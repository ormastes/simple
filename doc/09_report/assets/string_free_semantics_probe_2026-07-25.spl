# Probe: what rt_string_free actually refuses, and what it does NOT refuse.
#
# The decisive question for the eviction-leak audit is not "does the free
# work" but "does the primitive protect me from aliasing". It does not.
# Case E shows rt_string_free returns 1 (accepts) for a string that still has
# a second live holder -- so the whole safety burden sits in the .spl-level
# ownership proof, exactly as driver_types.spl:178-183 assumes.
#
# No freed value is ever read back: the aliased holder is deliberately left
# untouched after the free, so the probe itself stays defined behaviour.
#
# Kept free of Dict/struct/stdlib use on purpose -- pulling those in trips a
# pre-existing seed gap (unknown extern rt_transient_array_scope_begin).

extern fn rt_string_free(value: text) -> i64
extern fn rt_heap_registry_count() -> i64

fn main() -> i64:
    # --- A: uniquely-owned heap string is reclaimed -------------------------
    val before_a = rt_heap_registry_count()
    val unique = "unique_heap_string_padding_padding" + "_1"
    val after_alloc = rt_heap_registry_count()
    val rc_a = rt_string_free(unique)
    val after_free = rt_heap_registry_count()
    print "A unique   rc={rc_a} alloc_delta={after_alloc - before_a} free_delta={after_free - after_alloc}"

    # --- B: repeat free of the same value is refused, not a double free -----
    val rc_b = rt_string_free(unique)
    print "B repeat   rc={rc_b} expect 0 refused"

    # --- C: literal (intern-table owned) is refused --------------------------
    val rc_c = rt_string_free("interned_literal_marker")
    print "C literal  rc={rc_c} expect 0 refused"

    # --- D: short string (len<=1 process cache) is refused -------------------
    val rc_d = rt_string_free("x")
    print "D short    rc={rc_d} expect 0 refused"

    # --- E: THE POINT. A string with a second live holder is ACCEPTED. -------
    # Same shape as resolution.spl:58-59, where one text sits in
    # resolution_cache AND is returned inside a ResolvedModule.
    val aliased = "aliased_heap_string_padding_padding" + "_2"
    val second_holder = aliased
    val rc_e = rt_string_free(aliased)
    # second_holder is now DANGLING. Never read it.
    print "E aliased  rc={rc_e} 1 means accepted despite a live alias"
    0
