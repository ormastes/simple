# Focused native check for the runtime text builder used by CAS generations.
extern fn rt_string_builder_new() -> i64
extern fn rt_string_builder_push(handle: i64, part: text) -> i64
extern fn rt_string_builder_finish(handle: i64) -> text
extern fn rt_string_builder_free(handle: i64)

fn probe_join(parts: [text], separator: text) -> text?:
    val builder = rt_string_builder_new()
    if builder == 0:
        return nil
    var first = true
    for part in parts:
        if not first and rt_string_builder_push(builder, separator) == 0:
            rt_string_builder_free(builder)
            return nil
        if rt_string_builder_push(builder, part) == 0:
            rt_string_builder_free(builder)
            return nil
        first = false
    Some(rt_string_builder_finish(builder))

fn main() -> i64:
    val generation = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    val rows = [
        "simple-cas-batch-v1",
        "generation={generation}",
        "parent=",
        "scc=probe",
        "transaction={generation}",
        "pkg|action-digest|receipt-digest",
    ]
    val actual = probe_join(rows, "\n")
    if actual == nil:
        print "cas-join-failed:nil"
        return 1
    val expected = "simple-cas-batch-v1\ngeneration={generation}\nparent=\nscc=probe\ntransaction={generation}\npkg|action-digest|receipt-digest"
    if actual! != expected:
        print "cas-join-failed:chars={actual!.len()} expected={expected.len()}"
        return 1
    print "cas-join-ok:chars={actual!.len()}"
    0
