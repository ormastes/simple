knowledge_registry:
  version: 1
  selection: exact-feature-then-longest-source-prefix
  receipt: .spipe/<feature>/knowledge_selection.sdn
feature_routes:
  - feature_id: simpleos_vulkan_cuda_adreno
    group_id: rendering_ui
    group_path: doc/00_llm_process/feature_group/rendering_ui/skill.md
    expert_path: doc/00_llm_process/feature_expert/gpu_offload_check/skill.md
  - feature_id: gpu_renderer_processing_backends
    group_id: rendering_ui
    group_path: doc/00_llm_process/feature_group/rendering_ui/skill.md
    expert_path: doc/00_llm_process/feature_expert/gpu_offload_check/skill.md
layer_routes:
  - prefix: src/os/kernel
    group_id: os_kernel
    group_path: doc/00_llm_process/layer_base/os_kernel/skill.md
    architecture_profile: mdsoc_only
  - prefix: src/os/drivers
    group_id: os_drivers
    group_path: doc/00_llm_process/layer_base/os_drivers/skill.md
    architecture_profile: mdsoc_only
  - prefix: src/os/services
    group_id: os_userland
    group_path: doc/00_llm_process/layer_base/os_userland/skill.md
    architecture_profile: mdsoc_plus
  - prefix: src/os/apps
    group_id: os_userland
    group_path: doc/00_llm_process/layer_base/os_userland/skill.md
    architecture_profile: mdsoc_plus
  - prefix: src/compiler
    group_id: compiler_pipeline
    group_path: doc/00_llm_process/layer_base/compiler_pipeline/skill.md
    architecture_profile: mdsoc
  - prefix: src/runtime
    group_id: runtime_memory_io
    group_path: doc/00_llm_process/layer_base/runtime_memory_io/skill.md
    architecture_profile: mdsoc
  - prefix: src/lib/common/processing
    group_id: graphics_engine
    group_path: doc/00_llm_process/layer_base/graphics_engine/skill.md
    architecture_profile: mdsoc_plus
  - prefix: src/lib/gc_async_mut/processing
    group_id: graphics_engine
    group_path: doc/00_llm_process/layer_base/graphics_engine/skill.md
    architecture_profile: mdsoc_plus
  - prefix: src/lib
    group_id: runtime_memory_io
    group_path: doc/00_llm_process/layer_base/runtime_memory_io/skill.md
    architecture_profile: mdsoc_plus
  - prefix: src/app
    group_id: app_editor_tooling
    group_path: doc/00_llm_process/layer_base/app_editor_tooling/skill.md
    architecture_profile: mdsoc_plus
