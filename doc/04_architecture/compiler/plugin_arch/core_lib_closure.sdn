# Core-lib closure classification, schema v1 (WP-09, kernel/plugin audit
# plan). Rows are ordered; the first matching path glob owns a src/lib file.
# Format: CORE|shell-path-glob. Everything under src/lib NOT matched by a
# CORE row is implicitly HOST — reachable only from non-kernel code (plugins,
# app, os), never from the compiler kernel (K0, or K0+K1 in --kernel-binary
# mode).
#
# This set is NOT yet accepted (OD-4, kernel/plugin audit plan §6): it is
# seeded from the census's inferred smallest set (§1.4/§C5/OD-4) as a
# starting point for measurement, not a final decision. Until OD-4 formally
# accepts a set, scripts/check/check-core-lib-closure.shs only fails on
# GROWTH past the measured baseline (a NEW non-core file reached); a
# baselined file no longer reached is a WARN (stale baseline), not a FAIL.
# See scripts/check/core_lib_closure_baseline.txt (merge-owner-only per §8)
# for the current measured closure, which is evidence, not an allowlist.
schema: simple/compiler/core-lib-closure/v1
source_root: src/lib
entries:
  - CORE|src/lib/common/text*.spl
  - CORE|src/lib/common/text_layout/**
  - CORE|src/lib/common/string_core.spl
  - CORE|src/lib/common/bytes/**
  - CORE|src/lib/common/hash/**
  - CORE|src/lib/common/json/**
  - CORE|src/lib/common/sdn/**
  - CORE|src/lib/common/encoding/**
  - CORE|src/lib/common/structural/**
  - CORE|src/lib/common/contracts/**
  - CORE|src/lib/common/crypto/sha256*.spl
  - CORE|src/lib/nogc_sync_mut/io/**
  - CORE|src/lib/nogc_sync_mut/fs/**
  - CORE|src/lib/nogc_sync_mut/sffi/**
  - CORE|src/lib/nogc_sync_mut/env/**
  - CORE|src/lib/nogc_sync_mut/process*.spl
  - CORE|src/lib/log.spl
