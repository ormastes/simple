schema: host_enrollment_verification_v1
status: AWAITING_VERIFICATION
scope: signed-enrollment-codec-and-filesystem-claim
source_review: accepted-scoped-source-not-runtime
reviewer: Astra-host-lead
worker: Sol-host-worker
execution:
    build_attempts: 0
    compilation: NOT_RUN
    core_sspec: NOT_RUN
    claim_sspec: NOT_RUN
    full_suite: NOT_RUN
    branch_coverage: NOT_MEASURED
    native_provider_system_gate: NOT_RUN
resource_policy:
    aggregate_cpu_limit: 5
    cpu_set: "0-4"
    command_prefix: "taskset -c 0-4"
    build_slot: unassigned
required_runtime_checks:
    compiler_check: NOT_RUN
    library_check: NOT_RUN
    mcp_check: NOT_RUN
    lsp_check: NOT_RUN
    mcp_stdio_integration: NOT_RUN
limits:
    native_observer_is_caller_prerequisite: true
    installed_machine_parent_is_caller_prerequisite: true
    uid_provenance_not_provided: true
    descriptor_relative_race_guarantee_not_provided: true
    global_parent_enrollment_not_provided: true
    public_host_commands: NOT_IMPLEMENTED
    provider_effects: NOT_IMPLEMENTED
    operational_capacity_journal: NOT_CREATED
    complete_host_service: false
static_checks:
    whitespace: PASS
    working_environment_guard: PASS
    staged_environment_guard: PASS
    executable_specs_in_manual_tree: 0
