```simple
val mockfn = MockFunction.create("service")
val fluent = FluentExpectation.create(mockfn)
expect fluent.mockfn.name == "service"
val has_when_args = match fluent.when_args:
    Some(_): true
    nil: false
expect not has_when_args
```

