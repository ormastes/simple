step("Verify: rejects well-formed SDN that is missing the 'sheets' key")
# @req: REQ-SSPEC-LOCAL-001
match workbook_decode_sdn("{title: \"no sheets here\"}"):
    case Ok(_):
        assert_true(false)
    case Err(_):
        assert_true(true)
