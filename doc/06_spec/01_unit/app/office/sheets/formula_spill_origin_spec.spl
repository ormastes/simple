# @req: REQ-SSPEC-LOCAL-001
step("Verify: OFFSET spill origin display equals the scalar top-left (both sources agree)")
var sh = Sheet.new("f")
sh = _base(sh)
sh.set_value("D1", "=OFFSET(A1,0,0,2,2)")
sh = recalculate_formula_cells(sh)
expect(_disp(sh, "D1")).to_equal("10")
```

