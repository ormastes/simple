# @req: REQ-SSPEC-LOCAL-001
step("Verify: recalculating an already-recalculated sheet keeps the same displays")
var sh = _mixed_sheet()
sh = recalculate_formula_cells(sh)
expect(_disp(sh, "A1")).to_equal("#CIRC!")
expect(_disp(sh, "E1")).to_equal("9")
```

