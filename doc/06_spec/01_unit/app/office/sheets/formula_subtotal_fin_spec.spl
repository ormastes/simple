# @req: REQ-SSPEC-LOCAL-001
step("Verify: SUBTOTAL(9,...) includes hidden rows: sum = 15")
var sh = Sheet.new("f")
sh.set_value("A1", "1")
sh.set_value("A2", "2")
sh.set_value("A3", "3")
sh.set_value("A4", "4")
sh.set_value("A5", "5")
