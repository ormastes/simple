```simple
step("Verify: FREQUENCY spills bins+1 counts down a column (Excel doc example)")
# @req: REQ-SSPEC-LOCAL-001
var sh = Sheet.new("f")
sh.set_value("A1", "79")
sh.set_value("A2", "85")
sh.set_value("A3", "78")
sh.set_value("A4", "85")
sh.set_value("A5", "50")
sh.set_value("A6", "81")
sh.set_value("A7", "95")
sh.set_value("A8", "88")
sh.set_value("A9", "97")
sh.set_value("C1", "70")
sh.set_value("C2", "79")
sh.set_value("C3", "89")
sh.set_value("E1", "=FREQUENCY(A1:A9,C1:C3)")
sh = recalculate_formula_cells(sh)
expect(_disp(sh, "E1")).to_equal("1")
expect(_disp(sh, "E2")).to_equal("2")
expect(_disp(sh, "E3")).to_equal("4")
expect(_disp(sh, "E4")).to_equal("2")
