expect(one_set).to_be(true)
expect(true_set).to_be(true)
expect(restored).to_be(true)
expect(empty_disabled).to_be(false)
expect(zero_disabled).to_be(false)
expect(false_disabled).to_be(false)
expect(yes_disabled).to_be(false)
expect(whitespace_disabled).to_be(false)
expect(numeric_enabled).to_be(true)
