# @req: REQ-SSPEC-LOCAL-001
step("Verify: should reject a response that arrives after the retry deadline")
val p = RetryPolicy(
    max_attempts: 1,
    base_delay_ms: 1,
    max_delay_ms: 1,
    timeout_ms: 1
)
val outcome = with_retry(
    p,
    fn(attempt: i64) -> (i64, text, text, i64):
        sleep_ms(5)
        (200, "late success", "", 0)
)
expect(outcome.status).to_equal(200)  # oracle: 200 — named expected value from the requirement
expect(outcome.attempts).to_equal(1)  # oracle: 1 — named expected value from the requirement
expect(outcome.error).to_equal("retry timeout exceeded")
```

