```simple
# @req: REQ-SSPEC-LOCAL-001
step("Verify: should not retry on immediate success")
val p = _fast_policy()
val outcome = with_retry(p, fn(attempt: i64) -> (i64, text, text, i64):
    (200, "ok", "", 0)
)
expect(outcome.status).to_equal(200)  # oracle: 200 — named expected value from the requirement
expect(outcome.attempts).to_equal(1)  # oracle: 1 — named expected value from the requirement
expect(outcome.error).to_equal("")
```

