# @req: REQ-SSPEC-LOCAL-001
step("Verify: rejects a caller path-only launch after capability gating")
val result = x86_64_fs_exec_spawn_as(
    0, "/sys/apps/unsigned.elf", [], [])
expect(result).to_equal(-13)
```

