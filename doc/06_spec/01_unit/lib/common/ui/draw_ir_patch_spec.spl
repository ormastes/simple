# @req: REQ-SSPEC-LOCAL-001
step("Verify: compares every glyph_run member and suppresses reorder for moved glyph changes")
val baseline = draw_ir_composition("rev-1", "scene", DRAW_IR_BACKEND_CPU, [
    draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
        draw_ir_text_shaped_font("label", 5, 5, "AB", 2u32, "mono", "face", [8, 8], 16, 12, 12,
            draw_ir_glyph_run_payload([1u32, 2u32], [0, 8], [0, 0], [0, 1], true)),
        draw_ir_rect("peer", 40, 5, 8, 8, 3u32)
    ])
])
val changed_payloads = [
    draw_ir_glyph_run_payload([9u32, 2u32], [0, 8], [0, 0], [0, 1], true),
    draw_ir_glyph_run_payload([1u32, 2u32], [1, 8], [0, 0], [0, 1], true),
    draw_ir_glyph_run_payload([1u32, 2u32], [0, 8], [1, 0], [0, 1], true),
    draw_ir_glyph_run_payload([1u32, 2u32], [0, 8], [0, 0], [1, 1], true),
    draw_ir_glyph_run_payload([1u32, 2u32], [0, 8], [0, 0], [0, 1], false),
    draw_ir_glyph_run_payload([1u32, 2u32], [0], [0, 0], [0, 1], true)
]
for changed_payload in changed_payloads:
    val current = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
        draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
            draw_ir_text_shaped_font("label", 5, 5, "AB", 2u32, "mono", "face", [8, 8], 16, 12, 12, changed_payload),
            draw_ir_rect("peer", 40, 5, 8, 8, 3u32)
        ])
    ])
    val patch = draw_ir_patch_between(baseline, "rev-1", current, "rev-2")
    expect(patch.operations.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
    expect(_op_kind_count(patch.operations, DRAW_IR_PATCH_OP_UPDATE_STYLE, "label")).to_equal(1)
    expect(_op_kind_present(patch.operations, DRAW_IR_PATCH_OP_REORDER, "label")).to_equal(false)
    expect(patch.damage_rects.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
    expect(draw_ir_patch_commands_equal(baseline, current)).to_equal(false)
    val applied = draw_ir_patch_apply(baseline, patch)
    expect(applied.ok).to_equal(true)
    expect(draw_ir_patch_commands_equal(applied.composition, current)).to_equal(true)

val moved = draw_ir_composition("rev-2", "scene", DRAW_IR_BACKEND_CPU, [
    draw_ir_batch("batch", DRAW_IR_BACKEND_CPU, _embedding(), [
        draw_ir_rect("peer", 40, 5, 8, 8, 3u32),
        draw_ir_text_shaped_font("label", 6, 5, "AB", 2u32, "mono", "face", [8, 8], 16, 12, 12,
            draw_ir_glyph_run_payload([9u32, 2u32], [0, 8], [0, 0], [0, 1], true))
    ])
])
val moved_patch = draw_ir_patch_between(baseline, "rev-1", moved, "rev-2")
expect(_op_kind_count(moved_patch.operations, DRAW_IR_PATCH_OP_UPDATE_GEOMETRY, "label")).to_equal(1)
expect(_op_kind_count(moved_patch.operations, DRAW_IR_PATCH_OP_UPDATE_STYLE, "label")).to_equal(1)
expect(_op_kind_present(moved_patch.operations, DRAW_IR_PATCH_OP_REORDER, "label")).to_equal(false)
expect(_op_kind_count(moved_patch.operations, DRAW_IR_PATCH_OP_REORDER, "peer")).to_equal(1)
val moved_applied = draw_ir_patch_apply(baseline, moved_patch)
expect(moved_applied.ok).to_equal(true)
expect(draw_ir_patch_commands_equal(moved_applied.composition, moved)).to_equal(true)
