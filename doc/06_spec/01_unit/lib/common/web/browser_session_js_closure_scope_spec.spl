# @req: REQ-SSPEC-LOCAL-001
step("Verify: row E: a promise job callback captures the enclosing parameter")
expect(
    _eval_script_html(
        "function f(x) { return Promise.resolve(1).then(function(v) { out = '' + (typeof x) + ':' + x; }); } f(5);"
    )
).to_equal("number:5")
```

