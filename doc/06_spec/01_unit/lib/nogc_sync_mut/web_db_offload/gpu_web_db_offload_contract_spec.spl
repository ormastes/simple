    request(GpuWdbWorkKind.DbVectorSearch, 65536, 0, true, true, false),
    gpu_wdb_default_budget()
)
expect(decision.path).to_equal(GpuWdbDecisionPath.Reject)
expect(decision.reason).to_equal("cpu-fallback-required")
```

</details>

