#### routes Engine2D opencl probing through the render backend facade

- Verify: routes Engine2D opencl probing through the render backend facade
   - Expected: probe.requested_name equals `opencl`
   - Expected: probe.selected_name equals `opencl`
   - Expected: probe.api_name equals `opencl`
   - Expected: probe.shader_format equals `opencl-c`
   - Expected: probe.has_compute is true
   - Expected: _strict_failure_without_fallback(probe.status, probe.requested_name, probe.selected_name) is true
   - Expected: probe.available is true
   - Expected: probe.feature_gate equals `opencl_2d_render`
   - Expected: probe.status equals `BackendStatus.Unavailable`
   - Expected: probe.available is false
   - Expected: gate_is_known is true
   - Expected: engine.backend_name() equals `opencl`
   - Expected: readback.pixels.len() equals `expected_px`
   - Expected: readback.source equals `device_readback`
   - Expected: readback.pixels[0] equals `0xff112233u32`
   - Expected: readback.pixels[expected_px - 1] equals `0xff112233u32`


<details>
<summary>Executable SSpec</summary>

Runnable source: 65 lines folded for reproduction.
Reproduction: this block contains the complete executable scenario source.

```simple
step("Verify: routes Engine2D opencl probing through the render backend facade")
# @req: REQ-SSPEC-LOCAL-001
val probe = Engine2D.probe_backend(4, 4, "opencl")
print(probe.diagnostic_text())

expect(probe.requested_name).to_equal("opencl")
expect(probe.selected_name).to_equal("opencl")
expect(probe.api_name).to_equal("opencl")
expect(probe.shader_format).to_equal("opencl-c")
expect(probe.has_compute).to_equal(true)
expect(_strict_failure_without_fallback(probe.status, probe.requested_name, probe.selected_name)).to_equal(true)

# Probe SELF-consistency — claims about the probe object's own fields
# agreeing with each other, NOT predictions about the later create, so
# these stay hard assertions.
val probe_ready = probe.status == BackendStatus.Initialized
if probe_ready:
    expect(probe.available).to_equal(true)
    expect(probe.feature_gate).to_equal("opencl_2d_render")
else:
    expect(probe.status).to_equal(BackendStatus.Unavailable)
    expect(probe.available).to_equal(false)
    val gate_is_known = probe.feature_gate == "opencl_context" or probe.feature_gate == "opencl_2d_render" or probe.feature_gate == "opencl_surface"
    expect(gate_is_known).to_equal(true)

# The create is attempted REGARDLESS of what the probe predicted. A
# divergence is DISCLOSED, never asserted — it is a property of the host
# between two independent device acquisitions, not of the code under test.
val expected_px = 4 * 4
val strict = Engine2D.create_with_backend_strict(4, 4, "opencl")
val created = strict.is_ok()
if created != probe_ready:
    print "[toctou] opencl: probe predicted ready={probe_ready} but the independent create returned ok={created} — disclosed, not asserted"

match strict:
    case Ok(engine):
        # Holds on whatever backend actually served the frame.
        expect(engine.backend_name()).to_equal("opencl")
        engine.clear(0xff112233u32)
        val readback = engine.read_pixels_with_source()
        # A no-frame source carries an EMPTY pixel array, so a frame-length
        # check there is a host condition, not a defect. Gated no narrower
        # than that: every source that DID produce a frame still asserts.
        if _source_is_no_frame(readback.source):
            print "[probe-gpu] opencl: FRAME ASSERTIONS SKIPPED — no frame was produced (source={readback.source}); this example proves NOTHING about rendering correctness"
        else:
            expect(readback.pixels.len()).to_equal(expected_px)
        _assert_provenance_invariants("opencl", readback.source, readback.backend_handle, readback.pixel_count, expected_px)
        val proven = _report_outcome("opencl", readback.source, readback.backend_handle, readback.device_identity, readback.pixel_count, expected_px)
        if proven:
            # Asserted off a FACT (a device really produced this frame),
            # never off the probe's prediction.
            expect(readback.source).to_equal("device_readback")
            expect(readback.pixels[0]).to_equal(0xff112233u32)
            expect(readback.pixels[expected_px - 1]).to_equal(0xff112233u32)
        engine.shutdown()
    case Err(failure):
        # The strictness claim still holds unconditionally on the failure
        # path: a failed strict create may never substitute a CPU backend.
        _assert_strict_failure_is_structured("opencl", failure.selected_name)

# Worded to avoid quoting the disclosure token itself — a verdict line
# containing it would be miscounted as a real GPU-PROVEN disclosure.
print "[probe-gpu] RUN VERDICT: count the per-example GPU-PROVEN disclosure lines above. A run with none of them proves NOTHING about the OpenCL device path, however green it looks."
print "[probe-gpu] RUN VERDICT: no assertion in this example is driven by the probe; a probe/create divergence is reported on a [toctou] line instead."
```

</details>

