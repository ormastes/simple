   - Expected: is_type_var(v) is true
   - Expected: is_type_var(TYPE_I64) is false
   - Expected: is_type_var(TYPE_BOOL) is false
   - Expected: is_type_var(TYPE_F64) is false
   - Expected: is_type_var(TYPE_TEXT) is false


