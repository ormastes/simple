   - Expected: d["a"] equals `one`
   - Expected: d.get("a") equals `one`
   - Expected: d["b"] equals `two`
   - Expected: d.get("b") equals `two`
   - Expected: d.contains_key("a") is true
   - Expected: d.contains_key("b") is true


