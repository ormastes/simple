```simple
# @req: REQ-COMPILER-BOOTSTRAP-001
step("Verify: routes six-argument context calls through the default wrapper")
val fixture = "build/land11_spec_fx/template_default_context.spl"
expect(write_template_fixture(fixture)).to_equal(true)
val (out, _err, rc) = rt_process_run_timeout(compiler_binary(), ["run", fixture], 300000)
expect(rc).to_equal(0)
# Two distinct concrete instantiations of the same generic template must
# both come back through the default specialization path with the
# per-type values intact.
expect(out).to_contain("3-4-x-y")
```

