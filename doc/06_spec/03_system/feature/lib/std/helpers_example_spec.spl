```simple
step("Verify: partitions by predicate")
# @req: REQ-FEATURE-HelpExam-001
val numbers = [1, 2, 3, 4, 5, 6]
val is_even = fn(x): x % 2 == 0
var result = array_partition_inline(numbers, is_even)
val evens = result.0
val odds = result.1
expect(evens.len()).to_equal(3)  # oracle: value fixed by the spec contract
expect(evens[0]).to_equal(2)  # oracle: value fixed by the spec contract
expect(odds.len()).to_equal(3)  # oracle: value fixed by the spec contract
expect(odds[0]).to_equal(1)  # oracle: value fixed by the spec contract
```

