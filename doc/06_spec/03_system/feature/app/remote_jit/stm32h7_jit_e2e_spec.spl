if not hardware_ready():
    print "[skip] STM32H7 hardware not available"
    return
var adapter = Stm32H7Adapter.new()
val result = adapter.connect()
if result.is_err():
    print "[skip] connect failed: {result.err().unwrap()}"
    return
expect(result.is_ok()).to_equal(true)
print "[ok] connected to STM32H7 via OpenOCD"
adapter.disconnect()
```

