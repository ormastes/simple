   - Expected: _eval_str("var EventEmitter = require('events').EventEmitter; var e = new EventEmitter(); var cb = () => 1; var other = () => 2; e.on('ready', cb); e.removeListener('ready', other); e.listenerCount('ready') + ':' + e.emit('ready')") equals `1:true`


