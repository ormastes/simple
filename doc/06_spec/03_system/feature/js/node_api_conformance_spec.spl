   - Expected: _eval_str("var h = require('timers').setTimeout(() => {}, 5); h.refresh(); h.scheduledAt + ':' + h.dueAt") equals `0:5`
   - Expected: _eval_str("var h = require('timers').setTimeout(() => {}, 5); h.close(); h.refresh(); h.refreshed") equals `false`


