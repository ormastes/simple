# @req: REQ-SSPEC-LOCAL-001
step("Verify: produces [0.0, 0.5, 1.0] for linspace(0, 1, 3) — closed interval")
val a = linspace(Float64.new(0.0), Float64.new(1.0), Index.new(3))
expect(a.len()).to_equal(Index.new(3))
