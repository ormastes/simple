# @req: REQ-FEATURE-WITH-STATEMENT-001
step("Verify: calls cleanup even when block completes normally")
var cleanup_called = false

class TestContext:
    fn enter() -> TestContext:
        self

    fn cleanup():
        cleanup_called = true

val ctx = TestContext()

with ctx:
    val x = 42

check cleanup_called
```

