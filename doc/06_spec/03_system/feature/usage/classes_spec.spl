# @req: REQ-FEATURE-CLASSES-001
step("Verify: adds method to struct via impl")
# Block-scoped impl now works!
struct Point:
    x: i64
    y: i64

impl Point:
    fn sum(self):
        return self.x + self.y

val p = Point { x: 15, y: 25 }
expect p.sum() == 40
