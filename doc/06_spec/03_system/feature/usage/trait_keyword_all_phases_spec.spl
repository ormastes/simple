step("Verify: delegates immutable method to field")
# @req: REQ-FEATURE-TraiKeywAllPhas-001
struct Inner:
    data: i64
    fn get_len() -> i64:
        self.data

# This represents what desugar would generate from alias fn len = inner.len
struct Wrapper:
    inner: Inner
    fn get_len() -> i64:
        self.inner.get_len()

