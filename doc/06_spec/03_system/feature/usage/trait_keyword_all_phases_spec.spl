step("Verify: abstract method must be implemented")
# @req: REQ-FEATURE-TraiKeywAllPhas-001
trait Eq:
    fn eq_val(other_val: i64) -> bool

struct Number:
    n: i64

impl Eq for Number:
    fn eq_val(other_val: i64) -> bool:
        self.n == other_val

val num = Number(n: 42)
expect(num.eq_val(42)).to_equal(true)
expect(num.eq_val(10)).to_equal(false)
```

