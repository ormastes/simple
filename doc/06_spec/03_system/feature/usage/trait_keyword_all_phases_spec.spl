```simple
step("Verify: multiple traits in source: each generates correct forwarding")
# @req: REQ-FEATURE-TraiKeywAllPhas-001
trait ReadCapable:
    fn read_data() -> text

trait CloseCapable:
    me close_handle()

struct Reader:
    data: text
    fn read_data() -> text:
        self.data

struct HandleObj:
    open: bool
    me close_handle():
        self.open = false

impl ReadCapable for Reader:
    fn read_data() -> text:
        self.data

impl CloseCapable for HandleObj:
    me close_handle():
        self.open = false

# FileStream delegates to both reader and handle
struct FileStream:
    reader: Reader
    handle: HandleObj
    fn read_data() -> text:
        self.reader.read_data()
    me close_handle():
        self.handle.close_handle()

var fs = FileStream(reader: Reader(data: "content"), handle: HandleObj(open: true))
expect(fs.read_data()).to_equal("content")
fs.close_handle()
expect(fs.handle.open).to_equal(false)
```

