# @req: REQ-FEATURE-TraiKeywAllPhas-001
struct InnerCalc:
    base: i64
    fn get(key: i64, default_val: i64) -> i64:
        if key > 0:
            self.base + key
        else:
            default_val

struct CalcWrapper:
    inner: InnerCalc
    fn get(key: i64, default_val: i64) -> i64:
        self.inner.get(key, default_val)

val w = CalcWrapper(inner: InnerCalc(base: 100))
