```simple
step("Verify: multiple trait params dispatch correctly")
# @req: REQ-FEATURE-TraiKeywAllPhas-001
trait ReadOp:
    fn read_op() -> text

trait CloseOp:
    fn close_op() -> text

struct FileReader:
    name: text

impl ReadOp for FileReader:
    fn read_op() -> text:
        "read:{self.name}"

struct FileCloser:
    name: text

impl CloseOp for FileCloser:
    fn close_op() -> text:
        "close:{self.name}"

fn use_both(r: ReadOp, c: CloseOp) -> text:
    "{r.read_op()} {c.close_op()}"

val r = FileReader(name: "a.txt")
val c = FileCloser(name: "b.txt")
expect(use_both(r, c)).to_equal("read:a.txt close:b.txt")
```

