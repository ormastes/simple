```simple
# @req: REQ-SSPEC-LOCAL-001
step("Verify: allows wildcard in weak enum")
enum Status:
    Active
    Inactive
    Pending
val s = Status.Active
var result = 0
match s:
    case Status.Active:
        result = 1
    case _:
        result = 0
expect(result).to_equal(1)
```

</details>

