# @req: REQ-FEATURE-NullCoalTryOper-001
fn parse_value(s: text) -> Result<i64, text>:
    val opt = s.parse_int()
    if not opt.?:
        return Err("parse failed")
    val value = opt ?? 0
    Ok(value)

val result = parse_value("42")
match result:
