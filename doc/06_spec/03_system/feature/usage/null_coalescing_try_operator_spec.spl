step("Verify: match instead of ? in for loop")
# @req: REQ-FEATURE-NullCoalTryOper-001
fn sum_parsed(items: [text]) -> Result<i64, text>:
    var total = 0
    for item in items:
        val result = item.parse_int()
        match result:
            case Some(n): total = total + n
            case None: return Err("parse failed: {item}")
    Ok(total)

val result = sum_parsed(["1", "2", "3"])
match result:
    case Ok(v): expect(v).to_equal(6)  # oracle: value fixed by the spec contract
    case Err(_): fail("Expected Ok")
