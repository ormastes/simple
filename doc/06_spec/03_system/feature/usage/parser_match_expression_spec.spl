# @req: REQ-SSPEC-LOCAL-001
step("Verify: nested match expressions return values")
val a = 1
val output = match a:
    1 =>
        val inner = match 2:
            2 => "one-two"
            _ => "one-other"
        inner
    _ =>
        "other"
expect output == "one-two"
