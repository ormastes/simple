# GPU WebScene parallel-development ownership ledger
# Source: doc/03_plan/ui/gpu_web_scene_offload_mdsoc_plus_plan.md §10-12
#
# Rules:
# - Each agent modifies ONLY its assigned path prefixes.
# - Frozen contracts (§10.2) require a schema-version bump before any change.
# - Only W10 (web integration) and I11 (engine2d integration) touch existing production entrypoints.
# - Feature flags (SIMPLE_WEB_GPU_SCENE, SIMPLE_GPU_EVENT_SCRIPT, SIMPLE_WEB_GPU_STRICT, SIMPLE_WEB_GPU_SHADOW) default off.
# - Existing DrawIR v2, CPU event reducer and web renderer remain usable.
# - No shared ad-hoc utilities; cross-group utilities require a frozen port or move to the owning capsule.

gpu_web_scene_ownership:
  C0_contract_freeze:
    status: in_progress
    owner: session-2026-07-31-c0
    note: gpu_web_ports/receipt/capacity/draw_ir_v3 contracts landed
