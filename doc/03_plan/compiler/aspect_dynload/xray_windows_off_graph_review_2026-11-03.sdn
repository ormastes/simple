review:
  schema: 1
  source_base: f2c3d2d450c
  scope: observer-request-admission-and-hosted-build-edges
  status: source-reviewed-execution-unrun
  windows_build_dag_comparison: unrun
  windows_compile_command_comparison: unrun
  windows_link_import_export_comparison: unrun
  native_profile_admission: unsupported

request_path:
  extension_owner: src/lib/common/plugin/aspect_params.spl
  extension_name: simple.trace/observer-v1
  extension_intake: src/lib/common/trace/observer_aspect_config_v1.spl
  config_parser: src/lib/common/trace/observer_config_v1.spl
  target_route: src/lib/common/trace/observer_build_route_v1.spl
  compiler_request: src/compiler/80.driver/driver_observer_request_v1.spl
  compiler_admission: src/compiler/80.driver/driver_observer_compile_gate_v1.spl
  order: "entry admission -> extension validation -> SDN validation -> target route -> reject active candidates"
  absent: "No observer payload parsing; existing compiler path continues"
  off: "Route returns Off with backend None before target/backend selection"
  windows_active: "UnsupportedTarget; no Linux candidate or provider is selected"
  linux_active: "Candidate only; UnsupportedProfile prevents native instrumentation"
  dependencies: "Only common contract/config/text/SDN code; no hosted LLVM or memory provider"

compiler_entrypoints:
  ordinary: "driver_orchestration.compile rejects before reverse-reference owner, build session, source loading, cache lookup, and mode dispatch"
  vhdl: "driver_orchestration.compile_vhdl_only rejects before backend validation and source loading"
  jit: "driver_pipeline_execution.jit_compile_and_run rejects before MIR lowering; post-weave errors prevent execution"
  aot: "driver_aot_pipeline.aot_compile rejects before bootstrap/shard routing"
  emit: "driver_aot_pipeline.stage_emit_object rejects before HIR eviction and optional transform skipping; post-weave errors prevent emission"
  source_llvm: "driver_source_llvm_ir.compile_source_to_llvm_ir creates default options, has no observer-request parameter, and checks transform errors before emission"
  constructor_limit: "CompileContext/compiler-driver construction occurs before admission; this review does not claim that generic compiler dependencies are deferred"

actual_build_graph:
  native_root: src/app/io/_CliCompile/native_build.spl
  default_roots: "src/compiler, src/app, src/lib"
  closure_owner: _native_build_entry_closure
  dispatch: "CompileOptions.default -> input roots/entry -> compiler_driver_create -> compiler_driver_run_compile"
  graph_before_driver: "Entry closure resolution happens before driver admission"
  target_resolver: src/app/build/targets/target_resolve.spl
  target_resolver_behavior: "Resolves declared named dependencies in topological order; no observer route input"
  compiler_manifest: src/compiler/simple.sdn
  compiler_manifest_dependencies: "../lib and ../../rust; no observer/XRay dependency"
  owner_registry: src/package_ownership/simple.sdn
  owner_registry_behavior: "Assigns compiler/lib/os ownership; not an observer platform-selection authority"
  dependency_archive_owner: src/app/io/_CliCompile/native_dependency_inputs.spl
  dependency_archive_behavior: "Admits explicit hashed archive/object receipts; no observer route input"
  current_hosted_xray_edge: absent
  staged_effectful_leaf: test/fixtures/trace/hosted_linux/observer_llvm_linux_v1.spl
  physical_exclusion: "Effectful source moved outside src/compiler, src/app, src/lib and src; former std source path absent; no observer or shim imports it"
  staged_leaf_policy: "Future admitted Linux provider must explicitly select/materialize this leaf; its existence does not advertise availability"
  simpleos_config: src/os/port/llvm/compiler_rt_cmake.cmake
  simpleos_xray: "COMPILER_RT_BUILD_XRAY OFF; unchanged"

missing_glue:
  cli: "No dynamic observer CLI option -> AspectParams extension transfer in native_build; defaults remain off"
  graph_selection: "No qualified observer route -> hosted dependency node selection before native source closure/dependency resolution"
  producer_admission: "No pinned producer/source/runtime ABI authority authorizes either candidate"
  emitter: "No route -> LLVM attributes/native sled-map emission integration"
  linker: "No route -> target-scoped XRay archive/link inputs integration"
  windows_off_risk: "Adding an effectful Linux leaf under broad default src/lib roots is not protected by this runtime route helper alone; future graph selection must exclude it before source/import evaluation"
  scanner_gap_owner: src/app/io/_CliCompile/native_build.spl
  scanner_gap: "_native_build_entry_closure reads raw content and _nb_module_path_from_use trims inactive @when-arm use statements; unlike driver_entry_closure_core cached scan, it does not preprocess target conditionals before discovering dependencies"
  scanner_gap_scope: "Recorded for owner repair; no broad native-build resolver change while bootstrap producer work is active"
  proof_boundary: "Current absence of a hosted dependency is not proof that future Linux integration preserves the Windows graph"

regression:
  spec: test/01_unit/compiler/driver/observer_entry_admission_v1_spec.spl
  cases: 7
  oracle: "Real driver methods return exact TRACE-E-REQUEST status before nonexistent input parsing or MIR work"
  execution: unrun
  gate_leak_repaired: "Previously weave_aop recorded an error and returned, while JIT and main AOT could continue; entry admission now returns a CompileResult failure"
  preserved_paths: "Staged batch and MIR shard already check error counters before emission; retain their cleanup flow"
  source_exclusion_spec: test/01_unit/compiler/driver/observer_linux_leaf_exclusion_v1_spec.spl
  source_exclusion_cases: 3
  source_exclusion_oracle: "Production collector finds zero sources at former src path and recognizes the explicitly selected staged input; production import scanner sees no staged leaf edge in observer admission/shim modules"
  source_exclusion_execution: unrun
