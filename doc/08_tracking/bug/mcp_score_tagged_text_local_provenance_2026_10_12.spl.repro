fn _ctx_fmt_score(score: f64) -> text:
    # WORKAROUND(mcp-f64-to-int-20261012): native method lowering is unresolved.
    val milli = (score * 1000.0) as i64
    val whole = milli / 1000
    var frac = milli - whole * 1000
    if frac < 0:
        frac = 0 - frac
    var frac_s = str(frac)
    while frac_s.len() < 3:
        frac_s = "0" + frac_s
    str(whole) + "." + frac_s

fn main() -> i64:
    assert(_ctx_fmt_score(0.0) == "0.000")
    assert(_ctx_fmt_score(1.25) == "1.250")
    assert(_ctx_fmt_score(12.345) == "12.345")
    assert(_ctx_fmt_score(-1.25) == "-1.250")
    assert(_ctx_fmt_score(0.001) == "0.001")
    assert(_ctx_fmt_score(1.2349) == "1.234")
    print "MCP_SCORE_CAST_NATIVE_PASS"
    0
