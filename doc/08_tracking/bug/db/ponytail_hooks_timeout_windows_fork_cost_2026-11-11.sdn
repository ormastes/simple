bug_descriptions |bug_id, line_num, content|
    ponytail_hooks_timeout_windows_fork_cost_2026-11-11, 0, "ponytail SessionStart/UserPromptSubmit hooks exceed their 5 s timeout on Windows Git Bash: each spawned external command (sed/grep/tr/head/awk/cat, $(...) subshells) costs ~4-8 s on a loaded host, and the prompt hook spawned ~10 per prompt."

bugs_active |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|
    ponytail_hooks_timeout_windows_fork_cost_2026-11-11, P2, fix-implemented-verification-pending, "ponytail hooks time out on Windows (per-process spawn cost)", .claude/hooks/ponytail-prompt.shs, 1, "sh .claude/hooks/ponytail-prompt.shs --selftest; time echo '{\"prompt\":\"hi\"}' | sh .claude/hooks/ponytail-prompt.shs", 2026-11-11, 2026-11-11, true

bug_investigation_logs |bug_id, line_num, content|
    ponytail_hooks_timeout_windows_fork_cost_2026-11-11, 0, "root cause: fork cost (sh -c true = 3-5 s on host); prompt hook 15-40 s, session-start 5-9 s before. fix: both hooks fork-free (read/case/parameter expansion builtins only; heredoc via read loop; no $(dirname)/pwd). after: prompt 2.7 s, session-start 1.7 s = single sh spawn floor. selftests 9/9 and 7/7 green. remaining: user confirmation in a live Claude Code Windows session."
