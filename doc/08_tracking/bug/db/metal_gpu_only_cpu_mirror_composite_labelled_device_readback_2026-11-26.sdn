    metal_gpu_only_cpu_mirror_composite_labelled_device_readback_2026-11-26, P2, fix-implemented-verification-pending, "Metal gpu_only composites blends on the CPU mirror but labels the readback device", doc/08_tracking/bug/metal_gpu_only_cpu_mirror_composite_labelled_device_readback_2026-11-26.md, 1, src/lib/gc_async_mut/gpu/engine2d/backend_metal.spl, 2026-11-26, 2026-11-27, true

