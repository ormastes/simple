    wm_retained_damage_rejects_parent_sampling_window_material_2026-11-26, P2, open, "retained damage replay rejects every backdrop-sampling (fluid_light) window", doc/08_tracking/bug/wm_retained_damage_rejects_parent_sampling_window_material_2026-11-26.md, 1, test/02_integration/rendering/engine2d_wm_local_lane_clock_tick_spec.spl, 2026-11-26, 2026-11-26, true

