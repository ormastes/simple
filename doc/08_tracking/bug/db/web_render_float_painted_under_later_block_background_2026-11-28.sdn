    web_render_float_painted_under_later_block_background_2026-11-28, P2, open, "web render: a float is painted under a later in-flow block's background", src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_layout.spl, 1105, "<div style='float:left;width:100px;height:20px;background:#aa0000'></div><div style='height:10px;background:#00aa00'></div>; scan the float's column", 2026-11-28, 2026-11-28, true

bug_investigation_logs |bug_id, line_num, content|
    web_render_float_painted_under_later_block_background_2026-11-28, 0, "2026-11-28 frac-float-svg lane: measured, not fixed (paint order, outside the layout lane). Suggested fix: emit float box commands and their descendants after the in-flow block backgrounds of the same stacking context, before inline content."

