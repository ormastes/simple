bug_descriptions |bug_id, line_num, content|
    overflow_hidden_fractional_clip_4x_drops_fraction_2026-11-27, 0, "At device scale 4 Chrome 159 clips an overflow:hidden 100.25x10.5px box at device row 82 / column 441; Simple's layout drops the fraction and clips at row 80 / column 440, so the child's last device rows and column are cut."

bugs_active |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|
    overflow_hidden_fractional_clip_4x_drops_fraction_2026-11-27, P3, fixed, "4x overflow:hidden clip edge drops the box's fractional CSS size (row 80/col 440 vs Chrome 82/441)", src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_layout.spl, 2010, test/01_unit/browser_engine/overflow_hidden_fractional_clip_4x_chrome159_spec.spl, 2026-11-27, 2026-11-27, true

bug_investigation_logs |bug_id, line_num, content|
    overflow_hidden_fractional_clip_4x_drops_fraction_2026-11-27, 0, "2026-11-27 webrender-textarea-clip Linux aarch64 seed sha256 fb80903917d6d5f5, Chrome for Testing 159.0.8154.6 at 4x: r81c240 expected (204,0,0) got white; r75c440 expected (204,0,0) got (221,221,238). Same on base 31eed3226c1."
    overflow_hidden_fractional_clip_4x_drops_fraction_2026-11-27, 1, "2026-11-27 W4-5 fixed: preserved box_geometry_raw_tokens/box_geometry_unresolved/fractional_authored_decls across Style.copy_from in simple_web_html_layout_renderer_style.spl; added _html_box_device_extra_h and carried box_device_extra_w_at / _html_box_device_extra_h into non-textarea overflow owned clip far edges (clamped recursively against ancestor clips) in simple_web_html_layout_renderer_paint_layout.spl. Dropped in-development tag from test/01_unit/browser_engine/overflow_hidden_fractional_clip_4x_chrome159_spec.spl; verified 4/4 PASS on interpreter matching Chrome 159 oracle pixels (r81c240=(204,0,0), r82c240=white, r75c440=(204,0,0), r75c441=white), short-child bottom paint, nested clip clamp, and integer 4x/1x guards."

bug_fix_strategies |bug_id, line_num, content|
    overflow_hidden_fractional_clip_4x_drops_fraction_2026-11-27, 0, "Carry the box's fractional end (end_frac) into its owned clip edge at k>1, the way box_device_extra_h carries a content-height fraction; then drop the in-development tag."
