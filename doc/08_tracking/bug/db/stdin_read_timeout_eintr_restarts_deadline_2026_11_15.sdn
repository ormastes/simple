strings |id, value|

bug_descriptions |bug_id, line_num, content|
    stdin_read_timeout_eintr_restarts_deadline_2026_11_15, 0, "On Linux the bounded stdin reader passes its original timeout to poll after every EINTR, so repeated signals can extend the operation beyond the requested duration. The read retry is not claimed to violate the deadline without a separate reproduction."
    stdin_read_timeout_eintr_restarts_deadline_2026_11_15, 1, "Deterministic native fixture against the unmodified release returned in 503 ms for a 300 ms timeout after eight targeted SIGUSR1 signals. The repaired source's final exact-hash run passed in 301 ms; injected clock failure and deadline overflow both returned empty before poll."

bugs_active |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|
    stdin_read_timeout_eintr_restarts_deadline_2026_11_15, P2, fixing, "rt_stdin_read_timeout_v1 restarts full poll timeout after EINTR", src/runtime/runtime_core_io_exports.c, 234, src/runtime/test/rt_stdin_read_timeout_eintr_selfcheck.c, 2026-11-15, 2026-11-14, true

bug_investigation_logs |bug_id, line_num, content|
    stdin_read_timeout_eintr_restarts_deadline_2026_11_15, 0, "Source inspection at release 80fdf9ff49f3adb37d43e38bea2039ed05923270: rt_stdin_read_timeout_v1 retries poll with unchanged timeout_ms after EINTR."
    stdin_read_timeout_eintr_restarts_deadline_2026_11_15, 1, "Native regression: unmodified release source returned after 503 ms with timeout=300 ms and eight targeted SIGUSR1 signals. The deadline-only fix first passed at 302 ms; final source with clock-failure/time_t-overflow guards passed at 301 ms."
    stdin_read_timeout_eintr_restarts_deadline_2026_11_15, 2, "Raw stdin ownership audit: sys.terminal_console.read_timeout is the sole in-tree caller; open() checks TTY, enters raw mode and maintains one console-handle owner. No competing-reader race after poll readiness was demonstrated; post-read EINTR retry is outside this finding."
    stdin_read_timeout_eintr_restarts_deadline_2026_11_15, 3, "Final production C SHA256 988cb3bbb957c3ed20ef29d38b877c4e5d6fc7bd278190af3b5748b62c385758; fixture e2cc65a92031557951cba36f2ca73e38a51d5ec5506e36d7e141bdb3a66b7f34; runner ab7318705eb3e843be33a18d3888e704deebcfeed6a1857f58421e8f3a171f9e. Artifacts: build/rt-stdin-timeout-eintr."

bug_fix_strategies |bug_id, line_num, content|
    stdin_read_timeout_eintr_restarts_deadline_2026_11_15, 0, "Use one monotonic absolute deadline; after EINTR recompute the remaining poll duration, return empty when expired, and preserve existing size/timeout clamps and partial-read contract."

