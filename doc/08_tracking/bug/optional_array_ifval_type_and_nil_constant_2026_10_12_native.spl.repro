# AUTHORED_UNEXECUTED with changed producer. Exit codes identify real value failures.
fn make_array(present: bool) -> [any]?:
    if present:
        val items: [any] = [7, "two", nil]
        return Some(items)
    nil

fn make_empty() -> [any]?:
    val items: [any] = []
    Some(items)

fn make_ints() -> [i64]?:
    Some([19, 23])

fn main() -> i64:
    if val items = make_array(true):
        var count = 0
        for item in items:
            if count == 0 and item != 7:
                return 11
            if count == 1 and item != "two":
                return 12
            if count == 2 and item != nil:
                return 13
            count = count + 1
        if count != 3:
            return 1
    else:
        return 2
    if val absent = make_array(false):
        return 3
    if val empty = make_empty():
        for item in empty:
            return 4
    else:
        return 5
    if var numbers = make_ints():
        var sum = 0
        for number in numbers:
            sum = sum + number
        if sum != 42:
            return 6
    else:
        return 7
    return 0
