# SimpleOS production status ledger — canonical owner + maturity per subsystem.
# Master plan: doc/01_research/domain/simpleos_production_host_master_plan.md §22 Phase 0.
# Guarded by test/01_unit/os/arch/duplicate_owner_spec.spl (ledger/code parity).
# maturity: production | partial | model | evidence-only | host-proxy | stub | duplicate

production_status:
  abi_contract:
    owner: os.kernel.abi.abi_v1
    lane: A00
    maturity: partial
  kernel_types:
    owner: os.kernel.types
    lane: A00
    maturity: production
  ipc:
    owner: os.kernel.ipc
    lane: A01
    maturity: partial
    note: l4_fast_ipc.spl is a benchmark model, not the syscall path
  capability_spawn:
    owner: os.kernel.ipc.cspace_spawn
    lane: A02
    maturity: model
    note: SpawnSpec exists; live child CSpace injection unwired; ambient spawn_full remains
  loader:
    owner: os.kernel.loader
    lane: A02
    maturity: partial
    note: per-exec bootstrap scheduler; descriptor-based exec pending
  memory:
    owner: os.kernel.memory
    lane: A02
    maturity: partial
  vfs:
    owner: os.kernel.fs
    lane: A03
    maturity: duplicate
    note: old VfsManager + FsDriver/mount-table + direct FAT32 coexist; unify then delete
  drivers:
    owner: os.drivers
    lane: A04
    maturity: evidence-only
    note: DeviceGrant runtime ABI missing; readiness contracts only
  posix:
    owner: os.posix
    lane: A05
    maturity: partial
    note: no writable shared mmap, no pthreads; profile matrix must stop over-claiming
  tty:
    owner: os.kernel tty paths
    lane: A06
    maturity: model
    note: tty_write returns accepted count without delivering to output endpoint
  ssh:
    owner: os simple-native sshd
    lane: A06
    maturity: model
    note: x86_64-only FS-exec arms; OpenSSH port is the production path
  containers:
    owner: os container contract
    lane: A07
    maturity: model
    note: namespace metadata + markers, not enforced resource domains
  web_server:
    owner: os.http
    lane: A09
    maturity: partial
    note: native raw benchmark fast; routed server interpreter-bound
  database:
    owner: simple db embedded (SDN store)
    lane: A09
    maturity: partial
    note: server tier absent; SQLite-over-VFS is the first milestone
  config:
    owner: std.config (to extract from IDE config)
    lane: A10
    maturity: duplicate
    note: parser/getters hand-duplicated across IDE + settings
  browser:
    owner: browser tree
    lane: A10
    maturity: model
    note: production-blocking isolation/origin/lifecycle gaps
  llm_profiles:
    owner: os security llm profile registry
    lane: A07
    maturity: model
    note: role/CSpace research not wired to spawn-time CSpaces
  evidence:
    owner: spipe sdn receipts
    lane: A11
    maturity: partial
    note: fail-closed on missing/stale artifacts not yet universal
