# Updated by scripts/check/check-bootstrap-must-pass.shs. TODO is visible debt,
# never PASS. A fresh successful bootstrap validates and promotes each compiler
# stage, then runs the automated bootstrap-tier gates before recording success.
must_check_ledger:
  schema: "simple.must-check-ledger/v3"
  source_fingerprint: "unrecorded"
  completed_at_utc: "never"
must_check_results |id, status, passed_at_utc, command, evidence, evidence_sha256, owner, unblock_condition|
    compiler-stage1, todo, never, "scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap --deploy", "successful Stage 1 receipt required", "never", "compiler-team", "produce fresh bootstrap-owned evidence for this gate"
    compiler-stage2, todo, never, "scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap --deploy", "successful Stage 2 receipt required", "never", "compiler-team", "produce fresh bootstrap-owned evidence for this gate"
    compiler-stage3, todo, never, "scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap --deploy", "successful Stage 3 admission receipt required", "never", "compiler-team", "produce fresh bootstrap-owned evidence for this gate"
    compiler-stage4, todo, never, "scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap --deploy", "successful full Stage 4 CLI receipt required", "never", "compiler-team", "produce fresh bootstrap-owned evidence for this gate"
    rules-full, todo, never, "sh scripts/check/check-rules-sdl.shs --group full", "bootstrap must-check has not recorded PASS", "never", "tooling-team", "produce fresh bootstrap-owned evidence for this gate"
    bootstrap-essential-tools, todo, never, "sh scripts/check/check-bootstrap-essential-tools-smoke.shs", "bootstrap must-check has not recorded PASS", "never", "tooling-team", "produce fresh bootstrap-owned evidence for this gate"
    native-positional-build, todo, never, "sh scripts/check/check-native-inprocess-positional-nonvacuous.shs", "bootstrap must-check has not recorded PASS", "never", "tooling-team", "produce fresh bootstrap-owned evidence for this gate"
    predicate-parser-native-build, todo, never, "sh scripts/check/check-predicate-parser-native-build.shs", "bootstrap must-check has not recorded PASS", "never", "tooling-team", "produce fresh bootstrap-owned evidence for this gate"
    native-trailing-defaults, todo, never, "sh scripts/check/check-native-trailing-default-param.shs", "bootstrap must-check has not recorded PASS", "never", "tooling-team", "produce fresh bootstrap-owned evidence for this gate"
    class-identity-matrix, todo, never, "sh scripts/check/check-class-identity-engine-matrix.shs", "bootstrap must-check has not recorded PASS", "never", "tooling-team", "produce fresh bootstrap-owned evidence for this gate"
    engine-differential, todo, never, "", "bootstrap differential evidence not recorded", "never", "tooling-team", "produce fresh bootstrap-owned evidence for this gate"
    sdoctest-markdown-comments, todo, never, "sh scripts/check/check-sdoctest-bootstrap.shs", "full Markdown and comment sdoctest evidence not recorded", "never", "tooling-team", "produce fresh bootstrap-owned evidence for this gate"
    windows-hook-installation, todo, never, "", "native Windows linked-worktree install evidence not recorded", "never", "tooling-team", "on a Windows host create two linked worktrees then run powershell -File scripts/setup/install-must-check-hooks.ps1 -Install in one and -Check plus check-hook-installation.shs from the other"
    caret-local-llm-launch, todo, never, "", "Slang has loader readiness but no generation endpoint or Caret provider", "never", "llm-caret-team", "produce fresh bootstrap-owned evidence for this gate"
    caret-provider-wrappers, todo, never, "sh scripts/check/check-caret-suite-bootstrap.shs --gate provider-wrappers", "four-provider wrapper evidence not recorded", "never", "llm-caret-team", "produce fresh bootstrap-owned evidence for this gate"
    caret-agent-manager-primitives, todo, never, "sh scripts/check/check-caret-suite-bootstrap.shs --gate agent-primitives", "agent-manager primitive evidence not recorded", "never", "llm-caret-team", "produce fresh bootstrap-owned evidence for this gate"
