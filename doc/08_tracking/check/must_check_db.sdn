# Updated by scripts/check/check-bootstrap-must-pass.shs. TODO is visible debt,
# never PASS. A fresh successful bootstrap validates and promotes each compiler
# stage, then runs the automated bootstrap-tier gates before recording success.
must_check_ledger:
  schema: "simple.must-check-ledger/v2"
  source_fingerprint: "unrecorded"
  completed_at_utc: "never"
must_check_results |id, status, passed_at_utc, command, evidence, evidence_sha256|
    compiler-stage1, todo, never, "scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap --deploy", "successful Stage 1 receipt required", "never"
    compiler-stage2, todo, never, "scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap --deploy", "successful Stage 2 receipt required", "never"
    compiler-stage3, todo, never, "scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap --deploy", "successful Stage 3 admission receipt required", "never"
    compiler-stage4, todo, never, "scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap --deploy", "successful full Stage 4 CLI receipt required", "never"
    rules-full, todo, never, "sh scripts/check/check-rules-sdl.shs --group full", "bootstrap must-check has not recorded PASS", "never"
    bootstrap-essential-tools, todo, never, "sh scripts/check/check-bootstrap-essential-tools-smoke.shs", "bootstrap must-check has not recorded PASS", "never"
    native-positional-build, todo, never, "sh scripts/check/check-native-inprocess-positional-nonvacuous.shs", "bootstrap must-check has not recorded PASS", "never"
    predicate-parser-native-build, todo, never, "sh scripts/check/check-predicate-parser-native-build.shs", "bootstrap must-check has not recorded PASS", "never"
    native-trailing-defaults, todo, never, "sh scripts/check/check-native-trailing-default-param.shs", "bootstrap must-check has not recorded PASS", "never"
    class-identity-matrix, todo, never, "sh scripts/check/check-class-identity-engine-matrix.shs", "bootstrap must-check has not recorded PASS", "never"
    engine-differential, todo, never, "", "bootstrap differential evidence not recorded", "never"
    sdoctest-markdown-comments, todo, never, "sh scripts/check/check-sdoctest-bootstrap.shs", "full Markdown and comment sdoctest evidence not recorded", "never"
    caret-local-llm-launch, todo, never, "", "Slang has loader readiness but no generation endpoint or Caret provider", "never"
    caret-provider-wrappers, todo, never, "sh scripts/check/check-caret-suite-bootstrap.shs --gate provider-wrappers", "four-provider wrapper evidence not recorded", "never"
    caret-agent-manager-primitives, todo, never, "sh scripts/check/check-caret-suite-bootstrap.shs --gate agent-primitives", "agent-manager primitive evidence not recorded", "never"
    caret-multi-manager-launch, todo, never, "sh scripts/check/check-caret-suite-bootstrap.shs --gate multi-manager", "bootstrap multi-Caret manager evidence not recorded", "never"
    caret-smux-multi-launch, todo, never, "", "os.apps.smux production launch adapter and PTY lifecycle evidence missing", "never"
    web-server-gpu-nginx, todo, never, "", "implementation and retained benchmark evidence required", "never"
    db-server-gpu-sql, todo, never, "", "implementation and retained benchmark evidence required", "never"
    simpleos-sbc-qemu-ls, todo, never, "", "live SBC and matching QEMU receipts required", "never"
    simpleos-clang-hello, todo, never, "", "in-guest filesystem execution receipt required", "never"
    simpleos-simple-toolchain, todo, never, "", "in-guest Simple toolchain execution receipt required", "never"
    simpleos-server-executables, todo, never, "", "in-guest executable receipts required", "never"
    riscv32-riscv64-shared, todo, never, "", "template ownership audit required", "never"
    simple-generated-vhdl-linux, todo, never, "", "generator provenance and Linux boot receipt required", "never"
    binary-size-go-parity, todo, never, "", "retained comparable size measurement required", "never"
    interpreter-startup-parity, todo, never, "", "retained warm and cold launch measurements required", "never"
    rust-go-benchmark-parity, todo, never, "", "retained representative benchmark measurements required", "never"
