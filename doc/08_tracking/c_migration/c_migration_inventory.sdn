# Canonical C-to-Simple migration registry (binary_runtime_hardening Wave 4).
# One entry per migration unit. Markdown views are projections of this file.
# Schema: doc/01_research/infra/sspec_binary/binary_sspec_rt_hardening_frozen_design_2026-08-18.md §13

c_migrations:
  - id: C-MIG-0001
    path: src/runtime/runtime_legacy_core.c
    symbols:
      - rt_crc32_text
    classification: product_algorithm
    replacement: std.nogc_sync_mut.compression.gzip.crc32_text
    simple_callers_migrated:
      - src/lib/nogc_sync_mut/database/core.spl
      - src/lib/nogc_sync_mut/database/wal.spl
    correctness_spec: test/01_unit/lib/nogc_sync_mut/compression/crc32_text_crosslang_spec.spl
    correctness_result: "5 examples, 5 passed (KAT 0xCBF43926 + C-oracle differential incl. UTF-8, 2026-08-18)"
    regression_spec: test/integration/lib/database_core_spec.spl
    regression_result: "35 examples, 35 passed post-migration (2026-08-18)"
    c_status: retained_as_test_oracle
    perf_status: codegen_lane_fail_7.6x_improving — doc/08_tracking/bug/crc32_text_codegen_lane_14x_slower_than_c_2026-08-18.md
    perf_spec: test/05_perf/lib/crc32_text_c_vs_simple_perf_spec.spl
    perf_measured: >
      Interpreter lane, 2026-08-18, body_len 2090, iters 200: O(n^2)
      byte-array rebuild 1185x C; after streaming rewrite 640x C (halved).
      Interpreter lane is NOT the parity verdict (documented ~100-1000x
      envelope); spec enforces a 1000x structural ceiling that fails the
      quadratic class. Native-lane parity verdict still pending a deployed
      fixed compiler.
    fixed_perf_bugs:
      - "PERF: crc32_table() rebuilt per call — cached at module init (val _CRC32_TABLE), 2026-08-18"
      - "PERF: crc32_text built a [u8] via per-byte array copy (O(n^2), 1185x C) — now streams s.bytes() directly (640x C), 2026-08-18"

  - id: C-MIG-0019
    path: src/runtime/runtime_timestamp.c
    symbols:
      - rt_timestamp_from_components
      - rt_timestamp_add_days
      - rt_timestamp_diff_days
      - rt_timestamp_get_year/month/day/hour/minute/second/microsecond
    classification: product_algorithm
    replacement: std.common.time_utils (already implemented — pure Simple, same era-based civil-calendar algorithm)
    simple_callers_migrated: []
    caller_note: >
      Zero product Simple callers of the rt_ forms (verified 2026-08-18:
      only ffi_gen specs and the backend symbol closure reference them).
      Remaining consumers are the Rust seed / generated boundary.
    correctness_spec: test/01_unit/lib/common/time_utils_crosslang_spec.spl
    correctness_result: "5 examples, 5 passed (epoch, leap-day, century, 400-year, pre-epoch, add/diff incl. negatives; 2026-08-18)"
    c_status: retained_as_test_oracle
    perf_status: not_hot_path
