use std.nogc_sync_mut.compression.gzip.compress.{gzip_compress}
use std.nogc_sync_mut.compression.gzip.lz77.{lz77_compress}
use std.nogc_sync_mut.compression.gzip.deflate.{deflate_block_fixed}

fn mkdata(n: i64) -> [u8]:
    var d: [u8] = []
    var i = 0
    loop:
        if i >= n:
            break
        d.push(((i * 7 + (i / 13)) & 0x3f).to_u8())
        i = i + 1
    return d

fn main(args: [string]):
    val n = args[0].to_i64()
    val phase = args[1]
    val d = mkdata(n)
    if phase == "lz77":
        val toks = lz77_compress(d, 6)
        print("toks=" + toks.len().to_string())
    else:
        if phase == "deflate":
            val toks = lz77_compress(d, 6)
            val blk = deflate_block_fixed(toks, true)
            print("out=" + blk.len().to_string())
        else:
            if phase == "mkonly":
                print("d=" + d.len().to_string())
            else:
                val g = gzip_compress(d, 6)
                print("gz=" + g.len().to_string())
