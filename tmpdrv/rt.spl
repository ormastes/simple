use std.nogc_sync_mut.compression.gzip.compress.{gzip_compress, gzip_decompress}

fn same(a, b) -> bool:
    if a.len() != b.len():
        return false
    var i = 0
    loop:
        if i >= a.len():
            break
        if a[i] != b[i]:
            return false
        i = i + 1
    return true

fn hexdump(g) -> string:
    var s = ""
    var i = 0
    loop:
        if i >= g.len():
            break
        s = s + g[i].to_i64().to_string() + " "
        i = i + 1
    return s

fn mkrand(n: i64) -> [u8]:
    var d: [u8] = []
    var st = 999
    var i = 0
    loop:
        if i >= n:
            break
        st = (st * 1103515245 + 12345) & 0x7fffffff
        d.push(((st >> 16) & 0xff).to_u8())
        i = i + 1
    return d

fn mkrep(n: i64) -> [u8]:
    var d: [u8] = []
    var i = 0
    loop:
        if i >= n:
            break
        d.push((65 + (i % 5)).to_u8())
        i = i + 1
    return d

fn mkall() -> [u8]:
    var d: [u8] = []
    var i = 0
    loop:
        if i >= 256:
            break
        d.push(i.to_u8())
        i = i + 1
    return d

fn check(name: string, d: [u8], lvl: i64):
    val g = gzip_compress(d, lvl)
    if val back = gzip_decompress(g):
        var v = "FAIL"
        if same(d, back):
            v = "OK"
        print("RT " + name + " lvl=" + lvl.to_string() + " in=" + d.len().to_string() + " gz=" + g.len().to_string() + " " + v)
    else:
        print("RT " + name + " lvl=" + lvl.to_string() + " DECOMPRESS_NIL")
    print("BYTES " + name + " " + hexdump(g))

fn main():
    var empty: [u8] = []
    check("empty", empty, 6)
    check("allbytes", mkall(), 6)
    check("rand4k", mkrand(4096), 6)
    check("rep8k", mkrep(8192), 6)
    check("rand1k_l1", mkrand(1024), 1)
    check("rep4k_l9", mkrep(4096), 9)
