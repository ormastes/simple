use std.spec.{describe, it, expect}
use app.io.bootstrap_adhoc_main.{
    bootstrap_adhoc_negative_diagnostic, bootstrap_adhoc_positive_marker,
    bootstrap_adhoc_release_admissible
}

describe "worktree-local frontend bootstrap ad-hoc check":
    it "uses exact positive and negative evidence":
        expect(bootstrap_adhoc_positive_marker()).to_equal(
            "BOOTSTRAP_ADHOC_PASS lane=frontend\n"
        )
        expect(bootstrap_adhoc_negative_diagnostic()).to_equal(
            "expected parameter name"
        )

    it "never admits a release":
        expect(bootstrap_adhoc_release_admissible()).to_equal(false)
