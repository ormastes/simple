# SimpleRing async-base Phase 3 qualification ledger.
# Phase 2 ships the pure-Simple source foundation. TODO is visible debt, never PASS.
phase3_tests |id, status, owner, command, required_evidence, unblock_condition|
    SRA-P3-001, todo, compiler-team, "scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap --deploy", "admitted current pure-Simple CLI identity and Stage 4 receipt", "deploy a current pure-Simple bin/simple; Rust bootstrap seed is not admissible"
    SRA-P3-002, todo, async-runtime-team, "SIMPLE_LIB=src bin/simple check src/lib test/01_unit/lib/common/contracts/execution/simple_ring_async_v1_spec.spl test/01_unit/lib/common/contracts/execution/async_profile_v1_spec.spl test/01_unit/lib/nogc_async_mut/async_ring/simple_ring_spec.spl test/01_unit/lib/nogc_async_mut/async_ring/mission_adapter_spec.spl test/01_unit/lib/nogc_async_mut_noalloc/async/async_trace_ring_spec.spl test/01_unit/lib/nogc_async_mut_noalloc/async/mission_ready_set_spec.spl test/02_integration/lib/async/simple_ring_async_base_integration_spec.spl test/02_integration/lib/async/simple_ring_profile_integration_spec.spl test/02_integration/lib/async/simple_ring_future_compat_spec.spl test/02_integration/lib/async/simple_ring_async_base_concurrency_spec.spl test/00_formal_verification/runtime/simple_ring_async_base_bounded_model_spec.spl test/03_system/runtime/simple_ring_async_base_spec.spl", "per-file pure-Simple verdicts with no dropped examples and all five profile/provider outcomes", "SRA-P3-001 PASS"
    SRA-P3-003, todo, async-runtime-team, "bin/simple test test/05_perf/runtime/simple_ring_async_base_perf_spec.spl --mode=native", "before/after p50 p99 p99.9 throughput occupancy high-water full batches kicks max RSS and allocation receipt", "SRA-P3-001 PASS and representative baseline fixture approved"
    SRA-P3-004, todo, test-infra-team, "SIMPLE_COVERAGE=1 SIMPLE_COVERAGE_THRESHOLD=80 bin/simple test test/01_unit/lib/common/contracts/execution/simple_ring_async_v1_spec.spl test/01_unit/lib/common/contracts/execution/async_profile_v1_spec.spl test/01_unit/lib/nogc_async_mut/async_ring/simple_ring_spec.spl test/01_unit/lib/nogc_async_mut/async_ring/mission_adapter_spec.spl test/01_unit/lib/nogc_async_mut_noalloc/async/async_trace_ring_spec.spl test/01_unit/lib/nogc_async_mut_noalloc/async/mission_ready_set_spec.spl --coverage --no-cache", "80 percent or greater branch coverage for every owned implementation file", "SRA-P3-001 PASS and coverage output retains decision and branch data"
    SRA-P3-005, todo, spipe-team, "bin/simple spipe-docgen test/03_system/runtime/simple_ring_async_base_spec.spl --output doc/06_spec --no-index", "generated manual with zero stubs plus sspec-maintain PASS", "SRA-P3-001 PASS and docgen available on deployed CLI"
    SRA-P3-006, todo, compiler-team, "bin/simple check src/compiler", "effect report suspension map typed fixed-frame lowering and zero blocking executor-poll paths", "implement canonical frame/poll lowering and remove rt_future_await from executor poll paths"
    SRA-P3-007, todo, compiler-team, "bin/simple check src/lib/nogc_async_mut_noalloc/async", "compiler/linker placement receipt fixed task and resource pools memory upper bound and post-Ready allocation trace", "preserve fixed storage size and placement through lowering/linking"
    SRA-P3-008, todo, verification-team, "sh scripts/audit/direct-env-runtime-guard.shs --working", "working and staged guards layout guard duplicate scan lint and requirement-by-requirement Phase 3 PASS report", "SRA-P3-002 through SRA-P3-007 PASS"

# Every NFR has an executable Phase 3 gate. Mechanism scenarios may pass before
# qualification; quantified rows stay TODO until their retained evidence exists.
nfr_acceptance |nfr_id, status, test_or_gate, acceptance_evidence|
    NFR-SRA-001, todo, "test/03_system/runtime/simple_ring_async_base_spec.spl + test/05_perf/runtime/simple_ring_async_base_perf_spec.spl", "bounded exact-slot operations and measured O(1)/O(batch-size) scaling"
    NFR-SRA-002, todo, "test/05_perf/runtime/simple_ring_async_base_perf_spec.spl + SRA-P3-007", "finite high-water plus zero post-admission allocation and memory upper bound"
    NFR-SRA-003, todo, "test/03_system/runtime/simple_ring_async_base_spec.spl + SRA-P3-006", "nonblocking compatibility receipt and zero blocking executor-poll events"
    NFR-SRA-004, todo, "test/02_integration/lib/async/simple_ring_profile_integration_spec.spl + test/03_system/runtime/simple_ring_async_base_spec.spl", "deterministic mission policy and overload/provider choice"
    NFR-SRA-005, todo, "test/02_integration/lib/async/simple_ring_async_base_concurrency_spec.spl + test/00_formal_verification/runtime/simple_ring_async_base_bounded_model_spec.spl", "reuse reset cancellation and stale-generation safety"
    NFR-SRA-006, todo, "test/03_system/runtime/simple_ring_async_base_spec.spl + SRA-P3-007", "complete mission evidence bundle with no false proof flags"
    NFR-SRA-007, todo, "SRA-P3-002 + SRA-P3-004", "full boundary matrix and at least 80 percent owned branch coverage"
    NFR-SRA-008, todo, "test/05_perf/runtime/simple_ring_async_base_perf_spec.spl + SRA-P3-003", "retained before/after p50 p99 p99.9 throughput RSS allocation and queue telemetry"
    NFR-SRA-009, todo, "SRA-P3-006 + SRA-P3-003", "sync leaf produces no Future frame scheduler or ring work and has admitted regression measurement"
    NFR-SRA-010, todo, "test/02_integration/lib/async/simple_ring_profile_integration_spec.spl + test/03_system/runtime/simple_ring_async_base_spec.spl", "portable contract and explicit direct/translated/software/emulated mapping facts"
    NFR-SRA-011, todo, "test/02_integration/lib/async/simple_ring_future_compat_spec.spl + test/03_system/runtime/simple_ring_async_base_spec.spl", "exact-token compatibility without weakened backpressure blocking or fallback facts"
    NFR-SRA-012, todo, "SRA-P3-005 + SRA-P3-008", "zero-stub generated manual current docs and requirement-by-requirement verification report"
