fn main():
    val a = (255 & 0xFF).to_u8()
    print("CHK a={a}")
    val b = (300).to_u8()
    print("CHK b={b}")
    val c = (0 - 1).to_u8()
    print("CHK c={c}")
    val d = (4294967296).to_i32()
    print("CHK d={d}")
    val e = (70000).to_u16()
    print("CHK e={e}")
    print("CHK done=1")
