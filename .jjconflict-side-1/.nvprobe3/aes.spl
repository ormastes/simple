use std.common.aes.modes.{aes_cbc_encrypt, aes_cbc_decrypt}

fn main():
    var key: [i64] = []
    var i = 0
    while i < 16:
        key.push(i)
        i = i + 1
    var iv: [i64] = []
    var j = 0
    while j < 16:
        iv.push(255 - j)
        j = j + 1
    var pt: [i64] = []
    var k = 0
    while k < 16:
        pt.push(k * 3)
        k = k + 1
    val ct = aes_cbc_encrypt(pt, key, iv)
    var sum = 0
    var m = 0
    while m < ct.len():
        sum = sum + ct[m]
        m = m + 1
    print("CT_LEN={ct.len()} CT_SUM={sum}")
    if val rt = aes_cbc_decrypt(ct, key, iv):
        var ok = 1
        var n = 0
        while n < pt.len():
            if rt[n] != pt[n]:
                ok = 0
            n = n + 1
        print("ROUNDTRIP_OK={ok}")
    else:
        print("ROUNDTRIP_OK=-1")
    print("done=1")
