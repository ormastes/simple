# Live CUDA evidence for the web GPU-paint route selector.

use std.spec.{describe, it, expect}
use common.render_scene.scene.{scene_fill_rect}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{WebGpuPaintFrame}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_engine2d_presenter.{
    WebGpuPaintTimingEvidence,
    web_gpu_paint_measure_frame,
    web_gpu_paint_sample_frame,
    web_gpu_paint_timing_cache_reset
}
use std.gc_async_mut.io.mod_stub.{env_get}

fn measured_backend() -> text:
    val requested = (env_get("SIMPLE_WEB_GPU_PAINT_MEASURE_BACKEND") ?? "").trim().lower()
    if requested.len() > 0: requested else: "cuda"

fn full_fill_frame() -> WebGpuPaintFrame:
    val width = 64
    val height = 64
    val color = 0xFF1D4ED8u32
    WebGpuPaintFrame(
        fb: [color; width * height],
        fill_ops: [scene_fill_rect(0, 0, width, height, color as i32)],
        width: width,
        height: height,
        base: 0xFFFFFFFFu32,
        cpu_paint_pixels: 0
    )

fn expect_device_measurement(profile: WebGpuPaintTimingEvidence):
    expect(profile.available).to_equal(true)
    expect(profile.sample_count).to_equal(3)
    expect(profile.upload_bound_p50_us).to_be_greater_than(0)
    expect(profile.upload_bound_p95_us).to_be_greater_than(profile.upload_bound_p50_us - 1)
    expect(profile.gpu_paint_p50_us).to_be_greater_than(0)
    expect(profile.gpu_paint_p95_us).to_be_greater_than(profile.gpu_paint_p50_us - 1)
    expect(profile.pixels_match).to_equal(true)
    expect(profile.upload_device_proven).to_equal(true)
    expect(profile.gpu_device_proven).to_equal(true)
    expect(
        profile.reason == "measured-gpu-faster" or
        profile.reason == "measured-gpu-slower-overhead"
    ).to_equal(true)

describe "Web GPU paint measured device route":
    it "measures a full-frame route end to end":
        web_gpu_paint_timing_cache_reset()
        val first = web_gpu_paint_sample_frame(full_fill_frame(), measured_backend(), 0xFFFFFFFFu32)
        expect(first.sample_count).to_equal(1)
        expect(first.available).to_equal(false)
        expect_device_measurement(web_gpu_paint_measure_frame(full_fill_frame(), measured_backend(), 0xFFFFFFFFu32))
