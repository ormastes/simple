use os.kernel.arch.riscv64.starfive.boot.starfive_dtb_policy.{
    starfive_dtb_policy_select,
    STARFIVE_FDT_MAGIC
}

fn main() -> i64:
    var checksum = 0u64
    var i = 0u64
    while i < 50000000u64:
        val candidate = if (i & 3u64) == 0u64: 0u64 else: 0x80000000u64 + i
        val candidate_magic = if (i & 1u64) == 0u64: STARFIVE_FDT_MAGIC else: 0u64
        val fallback_magic = if (i & 7u64) == 0u64: STARFIVE_FDT_MAGIC else: 0u64
        checksum = checksum + starfive_dtb_policy_select(
            candidate, candidate_magic, fallback_magic
        )
        i = i + 1u64
    print "checksum=" + checksum.to_text()
    0
