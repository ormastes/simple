# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: This spec proves svllm pack log mode CLI options.
Audience: Maintainers of the Simple integration suite reviewing this behavior.
"""
# @req: REQ-SVLLMPACKLOGMODES-001
use std.spec.step

use std.spec.{describe, it, expect, step}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn _run_slang_pack(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/slang_pack/main.spl\" " + joined
    ])

describe "slang pack log mode CLI options":
    it "shows shared log options in help":
        # @req: REQ-SVLLMPACKLOGMODES-001
        step("shows shared log options in help")
        val (out, err, code) = _run_svllm_pack(["--help"])
        expect(code).to_equal(0)
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json for usage output":
        step("supports log-mode json for usage output")
        val (out, err, code) = _run_svllm_pack(["--log-mode=json"])
        expect(code).to_equal(0)
        expect(out).to_contain("\"command\":\"slang-pack\"")
        expect(out).to_contain("\"status\":\"usage\"")

    it "supports dot progress for help output":
        step("supports dot progress for help output")
        val (out, err, code) = _run_svllm_pack(["--progress=dot", "--help"])
        expect(code).to_equal(0)
        expect(out).to_start_with(".")
        expect(out).to_contain("slang-pack")

    it "rejects invalid log mode":
        step("rejects invalid log mode")
        val (out, err, code) = _run_svllm_pack(["--log-mode=noisy"])
        expect(code).to_equal(1)

    it "emits json for unknown options":
        # @req REQ-SSPEC-INTEGRATION
        step("emits json for unknown options")
        step("emits json for unknown options")
        val (out, err, code) = _run_svllm_pack(["--log-mode=json", "--bogus"])
        expect(code).to_equal(1)
        expect(out).to_contain("\"command\":\"slang-pack\"")
        expect(out).to_contain("\"status\":\"error\"")
