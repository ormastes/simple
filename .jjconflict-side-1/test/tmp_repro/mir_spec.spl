# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-TMPREPRO
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use spec.{describe, it, expect}

use compiler.mdsoc.transform.feature.typing_to_hir.entity_view.TypedAstView.{TypedAstContext}
use compiler.mdsoc.transform.feature.hir_to_mir.entity_view.HirView.{CfgContext}
use compiler.mdsoc.transform.feature.mir_to_backend.entity_view.MirProgram.{MirProgram}
use compiler.mdsoc.transform.feature.mir_to_backend.entity_view.MirDebugInfo.{MirDebugInfo}
use compiler.mdsoc.transform.feature.lexing_to_parsing.entity_view.TokenStreamView.{TokenStreamView}
use compiler.mdsoc.transform.feature.mir_to_optimizer.entity_view.MirOptView.{MirOptView}
use compiler.mdsoc.transform.feature.backend_to_linker.entity_view.ObjectFileView.{ObjectFileView}
use compiler.mdsoc.transform.feature.loading_to_parsing.entity_view.LoadedModuleView.{LoadedModuleView}

fn main():
    val p = MirProgram.empty()
    print("fc=${p.function_count}")
    p.function_count

describe "MIR empty program":
    """
    Executable specification evidence for MIR program construction:
    a freshly created empty MirProgram must report zero functions.
    """
    it "empty MirProgram reports zero functions":
        # @req REQ-SSPEC-TMPREPRO
        step("construct an empty MirProgram")
        val p = MirProgram.empty()
        expect(p.function_count).to_equal(0)
