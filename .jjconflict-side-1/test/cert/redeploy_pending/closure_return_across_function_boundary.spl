# REDEPLOY-PENDING expected-behavior spec for cert redeploy kit item 2.
#
# A closure created inside a function, capturing that function's parameter, and
# returned to the caller must remain callable and return the correct value.
#
# Expected stdout after the closure-boundary boxing fix is redeployed:
#   105
#
# On the FROZEN deployed binary this prints `<invalid-heap:0x69>` (0x69 == 105:
# the value is computed correctly but returned UNBOXED and misread as a heap
# pointer). Lives under redeploy_pending/ because it fails on the frozen binary.
fn make_adder(base: i64):
    val add_base = \x: x + base
    return add_base

fn main():
    val adder = make_adder(100)
    print(adder(5))   # expected 105
