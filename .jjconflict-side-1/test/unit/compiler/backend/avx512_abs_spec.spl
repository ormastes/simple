# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
AVX-512 VPABSD/Q — byte-level emit golden tests

Tests emit_avx512_vpabsd and emit_avx512_vpabsq from
src/compiler/70.backend/backend/native/x86_64_avx512.spl
against Intel SDM Vol 2C §VPABSD/§VPABSQ encoding.
Register ID convention: zmm_to_index uses id-48, so zmm0=48, zmm1=49, etc.
Golden bytes verified via llvm-mc -triple=x86_64 -mattr=+avx512f --show-encoding.
"""
use std.spec.step

import std.spec

use std.spipe.*
use compiler.backend.native.x86_64_avx512.{emit_avx512_vpabsd, emit_avx512_vpabsq}

fn _list_hex(bytes: [i64]) -> text:
    val hex_chars = "0123456789abcdef"
    var s: text = ""
    var i: u64 = 0
    while i < bytes.len().to_u64():
        val b = bytes[i.to_i64()]
        s = s + hex_chars.char_at(((b / 16) % 16).to_u64())
        s = s + hex_chars.char_at((b % 16).to_u64())
        i = i + 1
    s

val X86_ZMM0 = 48
val X86_ZMM1 = 49
val X86_ZMM2 = 50
val X86_ZMM3 = 51

describe "AVX-512 VPABSD byte-level emit":
    # @manual scenario evidence

    it "VPABSD zmm0, zmm0":
        # @req REQ-SSPEC-UNIT
        step("VPABSD zmm0, zmm0")
        val bytes = emit_avx512_vpabsd(X86_ZMM0, X86_ZMM0)
        expect(_list_hex(bytes)).to_equal("62f27d481ec0")

    it "VPABSD zmm1, zmm3":
        # @req REQ-SSPEC-UNIT
        step("VPABSD zmm1, zmm3")
        val bytes = emit_avx512_vpabsd(X86_ZMM1, X86_ZMM3)
        expect(_list_hex(bytes)).to_equal("62f27d481ecb")

    it "VPABSD output length is 6 bytes":
        # @req REQ-SSPEC-UNIT
        step("VPABSD output length is 6 bytes")
        val bytes = emit_avx512_vpabsd(X86_ZMM0, X86_ZMM0)
        expect(bytes.len()).to_equal(6)

describe "AVX-512 VPABSQ byte-level emit":

    it "VPABSQ zmm0, zmm0":
        # @req REQ-SSPEC-UNIT
        step("VPABSQ zmm0, zmm0")
        val bytes = emit_avx512_vpabsq(X86_ZMM0, X86_ZMM0)
        expect(_list_hex(bytes)).to_equal("62f2fd481ec0")

    it "VPABSQ zmm2, zmm0":
        # @req REQ-SSPEC-UNIT
        step("VPABSQ zmm2, zmm0")
        val bytes = emit_avx512_vpabsq(X86_ZMM2, X86_ZMM0)
        expect(_list_hex(bytes)).to_equal("62f2fd481ed0")

    it "VPABSQ output length is 6 bytes":
        # @req REQ-SSPEC-UNIT
        step("VPABSQ output length is 6 bytes")
        val bytes = emit_avx512_vpabsq(X86_ZMM0, X86_ZMM0)
        expect(bytes.len()).to_equal(6)

    it "VPABSQ W-bit differs from VPABSD (byte index 2)":
        # @req REQ-SSPEC-UNIT
        step("VPABSQ W-bit differs from VPABSD (byte index 2)")
        val d_bytes = emit_avx512_vpabsd(X86_ZMM0, X86_ZMM0)
        val q_bytes = emit_avx512_vpabsq(X86_ZMM0, X86_ZMM0)
        expect(d_bytes[2] == q_bytes[2]).to_equal(false)
