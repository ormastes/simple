# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use app.web_dashboard.server.{DashboardServer}

describe "ios_mode":
    # @manual scenario evidence
    describe "DashboardServer.new_ios":
        it "AC-3: new_ios constructor sets is_ios to true":
            # @req REQ-SSPEC-UNIT
            step("AC-3: new_ios constructor sets is_ios to true")
            val server = DashboardServer.new_ios(3099, "")
            expect(server.is_ios).to_equal(true)

        it "AC-3: new_ios constructor records the port":
            # @req REQ-SSPEC-UNIT
            step("AC-3: new_ios constructor records the port")
            val server = DashboardServer.new_ios(3099, "")
            expect(server.port).to_equal(3099)

        it "AC-3: new (non-iOS) constructor keeps is_ios false":
            # @req REQ-SSPEC-UNIT
            step("AC-3: new (non-iOS) constructor keeps is_ios false")
            val server = DashboardServer.new(3099)
            expect(server.is_ios).to_equal(false)

        it "AC-3: new_with_agent_dir constructor keeps is_ios false":
            # @req REQ-SSPEC-UNIT
            step("AC-3: new_with_agent_dir constructor keeps is_ios false")
            val server = DashboardServer.new_with_agent_dir(3099, "/tmp/agents")
            expect(server.is_ios).to_equal(false)
