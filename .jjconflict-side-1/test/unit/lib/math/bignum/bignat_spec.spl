# BigNat spec — 33 hand-picked KATs covering the variable-length pure-
# Simple BigNat layer. All KATs are public-values; the CT layer is
# exercised separately in fixed_spec.spl.

"""
## Purpose and audience
Verifies the bignat behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

use std.spec.step
use std.math.bignum.limb.{LIMB_BITS, LIMB_BASE, LIMB_MASK}
use std.math.bignum.bignat.{
    bn_zero, bn_one, bn_from_i64,
    is_zero, is_one, normalize, cmp,
    bit_length, get_bit, shift_left_one,
    add, sub, mul, mul_i64, div_mod, modulo,
    from_bytes_be, from_bytes_le, to_bytes_be, to_bytes_le
}

# @req: REQ-BIGNUM-Bignat-001
describe "math.bignum.bignat":
    describe "constructors":
        it "bn_zero is canonical [0]":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: bn_zero is canonical [0]")
            val z = bn_zero()
            expect(z.len()).to_equal(1)  # oracle: value fixed by the spec contract
            expect(z[0]).to_equal(0)  # oracle: value fixed by the spec contract

        it "bn_one is [1]":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: bn_one is [1]")
            val o = bn_one()
            expect(o.len()).to_equal(1)  # oracle: value fixed by the spec contract
            expect(o[0]).to_equal(1)  # oracle: value fixed by the spec contract

        it "bn_from_i64(0) is canonical zero":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: bn_from_i64(0) is canonical zero")
            val r = bn_from_i64(0)
            expect(is_zero(r)).to_equal(true)

        it "bn_from_i64(LIMB_BASE) is two limbs [0, 1]":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: bn_from_i64(LIMB_BASE) is two limbs [0, 1]")
            val r = bn_from_i64(LIMB_BASE)
            expect(r.len()).to_equal(2)  # oracle: value fixed by the spec contract
            expect(r[0]).to_equal(0)  # oracle: value fixed by the spec contract
            expect(r[1]).to_equal(1)  # oracle: value fixed by the spec contract

    describe "predicates":
        it "is_zero true on canonical zero":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: is_zero true on canonical zero")
            expect(is_zero(bn_zero())).to_equal(true)

        it "is_zero false on one":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: is_zero false on one")
            expect(is_zero(bn_one())).to_equal(false)

        it "is_one true on bn_one":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: is_one true on bn_one")
            expect(is_one(bn_one())).to_equal(true)

        it "is_one false on bn_zero":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: is_one false on bn_zero")
            expect(is_one(bn_zero())).to_equal(false)

    describe "normalize":
        it "drops trailing zeros":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: drops trailing zeros")
            val r = normalize([5, 0, 0])
            expect(r.len()).to_equal(1)  # oracle: value fixed by the spec contract
            expect(r[0]).to_equal(5)  # oracle: value fixed by the spec contract

        it "preserves canonical zero":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: preserves canonical zero")
            val r = normalize([0])
            expect(r.len()).to_equal(1)  # oracle: value fixed by the spec contract
            expect(r[0]).to_equal(0)  # oracle: value fixed by the spec contract

        it "leaves already-normalized alone":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: leaves already-normalized alone")
            val r = normalize([1, 2, 3])
            expect(r.len()).to_equal(3)  # oracle: value fixed by the spec contract
            expect(r[2]).to_equal(3)  # oracle: value fixed by the spec contract

    describe "cmp":
        it "returns 0 on equal":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: returns 0 on equal")
            expect(cmp(bn_from_i64(42), bn_from_i64(42))).to_equal(0)  # oracle: value fixed by the spec contract

        it "returns -1 when a < b":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: returns -1 when a < b")
            expect(cmp(bn_from_i64(7), bn_from_i64(11))).to_equal(-1)  # oracle: value fixed by the spec contract

        it "returns 1 when a > b":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: returns 1 when a > b")
            expect(cmp(bn_from_i64(11), bn_from_i64(7))).to_equal(1)  # oracle: value fixed by the spec contract

    describe "add":
        it "single-limb 3 + 4 = 7":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: single-limb 3 + 4 = 7")
            val r = add(bn_from_i64(3), bn_from_i64(4))
            expect(r.len()).to_equal(1)  # oracle: value fixed by the spec contract
            expect(r[0]).to_equal(7)  # oracle: value fixed by the spec contract

        it "carries at LIMB_MASK + 1 = LIMB_BASE":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: carries at LIMB_MASK + 1 = LIMB_BASE")
            val r = add(bn_from_i64(LIMB_MASK), bn_one())
            expect(r.len()).to_equal(2)  # oracle: value fixed by the spec contract
            expect(r[0]).to_equal(0)  # oracle: value fixed by the spec contract
            expect(r[1]).to_equal(1)  # oracle: value fixed by the spec contract

        it "multi-limb carry chain LIMB_MASK + LIMB_MASK":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: multi-limb carry chain LIMB_MASK + LIMB_MASK")
            val r = add(bn_from_i64(LIMB_MASK), bn_from_i64(LIMB_MASK))
            # 2 * (2^30 - 1) = 2^31 - 2 = (LIMB_BASE - 2) + 1 * LIMB_BASE
            # so low limb = LIMB_MASK - 1, high limb = 1.
            expect(r.len()).to_equal(2)  # oracle: value fixed by the spec contract
            expect(r[0]).to_equal(LIMB_MASK - 1)
            expect(r[1]).to_equal(1)  # oracle: value fixed by the spec contract

    describe "sub":
        it "10 - 3 = 7":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: 10 - 3 = 7")
            val r = sub(bn_from_i64(10), bn_from_i64(3))
            expect(r.len()).to_equal(1)  # oracle: value fixed by the spec contract
            expect(r[0]).to_equal(7)  # oracle: value fixed by the spec contract

        it "borrows across limb boundary":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: borrows across limb boundary")
            # LIMB_BASE - 1 = LIMB_MASK (single limb result).
            val r = sub(bn_from_i64(LIMB_BASE), bn_from_i64(1))
            expect(r.len()).to_equal(1)  # oracle: value fixed by the spec contract
            expect(r[0]).to_equal(LIMB_MASK)

        it "returns zero when b >= a":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: returns zero when b >= a")
            val r = sub(bn_from_i64(3), bn_from_i64(10))
            expect(is_zero(r)).to_equal(true)

    describe "mul":
        it "0 * x = 0":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: 0 * x = 0")
            val r = mul(bn_zero(), bn_from_i64(123))
            expect(is_zero(r)).to_equal(true)

        it "small-by-small 7 * 13 = 91":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: small-by-small 7 * 13 = 91")
            val r = mul(bn_from_i64(7), bn_from_i64(13))
            expect(r.len()).to_equal(1)  # oracle: value fixed by the spec contract
            expect(r[0]).to_equal(91)  # oracle: value fixed by the spec contract

        it "LIMB_MASK * LIMB_MASK matches limb_mul corner":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: LIMB_MASK * LIMB_MASK matches limb_mul corner")
            # (2^30 - 1)^2 = 2^60 - 2^31 + 1
            #              = 1 + (LIMB_BASE - 2) * LIMB_BASE
            val r = mul(bn_from_i64(LIMB_MASK), bn_from_i64(LIMB_MASK))
            expect(r.len()).to_equal(2)  # oracle: value fixed by the spec contract
            expect(r[0]).to_equal(1)  # oracle: value fixed by the spec contract
            expect(r[1]).to_equal(LIMB_BASE - 2)

        it "mul_i64 cross-checks against mul":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: mul_i64 cross-checks against mul")
            val a = bn_from_i64(123456)
            val r1 = mul_i64(a, 7)
            val r2 = mul(a, bn_from_i64(7))
            expect(cmp(r1, r2)).to_equal(0)  # oracle: value fixed by the spec contract

    describe "shift / bit access":
        it "shift_left_one of zero stays zero":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: shift_left_one of zero stays zero")
            expect(is_zero(shift_left_one(bn_zero()))).to_equal(true)

        it "shift_left_one(LIMB_MASK) crosses into high limb":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: shift_left_one(LIMB_MASK) crosses into high limb")
            # 2 * (2^30 - 1) = 2^31 - 2; matches add cross-check.
            val r = shift_left_one(bn_from_i64(LIMB_MASK))
            expect(r.len()).to_equal(2)  # oracle: value fixed by the spec contract
            expect(r[0]).to_equal(LIMB_MASK - 1)
            expect(r[1]).to_equal(1)  # oracle: value fixed by the spec contract

        it "bit_length of zero is 0":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: bit_length of zero is 0")
            expect(bit_length(bn_zero())).to_equal(0)  # oracle: value fixed by the spec contract

        it "bit_length of LIMB_BASE is LIMB_BITS + 1":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: bit_length of LIMB_BASE is LIMB_BITS + 1")
            expect(bit_length(bn_from_i64(LIMB_BASE))).to_equal(LIMB_BITS + 1)

        it "get_bit picks individual bits":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: get_bit picks individual bits")
            # 5 = 0b101 -> bits 0 and 2 set, bit 1 clear.
            val a = bn_from_i64(5)
            expect(get_bit(a, 0)).to_equal(1)  # oracle: value fixed by the spec contract
            expect(get_bit(a, 1)).to_equal(0)  # oracle: value fixed by the spec contract
            expect(get_bit(a, 2)).to_equal(1)  # oracle: value fixed by the spec contract

    describe "div_mod":
        it "100 / 7 = (14, 2)":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: 100 / 7 = (14, 2)")
            val pair = div_mod(bn_from_i64(100), bn_from_i64(7))
            expect(pair[0][0]).to_equal(14)  # oracle: value fixed by the spec contract
            expect(pair[1][0]).to_equal(2)  # oracle: value fixed by the spec contract

        it "(LIMB_BASE + 5) mod LIMB_BASE = 5":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: (LIMB_BASE + 5) mod LIMB_BASE = 5")
            val a = add(bn_from_i64(LIMB_BASE), bn_from_i64(5))
            val r = modulo(a, bn_from_i64(LIMB_BASE))
            expect(r.len()).to_equal(1)  # oracle: value fixed by the spec contract
            expect(r[0]).to_equal(5)  # oracle: value fixed by the spec contract

        it "div_mod of x < m gives (0, x)":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: div_mod of x < m gives (0, x)")
            val pair = div_mod(bn_from_i64(3), bn_from_i64(10))
            expect(is_zero(pair[0])).to_equal(true)
            expect(pair[1][0]).to_equal(3)  # oracle: value fixed by the spec contract

    describe "byte encoding":
        it "from_bytes_be 0x0102 = 258":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: from_bytes_be 0x0102 = 258")
            val r = from_bytes_be([1u8, 2u8])
            expect(r.len()).to_equal(1)  # oracle: value fixed by the spec contract
            expect(r[0]).to_equal(258)  # oracle: value fixed by the spec contract

        it "to_bytes_be round-trips 0xDEADBEEF":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: to_bytes_be round-trips 0xDEADBEEF")
            val src: [u8] = [0xDEu8, 0xADu8, 0xBEu8, 0xEFu8]
            val n = from_bytes_be(src)
            val out = to_bytes_be(n, 4)
            expect(out.len()).to_equal(4)  # oracle: value fixed by the spec contract
            expect(out[0]).to_equal(0xDEu8)
            expect(out[1]).to_equal(0xADu8)
            expect(out[2]).to_equal(0xBEu8)
            expect(out[3]).to_equal(0xEFu8)

        it "from_bytes_le is mirror of from_bytes_be":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: from_bytes_le is mirror of from_bytes_be")
            val be = from_bytes_be([1u8, 2u8, 3u8])
            val le = from_bytes_le([3u8, 2u8, 1u8])
            expect(cmp(be, le)).to_equal(0)  # oracle: value fixed by the spec contract

        it "to_bytes_le round-trips small value":
            # @req: REQ-BIGNUM-Bignat-001
            step("Verify: to_bytes_le round-trips small value")
            val n = bn_from_i64(258)
            val out = to_bytes_le(n, 2)
            expect(out[0]).to_equal(2u8)
            expect(out[1]).to_equal(1u8)
