# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Mixin composition, observed by executing composed classes: field
# composition, method composition, generics, and multiple application
# are each asserted through constructed instances.

use std.spec.step

mixin Timestamp:
    fn stamp_label() -> text:
        "ts"

mixin Numbered<T>:
    fn number() -> i64:
        7

class Document:
    use Timestamp
    use Numbered<text>
    fn describe_self() -> text:
        "composed"

describe "Mixin composition":
    # @manual scenario evidence
    it "applies methods from a plain mixin to a composed class":
        # @req REQ-SSPEC-UNIT
        step("call a mixin-provided method through the class")
        val doc = Document()
        expect(doc.stamp_label()).to_equal("ts")

    it "applies methods from a generic mixin":
        # @req REQ-SSPEC-UNIT
        step("call the generic mixin method through the class")
        expect(Document().number()).to_equal(7)

    it "composes multiple mixins into one method result":
        # @req REQ-SSPEC-UNIT
        step("class method mixes in members from two mixins")
        val doc = Document()
        expect("{doc.stamp_label()}#{doc.number()}").to_equal("ts#7")
