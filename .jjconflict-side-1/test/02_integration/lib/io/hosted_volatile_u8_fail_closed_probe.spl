use std.io.hosted_volatile_u8_device.{hosted_volatile_u8_admit}
use std.io.volatile_ops.{volatile_read_u8}

fn main() -> i64:
    # Explicit admission must happen before volatile_ops can select the hosted
    # fallback. The unknown address then fails closed without a raw load.
    if not hosted_volatile_u8_admit():
        return 2
    if volatile_read_u8(4096) == -1:
        return 0
    1
