# codex-system-test
use std.spec.*
use app.io.vhdl_ffi.{ghdl_available, ghdl_unique_workdir, ghdl_analyze_in,
    ghdl_elaborate_in, ghdl_run_in, vhdl_write_file}
use compiler.mir.hwir.types.{CoreConfig}
use compiler.backend.backend.riscv_scalar_runtime_alu_pipeline_to_vhdl.{
    compile_strict_riscv_scalar_runtime_alu_pipeline}

fn runtime_alu_pipeline_testbench(entity_name: text, xlen: i32,
    vectors: text) -> text:
    """
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
use std.env.all;
entity {entity_name}_tb is end entity;
architecture sim of {entity_name}_tb is
  signal clk : std_logic := '0';
  signal rst : std_logic := '0';
  signal in_valid : std_logic := '0';
  signal in_ready : std_logic := '0';
  signal instruction : std_logic_vector(31 downto 0) := (others => '0');
  signal instruction_length_bytes : std_logic_vector(2 downto 0) := (others => '0');
  signal rs1_value : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal rs2_value : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal pc_before : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal fallthrough_pc : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal privilege : std_logic_vector(1 downto 0) := (others => '0');
  signal provider_event_id : std_logic_vector(63 downto 0) := (others => '0');
  signal decode_event_id : std_logic_vector(63 downto 0) := (others => '0');
  signal completion_ready : std_logic := '0';
  signal completion_valid : std_logic := '0';
  signal completion_rd : std_logic_vector(4 downto 0) := (others => '0');
  signal completion_rd_write : std_logic := '0';
  signal completion_rd_value : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal completion_pc_after : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal completion_execute_trap_valid : std_logic := '0';
  signal completion_execute_trap_cause : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal completion_execute_trap_tval : std_logic_vector({xlen - 1} downto 0) := (others => '0');
  signal completion_provider_event_id : std_logic_vector(63 downto 0) := (others => '0');
  signal completion_decode_event_id : std_logic_vector(63 downto 0) := (others => '0');
  signal completion_illegal_valid : std_logic := '0';
  signal runtime_protocol_fault : std_logic := '0';
begin
  dut: entity work.{entity_name} port map(
    clk => clk, rst => rst, in_valid => in_valid, in_ready => in_ready,
    instruction => instruction,
    instruction_length_bytes => instruction_length_bytes,
    rs1_value => rs1_value, rs2_value => rs2_value,
    pc_before => pc_before, fallthrough_pc => fallthrough_pc,
    privilege => privilege, provider_event_id => provider_event_id,
    decode_event_id => decode_event_id, completion_ready => completion_ready,
    completion_valid => completion_valid, completion_rd => completion_rd,
    completion_rd_write => completion_rd_write,
    completion_rd_value => completion_rd_value,
    completion_pc_after => completion_pc_after,
    completion_execute_trap_valid => completion_execute_trap_valid,
    completion_execute_trap_cause => completion_execute_trap_cause,
    completion_execute_trap_tval => completion_execute_trap_tval,
    completion_provider_event_id => completion_provider_event_id,
    completion_decode_event_id => completion_decode_event_id,
    completion_illegal_valid => completion_illegal_valid,
    runtime_protocol_fault => runtime_protocol_fault);
  process
    procedure tick is
    begin
      wait for 1 ns; clk <= '1'; wait for 1 ns; clk <= '0'; wait for 1 ns;
    end procedure;
    procedure drive(
      constant insn : std_logic_vector(31 downto 0);
      constant lhs : std_logic_vector({xlen - 1} downto 0);
      constant rhs : std_logic_vector({xlen - 1} downto 0);
      constant pc_value : std_logic_vector({xlen - 1} downto 0);
      constant event_id : std_logic_vector(63 downto 0)) is
    begin
      in_valid <= '1'; instruction <= insn; instruction_length_bytes <= "100";
      rs1_value <= lhs; rs2_value <= rhs; pc_before <= pc_value;
      fallthrough_pc <= std_logic_vector(unsigned(pc_value) + 4);
      privilege <= "11"; provider_event_id <= event_id; decode_event_id <= event_id;
    end procedure;
  begin
    rst <= '1'; tick; rst <= '0'; wait for 1 ns;
    assert in_ready = '1' and completion_valid = '0' and
      runtime_protocol_fault = '0'
      report "pipeline reset state is invalid" severity failure;
{vectors}    finish;
  end process;
end architecture;
"""

fn runtime_alu_pipeline_rv32_vectors() -> text:
    """
    completion_ready <= '0';
    drive(x"007302B3", x"00000011", x"00000022", x"00000100",
      x"0000000000000007");
    tick;
    assert in_ready = '0' and completion_valid = '0'
      report "RV32 ADD was not captured by the decoded-uop stage" severity failure;
    in_valid <= '0'; tick;
    assert completion_valid = '1' and completion_rd = "00101" and
      completion_rd_write = '1' and completion_rd_value = x"00000033" and
      completion_pc_after = x"00000104" and
      completion_provider_event_id = x"0000000000000007" and
      completion_decode_event_id = x"0000000000000007"
      report "RV32 ADD completion payload is invalid" severity failure;

    instruction <= x"407302B3"; rs1_value <= x"AAAAAAAA";
    rs2_value <= x"55555555"; pc_before <= x"00000200";
    fallthrough_pc <= x"00000204";
    provider_event_id <= x"0000000000000063";
    decode_event_id <= x"0000000000000063";
    tick;
    assert completion_valid = '1' and completion_rd = "00101" and
      completion_rd_value = x"00000033" and completion_pc_after = x"00000104" and
      completion_provider_event_id = x"0000000000000007"
      report "backpressured RV32 completion changed with top-level inputs" severity failure;

    completion_ready <= '1'; tick;
    assert completion_valid = '0'
      report "RV32 completion was not consumed" severity failure;
    completion_ready <= '0'; tick;
    assert completion_valid = '0'
      report "RV32 completion was consumed more than once" severity failure;

    drive(x"0000000F", x"00000000", x"00000000", x"00000300",
      x"0000000000000008");
    tick; in_valid <= '0'; tick;
    assert completion_valid = '0' and runtime_protocol_fault = '1'
      report "legal non-ALU semantic row did not fault closed" severity failure;
    instruction <= x"007302B3"; wait for 1 ns; tick;
    assert runtime_protocol_fault = '1'
      report "semantic ownership fault was not sticky" severity failure;

    rst <= '1'; tick; rst <= '0'; wait for 1 ns;
    assert runtime_protocol_fault = '0' and in_ready = '1' and
      completion_valid = '0'
      report "reset did not recover the faulted RV32 pipeline" severity failure;
    drive(x"007302B3", x"00000002", x"00000003", x"00000400",
      x"0000000000000009");
    tick; in_valid <= '0'; tick;
    assert completion_valid = '1' and completion_rd_value = x"00000005" and
      runtime_protocol_fault = '0'
      report "RV32 pipeline did not retire after reset recovery" severity failure;
    completion_ready <= '1'; tick; completion_ready <= '0';

    drive(x"FFFFFFFF", x"00000000", x"00000000", x"00000500",
      x"000000000000000A");
    tick; in_valid <= '0'; tick;
    assert completion_valid = '1' and completion_illegal_valid = '1' and
      completion_execute_trap_valid = '1' and completion_execute_trap_cause = x"00000002" and
      completion_execute_trap_tval = x"FFFFFFFF" and
      completion_provider_event_id = x"000000000000000A" and
      completion_decode_event_id = x"000000000000000A" and runtime_protocol_fault = '0'
      report "illegal instruction did not produce an architectural completion" severity failure;
    completion_ready <= '1'; tick; completion_ready <= '0';
"""

fn runtime_alu_pipeline_rv64_vectors() -> text:
    """
    completion_ready <= '0';
    drive(x"0010819B", x"000000007FFFFFFF", x"0000000000000000",
      x"0000000000000100", x"0000000000000011");
    tick; in_valid <= '0'; tick;
    assert completion_valid = '1' and completion_rd = "00011" and
      completion_rd_write = '1' and
      completion_rd_value = x"FFFFFFFF80000000" and
      completion_pc_after = x"0000000000000104" and
      completion_provider_event_id = x"0000000000000011" and
      completion_decode_event_id = x"0000000000000011" and
      runtime_protocol_fault = '0'
      report "RV64 ADDIW completion or sign extension is invalid" severity failure;
    completion_ready <= '1'; tick;
    assert completion_valid = '0'
      report "RV64 ADDIW completion was not consumed once" severity failure;
"""

fn simulate_runtime_alu_pipeline(entity_name: text, config: CoreConfig,
    vectors: text) -> bool:
    val emitted = compile_strict_riscv_scalar_runtime_alu_pipeline(entity_name, config)
    if not emitted.is_success(): return false
    val workdir = ghdl_unique_workdir(entity_name)
    if not workdir.?: return false
    val isolated = workdir.unwrap()
    val path = isolated + "/" + entity_name + ".vhd"
    if not vhdl_write_file(path, emitted.vhdl + "\n" +
        runtime_alu_pipeline_testbench(entity_name, config.xlen, vectors)):
        return false
    if not ghdl_analyze_in(path, isolated).success: return false
    if not ghdl_elaborate_in(entity_name + "_tb", isolated).success: return false
    ghdl_run_in(entity_name + "_tb", Some("150ns"), isolated).success

describe "closed runtime scalar ALU pipeline VHDL protocol":
    slow_it "holds and consumes legal completions and latches semantic or illegal faults":
        val available = ghdl_available()
        expect(available).to_equal(true)
        if not available: return
        expect(simulate_runtime_alu_pipeline("runtime_alu_pipeline_ghdl_rv32",
            CoreConfig.rv32(), runtime_alu_pipeline_rv32_vectors())).to_equal(true)
        expect(simulate_runtime_alu_pipeline("runtime_alu_pipeline_ghdl_rv64",
            CoreConfig.rv64(), runtime_alu_pipeline_rv64_vectors())).to_equal(true)
