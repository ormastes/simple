extern fn rt_exit(code: i32)

fn subtract_erased(left, right):
    left - right

fn remove_erased(receiver, key):
    receiver.remove(key)

fn fail(message: text):
    print "FAIL: {message}"
    rt_exit(1)

if subtract_erased(9, 4) != 5:
    fail("Any integer subtraction")

val float_delta = subtract_erased(9.5, 4)
if float_delta < 5.499999 or float_delta > 5.500001:
    fail("Any mixed-f64 subtraction")

var values = [10, 20, 30]
if remove_erased(values, 1) != 20:
    fail("erased array remove result")
if values.len() != 2 or values[0] != 10 or values[1] != 30:
    fail("erased array remove mutation")

var lookup: Dict<text, i64> = {"answer": 42}
if remove_erased(lookup, "answer") != 42:
    fail("erased dict remove result")
if lookup.contains_key("answer"):
    fail("erased dict remove mutation")

print "PASS: Any subtraction and erased collection remove runtime parity"
rt_exit(0)
