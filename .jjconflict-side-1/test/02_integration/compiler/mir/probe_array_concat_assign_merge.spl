# Probe: `x = x + arr` / `x += arr` are desugared by collection_desugar into
# `x.merge(arr)`. Exercises int, text and struct element arrays and merge from
# an empty receiver. Run under native-build and interpret; outputs must match.
# (An alias `val t = xs` before the concat is deliberately NOT here: the
# array-copy loop it lowers to trips a separate pre-existing llc SSA error —
# doc/08_tracking/bug/llvm_text_backend_array_copy_loop_ssa_redefinition_2026-08-22.md)
struct Pt:
    x: i64
    y: i64

fn main() -> i64:
    var xs = [1, 2]
    xs = xs + [3, 4]
    xs += [5]
    print "ints {xs.len()} {xs[0]} {xs[2]} {xs[4]}"
    var ss = ["a"]
    ss = ss + ["b", "c"]
    print "texts {ss.len()} {ss[0]}{ss[1]}{ss[2]}"
    var ps = [Pt(x: 1, y: 2)]
    ps = ps + [Pt(x: 3, y: 4)]
    print "structs {ps.len()} {ps[1].x} {ps[1].y}"
    var empty: [i64] = []
    empty = empty + xs
    print "fromempty {empty.len()} {empty[4]}"
    0
