# @engine-reach: native-by-compile
"""
# Cross-module static error factory integration

Runs the pure-Simple native compiler boundary with stub fallback disabled and
executes the produced candidate. The checker rejects the Rust seed.
"""

extern fn rt_process_run(program: text, args: [text]) -> (text, text, i64)

describe "Native cross-module static factory integration":
    it "should compile and execute both imported factories":
        val (stdout, stderr, status) = rt_process_run("sh", [
            "scripts/check/check-native-crossmodule-static-error-factory.shs"
        ])
        expect(status).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("STATUS: PASS native-crossmodule-static-factory")
        expect(stdout).to_contain("factories=2")
