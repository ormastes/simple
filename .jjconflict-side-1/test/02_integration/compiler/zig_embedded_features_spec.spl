"""
## Purpose and audience
This spec pins the embedded-systems feature surface that Simple adopted from
Zig: the comptime semantic checker, layout and link-section attributes, the
calling-convention bridge, volatile SFFI memory operations, cross-compilation
target presets, and the recorded design contracts for the features that are
still design-stage. It is written for compiler engineers working on the
baremetal and embedded lanes who need product-backed evidence that each
surface answers as documented, not that helper mirrors behave in isolation.

## Operator workflow
Run the file with the self-hosted runner:
`./src/compiler_rust/target/bootstrap/simple run test/02_integration/compiler/zig_embedded_features_spec.spl`.
Every scenario executes real product calls against the compiler modules and the
`app.io` volatile SFFI wrappers; a green run is the acceptance signal for the
embedded feature set on the host lane.

## Compatibility and limitations
Volatile reads and writes route through the interpreter fallback (the host
runtime has no volatile externs), so MMIO scenarios assert the documented
host-fallback behavior rather than real hardware reads. The wffi bindgen and
the error-trace/sentinel features exist only as shipped loader surfaces and
recorded design contracts, so their scenarios probe the shipped source and the
research record instead of a runtime API that does not exist yet.

## Verification guidance and troubleshooting
A failure in the comptime or attribute scenarios means the corresponding
compiler module changed behavior and the embedded lanes must be re-audited
before landing. A failure in a volatile scenario means the SFFI fallback
routing changed and baremetal targets may read garbage on host. A failure in a
source-contract scenario means a shipped file was renamed or restructured;
update the contract scenario in the same change that moves the code.
"""
# Lifecycle: doc/01_research/hardware/baremetal/zig_embedded_features_2026-02-18.md ;
# doc/03_plan/hardware/baremetal/web_baremetal_size_restart_2026-05-28.md ;
# doc/04_architecture/hardware/bare_metal_integration.md ;
# doc/05_design/hardware/baremetal_features_examples.md
# @manual_section: zig embedded feature surfaces

use std.spec.{describe, it, expect}
use std.spec.step
use std.fs.{file_read_text}
use compiler.semantics.comptime_checker.{comptime_checker_reset, comptime_check_expr, comptime_checker_get_warnings, has_non_ct_prefix, is_non_ct_name}
use compiler.common.attributes.{is_power_of_two, validate_alignment}
use compiler.common.diagnostics.span.{Span}
use compiler.backend.link_attrs.{link_section_attr_default, link_section_attr_new, link_attr_is_flash, link_attr_has_placement}
use compiler.backend.callconv_bridge.{callconv_from_string, callconv_resolve_from_flags, callconv_is_valid_name}
use compiler.backend.target_presets.{preset_cortex_m4, preset_wasm32, preset_all_names, preset_is_baremetal}
use app.io.volatile_ops.{volatile_read_u32, memory_barrier, load_barrier, store_barrier}

describe "comptime semantic checker":
    it "flags an rt_ extern call as not const-evaluable":
        # @req REQ-ZIGEMB-001
        # @capture(statistics): comptime warning count for the submitted extern call
        step("Submit an rt_ extern call to the comptime checker and collect its warnings")
        comptime_checker_reset()
        comptime_check_expr("embed_probe", "rt_volatile_read_u32(16)", "extern call")
        val warnings = comptime_checker_get_warnings()
        expect(warnings.len()).to_equal(1)  # oracle: the checker registers exactly one warning for the single extern call

    it "starts with an empty warning registry after a reset":
        # @req REQ-ZIGEMB-002
        # @capture(statistics): comptime warning count on a freshly reset registry
        step("Reset the comptime checker and read the warning registry before any submission")
        comptime_checker_reset()
        val warnings = comptime_checker_get_warnings()
        expect(warnings.len()).to_equal(0)  # oracle: a reset clears every recorded warning, so the registry starts empty

    it "rejects sleep as a known non-const builtin name":
        # @req REQ-ZIGEMB-003
        # @capture(bit_table): non-const name verdicts for sleep and add
        step("Probe the checker builtin-name table with sleep and add")
        val sleep_is_non_ct = is_non_ct_name("sleep")
        val add_is_const_safe = has_non_ct_prefix("add") == false
        expect(sleep_is_non_ct).to_equal(true)
        expect(add_is_const_safe).to_equal(true)

describe "layout attribute wiring":
    it "validates a power-of-two alignment for packed layouts":
        # @req REQ-ZIGEMB-004
        # @capture(bit_table): power-of-two verdict for alignment 16
        step("Ask the layout attribute validator whether 16 is a legal alignment")
        val alignment_is_legal = is_power_of_two(16)
        expect(alignment_is_legal).to_equal(true)

    it "rejects an alignment that is not a power of two":
        # @req REQ-ZIGEMB-005
        # @capture(bit_table): power-of-two verdict for alignment 18
        step("Submit the illegal alignment 18 to the power-of-two check")
        val alignment_is_legal = is_power_of_two(18)
        expect(alignment_is_legal).to_equal(false)

    it "returns the alignment unchanged from the layout validator":
        # @req REQ-ZIGEMB-006
        # @capture(statistics): validated alignment value on the Ok return
        step("Run the alignment validator on a legal span")
        val validated = validate_alignment(16, Span.new(0, 1, 1, 1)).?
        expect(validated).to_equal(16)  # oracle: the validator echoes a legal alignment through the Ok return

describe "link section annotations":
    it "leaves the default link section empty for code without placement":
        # @req REQ-ZIGEMB-007
        # @capture(bit_table): default link-section and address-space emptiness
        step("Build the default link attribute and read its placement fields")
        val default_attr = link_section_attr_default()
        expect(default_attr.section).to_equal("")
        expect(default_attr.addr_space).to_equal("")

    it "carries the ISR vector section into a link attribute":
        # @req REQ-ZIGEMB-008
        # @capture(protocol_json): link attribute carrying the .isr_vector section
        step("Attach the .isr_vector section through the link attribute constructor")
        val isr_attr = link_section_attr_new(".isr_vector", "")
        expect(isr_attr.section).to_equal(".isr_vector")
        expect(link_attr_has_placement(isr_attr)).to_equal(true)

    it "recognizes the flash address space on a link attribute":
        # @req REQ-ZIGEMB-009
        # @capture(bit_table): flash recognition verdict for addr_space flash
        step("Tag a link attribute with the flash address space")
        val flash_attr = link_section_attr_new("", "flash")
        expect(link_attr_is_flash(flash_attr)).to_equal(true)

    it "rejects the ram address space as a flash placement":
        # @req REQ-ZIGEMB-010
        # @capture(bit_table): flash recognition verdict for addr_space ram
        step("Tag a link attribute with the ram address space and re-probe flash recognition")
        val ram_attr = link_section_attr_new("", "ram")
        expect(link_attr_is_flash(ram_attr)).to_equal(false)

describe "calling convention extension":
    it "maps an explicit C calling convention by name":
        # @req REQ-ZIGEMB-011
        # @capture(protocol_json): resolved convention for the explicit C attribute
        step("Resolve the C convention through the calling-convention bridge")
        val resolved = callconv_from_string("C")
        expect(resolved).to_equal("C")

    it "resolves the Naked convention from the naked flag":
        # @req REQ-ZIGEMB-012
        # @capture(protocol_json): resolved convention for the naked flag
        step("Resolve a function carrying only the naked flag")
        val resolved = callconv_resolve_from_flags(true, false, false, "")
        expect(resolved).to_equal("Naked")

    it "falls back to the Simple convention without attributes or flags":
        # @req REQ-ZIGEMB-013
        # @capture(protocol_json): resolved convention for the unattributed default
        step("Resolve a function with no calling-convention attribute and no flags")
        val resolved = callconv_resolve_from_flags(false, false, false, "")
        expect(resolved).to_equal("Simple")

    it "rejects an unknown calling-convention name":
        # @req REQ-ZIGEMB-014
        # @capture(bit_table): validity verdict for the unknown convention name
        step("Submit the fabricated convention name BogusConv to the validator")
        val name_is_valid = callconv_is_valid_name("BogusConv")
        expect(name_is_valid).to_equal(false)

describe "volatile SFFI memory operations":
    it "reads MMIO through the host volatile fallback":
        # @req REQ-ZIGEMB-015
        # @capture(statistics): value returned by the host-fallback volatile read
        step("Issue a volatile read against the peripheral base address on the host")
        val mmio_read = volatile_read_u32(1073872896)
        expect(mmio_read).to_equal(0)  # oracle: host builds have no volatile externs, so the zero fallback answers the read

    it "executes the full load and store SFFI memory fences":
        # @req REQ-ZIGEMB-016
        # @capture(statistics): post-fence volatile read value
        step("Issue the full, load, and store fences in sequence, then re-read MMIO")
        memory_barrier()
        load_barrier()
        store_barrier()
        val post_fence_read = volatile_read_u32(1073872896)
        expect(post_fence_read).to_equal(0)  # oracle: the fences must not disturb the documented host fallback value

    it "keeps repeated volatile reads deterministic under the fallback":
        # @req REQ-ZIGEMB-017
        # @capture(statistics): second volatile read value under the fallback
        step("Issue the same volatile read twice on the host runtime")
        volatile_read_u32(1073872896)
        val second_read = volatile_read_u32(1073872896)
        expect(second_read).to_equal(0)  # oracle: repeated fallback reads answer the same documented value

describe "wffi dynamic loader contract":
    it "ships the wffi loader entry points in the compiler frontend":
        # @req REQ-ZIGEMB-018
        # @capture(bit_table): loader entry-point presence probes over the wsffi source
        step("Read the shipped wsffi module and probe the loader contract")
        val wsffi_loader_source = file_read_text("src/compiler/10.frontend/core/wsffi/mod.spl")
        val wffi_loader_contract_present =
            wsffi_loader_source.contains("fn wffi_load") and
            wsffi_loader_source.contains("fn wffi_get") and
            wsffi_loader_source.contains("fn wffi_close")
        expect(wffi_loader_contract_present).to_equal(true)  # oracle: load/get/close are the shipped wffi loader contract

    it "wires the wffi call ladder for foreign functions":
        # @req REQ-ZIGEMB-019
        # @capture(bit_table): arity-ladder presence probes over the wsffi source
        step("Probe the shipped wsffi module for the zero-to-three argument call ladder")
        val wsffi_loader_source = file_read_text("src/compiler/10.frontend/core/wsffi/mod.spl")
        val wffi_call_ladder_wired =
            wsffi_loader_source.contains("fn wffi_call_0") and
            wsffi_loader_source.contains("fn wffi_call_1") and
            wsffi_loader_source.contains("fn wffi_call_2") and
            wsffi_loader_source.contains("fn wffi_call_3")
        expect(wffi_call_ladder_wired).to_equal(true)  # oracle: the arity ladder is how compiled calls reach foreign functions

describe "cross-compilation target presets":
    it "treats cortex-m4 as a baremetal no-std no-gc preset":
        # @req REQ-ZIGEMB-020
        # @capture(bit_table): baremetal, no-std, and no-gc flags for cortex-m4
        step("Build the cortex-m4 preset and read its execution flags")
        val m4 = preset_cortex_m4()
        expect(preset_is_baremetal(m4)).to_equal(true)
        expect(m4.no_std).to_equal(true)
        expect(m4.no_gc).to_equal(true)

    it "targets thumbv7em for the cortex-m4 preset":
        # @req REQ-ZIGEMB-021
        # @capture(protocol_json): architecture triple component for cortex-m4
        step("Read the architecture component of the cortex-m4 preset")
        val m4 = preset_cortex_m4()
        expect(m4.arch).to_equal("thumbv7em")

    it "targets wasm32 for the wasm preset":
        # @req REQ-ZIGEMB-022
        # @capture(protocol_json): architecture triple component for wasm32
        step("Read the architecture component of the wasm32 preset")
        val wasm = preset_wasm32()
        expect(wasm.arch).to_equal("wasm32")

describe "test and debug block defaults":
    it "defaults the builtin test mode off outside a test harness":
        # @req REQ-ZIGEMB-023
        # @capture(bit_table): builtin test-mode resolution probes over the eval source
        step("Read the interpreter eval surface and probe the test-mode default")
        val eval_source = file_read_text("src/compiler/10.frontend/core/interpreter/eval.spl")
        val builtin_test_mode_defaults_off =
            eval_source.contains("__builtin_test_mode") and
            eval_source.contains("val_make_bool(false)")
        expect(builtin_test_mode_defaults_off).to_equal(true)  # oracle: eval resolves __builtin_test_mode to val_make_bool(false)

    it "defaults the builtin debug mode off beside the test mode":
        # @req REQ-ZIGEMB-024
        # @capture(bit_table): builtin debug-mode resolution probes over the eval source
        step("Read the interpreter eval surface and probe the debug-mode default")
        val eval_source = file_read_text("src/compiler/10.frontend/core/interpreter/eval.spl")
        val builtin_debug_mode_defaults_off =
            eval_source.contains("__builtin_debug_mode") and
            eval_source.contains("val_make_bool(false)")
        expect(builtin_debug_mode_defaults_off).to_equal(true)  # oracle: eval resolves __builtin_debug_mode to val_make_bool(false)

    it "keeps test and debug blocks dormant in default interpreted runs":
        # @req REQ-ZIGEMB-025
        # @capture(bit_table): exact-name resolution arms for both builtin modes
        step("Verify both builtin modes resolve by exact name in the interpreter")
        val eval_source = file_read_text("src/compiler/10.frontend/core/interpreter/eval.spl")
        val both_modes_resolve_by_name =
            eval_source.contains("if name == \"__builtin_test_mode\"") and
            eval_source.contains("if name == \"__builtin_debug_mode\"")
        expect(both_modes_resolve_by_name).to_equal(true)  # oracle: exact-name arms are what keep the blocks dormant by default

describe "error return diagnostics":
    it "returns a diagnostic for a zero alignment":
        # @req REQ-ZIGEMB-026
        # @capture(bit_table): error verdict for the zero alignment
        step("Submit the illegal alignment 0 to the layout validator")
        val zero_alignment_outcome = validate_alignment(0, Span.new(0, 1, 1, 1))
        expect(zero_alignment_outcome.is_err()).to_equal(true)

    it "reports the power-of-two diagnostic for invalid alignment":
        # @req REQ-ZIGEMB-027
        # @capture(bit_table): error verdict for the non-power-of-two alignment
        step("Submit the illegal alignment 3 to the layout validator")
        val odd_alignment_outcome = validate_alignment(3, Span.new(0, 1, 1, 1))
        expect(odd_alignment_outcome.is_err()).to_equal(true)

    it "keeps the success path free of diagnostics":
        # @req REQ-ZIGEMB-028
        # @capture(bit_table): Ok verdict for the legal alignment
        step("Submit the legal alignment 16 and confirm no diagnostic is raised")
        val legal_alignment_outcome = validate_alignment(16, Span.new(0, 1, 1, 1))
        expect(legal_alignment_outcome.is_ok()).to_equal(true)

describe "sentinel type design record":
    it "records the sentinel type design as the CStr contract":
        # @req REQ-ZIGEMB-029
        # @capture(bit_table): design-record probes over the sentinel research document
        step("Read the sentinel research record and probe the CStr design contract")
        val sentinel_design_doc =
            file_read_text("doc/01_research/language/types/sentinel_types_design_2026-02-18.md")
        val null_sentinel_design_recorded =
            sentinel_design_doc.contains("sentinel") and
            sentinel_design_doc.contains("CStr")
        expect(null_sentinel_design_recorded).to_equal(true)  # oracle: the research record is the shipped contract for this design-stage feature

    it "pins the null sentinel as the CStr termination guarantee":
        # @req REQ-ZIGEMB-030
        # @capture(bit_table): termination-guarantee probes over the research record
        step("Probe the sentinel research record for the null-termination guarantee")
        val sentinel_design_doc =
            file_read_text("doc/01_research/language/types/sentinel_types_design_2026-02-18.md")
        val null_termination_guarantee_recorded =
            sentinel_design_doc.contains("null") and
            sentinel_design_doc.contains("terminat")
        expect(null_termination_guarantee_recorded).to_equal(true)  # oracle: termination is the core guarantee the design commits to

describe "embedded preset catalog":
    it "exposes the full cross-compilation preset catalog for embedded lanes":
        # @req REQ-ZIGEMB-031
        # @capture(statistics): total preset count across all target lanes
        step("Enumerate the product target presets")
        val preset_count = preset_all_names().len()
        expect(preset_count).to_equal(12)  # oracle: the product ships twelve presets across baremetal, wasm, and host lanes
