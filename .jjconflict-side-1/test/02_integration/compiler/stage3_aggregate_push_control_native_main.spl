struct Stage3AggregateWalkControl:
    node_key: text
    path: text

fn main() -> i32:
    # No compiler import: this isolates the adjacent generic array/aggregate
    # push shape from the CompileContext entry closure.
    var pending: [Stage3AggregateWalkControl] = []
    pending.push(Stage3AggregateWalkControl(node_key: "root", path: ""))
    pending.push(Stage3AggregateWalkControl(node_key: "child", path: "root.edge"))
    val selected: Stage3AggregateWalkControl = pending[1]
    val adjacent_ok = pending.len() == 2 and selected.node_key == "child" and selected.path == "root.edge"
    print "stage3_aggregate_receiver_adjacent={adjacent_ok}"
    if adjacent_ok:
        return 0
    1
