use std.gc_async_mut.gpu.engine2d.vulkan_session.{VulkanSession}
use std.nogc_sync_mut.gpu.engine2d.sffi_vulkan.{vulkan_sffi_last_error}

fn main() -> i64:
    var session = VulkanSession.create()
    val status = session.init()
    print("vulkan_session_status=" + status.to_text())
    print("vulkan_session_last_error=" + vulkan_sffi_last_error())
    print("vulkan_session_device_name=" + session.device_name)
    print("vulkan_session_device_type=" + session.device_type)
    print("vulkan_session_driver_identity=" + session.driver_identity)
    if status == 0:
        session.release()
    status
