# Shared macOS Vulkan/Metal 2D Draw IR + semantic-event fixture.
#
# Both live backends must consume this exact, backend-neutral composition and
# compare against this exact reducer mutation. The fixture deliberately owns no
# backend creation, font atlas, cache, or renderer handle. Text remains a normal
# DrawIrCommand and therefore lowers through Engine2D's canonical draw_text path.

use common.ui.builder.{button, build_tree, column}
use common.ui.draw_ir.{
    DRAW_IR_BACKEND_GPU,
    DrawIrComposition,
    draw_ir_batch,
    draw_ir_composition,
    draw_ir_embedding_config,
    draw_ir_rect,
    draw_ir_style_prop,
    draw_ir_text_styled
}
use common.ui.event.{process_event}
use common.ui.widget.{UIEvent, UIState}

val MACOS_GPU_2D_FIXTURE_WIDTH: i32 = 3840
val MACOS_GPU_2D_FIXTURE_HEIGHT: i32 = 2160
val MACOS_GPU_2D_FIXTURE_DPI: i32 = 300
val MACOS_GPU_2D_FIXTURE_FONT_PIXELS: i32 = 100
val MACOS_GPU_2D_NATIVE_FOCUS_KIND: i64 = 5
val MACOS_GPU_2D_IDLE_ACCENT: u32 = 0xFF4338CAu32
val MACOS_GPU_2D_ACTIVE_ACCENT: u32 = 0xFF16A34Au32

struct MacosGpu2dSemanticMutation:
    event_name: text
    native_focus_kind: i64
    native_focus_observed: bool
    native_focus_reduced: bool
    before_focus: text
    after_focus: text
    before_accent: u32
    after_accent: u32
    changed: bool

struct MacosGpu2dDrawIrEventFixture:
    composition: DrawIrComposition
    mutation: MacosGpu2dSemanticMutation
    width: i32
    height: i32
    dpi: i32

fn macos_gpu_2d_accent_for_focus(focused_id: text) -> u32:
    if focused_id == "macos-gpu-2d-action":
        return MACOS_GPU_2D_ACTIVE_ACCENT
    MACOS_GPU_2D_IDLE_ACCENT

fn macos_gpu_2d_reduce_native_focus(
    native_focused: bool, native_kind: i64
) -> MacosGpu2dSemanticMutation:
    val root = column(
        "macos-gpu-2d-root",
        [button("macos-gpu-2d-action", "Activate", "activate")]
    )
    val before = UIState.new(build_tree(root))
    val native_focus_reduced = (
        native_focused and native_kind == MACOS_GPU_2D_NATIVE_FOCUS_KIND)
    var after = before
    if native_focus_reduced:
        after = process_event(
            before,
            UIEvent.FocusEvent(
                target_id: "macos-gpu-2d-action",
                kind: "focus"
            )
        )
    MacosGpu2dSemanticMutation(
        event_name: if native_focus_reduced: "focus" else: "",
        native_focus_kind: native_kind,
        native_focus_observed: native_focused,
        native_focus_reduced: native_focus_reduced,
        before_focus: before.focused_id,
        after_focus: after.focused_id,
        before_accent: macos_gpu_2d_accent_for_focus(before.focused_id),
        after_accent: macos_gpu_2d_accent_for_focus(after.focused_id),
        changed: before.focused_id != after.focused_id
    )

fn macos_gpu_2d_frozen_composition(action_accent: u32) -> DrawIrComposition:
    # Full-target, origin-aligned, fully opaque embedding is the executor's
    # direct-parent condition. It preserves the live Engine2D FontRenderer
    # instead of creating a child surface without the selected vector face.
    val embedding = draw_ir_embedding_config(
        "macos-gpu-2d-surface",
        "macos-gpu-2d-scene",
        0,
        0,
        MACOS_GPU_2D_FIXTURE_WIDTH,
        MACOS_GPU_2D_FIXTURE_HEIGHT,
        0,
        1000,
        true
    )
    val text_style = [
        draw_ir_style_prop(
            "font-size", MACOS_GPU_2D_FIXTURE_FONT_PIXELS.to_string()),
        draw_ir_style_prop(
            "line-height", MACOS_GPU_2D_FIXTURE_FONT_PIXELS.to_string())
    ]
    val commands = [
        draw_ir_rect(
            "macos-gpu-2d-background",
            0,
            0,
            MACOS_GPU_2D_FIXTURE_WIDTH,
            MACOS_GPU_2D_FIXTURE_HEIGHT,
            0xFF101522u32
        ),
        draw_ir_rect("macos-gpu-2d-panel", 260, 260, 1500, 900, 0xFF1F2937u32),
        draw_ir_rect("macos-gpu-2d-action", 360, 760, 1000, 240, action_accent),
        draw_ir_text_styled(
            "macos-gpu-2d-title", 360, 370, "Simple 2D 300 DPI",
            0xFFF3F4F6u32, text_style),
        draw_ir_text_styled(
            "macos-gpu-2d-action-label", 520, 820, "Active",
            0xFFFFFFFFu32, text_style)
    ]
    val batch = draw_ir_batch(
        "macos-gpu-2d-frozen-batch",
        DRAW_IR_BACKEND_GPU,
        embedding,
        commands
    )
    draw_ir_composition(
        "macos-gpu-2d-frozen-composition-v1",
        "macos-gpu-2d-frozen-scene-v1",
        DRAW_IR_BACKEND_GPU,
        [batch]
    )

fn macos_gpu_2d_draw_ir_event_fixture(
    native_focused: bool, native_kind: i64
) -> MacosGpu2dDrawIrEventFixture:
    val mutation = macos_gpu_2d_reduce_native_focus(
        native_focused, native_kind)
    MacosGpu2dDrawIrEventFixture(
        composition: macos_gpu_2d_frozen_composition(mutation.after_accent),
        mutation: mutation,
        width: MACOS_GPU_2D_FIXTURE_WIDTH,
        height: MACOS_GPU_2D_FIXTURE_HEIGHT,
        dpi: MACOS_GPU_2D_FIXTURE_DPI
    )
