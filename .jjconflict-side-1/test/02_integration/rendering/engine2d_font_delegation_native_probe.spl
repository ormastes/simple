use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.text_layout.font_renderer.{FontRenderer}

fn main() -> i64:
    var engine = Engine2D.create_offscreen(8, 8)
    if engine.selected_font_identity() != "":
        print("engine2d_font_delegation_native_status=fail-initial")
        return 1

    engine.install_font_renderer(FontRenderer.new())
    val installed = engine.fonts()
    if installed.has_sffi_ttf():
        print("engine2d_font_delegation_native_status=fail-installed")
        return 2

    engine.unload_font()
    if engine.selected_font_identity() != "":
        print("engine2d_font_delegation_native_status=fail-clear")
        return 3

    val recreated = engine.fonts()
    if recreated.has_sffi_ttf():
        print("engine2d_font_delegation_native_status=fail-recreated")
        return 4
    engine.unload_font()
    engine.shutdown()

    print("engine2d_font_delegation_native_status=pass")
    0
