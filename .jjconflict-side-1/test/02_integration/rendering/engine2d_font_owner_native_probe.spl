use std.gc_async_mut.gpu.engine2d.font_owner.{
    Engine2DFontOwner,
    engine2d_font_owner_current,
    engine2d_font_owner_get_or_create,
    engine2d_font_owner_store
}
use std.gc_async_mut.text_layout.font_renderer.{
    font_renderer_registered_selected_bytes_only
}

fn main() -> i64:
    var owner = Engine2DFontOwner.new()
    match engine2d_font_owner_current(owner):
        case Some(_):
            print("engine2d_font_owner_native_status=fail-initial-state")
            return 1
        case None:
            pass_do_nothing("empty owner is the required initial state")

    val first = engine2d_font_owner_get_or_create(owner)
    if first.has_sffi_ttf():
        print("engine2d_font_owner_native_status=fail-unexpected-face")
        return 2
    owner = engine2d_font_owner_store(owner, first)

    match engine2d_font_owner_current(owner):
        case Some(active):
            if active.has_sffi_ttf():
                print("engine2d_font_owner_native_status=fail-first-read")
                return 3
        case None:
            print("engine2d_font_owner_native_status=fail-missing-first-read")
            return 4

    val second = engine2d_font_owner_get_or_create(owner)
    if second.has_sffi_ttf():
        print("engine2d_font_owner_native_status=fail-second-read")
        return 5

    if font_renderer_registered_selected_bytes_only():
        print("engine2d_font_owner_native_status=fail-first-lock")
        return 6
    if font_renderer_registered_selected_bytes_only():
        print("engine2d_font_owner_native_status=fail-second-lock")
        return 7

    print("engine2d_font_owner_native_status=pass")
    0
