# codex-integration-test
"""# SimpleOS host-GPU guest ISA contract

Keeps the canonical three-ISA evidence matrix as the default while allowing
the macOS live lane to build and boot only its current AArch64 guests.
"""

use std.spec.*
use std.io_runtime.{process_run}
use app.io.mod.{file_read_text}

fn wrapper_source() -> text:
    file_read_text("scripts/check/check-simpleos-qemu-host-gpu-2d.shs")

describe "SimpleOS host-GPU guest ISA selection":
    it "accepts only the canonical matrix or exact AArch64 lane":
        val (out, err, code) = process_run(
            "/bin/sh",
            ["scripts/check/check-simpleos-qemu-host-gpu-2d.shs", "--self-test-guest-isas"],
        )
        expect(code).to_equal(0)
        expect(err).to_equal("")
        expect(out).to_contain("simpleos_qemu_host_gpu_2d_guest_isa_contract_self_test=pass")

    it "keeps selection ahead of daemon and guest execution":
        val source = wrapper_source()
        expect(source).to_contain("set_guest_isa_contract()")
        expect(source).to_contain("GUEST_ISA_REQUEST=x86_64,aarch64,riscv64")
        expect(source).to_contain("GUEST_ISAS=\"x86_64 aarch64 riscv64\"")
        expect(source).to_contain("GUEST_ISAS=aarch64")
        expect(source).to_contain("for isa in $GUEST_ISAS; do")
        expect(source).to_contain("daemon_entry=src/app/simpleos_gpu_host/main_macos.spl")
        expect(source).to_contain("SIMPLEOS_HOST_GPU_USE_EXISTING_GUESTS")
