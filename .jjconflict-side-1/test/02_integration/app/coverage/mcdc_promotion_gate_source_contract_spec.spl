# @req REQ-005 NFR-008
# @evidence-class source-contract

use std.io.{file_read}
use std.spec.{describe, it, expect, step}

val RUNTIME = "src/runtime/runtime_coverage_core.c"
val CLI = "src/app/coverage/main.spl"
val PURE_BOUNDARY = "src/lib/nogc_sync_mut/io/coverage_mcdc.spl"

describe "MC/DC production promotion gate source contract":
    it "fails every admitted runtime report mode below exact coverage":
        step("Inspect the allocation-free runtime report return policy")
        val source = file_read(RUNTIME)
        expect(source).to_contain("if (!report->gate_passed)")
        expect(source).to_contain("return SIMPLE_MCDC_V1_GATE_FAILED;")
        expect(source.contains(
            "mode == SIMPLE_MCDC_REPORT_NORMAL_V1 && !report->gate_passed")).to_equal(false)

    it "does not bypass alpha or beta in CLI reporting":
        step("Inspect the CLI promotion-mode mapping and exit contract")
        val source = file_read(CLI)
        expect(source).to_contain("McdcReportModeV1.Alpha")
        expect(source).to_contain("McdcReportModeV1.Beta")
        expect(source).to_contain("MC/DC gate=FAIL reason=eligible coverage is not exactly 100%")
        expect(source.contains("gate=NOT_ENFORCED")).to_equal(false)

    it "exposes complete bounded V2 rows without changing the V1 default":
        step("Inspect V2 caller-owned storage and cold-path output bounds")
        val cli = file_read(CLI)
        val boundary = file_read(PURE_BOUNDARY)
        expect(cli).to_contain("get_arg(args, \"--report-version\", \"v1\")")
        expect(cli).to_contain("MC/DC decision index=")
        expect(cli).to_contain("MC/DC witness index=")
        expect(cli).to_contain("MC/DC merge_process index=")
        expect(cli).to_contain("MC/DC merged_witness decision_id=")
        expect(cli).to_contain("exceeds --max-output-lines")
        expect(cli).to_contain("mcdc_runtime_merge_reports_v2")
        expect(boundary).to_contain("Build a complete V2 report using only caller-owned fixed buffers")
        expect(boundary).to_contain("binary_identity_sha256.len() != 64")
