use std.spec
use std.io_runtime.{file_write, file_delete}
use app.lsp.lsp_handlers.{lsp_handle_completion, lsp_handle_hover}
use app.lsp.lsp_json.{Q}

fn query_fixture_path() -> text:
    "/tmp/simple_lsp_test_query_stdout_spec.spl"

fn position_body(line: i64, col: i64) -> text:
    "{\"textDocument\":{\"uri\":\"file://" + query_fixture_path() + "\"},\"position\":{\"line\":" + str(line) + ",\"character\":" + str(col) + "}}"

describe "LSP visibility query stdout filtering":
    it "returns completion JSON despite bootstrap diagnostics":
        val code = "fn my_completable_function() -> i64:\n    42\n\nfn use_it() -> i64:\n    my_comp"
        expect(file_write(query_fixture_path(), code)).to_equal(true)
        val response = lsp_handle_completion("1", position_body(4, 7))
        expect(response).to_contain("my_completable_function")
        file_delete(query_fixture_path())

    it "returns hover JSON despite bootstrap diagnostics":
        val code = "fn my_completable_function() -> i64:\n    42\n"
        expect(file_write(query_fixture_path(), code)).to_equal(true)
        val response = lsp_handle_hover("2", position_body(0, 5))
        expect(response).to_contain("fn my_completable_function")
        expect(response).to_contain("Visibility")
        file_delete(query_fixture_path())
