# @req REQ-001 REQ-005 REQ-006 REQ-009 REQ-015
use std.spec.{describe, it, expect}
use std.common.debug.capability.{CapLevel}
use std.common.debug.contracts_v1.{DebugVerificationV1}
use std.common.debug.service_v1.{
    central_debug_service_v1_graph, central_debug_service_v1_receipts,
    central_debug_service_v1_session,
}
use app.debug.interpreter_service_adapter_v1.{
    InterpreterDebugServiceAdapterV1, interpreter_expression_is_pure_lookup_v1,
}

val INTERPRETER_FIXTURE = "test/fixtures/debug/interpreter_vertical_slice.spl"

describe "existing Simple interpreter through DebugServiceV1":
    it "binds launch target and semantic breakpoint to exact build and session":
        var adapter = InterpreterDebugServiceAdapterV1.create()
        val session_id = adapter.launch(INTERPRETER_FIXTURE, [])?
        val graph = central_debug_service_v1_graph(session_id)?
        expect(graph.build_id).to_start_with("sha256:")
        expect(graph.nodes.len()).to_equal(1)
        expect(graph.nodes[0].kind).to_equal("runtime.simple.interpreter")
        expect(graph.capabilities[0].support).to_equal(CapLevel.Native)
        expect(graph.capabilities[0].verification).to_equal(DebugVerificationV1.FixtureVerified)
        val breakpoint = adapter.set_semantic_breakpoint(INTERPRETER_FIXTURE, 5, "fixture.main.answer")?
        expect(breakpoint.source_anchor).to_equal(INTERPRETER_FIXTURE + ":5")
        expect(breakpoint.symbol_id).to_equal("fixture.main.answer")
        adapter.close()?
        expect(central_debug_service_v1_session(session_id)?.open).to_equal(false)

    it "returns structured stack and locals without inventing concurrency state":
        var adapter = InterpreterDebugServiceAdapterV1.create()
        val session_id = adapter.launch(INTERPRETER_FIXTURE, [])?
        val frames = adapter.stack()?
        val locals = adapter.locals()?
        expect(frames.len()).to_be_greater_than(-1)
        expect(locals.len()).to_be_greater_than(-1)
        val concurrency = adapter.concurrency_snapshot()
        expect(concurrency.tasks_available).to_equal(false)
        expect(concurrency.actors_available).to_equal(false)
        expect(concurrency.queues_available).to_equal(false)
        expect(concurrency.verification).to_equal(DebugVerificationV1.Blocked)
        expect(concurrency.reason).to_contain("no task/actor/queue")
        expect(central_debug_service_v1_receipts(session_id).len()).to_be_greater_than(4)
        adapter.close()?

    it "permits only the existing backend pure local lookup shape":
        expect(interpreter_expression_is_pure_lookup_v1("answer")).to_equal(true)
        expect(interpreter_expression_is_pure_lookup_v1("answer()" )).to_equal(false)
        expect(interpreter_expression_is_pure_lookup_v1("answer = 9")).to_equal(false)
        var adapter = InterpreterDebugServiceAdapterV1.create()
        val session_id = adapter.launch(INTERPRETER_FIXTURE, [])?
        match adapter.evaluate_pure("answer()"):
            case Ok(_): expect(false).to_equal(true)
            case Err(reason): expect(reason).to_contain("impure")
        expect(central_debug_service_v1_receipts(session_id).last().allowed).to_equal(false)
        adapter.close()?
