use app.configc.compiler.{compile_composition_text_v1}

extern fn rt_file_read_bytes(path: text) -> [u8]?

val OUTPUT = "/tmp/simple_configc_composition_v1_roundtrip.sci"
val SOURCE = "schema: simple.composition/1\nprofile: test\napps:\n  - id: editor\n    name: Editor\n    artifact: /sys/apps/editor.smf\n    associations: [.spl]\n"

describe "simple-configc first composition slice":
    it "REQ-001 writes a read-back-verified SCI without building a provider":
        val result = compile_composition_text_v1(SOURCE, OUTPUT)
        expect(result.ok).to_equal(true)
        expect(result.code).to_equal("CONFIGC_OK")
        expect(result.byte_count > 148).to_equal(true)
        expect(result.composition_digest.len()).to_equal(64)
        val bytes = rt_file_read_bytes(OUTPUT) ?? []
        expect(bytes.len()).to_equal(result.byte_count)
