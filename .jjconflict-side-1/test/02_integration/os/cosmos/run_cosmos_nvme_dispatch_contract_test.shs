#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
source_dir="$root/src/os/kernel/arch/arm32/cosmos"
test_source="$root/test/02_integration/os/cosmos/cosmos_nvme_dispatch_contract_test.c"
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-nvme-dispatch-contract.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

common_flags='-std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wformat=2'
units='cosmos_nvme_firmware cosmos_nvme_admin cosmos_nvme_pcie_adapter cosmos_nvme_dispatch'

cc $common_flags -DCOSMOS_MMIO_TEST=1 -I"$source_dir" "$test_source" \
    "$source_dir/cosmos_nvme_firmware.c" \
    "$source_dir/cosmos_nvme_admin.c" \
    "$source_dir/cosmos_nvme_pcie_adapter.c" \
    "$source_dir/cosmos_nvme_dispatch.c" \
    -o "$build_dir/cosmos_nvme_dispatch_contract_test"
"$build_dir/cosmos_nvme_dispatch_contract_test"

for unit in $units; do
    clang --target=armv7-none-eabi -mcpu=cortex-a9 -marm \
        -ffreestanding -nostdlib -fno-builtin $common_flags \
        -I"$source_dir" -c "$source_dir/$unit.c" \
        -o "$build_dir/$unit.arm.o"
done

echo "cosmos NVMe dispatcher ARM compile: PASS"
