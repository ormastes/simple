#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
source_dir="$root/src/os/kernel/arch/arm32/cosmos"
test_source="$root/test/02_integration/os/cosmos/cosmos_storage_startup_contract_test.c"
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/cosmos-storage-startup.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

common_flags='-std=c11 -O2 -Wall -Wextra -Werror -Wpedantic -Wshadow -Wstrict-prototypes -Wformat=2'
arm_flags='--target=armv7-none-eabi -mcpu=cortex-a9 -marm -ffreestanding -nostdlib -fno-builtin'

cc $common_flags -DCOSMOS_MMIO_TEST=1 -I"$source_dir" \
    "$test_source" "$source_dir/cosmos_storage.c" \
    -o "$build_dir/cosmos_storage_startup_test"
"$build_dir/cosmos_storage_startup_test"

clang $arm_flags $common_flags -I"$source_dir" \
    -c "$source_dir/cosmos_storage.c" \
    -o "$build_dir/cosmos_storage_qemu.arm.o"

clang $arm_flags $common_flags -DCOSMOS_SILICON=1 \
    -include "$source_dir/cosmos_profile_openssd2_8ch8way_v300.h" \
    -I"$source_dir" -c "$source_dir/cosmos_storage.c" \
    -o "$build_dir/cosmos_storage_silicon.arm.o"

echo "cosmos storage startup ARM profiles compile: PASS"
