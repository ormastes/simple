"""
## Purpose and audience
Acceptance oracles for the open remains of
doc/03_plan/compiler/startup_performance/startup_perf_plan_2026-08-17.md.
Audience: the compiler implementer closing Phase B's component-fold-static
proof, Phase C's zero-rebuild CLI surface, and Phase E's growth-band gate;
and the reviewer confirming each pinned interface's real computed contract.
## Operator workflow
bin/simple test test/03_system/plan_acceptance/startup_perf_plan_spec.spl
Each scenario below calls the real, already-implemented decision function for
its phase (or, where the plan names no concrete symbol yet, a deliberately
unresolved forcing-function import) and asserts a real computed verdict —
never a hardcoded stand-in string.
## Compatibility and limitations
Tagged in-development: these pin the promised INTERFACE and fail until the
plan's remaining checkboxes are implemented.

Coverage note: the plan's third open checkbox ("REMAINING — per-phase
before/after snapshot spec with growth band") names no existing function
anywhere in `src/` (verified via `grep -rn growth_band src/` before writing
this file: zero hits). The Phase E acceptance text only promises "a spec
[that] compares two committed snapshots and fails on unexplained growth
beyond a configured band" — no concrete symbol. `deps_growth_band_verdict`
below is this lane's forcing-function name for that promised interface,
chosen to mirror the `src/app/deps/` module the plan already owns; its
absence is deliberate (unresolved-symbol load failure, neutralized by the
in-development tag) rather than an oversight.
## Verification
A green run means `resolve_component_verdict`, the CLI-surface snapshot and
migration-report functions, and (once landed) `deps_growth_band_verdict` all
answer with the documented literal verdict strings. Troubleshooting: a load
failure naming `deps_growth_band_verdict` unresolved is the intended
in-development signal for the still-missing Phase E checkbox, not a harness
defect.
## Lifecycle
doc/01_research/compiler/startup_performance/startup_perf_architecture_2026-08-17.md
doc/03_plan/compiler/startup_performance/startup_perf_plan_2026-08-17.md
doc/04_architecture/startup/00_startup_architecture.md
doc/05_design/compiler/incremental_build/per_lane_private_caches.md
"""
# @tag:in-development
# doc-path: doc/03_plan/compiler/startup_performance/startup_perf_plan_2026-08-17.md
# @cover src/lib/common/structural/component/descriptor.spl 20%
# @cover src/app/cli/help_surface_report.spl 20%
# @manual_section "Startup-perf plan Phase B/C/E remains"

use std.spec.{describe, context, it, expect, step}
use std.common.structural.component.descriptor.{
    component_v1_make,
    resolve_component_verdict
}
use app.cli.help_surface_inventory.{
    CliSurfaceSnapshotV1,
    cli_surface_snapshot_v1,
}
use app.cli.help_surface_report.{
    cli_surface_migration_report_markdown_v1,
    cli_surface_completion_candidates_v1,
}
use app.deps.growth_band.{deps_growth_band_verdict}

describe "plan: compiler/startup_performance/startup_perf_plan_2026-08-17 remains":

    context "Phase B — config-driven dynload axes":

        it "NOT-STARTED — planned src/lib/common/structural/component/ (ComponentDescriptorV1, resolve_component) does not exist; the landed implementation lives on the dynsmf path instead. Fold-static-on-full-rebuild (placement=auto) bootstrap proof not evidenced.":
            # @req REQ-STARTUP-001
            step("Build a real ComponentDescriptorV1 catalog entry for the optimizer component")
            # Interface pin: the still-open half of this checkbox is the
            # BOOTSTRAP proof ("modify optimizer source, rebuild only
            # optimizer.smf ... then full rebuild and the same run shows
            # resolution=STATIC", Phase B acceptance list). That proof rests
            # on resolve_component's placement=auto fold decision: a
            # matching embedded/configured impl-hash digest must fold to
            # "static", and a stale digest must fall back to "dynamic".
            # This pins that decision-table contract with real computed
            # verdicts (component_v1_make / resolve_component_verdict both
            # exist under std.common.structural.component.descriptor); it
            # does not itself run a bootstrap rebuild.
            val catalog = [component_v1_make(1, "optimizer.basic", "1", "auto", "auto", "command")]
            step("Resolve the verdict when the embedded digest matches the configured digest")
            val matching_digest = resolve_component_verdict(catalog, "optimizer.basic", "sha256:aaaa", "sha256:aaaa")
            # @capture matching_digest is the real computed verdict string from resolve_component_verdict(...)
            expect(matching_digest).to_equal("ok:static:command:presence=auto,placement=auto,activation=command")
            step("Resolve the verdict when the embedded digest is stale against the configured digest")
            val stale_digest = resolve_component_verdict(catalog, "optimizer.basic", "sha256:aaaa", "sha256:bbbb")
            # @capture stale_digest is the real computed verdict string for the stale-digest branch
            expect(stale_digest).to_equal("ok:dynamic:command:presence=auto,placement=auto,activation=command")

    context "Phase C — dynamic CLI args without core rebuild":

        it "REMAINING — C4 help/completion generator from SCI + migration report of hardcoded options; zero-rebuild sha256 proof not recorded here.":
            # @req REQ-STARTUP-002
            step("Take a real CLI-surface snapshot (SCI) of the deployed command inventory")
            # Interface pin: the help/completion generator and migration
            # report ARE implemented (cli_surface_migration_report_markdown_v1,
            # cli_surface_completion_candidates_v1 under app.cli.help_surface_report),
            # so this pins their real computed contract: a fresh snapshot
            # must report zero table-only (hardcoded, unregistered) drift,
            # and completion must resolve a known prefix to its exact
            # candidate set. This does NOT cover the checkbox's separate
            # "zero-rebuild sha256 proof" sub-claim, which is a bootstrap
            # build-artifact proof with no promised function anywhere in
            # src/ (verified absent) and is out of scope for an interface
            # oracle.
            val snapshot = cli_surface_snapshot_v1()
            step("Render the migration report and assert zero table-only (hardcoded) drift")
            val report = cli_surface_migration_report_markdown_v1(snapshot, "2026-09-05")
            # @capture report is the real generated migration-report markdown for the live snapshot
            expect(report).to_contain("## Table-only (0)")
            step("Resolve completion candidates for the real \"bu\" prefix against the live snapshot")
            val candidates = cli_surface_completion_candidates_v1(snapshot, "bu")
            # @capture candidates is the real computed completion set for prefix \"bu\"
            expect(candidates).to_equal(["bug-add", "bug-gen", "bug-resolve", "build"])

    context "Phase E — coupling/cohesion gates":

        it "REMAINING — per-phase before/after snapshot spec with growth band not found; snapshots are one baseline, not a bracketing series.":
            # @req REQ-STARTUP-003
            step("Load the committed baseline and current CLI-dir-aggregate edge counts")
            # Interface pin: Phase E's acceptance text promises "a spec
            # [that] compares two committed snapshots and fails on
            # unexplained growth beyond a configured band". No such
            # function exists in src/ yet. deps_growth_band_verdict(
            # baseline_edges, current_edges, band_pct) -> text is this
            # lane's forcing-function shape for that interface: given the
            # committed baseline CLI-dir-aggregate edge count (1298 files,
            # doc/10_metrics/startup/coupling_cohesion_baseline_2026-08-17.md)
            # and a same-or-smaller current count, the verdict must read
            # "within_band" — never a silent pass on an unmeasured delta.
            val baseline_closure_files = 1298
            val current_closure_files = 1298
            step("Resolve the growth-band verdict for the same-count baseline/current pair")
            val verdict = deps_growth_band_verdict(baseline_closure_files, current_closure_files, 0.15)
            # oracle: "within_band" is the documented verdict string for a same-or-smaller
            # current count against the committed baseline (Phase E acceptance text); a
            # different or missing string signals unexplained growth rather than a silent pass
            # @capture verdict is the real computed return value of deps_growth_band_verdict(...)
            expect(verdict).to_equal("within_band")
