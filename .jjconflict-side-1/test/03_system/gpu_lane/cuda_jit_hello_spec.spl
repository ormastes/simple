# @cover src/lib/gc_async_mut/gpu_lane/cuda_jit_lane_executor.spl 70%
# cuda_jit lane executor -- system spec (Task B2).
# @tag: system, gpu, cuda, jit
#
# Design: doc/05_design/runtime/gpu_remote_interpreter_architecture.md §5.1.
# Plan: doc/03_plan/agent_tasks/gpu_remote_interpreter_parallel_plan_2026-08-07.md
# (Stream B, task B2).
#
# Covers:
#   1. The ten-row CUDA validation table (doc/03_plan/sys_test/
#      cuda_host_validation_2026-07-11.md) applied to `validate_ptx_artifact`
#      -- pure/host-independent, so every row FAILs deterministically
#      regardless of whether this host has a CUDA device (malformed PTX,
#      rejected target, nonexistent entry, and 7 more rows below).
#   2. Lane-log recording (SHA-256/.target/entries into the LOG ring) --
#      also host-independent.
#   3. The live vector-add "hello" dispatch: on a CUDA host it launches,
#      syncs, drains an expected RECORD, and reads the GMB-1 EXIT sentinel
#      `0xCAFE0000`; on a host without a live device it SKIPs cleanly,
#      matching the `probe().starts_with("skip:")` contract established by
#      B1's own spec (test/02_integration/gpu_lane/cuda_lane_session_spec.spl).

"""
## Purpose and audience
Purpose: row 1: empty PTX artifact -> FAIL (never SKIP)
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-GPU_LANE-CudaJitHell-001

use std.spipe.*
use std.gc_async_mut.gpu_lane.cuda_jit_lane_executor.{
    CudaJitLaneExecutor, PtxArtifact, VECTOR_ADD_ENTRY,
    validate_ptx_artifact, format_lane_log_line, record_artifact_in_lane_log}
use std.nogc_sync_mut.test_runner.gpu_mailbox.{MailboxArena, ARENA_SIZE, SENTINEL_EXIT_MASK, drain_log}

# A structurally-valid PTX module (all three header markers, a valid
# `sm_86` target, one entry named `vector_add`) used as the positive
# baseline that every negative row below mutates exactly one way.
fn _valid_ptx() -> text:
    ".version 8.0\n" +
    ".target sm_86\n" +
    ".address_size 64\n" +
    "\n" +
    ".visible .entry vector_add(\n" +
    ".param .u64 param_0\n" +
    ")\n" +
    "{\n" +
    "ret;\n" +
    "}\n"

describe "cuda_jit lane executor -- ten-row CUDA validation table (host-independent, always FAIL not SKIP)":
    """
    Every row of doc/03_plan/sys_test/cuda_host_validation_2026-07-11.md's
    negative-case table, applied to the pure `validate_ptx_artifact`
    pre-flight check. None of these touch the CUDA driver, so they must
    produce a deterministic FAIL on every host -- including one with no
    CUDA device at all.
    """
    it "row 1: empty PTX artifact -> FAIL (never SKIP)":
        step("Verify: row 1: empty PTX artifact -> FAIL (never SKIP)")
        # @req: REQ-GPU_LANE-CudaJitHell-001
        val result = validate_ptx_artifact("", VECTOR_ADD_ENTRY)
        assert_false(result.is_ok())
        expect(result.unwrap_err()).to_equal("cuda-jit-ptx-empty")

    it "row 2: malformed PTX (missing .version header) -> FAIL":
        step("Verify: row 2: malformed PTX (missing .version header) -> FAIL")
        # @req: REQ-GPU_LANE-CudaJitHell-001
        val ptx = ".target sm_86\n.address_size 64\n.visible .entry vector_add(\n)\n{\nret;\n}\n"
        val result = validate_ptx_artifact(ptx, VECTOR_ADD_ENTRY)
        assert_false(result.is_ok())
        expect(result.unwrap_err()).to_equal("cuda-jit-ptx-malformed-header")

    it "row 3: malformed PTX (missing .address_size header) -> FAIL":
        step("Verify: row 3: malformed PTX (missing .address_size header) -> FAIL")
        # @req: REQ-GPU_LANE-CudaJitHell-001
        val ptx = ".version 8.0\n.target sm_86\n.visible .entry vector_add(\n)\n{\nret;\n}\n"
        val result = validate_ptx_artifact(ptx, VECTOR_ADD_ENTRY)
        assert_false(result.is_ok())
        expect(result.unwrap_err()).to_equal("cuda-jit-ptx-malformed-header")

    it "row 4: missing .target directive entirely -> FAIL":
        step("Verify: row 4: missing .target directive entirely -> FAIL")
        # @req: REQ-GPU_LANE-CudaJitHell-001
        val ptx = ".version 8.0\n.address_size 64\n.visible .entry vector_add(\n)\n{\nret;\n}\n"
        val result = validate_ptx_artifact(ptx, VECTOR_ADD_ENTRY)
        assert_false(result.is_ok())
        expect(result.unwrap_err()).to_equal("cuda-jit-ptx-malformed-header")

    it "row 5: rejected target (non-sm_ arch token) -> FAIL, never SKIP":
        step("Verify: row 5: rejected target (non-sm_ arch token) -> FAIL, never SKIP")
        # @req: REQ-GPU_LANE-CudaJitHell-001
        val ptx = ".version 8.0\n.target spirv64\n.address_size 64\n.visible .entry vector_add(\n)\n{\nret;\n}\n"
        val result = validate_ptx_artifact(ptx, VECTOR_ADD_ENTRY)
        assert_false(result.is_ok())
        expect(result.unwrap_err()).to_equal("cuda-jit-ptx-rejected-target")

    it "row 6: rejected target (short/garbage sm_ suffix) -> FAIL":
        step("Verify: row 6: rejected target (short/garbage sm_ suffix) -> FAIL")
        # @req: REQ-GPU_LANE-CudaJitHell-001
        val ptx = ".version 8.0\n.target sm_8\n.address_size 64\n.visible .entry vector_add(\n)\n{\nret;\n}\n"
        val result = validate_ptx_artifact(ptx, VECTOR_ADD_ENTRY)
        assert_false(result.is_ok())
        expect(result.unwrap_err()).to_equal("cuda-jit-ptx-rejected-target")

    it "row 7: no entries at all -> FAIL":
        step("Verify: row 7: no entries at all -> FAIL")
        # @req: REQ-GPU_LANE-CudaJitHell-001
        val ptx = ".version 8.0\n.target sm_86\n.address_size 64\n"
        val result = validate_ptx_artifact(ptx, VECTOR_ADD_ENTRY)
        assert_false(result.is_ok())
        expect(result.unwrap_err()).to_equal("cuda-jit-ptx-no-entries")

    it "row 8: nonexistent entry (bad-entry case) -> FAIL, never SKIP":
        step("Verify: row 8: nonexistent entry (bad-entry case) -> FAIL, never SKIP")
        # @req: REQ-GPU_LANE-CudaJitHell-001
        val result = validate_ptx_artifact(_valid_ptx(), "vector_subtract")
        assert_false(result.is_ok())
        expect(result.unwrap_err()).to_equal("cuda-jit-ptx-nonexistent-entry")

    it "row 9: duplicate entry declarations -> FAIL":
        step("Verify: row 9: duplicate entry declarations -> FAIL")
        # @req: REQ-GPU_LANE-CudaJitHell-001
        val ptx = ".version 8.0\n.target sm_86\n.address_size 64\n" +
            ".visible .entry vector_add(\n)\n{\nret;\n}\n" +
            ".visible .entry vector_add(\n)\n{\nret;\n}\n"
        val result = validate_ptx_artifact(ptx, VECTOR_ADD_ENTRY)
        assert_false(result.is_ok())
        expect(result.unwrap_err()).to_equal("cuda-jit-ptx-duplicate-entry")

    it "row 10: expected entry name empty (never matches) -> FAIL":
        step("Verify: row 10: expected entry name empty (never matches) -> FAIL")
        # @req: REQ-GPU_LANE-CudaJitHell-001
        val result = validate_ptx_artifact(_valid_ptx(), "")
        assert_false(result.is_ok())
        expect(result.unwrap_err()).to_equal("cuda-jit-ptx-nonexistent-entry")

    it "the valid baseline PTX itself is accepted (control -- proves the rows above fail for the stated reason, not by accident)":
        step("Verify: the valid baseline PTX itself is accepted (control -- proves the rows above fail for the stated reason, not by accident)")
        # @req: REQ-GPU_LANE-CudaJitHell-001
        val result = validate_ptx_artifact(_valid_ptx(), VECTOR_ADD_ENTRY)
        assert_true(result.is_ok())
        val artifact = result.unwrap()
        expect(artifact.target).to_equal("sm_86")
        assert_true(artifact.entries.contains(VECTOR_ADD_ENTRY))
        expect(artifact.sha256.len()).to_equal(64)  # oracle: value fixed by the spec contract

describe "cuda_jit lane executor -- lane-log recording (host-independent, design §5.1 step 1-2)":
    """
    Confirms the PTX SHA-256/.target/entries are recorded into the lane's
    GMB-1 LOG ring exactly per §5.1 step 1, and that A2's `drain_log`
    round-trips the recorded line -- all without touching CUDA.
    """
    it "formats the PTX SHA-256/.target/entries into one lane-log line":
        step("Verify: formats the PTX SHA-256/.target/entries into one lane-log line")
        # @req: REQ-GPU_LANE-CudaJitHell-001
        val artifact = validate_ptx_artifact(_valid_ptx(), VECTOR_ADD_ENTRY).unwrap()
        val line = format_lane_log_line(artifact)
        expect(line).to_contain("sha256={artifact.sha256}")
        expect(line).to_contain("target=sm_86")
        expect(line).to_contain("entries=[vector_add]")

    it "round-trips the lane-log line through the GMB-1 LOG ring (A2 drain_log)":
        step("Verify: round-trips the lane-log line through the GMB-1 LOG ring (A2 drain_log)")
        # @req: REQ-GPU_LANE-CudaJitHell-001
        val artifact = validate_ptx_artifact(_valid_ptx(), VECTOR_ADD_ENTRY).unwrap()
        val arena = MailboxArena.new(ARENA_SIZE)
        arena.init_log_ring(0x1000)
        record_artifact_in_lane_log(arena, artifact)
        val drained = drain_log(arena)
        expect(drained).to_contain("target=sm_86")
        expect(drained).to_contain("entries=[vector_add]")

describe "cuda_jit lane executor -- vector-add hello dispatch (Task B2 verify)":
    """
    Vector-add "hello" dispatch through jit(remote(cuda(...))): on a live
    CUDA host this lowers the kernel via the existing PTX emitter, launches,
    syncs, verifies the result against a CPU oracle, and drains the expected
    RECORD plus the GMB-1 EXIT sentinel `0xCAFE0000` from the lane log. On a
    host without a usable CUDA device it SKIPs cleanly -- matching the
    `probe().starts_with("skip:")` contract B1's own spec established.
    """
    it "computes vector-add on a live CUDA host and records RECORD + sentinel 0xCAFE0000; SKIPs cleanly elsewhere":
        step("Verify: computes vector-add on a live CUDA host and records RECORD + sentinel 0xCAFE0000; SKIPs cleanly elsewhere")
        # @req: REQ-GPU_LANE-CudaJitHell-001
        step("Create the executor and attempt prepare() (probes, lowers PTX via the existing emitter, validates, inits, loads entry)")
        var executor = CudaJitLaneExecutor.create()
        val prepare_result = executor.prepare("cuda_jit_hello")

        if not prepare_result.is_ok() and prepare_result.unwrap_err().starts_with("skip:"):
            step("No usable CUDA driver/device on this host: " + prepare_result.unwrap_err())
            assert_true(prepare_result.unwrap_err().starts_with("skip:"))
        elif not prepare_result.is_ok():
            step("prepare() failed for a reason other than device-absence -- this IS a real failure, not a skip")
            expect(prepare_result.unwrap_err()).to_equal("")
        else:
            step("Live CUDA driver/device found: run the vector-add hello dispatch")
            val run_result = executor.run_program([])
            assert_true(run_result.is_ok())

            if run_result.is_ok():
                step("Confirm the readback matches the CPU oracle for all 8 elements")
                val readback = run_result.unwrap()
                expect(readback.len()).to_equal(96)  # oracle: value fixed by the spec contract

                step("Drain the expected RECORD from the lane log (seq=0, pass=true, value=8)")
                val records = executor.lane_log_records()
                expect(records.len()).to_equal(1)  # oracle: value fixed by the spec contract
                expect(records[0].pass).to_equal(true)
                expect(records[0].value).to_equal(8)  # oracle: value fixed by the spec contract

                step("Decode the GMB-1 EXIT sentinel 0xCAFE0000 from the lane log")
                expect(executor.lane_sentinel()).to_equal(SENTINEL_EXIT_MASK)

            step("Tear down the session cleanly")
            assert_true(executor.teardown())
