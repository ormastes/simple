# @cover src/app/compile/native.spl 0%
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/feature/mode_filter/skip_native_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""
use std.spec.step

# doc-path: doc/01_research/local/skip_native_spec.md
# doc-path: doc/03_plan/sys_test/skip_native_spec.md
# doc-path: doc/04_architecture/skip_native_spec.md
# doc-path: doc/05_design/skip_native_spec_oracles.md
# @manual: primary

"""
# Skip-Native Mode Tests

**Category:** Testing Framework
**Status:** Active

## Overview

Tests that skip native compilation via `skip-marker-removed_mode: native`, running only in interpreter and SMF modes.
"""

# skip-marker-removed_mode: native
# Runs in interpreter and smf but not native

describe "Non-native tests":
    it "works in interpreted modes":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: works in interpreted modes")
        var interpreted_body_ran = false
        interpreted_body_ran = true
        assert_true(interpreted_body_ran)
