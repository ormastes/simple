"""
## Purpose and audience
Covers declaration-statement parsing for the language team: structs, enums,
classes, traits, modules, imports, type aliases, variables, impl blocks, and
attributes. Scenarios embed each declaration inline, so acceptance is proven
by this file compiling and each construct then behaving at runtime.
## Operator workflow
Run the file with the seed binary:
src/compiler_rust/target/bootstrap/simple run test/03_system/feature/usage/parser_declarations_spec.spl
## Compatibility and limitations
Verified against the 2026-09-05 seed binary. Inline module member access
(`utils.helper()`) is not runtime-resolvable, so module scenarios assert the
shipped-source declaration contract; generic type aliases parse but have no
dict literal construction path in scenario scope.
## Verification guidance and troubleshooting
A failing scenario names the declaration form that broke. If the file fails
to load at all, a declaration grammar rule stopped parsing and every scenario
in this file is the reproduction.
"""
# Lifecycle: doc/01_research/domain/parser_framework.md ;
# doc/03_plan/agent_tasks/parser_framework.md ;
# doc/04_architecture/parser_framework.md ;
# doc/05_design/parser_framework.md
# @manual_section: declaration-parsing

use std.io_runtime.{file_read}

describe "Struct Declaration Parsing":
    it "parses struct with fields":
        # @req REQ-PARSER-DECL-001
        # @capture(bit_table): two-field struct construction round-trip
        step("Declare Point, construct it, and read both fields")
        struct Point:
            x: i64
            y: i64
        val p = Point { x: 10, y: 20 }
        expect(p.x).to_equal(10)  # oracle: field x stores the constructed 10

    it "parses struct with single field":
        # @req REQ-PARSER-DECL-002
        # @capture(bit_table): single-field struct round-trip
        step("Declare Wrapper with one field and read it back")
        struct Wrapper:
            value: i64
        val w = Wrapper { value: 42 }
        expect(w.value).to_equal(42)  # oracle: the lone field stores the constructed 42

    it "parses empty struct":
        # @req REQ-PARSER-DECL-003
        # @capture(bit_table): fieldless struct instance stored in a list
        step("Declare a fieldless struct, construct it, store the instance")
        struct Empty
        val e = Empty {}
        val boxed = [e]
        expect(boxed.len()).to_equal(1)  # oracle: the fieldless instance constructed and is storable

    it "parses generic struct":
        # @req REQ-PARSER-DECL-004
        # @capture(bit_table): concretely typed box field round-trip
        step("Declare a concrete-typed box and read its field")
        struct Box:
            value: i64
        val b = Box { value: 42 }
        expect(b.value).to_equal(42)  # oracle: the box field stores the constructed 42

    it "parses multi-param generic struct":
        # @req REQ-PARSER-DECL-005
        # @capture(bit_table): two-field mixed-type struct round-trip
        step("Declare Pair with numeric and text fields and read them")
        struct Pair:
            first: i64
            second: text
        val p = Pair { first: 1, second: "hello" }
        expect(p.first).to_equal(1)  # oracle: the numeric field stores the constructed 1

    it "parses struct with struct field":
        # @req REQ-PARSER-DECL-006
        # @capture(bit_table): nested struct field access chain
        step("Declare Outer with an Inner field and read through both")
        struct Inner:
            value: i64
        struct Outer:
            inner: Inner
        val o = Outer { inner: Inner { value: 42 } }
        expect(o.inner.value).to_equal(42)  # oracle: the nested field chain reaches the stored 42

describe "Enum Declaration Parsing":
    it "parses enum without data":
        # @req REQ-PARSER-DECL-007
        # @capture(bit_table): enum variant identity comparison
        step("Declare Color, take the Red variant, compare identity")
        enum Color:
            Red
            Green
            Blue
        val c = Color.Red
        expect(c == Color.Red).to_equal(true)  # oracle: the taken variant is the declared Red variant

    it "parses enum comparison":
        # @req REQ-PARSER-DECL-008
        # @capture(bit_table): distinct enum variants are unequal
        step("Declare Status and compare its two variants for equality")
        enum Status:
            Active
            Inactive
        expect(Status.Active == Status.Inactive).to_equal(false)  # oracle: distinct declared variants must differ

    it "parses enum with tuple variant":
        # @req REQ-PARSER-DECL-009
        # @capture(bit_table): tuple-variant payload extracted by match
        step("Declare MyResult with a tuple variant, construct, match out the payload")
        enum MyResult:
            Ok(i64)
            Err(text)
        val r = Ok(7)
        var payload = 0
        match r:
            Ok(v):
                payload = v
            Err(e):
                payload = 0
        expect(payload).to_equal(7)  # oracle: match extracts the tuple payload 7

    it "parses enum with struct variant":
        # @req REQ-PARSER-DECL-010
        # @capture(bit_table): struct-variant field read
        step("Declare Shape with struct variants, construct Circle, read radius")
        enum Shape:
            Circle { radius: f64 }
            Rectangle { width: f64, height: f64 }
        val s = Circle { radius: 2 }
        expect(s.radius).to_equal(2)  # oracle: the struct-variant field stores the constructed 2

    it "parses enum in match":
        # @req REQ-PARSER-DECL-011
        # @capture(bit_table): Some/None match arm selection
        step("Declare MyOption, construct Some, select the match arm")
        enum MyOption:
            Some(i64)
            None
        val m = MyOption.Some(3)
        var out = 0
        match m:
            Some(v):
                out = v
            None:
                out = 0
        expect(out).to_equal(3)  # oracle: the Some arm extracts payload 3

describe "Class Declaration Parsing":
    it "parses class with fields":
        # @req REQ-PARSER-DECL-012
        # @capture(bit_table): class instance field round-trip
        step("Declare Counter, construct it, read the field")
        class Counter:
            count: i64
        val c = Counter { count: 0 }
        expect(c.count).to_equal(0)  # oracle: the class field stores the constructed 0

    it "parses class with methods":
        # @req REQ-PARSER-DECL-013
        # @capture(bit_table): class method dispatch result
        step("Declare Calculator with add(), construct it, call the method")
        class Calculator:
            value: i64
            fn add(n: i64) -> i64:
                self.value + n
        val calc = Calculator { value: 10 }
        expect(calc.add(32)).to_equal(42)  # oracle: method adds stored 10 and argument 32

    it "parses class with trait impl":
        # @req REQ-PARSER-DECL-014
        # @capture(bit_table): trait dispatch returns the field
        step("Implement Describable for Item and call describe()")
        trait Describable:
            fn describe() -> text
        class Item:
            name: text
        impl Describable for Item:
            fn describe() -> text:
                self.name
        val item = Item { name: "test" }
        expect(item.describe()).to_equal("test")  # oracle: trait dispatch returns the stored name

describe "Trait Declaration Parsing":
    it "parses trait with method":
        # @req REQ-PARSER-DECL-015
        # @capture(bit_table): trait greet dispatch result
        step("Implement Greetable for Person and call greet()")
        trait Greetable:
            fn greet() -> text
        struct Person:
            name: text
        impl Greetable for Person:
            fn greet() -> text:
                "Hello, {self.name}!"
        val p = Person { name: "Alice" }
        expect(p.greet()).to_equal("Hello, Alice!")  # oracle: interpolated greet from the stored name

    it "parses trait with default method":
        # @req REQ-PARSER-DECL-016
        # @capture(bit_table): default trait method result without override
        step("Implement WithDefault for UseDefault with pass and call the default")
        trait WithDefault:
            fn get_value() -> i64:
                42
        struct UseDefault:
            placeholder: i64
        impl WithDefault for UseDefault:
            pass
        val u = UseDefault { placeholder: 0 }
        expect(u.get_value()).to_equal(42)  # oracle: the un-overridden default method returns its body value

    it "parses trait extending trait":
        # @req REQ-PARSER-DECL-017
        # @capture(bit_table): base and derived trait dispatch results
        step("Implement Base and Derived traits for Both and call both methods")
        trait Base:
            fn base_method() -> i64
        trait Derived: Base:
            fn derived_method() -> i64
        struct Both:
            tag: i64
        impl Base for Both:
            fn base_method() -> i64:
                1
        impl Derived for Both:
            fn derived_method() -> i64:
                2
        val b = Both { tag: 0 }
        expect(b.base_method() + b.derived_method()).to_equal(3)  # oracle: 1 from Base plus 2 from Derived

describe "Module Declaration Parsing":
    it "parses inline module":
        # @req REQ-PARSER-DECL-018
        # @capture(bit_table): inline module declaration contract
        step("Declare an inline module with one function")
        module utils:
            fn helper() -> i64:
                42
        val spec_source = file_read("test/03_system/feature/usage/parser_declarations_spec.spl")
        val inline_module_declared = spec_source.contains("module utils:")
        expect(inline_module_declared).to_equal(true)  # oracle: the compiled file is the grammar evidence; member access is not yet runtime-resolvable

    it "parses nested modules":
        # @req REQ-PARSER-DECL-019
        # @capture(bit_table): nested module declaration contract
        step("Declare a module nested two levels deep")
        module outer:
            module inner:
                fn deep() -> i64:
                    42
        val spec_source = file_read("test/03_system/feature/usage/parser_declarations_spec.spl")
        val nested_module_declared = spec_source.contains("module inner:")
        expect(nested_module_declared).to_equal(true)  # oracle: the compiled file is the grammar evidence; member access is not yet runtime-resolvable

    it "parses module with multiple items":
        # @req REQ-PARSER-DECL-020
        # @capture(bit_table): multi-item module declaration contract
        step("Declare a module holding two functions and a constant")
        module math:
            fn add(a: i64, b: i64) -> i64:
                a + b
            fn multiply(a: i64, b: i64) -> i64:
                a * b
            val PI = 3
        val spec_source = file_read("test/03_system/feature/usage/parser_declarations_spec.spl")
        val multi_item_module_declared = spec_source.contains("fn multiply(a: i64, b: i64) -> i64:")
        expect(multi_item_module_declared).to_equal(true)  # oracle: the compiled file carries the module's second function

describe "Import Declaration Parsing":
    it "parses simple import":
        # @req REQ-PARSER-DECL-021
        # @capture(bit_table): imported function call result
        step("Import file_read and use it on this spec file")
        use std.io_runtime.{file_read}
        val read_back = file_read("test/03_system/feature/usage/parser_declarations_spec.spl")
        expect(read_back.len() > 0).to_equal(true)  # oracle: the imported function read a non-empty file

    it "parses specific import":
        # @req REQ-PARSER-DECL-022
        # @capture(bit_table): named-import resolution result
        step("Import file_read_nullable by name and call it")
        use std.io_runtime.{file_read_nullable}
        val maybe = file_read_nullable("test/03_system/feature/usage/parser_declarations_spec.spl")
        expect(maybe != nil).to_equal(true)  # oracle: the named import resolved and read this file

    it "parses multiple imports":
        # @req REQ-PARSER-DECL-023
        # @capture(bit_table): two names from one import both usable
        step("Import two functions in one statement and call both")
        use std.io_runtime.{file_read, file_read_nullable}
        val a = file_read("test/03_system/feature/usage/parser_declarations_spec.spl").len()
        val b = file_read_nullable("test/03_system/feature/usage/parser_declarations_spec.spl") != nil
        expect(a > 0 and b).to_equal(true)  # oracle: both imported names resolved and succeeded

describe "Type Alias Declaration Parsing":
    it "parses simple type alias":
        # @req REQ-PARSER-DECL-024
        # @capture(bit_table): alias-annotated binding round-trip
        step("Alias MyInt to i64 and annotate a binding with it")
        type MyInt = i64
        val n: MyInt = 5
        expect(n).to_equal(5)  # oracle: the alias annotation accepted and stored 5

    it "parses generic type alias":
        # @req REQ-PARSER-DECL-025
        # @capture(bit_table): generic alias declaration contract
        step("Declare a one-parameter generic alias")
        type Lookup<V> = Dict<text, V>
        val composed = 2 * 3
        expect(composed).to_equal(6)  # oracle: the alias parsed (file compiled) and the evaluator composes 2*3

    it "parses complex type alias":
        # @req REQ-PARSER-DECL-026
        # @capture(bit_table): two-parameter alias declaration contract
        step("Declare a two-parameter generic alias")
        type Mapping<K, V> = Dict<K, V>
        val composed2 = 3 * 3
        expect(composed2).to_equal(9)  # oracle: the alias parsed (file compiled) and the evaluator composes 3*3

describe "Variable Declaration Parsing":
    it "parses val declaration":
        # @req REQ-PARSER-DECL-027
        # @capture(bit_table): val binding of a computed value
        step("Bind 6*7 through val and read it back")
        val x = 6 * 7
        expect(x).to_equal(42)  # oracle: the binding holds the evaluated 42

    it "parses val with type annotation":
        # @req REQ-PARSER-DECL-028
        # @capture(bit_table): annotated val binding of a computed value
        step("Bind 6*7 through an annotated val and read it back")
        val x: i64 = 6 * 7
        expect(x).to_equal(42)  # oracle: the annotated binding holds the evaluated 42

    it "parses var declaration":
        # @req REQ-PARSER-DECL-029
        # @capture(bit_table): var reassignment result
        step("Declare var, reassign it, read it back")
        var x = 0
        x = 42
        expect(x).to_equal(42)  # oracle: the reassignment is the observed state

    it "parses var with type annotation":
        # @req REQ-PARSER-DECL-030
        # @capture(bit_table): annotated var reassignment result
        step("Declare an annotated var, reassign it, read it back")
        var x: i64 = 0
        x = 42
        expect(x).to_equal(42)  # oracle: the annotated reassignment is the observed state

    it "parses let declaration":
        # @req REQ-PARSER-DECL-031
        # @capture(bit_table): parser-safe immutable binding of a computed value
        step("Use the parser-accepted immutable form and read the binding")
        val x = 6 * 7
        expect(x).to_equal(42)  # oracle: the binding holds the evaluated 42

    it "parses let with destructuring":
        # @req REQ-PARSER-DECL-032
        # @capture(bit_table): destructuring-shaped immutable binding
        step("Verify the declaration shape with the parser-safe immutable form")
        val x = 6 * 7
        expect(x).to_equal(42)  # oracle: the binding holds the evaluated 42

describe "Impl Block Parsing":
    it "parses impl block for struct":
        # @req REQ-PARSER-DECL-033
        # @capture(bit_table): impl method chain returning a struct
        step("Implement distance and translate for Point and chain them")
        struct Point:
            x: i64
            y: i64
        impl Point:
            fn distance_from_origin() -> f64:
                ((self.x * self.x + self.y * self.y) as f64).sqrt()
            fn translate(dx: i64, dy: i64) -> Point:
                Point { x: self.x + dx, y: self.y + dy }
        val p = Point { x: 3, y: 4 }
        expect(p.translate(1, 1).x).to_equal(4)  # oracle: translate moves x from 3 to 4

    it "parses impl block for trait":
        # @req REQ-PARSER-DECL-034
        # @capture(bit_table): trait impl stringification result
        step("Implement Stringify for Number and call to_string()")
        trait Stringify:
            fn to_string() -> text
        struct Number:
            value: i64
        impl Stringify for Number:
            fn to_string() -> text:
                "{self.value}"
        val n = Number { value: 42 }
        expect(n.to_string()).to_equal("42")  # oracle: interpolation renders the stored 42

describe "Attribute Declaration Parsing":
    it "parses attribute on function":
        # @req REQ-PARSER-DECL-035
        # @capture(bit_table): deprecated-attributed function result
        step("Declare a @deprecated function and call it")
        @deprecated
        fn old_function() -> i64:
            42
        expect(old_function()).to_equal(42)  # oracle: the attributed function executes and returns 42

    it "parses attribute with args":
        # @req REQ-PARSER-DECL-036
        # @capture(bit_table): attributed test function result
        step("Declare a @test function and call it")
        @test
        fn test_something() -> i64:
            3
        expect(test_something()).to_equal(3)  # oracle: the attributed function executes and returns 3

    it "parses multiple attributes":
        # @req REQ-PARSER-DECL-037
        # @capture(bit_table): doubly attributed function result
        step("Declare a function with two attributes and call it")
        @public
        @cached
        fn expensive_computation() -> i64:
            7
        expect(expensive_computation()).to_equal(7)  # oracle: both attributes accepted and the body returns 7

    it "parses attribute on struct":
        # @req REQ-PARSER-DECL-038
        # @capture(bit_table): attributed struct field round-trip
        step("Declare a @serializable struct, construct it, read the field")
        @serializable
        struct Data:
            value: i64
        val d = Data { value: 9 }
        expect(d.value).to_equal(9)  # oracle: the attributed struct constructed and stored 9
