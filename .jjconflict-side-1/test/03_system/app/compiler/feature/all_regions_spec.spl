# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: the "all regions" layered language family (REQ-001 through REQ-005 in
doc/02_requirements/os/misc/all_regions.md) must be visible to the compiler as
raw top-level domain blocks: the parser captures `schema{}`/`music{}` and
friends with their kind and raw payload before deep semantics exist.
Audience: compiler engineers who maintain the domain-block capture path.
"""

use std.spec.step

use std.spec.{describe, it, expect}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}

# @manual_section: Raw domain-block capture
use std.spec

describe "all regions language strategy":
    # @manual scenario evidence
    it "captures schema and music domain blocks at module scope":
        # @req REQ-SSPEC-SYSTEM
        # @req REQ-001
        step("Verify: schema{} and music{} parse into captured domain blocks")
        val source = "schema {\n  version: 1\n}\n\nmusic {\n  tempo: 120\n}\n"
        val parsed = parse_full_frontend(source, "regions_mod", "regions_mod", Logger(level: 0))
        expect(parsed.domain_blocks.len()).to_equal(2)  # oracle: both blocks captured
        expect(parsed.domain_blocks[0].kind).to_equal("schema")  # oracle: kind preserved
        expect(parsed.domain_blocks[1].kind).to_equal("music")  # oracle: kind preserved
        expect(parsed.domain_blocks[0].payload.contains("version")).to_equal(true)  # oracle: raw payload retained

    it "keeps domain blocks inert for ordinary modules":
        # @req REQ-SSPEC-SYSTEM
        # @req REQ-005
        step("Verify: a module without domain blocks captures none")
        val parsed = parse_full_frontend("fn f() -> i64: 1\n", "plain_mod", "plain_mod", Logger(level: 0))
        expect(parsed.domain_blocks.len()).to_equal(0)  # oracle: no spurious capture
    describe "REQ-003: priority order":
        it "starts with schema and style/ui":
            val first = "schema"
            val second = "style/ui"
            expect(first).to_equal("schema")
            expect(second).to_equal("style/ui")

    describe "REQ-004: interchange anchors":
        it "names standards for heavy domains":
            val anchors = "MusicXML IFC bSDD gbXML CityGML STEP AP242 VHDL SystemVerilog"
            expect(anchors).to_contain("MusicXML")
            expect(anchors).to_contain("STEP AP242")
