# @req REQ-008 REQ-009 REQ-014
# @manual: primary
"""Pure-owner RT/HAL differential comparison with bounded deterministic commit."""
use std.spec.*
use std.spec.step
use std.common.rt_hal.model.*
use std.nogc_sync_mut.rt_hal.*

fn value_outcome(code: text, value_hash: text, effect_hash: text = "") -> RtHalOutcome:
    RtHalOutcome(status: RtHalOutcomeStatus.Value, code: code,
        value_hash: value_hash, effect_hash: effect_hash)

fn pure_query(item: RtHalWorkItem) -> RtHalOutcome: value_outcome("OK", item.input_hash)
fn pure_effect(item: RtHalWorkItem) -> RtHalOutcome: value_outcome("OK", "result", item.replay_hash)
fn comparator_query(item: RtHalWorkItem) -> RtHalOutcome: value_outcome("OK", item.input_hash)
fn comparator_replay(item: RtHalWorkItem) -> RtHalOutcome: value_outcome("OK", "result", item.replay_hash)
fn mismatch_query(item: RtHalWorkItem) -> RtHalOutcome: value_outcome("OK", "different")

fn request(kind: RtHalOperationKind) -> RtHalRequest:
    RtHalRequest(case_id: 9, operation: kind, operation_id: "timer.read",
        input_hash: "sha256:input", replay_hash: "sha256:effect")

describe "RT HAL provider differential":
    it "should compare Pure Simple C and Rust query results in provider order":
        step("compare RT/HAL providers")
        val comparison = rt_hal_default_comparison(true, true, 3, 12, 8, 4096, true)
        val pure = RtHalPureAdapter(provider_id: "pure-simple", query_fn: pure_query, effect_fn: pure_effect)
        val adapters = [
            RtHalComparatorAdapter(provider_id: "c-comparator", query_fn: comparator_query, replay_fn: comparator_replay),
            RtHalComparatorAdapter(provider_id: "rust-comparator", query_fn: comparator_query, replay_fn: comparator_replay)
        ]
        val report = rt_hal_execute_cooperative(comparison, [request(RtHalOperationKind.Query)], pure, adapters)
        expect(report.completion_error()).to_equal("")
        expect(report.compared_result(0, 1).provider_id).to_equal("c-comparator")
        expect(report.compared_result(0, 2).matches_pure).to_equal(true)

    it "should execute an irreversible effect only in the pure owner and replay its trace":
        step("compare RT/HAL providers")
        val comparison = rt_hal_default_comparison(true, false, 2, 8, 8, 4096, true)
        val pure = RtHalPureAdapter(provider_id: "pure-simple", query_fn: pure_query, effect_fn: pure_effect)
        val c = RtHalComparatorAdapter(provider_id: "c-comparator", query_fn: comparator_query, replay_fn: comparator_replay)
        val report = rt_hal_execute_cooperative(comparison, [request(RtHalOperationKind.Effectful)], pure, [c])
        expect(report.completion_error()).to_equal("")
        expect(report.compared_result(0, 1).matches_pure).to_equal(true)

    it "should distinguish a mismatch from an unsupported provider":
        step("compare RT/HAL providers")
        val comparison = rt_hal_default_comparison(true, false, 2, 8, 8, 4096, true)
        val pure = RtHalPureAdapter(provider_id: "pure-simple", query_fn: pure_query, effect_fn: pure_effect)
        val bad = RtHalComparatorAdapter(provider_id: "c-comparator", query_fn: mismatch_query, replay_fn: comparator_replay)
        expect(rt_hal_execute_cooperative(comparison, [request(RtHalOperationKind.Query)], pure, [bad]).completion_error()).to_equal("RTHAL-E-MISMATCH")
        expect(rt_hal_execute_cooperative(comparison, [request(RtHalOperationKind.Query)], pure, []).completion_error()).to_equal("RTHAL-W-UNSUPPORTED")

