# Native entry-closure regression for cmd_wiki's process facade import.
# Function-local `use` statements are parser-only no-ops in the bootstrap
# frontend, so process_run must be registered at module scope before HIR lowers
# either editor path. Calling help avoids launching an editor while forcing the
# whole imported module through native HIR lowering.

use app.devhub.cmd_wiki.{handle_wiki}

extern fn rt_exit(code: i32)

fn main() -> i64:
    val code = handle_wiki(["--help"])
    if code != 0:
        rt_exit(41)
    rt_exit(30)
    0
