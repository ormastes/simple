# Native tagged-container regression: a raw i64 returned by a function must
# be boxed before it is stored in an array's RuntimeValue slot. The matching
# read unboxes once, so any raw store corrupts multiples of eight (`10000`
# becomes `1250`). Cover both the direct-call and reassigned-local shapes used
# by the self-hosted parser's flat type-tag arrays.

extern fn rt_exit(code: i32)

fn large_type_tag() -> i64:
    10000

fn negative_type_tag() -> i64:
    -8000

fn main() -> i64:
    var direct: [i64] = []
    direct.push(large_type_tag())
    if direct[0] != 10000:
        rt_exit(41)

    var reassigned: [i64] = []
    var tag = 12
    tag = large_type_tag()
    reassigned.push(tag)
    if reassigned[0] != 10000:
        rt_exit(42)

    var adjacent: [i64] = []
    adjacent.push(7)
    adjacent.push(negative_type_tag())
    if adjacent[0] != 7 or adjacent[1] != -8000:
        rt_exit(43)

    rt_exit(30)
    0
