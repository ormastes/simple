"""Fail-closed LLVM 23.1 admission for the ARM64 SimpleOS producer."""

use std.io_runtime.{file_read}
use std.spec.*

describe "SimpleOS ARM64 LLVM 23.1 producer attestation":
    it "requires one explicit provider for the pure-Simple LLVM backend":
        val producer = file_read("scripts/check/build-simpleos-arm64-desktop-engine2d-attested.shs")
        expect(producer).to_contain("attest_llvm_23_1_provider")
        expect(producer).to_contain("llvm-23-1-prefix-required")
        expect(producer).to_contain("simple-llvm-prefix-required")
        expect(producer).to_contain("llvm-provider-prefix-mismatch")
        expect(producer).to_contain("llvm-provider-prefix-unsafe")
        expect(producer).to_contain("llvm-provider-tool-override-forbidden")
        expect(producer).to_contain("validate_clang_23_1_toolchain")
        expect(producer).to_contain("SIMPLE_OS_BUILD_BACKEND=llvm")

    it "binds all provider tools and their versions to the published receipt":
        val producer = file_read("scripts/check/build-simpleos-arm64-desktop-engine2d-attested.shs")
        expect(producer).to_contain("llvm_provider_attestation=llvm-clang-23.1-host-native-build-v1")
        expect(producer).to_contain("attest_authenticated_llvm_23_1_builder")
        expect(producer).to_contain("llvm-23-1-builder-tag-commit-mismatch")
        expect(producer).to_contain("llvm_provider_tag_commit=")
        expect(producer).to_contain("llvm_23_1_prepare_isolated_keyring")
        expect(producer).to_contain("llvm_clang_sha256=")
        expect(producer).to_contain("llvm_lld_sha256=")
        expect(producer).to_contain("llvm_ar_sha256=")
        expect(producer).to_contain("llvm_opt_sha256=")
        expect(producer).to_contain("llvm_llc_sha256=")
        expect(producer).to_contain("llvm_config_sha256=")
        expect(producer).to_contain("llvm_objcopy_sha256=")
        expect(producer).to_contain("scripts/check/lib/clang-23-1-toolchain.shs")
        expect(producer).to_contain("canonical_provider_tool")
        expect(producer).to_contain("llvm-provider-tool-not-canonical")
        expect(producer).to_contain("llvm-23-1-provider-changed-during-build")

    it "freezes the attested environment and makes QMP revalidate it":
        val producer = file_read("scripts/check/build-simpleos-arm64-desktop-engine2d-attested.shs")
        val qmp = file_read("scripts/check/check-simpleos-arm64-qmp-input-evidence.shs")
        expect(producer).to_contain("BUILD_COMMAND=\"env $BUILD_ENVIRONMENT")
        expect(producer).to_contain("LLVM_LLC=$LLVM_LLC_23_1")
        expect(producer).to_contain("verify_llvm_23_1_provider_unchanged")
        expect(qmp).to_contain("verify_manifest_provider_tool opt")
        expect(qmp).to_contain("verify_manifest_provider_tool llc")
        expect(qmp).to_contain("verify_manifest_provider_tool llvm-config")
        expect(qmp).to_contain("verify_manifest_provider_tool llvm-objcopy")
        expect(qmp).to_contain("canonical-build-manifest-llvm-provider-signed-builder-rejected")
        expect(qmp).to_contain("canonical-build-manifest-llvm-provider-signing-key-rejected")
        expect(qmp).to_contain("canonical-build-manifest-llvm-tool-not-canonical")
        expect(qmp).to_contain("canonical-build-manifest-llvm-prefix-unsafe")
        expect(qmp).to_contain("canonical-build-manifest-llvm-tool-sha256-mismatch")
        expect(qmp).to_contain("arm64_qmp_input_llvm_llc_sha256=")

    it "tracks the resolver as part of the frozen ARM64 source identity":
        val fingerprint = file_read("scripts/check/lib/simpleos-arm64-guest-source-fingerprint.shs")
        expect(fingerprint).to_contain("scripts/check/lib/clang-23-1-toolchain.shs")
        expect(fingerprint).to_contain("scripts/check/lib/llvm-23-1-signed-provider.shs")
        expect(fingerprint).to_contain("scripts/setup/keys/llvm-release-tobias-hieta.asc")

    it "does not represent host provider readiness as compiler-in-guest proof":
        val manual = file_read("doc/06_spec/03_system/check/simpleos_arm64_llvm23_provider_contract_spec.md")
        expect(manual).to_contain("host-provider readiness")
        expect(manual).to_contain("does not prove that a compiler runs inside the ARM64 guest")
        expect(manual).to_contain("guest serial/QEMU execution transcript")

    it "has an executable shell gate for negative provider cases":
        val shell_gate = file_read("scripts/check/check-simpleos-arm64-llvm23-provider-contract.shs")
        expect(shell_gate).to_contain("--llvm-provider-self-test")
        expect(shell_gate).to_contain("arm64_llvm_provider_tag_commit_rejection_status=pass")
        expect(shell_gate).to_contain("untrusted LLVM signer fingerprint was accepted")
        expect(shell_gate).to_contain("arm64_llvm_provider_untrusted_signer_rejection_status=pass")
        expect(shell_gate).to_contain("SIMPLE_LLVM_23_1_TEST_SOURCE_DIR")
        expect(shell_gate).to_contain("isolated_builder_verify_tag_status=pass")
