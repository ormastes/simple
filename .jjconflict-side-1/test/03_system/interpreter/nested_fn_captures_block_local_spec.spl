# @bug nested_fn_in_spec_block_loses_captured_local_2026-08-04
# @req a nested `fn` declared inside a spec block must capture that block's locals
# Reproducing spec: arm A (silent zero) and arm B ("variable not found").

"""
## Purpose and audience
Purpose: nested fn reads a block-local array
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-INTERPRETER-NestFnCaptBlocLoca-001

fn apply_reader(reader: (i64) -> i64, off: i64) -> i64:
    reader(off)

use std.spec.step
describe "nested fn inside an it block captures block locals":
    it "nested fn reads a block-local array":
        step("Verify: nested fn reads a block-local array")
        # @req: REQ-INTERPRETER-NestFnCaptBlocLoca-001
        val buf: [i64] = [10, 20, 30, 40]
        fn read8(off: i64) -> i64:
            buf[off]
        expect(read8(2)).to_equal(30)  # oracle: value fixed by the spec contract

    it "nested fn passed as a callback reads a block-local array":
        step("Verify: nested fn passed as a callback reads a block-local array")
        # @req: REQ-INTERPRETER-NestFnCaptBlocLoca-001
        val buf: [i64] = [10, 20, 30, 40]
        fn read8(off: i64) -> i64:
            buf[off]
        expect(apply_reader(read8, 1)).to_equal(20)  # oracle: value fixed by the spec contract

    it "nested fn reads a block-local scalar":
        step("Verify: nested fn reads a block-local scalar")
        # @req: REQ-INTERPRETER-NestFnCaptBlocLoca-001
        val base: i64 = 4275044352
        fn get_base() -> i64:
            base
        expect(get_base()).to_equal(4275044352)  # oracle: value fixed by the spec contract

    it "nested fn composes two block locals":
        step("Verify: nested fn composes two block locals")
        # @req: REQ-INTERPRETER-NestFnCaptBlocLoca-001
        val lo: i64 = 0x1000
        val hi: i64 = 0x2
        fn combine() -> i64:
            lo + (hi * 0x10000)
        expect(combine()).to_equal(0x21000)
