# Fixed workload for test/01_unit/compiler/interp/mem_guard_rate_spec.spl.
# Allocates/frees a fixed number of blocks through the hosted rt_alloc/rt_free
# path and prints the SIMPLE_MEM_GUARD_RATE sampled-allocation count before
# and after, so the parent spec can confirm sampling actually fires (and
# fires on every single allocation at rate=1) once the env var is set.

extern fn rt_mem_guard_stats() -> i64
extern fn rt_alloc(size: i64) -> i64
extern fn rt_free(ptr: i64)

val ALLOC_COUNT = 50

fn main() -> i64:
    print "guard_rate_workload: before={rt_mem_guard_stats()}"
    var i = 0
    while i < ALLOC_COUNT:
        val p = rt_alloc(64)
        rt_free(p)
        i = i + 1
    print "guard_rate_workload: after={rt_mem_guard_stats()}"
    0
