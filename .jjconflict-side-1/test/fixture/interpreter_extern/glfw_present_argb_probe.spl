# Fixture for test/01_unit/compiler/interpreter_extern/glfw_registration_spec.spl.
# rt_glfw_present_argb takes a runtime SplArray*, which the interpreter path
# cannot marshal generically. It must be refused with an explanation, not a
# bad transmute or a crash. This proves the array-taking entry point (one of
# 41 in the family) is a deliberate, explained refusal on the interpreter
# path, distinct from both "unknown extern function" and a segfault.

extern fn rt_glfw_present_argb(handle: i64, pixels: [i64], width: i64, height: i64) -> i64

fn main() -> i64:
    val pixels: [i64] = []
    val n = rt_glfw_present_argb(0, pixels, 0, 0)
    print "unexpected success: n={n}"
    0
