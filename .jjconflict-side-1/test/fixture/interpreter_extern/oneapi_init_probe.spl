# Fixture for test/01_unit/compiler/interpreter_extern/oneapi_registration_spec.spl.
# Calls a real rt_oneapi_* extern that previously had no entry in
# EXTERN_DISPATCH and no path to the linked C implementation (lane R2:
# runtime_native.c was absent from the C sources
# src/compiler_rust/runtime/build.rs compiles). Before the fix this died with
# `unknown extern function: rt_oneapi_init`. The C implementation
# (src/runtime/runtime_native.c) is a fixed-value capability stub, so a
# resolved call returns false (unavailable), not an unknown-extern error.

extern fn rt_oneapi_init() -> bool

fn main() -> i64:
    val ok = rt_oneapi_init()
    print "oneapi_init_result={ok}"
    0
