# Fixture for test/01_unit/compiler/interpreter_extern/capability_gap_spec.spl.
# Calls a real rt_lyon_* extern (declared in
# src/lib/nogc_sync_mut/io/graphics2d_sffi.spl). rt_lyon_* has 49 .spl call
# sites and ZERO native definitions anywhere (M3 capability gap) — the
# largest of the five families this spec covers.

@unsafe(reason: "intentional probe of unavailable Lyon foreign provider", capabilities: [ffi])
extern fn rt_lyon_fill_tessellation_free(tess: i64) -> bool

fn main() -> i64:
    val r = unsafe(capabilities: [ffi]):
        rt_lyon_fill_tessellation_free(0)
    print "unexpected success: rt_lyon_fill_tessellation_free={r}"
    0
