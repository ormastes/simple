# Real loopback HTTP/1.1 server written in Simple.
#
# Gives the browser engine's H1 network module a genuine peer on a real socket.
# Used by test/02_integration/app/ui.web/browser_h1_loopback_e2e_spec.spl via
# test/helpers/browser_h1_loopback_driver.spl.
#
# This binds a REAL TCP socket:
#   TcpListener.bind -> rt_io_tcp_bind (tcp.spl:43 / :491)
#   -> runtime/src/value/net_tcp.rs:390 -> std::net::TcpListener::bind
#
# Verified against a NON-Simple client (bash /dev/tcp), which excludes any
# in-process shim: see the spec's header for the transcript.
#
# Usage (env-configured, so no CLI-arg plumbing is needed):
#   SIMPLE_TEST_HTTP_PORT=0 \
#   SIMPLE_TEST_HTTP_MAX=1 \
#   SIMPLE_TEST_HTTP_PORTFILE=/tmp/port.txt \
#   SIMPLE_TEST_HTTP_LOGFILE=/tmp/srv.log \
#   bin/simple run test/fixture/net/simple_http_server.spl
#
# SIMPLE_TEST_HTTP_PORT     : 0 for an ephemeral port (recommended), or a fixed port
# SIMPLE_TEST_HTTP_MAX      : serve this many connections then exit
# SIMPLE_TEST_HTTP_PORTFILE : the bound "127.0.0.1:PORT", written once listening
# SIMPLE_TEST_HTTP_LOGGFILE : server-side wire evidence, rewritten after each event
#
# The wire is plaintext HTTP/1.1. TLS is not on this path.

use std.nogc_sync_mut.io.tcp.{TcpListener, TcpStream}

extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_env_get(key: text) -> text

val SERVER_BODY = "PONG-FROM-SIMPLE-SERVER-4242"

fn env_or(key: text, fallback: text) -> text:
    val v = rt_env_get(key)
    if v == nil:
        return fallback
    if v == "":
        return fallback
    return v

fn emit(logfile: text, log: text, line: text) -> text:
    """Print an event and mirror the whole log to logfile for the spec to read."""
    print(line)
    val next = "{log}{line}\n"
    if logfile != "":
        val _ = rt_file_write_text(logfile, next)
    return next

fn serve_one(stream: TcpStream, index: i64, logfile: text, log_in: text) -> text:
    """Read one HTTP/1.1 request off the socket and write one response back."""
    var log = log_in

    val peer_res = stream.peer_addr()
    var peer = "?"
    if peer_res.is_ok():
        peer = peer_res.unwrap()
    log = emit(logfile, log, "SERVER_PEER {peer}")

    val local_res = stream.local_addr()
    if local_res.is_ok():
        log = emit(logfile, log, "SERVER_CONN_LOCAL {local_res.unwrap()}")

    # Read the request line, then drain headers until the blank line.
    var request_line = ""
    var header_count = 0
    var reading = true
    while reading:
        val line_res = stream.read_line()
        if line_res.is_err():
            reading = false
        else:
            val line = line_res.unwrap()
            val trimmed = line.trim()
            if request_line == "":
                request_line = trimmed
                log = emit(logfile, log, "SERVER_GOT_REQUEST_LINE {trimmed}")
            else:
                if trimmed == "":
                    reading = false
                else:
                    header_count = header_count + 1
                    log = emit(logfile, log, "SERVER_GOT_HEADER {trimmed}")

    log = emit(logfile, log, "SERVER_HEADER_COUNT {header_count}")

    val body = "{SERVER_BODY}"
    val clen = body.len()
    val response = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nX-Simple-Server: loopback\r\nContent-Length: {clen}\r\nConnection: close\r\n\r\n{body}"
    val w = stream.write_text(response)
    if w.is_err():
        return emit(logfile, log, "SERVER_WRITE_FAILED {index}")
    val f = stream.flush()
    return emit(logfile, log, "SERVER_SERVED {index} request_line={request_line}")

fn main():
    val port_text = env_or("SIMPLE_TEST_HTTP_PORT", "0")
    val max_text = env_or("SIMPLE_TEST_HTTP_MAX", "1")
    val portfile = env_or("SIMPLE_TEST_HTTP_PORTFILE", "")
    val logfile = env_or("SIMPLE_TEST_HTTP_LOGFILE", "")

    var log = ""

    val bind_addr = "127.0.0.1:{port_text}"
    val listener_res = TcpListener.bind(bind_addr)
    if listener_res.is_err():
        log = emit(logfile, log, "SERVER_BIND_FAILED {bind_addr}")
        return
    var listener = listener_res.unwrap()

    var bound = bind_addr
    val local_res = listener.local_addr()
    if local_res.is_ok():
        bound = local_res.unwrap()
    log = emit(logfile, log, "SERVER_LISTENING {bound}")

    val max_requests = max_text.to_i64()
    var served = 0
    var running = true

    # The portfile is written LAST during startup, so its presence is the
    # caller's proof that the socket is already listening.
    if portfile != "":
        log = emit(logfile, log, "SERVER_PORTFILE_PATH [{portfile}]")
        val ok = rt_file_write_text(portfile, bound)
        log = emit(logfile, log, "SERVER_PORTFILE_WRITTEN {ok}")

    while running:
        if served >= max_requests:
            running = false
        else:
            val stream_res = listener.accept_timeout(20000)
            if stream_res.is_err():
                log = emit(logfile, log, "SERVER_ACCEPT_TIMEOUT after {served}")
                running = false
            else:
                var stream = stream_res.unwrap()
                log = serve_one(stream, served, logfile, log)
                val c = stream.close()
                served = served + 1

    val lc = listener.close()
    log = emit(logfile, log, "SERVER_DONE served={served}")

main()
