# Regression + class detection: a `default_axes == "static"` catalog entry must
# validate, and every pinned catalog face must validate against its own bytes.
#
# doc/08_tracking/bug/simpleos_static_axes_fonts_rejected_by_selected_asset_validation_2026-08-09.md
# hypothesised (read-derived, never executed) that selected-asset validation
# refuses Bungee and UnifrakturCook *because* their default_axes is "static".
# Executed here, both validate cleanly on the host lane, which falsifies that
# hypothesis: `sfnt_manifest_default_axes_match` explicitly returns
# `manifest == "static"` for a face with no `fvar` table
# (src/lib/common/encoding/sfnt.spl:230). The guest-side `rejected:<n>B` must
# therefore come from the later runtime probe, not from this validator.

use std.spec.{describe, it, expect}
use std.common.encoding.font_registry.{load_selected_font_file}

fn _reason(path: text) -> text:
    val r = load_selected_font_file(path)
    val v = r.1
    if v.valid: return "valid"
    v.reason

describe "static default_axes faces pass selected-asset validation":
    it "Bungee (default_axes=static) validates":
        expect(_reason("assets/fonts/google-fonts/ofl/bungee/Bungee-Regular.ttf")).to_equal("valid")

    it "UnifrakturCook (default_axes=static) validates":
        expect(_reason("assets/fonts/google-fonts/ofl/unifrakturcook/UnifrakturCook-Bold.ttf")).to_equal("valid")

    it "does not refuse with the hypothesised default-axes reason":
        expect(_reason("assets/fonts/google-fonts/ofl/bungee/Bungee-Regular.ttf")).to_not_equal("default-axes")
