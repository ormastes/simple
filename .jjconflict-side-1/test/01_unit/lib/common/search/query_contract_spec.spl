use std.spec
use lib.common.search.query.{EqualityFilterV1, SearchQueryV1}

describe "bounded search query":
    it "accepts closed v1 bounds":
        step("Validate query and facet bounds")
        expect(SearchQueryV1.of("alpha", [EqualityFilterV1.of("project", ["simple"])], 1000, nil, true).validate_bounds().is_ok()).to_equal(true)
        expect(SearchQueryV1.of("alpha", [], 1001, nil, false).validate_bounds().is_ok()).to_equal(false)

