# @cover src/lib/common/ui/render_opt/composition_damage.spl 80%
# @tag: unit, ui, render_opt, damage

use std.spec
use common.ui.draw_ir.{
    DrawIrCommand, DRAW_IR_BACKEND_CPU,
    draw_ir_batch, draw_ir_composition, draw_ir_embedding_config,
    draw_ir_group_command, draw_ir_rect
}
use common.ui.render_opt.composition_damage.{composition_damage_between}
use common.ui.render_opt.damage_plan.{
    DAMAGE_PLAN_FULL, DAMAGE_PLAN_LOCAL, DAMAGE_PLAN_NONE
}

fn damage_composition(revision: text, x: i32, color: u32):
    draw_ir_composition(revision, "scene", DRAW_IR_BACKEND_CPU, [
        draw_ir_batch(
            "main", DRAW_IR_BACKEND_CPU,
            draw_ir_embedding_config(
                "surface", "root", 0, 0, 100, 80, 0, 1000, false),
            [draw_ir_rect("box", x, 10, 20, 15, color)]
        )
    ])

fn multi_batch_damage_composition(revision: text, second_color: u32):
    val embedding = draw_ir_embedding_config(
        "surface", "root", 0, 0, 100, 80, 0, 1000, false)
    draw_ir_composition(revision, "scene", DRAW_IR_BACKEND_CPU, [
        draw_ir_batch(
            "first", DRAW_IR_BACKEND_CPU, embedding,
            [draw_ir_rect("first-box", 10, 10, 20, 15, 1u32)]),
        draw_ir_batch(
            "second", DRAW_IR_BACKEND_CPU, embedding,
            [draw_ir_rect("second-box", 40, 10, 20, 15, second_color)])
    ])

describe "retained Draw IR composition damage":
    it "classifies an unchanged command stream as no damage":
        val prior = damage_composition("old", 10, 1u32)
        val current = damage_composition("new", 10, 1u32)
        val damage = composition_damage_between(
            prior, current, 100, 80, true, true)
        expect(damage.mode).to_equal(DAMAGE_PLAN_NONE)
        expect(damage.rects).to_equal([])

    it "emits one clipped local rectangle for an in-place style change":
        val prior = damage_composition("old", -5, 1u32)
        val current = damage_composition("new", -5, 2u32)
        val damage = composition_damage_between(
            prior, current, 100, 80, true, true)
        expect(damage.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(damage.rects).to_equal([0, 10, 15, 15])

    it "retains both old and new bounds when a component moves":
        val damage = composition_damage_between(
            damage_composition("old", 10, 1u32),
            damage_composition("new", 40, 1u32),
            100, 80, true, true)
        expect(damage.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(damage.rects).to_equal([10, 10, 20, 15, 40, 10, 20, 15])

    it "deduplicates many identical damage candidates with linear probes":
        var old_commands: [DrawIrCommand] = []
        var new_commands: [DrawIrCommand] = []
        var i = 0
        while i < 64:
            old_commands.push(draw_ir_rect("box-" + i.to_string(), 10, 10, 20, 15, 1u32))
            new_commands.push(draw_ir_rect("box-" + i.to_string(), 10, 10, 20, 15, 2u32))
            i = i + 1
        val embedding = draw_ir_embedding_config(
            "surface", "root", 0, 0, 100, 80, 0, 1000, false)
        val prior = draw_ir_composition("old", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("main", DRAW_IR_BACKEND_CPU, embedding, old_commands)])
        val current = draw_ir_composition("new", "scene", DRAW_IR_BACKEND_CPU, [
            draw_ir_batch("main", DRAW_IR_BACKEND_CPU, embedding, new_commands)])
        val damage = composition_damage_between(
            prior, current, 100, 80, true, true)
        expect(damage.rects).to_equal([10, 10, 20, 15])
        # The patch conservatively contributes old and new bounds for every
        # style change. All 128 identical candidates resolve in one probe.
        expect(damage.damage_candidates).to_equal(128)
        expect(damage.dedup_probes).to_equal(128)

    it "keeps multi-batch metadata and returns exact local damage":
        val damage = composition_damage_between(
            multi_batch_damage_composition("old", 1u32),
            multi_batch_damage_composition("new", 2u32),
            100, 80, true, true)
        expect(damage.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(damage.rects).to_equal([40, 10, 20, 15])
        expect(damage.reason).to_equal("composition-patch")

    it "fails open for unstable inputs and commands without bounds":
        val prior = damage_composition("old", 10, 1u32)
        val current = damage_composition("new", 10, 1u32)
        val viewport = composition_damage_between(
            prior, current, 100, 80, false, true)
        expect(viewport.mode).to_equal(DAMAGE_PLAN_FULL)
        expect(viewport.rects).to_equal([0, 0, 100, 80])

        val old_group = draw_ir_composition(
            "old", "scene", DRAW_IR_BACKEND_CPU, [
                draw_ir_batch(
                    "main", DRAW_IR_BACKEND_CPU,
                    draw_ir_embedding_config(
                        "surface", "root", 0, 0, 100, 80, 0, 1000, false),
                    [draw_ir_group_command("group", "old-parent")])])
        val new_group = draw_ir_composition(
            "new", "scene", DRAW_IR_BACKEND_CPU, [
                draw_ir_batch(
                    "main", DRAW_IR_BACKEND_CPU,
                    draw_ir_embedding_config(
                        "surface", "root", 0, 0, 100, 80, 0, 1000, false),
                    [draw_ir_group_command("group", "new-parent")])])
        val unbounded = composition_damage_between(
            old_group, new_group, 100, 80, true, true)
        expect(unbounded.mode).to_equal(DAMAGE_PLAN_FULL)
        expect(unbounded.reason).to_equal("composition-patch-no-bounds")
