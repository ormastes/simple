"""
## Purpose and audience
Purpose: Prove that DrawIR v3 GROUP/PORT resolver (design section 4).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# @cover src/lib/common/ui/draw_ir_v3_group_resolve.spl 80%
# @tag: unit, ui, draw_ir, draw_ir_v3, gpu_web, group_resolve

use std.spec
use common.ui.draw_ir_v3.{
    DRAW_IR_V3_FLAG_HIDDEN,
    DRAW_IR_V3_HIT_RECT,
    DRAW_IR_V3_KIND_GROUP,
    DRAW_IR_V3_KIND_PORT,
    DRAW_IR_V3_KIND_RECT,
    DRAW_IR_V3_NO_ID,
    DRAW_IR_V3_RESOURCE_VIDEO,
    DrawIrV3Scene,
    draw_ir_v3_clip_append,
    draw_ir_v3_clip_next_id,
    draw_ir_v3_empty_command,
    draw_ir_v3_empty_scene,
    draw_ir_v3_hit_shape_append,
    draw_ir_v3_hit_shape_next_id,
    draw_ir_v3_paint_append,
    draw_ir_v3_paint_next_id,
    draw_ir_v3_resource_append,
    draw_ir_v3_resource_next_id,
    draw_ir_v3_scene_push_command,
    draw_ir_v3_transform_append,
    draw_ir_v3_transform_next_id
}
use common.ui.draw_ir_v3_oracle.{draw_ir_v3_oracle_walk}
use common.ui.draw_ir_v3_group_resolve.{
    DRAW_IR_V3_GROUP_RECEIPT_NONE,
    DRAW_IR_V3_GROUP_RECEIPT_OFFSCREEN_UNSUPPORTED,
    DRAW_IR_V3_GROUP_RECEIPT_PORT_UNAVAILABLE,
    DRAW_IR_V3_GROUP_RECEIPT_STRUCTURE,
    DrawIrV3PortSurfaceState,
    draw_ir_v3_group_execute_check,
    draw_ir_v3_group_resolve,
    draw_ir_v3_group_resolve_hit_test,
    draw_ir_v3_port_surface_state_empty
}

# --- fixture helpers ---------------------------------------------------------

fn _grp_add_transform(scene: DrawIrV3Scene, m11: i32, m12: i32, m21: i32, m22: i32, dx: i32, dy: i32) -> DrawIrV3Scene:
    var s = scene
    s.transforms = draw_ir_v3_transform_append(s.transforms, m11, m12, m21, m22, dx, dy)
    s

fn _grp_add_clip(scene: DrawIrV3Scene, x: i32, y: i32, width: i32, height: i32) -> DrawIrV3Scene:
    var s = scene
    s.clips = draw_ir_v3_clip_append(s.clips, x, y, width, height, 0, DRAW_IR_V3_NO_ID)
    s

fn _grp_add_paint_opacity(scene: DrawIrV3Scene, opacity_milli: i32) -> DrawIrV3Scene:
    var s = scene
    s.paint = draw_ir_v3_paint_append(s.paint, 0u32, 0u32, 0, opacity_milli, 0u16)
    s

fn _grp_add_hit_shape(scene: DrawIrV3Scene, x: i32, y: i32, width: i32, height: i32, component_id: u32) -> DrawIrV3Scene:
    var s = scene
    s.hit_shapes = draw_ir_v3_hit_shape_append(s.hit_shapes, x, y, width, height, DRAW_IR_V3_HIT_RECT, 0u16, component_id)
    s

fn _grp_add_resource(scene: DrawIrV3Scene) -> DrawIrV3Scene:
    var s = scene
    s.resources = draw_ir_v3_resource_append(s.resources, DRAW_IR_V3_RESOURCE_VIDEO, 0u32, 0u32, 0u32, 0)
    s

# One root GROUP (component 1, identity transform) with one RECT child
# (component 2, hit shape at local (0,0,10,10)) parented under it, and the
# GROUP given transform id 0 pointing at whatever transform row the caller
# already appended at index 0.
fn _grp_translated_group_scene(dx: i32, dy: i32) -> DrawIrV3Scene:
    var scene = draw_ir_v3_empty_scene(1u32, 1u32)
    scene = _grp_add_transform(scene, 1000, 0, 0, 1000, dx, dy)
    scene = _grp_add_hit_shape(scene, 0, 0, 10, 10, 2u32)

    var group = draw_ir_v3_empty_command()
    group.kind = DRAW_IR_V3_KIND_GROUP
    group.component_id = 1u32
    group.parent_id = DRAW_IR_V3_NO_ID
    group.transform_id = 0u32
    scene = draw_ir_v3_scene_push_command(scene, group)

    var child = draw_ir_v3_empty_command()
    child.kind = DRAW_IR_V3_KIND_RECT
    child.component_id = 2u32
    child.parent_id = 1u32
    child.hit_shape_id = 0u32
    draw_ir_v3_scene_push_command(scene, child)

describe "DrawIR v3 GROUP/PORT resolver (design section 4)":

    # --- capability probe (assumption A3) -----------------------------------

    it "probe: the existing CPU oracle classifies neither GROUP nor PORT commands":
        step("Verify: probe: the existing CPU oracle classifies neither GROUP nor PORT commands")
        # @req: REQ-LIB-COMMON-001
        var scene = draw_ir_v3_empty_scene(1u32, 1u32)
        var group = draw_ir_v3_empty_command()
        group.kind = DRAW_IR_V3_KIND_GROUP
        group.component_id = 1u32
        scene = draw_ir_v3_scene_push_command(scene, group)
        var port = draw_ir_v3_empty_command()
        port.kind = DRAW_IR_V3_KIND_PORT
        port.component_id = 2u32
        scene = draw_ir_v3_scene_push_command(scene, port)

        val report = draw_ir_v3_oracle_walk(scene)
        expect(report.total_commands).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(report.rect_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(report.text_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(report.image_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(report.path_count).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "probe: an empty scene resolves to an empty, ok result":
        step("Verify: probe: an empty scene resolves to an empty, ok result")
        val scene = draw_ir_v3_empty_scene(1u32, 1u32)
        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        expect(result.ok).to_equal(true)
        expect(result.states.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.receipts.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # --- (a) transform: translated group, child hits at world coords -------

    it "(a) resolves a translated group's child to the group's world transform":
        step("Verify: (a) resolves a translated group's child to the group's world transform")
        val scene = _grp_translated_group_scene(100, 50)
        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        expect(result.ok).to_equal(true)
        val child_state = result.states[1]
        expect(child_state.world_dx).to_equal(100)  # oracle: 100 — named expected value from the requirement
        expect(child_state.world_dy).to_equal(50)  # oracle: 50 — named expected value from the requirement

    it "(a) hit-tests a point at the translated world coordinates":
        step("Verify: (a) hit-tests a point at the translated world coordinates")
        val scene = _grp_translated_group_scene(100, 50)
        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        val hit = draw_ir_v3_group_resolve_hit_test(scene, result, 105, 55)
        expect(hit.hit).to_equal(true)
        expect(hit.component_id).to_equal(2u32)

    it "(a) misses the same point expressed in local (untranslated) coordinates":
        step("Verify: (a) misses the same point expressed in local (untranslated) coordinates")
        val scene = _grp_translated_group_scene(100, 50)
        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        val hit = draw_ir_v3_group_resolve_hit_test(scene, result, 5, 5)
        expect(hit.hit).to_equal(false)

    # --- (b) transform composition order: parent ∘ local -------------------

    it "(b) composes nested groups parent-after-local on an order-sensitive pair":
        step("Verify: (b) composes nested groups parent-after-local on an order-sensitive pair")
        # Root A: scale x2. Child B (of A): translate +10 on x. Grandchild C
        # (of B, identity local transform) inherits world(B).
        # Correct (parent-applied-after-local) order gives world(B).dx = 20
        # (translate 10, then scale by 2 -> 20). The wrong order
        # (local-applied-after-parent) would give 10. This is the pair the
        # required sabotage (swap composition order) must flip.
        var scene = draw_ir_v3_empty_scene(1u32, 1u32)
        scene = _grp_add_transform(scene, 2000, 0, 0, 2000, 0, 0)   # id 0: scale x2
        scene = _grp_add_transform(scene, 1000, 0, 0, 1000, 10, 0)  # id 1: translate +10,0
        scene = _grp_add_hit_shape(scene, 0, 0, 1, 1, 3u32)

        var a = draw_ir_v3_empty_command()
        a.kind = DRAW_IR_V3_KIND_GROUP
        a.component_id = 1u32
        a.parent_id = DRAW_IR_V3_NO_ID
        a.transform_id = 0u32
        scene = draw_ir_v3_scene_push_command(scene, a)

        var b = draw_ir_v3_empty_command()
        b.kind = DRAW_IR_V3_KIND_GROUP
        b.component_id = 2u32
        b.parent_id = 1u32
        b.transform_id = 1u32
        scene = draw_ir_v3_scene_push_command(scene, b)

        var c = draw_ir_v3_empty_command()
        c.kind = DRAW_IR_V3_KIND_RECT
        c.component_id = 3u32
        c.parent_id = 2u32
        c.hit_shape_id = 0u32
        scene = draw_ir_v3_scene_push_command(scene, c)

        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        expect(result.ok).to_equal(true)
        val b_state = result.states[1]
        expect(b_state.world_dx).to_equal(20)  # oracle: 20 — named expected value from the requirement
        expect(b_state.world_m11).to_equal(2000)  # oracle: 2000 — named expected value from the requirement

    it "resolves the same scene twice to byte-identical states (pure/repeatable)":
        step("Verify: resolves the same scene twice to byte-identical states (pure/repeatable)")
        val scene = _grp_translated_group_scene(7, 3)
        val result_a = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        val result_b = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        expect(result_a.states[1].world_dx).to_equal(result_b.states[1].world_dx)
        expect(result_a.states[1].world_dy).to_equal(result_b.states[1].world_dy)

    # --- (c) visibility: AND-composition, excludes hit test -----------------

    it "(c) an invisible group's descendant resolves not-visible":
        step("Verify: (c) an invisible group's descendant resolves not-visible")
        var scene = _grp_translated_group_scene(0, 0)
        var commands = scene.commands
        var group = commands[0]
        group.flags = DRAW_IR_V3_FLAG_HIDDEN
        commands[0] = group
        scene.commands = commands

        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        expect(result.states[0].effective_visible).to_equal(false)
        expect(result.states[1].effective_visible).to_equal(false)

    it "(c) an invisible group's descendant is excluded from hit testing":
        step("Verify: (c) an invisible group's descendant is excluded from hit testing")
        var scene = _grp_translated_group_scene(0, 0)
        var commands = scene.commands
        var group = commands[0]
        group.flags = DRAW_IR_V3_FLAG_HIDDEN
        commands[0] = group
        scene.commands = commands

        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        val hit = draw_ir_v3_group_resolve_hit_test(scene, result, 5, 5)
        expect(hit.hit).to_equal(false)

    it "(c) a sibling command outside the hidden group still resolves visible and hits":
        step("Verify: (c) a sibling command outside the hidden group still resolves visible and hits")
        var scene = _grp_translated_group_scene(0, 0)
        scene = _grp_add_hit_shape(scene, 0, 0, 4, 4, 9u32)
        var commands = scene.commands
        var group = commands[0]
        group.flags = DRAW_IR_V3_FLAG_HIDDEN
        commands[0] = group
        scene.commands = commands

        var sibling = draw_ir_v3_empty_command()
        sibling.kind = DRAW_IR_V3_KIND_RECT
        sibling.component_id = 9u32
        sibling.parent_id = DRAW_IR_V3_NO_ID
        sibling.hit_shape_id = 1u32
        scene = draw_ir_v3_scene_push_command(scene, sibling)

        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        expect(result.states[2].effective_visible).to_equal(true)
        val hit = draw_ir_v3_group_resolve_hit_test(scene, result, 1, 1)
        expect(hit.hit).to_equal(true)
        expect(hit.component_id).to_equal(9u32)

    # --- (d) clip: AABB intersect + refuse-don't-degrade NEEDS_OFFSCREEN ----

    it "(d) a rotated group carrying a clip is marked NEEDS_OFFSCREEN":
        step("Verify: (d) a rotated group carrying a clip is marked NEEDS_OFFSCREEN")
        var scene = draw_ir_v3_empty_scene(1u32, 1u32)
        # 90 degree rotation: m11=0 m12=-1000 m21=1000 m22=0 (off-diagonal
        # terms nonzero -> not axis-preserving).
        scene = _grp_add_transform(scene, 0, -1000, 1000, 0, 0, 0)
        scene = _grp_add_clip(scene, 0, 0, 10, 10)

        var group = draw_ir_v3_empty_command()
        group.kind = DRAW_IR_V3_KIND_GROUP
        group.component_id = 1u32
        group.parent_id = DRAW_IR_V3_NO_ID
        group.transform_id = 0u32
        group.clip_id = 0u32
        scene = draw_ir_v3_scene_push_command(scene, group)

        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        expect(result.ok).to_equal(true)
        expect(result.states[0].needs_offscreen).to_equal(true)

    it "(d) an executor without offscreen support refuses a NEEDS_OFFSCREEN batch":
        step("Verify: (d) an executor without offscreen support refuses a NEEDS_OFFSCREEN batch")
        var scene = draw_ir_v3_empty_scene(1u32, 1u32)
        scene = _grp_add_transform(scene, 0, -1000, 1000, 0, 0, 0)
        scene = _grp_add_clip(scene, 0, 0, 10, 10)
        var group = draw_ir_v3_empty_command()
        group.kind = DRAW_IR_V3_KIND_GROUP
        group.component_id = 1u32
        group.transform_id = 0u32
        group.clip_id = 0u32
        scene = draw_ir_v3_scene_push_command(scene, group)

        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        val refusal = draw_ir_v3_group_execute_check(result.states[0], 0, 1u32, false)
        expect(refusal.kind).to_equal(DRAW_IR_V3_GROUP_RECEIPT_OFFSCREEN_UNSUPPORTED)

    it "(d) an executor WITH offscreen support is not refused for the same batch":
        step("Verify: (d) an executor WITH offscreen support is not refused for the same batch")
        var scene = draw_ir_v3_empty_scene(1u32, 1u32)
        scene = _grp_add_transform(scene, 0, -1000, 1000, 0, 0, 0)
        scene = _grp_add_clip(scene, 0, 0, 10, 10)
        var group = draw_ir_v3_empty_command()
        group.kind = DRAW_IR_V3_KIND_GROUP
        group.component_id = 1u32
        group.transform_id = 0u32
        group.clip_id = 0u32
        scene = draw_ir_v3_scene_push_command(scene, group)

        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        val ok_receipt = draw_ir_v3_group_execute_check(result.states[0], 0, 1u32, true)
        expect(ok_receipt.kind).to_equal(DRAW_IR_V3_GROUP_RECEIPT_NONE)

    it "(d) an axis-preserving (unrotated) clipped group is NOT marked NEEDS_OFFSCREEN":
        step("Verify: (d) an axis-preserving (unrotated) clipped group is NOT marked NEEDS_OFFSCREEN")
        var scene = draw_ir_v3_empty_scene(1u32, 1u32)
        scene = _grp_add_transform(scene, 1000, 0, 0, 1000, 5, 5)
        scene = _grp_add_clip(scene, 0, 0, 10, 10)
        var group = draw_ir_v3_empty_command()
        group.kind = DRAW_IR_V3_KIND_GROUP
        group.component_id = 1u32
        group.transform_id = 0u32
        group.clip_id = 0u32
        scene = draw_ir_v3_scene_push_command(scene, group)

        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        expect(result.states[0].needs_offscreen).to_equal(false)

    it "intersects a child clip against its parent's clip (AABB intersection, not replacement)":
        step("Verify: intersects a child clip against its parent's clip (AABB intersection, not replacement)")
        var scene = draw_ir_v3_empty_scene(1u32, 1u32)
        scene = _grp_add_transform(scene, 1000, 0, 0, 1000, 0, 0)  # id 0: identity
        scene = _grp_add_clip(scene, 0, 0, 20, 20)   # id 0: outer clip 0..20
        scene = _grp_add_clip(scene, 10, 10, 20, 20) # id 1: inner clip 10..30

        var outer = draw_ir_v3_empty_command()
        outer.kind = DRAW_IR_V3_KIND_GROUP
        outer.component_id = 1u32
        outer.transform_id = 0u32
        outer.clip_id = 0u32
        scene = draw_ir_v3_scene_push_command(scene, outer)

        var inner = draw_ir_v3_empty_command()
        inner.kind = DRAW_IR_V3_KIND_GROUP
        inner.component_id = 2u32
        inner.parent_id = 1u32
        inner.transform_id = 0u32
        inner.clip_id = 1u32
        scene = draw_ir_v3_scene_push_command(scene, inner)

        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        val inner_state = result.states[1]
        expect(inner_state.clip_present).to_equal(true)
        expect(inner_state.clip_x).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(inner_state.clip_y).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(inner_state.clip_width).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(inner_state.clip_height).to_equal(10)  # oracle: 10 — named expected value from the requirement

    # --- opacity: u16-milli multiplicative ----------------------------------

    it "multiplies nested group opacities (500 x 500 -> 250, milli-scale, round-to-nearest)":
        step("Verify: multiplies nested group opacities (500 x 500 -> 250, milli-scale, round-to-nearest)")
        var scene = draw_ir_v3_empty_scene(1u32, 1u32)
        scene = _grp_add_transform(scene, 1000, 0, 0, 1000, 0, 0)
        scene = _grp_add_paint_opacity(scene, 500)
        scene = _grp_add_paint_opacity(scene, 500)

        var outer = draw_ir_v3_empty_command()
        outer.kind = DRAW_IR_V3_KIND_GROUP
        outer.component_id = 1u32
        outer.transform_id = 0u32
        outer.paint_id = 0u32
        scene = draw_ir_v3_scene_push_command(scene, outer)

        var inner = draw_ir_v3_empty_command()
        inner.kind = DRAW_IR_V3_KIND_GROUP
        inner.component_id = 2u32
        inner.parent_id = 1u32
        inner.transform_id = 0u32
        inner.paint_id = 1u32
        scene = draw_ir_v3_scene_push_command(scene, inner)

        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        expect(result.states[0].effective_opacity_milli).to_equal(500)  # oracle: 500 — named expected value from the requirement
        expect(result.states[1].effective_opacity_milli).to_equal(250)  # oracle: 250 — named expected value from the requirement

    it "defaults a group with no paint reference to fully opaque (1000), not the table's zero default":
        step("Verify: defaults a group with no paint reference to fully opaque (1000), not the table's zero default")
        var scene = draw_ir_v3_empty_scene(1u32, 1u32)
        var group = draw_ir_v3_empty_command()
        group.kind = DRAW_IR_V3_KIND_GROUP
        group.component_id = 1u32
        scene = draw_ir_v3_scene_push_command(scene, group)

        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        expect(result.states[0].effective_opacity_milli).to_equal(1000)  # oracle: 1000 — named expected value from the requirement

    # --- (e) structural: contiguous-descendant check -------------------------

    it "(e) a non-contiguous descendant range is rejected with a STRUCTURE receipt":
        step("Verify: (e) a non-contiguous descendant range is rejected with a STRUCTURE receipt")
        var scene = draw_ir_v3_empty_scene(1u32, 1u32)
        var group = draw_ir_v3_empty_command()
        group.kind = DRAW_IR_V3_KIND_GROUP
        group.component_id = 1u32
        scene = draw_ir_v3_scene_push_command(scene, group)

        var child1 = draw_ir_v3_empty_command()
        child1.kind = DRAW_IR_V3_KIND_RECT
        child1.component_id = 2u32
        child1.parent_id = 1u32
        scene = draw_ir_v3_scene_push_command(scene, child1)

        var interloper = draw_ir_v3_empty_command()
        interloper.kind = DRAW_IR_V3_KIND_RECT
        interloper.component_id = 3u32
        interloper.parent_id = DRAW_IR_V3_NO_ID
        scene = draw_ir_v3_scene_push_command(scene, interloper)

        var child2 = draw_ir_v3_empty_command()
        child2.kind = DRAW_IR_V3_KIND_RECT
        child2.component_id = 4u32
        child2.parent_id = 1u32
        scene = draw_ir_v3_scene_push_command(scene, child2)

        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        expect(result.ok).to_equal(false)
        expect(result.receipts.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.receipts[0].kind).to_equal(DRAW_IR_V3_GROUP_RECEIPT_STRUCTURE)
        expect(result.receipts[0].component_id).to_equal(1u32)

    it "(e) a contiguous descendant range resolves ok with no STRUCTURE receipt":
        step("Verify: (e) a contiguous descendant range resolves ok with no STRUCTURE receipt")
        val scene = _grp_translated_group_scene(0, 0)
        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        expect(result.ok).to_equal(true)

    # --- (f) PORT: stale/unavailable surface generation ----------------------

    it "(f) a stale PORT surface generation gets the loud marker and a receipt":
        step("Verify: (f) a stale PORT surface generation gets the loud marker and a receipt")
        var scene = draw_ir_v3_empty_scene(1u32, 1u32)
        scene = _grp_add_resource(scene)

        var port = draw_ir_v3_empty_command()
        port.kind = DRAW_IR_V3_KIND_PORT
        port.component_id = 5u32
        port.component_generation = 7u32
        port.image_resource_id = 0u32
        scene = draw_ir_v3_scene_push_command(scene, port)

        val ports = DrawIrV3PortSurfaceState(
            resource_ids: [0u32], available: [true], current_generations: [9u32]
        )
        val result = draw_ir_v3_group_resolve(scene, ports)
        expect(result.states[0].port_loud_marker).to_equal(true)
        expect(result.receipts.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.receipts[0].kind).to_equal(DRAW_IR_V3_GROUP_RECEIPT_PORT_UNAVAILABLE)
        expect(result.receipts[0].component_id).to_equal(5u32)

    it "(f) a missing PORT surface (no registry entry at all) is fail-closed loud":
        step("Verify: (f) a missing PORT surface (no registry entry at all) is fail-closed loud")
        var scene = draw_ir_v3_empty_scene(1u32, 1u32)
        var port = draw_ir_v3_empty_command()
        port.kind = DRAW_IR_V3_KIND_PORT
        port.component_id = 6u32
        port.component_generation = 1u32
        port.image_resource_id = 42u32
        scene = draw_ir_v3_scene_push_command(scene, port)

        val result = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        expect(result.states[0].port_loud_marker).to_equal(true)
        expect(result.receipts.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "(f) a fresh, available PORT surface has no loud marker and no receipt":
        step("Verify: (f) a fresh, available PORT surface has no loud marker and no receipt")
        var scene = draw_ir_v3_empty_scene(1u32, 1u32)
        scene = _grp_add_resource(scene)

        var port = draw_ir_v3_empty_command()
        port.kind = DRAW_IR_V3_KIND_PORT
        port.component_id = 5u32
        port.component_generation = 7u32
        port.image_resource_id = 0u32
        scene = draw_ir_v3_scene_push_command(scene, port)

        val ports = DrawIrV3PortSurfaceState(
            resource_ids: [0u32], available: [true], current_generations: [7u32]
        )
        val result = draw_ir_v3_group_resolve(scene, ports)
        expect(result.states[0].port_loud_marker).to_equal(false)
        expect(result.receipts.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "treats a PORT as a leaf for hit testing (participates like any other hit-testable command)":
        step("Verify: treats a PORT as a leaf for hit testing (participates like any other hit-testable command)")
        var scene = draw_ir_v3_empty_scene(1u32, 1u32)
        scene = _grp_add_resource(scene)
        scene = _grp_add_hit_shape(scene, 0, 0, 8, 8, 5u32)

        var port = draw_ir_v3_empty_command()
        port.kind = DRAW_IR_V3_KIND_PORT
        port.component_id = 5u32
        port.component_generation = 7u32
        port.image_resource_id = 0u32
        port.hit_shape_id = 0u32
        scene = draw_ir_v3_scene_push_command(scene, port)

        val ports = DrawIrV3PortSurfaceState(
            resource_ids: [0u32], available: [true], current_generations: [7u32]
        )
        val result = draw_ir_v3_group_resolve(scene, ports)
        val hit = draw_ir_v3_group_resolve_hit_test(scene, result, 2, 2)
        expect(hit.hit).to_equal(true)
        expect(hit.component_id).to_equal(5u32)
