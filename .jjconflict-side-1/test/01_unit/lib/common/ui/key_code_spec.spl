"""
## Purpose and audience
Purpose: Prove that canonical key-code vocabulary is pinned to the VK / W3C keyCode space.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# @cover src/lib/common/ui/key_code.spl 80%
# @tag: unit, ui, input, key_code, cross_producer

# Cross-producer key-code equality.
#
# THE CLAIM UNDER TEST: showcase/widget logic is byte-identical across the
# 2d / web / gui / wm targets, with only the HAL differing. That claim is false
# unless the same physical keypress becomes the same integer no matter which of
# the four producers observed it. This spec is that proof.
#
# The rows are anti-vacuous by construction. `_quad` renders all four producer
# results into one string and compares it against `_all(expected)`, so:
#   * a producer that returns CANON_UNKNOWN renders "0" and fails the row --
#     mutual agreement on "unknown" cannot pass;
#   * the expected value is an ABSOLUTE constant, so all four producers being
#     wrong the same way cannot pass either.
# A separate block pins every canonical constant to its literal integer, so the
# rows cannot be satisfied by silently redefining the vocabulary.

use std.spec
use common.ui.key_code.{
    CANON_UNKNOWN,
    CANON_BACKSPACE, CANON_TAB, CANON_ENTER, CANON_SHIFT, CANON_CTRL,
    CANON_ALT, CANON_CAPSLOCK, CANON_ESCAPE, CANON_SPACE,
    CANON_PAGEUP, CANON_PAGEDOWN, CANON_END, CANON_HOME,
    CANON_LEFT, CANON_UP, CANON_RIGHT, CANON_DOWN,
    CANON_INSERT, CANON_DELETE, CANON_META,
    CANON_0, CANON_1, CANON_5, CANON_9,
    CANON_A, CANON_M, CANON_Q, CANON_Z,
    CANON_F1, CANON_F5, CANON_F11, CANON_F12,
    CANON_MINUS, CANON_COMMA, CANON_SLASH, CANON_BACKTICK,
    ps2_set1_to_canon, evdev_to_canon, sdl_keysym_to_canon,
    winit_keycode_to_canon,
    canon_key_name, canon_is_modifier, canon_is_letter, canon_is_digit
}

# Render the four producers' answers for one physical key as one string.
# PS/2 extended keys are passed as the combined 0xE0xx value.
fn _quad(ps2: i64, evdev: i64, sdl: i64, winit: i64) -> text:
    ps2_set1_to_canon(ps2).to_text() + "," +
        evdev_to_canon(evdev).to_text() + "," +
        sdl_keysym_to_canon(sdl).to_text() + "," +
        winit_keycode_to_canon(winit).to_text()

# The string a row must produce: the same canonical code, four times.
fn _all(code: i64) -> text:
    code.to_text() + "," + code.to_text() + "," + code.to_text() + "," + code.to_text()

describe "canonical key-code vocabulary is pinned to the VK / W3C keyCode space":

    it "pins the control and navigation codes to their literal VK integers":
        step("Verify: pins the control and navigation codes to their literal VK integers")
        # @req: REQ-LIB-COMMON-001
        expect(CANON_UNKNOWN).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(CANON_BACKSPACE).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(CANON_TAB).to_equal(9)  # oracle: 9 — named expected value from the requirement
        expect(CANON_ENTER).to_equal(13)  # oracle: 13 — named expected value from the requirement
        expect(CANON_SHIFT).to_equal(16)  # oracle: 16 — named expected value from the requirement
        expect(CANON_CTRL).to_equal(17)  # oracle: 17 — named expected value from the requirement
        expect(CANON_ALT).to_equal(18)  # oracle: 18 — named expected value from the requirement
        expect(CANON_CAPSLOCK).to_equal(20)  # oracle: 20 — named expected value from the requirement
        expect(CANON_ESCAPE).to_equal(27)  # oracle: 27 — named expected value from the requirement
        expect(CANON_SPACE).to_equal(32)  # oracle: 32 — named expected value from the requirement
        expect(CANON_PAGEUP).to_equal(33)  # oracle: 33 — named expected value from the requirement
        expect(CANON_PAGEDOWN).to_equal(34)  # oracle: 34 — named expected value from the requirement
        expect(CANON_END).to_equal(35)  # oracle: 35 — named expected value from the requirement
        expect(CANON_HOME).to_equal(36)  # oracle: 36 — named expected value from the requirement
        expect(CANON_INSERT).to_equal(45)  # oracle: 45 — named expected value from the requirement
        expect(CANON_DELETE).to_equal(46)  # oracle: 46 — named expected value from the requirement
        expect(CANON_META).to_equal(91)  # oracle: 91 — named expected value from the requirement

    it "pins the arrows in VK order (left, up, right, down = 37..40)":
        step("Verify: pins the arrows in VK order (left, up, right, down = 37..40)")
        # SDL numbers these right/left/down/up; a transposed table would be
        # invisible without this absolute pin.
        expect(CANON_LEFT).to_equal(37)  # oracle: 37 — named expected value from the requirement
        expect(CANON_UP).to_equal(38)  # oracle: 38 — named expected value from the requirement
        expect(CANON_RIGHT).to_equal(39)  # oracle: 39 — named expected value from the requirement
        expect(CANON_DOWN).to_equal(40)  # oracle: 40 — named expected value from the requirement

    it "pins letters to uppercase ASCII and digits to ASCII":
        step("Verify: pins letters to uppercase ASCII and digits to ASCII")
        expect(CANON_0).to_equal(48)  # oracle: 48 — named expected value from the requirement
        expect(CANON_1).to_equal(49)  # oracle: 49 — named expected value from the requirement
        expect(CANON_5).to_equal(53)  # oracle: 53 — named expected value from the requirement
        expect(CANON_9).to_equal(57)  # oracle: 57 — named expected value from the requirement
        expect(CANON_A).to_equal(65)  # oracle: 65 — named expected value from the requirement
        expect(CANON_M).to_equal(77)  # oracle: 77 — named expected value from the requirement
        expect(CANON_Q).to_equal(81)  # oracle: 81 — named expected value from the requirement
        expect(CANON_Z).to_equal(90)  # oracle: 90 — named expected value from the requirement

    it "pins the function keys to 112..123":
        step("Verify: pins the function keys to 112..123")
        expect(CANON_F1).to_equal(112)  # oracle: 112 — named expected value from the requirement
        expect(CANON_F5).to_equal(116)  # oracle: 116 — named expected value from the requirement
        expect(CANON_F11).to_equal(122)  # oracle: 122 — named expected value from the requirement
        expect(CANON_F12).to_equal(123)  # oracle: 123 — named expected value from the requirement

describe "all four producers agree on one canonical code per physical key":

    it "agrees on letters (PS/2 set-1, evdev, SDLK lowercase, winit VK)":
        step("Verify: agrees on letters (PS/2 set-1, evdev, SDLK lowercase, winit VK)")
        expect(_quad(0x1E, 30, 97, 65)).to_equal(_all(CANON_A))
        expect(_quad(0x32, 50, 109, 77)).to_equal(_all(CANON_M))
        expect(_quad(0x10, 16, 113, 81)).to_equal(_all(CANON_Q))
        expect(_quad(0x2C, 44, 122, 90)).to_equal(_all(CANON_Z))
        # And the answer is the absolute VK integer, not merely "the same".
        expect(_quad(0x1E, 30, 97, 65)).to_equal(_all(65))

    it "agrees on digits":
        step("Verify: agrees on digits")
        expect(_quad(0x0B, 11, 48, 48)).to_equal(_all(CANON_0))
        expect(_quad(0x02, 2, 49, 49)).to_equal(_all(CANON_1))
        expect(_quad(0x06, 6, 53, 53)).to_equal(_all(CANON_5))
        expect(_quad(0x0A, 10, 57, 57)).to_equal(_all(CANON_9))
        expect(_quad(0x0B, 11, 48, 48)).to_equal(_all(48))

    it "agrees on Enter, Escape, Space, Tab and Backspace":
        step("Verify: agrees on Enter, Escape, Space, Tab and Backspace")
        expect(_quad(0x1C, 28, 13, 13)).to_equal(_all(CANON_ENTER))
        expect(_quad(0x01, 1, 27, 27)).to_equal(_all(CANON_ESCAPE))
        expect(_quad(0x39, 57, 32, 32)).to_equal(_all(CANON_SPACE))
        expect(_quad(0x0F, 15, 9, 9)).to_equal(_all(CANON_TAB))
        expect(_quad(0x0E, 14, 8, 8)).to_equal(_all(CANON_BACKSPACE))
        expect(_quad(0x01, 1, 27, 27)).to_equal(_all(27))

    it "agrees on the arrow cluster despite SDL's out-of-order keysyms":
        step("Verify: agrees on the arrow cluster despite SDL's out-of-order keysyms")
        # SDLK: RIGHT=1073741903 LEFT=904 DOWN=905 UP=906.
        # evdev: UP=103 LEFT=105 RIGHT=106 DOWN=108.
        # PS/2:  E048 up, E04B left, E04D right, E050 down.
        expect(_quad(0xE04B, 105, 1073741904, 37)).to_equal(_all(CANON_LEFT))
        expect(_quad(0xE048, 103, 1073741906, 38)).to_equal(_all(CANON_UP))
        expect(_quad(0xE04D, 106, 1073741903, 39)).to_equal(_all(CANON_RIGHT))
        expect(_quad(0xE050, 108, 1073741905, 40)).to_equal(_all(CANON_DOWN))
        expect(_quad(0xE04B, 105, 1073741904, 37)).to_equal(_all(37))

    it "agrees on the navigation cluster (home/end/pgup/pgdn/ins/del)":
        step("Verify: agrees on the navigation cluster (home/end/pgup/pgdn/ins/del)")
        expect(_quad(0xE047, 102, 1073741898, 36)).to_equal(_all(CANON_HOME))
        expect(_quad(0xE04F, 107, 1073741901, 35)).to_equal(_all(CANON_END))
        expect(_quad(0xE049, 104, 1073741899, 33)).to_equal(_all(CANON_PAGEUP))
        expect(_quad(0xE051, 109, 1073741902, 34)).to_equal(_all(CANON_PAGEDOWN))
        expect(_quad(0xE052, 110, 1073741897, 45)).to_equal(_all(CANON_INSERT))
        # SDLK_DELETE is 127 (ASCII DEL), not part of the 0x40000000 block.
        expect(_quad(0xE053, 111, 127, 46)).to_equal(_all(CANON_DELETE))

    it "agrees on modifiers, collapsing left and right to one code":
        step("Verify: agrees on modifiers, collapsing left and right to one code")
        # Left-hand variants.
        expect(_quad(0x2A, 42, 1073742049, 16)).to_equal(_all(CANON_SHIFT))
        expect(_quad(0x1D, 29, 1073742048, 17)).to_equal(_all(CANON_CTRL))
        expect(_quad(0x38, 56, 1073742050, 18)).to_equal(_all(CANON_ALT))
        # Right-hand variants land on the SAME canonical code.
        expect(_quad(0x36, 54, 1073742053, 16)).to_equal(_all(CANON_SHIFT))
        expect(_quad(0xE01D, 97, 1073742052, 17)).to_equal(_all(CANON_CTRL))
        expect(_quad(0xE038, 100, 1073742054, 18)).to_equal(_all(CANON_ALT))
        # Meta / GUI / Super.
        expect(_quad(0xE05B, 125, 1073742051, 91)).to_equal(_all(CANON_META))
        expect(_quad(0x3A, 58, 1073741881, 20)).to_equal(_all(CANON_CAPSLOCK))

    it "agrees on function keys, including the F11/F12 evdev discontinuity":
        step("Verify: agrees on function keys, including the F11/F12 evdev discontinuity")
        # evdev F1..F10 are 59..68 but F11/F12 jump to 87/88 -- the one place
        # evdev and PS/2 set-1 stop coinciding in this range.
        expect(_quad(0x3B, 59, 1073741882, 112)).to_equal(_all(CANON_F1))
        expect(_quad(0x3F, 63, 1073741886, 116)).to_equal(_all(CANON_F5))
        expect(_quad(0x57, 87, 1073741892, 122)).to_equal(_all(CANON_F11))
        expect(_quad(0x58, 88, 1073741893, 123)).to_equal(_all(CANON_F12))
        expect(_quad(0x58, 88, 1073741893, 123)).to_equal(_all(123))

    it "agrees on punctuation":
        step("Verify: agrees on punctuation")
        expect(_quad(0x0C, 12, 45, 189)).to_equal(_all(CANON_MINUS))
        expect(_quad(0x33, 51, 44, 188)).to_equal(_all(CANON_COMMA))
        expect(_quad(0x35, 53, 47, 191)).to_equal(_all(CANON_SLASH))
        expect(_quad(0x29, 41, 96, 192)).to_equal(_all(CANON_BACKTICK))

describe "unmapped input is reported, not guessed":

    it "returns CANON_UNKNOWN for codes no producer defines":
        step("Verify: returns CANON_UNKNOWN for codes no producer defines")
        expect(ps2_set1_to_canon(0x77)).to_equal(CANON_UNKNOWN)
        expect(evdev_to_canon(700)).to_equal(CANON_UNKNOWN)
        expect(sdl_keysym_to_canon(1073999999)).to_equal(CANON_UNKNOWN)
        expect(winit_keycode_to_canon(999)).to_equal(CANON_UNKNOWN)

    it "does not let a real key collapse to CANON_UNKNOWN":
        step("Verify: does not let a real key collapse to CANON_UNKNOWN")
        # The negative pin for every row above: were any producer's table to
        # lose an entry, this fires even if the rows were somehow rewritten.
        expect(ps2_set1_to_canon(0x1E)).to_not_equal(CANON_UNKNOWN)
        expect(evdev_to_canon(30)).to_not_equal(CANON_UNKNOWN)
        expect(sdl_keysym_to_canon(97)).to_not_equal(CANON_UNKNOWN)
        expect(winit_keycode_to_canon(65)).to_not_equal(CANON_UNKNOWN)

describe "canonical helpers agree with the existing consumers":

    it "names keys in the widget_dispatch_key vocabulary":
        step("Verify: names keys in the widget_dispatch_key vocabulary")
        # These are exactly the names host_input_event.host_key_name returns
        # for the codes it handles, so adopting this module changes no
        # widget-layer behaviour.
        expect(canon_key_name(CANON_BACKSPACE)).to_equal("backspace")
        expect(canon_key_name(CANON_TAB)).to_equal("tab")
        expect(canon_key_name(CANON_ENTER)).to_equal("enter")
        expect(canon_key_name(CANON_ESCAPE)).to_equal("escape")
        expect(canon_key_name(CANON_SPACE)).to_equal("space")
        expect(canon_key_name(CANON_END)).to_equal("end")
        expect(canon_key_name(CANON_HOME)).to_equal("home")
        expect(canon_key_name(CANON_LEFT)).to_equal("left")
        expect(canon_key_name(CANON_UP)).to_equal("up")
        expect(canon_key_name(CANON_RIGHT)).to_equal("right")
        expect(canon_key_name(CANON_DOWN)).to_equal("down")
        expect(canon_key_name(CANON_DELETE)).to_equal("delete")
        expect(canon_key_name(CANON_F1)).to_equal("f1")
        expect(canon_key_name(CANON_F12)).to_equal("f12")
        # Letters carry their glyph in `ch`, so they have no name.
        expect(canon_key_name(CANON_A)).to_equal("")

    it "classifies modifiers the way input_event.is_modifier_key does":
        step("Verify: classifies modifiers the way input_event.is_modifier_key does")
        expect(canon_is_modifier(CANON_SHIFT)).to_equal(true)
        expect(canon_is_modifier(CANON_CTRL)).to_equal(true)
        expect(canon_is_modifier(CANON_ALT)).to_equal(true)
        expect(canon_is_modifier(CANON_META)).to_equal(true)
        expect(canon_is_modifier(CANON_A)).to_equal(false)
        expect(canon_is_modifier(CANON_ENTER)).to_equal(false)

    it "classifies letters and digits":
        step("Verify: classifies letters and digits")
        expect(canon_is_letter(CANON_A)).to_equal(true)
        expect(canon_is_letter(CANON_Z)).to_equal(true)
        expect(canon_is_letter(CANON_0)).to_equal(false)
        expect(canon_is_digit(CANON_0)).to_equal(true)
        expect(canon_is_digit(CANON_9)).to_equal(true)
        expect(canon_is_digit(CANON_A)).to_equal(false)
