"""
## Purpose and audience
Purpose: Prove that flat and packed hit-test stacks agree on shared boundaries.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# Boundary agreement between the TWO hit-test/event-routing stacks.
#
# Plan: doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md section 7
# ("Events"), lanes U0-U3.
#
# The repo ships two structurally separate stacks that both answer "which
# node owns this pointer event":
#   - the flat 2D-proxy stack, `common/engine/interaction/hit_test.hit_stack`
#     (paint-key ordered walk over `HitProxy2D` AABBs), and
#   - the packed-scene stack, `common/ui/ui_scene_event_route.ui_scene_route_event`
#     (reverse command walk over a `DrawIrV3Scene` + OWNER_RECORDS).
# Nothing verified that they AGREE. They meet for real in WM chrome drawn
# around an embedded browser view: a click a pixel either side of the border
# must reach the same owner no matter which stack answered it.
#
# This spec feeds the SAME rectangles and the SAME integer pointer
# coordinates to both stacks and compares the resolved owner id. It also
# pins the three input shapes that used to PROVABLY disagree (measured, not
# assumed): z_index-contradicts-emission-order, a disabled topmost node, and
# a pointer-policy-none topmost node. `DrawIrV3HitShapeTable` gained
# `z_indices`/`enableds`/`pointer_policies` columns (schema v4) and
# `draw_ir_v3_group_resolve_hit_test` now consults them, so all three cases
# are asserted CLOSED below via the same shared-fixture `_expect_agree`
# helper the well-formed-bounds cases use -- not merely "both stacks broke
# the same way".
#
# @cover src/lib/common/engine/interaction/hit_test.spl 60%
# @tag: unit, ui, events, hit_test, unified_packed_ui_scene, render_perf, u0

use std.spec
use common.ui.draw_ir_v3.{
    DRAW_IR_V3_NO_ID,
    DRAW_IR_V3_HIT_RECT,
    DRAW_IR_V3_KIND_RECT,
    DRAW_IR_V3_POINTER_POLICY_NONE as DRAW_IR_V3_HIT_POINTER_POLICY_NONE,
    DRAW_IR_V3_POINTER_POLICY_AUTO as DRAW_IR_V3_HIT_POINTER_POLICY_AUTO,
    DrawIrV3Scene,
    draw_ir_v3_empty_scene,
    draw_ir_v3_empty_command,
    draw_ir_v3_scene_push_command,
    draw_ir_v3_hit_shape_append,
    draw_ir_v3_hit_shape_append_ex
}
use common.ui.draw_ir_v3_group_resolve.{draw_ir_v3_group_resolve, draw_ir_v3_port_surface_state_empty}
use common.ui.ui_scene_counts.{UI_PRODUCER_GUI}
use common.ui.ui_scene_owner_table.{UiOwnerRecord, UI_SCENE_EVENT_POLICY_HIT_OPAQUE}
use common.ui.ui_scene_event_route.{UI_SCENE_ROUTE_REFUSE_NO_HIT, ui_scene_route_event}
use std.common.engine.interaction.hit_proxy.{HitProxy2D, POINTER_POLICY_AUTO, POINTER_POLICY_NONE}
use std.common.engine.interaction.hit_test.{
    HIT_TEST_ROUTE_OK,
    HIT_TEST_ROUTE_REFUSE_NO_HIT,
    HIT_TEST_ROUTE_REFUSE_STALE_GENERATION,
    hit_stack,
    hit_stack_validated
}

# --- shared fixture vocabulary ----------------------------------------------
#
# One rectangle, expressed ONCE, then lowered into both stacks. `emit_seq` is
# the paint order: for the flat stack it becomes `insertion_sequence`, for the
# packed stack it is the command-array position. That single shared source is
# what makes an agreement assertion meaningful -- if each stack were given its
# own hand-tuned fixture, agreement would prove nothing.
#
# `z_index`/`enabled`/`pointer_policy` close the divergence documented below:
# both the flat proxy (`HitProxy2D`) and the packed hit shape
# (`DrawIrV3HitShapeTable`, schema v4) now carry these columns, so a single
# shared rect can drive both stacks to the SAME answer for all three
# previously-divergent properties, not just well-formed bounds.
struct _AgreeRect:
    node_id: i64
    left: i32
    top: i32
    right: i32
    bottom: i32
    z_index: i32
    enabled: bool
    pointer_policy: i32

fn _rect(node_id: i64, left: i32, top: i32, right: i32, bottom: i32) -> _AgreeRect:
    _AgreeRect(
        node_id: node_id, left: left, top: top, right: right, bottom: bottom,
        z_index: 0, enabled: true, pointer_policy: POINTER_POLICY_AUTO
    )

fn _agree_owner(semantic_id: u32, generation: u32) -> UiOwnerRecord:
    UiOwnerRecord(
        producer_kind: UI_PRODUCER_GUI, event_policy: UI_SCENE_EVENT_POLICY_HIT_OPAQUE,
        semantic_id: semantic_id, semantic_generation: generation,
        parent_owner_id: DRAW_IR_V3_NO_ID, action_binding_id: DRAW_IR_V3_NO_ID
    )

fn _agree_proxies(rects: [_AgreeRect]) -> [HitProxy2D]:
    var out: [HitProxy2D] = []
    var i = 0
    while i < rects.len():
        val r = rects[i]
        var p = HitProxy2D.create(r.node_id, r.left, r.top, r.right, r.bottom)
        p.insertion_sequence = i.to_i32()
        p.z_index = r.z_index
        p.enabled = r.enabled
        p.pointer_policy = r.pointer_policy
        out.push(p)
        i = i + 1
    out

fn _agree_scene(rects: [_AgreeRect]) -> DrawIrV3Scene:
    var scene = draw_ir_v3_empty_scene(1u32, 1u32)
    var i = 0
    while i < rects.len():
        val r = rects[i]
        val policy = if r.pointer_policy == POINTER_POLICY_NONE:
            DRAW_IR_V3_HIT_POINTER_POLICY_NONE
        else:
            DRAW_IR_V3_HIT_POINTER_POLICY_AUTO
        scene.hit_shapes = draw_ir_v3_hit_shape_append_ex(
            scene.hit_shapes, r.left, r.top, r.right - r.left, r.bottom - r.top,
            DRAW_IR_V3_HIT_RECT, 0u16, r.node_id.to_u32(),
            r.z_index, r.enabled, policy
        )
        i = i + 1
    var j = 0
    while j < rects.len():
        var cmd = draw_ir_v3_empty_command()
        cmd.kind = DRAW_IR_V3_KIND_RECT
        cmd.component_id = rects[j].node_id.to_u32()
        cmd.hit_shape_id = j.to_u32()
        scene = draw_ir_v3_scene_push_command(scene, cmd)
        j = j + 1
    scene

fn _agree_owners(rects: [_AgreeRect]) -> [UiOwnerRecord]:
    var out: [UiOwnerRecord] = []
    var i = 0
    while i < rects.len():
        out.push(_agree_owner(rects[i].node_id.to_u32(), 0u32))
        i = i + 1
    out

# Packed answer normalized to the flat stack's sentinel convention: -1 means
# "no owner resolved", which is what `hit_stack` reports as `primary`.
fn _packed_owner_at(rects: [_AgreeRect], x: i32, y: i32) -> i64:
    val scene = _agree_scene(rects)
    val resolved = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
    val receipt = ui_scene_route_event(scene, resolved, _agree_owners(rects), x, y)
    if not receipt.accepted:
        return -1
    receipt.hit_component_id.to_i64()

fn _flat_owner_at(rects: [_AgreeRect], x: i32, y: i32) -> i64:
    var parents: Dict<i64, i64> = {}
    hit_stack(_agree_proxies(rects), parents, x, y).primary

# The single agreement assertion. `expected` is stated independently of both
# stacks so a case where BOTH are wrong in the same direction still fails --
# asserting only `flat == packed` would pass if both broke identically.
fn _expect_agree(rects: [_AgreeRect], x: i32, y: i32, expected: i64):
    val flat = _flat_owner_at(rects, x, y)
    val packed = _packed_owner_at(rects, x, y)
    print "agree pt=({x},{y}) flat={flat} packed={packed} expected={expected}"
    expect(flat).to_equal(expected)
    expect(packed).to_equal(expected)
    expect(flat).to_equal(packed)

# WM chrome (id 1) with an embedded browser view (id 2) drawn on top of it.
# Chrome  : [10,60) x [10,60)   Content : [30,50) x [30,50)
fn _chrome_and_content() -> [_AgreeRect]:
    [
        _rect(1, 10, 10, 60, 60),
        _rect(2, 30, 30, 50, 50)
    ]

describe "flat and packed hit-test stacks agree on shared boundaries":
    """A pointer event near WM chrome around an embedded browser view must
    reach the same owner regardless of which of the repo's two hit-test
    stacks resolved it. Both stacks are driven from one shared rectangle
    list and one shared coordinate, so an agreement result cannot come from
    two fixtures quietly tuned to each other."""

    it "resolves the nested child at its own top-left border pixel to the child":
        # @req: REQ-LIB-COMMON-001
        step("click the exact top-left pixel of the embedded content view")
        # Catches: an inclusive-vs-half-open regression on the child's LEADING
        # edge in either stack. If either stack made the leading edge
        # exclusive, that stack would answer 1 (chrome) here.
        _expect_agree(_chrome_and_content(), 30, 30, 2)

    it "resolves the pixel just outside the child's leading border to the parent":
        step("click one pixel left of the embedded content view")
        # Catches: an off-by-one that widens the child by one pixel. A stack
        # that grew the child leftwards answers 2 instead of 1.
        _expect_agree(_chrome_and_content(), 29, 30, 1)

    it "resolves the child's last interior pixel to the child":
        step("click the bottom-right interior pixel of the content view")
        # Catches: a stack shrinking the trailing edge by one (would answer 1).
        _expect_agree(_chrome_and_content(), 49, 49, 2)

    it "resolves the child's trailing border pixel to the parent, not the child":
        step("click the first pixel past the content view's bottom-right corner")
        # THE half-open assertion: bounds are [left,right) x [top,bottom).
        # A stack using inclusive trailing edges answers 2 here. This is the
        # single most likely real divergence between a GUI widget stack and a
        # browser-derived stack, which historically used inclusive edges.
        _expect_agree(_chrome_and_content(), 50, 50, 1)

    it "resolves the outer chrome's own leading border pixel to the chrome":
        step("click the top-left pixel of the window chrome")
        _expect_agree(_chrome_and_content(), 10, 10, 1)

    it "resolves the pixel just outside the chrome to no owner at all":
        step("click one pixel outside the window chrome's leading edge")
        # Catches a stack that treats "no hit" as "hit the root/backmost
        # node": it would answer 1 rather than -1.
        _expect_agree(_chrome_and_content(), 9, 10, -1)

    it "resolves the chrome's own trailing border pixel to no owner":
        step("click the first pixel past the chrome's bottom-right corner")
        _expect_agree(_chrome_and_content(), 60, 60, -1)

    it "resolves a point far outside every shape to no owner in both stacks":
        step("click well away from any drawn rectangle")
        _expect_agree(_chrome_and_content(), 5, 5, -1)

    it "resolves an overlapping later-painted sibling to the sibling on top":
        step("click where two same-size siblings overlap")
        # Catches a forward (composition-order) walk on the packed side or an
        # ascending paint-key sort on the flat side: either would answer 1.
        val siblings = [
            _rect(1, 0, 0, 20, 20),
            _rect(2, 10, 10, 30, 30)
        ]
        _expect_agree(siblings, 15, 15, 2)

    it "resolves the non-overlapping part of the lower sibling to the lower sibling":
        step("click the part of the first sibling the second does not cover")
        val siblings = [
            _rect(1, 0, 0, 20, 20),
            _rect(2, 10, 10, 30, 30)
        ]
        _expect_agree(siblings, 5, 5, 1)

describe "flat and packed stacks agree on the three inputs the packed schema used to be unable to express":
    """FORMERLY divergent, now CLOSED (schema v4, draw_ir_v3.spl). Before
    this change `DrawIrV3Command` (frozen schema, draw_ir_v3.spl:79-94)
    carried no z-index, no enabled flag and no pointer-policy field, so the
    packed stack's only ordering signal was command-array position and its
    only suppression signal was `hit_shape_id == NO_ID` / `effective_visible`
    -- the flat stack had all three and the two stacks provably disagreed
    (measured below in the sabotage regression comment). The fix added
    `z_indices`/`enableds`/`pointer_policies` columns to
    `DrawIrV3HitShapeTable` (the hit-shape SIDE TABLE, not the frozen
    command record) and wired `draw_ir_v3_group_resolve_hit_test` to
    consult them. Each scenario below drives BOTH stacks from the SAME
    `_AgreeRect` fixture via `_expect_agree` -- the same one-source
    discipline the well-formed-bounds describe block above uses -- so
    agreement here is not two independently-tuned fixtures agreeing by
    coincidence."""

    it "agrees when a node's z_index contradicts its emission order":
        step("give the FIRST-emitted of two coincident nodes the higher z_index")
        # Before the fix: flat honoured z_index (node 1 wins) while packed
        # could only honour array order (node 2 wins) -- see
        # `event_route_stack_boundary_agreement_divergence_regression_2026-08-09.md`
        # for the measured pre-fix numbers this replaced.
        var r1 = _rect(1, 0, 0, 20, 20)
        r1.z_index = 5
        val rects = [r1, _rect(2, 0, 0, 20, 20)]
        _expect_agree(rects, 10, 10, 1)

    it "agrees when the topmost node is disabled":
        step("disable the topmost of two coincident nodes")
        var r2 = _rect(2, 0, 0, 20, 20)
        r2.enabled = false
        val rects = [_rect(1, 0, 0, 20, 20), r2]
        # A disabled node must pass the click through to whatever is
        # beneath it on BOTH stacks -- exactly the WM bug where a
        # greyed-out overlay swallowed input on the packed path alone.
        _expect_agree(rects, 10, 10, 1)

    it "agrees when the topmost node has pointer-policy none":
        step("mark the topmost of two coincident nodes as pointer-transparent")
        var r2 = _rect(2, 0, 0, 20, 20)
        r2.pointer_policy = POINTER_POLICY_NONE
        val rects = [_rect(1, 0, 0, 20, 20), r2]
        _expect_agree(rects, 10, 10, 1)

describe "flat stack refuses stale generations the way the packed stack does":
    """Parity for src/lib/common/ui/ui_scene_event_route.spl:117-118
    (UI_SCENE_ROUTE_REFUSE_STALE_GENERATION). Before this change the flat
    path accepted every hit, so an event built against a recycled node id
    was delivered on one stack and refused on the other."""

    it "accepts a hit whose carried generation matches the live table":
        step("Verify: accepts a hit whose carried generation matches the live table")
        val rects = _chrome_and_content()
        var parents: Dict<i64, i64> = {}
        var carried: Dict<i64, i64> = {}
        carried[2] = 7
        var current: Dict<i64, i64> = {}
        current[2] = 7
        val out = hit_stack_validated(_agree_proxies(rects), parents, 40, 40, carried, current)
        expect(out.accepted).to_equal(true)
        expect(out.reason).to_equal(HIT_TEST_ROUTE_OK)
        expect(out.result.primary).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "refuses a hit whose carried generation is stale":
        step("the live table has moved to generation 8; the event carries 7")
        val rects = _chrome_and_content()
        var parents: Dict<i64, i64> = {}
        var carried: Dict<i64, i64> = {}
        carried[2] = 7
        var current: Dict<i64, i64> = {}
        current[2] = 8
        val out = hit_stack_validated(_agree_proxies(rects), parents, 40, 40, carried, current)
        # Catches the pre-change behavior exactly: unvalidated hit_stack
        # answers 2 here, so an implementation that forwarded without
        # checking would report accepted=true / primary=2.
        expect(out.accepted).to_equal(false)
        expect(out.reason).to_equal(HIT_TEST_ROUTE_REFUSE_STALE_GENERATION)
        expect(out.result.primary).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "refuses a tracked node that carries no generation at all":
        step("live table tracks the node; the event carries nothing")
        # Fail-closed: an absent carried generation cannot be proven current.
        # Catches a permissive `contains_key` guard that would skip the check.
        val rects = _chrome_and_content()
        var parents: Dict<i64, i64> = {}
        var carried: Dict<i64, i64> = {}
        var current: Dict<i64, i64> = {}
        current[2] = 8
        val out = hit_stack_validated(_agree_proxies(rects), parents, 40, 40, carried, current)
        expect(out.accepted).to_equal(false)
        expect(out.reason).to_equal(HIT_TEST_ROUTE_REFUSE_STALE_GENERATION)

    it "accepts an untracked node so existing callers are unchanged":
        step("no generation tracking configured at all")
        # Catches an over-eager fail-closed rule that would break every
        # current hit_stack caller (panel2d, window_scene, host_gpu_event_queue).
        val rects = _chrome_and_content()
        var parents: Dict<i64, i64> = {}
        var carried: Dict<i64, i64> = {}
        var current: Dict<i64, i64> = {}
        val out = hit_stack_validated(_agree_proxies(rects), parents, 40, 40, carried, current)
        expect(out.accepted).to_equal(true)
        expect(out.result.primary).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "reports a miss with the same no-hit refusal shape as the packed stack":
        val rects = _chrome_and_content()
        var parents: Dict<i64, i64> = {}
        var carried: Dict<i64, i64> = {}
        var current: Dict<i64, i64> = {}
        val out = hit_stack_validated(_agree_proxies(rects), parents, 5, 5, carried, current)
        expect(out.accepted).to_equal(false)
        expect(out.reason).to_equal(HIT_TEST_ROUTE_REFUSE_NO_HIT)
        expect(out.result.primary).to_equal(-1)  # oracle: -1 — named expected value from the requirement
        step("the packed stack refuses the same point with its own no-hit reason")
        val scene = _agree_scene(rects)
        val resolved = draw_ir_v3_group_resolve(scene, draw_ir_v3_port_surface_state_empty())
        val receipt = ui_scene_route_event(scene, resolved, _agree_owners(rects), 5, 5)
        expect(receipt.accepted).to_equal(false)
        expect(receipt.reason).to_equal(UI_SCENE_ROUTE_REFUSE_NO_HIT)
