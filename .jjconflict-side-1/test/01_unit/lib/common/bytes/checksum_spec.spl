# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# checksum_spec.spl — Crc32 / Adler32 against known vectors (AC-7)
use std.spec.step

use std.spec
use std.spec.step
use lib.common.bytes.span.{ByteSpan}
use lib.common.bytes.checksum.{Crc32, Adler32}


# "123456789" as ASCII bytes
fn check_input() -> [u8]:
    [49u8, 50u8, 51u8, 52u8, 53u8, 54u8, 55u8, 56u8, 57u8]

describe "Crc32":
    # @manual scenario evidence
    it "CRC32(\"123456789\") == 0xCBF43926":
        # @req REQ-SSPEC-LIB
        step("CRC32(\")
        var c = Crc32.new()
        c.update(ByteSpan.new(check_input()))
        expect(c.raw()).to_equal(0xCBF43926)

    it "CRC32 of empty input == 0":
        # @req REQ-SSPEC-LIB
        step("CRC32 of empty input == 0")
        var c = Crc32.new()
        c.update(ByteSpan.empty())
        expect(c.raw()).to_equal(0)

    it "incremental update matches single update":
        # @req REQ-SSPEC-LIB
        step("incremental update matches single update")
        val data = check_input()
        var whole = Crc32.new()
        whole.update(ByteSpan.new(data))
        var parts = Crc32.new()
        parts.update(ByteSpan.of(data, 0, 4))
        parts.update(ByteSpan.of(data, 4, 5))
        expect(parts.raw()).to_equal(whole.raw())

    it "value() returns big-endian byte view of the CRC":
        # @req REQ-SSPEC-LIB
        step("value() returns big-endian byte view of the CRC")
        var c = Crc32.new()
        c.update(ByteSpan.new(check_input()))
        val be = c.value().to_span()
        expect(be.get(0).to_i64()).to_equal(0xCB)
        expect(be.get(1).to_i64()).to_equal(0xF4)
        expect(be.get(2).to_i64()).to_equal(0x39)
        expect(be.get(3).to_i64()).to_equal(0x26)

describe "Adler32":
    it "Adler32(\"123456789\") == 0x091E01DE":
        # @req REQ-SSPEC-LIB
        step("Adler32(\")
        var a = Adler32.new()
        a.update(ByteSpan.new(check_input()))
        expect(a.raw()).to_equal(0x091E01DE)

    it "Adler32 of empty input == 1":
        # @req REQ-SSPEC-LIB
        step("Adler32 of empty input == 1")
        var a = Adler32.new()
        a.update(ByteSpan.empty())
        expect(a.raw()).to_equal(1)

    it "incremental update matches single update":
        # @req REQ-SSPEC-LIB
        step("incremental update matches single update")
        val data = check_input()
        var whole = Adler32.new()
        whole.update(ByteSpan.new(data))
        var parts = Adler32.new()
        parts.update(ByteSpan.of(data, 0, 3))
        parts.update(ByteSpan.of(data, 3, 6))
        expect(parts.raw()).to_equal(whole.raw())
