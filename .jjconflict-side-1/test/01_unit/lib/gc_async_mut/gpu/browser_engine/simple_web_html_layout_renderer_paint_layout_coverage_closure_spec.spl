# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_layout.spl 15%
# @tag: unit, ui, browser_engine, coverage-closure
#
# Coverage-closure spec for `paint_layout.spl`'s U4.5 line-coverage target
# (>=85%, see doc/09_report/ui/testing/wm_gui_web_coverage_baseline_2026-08-07.md
# "U4.4 / U4.5 closure"). The baseline for this file (measured by the
# combined `simple_web_html_layout_renderer_coverage_spec.spl`) was 42%
# (610/1432 measured lines) — the report's own U4.4/U4.5 appendix. This spec
# targets the pure, no-DOM-fixture helper functions in this file that no
# existing spec exercises directly: the DrawIR numeric-clamp helpers, the
# CSS shadow-layer/background-edge/background-offset math, the tile-op
# hashing/abs helpers, the input-text byte-boundary walkers, and the
# input caret/selection color and text-decoration-line serializers.
#
# `paint`/`paint_tiled`/`_html_draw_ir_commands` (the large DOM-tree-walking
# functions) are already exercised by the combined coverage spec and are not
# duplicated here.

use std.spec.{describe, it, assert_true, assert_false, assert_equal}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_paint_layout.{
    has_visible_overflow_clip,
    _html_draw_ir_non_negative, _html_draw_ir_shadow_layer_count,
    _html_draw_ir_clamp_i64, _html_draw_ir_abs_i32, _html_draw_ir_saturated_i32,
    _html_draw_ir_background_offset, _html_draw_ir_background_edge,
    _tile_abs_i32, _tile_style_hash,
    input_text_prefix, _input_text_source_boundaries,
    input_caret_color, input_selection_color, _text_decoration_line_text
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_style.{
    Style, renderer_default_style
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir_result,
    simple_web_layout_render_html_software_pixels,
    simple_web_layout_render_html_software_pixels_tile_lane
}

# --- fixtures for the `paint`/`_html_draw_ir_commands` DOM-tree-walking
# closure round below. A single-property brace group like {color:red} lexes
# as a string interpolation ({var:format}); every CSS brace is doubled to
# escape it, matching the convention already used by
# simple_web_html_layout_renderer_coverage_spec.spl's fixtures.

fn _pl_head(rules: text) -> text:
    "<html><head><style>html,body{{margin:0;padding:0;background:#ffffff}}" +
        rules + "</style></head><body>"

fn _pl_scrollbar_doc() -> text:
    """A 20x20 box with BOTH `overflow:hidden` and `overflow-y:auto` set (the
    only combination that raises both `overflow_hidden` and `overflow_auto_y`
    -- see simple_web_html_layout_renderer_decl_apply.spl's `overflow`/
    `overflow-y` cascade) and more content than fits -- the only path that
    reaches `paint`'s scrollbar pass (`fb_vertical_scrollbar_clip`, w>=15,
    h>=8), 0-covered by this spec before this fixture."""
    _pl_head(".sb{{width:20px;height:20px;overflow:hidden;overflow-y:auto;background:#e2e8f0}}") +
        "<div class=\"sb\"><p>a</p><p>b</p><p>c</p><p>d</p><p>e</p></div></body></html>"

fn _pl_zsort_doc() -> text:
    """Three overlapping `position:absolute` boxes with z-index 30/10/20,
    declared in DOM order 10,30,20 -- deliberately NOT ascending, forcing
    `paint`'s pass-4 unsorted branch (`positive_z_sorted = false`) to call
    `_sort_positive_z_indices` before painting them back-to-front."""
    _pl_head(
        ".z1{{position:absolute;left:0px;top:0px;width:10px;height:10px;z-index:30;background:#ff0000}}" +
        ".z2{{position:absolute;left:0px;top:0px;width:10px;height:10px;z-index:10;background:#00ff00}}" +
        ".z3{{position:absolute;left:0px;top:0px;width:10px;height:10px;z-index:20;background:#0000ff}}"
    ) + "<div class=\"z2\"></div><div class=\"z1\"></div><div class=\"z3\"></div></body></html>"

fn _pl_rtl_doc() -> text:
    "<html><head><style>html,body{{margin:0;padding:0}}.r{{direction:rtl;font-size:8px}}" +
        "</style></head><body><p class=\"r\">abc</p></body></html>"

fn _pl_ltr_doc() -> text:
    "<html><head><style>html,body{{margin:0;padding:0}}.r{{font-size:8px}}" +
        "</style></head><body><p class=\"r\">abc</p></body></html>"

fn _pl_upper_doc() -> text:
    _pl_head(".u{{text-transform:uppercase;font-size:8px}}") +
        "<p class=\"u\">abc</p></body></html>"

fn _pl_ellipsis_doc() -> text:
    """A 10px-wide nowrap+hidden box with `text-overflow:ellipsis` around a
    long text run -- the only path that reaches the Draw IR text-command
    ellipsis arm added in commit 34095840 (`_html_draw_ir_command`'s
    `st.text_overflow_ellipsis` branch calling `ellipsize_text_for_width`)."""
    _pl_head(".e{{width:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:8px}}") +
        "<p class=\"e\">abcdefghijklmnop</p></body></html>"

fn _pl_noellipsis_doc() -> text:
    """Same text run as `_pl_ellipsis_doc` but with no `text-overflow` set and
    a box wide enough to hold it -- the sibling `else` arm of the same
    ellipsis branch, so both sides of the commit-34095840 diff are exercised."""
    _pl_head(".e{{width:100px;font-size:8px}}") +
        "<p class=\"e\">abcdefghijklmnop</p></body></html>"

fn _pl_bgimg_doc() -> text:
    """A `background-image:url(...)` box rendered through the images-less
    `simple_web_layout_render_html_draw_ir_result` entry point -- the only
    path that reaches `_html_draw_ir_commands`'s background-layer branch
    (`_html_draw_ir_two_url_background_layers`, `_html_draw_ir_image_index`)
    and its `backgrounds_ready = false` fallback when no image resource is
    supplied, 0-covered by this spec before this fixture."""
    _pl_head(".bi{{width:10px;height:10px;background-image:url(x.png)}}") +
        "<div class=\"bi\"></div></body></html>"

fn _pl_details_doc() -> text:
    """A `<details><summary>` pair -- the only path that reaches
    `_html_draw_ir_summary_marker_command`, 0-covered by this spec before
    this fixture."""
    "<html><head><style>html,body{{margin:0;padding:0}}</style></head><body>" +
        "<details><summary>more</summary><p>hidden</p></details></body></html>"

describe "paint entry point: node/style pipeline via HTML (paint closure)":
    """Drives the real HTML -> DOM -> style -> layout -> paint pipeline
    through its own public entry points (`simple_web_layout_render_html_*`)
    on tiny fixtures, rather than smoke-calling `paint`/`_html_draw_ir_commands`
    directly -- this is the reachable path the baseline report's
    "requires full node/style array fixtures to close further" gap named.
    Every assertion below is a real pixel or Draw IR command value, hand-
    verified against a throwaway probe of this same entry point before being
    asserted (not a smoke/existence check)."""

    it "paints scrollbar-track pixels distinct from the box's own background and from the page outside it":
        val px = simple_web_layout_render_html_software_pixels(_pl_scrollbar_doc(), 24, 24, 3600000)
        # col4: the div's own #e2e8f0 background, left of the scrollbar.
        # col10: inside the 15px-wide scrollbar track/thumb region
        # (x = box_right(20) - border_r(0) - 15 = 5 .. 19).
        # col22: outside the 20px-wide box, the page's white background.
        assert_true(px[4] != px[10])
        assert_true(px[10] != px[22])
        assert_equal(px[22], 4294967295u32)

    it "z-sorts unsorted positive-z-index absolute boxes so the highest z-index paints on top":
        val px = simple_web_layout_render_html_software_pixels(_pl_zsort_doc(), 12, 12, 3600000)
        # z1 (z-index:30, #ff0000) is declared second in DOM order but has the
        # highest z-index, so it must be the topmost (last-painted) pixel at
        # the fully-overlapping origin -- only reachable if the unsorted-input
        # branch actually calls _sort_positive_z_indices.
        assert_equal(px[0], 4294901760u32)

    it "reverses RTL #text glyph order relative to the same LTR text":
        val res_rtl = simple_web_layout_render_html_draw_ir_result(_pl_rtl_doc(), 64, 24)
        val res_ltr = simple_web_layout_render_html_draw_ir_result(_pl_ltr_doc(), 64, 24)
        var rtl_text = ""
        for b in res_rtl.composition.batches:
            for c in b.commands:
                if c.kind == "text" and rtl_text == "":
                    rtl_text = c.text_value
        var ltr_text = ""
        for b in res_ltr.composition.batches:
            for c in b.commands:
                if c.kind == "text" and ltr_text == "":
                    ltr_text = c.text_value
        assert_equal(ltr_text, "abc")
        assert_equal(rtl_text, "cba")

    it "applies text-transform:uppercase before the Draw IR text command is built":
        val res = simple_web_layout_render_html_draw_ir_result(_pl_upper_doc(), 64, 24)
        var upper_text = ""
        for b in res.composition.batches:
            for c in b.commands:
                if c.kind == "text" and upper_text == "":
                    upper_text = c.text_value
        assert_equal(upper_text, "ABC")

    it "ellipsizes an overflowing text-overflow:ellipsis run in the Draw IR text command":
        val res = simple_web_layout_render_html_draw_ir_result(_pl_ellipsis_doc(), 64, 24)
        var ellipsis_text = ""
        for b in res.composition.batches:
            for c in b.commands:
                if c.kind == "text" and ellipsis_text == "":
                    ellipsis_text = c.text_value
        assert_equal(ellipsis_text, "...")

    it "passes the full text through unmodified when text-overflow:ellipsis is not set":
        val res = simple_web_layout_render_html_draw_ir_result(_pl_noellipsis_doc(), 64, 24)
        var full_text = ""
        for b in res.composition.batches:
            for c in b.commands:
                if c.kind == "text" and full_text == "":
                    full_text = c.text_value
        assert_equal(full_text, "abcdefghijklmnop")

    it "computes the background-image layer set and falls back cleanly with no image resources supplied":
        val res = simple_web_layout_render_html_draw_ir_result(_pl_bgimg_doc(), 24, 24)
        var command_count = 0
        for b in res.composition.batches:
            for c in b.commands:
                command_count = command_count + 1
        # canvas + html + body + div, and NO extra background-image command --
        # proving the backgrounds_ready=false fallback path ran to completion
        # (rather than crashing or silently appending a partial command).
        assert_equal(command_count, 4)

    it "emits an explicit summary-marker Draw IR command for a <details><summary>":
        val res = simple_web_layout_render_html_draw_ir_result(_pl_details_doc(), 64, 24)
        var marker_text = ""
        var marker_component = ""
        for b in res.composition.batches:
            for c in b.commands:
                if c.kind == "text" and c.component_id.contains("::marker"):
                    marker_text = c.text_value
                    marker_component = c.component_id
        assert_equal(marker_text, "▶")
        assert_true(marker_component.contains("summary"))

describe "has_visible_overflow_clip":
    """True when any style in the list has overflow_hidden/overflow_auto_y
    set and is not display:none; false otherwise."""

    it "is false for an empty style list":
        assert_false(has_visible_overflow_clip([]))

    it "is false when no style clips overflow":
        val st = renderer_default_style()
        assert_false(has_visible_overflow_clip([st, st]))

    it "is true when one style in the list clips overflow and is visible":
        var st_clip = renderer_default_style()
        st_clip.overflow_hidden = true
        assert_true(has_visible_overflow_clip([renderer_default_style(), st_clip]))

    it "ignores a clipping style that is display:none":
        var st_clip = renderer_default_style()
        st_clip.overflow_hidden = true
        st_clip.display = "none"
        assert_false(has_visible_overflow_clip([st_clip]))

describe "_html_draw_ir_non_negative":
    it "clamps a negative value to 0":
        assert_equal(_html_draw_ir_non_negative(-5), 0)

    it "passes a non-negative value through unchanged":
        assert_equal(_html_draw_ir_non_negative(7), 7)
        assert_equal(_html_draw_ir_non_negative(0), 0)

describe "_html_draw_ir_shadow_layer_count":
    it "is 0 for an empty shadow value":
        assert_equal(_html_draw_ir_shadow_layer_count(""), 0)

    it "counts one layer for a single shadow with no top-level comma":
        assert_equal(_html_draw_ir_shadow_layer_count("2px 2px 4px #000"), 1)

    it "counts each top-level-comma-separated shadow as its own layer":
        assert_equal(
            _html_draw_ir_shadow_layer_count("2px 2px 4px #000, 0 0 2px red"), 2)

describe "_html_draw_ir_clamp_i64":
    it "clamps a value below the low bound up to low":
        assert_equal(_html_draw_ir_clamp_i64(-10i64, 0i64, 100i64), 0i64)

    it "clamps a value above the high bound down to high":
        assert_equal(_html_draw_ir_clamp_i64(200i64, 0i64, 100i64), 100i64)

    it "passes an in-range value through unchanged":
        assert_equal(_html_draw_ir_clamp_i64(50i64, 0i64, 100i64), 50i64)

describe "_html_draw_ir_abs_i32":
    it "negates a negative value into i64":
        assert_equal(_html_draw_ir_abs_i32(-9), 9i64)

    it "passes a non-negative value through as i64":
        assert_equal(_html_draw_ir_abs_i32(9), 9i64)
        assert_equal(_html_draw_ir_abs_i32(0), 0i64)

describe "_html_draw_ir_saturated_i32":
    it "saturates a value above i32::MAX down to i32::MAX":
        assert_equal(_html_draw_ir_saturated_i32(9999999999i64), 2147483647)

    it "saturates a value below i32::MIN up to i32::MIN":
        assert_equal(_html_draw_ir_saturated_i32(0i64 - 9999999999i64), 0 - 2147483647 - 1)

    it "passes an in-range i64 through as i32":
        assert_equal(_html_draw_ir_saturated_i32(42i64), 42)

describe "_html_draw_ir_background_offset":
    it "passes a normal (non-sentinel) value through unchanged":
        assert_equal(_html_draw_ir_background_offset(10, 200), 10)

    it "resolves a percentage-sentinel value against free_space":
        # value <= -1000 encodes a percentage: pct = -1000 - value, offset =
        # free_space * pct / 100. -1050 encodes 50%, so with free_space=200
        # the offset is 200 * 50 / 100 = 100.
        assert_equal(_html_draw_ir_background_offset(0 - 1050, 200), 100)

describe "_html_draw_ir_background_edge":
    it "returns the full box span unchanged for border-box":
        val edge = _html_draw_ir_background_edge("border-box", 10, 100, 2, 3, 4, 5)
        assert_equal(edge.0, 10)
        assert_equal(edge.1, 100)

    it "insets by border+padding on both sides for content-box":
        val edge = _html_draw_ir_background_edge("content-box", 10, 100, 2, 3, 4, 5)
        # start = box_start + border_start + padding_start = 10 + 2 + 4 = 16
        assert_equal(edge.0, 16)
        # size = box_size - inset_start - border_end - padding_end = 100 - 6 - 3 - 5 = 86
        assert_equal(edge.1, 86)

    it "insets by border only for the padding-box default case":
        val edge = _html_draw_ir_background_edge("padding-box", 10, 100, 2, 3, 4, 5)
        assert_equal(edge.0, 12)
        assert_equal(edge.1, 95)

    it "never returns a negative size (clamped by non_negative)":
        val edge = _html_draw_ir_background_edge("content-box", 0, 5, 10, 10, 10, 10)
        assert_equal(edge.1, 0)

describe "_tile_abs_i32":
    it "negates a negative value":
        assert_equal(_tile_abs_i32(-3), 3)

    it "passes a non-negative value through unchanged":
        assert_equal(_tile_abs_i32(3), 3)
        assert_equal(_tile_abs_i32(0), 0)

describe "_tile_style_hash":
    it "differs when bg differs and matches when every hashed field matches":
        var a = renderer_default_style()
        var b = renderer_default_style()
        assert_equal(_tile_style_hash(a), _tile_style_hash(b))
        a.bg = 0xFF0000FFu32
        assert_true(_tile_style_hash(a) != _tile_style_hash(b))

    it "differs when opacity_pct differs":
        var a = renderer_default_style()
        var b = renderer_default_style()
        a.opacity_pct = 50
        assert_true(_tile_style_hash(a) != _tile_style_hash(b))

describe "input_text_prefix":
    it "returns the empty text when max_glyphs is 0 or negative":
        assert_equal(input_text_prefix("hello", 0), "")
        assert_equal(input_text_prefix("hello", -1), "")

    it "returns the value unchanged when it already fits within max_glyphs":
        assert_equal(input_text_prefix("hi", 5), "hi")

    it "truncates to the first max_glyphs codepoints on an ASCII value":
        assert_equal(input_text_prefix("hello world", 5), "hello")

describe "_input_text_source_boundaries":
    it "starts with a leading 0 boundary for an empty value":
        val b = _input_text_source_boundaries("")
        assert_equal(b.len(), 1)
        assert_equal(b[0], 0i64)

    it "records one boundary per ASCII byte plus the leading 0":
        val b = _input_text_source_boundaries("abc")
        assert_equal(b.len(), 4)
        assert_equal(b[0], 0i64)
        assert_equal(b[1], 1i64)
        assert_equal(b[2], 2i64)
        assert_equal(b[3], 3i64)

describe "input_caret_color":
    it "returns the style's explicit caret_color when set":
        var st = renderer_default_style()
        st.caret_color = 0xFF112233u32
        assert_equal(input_caret_color(st), 0xFF112233u32)

    it "falls back to fg when caret_color is unset (0)":
        var st = renderer_default_style()
        st.fg = 0xFF445566u32
        st.caret_color = 0u32
        assert_equal(input_caret_color(st), 0xFF445566u32)

describe "input_selection_color":
    it "composes the fixed selection alpha with the caret color's rgb":
        var st = renderer_default_style()
        st.caret_color = 0xFF112233u32
        # INPUT_TEXT_SELECTION_ALPHA (0x66) shifted into the alpha byte, rgb
        # taken from caret_color with its own alpha byte masked off.
        assert_equal(input_selection_color(st), 0x66112233u32)

describe "_text_decoration_line_text":
    it "reports none when no decoration line is set":
        val st = renderer_default_style()
        assert_equal(_text_decoration_line_text(st), "none")

    it "reports a single active decoration line":
        var st = renderer_default_style()
        st.text_decoration_underline = true
        assert_equal(_text_decoration_line_text(st), "underline")

    it "joins multiple active decoration lines in canonical order":
        var st = renderer_default_style()
        st.text_decoration_underline = true
        st.text_decoration_overline = true
        st.text_decoration_line_through = true
        assert_equal(_text_decoration_line_text(st), "underline overline line-through")

# --- `paint_tiled`'s `widget_mode` early-return branch (paint_layout.spl
# ~1320: `if widget_mode: return paint(...)`) -- 0-covered by every existing
# spec. `paint_tiled` is called from exactly two sites
# (simple_web_html_layout_renderer.spl): the production render entry guards
# the call with `and not widget_mode`, so widget_mode is NEVER true there;
# only `simple_web_layout_render_html_software_pixels_tile_lane` (the
# tile-lane test/bench entry) passes widget_mode through unconditionally.
# Every existing caller of that entry (tile_paint_parity_spec.spl,
# simple_web_html_layout_renderer_coverage_spec.spl's tile-lane-parity
# example) uses plain non-widget-chrome fixtures, so the branch was never
# taken from any reachable path until this example.
fn _pl_tiled_widget_doc() -> text:
    """No `<style>` tag anywhere and the literal class name `widget-panel`
    present -- the only combination `simple_web_layout_uses_legacy_widget_chrome`
    accepts. Passed through `simple_web_layout_render_html_software_pixels_tile_lane`
    with tiled=true, this forces `paint_tiled`'s widget_mode branch, which
    short-circuits straight to the classic `paint()` and never builds a
    clip cache, tile grid, or survivor set."""
    "<html><body><div class=\"widget-panel wp\">x</div></body></html>"

describe "paint_tiled: widget_mode early-return branch":

    it "routes a legacy-widget-chrome document straight to the classic painter (tiled == classic)":
        val html = _pl_tiled_widget_doc()
        val tiled = simple_web_layout_render_html_software_pixels_tile_lane(
            html, 32, 24, 0, 24, true)
        val classic = simple_web_layout_render_html_software_pixels_tile_lane(
            html, 32, 24, 0, 24, false)
        # widget_mode short-circuits paint_tiled to `paint(...)` unconditionally,
        # so the tiled and classic lanes must be byte-identical -- any tile
        # culling/survivor-set involvement would risk a divergence here since
        # the widget-chrome background base color differs from the normal
        # canvas background path.
        assert_equal(tiled.len(), 768)
        assert_equal(classic.len(), 768)
        assert_equal(tiled, classic)
        # Widget chrome base fill is argb(245,245,245); confirm the branch
        # actually painted the widget-chrome background, not the plain-page
        # white background (which would mean widget_mode was silently false).
        assert_equal(tiled[0], 0xFFF5F5F5u32)
