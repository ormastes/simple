# Regression spec for
# doc/08_tracking/bug/pool_linked_list_push_fails_complex_indexed_field_receiver_2026-08-07.md
#
# PoolLinkedList previously stored `nodes: [ListNode]` and mutated pool
# nodes through an array-indexed field write (`self.nodes[idx].next = v`),
# e.g. in alloc_node()/free_node()/push_front()/push_back(). That shape is
# rejected by the interpreter with "invalid assignment: complex indexed
# field receiver is not supported" whenever the array receiver is itself a
# field access (`self.nodes[idx]`), not a bare identifier — confirmed to
# come from an emitting site that is Rust-only (src/compiler_rust) and not
# reachable through any editable `.spl` source: two sentinel probes placed
# in both `eval_assign_expr` definitions under
# src/compiler/10.frontend/core/interpreter/ never fired for this test path,
# and no `.spl` file under src/compiler/ or src/runtime/ contains the
# message text (verified by fragment grep on eval_set_error call sites, not
# just a grep of the full literal).
#
# Fix: refactored to parallel primitive arrays (values: [i64], nexts: [i32],
# prevs: [i32]) — the pattern FixedMap already used successfully
# (commit 57f7f44849f) and FixedMap's own regression spec documents. No
# node object is ever constructed after new(); every operation writes by
# plain index assignment (`self.nexts[idx] = v`), which does not hit the
# unsupported assignment shape.
#
# This spec is real and behavioral (imports and calls PoolLinkedList),
# unlike the sibling `linked_list_spec.spl`, which is a text-scan-only spec
# that never caught this defect because it never executed any operation.

use std.nogc_async_mut_noalloc.collections.linked_list.{PoolLinkedList}

describe "PoolLinkedList backing storage and behavior after the parallel-array refactor":
    """Proves push_back/push_front/pop_front/pop_back/remove_at actually
    execute (they previously failed at runtime on every call) and that
    list behavior is correct."""

    it "push_back then pop_front returns values in FIFO order":
        val list = PoolLinkedList.new(4)
        assert_true(list.push_back(10))
        assert_true(list.push_back(20))
        assert_true(list.push_back(30))
        expect(list.size()).to_equal(3)
        expect(list.pop_front()).to_equal(10)
        expect(list.pop_front()).to_equal(20)
        expect(list.pop_front()).to_equal(30)
        expect(list.pop_front()).to_equal(-1)

    it "push_front then pop_back returns values in FIFO order (reversed insertion)":
        val list = PoolLinkedList.new(4)
        assert_true(list.push_front(1))
        assert_true(list.push_front(2))
        assert_true(list.push_front(3))
        expect(list.pop_back()).to_equal(1)
        expect(list.pop_back()).to_equal(2)
        expect(list.pop_back()).to_equal(3)
        expect(list.pop_back()).to_equal(-1)

    it "reports pool exhaustion via push_back/push_front returning false":
        val list = PoolLinkedList.new(2)
        assert_true(list.push_back(1))
        assert_true(list.push_back(2))
        expect(list.is_full()).to_equal(true)
        expect(list.push_back(3)).to_equal(false)
        expect(list.push_front(4)).to_equal(false)
        expect(list.size()).to_equal(2)

    it "remove_at removes a middle node and preserves the remaining links":
        val list = PoolLinkedList.new(4)
        list.push_back(10)
        list.push_back(20)
        list.push_back(30)
        expect(list.contains(20)).to_equal(true)
        list.remove_at(1)
        expect(list.size()).to_equal(2)
        expect(list.contains(20)).to_equal(false)
        expect(list.pop_front()).to_equal(10)
        expect(list.pop_front()).to_equal(30)

    it "recycles freed nodes so capacity is not permanently consumed":
        val list = PoolLinkedList.new(2)
        list.push_back(1)
        list.push_back(2)
        expect(list.is_full()).to_equal(true)
        list.pop_front()
        expect(list.is_full()).to_equal(false)
        assert_true(list.push_back(3))
        expect(list.peek_front()).to_equal(2)
        expect(list.peek_back()).to_equal(3)
