use std.spec.*
use std.hardware.rv64gc_rtl.csr.misa_rv64imac

val MISA_FD: i64 = (1 << 5) | (1 << 3)
val MISA_SU: i64 = (1 << 18) | (1 << 20)

describe "RV64IMAC product MISA":
    it "advertises implemented S/U privilege without F/D":
        val misa = misa_rv64imac()
        expect(misa & MISA_SU).to_equal(MISA_SU)
        expect(misa & MISA_FD).to_equal(0)
