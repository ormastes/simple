# Runnable probe for the SimpleOS / WB-SoC testbench generator — generates the
# three XLEN PAIRS, byte-compares each of the six files against its golden, and
# proves determinism by generating every file a second time.
# Run: bin/simple run test/01_unit/lib/hardware/vhdl_gen/probe_tb_simpleos_wb_gen.spl

use std.hardware.riscv_common.xlen.XlenConfig
use std.hardware.vhdl_gen.tb_simpleos_wb_gen.{generate_wb_soc_smoke, generate_simpleos_boot, generate_simpleos_boot_axi}

extern fn rt_file_read_text(path: text) -> text

fn check(name: text, ok: bool) -> i64:
    if ok:
        print("PASS " + name)
        0
    else:
        print("FAIL " + name)
        1

fn first_diff(a: text, b: text) -> i64:
    var i = 0
    val n = if a.len() < b.len(): a.len() else: b.len()
    while i < n:
        if a[i] != b[i]:
            return i
        i = i + 1
    if a.len() == b.len():
        -1
    else:
        n

fn line_of(s: text, pos: i64) -> i64:
    var i = 0
    var line = 1
    while i < pos and i < s.len():
        if s[i] == '\n':
            line = line + 1
        i = i + 1
    line

fn gen_for(name: text) -> text:
    if name == "tb_rv32_wb_soc_smoke.vhd":
        generate_wb_soc_smoke(XlenConfig.rv32())
    elif name == "tb_rv64_wb_soc_smoke.vhd":
        generate_wb_soc_smoke(XlenConfig.rv64())
    elif name == "tb_rv32_simpleos_boot.vhd":
        generate_simpleos_boot(XlenConfig.rv32())
    elif name == "tb_rv64_simpleos_boot.vhd":
        generate_simpleos_boot(XlenConfig.rv64())
    elif name == "tb_rv32_simpleos_boot_axi.vhd":
        generate_simpleos_boot_axi(XlenConfig.rv32(), "")
    else:
        generate_simpleos_boot_axi(XlenConfig.rv64(), "")

fn target_names() -> [text]:
    var n: [text] = []
    n = n.push("tb_rv32_wb_soc_smoke.vhd")
    n = n.push("tb_rv64_wb_soc_smoke.vhd")
    n = n.push("tb_rv32_simpleos_boot.vhd")
    n = n.push("tb_rv64_simpleos_boot.vhd")
    n = n.push("tb_rv32_simpleos_boot_axi.vhd")
    n = n.push("tb_rv64_simpleos_boot_axi.vhd")
    n

fn main():
    var fails = 0
    val names = target_names()
    var i = 0
    while i < names.len():
        val golden = rt_file_read_text("examples/09_embedded/fpga_riscv/rtl/" + names[i])
        val gen = gen_for(names[i])
        val ok = gen == golden
        fails = fails + check(names[i] + " byte-identical (len " + gen.len().to_text() +
            " vs " + golden.len().to_text() + ")", ok)
        if not ok:
            val d = first_diff(gen, golden)
            print("  first diff at byte " + d.to_text() + " (gen line " + line_of(gen, d).to_text() +
                ", golden line " + line_of(golden, d).to_text() + ")")
            var lo = d - 140
            if lo < 0:
                lo = 0
            print("  GEN    ...|" + gen.substring(lo, d + 90) + "|")
            print("  GOLDEN ...|" + golden.substring(lo, d + 90) + "|")
        i = i + 1
    # determinism: a second generation pass must be byte-identical
    i = 0
    var det_ok = true
    while i < names.len():
        if gen_for(names[i]) != gen_for(names[i]):
            det_ok = false
            print("  NONDETERMINISTIC: " + names[i])
        i = i + 1
    fails = fails + check("determinism (regenerate all 6)", det_ok)
    if fails == 0:
        print("TB_SIMPLEOS_WB PROBE: ALL PASS")
    else:
        print("TB_SIMPLEOS_WB PROBE: " + fails.to_text() + " FAILURES")
