use std.io_runtime.{file_read}
use std.spec.{describe, it, expect}
use nogc_sync_mut.platform.{normalize_path, is_absolute_path, join_path}

describe "nogc_sync_mut platform path ownership":

    it "retains canonical path implementations through native entry closure":
        val source = file_read("src/lib/nogc_sync_mut/platform.spl")
        expect(source).to_contain("export use nogc_sync_mut.path.{normalize_path, is_absolute_path, join_path}")
        expect(source.contains("path.normalize_path(input_path)")).to_equal(false)

    it "forwards path behavior without a runtime module object":
        expect(normalize_path("alpha\\beta")).to_equal("alpha/beta")
        expect(is_absolute_path("/tmp/simple")).to_equal(true)
        expect(join_path("alpha", "beta")).to_equal("alpha/beta")
