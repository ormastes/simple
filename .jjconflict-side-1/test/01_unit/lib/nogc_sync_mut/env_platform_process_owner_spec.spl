use std.spec

describe "environment process runtime ownership":
    it "routes environment platform calls through semantic owners":
        val platform = file_read("src/lib/nogc_sync_mut/env/platform.spl")
        val types = file_read("src/lib/nogc_sync_mut/env/types.spl")
        val init = file_read("src/lib/nogc_sync_mut/env/__init__.spl")
        val async_init = file_read("src/lib/nogc_async_mut/env/__init__.spl")

        expect(platform).to_contain(r"use std.nogc_sync_mut.io.env_ops.{home_raw, cwd_raw}")
        expect(platform).to_contain(r"use std.nogc_sync_mut.io.process_ops.{process_run_raw}")
        expect(platform).to_contain(r"use std.nogc_sync_mut.io.sysinfo_ops.{hostname}")
        expect(platform.contains("extern fn rt_process_run")).to_equal(false)
        expect(types).to_contain("extern fn rt_process_run")
        expect(types).to_contain("export rt_env_get, rt_env_home, rt_env_set, rt_env_cwd, rt_env_remove, rt_hostname, rt_process_run, rt_env_vars")
