use std.spec.*
use std.nogc_sync_mut.debug.remote.protocol.process_command.{debug_process_output, debug_shell_output}

describe "bounded debug command output":
    it "returns stdout for a successful command":
        val result = debug_process_output("printf", ["debug-ok"])
        match result:
            Ok(output): expect(output).to_equal("debug-ok")
            Err(error): fail("successful command failed: {error}")

    it "keeps command failure distinct from empty stdout":
        val result = debug_process_output(
            "/bin/sh",
            ["-c", "printf 'debug-failed' >&2; exit 7"]
        )
        match result:
            Ok(_): fail("failed command was accepted as successful output")
            Err(error):
                expect(error).to_contain("exit code 7")
                expect(error).to_contain("debug-failed")

    it "passes shell values as data rather than executable syntax":
        val result = debug_shell_output(
            "printf '%s' \"$1\"",
            ["$(printf injected)"]
        )
        match result:
            Ok(output): expect(output).to_equal("$(printf injected)")
            Err(error): fail("literal shell argument failed: {error}")
