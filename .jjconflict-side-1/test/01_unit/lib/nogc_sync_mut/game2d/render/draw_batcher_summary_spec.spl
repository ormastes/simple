# @cover src/lib/nogc_sync_mut/game2d/render/draw_batcher.spl 60%
#
# Reproduce for the `text(...)` E1002 defect: `BatchStats.summary()` used the
# unresolvable `text(n)` conversion spelling and failed any co-compiled unit
# that called it (`function \`text\` not found`). Pins the interpolated form.

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.game2d.render.draw_batcher.{DrawBatcher}
use std.nogc_sync_mut.game2d.render.image.{Image}
use std.nogc_sync_mut.engine.render.command.{RenderCommandBuffer}
use std.nogc_sync_mut.engine.sprite.sprite.{Sprite}
use std.common.engine.ids.{TextureId}
use std.common.engine.units.{ZIndex}
use std.common.engine.rect.{Rect2}
use std.common.engine.color.{EngineColor}

fn _img(tid: i64) -> Image:
    Image.from_sprite(
        Sprite.create(TextureId(raw: tid), Rect2(x: 0.0, y: 0.0, width: 8.0, height: 8.0)), 8, 8)

describe "DrawBatcher batch stats summary":
    it "renders a readable summary after a flushed frame":
        var batcher = DrawBatcher.create()
        batcher.begin_frame()
        batcher.submit_tinted(_img(1), Rect2(x: 0.0, y: 0.0, width: 8.0, height: 8.0), EngineColor.white(), ZIndex(value: 0))
        batcher.submit_tinted(_img(1), Rect2(x: 8.0, y: 0.0, width: 8.0, height: 8.0), EngineColor.white(), ZIndex(value: 0))
        batcher.submit_tinted(_img(2), Rect2(x: 0.0, y: 8.0, width: 8.0, height: 8.0), EngineColor.white(), ZIndex(value: 1))
        var buf = RenderCommandBuffer.create()
        batcher.end_frame(buf)
        val stats = batcher.last_stats()
        expect(stats.sprites_submitted).to_equal(3)
        expect(stats.summary()).to_equal("sprites=3 draw_calls=2 tex_switches=1")
