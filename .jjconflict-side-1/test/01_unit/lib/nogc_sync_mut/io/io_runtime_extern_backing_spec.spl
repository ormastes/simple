"""
## Purpose and audience
Purpose: Prove FROM SIMPLE that the raw `rt_*` file, directory, environment,
clock, process and hash externs behind `std.io_runtime` actually resolve and
behave — rather than silently returning nil, zero, false or "".
Audience: runtime, stdlib and platform maintainers.

## Why the externs are re-declared here instead of importing std.io_runtime
Two independent reasons, both deliberate:

  1. The wrappers in `src/lib/nogc_sync_mut/io_runtime.spl` normalise the raw
     sentinel away — `env_get` turns a nil into "", `read_file` turns a nil into
     "". Through the wrapper the nil is unobservable, which is exactly the
     silent-nil defect class this spec exists to detect. The raw declaration
     keeps the optional visible.
  2. Importing that module is not currently possible on every toolchain (see
     "Toolchain note" below), and coverage of the runtime surface should not be
     hostage to a facade.

These declarations are copied verbatim from `io_runtime.spl` lines 51-113,
minus the `@unsafe(...)` attribute lines.

## Discrimination method
Every assertion was written against one question: "would this still pass if the
extern returned nil / 0 / false / ''?" Three techniques are used:

  1. ROUNDTRIP ON A NONCE. Write a unique value, read it back, compare. A nil
     read decays and cannot equal the nonce. A bare existence check is rejected:
     `rt_file_exists(...) == false` passes against a stub that always says no.
  2. FLOOR AND CEILING ON A CLOCK. `rt_time_now_unix_micros()` must sit inside a
     plausible window. nil/0 fails the floor; a large constant sentinel fails
     the ceiling. "Returns an integer" would discriminate nothing.
  3. MEMBERSHIP IN A CLOSED SET. `rt_platform_name()` must be a name we accept.
     nil -> "" is not a member.

State-changing operations are asserted as SEQUENCES (absent -> present ->
absent), because any single reading passes against a constant-answer stub.

Assertions that could NOT be made discriminating from Simple alone are marked
NOT DISCRIMINATING in a comment and kept deliberately, never quietly dropped.

## Toolchain note
`use std.io_runtime` (and `std.fs`, `std.platform`, which re-export it) fails to
load on a compiler that predates the `@always_inline` decorator:

    error: semantic: unknown decorator `@always_inline` on function `file_read_nullable`

That is a stale-artifact symptom, not a defect in this spec; the raw-extern form
below is unaffected by it.

## Compatibility and limitations
Platform-neutral. All filesystem work happens under a nonce-named directory
beneath the process working directory, is created by this spec and removed by
it. Forward slashes are used throughout, which Windows accepts. `platform_name`
is checked against the union of accepted names rather than against one host.

Related defect class:
doc/08_tracking/bug/unregistered_extern_silent_nil_2026-08-01.md
"""

use std.spec

extern fn rt_file_read_text(path: text) -> text?
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool
extern fn rt_file_size(path: text) -> i64
extern fn rt_env_get(key: text) -> text?
extern fn rt_env_cwd() -> text?
extern fn rt_env_set(key: text, value_str: text) -> bool
extern fn rt_getpid() -> i64
extern fn rt_time_now_unix_micros() -> i64
extern fn rt_time_now_monotonic_ms() -> i64
extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_dir_exists(path: text) -> bool
extern fn rt_dir_remove_all(path: text) -> bool
extern fn rt_platform_name() -> text?
extern fn rt_hash_text(s: text) -> i64

fn check(condition: bool):
    expect(condition).to_equal(true)

# A per-run nonce so a stale artifact from an earlier run can never be mistaken
# for this run's write. Derived from the clock and the pid, both of which are
# themselves asserted below.
fn run_nonce() -> text:
    "{rt_time_now_unix_micros()}_{rt_getpid()}"

fn scratch_root() -> text:
    (rt_env_cwd() ?? ".") + "/build/io_runtime_extern_backing_spec"

describe "rt_* clock and process externs":
    # DISCRIMINATING. 1600000000000000 us is 2020-09-13. A nil-decayed 0, a
    # negative failure sentinel, or a seconds/millis value mistakenly returned
    # as micros all fall below the floor.
    it "rt_time_now_unix_micros is above a past epoch floor":
        check(rt_time_now_unix_micros() > 1600000000000000)

    # DISCRIMINATING against a stub returning an arbitrary large constant such
    # as i64 max. 2524608000000000 us is 2050-01-01.
    it "rt_time_now_unix_micros is below a far-future ceiling":
        check(rt_time_now_unix_micros() < 2524608000000000)

    # DISCRIMINATING. A monotonic clock must never move backwards. Two equal
    # zeroes would satisfy this, so it is paired with the advance check below
    # rather than relied on alone.
    it "rt_time_now_monotonic_ms does not go backwards across two reads":
        val first = rt_time_now_monotonic_ms()
        val second = rt_time_now_monotonic_ms()
        check(second >= first)

    # DISCRIMINATING. A frozen or nil-decayed clock cannot advance across real
    # work; the loop below is deliberately long enough to consume >=1 ms and
    # the result is compared against the pre-loop reading.
    it "rt_time_now_monotonic_ms advances across measurable work":
        val before = rt_time_now_monotonic_ms()
        var acc = 0
        var i = 0
        while i < 4000000:
            acc = acc + i
            i = i + 1
        check(acc > 0)
        check(rt_time_now_monotonic_ms() > before)

    # DISCRIMINATING. nil/0 fails; a real pid is strictly positive. The
    # stability half rules out a stub that returns a fresh random number.
    it "rt_getpid is positive and stable within one process":
        val first = rt_getpid()
        check(first > 0)
        expect(rt_getpid()).to_equal(first)

describe "rt_* platform and cwd externs":
    # DISCRIMINATING. Closed-set membership; nil -> "" is not a member.
    it "rt_platform_name returns a recognised platform name":
        val raw = rt_platform_name()
        check(raw != nil)
        val name = (raw ?? "").lower()
        val known = name == "windows" or name == "linux" or name == "macos" or name == "darwin" or name == "freebsd" or name == "openbsd" or name == "netbsd"
        check(known)

    # DISCRIMINATING. nil is visible here because the optional is not erased.
    it "rt_env_cwd returns a non-nil, non-trivial path":
        val here = rt_env_cwd()
        check(here != nil)
        check((here ?? "").len() > 1)

    # DISCRIMINATING. The path the cwd extern reports must be a directory the
    # dir extern also sees; a nil/"" cwd makes this a query on "" and fails.
    it "the directory named by rt_env_cwd actually exists":
        check(rt_dir_exists(rt_env_cwd() ?? ""))

describe "rt_* environment externs":
    # DISCRIMINATING. Roundtrip on a nonce: a nil-returning rt_env_get cannot
    # equal it. Asserting only that rt_env_set returned true would prove nothing
    # about the read path.
    it "rt_env_set then rt_env_get roundtrips a unique value":
        val key = "SIMPLE_SPEC_RT_EXTERN_PROBE"
        val value = "probe-" + run_nonce()
        check(rt_env_set(key, value))
        val observed = rt_env_get(key)
        check(observed != nil)
        expect(observed ?? "").to_equal(value)

    # DISCRIMINATING. The second write must REPLACE the first; a stub that
    # caches, or one that returns nil, fails.
    it "rt_env_set overwrites a previously stored value":
        val key = "SIMPLE_SPEC_RT_EXTERN_PROBE2"
        rt_env_set(key, "first-" + run_nonce())
        val second = "second-" + run_nonce()
        check(rt_env_set(key, second))
        expect(rt_env_get(key) ?? "").to_equal(second)

    # DISCRIMINATING at the RAW layer, and this is precisely why the raw form is
    # used here: an absent key must produce nil, which the `env_get` wrapper
    # would have normalised to "" — making the broken and working cases
    # indistinguishable. Through the wrapper this assertion is impossible.
    it "rt_env_get returns nil for a key that was never set":
        check(rt_env_get("SIMPLE_SPEC_RT_EXTERN_DEFINITELY_ABSENT_ZZQ") == nil)

describe "rt_* directory externs":
    # DISCRIMINATING. Create-then-observe: rt_dir_exists must flip false ->
    # true. The "before" half alone would pass against a stub that always says
    # false, so both halves live in one scenario.
    it "rt_dir_create_all creates a directory rt_dir_exists then reports":
        val path = scratch_root() + "/d" + run_nonce()
        check(not rt_dir_exists(path))
        check(rt_dir_create_all(path))
        check(rt_dir_exists(path))
        rt_dir_remove_all(path)

    # DISCRIMINATING for the "all" semantics specifically: the observation is
    # made on the DEEPEST level, which a single-level mkdir never creates.
    it "rt_dir_create_all creates intermediate levels":
        val root = scratch_root() + "/n" + run_nonce()
        val deep = root + "/a/b/c"
        check(rt_dir_create_all(deep))
        check(rt_dir_exists(deep))
        rt_dir_remove_all(root)

    # DISCRIMINATING. Removal must flip rt_dir_exists back to false, and the
    # directory was proven present first.
    it "rt_dir_remove_all removes a directory it can see":
        val path = scratch_root() + "/r" + run_nonce()
        check(rt_dir_create_all(path))
        check(rt_dir_exists(path))
        check(rt_dir_remove_all(path))
        check(not rt_dir_exists(path))

describe "rt_* file externs":
    # DISCRIMINATING. The nonce roundtrip is the strongest oracle available from
    # Simple: only a working write AND a working read produce it. The explicit
    # nil check makes the failure mode legible when it does break.
    it "rt_file_write_text then rt_file_read_text roundtrips unique content":
        val dir = scratch_root()
        rt_dir_create_all(dir)
        val path = dir + "/rt" + run_nonce() + ".txt"
        val content = "simple-side-runtime-probe-" + run_nonce()
        check(rt_file_write_text(path, content))
        val observed = rt_file_read_text(path)
        check(observed != nil)
        expect(observed ?? "").to_equal(content)
        rt_file_delete(path)

    # DISCRIMINATING. Multi-line content catches a read path that truncates at a
    # newline — which a single-token roundtrip cannot see.
    it "rt_file_read_text preserves multi-line content":
        val dir = scratch_root()
        rt_dir_create_all(dir)
        val path = dir + "/ml" + run_nonce() + ".txt"
        val content = "line one\nline two\nline three\ntail " + run_nonce()
        check(rt_file_write_text(path, content))
        expect(rt_file_read_text(path) ?? "").to_equal(content)
        rt_file_delete(path)

    # DISCRIMINATING. rt_file_exists must flip false -> true -> false around a
    # write and a delete. Any single one of the three readings would pass
    # against a constant-answer stub; the sequence would not.
    it "rt_file_exists tracks creation and deletion":
        val dir = scratch_root()
        rt_dir_create_all(dir)
        val path = dir + "/ex" + run_nonce() + ".txt"
        check(not rt_file_exists(path))
        check(rt_file_write_text(path, "x"))
        check(rt_file_exists(path))
        check(rt_file_delete(path))
        check(not rt_file_exists(path))

    # DISCRIMINATING. Compared against the byte length this spec chose, so both
    # a 0/-1 sentinel and a constant-answer stub fail.
    it "rt_file_size reports the byte length of what was written":
        val dir = scratch_root()
        rt_dir_create_all(dir)
        val path = dir + "/sz" + run_nonce() + ".txt"
        check(rt_file_write_text(path, "0123456789abcdef"))
        expect(rt_file_size(path)).to_equal(16)
        rt_file_delete(path)

    # DISCRIMINATING. A rewrite must REPLACE, not append: the second read equals
    # the second content exactly rather than containing both.
    it "rt_file_write_text replaces rather than appends on rewrite":
        val dir = scratch_root()
        rt_dir_create_all(dir)
        val path = dir + "/rw" + run_nonce() + ".txt"
        check(rt_file_write_text(path, "first-content-aaaaaaaa"))
        val second = "second-" + run_nonce()
        check(rt_file_write_text(path, second))
        expect(rt_file_read_text(path) ?? "").to_equal(second)
        rt_file_delete(path)

    # DISCRIMINATING at the RAW layer. Reading a file that does not exist must
    # yield nil; the `read_file` wrapper normalises this to "" and so cannot
    # tell a missing file from a broken runtime.
    it "rt_file_read_text returns nil for a path that does not exist":
        val missing = scratch_root() + "/definitely-absent-" + run_nonce() + ".txt"
        check(not rt_file_exists(missing))
        check(rt_file_read_text(missing) == nil)

describe "rt_hash_text extern":
    # DISCRIMINATING. Determinism alone is satisfied by a nil-decayed constant
    # 0, so it is asserted together with the distinctness row below and neither
    # is relied on alone.
    it "rt_hash_text is deterministic for one input":
        val h = rt_hash_text("simple-runtime-probe")
        expect(rt_hash_text("simple-runtime-probe")).to_equal(h)

    # DISCRIMINATING. A stub that always returns the same value (0 included)
    # fails here. Together with determinism above this pins a real hash.
    it "rt_hash_text separates two different inputs":
        check(rt_hash_text("alpha") != rt_hash_text("beta"))

    # DISCRIMINATING for an avalanche-free or prefix-only hash: the two inputs
    # differ in exactly one byte at the LAST position.
    it "rt_hash_text separates inputs differing only in the final byte":
        check(rt_hash_text("prefix-shared-value-A") != rt_hash_text("prefix-shared-value-B"))

describe "text and array operations (no extern involved)":
    # DISCRIMINATING for any nil-decay in the text paths, but note these are
    # compiler/stdlib intrinsics rather than rt_* externs; they are included as
    # a baseline that the harness itself is sound, not as runtime evidence.
    it "text length, case and containment match computed expectations":
        val s = "Simple-Runtime-Probe"
        expect(s.len()).to_equal(20)
        expect(s.lower()).to_equal("simple-runtime-probe")
        expect(s.upper()).to_equal("SIMPLE-RUNTIME-PROBE")
        check(s.contains("Runtime"))
        check(not s.contains("runtime-absent"))

    # DISCRIMINATING. The total is a computed oracle, not a restatement of input.
    it "array iteration accumulates a computed total":
        val xs = [3, 1, 4, 1, 5, 9, 2, 6]
        var total = 0
        for x in xs:
            total = total + x
        expect(total).to_equal(31)
        expect(xs.len()).to_equal(8)

    # DISCRIMINATING. Append grows by exactly one and places the element last.
    # `xs` must be `var`: `append` is a MUTATING method and the compiler rejects
    # it on an immutable binding ("cannot call mutating method 'append' on
    # immutable array"). That rejection was observed while writing this spec and
    # is recorded here so the next author does not rediscover it.
    it "array append grows the collection and places the element last":
        var xs = [10, 20, 30]
        val ys = xs.append(40)
        expect(ys.len()).to_equal(4)
        expect(ys[3]).to_equal(40)
