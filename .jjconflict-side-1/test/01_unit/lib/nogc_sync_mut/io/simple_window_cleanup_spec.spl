use std.spec
use common.io.window_event.{WINDOW_STATUS_OK}
use std.nogc_sync_mut.io.simple_window.{SimpleWindow}

describe "Simple Window close cleanup":
    it "releases queued text and pixel ownership to baseline":
        var runtime = SimpleWindow.headless(8, 8)
        val baseline_windows = runtime.live_window_count()
        val baseline_pixels = runtime.pixel_surface_count()
        val baseline_events = runtime.events.queued_count()
        val baseline_text = runtime.events.text_live_count()
        val window = runtime.create_window("cleanup", 2, 2)
        expect(runtime.stage_argb(
            window, 2, 2, [1u32, 2u32, 3u32, 4u32]
        )).to_equal(WINDOW_STATUS_OK)
        expect(runtime.inject_text(window, 1, "Simple")).to_equal(
            WINDOW_STATUS_OK
        )
        expect(runtime.events.queued_count()).to_equal(baseline_events + 1)
        expect(runtime.events.text_live_count()).to_equal(baseline_text + 1)

        expect(runtime.destroy_window(window)).to_equal(WINDOW_STATUS_OK)
        expect(runtime.live_window_count()).to_equal(baseline_windows)
        expect(runtime.pixel_surface_count()).to_equal(baseline_pixels)
        expect(runtime.events.queued_count()).to_equal(baseline_events)
        expect(runtime.events.text_live_count()).to_equal(baseline_text)
