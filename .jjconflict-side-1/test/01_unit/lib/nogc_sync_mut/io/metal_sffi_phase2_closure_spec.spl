extern fn rt_file_read_text(path: text) -> text

describe "Metal SFFI Phase2 closure":
    it "uses the runtime-owned typed byte-array pointer facade":
        val source = rt_file_read_text("src/lib/nogc_sync_mut/io/metal_sffi.spl") ?? ""
        expect(source).to_contain("extern fn rt_array_data_ptr_u8(values: [u8]) -> i64")
        expect(source).to_contain("rt_array_data_ptr_u8(params), params.len()")

