"""
# Enterprise Assets Vertical — register, depreciation, posting, disposal

## Overview

A finance actor acquires a fixed asset in the durable enterprise store,
capitalizes an improvement into its basis, posts a straight-line depreciation
schedule period by period, and finally disposes of it for a gain or a loss.
Every write runs the frozen guarded sequence (session -> rbac -> validation ->
idempotency -> effects in one UoW) and chains a sha256 audit record; every read
is a pure fold over insert-only rows.

## Arithmetic proven here (exact, integer, float-free)

Straight line spreads `basis - salvage` over `life_periods`, with the
integer-division remainder absorbed by the FINAL period:

| basis | salvage | life | schedule | sum |
|-------|---------|------|----------|-----|
| 10000 | 1000 | 3 | 3000, 3000, 3000 | 9000 |
| 10000 | 0 | 3 | 3333, 3333, 3334 | 10000 |

The 3334 last period is the whole point: a float schedule would drift, this one
reconciles to the cent. Capitalizing 2000 onto a 10000/1000/3 asset moves the
basis to 12000 and the schedule to 11000/3 = 3666, 3666, 3668.

## Guarded sequence proven (reproduce-first for each denial)

| Rung | Denial reason | Scenario |
|------|---------------|----------|
| rbac | forbidden | a `sales` actor cannot acquire an asset |
| validation | invalid-record | a NEGATIVE life is rejected at acquire |
| validation | invalid-record | a SECOND disposal of the same asset is rejected |
| idempotency | duplicate-key | replay returns recorded result, no second effect |

Plus: tenant isolation (tenant B's folds never see tenant A's assets).

**Requirements:** N/A
**Plan:** doc/03_plan/agent_tasks/simple_erp.md

Lane: .spipe/simple_enterprise_suite (W23-FAN, assets).
"""

use std.spec.*
use std.io_runtime.{file_exists, file_delete, dir_create_all}
use std.nogc_sync_mut.enterprise_store.store.{store_open, store_close}
use std.nogc_sync_mut.enterprise_store.records.{audit_verify_chain, outbox_pending}
use std.nogc_sync_mut.enterprise_sale.foundation.{
    TenantContext, ActorContext, SessionContext, CommandEnvelope,
    reason_allowed
}
use std.nogc_sync_mut.enterprise_assets.assets.{
    assets_setup, assets_acquire, assets_capitalize, assets_post_period, assets_dispose,
    assets_find, assets_cost_basis, assets_schedule, assets_schedule_total,
    assets_accumulated, assets_book_value, assets_book_value_money,
    assets_gain_loss, assets_disposed, assets_period_posted
}

fn db_path(name: text) -> text:
    "build/test-artifacts/assets_" + name + ".db"

fn tenant_a() -> TenantContext:
    TenantContext(tenant_id: "tenant-a", name: "Alpha Trading")

fn tenant_b() -> TenantContext:
    TenantContext(tenant_id: "tenant-b", name: "Beta Retail")

fn cfo_a() -> ActorContext:
    ActorContext(actor_id: "cfo-1", role: "finance")

fn clerk_a() -> ActorContext:
    ActorContext(actor_id: "clerk-1", role: "sales")

fn session_for(who: ActorContext, tenant: TenantContext) -> SessionContext:
    SessionContext(token: "tok-" + who.actor_id, actor_id: who.actor_id, tenant_id: tenant.tenant_id, active: true)

fn envelope(key: text) -> CommandEnvelope:
    CommandEnvelope(request_id: "req-" + key, idempotency_key: key, action: "assets.cmd", payload: "")

fn fresh_store(name: text):
    dir_create_all("build/test-artifacts")
    if file_exists(db_path(name)):
        file_delete(db_path(name))
    val store = store_open(db_path(name))
    assets_setup(store)
    store

describe "assets vertical — acquire registers a depreciable asset":
    it "finance acquires 10000/1000/3 and the register folds it back exactly":
        step("Open a clean store")
        val store = fresh_store("acquire")
        val t = tenant_a()
        val cfo = cfo_a()
        val s = session_for(cfo, t)

        step("Acquire asset FA-1: cost 10000, salvage 1000, life 3 periods")
        val r = assets_acquire(store, s, t, cfo, envelope("a-1"), "FA-1", 10000, 1000, 3)
        expect(r.reason).to_equal("accepted")
        expect(reason_allowed(r.reason)).to_be(true)

        step("The acquisition row folds back with every field intact")
        val rec = assets_find(store, "tenant-a", "FA-1")
        expect(rec.found).to_be(true)
        expect(rec.cost_cents).to_equal(10000)
        expect(rec.salvage_cents).to_equal(1000)
        expect(rec.life_periods).to_equal(3)

        step("Basis equals cost before any capitalization; book value equals basis")
        expect(assets_cost_basis(store, "tenant-a", "FA-1")).to_equal(10000)
        expect(assets_accumulated(store, "tenant-a", "FA-1")).to_equal(0)
        expect(assets_book_value(store, "tenant-a", "FA-1")).to_equal(10000)

        step("An unknown asset folds to not-found with a zero basis")
        expect(assets_find(store, "tenant-a", "NOPE").found).to_be(false)
        expect(assets_cost_basis(store, "tenant-a", "NOPE")).to_equal(0)

        step("The audit chain recomputes end to end")
        expect(audit_verify_chain(store, "tenant-a")).to_be(true)
        store_close(store)

describe "assets vertical — straight-line schedule reconciles to the cent":
    it "10000/1000/3 spreads evenly; 10000/0/3 puts the remainder in the LAST period":
        val store = fresh_store("schedule")
        val t = tenant_a()
        val cfo = cfo_a()
        val s = session_for(cfo, t)

        step("Even case: (10000-1000)/3 = 3000 per period, summing to 9000")
        assets_acquire(store, s, t, cfo, envelope("s-even"), "FA-EVEN", 10000, 1000, 3)
        val even = assets_schedule(store, "tenant-a", "FA-EVEN")
        expect(even.len()).to_equal(3)
        expect(even[0]).to_equal(3000)
        expect(even[1]).to_equal(3000)
        expect(even[2]).to_equal(3000)
        expect(assets_schedule_total(store, "tenant-a", "FA-EVEN")).to_equal(9000)

        step("Remainder case: 10000/3 = 3333 r1 -> 3333, 3333, 3334 (last carries +1)")
        assets_acquire(store, s, t, cfo, envelope("s-odd"), "FA-ODD", 10000, 0, 3)
        val odd = assets_schedule(store, "tenant-a", "FA-ODD")
        expect(odd.len()).to_equal(3)
        expect(odd[0]).to_equal(3333)
        expect(odd[1]).to_equal(3333)
        expect(odd[2]).to_equal(3334)

        step("The schedule reconciles EXACTLY to basis - salvage — no float drift")
        expect(assets_schedule_total(store, "tenant-a", "FA-ODD")).to_equal(10000)
        store_close(store)

describe "assets vertical — capitalization moves the basis and the schedule":
    it "capitalizing 2000 onto 10000/1000/3 gives basis 12000 and 3666/3666/3668":
        val store = fresh_store("capitalize")
        val t = tenant_a()
        val cfo = cfo_a()
        val s = session_for(cfo, t)
        assets_acquire(store, s, t, cfo, envelope("c-acq"), "FA-2", 10000, 1000, 3)

        step("Capitalize a 2000-cent improvement")
        val cap = assets_capitalize(store, s, t, cfo, envelope("c-1"), "FA-2", 2000)
        expect(cap.reason).to_equal("accepted")
        expect(assets_cost_basis(store, "tenant-a", "FA-2")).to_equal(12000)

        step("Depreciable is now 11000; 11000/3 = 3666 r2 -> 3666, 3666, 3668")
        val sched = assets_schedule(store, "tenant-a", "FA-2")
        expect(sched[0]).to_equal(3666)
        expect(sched[1]).to_equal(3666)
        expect(sched[2]).to_equal(3668)
        expect(assets_schedule_total(store, "tenant-a", "FA-2")).to_equal(11000)

        step("Capitalizing a non-positive amount, or onto an unknown asset, is rejected")
        expect(assets_capitalize(store, s, t, cfo, envelope("c-2"), "FA-2", 0).reason).to_equal("invalid-record")
        expect(assets_capitalize(store, s, t, cfo, envelope("c-3"), "NOPE", 500).reason).to_equal("invalid-record")
        store_close(store)

describe "assets vertical — period posting accumulates to the salvage floor":
    it "posting all 3 periods of 10000/1000/3 leaves book value at the 1000 salvage":
        val store = fresh_store("posting")
        val t = tenant_a()
        val cfo = cfo_a()
        val s = session_for(cfo, t)
        assets_acquire(store, s, t, cfo, envelope("p-acq"), "FA-3", 10000, 1000, 3)

        step("Post period 1 — accumulated 3000, book value 7000")
        expect(assets_post_period(store, s, t, cfo, envelope("p-1"), "FA-3", 1).reason).to_equal("accepted")
        expect(assets_accumulated(store, "tenant-a", "FA-3")).to_equal(3000)
        expect(assets_book_value(store, "tenant-a", "FA-3")).to_equal(7000)
        expect(assets_period_posted(store, "tenant-a", "FA-3", 1)).to_be(true)

        step("Re-posting the SAME period is rejected — no double depreciation")
        val dup = assets_post_period(store, s, t, cfo, envelope("p-1b"), "FA-3", 1)
        expect(dup.ok).to_be(false)
        expect(dup.reason).to_equal("invalid-record")
        expect(assets_accumulated(store, "tenant-a", "FA-3")).to_equal(3000)

        step("A period outside 1..life is rejected on both ends")
        expect(assets_post_period(store, s, t, cfo, envelope("p-0"), "FA-3", 0).reason).to_equal("invalid-record")
        expect(assets_post_period(store, s, t, cfo, envelope("p-4"), "FA-3", 4).reason).to_equal("invalid-record")

        step("Post periods 2 and 3 — book value lands EXACTLY on the salvage value")
        expect(assets_post_period(store, s, t, cfo, envelope("p-2"), "FA-3", 2).reason).to_equal("accepted")
        expect(assets_post_period(store, s, t, cfo, envelope("p-3"), "FA-3", 3).reason).to_equal("accepted")
        expect(assets_accumulated(store, "tenant-a", "FA-3")).to_equal(9000)
        expect(assets_book_value(store, "tenant-a", "FA-3")).to_equal(1000)

        step("The session-gated Money view reports the same book value")
        expect(assets_book_value_money(store, s, t, cfo, "FA-3", "USD").amount_cents).to_equal(1000)
        expect(assets_book_value_money(store, s, t, cfo, "FA-3", "USD").currency).to_equal("USD")
        expect(audit_verify_chain(store, "tenant-a")).to_be(true)
        store_close(store)

describe "assets vertical — disposal realises a gain or a loss":
    it "selling a 1000-book-value asset for 1500 is a +500 gain, for 400 a -600 loss":
        val store = fresh_store("disposal")
        val t = tenant_a()
        val cfo = cfo_a()
        val s = session_for(cfo, t)

        step("Fully depreciate FA-G down to its 1000 salvage book value")
        assets_acquire(store, s, t, cfo, envelope("d-acq"), "FA-G", 10000, 1000, 3)
        assets_post_period(store, s, t, cfo, envelope("d-p1"), "FA-G", 1)
        assets_post_period(store, s, t, cfo, envelope("d-p2"), "FA-G", 2)
        assets_post_period(store, s, t, cfo, envelope("d-p3"), "FA-G", 3)
        expect(assets_book_value(store, "tenant-a", "FA-G")).to_equal(1000)

        step("Proceeds 1500 against a 1000 book value is a +500 GAIN")
        expect(assets_gain_loss(store, "tenant-a", "FA-G", 1500)).to_equal(500)
        val sold = assets_dispose(store, s, t, cfo, envelope("d-1"), "FA-G", 1500)
        expect(sold.reason).to_equal("accepted")
        expect(assets_disposed(store, "tenant-a", "FA-G")).to_be(true)

        step("A second asset sold BELOW book value realises a loss")
        assets_acquire(store, s, t, cfo, envelope("d-acq2"), "FA-L", 10000, 1000, 3)
        assets_post_period(store, s, t, cfo, envelope("d-l1"), "FA-L", 1)
        assets_post_period(store, s, t, cfo, envelope("d-l2"), "FA-L", 2)
        assets_post_period(store, s, t, cfo, envelope("d-l3"), "FA-L", 3)
        # proceeds 400 against a 1000 book value -> -600
        expect(assets_gain_loss(store, "tenant-a", "FA-L", 400)).to_equal(-600)
        expect(assets_dispose(store, s, t, cfo, envelope("d-2"), "FA-L", 400).reason).to_equal("accepted")

        step("Break-even: proceeds equal to book value is a zero gain/loss")
        assets_acquire(store, s, t, cfo, envelope("d-acq3"), "FA-E", 5000, 0, 1)
        expect(assets_gain_loss(store, "tenant-a", "FA-E", 5000)).to_equal(0)
        expect(audit_verify_chain(store, "tenant-a")).to_be(true)
        store_close(store)

describe "assets vertical — a disposed asset is retired for good":
    it "reproduce: a SECOND dispose of the same asset is rejected (invalid-record)":
        val store = fresh_store("double-dispose")
        val t = tenant_a()
        val cfo = cfo_a()
        val s = session_for(cfo, t)
        assets_acquire(store, s, t, cfo, envelope("dd-acq"), "FA-D", 8000, 0, 2)

        step("First disposal is accepted")
        expect(assets_dispose(store, s, t, cfo, envelope("dd-1"), "FA-D", 9000).reason).to_equal("accepted")
        val outbox_after_first = outbox_pending(store, "tenant-a").len()

        step("Second disposal with a FRESH key is rejected — not an idempotency artifact")
        val second = assets_dispose(store, s, t, cfo, envelope("dd-2"), "FA-D", 500)
        expect(second.ok).to_be(false)
        expect(second.reason).to_equal("invalid-record")
        expect(reason_allowed(second.reason)).to_be(true)

        step("No second effect reached the outbox")
        expect(outbox_pending(store, "tenant-a").len()).to_equal(outbox_after_first)

        step("A disposed asset can no longer be capitalized or depreciated")
        expect(assets_capitalize(store, s, t, cfo, envelope("dd-3"), "FA-D", 100).reason).to_equal("invalid-record")
        expect(assets_post_period(store, s, t, cfo, envelope("dd-4"), "FA-D", 1).reason).to_equal("invalid-record")
        store_close(store)

describe "assets vertical — invalid acquisitions are rejected":
    it "reproduce: a NEGATIVE (or zero) life is rejected, as are bad cost/salvage and duplicates":
        val store = fresh_store("invalid")
        val t = tenant_a()
        val cfo = cfo_a()
        val s = session_for(cfo, t)

        step("A negative life cannot produce a schedule — rejected at validation")
        val neg = assets_acquire(store, s, t, cfo, envelope("i-1"), "FA-N", 10000, 0, -3)
        expect(neg.ok).to_be(false)
        expect(neg.reason).to_equal("invalid-record")
        expect(reason_allowed(neg.reason)).to_be(true)
        expect(assets_find(store, "tenant-a", "FA-N").found).to_be(false)

        step("A zero life is rejected on the same rung")
        expect(assets_acquire(store, s, t, cfo, envelope("i-2"), "FA-Z", 10000, 0, 0).reason).to_equal("invalid-record")

        step("Non-positive cost, salvage above cost, and an empty id are rejected")
        expect(assets_acquire(store, s, t, cfo, envelope("i-3"), "FA-C", 0, 0, 3).reason).to_equal("invalid-record")
        expect(assets_acquire(store, s, t, cfo, envelope("i-4"), "FA-S", 1000, 2000, 3).reason).to_equal("invalid-record")
        expect(assets_acquire(store, s, t, cfo, envelope("i-5"), "", 1000, 0, 3).reason).to_equal("invalid-record")

        step("A duplicate asset id is rejected — the register never gets two rows")
        assets_acquire(store, s, t, cfo, envelope("i-6"), "FA-U", 1000, 0, 2)
        expect(assets_acquire(store, s, t, cfo, envelope("i-7"), "FA-U", 5000, 0, 5).reason).to_equal("invalid-record")
        expect(assets_find(store, "tenant-a", "FA-U").cost_cents).to_equal(1000)
        store_close(store)

describe "assets vertical — rbac denies an unauthorized actor":
    it "reproduce: a sales actor cannot acquire, post or dispose (forbidden)":
        val store = fresh_store("rbac")
        val t = tenant_a()
        val clerk = clerk_a()
        val cfo = cfo_a()
        val cs = session_for(clerk, t)

        step("Acquire as a sales role is forbidden and registers nothing")
        val r = assets_acquire(store, cs, t, clerk, envelope("rb-1"), "FA-R", 10000, 0, 3)
        expect(r.ok).to_be(false)
        expect(r.reason).to_equal("forbidden")
        expect(reason_allowed(r.reason)).to_be(true)
        expect(assets_find(store, "tenant-a", "FA-R").found).to_be(false)

        step("With a finance-acquired asset, sales still cannot post or dispose it")
        assets_acquire(store, session_for(cfo, t), t, cfo, envelope("rb-2"), "FA-R2", 10000, 0, 3)
        expect(assets_post_period(store, cs, t, clerk, envelope("rb-3"), "FA-R2", 1).reason).to_equal("forbidden")
        expect(assets_dispose(store, cs, t, clerk, envelope("rb-4"), "FA-R2", 100).reason).to_equal("forbidden")
        expect(assets_accumulated(store, "tenant-a", "FA-R2")).to_equal(0)
        expect(assets_disposed(store, "tenant-a", "FA-R2")).to_be(false)
        store_close(store)

describe "assets vertical — idempotent replay produces exactly one effect":
    it "replaying assets_acquire returns duplicate-key and posts no second row":
        val store = fresh_store("replay")
        val t = tenant_a()
        val cfo = cfo_a()
        val s = session_for(cfo, t)

        step("Acquire FA-I under key same-key")
        expect(assets_acquire(store, s, t, cfo, envelope("same-key"), "FA-I", 10000, 1000, 3).reason).to_equal("accepted")
        val outbox_after_first = outbox_pending(store, "tenant-a").len()

        step("Replay the SAME key for a DIFFERENT asset — must not take effect")
        val replay = assets_acquire(store, s, t, cfo, envelope("same-key"), "FA-I2", 99999, 0, 9)
        expect(replay.ok).to_be(true)
        expect(replay.reason).to_equal("duplicate-key")
        expect(reason_allowed(replay.reason)).to_be(true)

        step("No second effect — FA-I2 was never registered, outbox unchanged")
        expect(assets_find(store, "tenant-a", "FA-I2").found).to_be(false)
        expect(outbox_pending(store, "tenant-a").len()).to_equal(outbox_after_first)
        store_close(store)

describe "assets vertical — tenant isolation":
    it "tenant B's folds never see tenant A's asset of the same id":
        val store = fresh_store("isolation")
        val ta = tenant_a()
        val cfo_a_actor = cfo_a()
        val sa = session_for(cfo_a_actor, ta)
        val tb = tenant_b()
        val cfo_b = ActorContext(actor_id: "cfo-b", role: "finance")
        val sb = session_for(cfo_b, tb)

        step("Both tenants register an asset under the SAME id with different costs")
        assets_acquire(store, sa, ta, cfo_a_actor, envelope("ti-a"), "FA-X", 10000, 1000, 3)
        assets_acquire(store, sb, tb, cfo_b, envelope("ti-b"), "FA-X", 60000, 0, 2)

        step("Each tenant folds only its own row")
        expect(assets_find(store, "tenant-a", "FA-X").cost_cents).to_equal(10000)
        expect(assets_find(store, "tenant-b", "FA-X").cost_cents).to_equal(60000)
        expect(assets_cost_basis(store, "tenant-a", "FA-X")).to_equal(10000)
        expect(assets_cost_basis(store, "tenant-b", "FA-X")).to_equal(60000)

        step("Tenant A posts a period; tenant B's accumulated depreciation is untouched")
        assets_post_period(store, sa, ta, cfo_a_actor, envelope("ti-p"), "FA-X", 1)
        expect(assets_accumulated(store, "tenant-a", "FA-X")).to_equal(3000)
        expect(assets_accumulated(store, "tenant-b", "FA-X")).to_equal(0)
        expect(assets_book_value(store, "tenant-b", "FA-X")).to_equal(60000)

        step("Tenant A disposes; tenant B's asset is still live")
        assets_dispose(store, sa, ta, cfo_a_actor, envelope("ti-d"), "FA-X", 5000)
        expect(assets_disposed(store, "tenant-a", "FA-X")).to_be(true)
        expect(assets_disposed(store, "tenant-b", "FA-X")).to_be(false)
        store_close(store)
