# Focused canonical Viz typed-surface composition coverage.

use std.spipe.*
use std.skia.entity.geometry.{SkRect}
use std.skia.entity.color.{SkColor4f}
use std.viz.entity.surface_id.{SurfaceId, FrameSinkId, LocalSurfaceId}
use std.viz.entity.draw_quad.{DrawQuadKind}
use std.viz.entity.compositor_frame.{CompositorFrame, FrameMetadata}
use std.viz.entity.render_pass.{RenderPass}
use std.viz.entity.draw_quad.{DrawQuad}
use std.viz.feature.frame_builder.{frame_builder_new}
use std.viz.feature.aggregator.{Aggregator}
use std.viz.entity.aggregator_entry.{AggregatorEntry}

fn _rect() -> SkRect:
    SkRect(left: 0.0, top: 0.0, right: 64.0, bottom: 32.0)

fn _surface(client: i32, sink: i32, parent: i32, child: i32) -> SurfaceId:
    SurfaceId(
        frame_sink_id: FrameSinkId(client_id: client, sink_id: sink),
        local_surface_id: LocalSurfaceId(
            parent_sequence_number: parent,
            child_sequence_number: child
        )
    )

fn _solid_frame(color: SkColor4f):
    var builder = frame_builder_new()
    builder.begin_render_pass(_rect())
    expect(builder.add_solid_color_quad(_rect(), color)).to_equal(true)
    expect(builder.end_render_pass()).to_equal(true)
    builder.build().unwrap()

fn _root_frame(child: SurfaceId):
    var builder = frame_builder_new()
    builder.begin_render_pass(_rect())
    expect(builder.add_surface_quad(_rect(), child, 1.0)).to_equal(true)
    expect(builder.end_render_pass()).to_equal(true)
    builder.build().unwrap()

describe "canonical typed surface composition":
    it "frame builder preserves a typed SurfaceId on its surface quad and frame reference":
        val child = _surface(41, 7, 12, 99)
        val frame = _root_frame(child)
        val quad = frame.render_pass_list[0].quads[0]

        expect(frame.referenced_surfaces.len()).to_equal(1)
        expect(frame.referenced_surfaces[0].equals(child)).to_equal(true)
        expect(quad.surface_id.equals(child)).to_equal(true)

    it "aggregator composes a root surface quad with its typed child frame":
        val root = _surface(1, 1, 1, 1)
        val child = _surface(41, 7, 12, 99)
        val child_frame = _solid_frame(SkColor4f(r: 1.0, g: 0.0, b: 0.0, a: 1.0))
        var aggregator = Aggregator.new()
        aggregator.register_frame(AggregatorEntry(surface_id: root, frame: _root_frame(child)))
        aggregator.register_frame(AggregatorEntry(surface_id: child, frame: child_frame))

        val composed = aggregator.aggregate(root)
        expect(composed.render_pass_list.len()).to_equal(2)
        expect(composed.total_quad_count()).to_equal(2)
        expect(composed.render_pass_list[0].quads[0].solid_color.r).to_equal(1.0)
        expect(composed.render_pass_list[1].quads[0].kind).to_equal(DrawQuadKind.RenderPass)
        expect(composed.render_pass_list[1].quads[0].render_pass_id).to_equal(composed.render_pass_list[0].id)
        expect(composed.referenced_surfaces.len()).to_equal(0)

    it "aggregator drops a typed surface quad when its child is missing":
        val root = _surface(2, 1, 1, 1)
        val missing_child = _surface(42, 8, 13, 100)
        var aggregator = Aggregator.new()
        aggregator.register_frame(AggregatorEntry(surface_id: root, frame: _root_frame(missing_child)))

        val composed = aggregator.aggregate(root)
        expect(composed.total_quad_count()).to_equal(0)

    it "rejects a cyclic typed surface graph instead of emitting a partial frame":
        val first = _surface(9, 1, 1, 1)
        val second = _surface(9, 2, 1, 2)
        var aggregator = Aggregator.new()
        aggregator.register_frame(AggregatorEntry(surface_id: first, frame: _root_frame(second)))
        aggregator.register_frame(AggregatorEntry(surface_id: second, frame: _root_frame(first)))

        val composed = aggregator.aggregate(first)
        expect(composed.render_pass_list.len()).to_equal(0)

    it "rejects a direct frame whose declared surface reference has no matching surface quad":
        val root = _surface(10, 1, 1, 1)
        val child = _surface(10, 2, 1, 2)
        var malformed = _root_frame(child)
        malformed.referenced_surfaces = []
        var aggregator = Aggregator.new()
        aggregator.register_frame(AggregatorEntry(surface_id: root, frame: malformed))
        aggregator.register_frame(AggregatorEntry(surface_id: child, frame: _solid_frame(SkColor4f(r: 1.0, g: 0.0, b: 0.0, a: 1.0))))

        expect(aggregator.aggregate(root).render_pass_list.len()).to_equal(0)

    it "rejects duplicate local render-pass identifiers before rebasing":
        val root = _surface(11, 1, 1, 1)
        var malformed = _solid_frame(SkColor4f(r: 0.0, g: 1.0, b: 0.0, a: 1.0))
        malformed.render_pass_list.push(malformed.render_pass_list[0])
        var aggregator = Aggregator.new()
        aggregator.register_frame(AggregatorEntry(surface_id: root, frame: malformed))

        expect(aggregator.aggregate(root).render_pass_list.len()).to_equal(0)

    it "rejects a forward local render-pass dependency":
        val root = _surface(12, 1, 1, 1)
        var first = RenderPass.new(1, _rect())
        first.add_quad(DrawQuad.render_pass(0, _rect(), 2))
        val second = RenderPass.new(2, _rect())
        val malformed = CompositorFrame(
            metadata: FrameMetadata(
                device_scale_factor: 1.0, root_scroll_offset_x: 0.0,
                root_scroll_offset_y: 0.0, frame_token: 1
            ),
            render_pass_list: [first, second], referenced_surfaces: [],
            device_viewport_rect: _rect()
        )
        var aggregator = Aggregator.new()
        aggregator.register_frame(AggregatorEntry(surface_id: root, frame: malformed))

        expect(aggregator.aggregate(root).render_pass_list.len()).to_equal(0)

    it "rejects direct frames with invalid shared-quad-state indices":
        val root = _surface(13, 1, 1, 1)
        var negative = _solid_frame(SkColor4f(r: 1.0, g: 0.0, b: 0.0, a: 1.0))
        negative.render_pass_list[0].quads[0].shared_quad_state_index = -1
        var aggregator = Aggregator.new()
        aggregator.register_frame(AggregatorEntry(surface_id: root, frame: negative))
        expect(aggregator.known_frames.len()).to_equal(0)
        expect(aggregator.aggregate(root).render_pass_list.len()).to_equal(0)

        var equal_to_len = _solid_frame(SkColor4f(r: 0.0, g: 1.0, b: 0.0, a: 1.0))
        equal_to_len.render_pass_list[0].quads[0].shared_quad_state_index =
            equal_to_len.render_pass_list[0].shared_quad_states.len().to_i32()
        aggregator.register_frame(AggregatorEntry(surface_id: root, frame: equal_to_len))
        expect(aggregator.aggregate(root).render_pass_list.len()).to_equal(0)

    it "keeps a healthy stored frame when a malformed direct replacement is rejected":
        val root = _surface(13, 2, 1, 1)
        val healthy = _solid_frame(SkColor4f(r: 0.0, g: 1.0, b: 0.0, a: 1.0))
        var malformed = _solid_frame(SkColor4f(r: 1.0, g: 0.0, b: 0.0, a: 1.0))
        malformed.render_pass_list[0].quads[0].shared_quad_state_index = -1
        var aggregator = Aggregator.new()
        aggregator.register_frame(AggregatorEntry(surface_id: root, frame: healthy))
        aggregator.register_frame(AggregatorEntry(surface_id: root, frame: malformed))
        expect(aggregator.known_frames.len()).to_equal(1)
        val drawn = aggregator.aggregate(root)
        expect(drawn.render_pass_list.len()).to_equal(1)
        expect(drawn.render_pass_list[0].quads[0].solid_color.g).to_equal(1.0)

    it "rejects non-finite or out-of-range direct numeric render state":
        val root = _surface(14, 1, 1, 1)
        var nan_quad = _solid_frame(SkColor4f(r: 1.0, g: 0.0, b: 0.0, a: 1.0))
        nan_quad.render_pass_list[0].quads[0].rect.right = 0.0 / 0.0
        var aggregator = Aggregator.new()
        aggregator.register_frame(AggregatorEntry(surface_id: root, frame: nan_quad))
        expect(aggregator.aggregate(root).render_pass_list.len()).to_equal(0)

        var invalid_opacity = _solid_frame(SkColor4f(r: 0.0, g: 1.0, b: 0.0, a: 1.0))
        invalid_opacity.render_pass_list[0].shared_quad_states[0].opacity = 1.5
        aggregator.register_frame(AggregatorEntry(surface_id: root, frame: invalid_opacity))
        expect(aggregator.aggregate(root).render_pass_list.len()).to_equal(0)

        var empty_rect = _solid_frame(SkColor4f(r: 0.0, g: 0.0, b: 1.0, a: 1.0))
        empty_rect.render_pass_list[0].quads[0].rect.right = 0.0
        aggregator.register_frame(AggregatorEntry(surface_id: root, frame: empty_rect))
        expect(aggregator.aggregate(root).render_pass_list.len()).to_equal(0)

    it "aggregator composes the replacement registered for a typed child SurfaceId":
        val root = _surface(3, 1, 1, 1)
        val child = _surface(43, 9, 14, 101)
        val first = _solid_frame(SkColor4f(r: 1.0, g: 0.0, b: 0.0, a: 1.0))
        val replacement = _solid_frame(SkColor4f(r: 0.0, g: 0.0, b: 1.0, a: 1.0))
        var aggregator = Aggregator.new()
        aggregator.register_frame(AggregatorEntry(surface_id: root, frame: _root_frame(child)))
        aggregator.register_frame(AggregatorEntry(surface_id: child, frame: first))
        aggregator.register_frame(AggregatorEntry(surface_id: child, frame: replacement))

        val composed = aggregator.aggregate(root)
        expect(composed.render_pass_list.len()).to_equal(2)
        expect(composed.total_quad_count()).to_equal(2)
        expect(composed.render_pass_list[0].quads[0].solid_color.b).to_equal(1.0)
        expect(composed.render_pass_list[1].quads[0].kind).to_equal(DrawQuadKind.RenderPass)

    it "memoizes a shared typed child instead of importing its pass DAG twice":
        val root = _surface(50, 1, 1, 1)
        val child = _surface(50, 2, 1, 2)
        var builder = frame_builder_new()
        builder.begin_render_pass(_rect())
        expect(builder.add_surface_quad(_rect(), child, 1.0)).to_equal(true)
        expect(builder.add_surface_quad(_rect(), child, 1.0)).to_equal(true)
        expect(builder.end_render_pass()).to_equal(true)
        var aggregator = Aggregator.new()
        aggregator.register_frame(AggregatorEntry(surface_id: root, frame: builder.build().unwrap()))
        aggregator.register_frame(AggregatorEntry(surface_id: child, frame: _solid_frame(SkColor4f(r: 0.0, g: 1.0, b: 0.0, a: 1.0))))

        val composed = aggregator.aggregate(root)
        expect(composed.render_pass_list.len()).to_equal(2)
        expect(composed.render_pass_list[1].quads.len()).to_equal(2)
        expect(composed.render_pass_list[1].quads[0].render_pass_id).to_equal(composed.render_pass_list[1].quads[1].render_pass_id)

    it "rejects an acyclic surface chain beyond the aggregate depth budget":
        var surfaces: [SurfaceId] = []
        var i = 0
        while i < 33:
            surfaces.push(_surface(60, i + 1, 1, i + 1))
            i = i + 1
        var aggregator = Aggregator.new()
        i = 32
        while i >= 0:
            var frame = _solid_frame(SkColor4f(r: 1.0, g: 1.0, b: 1.0, a: 1.0))
            if i != 32:
                frame = _root_frame(surfaces[(i + 1).to_i64()])
            aggregator.register_frame(AggregatorEntry(surface_id: surfaces[i.to_i64()], frame: frame))
            i = i - 1

        expect(aggregator.aggregate(surfaces[0]).render_pass_list.len()).to_equal(0)
