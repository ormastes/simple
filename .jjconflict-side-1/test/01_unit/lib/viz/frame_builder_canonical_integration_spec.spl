use std.test.*
use std.skia.entity.geometry.{SkRect}
use std.skia.entity.color.{SkColor4f}
use std.viz.entity.surface_id.{SurfaceId, FrameSinkId, LocalSurfaceId}
use std.viz.entity.shared_image.{SharedImageMailbox}
use std.viz.entity.draw_quad.{DrawQuadKind}
use std.viz.entity.compositor_frame.{CompositorFrame, FrameMetadata}
use std.viz.feature.frame_builder.{frame_builder_new}
use std.viz.entity.aggregator_entry.{AggregatorEntry}
use std.viz.feature.display_compositor.{DisplayCompositor}
use std.viz.feature.aggregator.{Aggregator}

fn _rect() -> SkRect:
    SkRect(left: 0.0, top: 0.0, right: 64.0, bottom: 32.0)

fn _surface() -> SurfaceId:
    SurfaceId(
        frame_sink_id: FrameSinkId(client_id: 7, sink_id: 3),
        local_surface_id: LocalSurfaceId(parent_sequence_number: 1, child_sequence_number: 1)
    )

describe "canonical Viz frame builder integration":
    it "builds canonical frame entities accepted by DisplayCompositor":
        var builder = frame_builder_new()
        val pass_id = builder.begin_render_pass(_rect())
        expect(builder.add_solid_color_quad(_rect(), SkColor4f(r: 1.0, g: 0.0, b: 0.0, a: 1.0))).to_equal(true)
        expect(builder.end_render_pass()).to_equal(true)
        val frame = builder.build().unwrap()
        val surface = _surface()
        var display = DisplayCompositor.new(_rect())
        display.submit_frame(AggregatorEntry(surface_id: surface, frame: frame))
        val drawn = display.draw_frame(surface)

        expect(drawn.root_render_pass_id()).to_equal(pass_id)
        expect(drawn.render_pass_list.len()).to_equal(1)
        expect(drawn.render_pass_list[0].shared_quad_states.len()).to_equal(1)
        expect(drawn.render_pass_list[0].quads[0].shared_quad_state_index).to_equal(0)
        match drawn.render_pass_list[0].quads[0].kind:
            DrawQuadKind.SolidColor: expect(true).to_equal(true)
            _: expect(false).to_equal(true)

    it "rejects nested/open passes and malformed texture input":
        var builder = frame_builder_new()
        builder.begin_render_pass(_rect())
        expect(builder.begin_render_pass(_rect())).to_equal(-1)
        expect(builder.add_texture_quad(_rect(), SharedImageMailbox(bytes: []), 1.0)).to_equal(false)
        expect(builder.add_solid_color_quad(_rect(), SkColor4f(r: 0.0, g: 0.0, b: 0.0, a: 1.0))).to_equal(true)
        builder.build().to_be_nil()

    it "rejects colors outside the canonical normalized RGBA domain":
        var builder = frame_builder_new()
        builder.begin_render_pass(_rect())
        expect(builder.add_solid_color_quad(_rect(), SkColor4f(r: 1.1, g: 0.0, b: 0.0, a: 1.0))).to_equal(false)
        expect(builder.add_debug_border(_rect(), SkColor4f(r: 0.0, g: 0.0, b: 0.0, a: -0.1))).to_equal(false)
        expect(builder.add_solid_color_quad(_rect(), SkColor4f(r: 0.0, g: 0.0, b: 0.0, a: 1.0))).to_equal(true)

    it "accepts only completed render-pass references and typed surface identity":
        var builder = frame_builder_new()
        val first = builder.begin_render_pass(_rect())
        expect(builder.add_render_pass_quad(_rect(), first, 1.0)).to_equal(false)
        expect(builder.end_render_pass()).to_equal(true)
        val second = builder.begin_render_pass(_rect())
        expect(builder.add_render_pass_quad(_rect(), first, 0.5)).to_equal(true)
        expect(builder.add_surface_quad(_rect(), _surface(), 1.0)).to_equal(true)
        expect(builder.end_render_pass()).to_equal(true)
        val frame = builder.build().unwrap()
        expect(frame.root_render_pass_id()).to_equal(second)
        expect(frame.referenced_surfaces.len()).to_equal(1)
        expect(frame.render_pass_list[1].quads[1].kind).to_equal(DrawQuadKind.Surface)
        expect(frame.render_pass_list[1].quads[1].surface_id.equals(_surface())).to_equal(true)
        expect(frame.referenced_surfaces[0].equals(_surface())).to_equal(true)

    it "rejects a pass beyond the bounded retained-frame budget":
        var builder = frame_builder_new()
        var count = 0
        while count < 256:
            expect(builder.begin_render_pass(_rect()) > 0).to_equal(true)
            expect(builder.end_render_pass()).to_equal(true)
            count = count + 1
        expect(builder.begin_render_pass(_rect())).to_equal(-1)

    it "does not retain a registry entry beyond the bounded surface budget":
        var builder = frame_builder_new()
        builder.begin_render_pass(_rect())
        expect(builder.add_solid_color_quad(_rect(), SkColor4f(r: 0.0, g: 1.0, b: 0.0, a: 1.0))).to_equal(true)
        expect(builder.end_render_pass()).to_equal(true)
        val frame = builder.build().unwrap()
        var aggregator = Aggregator.new()
        var count = 0
        while count < 129:
            val surface = SurfaceId(
                frame_sink_id: FrameSinkId(client_id: count + 1, sink_id: 1),
                local_surface_id: LocalSurfaceId(parent_sequence_number: 1, child_sequence_number: 1)
            )
            aggregator.register_frame(AggregatorEntry(surface_id: surface, frame: frame))
            count = count + 1
        val first = SurfaceId(
            frame_sink_id: FrameSinkId(client_id: 1, sink_id: 1),
            local_surface_id: LocalSurfaceId(parent_sequence_number: 1, child_sequence_number: 1)
        )
        val rejected = SurfaceId(
            frame_sink_id: FrameSinkId(client_id: 129, sink_id: 1),
            local_surface_id: LocalSurfaceId(parent_sequence_number: 1, child_sequence_number: 1)
        )
        expect(aggregator.aggregate(first).render_pass_list.len()).to_equal(1)
        expect(aggregator.aggregate(rejected).render_pass_list.len()).to_equal(0)

    it "rejects direct frames with unbounded referenced-surface retention":
        var references: [SurfaceId] = []
        var count = 0
        while count < 4097:
            references.push(SurfaceId(
                frame_sink_id: FrameSinkId(client_id: count + 1, sink_id: 1),
                local_surface_id: LocalSurfaceId(parent_sequence_number: 1, child_sequence_number: 1)
            ))
            count = count + 1
        val direct = CompositorFrame(
            metadata: FrameMetadata(
                device_scale_factor: 1.0,
                root_scroll_offset_x: 0.0,
                root_scroll_offset_y: 0.0,
                frame_token: 1
            ),
            render_pass_list: [],
            referenced_surfaces: references,
            device_viewport_rect: _rect()
        )
        var aggregator = Aggregator.new()
        aggregator.register_frame(AggregatorEntry(surface_id: _surface(), frame: direct))
        expect(aggregator.known_frames.len()).to_equal(0)
