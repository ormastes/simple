use std.spec
use std.common.rt_hal.model.{RtHalOperationKind}
use std.nogc_sync_mut.rt_hal.exact_boundary.{RtHalDigest256, RtHalExactRequest}
use test.fixtures.rt_hal_external.fixture_plan.{rt_hal_external_expected_receipt}

fn digest(base: i64) -> RtHalDigest256:
    RtHalDigest256(word0: base, word1: base + 1, word2: base + 2, word3: base + 3)

describe "independent RT/HAL external comparator reference":
    it "matches the fixed query transform vector":
        val request = RtHalExactRequest(
            case_id: 101, operation: RtHalOperationKind.Query,
            operation_digest: digest(10), input_digest: digest(20))
        val receipt = rt_hal_external_expected_receipt(request, digest(0))
        expect(receipt.outcome_digest.word0).to_equal(5741074157106036119)
        expect(receipt.outcome_digest.word1).to_equal(-1247515204484583637)
        expect(receipt.outcome_digest.word2).to_equal(-4245952303110056483)
        expect(receipt.outcome_digest.word3).to_equal(-4558578986247194669)
        expect(receipt.trace_digest.word0).to_equal(7723690326184253018)
        expect(receipt.trace_digest.word1).to_equal(-632598729158632692)
        expect(receipt.trace_digest.word2).to_equal(-2173326836441120125)
        expect(receipt.trace_digest.word3).to_equal(8061763975075729028)
        expect(receipt.error_digest.word0).to_equal(0)
        expect(receipt.error_digest.word3).to_equal(0)

    it "incorporates but does not repeat the Pure effect trace":
        val request = RtHalExactRequest(
            case_id: 102, operation: RtHalOperationKind.Effectful,
            operation_digest: digest(30), input_digest: digest(40))
        val receipt = rt_hal_external_expected_receipt(request, digest(100))
        expect(receipt.outcome_digest.word0).to_equal(314625549859528360)
        expect(receipt.outcome_digest.word1).to_equal(3839477438135725125)
        expect(receipt.outcome_digest.word2).to_equal(7085691677194275070)
        expect(receipt.outcome_digest.word3).to_equal(-3964041498567233715)
        expect(receipt.trace_digest.word0).to_equal(100)
        expect(receipt.trace_digest.word1).to_equal(101)
        expect(receipt.trace_digest.word2).to_equal(102)
        expect(receipt.trace_digest.word3).to_equal(103)
        expect(receipt.error_digest.word0).to_equal(0)
        expect(receipt.error_digest.word3).to_equal(0)
