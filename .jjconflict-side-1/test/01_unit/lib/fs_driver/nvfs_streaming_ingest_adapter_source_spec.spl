use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text

describe "NVFS streaming ingest adapter source contract":
    it "is one bounded DBFS delegation seam without whole-file assembly":
        val source = rt_file_read_text(
            "src/lib/nogc_sync_mut/fs_driver/nvfs_driver.spl") ?? ""
        expect(source.contains("NVFS_STREAM_INGEST_PROVIDER_V1: text = \"nvfs-dbfs-backed-v1\"")).to_equal(true)
        expect(source.contains("NVFS_STREAM_INGEST_CAPACITY: i32 = DBFS_STREAM_INGEST_CAPACITY")).to_equal(true)
        expect(source.contains("NVFS_STREAM_INGEST_MAX_CHUNK_BYTES: i64 = DBFS_STREAM_INGEST_MAX_CHUNK_BYTES")).to_equal(true)
        expect(source.contains("_dbfs_lease: DbfsStreamIngestLease")).to_equal(true)
        expect(source.contains("self.inner.stream_ingest_begin(")).to_equal(true)
        expect(source.contains("self.inner.stream_ingest_append(")).to_equal(true)
        expect(source.contains("self.inner.stream_ingest_finish(")).to_equal(true)
        expect(source.contains("self.inner.stream_ingest_abort(")).to_equal(true)
        expect(source.contains("val bytes = self.inner.read_handle(")).to_equal(false)
        expect(source.contains("match self.name")).to_equal(false)
        expect(source.contains("match self.stream_ingest_provider_v1()")).to_equal(false)
