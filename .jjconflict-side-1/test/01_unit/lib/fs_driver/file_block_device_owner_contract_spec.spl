use std.io_runtime.{read_file_text}
use std.spec

describe "FileBlockDevice owner authority contract":
    it "keeps registration authority and geometry table-private":
        val source = read_file_text(
            "src/lib/nogc_sync_mut/fs_driver/file_block_device.spl")
        expect(source).to_contain("class FileBlockDeviceAuthority:")
        expect(source).to_contain("_authority: FileBlockDeviceAuthority")
        expect(source).to_contain("_file_bd_generations[slot] != generation")
        expect(source).to_contain("_file_bd_tokens[slot] != token")
        expect(source).to_contain("_file_bd_generations[i] != 0xffffffffffffffffu64")
        expect(source.contains("sector_size_bytes: u32")).to_equal(false)
        expect(source.contains("sector_count_value: u64")).to_equal(false)

    it "does not expose the rejected pathname create-exclusive sequence":
        val source = read_file_text(
            "src/lib/nogc_sync_mut/fs_driver/file_block_device.spl")
        expect(source.contains("create_exclusive")).to_equal(false)
        expect(source).to_contain("Never close and reopen `path`")
        expect(source).to_contain("FileHandle.create_read_write_no_follow(path)")
        expect(source).to_contain("Rust/interpreter")

    it "has native-C parity for every FileBlockDevice FileHandle operation":
        val runtime = read_file_text("src/runtime/runtime_native.c")
        expect(runtime).to_contain("int64_t rt_io_file_open(")
        expect(runtime).to_contain("int64_t rt_io_file_read(")
        expect(runtime).to_contain("int rt_io_file_write_all(")
        expect(runtime).to_contain("int64_t rt_io_file_seek(")
        expect(runtime).to_contain("int rt_io_file_flush(")
        expect(runtime).to_contain("int rt_io_file_close(")
        expect(runtime).to_contain("int64_t rt_io_file_meta_size(")
        expect(runtime).to_contain("mode == 4 ? O_RDWR | O_CREAT | O_TRUNC")
