use std.spec
use std.io_runtime.{file_read}

describe "WM retained old/new damage contract":
    it "retains old window extents and admits changed scene revisions":
        val source = file_read("src/os/compositor/engine2d_wm_frame_executor.spl")
        expect(source).to_contain("last_successful_window_rects: [i64]")
        expect(source).to_contain("if scene_revision != self.last_successful_scene_revision:")
        expect(source).to_contain("self.last_successful_window_rects[old + 4] != 0")
        expect(source).to_contain("self.last_successful_scene_revision > 0")
        expect(source.contains("self.last_successful_scene_revision == scene_revision")).to_equal(false)

    it "marks both retained and current extents and guards background identity":
        val source = file_read("src/os/compositor/engine2d_wm_frame_executor.spl")
        expect(source).to_contain("last_successful_background_key: text")
        expect(source).to_contain("if background_key != self.last_successful_background_key:")
        expect(source).to_contain("return engine2d_wm_full_damage_plan")
        expect(source).to_contain("self.damage_tiles.mark_rect(\n                        self.last_successful_window_rects[old]")
        expect(source).to_contain("current.x.to_i64(), current.y.to_i64()")
