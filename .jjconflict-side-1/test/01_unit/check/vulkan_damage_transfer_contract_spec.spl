use std.spec
use std.io_runtime.{file_read}

describe "Vulkan exact damage transfer contract":
    it "uses checked packed strided transfers instead of per-row prefix copies":
        val buffer = file_read("src/compiler_rust/runtime/src/vulkan/buffer.rs")
        val runtime = file_read("src/compiler_rust/runtime/src/vulkan_graphics_runtime_buffer.rs")
        expect(buffer).to_contain("pub fn download_range(")
        expect(buffer).to_contain("pub fn download_strided(")
        expect(buffer).to_contain("pub fn upload_strided(")
        expect(runtime).to_contain("rt_vulkan_copy_from_buffer_strided_raw")
        expect(runtime).to_contain("rt_vulkan_copy_to_buffer_strided_raw")
        expect(runtime).to_contain("row_bytes.checked_mul(row_count)")

    it "reports host-cache copies honestly and reserves device present":
        val backend = file_read("src/lib/gc_async_mut/gpu/engine2d/backend_vulkan.spl")
        expect(backend).to_contain("me present_damage_plan(plan: DamageFramePlan) -> bool")
        expect(backend).to_contain("self.present_mode = \"host_cache\"")
        expect(backend).to_contain("self.present_device_present = false")
        expect(backend).to_contain("host_cache_after_device_copy")
        expect(backend).to_contain("vulkan_sffi_read_buffer_strided_bytes(")
