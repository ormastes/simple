use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "Vulkan direct partial-present receipt":
    it "exposes the presenter's exact retained transfer receipt without a readback edge":
        val facade = file_read(
            "src/lib/nogc_sync_mut/gpu/engine2d/vulkan_presenter.spl")
        expect(facade).to_contain("struct VulkanEngine2dPresentDamageReceipt")
        expect(facade).to_contain("last_present_status: i32")
        expect(facade).to_contain("rect_count: i64")
        expect(facade).to_contain("copied_bytes: i64")
        expect(facade).to_contain("full_fallback: bool")
        expect(facade).to_contain("readback_performed: bool")
        expect(facade).to_contain("fn present_damage_with_receipt(")
        expect(facade).to_contain(
            "rt_vk_engine2d_presenter_last_damage_copy_bytes(self.handle)")
        expect(facade).to_contain(
            "rt_vk_engine2d_presenter_last_damage_rect_count(self.handle)")
        expect(facade).to_contain("readback_performed: false")

    it "publishes the receipt only after direct damage present and resets stale evidence first":
        val compositor = file_read("src/os/compositor/compositor_engine2d.spl")
        expect(compositor).to_contain("vulkan_last_present_status: i32 = -1")
        expect(compositor).to_contain("vulkan_last_present_copied_bytes: i64 = -1")
        expect(compositor).to_contain("vulkan_last_present_readback_performed: bool = false")
        expect(compositor).to_contain("val present = owner.present_damage_with_receipt(")
        expect(compositor).to_contain(
            "self.vulkan_last_present_copied_bytes = present.copied_bytes")
        expect(compositor).to_contain("vulkan_last_present_full_fallback=")
        expect(compositor).to_contain("vulkan_last_present_readback_performed=")

    it "reads retained state only and leaves the transfer algorithm unchanged":
        val runtime = file_read(
            "src/compiler_rust/runtime/src/value/gpu_vulkan/vulkan_sffi/swapchain.rs")
        expect(runtime).to_contain(
            "pub extern \"C\" fn rt_vk_engine2d_presenter_last_damage_copy_bytes(")
        expect(runtime).to_contain("presenter.retained.lock().last_copy_bytes")
        expect(runtime).to_contain("presenter.retained.lock().last_rect_count")
        expect(runtime).to_contain("presenter.retained.lock().last_full_fallback")
