use std.spec
use app.mcp.main_lazy_vcs_tools.{handle_simple_log}

extern fn rt_file_delete(path: text) -> bool
extern fn rt_file_exists(path: text) -> bool
extern fn rt_getpid() -> i64

describe "MCP argv VCS contract":
    it "does not execute a revset as a shell command":
        val marker = "/tmp/simple_mcp_argv_vcs_marker_" + str(rt_getpid())
        val _ = rt_file_delete(marker)

        handle_simple_log("argv-contract", "{\"revsets\":\"@;touch " + marker + "\"}")

        val injected = rt_file_exists(marker)
        if injected:
            val _ = rt_file_delete(marker)
        expect(injected).to_equal(false)
