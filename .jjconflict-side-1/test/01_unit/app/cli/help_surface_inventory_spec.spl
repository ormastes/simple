use std.spec
use app.cli.help_surface_inventory.{
    cli_surface_snapshot_v1,
    cli_surface_command_names_v1,
    cli_surface_table_only_v1,
    cli_surface_help_only_v1,
    cli_surface_dispatch_only_v1,
    cli_surface_exact_help_dispatch_parity_v1,
    cli_surface_generated_sources_current_v1,
    cli_surface_source_hashes_match_v1,
}

describe "CLI help surface V1 inventory":
    it "records every current surface without promoting table-only commands":
        val snapshot = cli_surface_snapshot_v1()
        expect(cli_surface_command_names_v1(snapshot, "dispatch").len()).to_equal(123)
        expect(cli_surface_command_names_v1(snapshot, "help").len()).to_equal(123)
        expect(cli_surface_command_names_v1(snapshot, "table").len()).to_equal(123)
        expect(cli_surface_command_names_v1(snapshot, "all").len()).to_equal(123)

    it "records provider on all three surfaces after root routing lands":
        val snapshot = cli_surface_snapshot_v1()
        expect(cli_surface_table_only_v1(snapshot)).to_equal([])
        expect(cli_surface_help_only_v1(snapshot)).to_equal([])
        expect(cli_surface_command_names_v1(snapshot, "dispatch").contains("provider")).to_equal(true)
        expect(cli_surface_command_names_v1(snapshot, "help").contains("provider")).to_equal(true)

    it "projects every registry command into the compatibility table":
        val snapshot = cli_surface_snapshot_v1()
        val dispatch_only = cli_surface_dispatch_only_v1(snapshot)
        expect(dispatch_only).to_equal([])

    it "exposes the root flag families for generated completion":
        val snapshot = cli_surface_snapshot_v1()
        expect(snapshot.log_flags.contains("--log-mode")).to_equal(true)
        expect(snapshot.internal_flags.contains("--run-config")).to_equal(true)
        expect(snapshot.internal_flags.contains("--backend")).to_equal(true)

    it "admits production generation only for current source hashes and exact parity":
        val snapshot = cli_surface_snapshot_v1()
        expect(cli_surface_exact_help_dispatch_parity_v1(snapshot)).to_equal(true)
        expect(cli_surface_generated_sources_current_v1()).to_equal(true)

    it "NEGATIVE control: any stale source hash blocks production generation":
        expect(cli_surface_source_hashes_match_v1(
            "stale-dispatch", "stale-help", "stale-table")).to_equal(false)
