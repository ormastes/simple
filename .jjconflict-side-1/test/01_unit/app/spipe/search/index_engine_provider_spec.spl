# GAP B: IndexEngineSearchProvider — a real `SearchProvider` backed by the P2
# `IndexEngine`, exercised end-to-end through `InProcessSearchProviderAdapter`
# (handshake -> search), proving results reflect actual indexed content
# rather than mock/empty data.

use std.spec
use app.spipe.search.adapter.{required_handshake_v1}
use app.spipe.search.in_process_adapter.{InProcessSearchProviderAdapter}
use app.spipe.search.index_engine_provider.{IndexEngineSearchProvider}
use lib.common.search.document.{ScopedSearchDocumentV1, ScopedFieldV1, ScopedFacetV1, SearchFacet}
use lib.common.search.query.{SearchQuery}

fn doc(id: text, title: text, body: text) -> ScopedSearchDocumentV1:
    ScopedSearchDocumentV1.of(
        id, "rev-1",
        [ScopedFieldV1.of("title", title), ScopedFieldV1.of("body", body)],
        [ScopedFacetV1.of("kind", "note")],
        "vis-1", "hash-" + id, "scope-1",
    )

fn corpus() -> [ScopedSearchDocumentV1]:
    [
        doc("doc-alpha", "Alpha Rocket Engines", "The rocket engine burns fuel efficiently."),
        doc("doc-beta", "Beta Gardening Guide", "Gardening tips for growing tomatoes and herbs."),
        doc("doc-gamma", "Gamma Rocket Fuel Chemistry", "Rocket fuel chemistry involves oxidizers and propellants."),
    ]

fn healthy_adapter() -> InProcessSearchProviderAdapter:
    val provider = IndexEngineSearchProvider.of_documents(corpus())
    var adapter = InProcessSearchProviderAdapter.new(provider)
    adapter.handshake(required_handshake_v1())?
    adapter

describe "GAP B — IndexEngineSearchProvider real end-to-end search":
    it "returns real hits reflecting indexed content for a matching term":
        step("Query for 'rocket' must return exactly the two rocket documents, not the gardening one")
        var adapter = healthy_adapter()
        val query = SearchQuery.of("rocket", [], 10, "", false)
        val result = adapter.search("snap-1", "sha256:" + "0".repeat(64), query)
        match result:
            Ok(page):
                expect(page.hits.len()).to_equal(2)
                var ids: [text] = []
                var i = 0
                while i < page.hits.len():
                    ids.push(page.hits[i].document_id)
                    i = i + 1
                expect(ids.contains("doc-alpha")).to_equal(true)
                expect(ids.contains("doc-gamma")).to_equal(true)
                expect(ids.contains("doc-beta")).to_equal(false)
            Err(_):
                expect(true).to_equal(false)

    it "ranks the document with denser term matches higher":
        step("'rocket fuel' should rank doc-gamma (matches both terms in title+body) above doc-alpha")
        var adapter = healthy_adapter()
        val query = SearchQuery.of("rocket fuel", [], 10, "", false)
        val result = adapter.search("snap-1", "sha256:" + "0".repeat(64), query)
        match result:
            Ok(page):
                expect(page.hits.len()).to_equal(2)
                expect(page.hits[0].document_id).to_equal("doc-gamma")
            Err(_):
                expect(true).to_equal(false)

    it "returns no hits for a term absent from the corpus":
        step("A query term that appears nowhere yields an empty page, not an error")
        var adapter = healthy_adapter()
        val query = SearchQuery.of("xylophone", [], 10, "", false)
        val result = adapter.search("snap-1", "sha256:" + "0".repeat(64), query)
        match result:
            Ok(page): expect(page.hits.len()).to_equal(0)
            Err(_): expect(true).to_equal(false)

    it "excludes documents that fail a facet filter even when the term matches":
        step("Filtering on a facet value present on no document removes all hits")
        val provider = IndexEngineSearchProvider.of_documents(corpus())
        var adapter = InProcessSearchProviderAdapter.new(provider)
        adapter.handshake(required_handshake_v1())?
        val query = SearchQuery.of("rocket", [SearchFacet.of("kind", "archived")], 10, "", false)
        val result = adapter.search("snap-1", "sha256:" + "0".repeat(64), query)
        match result:
            Ok(page): expect(page.hits.len()).to_equal(0)
            Err(_): expect(true).to_equal(false)

    it "explains a document with real term contributions":
        step("explain_document reports a contribution for the matched query term")
        val provider = IndexEngineSearchProvider.of_documents(corpus())
        val query = SearchQuery.of("rocket", [], 10, "", true)
        val explanation = provider.explain_document("snap-1", "sha256:" + "0".repeat(64), "doc-alpha", query)
        match explanation:
            Ok(exp):
                expect(exp.contributions.len() > 0).to_equal(true)
            Err(_):
                expect(true).to_equal(false)
