# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

fn collision_probability(symbol_count: f64, hash_space: f64) -> f64:
    if symbol_count <= 1.0:
        return 0.0
    (symbol_count * (symbol_count - 1.0)) / (2.0 * hash_space)

describe "Symbol Hash":
    # @manual scenario evidence
    it "computes zero collision probability for empty or single symbol sets":
        # @req REQ-SSPEC-APP
        step("computes zero collision probability for empty or single symbol sets")
        expect(collision_probability(0.0, 1024.0)).to_equal(0.0)
        expect(collision_probability(1.0, 1024.0)).to_equal(0.0)

    it "computes birthday-bound collision probability for multiple symbols":
        # @req REQ-SSPEC-APP
        step("computes birthday-bound collision probability for multiple symbols")
        val probability = collision_probability(4.0, 100.0)
        expect(probability).to_equal(0.06)
