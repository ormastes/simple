# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

use app.search.main.{parse_limit_or_default}

describe "search limit guard":
    it "guards malformed limit parsing":
        val source = rt_file_read_text("src/app/search/main.spl") ?? ""

        expect(source).to_contain("fn parse_limit_or_default(value: text) -> i64")
        expect(source).to_contain("for ch in trimmed:")
        expect(source).to_contain("if ch < \"0\" or ch > \"9\":")
        expect(source).to_contain("if parsed <= 0:")
        expect(source).to_contain("return 20")
        expect(source).to_contain("limit = parse_limit_or_default(arg[8:])")
        expect(source.contains("limit = arg[8:].to_int()")).to_equal(false)
