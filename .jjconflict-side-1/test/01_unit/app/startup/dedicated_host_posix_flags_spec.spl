# POSIX provider platform flag translation specification.

use std.spec.{describe, it, expect}
use common.platform.dedicated_host.{HOST_MAP_ANONYMOUS, HOST_MAP_PRIVATE}
use os.hosted.dedicated_host_posix.{posix_native_map_flags}

describe "dedicated host POSIX flag translation":
    it "keeps the canonical Linux bit and translates native anonymous bits":
        val flags = HOST_MAP_PRIVATE | HOST_MAP_ANONYMOUS
        expect(posix_native_map_flags(flags, "linux")).to_equal(0x22)
        expect(posix_native_map_flags(flags, "macos")).to_equal(0x1002)
        expect(posix_native_map_flags(flags, "freebsd")).to_equal(0x1002)
        expect(posix_native_map_flags(flags, "solaris")).to_equal(0x102)

    it "never changes file-backed mapping flags":
        expect(posix_native_map_flags(HOST_MAP_PRIVATE, "macos")).to_equal(HOST_MAP_PRIVATE)
