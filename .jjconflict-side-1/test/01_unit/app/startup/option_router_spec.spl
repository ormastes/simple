# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# Stage-0 option router — reproducing acceptance spec (Phase C / WP-19a-s).
# Options route to the registered handler route, including the
# `--x<ns>-<key>[=<value>]` extension split and the hard `--` boundary.

use std.spec.step

use std.spec
use std.io_runtime.{file_read}
use std.nogc_sync_mut.composition.cli_option_route.{
    CLI_VALUE_MODE_FLAG, CLI_VALUE_MODE_REQUIRED,
    CLI_ROUTE_ERR_UNKNOWN_NAMESPACE, CLI_ROUTE_ERR_BAD_NAMESPACE_SHAPE,
    CLI_ROUTE_ERR_RESERVED_SPELLING
}
use app.startup.option_router.{

    OptionRouterRouteV1, OptionRouterNamespaceV1,
    option_router_table_create_v1, option_router_register_route_v1,
    option_router_register_namespace_v1, option_router_dispatch_token_v1,
    option_router_route_argv_v1,
    app_root_option_plan_v1, app_root_startup_option_help_lines_v1,
    ROUTER_DISPATCH_EXACT, ROUTER_DISPATCH_EXTENSION,
    ROUTER_DISPATCH_POSITIONAL, ROUTER_DISPATCH_TERMINATOR,
    ROUTER_DISPATCH_PROGRAM_ARG, ROUTER_DISPATCH_ERROR
}
use app.startup.launch_metadata.{launch_metadata_default}
use app.startup.load_policy_wiring.{
    startup_load_policy_result_v1,
    startup_load_policy_for_component_input_v1
}
use app.startup.segment_load_plan.{startup_segment_load_result_v1}

fn _table():
    var t = option_router_table_create_v1()
    val (t1, d1) = option_router_register_route_v1(t, OptionRouterRouteV1(option_id: "core.verbose", spelling: "--verbose", value_mode: CLI_VALUE_MODE_FLAG, provider_id: ""))
    assert d1.ok
    val (t2, d2) = option_router_register_route_v1(t1, OptionRouterRouteV1(option_id: "core.opt_level", spelling: "--opt-level", value_mode: CLI_VALUE_MODE_REQUIRED, provider_id: ""))
    assert d2.ok
    val (t3, d3) = option_router_register_namespace_v1(t2, OptionRouterNamespaceV1(namespace: "log", provider_id: "provider.log", provider_marker_path: ""))
    assert d3.ok
    t3

describe "stage0 option router — exact routes":
    # @manual scenario evidence
    it "routes a flag spelling to its handler route":
        # @req REQ-SSPEC-UNIT
        step("routes a flag spelling to its handler route")
        val t = _table()
        val d = option_router_dispatch_token_v1(t, "--verbose", false)
        expect(d.kind).to_be(ROUTER_DISPATCH_EXACT)
        expect(d.option_id).to_be("core.verbose")
        expect(d.route_index).to_be(0)
        expect(d.has_value).to_be(false)

    it "routes a valued spelling with =value to the right handler":
        # @req REQ-SSPEC-UNIT
        step("routes a valued spelling with =value to the right handler")
        val t = _table()
        val d = option_router_dispatch_token_v1(t, "--opt-level=2", false)
        expect(d.kind).to_be(ROUTER_DISPATCH_EXACT)
        expect(d.option_id).to_be("core.opt_level")
        expect(d.has_value).to_be(true)
        expect(d.value).to_be("2")

    it "value-mode is enforced: required without = is an error, flag with = is an error":
        # @req REQ-SSPEC-UNIT
        step("value-mode is enforced: required without = is an error, flag with = is an error")
        val t = _table()
        expect(option_router_dispatch_token_v1(t, "--opt-level", false).kind).to_be(ROUTER_DISPATCH_ERROR)
        expect(option_router_dispatch_token_v1(t, "--verbose=1", false).kind).to_be(ROUTER_DISPATCH_ERROR)

    it "unknown exact option is a fail-closed error":
        # @req REQ-SSPEC-UNIT
        step("unknown exact option is a fail-closed error")
        val t = _table()
        expect(option_router_dispatch_token_v1(t, "--nope", false).kind).to_be(ROUTER_DISPATCH_ERROR)

    it "reserved spellings cannot be registered":
        # @req REQ-SSPEC-UNIT
        step("reserved spellings cannot be registered")
        val t = _table()
        val (_, d) = option_router_register_route_v1(t, OptionRouterRouteV1(option_id: "bad", spelling: "--help", value_mode: CLI_VALUE_MODE_FLAG, provider_id: ""))
        expect(d.ok).to_be(false)
        expect(d.code).to_be(CLI_ROUTE_ERR_RESERVED_SPELLING)

describe "stage0 option router — --x extension split":
    it "splits --x<ns>-<key>=<value> into namespace/key/value":
        # @req REQ-SSPEC-UNIT
        step("splits --x<ns>-<key>=<value> into namespace/key/value")
        val t = _table()
        val d = option_router_dispatch_token_v1(t, "--xlog-level=debug", false)
        expect(d.kind).to_be(ROUTER_DISPATCH_EXTENSION)
        expect(d.namespace).to_be("log")
        expect(d.key).to_be("level")
        expect(d.value).to_be("debug")
        expect(d.has_value).to_be(true)
        expect(d.ns_index).to_be(0)

    it "flag form --x<ns>-<key> has no value; key may contain dashes":
        # @req REQ-SSPEC-UNIT
        step("flag form --x<ns>-<key> has no value; key may contain dashes")
        val t = _table()
        val d = option_router_dispatch_token_v1(t, "--xlog-color-mode", false)
        expect(d.kind).to_be(ROUTER_DISPATCH_EXTENSION)
        expect(d.namespace).to_be("log")
        expect(d.key).to_be("color-mode")
        expect(d.has_value).to_be(false)

    it "unknown namespace and malformed --x tokens are fail-closed errors":
        # @req REQ-SSPEC-UNIT
        step("unknown namespace and malformed --x tokens are fail-closed errors")
        val t = _table()
        val d1 = option_router_dispatch_token_v1(t, "--xzz-key", false)
        expect(d1.kind).to_be(ROUTER_DISPATCH_ERROR)
        expect(d1.error_code).to_be(CLI_ROUTE_ERR_UNKNOWN_NAMESPACE)
        val d2 = option_router_dispatch_token_v1(t, "--xlog", false)
        expect(d2.kind).to_be(ROUTER_DISPATCH_ERROR)
        expect(d2.error_code).to_be(CLI_ROUTE_ERR_BAD_NAMESPACE_SHAPE)
        val d3 = option_router_dispatch_token_v1(t, "--x-key", false)
        expect(d3.kind).to_be(ROUTER_DISPATCH_ERROR)

describe "stage0 option router — argv routing with hard -- boundary":
    it "routes a mixed argv and stops intercepting after --":
        # @req REQ-SSPEC-UNIT
        step("routes a mixed argv and stops intercepting after --")
        val t = _table()
        match option_router_route_argv_v1(t, ["--verbose", "--xlog-level=info", "input.spl", "--", "--xlog-level=late"]):
            case Ok(ds):
                expect(ds.len()).to_be(5)
                expect(ds[0].kind).to_be(ROUTER_DISPATCH_EXACT)
                expect(ds[1].kind).to_be(ROUTER_DISPATCH_EXTENSION)
                expect(ds[2].kind).to_be(ROUTER_DISPATCH_POSITIONAL)
                expect(ds[3].kind).to_be(ROUTER_DISPATCH_TERMINATOR)
                expect(ds[4].kind).to_be(ROUTER_DISPATCH_PROGRAM_ARG)
            case Err(e):
                expect(e).to_be("")

    it "argv routing is fail-closed on the first bad token":
        # @req REQ-SSPEC-UNIT
        step("argv routing is fail-closed on the first bad token")
        val t = _table()
        match option_router_route_argv_v1(t, ["--verbose", "--xzz-key"]):
            case Ok(_): expect(true).to_be(false)
            case Err(e): expect(e.contains("unknown namespace")).to_be(true)

describe "production app-root option plan":
    it "drops the entry script and consumes paired and inline log options":
        val plan = app_root_option_plan_v1([
            "src/app/main.spl",
            "--log-mode", "json",
            "--progress=dot",
            "--help"
        ])
        expect(plan.ok).to_be(true)
        expect(plan.routed_args).to_equal(["--help"])

    it "consumes DynSMF controls but retains the existing status command":
        val plan = app_root_option_plan_v1([
            "--no-dynsmf",
            "--disable-dynsmf=log.debug",
            "--dynsmf-status"
        ])
        expect(plan.ok).to_be(true)
        expect(plan.routed_args).to_equal(["--dynsmf-status"])

    it "routes the exact component config and status through one plan":
        val plan = app_root_option_plan_v1([
            "--component-config=config/components.sdn",
            "--component-status"
        ])
        expect(plan.component_config_ok).to_be(true)
        expect(plan.component_configured).to_be(true)
        expect(plan.component_config_path).to_equal("config/components.sdn")
        expect(plan.routed_args).to_equal(["--component-status"])

    it "preserves duplicate and empty component-config failures":
        val duplicate = app_root_option_plan_v1([
            "--component-config=a.sdn",
            "--component-config=b.sdn",
            "ordinary-command"
        ])
        expect(duplicate.component_config_ok).to_be(false)
        expect(duplicate.component_config_error).to_equal(
            "duplicate_component_config")

        val empty = app_root_option_plan_v1([
            "--component-config=",
            "ordinary-command"
        ])
        expect(empty.component_config_ok).to_be(false)
        expect(empty.component_config_error).to_equal(
            "empty_component_config_path")

    it "preserves unknown-command and hard-boundary semantics":
        val unknown = app_root_option_plan_v1(["ordinary-command"])
        expect(unknown.routed_args).to_equal(["ordinary-command"])

        val bounded = app_root_option_plan_v1([
            "--quiet", "--", "--component-status"
        ])
        expect(bounded.routed_args).to_equal(["--", "--component-status"])

    it "owns the unchanged DynSMF and component help lines":
        expect(app_root_startup_option_help_lines_v1()).to_equal([
            "dynSMF startup options:",
            "  --dynsmf-status",
            "  --no-dynsmf",
            "  --disable-dynsmf=<ids>",
            "",
            "Component startup options:",
            "  --component-config=<exact-file>",
            "  --component-status"
        ])

describe "production app-root load and segment cutover":
    it "returns typed no-action state when batch1 exposes no artifact metadata":
        val policy = startup_load_policy_for_component_input_v1(
            true, "config/components.sdn")
        expect(policy.applicable).to_be(false)
        expect(policy.ok).to_be(true)
        expect(policy.reason).to_contain("artifact_metadata_unavailable")

        val result = startup_segment_load_result_v1(policy, false, "")
        expect(result.applicable).to_be(false)
        expect(result.ok).to_be(true)
        expect(result.plan.planned).to_be(false)
        expect(result.plan.rows.len()).to_be(0)

    it "uses canonical policy and segment planning when both inputs exist":
        val policy = startup_load_policy_result_v1(
            launch_metadata_default("smf"), true, false)
        val result = startup_segment_load_result_v1(
            policy,
            true,
            "segments:\n  kind: rx offset: 0 len: 16\n"
        )
        expect(result.applicable).to_be(true)
        expect(result.ok).to_be(true)
        expect(result.plan.planned).to_be(true)
        expect(result.plan.rows.len()).to_be(1)
        expect(result.plan.rows[0].action).to_equal("map_read_only")

    it "keeps main free of the removed parallel option cleaners":
        val source = file_read("src/app/main.spl")
        expect(source).to_contain("app_root_option_plan_v1(raw_args)")
        expect(source).to_contain("dynsmf_admitted_registry_load")
        expect(source).to_contain("component_dynsmf_startup_from_registry_config_path")
        expect(source.contains("dynsmf_trust_registry_unconfigured")).to_equal(false)
        expect(source.contains("fn app_root_clean_log_args")).to_equal(false)
        expect(source.contains("fn app_root_component_config_option")).to_equal(false)
