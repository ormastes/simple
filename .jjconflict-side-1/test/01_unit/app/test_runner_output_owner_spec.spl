use std.test_runner.test_runner_output.{result_doc_name}
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "test runner doc output path owner":
    it "keeps Stage4 doc output on the concrete basename owner":
        val source = file_read("src/lib/nogc_sync_mut/test_runner/test_runner_output.spl")
        expect(source).to_contain("use std.nogc_sync_mut.io.sysinfo_ops.{path_basename}")
        expect(source.contains("use std.io.{path_basename}")).to_equal(false)
        expect(source).to_contain("val name = result_doc_name(result.path)")

    it "formats a POSIX result path as its basename":
        expect(result_doc_name("nested/path/example_spec.spl")).to_equal("example_spec.spl")

    it "prevents platform path separators from leaking into doc output":
        expect(result_doc_name("C:\\repo\\test\\nested\\example_test.spl")).to_equal("example_test.spl")
