use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "owned process facade contract":
    it "routes through the identity-owned bounded provider and exposes a versioned receipt":
        val owner = file_read("src/lib/nogc_sync_mut/io/process_ops.spl")
        val hub = file_read("src/app/io/mod.spl")
        val exports = file_read("src/app/io/__init__.spl")
        val interpreter = file_read("src/compiler_rust/compiler/src/interpreter_extern/system.rs")
        expect(owner).to_contain("extern fn rt_process_run_owned_bounded_value")
        expect(owner).to_contain("pub fn process_run_owned_bounded")
        expect(owner).to_contain("pub fn process_owned_terminate")
        expect(owner).to_contain("fields.len() == 19")
        expect(owner).to_contain("OWNED_PROCESS_MAX_TIMEOUT_MS")
        expect(owner).to_contain("OWNED_PROCESS_MAX_OUTPUT_BYTES")
        expect(hub).to_contain("process_run_owned_bounded")
        expect(exports).to_contain("OwnedProcessReceipt")
        expect(interpreter).to_contain("unsupported by the interpreter: owned PID identity receipts require the native runtime provider")

    it "registers the exact provider across symbol, SFFI, Stage4, and runtime build closures":
        val symbols = file_read("src/compiler_rust/common/src/runtime_symbols.rs")
        val sffi = file_read("src/compiler_rust/compiler/src/codegen/runtime_sffi.rs")
        val closure = file_read("src/compiler/70.backend/backend/stage4_symbol_closure.spl")
        val build = file_read("src/compiler/70.backend/backend/runtime_compiler.spl")
        val adapter = file_read("src/runtime/runtime_process_owned.c")
        for source in [symbols, sffi, closure]:
            expect(source).to_contain("rt_process_run_owned_bounded_value")
            expect(source).to_contain("rt_process_owned_cancel_value")
        expect(build).to_contain("runtime_process_owned")
        expect(adapter).to_contain("memchr(cmd_data, '\\0'")
        expect(adapter).to_contain("memchr(arg_data, '\\0'")
        expect(adapter).to_contain("RT_OWNED_PROCESS_RECEIPT_VERSION, 0, 0")
        expect(adapter).to_contain("ENOTSUP")
