# Regression spec for
# doc/08_tracking/bug/for_loop_var_shadows_prior_local_binding_lost_2026-06-11.md
#
# Originally reported: a `for X in arr` loop whose loop variable name reuses
# an earlier `val`/`var` binding in the same function silently lost the
# iterated element -- the interpreter printed the stale (or default int 0)
# value instead of each array element, and native codegen read nil.
#
# Native/MIR side was fixed 2026-06-11 (newest-first local resolution in
# `lowering_stmt.rs`). The interpreter side was left OPEN in that doc.
#
# Re-verified 2026-08-09: the interpreter no longer reproduces the defect --
# `bin/simple /tmp/v7.spl` and `SIMPLE_EXECUTION_MODE=interpreter bin/simple
# /tmp/v7.spl` both print "p" then "q" for the exact repro in the bug doc.
# No live defect remains on this lane.

fn shadowed_loop_values() -> [text]:
    var bar = "X"
    var out: [text] = []
    for bar in ["p", "q"]:
        out.push(bar)
    out

describe "for-loop variable that shadows a prior val/var binding":
    it "sees each iterated element, not the stale prior binding":
        val out = shadowed_loop_values()
        expect(out.len()).to_equal(2)
        expect(out.get(0)).to_equal("p")
        expect(out.get(1)).to_equal("q")
