# Regression spec for item 24 of doc/08_tracking/bug/
# unit_sweep_language_and_interpreter_gaps_2026-08-26.md
#
# Reported: the one-line `unsafe(capabilities: [...]): expr` body was rejected
# by the Rust seed parser with "expected Newline, found Identifier". Only the
# indented block form parsed, so the 13 sites in
# src/os/kernel/boot/mmio_hardware.spl had been expanded to blocks as a
# workaround.
#
# Cause: `parse_unsafe_block_primary` (parser/src/expressions/primary/mod.rs)
# called `parse_block`, which accepts only the indented form. Fixed by routing
# the body through `parse_inline_or_block`, the existing helper that accepts
# both shapes. The workaround in mmio_hardware.spl was reverted in the same
# change.
#
# This spec is a PARSE-level gate: if the inline form does not parse, this file
# fails to load and every example below reports as an error.

fn inline_unsafe_double(v: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]): v * 2

fn inline_unsafe_sum(a: i64, b: i64) -> i64:
    unsafe(capabilities: [ffi]): a + b

fn block_unsafe_double(v: i64) -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        v * 2

fn inline_unsafe_in_if(v: i64, on: bool) -> i64:
    if on:
        unsafe(capabilities: [ffi, raw_ptr]): v * 2
    else:
        0

describe "inline unsafe body":
    it "parses and evaluates a one-line unsafe body":
        expect(inline_unsafe_double(21)).to_equal(42)

    it "parses a one-line unsafe body with a single capability":
        expect(inline_unsafe_sum(20, 22)).to_equal(42)

    it "keeps the indented unsafe block form working":
        expect(block_unsafe_double(21)).to_equal(42)

    it "accepts a one-line unsafe body nested inside a control-flow body":
        expect(inline_unsafe_in_if(21, true)).to_equal(42)
        expect(inline_unsafe_in_if(21, false)).to_equal(0)
