#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
out_dir=${TMPDIR:-/tmp}/simple-runtime-exception-frame-test-$$
mkdir -p "$out_dir"
trap 'rm -rf "$out_dir"' EXIT HUP INT TERM

cc -std=gnu11 -O2 -ffunction-sections -fdata-sections \
    -I"$repo_root/src/runtime" -I"$repo_root/src/runtime/platform" \
    -c "$repo_root/src/runtime/runtime_native.c" -o "$out_dir/runtime_native.o"
cc -std=gnu11 -O2 -I"$repo_root/src/runtime" \
    "$repo_root/test/01_unit/runtime/runtime_exception_frame_test.c" \
    "$out_dir/runtime_native.o" -Wl,--gc-sections -pthread -ldl -lm \
    -o "$out_dir/runtime_exception_frame_test"
"$out_dir/runtime_exception_frame_test"
