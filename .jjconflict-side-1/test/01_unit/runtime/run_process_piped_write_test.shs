#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
test_dir=$(mktemp -d)
trap 'rm -rf "$test_dir"' EXIT HUP INT TERM

link_gc=-Wl,--gc-sections
if [ "$(uname -s)" = Darwin ]; then
    link_gc=-Wl,-dead_strip
fi

cc -O2 -std=gnu11 -Wall -Wextra -Werror -ffunction-sections -fdata-sections \
    -I "$repo_root/src/runtime" \
    "$repo_root/test/01_unit/runtime/process_piped_write_test.c" \
    "$repo_root/src/runtime/runtime_process.c" \
    "$link_gc" -pthread \
    -o "$test_dir/process_piped_write_test"

"$test_dir/process_piped_write_test"
echo 'STATUS: PASS browser renderer runtime sandbox'
