#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
bootstrap="$root/scripts/bootstrap/bootstrap-from-scratch.sh"
resume="$root/scripts/bootstrap/resume-stage3-from-admitted.sh"
probe="$root/scripts/check/check-bootstrap-stage2-llvm-struct-receiver.shs"
helper="$root/scripts/check/lib/bootstrap-stage3/receiver-probe.shs"
manifest_write="$root/scripts/check/lib/bootstrap-stage3/manifest-write.shs"
manifest_verify="$root/scripts/check/lib/bootstrap-stage3/manifest-verify.shs"
fixture="$root/test/04_smoke/bootstrap_llvm_struct_receiver_guard.spl"

fail() { echo "FAIL: $*" >&2; exit 1; }
contains() { grep -Fq -- "$2" "$1" || fail "missing $2 in $1"; }

contains "$fixture" 'fn zero(self) -> i64:'
contains "$fixture" 'fn plus(self, amount: i64) -> i64:'
contains "$fixture" 'receiver.zero() + receiver.plus(2)'
contains "$probe" 'SIMPLE_LLVM_BITCODE_DEBUG=1'
contains "$probe" 'SIMPLE_KEEP_LLVM_IR=1'
contains "$probe" '--backend llvm'
contains "$probe" '--entry-closure'
contains "$probe" '--runtime-path "$runtime"'
contains "$probe" 'declare i8 @rt_struct_receiver_valid(i64, i64, i64)'
contains "$probe" 'call i8 @rt_struct_receiver_valid'
contains "$probe" 'nm -u "$object"'
contains "$probe" 'nm -g --defined-only "$probe_bin"'
contains "$helper" 'simple-bootstrap-stage2-receiver-smoke-evidence-v1'
contains "$helper" 'simple-bootstrap-stage2-llvm-receiver-evidence-v1'
contains "$helper" 'bootstrap_stage3_verify_llvm_receiver_evidence'
contains "$bootstrap" 'check-bootstrap-stage2-struct-receiver.shs'
contains "$bootstrap" 'check-bootstrap-stage2-llvm-struct-receiver.shs'
contains "$bootstrap" 'bootstrap_stage3_verify_receiver_smoke_evidence'
contains "$bootstrap" 'bootstrap_stage3_verify_llvm_receiver_evidence'
contains "$resume" 'stage2-struct-receiver-smoke.env'
contains "$resume" 'stage2-llvm-struct-receiver'
contains "$resume" 'bootstrap_stage3_verify_receiver_smoke_evidence'
contains "$resume" 'bootstrap_stage3_verify_llvm_receiver_evidence'
contains "$manifest_write" 'simple-bootstrap-stage3-provenance-v4'
contains "$manifest_write" 'stage2_llvm_receiver_evidence_sha256='
contains "$manifest_verify" 'simple-bootstrap-stage3-provenance-v4'
contains "$manifest_verify" 'stage2_llvm_receiver_evidence_path'

echo 'bootstrap_stage2_llvm_receiver_admission_contract_test: PASS'
