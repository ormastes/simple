# Const-By-Default Reference Lint Specification
#
# Verifies W-MC-REF-001 (const_ref_default): a function body that mutates a
# parameter not declared `mut` gets a warning; `mut` params, locals, and
# shadowed params do not. Text-level heuristic (see const_ref_default.spl for
# the ponytail note; upgrade path = semantic effect analysis).

use std.spec.*
use compiler.semantics.lint.const_ref_default.{
    ConstRefFinding,
    check_const_ref_default
}


describe "W-MC-REF-001: mutation of a non-mut parameter":
    """
    ## Const-by-default references

    Parameters are const by default; mutating one without a `mut`
    annotation is flagged at warn level.
    """

    context "when an unannotated parameter is mutated":

        it "warns on plain reassignment of a parameter":
            val source = "fn f(x: i64) -> i64:\n    x = 5\n    x\n"
            val findings = check_const_ref_default(source, "src/app/demo.spl")
            expect(findings.len()).to_equal(1)
            expect(findings[0].code).to_equal("W-MC-REF-001")
            expect(findings[0].param).to_equal("x")
            expect(findings[0].line_num).to_equal(2)

        it "warns on compound assignment of a parameter":
            val source = "fn bump(n: i64) -> i64:\n    n += 2\n    n\n"
            val findings = check_const_ref_default(source, "src/app/demo.spl")
            expect(findings.len()).to_equal(1)
            expect(findings[0].param).to_equal("n")

        it "warns on index assignment into a parameter":
            val source = "fn set0(buf: [i64], v: i64):\n    buf[0] = v\n"
            val findings = check_const_ref_default(source, "src/app/demo.spl")
            expect(findings.len()).to_equal(1)
            expect(findings[0].param).to_equal("buf")

        it "warns on a known-mutating method call on a parameter":
            val source = "fn add(items: [i64], v: i64):\n    items.push(v)\n"
            val findings = check_const_ref_default(source, "src/app/demo.spl")
            expect(findings.len()).to_equal(1)
            expect(findings[0].param).to_equal("items")

    context "when the parameter is declared mut":

        it "does not warn on reassignment of a mut parameter":
            val source = "fn f(mut x: i64) -> i64:\n    x = 5\n    x\n"
            val findings = check_const_ref_default(source, "src/app/demo.spl")
            expect(findings.len()).to_equal(0)

        it "does not warn on push into a mut array parameter":
            val source = "fn add(mut items: [i64], v: i64):\n    items.push(v)\n"
            val findings = check_const_ref_default(source, "src/app/demo.spl")
            expect(findings.len()).to_equal(0)

        it "warns only for the non-mut param in a mixed signature":
            val source = "fn g(mut buf: [i64], v: i64):\n    buf.push(v)\n    v = 3\n"
            val findings = check_const_ref_default(source, "src/app/demo.spl")
            expect(findings.len()).to_equal(1)
            expect(findings[0].param).to_equal("v")

    context "when only locals are mutated":

        it "does not warn on mutating a var local":
            val source = "fn f(x: i64) -> i64:\n    var acc = 0\n    acc = acc + x\n    acc\n"
            val findings = check_const_ref_default(source, "src/app/demo.spl")
            expect(findings.len()).to_equal(0)

        it "does not warn on push into a var local array":
            val source = "fn f(x: i64):\n    var out: [i64] = []\n    out.push(x)\n"
            val findings = check_const_ref_default(source, "src/app/demo.spl")
            expect(findings.len()).to_equal(0)

    context "when a local re-declaration shadows the parameter":

        it "does not warn on mutation after a var shadow of the param":
            val source = "fn f(x: i64) -> i64:\n    var x = 0\n    x = 5\n    x\n"
            val findings = check_const_ref_default(source, "src/app/demo.spl")
            expect(findings.len()).to_equal(0)

        it "does not warn on push after a val shadow of the param":
            val source = "fn f(items: [i64]):\n    val items = [1]\n    items.push(2)\n"
            val findings = check_const_ref_default(source, "src/app/demo.spl")
            expect(findings.len()).to_equal(0)

    context "non-mutating uses and exclusions":

        it "does not warn on read-only uses (comparison, call argument)":
            val source = "fn f(x: i64) -> bool:\n    if x == 3:\n        return true\n    print(x)\n    false\n"
            val findings = check_const_ref_default(source, "src/app/demo.spl")
            expect(findings.len()).to_equal(0)

        it "skips extern fn declarations":
            val source = "extern fn rt_write(fd: i64) -> i64\n"
            val findings = check_const_ref_default(source, "src/app/demo.spl")
            expect(findings.len()).to_equal(0)

        it "skips vendored sources":
            val source = "fn f(x: i64) -> i64:\n    x = 5\n    x\n"
            val findings = check_const_ref_default(source, "src/runtime/vendor/lib/thing.spl")
            expect(findings.len()).to_equal(0)
