# @tag: unit, compiler, mir, native-safe
use std.spec.{describe, it, expect}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*

fn lower_stmt_dispatch_fixture() -> (text, text, i64, i64):
    val source = "fn implicit_tail() -> i64:\n    val x = 1\n    var y = 2\n    y = x\n    if true:\n        val z = 3\n        z\n    else:\n        y\n\nfn explicit_return() -> i64:\n    return 9\n"
    val parsed = parse_full_frontend(
        source, "hir_stmt_scalar_dispatch.spl",
        "hir_stmt_scalar_dispatch", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(
        "hir_stmt_scalar_dispatch.spl")
    val hir = hir_lowering.lower_module(parsed)
    var mir_lowering = MirLowering.new(hir.symbols)
    val mir = mir_lowering.lower_module(hir)
    var implicit_text = ""
    var explicit_text = ""
    for function in mir.functions.values():
        if function.name == "implicit_tail" or function.name.ends_with(".implicit_tail"):
            implicit_text = serialize_mir_function(function)
        elif function.name == "explicit_return" or function.name.ends_with(".explicit_return"):
            explicit_text = serialize_mir_function(function)
    (implicit_text, explicit_text, hir_lowering.errors.len(), mir_lowering.errors.len())

describe "HIR statement scalar dispatch into MIR":
    it "emits Let, Assign, nested block tails, and both return forms":
        val (implicit_mir, explicit_mir, hir_errors, mir_errors) = lower_stmt_dispatch_fixture()
        expect(hir_errors).to_equal(0)
        expect(mir_errors).to_equal(0)
        expect(implicit_mir.len()).to_be_greater_than(0)
        expect(explicit_mir.len()).to_be_greater_than(0)
        # Let/var bindings create locals; assignment emits a copy/store; the
        # nested if contributes branch blocks and its implicit tail returns.
        expect(implicit_mir).to_contain("locals")
        expect(implicit_mir).to_contain("Copy")
        expect(implicit_mir).to_contain("If")
        expect(implicit_mir).to_contain("Return")
        # Explicit HirExprKind.Return remains a statement and emits Return too.
        expect(explicit_mir).to_contain("Return")
