# @cover src/compiler/50.mir/mir_data.spl 2%
# @tag: unit, compiler, mir, regression

use std.spec
use compiler.mir.mir_data.*

describe "MIR call emission":
    it "does not inspect an optional operand payload":
        var builder = MirBuilder.new()
        builder.begin_simple_function("caller", "unit")
        val signature = MirSignature(params: [], return_type: MirType.i64(), is_variadic: false)
        val function = MirOperand(kind: MirOperandKind.Const(
            MirConstValue.Str("callee"),
            MirType(kind: MirTypeKind.FuncPtr(signature))
        ))
        val optional_payload = MirOperand(kind: MirOperandKind.Copy(nil))

        builder.emit_call(function, [optional_payload], MirType.i64())

        expect(builder.instructions.len()).to_equal(1)
