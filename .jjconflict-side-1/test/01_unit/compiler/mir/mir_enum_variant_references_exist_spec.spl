"""
# MIR enum variant references in specs must exist (detection)

**Category:** Compiler / MIR
**Status:** Stable

## Overview

Detection spec for the defect CLASS behind the stale `MirTerminator.Return`
incident: a test spec names an enum variant that the product enum does not
declare. Simple only diagnoses an unknown variant when the constructing
expression is evaluated, so such a reference is silent in any code path that
is skipped, guarded, or dead — it is not a compile-time error for the file.

The reproducer (`mir_terminator_variant_name_spec.spl`) pins the one variant
name that was wrong. This spec generalises: it extracts EVERY
`<MirEnum>.<Variant>` reference out of the MIR-constructing specs and asserts
each referenced variant is actually declared in the corresponding product
enum. It therefore fails on any future stale variant, on any of the five
tracked MIR enums, not only on `Return`.
"""

extern fn rt_file_read_text(path: text) -> text

fn read(path: text) -> text:
    rt_file_read_text(path) ?? ""

fn is_ident_char(c: text) -> bool:
    c >= "a" and c <= "z" or c >= "A" and c <= "Z" or c >= "0" and c <= "9" or c == "_"

# Slice the `enum <name>:` block out of a product source file. The block runs
# from the enum header to the next line that starts in column 0 and is not a
# blank/comment/indented line.
fn enum_block(source: text, enum_name: text) -> text:
    val lines = source.split("\n")
    var out = ""
    var inside = false
    var i = 0
    while i < lines.len():
        val line = lines[i]
        if inside:
            if line.len() > 0 and not line.starts_with(" ") and not line.starts_with("\t"):
                inside = false
            else:
                out = out + line + "\n"
        if line.starts_with("enum {enum_name}:"):
            inside = true
        i = i + 1
    out

# Every distinct `<prefix>.<Ident>` variant name referenced in `source`.
fn referenced_variants(source: text, prefix: text) -> [text]:
    val needle = prefix + "."
    var found: [text] = []
    var idx = 0
    while idx < source.len():
        val hit = source.index_of(needle, idx)
        if hit < 0:
            idx = source.len()
        else:
            var j = hit + needle.len()
            var name = ""
            while j < source.len() and is_ident_char(source.substring(j, j + 1)):
                name = name + source.substring(j, j + 1)
                j = j + 1
            if name.len() > 0 and not found.contains(name):
                found.push(name)
            idx = hit + needle.len()
    found

# Collect the variant names an `enum` block declares. Handles all three
# shapes the MIR enums actually use: payload variants (`Ret(value: X)`),
# comma-packed payload-less variants (`Add, Sub, Mul`), and multi-line payload
# variants whose field lines must NOT be mistaken for variants.
fn declared_variants(block: text) -> [text]:
    var out: [text] = []
    val lines = block.split("\n")
    var i = 0
    while i < lines.len():
        var line = lines[i]
        val hash = line.index_of("#", 0)
        if hash >= 0:
            line = line.substring(0, hash)
        val pieces = line.split(",")
        var p = 0
        while p < pieces.len():
            val piece = pieces[p].trim()
            val paren = piece.index_of("(", 0)
            val colon = piece.index_of(":", 0)
            # A `name: Type` field line belongs to a payload, not a variant.
            val is_field = colon >= 0 and (paren < 0 or colon < paren)
            if not is_field:
                var name = ""
                var j = 0
                while j < piece.len() and is_ident_char(piece.substring(j, j + 1)):
                    name = name + piece.substring(j, j + 1)
                    j = j + 1
                val head = name.substring(0, 1)
                if name.len() > 0 and head >= "A" and head <= "Z" and not out.contains(name):
                    out.push(name)
            p = p + 1
        i = i + 1
    out

fn declares_variant(block: text, variant: text) -> bool:
    declared_variants(block).contains(variant)

describe "MIR enum variant references in specs":
    it "resolves every MIR enum variant named by the MIR-constructing specs":
        # (enum name, product source file holding its declaration)
        val enums = [
            ("MirTerminator", "src/compiler/50.mir/mir_instruction_support.spl"),
            ("MirOperandKind", "src/compiler/50.mir/mir_instruction_support.spl"),
            ("MirBinOp", "src/compiler/50.mir/mir_instruction_support.spl"),
            ("MirInstKind", "src/compiler/50.mir/mir_instruction_kinds.spl"),
            ("MirConstValue", "src/compiler/50.mir/mir_types.spl")
        ]

        val specs = [
            "test/03_system/feature/compiler/mir_complex_spec.spl",
            "test/03_system/feature/compiler/mir_native_spec.spl",
            "test/03_system/feature/compiler/mir_builder_spec.spl",
            "test/03_system/app/compiler/feature/optimization_plugin_jit_hotspot_system_spec.spl",
            "test/system/app/compiler/feature/optimization_plugin_jit_hotspot_system_spec.spl",
            "test/integration/compiler/vhdl_backend_e2e_spec.spl",
            "test/02_integration/compiler/vhdl_backend_e2e_spec.spl"
        ]

        var checked = 0
        var unresolved: [text] = []

        var e = 0
        while e < enums.len():
            val enum_name = enums[e][0]
            val block = enum_block(read(enums[e][1]), enum_name)
            # Non-vacuity: the enum block must have been located.
            expect(block.len() > 0).to_equal(true)

            var s = 0
            while s < specs.len():
                val spec_source = read(specs[s])
                val names = referenced_variants(spec_source, enum_name)
                var n = 0
                while n < names.len():
                    checked = checked + 1
                    if not declares_variant(block, names[n]):
                        unresolved.push("{specs[s]}: {enum_name}.{names[n]}")
                    n = n + 1
                s = s + 1
            e = e + 1

        # Non-vacuity: this scan must actually have examined variant references.
        expect(checked > 0).to_equal(true)
        expect(unresolved).to_equal([])

    it "still flags a stale variant name when one is present":
        # Self-check of the detector: a synthetic source that names a variant
        # the real enum does not declare must be reported as unresolved.
        val block = enum_block(read("src/compiler/50.mir/mir_instruction_support.spl"), "MirTerminator")
        expect(block.len() > 0).to_equal(true)

        val synthetic = "terminator: MirTerminator.Return(nil)"
        val names = referenced_variants(synthetic, "MirTerminator")
        expect(names).to_equal(["Return"])
        expect(declares_variant(block, "Return")).to_equal(false)
        expect(declares_variant(block, "Ret")).to_equal(true)
