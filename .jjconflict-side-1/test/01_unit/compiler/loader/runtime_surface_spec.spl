use std.spec

extern fn rt_file_read_text(path: text) -> text

fn runtime_init_text() -> text:
    rt_file_read_text("src/compiler/99.loader/runtime/__init__.spl")

fn loader_alias_init_text() -> text:
    rt_file_read_text("src/compiler/99.loader/loader/__init__.spl")

fn root_loader_init_text() -> text:
    rt_file_read_text("src/compiler/99.loader/__init__.spl")

describe "loader runtime compatibility surfaces":
    it "loader alias package is a thin alias to the curated runtime package":
        val alias_text = loader_alias_init_text()
        expect(alias_text).to_contain("export use compiler.loader.runtime.*")
        expect(alias_text.contains("export ModuleLoader")).to_equal(false)
        expect(alias_text.contains("export native_mmap_file")).to_equal(false)

    it "runtime facade keeps the curated export list and avoids duplicate jit-context instantiation exports":
        val runtime_text = runtime_init_text()
        expect(runtime_text).to_contain("export JitCompilationContext")
        expect(runtime_text).to_contain("export InstantiationRecord")
        # NOTE (2026-08-10): the braces here MUST be doubled. A matched `{...}`
        # pair inside a text literal is STRING INTERPOLATION, so the unescaped
        # form compiled the brace content as a variable reference and the whole
        # example died with `semantic: variable 'moduleloader_execute_smf' not
        # found` — it never reached any assertion. `{{` renders as a literal `{`
        # (verified), so this matches the real re-export line.
        expect(runtime_text).to_contain("export use compiler.loader.module_loader_compat.{{moduleloader_execute_smf}}")
        expect(runtime_text.contains("\nexport moduleloader_execute_smf\n")).to_equal(false)
        expect(runtime_text.contains("# Re-exported from jit_context.spl\nexport JitCompilationContext\nexport InstantiationRecord")).to_equal(false)

    it "root compatibility facade still documents compiler.loader.runtime as the preferred public surface":
        val root_text = root_loader_init_text()
        # The pointer is intentionally documentation, so pin the whole sentence
        # rather than the bare dotted name (which any stray mention satisfied).
        expect(root_text).to_contain("Newer curated loader consumers should prefer `compiler.loader.runtime`.")
        # ...and pin the facade's real re-export surface alongside it.
        expect(root_text).to_contain("export use compiler.loader.compiler_sffi.{")
        expect(root_text).to_contain("moduleloader_load")
