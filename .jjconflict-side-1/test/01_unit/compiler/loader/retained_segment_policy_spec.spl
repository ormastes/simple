# Provider-owned retained-image policy: no mapper path reopening or implicit
# OS policy.  These two cases prove the only admitted mapping route and that
# unsupported read-ahead fails before it can allocate executable memory.

use std.spec.{describe, it, assert_true, assert_eq}
use compiler.loader.segment_mapper.{
    SegmentMapper, RetainedSegmentLoadIntent,
    anonymous_wx_retained_provider, retained_segment_policy_receipt
}

fn selected_bytes() -> [u8]:
    [0x90u8, 0x90u8, 0xC3u8]

describe "retained segment provider policy":
    it "records normal legacy and selected anonymous-WX policy receipts":
        val provider = anonymous_wx_retained_provider("registry-retained-image")
        assert_true(provider.anonymous_wx_selected)
        assert_true(not provider.file_backed_selected)
        assert_true(not provider.retained_read_ahead)

        val normal = retained_segment_policy_receipt(
            provider, RetainedSegmentLoadIntent.Normal, 3, 4).unwrap()
        assert_eq(normal.provider, "registry-retained-image")
        assert_eq(normal.mechanism, "anonymous-wx-legacy")
        assert_eq(normal.selected_bytes, 3)
        assert_eq(normal.mapping_calls, 4)

        val selected = retained_segment_policy_receipt(
            provider, RetainedSegmentLoadIntent.MapSelectedSegments, 3, 5).unwrap()
        assert_eq(selected.mechanism, "anonymous-wx-selected")
        assert_eq(selected.fallback_reason, "")
        assert_eq(selected.selected_bytes, 3)
        assert_eq(selected.mapping_calls, 5)

    it "rejects unsupported selected read-ahead before mapping":
        val provider = anonymous_wx_retained_provider("registry-retained-image")
        var mapper = SegmentMapper.new()
        val attempted = mapper.map_retained_segment(
            provider, RetainedSegmentLoadIntent.ReadAheadSelected,
            "read-ahead", 0, selected_bytes(), 16)
        assert_true(attempted.is_err())
        assert_true(attempted.unwrap_err().contains("does not support selected read-ahead"))
        assert_eq(mapper.stats().mapping_calls, 0)
        assert_eq(mapper.stats().segment_count, 0)
