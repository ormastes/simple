"""Bounded-copy coverage for literal interpolation-brace decoding."""

use std.spec.*
use std.io_runtime.{file_read}
use compiler.frontend.core.string_interpolation_expand.{decode_interpolation_brace_escapes}

describe "interpolation brace escape decoding":
    it "returns brace-free text unchanged":
        expect(decode_interpolation_brace_escapes("plain text")).to_equal("plain text")

    it "decodes paired opening and closing braces":
        expect(decode_interpolation_brace_escapes("a{{b}}c")).to_equal("a{b}c")

    it "preserves the old left-to-right behavior for odd brace runs":
        expect(decode_interpolation_brace_escapes("{{{")).to_equal("{{")
        expect(decode_interpolation_brace_escapes("}}}")).to_equal("}}")

    it "consumes adjacent pairs independently":
        expect(decode_interpolation_brace_escapes("{{{{")).to_equal("{{")
        expect(decode_interpolation_brace_escapes("}}}}")).to_equal("}}")

    it "preserves untouched spans around several escaped pairs":
        expect(decode_interpolation_brace_escapes("pre{{x}}mid{{y}}post")).to_equal(
            "pre{x}mid{y}post")

    it "preserves UTF-8 spans surrounding escaped braces byte-exactly":
        expect(decode_interpolation_brace_escapes("α{{雪}}🙂")).to_equal("α{雪}🙂")

    it "joins bounded source spans instead of growing an accumulator":
        val source = file_read("src/compiler/10.frontend/core/string_interpolation_expand.spl")
        val begin = source.index_of("fn decode_interpolation_brace_escapes")
        val finish = source.index_of("fn parse_string_interpolation_parts")
        expect(begin >= 0 and finish > begin).to_equal(true)
        val body = source.substring(begin, finish)
        expect(body.count("chunks.join(\"\")")).to_equal(1)
        expect(body.count("result = result + ch")).to_equal(0)
        expect(body.count("var result = \"\"")).to_equal(0)
