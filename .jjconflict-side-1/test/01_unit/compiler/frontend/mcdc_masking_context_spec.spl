# @cover src/compiler/10.frontend/core/mcdc_masking_context.spl 85%
use std.spec.*
use compiler.core.ast.*
use compiler.core.ast_expr.*
use compiler.core.mcdc_masking_context.*

describe "compiler formal masking contexts":
    it "derives neutral sibling requirements from Boolean structure":
        ast_reset()
        val a = expr_ident("a", 0)
        val b = expr_ident("b", 0)
        val c = expr_ident("c", 0)
        val conjunction = expr_binary(55, a, b, 0)
        val decision = expr_binary(56, conjunction, c, 0)
        val contexts = compiler_mcdc_formal_contexts(91, decision)
        expect(contexts.len()).to_equal(3)
        expect(contexts[0].context.requirement_count).to_equal(2)
        # a requires b=true at AND, then c=false at OR.
        expect(contexts[0].requirements[0].required_outcome).to_equal(true)
        expect(contexts[0].requirements[1].required_outcome).to_equal(false)
        expect(contexts[0].context.proof_id).to_be_greater_than(0)
        expect(contexts[0].context.context_id).to_be_greater_than(0)

    it "marks repeated atomic conditions as strongly coupled":
        ast_reset()
        val left = expr_ident("same", 0)
        val right = expr_ident("same", 0)
        val contexts = compiler_mcdc_formal_contexts(
            92, expr_binary(55, left, right, 0))
        expect(contexts.len()).to_equal(2)
        expect(contexts[0].context.strong_coupling).to_equal(true)
        expect(contexts[1].context.strong_coupling).to_equal(true)

    it "keeps proof identities sensitive to Boolean topology":
        ast_reset()
        val a = expr_ident("a", 0)
        val b = expr_ident("b", 0)
        val and_context = compiler_mcdc_formal_contexts(
            93, expr_binary(55, a, b, 0))
        val or_context = compiler_mcdc_formal_contexts(
            93, expr_binary(56, a, b, 0))
        expect(and_context[0].context.proof_id == or_context[0].context.proof_id).to_equal(false)
