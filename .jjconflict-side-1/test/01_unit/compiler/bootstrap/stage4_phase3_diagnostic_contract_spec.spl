extern fn rt_file_read_text(path: text) -> text

describe "Stage4 Phase 3 diagnostic contract":
    it "prints every buffered HIR diagnostic before either failure result":
        val source = rt_file_read_text("src/compiler/80.driver/driver_orchestration.spl") ?? ""
        val loop_start = source.index_of("while phase3_error_idx < self.ctx.errors.len():")
        val resolve_error = source.index_of("if first_error.contains(\"Method resolution\"):")
        val type_error = source.index_of("return CompileResult.TypeError(self.ctx.errors)")

        expect(loop_start).to_be_greater_than(-1)
        expect(source).to_contain("log_error(\"phase 3 diagnostic: {self.ctx.errors[phase3_error_idx]}\")")
        expect(resolve_error).to_be_greater_than(loop_start)
        expect(type_error).to_be_greater_than(loop_start)
