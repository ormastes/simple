extern fn rt_file_read_text(path: text) -> text

describe "Stage4 candidate provenance source roots":
    it "declares every source root included in the revision hash":
        val source = rt_file_read_text("scripts/check/lib/stage4-candidate-provenance.shs") ?? ""
        val roots = "src/compiler:src/lib:src/app:src/runtime:examples/10_tooling"

        expect(source).to_contain("find src/compiler src/lib src/app src/runtime examples/10_tooling")
        expect(source).to_contain("source_roots={roots}")
        expect(source).to_contain("= {roots} ] || exit 1")
