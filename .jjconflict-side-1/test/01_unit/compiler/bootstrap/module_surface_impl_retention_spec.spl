"""Ownership contract for compact implementation metadata in ModuleSurface."""

use std.io_runtime.{file_read}

describe "module surface implementation retention":
    it "retains only implementation fields consumed by Phase 3":
        val source = file_read(
            "src/compiler/20.hir/hir_lowering/module_surface.spl")
        val impl_start = source.find("struct ModuleSurfaceImpl:")
        val impl_end = source.find("struct ModuleSurfaceConst:")
        val impl_surface = if impl_start >= 0 and impl_end > impl_start:
            source.substring(impl_start, impl_end)
        else:
            ""
        expect(impl_surface).to_contain("type_: Type")
        expect(impl_surface).to_contain("has_trait_: bool")
        expect(impl_surface).to_contain("trait_: Type")
        expect(impl_surface).to_contain(
            "methods: Dict<text, ModuleSurfaceCallable>")
        expect(impl_surface.contains("type_params:")).to_equal(false)
        expect(impl_surface.contains("where_clause:")).to_equal(false)
        expect(impl_surface.contains("assoc_types:")).to_equal(false)
        expect(impl_surface.contains("span:")).to_equal(false)

    it "does not copy unused implementation AST graphs":
        val source = file_read(
            "src/compiler/20.hir/hir_lowering/module_surface.spl")
        val convert_start = source.find(
            "fn module_surface_impl_from_impl(impl_: Impl)")
        val convert_end = source.find("fn module_surface_export_origin_hints(")
        val convert = if convert_start >= 0 and convert_end > convert_start:
            source.substring(convert_start, convert_end)
        else:
            ""
        expect(convert).to_contain("type_: impl_.type_")
        expect(convert).to_contain("has_trait_: impl_.has_trait_")
        expect(convert).to_contain("trait_: impl_.trait_")
        expect(convert).to_contain("methods: methods")
        expect(convert.contains("type_params: impl_.type_params")).to_equal(false)
        expect(convert.contains("where_clause: impl_.where_clause")).to_equal(false)
        expect(convert.contains("assoc_types: impl_.assoc_types")).to_equal(false)
        expect(convert.contains("span: impl_.span")).to_equal(false)
