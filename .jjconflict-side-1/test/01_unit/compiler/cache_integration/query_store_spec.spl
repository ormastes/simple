"""
# Workspace Query DB and Query Result Manifest Specification

**Category:** Infrastructure
**Plan:** doc/03_plan/compiler/cache/c0_schema_freeze_2026-08-09.md
**Design:** doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md §14.1, §14.5, §17.4

## Overview

The mutable red/green graph is workspace-local; the ONLY thing that crosses
into a shareable tier is an (ActionDigest -> ResultManifestDigest) mapping from
a GREEN node. Query results become shareable only as CAS-backed
ResultManifests, and anything carrying session identity is refused before a
single byte is written.
"""

use std.spec.*
use compiler.driver.query_store.query_db.{
    QueryDb, QueryNode, QueryColor, ExportedActionMapping,
    query_db_new, query_db_insert, query_db_get, query_db_has, query_db_ids,
    query_db_mark_green, query_db_mark_dirty, query_db_is_green,
    query_db_dependents, query_node_new, query_node_export, query_node_is_exportable
}
use compiler.driver.query_store.query_result_manifest.{
    QueryArtifact, QueryResultStored,
    query_result_is_shareable, query_result_store, query_result_manifest_build,
    output_fingerprint_of
}
use compiler.driver.cache.action_key.{ResultKind}
use compiler.driver.cache_integration.key_wiring.{ActionRoots, action_roots_collect}
use compiler.driver.cache.cas_store.{cas_open}
use compiler.mdsoc.aop_index.pointcut_query.{PointcutQuery}
use compiler.mdsoc.aop_index.join_point_descriptor.{JoinPointDescriptor}
use compiler.mir.incremental.block_key.{BlockKey, BlockKeyMap, BlockRole}

extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_time_now_unix_micros() -> i64
extern fn rt_getpid() -> i64

fn fresh_cas() -> text:
    val root = "build/tmp/query_store_spec/{rt_getpid()}-{rt_time_now_unix_micros()}"
    rt_dir_create_all(root)
    cas_open(root)
    root

fn empty_roots() -> ActionRoots:
    val q: [PointcutQuery] = []
    val d: [JoinPointDescriptor] = []
    val m: [BlockKeyMap] = []
    action_roots_collect(q, d, m)

fn uncacheable_roots() -> ActionRoots:
    val q: [PointcutQuery] = []
    val d: [JoinPointDescriptor] = []
    val ambiguous = BlockKeyMap(
        block_ids: [0],
        keys: [BlockKey(parent_function: "app::run", origin_anchor: "b0", role: BlockRole.Entry, structural_path: "p", same_anchor_ordinal: 0)],
        ambiguous: true
    )
    action_roots_collect(q, d, [ambiguous])

# a -> b -> c  (c reads b, b reads a)
fn chain_db() -> QueryDb:
    var db = query_db_new()
    db = query_db_insert(db, query_node_new("a"))
    var b = query_node_new("b")
    b.deps = ["a"]
    db = query_db_insert(db, b)
    var c = query_node_new("c")
    c.deps = ["b"]
    db = query_db_insert(db, c)
    db = query_db_mark_green(db, "a", "ad-a", "rmd-a")
    db = query_db_mark_green(db, "b", "ad-b", "rmd-b")
    db = query_db_mark_green(db, "c", "ad-c", "rmd-c")
    db

describe "red/green propagation (§17.4)":
    it "reddens the transitive dependents of a dirtied node":
        # SABOTAGE TARGET: a propagation that stops at the first hop leaves "c"
        # green. Asserting the FAR node is red, while an unrelated green node
        # stays green, distinguishes real propagation from "mark everything".
        var db = chain_db()
        db = query_db_insert(db, query_node_new("unrelated"))
        db = query_db_mark_green(db, "unrelated", "ad-u", "rmd-u")
        db = query_db_mark_dirty(db, "a")
        expect(query_db_is_green(db, "a")).to_equal(false)
        expect(query_db_is_green(db, "b")).to_equal(false)
        expect(query_db_is_green(db, "c")).to_equal(false)
        expect(query_db_is_green(db, "unrelated")).to_equal(true)

    it "does not redden the nodes a dirtied node DEPENDS on":
        var db = chain_db()
        db = query_db_mark_dirty(db, "c")
        expect(query_db_is_green(db, "c")).to_equal(false)
        expect(query_db_is_green(db, "b")).to_equal(true)
        expect(query_db_is_green(db, "a")).to_equal(true)

    it "terminates on a cycle":
        var db = query_db_new()
        var x = query_node_new("x")
        x.deps = ["y"]
        var y = query_node_new("y")
        y.deps = ["x"]
        db = query_db_insert(db, x)
        db = query_db_insert(db, y)
        db = query_db_mark_green(db, "x", "ad-x", "rmd-x")
        db = query_db_mark_green(db, "y", "ad-y", "rmd-y")
        db = query_db_mark_dirty(db, "x")
        expect(query_db_is_green(db, "x")).to_equal(false)
        expect(query_db_is_green(db, "y")).to_equal(false)

    it "records dependents in both directions correctly":
        val db = chain_db()
        expect(query_db_dependents(db, "a")).to_equal(["b"])
        expect(query_db_dependents(db, "c").is_empty()).to_equal(true)

describe "the query graph NEVER leaves the workspace (§14.1)":
    it "exports only the two digest fields of a GREEN node":
        val db = chain_db()
        val node = query_db_get(db, "b")
        match node:
            case Some(n):
                val exported = query_node_export(n)
                match exported:
                    case Some(m):
                        expect(m.action_digest).to_equal("ad-b")
                        expect(m.result_manifest_digest).to_equal("rmd-b")
                    case nil: fail("a green node with both digests must export")
            case nil: fail("node b must exist")

    it "REFUSES to export a red node":
        # SABOTAGE TARGET: dropping the colour check publishes a mapping to a
        # result that was invalidated. Asserting the node still HOLDS both
        # digests proves the refusal is about the COLOUR, not about missing
        # data — an "empty fields" bug could not produce this pairing.
        var db = chain_db()
        db = query_db_mark_dirty(db, "b")
        val node = query_db_get(db, "b")
        match node:
            case Some(n):
                expect(n.action_digest).to_equal("ad-b")
                expect(n.result_manifest_digest).to_equal("rmd-b")
                expect(query_node_is_exportable(n)).to_equal(false)
                match query_node_export(n):
                    case Some(_m): fail("a red node must never export an action mapping")
                    case nil: expect(true).to_equal(true)
            case nil: fail("node b must exist")

    it "REFUSES to export a never-executed node":
        val n = query_node_new("fresh")
        expect(query_node_is_exportable(n)).to_equal(false)

describe "query result manifests (§14.5)":
    it "refuses session-local artifact names before writing anything":
        # SABOTAGE TARGET: each rejected class is asserted separately, and a
        # clean name is asserted to PASS, so a gate that rejects everything
        # cannot make this green.
        expect(query_result_is_shareable([QueryArtifact(name: "build/out.o", content: "x")])).to_equal(true)
        expect(query_result_is_shareable([QueryArtifact(name: "/abs/out.o", content: "x")])).to_equal(false)
        expect(query_result_is_shareable([QueryArtifact(name: "../out.o", content: "x")])).to_equal(false)
        expect(query_result_is_shareable([QueryArtifact(name: "<session:7>/out.o", content: "x")])).to_equal(false)
        expect(query_result_is_shareable([QueryArtifact(name: "<jit-addr:0x40>/out.o", content: "x")])).to_equal(false)

    it "stores a shareable result and returns a manifest digest":
        val root = fresh_cas()
        val out = query_result_store(
            root, "action-digest-1", ResultKind.MirModule,
            [QueryArtifact(name: "build/out.o", content: "object-bytes")],
            "dep-manifest", empty_roots(), "", 2
        )
        expect(out.stored).to_equal(true)
        expect(out.result_manifest_digest.is_empty()).to_equal(false)

    it "stores NOTHING for an unshareable result and says why":
        val root = fresh_cas()
        val out = query_result_store(
            root, "action-digest-2", ResultKind.MirModule,
            [QueryArtifact(name: "/abs/out.o", content: "object-bytes")],
            "dep-manifest", empty_roots(), "", 2
        )
        expect(out.stored).to_equal(false)
        expect(out.result_manifest_digest).to_equal("")
        expect(out.reason).to_equal("not shareable: session-local content")

    it "stores NOTHING for an uncacheable action and says why":
        val root = fresh_cas()
        val out = query_result_store(
            root, "action-digest-3", ResultKind.MirModule,
            [QueryArtifact(name: "build/out.o", content: "object-bytes")],
            "dep-manifest", uncacheable_roots(), "", 2
        )
        expect(out.stored).to_equal(false)
        expect(out.reason).to_equal("uncacheable: ambiguous block manifest")

    it "makes the output fingerprint ORDER-SENSITIVE":
        # Artifact order is semantic (a link input list is not a set), so this
        # must NOT be the order-independent set root used for AOP/block roots.
        expect(output_fingerprint_of(["a", "b"])).to_not_equal(output_fingerprint_of(["b", "a"]))
