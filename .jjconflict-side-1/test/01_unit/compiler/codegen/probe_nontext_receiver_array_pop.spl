# Run-path probe for the NAME-KEYED-DISPATCH-WITHOUT-RECEIVER-TYPE class.
#
# MIR method-call lowering dispatches on the method NAME only, with no
# receiver type. src/runtime/runtime_native.c (~4626) carries a shared guard
# `rt_refuse_non_text_receiver(method, receiver)` that exit(70)s with
#   "str.<m> was called on a receiver that is not text ... a code-generation
#    dispatch gap, not a program error"
# for exactly 7 names: clear, drop, pop, rev, reverse, sorted, take.
#
# Each of those names is exercised here on a NON-text receiver, one name per
# file. ONE NAME PER FILE IS LOAD-BEARING: a single exit(70) or PANIC aborts
# the process, so a combined probe would report only the first broken name and
# hide the rest.
#
# Driven as a native build by nontext_receiver_method_dispatch_class_spec.spl.

fn main():
    var a = [1, 2, 3]
    val p = a.pop()
    print("PROBE array_pop popped=")
    print(p)
    print(" END")
