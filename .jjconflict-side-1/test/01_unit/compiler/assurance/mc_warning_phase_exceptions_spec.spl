"""
## Purpose and audience
Purpose: Prove step 1 of the allocatable mission-critical migration — a
project pinned to `profile: critical` with `warning_phase: true` reports a
critical-tier violation as a WARNING (never a build-failing Deny, never
silence), and a module listed under `mc_exceptions:` is skipped WITH a
reported reason rather than silently.
Audience: compiler and tooling engineers who maintain the assurance policy.
"""
# @req: REQ-COMPILER-ASSURANCE-001 — stable requirement identity for this spec.

# Drives the REAL modules: the lint config projection
# (90.tools/lint/_LintMain/config_and_model.spl) and the exception leaf
# (00.common/assurance/mc_exceptions.spl). No replicas.

use std.spec.*
use compiler.tools.lint._LintMain.config_and_model.{
    LintConfig, LintProfile, LintLevel, profile_default_levels
}
use compiler.common.assurance.mc_exceptions.{
    McException, parse_mc_exceptions, mc_exception_reason_for,
    mc_exception_report_line
}

val MC_SDN = "lints:\n  profile: critical\n  warning_phase: true\n  mc_exceptions: \"src/lib/gc_sync_mut=outside step-1 scope, src/lib/skia=vendored bindings\"\n"

describe "allocatable mission-critical step 1: warning phase":
    it "critical tier denies raw_sffi_call when warning phase is OFF":
        step("Verify: the baseline this spec ramps down from")
        # @req: REQ-COMPILER-ASSURANCE-001
        val levels = profile_default_levels(LintProfile.Critical)
        expect(levels["raw_sffi_call"]).to_equal("deny")
        expect(levels["bare_primitive_internal"]).to_equal("warn")

    it "reports a critical-tier violation as a WARNING under warning phase":
        step("Verify: profile critical + warning_phase true -> deny becomes warn")
        # @req: REQ-COMPILER-ASSURANCE-001
        val config = LintConfig.from_sdn_string(MC_SDN)
        expect(config.error).to_equal("")
        expect(config.warning_phase).to_equal(true)
        expect(config.get_level("raw_sffi_call") == LintLevel.Warn).to_equal(true)
        expect(config.get_level("memory_safety") == LintLevel.Warn).to_equal(true)

    it "never downgrades into silence — warn stays warn, not allow":
        step("Verify: the lint floor is Warn")
        # @req: REQ-COMPILER-ASSURANCE-001
        val config = LintConfig.from_sdn_string(MC_SDN)
        expect(config.get_level("bare_primitive_internal") == LintLevel.Warn).to_equal(true)
        expect(config.get_level("silent_default") == LintLevel.Warn).to_equal(true)

    it "is a one-level transform: with warning phase off the deny is intact":
        step("Verify: same manifest minus warning_phase keeps Deny")
        # @req: REQ-COMPILER-ASSURANCE-001
        val config = LintConfig.from_sdn_string("lints:\n  profile: critical\n")
        expect(config.get_level("raw_sffi_call") == LintLevel.Deny).to_equal(true)

describe "allocatable mission-critical step 1: exceptions":
    it "parses scope=reason entries and drops unjustified ones":
        step("Verify: grammar is fail-closed")
        # @req: REQ-COMPILER-ASSURANCE-001
        val exc = parse_mc_exceptions("src/lib/skia=vendored, src/lib/js=, =no scope, junk, ./src/lib/web/=web glue")
        expect(exc.len()).to_equal(2)
        expect(exc[0].scope).to_equal("src/lib/skia")
        expect(exc[0].reason).to_equal("vendored")
        expect(exc[1].scope).to_equal("src/lib/web")

    it "matches on a path boundary, absolute or repo-relative":
        step("Verify: gc_sync_mut is excepted, gc_sync_mut_x and gc are not")
        # @req: REQ-COMPILER-ASSURANCE-001
        val exc = parse_mc_exceptions("src/lib/gc_sync_mut=outside scope")
        expect(mc_exception_reason_for(exc, "/wt/src/lib/gc_sync_mut/x.spl")).to_equal("outside scope")
        expect(mc_exception_reason_for(exc, "src/lib/gc_sync_mut/x.spl")).to_equal("outside scope")
        expect(mc_exception_reason_for(exc, "src/lib/gc_sync_mut_x/x.spl")).to_equal("")
        expect(mc_exception_reason_for(exc, "src/lib/gc/x.spl")).to_equal("")

    it "loads mc_exceptions from the manifest and reports the skip with its reason":
        step("Verify: LintConfig carries the list; the report line names file and reason")
        # @req: REQ-COMPILER-ASSURANCE-001
        val config = LintConfig.from_sdn_string(MC_SDN)
        expect(config.mc_exceptions.len()).to_equal(2)
        val reason = config.mc_exception_reason("/wt/src/lib/skia/canvas.spl")
        expect(reason).to_equal("vendored bindings")
        val line = mc_exception_report_line("/wt/src/lib/skia/canvas.spl", reason)
        expect(line.contains("src/lib/skia/canvas.spl")).to_equal(true)
        expect(line.contains("vendored bindings")).to_equal(true)
        expect(line.contains("skipped")).to_equal(true)

    it "does not except a file in scope, and child() keeps the list":
        step("Verify: compiler files stay held to the tier; inheritance preserves exceptions")
        # @req: REQ-COMPILER-ASSURANCE-001
        val config = LintConfig.from_sdn_string(MC_SDN)
        expect(config.mc_exception_reason("/wt/src/compiler/80.driver/driver.spl")).to_equal("")
        val child = config.child()
        expect(child.mc_exceptions.len()).to_equal(2)
        expect(child.warning_phase).to_equal(true)
