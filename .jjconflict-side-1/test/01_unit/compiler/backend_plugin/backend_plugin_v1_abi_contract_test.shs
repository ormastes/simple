#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
abi_dir="$repo_root/src/compiler/70.backend/backend_plugin/abi"
fixture_dir="$repo_root/test/01_unit/compiler/backend_plugin/fixtures"
tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
cc -std=c11 -Wall -Wextra -Werror -fPIC -shared -I"$abi_dir" "$fixture_dir/backend_plugin_v1_fixture.c" -o "$tmp_dir/provider.so"
cc -std=c11 -Wall -Wextra -Werror -I"$abi_dir" "$fixture_dir/backend_plugin_v1_host.c" -ldl -o "$tmp_dir/host"
"$tmp_dir/host" "$tmp_dir/provider.so"
