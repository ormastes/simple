use std.io_runtime.{file_read}

fn coverage_eval_source() -> text:
    file_read("src/compiler/10.frontend/core/interpreter/eval.spl") ?? ""

describe "Interpreter MC/DC unary-not composition":
    it "counts the operand leaves instead of treating not as an atom":
        val source = coverage_eval_source()
        expect(source).to_contain(
            "if condition_node.tag == EXPR_UNARY and condition_node.i_val == 57:")
        expect(source).to_contain(
            "return coverage_condition_leaf_count_at(")
        expect(source).to_contain(
            "condition_node.left, remaining_depth - 1)")

    it "preserves leaf probes through not in the legacy path":
        val source = coverage_eval_source()
        expect(source).to_contain(
            "val operand_value = eval_control_condition_legacy(")
        expect(source).to_contain(
            "return val_make_bool(not val_is_truthy(operand_value))")

    it "preserves the same leaf ordinal through not in vector mode":
        val source = coverage_eval_source()
        expect(source).to_contain(
            "val operand_value = eval_control_condition_at(")
        expect(source).to_contain(
            "condition_node.left, decision_id, condition_index)")

    it "keeps unary traversal bounded and allocation free":
        val source = coverage_eval_source()
        expect(source).to_contain("if remaining_depth <= 0: return 63")
        expect(source).not.to_contain("coverage_condition_leaf_ids")
