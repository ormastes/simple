use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "VHDL indexed target resolution":
    it "builds raw all-function and hardware-only indexes once":
        val source = file_read(
            "src/compiler/70.backend/backend/vhdl/vhdl_design_catalog.spl")
        expect(source).to_contain("var target_symbol_ids: Dict<text, i64> = {}")
        expect(source).to_contain("var target_match_counts: Dict<text, i64> = {}")
        expect(source).to_contain("vhdl_catalog_target_index_key(false, false, candidate.name)")
        expect(source).to_contain("vhdl_catalog_target_index_key(false, true, identity)")
        expect(source).to_contain("vhdl_catalog_target_index_key(true, false, candidate.name)")
        expect(source).to_contain("vhdl_catalog_target_index_key(true, true, identity)")

    it "uses expected constant-time lookup without per-edge sorting":
        val source = file_read(
            "src/compiler/70.backend/backend/vhdl/vhdl_design_catalog.spl")
        val resolver_start = source.index_of("fn vhdl_catalog_resolve_target")
        val marker_start = source.index_of("fn vhdl_catalog_mark_type")
        val resolver = source.substring(resolver_start, marker_start)
        expect(resolver).to_contain("vhdl_catalog_target_index_key(hardware_only, qualified, target)")
        expect(resolver).to_contain("target_match_counts[key]")
        expect(resolver).to_contain("target_symbol_ids[key]")
        expect(resolver).not.to_contain("all_functions.keys()")
        expect(resolver).not.to_contain("vhdl_catalog_sorted_symbols")
        expect(resolver).not.to_contain("for candidate_symbol")

    it "preserves ambiguity and qualified-unresolved diagnostics":
        val source = file_read(
            "src/compiler/70.backend/backend/vhdl/vhdl_design_catalog.spl")
        expect(source).to_contain("Ambiguous VHDL {target_kind} `{target}`; use a module-qualified identity")
        expect(source).to_contain("Unresolved VHDL {target_kind} `{target}`")
        expect(source).to_contain("if qualified:\n            return Err")
        expect(source).to_contain("return Ok(nil)")
