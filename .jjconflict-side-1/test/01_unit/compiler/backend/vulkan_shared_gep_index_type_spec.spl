# @cover src/compiler/70.backend/backend/vulkan_backend.spl 30%
# @tag: unit, compiler, backend, gpu, vulkan
#
# Regression for the exact defect on todo_db row 612: the Vulkan GEP lowering
# claimed to accept one-index U32/I64 GEPs, and function_uses_i64 already
# special-cased an inline I64 GEP index to raise OpCapability Int64, but the
# index check itself rejected anything that was not U32.

use compiler.backend.backend.vulkan_backend.{VulkanCodegenBackend}
use compiler.backend.backend.backend_types.{CompileError, compileoptions_default_options}
use compiler.backend.gpu_codegen_types.{GpuCodegen}
use compiler.mir.mir_data.*

fn vk_u32() -> MirType: MirType(kind: MirTypeKind.U32)
fn vk_i64() -> MirType: MirType(kind: MirTypeKind.I64)
fn vk_ptr_u32() -> MirType: MirType.ptr(vk_u32(), true)
fn vk_temp(id: i64, ty: MirType) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: ty, kind: LocalKind.Temp, is_ghost: false)
fn vk_op(id: i64) -> MirOperand: MirOperand.copy(LocalId(id: id))
fn vk_const(value: i64, ty: MirType) -> MirOperand:
    MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(value), ty))
fn vk_inst(kind: MirInstKind) -> MirInst: MirInst(kind: kind, span: nil)

fn vk_body(instructions: [MirInst], locals: [MirLocal]) -> MirBody:
    MirBody(
        name: "shared_gep_index_kernel",
        blocks: [MirBlock(id: BlockId.entry(), label: Some("entry"), instructions: instructions, terminator: MirTerminator.Ret(nil))],
        locals: locals,
        arg_count: 0,
        return_ty: MirType.unit()
    )

fn vk_compile(instructions: [MirInst], locals: [MirLocal]) -> Result<text, CompileError>:
    VulkanCodegenBackend.create_with_options([1, 3], compileoptions_default_options())
        .compile_kernel("shared_gep_index_kernel", vk_body(instructions, locals))

describe "Vulkan shared-memory GEP index typing":
    it "positive control: a U32 shared index still lowers to OpAccessChain":
        val result = vk_compile(
            [
                vk_inst(MirInstKind.GpuSharedAlloc(LocalId(id: 0), vk_u32(), 4)),
                vk_inst(MirInstKind.GetElementPtr(LocalId(id: 1), vk_op(0), [vk_const(2, vk_u32())])),
                vk_inst(MirInstKind.Store(vk_op(1), vk_const(5, vk_u32())))
            ],
            [vk_temp(0, vk_ptr_u32()), vk_temp(1, vk_ptr_u32())]
        )
        expect(result.is_ok()).to_equal(true)
        expect(result.unwrap()).to_contain("OpAccessChain")

    it "accepts an inline I64 shared index and declares the Int64 capability":
        val result = vk_compile(
            [
                vk_inst(MirInstKind.GpuSharedAlloc(LocalId(id: 0), vk_u32(), 4)),
                vk_inst(MirInstKind.GetElementPtr(LocalId(id: 1), vk_op(0), [vk_const(2, vk_i64())])),
                vk_inst(MirInstKind.Store(vk_op(1), vk_const(5, vk_u32())))
            ],
            [vk_temp(0, vk_ptr_u32()), vk_temp(1, vk_ptr_u32())]
        )
        expect(result.is_ok()).to_equal(true)
        val output = result.unwrap()
        expect(output).to_contain("OpCapability Int64")
        expect(output).to_contain("OpTypeInt 64 0")
        expect(output).to_contain("OpAccessChain")
