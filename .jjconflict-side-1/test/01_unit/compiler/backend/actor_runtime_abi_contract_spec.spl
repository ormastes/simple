use std.test.*

extern fn rt_file_read_text(path: text) -> text

describe "actor runtime ABI closure":
    it "keeps runtime, codegen, interpreter, and public hooks on canonical spawn-2 recv-0":
        val runtime_sffi = rt_file_read_text("src/compiler_rust/compiler/src/codegen/runtime_sffi.rs") ?? ""
        val actor_runtime = rt_file_read_text("src/compiler_rust/runtime/src/value/actors.rs") ?? ""
        val cranelift = rt_file_read_text("src/compiler_rust/compiler/src/codegen/instr/async_ops.rs") ?? ""
        val llvm = rt_file_read_text("src/compiler_rust/compiler/src/codegen/llvm/emitter.rs") ?? ""
        val interpreter = rt_file_read_text("src/compiler/95.interp/mir_interpreter.spl") ?? ""
        val intrinsics = rt_file_read_text("src/compiler/95.interp/mir_interp_intrinsics.spl") ?? ""
        val hooks = rt_file_read_text("src/lib/nogc_sync_mut/concurrent/actor_hooks.spl") ?? ""

        expect(runtime_sffi).to_contain("RuntimeFuncSpec::new(\"rt_actor_spawn\", &[I64, I64], &[I64])")
        expect(runtime_sffi).to_contain("RuntimeFuncSpec::new(\"rt_actor_recv\", &[], &[I64])")
        expect(runtime_sffi).to_contain("RuntimeFuncSpec::new(\"rt_actor_send_result\", &[I64, I64], &[I64])")
        expect(actor_runtime).to_contain("Option<extern \"C\" fn(RuntimeValue)>")
        expect(actor_runtime).to_contain("f(callback_ctx)")
        expect(actor_runtime.contains("as_heap_ptr() as *const u8")).to_equal(false)
        expect(cranelift).to_contain("call_runtime_2(ctx, builder, \"rt_actor_spawn\", body_ptr, ctx_val)")
        expect(llvm).to_contain("LLVM actor spawn is unsupported: outlined actor callback address is unavailable")
        expect(llvm.contains("self.call_runtime(\"rt_actor_spawn\"")).to_equal(false)
        expect(llvm).to_contain("self.call_runtime(\"rt_actor_recv\", &[])")
        expect(interpreter).to_contain("extern fn rt_actor_spawn(handler: i64, ctx: i64) -> i64")
        expect(interpreter).to_contain("extern fn rt_actor_send_result(target: i64, message: i64) -> i64")
        expect(interpreter).to_contain("extern fn rt_actor_recv() -> i64")
        expect(interpreter).to_contain("rt_actor_spawn(args[0], 0)")
        expect(interpreter).to_contain("rt_actor_send_result(args[0], args[1])")
        expect(interpreter).to_contain("case \"__simple_runtime_receive\":\n                rt_actor_recv()")
        expect(intrinsics).to_contain("extern fn rt_actor_spawn(handler: i64, ctx: i64) -> i64")
        expect(intrinsics).to_contain("extern fn rt_actor_send_result(target: i64, message: i64) -> i64")
        expect(intrinsics).to_contain("extern fn rt_actor_recv() -> i64")
        expect(hooks).to_contain("extern fn rt_actor_spawn(handler: Any, ctx: Any) -> i64")
        expect(hooks).to_contain("extern fn rt_actor_send_result(actor_id: i64, message: Any) -> i64")
        expect(hooks).to_contain("extern fn rt_actor_recv() -> Any")
        expect(hooks).to_contain("rt_actor_spawn(handler, nil)")
        expect(hooks).to_contain("rt_actor_recv()")
        expect(hooks.contains("rt_actor_recv(actor_id)")).to_equal(false)
        expect(hooks.contains("extern fn rt_actor_send(actor_id")).to_equal(false)
