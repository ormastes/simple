use std.spec.*

extern fn rt_file_read_text(path: text) -> text

describe "HIR self owner scalar metadata source contract":
    it "routes self field ownership without optional HirType dereference":
        val types = rt_file_read_text("src/compiler/20.hir/hir_lowering/types.spl") ?? ""
        # Repointed 2026-08-21: self-field owner routing moved to
        # _Expressions/expression_support.spl in 4b88aebf00b.
        val expressions = rt_file_read_text("src/compiler/20.hir/hir_lowering/_Expressions/expression_support.spl") ?? ""
        val impls = rt_file_read_text("src/compiler/20.hir/hir_lowering/_Items/trait_impl_lowering.spl") ?? ""
        # Repointed 2026-08-21: class decl lowering split out to
        # _Items/class_declaration_lowering.spl in 4b88aebf00b.
        val classes = rt_file_read_text("src/compiler/20.hir/hir_lowering/_Items/class_declaration_lowering.spl") ?? ""
        # Repointed 2026-08-21: bootstrap impl lowering moved to
        # _Items/module_declarations_bootstrap.spl in 4b88aebf00b.
        val modules = rt_file_read_text("src/compiler/20.hir/hir_lowering/_Items/module_declarations_bootstrap.spl") ?? ""

        expect(types).to_contain("current_method_self_symbol_id: i64")
        expect(types).to_contain("current_method_self_symbol_id: -1")
        expect(expressions).to_contain("if self.current_method_self_symbol_id >= 0:")
        expect(expressions).to_contain("field_type_for_owner_raw(self.current_method_self_symbol_id, field_name)")
        expect(expressions).to_not_contain("_hir_named_type_symbol(self_type)")
        expect(impls).to_contain("previous_self_symbol_id")
        expect(classes).to_contain("previous_self_symbol_id")
        expect(modules).to_contain("previous_impl_self_symbol_id")
