use std.spec.{describe, it, expect}
use compiler.driver.compilability.{CompilabilityAnalyzer, CompilabilityMode}

describe "compilability execution mode":
    it "keeps interpolated strings conservative for hybrid JIT":
        var analyzer = CompilabilityAnalyzer.create_for_mode(CompilabilityMode.HybridJit)
        val status = analyzer.analyze_function("render", ["string_interpolation"])

        expect(status.is_compilable()).to_equal(false)

    it "retains native interpolation lowering for standalone AOT":
        var analyzer = CompilabilityAnalyzer.create_for_mode(CompilabilityMode.AotNative)
        val status = analyzer.analyze_function("render", ["string_interpolation"])

        expect(status.is_compilable()).to_equal(true)

    it "does not weaken genuinely unsupported AOT constructs":
        var analyzer = CompilabilityAnalyzer.create_for_mode(CompilabilityMode.AotNative)
        val status = analyzer.analyze_function("render", ["string_interpolation", "try_operator"])

        expect(status.is_compilable()).to_equal(false)
