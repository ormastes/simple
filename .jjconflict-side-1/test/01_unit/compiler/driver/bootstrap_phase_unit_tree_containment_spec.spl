use std.io_runtime.{file_read}

use std.spec.step

describe "bootstrap phase compiler-unit containment":
    it "lists first and terminalizes every compiler spec independently":
        step("prevents an aggregate timeout from hiding the unvisited suffix")
        val source = file_read("scripts/bootstrap/bootstrap-phase-verification.shs")
        val start = source.find("run_compiler_unit_tests() {") ?? -1
        val finish = source.find("# Normal is fail-fast", start) ?? -1
        val body = if start >= 0 and finish > start: source.substring(start, finish) else: ""
        expect(source).to_contain("spec_timeout_seconds=")
        expect(source).to_contain("BOOTSTRAP_VERIFY_SPEC_TIMEOUT_SECONDS:-120")
        expect(body).to_contain("LC_ALL=C sort >\"$manifest\"")
        expect(body).to_contain("done <\"$manifest\"")
        expect(body).to_contain("run-process-group-timeout.shs")
        expect(body).to_contain("printf 'END %s result=%s status=%s\\n'")
        expect(body).to_contain("printf '%s\\t%s\\t%s\\n'")
        expect(source.contains("run_matrix_task compiler_unit_tests \"$compiler_snapshot\" test test/01_unit/compiler")).to_be(false)
