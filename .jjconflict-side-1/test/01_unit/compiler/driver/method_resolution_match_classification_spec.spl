use compiler.hir.hir_types.{MethodResolution, SymbolId}

fn classify_for_test(resolution: MethodResolution) -> text:
    match resolution:
        case Unresolved: "unresolved"
        case FreeFunction(_): "free"
        case InstanceMethod(_, _): "instance"
        case StaticMethod(_, _): "static"
        case TraitMethod(_, _): "trait"

describe "MethodResolution exhaustive classification":
    it "classifies the payload-free unresolved variant":
        expect(classify_for_test(MethodResolution.Unresolved)).to_equal("unresolved")

    it "classifies the one-payload free-function variant":
        expect(classify_for_test(MethodResolution.FreeFunction(
            SymbolId(id: 3)))).to_equal("free")

    it "classifies every two-payload owner variant independently":
        val owner = SymbolId(id: 5)
        val method = SymbolId(id: 7)
        expect(classify_for_test(MethodResolution.InstanceMethod(
            owner, method))).to_equal("instance")
        expect(classify_for_test(MethodResolution.StaticMethod(
            owner, method))).to_equal("static")
        expect(classify_for_test(MethodResolution.TraitMethod(
            owner, method))).to_equal("trait")

