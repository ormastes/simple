"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/driver/backend_result_payload_identity_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/backend_result_payload_identity_spec.md
# doc-path: doc/03_plan/sys_test/backend_result_payload_identity_spec.md
# doc-path: doc/04_architecture/backend_result_payload_identity_spec.md
# doc-path: doc/05_design/backend_result_payload_identity_spec_oracles.md
# @manual: primary

"""
# Backend result payload identity

The driver facade must expose backend result variants with the payload types
owned by `compiler.backend.backend_types`. Canonical configuration SDN values
remain a distinct type even though both domains represent SDN data.
"""
use std.spec.step

use std.spec.step

use std.spec.*
use compiler.driver.driver_types.{BackendResult}
use compiler.backend.backend_types.{BackendSdnValue, SdnValueKind, CompiledUnit}
use std.common.sdn.value.{SdnValue}


describe "driver backend result payload identity":
    # @manual scenario evidence
    it "keeps backend SDN payloads distinct from canonical configuration SDN":
        # @req REQ-SSPEC-COMPILER
        step("keeps backend SDN payloads distinct from canonical configuration SDN")
        val backend_value = BackendSdnValue.int(7)
        val result = BackendResult.SdnData(backend_value)
        match result:
            case BackendResult.SdnData(data):
                match data.kind:
                    case SdnValueKind.Int(value): expect(value).to_equal(7)
                    case _: expect("backend-int").to_equal("unexpected-kind")
            case _: expect("sdn-data").to_equal("unexpected-result")

        val config_value = SdnValue.Int(9)
        match config_value:
            case SdnValue.Int(value): expect(value).to_equal(9)
            case _: expect("config-int").to_equal("unexpected-kind")

    it "keeps compiled-unit payloads bound to the backend owner":
        # @req REQ-SSPEC-COMPILER
        step("keeps compiled-unit payloads bound to the backend owner")
        val unit = CompiledUnit(
            name: "identity-probe",
            code: [],
            symbols: {},
            entry_point: nil,
            relocations: []
        )
        val result = BackendResult.CompiledUnit(unit)
        match result:
            case BackendResult.CompiledUnit(compiled):
                expect(compiled.name).to_equal("identity-probe")
                expect(compiled.code.len()).to_equal(0)
            case _: expect("compiled-unit").to_equal("unexpected-result")
