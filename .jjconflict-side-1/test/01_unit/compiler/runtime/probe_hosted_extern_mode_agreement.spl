# Run-path probe: hosted optional-backend externs must answer identically in
# every execution mode.
#
# Companion to `hosted_extern_mode_agreement_class_spec.spl`. This file is NOT a
# spec — it is executed as a SUBPROCESS by that spec, once per
# SIMPLE_EXECUTION_MODE, so that a mode-dependent answer can actually be
# observed. A spec body always runs on one engine and could never see the split.
#
# It prints one `MODE_PROBE <name>=<value>` line per extern. The spec compares
# the lines ACROSS modes; this file deliberately asserts nothing about the
# absolute values, because "no Vulkan installed" (0) and "three devices" (3) are
# both legitimate answers for a host. What is never legitimate is two engines
# disagreeing about the same host.

extern fn rt_vulkan_is_available() -> i64
extern fn rt_vulkan_device_count() -> i64
extern fn rt_cuda_available() -> i64
extern fn rt_cuda_device_count() -> i64

fn emit(name: text, v: i64):
    print("MODE_PROBE ")
    print(name)
    print("=")
    print(v.to_text())
    print("\n")

fn main():
    emit("vulkan_is_available", rt_vulkan_is_available())
    emit("vulkan_device_count", rt_vulkan_device_count())
    emit("cuda_available", rt_cuda_available())
    emit("cuda_device_count", rt_cuda_device_count())
    print("MODE_PROBE DONE\n")
