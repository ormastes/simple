use std.spec.*
use compiler.semantics.lint.silent_default.{
    check_silent_default, check_silent_default_lines}

describe "silent default canonical line snapshot":
    it "matches all compatibility finding fields and order":
        val source = "@mission_critical\nfn scan():\n    val item = resolve(key).unwrap_or(0)\n    val result = risky().ok()\nfn success() -> bool:\n    self.total_failed == 0\n"
        val from_source = check_silent_default(source, "src/app/sample.spl")
        val from_lines = check_silent_default_lines(
            source.split("\n"), "src/app/sample.spl")
        expect(from_lines.len()).to_equal(from_source.len())
        expect(from_lines.len()).to_equal(3)
        var index = 0
        while index < from_source.len():
            expect(from_lines[index].code).to_equal(from_source[index].code)
            expect(from_lines[index].severity).to_equal(from_source[index].severity)
            expect(from_lines[index].name).to_equal(from_source[index].name)
            expect(from_lines[index].line_num).to_equal(from_source[index].line_num)
            expect(from_lines[index].message).to_equal(from_source[index].message)
            expect(from_lines[index].note).to_equal(from_source[index].note)
            index = index + 1

    it "keeps vendored and node_modules sources excluded":
        val lines = [
            "@mission_critical", "fn scan():",
            "    val item = resolve(key).unwrap_or(0)"
        ]
        expect(check_silent_default_lines(
            lines, "src/runtime/vendor/sample.spl").len()).to_equal(0)
        expect(check_silent_default_lines(
            lines, "pkg/node_modules/sample.spl").len()).to_equal(0)
