"""Constructed sabotage and structural inventory for the pre-MIR facet seal."""

use std.spec.*
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_definitions.*
use compiler.hir.hir_types.*
use compiler.semantics.resolve.{resolve_methods}
use compiler.semantics.facet_resolution.{FACET_EXPRESSION_OWNER_INVENTORY}
use common.facet_abi.{FacetInterfaceId, ConcreteTypeId}

fn sabotage_leaf(span: Span) -> HirExpr:
    val scalar = HirType(kind: HirTypeKind.Int(64, true), span: span)
    val receiver = HirExpr(
        kind: HirExprKind.IntLit(7, nil), has_type_: true, type_: scalar, span: span)
    HirExpr(
        kind: HirExprKind.FacetAcquire(
            receiver, scalar, FacetInterfaceId(value: "!unsealed"),
            Some(ConcreteTypeId(value: "!unsealed")),
            HirFacetAcquireMode.LoadRequired),
        has_type_: false, type_: scalar, span: span)

fn sabotage_nested(span: Span) -> HirExpr:
    val scalar = HirType(kind: HirTypeKind.Int(64, true), span: span)
    val leaf = sabotage_leaf(span)
    val branch = HirExpr(
        kind: HirExprKind.If(
            HirExpr(kind: HirExprKind.BoolLit(true), has_type_: true,
                type_: HirType(kind: HirTypeKind.Bool, span: span), span: span),
            HirBlock(stmts: [], has: true, value: leaf, span: span), nil),
        has_type_: false, type_: scalar, span: span)
    val closure = HirExpr(
        kind: HirExprKind.Lambda([], branch, []),
        has_type_: false, type_: scalar, span: span)
    HirExpr(
        kind: HirExprKind.Call(
            HirExpr(kind: HirExprKind.UnitLit, has_type_: false, type_: scalar, span: span),
            [HirCallArg(has_name: false, name: "", value: closure, span: span)], []),
        has_type_: false, type_: scalar, span: span)

describe "facet acquisition expression seal guard":
    it "rejects a sentinel hidden in an argument closure branch":
        val parsed = parse_full_frontend(
            "fn victim() -> i64: 0\n", "facet_sabotage.spl", "facet_sabotage",
            Logger(level: 0))
        var lowering = HirLowering.with_filename("facet_sabotage.spl")
        var module = lowering.lower_module(parsed)
        for symbol in module.functions.keys():
            var function = module.functions[symbol]
            function.body = HirBlock(
                stmts: [HirStmt(kind: HirStmtKind.Expr(sabotage_nested(function.span)),
                    span: function.span)],
                has: false, value: sabotage_leaf(function.span), span: function.span)
            module.functions[symbol] = function
        val (resolved, errors) = resolve_methods(module, nil)
        expect(errors.len()).to_be_greater_than(0)
        expect(errors.map(|error| error.message).join("\n")).to_contain("E-FACET004")
        expect(resolved.name).to_equal(module.name)

    it "keeps an explicit exhaustive inventory of expression-bearing owners":
        expect(FACET_EXPRESSION_OWNER_INVENTORY.len()).to_equal(15)
        expect(FACET_EXPRESSION_OWNER_INVENTORY).to_contain("function.params.default")
        expect(FACET_EXPRESSION_OWNER_INVENTORY).to_contain("match.pattern")
        expect(FACET_EXPRESSION_OWNER_INVENTORY).to_contain("inline_asm.operands")
