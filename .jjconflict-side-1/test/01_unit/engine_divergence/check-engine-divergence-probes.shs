#!/bin/sh
# Engine-crossing divergence guard (interpreter vs JIT).
#
# WHY THIS IS NOT A SPEC: `bin/simple test` is the tree-walk INTERPRETER, while
# `bin/simple run` is the Cranelift JIT. A spec body therefore cannot observe a
# JIT-only defect at all -- every row this guard covers is an ENGINE-DIVERGENCE
# row, so the only instrument that can see it is a subprocess probe that runs
# the same source under `SIMPLE_EXECUTION_MODE=interpreter` and `=jit` and
# diffs the two. Probe runs are also ~50x cheaper than the spec runner, whose
# own 120s per-file budget times out on the JS-engine suite for reasons
# unrelated to any defect here.
#
# Covers the following bug rows (see doc/08_tracking/bug/):
#   alias_value_semantics_probe   -> struct_field_aliases_under_jit_2026-08-08
#                                    jit_class_mutation_drop_characterization_2026-07-04
#   f64_call_result_probe         -> f64_self_hosted_call_result_codegen_2026-06-21
#   if_expr_dead_branch_probe     -> if_expression_dead_branch_binds_empty_list_2026-08-06
#   js_engine_assign_dispatch     -> stage4_seed_interpreter_statement_dispatch_regression_2026-08-16
#   boxed_int_61bit_probe         -> the 61-bit boxed-int truncation family
#                                    (LEGACY CONTROL: expected to diverge, but it
#                                     is a DEFECT, so it stops diverging the moment
#                                     the defect is fixed. It is now advisory only;
#                                     see mode_switch_control_probe below.)
#
# CONTROL (synthetic, defect-free): mode_switch_control_probe references an
# unresolvable external symbol. Only the Cranelift path emits `[jit-fallback]`
# for that, so the two engines are distinguishable by construction and the
# control cannot "expire" by someone fixing a bug. This replaces the old
# arrangement where the positive control WAS a live defect -- see
# doc/08_tracking/bug/engine_divergence_guard_control_depends_on_fixed_defect_2026-08-17.md
#
# BINARY SELECTION AND STALENESS (fail-closed):
#   The compiler under test is `${SIMPLE_BIN:-$ROOT/bin/simple}`. If that binary
#   predates any engine source it claims to be probing (src/compiler_rust,
#   src/runtime), the run CANNOT report PASS: it reports
#   `ERROR — nothing was checked` (exit 2), because a green produced by a binary
#   older than the code is a green by construction. A FAIL is still reported as
#   FAIL -- an observed divergence is real evidence on any binary. See
#   doc/08_tracking/bug/engine_divergence_guard_hardcodes_stale_seed_2026-08-17.md
#
# Env vars must be passed with `env VAR=... bin/simple ...` directly:
# scripts/resource/test-slot.shs does NOT propagate env to the child and has
# produced a false green here before.
#
# Verdict is the LAST line of stdout:
#   PASS  -- <n> probe(s) checked, ...        exit 0
#   FAIL  -- ...                             exit 1
#   ERROR -- nothing was checked             exit 2   (never a pass)

set -u

ROOT=$(cd "$(dirname "$0")/../../.." && pwd)
SIMPLE="${SIMPLE_BIN:-$ROOT/bin/simple}"
DIR="$ROOT/test/01_unit/engine_divergence/probes"
CHECKED=0
FAILED=""
MODE_SWITCH_LIVE=0
STALE=""

if [ ! -x "$SIMPLE" ]; then
    echo "ERROR — nothing was checked (no $SIMPLE)"
    exit 2
fi

# Staleness: engine sources newer than the binary mean this binary cannot speak
# for the tree. Recorded here, enforced at verdict time (never upgrades a FAIL).
for _d in "$ROOT/src/compiler_rust" "$ROOT/src/runtime"; do
    [ -d "$_d" ] || continue
    _n=$(find "$_d" -type f \( -name '*.rs' -o -name '*.c' -o -name '*.h' \) \
        -newer "$SIMPLE" -print 2>/dev/null | wc -l)
    [ "$_n" -gt 0 ] && STALE="$STALE $_d($_n)"
done

# Run one probe under one mode; echo only the probe's marker lines.
run_probe() {
    _file="$1"
    _mode="$2"
    # rc is read on its own line, never through a pipe.
    _out=$(timeout 300 env SIMPLE_EXECUTION_MODE="$_mode" "$SIMPLE" run "$_file" 2>/dev/null)
    _rc=$?
    if [ "$_rc" = 137 ] || [ "$_rc" = 143 ] || [ "$_rc" = 144 ]; then
        # earlyoom kills `simple` first on this host. Not a failure: unverified.
        echo "__OOM__"
        return 0
    fi
    echo "$_out" | grep -E '^[A-Z][0-9A-Za-z_]*=' | sort
}

# expect_same <probe> <expected-marker-lines>
# Asserts both engines agree AND that they agree on the CORRECT value.
expect_same() {
    _name="$1"
    _expected="$2"
    _f="$DIR/$_name.spl"
    if [ ! -f "$_f" ]; then
        FAILED="$FAILED $_name(missing)"
        return
    fi
    _i=$(run_probe "$_f" interpreter)
    _j=$(run_probe "$_f" jit)
    CHECKED=$((CHECKED + 1))
    case "$_i$_j" in
        *__OOM__*)
            echo "  $_name: SKIP (earlyoom, unverified)"
            CHECKED=$((CHECKED - 1))
            return
            ;;
    esac
    if [ "$_i" != "$_j" ]; then
        echo "  $_name: DIVERGED interpreter/jit"
        echo "$_i" | sed 's/^/    i: /'
        echo "$_j" | sed 's/^/    j: /'
        FAILED="$FAILED $_name(diverged)"
        return
    fi
    if [ "$_i" != "$_expected" ]; then
        echo "  $_name: engines AGREE but value is WRONG"
        echo "$_i" | sed 's/^/    got:  /'
        echo "$_expected" | sed 's/^/    want: /'
        FAILED="$FAILED $_name(wrong)"
        return
    fi
    echo "  $_name: OK (both engines, correct values)"
}

# expect_mode_switch_live <probe> -- the SYNTHETIC control. The probe calls an
# unresolvable external symbol; only the Cranelift path reports `[jit-fallback]`
# for that, so the marker appears under =jit and not under =interpreter. It
# depends on no defect and therefore cannot expire when the tree improves.
expect_mode_switch_live() {
    _name="$1"
    _f="$DIR/$_name.spl"
    if [ ! -f "$_f" ]; then
        FAILED="$FAILED $_name(missing)"
        return
    fi
    _ie=$(timeout 300 env SIMPLE_EXECUTION_MODE=interpreter "$SIMPLE" run "$_f" 2>&1)
    _je=$(timeout 300 env SIMPLE_EXECUTION_MODE=jit "$SIMPLE" run "$_f" 2>&1)
    CHECKED=$((CHECKED + 1))
    _ihas=$(echo "$_ie" | grep -c 'jit-fallback')
    _jhas=$(echo "$_je" | grep -c 'jit-fallback')
    if [ "$_jhas" -eq 0 ] || [ "$_ihas" -ne 0 ]; then
        echo "  $_name: CONTROL BROKEN — the SIMPLE_EXECUTION_MODE switch is not"
        echo "    taking effect (jit marker seen: jit=$_jhas interpreter=$_ihas), so no"
        echo "    other result in this file is trustworthy."
        FAILED="$FAILED $_name(control-broken)"
        return
    fi
    MODE_SWITCH_LIVE=1
    echo "  $_name: OK (synthetic control — mode switch is live)"
}

# expect_diverge <probe> -- LEGACY defect-based control, advisory. If it stops
# diverging the defect behind it was fixed; that is good news, not a broken
# harness, so it is reported as RETIRED provided the synthetic control above
# proved the mode switch live. If the synthetic control did NOT run or failed,
# agreement here is still a FAIL.
expect_diverge() {
    _name="$1"
    _f="$DIR/$_name.spl"
    if [ ! -f "$_f" ]; then
        FAILED="$FAILED $_name(missing)"
        return
    fi
    _i=$(run_probe "$_f" interpreter)
    _j=$(run_probe "$_f" jit)
    CHECKED=$((CHECKED + 1))
    case "$_i$_j" in
        *__OOM__*)
            echo "  $_name: SKIP (earlyoom, unverified)"
            CHECKED=$((CHECKED - 1))
            return
            ;;
    esac
    if [ "$_i" = "$_j" ]; then
        if [ "$MODE_SWITCH_LIVE" = "1" ]; then
            echo "  $_name: CONTROL RETIRED — engines agree, i.e. the defect this"
            echo "    legacy control relied on (61-bit boxed-int truncation, fixed by"
            echo "    610ce80229e) is gone. Mode-switch liveness is asserted by"
            echo "    mode_switch_control_probe, so this is not a failure. Drop this"
            echo "    probe from the roster."
            return
        fi
        echo "  $_name: CONTROL BROKEN — engines agree and the synthetic control did"
        echo "    not establish that the mode switch is live; no other result in this"
        echo "    file is trustworthy."
        FAILED="$FAILED $_name(control-broken)"
        return
    fi
    echo "  $_name: OK (legacy control still diverges — defect not yet fixed)"
}

echo "engine-divergence probes (binary: $(readlink -f "$SIMPLE"))"

# Synthetic control runs FIRST: everything below is only trustworthy if the
# mode switch is live.
expect_mode_switch_live mode_switch_control_probe

# struct = value semantics, class = identity semantics, under BOTH engines.
expect_same alias_value_semantics_probe \
"A_class_in_array=777
B_struct_from_field=0
C_struct_local_copy=0
D_struct_in_array=0"

expect_same f64_call_result_probe \
"F1=21.5
F2=43.0
F3=21.5
F4=21.5"

expect_same if_expr_dead_branch_probe \
"I1_len=3
I2_len=3
I3_len=3"

expect_same js_engine_assign_dispatch_probe \
"J1_for_accum=num:3.0
J2_nested_obj=num:42.0
J3_simple_assign=num:7.0
J4_typeof_undef=str:undefined"

# LEGACY CONTROL — advisory (61-bit boxed-int truncation under JIT).
expect_diverge boxed_int_61bit_probe

if [ "$CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked"
    exit 2
fi

if [ -n "$FAILED" ]; then
    echo "FAIL — $CHECKED probe(s) checked, offending:$FAILED"
    exit 1
fi

if [ -n "$STALE" ]; then
    echo "ERROR — nothing was checked: $(readlink -f "$SIMPLE") predates engine"
    echo "  source newer than it:$STALE — a green from a binary older than the code"
    echo "  is a green by construction. Rebuild/redeploy, or point SIMPLE_BIN at a"
    echo "  binary built from this tree, and re-run."
    exit 2
fi

echo "PASS — $CHECKED probe(s) checked across 2 engine(s) (interpreter, jit), 0 divergences"
exit 0
