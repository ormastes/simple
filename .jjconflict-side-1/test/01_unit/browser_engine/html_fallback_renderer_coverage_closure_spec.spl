# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-BROWSER_ENGINE
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: Prove that counting and glyph helpers (closure).
Audience: compiler and tooling engineers who maintain this spec.
"""
use std.spec.step

# @req: REQ-BROWSER-ENGINE-HTML-FALLBACK-RENDERER-COVERAGE-CLOSURE-SPEC-SPL-001 — stable requirement identity for this spec.
# @cover src/lib/gc_async_mut/gpu/browser_engine/html_fallback_renderer.spl 60%
"""
# HTML Fallback Renderer — Coverage Closure

`html_fallback_renderer.spl` had zero test/ references before this spec.
This spec closes its pure helpers (div counting, glyph advance, quoted-string
stripping, ellipsis, wrap decisions, line wrapping, tag/attr scanning, body
style defaults) and smoke-tests the pixel-producing entry point.
"""

use std.spec.step

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.browser_engine.html_fallback_renderer.{
    br_apply_text_overflow_ellipsis,
    br_body_font_size_px,
    br_body_margin_px,
    br_char_advance_px,
    br_count_fallback_divs,
    br_div_direct_text,
    br_div_fallback_text,
    br_fallback_wrap_lines,
    br_first_span_text_before_div_close,
    br_first_tag_attr_value,
    br_render_simple_block_fallback_pixels,
    br_should_wrap_text,
    br_strip_css_quoted_string,
}

describe "counting and glyph helpers (closure)":
    # @manual scenario evidence
    it "counts <div occurrences and returns 0 when absent":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("counts <div occurrences and returns 0 when absent")
        step("Verify: counts <div occurrences and returns 0 when absent")
        # @req: REQ-BROWSER-ENGINE-HTML-FALLBACK-RENDERER-COVERAGE-CLOSURE-SPEC-SPL-001
        expect(br_count_fallback_divs("<div><div id=x></div></div>")).to_equal(2)
        expect(br_count_fallback_divs("<span></span>")).to_equal(0)

    it "uses a narrower advance for tiny font sizes":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("uses a narrower advance for tiny font sizes")
        step("Verify: uses a narrower advance for tiny font sizes")
        expect(br_char_advance_px(8)).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(br_char_advance_px(16)).to_equal(8)  # oracle: 8 — named expected value from the requirement

describe "br_strip_css_quoted_string (closure)":
    it "strips matching double and single quotes":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("strips matching double and single quotes")
        step("Verify: strips matching double and single quotes")
        expect(br_strip_css_quoted_string("\"hi\"")).to_equal("hi")
        expect(br_strip_css_quoted_string("'hi'")).to_equal("hi")

    it "returns empty for unquoted or too-short values":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("returns empty for unquoted or too-short values")
        step("Verify: returns empty for unquoted or too-short values")
        expect(br_strip_css_quoted_string("hi")).to_equal("")
        expect(br_strip_css_quoted_string("'")).to_equal("")

describe "ellipsis and wrapping (closure)":
    it "truncates overflowing text with an ellipsis":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("truncates overflowing text with an ellipsis")
        step("Verify: truncates overflowing text with an ellipsis")
        expect(br_apply_text_overflow_ellipsis("abcdefghij", 40, 16)).to_equal("ab...")

    it "returns bare ellipsis for very narrow blocks and passes short text through":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("returns bare ellipsis for very narrow blocks and passes short text through")
        step("Verify: returns bare ellipsis for very narrow blocks and passes short text through")
        expect(br_apply_text_overflow_ellipsis("abcdef", 10, 16)).to_equal("...")
        expect(br_apply_text_overflow_ellipsis("ab", 100, 16)).to_equal("ab")

    it "wraps only under word-break/overflow-wrap styles":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("wraps only under word-break/overflow-wrap styles")
        step("Verify: wraps only under word-break/overflow-wrap styles")
        expect(br_should_wrap_text("word-break: break-all")).to_equal(true)
        expect(br_should_wrap_text("overflow-wrap: break-word")).to_equal(true)
        expect(br_should_wrap_text("color: red")).to_equal(false)

    it "splits long text into fixed-width lines and leaves short text whole":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("splits long text into fixed-width lines and leaves short text whole")
        step("Verify: splits long text into fixed-width lines and leaves short text whole")
        val lines = br_fallback_wrap_lines("abcdefghij", 40, 16)
        expect(lines.len()).to_equal(2)
        expect(lines[0]).to_equal("abcde")
        expect(lines[1]).to_equal("fghij")
        expect(br_fallback_wrap_lines("ab", 40, 16).len()).to_equal(1)
        expect(br_fallback_wrap_lines("abcdef", 0, 16).len()).to_equal(1)

describe "tag and div text scanning (closure)":
    it "reads the first tag's attribute value, empty when tag or attr missing":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("reads the first tag's attribute value, empty when tag or attr missing")
        step("Verify: reads the first tag's attribute value, empty when tag or attr missing")
        expect(br_first_tag_attr_value("<body style=\"margin:0\">", "body", "style")).to_equal("margin:0")
        expect(br_first_tag_attr_value("<div></div>", "body", "style")).to_equal("")
        expect(br_first_tag_attr_value("<body", "body", "style")).to_equal("")

    it "extracts direct div text only when no nested markup precedes </div>":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("extracts direct div text only when no nested markup precedes </div>")
        step("Verify: extracts direct div text only when no nested markup precedes </div>")
        val html = "<div> hello </div>"
        expect(br_div_direct_text(html, 5)).to_equal("hello")
        expect(br_div_direct_text("<div><span>x</span></div>", 5)).to_equal("")
        expect(br_div_direct_text("<div>never closed", 5)).to_equal("")

    it "falls back to the first span's text inside the div":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("falls back to the first span's text inside the div")
        step("Verify: falls back to the first span's text inside the div")
        val html = "<div><span>inner</span></div>"
        expect(br_div_fallback_text(html, 5)).to_equal("inner")
        expect(br_first_span_text_before_div_close(html, 5)).to_equal("inner")
        expect(br_first_span_text_before_div_close("<div>plain</div>", 5)).to_equal("")

describe "body style defaults (closure)":
    it "uses inline body style and CSS defaults":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("uses inline body style and CSS defaults")
        step("Verify: uses inline body style and CSS defaults")
        expect(br_body_margin_px("<body style=\"margin:4px\">x</body>")).to_equal(4)
        expect(br_body_margin_px("<body>x</body>")).to_equal(8)
        expect(br_body_margin_px("<body style=\"margin:-3px\">x</body>")).to_equal(0)
        expect(br_body_font_size_px("<body style=\"font-size:20px\">x</body>")).to_equal(20)
        expect(br_body_font_size_px("<body>x</body>")).to_equal(16)

describe "br_render_simple_block_fallback_pixels (closure smoke)":
    it "produces a width*height pixel buffer for simple block markup":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("produces a width*height pixel buffer for simple block markup")
        step("Verify: produces a width*height pixel buffer for simple block markup")
        val px = br_render_simple_block_fallback_pixels("<body><div>hi</div></body>", 16, 8)
        expect(px.len()).to_equal(128)

# --- Coverage-closure wave 2 (2026-08-15): renderer paths + span cascades ----

use std.gc_async_mut.gpu.browser_engine.html_fallback_renderer.{
    br_body_background_argb_or_default,
    br_pseudo_content_text,
    br_first_span_style_before_div_close,
    br_span_descendant_style,
    br_first_span_bounds_before_div_close,
}

fn _fb_css(body: text) -> text:
    "<style>" + body + "</style>"

fn _fb_rule(selector: text, decls: text) -> text:
    selector + " " + 123.chr() + " " + decls + " " + 125.chr() + " "

describe "br_render_simple_block_fallback_pixels branch paths (wave 2 closure)":
    it "returns early on a div tag that never closes its angle bracket":
        val px = br_render_simple_block_fallback_pixels("<body><div>a</div><div", 8, 8)
        expect(px.len()).to_equal(64)

    it "paints a filled block and wraps text under word-break:break-all":
        val html = "<body><div style=\"background-color:#ff0000;width:40px;word-break: break-all\">abcdefghij</div></body>"
        val px = br_render_simple_block_fallback_pixels(html, 64, 64)
        expect(px.len()).to_equal(4096)
        # the wrap path produced two text lines, so some non-background pixel exists
        var found = false
        var i = 0
        while i < px.len():
            if px[i] != 0xFFFFFFFFu32 and px[i] != 0xFFFF0000u32:
                found = true
            i = i + 1
        expect(found).to_equal(true)

    it "draws the ellipsis-truncated single line under text-overflow:ellipsis":
        val html = "<body><div style=\"width:40px;text-overflow:ellipsis\">abcdefghij</div></body>"
        val px = br_render_simple_block_fallback_pixels(html, 64, 32)
        expect(px.len()).to_equal(2048)

describe "br_pseudo_content_text (wave 2 closure)":
    it "merges tag, class, tag.class, and #id ::before rules with the id rule last":
        val css = _fb_css(
            _fb_rule("div::before", "content: \"T\"") +
            _fb_rule(".c::before", "content: \"C\"") +
            _fb_rule("div.c::before", "content: \"TC\"") +
            _fb_rule("#i::before", "content: \"ID\""))
        val html = css + "<div class=\"c\" id=\"i\">x</div>"
        expect(br_pseudo_content_text(html, "div", "c", "i", "before")).to_equal("ID")

    it "returns empty when content is missing or none":
        val css = _fb_css(_fb_rule("div::after", "content: none"))
        expect(br_pseudo_content_text(css + "<div>x</div>", "div", "", "", "after")).to_equal("")
        expect(br_pseudo_content_text("<div>x</div>", "div", "", "", "before")).to_equal("")

describe "wrap and body background residuals (wave 2 closure)":
    it "keeps the trailing partial line when the text is not an exact multiple":
        val lines = br_fallback_wrap_lines("abcdefg", 40, 16)
        expect(lines.len()).to_equal(2)
        expect(lines[1]).to_equal("fg")

    it "reads an authored body background and falls back otherwise":
        expect(br_body_background_argb_or_default("<body style=\"background:#102030\">x</body>", 0u32)).to_equal(0xFF102030u32)
        expect(br_body_background_argb_or_default("<body>x</body>", 7u32)).to_equal(7u32)

describe "first-span style cascade before the div close (wave 2 closure)":
    it "merges inline, tag, class, id, and descendant span rules":
        val css = _fb_css(
            _fb_rule("span", "color: red") +
            _fb_rule(".s", "font-size: 12px") +
            _fb_rule("span.s", "letter-spacing: 1px") +
            _fb_rule("#i", "font-weight: bold") +
            _fb_rule("span#i", "line-height: 14px") +
            _fb_rule("div span", "word-spacing: 2px") +
            _fb_rule("div > span", "text-indent: 3px") +
            _fb_rule(".p span", "margin: 1px") +
            _fb_rule("div.p span", "padding: 1px") +
            _fb_rule(".p > span", "border-width: 1px") +
            _fb_rule("div.p > span", "outline-width: 1px") +
            _fb_rule("#pid span", "min-width: 5px") +
            _fb_rule("div#pid span", "max-width: 50px") +
            _fb_rule("#pid > span", "top: 1px") +
            _fb_rule("div#pid > span", "left: 1px"))
        val div_tag = "<div class=\"p\" id=\"pid\">"
        val html = css + div_tag + "<span style=\"color:blue\" class=\"s\" id=\"i\">t</span></div>"
        val content_start = css.len() + div_tag.len()
        val style = br_first_span_style_before_div_close(html, content_start, "div class=\"p\" id=\"pid\"")
        expect(style.contains("color:blue")).to_equal(true)
        expect(style.contains("font-size: 12px")).to_equal(true)
        expect(style.contains("word-spacing: 2px")).to_equal(true)
        val desc = br_span_descendant_style(html, "div class=\"p\" id=\"pid\"")
        expect(desc.contains("min-width: 5px")).to_equal(true)
        expect(desc.contains("margin: 1px")).to_equal(true)

    it "returns empty when no span exists before the div close":
        expect(br_first_span_style_before_div_close("<div>plain</div>", 5, "div")).to_equal("")

describe "br_first_span_bounds_before_div_close (wave 2 closure)":
    it "reports sentinel bounds for missing, unterminated, and unclosed spans":
        val (a1, b1, c1) = br_first_span_bounds_before_div_close("<div>plain</div>", 5)
        expect(a1).to_equal(-1)
        val (a2, b2, c2) = br_first_span_bounds_before_div_close("<div><span x", 5)
        expect(a2).to_equal(-1)
        val (a3, b3, c3) = br_first_span_bounds_before_div_close("<div><span>x</div>", 5)
        expect(a3).to_equal(-1)
        expect(b1 + c1 + b2 + c2 + b3 + c3).to_equal(-6)

describe "residual guard branches (wave 3 closure)":
    it "a block narrower than one glyph advance keeps the text unwrapped":
        expect(br_fallback_wrap_lines("abcdef", 4, 16).len()).to_equal(1)

    it "span text containing nested markup is rejected":
        expect(br_first_span_text_before_div_close("<div><span>a<b></span></div>", 5)).to_equal("")

    it "a span whose open tag never closes inside the div yields sentinel bounds":
        val (a, b, c) = br_first_span_bounds_before_div_close("<div><span x</div>", 5)
        expect(a).to_equal(-1)
        expect(b).to_equal(-1)
        expect(c).to_equal(-1)
