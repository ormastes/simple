"""Regression: an `after_all` hook's mutation of a module global must build on
the value an earlier hook in the same group published, not on the module-load
value the frame happened to capture.

Before the fix the hook READ `[before_all]` through the live store but pushed
onto a stale `[]`, publishing `[after_all]` and silently discarding the
earlier write.
doc/08_tracking/bug/after_all_hook_module_global_write_lost_after_in_group_mutation_2026-08-31.md
"""
use std.spec

var order: [text] = []

describe "after_all mutation on an already-mutated module global":
    before_all:
        order.push("before_all")

    after_all:
        order.push("after_all")

    it "sees the before_all write":
        expect(order.len()).to_equal(1)
        expect(order[0]).to_equal("before_all")

describe "the drained after_all write survives":
    it "kept both entries in order":
        expect(order.len()).to_equal(2)
        expect(order[0]).to_equal("before_all")
        expect(order[1]).to_equal("after_all")
