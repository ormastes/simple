# @cover src/os/services/vfs/vfs_boot_init.spl 100%
# @req REQ-005
"""Direct FAT32 boot maps only PID1's fixed child-image paths."""

use std.spec.{describe, it, expect}
use os.services.vfs.vfs_boot_init.{vfs_boot_catalog_service_leaf}

describe "direct boot root-service path mapping":
    it "maps PID1 to its fixed direct-FAT alias":
        expect(vfs_boot_catalog_service_leaf("/system/service_manager.smf")).to_equal("INIT.SMF")

    it "maps every fixed catalogue child regardless of input case":
        expect(vfs_boot_catalog_service_leaf("/system/services/vfs.smf")).to_equal("VFS.SMF")
        expect(vfs_boot_catalog_service_leaf("/SYSTEM/SERVICES/NET.SMF")).to_equal("NET.SMF")
        expect(vfs_boot_catalog_service_leaf("/System/Services/Http.Smf")).to_equal("HTTP.SMF")

    it "fails closed for paths outside the fixed root catalogue":
        expect(vfs_boot_catalog_service_leaf("/system/services/other.smf")).to_equal("")
        expect(vfs_boot_catalog_service_leaf("/sys/services/vfs.smf")).to_equal("")
