use std.spec.*
use os.services.vfs.vfs_boot_init.{
    _vfs_boot_reset_storage_state,
    _vfs_ambient_reset_for_test,
    vfs_is_ready,
    vfs_ambient_in_container
}

describe "VFS boot state owner behavior":
    it "resets observable VFS state through owner-side APIs":
        _vfs_boot_reset_storage_state()
        expect(vfs_is_ready()).to_equal(false)
        _vfs_ambient_reset_for_test()
        expect(vfs_ambient_in_container()).to_equal(false)
