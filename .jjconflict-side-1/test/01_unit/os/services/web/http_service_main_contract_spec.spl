"""Native HTTP payload remains bound to the owned net IPC transport."""

use std.spec.{describe, it, expect}
use os.services.web.http_service_main.{NativeHttpService}

describe "native HTTP service payload":
    it "starts with no ambient listener or socket descriptor":
        val service = NativeHttpService.new()
        expect(service.port_id).to_equal(0u64)
        expect(service.net_port_id).to_equal(0u64)
        expect(service.listener_fd).to_equal(-1i32)
