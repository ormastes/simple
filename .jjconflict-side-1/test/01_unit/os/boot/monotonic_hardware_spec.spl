# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.*
use os.kernel.boot.monotonic_hardware.{boot_monotonic_deadline_us, boot_monotonic_elapsed_us}


describe "SimpleOS boot monotonic clock arithmetic":
    # @manual scenario evidence
    it "keeps valid sub-microsecond intervals distinct from invalid samples":
        # @req REQ-SSPEC-OS
        step("keeps valid sub-microsecond intervals distinct from invalid samples")
        expect(boot_monotonic_elapsed_us(100, 100)).to_equal(1)
        expect(boot_monotonic_elapsed_us(100, 99)).to_equal(0)
        expect(boot_monotonic_elapsed_us(100, 125)).to_equal(25)

    it "creates exact deadlines and rejects overflow":
        # @req REQ-SSPEC-OS
        step("creates exact deadlines and rejects overflow")
        expect(boot_monotonic_deadline_us(10, 500000)).to_equal(500010)
        expect(boot_monotonic_deadline_us(9223372036854775806, 1)).to_equal(9223372036854775807)
        expect(boot_monotonic_deadline_us(9223372036854775807, 1)).to_equal(0)
