"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/os/crypto/x25519mlkem768_native_tagged_value_contract_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/x25519mlkem768_native_tagged_value_contract_spec.md
# doc-path: doc/03_plan/sys_test/x25519mlkem768_native_tagged_value_contract_spec.md
# doc-path: doc/04_architecture/x25519mlkem768_native_tagged_value_contract_spec.md
# doc-path: doc/05_design/x25519mlkem768_native_tagged_value_contract_spec_oracles.md
# @manual: primary

"""Regression contract for ML-KEM canonical-key validation on native arrays."""
use std.spec.step

use std.spec.step

use std.io_runtime.{file_read}
use std.spec.*
use os.crypto.ml_kem.{ml_kem_768_encapsulation_key_valid}


fn _zero_encapsulation_key() -> list:
    var out = []
    var i: i64 = 0
    while i < 1184:
        out.push(0)
        i = i + 1
    out

describe "X25519MLKEM768 native tagged-value validation boundary":
    # @manual scenario evidence
    it "uses typed packed-byte reads before modulo q":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: uses typed packed-byte reads before modulo q")
        val source = file_read("src/os/crypto/ml_kem.spl")
        expect(source).to_contain(
            "val b0 = values[byte_offset] & 0xFF")
        expect(source).to_contain(
            "val b2 = values[byte_offset + 2] & 0xFF")
        expect(source.contains(
            "decoded.get(coeff).to_i64() % 3329")).to_be(false)
        expect(source.contains("val decoded = byte_decode(encoded, 12)")).to_be(false)

    it "accepts the largest canonical coefficient in both packed positions":
        step("Verify: accepts the largest canonical coefficient in both packed positions")
        # @req: REQ-SSPEC-LOCAL-001
        var ek = _zero_encapsulation_key()
        ek[0] = 0x00
        ek[1] = 0x0D
        ek[2] = 0xD0
        expect(ml_kem_768_encapsulation_key_valid(ek)).to_be(true)

    it "rejects q in the first packed coefficient":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: rejects q in the first packed coefficient")
        var ek = _zero_encapsulation_key()
        ek[0] = 0x01
        ek[1] = 0x0D
        expect(ml_kem_768_encapsulation_key_valid(ek)).to_be(false)

    it "rejects q in the second packed coefficient":
        step("Verify: rejects q in the second packed coefficient")
        # @req: REQ-SSPEC-LOCAL-001
        var ek = _zero_encapsulation_key()
        ek[1] = 0x10
        ek[2] = 0xD0
        expect(ml_kem_768_encapsulation_key_valid(ek)).to_be(false)

    it "checks canonical coefficients in every packed polynomial":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: checks canonical coefficients in every packed polynomial")
        var second_poly = _zero_encapsulation_key()
        second_poly[384] = 0x01
        second_poly[385] = 0x0D
        expect(ml_kem_768_encapsulation_key_valid(second_poly)).to_be(false)

        var final_pair = _zero_encapsulation_key()
        final_pair[1150] = 0x10
        final_pair[1151] = 0xD0
        expect(ml_kem_768_encapsulation_key_valid(final_pair)).to_be(false)

    it "rejects non-octet list elements without exempting rho":
        step("Verify: rejects non-octet list elements without exempting rho")
        # @req: REQ-SSPEC-LOCAL-001
        var high_packed = _zero_encapsulation_key()
        high_packed[0] = 256
        expect(ml_kem_768_encapsulation_key_valid(high_packed)).to_be(false)

        var negative_packed = _zero_encapsulation_key()
        negative_packed[0] = -1
        expect(ml_kem_768_encapsulation_key_valid(negative_packed)).to_be(false)

        var high_rho = _zero_encapsulation_key()
        high_rho[1183] = 256
        expect(ml_kem_768_encapsulation_key_valid(high_rho)).to_be(false)

        var maximal_rho = _zero_encapsulation_key()
        maximal_rho[1183] = 255
        expect(ml_kem_768_encapsulation_key_valid(maximal_rho)).to_be(true)

    it "rejects a key with the wrong encoded length":
        step("Verify: rejects a key with the wrong encoded length")
        # @req: REQ-SSPEC-LOCAL-001
        expect(ml_kem_768_encapsulation_key_valid([])).to_be(false)

    it "records why chained to_i64 is not native unboxing evidence":
        step("Verify: records why chained to_i64 is not native unboxing evidence")
        # @req: REQ-SSPEC-LOCAL-001
        val report = file_read(
            "doc/08_tracking/bug/x25519mlkem768_pure_native_probe_closure_nil_2026-08-02.md")
        expect(report).to_contain(
            "there is no `sar $3`")
        expect(report).to_contain(
            "`rt_value_as_int` call")
        expect(report).to_contain(
            "`list.get` compiler defect remains open")
