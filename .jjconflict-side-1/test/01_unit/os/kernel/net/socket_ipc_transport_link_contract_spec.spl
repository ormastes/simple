use std.io_runtime.{file_read}

describe "socket IPC target ownership boundary":
    it "keeps raw byte-array IPC externs out of architecture-neutral socket compatibility":
        val compat = file_read("src/os/kernel/socket_compat.spl")
        expect(compat.contains("extern fn rt_ipc_send_bytes")).to_be(false)
        expect(compat.contains("extern fn rt_ipc_recv_bytes")).to_be(false)
        expect(compat).to_contain("socket_ipc_send_bytes")
        expect(compat).to_contain("socket_ipc_recv_bytes")

    it "confines the runtime bridge to x86_64 and fails closed elsewhere":
        val transport = file_read("src/os/kernel/net/socket_ipc_transport.spl")
        expect(transport).to_contain("@cfg(x86_64)\nextern fn rt_ipc_send_bytes")
        expect(transport).to_contain("@cfg(x86_64)\nextern fn rt_ipc_recv_bytes")
        expect(transport).to_contain("@cfg(not(x86_64))\nfn socket_ipc_send_bytes")
        expect(transport).to_contain("-(ENOSYS as i64)")
        expect(transport).to_contain("@cfg(not(x86_64))\nfn socket_ipc_recv_bytes")
        expect(transport).to_contain("[]")

    it "does not add a fabricated ARM64 runtime provider":
        val arm_runtime = file_read("examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c")
        expect(arm_runtime.contains("rt_ipc_send_bytes")).to_be(false)
        expect(arm_runtime.contains("rt_ipc_recv_bytes")).to_be(false)
