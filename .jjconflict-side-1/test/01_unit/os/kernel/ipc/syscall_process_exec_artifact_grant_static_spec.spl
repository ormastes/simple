use std.test.*
use std.fs.{file_read}

val PROCESS = "src/os/kernel/ipc/syscall_process.spl"

describe "exec canonical artifact grant binding static contract":
    it "binds exec admission to both requested and canonical artifact paths":
        val body = file_read(PROCESS)
        val helper = body.split("fn _process_grant_errno_for_artifact(")[1].split(
            "# ============================================================================")[0]
        expect(helper).to_contain(
            "_process_grant_errno_for_path(requested_path, klog)")
        expect(helper).to_contain(
            "_process_grant_errno_for_path(artifact_path, klog)")
        expect(helper.index_of(
            "_process_grant_errno_for_path(requested_path, klog)")).to_be_less_than(
            helper.index_of("_process_grant_errno_for_path(artifact_path, klog)"))
        expect(helper).to_contain("if artifact_path == requested_path:")

    it "passes one resolved artifact identity to grant and exec loading":
        val body = file_read(PROCESS)
        val exec = body.split("fn _handle_exec_state(")[1].split(
            "fn _handle_exec(")[0]
        expect(exec.count("_resolved_artifact_path_from_bytes(")).to_equal(1)
        expect(exec).to_contain(
            "_process_grant_errno_for_artifact(\n        path, artifact_path")
        expect(exec).to_contain(
            "resolve_executable_bytes(artifact_path, CURRENT_EXEC_ARCH)")
        expect(exec.index_of("_process_grant_errno_for_artifact(")).to_be_less_than(
            exec.index_of("resolve_executable_bytes(artifact_path"))

    it "uses the same binding before byte-path direct spawn resolution":
        val body = file_read(PROCESS)
        val direct = body.split("pub fn dispatch_spawn_binary_direct_state(")[1].split(
            "fn dispatch_spawn_binary_direct(")[0]
        expect(direct).to_contain(
            "val artifact_path = _resolved_artifact_path_from_bytes(path, path_bytes)")
        expect(direct).to_contain(
            "_process_grant_errno_for_artifact(\n        path, artifact_path, klog)")
        expect(direct).to_contain("resolve_executable_bytes(artifact_path, arch)")
        expect(direct.index_of("_process_grant_errno_for_artifact(")).to_be_less_than(
            direct.index_of("resolve_executable_bytes(artifact_path, arch)"))
