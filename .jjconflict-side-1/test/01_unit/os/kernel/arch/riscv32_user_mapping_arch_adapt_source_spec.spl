# @cover src/os/kernel/arch_adapt/riscv32_user_mapping.spl 100%
# Exact source-decision coverage for RISC-V 32 loader mapping routing.

use std.spec.{describe, it, expect, step}
use app.io.mod.{file_read_text}

val ADAPTER_PATH = "src/os/kernel/arch_adapt/riscv32_user_mapping.spl"
val MAPPING_PATH =
    "src/os/kernel/loader/riscv32_sv32_mapping_owner_v1.spl"
val REGISTRY_PATH =
    "src/os/kernel/loader/executable_authority_registry.spl"
val CONCRETE_OWNER = "os.kernel.arch.riscv32.sv32_user_root_owner_v1"
val ADAPTER_OWNER = "os.kernel.arch_adapt.riscv32_user_mapping"
val EXACT_ADAPTER_SOURCE = "# Compile-time RISC-V 32 User-Mapping Adapter\n" +
    "#\n" +
    "# Loader owners bind to this architecture boundary instead of importing the\n" +
    "# concrete RISC-V 32 tree. Public re-exports preserve existing declarations;\n" +
    "# no runtime dispatch, allocation, copied state, or additional call is added.\n" +
    "\n" +
    "pub use {CONCRETE_OWNER}.{{\n" +
    "    Riscv32Sv32RootLeaseV1,\n" +
    "    Riscv32Sv32RootUnreachableReceiptV1,\n" +
    "    riscv32_sv32_user_root_create_v1,\n" +
    "    riscv32_sv32_user_map_exact_v1,\n" +
    "    riscv32_sv32_user_unmap_exact_v1,\n" +
    "    riscv32_sv32_user_root_detach_v1,\n" +
    "    riscv32_sv32_user_root_release_detached_v1,\n" +
    "    riscv32_sv32_user_root_abort_fresh_v1,\n" +
    "    riscv32_sv32_root_unreachable_claim_v1,\n" +
    "}}\n"
val EXACT_MAPPING_IMPORT = "use {ADAPTER_OWNER}.{{\n" +
    "    Riscv32Sv32RootLeaseV1, Riscv32Sv32RootUnreachableReceiptV1,\n" +
    "    riscv32_sv32_user_root_create_v1,\n" +
    "    riscv32_sv32_user_map_exact_v1,\n" +
    "    riscv32_sv32_user_unmap_exact_v1,\n" +
    "    riscv32_sv32_user_root_detach_v1,\n" +
    "    riscv32_sv32_user_root_release_detached_v1,\n" +
    "    riscv32_sv32_user_root_abort_fresh_v1\n" +
    "}}"
val EXACT_REGISTRY_IMPORT = "use {ADAPTER_OWNER}.{{\n" +
    "    Riscv32Sv32RootUnreachableReceiptV1,\n" +
    "    riscv32_sv32_root_unreachable_claim_v1\n" +
    "}}"

describe "RISC-V 32 user-mapping compile-time architecture adapter":
    it "is exactly the allocation-free whole-file forwarding contract":
        step("Read the adapter source and pin its exact export decision")
        val source = file_read_text(ADAPTER_PATH)
        expect(source).to_equal(EXACT_ADAPTER_SOURCE)

    it "routes every loader consumer only through the adapter":
        step("Read and pin both exact consumer import blocks")
        val mapping = file_read_text(MAPPING_PATH)
        val registry = file_read_text(REGISTRY_PATH)
        expect(mapping.contains(EXACT_MAPPING_IMPORT)).to_equal(true)
        expect(registry.contains(EXACT_REGISTRY_IMPORT)).to_equal(true)
        expect(mapping.count(ADAPTER_OWNER)).to_equal(1)
        expect(registry.count(ADAPTER_OWNER)).to_equal(1)

        step("Reject direct concrete-owner imports from loader consumers")
        expect(mapping.contains(CONCRETE_OWNER)).to_equal(false)
        expect(registry.contains(CONCRETE_OWNER)).to_equal(false)
