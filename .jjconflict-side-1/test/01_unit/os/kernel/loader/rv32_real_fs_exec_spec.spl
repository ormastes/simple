# @cover src/os/kernel/loader/rv32_real_exec_payload.spl 80%
use std.spec.*
use os.kernel.loader.rv32_real_exec_payload.*

describe "RV32 real filesystem execution payload":
    it "simulates nonce-bound target stdout and exit 37":
        val nonce = "rv32-real-exec-0001"
        val elf = rv32_real_exec_elf(nonce)
        val simulated = rv32_simulate_real_exec_elf(elf)
        expect(simulated.valid).to_equal(true)
        expect(simulated.stdout).to_equal(rv32_real_exec_stdout(nonce))
        expect(simulated.exit_code).to_equal(37)

    it "emits a real ELF32 RISC-V executable envelope":
        val elf = rv32_real_exec_elf("rv32-real-exec-0002")
        expect(elf[4]).to_equal(1)
        expect(elf[18]).to_equal(243)
        expect(elf[19]).to_equal(0)
        expect(elf[0x108]).to_equal(0x73)

    it "rejects a mutated mounted instruction":
        val nonce = "rv32-real-exec-0003"
        var elf = rv32_real_exec_elf(nonce)
        elf[0x108] = 0
        val admission = rv32_admit_mounted_real_exec(elf, nonce)
        expect(admission.payload_accepted).to_equal(false)
        expect(admission.reason).to_equal("rv32-real-exec-mounted-bytes-mismatch")

    it "admits exact payload bytes but blocks missing Sv32 live entry":
        val nonce = "rv32-real-exec-0004"
        val admission = rv32_admit_mounted_real_exec(rv32_real_exec_elf(nonce), nonce)
        expect(admission.payload_accepted).to_equal(true)
        expect(admission.live_executable).to_equal(false)
        expect(admission.status).to_equal(-95)
        expect(admission.reason).to_equal("rv32-sv32-live-entry-not-installed")

    it "rejects a nonce outside the bounded printable contract":
        val admission = rv32_admit_mounted_real_exec([], "short")
        expect(admission.payload_accepted).to_equal(false)
        expect(admission.live_executable).to_equal(false)
        expect(admission.status).to_equal(-22)
        expect(admission.reason).to_equal("rv32-real-exec-invalid-nonce")

    it "rejects exact valid bytes authenticated for another nonce":
        val mounted = rv32_real_exec_elf("rv32-real-exec-owner-a")
        val admission = rv32_admit_mounted_real_exec(mounted, "rv32-real-exec-owner-b")
        expect(admission.payload_accepted).to_equal(false)
        expect(admission.live_executable).to_equal(false)
        expect(admission.status).to_equal(-13)
        expect(admission.reason).to_equal("rv32-real-exec-mounted-bytes-mismatch")
