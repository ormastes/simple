"""Focused scheduler handoff contract for the admitted x86_64 server pair."""

use std.spec.{describe, it, expect}
use std.fs.{file_read}
use os.kernel.loader.x86_64_server_admission.{
    X86_64_SERVER_WEB_PATH, X86_64_SERVER_DB_PATH, X86_64_SERVER_PROFILE,
    X86_64ServerAdmissionInput,
    x86_64_server_web_profile, x86_64_server_db_profile
}
use os.kernel.loader.artifact_manifest.{manifest_sha256_hex}
use os.kernel.loader.x86_64_server_scheduler_bridge.{
    x86_64_server_schedule_admitted_input
}
use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.ipc.ipc.{IpcManager}
use os.kernel.types.task_types.{TaskId, TaskPriority}

fn _push_u16(bytes: [u8], value: i64) -> [u8]:
    bytes.push((value & 0xff).to_u8())
    bytes.push(((value >> 8) & 0xff).to_u8())
    bytes

fn _push_u32(bytes: [u8], value: i64) -> [u8]:
    var out = bytes
    out = _push_u16(out, value)
    out = _push_u16(out, value >> 16)
    out

fn _push_u64(bytes: [u8], value: i64) -> [u8]:
    var out = bytes
    out = _push_u32(out, value)
    out = _push_u32(out, value >> 32)
    out

fn _minimal_x86_64_elf(marker: u8) -> [u8]:
    var out: [u8] = [0x7f, 0x45, 0x4c, 0x46, 2, 1, 1, 0]
    while out.len() < 16: out.push(0)
    out = _push_u16(out, 2)
    out = _push_u16(out, 62)
    out = _push_u32(out, 1)
    out = _push_u64(out, 0x400000)
    out = _push_u64(out, 64)
    out = _push_u64(out, 0)
    out = _push_u32(out, 0)
    out = _push_u16(out, 64)
    out = _push_u16(out, 56)
    out = _push_u16(out, 1)
    out = _push_u16(out, 0)
    out = _push_u16(out, 0)
    out = _push_u16(out, 0)
    out = _push_u32(out, 1)
    out = _push_u32(out, 5)
    out = _push_u64(out, 0x80)
    out = _push_u64(out, 0x400000)
    out = _push_u64(out, 0x400000)
    out = _push_u64(out, 4)
    out = _push_u64(out, 4)
    out = _push_u64(out, 0x1000)
    while out.len() < 0x80: out.push(0)
    out.push(marker)
    out.push(0x90.to_u8())
    out.push(0x90.to_u8())
    out.push(0x90.to_u8())
    out

fn _input(web: [u8], db: [u8]) -> X86_64ServerAdmissionInput:
    X86_64ServerAdmissionInput(
        web_path: X86_64_SERVER_WEB_PATH,
        db_path: X86_64_SERVER_DB_PATH,
        web_bytes: web,
        db_bytes: db,
        web_version: "1.0.0",
        db_version: "1.0.0",
        web_sha256: manifest_sha256_hex(web),
        db_sha256: manifest_sha256_hex(db),
        image_id: "unit-fat32-image",
        image_sha256: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        launch_id: "bridge-test",
        runtime_profile: X86_64_SERVER_PROFILE,
        web_profile: x86_64_server_web_profile("bridge-test"),
        db_profile: x86_64_server_db_profile("bridge-test")
    )

describe "x86_64 admitted server scheduler bridge":
    it "passes bounded opaque launch profiles as exact argv vectors":
        val bridge = file_read("src/os/kernel/loader/x86_64_server_scheduler_bridge.spl")
        val scheduler = file_read("src/os/kernel/scheduler/_Scheduler/scheduler_lifecycle.spl")
        val scheduler_exec = file_read("src/os/kernel/scheduler/scheduler_exec.spl")
        expect(bridge).to_contain("val web_argv: [text] = [")
        expect(bridge).to_contain("X86_64_SERVER_WEB_PATH, \"--simpleos\", \"--launch-id\", input.web_profile")
        expect(bridge).to_contain("X86_64_SERVER_DB_PATH, \"--simpleos\", \"--launch-id\", input.db_profile")
        expect(bridge).to_contain("val web_envp: [text] = []")
        expect(bridge).to_contain("val db_envp: [text] = []")
        expect(bridge).to_contain("MAX_ARGUMENTS: i64 = 16")
        expect(bridge).to_contain("MAX_ARGUMENT_BYTES: i64 = 256")
        expect(bridge).to_contain("MAX_TOTAL_BYTES: i64 = 2048")
        expect(bridge).to_contain("argv[0] == \"\" or argv[0].contains(\"\\0\")")
        expect(bridge).to_contain("argument.contains(\"\\0\")")
        expect(bridge).to_contain("create_user_task_from_bytes_with_args_pid(")
        expect(bridge.contains(".ptr()")).to_equal(false)
        expect(bridge.contains("asm(")).to_equal(false)
        expect(scheduler).to_contain("me create_user_task_from_bytes_with_args_pid(")
        expect(scheduler).to_contain("path, bytes, arch, [], [], priority, caps")
        expect(scheduler_exec).to_contain("pub fn sched_create_user_task_from_bytes_with_args_pid_impl(")
        expect(scheduler_exec).to_contain("stage_user_process_image_for_scheduler(path, bytes, arch, argv, envp)")

    it "reaps every provisional task on capability or DB rollback":
        val source = file_read("src/os/kernel/loader/x86_64_server_scheduler_bridge.spl")
        expect(source).to_contain("val _web_collected = live_scheduler.wait_for_collect(")
        expect(source).to_contain("val _db_collected = live_scheduler.wait_for_collect(")
        expect(source).to_contain("live_ipc.cap_revoke_all_for_task(TaskId(id: web_pid))")
        expect(source).to_contain("live_ipc.cap_revoke_all_for_task(TaskId(id: db_pid))")

    it "creates distinct prioritized tasks and rolls web back on DB failure":
        val web = _minimal_x86_64_elf(0x90.to_u8())
        val db = _minimal_x86_64_elf(0xc3.to_u8())
        val launched = x86_64_server_schedule_admitted_input(
            _input(web, db), Scheduler.new(), IpcManager.new()
        )
        expect(launched.accepted).to_equal(true)
        expect(launched.reason).to_equal("ok")
        expect(launched.web_pid).to_be_greater_than(0u64)
        expect(launched.db_pid).to_be_greater_than(launched.web_pid)
        val web_task = launched.scheduler.get_task(TaskId(id: launched.web_pid)).unwrap()
        val db_task = launched.scheduler.get_task(TaskId(id: launched.db_pid)).unwrap()
        expect(web_task.priority).to_equal(TaskPriority.High)
        expect(db_task.priority).to_equal(TaskPriority.Normal)
        expect(web_task.capabilities.caps.len()).to_equal(3)
        expect(db_task.capabilities.caps.len()).to_equal(4)
        expect(web_task.capabilities.is_pledged).to_equal(true)
        expect(db_task.capabilities.is_pledged).to_equal(true)
        val web_ipc_caps = launched.ipc.capabilities_for_task(
            TaskId(id: launched.web_pid)).unwrap()
        val db_ipc_caps = launched.ipc.capabilities_for_task(
            TaskId(id: launched.db_pid)).unwrap()
        var i = 0
        while i < web_task.capabilities.caps.len():
            val scheduler_cap = web_task.capabilities.caps[i]
            val ipc_cap = web_ipc_caps.caps[i]
            expect(scheduler_cap.kind).to_equal(ipc_cap.kind)
            expect(scheduler_cap.owner).to_equal(launched.web_pid)
            expect(scheduler_cap.owner).to_equal(ipc_cap.owner)
            expect(scheduler_cap.token_id).to_equal(ipc_cap.token_id)
            expect(scheduler_cap.token_id).to_be_greater_than(0u64)
            expect(scheduler_cap.generation).to_equal(ipc_cap.generation)
            i = i + 1
        i = 0
        while i < db_task.capabilities.caps.len():
            val scheduler_cap = db_task.capabilities.caps[i]
            val ipc_cap = db_ipc_caps.caps[i]
            expect(scheduler_cap.kind).to_equal(ipc_cap.kind)
            expect(scheduler_cap.owner).to_equal(launched.db_pid)
            expect(scheduler_cap.owner).to_equal(ipc_cap.owner)
            expect(scheduler_cap.token_id).to_equal(ipc_cap.token_id)
            expect(scheduler_cap.token_id).to_be_greater_than(0u64)
            expect(scheduler_cap.generation).to_equal(ipc_cap.generation)
            i = i + 1
        expect(web_task.capabilities.caps[0].token_id).to_be_less_than(
            db_task.capabilities.caps[0].token_id)
        expect(web_task.capabilities.has(db_task.capabilities.caps[0].kind)).to_equal(true)
        expect(web_task.capabilities.has(db_task.capabilities.caps[1].kind)).to_equal(false)

        val rolled = x86_64_server_schedule_admitted_input(
            _input(web, []), Scheduler.new(), IpcManager.new()
        )
        expect(rolled.accepted).to_equal(false)
        expect(rolled.web_pid).to_equal(0u64)
        expect(rolled.db_pid).to_equal(0u64)
        expect(rolled.reason).to_equal("admission-rejected:empty-server-artifact")
        expect(rolled.rolled_back_web_pid).to_equal(0u64)
