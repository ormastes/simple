"""
SOSIX/QEMU guest filesystem evidence contract.

Proves the shared classifier rejects missing boot/mount/listing facts, a
nonzero or fabricated program result, and non-target-native execution. These
are contract tests only; per-architecture system scenarios must still boot QEMU
and populate the receipt from retained guest output.
"""

use std.spec.*
use os.sosix.qemu_evidence.guest_filesystem_receipt.{
    SOSIX_QEMU_GUEST_PASS,
    SosixQemuGuestFilesystemReceipt,
    sosix_qemu_guest_filesystem_status,
    sosix_qemu_guest_serial_status,
    sosix_qemu_compiler_serial_status
}

fn compiler_serial(nonce: text = "n-compiler-17") -> text:
    val identity = "host=linux guest=x86_64 nonce=" + nonce
    "SOSIX_QEMU_BOOT PASS " + identity + "\n" +
    "SOSIX_QEMU_FS_MOUNT PASS " + identity + "\n" +
    "SOSIX_QEMU_FS_LS BEGIN " + identity + "\n" +
    "SOSIX_QEMU_FS_LS_ENTRY " + identity + " path=/usr/bin/simple\n" +
    "SOSIX_QEMU_FS_LS END " + identity + " status=pass\n" +
    "SOSIX_QEMU_COMPILER_VERSION " + identity + " path=/usr/bin/simple version=0.9.1 exit=0 target_native=true\n" +
    "SOSIX_QEMU_HELLO_SOURCE " + identity + " path=/tmp/hello.spl source_nonce=" + nonce + "\n" +
    "SOSIX_QEMU_HELLO_COMPILE BEGIN " + identity + " compiler=/usr/bin/simple source=/tmp/hello.spl output=/tmp/hello\n" +
    "SOSIX_QEMU_HELLO_COMPILE END " + identity + " output=/tmp/hello exit=0 target_native=true\n" +
    "SOSIX_QEMU_PROGRAM BEGIN " + identity + " path=/tmp/hello\n" +
    "SOSIX_QEMU_PROGRAM_STDOUT " + identity + " text=hello-n-compiler-17\n" +
    "SOSIX_QEMU_PROGRAM END " + identity + " exit=0 target_native=true\n"

fn passing_receipt() -> SosixQemuGuestFilesystemReceipt:
    SosixQemuGuestFilesystemReceipt(
        host: "linux",
        guest: "x86_64",
        boot_status: "pass",
        mount_status: "pass",
        listing_status: "pass",
        listing_output: "/usr/bin/simple\n/hello.spl\n",
        expected_listing_entry: "/usr/bin/simple",
        program_status: "pass",
        program_path: "/hello.spl",
        program_nonce: "sq-x86-64-001",
        program_stdout: "hello from simple on simpleos",
        expected_program_stdout: "hello from simple on simpleos",
        program_exit_code: 0,
        fixed_response_detected: false,
        target_native_program: true
    )

describe "SOSIX QEMU guest filesystem evidence":
    it "accepts a correlated boot listing and target-native program receipt":
        step("Classify a complete guest filesystem flow")
        val status = sosix_qemu_guest_filesystem_status(passing_receipt())
        expect(status).to_equal(SOSIX_QEMU_GUEST_PASS)

    it "rejects a listing that does not contain the required payload":
        step("Remove the independently required listing entry")
        var receipt = passing_receipt()
        receipt.listing_output = "/hello.spl\n"
        val status = sosix_qemu_guest_filesystem_status(receipt)
        expect(status).to_equal("blocked:listing-entry-missing")

    it "rejects a nonzero arbitrary program result":
        step("Change the guest program exit status")
        var receipt = passing_receipt()
        receipt.program_exit_code = 7
        val status = sosix_qemu_guest_filesystem_status(receipt)
        expect(status).to_equal("blocked:program-exit-nonzero")

    it "rejects fixed response evidence":
        step("Mark the transcript as a fixed response")
        var receipt = passing_receipt()
        receipt.fixed_response_detected = true
        val status = sosix_qemu_guest_filesystem_status(receipt)
        expect(status).to_equal("blocked:fixed-response-detected")

    it "rejects a host-side or wrong-architecture program":
        step("Remove target-native provenance")
        var receipt = passing_receipt()
        receipt.target_native_program = false
        val status = sosix_qemu_guest_filesystem_status(receipt)
        expect(status).to_equal("blocked:program-not-target-native")

    it "accepts exact nonce-correlated serial markers":
        step("Parse one production guest marker flow")
        val serial =
            "SOSIX_QEMU_BOOT PASS host=linux guest=x86_64 nonce=n-17\n" +
            "SOSIX_QEMU_FS_MOUNT PASS host=linux guest=x86_64 nonce=n-17\n" +
            "SOSIX_QEMU_FS_LS BEGIN host=linux guest=x86_64 nonce=n-17\n" +
            "SOSIX_QEMU_FS_LS_ENTRY host=linux guest=x86_64 nonce=n-17 path=/usr/bin/simple\n" +
            "SOSIX_QEMU_FS_LS END host=linux guest=x86_64 nonce=n-17 status=pass\n" +
            "SOSIX_QEMU_PROGRAM BEGIN host=linux guest=x86_64 nonce=n-17 path=/hello.spl\n" +
            "SOSIX_QEMU_PROGRAM_STDOUT host=linux guest=x86_64 nonce=n-17 text=hello from simple on simpleos\n" +
            "SOSIX_QEMU_PROGRAM END host=linux guest=x86_64 nonce=n-17 exit=0 target_native=true\n"
        val status = sosix_qemu_guest_serial_status(
            serial, "linux", "x86_64", "n-17", "/usr/bin/simple",
            "/hello.spl", "hello from simple on simpleos")
        expect(status).to_equal(SOSIX_QEMU_GUEST_PASS)

    it "rejects replayed listing markers from another nonce":
        step("Correlate listing evidence to the requested run nonce")
        val serial =
            "SOSIX_QEMU_BOOT PASS host=linux guest=x86_64 nonce=n-18\n" +
            "SOSIX_QEMU_FS_MOUNT PASS host=linux guest=x86_64 nonce=n-18\n" +
            "SOSIX_QEMU_FS_LS BEGIN host=linux guest=x86_64 nonce=old\n" +
            "SOSIX_QEMU_FS_LS_ENTRY host=linux guest=x86_64 nonce=old path=/usr/bin/simple\n"
        val status = sosix_qemu_guest_serial_status(
            serial, "linux", "x86_64", "n-18", "/usr/bin/simple",
            "/hello.spl", "hello from simple on simpleos")
        expect(status).to_equal("blocked:listing-not-executed")

    it "accepts target compiler version nonce-bound compile and filesystem execution evidence":
        step("Validate one retained compiler-bearing guest transcript")
        val status = sosix_qemu_compiler_serial_status(
            compiler_serial(), "linux", "x86_64", "n-compiler-17",
            "/usr/bin/simple", "0.9.1", "/tmp/hello.spl", "/tmp/hello",
            "hello-n-compiler-17")
        expect(status).to_equal(SOSIX_QEMU_GUEST_PASS)

    it "rejects a descriptor-only compiler claim without target version evidence":
        step("Remove the target compiler version marker")
        val serial = compiler_serial().replace("SOSIX_QEMU_COMPILER_VERSION", "SOSIX_QEMU_COMPILER_DECLARED")
        val status = sosix_qemu_compiler_serial_status(
            serial, "linux", "x86_64", "n-compiler-17", "/usr/bin/simple",
            "0.9.1", "/tmp/hello.spl", "/tmp/hello", "hello-n-compiler-17")
        expect(status).to_equal("blocked:compiler-version-not-proven")

    it "rejects hello compilation replayed from another nonce":
        step("Correlate source and compile markers with the requested run")
        val serial = compiler_serial().replace(
            "SOSIX_QEMU_HELLO_SOURCE host=linux guest=x86_64 nonce=n-compiler-17",
            "SOSIX_QEMU_HELLO_SOURCE host=linux guest=x86_64 nonce=old")
        val status = sosix_qemu_compiler_serial_status(
            serial, "linux", "x86_64", "n-compiler-17", "/usr/bin/simple",
            "0.9.1", "/tmp/hello.spl", "/tmp/hello", "hello-n-compiler-17")
        expect(status).to_equal("blocked:hello-source-not-correlated")
