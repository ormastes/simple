use std.spec.{describe, it, expect, to_equal}
use std.spec.step
use os.services.wm.simpleos_wm_input_adapter.{simpleos_wm_no_input_adapter}

describe "SimpleOS WM explicit input adapter":
    it "reports no-input honestly and never emits a synthetic successful event":
        step("Poll the architecture-neutral no-input adapter")
        val adapter = simpleos_wm_no_input_adapter()
        val poll = adapter.poll()
        expect(adapter.backing_kind()).to_equal("none")
        expect(poll.ok).to_equal(false)
        expect(poll.state).to_equal("input-unavailable")
