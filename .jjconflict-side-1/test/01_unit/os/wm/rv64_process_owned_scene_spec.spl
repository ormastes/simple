use std.spec
use os.compositor.compositor.{Compositor}
use os.compositor.host_compositor_entry.{HeadlessHostCompositorBackend}
use os.compositor.rv64_process_owned_scene.{
    rv64_process_owned_scene,
    rv64_process_owned_render_cardinality_valid,
    rv64_process_owned_presentation_binding_valid
}
use os.desktop.shell.{DesktopShell}

fn _rv64_scene_compositor() -> Compositor:
    Compositor.with_backends(
        HeadlessHostCompositorBackend.new(800, 600), nil, 800, 600
    )

describe "RV64 process-owned compositor scene":
    it "retains only exact PID surfaces with original stacking and focus":
        var compositor = _rv64_scene_compositor()
        val global_id = compositor.create_window("Global", 1, 2, 100, 90)
        val visible_id = compositor.create_window("Owned visible", 3, 4, 120, 100)
        val foreign_id = compositor.create_window("Foreign", 5, 6, 130, 110)
        val minimized_id = compositor.create_window("Owned minimized", 7, 8, 140, 120)
        compositor.set_window_identity(visible_id, 41, "owned-visible")
        compositor.set_window_identity(foreign_id, 99, "foreign")
        compositor.set_window_identity(minimized_id, 41, "owned-minimized")
        compositor.minimize_window(minimized_id.to_u64())
        compositor.focused_idx = 1

        val owned = rv64_process_owned_scene(compositor, 41u64)

        expect(global_id).to_equal(1)
        expect(owned.scene.windows.len()).to_equal(2)
        expect(owned.process_surface_count).to_equal(1)
        expect(owned.scene.windows[0].window_id).to_equal(visible_id.to_text())
        expect(owned.scene.windows[0].z_index).to_equal(1)
        expect(owned.scene.windows[0].focused).to_equal(true)
        expect(owned.scene.windows[0].minimized).to_equal(false)
        expect(owned.scene.windows[1].window_id).to_equal(minimized_id.to_text())
        expect(owned.scene.windows[1].z_index).to_equal(3)
        expect(owned.scene.windows[1].focused).to_equal(false)
        expect(owned.scene.windows[1].minimized).to_equal(true)

    it "never treats compositor PID zero as a process-owned scene":
        var compositor = _rv64_scene_compositor()
        compositor.create_window("Global", 1, 2, 100, 90)

        val global = rv64_process_owned_scene(compositor, 0u64)

        expect(global.scene.windows.len()).to_equal(0)
        expect(global.process_surface_count).to_equal(0)

    it "retains ownership when every exact-PID surface is minimized":
        var compositor = _rv64_scene_compositor()
        val owned_id = compositor.create_window("Owned minimized", 7, 8, 140, 120)
        compositor.set_window_identity(owned_id, 41, "owned-minimized")
        compositor.minimize_window(owned_id.to_u64())

        val owned = rv64_process_owned_scene(compositor, 41u64)

        expect(owned.scene.windows.len()).to_equal(1)
        expect(owned.process_surface_count).to_equal(0)
        expect(owned.scene.windows[0].minimized).to_equal(true)
        expect(rv64_process_owned_render_cardinality_valid(owned, 0)).to_equal(true)
        expect(rv64_process_owned_presentation_binding_valid(owned, 41u64, 0)).to_equal(true)
        expect(rv64_process_owned_render_cardinality_valid(owned, 1)).to_equal(false)

    it "rejects missing frames and forged retained-window ownership":
        var compositor = _rv64_scene_compositor()
        val owned_id = compositor.create_window("Owned visible", 7, 8, 140, 120)
        compositor.set_window_identity(owned_id, 41, "owned-visible")
        val owned = rv64_process_owned_scene(compositor, 41u64)

        expect(rv64_process_owned_render_cardinality_valid(owned, 0)).to_equal(false)
        expect(rv64_process_owned_render_cardinality_valid(owned, 1)).to_equal(true)
        expect(rv64_process_owned_presentation_binding_valid(owned, 99u64, 1)).to_equal(false)

    it "changes revision only for retained scene state or screen dimensions":
        var compositor = _rv64_scene_compositor()
        val owned_id = compositor.create_window("Owned", 3, 4, 120, 100)
        val foreign_id = compositor.create_window("Foreign", 5, 6, 130, 110)
        compositor.set_window_identity(owned_id, 41, "owned")
        compositor.set_window_identity(foreign_id, 99, "foreign")
        val baseline = rv64_process_owned_scene(compositor, 41u64).scene_revision

        compositor.set_window_title(foreign_id.to_u64(), "Foreign changed")
        expect(rv64_process_owned_scene(compositor, 41u64).scene_revision)
            .to_equal(baseline)
        compositor.set_window_title(owned_id.to_u64(), "Owned changed")
        val owned_changed = rv64_process_owned_scene(compositor, 41u64).scene_revision
        expect(owned_changed == baseline).to_equal(false)
        compositor.screen_width = 801
        expect(rv64_process_owned_scene(compositor, 41u64).scene_revision == owned_changed)
            .to_equal(false)

    it "filters process render frames while the global render path remains complete":
        var compositor = _rv64_scene_compositor()
        val owned_id = compositor.create_window("Owned", 3, 4, 120, 100)
        val foreign_id = compositor.create_window("Foreign", 5, 6, 130, 110)
        compositor.set_window_identity(owned_id, 41, "owned")
        compositor.set_window_identity(foreign_id, 99, "foreign")
        compositor.update_window_content(owned_id.to_u64(), "<main>owned</main>")
        compositor.update_window_content(foreign_id.to_u64(), "<main>foreign</main>")
        var shell = DesktopShell.new(compositor)

        val owned_frames = shell.runtime_content_frames_for_process(71, 41u64)
        val global_frames = shell.runtime_content_frames(71)

        expect(owned_frames.len()).to_equal(1)
        expect(owned_frames[0].window_id).to_equal(owned_id.to_text())
        expect(global_frames.len()).to_equal(2)
