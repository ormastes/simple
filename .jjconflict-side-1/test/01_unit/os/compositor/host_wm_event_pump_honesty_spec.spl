# @cover src/os/compositor/host_compositor_core.spl 5%
# @tag: unit, os, compositor, wm
"""
# Host WM Event Pump Honesty Spec

HostWmHandle.pump_host_events has no host event source on the Headless-only
path this file constructs — the honest contract is: return 0 events AND record
the tick in an observable counter (counted no-op, not a silent fake).
"""

use std.spec.{describe, it, expect}
use common.window_protocol.geometry.{Size}
use os.compositor.host_compositor_core.{
    HostWmConfig,
    HostBackendKind,
    init_headless_host_wm,
    host_wm_event_pump_noop_ticks
}

describe "headless host WM event pump honesty":
    it "returns zero events and counts each live-handle no-op tick":
        val cfg = HostWmConfig(
            backend: HostBackendKind.Headless,
            initial_size: Size.wh(64, 48),
            title: "pump-honesty"
        )
        val handle = init_headless_host_wm(cfg)
        val before = host_wm_event_pump_noop_ticks()
        val pumped = handle.pump_host_events()
        expect(pumped).to_equal(0)
        expect(host_wm_event_pump_noop_ticks()).to_equal(before + 1)
        val pumped_again = handle.pump_host_events()
        expect(pumped_again).to_equal(0)
        expect(host_wm_event_pump_noop_ticks()).to_equal(before + 2)
