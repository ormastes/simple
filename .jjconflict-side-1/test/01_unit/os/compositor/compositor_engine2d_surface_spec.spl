"""
## Purpose and audience
Purpose: Prove that Engine2dCompositorBackend — create_from_env / selected_backend.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-OS-COMPOSITOR-001 — stable requirement identity for this spec.

# @cover src/os/compositor/compositor_engine2d.spl 80%
# @tag: unit, os, compositor, engine2d, surface
#
# Closure for `compositor_engine2d.spl` surface untested by
# `engine2d_compositor_revision_cache_spec.spl` (which owns
# render_draw_ir_composition_resources_revision caching behaviour — not
# duplicated here). Plan unit F8.
#
# CORRECTIONS vs the plan (2026-08-07, verified by probe against the real
# module before writing assertions):
# - `create_from_env` with an UNRECOGNISED `SIMPLE_GUI_BACKEND` value does
#   NOT reject or crash; it silently resolves to a concrete backend name
#   rather than "software" verbatim. Under `bin/simple run` (JIT) probing
#   showed unset/=="software" -> `"cpu"` and an unrecognised name also ->
#   `"cpu"`. Under `bin/simple test` (the interpreter/test-runner lane this
#   spec actually runs on - see `.claude/rules/testing.md`), unset and
#   explicit `"software"` both resolve `selected_backend()` to the literal
#   `"software"`, while an unrecognised name still resolves to `"cpu"` - an
#   ENGINE DIVERGENCE (interpreter vs JIT disagree on the resolved name for
#   the same request), consistent with this tree's other engine-divergence
#   findings. This spec asserts the `bin/simple test` (interpreter) values,
#   since that is the lane it runs under; it does not assert JIT parity.
# - `frame_provenance()` does NOT change merely from calling `clear()` /
#   `fill_rect()` / other `CompositorBackend` trait ops - those only call
#   `invalidate_frame_receipt()` (which zeroes the readback-receipt fields;
#   a zero-to-zero transition on a freshly created backend is invisible) and
#   never populate `last_readback_checksum`/`last_composition_id`/etc.
#   Those fields are populated ONLY by `render_draw_ir_composition[_resources]`.
#   So "invalidate_frame_receipt forces next frame_provenance to change" is
#   pinned here across a render -> invalidate transition (checksum/width/
#   height/stride/format/composition_id/scene_key go from real values back
#   to their zero/empty defaults), not across a bare `clear()` call.

use std.spec.{describe, it, expect}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend, host_wm_render_backend_key}
use common.ui.draw_ir.{draw_ir_batch, draw_ir_composition, draw_ir_embedding_config, draw_ir_rect}
use std.nogc_sync_mut.env.variables.{env_set, env_unset}

fn surface_fixture(color: u32):
    val embedding = draw_ir_embedding_config("web", "body", 0, 0, 4, 4, 0, 1000, true)
    draw_ir_composition("surface-test", "hosted-web", "software", [
        draw_ir_batch("body", "software", embedding, [
            draw_ir_rect("fill", 0, 0, 4, 4, color)
        ])
    ])

use std.spec.step

describe "Engine2dCompositorBackend — create_from_env / selected_backend":
    it "create_from_env with SIMPLE_GUI_BACKEND unset resolves selected_backend to the software engine name":
        step("Verify: create_from_env with SIMPLE_GUI_BACKEND unset resolves selected_backend to the software engine name")
        # @req: REQ-OS-COMPOSITOR-001
        env_unset("SIMPLE_GUI_BACKEND")
        var raster = Engine2dCompositorBackend.create_from_env(4, 4)
        expect(raster.selected_backend()).to_equal("software")
        raster.shutdown()

    it "create_from_env with SIMPLE_GUI_BACKEND=software resolves selected_backend to software":
        step("Verify: create_from_env with SIMPLE_GUI_BACKEND=software resolves selected_backend to software")
        env_set("SIMPLE_GUI_BACKEND", "software")
        var raster = Engine2dCompositorBackend.create_from_env(4, 4)
        expect(raster.selected_backend()).to_equal("software")
        env_unset("SIMPLE_GUI_BACKEND")
        raster.shutdown()

    it "create_from_env with an unrecognised SIMPLE_GUI_BACKEND value does not crash and lands on cpu":
        step("Verify: create_from_env with an unrecognised SIMPLE_GUI_BACKEND value does not crash and lands on cpu")
        env_set("SIMPLE_GUI_BACKEND", "nonexistent_backend_xyz")
        var raster = Engine2dCompositorBackend.create_from_env(4, 4)
        expect(raster.selected_backend()).to_equal("cpu")
        env_unset("SIMPLE_GUI_BACKEND")
        raster.shutdown()

describe "Engine2dCompositorBackend — host_wm_render_backend_key":
    it "is stable across repeated calls on the same env (pure function of SIMPLE_GUI_BACKEND)":
        step("Verify: is stable across repeated calls on the same env (pure function of SIMPLE_GUI_BACKEND)")
        env_unset("SIMPLE_GUI_BACKEND")
        val k1 = host_wm_render_backend_key()
        val k2 = host_wm_render_backend_key()
        expect(k1).to_equal("software")
        expect(k1).to_equal(k2)

    it "trims and honors an explicit SIMPLE_GUI_BACKEND override":
        step("Verify: trims and honors an explicit SIMPLE_GUI_BACKEND override")
        env_set("SIMPLE_GUI_BACKEND", "  metal  ")
        expect(host_wm_render_backend_key()).to_equal("metal")
        env_unset("SIMPLE_GUI_BACKEND")

describe "Engine2dCompositorBackend — pixel buffer override":
    it "is absent by default, then retained/counted/returned once set":
        step("Verify: is absent by default, then retained/counted/returned once set")
        var raster = Engine2dCompositorBackend.create_named(4, 4, "software")
        expect(raster.retained_pixel_buffer_override_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        var custom: [u32] = [0xFF112233u32; 16]
        raster.set_pixel_buffer_override(custom)
        expect(raster.retained_pixel_buffer_override_count()).to_equal(16)  # oracle: 16 — named expected value from the requirement

        val got = raster.get_pixel_buffer()
        expect(got.len()).to_equal(16)  # oracle: 16 — named expected value from the requirement
        expect(got[0]).to_equal(0xFF112233u32)
        raster.shutdown()

    it "a fresh backend id does not see a prior instance's override (per-id retention)":
        step("Verify: a fresh backend id does not see a prior instance's override (per-id retention)")
        var first = Engine2dCompositorBackend.create_named(4, 4, "software")
        var custom: [u32] = [0xFFAABBCCu32; 16]
        first.set_pixel_buffer_override(custom)
        expect(first.retained_pixel_buffer_override_count()).to_equal(16)  # oracle: 16 — named expected value from the requirement

        var second = Engine2dCompositorBackend.create_named(4, 4, "software")
        expect(second.retained_pixel_buffer_override_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        first.shutdown()
        second.shutdown()

describe "Engine2dCompositorBackend — frame_provenance / invalidate_frame_receipt":
    it "invalidate_frame_receipt resets the readback receipt populated by a real render to its zero/empty defaults":
        step("Verify: invalidate_frame_receipt resets the readback receipt populated by a real render to its zero/empty defaults")
        var raster = Engine2dCompositorBackend.create_named(4, 4, "software")
        val before = raster.frame_provenance()
        expect(before).to_contain("checksum=0")
        expect(before).to_contain("completed=false")

        val result = raster.render_draw_ir_composition_resources(surface_fixture(0xFF2563EBu32), [])
        expect(result.fallback_required).to_equal(false)
        val after_render = raster.frame_provenance()
        expect(after_render).to_contain("completed=true")
        expect(after_render).to_contain("composition_id=surface-test")
        expect(after_render == before).to_equal(false)

        raster.invalidate_frame_receipt()
        val after_invalidate = raster.frame_provenance()
        expect(after_invalidate).to_contain("checksum=0")
        expect(after_invalidate).to_contain("completed=false")
        expect(after_invalidate).to_contain("composition_id=;")
        expect(after_invalidate == after_render).to_equal(false)
        raster.shutdown()

describe "Engine2dCompositorBackend — font_provenance / frame_provenance name the actual backend, not a fabricated value":
    it "font_provenance names bitmap-default identity and a (possibly empty) real execution target, never a hardcoded non-empty identity for an unconfigured font":
        step("Verify: font_provenance names bitmap-default identity and a (possibly empty) real execution target, never a hardcoded non-empty identity for an unconfigured font")
        var raster = Engine2dCompositorBackend.create_named(4, 4, "software")
        val prov = raster.font_provenance()
        expect(prov).to_contain("identity=")
        expect(prov).to_contain("target=")
        raster.shutdown()

    it "frame_provenance names the real selected_backend, not a fabricated constant":
        step("Verify: frame_provenance names the real selected_backend, not a fabricated constant")
        var raster = Engine2dCompositorBackend.create_named(4, 4, "software")
        val prov = raster.frame_provenance()
        expect(prov).to_contain("backend=" + raster.selected_backend() + ";")
        raster.shutdown()
