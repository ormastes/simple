use common.window_protocol.compositor_methods.{COMP_MINIMIZE}
use common.window_protocol.geometry.{Size}
use os.compositor.host_compositor_entry.{HostCompositor}
use os.userlib.ipc_protocol.{COMP_CREATE_WINDOW}

fn main() -> i64:
    var compositor = HostCompositor.new_headless(Size.wh(320, 240))
    compositor.apply_bridge_request(
        1, 10, COMP_CREATE_WINDOW.to_i64(), 0,
        "Window", 31, 47, 180, 140, "", 99, "/sys/apps/window"
    )
    val window_id = compositor.windows[0].id
    compositor.maximize_window(window_id)
    compositor.dragging = true
    compositor.drag_window_id = window_id
    compositor.resizing = true
    compositor.resize_window_id = window_id
    compositor.armed_chrome_target = "close"
    compositor.armed_chrome_window_id = window_id
    compositor.apply_bridge_request(
        2, 0, COMP_MINIMIZE.to_i64(), window_id,
        "", 0, 0, 0, 0, "", 0, ""
    )
    if (compositor.dragging or compositor.drag_window_id != 0 or
        compositor.resizing or compositor.resize_window_id != 0 or
        compositor.armed_chrome_target != "" or
        compositor.armed_chrome_window_id != 0):
        return 1
    compositor.restore_window(window_id)
    if not compositor.windows[0].maximized:
        return 2
    if compositor.windows[0].x != 0 or compositor.windows[0].y != 48:
        return 3
    if compositor.windows[0].h != 136:
        return 4
    compositor.restore_window(window_id)
    if compositor.windows[0].maximized:
        return 5
    if (compositor.windows[0].x != 31 or
        compositor.windows[0].y != 47 or
        compositor.windows[0].w != 180 or
        compositor.windows[0].h != 140):
        return 6
    0
