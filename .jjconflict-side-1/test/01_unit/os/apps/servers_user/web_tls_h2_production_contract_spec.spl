use std.spec.*
use std.fs.{read_file}
use os.apps.web_user.web_tls_provisioning_v1.{WebTlsProvisioningOwnerV1}

describe "WEB TLS H2 production contract":
    it "requires exact H2 or H1 ALPN without a no-ALPN fallback":
        var provisioning = WebTlsProvisioningOwnerV1.new()
        expect(provisioning.admit([1u8], [2u8])).to_be(true)
        val config = provisioning.config().unwrap()
        expect(config.alpn_protocols).to_equal([
            [104u8, 50u8],
            [104u8, 116u8, 116u8, 112u8, 47u8, 49u8, 46u8, 49u8]])
        expect(config.ready_alpn_protocols).to_equal(config.alpn_protocols)
        expect(config.require_alpn).to_be(true)

    it "keeps H2 behind authenticated TLS and nested send transactions":
        val source = read_file(
            "src/os/apps/servers_user/web_tls_h2_v1.spl")
        expect(source).to_contain("stream.ingest(wire)")
        expect(source).to_contain(
            "coordinator.feed_authenticated_plaintext(\n                        plaintext, true)")
        expect(source).to_contain("stream.begin_application(plaintext)")
        expect(source).to_contain("stream.commit_send(prepared.token)")
        expect(source).to_contain("control_owner.commit_control(prepared.token)")
        expect(source).to_contain("response_owner.commit_response(prepared.transaction)")
        expect(source).to_not_contain("socket_send(socket")
        expect(source).to_not_contain("h3")

    it "serves only the existing static routes with GET and HEAD semantics":
        val source = read_file(
            "src/os/apps/servers_user/web_tls_h2_v1.spl")
        expect(source).to_contain("request.method == \"GET\"")
        expect(source).to_contain("request.method == \"HEAD\"")
        expect(source).to_contain("request.path == \"/\"")
        expect(source).to_contain("request.path == \"/SERVER.HTM\"")
        expect(source).to_contain("val body: [u8] = if head_only: []")
        expect(source).to_contain("prepare_head_response_v1")
        expect(source).to_contain("value: body_length.to_text()")
        expect(source).to_contain("text_to_bytes_pure(\"ERR route not found\\n\")")
