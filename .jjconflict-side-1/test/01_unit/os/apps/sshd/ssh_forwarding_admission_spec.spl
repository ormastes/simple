use os.apps.sshd.ssh_channel.{ChannelTable, SSH_MSG_CHANNEL_OPEN_FAILURE, SSH_OPEN_UNKNOWN_CHANNEL_TYPE}
use os.apps.sshd.ssh_channel_open_request.*
use os.apps.sshd.ssh_global_request.*

fn _forwarding_u32_be(out: [u8], value: u32) -> [u8]:
    var bytes = out
    bytes.push(((value >> 24u32) & 255u32).to_u8())
    bytes.push(((value >> 16u32) & 255u32).to_u8())
    bytes.push(((value >> 8u32) & 255u32).to_u8())
    bytes.push((value & 255u32).to_u8())
    bytes

fn _forwarding_channel_open(kind: [u8], sender: u32, tail: [u8]) -> [u8]:
    var packet: [u8] = [90u8]
    packet = _forwarding_u32_be(packet, kind.len().to_u32())
    for byte in kind:
        packet.push(byte)
    packet = _forwarding_u32_be(packet, sender)
    packet = _forwarding_u32_be(packet, 4096u32)
    packet = _forwarding_u32_be(packet, 1024u32)
    for byte in tail:
        packet.push(byte)
    packet

fn _forwarding_global_request(name: [u8], want_reply: u8, tail: [u8]) -> [u8]:
    var packet: [u8] = [SSH_MSG_GLOBAL_REQUEST]
    packet = _forwarding_u32_be(packet, name.len().to_u32())
    for byte in name:
        packet.push(byte)
    packet.push(want_reply)
    for byte in tail:
        packet.push(byte)
    packet

describe "SSHD forwarding admission is fail closed":
    it "rejects direct-tcpip before a channel-table allocation":
        val channels = ChannelTable.new()
        val request = ssh_channel_open_request_classify_v1(
            _forwarding_channel_open(
                [0x64u8, 0x69u8, 0x72u8, 0x65u8, 0x63u8, 0x74u8,
                 0x2Du8, 0x74u8, 0x63u8, 0x70u8, 0x69u8, 0x70u8],
                41u32,
                # destination/origin address and port fields are opaque because
                # this SSHD never authorizes or opens forwarding sockets.
                [0u8, 0u8, 0u8, 9u8, 0x31u8, 0x32u8, 0x37u8, 0x2Eu8,
                 0x30u8, 0x2Eu8, 0x30u8, 0x2Eu8, 0x31u8, 0u8, 0u8,
                 0u8, 22u8]
            )
        )
        expect(request.kind).to_equal(SshChannelOpenRequestKindV1.Unsupported)
        expect(channels.channels.len()).to_equal(0u64)
        val reply = ssh_channel_open_rejection_payload_v1(request)
        expect(reply[0u64]).to_equal(SSH_MSG_CHANNEL_OPEN_FAILURE)
        expect(reply[4u64]).to_equal(41u8)
        expect(reply[8u64]).to_equal(SSH_OPEN_UNKNOWN_CHANNEL_TYPE.to_u8())

    it "rejects forwarded-tcpip and both streamlocal channel families":
        val names: [[u8]] = [
            [0x66u8, 0x6Fu8, 0x72u8, 0x77u8, 0x61u8, 0x72u8, 0x64u8,
             0x65u8, 0x64u8, 0x2Du8, 0x74u8, 0x63u8, 0x70u8, 0x69u8, 0x70u8],
            [0x64u8, 0x69u8, 0x72u8, 0x65u8, 0x63u8, 0x74u8, 0x2Du8,
             0x73u8, 0x74u8, 0x72u8, 0x65u8, 0x61u8, 0x6Du8, 0x6Cu8,
             0x6Fu8, 0x63u8, 0x61u8, 0x6Cu8, 0x40u8, 0x6Fu8, 0x70u8,
             0x65u8, 0x6Eu8, 0x73u8, 0x73u8, 0x68u8, 0x2Eu8, 0x63u8,
             0x6Fu8, 0x6Du8],
            [0x66u8, 0x6Fu8, 0x72u8, 0x77u8, 0x61u8, 0x72u8, 0x64u8,
             0x65u8, 0x64u8, 0x2Du8, 0x73u8, 0x74u8, 0x72u8, 0x65u8,
             0x61u8, 0x6Du8, 0x6Cu8, 0x6Fu8, 0x63u8, 0x61u8, 0x6Cu8,
             0x40u8, 0x6Fu8, 0x70u8, 0x65u8, 0x6Eu8, 0x73u8, 0x73u8,
             0x68u8, 0x2Eu8, 0x63u8, 0x6Fu8, 0x6Du8]
        ]
        for name in names:
            val request = ssh_channel_open_request_classify_v1(
                _forwarding_channel_open(name, 7u32, [0u8, 0u8, 0u8, 0u8])
            )
            expect(request.kind).to_equal(SshChannelOpenRequestKindV1.Unsupported)
            expect(ssh_channel_open_rejection_payload_v1(request)[8u64]).to_equal(
                SSH_OPEN_UNKNOWN_CHANNEL_TYPE.to_u8())

    it "fails all TCP and streamlocal global forward lifecycle requests":
        val names: [[u8]] = [
            [0x74u8, 0x63u8, 0x70u8, 0x69u8, 0x70u8, 0x2Du8, 0x66u8,
             0x6Fu8, 0x72u8, 0x77u8, 0x61u8, 0x72u8, 0x64u8],
            [0x63u8, 0x61u8, 0x6Eu8, 0x63u8, 0x65u8, 0x6Cu8, 0x2Du8,
             0x74u8, 0x63u8, 0x70u8, 0x69u8, 0x70u8, 0x2Du8, 0x66u8,
             0x6Fu8, 0x72u8, 0x77u8, 0x61u8, 0x72u8, 0x64u8],
            [0x73u8, 0x74u8, 0x72u8, 0x65u8, 0x61u8, 0x6Du8, 0x6Cu8,
             0x6Fu8, 0x63u8, 0x61u8, 0x6Cu8, 0x2Du8, 0x66u8, 0x6Fu8,
             0x72u8, 0x77u8, 0x61u8, 0x72u8, 0x64u8, 0x40u8, 0x6Fu8,
             0x70u8, 0x65u8, 0x6Eu8, 0x73u8, 0x73u8, 0x68u8, 0x2Eu8,
             0x63u8, 0x6Fu8, 0x6Du8],
            [0x63u8, 0x61u8, 0x6Eu8, 0x63u8, 0x65u8, 0x6Cu8, 0x2Du8,
             0x73u8, 0x74u8, 0x72u8, 0x65u8, 0x61u8, 0x6Du8, 0x6Cu8,
             0x6Fu8, 0x63u8, 0x61u8, 0x6Cu8, 0x2Du8, 0x66u8, 0x6Fu8,
             0x72u8, 0x77u8, 0x61u8, 0x72u8, 0x64u8, 0x40u8, 0x6Fu8,
             0x70u8, 0x65u8, 0x6Eu8, 0x73u8, 0x73u8, 0x68u8, 0x2Eu8,
             0x63u8, 0x6Fu8, 0x6Du8]
        ]
        for name in names:
            val decision = ssh_global_request_classify(
                _forwarding_global_request(name, 1u8, [0u8, 0u8, 0u8, 0u8])
            )
            expect(decision).to_equal(SshGlobalRequestDecisionV1.ReplyFailure)
            expect(ssh_global_request_reply_payload(decision)).to_equal(
                [SSH_MSG_REQUEST_FAILURE])

    it "does not create a hidden forwarding lifecycle when no reply was requested":
        val decision = ssh_global_request_classify(_forwarding_global_request(
            [0x74u8, 0x63u8, 0x70u8, 0x69u8, 0x70u8, 0x2Du8, 0x66u8,
             0x6Fu8, 0x72u8, 0x77u8, 0x61u8, 0x72u8, 0x64u8],
            0u8,
            [0u8, 0u8, 0u8, 0u8]
        ))
        expect(decision).to_equal(SshGlobalRequestDecisionV1.NoReply)
        expect(ssh_global_request_reply_payload(decision)).to_equal([])
