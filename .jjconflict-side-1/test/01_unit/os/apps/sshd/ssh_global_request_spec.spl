use os.apps.sshd.ssh_global_request.*

fn global_request(name: [u8], want_reply: u8, tail: [u8]) -> [u8]:
    var out: [u8] = [SSH_MSG_GLOBAL_REQUEST]
    val n = name.len().to_u32()
    out.push(((n / 16777216u32) % 256u32).to_u8())
    out.push(((n / 65536u32) % 256u32).to_u8())
    out.push(((n / 256u32) % 256u32).to_u8())
    out.push((n % 256u32).to_u8())
    for byte in name:
        out.push(byte)
    out.push(want_reply)
    for byte in tail:
        out.push(byte)
    out

fn keepalive_name() -> [u8]:
    [0x6Bu8, 0x65u8, 0x65u8, 0x70u8, 0x61u8, 0x6Cu8, 0x69u8,
     0x76u8, 0x65u8, 0x40u8, 0x6Fu8, 0x70u8, 0x65u8, 0x6Eu8,
     0x73u8, 0x73u8, 0x68u8, 0x2Eu8, 0x63u8, 0x6Fu8, 0x6Du8]

describe "bounded SSH global requests":
    it "answers an exact OpenSSH keepalive with unsupported-request failure":
        val decision = ssh_global_request_classify(global_request(keepalive_name(), 1u8, []))
        expect(decision).to_equal(SshGlobalRequestDecisionV1.ReplyFailure)
        expect(ssh_global_request_reply_payload(decision)).to_equal([SSH_MSG_REQUEST_FAILURE])

    it "fails an unsupported request when a reply was requested":
        val decision = ssh_global_request_classify(global_request([0x78u8], 1u8, [0x01u8]))
        expect(decision).to_equal(SshGlobalRequestDecisionV1.ReplyFailure)
        expect(ssh_global_request_reply_payload(decision)).to_equal([SSH_MSG_REQUEST_FAILURE])

    it "emits no response when want-reply is false":
        val decision = ssh_global_request_classify(global_request([0x78u8], 0u8, []))
        expect(decision).to_equal(SshGlobalRequestDecisionV1.NoReply)
        expect(ssh_global_request_reply_payload(decision)).to_equal([])

    it "also fails a keepalive carrying request-specific trailing data":
        val decision = ssh_global_request_classify(global_request(keepalive_name(), 1u8, [0u8]))
        expect(decision).to_equal(SshGlobalRequestDecisionV1.ReplyFailure)

    it "rejects a truncated request name":
        expect(ssh_global_request_classify([80u8, 0u8, 0u8, 0u8, 1u8])).to_equal(SshGlobalRequestDecisionV1.Malformed)

    it "treats an empty complete name as an unsupported request":
        val decision = ssh_global_request_classify(global_request([], 1u8, []))
        expect(decision).to_equal(SshGlobalRequestDecisionV1.ReplyFailure)

    it "treats a complete name longer than 256 bytes as unsupported":
        var long_name: [u8] = []
        var i: u64 = 0u64
        while i < 257u64:
            long_name.push(0x78u8)
            i = i + 1u64
        val decision = ssh_global_request_classify(global_request(long_name, 1u8, []))
        expect(decision).to_equal(SshGlobalRequestDecisionV1.ReplyFailure)
