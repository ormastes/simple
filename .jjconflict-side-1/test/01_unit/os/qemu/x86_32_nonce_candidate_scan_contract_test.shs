#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
runtime="$root/examples/09_embedded/simple_os/arch/x86_32/boot/baremetal_stubs.c"
image="${X86_32_NONCE_IMAGE:-/mnt/data/.simple/qemu/artifacts/sosix-qemu/linux/diagnostic/nonce-four-20260812T031000Z/x86_32.img}"

grep -q 'if (!valid || end >= len || base\[end\] !=.*continue;' "$runtime"
! grep -q 'end == i + j) return 0;' "$runtime"

perl - "$image" <<'PERL'
use strict;
use warnings;
my ($path) = @ARGV;
open my $fh, '<:raw', $path or die "open $path: $!\n";
local $/;
my $data = <$fh>;
my $prefix = 'SIMPLEOS_QEMU_NONCE=';
my @offsets;
my $at = 0;
while (($at = index($data, $prefix, $at)) >= 0) {
    push @offsets, $at++;
}
die "fixture must contain a decoy followed by real nonce\n" unless @offsets >= 2;
my $first_tail = substr($data, $offsets[0] + length($prefix), 1);
die "first candidate is unexpectedly valid\n" if $first_tail =~ /[A-Za-z0-9._:-]/;
my $valid = 0;
for my $off (@offsets) {
    my $tail = substr($data, $off + length($prefix), 118 - length($prefix));
    if ($tail =~ /\A([A-Za-z0-9._:-]+)\n/) {
        $valid = 1;
        print "PASS x86_32 nonce scanner skips decoy=$offsets[0] real=$off nonce=$1\n";
        last;
    }
}
die "no valid nonce after decoy\n" unless $valid;
PERL
