use std.spec
use std.common.debug.contracts_v1.{
    DebugPerturbationV1, DebugRootOperationV1,
    debug_policy_observe_only_v1,
}
use std.common.debug.service_v1.{central_debug_service_v1_graph, central_debug_service_v1_receipts}
use os.realtime.jtag.openocd_probe.OpenOcdProbe
use os.realtime.jtag.debug_service_adapter_v1.{
    OpenOcdActionV1, OpenOcdDebugServiceAdapterV1,
    openocd_action_operation_v1, openocd_action_perturbation_v1,
}

describe "OpenOCD DebugServiceV1 harmony adapter":
    it "classifies reads as passive inspection and execution control as stopping":
        expect(openocd_action_operation_v1(OpenOcdActionV1.ReadMemory)).to_equal(DebugRootOperationV1.Inspect)
        expect(openocd_action_perturbation_v1(OpenOcdActionV1.ReadRegister)).to_equal(DebugPerturbationV1.Passive)
        expect(openocd_action_operation_v1(OpenOcdActionV1.Halt)).to_equal(DebugRootOperationV1.Control)
        expect(openocd_action_perturbation_v1(OpenOcdActionV1.Resume)).to_equal(DebugPerturbationV1.Stopping)

    it "classifies monitor flash reset and writes as mutating":
        expect(openocd_action_operation_v1(OpenOcdActionV1.RawMonitor)).to_equal(DebugRootOperationV1.Domain)
        expect(openocd_action_perturbation_v1(OpenOcdActionV1.RawMonitor)).to_equal(DebugPerturbationV1.Mutating)
        expect(openocd_action_perturbation_v1(OpenOcdActionV1.Flash)).to_equal(DebugPerturbationV1.Mutating)
        expect(openocd_action_perturbation_v1(OpenOcdActionV1.Reset)).to_equal(DebugPerturbationV1.Mutating)
        expect(openocd_action_perturbation_v1(OpenOcdActionV1.WriteMemory)).to_equal(DebugPerturbationV1.Mutating)

    it "binds the existing resource to the central target graph without claiming live verification":
        var probe = OpenOcdProbe.new("127.0.0.1", 6666, "riscv32")
        probe.connected = true
        var adapter = OpenOcdDebugServiceAdapterV1.create(probe)
        val session_id = adapter.bind("build-openocd-fixture", "openocd://fixture/probe0", debug_policy_observe_only_v1()).unwrap()
        val graph = central_debug_service_v1_graph(session_id).unwrap()
        expect(graph.nodes.len()).to_equal(1)
        expect(graph.nodes[0].target_id).to_equal("openocd://fixture/probe0")
        expect(graph.nodes[0].kind).to_equal("embedded.openocd-jtag")
        expect(graph.capabilities[0].reason).to_contain("existing OpenOCD JTAG resource")
        adapter.close(session_id).unwrap()

    it "denies stopping and mutating commands before invoking the transport owner":
        var probe = OpenOcdProbe.new("127.0.0.1", 6666, "arm")
        probe.connected = true
        var adapter = OpenOcdDebugServiceAdapterV1.create(probe)
        val session_id = adapter.bind("build-openocd-deny", "openocd://fixture/probe1", debug_policy_observe_only_v1()).unwrap()
        val halt_result = adapter.halt(session_id)
        val flash_result = adapter.flash(session_id, "firmware.elf")
        expect(halt_result.is_err()).to_equal(true)
        expect(flash_result.is_err()).to_equal(true)
        val receipts = central_debug_service_v1_receipts(session_id)
        expect(receipts.any(\receipt: receipt.action == "openocd.halt" and not receipt.allowed)).to_equal(true)
        expect(receipts.any(\receipt: receipt.action == "openocd.flash" and not receipt.allowed)).to_equal(true)
        adapter.close(session_id).unwrap()

    it "rejects unconnected resources and foreign session ids":
        val disconnected = OpenOcdProbe.new("127.0.0.1", 6666, "arm")
        var rejected = OpenOcdDebugServiceAdapterV1.create(disconnected)
        expect(rejected.bind("build-openocd", "openocd://fixture/disconnected", debug_policy_observe_only_v1()).is_err()).to_equal(true)

        var connected = OpenOcdProbe.new("127.0.0.1", 6666, "arm")
        connected.connected = true
        var adapter = OpenOcdDebugServiceAdapterV1.create(connected)
        val session_id = adapter.bind("build-openocd-owner", "openocd://fixture/probe2", debug_policy_observe_only_v1()).unwrap()
        val other = std.common.debug.contracts_v1.DebugSessionId(value: "debug-not-owner")
        expect(adapter.poll_halted(other).is_err()).to_equal(true)
        adapter.close(session_id).unwrap()
