# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/os/libc/simpleos_libc.c 60%
"""
# POSIX Honest-Failure Specification

Lane P5 (POSIX truth) forbids stubs that silently report fake success for a
facility the SimpleOS L4 syscall path does not actually implement. This spec
pins two honest-failure contracts on the guest libc shim
(`src/os/libc/simpleos_libc.c`):

1. `mmap()` on the SimpleOS syscall path (the non-Linux-host branch — the
   Linux-host branch is a real passthrough syscall and is out of scope) must
   fail closed with `EOPNOTSUPP` for a writable `MAP_SHARED` request and for
   any fd-backed (file-backed) request, instead of silently discarding
   `flags`/`fd`/`offset` and handing back an anonymous private mapping that
   looks like success but is neither shared nor file-backed. See
   `doc/02_requirements/os/posix_profiles.md` and
   `src/os/posix/mod.spl` ("writable POSIX shared-memory mmap" is documented
   as NOT supported by design).
2. `pthread_create()` and condition-variable wait/wake calls must report
   `ENOSYS`, never a fake success code, since
   SimpleOS has no kernel thread support behind the guest libc yet.

The guest-only `mmap()` branch only executes when `running_on_linux_host()`
is false (real SimpleOS kernel, not a host Linux ELF run for cross-toolchain
bring-up), so it cannot be exercised by spawning a host-compiled binary from
this spec. Instead this spec pins the honest-failure contract directly on
the shipped source text, so a regression that reintroduces the silent
downgrade is caught the moment the source changes back.
"""

use std.spec.step

use std.spec
use std.spec.step
use app.io.mod.{file_read_text}


fn libc_source() -> text:
    file_read_text("src/os/libc/simpleos_libc.c")

fn pthread_source() -> text:
    file_read_text("src/os/libc/simpleos_pthread.c")

fn pthread_cond_source() -> text:
    file_read_text("src/os/libc/simpleos_pthread_cond.c")

fn filelock_source() -> text:
    file_read_text("src/os/libc/simpleos_filelock.c")

fn process_wait_source() -> text:
    file_read_text("src/os/libc/simpleos_process_wait.c")

fn signal_source() -> text:
    file_read_text("src/os/libc/simpleos_signal.c")

fn time_source() -> text:
    file_read_text("src/os/libc/simpleos_time.c")

fn process_source() -> text:
    file_read_text("src/os/libc/simpleos_process.c")

fn libc_ext_source() -> text:
    file_read_text("src/os/libc/simpleos_libc_ext.c")

fn sched_source() -> text:
    file_read_text("src/os/libc/simpleos_sched.c")

describe "mmap honest failure on the SimpleOS syscall path":
    # @manual scenario evidence
    it "loads the guest libc shim source":
        # @req REQ-SSPEC-UNIT
        step("loads the guest libc shim source")
        val src = libc_source()
        expect(src.len() > 0).to_equal(true)

    it "rejects a writable MAP_SHARED request with EOPNOTSUPP":
        # @req REQ-SSPEC-UNIT
        step("rejects a writable MAP_SHARED request with EOPNOTSUPP")
        val src = libc_source()
        expect(src).to_contain("(flags & MAP_SHARED) != 0 && (prot & PROT_WRITE) != 0")
        expect(src).to_contain("errno = EOPNOTSUPP;")

    it "rejects an fd-backed (file-backed) mmap request instead of silently going anonymous":
        # @req REQ-SSPEC-UNIT
        step("rejects an fd-backed (file-backed) mmap request instead of silently going anonymous")
        val src = libc_source()
        expect(src).to_contain("if (fd >= 0)")

    it "no longer discards flags and fd unconditionally before the syscall":
        # @req REQ-SSPEC-UNIT
        step("no longer discards flags and fd unconditionally before the syscall")
        val src = libc_source()
        # The old lie: `(void)flags; (void)fd; (void)offset;` right before
        # dispatching syscall 10 unconditionally, with no honesty check
        # in between. The fixed source keeps `(void)offset;` alone (offset
        # is genuinely meaningless once file-backed requests are rejected)
        # but must not still contain the three-in-one discard.
        expect(src).to_contain("(void)offset;")
        expect(src.contains("(void)flags; (void)fd; (void)offset;")).to_equal(false)

describe "pthread_create honest failure":
    it "loads the guest pthread shim source":
        # @req REQ-SSPEC-UNIT
        step("loads the guest pthread shim source")
        val src = pthread_source()
        expect(src.len() > 0).to_equal(true)

    it "reports ENOSYS instead of faking a created thread":
        # @req REQ-SSPEC-UNIT
        step("reports ENOSYS instead of faking a created thread")
        val src = pthread_source()
        expect(src).to_contain("int pthread_create(pthread_t *thread, const pthread_attr_t *attr,")
        expect(src).to_contain("return ENOSYS;")

    it "defines every declared detach-state accessor":
        val src = pthread_source()
        expect(src).to_contain("int pthread_attr_getdetachstate(const pthread_attr_t *attr, int *state)")
        expect(src).to_contain("*state = PTHREAD_CREATE_JOINABLE;")

describe "pthread condition variables fail closed without a kernel wait owner":
    it "does not report fake success from wait or wake calls":
        val src = pthread_cond_source()
        expect(src).to_contain("int pthread_cond_wait(pthread_cond_t *cond, pthread_mutex_t *mutex)")
        expect(src).to_contain("int pthread_cond_timedwait(pthread_cond_t *cond, pthread_mutex_t *mutex,")
        expect(src).to_contain("return ENOSYS;")
        expect(src.contains("return ETIMEDOUT;")).to_equal(false)

describe "flock honest failure without a kernel advisory-lock owner":
    it "does not claim an exclusive lock it cannot track":
        val src = filelock_source()
        expect(src).to_contain("int flock(int fd, int operation)")
        expect(src).to_contain("return ENOSYS;")
        expect(src.contains("return 0;")).to_equal(false)

describe "resource governance fails closed without a kernel accounting owner":
    it "does not fabricate resource limits or CPU/RSS receipts":
        val src = process_wait_source()
        expect(src).to_contain("int getrusage(int who, struct rusage *usage)")
        expect(src).to_contain("int getrlimit(int resource, struct rlimit *rlim)")
        expect(src).to_contain("int setrlimit(int resource, const struct rlimit *rlim)")
        expect(src).to_contain("errno = ENOSYS;")
        expect(src.contains("rlim->rlim_cur = RLIM_INFINITY;")).to_equal(false)

    it "rejects wait4 usage before it can reap a child":
        val src = process_wait_source()
        expect(src).to_contain("if (usage) {")
        expect(src).to_contain("return (pid_t)-1;")

describe "signal masking fails closed without a kernel mask owner":
    it "rejects requested masks and all unsupported handler registration":
        val src = signal_source()
        expect(src).to_contain("int sigprocmask(int how, const sigset_t *set, sigset_t *oldset)")
        expect(src).to_contain("if (set) {")
        expect(src).to_contain("sighandler_t signal(int signum, sighandler_t handler)")
        expect(src).to_contain("if (act) {")
        expect(src).to_contain("errno = ENOSYS;")

describe "nanosleep propagates kernel failure instead of fabricating completion":
    it "validates its request and reports the syscall errno":
        val src = time_source()
        expect(src).to_contain("if (!req || req->tv_sec < 0 || req->tv_nsec < 0")
        expect(src).to_contain("int64_t result = simpleos_syscall(51, nanos")
        expect(src).to_contain("errno = (int)(-result);")
        expect(src).to_contain("if (!tp)")
        expect(src).to_contain("if (!tv)")

    it "keeps sleep and usleep on the same syscall error contract":
        val src = process_source()
        expect(src).to_contain("int64_t result = simpleos_syscall(51")
        expect(src).to_contain("errno = (int)(-result);")
        expect(src).to_contain("return seconds;")

    it "does not claim a positive SIGALRM request was armed":
        val src = process_source()
        expect(src).to_contain("if (seconds != 0) {")
        expect(src).to_contain("errno = ENOSYS;")

describe "environment entries use checked owned allocation":
    it "rejects invalid names and prevents entry-size wraparound":
        val src = process_source()
        expect(src).to_contain("static int _env_entry_size")
        expect(src).to_contain("if (name_len > (size_t)-1 - 2) return 0;")
        expect(src).to_contain("if (!_env_name_valid(name) || !value)")
        expect(src).to_contain("free(previous);")

describe "credentials fail closed without a kernel credential owner":
    it "does not fabricate root uid or gid":
        val src = process_source()
        expect(src).to_contain("uid_t getuid(void)")
        expect(src).to_contain("gid_t getgid(void)")
        expect(src).to_contain("uid_t geteuid(void)")
        expect(src).to_contain("gid_t getegid(void)")
        expect(src).to_contain("return (uid_t)-1;")
        expect(src).to_contain("return (gid_t)-1;")

describe "realpath fails closed until VFS owns canonical resolution":
    it "does not return a copied spelling as a containment oracle":
        val src = libc_ext_source()
        expect(src).to_contain("char *realpath(const char *path, char *resolved)")
        expect(src).to_contain("errno = ENOSYS;")
        expect(src).to_contain("return NULL;")
        expect(src.contains("strncpy(resolved, path, 4095)")).to_equal(false)

describe "madvise fails closed without a VM advice owner":
    it "does not report discarded memory advice as successful":
        val src = libc_ext_source()
        expect(src).to_contain("int madvise(void *addr, size_t length, int advice)")
        expect(src).to_contain("errno = ENOSYS;")
        expect(src.contains("(void)advice;\n    return 0;")).to_equal(false)

describe "formatted input fails closed without a parser owner":
    it "does not collapse unsupported parsing into zero assignments":
        val src = libc_ext_source()
        expect(src).to_contain("int scanf(const char *fmt, ...)")
        expect(src).to_contain("int fscanf(FILE *stream, const char *fmt, ...)")
        expect(src).to_contain("int sscanf(const char *str, const char *fmt, ...)")
        expect(src).to_contain("int vsscanf(const char *str, const char *fmt, va_list ap)")
        expect(src).to_contain("return EOF;")

describe "sched_yield reaches the kernel scheduler owner":
    it "does not fabricate a successful local yield":
        val src = sched_source()
        expect(src).to_contain("#define SIMPLEOS_SYS_YIELD 1")
        expect(src).to_contain("simpleos_syscall(SIMPLEOS_SYS_YIELD, 0, 0, 0, 0, 0)")
        expect(src).to_contain("errno = (int)(-result);")
