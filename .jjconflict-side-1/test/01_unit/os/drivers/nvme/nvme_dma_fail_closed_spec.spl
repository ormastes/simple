use std.spec.{describe, it, expect}
use std.fs.{read_file}

describe "NVMe target DMA allocation":
    it "fails closed instead of using the native runtime allocator":
        val source = read_file("src/os/drivers/nvme/_NvmeDriver/driver_operations.spl")
        expect(source).to_contain("return Result.Err(\"DMA allocation syscall failed\")")
        expect(source).to_contain("return Result.Err(\"DMA allocation returned zero address\")")
        expect(source).to_not_contain("rt_dma_alloc")
        expect(source).to_not_contain("rt_dma_phys_of")
