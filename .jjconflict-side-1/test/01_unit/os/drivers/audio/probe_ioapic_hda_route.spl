use os.kernel.boot.mmio.{
    mmio_reset_for_test,
    mmio_read32,
}
use os.kernel.interrupts.ioapic.{
    IOAPIC_BASE,
    ioapic_intx_low_value,
    ioapic_route_intx,
    ioapic_mask_intx,
}

fn main() -> i64:
    if (ioapic_intx_low_value(43, false) != 0xA02Bu32 or
        ioapic_intx_low_value(43, true) != 0x1A02Bu32):
        return 1
    mmio_reset_for_test()
    if not ioapic_route_intx(11, 43):
        return 2
    if mmio_read32((IOAPIC_BASE + 0x00) as u64) != 0x26u32:
        return 3
    if mmio_read32((IOAPIC_BASE + 0x10) as u64) != 0xA02Bu32:
        return 4
    if not ioapic_mask_intx(11):
        return 5
    if mmio_read32((IOAPIC_BASE + 0x10) as u64) != 0x1A02Bu32:
        return 6
    if (ioapic_route_intx(24, 56) or
        ioapic_route_intx(11, 31) or
        ioapic_mask_intx(-1)):
        return 7
    0
