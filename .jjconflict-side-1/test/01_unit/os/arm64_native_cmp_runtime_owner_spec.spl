extern fn rt_file_read_text(path: text) -> text

describe "ARM64 freestanding native comparison owner":
    it "owns erased ordering with integer and lexical string semantics":
        val source = rt_file_read_text("examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c") ?? ""
        val header = rt_file_read_text("examples/09_embedded/simple_os/arch/common/baremetal_runtime.h") ?? ""
        expect(source).to_contain("RuntimeValue rt_native_cmp(RuntimeValue left, RuntimeValue right)")
        expect(source).to_contain("left_header->type == HEAP_STRING")
        expect(source).to_contain("left_byte < right_byte ? -1 : 1")
        expect(source).to_contain("(int64_t)left < (int64_t)right ? -1 : 1")
        expect(header).to_contain("RuntimeValue rt_native_cmp(RuntimeValue left, RuntimeValue right);")

