# Regression spec for doc/08_tracking/bug/pub_reserved_identifier_undocumented_2026-08-10.md
#
# Repro: `pub` lexes as a keyword everywhere (`val pub = ...` -> "expected
# pattern, found Pub") but was absent from the documented reserved-keyword
# lists, so the failure read as a parser bug. Resolution chose option (a):
# document it. These specs FAIL if `pub` drops out of either list again.
extern fn rt_file_read_text(path: text) -> text

fn doc_text(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "pub is documented as reserved (repro)":
    it "syntax quick reference lists pub among reserved keywords":
        val src = doc_text("doc/07_guide/quick_reference/syntax_quick_reference.md")
        expect(src).to_contain("Reserved keywords that cannot be used as identifiers")
        expect(src).to_contain("`pub`")

    it "language rules reserved-keyword line includes pub":
        val src = doc_text(".claude/rules/language.md")
        expect(src).to_contain("**Reserved keywords:**")
        expect(src).to_contain("`and_then`, `pub`")

describe "known reserved identifiers stay documented (generalization)":
    it "the quick-reference reserved line carries the full known set":
        val src = doc_text("doc/07_guide/quick_reference/syntax_quick_reference.md")
        for kw in ["gen", "val", "def", "exists", "actor", "assert", "join", "pass_todo", "pass_do_nothing", "pass_dn", "examples", "and_then", "pub"]:
            assert_contains(src, "`{kw}`")
