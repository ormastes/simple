# NEGATIVE fixture, `@extern` ATTRIBUTE form. Same promise as the sibling
# `negative/` fixture, written the other way round: `lane_definitely_absent_at_probe`
# is implemented NOWHERE. This form took a different parse path -- a bodyless
# `@extern fn` became an ordinary FunctionDef with an empty body, which MIR
# lowered to an `Unreachable` terminator and the mangler emitted as a STRONG
# module-mangled DEFINITION (`ud2`). The build exited 0 and the binary SIGILLed.
# Building this MUST fail with a diagnostic naming the symbol.
@extern fn lane_definitely_absent_at_probe(x: i64) -> i64

fn main():
    print("got " + lane_definitely_absent_at_probe(3).to_string())
