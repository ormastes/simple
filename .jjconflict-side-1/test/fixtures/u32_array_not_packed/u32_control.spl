# RSS-delta canary control leg: a small `[u32]` array, to baseline the
# process's fixed overhead before comparing against u32_large.spl.
# See check-u32-array-not-packed.shs and
# doc/08_tracking/bug/rt_typed_words_u32_is_not_a_packed_pixel_basis_2026-08-06.md.
fn main():
    var a: [u32] = []
    var i: i64 = 0
    while i < 100:
        a.push((i & 0xffffffff) as u32)
        i = i + 1
    println("len=" + a.len().to_text())
