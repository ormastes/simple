extern fn rt_fixture_called(value: i64) -> i64
extern fn rt_fixture_value(value: i64) -> i64
unsafe extern fn rt_fixture_unsafe(value: i64) -> i64
@extern("C", "rt_fixture_alias")
fn fixture_alias(value: i64) -> i64

fn use_fixture() -> i64:
    val callback = rt_fixture_value
    callback(rt_fixture_called(1)) + rt_fixture_unsafe(1) + fixture_alias(1)
