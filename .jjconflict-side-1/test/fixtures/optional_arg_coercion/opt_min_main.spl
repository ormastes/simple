# Minimal repro for
# doc/08_tracking/bug/interpreter_bare_arg_not_some_wrapped_at_optional_param_2026-08-04.md
#
# The interpreter does not Some-wrap a bare argument passed to a `T?`
# parameter, so `case Some(n)` matches nothing and the whole `match` falls
# through to the statement after it. The JIT is correct. Run it both ways:
#
#   simple run test/fixtures/optional_arg_coercion/opt_min_main.spl
#     -> MAIN_box=Some:x  MAIN_box_nil=None  MAIN_int=Some:7  MAIN_text=Some:hi
#
#   SIMPLE_RUNTIME_MODE=interpreter SIMPLE_EXECUTION_MODE=interpret \
#     simple run test/fixtures/optional_arg_coercion/opt_min_main.spl
#     -> MAIN_box=FELL_THROUGH  MAIN_box_nil=None
#        MAIN_int=FELL_THROUGH  MAIN_text=FELL_THROUGH
#
# Every spec runs on the second path: test_runner_single.spl forces
# SIMPLE_RUNTIME_MODE=interpreter and SIMPLE_EXECUTION_MODE=interpret for the
# child. This is a plain program, not a spec, so it is not auto-collected --
# a spec asserting either observed value would enshrine one engine's defect.

class Box:
    val tag: text

fn m_box(p: Box?) -> text:
    match p:
        case Some(n):
            return "Some:" + n.tag
        case None:
            return "None"
    "FELL_THROUGH"

fn m_int(p: i64?) -> text:
    match p:
        case Some(n):
            return "Some:{n}"
        case None:
            return "None"
    "FELL_THROUGH"

fn m_text(p: text?) -> text:
    match p:
        case Some(n):
            return "Some:" + n
        case None:
            return "None"
    "FELL_THROUGH"

fn main() -> i64:
    val b = Box(tag: "x")
    print "MAIN_box={m_box(b)}"
    print "MAIN_box_nil={m_box(nil)}"
    print "MAIN_int={m_int(7)}"
    print "MAIN_text={m_text("hi")}"
    0
