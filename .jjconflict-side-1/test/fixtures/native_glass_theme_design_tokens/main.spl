use common.ui.glass.theme.{glass_design_tokens}

fn main() -> i64:
    val aetheric = glass_design_tokens("aetheric_dark")
    if aetheric.colors.surface_primary != "rgba(18,18,31,0.72)": return 41
    if aetheric.colors.text_primary != "#E3E0F3": return 42
    if aetheric.colors.accent != "#C6C6C8": return 43
    if aetheric.blur.surface_blur != 20 or aetheric.blur.elevated_blur != 40: return 44

    val light = glass_design_tokens("glass_light")
    if light.colors.text_primary != "#1D1D1F" or light.colors.accent != "#007AFF": return 45

    val dark = glass_design_tokens("glass_dark")
    if dark.colors.text_primary != "#F5F5F7" or dark.colors.accent != "#0A84FF": return 46

    val unknown = glass_design_tokens("unknown_theme")
    if unknown.colors.surface_primary != dark.colors.surface_primary: return 47

    val passed = true
    print("glass theme design tokens resolved: {passed}")
    if passed: 0 else: 1
