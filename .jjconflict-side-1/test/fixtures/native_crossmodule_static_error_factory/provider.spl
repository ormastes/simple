struct FactoryError:
    message: text
    code: i64

impl FactoryError:
    static fn runtime_error(message: text) -> FactoryError:
        FactoryError(message: message, code: 17)

    static fn type_error(message: text) -> FactoryError:
        FactoryError(message: message, code: 23)

export FactoryError
