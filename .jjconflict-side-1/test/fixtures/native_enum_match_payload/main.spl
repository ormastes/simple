# Fixture for scripts/check/check-native-enum-match-payload.shs
# Bug: doc/08_tracking/bug/match_on_enum_native_lowering_status_2026-08-07.md
#
# Payload-free enum match works under `--native` (LLVM AOT); payload-bearing
# enum match is refused (fail-closed) with a "requires the interpreter"
# diagnostic on that same lane. This fixture exercises both so the fence can
# tell the two apart if/when the payload-bearing gap is ever closed.

enum Kind:
    A
    B
    C

enum Shape:
    Circle(f64)
    Rect(f64, f64)
    Point

fn describe_kind(k: Kind) -> text:
    match k:
        Kind.A: return "kind-A"
        Kind.B: return "kind-B"
        Kind.C: return "kind-C"

fn describe_shape(s: Shape) -> text:
    match s:
        Shape.Circle(r): return "circle:" + r.to_text()
        Shape.Rect(w, h): return "rect:" + w.to_text() + "x" + h.to_text()
        Shape.Point: return "point"

fn main():
    print(describe_kind(Kind.A))
    print(describe_kind(Kind.B))
    print(describe_kind(Kind.C))
    print(describe_shape(Shape.Circle(2.5)))
    print(describe_shape(Shape.Rect(3.0, 4.0)))
    print(describe_shape(Shape.Point))
