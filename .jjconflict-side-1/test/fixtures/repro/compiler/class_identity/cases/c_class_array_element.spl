# F1 corpus case C — array of class refs, mutate through the SECOND element.
# Contract: the slot holds the REFERENCE.
# Prints REF when the contract holds, COPY(n=..) when it is violated.

class CellC:
    n: i64

fn main():
    val first = CellC(n: 120)
    val second = CellC(n: 130)
    val arr = [first, second]
    arr[1].n = 131
    val got = second.n
    if got == 131:
        print "C class array elem[1]  = REF"
    else:
        print "C class array elem[1]  = COPY(n={got})"
