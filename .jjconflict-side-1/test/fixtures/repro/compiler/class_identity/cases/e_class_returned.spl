# F1 corpus case E — a class RETURNED from a function, then stored and mutated.
# Contract: the returned handle and the local are the same object.
# Prints REF when the contract holds, COPY(n=..) when it is violated.

class CellE:
    n: i64

class HolderE:
    cell: CellE

fn make_cell() -> CellE:
    CellE(n: 90)

fn main():
    val c = make_cell()
    val h = HolderE(cell: c)
    c.n = 91
    val got = h.cell.n
    if got == 91:
        print "E class returned       = REF"
    else:
        print "E class returned       = COPY(n={got})"
