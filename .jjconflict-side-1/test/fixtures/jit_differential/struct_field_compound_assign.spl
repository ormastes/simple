# Known bug: `obj.field += v` computes 0<op>rhs (the load side of the
# compound assignment fails to resolve the place) under the default
# (Cranelift JIT) engine -- silently wrong at any depth. See memory
# reference jit-struct-field-compound-assign-loads-zero-2026-07-27 and
# doc/08_tracking/bug/jit_struct_field_compound_assign_loads_zero_2026-07-27.md.
# Expected (interpreter, correct): n=7
struct S:
    n: i64

fn main():
    var s = S(n: 5)
    s.n += 2
    print("n={s.n}")
