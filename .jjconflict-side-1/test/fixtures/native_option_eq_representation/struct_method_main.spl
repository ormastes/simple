# Struct-method variant of the native inlined `Option<text>` return-
# representation defect: doc/08_tracking/bug/native_inlined_option_return_representation_mismatch_2026-08-02.md
#
# The original repro (SdnRow.get("run_id") == Some(run_id)) used a struct
# method. That shape was blocked from 2026-08-06 until 2026-08-08 by an
# unrelated crash (any struct/impl-method call on native-build's --entry
# fast path hit "semantic: undefined field 'kind': cannot access field on
# value of type 'nil'" -- fixed in 100a9aadcc4, see
# src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl:940).
# With that crash gone, this fixture re-verifies the `==` comparison shape
# directly on a struct method (not just the free-function fixture in
# main.spl).
class Lookup:
    id: text

impl Lookup:
    fn get() -> Option<text>:
        if self.id == "":
            return None
        return Some(self.id)

fn main():
    val hit = Lookup(id: "run_id").get()
    val miss = Lookup(id: "run_id").get()
    val absent = Lookup(id: "").get()

    val hit_result = if hit == Some("run_id"): "match" else: "no-match"
    val miss_result = if miss == Some("other_id"): "match" else: "no-match"
    val none_result = if absent == None: "match" else: "no-match"

    print("hit={hit_result} miss={miss_result} none={none_result}")
