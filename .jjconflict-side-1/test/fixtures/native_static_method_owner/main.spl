# Minimal repro for native_build_static_method_owner_unresolved_2026-08-17.
#
# Kept to the SMALLEST program that exercises the defect: a static method called
# through the bare class name. One unsupported operation anywhere in a program
# silently demotes the whole thing to the interpreter, which would make this
# native-lane defect vanish -- so nothing else belongs in this file.
#
# Before the fix, native-build reported:
#     error: MIR lowering error: undefined variable Widget
# because MIR lowering could not recover the owner name "Widget" from the
# receiver and fell through to lowering the bare class name as a VALUE.
class Widget:
    base: i64

    static fn stat(a: i64, b: i64 = 55, c: bool = false) -> i64:
        print("stat a={a} b={b} c={c}\n")
        0

fn main() -> i64:
    Widget.stat(2)
    0
