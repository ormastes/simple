use std.gc_async_mut.gpu.browser_engine.style.custom_properties.{
    has_var_reference, is_custom_property, parse_var_function
}

fn main() -> i64:
    if not is_custom_property("--accent"): return 1
    if not has_var_reference("color: var(--accent, blue)"): return 2
    val parsed = parse_var_function("var(--accent, blue)")
    if parsed.first != "--accent": return 3
    if parsed.second != "blue": return 4
    0
