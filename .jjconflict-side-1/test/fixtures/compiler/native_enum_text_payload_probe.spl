"""Native regression probe for text payload bindings in ordinary enums."""

enum LocalValue:
    Text(value: text)

impl LocalValue:
    fn to_text() -> text:
        match self:
            LocalValue.Text(value): value

fn main() -> i64:
    val value = LocalValue.Text(value: "local").to_text()
    if value != "local":
        print "FAIL local_enum_text=" + value
        return 1
    print "PASS native_enum_text_payload"
    0
