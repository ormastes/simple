# Fixture A for the module-private function name-collision class-detection spec.
# Defines a `_`-prefixed (module-private) helper whose name is deliberately
# shared with the identically-signed helper in private_collision_mod_b.spl,
# but whose body returns a DIFFERENT value.

fn _collision_probe_shared(x: i64) -> i64: x + 1

pub fn probe_a(x: i64) -> i64: _collision_probe_shared(x)
