# Divergence class (h): the value-bound `val v = unsafe(capabilities: [ffi]):`
# block form the stdlib adopted on 2026-08-24 (7ef30bafe0e).
#
# A seed that predates parser fix d2d0bec2e40 parses `unsafe(` as a function
# call and dies `error[E1002]: function 'unsafe' not found` — before printing
# anything. That is exactly the deployed-seed state that made every check
# driver importing env_get blind (deployed_seed_cannot_parse_value_bound_
# unsafe_2026-08-25.md). A lane that prints nothing is an ERROR lane here, so
# this fixture turns "the seed is too old for the stdlib" into a named
# differential ERROR instead of a silent aggregate blind spot.

extern fn rt_env_get(key: text) -> text?

fn main() -> i64:
    val home = unsafe(capabilities: [ffi]):
        rt_env_get("HOME")
    print("home_nonempty=" + ((home ?? "") != "").to_text())
    val missing = unsafe(capabilities: [ffi]):
        rt_env_get("SIMPLE_DEFINITELY_UNSET_VAR_2026_08_25")
    print("missing_is_nil=" + (missing == nil).to_text())
    0
