# Fixture: deliberately violates the raw_rt_access lint by declaring a raw rt_*
# extern outside the privileged runtime tiers. Its ONLY purpose is to prove the
# linter still reports findings -- if lint calls this file clean, the linter has
# stopped biting and the prevention spec must fail.

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn call_it() -> i64:
    val (out, err, code) = rt_process_run("/bin/echo", ["hi"])
    return code
