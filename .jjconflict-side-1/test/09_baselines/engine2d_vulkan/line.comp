#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) buffer Framebuffer { uint pixels[]; } fb;
layout(push_constant) uniform Push {
    int x1; int y1; int x2; int y2; uint color; int thickness;
    int fb_width; int fb_height; int clip_x; int clip_y; int clip_width;
    int clip_height; int clip_enabled; int reserved[3];
} pc;
bool writable(int x, int y) {
    if (x < 0 || y < 0 || x >= pc.fb_width || y >= pc.fb_height) return false;
    return pc.clip_enabled == 0 || (x >= pc.clip_x && y >= pc.clip_y &&
        x < pc.clip_x + pc.clip_width && y < pc.clip_y + pc.clip_height);
}
void main() {
    int x = pc.x1, y = pc.y1;
    int dx = abs(pc.x2 - pc.x1), sx = pc.x1 < pc.x2 ? 1 : -1;
    int dy = -abs(pc.y2 - pc.y1), sy = pc.y1 < pc.y2 ? 1 : -1;
    int err = dx + dy;
    for (;;) {
        if (writable(x, y)) fb.pixels[y * pc.fb_width + x] = pc.color;
        if (x == pc.x2 && y == pc.y2) break;
        int e2 = 2 * err;
        if (e2 >= dy) { err += dy; x += sx; }
        if (e2 <= dx) { err += dx; y += sy; }
    }
}
