schema:
  id: simple.llm_caret.messaging.config/v1
  root: messaging
  fields:
    server:
      required: true
      fields:
        listen: {type: text, required: true, allowed_prefixes: ["unix://", "http://127.0.0.1:", "http://localhost:"]}
        database: {type: text, required: true}
        external_http: {type: bool, default: false}
    defaults:
      fields:
        room_mode: {type: enum, values: [room, mention, keyword, manual], default: mention}
        update_policy: {type: enum, values: [milestones, verbose, final_only, silent], default: milestones}
        previous_messages: {type: i64, minimum: 0, maximum: 20, default: 2}
        mirror_policy: {type: enum, values: [full, metadata_only, off], default: full}
    agents: {type: map, value_schema: agent_binding}
    rooms: {type: map, value_schema: room_policy}
    transports: {type: map, value_schema: transport_binding}
  definitions:
    agent_binding:
      fields:
        provider: {type: enum, values: [claude, codex, gemini], required: true}
        handler: {type: enum, values: [main, subagent, advisor, router], required: true}
        role: {type: text, required: true}
        session_policy: {type: enum, values: [persistent_per_room, persistent_per_thread, new_per_task, existing_main_session], required: true}
    room_policy:
      fields:
        mode: {type: enum, values: [room, mention, keyword, manual], required: true}
        update_policy: {type: enum, values: [milestones, verbose, final_only, silent], required: true}
    transport_binding:
      fields:
        enabled: {type: bool, required: true}
        credential_ref: {type: secret_reference, required: false}
        mirror_policy: {type: enum, values: [full, metadata_only, off], default: full}
