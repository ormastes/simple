#!/bin/sh
# Interpreter-mode wrapper pinned to the deployed Simple binary.
#
# This wrapper used to set nothing at all, so it ran the JIT exactly like plain
# `bin/simple` while its name promised the interpreter. Engine selection is done
# by SIMPLE_EXECUTION_MODE; it is exported here unconditionally so the wrapper
# cannot silently hand back JIT results.
# See doc/07_guide/runtime/execution_engine_selection.md
SIMPLE_EXECUTION_MODE=interpret
export SIMPLE_EXECUTION_MODE

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
runtime_usable() {
  candidate="$1"
  [ -x "$candidate" ] || return 1
  "$candidate" --version >/dev/null 2>&1 || return 1
}

for runtime in \
  "${script_dir}/simple" \
  "${script_dir}/release/simple" \
  "${script_dir}/release/x86_64-unknown-linux-gnu/simple" \
  "${script_dir}/release/linux-x86_64/simple"
do
  if runtime_usable "$runtime"; then
    exec "$runtime" "$@"
  fi
done
printf '%s\n' "error: no Simple runtime found under ${script_dir}" >&2
exit 127
