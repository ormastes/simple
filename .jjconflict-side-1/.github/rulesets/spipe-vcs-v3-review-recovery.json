{
  "name": "spipe-vcs-v3-review-recovery",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/review/*",
        "refs/heads/review/**/*",
        "refs/heads/recovery/*",
        "refs/heads/recovery/**/*"
      ],
      "exclude": []
    }
  },
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"}
  ]
}
