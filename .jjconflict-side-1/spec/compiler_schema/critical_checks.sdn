# Critical-check enforcement manifest — hardening plan Phase 8.
#
# Plan:   doc/03_plan/compiler/hardening/critical_hardening_plan_2026-08-21.md (Phase 8)
# Model:  src/compiler/00.common/assurance/package_pins.spl
# Gate:   scripts/check/check-critical-package-pins.shs
#
# WHAT THIS FILE IS
#   A DECLARED record of every `scripts/check/check-*.shs` gate, its CURRENT
#   enforcement status (`mandatory` = it runs and can block; `advisory` = it
#   exists but nothing blocks on it), the packages it covers, and whether it is
#   a differential check (compares two independent implementations or engines).
#   Seeded 2026-08-21 from the guard list in `.claude/rules/vcs.md`.
#
# WHAT THIS FILE IS NOT
#   It is not a measurement. Nothing here proves a gate runs; a row is a claim
#   that a human recorded and that a reviewer can falsify by reading
#   `.claude/rules/vcs.md` and the pre-push hook. It is written down instead of
#   inferred precisely because "the script exists" is NOT evidence that it
#   enforces anything — the two ADVISORY rows below are both honestly RED on
#   `main` today, and an inference-based model would have laundered them into a
#   green critical pin.
#
# HOW TO CHANGE A ROW
#   Flip `status:` to `mandatory` only when the gate is actually wired into
#   `scripts/check/pre-push-conflict-tree-guard.shs` (or the documented landing
#   flow) AND is green. Promoting a row you have not verified is the same class
#   of error as a fail-open guard.
#
# `covers:` uses PACKAGE names as declared in each package's `simple.sdn`
# `project.name`, not directory paths.

checks:
  - name: check-no-conflict-tree-push.shs
    status: mandatory
    differential: false
    covers:
      - simple-compiler-common
      - simple-compiler
      - simple-std
      - simple-app
  - name: check-no-conflict-markers-push.shs
    status: mandatory
    differential: false
    covers:
      - simple-compiler-common
      - simple-compiler
      - simple-std
      - simple-app
  - name: check-tree-size-push.shs
    status: mandatory
    differential: false
    covers:
      - simple-compiler-common
      - simple-compiler
      - simple-std
      - simple-app
  - name: check-test-tree-divergence.shs
    status: mandatory
    differential: false
    covers:
      - simple-compiler-common
      - simple-compiler
      - simple-std
  - name: check-seed-builds-push.shs
    status: mandatory
    differential: false
    covers:
      - simple-rust-runtime
  - name: check-runtime-api-regression-push.shs
    status: mandatory
    differential: false
    covers:
      - simple-rust-runtime
  - name: check-c-runtime-compiles-push.shs
    status: mandatory
    differential: false
    covers:
      - simple-rust-runtime
  - name: check-no-direct-rt.shs
    status: mandatory
    differential: false
    covers:
      - simple-compiler-common
      - simple-compiler
      - simple-std
      - simple-app
  - name: check-unbacked-extern-ratchet.shs
    status: mandatory
    differential: false
    covers:
      - simple-compiler-common
      - simple-compiler
      - simple-std
      - simple-app
  - name: check-compiler-schema-fresh.shs
    status: mandatory
    differential: false
    covers:
      - simple-compiler
  - name: check-compiler-transition-coverage.shs
    status: mandatory
    differential: false
    covers:
      - simple-compiler-common
  - name: check-critical-wildcard-ban.shs
    status: mandatory
    differential: false
    covers:
      - simple-compiler
  - name: check-any-escape-census.shs
    status: mandatory
    differential: false
    covers:
      - simple-compiler
  - name: check-hardening-mutation.shs
    status: mandatory
    differential: false
    covers:
      - simple-compiler
      - simple-compiler-common
  - name: check-completeness-seal.shs
    status: mandatory
    differential: false
    covers:
      - simple-compiler
  - name: check-aspect-seal.shs
    status: mandatory
    differential: false
    covers:
      - simple-compiler
  - name: check-post-mono-invariants.shs
    status: mandatory
    differential: false
    covers:
      - simple-compiler
  - name: check-duplicate-pub-fn-names.shs
    status: mandatory
    differential: false
    covers:
      - simple-compiler-common
      - simple-compiler
      - simple-std
      - simple-app
  - name: check-stage-binaries-runnable.shs
    status: advisory
    differential: false
    covers:
      - simple-compiler-common
      - simple-compiler
      - simple-std
  - name: check-no-unresolved-runtime-symbols.shs
    status: advisory
    differential: false
    covers:
      - simple-compiler-common
      - simple-compiler
      - simple-std
