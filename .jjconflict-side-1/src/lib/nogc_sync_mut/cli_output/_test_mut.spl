# Shared module for array-element mutation import tests.
# Consumed by test/system/module_import/fixtures/var_mutation_import.spl.
# Mirrors src/compiler_rust/lib/std/src/cli_output/_test_mut.spl.

fn test_no_mutate() -> i64:
    val arr = [0]
    arr[0]

fn test_with_mutate() -> i64:
    var arr = [1]
    arr[0] = 0
    arr[0]
