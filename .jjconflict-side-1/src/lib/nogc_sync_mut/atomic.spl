            rt_atomic_bool_fetch_or(self._handle, value)

    fn fetch_not(ordering: MemoryOrdering) -> bool:
        unsafe(capabilities: [ffi]):
            rt_atomic_bool_fetch_not(self._handle)

    @unsafe(reason: "manual release invalidates this handle; caller must prevent later use and duplicate release", capabilities: [ffi])
    fn free():
        unsafe(capabilities: [ffi]):
            rt_atomic_bool_free(self._handle)

# ============================================================================
# Factory Functions
# ============================================================================

fn atomic_i64_new(value: i64) -> AtomicI64:
    var handle: i64 = 0
    unsafe(capabilities: [ffi]):
        handle = rt_atomic_int_new(value)
    if handle <= 0:
        panic("E-SFFI-ATOMIC-001: atomic integer allocation failed")
    AtomicI64(_handle: handle)

fn atomic_usize_new(value: i64) -> AtomicUsize:
    var handle: i64 = 0
    unsafe(capabilities: [ffi]):
        handle = rt_atomic_int_new(value)
    if handle <= 0:
        panic("E-SFFI-ATOMIC-001: atomic usize allocation failed")
    AtomicUsize(_handle: handle)

fn atomic_bool_new(value: bool) -> AtomicBool:
    var handle: i64 = 0
    unsafe(capabilities: [ffi]):
        handle = rt_atomic_bool_new(value)
    if handle <= 0:
        panic("E-SFFI-ATOMIC-001: atomic boolean allocation failed")
    AtomicBool(_handle: handle)

# ============================================================================
# Fence Operations
# ============================================================================

fn fence(ordering: MemoryOrdering):
    # No-op: runtime does not yet support memory fences.
    # All atomic operations use SeqCst internally, so fences are unnecessary.
    pass

