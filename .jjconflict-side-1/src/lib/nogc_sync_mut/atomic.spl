# Atomic Operations Module
#
# Provides thread-safe atomic operations for concurrent programming.
# All operations use hardware-level atomic instructions for lock-free synchronization.
#
# Architecture:
# - AtomicI64: 64-bit signed integer atomics
# - AtomicUsize: Platform-sized unsigned atomics (for indices/sizes)
# - AtomicBool: Boolean atomics (for flags)
# - Memory ordering: Relaxed, Acquire, Release, AcqRel, SeqCst
#
# Note: the current provider uses SeqCst for all operations internally, so the
# ordering parameter is advisory until generated ordered thunks are available.

# ============================================================================
# Memory Ordering
# ============================================================================

enum MemoryOrdering:
    Relaxed  # No ordering constraints (just atomicity)
    Acquire  # Load-acquire: prevents reordering of subsequent reads
    Release  # Store-release: prevents reordering of previous writes
    AcqRel   # Both acquire and release (for read-modify-write)
    SeqCst   # Sequentially consistent (total order)

# ============================================================================
# SFFI Declarations (SFFI - working rt_atomic_int_*/rt_atomic_bool_*)
# ============================================================================

# Atomic integer operations (i64)
@unsafe(reason: "raw owned atomic-int handle allocation; zero and cross-kind handles are not typed", capabilities: [ffi])
extern fn rt_atomic_int_new(initial: i64) -> i64
@unsafe(reason: "raw atomic-int handle load; invalid or stale handles fabricate zero", capabilities: [ffi])
extern fn rt_atomic_int_load(handle: i64) -> i64
@unsafe(reason: "raw atomic-int handle store; invalid or stale handles silently discard writes", capabilities: [ffi])
extern fn rt_atomic_int_store(handle: i64, value: i64)
@unsafe(reason: "raw atomic-int handle swap; invalid or stale handles fabricate zero", capabilities: [ffi])
extern fn rt_atomic_int_swap(handle: i64, value: i64) -> i64
@unsafe(reason: "raw atomic-int compare-exchange; invalid or stale handles fabricate false", capabilities: [ffi])
extern fn rt_atomic_int_compare_exchange(handle: i64, current: i64, new_value: i64) -> bool
@unsafe(reason: "raw atomic-int fetch-add; invalid or stale handles fabricate zero", capabilities: [ffi])
extern fn rt_atomic_int_fetch_add(handle: i64, value: i64) -> i64
@unsafe(reason: "raw atomic-int fetch-sub; invalid or stale handles fabricate zero", capabilities: [ffi])
extern fn rt_atomic_int_fetch_sub(handle: i64, value: i64) -> i64
@unsafe(reason: "raw atomic-int fetch-and; invalid or stale handles fabricate zero", capabilities: [ffi])
extern fn rt_atomic_int_fetch_and(handle: i64, value: i64) -> i64
@unsafe(reason: "raw atomic-int fetch-or; invalid or stale handles fabricate zero", capabilities: [ffi])
extern fn rt_atomic_int_fetch_or(handle: i64, value: i64) -> i64
@unsafe(reason: "raw atomic-int fetch-xor; invalid or stale handles fabricate zero", capabilities: [ffi])
extern fn rt_atomic_int_fetch_xor(handle: i64, value: i64) -> i64
@unsafe(reason: "raw atomic-int handle release; stale or cross-kind handle behavior is untyped", capabilities: [ffi])
extern fn rt_atomic_int_free(handle: i64)

# Atomic boolean operations
@unsafe(reason: "raw owned atomic-bool handle allocation; zero and cross-kind handles are not typed", capabilities: [ffi])
extern fn rt_atomic_bool_new(initial: bool) -> i64
@unsafe(reason: "raw atomic-bool handle load; invalid or stale handles fabricate false", capabilities: [ffi])
extern fn rt_atomic_bool_load(handle: i64) -> bool
@unsafe(reason: "raw atomic-bool handle store; invalid or stale handles silently discard writes", capabilities: [ffi])
extern fn rt_atomic_bool_store(handle: i64, value: bool)
@unsafe(reason: "raw atomic-bool handle swap; invalid or stale handles fabricate false", capabilities: [ffi])
extern fn rt_atomic_bool_swap(handle: i64, value: bool) -> bool
@unsafe(reason: "raw atomic-bool compare-exchange; invalid or stale handles fabricate false", capabilities: [ffi])
extern fn rt_atomic_bool_compare_exchange(handle: i64, current: bool, new_value: bool) -> bool
@unsafe(reason: "raw atomic-bool fetch-and; invalid or stale handles fabricate false", capabilities: [ffi])
extern fn rt_atomic_bool_fetch_and(handle: i64, value: bool) -> bool
@unsafe(reason: "raw atomic-bool fetch-or; invalid or stale handles fabricate false", capabilities: [ffi])
extern fn rt_atomic_bool_fetch_or(handle: i64, value: bool) -> bool
@unsafe(reason: "raw atomic-bool fetch-not; invalid or stale handles fabricate false", capabilities: [ffi])
extern fn rt_atomic_bool_fetch_not(handle: i64) -> bool
@unsafe(reason: "raw atomic-bool handle release; stale or cross-kind handle behavior is untyped", capabilities: [ffi])
extern fn rt_atomic_bool_free(handle: i64)

# ============================================================================
# Helper Functions
# ============================================================================

fn ordering_to_i32(ordering: MemoryOrdering) -> i32:
    match ordering:
        case Relaxed: 0
        case Acquire: 1
        case Release: 2
        case AcqRel: 3
        case SeqCst: 4

# ============================================================================
# AtomicI64
# ============================================================================

class AtomicI64:
    _handle: i64

    fn load(ordering: MemoryOrdering) -> i64:
        # Note: ordering ignored - runtime uses SeqCst
        unsafe(capabilities: [ffi]):
            rt_atomic_int_load(self._handle)

    fn store(value: i64, ordering: MemoryOrdering):
        unsafe(capabilities: [ffi]):
            rt_atomic_int_store(self._handle, value)

    fn swap(value: i64, ordering: MemoryOrdering) -> i64:
        unsafe(capabilities: [ffi]):
            rt_atomic_int_swap(self._handle, value)

    fn compare_exchange(expected: i64, new_value: i64, success_order: MemoryOrdering, failure_order: MemoryOrdering) -> bool:
        unsafe(capabilities: [ffi]):
            rt_atomic_int_compare_exchange(self._handle, expected, new_value)

    fn fetch_add(value: i64, ordering: MemoryOrdering) -> i64:
        unsafe(capabilities: [ffi]):
            rt_atomic_int_fetch_add(self._handle, value)

    fn fetch_sub(value: i64, ordering: MemoryOrdering) -> i64:
        unsafe(capabilities: [ffi]):
            rt_atomic_int_fetch_sub(self._handle, value)

    fn fetch_and(value: i64, ordering: MemoryOrdering) -> i64:
        unsafe(capabilities: [ffi]):
            rt_atomic_int_fetch_and(self._handle, value)

    fn fetch_or(value: i64, ordering: MemoryOrdering) -> i64:
        unsafe(capabilities: [ffi]):
            rt_atomic_int_fetch_or(self._handle, value)

    fn fetch_xor(value: i64, ordering: MemoryOrdering) -> i64:
        unsafe(capabilities: [ffi]):
            rt_atomic_int_fetch_xor(self._handle, value)

    fn increment(ordering: MemoryOrdering) -> i64:
        self.fetch_add(1, ordering)

    fn decrement(ordering: MemoryOrdering) -> i64:
        self.fetch_sub(1, ordering)

    @unsafe(reason: "manual release invalidates this handle; caller must prevent later use and duplicate release", capabilities: [ffi])
    fn free():
        unsafe(capabilities: [ffi]):
            rt_atomic_int_free(self._handle)

# ============================================================================
# AtomicUsize (alias for AtomicI64 - both use i64 in Simple)
# ============================================================================

class AtomicUsize:
    _handle: i64

    fn load(ordering: MemoryOrdering) -> i64:
        unsafe(capabilities: [ffi]):
            rt_atomic_int_load(self._handle)

    fn store(value: i64, ordering: MemoryOrdering):
        unsafe(capabilities: [ffi]):
            rt_atomic_int_store(self._handle, value)

    fn swap(value: i64, ordering: MemoryOrdering) -> i64:
        unsafe(capabilities: [ffi]):
            rt_atomic_int_swap(self._handle, value)

    fn compare_exchange(expected: i64, new_value: i64, success_order: MemoryOrdering, failure_order: MemoryOrdering) -> bool:
        unsafe(capabilities: [ffi]):
            rt_atomic_int_compare_exchange(self._handle, expected, new_value)

    fn fetch_add(value: i64, ordering: MemoryOrdering) -> i64:
        unsafe(capabilities: [ffi]):
            rt_atomic_int_fetch_add(self._handle, value)

    fn fetch_sub(value: i64, ordering: MemoryOrdering) -> i64:
        unsafe(capabilities: [ffi]):
            rt_atomic_int_fetch_sub(self._handle, value)

    fn increment(ordering: MemoryOrdering) -> i64:
        self.fetch_add(1, ordering)

    fn decrement(ordering: MemoryOrdering) -> i64:
        self.fetch_sub(1, ordering)

    @unsafe(reason: "manual release invalidates this handle; caller must prevent later use and duplicate release", capabilities: [ffi])
    fn free():
        unsafe(capabilities: [ffi]):
            rt_atomic_int_free(self._handle)

# ============================================================================
