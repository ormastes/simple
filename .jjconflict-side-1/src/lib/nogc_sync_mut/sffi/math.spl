# math runtime aliases — thin typed wrappers over rt_* primitives.
#
# Part of the rt_* migration programme (scripts/check/rt_alias_map.sdn):
# every wrapper here is signature-identical to the raw runtime call it names,
# so `rt_migrate` can rewrite product call sites mechanically. Product code
# imports these instead of declaring `extern fn rt_*` itself. Signatures come
# from the majority extern declaration in the tree (see the map's decl census).

@unsafe(reason: "raw runtime ABI for rt_f32_array_alloc", capabilities: [ffi])
extern fn rt_f32_array_alloc(len: i64) -> [f32]

@always_inline
fn f32_array_alloc(len: i64) -> [f32]:
    unsafe(capabilities: [ffi]):
        rt_f32_array_alloc(len)

@unsafe(reason: "raw runtime ABI for rt_f64_array_alloc", capabilities: [ffi])
extern fn rt_f64_array_alloc(len: i64) -> [f64]

@always_inline
fn f64_array_alloc(len: i64) -> [f64]:
    unsafe(capabilities: [ffi]):
        rt_f64_array_alloc(len)

