# codex-impl

use std.tiny.common.types.{TinyPoint}

const TINY_EVENT_NONE: i32 = 0
const TINY_EVENT_KEY: i32 = 1
const TINY_EVENT_TEXT: i32 = 2
const TINY_EVENT_POINTER_MOVE: i32 = 3
const TINY_EVENT_POINTER_DOWN: i32 = 4
const TINY_EVENT_POINTER_UP: i32 = 5
const TINY_EVENT_WHEEL: i32 = 6
const TINY_EVENT_FOCUS: i32 = 7
const TINY_EVENT_ACTION: i32 = 8

class TinyEvent:
    kind: i32
    point: TinyPoint
    code: i32
    value: i32

    static fn none() -> TinyEvent:
        TinyEvent(kind: TINY_EVENT_NONE, point: TinyPoint(x: 0, y: 0), code: 0, value: 0)
