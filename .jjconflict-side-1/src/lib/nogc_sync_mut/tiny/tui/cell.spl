# codex-impl

class TinyCell:
    glyph: text
    foreground: i32
    background: i32
    attributes: i32

    static fn blank() -> TinyCell:
        TinyCell(glyph: " ", foreground: 7, background: 0, attributes: 0)

class TinyCellBuffer:
    width: i32
    height: i32
    cells: [TinyCell]

    static fn create(width: i32, height: i32) -> TinyCellBuffer:
        val safe_width = if width > 0: width else: 0
        val safe_height = if height > 0: height else: 0
        var cells: [TinyCell] = []
        val count = safe_width * safe_height
        var index = 0
        while index < count:
            cells = cells.push(TinyCell.blank())
            index = index + 1
        TinyCellBuffer(width: safe_width, height: safe_height, cells: cells)

    me clear():
        var index = 0
        while index < self.cells.len():
            self.cells[index] = TinyCell.blank()
            index = index + 1

    me put(x: i32, y: i32, glyph: text, foreground: i32, background: i32, attributes: i32):
        if x < 0 or y < 0 or x >= self.width or y >= self.height: return
        self.cells[y * self.width + x] = TinyCell(glyph: glyph, foreground: foreground, background: background, attributes: attributes)

    fn glyph_at(x: i32, y: i32) -> text:
        if x < 0 or y < 0 or x >= self.width or y >= self.height: return ""
        self.cells[y * self.width + x].glyph

    fn row_text(y: i32) -> text:
        if y < 0 or y >= self.height: return ""
        var result = ""
        var x = 0
        while x < self.width:
            result = result + self.glyph_at(x, y)
            x = x + 1
        result
