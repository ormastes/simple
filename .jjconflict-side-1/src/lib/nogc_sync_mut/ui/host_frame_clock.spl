# Host adapter for FrameClock (src/lib/common/ui/ui_frame_clock.spl).
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# io.time_ops import and the raw rt_sleep_nanos extern below are legal here
# -- this is the one place in the WM/GUI/web/2D lane's dependency graph
# allowed to touch the real clock. Callers outside the portable lane
# construct HostFrameClock and inject it wherever a FrameClock is expected;
# the portable lane itself never imports this file directly.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W1).

use std.common.ui.ui_frame_clock.{FrameClock}
use std.nogc_sync_mut.io.time_ops.{time_now_micros}

extern fn rt_sleep_nanos(ns: i64)

class HostFrameClock:
    pass_dn

impl HostFrameClock:
    static fn new() -> HostFrameClock:
        HostFrameClock()

impl FrameClock for HostFrameClock:
    me now_micros() -> i64:
        time_now_micros()

    me sleep_until(deadline_us: i64):
        val remaining_us = deadline_us - time_now_micros()
        if remaining_us > 0:
            rt_sleep_nanos(remaining_us * 1000)

# Convenience factory for call sites that just need "the real clock" as a
# default-injection fallback (in-lane call sites that have not yet been
# threaded to an explicit clock parameter by their own caller).
pub fn default_frame_clock() -> FrameClock:
    HostFrameClock.new()
