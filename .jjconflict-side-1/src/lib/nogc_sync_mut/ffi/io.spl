"""
Compatibility facade for the canonical typed SFFI I/O owner.

All declarations and validation live in std.nogc_sync_mut.sffi.io so FFI and
SFFI import paths cannot drift. Re-exports are compile-time only and add no
runtime call, allocation, lookup, or synchronization.
"""

export use std.nogc_sync_mut.sffi.io.{
    file_exists, file_size, file_modified, file_modified_time,
    file_read_text, file_read, file_read_bytes, file_read_lines,
    file_write_text, file_write, file_write_bytes, file_append_text,
    file_atomic_write, file_copy, file_move, file_delete, file_remove,
    file_hash, file_hash_sha256,
    SffiFileLock, file_lock_acquire, file_lock, file_unlock,
    file_mmap_read_text, file_mmap_read_bytes,
    dir_exists, dir_list, dir_walk, list_dir_recursive,
    dir_create, dir_create_all, dir_remove, dir_remove_all,
    path_join2, path_absolute, path_parent, path_filename,
    path_extension, path_normalize
}
