# Shared 3D backend math runtime hooks.

@unsafe(reason: "raw scalar math ABI", capabilities: [ffi])
extern fn rt_math_sqrt(x: f64) -> f64
@unsafe(reason: "raw scalar math ABI", capabilities: [ffi])
extern fn rt_math_sin(x: f64) -> f64
@unsafe(reason: "raw scalar math ABI", capabilities: [ffi])
extern fn rt_math_cos(x: f64) -> f64

fn gpu3d_sqrt_f32(x: f32) -> f32:
    unsafe(capabilities: [ffi]): rt_math_sqrt(x as f64) as f32

fn gpu3d_sin_f32(x: f32) -> f32:
    unsafe(capabilities: [ffi]): rt_math_sin(x as f64) as f32

fn gpu3d_cos_f32(x: f32) -> f32:
    unsafe(capabilities: [ffi]): rt_math_cos(x as f64) as f32
