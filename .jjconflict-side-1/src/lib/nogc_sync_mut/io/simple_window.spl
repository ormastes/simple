# Canonical deterministic Simple window facade. The headless backend is the
# contract oracle; hosted adapters translate native callbacks into its event
# record shape.

use common.io.window_event.{
    WINDOW_STATUS_OK,
    WINDOW_STATUS_UNSUPPORTED,
    WINDOW_STATUS_INVALID_HANDLE,
    WINDOW_STATUS_INVALID_ARGUMENT,
    WindowEventRecord,
    WindowEventLoop,
    window_event_none,
    window_generation_handle,
    window_generation_handle_index,
    window_generation_handle_generation,
}
use common.io.window_capability.{
    WINDOW_CAP_SHOW_HIDE,
    WINDOW_CAP_FRAMEBUFFER_SCALE,
    WINDOW_CAP_FOCUS,
    WINDOW_CAP_MINIMIZE,
    WINDOW_CAP_MAXIMIZE,
    WINDOW_CAP_TEXT_INPUT,
    WINDOW_CAP_PRESENT_ARGB,
    WindowCapability,
    window_capability,
}

class SimpleWindowSlot:
    generation: i64
    live: bool
    title: text
    width: i64
    height: i64
    framebuffer_width: i64
    framebuffer_height: i64
    content_scale_milli: i64
    visible: bool
    focused: bool
    minimized: bool
    maximized: bool
    frame_sequence: i64
    pixels: [u32]

impl SimpleWindowSlot:
    static fn empty() -> SimpleWindowSlot:
        SimpleWindowSlot(
            generation: 1,
            live: false,
            title: "",
            width: 0,
            height: 0,
            framebuffer_width: 0,
            framebuffer_height: 0,
            content_scale_milli: 1000,
            visible: false,
            focused: false,
            minimized: false,
            maximized: false,
            frame_sequence: 0,
            pixels: []
        )

class SimpleWindow:
    backend: text
    events: WindowEventLoop
    slots: [SimpleWindowSlot]
    next_sequence: i64

impl SimpleWindow:
    static fn headless(event_capacity: i64, text_capacity: i64) -> SimpleWindow:
        SimpleWindow(
            backend: "headless",
            events: WindowEventLoop.create(event_capacity, text_capacity),
            slots: [],
            next_sequence: 1
        )

    fn backend_identity() -> text:
        self.backend

    fn capability(operation: i64) -> WindowCapability:
        val supported = (
            operation == WINDOW_CAP_SHOW_HIDE or
            operation == WINDOW_CAP_FRAMEBUFFER_SCALE or
            operation == WINDOW_CAP_FOCUS or
            operation == WINDOW_CAP_MINIMIZE or
            operation == WINDOW_CAP_MAXIMIZE or
            operation == WINDOW_CAP_TEXT_INPUT or
            operation == WINDOW_CAP_PRESENT_ARGB
        )
        window_capability(
            operation,
            supported,
            if supported: "" else: "{self.backend} backend does not support operation {operation}"
        )

    fn _slot_index(handle: i64) -> i64:
        val index = window_generation_handle_index(handle)
        val generation = window_generation_handle_generation(handle)
        if index < 0 or index >= self.slots.len():
            return -1
        val slot = self.slots[index]
        if not slot.live or slot.generation != generation:
            return -1
        index

    me create_window(title: text, width: i64, height: i64) -> i64:
        if width <= 0 or height <= 0:
            return 0
        var index = 0
        while index < self.slots.len():
            if not self.slots[index].live:
                var reused = self.slots[index]
                reused.live = true
                reused.title = title
                reused.width = width
                reused.height = height
                reused.framebuffer_width = width
                reused.framebuffer_height = height
                reused.content_scale_milli = 1000
                reused.visible = true
                reused.focused = true
                reused.minimized = false
                reused.maximized = false
                reused.frame_sequence = 0
                reused.pixels = []
                self.slots[index] = reused
                return window_generation_handle(index, reused.generation)
            index = index + 1
        val slot = SimpleWindowSlot.empty()
        self.slots.push(slot)
        index = self.slots.len() - 1
        var created = self.slots[index]
        created.live = true
        created.title = title
        created.width = width
        created.height = height
        created.framebuffer_width = width
        created.framebuffer_height = height
        created.visible = true
        created.focused = true
        self.slots[index] = created
        window_generation_handle(index, created.generation)

    me destroy_window(handle: i64) -> i64:
        val index = self._slot_index(handle)
        if index < 0:
            return WINDOW_STATUS_INVALID_HANDLE
        var slot = self.slots[index]
        self.events.drop_window_events(handle)
        slot.live = false
        slot.visible = false
        slot.focused = false
        slot.pixels = []
        slot.generation = slot.generation + 1
        self.slots[index] = slot
        WINDOW_STATUS_OK

    me show_window(handle: i64, visible: bool) -> i64:
        val index = self._slot_index(handle)
        if index < 0:
            return WINDOW_STATUS_INVALID_HANDLE
        var slot = self.slots[index]
        slot.visible = visible
        self.slots[index] = slot
        WINDOW_STATUS_OK

    me focus_window(handle: i64) -> i64:
        val index = self._slot_index(handle)
        if index < 0:
            return WINDOW_STATUS_INVALID_HANDLE
        var i = 0
        while i < self.slots.len():
            var slot = self.slots[i]
            slot.focused = i == index and slot.live
            self.slots[i] = slot
            i = i + 1
        WINDOW_STATUS_OK

    me minimize_window(handle: i64) -> i64:
        val index = self._slot_index(handle)
        if index < 0:
            return WINDOW_STATUS_INVALID_HANDLE
        var slot = self.slots[index]
        slot.minimized = true
        slot.maximized = false
        slot.visible = false
        self.slots[index] = slot
        WINDOW_STATUS_OK

    me maximize_window(handle: i64) -> i64:
        val index = self._slot_index(handle)
        if index < 0:
            return WINDOW_STATUS_INVALID_HANDLE
        var slot = self.slots[index]
        slot.minimized = false
        slot.maximized = true
        slot.visible = true
        self.slots[index] = slot
        WINDOW_STATUS_OK

    me restore_window(handle: i64) -> i64:
        val index = self._slot_index(handle)
        if index < 0:
            return WINDOW_STATUS_INVALID_HANDLE
        var slot = self.slots[index]
        slot.minimized = false
        slot.maximized = false
        slot.visible = true
        self.slots[index] = slot
        WINDOW_STATUS_OK

    fn set_window_position(handle: i64, x: i64, y: i64) -> i64:
        if self._slot_index(handle) < 0:
            return WINDOW_STATUS_INVALID_HANDLE
        WINDOW_STATUS_UNSUPPORTED

    fn set_decorated(handle: i64, decorated: bool) -> i64:
        if self._slot_index(handle) < 0:
            return WINDOW_STATUS_INVALID_HANDLE
        WINDOW_STATUS_UNSUPPORTED

    fn set_floating(handle: i64, floating: bool) -> i64:
        if self._slot_index(handle) < 0:
            return WINDOW_STATUS_INVALID_HANDLE
        WINDOW_STATUS_UNSUPPORTED

    me stage_argb(handle: i64, width: i64, height: i64, pixels: [u32]) -> i64:
        val index = self._slot_index(handle)
        if index < 0:
            return WINDOW_STATUS_INVALID_HANDLE
        if width <= 0 or height <= 0 or pixels.len() != width * height:
            return WINDOW_STATUS_INVALID_ARGUMENT
        var slot = self.slots[index]
        slot.framebuffer_width = width
        slot.framebuffer_height = height
        slot.pixels = pixels
        self.slots[index] = slot
        WINDOW_STATUS_OK

    me present(handle: i64) -> i64:
        val index = self._slot_index(handle)
        if index < 0:
            return WINDOW_STATUS_INVALID_HANDLE
        var slot = self.slots[index]
        if slot.pixels.len() != slot.framebuffer_width * slot.framebuffer_height:
            return WINDOW_STATUS_INVALID_ARGUMENT
        slot.frame_sequence = slot.frame_sequence + 1
        self.slots[index] = slot
        WINDOW_STATUS_OK

    me inject_window_event(event: WindowEventRecord) -> i64:
        self.inject_window_event_scalar(
            event.kind,
            event.window_handle,
            event.sequence,
            event.timestamp_ns,
            event.key,
            event.scancode,
            event.action,
            event.modifiers,
            event.x_milli,
            event.y_milli,
            event.delta_x_milli,
            event.delta_y_milli,
            event.width,
            event.height
        )

    me inject_window_event_scalar(
        kind: i64,
        window_handle: i64,
        sequence: i64,
        timestamp_ns: i64,
        key: i64,
        scancode: i64,
        action: i64,
        modifiers: i64,
        x_milli: i64,
        y_milli: i64,
        delta_x_milli: i64,
        delta_y_milli: i64,
        width: i64,
        height: i64
    ) -> i64:
        if self._slot_index(window_handle) < 0:
            return WINDOW_STATUS_INVALID_HANDLE
        self.events.enqueue_scalar(
            kind, window_handle, sequence, timestamp_ns,
            key, scancode, action, modifiers,
            x_milli, y_milli, delta_x_milli, delta_y_milli,
            width, height
        )

    me inject_text(window_handle: i64, timestamp_ns: i64, value: text) -> i64:
        if self._slot_index(window_handle) < 0:
            return WINDOW_STATUS_INVALID_HANDLE
        val sequence = self.next_sequence
        self.next_sequence = self.next_sequence + 1
        self.events.enqueue_text(window_handle, sequence, timestamp_ns, value)

    me poll_event() -> WindowEventRecord:
        self.events.poll()

    me poll_event_scalar() -> i64:
        """Freestanding-safe poll; fields are exposed as events.polled_*."""
        self.events.poll_scalar()

    fn event_text(handle: i64) -> text:
        self.events.text_value(handle)

    me release_event_text(handle: i64) -> i64:
        self.events.release_text(handle)

    fn live_window_count() -> i64:
        var count = 0
        var i = 0
        while i < self.slots.len():
            if self.slots[i].live:
                count = count + 1
            i = i + 1
        count

    fn pixel_surface_count() -> i64:
        var count = 0
        var i = 0
        while i < self.slots.len():
            if self.slots[i].live and self.slots[i].pixels.len() > 0:
                count = count + 1
            i = i + 1
        count

    fn frame_sequence(handle: i64) -> i64:
        val index = self._slot_index(handle)
        if index < 0:
            return 0
        self.slots[index].frame_sequence

    fn framebuffer_pixels(handle: i64) -> [u32]:
        val index = self._slot_index(handle)
        if index < 0:
            return []
        self.slots[index].pixels
