# Math Functions - SFFI (Runtime SFFI)
#
# Advanced math functions using runtime SFFI.
# Basic math (exp, ln, sqrt, sin, cos, random) remain in mod.spl
# since they use shell-based bc fallbacks that depend on shell().

# --- Logarithm functions ---
@unsafe(reason: "raw IEEE-754 natural-logarithm ABI", capabilities: [ffi])
extern fn rt_math_log(x: f64) -> f64
@unsafe(reason: "raw IEEE-754 base-10 logarithm ABI", capabilities: [ffi])
extern fn rt_math_log10(x: f64) -> f64
@unsafe(reason: "raw IEEE-754 base-2 logarithm ABI", capabilities: [ffi])
extern fn rt_math_log2(x: f64) -> f64

fn math_log(x: f64) -> f64:
    """Natural logarithm (SFFI)."""
    unsafe(capabilities: [ffi]):
        rt_math_log(x)

fn math_log10(x: f64) -> f64:
    """Base-10 logarithm (SFFI)."""
    unsafe(capabilities: [ffi]):
        rt_math_log10(x)

fn math_log2(x: f64) -> f64:
    """Base-2 logarithm (SFFI)."""
    unsafe(capabilities: [ffi]):
        rt_math_log2(x)

# --- Inverse trig functions ---
@unsafe(reason: "raw IEEE-754 inverse-sine ABI", capabilities: [ffi])
extern fn rt_math_asin(x: f64) -> f64
@unsafe(reason: "raw IEEE-754 inverse-cosine ABI", capabilities: [ffi])
extern fn rt_math_acos(x: f64) -> f64
@unsafe(reason: "raw IEEE-754 inverse-tangent ABI", capabilities: [ffi])
extern fn rt_math_atan(x: f64) -> f64
@unsafe(reason: "raw IEEE-754 two-argument inverse-tangent ABI", capabilities: [ffi])
extern fn rt_math_atan2(y: f64, x: f64) -> f64

fn math_asin(x: f64) -> f64:
    """Arc sine (SFFI)."""
    unsafe(capabilities: [ffi]):
        rt_math_asin(x)

fn math_acos(x: f64) -> f64:
    """Arc cosine (SFFI)."""
    unsafe(capabilities: [ffi]):
        rt_math_acos(x)

fn math_atan(x: f64) -> f64:
    """Arc tangent (SFFI)."""
    unsafe(capabilities: [ffi]):
        rt_math_atan(x)

fn math_atan2(y: f64, x: f64) -> f64:
    """Arc tangent of y/x (SFFI)."""
    unsafe(capabilities: [ffi]):
        rt_math_atan2(y, x)

# --- Hyperbolic functions ---
@unsafe(reason: "raw IEEE-754 hyperbolic-sine ABI", capabilities: [ffi])
extern fn rt_math_sinh(x: f64) -> f64
@unsafe(reason: "raw IEEE-754 hyperbolic-cosine ABI", capabilities: [ffi])
extern fn rt_math_cosh(x: f64) -> f64
@unsafe(reason: "raw IEEE-754 hyperbolic-tangent ABI", capabilities: [ffi])
extern fn rt_math_tanh(x: f64) -> f64

fn math_sinh(x: f64) -> f64:
    """Hyperbolic sine (SFFI)."""
    unsafe(capabilities: [ffi]):
        rt_math_sinh(x)

fn math_cosh(x: f64) -> f64:
    """Hyperbolic cosine (SFFI)."""
    unsafe(capabilities: [ffi]):
        rt_math_cosh(x)

fn math_tanh(x: f64) -> f64:
    """Hyperbolic tangent (SFFI)."""
    unsafe(capabilities: [ffi]):
        rt_math_tanh(x)

# --- Rounding functions ---
@unsafe(reason: "raw IEEE-754 ceiling ABI", capabilities: [ffi])
extern fn rt_math_ceil(x: f64) -> f64
@unsafe(reason: "raw IEEE-754 floor ABI", capabilities: [ffi])
extern fn rt_math_floor(x: f64) -> f64

fn math_ceil(x: f64) -> f64:
    """Ceiling function (SFFI)."""
    unsafe(capabilities: [ffi]):
        rt_math_ceil(x)

fn math_floor(x: f64) -> f64:
    """Floor function (SFFI)."""
    unsafe(capabilities: [ffi]):
        rt_math_floor(x)

fn math_round(x: f64) -> f64:
    """Round to nearest integer (pure Simple, rt_math_round not in runtime)."""
    val floored = unsafe(capabilities: [ffi]):
        rt_math_floor(x)
    if x - floored >= 0.5:
        floored + 1.0
    else:
        floored
