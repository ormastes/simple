@allow(primitive_api)
# Counterpart Conformance — converter registry (Wave 1, lane F5).
#
# primitive_api is allowed here deliberately: schema versions are i64 and the
# registry predicates are bool by contract with the frozen Wave-0 model, whose
# wire types these mirror. Wrapping them in newtypes would fork the contract.
#
# Holds the versioned converter edges of the conversion graph, keyed by
# (from_schema, to_schema). Registration is fail-closed: a manifest that is
# incomplete, self-looping on one schema, missing a schema version, or that
# re-uses an already-registered converter_id is REJECTED and recorded, never
# silently accepted and never silently ignored.
#
# A schema id is `<name>@<version>` with version >= 1, e.g.
# "chrome.dom_snapshot@1". "Missing schema version" is a first-class rejection
# because a converter that does not pin its input and output schema versions
# cannot be replayed.
#
# Design: doc/05_design/infra/counterpart/counterpart_conformance_infrastructure_design_2026-08-09.md §6
# Contracts: src/lib/common/spec/evidence/counterpart/model.spl (frozen, do not edit)

use std.common.spec.evidence.counterpart.model.{
    ConverterManifest,
    ConversionLoss,
    conversion_loss_name
}

# ---------------------------------------------------------------------------
# Schema identity
# ---------------------------------------------------------------------------

# Fail-closed schema version parse. Returns -1 for anything that is not exactly
# `<non-empty-name>@<positive-integer>`. Never guesses a default version.
pub fn schema_version_of(schema_id: text) -> i64:
    val parts = schema_id.split("@")
    if parts.len() != 2:
        return -1
    if parts[0] == "":
        return -1
    val raw = parts[1]
    if raw == "":
        return -1
    val parsed = raw.to_i64()
    # Round-trip guard: `to_i64` is permissive, so reject anything whose
    # decimal rendering differs from the source text ("1x", " 1", "01").
    if parsed.to_text() != raw:
        return -1
    if parsed < 1:
        return -1
    parsed

# A converter declares its inputs through `preconditions`. A precondition of the
# form `derives_expected_from:<source>` names where the converter obtains an
# expected value. Naming the candidate's own output there is the final clause of
# design §6.3: such a converter makes every downstream relation trivially true
# while passing every other gate — the route is short, deterministic, loss-free
# and unambiguous, so nothing else catches it.
pub val COUNTERPART_DERIVES_EXPECTED_PREFIX: text = "derives_expected_from:"
pub val COUNTERPART_CANDIDATE_SOURCE_TOKEN: text = "candidate"

# The source named by a `derives_expected_from:` precondition, or "" if the
# precondition is not of that form.
pub fn derived_expectation_source(precondition: text) -> text:
    if not precondition.starts_with(COUNTERPART_DERIVES_EXPECTED_PREFIX):
        return ""
    precondition.substring(COUNTERPART_DERIVES_EXPECTED_PREFIX.len(), precondition.len())

# True when a converter derives an expected value from the candidate's own
# output. Any source naming the candidate counts, not only the exact spelling
# `candidate_output`, so a rename cannot walk around the gate.
pub fn precondition_derives_from_candidate(precondition: text) -> bool:
    val source = derived_expectation_source(precondition)
    if source == "":
        return false
    source.contains(COUNTERPART_CANDIDATE_SOURCE_TOKEN)

pub fn manifest_derives_expected_from_candidate(manifest: ConverterManifest) -> bool:
    for precondition in manifest.preconditions:
        if precondition_derives_from_candidate(precondition):
            return true
    false

pub fn schema_name_of(schema_id: text) -> text:
    val parts = schema_id.split("@")
    if parts.len() != 2:
        return ""
    parts[0]

pub fn schema_id_is_valid(schema_id: text) -> bool:
    schema_version_of(schema_id) >= 1

# ---------------------------------------------------------------------------
# Registry
# ---------------------------------------------------------------------------

pub struct ConverterRegistry:
    converters: [ConverterManifest]
    rejections: [text]

pub fn converter_registry() -> ConverterRegistry:
    ConverterRegistry(converters: [], rejections: [])

pub fn converter_manifest(
    converter_id: text,
    converter_version: text,
    from_schema: text,
    to_schema: text,
    loss: ConversionLoss
) -> ConverterManifest:
    ConverterManifest(
        converter_id: converter_id,
        converter_version: converter_version,
        from_schema: from_schema,
        to_schema: to_schema,
        loss: loss,
        deterministic: true,
        preserved_dimensions: [],
        dropped_dimensions: [],
        preconditions: []
    )

pub fn converter_manifest_full(
    converter_id: text,
    converter_version: text,
    from_schema: text,
    to_schema: text,
    loss: ConversionLoss,
    deterministic: bool,
    preserved_dimensions: [text],
    dropped_dimensions: [text],
    preconditions: [text]
) -> ConverterManifest:
    ConverterManifest(
        converter_id: converter_id,
        converter_version: converter_version,
        from_schema: from_schema,
        to_schema: to_schema,
        loss: loss,
        deterministic: deterministic,
        preserved_dimensions: preserved_dimensions,
        dropped_dimensions: dropped_dimensions,
        preconditions: preconditions
    )

# Every reason a manifest may not enter the graph. Empty list = acceptable.
pub fn converter_manifest_rejections(manifest: ConverterManifest) -> [text]:
    var failures: [text] = []
    if manifest.converter_id == "":
        failures.push("converter_id is empty")
    if manifest.converter_version == "":
        failures.push("converter " + manifest.converter_id + " has no converter_version")
    if not schema_id_is_valid(manifest.from_schema):
        failures.push("converter " + manifest.converter_id
            + " has missing/invalid from_schema version '" + manifest.from_schema + "'")
    if not schema_id_is_valid(manifest.to_schema):
        failures.push("converter " + manifest.converter_id
            + " has missing/invalid to_schema version '" + manifest.to_schema + "'")
    if manifest.from_schema == manifest.to_schema:
        failures.push("converter " + manifest.converter_id
            + " is a self-loop on '" + manifest.from_schema + "'")
    if not manifest.deterministic:
        failures.push("converter " + manifest.converter_id + " is not deterministic")
    # The reason echoes the offending precondition verbatim, so the refusal
    # names the actual source (e.g. `candidate_output`) rather than only the
    # rule it broke.
    for precondition in manifest.preconditions:
        if precondition_derives_from_candidate(precondition):
            failures.push("converter " + manifest.converter_id
                + " derives an expected value from the candidate under test ('"
                + precondition + "'): this makes every downstream relation"
                + " trivially true")
    failures

pub fn registry_has_converter_id(registry: ConverterRegistry, converter_id: text) -> bool:
    for existing in registry.converters:
        if existing.converter_id == converter_id:
            return true
    false

# Registers one edge. Returns the updated registry; a refused registration is
# recorded in `rejections` so the caller cannot mistake it for a success.
pub fn registry_register(
    registry: ConverterRegistry,
    manifest: ConverterManifest
) -> ConverterRegistry:
    var converters = registry.converters
    var rejections = registry.rejections

    var refused = false
    for reason in converter_manifest_rejections(manifest):
        rejections.push(reason)
        refused = true

    if registry_has_converter_id(registry, manifest.converter_id):
        rejections.push("duplicate converter registration '" + manifest.converter_id + "'")
        refused = true

    if not refused:
        converters.push(manifest)

    ConverterRegistry(converters: converters, rejections: rejections)

pub fn registry_register_all(
    registry: ConverterRegistry,
    manifests: [ConverterManifest]
) -> ConverterRegistry:
    var current = registry
    for manifest in manifests:
        current = registry_register(current, manifest)
    current

pub fn registry_is_clean(registry: ConverterRegistry) -> bool:
    registry.rejections.len() == 0

pub fn registry_edge_count(registry: ConverterRegistry) -> i64:
    registry.converters.len()

# All edges leaving one schema, in registration order.
pub fn registry_edges_from(registry: ConverterRegistry, from_schema: text) -> [ConverterManifest]:
    var edges: [ConverterManifest] = []
    for manifest in registry.converters:
        if manifest.from_schema == from_schema:
            edges.push(manifest)
    edges

# All edges for one exact (from, to) pair. More than one means the pair is
# ambiguous unless the losses differ; the graph, not the registry, decides.
pub fn registry_edges_between(
    registry: ConverterRegistry,
    from_schema: text,
    to_schema: text
) -> [ConverterManifest]:
    var edges: [ConverterManifest] = []
    for manifest in registry.converters:
        if manifest.from_schema == from_schema and manifest.to_schema == to_schema:
            edges.push(manifest)
    edges

pub fn registry_converter_by_id(
    registry: ConverterRegistry,
    converter_id: text
) -> ConverterManifest?:
    for manifest in registry.converters:
        if manifest.converter_id == converter_id:
            return manifest
    nil

pub fn converter_edge_label(manifest: ConverterManifest) -> text:
    (manifest.converter_id + "@" + manifest.converter_version
        + "(" + manifest.from_schema + "->" + manifest.to_schema
        + "," + conversion_loss_name(manifest.loss) + ")")
