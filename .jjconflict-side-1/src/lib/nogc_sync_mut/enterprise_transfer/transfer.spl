"""
# Inter-Location Stock Transfers — move inventory between locations

Lane W22-C of the Simple Enterprise Suite. A stock-transfer vertical layered on
the durable enterprise store, complementing `enterprise_inventory/inventory.spl`:
it moves physical stock between warehouses/locations as a two-phase event log.

    seed (stock-in) -> dispatch (in-transit) -> receive (arrived)

Every write runs the frozen guarded sequence over the durable store:

    session -> rbac -> domain validation -> idempotency -> effects in one UoW

## Storage model — insert-only signed movements + derive on read

A single insert-only table `xfer_moves` holds one signed row per movement; a
transfer's identity/route lives in the insert-only `xfer_transfers` table (one
immutable row, written at dispatch). There is NO UPDATE anywhere: per-location
on-hand and transfer status are pure-Simple folds over these rows (the
interpreter sqlite emulation is non-ACID and ignores WHERE — durable claims
rest on the file backend; see the store's backend-honesty docstring). Reasons
partition the ledger:

- `xfer-seed`     (+qty) — guarded initial stock-in at a location.
- `xfer-dispatch` (−qty) — decrements the SOURCE location; marks in-transit.
- `xfer-receive`  (+qty) — increments the DESTINATION location; marks received.

Derived per (tenant, sku, location):

    location_on_hand = sum(delta) over all reasons for that location

A transfer's status folds over its own `xfer_moves` rows:

    "" (unknown) -> in-transit (a dispatch move) -> received (a receive move)

## Two-phase invariants

- Source is decremented at DISPATCH; destination is incremented only at RECEIVE.
- Between dispatch and receive the moved quantity is "in transit" — counted at
  neither location — so total on-hand across locations dips by qty mid-flight
  and is RESTORED exactly on receive: a completed transfer conserves the grand
  total on-hand across all locations.
- `transfer_dispatch` denies the closed-set reason `insufficient-stock` when
  qty exceeds the source location's on-hand (state-dependent: gated on
  not-replayed, like inventory's over-reserve check).
- `transfer_receive` denies `invalid-transition` unless the transfer is
  currently `in-transit` — receiving before dispatch (unknown) or receiving
  twice (already received) both fail with NO effect.

## RBAC — frozen `procurement` role reused via a LOCAL gate

`foundation.role_allows` is FROZEN (an ADR is required to extend it) and
`enterprise_sale/rbac_registry.spl` is byte-fenced to it. Warehouse transfer is
operationally the same actor as goods receiving, so this vertical AUTHORIZES via
the LOCAL `transfer_role_allows` gate (mirroring `enterprise_tax`'s
`tax_role_allows`): admin passes for everything (the blanket admin rule), and
the existing `procurement` role is reused for the transfer actions. No row is
added to the frozen table and rbac_registry.spl is not touched.

sha256 audit is taken only via the enterprise_store facade
(`records.audit_append` -> `audit_hash.audit_sha256_hex`); this module never
imports `std.common.crypto.sha256` directly (cross-OS rule, one codebase).
"""

use std.nogc_sync_mut.enterprise_store.store.{
    EnterpriseStore, store_migrate, store_rows, store_insert_row,
    uow_begin, uow_commit, uow_rollback
}
use std.nogc_sync_mut.enterprise_store.records.{
    idempotency_seen, idempotency_result, idempotency_record,
    outbox_append, audit_append
}
use std.nogc_sync_mut.io.sqlite_sffi.{sqlite_row_get}
use std.nogc_sync_mut.enterprise_sale.foundation.{
    TenantContext, ActorContext, SessionContext,
    CommandEnvelope, CommandResult,
    accepted, denied, session_valid
}

# =============================================================================
# Schema — insert-only signed movements + immutable transfer route rows
# =============================================================================

fn xfer_setup(store: EnterpriseStore) -> bool:
    var ok = store_migrate(store, "xfer_001_moves",
        "CREATE TABLE IF NOT EXISTS xfer_moves (id INTEGER PRIMARY KEY, tenant_id TEXT, transfer_id TEXT, sku TEXT, location TEXT, delta TEXT, reason TEXT)")
    ok = ok and store_migrate(store, "xfer_002_transfers",
        "CREATE TABLE IF NOT EXISTS xfer_transfers (id INTEGER PRIMARY KEY, tenant_id TEXT, transfer_id TEXT, sku TEXT, qty TEXT, from_loc TEXT, to_loc TEXT)")
    ok

# =============================================================================
# Local RBAC gate — reuse the frozen `procurement` role (no new grant)
# =============================================================================

# transfer_role_allows gates transfer commands. admin passes for everything
# (matching the frozen blanket rule); the procurement role is REUSED for
# stock-transfer actions. The frozen role_allows table is NOT edited.
fn transfer_role_allows(role: text, action: text) -> bool:
    if role == "admin":
        return true
    if role == "procurement":
        return action == "transfer.stock.seed" or action == "transfer.stock.dispatch" or action == "transfer.stock.receive"
    false

# =============================================================================
# Derived reads (pure-Simple filtering + fold; see module docstring)
# =============================================================================

# location_on_hand: physical stock currently AT a (tenant, sku, location) =
# sum of every signed movement delta recorded against that location.
fn location_on_hand(store: EnterpriseStore, tenant_id: text, sku: text, location: text) -> i64:
    var total: i64 = 0
    val rows = store_rows(store, "xfer_moves", "id, tenant_id, transfer_id, sku, location, delta, reason")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "sku") == sku and sqlite_row_get(row, "location") == location:
            total = total + int(sqlite_row_get(row, "delta"))
    total

# transfer_status folds a transfer's movement rows to its current phase:
# "" (unknown) -> in-transit (dispatch move) -> received (receive move).
fn transfer_status(store: EnterpriseStore, tenant_id: text, transfer_id: text) -> text:
    var status = ""
    val rows = store_rows(store, "xfer_moves", "id, tenant_id, transfer_id, sku, location, delta, reason")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "transfer_id") == transfer_id:
            val reason = sqlite_row_get(row, "reason")
            if reason == "xfer-dispatch":
                status = "in-transit"
            elif reason == "xfer-receive":
                status = "received"
    status

# transfer_route returns (sku, qty, from_loc, to_loc) for a transfer; qty -1
# signals an unknown transfer (no dispatch row was ever written).
fn transfer_route(store: EnterpriseStore, tenant_id: text, transfer_id: text) -> (text, i64, text, text):
    val rows = store_rows(store, "xfer_transfers", "id, tenant_id, transfer_id, sku, qty, from_loc, to_loc")
    for row in rows:
        if sqlite_row_get(row, "tenant_id") == tenant_id and sqlite_row_get(row, "transfer_id") == transfer_id:
            return (sqlite_row_get(row, "sku"), int(sqlite_row_get(row, "qty")), sqlite_row_get(row, "from_loc"), sqlite_row_get(row, "to_loc"))
    ("", -1, "", "")

# =============================================================================
# Guarded commands (frozen sequence: session -> rbac -> validation ->
# idempotency -> effects in one unit of work)
# =============================================================================

# stock_seed: guarded initial stock-in at a location (+qty).
fn stock_seed(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, location: text, sku: text, qty: i64) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", sku)
    if not transfer_role_allows(who.role, "transfer.stock.seed"):
        return denied("forbidden", sku)
    if sku == "" or location == "" or qty <= 0:
        return denied("invalid-record", sku)
    if idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key):
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    val ref = sku + "@" + location
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO xfer_moves (tenant_id, transfer_id, sku, location, delta, reason) VALUES (?, ?, ?, ?, ?, ?)",
        [tenant.tenant_id, "seed", sku, location, "{qty}", "xfer-seed"])
    outbox_append(store, tenant.tenant_id, "transfer.stock.seeded", ref + ":{qty}")
    audit_append(store, tenant.tenant_id, who.actor_id, "transfer.stock.seed", ref + ":{qty}")
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, ref)
    uow_commit(store)
    accepted(ref)

# transfer_dispatch: phase one — decrement the SOURCE location and mark the
# transfer in-transit. Denies `insufficient-stock` when qty exceeds the source
# location's on-hand (state-dependent, gated on not-replayed).
fn transfer_dispatch(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, transfer_id: text, sku: text, qty: i64, from_loc: text, to_loc: text) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", transfer_id)
    if not transfer_role_allows(who.role, "transfer.stock.dispatch"):
        return denied("forbidden", transfer_id)
    if transfer_id == "" or sku == "" or from_loc == "" or to_loc == "" or from_loc == to_loc or qty <= 0:
        return denied("invalid-record", transfer_id)
    # The over-transfer check is state-DEPENDENT: source on-hand shrinks by this
    # command's own effect, so re-judging it on a replay would deny an
    # already-accepted command. Feasibility is asked only of a command not
    # already recorded (frozen order: session -> rbac -> validation ->
    # idempotency).
    val replayed = idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key)
    if not replayed and qty > location_on_hand(store, tenant.tenant_id, sku, from_loc):
        return denied("insufficient-stock", "over-transfer:" + transfer_id + ":" + sku + "@" + from_loc + ":on_hand={location_on_hand(store, tenant.tenant_id, sku, from_loc)}:got={qty}")
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO xfer_transfers (tenant_id, transfer_id, sku, qty, from_loc, to_loc) VALUES (?, ?, ?, ?, ?, ?)",
        [tenant.tenant_id, transfer_id, sku, "{qty}", from_loc, to_loc])
    store_insert_row(store,
        "INSERT INTO xfer_moves (tenant_id, transfer_id, sku, location, delta, reason) VALUES (?, ?, ?, ?, ?, ?)",
        [tenant.tenant_id, transfer_id, sku, from_loc, "-{qty}", "xfer-dispatch"])
    outbox_append(store, tenant.tenant_id, "transfer.stock.dispatched", transfer_id + ":" + sku + ":{qty}")
    audit_append(store, tenant.tenant_id, who.actor_id, "transfer.stock.dispatch", transfer_id + ":{qty}")
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, transfer_id)
    uow_commit(store)
    accepted(transfer_id)

# transfer_receive: phase two — increment the DESTINATION location and mark the
# transfer received. Denies `invalid-transition` unless the transfer is
# currently in-transit (receive-before-dispatch or double-receive), with NO
# effect. The route (sku/qty/to_loc) is read from the immutable transfer row.
fn transfer_receive(store: EnterpriseStore, session: SessionContext, tenant: TenantContext, who: ActorContext, envelope: CommandEnvelope, transfer_id: text) -> CommandResult:
    if not session_valid(session, tenant, who):
        return denied("invalid-session", transfer_id)
    if not transfer_role_allows(who.role, "transfer.stock.receive"):
        return denied("forbidden", transfer_id)
    if transfer_id == "":
        return denied("invalid-record", transfer_id)
    # The in-transit -> received transition is state-DEPENDENT (received is this
    # command's own effect), so it is asked only of a command not already
    # recorded; a replay returns the recorded result. An unknown transfer (never
    # dispatched) and an already-received one are BOTH invalid-transition.
    val status = transfer_status(store, tenant.tenant_id, transfer_id)
    val replayed = idempotency_seen(store, tenant.tenant_id, envelope.idempotency_key)
    if not replayed and status != "in-transit":
        return denied("invalid-transition", transfer_id + ":" + status)
    if replayed:
        return CommandResult(ok: true, reason: "duplicate-key", detail: idempotency_result(store, tenant.tenant_id, envelope.idempotency_key))
    val route = transfer_route(store, tenant.tenant_id, transfer_id)
    uow_begin(store)
    store_insert_row(store,
        "INSERT INTO xfer_moves (tenant_id, transfer_id, sku, location, delta, reason) VALUES (?, ?, ?, ?, ?, ?)",
        [tenant.tenant_id, transfer_id, route.0, route.3, "{route.1}", "xfer-receive"])
    outbox_append(store, tenant.tenant_id, "transfer.stock.received", transfer_id + ":" + route.0 + ":{route.1}")
    audit_append(store, tenant.tenant_id, who.actor_id, "transfer.stock.receive", transfer_id + ":{route.1}")
    idempotency_record(store, tenant.tenant_id, envelope.idempotency_key, transfer_id)
    uow_commit(store)
    accepted(transfer_id)

export xfer_setup, transfer_role_allows
export location_on_hand, transfer_status, transfer_route
export stock_seed, transfer_dispatch, transfer_receive
