# Named literal sections for the one-off harnesses.
#
# Scope discipline: ONLY irreducible prose belongs here — the file-header
# comment paragraphs, which carry no structure a descriptor could express.
# Every construct that has structure (declarations, maps, processes, reports,
# the verdict chain) is generated in tb_oneoff_gen.spl from descriptors and is
# deliberately NOT parked here as a literal blob.

# Header of tb_rv32_payload.vhd: explains why the harness taps the store-time
# debug strobe instead of baud-decoding uart_tx, the working-directory contract
# the core's .mem readers impose, and the sentinel/timeout protocol.
fn oo_payload_head_comment() -> [text]:
    var l: [text] = []
    l = l.push("-- tb_rv32_payload.vhd  (Lane OO — NEW harness, does not modify any existing RTL)")
    l = l.push("--")
    l = l.push("-- Generic UART-capture testbench for the PROVEN rv32 exec core")
    l = l.push("-- (examples/09_embedded/fpga_riscv/rtl/rv32_exec_core.vhd). It instantiates the")
    l = l.push("-- read-only core UNMODIFIED and captures every byte the core emits on its")
    l = l.push("-- store-time debug UART strobe (debug_uart_valid / debug_uart_byte) rather than")
    l = l.push("-- serial-decoding uart_tx, so capture is baud-timing independent and exact.")
    l = l.push("--")
    l = l.push("-- The core's init_rom / init_data_rom functions open \"rv32_payload.mem\" and")
    l = l.push("-- \"rv32_fat32.mem\" by bare relative name, so both `ghdl -e` and `ghdl -r` MUST")
    l = l.push("-- be launched from a directory that holds those two files. This TB writes one")
    l = l.push("-- captured character per line to \"uart_capture.txt\" (fresh each run). Payloads")
    l = l.push("-- emit only printable ASCII plus the sentinel, and never a raw newline (0x0A),")
    l = l.push("-- so the driving shell reconstructs the exact string by deleting line breaks.")
    l = l.push("-- The sentinel byte 0x7E ('~') marks end-of-output: on receipt the TB reports")
    l = l.push("-- the elapsed core cycle count and stops. If the payload livelocks, GHDL's")
    l = l.push("-- --stop-time bound ends the run with no sentinel and the shell gate fails.")
    l

# Header of tb_gate.vhd: the pass/fail convention the ISA payloads follow.
fn oo_gate_head_comment() -> [text]:
    var l: [text] = []
    l = l.push("-- RISC-V ISA gate: sample UART pass/fail char to determine test result")
    l = l.push("-- Tests write 'P' to UART MMIO 0x10000000 for pass, 'F' for fail, then j .")
    l

# In-body comments. Each is a single explanatory line whose position is
# structural (it introduces the block that follows), so the generator places
# them; only their text lives here.
fn oo_payload_clock_comment() -> text:
    "  -- 100 MHz simulated core clock"

fn oo_payload_reset_comment() -> text:
    "  -- Reset release"

fn oo_payload_cycle_comment() -> text:
    "  -- Core cycle counter (post-reset)"

fn oo_payload_capture_comment() -> text:
    "  -- UART byte capture on the store-time strobe"

fn oo_payload_sentinel_comment() -> text:
    "  -- '~' end-of-output sentinel"

fn oo_gate_sample_comment() -> text:
    "        -- Look for UART byte on rising edge of debug_uart_valid"

fn oo_gate_arms_comment() -> text:
    "          -- Check for 'P' (0x50) or 'F' (0x46)"
