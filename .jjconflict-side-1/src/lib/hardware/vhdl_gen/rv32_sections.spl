fn rv32_post_case() -> [text]:
    var l: [text] = []
    l = l.push("        end if;")
    l = l.push("")
    l

fn rv32_epilogue() -> [text]:
    var l: [text] = []
    l = l.push("        r(0) := (others => '0');")
    l = l.push("        -- Write divider result when complete")
    l = l.push("        if div_running_q = '0' and div_rd_q /= 0 and state_q = S_EXEC then")
    l = l.push("          r(div_rd_q) := div_result_q;")
    l = l.push("          div_rd_q <= 0;")
    l = l.push("        end if;")
    l = l.push("        regs_q <= r;")
    l = l.push("        if state_q = S_EXEC then")
    l = l.push("          pc_q <= pc_next;")
    l = l.push("        end if;")
    l = l.push("      end if;")
    l = l.push("")
    l = l.push("      -- === Physical memory ports (single read + single write per array) ===")
    l = l.push("      -- Funneled write port: both code-RAM copies written identically.")
    l = l.push("      if rom_we then")
    l = l.push("        rom_a(rom_wa) <= rom_wd;")
    l = l.push("        rom_b(rom_wa) <= rom_wd;")
    l = l.push("      end if;")
    l = l.push("      -- Registered (synchronous) reads: exactly one read port per physical")
    l = l.push("      -- array, address muxed by FSM state. Read-first semantics (VHDL signal")
    l = l.push("      -- arrays always read pre-edge contents), matching BRAM read-first.")
    l = l.push("      rom_a_q <= rom_a(rom_ra_a);")
    l = l.push("      rom_b_q <= rom_b(rom_ra_b);")
    l = l.push("      data_rom_q <= data_rom(dr_ra);")
    l = l.push("    end if;")
    l = l.push("  end process;")
    l = l.push("end architecture rtl;")
    l
