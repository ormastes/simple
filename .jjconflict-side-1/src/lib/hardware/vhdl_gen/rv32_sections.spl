# rv32_exec_core named literal sections (irreducible per-core logic paragraphs).
# Structured parts (entity/ports/generics/constants/decode arm headers/mem-init/
# dbg taps) are generated in gen_types.spl / exec_core_gen.spl — NOT here.
# Each function below is one named section; the header comment names it.

fn rv32_type_arrays() -> [text]:
    var l: [text] = []
    l = l.push("  type rom_t is array(0 to ROM_WORDS - 1) of std_logic_vector(31 downto 0);")
    l = l.push("  type data_rom_t is array(0 to DATA_ROM_WORDS - 1) of std_logic_vector(31 downto 0);")
    l

fn rv32_type_ldkind() -> [text]:
    var l: [text] = []
    l = l.push("  -- Deferred (synchronous-BRAM) load bookkeeping")
    l = l.push("  type ld_kind_t is (LD_WORD, LD_LB, LD_LBU);")
    l

fn rv32_sig_block_a() -> [text]:
    var l: [text] = []
    l = l.push("  -- Replicated code RAM: two identical physical copies, written identically.")
    l = l.push("  -- Each copy has exactly ONE synchronous read port (address muxed by FSM")
    l = l.push("  -- state) plus the shared write port -> simple-dual-port BRAM inferable.")
    l = l.push("  -- rom_a serves fetch word 0 and all data-side reads (loads / sb RMW, which")
    l = l.push("  -- happen in states where fetch is idle); rom_b serves fetch word 1")
    l = l.push("  -- (pc_idx + 1, needed for misaligned 32-bit instructions).")
    l = l.push("  signal rom_a : rom_t := init_rom;")
    l = l.push("  signal rom_b : rom_t := init_rom;")
    l = l.push("  signal data_rom : data_rom_t := init_data_rom;")
    l = l.push("  -- CSR file: minimal set for zicsr (mhartid=0, mstatus, mtvec, mie, mip)")
    l = l.push("  signal csr_mhartid : unsigned(31 downto 0) := x\"00000000\";")
    l = l.push("  signal csr_mstatus : unsigned(31 downto 0) := x\"00000000\";")
    l = l.push("  signal csr_mtvec : unsigned(31 downto 0) := x\"00000000\";")
    l = l.push("  signal csr_mie : unsigned(31 downto 0) := x\"00000000\";")
    l = l.push("  signal csr_mip : unsigned(31 downto 0) := x\"00000000\";")
    l = l.push("  -- Divider FSM state (multi-cycle for div/divu/rem/remu)")
    l = l.push("  signal div_op_q : std_logic_vector(2 downto 0) := (others => '0');")
    l = l.push("  signal div_running_q : std_logic := '0';")
    l = l.push("  signal div_sign_q : std_logic := '0';")
    l = l.push("  signal div_rem_q : std_logic := '0';")
    l = l.push("  signal div_neg_result_q : std_logic := '0';")
    l = l.push("  signal div_dividend_q : signed(63 downto 0) := (others => '0');")
    l = l.push("  signal div_divisor_q : signed(63 downto 0) := (others => '0');")
    l = l.push("  signal div_quotient_q : signed(31 downto 0) := (others => '0');")
    l = l.push("  signal div_count_q : unsigned(5 downto 0) := (others => '0');")
    l = l.push("  signal div_rd_q : natural range 0 to 31 := 0;")
    l = l.push("  signal div_result_q : unsigned(31 downto 0) := (others => '0');")
    l = l.push("  attribute rom_style : string;")
    l = l.push("  attribute ram_style : string;")
    l = l.push("  attribute ram_style of rom_a : signal is \"block\";")
    l = l.push("  attribute ram_style of rom_b : signal is \"block\";")
    l = l.push("  attribute rom_style of data_rom : signal is \"block\";")
    l = l.push("  -- Registered BRAM read data (one read port per physical array)")
    l = l.push("  signal rom_a_q : std_logic_vector(31 downto 0) := (others => '0');")
    l = l.push("  signal rom_b_q : std_logic_vector(31 downto 0) := (others => '0');")
    l = l.push("  signal data_rom_q : std_logic_vector(31 downto 0) := (others => '0');")
    l = l.push("  -- Deferred load / byte-store state")
    l = l.push("  signal ld_rd_q : natural range 0 to 31 := 0;")
    l = l.push("  signal ld_kind_q : ld_kind_t := LD_WORD;")
    l = l.push("  signal ld_lane_q : natural range 0 to 3 := 0;")
    l = l.push("  signal ld_src_data_q : std_logic := '0';")
    l = l.push("  signal st_idx_q : natural range 0 to ROM_WORDS - 1 := 0;")
    l = l.push("  signal st_lane_q : natural range 0 to 3 := 0;")
    l = l.push("  signal st_byte_q : std_logic_vector(7 downto 0) := (others => '0');")
    l = l.push("  signal regs_q : regs_t := (others => (others => '0'));")
    l = l.push("  signal pc_q : unsigned(31 downto 0) := BASE_ADDR;")
    l = l.push("  signal state_q : state_t := S_FETCH;")
    l = l.push("  signal next_pc_q : unsigned(31 downto 0) := BASE_ADDR;")
    l = l.push("  signal uart_tx_q : std_logic := '1';")
    l = l.push("  signal uart_busy_q : std_logic := '0';")
    l = l.push("  signal uart_baud_q : natural range 0 to CLK_FREQ := 0;")
    l = l.push("  signal uart_bits_q : natural range 0 to 10 := 0;")
    l = l.push("  signal uart_shift_q : std_logic_vector(9 downto 0) := (others => '1');")
    l

fn rv32_helper_funcs() -> [text]:
    var l: [text] = []
    l = l.push("  function sext(v : std_logic_vector) return unsigned is")
    l = l.push("  begin")
    l = l.push("    return unsigned(resize(signed(v), 32));")
    l = l.push("  end function;")
    l = l.push("")
    l = l.push("  function c_addi4spn_imm(h : std_logic_vector(15 downto 0)) return unsigned is")
    l = l.push("    variable imm : unsigned(9 downto 0) := (others => '0');")
    l = l.push("  begin")
    l = l.push("    imm(5 downto 4) := unsigned(h(12 downto 11));")
    l = l.push("    imm(9 downto 6) := unsigned(h(10 downto 7));")
    l = l.push("    imm(2) := h(6);")
    l = l.push("    imm(3) := h(5);")
    l = l.push("    return resize(imm, 32);")
    l = l.push("  end function;")
    l = l.push("")
    l = l.push("  function c_addi_imm(h : std_logic_vector(15 downto 0)) return unsigned is")
    l = l.push("  begin")
    l = l.push("    return sext(h(12) & h(6 downto 2));")
    l = l.push("  end function;")
    l = l.push("")
    l = l.push("  function c_lw_imm(h : std_logic_vector(15 downto 0)) return unsigned is")
    l = l.push("    variable imm : unsigned(6 downto 0) := (others => '0');")
    l = l.push("  begin")
    l = l.push("    -- RVC CL/CS-format word offset (C.LW / C.SW):")
    l = l.push("    --   imm[5:3] = inst[12:10], imm[2] = inst[6], imm[6] = inst[5].")
    l = l.push("    -- The earlier mapping mis-placed the fields (imm[5]:=inst[5],")
    l = l.push("    -- imm[4:2]:=inst[12:10], imm[6]:=inst[6]), decoding C.LW s0,4(s1) as")
    l = l.push("    -- offset 0x40 instead of 0x4 -> loads/stores hit the wrong word")
    l = l.push("    -- (GHDL vs QEMU divergence at pc 0x80002580 reading 0x80008E04).")
    l = l.push("    imm(5 downto 3) := unsigned(h(12 downto 10));")
    l = l.push("    imm(2) := h(6);")
    l = l.push("    imm(6) := h(5);")
    l = l.push("    return resize(imm, 32);")
    l = l.push("  end function;")
    l = l.push("")
    l = l.push("  function c_lwsp_imm(h : std_logic_vector(15 downto 0)) return unsigned is")
    l = l.push("    variable imm : unsigned(7 downto 0) := (others => '0');")
    l = l.push("  begin")
    l = l.push("    imm(5) := h(12);")
    l = l.push("    imm(4 downto 2) := unsigned(h(6 downto 4));")
    l = l.push("    imm(7 downto 6) := unsigned(h(3 downto 2));")
    l = l.push("    return resize(imm, 32);")
    l = l.push("  end function;")
    l = l.push("")
    l = l.push("  function c_swsp_imm(h : std_logic_vector(15 downto 0)) return unsigned is")
    l = l.push("    variable imm : unsigned(7 downto 0) := (others => '0');")
    l = l.push("  begin")
    l = l.push("    imm(5 downto 2) := unsigned(h(12 downto 9));")
    l = l.push("    imm(7 downto 6) := unsigned(h(8 downto 7));")
    l = l.push("    return resize(imm, 32);")
    l = l.push("  end function;")
    l = l.push("")
    l = l.push("  function c_lui_imm(h : std_logic_vector(15 downto 0)) return unsigned is")
    l = l.push("  begin")
    l = l.push("    return sext(h(12) & h(6 downto 2) & \"000000000000\");")
    l = l.push("  end function;")
    l = l.push("")
    l = l.push("  function c_addi16sp_imm(h : std_logic_vector(15 downto 0)) return unsigned is")
    l = l.push("    variable imm : std_logic_vector(9 downto 0) := (others => '0');")
    l = l.push("  begin")
    l = l.push("    imm(9) := h(12);")
    l = l.push("    imm(4) := h(6);")
    l = l.push("    imm(6) := h(5);")
    l = l.push("    imm(8 downto 7) := h(4 downto 3);")
    l = l.push("    imm(5) := h(2);")
    l = l.push("    return sext(imm);")
    l = l.push("  end function;")
    l = l.push("")
    l = l.push("  function c_j_imm(h : std_logic_vector(15 downto 0)) return unsigned is")
    l = l.push("    variable imm : std_logic_vector(11 downto 0) := (others => '0');")
    l = l.push("  begin")
    l = l.push("    imm(11) := h(12);")
    l = l.push("    imm(4) := h(11);")
    l = l.push("    imm(9 downto 8) := h(10 downto 9);")
    l = l.push("    imm(10) := h(8);")
    l = l.push("    imm(6) := h(7);")
    l = l.push("    imm(7) := h(6);")
    l = l.push("    imm(3 downto 1) := h(5 downto 3);")
    l = l.push("    imm(5) := h(2);")
    l = l.push("    return sext(imm);")
    l = l.push("  end function;")
    l = l.push("")
    l = l.push("  function c_b_imm(h : std_logic_vector(15 downto 0)) return unsigned is")
    l = l.push("    variable imm : std_logic_vector(8 downto 0) := (others => '0');")
    l = l.push("  begin")
    l = l.push("    imm(8) := h(12);")
    l = l.push("    imm(4 downto 3) := h(11 downto 10);")
    l = l.push("    imm(7 downto 6) := h(6 downto 5);")
    l = l.push("    imm(2 downto 1) := h(4 downto 3);")
    l = l.push("    imm(5) := h(2);")
    l = l.push("    return sext(imm);")
    l = l.push("  end function;")
    l = l.push("")
    l = l.push("  function word_index(addr : unsigned(31 downto 0)) return natural is")
    l = l.push("    variable off : unsigned(31 downto 0);")
    l = l.push("  begin")
    l = l.push("    off := addr - BASE_ADDR;")
    l = l.push("    return to_integer(off(15 downto 2));")
    l = l.push("  end function;")
    l = l.push("")
    l = l.push("  function data_rom_index(addr : unsigned(31 downto 0)) return natural is")
    l = l.push("    variable off : unsigned(31 downto 0);")
    l = l.push("  begin")
    l = l.push("    off := addr - x\"40000000\";")
    l = l.push("    return to_integer(off(15 downto 2));")
    l = l.push("  end function;")
    l = l.push("")
    l = l.push("  -- NOTE: the former impure load_word/load_byte helpers performed")
    l = l.push("  -- asynchronous multi-port reads of rom/data_rom, which forced 16k-deep")
    l = l.push("  -- LUTRAM and killed K26 placement. Loads from rom/data_rom are now")
    l = l.push("  -- deferred one cycle through the S_LOAD state using the registered")
    l = l.push("  -- single-port BRAM reads (rom_a_q / data_rom_q). Word index ranges:")
    l = l.push("  -- word_index/data_rom_index return off(15 downto 2), i.e. 0..16383, so")
    l = l.push("  -- in-region indexes are always < ROM_WORDS / DATA_ROM_WORDS and loads")
    l = l.push("  -- from nibble-4/nibble-8 regions always hit data_rom/rom respectively")
    l = l.push("  -- (identical to the old guard outcomes).")
    l

fn rv32_process_head() -> [text]:
    var l: [text] = []
    l = l.push("  process(clk)")
    l = l.push("    variable r : regs_t;")
    l = l.push("    variable pc_next : unsigned(31 downto 0);")
    l = l.push("    variable pc_idx : natural;")
    l = l.push("    variable w : std_logic_vector(31 downto 0);")
    l = l.push("    variable w2 : std_logic_vector(31 downto 0);")
    l = l.push("    variable h : std_logic_vector(15 downto 0);")
    l = l.push("    variable ins : std_logic_vector(31 downto 0);")
    l = l.push("    variable op : std_logic_vector(6 downto 0);")
    l = l.push("    variable rd : natural range 0 to 31;")
    l = l.push("    variable rs1 : natural range 0 to 31;")
    l = l.push("    variable rs2 : natural range 0 to 31;")
    l = l.push("    variable eff : unsigned(31 downto 0);")
    l = l.push("    variable data_w : std_logic_vector(31 downto 0);")
    l = l.push("    variable crs1 : natural range 0 to 31;")
    l = l.push("    variable crs2 : natural range 0 to 31;")
    l = l.push("    variable mem_idx : natural;")
    l = l.push("    variable load_addr : unsigned(31 downto 0);")
    l = l.push("    variable mul_result : signed(31 downto 0);")
    l = l.push("    variable mul_result_full : signed(63 downto 0);")
    l = l.push("    variable rs1_signed : signed(31 downto 0);")
    l = l.push("    variable rs2_signed : signed(31 downto 0);")
    l = l.push("    variable dvd : signed(63 downto 0);")
    l = l.push("    variable res32 : unsigned(31 downto 0);")
    l = l.push("    -- Single muxed read address per physical memory + funneled write port")
    l = l.push("    variable rom_ra_a : natural range 0 to ROM_WORDS - 1;")
    l = l.push("    variable rom_ra_b : natural range 0 to ROM_WORDS - 1;")
    l = l.push("    variable dr_ra : natural range 0 to DATA_ROM_WORDS - 1;")
    l = l.push("    variable rom_we : boolean;")
    l = l.push("    variable rom_wa : natural range 0 to ROM_WORDS - 1;")
    l = l.push("    variable rom_wd : std_logic_vector(31 downto 0);")
    l = l.push("    variable idxp1 : natural;")
    l = l.push("    variable ld_w : std_logic_vector(31 downto 0);")
    l = l.push("  begin")
    l

fn rv32_exec_prelude() -> [text]:
    var l: [text] = []
    l = l.push("    if rising_edge(clk) then")
    l = l.push("      -- Default memory port addressing: prefetch current pc words. States")
    l = l.push("      -- that need a data-side read (S_EXEC issuing a load or sb RMW)")
    l = l.push("      -- override rom_ra_a / dr_ra below before the registered reads at the")
    l = l.push("      -- bottom of this process.")
    l = l.push("      rom_we := false;")
    l = l.push("      rom_wa := 0;")
    l = l.push("      rom_wd := (others => '0');")
    l = l.push("      pc_idx := word_index(pc_q);")
    l = l.push("      rom_ra_a := pc_idx;")
    l = l.push("      idxp1 := pc_idx + 1;")
    l = l.push("      if idxp1 < ROM_WORDS then")
    l = l.push("        rom_ra_b := idxp1;")
    l = l.push("      else")
    l = l.push("        rom_ra_b := ROM_WORDS - 1;")
    l = l.push("      end if;")
    l = l.push("      dr_ra := 0;")
    l = l.push("      debug_uart_valid_q <= debug_uart_valid_next_q;")
    l = l.push("      debug_uart_valid_next_q <= '0';")
    l = l.push("      if uart_busy_q = '1' then")
    l = l.push("        if uart_baud_q >= BAUD_DIV - 1 then")
    l = l.push("          uart_baud_q <= 0;")
    l = l.push("          if uart_bits_q > 1 then")
    l = l.push("            uart_tx_q <= uart_shift_q(1);")
    l = l.push("            uart_shift_q <= '1' & uart_shift_q(9 downto 1);")
    l = l.push("            uart_bits_q <= uart_bits_q - 1;")
    l = l.push("          else")
    l = l.push("            uart_tx_q <= '1';")
    l = l.push("            uart_busy_q <= '0';")
    l = l.push("            uart_bits_q <= 0;")
    l = l.push("          end if;")
    l = l.push("        else")
    l = l.push("          uart_baud_q <= uart_baud_q + 1;")
    l = l.push("        end if;")
    l = l.push("      end if;")
    l = l.push("")
    l = l.push("      if rst = '1' then")
    l = l.push("        regs_q <= (others => (others => '0'));")
    l = l.push("        pc_q <= BASE_ADDR;")
    l = l.push("        next_pc_q <= BASE_ADDR;")
    l = l.push("        state_q <= S_FETCH;")
    l = l.push("        ld_rd_q <= 0;")
    l = l.push("        ld_kind_q <= LD_WORD;")
    l = l.push("        ld_lane_q <= 0;")
    l = l.push("        ld_src_data_q <= '0';")
    l = l.push("        st_idx_q <= 0;")
    l = l.push("        st_lane_q <= 0;")
    l = l.push("        st_byte_q <= (others => '0');")
    l = l.push("        uart_tx_q <= '1';")
    l = l.push("        uart_busy_q <= '0';")
    l = l.push("        uart_baud_q <= 0;")
    l = l.push("        uart_bits_q <= 0;")
    l = l.push("        uart_shift_q <= (others => '1');")
    l = l.push("        debug_uart_valid_q <= '0';")
    l = l.push("        debug_uart_valid_next_q <= '0';")
    l = l.push("        debug_uart_byte_q <= (others => '0');")
    l = l.push("        debug_pc_q <= (others => '0');")
    l = l.push("        debug_ins_q <= (others => '0');")
    l = l.push("        debug_a0_q <= (others => '0');")
    l = l.push("        debug_ra_q <= (others => '0');")
    l = l.push("        debug_sp_q <= (others => '0');")
    l = l.push("        debug_phase_q <= (others => '0');")
    l = l.push("        csr_mhartid <= (others => '0');")
    l = l.push("        csr_mstatus <= (others => '0');")
    l = l.push("        csr_mtvec <= (others => '0');")
    l = l.push("        csr_mie <= (others => '0');")
    l = l.push("        csr_mip <= (others => '0');")
    l = l.push("        div_running_q <= '0';")
    l = l.push("        div_op_q <= (others => '0');")
    l = l.push("        div_sign_q <= '0';")
    l = l.push("        div_rem_q <= '0';")
    l = l.push("        div_neg_result_q <= '0';")
    l = l.push("        div_dividend_q <= (others => '0');")
    l = l.push("        div_divisor_q <= (others => '0');")
    l = l.push("        div_quotient_q <= (others => '0');")
    l = l.push("        div_count_q <= (others => '0');")
    l = l.push("        div_rd_q <= 0;")
    l = l.push("        div_result_q <= (others => '0');")
    l = l.push("      elsif state_q = S_UART then")
    l = l.push("        if uart_busy_q = '0' then")
    l = l.push("          pc_q <= next_pc_q;")
    l = l.push("          state_q <= S_FETCH;")
    l = l.push("        end if;")
    l = l.push("      elsif state_q = S_DIVIDE then")
    l = l.push("        -- Multi-cycle divider FSM")
    l = l.push("        if div_count_q /= 0 then")
    l = l.push("          div_count_q <= div_count_q - 1;")
    l = l.push("          -- Shift first, then compare/subtract the SHIFTED remainder (restoring division)")
    l = l.push("          dvd := shift_left(div_dividend_q, 1);")
    l = l.push("          -- restoring division: UNSIGNED compare of the 32-bit partial remainder")
    l = l.push("          -- (high half, after shift) vs the 32-bit divisor magnitude.")
    l = l.push("          if unsigned(dvd(63 downto 32)) >= unsigned(div_divisor_q(31 downto 0)) then")
    l = l.push("            dvd(63 downto 32) := dvd(63 downto 32) - div_divisor_q(31 downto 0);")
    l = l.push("            div_quotient_q <= shift_left(div_quotient_q, 1) + 1;")
    l = l.push("          else")
    l = l.push("            div_quotient_q <= shift_left(div_quotient_q, 1);")
    l = l.push("          end if;")
    l = l.push("          div_dividend_q <= dvd;")
    l = l.push("        else")
    l = l.push("          div_running_q <= '0';")
    l = l.push("          state_q <= S_FETCH;")
    l = l.push("          -- Compute the final result into res32, then write it DIRECTLY to the")
    l = l.push("          -- register file here (signal assignment, effective the cycle S_EXEC")
    l = l.push("          -- resumes). This makes the result visible to the next instruction via")
    l = l.push("          -- r:=regs_q, avoiding the load-use hazard where the post-div/rem")
    l = l.push("          -- instruction would otherwise read the stale register.")
    l = l.push("          if div_rem_q = '1' then")
    l = l.push("            -- After 32 left-shifts, remainder is in bits 63:32")
    l = l.push("            if div_neg_result_q = '1' then")
    l = l.push("              res32 := unsigned(-signed(div_dividend_q(63 downto 32)));")
    l = l.push("            else")
    l = l.push("              res32 := unsigned(div_dividend_q(63 downto 32));")
    l = l.push("            end if;")
    l = l.push("          else")
    l = l.push("            if div_neg_result_q = '1' then")
    l = l.push("              res32 := unsigned(-div_quotient_q);")
    l = l.push("            else")
    l = l.push("              res32 := unsigned(div_quotient_q);")
    l = l.push("            end if;")
    l = l.push("          end if;")
    l = l.push("          div_result_q <= res32;")
    l = l.push("          if div_rd_q /= 0 then")
    l = l.push("            regs_q(div_rd_q) <= res32;")
    l = l.push("          end if;")
    l = l.push("          div_rd_q <= 0;")
    l = l.push("        end if;")
    l = l.push("      elsif state_q = S_FETCH then")
    l = l.push("        -- Fetch cycle: registered BRAM reads at the bottom of this process")
    l = l.push("        -- latch rom_a(pc_idx) / rom_b(pc_idx + 1) this edge (default")
    l = l.push("        -- addressing above); decode + execute happens next cycle in S_EXEC.")
    l = l.push("        state_q <= S_EXEC;")
    l = l.push("      elsif state_q = S_LOAD then")
    l = l.push("        -- Complete a deferred rom/data_rom load using the data registered on")
    l = l.push("        -- the previous edge.")
    l = l.push("        if ld_src_data_q = '1' then")
    l = l.push("          ld_w := data_rom_q;")
    l = l.push("        else")
    l = l.push("          ld_w := rom_a_q;")
    l = l.push("        end if;")
    l = l.push("        if ld_rd_q /= 0 then")
    l = l.push("          case ld_kind_q is")
    l = l.push("            when LD_WORD =>")
    l = l.push("              regs_q(ld_rd_q) <= unsigned(ld_w);")
    l = l.push("            when LD_LB =>")
    l = l.push("              regs_q(ld_rd_q) <= sext(ld_w(ld_lane_q * 8 + 7 downto ld_lane_q * 8));")
    l = l.push("            when LD_LBU =>")
    l = l.push("              regs_q(ld_rd_q) <= resize(unsigned(ld_w(ld_lane_q * 8 + 7 downto ld_lane_q * 8)), 32);")
    l = l.push("          end case;")
    l = l.push("        end if;")
    l = l.push("        state_q <= S_FETCH;")
    l = l.push("      elsif state_q = S_STORE then")
    l = l.push("        -- Complete an sb read-modify-write to the code RAM: rom_a_q holds")
    l = l.push("        -- the word registered last edge; merge the byte lane and write both")
    l = l.push("        -- physical copies via the funneled write port.")
    l = l.push("        data_w := rom_a_q;")
    l = l.push("        data_w(st_lane_q * 8 + 7 downto st_lane_q * 8) := st_byte_q;")
    l = l.push("        rom_we := true;")
    l = l.push("        rom_wa := st_idx_q;")
    l = l.push("        rom_wd := data_w;")
    l = l.push("        state_q <= S_FETCH;")
    l = l.push("      else")
    l = l.push("        r := regs_q;")
    l = l.push("        -- Default next state: back to fetch (overridden below by UART /")
    l = l.push("        -- DIVIDE / deferred LOAD / deferred STORE transitions).")
    l = l.push("        state_q <= S_FETCH;")
    l = l.push("        pc_next := pc_q + 4;")
    l = l.push("        -- pc_idx was set in the per-cycle defaults; instruction words were")
    l = l.push("        -- registered from the replicated BRAMs during S_FETCH.")
    l = l.push("        if pc_idx < ROM_WORDS then")
    l = l.push("          w := rom_a_q;")
    l = l.push("        else")
    l = l.push("          w := x\"00000013\";")
    l = l.push("        end if;")
    l = l.push("        if pc_q(1) = '0' then")
    l = l.push("          h := w(15 downto 0);")
    l = l.push("          ins := w;")
    l = l.push("        else")
    l = l.push("          h := w(31 downto 16);")
    l = l.push("          if pc_idx + 1 < ROM_WORDS then")
    l = l.push("            w2 := rom_b_q;")
    l = l.push("          else")
    l = l.push("            w2 := x\"00000013\";")
    l = l.push("          end if;")
    l = l.push("          ins := w2(15 downto 0) & w(31 downto 16);")
    l = l.push("        end if;")
    l = l.push("")
    l

fn rv32_rvc_decode() -> [text]:
    var l: [text] = []
    l = l.push("        if h(1 downto 0) /= \"11\" then")
    l = l.push("          pc_next := pc_q + 2;")
    l = l.push("          if h(1 downto 0) = \"01\" then")
    l = l.push("            case h(15 downto 13) is")
    l = l.push("              when \"000\" =>")
    l = l.push("                rd := to_integer(unsigned(h(11 downto 7)));")
    l = l.push("                if rd /= 0 then")
    l = l.push("                  r(rd) := r(rd) + c_addi_imm(h);")
    l = l.push("                end if;")
    l = l.push("              when \"001\" =>")
    l = l.push("                r(1) := pc_q + 2;")
    l = l.push("                pc_next := pc_q + c_j_imm(h);")
    l = l.push("              when \"010\" =>")
    l = l.push("                rd := to_integer(unsigned(h(11 downto 7)));")
    l = l.push("                if rd /= 0 then")
    l = l.push("                  r(rd) := c_addi_imm(h);")
    l = l.push("                end if;")
    l = l.push("              when \"011\" =>")
    l = l.push("                rd := to_integer(unsigned(h(11 downto 7)));")
    l = l.push("                if rd = 2 then")
    l = l.push("                  r(2) := r(2) + c_addi16sp_imm(h);")
    l = l.push("                elsif rd /= 0 then")
    l = l.push("                  r(rd) := c_lui_imm(h);")
    l = l.push("                end if;")
    l = l.push("              when \"100\" =>")
    l = l.push("                -- C1 MISC-ALU group. h(11 downto 10) selects the sub-op; the")
    l = l.push("                -- earlier decode looked only at h(12) and so mis-ran C.SRAI,")
    l = l.push("                -- C.SUB/C.XOR/C.OR/C.AND (and small-immediate C.ANDI) all as")
    l = l.push("                -- C.SRLI. Decode the full field.")
    l = l.push("                rd := 8 + to_integer(unsigned(h(9 downto 7)));  -- rd'/rs1'")
    l = l.push("                case h(11 downto 10) is")
    l = l.push("                  when \"00\" => -- C.SRLI (rv32: shamt = h(6 downto 2), h(12)=0)")
    l = l.push("                    r(rd) := shift_right(r(rd), to_integer(unsigned(h(6 downto 2))));")
    l = l.push("                  when \"01\" => -- C.SRAI (arithmetic)")
    l = l.push("                    r(rd) := unsigned(shift_right(signed(r(rd)), to_integer(unsigned(h(6 downto 2)))));")
    l = l.push("                  when \"10\" => -- C.ANDI (sign-extended CI immediate)")
    l = l.push("                    r(rd) := r(rd) and c_addi_imm(h);")
    l = l.push("                  when others => -- \"11\": CA-format register-register ops")
    l = l.push("                    rs2 := 8 + to_integer(unsigned(h(4 downto 2)));  -- rs2'")
    l = l.push("                    case h(6 downto 5) is")
    l = l.push("                      when \"00\" => r(rd) := r(rd) - r(rs2);    -- C.SUB")
    l = l.push("                      when \"01\" => r(rd) := r(rd) xor r(rs2);  -- C.XOR")
    l = l.push("                      when \"10\" => r(rd) := r(rd) or r(rs2);   -- C.OR")
    l = l.push("                      when others => r(rd) := r(rd) and r(rs2);-- C.AND")
    l = l.push("                    end case;")
    l = l.push("                end case;")
    l = l.push("              when \"101\" =>")
    l = l.push("                pc_next := pc_q + c_j_imm(h);")
    l = l.push("              when \"110\" =>")
    l = l.push("                rs1 := 8 + to_integer(unsigned(h(9 downto 7)));")
    l = l.push("                if r(rs1) = 0 then")
    l = l.push("                  pc_next := pc_q + c_b_imm(h);")
    l = l.push("                end if;")
    l = l.push("              when others =>")
    l = l.push("                rs1 := 8 + to_integer(unsigned(h(9 downto 7)));")
    l = l.push("                if r(rs1) /= 0 then")
    l = l.push("                  pc_next := pc_q + c_b_imm(h);")
    l = l.push("                end if;")
    l = l.push("            end case;")
    l = l.push("          end if;")
    l = l.push("")
    l = l.push("          if h(1 downto 0) = \"00\" then")
    l = l.push("            if h(15 downto 13) = \"000\" then")
    l = l.push("              rd := 8 + to_integer(unsigned(h(4 downto 2)));")
    l = l.push("              r(rd) := r(2) + c_addi4spn_imm(h);")
    l = l.push("            elsif h(15 downto 13) = \"010\" then")
    l = l.push("              rd := 8 + to_integer(unsigned(h(4 downto 2)));")
    l = l.push("              rs1 := 8 + to_integer(unsigned(h(9 downto 7)));")
    l = l.push("              load_addr := r(rs1) + c_lw_imm(h);")
    l = l.push("              mem_idx := word_index(load_addr);")
    l = l.push("                -- Deferred sync-BRAM load (was: r(rd) := load_word(load_addr))")
    l = l.push("                if load_addr(31 downto 28) = x\"4\" then")
    l = l.push("                  dr_ra := data_rom_index(load_addr);")
    l = l.push("                  ld_src_data_q <= '1';")
    l = l.push("                  ld_rd_q <= rd;")
    l = l.push("                  ld_kind_q <= LD_WORD;")
    l = l.push("                  state_q <= S_LOAD;")
    l = l.push("                elsif load_addr(31 downto 28) = x\"8\" then")
    l = l.push("                  rom_ra_a := word_index(load_addr);")
    l = l.push("                  ld_src_data_q <= '0';")
    l = l.push("                  ld_rd_q <= rd;")
    l = l.push("                  ld_kind_q <= LD_WORD;")
    l = l.push("                  state_q <= S_LOAD;")
    l = l.push("                else")
    l = l.push("                  r(rd) := (others => '0');")
    l = l.push("                end if;")
    l = l.push("            elsif h(15 downto 13) = \"110\" then")
    l = l.push("              rs1 := 8 + to_integer(unsigned(h(9 downto 7)));")
    l = l.push("              rs2 := 8 + to_integer(unsigned(h(4 downto 2)));")
    l = l.push("              eff := r(rs1) + c_lw_imm(h);")
    l = l.push("              mem_idx := word_index(eff);")
    l = l.push("              if mem_idx < ROM_WORDS then")
    l = l.push("                rom_we := true;")
    l = l.push("                rom_wa := mem_idx;")
    l = l.push("                rom_wd := std_logic_vector(r(rs2));")
    l = l.push("              end if;")
    l = l.push("            end if;")
    l = l.push("          elsif h(1 downto 0) = \"10\" then")
    l = l.push("            if h(15 downto 13) = \"000\" then")
    l = l.push("              rd := to_integer(unsigned(h(11 downto 7)));")
    l = l.push("              if rd /= 0 then")
    l = l.push("                r(rd) := shift_left(r(rd), to_integer(unsigned(h(6 downto 2))));")
    l = l.push("              end if;")
    l = l.push("            elsif h(15 downto 13) = \"010\" then")
    l = l.push("              rd := to_integer(unsigned(h(11 downto 7)));")
    l = l.push("              if rd /= 0 then")
    l = l.push("                load_addr := r(2) + c_lwsp_imm(h);")
    l = l.push("                mem_idx := word_index(load_addr);")
    l = l.push("                  -- Deferred sync-BRAM load (was: r(rd) := load_word(load_addr))")
    l = l.push("                  if load_addr(31 downto 28) = x\"4\" then")
    l = l.push("                    dr_ra := data_rom_index(load_addr);")
    l = l.push("                    ld_src_data_q <= '1';")
    l = l.push("                    ld_rd_q <= rd;")
    l = l.push("                    ld_kind_q <= LD_WORD;")
    l = l.push("                    state_q <= S_LOAD;")
    l = l.push("                  elsif load_addr(31 downto 28) = x\"8\" then")
    l = l.push("                    rom_ra_a := word_index(load_addr);")
    l = l.push("                    ld_src_data_q <= '0';")
    l = l.push("                    ld_rd_q <= rd;")
    l = l.push("                    ld_kind_q <= LD_WORD;")
    l = l.push("                    state_q <= S_LOAD;")
    l = l.push("                  else")
    l = l.push("                    r(rd) := (others => '0');")
    l = l.push("                  end if;")
    l = l.push("              end if;")
    l = l.push("            elsif h(15 downto 13) = \"100\" then")
    l = l.push("              rd := to_integer(unsigned(h(11 downto 7)));")
    l = l.push("              rs2 := to_integer(unsigned(h(6 downto 2)));")
    l = l.push("              if h(12) = '0' then")
    l = l.push("                -- c.jr rs1 (rs2=0) / c.mv rd,rs2 (rs2/=0)")
    l = l.push("                if rs2 = 0 then")
    l = l.push("                  if rd /= 0 then")
    l = l.push("                    pc_next := r(rd);")
    l = l.push("                  end if;")
    l = l.push("                elsif rd /= 0 then")
    l = l.push("                  r(rd) := r(rs2);")
    l = l.push("                end if;")
    l = l.push("              else")
    l = l.push("                -- c.jalr rs1 (rs2=0): ra=pc+2, pc=rs1  /  c.add rd,rs2 (rs2/=0): rd+=rs2")
    l = l.push("                if rs2 = 0 then")
    l = l.push("                  if rd /= 0 then")
    l = l.push("                    pc_next := r(rd);")
    l = l.push("                    r(1) := pc_q + 2;")
    l = l.push("                  end if;")
    l = l.push("                elsif rd /= 0 then")
    l = l.push("                  r(rd) := r(rd) + r(rs2);")
    l = l.push("                end if;")
    l = l.push("              end if;")
    l = l.push("            elsif h(15 downto 13) = \"110\" then")
    l = l.push("              rs2 := to_integer(unsigned(h(6 downto 2)));")
    l = l.push("              eff := r(2) + c_swsp_imm(h);")
    l = l.push("              mem_idx := word_index(eff);")
    l = l.push("              if mem_idx < ROM_WORDS then")
    l = l.push("                rom_we := true;")
    l = l.push("                rom_wa := mem_idx;")
    l = l.push("                rom_wd := std_logic_vector(r(rs2));")
    l = l.push("              end if;")
    l = l.push("            end if;")
    l = l.push("          end if;")
    l = l.push("        else")
    l = l.push("          op := ins(6 downto 0);")
    l = l.push("          rd := to_integer(unsigned(ins(11 downto 7)));")
    l = l.push("          rs1 := to_integer(unsigned(ins(19 downto 15)));")
    l = l.push("          rs2 := to_integer(unsigned(ins(24 downto 20)));")
    l

fn rv32_arm_op_imm() -> [text]:
    var l: [text] = []
    l = l.push("              if rd /= 0 then")
    l = l.push("                case ins(14 downto 12) is")
    l = l.push("                  when \"000\" => r(rd) := r(rs1) + sext(ins(31 downto 20));")
    l = l.push("                  when \"111\" => r(rd) := r(rs1) and sext(ins(31 downto 20));")
    l = l.push("                  when \"100\" => r(rd) := r(rs1) xor sext(ins(31 downto 20));")
    l = l.push("                  when \"110\" => r(rd) := r(rs1) or sext(ins(31 downto 20));")
    l = l.push("                  when \"010\" =>")
    l = l.push("                    if signed(r(rs1)) < signed(sext(ins(31 downto 20))) then r(rd) := to_unsigned(1, 32); else r(rd) := (others => '0'); end if;")
    l = l.push("                  when \"011\" =>")
    l = l.push("                    if r(rs1) < sext(ins(31 downto 20)) then r(rd) := to_unsigned(1, 32); else r(rd) := (others => '0'); end if;")
    l = l.push("                  when \"001\" => r(rd) := shift_left(r(rs1), to_integer(unsigned(ins(24 downto 20))));")
    l = l.push("                  when \"101\" =>")
    l = l.push("                    if ins(30) = '1' then r(rd) := unsigned(shift_right(signed(r(rs1)), to_integer(unsigned(ins(24 downto 20)))));")
    l = l.push("                    else r(rd) := shift_right(r(rs1), to_integer(unsigned(ins(24 downto 20)))); end if;")
    l = l.push("                  when others => null;")
    l = l.push("                end case;")
    l = l.push("              end if;")
    l

fn rv32_arm_op() -> [text]:
    var l: [text] = []
    l = l.push("              if rd /= 0 then")
    l = l.push("                if ins(31 downto 25) = \"0000001\" then")
    l = l.push("                  -- M-extension (funct7=0000001)")
    l = l.push("                  case ins(14 downto 12) is")
    l = l.push("                    when \"000\" => -- mul (full 32-bit multiply, take low 32 bits)")
    l = l.push("                      mul_result_full := signed(unsigned(r(rs1))) * signed(unsigned(r(rs2)));")
    l = l.push("                      r(rd) := unsigned(mul_result_full(31 downto 0));")
    l = l.push("                    when \"001\" => -- mulh (signed * signed, high 32 bits)")
    l = l.push("                      mul_result_full := signed(r(rs1)) * signed(r(rs2));")
    l = l.push("                      r(rd) := unsigned(mul_result_full(63 downto 32));")
    l = l.push("                    when \"010\" => -- mulhsu (signed * unsigned, high 32 bits)")
    l = l.push("                      -- correction form (all 64-bit, synth-safe): for a<0,")
    l = l.push("                      -- signed(a)*unsigned(b) = a_unsigned*b - 2^32*b")
    l = l.push("                      mul_result_full := signed(unsigned(r(rs1)) * unsigned(r(rs2)));")
    l = l.push("                      if signed(r(rs1)) < 0 then")
    l = l.push("                        mul_result_full := mul_result_full - shift_left(resize(signed(unsigned(r(rs2))), 64), 32);")
    l = l.push("                      end if;")
    l = l.push("                      r(rd) := unsigned(mul_result_full(63 downto 32));")
    l = l.push("                    when \"011\" => -- mulhu (unsigned * unsigned, high 32 bits)")
    l = l.push("                      mul_result_full := signed(unsigned(r(rs1)) * unsigned(r(rs2)));")
    l = l.push("                      r(rd) := unsigned(mul_result_full(63 downto 32));")
    l = l.push("                    when \"100\" => -- div (signed, truncate toward zero)")
    l = l.push("                      if r(rs2) = 0 then")
    l = l.push("                        r(rd) := x\"FFFFFFFF\";")
    l = l.push("                      elsif signed(r(rs1)) = -16#80000000# and r(rs2) = x\"FFFFFFFF\" then")
    l = l.push("                        r(rd) := x\"80000000\";")
    l = l.push("                      else")
    l = l.push("                        -- Start multi-cycle division")
    l = l.push("                        div_running_q <= '1';")
    l = l.push("                        div_op_q <= \"100\";")
    l = l.push("                        div_sign_q <= '1';")
    l = l.push("                        div_rem_q <= '0';")
    l = l.push("                        div_rd_q <= rd;")
    l = l.push("                        rs1_signed := signed(r(rs1));")
    l = l.push("                        rs2_signed := signed(r(rs2));")
    l = l.push("                        -- Quotient needs negation if signs differ")
    l = l.push("                        if (rs1_signed < 0) /= (rs2_signed < 0) then")
    l = l.push("                          div_neg_result_q <= '1';")
    l = l.push("                        else")
    l = l.push("                          div_neg_result_q <= '0';")
    l = l.push("                        end if;")
    l = l.push("                        if rs1_signed < 0 then")
    l = l.push("                          div_dividend_q <= to_signed(0, 32) & resize(-rs1_signed, 32);")
    l = l.push("                        else")
    l = l.push("                          div_dividend_q <= to_signed(0, 32) & rs1_signed;")
    l = l.push("                        end if;")
    l = l.push("                        if rs2_signed < 0 then")
    l = l.push("                          div_divisor_q <= to_signed(0, 32) & resize(-rs2_signed, 32);")
    l = l.push("                        else")
    l = l.push("                          div_divisor_q <= to_signed(0, 32) & rs2_signed;")
    l = l.push("                        end if;")
    l = l.push("                        div_divisor_q(63 downto 32) <= (others => '0');")
    l = l.push("                        div_count_q <= to_unsigned(32, 6);")
    l = l.push("                        div_quotient_q <= (others => '0');")
    l = l.push("                        state_q <= S_DIVIDE;")
    l = l.push("                      end if;")
    l = l.push("                    when \"101\" => -- divu (unsigned)")
    l = l.push("                      if r(rs2) = 0 then")
    l = l.push("                        r(rd) := x\"FFFFFFFF\";")
    l = l.push("                      else")
    l = l.push("                        -- Start multi-cycle unsigned division")
    l = l.push("                        div_running_q <= '1';")
    l = l.push("                        div_op_q <= \"101\";")
    l = l.push("                        div_sign_q <= '0';")
    l = l.push("                        div_rem_q <= '0';")
    l = l.push("                        div_neg_result_q <= '0';")
    l = l.push("                        div_rd_q <= rd;")
    l = l.push("                        rs1_signed := signed(r(rs1));")
    l = l.push("                        rs2_signed := signed(r(rs2));")
    l = l.push("                        div_dividend_q <= to_signed(0, 32) & rs1_signed;")
    l = l.push("                        div_divisor_q <= to_signed(0, 32) & rs2_signed;")
    l = l.push("                        div_count_q <= to_unsigned(32, 6);")
    l = l.push("                        div_quotient_q <= (others => '0');")
    l = l.push("                        state_q <= S_DIVIDE;")
    l = l.push("                      end if;")
    l = l.push("                    when \"110\" => -- rem (signed remainder)")
    l = l.push("                      if r(rs2) = 0 then")
    l = l.push("                        r(rd) := r(rs1);")
    l = l.push("                      elsif signed(r(rs1)) = -16#80000000# and r(rs2) = x\"FFFFFFFF\" then")
    l = l.push("                        r(rd) := x\"00000000\";")
    l = l.push("                      else")
    l = l.push("                        -- Start multi-cycle signed remainder")
    l = l.push("                        div_running_q <= '1';")
    l = l.push("                        div_op_q <= \"110\";")
    l = l.push("                        div_sign_q <= '1';")
    l = l.push("                        div_rem_q <= '1';")
    l = l.push("                        div_rd_q <= rd;")
    l = l.push("                        rs1_signed := signed(r(rs1));")
    l = l.push("                        rs2_signed := signed(r(rs2));")
    l = l.push("                        -- Remainder inherits dividend's sign")
    l = l.push("                        if rs1_signed < 0 then")
    l = l.push("                          div_neg_result_q <= '1';")
    l = l.push("                        else")
    l = l.push("                          div_neg_result_q <= '0';")
    l = l.push("                        end if;")
    l = l.push("                        if rs1_signed < 0 then")
    l = l.push("                          div_dividend_q <= to_signed(0, 32) & resize(-rs1_signed, 32);")
    l = l.push("                        else")
    l = l.push("                          div_dividend_q <= to_signed(0, 32) & rs1_signed;")
    l = l.push("                        end if;")
    l = l.push("                        if rs2_signed < 0 then")
    l = l.push("                          div_divisor_q <= to_signed(0, 32) & resize(-rs2_signed, 32);")
    l = l.push("                        else")
    l = l.push("                          div_divisor_q <= to_signed(0, 32) & rs2_signed;")
    l = l.push("                        end if;")
    l = l.push("                        div_divisor_q(63 downto 32) <= (others => '0');")
    l = l.push("                        div_count_q <= to_unsigned(32, 6);")
    l = l.push("                        div_quotient_q <= (others => '0');")
    l = l.push("                        state_q <= S_DIVIDE;")
    l = l.push("                      end if;")
    l = l.push("                    when \"111\" => -- remu (unsigned remainder)")
    l = l.push("                      if r(rs2) = 0 then")
    l = l.push("                        r(rd) := r(rs1);")
    l = l.push("                      else")
    l = l.push("                        -- Start multi-cycle unsigned remainder")
    l = l.push("                        div_running_q <= '1';")
    l = l.push("                        div_op_q <= \"111\";")
    l = l.push("                        div_sign_q <= '0';")
    l = l.push("                        div_rem_q <= '1';")
    l = l.push("                        div_neg_result_q <= '0';")
    l = l.push("                        div_rd_q <= rd;")
    l = l.push("                        rs1_signed := signed(r(rs1));")
    l = l.push("                        rs2_signed := signed(r(rs2));")
    l = l.push("                        div_dividend_q <= to_signed(0, 32) & rs1_signed;")
    l = l.push("                        div_divisor_q <= to_signed(0, 32) & rs2_signed;")
    l = l.push("                        div_count_q <= to_unsigned(32, 6);")
    l = l.push("                        div_quotient_q <= (others => '0');")
    l = l.push("                        state_q <= S_DIVIDE;")
    l = l.push("                      end if;")
    l = l.push("                    when others => null;")
    l = l.push("                  end case;")
    l = l.push("                else")
    l = l.push("                  -- Standard R-type ALU")
    l = l.push("                  case ins(14 downto 12) is")
    l = l.push("                    when \"000\" => if ins(30) = '1' then r(rd) := r(rs1) - r(rs2); else r(rd) := r(rs1) + r(rs2); end if;")
    l = l.push("                    when \"001\" => r(rd) := shift_left(r(rs1), to_integer(r(rs2)(4 downto 0)));")
    l = l.push("                    when \"010\" => if signed(r(rs1)) < signed(r(rs2)) then r(rd) := to_unsigned(1, 32); else r(rd) := (others => '0'); end if;")
    l = l.push("                    when \"011\" => if r(rs1) < r(rs2) then r(rd) := to_unsigned(1, 32); else r(rd) := (others => '0'); end if;")
    l = l.push("                    when \"100\" => r(rd) := r(rs1) xor r(rs2);")
    l = l.push("                    when \"101\" => if ins(30) = '1' then r(rd) := unsigned(shift_right(signed(r(rs1)), to_integer(r(rs2)(4 downto 0)))); else r(rd) := shift_right(r(rs1), to_integer(r(rs2)(4 downto 0))); end if;")
    l = l.push("                    when \"110\" => r(rd) := r(rs1) or r(rs2);")
    l = l.push("                    when others => r(rd) := r(rs1) and r(rs2);")
    l = l.push("                  end case;")
    l = l.push("                end if;")
    l = l.push("              end if;")
    l

fn rv32_arm_auipc() -> [text]:
    var l: [text] = []
    l = l.push("              if rd /= 0 then r(rd) := pc_q + shift_left(resize(unsigned(ins(31 downto 12)), 32), 12); end if;")
    l

fn rv32_arm_lui() -> [text]:
    var l: [text] = []
    l = l.push("              if rd /= 0 then r(rd) := shift_left(resize(unsigned(ins(31 downto 12)), 32), 12); end if;")
    l

fn rv32_arm_jal() -> [text]:
    var l: [text] = []
    l = l.push("              if rd /= 0 then r(rd) := pc_q + 4; end if;")
    l = l.push("              pc_next := pc_q + sext(ins(31) & ins(19 downto 12) & ins(20) & ins(30 downto 21) & '0');")
    l

fn rv32_arm_jalr() -> [text]:
    var l: [text] = []
    l = l.push("              pc_next := (r(rs1) + sext(ins(31 downto 20))) and x\"fffffffe\";")
    l = l.push("              if rd /= 0 then r(rd) := pc_q + 4; end if;")
    l

fn rv32_arm_branch() -> [text]:
    var l: [text] = []
    l = l.push("              eff := pc_q + sext(ins(31) & ins(7) & ins(30 downto 25) & ins(11 downto 8) & '0');")
    l = l.push("              case ins(14 downto 12) is")
    l = l.push("                when \"000\" => if r(rs1) = r(rs2) then pc_next := eff; end if;")
    l = l.push("                when \"001\" => if r(rs1) /= r(rs2) then pc_next := eff; end if;")
    l = l.push("                when \"100\" => if signed(r(rs1)) < signed(r(rs2)) then pc_next := eff; end if;")
    l = l.push("                when \"101\" => if signed(r(rs1)) >= signed(r(rs2)) then pc_next := eff; end if;")
    l = l.push("                when \"110\" => if r(rs1) < r(rs2) then pc_next := eff; end if;")
    l = l.push("                when others => if r(rs1) >= r(rs2) then pc_next := eff; end if;")
    l = l.push("              end case;")
    l

fn rv32_arm_load() -> [text]:
    var l: [text] = []
    l = l.push("              eff := r(rs1) + sext(ins(31 downto 20));")
    l = l.push("              if eff = UART_ADDR + x\"00000005\" then")
    l = l.push("                -- 16550 UART Line Status Register read. Report THRE|TEMT (0x60)")
    l = l.push("                -- so the firmware's \"wait until TX holding register empty\" poll")
    l = l.push("                -- (lbu 5(uart_base); andi 0x20; beqz loop) makes forward progress.")
    l = l.push("                -- Without modelling the LSR the soft-core returned 0 here and any")
    l = l.push("                -- LSR-polling firmware (the minimal NVMe self-test) spun forever")
    l = l.push("                -- before emitting its first UART byte. QEMU's 16550 models this;")
    l = l.push("                -- the core must too to run the same firmware. Board-faithful: a")
    l = l.push("                -- real idle 16550 reads 0x60 in the LSR.")
    l = l.push("                if rd /= 0 then r(rd) := x\"00000060\"; end if;")
    l = l.push("              elsif rd /= 0 then")
    l = l.push("                case ins(14 downto 12) is")
    l = l.push("                  when \"000\" =>")
    l = l.push("                    mem_idx := word_index(eff);")
    l = l.push("                      -- Deferred sync-BRAM byte load, sign-extended (was lb via load_byte)")
    l = l.push("                      if eff(31 downto 28) = x\"4\" then")
    l = l.push("                        dr_ra := data_rom_index(eff);")
    l = l.push("                        ld_src_data_q <= '1';")
    l = l.push("                        ld_rd_q <= rd;")
    l = l.push("                        ld_kind_q <= LD_LB;")
    l = l.push("                        ld_lane_q <= to_integer(eff(1 downto 0));")
    l = l.push("                        state_q <= S_LOAD;")
    l = l.push("                      elsif eff(31 downto 28) = x\"8\" then")
    l = l.push("                        rom_ra_a := word_index(eff);")
    l = l.push("                        ld_src_data_q <= '0';")
    l = l.push("                        ld_rd_q <= rd;")
    l = l.push("                        ld_kind_q <= LD_LB;")
    l = l.push("                        ld_lane_q <= to_integer(eff(1 downto 0));")
    l = l.push("                        state_q <= S_LOAD;")
    l = l.push("                      else")
    l = l.push("                        r(rd) := (others => '0');")
    l = l.push("                      end if;")
    l = l.push("                  when \"100\" =>")
    l = l.push("                    mem_idx := word_index(eff);")
    l = l.push("                      -- Deferred sync-BRAM byte load, zero-extended (was lbu via load_byte)")
    l = l.push("                      if eff(31 downto 28) = x\"4\" then")
    l = l.push("                        dr_ra := data_rom_index(eff);")
    l = l.push("                        ld_src_data_q <= '1';")
    l = l.push("                        ld_rd_q <= rd;")
    l = l.push("                        ld_kind_q <= LD_LBU;")
    l = l.push("                        ld_lane_q <= to_integer(eff(1 downto 0));")
    l = l.push("                        state_q <= S_LOAD;")
    l = l.push("                      elsif eff(31 downto 28) = x\"8\" then")
    l = l.push("                        rom_ra_a := word_index(eff);")
    l = l.push("                        ld_src_data_q <= '0';")
    l = l.push("                        ld_rd_q <= rd;")
    l = l.push("                        ld_kind_q <= LD_LBU;")
    l = l.push("                        ld_lane_q <= to_integer(eff(1 downto 0));")
    l = l.push("                        state_q <= S_LOAD;")
    l = l.push("                      else")
    l = l.push("                        r(rd) := (others => '0');")
    l = l.push("                      end if;")
    l = l.push("                  when others =>")
    l = l.push("                    mem_idx := word_index(eff);")
    l = l.push("                      -- Deferred sync-BRAM word load (was: r(rd) := load_word(eff))")
    l = l.push("                      if eff(31 downto 28) = x\"4\" then")
    l = l.push("                        dr_ra := data_rom_index(eff);")
    l = l.push("                        ld_src_data_q <= '1';")
    l = l.push("                        ld_rd_q <= rd;")
    l = l.push("                        ld_kind_q <= LD_WORD;")
    l = l.push("                        state_q <= S_LOAD;")
    l = l.push("                      elsif eff(31 downto 28) = x\"8\" then")
    l = l.push("                        rom_ra_a := word_index(eff);")
    l = l.push("                        ld_src_data_q <= '0';")
    l = l.push("                        ld_rd_q <= rd;")
    l = l.push("                        ld_kind_q <= LD_WORD;")
    l = l.push("                        state_q <= S_LOAD;")
    l = l.push("                      else")
    l = l.push("                        r(rd) := (others => '0');")
    l = l.push("                      end if;")
    l = l.push("                end case;")
    l = l.push("              end if;")
    l

fn rv32_arm_store() -> [text]:
    var l: [text] = []
    l = l.push("              eff := r(rs1) + sext(ins(31 downto 25) & ins(11 downto 7));")
    l = l.push("              if eff = UART_ADDR and ins(14 downto 12) = \"000\" then")
    l = l.push("                uart_shift_q <= '1' & std_logic_vector(r(rs2)(7 downto 0)) & '0';")
    l = l.push("                uart_tx_q <= '0';")
    l = l.push("                uart_busy_q <= '1';")
    l = l.push("                uart_baud_q <= 0;")
    l = l.push("                uart_bits_q <= 10;")
    l = l.push("                debug_uart_valid_next_q <= '1';")
    l = l.push("                debug_uart_byte_q <= std_logic_vector(r(rs2)(7 downto 0));")
    l = l.push("                next_pc_q <= pc_next;")
    l = l.push("                state_q <= S_UART;")
    l = l.push("              elsif eff(31 downto 28) = x\"8\" then")
    l = l.push("                mem_idx := word_index(eff);")
    l = l.push("                if mem_idx < ROM_WORDS then")
    l = l.push("                  -- Store to code ROM (now writable for stack spills)")
    l = l.push("                  if ins(14 downto 12) = \"000\" then")
    l = l.push("                    -- sb (byte store) to ROM: deferred read-modify-write.")
    l = l.push("                    -- Register the word read this edge; merge + write in S_STORE.")
    l = l.push("                    rom_ra_a := mem_idx;")
    l = l.push("                    st_idx_q <= mem_idx;")
    l = l.push("                    st_lane_q <= to_integer(eff(1 downto 0));")
    l = l.push("                    st_byte_q <= std_logic_vector(r(rs2)(7 downto 0));")
    l = l.push("                    state_q <= S_STORE;")
    l = l.push("                  else")
    l = l.push("                    -- sw (word store) to ROM")
    l = l.push("                    rom_we := true;")
    l = l.push("                    rom_wa := mem_idx;")
    l = l.push("                    rom_wd := std_logic_vector(r(rs2));")
    l = l.push("                  end if;")
    l = l.push("                end if;")
    l = l.push("              end if;")
    l

fn rv32_sys_glue_a() -> [text]:
    var l: [text] = []
    l = l.push("              case ins(14 downto 12) is")
    l = l.push("                when \"000\" =>")
    l = l.push("                  -- ecall (funct7=0000000) / ebreak (funct7=0000001)")
    l = l.push("                  if ins(31 downto 20) = \"000000000000\" then")
    l = l.push("                    -- ecall: halt cleanly")
    l = l.push("                    state_q <= S_FETCH;")
    l = l.push("                    pc_q <= pc_q;")
    l = l.push("                    null;")
    l = l.push("                  elsif ins(31 downto 20) = \"000000000001\" then")
    l = l.push("                    -- ebreak: halt cleanly")
    l = l.push("                    state_q <= S_FETCH;")
    l = l.push("                    pc_q <= pc_q;")
    l = l.push("                    null;")
    l = l.push("                  end if;")
    l = l.push("                when \"001\" =>")
    l = l.push("                  -- csrrw")
    l = l.push("                  crs1 := to_integer(unsigned(ins(19 downto 15)));")
    l = l.push("                  if rd /= 0 then")
    l

fn rv32_sys_glue_b() -> [text]:
    var l: [text] = []
    l = l.push("                  end if;")
    l = l.push("                  -- Write CSR (ignored for minimal implementation)")
    l = l.push("                when \"010\" =>")
    l = l.push("                  -- csrrs (read-write with set bits)")
    l = l.push("                  crs1 := to_integer(unsigned(ins(19 downto 15)));")
    l = l.push("                  if rd /= 0 then")
    l

fn rv32_sys_glue_c() -> [text]:
    var l: [text] = []
    l = l.push("                  end if;")
    l = l.push("                  -- Set bits (ignored for minimal implementation)")
    l = l.push("                when \"011\" =>")
    l = l.push("                  -- csrrc (read-write with clear bits)")
    l = l.push("                  crs1 := to_integer(unsigned(ins(19 downto 15)));")
    l = l.push("                  if rd /= 0 then")
    l

fn rv32_sys_glue_d() -> [text]:
    var l: [text] = []
    l = l.push("                  end if;")
    l = l.push("                  -- Clear bits (ignored for minimal implementation)")
    l = l.push("                when \"101\" =>")
    l = l.push("                  -- csrrwi (immediate version)")
    l = l.push("                  if rd /= 0 then")
    l

fn rv32_sys_glue_e() -> [text]:
    var l: [text] = []
    l = l.push("                  end if;")
    l = l.push("                  -- Write CSR (ignored for minimal implementation)")
    l = l.push("                when \"110\" =>")
    l = l.push("                  -- csrrsi (immediate set bits)")
    l = l.push("                  if rd /= 0 then")
    l

fn rv32_sys_glue_f() -> [text]:
    var l: [text] = []
    l = l.push("                  end if;")
    l = l.push("                  -- Set bits (ignored for minimal implementation)")
    l = l.push("                when \"111\" =>")
    l = l.push("                  -- csrrci (immediate clear bits)")
    l = l.push("                  if rd /= 0 then")
    l

fn rv32_sys_glue_g() -> [text]:
    var l: [text] = []
    l = l.push("                  end if;")
    l = l.push("                  -- Clear bits (ignored for minimal implementation)")
    l = l.push("                when others => null;")
    l = l.push("              end case;")
    l

fn rv32_arm_amo() -> [text]:
    var l: [text] = []
