#![allow(primitive_api)]

# JTAG-terminal console spec — SERIAL BASE COMPLETENESS.
#
# The point of these tests is not that decoding "works" in the happy case; it is
# that every way the JTAG console can lose bytes is REPORTED instead of silently
# producing a shorter transcript that reads like a complete one. Each loss mode
# below corresponds to a real property of the RTL capture path
# (rv32_bram_soc.vhd): a finite buffer whose writes stop while the byte counter
# keeps going, a final partial word carrying padding, and a 24-bit counter field.

use std.io_runtime
use std.nogc_sync_mut.spec.{describe, it, expect, expect_not, assert_true}
use hardware.fpga_k26.jtag_console.{
    ConsoleConfig, console_default_config, console_uart_config,
    console_mode_from_text, console_mode_name, console_with_mode,
    console_capacity, console_has_jtag, console_obs_cmd, console_words_needed,
    console_status_bytes, console_decode, console_complete, console_render,
    console_verdict_line,
    CONSOLE_UART, CONSOLE_JTAG, CONSOLE_BOTH,
    CONSOLE_OK, CONSOLE_EMPTY, CONSOLE_OVERFLOW, CONSOLE_SHORT_READ,
    CONSOLE_NO_BUFFER, CONSOLE_COUNT_MASK
}

# Model of the RTL capture buffer: byte N lands in word N/4, lane N%4, where
# lane 0 is bits 7..0. Untouched lanes stay 0x00, exactly like the VHDL signal
# initialiser `(others => x"00000000")`.
fn pack(bytes: [i64], buf_words: i64) -> [i64]:
    var words: [i64] = []
    var w = 0
    while w < buf_words:
        words = words.push(0)
        w = w + 1
    var i = 0
    while i < bytes.len() and i < buf_words * 4:
        val wi = i / 4
        val lane = i - wi * 4
        words[wi] = words[wi] | ((bytes[i] & 0xff) << (lane * 8))
        i = i + 1
    words

fn seq(n: i64, first: i64) -> [i64]:
    var out: [i64] = []
    var i = 0
    while i < n:
        out = out.push((first + i) & 0xff)
        i = i + 1
    out

fn small_cfg(words: i64) -> ConsoleConfig:
    console_with_mode(
        ConsoleConfig(mode: CONSOLE_JTAG, buf_words: words, user_chain: 4,
                      baud: 115200, tck_hz: 1000000),
        CONSOLE_JTAG)

fn main():
    # -----------------------------------------------------------------
    # Configuration / mode selection
    # -----------------------------------------------------------------
    describe("ConsoleConfig"):
        it("defaults to the cable-free JTAG terminal with an 8 KB buffer"):
            val cfg = console_default_config()
            expect(cfg.mode).to_equal(CONSOLE_JTAG)
            expect(cfg.buf_words).to_equal(2048)
            expect(console_capacity(cfg)).to_equal(8192)

        it("parses the mode knob and round-trips its spelling"):
            expect(console_mode_from_text("uart")).to_equal(CONSOLE_UART)
            expect(console_mode_from_text("jtag")).to_equal(CONSOLE_JTAG)
            expect(console_mode_from_text("both")).to_equal(CONSOLE_BOTH)
            expect(console_mode_name(CONSOLE_UART)).to_equal("uart")
            expect(console_mode_name(CONSOLE_BOTH)).to_equal("both")

        it("falls back to JTAG for an unrecognised knob"):
            # The cable-free path is the safe default: it needs no extra hardware.
            expect(console_mode_from_text("rs232")).to_equal(CONSOLE_JTAG)

        it("knows which modes can actually produce a transcript"):
            assert_true(console_has_jtag(console_default_config()))
            expect_not(console_has_jtag(console_uart_config()))
            # JTAG selected but the bitstream was built without a capture buffer.
            expect_not(console_has_jtag(small_cfg(0)))

    # -----------------------------------------------------------------
    # Observation-DR command encoding
    # -----------------------------------------------------------------
    describe("obs command encoding"):
        it("puts the word index in the high half and cmd 3 in the low half"):
            expect(console_obs_cmd(0)).to_equal("00000003")
            expect(console_obs_cmd(1)).to_equal("00010003")
            expect(console_obs_cmd(0x1234)).to_equal("12340003")
            expect(console_obs_cmd(2047)).to_equal("07ff0003")

        it("masks the byte counter out of a status word"):
            # bit31 pass, bit30 fail, low 24 bits = count.
            expect(console_status_bytes(0xC000_02BC)).to_equal(700)

        it("asks for exactly enough words, including a partial tail"):
            val cfg = console_default_config()
            expect(console_words_needed(0, cfg)).to_equal(0)
            expect(console_words_needed(1, cfg)).to_equal(1)
            expect(console_words_needed(4, cfg)).to_equal(1)
            expect(console_words_needed(5, cfg)).to_equal(2)
            expect(console_words_needed(700, cfg)).to_equal(175)
            # Past capacity there are no more words to fetch.
            expect(console_words_needed(99999, cfg)).to_equal(2048)

    # -----------------------------------------------------------------
    # Completeness: the happy path must be byte-exact
    # -----------------------------------------------------------------
    describe("serial base completeness — lossless round trip"):
        it("recovers every byte of a full-word transcript"):
            val cfg = small_cfg(16)
            val src = seq(64, 1)
            val t = console_decode(pack(src, 16), 64, cfg)
            expect(t.status).to_equal(CONSOLE_OK)
            assert_true(console_complete(t))
            expect(t.captured).to_equal(64)
            expect(t.lost).to_equal(0)
            expect(t.bytes.len()).to_equal(64)
            var i = 0
            while i < 64:
                expect(t.bytes[i]).to_equal(src[i])
                i = i + 1

        it("recovers control bytes and high bytes, not just printable ASCII"):
            # 0x00 and 0x0d are exactly what the old readout discarded.
            val cfg = small_cfg(4)
            val src = [0x00, 0x0d, 0x1b, 0x7f, 0x80, 0xff, 0x41, 0x0a]
            val t = console_decode(pack(src, 4), 8, cfg)
            expect(t.status).to_equal(CONSOLE_OK)
            expect(t.bytes.len()).to_equal(8)
            var i = 0
            while i < 8:
                expect(t.bytes[i]).to_equal(src[i])
                i = i + 1

        it("drops the padding lanes of a partial final word"):
            # 5 bytes occupy 2 words; the 3 unwritten lanes must NOT appear.
            val cfg = small_cfg(4)
            val src = [0x48, 0x65, 0x6c, 0x6c, 0x6f]
            val t = console_decode(pack(src, 4), 5, cfg)
            expect(t.status).to_equal(CONSOLE_OK)
            expect(t.bytes.len()).to_equal(5)
            expect(console_render(t.bytes)).to_equal("Hello")

    # -----------------------------------------------------------------
    # Completeness: every loss mode must be reported, never silent
    # -----------------------------------------------------------------
    describe("serial base completeness — loss is reported"):
        it("reports overflow with the exact byte loss instead of truncating quietly"):
            # 16-word buffer = 64 bytes; the core kept counting to 100.
            val cfg = small_cfg(16)
            val t = console_decode(pack(seq(100, 1), 16), 100, cfg)
            expect(t.status).to_equal(CONSOLE_OVERFLOW)
            expect_not(console_complete(t))
            expect(t.captured).to_equal(64)
            expect(t.lost).to_equal(36)
            expect(t.reason).to_contain("36 bytes LOST")
            # The 64 bytes it did capture are still handed back, usable.
            expect(t.bytes.len()).to_equal(64)

        it("reports a short read rather than treating it as the end of output"):
            val cfg = small_cfg(16)
            val full = pack(seq(64, 1), 16)
            var partial: [i64] = []
            var i = 0
            while i < 4:
                partial = partial.push(full[i])
                i = i + 1
            val t = console_decode(partial, 64, cfg)
            expect(t.status).to_equal(CONSOLE_SHORT_READ)
            expect_not(console_complete(t))
            expect(t.captured).to_equal(16)
            expect(t.lost).to_equal(48)
            expect(t.reason).to_contain("need 16")

        it("reports an empty capture as a failure, not an empty transcript"):
            val t = console_decode([], 0, console_default_config())
            expect(t.status).to_equal(CONSOLE_EMPTY)
            expect_not(console_complete(t))

        it("reports a JTAG read against a bitstream that has no capture buffer"):
            val t = console_decode([], 100, console_uart_config())
            expect(t.status).to_equal(CONSOLE_NO_BUFFER)
            expect_not(console_complete(t))
            expect(t.reason).to_contain("no JTAG capture buffer")

        it("does not claim completeness when the 24-bit counter is pinned"):
            val cfg = small_cfg(0x40_0000)
            val t = console_decode(pack(seq(4, 1), 1), CONSOLE_COUNT_MASK, cfg)
            expect_not(console_complete(t))

    # -----------------------------------------------------------------
    # Rendering must not hide bytes either
    # -----------------------------------------------------------------
    describe("console_render"):
        it("passes printable ASCII and terminal whitespace through verbatim"):
            expect(console_render([0x6f, 0x6b, 0x0a])).to_equal("ok\n")
            expect(console_render([0x61, 0x09, 0x62, 0x0d])).to_equal("a\tb\r")

        it("escapes unprintable bytes instead of dropping them"):
            # Old behaviour discarded these; a lossy transcript then looked clean.
            expect(console_render([0x00])).to_equal("\\x00")
            expect(console_render([0x1b, 0x5b, 0x41])).to_equal("\\x1b[A")
            expect(console_render([0xff])).to_equal("\\xff")

        it("keeps length information for a mixed stream"):
            val rendered = console_render([0x41, 0x00, 0x42])
            expect(rendered).to_equal("A\\x00B")

    describe("console_verdict_line"):
        it("labels a complete transcript COMPLETE"):
            val cfg = small_cfg(16)
            val line = console_verdict_line(console_decode(pack(seq(64, 1), 16), 64, cfg))
            expect(line).to_contain("COMPLETE")
            expect(line).to_contain("lost=0")

        it("labels an overflowed transcript INCOMPLETE with the loss"):
            val cfg = small_cfg(16)
            val line = console_verdict_line(console_decode(pack(seq(100, 1), 16), 100, cfg))
            expect(line).to_contain("INCOMPLETE")
            expect(line).to_contain("lost=36")
