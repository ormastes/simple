# x86_64 barrier / cache-op / wait intrinsics (design A.7 F2)
#
# One instruction per call through the MIR InlineAsm node (`asm volatile`
# with an implicit `memory` clobber, so each is also a compiler barrier).
# No runtime call, no allocation. Skipped (no-op) on the host interpreter.
# AT&T syntax (the LLVM path's dialect, design A.3.1).

fn mfence():
    """Full memory fence."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("mfence")

fn lfence():
    """Load fence."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("lfence")

fn sfence():
    """Store fence."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("sfence")

fn fence_full():
    """Arch-neutral full fence name (shared with riscv/aarch64): `mfence`."""
    mfence()

fn clflush(addr: u64):
    """Flush one cache line containing `addr`."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("clflush ({a})", a = in(reg) addr)

fn invlpg(addr: u64):
    """Invalidate the TLB entry for one page."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("invlpg ({a})", a = in(reg) addr)

fn cpu_relax():
    """Spin-loop hint: `pause`."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("pause")

fn hlt():
    """Halt until the next interrupt."""
    unsafe(capabilities: [inline_asm]):
        asm volatile("hlt")

fn cli():
    unsafe(capabilities: [inline_asm]):
        asm volatile("cli")

fn sti():
    unsafe(capabilities: [inline_asm]):
        asm volatile("sti")

fn nop():
    unsafe(capabilities: [inline_asm]):
        asm volatile("nop")

export mfence, lfence, sfence, fence_full, clflush, invlpg
export cpu_relax, hlt, cli, sti, nop
