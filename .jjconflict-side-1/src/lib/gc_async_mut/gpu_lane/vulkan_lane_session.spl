# Vulkan lane session for the GPU Remote Interpreter test lanes (Task C1).
#
# Design: doc/05_design/runtime/gpu_remote_interpreter_architecture.md
# section 5 / 6.1. Scope for this task is the session shell only: device
# selection honoring VULKAN_DEVICE_INDEX, a single arena VkBuffer (STORAGE,
# bound as SSBO set 0 binding 0), a descriptor set over that buffer, a
# pipeline-cache path under the build dir, and a fence-with-timeout helper
# that forces the GMB-1 sentinel 0xDEAD0000 on timeout or non-completion.
# Full mailbox arena wiring (SGP program upload, opcode drain) is a later
# task (B2/C2) and is intentionally NOT built here.

mod std.gc_async_mut.gpu_lane.vulkan_lane_session

use std.gc_async_mut.gpu.engine2d.sffi_vulkan.{
    vulkan_sffi_init, vulkan_sffi_shutdown_reaped,
    vulkan_sffi_is_available, vulkan_sffi_device_count,
    vulkan_sffi_select_device, vulkan_sffi_device_type,
    vulkan_sffi_device_name,
    vulkan_sffi_selected_device_driver_identity,
    vulkan_sffi_selected_device_driver_identity_hash,
    vulkan_sffi_alloc_buffer, vulkan_sffi_free_buffer,
    vulkan_sffi_copy_to_buffer, vulkan_sffi_read_buffer_bytes,
    vulkan_sffi_compile_spirv, vulkan_sffi_destroy_shader,
    vulkan_sffi_create_compute_pipeline, vulkan_sffi_destroy_pipeline,
    vulkan_sffi_create_descriptor_set, vulkan_sffi_bind_buffer,
    vulkan_sffi_destroy_descriptor_set, vulkan_sffi_begin_compute,
    vulkan_sffi_bind_pipeline, vulkan_sffi_bind_descriptors,
    vulkan_sffi_dispatch, vulkan_sffi_end_compute,
    vulkan_sffi_discard_command,
    vulkan_sffi_fence_submission_supported,
    vulkan_sffi_submit_no_wait, vulkan_sffi_wait_fence,
    vulkan_sffi_destroy_fence, vulkan_sffi_reap_dependency_quarantine,
    vulkan_sffi_quarantine_dependencies,
    vulkan_sffi_quarantine_unsubmitted_command}
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}

# GMB-1 sentinels (doc/05_design/runtime/gpu_remote_interpreter_architecture.md
# section 3.1 / 7). Only the timeout/device-lost sentinel is relevant at the
# C1 session-shell layer; normal-exit sentinel decode is a later task.
val VULKAN_LANE_TIMEOUT_SENTINEL: i64 = 0xDEAD0000
val VULKAN_LANE_OK_SENTINEL: i64 = 0xCAFE0000

# STORAGE_BUFFER usage flag understood by rt_vulkan_alloc_buffer (see
# src/compiler_rust/runtime/src/vulkan_graphics_runtime_buffer.rs).
val _VULKAN_LANE_STORAGE_BUFFER: i64 = 0x80

fn _vulkan_lane_default_timeout_ms() -> i64:
    val raw = env_get("GPU_LANE_TIMEOUT_MS")
    if raw == "" or raw == nil:
        30000
    else:
        val parsed = raw.trim().to_i64()
        if parsed > 0:
            parsed
        else:
            30000

fn _vulkan_lane_default_device_index() -> i64:
    val raw = env_get("VULKAN_DEVICE_INDEX")
    if raw == "" or raw == nil:
        0
    else:
        val parsed = raw.trim().to_i64()
        if parsed >= 0:
            parsed
        else:
            0

# `VulkanLaneSession` — one arena buffer, one persistent compute pipeline
# (the SVM-G interpreter shader in later tasks; a caller-supplied SPIR-V
# module here), a descriptor set bound to the arena, and a fence-timeout
# helper. Mirrors the resource-safety discipline of
# `std.gc_async_mut.crypto_accel.vulkan_session.CryptoVulkanSession`: never
# release a resource whose completion status is unknown.
class VulkanLaneSession:
    device_ordinal: i64
    timeout_ms: i64
    pipeline_cache_path: text
    initialized: bool
    completion_unknown: bool
    release_pending: bool
    device_identity: i64
    device_name: text
    driver_identity: text
    arena_buffer: i64
    arena_capacity: i64
    lane_shader: i64
    lane_pipeline: i64
    pending_fence: i64
    last_dispatch_sentinel: i64
    last_error: text

    static fn create() -> VulkanLaneSession:
        VulkanLaneSession.create_for_device(
            _vulkan_lane_default_device_index())

    static fn create_for_device(device_ordinal: i64) -> VulkanLaneSession:
        VulkanLaneSession(
            device_ordinal: device_ordinal,
            timeout_ms: _vulkan_lane_default_timeout_ms(),
            pipeline_cache_path:
                "build/gpu_lane/vulkan_pipeline_cache_" +
                device_ordinal.to_text() + ".bin",
            initialized: false, completion_unknown: false,
            release_pending: false,
            device_identity: 0, device_name: "", driver_identity: "",
            arena_buffer: 0, arena_capacity: 0,
            lane_shader: 0, lane_pipeline: 0,
            pending_fence: 0, last_dispatch_sentinel: 0, last_error: "")

    # Host-aware capability probe. Never raises, never hangs: returns ""
    # when a live Vulkan-capable device is usable, or a "skip:<reason>"
    # string per the GMB-1 SKIP contract (design doc section 7) when the
    # ICD/loader/device is absent. Safe to call before `init`.
    me probe() -> text:
        if not vulkan_sffi_is_available():
            return "skip:vulkan-loader-unavailable"
        if not vulkan_sffi_init():
            return "skip:vulkan-instance-init-failed"
        val device_count = vulkan_sffi_device_count()
        if device_count < 1:
            vulkan_sffi_shutdown_reaped()
            return "skip:vulkan-no-physical-device"
        if self.device_ordinal >= device_count:
            vulkan_sffi_shutdown_reaped()
            return "skip:vulkan-device-ordinal-unavailable"
        if not vulkan_sffi_select_device(self.device_ordinal):
            vulkan_sffi_shutdown_reaped()
            return "skip:vulkan-device-select-failed"
        val device_type = vulkan_sffi_device_type(self.device_ordinal)
        if device_type != "discrete" and device_type != "integrated":
            vulkan_sffi_shutdown_reaped()
            return "skip:vulkan-physical-device-required"
        ""

    # Ensure the pipeline-cache directory exists under the build dir. The
    # underlying `rt_vulkan_create_compute_pipeline` extern does not yet
    # expose VkPipelineCache blob persistence (no create-with-data /
    # get-cache-data adapter) -- see the report for the filed follow-up.
    # This method only reserves and records the path so the on-disk layout
    # is stable once that extern lands.
    me _ensure_pipeline_cache_dir() -> bool:
        val slash = self.pipeline_cache_path.rfind("/")
        if slash < 0:
            return true
        dir_create_all(self.pipeline_cache_path.substring(0, slash))

    me init(arena_bytes: i64, lane_spirv: [u8], entry: text) -> text:
        if self.initialized or self.completion_unknown or self.release_pending:
            return "vulkan-lane-session-state-invalid"
        if arena_bytes <= 0 or lane_spirv.len() < 4 or entry == "":
            return "vulkan-lane-arena-artifact-invalid"
        val probe_result = self.probe()
        if probe_result != "":
            return probe_result
        self.device_identity =
            vulkan_sffi_selected_device_driver_identity_hash()
        self.device_name = vulkan_sffi_device_name(self.device_ordinal)
        self.driver_identity = vulkan_sffi_selected_device_driver_identity()
        if (self.device_identity <= 0 or self.device_name == "" or
                self.driver_identity == ""):
            vulkan_sffi_shutdown_reaped()
            return "vulkan-lane-device-identity-unavailable"
        val _cache_dir_ready = self._ensure_pipeline_cache_dir()
        self.lane_shader = vulkan_sffi_compile_spirv(lane_spirv)
        if self.lane_shader <= 0:
            vulkan_sffi_shutdown_reaped()
            return "vulkan-lane-shader-load-failed"
        self.lane_pipeline = vulkan_sffi_create_compute_pipeline(
            self.lane_shader, entry, 0)
        if self.lane_pipeline <= 0:
            vulkan_sffi_destroy_shader(self.lane_shader)
            self.lane_shader = 0
            vulkan_sffi_shutdown_reaped()
            return "vulkan-lane-pipeline-create-failed"
        self.arena_buffer = vulkan_sffi_alloc_buffer(
            arena_bytes, _VULKAN_LANE_STORAGE_BUFFER)
        if self.arena_buffer <= 0:
            vulkan_sffi_destroy_pipeline(self.lane_pipeline)
            vulkan_sffi_destroy_shader(self.lane_shader)
            self.lane_pipeline = 0
            self.lane_shader = 0
            vulkan_sffi_shutdown_reaped()
            return "vulkan-lane-arena-alloc-failed"
        self.arena_capacity = arena_bytes
        self.initialized = true
        ""

    # Host-side arena write. Returns false without raising on failure so a
    # caller can decide how to fold that into its own contract.
    me arena_write(data: [u8]) -> bool:
        if not self.initialized or self.completion_unknown or self.release_pending:
            return false
        if data.len().to_i64() > self.arena_capacity:
            return false
        vulkan_sffi_copy_to_buffer(self.arena_buffer, data, 0)

    me arena_read(byte_count: i64) -> [u8]:
        if not self.initialized or self.completion_unknown or self.release_pending:
            return []
        if byte_count <= 0 or byte_count > self.arena_capacity:
            return []
        vulkan_sffi_read_buffer_bytes(self.arena_buffer, byte_count, 0)

    # Dispatch the session's persistent pipeline once against the arena
    # (bound as SSBO set 0 binding 0), fence with `self.timeout_ms`, and
    # decode into a GMB-1 sentinel. Never blocks past the timeout: a fence
    # that does not complete in time (or an unsubmittable/lost device) is
    # forced to VULKAN_LANE_TIMEOUT_SENTINEL, matching design doc section
    # 3.3 / 6.1 step 5 ("fence with GPU_LANE_TIMEOUT_MS; on timeout or
    # VK_ERROR_DEVICE_LOST force sentinel 0xDEAD0000"). The underlying
    # `rt_vulkan_wait_fence` extern reports only a completed/not-completed
    # bool, so this cannot yet distinguish a plain timeout from an actual
    # VK_ERROR_DEVICE_LOST -- both fold to the same sentinel, which is the
    # contract-required behavior either way.
    me dispatch_once(grid_x: i64) -> text:
        if not self.initialized or self.completion_unknown or self.release_pending:
            return "vulkan-lane-session-unavailable"
        if grid_x <= 0:
            return "vulkan-lane-dispatch-invalid"
        val quarantine_failed = not vulkan_sffi_reap_dependency_quarantine()
        if quarantine_failed:
            return "vulkan-lane-fenced-submit-unavailable"
        if not vulkan_sffi_fence_submission_supported():
            return "vulkan-lane-fenced-submit-unavailable"
        val descriptor = vulkan_sffi_create_descriptor_set(self.lane_pipeline)
        if descriptor <= 0:
            return "vulkan-lane-descriptor-create-failed"
        var ready = vulkan_sffi_bind_buffer(descriptor, 0, self.arena_buffer)
        var command: i64 = 0
        if ready:
            command = vulkan_sffi_begin_compute()
            ready = command > 0
        if ready:
            ready = vulkan_sffi_bind_pipeline(command, self.lane_pipeline)
        if ready:
            ready = vulkan_sffi_bind_descriptors(command, descriptor)
        if ready:
            ready = vulkan_sffi_dispatch(command, grid_x, 1, 1)
        if ready:
            ready = vulkan_sffi_end_compute(command)
        if not ready:
            if command > 0:
                val discarded = vulkan_sffi_discard_command(command)
                if not discarded:
                    vulkan_sffi_quarantine_unsubmitted_command(
                        command, descriptor, 0)
                    self.completion_unknown = true
                    self.release_pending = true
                    self.last_dispatch_sentinel = VULKAN_LANE_TIMEOUT_SENTINEL
                    return "vulkan-lane-command-release-unknown"
            vulkan_sffi_destroy_descriptor_set(descriptor)
            return "vulkan-lane-command-record-failed"
        # Non-blocking submit: returns a still-PENDING fence, so the
        # `vulkan_sffi_wait_fence(fence, timeout_ns)` below is the ONLY place a
        # wait happens and `self.timeout_ms` is genuinely enforceable. Using
        # `vulkan_sffi_submit_and_wait_fence` here waited with an infinite
        # timeout internally, which made the timeout branch below structurally
        # unreachable. See doc/08_tracking/bug/
        # vulkan_submit_and_wait_fence_blocks_unconditionally_no_nonblocking_submit_2026-08-07.md
        val fence = vulkan_sffi_submit_no_wait(command)
        if fence < 0:
            # Submit outcome unknown (possible device loss mid-submit):
            # quarantine and force the timeout sentinel, never a silent pass.
            vulkan_sffi_quarantine_dependencies(descriptor, 0, 0, 0)
            self.completion_unknown = true
            self.release_pending = true
            self.last_dispatch_sentinel = VULKAN_LANE_TIMEOUT_SENTINEL
            return "vulkan-lane-submit-completion-unknown"
        if fence == 0:
            vulkan_sffi_destroy_descriptor_set(descriptor)
            self.last_dispatch_sentinel = VULKAN_LANE_TIMEOUT_SENTINEL
            return "vulkan-lane-submit-failed"
        val timeout_ns = self.timeout_ms * 1000000
        val completed = vulkan_sffi_wait_fence(fence, timeout_ns)
        if not completed:
            # Fence timeout or VK_ERROR_DEVICE_LOST: force the GMB-1
            # sentinel and retain the resources (completion is unknown, so
            # freeing them now would be unsafe).
            self.pending_fence = fence
            vulkan_sffi_quarantine_dependencies(descriptor, 0, 0, 0)
            self.completion_unknown = true
            self.release_pending = true
            self.last_dispatch_sentinel = VULKAN_LANE_TIMEOUT_SENTINEL
            return "vulkan-lane-fence-timeout"
        val fence_destroyed = vulkan_sffi_destroy_fence(fence)
        val descriptor_destroyed = vulkan_sffi_destroy_descriptor_set(descriptor)
        if not fence_destroyed or not descriptor_destroyed:
            self.pending_fence = fence
            self.release_pending = true
            self.last_dispatch_sentinel = VULKAN_LANE_TIMEOUT_SENTINEL
            return "vulkan-lane-completion-cleanup-pending"
        self.last_dispatch_sentinel = VULKAN_LANE_OK_SENTINEL
        ""

    me retry_terminal_completion() -> text:
        if not self.completion_unknown and not self.release_pending:
            return "vulkan-lane-quarantine-not-pending"
        if not vulkan_sffi_reap_dependency_quarantine():
            return "vulkan-lane-quarantine-device-idle-unproven"
        if (self.pending_fence > 0 and
                not vulkan_sffi_destroy_fence(self.pending_fence)):
            return "vulkan-lane-quarantine-fence-release-pending"
        self.pending_fence = 0
        self.completion_unknown = false
        self.release_pending = false
        "vulkan-lane-quarantine-retry-complete"

    me shutdown() -> text:
        if self.completion_unknown or self.release_pending:
            return "vulkan-lane-session-cleanup-pending"
        if self.arena_buffer > 0:
            if vulkan_sffi_free_buffer(self.arena_buffer):
                self.arena_buffer = 0
        if self.arena_buffer > 0:
            return "vulkan-lane-session-buffer-release-pending"
        self.arena_capacity = 0
        if self.lane_pipeline > 0:
            if vulkan_sffi_destroy_pipeline(self.lane_pipeline):
                self.lane_pipeline = 0
        if self.lane_pipeline > 0:
            return "vulkan-lane-session-pipeline-release-pending"
        if self.lane_shader > 0:
            if vulkan_sffi_destroy_shader(self.lane_shader):
                self.lane_shader = 0
        if self.lane_shader > 0:
            return "vulkan-lane-session-shader-release-pending"
        if not vulkan_sffi_shutdown_reaped():
            return "vulkan-lane-session-global-shutdown-pending"
        self.initialized = false
        self.device_identity = 0
        self.device_name = ""
        self.driver_identity = ""
        self.pending_fence = 0
        self.release_pending = false
        ""

export VulkanLaneSession, VULKAN_LANE_TIMEOUT_SENTINEL, VULKAN_LANE_OK_SENTINEL
