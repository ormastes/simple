# @gc — module uses GC runtime
#
# OpenAI-compatible wire protocol for slang — phase A6 surface.
#
# Design: doc/05_design/ml/slang/slang_master_plan.md (A6 "HTTP API").
#
# This module is transport-free on purpose: it only turns text bodies into
# parsed requests and parsed results back into JSON text. The socket server
# lives in src/app/slang_server/, so every behaviour here is testable without
# binding a port.

use std.common.json.parser.{json_parse_with_error}

# One HTTP answer: numeric status plus a JSON body. Carrying the status as a
# plain i32 keeps this module free of any HTTP server dependency.
struct ApiResponse:
    status: i32
    body: text

# A parsed /v1/chat/completions request. Only the fields slang can act on are
# kept; unknown fields are accepted and ignored, as OpenAI clients expect.
struct ChatRequest:
    model: text
    message_count: i64
    max_tokens: i64
    stream: bool

fn _escape_json_text(s: text) -> text:
    var out = ""
    for ch in s.chars():
        if ch == "\\":
            out = out + "\\\\"
        elif ch == "\"":
            out = out + "\\\""
        elif ch == "\n":
            out = out + "\\n"
        elif ch == "\r":
            out = out + "\\r"
        elif ch == "\t":
            out = out + "\\t"
        else:
            out = out + ch
    out

# Locate a top-level-ish key and return the offset just past its colon, or -1.
# Whitespace between the key, the colon and the value is tolerated.
fn _value_start(source: text, key: text) -> i64:
    val marker = "\"" + key + "\""
    val at = source.find(marker)
    if at < 0:
        return -1
    var i = at + marker.len()
    while i < source.len():
        val ch = source.char_at(i)
        if ch == " " or ch == "\n" or ch == "\r" or ch == "\t":
            i = i + 1
        elif ch == ":":
            return i + 1
        else:
            return -1
    -1

fn _skip_ws(source: text, from: i64) -> i64:
    var i = from
    while i < source.len():
        val ch = source.char_at(i)
        if ch == " " or ch == "\n" or ch == "\r" or ch == "\t":
            i = i + 1
        else:
            return i
    i

# Read a JSON string value for `key`. Returns "" when absent or not a string.
fn json_string_field(source: text, key: text) -> text:
    val after = _value_start(source, key)
    if after < 0:
        return ""
    var i = _skip_ws(source, after)
    if i >= source.len():
        return ""
    if source.char_at(i) != "\"":
        return ""
    i = i + 1
    var out = ""
    var escaped = false
    while i < source.len():
        val ch = source.char_at(i)
        if escaped:
            out = out + ch
            escaped = false
        elif ch == "\\":
            escaped = true
        elif ch == "\"":
            return out
        else:
            out = out + ch
        i = i + 1
    ""

# Read a non-negative JSON integer for `key`, or `missing` when absent/invalid.
fn json_int_field(source: text, key: text, missing: i64) -> i64:
    val after = _value_start(source, key)
    if after < 0:
        return missing
    var i = _skip_ws(source, after)
    var out: i64 = 0
    var seen = false
    while i < source.len():
        val ch = source.char_at(i)
        if ch >= "0" and ch <= "9":
            out = (out * 10) + (ch.ord() - "0".ord())
            seen = true
            i = i + 1
        else:
            if seen:
                return out
            return missing
    if seen:
        return out
    missing

# True when `key` holds the literal `true`.
fn json_bool_field_is_true(source: text, key: text) -> bool:
    val after = _value_start(source, key)
    if after < 0:
        return false
    val i = _skip_ws(source, after)
    source.slice(i, source.len()).starts_with("true")

# Count the objects directly inside the array value of `key`. Returns -1 when
# `key` is absent or its value is not an array.
fn json_array_object_count(source: text, key: text) -> i64:
    val after = _value_start(source, key)
    if after < 0:
        return -1
    var i = _skip_ws(source, after)
    if i >= source.len():
        return -1
    if source.char_at(i) != "[":
        return -1
    i = i + 1
    var count: i64 = 0
    var depth: i64 = 0
    var in_string = false
    var escaped = false
    while i < source.len():
        val ch = source.char_at(i)
        if in_string:
            if escaped:
                escaped = false
            elif ch == "\\":
                escaped = true
            elif ch == "\"":
                in_string = false
        elif ch == "\"":
            in_string = true
        elif ch == "{":
            if depth == 0:
                count = count + 1
            depth = depth + 1
        elif ch == "}":
            if depth > 0:
                depth = depth - 1
        elif ch == "]" and depth == 0:
            return count
        i = i + 1
    -1

# Parse a chat-completions body. Err carries the client-facing reason.
fn parse_chat_request(body: text) -> Result<ChatRequest, text>:
    if body.trim() == "":
        return Err("request body is empty")
    val parsed = json_parse_with_error(body)
    if parsed.1 != "":
        return Err("request body is not valid JSON: " + parsed.1)
    if not body.trim().starts_with("{"):
        return Err("request body must be a JSON object")
    val model = json_string_field(body, "model")
    if model == "":
        return Err("missing or empty required field: model")
    val count = json_array_object_count(body, "messages")
    if count < 0:
        return Err("missing required field: messages (must be an array)")
    if count == 0:
        return Err("field messages must contain at least one message")
    if json_bool_field_is_true(body, "stream"):
        return Err("streaming is not supported by this slang build; send stream=false")
    Ok(ChatRequest(
        model: model,
        message_count: count,
        max_tokens: json_int_field(body, "max_tokens", 0),
        stream: false
    ))

# Read a JSON string value for the LAST occurrence of `key`, rather than the
# first. Chat requests carry one "content" per message, so the last one is the
# newest turn — which is the prompt the engine must answer. Reading the first
# would answer the system prompt instead, silently and plausibly.
fn json_string_field_last(source: text, key: text) -> text:
    val marker = "\"" + key + "\""
    var at = source.rfind(marker)
    if at < 0:
        return ""
    json_string_field(source.slice(at, source.len()), key)

# OpenAI chat-completion envelope. Only emitted for text that a model actually
# produced: nothing in this file fabricates a completion, and the stub path in
# serving_chat.spl still returns an error rather than calling this.
fn openai_chat_completion_response(model: text, content: text, prompt_tokens: i64, completion_tokens: i64) -> ApiResponse:
    val body = "{\"id\":\"chatcmpl-slang\",\"object\":\"chat.completion\",\"created\":0,\"model\":\"" + _escape_json_text(model) + "\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"" + _escape_json_text(content) + "\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":" + prompt_tokens.to_text() + ",\"completion_tokens\":" + completion_tokens.to_text() + ",\"total_tokens\":" + (prompt_tokens + completion_tokens).to_text() + "}}"
    ApiResponse(status: 200, body: body)

# OpenAI error envelope: {"error":{"message","type","param","code"}}.
# `detail_json` is appended verbatim inside the error object when non-empty so
# callers can attach machine-readable diagnostics next to the human message.
fn openai_error_response(status: i32, message: text, err_type: text, code: text, detail_json: text) -> ApiResponse:
    var inner = "\"message\":\"" + _escape_json_text(message) + "\",\"type\":\"" + _escape_json_text(err_type) + "\",\"param\":null,\"code\":\"" + _escape_json_text(code) + "\""
    if detail_json != "":
        inner = inner + "," + detail_json
    ApiResponse(status: status, body: "{\"error\":{" + inner + "}}")

# OpenAI model-list envelope: {"object":"list","data":[{...}]}.
fn openai_models_response(ids: [text], owner: text) -> ApiResponse:
    var data = ""
    var i = 0
    while i < ids.len():
        if i > 0:
            data = data + ","
        data = data + "{\"id\":\"" + _escape_json_text(ids[i]) + "\",\"object\":\"model\",\"created\":0,\"owned_by\":\"" + _escape_json_text(owner) + "\"}"
        i = i + 1
    ApiResponse(status: 200, body: "{\"object\":\"list\",\"data\":[" + data + "]}")

export ApiResponse, ChatRequest
export json_string_field, json_int_field, json_bool_field_is_true, json_array_object_count
export parse_chat_request, openai_error_response, openai_models_response
export json_string_field_last, openai_chat_completion_response
