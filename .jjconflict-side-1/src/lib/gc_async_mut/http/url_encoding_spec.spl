"""Regression spec for percent-encoding in the async http/url.spl tiers.

gc_async_mut and nogc_async_mut carried the pre-fix url.spl, whose
percent_encode_char called `ch.char_code()` -- a method text does not have --
so url_encode raised `Function 'str.char_code' not found` for every non
-unreserved character. Oracle: RFC 3986 §2.1/§2.3/§2.5.
"""

mod gc_async_mut.http.url
mod nogc_async_mut.http.url

use std.gc_async_mut.http.url.{url_encode, url_decode}
use std.nogc_async_mut.http.url.{url_encode as na_url_encode, url_decode as na_url_decode}

describe "gc_async_mut url_encode (RFC 3986)":
    """Unreserved characters pass through; everything else is percent-encoded."""

    it "leaves RFC 3986 2.3 unreserved characters alone":
        expect(url_encode("A-Z")).to_equal("A-Z")
        expect(url_encode("az09-_.~")).to_equal("az09-_.~")

    it "percent-encodes a space as %20":
        expect(url_encode("a b")).to_equal("a%20b")

    it "percent-encodes RFC 3986 2.2 reserved delimiters":
        expect(url_encode("/")).to_equal("%2F")
        expect(url_encode("?")).to_equal("%3F")
        expect(url_encode("&")).to_equal("%26")

    it "encodes non-ASCII as UTF-8 octets (RFC 3986 2.5)":
        # U+20AC EURO SIGN is UTF-8 E2 82 AC
        expect(url_encode("\u{20AC}")).to_equal("%E2%82%AC")

describe "gc_async_mut url_decode (RFC 3986)":
    """Percent-decoding reassembles UTF-8 octets."""

    it "decodes %20 to a space":
        expect(url_decode("a%20b")).to_equal("a b")

    it "decodes a multi-octet UTF-8 sequence":
        expect(url_decode("%E2%82%AC")).to_equal("\u{20AC}")

    it "round-trips through encode then decode":
        val s = "a b/\u{20AC}?x=1"
        expect(url_decode(url_encode(s))).to_equal(s)

describe "nogc_async_mut url_encode (RFC 3986)":
    """The nogc_async_mut copy carried the identical defect."""

    it "percent-encodes a space as %20":
        expect(na_url_encode("a b")).to_equal("a%20b")

    it "encodes non-ASCII as UTF-8 octets":
        expect(na_url_encode("\u{20AC}")).to_equal("%E2%82%AC")

    it "round-trips through encode then decode":
        val s = "a b/\u{20AC}?x=1"
        expect(na_url_decode(na_url_encode(s))).to_equal(s)
