# Tile render culling core (T1 + T3 of the tile_render_culling_plan).
#
# Pure functions over a fixed 256px document-space tile grid: op -> tile
# binning (hidden/zero-area ops dropped at bin time), viewport+margin live
# tile set, FNV-1a per-tile checksums (damage-reuse key for the CPU and GPU
# lanes), and conservative occlusion (the latest opaque op that fully covers
# a tile culls every earlier op binned in that tile).
#
# Shared by the CPU tiled paint lane (paint_tiled in
# simple_web_html_layout_renderer_paint_layout.spl) and, later, the GPU lane
# (T4): both lanes consume the same TileOp/TileBins model. No classes with
# behavior, no dicts (native-codegen Dict pitfalls: .claude/rules/code-style.md)
# — arrays indexed by tile index only.
#
# Plan: doc/03_plan/ui/rendering/tile_render_culling_plan.md

use std.gc_async_mut.io.mod_stub.{env_get}

val TILE_PX: i32 = 256
val TILE_MARGIN_PX: i32 = 512

# One paint-ordered culling record. `node` is the producer index (layout node
# or DrawIR command index); `kind` distinguishes phases (0 = box, 1 = text /
# content-on-top, 2 = scrollbar). Rects are device-space, already intersected
# with the op's ancestor clip by the producer. `hidden` ops (display:none,
# visibility:hidden, hidden-by-ancestor, nothing-to-paint) and zero-area ops
# are dropped at bin time. `opaque` marks full-coverage opaque rect
# candidates for T3 occlusion.
class TileOp:
    kind: i32
    node: i32
    x: i32
    y: i32
    w: i32
    h: i32
    hidden: bool
    opaque: bool
    style_hash: i64
    resource: i32

class TileGrid:
    origin_x: i32
    origin_y: i32
    bound_x0: i32
    bound_y0: i32
    bound_x1: i32
    bound_y1: i32
    tiles_x: i32
    tiles_y: i32

# Per-tile op lists as one flat counting-sort layout: ops binned to tile t
# are items[starts[t] .. starts[t+1]], in original (paint) order.
class TileBins:
    starts: [i32]
    items: [i32]

fn tile_op(kind: i32, node: i32, x: i32, y: i32, w: i32, h: i32, hidden: bool, opaque: bool, style_hash: i64, resource: i32) -> TileOp:
    TileOp(kind: kind, node: node, x: x, y: y, w: w, h: h, hidden: hidden, opaque: opaque, style_hash: style_hash, resource: resource)

# Floor division that is correct for negative coordinates (plan acceptance
# lists negative coords as a binning edge case).
fn tile_floor_div(v: i32, d: i32) -> i32:
    var q = v / d
    if v % d != 0 and ((v < 0) != (d < 0)):
        q = q - 1
    q

fn _tile_floor_div_i64(v: i64, d: i64) -> i64:
    var q = v / d
    if v % d != 0 and ((v < 0) != (d < 0)):
        q = q - 1
    q

fn tile_grid_make(x0: i32, y0: i32, x1: i32, y1: i32) -> TileGrid:
    if x1 <= x0 or y1 <= y0:
        return TileGrid(
            origin_x: x0, origin_y: y0,
            bound_x0: x0, bound_y0: y0, bound_x1: x0, bound_y1: y0,
            tiles_x: 0, tiles_y: 0)
    val tx0 = tile_floor_div(x0, TILE_PX)
    val ty0 = tile_floor_div(y0, TILE_PX)
    val tx1 = tile_floor_div(x1 - 1, TILE_PX)
    val ty1 = tile_floor_div(y1 - 1, TILE_PX)
    TileGrid(
        origin_x: tx0 * TILE_PX, origin_y: ty0 * TILE_PX,
        bound_x0: x0, bound_y0: y0, bound_x1: x1, bound_y1: y1,
        tiles_x: tx1 - tx0 + 1, tiles_y: ty1 - ty0 + 1
    )

fn tile_count(grid: TileGrid) -> i32:
    grid.tiles_x * grid.tiles_y

fn tile_rect_x0(grid: TileGrid, t: i32) -> i32:
    val edge = grid.origin_x + (t % grid.tiles_x) * TILE_PX
    if edge > grid.bound_x0: edge else: grid.bound_x0

fn tile_rect_y0(grid: TileGrid, t: i32) -> i32:
    val edge = grid.origin_y + (t / grid.tiles_x) * TILE_PX
    if edge > grid.bound_y0: edge else: grid.bound_y0

fn tile_rect_x1(grid: TileGrid, t: i32) -> i32:
    val edge = grid.origin_x + (t % grid.tiles_x + 1) * TILE_PX
    if edge < grid.bound_x1: edge else: grid.bound_x1

fn tile_rect_y1(grid: TileGrid, t: i32) -> i32:
    val edge = grid.origin_y + (t / grid.tiles_x + 1) * TILE_PX
    if edge < grid.bound_y1: edge else: grid.bound_y1

# Covered tile-index column/row range of a device rect, clamped to the grid.
# Returns (tx0, ty0, tx1, ty1) inclusive; tx1 < tx0 means no coverage.
fn tile_cover_range(grid: TileGrid, x: i32, y: i32, w: i32, h: i32) -> (i32, i32, i32, i32):
    if w <= 0 or h <= 0 or grid.tiles_x <= 0 or grid.tiles_y <= 0:
        return (0, 0, -1, -1)
    val rx0 = x.to_i64()
    val ry0 = y.to_i64()
    val rx1 = rx0 + w.to_i64()
    val ry1 = ry0 + h.to_i64()
    if rx1 <= grid.bound_x0.to_i64() or ry1 <= grid.bound_y0.to_i64() or
            rx0 >= grid.bound_x1.to_i64() or ry0 >= grid.bound_y1.to_i64():
        return (0, 0, -1, -1)
    var tx0 = _tile_floor_div_i64(rx0 - grid.origin_x.to_i64(), TILE_PX.to_i64()).to_i32()
    var ty0 = _tile_floor_div_i64(ry0 - grid.origin_y.to_i64(), TILE_PX.to_i64()).to_i32()
    var tx1 = _tile_floor_div_i64(rx1 - 1 - grid.origin_x.to_i64(), TILE_PX.to_i64()).to_i32()
    var ty1 = _tile_floor_div_i64(ry1 - 1 - grid.origin_y.to_i64(), TILE_PX.to_i64()).to_i32()
    if tx1 < 0 or ty1 < 0 or tx0 >= grid.tiles_x or ty0 >= grid.tiles_y:
        return (0, 0, -1, -1)
    if tx0 < 0:
        tx0 = 0
    if ty0 < 0:
        ty0 = 0
    if tx1 >= grid.tiles_x:
        tx1 = grid.tiles_x - 1
    if ty1 >= grid.tiles_y:
        ty1 = grid.tiles_y - 1
    (tx0, ty0, tx1, ty1)

# Bin ops into per-tile lists. Hidden and zero-area ops are dropped here —
# they never reach a tile. Two-pass counting sort keeps one flat items array
# (no nested array mutation) and preserves op order inside each tile.
fn tile_bin_ops(ops: [TileOp], grid: TileGrid) -> TileBins:
    val tiles = tile_count(grid)
    var counts: [i32] = [0; tiles + 1]
    val op_count = ops.len()
    var i = 0
    while i < op_count:
        val op = ops[i]
        if not op.hidden:
            val (tx0, ty0, tx1, ty1) = tile_cover_range(grid, op.x, op.y, op.w, op.h)
            var ty = ty0
            while ty <= ty1:
                var tx = tx0
                while tx <= tx1:
                    val t = ty * grid.tiles_x + tx
                    counts[t] = counts[t] + 1
                    tx = tx + 1
                ty = ty + 1
        i = i + 1
    var starts: [i32] = [0; tiles + 1]
    var total = 0
    var t = 0
    while t < tiles:
        starts[t] = total
        total = total + counts[t]
        t = t + 1
    starts[tiles] = total
    var fill: [i32] = [0; tiles]
    var items: [i32] = [0; total]
    i = 0
    while i < op_count:
        val op = ops[i]
        if not op.hidden:
            val (tx0, ty0, tx1, ty1) = tile_cover_range(grid, op.x, op.y, op.w, op.h)
            var ty = ty0
            while ty <= ty1:
                var tx = tx0
                while tx <= tx1:
                    val tt = ty * grid.tiles_x + tx
                    items[starts[tt] + fill[tt]] = i
                    fill[tt] = fill[tt] + 1
                    tx = tx + 1
                ty = ty + 1
        i = i + 1
    TileBins(starts: starts, items: items)

# Live tile set: tiles intersecting the viewport rect extended by `margin`
# px on every side (plan: viewport + 512px prefetch band).
fn tile_live_set(grid: TileGrid, vx: i32, vy: i32, vw: i32, vh: i32, margin: i32) -> [bool]:
    val tiles = tile_count(grid)
    var live: [bool] = [false; tiles]
    val (tx0, ty0, tx1, ty1) = tile_cover_range(
        grid, vx - margin, vy - margin, vw + margin * 2, vh + margin * 2
    )
    var ty = ty0
    while ty <= ty1:
        var tx = tx0
        while tx <= tx1:
            live[ty * grid.tiles_x + tx] = true
            tx = tx + 1
        ty = ty + 1
    live

# FNV-1a 64-bit, same constants as std.hash.fnv1a_hash_i64 (i64 arithmetic
# wraps). One step hashes all 8 bytes of a value in little-endian order.
val TILE_FNV_OFFSET_BASIS: i64 = -3750763034362895579
val TILE_FNV_PRIME: i64 = 1099511628211

fn tile_fnv_step(hash: i64, value: i64) -> i64:
    var h = hash
    var v = value
    var i = 0
    while i < 8:
        h = h ^ (v & 0xFF)
        h = h * TILE_FNV_PRIME
        v = v >> 8
        i = i + 1
    h

# Checksum of one tile's binned ops (kind, rect, style hash, resource id, in
# tile-local order). Drives damage reuse: an unchanged checksum means the
# tile's pixels can be reused instead of re-rastered.
fn tile_checksum(ops: [TileOp], bins: TileBins, t: i32) -> i64:
    var h = TILE_FNV_OFFSET_BASIS
    var s = bins.starts[t]
    val e = bins.starts[t + 1]
    while s < e:
        val op = ops[bins.items[s]]
        h = tile_fnv_step(h, op.kind as i64)
        h = tile_fnv_step(h, op.x as i64)
        h = tile_fnv_step(h, op.y as i64)
        h = tile_fnv_step(h, op.w as i64)
        h = tile_fnv_step(h, op.h as i64)
        h = tile_fnv_step(h, op.style_hash)
        h = tile_fnv_step(h, op.resource as i64)
        s = s + 1
    h

fn tile_checksums(ops: [TileOp], bins: TileBins, grid: TileGrid) -> [i64]:
    val tiles = tile_count(grid)
    var out: [i64] = [0; tiles]
    var t = 0
    while t < tiles:
        out[t] = tile_checksum(ops, bins, t)
        t = t + 1
    out

# T3 conservative occlusion: slot (index into bins.items within tile t) of
# the LATEST opaque op whose rect fully contains the tile rect, or -1. Every
# op binned before that slot is invisible in this tile (back-to-front paint:
# a later full-tile opaque fill hides all earlier content in the tile).
fn tile_occluder_slot(ops: [TileOp], bins: TileBins, grid: TileGrid, t: i32) -> i32:
    val tx0 = tile_rect_x0(grid, t)
    val ty0 = tile_rect_y0(grid, t)
    val tx1 = tile_rect_x1(grid, t)
    val ty1 = tile_rect_y1(grid, t)
    var slot = -1
    var s = bins.starts[t]
    val e = bins.starts[t + 1]
    while s < e:
        val op = ops[bins.items[s]]
        if (
            op.opaque and op.x <= tx0 and op.y <= ty0 and
            op.x.to_i64() + op.w.to_i64() >= tx1.to_i64() and
            op.y.to_i64() + op.h.to_i64() >= ty1.to_i64()
        ):
            slot = s
        s = s + 1
    slot

# Per-op survivor mask: an op survives when at least one LIVE tile shows it
# (binned in the tile at or after the tile's occluder slot). Ops binned only
# in non-live tiles, or occluded in every live tile they touch, are culled.
fn tile_survivors(ops: [TileOp], bins: TileBins, grid: TileGrid, live: [bool]) -> [bool]:
    var out: [bool] = [false; ops.len()]
    val tiles = tile_count(grid)
    var t = 0
    while t < tiles:
        if live[t]:
            val occ = tile_occluder_slot(ops, bins, grid, t)
            var s = bins.starts[t]
            val e = bins.starts[t + 1]
            if occ > s:
                s = occ
            while s < e:
                out[bins.items[s]] = true
                s = s + 1
        t = t + 1
    out

# ---------------------------------------------------------------------------
# Feature flag + benchmark counters (T5 hooks). Counters are recorded by the
# tiled lanes and read by the parity/benchmark specs — plain module state,
# no fabrication path: only a real paint_tiled run writes them.
# ---------------------------------------------------------------------------

# CPU tiled paint lane gate. Default OFF: flag-off keeps the classic paint()
# path byte-identical (paint_tiled is never entered).
fn tile_paint_flag_enabled() -> bool:
    val v = env_get("SIMPLE_WEB_TILE_PAINT")
    if v == nil:
        return false
    v == "1"

var _tile_stats_ops_total: i64 = 0
var _tile_stats_ops_painted: i64 = 0
var _tile_stats_tiles_total: i64 = 0
var _tile_stats_tiles_live: i64 = 0
var _tile_stats_tiles_skipped: i64 = 0
var _tile_stats_tiles_occluded: i64 = 0

fn tile_stats_record(ops_total: i64, ops_painted: i64, tiles_total: i64, tiles_live: i64, tiles_skipped: i64, tiles_occluded: i64):
    _tile_stats_ops_total = ops_total
    _tile_stats_ops_painted = ops_painted
    _tile_stats_tiles_total = tiles_total
    _tile_stats_tiles_live = tiles_live
    _tile_stats_tiles_skipped = tiles_skipped
    _tile_stats_tiles_occluded = tiles_occluded

fn tile_stats_reset():
    tile_stats_record(0, 0, 0, 0, 0, 0)

fn tile_stats_ops_total() -> i64:
    _tile_stats_ops_total

fn tile_stats_ops_painted() -> i64:
    _tile_stats_ops_painted

fn tile_stats_tiles_total() -> i64:
    _tile_stats_tiles_total

fn tile_stats_tiles_live() -> i64:
    _tile_stats_tiles_live

fn tile_stats_tiles_skipped() -> i64:
    _tile_stats_tiles_skipped

fn tile_stats_tiles_occluded() -> i64:
    _tile_stats_tiles_occluded
