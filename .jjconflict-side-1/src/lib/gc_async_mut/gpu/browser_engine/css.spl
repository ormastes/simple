use std.gc_async_mut.gpu.browser_engine.dom.{StyleProps}

struct CssPx:
    """A CSS pixel measurement."""
    value: f64

struct BoxShadow:
    offset_x: f64
    offset_y: f64
    blur_radius: f64
    spread_radius: f64
    color: text
    inset: bool

type CssValue = text
type FloatCode = text
type ClearCode = text

struct BoxEdges:
    top: f64
    right: f64
    bottom: f64
    left: f64

struct BorderProps:
    width: f64
    color: text
    style: text

fn parse_css_value(s: text) -> text:
    s.trim()

fn be_default_style() -> StyleProps:
    StyleProps.empty()

fn css_get_overflow(style: StyleProps) -> text:
    style.overflow

fn css_parse_length_or_calc(value: text) -> CssValue:
    value.trim()

fn resolve_style(style: StyleProps) -> StyleProps:
    style

# =========================================================================
# CSS float/clear code helpers — return a struct with a .value field so
# callers can use css_get_float_code(style).value
# =========================================================================

pub class CssIntValue:
    value: i32

pub fn css_get_float_code(style: StyleProps) -> CssIntValue:
    """Return the float_css property as an integer code: 0=none, 1=left, 2=right."""
    val v = style.float_css.trim().lower()
    if v == "left":
        return CssIntValue(value: 1)
    if v == "right":
        return CssIntValue(value: 2)
    CssIntValue(value: 0)

pub fn css_get_clear_code(style: StyleProps) -> CssIntValue:
    """Return the clear_css property as an integer code: 0=none, 1=left, 2=right, 3=both."""
    val v = style.clear_css.trim().lower()
    if v == "left":
        return CssIntValue(value: 1)
    if v == "right":
        return CssIntValue(value: 2)
    if v == "both":
        return CssIntValue(value: 3)
    CssIntValue(value: 0)

export StyleProps
export BoxShadow
export BoxEdges
export BorderProps
export CssValue
export FloatCode
export ClearCode
export CssIntValue
export be_default_style
export parse_css_value
export css_get_overflow
export css_get_float_code
export css_get_clear_code
export css_parse_length_or_calc
export resolve_style
