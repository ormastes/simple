# CPU reference — ordered DOM tree-builder commit into the frozen arena.
#
# Plan: doc/03_plan/platform/structural_compute/html_css_parser_plan.md
#   Scope: "HTML: GPU/SIMD tokenizer + **ordered** tree-builder commit
#   (insertion modes, open-element stack, foster parenting, script interaction
#   stay CPU-ordered)".
# Shared rules: doc/03_plan/platform/structural_compute/README.md
#
# WHAT THIS IS
# The commit side of the tree builder: the open-element stack and the
# append/attribute/close operations that write into `DomArena`. This is the
# oracle (shared rule 3) that the SIMD/GPU tokenizer tiers must reproduce
# exactly; it is never deleted and never replaced by an accelerated variant.
#
# WHAT THIS IS NOT — AND WHY
# There is no tokenizer and no insertion-mode state machine here. HTML is a
# ParseDialect on the parser_framework lane's runtime and that contract is not
# frozen at origin yet; shared rule 1 forbids implementing against it. So this
# file freezes the commit API the dialect will drive and stops there.
# Insertion modes, foster parenting and script interaction are deliberately
# absent, not forgotten — they are driven BY the dialect and land with it.
#
# NO SILENT FALLBACK (shared rule 4)
# Every rejection here carries a reason receipt naming the operation and the
# state that made it illegal. The builder is total: a malformed call sequence
# records a receipt and continues so the caller sees ALL the damage, and
# `dom_builder_finish` reports `ok: false` with the first receipt. Nothing is
# silently repaired, reordered, or dropped.

use std.common.base_encoding.utilities.{text_to_bytes_linear}
use std.common.ui.gpu_web_capacity_manifest.{
    GpuWebCapacityManifest,
    GpuWebCapacityPlan,
    GpuWebCapacityVerdict,
    gpu_web_capacity_plan_zero,
    gpu_web_capacity_verify
}
use std.gc_async_mut.gpu.browser_engine.gpu_web.dom.dom_arena_types.{
    DOM_NODE_KIND_CDATA,
    DOM_NODE_KIND_COMMENT,
    DOM_NODE_KIND_DOCTYPE,
    DOM_NODE_KIND_DOCUMENT,
    DOM_NODE_KIND_ELEMENT,
    DOM_NODE_KIND_PROCESSING_INSTRUCTION,
    DOM_NODE_KIND_TEXT,
    DOM_NO_ID,
    DOM_NO_ID_I64,
    DomArena,
    DomAttributeArena,
    DomSnapshot,
    DomStringTable,
    dom_arena_empty,
    dom_snapshot
}

# --- reason codes ---------------------------------------------------------
# Stable strings: a receipt is read by operators and by parity tests, so these
# are part of the observable contract.
pub val DOM_BUILD_ERR_UNBALANCED_CLOSE: text = "dom_builder_unbalanced_close"
pub val DOM_BUILD_ERR_UNCLOSED_ELEMENTS: text = "dom_builder_unclosed_elements"
pub val DOM_BUILD_ERR_ATTRIBUTE_WITHOUT_ELEMENT: text = "dom_builder_attribute_without_open_element"
pub val DOM_BUILD_ERR_CAPACITY: text = "dom_builder_capacity_rejected"

# =========================================================================
# Builder state.
#
# `intern_index` is a text-keyed dict, which the arena schema forbids — that is
# intentional and safe: the dict lives ONLY in this host-side builder and is
# dropped at `finish`. Nothing text-keyed reaches `DomArena`.
# =========================================================================
struct DomBuilder:
    arena: DomArena
    open_stack: [i64]
    intern_index: Dict<text, i64>
    # Node whose attribute span is still open, or DOM_NO_ID_I64. Attributes are
    # a contiguous (start, count) span, so they may only be appended while the
    # owning element is the most recently appended node.
    attr_target: i64
    input_bytes: i64
    error_count: i64
    first_reason: text
    reasons: [text]

struct DomInternResult:
    builder: DomBuilder
    id: i64

struct DomBuildResult:
    ok: bool
    reason: text
    error_count: i64
    reasons: [text]
    arena: DomArena
    plan: GpuWebCapacityPlan
    verdict: GpuWebCapacityVerdict

pub fn dom_builder_new() -> DomBuilder:
    DomBuilder(
        arena: dom_arena_empty(),
        open_stack: [],
        intern_index: {},
        attr_target: DOM_NO_ID_I64,
        input_bytes: 0,
        error_count: 0,
        first_reason: "",
        reasons: []
    )

fn _dom_fail(b: DomBuilder, reason: text) -> DomBuilder:
    var out = b
    out.error_count = b.error_count + 1
    out.reasons = b.reasons.push(reason)
    if b.first_reason == "":
        out.first_reason = reason
    out

# --- interning ------------------------------------------------------------
# `contains_key` + index read, never `.get()`: `.get()` on a hit is corrupt
# under native codegen (doc/07_guide/language/dict_native_pitfalls.md).
pub fn dom_builder_intern(b: DomBuilder, s: text) -> DomInternResult:
    if b.intern_index.contains_key(s):
        return DomInternResult(builder: b, id: b.intern_index[s])

    val bytes = text_to_bytes_linear(s)
    var table = b.arena.strings
    val start = table.bytes.len()
    var i = 0
    while i < bytes.len():
        table.bytes = table.bytes.push(bytes[i])
        i = i + 1
    table.starts = table.starts.push(start.to_u32())
    table.lens = table.lens.push(bytes.len().to_u32())
    val id = table.count.to_i64()
    table.count = (id + 1).to_u32()

    var out = b
    var arena = b.arena
    arena.strings = table
    out.arena = arena
    # Write-back idiom (ADR-004): mutate a copy, then assign the field back.
    var index_map = b.intern_index
    index_map[s] = id
    out.intern_index = index_map
    out.input_bytes = b.input_bytes + bytes.len()
    DomInternResult(builder: out, id: id)

fn _dom_intern_optional(b: DomBuilder, s: text, present: bool) -> DomInternResult:
    if not present:
        return DomInternResult(builder: b, id: DOM_NO_ID_I64)
    dom_builder_intern(b, s)

fn _dom_id_u32(id: i64) -> u32:
    if id == DOM_NO_ID_I64:
        return DOM_NO_ID
    id.to_u32()

# --- node append ----------------------------------------------------------
# Appends one node in document order and links it under the current top of the
# open-element stack. Returns the builder; the new node's index is
# `arena.node_count - 1` by the document-order guarantee.
fn _dom_append_node(
    b: DomBuilder,
    kind: u16,
    name_id: i64,
    ns_id: i64,
    value_id: i64
) -> DomBuilder:
    var arena = b.arena
    val index = arena.node_count.to_i64()

    var parent = DOM_NO_ID_I64
    if b.open_stack.len() > 0:
        parent = b.open_stack[b.open_stack.len() - 1]

    var prev = DOM_NO_ID_I64
    if parent != DOM_NO_ID_I64:
        prev = arena.last_children[parent].to_i64()

    arena.kinds = arena.kinds.push(kind)
    arena.generations = arena.generations.push(0u32)
    arena.name_ids = arena.name_ids.push(_dom_id_u32(name_id))
    arena.ns_ids = arena.ns_ids.push(_dom_id_u32(ns_id))
    arena.value_ids = arena.value_ids.push(_dom_id_u32(value_id))
    arena.parents = arena.parents.push(_dom_id_u32(parent))
    arena.first_children = arena.first_children.push(DOM_NO_ID)
    arena.last_children = arena.last_children.push(DOM_NO_ID)
    arena.next_siblings = arena.next_siblings.push(DOM_NO_ID)
    arena.prev_siblings = arena.prev_siblings.push(_dom_id_u32(prev))
    arena.child_counts = arena.child_counts.push(0u32)
    arena.attr_starts = arena.attr_starts.push(arena.attributes.count)
    arena.attr_counts = arena.attr_counts.push(0u32)
    arena.node_count = (index + 1).to_u32()

    # Write-back idiom (ADR-004): an indexed store into a list reached through a
    # struct field is silently lost, so each column is copied out, mutated, and
    # assigned back. Lint COLL019 flags the direct form.
    if parent != DOM_NO_ID_I64:
        if prev == DOM_NO_ID_I64:
            var first_children = arena.first_children
            first_children[parent] = index.to_u32()
            arena.first_children = first_children
        else:
            var next_siblings = arena.next_siblings
            next_siblings[prev] = index.to_u32()
            arena.next_siblings = next_siblings
        var last_children = arena.last_children
        last_children[parent] = index.to_u32()
        arena.last_children = last_children
        var child_counts = arena.child_counts
        child_counts[parent] = (child_counts[parent].to_i64() + 1).to_u32()
        arena.child_counts = child_counts

    var out = b
    out.arena = arena
    out

# --- public commit API ----------------------------------------------------

# Document node. Root-level; appended like any other node so the caller keeps
# full control of tree shape (the plan does not mandate an implicit root).
pub fn dom_builder_open_document(b: DomBuilder) -> DomBuilder:
    var out = _dom_append_node(b, DOM_NODE_KIND_DOCUMENT, DOM_NO_ID_I64, DOM_NO_ID_I64, DOM_NO_ID_I64)
    val index = out.arena.node_count.to_i64() - 1
    out.open_stack = out.open_stack.push(index)
    out.attr_target = DOM_NO_ID_I64
    out

pub fn dom_builder_open_element(b: DomBuilder, name: text, ns: text) -> DomBuilder:
    val name_res = dom_builder_intern(b, name)
    val ns_res = _dom_intern_optional(name_res.builder, ns, ns != "")
    var out = _dom_append_node(
        ns_res.builder, DOM_NODE_KIND_ELEMENT, name_res.id, ns_res.id, DOM_NO_ID_I64
    )
    val index = out.arena.node_count.to_i64() - 1
    out.open_stack = out.open_stack.push(index)
    out.attr_target = index
    out

# Attributes belong to the element opened immediately before them. Appending
# one after any other node has been appended would tear the contiguous span, so
# it is rejected with a receipt rather than silently relocated.
pub fn dom_builder_attribute(b: DomBuilder, name: text, value: text, ns: text) -> DomBuilder:
    val target = b.attr_target
    if target == DOM_NO_ID_I64 or target != b.arena.node_count.to_i64() - 1:
        return _dom_fail(
            b,
            DOM_BUILD_ERR_ATTRIBUTE_WITHOUT_ELEMENT
                + ": name=" + name
                + " attr_target=" + target.to_text()
                + " last_node=" + (b.arena.node_count.to_i64() - 1).to_text()
        )

    val name_res = dom_builder_intern(b, name)
    val value_res = dom_builder_intern(name_res.builder, value)
    val ns_res = _dom_intern_optional(value_res.builder, ns, ns != "")

    var out = ns_res.builder
    var arena = out.arena
    var attrs = arena.attributes
    attrs.name_ids = attrs.name_ids.push(_dom_id_u32(name_res.id))
    attrs.value_ids = attrs.value_ids.push(_dom_id_u32(value_res.id))
    attrs.ns_ids = attrs.ns_ids.push(_dom_id_u32(ns_res.id))
    attrs.count = (attrs.count.to_i64() + 1).to_u32()
    arena.attributes = attrs
    var attr_counts = arena.attr_counts
    attr_counts[target] = (attr_counts[target].to_i64() + 1).to_u32()
    arena.attr_counts = attr_counts
    out.arena = arena
    out

fn _dom_append_leaf(b: DomBuilder, kind: u16, data: text) -> DomBuilder:
    val res = dom_builder_intern(b, data)
    var out = _dom_append_node(res.builder, kind, DOM_NO_ID_I64, DOM_NO_ID_I64, res.id)
    out.attr_target = DOM_NO_ID_I64
    out

pub fn dom_builder_text(b: DomBuilder, data: text) -> DomBuilder:
    _dom_append_leaf(b, DOM_NODE_KIND_TEXT, data)

pub fn dom_builder_comment(b: DomBuilder, data: text) -> DomBuilder:
    _dom_append_leaf(b, DOM_NODE_KIND_COMMENT, data)

pub fn dom_builder_cdata(b: DomBuilder, data: text) -> DomBuilder:
    _dom_append_leaf(b, DOM_NODE_KIND_CDATA, data)

pub fn dom_builder_doctype(b: DomBuilder, name: text) -> DomBuilder:
    val res = dom_builder_intern(b, name)
    var out = _dom_append_node(res.builder, DOM_NODE_KIND_DOCTYPE, res.id, DOM_NO_ID_I64, DOM_NO_ID_I64)
    out.attr_target = DOM_NO_ID_I64
    out

pub fn dom_builder_processing_instruction(b: DomBuilder, target: text, data: text) -> DomBuilder:
    val name_res = dom_builder_intern(b, target)
    val data_res = dom_builder_intern(name_res.builder, data)
    var out = _dom_append_node(
        data_res.builder, DOM_NODE_KIND_PROCESSING_INSTRUCTION, name_res.id, DOM_NO_ID_I64, data_res.id
    )
    out.attr_target = DOM_NO_ID_I64
    out

# Closing with an empty stack is malformed input, not a no-op: an unbalanced
# end tag is exactly the case where a silent repair would make two tiers
# disagree about tree shape while both reported success.
pub fn dom_builder_close(b: DomBuilder) -> DomBuilder:
    if b.open_stack.len() == 0:
        return _dom_fail(
            b,
            DOM_BUILD_ERR_UNBALANCED_CLOSE
                + ": open_depth=0 node_count=" + b.arena.node_count.to_i64().to_text()
        )
    var out = b
    out.open_stack = b.open_stack[0:b.open_stack.len() - 1]
    out.attr_target = DOM_NO_ID_I64
    out

pub fn dom_builder_open_depth(b: DomBuilder) -> i64:
    b.open_stack.len()

# --- capacity accounting --------------------------------------------------
# Kernel A/B equivalent for this stage: the exact totals the arena holds, in
# the frozen `GpuWebCapacityPlan` shape so Kernel C can verify them.
#
# `input_bytes` here is the total UTF-8 byte weight handed to the builder
# (every interned name/value/text counted once per distinct string). Once the
# HTML ParseDialect lands, the dialect's source document length is the correct
# value and this becomes a lower bound; that substitution is a one-line change
# in the dialect adapter, not a schema change.
pub fn dom_builder_capacity_plan(b: DomBuilder) -> GpuWebCapacityPlan:
    var plan = gpu_web_capacity_plan_zero()
    val arena = b.arena
    plan.input_bytes = b.input_bytes.to_u64()
    plan.nodes = arena.node_count
    plan.attributes = arena.attributes.count
    plan.string_bytes = arena.strings.bytes.len().to_u64()

    # One parent edge per node that has a parent. Counted, not assumed to be
    # node_count - 1: the arena permits several root-level nodes (a document
    # with a doctype and a comment before <html> has three).
    var edges = 0
    var i = 0
    val total = arena.node_count.to_i64()
    while i < total:
        if arena.parents[i].to_i64() != DOM_NO_ID_I64:
            edges = edges + 1
        i = i + 1
    plan.dom_edges = edges.to_u32()
    plan

# --- finish ---------------------------------------------------------------
# Total. Never throws, never truncates. `ok` is true only when the call
# sequence was well formed AND the result fits the manifest.
pub fn dom_builder_finish(b: DomBuilder, manifest: GpuWebCapacityManifest) -> DomBuildResult:
    var checked = b
    if b.open_stack.len() > 0:
        checked = _dom_fail(
            b,
            DOM_BUILD_ERR_UNCLOSED_ELEMENTS
                + ": open_depth=" + b.open_stack.len().to_text()
                + " deepest_node=" + b.open_stack[b.open_stack.len() - 1].to_text()
        )

    val plan = dom_builder_capacity_plan(checked)
    val verdict = gpu_web_capacity_verify(plan, manifest)

    var reasons = checked.reasons
    var errors = checked.error_count
    var first = checked.first_reason
    if not verdict.accepted:
        val receipt = DOM_BUILD_ERR_CAPACITY + ": " + verdict.reason
        reasons = reasons.push(receipt)
        errors = errors + 1
        if first == "":
            first = receipt

    DomBuildResult(
        ok: errors == 0,
        reason: first,
        error_count: errors,
        reasons: reasons,
        arena: checked.arena,
        plan: plan,
        verdict: verdict
    )

# An immutable snapshot of a successful build. A rejected build yields no
# snapshot — callers must read `ok` first; handing back a snapshot of a
# partially committed tree is the silent fallback shared rule 4 forbids.
pub fn dom_build_result_snapshot(result: DomBuildResult, epoch: u64) -> DomSnapshot:
    dom_snapshot(epoch, result.arena)
