# Frozen contract — GPU-web DOM arena (HTML-DOM lane, parse side).
#
# Plan (authoritative on names/types/staging):
#   doc/03_plan/platform/structural_compute/html_css_parser_plan.md
#     Scope bullet 1: "`DomArena`/`DomAttributeArena`, stable document-local
#     `NodeId` (index + generation), immutable DOM snapshots"
#     Phase 1 "Canonical schema (Wave 0/1)".
# Shared lane rules:
#   doc/03_plan/platform/structural_compute/README.md
# Conventions this file follows (normative for the nine non-ID-TAG lanes):
#   doc/05_design/platform/structural_compute/identity_tagmap_contract_v1.md §2
#
# WHY SoA
# This schema mirrors the frozen DrawIR v3 conventions
# (`src/lib/common/ui/draw_ir_v3.spl`), which are the house rules for anything
# a GPU kernel will later touch:
#   * no text keys in the hot structures — every name/value is a u32 id into a
#     flat string table;
#   * no nested dynamic arrays — a node's attributes are a `(start, count)`
#     span into one flat attribute arena;
#   * `0xffffffff` is the absent/null id, because ids are 0-based flat indices
#     so 0 is a real id;
#   * explicit schema version constant; a contract change is a NEW version
#     (shared rule 1), never an in-place edit of this file.
#
# WHAT THIS FILE IS NOT
# There is no tokenizer here and no tree builder driven from source text. The
# HTML tokenizer is a ParseDialect on the parser_framework lane's runtime and
# that contract is NOT frozen at origin yet, so per shared rule 1 this lane
# stops at the arena the tree builder commits into. `dom_arena_build.spl`
# supplies the ordered commit API (open/attribute/text/close) that the
# tokenizer will drive once the dialect contract lands.
#
# CPU REFERENCE (shared rule 3): this module and its builder are the oracle the
# SIMD/GPU tokenizer tiers must match. It is never deleted.

use std.common.base_encoding.utilities.{base_encoding_bytes_to_text as bytes_to_text}

# --- schema version -------------------------------------------------------
pub val GPU_WEB_DOM_ARENA_SCHEMA_VERSION: text = "simple-gpu-web-dom-arena-v1"
# Numeric mirror, for headers that may not carry text (device-visible marker).
pub val GPU_WEB_DOM_ARENA_SCHEMA_ID: u32 = 1u32

# --- absent id ------------------------------------------------------------
pub val DOM_NO_ID: u32 = 0xffffffffu32
# i64 mirror. Column reads are compared in i64 throughout this module because
# mixed-width comparison has bitten this repo before; the u32 constant above is
# the contract, this one is the arithmetic form of the same value.
pub val DOM_NO_ID_I64: i64 = 4294967295

# --- node kinds (u16) -----------------------------------------------------
# Discriminants are wire values: never renumber, never reuse a retired number.
pub val DOM_NODE_KIND_NONE: u16 = 0u16
pub val DOM_NODE_KIND_DOCUMENT: u16 = 1u16
pub val DOM_NODE_KIND_DOCTYPE: u16 = 2u16
pub val DOM_NODE_KIND_ELEMENT: u16 = 3u16
pub val DOM_NODE_KIND_TEXT: u16 = 4u16
pub val DOM_NODE_KIND_COMMENT: u16 = 5u16
pub val DOM_NODE_KIND_CDATA: u16 = 6u16
pub val DOM_NODE_KIND_PROCESSING_INSTRUCTION: u16 = 7u16

# =========================================================================
# Stable document-local node id: index + generation.
#
# `index` is the flat column index. `generation` distinguishes a reused slot
# from the node that previously occupied it, so a reference held across a
# mutation epoch can be detected as stale rather than silently resolving to a
# different node. Append-only construction (this wave) emits generation 0 for
# every node; the mutation-transaction wave is what bumps it.
# =========================================================================
struct DomNodeId:
    index: u32
    generation: u32

# A (start, count) span into a flat column. The only way variable-length
# payloads are expressed in this schema.
struct DomSpan:
    start: u32
    count: u32

# =========================================================================
# String table — the single place text lives.
#
# `bytes` is one flat UTF-8 byte column; `starts`/`lens` are per-id spans into
# it. Spans always cover a whole interned string and are never split, so a
# span is always valid UTF-8 by construction.
# =========================================================================
struct DomStringTable:
    bytes: [u8]
    starts: [u32]
    lens: [u32]
    count: u32

# =========================================================================
# Attribute arena — flat columns, addressed by each node's (start, count).
# Attribute order within a node is document order; the builder never reorders.
# =========================================================================
struct DomAttributeArena:
    name_ids: [u32]
    value_ids: [u32]
    ns_ids: [u32]
    count: u32

# =========================================================================
# DOM arena — struct of arrays, one entry per node, indexed by node index.
#
# Nodes are appended in document (pre-order) order, so a node's index IS its
# document order. That is a contract guarantee, not an implementation detail:
# ordered comparisons and the canonical serialization both rely on it.
# =========================================================================
struct DomArena:
    schema_id: u32
    node_count: u32

    kinds: [u16]
    generations: [u32]

    # u32 ids into the string table; DOM_NO_ID where the kind has no such field
    # (a text node has no name, an element has no value).
    name_ids: [u32]
    ns_ids: [u32]
    value_ids: [u32]

    # Tree links, all node indices, DOM_NO_ID for absent.
    parents: [u32]
    first_children: [u32]
    last_children: [u32]
    next_siblings: [u32]
    prev_siblings: [u32]
    child_counts: [u32]

    # (start, count) span into `attributes`.
    attr_starts: [u32]
    attr_counts: [u32]

    strings: DomStringTable
    attributes: DomAttributeArena

# =========================================================================
# Immutable snapshot. `snapshot` is the FROZEN ID-TAG `SnapshotId`
# (src/lib/common/structural/identity/entity_id.spl) — this lane consumes that
# contract rather than minting its own epoch type.
#
# INTERPRETATION (plan is silent): the plan says "immutable DOM snapshots" but
# does not name the wrapper struct or say which snapshot identity to use.
# Reusing the frozen `SnapshotId` is this lane's reading of shared rule 1; it
# is not spelled out in the plan.
# =========================================================================
struct DomSnapshot:
    snapshot_epoch: u64
    arena: DomArena

# --- constructors ---------------------------------------------------------

pub fn dom_node_id(index: u32, generation: u32) -> DomNodeId:
    DomNodeId(index: index, generation: generation)

pub fn dom_span(start: u32, count: u32) -> DomSpan:
    DomSpan(start: start, count: count)

pub fn dom_string_table_empty() -> DomStringTable:
    DomStringTable(bytes: [], starts: [], lens: [], count: 0u32)

pub fn dom_attribute_arena_empty() -> DomAttributeArena:
    DomAttributeArena(name_ids: [], value_ids: [], ns_ids: [], count: 0u32)

pub fn dom_arena_empty() -> DomArena:
    DomArena(
        schema_id: GPU_WEB_DOM_ARENA_SCHEMA_ID,
        node_count: 0u32,
        kinds: [],
        generations: [],
        name_ids: [],
        ns_ids: [],
        value_ids: [],
        parents: [],
        first_children: [],
        last_children: [],
        next_siblings: [],
        prev_siblings: [],
        child_counts: [],
        attr_starts: [],
        attr_counts: [],
        strings: dom_string_table_empty(),
        attributes: dom_attribute_arena_empty()
    )

# --- equality -------------------------------------------------------------

pub fn dom_node_id_equal(a: DomNodeId, b: DomNodeId) -> bool:
    a.index == b.index and a.generation == b.generation

pub fn dom_span_equal(a: DomSpan, b: DomSpan) -> bool:
    a.start == b.start and a.count == b.count

# --- accessors ------------------------------------------------------------
# All accessors are total: an out-of-range index yields an absent/empty answer
# rather than trapping. They are cold-path helpers; the hot path indexes the
# columns directly.

pub fn dom_arena_node_count(arena: DomArena) -> i64:
    arena.node_count.to_i64()

pub fn dom_arena_in_range(arena: DomArena, index: i64) -> bool:
    index >= 0 and index < arena.node_count.to_i64()

pub fn dom_arena_node_id(arena: DomArena, index: i64) -> DomNodeId:
    if not dom_arena_in_range(arena, index):
        return dom_node_id(DOM_NO_ID, 0u32)
    dom_node_id(index.to_u32(), arena.generations[index])

pub fn dom_arena_kind(arena: DomArena, index: i64) -> u16:
    if not dom_arena_in_range(arena, index):
        return DOM_NODE_KIND_NONE
    arena.kinds[index]

pub fn dom_arena_parent(arena: DomArena, index: i64) -> i64:
    if not dom_arena_in_range(arena, index):
        return DOM_NO_ID_I64
    arena.parents[index].to_i64()

pub fn dom_arena_attribute_span(arena: DomArena, index: i64) -> DomSpan:
    if not dom_arena_in_range(arena, index):
        return dom_span(0u32, 0u32)
    dom_span(arena.attr_starts[index], arena.attr_counts[index])

# Children in document order, walked through the sibling links. The walk is
# bounded by node_count so a corrupted link column cannot spin forever.
pub fn dom_arena_children(arena: DomArena, index: i64) -> [i64]:
    var out: [i64] = []
    if not dom_arena_in_range(arena, index):
        return out
    val limit = arena.node_count.to_i64()
    var steps = 0
    var child = arena.first_children[index].to_i64()
    while child != DOM_NO_ID_I64 and steps <= limit:
        if not dom_arena_in_range(arena, child):
            return out
        out = out.push(child)
        child = arena.next_siblings[child].to_i64()
        steps = steps + 1
    out

# Depth from the document root, walking parents. -1 for an out-of-range index.
pub fn dom_arena_depth(arena: DomArena, index: i64) -> i64:
    if not dom_arena_in_range(arena, index):
        return -1
    val limit = arena.node_count.to_i64()
    var depth = 0
    var cur = arena.parents[index].to_i64()
    while cur != DOM_NO_ID_I64 and depth <= limit:
        if not dom_arena_in_range(arena, cur):
            return depth
        depth = depth + 1
        cur = arena.parents[cur].to_i64()
    depth

# --- string table ---------------------------------------------------------

pub fn dom_string_count(table: DomStringTable) -> i64:
    table.count.to_i64()

# Materialise an interned string. Cold path only — the hot path compares u32
# ids and never needs the bytes.
pub fn dom_string_text(table: DomStringTable, id: i64) -> text:
    if id < 0 or id >= table.count.to_i64():
        return ""
    val start = table.starts[id].to_i64()
    val length = table.lens[id].to_i64()
    if start < 0 or length < 0 or start + length > table.bytes.len():
        return ""
    var slice: [u8] = []
    var i = 0
    while i < length:
        slice = slice.push(table.bytes[start + i])
        i = i + 1
    bytes_to_text(slice)

pub fn dom_arena_name(arena: DomArena, index: i64) -> text:
    if not dom_arena_in_range(arena, index):
        return ""
    dom_string_text(arena.strings, arena.name_ids[index].to_i64())

pub fn dom_arena_value(arena: DomArena, index: i64) -> text:
    if not dom_arena_in_range(arena, index):
        return ""
    dom_string_text(arena.strings, arena.value_ids[index].to_i64())

# Attribute lookup by name within a node's span. Returns DOM_NO_ID_I64 when the
# node has no such attribute — an absent attribute is a real answer, not an
# error, so there is no receipt here.
pub fn dom_arena_attribute_index(arena: DomArena, index: i64, name: text) -> i64:
    val span = dom_arena_attribute_span(arena, index)
    val start = span.start.to_i64()
    val count = span.count.to_i64()
    var i = 0
    while i < count:
        val slot = start + i
        if slot >= 0 and slot < arena.attributes.count.to_i64():
            if dom_string_text(arena.strings, arena.attributes.name_ids[slot].to_i64()) == name:
                return slot
        i = i + 1
    DOM_NO_ID_I64

pub fn dom_arena_attribute_value(arena: DomArena, index: i64, name: text) -> text:
    val slot = dom_arena_attribute_index(arena, index, name)
    if slot == DOM_NO_ID_I64:
        return ""
    dom_string_text(arena.strings, arena.attributes.value_ids[slot].to_i64())

# --- snapshot -------------------------------------------------------------

pub fn dom_snapshot(epoch: u64, arena: DomArena) -> DomSnapshot:
    DomSnapshot(snapshot_epoch: epoch, arena: arena)

# A later snapshot of the same document supersedes an earlier one. Mirrors
# `snapshot_supersedes` in the frozen identity contract.
pub fn dom_snapshot_supersedes(newer: DomSnapshot, older: DomSnapshot) -> bool:
    newer.snapshot_epoch.to_i64() > older.snapshot_epoch.to_i64()

# A node id minted against an older snapshot is stale for a newer one unless
# the generation still matches the slot it names.
pub fn dom_snapshot_id_live(snapshot: DomSnapshot, id: DomNodeId) -> bool:
    val index = id.index.to_i64()
    if not dom_arena_in_range(snapshot.arena, index):
        return false
    snapshot.arena.generations[index].to_i64() == id.generation.to_i64()

# --- canonical serialization ---------------------------------------------
# Acceptance criterion: "Token and DOM canonical serialization equal CPU
# oracle". This is the ordered, deterministic text form every tier must agree
# on. It is host-side and diff-friendly on purpose: a byte codec would compare
# equal for the wrong reasons when two tiers disagree about tree SHAPE, which
# is the property the parity tests actually care about.
#
# Grammar (one line per node, pre-order = index order):
#   <depth-dots><kind> name=<name> ns=<ns> value=<value> attrs=[k=v,...]
# Absent ids serialize as `-`, so absent and empty-string are distinguishable.
fn _dom_kind_name(kind: u16) -> text:
    if kind == DOM_NODE_KIND_DOCUMENT:
        return "document"
    if kind == DOM_NODE_KIND_DOCTYPE:
        return "doctype"
    if kind == DOM_NODE_KIND_ELEMENT:
        return "element"
    if kind == DOM_NODE_KIND_TEXT:
        return "text"
    if kind == DOM_NODE_KIND_COMMENT:
        return "comment"
    if kind == DOM_NODE_KIND_CDATA:
        return "cdata"
    if kind == DOM_NODE_KIND_PROCESSING_INSTRUCTION:
        return "pi"
    "none"

fn _dom_field(table: DomStringTable, id: i64) -> text:
    if id == DOM_NO_ID_I64:
        return "-"
    dom_string_text(table, id)

fn _dom_indent(depth: i64) -> text:
    var out = ""
    var i = 0
    while i < depth:
        out = out + "."
        i = i + 1
    out

pub fn dom_arena_canonical_lines(arena: DomArena) -> [text]:
    var out: [text] = []
    val total = arena.node_count.to_i64()
    var i = 0
    while i < total:
        val span = dom_arena_attribute_span(arena, i)
        val start = span.start.to_i64()
        val count = span.count.to_i64()
        var attrs: [text] = []
        var a = 0
        while a < count:
            val slot = start + a
            if slot >= 0 and slot < arena.attributes.count.to_i64():
                attrs = attrs.push(
                    _dom_field(arena.strings, arena.attributes.name_ids[slot].to_i64())
                    + "="
                    + _dom_field(arena.strings, arena.attributes.value_ids[slot].to_i64())
                )
            a = a + 1
        out = out.push(
            _dom_indent(dom_arena_depth(arena, i))
            + _dom_kind_name(arena.kinds[i])
            + " name=" + _dom_field(arena.strings, arena.name_ids[i].to_i64())
            + " ns=" + _dom_field(arena.strings, arena.ns_ids[i].to_i64())
            + " value=" + _dom_field(arena.strings, arena.value_ids[i].to_i64())
            + " attrs=[" + attrs.join(",") + "]"
        )
        i = i + 1
    out

pub fn dom_arena_canonical_text(arena: DomArena) -> text:
    dom_arena_canonical_lines(arena).join("\n")
