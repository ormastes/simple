use std.common.ui.ui_frame_clock.{FrameClock}
use std.nogc_sync_mut.ui.host_frame_clock.{default_frame_clock}

#[runtime_intrinsics]
extern fn rt_cpu_arch_name() -> text

pub fn cpu_arch_name() -> text:
    rt_cpu_arch_name()

pub fn sleep_nanos(ns: i64, clock: FrameClock? = nil):
    val ck: FrameClock = if clock == nil: default_frame_clock() else: clock
    ck.sleep_until(ck.now_micros() + ns / 1000)
