# SCV interface / HIR fingerprints — SCV-IMPL-G-05.
#
# Reuses the Simple compiler frontend's canonical digests instead of
# inventing a second scheme:
#   * compiler.semantics.interface.compile_interface.compile_interface_digest
#     (domain `simple/compile-interface/v1`, sorted-set canonical encoding)
#     over an ApiSurface built from the `simple` query pack (SCV-IMPL-P-06);
#   * compiler.semantics.interface.module_identity.implementation_digest_of
#     (domain `simple/implementation/v1`, comment/format-insensitive).
#
# NAMES STATE THE GUARANTEE (plan row G-05: no "semantic" overclaim):
#   syntactic_interface_id  "siface1:<sha>"  — the DECLARED public surface
#       (names, parameter names/types, return types, fields, variants,
#       method names) exactly as written in source. It is NOT type-checked
#       and NOT resolved: a type alias rename changes it, an equivalent
#       re-typing does not preserve it.
#   normalized_impl_hash    "nimpl1:<sha>"   — normalized source (comments
#       and trailing whitespace stripped, blank lines dropped).
#   typed_hir_hash          "unavailable:…"  — the compiler frontend has no
#       typed-HIR extractor yet (compile_interface.spl header); reported as
#       unavailable rather than substituted by a syntactic stand-in.
# TODO(SCV-IMPL-G-06): replace typed_hir_hash with the compiler's typed-HIR
# digest once the frontend exposes an extractor (compiler.hir.generated
# .hir_hash hashes HIR nodes, but nothing lowers a module to HIR from here).

use compiler.tools.api_surface.{ApiSurface, FunctionSignature, ParamSignature, FieldSignature, ClassSignature, EnumSignature, TraitSignature}
use compiler.semantics.interface.compile_interface.{compile_interface_digest}
use compiler.semantics.interface.module_identity.{implementation_digest_of}
use std.scv.query_packs.{scv_query_pack_extract_decls}

fn scv_hir_fingerprint_version() -> text:
    "scv/hir-fingerprint/v1"

fn scv_hir_fingerprint_guarantee() -> text:
    "syntactic_interface_id covers the declared public surface as written (not type-checked, not resolved); normalized_impl_hash covers comment/format-normalized source; typed_hir_hash is unavailable"

# --- signature text -> ApiSurface parts -------------------------------------

# Split "(a: i64, b: Dict<text, i64>) -> i64" into (params-text, return-type).
fn scv_fp_split_signature(sig: text) -> (text, text):
    val open = sig.index_of("(")
    if open < 0:
        return ("", "")
    var depth = 0
    var i = open
    var close = -1
    while i < sig.len():
        val c = sig[i:i + 1]
        if c == "(":
            depth = depth + 1
        elif c == ")":
            depth = depth - 1
            if depth == 0:
                close = i
                break
        i = i + 1
    if close < 0:
        return ("", "")
    val params = sig[open + 1:close]
    val tail = sig[close + 1:]
    val arrow = tail.index_of("->")
    val ret = if arrow >= 0: tail[arrow + 2:].trim() else: ""
    (params, ret)

# Top-level comma split (ignores commas nested in <>, (), []).
fn scv_fp_split_params(params: text) -> [text]:
    var out: [text] = []
    var depth = 0
    var current = ""
    for c in params.chars():
        if c == "<" or c == "(" or c == "[":
            depth = depth + 1
        elif c == ">" or c == ")" or c == "]":
            depth = depth - 1
        if c == "," and depth == 0:
            if current.trim() != "":
                out.push(current.trim())
            current = ""
        else:
            current = current + c
    if current.trim() != "":
        out.push(current.trim())
    out

fn scv_fp_param(p: text) -> ParamSignature:
    var body = p
    val eq = body.index_of("=")
    if eq >= 0:
        body = body[0:eq].trim()
    val colon = body.index_of(":")
    if colon < 0:
        return ParamSignature(name: body, type_name: nil)
    ParamSignature(name: body[0:colon].trim(), type_name: Some(body[colon + 1:].trim()))

fn scv_fp_function(name: text, sig: text) -> FunctionSignature:
    val (params_text, ret) = scv_fp_split_signature(sig)
    var params: [ParamSignature] = []
    for p in scv_fp_split_params(params_text):
        params.push(scv_fp_param(p))
    FunctionSignature(name: name, params: params,
        return_type: if ret == "": nil else: Some(ret),
        is_async: false, is_generator: false,
        visibility_display: nil, declared_visibility: nil)

# ApiSurface of a Simple module from the `simple` query pack rows. Top-level
# constants are not part of ApiSurface (compile_interface.spl: not carried
# yet), so they do not enter the id.
fn scv_surface_from_source(module: text, source: text) -> ApiSurface:
    var surface = ApiSurface.create(module)
    val rows = scv_query_pack_extract_decls("simple", source)
    var fields: Dict<text, [FieldSignature]> = {}
    var methods: Dict<text, [text]> = {}
    var variants: Dict<text, [text]> = {}
    var kinds: Dict<text, text> = {}
    var order: [text] = []
    for row in rows:
        val p = row.split("|")
        if p.len() < 5:
            continue
        val kind = p[0]
        val name = p[1]
        val container = p[3]
        val sig = p[4]
        if container == "":
            if kind == "fn":
                surface.add_function(scv_fp_function(name, sig))
            elif kind == "type" or kind == "enum" or kind == "trait":
                kinds[name] = kind
                order.push(name)
                fields[name] = []
                methods[name] = []
                variants[name] = []
        elif kind == "field" and fields.contains_key(container):
            var fl = fields[container]
            fl.push(FieldSignature(name: name, type_name: if sig == "": nil else: Some(sig), is_public: true, visibility_display: nil, declared_visibility: nil))
            fields[container] = fl
        elif kind == "variant" and variants.contains_key(container):
            var vl = variants[container]
            vl.push(name)
            variants[container] = vl
        elif kind == "fn" and methods.contains_key(container):
            var ml = methods[container]
            ml.push(name)
            methods[container] = ml
    for name in order:
        val kind = kinds[name]
        if kind == "type":
            surface.add_class(ClassSignature(name: name, fields: fields[name], methods: methods[name]))
        elif kind == "enum":
            surface.add_enum(EnumSignature(name: name, variants: variants[name]))
        else:
            surface.add_trait(TraitSignature(name: name, methods: methods[name]))
    surface

# --- fingerprints ------------------------------------------------------------

fn scv_syntactic_interface_id(module: text, source: text) -> text:
    "siface1:" + compile_interface_digest(scv_surface_from_source(module, source))

fn scv_normalized_impl_hash(source: text) -> text:
    "nimpl1:" + implementation_digest_of(source)

fn scv_typed_hir_hash(module: text, source: text) -> text:
    "unavailable: no typed-HIR extractor in the compiler frontend (module {module}, {source.len()} bytes); see TODO(SCV-IMPL-G-06) in std.scv.hir_fingerprint"

fn scv_hir_fingerprint(module: text, source: text) -> text:
    "fingerprint: {scv_hir_fingerprint_version()}\nmodule: {module}\nsyntactic_interface_id: {scv_syntactic_interface_id(module, source)}\nnormalized_impl_hash: {scv_normalized_impl_hash(source)}\ntyped_hir_hash: {scv_typed_hir_hash(module, source)}\nguarantee: {scv_hir_fingerprint_guarantee()}\n"

fn scv_fingerprint_field(record: text, key: text) -> text:
    val marker = "{key}: "
    for line in record.split("\n"):
        if line.starts_with(marker):
            return line[marker.len():]
    ""

export scv_hir_fingerprint_version, scv_hir_fingerprint_guarantee
export scv_surface_from_source, scv_syntactic_interface_id, scv_normalized_impl_hash, scv_typed_hir_hash
export scv_hir_fingerprint, scv_fingerprint_field
