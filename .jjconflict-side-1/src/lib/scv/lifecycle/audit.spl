# codex-impl
# Durable audit identity for lifecycle and protected-operation boundaries.

use std.common.crypto.sha256.{sha256_text}
use std.scv.lifecycle.model.{OperationAudit}
use std.scv.lifecycle.codec.{LifecycleRecord, lifecycle_record}

struct OperationAuditInput:
    operation_kind: text
    entity_id: text
    actor_id: text
    authority: text
    policy_digest: text
    input_digest: text
    output_digest: text
    state: text

fn lifecycle_operation_audit(input: OperationAuditInput) -> OperationAudit:
    val operation_id = "op_" + sha256_text(input.operation_kind + "|" + input.entity_id + "|" + input.actor_id + "|" + input.policy_digest + "|" + input.input_digest)
    OperationAudit(operation_id: operation_id, operation_kind: input.operation_kind, entity_id: input.entity_id, actor: input.actor_id, authority: input.authority, policy_digest: input.policy_digest, input_digest: input.input_digest, output_digest: input.output_digest, state: input.state)

fn lifecycle_operation_record(audit: OperationAudit) -> LifecycleRecord:
    lifecycle_record("operation_audit", audit.operation_id, [
        audit.operation_kind, audit.entity_id, audit.actor, audit.authority,
        audit.policy_digest, audit.input_digest, audit.output_digest, audit.state
    ])

export OperationAuditInput, lifecycle_operation_audit, lifecycle_operation_record
