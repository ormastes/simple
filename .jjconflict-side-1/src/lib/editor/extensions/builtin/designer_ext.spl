# Built-in Designer Extension
#
# Declares the "ui" visual-document kind and the designer.* command surface.
# The real note/preview/link logic lives on the markdown visual editor model
# (src/lib/common/markdown_visual_editor.spl, owner_module of the "designer"
# IDE capability): markdown_visual_note (path+source -> MarkdownVisualNote,
# line 17), markdown_visual_preview_lines (source -> rendered preview lines,
# line 45), and markdown_visual_wiki_links (source -> [text] wiki links,
# line 56). This manifest is the typed, host-visible declaration of that
# command surface, matching writer_ext_manifest's pattern of declaring
# commands the app itself owns and runs.

# Designer is the builtin that owns the "ui" domain, so it is also the
# manifest that declares the appearance the IDE actually ships: the
# `aetheric_dark` palette at config/themes/aetheric_dark/theme.sdn, which
# config/themes/theme.sdn names as `default_theme` (and to which every `light`
# / `dark` / `glass_*` alias currently resolves). Declaring it here makes
# `contributes_themes` a live contribution kind end to end -- the host
# registers it on activation and `ExtensionHost.find_theme` resolves it --
# rather than a field that only ever decodes.
use std.editor.extensions.manifest.{ExtensionManifest, ExtensionCommand, ExtensionLanguage,
    ExtensionTheme, extension_manifest_basic}

fn designer_ext_manifest() -> ExtensionManifest:
    var m = extension_manifest_basic(
        "designer", "1.0.0", "",
        ["onCommand:designer.load_note", "onCommand:designer.preview"],
        [
            ExtensionCommand(id: "designer.load_note", title: "Designer: Load Note", category: "Designer"),
            ExtensionCommand(id: "designer.preview", title: "Designer: Preview", category: "Designer"),
            ExtensionCommand(id: "designer.wiki_links", title: "Designer: List Wiki Links", category: "Designer")
        ],
        [ExtensionLanguage(id: "ui", extensions: ["html", "css"])]
    )
    m.contributes_themes = [
        ExtensionTheme(
            id: "aetheric-dark",
            label: "Aetheric Dark",
            ui_theme: "dark",
            path: "config/themes/aetheric_dark/theme.sdn"
        )
    ]
    m
