# Host-OS system clipboard access via SDL2.

use common.ui.capability.{Capability, NotSupported}
use std.nogc_async_mut.io.window_sffi.{window_clipboard_get, window_clipboard_set, window_clipboard_has_text}

fn clipboard_read() -> Result<text, NotSupported>:
    val content = window_clipboard_get()
    if not content.?:
        return Err(NotSupported.new("SDL2 clipboard read failed"))
    Ok(content.unwrap())

fn clipboard_write(content: text) -> Result<bool, NotSupported>:
    val ok = window_clipboard_set(content)
    if not ok:
        return Err(NotSupported.new("SDL2 clipboard write failed"))
    Ok(ok)

fn clipboard_has_text() -> Result<bool, NotSupported>:
    val has_text = window_clipboard_has_text()
    if not has_text.?:
        return Err(NotSupported.new("SDL2 clipboard query failed"))
    Ok(has_text.unwrap())
