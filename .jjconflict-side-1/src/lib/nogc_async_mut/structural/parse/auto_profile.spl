# Auto-profile seam for wave-2 dispatch decisions.
#
# Deliberately returns a scalar-only default in wave-1 with explicit fallback reason.

use std.common.structural.parse.contracts.{ParseExecutionMode}
use std.common.structural.parse.parse_types.{ParseRequest}
use std.nogc_async_mut.structural.parse.runtime.{ParseRuntime}

struct ParseBenchmarkEvidence:
    dialect_id: text
    schema_version: i64
    runtime_version: i64
    backend: text
    evidence_digest: text

struct ParseModeDecision:
    requested: ParseExecutionMode
    selected: ParseExecutionMode
    fallback_reason: text
    evidence_digest: text

fn select_parse_mode(_runtime: ParseRuntime, _request: ParseRequest, evidence: [ParseBenchmarkEvidence]) -> ParseModeDecision:
    # No threshold data is collected in wave-1. Keep the observable shape explicit.
    ParseModeDecision(
        requested: ParseExecutionMode.Auto,
        selected: ParseExecutionMode.Scalar,
        fallback_reason: "auto_profile_not_implemented_wave_1",
        evidence_digest: if evidence.len() > 0: evidence[0].evidence_digest else ""
    )

export ParseBenchmarkEvidence, ParseModeDecision
export select_parse_mode
