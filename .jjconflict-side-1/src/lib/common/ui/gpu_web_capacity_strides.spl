# GPU Web Capacity Strides — backend-aware one-time-allocation sizing (S5).
#
# Additive sibling of `gpu_web_capacity_manifest.spl`. Nothing in the manifest
# module is modified, wrapped, or re-exported here; this file only adds the
# byte-sizing layer the refactor plan S5 requires:
#   doc/03_plan/ui/draw_ir/draw_ir_backend_native_refactor_plan.md  (S5)
#   doc/04_architecture/ui/rendering/draw_ir_backend_native_layout.md  (§4)
#
# THE HONESTY RULE (unchanged from the manifest module)
# This file MEASURES. It never clamps a count, never grows a bound, and never
# rounds a count down. Rounding here goes only UP (pool base to backend
# alignment), which can only make a capacity verdict stricter, never looser.
#
# STRIDE DERIVATION — read before editing any number.
# Every stride below is derived field-by-field from the frozen record it
# sizes, using the CANONICAL LANE LAYOUT: a u16 column occupies a full 4-byte
# lane, because the conservative device baseline does not assume 16-bit
# storage capability (Vulkan: storageBuffer16BitAccess/shaderInt16 are
# optional; D3D12: no 16-bit scalars before SM6.2; sharing one layout across
# backends means the least common denominator wins). The packed (byte-exact)
# sum is documented next to each lane sum so the rounding is auditable.
#
# Per-record arithmetic, from src/lib/common/ui/draw_ir_v3.spl unless noted:
#
#   command      DrawIrV3Command: kind u16 + flags u16 + 11 x u32
#                (component_id, component_generation, parent_id, geometry_id,
#                 paint_id, text_run_id, image_resource_id, path_span_id,
#                 clip_id, transform_id, hit_shape_id).
#                Packed: 2x2 + 11x4 = 48 B. Lane: 13 x 4 = 52 B.
#   geometry     DrawIrV3GeometryTable per record: xs, ys, widths, heights,
#                corner_radii = 5 x i32 = 20 B (packed == lane).
#   paint        DrawIrV3PaintTable per record: fill_colors u32 +
#                stroke_colors u32 + stroke_widths_milli i32 +
#                opacities_milli i32 + blend_modes u16.
#                Packed: 4+4+4+4+2 = 18 B. Lane: 5 x 4 = 20 B.
#   text_run     DrawIrV3TextRunTable per RUN (run_* columns only):
#                run_glyph_starts u32 + run_glyph_counts u32 +
#                run_font_resource_ids u32 + run_font_sizes_milli i32 +
#                run_baseline_xs i32 + run_baseline_ys i32 + run_colors u32
#                = 7 x 4 = 28 B (packed == lane).
#   glyph        DrawIrV3TextRunTable per GLYPH (glyph_* columns):
#                glyph_ids u32 + glyph_xs i32 + glyph_ys i32 +
#                glyph_clusters i64. Packed: 4+4+4+8 = 20 B; +4 B tail pad so
#                an AoS mirror keeps the i64 cluster 8-byte aligned = 24 B.
#   resource     DrawIrV3ResourceTable per record: kinds u16 + formats u32
#                (widened per S1) + widths u32 + heights u32 +
#                content_hashes i64. Packed: 2+4+4+4+8 = 22 B.
#                Lane: 4+4+4+4+8 = 24 B (already an 8-byte multiple).
#   path_point   DrawIrV3PathPointTable per POINT (point_* columns):
#                point_xs i32 + point_ys i32 + point_verbs u16.
#                Packed: 4+4+2 = 10 B. Lane: 3 x 4 = 12 B.
#   clip         DrawIrV3ClipTable per record: xs, ys, widths, heights,
#                corner_radii (5 x i32) + parent_ids u32 = 6 x 4 = 24 B.
#   transform    DrawIrV3TransformTable per record: m11s, m12s, m21s, m22s,
#                dxs, dys = 6 x i32 = 24 B (packed == lane).
#
# Counts in the manifest with no v3 table get their own stride field, each
# with its own documented basis (never a guessed reuse of another stride):
#
#   node         NO fixed-width device node record exists in-tree
#                (WebLayoutNodeSnapshot in gpu_web/layout/contracts.spl is
#                host-side and carries text fields). Documented CONSERVATIVE
#                constant: numeric core of WebLayoutNodeSnapshot = id +
#                arena_index + dom_route_id + parent_id + font_size +
#                estimated_work (6 x i64 = 48 B) + 3 bool flags widened to
#                4-byte lanes (12 B) = 60 B, rounded to 64 B.
#   layout_box   LayoutBox (src/lib/common/structural/layout/types.spl):
#                id, x, y, width, height = 5 x i64 = 40 B.
#   batch        NO device batch record exists yet; plan S4 defines the batch
#                dispatch shape (one dispatch per command range, descriptor
#                sets keyed by (pipeline, resource-set)). Documented
#                conservative record: command_start u32 + command_count u32 +
#                pipeline_id u32 (12 B) + resource_set_key i64 (8 B) = 20 B,
#                +4 B tail pad for the i64 key in an AoS mirror = 24 B.
#   patch_op     DrawIrPatchOp (src/lib/common/ui/draw_ir_patch.spl) mapped
#                field-by-field to fixed-width v3 equivalents: kind lane 4 B +
#                component_id as u32 id 4 B + parent_id as u32 id 4 B +
#                old_index i32 4 B + new_index i32 4 B + embedded command
#                image 52 B + old_bounds + new_bounds as DrawIrRect
#                (present lane 4 B + 4 x i32 = 20 B each, 40 B) = 112 B.
#   fragment     LayoutFragment (structural/layout/types.spl): id i64 +
#                node_id i64 + box LayoutBox 40 B + kind (text; sized as an
#                8-byte kind handle, documented conservative) +
#                fragment_index i64 = 8+8+40+8+8 = 72 B.
#   line_box     LayoutLineBox (structural/layout/types.spl): node_id i64 +
#                line_index i64 + box LayoutBox 40 B + text_start i64 +
#                text_end i64 = 8+8+40+8+8 = 72 B.
#
# ALIGNMENT per backend (pool granularity, not field granularity):
#   vulkan  256 — conservative minStorageBufferOffsetAlignment ceiling; the
#                 spec-guaranteed worst case a portable allocator must accept.
#   metal   16  — Metal buffer offset alignment conservative bound (setBuffer
#                 offset alignment; 16 covers all Apple GPU families).
#   d3d12   256 — D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT; structured
#                 SRV/UAV pools placed with CBV-compatible offsets.
#
# D3D12 command stride: kind/flags already occupy 4-byte lanes (see canonical
# lane rule above), so no extra u16 packing is needed for correctness; the
# record is padded 52 -> 56 B so consecutive command records tile on 8-byte
# boundaries (arch doc §4.1: "DX u16-packing may pad to 56").

use common.ui.gpu_web_capacity_manifest.{GpuWebCapacityManifest}

pub struct GpuWebBackendStrideProfile:
    command_stride_bytes: i64
    geometry_stride_bytes: i64
    paint_stride_bytes: i64
    text_run_stride_bytes: i64
    glyph_stride_bytes: i64
    resource_stride_bytes: i64
    path_point_stride_bytes: i64
    clip_stride_bytes: i64
    transform_stride_bytes: i64
    node_stride_bytes: i64
    layout_box_stride_bytes: i64
    batch_stride_bytes: i64
    patch_operation_stride_bytes: i64
    fragment_stride_bytes: i64
    line_box_stride_bytes: i64
    alignment_bytes: i64

# Canonical lane strides shared by every profile; only `command` (D3D12 tail
# pad) and `alignment_bytes` differ per backend. Values per the derivation
# table in the header — change a number only together with its arithmetic.
fn _gws_profile(command_stride: i64, alignment: i64) -> GpuWebBackendStrideProfile:
    return GpuWebBackendStrideProfile(
        command_stride_bytes: command_stride,
        geometry_stride_bytes: 20,
        paint_stride_bytes: 20,
        text_run_stride_bytes: 28,
        glyph_stride_bytes: 24,
        resource_stride_bytes: 24,
        path_point_stride_bytes: 12,
        clip_stride_bytes: 24,
        transform_stride_bytes: 24,
        node_stride_bytes: 64,
        layout_box_stride_bytes: 40,
        batch_stride_bytes: 24,
        patch_operation_stride_bytes: 112,
        fragment_stride_bytes: 72,
        line_box_stride_bytes: 72,
        alignment_bytes: alignment
    )

# Vulkan: command = 13 lanes x 4 B = 52; alignment 256 (conservative
# minStorageBufferOffsetAlignment).
pub fn gpu_web_stride_profile_vulkan() -> GpuWebBackendStrideProfile:
    return _gws_profile(52, 256)

# Metal: identical lane strides (data is shared canonical-VK layout, not
# retranslated); alignment 16 (buffer offset alignment bound).
pub fn gpu_web_stride_profile_metal() -> GpuWebBackendStrideProfile:
    return _gws_profile(52, 16)

# D3D12: kind/flags already widened to 4-byte lanes, so no repacking; command
# padded 52 -> 56 to tile records on 8-byte boundaries (arch doc §4.1);
# alignment 256 (D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT).
pub fn gpu_web_stride_profile_d3d12() -> GpuWebBackendStrideProfile:
    return _gws_profile(56, 256)

# Round a pool size UP to the profile alignment. 0 stays 0 (an empty pool
# reserves nothing). alignment <= 0 skips rounding, mirroring the
# `alignment_bytes > 0` guard in gpu_web_capacity_manifest_for_backend_session.
fn _gws_round_up(size_bytes: i64, alignment_bytes: i64) -> i64:
    if alignment_bytes <= 0:
        return size_bytes
    val rem = size_bytes % alignment_bytes
    if rem == 0:
        return size_bytes
    return size_bytes + (alignment_bytes - rem)

fn _gws_pool_bytes(count: i64, stride_bytes: i64, alignment_bytes: i64) -> i64:
    return _gws_round_up(count * stride_bytes, alignment_bytes)

# Total one-time reservation in bytes for the record pools the manifest
# bounds: each pool is count x stride, rounded UP to the backend alignment,
# then summed. MEASUREMENT ONLY — no clamping, no auto-grow; a caller that
# finds this total over budget must reject with a receipt, exactly like
# Kernel C. Counts with no record pool (attributes, css bounds, events,
# scratch byte fields, ...) are byte- or policy-bounds already and are not
# resized here.
pub fn gpu_web_capacity_bytes(manifest: GpuWebCapacityManifest, strides: GpuWebBackendStrideProfile) -> i64:
    val a = strides.alignment_bytes
    var total: i64 = 0
    total = total + _gws_pool_bytes(manifest.max_nodes.to_i64(), strides.node_stride_bytes, a)
    total = total + _gws_pool_bytes(manifest.max_layout_boxes.to_i64(), strides.layout_box_stride_bytes, a)
    total = total + _gws_pool_bytes(manifest.max_fragments.to_i64(), strides.fragment_stride_bytes, a)
    total = total + _gws_pool_bytes(manifest.max_line_boxes.to_i64(), strides.line_box_stride_bytes, a)
    total = total + _gws_pool_bytes(manifest.max_glyphs.to_i64(), strides.glyph_stride_bytes, a)
    total = total + _gws_pool_bytes(manifest.max_draw_batches.to_i64(), strides.batch_stride_bytes, a)
    total = total + _gws_pool_bytes(manifest.max_draw_commands.to_i64(), strides.command_stride_bytes, a)
    total = total + _gws_pool_bytes(manifest.max_path_points.to_i64(), strides.path_point_stride_bytes, a)
    total = total + _gws_pool_bytes(manifest.max_patch_operations.to_i64(), strides.patch_operation_stride_bytes, a)
    return total
