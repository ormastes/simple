# DrawIR v3 CPU oracle and validation sink.
#
# Source of truth: `doc/03_plan/ui/gpu_web_scene_offload_mdsoc_plus_plan.md`
# §12 Program 2, "I5 -- CPU oracle and validation sink":
#
#     Implement from one canonical operation walker:
#       CountingSink
#       ArenaSink
#       ValidationSink
#       HashSink
#       CPUPrepared2DSink
#     This prevents estimator/renderer drift.
#
# THE ONE-WALKER RULE THIS FILE EXISTS TO ENFORCE
# ------------------------------------------------
# Every sink below (`draw_ir_v3_oracle_count`, `draw_ir_v3_oracle_hash`,
# `draw_ir_v3_oracle_validate`) is a thin read of a single field on the report
# produced by `draw_ir_v3_oracle_walk`. That walker is the ONLY loop over
# `scene.commands` in this file. If a future change needs a sixth sink
# (e.g. `CPUPrepared2DSink`), add a field to `DrawIrV3OracleReport` and fold it
# in the SAME loop -- never add a second independent scan. Two scans computing
# "the same" count from two different loops is exactly the estimator/renderer
# drift this lane is chartered to prevent (shared rule 3,
# `doc/03_plan/platform/structural_compute/README.md`: the CPU reference is
# the oracle and is never forked).
#
# `hash` folds every `DrawIrV3Command` field, in the field's declared order, so
# two scenes that differ in any field -- including an id a renderer might
# otherwise ignore -- produce different hashes. The fold is FNV-1a over the
# little-endian bytes of each field (u16 fields fold 2 bytes, u32 fields fold
# 4), which is the same algorithm as `std.hash.fnv1a_hash_i64`
# (`src/lib/nogc_async_mut_noalloc/hash/mod.spl`) generalized to a u64
# accumulator; it is reimplemented locally rather than imported so this
# `common/ui` module does not take a dependency on the baremetal hash tier.
#
# The hash is masked to 63 bits before being returned. This mirrors the
# precedent in `window_scene.spl`'s `wm_content_frame_checksum`: a u64 struct
# field carrying the high bit set corrupts `if val` / Option-unwrap on the
# JIT-bailout interpreter path (see
# doc/08_tracking/bug/interp_u64_high_bit_option_unwrap_corruption_2026-07-11.md).
# Costs one bit of hash space, not a redesign.

use common.ui.draw_ir_v3.{
    DRAW_IR_V3_FLAG_HIDDEN,
    DRAW_IR_V3_KIND_IMAGE,
    DRAW_IR_V3_KIND_PATH,
    DRAW_IR_V3_KIND_RECT,
    DRAW_IR_V3_KIND_TEXT,
    DRAW_IR_V3_NO_ID,
    DrawIrV3Scene,
    draw_ir_v3_has_flag
}

# --- FNV-1a (64-bit) constants ---------------------------------------------
val _ORACLE_FNV1A_OFFSET_BASIS: u64 = 0xcbf29ce484222325u64
val _ORACLE_FNV1A_PRIME: u64 = 0x100000001b3u64

# =========================================================================
# Report -- the single struct every sink reads from.
# =========================================================================
struct DrawIrV3OracleReport:
    total_commands: i64
    rect_count: i64
    text_count: i64
    image_count: i64
    path_count: i64
    hidden_count: i64
    hash: u64

# Folds `byte_count` little-endian bytes of `value` into `hash` via FNV-1a.
# `value` stays `i64` through the shift/mask so this uses the same proven
# arithmetic as `std.hash.fnv1a_hash_i64`; only the final byte is widened to
# `u64` to XOR into the accumulator.
fn _draw_ir_v3_oracle_fold_bytes(hash: u64, value: i64, byte_count: i64) -> u64:
    var h = hash
    var v = value
    var i: i64 = 0
    while i < byte_count:
        val byte = (v & 0xFF).to_u64()
        h = h ^ byte
        h = h * _ORACLE_FNV1A_PRIME
        v = v >> 8
        i = i + 1
    h

# =========================================================================
# The one canonical walker. Counting, kind classification, hidden-flag
# accounting, and hashing all come from this single pass over
# `scene.commands`.
# =========================================================================
fn draw_ir_v3_oracle_walk(scene: DrawIrV3Scene) -> DrawIrV3OracleReport:
    var total_commands: i64 = 0
    var rect_count: i64 = 0
    var text_count: i64 = 0
    var image_count: i64 = 0
    var path_count: i64 = 0
    var hidden_count: i64 = 0
    var hash: u64 = _ORACLE_FNV1A_OFFSET_BASIS

    val commands = scene.commands
    var i: i64 = 0
    while i < commands.len().to_i64():
        val cmd = commands[i]
        total_commands = total_commands + 1

        if cmd.kind == DRAW_IR_V3_KIND_RECT:
            rect_count = rect_count + 1
        elif cmd.kind == DRAW_IR_V3_KIND_TEXT:
            text_count = text_count + 1
        elif cmd.kind == DRAW_IR_V3_KIND_IMAGE:
            image_count = image_count + 1
        elif cmd.kind == DRAW_IR_V3_KIND_PATH:
            path_count = path_count + 1

        if draw_ir_v3_has_flag(cmd, DRAW_IR_V3_FLAG_HIDDEN):
            hidden_count = hidden_count + 1

        # Fold every DrawIrV3Command field, in declared order.
        hash = _draw_ir_v3_oracle_fold_bytes(hash, cmd.kind.to_i64(), 2)
        hash = _draw_ir_v3_oracle_fold_bytes(hash, cmd.flags.to_i64(), 2)
        hash = _draw_ir_v3_oracle_fold_bytes(hash, cmd.component_id.to_i64(), 4)
        hash = _draw_ir_v3_oracle_fold_bytes(hash, cmd.component_generation.to_i64(), 4)
        hash = _draw_ir_v3_oracle_fold_bytes(hash, cmd.parent_id.to_i64(), 4)
        hash = _draw_ir_v3_oracle_fold_bytes(hash, cmd.geometry_id.to_i64(), 4)
        hash = _draw_ir_v3_oracle_fold_bytes(hash, cmd.paint_id.to_i64(), 4)
        hash = _draw_ir_v3_oracle_fold_bytes(hash, cmd.text_run_id.to_i64(), 4)
        hash = _draw_ir_v3_oracle_fold_bytes(hash, cmd.image_resource_id.to_i64(), 4)
        hash = _draw_ir_v3_oracle_fold_bytes(hash, cmd.path_span_id.to_i64(), 4)
        hash = _draw_ir_v3_oracle_fold_bytes(hash, cmd.clip_id.to_i64(), 4)
        hash = _draw_ir_v3_oracle_fold_bytes(hash, cmd.transform_id.to_i64(), 4)
        hash = _draw_ir_v3_oracle_fold_bytes(hash, cmd.hit_shape_id.to_i64(), 4)

        i = i + 1

    val masked_hash = hash & 0x7FFFFFFFFFFFFFFFu64

    DrawIrV3OracleReport(
        total_commands: total_commands,
        rect_count: rect_count,
        text_count: text_count,
        image_count: image_count,
        path_count: path_count,
        hidden_count: hidden_count,
        hash: masked_hash
    )

# --- CountingSink -----------------------------------------------------------
fn draw_ir_v3_oracle_count(scene: DrawIrV3Scene) -> i64:
    draw_ir_v3_oracle_walk(scene).total_commands

# --- HashSink ----------------------------------------------------------------
fn draw_ir_v3_oracle_hash(scene: DrawIrV3Scene) -> u64:
    draw_ir_v3_oracle_walk(scene).hash

# --- ValidationSink ----------------------------------------------------------
# Every set (non-`DRAW_IR_V3_NO_ID`) table id on every command must be
# in-range for its corresponding side table in the SAME scene. Returns false
# on the first violation found; this is a fast fail-closed check, not a
# reporting pass (a reporting variant would be a second sink over the walker's
# report, e.g. an id-violations list on `DrawIrV3OracleReport`, and is not
# needed by any current caller).
fn draw_ir_v3_oracle_validate(scene: DrawIrV3Scene) -> bool:
    val geometry_len = scene.geometry.xs.len().to_i64()
    val paint_len = scene.paint.fill_colors.len().to_i64()
    val text_run_len = scene.text_runs.run_glyph_starts.len().to_i64()
    val resource_len = scene.resources.kinds.len().to_i64()
    val path_span_len = scene.path_points.span_point_starts.len().to_i64()
    val clip_len = scene.clips.xs.len().to_i64()
    val transform_len = scene.transforms.m11s.len().to_i64()
    val hit_shape_len = scene.hit_shapes.xs.len().to_i64()

    val commands = scene.commands
    var i: i64 = 0
    while i < commands.len().to_i64():
        val cmd = commands[i]
        if not _draw_ir_v3_oracle_id_ok(cmd.geometry_id, geometry_len):
            return false
        if not _draw_ir_v3_oracle_id_ok(cmd.paint_id, paint_len):
            return false
        if not _draw_ir_v3_oracle_id_ok(cmd.text_run_id, text_run_len):
            return false
        if not _draw_ir_v3_oracle_id_ok(cmd.image_resource_id, resource_len):
            return false
        if not _draw_ir_v3_oracle_id_ok(cmd.path_span_id, path_span_len):
            return false
        if not _draw_ir_v3_oracle_id_ok(cmd.clip_id, clip_len):
            return false
        if not _draw_ir_v3_oracle_id_ok(cmd.transform_id, transform_len):
            return false
        if not _draw_ir_v3_oracle_id_ok(cmd.hit_shape_id, hit_shape_len):
            return false
        i = i + 1
    true

# A sentinel (`DRAW_IR_V3_NO_ID`) id is always ok -- it means "absent", not a
# table reference. A set id must be a valid 0-based index (`0 <= id < len`).
fn _draw_ir_v3_oracle_id_ok(id: u32, len: i64) -> bool:
    if id == DRAW_IR_V3_NO_ID:
        return true
    val idx = id.to_i64()
    idx >= 0 and idx < len

export DrawIrV3OracleReport, draw_ir_v3_oracle_walk, draw_ir_v3_oracle_count,
    draw_ir_v3_oracle_hash, draw_ir_v3_oracle_validate
