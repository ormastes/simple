# Domain-separated identity for the exact five-input full-hybrid workload.

mod lib.common.crypto.x25519_mlkem768.raw_workload_binding

use std.common.crypto.sha256.{sha256_u8_hex}

val X25519_MLKEM768_RAW_WORKLOAD_SCHEMA: text =
    "x25519mlkem768-raw-workload-binding-v1"

fn _raw_append_text(target: [u8], value: text):
    var index: i64 = 0
    while index < value.len():
        target.push(value.char_code_at(index).to_u8())
        index = index + 1

fn _raw_append_length(target: [u8], length: i64):
    target.push(((length >> 24) & 255).to_u8())
    target.push(((length >> 16) & 255).to_u8())
    target.push(((length >> 8) & 255).to_u8())
    target.push((length & 255).to_u8())

fn _raw_append_bytes_field(
        target: [u8], label: text, values: [u8]) -> bool:
    if values.len().to_i64() != 32: return false
    _raw_append_text(target, label)
    _raw_append_length(target, values.len().to_i64())
    var index: i64 = 0
    while index < values.len().to_i64():
        target.push(values[index])
        index = index + 1
    true

fn _raw_list_bytes(values: list) -> Result<[u8], text>:
    if values.len() != 32:
        return Err("x25519mlkem768-raw-workload-invalid")
    var out: [u8] = []
    var index: i64 = 0
    while index < values.len():
        val value = values.get(index)
        if value < 0 or value > 255:
            return Err("x25519mlkem768-raw-workload-invalid")
        out.push(value.to_u8())
        index = index + 1
    Ok(out)

fn _raw_wipe(values: [u8]):
    var index: i64 = 0
    while index < values.len().to_i64():
        values[index] = 0u8
        index = index + 1

fn x25519_mlkem768_raw_workload_sha256(
        client_private: [u8], d: list, z: list,
        server_private: [u8], m: list) -> Result<text, text>:
    val d_bytes = _raw_list_bytes(d)?
    defer _raw_wipe(d_bytes)
    val z_bytes = _raw_list_bytes(z)?
    defer _raw_wipe(z_bytes)
    val m_bytes = _raw_list_bytes(m)?
    defer _raw_wipe(m_bytes)
    var material: [u8] = []
    defer _raw_wipe(material)
    _raw_append_text(material, X25519_MLKEM768_RAW_WORKLOAD_SCHEMA)
    if (not _raw_append_bytes_field(
            material, "client_private", client_private) or
            not _raw_append_bytes_field(material, "d", d_bytes) or
            not _raw_append_bytes_field(material, "z", z_bytes) or
            not _raw_append_bytes_field(
                material, "server_private", server_private) or
            not _raw_append_bytes_field(material, "m", m_bytes)):
        return Err("x25519mlkem768-raw-workload-invalid")
    Ok(sha256_u8_hex(material))

export X25519_MLKEM768_RAW_WORKLOAD_SCHEMA
export x25519_mlkem768_raw_workload_sha256

