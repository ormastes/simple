# Canonical textual SHA-256 evidence validation shared by platform contracts.

fn sha256_lower_hex_valid(value: text) -> bool:
    if value.len() != 64:
        return false
    var index: i64 = 0
    while index < value.len():
        val code = value.char_code_at(index)
        if not ((code >= 48 and code <= 57) or
                (code >= 97 and code <= 102)):
            return false
        index = index + 1
    true

export sha256_lower_hex_valid
