# Binary/bitfield format adapter for Modern SSpec typed evidence (E4 lane).
#
# This module decodes a fixed-width integer (register, PTE, capability token,
# wire header word) into `CanonicalEvidence` nodes using a declared
# `BinaryLayout`, so the same layout that drives the comparator also drives
# the manual's byte/bit table — a hand-written table can silently drift from
# the field set the oracle actually checks, and this makes that impossible.
#
# It is deliberately pure: no I/O, no rendering. Ground truth for the example
# layout is the real kernel PTE bitfield accessors in
# `src/os/kernel/types/bitfield.spl` — this module mirrors that field set, it
# does not invent one.
#
# Guide: doc/07_guide/infra/sspec_typed_evidence.md
# Research: doc/01_research/infra/sspec/modern_sspec_typed_evidence_research_2026-08-08.md

use std.common.spec.evidence.model.{
    EvidenceNode, evidence_node_at,
    CanonicalEvidence, canonical_evidence, canonical_evidence_parse_error
}

# ---------------------------------------------------------------------------
# Layout model
# ---------------------------------------------------------------------------

# `unspecified` is a distinct member, not a default some caller forgot to
# set: a layout that never states its byte/bit order describes ambiguous
# bytes, and ambiguous bytes cannot be decoded reproducibly.
pub enum ByteOrder:
    little
    big
    unspecified

pub fn byte_order_name(order: ByteOrder) -> text:
    match order:
        case ByteOrder.little: "little"
        case ByteOrder.big: "big"
        case ByteOrder.unspecified: "unspecified"

pub enum BitOrder:
    lsb0
    msb0
    unspecified

pub fn bit_order_name(order: BitOrder) -> text:
    match order:
        case BitOrder.lsb0: "lsb0"
        case BitOrder.msb0: "msb0"
        case BitOrder.unspecified: "unspecified"

# `reserved` fields are still decoded (so a nonzero reserved bit is visible
# evidence, not silently dropped) but are checked against a must-be-zero
# policy separately from ordinary field decoding.
pub struct BinaryFieldSpec:
    name: text
    lsb: i64
    width: i64
    reserved: bool
    description: text

pub fn binary_field(name: text, lsb: i64, width: i64, description: text) -> BinaryFieldSpec:
    BinaryFieldSpec(name: name, lsb: lsb, width: width, reserved: false, description: description)

pub fn reserved_field(name: text, lsb: i64, width: i64) -> BinaryFieldSpec:
    BinaryFieldSpec(name: name, lsb: lsb, width: width, reserved: true, description: "reserved")

# `source_ref` names the production file this layout mirrors, so a reviewer
# can diff the manual against ground truth instead of trusting the spec.
pub struct BinaryLayout:
    layout_id: text
    total_bits: i64
    byte_order: ByteOrder
    bit_order: BitOrder
    fields: [BinaryFieldSpec]
    source_ref: text

# ---------------------------------------------------------------------------
# Layout validity
# ---------------------------------------------------------------------------

fn fields_overlap(a: BinaryFieldSpec, b: BinaryFieldSpec) -> bool:
    not (a.lsb + a.width <= b.lsb or b.lsb + b.width <= a.lsb)

# Every rule here corresponds to a way a "decoded" table can describe bytes
# that were never actually checked: an unspecified order is ambiguous, a
# field hanging off the end of the value reads garbage, and overlapping
# fields let two rows disagree about the same bit.
pub fn layout_errors(layout: BinaryLayout) -> [text]:
    var errs: [text] = []
    if layout.byte_order == ByteOrder.unspecified:
        errs.push("byte_order is unspecified")
    if layout.bit_order == BitOrder.unspecified:
        errs.push("bit_order is unspecified")
    for field in layout.fields:
        if field.width <= 0:
            errs.push("field " + field.name + " has non-positive width")
        elif field.lsb < 0 or field.lsb + field.width > layout.total_bits:
            errs.push("field " + field.name + " exceeds total_bits")
    var i = 0
    while i < layout.fields.len():
        var j = i + 1
        while j < layout.fields.len():
            if fields_overlap(layout.fields[i], layout.fields[j]):
                errs.push("field " + layout.fields[i].name + " overlaps " + layout.fields[j].name)
            j = j + 1
        i = i + 1
    errs

pub fn layout_is_valid(layout: BinaryLayout) -> bool:
    layout_errors(layout).len() == 0

fn join_semicolons(items: [text]) -> text:
    var out = ""
    var i = 0
    while i < items.len():
        if i > 0:
            out = out + "; "
        out = out + items[i]
        i = i + 1
    out

# A reserved field that is nonzero under a must-be-zero policy is a real
# defect signal (an undocumented flag the hardware/wire actually sets), so it
# is reported by name rather than folded into a generic mismatch.
pub fn reserved_violations(value: i64, layout: BinaryLayout) -> [text]:
    var errs: [text] = []
    for field in layout.fields:
        if field.reserved:
            if field_extract(value, field.lsb, field.width) != 0:
                errs.push(field.name)
    errs

# ---------------------------------------------------------------------------
# Bit-field read/write
# ---------------------------------------------------------------------------

pub fn field_extract(value: i64, lsb: i64, width: i64) -> i64:
    val mask = (1 << width) - 1
    (value >> lsb) & mask

pub fn field_insert(value: i64, lsb: i64, width: i64, field_value: i64) -> i64:
    val mask = (1 << width) - 1
    (value & ~(mask << lsb)) | ((field_value & mask) << lsb)

# ---------------------------------------------------------------------------
# Byte / hex / binary rendering
# ---------------------------------------------------------------------------

fn hex_digit(nibble: i64) -> text:
    val digits = "0123456789abcdef"
    digits.slice(nibble, nibble + 1)

fn byte_to_hex(b: i64) -> text:
    hex_digit((b >> 4) & 0xF) + hex_digit(b & 0xF)

fn byte_to_binary(b: i64) -> text:
    var out = ""
    var bit = 7
    while bit >= 0:
        if (b >> bit) & 1 != 0:
            out = out + "1"
        else:
            out = out + "0"
        bit = bit - 1
    out

pub fn u64_to_le_bytes(value: i64) -> [i64]:
    var out: [i64] = []
    var i = 0
    while i < 8:
        out.push((value >> (8 * i)) & 0xFF)
        i = i + 1
    out

pub fn bytes_hex(bytes: [i64]) -> text:
    var out = ""
    var i = 0
    while i < bytes.len():
        if i > 0:
            out = out + " "
        out = out + byte_to_hex(bytes[i])
        i = i + 1
    out

# Grouped by byte, most-significant byte first, so the string reads in the
# same order a human writes a hex literal.
pub fn u64_binary_grouped(value: i64) -> text:
    var out = "0b"
    var i = 7
    while i >= 0:
        if i < 7:
            out = out + "_"
        out = out + byte_to_binary((value >> (8 * i)) & 0xFF)
        i = i - 1
    out

# ---------------------------------------------------------------------------
# Decode to CanonicalEvidence
# ---------------------------------------------------------------------------

# The comparator target: one node per field plus two order/endianness nodes,
# all derived from `field_extract`, so a decoded value and the manual table
# below can never disagree about how a field was read.
pub fn decode_u64(value: i64, layout: BinaryLayout) -> CanonicalEvidence:
    val errs = layout_errors(layout)
    if errs.len() > 0:
        return canonical_evidence_parse_error("binary_layout", layout.layout_id, join_semicolons(errs))
    var nodes: [EvidenceNode] = []
    var order = 0
    nodes.push(evidence_node_at("byte_order", byte_order_name(layout.byte_order), order))
    order = order + 1
    nodes.push(evidence_node_at("bit_order", bit_order_name(layout.bit_order), order))
    order = order + 1
    for field in layout.fields:
        val fv = field_extract(value, field.lsb, field.width)
        nodes.push(evidence_node_at(field.name, "{fv}", order))
        order = order + 1
    canonical_evidence("binary_layout", layout.layout_id, nodes)

# ---------------------------------------------------------------------------
# Manual table
# ---------------------------------------------------------------------------

# Rows generated FROM the same layout the comparator decodes against, never
# hand-written: offset | bytes | bits | field | raw hex | decoded.
# Renders `fv` as exactly ceil(width/8) bytes of hex, most-significant byte
# first. `byte_to_hex(fv & 0xFF)` truncates any field wider than one byte to
# its low byte — a 40-bit physical-address field would table as its last two
# hex digits while decoding correctly, so the generated table would disagree
# with the very evidence it was generated from.
fn field_value_hex(fv: i64, width: i64) -> text:
    var nbytes = (width + 7) / 8
    if nbytes < 1:
        nbytes = 1
    var out = ""
    var i = nbytes - 1
    while i >= 0:
        out = out + byte_to_hex((fv >> (8 * i)) & 0xFF)
        i = i - 1
    out

pub fn binary_field_table(value: i64, layout: BinaryLayout) -> [text]:
    var rows: [text] = []
    rows.push("Offset | Bytes | Bits | Field | Raw (hex) | Decoded")
    for field in layout.fields:
        val fv = field_extract(value, field.lsb, field.width)
        val hi = field.lsb + field.width - 1
        val offset_byte = field.lsb / 8
        val hex_value = field_value_hex(fv, field.width)
        val decoded = if field.width == 1: (if fv != 0: "true" else: "false") else: "{fv}"
        rows.push(
            "{offset_byte}" + " | " + hex_value + " | "
            + "{hi}" + ":" + "{field.lsb}" + " | " + field.name + " | "
            + hex_value + " | " + decoded
        )
    rows

# ---------------------------------------------------------------------------
# Example layout: x86_64 PTE (ground truth: src/os/kernel/types/bitfield.spl)
# ---------------------------------------------------------------------------

# Mirrors the real kernel PTE field set (present/writable/user/phys_addr/
# no_execute) plus the two reserved bit ranges the kernel accessors leave
# untouched, so the layout covers all 64 bits without inventing new fields.
pub fn pte_layout() -> BinaryLayout:
    BinaryLayout(
        layout_id: "x86_64_pte",
        total_bits: 64,
        byte_order: ByteOrder.little,
        bit_order: BitOrder.lsb0,
        fields: [
            binary_field("present", 0, 1, "Present (P)"),
            binary_field("writable", 1, 1, "Read/Write (RW)"),
            binary_field("user", 2, 1, "User/Supervisor (US)"),
            reserved_field("reserved_low", 3, 9),
            binary_field("phys_addr", 12, 40, "Physical address (4K-aligned)"),
            reserved_field("reserved_high", 52, 11),
            binary_field("no_execute", 63, 1, "No Execute (NX)")
        ],
        source_ref: "src/os/kernel/types/bitfield.spl"
    )

# ---------------------------------------------------------------------------
# Mask-aware comparator (binary SSpec core)
#
# Canonical rule: delta = (actual XOR effective_expected) AND compare_mask.
# Two semantic invariants (design:
# doc/05_design/infra/sspec/binary_reference_stacked_design.md):
#   1. "ignored" means compare_mask contributed 0 bits under the current
#      context — the value is captured but cannot fail the assertion.
#   2. Reserved is NOT ignored: reserved fields are actively checked against
#      their fixed value (zero here, matching `reserved_violations` above),
#      regardless of what the caller passed as `expected` in that range.
# ---------------------------------------------------------------------------

# Per-field comparison policy. `policy` is one of:
#   "exact"          compare all field bits
#   "dont_care"      contribute no bits to compare_mask
#   "reserved_zero"  compare all field bits against 0
#   "reserved_one"   compare all field bits against all-ones
#   "masked"         compare only the bits set in `mask` (field-relative)
pub struct ComparePolicy:
    field: text
    policy: text
    mask: i64

pub fn policy_exact(field: text) -> ComparePolicy:
    ComparePolicy(field: field, policy: "exact", mask: 0)

pub fn policy_dont_care(field: text) -> ComparePolicy:
    ComparePolicy(field: field, policy: "dont_care", mask: 0)

pub fn policy_masked(field: text, mask: i64) -> ComparePolicy:
    ComparePolicy(field: field, policy: "masked", mask: mask)

pub struct WordDiff:
    expected: i64
    actual: i64
    compare_mask: i64
    delta: i64
    status: text          # "pass" | "fail" | "ignored"
    failing_fields: [text]

fn _policy_for(field_name: text, policies: [ComparePolicy]) -> text:
    for p in policies:
        if p.field == field_name:
            return p.policy
    "exact"

fn _mask_for(field_name: text, policies: [ComparePolicy]) -> i64:
    for p in policies:
        if p.field == field_name:
            return p.mask
    0

# Compare one word of `layout` under per-field `policies`. A field with no
# entry in `policies` defaults to "exact"; a layout field flagged `reserved`
# is ALWAYS checked as reserved_zero, overriding any dont_care request —
# a reserved bit flipping must be able to fail the assertion.
pub fn compare_word(expected: i64, actual: i64, layout: BinaryLayout, policies: [ComparePolicy]) -> WordDiff:
    var compare_mask: i64 = 0
    var effective_expected = expected
    for field in layout.fields:
        val field_bits = ((1 << field.width) - 1) << field.lsb
        var pol = _policy_for(field.name, policies)
        if field.reserved:
            pol = "reserved_zero"
        if pol == "dont_care":
            continue
        if pol == "masked":
            compare_mask = compare_mask | ((_mask_for(field.name, policies) << field.lsb) & field_bits)
        else:
            compare_mask = compare_mask | field_bits
        if pol == "reserved_zero":
            effective_expected = effective_expected & ~field_bits
        if pol == "reserved_one":
            effective_expected = effective_expected | field_bits
    val delta = (actual ^ effective_expected) & compare_mask
    var failing: [text] = []
    for field in layout.fields:
        val field_bits = ((1 << field.width) - 1) << field.lsb
        if (delta & field_bits) != 0:
            failing.push(field.name)
    val status = if compare_mask == 0: "ignored" else: (if delta == 0: "pass" else: "fail")
    WordDiff(
        expected: expected,
        actual: actual,
        compare_mask: compare_mask,
        delta: delta,
        status: status,
        failing_fields: failing,
    )

# One compact expected/actual line for the stacked view, e.g.
#   "CDW12 expected 0x0000000055200007 actual 0x0000000054200007 FAIL [stc]"
pub fn render_word_line(label: text, d: WordDiff) -> text:
    val mark = if d.status == "pass": "ok" else: (if d.status == "ignored": "~ don't care" else: "FAIL")
    var line = label + " expected 0x" + bytes_hex(u64_to_le_bytes(d.expected))
    line = line + " actual 0x" + bytes_hex(u64_to_le_bytes(d.actual)) + " " + mark
    if d.status == "fail":
        var names = ""
        for n in d.failing_fields:
            names = if names == "": n else: names + "," + n
        line = line + " [" + names + "]"
    line

# ---------------------------------------------------------------------------
# Stacked multi-word figure (the default reference view of the binary SSpec
# design: doc/05_design/infra/sspec/binary_reference_stacked_design.md).
# Renders words as rows (word_label + index), one line per word; a word whose
# WordDiff failed expands to a bit-level row pair with the failing fields
# named. Pure text projection — evidence stays in WordDiff.
# ---------------------------------------------------------------------------

fn _bin_group(value: i64, bits: i64) -> text:
    var out = ""
    var i = bits - 1
    while i >= 0:
        out = out + (if ((value >> i) & 1) != 0: "1" else: "0")
        if i > 0 and i % 8 == 0:
            out = out + "_"
        i = i - 1
    out

# One reference row per word value: "CDW10  0x00123400"
pub fn stacked_rows(values: [i64], word_label: text, first_word: i64) -> [text]:
    var rows: [text] = []
    var i = 0
    while i < values.len():
        val idx = first_word + i
        rows.push(word_label + "{idx}  0x" + bytes_hex(u64_to_le_bytes(values[i])))
        i = i + 1
    rows

# Same stacked reference words as `stacked_rows`, but rendered as a genuine
# Markdown pipe table (`| Word | Value (hex) | Binary |`) instead of plain
# reference lines — for callers that need the stacked word figure to survive
# as `| col | col |` syntax in a generated manual, not just terminal text.
# Additive sibling of `stacked_rows`; does not change its output.
# Same stacked reference words as `stacked_md_table`, but as RAW " | "-joined
# rows (header first, no leading/trailing pipe, no separator row) — the
# convention `manual_render.render_pipe_table` expects as input, so a caller
# building a `ManualBlock`/evidence-sidecar entry gets correct table syntax
# after that renderer wraps it, instead of double-wrapped/double-escaped
# pipes from feeding it `stacked_md_table`'s already-rendered output.
pub fn stacked_manual_rows(values: [i64], word_label: text, first_word: i64) -> [text]:
    var rows: [text] = []
    rows.push("Word | Value (hex) | Binary")
    var i = 0
    while i < values.len():
        val idx = first_word + i
        rows.push(
            word_label + "{idx}" + " | 0x" + bytes_hex(u64_to_le_bytes(values[i]))
            + " | " + u64_binary_grouped(values[i])
        )
        i = i + 1
    rows

pub fn stacked_md_table(values: [i64], word_label: text, first_word: i64) -> [text]:
    var rows: [text] = []
    rows.push("| Word | Value (hex) | Binary |")
    rows.push("| --- | --- | --- |")
    var i = 0
    while i < values.len():
        val idx = first_word + i
        rows.push(
            "| " + word_label + "{idx}" + " | 0x" + bytes_hex(u64_to_le_bytes(values[i]))
            + " | " + u64_binary_grouped(values[i]) + " |"
        )
        i = i + 1
    rows

# Expected/actual stacked comparison: compact per-word line; a failing word
# adds expected/actual bit rows (16-bit groups) and the failing field names.
pub fn stacked_compare_rows(diffs: [WordDiff], layout: BinaryLayout, word_label: text, first_word: i64) -> [text]:
    var rows: [text] = []
    var i = 0
    while i < diffs.len():
        val d = diffs[i]
        val idx = first_word + i
        rows.push(render_word_line(word_label + "{idx}", d))
        if d.status == "fail":
            rows.push("  expected  " + _bin_group(d.expected, layout.total_bits))
            rows.push("  actual    " + _bin_group(d.actual, layout.total_bits))
            var names = ""
            for n in d.failing_fields:
                names = if names == "": n else: names + ", " + n
            rows.push("  ^ FAIL in: " + names)
        i = i + 1
    rows
