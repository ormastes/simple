#![allow(primitive_api)]
# Counterpart -> Modern SSpec canonical evidence projection (Lane F8).
#
# primitive_api is allowed here for the same reason as the sibling frozen
# contract module: the values projected here (counts, boolean receipt flags)
# are the on-the-wire evidence types themselves, and every one of them is
# rendered straight into a text evidence node.
#
# Pure projection only: a `CounterpartRun` in, a `CanonicalEvidence` out. No
# acquisition, no IO, no Markdown. The emitted paths are the normative list in
# doc/05_design/infra/counterpart/counterpart_conformance_infrastructure_design_2026-08-09.md
# section 13, so an ordinary `check_exact("counterpart.comparisons.failed", "0")`
# oracle works against a counterpart run with no new scenario language.
#
# Fail-closed rule that governs this whole module: a run that fails the frozen
# vacuity gate (`counterpart_run_vacuity_failures`) or that carries plan/loader
# rejections projects as a PARSE-ERROR evidence, never as a clean node set. An
# empty-but-well-formed node set would satisfy a subset oracle and read as a
# pass, which is the precise failure the gate exists to prevent.

use std.common.spec.evidence.model.{
    CanonicalEvidence, EvidenceNode, evidence_node, canonical_evidence,
    canonical_evidence_parse_error
}
use std.common.spec.evidence.counterpart.model.{
    CounterpartRun, SourceResult, ComparisonCell, ProviderManifest,
    ConversionReceipt, ExecutionReceipt, LogicalArtifact,
    ProviderStatus, logical_artifact_is_vacuous,
    provider_status_name, relation_name, conversion_loss_name,
    execution_mode_name, counterpart_run_sources_executed,
    counterpart_run_sources_unavailable, counterpart_run_comparisons_failed,
    counterpart_run_vacuity_failures
}

# NOTE ON ORDERING: the file-header `@allow(...)` attribute must be followed by
# a fn/struct/enum, never by a `pub val` — the engine's parser rejects
# "pub with attributes ... found Val" (see the bug record for
# `@allow` + `pub val`). Hence the helper below precedes the constant.
fn bool_text(value: bool) -> text:
    if value:
        return "true"
    "false"

pub val COUNTERPART_EVIDENCE_KIND: text = "counterpart"

fn join_reasons(reasons: [text]) -> text:
    var out = ""
    var first = true
    for reason in reasons:
        if first:
            out = reason
            first = false
        else:
            out = out + "; " + reason
    out

# The provider manifest is the only place `version` and `artifact_hash` are
# recorded. When no manifest is supplied for a provider those two nodes are
# OMITTED rather than filled with a placeholder: an omitted node makes an
# oracle check resolve zero nodes and fail closed, whereas "unknown" would be a
# fabricated value that a closed oracle could be written to accept.
fn push_source_nodes(
    nodes: [EvidenceNode],
    source: SourceResult,
    manifests: [ProviderManifest]
) -> [EvidenceNode]:
    var out = nodes
    val base = "counterpart.provider." + source.provider_id + "."
    out.push(evidence_node(base + "status", provider_status_name(source.status)))
    out.push(evidence_node(base + "independence_group", source.independence_group))
    for manifest in manifests:
        if manifest.provider_id == source.provider_id:
            out.push(evidence_node(base + "version", manifest.version))
            out.push(evidence_node(base + "artifact_hash", manifest.artifact_hash))
    out

fn push_conversion_nodes(nodes: [EvidenceNode], conversions: [ConversionReceipt]) -> [EvidenceNode]:
    var out = nodes
    for receipt in conversions:
        val base = "counterpart.converter." + receipt.converter_id + "."
        out.push(evidence_node(base + "loss_class", conversion_loss_name(receipt.loss)))
        out.push(evidence_node(base + "input_hash", receipt.input_hash))
        out.push(evidence_node(base + "output_hash", receipt.output_hash))
    out

fn push_execution_nodes(nodes: [EvidenceNode], receipt: ExecutionReceipt) -> [EvidenceNode]:
    var out = nodes
    val base = "counterpart.execution." + receipt.provider_id + "."
    out.push(evidence_node(base + "mode", execution_mode_name(receipt.execution_mode)))
    out.push(evidence_node(base + "submission_count", "{receipt.submission_count}"))
    out.push(evidence_node(base + "fence_completed", bool_text(receipt.fence_completed)))
    out.push(evidence_node(base + "device_origin_readback", bool_text(receipt.device_origin_readback)))
    out.push(evidence_node(base + "fallback_used", bool_text(receipt.fallback_used)))
    out

fn push_matrix_nodes(nodes: [EvidenceNode], cell: ComparisonCell) -> [EvidenceNode]:
    var out = nodes
    val base = "counterpart.matrix." + cell.left_source_id + "." + cell.right_source_id + "."
    out.push(evidence_node(base + "relation", relation_name(cell.relation)))
    out.push(evidence_node(base + "matched", bool_text(cell.matched)))
    out.push(evidence_node(base + "mismatch_count", "{cell.mismatch_count}"))
    out

# Reasons a run may not be projected as clean evidence. Kept separate from the
# projection itself so a caller (and the spec) can assert the exact reason set
# rather than only observing that projection failed.
#
# These are the STRUCTURAL clauses of the frozen vacuity gate: nothing ran,
# nothing was compared, or everything that ran shares one upstream. The gate's
# remaining clause — "this individual source did not execute" — is deliberately
# NOT a projection blocker, because it is projected as DATA
# (`counterpart.provider.<id>.status` and `counterpart.providers.unavailable`),
# which is what makes the design's
# `check_exact("counterpart.providers.unavailable", "0")` oracle meaningful. An
# unavailable provider therefore always shows up as `unavailable`; it is never
# absorbed into a pass, and it can never be the reason a projection looks clean.
# Whether a specific missing provider is fatal is a PLAN question
# (`PlanSource.required`), and the run alone does not carry it — see
# `strict_vacuity_failures` below for the full frozen gate.
pub fn projection_blockers(run: CounterpartRun) -> [text]:
    var blockers: [text] = []
    for rejection in run.rejections:
        blockers.push("rejection: " + rejection)
    if run.sources.len() == 0:
        blockers.push("vacuity: run executed zero sources")
    if run.matrix.len() == 0:
        blockers.push("vacuity: run performed zero comparisons")
    var executed_groups: [text] = []
    var executed = 0
    for source in run.sources:
        match source.status:
            case ProviderStatus.executed:
                executed = executed + 1
                if logical_artifact_is_vacuous(source.artifact):
                    blockers.push("vacuity: source " + source.source_id
                        + " produced a vacuous artifact")
                var seen = false
                for group in executed_groups:
                    if group == source.independence_group:
                        seen = true
                if not seen and source.independence_group != "":
                    executed_groups.push(source.independence_group)
            case _:
                pass
    if executed < 2:
        blockers.push("vacuity: fewer than two sources executed: nothing was differentially compared")
    if executed_groups.len() < 2:
        blockers.push("vacuity: all executed sources share one independence group")
    blockers

# The frozen gate verbatim, including the per-source status clause. A lane that
# knows its plan marked every source `required` should assert on THIS, not on
# `projection_blockers`.
pub fn strict_vacuity_failures(run: CounterpartRun) -> [text]:
    counterpart_run_vacuity_failures(run)

pub fn counterpart_run_to_evidence(run: CounterpartRun) -> CanonicalEvidence:
    counterpart_run_to_evidence_with_manifests(run, [])

pub fn counterpart_run_to_evidence_with_manifests(
    run: CounterpartRun,
    manifests: [ProviderManifest]
) -> CanonicalEvidence:
    val blockers = projection_blockers(run)
    if blockers.len() > 0:
        return canonical_evidence_parse_error(
            COUNTERPART_EVIDENCE_KIND,
            run.plan_id,
            join_reasons(blockers)
        )

    var nodes: [EvidenceNode] = []
    nodes.push(evidence_node("counterpart.plan.id", run.plan_id))
    nodes.push(evidence_node("counterpart.boundary.id", run.boundary_id))
    nodes.push(evidence_node("counterpart.providers.requested", "{run.sources.len()}"))
    nodes.push(evidence_node(
        "counterpart.providers.executed",
        "{counterpart_run_sources_executed(run)}"
    ))
    nodes.push(evidence_node(
        "counterpart.providers.unavailable",
        "{counterpart_run_sources_unavailable(run)}"
    ))
    nodes.push(evidence_node("counterpart.comparisons.executed", "{run.matrix.len()}"))
    nodes.push(evidence_node(
        "counterpart.comparisons.failed",
        "{counterpart_run_comparisons_failed(run)}"
    ))

    for source in run.sources:
        nodes = push_source_nodes(nodes, source, manifests)
        nodes = push_conversion_nodes(nodes, source.conversions)
        nodes = push_execution_nodes(nodes, source.execution)

    for cell in run.matrix:
        nodes = push_matrix_nodes(nodes, cell)

    canonical_evidence(COUNTERPART_EVIDENCE_KIND, run.plan_id, nodes)
