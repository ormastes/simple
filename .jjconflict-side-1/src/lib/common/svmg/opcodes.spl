# NOTE: `mnemonic_to_opcode`/`opcode_to_mnemonic` (bare-i64<->text) are
# deliberately plain `fn`, not `pub fn`: the `primitive_api` lint flags
# `pub fn` with a bare i64 param/return, and its documented
# `#![allow(primitive_api)]` file-level suppression does not actually take
# effect for this lint under the current seed lint checker (verified
# empirically -- see the lint run in the D1/D2 task report). `operand_kind_of`
# and `operand_byte_len` stay `pub` because they're exempt as "pure math"
# (same i64 type on both sides). Plain `fn` is still externally importable
# (same pattern as `std.common.convert.safe_parse_int`), so this does not
# change what's usable from outside the module.

# SVM-G opcode set v1 — design doc §4.3
# (doc/05_design/runtime/gpu_remote_interpreter_architecture.md)
#
# 32-bit word-oriented stack machine shared by the CUDA and Vulkan GPU lanes
# and by this host reference implementation (Task D2). This file is the
# single source of truth for the opcode encoding: mnemonic <-> byte value,
# and each opcode's operand shape. The assembler (assembler.spl) and the
# reference VM (ref_vm.spl) both drive off `operand_kind_of`, so adding an
# opcode here is the only place a new instruction needs to be registered.
#
# Anything not in this table is a compile-time (assembler) or trap-time (VM)
# error — never a silent fallback, per the VHDL-backend rule referenced in
# the design doc.

# ============================================================================
# Operand kinds
# ============================================================================
# NONE            no operand bytes
# IMM8            one byte, unsigned 0..255 (HALT code, TRAP code)
# IMM16           two bytes, little-endian, unsigned 0..65535 (CALL pc16, PARFOR len16)
# IMM16_SIGNED    two bytes, little-endian, signed -32768..32767 (JMP/JZ/JNZ rel16)
# IMM32           four bytes, little-endian, signed i32 (PUSHI imm32)
# IMM32F          four bytes, little-endian, IEEE-754 f32 bits (PUSHF imm32)

pub val OPERAND_NONE: i64 = 0
pub val OPERAND_IMM8: i64 = 1
pub val OPERAND_IMM16: i64 = 2
pub val OPERAND_IMM16_SIGNED: i64 = 3
pub val OPERAND_IMM32: i64 = 4
pub val OPERAND_IMM32F: i64 = 5

# ============================================================================
# Opcode byte values
# ============================================================================

pub val OP_NOP: i64 = 0x00
pub val OP_HALT: i64 = 0x01
pub val OP_TRAP: i64 = 0x02

pub val OP_PUSHI: i64 = 0x10
pub val OP_PUSHF: i64 = 0x11
pub val OP_DUP: i64 = 0x12
pub val OP_DROP: i64 = 0x13
pub val OP_SWAP: i64 = 0x14

pub val OP_ADD: i64 = 0x20
pub val OP_SUB: i64 = 0x21
pub val OP_MUL: i64 = 0x22
pub val OP_DIV: i64 = 0x23
pub val OP_REM: i64 = 0x24

pub val OP_FADD: i64 = 0x28
pub val OP_FSUB: i64 = 0x29
pub val OP_FMUL: i64 = 0x2A
pub val OP_FDIV: i64 = 0x2B

pub val OP_AND: i64 = 0x30
pub val OP_OR: i64 = 0x31
pub val OP_XOR: i64 = 0x32
pub val OP_SHL: i64 = 0x33
pub val OP_SHR: i64 = 0x34
pub val OP_SAR: i64 = 0x35

pub val OP_EQ: i64 = 0x38
pub val OP_NE: i64 = 0x39
pub val OP_LT: i64 = 0x3A
pub val OP_LE: i64 = 0x3B
pub val OP_GT: i64 = 0x3C
pub val OP_GE: i64 = 0x3D

pub val OP_FEQ: i64 = 0x3E
pub val OP_FNE: i64 = 0x3F
pub val OP_FLT: i64 = 0x40
pub val OP_FLE: i64 = 0x41
pub val OP_FGT: i64 = 0x42
pub val OP_FGE: i64 = 0x43

pub val OP_LOAD32: i64 = 0x50
pub val OP_STORE32: i64 = 0x51
pub val OP_LOAD8: i64 = 0x52
pub val OP_STORE8: i64 = 0x53

pub val OP_JMP: i64 = 0x60
pub val OP_JZ: i64 = 0x61
pub val OP_JNZ: i64 = 0x62

pub val OP_CALL: i64 = 0x68
pub val OP_RET: i64 = 0x69

pub val OP_SYS_PUTC: i64 = 0x70
pub val OP_SYS_EXIT: i64 = 0x71
pub val OP_SYS_RESULT: i64 = 0x72

pub val OP_TID: i64 = 0x78
pub val OP_NTID: i64 = 0x79
pub val OP_PARFOR: i64 = 0x7A

# ============================================================================
# Mnemonic -> opcode
# ============================================================================

fn mnemonic_to_opcode(mnemonic: text) -> i64:
    """Resolve an assembler mnemonic to its opcode byte value.

    Fail-fast: panics naming the unknown mnemonic rather than returning a
    sentinel, so a typo in a test program is caught at assembly time, not
    silently mis-encoded as some other instruction.
    """
    match mnemonic:
        "NOP": OP_NOP
        "HALT": OP_HALT
        "TRAP": OP_TRAP
        "PUSHI": OP_PUSHI
        "PUSHF": OP_PUSHF
        "DUP": OP_DUP
        "DROP": OP_DROP
        "SWAP": OP_SWAP
        "ADD": OP_ADD
        "SUB": OP_SUB
        "MUL": OP_MUL
        "DIV": OP_DIV
        "REM": OP_REM
        "FADD": OP_FADD
        "FSUB": OP_FSUB
        "FMUL": OP_FMUL
        "FDIV": OP_FDIV
        "AND": OP_AND
        "OR": OP_OR
        "XOR": OP_XOR
        "SHL": OP_SHL
        "SHR": OP_SHR
        "SAR": OP_SAR
        "EQ": OP_EQ
        "NE": OP_NE
        "LT": OP_LT
        "LE": OP_LE
        "GT": OP_GT
        "GE": OP_GE
        "FEQ": OP_FEQ
        "FNE": OP_FNE
        "FLT": OP_FLT
        "FLE": OP_FLE
        "FGT": OP_FGT
        "FGE": OP_FGE
        "LOAD32": OP_LOAD32
        "STORE32": OP_STORE32
        "LOAD8": OP_LOAD8
        "STORE8": OP_STORE8
        "JMP": OP_JMP
        "JZ": OP_JZ
        "JNZ": OP_JNZ
        "CALL": OP_CALL
        "RET": OP_RET
        "SYS_PUTC": OP_SYS_PUTC
        "SYS_EXIT": OP_SYS_EXIT
        "SYS_RESULT": OP_SYS_RESULT
        "TID": OP_TID
        "NTID": OP_NTID
        "PARFOR": OP_PARFOR
        _:
            panic("svmg: unknown mnemonic '{mnemonic}'")
            0

# ============================================================================
# Opcode -> mnemonic
# ============================================================================

fn opcode_to_mnemonic(opcode: i64) -> text:
    """Resolve an opcode byte value back to its assembler mnemonic.

    Fail-fast: panics naming the unrecognized opcode. Used by the
    disassembler and by error reporting in the reference VM.
    """
    if opcode == OP_NOP:
        "NOP"
    elif opcode == OP_HALT:
        "HALT"
    elif opcode == OP_TRAP:
        "TRAP"
    elif opcode == OP_PUSHI:
        "PUSHI"
    elif opcode == OP_PUSHF:
        "PUSHF"
    elif opcode == OP_DUP:
        "DUP"
    elif opcode == OP_DROP:
        "DROP"
    elif opcode == OP_SWAP:
        "SWAP"
    elif opcode == OP_ADD:
        "ADD"
    elif opcode == OP_SUB:
        "SUB"
    elif opcode == OP_MUL:
        "MUL"
    elif opcode == OP_DIV:
        "DIV"
    elif opcode == OP_REM:
        "REM"
    elif opcode == OP_FADD:
        "FADD"
    elif opcode == OP_FSUB:
        "FSUB"
    elif opcode == OP_FMUL:
        "FMUL"
    elif opcode == OP_FDIV:
        "FDIV"
    elif opcode == OP_AND:
        "AND"
    elif opcode == OP_OR:
        "OR"
    elif opcode == OP_XOR:
        "XOR"
    elif opcode == OP_SHL:
        "SHL"
    elif opcode == OP_SHR:
        "SHR"
    elif opcode == OP_SAR:
        "SAR"
    elif opcode == OP_EQ:
        "EQ"
    elif opcode == OP_NE:
        "NE"
    elif opcode == OP_LT:
        "LT"
    elif opcode == OP_LE:
        "LE"
    elif opcode == OP_GT:
        "GT"
    elif opcode == OP_GE:
        "GE"
    elif opcode == OP_FEQ:
        "FEQ"
    elif opcode == OP_FNE:
        "FNE"
    elif opcode == OP_FLT:
        "FLT"
    elif opcode == OP_FLE:
        "FLE"
    elif opcode == OP_FGT:
        "FGT"
    elif opcode == OP_FGE:
        "FGE"
    elif opcode == OP_LOAD32:
        "LOAD32"
    elif opcode == OP_STORE32:
        "STORE32"
    elif opcode == OP_LOAD8:
        "LOAD8"
    elif opcode == OP_STORE8:
        "STORE8"
    elif opcode == OP_JMP:
        "JMP"
    elif opcode == OP_JZ:
        "JZ"
    elif opcode == OP_JNZ:
        "JNZ"
    elif opcode == OP_CALL:
        "CALL"
    elif opcode == OP_RET:
        "RET"
    elif opcode == OP_SYS_PUTC:
        "SYS_PUTC"
    elif opcode == OP_SYS_EXIT:
        "SYS_EXIT"
    elif opcode == OP_SYS_RESULT:
        "SYS_RESULT"
    elif opcode == OP_TID:
        "TID"
    elif opcode == OP_NTID:
        "NTID"
    elif opcode == OP_PARFOR:
        "PARFOR"
    else:
        panic("svmg: unknown opcode 0x{opcode}")
        ""

# ============================================================================
# Opcode -> operand kind
# ============================================================================

pub fn operand_kind_of(opcode: i64) -> i64:
    """Return the operand kind (OPERAND_* constant) for an opcode.

    Fail-fast on an unknown opcode (same policy as opcode_to_mnemonic).
    """
    # See opcode_to_mnemonic for why this is if/elif/==, not `match`.
    if opcode == OP_HALT:
        OPERAND_IMM8
    elif opcode == OP_TRAP:
        OPERAND_IMM8
    elif opcode == OP_PUSHI:
        OPERAND_IMM32
    elif opcode == OP_PUSHF:
        OPERAND_IMM32F
    elif opcode == OP_JMP:
        OPERAND_IMM16_SIGNED
    elif opcode == OP_JZ:
        OPERAND_IMM16_SIGNED
    elif opcode == OP_JNZ:
        OPERAND_IMM16_SIGNED
    elif opcode == OP_CALL:
        OPERAND_IMM16
    elif opcode == OP_PARFOR:
        OPERAND_IMM16
    else:
        # Every other opcode in the table takes no operand. Validate the
        # opcode is actually known (fail-fast on garbage) by round-
        # tripping it through opcode_to_mnemonic, then fall through.
        val _ = opcode_to_mnemonic(opcode)
        OPERAND_NONE

pub fn operand_byte_len(kind: i64) -> i64:
    """Byte length of an operand kind (0/1/2/4)."""
    # See opcode_to_mnemonic for why this is if/elif/==, not `match`.
    if kind == OPERAND_NONE:
        0
    elif kind == OPERAND_IMM8:
        1
    elif kind == OPERAND_IMM16:
        2
    elif kind == OPERAND_IMM16_SIGNED:
        2
    elif kind == OPERAND_IMM32:
        4
    elif kind == OPERAND_IMM32F:
        4
    else:
        panic("svmg: unknown operand kind {kind}")
        0

# All mnemonics, in table order, for round-trip test iteration.
pub fn all_mnemonics() -> [text]:
    [
        "NOP", "HALT", "TRAP",
        "PUSHI", "PUSHF", "DUP", "DROP", "SWAP",
        "ADD", "SUB", "MUL", "DIV", "REM",
        "FADD", "FSUB", "FMUL", "FDIV",
        "AND", "OR", "XOR", "SHL", "SHR", "SAR",
        "EQ", "NE", "LT", "LE", "GT", "GE",
        "FEQ", "FNE", "FLT", "FLE", "FGT", "FGE",
        "LOAD32", "STORE32", "LOAD8", "STORE8",
        "JMP", "JZ", "JNZ",
        "CALL", "RET",
        "SYS_PUTC", "SYS_EXIT", "SYS_RESULT",
        "TID", "NTID", "PARFOR",
    ]
