# ============================================================================
# common/structural/mutation/mutation_contracts.spl — FROZEN MutationIR
# contract v1 (enums, sets, phase and conflict vocabulary)
#
# Architecture: doc/04_architecture/compiler/mdsoc/
#   mdsoc_plus_tagged_structural_compute_architecture.md §8 (MutationIR and
#   transactional transformation), §26 (contract freeze), §27 (MUTATE lane owns
#   structural/mutation), §30.5 (MutationIR verification obligations).
#
# Wave 0f of the contract-freeze phase. Freezes artifact group 5 of §26:
# "MutationIR and conflict order".
#
# Conventions are inherited unchanged from the ID-TAG lane (wave 0a), the MAP
# lane (wave 0b), the QUERY lane (wave 0c) and the receipts lane: all integers
# little-endian, fixed width, no padding, no alignment; every enum is a u8
# discriminant; every top-level record carries the 8-byte wire envelope; an
# unknown enum discriminant or a set reserved bit is a HARD REJECT, never a
# silent default. See common/structural/wire.spl and
# doc/05_design/platform/structural_compute/identity_tagmap_contract_v1.md.
#
# NOT REDECLARED HERE, imported instead:
#   EntityKey / ArtifactId / SnapshotId / Hash128  — ID-TAG lane
#                                                   (structural/identity)
#   MappingKind                                    — MAP lane
#   DirtyMask                                      — INVALIDATE lane owns the
#                                                    bit vocabulary; §8.3's
#                                                    `invalidates` is carried
#                                                    here as an opaque u32 SLOT
#                                                    only (see below).
#
# DELIBERATELY RENAMED to avoid colliding with an unrelated existing type —
# two declarations of one name is how lanes silently diverge:
#   §8.3 `EffectSummary`   -> `MutationEffect`
#        (`EffectSummary` is already taken by the compiler optimizer contract,
#         compiler/00.common/structural_contracts/optimizer.spl:12)
#   §8.5 `MutationReceipt` -> `MutationCommitReceipt`
#        (`MutationReceipt` is already taken by the compiler port contract,
#         compiler/00.common/structural_contracts/ports.spl:49, which is a
#         text-digest projection and not a wire record)
#
# FROZEN: enum discriminants are wire values. A discriminant is never reused and
# never renumbered; new variants take the next free number.
# ============================================================================

val MUTATION_SCHEMA_VERSION: i64 = 1

# ----------------------------------------------------------------------------
# MutationKind (§8.2) — fully enumerated by the architecture; frozen as given,
# in declaration order, starting at 0.
#
# The LINK lane already froze `LinkMutationKind` (structural/resolve/
# resolve_types.spl) as "LINK's projection of the MutationIR kinds it emits".
# That projection is a SEPARATE, lane-local numbering (0..2) and is deliberately
# NOT the same integer space as this enum; a projection maps into this space by
# name, never by reusing its discriminant.
# ----------------------------------------------------------------------------

enum MutationKind:
    AddTag
    RemoveTag
    ReplaceSourceRange
    InsertSourceBefore
    InsertSourceAfter
    ReplaceSyntaxNode
    InsertSyntaxChild
    DeleteSyntaxNode
    ReplaceHirNode
    ReplaceMirInstruction
    InsertMirBefore
    InsertMirAfter
    SplitBasicBlock
    ReplaceLlvmInstruction
    InsertDomChild
    RemoveDomSubtree
    MoveDomSubtree
    SetDomAttribute
    ReplaceDomText
    InsertCssRule
    ReplaceCssRule
    DeleteCssRule
    ReplaceDeclaration
    ReplaceLinkDefinition
    AddRelocation
    ChangePlacementHint

fn mutation_kind_to_u8(k: MutationKind) -> i64:
    match k:
        case MutationKind.AddTag: 0
        case MutationKind.RemoveTag: 1
        case MutationKind.ReplaceSourceRange: 2
        case MutationKind.InsertSourceBefore: 3
        case MutationKind.InsertSourceAfter: 4
        case MutationKind.ReplaceSyntaxNode: 5
        case MutationKind.InsertSyntaxChild: 6
        case MutationKind.DeleteSyntaxNode: 7
        case MutationKind.ReplaceHirNode: 8
        case MutationKind.ReplaceMirInstruction: 9
        case MutationKind.InsertMirBefore: 10
        case MutationKind.InsertMirAfter: 11
        case MutationKind.SplitBasicBlock: 12
        case MutationKind.ReplaceLlvmInstruction: 13
        case MutationKind.InsertDomChild: 14
        case MutationKind.RemoveDomSubtree: 15
        case MutationKind.MoveDomSubtree: 16
        case MutationKind.SetDomAttribute: 17
        case MutationKind.ReplaceDomText: 18
        case MutationKind.InsertCssRule: 19
        case MutationKind.ReplaceCssRule: 20
        case MutationKind.DeleteCssRule: 21
        case MutationKind.ReplaceDeclaration: 22
        case MutationKind.ReplaceLinkDefinition: 23
        case MutationKind.AddRelocation: 24
        case MutationKind.ChangePlacementHint: 25

val MUTATION_KIND_MAX: i64 = 25
val MUTATION_KIND_COUNT: i64 = 26

fn mutation_kind_from_u8(v: i64) -> MutationKind:
    """Caller MUST gate on `mutation_kind_valid` first; this maps only known
    discriminants and pins anything else to AddTag so the function stays total
    (same rule as query_op_kind_from_u8)."""
    match v:
        case 1: MutationKind.RemoveTag
        case 2: MutationKind.ReplaceSourceRange
        case 3: MutationKind.InsertSourceBefore
        case 4: MutationKind.InsertSourceAfter
        case 5: MutationKind.ReplaceSyntaxNode
        case 6: MutationKind.InsertSyntaxChild
        case 7: MutationKind.DeleteSyntaxNode
        case 8: MutationKind.ReplaceHirNode
        case 9: MutationKind.ReplaceMirInstruction
        case 10: MutationKind.InsertMirBefore
        case 11: MutationKind.InsertMirAfter
        case 12: MutationKind.SplitBasicBlock
        case 13: MutationKind.ReplaceLlvmInstruction
        case 14: MutationKind.InsertDomChild
        case 15: MutationKind.RemoveDomSubtree
        case 16: MutationKind.MoveDomSubtree
        case 17: MutationKind.SetDomAttribute
        case 18: MutationKind.ReplaceDomText
        case 19: MutationKind.InsertCssRule
        case 20: MutationKind.ReplaceCssRule
        case 21: MutationKind.DeleteCssRule
        case 22: MutationKind.ReplaceDeclaration
        case 23: MutationKind.ReplaceLinkDefinition
        case 24: MutationKind.AddRelocation
        case 25: MutationKind.ChangePlacementHint
        case _: MutationKind.AddTag

fn mutation_kind_valid(v: i64) -> bool:
    v >= 0 and v <= MUTATION_KIND_MAX

fn mutation_kind_equal(a: MutationKind, b: MutationKind) -> bool:
    mutation_kind_to_u8(a) == mutation_kind_to_u8(b)

# ----------------------------------------------------------------------------
# EntityKindSet (§8.3) — wire SLOT and vocabulary, DERIVED.
#
# §8.3's `reads`/`writes`/`creates`/`deletes` are all typed `EntityKindSet`, and
# the type is never defined anywhere in the document. Rather than invent a
# taxonomy, this freezes the wire slot as a u32 bitset (same shape and same
# reasoning as §6.4's ratified MappingKindSet: a "set of kinds" is a bitset, and
# u32 is the smallest fixed width leaving room to grow) and derives the
# vocabulary from the ONLY place the document enumerates what a mutation may
# touch: §8.2's MutationKind list.
#
# Every §8.2 kind names exactly one class of entity, and those classes are:
#
#   bit 0  Tag             AddTag, RemoveTag
#   bit 1  SourceText      ReplaceSourceRange, InsertSourceBefore/After
#   bit 2  SyntaxNode      ReplaceSyntaxNode, InsertSyntaxChild, DeleteSyntaxNode
#   bit 3  HirNode         ReplaceHirNode
#   bit 4  MirInstruction  ReplaceMirInstruction, InsertMirBefore/After
#   bit 5  BasicBlock      SplitBasicBlock
#   bit 6  LlvmInstruction ReplaceLlvmInstruction
#   bit 7  DomNode         InsertDomChild, RemoveDomSubtree, MoveDomSubtree,
#                          SetDomAttribute, ReplaceDomText
#   bit 8  CssRule         InsertCssRule, ReplaceCssRule, DeleteCssRule
#   bit 9  Declaration     ReplaceDeclaration
#   bit 10 LinkDefinition  ReplaceLinkDefinition
#   bit 11 Relocation      AddRelocation
#   bit 12 PlacementHint   ChangePlacementHint
#
#   bits 13..31 RESERVED and MUST be zero — hard reject.
#
# The partition is total and disjoint over all 26 kinds, which is what makes
# `mutation_kind_target_kind` a total function and lets the op-level invariant
# below be checked mechanically. Raised for ratification — see the contract
# document.
# ----------------------------------------------------------------------------

val ENTITY_KIND_SET_LEN: i64 = 4
val ENTITY_KIND_TAG: i64 = 1
val ENTITY_KIND_SOURCE_TEXT: i64 = 2
val ENTITY_KIND_SYNTAX_NODE: i64 = 4
val ENTITY_KIND_HIR_NODE: i64 = 8
val ENTITY_KIND_MIR_INSTRUCTION: i64 = 16
val ENTITY_KIND_BASIC_BLOCK: i64 = 32
val ENTITY_KIND_LLVM_INSTRUCTION: i64 = 64
val ENTITY_KIND_DOM_NODE: i64 = 128
val ENTITY_KIND_CSS_RULE: i64 = 256
val ENTITY_KIND_DECLARATION: i64 = 512
val ENTITY_KIND_LINK_DEFINITION: i64 = 1024
val ENTITY_KIND_RELOCATION: i64 = 2048
val ENTITY_KIND_PLACEMENT_HINT: i64 = 4096
val ENTITY_KIND_SET_KNOWN: i64 = 8191
val ENTITY_KIND_SET_EMPTY: i64 = 0
val ENTITY_KIND_SET_BIT_COUNT: i64 = 13

fn entity_kind_set_valid(raw: i64) -> bool:
    """True when no reserved bit is set. Silently masking a reserved bit off
    would let an op claim an effect this reader cannot even name, and §8.3 says
    the effect summary is what conflict detection runs on."""
    raw >= 0 and (raw & ENTITY_KIND_SET_KNOWN) == raw

fn entity_kind_set_contains(set: i64, bit: i64) -> bool:
    (set & bit) != 0

fn entity_kind_set_disjoint(a: i64, b: i64) -> bool:
    """§8.4's ComposeIfDisjoint policy is defined on exactly this test."""
    (a & b) == 0

fn mutation_kind_target_kind(k: MutationKind) -> i64:
    """The single EntityKindSet bit the kind operates on. Total over all 26
    §8.2 kinds; the derivation table is in the header comment above."""
    match mutation_kind_to_u8(k):
        case 1: ENTITY_KIND_TAG
        case 2: ENTITY_KIND_SOURCE_TEXT
        case 3: ENTITY_KIND_SOURCE_TEXT
        case 4: ENTITY_KIND_SOURCE_TEXT
        case 5: ENTITY_KIND_SYNTAX_NODE
        case 6: ENTITY_KIND_SYNTAX_NODE
        case 7: ENTITY_KIND_SYNTAX_NODE
        case 8: ENTITY_KIND_HIR_NODE
        case 9: ENTITY_KIND_MIR_INSTRUCTION
        case 10: ENTITY_KIND_MIR_INSTRUCTION
        case 11: ENTITY_KIND_MIR_INSTRUCTION
        case 12: ENTITY_KIND_BASIC_BLOCK
        case 13: ENTITY_KIND_LLVM_INSTRUCTION
        case 14: ENTITY_KIND_DOM_NODE
        case 15: ENTITY_KIND_DOM_NODE
        case 16: ENTITY_KIND_DOM_NODE
        case 17: ENTITY_KIND_DOM_NODE
        case 18: ENTITY_KIND_DOM_NODE
        case 19: ENTITY_KIND_CSS_RULE
        case 20: ENTITY_KIND_CSS_RULE
        case 21: ENTITY_KIND_CSS_RULE
        case 22: ENTITY_KIND_DECLARATION
        case 23: ENTITY_KIND_LINK_DEFINITION
        case 24: ENTITY_KIND_RELOCATION
        case 25: ENTITY_KIND_PLACEMENT_HINT
        case _: ENTITY_KIND_TAG

# ----------------------------------------------------------------------------
# MutationPhase (§8.4, ordering key 2) — wire SLOT and vocabulary, DERIVED.
#
# "mutation phase" appears EXACTLY ONCE in the whole architecture document, as
# ordering key 2 of §8.4, and is never given a type or a vocabulary. Key 1 is
# already "target artifact/entity", so key 2 cannot be the representation the
# entity lives in — that is determined by key 1 and would carry no information.
# What key 2 must distinguish, once several ops share one target, is the CLASS
# of edit, because on one target those classes are not commutative and priority
# alone cannot order them safely.
#
# §8.2's kind list partitions by verb into exactly four classes, and that
# partition is the minimum vocabulary the surrounding text distinguishes:
#
#   0 Remove      RemoveTag, DeleteSyntaxNode, RemoveDomSubtree, DeleteCssRule
#   1 Replace     Replace*/Set*/Change* — acts on the existing entity in place
#   2 Insert      Add*/Insert*         — adds new material anchored to it
#   3 Restructure SplitBasicBlock, MoveDomSubtree — changes containment itself
#
# The ORDER is derived from §8.2's own insertion semantics: InsertSourceBefore /
# InsertSourceAfter / InsertMirBefore / InsertMirAfter are positioned RELATIVE to
# an existing target, so every op that consumes the pre-existing entity (Remove,
# Replace) must be ordered before the ops that anchor new material to it, and
# the ops that change containment wholesale run last so that member edits land
# in the original container before it moves.
#
# The phase byte is REDUNDANT with the kind byte by construction, and the codec
# enforces `phase == mutation_kind_phase(kind)` on encode AND on decode. That is
# deliberate: it freezes the wire slot (a GPU sorter reads one byte for key 2
# instead of a lookup table, §30.5's "conflicts never depend on thread
# scheduling") while making it impossible for a derived field to be forged into
# a value that disagrees with the ratified kind. Raised for ratification — see
# the contract document.
# ----------------------------------------------------------------------------

enum MutationPhase:
    Remove
    Replace
    Insert
    Restructure

fn mutation_phase_to_u8(p: MutationPhase) -> i64:
    match p:
        case MutationPhase.Remove: 0
        case MutationPhase.Replace: 1
        case MutationPhase.Insert: 2
        case MutationPhase.Restructure: 3

val MUTATION_PHASE_MAX: i64 = 3
val MUTATION_PHASE_COUNT: i64 = 4

fn mutation_phase_from_u8(v: i64) -> MutationPhase:
    """Caller MUST gate on `mutation_phase_valid` first."""
    match v:
        case 1: MutationPhase.Replace
        case 2: MutationPhase.Insert
        case 3: MutationPhase.Restructure
        case _: MutationPhase.Remove

fn mutation_phase_valid(v: i64) -> bool:
    v >= 0 and v <= MUTATION_PHASE_MAX

fn mutation_phase_equal(a: MutationPhase, b: MutationPhase) -> bool:
    mutation_phase_to_u8(a) == mutation_phase_to_u8(b)

fn mutation_kind_phase(k: MutationKind) -> MutationPhase:
    """The canonical phase for a kind. Total over all 26 §8.2 kinds."""
    match mutation_kind_to_u8(k):
        case 1: MutationPhase.Remove
        case 7: MutationPhase.Remove
        case 15: MutationPhase.Remove
        case 21: MutationPhase.Remove
        case 2: MutationPhase.Replace
        case 5: MutationPhase.Replace
        case 8: MutationPhase.Replace
        case 9: MutationPhase.Replace
        case 13: MutationPhase.Replace
        case 17: MutationPhase.Replace
        case 18: MutationPhase.Replace
        case 20: MutationPhase.Replace
        case 22: MutationPhase.Replace
        case 23: MutationPhase.Replace
        case 25: MutationPhase.Replace
        case 12: MutationPhase.Restructure
        case 16: MutationPhase.Restructure
        case _: MutationPhase.Insert

# ----------------------------------------------------------------------------
# MutationProducer (§8.2 `origin`, §8.4 key 4) — wire SLOT and vocabulary,
# DERIVED.
#
# §8.2 declares `origin: MutationOrigin` and the type is never defined. §8.4's
# ordering key 4 is "plugin/advice stable name", so the origin must carry a
# stable name; and §8.4's own prose distinguishes producer FAMILIES, because it
# says different families run different conflict policies through the same
# machinery. The families the document actually names:
#
#   0 AopAdvice      §8.4 "AOP advice ordering uses its established priority
#                    semantics"; §8.7 "AOP becomes a domain frontend"
#   1 OptimizerPass  §25's optimizer manifests + MutationIR adapters; §31's
#                    "optimizer before/after semantic equivalence" and
#                    "pass-order determinism"
#   2 CssCascade     §8.4 "CSS cascade uses a domain resolver based on origin,
#                    layer, importance, specificity, and source order"
#   3 LinkResolver   §12/§18's emit step; the LINK lane already ships
#                    `LinkMutationKind` as "the MutationIR kinds it emits"
#   4 ClangAdapter   §25's "MutationIR <-> clang::transformer/Replacements
#                    adapter"
#   5 Plugin         §8.1/§8.2/§8.4's generic "plugin" — the catch-all, kept
#                    LAST so a named family is never silently absorbed into it
#
# Raised for ratification — see the contract document.
# ----------------------------------------------------------------------------

enum MutationProducer:
    AopAdvice
    OptimizerPass
    CssCascade
    LinkResolver
    ClangAdapter
    Plugin

fn mutation_producer_to_u8(p: MutationProducer) -> i64:
    match p:
        case MutationProducer.AopAdvice: 0
        case MutationProducer.OptimizerPass: 1
        case MutationProducer.CssCascade: 2
        case MutationProducer.LinkResolver: 3
        case MutationProducer.ClangAdapter: 4
        case MutationProducer.Plugin: 5

val MUTATION_PRODUCER_MAX: i64 = 5
val MUTATION_PRODUCER_COUNT: i64 = 6

fn mutation_producer_from_u8(v: i64) -> MutationProducer:
    """Caller MUST gate on `mutation_producer_valid` first."""
    match v:
        case 1: MutationProducer.OptimizerPass
        case 2: MutationProducer.CssCascade
        case 3: MutationProducer.LinkResolver
        case 4: MutationProducer.ClangAdapter
        case 5: MutationProducer.Plugin
        case _: MutationProducer.AopAdvice

fn mutation_producer_valid(v: i64) -> bool:
    v >= 0 and v <= MUTATION_PRODUCER_MAX

fn mutation_producer_equal(a: MutationProducer, b: MutationProducer) -> bool:
    mutation_producer_to_u8(a) == mutation_producer_to_u8(b)

# ----------------------------------------------------------------------------
# ConflictPolicy (§8.4) — fully enumerated by the architecture; frozen as given,
# in declaration order, starting at 0.
# ----------------------------------------------------------------------------

enum ConflictPolicy:
    Reject
    HighestPriorityWins
    ComposeIfDisjoint
    RequeryAfterEarlierMutation
    DomainResolver

fn conflict_policy_to_u8(p: ConflictPolicy) -> i64:
    match p:
        case ConflictPolicy.Reject: 0
        case ConflictPolicy.HighestPriorityWins: 1
        case ConflictPolicy.ComposeIfDisjoint: 2
        case ConflictPolicy.RequeryAfterEarlierMutation: 3
        case ConflictPolicy.DomainResolver: 4

val CONFLICT_POLICY_MAX: i64 = 4
val CONFLICT_POLICY_COUNT: i64 = 5

fn conflict_policy_from_u8(v: i64) -> ConflictPolicy:
    """Caller MUST gate on `conflict_policy_valid` first."""
    match v:
        case 1: ConflictPolicy.HighestPriorityWins
        case 2: ConflictPolicy.ComposeIfDisjoint
        case 3: ConflictPolicy.RequeryAfterEarlierMutation
        case 4: ConflictPolicy.DomainResolver
        case _: ConflictPolicy.Reject

fn conflict_policy_valid(v: i64) -> bool:
    v >= 0 and v <= CONFLICT_POLICY_MAX

fn conflict_policy_equal(a: ConflictPolicy, b: ConflictPolicy) -> bool:
    conflict_policy_to_u8(a) == conflict_policy_to_u8(b)

fn conflict_policy_is_total(p: ConflictPolicy) -> bool:
    """True when the policy can resolve every pair of overlapping ops on its
    own. Reject and ComposeIfDisjoint cannot: both have inputs they refuse
    rather than resolve, so a merge under them can still fail. §8.6's
    `merge(plans, policy)` needs this distinction to know whether a failure is
    a bug or a contract outcome."""
    val v = conflict_policy_to_u8(p)
    v == 1 or v == 3 or v == 4

# ----------------------------------------------------------------------------
# Fixed-width scalar helpers.
#
# `priority: i32` (§8.2) is the only SIGNED field in the group. It is written
# masked to 32 bits like every other fixed-width field, so the reader must
# sign-extend explicitly; reading it back as a bare u32 would turn priority -1
# into 4294967295 and inverts §8.4's HighestPriorityWins on every negative
# priority. Both directions are tested against a golden vector.
#
# `mutation_u64_lt` exists because Simple carries u64 in i64: a u64 above 2^63
# comes back NEGATIVE with the identical bit pattern, so a bare `<` on
# `local_identity` or `stable_order` would sort the top half of the space first
# and make §8.4's order depend on which half a hash landed in.
# ----------------------------------------------------------------------------

val MUTATION_U32_MAX: i64 = 4294967295
val MUTATION_I32_MIN: i64 = 0 - 2147483648
val MUTATION_I32_MAX: i64 = 2147483647
val MUTATION_U32_SIGN_BIT: i64 = 2147483648
val MUTATION_U32_SPAN: i64 = 4294967296

fn mutation_i32_to_u32(v: i64) -> i64:
    """Two's-complement encoding of a signed 32-bit priority."""
    v & MUTATION_U32_MAX

fn mutation_i32_from_u32(v: i64) -> i64:
    """Sign-extend a 32-bit two's-complement field back to i64."""
    if v >= MUTATION_U32_SIGN_BIT:
        return v - MUTATION_U32_SPAN
    v

fn mutation_i32_valid(v: i64) -> bool:
    v >= MUTATION_I32_MIN and v <= MUTATION_I32_MAX

fn mutation_u32_valid(v: i64) -> bool:
    v >= 0 and v <= MUTATION_U32_MAX

fn mutation_u64_lt(a: i64, b: i64) -> bool:
    """Unsigned less-than over a u64 bit pattern carried in i64."""
    if (a < 0) == (b < 0):
        return a < b
    b < 0

export MUTATION_SCHEMA_VERSION
export MutationKind, mutation_kind_to_u8, mutation_kind_from_u8
export mutation_kind_valid, mutation_kind_equal
export MUTATION_KIND_MAX, MUTATION_KIND_COUNT
export ENTITY_KIND_SET_LEN, ENTITY_KIND_SET_KNOWN, ENTITY_KIND_SET_EMPTY
export ENTITY_KIND_SET_BIT_COUNT
export ENTITY_KIND_TAG, ENTITY_KIND_SOURCE_TEXT, ENTITY_KIND_SYNTAX_NODE
export ENTITY_KIND_HIR_NODE, ENTITY_KIND_MIR_INSTRUCTION, ENTITY_KIND_BASIC_BLOCK
export ENTITY_KIND_LLVM_INSTRUCTION, ENTITY_KIND_DOM_NODE, ENTITY_KIND_CSS_RULE
export ENTITY_KIND_DECLARATION, ENTITY_KIND_LINK_DEFINITION
export ENTITY_KIND_RELOCATION, ENTITY_KIND_PLACEMENT_HINT
export entity_kind_set_valid, entity_kind_set_contains, entity_kind_set_disjoint
export mutation_kind_target_kind
export MutationPhase, mutation_phase_to_u8, mutation_phase_from_u8
export mutation_phase_valid, mutation_phase_equal, mutation_kind_phase
export MUTATION_PHASE_MAX, MUTATION_PHASE_COUNT
export MutationProducer, mutation_producer_to_u8, mutation_producer_from_u8
export mutation_producer_valid, mutation_producer_equal
export MUTATION_PRODUCER_MAX, MUTATION_PRODUCER_COUNT
export ConflictPolicy, conflict_policy_to_u8, conflict_policy_from_u8
export conflict_policy_valid, conflict_policy_equal, conflict_policy_is_total
export CONFLICT_POLICY_MAX, CONFLICT_POLICY_COUNT
export MUTATION_U32_MAX, MUTATION_I32_MIN, MUTATION_I32_MAX
export MUTATION_U32_SIGN_BIT, MUTATION_U32_SPAN
export mutation_i32_to_u32, mutation_i32_from_u32, mutation_i32_valid
export mutation_u32_valid, mutation_u64_lt
