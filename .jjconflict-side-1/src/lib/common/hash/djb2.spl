# Deterministic signed 32-bit text hash matching Claude Code's djb2Hash helper.
# This is the JavaScript `(hash * 31 + charCode) | 0` behavior over UTF-16 code units.

fn _signed_i32(value: i64) -> i64:
    val masked = value & 4294967295
    if masked >= 2147483648:
        masked - 4294967296
    else:
        masked

fn djb2_hash_text(value: text) -> i64:
    var hash = 0
    for ch in value.chars():
        val codepoint = ch.char_code_at(0)
        if codepoint <= 0xFFFF:
            hash = _signed_i32(((hash << 5) - hash) + codepoint)
        else:
            val adjusted = codepoint - 0x10000
            val high = 0xD800 + (adjusted >> 10)
            val low = 0xDC00 + (adjusted & 0x3FF)
            hash = _signed_i32(((hash << 5) - hash) + high)
            hash = _signed_i32(((hash << 5) - hash) + low)
    hash

export djb2_hash_text
