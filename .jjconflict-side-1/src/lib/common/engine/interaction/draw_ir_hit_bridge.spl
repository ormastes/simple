# draw_ir_hit_bridge.spl — Unified 2D interaction core: DrawIR -> hit forest.
#
# Lane L1 (decisions D2 + D5) of
# doc/03_plan/ui/unified_2d_engine/unified_2d_event_panel_offload_2026-07-30.md:
# makes DrawIR's `hit_rect` and `parent_id` load-bearing for the first time.
# Each DrawIrBatch becomes a GROUP node (proxy from its embedding rect, layer,
# array order); each DrawIrCommand with a present `hit_rect` becomes a LEAF
# node parented to its batch group (or to the node named by the command's
# `parent_id` when set). The resulting proxies + parent map plug directly
# into hit_test.hit_stack / event_route.dispatch — DrawIR answers "what is
# under this pixel" through the one shared event core.
#
# Bounds are the core's half-open convention [left, right) x [top, bottom)
# (HitProxy2D.contains_point: left/top inclusive, right/bottom exclusive).

use std.common.engine.interaction.hit_proxy.{HitProxy2D}
use std.common.ui.draw_ir.{DrawIrComposition, DrawIrBatch, DrawIrCommand}

struct DrawIrHitForest:
    """Hit-test forest lifted from a DrawIrComposition. `proxies` +
    `parents` are exactly the two inputs hit_test.hit_stack takes;
    `node_names` is the reverse map from hashed i64 node id back to the
    originating component_id text so callers can translate hit results
    into DrawIR component ids."""
    proxies: [HitProxy2D]
    parents: Dict<i64, i64>
    node_names: Dict<i64, text>

fn draw_ir_node_id(name: text) -> i64:
    """Stable node id for a DrawIR component_id: 32-bit FNV-1a over the
    text's bytes. Indexes the byte array once (never char_code_at in a
    loop — that is O(i) per call, O(N^2) per string). The 32-bit variant
    keeps every intermediate inside i64 with no overflow; the result is
    always positive, so it never collides with the core's -1 "nothing
    hit" sentinel."""
    val bytes = name.bytes()
    var h: i64 = 2166136261
    val n = bytes.len()
    var i = 0
    while i < n:
        h = h xor bytes[i]
        h = (h * 16777619) % 4294967296
        i = i + 1
    h

fn draw_ir_hit_forest(comp: DrawIrComposition) -> DrawIrHitForest:
    """Lift a DrawIrComposition into a HitProxy2D forest.

    Group nodes: one per batch, AABB = embedding {x, y, width, height}
    as half-open absolute edges, render_layer = embedding.layer,
    tree_order = batch array index. Leaf nodes: one per command whose
    hit_rect is present, AABB = hit_rect translated by the embedding's
    x/y (hit_rect is batch-local), same render_layer/tree_order as the
    batch. insertion_sequence is a single global counter in emission
    order (group first, then its leaves), so a leaf always ranks on top
    of its own group and later batches rank on top of earlier ones at
    equal layer — array order == paint order == hit order.

    Parent map: leaf -> command.parent_id's node when parent_id is set,
    else leaf -> its batch group. When embedding.clip is true, leaf
    rects are clamped to the batch rect (a fully clipped-out leaf keeps
    an empty AABB that can never be hit)."""
    var proxies: [HitProxy2D] = []
    var parents: Dict<i64, i64> = {}
    var node_names: Dict<i64, text> = {}
    var seq = 0
    var bi = 0
    val batch_count = comp.batches.len()
    while bi < batch_count:
        val batch = comp.batches[bi]
        val emb = batch.embedding
        val group_name = emb.component_id
        val group_id = draw_ir_node_id(group_name)
        node_names[group_id] = group_name
        var group = HitProxy2D.create(
            group_id, emb.x, emb.y, emb.x + emb.width, emb.y + emb.height
        )
        group.render_layer = emb.layer
        group.tree_order = bi
        group.insertion_sequence = seq
        seq = seq + 1
        proxies.push(group)

        var ci = 0
        val command_count = batch.commands.len()
        while ci < command_count:
            val cmd = batch.commands[ci]
            if cmd.hit_rect.present:
                var leaf_name = cmd.component_id
                if leaf_name == "":
                    # Anonymous command: synthesize a stable name from the
                    # batch component and the command's array position.
                    leaf_name = "{group_name}#cmd{ci}"
                val leaf_id = draw_ir_node_id(leaf_name)
                node_names[leaf_id] = leaf_name

                var left = emb.x + cmd.hit_rect.x
                var top = emb.y + cmd.hit_rect.y
                var right = left + cmd.hit_rect.width
                var bottom = top + cmd.hit_rect.height
                if emb.clip:
                    if left < emb.x:
                        left = emb.x
                    if top < emb.y:
                        top = emb.y
                    if right > emb.x + emb.width:
                        right = emb.x + emb.width
                    if bottom > emb.y + emb.height:
                        bottom = emb.y + emb.height
                    if right < left:
                        right = left
                    if bottom < top:
                        bottom = top

                var leaf = HitProxy2D.create(leaf_id, left, top, right, bottom)
                leaf.render_layer = emb.layer
                leaf.tree_order = bi
                leaf.insertion_sequence = seq
                seq = seq + 1
                proxies.push(leaf)

                var parent_node = group_id
                if cmd.parent_id != "":
                    parent_node = draw_ir_node_id(cmd.parent_id)
                    node_names[parent_node] = cmd.parent_id
                if leaf_id != parent_node:
                    # Guard: a command reusing its batch's component_id must
                    # not become its own parent (ancestor-walk cycle).
                    parents[leaf_id] = parent_node
            ci = ci + 1
        bi = bi + 1
    DrawIrHitForest(proxies: proxies, parents: parents, node_names: node_names)

fn group_collisions(proxies: [HitProxy2D]) -> [(i64, i64)]:
    """Pairwise AABB overlap over a HitProxy2D set (decision D5: collision
    detection reuses the SAME proxy forest as pointer hit-testing).
    Half-open bounds: rects that merely share an edge do NOT collide,
    matching contains_point's left-inclusive/right-exclusive rule.
    Disabled or invisible proxies never collide. Each unordered pair is
    reported once, in array order (earlier index first)."""
    # ponytail: plain O(n^2) pairwise sweep — fine for panel/HUD counts.
    # Upgrade path when a measured workload needs it: uniform-grid
    # broadphase (bucket proxies by cell, test only shared-cell pairs),
    # per D5 of the 2026-07-30 plan.
    var out: [(i64, i64)] = []
    val n = proxies.len()
    var i = 0
    while i < n:
        val a = proxies[i]
        if a.enabled and a.visible:
            var j = i + 1
            while j < n:
                val b = proxies[j]
                if b.enabled and b.visible:
                    if (a.left < b.right and b.left < a.right and
                        a.top < b.bottom and b.top < a.bottom):
                        out.push((a.node_id, b.node_id))
                j = j + 1
        i = i + 1
    out

export DrawIrHitForest, draw_ir_node_id, draw_ir_hit_forest, group_collisions
