# SAML parser — `.saml` source text to a `SamlModule`
#
# Line-oriented and indentation-aware, matching Simple's own block style. The
# parser is tolerant: an unrecognised line becomes a diagnostic rather than
# aborting the file, so an editor always has a partial model to display.
#
# Behavior is specified by test/01_unit/lib/saml/saml_spec.spl.

use std.common.saml.ir.{SamlField, SamlClass, SamlEnumValue, SamlEnum, SamlStruct}
use std.common.saml.ir.{SamlParam, SamlExample, SamlFunction, SamlTest}
use std.common.saml.ir.{SamlDiagnostic, SamlModule, empty_module}

# Count leading spaces. Tabs are rejected upstream by the lint rule; here they
# simply count as one column each so the block structure still resolves.
fn _indent_of(line: text) -> i64:
    var n = 0
    for ch in line.chars():
        if ch == " ":
            n = n + 1
        else:
            break
    n

fn _strip_comment(line: text) -> text:
    val hash = line.index_of("#")
    if hash < 0:
        return line
    line.slice(0, hash)

# Pull the text between the first pair of double quotes, e.g. from
# `@alias("candidate_name")` return `candidate_name`.
fn _quoted_arg(source: text) -> text:
    val open = source.index_of("\"")
    if open < 0:
        return ""
    val rest = source.slice(open + 1, source.len())
    val close = rest.index_of("\"")
    if close < 0:
        return ""
    rest.slice(0, close)

# Split a trailing run of `@attr` / `@attr(...)` off a declaration line.
# Returns [head, attr, attr, ...] with the head first so callers can index it.
fn split_attributes(source: text) -> [text]:
    var parts: [text] = []
    val at = source.index_of("@")
    if at < 0:
        parts.push(source.trim())
        return parts
    parts.push(source.slice(0, at).trim())
    # Accumulate into a list and join once — `current = current + ch` is O(n^2)
    # and the linter rejects it (COLL006).
    var current: [text] = []
    var depth = 0
    var started = false
    for ch in source.slice(at, source.len()).chars():
        if ch == "@":
            if depth == 0:
                if started:
                    parts.push(current.join("").trim())
                current = []
                started = true
                continue
        if ch == "(":
            depth = depth + 1
        if ch == ")":
            depth = depth - 1
        current.push(ch)
    if started:
        parts.push(current.join("").trim())
    parts

# `name: [Type]?` -> ("name", "Type", optional, is_list)
fn _parse_typed_name(source: text) -> [text]:
    val colon = source.index_of(":")
    if colon < 0:
        return []
    val name = source.slice(0, colon).trim()
    var type_src = source.slice(colon + 1, source.len()).trim()
    var optional = "false"
    var is_list = "false"
    if type_src.ends_with("?"):
        optional = "true"
        type_src = type_src.slice(0, type_src.len() - 1).trim()
    if type_src.starts_with("[") and type_src.ends_with("]"):
        is_list = "true"
        type_src = type_src.slice(1, type_src.len() - 1).trim()
    if type_src.ends_with("?"):
        optional = "true"
        type_src = type_src.slice(0, type_src.len() - 1).trim()
    [name, type_src, optional, is_list]

fn _field_from(source: text, line_no: i64) -> SamlField?:
    val pieces = split_attributes(source)
    if pieces.len() == 0:
        return nil
    val parsed = _parse_typed_name(pieces[0])
    if parsed.len() == 0:
        return nil
    var alias = ""
    var description = ""
    var sensitive = ""
    var i = 1
    while i < pieces.len():
        val attr = pieces[i]
        if attr.starts_with("alias("):
            alias = _quoted_arg(attr)
        if attr.starts_with("description("):
            description = _quoted_arg(attr)
        if attr.starts_with("sensitive("):
            sensitive = attr.slice(10, attr.len() - 1).trim()
        i = i + 1
    SamlField(
        name: parsed[0],
        type_name: parsed[1],
        optional: parsed[2] == "true",
        is_list: parsed[3] == "true",
        alias: alias,
        description: description,
        sensitive: sensitive,
        line: line_no
    )

# Parse the parameter list of `llm fn Name(a: text, b: [i64]?) -> R:`.
fn _params_from(source: text) -> [SamlParam]:
    var out: [SamlParam] = []
    val trimmed = source.trim()
    if trimmed == "":
        return out
    for piece in trimmed.split(","):
        val parsed = _parse_typed_name(piece)
        if parsed.len() == 4:
            out.push(SamlParam(
                name: parsed[0],
                type_name: parsed[1],
                optional: parsed[2] == "true",
                is_list: parsed[3] == "true"
            ))
    out

# A comment-embedded test:  `# example: <input> => <expected>`
# and its deliberate-red counterpart `# counter-example: ... => ...`.
fn parse_example_comment(comment: text, line_no: i64) -> SamlExample?:
    """Parse one `# example:` / `# counter-example:` comment, or nil."""
    val body = comment.trim()
    var kind = ""
    var rest = ""
    if body.starts_with("example:"):
        kind = "example"
        rest = body.slice(8, body.len())
    if body.starts_with("counter-example:"):
        kind = "counter_example"
        rest = body.slice(16, body.len())
    if kind == "":
        return nil
    val arrow = rest.index_of("=>")
    if arrow < 0:
        return SamlExample(kind: kind, input_text: rest.trim(), expect_text: "", line: line_no)
    SamlExample(
        kind: kind,
        input_text: rest.slice(0, arrow).trim(),
        expect_text: rest.slice(arrow + 2, rest.len()).trim(),
        line: line_no
    )

# Parse a whole `.saml` source file.
fn parse_saml(source: text, source_path: text) -> SamlModule:
    """Parse `.saml` source into a `SamlModule`, collecting diagnostics."""
    var module_name = ""
    var classes: [SamlClass] = []
    var enums: [SamlEnum] = []
    var structs: [SamlStruct] = []
    var functions: [SamlFunction] = []
    var tests: [SamlTest] = []
    var diagnostics: [SamlDiagnostic] = []

    # Pending state carried from comment/attribute lines onto the next decl.
    var pending_attrs: [text] = []
    var pending_examples: [SamlExample] = []
    var pending_doc = ""

    # Open block state. `block` names what the current indented lines belong to.
    var block = ""
    var block_indent = 0
    var cur_fields: [SamlField] = []
    var cur_values: [SamlEnumValue] = []
    var cur_name = ""
    var cur_line = 0
    var cur_params: [SamlParam] = []
    var cur_return = ""
    var cur_client = ""
    var cur_prompt = ""
    var cur_attrs: [text] = []
    var cur_examples: [SamlExample] = []
    var cur_doc = ""
    var cur_functions: [text] = []
    var cur_asserts: [text] = []
    var cur_evidence = ""
    var sub_block = ""
    var in_prompt = false
    var prompt_lines: [text] = []

    var line_no = 0
    for raw in source.split("\n"):
        line_no = line_no + 1
        val line = if raw.ends_with("\r"): raw.slice(0, raw.len() - 1) else: raw
        val indent = _indent_of(line)

        # A triple-quoted prompt body is captured verbatim.
        if in_prompt:
            if line.trim() == "\"\"\"":
                in_prompt = false
                cur_prompt = prompt_lines.join("\n")
                continue
            prompt_lines.push(line.trim())
            continue

        val trimmed = line.trim()
        if trimmed == "":
            continue

        if trimmed.starts_with("#"):
            val comment = trimmed.slice(1, trimmed.len())
            val example = parse_example_comment(comment, line_no)
            if example != nil:
                pending_examples.push(example)
            else:
                if pending_doc == "":
                    pending_doc = comment.trim()
            continue

        if trimmed.starts_with("@"):
            for attr in split_attributes(trimmed):
                if attr != "":
                    pending_attrs.push(attr)
            continue

        val code = _strip_comment(line).trim()
        if code == "":
            continue

        # Close the open block when the indentation returns to column 0.
        if indent == 0 and block != "":
            if block == "class":
                classes.push(SamlClass(name: cur_name, fields: cur_fields, line: cur_line))
            if block == "struct":
                structs.push(SamlStruct(name: cur_name, fields: cur_fields, line: cur_line))
            if block == "enum":
                enums.push(SamlEnum(name: cur_name, values: cur_values, line: cur_line))
            if block == "function":
                val fn_decl = SamlFunction(name: cur_name, params: cur_params, return_type: cur_return, client: cur_client, prompt: cur_prompt, attributes: cur_attrs, example_cases: cur_examples, doc: cur_doc, line: cur_line)
                functions.push(fn_decl)
            if block == "test":
                val test_decl = SamlTest(name: cur_name, functions: cur_functions, asserts: cur_asserts, evidence_source: cur_evidence, line: cur_line)
                tests.push(test_decl)
            block = ""
            sub_block = ""

        if indent == 0:
            if code.starts_with("module "):
                module_name = code.slice(7, code.len()).trim()
                pending_attrs = []
                pending_examples = []
                pending_doc = ""
                continue
            if code.starts_with("class ") and code.ends_with(":"):
                block = "class"
                block_indent = indent
                cur_name = code.slice(6, code.len() - 1).trim()
                cur_fields = []
                cur_line = line_no
                pending_attrs = []
                pending_examples = []
                pending_doc = ""
                continue
            if code.starts_with("struct ") and code.ends_with(":"):
                block = "struct"
                block_indent = indent
                cur_name = code.slice(7, code.len() - 1).trim()
                cur_fields = []
                cur_line = line_no
                pending_attrs = []
                pending_examples = []
                pending_doc = ""
                continue
            if code.starts_with("enum ") and code.ends_with(":"):
                block = "enum"
                block_indent = indent
                cur_name = code.slice(5, code.len() - 1).trim()
                cur_values = []
                cur_line = line_no
                pending_attrs = []
                pending_examples = []
                pending_doc = ""
                continue
            if code.starts_with("llm fn "):
                val open = code.index_of("(")
                val close = code.index_of(")")
                if open < 0 or close < 0:
                    diagnostics.push(SamlDiagnostic(
                        code: "E-SAML-1000", severity: "error",
                        message: "llm fn declaration is missing its parameter list",
                        line: line_no
                    ))
                    continue
                block = "function"
                block_indent = indent
                cur_name = code.slice(7, open).trim()
                cur_params = _params_from(code.slice(open + 1, close))
                val after = code.slice(close + 1, code.len())
                val arrow = after.index_of("->")
                if arrow < 0:
                    cur_return = ""
                    diagnostics.push(SamlDiagnostic(
                        code: "E-SAML-1200", severity: "error",
                        message: "llm fn " + cur_name + " declares no return type",
                        line: line_no
                    ))
                else:
                    var ret = after.slice(arrow + 2, after.len()).trim()
                    if ret.ends_with(":"):
                        ret = ret.slice(0, ret.len() - 1).trim()
                    cur_return = ret
                cur_client = ""
                cur_prompt = ""
                cur_attrs = pending_attrs
                cur_examples = pending_examples
                cur_doc = pending_doc
                cur_line = line_no
                pending_attrs = []
                pending_examples = []
                pending_doc = ""
                continue
            if code.starts_with("test ") and code.ends_with(":"):
                block = "test"
                block_indent = indent
                cur_name = code.slice(5, code.len() - 1).trim()
                cur_functions = []
                cur_asserts = []
                cur_evidence = ""
                cur_line = line_no
                pending_attrs = []
                pending_examples = []
                pending_doc = ""
                continue
            diagnostics.push(SamlDiagnostic(
                code: "E-SAML-1000", severity: "warning",
                message: "unrecognised top-level declaration: " + code,
                line: line_no
            ))
            continue

        # Indented lines belong to the open block.
        if block == "class" or block == "struct":
            val field = _field_from(code, line_no)
            if field == nil:
                diagnostics.push(SamlDiagnostic(
                    code: "E-SAML-1000", severity: "warning",
                    message: "unrecognised field in " + cur_name + ": " + code,
                    line: line_no
                ))
            else:
                cur_fields.push(field)
            continue

        if block == "enum":
            val pieces = split_attributes(code)
            var alias = ""
            var i = 1
            while i < pieces.len():
                if pieces[i].starts_with("alias("):
                    alias = _quoted_arg(pieces[i])
                i = i + 1
            cur_values.push(SamlEnumValue(name: pieces[0], alias: alias, line: line_no))
            continue

        if block == "function":
            if code.starts_with("client:"):
                cur_client = code.slice(7, code.len()).trim()
                continue
            if code.starts_with("prompt:"):
                continue
            if code == "\"\"\"":
                in_prompt = true
                prompt_lines = []
                continue
            continue

        if block == "test":
            if code.starts_with("functions:"):
                sub_block = "functions"
                continue
            if code.starts_with("assert:"):
                sub_block = "assert"
                continue
            if code.starts_with("evidence:"):
                sub_block = "evidence"
                continue
            if code.starts_with("- "):
                val item = code.slice(2, code.len()).trim()
                if sub_block == "functions":
                    cur_functions.push(item)
                if sub_block == "assert":
                    cur_asserts.push(item)
                continue
            if sub_block == "evidence" and code.starts_with("source:"):
                cur_evidence = code.slice(7, code.len()).trim()
                continue
            continue

    # Close whatever block the file ended inside.
    if block == "class":
        classes.push(SamlClass(name: cur_name, fields: cur_fields, line: cur_line))
    if block == "struct":
        structs.push(SamlStruct(name: cur_name, fields: cur_fields, line: cur_line))
    if block == "enum":
        enums.push(SamlEnum(name: cur_name, values: cur_values, line: cur_line))
    if block == "function":
        val tail_fn = SamlFunction(name: cur_name, params: cur_params, return_type: cur_return, client: cur_client, prompt: cur_prompt, attributes: cur_attrs, example_cases: cur_examples, doc: cur_doc, line: cur_line)
        functions.push(tail_fn)
    if block == "test":
        val tail_test = SamlTest(name: cur_name, functions: cur_functions, asserts: cur_asserts, evidence_source: cur_evidence, line: cur_line)
        tests.push(tail_test)

    SamlModule(
        name: module_name,
        classes: classes,
        enums: enums,
        structs: structs,
        functions: functions,
        tests: tests,
        diagnostics: diagnostics,
        source_path: source_path
    )

export parse_saml, split_attributes, parse_example_comment
