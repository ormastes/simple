# P10 — bounded LSH candidate bucketing over MinHash signatures.
#
# Never all-pairs: documents are grouped into bands of the MinHash signature
# and only documents sharing a band bucket are ever compared, bounding work to
# O(docs * bands) grouping + O(bucket_size^2) comparisons per bucket instead of
# O(docs^2). Pair ordering is the frozen contract from design §7:
# `score desc, left ID asc, right ID asc`.
#
# Design: doc/05_design/infra/spipe/spipe_knowledge_compiler_search_providers.md §7

use std.common.search.fingerprint.{MinHashSignatureV1, minhash_jaccard_estimate, stable_hash64}

pub struct DuplicateCandidatePairV1:
    left_id: text
    right_id: text
    score: i64
    method: text

fn ordered_pair(id_a: text, id_b: text) -> (text, text):
    if id_a < id_b:
        return (id_a, id_b)
    (id_b, id_a)

fn band_key(sig: MinHashSignatureV1, band: i64, rows: i64) -> text:
    val start = band * rows
    var joined = "b" + "{band}" + ":"
    var i = start
    val end_idx = start + rows
    while i < end_idx and i < sig.values.len():
        joined = joined + "{sig.values[i]}" + ","
        i = i + 1
    "{stable_hash64(joined)}"

pub fn bucketed_candidates(
    doc_ids: [text],
    signatures: [MinHashSignatureV1],
    bands: i64,
    rows: i64,
    max_candidates_per_doc: i64,
) -> [DuplicateCandidatePairV1]:
    """Bounded candidate generation: bucket documents by LSH band, compare only
    within-bucket pairs, dedupe across bands, then sort and cap per document."""
    if doc_ids.len() != signatures.len() or doc_ids.len() < 2:
        return []
    val band_count = if bands < 1: 1 else: bands
    val row_count = if rows < 1: 1 else: rows

    # bucket_key -> list of doc indices sharing that bucket, in one band
    var buckets: {text: [i64]} = {}
    var b = 0
    while b < band_count:
        var d = 0
        while d < doc_ids.len():
            val key = "{b}:" + band_key(signatures[d], b, row_count)
            var current = buckets[key] ?? []
            current.push(d)
            buckets[key] = current
            d = d + 1
        b = b + 1

    # Emit candidate pairs; dedupe by (left,right) since the same pair can
    # collide in more than one band.
    var seen: {text: bool} = {}
    var pairs: [DuplicateCandidatePairV1] = []
    val bucket_keys = buckets.keys()
    var bk = 0
    while bk < bucket_keys.len():
        val members = buckets[bucket_keys[bk]]
        var x = 0
        while x < members.len():
            var y = x + 1
            while y < members.len():
                val idx_a = members[x]
                val idx_b = members[y]
                val ordered = ordered_pair(doc_ids[idx_a], doc_ids[idx_b])
                val pair_key = ordered.0 + "|" + ordered.1
                if not (seen[pair_key] ?? false):
                    seen[pair_key] = true
                    val score = minhash_jaccard_estimate(signatures[idx_a], signatures[idx_b])
                    pairs.push(DuplicateCandidatePairV1(left_id: ordered.0, right_id: ordered.1, score: score, method: "minhash"))
                y = y + 1
            x = x + 1
        bk = bk + 1

    val ordered_pairs = sort_pairs(pairs)
    cap_per_document(ordered_pairs, max_candidates_per_doc)

fn sort_pairs(pairs: [DuplicateCandidatePairV1]) -> [DuplicateCandidatePairV1]:
    """score desc, left ID asc, right ID asc — the frozen pair-ordering
    contract (design §7)."""
    var sorted: [DuplicateCandidatePairV1] = pairs
    var i = 1
    while i < sorted.len():
        val v = sorted[i]
        var j = i - 1
        while j >= 0 and pair_less(v, sorted[j]):
            sorted[j + 1] = sorted[j]
            j = j - 1
        sorted[j + 1] = v
        i = i + 1
    sorted

fn pair_less(a: DuplicateCandidatePairV1, b: DuplicateCandidatePairV1) -> bool:
    if a.score != b.score:
        return a.score > b.score
    if a.left_id != b.left_id:
        return a.left_id < b.left_id
    a.right_id < b.right_id

fn cap_per_document(pairs: [DuplicateCandidatePairV1], max_per_doc: i64) -> [DuplicateCandidatePairV1]:
    if max_per_doc < 1:
        return pairs
    var counts: {text: i64} = {}
    var out: [DuplicateCandidatePairV1] = []
    var i = 0
    while i < pairs.len():
        val p = pairs[i]
        val left_count = counts[p.left_id] ?? 0
        val right_count = counts[p.right_id] ?? 0
        if left_count < max_per_doc and right_count < max_per_doc:
            out.push(p)
            counts[p.left_id] = left_count + 1
            counts[p.right_id] = right_count + 1
        i = i + 1
    out
