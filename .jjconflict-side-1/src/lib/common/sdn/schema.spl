# SDN Schema — typed decode helpers that collect ALL issues instead of
# failing on the first one.
#
# Intended consumer: manifest/config decoders (e.g. the IDE extension
# manifest decoder) that want a full error report in one pass.
#
# Public API (kept deliberately small):
#   SdnDecodeIssue                   — one problem: path, message, line, col
#   SdnDecodeIssues                  — collector class; create with
#                                      SdnDecodeIssues.new(), read .items
#   sdn_get_text(v, path, issues)    -> text?   (issue only on type mismatch)
#   sdn_get_int(v, path, issues)     -> i64?
#   sdn_get_bool(v, path, issues)    -> bool?
#   sdn_get_array(v, path, issues)   -> [SdnValue]?
#   sdn_get_text_array(v, path, issues) -> [text]?  (per-element issues)
#   sdn_get_dict(v, path, issues)    -> Dict<text, SdnValue>?
#   sdn_require_*                    — same, but a missing path is an issue too
#   sdn_locate_issues(issues, spans) — fill line/col from parse_with_spans map
#
# Semantics:
#   - get_*: missing path  -> None, NO issue (optional field)
#            wrong type    -> None, one issue at `path`
#   - require_*: missing path -> None, one "missing required field" issue
#   - decoding never aborts: every helper is total and appends to `issues`
#
# Landmine note: build decoded structs via `mut` locals; never mutate an
# SdnValue returned from a constructor (dead-copy bug, plan §0.11).

use std.common.sdn.value.{SdnValue, SdnSpan}

# One decode problem. line/col are 0 unless located via sdn_locate_issues.
pub struct SdnDecodeIssue:
    path: text
    message: text
    line: i64
    col: i64

# Accumulates decode issues across an entire decode pass.
pub class SdnDecodeIssues:
    items: [SdnDecodeIssue]

    static fn new() -> SdnDecodeIssues:
        SdnDecodeIssues(items: [])

    me add(path: text, message: text):
        self.items = self.items.push(SdnDecodeIssue(path: path, message: message, line: 0, col: 0))

    fn count(self) -> i64:
        self.items.len()

    fn is_empty(self) -> bool:
        self.items.len() == 0

# ---- optional getters: missing -> None silently; wrong type -> issue ----

pub fn sdn_get_text(v: SdnValue, path: text, issues: SdnDecodeIssues) -> text?:
    match v.get_path(path):
        case Some(x):
            match x.as_str():
                case Some(s):
                    Some(s)
                case None:
                    issues.add(path, "expected text, got " + x.type_name())
                    None
        case None:
            None

pub fn sdn_get_int(v: SdnValue, path: text, issues: SdnDecodeIssues) -> i64?:
    match v.get_path(path):
        case Some(x):
            match x.as_i64():
                case Some(i):
                    Some(i)
                case None:
                    issues.add(path, "expected int, got " + x.type_name())
                    None
        case None:
            None

pub fn sdn_get_bool(v: SdnValue, path: text, issues: SdnDecodeIssues) -> bool?:
    match v.get_path(path):
        case Some(x):
            match x.as_bool():
                case Some(b):
                    Some(b)
                case None:
                    issues.add(path, "expected bool, got " + x.type_name())
                    None
        case None:
            None

pub fn sdn_get_array(v: SdnValue, path: text, issues: SdnDecodeIssues) -> [SdnValue]?:
    match v.get_path(path):
        case Some(x):
            match x.as_array():
                case Some(a):
                    Some(a)
                case None:
                    issues.add(path, "expected array, got " + x.type_name())
                    None
        case None:
            None

# Text array: non-text elements each get their own issue ("path.N") and are
# skipped; the remaining text elements are returned.
pub fn sdn_get_text_array(v: SdnValue, path: text, issues: SdnDecodeIssues) -> [text]?:
    match sdn_get_array(v, path, issues):
        case Some(items):
            var out: [text] = []
            var idx = 0
            for item in items:
                match item.as_str():
                    case Some(s):
                        out.push(s)
                    case None:
                        issues.add(path + "." + idx.to_text(), "expected text, got " + item.type_name())
                idx = idx + 1
            Some(out)
        case None:
            None

pub fn sdn_get_dict(v: SdnValue, path: text, issues: SdnDecodeIssues) -> Dict<text, SdnValue>?:
    match v.get_path(path):
        case Some(x):
            match x.as_dict():
                case Some(d):
                    Some(d)
                case None:
                    issues.add(path, "expected dict, got " + x.type_name())
                    None
        case None:
            None

# ---- required getters: missing path is reported as an issue ----

fn _sdn_schema_present(v: SdnValue, path: text, issues: SdnDecodeIssues) -> bool:
    match v.get_path(path):
        case Some(_):
            true
        case None:
            issues.add(path, "missing required field")
            false

pub fn sdn_require_text(v: SdnValue, path: text, issues: SdnDecodeIssues) -> text?:
    if _sdn_schema_present(v, path, issues):
        sdn_get_text(v, path, issues)
    else:
        None

pub fn sdn_require_int(v: SdnValue, path: text, issues: SdnDecodeIssues) -> i64?:
    if _sdn_schema_present(v, path, issues):
        sdn_get_int(v, path, issues)
    else:
        None

pub fn sdn_require_bool(v: SdnValue, path: text, issues: SdnDecodeIssues) -> bool?:
    if _sdn_schema_present(v, path, issues):
        sdn_get_bool(v, path, issues)
    else:
        None

pub fn sdn_require_array(v: SdnValue, path: text, issues: SdnDecodeIssues) -> [SdnValue]?:
    if _sdn_schema_present(v, path, issues):
        sdn_get_array(v, path, issues)
    else:
        None

pub fn sdn_require_text_array(v: SdnValue, path: text, issues: SdnDecodeIssues) -> [text]?:
    if _sdn_schema_present(v, path, issues):
        sdn_get_text_array(v, path, issues)
    else:
        None

pub fn sdn_require_dict(v: SdnValue, path: text, issues: SdnDecodeIssues) -> Dict<text, SdnValue>?:
    if _sdn_schema_present(v, path, issues):
        sdn_get_dict(v, path, issues)
    else:
        None

# ---- span attachment ----

# Return the collected issues with line/col filled in from a span map (as
# produced by parse_with_spans). Issues whose path has no span are unchanged.
pub fn sdn_locate_issues(issues: SdnDecodeIssues, spans: Dict<text, SdnSpan>) -> [SdnDecodeIssue]:
    var out: [SdnDecodeIssue] = []
    for it in issues.items:
        if spans.contains_key(it.path):
            val sp = spans[it.path]
            out.push(SdnDecodeIssue(path: it.path, message: it.message, line: sp.line, col: sp.column))
        else:
            out.push(it)
    out
