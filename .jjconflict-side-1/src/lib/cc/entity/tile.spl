# Tile — one raster tile in the compositor's tile cache.
#
# A layer that draws content is chopped into a grid of fixed-size tiles. Each
# tile is rasterized independently and cached, so scrolling or a small
# invalidation re-rasters only the tiles it touched rather than the whole layer.
#
# A tile moves through one state machine and no other:
#
#     Unrasterized --begin_raster--> InProgress --complete_raster--> Ready
#                                        |
#                                        +-------fail_raster------> Failed
#
# `has_raster_task` is true exactly while the tile sits in InProgress, i.e.
# while a raster task for it is outstanding.
#
# Provides: TileId, TileKey, TilePriority, TileDrawState, Tile,
#           tile_id_new, tile_new.

use std.skia.entity.geometry.{SkRect, SkIRect}
use std.skia.backend.cpu.raster_prims.{Bitmap}

# How urgently a tile is needed. The scheduler rasters `Now` tiles before the
# current frame draws, `Soon` tiles opportunistically, and `Eventually` tiles
# only when there is spare capacity.
#
# `NowBin`/`SoonBin`/`EventuallyBin` are the legacy Chromium-derived spellings
# (cc calls these priority *bins*) kept for callers written against the older
# name. They are distinct variants, so a scheduler that reads priorities must
# handle both spellings of the same bin.
enum TilePriority:
    Now
    Soon
    Eventually
    NowBin
    SoonBin
    EventuallyBin

# Where a tile is in the raster state machine above.
enum TileDrawState:
    Unrasterized
    InProgress
    Ready
    Failed

# Identifies a tile: which layer it belongs to, its (i, j) slot in that layer's
# tile grid, and the raster scale it was cut at. The scale is part of the
# identity because the same grid slot at a different zoom is a different tile.
class TileId:
    layer_id: i64
    i: i64
    j: i64
    scale: f64

    static fn new(layer_id: i64, i: i64, j: i64, scale: f64) -> TileId:
        TileId(layer_id: layer_id, i: i, j: j, scale: scale)

    fn equals(other: TileId) -> bool:
        (self.layer_id == other.layer_id and self.i == other.i
         and self.j == other.j and self.scale == other.scale)

fn tile_id_new(layer_id: i64, i: i64, j: i64, scale: f64) -> TileId:
    TileId(layer_id: layer_id, i: i, j: j, scale: scale)

# Legacy name for TileId — cc calls this a tile *key*.
type TileKey = TileId

class Tile:
    id: TileId
    content_rect: SkRect
    priority: TilePriority
    draw_state: TileDrawState
    has_raster_task: bool
    required_for_activation: bool
    bitmap: Bitmap

    # A fresh, unrasterized tile at the lowest priority.
    static fn make(id: TileId, content_rect: SkRect) -> Tile:
        Tile(id: id, content_rect: content_rect,
             priority: TilePriority.Eventually,
             draw_state: TileDrawState.Unrasterized,
             has_raster_task: false,
             required_for_activation: false,
             bitmap: Bitmap.zeros(0, 0))

    # Legacy constructor: integer content rect plus an explicit priority.
    static fn new(key: TileKey, content_rect: SkIRect, priority: TilePriority) -> Tile:
        Tile(id: key,
             content_rect: SkRect(left: content_rect.left.to_f64(),
                                  top: content_rect.top.to_f64(),
                                  right: content_rect.right.to_f64(),
                                  bottom: content_rect.bottom.to_f64()),
             priority: priority,
             draw_state: TileDrawState.Unrasterized,
             has_raster_task: false,
             required_for_activation: false,
             bitmap: Bitmap.zeros(0, 0))

    me set_priority(priority: TilePriority):
        me.priority = priority

    # Claims the tile for rasterization; the raster task is now outstanding.
    me begin_raster():
        me.draw_state = TileDrawState.InProgress
        me.has_raster_task = true

    # Publishes the rastered pixels and retires the raster task.
    me complete_raster(bitmap: Bitmap):
        me.bitmap = bitmap
        me.draw_state = TileDrawState.Ready
        me.has_raster_task = false

    # Retires the raster task without pixels; the tile stays undrawable.
    me fail_raster():
        me.draw_state = TileDrawState.Failed
        me.has_raster_task = false

    # True only when the tile has pixels the compositor may draw. Failed is not
    # ready — a failed raster must not be mistaken for a finished one.
    fn is_ready() -> bool:
        self.draw_state == TileDrawState.Ready

    me mark_required_for_activation(required: bool):
        me.required_for_activation = required

fn tile_new(id: TileId, content_rect: SkRect) -> Tile:
    Tile.make(id, content_rect)
