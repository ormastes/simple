# Pure-Simple simple-core math ABI backed by the platform math library.

@unsafe(reason: "raw platform libm square-root ABI", capabilities: [ffi])
extern fn sqrt(x: f64) -> f64

@always_inline
fn _sffi_core_math_sqrt(x: f64) -> f64:
    unsafe(capabilities: [ffi]):
        sqrt(x)

pub fn rt_math_sqrt(x: f64) -> f64:
    return _sffi_core_math_sqrt(x)
