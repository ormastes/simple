# Bounded printable-byte extraction for filesystem-launched SimpleOS Simplebox.

use os.userlib.fs.{file_open_direct, file_read_direct, file_close_direct}
use os.tools.simplebox.simplebox_fs_applets.{
    SIMPLEBOX_FILE_BYTES_LIMIT, SIMPLEBOX_READ_CHUNK_BYTES,
    SIMPLEBOX_PATH_OPERAND_BYTES_LIMIT
}
use std.nogc_sync_mut.binary_io.{bytes_to_string}

extern fn stdout_write(data: text)

pub const SIMPLEBOX_STRINGS_DEFAULT_MINIMUM: u64 = 4u64
pub const SIMPLEBOX_STRINGS_MINIMUM_LIMIT: u64 = 4096u64
pub const SIMPLEBOX_STRINGS_RUN_LIMIT: u64 = 1000000u64
pub const SIMPLEBOX_STRINGS_ROWS_PER_BLOCK: u64 = 1024u64
pub const SIMPLEBOX_STRINGS_OUTPUT_BYTES_LIMIT: u64 = 67108864u64

struct SimpleboxStringsPlan:
    minimum: u64
    path: text
    accepted: bool
    error: text

struct SimpleboxStringsState:
    blocks: [text]
    buffered_rows: [text]
    pending_chunks: [text]
    pending: [u8]
    pending_bytes: u64
    consumed: u64
    output_bytes: u64
    run_count: u64
    failure: text

fn _strings_parse_minimum(value: text) -> u64:
    val bytes = value.bytes()
    if bytes.len() == 0u64 or bytes.len() > 4u64:
        return 0u64
    var minimum: u64 = 0u64
    for byte in bytes:
        if byte < 48u8 or byte > 57u8:
            return 0u64
        val digit = (byte - 48u8).to_u64()
        if minimum > (SIMPLEBOX_STRINGS_MINIMUM_LIMIT - digit) / 10u64:
            return 0u64
        minimum = minimum * 10u64 + digit
    if minimum == 0u64 or minimum > SIMPLEBOX_STRINGS_MINIMUM_LIMIT:
        return 0u64
    minimum

fn _strings_plan(args: [text]) -> SimpleboxStringsPlan:
    var minimum = SIMPLEBOX_STRINGS_DEFAULT_MINIMUM
    var minimum_set = false
    var path = ""
    var options = true
    var index: u64 = 0u64
    while index < args.len():
        val arg = args[index]
        if options and arg == "--":
            options = false
        elif options and arg == "-a":
            pass_do_nothing("the bounded implementation already scans the whole file")
        elif options and arg == "-n":
            if minimum_set or index + 1u64 >= args.len():
                return SimpleboxStringsPlan(minimum: 0u64, path: "",
                    accepted: false, error: "-n requires one minimum length")
            minimum = _strings_parse_minimum(args[index + 1u64])
            if minimum == 0u64:
                return SimpleboxStringsPlan(minimum: 0u64, path: "",
                    accepted: false, error: "minimum length must be 1..4096")
            minimum_set = true
            index = index + 1u64
        elif options and arg.starts_with("-n") and arg.len() > 2u64:
            if minimum_set:
                return SimpleboxStringsPlan(minimum: 0u64, path: "",
                    accepted: false, error: "minimum length specified more than once")
            minimum = _strings_parse_minimum(arg.slice(2, arg.len()))
            if minimum == 0u64:
                return SimpleboxStringsPlan(minimum: 0u64, path: "",
                    accepted: false, error: "minimum length must be 1..4096")
            minimum_set = true
        elif options and arg.starts_with("-"):
            return SimpleboxStringsPlan(minimum: 0u64, path: "",
                accepted: false, error: "unsupported option: " + arg)
        elif path != "":
            return SimpleboxStringsPlan(minimum: 0u64, path: "",
                accepted: false, error: "expected exactly one FILE operand")
        else:
            path = arg
            options = false
        index = index + 1u64
    if path == "":
        return SimpleboxStringsPlan(minimum: 0u64, path: "",
            accepted: false, error: "missing FILE operand")
    if path.len() > SIMPLEBOX_PATH_OPERAND_BYTES_LIMIT:
        return SimpleboxStringsPlan(minimum: 0u64, path: "",
            accepted: false, error: "invalid path length")
    SimpleboxStringsPlan(minimum: minimum, path: path, accepted: true, error: "")

fn _strings_finish_run(
    prior: SimpleboxStringsState, minimum: u64
) -> SimpleboxStringsState:
    var state = prior
    val run_bytes = state.pending_bytes + state.pending.len()
    if run_bytes < minimum:
        state.pending_chunks = []
        state.pending = []
        state.pending_bytes = 0u64
        return state
    if state.run_count >= SIMPLEBOX_STRINGS_RUN_LIMIT:
        state.failure = "input exceeds simplebox printable-run limit"
        return state
    val output_size = run_bytes + 1u64
    if output_size > SIMPLEBOX_STRINGS_OUTPUT_BYTES_LIMIT - state.output_bytes:
        state.failure = "output exceeds simplebox byte limit"
        return state
    if state.pending_chunks.len() == 0u64:
        state.buffered_rows.push(bytes_to_string(state.pending) + "\n")
        if state.buffered_rows.len() == SIMPLEBOX_STRINGS_ROWS_PER_BLOCK:
            state.blocks.push(state.buffered_rows.join(""))
            state.buffered_rows = []
    else:
        # Preserve output order while avoiding a second run-sized join/copy.
        # Long runs are retained as read-chunk-sized text blocks and emitted
        # only after the descriptor has closed successfully.
        if state.buffered_rows.len() > 0u64:
            state.blocks.push(state.buffered_rows.join(""))
            state.buffered_rows = []
        for chunk in state.pending_chunks:
            state.blocks.push(chunk)
        if state.pending.len() > 0u64:
            state.blocks.push(bytes_to_string(state.pending))
        state.blocks.push("\n")
    state.pending_chunks = []
    state.pending = []
    state.pending_bytes = 0u64
    state.output_bytes = state.output_bytes + output_size
    state.run_count = state.run_count + 1u64
    state

fn _strings_read(plan: SimpleboxStringsPlan) -> SimpleboxStringsState:
    var state = SimpleboxStringsState(
        blocks: [], buffered_rows: [], pending_chunks: [], pending: [],
        pending_bytes: 0u64,
        consumed: 0u64, output_bytes: 0u64, run_count: 0u64, failure: "")
    val opened = file_open_direct(plan.path, 0u32)
    match opened:
        case Err(reason):
            state.failure = plan.path + ": " + reason
            state
        case Ok(fd):
            var complete = false
            while not complete and state.failure == "":
                match file_read_direct(fd, SIMPLEBOX_READ_CHUNK_BYTES):
                    case Err(reason): state.failure = plan.path + ": " + reason
                    case Ok(chunk):
                        if chunk.len() == 0u64:
                            complete = true
                        elif chunk.len() > SIMPLEBOX_FILE_BYTES_LIMIT - state.consumed:
                            state.failure = plan.path + ": file exceeds simplebox byte limit"
                        else:
                            state.consumed = state.consumed + chunk.len()
                            var index: u64 = 0u64
                            while index < chunk.len() and state.failure == "":
                                val byte = chunk[index]
                                if byte >= 32u8 and byte <= 126u8:
                                    state.pending.push(byte)
                                    if (state.pending.len() ==
                                        SIMPLEBOX_READ_CHUNK_BYTES):
                                        state.pending_chunks.push(
                                            bytes_to_string(state.pending))
                                        state.pending_bytes = state.pending_bytes +
                                            state.pending.len()
                                        state.pending = []
                                else:
                                    state = _strings_finish_run(state, plan.minimum)
                                index = index + 1u64
            if (state.failure == "" and
                (state.pending_bytes > 0u64 or state.pending.len() > 0u64)):
                state = _strings_finish_run(state, plan.minimum)
            if not file_close_direct(fd) and state.failure == "":
                state.failure = plan.path + ": close failed"
            if state.failure == "" and state.buffered_rows.len() > 0u64:
                state.blocks.push(state.buffered_rows.join(""))
                state.buffered_rows = []
            state

pub fn simplebox_strings(args: [text]) -> i32:
    """Extract bounded printable ASCII runs from one filesystem object.

    Supported forms are `strings [-a] [-n MIN] [--] FILE` and `-nMIN`.
    MIN defaults to four and is bounded to 1..4096. Printable bytes are the
    locale-independent ASCII range 0x20..0x7e. Encodings, object-section
    filtering, offsets, stdin, and unbounded input are rejected. The complete
    read and close are admitted before any extracted content reaches stdout.
    """
    val plan = _strings_plan(args)
    if not plan.accepted:
        stdout_write("strings: " + plan.error + "\n")
        return 2
    val state = _strings_read(plan)
    if state.failure != "":
        stdout_write("strings: " + state.failure + "\n")
        return 2
    for block in state.blocks:
        stdout_write(block)
    0
