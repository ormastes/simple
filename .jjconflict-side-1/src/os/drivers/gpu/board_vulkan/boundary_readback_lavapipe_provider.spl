# lavapipe counterpart provider descriptor for the board Vulkan readback
# boundary (`vulkan.present.readback_image@1`).
#
# lavapipe (Mesa's `libvulkan_lvp.so`, ICD manifest
# `/usr/share/vulkan/icd.d/lvp_icd.json`) is a software Vulkan implementation —
# deterministic, needs no GPU or board, and is the reference this lane
# compares candidate readbacks against for `image_exact`. Its
# `independence_group` is `mesa`, per the architecture doc, so a run that only
# executes lavapipe alongside another Mesa-derived driver (anv, turnip,
# powervr) is one independent reference, not two.
#
# This file only builds the descriptor DATA (a `ProviderManifest`). It does not
# edit `provider_registry.spl` or any other central registry — per plan rule 9
# ("add a descriptor rather than editing central registries"), a caller wires
# this into a `ProviderRegistry` with `provider_registry_register` at run time.
#
# Optional second reference: anv (`intel_icd.json`) is also installed on this
# host, hardware-backed rather than software, and is described here too so a
# run can add a genuinely independent... except anv is ALSO Mesa (`group:
# mesa`), which is exactly the independence-group trap the architecture doc
# calls out: lavapipe + anv together still count as one independent reference,
# not two. Kept anyway because a hardware-backed second data point is still
# useful evidence, just not a second independence group.
#
# Plan: doc/03_plan/os/vulkan/board_vulkan_parallel_soc_lanes_2026-08-10.md
# Model: src/lib/common/spec/evidence/counterpart/model.spl (frozen, do not edit)

use std.common.spec.evidence.counterpart.model.{
    ComponentManifest,
    ProviderKind,
    ProviderManifest, ProviderStatus,
    COUNTERPART_ABI_VERSION
}
use std.common.spec.evidence.format.exec_capture.{ExecCapture, exec_to_evidence}
use std.common.spec.evidence.model.{CanonicalEvidence}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use os.drivers.gpu.board_vulkan.soc_profile.{board_vulkan_boundary_readback}

pub val LAVAPIPE_READBACK_TIMEOUT_MS: i64 = 30000
pub val LAVAPIPE_READBACK_MAX_OUTPUT_BYTES: i64 = 4194304

pub struct LavapipeReadbackResult:
    status: ProviderStatus
    reference_image_bytes: text
    diagnostic: text
    evidence: CanonicalEvidence

fn transcript_value(output: text, key: text) -> text:
    for line in output.split("\n"):
        if line.starts_with(key + "="):
            return line.slice(key.len() + 1, line.len()).trim()
    ""

# Portable bounded execution: timeout and capture limits are enforced by the
# runtime facade, not a host `timeout` utility. Only a successful Vulkan
# device-readback transcript can supply the reference image identity.
pub fn lavapipe_readback_worker(command: text, args: [text]) -> LavapipeReadbackResult:
    val (stdout, stderr, code) = process_run_bounded(
        command, args, LAVAPIPE_READBACK_TIMEOUT_MS,
        LAVAPIPE_READBACK_MAX_OUTPUT_BYTES)
    val capture = ExecCapture(
        command: command, args: args, exit_code: code,
        stdout: stdout, stderr: stderr, duration_ms: 0,
        launch_ok: code != -1,
        launch_error: if code == -1: "process spawn failed" else: "")
    val evidence = exec_to_evidence(capture, "board_vulkan.lavapipe_readback")
    if code == -1 or code == 126 or code == 127:
        return LavapipeReadbackResult(status: ProviderStatus.unavailable, reference_image_bytes: "", diagnostic: stderr, evidence: evidence)
    if code != 0:
        return LavapipeReadbackResult(status: ProviderStatus.crashed, reference_image_bytes: "", diagnostic: stderr, evidence: evidence)
    val checksum = transcript_value(stdout, "rect_actual_checksum")
    if transcript_value(stdout, "overall") != "pass" or
       transcript_value(stdout, "backend_name") != "vulkan" or
       transcript_value(stdout, "rect_readback_source") != "device_readback" or
       checksum == "":
        return LavapipeReadbackResult(
            status: ProviderStatus.crashed, reference_image_bytes: "",
            diagnostic: "worker produced no admissible device readback", evidence: evidence)
    LavapipeReadbackResult(
        status: ProviderStatus.executed, reference_image_bytes: "checksum:" + checksum,
        diagnostic: "", evidence: evidence)

# Production owner: pin lavapipe through `env`, then execute the caller's
# admitted cached Engine2D readback worker artifact. Its checksum is computed
# from captured device pixels; no expected value is passed into this function.
pub fn lavapipe_readback_reference(worker_binary: text) -> LavapipeReadbackResult:
    lavapipe_readback_worker("/usr/bin/env", [
        "VK_ICD_FILENAMES=" + lavapipe_icd_manifest_path(),
        worker_binary
    ])

pub fn lavapipe_provider_id() -> text:
    "lavapipe"
pub fn lavapipe_independence_group() -> text:
    "mesa"
pub fn lavapipe_icd_manifest_path() -> text:
    "/usr/share/vulkan/icd.d/lvp_icd.json"
pub fn lavapipe_shared_library_path() -> text:
    "/usr/lib/x86_64-linux-gnu/libvulkan_lvp.so"

fn readback_component(component_id: text) -> ComponentManifest:
    ComponentManifest(
        component_id: component_id,
        counterpart_boundary_id: board_vulkan_boundary_readback(),
        input_schema_id: "vulkan.present.readback_image.input@1",
        output_schema_id: "vulkan.present.readback_image.output@1",
        stateful: false,
        reset_supported: true,
        deterministic_claim: "software_rasterizer_bit_reproducible",
        supported_relations: ["image_exact"],
        supported_execution_modes: ["cpu_reference"],
        capability_requirements: []
    )

# lavapipe is the primary, always-available reference for this boundary: pure
# software, no GPU or board needed, deterministic across runs.
pub fn lavapipe_provider_manifest() -> ProviderManifest:
    ProviderManifest(
        provider_id: lavapipe_provider_id(),
        provider_kind: ProviderKind.native_isolated_worker,
        independence_group: lavapipe_independence_group(),
        abi_version: COUNTERPART_ABI_VERSION,
        version: "mesa-lavapipe-installed",
        artifact_hash: lavapipe_shared_library_path(),
        license_spdx: "MIT",
        components: [readback_component("lavapipe.readback_image")]
    )

# anv (Intel hardware-backed Mesa driver). Documented here as the optional
# second reference the task description mentions. NOTE: same
# `independence_group` as lavapipe ("mesa") — including this alongside
# lavapipe in one run does NOT add a second independent reference; it exists
# only so a run can demand a hardware-backed data point when one is available.
pub fn anv_provider_id() -> text:
    "anv"
pub fn anv_icd_manifest_path() -> text:
    "/usr/share/vulkan/icd.d/intel_icd.json"

pub fn anv_provider_manifest() -> ProviderManifest:
    ProviderManifest(
        provider_id: anv_provider_id(),
        provider_kind: ProviderKind.native_isolated_worker,
        independence_group: lavapipe_independence_group(),
        abi_version: COUNTERPART_ABI_VERSION,
        version: "mesa-anv-installed",
        artifact_hash: anv_icd_manifest_path(),
        license_spdx: "MIT",
        components: [readback_component("anv.readback_image")]
    )
