# OS-owned dynSMF trust configuration and retained-byte admission registry.
#
# The registry is the only production bridge from an exact trust config to an
# executable artifact. It binds every library id/path/ABI/kind/export/digest,
# parses the aspect directory from that same image, and retains the bytes that
# passed admission. Startup consumers never reopen an admitted artifact path.

use std.common.aspect_pack.{
    AspectFacetDescriptor,
    AspectPackBinding,
    AspectCatalogEntry,
    aspect_catalog_build
}
use std.common.crypto.sha256.{sha256_u8_hex}
use os.smf.aspect_pack_directory.{
    AspectPackArtifactIdentity,
    AspectPackExportContract,
    AspectPackLookupRequest,
    aspect_pack_directory_parse_from_outer_smf_bytes,
    aspect_pack_directory_validate_against_manifest
}
use os.smf.dynsmf_manifest_contract.{DynSmfManifestEntry}

extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_read_bytes(path: text) -> [u8]
extern fn rt_file_read_text(path: text) -> text

class DynSmfTrustBindingConfig:
    facet_id: text
    aspect_id: text
    module_id: text
    module_abi_hash: text
    export_symbol: text
    interface_abi_hash: text

class DynSmfTrustArtifactConfig:
    library_id: text
    path: text
    abi_version: text
    artifact_kind: text
    content_hash: text
    bindings: [DynSmfTrustBindingConfig]

class DynSmfTrustConfigParse:
    ok: bool
    reason: text
    artifacts: [DynSmfTrustArtifactConfig]

class DynSmfTrustArtifactImage:
    path: text
    artifact_bytes: [u8]

class DynSmfAdmittedArtifact:
    library_id: text
    request: AspectPackLookupRequest
    artifact_bytes: [u8]

class DynSmfAdmittedRegistry:
    ok: bool
    reason: text
    artifacts: [DynSmfAdmittedArtifact]

fn _dynsmf_trust_binding_default() -> DynSmfTrustBindingConfig:
    DynSmfTrustBindingConfig(
        facet_id: "",
        aspect_id: "",
        module_id: "",
        module_abi_hash: "",
        export_symbol: "",
        interface_abi_hash: ""
    )

fn _dynsmf_trust_artifact_default() -> DynSmfTrustArtifactConfig:
    DynSmfTrustArtifactConfig(
        library_id: "",
        path: "",
        abi_version: "",
        artifact_kind: "",
        content_hash: "",
        bindings: []
    )

fn _dynsmf_trust_parse_error(reason: text) -> DynSmfTrustConfigParse:
    DynSmfTrustConfigParse(ok: false, reason: reason, artifacts: [])

fn _dynsmf_trust_registry_error(reason: text) -> DynSmfAdmittedRegistry:
    DynSmfAdmittedRegistry(ok: false, reason: reason, artifacts: [])

fn _dynsmf_trust_binding_valid(binding: DynSmfTrustBindingConfig) -> bool:
    (binding.facet_id != "" and binding.aspect_id != "" and
        binding.module_id != "" and binding.module_abi_hash != "" and
        binding.export_symbol != "" and binding.interface_abi_hash != "")

fn _dynsmf_trust_digest_valid(digest: text) -> bool:
    if digest.len() != 64:
        return false
    var index = 0
    while index < digest.len():
        val ch = digest.slice(index, index + 1)
        if not "0123456789abcdef".contains(ch):
            return false
        index = index + 1
    true

fn _dynsmf_trust_artifact_valid(artifact: DynSmfTrustArtifactConfig) -> bool:
    (artifact.library_id != "" and artifact.path != "" and
        artifact.abi_version != "" and artifact.artifact_kind != "" and
        _dynsmf_trust_digest_valid(artifact.content_hash) and
        artifact.bindings.len() > 0)

fn _dynsmf_trust_binding_duplicate(bindings: [DynSmfTrustBindingConfig], binding: DynSmfTrustBindingConfig) -> bool:
    var index = 0
    while index < bindings.len():
        if (bindings[index].facet_id == binding.facet_id or
            bindings[index].export_symbol == binding.export_symbol):
            return true
        index = index + 1
    false

fn _dynsmf_trust_finish_binding(artifact: DynSmfTrustArtifactConfig, binding: DynSmfTrustBindingConfig, have_binding: bool) -> text:
    if not have_binding:
        return ""
    if not _dynsmf_trust_binding_valid(binding):
        return "incomplete_binding:" + artifact.library_id
    if _dynsmf_trust_binding_duplicate(artifact.bindings, binding):
        return "duplicate_binding:" + artifact.library_id + ":" + binding.export_symbol
    artifact.bindings.push(binding)
    ""

fn _dynsmf_trust_artifact_duplicate(artifacts: [DynSmfTrustArtifactConfig], artifact: DynSmfTrustArtifactConfig) -> bool:
    var index = 0
    while index < artifacts.len():
        if (artifacts[index].library_id == artifact.library_id or
            artifacts[index].path == artifact.path):
            return true
        index = index + 1
    false

fn _dynsmf_trust_finish_artifact(artifacts: [DynSmfTrustArtifactConfig], artifact: DynSmfTrustArtifactConfig, have_artifact: bool) -> text:
    if not have_artifact:
        return ""
    if not _dynsmf_trust_artifact_valid(artifact):
        return "incomplete_artifact:" + artifact.library_id
    if _dynsmf_trust_artifact_duplicate(artifacts, artifact):
        return "duplicate_artifact:" + artifact.library_id
    artifacts.push(artifact)
    ""

# Exact fail-closed grammar. Artifact fields must precede their binding blocks:
#
#   trust_artifact:
#     id: file_io
#     path: build/dynsmf/file_io.smf
#     abi_version: 1
#     artifact_kind: precompiled_smf
#     content_hash: <sha256>
#     binding:
#       facet_id: startup/file_io/open
#       aspect_id: startup.aspect
#       module_id: file_io.module
#       module_abi_hash: <exact-module-abi>
#       export_symbol: open
#       interface_abi_hash: <exact-interface-abi>
pub fn dynsmf_trust_config_parse(source: text) -> DynSmfTrustConfigParse:
    var artifacts: [DynSmfTrustArtifactConfig] = []
    var artifact = _dynsmf_trust_artifact_default()
    var binding = _dynsmf_trust_binding_default()
    var have_artifact = false
    var have_binding = false
    val lines = source.split("\n")
    var index = 0
    while index < lines.len():
        val line = lines[index].trim()
        index = index + 1
        if line == "" or line.starts_with("#"):
            continue
        if line == "trust_artifact:":
            val binding_error = _dynsmf_trust_finish_binding(artifact, binding, have_binding)
            if binding_error != "":
                return _dynsmf_trust_parse_error(binding_error)
            val artifact_error = _dynsmf_trust_finish_artifact(artifacts, artifact, have_artifact)
            if artifact_error != "":
                return _dynsmf_trust_parse_error(artifact_error)
            artifact = _dynsmf_trust_artifact_default()
            binding = _dynsmf_trust_binding_default()
            have_artifact = true
            have_binding = false
            continue
        if line == "binding:":
            if not have_artifact:
                return _dynsmf_trust_parse_error("binding_without_artifact")
            val binding_error = _dynsmf_trust_finish_binding(artifact, binding, have_binding)
            if binding_error != "":
                return _dynsmf_trust_parse_error(binding_error)
            binding = _dynsmf_trust_binding_default()
            have_binding = true
            continue
        if not have_artifact:
            return _dynsmf_trust_parse_error("field_without_artifact:" + line)
        val separator = line.index_of(":")
        if separator < 0:
            return _dynsmf_trust_parse_error("malformed_line:" + line)
        val key = line.substring(0, separator).trim()
        val value = line.substring(separator + 1, line.len()).trim()
        if value == "":
            return _dynsmf_trust_parse_error("empty_value:" + key)
        if have_binding:
            if key == "facet_id":
                binding.facet_id = value
            elif key == "aspect_id":
                binding.aspect_id = value
            elif key == "module_id":
                binding.module_id = value
            elif key == "module_abi_hash":
                binding.module_abi_hash = value
            elif key == "export_symbol":
                binding.export_symbol = value
            elif key == "interface_abi_hash":
                binding.interface_abi_hash = value
            else:
                return _dynsmf_trust_parse_error("unknown_binding_key:" + key)
        else:
            if key == "id":
                artifact.library_id = value
            elif key == "path":
                artifact.path = value
            elif key == "abi_version":
                artifact.abi_version = value
            elif key == "artifact_kind":
                artifact.artifact_kind = value
            elif key == "content_hash":
                artifact.content_hash = value
            else:
                return _dynsmf_trust_parse_error("unknown_artifact_key:" + key)
    val binding_error = _dynsmf_trust_finish_binding(artifact, binding, have_binding)
    if binding_error != "":
        return _dynsmf_trust_parse_error(binding_error)
    val artifact_error = _dynsmf_trust_finish_artifact(artifacts, artifact, have_artifact)
    if artifact_error != "":
        return _dynsmf_trust_parse_error(artifact_error)
    if artifacts.len() == 0:
        return _dynsmf_trust_parse_error("trust_registry_empty")
    DynSmfTrustConfigParse(ok: true, reason: "parsed", artifacts: artifacts)

fn _dynsmf_trust_manifest_entry(manifest: [DynSmfManifestEntry], library_id: text) -> DynSmfManifestEntry?:
    var found: DynSmfManifestEntry? = nil
    var matches = 0
    var index = 0
    while index < manifest.len():
        if manifest[index].id == library_id:
            found = manifest[index]
            matches = matches + 1
        index = index + 1
    if matches == 1:
        return found
    nil

fn _dynsmf_trust_image(images: [DynSmfTrustArtifactImage], path: text) -> DynSmfTrustArtifactImage?:
    var found: DynSmfTrustArtifactImage? = nil
    var matches = 0
    var index = 0
    while index < images.len():
        if images[index].path == path:
            found = images[index]
            matches = matches + 1
        index = index + 1
    if matches == 1:
        return found
    nil

fn _dynsmf_trust_exports_exact(entry: DynSmfManifestEntry, bindings: [DynSmfTrustBindingConfig]) -> bool:
    if entry.exports.len() != bindings.len():
        return false
    var index = 0
    while index < bindings.len():
        if entry.exports[index] != bindings[index].export_symbol:
            return false
        index = index + 1
    true

fn _dynsmf_trust_copy_bytes(bytes: [u8]) -> [u8]:
    var retained: [u8] = []
    var index = 0
    while index < bytes.len():
        retained.push(bytes[index])
        index = index + 1
    retained

fn _dynsmf_trust_admit_parsed(manifest: [DynSmfManifestEntry], parsed: DynSmfTrustConfigParse, images: [DynSmfTrustArtifactImage]) -> DynSmfAdmittedRegistry:
    if not parsed.ok:
        return _dynsmf_trust_registry_error("trust_config_invalid:" + parsed.reason)
    if images.len() != parsed.artifacts.len():
        return _dynsmf_trust_registry_error("trust_image_count_mismatch")
    var admitted: [DynSmfAdmittedArtifact] = []
    var artifact_index = 0
    while artifact_index < parsed.artifacts.len():
        val config = parsed.artifacts[artifact_index]
        val manifest_entry = _dynsmf_trust_manifest_entry(manifest, config.library_id)
        if manifest_entry == nil:
            return _dynsmf_trust_registry_error("manifest_identity_missing_or_ambiguous:" + config.library_id)
        val entry = manifest_entry!
        if entry.path != config.path:
            return _dynsmf_trust_registry_error("manifest_path_mismatch:" + config.library_id)
        if entry.abi_version != config.abi_version:
            return _dynsmf_trust_registry_error("manifest_abi_mismatch:" + config.library_id)
        if entry.artifact_kind != config.artifact_kind or config.artifact_kind != "precompiled_smf":
            return _dynsmf_trust_registry_error("manifest_kind_mismatch:" + config.library_id)
        if not _dynsmf_trust_exports_exact(entry, config.bindings):
            return _dynsmf_trust_registry_error("manifest_exports_mismatch:" + config.library_id)
        val image = _dynsmf_trust_image(images, config.path)
        if image == nil:
            return _dynsmf_trust_registry_error("artifact_image_missing_or_ambiguous:" + config.library_id)
        val retained = _dynsmf_trust_copy_bytes(image!.artifact_bytes)
        if sha256_u8_hex(retained) != config.content_hash:
            return _dynsmf_trust_registry_error("artifact_digest_mismatch:" + config.library_id)
        val parsed_outer = aspect_pack_directory_parse_from_outer_smf_bytes(retained)
        if not parsed_outer.ok:
            return _dynsmf_trust_registry_error("artifact_aspect_pack_invalid:" + config.library_id + ":" + parsed_outer.error_code)
        var catalog_entries: [AspectCatalogEntry] = []
        var export_contracts: [AspectPackExportContract] = []
        var binding_index = 0
        while binding_index < config.bindings.len():
            val binding = config.bindings[binding_index]
            catalog_entries.push(AspectCatalogEntry(
                descriptor: AspectFacetDescriptor(
                    facet_id: binding.facet_id,
                    export_symbol: binding.export_symbol,
                    interface_abi_hash: binding.interface_abi_hash
                ),
                binding: AspectPackBinding(
                    facet_id: binding.facet_id,
                    aspect_id: binding.aspect_id,
                    library_id: config.library_id,
                    library_path: config.path,
                    library_abi_version: config.abi_version,
                    module_id: binding.module_id,
                    module_abi_hash: binding.module_abi_hash,
                    pack_content_hash: parsed_outer.directory.content_hash,
                    placement: "dynamic"
                )
            ))
            export_contracts.push(AspectPackExportContract(
                library_id: config.library_id,
                export_symbol: binding.export_symbol,
                interface_abi_hash: binding.interface_abi_hash
            ))
            binding_index = binding_index + 1
        val catalog = aspect_catalog_build(catalog_entries)
        if not catalog.ok:
            return _dynsmf_trust_registry_error("catalog_invalid:" + config.library_id + ":" + catalog.error_code)
        val exact_manifest = [entry]
        val request = AspectPackLookupRequest(
            directory: parsed_outer.directory,
            catalog: catalog.catalog,
            manifest: exact_manifest,
            artifact: AspectPackArtifactIdentity(
                library_id: config.library_id,
                path: config.path,
                content_hash: config.content_hash
            ),
            export_contracts: export_contracts,
            facet_id: config.bindings[0].facet_id
        )
        val validation = aspect_pack_directory_validate_against_manifest(
            request.directory,
            request.catalog,
            request.manifest,
            request.artifact,
            request.export_contracts
        )
        if not validation.ok:
            return _dynsmf_trust_registry_error("admission_rejected:" + config.library_id + ":" + validation.error_code)
        admitted.push(DynSmfAdmittedArtifact(
            library_id: config.library_id,
            request: request,
            artifact_bytes: retained
        ))
        artifact_index = artifact_index + 1
    DynSmfAdmittedRegistry(ok: true, reason: "admitted", artifacts: admitted)

pub fn dynsmf_admitted_registry_from_values(manifest: [DynSmfManifestEntry], config_source: text, images: [DynSmfTrustArtifactImage]) -> DynSmfAdmittedRegistry:
    _dynsmf_trust_admit_parsed(manifest, dynsmf_trust_config_parse(config_source), images)

pub fn dynsmf_admitted_registry_load(manifest: [DynSmfManifestEntry], config_path: text) -> DynSmfAdmittedRegistry:
    if config_path == "" or not rt_file_exists(config_path):
        return _dynsmf_trust_registry_error("trust_config_missing:" + config_path)
    val parsed = dynsmf_trust_config_parse(rt_file_read_text(config_path))
    if not parsed.ok:
        return _dynsmf_trust_registry_error("trust_config_invalid:" + parsed.reason)
    var images: [DynSmfTrustArtifactImage] = []
    var index = 0
    while index < parsed.artifacts.len():
        val path = parsed.artifacts[index].path
        if not rt_file_exists(path):
            return _dynsmf_trust_registry_error("artifact_file_missing:" + parsed.artifacts[index].library_id)
        # Exactly one artifact content read. The registry retains this value and
        # all startup consumers receive it directly.
        images.push(DynSmfTrustArtifactImage(path: path, artifact_bytes: rt_file_read_bytes(path)))
        index = index + 1
    _dynsmf_trust_admit_parsed(manifest, parsed, images)

pub fn dynsmf_admitted_registry_find(registry: DynSmfAdmittedRegistry, library_id: text) -> DynSmfAdmittedArtifact?:
    if not registry.ok:
        return nil
    var found: DynSmfAdmittedArtifact? = nil
    var matches = 0
    var index = 0
    while index < registry.artifacts.len():
        if registry.artifacts[index].library_id == library_id:
            found = registry.artifacts[index]
            matches = matches + 1
        index = index + 1
    if matches == 1:
        return found
    nil

pub fn dynsmf_trust_registry_default_path() -> text:
    "simple_dynsmf_trust.sdn"

export DynSmfTrustBindingConfig, DynSmfTrustArtifactConfig, DynSmfTrustConfigParse
export DynSmfTrustArtifactImage, DynSmfAdmittedArtifact, DynSmfAdmittedRegistry
