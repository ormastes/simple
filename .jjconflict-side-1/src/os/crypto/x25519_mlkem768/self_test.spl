mod os.crypto.x25519_mlkem768.self_test

use os.crypto.ml_kem.{ml_kem_keygen_checked, ml_kem_encaps_checked,
    ml_kem_decaps_checked}
use os.crypto.sha256.{sha256}

class X25519MlKem768SelfTestReceipt:
    encapsulation_key_bytes: i64
    decapsulation_key_bytes: i64
    ciphertext_bytes: i64
    shared_secret_bytes: i64
    encapsulation_key_sha256: text
    decapsulation_key_sha256: text
    ciphertext_sha256: text
    shared_secret_sha256: text

fn _oracle_seed(hex: text) -> list:
    var out: list = []
    var i: i64 = 0
    while i < hex.len():
        val hi_code = hex.char_code_at(i)
        val lo_code = hex.char_code_at(i + 1)
        val hi = if hi_code <= 57: hi_code - 48 else: hi_code - 87
        val lo = if lo_code <= 57: lo_code - 48 else: lo_code - 87
        out.push(hi * 16 + lo)
        i = i + 2
    out

fn _octets(values: list) -> [u8]:
    var out: [u8] = []
    var i: i64 = 0
    while i < values.len():
        out.push(values.get(i).to_u8())
        i = i + 1
    out

fn _hex_digit(value: i64) -> text:
    if value < 10: value.to_text()
    elif value == 10: "a"
    elif value == 11: "b"
    elif value == 12: "c"
    elif value == 13: "d"
    elif value == 14: "e"
    else: "f"

fn _digest(values: list) -> text:
    val digest = sha256(_octets(values))
    var out = ""
    var i: i64 = 0
    while i < digest.len().to_i64():
        val value = digest[i].to_i64()
        out = out + _hex_digit((value >> 4) & 15) + _hex_digit(value & 15)
        i = i + 1
    out

fn x25519_mlkem768_pure_simple_self_test() -> Result<X25519MlKem768SelfTestReceipt, text>:
    val d = _oracle_seed(
        "934d60b35624d740b30a7f227af2ae7c678e4e04e13c5f509eade2b79aea77e2")
    val z = _oracle_seed(
        "3e2a2ea6c9c476fc4937b013c993a793d6c0ab9960695ba838f649da539ca3d0")
    val pair = match ml_kem_keygen_checked(d, z):
        case Ok(value): value
        case Err(reason): return Err("ML-KEM-768 self-test keygen: " + reason)
    val (ek, dk) = pair
    val ek_digest = _digest(ek)
    val dk_digest = _digest(dk)
    if ek_digest != "c45a699a9efcb1a799578ce95f24b063b0b9ddc0879afdb3967fd9e1e3e8c247":
        return Err("ML-KEM-768 self-test encapsulation-key mismatch")
    if dk_digest != "1dc4ab0188bfd90b41bbd91884e40a41ccd0f46e5d3754b615373c9656f6af39":
        return Err("ML-KEM-768 self-test decapsulation-key mismatch")

    val encapsulated = match ml_kem_encaps_checked(ek, d):
        case Ok(value): value
        case Err(reason): return Err("ML-KEM-768 self-test encapsulation: " + reason)
    val (shared, ciphertext) = encapsulated
    val ciphertext_digest = _digest(ciphertext)
    val shared_digest = _digest(shared)
    if ciphertext_digest != "0b99b2af81971943e4ef6e6f17f42be4f3caa9fea18da0f63df1d43639a74743":
        return Err("ML-KEM-768 self-test ciphertext mismatch")
    if shared_digest != "340f07be0ffe3d996f44bb05f10eecaca6f494c77a3c353cb1872cacb834f596":
        return Err("ML-KEM-768 self-test shared-secret mismatch")

    val recovered = match ml_kem_decaps_checked(dk, ciphertext):
        case Ok(value): value
        case Err(reason): return Err("ML-KEM-768 self-test decapsulation: " + reason)
    if _digest(recovered) != shared_digest:
        return Err("ML-KEM-768 self-test recovered-secret mismatch")

    Ok(X25519MlKem768SelfTestReceipt(
        encapsulation_key_bytes: ek.len(),
        decapsulation_key_bytes: dk.len(),
        ciphertext_bytes: ciphertext.len(),
        shared_secret_bytes: shared.len(),
        encapsulation_key_sha256: ek_digest,
        decapsulation_key_sha256: dk_digest,
        ciphertext_sha256: ciphertext_digest,
        shared_secret_sha256: shared_digest))

export X25519MlKem768SelfTestReceipt, x25519_mlkem768_pure_simple_self_test
