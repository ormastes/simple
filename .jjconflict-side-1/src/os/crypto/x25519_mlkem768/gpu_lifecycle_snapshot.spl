# Typed, backend-neutral lifecycle snapshots for X25519MLKEM768 GPU work.
# This owner performs no device I/O and carries no qualification policy.

mod os.crypto.x25519_mlkem768.gpu_lifecycle_snapshot

val X25519_MLKEM768_GPU_LIFECYCLE_COUNTER_MAX: i64 = 9223372036854775807

struct X25519MlKem768GpuLifecycleSnapshot:
    transfer_count: i64
    launch_count: i64
    synchronization_count: i64
    readback_count: i64
    kernel_count: i64

struct X25519MlKem768GpuLifecycleDelta:
    transfer_count: i64
    launch_count: i64
    synchronization_count: i64
    readback_count: i64
    kernel_count: i64

fn x25519_mlkem768_gpu_lifecycle_snapshot(
        transfer_count: i64, launch_count: i64,
        synchronization_count: i64, readback_count: i64,
        kernel_count: i64) -> X25519MlKem768GpuLifecycleSnapshot:
    X25519MlKem768GpuLifecycleSnapshot(
        transfer_count: transfer_count,
        launch_count: launch_count,
        synchronization_count: synchronization_count,
        readback_count: readback_count,
        kernel_count: kernel_count)

fn x25519_mlkem768_gpu_lifecycle_snapshot_reason(
        snapshot: X25519MlKem768GpuLifecycleSnapshot) -> text:
    if snapshot.transfer_count < 0:
        return "gpu-lifecycle-transfer-negative"
    if snapshot.launch_count < 0:
        return "gpu-lifecycle-launch-negative"
    if snapshot.synchronization_count < 0:
        return "gpu-lifecycle-synchronization-negative"
    if snapshot.readback_count < 0:
        return "gpu-lifecycle-readback-negative"
    if snapshot.kernel_count < 0:
        return "gpu-lifecycle-kernel-negative"
    # i64::MAX remains a representable terminal observation. Executors reject
    # another event before increment; any wrapped value is negative and is
    # rejected above. Monotonic ordering is checked before subtraction.
    ""

fn x25519_mlkem768_gpu_lifecycle_delta_valid(
        delta: X25519MlKem768GpuLifecycleDelta) -> bool:
    val kernel_count = delta.kernel_count
    kernel_count > 0 and
        delta.transfer_count == kernel_count and
        delta.launch_count == kernel_count and
        delta.synchronization_count == kernel_count and
        delta.readback_count == kernel_count

fn x25519_mlkem768_gpu_lifecycle_delta(
        baseline: X25519MlKem768GpuLifecycleSnapshot,
        current: X25519MlKem768GpuLifecycleSnapshot
) -> Result<X25519MlKem768GpuLifecycleDelta, text>:
    val baseline_reason = x25519_mlkem768_gpu_lifecycle_snapshot_reason(
        baseline)
    if baseline_reason != "":
        return Err("gpu-lifecycle-baseline-invalid:" + baseline_reason)
    val current_reason = x25519_mlkem768_gpu_lifecycle_snapshot_reason(current)
    if current_reason != "":
        return Err("gpu-lifecycle-current-invalid:" + current_reason)
    if baseline.transfer_count > current.transfer_count:
        return Err("gpu-lifecycle-transfer-baseline-future")
    if baseline.launch_count > current.launch_count:
        return Err("gpu-lifecycle-launch-baseline-future")
    if baseline.synchronization_count > current.synchronization_count:
        return Err("gpu-lifecycle-synchronization-baseline-future")
    if baseline.readback_count > current.readback_count:
        return Err("gpu-lifecycle-readback-baseline-future")
    if baseline.kernel_count > current.kernel_count:
        return Err("gpu-lifecycle-kernel-baseline-future")
    val delta = X25519MlKem768GpuLifecycleDelta(
        transfer_count: current.transfer_count - baseline.transfer_count,
        launch_count: current.launch_count - baseline.launch_count,
        synchronization_count: current.synchronization_count -
            baseline.synchronization_count,
        readback_count: current.readback_count - baseline.readback_count,
        kernel_count: current.kernel_count - baseline.kernel_count)
    if delta.kernel_count <= 0:
        return Err("gpu-lifecycle-kernel-delta-not-positive")
    if delta.transfer_count != delta.kernel_count:
        return Err("gpu-lifecycle-transfer-delta-mismatch")
    if delta.launch_count != delta.kernel_count:
        return Err("gpu-lifecycle-launch-delta-mismatch")
    if delta.synchronization_count != delta.kernel_count:
        return Err("gpu-lifecycle-synchronization-delta-mismatch")
    if delta.readback_count != delta.kernel_count:
        return Err("gpu-lifecycle-readback-delta-mismatch")
    Ok(delta)

export X25519MlKem768GpuLifecycleSnapshot
export X25519MlKem768GpuLifecycleDelta
export X25519_MLKEM768_GPU_LIFECYCLE_COUNTER_MAX
export x25519_mlkem768_gpu_lifecycle_snapshot
export x25519_mlkem768_gpu_lifecycle_snapshot_reason
export x25519_mlkem768_gpu_lifecycle_delta
export x25519_mlkem768_gpu_lifecycle_delta_valid
