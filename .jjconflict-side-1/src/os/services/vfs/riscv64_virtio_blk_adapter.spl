# RV64 legacy-PCI VirtIO-BLK adapter for the shared FAT32 implementation.

use os.services.block_device.{BlockDevice}

extern fn rt_riscv64_virtio_blk_fat32_init() -> i64
extern fn rt_riscv64_virtio_blk_fat32_capacity_sectors() -> i64
extern fn rt_riscv64_virtio_blk_fat32_read_sector_bytes(lba: u64) -> [u8]

class Riscv64VirtioBlkAdapter:
    capacity_sectors: u64

impl Riscv64VirtioBlkAdapter:
    static fn initialize() -> Result<Riscv64VirtioBlkAdapter, text>:
        val init = rt_riscv64_virtio_blk_fat32_init()
        if init != 0:
            return Err("riscv64 virtio-blk init failed rc={init}")
        val capacity = rt_riscv64_virtio_blk_fat32_capacity_sectors()
        if capacity <= 0:
            return Err("riscv64 virtio-blk capacity unavailable")
        Ok(Riscv64VirtioBlkAdapter(capacity_sectors: capacity.to_u64()))

impl BlockDevice for Riscv64VirtioBlkAdapter:
    me fn read_sector(lba: u64) -> Result<[u8], text>:
        if lba >= self.capacity_sectors:
            return Err("riscv64 virtio-blk read beyond capacity")
        val bytes = rt_riscv64_virtio_blk_fat32_read_sector_bytes(lba)
        if bytes.len() != 512:
            return Err("riscv64 virtio-blk sector read failed")
        Ok(bytes)

    me fn write_sector(lba: u64, data: [u8]) -> Result<bool, text>:
        val _lba = lba
        val _data = data
        Err("riscv64 virtio-blk FAT32 media is read-only")

    me fn sector_size() -> u32:
        512u32
