# container-manager — Podman design on MDSOC+ (userland service capsule).
#
# MDSOC+ shape: this is a USERLAND service, so it is one MDSOC capsule (outer:
# manifest + ports + capabilities + lifecycle) wrapping an ECS `World` business
# layer (inner). Kernel-side namespace/capability ENFORCEMENT stays MDSOC-only
# in src/os/kernel/loader/container_namespace.spl — this capsule only builds the
# handles the kernel then enforces; it is orchestration, not the security
# boundary.
#
# Design: doc/04_architecture/os/container/podman_mdsoc_container_arch.md
#
# ECS uses plain component structs + a `ContainerWorld` holding parallel
# component arrays keyed by entity index (one Container entity == one index).
# Pod/Image/Monitor are components on that entity or a side Pod table.
#
# Self-hosted-defect discipline (see lane notes):
#  - the World holds its component arrays DIRECTLY (single field hop); mutations
#    go through extract-mutate-writeback (var s = self.x; s[i] = ...; self.x = s)
#    so a write is never lost through a two-hop method call.
#  - imported method bodies use bare Ok/Err (never Result.Ok) — N/A here, no
#    Result crossing a module boundary.
#  - no `{`/`}` literals in strings.

use os.kernel.loader.container_namespace.{ContainerNamespaceView, container_view_rootless, container_view_create, container_view_allows_path, container_view_allows_pid, container_view_path_decision, container_view_pid_decision}
use os.services.container.container_storage.{LayerStore, ImageLayer, CowSnapshot, Volume}
use os.services.service_manifest.{ServiceManifest, can_start, mark_starting, mark_ready, mark_stopping, mark_stopped, record_health, record_heartbeat, check_watchdog, should_restart, on_restart, holds_grants}

# ============================================================================
# Shared-namespace mask bits (which namespaces a pod member shares with its pod)
# ============================================================================
val NS_NET: u32 = 1u32
val NS_IPC: u32 = 2u32
val NS_MOUNT: u32 = 4u32
val NS_PID: u32 = 8u32
val NS_UTS: u32 = 16u32

fn mask_has(mask: u32, bit: u32) -> bool:
    (mask & bit) != 0u32

# ============================================================================
# ECS components (data-only structs)
# ============================================================================

struct ContainerId:
    """Stable identity of a Container entity."""
    id: u64
    name: text

struct PodMembership:
    """Pod the container belongs to + which namespaces it shares with the pod.
    pod_id == 0 means "not in a pod". shared_ns_mask uses the NS_* bits."""
    pod_id: u64
    shared_ns_mask: u32

struct NamespaceView:
    """Wraps the kernel ContainerNamespaceView (the ENFORCED VFS/pid boundary)
    plus the manager-held net/ipc endpoint handles. handle == 0 means "no
    endpoint" (rootless default holds none until sys_pod_wire / sys_start)."""
    view: ContainerNamespaceView
    net_handle: u64
    ipc_handle: u64

struct ResourceDomain:
    """cgroup-shaped quotas: cpu shares, mem bytes, io weight, pids cap."""
    cpu: u64
    mem: u64
    io: u64
    pids: u64

struct ImageSnapshot:
    """Content-addressed RO base + COW writable layer id + per-container quota."""
    base_digest: text
    cow_layer: text
    quota: u64

struct Lifecycle:
    """created | running | paused | stopped | exited. exit_code is meaningful
    only when state == "exited" (else -1)."""
    state: text
    exit_code: i64

struct MonitorHandle:
    """Per-container monitor capsule handle + its last-known state (daemonless:
    one monitor per container, no central root daemon)."""
    handle: u64
    last_state: text

struct MonitorReport:
    """What the per-container monitor capsule (Podman's `conmon` role) OBSERVED
    about its workload, waiting to be consumed by sys_monitor. The monitor
    observes; the manager records. `pending` is true between the monitor
    posting an observation and sys_monitor consuming it. state is one of
    "none" | "running" | "exited" | "crashed"; exit_code is meaningful only for
    exited/crashed (else -1)."""
    pending: bool
    state: text
    exit_code: i64

struct RestartPolicy:
    """Podman-shaped restart policy: "no" | "on-failure" | "always".
    `retries` counts restarts already performed against `max_retries`."""
    policy: text
    max_retries: i64
    retries: i64

# ============================================================================
# Pod side table (a Pod entity owns the shared net/ipc endpoints)
# ============================================================================

struct Pod:
    """A pod: an id + the net/ipc endpoints its members may share."""
    id: u64
    net_handle: u64
    ipc_handle: u64

# ============================================================================
# ContainerSpec / SpawnRequest — the MODEL of a kernel SpawnSpec.
#
# We do NOT call the live spawn syscall. sys_start builds a ContainerSpec from
# the NamespaceView + ResourceDomain and maps it to a SpawnRequest whose caps
# are a SUBSET of what was granted at create time (never amplified).
# ============================================================================

struct ContainerSpec:
    """Assembled from a container's view + resource domain at start time."""
    image_digest: text
    root: text
    caps: [text]
    budget: u64

struct SpawnRequest:
    """The model of a kernel SpawnSpec submission (image + attenuated pouch)."""
    image_digest: text
    isolation: text
    caps: [text]
    budget: u64

# Subset check: is every element of `child` present in `parent`?
# Used to prove the daemonless / no-ambient property: a spawn request's caps
# can only be a subset of the granted authority, never amplified.
fn caps_is_subset(child: [text], parent: [text]) -> bool:
    var i = 0
    while i < child.len():
        val needle = child[i]
        var found = false
        var j = 0
        while j < parent.len():
            if parent[j] == needle:
                found = true
            j = j + 1
        if not found:
            return false
        i = i + 1
    true

# ============================================================================
# service_v1 MANIFEST DECLARATION — the container-manager *service* itself.
#
# Distinct from the per-CONTAINER lifecycle above: this is what the manager
# publishes about ITSELF to a supervisor (master plan §4 service_v1, §20
# health/watchdog, §21 restart-drops-stale-grants). The declaration is pure
# data; the lifecycle hooks below map it onto the manager's EXISTING
# start/stop/monitor machinery — no second mechanism is introduced.
# ============================================================================

fn container_manager_manifest() -> ServiceManifest:
    """Declared service_v1 manifest for the container-manager service.

    readiness_deps mirror what sys_create/sys_start actually need before they
    can do anything: a filesystem to resolve container roots through (vfs) and
    a process manager to hand SpawnRequests to (pm). required_capabilities are
    the grants the manager must hold to broker container authority at all.
    """
    var m = ServiceManifest.create("container-manager", "service_v1")
    m.required_capabilities = ["cap.spawn", "cap.fs_mount", "cap.resource_domain"]
    m.readiness_deps = ["vfs", "pm"]
    m.health_check_kind = "heartbeat"
    m.restart_policy = "on_failure"
    m.max_restarts = 3
    m.watchdog_timeout_ms = 5000
    m

# ============================================================================
# ContainerWorld — the ECS business layer inside the capsule.
# Parallel component arrays; entity == index. Held DIRECTLY (single field hop).
# ============================================================================

class ContainerWorld:
    ids: [ContainerId]
    pods_of: [PodMembership]
    views: [NamespaceView]
    domains: [ResourceDomain]
    images: [ImageSnapshot]
    lifecycles: [Lifecycle]
    monitors: [MonitorHandle]
    # Pending observations posted by each container's monitor capsule.
    reports: [MonitorReport]
    # Per-container restart policy (default "no").
    restarts: [RestartPolicy]
    # Authority granted to each container at create time — the parent set the
    # sys_start spawn request must stay a subset of.
    granted_caps: [[text]]
    # CEILING columns — the create-time authority, kept for the lifetime of the
    # entity. granted_caps[i] is emptied on stop/exit (§21, no stale grant), so
    # it cannot itself bound a RESTART; without a separate ceiling sys_restart
    # took any caps and any root the caller named and a crash-loop became a
    # privilege-escalation primitive (bug
    # container_restart_no_cap_ceiling_2026-07-27). These are set once by
    # sys_create and never widened.
    ceiling_caps: [[text]]
    ceiling_roots: [text]
    # Side table of pods.
    pods: [Pod]
    # §6.4 image/volume store: content-addressed RO layers + COW snapshots +
    # explicit volumes + ref-tracked GC. Held DIRECTLY (single field hop);
    # every mutation goes through extract-mutate-writeback.
    store: LayerStore
    # service_v1 manifest for the container-manager SERVICE (not a container).
    # Held DIRECTLY (single field hop) and mutated only through
    # extract-mutate-writeback, same as every other component column.
    manifest: ServiceManifest
    next_id: u64

impl ContainerWorld:
    static fn new() -> ContainerWorld:
        ContainerWorld(
            ids: [],
            pods_of: [],
            views: [],
            domains: [],
            images: [],
            lifecycles: [],
            monitors: [],
            reports: [],
            restarts: [],
            granted_caps: [],
            ceiling_caps: [],
            ceiling_roots: [],
            pods: [],
            store: LayerStore.new(),
            manifest: container_manager_manifest(),
            next_id: 1u64
        )

    fn count(self) -> i64:
        self.ids.len()

    # --- accessors (spec asserts through returned values, not module vars) ---

    fn view_of(self, idx: i64) -> NamespaceView:
        self.views[idx]

    fn kernel_view_of(self, idx: i64) -> ContainerNamespaceView:
        """The kernel view a LIVE lookup site enforces through.

        This is the handoff used by `VfsManager.enter_container_view` in
        src/os/services/vfs/vfs.spl — the one place container isolation stops
        being a model and becomes a decision on a real path lookup. A stopped or
        reaped container's slot already holds `container_view_rootless()`
        (see sys_stop / reap_monitor_reports below), so a lookup performed on
        behalf of a dead container resolves nothing.
        """
        self.views[idx].view

    fn lifecycle_state(self, idx: i64) -> text:
        self.lifecycles[idx].state

    fn lifecycle_exit(self, idx: i64) -> i64:
        self.lifecycles[idx].exit_code

    fn monitor_state(self, idx: i64) -> text:
        self.monitors[idx].last_state

    fn granted_of(self, idx: i64) -> [text]:
        self.granted_caps[idx]

    # Delegate path/pid decisions to the KERNEL primitive — the kernel view is
    # the oracle; the manager never re-implements namespace lookup.
    fn allows_path(self, idx: i64, path: text) -> bool:
        container_view_allows_path(self.views[idx].view, path)

    fn allows_pid(self, idx: i64, pid: u64) -> bool:
        container_view_allows_pid(self.views[idx].view, pid)

    fn path_decision(self, idx: i64, path: text) -> text:
        container_view_path_decision(self.views[idx].view, path)

    fn pid_decision(self, idx: i64, pid: u64) -> text:
        container_view_pid_decision(self.views[idx].view, pid)

    # ------------------------------------------------------------------------
    # sys_create — allocate a container. Build a ROOTLESS view first (denies
    # everything), then add ONLY the declared root + pids. NO start.
    # `seed_global_root` exists solely so the spec can prove it can FAIL: seed a
    # "/" root instead of rootless and the deny oracles break. Production callers
    # pass false.
    # ------------------------------------------------------------------------
    me sys_create(name: text, root: text, pids: [u64], image_digest: text, cpu: u64, mem: u64, io: u64, pid_quota: u64, granted: [text], seed_global_root: bool) -> i64:
        # Rootless by construction: begin from the deny-everything view.
        var view = container_view_rootless()
        # Add ONLY the explicitly declared handles. A rootless container never
        # holds a global root it must shed.
        if seed_global_root:
            # DEFECT-INJECTION path (spec fail-once proof): a global "/" root.
            view = container_view_create("/", pids)
        else:
            view = container_view_create(root, pids)

        val cid = self.next_id
        # The COW writable layer id must be UNIQUE PER CONTAINER. It used to be
        # `image_digest + ":cow"`, so two containers branched off the same
        # content-addressed base were handed the SAME writable layer id — in a
        # real COW backend that is one shared writable layer, i.e. container A
        # reading and writing container B's files (bug
        # container_cow_layer_id_aliased_across_containers_2026-07-27).
        # The container id disambiguates; the base digest stays in the name so
        # the parent chain is still readable.
        val cow = image_digest + ":cow:" + "{cid}"

        var a_ids = self.ids
        a_ids = a_ids.push(ContainerId(id: cid, name: name))
        self.ids = a_ids

        var a_pods = self.pods_of
        a_pods = a_pods.push(PodMembership(pod_id: 0u64, shared_ns_mask: 0u32))
        self.pods_of = a_pods

        var a_views = self.views
        a_views = a_views.push(NamespaceView(view: view, net_handle: 0u64, ipc_handle: 0u64))
        self.views = a_views

        var a_dom = self.domains
        a_dom = a_dom.push(ResourceDomain(cpu: cpu, mem: mem, io: io, pids: pid_quota))
        self.domains = a_dom

        var a_img = self.images
        a_img = a_img.push(ImageSnapshot(base_digest: image_digest, cow_layer: cow, quota: mem))
        self.images = a_img

        var a_life = self.lifecycles
        a_life = a_life.push(Lifecycle(state: "created", exit_code: -1))
        self.lifecycles = a_life

        var a_mon = self.monitors
        a_mon = a_mon.push(MonitorHandle(handle: 0u64, last_state: "none"))
        self.monitors = a_mon

        var a_rep = self.reports
        a_rep = a_rep.push(MonitorReport(pending: false, state: "none", exit_code: -1))
        self.reports = a_rep

        var a_rs = self.restarts
        a_rs = a_rs.push(RestartPolicy(policy: "no", max_retries: 0, retries: 0))
        self.restarts = a_rs

        var a_grant = self.granted_caps
        a_grant = a_grant.push(granted)
        self.granted_caps = a_grant

        # Freeze the create-time authority as this entity's permanent ceiling.
        # `granted` is the maximum this container may EVER hold; `view.root` the
        # widest subtree it may ever resolve through. sys_restart attenuates
        # against these, so a restart can only ever narrow authority.
        var a_ceil = self.ceiling_caps
        a_ceil = a_ceil.push(granted)
        self.ceiling_caps = a_ceil

        var a_croot = self.ceiling_roots
        a_croot = a_croot.push(view.root)
        self.ceiling_roots = a_croot

        # §6.4: creating a container branches a COW writable snapshot off the
        # immutable content-addressed RO base. The base layer itself is added to
        # the store by the image import path (store_add_layer), not here — a
        # container may legitimately reference a base that lives in a store the
        # manager only has a handle to.
        var st = self.store
        st.add_snapshot(cow, image_digest, cid, mem)
        self.store = st

        self.next_id = cid + 1u64
        self.ids.len() - 1

    # ------------------------------------------------------------------------
    # Pod registration + sys_pod_wire.
    # ------------------------------------------------------------------------
    me create_pod(net_handle: u64, ipc_handle: u64) -> u64:
        val pid = self.next_id
        var a = self.pods
        a = a.push(Pod(id: pid, net_handle: net_handle, ipc_handle: ipc_handle))
        self.pods = a
        self.next_id = pid + 1u64
        pid

    fn find_pod(self, pod_id: u64) -> Pod:
        var i = 0
        while i < self.pods.len():
            if self.pods[i].id == pod_id:
                return self.pods[i]
            i = i + 1
        Pod(id: 0u64, net_handle: 0u64, ipc_handle: 0u64)

    # For a pod member, share the pod's net/ipc namespace (component reference by
    # endpoint handle). NEVER share mount(root) or pid unless explicitly declared
    # in shared_ns_mask — mount/pid stay the container's own confined view.
    me sys_pod_wire(idx: i64, pod_id: u64, shared_ns_mask: u32):
        val pod = self.find_pod(pod_id)

        var a_pods = self.pods_of
        a_pods[idx] = PodMembership(pod_id: pod_id, shared_ns_mask: shared_ns_mask)
        self.pods_of = a_pods

        val cur = self.views[idx]
        var net = cur.net_handle
        var ipc = cur.ipc_handle
        if mask_has(shared_ns_mask, NS_NET):
            net = pod.net_handle
        if mask_has(shared_ns_mask, NS_IPC):
            ipc = pod.ipc_handle
        # cur.view (mount/pid boundary) is passed through UNCHANGED: sharing net
        # or ipc never widens the filesystem/pid view. Mount/pid sharing is out
        # of scope for this increment (would require a merged kernel view).
        var a_views = self.views
        a_views[idx] = NamespaceView(view: cur.view, net_handle: net, ipc_handle: ipc)
        self.views = a_views

    # ------------------------------------------------------------------------
    # sys_start — assemble a ContainerSpec from view+domain, map to a
    # SpawnRequest whose caps are a SUBSET of granted, set Lifecycle=running,
    # attach a MonitorHandle. Does NOT call the live spawn syscall.
    # ------------------------------------------------------------------------
    fn build_spec(self, idx: i64) -> ContainerSpec:
        val img = self.images[idx]
        val dom = self.domains[idx]
        val view = self.views[idx]
        # The spawn request asks for exactly the granted authority (attenuation
        # could narrow further; it can NEVER add). Model: request caps = granted.
        ContainerSpec(
            image_digest: img.base_digest,
            root: view.view.root,
            caps: self.granted_caps[idx],
            budget: dom.mem
        )

    fn to_spawn_request(self, spec: ContainerSpec) -> SpawnRequest:
        SpawnRequest(
            image_digest: spec.image_digest,
            isolation: "container",
            caps: spec.caps,
            budget: spec.budget
        )

    me sys_start(idx: i64) -> SpawnRequest:
        val spec = self.build_spec(idx)
        val req = self.to_spawn_request(spec)

        var a_life = self.lifecycles
        a_life[idx] = Lifecycle(state: "running", exit_code: -1)
        self.lifecycles = a_life

        var a_mon = self.monitors
        val h = self.ids[idx].id
        a_mon[idx] = MonitorHandle(handle: h, last_state: "running")
        self.monitors = a_mon
        req

    # ------------------------------------------------------------------------
    # sys_stop — ordered stop/crash revocation (driver §7.3 order, at container
    # granularity):
    #   1. stop scheduling
    #   2. revoke net/ipc endpoints
    #   3. release device grants
    #   4. unmap volumes
    #   5. collect exit
    #   6. free resource domain
    # §21 invariant: a stopped container's NamespaceView resolves NOTHING — it
    # retains no stale root/pid/endpoint/secret grant. We collapse the view back
    # to rootless (deny-everything) so every previously-allowed path/pid denies.
    # ------------------------------------------------------------------------
    me sys_stop(idx: i64) -> Lifecycle:
        # 1. stop scheduling.
        var a_life = self.lifecycles
        a_life[idx] = Lifecycle(state: "stopped", exit_code: 0)
        self.lifecycles = a_life

        # 2. revoke net/ipc endpoints + collapse the kernel view to rootless so
        #    it resolves nothing (device grants (3) / volumes (4) are folded into
        #    the same deny-everything collapse for this model increment).
        var a_views = self.views
        a_views[idx] = NamespaceView(view: container_view_rootless(), net_handle: 0u64, ipc_handle: 0u64)
        self.views = a_views

        # 5. collect exit — reflected in Lifecycle.exit_code above; monitor reaped.
        var a_mon = self.monitors
        a_mon[idx] = MonitorHandle(handle: 0u64, last_state: "stopped")
        self.monitors = a_mon

        # 6. free resource domain — quotas returned to the pool.
        var a_dom = self.domains
        a_dom[idx] = ResourceDomain(cpu: 0u64, mem: 0u64, io: 0u64, pids: 0u64)
        self.domains = a_dom

        # Drop granted authority — no lingering pouch.
        var a_grant = self.granted_caps
        a_grant[idx] = []
        self.granted_caps = a_grant

        self.lifecycles[idx]

    # ------------------------------------------------------------------------
    # sys_monitor — poll each container's MonitorHandle.
    #
    # Podman's per-container conmon model: the MONITOR observes the workload,
    # the MANAGER records the observation. A monitor capsule posts what it saw
    # (post_monitor_report — this is the model of the monitor's event port; the
    # capsule is spawned with only that container's caps, so it can observe
    # nothing else). sys_monitor is the system that sweeps the world and
    # consumes every pending observation.
    #
    # On a workload exit (clean OR crash) we set Lifecycle = exited(code) and
    # REAP: the monitor handle goes to 0 and the container's authority is torn
    # down exactly as in sys_stop — view collapsed to rootless, resource domain
    # freed, granted pouch emptied. That is the §21 rule already proven for
    # services: a crashed container becomes eligible for its restart policy but
    # retains NO stale grant. On restart the grants are RE-ACQUIRED
    # (sys_restart takes a fresh set), never inherited from the dead instance.
    #
    # Returns how many containers were reaped by this pass.
    # ------------------------------------------------------------------------
    me post_monitor_report(idx: i64, state: text, exit_code: i64):
        var a_rep = self.reports
        a_rep[idx] = MonitorReport(pending: true, state: state, exit_code: exit_code)
        self.reports = a_rep

    fn report_pending(self, idx: i64) -> bool:
        self.reports[idx].pending

    me sys_monitor() -> i64:
        var reaped = 0
        var i = 0
        while i < self.ids.len():
            val r = self.reports[i]
            if r.pending:
                if r.state == "exited" or r.state == "crashed":
                    # Record the exact exit code the monitor observed.
                    var a_life = self.lifecycles
                    a_life[i] = Lifecycle(state: "exited", exit_code: r.exit_code)
                    self.lifecycles = a_life

                    # Reap: the per-container monitor is done.
                    var a_mon = self.monitors
                    a_mon[i] = MonitorHandle(handle: 0u64, last_state: "reaped")
                    self.monitors = a_mon

                    # §21 — an exited container retains NO stale grant. Collapse
                    # the kernel view to rootless (resolves nothing), free the
                    # resource domain, drop the granted pouch.
                    var a_views = self.views
                    a_views[i] = NamespaceView(view: container_view_rootless(), net_handle: 0u64, ipc_handle: 0u64)
                    self.views = a_views

                    var a_dom = self.domains
                    a_dom[i] = ResourceDomain(cpu: 0u64, mem: 0u64, io: 0u64, pids: 0u64)
                    self.domains = a_dom

                    var a_grant = self.granted_caps
                    a_grant[i] = []
                    self.granted_caps = a_grant

                    reaped = reaped + 1
                else:
                    # Still alive — only the last-known state moves.
                    var a_mon_live = self.monitors
                    a_mon_live[i] = MonitorHandle(handle: self.monitors[i].handle, last_state: r.state)
                    self.monitors = a_mon_live

                # Observation consumed.
                var a_done = self.reports
                a_done[i] = MonitorReport(pending: false, state: r.state, exit_code: r.exit_code)
                self.reports = a_done
            i = i + 1
        reaped

    # ------------------------------------------------------------------------
    # Restart policy — a crashed container is ELIGIBLE for restart, but the
    # restart re-acquires authority from scratch.
    # ------------------------------------------------------------------------
    me set_restart_policy(idx: i64, policy: text, max_retries: i64):
        var a_rs = self.restarts
        a_rs[idx] = RestartPolicy(policy: policy, max_retries: max_retries, retries: 0)
        self.restarts = a_rs

    fn restart_policy_of(self, idx: i64) -> text:
        self.restarts[idx].policy

    fn restart_retries(self, idx: i64) -> i64:
        self.restarts[idx].retries

    fn restart_eligible(self, idx: i64) -> bool:
        val lc = self.lifecycles[idx]
        if lc.state != "exited":
            return false
        val rp = self.restarts[idx]
        if rp.retries >= rp.max_retries:
            return false
        if rp.policy == "always":
            return true
        if rp.policy == "on-failure":
            return lc.exit_code != 0
        false

    # The create-time ceiling this entity can never exceed.
    fn ceiling_of(self, idx: i64) -> [text]:
        self.ceiling_caps[idx]

    fn ceiling_root_of(self, idx: i64) -> text:
        self.ceiling_roots[idx]

    # Attenuate a re-acquisition request against the ceiling: keep only caps the
    # container was granted at CREATE time. Never amplifies — the result is a
    # subset of both the request and the ceiling.
    fn attenuate_caps(self, idx: i64, requested: [text]) -> [text]:
        val ceiling = self.ceiling_caps[idx]
        var out: [text] = []
        var i = 0
        while i < requested.len():
            val c = requested[i]
            var allowed = false
            var j = 0
            while j < ceiling.len():
                if ceiling[j] == c:
                    allowed = true
                j = j + 1
            if allowed:
                out = out.push(c)
            i = i + 1
        out

    # A restart may re-declare a root at or BELOW the create-time root, never
    # above it (and never the host root "/" unless that is what was created).
    # Anything wider collapses to the ceiling root — fail-closed, never widened.
    fn clamp_root(self, idx: i64, root: text) -> text:
        val ceiling = self.ceiling_roots[idx]
        if ceiling == "":
            return ""
        if root == ceiling:
            return ceiling
        if root.starts_with(ceiling + "/"):
            if not root.contains(".."):
                return root
        ceiling

    # sys_restart — bring an exited container back. EVERY grant is supplied
    # afresh by the caller (root/pids/caps/quotas): nothing is inherited from
    # the dead instance, because sys_monitor already emptied all of it. This is
    # the §21 service rule applied to containers.
    #
    # §21 says nothing may SURVIVE a restart; it does not by itself stop a
    # restart from asking for MORE. The re-acquisition is therefore attenuated
    # against the frozen create-time ceiling (caps AND root) — a crash-loop is
    # not a privilege-escalation primitive.
    me sys_restart(idx: i64, reacquired: [text], root: text, pids: [u64], cpu: u64, mem: u64, io: u64, pid_quota: u64) -> SpawnRequest:
        # Re-acquire the namespace view from a rootless base + the freshly
        # declared handles (never the stale collapsed view), clamped to the
        # create-time root.
        val safe_root = self.clamp_root(idx, root)
        var a_views = self.views
        a_views[idx] = NamespaceView(view: container_view_create(safe_root, pids), net_handle: 0u64, ipc_handle: 0u64)
        self.views = a_views

        # Re-mint the resource domain.
        var a_dom = self.domains
        a_dom[idx] = ResourceDomain(cpu: cpu, mem: mem, io: io, pids: pid_quota)
        self.domains = a_dom

        # Re-acquire the capability pouch, attenuated against the ceiling.
        var a_grant = self.granted_caps
        a_grant[idx] = self.attenuate_caps(idx, reacquired)
        self.granted_caps = a_grant

        var a_rs = self.restarts
        val rp = self.restarts[idx]
        a_rs[idx] = RestartPolicy(policy: rp.policy, max_retries: rp.max_retries, retries: rp.retries + 1)
        self.restarts = a_rs

        # Inlined sys_start (assemble spec → spawn request → running + monitor).
        val spec = self.build_spec(idx)
        val req = self.to_spawn_request(spec)

        var a_life = self.lifecycles
        a_life[idx] = Lifecycle(state: "running", exit_code: -1)
        self.lifecycles = a_life

        var a_mon = self.monitors
        a_mon[idx] = MonitorHandle(handle: self.ids[idx].id, last_state: "running")
        self.monitors = a_mon

        var a_rep = self.reports
        a_rep[idx] = MonitorReport(pending: false, state: "running", exit_code: -1)
        self.reports = a_rep
        req

    # ------------------------------------------------------------------------
    # §6.4 image / volume store surface (extract-mutate-writeback throughout).
    # ------------------------------------------------------------------------
    me store_add_layer(digest: text, parent: text, size: u64) -> bool:
        var st = self.store
        val ok = st.add_layer(digest, parent, size)
        self.store = st
        ok

    me attach_volume(idx: i64, name: text, dest: text, persistent: bool):
        var st = self.store
        st.add_volume(name, dest, persistent, self.ids[idx].id)
        self.store = st

    # Atomic rollback of a container to its RO base. Returns the base digest,
    # or "" when nothing changed.
    me snapshot_rollback_of(idx: i64) -> text:
        var st = self.store
        val base = st.rollback_owner(self.ids[idx].id)
        self.store = st
        base

    me snapshot_write_of(idx: i64, bytes: u64) -> bool:
        var st = self.store
        val ok = st.snapshot_write(self.ids[idx].id, bytes)
        self.store = st
        ok

    fn layer_refcount_of(self, digest: text) -> i64:
        self.store.refcount(digest)

    fn store_layer_count(self) -> i64:
        self.store.layer_count()

    fn store_has_layer(self, digest: text) -> bool:
        self.store.has_layer(digest)

    fn snapshot_live_of(self, idx: i64) -> bool:
        self.store.snapshot_live(self.ids[idx].id)

    fn snapshot_used_of(self, idx: i64) -> u64:
        self.store.snapshot_used(self.ids[idx].id)

    fn snapshot_layer_of(self, idx: i64) -> text:
        self.store.snapshot_layer_id(self.ids[idx].id)

    fn live_snapshot_count(self) -> i64:
        self.store.live_snapshot_count()

    fn volume_live(self, name: text) -> bool:
        self.store.volume_live(name)

    fn live_volume_count(self) -> i64:
        self.store.live_volume_count()

    fn was_reclaimed(self, digest: text) -> bool:
        self.store.was_reclaimed(digest)

    # ------------------------------------------------------------------------
    # sys_gc — ref-tracked reclaim.
    #
    # For every container that is `exited` or `stopped`: release its COW
    # writable snapshot (dropping the reference it held on its RO base chain)
    # and drop its NON-persistent volumes. EXPLICIT PERSISTENT VOLUMES SURVIVE
    # container removal — the Podman/§6.4 rule. Then run the ref-counted layer
    # collection, which reclaims ONLY layers whose refcount is 0; a layer still
    # referenced by a live container (directly or through its parent chain) is
    # never touched.
    #
    # Returns the digests reclaimed by this pass.
    # ------------------------------------------------------------------------
    me sys_gc() -> [text]:
        var st = self.store
        var i = 0
        while i < self.ids.len():
            val state = self.lifecycles[i].state
            if state == "exited" or state == "stopped":
                val owner = self.ids[i].id
                st.release_snapshot(owner)
                st.drop_container_volumes(owner)
                # The ImageSnapshot component loses its writable layer; the RO
                # base digest is KEPT so the container can be re-created from
                # the same content-addressed base.
                var a_img = self.images
                val im = a_img[i]
                a_img[i] = ImageSnapshot(base_digest: im.base_digest, cow_layer: "", quota: 0u64)
                self.images = a_img
            i = i + 1
        val reclaimed = st.gc_run(false)
        self.store = st
        reclaimed

    # ------------------------------------------------------------------------
    # service_v1 LIFECYCLE HOOKS — the manager as a supervised service.
    #
    # Every hook is extract-mutate-writeback on `self.manifest` (bug
    # selfhost_two_hop_field_method_mutation_lost_2026-07-27: a
    # `self.manifest.<mutate>()` chain crossing the imported ServiceManifest
    # struct silently mutates a discarded copy). service_manifest.spl's
    # functions are pure — they RETURN a new manifest — so the write-back is
    # what actually commits the transition.
    # ------------------------------------------------------------------------

    fn svc_manifest(self) -> ServiceManifest:
        self.manifest

    fn svc_name(self) -> text:
        self.manifest.name

    fn svc_state(self) -> text:
        self.manifest.state

    fn svc_grants(self) -> [text]:
        self.manifest.granted_handles

    fn svc_restart_count(self) -> i64:
        self.manifest.restart_count

    fn svc_holds_grants(self) -> bool:
        holds_grants(self.manifest)

    # Lifecycle hook: start. Refuses (returns false, state unchanged) until
    # every declared readiness dependency is up — the manager must not create
    # containers before vfs/pm exist.
    me svc_start(ready_set: [text]) -> bool:
        if not can_start(self.manifest, ready_set):
            return false
        var m = self.manifest
        m = mark_starting(m)
        self.manifest = m
        true

    # Grant acquisition, modelled after grant_broker issuance: a started
    # service takes the device/secret handles it was authorized to hold.
    me svc_acquire_grant(handle: text):
        var m = self.manifest
        var g = m.granted_handles
        g = g.push(handle)
        m.granted_handles = g
        self.manifest = m

    me svc_ready():
        var m = self.manifest
        m = mark_ready(m)
        self.manifest = m

    me svc_heartbeat(now_ms: i64):
        var m = self.manifest
        m = record_heartbeat(m, now_ms)
        self.manifest = m

    me svc_watchdog(now_ms: i64) -> text:
        var m = self.manifest
        m = check_watchdog(m, now_ms)
        self.manifest = m
        self.manifest.state

    # Health from the manager's OWN world invariants, not a synthetic probe:
    # the manager is healthy exactly while §21 holds across every container it
    # supervises — a container that is stopped or exited must hold NO granted
    # capabilities and must resolve NOTHING (its view was collapsed to
    # rootless). Any dead container still carrying authority is a §21 breach
    # and degrades, then fails, the service.
    fn svc_world_invariant(self) -> bool:
        var i = 0
        while i < self.ids.len():
            val state = self.lifecycles[i].state
            if state == "stopped" or state == "exited":
                if self.granted_caps[i].len() > 0:
                    return false
                if container_view_allows_path(self.views[i].view, self.views[i].view.root):
                    return false
            i = i + 1
        true

    me svc_health_check() -> text:
        val ok = self.svc_world_invariant()
        var m = self.manifest
        m = record_health(m, ok)
        self.manifest = m
        self.manifest.state

    fn svc_restart_allowed(self) -> bool:
        should_restart(self.manifest.restart_policy, self.manifest.restart_count, self.manifest.max_restarts)

    # ------------------------------------------------------------------------
    # Lifecycle hook: RESTART — the §21 invariant at SERVICE granularity.
    #
    # Returns false (nothing changes) once the restart-limit is spent. On a
    # permitted restart:
    #   * on_restart() clears the manifest's granted_handles outright — the
    #     respawned manager re-acquires every device/secret grant from the
    #     broker, never inherits one;
    #   * and the authority the manager had BROKERED OUT to every container it
    #     supervised is torn down the same way (pouch emptied, kernel view
    #     collapsed to rootless), because a manager that died cannot vouch for
    #     grants it can no longer supervise.
    # ------------------------------------------------------------------------
    me svc_restart() -> bool:
        if not self.svc_restart_allowed():
            return false

        # 1. Manifest-level §21: drop every grant the SERVICE held.
        var m = self.manifest
        m = on_restart(m)
        self.manifest = m

        # 2. World-level §21: drop every grant the service had brokered out.
        var a_grant = self.granted_caps
        var a_views = self.views
        var i = 0
        while i < self.ids.len():
            a_grant[i] = []
            a_views[i] = NamespaceView(view: container_view_rootless(), net_handle: 0u64, ipc_handle: 0u64)
            i = i + 1
        self.granted_caps = a_grant
        self.views = a_views

        # 3. Re-enter Starting — grants must be re-acquired before Ready.
        var m2 = self.manifest
        m2 = mark_starting(m2)
        self.manifest = m2
        true

    me svc_stop():
        var m = self.manifest
        m = mark_stopping(m)
        self.manifest = m
        var m2 = self.manifest
        m2 = mark_stopped(m2)
        self.manifest = m2
