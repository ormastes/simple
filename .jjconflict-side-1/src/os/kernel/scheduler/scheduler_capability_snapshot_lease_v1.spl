# Scheduler-private, bounded capability snapshot leases.
#
# Lock order is strict: the Scheduler/TCB owner must be held before issue(),
# then this registry mutex may be acquired. consume() acquires only the registry
# mutex and must never call back into Scheduler. This prevents lock inversion.

use os.kernel.types.capability_types.{CapabilitySet, CapabilityToken}
use std.thread_sffi.{mutex_raw_create, mutex_raw_lock, mutex_raw_unlock}

pub(package) struct SchedulerCapabilitySnapshotLeaseV1:
    _slot: i64
    _generation: u64
    _nonce: u64

pub(package) struct SchedulerPinnedCapabilitySnapshotV1:
    _task_id: u64
    _lifecycle_generation: u64
    _exec_generation: u64
    # Concrete tokens are copied into this package-private value. No mutable
    # CapabilitySet and no registry locator crosses the scheduler package.
    _concrete_tokens: [CapabilityToken]

pub struct SchedulerCurrentExecutionSnapshotV1:
    """Atomic Scheduler view used by authenticated syscall ingress.

    The coordinates and pledged capability lease are copied from one current
    TCB observation.  Consumers cannot substitute independently sampled task
    identity or generation values.
    """
    task_id: u64
    lifecycle_generation: u64
    exec_generation: u64
    admitted: bool
    lease: SchedulerCapabilitySnapshotLeaseV1

pub fn scheduler_current_execution_snapshot_task_id_v1(
    snapshot: SchedulerCurrentExecutionSnapshotV1
) -> u64:
    snapshot.task_id

pub fn scheduler_current_execution_snapshot_lifecycle_generation_v1(
    snapshot: SchedulerCurrentExecutionSnapshotV1
) -> u64:
    snapshot.lifecycle_generation

pub fn scheduler_current_execution_snapshot_exec_generation_v1(
    snapshot: SchedulerCurrentExecutionSnapshotV1
) -> u64:
    snapshot.exec_generation

pub fn scheduler_current_execution_snapshot_admitted_v1(
    snapshot: SchedulerCurrentExecutionSnapshotV1
) -> bool:
    snapshot.admitted

pub(package) fn scheduler_current_execution_snapshot_lease_v1(
    snapshot: SchedulerCurrentExecutionSnapshotV1
) -> SchedulerCapabilitySnapshotLeaseV1:
    snapshot.lease

pub(package) fn scheduler_pinned_capability_snapshot_caps_v1(
    snapshot: SchedulerPinnedCapabilitySnapshotV1
) -> CapabilitySet:
    CapabilitySet(caps: snapshot._concrete_tokens, is_pledged: true)

enum _SnapshotSlotStateV1:
    Free
    Active

struct _SnapshotSlotV1:
    generation: u64
    nonce: u64
    state: _SnapshotSlotStateV1
    task_id: u64
    lifecycle_generation: u64
    exec_generation: u64
    concrete_tokens: [CapabilityToken]

val _snapshot_mutex_v1: i64 = mutex_raw_create()
var _snapshot_slots_v1: [_SnapshotSlotV1] = []
var _snapshot_next_generation_v1: u64 = 1u64
var _snapshot_poisoned_v1: bool = false

pub(package) fn scheduler_capability_snapshot_max_leases_v1() -> i64: 64

fn _copy_concrete_tokens_v1(caps: CapabilitySet) -> [CapabilityToken]:
    var pinned: [CapabilityToken] = []
    for cap in caps.caps:
        pinned.push(CapabilityToken(
            kind: cap.kind, generation: cap.generation, owner: cap.owner,
            token_id: cap.token_id, parent_token_id: cap.parent_token_id,
            depth: cap.depth))
    pinned

fn _concrete_tokens_valid_v1(task_id: u64, caps: CapabilitySet) -> bool:
    if task_id == 0u64 or not caps.is_pledged or caps.caps.len() == 0:
        return false
    var index: i64 = 0
    while index < caps.caps.len():
        val cap = caps.caps[index]
        if cap.owner != task_id or cap.generation == 0u64 or
            cap.token_id == 0u64:
            return false
        var prior: i64 = 0
        while prior < index:
            if caps.caps[prior].token_id == cap.token_id: return false
            prior = prior + 1
        index = index + 1
    true

fn _snapshot_unlock_v1() -> bool:
    if mutex_raw_unlock(_snapshot_mutex_v1): return true
    _snapshot_poisoned_v1 = true
    false

pub(package) fn scheduler_capability_snapshot_issue_v1(
    task_id: u64,
    lifecycle_generation: u64,
    exec_generation: u64,
    caps: CapabilitySet
) -> SchedulerCapabilitySnapshotLeaseV1?:
    # Ambient/full authority has no finite concrete snapshot and cannot be
    # delegated by this mechanism.
    if (task_id == 0u64 or lifecycle_generation == 0u64 or
        exec_generation == 0u64 or
        not _concrete_tokens_valid_v1(task_id, caps)):
        return nil
    val pinned = _copy_concrete_tokens_v1(caps)
    if (_snapshot_mutex_v1 <= 0 or _snapshot_poisoned_v1 or
        not mutex_raw_lock(_snapshot_mutex_v1)):
        return nil
    var reusable = -1
    var index = 0
    while index < _snapshot_slots_v1.len():
        if reusable < 0 and _snapshot_slots_v1[index].state == _SnapshotSlotStateV1.Free:
            reusable = index
        index = index + 1
    if ((reusable < 0 and _snapshot_slots_v1.len() >=
            scheduler_capability_snapshot_max_leases_v1()) or
        _snapshot_next_generation_v1 == 0u64 or
        _snapshot_next_generation_v1 == 0xFFFFFFFFFFFFFFFFu64):
        _ = _snapshot_unlock_v1()
        return nil
    val generation = _snapshot_next_generation_v1
    _snapshot_next_generation_v1 = generation + 1u64
    var nonce = generation ^ task_id ^ lifecycle_generation ^ exec_generation ^
        0x534E415053484F54u64
    if nonce == 0u64: nonce = generation ^ 0x4C45415345u64
    val slot = _SnapshotSlotV1(
        generation: generation, nonce: nonce, state: _SnapshotSlotStateV1.Active,
        task_id: task_id, lifecycle_generation: lifecycle_generation,
        exec_generation: exec_generation, concrete_tokens: pinned)
    val target = if reusable >= 0: reusable else: _snapshot_slots_v1.len()
    if reusable >= 0:
        _snapshot_slots_v1[reusable] = slot
    else:
        _snapshot_slots_v1.push(slot)
    val lease = SchedulerCapabilitySnapshotLeaseV1(
        _slot: target, _generation: generation, _nonce: nonce)
    if not _snapshot_unlock_v1(): return nil
    Some(lease)

pub(package) fn scheduler_capability_snapshot_consume_once_v1(
    lease: SchedulerCapabilitySnapshotLeaseV1,
    task_id: u64,
    lifecycle_generation: u64,
    exec_generation: u64
) -> SchedulerPinnedCapabilitySnapshotV1?:
    if (task_id == 0u64 or lifecycle_generation == 0u64 or exec_generation == 0u64 or
        _snapshot_mutex_v1 <= 0 or _snapshot_poisoned_v1 or
        not mutex_raw_lock(_snapshot_mutex_v1)):
        return nil
    if lease._slot < 0 or lease._slot >= _snapshot_slots_v1.len():
        _ = _snapshot_unlock_v1()
        return nil
    var slot = _snapshot_slots_v1[lease._slot]
    # Validate every coordinate before burning the one-shot lease. A confused
    # caller therefore cannot retire another execution instance's snapshot.
    if (slot.state != _SnapshotSlotStateV1.Active or
        slot.generation != lease._generation or slot.nonce != lease._nonce or
        slot.task_id != task_id or
        slot.lifecycle_generation != lifecycle_generation or
        slot.exec_generation != exec_generation):
        _ = _snapshot_unlock_v1()
        return nil
    val snapshot = SchedulerPinnedCapabilitySnapshotV1(
        _task_id: slot.task_id,
        _lifecycle_generation: slot.lifecycle_generation,
        _exec_generation: slot.exec_generation,
        _concrete_tokens: _copy_concrete_tokens_v1(CapabilitySet(
            caps: slot.concrete_tokens, is_pledged: true)))
    slot.state = _SnapshotSlotStateV1.Free
    slot.task_id = 0u64
    slot.lifecycle_generation = 0u64
    slot.exec_generation = 0u64
    slot.concrete_tokens = []
    _snapshot_slots_v1[lease._slot] = slot
    if not _snapshot_unlock_v1(): return nil
    Some(snapshot)

pub(package) fn scheduler_capability_snapshot_validate_v1(
    lease: SchedulerCapabilitySnapshotLeaseV1,
    task_id: u64,
    lifecycle_generation: u64,
    exec_generation: u64
) -> bool:
    """Validate exact live coordinates without consuming the one-shot lease."""
    if (task_id == 0u64 or lifecycle_generation == 0u64 or
        exec_generation == 0u64 or _snapshot_mutex_v1 <= 0 or
        _snapshot_poisoned_v1 or not mutex_raw_lock(_snapshot_mutex_v1)):
        return false
    if lease._slot < 0 or lease._slot >= _snapshot_slots_v1.len():
        _ = _snapshot_unlock_v1()
        return false
    val slot = _snapshot_slots_v1[lease._slot]
    val valid = slot.state == _SnapshotSlotStateV1.Active and
        slot.generation == lease._generation and slot.nonce == lease._nonce and
        slot.task_id == task_id and
        slot.lifecycle_generation == lifecycle_generation and
        slot.exec_generation == exec_generation
    if not _snapshot_unlock_v1(): return false
    valid

pub(package) fn scheduler_capability_snapshot_retire_v1(
    lease: SchedulerCapabilitySnapshotLeaseV1,
    task_id: u64,
    lifecycle_generation: u64,
    exec_generation: u64
) -> bool:
    """Retire an unconsumed lease on a later transaction failure.

    As with consume, mismatched coordinates are rejected before the lease is
    burned, so cleanup cannot accidentally retire another transaction.
    """
    if (_snapshot_mutex_v1 <= 0 or _snapshot_poisoned_v1 or
        not mutex_raw_lock(_snapshot_mutex_v1)):
        return false
    if lease._slot < 0 or lease._slot >= _snapshot_slots_v1.len():
        _ = _snapshot_unlock_v1()
        return false
    var slot = _snapshot_slots_v1[lease._slot]
    if (slot.state != _SnapshotSlotStateV1.Active or
        slot.generation != lease._generation or slot.nonce != lease._nonce or
        slot.task_id != task_id or
        slot.lifecycle_generation != lifecycle_generation or
        slot.exec_generation != exec_generation):
        _ = _snapshot_unlock_v1()
        return false
    slot.state = _SnapshotSlotStateV1.Free
    slot.task_id = 0u64
    slot.lifecycle_generation = 0u64
    slot.exec_generation = 0u64
    slot.concrete_tokens = []
    _snapshot_slots_v1[lease._slot] = slot
    _snapshot_unlock_v1()

export SchedulerCapabilitySnapshotLeaseV1
export SchedulerPinnedCapabilitySnapshotV1
export SchedulerCurrentExecutionSnapshotV1
export scheduler_current_execution_snapshot_task_id_v1
export scheduler_current_execution_snapshot_lifecycle_generation_v1
export scheduler_current_execution_snapshot_exec_generation_v1
export scheduler_current_execution_snapshot_admitted_v1
export scheduler_current_execution_snapshot_lease_v1
export scheduler_pinned_capability_snapshot_caps_v1
export scheduler_capability_snapshot_max_leases_v1
export scheduler_capability_snapshot_issue_v1
export scheduler_capability_snapshot_consume_once_v1
export scheduler_capability_snapshot_validate_v1
export scheduler_capability_snapshot_retire_v1
