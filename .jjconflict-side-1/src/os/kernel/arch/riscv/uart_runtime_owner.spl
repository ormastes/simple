# Shared RISC-V UART runtime owner.
#
# Keep the raw runtime boundary in this architecture-light leaf. Consumers use
# the typed inline wrapper so byte output remains direct, O(1), and
# allocation-free after lowering. The provider continues to receive u64 and
# owns the target-specific UART implementation.

extern fn rt_riscv_uart_put(byte: u64)

@inline
pub fn riscv_uart_put(byte: u8):
    rt_riscv_uart_put(byte as u64)
