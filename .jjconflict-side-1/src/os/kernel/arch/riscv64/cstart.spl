# RISC-V 64 bare-metal cstart bridge — HalCstart entry points for this arch.
#
# The body is arch-independent; see os.kernel.arch.common.cstart_bridge.

use os.kernel.arch.arch_context.{BootArgs, JmpBuf}
use os.kernel.arch.hal.{CstartError}
use os.kernel.arch.common.cstart_bridge.{cstart_init_common, setjmp_common, longjmp_common, exit_common}

fn cstart_init(boot_args: BootArgs) -> Result<i32, CstartError>:
    cstart_init_common(boot_args)

fn setjmp(buf: JmpBuf) -> i32:
    setjmp_common(buf)

fn longjmp(buf: JmpBuf, value: i32) -> i32:
    longjmp_common(buf, value)

fn exit(code: i32) -> i32:
    exit_common(code)
