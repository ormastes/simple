# Pure-Simple scalar policy for the Cosmos+ Cortex-A9 SMP/GIC lane.
#
# MMIO, barriers, assembly, mailbox publication, and the legacy contract ABI
# stay in cosmos_smp_gic.c. This owner contains only deterministic scalar
# validation and register-value derivation.

pub val COSMOS_SMP_GIC_POLICY_DECISIONS: u32 = 17u32
pub val COSMOS_SMP_GIC_POLICY_OUTCOMES_REQUIRED: u64 = 0x3FFFFFFFFu64

val COSMOS_OK: i32 = 0
val COSMOS_POLL_LIMIT: u32 = 1000000u32
val COSMOS_GIC_MAX_WORDS: u32 = 32u32
val COSMOS_GIC_CPU0: u32 = 0x01010101u32
val COSMOS_GIC_CPU0_TARGET: u32 = 0x01u32
val COSMOS_GIC_PCI_PRIORITY: u32 = 0xA0u32
val COSMOS_GIC_IRQ_ID_MASK: u32 = 0x3FFu32
val COSMOS_GIC_SPURIOUS_MIN: u32 = 1020u32
val COSMOS_PCIE_PL_IRQ_ID: u32 = 61u32

val GICD_ICENABLER: u32 = 0x180u32
val GICD_IPRIORITYR: u32 = 0x400u32
val GICD_ITARGETSR: u32 = 0x800u32
val GICD_ICFGR: u32 = 0xC00u32

val COSMOS_SMP_READY: u32 = 1u32
val COSMOS_SMP_ACKED: u32 = 3u32
val COSMOS_SMP_CANCELLED: u32 = 4u32

val COSMOS_GIC_QUIESCE_NONE: u32 = 0u32
val COSMOS_GIC_QUIESCE_CPU: u32 = 1u32
val COSMOS_GIC_QUIESCE_LINE: u32 = 2u32

# Named semantic decisions. Each ID has one production recording site.
# D00 limit.words-nonzero
# D01 limit.words-within-max
# D02 target.word-zero
# D03 generation.wrap
# D04 release.cpu-primary
# D05 release.entry-present
# D06 release.stack-present
# D07 release.entry-aligned
# D08 release.stack-aligned
# D09 secondary.success
# D10 ack.state-acked
# D11 ack.generation-matches
# D12 pcie.words-valid
# D13 pcie.word-in-range
# D14 quiesce.handler-ok
# D15 quiesce.spurious
# D16 quiesce.cpu-local

# Actual execution outcomes, not a test-authored manifest. Recording is
# dormant in firmware and enabled only when the host evidence driver calls
# reset, so the normal dual-core path has no shared mutable writes. A bit is
# set only when the corresponding production predicate then executes.
var g_cosmos_smp_gic_policy_coverage_enabled: bool = false
var g_cosmos_smp_gic_policy_outcomes: u64 = 0u64

fn _policy_coverage_record(decision_id: u32, result: bool):
    if not g_cosmos_smp_gic_policy_coverage_enabled:
        return
    val outcome_id = decision_id * 2u32 + (result as u32)
    g_cosmos_smp_gic_policy_outcomes =
        g_cosmos_smp_gic_policy_outcomes | ((1 as u64) << outcome_id)

fn _as_c_int(result: bool) -> i32:
    if result: 1 else: 0

fn _u32_add_wrapped(left: u32, right: u32) -> u32:
    ((left.to_u64() + right.to_u64()) & 0xFFFFFFFFu64).to_u32()

@export("C", name: "cosmos_smp_gic_policy_coverage_reset")
pub fn cosmos_smp_gic_policy_coverage_reset():
    g_cosmos_smp_gic_policy_outcomes = 0u64
    g_cosmos_smp_gic_policy_coverage_enabled = true

@export("C", name: "cosmos_smp_gic_policy_coverage_mask")
pub fn cosmos_smp_gic_policy_coverage_mask() -> u64:
    g_cosmos_smp_gic_policy_outcomes

@export("C", name: "cosmos_smp_gic_policy_coverage_required")
pub fn cosmos_smp_gic_policy_coverage_required() -> u64:
    COSMOS_SMP_GIC_POLICY_OUTCOMES_REQUIRED

@export("C", name: "cosmos_smp_gic_policy_coverage_decisions")
pub fn cosmos_smp_gic_policy_coverage_decisions() -> u32:
    COSMOS_SMP_GIC_POLICY_DECISIONS

@export("C", name: "cosmos_gic_limit_words")
pub fn cosmos_gic_limit_words(words: u32) -> u32:
    val nonzero = words != 0u32
    _policy_coverage_record(0u32, nonzero)
    if not nonzero:
        return 0u32
    val within_max = words <= COSMOS_GIC_MAX_WORDS
    _policy_coverage_record(1u32, within_max)
    if within_max: words else: 0u32

@export("C", name: "cosmos_gic_words_from_typer")
pub fn cosmos_gic_words_from_typer(typer: u32) -> u32:
    cosmos_gic_limit_words((typer & 0x1Fu32) + 1u32)

@export("C", name: "cosmos_gic_target_for_word")
pub fn cosmos_gic_target_for_word(word: u32) -> u32:
    val word_zero = word == 0u32
    _policy_coverage_record(2u32, word_zero)
    if word_zero: 0u32 else: COSMOS_GIC_CPU0

@export("C", name: "cosmos_smp_next_generation")
pub fn cosmos_smp_next_generation(generation: u32) -> u32:
    val wrapped = generation == 0xFFFFFFFFu32
    _policy_coverage_record(3u32, wrapped)
    if wrapped: 1u32 else: generation + 1u32

@export("C", name: "cosmos_smp_release_request_valid")
pub fn cosmos_smp_release_request_valid(
    cpu_id: u32,
    entry: u32,
    stack_top: u32
) -> i32:
    val cpu_primary = cpu_id == 0u32
    _policy_coverage_record(4u32, cpu_primary)
    if not cpu_primary:
        return 0
    val entry_present = entry != 0u32
    _policy_coverage_record(5u32, entry_present)
    if not entry_present:
        return 0
    val stack_present = stack_top != 0u32
    _policy_coverage_record(6u32, stack_present)
    if not stack_present:
        return 0
    val entry_aligned = (entry & 3u32) == 0u32
    _policy_coverage_record(7u32, entry_aligned)
    if not entry_aligned:
        return 0
    val stack_aligned = (stack_top & 7u32) == 0u32
    _policy_coverage_record(8u32, stack_aligned)
    _as_c_int(stack_aligned)

@export("C", name: "cosmos_smp_ready_observed")
pub fn cosmos_smp_ready_observed(state: u32) -> i32:
    _as_c_int(state == COSMOS_SMP_READY)

@export("C", name: "cosmos_smp_secondary_state")
pub fn cosmos_smp_secondary_state(result: i32) -> u32:
    val success = result == COSMOS_OK
    _policy_coverage_record(9u32, success)
    if success: COSMOS_SMP_ACKED else: COSMOS_SMP_CANCELLED

@export("C", name: "cosmos_smp_ack_observed")
pub fn cosmos_smp_ack_observed(state: u32, ack: u32, generation: u32) -> i32:
    val state_acked = state == COSMOS_SMP_ACKED
    _policy_coverage_record(10u32, state_acked)
    if not state_acked:
        return 0
    val generation_matches = ack == generation
    _policy_coverage_record(11u32, generation_matches)
    _as_c_int(generation_matches)

@export("C", name: "cosmos_smp_poll_allowed")
pub fn cosmos_smp_poll_allowed(poll: u32) -> i32:
    _as_c_int(poll < COSMOS_POLL_LIMIT)

@export("C", name: "cosmos_gic_irq_id")
pub fn cosmos_gic_irq_id(acknowledge: u32) -> u32:
    acknowledge & COSMOS_GIC_IRQ_ID_MASK

@export("C", name: "cosmos_gic_irq_is_spurious")
pub fn cosmos_gic_irq_is_spurious(interrupt_id: u32) -> i32:
    _as_c_int(interrupt_id >= COSMOS_GIC_SPURIOUS_MIN)

@export("C", name: "cosmos_gic_disable_offset")
pub fn cosmos_gic_disable_offset(interrupt_id: u32) -> u32:
    _u32_add_wrapped(GICD_ICENABLER, (interrupt_id / 32u32) * 4u32)

@export("C", name: "cosmos_gic_disable_mask")
pub fn cosmos_gic_disable_mask(interrupt_id: u32) -> u32:
    1u32 << (interrupt_id & 31u32)

@export("C", name: "cosmos_gic_byte_shift")
pub fn cosmos_gic_byte_shift(interrupt_id: u32) -> u32:
    (interrupt_id & 3u32) * 8u32

@export("C", name: "cosmos_gic_config_shift")
pub fn cosmos_gic_config_shift(interrupt_id: u32) -> u32:
    (interrupt_id & 15u32) * 2u32

@export("C", name: "cosmos_gic_priority_offset")
pub fn cosmos_gic_priority_offset(interrupt_id: u32) -> u32:
    _u32_add_wrapped(GICD_IPRIORITYR, (interrupt_id / 4u32) * 4u32)

@export("C", name: "cosmos_gic_target_offset")
pub fn cosmos_gic_target_offset(interrupt_id: u32) -> u32:
    _u32_add_wrapped(GICD_ITARGETSR, (interrupt_id / 4u32) * 4u32)

@export("C", name: "cosmos_gic_config_offset")
pub fn cosmos_gic_config_offset(interrupt_id: u32) -> u32:
    _u32_add_wrapped(GICD_ICFGR, (interrupt_id / 16u32) * 4u32)

@export("C", name: "cosmos_gic_priority_value")
pub fn cosmos_gic_priority_value(current: u32, interrupt_id: u32) -> u32:
    val shift = cosmos_gic_byte_shift(interrupt_id)
    val mask = 0xFFu32 << shift
    (current & ~mask) | (COSMOS_GIC_PCI_PRIORITY << shift)

@export("C", name: "cosmos_gic_target_cpu0_value")
pub fn cosmos_gic_target_cpu0_value(current: u32, interrupt_id: u32) -> u32:
    val shift = cosmos_gic_byte_shift(interrupt_id)
    val mask = 0xFFu32 << shift
    (current & ~mask) | (COSMOS_GIC_CPU0_TARGET << shift)

@export("C", name: "cosmos_gic_level_config_value")
pub fn cosmos_gic_level_config_value(current: u32, interrupt_id: u32) -> u32:
    current & ~(3u32 << cosmos_gic_config_shift(interrupt_id))

@export("C", name: "cosmos_gic_pcie_irq_in_range")
pub fn cosmos_gic_pcie_irq_in_range(words: u32) -> i32:
    val words_valid = cosmos_gic_limit_words(words) != 0u32
    _policy_coverage_record(12u32, words_valid)
    if not words_valid:
        return 0
    val word_in_range = (COSMOS_PCIE_PL_IRQ_ID / 32u32) < words
    _policy_coverage_record(13u32, word_in_range)
    _as_c_int(word_in_range)

@export("C", name: "cosmos_gic_eoir_required")
pub fn cosmos_gic_eoir_required(interrupt_id: u32) -> i32:
    _as_c_int(cosmos_gic_irq_is_spurious(interrupt_id) == 0)

@export("C", name: "cosmos_gic_quiesce_kind")
pub fn cosmos_gic_quiesce_kind(interrupt_id: u32, handler_result: i32) -> u32:
    val handler_ok = handler_result == COSMOS_OK
    _policy_coverage_record(14u32, handler_ok)
    if handler_ok:
        return COSMOS_GIC_QUIESCE_NONE
    val spurious = cosmos_gic_irq_is_spurious(interrupt_id) != 0
    _policy_coverage_record(15u32, spurious)
    if spurious:
        return COSMOS_GIC_QUIESCE_NONE
    val cpu_local = interrupt_id < 16u32
    _policy_coverage_record(16u32, cpu_local)
    if cpu_local: COSMOS_GIC_QUIESCE_CPU else: COSMOS_GIC_QUIESCE_LINE
