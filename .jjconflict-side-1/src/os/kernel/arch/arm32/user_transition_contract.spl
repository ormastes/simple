"""Frozen ARMv7-A user/SVC transition ABI.  This file defines layout only."""

pub val ARM32_USER_ABI_VERSION: u32 = 0x00010006  # v1.6
pub val ARM32_TOKEN_MAC_DOMAIN: text = "SOSIX-A32-TOK1.1"
pub val ARM32_TOKEN_MAC_INPUT_BYTES: u32 = 72
pub val ARM32_TOKEN_MAC_KEY_BYTES: u32 = 16
pub val ARM32_MAX_CPU_SLOTS: u32 = 4

pub val ARM32_MAP_USER: u32 = 1
pub val ARM32_MAP_WRITE: u32 = 2
pub val ARM32_MAP_EXEC: u32 = 4
pub val ARM32_MAP_DEVICE: u32 = 8
pub val ARM32_MAP_SHARED: u32 = 16
pub val ARM32_MAP_FLAGS_MASK: u32 = 31
pub val ARM32_L2_XN: u32 = 1
pub val ARM32_L2_SMALL_PAGE: u32 = 2
pub val ARM32_L2_B: u32 = 4
pub val ARM32_L2_C: u32 = 8
pub val ARM32_L2_AP_RW_ALL: u32 = 3 << 4
pub val ARM32_L2_AP_RO_ALL: u32 = (2 << 4) | (1 << 9)
pub val ARM32_L2_TEX_NORMAL_WBWA: u32 = 1 << 6
pub val ARM32_L2_S: u32 = 1 << 10
pub val ARM32_L2_NG: u32 = 1 << 11
pub val ARM32_DACR_DOMAIN0_CLIENT: u32 = 1
pub val ARM32_USER_TABLE_ARENA_BYTES: u32 = 1024 * 1024
pub val ARM32_USER_TABLE_PAGE_BYTES: u32 = 4096
pub val ARM32_USER_TABLE_PAGE_COUNT: u32 = 256
pub val ARM32_CPSR_USR: u32 = 0x10
pub val ARM32_CPSR_MODE_MASK: u32 = 0x1f
pub val ARM32_SVC_FRAME_WORDS: u32 = 18
pub val ARM32_SVC_FRAME_BYTES: u32 = 72
pub val ARM32_HANDOFF_TOKEN_WORDS: u32 = 16
pub val ARM32_HANDOFF_TOKEN_BYTES: u32 = 64
pub val ARM32_HANDOFF_TOKEN_MAGIC: u32 = 0x41333255  # "U23A", LE

pub val ARM32_SVC_WRITE_STDOUT: u32 = 60
pub val ARM32_SVC_EXIT: u32 = 0
pub val ARM32_EXPECTED_EXIT: u32 = 37

pub val ARM32_TOKEN_PREPARED: u32 = 1
pub val ARM32_TOKEN_RUNNING: u32 = 2
pub val ARM32_TOKEN_EXITED: u32 = 3
pub val ARM32_TOKEN_REAPED: u32 = 4

pub struct Arm32SvcFrameV1:
    r0: u32
    r1: u32
    r2: u32
    r3: u32
    r4: u32
    r5: u32
    r6: u32
    r7: u32
    r8: u32
    r9: u32
    r10: u32
    r11: u32
    r12: u32
    user_sp: u32
    user_lr: u32
    return_pc: u32
    spsr: u32
    svc_instruction: u32

pub struct Arm32UserHandoffTokenV1:
    magic: u32
    version: u32
    task_id: u32
    task_generation: u32
    address_space_id: u32
    user_ttbr0_root: u32
    nonce_lo: u32
    nonce_hi: u32
    supervisor_sp: u32
    supervisor_pc: u32
    kernel_ttbr0_root: u32
    lifecycle_state: u32
    auth_tag_lo: u32
    auth_tag_hi: u32
    expected_frame_sp: u32
    syscall_sequence: u32

pub struct Arm32SvcDispositionV14:
    action: u32
    status: u32
    stdout_byte: u32
    exit_code: u32
    fault_code: u32
    task_id: u32
    task_generation: u32
    syscall_sequence: u32
    auth_receipt_lo: u32
    auth_receipt_hi: u32
    observed_ttbr0: u32
    frame_sp: u32
    return_pc: u32
    spsr: u32
    reserved0: u32
    reserved1: u32

pub fn arm32_svc_frame_shape_valid(frame: Arm32SvcFrameV1) -> bool:
    (frame.spsr & ARM32_CPSR_MODE_MASK) == ARM32_CPSR_USR and
        (frame.return_pc & 3) == 0 and (frame.user_sp & 7) == 0

pub fn arm32_handoff_token_shape_valid(token: Arm32UserHandoffTokenV1) -> bool:
    token.magic == ARM32_HANDOFF_TOKEN_MAGIC and
        token.version == ARM32_USER_ABI_VERSION and token.task_id != 0 and
        token.task_generation != 0 and token.address_space_id != 0 and
        token.user_ttbr0_root != 0 and (token.user_ttbr0_root & 0x3fff) == 0 and
        token.supervisor_sp != 0 and (token.supervisor_sp & 7) == 0 and
        token.supervisor_pc != 0 and token.kernel_ttbr0_root != 0 and
        token.lifecycle_state >= ARM32_TOKEN_PREPARED and
        token.lifecycle_state <= ARM32_TOKEN_REAPED and
        (token.auth_tag_lo != 0 or token.auth_tag_hi != 0)

pub fn arm32_expected_svc_frame_sp(svc_stack_top: u32) -> u32:
    # The dedicated SVC stack top is 8-byte aligned; one non-reentrant frame
    # occupies the highest 72 bytes.  A guard page lies below its 4-KiB stack.
    svc_stack_top - ARM32_SVC_FRAME_BYTES

pub fn arm32_user_map_flags_valid_v12(flags: u32) -> bool:
    (flags & ~ARM32_MAP_FLAGS_MASK) == 0 and
        (flags & ARM32_MAP_USER) != 0 and
        not ((flags & ARM32_MAP_WRITE) != 0 and (flags & ARM32_MAP_EXEC) != 0) and
        not ((flags & ARM32_MAP_DEVICE) != 0 and
            ((flags & ARM32_MAP_EXEC) != 0 or (flags & ARM32_MAP_SHARED) == 0))
