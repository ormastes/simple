# Frozen x86_32 privilege-transition ABI v1.
#
# This module contains layout and state contracts only.  It deliberately does
# not export a live entry/trap symbol; assembly and runtime owners must conform
# to this ABI before the fail-closed filesystem-exec admission is enabled.

val X86_32_PRIVILEGE_ABI_VERSION: u32 = 0x00010008
val X86_32_PRIVILEGE_ABI_MAJOR: u32 = 1
val X86_32_PRIVILEGE_ABI_MINOR: u32 = 8
val X86_32_PMM_MAX_PHYS_PAGES: u32 = 1048576
val X86_32_PMM_BITMAP_BYTES: u32 = 131072
val X86_32_BOOT_PDE_4M_FLAGS: u32 = 0x83
val X86_32_BOOT_CR4_PSE: u32 = 0x10
val X86_32_BOOT_CR0_PG_WP: u32 = 0x80010000
val X86_32_BOOT_PAGING_POOL_PAGES: u32 = 3
val X86_32_BOOT_PAGING_POOL_BYTES: u32 = 12288
val X86_32_PRIVILEGE_TOKEN_MAGIC: u32 = 0x58333254  # "X32T"
val X86_32_PRIVILEGE_DISPATCH_SYMBOL: text = "simpleos_x86_32_privilege_dispatch_v1_1"
val X86_32_PRIVILEGE_ENTER_SYMBOL: text = "simpleos_x86_32_privilege_enter_v1_2"
val X86_32_PRIVILEGE_CLEAR_SYMBOL: text = "simpleos_x86_32_privilege_clear_active_v1_2"

# Owned GDT layout. Selectors include no RPL unless explicitly named USER.
val X86_32_GDT_NULL: u16 = 0x00
val X86_32_GDT_KERNEL_CODE: u16 = 0x08
val X86_32_GDT_KERNEL_DATA: u16 = 0x10
val X86_32_GDT_USER_CODE: u16 = 0x1B
val X86_32_GDT_USER_DATA: u16 = 0x23
val X86_32_GDT_TSS: u16 = 0x28
val X86_32_GDT_ENTRY_COUNT: u32 = 6
val X86_32_GDT_BYTES: u32 = 48

# 32-bit available-TSS contract. esp0 is rebound before every user entry.
val X86_32_TSS_BYTES: u32 = 104
val X86_32_TSS_ESP0_OFFSET: u32 = 4
val X86_32_TSS_SS0_OFFSET: u32 = 8
val X86_32_TSS_IOMAP_BASE_OFFSET: u32 = 102

# Trap frame constructed by the future common int80 assembly owner. The first
# fourteen words are software-saved; the final five are the CPL3 hardware
# frame pushed by the CPU (EIP, CS, EFLAGS, user ESP, user SS).
val X86_32_TRAP_FRAME_WORDS: u32 = 19
val X86_32_TRAP_FRAME_BYTES: u32 = 76
val X86_32_TF_GS: u32 = 0
val X86_32_TF_FS: u32 = 4
val X86_32_TF_ES: u32 = 8
val X86_32_TF_DS: u32 = 12
val X86_32_TF_EDI: u32 = 16
val X86_32_TF_ESI: u32 = 20
val X86_32_TF_EBP: u32 = 24
val X86_32_TF_ESP_DUMMY: u32 = 28
val X86_32_TF_EBX: u32 = 32
val X86_32_TF_EDX: u32 = 36
val X86_32_TF_ECX: u32 = 40
val X86_32_TF_EAX: u32 = 44
val X86_32_TF_VECTOR: u32 = 48
val X86_32_TF_ERROR: u32 = 52
val X86_32_TF_EIP: u32 = 56
val X86_32_TF_CS: u32 = 60
val X86_32_TF_EFLAGS: u32 = 64
val X86_32_TF_USER_ESP: u32 = 68
val X86_32_TF_USER_SS: u32 = 72

val X86_32_INT80_VECTOR: u32 = 0x80
val X86_32_SYSCALL_EXIT: u32 = 0
val X86_32_SYSCALL_DEBUG_WRITE: u32 = 60
val X86_32_REQUIRED_EXIT_STATUS: u32 = 37
val X86_32_NONCE_DIGEST_BYTES: u32 = 32

@repr("C")
@pack(1)
struct X86_32PrivilegeTokenV1:
    magic: u32
    version: u32
    state: u32              # 0 empty, 1 armed, 2 exiting, 3 consumed
    reserved0: u32
    task_id: u64
    task_generation: u64    # snapshot of TaskSecurity.capability_generation
    address_space_id: u64
    expected_cr3: u32
    kernel_cr3: u32
    kernel_esp: u32
    kernel_resume_eip: u32
    expected_nonce_user_va: u32
    nonce_length: u32
    nonce_digest: [u8; 32]

val X86_32_PRIVILEGE_TOKEN_BYTES: u32 = 96
val X86_32_TOKEN_TASK_ID_OFFSET: u32 = 16
val X86_32_TOKEN_GENERATION_OFFSET: u32 = 24
val X86_32_TOKEN_ADDRESS_SPACE_ID_OFFSET: u32 = 32
val X86_32_TOKEN_EXPECTED_CR3_OFFSET: u32 = 40
val X86_32_TOKEN_KERNEL_CR3_OFFSET: u32 = 44
val X86_32_TOKEN_KERNEL_ESP_OFFSET: u32 = 48
val X86_32_TOKEN_KERNEL_RESUME_EIP_OFFSET: u32 = 52
val X86_32_TOKEN_NONCE_USER_VA_OFFSET: u32 = 56
val X86_32_TOKEN_NONCE_LENGTH_OFFSET: u32 = 60
val X86_32_TOKEN_NONCE_DIGEST_OFFSET: u32 = 64

# Assembly-to-Simple dispatcher result. Assembly changes control flow solely
# from `action`; a negative result never implies an iret by itself.
val X86_32_TRAP_ACTION_REJECT: u32 = 0
val X86_32_TRAP_ACTION_RETURN_USER: u32 = 1
val X86_32_TRAP_ACTION_RESUME_KERNEL_EXIT: u32 = 2

@repr("C")
@pack(1)
struct X86_32TrapDispositionV1:
    action: u32
    eax: i32
    kernel_esp: u32
    kernel_eip: u32

val X86_32_TRAP_DISPOSITION_BYTES: u32 = 16

# Scalar raw-C dispatcher ABI v1.1:
#   i32 simpleos_x86_32_privilege_dispatch_v1_1(
#       frame_ptr: u32, token_ptr: u32, observed_cr3: u32,
#       disposition_out_ptr: u32)
# Return 0 only after fully initializing disposition_out; negative errno means
# reject and leaves no authorization to return to user or resume a continuation.
# All pointers are required non-null and 4-byte aligned. The symbol is strong,
# unique, cdecl, and must never be selected through weak probing.
val X86_32_DISPATCH_OK: i32 = 0
val X86_32_DISPATCH_EINVAL: i32 = -22
val X86_32_DISPATCH_EAUTH: i32 = -13

# Entry/install ABI v1.2:
#   noreturn void simpleos_x86_32_privilege_enter_v1_2(
#       token*, kernel_stack_top, eip, user_esp, user_cr3)
# The architecture owner rejects an occupied per-CPU slot, writes TSS.esp0,
# then release-publishes token as the active slot. Exit/fault atomically clears
# that exact pointer once before scheduler collection or stack destruction.
val X86_32_ENTRY_EBUSY: i32 = -16
val X86_32_ENTRY_KERNEL_STACK_PAGES: u32 = 4
val X86_32_ENTRY_KERNEL_STACK_BYTES: u32 = 16384
val X86_32_ENTRY_STACK_ALIGNMENT: u32 = 16
val X86_32_NONCE_USER_VA: u32 = 0x2FFFF000
val X86_32_NONCE_PAGE_BYTES: u32 = 4096
val X86_32_TOKEN_REGISTRY_SLOTS: u32 = 16
val X86_32_RECURSIVE_PDE_INDEX: u32 = 1023
val X86_32_RECURSIVE_PT_BASE: u32 = 0xFFC00000
val X86_32_RECURSIVE_PD_VA: u32 = 0xFFFFF000
val X86_32_KMAP_PDE_INDEX: u32 = 1022
val X86_32_KMAP_PTE_INDEX: u32 = 1023
val X86_32_KMAP_VA: u32 = 0xFFBFF000

# Scheduler-only registry states. A child never receives the kernel pointer.
val X86_32_PREP_EMPTY: u32 = 0
val X86_32_PREP_ALLOCATED: u32 = 1
val X86_32_PREP_NONCE_MAPPED: u32 = 2
val X86_32_PREP_PINNED: u32 = 3
val X86_32_PREP_CONSUMED: u32 = 4
val X86_32_PREP_REVOKED: u32 = 5

fn x86_32_privilege_entry_layout_valid() -> bool:
    X86_32_ENTRY_KERNEL_STACK_PAGES * 4096 == X86_32_ENTRY_KERNEL_STACK_BYTES and
    (X86_32_ENTRY_KERNEL_STACK_BYTES & (X86_32_ENTRY_STACK_ALIGNMENT - 1)) == 0

fn x86_32_nonce_range_valid(user_va: u32, length: u32) -> bool:
    user_va != 0 and length != 0 and length <= 4096 and
    user_va < 0xC0000000 and length <= 0xC0000000 - user_va

fn x86_32_nonce_reserved_range_valid(user_va: u32, length: u32) -> bool:
    user_va == X86_32_NONCE_USER_VA and
    x86_32_nonce_range_valid(user_va, length) and
    length <= X86_32_NONCE_PAGE_BYTES

fn x86_32_privilege_abi_layout_valid() -> bool:
    X86_32_GDT_USER_CODE == 0x1B and
    X86_32_GDT_USER_DATA == 0x23 and
    X86_32_GDT_TSS == 0x28 and
    X86_32_TSS_ESP0_OFFSET == 4 and
    X86_32_TF_EIP == 56 and
    X86_32_TF_USER_SS + 4 == X86_32_TRAP_FRAME_BYTES and
    X86_32_TOKEN_NONCE_DIGEST_OFFSET + X86_32_NONCE_DIGEST_BYTES == X86_32_PRIVILEGE_TOKEN_BYTES
