# Kernel-only packed authentication storage facade.
#
# Simple arrays are value-semantic tagged elements and are never passed as raw
# byte buffers. This facade copies scalar bytes into a fixed C-owned record.

val PACKED_AUTH_SECRET: u32 = 1
val PACKED_AUTH_MESSAGE: u32 = 2
val PACKED_AUTH_X86_TOKEN: u32 = 3

extern fn rt_packed_auth_claim(kind: u32) -> u64
extern fn rt_packed_auth_write_byte(lease: u64, index: u32, value: u32) -> i32
extern fn rt_packed_auth_address(lease: u64) -> u64
extern fn rt_packed_auth_release(lease: u64) -> i32

fn packed_auth_claim(kind: u32) -> u64:
    if kind != PACKED_AUTH_SECRET and kind != PACKED_AUTH_MESSAGE and kind != PACKED_AUTH_X86_TOKEN:
        return 0
    rt_packed_auth_claim(kind)

fn packed_auth_write_bytes(lease: u64, bytes: [u8], exact_len: u32) -> bool:
    if lease == 0 or bytes.len() != exact_len:
        return false
    var i: u32 = 0
    while i < exact_len:
        if rt_packed_auth_write_byte(lease, i, bytes[i].to_u32()) != 0:
            return false
        i = i + 1
    true

fn packed_auth_address(lease: u64) -> u64:
    if lease == 0:
        return 0
    rt_packed_auth_address(lease)

fn packed_auth_release(lease: u64) -> bool:
    lease != 0 and rt_packed_auth_release(lease) == 0

export PACKED_AUTH_SECRET, PACKED_AUTH_MESSAGE, PACKED_AUTH_X86_TOKEN
export packed_auth_claim, packed_auth_write_bytes, packed_auth_address, packed_auth_release
