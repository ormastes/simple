# Device Info Types — Entity Dimension
#
# PCI device info buffer shared between the kernel syscall layer and userlib.
# Kept free of ABI enums so host-side tools (which pull os.userlib.device into
# the CLI closure) can parse it with the self-hosted compiler; explicit-value
# enums (SyscallId) are seed-only today, see
# doc/08_tracking/bug/selfhost_parser_no_explicit_enum_values_2026-07-27.md.

@repr("C")
struct DeviceInfoBuf:
    """PCI device info returned by DevEnumerate/DevGetInfo."""
    bus: u8
    device: u8
    func: u8
    vendor_id: u16
    device_id: u16
    class_code: u8
    subclass: u8
    prog_if: u8
    irq_line: u8

fn new_device_info_buf() -> DeviceInfoBuf:
    """Factory for cross-module construction (struct constructors are not callable cross-module)."""
    DeviceInfoBuf(bus: 0, device: 0, func: 0, vendor_id: 0, device_id: 0, class_code: 0, subclass: 0, prog_if: 0, irq_line: 0)
