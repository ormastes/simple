"""Owner-issued, generation-live bindings for files referenced by argv."""

use std.fs_driver.mount_table.{
    MountTable, StableFileSnapshotLeaseV1, StableFileSnapshotSealV1
}
use std.common.crypto.sha256.{
    Sha256StreamV1, sha256_stream_v1_new, sha256_stream_v1_update,
    sha256_stream_v1_finish_hex
}
use os.kernel.scheduler.process_execution_observation.{
    SchedulerArgvFileRoleV1, SchedulerArgvFileBindingV1
}

const AUTH_ARGV_FILE_MAX_BYTES_V1: u64 = 1073741824u64
const AUTH_ARGV_FILE_CHUNK_BYTES_V1: u64 = 65536u64

pub(package) struct AuthenticatedArgvFileLeaseV1:
    role: SchedulerArgvFileRoleV1
    argv_index: i64
    lease: StableFileSnapshotLeaseV1
    seal: StableFileSnapshotSealV1

pub(package) fn authenticated_argv_file_binding_acquire_v1(
    table: MountTable,
    path: text,
    role: SchedulerArgvFileRoleV1,
    argv_index: i64
) -> Result<AuthenticatedArgvFileLeaseV1, text>:
    if argv_index < 0: return Err("argv-file-index-invalid")
    val opened = table.open_stable_snapshot(path, AUTH_ARGV_FILE_MAX_BYTES_V1)
    if opened.is_err(): return Err("argv-file-open-failed")
    val lease = opened.unwrap().lease
    if table.begin_stable_snapshot_promotion_hash_v1(lease).is_err():
        val closed = table.close_stable_snapshot(lease)
        if closed.is_err(): return Err("argv-file-cleanup-indeterminate")
        return Err("argv-file-hash-admission-failed")
    val stream: Sha256StreamV1 = sha256_stream_v1_new()
    var offset: u64 = 0u64
    var failed = opened.unwrap().size == 0u64
    while offset < opened.unwrap().size and not failed:
        val read = table.read_stable_snapshot(
            lease, offset, AUTH_ARGV_FILE_CHUNK_BYTES_V1)
        if read.is_err():
            failed = true
        else:
            val chunk = read.unwrap()
            if chunk.len() == 0u64 or not sha256_stream_v1_update(stream, chunk):
                failed = true
            else:
                offset = offset + chunk.len()
    val digest = if failed: nil else: sha256_stream_v1_finish_hex(stream)
    if not digest.?:
        val closed = table.close_stable_snapshot(lease)
        if closed.is_err(): return Err("argv-file-cleanup-indeterminate")
        return Err("argv-file-hash-failed")
    val seal = table.finish_stable_snapshot_v1(lease, digest.unwrap())
    if seal.is_err():
        val closed = table.close_stable_snapshot(lease)
        if closed.is_err(): return Err("argv-file-cleanup-indeterminate")
        return Err("argv-file-seal-failed")
    Ok(AuthenticatedArgvFileLeaseV1(
        role: role, argv_index: argv_index, lease: lease, seal: seal.unwrap()))

pub(package) fn authenticated_argv_file_binding_finish_v1(
    table: MountTable,
    owned: AuthenticatedArgvFileLeaseV1
) -> Result<SchedulerArgvFileBindingV1, text>:
    # Idempotent finish rechecks the live mount/namespace/content generations.
    val current = table.finish_stable_snapshot_v1(
        owned.lease, owned.seal.content_sha256)
    if current.is_err():
        val closed = table.close_stable_snapshot(owned.lease)
        if closed.is_err(): return Err("argv-file-cleanup-indeterminate")
        return Err("argv-file-changed-during-execution")
    val seal = current.unwrap()
    val closed = table.close_stable_snapshot(owned.lease)
    if closed.is_err(): return Err("argv-file-cleanup-indeterminate")
    Ok(SchedulerArgvFileBindingV1(
        role: owned.role, argv_index: owned.argv_index,
        canonical_path: seal.canonical_source_path,
        content_sha256: seal.content_sha256, mount_id: seal.mount_id.id as u64,
        mount_generation: seal.mount_generation,
        namespace_generation: seal.namespace_generation,
        file_generation: seal.file_generation, size: seal.size))

pub(package) fn authenticated_argv_file_binding_cancel_v1(
    table: MountTable,
    owned: AuthenticatedArgvFileLeaseV1
) -> bool:
    table.close_stable_snapshot(owned.lease).is_ok()
