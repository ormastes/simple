"""Canonical bounded wire codec for a primary-tool release descriptor.

Decoding proves only syntax, canonical representation, and descriptor shape.
Signature trust remains outside this syntax and shape codec.
"""

use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use std.common.structural.wire.{
    WIRE_ENVELOPE_LEN, wire_check_envelope, wire_get_u32, wire_has,
    wire_magic, wire_put_envelope, wire_put_u8, wire_put_u32}
use std.common.structural.digest.hash256_codec.{
    hash256_put, hash256_read, hash256_region_valid}
use os.kernel.loader.primary_linux_tool_catalog_bundle_v1.{
    PRIMARY_LINUX_TOOL_PAYLOAD_COUNT_V1}
use os.kernel.loader.primary_tool_release_descriptor_v1.{
    PrimaryToolReleaseDescriptorRowV1, PrimaryToolReleaseDescriptorV1,
    primary_tool_release_descriptor_signing_bytes_v1}

pub const PRIMARY_TOOL_RELEASE_DESCRIPTOR_CODEC_VERSION_V1: i64 = 1
pub const PRIMARY_TOOL_RELEASE_DESCRIPTOR_MAX_WIRE_BYTES_V1: i64 = 4096

pub struct PrimaryToolReleaseDescriptorEncodeResultV1:
    ok: bool
    bytes: [u8]

pub struct PrimaryToolReleaseDescriptorDecodeResultV1:
    ok: bool
    value: PrimaryToolReleaseDescriptorV1

struct _CodecTextReadV1:
    ok: bool
    value: text
    next: i64

fn primary_tool_release_descriptor_codec_magic_v1() -> i64:
    wire_magic("PTRD")

fn _empty_descriptor_v1() -> PrimaryToolReleaseDescriptorV1:
    PrimaryToolReleaseDescriptorV1(
        domain: "", target: ManifestTarget(os: "", arch: "", abi: ""),
        release_id: "", signer_key_id: "", rows: [], signature: [])

fn _encode_reject_v1() -> PrimaryToolReleaseDescriptorEncodeResultV1:
    PrimaryToolReleaseDescriptorEncodeResultV1(ok: false, bytes: [])

fn _decode_reject_v1() -> PrimaryToolReleaseDescriptorDecodeResultV1:
    PrimaryToolReleaseDescriptorDecodeResultV1(
        ok: false, value: _empty_descriptor_v1())

fn _printable_ascii_v1(value: text, maximum: i64) -> bool:
    if value.len() == 0 or value.len() > maximum: return false
    var index: i64 = 0
    while index < value.len():
        val code = value.char_code_at(index)
        if code < 32 or code > 126: return false
        index = index + 1
    true

fn _put_text_v1(out: [u8], value: text) -> [u8]:
    var bytes = wire_put_u32(out, value.len())
    var index: i64 = 0
    while index < value.len():
        bytes = wire_put_u8(bytes, value.char_code_at(index))
        index = index + 1
    bytes

fn _ascii_char_v1(code: i64) -> text:
    val printable =
        " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    if code < 32 or code > 126: return ""
    printable.substring(code - 32, code - 31)

fn _read_text_v1(
    data: [u8], offset: i64, maximum: i64
) -> _CodecTextReadV1:
    if not wire_has(data, offset, 4):
        return _CodecTextReadV1(ok: false, value: "", next: offset)
    val count = wire_get_u32(data, offset)
    if count <= 0 or count > maximum or not wire_has(data, offset + 4, count):
        return _CodecTextReadV1(ok: false, value: "", next: offset)
    var index: i64 = 0
    while index < count:
        val code = data[offset + 4 + index] & 0xff
        if code < 32 or code > 126:
            return _CodecTextReadV1(ok: false, value: "", next: offset)
        index = index + 1
    var value = ""
    index = 0
    while index < count:
        value = value + _ascii_char_v1(data[offset + 4 + index] & 0xff)
        index = index + 1
    _CodecTextReadV1(ok: true, value: value, next: offset + 4 + count)

fn _bytes_equal_v1(left: [u8], right: [u8]) -> bool:
    if left.len() != right.len(): return false
    var index: i64 = 0
    while index < left.len():
        if left[index] != right[index]: return false
        index = index + 1
    true

pub fn encode_primary_tool_release_descriptor_v1(
    descriptor: PrimaryToolReleaseDescriptorV1
) -> PrimaryToolReleaseDescriptorEncodeResultV1:
    if primary_tool_release_descriptor_signing_bytes_v1(descriptor).is_err():
        return _encode_reject_v1()
    if descriptor.signature.len() != 64:
        return _encode_reject_v1()
    if (not _printable_ascii_v1(descriptor.domain, 64) or
        not _printable_ascii_v1(descriptor.target.os, 16) or
        not _printable_ascii_v1(descriptor.target.arch, 16) or
        not _printable_ascii_v1(descriptor.target.abi, 16) or
        not _printable_ascii_v1(descriptor.release_id, 128) or
        not _printable_ascii_v1(descriptor.signer_key_id, 128)):
        return _encode_reject_v1()
    var bytes: [u8] = []
    bytes = wire_put_envelope(
        bytes, primary_tool_release_descriptor_codec_magic_v1(),
        PRIMARY_TOOL_RELEASE_DESCRIPTOR_CODEC_VERSION_V1)
    bytes = _put_text_v1(bytes, descriptor.domain)
    bytes = _put_text_v1(bytes, descriptor.target.os)
    bytes = _put_text_v1(bytes, descriptor.target.arch)
    bytes = _put_text_v1(bytes, descriptor.target.abi)
    bytes = _put_text_v1(bytes, descriptor.release_id)
    bytes = _put_text_v1(bytes, descriptor.signer_key_id)
    bytes = wire_put_u32(bytes, descriptor.rows.len())
    var index: i64 = 0
    while index < descriptor.rows.len():
        val row = descriptor.rows[index]
        if not _printable_ascii_v1(row.canonical_path, 256):
            return _encode_reject_v1()
        bytes = _put_text_v1(bytes, row.canonical_path)
        bytes = hash256_put(bytes, row.payload_sha256)
        bytes = hash256_put(bytes, row.scr1_sha256)
        index = index + 1
    index = 0
    while index < descriptor.signature.len():
        bytes = wire_put_u8(bytes, descriptor.signature[index])
        index = index + 1
    if bytes.len() > PRIMARY_TOOL_RELEASE_DESCRIPTOR_MAX_WIRE_BYTES_V1:
        return _encode_reject_v1()
    PrimaryToolReleaseDescriptorEncodeResultV1(ok: true, bytes: bytes)

pub fn decode_primary_tool_release_descriptor_v1(
    data: [u8]
) -> PrimaryToolReleaseDescriptorDecodeResultV1:
    if (data.len() < WIRE_ENVELOPE_LEN or
        data.len() > PRIMARY_TOOL_RELEASE_DESCRIPTOR_MAX_WIRE_BYTES_V1):
        return _decode_reject_v1()
    if not wire_check_envelope(
        data, 0, primary_tool_release_descriptor_codec_magic_v1(),
        PRIMARY_TOOL_RELEASE_DESCRIPTOR_CODEC_VERSION_V1):
        return _decode_reject_v1()
    var offset = WIRE_ENVELOPE_LEN
    val domain = _read_text_v1(data, offset, 64)
    if not domain.ok: return _decode_reject_v1()
    offset = domain.next
    val target_os = _read_text_v1(data, offset, 16)
    if not target_os.ok: return _decode_reject_v1()
    offset = target_os.next
    val target_arch = _read_text_v1(data, offset, 16)
    if not target_arch.ok: return _decode_reject_v1()
    offset = target_arch.next
    val target_abi = _read_text_v1(data, offset, 16)
    if not target_abi.ok: return _decode_reject_v1()
    offset = target_abi.next
    val release_id = _read_text_v1(data, offset, 128)
    if not release_id.ok: return _decode_reject_v1()
    offset = release_id.next
    val signer_key_id = _read_text_v1(data, offset, 128)
    if not signer_key_id.ok: return _decode_reject_v1()
    offset = signer_key_id.next
    if not wire_has(data, offset, 4): return _decode_reject_v1()
    val row_count = wire_get_u32(data, offset)
    if row_count != PRIMARY_LINUX_TOOL_PAYLOAD_COUNT_V1:
        return _decode_reject_v1()
    offset = offset + 4
    var rows: [PrimaryToolReleaseDescriptorRowV1] = []
    var index: i64 = 0
    while index < row_count:
        val path = _read_text_v1(data, offset, 256)
        if not path.ok: return _decode_reject_v1()
        offset = path.next
        if not hash256_region_valid(data, offset): return _decode_reject_v1()
        val payload_sha256 = hash256_read(data, offset)
        offset = offset + 32
        if not hash256_region_valid(data, offset): return _decode_reject_v1()
        val scr1_sha256 = hash256_read(data, offset)
        offset = offset + 32
        rows.push(PrimaryToolReleaseDescriptorRowV1(
            canonical_path: path.value, payload_sha256: payload_sha256,
            scr1_sha256: scr1_sha256))
        index = index + 1
    if not wire_has(data, offset, 64) or offset + 64 != data.len():
        return _decode_reject_v1()
    var signature: [u8] = []
    index = 0
    while index < 64:
        signature.push(data[offset + index])
        index = index + 1
    val descriptor = PrimaryToolReleaseDescriptorV1(
        domain: domain.value,
        target: ManifestTarget(
            os: target_os.value, arch: target_arch.value, abi: target_abi.value),
        release_id: release_id.value, signer_key_id: signer_key_id.value,
        rows: rows, signature: signature)
    if primary_tool_release_descriptor_signing_bytes_v1(descriptor).is_err():
        return _decode_reject_v1()
    val canonical = encode_primary_tool_release_descriptor_v1(descriptor)
    if not canonical.ok or not _bytes_equal_v1(canonical.bytes, data):
        return _decode_reject_v1()
    PrimaryToolReleaseDescriptorDecodeResultV1(ok: true, value: descriptor)
