"""SimpleOS frame-mode entry for the standalone Office Calc core.

Interactive raw terminal input remains hosted-only until SimpleOS exposes a
console-attached stdin and terminal mode/size syscalls to ring-3 programs.
"""

use app.office.sheets.calc_tui.{run_calc_frame_once}
use std.sffi.cli.{cli_get_args}

fn main() -> i64:
    val args = cli_get_args()
    val path = if args.len() > 1: args[1] else: "untitled.csv"
    run_calc_frame_once(path).to_i64()

export main
