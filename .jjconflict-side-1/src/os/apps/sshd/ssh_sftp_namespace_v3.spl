# Strict, bounded SFTP v3 namespace request codec.
#
# This module deliberately does not execute filesystem operations.  The SFTP
# session owner must decode a request, invoke an authoritative VFS facade, and
# encode that facade's real result.  Keeping execution out of this leaf makes
# it impossible for a missing backend operation to be reported as success.

use os.apps.sshd.ssh_packet.{ssh_get_u32, ssh_put_u32, ssh_put_string, ssh_put_text}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear, text_to_bytes_linear}

pub val SSH_FXP_REMOVE_V3: u8 = 13u8
pub val SSH_FXP_MKDIR_V3: u8 = 14u8
pub val SSH_FXP_RMDIR_V3: u8 = 15u8
pub val SSH_FXP_RENAME_V3: u8 = 18u8
pub val SSH_FXP_READLINK_V3: u8 = 19u8
pub val SSH_FXP_SYMLINK_V3: u8 = 20u8
pub val SSH_FXP_STATUS_V3: u8 = 101u8
pub val SSH_FXP_NAME_V3: u8 = 104u8

pub val SSH_FX_OK_V3: u32 = 0u32
pub val SSH_FX_NO_SUCH_FILE_V3: u32 = 2u32
pub val SSH_FX_PERMISSION_DENIED_V3: u32 = 3u32
pub val SSH_FX_FAILURE_V3: u32 = 4u32
pub val SSH_FX_BAD_MESSAGE_V3: u32 = 5u32
pub val SSH_FX_OP_UNSUPPORTED_V3: u32 = 8u32

val SFTP_NAMESPACE_MAX_PACKET_V3: u64 = 35000u64
val SFTP_NAMESPACE_MAX_PATH_V3: u64 = 4096u64
val SSH_FILEXFER_ATTR_PERMISSIONS_V3: u32 = 4u32
val SFTP_DEFAULT_DIRECTORY_MODE_V3: u32 = 0x1FFu32

pub enum SftpNamespaceKindV3:
    Remove
    Mkdir
    Rmdir
    Rename
    Readlink
    Symlink

pub struct SftpNamespaceRequestV3:
    kind: SftpNamespaceKindV3
    request_id: u32
    path: text
    second_path: text
    directory_mode: u32

fn _namespace_frame_v3(body: [u8]) -> [u8]:
    var out = ssh_put_u32([], body.len().to_u32())
    for byte in body:
        out.push(byte)
    out

fn _namespace_copy_v3(data: [u8], start: u64, length: u64) -> [u8]:
    var out: [u8] = []
    var i: u64 = 0u64
    while i < length:
        out.push(data[start + i])
        i = i + 1u64
    out

fn _namespace_path_bytes_admitted_v3(bytes: [u8], absolute: bool) -> bool:
    if bytes.len() == 0u64 or bytes.len() > SFTP_NAMESPACE_MAX_PATH_V3:
        return false
    if absolute and bytes[0u64] != 47u8:
        return false
    var component_len: u64 = 0u64
    var component_dots: u64 = 0u64
    var i: u64 = if bytes[0u64] == 47u8: 1u64 else: 0u64
    while i < bytes.len():
        val byte = bytes[i]
        if byte == 0u8:
            return false
        if byte == 47u8:
            if component_len == 1u64 and component_dots == 1u64:
                return false
            if component_len == 2u64 and component_dots == 2u64:
                return false
            component_len = 0u64
            component_dots = 0u64
        else:
            component_len = component_len + 1u64
            if byte == 46u8 and component_dots + 1u64 == component_len:
                component_dots = component_dots + 1u64
        i = i + 1u64
    not ((component_len == 1u64 and component_dots == 1u64) or
        (component_len == 2u64 and component_dots == 2u64))

fn _namespace_text_field_v3(
    frame: [u8], offset: u64, absolute: bool
) -> Result<(text, u64), text>:
    if offset > frame.len() or frame.len() - offset < 4u64:
        return Err("truncated path length")
    val length = ssh_get_u32(frame, offset).to_u64()
    if length == 0u64 or length > SFTP_NAMESPACE_MAX_PATH_V3:
        return Err("invalid path length")
    val start = offset + 4u64
    if start > frame.len() or length > frame.len() - start:
        return Err("truncated path")
    val bytes = _namespace_copy_v3(frame, start, length)
    if not _namespace_path_bytes_admitted_v3(bytes, absolute):
        return Err("path denied")
    match validated_utf8_bytes_to_text_linear(bytes):
        Err(_): Err("path is not valid UTF-8")
        Ok(path): Ok((path, start + length))

pub fn sftp_namespace_request_id_v3(frame: [u8]) -> u32:
    """Return the request id when its fixed prefix exists, otherwise zero."""
    if frame.len() < 9u64:
        return 0u32
    ssh_get_u32(frame, 5u64)

pub fn sftp_namespace_decode_v3(
    frame: [u8]
) -> Result<SftpNamespaceRequestV3, text>:
    """Decode exactly one complete length-prefixed SFTP v3 namespace request."""
    if frame.len() < 13u64 or frame.len() > SFTP_NAMESPACE_MAX_PACKET_V3 + 4u64:
        return Err("invalid namespace request length")
    val declared = ssh_get_u32(frame, 0u64).to_u64()
    if declared + 4u64 != frame.len():
        return Err("invalid namespace request framing")
    val kind_byte = frame[4u64]
    val request_id = ssh_get_u32(frame, 5u64)
    val first = _namespace_text_field_v3(frame, 9u64, true)?
    val first_path = first.0
    val after_first = first.1

    if kind_byte == SSH_FXP_REMOVE_V3 or kind_byte == SSH_FXP_RMDIR_V3 or
        kind_byte == SSH_FXP_READLINK_V3:
        if after_first != frame.len():
            return Err("unexpected namespace request tail")
        val kind = if kind_byte == SSH_FXP_REMOVE_V3:
            SftpNamespaceKindV3.Remove
        elif kind_byte == SSH_FXP_RMDIR_V3:
            SftpNamespaceKindV3.Rmdir
        else:
            SftpNamespaceKindV3.Readlink
        return Ok(SftpNamespaceRequestV3(kind: kind, request_id: request_id,
            path: first_path, second_path: "", directory_mode: 0u32))

    if kind_byte == SSH_FXP_MKDIR_V3:
        if after_first > frame.len() or frame.len() - after_first < 4u64:
            return Err("truncated mkdir attributes")
        val attr_flags = ssh_get_u32(frame, after_first)
        var mode = SFTP_DEFAULT_DIRECTORY_MODE_V3
        if attr_flags == 0u32:
            if after_first + 4u64 != frame.len():
                return Err("unexpected mkdir attributes")
        elif attr_flags == SSH_FILEXFER_ATTR_PERMISSIONS_V3:
            if after_first + 8u64 != frame.len():
                return Err("invalid mkdir permissions")
            mode = ssh_get_u32(frame, after_first + 4u64) & 0xFFFu32
        else:
            return Err("unsupported mkdir attributes")
        return Ok(SftpNamespaceRequestV3(kind: SftpNamespaceKindV3.Mkdir,
            request_id: request_id, path: first_path, second_path: "",
            directory_mode: mode))

    if kind_byte == SSH_FXP_RENAME_V3 or kind_byte == SSH_FXP_SYMLINK_V3:
        # SFTP v3 SYMLINK encodes linkpath first and targetpath second.
        val second = _namespace_text_field_v3(frame, after_first,
            kind_byte == SSH_FXP_RENAME_V3)?
        if second.1 != frame.len():
            return Err("unexpected two-path request tail")
        val kind = if kind_byte == SSH_FXP_RENAME_V3:
            SftpNamespaceKindV3.Rename
        else:
            SftpNamespaceKindV3.Symlink
        return Ok(SftpNamespaceRequestV3(kind: kind, request_id: request_id,
            path: first_path, second_path: second.0, directory_mode: 0u32))

    Err("not an SFTP v3 namespace request")

pub fn sftp_namespace_status_v3(
    request_id: u32, code: u32, message: text
) -> [u8]:
    var body: [u8] = [SSH_FXP_STATUS_V3]
    body = ssh_put_u32(body, request_id)
    body = ssh_put_u32(body, code)
    body = ssh_put_text(body, message)
    body = ssh_put_text(body, "")
    _namespace_frame_v3(body)

pub fn sftp_namespace_readlink_name_v3(
    request_id: u32, target: text
) -> Result<[u8], text>:
    """Encode the single NAME entry required by a successful v3 READLINK."""
    val target_bytes = text_to_bytes_linear(target)
    if not _namespace_path_bytes_admitted_v3(target_bytes, false):
        return Err("invalid readlink target")
    var body: [u8] = [SSH_FXP_NAME_V3]
    body = ssh_put_u32(body, request_id)
    body = ssh_put_u32(body, 1u32)
    body = ssh_put_string(body, target_bytes)
    body = ssh_put_string(body, target_bytes)
    body = ssh_put_u32(body, 0u32)
    Ok(_namespace_frame_v3(body))

export SftpNamespaceKindV3, SftpNamespaceRequestV3
export sftp_namespace_decode_v3, sftp_namespace_request_id_v3
export sftp_namespace_status_v3, sftp_namespace_readlink_name_v3
