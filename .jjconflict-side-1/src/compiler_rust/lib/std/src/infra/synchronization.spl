/**
Synchronization Primitives

High-level synchronization for concurrent programming.

Features:
- Mutex: Mutual exclusion lock
- RwLock: Reader-writer lock
- Once: One-time initialization
- Lazy: Lazy initialization
- ThreadLocal: Thread-local storage

```sdoctest
>>> val mutex = Mutex.new([])
>>> mutex.lock(_1.push(42))
>>> mutex.lock(_1[0])
42
```
*/

# SFFI declarations for synchronization primitives
@unsafe(reason: "runtime-owned mutex handle ABI carrying an initial RuntimeValue", capabilities: [ffi])
extern fn rt_mutex_new(value: Any) -> Any
@unsafe(reason: "blocking runtime mutex ABI; nil means an invalid handle", capabilities: [ffi])
extern fn rt_mutex_lock(mutex: Any) -> Any
@unsafe(reason: "non-blocking runtime mutex ABI; nil conflates contention and invalid handle", capabilities: [ffi])
extern fn rt_mutex_try_lock(mutex: Any) -> Any
@unsafe(reason: "runtime mutex owner/value update ABI with integer status", capabilities: [ffi])
extern fn rt_mutex_unlock(mutex: Any, new_value: Any) -> i64
@unsafe(reason: "consumes an idle runtime-owned mutex handle", capabilities: [ffi])
extern fn rt_mutex_free(mutex: Any)

@unsafe(reason: "runtime-owned RwLock handle ABI carrying an initial RuntimeValue", capabilities: [ffi])
extern fn rt_rwlock_new(value: Any) -> Any
@unsafe(reason: "runtime RwLock snapshot ABI; provider guard does not escape the call", capabilities: [ffi])
extern fn rt_rwlock_read(lock: Any) -> Any
@unsafe(reason: "runtime RwLock try-read snapshot ABI; nil conflates contention and failure", capabilities: [ffi])
extern fn rt_rwlock_try_read(lock: Any) -> Any
@unsafe(reason: "runtime RwLock write snapshot ABI; provider guard does not escape the call", capabilities: [ffi])
extern fn rt_rwlock_write(lock: Any) -> Any
@unsafe(reason: "runtime RwLock try-write snapshot ABI; nil conflates contention and failure", capabilities: [ffi])
extern fn rt_rwlock_try_write(lock: Any) -> Any
@unsafe(reason: "runtime RwLock value-update ABI with integer status", capabilities: [ffi])
extern fn rt_rwlock_set(lock: Any, new_value: Any) -> i64
@unsafe(reason: "consumes a runtime-owned RwLock handle", capabilities: [ffi])
extern fn rt_rwlock_free(lock: Any)

@unsafe(reason: "runtime condvar registry handle ABI", capabilities: [ffi])
extern fn rt_condvar_new() -> i64
@unsafe(reason: "provider is a non-waiting stub and does not integrate the mutex guard", capabilities: [ffi])
extern fn rt_condvar_wait(cv: i64, mutex: Any)
@unsafe(reason: "provider sleeps rather than atomically releasing/reacquiring the mutex", capabilities: [ffi])
extern fn rt_condvar_wait_timeout(cv: i64, mutex: Any, millis: i64) -> i64
@unsafe(reason: "runtime condvar registry notification ABI", capabilities: [ffi])
extern fn rt_condvar_notify_one(cv: i64)
@unsafe(reason: "runtime condvar registry broadcast ABI", capabilities: [ffi])
extern fn rt_condvar_notify_all(cv: i64)
@unsafe(reason: "consumes a runtime condvar registry handle", capabilities: [ffi])
extern fn rt_condvar_free(cv: i64)

@unsafe(reason: "runtime Once registry handle ABI", capabilities: [ffi])
extern fn rt_once_new() -> i64
@unsafe(reason: "provider callback execution is a stub and must not establish completion", capabilities: [ffi, raw_ptr])
extern fn rt_once_call(once: i64, func: i64)
@unsafe(reason: "runtime Once completion-state ABI", capabilities: [ffi])
extern fn rt_once_is_completed(once: i64) -> bool
@unsafe(reason: "consumes a runtime Once registry handle", capabilities: [ffi])
extern fn rt_once_free(once: i64)

@unsafe(reason: "runtime thread-local registry handle ABI", capabilities: [ffi])
extern fn rt_thread_local_new() -> i64
@unsafe(reason: "runtime thread-local RuntimeValue ABI; nil means unset or invalid", capabilities: [ffi])
extern fn rt_thread_local_get(tls: i64) -> Any
@unsafe(reason: "runtime thread-local RuntimeValue store ABI", capabilities: [ffi])
extern fn rt_thread_local_set(tls: i64, value: Any)
@unsafe(reason: "invalidates a runtime thread-local registry handle", capabilities: [ffi])
extern fn rt_thread_local_free(tls: i64)

/**
Mutex for mutual exclusion.

Provides exclusive access to protected data.
Only one thread can hold the lock at a time.

```sdoctest
>>> val data = Mutex.new(0)
>>> data.lock(_1 + 1)
>>> data.lock(\x: x)
1
```
*/
struct Mutex<T>:
    _handle: Any
    _value: T

    # Create a new mutex protecting a value.
    fn new(value: T) -> Mutex<T>:
        val handle = rt_mutex_new(value)
        return Mutex(_handle: handle, _value: value)

    # Lock the mutex and apply a function to the protected value.
    # Returns the function's result.
    fn lock<R>(self, func: fn(T) -> R) -> R:
        val current = rt_mutex_lock(self._handle)
        val result = func(current)
        rt_mutex_unlock(self._handle, current)
        return result

    # Try to lock the mutex without blocking.
    # Returns Some(result) if lock acquired, None otherwise.
    fn try_lock<R>(self, func: fn(T) -> R) -> Option<R>:
        val current = rt_mutex_try_lock(self._handle)
        if current != nil:
            val result = func(current)
            rt_mutex_unlock(self._handle, current)
            return Option.Some(result)
        return Option.None

    # Lock and mutate the protected value.
    fn with_lock(self, func: fn(T) -> T):
        val current = rt_mutex_lock(self._handle)
        self._value = func(current)
        rt_mutex_unlock(self._handle, self._value)

    # Get a copy of the protected value.
    fn get(self) -> T:
        return self.lock(\x: x)

    # Set the protected value.
    fn set(self, value: T):
        self.with_lock(\_: value)

    # Free the mutex.
    fn free(self):
        rt_mutex_free(self._handle)

    # =========================================================================
    # Helper Methods
    # =========================================================================

    fn summary() -> text:
        """Get summary of mutex.

        Returns:
            Human-readable summary

        Example:
            mutex.summary()
            # → "Mutex<T>"
        """
        return "Mutex<T>"

/**
Reader-writer lock.

Allows multiple concurrent readers or one exclusive writer.
Ideal for read-heavy workloads.

```sdoctest
>>> val data = RwLock.new(Map.new())
>>> data.read(_1.get("key"))  # Multiple readers OK
>>> data.write(_1.insert("key", 42))  # Exclusive write
```
*/
struct RwLock<T>:
    _handle: Any
    _value: T

    fn new(value: T) -> RwLock<T>:
        val handle = rt_rwlock_new(value)
        return RwLock(_handle: handle, _value: value)

    # Acquire read lock and apply function.
    # Multiple readers can hold the lock simultaneously.
    fn read<R>(self, func: fn(T) -> R) -> R:
        return func(rt_rwlock_read(self._handle))

    # Try to acquire read lock without blocking.
    fn try_read<R>(self, func: fn(T) -> R) -> Option<R>:
        val current = rt_rwlock_try_read(self._handle)
        if current != nil:
            val result = func(current)
            return Option.Some(result)
        return Option.None

    # Acquire write lock and apply function.
    # Exclusive access - no other readers or writers.
    fn write<R>(self, func: fn(T) -> R) -> R:
        val current = rt_rwlock_write(self._handle)
        val result = func(current)
        rt_rwlock_set(self._handle, current)
        return result

    # Try to acquire write lock without blocking.
    fn try_write<R>(self, func: fn(T) -> R) -> Option<R>:
        val current = rt_rwlock_try_write(self._handle)
        if current != nil:
            val result = func(current)
            rt_rwlock_set(self._handle, current)
            return Option.Some(result)
        return Option.None

    # Write lock and mutate.
    fn with_write(self, func: fn(T) -> T):
        val current = rt_rwlock_write(self._handle)
        self._value = func(current)
        rt_rwlock_set(self._handle, self._value)

    # Get value (read lock).
    fn get(self) -> T:
        return self.read(\x: x)

    # Set value (write lock).
    fn set(self, value: T):
        self.with_write(\_: value)

    fn free(self):
        rt_rwlock_free(self._handle)

    # =========================================================================
    # Helper Methods
    # =========================================================================

    fn summary() -> text:
        """Get summary of reader-writer lock.

        Returns:
            Human-readable summary

        Example:
            rwlock.summary()
            # → "RwLock<T>"
        """
        return "RwLock<T>"

/**
Condition variable for thread signaling.

Used with a mutex to wait for conditions.

```sdoctest
>>> val mutex = Mutex.new(false)
>>> val cv = CondVar.new()
>>> # Thread 1: Wait for condition
>>> mutex.lock(\ready:
...     while not ready:
...         cv.wait(mutex)
... )
>>> # Thread 2: Signal condition
>>> mutex.with_lock(\_: true)
>>> cv.notify_one()
```
*/
struct CondVar:
    _handle: i64

    static fn new() -> CondVar:
        val handle = rt_condvar_new()
        return CondVar(_handle: handle)

    # Wait on the condition variable.
    # Must be called while holding the mutex lock.
    # Releases the mutex while waiting and reacquires on wake.
    fn wait(self, mutex: Mutex<Any>):
        rt_condvar_wait(self._handle, mutex._handle)

    # Wait with timeout.
    # Returns true if signaled, false if timed out.
    fn wait_timeout(self, mutex: Mutex<Any>, millis: i64) -> bool:
        return rt_condvar_wait_timeout(self._handle, mutex._handle, millis) == 1

    # Wake one waiting thread.
    fn notify_one(self):
        rt_condvar_notify_one(self._handle)

    # Wake all waiting threads.
    fn notify_all(self):
        rt_condvar_notify_all(self._handle)

    fn free(self):
        rt_condvar_free(self._handle)

    # =========================================================================
    # Helper Methods
    # =========================================================================

    fn summary() -> text:
        """Get summary of condition variable.

        Returns:
            Human-readable summary

        Example:
            cv.summary()
            # → "CondVar"
        """
        return "CondVar"

/**
Once - one-time initialization.

Ensures a function is called exactly once.

```sdoctest
>>> val once = Once.new()
>>> val called = 0
>>> once.call(\: called = called + 1)
>>> once.call(\: called = called + 1)
>>> called
1
```
*/
struct Once:
    _handle: i64
    _completed: bool

    static fn new() -> Once:
        val handle = rt_once_new()
        return Once(_handle: handle, _completed: false)

    # Call the function exactly once.
    # Subsequent calls are no-ops.
    fn call(self, func: fn()):
        if not self._completed:
            # The current provider callback entry point is a documented stub;
            # invoke locally rather than silently skipping the initializer.
            func()
            self._completed = true

    # Call with result.
    # Returns the result from the first call.
    fn call_once<T>(self, func: fn() -> T, default: T) -> T:
        if not self._completed:
            val result = func()
            self._completed = true
            return result
        return default

    # Check if already called.
    fn is_completed(self) -> bool:
        return self._completed or rt_once_is_completed(self._handle)

    fn free(self):
        rt_once_free(self._handle)

    # =========================================================================
    # Helper Methods
    # =========================================================================

    fn is_pending(self) -> bool:
        """Check if not yet called."""
        return not self.is_completed()

    fn summary(self) -> text:
        """Get summary of once.

        Returns:
            Human-readable summary

        Example:
            once.summary()
            # → "Once: completed" or "Once: pending"
        """
        val status = if self.is_completed(): "completed" else: "pending"
        return "Once: {status}"

/**
Lazy - lazy initialization.

Defers initialization until first access.

```sdoctest
>>> val lazy = Lazy.new(\: expensive_computation())
>>> # Value not computed yet
>>> lazy.get()  # Computes on first access
>>> lazy.get()  # Returns cached value
```
*/
struct Lazy<T>:
    _init: fn() -> T
    _value: Option<T>
    _once: Once

    fn new(init: fn() -> T) -> Lazy<T>:
        return Lazy(
            _init: init,
            _value: Option.None,
            _once: Once.new()
        )

    # Get the value, initializing if necessary.
    fn get(self) -> T:
        if self._value.is_none():
            self._once.call(\:
                self._value = Option.Some(self._init())
            )
        return self._value.unwrap()

    # Check if value has been initialized.
    fn is_initialized(self) -> bool:
        return self._value.is_some()

    # Force initialization.
    fn force(self) -> T:
        return self.get()

    fn free(self):
        self._once.free()

    # =========================================================================
    # Helper Methods
    # =========================================================================

    fn is_uninitialized(self) -> bool:
        """Check if not yet initialized."""
        return not self.is_initialized()

    fn summary(self) -> text:
        """Get summary of lazy value.

        Returns:
            Human-readable summary

        Example:
            lazy.summary()
            # → "Lazy<T>: initialized" or "Lazy<T>: uninitialized"
        """
        val status = if self.is_initialized(): "initialized" else: "uninitialized"
        return "Lazy<T>: {status}"

/**
Thread-local storage.

Each thread gets its own copy of the value.

```sdoctest
>>> val tls = ThreadLocal.new(\: Buffer.new(1024))
>>> val buf = tls.get()  # Per-thread buffer
```
*/
struct ThreadLocal<T>:
    _handle: i64
    _init: fn() -> T

    fn new(init: fn() -> T) -> ThreadLocal<T>:
        val handle = rt_thread_local_new()
        return ThreadLocal(_handle: handle, _init: init)

    # Get this thread's value, initializing if needed.
    fn get(self) -> T:
        val current = rt_thread_local_get(self._handle)
        if current == nil:
            val initialized = self._init()
            rt_thread_local_set(self._handle, initialized)
            return initialized
        return current

    # Set this thread's value.
    fn set(self, value: T):
        rt_thread_local_set(self._handle, value)

    # Apply function to thread-local value.
    fn with<R>(self, func: fn(T) -> R) -> R:
        return func(self.get())

    fn free(self):
        rt_thread_local_free(self._handle)

    # =========================================================================
    # Helper Methods
    # =========================================================================

    fn summary() -> text:
        """Get summary of thread-local storage.

        Returns:
            Human-readable summary

        Example:
            tls.summary()
            # → "ThreadLocal<T>"
        """
        return "ThreadLocal<T>"

/**
Barrier for thread synchronization.

All threads must reach the barrier before any proceed.

```sdoctest
>>> val barrier = Barrier.new(4)
>>> # In each of 4 threads:
>>> barrier.wait()  # Blocks until all 4 arrive
```
*/
struct Barrier:
    _count: i64
    _waiting: AtomicInt
    _generation: AtomicInt
    _mutex: Mutex<bool>
    _cv: CondVar

    fn new(count: i64) -> Barrier:
        use infra.atomic.AtomicInt
        return Barrier(
            _count: count,
            _waiting: AtomicInt.new(0),
            _generation: AtomicInt.new(0),
            _mutex: Mutex.new(false),
            _cv: CondVar.new()
        )

    # Wait at the barrier.
    # Returns true for one thread (the "leader").
    fn wait(self) -> bool:
        val generator = self._generation.load()
        val arrived = self._waiting.fetch_add(1) + 1

        if arrived == self._count:
            # Last thread - release all
            self._waiting.store(0)
            self._generation.fetch_add(1)
            self._cv.notify_all()
            return true
        else:
            # Wait for others
            self._mutex.lock(\ready:
                while self._generation.load() == generator:
                    self._cv.wait(self._mutex)
            )
            return false

    @unsafe(reason: "manual release invalidates copied synchronization aliases", capabilities: [ffi])
    fn free(self):
        unsafe(capabilities: [ffi]):
            self._waiting.free()
        unsafe(capabilities: [ffi]):
            self._generation.free()
        self._mutex.free()
        self._cv.free()

    # =========================================================================
    # Helper Methods
    # =========================================================================

    fn waiting_count(self) -> i64:
        """Get number of threads currently waiting at barrier."""
        return self._waiting.load()

    fn is_full(self) -> bool:
        """Check if all threads have arrived at barrier."""
        return self._waiting.load() >= self._count

    fn is_empty(self) -> bool:
        """Check if no threads are waiting."""
        return self._waiting.load() == 0

    fn summary(self) -> text:
        """Get summary of barrier.

        Returns:
            Human-readable summary

        Example:
            barrier.summary()
            # → "Barrier: 3/4 waiting"
        """
        val waiting = self.waiting_count()
        val total = self._count
        return "Barrier: {waiting}/{total} waiting"

/**
Semaphore for resource limiting.

```sdoctest
>>> val sem = Semaphore.new(3)  # 3 permits
>>> sem.acquire()  # Get permit (blocks if none available)
>>> sem.release()  # Return permit
```
*/
struct Semaphore:
    _permits: AtomicInt
    _max: i64
    _mutex: Mutex<bool>
    _cv: CondVar

    fn new(permits: i64) -> Semaphore:
        use infra.atomic.AtomicInt
        return Semaphore(
            _permits: AtomicInt.new(permits),
            _max: permits,
            _mutex: Mutex.new(false),
            _cv: CondVar.new()
        )

    fn acquire(self):
        while true:
            val current = self._permits.load()
            if current > 0:
                val exchanged = self._permits.compare_exchange(current, current - 1)
                if exchanged:
                    return
            # Wait for permit
            self._mutex.lock(\ready:
                if self._permits.load() == 0:
                    self._cv.wait(self._mutex)
            )

    fn try_acquire(self) -> bool:
        val current = self._permits.load()
        if current > 0:
            return self._permits.compare_exchange(current, current - 1)
        return false

    fn release(self):
        val current = self._permits.load()
        if current < self._max:
            self._permits.fetch_add(1)
            self._cv.notify_one()

    fn available(self) -> i64:
        return self._permits.load()

    @unsafe(reason: "manual release invalidates copied synchronization aliases", capabilities: [ffi])
    fn free(self):
        unsafe(capabilities: [ffi]):
            self._permits.free()
        self._mutex.free()
        self._cv.free()

    # =========================================================================
    # Helper Methods
    # =========================================================================

    fn is_exhausted(self) -> bool:
        """Check if no permits available."""
        return self.available() == 0

    fn is_full(self) -> bool:
        """Check if all permits are available."""
        return self.available() >= self._max

    fn in_use(self) -> i64:
        """Get number of permits currently in use."""
        return self._max - self.available()

    fn max_permits(self) -> i64:
        """Get maximum number of permits."""
        return self._max

    fn summary(self) -> text:
        """Get summary of semaphore.

        Returns:
            Human-readable summary

        Example:
            sem.summary()
            # → "Semaphore: 2/5 permits available"
        """
        val avail = self.available()
        val total = self._max
        return "Semaphore: {avail}/{total} permits available"

/**
Latch - one-time countdown barrier.

```sdoctest
>>> val latch = Latch.new(3)
>>> # Each worker calls countdown()
>>> latch.countdown()
>>> # Main thread waits
>>> latch.wait()  # Blocks until count reaches 0
```
*/
struct Latch:
    _count: AtomicInt
    _mutex: Mutex<bool>
    _cv: CondVar

    fn new(count: i64) -> Latch:
        use infra.atomic.AtomicInt
        return Latch(
            _count: AtomicInt.new(count),
            _mutex: Mutex.new(false),
            _cv: CondVar.new()
        )

    fn countdown(self):
        val old = self._count.fetch_sub(1)
        if old == 1:
            self._cv.notify_all()

    fn wait(self):
        self._mutex.lock(\ready:
            while self._count.load() > 0:
                self._cv.wait(self._mutex)
        )

    fn is_done(self) -> bool:
        return self._count.load() == 0

    @unsafe(reason: "manual release invalidates copied synchronization aliases", capabilities: [ffi])
    fn free(self):
        unsafe(capabilities: [ffi]):
            self._count.free()
        self._mutex.free()
        self._cv.free()

    # =========================================================================
    # Helper Methods
    # =========================================================================

    fn is_pending(self) -> bool:
        """Check if latch is not yet done."""
        return not self.is_done()

    fn remaining(self) -> i64:
        """Get remaining count."""
        return self._count.load()

    fn summary(self) -> text:
        """Get summary of latch.

        Returns:
            Human-readable summary

        Example:
            latch.summary()
            # → "Latch: 2 remaining" or "Latch: done"
        """
        if self.is_done():
            return "Latch: done"
        else:
            val rem = self.remaining()
            return "Latch: {rem} remaining"
