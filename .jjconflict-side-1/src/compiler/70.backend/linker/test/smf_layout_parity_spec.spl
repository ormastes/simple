# SMF wire-layout parity spec — guards src/spec/artifact/smf_v1_2.sdn
#
# Audit 2026-08-10: the pure-Simple SmfHeader is a PACKED 128-byte layout
# (trailer at EOF-128); the Rust seed's #[repr(C)] SmfHeader is 96 bytes with
# alignment padding (trailer at EOF-96). They are NOT wire-identical. This
# spec pins the Simple side byte-for-byte so any drift from the normative
# schema is caught, and encodes the measured Rust offsets so a future
# convergence (or further drift) must update this file consciously.

use compiler.backend.linker.smf_header.{SmfHeader, SMF_HEADER_SIZE, smf_header_from_bytes}
use compiler.backend.linker.smf_enums.{Platform, Arch}

# Rust seed offsets, measured 2026-08-10 by compiled offset_of probe against
# src/compiler_rust/common/src/smf/header.rs (repr(C), size 96).
val RUST_SEED_HEADER_SIZE: i64 = 96
val RUST_SECTION_TABLE_OFFSET: i64 = 24   # Simple packed layout: 20
val RUST_ENTRY_POINT_OFFSET: i64 = 48     # Simple packed layout: 44
val RUST_APP_TYPE_OFFSET: i64 = 80        # Simple packed layout: 76

fn sample_header() -> SmfHeader:
    var h = SmfHeader.new_v1_1(Platform.Linux, Arch.X86_64)
    h.section_count = 3
    h.section_table_offset = 0x1122334455667788
    h.symbol_table_offset = 0x0102030405060708
    h.symbol_count = 7
    h.exported_count = 5
    h.entry_point = 0xAABBCCDDEEFF0011
    h.stub_size = 0x11223344
    h.smf_data_offset = 0x55667788
    h.module_hash = 0xDEADBEEFCAFEF00D
    h.source_hash = 0x0123456789ABCDEF
    h.app_type = 2
    h

describe "SMF v1.1 packed 128-byte layout (Simple side)":
    it "serializes to exactly 128 bytes":
        val bytes = sample_header().to_bytes()
        expect bytes.len() == 128
        expect SMF_HEADER_SIZE == 128

    it "places fields at the normative packed offsets":
        val bytes = sample_header().to_bytes()
        # section_table_offset at 20 (LE u64 0x1122334455667788 -> first byte 0x88)
        expect bytes[20] == 0x88
        expect bytes[27] == 0x11
        # symbol_count u32 at 36
        expect bytes[36] == 7
        # exported_count u32 at 40
        expect bytes[40] == 5
        # entry_point at 44 (LE -> first byte 0x11)
        expect bytes[44] == 0x11
        expect bytes[51] == 0xAA
        # module_hash at 60 (LE 0xDEADBEEFCAFEF00D -> first byte 0x0D)
        expect bytes[60] == 0x0D
        # app_type at 76
        expect bytes[76] == 2
        # window_width 1280 = 0x0500 at 77
        expect bytes[77] == 0x00
        expect bytes[78] == 0x05

    it "round-trips through smf_header_from_bytes at offset 0 (v1.0 leading header)":
        val h = sample_header()
        val parsed = smf_header_from_bytes(h.to_bytes())
        match parsed:
            Ok(p):
                expect p.section_table_offset == h.section_table_offset
                expect p.symbol_table_offset == h.symbol_table_offset
                expect p.entry_point == h.entry_point
                expect p.module_hash == h.module_hash
                expect p.app_type == h.app_type
            Err(e):
                expect e == ""  # fail loudly

    it "reads the v1.1 trailer at EOF-128 with a stub prefix":
        val h = sample_header()
        var file: [u8] = []
        var i = 0
        while i < 64:            # fake stub, no magic at 0
            file.push(0x90)
            i = i + 1
        file = file + h.to_bytes()
        val parsed = smf_header_from_bytes(file)
        match parsed:
            Ok(p):
                expect p.entry_point == h.entry_point
            Err(e):
                expect e == ""

    it "rejects a truncated header":
        val bytes = sample_header().to_bytes()
        var short: [u8] = []
        var i = 0
        while i < 100:
            short.push(bytes[i])
            i = i + 1
        expect smf_header_from_bytes(short).err.?

    it "stores compile-options hash in reserved bytes 88..104":
        var h = sample_header()
        var opts: [u8] = []
        var i = 0
        while i < 16:
            opts.push((i + 1) as u8)
            i = i + 1
        h.set_compile_options_bytes(opts)
        expect h.has_compile_options_hash()
        val bytes = h.to_bytes()
        expect bytes[88] == 1
        expect bytes[103] == 16
        expect bytes[104] == 0

describe "Rust seed divergence (documented, measured 2026-08-10)":
    it "records that the seed header is NOT wire-identical to the packed layout":
        # If either side is ever converged, update these AND smf_v1_2.sdn.
        expect RUST_SEED_HEADER_SIZE != SMF_HEADER_SIZE
        expect RUST_SECTION_TABLE_OFFSET != 20
        expect RUST_ENTRY_POINT_OFFSET != 44
        expect RUST_APP_TYPE_OFFSET != 76
