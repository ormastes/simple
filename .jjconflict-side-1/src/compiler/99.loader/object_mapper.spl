# Compatibility executable object mapper surface for interpreter/test runner.
# Keep these class names, fields, numeric widths, and method signatures exact;
# only the raw executable-memory transaction is delegated to the shared owner.

use compiler.loader.loader.exec_mapping.{exec_mapping_map_rx, exec_mapping_free}

class SharedExecMapperConfig:
    verbose: bool

    static fn default() -> SharedExecMapperConfig:
        SharedExecMapperConfig(verbose: false)

class SharedExecRecord:
    owner_id: text
    symbol: text
    address: i64
    size: i64
    generation: i64

class SharedExecMapperStats:
    mapped_symbols: i64
    owner_count: i64
    total_bytes: i64
    generation: i64

class SharedExecMapper:
    config: SharedExecMapperConfig
    records: Dict<text, SharedExecRecord>
    total_bytes: i64
    generation: i64

    static fn new(config: SharedExecMapperConfig) -> SharedExecMapper:
        SharedExecMapper(config: config, records: {}, total_bytes: 0, generation: 0)

    me map_symbol(owner_id: text, symbol: text, code: [u8], allow_replace: bool) -> Result<i64, text>:
        if code.len() == 0:
            return Err("Cannot map empty code for symbol " + symbol)
        if self.records.has(symbol) and not allow_replace:
            return Err("Symbol already mapped: " + symbol)

        if self.records.has(symbol):
            val old = self.records[symbol]
            if not exec_mapping_free(old.address, old.size):
                return Err("Failed to free existing mapping for " + symbol)
            self.total_bytes = self.total_bytes - old.size
            self.records = self.records.remove(symbol)

        val mapped = exec_mapping_map_rx(symbol, code)
        if mapped.is_err():
            return Err(mapped.unwrap_err())

        self.generation = self.generation + 1
        val address = mapped.unwrap()
        self.records[symbol] = SharedExecRecord(
            owner_id: owner_id,
            symbol: symbol,
            address: address,
            size: code.len() as i64,
            generation: self.generation
        )
        self.total_bytes = self.total_bytes + code.len() as i64
        Ok(address)

    fn lookup(symbol: text) -> i64?:
        if self.records.has(symbol):
            return Some(self.records[symbol].address)
        nil

    fn get_record(symbol: text) -> SharedExecRecord?:
        if self.records.has(symbol):
            return Some(self.records[symbol])
        nil

    me unmap_symbol(symbol: text) -> bool:
        if not self.records.has(symbol):
            return false
        val rec = self.records[symbol]
        if not exec_mapping_free(rec.address, rec.size):
            return false
        self.total_bytes = self.total_bytes - rec.size
        self.records = self.records.remove(symbol)
        true

    me unmap_owner(owner_id: text) -> i64:
        var names: [text] = []
        for symbol in self.records.keys():
            if self.records[symbol].owner_id == owner_id:
                names.push(symbol)
        var removed = 0i64
        for name in names:
            if self.unmap_symbol(name):
                removed = removed + 1
        removed

    me clear():
        var names: [text] = []
        for symbol in self.records.keys():
            names.push(symbol)
        for name in names:
            _ = self.unmap_symbol(name)

    fn stats() -> SharedExecMapperStats:
        var owners: Set<text> = {}
        for symbol in self.records.keys():
            owners = owners.insert(self.records[symbol].owner_id)
        SharedExecMapperStats(
            mapped_symbols: self.records.keys().len() as i64,
            owner_count: owners.len() as i64,
            total_bytes: self.total_bytes,
            generation: self.generation
        )

class LoaderMapperConfig:
    allow_replace_on_reload: bool

    static fn default() -> LoaderMapperConfig:
        LoaderMapperConfig(allow_replace_on_reload: false)

class LoaderMapper:
    config: LoaderMapperConfig

    static fn new(config: LoaderMapperConfig) -> LoaderMapper:
        LoaderMapper(config: config)

    fn map(exec_mapper: SharedExecMapper, owner_id: text, symbol: text, code: [u8], allow_replace_request: bool) -> Result<i64, text>:
        if allow_replace_request and not self.config.allow_replace_on_reload:
            return Err("Loader replace is disabled for symbol " + symbol)
        exec_mapper.map_symbol(owner_id, symbol, code, allow_replace_request)

class JitMapperConfig:
    default_owner: text
    allow_replace: bool

    static fn default() -> JitMapperConfig:
        JitMapperConfig(default_owner: "__jit__", allow_replace: true)

class JitMapper:
    config: JitMapperConfig

    static fn new(config: JitMapperConfig) -> JitMapper:
        JitMapper(config: config)

    fn map(exec_mapper: SharedExecMapper, owner_id: text, symbol: text, code: [u8]) -> Result<i64, text>:
        val effective_owner = if owner_id == "":
            self.config.default_owner
        else:
            owner_id
        exec_mapper.map_symbol(effective_owner, symbol, code, self.config.allow_replace)
