        case TokenKind.KwAs: 221
        case TokenKind.BlockStart: 240
        case TokenKind.BlockPayload: 241
        case TokenKind.BlockEnd: 242
        case TokenKind.KwPri: 243
        case _: 191

# ===== Token — lexed token with kind + span + text =====
struct Token:
    kind: TokenKind   # Relabelled tokens.spl wire code (see token_kind_from_code)
    span: LexSpan
    text: text    # Literal text of the token

fn lex_token_new(kind: i64, text: text, line: i64, col: i64) -> Token:
    # `kind` stays the raw tokens.spl wire code so every existing producer is
    # unchanged; the relabelling happens here, in one place.
    val s = LexSpan(start: 0, end_pos: 0, line: line, col: col)
    return Token(kind: token_kind_from_code(kind), span: s, text: text)

fn lex_token_eof(line: i64) -> Token:
    return lex_token_new(190, "", line, 0)

fn lex_token_error(msg: text, line: i64, col: i64) -> Token:
    return lex_token_new(191, msg, line, col)

fn token_is_keyword(t: Token) -> bool:
    val c = token_kind_code(t.kind)
    return c >= 20 and c <= 59

fn token_is_operator(t: Token) -> bool:
    val c = token_kind_code(t.kind)
    return c >= 60 and c <= 139

fn token_is_literal(t: Token) -> bool:
    val c = token_kind_code(t.kind)
    return c >= 1 and c <= 6
    return t.kind >= 1 and t.kind <= 6
