# Pure bootstrap low-memory option predicate.
#
# Environment ownership stays in the bootstrap API. Keeping this decision
# pure makes the complete positive/negative matrix independently testable.

pub fn bootstrap_low_memory_opt_ins_requested(
    bootstrap: text,
    stage4: text,
    low_memory: text
) -> bool:
    bootstrap == "1" and stage4 == "1" and low_memory == "1"
