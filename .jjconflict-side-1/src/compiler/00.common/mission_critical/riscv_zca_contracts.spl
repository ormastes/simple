# Canonical strict-HWIR contracts for proven common-Zca semantic intrinsics.
#
# This compiler-common schema has no dependency on hardware-library code.  The
# compiler consumes it to validate MIR and the hardware capability catalog
# consumes it to report evidence, avoiding reverse compiler->library imports.

pub class RiscvZcaStrictContract:
    isa_id: text
    intrinsic_name: text
    row_label: text
    xlen_scope: text

pub fn riscv_zca_strict_contracts() -> [RiscvZcaStrictContract]:
    [
        RiscvZcaStrictContract(isa_id: "zca.c.addi4spn", intrinsic_name: "__simple_riscv_zca_addi4spn_row_v1", row_label: "C.ADDI4SPN", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.lw", intrinsic_name: "__simple_riscv_zca_lw_row_v1", row_label: "C.LW", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.sw", intrinsic_name: "__simple_riscv_zca_sw_row_v1", row_label: "C.SW", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.lwsp", intrinsic_name: "__simple_riscv_zca_lwsp_row_v1", row_label: "C.LWSP", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.swsp", intrinsic_name: "__simple_riscv_zca_swsp_row_v1", row_label: "C.SWSP", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.nop_addi", intrinsic_name: "__simple_riscv_zca_caddi_row_v1", row_label: "C.ADDI", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.addi16sp", intrinsic_name: "__simple_riscv_zca_caddi16sp_row_v1", row_label: "C.ADDI16SP", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.lui", intrinsic_name: "__simple_riscv_zca_clui_row_v1", row_label: "C.LUI", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.li", intrinsic_name: "__simple_riscv_zca_cli_row_v1", row_label: "C.LI", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.slli", intrinsic_name: "__simple_riscv_zca_slli_low_row_v1", row_label: "C.SLLI.low", xlen_scope: "rv32-rv64-low-shamt"),
        RiscvZcaStrictContract(isa_id: "zca.c.srli", intrinsic_name: "__simple_riscv_zca_srli_low_row_v1", row_label: "C.SRLI.low", xlen_scope: "rv32-rv64-low-shamt"),
        RiscvZcaStrictContract(isa_id: "zca.c.srai", intrinsic_name: "__simple_riscv_zca_srai_low_row_v1", row_label: "C.SRAI.low", xlen_scope: "rv32-rv64-low-shamt"),
        RiscvZcaStrictContract(isa_id: "zca.c.andi", intrinsic_name: "__simple_riscv_zca_candi_row_v1", row_label: "C.ANDI", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.sub", intrinsic_name: "__simple_riscv_zca_csub_row_v1", row_label: "C.SUB", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.xor", intrinsic_name: "__simple_riscv_zca_cxor_row_v1", row_label: "C.XOR", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.or", intrinsic_name: "__simple_riscv_zca_cor_row_v1", row_label: "C.OR", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.and", intrinsic_name: "__simple_riscv_zca_cand_row_v1", row_label: "C.AND", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.j", intrinsic_name: "__simple_riscv_zca_cj_predecode_v1", row_label: "C.J", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.beqz", intrinsic_name: "__simple_riscv_zca_cbeqz_predecode_v1", row_label: "C.BEQZ", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.bnez", intrinsic_name: "__simple_riscv_zca_cbnez_predecode_v1", row_label: "C.BNEZ", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.jr", intrinsic_name: "__simple_riscv_zca_cjr_row_v1", row_label: "C.JR", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.mv", intrinsic_name: "__simple_riscv_zca_cmv_row_v1", row_label: "C.MV", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.jalr", intrinsic_name: "__simple_riscv_zca_cjalr_row_v1", row_label: "C.JALR", xlen_scope: "rv32-rv64"),
        RiscvZcaStrictContract(isa_id: "zca.c.add", intrinsic_name: "__simple_riscv_zca_cadd_row_v1", row_label: "C.ADD", xlen_scope: "rv32-rv64")
    ]

pub fn riscv_zca_strict_row_label(intrinsic_name: text) -> text:
    for contract in riscv_zca_strict_contracts():
        if contract.intrinsic_name == intrinsic_name:
            return contract.row_label
    ""

pub fn riscv_zca_strict_isa_id(intrinsic_name: text) -> text:
    for contract in riscv_zca_strict_contracts():
        if contract.intrinsic_name == intrinsic_name:
            return contract.isa_id
    ""

pub fn riscv_zca_strict_xlen_scope(intrinsic_name: text) -> text:
    for contract in riscv_zca_strict_contracts():
        if contract.intrinsic_name == intrinsic_name:
            return contract.xlen_scope
    ""
