# FormalStatus v1 — truthful formal-verification assurance lattice.
# A successful proof-engine run establishes ModelProven only. Promotion to
# ArtifactVerified requires separate source, backend, trust, and artifact
# evidence; callers must never infer that promotion from Lean's exit status.

enum FormalStatus:
    NotChecked
    Specified
    ModelProven
    SourceRefined
    BackendRefined
    ArtifactVerified
    TrustedBoundary
    AdmittedDevelopment
    Unsupported
    Failed
    Stale

# Frozen public schema spelling. The short name remains a compatibility alias
# for existing V1 consumers; both denote the same closed lattice.
type FormalStatusV1 = FormalStatus

impl FormalStatus:
    fn name() -> text:
        match self:
            FormalStatus.NotChecked: "not_checked"
            FormalStatus.Specified: "specified"
            FormalStatus.ModelProven: "model_proven"
            FormalStatus.SourceRefined: "source_refined"
            FormalStatus.BackendRefined: "backend_refined"
            FormalStatus.ArtifactVerified: "artifact_verified"
            FormalStatus.TrustedBoundary: "trusted_boundary"
            FormalStatus.AdmittedDevelopment: "admitted_development"
            FormalStatus.Unsupported: "unsupported"
            FormalStatus.Failed: "failed"
            FormalStatus.Stale: "stale"

    fn permits_verified_release() -> bool:
        match self:
            FormalStatus.ArtifactVerified: true
            case _: false

    fn refinement_rank() -> i64:
        match self:
            FormalStatus.Specified: 1
            FormalStatus.ModelProven: 2
            FormalStatus.SourceRefined: 3
            FormalStatus.BackendRefined: 4
            FormalStatus.ArtifactVerified: 5
            case _: 0

fn formal_status_from_legacy_verified(lean_succeeded: bool) -> FormalStatus:
    if lean_succeeded:
        return FormalStatus.ModelProven
    FormalStatus.Failed
