# CriticalSymbolSummaryV1 — FROZEN SCHEMA (WP-0, 2026-08-07).
#
# The per-symbol fact sheet that every downstream analysis writes into and the
# release gate reads out of. Consumers per the plan's shared-contracts table:
# closure analysis, resource/allocation classes (WP-11..WP-15), contracts and
# AoRTE obligations (WP-16), traceability (WP-23).
#
# Design rules baked in:
#  * Every lattice has an explicit `Unknown` bottom. `Unknown` is NOT a
#    permissive default — under `critical` it is an error. The repo's
#    measurement history is full of absent-means-fine defaults; this schema
#    refuses that shape.
#  * `symbol_id` is a SymbolId string, never a source path + line. Plan
#    research S6 rejects "stale line-number-only links" explicitly.
#  * No dict fields. Lists only — struct-valued dicts corrupt under native
#    codegen and `Dict.len()` returns -1.

# Allocation behaviour of a symbol and everything it can reach.
# Ordered lattice; `Unbounded` and `Unknown` both reject under `critical`
# (FLT-MEM-001).
enum AllocationClass:
    NoAlloc      # never allocates
    InitOnly     # allocates only before the startup seal
    BoundedPool  # allocates from a fixed-capacity pool that cannot grow
    Unbounded    # can allocate without a static bound -> reject
    Unknown      # not classified -> reject

impl AllocationClass:
    fn name() -> text:
        match self:
            AllocationClass.NoAlloc: "none"
            AllocationClass.InitOnly: "init_only"
            AllocationClass.BoundedPool: "bounded_pool"
            AllocationClass.Unbounded: "unbounded"
            AllocationClass.Unknown: "unknown"

    static fn from_name(raw: text) -> AllocationClass:
        if raw == "none":
            return AllocationClass.NoAlloc
        if raw == "init_only":
            return AllocationClass.InitOnly
        if raw == "bounded_pool":
            return AllocationClass.BoundedPool
        if raw == "unbounded":
            return AllocationClass.Unbounded
        AllocationClass.Unknown

    fn is_flight_acceptable() -> bool:
        match self:
            AllocationClass.Unbounded: false
            AllocationClass.Unknown: false
            _: true

# Whether the symbol can block, and for how long.
enum BlockingBehavior:
    NonBlocking
    BoundedBlocking    # bounded by a declared ceiling (priority-ceiling lock)
    UnboundedBlocking  # -> reject
    Unknown            # -> reject

impl BlockingBehavior:
    fn name() -> text:
        match self:
            BlockingBehavior.NonBlocking: "non_blocking"
            BlockingBehavior.BoundedBlocking: "bounded_blocking"
            BlockingBehavior.UnboundedBlocking: "unbounded_blocking"
            BlockingBehavior.Unknown: "unknown"

    static fn from_name(raw: text) -> BlockingBehavior:
        if raw == "non_blocking":
            return BlockingBehavior.NonBlocking
        if raw == "bounded_blocking":
            return BlockingBehavior.BoundedBlocking
        if raw == "unbounded_blocking":
            return BlockingBehavior.UnboundedBlocking
        BlockingBehavior.Unknown

    fn is_flight_acceptable() -> bool:
        match self:
            BlockingBehavior.NonBlocking: true
            BlockingBehavior.BoundedBlocking: true
            _: false

# How abnormal conditions leave the symbol (FLT-ABS-004).
enum PanicBehavior:
    NoPanic        # proved not to panic or trap
    TypedResult    # abnormal conditions surface as a typed Result/enum
    PanicPossible  # a panic can escape -> reject
    TrapPossible   # a hardware trap can escape -> reject
    Unknown        # -> reject

impl PanicBehavior:
    fn name() -> text:
        match self:
            PanicBehavior.NoPanic: "no_panic"
            PanicBehavior.TypedResult: "typed_result"
            PanicBehavior.PanicPossible: "panic_possible"
            PanicBehavior.TrapPossible: "trap_possible"
            PanicBehavior.Unknown: "unknown"

    static fn from_name(raw: text) -> PanicBehavior:
        if raw == "no_panic":
            return PanicBehavior.NoPanic
        if raw == "typed_result":
            return PanicBehavior.TypedResult
        if raw == "panic_possible":
            return PanicBehavior.PanicPossible
        if raw == "trap_possible":
            return PanicBehavior.TrapPossible
        PanicBehavior.Unknown

    fn is_flight_acceptable() -> bool:
        match self:
            PanicBehavior.NoPanic: true
            PanicBehavior.TypedResult: true
            _: false

# Termination evidence for loops (FLT-CF-003) and recursion (FLT-CF-002).
enum BoundStatus:
    NotApplicable  # no loop / no recursion at all
    Inferred       # bound inferred from a range, fixed collection or constant
    ByContract     # bound supplied by invariant:/decreases: and checked
    Unbounded      # -> reject
    Unknown        # -> reject

impl BoundStatus:
    fn name() -> text:
        match self:
            BoundStatus.NotApplicable: "not_applicable"
            BoundStatus.Inferred: "inferred"
            BoundStatus.ByContract: "by_contract"
            BoundStatus.Unbounded: "unbounded"
            BoundStatus.Unknown: "unknown"

    static fn from_name(raw: text) -> BoundStatus:
        if raw == "not_applicable":
            return BoundStatus.NotApplicable
        if raw == "inferred":
            return BoundStatus.Inferred
        if raw == "by_contract":
            return BoundStatus.ByContract
        if raw == "unbounded":
            return BoundStatus.Unbounded
        BoundStatus.Unknown

    fn is_flight_acceptable() -> bool:
        match self:
            BoundStatus.Unbounded: false
            BoundStatus.Unknown: false
            _: true

# Strength of the evidence backing a claim about the symbol.
enum EvidenceStatus:
    Proved   # a checked theorem exists
    Checked  # a runtime check or an executed test covers it
    Assumed  # asserted with no discharging artifact -> needs a waiver
    Absent   # nothing at all -> reject
    Unknown  # not yet examined -> reject

impl EvidenceStatus:
    fn name() -> text:
        match self:
            EvidenceStatus.Proved: "proved"
            EvidenceStatus.Checked: "checked"
            EvidenceStatus.Assumed: "assumed"
            EvidenceStatus.Absent: "absent"
            EvidenceStatus.Unknown: "unknown"

    static fn from_name(raw: text) -> EvidenceStatus:
        if raw == "proved":
            return EvidenceStatus.Proved
        if raw == "checked":
            return EvidenceStatus.Checked
        if raw == "assumed":
            return EvidenceStatus.Assumed
        if raw == "absent":
            return EvidenceStatus.Absent
        EvidenceStatus.Unknown

    fn is_flight_acceptable() -> bool:
        match self:
            EvidenceStatus.Proved: true
            EvidenceStatus.Checked: true
            _: false

# Whether the backend actually produced code for the symbol. Present because
# this repo has shipped "green" results for symbols with no native lowering at
# all (e.g. match-on-enum).
enum LoweringStatus:
    Lowered     # full native lowering exists
    Partial     # lowered on some paths / some backends only -> reject
    NotLowered  # -> reject
    Unknown     # -> reject

impl LoweringStatus:
    fn name() -> text:
        match self:
            LoweringStatus.Lowered: "lowered"
            LoweringStatus.Partial: "partial"
            LoweringStatus.NotLowered: "not_lowered"
            LoweringStatus.Unknown: "unknown"

    static fn from_name(raw: text) -> LoweringStatus:
        if raw == "lowered":
            return LoweringStatus.Lowered
        if raw == "partial":
            return LoweringStatus.Partial
        if raw == "not_lowered":
            return LoweringStatus.NotLowered
        LoweringStatus.Unknown

    fn is_flight_acceptable() -> bool:
        match self:
            LoweringStatus.Lowered: true
            _: false

# ============================================================================
# CriticalSymbolSummaryV1 — FROZEN SCHEMA.
# ============================================================================
struct CriticalSymbolSummaryV1:
    """Everything the flight gates need to know about one symbol.

    Fields:
    - symbol_id: canonical SymbolId. Not a path+line.
    - allocation_class / blocking / panic_behavior / loop_bound /
      recursion_bound / proof_status / test_status / backend_lowering:
      lattices above, each with an Unknown bottom that REJECTS.
    - effects: declared/inferred effect names.
    - capabilities: capabilities the symbol requires.
    - unsafe_ops: raw-pointer, MMIO, cast and SFFI operations performed.
    - stack_bytes: worst-case own frame in bytes; -1 means unknown (rejects
      under FLT-MEM-002, which is why it is integration-phase).
    - dyn_targets: enumerated indirect-call targets.
    - dyn_targets_closed: whether that list is provably complete. A non-empty
      list with `false` here does NOT satisfy FLT-ABS-002.
    """
    symbol_id: text
    allocation_class: AllocationClass
    blocking: BlockingBehavior
    effects: [text]
    capabilities: [text]
    unsafe_ops: [text]
    panic_behavior: PanicBehavior
    loop_bound: BoundStatus
    recursion_bound: BoundStatus
    stack_bytes: i64
    dyn_targets: [text]
    dyn_targets_closed: bool
    proof_status: EvidenceStatus
    test_status: EvidenceStatus
    backend_lowering: LoweringStatus

impl CriticalSymbolSummaryV1:
    # A summary for a symbol nothing has analysed yet. EVERY lattice sits at
    # its rejecting bottom on purpose — an unanalysed symbol must fail the
    # flight gate, not pass it.
    static fn unknown_for(symbol_id: text) -> CriticalSymbolSummaryV1:
        CriticalSymbolSummaryV1(
            symbol_id: symbol_id,
            allocation_class: AllocationClass.Unknown,
            blocking: BlockingBehavior.Unknown,
            effects: [],
            capabilities: [],
            unsafe_ops: [],
            panic_behavior: PanicBehavior.Unknown,
            loop_bound: BoundStatus.Unknown,
            recursion_bound: BoundStatus.Unknown,
            stack_bytes: -1,
            dyn_targets: [],
            dyn_targets_closed: false,
            proof_status: EvidenceStatus.Unknown,
            test_status: EvidenceStatus.Unknown,
            backend_lowering: LoweringStatus.Unknown,
        )

    fn stack_known() -> bool:
        self.stack_bytes >= 0

    # Ids of the FLT-* rules this symbol currently fails. Empty means the
    # symbol clears every gate this schema can express.
    fn failing_rule_ids() -> [text]:
        var out: [text] = []
        if not self.recursion_bound.is_flight_acceptable():
            out.push("FLT-CF-002")
        if not self.loop_bound.is_flight_acceptable():
            out.push("FLT-CF-003")
        if not self.allocation_class.is_flight_acceptable():
            out.push("FLT-MEM-001")
        if not self.stack_known():
            out.push("FLT-MEM-002")
        if not self.panic_behavior.is_flight_acceptable():
            out.push("FLT-ABS-004")
        if self.dyn_targets.len() > 0 and not self.dyn_targets_closed:
            out.push("FLT-ABS-002")
        if not self.backend_lowering.is_flight_acceptable():
            out.push("FLT-IMP-001")
        if not self.proof_status.is_flight_acceptable() and not self.test_status.is_flight_acceptable():
            out.push("FLT-IMP-002")
        out

    fn is_flight_clear() -> bool:
        self.failing_rule_ids().len() == 0
