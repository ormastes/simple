# Layer-equivalence structural checker (@layer_eq first slice, extended M3).
#
# Proves that a view struct is representation-identical to its target so a
# conversion can compile to an identity (no copy, no call). Covers all 8 proof
# obligations of doc/05_design/language/forwarding/
# layer_forwarding_and_layer_eq_types.md §3:
#   1. field count
#   2. total name mapping (same-name inference or @layer_field rename tags —
#      never a partial tag set)
#   3. per-field type
#   4. per-field offset/size, whole-type size/align
#   5. enum discriminant values (same tag values in the same positions)
#   6. ownership/mutability class (owned vs borrowed, mutable vs immutable)
#   7. address space (host vs device, or any two distinct tagged spaces, is
#      never equivalent)
#   8. unit/space/color/alpha semantic-vocabulary tags (@unit, @space,
#      @color, @alpha) — absent tag ("") is compared literally, so it never
#      silently matches a present tag; this is what keeps
#      CssLogicalRect -> DevicePixelRect correctly non-equivalent.
#
# Deliberately self-contained: consumes declared layouts (LayerEqType) so it
# can be exercised under the seed binary today without pulling in the HIR /
# type_layout dependency graph. Production wiring to the compiler's real
# layout computation (obligations 1-4) lives in the sibling adapter
# `layer_eq_real_layout.spl` (`layer_eq_type_from_layout`), exercised by
# layer_eq_checker_real_layout_spec.spl. See design doc §6 TODO 3.

struct LayerEqField:
    name: text
    type_name: text
    offset: i64
    size: i64
    mapped_name: text     # "" = infer by same name; else @layer_field(target)
    ownership: text       # "owned" | "borrowed" (obligation 6)
    mutable: bool         # obligation 6
    address_space: text   # "" = default/host/stack; else a space tag e.g. "device" (obligation 7)
    unit_tag: text         # "" = no @unit tag; else e.g. "css_px" (obligation 8)
    space_tag: text        # "" = no @space tag; else e.g. "document" (obligation 8)
    color_tag: text        # "" = no @color tag; else e.g. "srgb8" (obligation 8)
    alpha_tag: text         # "" = no @alpha tag; else "straight" | "premultiplied" (obligation 8)

struct LayerEqType:
    name: text
    total_size: i64
    align: i64
    fields: [LayerEqField]
    is_enum: bool          # obligation 5: this type is enum-like (has discriminants)
    discriminants: [i64]   # parallel to `fields` (by declared position) when is_enum

struct LayerEqVerdict:
    ok: bool
    diagnostic: text

fn layer_eq_ok() -> LayerEqVerdict:
    LayerEqVerdict(ok: true, diagnostic: "")

fn layer_eq_err(msg: text) -> LayerEqVerdict:
    LayerEqVerdict(ok: false, diagnostic: "error[layer_eq]: " + msg)

# Resolve the view field's target-field name. Implicit and explicit forms both
# pass through here so they cannot drift.
fn layer_eq_mapped_name(f: LayerEqField) -> text:
    if f.mapped_name == "":
        f.name
    else:
        f.mapped_name

fn layer_eq_find_field(target: LayerEqType, name: text) -> i64:
    var i = 0
    while i < target.fields.len():
        if target.fields[i].name == name:
            return i
        i = i + 1
    0 - 1

fn check_layer_eq(view: LayerEqType, target: LayerEqType) -> LayerEqVerdict:
    # Obligation 1: field count
    if view.fields.len() != target.fields.len():
        return layer_eq_err("'" + view.name + "' has " + view.fields.len().to_text()
            + " fields but @layer_eq target '" + target.name + "' has "
            + target.fields.len().to_text())

    # Partial-tag-set rule: all fields tagged, or none.
    var tagged = 0
    for f in view.fields:
        if f.mapped_name != "":
            tagged = tagged + 1
    if tagged != 0 and tagged != view.fields.len():
        return layer_eq_err("'" + view.name + "' mixes @layer_field-tagged and "
            + "untagged fields (" + tagged.to_text() + " of "
            + view.fields.len().to_text() + " tagged); tag all fields or none")

    # Obligation 5 (whole type): enum-ness must match on both sides — a
    # struct-like view is never layer-eq to an enum-like target or vice versa.
    if view.is_enum != target.is_enum:
        return layer_eq_err("'" + view.name + "' is_enum=" + view.is_enum.to_text()
            + " != target '" + target.name + "' is_enum=" + target.is_enum.to_text())

    # Guard against a malformed enum input: an is_enum type whose
    # `discriminants` array doesn't cover every field cannot be proven, so it
    # must fail closed rather than skip the discriminant check silently.
    if view.is_enum:
        if view.discriminants.len() != view.fields.len():
            return layer_eq_err("'" + view.name + "' is_enum but has "
                + view.discriminants.len().to_text() + " discriminants for "
                + view.fields.len().to_text() + " fields")
        if target.discriminants.len() != target.fields.len():
            return layer_eq_err("'" + target.name + "' is_enum but has "
                + target.discriminants.len().to_text() + " discriminants for "
                + target.fields.len().to_text() + " fields")

    # Obligations 2-8 per field.
    var vi = 0
    while vi < view.fields.len():
        val f = view.fields[vi]
        val tname = layer_eq_mapped_name(f)
        val ti = layer_eq_find_field(target, tname)
        if ti < 0:
            return layer_eq_err("'" + view.name + "." + f.name
                + "' maps to '" + tname + "', not a field of '" + target.name + "'")
        val tf = target.fields[ti]
        if f.type_name != tf.type_name:
            return layer_eq_err("'" + view.name + "." + f.name + "': type '"
                + f.type_name + "' != target '" + target.name + "." + tf.name
                + "' type '" + tf.type_name + "'")
        if f.offset != tf.offset or f.size != tf.size:
            return layer_eq_err("'" + view.name + "." + f.name + "': layout "
                + f.offset.to_text() + "+" + f.size.to_text() + " != target '"
                + target.name + "." + tf.name + "' layout "
                + tf.offset.to_text() + "+" + tf.size.to_text())

        # Obligation 5: discriminant value at this position must match.
        if view.is_enum:
            val vd = view.discriminants[vi]
            val td = target.discriminants[ti]
            if vd != td:
                return layer_eq_err("'" + view.name + "." + f.name
                    + "': discriminant " + vd.to_text() + " != target '"
                    + target.name + "." + tf.name + "' discriminant " + td.to_text())

        # Obligation 6: ownership and mutability class must match.
        if f.ownership != tf.ownership:
            return layer_eq_err("'" + view.name + "." + f.name + "': ownership '"
                + f.ownership + "' != target '" + target.name + "." + tf.name
                + "' ownership '" + tf.ownership + "'")
        if f.mutable != tf.mutable:
            return layer_eq_err("'" + view.name + "." + f.name + "': mutable="
                + f.mutable.to_text() + " != target '" + target.name + "." + tf.name
                + "' mutable=" + tf.mutable.to_text())

        # Obligation 7: address space must match (host vs device, or any two
        # distinct tagged spaces, is never equivalent).
        if f.address_space != tf.address_space:
            return layer_eq_err("'" + view.name + "." + f.name + "': address_space '"
                + f.address_space + "' != target '" + target.name + "." + tf.name
                + "' address_space '" + tf.address_space + "'")

        # Obligation 8: unit/space/color/alpha semantic-vocabulary tags must
        # match tag-for-tag. Absent ("") is compared literally, never treated
        # as a wildcard — an absent tag is NOT equivalent to any present tag.
        if f.unit_tag != tf.unit_tag:
            return layer_eq_err("'" + view.name + "." + f.name + "': @unit '"
                + f.unit_tag + "' != target '" + target.name + "." + tf.name
                + "' @unit '" + tf.unit_tag + "'")
        if f.space_tag != tf.space_tag:
            return layer_eq_err("'" + view.name + "." + f.name + "': @space '"
                + f.space_tag + "' != target '" + target.name + "." + tf.name
                + "' @space '" + tf.space_tag + "'")
        if f.color_tag != tf.color_tag:
            return layer_eq_err("'" + view.name + "." + f.name + "': @color '"
                + f.color_tag + "' != target '" + target.name + "." + tf.name
                + "' @color '" + tf.color_tag + "'")
        if f.alpha_tag != tf.alpha_tag:
            return layer_eq_err("'" + view.name + "." + f.name + "': @alpha '"
                + f.alpha_tag + "' != target '" + target.name + "." + tf.name
                + "' @alpha '" + tf.alpha_tag + "'")

        vi = vi + 1

    # Obligation 4 (whole type): size and alignment.
    if view.total_size != target.total_size:
        return layer_eq_err("'" + view.name + "' size " + view.total_size.to_text()
            + " != target '" + target.name + "' size " + target.total_size.to_text())
    if view.align != target.align:
        return layer_eq_err("'" + view.name + "' align " + view.align.to_text()
            + " != target '" + target.name + "' align " + target.align.to_text())

    layer_eq_ok()

export LayerEqField, LayerEqType, LayerEqVerdict, check_layer_eq, layer_eq_mapped_name
