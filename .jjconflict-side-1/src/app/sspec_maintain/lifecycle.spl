# Repository-backed lifecycle metadata validation, separate from pure text facts.
use app.sspec_maintain.model.{SspecDocumentizationReport,
    SspecDocumentizationFinding}
use app.sspec_maintain.source_facts.{extract_sspec_source_facts}
use app.sspec_maintain.analyzer.{make_sspec_finding, append_sspec_findings}
use std.nogc_sync_mut.io.file_ops.{file_exists}

fn inspect_sspec_lifecycle_links(report: SspecDocumentizationReport,
        source: text) -> SspecDocumentizationReport:
    """Add findings for declared lifecycle paths that no longer resolve; O(paths)."""
    val facts = extract_sspec_source_facts(report.source_path, source)
    var additions: [SspecDocumentizationFinding] = []
    for path in facts.lifecycle_paths:
        if not file_exists(path):
            additions.push(make_sspec_finding(report.source_path,
                "SSDOC-MNT-009", 1, "lifecycle path does not exist: {path}",
                "Update the metadata to a current repository path.", 10))
    append_sspec_findings(report, additions)
