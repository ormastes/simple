# codex-impl
# Provider-neutral lifecycle capability interfaces. Provider transports and
# credentials remain behind implementations; Spipe consumes typed results.
# @ac: AC-15

use std.scv.lifecycle.model.{LifecycleResult}
use app.devhub.provider.lifecycle_capability.{ProviderCapabilities}

trait LifecycleProvider:
    fn provider_id() -> text
    fn discover_capabilities() -> ProviderCapabilities

trait ReviewProvider:
    fn fetch_review(remote_id: text, expected_revision: text) -> LifecycleResult
    fn publish_revision(review_id: text, revision_id: text, idempotency_key: text) -> LifecycleResult
    fn publish_findings(review_id: text, revision_id: text, finding_ids: [text], idempotency_key: text) -> LifecycleResult
    fn submit_verdict(review_id: text, revision_id: text, verdict: text, idempotency_key: text) -> LifecycleResult

trait TaskProvider:
    fn fetch_task(remote_id: text, expected_revision: text) -> LifecycleResult
    fn apply_task_plan(task_id: text, sync_plan_id: text, expected_revision: text, idempotency_key: text) -> LifecycleResult

trait KnowledgeProvider:
    fn fetch_document(remote_id: text, expected_revision: text) -> LifecycleResult
    fn apply_managed_regions(document_id: text, sync_plan_id: text, expected_revision: text, idempotency_key: text) -> LifecycleResult

trait ReleaseProvider:
    fn create_draft(release_id: text, revision_id: text, idempotency_key: text) -> LifecycleResult
    fn upload_asset(release_id: text, artifact_digest: text, idempotency_key: text) -> LifecycleResult
    fn verify_publication(release_id: text, expected_revision: text, artifact_digests: [text]) -> LifecycleResult
    fn withdraw(release_id: text, reason: text, idempotency_key: text) -> LifecycleResult

export LifecycleProvider, ReviewProvider, TaskProvider, KnowledgeProvider, ReleaseProvider
