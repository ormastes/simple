# Provider-owned normalization over the host-owned app.io byte capability.
# Bytes returned by the host are moved into the result.  Write input is a
# scoped read-only loan and is never retained by this adapter.

use app.io.provider_byte_stream_ops.{AppByteStreamPort}
use app.spipe_knowledge_provider.transport_types.{ProviderByteReadV1, ProviderByteWriteV1}

trait ProviderByteStreamPort:
    me read_some(maximum_bytes: i64,
                 deadline_at_ms: i64) -> ProviderByteReadV1
    me write_some(bytes: [u8], offset: i64, maximum_bytes: i64,
                  deadline_at_ms: i64) -> ProviderByteWriteV1

fn _read_internal_error(detail: text) -> ProviderByteReadV1:
    ProviderByteReadV1(status: "error", bytes: [], detail: detail)

fn _write_internal_error(detail: text) -> ProviderByteWriteV1:
    ProviderByteWriteV1(status: "error", written_bytes: 0, detail: detail)

fn provider_byte_read_normalize(status: text, bytes: [u8], detail: text,
                                maximum_bytes: i64) -> ProviderByteReadV1:
    if maximum_bytes <= 0:
        return _read_internal_error("internal_error")
    if status == "data":
        if bytes.len() <= 0 or bytes.len() > maximum_bytes:
            return _read_internal_error("internal_error")
        return ProviderByteReadV1(status: "data", bytes: bytes, detail: "")
    if bytes.len() != 0:
        return _read_internal_error("internal_error")
    if status == "timeout":
        if detail != "would_block" and detail != "deadline":
            return _read_internal_error("internal_error")
        return ProviderByteReadV1(status: status, bytes: [], detail: detail)
    if status == "eof":
        return ProviderByteReadV1(status: status, bytes: [], detail: "")
    if status == "error":
        if detail == "": return _read_internal_error("internal_error")
        return ProviderByteReadV1(status: status, bytes: [], detail: detail)
    _read_internal_error("internal_error")

fn provider_byte_write_normalize(status: text, written_bytes: i64, detail: text,
                                 offset: i64, maximum_bytes: i64,
                                 input_bytes: i64) -> ProviderByteWriteV1:
    if offset < 0 or maximum_bytes <= 0 or offset > input_bytes or
        maximum_bytes > input_bytes - offset:
        return _write_internal_error("internal_error")
    if status == "data":
        if written_bytes <= 0 or written_bytes > maximum_bytes:
            return _write_internal_error("internal_error")
        return ProviderByteWriteV1(status: "data", written_bytes: written_bytes,
            detail: "")
    if written_bytes != 0:
        return _write_internal_error("internal_error")
    if status == "timeout":
        if detail != "would_block" and detail != "deadline":
            return _write_internal_error("internal_error")
        return ProviderByteWriteV1(status: status, written_bytes: 0, detail: detail)
    if status == "eof":
        return ProviderByteWriteV1(status: status, written_bytes: 0, detail: "")
    if status == "error":
        if detail == "": return _write_internal_error("internal_error")
        return ProviderByteWriteV1(status: status, written_bytes: 0, detail: detail)
    _write_internal_error("internal_error")

class ProviderAppIoByteStreamV1 with ProviderByteStreamPort:
    host: AppByteStreamPort

    static fn configured(host: AppByteStreamPort) -> ProviderAppIoByteStreamV1:
        ProviderAppIoByteStreamV1(host: host)

    me read_some(maximum_bytes: i64,
                 deadline_at_ms: i64) -> ProviderByteReadV1:
        if deadline_at_ms < 0: return _read_internal_error("internal_error")
        val result = self.host.read_some(maximum_bytes, deadline_at_ms)
        provider_byte_read_normalize(result.status, result.bytes, result.detail,
            maximum_bytes)

    me write_some(bytes: [u8], offset: i64, maximum_bytes: i64,
                  deadline_at_ms: i64) -> ProviderByteWriteV1:
        if deadline_at_ms < 0: return _write_internal_error("internal_error")
        val result = self.host.write_some(bytes, offset, maximum_bytes,
            deadline_at_ms)
        provider_byte_write_normalize(result.status, result.written_bytes,
            result.detail, offset, maximum_bytes, bytes.len())

export ProviderByteStreamPort, ProviderAppIoByteStreamV1
export provider_byte_read_normalize, provider_byte_write_normalize
