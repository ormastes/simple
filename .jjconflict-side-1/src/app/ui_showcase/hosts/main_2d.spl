# Entry point for the 2D (raw framebuffer) showcase target.
#
# Entries live under hosts/, not at src/app/ui_showcase/ depth 1: the strict
# tier is forbidden by check-ui-showcase-layering.shs from importing
# `app.ui_showcase.hosts.*` at all, so a depth-1 `main.spl` with a `--host`
# flag would be a layering VIOLATION by construction. One entry per target
# also matches the plan's file-ownership matrix.

use std.io_runtime.{env_get, file_write_bytes, mkdir_p}
use app.ui_showcase.showcase_core.{ShowcaseRunReport, showcase_run}
use app.ui_showcase.hosts.host_2d.{Screen2dHost}
use app.ui_showcase.hosts.scene_raster.{raster_distinct_pixel_count, raster_to_ppm_bytes}

fn _env_i32(key: text, fallback: i32) -> i32:
    val raw = env_get(key).trim()
    if raw == "":
        return fallback
    raw.to_int() ?? fallback

fn showcase_report_line(report: ShowcaseRunReport) -> text:
    "showcase host={report.host_name} frames={report.frames} clicks={report.clicks} " +
        "drags={report.drags} typed=\"{report.typed_text}\" left={report.left_offset} " +
        "right={report.right_offset} free={report.free_offset}"

fn _parent_dir(path: text) -> text:
    val idx = path.last_index_of("/")
    if idx <= 0:
        return ""
    path.substring(0, idx)

fn main():
    # 320x240 default, not the plan's 800x600: the surface is allocated one
    # `push` per pixel and painted per command in-language, so 800x600 costs
    # ~480k pushes per run for no extra evidence. Override with
    # SIMPLE_SHOWCASE_W / SIMPLE_SHOWCASE_H when a bigger capture is wanted.
    val w = _env_i32("SIMPLE_SHOWCASE_W", 320)
    val h = _env_i32("SIMPLE_SHOWCASE_H", 240)
    val frames = _env_i32("SIMPLE_SHOWCASE_FRAMES", 3).to_i64()
    val script = env_get("SIMPLE_SHOWCASE_SCRIPT")

    val host = Screen2dHost.open(w, h, script)
    val report = showcase_run(host, "sc2d", frames)
    print showcase_report_line(report)

    val capture = env_get("SIMPLE_SHOWCASE_CAPTURE").trim()
    if capture != "":
        val px = host.pixels()
        val distinct = raster_distinct_pixel_count(px, 4)
        val dir = _parent_dir(capture)
        if dir != "":
            mkdir_p(dir)
        file_write_bytes(capture, raster_to_ppm_bytes(px, w, h))
        # Reported, never asserted away: a blank capture is a FAIL upstream,
        # so the count is printed rather than silently tolerated.
        print "capture path={capture} distinct_pixels={distinct}"
