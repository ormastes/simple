pub struct BootstrapAdhocConfig:
    action: text
    compiler: text
    lane: text
    positive_fixture: text
    negative_fixture: text
    negative_expect: text
    output_root: text
    backend: text
    jobs: text
    changed_paths: [text]
    valid: bool
    error: text

fn bootstrap_adhoc_config_default() -> BootstrapAdhocConfig:
    BootstrapAdhocConfig(
        action: "help",
        compiler: "",
        lane: "auto",
        positive_fixture: "",
        negative_fixture: "",
        negative_expect: "",
        output_root: "build/bootstrap-adhoc-local",
        backend: "llvm",
        jobs: "2",
        changed_paths: [],
        valid: true,
        error: ""
    )

fn bootstrap_adhoc_value(args: [text], index: i64, flag: text) -> text:
    if index + 1 >= args.len():
        ""
    else:
        args[index + 1]

fn bootstrap_adhoc_jobs_valid(jobs: text) -> bool:
    jobs == "1" or jobs == "2" or jobs == "4" or jobs == "8" or
        jobs == "16" or jobs == "32" or jobs == "64"

pub fn bootstrap_adhoc_parse_args(args: [text]) -> BootstrapAdhocConfig:
    var config = bootstrap_adhoc_config_default()
    if args.len() == 0:
        return config
    config.action = args[0]
    var i = 1
    while i < args.len() and config.valid:
        val arg = args[i]
        if arg == "--compiler":
            config.compiler = bootstrap_adhoc_value(args, i, arg)
            i = i + 1
        elif arg == "--lane":
            config.lane = bootstrap_adhoc_value(args, i, arg)
            i = i + 1
        elif arg == "--positive":
            config.positive_fixture = bootstrap_adhoc_value(args, i, arg)
            i = i + 1
        elif arg == "--negative":
            config.negative_fixture = bootstrap_adhoc_value(args, i, arg)
            i = i + 1
        elif arg == "--negative-expect":
            config.negative_expect = bootstrap_adhoc_value(args, i, arg)
            i = i + 1
        elif arg == "--output":
            config.output_root = bootstrap_adhoc_value(args, i, arg)
            i = i + 1
        elif arg == "--backend":
            config.backend = bootstrap_adhoc_value(args, i, arg)
            i = i + 1
        elif arg == "--jobs":
            config.jobs = bootstrap_adhoc_value(args, i, arg)
            i = i + 1
        elif arg == "--changed":
            val changed = bootstrap_adhoc_value(args, i, arg)
            if changed != "":
                config.changed_paths.push(changed)
            i = i + 1
        elif arg == "--help" or arg == "-h":
            config.action = "help"
        else:
            config.valid = false
            config.error = "unknown argument: {arg}"
        i = i + 1

    if config.valid and config.action != "help" and config.action != "selftest" and
       config.action != "plan" and config.action != "check":
        config.valid = false
        config.error = "unknown action: {config.action}"
    if config.valid and config.backend != "llvm" and config.backend != "cranelift":
        config.valid = false
        config.error = "backend must be llvm or cranelift"
    if config.valid and not bootstrap_adhoc_jobs_valid(config.jobs):
        config.valid = false
        config.error = "jobs must be one of 1,2,4,8,16,32,64"
    config
