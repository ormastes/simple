# Minimal enterprise subscriptions entry — one codebase for host OS and
# SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_subscription.subscription.{sub_setup, sub_status, sub_invoiced_total}

fn main():
    val store = store_open_file("build/test-artifacts/probe_subscription.splstore")
    val ok = sub_setup(store)
    print("enterprise subscription probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " status=[" + sub_status(store, "t1", "none") + "] invoiced=" + sub_invoiced_total(store, "t1", "none").to_text())
    store_close(store)
