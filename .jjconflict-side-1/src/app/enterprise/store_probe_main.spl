# Minimal enterprise entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open, store_close, store_verify}
fn main():
    val store = store_open(":memory:")
    print("enterprise store open=" + store.open_ok.to_text() + " verify=[" + store_verify(store) + "]")
    store_close(store)
