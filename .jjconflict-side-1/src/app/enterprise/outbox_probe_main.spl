# Minimal enterprise outbox entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_outbox.outbox_worker.{outbox_worker_setup, outbox_worker_pending}

fn main():
    val store = store_open_file("build/test-artifacts/probe_outbox.splstore")
    val ok = outbox_worker_setup(store)
    val pending = outbox_worker_pending(store, "t1")
    print("enterprise outbox probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " pending=" + pending.len().to_text())
    store_close(store)
