# Minimal enterprise storefront entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_storefront.storefront.{sf_setup, sf_cart_total, sf_order_id_of, receipt_of}

fn main():
    val store = store_open_file("build/test-artifacts/probe_storefront.splstore")
    val ok = sf_setup(store)
    val total = sf_cart_total(store, "t1", "cart-1")
    val oid = sf_order_id_of(store, "t1", "cart-1")
    print("enterprise storefront probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " cart_total=" + total.to_text() + " order=[" + oid + "] receipt=" + receipt_of(store, "t1", "order-cart-1").to_text())
    store_close(store)
