# Minimal enterprise tax entry — one codebase for host OS and SimpleOS (AC-17).
use std.nogc_sync_mut.enterprise_store.store.{store_open_file, store_close}
use std.nogc_sync_mut.enterprise_tax.tax.{tax_setup, tax_round_half_up, tax_effective_rate_bp}

fn main():
    val store = store_open_file("build/test-artifacts/probe_tax.splstore")
    val ok = tax_setup(store)
    # 1000 cents at 875 bp = 87.5 -> round-half-up -> 88 (the boundary case).
    val tax = tax_round_half_up(1000, 875)
    val bp = tax_effective_rate_bp(store, "t1", "US-CA", "standard")
    print("enterprise tax probe open=" + store.open_ok.to_text() + " setup=" + ok.to_text() + " boundary_tax=" + tax.to_text() + " no_rate_bp=" + bp.to_text())
    store_close(store)
