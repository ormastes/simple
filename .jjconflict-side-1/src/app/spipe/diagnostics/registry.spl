# SPipe diagnostics registry loader (S1-D owns this file).
#
# `registry.sdn` (same directory) is the single code->meaning source of
# truth for the SPK diagnostic namespace, per
# doc/03_plan/infra/spipe/spipe_knowledge_compiler_refined_plan.md §2.1/§6.5.
# This module loads it, and enforces the invariants the plan requires:
#   - no duplicate codes
#   - every code falls in a legal range: either a reserved legacy code, or a
#     free new-code range (SPK110-129 link, SPK510-529 balance,
#     SPK530-549 admission)
#   - a caller-supplied "used codes" set must all be registered (S1-A/S1-C
#     export their own code tables and merge them here; S1-D has none of
#     those packages yet, so `check_used_codes` currently only verifies
#     S1-D's own admission codes -- see admission/verdict.spl).

use std.common.sdn.parser.{parse}
use std.common.sdn.value.{SdnValue}
use std.string_core.{char_code}
use std.io_runtime.{file_read, file_exists}

pub struct DiagnosticRow:
    code: text
    severity: text
    message_key: text
    component: text
    owner: text
    reserved: bool

fn _sdn_str(dict: Dict<text, SdnValue>, key: text) -> text:
    if dict.contains(key):
        match dict[key]:
            case String(s):
                return s
            case _:
                return ""
    ""

fn _sdn_bool(dict: Dict<text, SdnValue>, key: text) -> bool:
    if dict.contains(key):
        match dict[key]:
            case Bool(b):
                return b
            case _:
                return false
    false

fn _row_from_dict(d: Dict<text, SdnValue>) -> DiagnosticRow:
    DiagnosticRow(
        code: _sdn_str(d, "code"),
        severity: _sdn_str(d, "severity"),
        message_key: _sdn_str(d, "message_key"),
        component: _sdn_str(d, "component"),
        owner: _sdn_str(d, "owner"),
        reserved: _sdn_bool(d, "reserved"),
    )

# Parse already-read SDN source text into diagnostic rows. Pure -- no
# filesystem access, so it is directly testable against fixture strings.
pub fn parse_registry_source(source: text) -> Result<[DiagnosticRow], text>:
    match parse(source):
        case Ok(root):
            match root:
                case Dict(top):
                    if not top.contains("diagnostics"):
                        return Err("registry.sdn missing top-level 'diagnostics' key")
                    match top["diagnostics"]:
                        case Array(items):
                            var rows = []
                            for item in items:
                                match item:
                                    case Dict(d):
                                        rows.push(_row_from_dict(d))
                                    case _:
                                        return Err("diagnostics entry is not a dict")
                            return Ok(rows)
                        case _:
                            return Err("'diagnostics' is not an array")
                case _:
                    return Err("registry.sdn root is not a dict")
        case Err(msg):
            return Err("parse error: " + msg)

pub fn load_registry(path: text) -> Result<[DiagnosticRow], text>:
    if not file_exists(path):
        return Err("registry file not found: " + path)
    val source = file_read(path)
    parse_registry_source(source)

# --- Invariants ------------------------------------------------------------

# Numeric part of an "SPK123" style code, or -1 if malformed.
pub fn code_number(code: text) -> i64:
    if not code.starts_with("SPK"):
        return -1
    val digits = code[3:code.len()]
    if digits.len() == 0:
        return -1
    var n = 0
    val zero = char_code("0")
    val nine = char_code("9")
    for i in 0..digits.len():
        val cc = char_code(digits[i])
        if cc < zero or cc > nine:
            return -1
        n = n * 10 + (cc - zero)
    n

# Free ranges reserved for NEW (non-legacy) codes, per plan §2.1.
pub fn in_free_new_range(n: i64) -> bool:
    (n >= 110 and n <= 129) or (n >= 510 and n <= 529) or (n >= 530 and n <= 549)

# Duplicate codes across the registry -- fails closed (returns the offending
# codes) rather than silently keeping the last one.
pub fn find_duplicate_codes(rows: [DiagnosticRow]) -> [text]:
    var seen: Dict<text, bool> = {}
    var dups: Dict<text, bool> = {}
    var out = []
    for row in rows:
        if seen.contains(row.code):
            if not dups.contains(row.code):
                dups[row.code] = true
                out.push(row.code)
        else:
            seen[row.code] = true
    out

# A row is well-placed if it is an explicitly reserved legacy row (any
# numeric code, `owner: legacy_js`), or a non-reserved row whose numeric code
# falls in one of the free new-code ranges.
pub fn find_out_of_range_codes(rows: [DiagnosticRow]) -> [text]:
    var out = []
    for row in rows:
        val n = code_number(row.code)
        if n < 0:
            out.push(row.code)
        elif row.reserved:
            pass
        elif not in_free_new_range(n):
            out.push(row.code)
    out

# Every code in `used` must appear, registered, in `rows`.
pub fn find_unregistered_used_codes(rows: [DiagnosticRow], used: [text]) -> [text]:
    var known: Dict<text, bool> = {}
    for row in rows:
        known[row.code] = true
    var out = []
    for code in used:
        if not known.contains(code):
            out.push(code)
    out

# Full registry validation in one call: empty result = registry is clean.
pub fn validate_registry(rows: [DiagnosticRow]) -> [text]:
    var problems = []
    for code in find_duplicate_codes(rows):
        problems.push("duplicate code: " + code)
    for code in find_out_of_range_codes(rows):
        problems.push("code outside free ranges and not reserved: " + code)
    problems
