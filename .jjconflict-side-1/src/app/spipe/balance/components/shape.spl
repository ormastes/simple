# Shape component (research §13.2, "Shape — 15%", renormalized to 21).
#
# Penalizes excessive depth, direct document count, child-directory fanout,
# and repeated one-doc sibling directories, per the defaults table in §13.2
# (target/warning/strong-candidate bands, config'd in `config.spl`). Each of
# the 4 metrics owns an equal quarter (250 per-mille) of the component's raw
# score: 0 penalty inside its target band, 100 in the warning band, 250 past
# it (strong candidate for restructuring). raw = 1000 - sum(penalties).

use app.spipe.balance.score_types.{ScopeInput, BalanceComponent}
use app.spipe.balance.config.{BalanceConfig, ShapeMetricThreshold, default_config}

fn shape_name() -> text:
    "shape"

fn shape_metric_penalty(value: Int, threshold: ShapeMetricThreshold) -> Int:
    if value <= threshold.target_max: return 0
    if value <= threshold.warn_max: return 100
    250

fn shape_raw_with_config(input: ScopeInput, cfg: BalanceConfig) -> Int:
    val depth_penalty = shape_metric_penalty(input.depth, cfg.shape_depth)
    val docs_penalty = shape_metric_penalty(input.direct_docs, cfg.shape_direct_docs)
    val dirs_penalty = shape_metric_penalty(input.child_dirs, cfg.shape_child_dirs)
    val tiny_penalty = shape_metric_penalty(input.tiny_sibling_dirs, cfg.shape_tiny_sibling_dirs)
    val total_penalty = depth_penalty + docs_penalty + dirs_penalty + tiny_penalty
    val raw = 1000 - total_penalty
    if raw < 0: return 0
    raw

fn shape_raw(input: ScopeInput) -> Int:
    shape_raw_with_config(input, default_config())

impl BalanceComponent for shape:
    fn name() -> text: shape_name()
    fn raw(input: ScopeInput) -> Int: shape_raw(input)

export shape_name, shape_metric_penalty, shape_raw_with_config, shape_raw, shape_as_BalanceComponent
