"""CLI composition for `caret messaging`; heavy runtime carriers stay compiled."""

use app.llm_caret.messaging.database_execution.{default_database_execution_plan,
    default_messaging_mcp_execution_plan,
    default_messaging_hook_execution_plan,
    default_messaging_bridge_execution_plan,
    default_messaging_server_execution_plan,
    database_artifact_build_command, database_artifact_run_command,
    DatabaseExecutionPlan}
use app.llm_caret.messaging.config.{decode_messaging_config}
use app.io.mod.{env_get, process_run, file_modified_time}
use app.io.process_ops.{process_run_inherit}
use std.io_runtime.{mkdir_p, file_exists, file_read, file_write, file_delete, env_get_opt}
use app.llm_caret.messaging.adapter.plugin.installer.{PluginPlan, PluginFileOperation, plugin_content_hash, execute_plugin_plan}
use app.llm_caret.messaging.adapter.plugin.selection.{MessagingAgentSelection,
    parse_messaging_agent_selection, agent_activation_sdn}

fn messaging_help() -> text:
    "Usage:\n" +
    "  caret messaging status\n" +
    "  caret messaging mcp --probe\n" +
    "  caret messaging bridge --probe\n" +
    "  caret messaging database --probe [--db=PATH] [--smf]\n" +
    "  caret messaging config check [--config=PATH]\n" +
    "  caret messaging hook <claude|codex|gemini> <event>\n" +
    "  caret messaging serve [--port=N] [--db=PATH]\n" +
    "  caret messaging plugin install [--apply] [--target=PATH]\n" +
    "  caret messaging plugin activate [--apply] [--target=PATH]\n" +
    "  caret messaging plugin deactivate [--apply] [--target=PATH]\n" +
    "  caret messaging plugin check [--target=PATH]\n" +
    "  caret messaging plugin uninstall [--apply] [--target=PATH]\n"

fn messaging_artifact_fresh(plan: DatabaseExecutionPlan, dependencies: [text]) -> bool:
    if not file_exists(plan.artifact_path): return false
    val simple_binary = env_get_opt("SIMPLE_BINARY") ?? "bin/simple"
    val provenance_path = plan.artifact_path + ".provenance.sdn"
    if not file_exists(provenance_path): return false
    if file_read(provenance_path) != messaging_artifact_provenance(plan, dependencies, simple_binary):
        return false
    val artifact_time = file_modified_time(plan.artifact_path)
    if artifact_time < file_modified_time(plan.source_path): return false
    for dependency in dependencies:
        if not file_exists(dependency): return false
        if artifact_time < file_modified_time(dependency): return false
    true

fn messaging_artifact_provenance(plan: DatabaseExecutionPlan,
        dependencies: [text], simple_binary: text) -> text:
    if not file_exists(plan.source_path) or not file_exists(simple_binary): return ""
    var records = ["schema=simple.llm-caret-messaging.artifact-provenance/v1",
        "artifact=" + plan.artifact_path,
        "source=" + plan.source_path + "\u001f" + plugin_content_hash(file_read(plan.source_path)),
        "compiler=" + simple_binary + "\u001f" + file_modified_time(simple_binary).to_text()]
    for dependency in dependencies:
        if not file_exists(dependency): return ""
        records.push("dependency=" + dependency + "\u001f" + plugin_content_hash(file_read(dependency)))
    records.join("\n") + "\n"

fn messaging_record_artifact_provenance(plan: DatabaseExecutionPlan,
        dependencies: [text], simple_binary: text) -> bool:
    val provenance = messaging_artifact_provenance(plan, dependencies, simple_binary)
    if provenance == "" or not file_exists(plan.artifact_path): return false
    file_write(plan.artifact_path + ".provenance.sdn", provenance)
    true

fn messaging_status() -> i64:
    val store_source = "src/app/llm_caret/messaging/adapter/store/pure_sql_store.spl"
    val db_ready = messaging_artifact_fresh(default_database_execution_plan(true), [store_source])
    val mcp_ready = messaging_artifact_fresh(default_messaging_mcp_execution_plan(true),
        [store_source, "src/app/llm_caret/messaging/mcp/protocol.spl"])
    val hook_ready = messaging_artifact_fresh(default_messaging_hook_execution_plan(true),
        [store_source, "src/app/llm_caret/messaging/adapter/agent/hook_command.spl",
            "src/app/llm_caret/messaging/adapter/agent/hook_response.spl",
            "src/app/llm_caret/messaging/application/context_builder.spl"])
    val bridge_ready = messaging_artifact_fresh(default_messaging_bridge_execution_plan(true),
        [store_source, "src/app/llm_caret/messaging/adapter/agent/hook_bridge.spl"])
    val server_ready = messaging_artifact_fresh(default_messaging_server_execution_plan(true),
        [store_source, "src/app/llm_caret/messaging/adapter/server/http_server.spl"])
    val ready = db_ready and mcp_ready and hook_ready and bridge_ready and server_ready
    print "llm-caret-messaging: " + (if ready: "ready" else: "not-ready")
    print "database: pure-simple PureDatabase"
    print "carrier: native-executable"
    print "database-ready: " + db_ready.to_text()
    print "mcp-ready: " + mcp_ready.to_text()
    print "hook-ready: " + hook_ready.to_text()
    print "bridge-ready: " + bridge_ready.to_text()
    print "server-ready: " + server_ready.to_text()
    print "mcp-tools: chat_join,chat_leave,chat_send,chat_read,chat_mark_read,chat_who,chat_open_private,chat_notify_all,chat_assign,chat_task_update,chat_publish_artifact,chat_get_context"
    if ready: 0 else: 1

fn messaging_probe(kind: text, args: [text]) -> i64:
    if args.len() < 3 or args[2] != "--probe":
        if kind == "mcp":
            return run_compiled_messaging_mcp()
        print "ERROR " + kind + " requires its compiled runtime artifact; use --probe for readiness"
        return 2
    var plan = default_database_execution_plan(true)
    var dependencies = ["src/app/llm_caret/messaging/adapter/store/pure_sql_store.spl"]
    if kind == "mcp":
        plan = default_messaging_mcp_execution_plan(true)
        dependencies.push("src/app/llm_caret/messaging/mcp/protocol.spl")
    elif kind == "bridge":
        plan = default_messaging_bridge_execution_plan(true)
        dependencies.push("src/app/llm_caret/messaging/adapter/agent/hook_bridge.spl")
    val ready = messaging_artifact_fresh(plan, dependencies)
    print "{\"name\":\"llm-caret-messaging-" + kind + "\",\"status\":\"" +
        (if ready: "ready" else: "not-ready") + "\",\"database\":\"PureDatabase\",\"carrier\":\"native-executable\",\"artifact\":\"" +
        plan.artifact_path + "\",\"artifact_ready\":" + ready.to_text() + "}"
    if ready: 0 else: 1

fn run_compiled_messaging_mcp() -> i64:
    val plan = default_messaging_mcp_execution_plan(true)
    val simple_binary = env_get_opt("SIMPLE_BINARY") ?? "bin/simple"
    val slash = plan.artifact_path.last_index_of("/")
    if slash > 0: mkdir_p(plan.artifact_path.substring(0, slash))
    val store_source = "src/app/llm_caret/messaging/adapter/store/pure_sql_store.spl"
    val protocol_source = "src/app/llm_caret/messaging/mcp/protocol.spl"
    val dependencies = [store_source, protocol_source]
    val stale = not messaging_artifact_fresh(plan, dependencies)
    if stale:
        val build = database_artifact_build_command(plan, simple_binary)
        val build_result = process_run(build.command, build.args)
        if build_result.2 != 0:
            print "ERROR compiled messaging MCP build failed: " + build_result.1
            return 1
        if not messaging_record_artifact_provenance(plan, dependencies, simple_binary):
            print "ERROR compiled messaging MCP provenance write failed"
            return 1
    # Inherited stdio is required by MCP framing. Environment-based authority
    # and database configuration are inherited without being copied to argv.
    process_run_inherit(plan.artifact_path, [])

fn messaging_database_carrier(args: [text]) -> i64:
    if not args.contains("--probe"):
        print "ERROR database carrier currently supports --probe"
        return 2
    val prefer_native = not args.contains("--smf")
    val plan = default_database_execution_plan(prefer_native)
    val simple_binary = env_get_opt("SIMPLE_BINARY") ?? "bin/simple"
    val slash = plan.artifact_path.last_index_of("/")
    if slash > 0: mkdir_p(plan.artifact_path.substring(0, slash))
    val store_source = "src/app/llm_caret/messaging/adapter/store/pure_sql_store.spl"
    val dependencies = [store_source]
    val stale = not messaging_artifact_fresh(plan, dependencies)
    if stale:
        val build = database_artifact_build_command(plan, simple_binary)
        val build_result = process_run(build.command, build.args)
        if build_result.2 != 0:
            print "ERROR compiled database carrier build failed: " + build_result.1
            return 1
        if not messaging_record_artifact_provenance(plan, dependencies, simple_binary):
            print "ERROR compiled database carrier provenance write failed"
            return 1
    val database = messaging_option(args, "--db=", ".simple/state/llm-caret-messaging.db")
    val database_slash = database.last_index_of("/")
    if database_slash > 0: mkdir_p(database.substring(0, database_slash))
    val run = database_artifact_run_command(plan, simple_binary,
        ["--operation", "probe", "--db", database])
    val result = process_run(run.command, run.args)
    if result.0 != "": print result.0.trim()
    if result.2 != 0:
        if result.1 != "": print "ERROR " + result.1.trim()
        return result.2
    0

fn messaging_plugin_relatives() -> [text]:
    [".codex-plugin/plugin.json", ".claude-plugin/plugin.json", ".mcp.json",
        "gemini-extension.json", "integration.sdn", "README.md",
        "config/defaults.sdn", "config/schema.sdn", "mcp/manifest.sdn",
        "migrations/001_initial.sdn", "hooks/hooks.json",
        "skills/llm-caret-messaging/SKILL.md",
        "hooks/claude/hooks.json", "hooks/codex/hooks.json",
        "hooks/gemini/settings.fragment.json",
        ".gemini/commands/llm-caret-messaging.toml",
        "gemini/gemini-extension.json", "gemini/hooks/hooks.json",
        "gemini/commands/llm-caret-messaging.toml", "gemini/GEMINI.md",
        "gemini/skills/llm-caret-messaging/SKILL.md"]

fn messaging_plugin_target(args: [text]) -> text:
    messaging_option(args, "--target=", ".simple/integrations/llm-caret-messaging")

fn messaging_plugin_safe_target(target: text) -> bool:
    target != "" and target != "/" and target != "." and
        target.contains("llm-caret-messaging") and not target.starts_with("../")

fn messaging_plugin_agents(args: [text]) -> MessagingAgentSelection:
    var raw = messaging_option(args, "--agents=", "")
    var i = 0
    while i < args.len():
        if args[i] == "--agents" and i + 1 < args.len():
            raw = args[i + 1]
        i = i + 1
    if raw == "":
        raw = "claude,codex,gemini"
    parse_messaging_agent_selection(raw)

fn messaging_plugin_parent(path: text):
    val slash = path.last_index_of("/")
    if slash > 0: mkdir_p(path.substring(0, slash))

fn messaging_plugin_install(args: [text], apply: bool) -> i64:
    val source_root = "plugins/llm_caret_messaging"
    val target = messaging_plugin_target(args)
    if not messaging_plugin_safe_target(target):
        print "ERROR unsafe plugin target: " + target
        return 2
    val agent_selection = messaging_plugin_agents(args)
    if not agent_selection.valid:
        print "ERROR " + agent_selection.error
        return 2
    var operations: [PluginFileOperation] = []
    var records: [text] = []
    for relative in messaging_plugin_relatives():
        val source = source_root + "/" + relative
        if not file_exists(source):
            print "ERROR plugin source missing: " + source
            return 1
        val path = target + "/" + relative
        val current = if file_exists(path): file_read(path) else: ""
        val before_hash = plugin_content_hash(current)
        val content = file_read(source)
        val after_hash = plugin_content_hash(content)
        val backup = if current == "": "" else: path + ".llm-caret-backup-" + before_hash.substring(7, 19)
        operations.push(PluginFileOperation(action: if current == content: "unchanged" else: "write",
            path: path, backup_path: backup, expected_hash: before_hash, content: content,
            reason: "managed_llm_caret_messaging_bundle"))
        records.push(relative + "\u001f" + before_hash + "\u001f" + after_hash + "\u001f" + backup)
    val activation_relative = "config/selected-agents.sdn"
    val activation_path = target + "/" + activation_relative
    val activation_content = agent_activation_sdn(agent_selection)
    val activation_current = if file_exists(activation_path): file_read(activation_path) else: ""
    val activation_before = plugin_content_hash(activation_current)
    val activation_after = plugin_content_hash(activation_content)
    var activation_backup = ""
    if activation_current != "":
        activation_backup = activation_path + ".llm-caret-backup-" + activation_before.substring(7, 19)
    var activation_action = "write"
    if activation_current == activation_content:
        activation_action = "unchanged"
    operations.push(PluginFileOperation(action: activation_action,
        path: activation_path, backup_path: activation_backup,
        expected_hash: activation_before, content: activation_content,
        reason: "validated_agent_activation"))
    records.push(activation_relative + "\u001f" + activation_before + "\u001f" +
        activation_after + "\u001f" + activation_backup)
    val ownership_path = target + "/.ownership.sdn"
    val ownership = "schema=simple.llm-caret-plugin-ownership/v1\n" + records.join("\n") + "\n"
    val prior_ownership = if file_exists(ownership_path): file_read(ownership_path) else: ""
    operations.push(PluginFileOperation(action: if prior_ownership == ownership: "unchanged" else: "write",
        path: ownership_path, backup_path: if prior_ownership == "": "" else: ownership_path + ".backup",
        expected_hash: plugin_content_hash(prior_ownership), content: ownership, reason: "ownership_record"))
    if not apply:
        print "plugin-plan: install"
        print "target: " + target
        print "operations: " + operations.len().to_text()
        return 0
    for operation in operations: messaging_plugin_parent(operation.path)
    val result = execute_plugin_plan(PluginPlan(status: "ready", reason: "validated_bundle_install",
        operations: operations, records: [], checks: []))
    print "{\"status\":\"" + result.status + "\",\"applied\":" + result.applied.to_text() +
        ",\"error\":\"" + result.error + "\"}"
    if result.status == "applied": 0 else: 1

fn messaging_plugin_check(args: [text]) -> i64:
    val target = messaging_plugin_target(args)
    val ownership_path = target + "/.ownership.sdn"
    if not file_exists(ownership_path):
        print "ERROR plugin ownership record missing: " + ownership_path
        return 1
    var passed = 0
    var changed = 0
    val agent_selection = messaging_plugin_agents(args)
    if not agent_selection.valid:
        print "ERROR " + agent_selection.error
        return 2
    for line in file_read(ownership_path).split("\n"):
        val fields = line.split("\u001f")
        if fields.len() == 4:
            val path = target + "/" + fields[0]
            if file_exists(path) and plugin_content_hash(file_read(path)) == fields[2]: passed = passed + 1
            else: changed = changed + 1
    val config_path = target + "/config/defaults.sdn"
    if not file_exists(config_path) or not decode_messaging_config(file_read(config_path)).valid():
        changed = changed + 1
    val activation_path = target + "/config/selected-agents.sdn"
    if not file_exists(activation_path):
        changed = changed + 1
    else:
        val activation = file_read(activation_path)
        for agent in agent_selection.agents:
            if not activation.contains(agent):
                changed = changed + 1
    # Hash-valid configuration is not a healthy integration when the workers
    # that own MCP and hook/bridge database access cannot start. Keep this
    # check non-building and deterministic; startup owns freshness builds.
    val store_source = "src/app/llm_caret/messaging/adapter/store/pure_sql_store.spl"
    val mcp_plan = default_messaging_mcp_execution_plan(true)
    val hook_plan = default_messaging_hook_execution_plan(true)
    val bridge_plan = default_messaging_bridge_execution_plan(true)
    val mcp_ready = messaging_artifact_fresh(mcp_plan,
        [store_source, "src/app/llm_caret/messaging/mcp/protocol.spl"])
    val hook_ready = messaging_artifact_fresh(hook_plan,
        [store_source, "src/app/llm_caret/messaging/adapter/agent/hook_command.spl",
            "src/app/llm_caret/messaging/adapter/agent/hook_response.spl",
            "src/app/llm_caret/messaging/application/context_builder.spl"])
    val bridge_ready = messaging_artifact_fresh(bridge_plan,
        [store_source, "src/app/llm_caret/messaging/adapter/agent/hook_bridge.spl"])
    if not mcp_ready: changed = changed + 1
    if not hook_ready: changed = changed + 1
    if not bridge_ready: changed = changed + 1
    print "{\"status\":\"" + (if changed == 0: "passed" else: "changed") +
        "\",\"passed\":" + passed.to_text() + ",\"changed\":" + changed.to_text() +
        ",\"mcp_ready\":" + mcp_ready.to_text() +
        ",\"hook_ready\":" + hook_ready.to_text() +
        ",\"bridge_ready\":" + bridge_ready.to_text() + "}"
    if changed == 0: 0 else: 1

fn messaging_plugin_uninstall(args: [text], apply: bool) -> i64:
    val target = messaging_plugin_target(args)
    if not messaging_plugin_safe_target(target):
        print "ERROR unsafe plugin target: " + target
        return 2
    val ownership_path = target + "/.ownership.sdn"
    if not file_exists(ownership_path):
        print "ERROR plugin ownership record missing: " + ownership_path
        return 1
    val native_activation_path = target + "/config/native-activation.sdn"
    if file_exists(native_activation_path):
        print "ERROR deactivate native agent registrations before uninstall: " + native_activation_path
        return 2
    var operations: [PluginFileOperation] = []
    var preserved = 0
    for line in file_read(ownership_path).split("\n"):
        val fields = line.split("\u001f")
        if fields.len() == 4:
            val path = target + "/" + fields[0]
            val current = if file_exists(path): file_read(path) else: ""
            if plugin_content_hash(current) != fields[2]:
                preserved = preserved + 1
            elif fields[1] == plugin_content_hash(""):
                operations.push(PluginFileOperation(action: "delete", path: path, backup_path: "",
                    expected_hash: fields[2], content: "", reason: "plugin_created_file"))
            elif fields[3] != "" and file_exists(fields[3]):
                operations.push(PluginFileOperation(action: "restore_backup", path: path,
                    backup_path: fields[3], expected_hash: fields[2], content: "",
                    reason: "restore_exact_preinstall_content"))
            else:
                preserved = preserved + 1
    if not apply:
        print "plugin-plan: uninstall"
        print "operations: " + operations.len().to_text()
        print "preserved: " + preserved.to_text()
        return 0
    val result = execute_plugin_plan(PluginPlan(status: "ready", reason: "guarded_uninstall",
        operations: operations, records: [], checks: []))
    if result.status == "applied" and preserved == 0: file_delete(ownership_path)
    print "{\"status\":\"" + result.status + "\",\"applied\":" + result.applied.to_text() +
        ",\"preserved\":" + preserved.to_text() + ",\"error\":\"" + result.error + "\"}"
    if result.status == "applied": 0 else: 1

fn messaging_plugin_activate(args: [text], apply: bool) -> i64:
    val target = messaging_plugin_target(args)
    if not messaging_plugin_safe_target(target):
        print "ERROR unsafe plugin target: " + target
        return 2
    if not file_exists(target + "/.ownership.sdn"):
        print "ERROR plugin must be installed before activation: " + target
        return 2
    val activation_record = target + "/config/native-activation.sdn"
    val commands = [
        "claude plugin marketplace add . --scope project",
        "claude plugin install llm-caret-messaging@simple-plugins --scope project",
        "codex mcp add --env LLM_CARET_MESSAGING_DB=.simple/state/llm-caret-messaging.db --env LLM_CARET_MESSAGING_IDENTITY=local-agent --env LLM_CARET_MESSAGING_WORKSPACE=default --env LLM_CARET_MESSAGING_SCOPES=room:read,room:write,profile:read,dm:write,agent:control llm-caret-messaging -- caret messaging mcp",
        "gemini extensions link " + target + "/gemini --consent"
    ]
    if not apply:
        print "plugin-plan: activate"
        for command in commands: print command
        return 0
    val claude_marketplace = process_run("claude",
        ["plugin", "marketplace", "add", ".", "--scope", "project"])
    if claude_marketplace.2 != 0:
        print "ERROR Claude marketplace activation failed: " + claude_marketplace.1
        return 1
    val claude_plugin = process_run("claude",
        ["plugin", "install", "llm-caret-messaging@simple-plugins", "--scope", "project"])
    if claude_plugin.2 != 0:
        print "ERROR Claude plugin activation failed: " + claude_plugin.1
        return 1
    val codex_mcp = process_run("codex", ["mcp", "add",
        "--env", "LLM_CARET_MESSAGING_DB=.simple/state/llm-caret-messaging.db",
        "--env", "LLM_CARET_MESSAGING_IDENTITY=local-agent",
        "--env", "LLM_CARET_MESSAGING_WORKSPACE=default",
        "--env", "LLM_CARET_MESSAGING_SCOPES=room:read,room:write,profile:read,dm:write,agent:control",
        "llm-caret-messaging", "--", "caret", "messaging", "mcp"])
    if codex_mcp.2 != 0:
        print "ERROR Codex MCP activation failed: " + codex_mcp.1
        return 1
    val gemini_extension = process_run("gemini",
        ["extensions", "link", target + "/gemini", "--consent"])
    if gemini_extension.2 != 0:
        print "ERROR Gemini extension activation failed: " + gemini_extension.1
        return 1
    file_write(activation_record,
        "activation:\n  schema: simple.llm-caret-messaging.native-activation/v1\n" +
        "  claude: true\n  codex: true\n  gemini: true\n")
    print "{\"status\":\"activated\",\"claude\":true,\"codex\":true,\"gemini\":true}"
    0

fn messaging_plugin_deactivate(args: [text], apply: bool) -> i64:
    val target = messaging_plugin_target(args)
    if not messaging_plugin_safe_target(target):
        print "ERROR unsafe plugin target: " + target
        return 2
    val activation_record = target + "/config/native-activation.sdn"
    if not file_exists(activation_record):
        print "ERROR native activation ownership record missing: " + activation_record
        return 2
    val commands = [
        "claude plugin uninstall llm-caret-messaging@simple-plugins --scope project",
        "codex mcp remove llm-caret-messaging",
        "gemini extensions uninstall llm-caret-messaging"
    ]
    if not apply:
        print "plugin-plan: deactivate"
        for command in commands: print command
        return 0
    val claude_plugin = process_run("claude", ["plugin", "uninstall",
        "llm-caret-messaging@simple-plugins", "--scope", "project"])
    if claude_plugin.2 != 0:
        print "ERROR Claude plugin deactivation failed: " + claude_plugin.1
        return 1
    val codex_mcp = process_run("codex", ["mcp", "remove", "llm-caret-messaging"])
    if codex_mcp.2 != 0:
        print "ERROR Codex MCP deactivation failed: " + codex_mcp.1
        return 1
    val gemini_extension = process_run("gemini", ["extensions", "uninstall",
        "llm-caret-messaging"])
    if gemini_extension.2 != 0:
        print "ERROR Gemini extension deactivation failed: " + gemini_extension.1
        return 1
    file_delete(activation_record)
    print "{\"status\":\"deactivated\",\"claude\":true,\"codex\":true,\"gemini\":true}"
    0

fn messaging_plugin(args: [text]) -> i64:
    if args.len() < 3:
        print "ERROR plugin action required: install, check, or uninstall"
        return 2
    val action = args[2]
    val apply = args.contains("--apply")
    if action == "activate": return messaging_plugin_activate(args, apply)
    if action == "deactivate": return messaging_plugin_deactivate(args, apply)
    if action != "install" and action != "check" and action != "uninstall":
        print "ERROR unknown plugin action: " + action
        return 2
    if action == "install": return messaging_plugin_install(args, apply)
    if action == "check": return messaging_plugin_check(args)
    messaging_plugin_uninstall(args, apply)

fn messaging_option(args: [text], prefix: text, fallback: text) -> text:
    for arg in args:
        if arg.starts_with(prefix): return arg.substring(prefix.len())
    fallback

fn messaging_config(args: [text]) -> i64:
    if args.len() < 3 or args[2] != "check":
        print "ERROR config action required: check"
        return 2
    val path = messaging_option(args, "--config=", "plugins/llm_caret_messaging/config/defaults.sdn")
    if not file_exists(path):
        print "ERROR messaging config not found: " + path
        return 1
    val config = decode_messaging_config(file_read(path))
    if not config.valid():
        for issue in config.issues: print "ERROR " + issue
        return 1
    print "{\"status\":\"passed\",\"agents\":" + config.agents.len().to_text() +
        ",\"rooms\":" + config.rooms.len().to_text() + ",\"transports\":" +
        config.transports.len().to_text() + "}"
    0

fn messaging_serve(args: [text]) -> i64:
    val plan = default_messaging_server_execution_plan(true)
    val simple_binary = env_get_opt("SIMPLE_BINARY") ?? "bin/simple"
    val slash = plan.artifact_path.last_index_of("/")
    if slash > 0: mkdir_p(plan.artifact_path.substring(0, slash))
    val store_source = "src/app/llm_caret/messaging/adapter/store/pure_sql_store.spl"
    val server_source = "src/app/llm_caret/messaging/adapter/server/http_server.spl"
    val dependencies = [store_source, server_source]
    val stale = not messaging_artifact_fresh(plan, dependencies)
    if stale:
        val build = database_artifact_build_command(plan, simple_binary)
        val build_result = process_run(build.command, build.args)
        if build_result.2 != 0:
            print "ERROR compiled messaging server build failed: " + build_result.1
            return 1
        if not messaging_record_artifact_provenance(plan, dependencies, simple_binary):
            print "ERROR compiled messaging server provenance write failed"
            return 1
    var worker_args: [text] = []
    for arg in args.slice(2, args.len()): worker_args.push(arg)
    process_run_inherit(plan.artifact_path, worker_args)

fn messaging_hook(args: [text]) -> i64:
    if args.len() < 4:
        print "ERROR hook requires provider and event"
        return 2
    val provider = args[2]
    val event_name = args[3]
    if provider != "claude" and provider != "codex" and provider != "gemini":
        print "ERROR unsupported hook provider: " + provider
        return 2
    val plan = default_messaging_hook_execution_plan(true)
    val simple_binary = env_get_opt("SIMPLE_BINARY") ?? "bin/simple"
    val slash = plan.artifact_path.last_index_of("/")
    if slash > 0: mkdir_p(plan.artifact_path.substring(0, slash))
    val store_source = "src/app/llm_caret/messaging/adapter/store/pure_sql_store.spl"
    val command_source = "src/app/llm_caret/messaging/adapter/agent/hook_command.spl"
    val response_source = "src/app/llm_caret/messaging/adapter/agent/hook_response.spl"
    val context_source = "src/app/llm_caret/messaging/application/context_builder.spl"
    val dependencies = [store_source, command_source, response_source, context_source]
    val stale = not messaging_artifact_fresh(plan, dependencies)
    if stale:
        val build = database_artifact_build_command(plan, simple_binary)
        val build_result = process_run(build.command, build.args)
        if build_result.2 != 0:
            print "ERROR compiled messaging hook build failed: " + build_result.1
            return 1
        if not messaging_record_artifact_provenance(plan, dependencies, simple_binary):
            print "ERROR compiled messaging hook provenance write failed"
            return 1
    process_run_inherit(plan.artifact_path, ["--provider", provider, "--event", event_name])

fn messaging_bridge(args: [text]) -> i64:
    if args.len() >= 3 and args[2] == "--probe": return messaging_probe("bridge", args)
    val plan = default_messaging_bridge_execution_plan(true)
    val simple_binary = env_get_opt("SIMPLE_BINARY") ?? "bin/simple"
    val slash = plan.artifact_path.last_index_of("/")
    if slash > 0: mkdir_p(plan.artifact_path.substring(0, slash))
    val store_source = "src/app/llm_caret/messaging/adapter/store/pure_sql_store.spl"
    val bridge_source = "src/app/llm_caret/messaging/adapter/agent/hook_bridge.spl"
    val dependencies = [store_source, bridge_source]
    val stale = not messaging_artifact_fresh(plan, dependencies)
    if stale:
        val build = database_artifact_build_command(plan, simple_binary)
        val build_result = process_run(build.command, build.args)
        if build_result.2 != 0:
            print "ERROR compiled messaging bridge build failed: " + build_result.1
            return 1
        if not messaging_record_artifact_provenance(plan, dependencies, simple_binary):
            print "ERROR compiled messaging bridge provenance write failed"
            return 1
    val worker_args = if args.contains("--once"): ["--once"] else: []
    process_run_inherit(plan.artifact_path, worker_args)

fn run_messaging_cli(args: [text]) -> i64:
    if args.len() < 2 or args[1] == "help" or args[1] == "--help":
        print messaging_help()
        return 0
    val action = args[1]
    if action == "status": return messaging_status()
    if action == "mcp": return messaging_probe("mcp", args)
    if action == "bridge": return messaging_bridge(args)
    if action == "database": return messaging_database_carrier(args)
    if action == "config": return messaging_config(args)
    if action == "serve": return messaging_serve(args)
    if action == "hook": return messaging_hook(args)
    if action == "plugin": return messaging_plugin(args)
    print "ERROR unknown messaging action: " + action
    2

export run_messaging_cli, messaging_help
export messaging_artifact_fresh, messaging_artifact_provenance
