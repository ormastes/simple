"""Instance-scoped orchestration across Claude, Codex, and Gemini controls."""

use app.llm_caret.messaging.domain.model.{AgentBinding}
use app.llm_caret.messaging.adapter.agent.claude_hooks.{ClaudeHooksAdapter}
use app.llm_caret.messaging.adapter.agent.codex_app_server.{CodexAppServerAdapter}
use app.llm_caret.messaging.adapter.agent.gemini_hooks.{GeminiHooksAdapter}

struct AgentControlResult:
    ok: bool
    provider: text
    session_id: text
    evidence: text
    error: text

fn control_ok(provider: text, session_id: text, evidence: text) -> AgentControlResult:
    AgentControlResult(ok: true, provider: provider, session_id: session_id,
        evidence: evidence, error: "")

fn control_error(provider: text, session_id: text, error: text) -> AgentControlResult:
    AgentControlResult(ok: false, provider: provider, session_id: session_id,
        evidence: "", error: error)

class AgentControlService:
    claude: ClaudeHooksAdapter
    codex: CodexAppServerAdapter
    gemini: GeminiHooksAdapter

    static fn new(codex_app_server_available: bool) -> AgentControlService:
        AgentControlService(claude: ClaudeHooksAdapter.new(),
            codex: CodexAppServerAdapter.new(codex_app_server_available),
            gemini: GeminiHooksAdapter.new())

    me attach(provider: text, binding: AgentBinding) -> AgentControlResult:
        val session_id = match provider:
            "claude": self.claude.attach_session(binding)
            "codex": self.codex.attach_session(binding)
            "gemini": self.gemini.attach_session(binding)
            _: "error:unsupported_agent_provider"
        if session_id.starts_with("error:"): return control_error(provider, "", session_id)
        control_ok(provider, session_id, "session_attached")

    me resume(provider: text, session_id: text) -> AgentControlResult:
        val evidence = match provider:
            "claude": self.claude.registry.resume(session_id)
            "codex": self.codex.registry.resume(session_id)
            "gemini": self.gemini.registry.resume(session_id)
            _: "error:unsupported_agent_provider"
        self.result(provider, session_id, evidence)

    me inject_context(provider: text, session_id: text, manifest_id: text) -> AgentControlResult:
        val evidence = match provider:
            "claude": self.claude.registry.inject_context(session_id, manifest_id)
            "codex": self.codex.registry.inject_context(session_id, manifest_id)
            "gemini": self.gemini.registry.inject_context(session_id, manifest_id)
            _: "error:unsupported_agent_provider"
        self.result(provider, session_id, evidence)

    me submit(provider: text, session_id: text, task_id: text) -> AgentControlResult:
        val evidence = match provider:
            "claude": self.claude.registry.begin_task(session_id, task_id, "submit")
            "codex": self.codex.registry.begin_task(session_id, task_id, "turn/start")
            "gemini": self.gemini.registry.begin_task(session_id, task_id, "submit")
            _: "error:unsupported_agent_provider"
        self.result(provider, session_id, evidence)

    me steer(provider: text, session_id: text, task_id: text) -> AgentControlResult:
        val evidence = match provider:
            "claude": self.claude.registry.begin_task(session_id, task_id, "steer")
            "codex": self.codex.registry.begin_task(session_id, task_id, "steer")
            "gemini": self.gemini.registry.begin_task(session_id, task_id, "steer")
            _: "error:unsupported_agent_provider"
        self.result(provider, session_id, evidence)

    me cancel(provider: text, session_id: text, task_id: text) -> AgentControlResult:
        val evidence = match provider:
            "claude": self.claude.registry.cancel(session_id, task_id)
            "codex": self.codex.registry.cancel(session_id, task_id)
            "gemini": self.gemini.registry.cancel(session_id, task_id)
            _: "error:unsupported_agent_provider"
        self.result(provider, session_id, evidence)

    me accept_event(provider: text, session_id: text, event_name: text, payload: text) -> AgentControlResult:
        val evidence = match provider:
            "claude": self.claude.accept_hook(session_id, event_name, payload)
            "codex": self.codex.accept_notification(session_id, event_name, payload)
            "gemini": self.gemini.accept_hook(session_id, event_name, payload)
            _: "error:unsupported_agent_provider"
        self.result(provider, session_id, evidence)

    me close(provider: text, session_id: text) -> AgentControlResult:
        val evidence = match provider:
            "claude": self.claude.registry.close(session_id)
            "codex": self.codex.registry.close(session_id)
            "gemini": self.gemini.registry.close(session_id)
            _: "error:unsupported_agent_provider"
        self.result(provider, session_id, evidence)

    fn result(provider: text, session_id: text, evidence: text) -> AgentControlResult:
        if evidence.starts_with("error:"): return control_error(provider, session_id, evidence)
        control_ok(provider, session_id, evidence)

export AgentControlResult, AgentControlService
