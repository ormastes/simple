# codex-impl
"""Typed decoder for the LLM Caret composite integration manifest."""

use std.common.sdn.parser.{parse as sdn_parse}
use std.common.sdn.schema.{SdnDecodeIssues, sdn_require_text, sdn_require_bool, sdn_get_text, sdn_get_bool, sdn_get_text_array}

pub class IntegrationAgentManifest:
    name: text
    hook_path: text
    settings_fragment: text
    transport: text
    app_server: bool

pub class IntegrationManifest:
    schema: text
    name: text
    version: text
    kind: text
    runtime_command: text
    runtime_args: [text]
    agents: [IntegrationAgentManifest]
    mcp_manifest: text
    config_schema: text
    config_defaults: text
    migrations: [text]
    merge_settings: bool
    backup_before_write: bool
    record_owned_paths: bool
    record_before_after_hashes: bool
    preserve_user_entries_on_uninstall: bool
    credentials_in_hook_files: bool
    issues: [text]

    fn valid(self) -> bool:
        self.issues.len() == 0

fn _issue_text(issues: SdnDecodeIssues) -> [text]:
    var out: [text] = []
    for issue in issues.items:
        out.push(issue.path + ": " + issue.message)
    out

fn _agent(root, name: text, issues: SdnDecodeIssues) -> IntegrationAgentManifest:
    val prefix = "integration.agents." + name + "."
    val hook_path = sdn_get_text(root, prefix + "hooks", issues) ?? ""
    val settings_fragment = sdn_get_text(root, prefix + "settings_fragment", issues) ?? ""
    val transport = sdn_require_text(root, prefix + "transport", issues) ?? ""
    val app_server = sdn_get_bool(root, prefix + "app_server", issues) ?? false
    if hook_path == "" and settings_fragment == "":
        issues.add(prefix + "hooks", "agent requires hooks or settings_fragment")
    IntegrationAgentManifest(name: name, hook_path: hook_path, settings_fragment: settings_fragment,
        transport: transport, app_server: app_server)

fn _empty_manifest(issue: text) -> IntegrationManifest:
    IntegrationManifest(schema: "", name: "", version: "", kind: "", runtime_command: "",
        runtime_args: [], agents: [], mcp_manifest: "", config_schema: "", config_defaults: "",
        migrations: [], merge_settings: false, backup_before_write: false,
        record_owned_paths: false, record_before_after_hashes: false,
        preserve_user_entries_on_uninstall: false, credentials_in_hook_files: false,
        issues: [issue])

pub fn decode_integration_manifest(content: text) -> IntegrationManifest:
    match sdn_parse(content):
        case Err(_):
            _empty_manifest("manifest: invalid SDN")
        case Ok(root):
            val issues = SdnDecodeIssues.new()
            val schema = sdn_require_text(root, "integration.schema", issues) ?? ""
            val name = sdn_require_text(root, "integration.name", issues) ?? ""
            val version = sdn_require_text(root, "integration.version", issues) ?? ""
            val kind = sdn_require_text(root, "integration.kind", issues) ?? ""
            val runtime_command = sdn_require_text(root, "integration.runtime.command", issues) ?? ""
            val runtime_args = sdn_get_text_array(root, "integration.runtime.args", issues) ?? []
            val agents = [_agent(root, "claude", issues), _agent(root, "codex", issues), _agent(root, "gemini", issues)]
            val mcp_manifest = sdn_require_text(root, "integration.mcp.manifest", issues) ?? ""
            val config_schema = sdn_require_text(root, "integration.configuration.schema", issues) ?? ""
            val config_defaults = sdn_require_text(root, "integration.configuration.defaults", issues) ?? ""
            val migrations = sdn_get_text_array(root, "integration.migrations", issues) ?? []
            val merge_settings = sdn_require_bool(root, "integration.install_policy.merge_settings", issues) ?? false
            val backup_before_write = sdn_require_bool(root, "integration.install_policy.backup_before_write", issues) ?? false
            val record_owned_paths = sdn_require_bool(root, "integration.install_policy.record_owned_paths", issues) ?? false
            val record_before_after_hashes = sdn_require_bool(root, "integration.install_policy.record_before_after_hashes", issues) ?? false
            val preserve_user_entries_on_uninstall = sdn_require_bool(root, "integration.install_policy.preserve_user_entries_on_uninstall", issues) ?? false
            val credentials_in_hook_files = sdn_require_bool(root, "integration.install_policy.credentials_in_hook_files", issues) ?? false
            if schema != "simple.integration/v1":
                issues.add("integration.schema", "unsupported schema")
            if kind != "agent_chat_bridge":
                issues.add("integration.kind", "expected agent_chat_bridge")
            if credentials_in_hook_files:
                issues.add("integration.install_policy.credentials_in_hook_files", "credentials in hook files are forbidden")
            IntegrationManifest(schema: schema, name: name, version: version, kind: kind,
                runtime_command: runtime_command, runtime_args: runtime_args, agents: agents,
                mcp_manifest: mcp_manifest, config_schema: config_schema, config_defaults: config_defaults,
                migrations: migrations, merge_settings: merge_settings, backup_before_write: backup_before_write,
                record_owned_paths: record_owned_paths, record_before_after_hashes: record_before_after_hashes,
                preserve_user_entries_on_uninstall: preserve_user_entries_on_uninstall,
                credentials_in_hook_files: credentials_in_hook_files, issues: _issue_text(issues))
