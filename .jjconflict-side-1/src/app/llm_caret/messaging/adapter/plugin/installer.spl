# codex-impl
"""Pure installation planner: callers execute the explicit, hash-guarded operations."""

use std.crypto.sha256.{sha256_text}
use std.io_runtime.{file_exists, file_read, file_write, file_delete}
use app.llm_caret.messaging.adapter.plugin.manifest.{IntegrationManifest}

pub class PluginOwnedFile:
    path: text
    content: text
    executable: bool

pub class PluginInstalledRecord:
    path: text
    backup_path: text
    before_hash: text
    after_hash: text
    owned: bool

pub class PluginFileOperation:
    action: text
    path: text
    backup_path: text
    expected_hash: text
    content: text
    reason: text

pub class PluginCheck:
    name: text
    status: text
    detail: text

pub class PluginPlan:
    status: text
    reason: text
    operations: [PluginFileOperation]
    records: [PluginInstalledRecord]
    checks: [PluginCheck]

pub class PluginExecution:
    status: text
    applied: i64
    error: text

pub class PluginSettingsMerge:
    path: text
    current_content: text
    merged_content: text
    owned_fragment: text
    user_entries_preserved: bool
    owned_fragment_present: bool

pub fn plugin_content_hash(content: text) -> text:
    "sha256:" + sha256_text(content)

fn _backup_path(path: text, before_hash: text) -> text:
    path + ".llm-caret-messaging.backup." + before_hash.substring(7, 19)

fn _contains_credential(content: text) -> bool:
    val lower = content.to_lower()
    lower.contains("api_key") or lower.contains("access_token") or lower.contains("client_secret") or lower.contains("authorization: bearer")

fn _install_one(file: PluginOwnedFile, current: text) -> (PluginFileOperation, PluginInstalledRecord):
    val before_hash = plugin_content_hash(current)
    val after_hash = plugin_content_hash(file.content)
    val backup_path = if current == "": "" else: _backup_path(file.path, before_hash)
    val action = if current == file.content: "unchanged" else: "write"
    val operation = PluginFileOperation(action: action, path: file.path, backup_path: backup_path,
        expected_hash: before_hash, content: file.content, reason: "plugin_owned_file")
    val record = PluginInstalledRecord(path: file.path, backup_path: backup_path,
        before_hash: before_hash, after_hash: after_hash, owned: true)
    (operation, record)

pub fn plan_plugin_settings_merge(manifest: IntegrationManifest, merge: PluginSettingsMerge) -> PluginPlan:
    if not manifest.valid() or not manifest.merge_settings:
        return PluginPlan(status: "blocked", reason: "settings_merge_not_enabled", operations: [], records: [], checks: [])
    if merge.path.trim() == "" or merge.owned_fragment.trim() == "" or merge.merged_content.trim() == "":
        return PluginPlan(status: "blocked", reason: "settings_merge_input_missing", operations: [], records: [], checks: [])
    if not merge.user_entries_preserved:
        return PluginPlan(status: "blocked", reason: "settings_merge_would_remove_user_entries", operations: [], records: [], checks: [])
    if not merge.owned_fragment_present:
        return PluginPlan(status: "blocked", reason: "settings_merge_missing_owned_fragment", operations: [], records: [], checks: [])
    val file = PluginOwnedFile(path: merge.path, content: merge.merged_content, executable: false)
    val pair = _install_one(file, merge.current_content)
    val operation = PluginFileOperation(action: pair.0.action, path: pair.0.path,
        backup_path: pair.0.backup_path, expected_hash: pair.0.expected_hash,
        content: pair.0.content, reason: "merge_settings_preserving_user_entries")
    val checks = [
        PluginCheck(name: "settings_user_entries", status: "passed", detail: merge.path),
        PluginCheck(name: "settings_owned_fragment", status: "passed", detail: merge.path)
    ]
    PluginPlan(status: "ready", reason: "settings_merge_verified", operations: [operation], records: [pair.1], checks: checks)

pub fn plan_plugin_install(manifest: IntegrationManifest, files: [PluginOwnedFile], current_contents: [text], executable_ready: [bool], mcp_initializes: bool, mcp_tools_discovered: bool) -> PluginPlan:
    if not manifest.valid():
        return PluginPlan(status: "blocked", reason: "invalid_integration_manifest", operations: [], records: [], checks: [])
    if files.len() != current_contents.len() or files.len() != executable_ready.len():
        return PluginPlan(status: "blocked", reason: "install_input_length_mismatch", operations: [], records: [], checks: [])
    var operations: [PluginFileOperation] = []
    var records: [PluginInstalledRecord] = []
    var checks: [PluginCheck] = []
    var blocked_reason = ""
    var i = 0
    while i < files.len():
        val file = files[i]
        if _contains_credential(file.content):
            blocked_reason = "credential_material_in_plugin_file"
            checks.push(PluginCheck(name: "credentials:" + file.path, status: "failed", detail: "secret-like material detected"))
        else:
            val pair = _install_one(file, current_contents[i])
            operations.push(pair.0)
            records.push(pair.1)
            val executable_status = if not file.executable or executable_ready[i]: "passed" else: "failed"
            checks.push(PluginCheck(name: "executable:" + file.path, status: executable_status,
                detail: if file.executable: "hook executable" else: "regular file"))
            if executable_status == "failed" and blocked_reason == "":
                blocked_reason = "hook_executable_not_ready"
        i = i + 1
    checks.push(PluginCheck(name: "mcp_initialize", status: if mcp_initializes: "passed" else: "failed", detail: manifest.mcp_manifest))
    checks.push(PluginCheck(name: "mcp_tool_discovery", status: if mcp_tools_discovered: "passed" else: "failed", detail: manifest.mcp_manifest))
    if not mcp_initializes and blocked_reason == "":
        blocked_reason = "mcp_initialization_failed"
    if not mcp_tools_discovered and blocked_reason == "":
        blocked_reason = "mcp_tool_discovery_failed"
    if blocked_reason != "":
        return PluginPlan(status: "blocked", reason: blocked_reason, operations: operations, records: records, checks: checks)
    PluginPlan(status: "ready", reason: "install_preconditions_satisfied", operations: operations, records: records, checks: checks)

pub fn plan_plugin_check(records: [PluginInstalledRecord], current_contents: [text], executable_ready: [bool], mcp_initializes: bool, mcp_tools_discovered: bool) -> PluginPlan:
    if records.len() != current_contents.len() or records.len() != executable_ready.len():
        return PluginPlan(status: "failed", reason: "check_input_length_mismatch", operations: [], records: records, checks: [])
    var checks: [PluginCheck] = []
    var healthy = true
    var i = 0
    while i < records.len():
        val hash_ok = plugin_content_hash(current_contents[i]) == records[i].after_hash
        val ready = executable_ready[i]
        if not hash_ok or not ready:
            healthy = false
        checks.push(PluginCheck(name: "owned_hash:" + records[i].path, status: if hash_ok: "passed" else: "changed", detail: records[i].after_hash))
        checks.push(PluginCheck(name: "executable:" + records[i].path, status: if ready: "passed" else: "failed", detail: "recorded path"))
        i = i + 1
    checks.push(PluginCheck(name: "mcp_initialize", status: if mcp_initializes: "passed" else: "failed", detail: "runtime handshake"))
    checks.push(PluginCheck(name: "mcp_tool_discovery", status: if mcp_tools_discovered: "passed" else: "failed", detail: "tool/list"))
    if not mcp_initializes or not mcp_tools_discovered:
        healthy = false
    PluginPlan(status: if healthy: "passed" else: "failed", reason: if healthy: "installation_verified" else: "installation_drift_or_runtime_failure", operations: [], records: records, checks: checks)

pub fn plan_plugin_uninstall(records: [PluginInstalledRecord], current_contents: [text]) -> PluginPlan:
    if records.len() != current_contents.len():
        return PluginPlan(status: "blocked", reason: "uninstall_input_length_mismatch", operations: [], records: records, checks: [])
    var operations: [PluginFileOperation] = []
    var checks: [PluginCheck] = []
    var preserved = false
    var i = 0
    while i < records.len():
        val record = records[i]
        val current_hash = plugin_content_hash(current_contents[i])
        if not record.owned:
            operations.push(PluginFileOperation(action: "preserve", path: record.path, backup_path: record.backup_path,
                expected_hash: current_hash, content: current_contents[i], reason: "not_plugin_owned"))
            preserved = true
        elif current_hash != record.after_hash:
            operations.push(PluginFileOperation(action: "preserve", path: record.path, backup_path: record.backup_path,
                expected_hash: current_hash, content: current_contents[i], reason: "current_hash_differs_from_installed_hash"))
            preserved = true
        elif record.before_hash == plugin_content_hash(""):
            operations.push(PluginFileOperation(action: "delete", path: record.path, backup_path: "",
                expected_hash: record.after_hash, content: "", reason: "plugin_created_file"))
        else:
            operations.push(PluginFileOperation(action: "restore_backup", path: record.path, backup_path: record.backup_path,
                expected_hash: record.after_hash, content: "", reason: "restore_exact_preinstall_content"))
        checks.push(PluginCheck(name: "uninstall_guard:" + record.path, status: if current_hash == record.after_hash: "owned" else: "preserved", detail: current_hash))
        i = i + 1
    PluginPlan(status: "ready", reason: if preserved: "user_changes_preserved" else: "owned_files_removable", operations: operations, records: records, checks: checks)

fn _plugin_current_content(path: text) -> text:
    if not file_exists(path): return ""
    file_read(path)

pub fn execute_plugin_plan(plan: PluginPlan) -> PluginExecution:
    if plan.status != "ready" and plan.status != "passed":
        return PluginExecution(status: "blocked", applied: 0, error: "plan_not_executable:" + plan.status)

    # Check every ownership hash before making the first filesystem change.
    for operation in plan.operations:
        if operation.action == "write" or operation.action == "delete" or operation.action == "restore_backup":
            if plugin_content_hash(_plugin_current_content(operation.path)) != operation.expected_hash:
                return PluginExecution(status: "blocked", applied: 0,
                    error: "concurrent_change:" + operation.path)
        if operation.action == "restore_backup" and not file_exists(operation.backup_path):
            return PluginExecution(status: "blocked", applied: 0,
                error: "backup_missing:" + operation.backup_path)

    var applied = 0
    for operation in plan.operations:
        if operation.action == "write":
            val current = _plugin_current_content(operation.path)
            if operation.backup_path != "" and not file_write(operation.backup_path, current):
                return PluginExecution(status: "failed", applied: applied,
                    error: "backup_write_failed:" + operation.backup_path)
            if not file_write(operation.path, operation.content):
                return PluginExecution(status: "failed", applied: applied,
                    error: "owned_write_failed:" + operation.path)
            applied = applied + 1
        elif operation.action == "delete":
            if file_exists(operation.path) and not file_delete(operation.path):
                return PluginExecution(status: "failed", applied: applied,
                    error: "owned_delete_failed:" + operation.path)
            applied = applied + 1
        elif operation.action == "restore_backup":
            if not file_write(operation.path, file_read(operation.backup_path)):
                return PluginExecution(status: "failed", applied: applied,
                    error: "backup_restore_failed:" + operation.path)
            applied = applied + 1
        elif operation.action == "unchanged" or operation.action == "preserve":
            pass
        else:
            return PluginExecution(status: "failed", applied: applied,
                error: "unknown_operation:" + operation.action)
    PluginExecution(status: "applied", applied: applied, error: "")
