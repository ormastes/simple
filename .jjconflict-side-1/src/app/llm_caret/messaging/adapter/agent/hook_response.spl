"""Provider-correct JSON stdout contracts for compiled messaging hooks."""

use app.llm_caret.json_helpers.{escape_json_text}

fn hook_context_event(provider: text, event_name: text) -> bool:
    if provider == "claude":
        return event_name == "SessionStart" or event_name == "UserPromptSubmit" or
            event_name == "SubagentStart" or event_name == "PreToolUse" or
            event_name == "PostToolUse" or event_name == "PostToolUseFailure"
    provider == "gemini" and (event_name == "SessionStart" or event_name == "BeforeAgent")

fn provider_hook_response(provider: text, event_name: text, context: text) -> text:
    if context == "" or not hook_context_event(provider, event_name):
        return "{\"continue\":true,\"suppressOutput\":true}"
    "{\"continue\":true,\"suppressOutput\":true,\"hookSpecificOutput\":{" +
        "\"hookEventName\":\"" + escape_json_text(event_name) + "\"," +
        "\"additionalContext\":\"" + escape_json_text(context) + "\"}}"

export hook_context_event, provider_hook_response
