# Typed final-evidence orchestration for native SIMD X25519MLKEM768 runs.
#
# This boundary intentionally accepts no serialized receipt, digest, or
# attestation input.  The only raw hand-off is produced by the native pinned
# workload observer; the existing attested-row composer remains the sole
# promotion boundary.

mod app.test.x25519mlkem768_simd_final_evidence

use app.test.x25519mlkem768_evidence.{x25519_mlkem768_observe_pinned_simd_full_operation}
use app.test.x25519mlkem768_simd_attested_row.{x25519_mlkem768_compose_simd_attested_matrix_row}
use lib.common.crypto.x25519_mlkem768.contract.{X25519MlKem768SimdAdmission}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceCli, X25519MlKem768EvidenceMode,
    X25519MlKem768EvidenceScope}
use lib.common.crypto.x25519_mlkem768.matrix_receipt.{X25519MlKem768MatrixRow}
use lib.common.crypto.x25519_mlkem768.performance_attestation.{X25519MlKem768PerformanceAttestation}
use lib.common.crypto.x25519_mlkem768.simd_full_operation_receipt.{X25519MlKem768SimdReceiptBinding}

fn _simd_final_cli_reason(
        cli: X25519MlKem768EvidenceCli,
        binding: X25519MlKem768SimdReceiptBinding) -> text:
    if cli.backend != binding.backend:
        return "simd-final-cli-binding-backend-mismatch"
    if cli.mode != X25519MlKem768EvidenceMode.Native:
        return "simd-final-cli-requires-native-mode"
    if cli.scope != X25519MlKem768EvidenceScope.FullOperation:
        return "simd-final-cli-requires-full-operation"
    if cli.batch_size != binding.batch_size:
        return "simd-final-cli-binding-batch-mismatch"
    ""

# Run the actual native pinned SIMD path and produce one final Executed row
# only after independently admitted performance is verified.  Manifest,
# fixture, and runner digests originate exclusively in `binding`; callers
# cannot substitute unbound text values at this boundary.
fn x25519_mlkem768_observe_and_compose_simd_attested_matrix_row(
        cli: X25519MlKem768EvidenceCli,
        admission: X25519MlKem768SimdAdmission,
        binding: X25519MlKem768SimdReceiptBinding,
        performance: X25519MlKem768PerformanceAttestation
        ) -> Result<X25519MlKem768MatrixRow, text>:
    val cli_reason = _simd_final_cli_reason(cli, binding)
    if cli_reason != "": return Err(cli_reason)
    val observation = x25519_mlkem768_observe_pinned_simd_full_operation(
        cli, admission, binding.fixture_manifest_sha256,
        binding.fixture_source_sha256, binding.runner_source_sha256)?
    x25519_mlkem768_compose_simd_attested_matrix_row(
        binding, observation, performance)

export x25519_mlkem768_observe_and_compose_simd_attested_matrix_row
