# Generates an Aetheric host Web/GUI surface through the production
# SimpleOS Web request builder. The body supplies only evidence layout and
# controls; all visual material comes from the resolved theme package.

use common.ui.generated.aetheric_dark_theme_snapshot.{aetheric_dark_theme_render_snapshot}
use common.ui.wm_chrome_theme.{apply_theme_render_snapshot_to_wm_chrome}
use os.compositor.simple_web_window_renderer.{simple_web_content_full_html_with_theme}
use std.sffi.cli.{cli_get_args}
use std.io_runtime.{file_write}

fn main() -> i64:
    val args = cli_get_args()
    if args.len() < 2 or args[1] == "":
        print "aetheric_host_web_gui_generation_status=fail"
        print "aetheric_host_web_gui_generation_reason=missing-output-path"
        return 2
    val output_path = args[1]

    # Production native startup consumes the generated immutable snapshot.
    # Dynamic package compilation is a development tool boundary and returns
    # aggregate package classes that are not safe across the native ABI yet.
    val snapshot = aetheric_dark_theme_render_snapshot()
    if snapshot.id != "aetheric_dark":
        print "aetheric_host_web_gui_generation_status=fail"
        print "aetheric_host_web_gui_generation_reason=theme-resolution-mismatch"
        return 2
    apply_theme_render_snapshot_to_wm_chrome(snapshot)
    val body = "<main data-aetheric-production-surface='true' style='position:relative;min-height:600px;padding:32px;box-sizing:border-box'>" +
        "<section class='wm-window focused' data-window-state='active' style='position:absolute;left:48px;top:40px;width:520px;min-height:330px;overflow:hidden'>" +
        "<header class='wm-titlebar' style='display:flex;align-items:center;justify-content:space-between;min-height:48px;padding:0 16px;box-sizing:border-box'>" +
        "<h1 class='wm-title' style='margin:0;font-size:18px'>Aetheric Settings</h1><button class='widget-button' type='button' style='min-width:112px;min-height:36px'>Apply Theme</button></header>" +
        "<div style='display:grid;gap:16px;padding:24px'><label class='widget-label' for='theme-name'>Theme name</label>" +
        "<input id='theme-name' class='widget-input' value='Aetheric Dark' style='min-height:40px;padding:0 12px' />" +
        "<p class='widget-text'>Production Simple Web → Draw IR → Engine2D content.</p></div></section>" +
        "<section class='wm-window' data-window-state='inactive' style='position:absolute;left:612px;top:116px;width:280px;min-height:210px;overflow:hidden'>" +
        "<header class='wm-titlebar' style='display:flex;align-items:center;min-height:48px;padding:0 16px;box-sizing:border-box'><h2 class='wm-title' style='margin:0;font-size:16px'>Inactive Window</h2></header>" +
        "<div class='widget-text' style='padding:20px'>Focus depth comparison</div></section></main>"
    val html = simple_web_content_full_html_with_theme(snapshot.id, "Aetheric Production Web GUI", body, 960, 640)
    if html == "" or not file_write(output_path, html):
        print "aetheric_host_web_gui_generation_status=fail"
        print "aetheric_host_web_gui_generation_reason=html-write-failed"
        return 2

    print "aetheric_host_web_gui_generation_status=pass"
    print "aetheric_host_web_gui_generation_producer=simple_web_content_render_request_with_theme"
    print "aetheric_host_web_gui_generation_synthetic_fixture=false"
    print "aetheric_host_web_gui_generation_raw_source_execution=false"
    print "aetheric_host_web_gui_generation_theme_id={snapshot.id}"
    print "aetheric_host_web_gui_generation_theme_manifest_sha256={snapshot.source_manifest_sha256}"
    print "aetheric_host_web_gui_generation_theme_material_sha256={snapshot.material_sha256}"
    print "aetheric_host_web_gui_generation_html={output_path}"
    0
