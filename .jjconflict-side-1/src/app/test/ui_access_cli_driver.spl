# Narrow native entry for the canonical Simple UI access owner. Production
# evidence uses this cached artifact when the monolithic Stage 4 CLI is not
# available; command parsing and transport still belong to run_ui_access_cli.

use app.ui.access_cli.{run_ui_access_cli}
use std.sffi.cli.{cli_get_args}

fn main() -> i64:
    val raw = cli_get_args()
    var args: [text] = []
    var port = 18080
    var i = 1
    while i < raw.len():
        val arg = raw[i]
        if arg == "--port":
            if i + 1 >= raw.len():
                print "{\"schema\":\"simple.access/v1\",\"operation\":\"\",\"ok\":false,\"error\":{\"code\":\"invalid_argument\",\"message\":\"--port requires a value\"}}"
                return 2
            port = (raw[i + 1].to_int() ?? 18080).to_i32()
            i = i + 2
        elif arg.starts_with("--port="):
            port = (arg.substring(7, arg.len()).to_int() ?? 18080).to_i32()
            i = i + 1
        else:
            args = args.push(arg)
            i = i + 1
    run_ui_access_cli(args, port, "")
