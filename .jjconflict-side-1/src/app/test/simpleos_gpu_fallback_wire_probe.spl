"""Native host probe for explicit CPU fallback over file-backed ivshmem."""

use std.io_runtime.{
    remove_file_if_exists
}
use app.io.args_ops.{get_args}
use app.io.file_ops.{file_mmap, file_munmap}
use os.kernel.boot.mmio_hardware.{mmio_read32, mmio_read64, mmio_write64}
use os.kernel.boot.monotonic_hardware.{boot_monotonic_now_us}
use os.lib.gpu_bridge.host_gpu_ivshmem.{
    HostGpuIvshmemReceipt,
    HOST_GPU_IVSHMEM_MAX_TIMEOUT_POLLS,
    host_gpu_ivshmem_negotiate,
    host_gpu_ivshmem_fill_u32,
    host_gpu_ivshmem_device_receipt_valid,
    host_gpu_ivshmem_fallback_receipt_valid
}
use common.gpu.simpleos_host_gpu_protocol.{
    SIMPLEOS_HOST_GPU_REGION_BYTES,
    SIMPLEOS_HOST_GPU_BACKEND_MASK_CUDA,
    SIMPLEOS_HOST_GPU_BACKEND_CUDA,
    SIMPLEOS_HOST_GPU_STATUS_PASS,
    SIMPLEOS_HOST_GPU_STATUS_FALLBACK,
    SIMPLEOS_HOST_GPU_REASON_BACKEND_SUBMIT_FAILED,
    SIMPLEOS_HOST_GPU_READBACK_DEVICE,
    SIMPLEOS_HOST_GPU_READBACK_CPU
}

fn _cleanup(mapped: i64, path: text):
    if mapped > 0:
        val _ = file_munmap(mapped, SIMPLEOS_HOST_GPU_REGION_BYTES)

fn _output_exact(receipt: HostGpuIvshmemReceipt, count: i64, value: u32) -> bool:
    if receipt.output_bytes != count * 4:
        return false
    var index: i64 = 0
    while index < count:
        if mmio_read32(receipt.output_addr + ((index * 4) as u64)) != value:
            return false
        index = index + 1
    true

fn _median5(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64) -> i64:
    var a = v0
    var b = v1
    var c = v2
    var d = v3
    var e = v4
    var swap: i64 = 0
    if a > b:
        swap = a
        a = b
        b = swap
    if d > e:
        swap = d
        d = e
        e = swap
    if c > e:
        swap = c
        c = e
        e = swap
    if c > d:
        swap = c
        c = d
        d = swap
    if a > d:
        swap = a
        a = d
        d = swap
    if a > c:
        swap = a
        a = c
        c = swap
    if b > e:
        swap = b
        b = e
        e = swap
    if b > d:
        swap = b
        b = d
        d = swap
    if b > c:
        swap = b
        b = c
        c = swap
    c

fn _device_warm(base: u64) -> i64:
    val count: i64 = 1048576
    val value = 0x01020304u32
    val expected_checksum: i64 = 809508928
    val warmups: i64 = 3
    val samples: i64 = 5
    val hello = host_gpu_ivshmem_negotiate(
        base, 1, "x86_64", "vulkan", SIMPLEOS_HOST_GPU_BACKEND_MASK_CUDA,
        HOST_GPU_IVSHMEM_MAX_TIMEOUT_POLLS, boot_monotonic_now_us() + 30000000)
    var valid = hello.completed and
        hello.status == SIMPLEOS_HOST_GPU_STATUS_PASS and
        hello.processing_mask == SIMPLEOS_HOST_GPU_BACKEND_MASK_CUDA
    var handle: i64 = 0
    var identity: i64 = 0
    var device0: i64 = 0
    var device1: i64 = 0
    var device2: i64 = 0
    var device3: i64 = 0
    var device4: i64 = 0
    var roundtrip0: i64 = 0
    var roundtrip1: i64 = 0
    var roundtrip2: i64 = 0
    var roundtrip3: i64 = 0
    var roundtrip4: i64 = 0
    var non_device0: i64 = 0
    var non_device1: i64 = 0
    var non_device2: i64 = 0
    var non_device3: i64 = 0
    var non_device4: i64 = 0
    var last_status: i64 = 0
    var last_reason: i64 = 0
    var last_source: i64 = 0
    var last_checksum: i64 = 0
    var last_bytes: i64 = 0
    var last_elapsed_us: i64 = 0
    var last_roundtrip_us: i64 = 0
    var last_output0: u32 = 0u32
    var last_receipt_valid = false
    var last_output_exact = false
    var request_index: i64 = 0
    while valid and request_index < warmups + samples:
        val generation = request_index + 2
        val frame_id = request_index + 91
        val started = boot_monotonic_now_us()
        val receipt = host_gpu_ivshmem_fill_u32(
            base, generation, 7001, frame_id, "cuda", count, value,
            HOST_GPU_IVSHMEM_MAX_TIMEOUT_POLLS)
        val completed = boot_monotonic_now_us()
        val roundtrip_us = if completed > started: completed - started else: 0
        val receipt_valid = host_gpu_ivshmem_device_receipt_valid(
            receipt, generation, 7001, frame_id,
            SIMPLEOS_HOST_GPU_BACKEND_CUDA, count * 4)
        val output_exact = _output_exact(receipt, count, value)
        last_status = receipt.status
        last_reason = receipt.reason
        last_source = receipt.readback_source
        last_checksum = receipt.output_checksum
        last_bytes = receipt.output_bytes
        last_elapsed_us = receipt.elapsed_us
        last_roundtrip_us = roundtrip_us
        if receipt.output_addr > 0u64 and receipt.output_bytes >= 4:
            last_output0 = mmio_read32(receipt.output_addr)
        last_receipt_valid = receipt_valid
        last_output_exact = output_exact
        valid = receipt_valid and receipt.readback_source == SIMPLEOS_HOST_GPU_READBACK_DEVICE and
            receipt.output_checksum == expected_checksum and
            output_exact and roundtrip_us >= receipt.elapsed_us
        if request_index == 0:
            handle = receipt.native_handle
            identity = receipt.device_identity
        else:
            valid = valid and receipt.native_handle == handle and
                receipt.device_identity == identity
        if request_index >= warmups:
            val measured_index = request_index - warmups
            val non_device_us = roundtrip_us - receipt.elapsed_us
            if measured_index == 0:
                device0 = receipt.elapsed_us
                roundtrip0 = roundtrip_us
                non_device0 = non_device_us
            elif measured_index == 1:
                device1 = receipt.elapsed_us
                roundtrip1 = roundtrip_us
                non_device1 = non_device_us
            elif measured_index == 2:
                device2 = receipt.elapsed_us
                roundtrip2 = roundtrip_us
                non_device2 = non_device_us
            elif measured_index == 3:
                device3 = receipt.elapsed_us
                roundtrip3 = roundtrip_us
                non_device3 = non_device_us
            else:
                device4 = receipt.elapsed_us
                roundtrip4 = roundtrip_us
                non_device4 = non_device_us
        request_index = request_index + 1
    val median_device_us = _median5(device0, device1, device2, device3, device4)
    val median_roundtrip_us = _median5(roundtrip0, roundtrip1, roundtrip2, roundtrip3, roundtrip4)
    val median_non_device_us = _median5(
        non_device0, non_device1, non_device2, non_device3, non_device4)
    valid = valid and request_index == warmups + samples and
        median_device_us > 0 and median_roundtrip_us >= median_device_us and
        median_non_device_us >= 0 and handle > 0 and identity > 0
    val status = if valid: "pass" else: "fail"
    print("GPU_DEVICE_WARM_WIRE status={status} warmups={warmups} samples={samples} requests={request_index} count={count} checksum={expected_checksum} median_device_us={median_device_us} median_roundtrip_us={median_roundtrip_us} median_non_device_us={median_non_device_us} handle={handle} identity={identity} exact={valid} stable_provenance={valid} last_status={last_status} last_reason={last_reason} last_source={last_source} last_checksum={last_checksum} last_bytes={last_bytes} last_elapsed_us={last_elapsed_us} last_roundtrip_us={last_roundtrip_us} last_output0={last_output0} last_receipt_valid={last_receipt_valid} last_output_exact={last_output_exact}\n")
    if valid: 0 else: 1

fn main() -> i64:
    val args = get_args()
    if args.contains("--median-self-test"):
        val valid = _median5(5, 1, 3, 2, 4) == 3 and
            _median5(1, 1, 9, 1, 5) == 1 and
            _median5(9, 8, 7, 6, 5) == 7
        print("GPU_DEVICE_WARM_MEDIAN status={if valid: \"pass\" else: \"fail\"}\n")
        return if valid: 0 else: 1
    var path = ""
    var take_path = false
    for arg in args:
        if take_path:
            path = arg
            take_path = false
        elif arg == "--shm":
            take_path = true
    val expected_reason = if args.contains("--expected-reason=18"): 18 else: SIMPLEOS_HOST_GPU_REASON_BACKEND_SUBMIT_FAILED
    if path == "":
        print("GPU_FALLBACK_WIRE status=fail reason=shm-required\n")
        return 2
    val mapped = file_mmap(path, SIMPLEOS_HOST_GPU_REGION_BYTES, 0, false)
    if mapped <= 0:
        remove_file_if_exists(path)
        print("GPU_FALLBACK_WIRE status=fail reason=mmap-failed\n")
        return 3
    val base = mapped as u64
    if args.contains("--mmap-smoke"):
        mmio_write64(base, 0x53484750u64)
        val exact = mmio_read64(base) == 0x53484750u64
        _cleanup(mapped, path)
        print("GPU_FALLBACK_MMAP status={if exact: \"pass\" else: \"fail\"}\n")
        return if exact: 0 else: 1
    if args.contains("--device-warm"):
        val result = _device_warm(base)
        _cleanup(mapped, path)
        return result
    val hello = host_gpu_ivshmem_negotiate(
        base, 1, "x86_64", "vulkan", SIMPLEOS_HOST_GPU_BACKEND_MASK_CUDA,
        HOST_GPU_IVSHMEM_MAX_TIMEOUT_POLLS, boot_monotonic_now_us() + 30000000)
    val receipt = host_gpu_ivshmem_fill_u32(
        base, 2, 7001, 91, "cuda", 8, 0x01020304u32, HOST_GPU_IVSHMEM_MAX_TIMEOUT_POLLS)
    var output_exact = receipt.output_bytes == 32
    var output_index: i64 = 0
    while output_exact and output_index < 8:
        output_exact = mmio_read32(receipt.output_addr + ((output_index * 4) as u64)) == 0x01020304u32
        output_index = output_index + 1
    val valid = hello.completed and
        hello.status == SIMPLEOS_HOST_GPU_STATUS_PASS and
        hello.processing_mask == SIMPLEOS_HOST_GPU_BACKEND_MASK_CUDA and
        receipt.completed and
        receipt.status == SIMPLEOS_HOST_GPU_STATUS_FALLBACK and
        receipt.reason == expected_reason and
        receipt.readback_source == SIMPLEOS_HOST_GPU_READBACK_CPU and
        receipt.native_handle == 0 and receipt.device_identity == 0 and
        output_exact and receipt.output_checksum == 135272480 and
        receipt.elapsed_us > 0 and
        host_gpu_ivshmem_fallback_receipt_valid(
            receipt, 2, 7001, 91, SIMPLEOS_HOST_GPU_BACKEND_CUDA, 32)
    val status = if valid: "pass" else: "fail"
    print("GPU_FALLBACK_WIRE status={status} hello_completed={hello.completed} hello_status={hello.status} hello_mask={hello.processing_mask} receipt_completed={receipt.completed} receipt_status={receipt.status} reason={receipt.reason} source={receipt.readback_source} handle={receipt.native_handle} identity={receipt.device_identity} bytes={receipt.output_bytes} checksum={receipt.output_checksum} elapsed_us={receipt.elapsed_us} backend={receipt.backend_code}\n")
    _cleanup(mapped, path)
    if valid: 0 else: 1
