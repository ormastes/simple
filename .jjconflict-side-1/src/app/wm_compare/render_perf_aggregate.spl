"""A7 — 80 Hz promotion: the parent-authoritative aggregate-receipt correlator.

Plan: doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md § 0-B, item A7
("the software aggregate must correlate A4 and A5 receipts that each pass
p95 <= 12,500,000 ns with no disallowed fallback or unknown completion. It
reports `blocked-physical`, not failure or PASS, until correlated A6 evidence is
supplied; only then may it promote the full campaign").

The rules below mirror the committed shell contract in
scripts/check/check-render-perf-8k80-container.shs (BUDGET_NS=12500000, the
per-receipt field gates at :78-:79 and :103-:108, and the
`status=blocked-physical reason=missing-physical-receipt` branch at :163), so
the two enforcement surfaces cannot drift into disagreeing verdicts.

HONESTY CONTRACT. `blocked-physical` is a PROMOTION verdict, not a fallback
excuse: it may only be published when BOTH software receipts were actually
produced and actually passed their own gates, and the only thing missing is A6
physical evidence. Software evidence that is itself missing or rejected yields
`failed` with the naming reason — never `blocked-physical`, and never `pass`.
"""

use app.wm_compare.production_native_cpu_draw_ir_frame.{
    production_native_cpu_draw_ir_frame_receipt, production_native_cpu_draw_ir_frame_field
}
use app.wm_compare.strict_semantic_vulkan_producer.{strict_semantic_vulkan_producer_receipt}
use app.wm_compare_host.io_runtime.{file_exists, env_get}

# Per-frame budget for 80 Hz: 1s / 80 = 12.5 ms.
pub val RENDER_PERF_AGGREGATE_BUDGET_NS: i64 = 12500000

fn _field(receipt: text, key: text) -> text:
    production_native_cpu_draw_ir_frame_field(receipt, key)

fn _i64_field(receipt: text, key: text) -> i64:
    _field(receipt, key).parse_int() ?? 0

# A4's own gate: it passed, stayed inside the budget, proved no fallback, and
# reported a known completion.
pub fn render_perf_aggregate_software_receipt_admissible(receipt: text) -> bool:
    val p95 = _i64_field(receipt, "producer_receipt_p95_ns")
    (_field(receipt, "producer_receipt_status") == "pass" and
        p95 > 0 and p95 <= RENDER_PERF_AGGREGATE_BUDGET_NS and
        _field(receipt, "producer_receipt_fallback_used") == "false" and
        _field(receipt, "producer_receipt_completion_known") == "true")

# The A6 physical receipt this campaign refuses to fabricate.
pub fn render_perf_aggregate_physical_receipt_path() -> text:
    val override_path = env_get("PHYSICAL_RECEIPT") ?? ""
    if override_path != "":
        return override_path
    "build/render_perf/8k80_container/current/physical_receipt.env"

pub fn render_perf_aggregate_receipt_values(
    status: text, reason: text, width: i32, height: i32, sample_count: i32,
    cpu_status: text, cpu_p95_ns: i64, cpu_admissible: bool,
    vulkan_status: text, vulkan_p95_ns: i64, vulkan_admissible: bool,
    physical_present: bool
) -> text:
    "aggregate_receipt_status=" + status + "\n" +
        "aggregate_receipt_reason=" + reason + "\n" +
        "aggregate_receipt_budget_ns=" + RENDER_PERF_AGGREGATE_BUDGET_NS.to_string() + "\n" +
        "aggregate_receipt_surface_width=" + width.to_string() + "\n" +
        "aggregate_receipt_surface_height=" + height.to_string() + "\n" +
        "aggregate_receipt_sample_count=" + sample_count.to_string() + "\n" +
        "aggregate_receipt_a4_status=" + cpu_status + "\n" +
        "aggregate_receipt_a4_p95_ns=" + cpu_p95_ns.to_string() + "\n" +
        "aggregate_receipt_a4_admissible=" + (if cpu_admissible: "true" else: "false") + "\n" +
        "aggregate_receipt_a5_status=" + vulkan_status + "\n" +
        "aggregate_receipt_a5_p95_ns=" + vulkan_p95_ns.to_string() + "\n" +
        "aggregate_receipt_a5_admissible=" + (if vulkan_admissible: "true" else: "false") + "\n" +
        "aggregate_receipt_a6_physical_receipt_present=" + (if physical_present: "true" else: "false") + "\n"

pub fn render_perf_aggregate_receipt(
    width: i32, height: i32, sample_count: i32
) -> text:
    val cpu_receipt = production_native_cpu_draw_ir_frame_receipt(width, height, sample_count)
    # The strict Vulkan producer fixes its own warmup/sample counts (1 and 60);
    # only the changed revision is a caller choice.
    val vulkan_receipt = strict_semantic_vulkan_producer_receipt(width, height, 1)
    val cpu_status = _field(cpu_receipt, "producer_receipt_status")
    val vulkan_status = _field(vulkan_receipt, "producer_receipt_status")
    val cpu_p95 = _i64_field(cpu_receipt, "producer_receipt_p95_ns")
    val vulkan_p95 = _i64_field(vulkan_receipt, "producer_receipt_p95_ns")
    val cpu_ok = render_perf_aggregate_software_receipt_admissible(cpu_receipt)
    val vulkan_ok = render_perf_aggregate_software_receipt_admissible(vulkan_receipt)
    val physical_present = file_exists(render_perf_aggregate_physical_receipt_path())
    var status = "failed"
    var reason = ""
    if not cpu_ok and not vulkan_ok:
        reason = "a4-and-a5-software-evidence-rejected"
    elif not cpu_ok:
        reason = "a4-software-evidence-rejected"
    elif not vulkan_ok:
        reason = "a5-software-evidence-rejected"
    elif not physical_present:
        status = "blocked-physical"
        reason = "missing-physical-receipt"
    else:
        status = "pass"
        reason = "pass"
    render_perf_aggregate_receipt_values(
        status, reason, width, height, sample_count,
        cpu_status, cpu_p95, cpu_ok,
        vulkan_status, vulkan_p95, vulkan_ok,
        physical_present)

export RENDER_PERF_AGGREGATE_BUDGET_NS
export render_perf_aggregate_software_receipt_admissible
export render_perf_aggregate_physical_receipt_path
export render_perf_aggregate_receipt_values
export render_perf_aggregate_receipt
