#!/bin/sh
set -eu

if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
    echo "usage: $0 PUBLIC_SUFFIX_LIST_DAT SOURCE_COMMIT [OUTPUT_SPL]" >&2
    exit 2
fi

psl_source=$1
psl_commit=$2
psl_output=${3:-src/lib/common/web/public_suffix_data.spl}
psl_script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

case "$psl_commit" in
    *[!0-9a-f]* | ??????????????????????????????????????? | ?????????????????????????????????????????*)
        echo "SOURCE_COMMIT must be exactly 40 lowercase hex characters" >&2
        exit 2
        ;;
esac

if [ ! -f "$psl_source" ]; then
    echo "PSL source not found: $psl_source" >&2
    exit 2
fi

psl_gen_tmp=$(mktemp -d /tmp/simple-psl-gen.XXXXXX)
trap 'rm -rf "$psl_gen_tmp"' EXIT HUP INT TERM

awk '
    NF && $1 !~ /^\/\// {
        line = $0
        sub(/[[:space:]]+\/\/.*$/, "", line)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
        if (line == "") next
        if (line ~ /^!/) {
            print substr(line, 2) > exception
        } else if (line ~ /^\*\./) {
            print substr(line, 3) > wildcard
        } else {
            print line > exact
        }
    }
' exact="$psl_gen_tmp/exact" wildcard="$psl_gen_tmp/wildcard" exception="$psl_gen_tmp/exception" "$psl_source"

python3 "$psl_script_dir/public_suffix_idna_aliases.py" \
    "$psl_source" "$psl_gen_tmp/exact" "$psl_gen_tmp/wildcard" \
    "$psl_gen_tmp/exception"

LC_ALL=C sort -u "$psl_gen_tmp/exact" > "$psl_gen_tmp/exact.sorted"
LC_ALL=C sort -u "$psl_gen_tmp/wildcard" > "$psl_gen_tmp/wildcard.sorted"
LC_ALL=C sort -u "$psl_gen_tmp/exception" > "$psl_gen_tmp/exception.sorted"

psl_exact_count=$(wc -l < "$psl_gen_tmp/exact.sorted" | tr -d ' ')
psl_wildcard_count=$(wc -l < "$psl_gen_tmp/wildcard.sorted" | tr -d ' ')
psl_exception_count=$(wc -l < "$psl_gen_tmp/exception.sorted" | tr -d ' ')
if [ "$psl_exact_count" -lt 5000 ] || [ "$psl_wildcard_count" -lt 10 ] || [ "$psl_exception_count" -lt 1 ]; then
    echo "PSL source is unexpectedly small" >&2
    exit 1
fi

psl_sha256=$(sha256sum "$psl_source" | awk '{print $1}')
{
    echo "# Generated by scripts/generate/generate-public-suffix-list.shs — DO NOT EDIT"
    echo "# Source: https://github.com/publicsuffix/list"
    echo "# Commit: $psl_commit"
    echo "# SHA-256: $psl_sha256"
    echo "# License: Mozilla Public License 2.0"
    echo "# Unicode rules include deterministic RFC 3492 ASCII aliases."
    echo
    echo "pub val PUBLIC_SUFFIX_SOURCE_COMMIT: text = \"$psl_commit\""
    echo "pub val PUBLIC_SUFFIX_SOURCE_SHA256: text = \"$psl_sha256\""
    echo
    echo "pub val PUBLIC_SUFFIX_EXACT_RULES: [text] = ["
    awk '{gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); printf "    \"%s\",\n", $0}' "$psl_gen_tmp/exact.sorted"
    echo "]"
    echo
    echo "pub val PUBLIC_SUFFIX_WILDCARD_BASES: [text] = ["
    awk '{gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); printf "    \"%s\",\n", $0}' "$psl_gen_tmp/wildcard.sorted"
    echo "]"
    echo
    echo "pub val PUBLIC_SUFFIX_EXCEPTIONS: [text] = ["
    awk '{gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); printf "    \"%s\",\n", $0}' "$psl_gen_tmp/exception.sorted"
    echo "]"
} > "$psl_output"

echo "generated $psl_output exact=$psl_exact_count wildcard=$psl_wildcard_count exception=$psl_exception_count"
