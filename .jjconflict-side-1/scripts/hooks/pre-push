#!/bin/sh
# Local pre-push dispatcher installed by install-must-check-hooks.{shs,ps1}.
# The canonical driver delegates expensive requirements through textual-ledger
# validation while retaining the bounded committed-tree guards.
set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "pre-push dispatcher: cannot locate repository root" >&2
    exit 1
}
HOOKS_DIR=$(git rev-parse --git-path hooks 2>/dev/null) || exit 1
case "$HOOKS_DIR" in /*) : ;; *) HOOKS_DIR="$ROOT/$HOOKS_DIR" ;; esac
REFS=$(mktemp) || exit 1
trap 'rm -f "$REFS"' EXIT INT TERM
cat > "$REFS"

LOCAL_HOOK="$HOOKS_DIR/pre-push.local"
CANONICAL_GUARD="$ROOT/scripts/check/pre-push-conflict-tree-guard.shs"

# Recursion fuse. `.git/hooks/pre-push` is a thin launcher that execs THIS
# dispatcher, and the installer leaves a byte-identical copy at
# `pre-push.local`. The old test below only compared the local hook against
# CANONICAL_GUARD, so a launcher-shaped local hook looked like a legitimate
# third-party hook: dispatcher -> local hook -> exec dispatcher -> ... Each
# turn of that loop is a live `sh`, so a single `git push` forks without bound
# until the host runs out of pids (measured 2026-09-01: 16,253 processes, one
# distinct parent each, still climbing; concurrent builds began failing with
# EAGAIN "failed to spawn thread"). Two independent stops, because either
# alone can be defeated: an env marker that survives exec, and a content
# comparison against the dispatcher itself.
if [ -n "${SIMPLE_PREPUSH_DISPATCHER_ACTIVE:-}" ]; then
    LOCAL_HOOK=""
fi
SIMPLE_PREPUSH_DISPATCHER_ACTIVE=1
export SIMPLE_PREPUSH_DISPATCHER_ACTIVE

DISPATCHER_SELF="$ROOT/scripts/hooks/pre-push"
if [ -n "$LOCAL_HOOK" ] && cmp -s "$LOCAL_HOOK" "$DISPATCHER_SELF"; then
    LOCAL_HOOK=""
fi
# A launcher whose only job is to exec this dispatcher is not a user hook.
if [ -n "$LOCAL_HOOK" ] && [ -r "$LOCAL_HOOK" ] &&
   grep -q 'scripts/hooks/pre-push' "$LOCAL_HOOK" 2>/dev/null; then
    LOCAL_HOOK=""
fi

if [ -n "$LOCAL_HOOK" ] && [ -x "$LOCAL_HOOK" ] && ! cmp -s "$LOCAL_HOOK" "$CANONICAL_GUARD"; then
    "$LOCAL_HOOK" "$@" < "$REFS" || {
        rc=$?
        echo "pre-push dispatcher: preserved local hook failed (status $rc)" >&2
        exit "$rc"
    }
fi

sh "$CANONICAL_GUARD" "$@" < "$REFS"
rc=$?
rm -f "$REFS"
trap - EXIT INT TERM
exit "$rc"
