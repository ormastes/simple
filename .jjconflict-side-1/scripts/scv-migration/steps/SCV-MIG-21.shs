#!/bin/sh
# SCV-MIG-21 — conservative quarantine GC (stabilization §9): never delete, only quarantine
# Acceptance for the SCV migration plan (doc/03_plan/app/tools/scv_migration_month_plan.md).
# Runs the spec and maps its "Results: … 0 failed" line to a single verdict line.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-MIG-21.shs
# The checker (scripts/check/check-scv-migration-todo.shs) refuses to run it until then.
set -u
SPEC="test/integration/app/scv_quarantine_gc_spec.spl"
[ -f "$SPEC" ] || { echo "ERROR — nothing was checked (missing spec: $SPEC)"; exit 2; }
OUT="${TMPDIR:-/tmp}/SCV-MIG-21.$$.out"
bin/simple test "$SPEC" > "$OUT" 2>&1
rc=$?
RES="$(grep -E '^Results: ' "$OUT" | tail -n 1)"
rm -f "$OUT"
[ -n "$RES" ] || { echo "ERROR — nothing was checked (no Results line from $SPEC; rc=$rc)"; exit 2; }
case "$RES" in
  *" 0 failed"*) [ "$rc" -eq 0 ] && { echo "PASS — $SPEC: $RES"; exit 0; } ;;
esac
echo "FAIL — $SPEC: $RES (rc=$rc)"
exit 1
