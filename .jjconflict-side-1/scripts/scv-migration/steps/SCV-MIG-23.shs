#!/bin/sh
# SCV-MIG-23 — Restore drills: GitHub-only, checkpoint+Git, SCV-objects-only,
# corrupt DB, missing indexes, interrupted transaction (week 4).
# Acceptance for the SCV migration plan (doc/03_plan/app/tools/scv_migration_month_plan.md).
# Runs scripts/check/check-scv-restore-drills.shs (six drills, all PASS) and
# maps its verdict line to this step's single verdict line.
# Verdict is ALWAYS the last stdout line: PASS exit 0 / FAIL exit 1 / ERROR exit 2.
# Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/scv-migration/steps/SCV-MIG-23.shs
# The checker (scripts/check/check-scv-migration-todo.shs) refuses to run it until then.
set -u
DRILLS="scripts/check/check-scv-restore-drills.shs"
[ -f "$DRILLS" ] || { echo "ERROR — nothing was checked (missing: $DRILLS)"; exit 2; }
OUT="${TMPDIR:-/tmp}/SCV-MIG-23.$$.out"
sh "$DRILLS" > "$OUT" 2>&1
rc=$?
RES="$(grep -E '^(PASS|FAIL|ERROR) ' "$OUT" | tail -n 1)"
[ -n "$RES" ] || { tail -n 20 "$OUT"; rm -f "$OUT"; echo "ERROR — nothing was checked (no verdict line from $DRILLS; rc=$rc)"; exit 2; }
case "$RES" in
  "PASS"*"0 failures"*) [ "$rc" -eq 0 ] && { rm -f "$OUT"; echo "PASS — $DRILLS: $RES"; exit 0; } ;;
  "ERROR"*) tail -n 20 "$OUT"; rm -f "$OUT"; echo "ERROR — nothing was checked ($DRILLS: $RES)"; exit 2 ;;
esac
tail -n 40 "$OUT"; rm -f "$OUT"
echo "FAIL — $DRILLS: $RES (rc=$rc)"
exit 1
