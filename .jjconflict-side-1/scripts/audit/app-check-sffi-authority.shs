#!/bin/sh
# Static lexical-boundary guard for the standalone `simple check` entrypoint.
# This checks source shape only; it does not admit, sign, or verify providers.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/app/check/main.spl"

test "$(grep -c '^@unsafe(reason: "raw transient heap scope ABI", capabilities: \[ffi\])$' "$module")" -eq 2
test "$(grep -c '^@unsafe(reason: "raw monotonic clock ABI", capabilities: \[ffi\])$' "$module")" -eq 1
test "$(grep -c '^extern fn rt_' "$module")" -eq 3
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_transient_array_scope_begin()' "$module")" -eq 1
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_transient_array_scope_end()' "$module")" -eq 1
test "$(grep -c 'unsafe(capabilities: \[ffi\]): rt_time_now_micros()' "$module")" -eq 3
grep -q 'extern fn rt_transient_array_scope_begin() -> bool' "$module"
grep -q 'extern fn rt_transient_array_scope_end() -> bool' "$module"

echo 'App check SFFI authority: PASS declarations=3 lexical_calls=5 bool_contract=preserved direct_call_shape=preserved artifact_admission=absent'
