#!/bin/sh
set -eu

module=src/compiler/80.driver/driver_aot_vhdl_output.spl
facade=src/lib/nogc_sync_mut/io_runtime.spl

if rg -q '^extern fn rt_env_get' "$module"; then
    echo "AOT VHDL must use the canonical environment facade" >&2
    exit 1
fi

test "$(rg -c '^extern fn rt_enum_(discriminant|payload)' "$module")" -eq 2
test "$(rg -c '^fn _driver_vhdl_enum_(discriminant|payload)_raw' "$module")" -eq 2
test "$(rg -c 'unsafe\(capabilities: \[ffi\]\):' "$module")" -eq 2
for symbol in rt_enum_discriminant rt_enum_payload; do
    test "$(rg -c "${symbol}\\(" "$module")" -eq 2
done
test "$(rg -c '_driver_vhdl_enum_discriminant_raw\(' "$module")" -eq 5
test "$(rg -c '_driver_vhdl_enum_payload_raw\(' "$module")" -eq 5
test "$(rg -c 'E-SFFI-017: corrupt VHDL .* discriminant' "$module")" -eq 2
test "$(rg -c 'env_get_opt\("SIMPLE_COMPILER_TRACE"\)' "$module")" -eq 1
rg -Uq '@always_inline\npub fn env_get_opt\(key: text\) -> text\?:' "$facade"
