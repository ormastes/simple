#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/os/tls13/hkdf.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

[ "$(grep -c '^extern fn ' "$module")" -eq 16 ]
[ "$(grep -c '^@unsafe(reason:' "$module")" -eq 20 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 1 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 2 ]
[ "$(grep -c '_hkdf_u8_at(' "$module")" -eq 15 ]
[ "$(grep -c 'rt_bytes_u8_at(' "$module")" -eq 2 ]
[ "$(grep -c 'val label_tail_len = label_tail.len().to_u64()' "$module")" -eq 2 ]
! grep -q '_label_len(' "$module"

call_count=$(perl -0ne '
    s/""".*?"""//sg;
    s/#.*//mg;
    s/^extern fn .*\n//mg;
    while (/\b(?:rt_[a-z0-9_]+|serial_println)\s*\(/g) { $count++ }
    END { print $count + 0 }
' "$module")
[ "$call_count" -eq 16 ]

symbols=$(awk '/^extern fn /{name=$3; sub(/\(.*/, "", name); print name}' "$module")
both=0
one=0
none=0
for symbol in $symbols; do
    providers=0
    grep -q "RuntimeFuncSpec::new(\"$symbol\"" "$registry" && providers=$((providers + 1))
    grep -q "insert_simple!(\"$symbol\"" "$interpreter" && providers=$((providers + 1))
    case "$providers" in
        2) both=$((both + 1)) ;;
        1) one=$((one + 1)) ;;
        0) none=$((none + 1)) ;;
    esac
done
[ "$both" -eq 1 ]
[ "$one" -eq 8 ]
[ "$none" -eq 7 ]

echo "TLS 1.3 HKDF SFFI authority audit: PASS (29 former calls consolidated to 16 direct boundary sites; 16 declarations + 4 unsafe fast-path owners + 2 lexical typed owners; 1 both/8 one/7 no-provider; UTF-8 label byte extent fixed; byte owner mandatory-inline)"
