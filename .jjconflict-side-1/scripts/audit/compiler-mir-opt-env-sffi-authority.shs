#!/bin/sh
set -eu

module=src/compiler/60.mir_opt/mir_opt/mod.spl
facade=src/lib/nogc_sync_mut/io_runtime.spl

if rg -q '^extern fn rt_env_get|rt_env_get\(' "$module"; then
    echo "MIR optimizer must use the canonical environment facade" >&2
    exit 1
fi

test "$(rg -c 'env_get_opt\(key\)' "$module")" -eq 1
test "$(rg -c 'mir_opt_env_get\(' "$module")" -eq 4
test "$(rg -c '_mir_opt_verify_each_cached' "$module")" -eq 5
rg -Uq '@always_inline\npub fn env_get_opt\(key: text\) -> text\?:' "$facade"
