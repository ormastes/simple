#!/bin/sh
set -eu

module=src/compiler/70.backend/build_native.spl
facade=src/lib/nogc_sync_mut/io_runtime.spl

if rg -q '^extern fn rt_' "$module"; then
    echo "native build must use canonical runtime facades, not own raw SFFI" >&2
    exit 1
fi

rg -q '^use std\.io_runtime\.\{mkdir_p, env_get_opt, file_exists\}$' "$module"
test "$(rg -c 'env_get_opt\("SIMPLE_NATIVE_BUILD_CACHE_DIR"\)' "$module")" -eq 1
test "$(rg -c 'file_exists\(cache_path\)' "$module")" -eq 1
rg -Uq '@always_inline\npub fn file_exists\(path: text\) -> bool:' "$facade"
