#!/bin/sh
set -eu

content=src/app/simple_portal/content_db.spl
server=src/app/simple_portal/server.spl

test "$(rg '^extern fn rt_(file_read_text|dir_create)' "$content" "$server" | wc -l)" -eq 0
test "$(rg 'rt_(file_read_text|dir_create)\(' "$content" "$server" | wc -l)" -eq 0
test "$(rg -c 'read_file_text_result\(' "$content")" -eq 6
test "$(rg -c 'read_file_text_result\(' "$server")" -eq 2
rg -q 'if not dir_create\(self.data_root, true\):' "$server"

# Database loading is four reads with no preceding host file-existence probes.
load_body="$(sed -n '/^pub fn portal_content_db_load(/,/^pub fn portal_content_db_resolve_root/p' "$content")"
test "$(printf '%s\n' "$load_body" | rg 'read_file_text_result\(' | wc -l)" -eq 4
test "$(printf '%s\n' "$load_body" | rg 'file_exists\(' | wc -l)" -eq 0
