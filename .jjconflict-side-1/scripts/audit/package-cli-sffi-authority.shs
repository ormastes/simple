#!/bin/sh
set -eu

module=src/app/pkg/main.spl

test "$(rg '^extern fn rt_file_read_text' "$module" | wc -l)" -eq 0
test "$(rg 'rt_file_read_text\(' "$module" | wc -l)" -eq 0
test "$(rg -c '^extern fn rt_cli_get_args\(\)' "$module")" -eq 1
test "$(rg -c 'rt_cli_get_args\(\)' "$module")" -eq 2
rg -q '^fn _pkg_cli_args_raw\(\) -> \[text\]:' "$module"
rg -q 'unsafe\(capabilities: \[ffi\]\):' "$module"

dry_run="$(sed -n '/^fn _print_install_dry_run_json/,/^fn main/p' "$module")"
test "$(printf '%s\n' "$dry_run" | rg 'read_file_text_result\(' | wc -l)" -eq 1
test "$(printf '%s\n' "$dry_run" | rg 'file_exists\(' | wc -l)" -eq 0
