#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/runtime/simple_core/core_process.spl"
cranelift="$root/src/compiler_rust/compiler/src/codegen/instr/calls.rs"
llvm="$root/src/compiler_rust/compiler/src/codegen/llvm/functions/calls.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for raw in exit usleep free spl_load_i64 rt_string_new kill calloc malloc \
    spl_store_i64 spl_store_u8 rt_tuple_set rt_string_data getpid fork execvp \
    waitpid abort time gettimeofday clock_gettime spl_load_u8 rt_array_len \
    rt_array_get_text rt_simple_core_argv_array_new_owned \
    rt_simple_core_argv_array_push_owned rt_tuple_new rt_value_int rt_string_len \
    rt_stderr_write getppid signal setpgid sigpending sigismember sysconf strlen; do
    if [ "$(grep -Ec "(^|[^A-Za-z0-9_])${raw}\\(" "$module")" -ne 2 ]; then
        echo "simple-core process call escaped its mandatory-inline owner: $raw" >&2
        exit 1
    fi
done

[ "$(grep -c '^@always_inline$' "$module")" -eq 36 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi, raw_ptr\]):' "$module")" -eq 18 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module")" -eq 18 ]
for expected in _sffi_exit:10 _sffi_usleep:8 _sffi_free:27 \
    _sffi_load_i64:14 _sffi_rt_string_new:8 _sffi_kill:10; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done
for expected in _sffi_abort:2 _sffi_time:2 _sffi_gettimeofday:2 \
    _sffi_clock_gettime:3 _sffi_load_u8:3 _sffi_rt_array_len:3 \
    _sffi_rt_array_get_text:3 _sffi_argv_array_new:2 \
    _sffi_argv_array_push:2 _sffi_rt_tuple_new:2 _sffi_rt_value_int:2 \
    _sffi_rt_string_len:2 _sffi_rt_stderr_write:2 _sffi_getppid:2 \
    _sffi_signal:2 _sffi_setpgid:3 _sffi_sigpending:2 \
    _sffi_sigismember:2 _sffi_sysconf:2 _sffi_strlen:3; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done
for expected in _sffi_calloc:8 _sffi_malloc:6 _sffi_store_i64:5 \
    _sffi_store_u8:5 _sffi_rt_tuple_set:4 _sffi_rt_string_data:4 \
    _sffi_getpid:4 _sffi_fork:4 _sffi_execvp:4 _sffi_waitpid:7; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done

for intrinsic in spl_load_i64 spl_load_u8 spl_store_i64 spl_store_u8; do
    grep -q "\"$intrinsic\"" "$cranelift"
    grep -q "\"$intrinsic\"" "$llvm"
done
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "simple-core process authority audit: PASS (all 36 used raw operations have mandatory-inline minimal owners)"
