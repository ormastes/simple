#!/bin/sh
set -eu

module=src/compiler/00.common/di.spl

if rg -q '^extern fn rt_' "$module"; then
    echo "compiler DI must use canonical runtime facades, not own raw SFFI" >&2
    exit 1
fi

rg -q '^use std\.io_runtime\.\{env_get_opt\}$' "$module"
test "$(rg -c 'env_get_opt\("SIMPLE_(SYSTEM_TEST|DI_TEST)"\)' "$module")" -eq 2
