#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_async_mut/engine/physics/backend_gpu/gpu_solver.spl"
runtime="$root/src/compiler_rust/runtime/src/cuda_runtime.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern"

if [ "$(grep -c '^extern fn rt_cuda_' "$owner")" -ne 12 ] ||
   [ "$(grep -c '^[[:space:]]*@unsafe(.*capabilities: \[.*ffi' "$owner")" -ne 22 ]; then
    echo "GPU solver CUDA declaration or authority inventory changed without review" >&2
    exit 1
fi

awk '
    function indent(line, copy) {
        copy = line
        sub(/[^ ].*$/, "", copy)
        return length(copy)
    }
    /^[[:space:]]*@unsafe\(.*capabilities: \[.*ffi.*\]\)$/ {
        next_function_unsafe = 1
        next
    }
    /^[[:space:]]*(static fn|fn|me) / {
        function_indent = indent($0)
        function_unsafe = next_function_unsafe
        next_function_unsafe = 0
        inside_function = 1
        next
    }
    inside_function && NF && indent($0) <= function_indent {
        function_unsafe = 0
        inside_function = 0
    }
    /rt_cuda_[A-Za-z0-9_]+\(/ && !/^[[:space:]]*#/ && !/^[[:space:]]*extern fn/ && !function_unsafe {
        print "unscoped GPU solver CUDA call at line " FNR ": " $0 > "/dev/stderr"
        failed = 1
    }
    END { if (failed) exit 1 }
' "$owner"

grep -q '@unsafe(reason: "orchestrates unverified raw CUDA solver operations"' "$owner"

for symbol in \
    rt_cuda_memcpy_h2d \
    rt_cuda_memcpy_d2h \
    rt_cuda_compile_ptx \
    rt_cuda_get_function \
    rt_cuda_synchronize \
    rt_cuda_stream_create \
    rt_cuda_stream_destroy
do
    if grep -R -q -- "$symbol" "$runtime" "$interpreter"; then
        echo "$symbol gained a provider; review the quarantined solver ABI before changing its status" >&2
        exit 1
    fi
done
grep -q 'pub extern "C" fn rt_cuda_launch_kernel(' "$runtime"
grep -q 'func_name_ptr: \*const u8' "$runtime"
grep -q 'extern fn rt_cuda_launch_kernel(func: i64' "$owner"

echo "GPU solver CUDA SFFI authority audit: PASS (12 declarations, 9 raw methods, and solve explicitly unsafe; 7 symbols absent and launch ABI mismatch quarantined)"
