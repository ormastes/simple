#!/bin/sh
# Static raw-file-I/O elimination guard for cross-reference linting.
# This checks source shape only; it does not admit, sign, or verify a provider.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/35.semantics/lint_cross_ref.spl"

test "$(grep -c '^extern fn rt_file_' "$module")" -eq 0
test "$(grep -c '^use std.io_runtime.{dir_list, file_exists, read_file_text_result}$' "$module")" -eq 1
test "$(grep -c 'read_file_text_result(' "$module")" -eq 2
test "$(grep -c 'code: "XREF005"' "$module")" -eq 2
test "$(grep -c '^fn xref_load_requirement_ids() -> Result<\[text\], text>:$' "$module")" -eq 1

echo 'Cross-reference lint SFFI authority: PASS local_raw_declarations=0 result_lifts=2 read_error_diagnostics=2 artifact_admission=absent'
