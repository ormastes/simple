#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/compiler/99.loader/smf_mmap_native.spl"

symbols='rt_file_size rt_mmap_raw rt_munmap_raw rt_mprotect rt_madvise_raw rt_msync_flags rt_mlock rt_munlock rt_open_fd rt_close_fd rt_call_ptr_0 rt_call_ptr_1 rt_call_ptr_2 rt_call_ptr_3 rt_array_data_ptr rt_ptr_write_bytes_raw rt_ptr_write_u8 rt_ptr_write_i32 rt_ptr_write_i64 rt_bytes_from_raw'

for raw in $symbols; do
    [ "$(grep -Ec "^extern fn ${raw}\\(" "$module")" -eq 1 ]
    [ "$(grep -o "${raw}(" "$module" | wc -l)" -eq 2 ]
done

[ "$(grep -c '^@always_inline$' "$module")" -eq 8 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi' "$module")" -eq 20 ]
[ "$(grep -c '^@unsafe(' "$module")" -eq 37 ]
! grep -q '^extern fn rt_page_size' "$module"

# This implementation must retain its existing W^X allocation policy.
grep -q '_sffi_mmap_raw(0, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0)' "$module"
! grep -q 'PROT_READ | PROT_WRITE | PROT_EXEC' "$module"

echo "Top-level SMF mmap SFFI authority audit: PASS (20 raw ABIs confined; 8 mandatory-inline owners; 17 pointer-bearing APIs remain unsafe; W^X retained)"
