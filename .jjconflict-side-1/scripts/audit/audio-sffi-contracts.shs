#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
owner="$root/src/lib/nogc_sync_mut/io/audio_sffi.spl"

declarations=$(grep -c '^[[:space:]]*extern fn ' "$owner")
if [ "$declarations" -ne 39 ]; then
    echo "audio SFFI inventory changed without contract review" >&2
    exit 1
fi
tagged=$(awk '
    /^@unsafe\(.*capabilities: \[ffi\]\)$/ { previous_is_ffi = 1; next }
    /^[[:space:]]*extern fn / {
        if (previous_is_ffi) tagged++
    }
    { previous_is_ffi = 0 }
    END { print tagged + 0 }
' "$owner")
if [ "$tagged" -ne "$declarations" ]; then
    echo "every canonical audio declaration must be explicitly unsafe(ffi)" >&2
    exit 1
fi

echo "audio SFFI contract audit: PASS"
