#!/bin/sh
# Static NFR-SFFI-ACC-001 guard for the provider-loader handoff.
#
# This proves only that loader admission stays in the activation function and
# that session calls reuse cached typed addresses. It intentionally does not
# claim that the separate dynamic ABI marshaller is allocation-free.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
loader="$root/src/os/smf/provider_loader.spl"

body() {
    name=$1
    sed -n "/^fn $name(/,/^fn /p" "$loader"
}

require() {
    pattern=$1
    if ! grep -Fq "$pattern" "$loader"; then
        echo "FAIL: provider admission handoff is missing: $pattern" >&2
        exit 1
    fi
}

reject_in_session() {
    name=$1
    forbidden=$2
    if body "$name" | grep -Eq "$forbidden"; then
        echo "FAIL: $name gained load-time admission work: $forbidden" >&2
        exit 1
    fi
}

require 'enum ProviderAdmissionOutcomeV1:'
require 'outcome: ProviderAdmissionOutcomeV1'
require 'fn provider_admission_outcome_v1(status: i32) -> ProviderAdmissionOutcomeV1:'
require 'outcome: provider_admission_outcome_v1(status)'
require 'me is_admitted() -> bool:'
require 'PROVIDER_ADMISSION_DIGEST_UNSTABLE'

# All artifact reads, hashing, loader open, and name resolution remain in the
# cold activation owner. Session calls receive the already admitted slots.
admission=$(body provider_admit_dynamic_v1)
printf '%s\n' "$admission" | grep -Fq 'rt_file_read_bytes('
printf '%s\n' "$admission" | grep -Fq 'provider_artifact_digest_v1('
printf '%s\n' "$admission" | grep -Fq 'dynlib_open('
printf '%s\n' "$admission" | grep -Fq 'dynlib_symbol('
post_open=$(printf '%s\n' "$admission" | sed -n '/dynlib_open(/,$p')
printf '%s\n' "$post_open" | grep -Fq 'provider_artifact_digest_v1(rt_file_read_bytes(request.artifact_path))'
printf '%s\n' "$post_open" | grep -Fq 'PROVIDER_ADMISSION_DIGEST_UNSTABLE'
printf '%s\n' "$post_open" | grep -Fq 'dynlib_close(library)'

query=$(body provider_session_query_v1)
printf '%s\n' "$query" | grep -Fq 'call_provider_query_v1(session.admission.query_symbol_address, request)'
invoke=$(body provider_session_invoke_cli_v1)
printf '%s\n' "$invoke" | grep -Fq 'call_cli_command_v1(session.cli_invoke_symbol_address,'

for name in provider_session_query_v1 provider_session_invoke_cli_v1; do
    reject_in_session "$name" 'rt_file_|sha256|provider_artifact_digest|dynlib_open|dynlib_symbol|provider_admit_dynamic|sffi-evidence|[Ll]ock|[Rr]etry|dynlib_call_[0-9]'
done

# Build/audit scripts may produce receipts, but a runtime source module must
# never invoke those scripts on an admitted foreign call.
if rg -n 'scripts/audit/(sffi-evidence-admission|sffi-contract-inventory|rt-safety-census)' "$root/src" >/dev/null; then
    echo 'FAIL: runtime source references a load-time SFFI audit script' >&2
    exit 1
fi

echo 'PASS: provider admission handoff keeps typed outcome and cached loader slots; dynamic ABI marshalling allocation remains separately unverified'
