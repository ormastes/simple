#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/runtime/simple_core/core_env.spl"
native="$root/src/runtime/runtime_native.c"
rust="$root/src/compiler_rust/runtime/src/value/sffi/env_process.rs"
cranelift="$root/src/compiler_rust/compiler/src/codegen/instr/calls.rs"
llvm="$root/src/compiler_rust/compiler/src/codegen/llvm/functions/calls.rs"
llvm_attrs="$root/src/compiler_rust/compiler/src/codegen/llvm/backend_core.rs"
selfhost_inline="$root/src/compiler/60.mir_opt/mir_opt/_Inline/policy.spl"

for raw in getenv setenv getcwd malloc free strlen rt_string_new \
    spl_load_u8 spl_store_u8; do
    if [ "$(grep -Ec "(^|[^A-Za-z0-9_])${raw}\\(" "$module")" -ne 2 ]; then
        echo "simple-core environment call escaped its mandatory-inline owner: $raw" >&2
        exit 1
    fi
done

[ "$(grep -c '^@unsafe(' "$module")" -eq 9 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 9 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi, raw_ptr\]):' "$module")" -eq 9 ]
for expected in _sffi_getenv:2 _sffi_setenv:2 _sffi_getcwd:2 \
    _sffi_malloc:3 _sffi_free:8 _sffi_strlen:3 \
    _sffi_rt_string_new:3 _sffi_load_u8:2 _sffi_store_u8:3; do
    owner=${expected%%:*}
    count=${expected##*:}
    [ "$(grep -o "${owner}(" "$module" | wc -l)" -eq "$count" ]
done

grep -q 'if key_len < 1:' "$module"
grep -q 'if byte == 0:' "$module"
[ "$(grep -c 'return 3' "$module")" -ge 4 ]
grep -q 'if (!value) return rt_core_nil();' "$native"
grep -A8 'fn rt_env_get(name_ptr' "$rust" | grep -q 'RuntimeValue::NIL'
for intrinsic in spl_load_u8 spl_store_u8; do
    grep -q "\"$intrinsic\"" "$cranelift"
    grep -q "\"$intrinsic\"" "$llvm"
done
grep -q 'attr == "inline" || attr == "always_inline"' "$llvm_attrs"
grep -q 'func.name.contains("@always_inline")' "$selfhost_inline"

echo "simple-core environment authority audit: PASS (all calls confined; missing/failure is nil, present empty remains empty text, embedded NUL rejected)"
