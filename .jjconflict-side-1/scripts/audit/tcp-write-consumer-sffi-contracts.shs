#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
ssh="$root/src/os/tools/net/_SshTool/transport.spl"
async="$root/src/lib/nogc_async_mut/io/driver.spl"
provider="$root/src/runtime/runtime_native.c"
registry="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

for owner in "$ssh" "$async"; do
    awk '
        function indent(line, copy) {
            copy = line
            sub(/[^ ].*$/, "", copy)
            return length(copy)
        }
        /unsafe\(capabilities: \[.*ffi.*\]\):[[:space:]]*$/ {
            unsafe_indent = indent($0)
            inside_unsafe = 1
            next
        }
        inside_unsafe && NF && indent($0) <= unsafe_indent { inside_unsafe = 0 }
        /rt_io_tcp_write(_bytes)?\(/ && !/^[[:space:]]*extern fn / && !inside_unsafe {
            print "unscoped TCP byte write at line " FNR ": " $0 > "/dev/stderr"
            failed = 1
        }
        END { if (failed) exit 1 }
    ' "$owner"
done

grep -B1 '^extern fn rt_io_tcp_write(fd:' "$ssh" | grep -q '@unsafe(.*capabilities: \[ffi\])'
grep -B1 '^extern fn rt_io_tcp_write_bytes(fd:' "$async" | grep -q '@unsafe(.*capabilities: \[ffi\])'
grep -q 'if written > data.len():' "$ssh"
grep -q 'int64_t rt_io_tcp_write_bytes(int64_t fd, int64_t data_val)' "$provider"
grep -q 'insert_simple!("rt_io_tcp_write_bytes", interpreter_native_net::rt_io_tcp_write_interp)' "$registry"

write_body=$(sed -n '/^int64_t rt_io_tcp_write(int64_t fd/,/^}/p' "$provider")
if printf '%s\n' "$write_body" | grep -Eq 'malloc|calloc|realloc|pthread_|mutex'; then
    echo "native TCP byte write must remain allocation- and lock-free" >&2
    exit 1
fi

echo "TCP byte-write consumer SFFI audit: PASS (two minimal authorities; typed C/interpreter providers retained)"
