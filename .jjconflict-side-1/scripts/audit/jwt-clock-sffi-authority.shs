#!/bin/sh
# Static cross-lane authority gate for JWT and password-reset clock failure.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
claims="$root/src/lib/common/jwt/claims.spl"
auth="$root/src/lib/nogc_sync_mut/web_framework/auth_middleware.spl"
reset="$root/src/lib/nogc_sync_mut/web_framework/password_reset.spl"
runtime="$root/src/runtime/runtime_time.c"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/time.rs"

grep -Fq 'extern fn rt_time_now_unix_micros() -> i64' "$claims"
grep -Fq 'fn current_timestamp() -> Result<i64, text>:' "$claims"
grep -Fq 'return Err("JWT clock unavailable")' "$claims"
! grep -Fq 'rt_time_now_seconds' "$claims"

raw_calls=$(awk '
    /unsafe\(capabilities: \[ffi\]\):/ { pending=1; next }
    pending && /^[[:space:]]+rt_time_now_unix_micros/ { count++; pending=0; next }
    pending { pending=0 }
    END { print count + 0 }
' "$claims")
test "$raw_calls" -eq 1

test "$(grep -Fh 'match current_timestamp():' "$auth" "$reset" | wc -l | tr -d ' ')" -eq 3
grep -Fq 'int64_t rt_time_now_unix_micros(void)' "$runtime"
grep -Fq 'pub fn rt_time_now_unix_micros' "$interpreter"

echo 'JWT clock SFFI authority: PASS integer_cross_lane_abi=shared lexical_raw_calls=1 failure=typed_result no_extra_clock_read=1'
