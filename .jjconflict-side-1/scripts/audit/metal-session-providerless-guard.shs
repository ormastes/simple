#!/bin/sh
# The legacy no-GC Metal compute session is cache bookkeeping only. Keep the
# providerless execution ABI absent; the active GC Metal owner is separate.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
source="$root/src/lib/nogc_sync_mut/gpu/engine2d/metal_session.spl"

test "$(grep -c '^extern fn ' "$source")" -eq 0
! grep -Eq '^[[:space:]]*.*rt_engine2d_metal_session_[A-Za-z0-9_]*\(' "$source"
grep -q 'contains no SFFI boundary' "$source"
grep -q 'class MetalPipelineCache:' "$source"
grep -q 'class MetalComputeSession:' "$source"

echo 'Metal session providerless guard: PASS (pure bounded cache; no raw Metal externs)'
