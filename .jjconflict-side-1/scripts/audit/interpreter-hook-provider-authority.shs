#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)

for source in \
    "$root/src/lib/nogc_sync_mut/dap/hooks.spl" \
    "$root/src/lib/nogc_async_mut/dap/hooks.spl" \
    "$root/src/compiler/90.tools/sffi_gen/specs/interpreter_hooks.spl"; do
    declarations=$(grep -c '^extern fn rt_hook_' "$source")
    tagged=$(grep -B1 '^extern fn rt_hook_' "$source" | grep -c '^@unsafe(reason: "unimplemented interpreter debug-hook provider", capabilities: \[ffi\])$')
    test "$declarations" -eq 14
    test "$tagged" -eq "$declarations"
done

gap="$root/src/compiler_rust/compiler/src/interpreter_extern/capability_gap.rs"
grep -q '("rt_hook_", "rt_hook")' "$gap"
grep -q 'fn matches_all_six_families' "$gap"
grep -q '"rt_hook_pause"' "$gap"

echo 'interpreter hook provider authority: PASS (all raw hook declarations tagged; unavailable provider maps to capability gap)'
