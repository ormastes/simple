#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
module="$root/src/lib/nogc_sync_mut/sffi/runtime.spl"
registry="$root/src/compiler_rust/compiler/src/codegen/runtime_sffi.rs"
interpreter="$root/src/compiler_rust/compiler/src/interpreter_extern/mod.rs"

[ "$(grep -c '^extern fn ' "$module")" -eq 11 ]
[ "$(grep -c '^@always_inline$' "$module")" -eq 11 ]
[ "$(grep -c '^@unsafe(reason: "raw runtime-value handle or pointer contract remains caller-owned"' "$module")" -eq 11 ]
[ "$(grep -c 'unsafe(capabilities: \[ffi\]):' "$module" || true)" -eq 0 ]

symbols=$(sed -n 's/^extern fn \([A-Za-z0-9_]*\)(.*/\1/p' "$module")
both=0
one=0
none=0
for symbol in $symbols; do
    providers=0
    grep -q "RuntimeFuncSpec::new(\"$symbol\"" "$registry" && providers=$((providers + 1))
    grep -q "insert_simple!(\"$symbol\"" "$interpreter" && providers=$((providers + 1))
    case "$providers" in
        2) both=$((both + 1)) ;;
        1) one=$((one + 1)) ;;
        0) none=$((none + 1)) ;;
    esac
done
[ "$both" -eq 11 ]
[ "$one" -eq 0 ]
[ "$none" -eq 0 ]

# Semantic booleans remain booleans; no numeric workaround is admitted.
grep -q '^fn value_is_bool(value: RuntimeValuePtr) -> bool:' "$module"
for symbol in rt_value_as_bool rt_value_is_nil rt_value_is_int rt_value_is_float rt_value_is_bool; do
    grep -q "RuntimeFuncSpec::new(\"$symbol\", &\[I64\], &\[I8\])" "$registry"
done
for removed in rt_value_array_new rt_value_dict_new value_array_new value_dict_new \
    rt_value_is_string rt_value_is_array rt_value_is_dict rt_value_as_string \
    rt_value_clone value_is_string value_is_array value_is_dict value_as_string \
    value_clone; do
    ! grep -R -q -w "$removed" \
        "$root/src/lib/nogc_sync_mut/sffi/runtime.spl" \
        "$root/src/lib/nogc_async_mut/sffi/runtime.spl" \
        "$root/src/compiler/70.backend" \
        "$root/src/compiler/90.tools/sffi_gen/specs" \
        "$root/src/app/ffi_gen.specs"
done
for retired in rt_gc_init rt_gc_collect rt_gc_malloc gc_init gc_collect \
    gc_malloc rt_value_string rt_value_type rt_value_free rt_value_add \
    rt_value_sub rt_value_mul rt_value_div rt_value_lt value_string \
    value_string_from_text value_type value_free value_add value_sub value_mul \
    value_div value_lt rt_value_eq rt_print_value rt_println_value value_eq \
    value_print value_println; do
    ! grep -R -q -w "$retired" \
        "$root/src/lib/nogc_sync_mut/sffi/runtime.spl" \
        "$root/src/lib/nogc_async_mut/sffi/runtime.spl" \
        "$root/src/compiler/70.backend/sffi_minimal.spl" \
        "$root/src/compiler/70.backend/__init__.spl" \
        "$root/src/compiler/90.tools/sffi_gen/specs/runtime_value.spl" \
        "$root/src/app/ffi_gen.specs/runtime_value.spl" \
        "$root/src/lib/nogc_async_mut/mcp/fileio_main.spl" \
        "$root/src/lib/nogc_async_mut/mcp/jj/main.spl" \
        "$root/src/lib/nogc_sync_mut/mcp/jj/main.spl"
done

echo "runtime-value SFFI authority audit: PASS (11 raw declarations; 11 unsafe handle facades; 11 both/0 one/0 no-provider; all mandatory-inline)"
