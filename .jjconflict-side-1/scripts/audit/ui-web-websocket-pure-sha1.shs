#!/bin/sh
set -eu

source_file=src/app/ui.web/ws_handler.spl
owner=src/lib/nogc_sync_mut/websocket/handshake.spl

rg -q 'use std\.nogc_sync_mut\.websocket\.handshake\.\{compute_websocket_accept\}' "$source_file"
test "$(rg -c '^[[:space:]]+compute_websocket_accept\(key\)$' "$source_file")" -eq 1
rg -q '^fn compute_websocket_accept\(key: text\) -> text:$' "$owner"

! rg -q 'extern fn rt_sha1_|rt_sha1_(new|write|finish|free)\(' "$source_file"
! rg -q '\?\? (0|"")' "$source_file"

rg -q 'use std\.nogc_sync_mut\.io\.time_ops\.\{current_time_ms\}' "$source_file"
time_wrapper="$(sed -n '/^fn ui_web_ws_time_ms/,/^$/p' "$source_file")"
test "$(printf '%s\n' "$time_wrapper" | rg -c 'current_time_ms\(\)')" -eq 1
! rg -q 'extern fn rt_' "$source_file"

echo "UI WebSocket crypto audit: PASS (pure-Simple SHA-1/base64 and canonical time owners; no local raw SFFI/fabricated fallback)"
