#!/usr/bin/env bash
# macos-gui-run.shs â run a Simple GUI program in a real on-screen window on macOS.
#
# Why this exists: a bare CLI process is never registered with the macOS window
# server, so an interpreter-driven winit window is created but never composites
# (lsappinfo shows it unregistered). Launching from a proper .app bundle via
# LaunchServices registers the process in the Aqua session, after which the window
# displays. (The Simple program must also poll the event loop continuously rather
# than rt_thread_sleep â see examples/06_io/ui/web_engine2d_gui.spl.)
# See doc/08_tracking/bug/macos_winit_window_not_displayed_2026-05-28.md.
#
# Usage: scripts/macos-gui-run.shs <file.spl|file.smf> [program args...]
set -euo pipefail

strict_evidence="${SIMPLE_GUI_STRICT_EVIDENCE:-0}"
no_bootstrap_delegate="${SIMPLE_NO_BOOTSTRAP_DELEGATE:-0}"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"

manifest_value() {
  local key="$1"
  local manifest="$2"
  local count
  count="$(grep -c "^${key}=" "$manifest" 2>/dev/null || true)"
  [[ "$count" = "1" ]] || return 1
  sed -n "s/^${key}=//p" "$manifest"
}

canonical_path() {
  local path="$1"
  cd -P "$(dirname "$path")" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$path")"
}

sha256_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    sha256sum "$1" | awk '{print $1}'
  fi
}

has_winit_marker() {
  LC_ALL=C grep -aq -e "rt_winit_event_loop_new" -e "window_winitmodule.smf" "$1"
}

is_forbidden_strict_binary() {
  case "$1" in
    */simple_seed|*/simple_seed/*|*/src/compiler_rust/*|\
    */stage3/*|*/debug/*|*/test/02_integration/rendering/*live_harness*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

strict_contract_error() {
  echo "error: strict GUI evidence: $*" >&2
  return 1
}

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "macos-gui-run.shs is macOS-only; on Linux/Windows run the gui driver directly." >&2
  exit 1
fi

program="${1:-$repo_root/src/os/hosted/hosted_entry.spl}"
if [[ $# -gt 0 ]]; then shift; fi
program="$(cd "$(dirname "$program")" && pwd)/$(basename "$program")"
if [[ ! -f "$program" ]]; then echo "error: file not found: $program" >&2; exit 1; fi
case "$program" in
  *.spl|*.smf) ;;
  *) echo "error: expected a .spl source or compiled .smf artifact: $program" >&2; exit 1 ;;
esac

program_args=()
for arg in "$@"; do
  if [[ -f "$arg" ]]; then
    program_args+=("$(cd "$(dirname "$arg")" && pwd)/$(basename "$arg")")
  elif [[ -f "$repo_root/$arg" ]]; then
    program_args+=("$repo_root/$arg")
  else
    program_args+=("$arg")
  fi
done

# Locate a GUI-enabled driver (contains the winit runtime).
is_rust_seed_simple() {
  case "$1" in
    */src/compiler_rust/*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

strict_admitted_gui_driver=""
strict_admitted_gui_driver_hash=""
strict_admitted_manifest=""
strict_admitted_manifest_hash=""
strict_admitted_gui_driver_source_kind=""

assert_strict_admitted_inputs_unchanged() {
  [[ -n "${MACOS_GPU_ADMISSION_GUI_DRIVER_SHA256:-}" ]] || return 1
  [[ -n "${MACOS_GPU_ADMISSION_MANIFEST_SHA256:-}" ]] || return 1
  [[ "$(sha256_file "$strict_admitted_gui_driver")" = \
      "$MACOS_GPU_ADMISSION_GUI_DRIVER_SHA256" ]] || return 1
  [[ "$(sha256_file "$strict_admitted_manifest")" = \
      "$MACOS_GPU_ADMISSION_MANIFEST_SHA256" ]] || return 1
}

admit_strict_runtime() {
  local backend="${SIMPLE_GUI_BACKEND:-}"
  local helper="$repo_root/scripts/check/lib/macos-gpu-trusted-build-admission.shs"
  local platform
  case "$backend" in
    vulkan|metal) ;;
    *) return 1 ;;
  esac
  case "$(uname -m):$(uname -s)" in
    arm64:Darwin|aarch64:Darwin) platform=aarch64-apple-darwin ;;
    x86_64:Darwin) platform=x86_64-apple-darwin ;;
    *) return 1 ;;
  esac
  strict_admitted_manifest="${SIMPLE_GUI_TRUSTED_MANIFEST_PATH:-$repo_root/build/bootstrap/full/$platform/provenance/gui-driver.env}"
  [[ -f "$helper" && ! -L "$helper" ]] || return 1
  # shellcheck source=../check/lib/macos-gpu-trusted-build-admission.shs
  . "$helper"
  macos_gpu_full_cli_gui_admit \
    "$strict_admitted_manifest" "$repo_root" || return 1
  strict_admitted_gui_driver="$MACOS_GPU_ADMISSION_GUI_DRIVER"
  strict_admitted_gui_driver_hash="$MACOS_GPU_ADMISSION_GUI_DRIVER_SHA256"
  strict_admitted_manifest_hash="$MACOS_GPU_ADMISSION_MANIFEST_SHA256"
  strict_admitted_gui_driver_source_kind="$MACOS_GPU_ADMISSION_GUI_DRIVER_SOURCE_KIND"
  assert_strict_admitted_inputs_unchanged || return 1
  [[ "${SIMPLE_GUI_BINARY:-}" = "$strict_admitted_gui_driver" ]] || return 1
}

resolve_gui_binary() {
  local override_candidate
  if [[ "$strict_evidence" = "1" ]]; then
    [[ -n "${SIMPLE_GUI_BINARY:-}" ]] || return 1
    [[ -f "$SIMPLE_GUI_BINARY" && -x "$SIMPLE_GUI_BINARY" && ! -L "$SIMPLE_GUI_BINARY" ]] || return 1
    [[ "${SIMPLE_GUI_ALLOW_RUST_DRIVER:-0}" != "1" ]] || return 1
    override_candidate="$(canonical_path "$SIMPLE_GUI_BINARY")" || return 1
    [[ "$SIMPLE_GUI_BINARY" = "$override_candidate" ]] || return 1
    [[ "$override_candidate" = "$strict_admitted_gui_driver" ]] || return 1
    [[ "$(sha256_file "$override_candidate")" = \
        "$strict_admitted_gui_driver_hash" ]] || return 1
    is_forbidden_strict_binary "$override_candidate" && return 1
    has_winit_marker "$override_candidate" || return 1
    echo "$override_candidate"
    return 0
  fi

  for override_candidate in "${SIMPLE_GUI_BINARY:-}" "${SIMPLE_BIN:-}"; do
    if [ -n "$override_candidate" ] && [ -x "$override_candidate" ]; then
      if has_winit_marker "$override_candidate"; then
        if is_rust_seed_simple "$override_candidate"; then
          return 1
        fi
        echo "$override_candidate"
        return 0
      fi
    fi
  done

  local c
  for c in \
    "$repo_root/bin/simple" \
    "$repo_root/bin/release/"*"/simple" \
    "$repo_root/release/"*"/simple" \
    "$repo_root/build/bootstrap/stage3/simple"; do
    if [ -e "$c" ] && [ -x "$c" ] && has_winit_marker "$c"; then
      echo "$c"
      return 0
    fi
  done

  if [ "${SIMPLE_GUI_ALLOW_RUST_DRIVER:-0}" = "1" ]; then
    for c in \
      "$repo_root/src/compiler_rust/target/gui/release/simple" \
      "$repo_root/src/compiler_rust/target/gui/debug/simple"; do
      if [ -x "$c" ] && has_winit_marker "$c"; then
        echo "$c"
        return 0
      fi
    done
  fi

  return 1
}

if [[ "$strict_evidence" = "1" ]]; then
  admit_strict_runtime ||
    strict_contract_error "trusted manifest admission failed for SIMPLE_GUI_BINARY"
  assert_strict_admitted_inputs_unchanged ||
    strict_contract_error "admitted driver or manifest changed after admission"
fi

gui_bin="$(resolve_gui_binary)" || {
  if [[ "$strict_evidence" = "1" ]]; then
    strict_contract_error "requires the exact admitted canonical full-CLI driver hash (not seed/debug/Rust/stage3), with SIMPLE_GUI_ALLOW_RUST_DRIVER unset"
    exit 1
  fi
  if [ -n "${SIMPLE_GUI_BINARY:-${SIMPLE_BIN:-}}" ]; then
    selected="${SIMPLE_GUI_BINARY:-${SIMPLE_BIN:-}}"
    if is_rust_seed_simple "$selected"; then
      echo "error: SIMPLE_GUI_BINARY/SIMPLE_BIN points to forbidden rust-seed driver: $selected" >&2
      echo "set SIMPLE_GUI_ALLOW_RUST_DRIVER=1 for compatibility fallback if needed." >&2
    elif [ -n "$selected" ] && [ -x "$selected" ]; then
      echo "error: SIMPLE_GUI_BINARY/SIMPLE_BIN points to non-WINIT driver: $selected" >&2
    else
      echo "error: SIMPLE_GUI_BINARY/SIMPLE_BIN is not executable: $selected" >&2
    fi
  fi
  echo "error: no GUI-enabled pure-simple driver found." >&2
  echo "build one: (cd \"$repo_root/src/compiler_rust\" && CARGO_TARGET_DIR=target/gui cargo build -p simple-driver --features gui)" >&2
  echo "or provide SIMPLE_GUI_BINARY pointing to a GUI-enabled executable." >&2
  exit 1
}

gui_bin="$(canonical_path "$gui_bin")"
if [[ "$strict_evidence" = "1" ]]; then
  [[ -f "$gui_bin" && -x "$gui_bin" && ! -L "$gui_bin" ]] || strict_contract_error "selected binary is not a non-symlink regular executable"
  is_forbidden_strict_binary "$gui_bin" && strict_contract_error "forbidden selected binary: $gui_bin"
  [[ "${SIMPLE_GUI_ALLOW_RUST_DRIVER:-0}" != "1" ]] || strict_contract_error "SIMPLE_GUI_ALLOW_RUST_DRIVER=1 is forbidden"
fi
selected_binary_hash="$(sha256_file "$gui_bin")"

# Build a throwaway .app bundle whose executable IS the driver (self-contained),
# so LaunchServices registers it. An exec-wrapper does NOT work (de-registers).
tmp_root="$(cd "$(mktemp -d)" && pwd -P)"
app="$tmp_root/SimpleGui.app"
mkdir -p "$app/Contents/MacOS"
cp "$gui_bin" "$app/Contents/MacOS/SimpleGui"
app_executable="$(canonical_path "$app/Contents/MacOS/SimpleGui")"
bundled_binary_hash="$(sha256_file "$app_executable")"
if [[ "$strict_evidence" = "1" ]]; then
  assert_strict_admitted_inputs_unchanged ||
    strict_contract_error "admitted driver or manifest changed before launch"
  [[ "$(sha256_file "$gui_bin")" = "$selected_binary_hash" ]] || strict_contract_error "selected binary changed during bundle copy"
  [[ "$selected_binary_hash" = "$bundled_binary_hash" ]] || strict_contract_error "bundled binary hash differs from selected binary"
fi
case "$no_bootstrap_delegate" in
  0|1) ;;
  *) strict_contract_error "SIMPLE_NO_BOOTSTRAP_DELEGATE must equal 0 or 1" ;;
esac
if [[ "$strict_evidence" = "1" && "$no_bootstrap_delegate" != "1" ]]; then
  strict_contract_error "SIMPLE_NO_BOOTSTRAP_DELEGATE must equal 1"
fi
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>SimpleGui</string>
  <key>CFBundleIdentifier</key><string>com.simple.gui.run.$$</string>
  <key>CFBundleName</key><string>SimpleGui</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSEnvironment</key>
  <dict>
    <key>SIMPLE_GUI</key><string>1</string>
    <key>SIMPLE_NO_BOOTSTRAP_DELEGATE</key><string>$no_bootstrap_delegate</string>
    <key>SIMPLE_EXECUTION_MODE</key><string>interpret</string>
    <key>SIMPLE_NO_DEPRECATED_WARNINGS</key><string>${SIMPLE_NO_DEPRECATED_WARNINGS:-1}</string>
    <key>SIMPLE_LIB</key><string>${SIMPLE_LIB:-$repo_root/src}</string>
    <key>SIMPLE_ASSET_ROOT</key><string>${SIMPLE_ASSET_ROOT:-$repo_root}</string>
    <!-- GUI sessions are intentionally long-lived. A positive example timeout
         makes the driver fork an unregistered child, which cannot own an Aqua
         window. Callers that launch a compiled non-example artifact may still
         opt into a bounded timeout explicitly. -->
    <key>SIMPLE_TIMEOUT_SECONDS</key><string>${SIMPLE_TIMEOUT_SECONDS:-0}</string>
    <key>SIMPLE_EVT_LOG</key><string>${SIMPLE_EVT_LOG:-}</string>
    <key>SIMPLE_DIAG</key><string>${SIMPLE_DIAG:-}</string>
    <key>SIMPLE_DIAG_FILE</key><string>${SIMPLE_DIAG_FILE:-}</string>
    <key>SIMPLE_GUI_EVENT_EVIDENCE_PATH</key><string>${SIMPLE_GUI_EVENT_EVIDENCE_PATH:-}</string>
    <key>SIMPLE_GUI_BACKEND</key><string>${SIMPLE_GUI_BACKEND:-}</string>
    <key>SIMPLE_GUI_EXIT_AFTER_INTERACTION</key><string>${SIMPLE_GUI_EXIT_AFTER_INTERACTION:-}</string>
    <key>SIMPLE_ONE_CALL_UPLOAD</key><string>${SIMPLE_ONE_CALL_UPLOAD:-1}</string>
    <key>SIMPLE_ONE_CALL_READBACK</key><string>${SIMPLE_ONE_CALL_READBACK:-1}</string>
    <key>SHOWCASE_RESOLUTION</key><string>${SHOWCASE_RESOLUTION:-}</string>
    <key>SHOWCASE_DPI</key><string>${SHOWCASE_DPI:-}</string>
    <key>VK_ICD_FILENAMES</key><string>${VK_ICD_FILENAMES:-}</string>
    <key>DYLD_LIBRARY_PATH</key><string>${DYLD_LIBRARY_PATH:-}</string>
  </dict>
</dict>
</plist>
PLIST

echo "launching $program as $app ..."
echo "app stdout: $app/../launch.out  stderr: $app/../launch.err"
if [[ "${#program_args[@]}" -gt 0 ]]; then
  open -n --stdout "$app/../launch.out" --stderr "$app/../launch.err" "$app" --args run "$program" --no-daemon "${program_args[@]}"
else
  open -n --stdout "$app/../launch.out" --stderr "$app/../launch.err" "$app" --args run "$program" --no-daemon
fi

# This lookup only connects the LaunchServices bundle to its visible window for
# capture ownership.  Delegation/non-delegation evidence is established earlier
# by the EndpointSecurity execution-history receipt, never by this ps query.
find_exact_app_pid() {
  ps -axo pid=,command= | awk -v executable="$app_executable" '
    {
      pid = $1
      $1 = ""
      sub(/^[[:space:]]+/, "")
      if ($0 == executable || index($0, executable " ") == 1) {
        print pid
        exit
      }
    }
  '
}

pid_executable() {
  ps -p "$1" -o command= | awk '{print $1}'
}

find_window_owner_pid() {
  osascript - "$1" <<'OSA' 2>/dev/null
on run argv
set targetPid to (item 1 of argv) as integer
tell application "System Events"
  repeat with proc in (processes whose unix id is targetPid)
    tell proc
      if (count of windows) > 0 then
        return (unix id) as text
      end if
    end tell
  end repeat
end tell
error "SimpleGui window not ready"
end run
OSA
}

# `open` does not return the launched process id. Resolve it only through this
# invocation's unique temporary executable path, then publish that immutable
# identity for evidence wrappers. A bundle-name lookup can select another
# concurrent SimpleGui instance and invalidate all following input/capture proof.
launched_pid=""
for _ in $(seq 1 100); do
  launched_pid="$(find_exact_app_pid)"
  if [[ -n "$launched_pid" ]]; then
    break
  fi
  sleep 0.1
done
if [[ -z "$launched_pid" ]]; then
  echo "error: launched SimpleGui process not found for $app_executable" >&2
  exit 1
fi

launcher_pid="$launched_pid"
launcher_executable="$(pid_executable "$launcher_pid")"
window_owner_pid=""
window_owner_executable=""
if [[ "$strict_evidence" = "1" ]]; then
  [[ "$launcher_executable" = "$app_executable" ]] || strict_contract_error "launcher executable is not the bundled SimpleGui binary"
  for _ in $(seq 1 60); do
    window_owner_pid="$(find_window_owner_pid "$launcher_pid" || true)"
    if [[ -n "$window_owner_pid" ]]; then break; fi
    sleep 1
  done
  [[ "$window_owner_pid" = "$launcher_pid" ]] || strict_contract_error "launcher PID does not own the window"
  window_owner_executable="$(pid_executable "$window_owner_pid")"
  [[ "$window_owner_executable" = "$app_executable" ]] || strict_contract_error "window owner executable is not the bundled SimpleGui binary"
fi

echo "app pid: $launched_pid  executable: $app_executable"
if [[ -n "${SIMPLE_GUI_LAUNCHED_PID_PATH:-}" ]]; then
  pid_record_tmp="${SIMPLE_GUI_LAUNCHED_PID_PATH}.tmp.$$"
  {
    printf 'schema=macos_gui_run_pid_receipt_v3\n'
    printf 'strict_evidence=%s\n' "$strict_evidence"
    printf 'selected_source=%s\n' "$gui_bin"
    printf 'bundled_executable=%s\n' "$app_executable"
    printf 'selected_binary_hash=%s\n' "$selected_binary_hash"
    printf 'bundled_binary_hash=%s\n' "$bundled_binary_hash"
    printf 'trusted_manifest=%s\n' "$strict_admitted_manifest"
    printf 'trusted_manifest_hash=%s\n' "$strict_admitted_manifest_hash"
    printf 'trusted_gui_driver_source_kind=%s\n' "$strict_admitted_gui_driver_source_kind"
    printf 'trusted_gui_driver_sha256=%s\n' "$strict_admitted_gui_driver_hash"
    printf 'launched_pid=%s\n' "$launched_pid"
    printf 'launched_executable=%s\n' "$app_executable"
    printf 'launcher_pid=%s\n' "$launcher_pid"
    printf 'launcher_executable=%s\n' "$launcher_executable"
    printf 'window_owner_pid=%s\n' "$window_owner_pid"
    printf 'window_owner_executable=%s\n' "$window_owner_executable"
    printf 'launched_bundle=%s\n' "$app"
    printf 'launched_high_resolution_capable=true\n'
  } >"$pid_record_tmp"
  mv "$pid_record_tmp" "$SIMPLE_GUI_LAUNCHED_PID_PATH"
fi

if [[ "${SIMPLE_GUI_RUN_SKIP_NUDGE:-0}" = "1" ]]; then
  exit 0
fi

# winit may place small windows off-screen on multi-display macOS setups; nudge
# the exact launched process window on-screen once it appears.
for _ in $(seq 1 60); do
  if osascript - "$launched_pid" <<'OSA' >/dev/null 2>&1; then
on run argv
set targetPid to (item 1 of argv) as integer
tell application "System Events"
  repeat with proc in (processes whose unix id is targetPid)
    tell proc
      if (count of windows) > 0 then
        set position of window 1 to {200, 120}
        set frontmost to true
        return true
      end if
    end tell
  end repeat
end tell
error "SimpleGui window not ready"
end run
OSA
    break
  fi
  sleep 1
done
