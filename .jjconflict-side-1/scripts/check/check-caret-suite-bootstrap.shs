#!/bin/sh
# Bootstrap-owned LLM Caret suite gates. Never run from the push hook.
set -u

ROOT=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd -P)
SIMPLE=${SIMPLE_BINARY:-$ROOT/bin/simple}
STAGE4_PROVENANCE=${CARET_STAGE4_PROVENANCE:-}
GATE=""

results_are_green() {
    _results_file=$1
    _expected_total=$2
    _results_prefix_count=$(grep -c '^Results:' "$_results_file" || true)
    _summary_count=$(grep -Ec '^Results: [0-9]+ total, [0-9]+ passed, [0-9]+ failed$' "$_results_file" || true)
    [ "$_results_prefix_count" -eq 1 ] && [ "$_summary_count" -eq 1 ] || return 1
    _results_line=$(grep -E '^Results: [0-9]+ total, [0-9]+ passed, [0-9]+ failed$' "$_results_file")
    _counts=$(printf '%s\n' "$_results_line" | sed -n 's/^Results: \([0-9][0-9]*\) total, \([0-9][0-9]*\) passed, \([0-9][0-9]*\) failed$/\1 \2 \3/p')
    set -- $_counts
    [ "$#" -eq 3 ] && [ "$1" -eq "$_expected_total" ] && [ "$1" -gt 0 ] && [ "$1" -eq "$2" ] && [ "$3" -eq 0 ]
}

self_test_results_parser() {
    _parser_tmp=$(mktemp -d) || return 2
    trap 'rm -rf "$_parser_tmp"' EXIT HUP INT TERM
    printf '%s\n' 'Results: 4 total, 4 passed, 0 failed' > "$_parser_tmp/green"
    printf '%s\n' 'Results: 4 total, 3 passed, 1 failed' > "$_parser_tmp/failed"
    printf '%s\n' 'Results: 0 total, 0 passed, 0 failed' > "$_parser_tmp/empty"
    printf '%s\n' 'Results: 4 total, 4 passed, 0 failed (ignored suffix)' > "$_parser_tmp/malformed"
    printf '%s\n' 'Results: 4 total, 4 passed, 0 failed' 'Results: 4 total, 4 passed, 0 failed' > "$_parser_tmp/duplicate"
    printf '%s\n' 'Results: 4 total, 4 passed, 0 failed' 'Results: 4 total, 4 passed, 0 failed (ignored suffix)' > "$_parser_tmp/canonical-plus-malformed"
    : > "$_parser_tmp/missing"
    results_are_green "$_parser_tmp/green" 4 || { rm -rf "$_parser_tmp"; return 1; }
    ! results_are_green "$_parser_tmp/green" 3 || { rm -rf "$_parser_tmp"; return 1; }
    ! results_are_green "$_parser_tmp/failed" 4 || { rm -rf "$_parser_tmp"; return 1; }
    ! results_are_green "$_parser_tmp/empty" 4 || { rm -rf "$_parser_tmp"; return 1; }
    ! results_are_green "$_parser_tmp/malformed" 4 || { rm -rf "$_parser_tmp"; return 1; }
    ! results_are_green "$_parser_tmp/duplicate" 4 || { rm -rf "$_parser_tmp"; return 1; }
    ! results_are_green "$_parser_tmp/canonical-plus-malformed" 4 || { rm -rf "$_parser_tmp"; return 1; }
    ! results_are_green "$_parser_tmp/missing" 4 || { rm -rf "$_parser_tmp"; return 1; }
    rm -rf "$_parser_tmp"
}

assert_spec_scenarios() {
    _spec_path=$1
    _expected=$2
    _actual=$(grep -Ec '^[[:space:]]*it "' "$ROOT/$_spec_path" || true)
    [ "$_actual" -eq "$_expected" ]
}

# Guard against gate-count drift: every `run_spec <path> <n>` expectation in
# this script must equal the number of `it "` scenarios in that spec file.
# Landed after the provider_spec 36 -> 42 correction was applied to the
# --self-test scenario table but NOT to the local-torch lane's run_spec line,
# which would have failed the gate on a fully green suite.
expectations_match_scenarios() {
    _script=$1
    _base=$2
    _bad=""
    _seen=0
    _rows=$(grep -oE 'run'_'spec [^ ]+ [0-9]+' "$_script" | sed 's/^run_spec //')
    for _row in $(printf '%s\n' "$_rows" | tr ' ' ':'); do
        [ -n "$_row" ] || continue
        _p=${_row%:*}
        _declared=${_row##*:}
        _seen=$((_seen + 1))
        if [ -f "$_base/$_p" ]; then
            _actual=$(grep -Ec '^[[:space:]]*it "' "$_base/$_p" || true)
        else
            _actual=-1
        fi
        [ "$_declared" -eq "$_actual" ] || _bad="$_bad $_p(declared=$_declared,it=$_actual)"
    done
    [ "$_seen" -gt 0 ] || { echo "vacuous" >&2; return 1; }
    [ -z "$_bad" ] || { echo "drift:$_bad" >&2; return 1; }
    return 0
}

self_test_run_spec_expectation_parity() {
    # (1) Reproducing: the exact 36-vs-42 drift shape must be DETECTED, and the
    #     aligned twin must pass — a detector that fails everything proves nothing.
    _drift_tmp=$(mktemp -d) || return 2
    mkdir -p "$_drift_tmp/spec"
    printf '    it "a" {\n    it "b" {\n' > "$_drift_tmp/spec/two_it_spec.spl"
    printf 'run'_'spec spec/two_it_spec.spl 1 || exit 1\n' > "$_drift_tmp/drifted.shs"
    printf 'run'_'spec spec/two_it_spec.spl 2 || exit 1\n' > "$_drift_tmp/aligned.shs"
    printf 'echo no expectations here\n' > "$_drift_tmp/empty.shs"
    printf 'run'_'spec spec/absent_spec.spl 3 || exit 1\n' > "$_drift_tmp/missing.shs"
    ! expectations_match_scenarios "$_drift_tmp/drifted.shs" "$_drift_tmp" 2>/dev/null || { rm -rf "$_drift_tmp"; return 1; }
    expectations_match_scenarios "$_drift_tmp/aligned.shs" "$_drift_tmp" 2>/dev/null || { rm -rf "$_drift_tmp"; return 1; }
    ! expectations_match_scenarios "$_drift_tmp/empty.shs" "$_drift_tmp" 2>/dev/null || { rm -rf "$_drift_tmp"; return 1; }
    ! expectations_match_scenarios "$_drift_tmp/missing.shs" "$_drift_tmp" 2>/dev/null || { rm -rf "$_drift_tmp"; return 1; }
    rm -rf "$_drift_tmp"
    # (2) Generalizing: EVERY run_spec expectation in this gate, across all four
    #     lanes (local-torch, provider-wrappers, agent-primitives, multi-manager).
    expectations_match_scenarios "$0" "$ROOT" || return 1
}

case "${1:-}" in
    --gate) GATE=${2:-}; shift 2 ;;
    --self-test)
        self_test_results_parser || { echo "STATUS: FAIL caret-suite results-parser"; exit 1; }
        self_test_run_spec_expectation_parity || { echo "STATUS: FAIL caret-suite run-spec-expectation-parity"; exit 1; }
        for path in \
            src/app/llm_caret/main.spl \
            src/app/llm_caret/local_torch.spl \
            src/app/llm_caret/provider.spl \
            test/01_unit/app/llm_caret/main_spec.spl \
            test/01_unit/app/llm_caret/local_torch_spec.spl \
            test/01_unit/app/llm_caret/provider_spec.spl \
            test/01_unit/app/llm_caret/server_spec.spl \
            test/01_unit/app/llm_caret/agent_runtime_provider_spec.spl \
            test/03_system/llm_caret_agent_backends_spec.spl \
            test/03_system/llm_caret_multi_manager_spec.spl \
            test/03_system/app/llm_caret/feature/llm_caret_messaging_http_application_spec.spl \
            test/03_system/app/llm_caret/feature/llm_caret_messaging_mcp_spec.spl; do
            [ -f "$ROOT/$path" ] || { echo "STATUS: FAIL caret-suite missing=$path"; exit 1; }
        done
        for spec_count in \
            test/01_unit/app/llm_caret/main_spec.spl:64 \
            test/01_unit/app/llm_caret/local_torch_spec.spl:9 \
            test/01_unit/app/llm_caret/provider_spec.spl:43 \
            test/01_unit/app/llm_caret/server_spec.spl:22 \
            test/01_unit/app/llm_caret/agent_runtime_provider_spec.spl:5 \
            test/03_system/llm_caret_agent_backends_spec.spl:6 \
            test/03_system/app/llm_caret/feature/llm_caret_messaging_http_application_spec.spl:2 \
            test/03_system/app/llm_caret/feature/llm_caret_messaging_mcp_spec.spl:3 \
            test/03_system/llm_caret_multi_manager_spec.spl:3; do
            _spec=${spec_count%:*}
            _count=${spec_count##*:}
            assert_spec_scenarios "$_spec" "$_count" || { echo "STATUS: FAIL caret-suite scenario-count=$spec_count"; exit 1; }
        done
        _binding_out=$(CARET_STAGE4_PROVENANCE= SIMPLE_BINARY=/bin/true sh "$0" --gate provider-wrappers 2>&1)
        _binding_rc=$?
        [ "$_binding_rc" -eq 1 ] && printf '%s\n' "$_binding_out" | grep -qx 'STATUS: FAIL caret-suite missing-admitted-stage4-provenance' || { echo "STATUS: FAIL caret-suite stage4-binding-mutation"; exit 1; }
        grep -Fq 'caret-provider-wrappers, bootstrap, false, automated, "sh scripts/check/check-caret-suite-bootstrap.shs --gate provider-wrappers"' "$ROOT/config/check/must_check_gates.sdn" || { echo "STATUS: FAIL caret-suite provider-tier-contract"; exit 1; }
        grep -Fq 'caret-messaging-primitives, bootstrap, false, automated, "sh scripts/check/check-caret-suite-bootstrap.shs --gate agent-primitives"' "$ROOT/config/check/must_check_gates.sdn" || { echo "STATUS: FAIL caret-suite messaging-tier-contract"; exit 1; }
        grep -Fq 'caret-batch-process-adapter, bootstrap, false, automated, "sh scripts/check/check-caret-suite-bootstrap.shs --gate multi-manager"' "$ROOT/config/check/must_check_gates.sdn" || { echo "STATUS: FAIL caret-suite batch-tier-contract"; exit 1; }
        if find "$ROOT/scripts/check" -type f -name '*push*.shs' -exec grep -l 'check-caret-suite-bootstrap\.shs' {} + | grep -q .; then
            echo "STATUS: FAIL caret-suite push-tier-wiring"
            exit 1
        fi
        echo "STATUS: PASS caret-suite-bootstrap-self-test"
        exit 0 ;;
    *) echo "usage: $0 --gate local-torch|provider-wrappers|agent-primitives|multi-manager | --self-test" >&2; exit 2 ;;
esac

verify_stage4_binding() {
    [ -n "$STAGE4_PROVENANCE" ] || {
        echo "STATUS: FAIL caret-suite missing-admitted-stage4-provenance" >&2
        return 1
    }
    "$ROOT/scripts/check/check-post-bootstrap-stage4-sspec.shs" "$SIMPLE" "$STAGE4_PROVENANCE" >/dev/null
}

run_spec() {
    _spec=$1
    _expected_total=$2
    _out=$(mktemp) || exit 2
    "$SIMPLE" test "$ROOT/$_spec" --mode=interpreter --no-session-daemon --sequential --no-db --no-cache --assert-ran --fail-fast >"$_out" 2>&1
    _rc=$?
    if [ "$_rc" -ne 0 ] || ! results_are_green "$_out" "$_expected_total"; then
        tail -n 20 "$_out" >&2
        rm -f "$_out"
        return 1
    fi
    rm -f "$_out"
    return 0
}

case "$GATE" in
    local-torch)
        # Canonical repo-local inference path: Caret's local_torch provider,
        # launched through llm_caret main and exposed by its local HTTP server.
        verify_stage4_binding || exit 1
        run_spec test/01_unit/app/llm_caret/main_spec.spl 64 || exit 1
        run_spec test/01_unit/app/llm_caret/local_torch_spec.spl 9 || exit 1
        run_spec test/01_unit/app/llm_caret/provider_spec.spl 43 || exit 1
        run_spec test/01_unit/app/llm_caret/server_spec.spl 22 || exit 1
        echo "STATUS: PASS caret-local-torch-launch"
        ;;
    provider-wrappers)
        verify_stage4_binding || exit 1
        run_spec test/01_unit/app/llm_caret/agent_runtime_provider_spec.spl 5 || exit 1
        run_spec test/03_system/llm_caret_agent_backends_spec.spl 6 || exit 1
        echo "STATUS: PASS caret-provider-wrapper-fixture-contracts"
        ;;
    agent-primitives)
        verify_stage4_binding || exit 1
        run_spec test/03_system/app/llm_caret/feature/llm_caret_messaging_http_application_spec.spl 2 || exit 1
        run_spec test/03_system/app/llm_caret/feature/llm_caret_messaging_mcp_spec.spl 3 || exit 1
        echo "STATUS: PASS caret-messaging-primitives"
        ;;
    multi-manager)
        verify_stage4_binding || exit 1
        run_spec test/03_system/llm_caret_multi_manager_spec.spl 3 || exit 1
        echo "STATUS: PASS caret-injected-batch-process-adapter"
        ;;
    *) echo "STATUS: FAIL caret-suite unknown-gate=$GATE"; exit 2 ;;
esac
