#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

OUT="${1:?usage: $0 EVIDENCE}"
BUILD_DIR="${BUILD_DIR:-build/simpleos_gpu_host/offload_break_even/fill_u32}"
RAW_SAMPLES="$BUILD_DIR/raw-samples.tsv"
FILL_RECEIPT="$BUILD_DIR/fill-receipt.env"
PROVENANCE="$BUILD_DIR/provenance.env"
PROVENANCE_MANIFEST="$BUILD_DIR/provenance.manifest"
PTX="$BUILD_DIR/processing_fill_u32.ptx"
SOURCE="test/05_perf/local_gpu_check/cuda_fill_u32_break_even.c"
HARNESS="$BUILD_DIR/cuda_fill_u32_break_even"
CC_TOOL="${CC_TOOL:-cc}"
WARMUPS="${WARMUPS:-3}"
SAMPLES="${SAMPLES:-5}"
BATCHES="${BATCHES:-4096 65536 1048576}"

value_of() { grep "^$1=" "$2" 2>/dev/null | head -1 | cut -d= -f2- || true; }
sha256() { sha256sum "$1" | cut -d' ' -f1; }

mkdir -p "$BUILD_DIR"
command -v "$CC_TOOL" >/dev/null 2>&1
command -v sha256sum >/dev/null 2>&1
"$CC_TOOL" -O2 -std=c99 -Wall -Wextra -Werror "$SOURCE" -ldl -o "$HARNESS"
"$HARNESS" --dump-ptx "$PTX"
"$HARNESS" "$RAW_SAMPLES" "$FILL_RECEIPT" "$WARMUPS" "$SAMPLES" $BATCHES

source_hash="$(sha256 "$SOURCE")"
artifact_hash="$(sha256 "$HARNESS")"
ptx_hash="$(sha256 "$PTX")"
raw_hash="$(sha256 "$RAW_SAMPLES")"
device_uuid="$(value_of cuda_fill_u32_device_uuid "$FILL_RECEIPT")"
device_identity="$(value_of cuda_fill_u32_device_identity "$FILL_RECEIPT")"
coverage_max_batch="$(value_of cuda_fill_u32_coverage_max_batch "$FILL_RECEIPT")"
{
    echo "processing_ir_offload_provenance_manifest_schema=processing-ir-offload-provenance-v1"
    echo "processing_ir_offload_provenance_source_path=$SOURCE"
    echo "processing_ir_offload_provenance_source_sha256=$source_hash"
    echo "processing_ir_offload_provenance_artifact=$HARNESS"
    echo "processing_ir_offload_provenance_artifact_sha256=$artifact_hash"
    echo "processing_ir_offload_provenance_ptx_path=$PTX"
    echo "processing_ir_offload_provenance_ptx_sha256=$ptx_hash"
    echo "processing_ir_offload_provenance_raw_samples=$RAW_SAMPLES"
    echo "processing_ir_offload_provenance_raw_samples_sha256=$raw_hash"
    echo "processing_ir_offload_provenance_device_uuid=$device_uuid"
    echo "processing_ir_offload_provenance_device_identity=$device_identity"
    echo "processing_ir_offload_provenance_coverage_max_batch=$coverage_max_batch"
} >"$PROVENANCE_MANIFEST"
manifest_hash="$(sha256 "$PROVENANCE_MANIFEST")"
{
    echo "processing_ir_offload_provenance_status=pass"
    echo "processing_ir_offload_provenance_manifest_path=$PROVENANCE_MANIFEST"
    echo "processing_ir_offload_provenance_manifest_sha256=$manifest_hash"
    echo "processing_ir_offload_provenance_source_path=$SOURCE"
    echo "processing_ir_offload_provenance_source_sha256=$source_hash"
    echo "processing_ir_offload_provenance_artifact=$HARNESS"
    echo "processing_ir_offload_provenance_artifact_sha256=$artifact_hash"
    echo "processing_ir_offload_provenance_ptx_path=$PTX"
    echo "processing_ir_offload_provenance_ptx_sha256=$ptx_hash"
    echo "processing_ir_offload_provenance_raw_samples=$RAW_SAMPLES"
    echo "processing_ir_offload_provenance_raw_samples_sha256=$raw_hash"
    echo "processing_ir_offload_provenance_device_uuid=$device_uuid"
    echo "processing_ir_offload_provenance_device_identity=$device_identity"
    echo "processing_ir_offload_provenance_coverage_max_batch=$coverage_max_batch"
} >"$PROVENANCE"

rows="$(value_of cuda_fill_u32_row_count "$FILL_RECEIPT")"
{
    echo "processing_ir_offload_status=$(value_of cuda_fill_u32_status "$FILL_RECEIPT")"
    echo "processing_ir_offload_reason=measured-cuda-fill-u32-output-only"
    echo "processing_ir_offload_schema=processing-ir-offload-v1"
    echo "processing_ir_offload_execution=processing_ir"
    echo "processing_ir_offload_backend=cuda"
    echo "processing_ir_offload_evidence_kind=live"
    echo "processing_ir_offload_cpu_workload_id=fill_u32_v1"
    echo "processing_ir_offload_gpu_workload_id=fill_u32_v1"
    echo "processing_ir_offload_workload_kind=output_only"
    echo "processing_ir_offload_aggregate=$(value_of cuda_fill_u32_aggregate "$FILL_RECEIPT")"
    echo "processing_ir_offload_timing_unit=us"
    echo "processing_ir_offload_rss_source=$(value_of cuda_fill_u32_rss_source "$FILL_RECEIPT")"
    echo "processing_ir_offload_warmup_samples=$(value_of cuda_fill_u32_warmups "$FILL_RECEIPT")"
    echo "processing_ir_offload_measured_samples=$(value_of cuda_fill_u32_samples "$FILL_RECEIPT")"
    echo "processing_ir_offload_row_count=$rows"
    echo "processing_ir_offload_cpu_rss_kb=$(value_of cuda_fill_u32_cpu_rss_kb "$FILL_RECEIPT")"
    echo "processing_ir_offload_gpu_rss_kb=$(value_of cuda_fill_u32_gpu_rss_kb "$FILL_RECEIPT")"
    echo "processing_ir_offload_peak_rss_kb=$(value_of cuda_fill_u32_peak_rss_kb "$FILL_RECEIPT")"
    echo "processing_ir_offload_communication_overhead_us=0"
    echo "processing_ir_offload_break_even_batch=$(value_of cuda_fill_u32_break_even_batch "$FILL_RECEIPT")"
    echo "processing_ir_offload_break_even_found=$(value_of cuda_fill_u32_break_even_found "$FILL_RECEIPT")"
    echo "processing_ir_offload_raw_samples=$RAW_SAMPLES"
    echo "processing_ir_offload_raw_samples_sha256=$raw_hash"
    echo "processing_ir_offload_provenance_env=$PROVENANCE"
    echo "processing_ir_offload_provenance_manifest_path=$PROVENANCE_MANIFEST"
    echo "processing_ir_offload_provenance_manifest_sha256=$manifest_hash"
    echo "processing_ir_offload_ptx_path=$PTX"
    echo "processing_ir_offload_ptx_sha256=$ptx_hash"
    echo "processing_ir_offload_ptx_status=compiled_artifact_verified"
    echo "processing_ir_offload_ptx_artifact_validated=true"
    echo "processing_ir_offload_ptx_source_hash_equal=true"
    echo "processing_ir_offload_source_path=$SOURCE"
    echo "processing_ir_offload_source_sha256=$source_hash"
    echo "processing_ir_offload_artifact=$HARNESS"
    echo "processing_ir_offload_artifact_sha256=$artifact_hash"
    echo "processing_ir_offload_device_name=$(value_of cuda_fill_u32_device "$FILL_RECEIPT")"
    echo "processing_ir_offload_device_uuid=$device_uuid"
    echo "processing_ir_offload_device_identity=$device_identity"
    echo "processing_ir_offload_coverage_max_batch=$coverage_max_batch"
    echo "processing_ir_offload_executor_timing=$(value_of cuda_fill_u32_executor_timing "$FILL_RECEIPT")"
    i=0
    while [ "$i" -lt "$rows" ]; do
        prefix="cuda_fill_u32_row_${i}_"
        allocation="$(value_of "${prefix}allocation_us" "$FILL_RECEIPT")"
        launch="$(value_of "${prefix}launch_sync_us" "$FILL_RECEIPT")"
        readback="$(value_of "${prefix}readback_us" "$FILL_RECEIPT")"
        cleanup="$(value_of "${prefix}conversion_cleanup_us" "$FILL_RECEIPT")"
        total="$(value_of "${prefix}total_us" "$FILL_RECEIPT")"
        batch="$(value_of "${prefix}batch" "$FILL_RECEIPT")"
        echo "processing_ir_offload_row_${i}_batch=$batch"
        echo "processing_ir_offload_row_${i}_workload_id=fill_u32_v1"
        echo "processing_ir_offload_row_${i}_cpu_us=$(value_of "${prefix}cpu_us" "$FILL_RECEIPT")"
        echo "processing_ir_offload_row_${i}_upload_us=0"
        echo "processing_ir_offload_row_${i}_device_us=$((total - readback))"
        echo "processing_ir_offload_row_${i}_readback_us=$readback"
        echo "processing_ir_offload_row_${i}_transfer_us=$readback"
        echo "processing_ir_offload_row_${i}_total_us=$total"
        echo "processing_ir_offload_row_${i}_upload_bytes=0"
        echo "processing_ir_offload_row_${i}_readback_bytes=$((batch * 4))"
        echo "processing_ir_offload_row_${i}_command_count=1"
        echo "processing_ir_offload_row_${i}_submission_mode=output_only"
        echo "processing_ir_offload_row_${i}_readback_source=device_readback"
        echo "processing_ir_offload_row_${i}_readback_exact=$(value_of "${prefix}readback_exact" "$FILL_RECEIPT")"
        echo "processing_ir_offload_row_${i}_readback_mismatch_count=$(value_of "${prefix}mismatch_count" "$FILL_RECEIPT")"
        echo "processing_ir_offload_row_${i}_executor_allocation_us=$allocation"
        echo "processing_ir_offload_row_${i}_executor_launch_sync_us=$launch"
        echo "processing_ir_offload_row_${i}_executor_conversion_cleanup_us=$cleanup"
        echo "processing_ir_offload_row_${i}_executor_total_us=$(value_of "${prefix}executor_total_us" "$FILL_RECEIPT")"
        echo "processing_ir_offload_row_${i}_decision=$(value_of "${prefix}decision" "$FILL_RECEIPT")"
        i=$((i + 1))
    done
} >"$OUT"
