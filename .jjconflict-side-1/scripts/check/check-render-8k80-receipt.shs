#!/usr/bin/env bash
# Fail-closed admission gate for an 8K/80 rendering claim.
set -euo pipefail

usage() {
    echo "usage: $0 <receipt-file> [key-prefix] [device|cpu|bare]" >&2
}

[[ $# -ge 1 && $# -le 3 ]] || { usage; exit 2; }
receipt="$1"
prefix="${2:-render_8k80}"
lane_kind="${3:-device}"
[[ -f "$receipt" ]] || { echo "FAIL: receipt not found: $receipt" >&2; exit 1; }

value() {
    local key="$1"
    sed -n "s/^${prefix}_${key}=//p" "$receipt" | tail -1
}

fail() {
    echo "FAIL: $1" >&2
    exit 1
}

status="$(value status)"
resolution="$(value resolution)"
p95_us="$(value p95_us)"
fallback_used="$(value fallback_used)"
completion_known="$(value completion_known)"
present_scope="$(value present_scope)"
checksum_kind="$(value checksum_kind)"
checksum="$(value checksum)"

[[ "$status" == "completed" ]] || fail "status must be completed"
[[ "$resolution" == "7680x4320" ]] || fail "resolution must be 7680x4320"
[[ "$p95_us" =~ ^[0-9]+$ ]] || fail "p95_us must be an integer"
(( p95_us <= 12500 )) || fail "p95_us exceeds the 12.5 ms budget"
[[ "$fallback_used" == "false" ]] || fail "fallback_used must be false"
[[ "$completion_known" == "true" ]] || fail "completion_known must be true"
case "$lane_kind" in
    device)
        case "$present_scope" in
            swapchain|device-surface) ;;
            *) fail "present_scope must prove a completed device presentation" ;;
        esac
        case "$checksum_kind" in
            pixel-device-readback|pixel-sampled-device-readback) ;;
            *) fail "checksum_kind must prove device pixel output" ;;
        esac
        ;;
    cpu)
        case "$present_scope" in
            framebuffer-surface|host-window-surface) ;;
            *) fail "present_scope must prove a completed CPU framebuffer presentation" ;;
        esac
        case "$checksum_kind" in
            pixel-framebuffer-readback|pixel-presented-surface-readback) ;;
            *) fail "checksum_kind must prove CPU-presented pixel output" ;;
        esac
        ;;
    bare)
        case "$present_scope" in
            scanout-framebuffer|qemu-display-surface) ;;
            *) fail "present_scope must prove a completed bare/QEMU scanout" ;;
        esac
        case "$checksum_kind" in
            pixel-scanout-readback|pixel-qmp-screendump) ;;
            *) fail "checksum_kind must prove bare/QEMU displayed pixels" ;;
        esac
        ;;
    *) fail "lane kind must be device, cpu, or bare" ;;
esac
[[ -n "$checksum" ]] || fail "checksum must be non-empty"

echo "PASS: admitted 8K/80 $lane_kind rendering receipt ($prefix)"
