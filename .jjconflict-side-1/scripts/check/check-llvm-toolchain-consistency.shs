#!/bin/sh
# check-llvm-toolchain-consistency.shs
#
# Guards the "silent default" class of LLVM toolchain defect: the shell-side
# preference order (LLVM_VERSIONS in scripts/setup/platform-detect.shs) drifting
# apart from the majors the build can actually LINK (inkwell's llvmNN-0 feature,
# the llvm-sys major in Cargo.lock, the vendored crate that must supply it) and
# from the majors the pure-Simple runtime can dlopen (llvm_loader.spl).
#
# Why this exists (2026-08-17): a request to "switch to LLVM 20" looked like a
# one-line change to `: "${LLVM_VERSIONS:=18}"`. It is not. Making the shell
# prefer 20 exports LLVM_SYS_200_PREFIX, which llvm-sys 180.0.0 ignores; its
# build.rs then falls back to `llvm-config` on PATH (18 here) and links 18 anyway,
# while SIMPLE_LLVM_PATH points the dlopen loader at libLLVM-20.so. One process,
# two LLVM majors, and nothing fails loudly. This guard makes that split-brain a
# hard FAIL instead of a silent one.
#
# Verdict is ALWAYS the last line of stdout:
#   PASS  — <n> invariant(s) checked, ...           exit 0
#   FAIL  — ...                                     exit 1
#   ERROR — nothing was checked                     exit 2
# A run that checked zero invariants is ERROR, never a pass.
#
# --selftest runs fixtures BEFORE any real scan and is fatal.

set -u

ROOT="${LLVM_GUARD_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)}"

CHECKED=0
FAILURES=""

fail() { FAILURES="${FAILURES}${FAILURES:+; }$1"; }

# ---------------------------------------------------------------------------
# Extractors — each reads COMMITTED-shaped source text, never a live env var.
# ---------------------------------------------------------------------------

# Preferred major = first token of the LLVM_VERSIONS default in platform-detect.
llvm_pref_major() {
    sed -n 's/^: *"\${LLVM_VERSIONS:=\([^}"]*\)}".*/\1/p' "$1" 2>/dev/null \
        | head -1 | awk '{print $1}'
}

# Full preference list.
llvm_pref_list() {
    sed -n 's/^: *"\${LLVM_VERSIONS:=\([^}"]*\)}".*/\1/p' "$1" 2>/dev/null | head -1
}

# inkwell's selected llvmNN-0 feature -> NN
inkwell_major() {
    grep -o 'llvm[0-9][0-9]*-[0-9]' "$1" 2>/dev/null \
        | head -1 | sed 's/^llvm\([0-9][0-9]*\)-.*/\1/'
}

# Highest llvmNN-M feature the vendored inkwell actually offers -> NN
inkwell_vendor_max_major() {
    grep -oE '^llvm[0-9]+-[0-9]+ =' "$1" 2>/dev/null \
        | sed 's/ =$//' | sort -V | tail -1 | sed 's/^llvm\([0-9][0-9]*\)-.*/\1/'
}

# llvm-sys version in Cargo.lock -> major (llvm-sys encodes 180.0.0 => LLVM 18)
llvmsys_major() {
    awk '/^name = "llvm-sys"$/ { getline; if ($0 ~ /^version = /) {
             gsub(/[^0-9.]/, "", $0); split($0, a, "."); print int(a[1] / 10); exit } }' "$1" 2>/dev/null
}

# Does the dlopen loader list libLLVM-<major>.so ?
loader_lists_major() {
    grep -q "libLLVM-$2\.so" "$1" 2>/dev/null
}

# ---------------------------------------------------------------------------
# The scan
# ---------------------------------------------------------------------------
scan() {
    _detect="$1/scripts/setup/platform-detect.shs"
    _cargo="$1/src/compiler_rust/compiler/Cargo.toml"
    _lock="$1/src/compiler_rust/Cargo.lock"
    _vendor="$1/src/compiler_rust/vendor/inkwell/Cargo.toml"
    _loader="$1/src/lib/nogc_sync_mut/sffi/llvm_loader.spl"

    _pref=""; _prefs=""; _ink=""; _sys=""; _vmax=""

    if [ -f "$_detect" ]; then
        _pref=$(llvm_pref_major "$_detect")
        _prefs=$(llvm_pref_list "$_detect")
        if [ -n "$_pref" ]; then
            CHECKED=$((CHECKED + 1))
        else
            fail "could not extract LLVM_VERSIONS default from platform-detect.shs"
        fi
    fi

    if [ -f "$_cargo" ]; then
        _ink=$(inkwell_major "$_cargo")
        if [ -n "$_ink" ]; then
            CHECKED=$((CHECKED + 1))
        else
            fail "could not extract inkwell llvmNN-0 feature from compiler/Cargo.toml"
        fi
    fi

    if [ -f "$_lock" ]; then
        _sys=$(llvmsys_major "$_lock")
        [ -n "$_sys" ] && CHECKED=$((CHECKED + 1))
    fi

    if [ -f "$_vendor" ]; then
        _vmax=$(inkwell_vendor_max_major "$_vendor")
        [ -n "$_vmax" ] && CHECKED=$((CHECKED + 1))
    fi

    # (1) shell preference must be linkable by the Rust binding.
    if [ -n "$_pref" ] && [ -n "$_ink" ] && [ "$_pref" != "$_ink" ]; then
        fail "shell prefers LLVM ${_pref} but inkwell is pinned to llvm${_ink}-0 (llvm-sys would silently link ${_ink} via PATH llvm-config while SIMPLE_LLVM_PATH points at ${_pref})"
    fi

    # (2) inkwell feature and the resolved llvm-sys major must agree.
    if [ -n "$_ink" ] && [ -n "$_sys" ] && [ "$_ink" != "$_sys" ]; then
        fail "inkwell feature llvm${_ink}-0 disagrees with llvm-sys ${_sys}0.x in Cargo.lock"
    fi

    # (3) the vendored inkwell must actually offer the selected feature.
    if [ -n "$_ink" ] && [ -n "$_vmax" ] && [ "$_ink" -gt "$_vmax" ] 2>/dev/null; then
        fail "compiler/Cargo.toml selects llvm${_ink}-0 but vendored inkwell only offers up to llvm${_vmax}-0 (offline --locked build cannot resolve it)"
    fi

    # (4) every major in the preference list must be dlopen-able by the loader.
    if [ -n "$_prefs" ] && [ -f "$_loader" ]; then
        CHECKED=$((CHECKED + 1))
        for _m in $_prefs; do
            loader_lists_major "$_loader" "$_m" || \
                fail "LLVM_VERSIONS lists major ${_m} but llvm_loader.spl has no libLLVM-${_m}.so candidate"
        done
    fi

    _SUMMARY="pref=[${_prefs:-?}] inkwell=llvm${_ink:-?}-0 llvm-sys=${_sys:-?} vendor-max=llvm${_vmax:-?}"
}

# ---------------------------------------------------------------------------
# Selftest — fatal, runs before any real scan.
# ---------------------------------------------------------------------------
mkfixture() {
    # $1 dir  $2 LLVM_VERSIONS default  $3 inkwell feature major
    # $4 llvm-sys version  $5 vendor max major  $6 loader majors (space list)
    mkdir -p "$1/scripts/setup" "$1/src/compiler_rust/compiler" \
             "$1/src/compiler_rust/vendor/inkwell" "$1/src/lib/nogc_sync_mut/sffi"
    printf ': "${LLVM_VERSIONS:=%s}"\n' "$2" > "$1/scripts/setup/platform-detect.shs"
    printf 'inkwell = { version = "0.5", optional = true, features = ["llvm%s-0"] }\n' \
        "$3" > "$1/src/compiler_rust/compiler/Cargo.toml"
    printf 'name = "llvm-sys"\nversion = "%s"\n' "$4" > "$1/src/compiler_rust/Cargo.lock"
    : > "$1/src/compiler_rust/vendor/inkwell/Cargo.toml"
    _n=16
    while [ "$_n" -le "$5" ]; do
        printf 'llvm%s-0 = ["llvm-sys-%s0"]\n' "$_n" "$_n" \
            >> "$1/src/compiler_rust/vendor/inkwell/Cargo.toml"
        _n=$((_n + 1))
    done
    : > "$1/src/lib/nogc_sync_mut/sffi/llvm_loader.spl"
    for _m in $6; do
        printf '        "libLLVM-%s.so",\n' "$_m" \
            >> "$1/src/lib/nogc_sync_mut/sffi/llvm_loader.spl"
    done
}

run_fixture() {
    # $1 name  $2 expect (PASS|FAIL)  $3 dir
    CHECKED=0; FAILURES=""
    scan "$3"
    if [ "$CHECKED" -eq 0 ]; then _got=ERROR
    elif [ -n "$FAILURES" ]; then _got=FAIL
    else _got=PASS; fi
    if [ "$_got" != "$2" ]; then
        printf 'selftest fixture %s: expected %s, got %s (%s)\n' "$1" "$2" "$_got" "$FAILURES" >&2
        return 1
    fi
    return 0
}

selftest() {
    _tmp="${TMPDIR:-/tmp}/llvm-guard-selftest.$$"
    rm -rf "$_tmp"; mkdir -p "$_tmp"
    _bad=0

    # 1. today's healthy state: everything agrees on 18.
    mkfixture "$_tmp/f1" "18" "18" "180.0.0" "18" "18 17 19"
    run_fixture consistent-18 PASS "$_tmp/f1" || _bad=1

    # 2. the incident shape: shell switched to 20, Rust binding still 18.
    mkfixture "$_tmp/f2" "20 18" "18" "180.0.0" "18" "18 17 19 20"
    run_fixture shell-ahead-of-binding FAIL "$_tmp/f2" || _bad=1

    # 3. Cargo.lock disagrees with the selected inkwell feature.
    mkfixture "$_tmp/f3" "18" "18" "200.0.0" "18" "18"
    run_fixture lock-mismatch FAIL "$_tmp/f3" || _bad=1

    # 4. feature selected that the vendored crate cannot supply (offline build).
    mkfixture "$_tmp/f4" "20" "20" "200.0.0" "18" "20"
    run_fixture vendor-cannot-supply FAIL "$_tmp/f4" || _bad=1

    # 5. preference lists a major the dlopen loader has no candidate for.
    mkfixture "$_tmp/f5" "18 21" "18" "180.0.0" "18" "18"
    run_fixture loader-missing-candidate FAIL "$_tmp/f5" || _bad=1

    # 6. a fully consistent forward migration to 20 must PASS (proves the guard
    #    does not merely hardcode 18 and block all movement).
    mkfixture "$_tmp/f6" "20" "20" "200.0.0" "20" "20"
    run_fixture consistent-20 PASS "$_tmp/f6" || _bad=1

    # 7. empty tree must check zero invariants so the caller is forced to ERROR.
    mkdir -p "$_tmp/f7"
    run_fixture empty-tree ERROR "$_tmp/f7" || _bad=1

    rm -rf "$_tmp"
    if [ "$_bad" -ne 0 ]; then
        echo "FAIL — selftest failed"
        exit 1
    fi
    _SELFTEST_ONLY="${_SELFTEST_ONLY:-0}"
    if [ "$_SELFTEST_ONLY" = "1" ]; then
        echo "PASS — 7 selftest fixture(s) checked, 0 failures"
        exit 0
    fi
}

_SELFTEST_ONLY=0
case "${1:-}" in
    --selftest) _SELFTEST_ONLY=1 ;;
    --root) ROOT="${2:?--root needs a directory}" ;;
    "") ;;
    *) echo "usage: $0 [--selftest] [--root DIR]" >&2; exit 2 ;;
esac

selftest

CHECKED=0
FAILURES=""
_SUMMARY=""
scan "$ROOT"

if [ "$CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked (no LLVM toolchain declarations found under ${ROOT})"
    exit 2
fi
if [ -n "$FAILURES" ]; then
    echo "FAIL — ${CHECKED} invariant(s) checked in ${ROOT}: ${FAILURES}"
    exit 1
fi
echo "PASS — ${CHECKED} invariant(s) checked, LLVM toolchain consistent (${_SUMMARY})"
exit 0
