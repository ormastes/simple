#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)

pass_verdict() {
    echo 'bootstrap_essential_tools_smoke=true'
    echo 'PASS — bootstrap essential tools smoke completed with the admitted compiler'
}

if [ "${1:-}" = "--self-test" ]; then
    pass_verdict
    exit 0
fi

if [ "$#" -gt 1 ]; then
    echo "usage: $0 [stage4-binary]" >&2
    exit 2
fi
if [ "$#" -eq 1 ]; then
    if [ -n "${SIMPLE_BINARY:-}" ] && [ "$SIMPLE_BINARY" != "$1" ]; then
        echo "error=conflicting_simple_binary_argument" >&2
        exit 2
    fi
    SIMPLE_BINARY=$1
fi
SIMPLE_BINARY=${SIMPLE_BINARY:-"$repo_root/bin/simple"}
case "$SIMPLE_BINARY" in
    /*) ;;
    *) SIMPLE_BINARY="$repo_root/$SIMPLE_BINARY" ;;
esac

if [ ! -x "$SIMPLE_BINARY" ]; then
    echo "essential_tools_binary=false"
    echo "error=missing_simple_binary:$SIMPLE_BINARY"
    exit 1
fi

work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT INT TERM

run_with_timeout() {
    if command -v timeout >/dev/null 2>&1; then
        timeout -k 5s 30s "$@"
    elif command -v gtimeout >/dev/null 2>&1; then
        gtimeout -k 5s 30s "$@"
    else
        echo 'error=timeout_command_missing' >&2
        return 127
    fi
}

set +e
identity_output=$(run_with_timeout env SIMPLE_BOOTSTRAP= SIMPLE_RUST_SEED_WARNING= "$SIMPLE_BINARY" --version 2>&1)
identity_rc=$?
set -e
echo "essential_tools_identity_rc=$identity_rc"
if [ "$identity_rc" -ne 0 ] || [ -z "$identity_output" ]; then
    echo "error=unqualified_simple_binary"
    exit 1
fi
case "$identity_output" in
    *"bootstrap seed only"*|*"Rust-built"*)
        echo "error=rust_seed_binary"
        exit 1
        ;;
    *"debug build"*)
        echo "error=debug_simple_binary"
        exit 1
        ;;
esac
echo "essential_tools_pure_simple_identity=true"

run_probe() {
    label=$1
    expected_rc=$2
    shift 2
    set +e
    (cd "$work_dir" && run_with_timeout env SIMPLE_BOOTSTRAP= SIMPLE_RUNTIME_PATH= SIMPLE_LIB="$repo_root/src" SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_FRONTEND_DELEGATED=1 "$@") >"$work_dir/$label.out" 2>&1
    rc=$?
    set -e
    echo "${label}_rc=$rc"
    if [ "$rc" -ne "$expected_rc" ]; then
        echo "error=${label}_unexpected_exit"
        sed -n '1,120p' "$work_dir/$label.out"
        exit 1
    fi
}

run_json_probe() {
    label=$1
    expected_rc=$2
    shift 2
    set +e
    (cd "$work_dir" && run_with_timeout env SIMPLE_BOOTSTRAP= SIMPLE_RUNTIME_PATH= SIMPLE_LIB="$repo_root/src" SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_FRONTEND_DELEGATED=1 "$@") >"$work_dir/$label.json" 2>"$work_dir/$label.err"
    rc=$?
    set -e
    echo "${label}_rc=$rc"
    [ "$rc" -eq "$expected_rc" ] || { echo "error=${label}_unexpected_exit"; exit 1; }
    [ ! -s "$work_dir/$label.err" ] || { echo "error=${label}_stderr_not_empty"; exit 1; }
    run_with_timeout env SIMPLE_BOOTSTRAP= SIMPLE_RUNTIME_PATH= SIMPLE_LIB="$repo_root/src" SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_FRONTEND_DELEGATED=1 "$SIMPLE_BINARY" run "$repo_root/scripts/check/validate-json.spl" "$work_dir/$label.json" || { echo "error=${label}_not_json"; exit 1; }
    ! grep -Fq 'Found ' "$work_dir/$label.json" || { echo "error=${label}_human_output"; exit 1; }
}

run_jsonl_probe() {
    label=$1
    expected_rc=$2
    shift 2
    set +e
    (cd "$work_dir" && run_with_timeout env SIMPLE_BOOTSTRAP= SIMPLE_RUNTIME_PATH= SIMPLE_LIB="$repo_root/src" SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_FRONTEND_DELEGATED=1 "$@") >"$work_dir/$label.jsonl" 2>"$work_dir/$label.err"
    rc=$?
    set -e
    echo "${label}_rc=$rc"
    [ "$rc" -eq "$expected_rc" ] || { echo "error=${label}_unexpected_exit"; exit 1; }
    [ ! -s "$work_dir/$label.err" ] || { echo "error=${label}_jsonl_stderr_not_empty"; exit 1; }
    run_with_timeout env SIMPLE_BOOTSTRAP= SIMPLE_RUNTIME_PATH= SIMPLE_LIB="$repo_root/src" SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_FRONTEND_DELEGATED=1 "$SIMPLE_BINARY" run "$repo_root/scripts/check/validate-jsonl.spl" "$work_dir/$label.jsonl" || { echo "error=${label}_invalid_jsonl"; exit 1; }
}

printf '%s\n' '{"status":"valid"}' >"$work_dir/valid.json"
printf '%s\n' '{"status":' >"$work_dir/malformed.json"
printf '%s\n' '{"status":"valid"}' 'trailing human output' >"$work_dir/trailing.json"
run_probe validate_json_valid 0 "$SIMPLE_BINARY" run "$repo_root/scripts/check/validate-json.spl" "$work_dir/valid.json"
run_probe validate_json_malformed 1 "$SIMPLE_BINARY" run "$repo_root/scripts/check/validate-json.spl" "$work_dir/malformed.json"
run_probe validate_json_trailing 1 "$SIMPLE_BINARY" run "$repo_root/scripts/check/validate-json.spl" "$work_dir/trailing.json"

# Test runner: prove a real pass, assertion failure, and zero-example refusal.
run_probe test_runner_pass 0 "$SIMPLE_BINARY" test "$repo_root/test/fixtures/pure_simple_tooling/sibling_describe_green_spec.spl" --mode=interpreter --no-session-daemon --sequential --no-db --no-cache --assert-ran --fail-fast
grep -Fq 'Results: 2 total, 2 passed, 0 failed' "$work_dir/test_runner_pass.out" || { echo 'error=test_runner_pass_summary_missing'; exit 1; }
grep -Fq 'PASS' "$work_dir/test_runner_pass.out" || { echo 'error=test_runner_pass_marker_missing'; exit 1; }

run_probe list_constructor 0 "$SIMPLE_BINARY" test "$repo_root/test/01_unit/lib/core/list_constructor_hardening_spec.spl" --mode=interpreter --no-session-daemon --sequential --no-db --no-cache --assert-ran --fail-fast
grep -Fq 'Results: 1 total, 1 passed, 0 failed' "$work_dir/list_constructor.out" || { echo 'error=list_constructor_summary_missing'; exit 1; }
! grep -Fq 'Warning: spipe-docgen failed' "$work_dir/list_constructor.out" || { echo 'error=test_runner_default_started_spipe_docgen'; exit 1; }
[ ! -e "$work_dir/doc/06_spec" ] || { echo 'error=test_runner_default_generated_spipe_docs'; exit 1; }
echo 'essential_list_constructor_smoke=true'

run_probe test_runner_fail 1 "$SIMPLE_BINARY" test "$repo_root/scripts/check/fixtures/font_evidence_runner_fail_spec.spl" --mode=interpreter --no-session-daemon --sequential --no-db --no-cache --assert-ran --fail-fast
grep -Fq 'Results: 1 total, 0 passed, 1 failed' "$work_dir/test_runner_fail.out" || { echo 'error=test_runner_failure_summary_missing'; exit 1; }
grep -Fq 'FAIL' "$work_dir/test_runner_fail.out" || { echo 'error=test_runner_failure_marker_missing'; exit 1; }

run_probe test_runner_indexed_u8_fail 1 "$SIMPLE_BINARY" test "$repo_root/test/fixtures/pure_simple_tooling/indexed_u8_red_fixture.spl" --mode=interpreter --no-session-daemon --sequential --no-db --no-cache --assert-ran --fail-fast
grep -Fq 'Results: 1 total, 0 passed, 1 failed' "$work_dir/test_runner_indexed_u8_fail.out" || { echo 'error=test_runner_indexed_u8_failure_summary_missing'; exit 1; }
grep -Fq 'FAIL' "$work_dir/test_runner_indexed_u8_fail.out" || { echo 'error=test_runner_indexed_u8_failure_marker_missing'; exit 1; }
grep -Fq 'expected 0 to equal 99' "$work_dir/test_runner_indexed_u8_fail.out" || { echo 'error=test_runner_indexed_u8_assertion_missing'; exit 1; }

run_probe test_runner_empty 1 "$SIMPLE_BINARY" test "$repo_root/scripts/check/fixtures/font_evidence_runner_empty_spec.spl" --mode=interpreter --no-session-daemon --sequential --no-db --no-cache --assert-ran --fail-fast
grep -Fq -- '--assert-ran: no BDD examples executed' "$work_dir/test_runner_empty.out" || { echo 'error=test_runner_empty_refusal_missing'; exit 1; }

run_probe test_runner_forged 1 "$SIMPLE_BINARY" test "$repo_root/scripts/check/fixtures/font_evidence_runner_forged_colored_spec.spl" --mode=interpreter --no-session-daemon --sequential --no-db --no-cache --assert-ran --fail-fast
grep -Fq -- '--assert-ran: no BDD examples executed' "$work_dir/test_runner_forged.out" || { echo 'error=test_runner_forged_refusal_missing'; exit 1; }
echo 'essential_test_runner_smoke=true'

# Lint: prove a clean file and one real deny rule, not help or missing-file paths.
run_probe lint_clean 0 "$SIMPLE_BINARY" lint "$repo_root/test/fixtures/pure_simple_tooling/clean.spl"
grep -Fq 'Lint passed: all files clean' "$work_dir/lint_clean.out" || { echo 'error=lint_clean_marker_missing'; exit 1; }

cat >"$work_dir/lint_deny.spl" <<'EOF'
# TODO: missing structured area and priority tags
fn unfinished(value: i64) -> i64:
    pass_todo("bootstrap lint sanity intentionally remains incomplete")

fn collect_values<T>():
    var values = []
    var i = 0
    while i < 2:
        values = values + [i]
        i = i + 1
EOF
run_probe lint_deny 1 "$SIMPLE_BINARY" lint "$work_dir/lint_deny.spl"
grep -Fq 'T001' "$work_dir/lint_deny.out" || { echo 'error=lint_deny_todo_rule_missing'; exit 1; }
grep -Fq 'STUB003' "$work_dir/lint_deny.out" || { echo 'error=lint_deny_rule_missing'; exit 1; }
grep -Fq 'COLL001' "$work_dir/lint_deny.out" || { echo 'error=lint_deny_collection_rule_missing'; exit 1; }
grep -Fq 'Lint failed in 1 file(s)' "$work_dir/lint_deny.out" || { echo 'error=lint_deny_summary_missing'; exit 1; }
run_probe lint_directory 1 "$SIMPLE_BINARY" lint "$repo_root/test/fixtures/pure_simple_tooling/lint_directory"
grep -Fq 'W001' "$work_dir/lint_directory.out" || { echo 'error=lint_directory_write_rule_missing'; exit 1; }
grep -Fq 'D001' "$work_dir/lint_directory.out" || { echo 'error=lint_directory_direct_write_rule_missing'; exit 1; }
grep -Fq 'PARSE001' "$work_dir/lint_directory.out" || { echo 'error=lint_directory_parse_rule_missing'; exit 1; }
grep -Fq 'Lint failed in 1 file(s)' "$work_dir/lint_directory.out" || { echo 'error=lint_directory_summary_missing'; exit 1; }
run_jsonl_probe lint_json_deny 1 "$SIMPLE_BINARY" lint "$work_dir/lint_deny.spl" --json
grep -Fq '"type":"lint-diagnostic"' "$work_dir/lint_json_deny.jsonl" || { echo 'error=lint_json_diagnostic_missing'; exit 1; }
grep -Fq '"code":"STUB003"' "$work_dir/lint_json_deny.jsonl" || { echo 'error=lint_json_stub_rule_missing'; exit 1; }
grep -Fq '"code":"COLL001"' "$work_dir/lint_json_deny.jsonl" || { echo 'error=lint_json_collection_rule_missing'; exit 1; }
grep -Fq '"type":"lint-file-summary"' "$work_dir/lint_json_deny.jsonl" || { echo 'error=lint_json_summary_missing'; exit 1; }
aggregate='{"type":"lint-summary","status":"failed","failed_files":1}'
aggregate_count=$(grep -Fxc "$aggregate" "$work_dir/lint_json_deny.jsonl" || true)
[ "$aggregate_count" -eq 1 ] || { echo 'error=lint_json_aggregate_summary_wrong'; exit 1; }
awk 'NF && $0 !~ /^\{"type":"lint-(diagnostic|file-summary|summary|error|fix-summary)"/ { exit 1 }' "$work_dir/lint_json_deny.jsonl" || { echo 'error=lint_json_non_json_line'; exit 1; }
! grep -Fq 'Found ' "$work_dir/lint_json_deny.jsonl" || { echo 'error=lint_json_human_output'; exit 1; }
run_jsonl_probe lint_invalid_profile 2 "$SIMPLE_BINARY" lint "$repo_root/test/fixtures/pure_simple_tooling/clean.spl" --profile=relaible --json
grep -Fq 'unknown profile: relaible' "$work_dir/lint_invalid_profile.jsonl" || { echo 'error=lint_invalid_profile_accepted'; exit 1; }
echo 'essential_lint_smoke=true'

# Duplicate checker: execute from outside the repo so raw-source CLI fallback fails.
mkdir -p "$work_dir/duplicates"
printf '%s\n' 'fn repeated_value(input: i64) -> i64:' '    val alpha = input + 10' '    val beta = alpha * 2' '    val gamma = beta - 3' '    gamma + 1' >"$work_dir/duplicates/a.spl"
cp "$work_dir/duplicates/a.spl" "$work_dir/duplicates/b.spl"
mkdir -p "$work_dir/duplicates/ignored"
cp "$work_dir/duplicates/a.spl" "$work_dir/duplicates/ignored/c.spl"
cp "$work_dir/duplicates/a.spl" "$work_dir/duplicates/ignored/d.spl"

run_json_probe duplicate_clean 0 "$SIMPLE_BINARY" duplicate-check "$repo_root/test/fixtures/duplication/clean_pair" --no-default-excludes --mode token --min-lines 5 --min-tokens 8 --format json
grep -Fq '"mode": "token"' "$work_dir/duplicate_clean.json" || { echo 'error=duplicate_clean_mode_missing'; exit 1; }
grep -Fq '"total_groups": 0' "$work_dir/duplicate_clean.json" || { echo 'error=duplicate_clean_summary_missing'; exit 1; }

set -f
duplicate_args='duplicates --exclude duplicates/ignored/** --min-lines 5 --min-tokens 8 --format json --max-allowed 0'
assert_duplicate_found_json() {
    label=$1
    expected_mode=$2
    report="$work_dir/$label.json"
    grep -Fq "\"mode\": \"$expected_mode\"" "$report" || { echo "error=${label}_mode_wrong"; exit 1; }
    grep -Fq '"total_groups": 1' "$report" || { echo "error=${label}_group_count_wrong"; exit 1; }
    grep -Fq '"total_occurrences": 2' "$report" || { echo "error=${label}_total_occurrences_wrong"; exit 1; }
    grep -Fq '"total_lines": 10' "$report" || { echo "error=${label}_total_lines_wrong"; exit 1; }
    grep -Fq '"files_affected": 2' "$report" || { echo "error=${label}_files_affected_wrong"; exit 1; }
    grep -Fq '"occurrences": 2' "$report" || { echo "error=${label}_group_occurrences_wrong"; exit 1; }
    grep -Fq '"lines_per_block": 5' "$report" || { echo "error=${label}_lines_per_block_wrong"; exit 1; }
    grep -Fq '"file": "duplicates/a.spl"' "$report" || { echo "error=${label}_path_a_missing"; exit 1; }
    grep -Fq '"file": "duplicates/b.spl"' "$report" || { echo "error=${label}_path_b_missing"; exit 1; }
    [ "$(grep -Fc '"line_start": 1' "$report")" -eq 2 ] || { echo "error=${label}_line_start_wrong"; exit 1; }
    [ "$(grep -Fc '"line_end": 5' "$report")" -eq 2 ] || { echo "error=${label}_line_end_wrong"; exit 1; }
    ! grep -Fq 'duplicates/ignored/c.spl' "$report" || { echo "error=${label}_ignored_c_included"; exit 1; }
    ! grep -Fq 'duplicates/ignored/d.spl' "$report" || { echo "error=${label}_ignored_d_included"; exit 1; }
}
run_json_probe duplicate_token_uncached 1 "$SIMPLE_BINARY" duplicate-check $duplicate_args --mode token --no-cache
assert_duplicate_found_json duplicate_token_uncached token
run_json_probe duplicate_token_create 1 "$SIMPLE_BINARY" duplicate-check $duplicate_args --mode token --cache-path "$work_dir/token-cache.sdn"
[ -s "$work_dir/token-cache.sdn" ] || { echo 'error=duplicate_token_cache_missing'; exit 1; }
cmp -s "$work_dir/duplicate_token_uncached.json" "$work_dir/duplicate_token_create.json" || { echo 'error=duplicate_token_cache_create_changed'; exit 1; }
run_json_probe duplicate_token_reuse 1 "$SIMPLE_BINARY" duplicate-check $duplicate_args --mode token --cache-path "$work_dir/token-cache.sdn"
cmp -s "$work_dir/duplicate_token_create.json" "$work_dir/duplicate_token_reuse.json" || { echo 'error=duplicate_token_cache_output_changed'; exit 1; }

printf '%s\n' 'fn similar_value(input: i64) -> i64:' '    val delta = input + 10' '    val epsilon = delta * 2' '    val zeta = epsilon - 3' '    zeta + 1' >"$work_dir/duplicates/b.spl"
run_json_probe duplicate_cosine_uncached 1 "$SIMPLE_BINARY" duplicate-check $duplicate_args --mode cosine --similarity-threshold 0.85 --no-cache
assert_duplicate_found_json duplicate_cosine_uncached cosine
run_json_probe duplicate_cosine_create 1 "$SIMPLE_BINARY" duplicate-check $duplicate_args --mode cosine --similarity-threshold 0.85 --cache-path "$work_dir/cosine-cache.sdn"
[ -s "$work_dir/cosine-cache.sdn" ] || { echo 'error=duplicate_cosine_cache_missing'; exit 1; }
cmp -s "$work_dir/duplicate_cosine_uncached.json" "$work_dir/duplicate_cosine_create.json" || { echo 'error=duplicate_cosine_cache_output_changed'; exit 1; }
run_json_probe duplicate_cosine_reuse 1 "$SIMPLE_BINARY" duplicate-check $duplicate_args --mode cosine --similarity-threshold 0.85 --cache-path "$work_dir/cosine-cache.sdn"
cmp -s "$work_dir/duplicate_cosine_create.json" "$work_dir/duplicate_cosine_reuse.json" || { echo 'error=duplicate_cosine_cache_reuse_changed'; exit 1; }

printf '%s\n' 'fn unique_value(input: i64) -> i64:' '    input + 1' >"$work_dir/duplicates/b.spl"
run_json_probe duplicate_token_changed 0 "$SIMPLE_BINARY" duplicate-check $duplicate_args --mode token --cache-path "$work_dir/token-cache.sdn"
grep -Fq '"total_groups": 0' "$work_dir/duplicate_token_changed.json" || { echo 'error=duplicate_token_change_stale'; exit 1; }
grep -Fq 'file:6475706c6963617465732f622e73706c|' "$work_dir/token-cache.sdn" || { echo 'error=duplicate_token_change_cache_missing'; exit 1; }
rm "$work_dir/duplicates/b.spl"
run_json_probe duplicate_token_deleted 0 "$SIMPLE_BINARY" duplicate-check $duplicate_args --mode token --cache-path "$work_dir/token-cache.sdn"
! grep -Fq 'file:6475706c6963617465732f622e73706c|' "$work_dir/token-cache.sdn" || { echo 'error=duplicate_token_deleted_cache_retained'; exit 1; }
cp "$work_dir/duplicates/a.spl" "$work_dir/duplicates/b.spl"
run_json_probe duplicate_cache_disabled 1 "$SIMPLE_BINARY" duplicate-check $duplicate_args --mode token --cache-path "$work_dir/disabled-cache.sdn" --no-cache
[ ! -e "$work_dir/disabled-cache.sdn" ] || { echo 'error=duplicate_no_cache_ignored'; exit 1; }
set +f

run_probe duplicate_invalid_mode 2 "$SIMPLE_BINARY" duplicate-check "$work_dir/duplicates" --mode tokne
grep -Fq 'Usage: simple duplicate-check' "$work_dir/duplicate_invalid_mode.out" || { echo 'error=duplicate_invalid_mode_accepted'; exit 1; }
run_probe duplicate_invalid_format 2 "$SIMPLE_BINARY" duplicate-check "$work_dir/duplicates" --format yaml
grep -Fq 'Usage: simple duplicate-check' "$work_dir/duplicate_invalid_format.out" || { echo 'error=duplicate_invalid_format_accepted'; exit 1; }
run_probe duplicate_help_mixed 2 "$SIMPLE_BINARY" duplicate-check --help --bogus
grep -Fq 'duplicate-check: --help must be used alone' "$work_dir/duplicate_help_mixed.out" || { echo 'error=duplicate_help_mixed_accepted'; exit 1; }

printf '%s\n' 'duplicate-check:' '  mode: tokne' >"$work_dir/simple.duplicate-check.sdn"
run_probe duplicate_config_invalid_mode 2 "$SIMPLE_BINARY" duplicate-check "$work_dir/duplicates"
grep -Fq 'duplicate-check: invalid simple.duplicate-check.sdn mode: tokne' "$work_dir/duplicate_config_invalid_mode.out" || { echo 'error=duplicate_config_invalid_mode_accepted'; exit 1; }
run_json_probe duplicate_config_mode_override 0 "$SIMPLE_BINARY" duplicate-check "$repo_root/test/fixtures/duplication/clean_pair" --no-default-excludes --mode token --min-lines 5 --min-tokens 8 --format json
grep -Fq '"mode": "token"' "$work_dir/duplicate_config_mode_override.json" || { echo 'error=duplicate_config_mode_override_ignored'; exit 1; }

printf '%s\n' 'duplicate-check:' '  output-format: yaml' >"$work_dir/simple.duplicate-check.sdn"
run_probe duplicate_config_invalid_format 2 "$SIMPLE_BINARY" duplicate-check "$work_dir/duplicates"
grep -Fq 'duplicate-check: invalid simple.duplicate-check.sdn output-format: yaml' "$work_dir/duplicate_config_invalid_format.out" || { echo 'error=duplicate_config_invalid_format_accepted'; exit 1; }
run_json_probe duplicate_config_format_override 0 "$SIMPLE_BINARY" duplicate-check "$repo_root/test/fixtures/duplication/clean_pair" --no-default-excludes --mode token --min-lines 5 --min-tokens 8 --format json
grep -Fq '"mode": "token"' "$work_dir/duplicate_config_format_override.json" || { echo 'error=duplicate_config_format_override_ignored'; exit 1; }
echo 'essential_duplicate_checker_smoke=true'

# This is an ABI/wiring admission marker, not a live SimpleOS assertion.  The
# invoked check rejects a missing or wrongly ordered generated-entry/CRT hook;
# live QEMU and in-guest Clang evidence are deliberately tracked separately.
run_with_timeout sh "$repo_root/scripts/check/check-dedicated-host-startup-wiring.shs"
echo 'essential_dedicated_host_startup_wiring_structural=true'

pass_verdict
