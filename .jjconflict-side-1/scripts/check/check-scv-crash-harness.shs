#!/bin/sh
# check-scv-crash-harness.shs — SCV crash/fault-injection harness (SCV-MIG-18).
#
# Systematically runs an scv snapshot in a fresh temp repo once per fault
# point (SCV_FAULT_AFTER=<content|tree|commit|operation|head|wal>). After each
# injected kill: restart -> `scv doctor` -> journal/WAL recovery (runs inside
# the next scv command) -> `scv fsck` -> assert the repository equals a valid
# OLD or NEW state (HEAD_OP and workspaces.sdn must agree on one side), then a
# fresh snapshot + status + log must all still work and fsck must stay clean.
#
# Non-fault chaos rows:
#   wal-truncate : truncate .scv/journal/wal.log mid-record; recovery must cope
#   index-delete : delete .scv/meta/status_index.sdn; `scv rebuild-db` recovers
#   head-delete  : delete .scv/HEAD_OP; `scv doctor` must FAIL CLEANLY
#                  (non-zero exit < 124, ERROR diagnostic — never a crash)
#
# Verdict is ALWAYS the last stdout line (.claude/rules/vcs.md convention):
#   PASS — <n> crash point(s) survived, 0 corruptions    exit 0
#   FAIL — <n> crash point(s) run, corruptions: ...      exit 1
#   ERROR — nothing was checked (...)                    exit 2
#
# --selftest runs first and is FATAL: a deliberately-corrupted repository
# (commit object clobbered) must be caught as FAIL by the same classifier the
# scan uses, and canned half-state fixtures must be flagged.
#
# Usage:
#   sh scripts/check/check-scv-crash-harness.shs [--binary PATH]
#       [--points p1,p2,...] [--chaos c1,c2,...] [--selftest]
# Defaults: all 6 fault points, all 3 chaos rows.
set -u

BINARY="bin/simple"
POINTS="content tree commit operation head wal"
CHAOS="wal-truncate index-delete head-delete"
SELFTEST_ONLY=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --binary) [ "$#" -ge 2 ] || { echo "ERROR — nothing was checked (--binary needs a path)"; exit 2; }; BINARY=$2; shift 2 ;;
    --points) [ "$#" -ge 2 ] || { echo "ERROR — nothing was checked (--points needs a list)"; exit 2; }; POINTS=$(printf '%s' "$2" | tr ',' ' '); shift 2 ;;
    --chaos)  [ "$#" -ge 2 ] || { echo "ERROR — nothing was checked (--chaos needs a list)"; exit 2; }; CHAOS=$(printf '%s' "$2" | tr ',' ' '); shift 2 ;;
    --selftest) SELFTEST_ONLY=1; shift ;;
    *) echo "ERROR — nothing was checked (unknown argument: $1)"; exit 2 ;;
  esac
done

REPO=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd -P)
[ -x "$REPO/$BINARY" ] || [ -x "$BINARY" ] || { echo "ERROR — nothing was checked (no executable at $BINARY)"; exit 2; }
case "$BINARY" in /*) BIN="$BINARY" ;; *) BIN="$REPO/$BINARY" ;; esac

WORK=$(mktemp -d "${TMPDIR:-/tmp}/scv-crash.XXXXXX") || { echo "ERROR — nothing was checked (mktemp failed)"; exit 2; }
trap 'rm -rf "$WORK"' EXIT

scv() { SIMPLE_LIB="$REPO/src" SIMPLE_TIMEOUT_SECONDS=0 "$BIN" run "$REPO/src/app/scv/main.spl" "$@" 2>/dev/null; }

# --- classifiers (selftested) ------------------------------------------------
# fsck output is corrupt when it names structural damage.
fsck_is_clean() { # $1 = fsck output text -> 0 clean / 1 corrupt
  n=$(printf '%s' "$1" | grep -Ec 'missing|corrupt|mismatch|bad (commit|change|tree)' || true)
  [ "${n:-0}" -eq 0 ]
}
# OLD-or-NEW: head-op equality must match workspace-commit equality.
old_or_new_ok() { # $1 old_op $2 old_commit $3 new_op $4 new_commit
  if [ "$3" = "$1" ]; then [ "$4" = "$2" ]; else [ "$4" != "$2" ]; fi
}

# --- selftest (fatal, runs before every scan) --------------------------------
selftest() {
  # canned classifier fixtures
  fsck_is_clean "OK checked=12 clean" || { echo "SELFTEST FAIL: clean fsck text flagged corrupt"; return 1; }
  fsck_is_clean "commit c1: missing tree t9" && { echo "SELFTEST FAIL: corrupt fsck text passed"; return 1; }
  old_or_new_ok op_a c_a op_a c_a || { echo "SELFTEST FAIL: OLD state rejected"; return 1; }
  old_or_new_ok op_a c_a op_b c_b || { echo "SELFTEST FAIL: NEW state rejected"; return 1; }
  old_or_new_ok op_a c_a op_b c_a && { echo "SELFTEST FAIL: half state (new op, old commit) passed"; return 1; }
  old_or_new_ok op_a c_a op_a c_b && { echo "SELFTEST FAIL: half state (old op, new commit) passed"; return 1; }
  # real deliberately-corrupting fixture: clobber a commit object, fsck must
  # report damage and the classifier must catch it as FAIL.
  ST="$WORK/selftest"; mkdir -p "$ST"; ( cd "$ST" && printf 'st\n' > s.txt && scv init >/dev/null && scv snapshot >/dev/null ) || { echo "SELFTEST FAIL: fixture repo setup failed"; return 1; }
  CO=$(ls "$ST/.scv/objects/commits/" | head -1)
  [ -n "$CO" ] || { echo "SELFTEST FAIL: no commit object in fixture"; return 1; }
  printf 'garbage\n' > "$ST/.scv/objects/commits/$CO"
  OUT=$( cd "$ST" && scv fsck )
  if fsck_is_clean "$OUT"; then echo "SELFTEST FAIL: corrupted fixture repo not caught as FAIL"; return 1; fi
  return 0
}

if ! selftest; then echo "ERROR — nothing was checked (selftest failed)"; exit 2; fi
if [ "$SELFTEST_ONLY" -eq 1 ]; then echo "PASS — selftest only: classifiers and corrupting fixture verified"; exit 0; fi

FAILED=""
POINTS_RUN=0
note() { FAILED="$FAILED $1"; printf '  %s\n' "$1"; }

new_repo() { # $1 dir
  mkdir -p "$1" && ( cd "$1" && printf 'base\n' > a.txt && head -c 5000 /dev/urandom > big.bin && scv init >/dev/null && scv snapshot >/dev/null )
}
ws_commit() { sed -n 's/default: //p' "$1/.scv/meta/workspaces.sdn"; }

# --- fault points ------------------------------------------------------------
for P in $POINTS; do
  D="$WORK/fault-$P"
  if ! new_repo "$D"; then note "$P:setup"; POINTS_RUN=$((POINTS_RUN+1)); continue; fi
  OLD_OP=$(cat "$D/.scv/HEAD_OP"); OLD_COMMIT=$(ws_commit "$D")
  ( cd "$D" && printf 'edited\n' > a.txt )
  ( cd "$D" && SCV_FAULT_AFTER=$P scv snapshot >/dev/null ); RC=$?
  [ "$RC" -eq 3 ] || note "$P:fault-not-injected(rc=$RC)"
  ( cd "$D" && scv doctor >/dev/null ); RC=$?
  [ "$RC" -lt 124 ] || note "$P:doctor-crashed(rc=$RC)"
  [ "$RC" -eq 0 ] || note "$P:doctor(rc=$RC)"
  FSCK=$( cd "$D" && scv fsck )
  fsck_is_clean "$FSCK" || note "$P:fsck-after-crash"
  NEW_OP=$(cat "$D/.scv/HEAD_OP"); NEW_COMMIT=$(ws_commit "$D")
  old_or_new_ok "$OLD_OP" "$OLD_COMMIT" "$NEW_OP" "$NEW_COMMIT" || note "$P:half-state(old_op=$OLD_OP new_op=$NEW_OP)"
  ( cd "$D" && scv snapshot >/dev/null ); RC=$?
  [ "$RC" -eq 0 ] || note "$P:resnapshot(rc=$RC)"
  ( cd "$D" && scv status >/dev/null ); RC=$?
  [ "$RC" -eq 0 ] || note "$P:status(rc=$RC)"
  ( cd "$D" && scv log >/dev/null ); RC=$?
  [ "$RC" -eq 0 ] || note "$P:log(rc=$RC)"
  FSCK=$( cd "$D" && scv fsck )
  fsck_is_clean "$FSCK" || note "$P:fsck-final"
  POINTS_RUN=$((POINTS_RUN+1))
done

# --- chaos rows --------------------------------------------------------------
for C in $CHAOS; do
  D="$WORK/chaos-$C"
  if ! new_repo "$D"; then note "$C:setup"; POINTS_RUN=$((POINTS_RUN+1)); continue; fi
  case "$C" in
    wal-truncate)
      # truncated mid-record WAL: BEGIN plus a cut SET line, no COMMIT
      printf 'BEGIN txn=commit_dead\nSET path=HEAD_OP ol' > "$D/.scv/journal/wal.log"
      ( cd "$D" && scv doctor >/dev/null ); RC=$?
      [ "$RC" -eq 0 ] || note "$C:doctor(rc=$RC)"
      FSCK=$( cd "$D" && scv fsck ); fsck_is_clean "$FSCK" || note "$C:fsck"
      ( cd "$D" && printf 'more\n' >> a.txt && scv snapshot >/dev/null ); RC=$?
      [ "$RC" -eq 0 ] || note "$C:snapshot(rc=$RC)"
      ;;
    index-delete)
      rm -f "$D/.scv/meta/status_index.sdn"
      ( cd "$D" && scv rebuild-db >/dev/null ); RC=$?
      [ "$RC" -eq 0 ] || note "$C:rebuild-db(rc=$RC)"
      [ -f "$D/.scv/meta/status_index.sdn" ] || note "$C:index-not-rebuilt"
      ( cd "$D" && scv status >/dev/null ); RC=$?
      [ "$RC" -eq 0 ] || note "$C:status(rc=$RC)"
      FSCK=$( cd "$D" && scv fsck ); fsck_is_clean "$FSCK" || note "$C:fsck"
      ;;
    head-delete)
      rm -f "$D/.scv/HEAD_OP"
      OUT=$( cd "$D" && scv doctor ); RC=$?
      [ "$RC" -ne 0 ] || note "$C:doctor-passed-on-missing-head"
      [ "$RC" -lt 124 ] || note "$C:doctor-crashed(rc=$RC)"
      printf '%s' "$OUT" | grep -q "ERROR" || note "$C:no-clean-diagnostic"
      ;;
    *) note "$C:unknown-chaos-row" ;;
  esac
  POINTS_RUN=$((POINTS_RUN+1))
done

[ "$POINTS_RUN" -gt 0 ] || { echo "ERROR — nothing was checked (0 crash points executed)"; exit 2; }
if [ -z "$FAILED" ]; then
  echo "PASS — $POINTS_RUN crash point(s) survived, 0 corruptions"
  exit 0
fi
echo "FAIL — $POINTS_RUN crash point(s) run, corruptions:$FAILED"
exit 1
