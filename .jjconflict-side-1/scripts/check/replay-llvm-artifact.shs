#!/bin/sh
set -eu

usage() {
    echo "usage: $0 <module.ll|module.bc> [output-dir]" >&2
    exit 2
}

find_llvm_tool() {
    tool_name="$1"
    explicit_name="$2"
    if [ -n "$explicit_name" ]; then
        command -v "$explicit_name" || return 1
        return
    fi
    for candidate in "${tool_name}-20" "${tool_name}-19" "${tool_name}-18" \
        "${tool_name}-17" "$tool_name"; do
        if command -v "$candidate" >/dev/null 2>&1; then
            command -v "$candidate"
            return
        fi
    done
    return 1
}

[ "$#" -ge 1 ] && [ "$#" -le 2 ] || usage
input="$1"
[ -f "$input" ] || { echo "llvm_replay_status=fail reason=input-not-found input=$input" >&2; exit 1; }

output_dir="${2:-build/check/llvm-artifact-replay}"
mkdir -p "$output_dir"
stem=$(basename "$input")
stem=${stem%.*}
bitcode="$output_dir/$stem.bc"
object="$output_dir/$stem.o"

LLVM_AS=$(find_llvm_tool llvm-as "${LLVM_AS:-}") || {
    echo "llvm_replay_status=fail reason=missing-llvm-as" >&2
    exit 1
}
LLVM_OPT=$(find_llvm_tool opt "${LLVM_OPT:-}") || {
    echo "llvm_replay_status=fail reason=missing-opt" >&2
    exit 1
}
LLVM_LLC=$(find_llvm_tool llc "${LLVM_LLC:-}") || {
    echo "llvm_replay_status=fail reason=missing-llc" >&2
    exit 1
}

case "$input" in
    *.ll)
        if ! "$LLVM_AS" "$input" -o "$bitcode"; then
            echo "llvm_replay_status=fail stage=assemble input=$input" >&2
            exit 1
        fi
        ;;
    *.bc)
        bitcode="$input"
        ;;
    *) usage ;;
esac

if ! "$LLVM_OPT" -passes=verify -disable-output "$bitcode"; then
    echo "llvm_replay_status=fail stage=verify bitcode=$bitcode" >&2
    exit 1
fi
if ! "$LLVM_LLC" -filetype=obj "$bitcode" -o "$object"; then
    echo "llvm_replay_status=fail stage=object bitcode=$bitcode" >&2
    exit 1
fi

echo "llvm_replay_status=pass input=$input bitcode=$bitcode object=$object"
