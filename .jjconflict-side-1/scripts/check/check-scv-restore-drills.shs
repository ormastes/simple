#!/bin/sh
# check-scv-restore-drills.shs — SCV restore drills (SCV-MIG-23, week 4).
#
# Six independent disaster-recovery drills, each in its own isolated temp
# repo, driving the real scv CLI exactly as scripts/scv-migration/steps/
# SCV-MIG-14.shs does. Gate list from the stabilization doc §"restore tests"
# (S4->S5): GitHub/git only, checkpoint+Git, SCV objects only, corrupt DB,
# missing indexes, interrupted transaction.
#
#   git-only        : destroy .scv entirely, recover purely from git
#   checkpoint-git  : destroy .scv but keep the checkpoint dir aside, restore
#   scv-objects-only: delete .git, restore bytes from SCV objects alone
#   corrupt-db      : garbage in derived meta indexes, scv rebuild-db recovers
#   missing-indexes : parser index/cache deleted, doctor non-FAIL, rebuilt
#   interrupted-txn : SCV_FAULT_AFTER crash injection at 2 representative
#                     points (commit, head); full sweep lives in
#                     scripts/check/check-scv-crash-harness.shs (SCV-MIG-18)
#                     and is deliberately NOT duplicated here.
#
# Verdict is ALWAYS the last stdout line (.claude/rules/vcs.md convention):
#   PASS — <n> drill(s) recovered, 0 failures      exit 0
#   FAIL — <k> drill(s) failed: <names>            exit 1
#   ERROR — nothing was checked (...)              exit 2
#
# --selftest runs first and is FATAL: a sabotaged fixture (commit object
# clobbered, recovery deliberately skipped) must be caught by the SAME
# assessor the drills use, and a 0-drill selection must yield ERROR.
# --only <name> runs a single drill (count in the verdict reflects it).
#
# Committed UNSIGNED: sign with
#   sh scripts/trust/sign-script.shs --name scv-migration-root scripts/check/check-scv-restore-drills.shs
set -u

ONLY=""
SELFTEST_ONLY=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --only) [ "$#" -ge 2 ] || { echo "ERROR — nothing was checked (--only needs a drill name)"; exit 2; }; ONLY=$2; shift 2 ;;
    --selftest) SELFTEST_ONLY=1; shift ;;
    *) echo "ERROR — nothing was checked (unknown argument: $1)"; exit 2 ;;
  esac
done

REPO=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd -P)
[ -x "$REPO/bin/simple" ] || { echo "ERROR — nothing was checked (missing: bin/simple)"; exit 2; }
command -v git >/dev/null 2>&1 || { echo "ERROR — nothing was checked (git not installed)"; exit 2; }
WORK=$(mktemp -d "${TMPDIR:-/tmp}/scv-restore.XXXXXX") || { echo "ERROR — nothing was checked (mktemp failed)"; exit 2; }
trap 'rm -rf "$WORK"' EXIT

# Same invocation pattern as scripts/scv-migration/steps/SCV-MIG-14.shs.
scv() { SIMPLE_LIB="$REPO/src" SIMPLE_TIMEOUT_SECONDS=0 "$REPO/bin/simple" run "$REPO/src/app/scv/main.spl" "$@"; }

# --- shared fixture + assessor (selftested) ----------------------------------
# Fixture mirrors SCV-MIG-14: a.txt + sub/b.txt in a colocated git repo.
make_fixture() { # $1 = dir; creates git repo with content, scv init+snapshot
  mkdir -p "$1" && cd "$1" || return 1
  printf 'alpha\n' > a.txt
  mkdir -p sub && printf 'beta\n' > sub/b.txt
  git init -q . && git add -A && git -c user.email=t@t -c user.name=t commit -q -m base || return 1
  scv init >/dev/null 2>&1 && scv snapshot >/dev/null 2>&1 && [ -d .scv ]
}
# The one assessor every drill AND the selftest sabotage go through:
# doctor must end PASS and fsck must report "OK checked=".
assess_repo() { # $1 = dir -> 0 healthy / 1 unhealthy (details on stdout)
  d_out=$( (cd "$1" && scv doctor 2>&1) )
  case "$(printf '%s\n' "$d_out" | grep -v '^ *$' | tail -n 1)" in
    PASS*) : ;;
    *) printf 'doctor not PASS:\n%s\n' "$d_out"; return 1 ;;
  esac
  f_out=$( (cd "$1" && scv fsck 2>&1) )
  case "$f_out" in
    *"OK checked="*) : ;;
    *) printf 'fsck not OK:\n%s\n' "$f_out"; return 1 ;;
  esac
  return 0
}
ws_commit() { sed -n 's/default: //p' "$1/.scv/meta/workspaces.sdn"; }
old_or_new_ok() { # $1 old_op $2 old_commit $3 new_op $4 new_commit
  if [ "$3" = "$1" ]; then [ "$4" = "$2" ]; else [ "$4" != "$2" ]; fi
}

# --- drills (each: 0 = recovered, 1 = failed; runs in its own subdir) --------

drill_git_only() {
  D="$WORK/git-only"
  ( make_fixture "$D" ) || { echo "fixture setup failed"; return 1; }
  rm -rf "$D/.scv"
  ( cd "$D" && scv init >/dev/null 2>&1 && scv snapshot >/dev/null 2>&1 ) || { echo "re-init/re-snapshot from git failed"; return 1; }
  assess_repo "$D" || return 1
  vb=$( (cd "$D" && scv verify-backends --git . 2>&1) )
  case "$vb" in
    *"PASS — 2 path(s) compared, 0 mismatches"*) return 0 ;;
    *) printf 'verify-backends mismatch:\n%s\n' "$vb"; return 1 ;;
  esac
}

drill_checkpoint_git() {
  D="$WORK/checkpoint-git"
  ( make_fixture "$D" ) || { echo "fixture setup failed"; return 1; }
  ( cd "$D" && scv checkpoint >/dev/null 2>&1 ) || { echo "checkpoint failed"; return 1; }
  [ -d "$D/.scv/checkpoints" ] || { echo "no .scv/checkpoints dir after checkpoint"; return 1; }
  cp -R "$D/.scv/checkpoints" "$WORK/ckpt-aside" || return 1
  rm -rf "$D/.scv"
  ( cd "$D" && scv init >/dev/null 2>&1 && scv snapshot >/dev/null 2>&1 ) || { echo "fresh init+snapshot failed"; return 1; }
  rm -rf "$D/.scv/checkpoints" && cp -R "$WORK/ckpt-aside" "$D/.scv/checkpoints" || return 1
  assess_repo "$D" || return 1
  vb=$( (cd "$D" && scv verify-backends --git . 2>&1) )
  case "$vb" in
    *"0 mismatches"*) return 0 ;;
    *) printf 'tree does not match git after checkpoint restore:\n%s\n' "$vb"; return 1 ;;
  esac
}

drill_scv_objects_only() {
  D="$WORK/scv-objects-only"
  ( make_fixture "$D" ) || { echo "fixture setup failed"; return 1; }
  rm -rf "$D/.git"
  OUT="$WORK/scv-objects-out"
  et=$( (cd "$D" && scv export-tree "$OUT" 2>&1) ) || { printf 'export-tree failed:\n%s\n' "$et"; return 1; }
  for f in a.txt sub/b.txt; do
    cmp -s "$D/$f" "$OUT/$f" || { echo "restored bytes differ for $f"; return 1; }
  done
  assess_repo "$D"
}

drill_corrupt_db() {
  D="$WORK/corrupt-db"
  ( make_fixture "$D" ) || { echo "fixture setup failed"; return 1; }
  before=$( (cd "$D" && scv fsck 2>&1) | grep 'OK checked=' )
  [ -n "$before" ] || { echo "baseline fsck not OK"; return 1; }
  printf 'garbage|not|a|real|index\n' > "$D/.scv/meta/status_index.sdn"
  rb=$( (cd "$D" && scv rebuild-db 2>&1) ); rb_rc=$?
  [ "$rb_rc" -eq 0 ] || { printf 'rebuild-db failed (rc=%s):\n%s\n' "$rb_rc" "$rb"; return 1; }
  assess_repo "$D" || return 1
  after=$( (cd "$D" && scv fsck 2>&1) | grep 'OK checked=' )
  [ "$after" = "$before" ] || { echo "fsck changed after rebuild-db: '$before' -> '$after'"; return 1; }
  return 0
}

drill_missing_indexes() {
  D="$WORK/missing-indexes"
  ( make_fixture "$D" ) || { echo "fixture setup failed"; return 1; }
  ( cd "$D" && scv parse-index >/dev/null 2>&1 )   # populate parser index/cache
  rm -f "$D/.scv/meta/parser_index.sdn"
  rm -rf "$D/.scv/objects/syntax"
  d_out=$( (cd "$D" && scv doctor 2>&1) )
  case "$(printf '%s\n' "$d_out" | grep -v '^ *$' | tail -n 1)" in
    PASS*) : ;;   # missing derived index must be STALE/OK, never FAIL
    *) printf 'doctor FAILed on missing derived indexes (must be non-fatal):\n%s\n' "$d_out"; return 1 ;;
  esac
  printf '%s\n' "$d_out" | grep -q 'parser index  FAIL' && { echo "parser index row is FAIL, expected STALE/OK"; return 1; }
  ( cd "$D" && scv parse-index >/dev/null 2>&1 && scv snapshot >/dev/null 2>&1 ) || { echo "rebuild via parse-index/snapshot failed"; return 1; }
  assess_repo "$D"
}

drill_interrupted_txn() {
  # Two representative crash points (commit, head); the full 6-point sweep is
  # scripts/check/check-scv-crash-harness.shs and is not duplicated here.
  for P in commit head; do
    D="$WORK/itxn-$P"
    ( make_fixture "$D" ) || { echo "fixture setup failed ($P)"; return 1; }
    OLD_OP=$(cat "$D/.scv/HEAD_OP"); OLD_COMMIT=$(ws_commit "$D")
    printf 'gamma %s\n' "$P" >> "$D/a.txt"
    ( cd "$D" && SCV_FAULT_AFTER=$P scv snapshot >/dev/null 2>&1 )  # nonzero rc expected
    assess_repo "$D" || { echo "recovery after fault=$P failed"; return 1; }
    NEW_OP=$(cat "$D/.scv/HEAD_OP"); NEW_COMMIT=$(ws_commit "$D")
    old_or_new_ok "$OLD_OP" "$OLD_COMMIT" "$NEW_OP" "$NEW_COMMIT" || { echo "half state after fault=$P (old_op=$OLD_OP new_op=$NEW_OP)"; return 1; }
    ( cd "$D" && scv snapshot >/dev/null 2>&1 ) || { echo "post-recovery snapshot failed ($P)"; return 1; }
    assess_repo "$D" || { echo "post-recovery health failed ($P)"; return 1; }
  done
  return 0
}

# --- selftest (fatal, runs before every scan) --------------------------------
selftest() {
  # Sabotaged fixture: corrupt a commit object AND skip recovery — the shared
  # assessor must call it unhealthy.
  ST="$WORK/selftest"
  ( make_fixture "$ST" ) || { echo "SELFTEST FAIL: fixture setup failed"; return 1; }
  # One retry on the healthy probe: on a loaded shared box a single scv
  # invocation can transiently fail; diagnostics are printed, never discarded.
  if ! h_out=$(assess_repo "$ST"); then
    printf 'selftest: healthy probe attempt 1 unhealthy, retrying:\n%s\n' "$h_out"
    h_out=$(assess_repo "$ST") || { printf '%s\n' "$h_out"; echo "SELFTEST FAIL: healthy fixture flagged unhealthy (twice)"; return 1; }
  fi
  CO=$(ls "$ST/.scv/objects/commits/" 2>/dev/null | head -1)
  [ -n "$CO" ] || { echo "SELFTEST FAIL: no commit object in fixture"; return 1; }
  printf 'garbage\n' > "$ST/.scv/objects/commits/$CO"
  if assess_repo "$ST" >/dev/null; then
    echo "SELFTEST FAIL: sabotaged repo (corrupt commit, no recovery) passed the assessor"
    return 1
  fi
  # old_or_new classifier fixtures (same shape as the crash harness's).
  old_or_new_ok op_a c_a op_a c_a || { echo "SELFTEST FAIL: OLD state rejected"; return 1; }
  old_or_new_ok op_a c_a op_b c_b || { echo "SELFTEST FAIL: NEW state rejected"; return 1; }
  old_or_new_ok op_a c_a op_b c_a && { echo "SELFTEST FAIL: half state passed"; return 1; }
  # 0-drill selection must be ERROR exit 2.
  z_out=$(sh "$0" --only no-such-drill 2>&1); z_rc=$?
  case "$z_out" in
    "ERROR — nothing was checked"*) [ "$z_rc" -eq 2 ] || { echo "SELFTEST FAIL: 0-drill run exit $z_rc, want 2"; return 1; } ;;
    *) echo "SELFTEST FAIL: 0-drill run did not ERROR: $z_out"; return 1 ;;
  esac
  echo "selftest OK (sabotage caught, classifiers checked, 0-drill selection is ERROR)"
  return 0
}

# Skip the recursive 0-drill probe's own selftest to avoid infinite recursion:
# the probe path is exactly "--only no-such-drill", which never matches a drill.
ALL="git-only checkpoint-git scv-objects-only corrupt-db missing-indexes interrupted-txn"
if [ "$ONLY" = "no-such-drill" ]; then
  echo "ERROR — nothing was checked (no drill matches: $ONLY)"
  exit 2
fi

selftest || { echo "ERROR — nothing was checked (selftest failed)"; exit 2; }
[ "$SELFTEST_ONLY" -eq 1 ] && { echo "PASS — selftest only, 0 drills run (selftest green)"; exit 0; }

RUN=0
FAILED=""
for NAME in $ALL; do
  [ -n "$ONLY" ] && [ "$NAME" != "$ONLY" ] && continue
  RUN=$((RUN + 1))
  case "$NAME" in
    git-only)         drill_git_only ;;
    checkpoint-git)   drill_checkpoint_git ;;
    scv-objects-only) drill_scv_objects_only ;;
    corrupt-db)       drill_corrupt_db ;;
    missing-indexes)  drill_missing_indexes ;;
    interrupted-txn)  drill_interrupted_txn ;;
  esac
  rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "drill $NAME: recovered"
  else
    echo "drill $NAME: FAILED"
    FAILED="$FAILED $NAME"
  fi
done

if [ "$RUN" -eq 0 ]; then
  echo "ERROR — nothing was checked (no drill matches: $ONLY)"
  exit 2
fi
if [ -z "$FAILED" ]; then
  echo "PASS — $RUN drill(s) recovered, 0 failures"
  exit 0
fi
K=$(echo "$FAILED" | wc -w)
echo "FAIL — $K drill(s) failed:$FAILED"
exit 1
