#!/bin/sh
# Canonical SimpleOS QEMU guest-evidence runner (contract v1).
# Live execution is intentionally fail-closed until the image/firmware/SSH
# owner is wired. Fixture mode validates command shape only.
set -eu

usage() {
    echo "usage: $0 --qemu PATH --isa ISA --accel ACCEL --base-image FILE --overlay FILE --firmware FILE --cloudinit FILE --ssh-port N --ssh-user USER --ssh-key FILE --timeout SEC --guest-command CMD --serial FILE --ssh-log FILE [--fixture]" >&2
    exit 64
}
die() { echo "simpleos-qemu-guest-evidence: $*" >&2; exit 2; }
qemu= isa= accel= base= overlay= firmware= cloudinit= port= user= key= timeout= command= serial= ssh_log= fixture=false
while [ "$#" -gt 0 ]; do
    case "$1" in
        --qemu) qemu=$2; shift 2;; --isa) isa=$2; shift 2;; --accel) accel=$2; shift 2;;
        --base-image) base=$2; shift 2;; --overlay) overlay=$2; shift 2;;
        --firmware) firmware=$2; shift 2;; --cloudinit) cloudinit=$2; shift 2;;
        --ssh-port) port=$2; shift 2;; --ssh-user) user=$2; shift 2;; --ssh-key) key=$2; shift 2;;
        --timeout) timeout=$2; shift 2;; --guest-command) command=$2; shift 2;;
        --serial) serial=$2; shift 2;; --ssh-log) ssh_log=$2; shift 2;; --fixture) fixture=true; shift;;
        *) usage;;
    esac
done
for v in qemu isa accel base overlay firmware cloudinit port user key timeout command serial ssh_log; do
    eval "x=\${$v}"; [ -n "$x" ] || usage
done
case "$isa" in x86_64|aarch64|riscv64) ;; *) die "unsupported ISA";; esac
case "$accel" in kvm|tcg) ;; *) die "acceleration must be kvm or tcg";; esac
case "$command" in version|compile|run|payload-list) ;; *) die "guest command is not in closed enum";; esac
case "$port" in ''|*[!0-9]*) die "invalid SSH port";; esac
case "$timeout" in ''|*[!0-9]*) die "invalid timeout";; esac
[ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die "SSH port out of range"
[ "$timeout" -ge 1 ] || die "timeout must be positive"
[ -f "$qemu" ] || die "QEMU binary missing"
for f in "$base" "$firmware" "$cloudinit" "$key"; do [ -f "$f" ] || die "input missing: $f"; done
case "$overlay" in /*) ;; *) die "overlay must be absolute";; esac
case "$serial:$ssh_log" in *[[:space:]]*) die "log paths may not contain whitespace";; esac

if [ "$fixture" = true ]; then
    mkdir -p "$(dirname -- "$serial")" "$(dirname -- "$ssh_log")"
    # CONTRACT_ONLY: these are command-shape receipts, not guest evidence.
    printf '%s\n' "contract=simpleos-qemu-guest-evidence/v1" "qemu=$qemu" "isa=$isa" "accel=$accel" "guest_command=$command" > "$serial"
    printf '%s\n' "contract_only=true" "ssh_user=$user" "ssh_port=$port" "timeout=$timeout" > "$ssh_log"
    echo simpleos_qemu_guest_evidence_status=CONTRACT_ONLY
    exit 0
fi

# No live run may proceed until the canonical VM lifecycle owner is supplied.
die "live QEMU execution is not wired; use --fixture for CONTRACT_ONLY validation"
