#!/bin/sh
# Exact, interleaved evidence collector for the interpreter identifier-hash memo.
#
# Performance claims are admitted only from a source-matched pure-Simple Stage4
# full CLI. A Rust seed, missing/invalid provenance, or fewer than seven paired
# samples is BLOCKED (exit 2) before the first timing sample. The receipt binds
# binary, source closure, harness, timing tool, host, fixtures, and every raw
# elapsed/RSS/stdout/stderr-hash sample.

set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
cd "$ROOT_DIR"

N=${INTERPRETER_HASH_SAMPLE_COUNT:-7}
SIMPLE_BINARY=${SIMPLE_BINARY:-bin/simple}
SIMPLE_COMPILER_PROVENANCE=${SIMPLE_COMPILER_PROVENANCE:-}
OUTPUT_DIR=${INTERPRETER_HASH_OUTPUT_DIR:-build/perf/interpreter_hash_memo}
TIME_TOOL=${INTERPRETER_HASH_TIME_TOOL:-/usr/bin/time}

HARNESS_PATH="$ROOT_DIR/scripts/check/check-interpreter-hash-memo-perf.shs"
SUBJECT_SOURCE="$ROOT_DIR/src/compiler/10.frontend/core/interpreter/hashmap.spl"
HOT_UNCACHED="$ROOT_DIR/test/05_perf/startup/interpreter_hash_uncached_fixture.spl"
HOT_MEMO="$ROOT_DIR/test/05_perf/startup/interpreter_hash_hot_fixture.spl"
MISS_UNCACHED="$ROOT_DIR/test/05_perf/startup/interpreter_hash_miss_uncached_fixture.spl"
MISS_MEMO="$ROOT_DIR/test/05_perf/startup/interpreter_hash_miss_memo_fixture.spl"
LOAD_FAST="$ROOT_DIR/test/05_perf/startup/interpreter_identifier_load_fast_fixture.spl"
SLOW_ENV="$ROOT_DIR/test/05_perf/startup/interpreter_identifier_slow_env_fixture.spl"

blocked() {
    echo "STATUS: BLOCKED interpreter-hash-memo performance not measured: $*" >&2
    exit 2
}

hash_file() {
    sha256sum "$1" | awk '{print $1}'
}

resolve_file() {
    _path=$1
    case "$_path" in /*) ;; *) _path="$ROOT_DIR/$_path" ;; esac
    _resolved=$(readlink -f -- "$_path") || return 1
    [ -f "$_resolved" ] || return 1
    printf '%s\n' "$_resolved"
}

join_column() {
    awk -v column="$2" '{if (NR > 1) printf ","; printf "%s", $column} END{print ""}' "$1"
}

percentile_column() {
    _file=$1
    _column=$2
    _percent=$3
    awk -v column="$_column" '{print $column}' "$_file" |
        LC_ALL=C sort -n |
        awk -v percent="$_percent" '
            { values[NR] = $1 }
            END {
                index = int((NR * percent + 99) / 100)
                if (index < 1) index = 1
                if (index > NR) index = NR
                print values[index]
            }'
}

ratio_bp() {
    awk -v numerator="$1" -v denominator="$2" 'BEGIN {
        if (denominator <= 0) { print 999999999; exit }
        print int((numerator * 10000 + denominator / 2) / denominator)
    }'
}

case "$N" in ''|*[!0-9]*) blocked "sample count is not an integer: $N" ;; esac
[ "$N" -ge 7 ] || blocked "sample_count=$N is below the required N>=7"
[ -x "$TIME_TOOL" ] || blocked "timing tool missing or not executable: $TIME_TOOL"

for required in "$HARNESS_PATH" "$SUBJECT_SOURCE" "$HOT_UNCACHED" "$HOT_MEMO" \
        "$MISS_UNCACHED" "$MISS_MEMO" "$LOAD_FAST" "$SLOW_ENV"; do
    [ -f "$required" ] && [ ! -L "$required" ] || blocked "required regular file missing: $required"
done

SIMPLE_REAL=$(resolve_file "$SIMPLE_BINARY") || blocked "Simple binary missing or non-regular: $SIMPLE_BINARY"
[ -x "$SIMPLE_REAL" ] || blocked "Simple binary is not executable: $SIMPLE_REAL"
VERSION_OUT=$("$SIMPLE_REAL" --version 2>&1) || blocked "Simple binary cannot report its identity"
case "$VERSION_OUT" in
    *"bootstrap seed only"*|*"Rust-built Simple binary"*|*"Rust-built"*)
        blocked "Rust seed rejected; an admitted source-matched pure-Simple Stage4 CLI is required"
        ;;
esac

[ -n "$SIMPLE_COMPILER_PROVENANCE" ] || blocked "SIMPLE_COMPILER_PROVENANCE must name the exact adjacent admitted Stage4 receipt"
BOOTSTRAP_STAGE3_FACADE_PATH="$ROOT_DIR/scripts/check/lib/bootstrap-stage3-provenance.shs"
STAGE4_PROVENANCE_HELPER_PATH="$ROOT_DIR/scripts/check/lib/stage4-candidate-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH STAGE4_PROVENANCE_HELPER_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
. "$STAGE4_PROVENANCE_HELPER_PATH"

PROVENANCE_REAL=$(bootstrap_stage3_canonical_file "$SIMPLE_COMPILER_PROVENANCE") ||
    blocked "Stage4 provenance is missing, symlinked, or non-canonical"
[ "$PROVENANCE_REAL" = "${SIMPLE_REAL}.provenance.env" ] ||
    blocked "Stage4 provenance is not adjacent to the exact binary"
[ "$(bootstrap_stage3_manifest_value schema "$PROVENANCE_REAL")" = simple-bootstrap-stage4-provenance-v1 ] ||
    blocked "provenance is not a Stage4 full-CLI receipt"
stage4_verify_candidate_provenance "$PROVENANCE_REAL" "$SIMPLE_REAL" "$ROOT_DIR" ||
    blocked "Stage4 provenance/source/executable verification failed"

BINARY_SHA=$(hash_file "$SIMPLE_REAL")
PROVENANCE_SHA=$(hash_file "$PROVENANCE_REAL")
SOURCE_REVISION=$(bootstrap_stage3_manifest_value source_revision "$PROVENANCE_REAL")
SUBJECT_SHA=$(hash_file "$SUBJECT_SOURCE")
HARNESS_SHA=$(hash_file "$HARNESS_PATH")
TIME_TOOL_REAL=$(resolve_file "$TIME_TOOL") || blocked "timing tool must be a non-symlink regular file"
TIME_TOOL_SHA=$(hash_file "$TIME_TOOL_REAL")
HOST_NAME=$(hostname 2>/dev/null || echo unavailable)
HOST_UNAME=$(uname -a 2>/dev/null || echo unavailable)
HOST_CPU=$(sed -n 's/^model name[[:space:]]*:[[:space:]]*//p' /proc/cpuinfo 2>/dev/null | head -1)
[ -n "$HOST_CPU" ] || HOST_CPU=unavailable
HOST_IDENTITY_SHA=$(printf 'hostname=%s\nuname=%s\ncpu=%s\n' "$HOST_NAME" "$HOST_UNAME" "$HOST_CPU" | sha256sum | awk '{print $1}')

WORK=$(mktemp -d "${TMPDIR:-/tmp}/interpreter-hash-memo.XXXXXX") || blocked "cannot create work directory"
trap 'rm -rf "$WORK"' EXIT INT TERM
FIXTURE_MANIFEST="$WORK/fixtures.manifest"
HOT_UNCACHED_SHA=$(hash_file "$HOT_UNCACHED")
HOT_MEMO_SHA=$(hash_file "$HOT_MEMO")
MISS_UNCACHED_SHA=$(hash_file "$MISS_UNCACHED")
MISS_MEMO_SHA=$(hash_file "$MISS_MEMO")
LOAD_FAST_SHA=$(hash_file "$LOAD_FAST")
SLOW_ENV_SHA=$(hash_file "$SLOW_ENV")
printf '%s %s\n' "$HOT_UNCACHED_SHA" "$HOT_UNCACHED" >>"$FIXTURE_MANIFEST"
printf '%s %s\n' "$HOT_MEMO_SHA" "$HOT_MEMO" >>"$FIXTURE_MANIFEST"
printf '%s %s\n' "$MISS_UNCACHED_SHA" "$MISS_UNCACHED" >>"$FIXTURE_MANIFEST"
printf '%s %s\n' "$MISS_MEMO_SHA" "$MISS_MEMO" >>"$FIXTURE_MANIFEST"
printf '%s %s\n' "$LOAD_FAST_SHA" "$LOAD_FAST" >>"$FIXTURE_MANIFEST"
printf '%s %s\n' "$SLOW_ENV_SHA" "$SLOW_ENV" >>"$FIXTURE_MANIFEST"
FIXTURE_MANIFEST_SHA=$(hash_file "$FIXTURE_MANIFEST")
for lane in hot_uncached hot_memo miss_uncached miss_memo load_fast slow_env; do
    : >"$WORK/$lane.raw"
done
: >"$WORK/interleave.raw"

run_lane() {
    _sample=$1
    _lane=$2
    _fixture=$3
    _expected=$4
    _stdout="$WORK/${_sample}.${_lane}.stdout"
    _stderr="$WORK/${_sample}.${_lane}.stderr"
    _timing="$WORK/${_sample}.${_lane}.timing"

    set +e
    SIMPLE_EXECUTION_MODE=interpret SIMPLE_NO_JIT=1 SIMPLE_NO_STUB_FALLBACK=1 \
        SIMPLE_LIB="$ROOT_DIR/src" "$TIME_TOOL_REAL" -f '%e %M' -o "$_timing" \
        "$SIMPLE_REAL" run "$_fixture" >"$_stdout" 2>"$_stderr"
    _rc=$?
    set -e
    [ "$_rc" -eq 0 ] || blocked "sample=$_sample lane=$_lane exited $_rc"
    _actual=$(awk 'NF {last=$0} END {print last}' "$_stdout")
    [ "$_actual" = "$_expected" ] || blocked "sample=$_sample lane=$_lane checksum/output mismatch"
    set -- $(awk 'NF == 2 {print $1, $2; exit}' "$_timing")
    [ "$#" -eq 2 ] || blocked "sample=$_sample lane=$_lane timing row malformed"
    _elapsed_ms=$(awk -v seconds="$1" 'BEGIN {print int(seconds * 1000 + 0.5)}')
    _rss_kib=$2
    case "$_elapsed_ms:$_rss_kib" in *[!0-9:]*|:*) blocked "sample=$_sample lane=$_lane timing values invalid" ;; esac
    _stdout_sha=$(hash_file "$_stdout")
    _stderr_sha=$(hash_file "$_stderr")
    printf '%s %s %s %s\n' "$_elapsed_ms" "$_rss_kib" "$_stdout_sha" "$_stderr_sha" >>"$WORK/$_lane.raw"
    printf '%s:%s,' "$_sample" "$_lane" >>"$WORK/interleave.raw"
}

sample=1
while [ "$sample" -le "$N" ]; do
    if [ $((sample % 2)) -eq 1 ]; then
        run_lane "$sample" hot_uncached "$HOT_UNCACHED" "hash-uncached 25000 3338400000"
        run_lane "$sample" hot_memo "$HOT_MEMO" "hash-hot 25000 3338400000 hits=99996 misses=4"
        run_lane "$sample" miss_uncached "$MISS_UNCACHED" "hash-miss-uncached 4096 131475810"
        run_lane "$sample" miss_memo "$MISS_MEMO" "hash-miss-memo 4096 131475810 entries=8 hits=0 misses=4096"
        run_lane "$sample" load_fast "$LOAD_FAST" "identifier-load-fast 15575000 hits=99996 misses=4"
        run_lane "$sample" slow_env "$SLOW_ENV" "identifier-slow-env 15000000 hits=99996 misses=4"
    else
        run_lane "$sample" slow_env "$SLOW_ENV" "identifier-slow-env 15000000 hits=99996 misses=4"
        run_lane "$sample" load_fast "$LOAD_FAST" "identifier-load-fast 15575000 hits=99996 misses=4"
        run_lane "$sample" miss_memo "$MISS_MEMO" "hash-miss-memo 4096 131475810 entries=8 hits=0 misses=4096"
        run_lane "$sample" miss_uncached "$MISS_UNCACHED" "hash-miss-uncached 4096 131475810"
        run_lane "$sample" hot_memo "$HOT_MEMO" "hash-hot 25000 3338400000 hits=99996 misses=4"
        run_lane "$sample" hot_uncached "$HOT_UNCACHED" "hash-uncached 25000 3338400000"
    fi
    sample=$((sample + 1))
done

for lane in hot_uncached hot_memo miss_uncached miss_memo load_fast slow_env; do
    [ "$(wc -l <"$WORK/$lane.raw" | tr -d ' ')" -eq "$N" ] || blocked "lane=$lane did not retain exactly N=$N samples"
done

HOT_UNCACHED_P50=$(percentile_column "$WORK/hot_uncached.raw" 1 50)
HOT_UNCACHED_P95=$(percentile_column "$WORK/hot_uncached.raw" 1 95)
HOT_MEMO_P50=$(percentile_column "$WORK/hot_memo.raw" 1 50)
HOT_MEMO_P95=$(percentile_column "$WORK/hot_memo.raw" 1 95)
MISS_UNCACHED_P50=$(percentile_column "$WORK/miss_uncached.raw" 1 50)
MISS_UNCACHED_P95=$(percentile_column "$WORK/miss_uncached.raw" 1 95)
MISS_MEMO_P50=$(percentile_column "$WORK/miss_memo.raw" 1 50)
MISS_MEMO_P95=$(percentile_column "$WORK/miss_memo.raw" 1 95)
LOAD_FAST_P50=$(percentile_column "$WORK/load_fast.raw" 1 50)
LOAD_FAST_P95=$(percentile_column "$WORK/load_fast.raw" 1 95)
SLOW_ENV_P50=$(percentile_column "$WORK/slow_env.raw" 1 50)
SLOW_ENV_P95=$(percentile_column "$WORK/slow_env.raw" 1 95)
HOT_P50_RATIO_BP=$(ratio_bp "$HOT_MEMO_P50" "$HOT_UNCACHED_P50")
HOT_P95_RATIO_BP=$(ratio_bp "$HOT_MEMO_P95" "$HOT_UNCACHED_P95")
MISS_P50_RATIO_BP=$(ratio_bp "$MISS_MEMO_P50" "$MISS_UNCACHED_P50")
MISS_P95_RATIO_BP=$(ratio_bp "$MISS_MEMO_P95" "$MISS_UNCACHED_P95")

STATUS=pass
REASON=admitted-stage4-interleaved-evidence
[ "$HOT_P50_RATIO_BP" -le 10000 ] && [ "$HOT_P95_RATIO_BP" -le 10000 ] || {
    STATUS=fail
    REASON=hot-memo-regression
}
[ "$MISS_P50_RATIO_BP" -le 12500 ] && [ "$MISS_P95_RATIO_BP" -le 12500 ] || {
    STATUS=fail
    REASON=miss-heavy-regression-over-25-percent
}

# Revalidate all claim-bearing identities after sampling. A raced source,
# harness, executable, timing tool, or provenance receipt invalidates the row.
[ "$(hash_file "$SIMPLE_REAL")" = "$BINARY_SHA" ] || blocked "binary changed during sampling"
[ "$(hash_file "$PROVENANCE_REAL")" = "$PROVENANCE_SHA" ] || blocked "provenance changed during sampling"
[ "$(hash_file "$SUBJECT_SOURCE")" = "$SUBJECT_SHA" ] || blocked "subject source changed during sampling"
[ "$(hash_file "$HARNESS_PATH")" = "$HARNESS_SHA" ] || blocked "harness changed during sampling"
[ "$(hash_file "$TIME_TOOL_REAL")" = "$TIME_TOOL_SHA" ] || blocked "timing tool changed during sampling"
FIXTURE_MANIFEST_AFTER="$WORK/fixtures.after.manifest"
for fixture in "$HOT_UNCACHED" "$HOT_MEMO" "$MISS_UNCACHED" "$MISS_MEMO" "$LOAD_FAST" "$SLOW_ENV"; do
    printf '%s %s\n' "$(hash_file "$fixture")" "$fixture" >>"$FIXTURE_MANIFEST_AFTER"
done
[ "$(hash_file "$FIXTURE_MANIFEST_AFTER")" = "$FIXTURE_MANIFEST_SHA" ] || blocked "fixture set changed during sampling"
stage4_verify_candidate_provenance "$PROVENANCE_REAL" "$SIMPLE_REAL" "$ROOT_DIR" ||
    blocked "Stage4 provenance/source verification changed during sampling"

mkdir -p "$OUTPUT_DIR"
STAMP=$(date -u '+%Y%m%dT%H%M%SZ')
RECEIPT="$OUTPUT_DIR/interpreter_hash_memo_${STAMP}_$$.env"
TMP_RECEIPT="$WORK/receipt.env"

{
    echo "schema=interpreter-hash-memo-perf-evidence-v1"
    echo "status=$STATUS"
    echo "reason=$REASON"
    echo "sample_count=$N"
    echo "interleave_strategy=alternating-forward-reverse-within-each-sample"
    echo "interleave_order_raw=$(cat "$WORK/interleave.raw")"
    echo "binary_path=$SIMPLE_REAL"
    echo "binary_sha256=$BINARY_SHA"
    echo "binary_provenance_path=$PROVENANCE_REAL"
    echo "binary_provenance_sha256=$PROVENANCE_SHA"
    echo "source_revision_kind=content-sha256"
    echo "source_revision=$SOURCE_REVISION"
    echo "subject_source_path=$SUBJECT_SOURCE"
    echo "subject_source_sha256=$SUBJECT_SHA"
    echo "fixture_manifest_sha256=$FIXTURE_MANIFEST_SHA"
    echo "hot_uncached_fixture_path=$HOT_UNCACHED"
    echo "hot_uncached_fixture_sha256=$HOT_UNCACHED_SHA"
    echo "hot_memo_fixture_path=$HOT_MEMO"
    echo "hot_memo_fixture_sha256=$HOT_MEMO_SHA"
    echo "miss_uncached_fixture_path=$MISS_UNCACHED"
    echo "miss_uncached_fixture_sha256=$MISS_UNCACHED_SHA"
    echo "miss_memo_fixture_path=$MISS_MEMO"
    echo "miss_memo_fixture_sha256=$MISS_MEMO_SHA"
    echo "load_fast_fixture_path=$LOAD_FAST"
    echo "load_fast_fixture_sha256=$LOAD_FAST_SHA"
    echo "slow_env_fixture_path=$SLOW_ENV"
    echo "slow_env_fixture_sha256=$SLOW_ENV_SHA"
    echo "harness_path=$HARNESS_PATH"
    echo "harness_sha256=$HARNESS_SHA"
    echo "timing_tool_path=$TIME_TOOL_REAL"
    echo "timing_tool_sha256=$TIME_TOOL_SHA"
    echo "command_template=SIMPLE_EXECUTION_MODE=interpret SIMPLE_NO_JIT=1 SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_LIB=<root>/src <time> -f %e_%M <stage4> run <fixture>"
    echo "host_name=$HOST_NAME"
    echo "host_uname=$HOST_UNAME"
    echo "host_cpu=$HOST_CPU"
    echo "host_identity_sha256=$HOST_IDENTITY_SHA"
    for lane in hot_uncached hot_memo miss_uncached miss_memo load_fast slow_env; do
        echo "${lane}_elapsed_ms_raw=$(join_column "$WORK/$lane.raw" 1)"
        echo "${lane}_rss_kib_raw=$(join_column "$WORK/$lane.raw" 2)"
        echo "${lane}_stdout_sha256_raw=$(join_column "$WORK/$lane.raw" 3)"
        echo "${lane}_stderr_sha256_raw=$(join_column "$WORK/$lane.raw" 4)"
    done
    echo "hot_uncached_p50_ms=$HOT_UNCACHED_P50"
    echo "hot_uncached_p95_ms=$HOT_UNCACHED_P95"
    echo "hot_memo_p50_ms=$HOT_MEMO_P50"
    echo "hot_memo_p95_ms=$HOT_MEMO_P95"
    echo "hot_memo_p50_ratio_bp=$HOT_P50_RATIO_BP"
    echo "hot_memo_p95_ratio_bp=$HOT_P95_RATIO_BP"
    echo "miss_uncached_p50_ms=$MISS_UNCACHED_P50"
    echo "miss_uncached_p95_ms=$MISS_UNCACHED_P95"
    echo "miss_memo_p50_ms=$MISS_MEMO_P50"
    echo "miss_memo_p95_ms=$MISS_MEMO_P95"
    echo "miss_memo_p50_ratio_bp=$MISS_P50_RATIO_BP"
    echo "miss_memo_p95_ratio_bp=$MISS_P95_RATIO_BP"
    echo "load_fast_p50_ms=$LOAD_FAST_P50"
    echo "load_fast_p95_ms=$LOAD_FAST_P95"
    echo "slow_env_p50_ms=$SLOW_ENV_P50"
    echo "slow_env_p95_ms=$SLOW_ENV_P95"
} >"$TMP_RECEIPT"

[ ! -e "$RECEIPT" ] && [ ! -L "$RECEIPT" ] || blocked "receipt target already exists: $RECEIPT"
mv "$TMP_RECEIPT" "$RECEIPT"
chmod a-w "$RECEIPT" 2>/dev/null || true
echo "receipt=$RECEIPT"
if [ "$STATUS" = pass ]; then
    echo "STATUS: PASS interpreter-hash-memo admitted Stage4 N=$N hot_p50_ratio_bp=$HOT_P50_RATIO_BP hot_p95_ratio_bp=$HOT_P95_RATIO_BP miss_p50_ratio_bp=$MISS_P50_RATIO_BP miss_p95_ratio_bp=$MISS_P95_RATIO_BP"
    exit 0
fi
echo "STATUS: FAIL interpreter-hash-memo admitted Stage4 N=$N reason=$REASON hot_p50_ratio_bp=$HOT_P50_RATIO_BP hot_p95_ratio_bp=$HOT_P95_RATIO_BP miss_p50_ratio_bp=$MISS_P50_RATIO_BP miss_p95_ratio_bp=$MISS_P95_RATIO_BP" >&2
exit 1
