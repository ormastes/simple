#!/bin/sh
# AOT lane smoke gate — the ONLY routine check that exercises native-build.
#
# WHY: specs run interpreter/JIT only; AOT-lane defects are structurally
# invisible to the spec corpus (see reference_aot_lane_defects_are_invisible
# and doc/08_tracking/bug/aot_llvm_void_type_struct_probe_2026-08-10.md,
# where an invalid-IR emission for ANY struct-bearing program sat unnoticed).
# This gate native-builds a minimal struct program, RUNS it, and asserts the
# printed values — absence-of-error is not the oracle, output is.
#
# Verdict convention (matches other scripts/check gates):
#   PASS — 1 probe checked   exit 0
#   FAIL — ...               exit 1
#   ERROR — nothing was checked  exit 2
set -u
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
cd "$ROOT" || { echo "ERROR — nothing was checked (no repo root)"; exit 2; }
[ -x bin/simple ] || { echo "ERROR — nothing was checked (bin/simple missing)"; exit 2; }

TMPD=$(mktemp -d "${TMPDIR:-/tmp}/aot_smoke.XXXXXX") || { echo "ERROR — nothing was checked (mktemp)"; exit 2; }
trap 'rm -rf "$TMPD"' EXIT
# native-build rejects absolute --entry paths: keep the probe path RELATIVE.
PROBE="tmp_aot_smoke_$$.spl"
OUT="tmp_aot_smoke_$$_bin"
trap 'rm -rf "$TMPD" "$PROBE" "$OUT"' EXIT
cat > "$PROBE" <<'EOF'
struct Flat:
    x: f64
    n: i64

fn main():
    var a = Flat(x: 1.5, n: 7)
    var b = a
    b.n = 99
    print("a.n={a.n}")
    print("b.n={b.n}")
    print("a.x={a.x}")
    print("ctl=42")
EOF

echo "binary: $(readlink -f bin/simple)"
timeout "${AOT_SMOKE_TIMEOUT:-900}" bin/simple native-build "$PROBE" -o "$OUT" >"$TMPD/build.log" 2>&1
BEXIT=$?
if [ "$BEXIT" -eq 124 ] || [ "$BEXIT" -eq 143 ]; then
    echo "ERROR — nothing was checked (native-build killed/timed out, exit $BEXIT — host saturation, not a verdict)"
    exit 2
fi
if [ "$BEXIT" -ne 0 ] || [ ! -x "$OUT" ]; then
    grep -m 3 -i 'error' "$TMPD/build.log" || true
    echo "FAIL — AOT lane broken: native-build exit $BEXIT, binary $( [ -x "$OUT" ] && echo present || echo absent )"
    exit 1
fi
GOT=$(timeout 30 "./$OUT" 2>/dev/null)
WANT_A="a.n=7"; WANT_B="b.n=99"; WANT_X="a.x=1.5"; WANT_C="ctl=42"
# WANT_X fences the f64-struct-field interpolation defect: an untagged
# FloatValue reaching FStringFormat was bitcast, printing the IEEE-754 bit
# pattern (1.5 -> 4609434218613702656) instead of "1.5". See
# doc/08_tracking/bug/aot_llvm_void_type_struct_probe_2026-08-10.md.
case "$GOT" in
    *"$WANT_A"*"$WANT_B"*"$WANT_X"*"$WANT_C"*)
        echo "PASS — 1 probe checked (built, ran, struct copy + f64 field formatting verified: $WANT_A $WANT_B $WANT_X)"
        exit 0 ;;
    *)
        echo "got: $GOT"
        echo "FAIL — AOT binary ran but output wrong (wanted $WANT_A/$WANT_B/$WANT_X/$WANT_C)"
        exit 1 ;;
esac
