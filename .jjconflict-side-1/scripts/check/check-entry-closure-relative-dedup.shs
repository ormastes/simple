#!/bin/sh
set -eu

# Static fail-fast gate for the pure-Simple entry-closure owner. Relative
# module names repeat across packages (`.file_ops`, `.types`, ...); the seen
# key must include the declaring directory or later sibling surfaces vanish
# and qualified receivers decay into unresolved GlobalLoad nodes.
owner=src/compiler/80.driver/driver_source_pipeline_loading.spl

test -f "$owner"
grep -Fq 'val closure_import_key = if closure_mp.starts_with("."):' "$owner"
grep -Fq 'closure_dir + "::" + closure_mp' "$owner"
grep -Fq '_driver_text_bucket_set_has(closure_seen_mods, closure_import_key)' "$owner"
grep -Fq 'closure_seen_mods[closure_import_key] = true' "$owner"

# Reject the exact global-dedup shape recorded in the retained bootstrap
# receipts. These checks read one owner file and allocate no runtime material.
if grep -Fq '_driver_text_bucket_set_has(closure_seen_mods, closure_mp)' "$owner"; then
    echo "entry-closure relative imports are still deduplicated globally" >&2
    exit 1
fi
if grep -Fq 'closure_seen_mods[closure_mp] = true' "$owner"; then
    echo "entry-closure relative import insertion still uses a global key" >&2
    exit 1
fi

echo "entry-closure relative import dedup: PASS"
