#!/bin/sh
# Finalize one signed MCI-v2 SimpleOS target collector receipt.
# Fixture mode is contract-only and never produces an admissible live claim.
set -eu
LC_ALL=C; export LC_ALL

usage() {
    echo "usage: $0 --mode fixture|live --evidence DIR --bundle DIR --cell HOST:GUEST --run-id ID --source-hash SHA256 --compiler-receipt-hash SHA256 --configuration-hash SHA256 --image IMAGE --collector-key-id ID --collector-private-key PEM [--contract-fixture] [--captured-at-utc-ns NS --valid-until-utc-ns NS --stress-started-at-utc-ns NS --stress-ended-at-utc-ns NS]" >&2
    exit 2
}
mode= bundle= evidence= cell= run_id= source_hash= compiler_hash= config_hash= image=
collector_key_id= private_key= fixture=false captured= valid_until= stress_started= stress_ended=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --mode) [ "$#" -ge 2 ] || usage; mode=$2; shift 2;;
        --evidence) [ "$#" -ge 2 ] || usage; evidence=$2; shift 2;;
        --bundle) [ "$#" -ge 2 ] || usage; bundle=$2; shift 2;;
        --cell) [ "$#" -ge 2 ] || usage; cell=$2; shift 2;;
        --run-id) [ "$#" -ge 2 ] || usage; run_id=$2; shift 2;;
        --source-hash) [ "$#" -ge 2 ] || usage; source_hash=$2; shift 2;;
        --compiler-receipt-hash) [ "$#" -ge 2 ] || usage; compiler_hash=$2; shift 2;;
        --configuration-hash) [ "$#" -ge 2 ] || usage; config_hash=$2; shift 2;;
        --image) [ "$#" -ge 2 ] || usage; image=$2; shift 2;;
        --collector-key-id) [ "$#" -ge 2 ] || usage; collector_key_id=$2; shift 2;;
        --collector-private-key) [ "$#" -ge 2 ] || usage; private_key=$2; shift 2;;
        --contract-fixture) fixture=true; shift;;
        --captured-at-utc-ns) [ "$#" -ge 2 ] || usage; captured=$2; shift 2;;
        --valid-until-utc-ns) [ "$#" -ge 2 ] || usage; valid_until=$2; shift 2;;
        --stress-started-at-utc-ns) [ "$#" -ge 2 ] || usage; stress_started=$2; shift 2;;
        --stress-ended-at-utc-ns) [ "$#" -ge 2 ] || usage; stress_ended=$2; shift 2;;
        *) usage;;
    esac
done
die() { echo "mci-simpleos-collector: $*" >&2; exit 2; }
safe_token() { case "$1" in ''|*[!A-Za-z0-9._-]*) return 1;; esac; }
is_hash() { [ "${#1}" -eq 64 ] && case "$1" in *[!0-9a-f]*) return 1;; esac; }
is_uint() { case "$1" in ''|*[!0-9]*) return 1;; esac; }
diff_is_day() {
    awk -v a="$1" -v b="$2" 'BEGIN{sub(/^0+/,"",a);sub(/^0+/,"",b);if(a=="")a="0";if(b=="")b="0";if(length(b)<length(a)||(length(b)==length(a)&&b<a))exit 1;borrow=0;out="";i=length(b);j=length(a);while(i>0){x=substr(b,i,1)+0-borrow;y=(j>0?substr(a,j,1)+0:0);if(x<y){x+=10;borrow=1}else borrow=0;out=(x-y)out;i--;j--}sub(/^0+/,"",out);if(out=="")out="0";exit !(out=="86400000000000")}'
}
hash_file() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'; else shasum -a 256 "$1" | awk '{print $1}'; fi; }
regular() { [ -f "$1" ] && [ ! -L "$1" ]; }
copy_regular() {
    regular "$1" || die "missing or unsafe input: $1"
    mkdir -p "$(dirname "$2")"; cp -- "$1" "$2"; regular "$2" || die "copy failed: $1"
    [ "$(hash_file "$1")" = "$(hash_file "$2")" ] || die "copy hash changed: $1"
}
case "$mode" in fixture|live) ;; *) usage;; esac
[ -n "$bundle" ] && [ -d "$bundle" ] && [ -n "$evidence" ] && [ -n "$cell" ] && [ -n "$run_id" ] || usage
is_hash "$source_hash" && is_hash "$compiler_hash" && is_hash "$config_hash" || usage
safe_token "$run_id" && safe_token "$collector_key_id" && regular "$private_key" || usage
case "$cell" in *:*) host=${cell%%:*}; guest=${cell#*:};; *) die 'cell must be HOST:GUEST';; esac
case "$host" in linux|windows|macos|freebsd) ;; *) die 'unsupported host identity';; esac
case "$guest" in x86_32|x86_64|arm32|arm64|riscv32|riscv64) ;; *) die 'unsupported guest identity';; esac
if [ "$mode" = fixture ]; then
    [ "$fixture" = true ] || die 'fixture mode requires --contract-fixture'
else
    [ "$fixture" = false ] || die 'live mode forbids --contract-fixture'
fi
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
case "$evidence" in /*) evidence_abs=$evidence;; *) evidence_abs=$root/$evidence;; esac
case "$bundle" in /*) bundle_abs=$bundle;; *) bundle_abs=$root/$bundle;; esac
case "$image" in /*) image_abs=$image;; *) image_abs=$root/$image;; esac
case "$evidence_abs" in "$root"/*) ;; *) die 'evidence must be below repository root';; esac
case "$bundle_abs" in "$root"/*) ;; *) die 'bundle must be below repository root';; esac
case "$image_abs" in "$root"/*) ;; *) die 'image must be below repository root';; esac
regular "$image_abs" || die 'image missing or unsafe'
mkdir -p "$evidence_abs/collectors" "$evidence_abs/signatures"
[ ! -L "$evidence_abs/collectors" ] && [ ! -L "$evidence_abs/signatures" ] || die 'unsafe evidence directory'
prefix=$host-$guest; receipt=$evidence_abs/collectors/$prefix.receipt; signature=$evidence_abs/signatures/$prefix.sig
[ ! -e "$receipt" ] && [ ! -e "$signature" ] || die 'evidence collision'
if [ -z "$captured" ]; then [ "$mode" = fixture ] && captured=100000000000000 || captured=$(date +%s%N); fi
if [ -z "$valid_until" ]; then [ "$mode" = fixture ] && valid_until=186400000000000 || valid_until=$((captured + 86400000000000)); fi
if [ -z "$stress_started" ]; then [ "$mode" = fixture ] && stress_started=13600000000000 || die 'live mode requires stress start time'; fi
if [ -z "$stress_ended" ]; then [ "$mode" = fixture ] && stress_ended=100000000000000 || die 'live mode requires stress end time'; fi
is_uint "$captured" && is_uint "$valid_until" && is_uint "$stress_started" && is_uint "$stress_ended" || die 'timestamps must be unsigned decimal'
work=$(mktemp -d "$root/build/mci-simpleos-collector.XXXXXX"); trap 'rm -rf "$work"' EXIT HUP INT TERM
for f in version compile run resources invariants; do
    regular "$bundle_abs/$f.raw" && regular "$bundle_abs/$f.command" || die "bundle missing $f inputs"
done
for f in usr-bin bin sys-apps simpletool.sdn; do regular "$bundle_abs/payload/$f" || die "bundle missing payload/$f"; done
for f in version compile run resources invariants; do
    command_text=$(cat "$bundle_abs/$f.command"); [ -n "$command_text" ] || die "empty $f command"
    printf '%s' "$command_text" | (command -v sha256sum >/dev/null 2>&1 && sha256sum || shasum -a 256) | awk '{print $1}' > "$work/$f.command.sha256"
    if [ "$mode" = live ]; then
        command -v timeout >/dev/null 2>&1 || die 'timeout is required for live collection'
        timeout --signal=TERM --kill-after=5 "${MCI_SIMPLEOS_COMMAND_TIMEOUT_SECONDS:-1800}" sh -c "$command_text" > "$work/$f.raw" 2>&1 || die "$f command failed or timed out"
    else
        copy_regular "$bundle_abs/$f.raw" "$work/$f.raw"
    fi
done
grep -Eq '^Simple [0-9]+\.[0-9]+\.[0-9]+ \(pure-Simple\)$' "$work/version.raw" || die 'version transcript is not pure-Simple'
grep -Eq '^compile_result=pass$' "$work/compile.raw" || die 'compile transcript lacks pass'
[ "$(cat "$work/run.raw")" = 'hello world' ] || die 'run transcript is not exact hello world'
awk -F'|' '/^sample\|[0-9]+\|[0-9]+\|[0-9]+\|[0-9]+$/{n++;next}{bad=1}END{exit !(n>0&&bad==0)}' "$work/resources.raw" || die 'stress resources malformed'
awk -F'|' '/^check\|[A-Za-z0-9._-]+\|pass\|0$/{n++;next}{bad=1}END{exit !(n>0&&bad==0)}' "$work/invariants.raw" || die 'stress invariant ledger malformed'
[ "$stress_ended" -ge "$stress_started" ] || die 'stress timestamps reversed'
diff_is_day "$stress_started" "$stress_ended" || die 'stress evidence must cover exactly 24 hours'
image_hash=$(hash_file "$image_abs"); usr_hash=$(hash_file "$bundle_abs/payload/usr-bin"); bin_hash=$(hash_file "$bundle_abs/payload/bin")
apps_hash=$(hash_file "$bundle_abs/payload/sys-apps"); sdn_hash=$(hash_file "$bundle_abs/payload/simpletool.sdn")
for f in version compile run resources invariants; do copy_regular "$work/$f.raw" "$evidence_abs/collectors/$prefix-$f.raw"; done
common_artifact() { echo artifact_schema=$1; echo cell_id="$cell"; echo run_id="$run_id"; echo host_identity=host-$host; echo guest_identity=guest-$guest; }
version_e=$work/version.evidence; compile_e=$work/compile.evidence; run_e=$work/run.evidence; alias_e=$work/aliases.evidence; resources_e=$work/resources.evidence; invariants_e=$work/invariants.evidence
version_cmd_hash=$(cat "$work/version.command.sha256"); compile_cmd_hash=$(cat "$work/compile.command.sha256"); run_cmd_hash=$(cat "$work/run.command.sha256")
{ common_artifact simpleos-version-transcript-v1; echo command_sha256="$version_cmd_hash"; echo exit_code=0; echo version_text_sha256="$(hash_file "$work/version.raw")"; echo raw_relpath=collectors/$prefix-version.raw; echo raw_sha256="$(hash_file "$work/version.raw")"; echo result=pass; } > "$version_e"
compile_output_hash=$(sed -n 's/^output_sha256=\([0-9a-f]\{64\}\)$/\1/p' "$work/compile.raw"); [ -n "$compile_output_hash" ] || compile_output_hash=$usr_hash
{ common_artifact simpleos-compile-transcript-v1; echo command_sha256="$compile_cmd_hash"; echo exit_code=0; echo source_hash="$source_hash"; echo output_sha256="$compile_output_hash"; echo transcript_body_sha256="$(hash_file "$work/compile.raw")"; echo raw_relpath=collectors/$prefix-compile.raw; echo raw_sha256="$(hash_file "$work/compile.raw")"; echo result=pass; } > "$compile_e"
{ common_artifact simpleos-run-transcript-v1; echo command_sha256="$run_cmd_hash"; echo exit_code=0; echo image_hash="$image_hash"; echo payload_sha256="$usr_hash"; echo stdout_sha256="$(hash_file "$work/run.raw")"; echo raw_relpath=collectors/$prefix-run.raw; echo raw_sha256="$(hash_file "$work/run.raw")"; echo result=pass; } > "$run_e"
{ common_artifact simpleos-alias-identity-v1; echo usr_bin_sha256="$usr_hash"; echo bin_sha256="$bin_hash"; echo sys_apps_sha256="$apps_hash"; echo sys_simpletool_sdn_sha256="$sdn_hash"; echo result=pass; } > "$alias_e"
{ common_artifact simpleos-stress-resource-series-v1; echo started_at_utc_ns="$stress_started"; echo ended_at_utc_ns="$stress_ended"; echo sample_count="$(grep -c '^sample|' "$work/resources.raw")"; awk -F'|' 'BEGIN{loR=hiR=loC=hiC=loS=hiS=""} /^sample\|/{r=$3;c=$4;s=$5;if(loR==""||r<loR)loR=r;if(hiR==""||r>hiR)hiR=r;if(loC==""||c<loC)loC=c;if(hiC==""||c>hiC)hiC=c;if(loS==""||s<loS)loS=s;if(hiS==""||s>hiS)hiS=s} END{print "rss_min_bytes="loR;print "rss_max_bytes="hiR;print "cpu_min_millis="loC;print "cpu_max_millis="hiC;print "storage_min_bytes="loS;print "storage_max_bytes="hiS}' "$work/resources.raw"; echo samples_sha256="$(hash_file "$work/resources.raw")"; echo raw_relpath=collectors/$prefix-resources.raw; echo raw_sha256="$(hash_file "$work/resources.raw")"; echo result=pass; } > "$resources_e"
{ common_artifact simpleos-stress-invariant-ledger-v1; echo check_count="$(grep -c '^check|' "$work/invariants.raw")"; echo violation_count=0; echo ledger_body_sha256="$(hash_file "$work/invariants.raw")"; echo raw_relpath=collectors/$prefix-invariants.raw; echo raw_sha256="$(hash_file "$work/invariants.raw")"; echo result=pass; } > "$invariants_e"
for f in version compile run aliases resources invariants; do copy_regular "$work/$f.evidence" "$evidence_abs/collectors/$prefix-$f.evidence"; done
canonical=$work/canonical
{
    echo collector_schema=simpleos-qemu-host-collector-v1
    if [ "$mode" = fixture ]; then echo attestation=contract-only-v1; else echo attestation=signed-real-v1; fi
    echo collector_key_id="$collector_key_id"
    echo cell_id="$cell"; echo host_identity=host-$host; echo guest_identity=guest-$guest; echo run_id="$run_id"; echo source_hash="$source_hash"; echo compiler_receipt_hash="$compiler_hash"; echo configuration_hash="$config_hash"; echo image_hash="$image_hash"
    echo qemu_or_host_collector=real; echo target_side=true; echo guest_filesystem_execution=true; echo payload_paths=/usr/bin,/bin,/sys/apps,/SYS/SIMPLETOOL.SDN
    echo usr_bin_sha256="$usr_hash"; echo bin_sha256="$bin_hash"; echo sys_apps_sha256="$apps_hash"; echo sys_simpletool_sdn_sha256="$sdn_hash"
    echo captured_at_utc_ns="$captured"; echo valid_until_utc_ns="$valid_until"; echo payload_execution_schema=simpleos-payload-execution-v1
    echo version_command_sha256="$version_cmd_hash"; echo version_exit_code=0; echo version_transcript_relpath=collectors/$prefix-version.evidence; echo version_transcript_sha256="$(hash_file "$version_e")"
    echo compile_command_sha256="$compile_cmd_hash"; echo compile_exit_code=0; echo compile_transcript_relpath=collectors/$prefix-compile.evidence; echo compile_transcript_sha256="$(hash_file "$compile_e")"
    echo run_command_sha256="$run_cmd_hash"; echo run_exit_code=0; echo run_transcript_relpath=collectors/$prefix-run.evidence; echo run_transcript_sha256="$(hash_file "$run_e")"
    echo alias_identity_relpath=collectors/$prefix-aliases.evidence; echo alias_identity_sha256="$(hash_file "$alias_e")"
    echo stress_schema=simpleos-stress-receipt-v1; echo stress_started_at_utc_ns="$stress_started"; echo stress_ended_at_utc_ns="$stress_ended"; echo stress_duration_ns=86400000000000
    echo stress_resource_series_relpath=collectors/$prefix-resources.evidence; echo stress_resource_series_sha256="$(hash_file "$resources_e")"; echo stress_invariant_violations=0; echo stress_invariant_ledger_relpath=collectors/$prefix-invariants.evidence; echo stress_invariant_ledger_sha256="$(hash_file "$invariants_e")"
} > "$canonical"
cp -- "$canonical" "$receipt"
echo receipt_hash="$(hash_file "$canonical")" >> "$receipt"
openssl dgst -sha256 -sign "$private_key" -out "$signature" "$canonical" || die 'receipt signing failed'
[ "$(hash_file "$canonical")" = "$(sed -n 's/^receipt_hash=//p' "$receipt")" ] || die 'receipt hash publication mismatch'
[ "$mode" = fixture ] && echo mode=CONTRACT_ONLY || echo mode=LIVE
echo "receipt=$receipt"; echo "signature=$signature"
