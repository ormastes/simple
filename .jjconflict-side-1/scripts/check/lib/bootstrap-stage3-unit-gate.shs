#!/usr/bin/dash
set -eu

phase=
heavy_lock_path=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --phase=*) phase=${1#*=} ;;
    --heavy-lock=*) heavy_lock_path=${1#*=} ;;
    --) shift; break ;;
    *) echo "stage3 unit gate: invalid option: $1" >&2; exit 64 ;;
  esac
  shift
done
[ "$#" -gt 0 ] || { echo "stage3 unit gate: missing payload" >&2; exit 64; }

gate_marker=
IFS= read -r gate_marker || [ -n "$gate_marker" ] || {
  echo "stage3 unit gate: pre-exec authority is absent" >&2
  exit 70
}
[ "$gate_marker" = G ] || {
  echo "stage3 unit gate: invalid pre-exec authority" >&2
  exit 70
}
gate_trailer=
if IFS= read -r gate_trailer || [ -n "$gate_trailer" ]; then
  echo "stage3 unit gate: trailing pre-exec authority data" >&2
  exit 70
fi

case "$phase" in
  stage2)
    case "$heavy_lock_path" in
      /*) ;;
      *) echo "stage3 unit gate: invalid heavy-lock path" >&2; exit 70 ;;
    esac
    [ -f "$heavy_lock_path" ] && [ ! -L "$heavy_lock_path" ] || {
      echo "stage3 unit gate: invalid heavy-lock authority" >&2
      exit 70
    }
    [ "${SIMPLE_STAGE3_OUTER_LOCK_HELD+x}" != x ] || {
      echo "stage3 unit gate: caller supplied private authority marker" >&2
      exit 70
    }
    # In Stage 2 the supervisor gives systemd-run its already-locked OFD as
    # stdout.  Preserve that sole capability on fixed descriptor 9 before
    # restoring payload stdout to the diagnostic stream.  This is a dup of the
    # supervisor's flock owner, never a second open or lock acquisition.
    exec 9>&1
    exec 1>&2
    SIMPLE_STAGE3_OUTER_LOCK_HELD=1
    SIMPLE_STAGE3_HEAVY_LOCK_CAPABILITY_FD=9
    export SIMPLE_STAGE3_OUTER_LOCK_HELD \
      SIMPLE_STAGE3_HEAVY_LOCK_CAPABILITY_FD
    transaction_root=
    for payload_arg in "$@"; do
      case "$payload_arg" in
        --transaction-root=*)
          [ -z "$transaction_root" ] || {
            echo "stage3 unit gate: duplicate transaction root" >&2
            exit 70
          }
          transaction_root=${payload_arg#*=}
          ;;
        --output=*|--evidence-dir=*|--private-home=*|--private-tmp=*|--private-cache=*)
          echo "stage3 unit gate: legacy Stage 2 sibling authority" >&2
          exit 70
          ;;
      esac
    done
    case "$transaction_root" in
      /*) ;;
      *) echo "stage3 unit gate: missing transaction root" >&2; exit 70 ;;
    esac
    case "$transaction_root" in
      /|*/|*//*|*/./*|*/../*|*/.|*/..)
        echo "stage3 unit gate: non-canonical transaction root" >&2
        exit 70
        ;;
    esac
    set +e
    "$@" --outer-lock-fd=9 --outer-lock-path="$heavy_lock_path"
    payload_status=$?
    set -e
    for child in output evidence home tmp cache; do
      [ -d "$transaction_root/$child" ] && [ ! -L "$transaction_root/$child" ] || {
        echo "stage3 unit gate: incomplete transaction child $child" >&2
        exit 70
      }
    done
    transaction_receipt=$transaction_root/transaction.env
    [ -f "$transaction_receipt" ] && [ ! -L "$transaction_receipt" ] || {
      echo "stage3 unit gate: transaction receipt is absent" >&2
      exit 70
    }
    receipt_schema=
    receipt_status=
    receipt_exit=
    while IFS= read -r receipt_row; do
      case "$receipt_row" in
        schema=*) [ -z "$receipt_schema" ] || exit 70
          receipt_schema=${receipt_row#*=} ;;
        status=*) [ -z "$receipt_status" ] || exit 70
          receipt_status=${receipt_row#*=} ;;
        exit_code=*) [ -z "$receipt_exit" ] || exit 70
          receipt_exit=${receipt_row#*=} ;;
      esac
    done <"$transaction_receipt"
    [ "$receipt_schema" = simple-bootstrap-stage2-transaction-v1 ] &&
      [ "$receipt_status" = committed ] &&
      [ "$receipt_exit" = "$payload_status" ] || {
        echo "stage3 unit gate: transaction receipt mismatch" >&2
        exit 70
      }
    exit "$payload_status"
    ;;
  stage3)
    [ -z "$heavy_lock_path" ] || {
      echo "stage3 unit gate: Stage 3 received a Stage 2 capability path" >&2
      exit 70
    }
    # dash exports PWD even when launched through env -i.  Keep the Stage 3
    # payload environment equal to the supervisor's explicit allowlist.
    unset PWD
    exec "$@"
    ;;
  *) echo "stage3 unit gate: invalid phase" >&2; exit 64 ;;
esac
