# One-shot startup + bounded-scan performance/RSS receipt for REQ-019.
# This is evidence collection, not the policy owner.

use std.nogc_sync_mut.io.process_ops.{process_run}
use std.nogc_sync_mut.sffi.cli.{cli_get_args, cli_exit}

fn args_after_script() -> [text]:
    val all = cli_get_args()
    var out: [text] = []
    var found = false
    for arg in all:
        if found:
            if arg != "--": out = out.push(arg)
        elif arg.ends_with("mcdc_hal_migration_performance.spl"):
            found = true
    out

fn value(args: [text], name: text, fallback: text) -> text:
    var index = 0
    while index < args.len():
        if args[index] == name and index + 1 < args.len(): return args[index + 1]
        index = index + 1
    fallback

val args = args_after_script()
val runtime = value(args, "--runtime", "bin/simple")
val repo = value(args, "--repo", ".")
val epoch = value(args, "--epoch", "1.0.0-RC")
val result = process_run("/usr/bin/time", ["-f",
    "mcdc_hal_checker_wall_seconds=%e\nmcdc_hal_checker_peak_rss_kb=%M",
    runtime, "run", "scripts/audit/mcdc_hal_migration_check.spl", "--",
    "--repo", repo, "--epoch", epoch])
if result.0 != "": print result.0.trim()
if not result.1.contains("mcdc_hal_checker_wall_seconds=") or
        not result.1.contains("mcdc_hal_checker_peak_rss_kb="):
    print "ERROR migration performance receipt missing wall or peak RSS"
    cli_exit(2)
for line in result.1.split("\n"):
    if line.starts_with("mcdc_hal_checker_"): print line
if result.2 != 0: cli_exit(result.2)
cli_exit(0)
