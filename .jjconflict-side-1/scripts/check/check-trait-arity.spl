# Tier-A trait-conformance arity gate.
#
# Fails when an `impl <Trait> for <Type>:` block defines a method whose arity
# disagrees with the trait declaration it resolves to.  Standing gate for
# doc/08_tracking/bug/trait_conformance_check_ignores_arity_2026-08-04.md: the
# live conformance check (interpreter_eval.rs:985) compares a HashSet of method
# NAMES and never reads `m.params`, so arity drift is accepted in silence.
#
# Pure-Simple port of the one-off census scripts (repo rule: all code lives in
# .spl/.shs).  The port also repairs three declaration forms the Python census
# could not see, each of which changed its answer:
#   * `pub trait X:`            -- 19 declarations were invisible
#   * `trait X extends A, B:`   -- 1 declaration was invisible
#   * bare `me name(...)`       -- the census regex required a literal `fn`
#
# Receiver normalisation is applied to BOTH sides: `fn f(self, ...)` and
# `me f(...)` are both live conventions, so a naive params.len() comparison
# would red-flag every `me` implementer of a `self`-style trait.
#
# Usage:
#   bin/simple run scripts/check/check-trait-arity.spl [roots...]   # default src test
#   bin/simple run scripts/check/check-trait-arity.spl --selftest
#   bin/simple run scripts/check/check-trait-arity.spl --list-unscorable [roots...]
#
# The verdict is the LAST line of stdout:
#   PASS  -- <n> Tier-A method pairs scored, 0 arity drift    (exit 0)
#   FAIL  -- <n> Tier-A arity drift(s)                        (exit 1)
#   ERROR -- nothing was scored                               (exit 2)
#
# --selftest is not optional dressing: a "0 drift" result from a scorer whose
# control was never exercised is indistinguishable from a scorer that stopped
# working.  That is exactly how the superseded sweep's numbers survived.

use std.nogc_sync_mut.io_runtime.{file_read, file_write, dir_walk, dir_exists, dir_create_all, dir_remove_all, get_args, exit}

struct Sig:
    name: text
    arity: i64
    params: text
    ret: text
    line: i64
    has_body: bool

struct TDecl:
    tname: text
    file: text
    line: i64
    modids: [text]
    methods: [Sig]

struct IBlock:
    tname: text
    ty: text
    file: text
    line: i64
    uses: [text]
    methods: [Sig]

# A module that re-exports a declaration (`pub use X`) is what many impl files
# actually name in their own `use` line, so resolution has to follow one hop
# through it or the real declaration is never matched.
struct ReExport:
    modids: [text]
    uses: [text]

struct Scan:
    traits: [TDecl]
    impls: [IBlock]
    reexports: [ReExport]
    nfiles: i64

struct SigParse:
    ok: bool
    name: text
    params: [text]
    ret: text
    has_body: bool
    end_line: i64

struct MHdr:
    ok: bool
    name: text
    name_end: i64
    bare_me: bool

struct Resolved:
    how: text
    idx: [i64]

# ---------------------------------------------------------------- primitives

fn ident_chars() -> text:
    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

fn is_ident_char(c: text) -> bool:
    if c == "":
        return false
    ident_chars().contains(c)

fn indent_of(ln: text) -> i64:
    var i: i64 = 0
    val n = ln.len()
    while i < n:
        if ln.substring(i, i + 1) != " ":
            return i
        i = i + 1
    n

fn read_ident(s: text, start: i64) -> i64:
    var i = start
    val n = s.len()
    while i < n:
        if not is_ident_char(s.substring(i, i + 1)):
            break
        i = i + 1
    i

fn skip_ws(s: text, start: i64) -> i64:
    var i = start
    val n = s.len()
    while i < n:
        val c = s.substring(i, i + 1)
        if c != " " and c != "\t":
            break
        i = i + 1
    i

fn strip_comment(s: text) -> text:
    val h = s.find("#")
    if h < 0:
        return s
    s.substring(0, h)

fn count_char(s: text, c: text) -> i64:
    var n: i64 = 0
    var i: i64 = 0
    val len = s.len()
    while i < len:
        if s.substring(i, i + 1) == c:
            n = n + 1
        i = i + 1
    n

fn list_has(xs: [text], v: text) -> bool:
    for x in xs:
        if x == v:
            return true
    false

fn joined(ps: [text]) -> text:
    var s: text = ""
    for p in ps:
        if s == "":
            s = p
        else:
            s = s + ", " + p
    s

# The receiver is spelled four ways across the tree; all four must be dropped
# from BOTH sides before arities are compared.
fn is_receiver(p: text) -> bool:
    var head = p
    val c = head.find(":")
    if c >= 0:
        head = head.substring(0, c)
    head = head.trim()
    head == "self" or head == "me" or head == "&self" or head == "&mut self" or head == "mut self"

fn pcount(params: [text]) -> i64:
    var n: i64 = 0
    for p in params:
        if not is_receiver(p):
            n = n + 1
    n

fn norm_ret(r: text) -> text:
    var s = r.trim()
    while s.ends_with(":"):
        s = s.substring(0, s.len() - 1)
    s = s.replace(" ", "")
    s = s.replace("\t", "")
    s

# Split on top-level commas, then re-join fragments split inside generic angle
# brackets: `Result<Any, Any>` is ONE parameter, not two.  Getting this wrong
# manufactured a false `Matcher.matches` drift in an earlier sweep.
fn split_params(s: text) -> [text]:
    var raw: [text] = []
    var depth: i64 = 0
    var cur: text = ""
    var i: i64 = 0
    val n = s.len()
    while i < n:
        val ch = s.substring(i, i + 1)
        if ch == "(" or ch == "[" or ch == "{":
            depth = depth + 1
        else if ch == ")" or ch == "]" or ch == "}":
            depth = depth - 1
        if ch == "," and depth == 0:
            raw.push(cur.trim())
            cur = ""
        else:
            cur = cur + ch
        i = i + 1
    if cur.trim() != "":
        raw.push(cur.trim())

    var merged: [text] = []
    var buf: text = ""
    var ad: i64 = 0
    for frag in raw:
        ad = ad + count_char(frag, "<") - count_char(frag, ">")
        if buf == "":
            buf = frag
        else:
            buf = buf + ", " + frag
        if ad <= 0:
            merged.push(buf)
            buf = ""
            ad = 0
    if buf != "":
        merged.push(buf)
    merged

# ---------------------------------------------------------------- signatures

# Parse a signature that may span lines.  Scanning for the parameter '(' starts
# just past the method name so an earlier paren cannot be mistaken for it.
fn parse_sig(lines: [text], i: i64, name: text, name_end: i64) -> SigParse:
    var depth: i64 = 0
    var buf: text = ""
    var tail: text = ""
    var j = i
    var opened = false
    var closed = false
    val nlines = lines.len()
    while j < nlines:
        val ln = lines[j]
        var k: i64 = 0
        if j == i:
            k = name_end
        val n = ln.len()
        var closed_here = false
        while k < n:
            val ch = ln.substring(k, k + 1)
            if ch == "#" and depth == 0 and opened:
                break
            if ch == "(":
                depth = depth + 1
                opened = true
                if depth == 1:
                    k = k + 1
                    continue
            else if ch == ")":
                depth = depth - 1
                if depth == 0:
                    tail = ln.substring(k + 1, n)
                    closed_here = true
                    break
            if depth >= 1:
                buf = buf + ch
            k = k + 1
        if closed_here:
            closed = true
            break
        # A signature never spans this many lines; bail out rather than run to
        # end-of-file on a line that only looked like a header.
        if j - i > 24:
            break
        j = j + 1
    if not closed:
        return SigParse(ok: false, name: "", params: [], ret: "", has_body: false, end_line: i)

    val params = split_params(buf)
    val t = strip_comment(tail)
    var ret: text = ""
    var has_body = false
    val arrow = t.find("->")
    if arrow >= 0:
        val after = t.substring(arrow + 2, t.len())
        var d: i64 = 0
        var cut = after.len()
        var idx: i64 = 0
        while idx < after.len():
            val ch = after.substring(idx, idx + 1)
            if ch == "(" or ch == "[" or ch == "{" or ch == "<":
                d = d + 1
            else if ch == ")" or ch == "]" or ch == "}" or ch == ">":
                d = d - 1
            else if ch == ":" and d <= 0:
                # Return type ends at the first TOP-LEVEL ':' so a one-liner
                # body (`-> bool: true`) is not read as part of the type.
                cut = idx
                has_body = true
                break
            idx = idx + 1
        ret = after.substring(0, cut).trim()
        val w = ret.find(" where ")
        if w >= 0:
            ret = ret.substring(0, w).trim()
    else:
        has_body = t.trim().ends_with(":")
    SigParse(ok: true, name: name, params: params, ret: ret, has_body: has_body, end_line: j)

fn is_modifier(w: text) -> bool:
    w == "pub" or w == "pri" or w == "priv" or w == "static" or w == "extern"
        or w == "async" or w == "var" or w == "mut" or w == "abstract"
        or w == "override" or w == "virtual" or w == "to"

# Recognise a method header.  Accepted, after leading modifiers:
#     fn NAME(        me fn NAME(        me NAME(
# The bare `me NAME(` form is reported separately because `me` is not a keyword
# that can only open a declaration, so it is held to a stricter indent rule.
fn method_header(ln: text) -> MHdr:
    var i = skip_ws(ln, 0)
    var saw_me = false
    var saw_fn = false
    while true:
        val e = read_ident(ln, i)
        if e == i:
            return MHdr(ok: false, name: "", name_end: -1, bare_me: false)
        val w = ln.substring(i, e)
        if w == "fn":
            saw_fn = true
            i = skip_ws(ln, e)
            break
        if w == "me":
            if saw_me:
                return MHdr(ok: false, name: "", name_end: -1, bare_me: false)
            saw_me = true
            i = skip_ws(ln, e)
            continue
        if is_modifier(w):
            i = skip_ws(ln, e)
            continue
        # Not a modifier and not `fn`: only the bare `me` form gets here.
        if saw_me:
            break
        return MHdr(ok: false, name: "", name_end: -1, bare_me: false)
    val ne = read_ident(ln, i)
    if ne == i:
        return MHdr(ok: false, name: "", name_end: -1, bare_me: false)
    val nm = ln.substring(i, ne)
    var k = skip_ws(ln, ne)
    if k < ln.len() and ln.substring(k, k + 1) == "<":
        val gt = ln.find(">")
        if gt < 0:
            return MHdr(ok: false, name: "", name_end: -1, bare_me: false)
        k = skip_ws(ln, gt + 1)
    if k >= ln.len() or ln.substring(k, k + 1) != "(":
        return MHdr(ok: false, name: "", name_end: -1, bare_me: false)
    MHdr(ok: true, name: nm, name_end: ne, bare_me: saw_me and not saw_fn)

# ---------------------------------------------------------------- block walk

fn block_end(lines: [text], start: i64, hdr_indent: i64) -> i64:
    var i = start + 1
    var end = start + 1
    val n = lines.len()
    while i < n:
        val ln = lines[i]
        val s = ln.trim()
        if s == "" or s.starts_with("#"):
            i = i + 1
            continue
        if indent_of(ln) <= hdr_indent:
            break
        end = i + 1
        i = i + 1
    end

fn collect_methods(lines: [text], lo: i64, hi: i64, hdr_indent: i64) -> [Sig]:
    var out: [Sig] = []
    var i = lo
    while i < hi:
        val ln = lines[i]
        val ind = indent_of(ln)
        if ind > hdr_indent:
            val h = method_header(ln)
            if h.ok and ((not h.bare_me) or ind == hdr_indent + 4):
                val sp = parse_sig(lines, i, h.name, h.name_end)
                if sp.ok:
                    out.push(Sig(name: sp.name, arity: pcount(sp.params),
                                 params: joined(sp.params), ret: norm_ret(sp.ret),
                                 line: i + 1, has_body: sp.has_body))
                    i = sp.end_line + 1
                    continue
        i = i + 1
    out

# ---------------------------------------------------------------- headers

fn strip_generics(s: text) -> text:
    val a = s.find("<")
    if a < 0:
        return s.trim()
    s.substring(0, a).trim()

fn base_name(s: text) -> text:
    var out = s.trim()
    while true:
        val d = out.find(".")
        if d < 0:
            break
        out = out.substring(d + 1, out.len())
    out

# `[pub ]trait NAME[<..>][ extends A, B][(..)]:` -> NAME, else "".
fn trait_header_name(ln: text) -> text:
    var i = skip_ws(ln, 0)
    var e = read_ident(ln, i)
    if e > i and ln.substring(i, e) == "pub":
        i = skip_ws(ln, e)
        e = read_ident(ln, i)
    if e == i or ln.substring(i, e) != "trait":
        return ""
    i = skip_ws(ln, e)
    val ne = read_ident(ln, i)
    if ne == i:
        return ""
    if not strip_comment(ln).trim().ends_with(":"):
        return ""
    ln.substring(i, ne)

# `[pub ]impl TRAIT[<..>] for TYPE[<..>]:` -> "TRAIT|TYPE", else "".
fn impl_for_header(ln: text) -> text:
    var i = skip_ws(ln, 0)
    var e = read_ident(ln, i)
    if e > i and ln.substring(i, e) == "pub":
        i = skip_ws(ln, e)
        e = read_ident(ln, i)
    if e == i or ln.substring(i, e) != "impl":
        return ""
    val body = strip_comment(ln).trim()
    if not body.ends_with(":"):
        return ""
    val fpos = body.find(" for ")
    if fpos < 0:
        return ""
    val ipos = body.find("impl ")
    if ipos < 0:
        return ""
    var lhs = body.substring(ipos + 5, fpos).trim()
    var rhs = body.substring(fpos + 5, body.len() - 1).trim()
    lhs = base_name(strip_generics(lhs))
    rhs = base_name(strip_generics(rhs))
    if lhs == "" or rhs == "":
        return ""
    lhs + "|" + rhs

fn use_module(ln: text) -> text:
    val t = ln.trim()
    if not t.starts_with("use "):
        return ""
    val rest = t.substring(4, t.len()).trim()
    var i: i64 = 0
    val n = rest.len()
    while i < n:
        val c = rest.substring(i, i + 1)
        if not (is_ident_char(c) or c == "."):
            break
        i = i + 1
    var m = rest.substring(0, i)
    while m.ends_with("."):
        m = m.substring(0, m.len() - 1)
    m

# ---------------------------------------------------------------- module ids

fn dot_join(parts: [text], from: i64) -> text:
    var s: text = ""
    var i = from
    while i < parts.len():
        if s == "":
            s = parts[i]
        else:
            s = s + "." + parts[i]
        i = i + 1
    s

# Module identifiers a file may legitimately be imported as.  Textual, not the
# compiler's resolver -- see the residual-error notes in the bug doc.
fn modids(rel: text) -> [text]:
    var p = rel
    if p.ends_with(".spl"):
        p = p.substring(0, p.len() - 4)
    var parts: [text] = []
    for seg in p.split("/"):
        if seg != "":
            parts.push(seg)
    var out: [text] = []
    if parts.len() == 0:
        return out
    if parts[0] == "src":
        var t: [text] = []
        var i: i64 = 1
        while i < parts.len():
            t.push(parts[i])
            i = i + 1
        parts = t
    if parts.len() == 0:
        return out
    out.push(dot_join(parts, 0))
    if parts.len() > 0 and parts[0] == "lib":
        # `use std.X` may skip the tier directory.
        out.push("std." + dot_join(parts, 1))
        out.push("std." + dot_join(parts, 2))
        out.push(dot_join(parts, 1))
        out.push(dot_join(parts, 2))
    var n: i64 = 1
    while n < parts.len():
        out.push(dot_join(parts, n))
        n = n + 1
    var uniq: [text] = []
    for s in out:
        if s != "" and not list_has(uniq, s):
            uniq.push(s)
    uniq

fn dir_of(p: text) -> text:
    var last: i64 = -1
    var i: i64 = 0
    while i < p.len():
        if p.substring(i, i + 1) == "/":
            last = i
        i = i + 1
    if last < 0:
        return ""
    p.substring(0, last)

# ---------------------------------------------------------------- resolution

# A bare-name trait key is NOT a conservative approximation: it manufactures
# drift wherever the same abstraction is tiered across common/ nogc_sync_mut/
# nogc_async_mut/ gc_async_mut/.  Resolve by same-file, then import, then
# same-dir; anything left is reported unscorable, never guessed.
fn resolve(traits: [TDecl], name: text, impl_file: text, uses: [text]) -> Resolved:
    var all: [i64] = []
    var i: i64 = 0
    while i < traits.len():
        if traits[i].tname == name:
            all.push(i)
        i = i + 1
    if all.len() == 0:
        return Resolved(how: "NOT_FOUND", idx: [])
    if all.len() == 1:
        return Resolved(how: "unique", idx: all)

    var same: [i64] = []
    for k in all:
        if traits[k].file == impl_file:
            same.push(k)
    if same.len() > 0:
        return Resolved(how: "same-file", idx: same)

    var hit: [i64] = []
    for k in all:
        var matched = false
        for id in traits[k].modids:
            if list_has(uses, id) or list_has(uses, id + "." + name):
                matched = true
                break
        if matched:
            hit.push(k)
    if hit.len() == 1:
        return Resolved(how: "import", idx: hit)
    if hit.len() > 1:
        return Resolved(how: "import-multi", idx: hit)

    val idir = dir_of(impl_file)
    var sdir: [i64] = []
    for k in all:
        if dir_of(traits[k].file) == idir:
            sdir.push(k)
    if sdir.len() > 0:
        return Resolved(how: "same-dir", idx: sdir)
    Resolved(how: "AMBIGUOUS", idx: all)

# ---------------------------------------------------------------- scanning

# A `./` prefix (from `dir_walk(".")`) must be stripped before module ids are
# derived, or `src/` is never recognised, no `std.` alias is produced, and every
# multi-declaration trait falls through to AMBIGUOUS.
fn norm_path(p: text) -> text:
    var s = p
    while s.starts_with("./"):
        s = s.substring(2, s.len())
    s

fn should_scan(path: text) -> bool:
    if not path.ends_with(".spl"):
        return false
    if path.contains("/vendor/") or path.contains("/node_modules/"):
        return false
    if path.contains("/target/") or path.contains("/build/"):
        return false
    true

fn scan_file(rel: text, content: text) -> Scan:
    var traits: [TDecl] = []
    var impls: [IBlock] = []
    var reexports: [ReExport] = []
    val is_reexport = content.contains("pub use ")
    if not (content.contains("trait ") or content.contains("impl ") or is_reexport):
        return Scan(traits: traits, impls: impls, reexports: reexports, nfiles: 1)
    val lines = content.split("\n")

    # Pass 1: every `use` in the file, so a declaration above the imports still
    # resolves by import.
    var uses: [text] = []
    for ln in lines:
        val um = use_module(ln)
        if um != "" and not list_has(uses, um):
            uses.push(um)
    if is_reexport and uses.len() > 0:
        reexports.push(ReExport(modids: modids(rel), uses: uses))

    # Pass 2: declarations.
    var i: i64 = 0
    val n = lines.len()
    while i < n:
        val ln = lines[i]
        val s = ln.trim()
        if s == "" or s.starts_with("#"):
            i = i + 1
            continue
        val tn = trait_header_name(ln)
        if tn != "":
            val ind = indent_of(ln)
            val hi = block_end(lines, i, ind)
            traits.push(TDecl(tname: tn, file: rel, line: i + 1, modids: modids(rel),
                              methods: collect_methods(lines, i + 1, hi, ind)))
            i = i + 1
            continue
        val ih = impl_for_header(ln)
        if ih != "":
            val bar = ih.find("|")
            val ind2 = indent_of(ln)
            val hi2 = block_end(lines, i, ind2)
            impls.push(IBlock(tname: ih.substring(0, bar),
                              ty: ih.substring(bar + 1, ih.len()),
                              file: rel, line: i + 1, uses: uses,
                              methods: collect_methods(lines, i + 1, hi2, ind2)))
            i = i + 1
            continue
        i = i + 1
    Scan(traits: traits, impls: impls, reexports: reexports, nfiles: 1)

fn scan_roots(roots: [text]) -> Scan:
    var traits: [TDecl] = []
    var impls: [IBlock] = []
    var reexports: [ReExport] = []
    var nfiles: i64 = 0
    for root in roots:
        if not dir_exists(root):
            continue
        for p in dir_walk(root):
            if not should_scan(p):
                continue
            nfiles = nfiles + 1
            val fs = scan_file(norm_path(p), file_read(p))
            for t in fs.traits:
                traits.push(t)
            for b in fs.impls:
                impls.push(b)
            for rx in fs.reexports:
                reexports.push(rx)
    Scan(traits: traits, impls: impls, reexports: reexports, nfiles: nfiles)

# One hop only: `use os.services.block_device` reaches the re-export module,
# whose own `use std.fs_driver.block_device` reaches the declaration.  Deeper
# chains stay unscorable rather than being guessed at.
fn expand_uses(uses: [text], reexports: [ReExport]) -> [text]:
    var out: [text] = []
    for u in uses:
        out.push(u)
    for rx in reexports:
        var named = false
        for id in rx.modids:
            if list_has(uses, id):
                named = true
                break
        if named:
            for u in rx.uses:
                if not list_has(out, u):
                    out.push(u)
    out

# ---------------------------------------------------------------- scoring

# Every impl method whose trait candidates AGREE on arity is scored; the rest
# are counted unscorable rather than guessed.
fn drift_lines(sc: Scan) -> [text]:
    var out: [text] = []
    for ib in sc.impls:
        val r = resolve(sc.traits, ib.tname, ib.file, expand_uses(ib.uses, sc.reexports))
        if r.how == "NOT_FOUND":
            continue
        for m in ib.methods:
            var cand_ar: [i64] = []
            var cand_where: [text] = []
            for k in r.idx:
                for tm in sc.traits[k].methods:
                    if tm.name == m.name:
                        cand_ar.push(tm.arity)
                        cand_where.push("{sc.traits[k].file}:{tm.line}")
            if cand_ar.len() == 0:
                continue
            var agree = true
            var q: i64 = 1
            while q < cand_ar.len():
                if cand_ar[q] != cand_ar[0]:
                    agree = false
                    break
                q = q + 1
            if not agree:
                continue
            if cand_ar[0] != m.arity:
                out.push("  {ib.tname}.{m.name} on {ib.ty}: trait={cand_ar[0]} impl={m.arity} [{r.how}] {ib.file}:{m.line}  (trait {cand_where[0]})")
    out

fn main():
    val argv = get_args()
    var roots: [text] = []
    var selftest = false
    var list_unscorable = false
    var i: i64 = 0
    while i < argv.len():
        val a = argv[i]
        if a == "--selftest":
            selftest = true
            i = i + 1
            continue
        if a == "--list-unscorable":
            list_unscorable = true
            i = i + 1
            continue
        if a.starts_with("--") or a.ends_with("/simple") or a == "run" or a.ends_with(".spl"):
            i = i + 1
            continue
        roots.push(a)
        i = i + 1

    # The control runs BEFORE every scan and is fatal.  A checker that cannot
    # fail on a known-bad fixture proves nothing when it says PASS.
    if not run_control():
        print("FAIL -- positive control did not reproduce; scan not attempted")
        exit(1)
        return
    if selftest:
        print("PASS -- positive control reproduced")
        return

    if roots.len() == 0:
        roots.push("src")
        roots.push("test")

    val sc = scan_roots(roots)
    var scored: i64 = 0
    var unscorable: i64 = 0
    var notfound: i64 = 0
    var notfound_names: [text] = []
    var unscorable_lines: [text] = []
    for ib in sc.impls:
        val r = resolve(sc.traits, ib.tname, ib.file, expand_uses(ib.uses, sc.reexports))
        if r.how == "NOT_FOUND":
            notfound = notfound + ib.methods.len()
            if not list_has(notfound_names, ib.tname):
                notfound_names.push(ib.tname)
            print("  NOT-FOUND {ib.tname}.{joined(method_names(ib.methods))} on {ib.ty}  {ib.file}:{ib.line}")
            continue
        for m in ib.methods:
            var cand_ar: [i64] = []
            var cand_where: [text] = []
            for k in r.idx:
                for tm in sc.traits[k].methods:
                    if tm.name == m.name:
                        cand_ar.push(tm.arity)
                        cand_where.push("{sc.traits[k].file}:{tm.line}(ar={tm.arity})")
            if cand_ar.len() == 0:
                continue
            var agree = true
            var q: i64 = 1
            while q < cand_ar.len():
                if cand_ar[q] != cand_ar[0]:
                    agree = false
                    break
                q = q + 1
            if agree:
                scored = scored + 1
            else:
                unscorable = unscorable + 1
                if list_unscorable:
                    unscorable_lines.push("  UNSCORABLE {ib.tname}.{m.name} on {ib.ty} impl_ar={m.arity} [{r.how}] {ib.file}:{m.line}  cands: {joined(cand_where)}")

    val drift = drift_lines(sc)
    print("files scanned                     : {sc.nfiles}")
    print("trait declarations                : {sc.traits.len()}")
    print("impl T for Y blocks               : {sc.impls.len()}")
    print("Tier-A method pairs scored        : {scored}")
    print("unscorable (candidates disagree)  : {unscorable}")
    print("methods under a trait with no .spl declaration : {notfound} ({notfound_names.len()} names)")
    if notfound_names.len() > 0:
        print("  not-found trait names: {joined(notfound_names)}")
    for u in unscorable_lines:
        print(u)
    if drift.len() > 0:
        print("--- Tier-A ARITY DRIFT ---")
        for d in drift:
            print(d)
    if scored == 0:
        print("ERROR -- nothing was scored")
        exit(2)
        return
    if drift.len() > 0:
        print("FAIL -- {drift.len()} Tier-A arity drift(s)")
        exit(1)
        return
    print("PASS -- {scored} Tier-A method pairs scored, 0 arity drift")

# ------------------------------------------------------------- positive control
#
# The fixture is written to a temp directory at run time rather than checked in,
# so a deliberately-drifted .spl can never be picked up by lint, the test
# runner, or any other repo sweep -- and cannot drift away from this checker.
#
# Six planted cases MUST fire and three MUST NOT:
#   fire: over-arity, under-arity, `me fn`, bare `me`, `pub trait`, `extends`
#   silent: generic-comma parameter, mixed receiver conventions, return-only
# The last three are the false-positive guards; without them a scorer that
# simply reported everything would look like a working checker.

fn control_source() -> text:
    var s: text = ""
    s = s + "use std.ctrlmod.base\n"
    s = s + "\n"
    s = s + "trait CtrlOver:\n"
    s = s + "    fn wide(self, a: i64) -> bool\n"
    s = s + "\n"
    s = s + "impl CtrlOver for CtrlType:\n"
    s = s + "    fn wide(self, a: i64, b: i64) -> bool:\n"
    s = s + "        return true\n"
    s = s + "\n"
    s = s + "trait CtrlUnder:\n"
    s = s + "    fn narrow(self, a: i64, b: i64) -> bool\n"
    s = s + "\n"
    s = s + "impl CtrlUnder for CtrlType:\n"
    s = s + "    fn narrow(self, a: i64) -> bool:\n"
    s = s + "        return true\n"
    s = s + "\n"
    s = s + "trait CtrlMe:\n"
    s = s + "    me fn me_drift(a: i64) -> bool\n"
    s = s + "\n"
    s = s + "impl CtrlMe for CtrlType:\n"
    s = s + "    me fn me_drift(a: i64, b: i64) -> bool:\n"
    s = s + "        return true\n"
    s = s + "\n"
    s = s + "trait CtrlBareMe:\n"
    s = s + "    me bare_drift(a: i64) -> bool\n"
    s = s + "\n"
    s = s + "impl CtrlBareMe for CtrlType:\n"
    s = s + "    me bare_drift(a: i64, b: i64) -> bool:\n"
    s = s + "        return true\n"
    s = s + "\n"
    s = s + "pub trait CtrlPub:\n"
    s = s + "    fn pub_drift(self, a: i64) -> bool\n"
    s = s + "\n"
    s = s + "impl CtrlPub for CtrlType:\n"
    s = s + "    fn pub_drift(self, a: i64, b: i64) -> bool:\n"
    s = s + "        return true\n"
    s = s + "\n"
    s = s + "trait CtrlExt extends CtrlPub, CtrlOver:\n"
    s = s + "    fn ext_drift(self, a: i64) -> bool\n"
    s = s + "\n"
    s = s + "impl CtrlExt for CtrlType:\n"
    s = s + "    fn ext_drift(self, a: i64, b: i64) -> bool:\n"
    s = s + "        return true\n"
    s = s + "\n"
    # Deliberately ASYMMETRIC: the generic parameter appears on the trait side
    # only.  A symmetric pair cannot detect a broken re-join, because both
    # sides then miscount by the same amount and the drift cancels out.
    s = s + "trait CtrlGeneric:\n"
    s = s + "    fn matches(self, actual: Result<Any, Any>) -> bool\n"
    s = s + "\n"
    s = s + "impl CtrlGeneric for CtrlType:\n"
    s = s + "    fn matches(self, actual: Any) -> bool:\n"
    s = s + "        return true\n"
    s = s + "\n"
    s = s + "trait CtrlRecv:\n"
    s = s + "    fn mixed(self, a: i64) -> bool\n"
    s = s + "\n"
    s = s + "impl CtrlRecv for CtrlType:\n"
    s = s + "    me fn mixed(a: i64) -> bool:\n"
    s = s + "        return true\n"
    s = s + "\n"
    s = s + "trait CtrlRet:\n"
    s = s + "    fn ret_only(self, a: i64) -> bool\n"
    s = s + "\n"
    s = s + "impl CtrlRet for CtrlType:\n"
    s = s + "    fn ret_only(self, a: i64) -> i64:\n"
    s = s + "        return 1\n"
    s

fn run_control() -> bool:
    val dir = "/tmp/simple_trait_arity_control/src"
    dir_create_all(dir)
    if not file_write(dir + "/control.spl", control_source()):
        print("  control ERROR: fixture could not be written to {dir}")
        return false
    val sc = scan_roots(["/tmp/simple_trait_arity_control"])
    var found: [text] = []
    for line in drift_lines(sc):
        for want in control_names():
            if line.contains(want + " on CtrlType"):
                found.push(want)
    dir_remove_all("/tmp/simple_trait_arity_control")

    var ok = true
    for want in control_names():
        val hit = list_has(found, want)
        val need = control_must_fire(want)
        if hit != need:
            ok = false
            print("  control MISMATCH {want}: detected={hit} expected={need}")
    if sc.traits.len() != 9 or sc.impls.len() != 9:
        ok = false
        print("  control MISMATCH population: traits={sc.traits.len()} impls={sc.impls.len()} expected 9/9")
    if ok:
        print("control: 9 traits, 9 impls, 6 planted drifts detected, 3 non-drifts silent")
    ok

fn method_names(ms: [Sig]) -> [text]:
    var out: [text] = []
    for m in ms:
        out.push(m.name)
    out

fn control_names() -> [text]:
    ["CtrlOver.wide", "CtrlUnder.narrow", "CtrlMe.me_drift", "CtrlBareMe.bare_drift",
     "CtrlPub.pub_drift", "CtrlExt.ext_drift", "CtrlGeneric.matches", "CtrlRecv.mixed",
     "CtrlRet.ret_only"]

fn control_must_fire(name: text) -> bool:
    name != "CtrlGeneric.matches" and name != "CtrlRecv.mixed" and name != "CtrlRet.ret_only"
