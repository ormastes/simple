#!/bin/sh
# Produce deterministic reviewer-ready, deliberately unsigned startup evidence.
set -eu
LC_ALL=C; export LC_ALL

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
GATE=interpreter-startup-parity
FIXTURE_ID=hello-world
FIXTURE_DIR=test/05_perf/fixtures/interpreter_startup
SAMPLES=50
WARMUPS=10
OUTPUT_DIR=
RUN_ID=
SIMPLE_COMPILER=${SIMPLE_COMPILER:-}
STAGE4_PROVENANCE=${STAGE4_PROVENANCE:-}
PRODUCER_ID=${PRODUCER_ID:-performance-team}
REVIEWER_KEY_ID=${REVIEWER_KEY_ID:-independent-reviewer-required}
SELF_TEST=0

fail() { echo "STATUS: FAIL interpreter-startup-producer — $*" >&2; exit 1; }
hash_file() { sha256sum "$1" | awk '{print $1}'; }
hash_text() { sha256sum | awk '{print $1}'; }
fixed20() { printf '%020d' "$1"; }
token_ok() { case "$1" in ''|*[!A-Za-z0-9._:@+/-]*) return 1;; esac; }
usage() {
    echo "usage: $0 --output-dir <repo-relative-dir> --run-id <id> [--samples 50..1000] [--simple-compiler <stage4-simple>] [--stage4-provenance <file>]"
    echo "       $0 --self-test"
}
while [ "$#" -gt 0 ]; do
    case "$1" in
        --output-dir) OUTPUT_DIR=$2; shift 2;; --run-id) RUN_ID=$2; shift 2;;
        --samples) SAMPLES=$2; shift 2;; --simple-compiler) SIMPLE_COMPILER=$2; shift 2;;
        --stage4-provenance) STAGE4_PROVENANCE=$2; shift 2;; --producer-id) PRODUCER_ID=$2; shift 2;;
        --reviewer-key-id) REVIEWER_KEY_ID=$2; shift 2;; --self-test) SELF_TEST=1; shift;;
        -h|--help) usage; exit 0;; *) fail "unknown-argument-$1";;
    esac
done

source_fingerprint() {
    git -C "$ROOT" ls-tree -r HEAD -- src scripts config test rules.sdl doc/07_guide doc/00_llm_process doc/glossary.md |
        sed '\|[[:space:]]doc/08_tracking/check/must_check_db.sdn$|d' | sha256sum | awk '{print $1}'
}

if [ "$SELF_TEST" -eq 1 ]; then
    sh "$ROOT/test/01_unit/scripts/interpreter_startup_samples_test.shs" >/dev/null
    grep -Fq 'clock_gettime(CLOCK_MONOTONIC' "$ROOT/scripts/check/lib/rust-go-benchmark-monotonic-ns.c" || fail self-test-clock
    grep -Fq 'head-drift-during-production' "$0" || fail self-test-head-drift
    grep -Fq 'REVIEWER_KEY_ID' "$0" || fail self-test-unsigned-review
    echo 'STATUS: PASS interpreter-startup-producer self-test'
    exit 0
fi
for override in INTERPRETER_STARTUP_TEST_MODE INTERPRETER_STARTUP_PYTHON INTERPRETER_STARTUP_BUN \
    INTERPRETER_STARTUP_GO INTERPRETER_STARTUP_CLOCK INTERPRETER_STARTUP_CHECKER; do
    eval '[ -z "${'"$override"'+x}" ]' || fail "forbidden-environment-override-$override"
done
token_ok "$RUN_ID" || fail invalid-run-id
token_ok "$PRODUCER_ID" || fail invalid-producer-id
token_ok "$REVIEWER_KEY_ID" || fail invalid-reviewer-key-id
[ "$PRODUCER_ID" != "$REVIEWER_KEY_ID" ] || fail reviewer-must-be-independent
case "$SAMPLES" in ''|*[!0-9]*) fail invalid-samples;; esac
[ "$SAMPLES" -ge 50 ] && [ "$SAMPLES" -le 1000 ] || fail samples-out-of-range
case "$OUTPUT_DIR" in ''|/*|*' '*|..|../*|*/../*|*/..) fail unsafe-output-dir;; esac

START_HEAD=$(git -C "$ROOT" rev-parse HEAD) || fail head-identity
FINGERPRINT=$(source_fingerprint) || fail source-fingerprint
for tracked in scripts/check/produce-interpreter-startup-evidence.shs \
    scripts/check/check-interpreter-startup-samples.shs \
    scripts/check/check-interpreter-startup-parity.shs \
    scripts/check/check-external-must-check-receipt.shs \
    scripts/check/lib/rust-go-benchmark-monotonic-ns.c; do
    git -C "$ROOT" show "HEAD:$tracked" >"${TMPDIR:-/tmp}/startup-head-$$" || fail "missing-head-source-$tracked"
    cmp -s "$ROOT/$tracked" "${TMPDIR:-/tmp}/startup-head-$$" || { rm -f "${TMPDIR:-/tmp}/startup-head-$$"; fail "dirty-producer-or-checker-$tracked"; }
done
rm -f "${TMPDIR:-/tmp}/startup-head-$$"
for name in hello.spl hello.py hello.js hello.go oracle.txt; do
    git -C "$ROOT" cat-file -e "HEAD:$FIXTURE_DIR/$name" || fail "uncommitted-fixture-$name"
done
prefix=$ROOT; old_ifs=$IFS; IFS=/
for component in $OUTPUT_DIR; do prefix=$prefix/$component; [ ! -L "$prefix" ] || fail symlinked-output-ancestor; done
IFS=$old_ifs
parent_rel=${OUTPUT_DIR%/*}; [ "$parent_rel" != "$OUTPUT_DIR" ] || parent_rel=.
mkdir -p "$ROOT/$parent_rel"
parent_real=$(CDPATH= cd -- "$ROOT/$parent_rel" && pwd -P) || fail invalid-output-parent
case "$parent_real" in "$ROOT"|"$ROOT"/*) ;; *) fail output-parent-escapes-root;; esac
OUT=$parent_real/${OUTPUT_DIR##*/}; [ ! -e "$OUT" ] || fail output-dir-exists; mkdir -p "$OUT"
work=$(mktemp -d) || exit 1; trap 'rm -rf "$work"' EXIT INT TERM

if [ -z "$SIMPLE_COMPILER" ]; then
    for candidate in "$ROOT/bin/release/$(uname -m)-unknown-linux-gnu/simple" "$ROOT/bin/release/simple"; do
        [ -x "$candidate" ] && { SIMPLE_COMPILER=$candidate; break; }
    done
fi
[ -n "$SIMPLE_COMPILER" ] || fail missing-simple-compiler
SIMPLE_COMPILER=$(readlink -f "$SIMPLE_COMPILER")
case "$SIMPLE_COMPILER" in /*/bin/release/*) ;; *) fail non-release-simple-compiler;; esac
case "$SIMPLE_COMPILER" in *compiler_rust*|*rust*seed*|*bootstrap*simple*) fail rust-seed-compiler;; esac
[ -x "$SIMPLE_COMPILER" ] || fail unusable-simple-compiler
[ -n "$STAGE4_PROVENANCE" ] || STAGE4_PROVENANCE=${SIMPLE_COMPILER}.provenance.env
STAGE4_PROVENANCE=$(readlink -f "$STAGE4_PROVENANCE")
[ -f "$STAGE4_PROVENANCE" ] && [ ! -L "$STAGE4_PROVENANCE" ] || fail missing-stage4-provenance

PYTHON=$(command -v python3 || true); BUN=$(command -v bun || true); GO=$(command -v go || true); CC=$(command -v cc || true)
for pair in "python:$PYTHON" "bun:$BUN" "go:$GO" "cc:$CC"; do [ -n "${pair#*:}" ] || fail "missing-${pair%%:*}"; done
PYTHON=$(readlink -f "$PYTHON"); BUN=$(readlink -f "$BUN"); GO=$(readlink -f "$GO"); CC=$(readlink -f "$CC")
cp "$SIMPLE_COMPILER" "$OUT/simple-compiler"; cp "$STAGE4_PROVENANCE" "$OUT/stage4-provenance.env"
git -C "$ROOT" show HEAD:scripts/check/produce-interpreter-startup-evidence.shs >"$OUT/startup-producer-source.shs"
git -C "$ROOT" show HEAD:scripts/check/check-interpreter-startup-samples.shs >"$OUT/startup-samples-checker-source.shs"
git -C "$ROOT" show HEAD:scripts/check/check-interpreter-startup-parity.shs >"$OUT/startup-parity-checker-source.shs"
git -C "$ROOT" show HEAD:scripts/check/check-external-must-check-receipt.shs >"$OUT/startup-external-checker-source.shs"
cp "$PYTHON" "$OUT/startup-python"; cp "$BUN" "$OUT/startup-bun"; cp "$GO" "$OUT/startup-go"
env -i LC_ALL=C PATH=/usr/bin:/bin "$PYTHON" --version >"$OUT/startup-python-version.txt" 2>&1
env -i LC_ALL=C PATH=/usr/bin:/bin "$BUN" --version >"$OUT/startup-bun-version.txt" 2>&1
env -i LC_ALL=C PATH=/usr/bin:/bin "$GO" version >"$OUT/startup-go-version.txt" 2>&1

CLEAN_PATH=/usr/bin:/bin; mkdir -p "$work/go-cache"
(cd "$ROOT" && env -i LC_ALL=C PATH="$CLEAN_PATH" GOENV=off GOCACHE="$work/go-cache" CGO_ENABLED=0 "$GO" build -trimpath -o "$OUT/startup-go-hello" "$FIXTURE_DIR/hello.go") || fail go-build
clock_source=$ROOT/scripts/check/lib/rust-go-benchmark-monotonic-ns.c
cp "$clock_source" "$OUT/startup-clock-source.c"; cp "$CC" "$OUT/startup-clock-compiler"
env -i LC_ALL=C PATH=/usr/bin:/bin "$CC" --version >"$OUT/startup-clock-compiler-version.txt" 2>&1
env -i LC_ALL=C PATH="$CLEAN_PATH" "$CC" -O2 -std=c11 "$clock_source" -o "$OUT/startup-clock-helper" || fail clock-build
env -i LC_ALL=C PATH=/usr/bin:/bin "$OUT/startup-clock-helper" --self-test >/dev/null || fail clock-self-test

expected_sha=$(hash_file "$ROOT/$FIXTURE_DIR/oracle.txt"); empty_sha=$(printf '' | hash_text)
run_lane() {
    lane=$1; out=$2; err=$3; cache_dir=$4
    mkdir -p "$cache_dir"
    case "$lane" in
        simple) env -i LC_ALL=C PATH=/usr/bin:/bin HOME="$cache_dir" XDG_CACHE_HOME="$cache_dir" TMPDIR="$cache_dir" SIMPLE_NO_BOOTSTRAP_DELEGATE=1 SIMPLE_EXECUTION_MODE=interpret SIMPLE_EXECUTION_MODE_RECEIPT=1 "$SIMPLE_COMPILER" "$ROOT/$FIXTURE_DIR/hello.spl" >"$out" 2>"$err";;
        python) env -i LC_ALL=C PATH=/usr/bin:/bin HOME="$cache_dir" XDG_CACHE_HOME="$cache_dir" TMPDIR="$cache_dir" "$PYTHON" "$ROOT/$FIXTURE_DIR/hello.py" >"$out" 2>"$err";;
        bun) env -i LC_ALL=C PATH=/usr/bin:/bin HOME="$cache_dir" XDG_CACHE_HOME="$cache_dir" TMPDIR="$cache_dir" "$BUN" "$ROOT/$FIXTURE_DIR/hello.js" >"$out" 2>"$err";;
        go) env -i LC_ALL=C PATH=/usr/bin:/bin HOME="$cache_dir" XDG_CACHE_HOME="$cache_dir" TMPDIR="$cache_dir" "$OUT/startup-go-hello" >"$out" 2>"$err";;
    esac
}
for lane in simple python bun go; do
    run_lane "$lane" "$work/$lane.out" "$work/$lane.err" "$work/semantic-cache/$lane" || fail "$lane-semantic-run"
    [ "$(hash_file "$work/$lane.out")" = "$expected_sha" ] || fail "$lane-semantic-output"
    if [ "$lane" = simple ]; then
        grep -Fvx 'simple_execution_mode_v1 requested=interpreter actual=interpreter fallback=false' "$work/$lane.err" >"$work/$lane.filtered" || true
        [ "$(grep -Fxc 'simple_execution_mode_v1 requested=interpreter actual=interpreter fallback=false' "$work/$lane.err")" -eq 1 ] || fail simple-mode-receipt
        [ "$(hash_file "$work/$lane.filtered")" = "$empty_sha" ] || fail simple-stderr
    else [ "$(hash_file "$work/$lane.err")" = "$empty_sha" ] || fail "$lane-stderr"; fi
done

cat >"$OUT/semantic-equivalence.env" <<EOF
equivalence_schema=simple.interpreter-startup-equivalence/v1
gate_id=$GATE
source_fingerprint=$FINGERPRINT
run_id=$RUN_ID
fixture_id=$FIXTURE_ID
semantic_oracle_path=$FIXTURE_DIR/oracle.txt
semantic_oracle_sha256=$expected_sha
simple_source_path=$FIXTURE_DIR/hello.spl
simple_source_sha256=$(hash_file "$ROOT/$FIXTURE_DIR/hello.spl")
python_source_path=$FIXTURE_DIR/hello.py
python_source_sha256=$(hash_file "$ROOT/$FIXTURE_DIR/hello.py")
bun_source_path=$FIXTURE_DIR/hello.js
bun_source_sha256=$(hash_file "$ROOT/$FIXTURE_DIR/hello.js")
go_source_path=$FIXTURE_DIR/hello.go
go_source_sha256=$(hash_file "$ROOT/$FIXTURE_DIR/hello.go")
expected_stdout_sha256=$expected_sha
simple_stdout_sha256=$expected_sha
python_stdout_sha256=$expected_sha
bun_stdout_sha256=$expected_sha
go_stdout_sha256=$expected_sha
simple_exit=0
python_exit=0
bun_exit=0
go_exit=0
final_verdict=PASS
EOF

host_id=sha256:$({ uname -n; cat /etc/machine-id 2>/dev/null || true; } | hash_text)
boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unavailable)
cpu_model_sha=$(sed -n 's/^model name[[:space:]]*:[[:space:]]*//p' /proc/cpuinfo 2>/dev/null | head -n1 | hash_text)
cpuset_sha=$(sed -n 's/^Cpus_allowed_list:[[:space:]]*//p' /proc/self/status 2>/dev/null | hash_text)
governor=$(sed -n '1p' /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo unknown)
case "$governor" in ''|*[!A-Za-z0-9._:@+/-]*) governor=unknown;; esac
cat >"$OUT/startup-environment.env" <<EOF
environment_schema=simple.interpreter-startup-environment/v3
gate_id=$GATE
source_fingerprint=$FINGERPRINT
run_id=$RUN_ID
fixture_id=$FIXTURE_ID
host_id=$host_id
boot_id=$boot_id
os=linux
kernel=$(uname -r)
arch=$(uname -m)
cpu_model_sha256=$cpu_model_sha
cpu_count=$(getconf _NPROCESSORS_ONLN)
cpu_governor=$governor
cpuset_sha256=$cpuset_sha
isolation=controlled-host
launch_environment=env-i-lc-all-c-path-home-xdg-cache-home-tmpdir
clock_source_path=scripts/check/lib/rust-go-benchmark-monotonic-ns.c
clock_source_sha256=$(hash_file "$OUT/startup-clock-source.c")
clock_compiler_sha256=$(hash_file "$OUT/startup-clock-compiler")
clock_compiler_version_sha256=$(hash_file "$OUT/startup-clock-compiler-version.txt")
clock_tool_sha256=$(hash_file "$OUT/startup-clock-helper")
python_path=$PYTHON
python_executable_sha256=$(hash_file "$OUT/startup-python")
python_version_sha256=$(hash_file "$OUT/startup-python-version.txt")
bun_path=$BUN
bun_executable_sha256=$(hash_file "$OUT/startup-bun")
bun_version_sha256=$(hash_file "$OUT/startup-bun-version.txt")
go_path=$GO
go_executable_sha256=$(hash_file "$OUT/startup-go")
go_version_sha256=$(hash_file "$OUT/startup-go-version.txt")
go_hello_sha256=$(hash_file "$OUT/startup-go-hello")
simple_compiler_path=$SIMPLE_COMPILER
simple_executable_sha256=$(hash_file "$OUT/simple-compiler")
producer_source_path=scripts/check/produce-interpreter-startup-evidence.shs
producer_source_sha256=$(hash_file "$OUT/startup-producer-source.shs")
samples_checker_source_sha256=$(hash_file "$OUT/startup-samples-checker-source.shs")
parity_checker_source_sha256=$(hash_file "$OUT/startup-parity-checker-source.shs")
external_checker_source_sha256=$(hash_file "$OUT/startup-external-checker-source.shs")
warmup_launches=$WARMUPS
cold_definition=fresh-process-fresh-per-sample-runtime-cache-not-os-page-cache-cold
warm_definition=fresh-process-stable-lane-cache-after-fixed-warmups
final_verdict=PASS
EOF

cat >"$OUT/startup-raw-samples.env" <<EOF
sample_schema=simple.interpreter-startup-samples/v2
gate_id=$GATE
source_fingerprint=$FINGERPRINT
run_id=$RUN_ID
fixture_id=$FIXTURE_ID
clock_id=clock_gettime-monotonic
unit=ns
sample_count=$SAMPLES
warmup_launches=$WARMUPS
cold_policy=fresh-process-fresh-isolated-runtime-cache
EOF
measure() {
    phase=$1; lane=$2; index=$3
    cache_dir=$work/runtime-cache/warm/$lane
    [ "$phase" = cold ] && cache_dir=$work/runtime-cache/cold/$lane/$index
    start=$(env -i LC_ALL=C PATH=/usr/bin:/bin "$OUT/startup-clock-helper"); run_lane "$lane" "$work/out" "$work/err" "$cache_dir"; status=$?; end=$(env -i LC_ALL=C PATH=/usr/bin:/bin "$OUT/startup-clock-helper")
    [ "$end" -ge "$start" ] || fail monotonic-clock-regressed
    mode_count=0; mode=not-applicable; err_sha=$(hash_file "$work/err")
    if [ "$lane" = simple ]; then
        mode_count=$(grep -c '^simple_execution_mode_v1 ' "$work/err" || true)
        grep -Fvx 'simple_execution_mode_v1 requested=interpreter actual=interpreter fallback=false' "$work/err" >"$work/filtered" || true
        err_sha=$(hash_file "$work/filtered"); mode=requested-interpreter-actual-interpreter-fallback-false
    fi
    action=fresh-process-stable-warmed-runtime-cache; [ "$phase" = cold ] && action=fresh-process-fresh-isolated-runtime-cache
    printf 'sample|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' "$phase" "$lane" "$index" "$(fixed20 $((end-start)))" "$status" "$(hash_file "$work/out")" "$err_sha" "$mode_count" "$action" "$mode" >>"$OUT/startup-raw-samples.env"
}
i=1
while [ "$i" -le "$SAMPLES" ]; do
    for lane in simple python bun go; do measure cold "$lane" "$i"; done
    for lane in simple python bun go; do j=0; while [ "$j" -lt "$WARMUPS" ]; do run_lane "$lane" "$work/warm.out" "$work/warm.err" "$work/runtime-cache/warm/$lane" || fail "$lane-warmup"; j=$((j+1)); done; measure warm "$lane" "$i"; done
    i=$((i+1))
done

p50_line=$(( (SAMPLES+1)/2 )); p95_line=$(( (SAMPLES*95+99)/100 ))
for phase in cold warm; do for lane in simple python bun go; do
    awk -F'|' -v p=$phase -v l=$lane '$1=="sample"&&$2==p&&$3==l{print $5}' "$OUT/startup-raw-samples.env" | sort >"$work/$phase.$lane"
done; done
cat >"$OUT/startup-statistics.env" <<EOF
statistics_schema=simple.interpreter-startup-statistics/v1
gate_id=$GATE
source_fingerprint=$FINGERPRINT
run_id=$RUN_ID
fixture_id=$FIXTURE_ID
sample_count=$SAMPLES
EOF
for phase in cold warm; do for lane in simple python bun go; do
    echo "${phase}_${lane}_p50_ns=$(sed -n "${p50_line}p" "$work/$phase.$lane")"
    echo "${phase}_${lane}_p95_ns=$(sed -n "${p95_line}p" "$work/$phase.$lane")"
done; done >>"$OUT/startup-statistics.env"
printf '%s\n' 'comparison_policy=simple-p50-p95-strictly-lower' 'final_verdict=PASS' >>"$OUT/startup-statistics.env"

cat >"$OUT/command-receipt.env" <<EOF
evidence_schema=simple.must-check-command/v1
gate_id=$GATE
source_fingerprint=$FINGERPRINT
run_id=$RUN_ID
command=sh scripts/check/produce-interpreter-startup-evidence.shs --output-dir $OUTPUT_DIR --run-id $RUN_ID --samples $SAMPLES
exit_status=0
final_verdict=PASS
EOF
cat >"$OUT/target-identity.env" <<EOF
evidence_schema=simple.must-check-target/v1
gate_id=$GATE
run_id=$RUN_ID
target_kind=native-host
target_id=$host_id
final_verdict=PASS
EOF
tool_digest=$(printf '%s\n' "$(hash_file "$OUT/simple-compiler")" "$(hash_file "$OUT/startup-python")" "$(hash_file "$OUT/startup-bun")" "$(hash_file "$OUT/startup-go")" "$(hash_file "$OUT/startup-clock-helper")" | hash_text)
cat >"$OUT/toolchain-identity.env" <<EOF
evidence_schema=simple.must-check-toolchain/v1
gate_id=$GATE
run_id=$RUN_ID
toolchain_id=sha256:$tool_digest
final_verdict=PASS
EOF
cat >"$OUT/observations.env" <<EOF
evidence_schema=simple.must-check-observations/v1
gate_id=$GATE
source_fingerprint=$FINGERPRINT
run_id=$RUN_ID
acceptance_ids=semantic-equivalence,cold-samples,warm-samples,python,bun,go,simple-faster
acceptance.semantic-equivalence=PASS
acceptance.cold-samples=PASS
acceptance.warm-samples=PASS
acceptance.python=PASS
acceptance.bun=PASS
acceptance.go=PASS
acceptance.simple-faster=PASS
final_verdict=PASS
EOF

snapshot_dir=$work/checker-snapshots
mkdir -p "$snapshot_dir"
cp "$OUT/startup-parity-checker-source.shs" "$snapshot_dir/parity.shs"
cp "$OUT/startup-samples-checker-source.shs" "$snapshot_dir/samples.shs"
chmod 700 "$snapshot_dir/parity.shs" "$snapshot_dir/samples.shs"
sh "$snapshot_dir/parity.shs" --root "$ROOT" --fingerprint "$FINGERPRINT" --run-id "$RUN_ID" \
    --raw-samples "$OUT/startup-raw-samples.env" --statistics "$OUT/startup-statistics.env" --equivalence "$OUT/semantic-equivalence.env" --environment "$OUT/startup-environment.env" \
    --simple-compiler "$OUT/simple-compiler" --stage4-provenance "$OUT/stage4-provenance.env" \
    --clock-source "$OUT/startup-clock-source.c" --clock-compiler "$OUT/startup-clock-compiler" --clock-version "$OUT/startup-clock-compiler-version.txt" --clock-helper "$OUT/startup-clock-helper" \
    --python "$OUT/startup-python" --python-version "$OUT/startup-python-version.txt" --bun "$OUT/startup-bun" --bun-version "$OUT/startup-bun-version.txt" \
    --go "$OUT/startup-go" --go-version "$OUT/startup-go-version.txt" --go-hello "$OUT/startup-go-hello" \
    --producer-source "$OUT/startup-producer-source.shs" --samples-checker-source "$OUT/startup-samples-checker-source.shs" \
    --parity-checker-source "$OUT/startup-parity-checker-source.shs" --external-checker-source "$OUT/startup-external-checker-source.shs" \
    --samples-checker "$snapshot_dir/samples.shs" >/dev/null || fail lane-validation

summary=$OUT/external-evidence.unsigned.env
cat >"$summary" <<EOF
evidence_schema=simple.must-check-external-evidence/v2
gate_id=$GATE
source_fingerprint=$FINGERPRINT
final_verdict=PASS
producer_id=$PRODUCER_ID
producer_kind=controlled-host
run_id=$RUN_ID
produced_at_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)
reviewer_key_id=$REVIEWER_KEY_ID
acceptance_contract=$GATE/v1
acceptance_ids=semantic-equivalence,cold-samples,warm-samples,python,bun,go,simple-faster
EOF
for entry in command_receipt:command-receipt.env target_identity:target-identity.env toolchain_identity:toolchain-identity.env observations:observations.env \
 simple_compiler:simple-compiler startup_raw_samples:startup-raw-samples.env startup_statistics:startup-statistics.env semantic_equivalence:semantic-equivalence.env startup_environment:startup-environment.env stage4_provenance:stage4-provenance.env \
 startup_clock_source:startup-clock-source.c startup_clock_compiler:startup-clock-compiler startup_clock_compiler_version:startup-clock-compiler-version.txt startup_clock_helper:startup-clock-helper \
 startup_python:startup-python startup_python_version:startup-python-version.txt startup_bun:startup-bun startup_bun_version:startup-bun-version.txt startup_go:startup-go startup_go_version:startup-go-version.txt startup_go_hello:startup-go-hello \
 startup_producer_source:startup-producer-source.shs startup_samples_checker_source:startup-samples-checker-source.shs startup_parity_checker_source:startup-parity-checker-source.shs startup_external_checker_source:startup-external-checker-source.shs; do
    kind=${entry%%:*}; file=${entry#*:}; printf '%s_path=%s/%s\n%s_sha256=%s\n' "$kind" "$OUTPUT_DIR" "$file" "$kind" "$(hash_file "$OUT/$file")" >>"$summary"
done
[ "$START_HEAD" = "$(git -C "$ROOT" rev-parse HEAD)" ] || fail head-drift-during-production
[ "$FINGERPRINT" = "$(source_fingerprint)" ] || fail source-fingerprint-drift
echo "STATUS: PASS interpreter-startup-producer — unsigned reviewer-ready evidence: $OUTPUT_DIR"
