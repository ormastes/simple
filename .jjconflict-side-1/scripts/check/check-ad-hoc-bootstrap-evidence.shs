#!/bin/sh
# Validate and record a user-authorized Stage2/Stage3 diagnostic receipt.
set -eu

stage3_bin=${1:?usage: check-ad-hoc-bootstrap-evidence.shs <stage3-bin> <provenance-env> <receipt-env>}
provenance=${2:?usage: check-ad-hoc-bootstrap-evidence.shs <stage3-bin> <provenance-env> <receipt-env>}
receipt=${3:?usage: check-ad-hoc-bootstrap-evidence.shs <stage3-bin> <provenance-env> <receipt-env>}

[ "${SIMPLE_ADHOC_BOOTSTRAP:-0}" = 1 ] || { echo "error: SIMPLE_ADHOC_BOOTSTRAP=1 required" >&2; exit 2; }
[ -x "$stage3_bin" ] && [ -f "$provenance" ] || { echo "error: missing Stage3 artifact/provenance" >&2; exit 1; }
mkdir -p "$(dirname "$receipt")"
{
  echo "schema=simple-adhoc-stage3-diagnostic-v1"
  echo "stage3_path=$stage3_bin"
  echo "stage3_sha256=$(sha256sum "$stage3_bin" | awk '{print $1}')"
  echo "stage3_version=$($stage3_bin --version | head -1)"
  echo "provenance_path=$provenance"
  echo "provenance_sha256=$(sha256sum "$provenance" | awk '{print $1}')"
  echo "admission=false"
} > "$receipt"
