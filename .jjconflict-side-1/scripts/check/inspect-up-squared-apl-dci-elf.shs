#!/usr/bin/env sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
ELF="${UP2_DCI_ELF:-$ROOT_DIR/build/os/up-squared-apollo-lake/simpleos.elf}"
RECEIPT="${UP2_DCI_ELF_RECEIPT:-$ELF.receipt}"

fail() { echo "up2_dci_elf_status=fail"; echo "up2_dci_elf_reason=$1"; exit 1; }
blocked() { echo "up2_dci_elf_status=blocked"; echo "up2_dci_elf_reason=$1"; exit 2; }
receipt_value() { awk -F= -v key="$2" '$1==key {sub(/^[^=]*=/, ""); print; exit}' "$1"; }

test "${1:---inspect}" = --inspect || {
    echo "usage: $0 [--inspect]" >&2
    exit 64
}
command -v readelf >/dev/null 2>&1 || blocked readelf-missing
command -v sha256sum >/dev/null 2>&1 || blocked sha256sum-missing
test -s "$ELF" || blocked elf-missing
test -s "$RECEIPT" || blocked elf-receipt-missing

ELF_HASH="$(sha256sum "$ELF" | awk '{print $1}')"
test "$(receipt_value "$RECEIPT" schema)" = up2-simpleos-receipt-v1 || fail elf-receipt-schema
test "$(receipt_value "$RECEIPT" target)" = x86_64-up-squared-apollo-lake || fail elf-receipt-target
test "$(receipt_value "$RECEIPT" artifact_sha256)" = "$ELF_HASH" || fail elf-receipt-hash

HEADER="$(readelf -h "$ELF")"
printf '%s\n' "$HEADER" | grep -q 'Class:.*ELF64' || fail elf-class
printf '%s\n' "$HEADER" | grep -q 'Type:.*EXEC' || fail elf-type
printf '%s\n' "$HEADER" | grep -q 'Machine:.*X86-64' || fail elf-machine
ENTRY="$(printf '%s\n' "$HEADER" | awk -F: '/Entry point address:/ {gsub(/^[[:space:]]+/, "", $2); print $2; exit}')"
test -n "$ENTRY" || fail elf-entry

SEGMENTS="$(readelf -W -l "$ELF" | awk '
    $1 == "LOAD" {
        flags = ""
        for (field = 7; field < NF; field++) flags = flags $field
        printf "segment_%d=file_offset:%s,virtual_address:%s,physical_address:%s,file_size:%s,memory_size:%s,flags:%s,alignment:%s\n", count, $2, $3, $4, $5, $6, flags, $NF
        count++
    }
    END { printf "segment_count=%d\n", count }
')"
COUNT="$(printf '%s\n' "$SEGMENTS" | awk -F= '$1=="segment_count" {print $2}')"
test "$COUNT" -gt 0 || fail elf-load-segments-missing

echo schema=up2-dci-elf-inspection-v1
echo up2_dci_elf_status=pass
echo elf="$ELF"
echo elf_sha256="$ELF_HASH"
echo elf_entry="$ENTRY"
printf '%s\n' "$SEGMENTS"
echo load_semantics=copy-file-size-then-zero-to-memory-size
echo direct_contiguous_elf_copy=forbidden
echo direct_rip_boot=forbidden
echo persistent_writes=none
