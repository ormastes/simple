#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
build_dir="$repo_root/build/test/runtime_simd_utf8_native_check"
mkdir -p "$build_dir"

cc -O2 -std=gnu11 -I"$repo_root/src/runtime" \
    "$repo_root/test/01_unit/runtime/simd_text/runtime_simd_utf8_native_test.c" \
    -o "$build_dir/runtime_simd_utf8_native_test"
"$build_dir/runtime_simd_utf8_native_test"
