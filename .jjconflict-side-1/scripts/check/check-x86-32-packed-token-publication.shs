#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
registry="$root/src/os/kernel/arch/x86_32/token_registry.spl"
catalog="$root/src/os/port/_SimpleosMultiplatformBuild/platform_target_catalog.spl"

for literal in \
    'packed_auth_claim(PACKED_AUTH_X86_TOKEN)' \
    'packed_auth_write_bytes(lease.packed_lease, bytes, 96)' \
    'packed_auth_address(lease.packed_lease)' \
    'packed_auth_release(current.packed_lease)' \
    'current.packed_lease == lease.packed_lease'; do
    rg -F "$literal" "$registry" >/dev/null || { echo "missing token ownership rule: $literal" >&2; exit 1; }
done

if rg -n 'rt_array_data_ptr|packed_lease:[[:space:]]*\[|__attribute__\(\(weak\)\)' "$registry" >/dev/null; then
    echo "unstable array pointer or weak token owner detected" >&2
    exit 1
fi

rg -F '"src/os/kernel/arch/common/freestanding_packed_auth_storage.c"' "$catalog" >/dev/null
echo "x86_32 packed token publication: PASS"
