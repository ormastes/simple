# THE wrong-method detector. Two classes, same method name, different
# bodies, both reached through Any-annotated locals. A layout-unanimity
# or unique-name resolver dispatches both to one body and prints the
# same number twice. Expected stdout: C=7 then D=42
class Dog:
    fn speak(self) -> i64:
        return 7

class Cat:
    fn speak(self) -> i64:
        return 42

fn main() -> i64:
    val d: Any = Dog()
    val c: Any = Cat()
    print "C={d.speak()}"
    print "D={c.speak()}"
    return 0
