#!/bin/sh
# Prove the SimpleOS aarch64 Limine lane obtains a REAL framebuffer under REAL
# firmware (EDK2/AAVMF pflash), and refuse to pass on the fail-closed sentinel.
#
# ---------------------------------------------------------------------------
# WHY THIS EXISTS (root cause, established 2026-08-08)
# ---------------------------------------------------------------------------
# The aarch64 Limine lane booted fine and printed
# SIMPLEOS-AARCH64-LIMINE-KERNEL-OK, but every transcript also carried
#
#     [BOOT] WARNING: No framebuffer response from Limine
#
# The obvious hypothesis was that the aarch64 boot path never asks Limine for a
# framebuffer (the x86_64 request lives in src/os/kernel/boot/limine_boot.spl).
# That hypothesis is WRONG, and this comment exists so nobody re-derives it and
# "fixes" it by adding a duplicate request:
#
#   * src/os/kernel/boot/limine_boot_aarch64.spl ALREADY declares the request
#     (LIMINE_FRAMEBUFFER_ID_0/_1 at :67-68) and parses the response in
#     _parse_framebuffer() — structurally identical to the x86_64 file.
#   * The request struct itself lives in C, in
#     examples/09_embedded/simple_os/arch/aarch64/boot/freestanding_runtime.c
#     as g_limine_framebuffer_request, read back through the zero-arg accessor
#     extern rt_limine_framebuffer_response(). (The requests are in C because
#     `@section(...)` is not a real Simple attribute and because field access on
#     a @repr("C") global miscompiled on this target — see the bug doc.)
#   * A byte scan of the linked kernel.elf finds all five Limine request magics
#     present, correctly formed, 0x30 apart. The framebuffer one is there.
#   * DECISIVE: in the failing transcript, the HHDM, memmap (48 entries), RSDP
#     and kernel-address responses were ALL populated. Only framebuffer was
#     null. Request discovery demonstrably works; a missing request would have
#     nulled all five, not one.
#
# The actual root cause is the QEMU invocation, not the kernel: aarch64
# `-M virt` has NO default display adapter (unlike x86_64 Q35, which always has
# VGA). With no display device, the firmware exposes no GOP, so Limine has no
# framebuffer to hand over and correctly leaves the response null. The kernel
# then correctly refuses, fail-closed, via _no_framebuffer().
#
# The fix is therefore `-device ramfb` on the QEMU command line. Measured
# 2026-08-08 with the SAME unmodified kernel binary:
#     no display device      -> [BOOT] WARNING: No framebuffer response
#     -device virtio-gpu-pci -> [BOOT] WARNING: No framebuffer response
#                               (this AAVMF build has no usable VirtioGpuDxe GOP)
#     -device ramfb          -> [BOOT] Framebuffer: 800x600 bpp=32 pitch=3200
#
# NOTE: ESP /limine.conf carries `graphics: no`. That only controls Limine's own
# menu rendering; it does NOT suppress the framebuffer response, as the ramfb
# run above proves. Do not "fix" it speculatively.
#
# ---------------------------------------------------------------------------
# BOARD-RUNNABLE CONTRACT (.claude/rules/board-runnable.md)
# ---------------------------------------------------------------------------
# This boots through EDK2/AAVMF pflash and Limine's BOOTAA64.EFI — real firmware
# semantics, the same path a physical board takes. It NEVER uses QEMU `-kernel`
# pass semantics and NEVER uses isa-debug-exit. `ramfb` is a QEMU-specific
# display device; on a real board the equivalent surface comes from the board's
# own firmware GOP, so the KERNEL side (which is what this gate covers) is
# unchanged. The board bring-up path remains as filed.
#
# ---------------------------------------------------------------------------
# VERDICT CONTRACT — last line of stdout, fail-closed
# ---------------------------------------------------------------------------
#   PASS  — ... exit 0   a real framebuffer was obtained and validated
#   FAIL  — ... exit 1   the warning is present, or the surface is degenerate
#   ERROR — ... exit 2   could not run the check at all (nothing was verified)
#
# An absent artifact, an absent tool, or an empty serial log is ERROR (2), never
# a pass. "No warning found" alone is NOT sufficient to pass: an empty log has
# no warning either. A pass REQUIRES a positive Framebuffer line with a non-zero
# address and non-zero width/height/pitch/bpp.

set -eu

REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
ART_DIR="$REPO_ROOT/build/os/aarch64_limine"
WORK=${WORK_DIR:-$(mktemp -d)}
LOG="$WORK/aarch64-limine-fb.serial.log"
BOOT_TIMEOUT=${BOOT_TIMEOUT:-90}

fail()  { printf 'FAIL — %s\n'  "$1"; exit 1; }
oops()  { printf 'ERROR — nothing was checked: %s\n' "$1"; exit 2; }

# --- preflight: every input must exist, or we ERROR (never silently pass) ----
command -v qemu-system-aarch64 >/dev/null 2>&1 || oops "qemu-system-aarch64 not installed"
for f in AAVMF_CODE.fd AAVMF_VARS.fd esp.img; do
    [ -f "$ART_DIR/$f" ] || oops "missing boot artifact $ART_DIR/$f (build the aarch64 Limine lane first)"
done

cp "$ART_DIR/AAVMF_VARS.fd" "$WORK/VARS.fd"
cp "$ART_DIR/esp.img"       "$WORK/esp.img"

# --- boot under real firmware (EDK2/AAVMF pflash), with a display device -----
# The kernel halts forever in a WFE spin by design, so QEMU never exits on its
# own; `timeout` terminating it is the NORMAL path and is not an error. The
# serial transcript is the artifact, so the exit status is deliberately ignored
# here and every conclusion below is drawn from the log contents instead.
timeout "$BOOT_TIMEOUT" qemu-system-aarch64 \
    -M virt -cpu cortex-a72 -m 512M \
    -drive if=pflash,format=raw,file="$ART_DIR/AAVMF_CODE.fd",readonly=on \
    -drive if=pflash,format=raw,file="$WORK/VARS.fd" \
    -drive if=none,file="$WORK/esp.img",format=raw,id=esp \
    -device virtio-blk-pci,drive=esp \
    -device ramfb \
    -display none \
    -serial "file:$LOG" >/dev/null 2>&1 || true

[ -s "$LOG" ] || oops "serial log is empty — the guest produced no output at all"

# The kernel must actually have booted. Without this, a firmware-level failure
# would leave a log with no warning line and could read as a pass.
grep -aq 'SIMPLEOS-AARCH64-LIMINE-KERNEL-OK' "$LOG" \
    || oops "kernel never reached SIMPLEOS-AARCH64-LIMINE-KERNEL-OK; nothing about the framebuffer can be concluded"

# --- negative checks: the fail-closed refusal paths must NOT have fired ------
if grep -aq 'WARNING: No framebuffer response from Limine' "$LOG"; then
    fail "Limine returned no framebuffer response (see $LOG)"
fi
if grep -aq 'WARNING: No framebuffers available' "$LOG"; then
    fail "Limine framebuffer response present but framebuffer_count == 0 (see $LOG)"
fi
if grep -aq 'rejecting bogus framebuffer descriptor' "$LOG"; then
    fail "framebuffer descriptor failed limine_framebuffer_fields_valid (see $LOG)"
fi

# --- positive check: a real surface, with every field non-degenerate ---------
FB_LINE=$(grep -a '\[BOOT\] Framebuffer: addr=' "$LOG" | head -1)
[ -n "$FB_LINE" ] || oops "no '[BOOT] Framebuffer: addr=' line in the transcript (stale kernel build?)"

# Fields are logged as addr=0x<a> <w>x<h> bpp=<b> pitch=<p>.
ADDR=$(printf '%s\n' "$FB_LINE" | sed -n 's/.*addr=0x\([0-9a-fA-F]*\).*/\1/p')
DIMS=$(printf '%s\n' "$FB_LINE" | sed -n 's/.*addr=0x[0-9a-fA-F]* \([0-9]*x[0-9]*\).*/\1/p')
W=${DIMS%x*}
H=${DIMS#*x}
BPP=$(printf   '%s\n' "$FB_LINE" | sed -n 's/.*bpp=\([0-9]*\).*/\1/p')
PITCH=$(printf '%s\n' "$FB_LINE" | sed -n 's/.*pitch=\([0-9]*\).*/\1/p')

for pair in "addr:$ADDR" "width:$W" "height:$H" "bpp:$BPP" "pitch:$PITCH"; do
    name=${pair%%:*}
    val=${pair#*:}
    [ -n "$val" ]  || oops "could not parse $name out of: $FB_LINE"
    case "$val" in
        *[!0-9a-fA-F]*) oops "non-numeric $name in: $FB_LINE" ;;
    esac
    # A zero in ANY field is the _no_framebuffer() sentinel leaking through.
    [ "$val" != "0" ] || fail "$name is 0 — that is the _no_framebuffer() sentinel, not a real surface"
done

printf 'PASS — real-firmware (EDK2/AAVMF pflash + Limine BOOTAA64.EFI) aarch64 boot obtained a framebuffer: addr=0x%s %sx%s bpp=%s pitch=%s; 3 refusal paths checked and none fired; log %s\n' \
    "$ADDR" "$W" "$H" "$BPP" "$PITCH" "$LOG"
