# Expanded columns:
# requirement|case|spec|oracle|target|ABI|environment|filesystem|protocol|image-selector
simpleos_case_registry() {
    simpleos_case_registry_requirements | while IFS='|' read -r req happy boundary rejection target abi; do
        case "$req" in REQ-003) filesystem=vfs ;; REQ-004) filesystem=fat32 ;; REQ-005) filesystem=dbfs ;; REQ-006) filesystem=nvfs ;; *) filesystem=none ;; esac
        case "$req" in REQ-013) protocol=http-1.1-h2-h3 ;; REQ-014) protocol=simpledb-postgresql ;; REQ-015) protocol=ssh2-sftp3 ;; REQ-012|REQ-016|NFR-010) protocol=server-policy ;; *) protocol=none ;; esac
        environment=$(simpleos_case_registry_environments | awk -F '|' -v r="$req" '$1 == r {print $2}')
        [ -n "$environment" ] || return 1
        producer_target=host
        image_selector=native-runtime
        if [ "$environment" = qemu_system ]; then
            producer_target=$target
            case "$target" in
                arm64) image_selector=arm64-guest-image ;;
                x86_64) image_selector=x86_64-guest-image ;;
                riscv64) image_selector=riscv64-guest-image ;;
                *) image_selector=multiarch-unprovisioned ;;
            esac
        fi
        happy_marker=$(sed -n 's/^[[:space:]]*it "\(.*\)":/\1/p' "$happy" | sed -n '1p')
        boundary_marker=$(sed -n 's/^[[:space:]]*it "\(.*\)":/\1/p' "$boundary" | sed -n '1p')
        rejection_marker=$(sed -n 's/^[[:space:]]*it "\(.*\)":/\1/p' "$rejection" | sed -n '1p')
        [ -n "$happy_marker" ] && [ -n "$boundary_marker" ] && [ -n "$rejection_marker" ] || return 1
        printf '%s|happy|%s|%s|%s|%s|%s|%s|%s|%s\n' "$req" "$happy" "$happy_marker" "$producer_target" "$abi" "$environment" "$filesystem" "$protocol" "$image_selector"
        printf '%s|boundary|%s|%s|%s|%s|%s|%s|%s|%s\n' "$req" "$boundary" "$boundary_marker" "$producer_target" "$abi" "$environment" "$filesystem" "$protocol" "$image_selector"
        printf '%s|rejection|%s|%s|%s|%s|%s|%s|%s|%s\n' "$req" "$rejection" "$rejection_marker" "$producer_target" "$abi" "$environment" "$filesystem" "$protocol" "$image_selector"
    done
}
