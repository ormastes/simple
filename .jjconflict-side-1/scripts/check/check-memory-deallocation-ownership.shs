#!/bin/sh
set -eu

fail() {
    echo "memory deallocation ownership: FAIL: $*" >&2
    exit 1
}

for mode in gc_async_mut nogc_async_mut nogc_sync_mut; do
    allocator="src/lib/$mode/allocator.spl"
    gc="src/lib/$mode/gc.spl"

    grep -q 'me release():' "$allocator" || fail "$mode arena has no release operation"
    grep -q 'sys_free(self.buffer, self.capacity, 8)' "$allocator" || fail "$mode arena does not reach its owning free operation"
    grep -q 'self.buffer = \[\]' "$allocator" || fail "$mode arena retains its managed backing reference"

    grep -q 'if not self.objects.?:' "$gc" || fail "$mode GC does not detect an empty heap"
    grep -q 'self.young_alloc.release()' "$gc" || fail "$mode empty-heap sweep does not release its arena"
    grep -q 'if self.young_alloc.capacity == 0:' "$gc" || fail "$mode GC does not lazily restore a released arena"
done

# Adjacent explicit allocation families must retain their shared native owner.
grep -q 'void rt_free(uint8_t\* ptr)' src/runtime/runtime_memory.c || fail 'hosted runtime lacks rt_free'
grep -q 'free(ptr);' src/runtime/runtime_memory.c || fail 'hosted rt_free does not reach libc free'
grep -q 'rt_array_free_deep(int64_t value)' src/runtime/runtime_native.c || fail 'deep array deallocator is missing'
grep -q 'rt_string_free(int64_t value)' src/runtime/runtime_native.c || fail 'string deallocator is missing'
grep -q 'void spl_free(void\* ptr)' src/runtime/runtime.c || fail 'runtime allocator owner is missing'

# Compiler-facing GC wrappers must reach their declared runtime owner. This is
# intentionally separate from proving that every backend allocation is rooted.
compiler_gc='src/compiler/70.backend/sffi_minimal.spl'
grep -q 'extern fn rt_gc_malloc(size: i64) -> i64' "$compiler_gc" || fail 'compiler GC allocation ABI is missing'
sed -n '/^fn gc_malloc(size: i64)/,/^fn gc_collect()/p' "$compiler_gc" | grep -q 'rt_gc_malloc(size)' || fail 'compiler GC allocation wrapper returns a placeholder'
sed -n '/^fn gc_init()/,/^fn gc_malloc(size: i64)/p' "$compiler_gc" | grep -q 'rt_gc_init()' || fail 'compiler GC initialization wrapper is disconnected'
sed -n '/^fn gc_collect()/,/^fn value_nil()/p' "$compiler_gc" | grep -q 'rt_gc_collect()' || fail 'compiler GC collection wrapper is disconnected'

echo 'memory deallocation ownership: PASS'
