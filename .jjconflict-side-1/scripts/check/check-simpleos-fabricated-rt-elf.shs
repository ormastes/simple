#!/bin/sh
# check-simpleos-fabricated-rt-elf.shs -- ARTIFACT-side fabricated-stub gate.
#
# WHY THIS EXISTS (2026-08-09)
#   The link-time guard (`simpleos_check_no_fabricated_rt_stubs` in
#   src/compiler/70.backend/backend/llvm_native_link.spl) inspects the link
#   INPUTS. It did not stop `rt_index_of` -- a symbol that reached the shipped
#   x86_64 WM kernel as `xor %eax,%eax; ret`, made `index_of` answer 0 instead
#   of 11, and silently dropped all 45 `:root` CSS custom properties in the
#   guest. Fixed at 1f1c00aa578 by defining it in
#   examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c.
#
#   Whatever let it through upstream, the one artifact that cannot lie is the
#   linked ELF. This gate reads THAT: it enumerates every `rt_*` symbol in the
#   built kernel, classifies each BY BODY, and requires every constant-return
#   body to be EXPLICITLY accounted for in
#   config/simpleos_fabricated_rt_elf_accounting.sdn with a written
#   justification. An unaccounted fabricated symbol is a FAILURE.
#
#   This is the inverse of the old shape. The baseline check only ever fired on
#   symbols already listed as suspicious, so a NEW fabrication -- the only kind
#   that matters -- failed OPEN. Here the ELF supplies the symbol set and the
#   accounting file must cover it, so a new fabrication fails CLOSED by
#   construction: it is simply a name nobody wrote a justification for.
#
# CLASSIFY BY BODY, NEVER BY LINKAGE OR BY NAME.
#   Weak linkage does NOT imply fabricated: `rt_memcpy`, `rt_memset` and the
#   `rt_dma_*` family are `__attribute__((weak))` in baremetal_stubs.c with real
#   loops. Conversely a strong `T` symbol can still be a hand-written
#   `return 0;`. Only the disassembled body separates them, which is the same
#   ruling the link-time guard reached in
#   doc/08_tracking/bug/simpleos_fabricated_rt_guard_weak_real_false_positive_2026-07-28.md
#
# DECODE AMBIGUITY IS RESOLVED FAIL-CLOSED.
#   The SimpleOS x86 kernels are ELF32/`Intel 80386` headers carrying 64-bit
#   code (multiboot). Under an i386 decode the REX prefix of `push %rbp` shows
#   up as a spurious `dec %eax`, which would make a fabricated stub look like
#   real work -- fail-open. So for an 80386-machine ELF this gate disassembles
#   with BOTH `-m i386` and `-m i386:x86-64` and calls a symbol fabricated if
#   EITHER decode says its body is a constant return. An ambiguous decode can
#   therefore never hide a stub.
#
# VERDICT (last line of stdout, repo convention -- see .claude/rules/vcs.md)
#   PASS  — <n> symbol(s) checked ...      exit 0   (n is always > 0)
#   FAIL  — ...                            exit 1
#   ERROR — nothing was checked            exit 2   (no ELF, no nm, no symbols)
#
# Usage:
#   sh scripts/check/check-simpleos-fabricated-rt-elf.shs [ELF...]
#   --accounting <path>   override config/simpleos_fabricated_rt_elf_accounting.sdn
#   --prefix <p>          symbol prefix to police (default rt_)
#   --selftest            run the built-in fixtures and exit
# With no ELF argument the gate scans the default SimpleOS kernel search paths;
# finding none is ERROR, never PASS.

set -u

ACCOUNTING="config/simpleos_fabricated_rt_elf_accounting.sdn"
PREFIX="rt_"
SELFTEST=0
ELFS=""

while [ $# -gt 0 ]; do
    case "$1" in
        --accounting) ACCOUNTING="$2"; shift 2 ;;
        --prefix) PREFIX="$2"; shift 2 ;;
        --selftest) SELFTEST=1; shift ;;
        -h|--help) sed -n '1,60p' "$0"; exit 0 ;;
        -*) echo "ERROR — nothing was checked (unknown option $1)"; exit 2 ;;
        *) ELFS="$ELFS $1"; shift ;;
    esac
done

NM="${NM:-nm}"
OBJDUMP="${OBJDUMP:-objdump}"
command -v "$NM" >/dev/null 2>&1 || { echo "ERROR — nothing was checked (no $NM on PATH)"; exit 2; }
command -v "$OBJDUMP" >/dev/null 2>&1 || { echo "ERROR — nothing was checked (no $OBJDUMP on PATH)"; exit 2; }

WORK="${TMPDIR:-/tmp}/fabricated-rt-elf.$$"
mkdir -p "$WORK" || { echo "ERROR — nothing was checked (cannot create $WORK)"; exit 2; }
trap 'rm -rf "$WORK"' EXIT INT TERM

# ---------------------------------------------------------------- classifier --
# Reads an objdump listing on stdin, prints "<symbol> TRIVIAL" / "<symbol> REAL"
# for every symbol whose name starts with $PREFIX.
#
# TRIVIAL == the body contains a return and consists ONLY of frame set-up, pad,
# a small-constant load into the return register, and the return itself. That is
# precisely what auto_stubs.c fabricates (`xor %eax,%eax; ret`, or NIL_VALUE
# `mov $0x3,%eax; ret`) and what a hand-written `return 0;` compiles to.
#
# A `mov $0x800123,%eax; ret` -- the shape a relocated address takes once the
# link has resolved it, e.g. `rt_baremetal_heap_start` -- is NOT trivial: the
# constant test is capped at 0xff. That cap is the false-positive guard that an
# earlier revision of the link-time guard needed `-r` relocations to get, and it
# is why this gate does not simply match "ends in ret".
classify() {
    awk -v prefix="$PREFIX" '
        function flush(   i, ok) {
            if (sym == "" || index(sym, prefix) != 1) return
            if (!saw_ret) { print sym " REAL"; return }
            print sym " " (all_trivial ? "TRIVIAL" : "REAL")
        }
        function norm(s) {
            sub(/^[ \t]*[0-9a-fA-F]+:[ \t]*/, "", s)   # strip address
            sub(/[ \t]*[;#].*$/, "", s)                # strip trailing comment
            gsub(/[ \t]+/, " ", s)
            sub(/^ /, "", s); sub(/ $/, "", s)
            return s
        }
        # A no-op / prologue / padding instruction: carries no semantics.
        function is_pad(i) {
            if (i ~ /^(endbr64|endbr32|leave|int3|hlt_never|ud2_never)$/) return 1
            if (i ~ /^nop/ || i ~ /^(cs )?nop/ || i ~ /^xchg %ax,%ax$/) return 1
            if (i ~ /^push %(rbp|ebp)$/) return 1
            if (i ~ /^pop %(rbp|ebp)$/) return 1
            if (i ~ /^mov %(rsp|esp),%(rbp|ebp)$/) return 1
            if (i ~ /^(mov|stp|str) x29/) return 1          # aarch64 frame set-up
            if (i ~ /^(ldp|ldr) x29/) return 1
            if (i ~ /^(sub|add) (sp, sp|%rsp)/) return 1
            return 0
        }
        # Loading a SMALL constant into the return register. Capped at 0xff so a
        # resolved link-time address never reads as a constant return.
        function is_small_const(i,   m) {
            if (i ~ /^xor %(eax|rax|edx|rdx),%(eax|rax|edx|rdx)$/) return 1
            if (i ~ /^mov \$0x[0-9a-f]{1,2},%(eax|rax|edx|rdx)$/) return 1
            if (i ~ /^mov(z|)[a-z]* \$0x[0-9a-f]{1,2},%(eax|rax|edx|rdx)$/) return 1
            if (i ~ /^mov (w0|x0), #(0|[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$/) return 1
            if (i ~ /^mov (w0|x0), wzr$/ || i ~ /^mov (w0|x0), xzr$/) return 1
            if (i ~ /^li a0,(0|[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$/) return 1
            return 0
        }
        function is_ret(i) {
            return (i ~ /^(ret|retq|repz retq|ret[ \t]*$)/ || i == "ret" || i == "retq")
        }
        /^[0-9a-fA-F]+ <.*>:$/ {
            flush()
            sym = $0
            sub(/^[0-9a-fA-F]+ </, "", sym)
            sub(/>:$/, "", sym)
            all_trivial = 1; saw_ret = 0
            next
        }
        # Anything that is not an `<addr>:\t<insn>` line ends the current symbol.
        # Without this, objdump section banners ("Disassembly of section .fini:")
        # trailing the LAST symbol of a section counted as an unknown mnemonic
        # and flipped a genuine `xor %eax,%eax; ret` stub to REAL -- a fail-open
        # that depended on nothing but link order.
        $0 !~ /^[ \t]*[0-9a-fA-F]+:[ \t]/ {
            flush()
            sym = ""
            next
        }
        {
            if (sym == "") next
            i = norm($0)
            if (i == "") next
            if (i ~ /^\.\.\./) next
            if (is_ret(i)) { saw_ret = 1; next }
            if (is_pad(i)) next
            if (is_small_const(i)) next
            all_trivial = 0
        }
        END { flush() }
    '
}

# --------------------------------------------------------------- accounting --
# Format: `<entry-key> <symbol> <justification...>`; `#` starts a comment.
# A row with an EMPTY justification is rejected -- accounting without a reason
# is just an allowlist, which is the shape this gate exists to replace.
accounting_for() {
    entry="$1"
    [ -f "$ACCOUNTING" ] || return 0
    awk -v e="$entry" '
        { sub(/#.*$/, "") }
        { gsub(/^[ \t]+|[ \t]+$/, "") }
        $0 == "" { next }
        $1 != e && $1 != "*" { next }
        NF < 3 { print "BADROW " $2; next }
        { print "OK " $2 }
    ' "$ACCOUNTING"
}

# ------------------------------------------------------------------- scan one --
FAILURES=0
TOTAL_CHECKED=0
SCANNED_ELFS=0
FAIL_LINES="$WORK/fail.txt"
: > "$FAIL_LINES"

scan_elf() {
    elf="$1"
    entry=$(basename "$elf"); entry="${entry%.elf}"

    if [ ! -f "$elf" ]; then
        echo "  $elf: missing" >> "$FAIL_LINES"
        FAILURES=$((FAILURES + 1))
        return
    fi

    "$NM" "$elf" > "$WORK/nm.txt" 2>"$WORK/nm.err"
    if [ $? -ne 0 ] || [ ! -s "$WORK/nm.txt" ]; then
        echo "  $elf: nm produced no symbol table (stripped or unreadable)" >> "$FAIL_LINES"
        FAILURES=$((FAILURES + 1))
        return
    fi

    awk -v p="$PREFIX" '$3 != "" && index($3, p) == 1 { print $2, $3 }' "$WORK/nm.txt" \
        | sort -u > "$WORK/syms.txt"
    nsyms=$(wc -l < "$WORK/syms.txt" | tr -d ' ')
    if [ "$nsyms" -eq 0 ]; then
        echo "  $elf: zero ${PREFIX}* symbols -- an empty set is never a pass" >> "$FAIL_LINES"
        FAILURES=$((FAILURES + 1))
        return
    fi

    machine=$(readelf -h "$elf" 2>/dev/null | awk -F: '/Machine/ { gsub(/^[ \t]+/, "", $2); print $2 }')
    : > "$WORK/class.txt"
    case "$machine" in
        *80386*|*X86-64*|*x86-64*)
            # Fail-closed on decode ambiguity: EITHER decode saying TRIVIAL wins.
            "$OBJDUMP" -d -m i386:x86-64 --no-show-raw-insn "$elf" 2>/dev/null | classify >> "$WORK/class.txt"
            "$OBJDUMP" -d -m i386        --no-show-raw-insn "$elf" 2>/dev/null | classify >> "$WORK/class.txt"
            ;;
        *)
            "$OBJDUMP" -d --no-show-raw-insn "$elf" 2>/dev/null | classify >> "$WORK/class.txt"
            ;;
    esac
    if [ ! -s "$WORK/class.txt" ]; then
        echo "  $elf: objdump yielded no disassembly -- cannot classify bodies" >> "$FAIL_LINES"
        FAILURES=$((FAILURES + 1))
        return
    fi

    awk '$2 == "TRIVIAL" { print $1 }' "$WORK/class.txt" | sort -u > "$WORK/trivial.txt"
    accounting_for "$entry" > "$WORK/acct.txt"
    awk '$1 == "BADROW" { print $2 }' "$WORK/acct.txt" | sort -u > "$WORK/badrows.txt"
    awk '$1 == "OK"     { print $2 }' "$WORK/acct.txt" | sort -u > "$WORK/ok.txt"

    # Only symbols actually PRESENT in this ELF are in scope.
    awk '{ print $2 }' "$WORK/syms.txt" | sort -u > "$WORK/present.txt"
    comm -12 "$WORK/trivial.txt" "$WORK/present.txt" > "$WORK/fab.txt"
    nfab=$(wc -l < "$WORK/fab.txt" | tr -d ' ')
    unaccounted=$(comm -23 "$WORK/fab.txt" "$WORK/ok.txt")
    nbad=$(wc -l < "$WORK/badrows.txt" | tr -d ' ')

    TOTAL_CHECKED=$((TOTAL_CHECKED + nsyms))
    SCANNED_ELFS=$((SCANNED_ELFS + 1))
    echo "  $entry: $nsyms ${PREFIX}* symbol(s), $nfab with a constant-return body, machine=${machine:-unknown}"

    if [ "$nbad" -gt 0 ]; then
        echo "  $entry: accounting rows with NO justification (a reason is mandatory): $(tr '\n' ' ' < "$WORK/badrows.txt")" >> "$FAIL_LINES"
        FAILURES=$((FAILURES + 1))
    fi
    if [ -n "$unaccounted" ]; then
        n=$(printf '%s\n' "$unaccounted" | wc -l | tr -d ' ')
        echo "  $entry: $n fabricated ${PREFIX}* symbol(s) with NO accounting entry: $(printf '%s\n' "$unaccounted" | tr '\n' ' ')" >> "$FAIL_LINES"
        FAILURES=$((FAILURES + 1))
    fi
}

# ------------------------------------------------------------------ selftest --
selftest() {
    command -v cc >/dev/null 2>&1 || { echo "ERROR — nothing was checked (selftest needs cc)"; exit 2; }
    d="$WORK/selftest"; mkdir -p "$d"
    cat > "$d/real.c" <<'EOF'
long rt_selftest_real(long a, long b);
long rt_selftest_real(long a, long b) { long s = 0; for (long i = 0; i < b; i++) s += a + i; return s; }
EOF
    cat > "$d/fab.c" <<'EOF'
__attribute__((weak)) long rt_selftest_fab(void);
__attribute__((weak)) long rt_selftest_fab(void) { return 0; }
EOF
    cat > "$d/main.c" <<'EOF'
long rt_selftest_real(long, long);
long rt_selftest_fab(void);
int main(void) { return (int)(rt_selftest_real(1, 2) + rt_selftest_fab()); }
EOF
    cc -O1 -o "$d/a.elf" "$d/main.c" "$d/real.c" "$d/fab.c" 2>/dev/null || {
        echo "ERROR — nothing was checked (selftest cc link failed)"; exit 2; }
    printf 'a rt_selftest_fab intentional selftest fixture\n' > "$d/acct.sdn"

    fails=0
    # (a) fabricated + accounted -> PASS. NON-VACUOUS: the run must also report
    # that it actually SAW the constant-return body, otherwise a classifier that
    # finds nothing would pass this fixture for the wrong reason.
    out=$(ACCOUNTING="$d/acct.sdn" sh "$0" --accounting "$d/acct.sdn" --prefix rt_selftest "$d/a.elf" 2>&1)
    case "$(printf '%s' "$out" | tail -1)" in
        PASS*) : ;;
        *) echo "selftest(a) expected PASS, got: $(printf '%s' "$out" | tail -1)"; fails=$((fails+1)) ;;
    esac
    if ! printf '%s' "$out" | grep -q "1 with a constant-return body"; then
        echo "selftest(a) VACUOUS: classifier found no constant-return body in the fixture"
        fails=$((fails+1))
    fi
    # (b) fabricated + NOT accounted -> FAIL  (the fail-closed property)
    : > "$d/empty.sdn"
    out=$(sh "$0" --accounting "$d/empty.sdn" --prefix rt_selftest "$d/a.elf" 2>&1)
    case "$(printf '%s' "$out" | tail -1)" in
        FAIL*) : ;;
        *) echo "selftest(b) expected FAIL, got: $(printf '%s' "$out" | tail -1)"; fails=$((fails+1)) ;;
    esac
    # (c) accounting row without a justification -> FAIL
    printf 'a rt_selftest_fab\n' > "$d/nojust.sdn"
    out=$(sh "$0" --accounting "$d/nojust.sdn" --prefix rt_selftest "$d/a.elf" 2>&1)
    case "$(printf '%s' "$out" | tail -1)" in
        FAIL*) : ;;
        *) echo "selftest(c) expected FAIL, got: $(printf '%s' "$out" | tail -1)"; fails=$((fails+1)) ;;
    esac
    # (d) empty symbol set -> ERROR, never PASS
    out=$(sh "$0" --accounting "$d/acct.sdn" --prefix rt_no_such_prefix_ "$d/a.elf" 2>&1)
    case "$(printf '%s' "$out" | tail -1)" in
        FAIL*|ERROR*) : ;;
        *) echo "selftest(d) expected FAIL/ERROR, got: $(printf '%s' "$out" | tail -1)"; fails=$((fails+1)) ;;
    esac
    # (e) no ELF at all -> ERROR
    out=$(sh "$0" --accounting "$d/acct.sdn" "$d/does-not-exist.elf" 2>&1)
    case "$(printf '%s' "$out" | tail -1)" in
        FAIL*|ERROR*) : ;;
        *) echo "selftest(e) expected FAIL/ERROR, got: $(printf '%s' "$out" | tail -1)"; fails=$((fails+1)) ;;
    esac

    if [ "$fails" -gt 0 ]; then
        echo "FAIL — selftest: $fails fixture(s) behaved wrongly"
        exit 1
    fi
    echo "PASS — 5 symbol(s) checked (selftest fixtures a-e)"
    exit 0
}

[ "$SELFTEST" -eq 1 ] && selftest

# --------------------------------------------------------------- ELF discovery --
if [ -z "$(printf '%s' "$ELFS" | tr -d ' ')" ]; then
    for cand in \
        build/simpleos_wm_fullscreen_evidence/*.elf \
        build/simpleos_wm_x86_lane/*.elf \
        build/os/simpleos_*.elf
    do
        [ -f "$cand" ] && ELFS="$ELFS $cand"
    done
fi

if [ -z "$(printf '%s' "$ELFS" | tr -d ' ')" ]; then
    echo "ERROR — nothing was checked (no SimpleOS kernel ELF found; build one or pass a path)"
    exit 2
fi

for elf in $ELFS; do
    scan_elf "$elf"
done

if [ "$SCANNED_ELFS" -eq 0 ] || [ "$TOTAL_CHECKED" -eq 0 ]; then
    if [ -s "$FAIL_LINES" ]; then
        echo "Findings:"
        cat "$FAIL_LINES"
    fi
    echo "ERROR — nothing was checked (no ELF yielded a usable ${PREFIX}* symbol set)"
    exit 2
fi

if [ "$FAILURES" -gt 0 ]; then
    echo "Findings:"
    cat "$FAIL_LINES"
    echo "Each name above has a constant-return body in the shipped kernel. Either"
    echo "implement it in the arch's boot/baremetal_stubs.c, or add a row to"
    echo "$ACCOUNTING as '<entry> <symbol> <why nil is the correct answer>'."
    echo "FAIL — $TOTAL_CHECKED symbol(s) checked across $SCANNED_ELFS ELF(s), $FAILURES finding(s)"
    exit 1
fi

echo "PASS — $TOTAL_CHECKED symbol(s) checked across $SCANNED_ELFS ELF(s), every constant-return body accounted for"
exit 0
