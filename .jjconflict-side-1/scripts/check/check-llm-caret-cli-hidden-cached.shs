#!/bin/sh
# Fail-closed cached-artifact plain-CLI evidence for Caret hidden commands.
# This deliberately has no PTY dependency: stdin is a pipe and TERM is dumb.
set -u

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "${SCRIPT_DIR}/../.." && pwd)
CARET_WRAPPER="${REPO_ROOT}/bin/caret"
ARTIFACT_ROOT="${REPO_ROOT}/build/test-artifacts/03_system/app/llm_caret/feature/llm_caret_cli_hidden_cached"
CASE_NAME=""
SHA256_TOOL=""
HOST_TARGET=""
CACHED_ARTIFACT=""
PROVENANCE_FILE=""
FAILURES=0

usage() {
    printf '%s\n' 'usage: sh scripts/check/check-llm-caret-cli-hidden-cached.shs --case <prerequisites|default|enabled|explicit-false|disabled|all>'
}

fail_prerequisite() {
    printf '%s\n' 'evidence_status=FAIL'
    printf '%s\n' 'failure_class=prerequisite'
    printf '%s\n' "failure_reason=$1"
    printf '%s\n' "artifact_root=${ARTIFACT_ROOT}"
    exit 1
}

record_pass() { printf '%s\n' "case=$1 status=PASS artifact=$2"; }
record_failure() {
    FAILURES=$((FAILURES + 1))
    printf '%s\n' "case=$1 status=FAIL reason=$2 artifact=$3"
}

select_sha256_tool() {
    if command -v shasum >/dev/null 2>&1; then SHA256_TOOL=shasum
    elif command -v sha256sum >/dev/null 2>&1; then SHA256_TOOL=sha256sum
    else fail_prerequisite sha256_utility_missing
    fi
}

sha256_file() {
    case "${SHA256_TOOL}" in
        shasum) shasum -a 256 "$1" | awk '{print $1}' ;;
        sha256sum) sha256sum "$1" | awk '{print $1}' ;;
        *) return 1 ;;
    esac
}

detect_host_target() {
    case "$(uname -m 2>/dev/null || printf unknown)" in
        arm64|aarch64) arch=aarch64 ;;
        x86_64|amd64) arch=x86_64 ;;
        *) return 1 ;;
    esac
    case "$(uname -s 2>/dev/null || printf unknown)" in
        Darwin) printf '%s\n' "${arch}-apple-darwin" ;;
        Linux) printf '%s\n' "${arch}-unknown-linux-gnu" ;;
        FreeBSD) printf '%s\n' "${arch}-unknown-freebsd" ;;
        *) return 1 ;;
    esac
}

provenance_value() {
    awk -F= -v requested="$1" '
        $1 == requested { sub(/^[^=]*=/, ""); count += 1; value = $0 }
        END { if (count == 1 && value != "") print value; else exit 1 }
    ' "$2"
}

current_source_commit() {
    if command -v jj >/dev/null 2>&1 && [ -e "${REPO_ROOT}/.jj" ]; then
        clean=$(cd "${REPO_ROOT}" && jj log -r @ --no-graph -T 'if(empty, "true", "false")' 2>/dev/null) || return 1
        [ "${clean}" = true ] || return 1
        cd "${REPO_ROOT}" && jj log -r @- --no-graph -T 'commit_id' 2>/dev/null
        return
    fi
    command -v git >/dev/null 2>&1 || return 1
    [ "$(git -C "${REPO_ROOT}" status --porcelain)" = "" ] || return 1
    git -C "${REPO_ROOT}" rev-parse --verify HEAD
}

first_cached_artifact() {
    for candidate in \
        "${REPO_ROOT}/build/bootstrap/caret-package/caret" \
        "${REPO_ROOT}/bin/release/${HOST_TARGET}/caret" \
        "${REPO_ROOT}/bin/release/aarch64-apple-darwin/caret" \
        "${REPO_ROOT}/bin/release/aarch64-apple-darwin-macho/caret" \
        "${REPO_ROOT}/bin/release/x86_64-apple-darwin/caret" \
        "${REPO_ROOT}/bin/release/x86_64-apple-darwin-macho/caret" \
        "${REPO_ROOT}/bin/release/x86_64-unknown-linux-gnu/caret" \
        "${REPO_ROOT}/bin/release/linux-x86_64/caret" \
        "${REPO_ROOT}/build/bootstrap/full/aarch64-apple-darwin/caret" \
        "${REPO_ROOT}/build/bootstrap/full/x86_64-apple-darwin/caret" \
        "${REPO_ROOT}/build/bootstrap/full/x86_64-unknown-linux-gnu/caret"
    do
        if [ -x "${candidate}" ]; then printf '%s\n' "${candidate}"; return 0; fi
    done
    return 1
}

require_hash() {
    printf '%s\n' "$2" | LC_ALL=C grep -Eq '^[0-9a-f]{64}$' || fail_prerequisite "$1_invalid"
}

verify_cached_artifact_provenance() {
    PROVENANCE_FILE="${CACHED_ARTIFACT}.provenance"
    [ -f "${PROVENANCE_FILE}" ] || fail_prerequisite cached_caret_provenance_missing
    source_commit=$(provenance_value source_commit "${PROVENANCE_FILE}") || fail_prerequisite provenance_source_commit_missing_or_duplicate
    binary_sha256=$(provenance_value binary_sha256 "${PROVENANCE_FILE}") || fail_prerequisite provenance_binary_sha256_missing_or_duplicate
    runtime_sha256=$(provenance_value runtime_sha256 "${PROVENANCE_FILE}") || fail_prerequisite provenance_runtime_sha256_missing_or_duplicate
    runtime_path=$(provenance_value runtime_path "${PROVENANCE_FILE}") || fail_prerequisite provenance_runtime_path_missing_or_duplicate
    runtime=$(provenance_value runtime "${PROVENANCE_FILE}") || fail_prerequisite provenance_runtime_missing_or_duplicate
    runtime_probe=$(provenance_value runtime_probe "${PROVENANCE_FILE}") || fail_prerequisite provenance_runtime_probe_missing_or_duplicate
    rust_seed_used=$(provenance_value rust_seed_used "${PROVENANCE_FILE}") || fail_prerequisite provenance_rust_seed_used_missing_or_duplicate
    target=$(provenance_value target "${PROVENANCE_FILE}") || fail_prerequisite provenance_target_missing_or_duplicate
    require_hash provenance_binary_sha256 "${binary_sha256}"
    require_hash provenance_runtime_sha256 "${runtime_sha256}"
    [ "${runtime}" = pure-simple-self-hosted ] || fail_prerequisite provenance_runtime_not_pure_simple_self_hosted
    [ "${runtime_probe}" = pass ] || fail_prerequisite provenance_runtime_probe_not_pass
    [ "${rust_seed_used}" = false ] || fail_prerequisite provenance_rust_seed_used_not_false
    [ "${target}" = "${HOST_TARGET}" ] || fail_prerequisite cached_caret_target_mismatch
    [ "${runtime_path}" = "bin/release/${target}/simple" ] || fail_prerequisite provenance_runtime_path_invalid
    runtime_binary="${REPO_ROOT}/${runtime_path}"
    [ -x "${runtime_binary}" ] || fail_prerequisite provenance_runtime_missing_or_not_executable
    [ "$(sha256_file "${CACHED_ARTIFACT}")" = "${binary_sha256}" ] || fail_prerequisite cached_caret_binary_hash_mismatch
    [ "$(sha256_file "${runtime_binary}")" = "${runtime_sha256}" ] || fail_prerequisite cached_caret_runtime_hash_mismatch
    current_commit=$(current_source_commit) || fail_prerequisite current_source_revision_not_clean_or_unavailable
    [ "${current_commit}" = "${source_commit}" ] || fail_prerequisite cached_caret_source_commit_mismatch
}

scrub_provider_credentials() {
    unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_API_KEY CLAUDE_CODE_OAUTH_TOKEN
    unset CLAUDE_AI_OAUTH_ACCESS_TOKEN CLAUDE_BRIDGE_OAUTH_TOKEN OPENAI_API_KEY
    unset AZURE_OPENAI_API_KEY GOOGLE_API_KEY GEMINI_API_KEY GOOGLE_APPLICATION_CREDENTIALS
    unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_PROFILE AWS_DEFAULT_PROFILE
    unset AWS_BEARER_TOKEN_BEDROCK ANTHROPIC_VERTEX_PROJECT_ID ANTHROPIC_BEDROCK_BASE_URL
    unset ANTHROPIC_FOUNDRY_API_KEY
}

prepare_prerequisites() {
    mkdir -p "${ARTIFACT_ROOT}" || fail_prerequisite artifact_directory_unavailable
    [ -x "${CARET_WRAPPER}" ] || fail_prerequisite bin_caret_not_executable
    select_sha256_tool
    HOST_TARGET=$(detect_host_target) || fail_prerequisite host_target_undetermined
    CACHED_ARTIFACT=$(first_cached_artifact) || fail_prerequisite cached_caret_artifact_missing
    verify_cached_artifact_provenance
    scrub_provider_credentials
    export SIMPLE_CARET_NATIVE="${CACHED_ARTIFACT}"
    export SIMPLE_CARET_ALLOW_SOURCE_FALLBACK=0
}

write_provenance() {
    printf '%s\n' "cached_artifact=${CACHED_ARTIFACT}"
    printf '%s\n' "provenance_file=${PROVENANCE_FILE}"
    printf '%s\n' 'mode=plain-non-tty'
    printf '%s\n' 'source_fallback=0'
    cat "${PROVENANCE_FILE}"
}

run_case() {
    label=$1 expected_exit=$2 required=$3 forbidden=$4 feature_flag=$5 input=$6
    case_dir="${ARTIFACT_ROOT}/${label}"
    mkdir -p "${case_dir}/home" || { record_failure "${label}" artifact_directory_unavailable "${case_dir}"; return; }
    printf '%s\n' "printf '%s\\n' '${input}' | bin/caret --provider dummy --plain" >"${case_dir}/command.txt"
    printf '%s\n' "feature_flag=${feature_flag}" >>"${case_dir}/command.txt"
    write_provenance >"${case_dir}/provenance.txt"
    if [ "${feature_flag}" = unset ]; then
        env -u LLM_CARET_ENABLE_HIDDEN_COMMANDS HOME="${case_dir}/home" TERM=dumb \
            sh -c 'printf "%s\\n" "$1" | "$2" --provider dummy --plain' sh "${input}" "${CARET_WRAPPER}" >"${case_dir}/stdout.raw" 2>"${case_dir}/stderr.raw"
    else
        LLM_CARET_ENABLE_HIDDEN_COMMANDS="${feature_flag}" HOME="${case_dir}/home" TERM=dumb \
            sh -c 'printf "%s\\n" "$1" | "$2" --provider dummy --plain' sh "${input}" "${CARET_WRAPPER}" >"${case_dir}/stdout.raw" 2>"${case_dir}/stderr.raw"
    fi
    status=$?
    sed 's/sk-ant-[[:alnum:]_-]*/[REDACTED:provider-secret]/g' "${case_dir}/stdout.raw" >"${case_dir}/stdout.txt"
    sed 's/sk-ant-[[:alnum:]_-]*/[REDACTED:provider-secret]/g' "${case_dir}/stderr.raw" >"${case_dir}/stderr.txt"
    rm -f "${case_dir}/stdout.raw" "${case_dir}/stderr.raw"
    printf '%s\n' "${status}" >"${case_dir}/exit.txt"
    { cat "${case_dir}/stdout.txt"; cat "${case_dir}/stderr.txt"; } >"${case_dir}/combined.txt"
    if [ "${status}" -ne "${expected_exit}" ]; then record_failure "${label}" "exit_${status}" "${case_dir}"
    elif ! grep -F "${required}" "${case_dir}/combined.txt" >/dev/null 2>&1; then record_failure "${label}" required_output_missing "${case_dir}"
    elif grep -F "${forbidden}" "${case_dir}/combined.txt" >/dev/null 2>&1; then record_failure "${label}" forbidden_output_present "${case_dir}"
    else record_pass "${label}" "${case_dir}"
    fi
}

run_prerequisites() {
    case_dir="${ARTIFACT_ROOT}/prerequisites"
    mkdir -p "${case_dir}" || fail_prerequisite prerequisite_artifact_unavailable
    printf '%s\n' "${CACHED_ARTIFACT}" >"${case_dir}/command.txt"
    write_provenance >"${case_dir}/provenance.txt"
    : >"${case_dir}/stdout.txt"; : >"${case_dir}/stderr.txt"; printf '0\n' >"${case_dir}/exit.txt"
    record_pass prerequisites "${case_dir}"
}

case "${1:-}" in
    --case) CASE_NAME=${2:-}; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) usage; exit 2 ;;
esac
[ "$#" -eq 0 ] || { usage; exit 2; }
case "${CASE_NAME}" in prerequisites|default|enabled|explicit-false|disabled|all) ;; *) usage; exit 2 ;; esac

TOOL_JSON='{"type":"tool_use","id":"call-1","name":"Read","input":{"file_path":"fixture.txt"}}'
prepare_prerequisites
if [ "${CASE_NAME}" = prerequisites ] || [ "${CASE_NAME}" = all ]; then run_prerequisites; fi
if [ "${CASE_NAME}" = default ] || [ "${CASE_NAME}" = all ]; then
    run_case hidden-canonical-default 0 'Unknown command: /debug-tool-call' 'tool call id=call-1' unset "/debug-tool-call ${TOOL_JSON}"
    run_case hidden-alias-default 0 'Unknown command: /debug_tool_call' 'tool call id=call-1' unset "/debug_tool_call ${TOOL_JSON}"
fi
if [ "${CASE_NAME}" = enabled ] || [ "${CASE_NAME}" = all ]; then
    run_case hidden-canonical-enabled 0 'tool call id=call-1 name=Read input_bytes=27' 'Unknown command:' 1 "/debug-tool-call ${TOOL_JSON}"
    run_case hidden-alias-enabled 0 'tool call id=call-1 name=Read input_bytes=27' 'Unknown command:' 1 "/debug_tool_call ${TOOL_JSON}"
fi
if [ "${CASE_NAME}" = explicit-false ] || [ "${CASE_NAME}" = all ]; then
    run_case hidden-canonical-false 0 'Unknown command: /debug-tool-call' 'tool call id=call-1' false "/debug-tool-call ${TOOL_JSON}"
    run_case hidden-alias-false 0 'Unknown command: /debug_tool_call' 'tool call id=call-1' false "/debug_tool_call ${TOOL_JSON}"
fi
if [ "${CASE_NAME}" = disabled ] || [ "${CASE_NAME}" = all ]; then
    run_case disabled-canonical 0 'Command disabled: /remote-setup' fixture-secret unset /remote-setup
    run_case disabled-alias 0 'Command disabled: /remote_setup' fixture-secret unset /remote_setup
fi
if [ "${FAILURES}" -ne 0 ]; then printf '%s\n' "evidence_status=FAIL failed_cases=${FAILURES}"; exit 1; fi
printf '%s\n' 'evidence_status=PASS'
