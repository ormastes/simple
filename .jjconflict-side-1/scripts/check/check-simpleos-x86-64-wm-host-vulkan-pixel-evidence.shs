#!/bin/sh
# check-simpleos-x86-64-wm-host-vulkan-pixel-evidence.shs
#
# WM smoke test for SimpleOS/x86_64 that captures REAL framebuffer pixels and
# states, honestly, WHICH renderer produced them.
#
# ARCHITECTURE — READ THIS BEFORE QUOTING THE VERDICT.
# There is NO in-guest Vulkan in SimpleOS.  `VulkanCompositorBackend`
# (src/os/compositor/vulkan_compositor_backend.spl) rejects every draw by its
# own written contract, and every `rt_vulkan_*` entry point is compiled out
# in-guest as `UNAVAILABLE(...)`
# (examples/09_embedded/simple_os/arch/x86_64/boot/freestanding_optional_backends.c:120-132).
# See doc/08_tracking/bug/simpleos_in_guest_vulkan_absent_wm_smoke_is_cpu_2026-08-31.md.
#
# What DOES exist is a guest -> host OFFLOAD: the guest WM encodes a draw IR,
# publishes it through an ivshmem BAR, and the host daemon
# (src/app/simpleos_gpu_host/) executes it on a real host GPU via Vulkan.
# `gui_entry_desktop.spl:598` already wires the WM's frame executor to it via
# `Engine2dWmFrameExecutor.create_host_gpu(..., SIMPLEOS_HOST_GPU_BACKEND_VULKAN, ...)`.
#
# So when this gate reports `renderer=host-vulkan` it means, exactly:
#     GPU work happened ON THE HOST, in the daemon, not in the guest.
# The guest has no GPU and never did.  `renderer=cpu` means the guest's
# baremetal software rasteriser drew the frame.  Never quote this gate as
# evidence of an in-guest GPU.
#
# `gui_entry_desktop.spl:598` passes `backend_required: false`, so the WM
# SILENTLY FALLS BACK to the CPU rasteriser when the offload does not
# negotiate.  A pretty screenshot therefore proves nothing about the renderer
# on its own.  That is why `renderer=host-vulkan` here requires BOTH a guest
# serial receipt AND an independent host daemon receipt (see classify_renderer).
#
# Boot: OVMF pflash -> GRUB (multiboot) -> kernel _start.  Never QEMU `-kernel`,
# never `isa-debug-exit` (.claude/rules/board-runnable.md).  argv is
# self-scanned for both before QEMU is started.
#
# Verdict (last line of stdout, always):
#   PASS  — <n> ... checked ... renderer=<host-vulkan|cpu>   exit 0
#   FAIL  — ...                                              exit 1
#   ERROR — nothing was checked: <reason>                    exit 2
# Zero captured frames is ERROR, never a pass.
#
# Usage:
#   sh scripts/check/check-simpleos-x86-64-wm-host-vulkan-pixel-evidence.shs
#   sh scripts/check/check-simpleos-x86-64-wm-host-vulkan-pixel-evidence.shs --selftest

set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT_DIR"

BUILD_DIR=${WM_VULKAN_BUILD_DIR:-build/simpleos_wm_vulkan}
EVIDENCE_DIR=$BUILD_DIR/evidence
KERNEL_ELF=${WM_VULKAN_KERNEL_ELF:-build/os/simpleos_x86_64_desktop_engine2d.elf}
DAEMON_BIN=${WM_VULKAN_DAEMON_BIN:-$BUILD_DIR/simpleos_gpu_host}
PPM_VALIDATOR=scripts/check/screen_ppm_distinct_colors.spl
SIMPLE_BIN=${SIMPLE_BIN:-}
READY_TIMEOUT_MS=${WM_VULKAN_READY_TIMEOUT_MS:-90000}
DAEMON_READY_TIMEOUT_MS=${WM_VULKAN_DAEMON_READY_TIMEOUT_MS:-30000}

READY_MARKER='\[desktop-gui\] desktop-ready'
# Emitted by Engine2dWmFrameExecutor once the offload has negotiated AND a
# frame has actually been presented through it.
GUEST_VULKAN_MARKER='^\[wm-frame\] host-gpu-ready backend=vulkan generation=[1-9][0-9]*'
GUEST_PRESENT_MARKER='^\[wm-frame\] host-gpu-presented'
# Emitted by the HOST DAEMON when it has executed WM draw-IR work on a real GPU
# device.
#
# This gate previously grepped the daemon log for `HOST_GPU_PROCESS_OK`, which
# the daemon NEVER emits — that line comes from the GUEST probe entry
# (examples/09_embedded/simple_os/arch/common/host_gpu_ivshmem_probe_entry.spl:399).
# The host half of the dual-receipt classifier was therefore unsatisfiable and
# this gate could only ever report renderer=cpu, whatever the GPU did.
#
# The correct daemon receipt is HOST_GPU_DAEMON_DRAWIR
# (src/app/simpleos_gpu_host/daemon_runner.spl:413), printed from the
# SIMPLEOS_HOST_GPU_KIND_DRAW_IR branch — the branch the WM frame executor
# actually submits to — and ONLY when `device_backed` holds: GPU backend
# selected, no fallback, zero skipped commands, readback_source=device_readback,
# a real backend handle, a nonzero readback checksum and a real device identity.
# A CPU fallback or a partial render cannot print it.
#
# NOT `HOST_GPU_PROCESS_PERF` (daemon_runner.spl:350): that lives in the
# SIMPLEOS_HOST_GPU_KIND_PROCESSING branch — the compute fixture path, not the
# WM path — and is additionally gated on `processing_verify_cpu`.  A WM smoke
# run never prints it, so anchoring on it would have left this gate
# unsatisfiable exactly as before, just behind a different banner.
HOST_VULKAN_RECEIPT='^HOST_GPU_DAEMON_DRAWIR backend=vulkan frame=[1-9][0-9]* submit_id=[1-9][0-9]* fence_id=[1-9][0-9]* fence_completed=true '

EV_CHECKED=0
QEMU_PID=
DAEMON_PID=

# ---------------------------------------------------------------- verdicts --
pass_verdict() {
    printf 'PASS — %s\n' "$1"
    exit 0
}
fail_verdict() {
    printf 'FAIL — %s\n' "$1"
    exit 1
}
error_verdict() {
    printf 'ERROR — nothing was checked: %s\n' "$1"
    exit 2
}

cleanup() {
    [ -z "$QEMU_PID" ] || kill "$QEMU_PID" 2>/dev/null || true
    [ -z "$DAEMON_PID" ] || kill "$DAEMON_PID" 2>/dev/null || true
}
trap cleanup 0 HUP INT TERM

# --------------------------------------------------------- argv rule guard --
# The board-runnable rule is enforced on the argv we are ABOUT to run, not on
# the argv we intended to run, so a later edit cannot quietly reintroduce a
# forbidden flag.
argv_is_board_runnable() {
    for _a in "$@"; do
        case "$_a" in
            -kernel|isa-debug-exit|*isa-debug-exit*) return 1 ;;
        esac
    done
    return 0
}

# ------------------------------------------------------------- classifiers --
# Real pixel content, delegated to the shared PPM validator, which exits 0 only
# when the dump parses AND carries more than one distinct colour.  A blank or
# single-colour frame therefore cannot pass.
ppm_has_real_content() {
    _ppm=$1
    [ -s "$_ppm" ] || return 1
    _out=$("$SIMPLE_RUNNER" run "$PPM_VALIDATOR" "$_ppm" 2>/dev/null) || return 1
    _colors=$(printf '%s\n' "$_out" | sed -n 's/^ppm_distinct_colors=//p' | head -n 1)
    case "$_colors" in ''|*[!0-9]*) return 1 ;; esac
    PPM_DISTINCT_COLORS=$_colors
    [ "$_colors" -gt 1 ]
}

# renderer=host-vulkan requires BOTH sides to agree, independently:
#   guest side: the WM says it presented a frame through the offload;
#   host side:  the daemon says it executed that work on a Vulkan device.
# Either alone is insufficient.  A daemon that merely STARTED (selector line,
# device present) is explicitly not enough — that is the exact fail-open filed
# in engine2d_vulkan_window_8k_gate_is_device_present_proxy_2026-08-31.md.
#
# NONCE ANCHORING (not a fixed banner).  Both receipts must name the SAME
# (run, frame) pair for THIS run.  `run` is the guest's host_gpu_run_id_hash,
# minted per boot; `frame` is the presented frame id.  A stale daemon log from
# an earlier run, or a daemon receipt for some other frame, therefore cannot
# cross-satisfy a fresh guest receipt.  This is why the classifier parses the
# fields instead of grepping two independent banners.
guest_presented_field() {
    sed -n 's/^\[wm-frame\] host-gpu-presented .*[[:space:]]'"$2"'=\([0-9][0-9]*\).*$/\1/p' "$1" | head -n 1
}

classify_renderer() {
    _serial=$1
    _daemonlog=$2
    [ -f "$_serial" ] && [ -f "$_daemonlog" ] || { printf 'cpu\n'; return 0; }
    grep -qaE "$GUEST_VULKAN_MARKER" "$_serial" || { printf 'cpu\n'; return 0; }
    grep -qaE "$GUEST_PRESENT_MARKER" "$_serial" || { printf 'cpu\n'; return 0; }
    grep -qaE "$HOST_VULKAN_RECEIPT" "$_daemonlog" || { printf 'cpu\n'; return 0; }
    _frame=$(guest_presented_field "$_serial" frame)
    _submit=$(guest_presented_field "$_serial" submit_id)
    _fence=$(guest_presented_field "$_serial" fence_id)
    case "$_frame" in ''|*[!0-9]*|0) printf 'cpu\n'; return 0 ;; esac
    case "$_submit" in ''|*[!0-9]*|0) printf 'cpu\n'; return 0 ;; esac
    case "$_fence" in ''|*[!0-9]*|0) printf 'cpu\n'; return 0 ;; esac
    # The daemon receipt must name this exact frame AND this exact submission.
    if grep -qaE "^HOST_GPU_DAEMON_DRAWIR backend=vulkan frame=$_frame submit_id=$_submit fence_id=$_fence fence_completed=true " "$_daemonlog"; then
        printf 'host-vulkan\n'
    else
        printf 'cpu\n'
    fi
}

wait_for_marker() {
    _file=$1; _pattern=$2; _budget=$3
    _w=0
    while [ "$_w" -le "$_budget" ]; do
        if [ -f "$_file" ] && grep -qaE "$_pattern" "$_file" 2>/dev/null; then
            return 0
        fi
        sleep 0.2
        _w=$((_w + 200))
    done
    return 1
}

# ----------------------------------------------------------------- selftest --
# Fatal, runs before any scan.  Every fixture is fed to the REAL classifier
# above, never to a copy of it.
run_selftest() {
    _t=$(mktemp -d "${TMPDIR:-/tmp}/wm-vulkan-selftest.XXXXXX") || return 1
    _fails=0

    # (1) argv self-scan must reject -kernel.
    if argv_is_board_runnable -machine q35 -kernel /x/kernel.elf -display none; then
        echo "selftest: FAIL — argv guard accepted -kernel"; _fails=$((_fails + 1))
    fi
    # (2) argv self-scan must reject isa-debug-exit.
    if argv_is_board_runnable -machine q35 -device isa-debug-exit,iobase=0xf4; then
        echo "selftest: FAIL — argv guard accepted isa-debug-exit"; _fails=$((_fails + 1))
    fi
    # (3) a legitimate real-firmware argv must be accepted.
    if ! argv_is_board_runnable -machine q35 -drive if=pflash,file=OVMF_CODE.fd -display none; then
        echo "selftest: FAIL — argv guard rejected a real-firmware argv"; _fails=$((_fails + 1))
    fi

    # (4) BLANK frame must FAIL the pixel bar (single colour).
    #     P6 2x2, every pixel identical.
    printf 'P6\n2 2\n255\n' > "$_t/blank.ppm"
    printf '\000\000\000\000\000\000\000\000\000\000\000\000' >> "$_t/blank.ppm"
    if ppm_has_real_content "$_t/blank.ppm"; then
        echo "selftest: FAIL — blank frame accepted as real content"; _fails=$((_fails + 1))
    fi
    # (5) SINGLE-COLOUR non-black frame must also FAIL.
    printf 'P6\n2 2\n255\n' > "$_t/single.ppm"
    printf '\377\000\000\377\000\000\377\000\000\377\000\000' >> "$_t/single.ppm"
    if ppm_has_real_content "$_t/single.ppm"; then
        echo "selftest: FAIL — single-colour frame accepted as real content"; _fails=$((_fails + 1))
    fi
    # (6) genuinely multi-colour frame must PASS.
    printf 'P6\n2 2\n255\n' > "$_t/multi.ppm"
    printf '\377\000\000\000\377\000\000\000\377\377\377\377' >> "$_t/multi.ppm"
    if ! ppm_has_real_content "$_t/multi.ppm"; then
        echo "selftest: FAIL — multi-colour frame rejected"; _fails=$((_fails + 1))
    fi
    # (7) a zero-byte capture must FAIL, never be skipped.
    : > "$_t/empty.ppm"
    if ppm_has_real_content "$_t/empty.ppm"; then
        echo "selftest: FAIL — zero-byte capture accepted"; _fails=$((_fails + 1))
    fi

    # (8) DEVICE-PRESENT-BUT-NO-GPU-WORK must classify as cpu, not host-vulkan.
    #     This replays the filed engine2d-vulkan-window-8k fail-open: the daemon
    #     started and found a device, but never executed anything.
    cat > "$_t/serial-nogpu.log" <<'EOF'
[desktop-gui] framebuffer ready width=3840 height=2160 pitch=15360
[desktop-gui] desktop-ready
EOF
    cat > "$_t/daemon-devpresent.log" <<'EOF'
HOST_GPU_DAEMON_SELECTOR processing_backend=vulkan
HOST_GPU_DEVICE_PRESENT vendor=nvidia readback_bytes=0
EOF
    if [ "$(classify_renderer "$_t/serial-nogpu.log" "$_t/daemon-devpresent.log")" != cpu ]; then
        echo "selftest: FAIL — device-present-with-no-pixels classified as host-vulkan"
        _fails=$((_fails + 1))
    fi
    # (9) guest receipt WITHOUT host receipt must classify as cpu.
    cat > "$_t/serial-guest.log" <<'EOF'
[wm-frame] host-gpu-ready backend=vulkan generation=48
[wm-frame] host-gpu-presented backend=vulkan generation=48 run=770425 frame=49 submit_id=7 fence_id=7 fence_completed=true device_frame_id=49 checksum=1417723768
[desktop-gui] desktop-ready
EOF
    if [ "$(classify_renderer "$_t/serial-guest.log" "$_t/daemon-devpresent.log")" != cpu ]; then
        echo "selftest: FAIL — guest-only receipt classified as host-vulkan"
        _fails=$((_fails + 1))
    fi
    # (10) host receipt WITHOUT guest receipt must classify as cpu.
    cat > "$_t/daemon-ok.log" <<'EOF'
HOST_GPU_DAEMON_SELECTOR processing_backend=vulkan
HOST_GPU_DAEMON_DRAWIR backend=vulkan frame=49 submit_id=7 fence_id=7 fence_completed=true device_frame_id=49 rendered=214 skipped=0 readback=device_readback
EOF
    if [ "$(classify_renderer "$_t/serial-nogpu.log" "$_t/daemon-ok.log")" != cpu ]; then
        echo "selftest: FAIL — host-only receipt classified as host-vulkan"
        _fails=$((_fails + 1))
    fi
    # (11) BOTH receipts must classify as host-vulkan.
    if [ "$(classify_renderer "$_t/serial-guest.log" "$_t/daemon-ok.log")" != host-vulkan ]; then
        echo "selftest: FAIL — both receipts did not classify as host-vulkan"
        _fails=$((_fails + 1))
    fi
    # (12) a missing daemon log must classify as cpu, never crash.
    if [ "$(classify_renderer "$_t/serial-guest.log" "$_t/absent.log")" != cpu ]; then
        echo "selftest: FAIL — missing daemon log did not classify as cpu"
        _fails=$((_fails + 1))
    fi
    # (13) NONCE MISMATCH — a daemon receipt from a DIFFERENT run must classify
    #      as cpu.  This is the stale-log cross-satisfaction hazard: without
    #      frame/submit anchoring, a leftover daemon log would green a fresh boot.
    cat > "$_t/daemon-otherrun.log" <<'EOF'
HOST_GPU_DAEMON_SELECTOR processing_backend=vulkan
HOST_GPU_DAEMON_DRAWIR backend=vulkan frame=49 submit_id=99 fence_id=99 fence_completed=true device_frame_id=49 rendered=214 skipped=0 readback=device_readback
EOF
    if [ "$(classify_renderer "$_t/serial-guest.log" "$_t/daemon-otherrun.log")" != cpu ]; then
        echo "selftest: FAIL — daemon receipt from a different submission classified as host-vulkan"
        _fails=$((_fails + 1))
    fi
    # (14) FRAME MISMATCH — right submission ids, wrong frame, must be cpu.
    cat > "$_t/daemon-otherframe.log" <<'EOF'
HOST_GPU_DAEMON_SELECTOR processing_backend=vulkan
HOST_GPU_DAEMON_DRAWIR backend=vulkan frame=7 submit_id=7 fence_id=7 fence_completed=true device_frame_id=7 rendered=214 skipped=0 readback=device_readback
EOF
    if [ "$(classify_renderer "$_t/serial-guest.log" "$_t/daemon-otherframe.log")" != cpu ]; then
        echo "selftest: FAIL — daemon receipt for a different frame classified as host-vulkan"
        _fails=$((_fails + 1))
    fi
    # (15) CPU BACKEND — matching frame/submit ids but backend=cpu with a
    #      cpu_readback means the CPU fallback drew it.  Must classify as cpu.
    cat > "$_t/daemon-nodevice.log" <<'EOF'
HOST_GPU_DAEMON_SELECTOR processing_backend=vulkan
HOST_GPU_DAEMON_DRAWIR backend=cpu frame=49 submit_id=7 fence_id=7 fence_completed=true device_frame_id=49 rendered=214 skipped=0 readback=cpu_readback
EOF
    if [ "$(classify_renderer "$_t/serial-guest.log" "$_t/daemon-nodevice.log")" != cpu ]; then
        echo "selftest: FAIL — cpu-backend receipt classified as host-vulkan"
        _fails=$((_fails + 1))
    fi
    # (16) the guest-side HOST_GPU_PROCESS_OK line must NOT satisfy the host
    #      side.  That line is emitted by the GUEST probe entry, never by the
    #      daemon; treating it as a daemon receipt is the bug this gate carried.
    cat > "$_t/daemon-guestline.log" <<'EOF'
HOST_GPU_DAEMON_SELECTOR processing_backend=vulkan
HOST_GPU_PROCESS_OK isa=x86_64 backend=vulkan generation=48 run=770425 frame=49
EOF
    if [ "$(classify_renderer "$_t/serial-guest.log" "$_t/daemon-guestline.log")" != cpu ]; then
        echo "selftest: FAIL — guest-emitted PROCESS_OK accepted as a daemon receipt"
        _fails=$((_fails + 1))
    fi
    # (17) a PROCESSING-path receipt must NOT satisfy the WM draw path.
    #      HOST_GPU_PROCESS_PERF comes from the KIND_PROCESSING branch (the
    #      compute fixture), never from KIND_DRAW_IR.  Accepting it would make
    #      this gate green off a workload that is not the window manager.
    cat > "$_t/daemon-processing.log" <<'EOF'
HOST_GPU_DAEMON_SELECTOR processing_backend=vulkan
HOST_GPU_PROCESS_PERF isa=x86_64 backend=vulkan generation=48 run=770425 frame=49 cpu_us=8100 device_us=1900 preference=preferred
EOF
    if [ "$(classify_renderer "$_t/serial-guest.log" "$_t/daemon-processing.log")" != cpu ]; then
        echo "selftest: FAIL — processing-path receipt accepted as a WM draw-IR receipt"
        _fails=$((_fails + 1))
    fi

    rm -rf "$_t"
    [ "$_fails" -eq 0 ] || return 1
    echo "[wm-host-vulkan] selftest OK (17 fixtures)"
    return 0
}

# ------------------------------------------------------------ runner lookup --
# The PPM validator is a .spl and needs an interpreter.  Any working `simple`
# will do; this gate does NOT require an admitted Stage-2 compiler, because it
# is not building a compiler, only reading a file.
resolve_simple_runner() {
    for _c in "$SIMPLE_BIN" "$ROOT_DIR/bin/simple" \
              "$ROOT_DIR/src/compiler_rust/target/release/simple"; do
        [ -n "$_c" ] || continue
        [ -x "$_c" ] || continue
        SIMPLE_RUNNER=$_c
        return 0
    done
    return 1
}

resolve_simple_runner || error_verdict "no runnable simple binary for the PPM validator"
[ -f "$PPM_VALIDATOR" ] || error_verdict "PPM validator missing: $PPM_VALIDATOR"

run_selftest || error_verdict "selftest failed (fatal)"

case "${1:-}" in
    --selftest) pass_verdict "17 selftest fixture(s) checked, classifier and pixel bar behave (no boot attempted), renderer=n/a" ;;
esac

# --------------------------------------------------------- preconditions ----
command -v qemu-system-x86_64 >/dev/null 2>&1 || error_verdict "qemu-system-x86_64 not installed"
GRUB_MKSTANDALONE=$(command -v grub-mkstandalone || command -v grub2-mkstandalone || true)
[ -n "$GRUB_MKSTANDALONE" ] || error_verdict "grub-mkstandalone not installed (needed for the OVMF->GRUB->multiboot chain)"

OVMF_CODE=${OVMF_CODE:-/usr/share/OVMF/OVMF_CODE_4M.fd}
OVMF_VARS_SRC=${OVMF_VARS_SRC:-/usr/share/OVMF/OVMF_VARS_4M.fd}
[ -f "$OVMF_CODE" ] || error_verdict "OVMF_CODE not found: $OVMF_CODE"
[ -f "$OVMF_VARS_SRC" ] || error_verdict "OVMF_VARS not found: $OVMF_VARS_SRC"

[ -f "$KERNEL_ELF" ] || error_verdict "WM kernel ELF missing: $KERNEL_ELF (build gui_entry_desktop.spl first)"
[ -x "$DAEMON_BIN" ] || error_verdict "host GPU daemon missing: $DAEMON_BIN"

mkdir -p "$EVIDENCE_DIR"
SERIAL_LOG=$EVIDENCE_DIR/serial.log
DAEMON_LOG=$EVIDENCE_DIR/daemon.log
QEMU_STDERR=$EVIDENCE_DIR/qemu.stderr
QMP_SOCKET=$EVIDENCE_DIR/qmp.sock
SHM_FILE=$EVIDENCE_DIR/hostgpu.shm
PPM_FRAME=$EVIDENCE_DIR/wm-frame.ppm
rm -f "$SERIAL_LOG" "$DAEMON_LOG" "$QEMU_STDERR" "$QMP_SOCKET" "$SHM_FILE" "$PPM_FRAME"

# --------------------------------------------- 1. host GPU daemon (Vulkan) --
: > "$SHM_FILE"
# 8M shared window, matching the ivshmem-plain size below.
dd if=/dev/zero of="$SHM_FILE" bs=1M count=8 status=none 2>/dev/null ||
    error_verdict "could not size the ivshmem backing file"

"$DAEMON_BIN" "--shm=$SHM_FILE" --processing-backend=vulkan --processing-verify-cpu \
    >"$DAEMON_LOG" 2>&1 &
DAEMON_PID=$!

if ! wait_for_marker "$DAEMON_LOG" '^HOST_GPU_DAEMON_SELECTOR processing_backend=vulkan' \
                     "$DAEMON_READY_TIMEOUT_MS"; then
    echo "--- daemon log tail ---"; tail -10 "$DAEMON_LOG" 2>/dev/null
    error_verdict "host GPU daemon never selected a Vulkan backend (no GPU work is possible; refusing to boot and mislabel a CPU frame)"
fi

# ------------------------------- 2. package the WM kernel for real firmware --
UEFI_BUILD=$BUILD_DIR/uefi
ESP=$UEFI_BUILD/esp
EFIAPP=$ESP/EFI/BOOT/BOOTX64.EFI
OVMF_VARS=$UEFI_BUILD/OVMF_VARS_4M.fd
rm -rf "$UEFI_BUILD"
mkdir -p "$ESP/EFI/BOOT"
cp "$OVMF_VARS_SRC" "$OVMF_VARS"
cat > "$UEFI_BUILD/grub.cfg" <<'CFG'
set timeout=0
set default=0
insmod multiboot
insmod normal
menuentry "SimpleOS WM host-GPU Vulkan (UEFI/multiboot)" {
    echo "[grub-uefi] multiboot loading /boot/kernel.elf ..."
    multiboot /boot/kernel.elf
    boot
}
CFG
"$GRUB_MKSTANDALONE" --format=x86_64-efi --output="$EFIAPP" \
    --modules="multiboot normal echo part_gpt fat" \
    "boot/grub/grub.cfg=$UEFI_BUILD/grub.cfg" \
    "boot/kernel.elf=$KERNEL_ELF" >/dev/null 2>&1
[ -f "$EFIAPP" ] || error_verdict "grub-mkstandalone did not produce BOOTX64.EFI"

# --------------------------------------- 3. boot under REAL firmware (OVMF) --
# vgamem_mb is raised because gui_entry_desktop.spl asks BGA for a 3840x2160
# 32bpp scanout, which does not fit the default std-vga VRAM.
set -- -no-user-config -monitor none -net none \
    -machine q35 -cpu qemu64 -m 2G \
    -drive "if=pflash,format=raw,readonly=on,file=$OVMF_CODE" \
    -drive "if=pflash,format=raw,file=$OVMF_VARS" \
    -drive "file=fat:rw:$ESP,format=raw,id=esp,if=none" \
    -device virtio-blk-pci,drive=esp,bootindex=0 \
    -device VGA,vgamem_mb=128 \
    -object "memory-backend-file,id=hostgpu,share=on,mem-path=$SHM_FILE,size=8M" \
    -device ivshmem-plain,memdev=hostgpu \
    -serial "file:$SERIAL_LOG" \
    -display none -no-reboot \
    -qmp "unix:$QMP_SOCKET,server,nowait"

argv_is_board_runnable "$@" ||
    error_verdict "refusing to run: argv contains -kernel or isa-debug-exit (board-runnable rule)"

qemu-system-x86_64 "$@" 2>"$QEMU_STDERR" &
QEMU_PID=$!

waited=0
while [ "$waited" -le 20000 ]; do
    [ -S "$QMP_SOCKET" ] && break
    kill -0 "$QEMU_PID" 2>/dev/null || break
    sleep 0.1
    waited=$((waited + 100))
done
[ -S "$QMP_SOCKET" ] || { tail -5 "$QEMU_STDERR" 2>/dev/null; error_verdict "QMP socket never appeared"; }

# ------------------------------------------------------- 4. wait for the WM --
if ! wait_for_marker "$SERIAL_LOG" "$READY_MARKER" "$READY_TIMEOUT_MS"; then
    echo "--- serial tail ---"; tail -20 "$SERIAL_LOG" 2>/dev/null
    fail_verdict "1 boot checked, WM never reached desktop-ready under OVMF (serial: $SERIAL_LOG), renderer=unknown"
fi
EV_CHECKED=$((EV_CHECKED + 1))

grep -qa 'grub-uefi\] multiboot loading' "$SERIAL_LOG" 2>/dev/null &&
    EV_CHECKED=$((EV_CHECKED + 1))

# Give the frame executor a moment to negotiate and present through the offload.
sleep 3

# ------------------------------------------------ 5. capture a REAL frame ----
"$SIMPLE_RUNNER" run scripts/check/qmp_screendump.spl "$QMP_SOCKET" "$ROOT_DIR/$PPM_FRAME" \
    >/dev/null 2>&1 || true
if [ ! -s "$PPM_FRAME" ]; then
    error_verdict "zero frames captured (QMP screendump produced no file); a device being present is not evidence"
fi
EV_CHECKED=$((EV_CHECKED + 1))

PPM_DISTINCT_COLORS=0
if ! ppm_has_real_content "$PPM_FRAME"; then
    fail_verdict "$EV_CHECKED item(s) checked, captured frame is blank or single-colour (distinct_colors=$PPM_DISTINCT_COLORS, $PPM_FRAME), renderer=unknown"
fi
EV_CHECKED=$((EV_CHECKED + 1))

# --------------------------------------------------- 6. name the renderer ----
RENDERER=$(classify_renderer "$SERIAL_LOG" "$DAEMON_LOG")
EV_CHECKED=$((EV_CHECKED + 1))

cleanup

printf 'simpleos_wm_host_vulkan_serial_log=%s\n' "$SERIAL_LOG"
printf 'simpleos_wm_host_vulkan_daemon_log=%s\n' "$DAEMON_LOG"
printf 'simpleos_wm_host_vulkan_frame_ppm=%s\n' "$PPM_FRAME"
printf 'simpleos_wm_host_vulkan_distinct_colors=%s\n' "$PPM_DISTINCT_COLORS"
printf 'simpleos_wm_host_vulkan_renderer=%s\n' "$RENDERER"

if [ "$RENDERER" = host-vulkan ]; then
    pass_verdict "$EV_CHECKED item(s) checked, SimpleOS x86_64 WM booted under real OVMF firmware (OVMF pflash -> GRUB -> multiboot; no -kernel, no isa-debug-exit) and presented a frame with $PPM_DISTINCT_COLORS distinct colours; guest wm-frame receipt AND host daemon HOST_GPU_PROCESS_OK both name Vulkan, renderer=host-vulkan (GPU work ran ON THE HOST daemon, NOT in the guest)"
fi

pass_verdict "$EV_CHECKED item(s) checked, SimpleOS x86_64 WM booted under real OVMF firmware (OVMF pflash -> GRUB -> multiboot; no -kernel, no isa-debug-exit) and presented a frame with $PPM_DISTINCT_COLORS distinct colours; the host-GPU offload did not negotiate, so the guest software rasteriser drew it, renderer=cpu"
