#!/bin/sh
# Source-shape regression guard for the embedded SSH AES-256-GCM v2 provider.
# It verifies export and registration only; it does not claim runtime or
# cryptographic-provider admission evidence.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
rv64="$root/examples/09_embedded/simple_os/arch/riscv64/boot/tls13_aes256_gcm_helper.c"
x86="$root/examples/09_embedded/simple_os/arch/x86_64/boot/tls13_aes256_gcm_helper.c"
catalog="$root/src/os/port/_SimpleosMultiplatformBuild/platform_target_catalog.spl"

grep -q '^spl_i64 rt_ssh_aes256_gcm_decrypt_packet_v2(' "$rv64"
grep -q 'rt_ssh_aes256_gcm_v2_status(0U)' "$rv64"
grep -q 'rt_ssh_aes256_gcm_v2_status(1U)' "$rv64"
grep -q 'plaintext\[1ULL + payload_len\] = 2U;' "$rv64"
grep -q 'rt_copy_bytes_out(plaintext + 1ULL, payload_len + 1ULL)' "$rv64"
! grep -Eq 'weak[^[:cntrl:]]*rt_ssh_aes256_gcm_decrypt_packet_v2|rt_ssh_aes256_gcm_decrypt_packet_v2[^[:cntrl:]]*weak' "$rv64"

grep -q '^#define rt_ssh_aes256_gcm_decrypt_packet_v2 x86_ssh_aes256_gcm_decrypt_packet_v2_tagged$' "$x86"
grep -q '^#undef rt_ssh_aes256_gcm_decrypt_packet_v2$' "$x86"
grep -q '^spl_i64 rt_ssh_aes256_gcm_decrypt_packet_v2(' "$x86"
grep -q 'x86_ssh_aes256_gcm_decrypt_packet_v2_tagged' "$x86"

grep -q 'examples/09_embedded/simple_os/arch/riscv64/boot/tls13_aes256_gcm_helper.c' "$catalog"

echo 'SSH GCM SFFI v2 embedded providers: PASS (source export/registration only)'
