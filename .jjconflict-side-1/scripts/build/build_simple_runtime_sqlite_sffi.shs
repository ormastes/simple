#!/bin/sh
# Build the SQLite runtime provider used by hosted native evidence lanes.
#
# `src/runtime/runtime_sqlite.c` owns the rt_sqlite_* extern surface that
# `std.io.sqlite_sffi` declares, but it needs <sqlite3.h>/-lsqlite3 and is
# therefore deliberately absent from the compiler's default core C runtime
# (see `compile_runtime_objects` in
# `src/compiler/70.backend/backend/runtime_compiler.spl`). Hosted entries whose
# closure reaches the database layer must supply it explicitly through
# SIMPLE_LINK_OBJECTS, exactly like the winit and hosted-runtime providers.
set -eu

REPO_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
OUT_DIR="$REPO_ROOT/build/sffi"
SRC="$REPO_ROOT/src/runtime/runtime_sqlite.c"

case "$(uname -s)" in
  Darwin) EXT="dylib" ;;
  Linux|FreeBSD) EXT="so" ;;
  *) echo "[build_simple_runtime_sqlite_sffi] unsupported host" >&2; exit 1 ;;
esac

[ -s "$SRC" ] || { echo "[build_simple_runtime_sqlite_sffi] missing $SRC" >&2; exit 1; }

CC="${CC:-cc}"
mkdir -p "$OUT_DIR"
DST="$OUT_DIR/libsimple_runtime_sqlite_wm.$EXT"

case "$(uname -s)" in
  Darwin)
    SDK_PATH="$(xcrun --show-sdk-path)"
    "$CC" -dynamiclib -Os -fPIC -std=gnu11 \
      -isysroot "$SDK_PATH" \
      -I"$REPO_ROOT/src/runtime" -I"$REPO_ROOT/src/runtime/platform" \
      -Wl,-undefined,dynamic_lookup \
      -Wl,-install_name,@rpath/libsimple_runtime_sqlite_wm.dylib \
      "$SRC" -o "$DST.new" -lsqlite3
    ;;
  *)
    "$CC" -shared -Os -fPIC -std=gnu11 \
      -I"$REPO_ROOT/src/runtime" -I"$REPO_ROOT/src/runtime/platform" \
      "$SRC" -o "$DST.new" -lsqlite3
    ;;
esac

mv "$DST.new" "$DST"
# Fail closed: an empty or symbol-less provider must never look like success.
nm -g "$DST" 2>/dev/null | grep -Eq '(_| )rt_sqlite_open$' ||
  { echo "[build_simple_runtime_sqlite_sffi] provider lacks rt_sqlite_open" >&2; exit 1; }
nm -g "$DST" 2>/dev/null | grep -Eq '(_| )rt_sqlite_query_next$' ||
  { echo "[build_simple_runtime_sqlite_sffi] provider lacks rt_sqlite_query_next" >&2; exit 1; }
echo "[build_simple_runtime_sqlite_sffi] staged: $DST"
