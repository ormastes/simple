#!/bin/sh
# Build the spl_winit SFFI sibling cdylib and stage it where the GuiRenderer
# facade looks for it (build/sffi/libspl_winit.<ext>).
#
# The facade (src/lib/nogc_sync_mut/ui/gui_renderer.spl) resolves, in order:
#   1. $SIMPLE_SPL_WINIT_PATH  (explicit override)
#   2. build/sffi/libspl_winit.<dylib|so|dll>  (this script's output)
#
# No seed/bootstrap rebuild: this is a standalone cdylib loaded at runtime via
# spl_dlopen. See doc/04_architecture/ui/rendering/backend_isolation_architecture.md.
set -eu

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
CRATE_DIR="$REPO_ROOT/src/runtime/spl_winit"
OUT_DIR="$REPO_ROOT/build/sffi"

case "$(uname -s)" in
  Darwin) EXT="dylib" ;;
  Linux)  EXT="so" ;;
  *)      EXT="dll" ;;
esac

echo "[build_spl_winit] cargo build --release ($CRATE_DIR)"
( cd "$CRATE_DIR" && cargo build --release )

mkdir -p "$OUT_DIR"
SRC="$CRATE_DIR/target/release/libspl_winit.$EXT"
DST="$OUT_DIR/libspl_winit.$EXT"
cp "$SRC" "$DST.new"
if [ "$(uname -s)" = Darwin ]; then
  install_name_tool -id "@rpath/libspl_winit.dylib" "$DST.new"
  codesign --verify "$DST.new"
fi
mv "$DST.new" "$DST"
echo "[build_spl_winit] staged: $DST"
