#!/bin/sh
# pq-sign-lib.shs — sourced helpers for the hash-based script-signing scheme
# `wots-merkle-sha256-w16-h8` (WOTS w=16 one-time signatures under a Merkle
# tree of height 8, SHA-256 only). Quantum resistance rests solely on SHA-256
# preimage / second-preimage resistance; no number-theoretic assumption exists.
#
# Byte-exact contract (the pure-Simple verifier in
# src/lib/nogc_sync_mut/trust/script_signature.spl implements the SAME bytes):
#   H = SHA-256, n = 32. w = 16, len1 = 64, len2 = 3, len = 67 chains.
#   sk[i][j] = H("wots-sk" || sk_seed(32) || i:u32be || j:u16be)
#   F(x)     = H("wots-f"  || pub_seed(32) || x(32))
#   leaf[i]  = H("wots-pk" || pk_0 || ... || pk_66),  pk_j = F^15(sk[i][j])
#   node     = H("node" || left(32) || right(32));  root = level-8 node
#   m        = H("msg" || script bytes); b_0..b_63 = nibbles of m (high first)
#   C        = sum(15 - b_j) for j < 64; b_64..b_66 = 12-bit big-endian C
#   sig_j    = F^{b_j}(sk[i][j]);  verify: pk_j = F^{15-b_j}(sig_j)
#
# Design rules honoured here:
#   * Binary bytes NEVER live in a shell variable. Every hash input is a hex
#     string that is decoded to raw bytes by ONE `xxd -r -p` (or od-free
#     fallback) and piped straight into the digest tool, so the concatenation
#     is byte-exact (no NUL or trailing-newline hazards).
#   * The digest tool's exit status is captured on the line after the call.
#   * Seeds are never printed. Functions that touch sk_seed write only to
#     files inside the key dir or return derived (public) values.
#
# Key dir layout (mode 0700):  sk_seed  pub_seed  next_leaf  key_id  root  tree
#   `tree` caches all 511 Merkle nodes as `L<level>_<index>=<hex>` so that
#   signing reads its auth path instead of recomputing 256 leaves (~17k hashes).

PQ_ALG="wots-merkle-sha256-w16-h8"
PQ_TREE_HEIGHT=8
PQ_LEAVES=256
PQ_CHAINS=67
PQ_W_MAX=15
# 64 question marks: glob that strips exactly one 32-byte hex word.
PQ_Q64=$(printf "%064d" 0 | tr 0 "?")

# ASCII domain prefixes, pre-hexed so the whole hash input is one hex string.
PQ_PFX_SK="776f74732d736b"      # "wots-sk"
PQ_PFX_F="776f74732d66"         # "wots-f"
PQ_PFX_PK="776f74732d706b"      # "wots-pk"
PQ_PFX_NODE="6e6f6465"          # "node"
PQ_PFX_MSG="6d7367"             # "msg"

pq_die() {
    printf '%s\n' "pq-sign: $*" >&2
    exit 2
}

# Pick the digest tool once. Output is normalised to a bare 64-hex line.
pq_detect_hasher() {
    if [ -n "${PQ_HASHER:-}" ]; then
        return 0
    fi
    if command -v sha256sum >/dev/null 2>&1; then
        PQ_HASHER=sha256sum
    elif command -v openssl >/dev/null 2>&1; then
        PQ_HASHER=openssl
    else
        pq_die "no sha256sum or openssl on PATH"
    fi
    if command -v xxd >/dev/null 2>&1; then
        PQ_UNHEX=xxd
    else
        PQ_UNHEX=printf
    fi
}

# pq_sha256_stdin: read raw bytes on stdin, print lowercase hex digest.
pq_sha256_stdin() {
    if [ "$PQ_HASHER" = sha256sum ]; then
        _out=$(sha256sum)
        _rc=$?
        [ "$_rc" -eq 0 ] || pq_die "sha256sum failed"
        printf '%s\n' "${_out%% *}"
    else
        _out=$(openssl dgst -sha256)
        _rc=$?
        [ "$_rc" -eq 0 ] || pq_die "openssl dgst failed"
        printf '%s\n' "${_out##* }"
    fi
}

# pq_unhex_stdin: hex on stdin -> raw bytes on stdout.
pq_unhex_stdin() {
    if [ "$PQ_UNHEX" = xxd ]; then
        xxd -r -p
    else
        # Portable fallback: emit octal escapes for printf. Slow but exact.
        _hex=$(cat)
        _fmt=""
        while [ -n "$_hex" ]; do
            _b=${_hex%"${_hex#??}"}
            _hex=${_hex#??}
            _fmt="$_fmt\\$(printf '%03o' "0x$_b")"
        done
        # shellcheck disable=SC2059
        printf "$_fmt"
    fi
}

# pq_hash_hex HEX: SHA-256 of the raw bytes encoded by HEX.
pq_hash_hex() {
    printf '%s' "$1" | pq_unhex_stdin | pq_sha256_stdin
}

# pq_hash_prefixed_file PREFIX_HEX FILE: SHA-256(prefix bytes || file bytes).
pq_hash_prefixed_file() {
    { printf '%s' "$1" | pq_unhex_stdin; cat "$2"; } | pq_sha256_stdin
}

pq_is_hex64() {
    case "$1" in
        *[!0-9a-f]*) return 1 ;;
    esac
    [ "${#1}" -eq 64 ]
}

# pq_random_hex32: 32 random bytes as 64 hex from /dev/urandom.
pq_random_hex32() {
    _r=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')
    _rc=$?
    [ "$_rc" -eq 0 ] && [ "${#_r}" -eq 64 ] || pq_die "urandom read failed"
    printf '%s\n' "$_r"
}

# pq_chain_key SK_SEED_HEX I J -> hex
pq_chain_key() {
    pq_hash_hex "${PQ_PFX_SK}$1$(printf '%08x%04x' "$2" "$3")"
}

# pq_f PUB_SEED_HEX X_HEX -> hex   (one chain step)
pq_f() {
    pq_hash_hex "${PQ_PFX_F}$1$2"
}

# pq_f_n PUB_SEED_HEX X_HEX K -> hex  (K applications of F)
pq_f_n() {
    _x=$2
    _k=$3
    while [ "$_k" -gt 0 ]; do
        _x=$(pq_f "$1" "$_x")
        _k=$((_k - 1))
    done
    printf '%s\n' "$_x"
}

# pq_node LEFT_HEX RIGHT_HEX -> hex
pq_node() {
    pq_hash_hex "${PQ_PFX_NODE}$1$2"
}

# pq_leaf SK_SEED_HEX PUB_SEED_HEX I -> leaf hex (public)
pq_leaf() {
    _cat=""
    _j=0
    while [ "$_j" -lt "$PQ_CHAINS" ]; do
        _sk=$(pq_chain_key "$1" "$3" "$_j")
        _pk=$(pq_f_n "$2" "$_sk" "$PQ_W_MAX")
        _cat="$_cat$_pk"
        _j=$((_j + 1))
    done
    pq_hash_hex "${PQ_PFX_PK}$_cat"
}

# pq_msg_digest FILE -> hex of H("msg" || file bytes)
pq_msg_digest() {
    pq_hash_prefixed_file "$PQ_PFX_MSG" "$1"
}

# pq_nibble_value HEXCHAR -> decimal
pq_nibble_value() {
    case "$1" in
        [0-9]) printf '%s\n' "$1" ;;
        a) echo 10 ;; b) echo 11 ;; c) echo 12 ;;
        d) echo 13 ;; e) echo 14 ;; f) echo 15 ;;
        *) pq_die "bad hex digit '$1'" ;;
    esac
}

# pq_digits_of DIGEST_HEX -> 67 space-separated nibble values (b_0..b_66)
pq_digits_of() {
    _d=$1
    _out=""
    _sum=0
    _n=0
    while [ "$_n" -lt 64 ]; do
        _c=${_d%"${_d#?}"}
        _d=${_d#?}
        _v=$(pq_nibble_value "$_c")
        _out="$_out $_v"
        _sum=$((_sum + 15 - _v))
        _n=$((_n + 1))
    done
    _out="$_out $(( (_sum >> 8) & 15 )) $(( (_sum >> 4) & 15 )) $(( _sum & 15 ))"
    printf '%s\n' "${_out# }"
}

# pq_tree_get TREEFILE LEVEL INDEX -> hex
pq_tree_get() {
    _line=$(grep "^L$2_$3=" "$1")
    _rc=$?
    [ "$_rc" -eq 0 ] || pq_die "tree node L$2_$3 missing in $1"
    printf '%s\n' "${_line#*=}"
}

# pq_build_tree LEAFDIR TREEFILE: LEAFDIR holds files 0..255 with leaf hex.
# Writes every node as L<level>_<index>=<hex>; prints the root.
pq_build_tree() {
    _leafdir=$1
    _tree=$2
    : > "$_tree"
    _i=0
    while [ "$_i" -lt "$PQ_LEAVES" ]; do
        read -r _h < "$_leafdir/$_i" || pq_die "leaf $_i missing"
        pq_is_hex64 "$_h" || pq_die "leaf $_i malformed"
        printf 'L0_%s=%s\n' "$_i" "$_h" >> "$_tree"
        _i=$((_i + 1))
    done
    _lvl=0
    _count=$PQ_LEAVES
    while [ "$_lvl" -lt "$PQ_TREE_HEIGHT" ]; do
        _i=0
        _next=$((_lvl + 1))
        while [ "$_i" -lt "$_count" ]; do
            _l=$(pq_tree_get "$_tree" "$_lvl" "$_i")
            _r=$(pq_tree_get "$_tree" "$_lvl" "$((_i + 1))")
            printf 'L%s_%s=%s\n' "$_next" "$((_i / 2))" "$(pq_node "$_l" "$_r")" >> "$_tree"
            _i=$((_i + 2))
        done
        _count=$((_count / 2))
        _lvl=$_next
    done
    pq_tree_get "$_tree" "$PQ_TREE_HEIGHT" 0
}

# pq_auth_path TREEFILE LEAF -> 8 hex lines, leaf level first
pq_auth_path() {
    _idx=$2
    _lvl=0
    while [ "$_lvl" -lt "$PQ_TREE_HEIGHT" ]; do
        _sib=$(( (_idx >> _lvl) ^ 1 ))
        pq_tree_get "$1" "$_lvl" "$_sib"
        _lvl=$((_lvl + 1))
    done
}

# pq_kv FILE KEY -> value (first match), empty if absent
pq_kv() {
    _line=$(grep "^$2=" "$1" 2>/dev/null | head -n 1)
    printf '%s\n' "${_line#*=}"
}

# pq_atomic_write FILE CONTENT: tmp + mv in the same directory.
pq_atomic_write() {
    _tmp="$1.tmp.$$"
    printf '%s\n' "$2" > "$_tmp" || pq_die "cannot write $_tmp"
    mv -f "$_tmp" "$1" || pq_die "cannot move $_tmp to $1"
}

# pq_load_key KEYDIR: sets PQ_SK_SEED PQ_PUB_SEED PQ_KEY_ID PQ_ROOT PQ_NEXT_LEAF
pq_load_key() {
    _kd=$1
    [ -d "$_kd" ] || pq_die "key dir $_kd does not exist"
    for _f in sk_seed pub_seed next_leaf key_id root tree; do
        [ -f "$_kd/$_f" ] || pq_die "key dir $_kd is missing $_f"
    done
    read -r PQ_SK_SEED < "$_kd/sk_seed"
    read -r PQ_PUB_SEED < "$_kd/pub_seed"
    read -r PQ_NEXT_LEAF < "$_kd/next_leaf"
    read -r PQ_KEY_ID < "$_kd/key_id"
    read -r PQ_ROOT < "$_kd/root"
    pq_is_hex64 "$PQ_SK_SEED" || pq_die "sk_seed malformed"
    pq_is_hex64 "$PQ_PUB_SEED" || pq_die "pub_seed malformed"
    pq_is_hex64 "$PQ_ROOT" || pq_die "root malformed"
    case "$PQ_NEXT_LEAF" in
        ''|*[!0-9]*) pq_die "next_leaf malformed" ;;
    esac
}

# pq_verify_file SCRIPT SIGFILE PUBFILE: prints "ok" or "reason"; exit 0 on ok
pq_verify_file() {
    _script=$1
    _sig=$2
    _pub=$3
    [ -f "$_script" ] || { echo "script missing"; return 1; }
    [ -f "$_sig" ] || { echo "signature file missing"; return 1; }
    [ -f "$_pub" ] || { echo "public root file missing"; return 1; }
    _alg=$(pq_kv "$_sig" alg)
    [ "$_alg" = "$PQ_ALG" ] || { echo "unsupported alg '$_alg'"; return 1; }
    _palg=$(pq_kv "$_pub" alg)
    [ "$_palg" = "$PQ_ALG" ] || { echo "public root alg mismatch"; return 1; }
    _kid=$(pq_kv "$_sig" key_id)
    _pkid=$(pq_kv "$_pub" key_id)
    [ -n "$_kid" ] && [ "$_kid" = "$_pkid" ] || { echo "key_id mismatch"; return 1; }
    _root=$(pq_kv "$_pub" root)
    _pseed=$(pq_kv "$_pub" pub_seed)
    pq_is_hex64 "$_root" || { echo "public root malformed"; return 1; }
    pq_is_hex64 "$_pseed" || { echo "pub_seed malformed"; return 1; }
    _leaf=$(pq_kv "$_sig" leaf)
    case "$_leaf" in
        ''|*[!0-9]*) echo "leaf malformed"; return 1 ;;
    esac
    [ "$_leaf" -lt "$PQ_LEAVES" ] || { echo "leaf out of range"; return 1; }
    _sigv=$(pq_kv "$_sig" sig)
    _auth=$(pq_kv "$_sig" auth)
    [ "${#_sigv}" -eq $((PQ_CHAINS * 64)) ] || { echo "sig length wrong"; return 1; }
    [ "${#_auth}" -eq $((PQ_TREE_HEIGHT * 64)) ] || { echo "auth length wrong"; return 1; }
    case "$_sigv$_auth" in
        *[!0-9a-f]*) echo "sig not lowercase hex"; return 1 ;;
    esac
    _m=$(pq_msg_digest "$_script")
    set -- $(pq_digits_of "$_m")
    _cat=""
    _rest=$_sigv
    for _b in "$@"; do
        _s=${_rest%"${_rest#$PQ_Q64}"}
        _rest=${_rest#$PQ_Q64}
        _pk=$(pq_f_n "$_pseed" "$_s" $((PQ_W_MAX - _b)))
        _cat="$_cat$_pk"
    done
    _node=$(pq_hash_hex "${PQ_PFX_PK}$_cat")
    _idx=$_leaf
    _rest=$_auth
    _lvl=0
    while [ "$_lvl" -lt "$PQ_TREE_HEIGHT" ]; do
        _a=${_rest%"${_rest#$PQ_Q64}"}
        _rest=${_rest#$PQ_Q64}
        if [ $((_idx & 1)) -eq 0 ]; then
            _node=$(pq_node "$_node" "$_a")
        else
            _node=$(pq_node "$_a" "$_node")
        fi
        _idx=$((_idx >> 1))
        _lvl=$((_lvl + 1))
    done
    [ "$_node" = "$_root" ] || { echo "root mismatch"; return 1; }
    echo ok
    return 0
}

pq_detect_hasher
