# Counterpart provider lockfile.
#
# Tests never download "latest" upstream source at runtime. Every provider that
# links or drives an upstream project pins its revision and hashes here; `fetch`
# is the only network phase and normal runs use the local verified cache under
# build/counterparts/.
#
# A provider absent from this file is UNAVAILABLE, never PASS.
#
# ponytail: only the mock pilot is locked so far. Real entries land with their
# provider lane (P2 zlib/libdeflate, P3 HarfBuzz, P4 OpenSSL) — each adds one
# record here plus its descriptor under providers/. The resolver that verifies
# these hashes is lane F2 and is not written yet; until it exists, a locked
# record is a declaration, not an enforced gate.

counterpart_lock:
  schema_version: 1

  entries:
    - provider_id: mock
      upstream_url: ""
      upstream_revision: ""
      source_archive_sha256: ""
      patch_set_sha256: ""
      adapter_source_sha256: pending
      build_recipe_version: 1
      toolchain_identity: host-cc
      target_triple: x86_64-unknown-linux-gnu
      build_options: "-O2 -fPIC -shared"
      license_spdx: Apache-2.0
      artifact_sha256: pending
      sbom_sha256: pending
