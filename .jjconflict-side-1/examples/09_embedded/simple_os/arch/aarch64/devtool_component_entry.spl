# SimpleOS aarch64 in-guest DEV TOOL component sanity entry (EDK2/AAVMF lane).
#
# Boot chain: EDK2/AAVMF pflash -> vendor/limine/BOOTAA64.EFI (a real EFI
# application on a FAT ESP) -> this kernel ELF. NEVER QEMU `-kernel`, NEVER
# isa-debug-exit (.claude/rules/board-runnable.md); the gate self-checks the
# assembled QEMU argv for both before starting the VM.
#
# Port of examples/09_embedded/simple_os/arch/riscv64/devtool_component_entry.spl,
# which proved this row GREEN in-guest on riscv64. Only the console primitive
# (`log_raw_println` on PL011 rather than an extern `serial_println`) and the
# entry glue (`_start`, EL1, MMU already on) differ; the component logic is the
# same real product call.
#
# Components are built as SEPARATE kernels, never one combined image: the
# combined --entry-closure union on riscv64 left ~500 rt_* symbols undefined,
# so one component's closure must not hold the others hostage.
#
# WHAT THIS PROVES: a REAL lint rule from the real linter runs inside the guest
# over source text. The clean snippet must yield zero findings and the dirty
# snippet at least one — two conditions in OPPOSITE directions, so a rule that
# degraded to "always clean" or "always flags" fails this row rather than
# passing it. The rule is `lint_os_freestanding_patterns`, unmodified product
# code; this file supplies the snippets and prints what came back.
#
# COMPILER: the RUST SEED. The pure-Simple self-hosted compiler cannot compile
# anything in this tree yet.
#
# NEVER interpolate an integer into text — that emits rt_raw_i64_to_string,
# which the freestanding aarch64 runtime does not provide, and the link dies.

use os.kernel.log.klog_api.{log_init_serial, log_raw_println, LOG_INFO}
use compiler.tools.lint._LintMain.os_freestanding_lints.{lint_os_freestanding_patterns}

@unsafe(reason: "bare WFE park has no artifact-verified contract", capabilities: [ffi])
extern fn rt_aarch64_wfe_spin()

fn devtool_component_row() -> i64:
    """Run the REAL os-freestanding lint rule over two snippets."""
    val clean = "fn f() -> i64:\n    val x = 1\n    x\n"
    # A module-level global whose initializer is a CALL — exactly what
    # _fsk_check_global_call_init flags in a freestanding OS source file. The
    # path matters: os_freestanding_lint_in_scope() only fires under src/os/ or
    # examples/09_embedded/, so a path outside those would make BOTH snippets
    # silent and the row would look clean for the wrong reason.
    val dirty = "val g = make_thing()\nfn f() -> i64:\n    0\n"

    val clean_warnings = lint_os_freestanding_patterns("src/os/probe_clean.spl", clean)
    val dirty_warnings = lint_os_freestanding_patterns("src/os/probe_dirty.spl", dirty)

    log_raw_println("[devtool] lint src/os/probe_clean.spl  (expect no findings)")
    log_raw_println("[devtool] lint src/os/probe_dirty.spl  (expect a finding)")
    for w in dirty_warnings:
        log_raw_println("[devtool] finding: " + w.message)

    var rc = 0
    if clean_warnings.len() != 0:
        log_raw_println("[devtool] FAIL clean snippet produced findings")
        rc = 1
    if dirty_warnings.len() == 0:
        log_raw_println("[devtool] FAIL dirty snippet produced no finding — the rule is inert")
        rc = 1
    if rc == 0:
        log_raw_println("COMPONENT_DEVTOOL_SIMPLEOS_AARCH64_OK real lint rule ran in-guest, clean snippet silent and dirty snippet flagged")
    rc

@noreturn
fn _start():
    """aarch64 in-guest dev-tool sanity entry.

    Limine hands off at EL1 with the MMU on and a valid stack, so no assembly
    boot glue is needed (unlike riscv64/x86_64). The function MUST be named
    literally `_start` — native-build only auto-generates the
    `--defsym=_start=<mangled>` alias for a top-level function of that exact
    name in the entry file.
    """
    log_init_serial(LOG_INFO)
    log_raw_println("")
    log_raw_println("[components] SimpleOS aarch64 in-guest toolchain components (EDK2/AAVMF -> BOOTAA64.EFI)")
    log_raw_println("[components] serial up, exercising real product modules")
    val rc = devtool_component_row()
    if rc == 0:
        log_raw_println("[components] all component rows exited rc=0")
    else:
        log_raw_println("[components] at least one component row exited rc=nonzero")
    log_raw_println("[components] parking")
    while true:
        unsafe:
            rt_aarch64_wfe_spin()
