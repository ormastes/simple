# Print SSDOC findings per spec: path, rule, deduction.
use app.sspec_maintain.analyzer.{analyze_sspec_text}
use std.cli.cli_util.{get_cli_args}
use std.nogc_sync_mut.io.file_ops.{file_read}

fn main() -> i64:
    val args = get_cli_args()
    var i: i64 = 0
    while i < args.len():
        val path = args[i]
        val source = file_read(path) ?? ""
        if source != "":
            val report = analyze_sspec_text(path, source)
            for finding in report.findings:
                print "{path}\t{finding.rule_id}\t{finding.score_deduction}\t{finding.evidence}"
        i = i + 1
    0
