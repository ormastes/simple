use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}
use compiler.traits.trait_validation.{TraitError, create_builtin_traits}
use compiler.driver.driver_source_loading.{_format_trait_error}

val VALIDATION_SOURCE = "src/compiler/25.traits/trait_validation.spl"
val SOLVER_SOURCE = "src/compiler/25.traits/trait_solver.spl"
val DRIVER_SOURCE = "src/compiler/80.driver/driver_source_loading.spl"
val SYMBOL_OWNER_IMPORT = "use compiler.hir.hir_types.{Symbol}"

describe "trait Symbol owner boundary":
    it "constructs built-in trait symbols through the defining module":
        val traits = create_builtin_traits()
        expect(traits.len()).to_be_greater_than(0)
        expect(traits[0].name.name.len()).to_be_greater_than(0)
        val formatted = _format_trait_error(TraitError.UndefinedTrait(traits[0].name, traits[0].span))
        expect(formatted).to_contain("undefined trait")

    it "keeps signature-visible Symbol imports on the concrete HIR owner":
        val validation = file_read(VALIDATION_SOURCE)
        val solver = file_read(SOLVER_SOURCE)
        val driver = file_read(DRIVER_SOURCE)
        expect(validation).to_contain("HirType, HirTypeKind, SymbolId, HirSymbol,")
        expect(solver).to_contain(SYMBOL_OWNER_IMPORT)
        expect(solver.contains("    use compiler.hir.hir_types.{Symbol}")).to_be(false)
        expect(validation).to_contain("UndefinedTrait(name: HirSymbol, span: Span)")
        expect(validation).to_contain("builtin_trait_symbol(id: i64, name: text, span: Span) -> HirSymbol")
        expect(validation.contains("-> Symbol:")).to_be(false)
        expect(validation.contains("UndefinedTrait(name: Symbol, span: Span)")).to_be(false)
        expect(driver).to_contain("use compiler.hir.hir_types.{HirSymbol}")
        expect(driver).to_contain("use compiler.types.type_infer_types.{TypeInferError}")
        expect(driver.contains("use compiler.types.type_infer.*")).to_be(false)
