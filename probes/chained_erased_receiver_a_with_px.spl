# Variant A-with-Px: chained `.to_i32()` on the erased `char_code_at` result,
# with a struct in the unit that also defines `to_i32`.
struct Px:
    value: i32

    fn to_i32() -> i32:
        self.value

fn main():
    val s: text = "A5"
    val chained = s.char_code_at(0).to_i32()
    print("A chained=" + chained.to_text())
