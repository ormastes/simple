# Sanity-check for the extract_css_vw degenerate-groups receipt: a style
# block whose only rule sits behind a non-matching @media condition should
# scan a candidate (total_candidates>0) but emit zero selector groups,
# firing "[css-extract] degenerate candidates=N groups=0".
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{simple_web_layout_render_html_draw_ir_result}

fn main():
    val html = "<html><head><style>@media (min-width: 99999px) { .x { color: #ff0000; } }</style></head><body><div class=\"x\">hi</div></body></html>"
    val r = simple_web_layout_render_html_draw_ir_result(html, 64, 32)
    print "CSS_RECEIPT_PROBE_OK batches={r.composition.batches.len()}"
