extern fn rt_heap_registry_count() -> i64
extern fn rt_string_free(value: text) -> i64

fn main() -> i64:
    val before = rt_heap_registry_count()
    var arr: [text] = []
    var i = 0
    while i < 5000:
        arr = arr.push("dynamic_string_marker_number_padding_padding_padding_" + i.to_text())
        i = i + 1
    val after_fill = rt_heap_registry_count()

    # The fix under test: explicitly free each string instead of only
    # dropping the reference (which reclaims nothing on this no-GC runtime).
    var freed = 0
    var k = 0
    while k < 5000:
        freed = freed + rt_string_free(arr[k])
        k = k + 1
    val after_free = rt_heap_registry_count()

    # Refusal check: freeing the same values again must reclaim nothing.
    var refused = 0
    var m = 0
    while m < 5000:
        refused = refused + rt_string_free(arr[m])
        m = m + 1
    val after_double = rt_heap_registry_count()

    print "before={before} after_fill={after_fill} after_free={after_free}"
    print "delta_fill={after_fill - before} delta_free={after_free - after_fill}"
    print "freed={freed} double_freed={refused} delta_double={after_double - after_free}"
    0
