# Runnable check for the native-digest fast path in font_registry.
#
# Loads and validates every pinned font asset. Two things must hold:
#   1. every asset reports valid=true — the native file digest must equal the
#      pinned sha256, i.e. the fast path returns what blob-hashing returned;
#   2. it finishes in seconds, not hours.
# Before the fast path this whole set hashed at ~2.9 KB/s (~5h for the 52MB of
# pinned faces). See doc/08_tracking/bug/engine2d_load_font_interpreter_3kb_per_sec_2026-07-25.md
use std.common.encoding.font_registry.{selected_font_asset_candidates, load_selected_font_file}

fn main():
    val candidates = selected_font_asset_candidates()
    print "FONT_PROBE candidates={candidates.len()}"
    var bad: i64 = 0
    var total_bytes: i64 = 0
    var i: i64 = 0
    while i < candidates.len():
        val c = candidates[i]
        val lp: text = c.local_path
        val want: i64 = c.byte_len
        val (blob, validation) = load_selected_font_file(lp)
        val got = blob.len()
        val ok: bool = validation.valid
        val reason: text = validation.reason
        total_bytes = total_bytes + got
        if not ok or got != want:
            bad = bad + 1
            print "FONT_PROBE_BAD {i} bytes={got} want={want} valid={ok} reason={reason}"
        i = i + 1
    print "FONT_PROBE bytes={total_bytes} bad={bad}"
    if bad == 0:
        print "FONT_PROBE_PASS"
    else:
        print "FONT_PROBE_FAIL"
