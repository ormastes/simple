# Variant E: the struct method is renamed so no name collision with the
# builtin conversion exists. Sole difference from *_a_with_px.spl.
struct Px:
    value: i32

    fn as_i32() -> i32:
        self.value

fn main():
    val s: text = "A5"
    val chained = s.char_code_at(0).to_i32()
    print("E chained=" + chained.to_text())
