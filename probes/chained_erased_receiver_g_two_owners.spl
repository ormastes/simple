# Variant G: two unrelated structs both define `to_i32` with distinguishable
# constant bodies. Whichever value prints names the owner the misroute picked.
struct Ax:
    value: i32

    fn to_i32() -> i32:
        11

struct Bx:
    value: i32

    fn to_i32() -> i32:
        22

fn main():
    val s: text = "A5"
    val chained = s.char_code_at(0).to_i32()
    print("G chained=" + chained.to_text())
