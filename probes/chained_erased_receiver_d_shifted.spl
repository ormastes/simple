# Variant D: identical to *_a_with_px.spl plus four dummy locals ahead of the
# chained call, to shift the receiver's LocalId. If the crash disappears, the
# misroute is keyed on a per-function LocalId table (layout sensitivity).
struct Px:
    value: i32

    fn to_i32() -> i32:
        self.value

fn main():
    val d0 = 1
    val d1 = 2
    val d2 = 3
    val d3 = 4
    val s: text = "A5"
    val chained = s.char_code_at(0).to_i32()
    print("D chained=" + chained.to_text() + " pad=" + (d0 + d1 + d2 + d3).to_text())
