# Probe for doc/08_tracking/bug/f64_integral_to_text_drops_fraction_2026-07-25.md
#
# Covers both f64 -> text paths that the bug report calls out:
#   (a) string interpolation  "{x}"   (Value::to_display_string)
#   (b) explicit .to_text()           (float method dispatch)
# Expected rule: shortest decimal string that parses back to the SAME f64,
# with ".0" forced onto any value whose shortest form is integer-looking.
# Non-finite values (inf / -inf / NaN) pass through untouched.

fn show(label: text, v: f64) -> void:
    val t = v.to_text()
    print "{label}\tinterp={v}\tto_text={t}"

fn main() -> void:
    # Built by overflow, not by x/0.0: the interpreter traps on f64 division
    # by zero (doc/08_tracking/bug/ — seed interp f64/0), so overflow is the
    # portable way to reach inf in both the JIT and interpreter lanes.
    val big = 1e308
    val inf = big * 10.0
    val ninf = 0.0 - inf
    val nan = inf + ninf
    show("1.0", 1.0)
    show("0.0", 0.0)
    show("-1.0", -1.0)
    show("1.5", 1.5)
    show("0.1", 0.1)
    show("2.25", 2.25)
    show("-3.0", -3.0)
    show("1e15", 1e15)
    show("1e300", 1e300)
    show("1e-300", 1e-300)
    show("third", 1.0 / 3.0)
    show("inf", inf)
    show("-inf", ninf)
    show("nan", nan)
