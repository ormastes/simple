# Variant F: same as *_a_with_px.spl but `main` is declared BEFORE `Px`.
# Sole difference is declaration order (hence MIR lowering order).
fn main():
    val s: text = "A5"
    val chained = s.char_code_at(0).to_i32()
    print("F chained=" + chained.to_text())

struct Px:
    value: i32

    fn to_i32() -> i32:
        self.value
