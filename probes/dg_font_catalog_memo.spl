use std.common.encoding.font_registry.{selected_font_asset_candidates, simpleos_default_font_asset_candidate, selected_font_asset_candidate_for_path}

# Checks that memoizing the font candidate catalog preserves its contents.
# The catalog backs font identity/sha lookups, so a wrong length, order or
# field would corrupt font selection silently rather than fail loudly.
fn main():
    val first = selected_font_asset_candidates()
    val second = selected_font_asset_candidates()
    val len_ok = if first.len() == 16 and second.len() == 16: 1 else: 0
    print("CATALOG len_first={first.len()} len_second={second.len()} len_ok={len_ok}")

    # Same contents on the memoized second call, spot-checked at both ends and
    # at index 8 (the documented fallback entry).
    val f0 = first[0].family
    val s0 = second[0].family
    val f8 = first[8].family
    val s8 = second[8].family
    val f15 = first[15].family
    val s15 = second[15].family
    val same_ok = if f0 == s0 and f8 == s8 and f15 == s15: 1 else: 0
    print("CATALOG f0='{f0}' f8='{f8}' f15='{f15}' same_ok={same_ok}")

    # Byte-size and digest fields must survive memoization — these are what
    # font identity is derived from.
    val b0_first = first[0].byte_len
    val b0_second = second[0].byte_len
    val d0_first = first[0].sha256
    val d0_second = second[0].sha256
    val fields_ok = if b0_first == b0_second and d0_first == d0_second: 1 else: 0
    print("CATALOG bytes={b0_first} digest_len={d0_first.len()} fields_ok={fields_ok}")

    # The pinned SimpleOS default must still resolve through the memoized path.
    val def_family = simpleos_default_font_asset_candidate().family
    val def_ok = if def_family == "Noto Sans Mono": 1 else: 0
    print("CATALOG default_family='{def_family}' def_ok={def_ok}")

    # And a by-path lookup must still hit.
    val by_path = selected_font_asset_candidate_for_path("assets/fonts/google-fonts/ofl/notosansmono/NotoSansMono[wdth,wght].ttf")
    val path_ok = if by_path != nil: 1 else: 0
    print("CATALOG by_path_found={by_path != nil} path_ok={path_ok}")
