# Probe for the extract_css_vw inline-conversion (group_parts_list_prefix /
# split_selector_group_parts inlined to keep aggregate arrays local; see
# doc/08_tracking/bug/cranelift_native_aggregate_return_nil_receiver_hosted_wm_2026-07-26.md).
# Renders a document whose <style> block has 3 rules and asserts the CSS
# actually applied (color rule reaches the div) with no [css-extract]
# degenerate receipt.
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{simple_web_layout_render_html_draw_ir_result}

fn main():
    val html = "<html><head><style>.box { color: #ff0000; } #main { padding: 4px; } div.box, span.box { margin: 2px; }</style></head><body><div class=\"box\" id=\"main\">hello</div></body></html>"
    val r = simple_web_layout_render_html_draw_ir_result(html, 64, 32)
    print "CSS_RULES_PROBE_OK batches={r.composition.batches.len()}"
