class Box<T>:
    data: [T]
    shape: [i64]

    fn numel() -> i64:
        return self.data.len()

    static fn zeros(shape: [i64]) -> Box<f64>:
        var d: [f64] = []
        return Box(data: d, shape: shape)

    static fn from_data(data: [T], shape: [i64]) -> Box<T>:
        return Box(data: data, shape: shape)

fn main():
    val a = Box.zeros([2, 3])
    print("zeros numel=" + a.numel().to_text())
    val b = Box.from_data([1.0, 2.0, 3.0], [3])
    print("from_data numel=" + b.numel().to_text())
