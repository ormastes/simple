# Minimal repro for fix A1 (nested-array element identity) of
# doc/08_tracking/bug/cranelift_native_aggregate_return_nil_receiver_hosted_wm_2026-07-26.md
#
# Mechanism under test: for an array whose ELEMENT is itself an array
# (`[[text]]`), the outer slot holds a runtime array HANDLE. The MIR Index
# lowering (src/compiler/50.mir/_MirLoweringExpr/expr_dispatch.spl, `case
# Index`) used to register runtime-array/runtime-value identity for the
# decoded element only when the element was a NAMED struct, so an array
# element went down the scalar decode (`>>3`, which shreds the handle) and
# the decoded local never entered `runtime_array_locals`. `nested[i].len()`
# and `nested[i][j]` then lowered off a non-array local.
#
# Two shapes, because they reach the Index lowering with different amounts of
# type information:
#   Shape 1 -- `fn f() -> [[text]]` + caller indexes/.len()s. The call result
#     carries a HIR type, so `result_type` derives to an Array and the
#     pre-existing decode path already handles it. Kept as the control: it
#     must not regress.
#   Shape 2 -- the same value read back through a `[[text]]` CLASS FIELD.
#     Here the only surviving signal is the "__runtime_array__" sentinel in
#     `struct_field_array_element_type_name`, which
#     `remember_field_projection_provenance` used to drop. This is the shape
#     A1 fixes.
#
# Build shape for the native lane (paths relative to the repo root):
#   SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_LIB=<repo>/src <stage3-or-self-hosted> \
#     native-build --source probes/nested_array_element_identity_min.spl \
#     --entry probes/nested_array_element_identity_min.spl --entry-closure \
#     --strip --backend cranelift --cache-dir <fresh-dir> --mode dynload \
#     --output <bin>
# NOTE: the compiler binary must be REBUILT from the fixed source for this to
# mean anything -- a stage3 built before the fix compiles with its own baked
# in lowering.
#
# Expected on a fixed compiler: prints NESTED_ARRAY_MIN_PASS.
#
# BASELINE MEASURED 2026-07-26, before the A1 fix, with
# build/bootstrap/stage3/x86_64-unknown-linux-gnu/simple:
#   - seed interpreter (`run`)                    -> NESTED_ARRAY_MIN_PASS
#   - cranelift/dynload native, hosted lane       -> NESTED_ARRAY_MIN_PASS
#   - cranelift/dynload native, SIMPLE_BOOTSTRAP=1-> NESTED_ARRAY_MIN_PASS
# So at THIS scale the defect does not reproduce -- same layout sensitivity
# the sibling probe (cranelift_aggregate_return_min.spl) documents for the
# aggregate half. Treat this file as a REGRESSION GUARD for the A1 fix, not
# as a reproducer; reproducing A1 still needs the freestanding guest lane
# (SIMPLE_BOOTSTRAP=1 + SIMPLE_ALLOW_FREESTANDING_STUBS=1,
# --target x86_64-unknown-none) or hosted-WM scale.

class EventLog:
    name: text
    events: [[text]]

fn collect_events() -> [[text]]:
    var out: [[text]] = []
    out.push(["a", "b"])
    out.push(["c"])
    out

fn main() -> i64:
    var failures = 0

    # Shape 1 (control): direct call result, indexed and .len()'d.
    val direct = collect_events()
    if direct.len() != 2:
        print "NESTED_ARRAY_MIN_FAIL probe=outer-len got={direct.len()}"
        failures = failures + 1
    val first = direct[0]
    if first.len() != 2:
        print "NESTED_ARRAY_MIN_FAIL probe=direct-elem-len got={first.len()}"
        failures = failures + 1
    if first[1] != "b":
        print "NESTED_ARRAY_MIN_FAIL probe=direct-elem-value got={first[1]}"
        failures = failures + 1

    # Shape 2 (the A1 shape): the same nested array read back through a
    # `[[text]]` class field, so the element-is-an-array fact only survives
    # as the "__runtime_array__" sentinel.
    val log = EventLog(name: "log", events: collect_events())
    if log.events.len() != 2:
        print "NESTED_ARRAY_MIN_FAIL probe=field-outer-len got={log.events.len()}"
        failures = failures + 1
    val via_field = log.events[0]
    if via_field.len() != 2:
        print "NESTED_ARRAY_MIN_FAIL probe=field-elem-len got={via_field.len()}"
        failures = failures + 1
    if via_field[0] != "a":
        print "NESTED_ARRAY_MIN_FAIL probe=field-elem-value got={via_field[0]}"
        failures = failures + 1

    if failures == 0:
        print "NESTED_ARRAY_MIN_PASS"
        return 0
    print "NESTED_ARRAY_MIN_FAIL total={failures}"
    1
