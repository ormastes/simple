# Minimal repro candidate: a chained method call on an ERASED builtin result
# (`text.char_code_at(i)` -> i64) mis-dispatches into a same-named STRUCT
# method (`Px.to_i32`, whose body is `self.value`) when such a struct is in
# the same compilation unit. The i64 is then treated as a struct pointer and
# the field read faults / null-masks.
#
# Referenced by doc/08_tracking/bug/
# cranelift_native_aggregate_return_nil_receiver_hosted_wm_2026-07-26.md
# (hosted-WM first-frame stack: Px.to_i32 <- _engine2d_draw_ir_nth_int).
#
# Build shape for the native lane:
#   native-build --source <this> --entry <this> --entry-closure --strip \
#     --backend cranelift --mode dynload
# Expected on a good compiler: CHAIN_MIN_PASS on every line.

struct Px:
    value: i32

    fn to_i32() -> i32:
        self.value

fn main():
    val s: text = "A5"

    # A: chained conversion on the erased char_code_at result.
    val chained = s.char_code_at(0).to_i32()
    print("A chained=" + chained.to_text())
    if chained == 65:
        print("A CHAIN_MIN_PASS")
    else:
        print("A CHAIN_MIN_FAIL")

    # B: control — typed intermediate binding, same conversion.
    val code: i64 = s.char_code_at(0)
    val bound = code.to_i32()
    print("B bound=" + bound.to_text())
    if bound == 65:
        print("B CHAIN_MIN_PASS")
    else:
        print("B CHAIN_MIN_FAIL")

    # C: control — the struct method itself still works.
    val px = Px(value: 7)
    val direct = px.to_i32()
    print("C direct=" + direct.to_text())
    if direct == 7:
        print("C CHAIN_MIN_PASS")
    else:
        print("C CHAIN_MIN_FAIL")
