# Variant C: identical to *_a_with_px.spl except Px.to_i32 returns a constant
# instead of reading self. If the printed value is 77 the call really is
# DISPATCHED into Px.to_i32 (a resolution defect), not memory corruption.
struct Px:
    value: i32

    fn to_i32() -> i32:
        77

fn main():
    val s: text = "A5"
    val chained = s.char_code_at(0).to_i32()
    print("C chained=" + chained.to_text())
