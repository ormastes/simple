use os.compositor.simple_web_window_renderer.{simple_web_content_frame_cached}
use common.ui.window_scene.{wm_content_frame_web_provenance_valid}
use std.gc_async_mut.ui.web_render_pixel_backend.{web_render_pixel_artifact_cache}

# Host-side attribution probe for the SimpleOS-WM lane regression seen in
# rerun56: every window frame came back content-provenance-rejected with
# fallback=none material=(empty), so the material-provenance gate added with
# the glass-theme landing is rejecting frames the software backend produces.
# Reproducing on the host costs seconds instead of a ~7 minute kernel build,
# and prints every field the gate reads so the failing clause is named rather
# than guessed at.
fn main():
    val cache = web_render_pixel_artifact_cache(320, 200, "software")
    val frame = simple_web_content_frame_cached(cache, "probe-window", 1, 1, "aetheric_dark", "Probe", "<div>content</div>", 320, 200, 0)
    print("[prov] engine2d_status={frame.engine2d_status}")
    print("[prov] engine2d_backend={frame.engine2d_backend}")
    print("[prov] engine2d_reason={frame.engine2d_reason}")
    print("[prov] material_kind={frame.material_fallback_kind}")
    print("[prov] material_reason={frame.material_fallback_reason}")
    print("[prov] material_sha_len={frame.material_fallback_sha256.len()}")
    print("[prov] theme_id={frame.theme_id}")
    print("[prov] theme_sha_len={frame.theme_source_manifest_sha256.len()}")
    print("[prov] pixels={frame.pixels.len()} valid={wm_content_frame_web_provenance_valid(frame)}")
    print("WM_MATERIAL_PROVENANCE_PROBE_DONE")
