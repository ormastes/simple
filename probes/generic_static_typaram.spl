class Box<T>:
    val items: [T]

    static fn empty() -> Box<f64>:
        return Box(items: [])

    static fn from_data(data: [T]) -> Box<T>:
        return Box(items: data)

fn main():
    val a = Box.empty()
    print("empty len=" + a.items.len().to_text())
    val b = Box.from_data([1.0, 2.0, 3.0])
    print("from_data len=" + b.items.len().to_text())
