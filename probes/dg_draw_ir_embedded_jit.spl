# Probe: trigger JIT compilation of _engine2d_draw_ir_render_batch_embedded.
# Under the deployed Rust seed, `?? return` in that function makes the JIT
# opt out with "Unknown variable: return" and interpret the per-frame hot path.
# doc/08_tracking/bug/seed_parser_no_return_expression_kills_jit_2026-07-26.md
use common.ui.draw_ir.{DRAW_IR_BACKEND_CPU, draw_ir_batch, draw_ir_embedding_config, draw_ir_rect}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{engine2d_draw_ir_adv_batch}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}

fn main():
    var engine = Engine2D.create_with_backend(32, 24, "cpu")
    val batch = draw_ir_batch("probe-embed", DRAW_IR_BACKEND_CPU,
        draw_ir_embedding_config("surf", "win", 2, 2, 16, 12, 1, 500, false), [
        draw_ir_rect("r", 0, 0, 8, 8, 0xff3366ffu32)])
    val result = engine2d_draw_ir_adv_batch(engine, batch, false)
    print "DRAW_IR_EMBED_JIT_OK rendered={result.rendered_command_count}"
