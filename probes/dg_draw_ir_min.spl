# Minimal repro: the DrawIR render path crashes with `trim on nil` on any
# document containing an element. The software path handles the same document.
# doc/08_tracking/bug/web_draw_ir_path_trim_on_nil_any_element_2026-07-26.md
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{simple_web_layout_render_html_draw_ir_result}

fn main():
    val r = simple_web_layout_render_html_draw_ir_result("<div>x</div>", 24, 16)
    print "DRAW_IR_MIN_OK batches={r.composition.batches.len()}"
