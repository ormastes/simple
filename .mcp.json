{
  "_comment": "Portable project MCP configuration for Claude Code, Kimi Code, and compatible clients",

  "mcpServers": {
    "simple-pipe-mcp": {
      "_info": "Compiled Simple MCP server exposed under the SPipe-linked name.",
      "command": "/bin/sh",
      "args": ["-lc", "exec \"$PWD/bin/simple_mcp_server\""],
      "cwd": ".",
      "env": {
        "SIMPLE_LOG": "error",
        "RUST_LOG": "error",
        "SIMPLE_LIB": "src"
      }
    },
    "simple-mcp": {
      "_info": "Compiled Simple MCP server.",
      "command": "/bin/sh",
      "args": ["-lc", "exec \"$PWD/bin/simple_mcp_server\""],
      "cwd": ".",
      "env": {
        "SIMPLE_LOG": "error",
        "RUST_LOG": "error",
        "SIMPLE_LIB": "src"
      }
    },
    "simple-lsp-mcp": {
      "_info": "Source-mode Simple LSP MCP through the stdio bridge; the cached native server currently fails tools/call argument extraction.",
      "command": "/bin/sh",
      "args": ["-lc", "exec node \"$PWD/bin/mcp_stdio_bridge.js\" -- \"$PWD/bin/simple\" run \"$PWD/src/app/simple_lsp_mcp/main.spl\""],
      "cwd": ".",
      "env": {
        "SIMPLE_EXECUTION_MODE": "interpreter",
        "SIMPLE_LOG": "error",
        "RUST_LOG": "error",
        "SIMPLE_LIB": "src"
      }
    },
    "stitch": {
      "_info": "Google Stitch MCP proxy launched through the repo wrapper.",
      "command": "/bin/sh",
      "args": ["-lc", "exec node \"$PWD/bin/mcp_stdio_bridge.js\" -- node \"$PWD/bin/codex_stitch_mcp.js\""],
      "cwd": "."
    }
  }
}
