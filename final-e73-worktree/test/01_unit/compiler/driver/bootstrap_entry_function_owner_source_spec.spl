"""Focused source contracts for Stage3 bootstrap entry function ownership."""

use std.spec.*

extern fn rt_file_read_text(path: text) -> text?

describe "Stage3 bootstrap entry function ownership":
    it "reparses authoritative entry content before HIR lowering":
        val source = rt_file_read_text(
            "src/compiler/80.driver/driver_hir_pipeline_lowering.spl") ?? ""

        expect(source).to_contain("bootstrap_hir_set_current_module_is_entry(is_requested_bootstrap_entry)")
        expect(source).to_contain("if src.content != \"\":")
        expect(source).to_contain("val reparsed_entry_module = parse_full_frontend(src.content, src.path, name, self.ctx.logger)")
        expect(source).to_contain("lowering.lower_parser_module_unstub(reparsed_entry_module, is_bootstrap_entry)")

    it "keeps the typed function owner through the flat registry":
        val helpers = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/lowering_helpers.spl") ?? ""
        val lowering = rt_file_read_text(
            "src/compiler/20.hir/hir_lowering/_Items/module_lowering.spl") ?? ""

        expect(helpers).to_contain("fn bootstrap_hir_modules_add_current_functions(")
        expect(helpers).to_contain("_bootstrap_hir_module_functions = _bootstrap_hir_module_functions.push(_bootstrap_hir_functions)")
        expect(lowering).to_contain("bootstrap_hir_modules_add_current_functions(registry_module_name, is_entry")
        expect(lowering).to_contain("bootstrap_use_flat_entry_functions")
        expect(lowering).to_contain("flat_bootstrap_function_at(lower_idx)")
