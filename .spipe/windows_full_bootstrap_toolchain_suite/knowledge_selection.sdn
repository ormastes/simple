knowledge_selection:
  version: 1
  feature_id: windows_full_bootstrap_toolchain_suite
  registry: doc/00_llm_process/knowledge_registry.sdn
  selection_rule: exact-feature-then-longest-source-prefix
  feature_route_status: missing
  feature_route_gap: "No exact feature route exists; create or select the feature expert during the knowledge-update phase."
  common_spipe:
    route: .spipe/spipe
    source: legacy-compatibility-fallback
    loaded:
      - .spipe/spipe/.codex/skills/sp_dev/SKILL.md
      - .spipe/spipe/README.md
  source_routes:
    - prefix: src/compiler
      group_id: compiler_pipeline
      group_path: doc/00_llm_process/layer_base/compiler_pipeline/skill.md
      architecture_profile: mdsoc
    - prefix: src/lib
      group_id: runtime_memory_io
      group_path: doc/00_llm_process/layer_base/runtime_memory_io/skill.md
      architecture_profile: mdsoc_plus
    - prefix: src/app
      group_id: app_editor_tooling
      group_path: doc/00_llm_process/layer_base/app_editor_tooling/skill.md
      architecture_profile: mdsoc_plus
  authorization:
    scope: repository-owned bootstrap, compiler, library, app/tool, test, and documentation surfaces named by the active goal
    denied: vendored runtime/compiler sources and destructive physical-device operations
