policy:
  schema: spipe-vcs/2

  protected_refs:
    - ref: main
      local_projection: integration/main
      mutator: sj.integrate
      update: fast_forward_or_merge_queue
      force: deny
      required_profile: standard
      server_enforcement_required: true

    - ref: integration/main
      mutator: sj.integrate
      update: compare_and_swap
      force: deny
      required_profile: standard
      server_enforcement_required: true

    - ref_pattern: release/*
      mutator: sj.integrate_release
      update: fast_forward
      force: deny
      required_profile: release_line
      server_enforcement_required: true

    - ref_pattern: refs/tags/v*
      mutator: sj.create_release_tag
      update: immutable_annotated_signed
      force: deny
      required_profile: release
      server_enforcement_required: true

    - ref_pattern: review/*
      mutator: sj.publish_review_ref
      update: compare_and_swap
      force: lease_only
      required_profile: review_projection
      server_enforcement_required: true

    - ref_pattern: candidate/*
      mutator: sj.stage_release_candidate
      update: compare_and_swap
      force: deny
      required_profile: release
      server_enforcement_required: true

    - ref_pattern: recovery/*
      mutator: sj.recover
      update: append_only
      force: deny
      required_profile: recovery
      server_enforcement_required: true

  authoring:
    ordinary_change:
      jj_workspace: preferred
      remote_branch: not_required
      direct_protected_ref_update: deny

  raw_mutation:
    default: deny
    break_glass:
      authority: maintainer
      reason: required
      audit: required
      expiry: required
