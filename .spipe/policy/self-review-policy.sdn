self_review_policy:
  schema: spipe-self-review-policy-projection/1
  decision_schema: spipe-self-review-decision/1
  external_db_schema: spipe-self-review-policy-db/1
  external_record_schema: spipe-self-review-policy-db/grant/1
  authority: operator_owned_external
  source: SPIPE_SELF_REVIEW_POLICY_DB
  checked_in_grants: forbidden
  default_allow: true
  missing_or_malformed_external_db: deny
  max_ttl_seconds: 86400
  deny_precedence: true
  constrain_intersection: true
  scopes:
    - code
    - text
    - file
    - directory_files
    - directory_recursive
  changed_manifest:
    schema: spipe-changed-path-manifest/1
    exact_repository_pr_head_base_merge_base_diff: required
    target_repository_ref_ruleset: exact
    strict_up_to_date: required
    protected_target: required
    provider_authenticated: required
    rename_old_and_new: required
    delete_old: required
    copy_new: required
    symlink_submodule_non_utf8_traversal_quote_whitespace_non_ascii_alias: deny
    unknown_classification: code
  fixed_restriction:
    actual_credential_or_secret_blob: deny
    authenticated_semantic_scan: required
    policy_workflow_and_source_text: reviewable
  review_receipt:
    mode: self_attested
    independently_authenticated: false
    user_authorized: true
    exact_head: required
    authenticated: required
    verdict: PASS
    p0_count: 0
    p1_count: 0
  provider:
    required_check: SPipe Self Review Admission
    integration_id: 15368
    later_push_invalidates: true
    base_retarget_or_ruleset_change_invalidates: true
    normalized_ruleset_digest: exact
    ruleset_projection_version: exact
    immediate_pull_request_target_invalidation: true
    protected_base_push_invalidation: true
    policy_ruleset_change_dispatch_invalidation: true
    decision_ttl_seconds: 600
    scheduled_invalidator_minutes: 5
    merge_consumer_revalidation: required
    candidate_admission_schema: spipe-review-admission/1
    self_review_decision_candidate_authority: forbidden
    environment: self-review-admission
    workflow_definition: trusted_default_branch_only
    generic_actions_app_trust: explicitly_user_accepted_not_independent_security
    approval_count: 0
    provider_approval_claim: forbidden
