knowledge_selection:
  feature_id: full_pure_simple_simd_bootstrap
  registry: doc/00_llm_process/knowledge_registry.sdn
  registry_version: 1
  selection_rule: exact-feature-then-longest-source-prefix
  exact_feature_route:
    status: missing
    gap: No exact feature route exists for full_pure_simple_simd_bootstrap; research must identify or create the appropriate feature expert before verification.
  feature_groups:
    - group_id: compiler_language
      group_path: doc/00_llm_process/feature_group/compiler_language/skill.md
      basis: Closest registered group for compiler SIMD and ProcessingIR work; no exact feature route exists.
  layer_routes:
    - source_prefix: src/compiler
      group_id: compiler_pipeline
      group_path: doc/00_llm_process/layer_base/compiler_pipeline/skill.md
      architecture_profile: mdsoc
    - source_prefix: src/lib/common/processing
      group_id: graphics_engine
      group_path: doc/00_llm_process/layer_base/graphics_engine/skill.md
      architecture_profile: mdsoc_plus
    - source_prefix: src/lib
      group_id: runtime_memory_io
      group_path: doc/00_llm_process/layer_base/runtime_memory_io/skill.md
      architecture_profile: mdsoc_plus
    - source_prefix: src/app
      group_id: app_editor_tooling
      group_path: doc/00_llm_process/layer_base/app_editor_tooling/skill.md
      architecture_profile: mdsoc_plus
  required_expert_updates:
    - doc/00_llm_process/feature_expert/compiler/skill.md
    - doc/00_llm_process/feature_expert/mcp_lsp/skill.md
    - doc/00_llm_process/feature_expert/release_tooling/skill.md
    - doc/00_llm_process/layer_expert/compiler/skill.md
    - doc/00_llm_process/layer_expert/lib/skill.md
    - doc/00_llm_process/layer_expert/app/skill.md
    - doc/00_llm_process/layer_expert/tooling/skill.md
    - doc/00_llm_process/layer_expert/verification/skill.md
