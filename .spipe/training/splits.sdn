# Standing held-out partition for the sspec-scoring training loop.
#
# Fixes the gap recorded in
# doc/00_llm_process/feature_expert/modern_sspec/skill.md § "Known limitation
# of the current loop": the 2026-09-05 checklist-rewrite loop retrospectively
# reconstructed 14 held-out + 7 same-case specs from commit timestamps, but
# had no STANDING partition, no leak check, and no same-case-exclusion rule.
# This file is that standing partition. `scripts/check/sspec-train.shs
# --split <name>` reads it.
#
# Derivation of WHICH specs are train vs. private_test (git log on the
# checklist repo `.spipe/spipe/` and on the outer repo's spec commits — no
# literal file list existed in prose, so this was reconstructed and
# cross-checked against every commit body's own score table):
#   - Checklist rewrite: `bf9cd7b` in `.spipe/spipe`, author date
#     2026-09-05T13:50:53+09:00 ("raise sspec worker checklist from >=80 to
#     >=90, measured").
#   - Second edit: `3db4e4e`, author date 2026-09-05T14:00:08+09:00 ("make
#     the ORA-003 trailing-comment rule impossible to miss").
#   - Outer-repo commit `1bbe705` ("raise ten spipe specs to the
#     modern-sspec 90 target", A=13:58:17) carries the score table itself:
#     "The three files at the top of the list are the direct A/B" names
#     balance_score_spec (84->90), admission_verdict_spec (78->90) and
#     graph_source_spec (70->90) as the round-1 files that motivated the
#     rewrite -> same-case (train). The other 7 files in that commit
#     (fusion_rrf, identity_dominance [flagged "(blocker)" in the commit
#     body, matching the skill.md "including a blocker file"],
#     reverse_index, search_launch_policy, spipe_alias_family_export_parity,
#     spipe_before_all_after_all, spipe_quality_lint) were scored fresh
#     against the rewritten checklist -> held-out (private_test).
#   - Commit `01215ee5` ("four more specs to 90 -- ORA-003 markers moved
#     onto the assert line") states verbatim "These four had stalled at
#     84/84/84/88" -> exactly the skill.md's stalled batch that triggered
#     the 14:00 ORA-003 edit -> same-case (train), despite being committed
#     (14:06:48) after that edit.
#   - Commit `f7a727e2` ("three blocker specs 49 -> 90") = the skill.md's
#     "blocker batch (3)" -> held-out.
#   - Commit `686a729a` ("last four specs to 90 -- spipe unit tree now
#     18/18 at target") = the skill.md's "final near-target batch (4)" ->
#     held-out.
#   Totals: 3 + 4 = 7 same-case, 7 + 3 + 4 = 14 held-out, 21 overall --
#   matches the skill.md's 14/21 + 7/21 exactly.
#
# Leak-gate design (corrected 2026-09-05, same day — a first cut of this
# gate compared each held-out spec's own git timestamp against the freeze
# time, which is backwards: fixing a held-out spec to reach target
# NECESSARILY edits it after the freeze, so that gate ERRORed on every
# genuine held-out run by construction and was removed along with the
# per-row `temporal_cutoff` field this file used to carry). The leak that
# actually matters is the CHECKLIST changing after it saw a held-out spec's
# findings, not the spec changing after the checklist froze. So
# `checklist_digest` above is checked, at run time, against a fresh sha256
# of the checklist file; any drift ERRORs the whole run before any spec is
# scored. This proves the checklist text is byte-identical to the one
# frozen here; it does NOT prove a held-out spec was unseen when THIS
# checklist was written -- that provenance claim still rests on the
# bf9cd7b/3db4e4e commit-timestamp argument above, which is unenforced by
# any mechanism and remains a "Known limitation" in the skill.md.
#
# Re-freeze 2026-09-05 (same day): the digest was first frozen against
# `3db4e4e`, which existed only in a local `.spipe/spipe` checkout — the outer
# repo's gitlink still pointed at `c2a50b9f7b0`, so a fresh clone would have
# ERRORed on digest drift and "re-runnable" would have been local-only. The
# two checklist commits were rebased onto SPipe origin/main (`ac06e63`) and
# pushed as `4f5531c`/`06d7d34`; the outer gitlink now pins `06d7d34`. Upstream
# had changed the checklist by two lines in between (an example snippet
# `it "test": expect(true).to_equal(true)` -> a real assertion) — a generic
# example fix that names none of the 21 specs, so the held-out set stays
# valid under the new digest. Old digest deaf594d... -> dd830096... .
#
# The digest and citation gates apply only to non-train splits (private_test
# here) -- train rows are deliberately, admittedly tuned-on, and gating them
# would make ordinary train scoring ERROR every time the checklist is
# legitimately edited.

schema: sspec-training-splits/v1
checklist_digest: sha256:dd830096d5b15231c7bff067e79683d40bdcfac2f99f4a8f91d1cb8b2d8a3c1f
checklist_path: .spipe/spipe/doc/00_llm_process/spipe/skill.md

sspec_training_splits |split, source_case_uid|
    train, "test/01_unit/app/spipe/balance_score_spec.spl"
    train, "test/01_unit/app/spipe/admission_verdict_spec.spl"
    train, "test/01_unit/app/spipe/graph_source_spec.spl"
    train, "test/01_unit/app/spipe/diagnostics_registry_spec.spl"
    train, "test/01_unit/app/spipe/graph_source_v2_spec.spl"
    train, "test/01_unit/app/spipe/link_extraction_spec.spl"
    train, "test/01_unit/app/spipe/search_adapter_spec.spl"
    private_test, "test/01_unit/app/spipe/fusion_rrf_spec.spl"
    private_test, "test/01_unit/app/spipe/identity_dominance_spec.spl"
    private_test, "test/01_unit/app/spipe/reverse_index_spec.spl"
    private_test, "test/01_unit/app/spipe/search_launch_policy_spec.spl"
    private_test, "test/01_unit/std/spipe_alias_family_export_parity_spec.spl"
    private_test, "test/01_unit/std/spipe_before_all_after_all_spec.spl"
    private_test, "test/02_integration/app/spipe_quality_lint_spec.spl"
    private_test, "test/01_unit/app/spipe/model_canonical_dict_spec.spl"
    private_test, "test/01_unit/app/spipe/model_edge_spec.spl"
    private_test, "test/01_unit/app/spipe/model_identity_spec.spl"
    private_test, "test/01_unit/app/spipe/refactor_journal_fault_spec.spl"
    private_test, "test/01_unit/app/spipe/refactor_rewrite_spec.spl"
    private_test, "test/01_unit/app/spipe/search/index_engine_provider_spec.spl"
    private_test, "test/01_unit/app/spipe/search_response_distrust_spec.spl"
