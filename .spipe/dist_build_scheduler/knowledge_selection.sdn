          layer_id: compiler_pipeline
          architecture_mode: mdsoc
        - path_prefix: src/app/build/targets/target_executor.spl
          layer_base: src/app
          layer_id: app_editor_tooling
          architecture_mode: mdsoc_plus
        - path_prefix: src/app/build/gate_receipt.spl
          layer_base: src/app
          layer_id: app_editor_tooling
          architecture_mode: mdsoc_plus
        - path_prefix: src/app/build/signed_build_admission.spl
          layer_base: src/app
          layer_id: app_editor_tooling
          architecture_mode: mdsoc_plus
        - path_prefix: src/app/build/submodule_inventory.spl
          layer_base: src/app
          layer_id: app_editor_tooling
          architecture_mode: mdsoc_plus
        - path_prefix: src/app/build/scheduler/
          layer_base: src/app
          layer_id: app_editor_tooling
          architecture_mode: mdsoc_plus
        - path_prefix: src/app/io/_CliCompile/native_dependency_inputs.spl
          layer_base: src/app
          layer_id: app_editor_tooling
          architecture_mode: mdsoc_plus
        - path_prefix: src/app/io/_CliCompile/compile_targets.spl
          layer_base: src/app
          layer_id: app_editor_tooling
          architecture_mode: mdsoc_plus

    related_layer_experts:
