knowledge_selection:
    feature_id: dist_build_scheduler
    selected_at: 2026-09-25
    selection_reason: "Distributed build, hook/CI admission and repository policy are developer-tooling concerns; compiler and app layers supply the implementation contracts."

    feature_route:
        group_id: developer_tooling
        group_path: doc/00_llm_process/feature_group/developer_tooling/skill.md
