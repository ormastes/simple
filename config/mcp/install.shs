#!/bin/sh
# Install platform-specific MCP configs for Claude Code and Codex CLI.
# Usage: sh config/mcp/install.shs

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

OS="$(uname -s)"

shell_quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

case "$OS" in
    MINGW*|MSYS*|CYGWIN*|Windows_NT)
        SRC="$SCRIPT_DIR/win/.mcp.json"
        EXT=".cmd"
        ;;
    *)
        SRC="$SCRIPT_DIR/common/.mcp.json"
        EXT=""
        ;;
esac

# --- Claude Code (.mcp.json) ---
if [ "$EXT" = "" ]; then
    SIMPLE_MCP_CMD="$PROJECT_ROOT/bin/simple"
    SIMPLE_MCP_ENTRY="$PROJECT_ROOT/src/app/mcp/main.spl"
    SIMPLE_LSP_MCP_CMD="$PROJECT_ROOT/bin/simple_lsp_mcp_server"
    BRIDGE_CMD="$PROJECT_ROOT/bin/mcp_stdio_bridge.js"
    # NOTE: these embed a LITERAL double quote around `$PWD` so the launched
    # shell re-quotes the runtime cwd. `\\\"` (not `\"`) is required: the
    # value is interpolated into a JSON string in the heredoc below, so the
    # quote itself must already be backslash-escaped for JSON, or the
    # written .mcp.json is invalid (an unescaped `"` mid-string terminates
    # the JSON string early — confirmed with `JSON.parse` on the prior,
    # unescaped form: `SyntaxError: Expected ',' or ']' after array element`).
    SIMPLE_MCP_LAUNCH="exec \\\"\$PWD/bin/simple_mcp_server\\\""
    SIMPLE_LSP_MCP_LAUNCH="exec \\\"\$PWD/bin/simple_lsp_mcp_server\\\""
    SIMPLE_T32_MCP_LAUNCH="exec \\\"\$PWD/bin/t32_mcp_server\\\""
    SIMPLE_T32_LSP_MCP_LAUNCH="exec \\\"\$PWD/bin/t32_lsp_mcp_server\\\""
    SPIPE_MCP_LAUNCH="exec \\\"\$PWD/.spipe/spipe/bin/spipe-mcp\\\""
    # This heredoc is what actually WRITES .mcp.json on Linux/macOS (EXT==""):
    # it must carry every server the root-checked-in .mcp.json carries — t32,
    # t32-lsp and spipe included — or running this installer overwrites the
    # root file and silently drops them. `$SRC` (config/mcp/common/.mcp.json)
    # is kept aligned as a reference copy but is NOT read on this path.
    cat > "$PROJECT_ROOT/.mcp.json" <<EOF
{
  "_comment": "MCP Servers Configuration (local absolute paths for Claude Code)",

  "mcpServers": {
    "simple-pipe-mcp": {
      "_info": "Source-hosted Simple MCP script, exposed under the SPipe-linked name.",
      "command": "/bin/sh",
      "args": ["-lc", "$SIMPLE_MCP_LAUNCH"],
      "env": {
        "SIMPLE_LOG": "error",
        "RUST_LOG": "error",
        "SIMPLE_LIB": "$PROJECT_ROOT/src"
      }
    },
    "simple-mcp": {
      "_info": "Source-hosted Simple MCP script.",
      "command": "/bin/sh",
      "args": ["-lc", "$SIMPLE_MCP_LAUNCH"],
      "env": {
        "SIMPLE_LOG": "error",
        "RUST_LOG": "error",
        "SIMPLE_LIB": "$PROJECT_ROOT/src"
      }
    },
    "simple-lsp-mcp": {
      "_info": "Simple LSP MCP server launched from this checkout",
      "command": "/bin/sh",
      "args": ["-lc", "$SIMPLE_LSP_MCP_LAUNCH"],
      "env": {
        "SIMPLE_LOG": "error",
        "RUST_LOG": "error",
        "SIMPLE_LIB": "$PROJECT_ROOT/src"
      }
    },
    "t32-mcp": {
      "_info": "TRACE32 runtime MCP tools for live session control, launched from this checkout.",
      "command": "/bin/sh",
      "args": ["-lc", "$SIMPLE_T32_MCP_LAUNCH"],
      "env": {
        "SIMPLE_LOG": "error",
        "RUST_LOG": "error",
        "SIMPLE_LIB": "$PROJECT_ROOT/src",
        "SIMPLE_EXECUTION_MODE": "interpreter"
      }
    },
    "t32-lsp-mcp": {
      "_info": "TRACE32 CMM analysis MCP tools (parse, diagnostics, completions, hover, symbols, definition, validation), launched from this checkout.",
      "command": "/bin/sh",
      "args": ["-lc", "$SIMPLE_T32_LSP_MCP_LAUNCH"],
      "env": {
        "SIMPLE_LOG": "error",
        "RUST_LOG": "error",
        "SIMPLE_LIB": "$PROJECT_ROOT/src",
        "SIMPLE_EXECUTION_MODE": "interpreter"
      }
    },
    "spipe": {
      "_info": "SPipe MCP — process/expert surfaces for the executable SSpec workflow, via the .spipe/spipe submodule's pure-Simple stage-1 server (not the retired Node/stitch server).",
      "command": "/bin/sh",
      "args": ["-lc", "$SPIPE_MCP_LAUNCH"],
      "env": {
        "SIMPLE_LOG": "error",
        "RUST_LOG": "error",
        "SIMPLE_LIB": "$PROJECT_ROOT/src",
        "SIMPLE_EXECUTION_MODE": "interpreter"
      }
    }
  }
}
EOF
else
    cp "$SRC" "$PROJECT_ROOT/.mcp.json"
fi
echo "Installed .mcp.json for $OS"

# --- Gemini CLI project settings ---
if [ "$EXT" = "" ] && [ -d "$PROJECT_ROOT/.gemini" ]; then
    cat > "$PROJECT_ROOT/.gemini/settings.json" <<EOF
{
  "context": {
    "fileName": ["GEMINI.md", "CLAUDE.md"]
  },
  "hooks": {
  },
  "mcpServers": {
    "simple-pipe-mcp": {
      "command": "/bin/sh",
      "args": ["-lc", "$SIMPLE_MCP_LAUNCH"],
      "env": {
        "SIMPLE_LOG": "error",
        "RUST_LOG": "error",
        "SIMPLE_LIB": "$PROJECT_ROOT/src"
      }
    },
    "simple-mcp": {
      "command": "/bin/sh",
      "args": ["-lc", "$SIMPLE_MCP_LAUNCH"],
      "env": {
        "SIMPLE_LOG": "error",
        "RUST_LOG": "error",
        "SIMPLE_LIB": "$PROJECT_ROOT/src"
      }
    },
    "simple-lsp-mcp": {
      "command": "/bin/sh",
      "args": ["-lc", "$SIMPLE_LSP_MCP_LAUNCH"],
      "env": {
        "SIMPLE_LOG": "error",
        "RUST_LOG": "error",
        "SIMPLE_LIB": "$PROJECT_ROOT/src"
      }
    }
  }
}
EOF
    echo "Installed Gemini MCP settings for $OS"
fi

# --- Codex CLI (global ~/.codex/config.toml) ---
if command -v codex >/dev/null 2>&1; then
    SERVERS="simple-mcp simple-lsp-mcp"
    for NAME in $SERVERS; do
        # Convert server name to wrapper name (simple-mcp -> simple_mcp_server)
        WRAPPER=$(echo "$NAME" | sed 's/-/_/g')_server
        CMD="$PROJECT_ROOT/bin/${WRAPPER}${EXT}"
        if { [ "$NAME" = "simple-mcp" ] || [ "$NAME" = "simple-pipe-mcp" ]; } && [ "$EXT" = "" ]; then
            CMD="$PROJECT_ROOT/bin/simple_mcp_server"
            LAUNCH="cd $(shell_quote "$PROJECT_ROOT") && exec $(shell_quote "$CMD")"
        elif [ "$NAME" = "simple-lsp-mcp" ] && [ "$EXT" = "" ]; then
            # Source mode — native simple_lsp_mcp_server fails all tools/call (see above).
            CMD="$SIMPLE_RUNTIME_CMD"
            LAUNCH="cd $(shell_quote "$PROJECT_ROOT") && exec node $(shell_quote "$BRIDGE_CMD") -- $(shell_quote "$CMD") run $(shell_quote "$SIMPLE_LSP_MCP_ENTRY")"
        else
            LAUNCH="cd $(shell_quote "$PROJECT_ROOT") && exec $(shell_quote "$CMD")"
        fi
        if [ -e "$CMD" ] || [ -L "$CMD" ]; then
            codex mcp remove "$NAME" 2>/dev/null || true
            codex mcp add "$NAME" --env SIMPLE_LOG=error --env RUST_LOG=error --env SIMPLE_LIB="$PROJECT_ROOT/src" -- /bin/sh -lc "$LAUNCH"
        else
            echo "Warning: $CMD not found, skipping $NAME"
        fi
    done
    # Retire old optional browser/stitch MCP registrations that are no longer
    # part of the default Codex setup.
    codex mcp remove "chrome-devtools" 2>/dev/null || true
    codex mcp remove "stitch-mcp" 2>/dev/null || true
    codex mcp remove "stitch" 2>/dev/null || true
    echo "Installed Codex MCP servers for $OS"
else
    echo "Codex CLI not found, skipping Codex MCP setup"
fi
