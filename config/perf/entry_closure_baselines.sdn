    query-help, default, 125, 1262376, 2026-09-12T05:45:08Z, ee2a35f717f71be5f50608257b34bc6745db668d6335723fdb0065f24a130367, "wave baseline 2026-09-12"
    query-help, interpreter, 107, 1140426, 2026-09-12T05:45:08Z, ee2a35f717f71be5f50608257b34bc6745db668d6335723fdb0065f24a130367, "wave baseline 2026-09-12; the interpreter lane is 18 physical files smaller than default: a default-lane number is the one an import fix must move"
    check-help, default, 132, 1302861, 2026-09-12T05:45:08Z, ee2a35f717f71be5f50608257b34bc6745db668d6335723fdb0065f24a130367, "wave baseline 2026-09-12"
    check-help, interpreter, 114, 1180911, 2026-09-12T05:45:08Z, ee2a35f717f71be5f50608257b34bc6745db668d6335723fdb0065f24a130367, "wave baseline 2026-09-12; the interpreter lane is 18 physical files smaller than default: a default-lane number is the one an import fix must move"
