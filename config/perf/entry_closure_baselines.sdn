# Frozen PHYSICAL import closure per (entry point, EXECUTION LANE). Produced by
# scripts/perf/measure-entry-closure.shs, enforced by
# scripts/check/check-entry-closure-ratchet.shs, contract in
# doc/07_guide/perf/entry_closure_receipt_v1.md.
#
# `physical_files` = distinct realpath of every .spl the entry opened;
# `source_bytes_physical` = sum of their sizes. Neither may GROW, in EITHER lane.
# The receipt's other two numbers (spl_opens, unit_spellings) are deliberately
# NOT frozen here: they move with the seed's alias/cross-lane read behaviour
# (L5-E), not with an entry's imports, so freezing them would conflate two
# different changes. Measured proof: the same ten entries came out with identical
# physical pairs on two different builds of the seed while spl_opens moved up to
# 23%.
#
# `lane` is `default` (SIMPLE_EXECUTION_MODE unset — the JIT-attempt lane, which
# whole-module-compiles) or `interpreter` (SIMPLE_EXECUTION_MODE=interpreter).
# Both are frozen because L5-C found a function-local `use` shrinks only the
# interpreter lane; a per-entry-only baseline would let a default-lane regression
# hide behind an interpreter-lane improvement. `lane` sits at position 2, not
# appended last, because `reason` is free text that may contain commas and no
# column after it can be addressed by field index.
#
# A new entry_id is added here WITH A REASON and to the measurer's entry table.
# Rows are rewritten only by `--update-baseline --reason "<text>"`, for reviewed
# landings. A FAIL naming a grown pair is real new debt; regenerating hides it.
#
# cli-version / cli-help are 0/0 on purpose: the native CLI answers them without
# reading any .spl. That is the correct measurement, and equal-to-baseline PASSes.
entry_closure_baselines |entry_id, lane, physical_files, source_bytes_physical, recorded_at_utc, binary_sha256, reason|
    cli-version, default, 0, 0, 2026-09-12T05:45:08Z, ee2a35f717f71be5f50608257b34bc6745db668d6335723fdb0065f24a130367, "wave baseline 2026-09-12; native CLI: 0 opens is the correct measurement, not a failed one"
    cli-version, interpreter, 0, 0, 2026-09-12T05:45:08Z, ee2a35f717f71be5f50608257b34bc6745db668d6335723fdb0065f24a130367, "wave baseline 2026-09-12; native CLI: 0 opens is the correct measurement, not a failed one"
    cli-help, default, 0, 0, 2026-09-12T05:45:08Z, ee2a35f717f71be5f50608257b34bc6745db668d6335723fdb0065f24a130367, "wave baseline 2026-09-12; native CLI: 0 opens is the correct measurement, not a failed one"
    cli-help, interpreter, 0, 0, 2026-09-12T05:45:08Z, ee2a35f717f71be5f50608257b34bc6745db668d6335723fdb0065f24a130367, "wave baseline 2026-09-12; native CLI: 0 opens is the correct measurement, not a failed one"
    mcp-help, default, 131, 1323864, 2026-09-12T05:45:08Z, ee2a35f717f71be5f50608257b34bc6745db668d6335723fdb0065f24a130367, "wave baseline 2026-09-12"
    mcp-help, interpreter, 131, 1323864, 2026-09-12T05:45:08Z, ee2a35f717f71be5f50608257b34bc6745db668d6335723fdb0065f24a130367, "wave baseline 2026-09-12"
    mcp-info-call, default, 131, 1323864, 2026-09-12T05:45:08Z, ee2a35f717f71be5f50608257b34bc6745db668d6335723fdb0065f24a130367, "wave baseline 2026-09-12; the tools/call currently ERRORs with E1002 project_child_storage_environment (tooling_paths.spl:67 calls it without importing child_environment.spl:49) before loading anything mcp-help does not, so this row equals mcp-help by measurement, not by assumption; re-baseline with a reason if that defect is fixed"
    mcp-info-call, interpreter, 131, 1323864, 2026-09-12T05:45:08Z, ee2a35f717f71be5f50608257b34bc6745db668d6335723fdb0065f24a130367, "wave baseline 2026-09-12; the tools/call currently ERRORs with E1002 project_child_storage_environment (tooling_paths.spl:67 calls it without importing child_environment.spl:49) before loading anything mcp-help does not, so this row equals mcp-help by measurement, not by assumption; re-baseline with a reason if that defect is fixed"
    mcp-read-call, default, 55, 468644, 2026-09-12T17:38:13Z, 3d120a6f9ab5704b2225654e4f2773cdbdc787108bd21b67aab657ffe3da72ef, "L5-H: per-family lazy dispatch; in-process simple_read closure 129->55 files (receipt scratchpad/fanout/RECEIPT_L5H.md)"
    mcp-read-call, interpreter, 55, 468644, 2026-09-12T17:38:13Z, 3d120a6f9ab5704b2225654e4f2773cdbdc787108bd21b67aab657ffe3da72ef, "L5-H: per-family lazy dispatch; in-process simple_read closure 129->55 files (receipt scratchpad/fanout/RECEIPT_L5H.md)"
    lspmcp-help, default, 38, 326336, 2026-09-12T06:59:24Z, ef528c608113173c0c1aef6edb10ac17f9bf68886f34e05aff21a39c67515562, "L5-C deferral cost, reviewed: main.spl is itself in this entry's closure, and deferring .tools requires 7 dispatch wrappers + 8 function-local use lines in it, +1,331 B. physical_files UNCHANGED at 38 -- no import was added. The default lane whole-module-compiles every top-level fn before running any, so a function-local use cannot move it (the two physical-file lists were diffed byte-for-byte and are equal); the interpreter lane, which this entry actually executes in, went 38 -> 6 files / 325,005 -> 41,252 B on the same change. Interpreter rows deliberately NOT recentred"
    lspmcp-help, interpreter, 38, 325005, 2026-09-12T05:45:08Z, ee2a35f717f71be5f50608257b34bc6745db668d6335723fdb0065f24a130367, "wave baseline 2026-09-12"
    lspmcp-3frame, default, 38, 326336, 2026-09-12T06:59:24Z, ef528c608113173c0c1aef6edb10ac17f9bf68886f34e05aff21a39c67515562, "L5-C deferral cost, reviewed: main.spl is itself in this entry's closure, and deferring .tools requires 7 dispatch wrappers + 8 function-local use lines in it, +1,331 B. physical_files UNCHANGED at 38 -- no import was added. The default lane whole-module-compiles every top-level fn before running any, so a function-local use cannot move it (the two physical-file lists were diffed byte-for-byte and are equal); the interpreter lane, which this entry actually executes in, went 38 -> 6 files / 325,005 -> 41,252 B on the same change. Interpreter rows deliberately NOT recentred"
