# Windows x86_64 MSVC P3->P3+ Bootstrap Policy
#
# Configures the x86_64-pc-windows-msvc Phase 3+ bootstrap lane aligned with
# release/support.sdn (rc channel required target) and
# doc/07_guide/infra/rc1_windows_support_policy.md.
#
# Policy:
#   - New compiler builds on the Windows MSVC lane MUST start from an
#     already-qualified Phase >= 3 compiler (`min_phase: 3`, P3 -> P3/P4).
#   - Never fall back to the Rust seed, Phase 1, or Phase 2 on this lane
#     (`allow_seed_fallback: false`).
#   - Resolve the builder compiler via:
#       sh scripts/bootstrap/resolve-bootstrap-compiler.shs \
#         --platform x86_64-pc-windows-msvc \
#         --config config/bootstrap/windows-msvc.sdn
#   - Compile/link with `--target x86_64-pc-windows-msvc`, runtime bundle
#     `core-c-bootstrap`, 64 MiB PE stack reserve (`stack_reserve: 67108864`),
#     admitted LLVM clang/clang-cl, and lld-link with MSVC CRT + Windows SDK
#     LIB/INCLUDE preserved (never MinGW/GCC).
#   - Preserve CLI role boundaries per
#     doc/08_tracking/bug/rc63_packaged_compiler_identity_and_cli_role_2026-11-24.md:
#     Phase 3 (`bootstrap_main.spl`) is `bootstrap_only` and must never be
#     aliased as `phase4_cli_sha256`.

bootstrap:
  schema: simple-bootstrap-windows-msvc/1
  platform: windows-x86_64
  target: x86_64-pc-windows-msvc
  abi: msvc
  # Compiler selection (scripts/bootstrap/resolve-bootstrap-compiler.shs;
  # env SIMPLE_BOOTSTRAP_COMPILER overrides selection mode, while min_phase
  # still enforces >= 3).
  compiler: auto
  compiler_release: latest
  # Strict minimum phase floor: new compiler builds MUST start at Phase >= 3.
  # Rejects seed fallback, Phase 1, and Phase 2 candidates (fail-closed).
  min_phase: 3
  allow_seed_fallback: false
  # Target, runtime bundle, and PE stack policy.
  target_flag: --target x86_64-pc-windows-msvc
  runtime_bundle: core-c-bootstrap
  stack_reserve: 67108864
  # CC and linker authority: admitted LLVM clang/clang-cl + lld-link with
  # MSVC CRT and Windows SDK LIB/INCLUDE; never MinGW/GCC or GNU linker flavor.
  cc_policy: clang-cl-or-clang-msvc
  linker_flavor: msvc
  linker: lld-link
  windows_abi: msvc
  # Packaged CLI role policy (RC63 boundary).
  stage3_cli_role: bootstrap_only
  stage4_cli_role: full_cli
