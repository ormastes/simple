# UI builder descriptor registry (typed UI interface, phase 2 v1).
# Maps common.ui builder functions (src/lib/common/ui/builder.spl and
# common.ui.ios.builder) to manifest node metadata. Consumed by
# src/app/ui_manifest/main.spl (text-level builder-call scan, v1).
#
# Fields per descriptor:
#   id_argument: positional index of the literal widget-id argument (v1: 0 only)
#   kind:        manifest node kind
#   actions:     comma-separated action names (empty = display-only node)
#
# Expand-only: add new builder fns here; never repurpose existing entries
# without a lock-compat review (see typed_ui_interface_arch.md §Manifest).

descriptors:
    column:
        id_argument: 0
        kind: column
        actions:
    row:
        id_argument: 0
        kind: row
        actions:
    grid_layout:
        id_argument: 0
        kind: grid
        actions:
    panel:
        id_argument: 0
        kind: panel
        actions:
    label:
        id_argument: 0
        kind: label
        actions:
    text_widget:
        id_argument: 0
        kind: text
        actions:
    text_input:
        id_argument: 0
        kind: text_input
        actions: input, submit
    text_field:
        id_argument: 0
        kind: text_input
        actions: input, submit
    textarea:
        id_argument: 0
        kind: text_input
        actions: input, submit
    button:
        id_argument: 0
        kind: button
        actions: activate
    checkbox:
        id_argument: 0
        kind: checkbox
        actions: toggle
    dropdown:
        id_argument: 0
        kind: dropdown
        actions: select
    tabs:
        id_argument: 0
        kind: tabs
        actions: select
    list_widget:
        id_argument: 0
        kind: list
        actions: select
    table_widget:
        id_argument: 0
        kind: table
        actions: select
    segmented_control:
        id_argument: 0
        kind: segmented_control
        actions: select
    tree_widget:
        id_argument: 0
        kind: tree
        actions:
    tree_node:
        id_argument: 0
        kind: tree_node
        actions: toggle, select
    tree_leaf:
        id_argument: 0
        kind: tree_leaf
        actions: select
    menubar:
        id_argument: 0
        kind: menubar
        actions:
    menu_with_submenu:
        id_argument: 0
        kind: menu
        actions: select
    statusbar:
        id_argument: 0
        kind: statusbar
        actions:
    scroll:
        id_argument: 0
        kind: scroll
        actions:
    sidebar:
        id_argument: 0
        kind: sidebar
        actions:
    inspector:
        id_argument: 0
        kind: inspector
        actions:
    dialog:
        id_argument: 0
        kind: dialog
        actions:
    progress:
        id_argument: 0
        kind: progress
        actions:
    image:
        id_argument: 0
        kind: image
        actions:
    divider:
        id_argument: 0
        kind: divider
        actions:
    navigation_bar:
        id_argument: 0
        kind: navigation_bar
        actions:
    search_bar:
        id_argument: 0
        kind: search_bar
        actions: input, submit
