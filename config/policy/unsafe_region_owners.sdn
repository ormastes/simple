# Unsafe-region owner table (E-MC-REP-001). Owner decision 2026-11-03 (option 2,
# owners by AREA). @representation_boundary annotations take owner/reviewers
# from the longest matching path prefix here; reasons/reviewers are never invented.
# review_ref: the recorded Opus review for the area (PR link) once it lands.
unsafe_region_owners |area, path_prefixes, owner, reviewers, review_ref|
    compiler, "src/compiler/", ormastes, "ormastes;opus-review", pending
    runtime, "src/runtime/;src/compiler_rust/runtime/", ormastes, "ormastes;opus-review", pending
    lib-io, "src/lib/nogc_sync_mut/io/;src/lib/nogc_sync_mut/sffi/", ormastes, "ormastes;opus-review", pending
    lib-other, "src/lib/", ormastes, "ormastes;opus-review", pending
    os, "src/os/", ormastes, "ormastes;opus-review", pending
    app, "src/app/", ormastes, "ormastes;opus-review", pending
