# Scheduled per-rule diagnostic policy (DiagnosticRulePolicy, plan section 4).
# Loaded by compiler.common.diagnostics.diagnostic_rule_policy.
# Dates/editions are illustrative and need owner ratification before publishing.
# Severity is a pure function of (edition, release/policy_as_of date, this
# file's digest) - never the wall clock.
# Keep this file ASCII-only: doc/08_tracking/bug/sdn_parser_non_ascii_and_json_keys_2026-11-12.md
diagnostic_policy:
    version: 1
    rules:
        SPL-UNIT-001:
            description: "newunit is deprecated; use unit"
            category: deprecation
            replacement: unit
            exception_policy: allowed
            created_on: "2026-11-12"
            warn_since_date: "2026-11-12"
            warn_since_lang_version: "2026.11"
            error_not_before_date: "2027-05-01"
            error_since_lang_version: "2027.2"
            modes:
                default: warn
                robust: warn
                critical: warn
                verified: warn
        SPL-TYPE-001:
            description: "public API exposes an unclassified primitive"
            category: api_hygiene
            exception_policy: reason_required
            created_on: "2026-11-12"
            warn_since_date: "2026-11-12"
            warn_since_lang_version: "2026.11"
            error_not_before_date: "2027-05-01"
            error_since_lang_version: "2027.2"
            modes:
                default: warn
                advisory: warn
                moderate: warn
                strict: deny
                robust: deny
                critical: deny
                verified: deny
        SPL-UNIT-002:
            description: "illegal or implicit unit arithmetic"
            category: security
            exception_policy: forbidden
            created_on: "2026-11-12"
            warn_since_date: "2026-11-12"
            modes:
                default: deny
                robust: deny
                critical: deny
                verified: deny
        SPL-PAT-001:
            description: "Some/None pattern matched against a non-Option subject"
            category: correctness
            exception_policy: forbidden
            created_on: "2026-11-13"
            warn_since_date: "2026-11-13"
            modes:
                default: deny
                robust: deny
                critical: deny
                verified: deny
