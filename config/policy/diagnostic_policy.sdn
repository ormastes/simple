# Scheduled per-rule diagnostic policy (DiagnosticRulePolicy, plan section 4).
# Loaded by compiler.common.diagnostics.diagnostic_rule_policy.
# Ratified (owner decision 5C, 2026-11-16): promotion is by language edition +
# profile. New rules carry error_since_lang_version and NO error_not_before_date.
# Severity is a pure function of (edition, release/policy_as_of date, this
# file's digest) - never the wall clock.
# Keep this file ASCII-only: doc/08_tracking/bug/sdn_parser_non_ascii_and_json_keys_2026-11-12.md
diagnostic_policy:
    version: 1
    rules:
        SPL-UNIT-001:
            description: "newunit is deprecated; use unit"
            category: deprecation
            replacement: unit
            exception_policy: allowed
            created_on: "2026-11-12"
            warn_since_date: "2026-11-12"
            warn_since_lang_version: "2026.11"
            error_since_lang_version: "2027.2"
            modes:
                default: warn
                robust: warn
                critical: warn
                verified: warn
        SPL-TYPE-001:
            description: "public API exposes an unclassified primitive"
            category: api_hygiene
            exception_policy: reason_required
            created_on: "2026-11-12"
            warn_since_date: "2026-11-12"
            warn_since_lang_version: "2026.11"
            error_since_lang_version: "2027.2"
            modes:
                default: warn
                advisory: warn
                moderate: warn
                strict: deny
                robust: deny
                critical: deny
                verified: deny
        SPL-UNIT-002:
            description: "illegal or implicit unit arithmetic"
            category: security
            exception_policy: forbidden
            created_on: "2026-11-12"
            warn_since_date: "2026-11-12"
            modes:
                default: deny
                robust: deny
                critical: deny
                verified: deny
        # Robust-boundary rules: doc/03_plan/release/1.0.0/robust_boundaries_library_units_sffi_backends_plan_2026-11-15.md
        # Ratified schedule (5C): warn in edition 2026.11 default, deny in robust/critical/verified
        # now, deny by default from edition 2027.2. No wall-clock dates. SFFI-* stay deny now.
        SPL-BOUND-001:
            description: "foreign raw primitive escapes its SFFI/HAL/provider adapter"
            category: api_hygiene
            exception_policy: reason_required
            created_on: "2026-11-15"
            warn_since_date: "2026-11-15"
            warn_since_lang_version: "2026.11"
            error_since_lang_version: "2027.2"
            modes:
                default: warn
                robust: deny
                critical: deny
                verified: deny
        SPL-BOUND-002:
            description: "late primitive-to-unit cast on a foreign-origin value"
            category: api_hygiene
            exception_policy: reason_required
            created_on: "2026-11-15"
            warn_since_date: "2026-11-15"
            warn_since_lang_version: "2026.11"
            error_since_lang_version: "2027.2"
            modes:
                default: warn
                robust: deny
                critical: deny
                verified: deny
        SPL-BOUND-003:
            description: "unit erased to primitive then reasserted without validated construction"
            category: api_hygiene
            exception_policy: reason_required
            created_on: "2026-11-15"
            warn_since_date: "2026-11-15"
            warn_since_lang_version: "2026.11"
            error_since_lang_version: "2027.2"
            modes:
                default: warn
                robust: deny
                critical: deny
                verified: deny
        SPL-UNIT-003:
            description: "numeric newtype auto-derives arithmetic; migrate to unit with approved operators"
            category: api_hygiene
            exception_policy: reason_required
            created_on: "2026-11-16"
            warn_since_date: "2026-11-16"
            warn_since_lang_version: "2026.11"
            error_since_lang_version: "2027.2"
            modes:
                default: warn
                robust: deny
                critical: deny
                verified: deny
        SPL-UNIT-004:
            description: "unit*unit or unit/unit without a declared derived unit (`unit Speed = Meter / Second`)"
            category: api_hygiene
            exception_policy: reason_required
            created_on: "2026-11-16"
            warn_since_date: "2026-11-16"
            warn_since_lang_version: "2026.11"
            error_since_lang_version: "2027.2"
            modes:
                default: warn
                robust: deny
                critical: deny
                verified: deny
        SPL-BUILD-SRC-001:
            description: "unowned or overlapping source file, or source-inventory manifest drift"
            category: api_hygiene
            exception_policy: reason_required
            created_on: "2026-11-18"
            warn_since_date: "2026-11-18"
            warn_since_lang_version: "2026.11"
            error_since_lang_version: "2027.2"
            modes:
                default: warn
                robust: deny
                critical: deny
                verified: deny
        SPL-PROVIDER-ABI-001:
            description: "backend provider signature, target or receipt mismatch"
            category: security
            exception_policy: forbidden
            created_on: "2026-11-18"
            warn_since_date: "2026-11-18"
            modes:
                default: deny
                robust: deny
                critical: deny
                verified: deny
        SPL-SFFI-ABI-001:
            description: "SFFI ABI class, calling convention, width or ownership mismatch"
            category: security
            exception_policy: forbidden
            created_on: "2026-11-15"
            warn_since_date: "2026-11-15"
            modes:
                default: deny
                robust: deny
                critical: deny
                verified: deny
        SPL-SFFI-RANGE-001:
            description: "constrained unit returned from SFFI without proof or validation"
            category: security
            exception_policy: forbidden
            created_on: "2026-11-15"
            warn_since_date: "2026-11-15"
            modes:
                default: deny
                robust: deny
                critical: deny
                verified: deny
        SPL-PAT-001:
            description: "Some/None pattern matched against a non-Option subject"
            category: correctness
            exception_policy: forbidden
            created_on: "2026-11-13"
            warn_since_date: "2026-11-13"
            modes:
                default: deny
                robust: deny
                critical: deny
                verified: deny
