# Build group: vulkan codegen backend provider (opt-in, never in a default build).
# Included from the root targets.sdn. Select explicitly by group name `backends_vulkan`.
# Entry is the backend source that exists today; the dedicated provider_entry.spl
# of doc/05_design/compiler/backend_dynamic_plugin_build_groups.md §2.2 is not written yet.

group backends_vulkan:
    default: false
    members: //backend:vulkan

target //backend:vulkan:
    kind: shared
    entry: src/plugins/backend_vulkan/vulkan_backend.spl
    output: build/backends/host/backend_vulkan-v1.so
