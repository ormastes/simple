# Build group: vhdl codegen backend provider (opt-in, never in a default build).
# Included from the root targets.sdn. Select explicitly by group name `backends_vhdl`.
# Entry is the backend source that exists today; the dedicated provider_entry.spl
# of doc/05_design/compiler/backend_dynamic_plugin_build_groups.md §2.2 is not written yet.

group backends_vhdl:
    default: false
    members: //backend:vhdl

target //backend:vhdl:
    kind: shared
    entry: src/plugins/backend_vhdl/vhdl_backend.spl
    output: build/backends/host/backend_vhdl-v1.so
