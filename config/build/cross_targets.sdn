# Build group: cross-target artifacts (opt-in, never in a default build).
# Included from the root targets.sdn. Select explicitly by group name `cross_targets`.
# Targets may now declare `triple: <arch-vendor-os[-env]>` (never default-selected),
# but this group still lists NO targets: the target executor (target_executor.spl)
# does not pass the triple to native-build, so a cross target would silently build
# for the host. Add members once the executor forwards the triple to codegen.

group cross_targets:
    default: false
    members:
