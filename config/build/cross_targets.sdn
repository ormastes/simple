# Build group: cross-target artifacts (opt-in, never in a default build).
# Included from the root targets.sdn. Select explicitly by group name `cross_targets`.
# A target's `triple: <arch-vendor-os[-env]>` is forwarded by the target executor
# (target_executor.spl) as native-build `--target <triple>`; a triple target is
# never default-selected.

group cross_targets:
    default: false
    members: //cross:configc_aarch64_linux

target //cross:configc_aarch64_linux:
    kind: binary
    entry: src/app/configc/main.spl
    triple: aarch64-unknown-linux-gnu
    output: build/targets/cross/aarch64-unknown-linux-gnu/configc
