# Backend contracts as data (plan §6, owner decisions 2026-11-18).
# Verified by `backend_contracts_check` (src/app/build/targets/backend_contracts.spl)
# and pinned by test/01_unit/app/build/backend_contracts_spec.spl. Opt-in only:
# nothing here changes a default build.

schema: backend_contracts_v1

rocm:
  backend_of_record: hip
  group: backends_rocm
  target: "//backend:hip"

cuda_ptx:
  isa_version: "8.0"
  default_sm: sm_86
  source: src/plugins/backend_cuda/cuda/ptx_builder.spl

vector_length:
  mode: vl_agnostic
  query: runtime
  aarch64_tier: armv9-a+sve
  riscv64_tier: rv64gcv
