# Build group: c codegen backend provider (opt-in, never in a default build).
# Included from the root targets.sdn. Select explicitly by group name `backends_c`.
# Entry is the backend source that exists today; the dedicated provider_entry.spl
# of doc/05_design/compiler/backend_dynamic_plugin_build_groups.md §2.2 is not written yet.

group backends_c:
    default: false
    members: //backend:c

target //backend:c:
    kind: shared
    entry: src/plugins/backend_c/c_backend.spl
    output: build/backends/host/backend_c-v1.so
