# Build group: per-CPU-tier artifacts (opt-in, never in a default build).
# Included from the root targets.sdn. Select explicitly by group name `cpu_tier_artifacts`.
# Targets may now declare `cpu_tier: <tier>` (validated against cpu_tiers.sdn), but
# this group still lists NO targets: the target executor (target_executor.spl) does
# not pass cpu_tier to native-build, so a tiered target would silently build at the
# host baseline. Add members once the executor forwards the tier to codegen.
# Tier selection logic lives in src/lib/common/cpu_tier/.

group cpu_tier_artifacts:
    default: false
    members:
