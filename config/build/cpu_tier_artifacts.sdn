# Build group: per-CPU-tier artifacts (opt-in, never in a default build).
# Included from the root targets.sdn. Select explicitly by group name `cpu_tier_artifacts`.
# Lists NO targets on purpose: the target schema (build_targets.spl) has no tier
# field, so a per-tier artifact (x86-64-v3, armv9-a+sve, rv64gcv; see cpu_tiers.sdn)
# cannot be declared yet. Tier selection logic lives in src/lib/common/cpu_tier/.

group cpu_tier_artifacts:
    default: false
    members:
