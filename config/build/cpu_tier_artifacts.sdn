# Build group: per-CPU-tier artifacts (opt-in, never in a default build).
# Included from the root targets.sdn. Select explicitly by group name `cpu_tier_artifacts`.
# A target's `cpu_tier:` must belong to its triple's arch (else the host arch) in
# cpu_tiers.sdn. The target executor forwards x86-64[-v1..v4] as native-build
# `--cpu`; any other tier is refused (`target-error: unsupported-cpu_tier:`) rather
# than built at baseline. A tiered target is never default-selected.
# Tier selection logic lives in src/lib/common/cpu_tier/.

group cpu_tier_artifacts:
    default: false
    members: //tier:configc_x86_64_v3

target //tier:configc_x86_64_v3:
    kind: binary
    entry: src/app/configc/main.spl
    cpu_tier: x86-64-v3
    triple: x86_64-unknown-linux-gnu
    output: build/targets/tier/x86-64-v3/configc
