# CPU Tier Configuration
# Defines architecture-specific tier levels, feature sets, aliases, and tier classes
# for multi-target SIMD builds. Each tier maps to LLVM -target-cpu and -target-feature.
#
# Canonicalization and tier selection are implemented in src/lib/common/cpu_tier/tier_id.spl.
# The config provides static mappings; the library computes deltas, deduplication, and admission.

cpu_tiers:
  - arch: x86_64
    levels: [x86-64, x86-64-v2, x86-64-v3, x86-64-v4]
    aliases: {x86-64-v1: x86-64}
    implied_features:
      x86-64: []
      x86-64-v2: [cx16, popcnt, sahf, sse3, sse4.1, sse4.2, ssse3]
      x86-64-v3: [avx, avx2, bmi, bmi2, f16c, fma, movbe, xsave]
      x86-64-v4: [avx512bw, avx512cd, avx512dq, avx512f, avx512vl]
    default_tiers: [x86-64, x86-64-v2, x86-64-v3, x86-64-v4]
    feature_tiers: []

  - arch: aarch64
    levels: [armv8-a, armv8.2-a, armv9-a]
    aliases: {}
    implied_features:
      armv8-a: []
      armv8.2-a: [fp-armv8, neon]
      armv9-a: [fp-armv8, neon]
    default_tiers: [armv8-a, armv8.2-a, armv9-a+sve]
    feature_tiers: []

  - arch: riscv64
    levels: [rv64gc, rv64gcv]
    aliases: {}
    implied_features:
      rv64gc: []
      rv64gcv: [v]
    default_tiers: [rv64gc, rv64gcv]
    feature_tiers: []
