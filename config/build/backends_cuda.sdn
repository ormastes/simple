# Build group: cuda codegen backend provider (opt-in, never in a default build).
# Included from the root targets.sdn. Select explicitly by group name `backends_cuda`.
# Entry is the backend source that exists today; the dedicated provider_entry.spl
# of doc/05_design/compiler/backend_dynamic_plugin_build_groups.md §2.2 is not written yet.

group backends_cuda:
    default: false
    members: //backend:cuda

target //backend:cuda:
    kind: shared
    entry: src/plugins/backend_cuda/cuda_backend.spl
    output: build/backends/host/backend_cuda-v1.so
