# Build group: GPU runtime library (opt-in, never in a default build).
# Included from the root targets.sdn. Select explicitly by group name `runtime_gpu`.
# Plan §6: this is the runtime device lifecycle (detect/select/launch on a GPU at
# run time). It is deliberately separate from the codegen provider ABI
# (backends_*.sdn + admit_backend_provider): no provider descriptor gates it.
# It shares the admission receipt identity, though: SIMPLE_<BACKEND>_PROVIDER_RECEIPT
# names a provider_admission_receipt_v1 and runtime_dynload.c authenticates the
# loaded provider bytes against its artifact_sha256 (simple_gpu_provider_receipt_v1.h).
# Entry is the GPU device facade that exists today.

group runtime_gpu:
    default: false
    members: //runtime_gpu:device

target //runtime_gpu:device:
    kind: library
    entry: src/lib/gc_async_mut/gpu/device.spl
    output: build/runtime_gpu/host/runtime_gpu_device
