# Build group: stdlib_static archive
# Declares the stdlib static archive target and default settings.
# This sub-config is included by config/build/targets.sdn via
# `include:` directive (work/targets-include-group PR, when it lands).

group stdlib_static:
    default: false
    description: "Prebuilt stdlib static archive target"

    include: targets/stdlib_std.sdn

# Target declaration: stdlib static archive
# This will be read by scripts/build/build-stdlib-static.shs
# and src/app/cli/native_build_output_plan.spl

target //std:libsimple_std:
    type: archive
    outputs: libsimple_std-{semver}-{triple}-{cpu_tier}.a
    sidecar: libsimple_std-{semver}-{triple}-{cpu_tier}.a.lib.sdn
    units: std.**                          # All stdlib modules
    linker: llvm-ar
    format: archive

    # Archive is keyed by content, not commit. Two key axes:
    # 1. interface_digest_of(std units) — cache per interface hash
    # 2. (producer, target-triple, cpu-tier) — cache scope
    cache_key:
        axes:
            - iface_digest
            - producer
            - triple
            - cpu_tier

        scope_dir: ~/.simple/stdlib-archives
        scope_env: SIMPLE_STDLIB_ARCHIVE_DIR

    # Sidecar: archive metadata and validation
    sidecar_fields:
        - name: text              # "libsimple_std"
        - semver: text            # "1.0.0"
        - abi_major: i32          # Major ABI version
        - abi_minor: i32          # Minor ABI version (forward-compatible within major)
        - iface_digest: text      # sha256(sorted interface hashes of all units)
        - producer: text          # Compiler version + build date
        - triple: text            # Target triple (e.g., x86_64-unknown-linux-gnu)
        - cpu_tier: text          # CPU tier (O0, O1, O2, O3)
        - sha256: text            # Archive file sha256 for integrity check
