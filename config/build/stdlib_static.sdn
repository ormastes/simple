# Build group: prebuilt stdlib static archive (opt-in, never in a default build).
# Included from the root targets.sdn. Built by scripts/build/build-stdlib-static.shs,
# which wraps `native-build --emit-archive` (llvm-ar) and writes the
# <archive>.lib.sdn sidecar. Output name on every host:
#     libsimple_std-<semver>-<triple>-<tier>.a
# cached under build/std_archive/<triple>/<tier>/ (SIMPLE_STDLIB_ARCHIVE_DIR overrides).
# Plan: doc/05_design/compiler/backend_dynamic_plugin_build_groups.md §2.5.

group stdlib_static:
    default: false
    members: //std:libsimple_std

target //std:libsimple_std:
    kind: library
    entry: src/lib/std_archive_root.spl
    # Executor output until it grows triple/tier axes; the script writes the
    # real per-target archive (see header). Single producer is a follow-up.
    output: build/std_archive/libsimple_std.a
