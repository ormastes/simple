# Library and dynamic-library versioning configuration.
# Source of truth for naming patterns, ABI support window, and install location.
# Design: doc/05_design/compiler/lib_dylib_versioning.md

# Naming patterns for versioned artifacts.
stdlib_naming: "libsimple_std-{semver}-{triple}-{tier}.a"
backend_naming: "backend_{name}-{triple}-v{abi}.{ext}"
tier_dylib_naming: "lib{name}-{semver}-{triple}-{tier}.{ext}"

# Sidecar file suffix. Identity fields are serialized as SDN.
sidecar_suffix: ".lib.sdn"

# ABI support window: accept current major, plus N-1 while deprecated.
abi_window: 1

# Deprecated ABI major versions. Empty while no deprecation is active.
deprecated_abi: []

# Install root for versioned libraries and sidecars.
install_root: "lib/simple/{triple}"
