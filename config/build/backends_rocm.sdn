# Build group: rocm codegen backend provider (opt-in, never in a default build).
# Included from the root targets.sdn. Select explicitly by group name `backends_rocm`.
# Entry is the backend source that exists today; the dedicated provider_entry.spl
# of doc/05_design/compiler/backend_dynamic_plugin_build_groups.md §2.2 is not written yet.

group backends_rocm:
    default: false
    members: //backend:hip

target //backend:hip:
    kind: shared
    entry: src/plugins/backend_hip/hip_backend.spl
    output: build/backends/host/backend_hip-v1.so
