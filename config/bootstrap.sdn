# Simple Compiler Bootstrap Metadata
#
# Updated by `make bootstrap-promote` after successful verification.
# Records the last verified bootstrap for reproducibility.

bootstrap:
  version: 1.0.0-rc.1
  # Default build parallelism (bootstrap-jobs.shs: CLI --jobs > SIMPLE_NATIVE_BUILD_THREADS > this).
  jobs: 16
  # Compiler that builds the next phase (scripts/bootstrap/resolve-bootstrap-compiler.shs;
  # env SIMPLE_BOOTSTRAP_COMPILER overrides):
  #   auto    - newest local phase build of this lane (stage4 > stage3 > stage2 > stage1),
  #             else the newest release/RC binary for this platform, else the Rust seed
  #   local | release | seed | <path to a simple binary>
  # A candidate is used only after it native-builds and runs a hello world.
  compiler: auto
  # Release to take `release`/`auto` binaries from: latest (newest rc-*/v* carrying
  # this platform's package) or an explicit tag such as rc-1.0.0-rc.1.
  compiler_release: latest
  # Stage 3 lowering route (bootstrap-jobs.shs bootstrap_select_stage3_file_workers;
  # non-empty env SIMPLE_FILE_WORKERS > this > compiler default). 0 = two-pass
  # phase route; 1 = per-file src -> obj pool; delete the key for the compiler
  # default (per-file). Pinned to 0 because the per-file route still fails on the
  # first importing unit, bug #8504 layers 2-3 (layer 1 fixed by PR #8746):
  # doc/08_tracking/bug/per_file_lane_unit_mir_physical_ownership_missing_hir_2026-11-12.md
  # Read by resume-stage3-from-admitted.sh and the bootstrap-from-scratch.sh Stage 3.
  stage3_file_workers: 0
  stage2_hash: 718fe35b4d36937744d7481b96cacd74e1905a54f1bcdf6ebd1f4d2da1d169a3
  stage3_hash: 718fe35b4d36937744d7481b96cacd74e1905a54f1bcdf6ebd1f4d2da1d169a3
  verified: true
  source_revision: ed6f3a577f6ba627d7ced278fb3bdbf04c3757d0
