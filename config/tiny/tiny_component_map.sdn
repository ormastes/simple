schema = "simple.tiny.component-map.v1"
abi_major = 1
abi_minor = 0

profiles = [
  { id = "tiny-min", mandatory_packs = ["tiny.base", "tiny.draw.core"] },
  { id = "tiny-browser-static-rv32", mandatory_packs = ["tiny.base", "tiny.gui.core", "tiny.web.core", "tiny.draw.core", "tiny.2d.software", "tiny.wm.kiosk", "tiny.browser"] },
]

components = [
  # stable_name_hash is an ABI identity, not a runtime text hash. Never renumber it.
  { legacy = "Panel", tiny = "Pane", class_id = 4097, stable_name_hash = 4097, feature_id = 1, status = "base", pack = "tiny.gui.core", ftxui = "Element/Container", html = "div", differences = ["bounded children"] },
  { legacy = "LayoutKind.Hbox", tiny = "Row", class_id = 4098, stable_name_hash = 4098, feature_id = 1, status = "base", pack = "tiny.gui.core", ftxui = "hbox", html = "inline-row", differences = ["no flex distribution"] },
  { legacy = "LayoutKind.Vbox", tiny = "Column", class_id = 4099, stable_name_hash = 4099, feature_id = 1, status = "base", pack = "tiny.gui.core", ftxui = "vbox", html = "block-flow", differences = ["bounded children"] },
  { legacy = "PanelOverlay", tiny = "Stack", class_id = 4100, stable_name_hash = 4100, feature_id = 1, status = "base", pack = "tiny.gui.core", ftxui = "dbox", html = "bounded-overlay", differences = ["bounded z order"] },
  { legacy = "Text", tiny = "Text", class_id = 4101, stable_name_hash = 4101, feature_id = 1, status = "base", pack = "tiny.gui.core", ftxui = "text", html = "text/span/p/h1-h6", differences = ["bitmap font profile"] },
  { legacy = "Spacer", tiny = "Spacer", class_id = 4102, stable_name_hash = 4102, feature_id = 1, status = "base", pack = "tiny.gui.core", ftxui = "filler", html = "margin-gap", differences = [] },
  { legacy = "Divider", tiny = "Divider", class_id = 4103, stable_name_hash = 4103, feature_id = 1, status = "base", pack = "tiny.gui.core", ftxui = "separator", html = "hr", differences = [] },
  { legacy = "PanelStyle.border", tiny = "Border", class_id = 4104, stable_name_hash = 4104, feature_id = 1, status = "base", pack = "tiny.gui.core", ftxui = "border", html = "border-box", differences = ["solid border only"] },
  { legacy = "Button", tiny = "Button", class_id = 4105, stable_name_hash = 4105, feature_id = 1, status = "base", pack = "tiny.gui.core", ftxui = "Button", html = "button", differences = ["no hover animation"] },
  { legacy = "Checkbox", tiny = "Checkbox", class_id = 4106, stable_name_hash = 4106, feature_id = 1, status = "base", pack = "tiny.gui.core", ftxui = "Checkbox", html = "input[type=checkbox]", differences = [] },
  { legacy = "Input", tiny = "TextInput", class_id = 4107, stable_name_hash = 4107, feature_id = 1, status = "base", pack = "tiny.gui.core", ftxui = "Input", html = "input[type=text]", differences = ["bounded byte capacity"] },
  { legacy = "List", tiny = "List", class_id = 4108, stable_name_hash = 4108, feature_id = 1, status = "base", pack = "tiny.gui.core", ftxui = "Menu", html = "ul/ol/li", differences = ["fixed item capacity"] },
  { legacy = "Scroll", tiny = "ScrollPane", class_id = 4109, stable_name_hash = 4109, feature_id = 1, status = "base", pack = "tiny.gui.core", ftxui = "frame", html = "overflow:auto", differences = ["integer offsets"] },
  { legacy = "Progress", tiny = "Progress", class_id = 4110, stable_name_hash = 4110, feature_id = 1, status = "base", pack = "tiny.gui.core", ftxui = "gauge", html = "progress", differences = [] },
]

optional_packs = [
  "tiny.tui.core", "tiny.web.forms", "tiny.web.image", "tiny.web.flex",
  "tiny.draw.drawir_compat", "tiny.webir_compat", "tiny.vulkan.client",
