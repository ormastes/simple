# Host-specific environment for DESKTOP-5A4V03J (Windows 10 / Git Bash / MinGW).
#
# Consumed by `scripts/setup/host-env.shs`, which is SOURCED and exports the
# SIMPLE_HOST_* variables built from the fields below. A host with no
# config/host/<hostname>.sdn file is not an error — the loader is a no-op and
# callers fall back to their own generic defaults. This file exists only
# because DESKTOP-5A4V03J needed real values recorded somewhere other than
# hardcoded in scripts and docs.
#
# Schema: simple-host-env-v1

host_env:
  schema: simple-host-env-v1
  hostname: DESKTOP-5A4V03J
  platform: windows-mingw

  # Ordered POSIX PATH entries this host needs before any POSIX tool works.
  # Git Bash on this host inherits the raw Windows ';'-separated PATH, which
  # POSIX tools (ls, head, cargo, ...) cannot parse.
  path_prepend:
    - /usr/bin
    - /mingw64/bin
    - /c/Users/User/scoop/apps/rustup/current/.cargo/bin
    - /c/Users/User/scoop/apps/mingw-winlibs/current/bin
    - /c/Users/User/scoop/apps/nodejs/current
    - /c/Users/User/scoop/apps/git/current/cmd
    - /c/Users/User/scoop/shims
    - /c/Windows/system32
    - /c/Windows

  # rustup's real home vs. the %USERPROFILE%\.rustup fallback that `env -i`
  # resolvers land on when RUSTUP_HOME is dropped. See
  # doc/07_guide/tooling/local_temp_phase1_mcp_deploy.md for why both matter.
  rustup_home: C:\Users\User\scoop\persist\rustup\.rustup
  rustup_fallback_home: C:\Users\User\.rustup
  rustup_host_triple: x86_64-pc-windows-gnu

  # Throwaway root for local-temp deployments (deploy-local-temp-mcp.shs and
  # friends). POSIX form since consumers are .shs scripts.
  temp_deploy_root: /c/Users/User/AppData/Local/Temp/simple-local-temp-deploy
