# Versioned HOST CONFIG defaults — schema simple-host-config-v1.
#
# DO NOT EDIT THIS FILE FOR YOUR MACHINE. It is tracked, and it documents every
# host key with an example value COMMENTED OUT, so it pins nothing. The real
# values come from, highest precedence first:
#
#   1. environment       SIMPLE_HOST_<KEY>   (e.g. SIMPLE_HOST_MAX_BUILD_JOBS=8)
#   2. user/host file    ${SIMPLE_HOST_CONFIG:-$HOME/.config/simple/host.sdn}
#                        (untracked; generated by `sh scripts/setup/setup.shs`
#                        on first setup, never overwritten afterwards)
#   3. legacy per-host   config/host/<hostname>.sdn (tracked, host_env: block)
#   4. this file         (only keys you uncomment here — please don't)
#   5. the consumer's own built-in default (listed per key below)
#
# A more specific consumer variable still beats all of the above, e.g.
# SIMPLE_BOOTSTRAP_MAX_BUILD_JOBS > max_build_jobs, SIMPLE_LLVM_WIN_ROOT_23 /
# SIMPLE_LLVM_ROOT > llvm_root, SIMPLE_LLVM_VERSION > llvm_version.
#
# Shell reader:  scripts/setup/host-env.shs  (source it; or `--get KEY`,
#                `--print`, `--init`, `--selftest` when executed)
# Simple reader: std.common.config_core.host_config
# Guide:         doc/07_guide/infra/toolchain/host_config.md
#
# Format: one `  key: value` per line under `host_config:` (two-space indent,
# scalars only; lists are comma-separated).

host_config:
  schema: simple-host-config-v1

  # --- parallelism ----------------------------------------------------------
  # Upper bound for bootstrap native-build/test workers
  # (scripts/bootstrap/bootstrap-build-jobs-policy.shs). Built-in default 16,
  # hard max 80.
  # max_build_jobs: 16

  # Logical CPUs this host may use (detected: getconf _NPROCESSORS_ONLN).
  # max_threads: 8

  # Memory budget per build worker in MiB; the bootstrap memory clamp divides
  # MemAvailable by this. Built-in default 3300.
  # worker_mem_mib: 3300

  # Process-tree RSS cap for a parallel native build (the watchdog kills the
  # tree at this many KiB): cap = max(5859375 KiB, (tree_rss_base_mib +
  # jobs * tree_rss_per_job_mib) MiB), then at most tree_rss_host_pct % of
  # host physical RAM, then at most the watchdog's own hard ceiling
  # (3 GiB + jobs * 256 MiB, never above 75 % of host RAM; not configurable).
  # Owner: scripts/bootstrap/lib/tree-rss-policy.shs. More specific
  # SIMPLE_BOOTSTRAP_TREE_RSS_{BASE_MIB,PER_JOB_MIB,HOST_PCT} win, and an
  # explicit SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB replaces the formula
  # (still refused above the hard ceiling). tree_rss_host_pct must be 1..75,
  # and an invalid value here is a bootstrap refusal, not a silent fallback to
  # the default. Built-in defaults 3072 / 96 / 50:
  # measured seed->stage2 peaks are 2.85 GiB at 19 jobs and 4.0-4.4 GiB at 40.
  # tree_rss_base_mib: 3072
  # tree_rss_per_job_mib: 96
  # tree_rss_host_pct: 50

  # --- cpu ------------------------------------------------------------------
  # x86_64 | aarch64 | riscv64
  # cpu_family: x86_64

  # Comma-separated ISA extensions this host supports. Canonical names:
  #   x86_64:  sse2,sse4.2,avx,avx2,fma,bmi2,avx512f
  #   aarch64: neon,sve,sve2
  #   riscv64: rvv
  # cpu_features: sse2,sse4.2,avx,avx2,fma,bmi2

  # --- os -------------------------------------------------------------------
  # windows | linux | macos | freebsd | simpleos
  # os: linux

  # --- toolchain ------------------------------------------------------------
  # LLVM install prefix only — it selects no compiler driver. clang-cl is used
  # solely by the Windows MSVC lane; linux/macos/freebsd/simpleos use clang/cc
  # and MinGW a target-qualified clang (llvm-toolchain-env.shs). Consumed by
  # scripts/setup/llvm-toolchain-env.shs on both Windows and Unix.
  # llvm_root: /usr/lib/llvm-23
  # Preferred LLVM major (llvm-toolchain-env.shs tries it before 23, 20).
  # llvm_version: 23

  # --- devices --------------------------------------------------------------
  # on | off — whether a usable GPU is present.
  # gpu: off

  # --- cache ----------------------------------------------------------------
  # Each cache key is only a DEFAULT for one existing consumer variable, and
  # that variable (named per key below) still wins when it is set. Applied by
  # `eval "$(sh scripts/setup/host-env.shs --cache-env)"` (or the sourced
  # function host_config_apply_cache_env). Merely sourcing host-env.shs exports
  # no cache key, and bootstrap never applies them (centralized storage sets
  # SIMPLE_CACHE and it pins its own lane caches). These choose dirs / lane name / on-off / size
  # caps only: entries stay content+producer keyed and lane-partitioned
  # (doc/05_design/compiler/incremental_build/per_lane_private_caches.md).
  #
  # Host-shared compiler cache base (consumer SIMPLE_HOST_CACHE_ROOT, read by
  # cache_root.spl when --cache-env exported it). SIMPLE_CACHE and
  # SIMPLE_USER_STORAGE_ROOT still take precedence. Built-in default
  # ${XDG_CACHE_HOME:-$HOME/.cache}/simple.
  # cache_root: /home/me/.cache/simple
  # Default cache lane name (consumer SIMPLE_CACHE_SCOPE / --cache-scope).
  # Built-in default: default.
  # cache_scope: default
  # on | off — front-end parse cache (consumer SIMPLE_FRONTEND_CACHE; off = 0).
  # frontend_cache: on
  # on | off — HIR cache (consumer SIMPLE_HIR_CACHE; off = 0).
  # hir_cache: on
  # on | off — write-time round-trip self-check of each HIR cache entry
  # (consumer SIMPLE_HIR_CACHE_SELFCHECK; unset = on in bootstrap lanes, off elsewhere).
  # hir_cache_selfcheck: off
  # Native-build object cache dir (consumer SIMPLE_NATIVE_BUILD_CACHE_DIR).
  # Unset = per-consumer default (<machine cache root>/native-build/v1 for the
  # AOT driver, build/native_cache for the linkers). Lane + producer scope
  # subdirectories are still created beneath it.
  # native_build_cache_dir: /home/me/.cache/simple/native-build/v1
  # Size cap in bytes for the bounded cache GC / cache-dir evictor (consumer
  # SIMPLE_CACHE_MAX_BYTES; built-in 10 GiB for the L2 GC, 4 GiB per evicted
  # cache dir).
  # cache_max_bytes: 10737418240
  # `simple clean` auto-mode cap in GiB (consumer SIMPLE_CACHE_MAX_GB;
  # built-in 20).
  # cache_max_gb: 20

  # --- build features -------------------------------------------------------
  # on | off — whether this build ships a feature's source surface. Specs
  # tagged `# @tag:requires-<feature>` are SKIPPED when it is off: counted in
  # the summary, reason "<feature> feature disabled for this build", never a
  # pass. Built-in default for all three: off on release/1.0, whose
  # llvm/cranelift bootstrap tree does not carry these modules. Readers:
  # std.spec.requires_feature, scripts/bootstrap/phase3-test-skip-policy.shs.
  # HWIR / RISC-V-hardware generator (compiler.mir.hwir.riscv_scalar_* ...).
  # hwir: off
  # compiler.common.assurance proof_performance_evidence / schema_migration.
  # assurance: off
  # LLVM ARM bare-metal target config (llvm_arm_baremetal_config_for).
  # arm_baremetal: off
