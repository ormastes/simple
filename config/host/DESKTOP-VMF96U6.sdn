# Host-specific environment for DESKTOP-VMF96U6 (Windows / Git Bash / MSVC).
#
# Schema: simple-host-env-v1

host_env:
  schema: simple-host-env-v1
  hostname: DESKTOP-VMF96U6
  platform: windows-msvc

  # Canonical POSIX directories verified on this host. Rustup comes first so
  # the bootstrap authority can discover the installed rustc/cargo proxies.
  path_prepend:
    - /c/Users/ormas/.cargo/bin
    - /c/dev/tool/Git/cmd
    - /c/dev/install/clang+llvm-18.1.8-x86_64-pc-windows-msvc/bin
    - /c/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64
    - /c/dev/tool/msys2/mingw64/bin
    - /c/Program Files (x86)/Windows Kits/10/bin/10.0.26100.0/x64
    - /c/dev/tool/msys2/usr/bin
    - /usr/bin/core_perl
    - /bin

  rustup_home: C:\Users\ormas\.rustup
  rustup_fallback_home: C:\Users\ormas\.rustup
  rustup_host_triple: x86_64-pc-windows-msvc
  temp_deploy_root: /c/Users/ormas/AppData/Local/Temp/simple-local-temp-deploy
