# Host-specific environment for DESKTOP-VMF96U6 (Windows / Git Bash / MSVC).
#
# Schema: simple-host-env-v1

host_env:
  schema: simple-host-env-v1
  hostname: DESKTOP-VMF96U6
  platform: windows-msvc

  # Canonical POSIX directories verified on this host. Rustup comes first so
  # the bootstrap authority can discover the installed rustc/cargo proxies.
  path_prepend:
    - /c/Users/ormas/.cargo/bin
    - /c/dev/tool/Git/cmd
    - /c/dev/install/clang+llvm-18.1.8-x86_64-pc-windows-msvc/bin
    - /c/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64
    - /c/dev/tool/msys2/mingw64/bin
    - /c/Program Files (x86)/Windows Kits/10/bin/10.0.26100.0/x64
    # Git Bash's own /usr/bin before msys2's: msys2 sh/bash scrub the
    # environment when spawned from a Git Bash parent (see
    # doc/08_tracking/bug/msys2_sh_drops_env_from_git_bash_parent_2026-10-15.md).
    # msys2 still supplies tools Git Bash lacks.
    - /usr/bin
    - /c/dev/tool/msys2/usr/bin
    - /usr/bin/core_perl
    - /bin

  # Admitted LLVM 23.1.1 lives outside the Windows default probe list
  # (Program Files/LLVM); without this bootstrap aborts at startup with
  # "admitted LLVM 23.1.1 ... not found".
  llvm_root: /c/dev/tool/clang+llvm-23.1.1-x86_64-pc-windows-msvc
  llvm_version: 23

  rustup_home: C:\Users\ormas\.rustup
  rustup_fallback_home: C:\Users\ormas\.rustup
  rustup_host_triple: x86_64-pc-windows-msvc
  temp_deploy_root: /c/Users/ormas/AppData/Local/Temp/simple-local-temp-deploy

  # Bootstrap tuning measured on the 2026-11-22 Windows MSVC release bootstrap
  # (doc/08_tracking/bug/windows_msvc_release_bootstrap_lane_gaps_2026-11-22.md).
  # Env vars still win; read by scripts/bootstrap/lib/host-bootstrap-settings.shs
  # and bootstrap-jobs.shs. Refresh: sh scripts/setup/update-host-config.shs.
  #
  # Hyper-V dynamic-memory guest: GlobalMemoryStatusEx under-reports available
  # RAM, so the 24 GiB default reserve refused every build start (#8931,
  # doc/08_tracking/bug/windows_balloon_memory_headroom_false_refusal_2026-11-13.md).
  # Exported as SIMPLE_BUILD_MEMORY_RESERVE_BYTES=2147483648.
  mem_reserve_free_mib: 2048
  # Stage 3 process-tree RSS cap (SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB);
  # 20971520 was used first, 46137344 (44 GiB) on the later run.
  stage3_tree_rss_cap_kib: 46137344
  # Stage 3 threads via the coordinator route (SIMPLE_NATIVE_BUILD_THREADS); direct fan-out needs linux/darwin memory evidence.
  stage3_threads: 4
  # The per-file worker pool refuses on the ballooned host (#8931).
  stage3_file_workers: 0
  # Stage 2 verification matrix + Stage 3 shard workers (ledger W27/W32/W36,
  # doc/08_tracking/bug/host_config_matrix_shard_knobs_unreachable_2026-11-23.md).
  # W27: MIR shard workers AV on warm .fpc read-back (root cause OPEN), so the
  # frontend parse cache is off (SIMPLE_FRONTEND_CACHE=0; schema is on|off).
  frontend_cache: off
  # W32: 4139-module MIR workers exhausted commit; more, smaller shards with a
  # 30 GiB per-worker budget (one MIR worker under the whole-build plan).
  mir_sharding: 1
  mir_shard_count: 16
  mir_shard_worker_kib: 31457280
