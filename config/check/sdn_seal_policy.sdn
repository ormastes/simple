# Sidecar seal policy: first matching glob wins; unmatched files use xxh3.
# A .csm whose algorithm differs from the policy is RESEAL_NEEDED (gates FAIL).
# Algorithms: crc32 (8 hex), xxh3 (16 hex), blake3 (64 hex). Listed paths without
# a glob must be sealed: a missing seal there fails closed.
seal_policy |glob, algo|
    doc/08_tracking/bug/bug_db.sdn, xxh3
    doc/08_tracking/test/test_db.sdn, xxh3
    var/lib/web_stack_sample/sample.sdn, xxh3
