# Sidecar seal policy: first matching glob wins; unmatched files use the default (xxh3 once it lands; crc32 until then).
# A .csm whose algorithm differs from the policy is RESEAL_NEEDED (gates FAIL).
# Algorithms: crc32 (8 hex), xxh3 (16 hex), blake3 (64 hex).
# TODO: flip these three rows to xxh3 once the xxh3 primitives land (separate PR).
seal_policy |glob, algo|
    doc/08_tracking/bug/bug_db.sdn, crc32
    doc/08_tracking/test/test_db.sdn, crc32
    var/lib/web_stack_sample/sample.sdn, crc32
