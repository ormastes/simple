# PR fast-check receipt manifest (goal item 4/5).
#
# Read by scripts/check/sign-local-ci-receipt.shs and
# scripts/check/verify-local-ci-receipt.shs through
# SIMPLE_CI_RECEIPT_MANIFEST_REL=config/check/pr_fast_gates.sdn, so a
# `pr`-tier receipt binds exactly this one row. It is a separate file only
# because config/check/must_check_gates.sdn is owned by another lane; the
# intended end state is this row folded into that manifest by its owner.
#
# The row command is what scripts/check/check-pr-fast.shs --sign-key ... runs;
# the signer is fed --results from that run, never --run, because the command
# needs the PR range.
must_check_gates |id, tier, push_blocking, mode, command, ci_job, inputs, description|
    pr-fast-changed, pr, false, range, "sh scripts/check/check-pr-fast.shs --range", pr-fast-check, -, "changed .spl files compile, their unit specs and their feature (03_system) specs run, all inside a 60s budget"
