# REQ-019 migration policy. Epoch equality is deliberate and fail-closed.
schema=mcdc-hal-migration-v1
current_epoch=1.0.0-RC
enforcement_epoch=1.0.0
base_ref=origin/main
baseline=scripts/audit/baselines/mcdc-hal-migration-v1.sdn
shim_inventory=scripts/audit/baselines/mcdc-hal-compat-shims-v1.sdn
max_files=256
max_file_bytes=1048576
max_total_bytes=16777216
max_findings=2048
root=src/lib/common/structural/mcdc
root=src/lib/common/structural/hal_provider
root=src/lib/common/structural/environment_instruction
root=src/lib/nogc_sync_mut/mcdc.spl
root=src/lib/nogc_async_mut/mcdc.spl
root=src/lib/gc_async_mut/mcdc.spl
root=src/lib/gc_sync_mut/mcdc.spl
# Production native I/O owners are explicit files: test fixtures and the large
# vendored single-header libraries under src/runtime are outside this closure.
root=src/runtime/runtime_hosted_fs.c
root=src/runtime/runtime_process.c
root=src/runtime/runtime_process_owned.c
root=src/runtime/runtime_time.c
root=src/runtime/runtime_timestamp.c
root=src/runtime/runtime_socket_nonblock.c
root=src/runtime/runtime_terminal.c
root=src/runtime/runtime_fork.c
root=src/runtime/runtime_fork.h
