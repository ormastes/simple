# doc_layout.sdn — configuration for scripts/check/check-directory-fanout.shs
#
# Backs .claude/rules/structure.md's doc layout rule:
#   doc/<phase>/<domain>/<topic>  — ≤10 files per directory, max depth 4
#
# Read by check-directory-fanout.shs (simple `key: value` line parsing, same
# style as other config/check/*.sdn files). Override the file with --config,
# or override just the scan root with --root.
#
# root: the directory the DEPTH check is rooted at. Depth 1 = this dir itself
#   (e.g. "doc"), depth 4 = doc/phase/domain/topic. The file-count (fanout)
#   check is unaffected by `root` and always scans the whole owned-code tree,
#   unless --root is passed on the command line, which scopes BOTH checks.
root: doc

# file_limit: max files per directory before a directory is "over limit"
# (fanout check). Matches structure.md's "≤10 files per directory".
file_limit: 10

# max_depth: max directory nesting depth under `root` before a directory is
# "over limit" (depth check). Matches structure.md's "max depth 4".
max_depth: 4

# exempt_phase: a top-level phase directory directly under `root` that is
# excluded from the DEPTH check entirely (repeat the key for each phase).
# These are the phases structure.md marks DO-NOT-REFACTOR / auto-generated:
# their depth grows by design and a numeric/depth gate on them is meaningless
# noise, exactly like the EXEMPT mechanism in directory_fanout_baseline.txt.
exempt_phase: 06_spec
exempt_phase: 08_tracking
exempt_phase: 09_report
exempt_phase: 10_metrics
exempt_phase: 11_archive
