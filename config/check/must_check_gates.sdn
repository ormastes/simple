# Canonical mandatory-check registry. Commands are executed only by
# scripts/check/check-bootstrap-must-pass.shs. The push hook reads the ledger;
# it never executes bootstrap-tier commands.
must_check_gates |id, tier, push_blocking, mode, command, description|
    push-c-runtime-compiles, push, true, tree, "sh scripts/check/check-c-runtime-compiles-push.shs", "owned C runtime passes clang -fsyntax-only (green on main 2026-09-01)"
    push-no-direct-rt, push, true, tree, "sh scripts/check/check-no-direct-rt.shs --roots src", "direct rt_* call sites in product Simple do not exceed the baseline"
    push-guard-wiring, push, true, tree, "sh scripts/check/check-guard-wiring.shs", "no NEW unwired guard and no stale wiring baseline or opt-out"
    push-perf-regression-tests, push, false, tree, "sh scripts/check/check-perf-regression-tests.shs", "every landed perf fix is still pinned by its mechanism (advisory: RED on main, 4 regressed)"
    push-process-wait-eintr-retry, push, false, tree, "sh scripts/check/check-process-wait-eintr-retry.shs", "process wait paths retry on EINTR (advisory: selftest RED on main)"
    push-conflict-tree, push, true, range, "sh scripts/check/check-no-conflict-tree-push.shs", "outgoing commits contain no jj conflict tree"
    push-tree-size, push, true, range, "sh scripts/check/check-tree-size-push.shs", "outgoing tree retains load-bearing repository structure"
    push-conflict-markers, push, true, range, "sh scripts/check/check-no-conflict-markers-push.shs", "outgoing commits contain no conflict markers"
    push-rules-quick, push, true, ref, "sh scripts/check/check-rules-sdl.shs --scan-only --group quick --ref", "quick committed rules registry checks without mutation fixtures"
    push-interpreter-module-owners, push, true, ref, "sh scripts/check/check-interpreter-module-owners.shs --scan-only --ref", "tracked Rust interpreter modules have exactly one declared owner without mutation fixtures"
    push-runtime-api-regression, push, true, range, "sh scripts/check/check-runtime-api-regression-push.shs --scan-only", "outgoing range deletes no mass of exported rt_* runtime API"
    push-interpreter-extern-registry-gap, push, true, tree, "sh scripts/check/check-interpreter-extern-registry-gap.shs --scan-only", "no NEW compiler-declared extern missing from the seed interpreter extern registry, and no stale baseline row"
    push-sffi-v2-authority, push, true, tree, "sh scripts/check/check-sffi-v2-authority.shs", "all 46 SFFI v2 source-authority guards pass"
    push-type-walk-constructor-parity, push, true, tree, "sh scripts/check/check-type-walk-constructor-parity.shs --scan-only", "every type constructor is projected by the type walk"
    push-windows-checkout-damage, push, true, range, "sh scripts/check/check-windows-checkout-damage-push.shs --scan-only", "outgoing range carries no Windows-checkout damage (materialized symlinks, absolute Windows symlink targets, newly-introduced CRLF)"
    push-main-test-runnable, push, true, ref, "sh scripts/check/check-main-test-runnable-push.shs --rev", "the committed tree can still run bin/simple test (startup-path .spl parses)"
    push-rt-dual-implementation, push, true, tree, "sh scripts/check/check-rt-dual-implementation-ratchet.shs", "no NEW single-lane rt_* symbol and no stale baseline row (rt_* must exist in BOTH the C and Simple lanes)"
    push-dual-run-shadow, push, false, tree, "sh scripts/check/check-dual-run-shadow.shs", "every annotated C/Simple dual-run pair agrees (advisory: needs a runnable bin/simple, which not every push host has)"
    push-runtime-source-list-parity, push, true, tree, "sh scripts/check/check-runtime-source-list-parity.shs", "every owned src/runtime *.c has its frozen source-list membership across the seed, pure-Simple and Rust-crate rosters; no dropped or stale list entry"
    compiler-stage1, bootstrap, true, receipt, "scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap --deploy", "Stage 1 seed compiler completed"
    compiler-stage2, bootstrap, true, receipt, "scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap --deploy", "Stage 2 compiler completed"
    compiler-stage3, bootstrap, true, receipt, "scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap --deploy", "Stage 3 admitted self-host compiler completed"
    compiler-stage4, bootstrap, true, receipt, "scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap --deploy", "Stage 4 full pure-Simple CLI completed"
    stage4-tooling-matrix, bootstrap, true, todo, "", "49-row CLI MCP LSP tooling matrix has no required FAIL or BLOCKED row and is bound to the admitted Stage 4 candidate"
    rules-full, bootstrap, false, automated, "sh scripts/check/check-rules-sdl.shs --group full", "full rules and scenario shrink gates"
    tree-guard-exhaustive-selftest, bootstrap, false, automated, "sh scripts/check/check-tree-size-push.shs --selftest", "exhaustive structural tree detector fixtures moved out of interactive push"
    bootstrap-essential-tools, bootstrap, false, automated, "sh scripts/check/check-bootstrap-essential-tools-smoke.shs", "fresh Stage 4 test lint duplicate-check and aggregate smoke"
    native-positional-build, bootstrap, false, automated, "sh scripts/check/check-native-inprocess-positional-nonvacuous.shs", "in-process positional native build"
    predicate-parser-native-build, bootstrap, false, automated, "sh scripts/check/check-predicate-parser-native-build.shs", "predicate parser native build"
    native-trailing-defaults, bootstrap, false, automated, "sh scripts/check/check-native-trailing-default-param.shs", "native trailing default parameters"
    class-identity-matrix, bootstrap, false, automated, "sh scripts/check/check-class-identity-engine-matrix.shs", "multi-engine class identity matrix"
    engine-differential, bootstrap, false, automated, "sh scripts/check/check-engine-differential.shs", "interpreter JIT native differential"
    sdoctest-markdown-comments, bootstrap, false, automated, "sh scripts/check/check-sdoctest-bootstrap.shs", "Markdown and comment sdoctest discovery and execution"
    use-target-resolves, bootstrap, false, automated, "sh scripts/check/check-use-target-resolves.shs", "every use module path and named member resolves statically"
    c-runtime-compiles, bootstrap, false, automated, "sh scripts/check/check-c-runtime-compiles-push.shs", "owned C runtime passes clang -fsyntax-only"
    no-direct-rt, bootstrap, false, automated, "sh scripts/check/check-no-direct-rt.shs --roots src", "direct rt_* call sites in product Simple do not exceed the baseline"
    raw-sffi-unsafe-ratchet, bootstrap, false, automated, "sh scripts/check/check-raw-sffi-unsafe-ratchet.shs", "no new untagged raw SFFI declaration identity and no stale reviewed baseline row"
    signature-type-import-provenance, bootstrap, false, automated, "sh scripts/check/check-signature-type-import-provenance.shs", "signature types are imported from their declaring module"
    perf-regression-tests, bootstrap, false, automated, "sh scripts/check/check-perf-regression-tests.shs", "every landed perf fix is still pinned by its mechanism"
    process-wait-eintr-retry, bootstrap, false, automated, "sh scripts/check/check-process-wait-eintr-retry.shs", "process wait paths retry on EINTR"
    guard-wiring, bootstrap, false, automated, "sh scripts/check/check-guard-wiring.shs", "no NEW unwired guard and no stale wiring baseline or opt-out"
    outline-parse-terminates, bootstrap, false, automated, "sh scripts/check/check-outline-parse-terminates.shs", "treesitter outline-authority parse path terminates"
    runtime-api-regression-selftest, bootstrap, false, automated, "sh scripts/check/check-runtime-api-regression-push.shs --selftest", "runtime API deletion detector mutation fixtures"
    interpreter-extern-registry-gap-selftest, bootstrap, false, automated, "sh scripts/check/check-interpreter-extern-registry-gap.shs --selftest", "seed interpreter extern registry mutation fixtures"
    type-walk-constructor-parity-selftest, bootstrap, false, automated, "sh scripts/check/check-type-walk-constructor-parity.shs --selftest", "type projection constructor mutation fixtures"
    interpreter-module-owners-selftest, bootstrap, false, automated, "sh scripts/check/check-interpreter-module-owners.shs --selftest", "interpreter module ownership mutation fixtures"
    native-array-element-type, bootstrap, false, automated, "sh scripts/check/check-native-array-element-type.shs", "typed array element interpreter/native execution matrix and comparator selftest"
    windows-hook-installation, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "Windows linked-worktree launcher evidence; resume via must_check_tiering agent-task matrix"
    caret-local-llm-launch, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "Slang-through-Caret inference; resume via must_check_tiering agent-task matrix"
    caret-provider-wrappers, bootstrap, false, automated, "sh scripts/check/check-caret-suite-bootstrap.shs --gate provider-wrappers", "Stage4-bound injected-command argv and process lifecycle fixture contracts for Claude Codex Gemini and Kimi; not installed-provider proof"
    caret-installed-provider-launches, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "real installed Claude Codex Gemini and Kimi launches through Caret; resume via must_check_tiering agent-task matrix"
    caret-messaging-primitives, bootstrap, false, automated, "sh scripts/check/check-caret-suite-bootstrap.shs --gate agent-primitives", "Stage4-bound Caret messaging HTTP and MCP primitive operations"
    caret-agent-runtime-primitives, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "real Caret agent runtime launch status cancel stop and no-leak lifecycle evidence"
    caret-batch-process-adapter, bootstrap, false, automated, "sh scripts/check/check-caret-suite-bootstrap.shs --gate multi-manager", "Stage4-bound bounded injected-command batch adapter and derived terminal-view fixture contracts; not installed-provider supervision proof"
    caret-production-multi-manager-launch, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "multiple installed Caret provider wrappers remain live under sustained parent supervision and stop cleanly"
    caret-smux-multi-launch, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "Caret smux PTY lifecycle; resume via must_check_tiering agent-task matrix"
    web-server-request-port, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "Simple web server owns a configurable listening port and completes a bounded real request response and stop cycle"
    web-server-gpu-nginx, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "identical CPU and real-device GPU responses with device-hit proof and nginx throughput latency parity on the same request fixture"
    db-server-request-port, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "Simple database server owns a configurable wire-protocol port and completes a bounded query response and stop cycle"
    db-server-gpu-sql, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "identical CPU and real-device GPU query results with device-hit proof and PostgreSQL plus MySQL parity on equivalent fixtures"
    simpleos-sbc-qemu-ls, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "paired SBC and QEMU ls; resume via must_check_tiering agent-task matrix"
    simpleos-clang-hello, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "in-guest clang hello; resume via must_check_tiering agent-task matrix"
    simpleos-simple-toolchain, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "in-guest Simple toolchain; resume via must_check_tiering agent-task matrix"
    simpleos-server-executables, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "in-guest server executables; resume via must_check_tiering agent-task matrix"
    riscv32-riscv64-shared, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "RV32 RV64 template ownership; resume via must_check_tiering agent-task matrix"
    simple-generated-vhdl-linux, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "Simple-generated VHDL Linux boot; resume via must_check_tiering agent-task matrix"
    binary-size-go-parity, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "equivalent stripped native Simple executable is no larger than Go with artifact and toolchain hashes"
    interpreter-startup-parity, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "Simple interpreter cold and warm launch is faster than equivalent Python Bun and Go programs"
    rust-go-benchmark-parity, bootstrap, false, external-receipt, "sh scripts/check/check-external-must-check-receipt.shs", "native Simple equals or exceeds Rust and Go on semantically equivalent retained benchmark fixtures"
