# Canonical mandatory-check registry. Commands are executed only by
# scripts/check/check-bootstrap-must-pass.shs. The push hook reads the ledger;
# it never executes bootstrap-tier commands.
must_check_gates |id, tier, push_blocking, mode, command, ci_job, inputs, description|
    push-ui-slim-closure, push, false, tree, "sh scripts/check/check-ui-slim-closure.shs src/app/ui.tui/async_app.spl src/os/compositor src/os/drivers src/os/kernel src/lib/skia src/lib/gc_async_mut/gpu", -, -, "ordinary TUI live-reload entry import closure excludes compositor/drivers/kernel/skia/gpu (advisory: needs the bootstrap seed for deps; seed deps is a lower bound — see doc/03_plan/ui/slim_kernel_plugin/plan.md)"
    push-ui-slim-closure-tui-entry, push, false, tree, "sh scripts/check/check-ui-slim-closure.shs src/app/ui/backend_entry_tui.spl src/os/compositor src/os/drivers src/os/kernel src/lib/skia src/lib/gc_async_mut/gpu", -, -, "the spawned `simple ui tui` backend program excludes compositor/drivers/kernel/skia/gpu (advisory: same seed dependency as push-ui-slim-closure)"
    push-ui-slim-closure-cli-entry, push, false, tree, "sh scripts/check/check-ui-slim-closure.shs src/app/ui/cli_entry.spl src/os/compositor src/os/drivers src/os/kernel src/lib/skia src/lib/gc_async_mut/gpu", -, -, "the `simple ui` dispatcher stays thin — backends are separate processes (advisory: same seed dependency as push-ui-slim-closure)"
    push-ui-slim-pack-inventory, push, false, tree, "sh scripts/check/check-ui-slim-pack-inventory.shs src/app/ui/cli_entry.spl src/app/ui/backend_entry_tui.spl", -, -, "UI pack entries in config/ui/pack_prefixes.sdn keep their required/later/absent closure inventory (advisory: seed deps under interpretation)"
    push-c-runtime-compiles, push, true, ref, "sh scripts/check/check-c-runtime-compiles-push.shs --rev", -, -, "owned C runtime passes clang -fsyntax-only (green on main 2026-09-01). ref-mode since 2026-09-07: still a TREE check rather than a delta (compilability is a property of a tree), but of the COMMITTED tree — src/runtime plus src/**/*.h and tools/**/*.h are materialised with git archive so a real compiler gets real files, and the include paths and the SKIP classifier's in-repo header lookup both resolve inside the materialised tree. Fixture 12 pins that the two paths disagree on both axes; fixture 13 fails closed when the materialisation scope misses an in-repo header reached by a relative include (archiving src/runtime alone silently turned 130 compiled/5 skipped into 128/7)"
    push-no-direct-rt, push, true, ref, "sh scripts/check/check-no-direct-rt.shs --roots src --rev", -, -, "direct rt_* call sites in product Simple do not exceed the baseline; ref-mode since 2026-09-07 so it reads the COMMITTED tree being pushed — sources, the allowlist AND the baseline all come from the pushed sha, not the shared working checkout. Selftest fixture 17 pins that the two paths disagree on all three inputs. Measured at conversion: the checkout held 24 untracked .spl the commit did not (16342 vs 16318 files scanned)"
    push-port-io-single-owner, push, true, ref, "sh scripts/check/check-port-io-single-owner.shs --rev", -, -, "exactly one file under src/os declares rt_port_* externs, and it is src/os/kernel/arch/x86/port_io_owner.spl (nine files each declared their own until 2026-09-06, and two of them disagreed about the ABI: cpu.spl had (u64)->u64 where rtc.spl had (u16)->u8, against a C ABI of uint8_t rt_port_inb(uint16_t)); ref-mode since 2026-09-07 so it reads the COMMITTED tree being pushed, not the shared working checkout — selftest fixture 4 pins that the two paths disagree. This guard has NO baseline or allowlist file, so the census's second rot axis has no surface here; do not read the single --rev fixture as the weak one-axis form"
    push-guard-wiring, push, true, ref, "sh scripts/check/check-guard-wiring.shs --rev", -, -, "no NEW unwired guard and no stale wiring baseline or opt-out; ref-mode since 2026-09-07, and it is the ONE row in this migration that is genuinely SPLIT — the wiring graph (guard enumeration, roots, edges, opt-out, frozen baseline) reads the COMMITTED tree being pushed, while scan_installed_hooks keeps reading the real repository root because whether a hook is installed in THIS clone, resolving to tracked current source, is a property of the machine and not of the commit. Do not 'finish the job' by pointing the hook half at the revision: a materialised tree has no .git and would report a clean install on every host. Selftest fixtures st-rev-* pin that the two paths disagree on all THREE content inputs (sources, baseline, opt-out); each was injected separately and caught. Materialisation is scripts/.github/src/bin/tools/config minus the vendored trees, 312 MB / 1.2s, verified to leave every structured counter — dead_dispatch_arms included — byte-identical to the working-tree run"
    push-sosix-capsule-boundaries, push, false, tree, "sh scripts/check/check-sosix-capsule-boundaries.shs", -, -, "SOSIX capsule import directions, <=300-line files, direct rt_* src ceiling (advisory: re-runs the rt_* scan)"
    push-perf-regression-tests, push, false, tree, "sh scripts/check/check-perf-regression-tests.shs", -, -, "every landed perf fix is still pinned by its mechanism (advisory: RED on main, 4 regressed)"
    push-process-wait-eintr-retry, push, false, tree, "sh scripts/check/check-process-wait-eintr-retry.shs", -, -, "process wait paths retry on EINTR (advisory: selftest RED on main)"
    push-mir-transient-scope-boundary, push, false, tree, "sh scripts/check/check-mir-transient-scope-boundary.shs", -, -, "the per-module MIR lowering loop opens the paired transient-heap scope (begin/pause/promote-both-roots/end) instead of calling lower_module directly, closing the compiler-side gap check-transient-scope-reclaims.shs cannot see (measured PASS on main 2026-09-07, 9/9 invariants, 6/6 selftest fixtures). Advisory rather than blocking: it is tree-mode only (no --rev/--ref) and this migration prefers advisory or opt-out over minting a new tree-mode blocking row — see .claude/rules/vcs.md"
    push-transient-scope-reclaims, push, false, tree, "sh scripts/check/check-transient-scope-reclaims.shs", -, -, "the transient heap scope actually reclaims at runtime (unscoped/scoped RSS ratio >= 8x, scoped peak <= 64MiB) by building and running two native fixtures. Advisory: needs a runnable native-build seed (bin/simple or a built Rust seed), which a fresh checkout/worktree lacks (measured ERROR -- nothing was checked (no runnable seed; set SIMPLE_SEED) here 2026-09-07), and reads peak RSS via `/usr/bin/time -v`, a GNU-time flag absent on BSD/macOS time (measured `illegal option -- v` on this host) — same missing-binary class as push-dual-run-shadow and push-stage4-dynamic-runtime-lane, plus a portability gap neither of those has"
    push-rt-hash-text-cross-lane, push, false, tree, "sh scripts/check/check-rt-hash-text-cross-lane.shs", -, -, "rt_hash_text agrees across the interpreter and native lanes for the same input. Advisory: needs a deployed executable at bin/simple, which a fresh checkout/worktree lacks (measured ERROR -- nothing was checked (no executable simple binary) here 2026-09-07) -- same missing-binary class as push-transient-scope-reclaims and push-dual-run-shadow. Landed unwired with #483; wired here."
    push-conflict-tree, push, true, range, "sh scripts/check/check-no-conflict-tree-push.shs", -, -, "outgoing commits contain no jj conflict tree"
    push-tree-size, push, true, range, "sh scripts/check/check-tree-size-push.shs", -, -, "outgoing tree retains load-bearing repository structure"
    push-conflict-markers, push, true, range, "sh scripts/check/check-no-conflict-markers-push.shs", -, -, "outgoing commits contain no conflict markers"
    push-merge-content-conservation, push, false, range, "sh scripts/check/check-merge-content-conservation-push.shs --scan-only", -, -, "no merge in the outgoing range lost content its parents did not agree to remove: an add/add path auto-merged against an EMPTY base can silently drop a line one parent had (7d40e71aa9c dropped session.retain() from gpu_provider_probes.spl with no conflict and no marker) and a clean merge of a deletion on one side with a new use on the other leaves a top-level definition gone and its caller alive (advisory: brand-new gate, records its verdict before it blocks; measured false-positive rate in doc/08_tracking/bug/merge_automerge_silent_content_loss_2026-09-07.md)"
    push-rules-quick, push, true, ref, "sh scripts/check/check-rules-sdl.shs --scan-only --group quick --ref", -, -, "quick committed rules registry checks without mutation fixtures"
    push-interpreter-module-owners, push, true, ref, "sh scripts/check/check-interpreter-module-owners.shs --scan-only --ref", -, -, "tracked Rust interpreter modules have exactly one declared owner without mutation fixtures"
    push-runtime-api-regression, push, true, range, "sh scripts/check/check-runtime-api-regression-push.shs --scan-only", -, -, "outgoing range deletes no mass of exported rt_* runtime API"
    push-interpreter-extern-registry-gap, push, true, ref, "sh scripts/check/check-interpreter-extern-registry-gap.shs --scan-only --rev", -, -, "no NEW compiler-declared extern missing from the seed interpreter extern registry; push dispatch compares the exact committed tip with the outgoing range base via --baseline-rev, so existing mainline gaps do not block unrelated branches and removed gaps are improvements. Standalone scans retain frozen-baseline stale-row enforcement. Ref-mode reads committed declared/registry content rather than the shared checkout. Fixtures 7-9 pin committed-content isolation, unchanged-debt PASS, and branch-added-gap FAIL. Note --scan-only skips selftests on the push path; run the checker selftest manually until a bootstrap lane executes it"
    push-sffi-v2-authority, push, true, ref, "sh scripts/check/check-sffi-v2-authority.shs --rev", -, -, "no newly failing SFFI v2 source-authority guard versus the outgoing committed base. Push dispatch supplies --baseline-rev because main is honestly red; unchanged existing failures do not block unrelated topics, while a newly failing guard remains blocking. The wrapper materialises both revisions with git archive (src/scripts/test/examples minus vendor) and executes sub-guard copies inside each tree because all guards resolve root from $0. Five selftest fixtures pin committed-content isolation, missing guards, unchanged red PASS, and newly red FAIL"
    push-type-walk-constructor-parity, push, true, ref, "sh scripts/check/check-type-walk-constructor-parity.shs --scan-only --rev", -, -, "every type constructor is projected by the type walk; ref-mode since 2026-09-06 so it reads the COMMITTED tree being pushed (sources AND allowlist), not the shared working checkout — selftest fixture 7 pins that the two paths disagree"
    push-shs-path-conversion-equivalence, push, false, tree, "sh scripts/check/check-shs-path-conversion-equivalence.shs", -, -, "converting a drive-letter path in a .shs to MinGW form removes the hit and preserves behaviour (advisory: exec half needs cygpath, NOT RUN off Windows)"
    push-shs-native-tool-boundary-preserved, push, false, tree, "sh scripts/check/check-shs-native-tool-boundary-preserved.shs", -, -, "native-tool seams still receive native paths while shell logic stays MinGW (advisory: exec half needs cygpath, NOT RUN off Windows)"
    push-windows-checkout-damage, push, true, range, "sh scripts/check/check-windows-checkout-damage-push.shs --scan-only", -, -, "outgoing range carries no Windows-checkout damage (materialized symlinks, absolute Windows symlink targets, newly-introduced CRLF)"
    push-main-test-runnable, push, true, ref, "sh scripts/check/check-main-test-runnable-push.shs --rev", -, -, "the committed tree can still run bin/simple test (startup-path .spl parses)"
    push-rt-dual-implementation, push, true, ref, "sh scripts/check/check-rt-dual-implementation-ratchet.shs --rev", -, -, "no NEW single-lane rt_* symbol and no stale baseline row (rt_* must exist in BOTH the C and Simple lanes); ref-mode since 2026-09-06 so it reads the COMMITTED tree being pushed, not the shared working checkout"
    push-dual-run-shadow, push, false, tree, "sh scripts/check/check-dual-run-shadow.shs", -, -, "every annotated C/Simple dual-run pair agrees (advisory: needs a runnable bin/simple, which not every push host has)"
    push-parser-source-global-ratchet, push, false, ref, "sh scripts/check/check-parser-source-global-ratchet.shs --rev", -, -, "no NEW global parser-source site (current_core_source_get/set); freezes the count at 8 so the SourceSnapshot identity contract's remaining debt stays visible (advisory: brand-new gate, records its verdict before it blocks). ref-mode since 2026-09-07 so it reads the COMMITTED tree being pushed — the scanned sources AND the frozen baseline both come from the pushed sha, not the shared working checkout. Selftest fixtures st-rev-source and st-rev-baseline pin that the two paths DISAGREE on each rot axis separately. Materialisation is git ls-tree + git checkout-index, NOT git archive: .gitattributes line 55 is `build export-ignore`, which drops 24 TRACKED .spl under a build/ path component out of any archive, and fixture st-rev-scope fails the guard when that happens. Same verdict on both paths at conversion (16227 scanned, globals=8, baseline 8), ~4s"
    push-rt-api-groups, push, false, tree, "sh scripts/check/check-rt-api-groups.shs", -, -, "every rt_* symbol is registered AND grouped: a new symbol absent from config/api/api_registry.sdn fails, a symbol landing in the residual bucket `misc` (which is NOT a group) and absent from the frozen scripts/check/rt_api_group_baseline.txt fails, a stale baseline entry fails, and a group whose forbidden direct call sites exceed its frozen budget fails. The floor is the frozen baseline, not the registry's own `sites` column, so regenerating the registry can no longer launder it (advisory: needs rg on PATH, which not every push host has, and the ungrouped/frozen-budget semantics are new; lands RED (advisory) with 2 unregistered, 1 ungrouped, and 7 groups over budget; no promotion pending)"
    push-runtime-source-list-parity, push, true, ref, "sh scripts/check/check-runtime-source-list-parity.shs --rev", -, -, "every owned src/runtime *.c has its frozen source-list membership across the seed, pure-Simple and Rust-crate rosters; no dropped or stale list entry; ref-mode since 2026-09-06 so it reads the COMMITTED tree being pushed (the three rosters AND the baseline), not the shared working checkout — selftest fixture 8 pins that the two paths disagree"
    push-no-mock-file-system-io, push, true, ref, "sh scripts/check/check-no-mock-file-system-io.shs --rev", -, -, "no NEW import of silently-succeeding mock std.file_system I/O primitives into product code (2026-09-01: the mock file_write_text writes nothing and returns true, which broke native capsule receipts); ref-mode since 2026-09-06 so it reads the COMMITTED tree being pushed, not the shared working checkout — selftest fixture 6 pins that the two paths disagree"
    push-transient-scope-text-field-promotion, push, true, ref, "sh scripts/check/check-transient-scope-text-field-promotion.shs --rev", -, -, "every scalar text field module_surfaces_freeze re-assigns inside the phase-2 registry retention scope is explicitly promoted by module_surfaces_promote (the four omitted ones were free()d while 771 ModuleSurfaces still held the handle and surfaced 69 minutes later as a bare SIGSEGV in validate_value_struct_layouts). Blocking: green on main, ~0s, pure source scan, no toolchain and no binary. ref-mode from the day it was wired so it reads the COMMITTED tree being pushed, never the shared working checkout — the three sources are materialised with git show. This guard has NO baseline or allowlist file, so the census's second rot axis has no surface here; selftest fixtures 3 and 4 pin the scan-root axis in BOTH directions (dirty checkout + clean commit, and clean checkout + broken commit) and each requires the two verdicts to DISAGREE. Tier 2 (the opt-in native fixture) is reported as not run under --rev rather than answering about a different tree"
    push-lifecycle-reachability, push, false, tree, "sh scripts/check/check-lifecycle-reachability.shs", -, -, "no NEW dormant lifecycle symbol (exported with zero production callers outside its defining file) and no stale baseline row (advisory: 88 symbols baselined as known debt, promote to blocking as that shrinks)"
    push-no-unwind-lib-dependency, push, false, tree, "sh scripts/check/check-no-unwind-lib-dependency.shs", -, -, "no artifact takes a dependency on a SEPARATE unwinder library (libunwind*/libgcc_eh); Simple has no exceptions, and the bootstrap compat shim that copied libunwind.so.8 in as libunwind.so is the shape fixture 2 replays. Advisory rather than blocking for two honest reasons: its fatal selftest needs cc + readelf + a libunwind.so.8 in the compiler's search path (a push host may have none of the three, and absence of a tool must not be laundered into a pass), and its optional artifact half reads build/ outputs that no revision contains, so the ref-mode conversion needs a decision about what an artifact scan even means for a commit. Green on main today: PASS - 2 assertion(s) checked (0 artifact(s)) - and the 2 are the always-available source assertions (link_config.rs linux(), native_all_support.spl), so that verdict is NOT vacuous. Promotion candidate once the artifact half has ref semantics"
    push-native-text-abi-and-binary-read, push, false, tree, "sh scripts/check/check-native-text-abi-and-binary-read.shs", -, -, "two BEHAVIOURAL producer contracts of the native C runtime - the runtime is compiled and RUN, not grepped - covering the rt_file_read_text length/NUL truncation and the missing-path-is-RT_NIL result. Green on main (PASS - 6 contract(s) checked, 0 failed) in ~10s, but advisory not blocking because it COMPILES src/runtime out of the working checkout, which is exactly the materialisation trap that turned check-c-runtime-compiles-push from 130 compiled/5 skipped into 128/7 while still printing PASS when src/runtime was archived alone. Promote to blocking ref-mode by reusing that guard's proven archive scope (src/runtime plus src/**/*.h and tools/**/*.h) and adding the fail-closed include-escape fixture; do not hand-roll a narrower scope"
    push-aot-failure-speaks, push, false, tree, "sh scripts/check/check-aot-failure-speaks.shs --selftest", -, -, "a FAILED native-build unit must state WHY it failed - the '(none recorded -- BUG in the producer)' summary line blinded four separate investigations on 2026-09-06 because two different defects print it byte-identically. What is pinned on the push tier is the CLASSIFIER, not a live candidate: the scan half needs --candidate <a real rejected stage binary>, which a push has no reason to possess, so a bare row would print ERROR - nothing was checked on every push and check nothing. Same shape and same reasoning as push-local-ci-receipt-selftest. Advisory because the selftest is the whole subject here and a fixture-only proof should not be able to block a push; the live-candidate half belongs to the bootstrap lane"
    push-runtime-shared-library, push, false, tree, "sh scripts/check/check-runtime-shared-library.shs", -, -, "the DYNAMIC Simple runtime is a real shippable shared library: libsimple_runtime.so must carry a DT_SONAME (without one a consumer records the build path in DT_NEEDED and it can be neither installed nor versioned) and must export an rt_* surface above a floor. Advisory because the library is a BUILD OUTPUT no checkout contains - measured on a clean tree it reports ERROR - nothing was checked (no shared library given or found) after its 6 fixtures pass, and ERROR is the honest verdict, never a pass. It cannot be promoted by a ref conversion at all; promotion needs a lane that builds the cdylib first and passes --lib"
    push-native-text-to-i64-parses, push, false, tree, "sh scripts/check/check-native-text-to-i64-parses.shs", -, -, "a natively compiled simple must PARSE a text when it evaluates .to_i64() rather than hand back the text handle's own machine word (aarch64 Stage 2, 2026-09-07). Advisory because it must EXECUTE a native simple binary and bin/simple is untracked - it is a symlink created by scripts/setup/setup.shs, so a fresh checkout has none and the guard reports ERROR - nothing was checked (no executable simple binary; pass --binary <path>). Same class as push-dual-run-shadow and push-plan-acceptance-swept, both advisory for the same missing-binary reason. Its 7 fixtures still run and still discriminate on every push"
    push-stage4-dynamic-runtime-lane, push, false, tree, "sh scripts/check/check-stage4-dynamic-runtime-lane.shs", -, -, "the Stage4 self-hosted compiler entry can link the SHARED runtime instead of being forced onto the static core-C archive; it drives the real binary rather than cargo test on purpose, because the unit-test path is itself broken. Advisory because it needs a seed binary that can run native-build - on a clean checkout it reports ERROR - nothing was checked (no seed binary; set SIMPLE_SEED_BIN to one that can run native-build). Cannot be made blocking until a push host is guaranteed a runnable seed; that is the same blocker push-dual-run-shadow carries"
    push-llm-caret-server-serves, push, false, tree, "sh scripts/check/check-llm-caret-server-serves.shs", -, -, "end-to-end SOCKET proof of the llm_caret dummy-provider server: GET /v1/health 200 json; POST /v1/chat/completions 200 with a full chat.completion envelope; the same POST with stream:true 200 text/event-stream terminated by data: [DONE]. Advisory and deliberately the SLOWEST of the rows added 2026-09-07 (~122s: eight fixture servers under nc, then the real run), placed immediately before push-plan-acceptance-swept which is slower still. It needs bash for /dev/tcp - run_push_gate invokes every guard as sh, and under dash this guard used to die at the socket open with an EMPTY stdout and no verdict at all, so it now re-execs under bash and says ERROR when there is no bash. It also needs bin/simple, which a fresh checkout lacks; that precondition is now checked before the 60s wait_for_port instead of after it"
    push-plan-acceptance-swept, push, false, tree, "sh scripts/check/check-plan-acceptance-swept.shs", -, -, "every spec in test/03_system/plan_acceptance loads and runs; LAST push row deliberately — it is the slowest (~13 min serial) so fast blocking rows reject first (advisory: needs a runnable Simple binary most push hosts lack)"
    push-local-ci-receipt-selftest, push, false, tree, "sh scripts/check/verify-local-ci-receipt.shs --selftest", -, -, "local-CI-receipt verifier fail-closed fixtures still discriminate (advisory: the verifier lands in a parallel lane, so a blocking row would block every push until it exists)"
    push-cross-unit-user-to-text-not-hijacked, push, false, tree, "sh scripts/check/check-cross-unit-user-to-text-not-hijacked.shs", -, -, "advisory: user-defined to_text() on a cross-unit type must not be hijacked by a builtin; needs a built simple binary with LLVM backend and runtime bundle, which a bare push host lacks"
    push-base64url-codegen-lane-perf, push, false, tree, "sh scripts/check/check-base64url-codegen-lane-perf.shs", -, -, "advisory: base64url codegen-lane perf comparison; needs a runnable bin/simple, which a bare push host lacks (answers ERROR — nothing was checked there)"
    push-native-build-entry-memory-budget, push, false, tree, "sh scripts/check/check-native-build-entry-memory-budget.shs", -, -, "advisory: native-build worker heap budget probe; needs a runnable bin/simple and a real build, which a bare push host lacks"
    push-rect-batch-spirv-pinned, push, true, tree, "sh scripts/check/check-rect-batch-spirv-pinned.shs", -, -, "blocking: the checked-in rect-batch SPIR-V words must be exactly what glslangValidator produces from the checked-in GLSL right now; fast (~1s), no device needed, fail-closed with its own 4-fixture selftest run before every scan"
    push-chrome-dynlib-probe, push, false, tree, "sh scripts/check/check-chrome-dynlib-probe.shs", -, -, "advisory: two-stage probe of the Chrome (CEF) render dynlib ABI; stage A needs a runnable Simple binary a fresh checkout lacks and stage B needs a pinned CEF drop most push hosts lack, so it answers ERROR - nothing was checked there rather than a fabricated pass"
    compiler-stage1, bootstrap, true, receipt, "scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap --deploy", -, -, "Stage 1 seed compiler completed"
    compiler-stage2, bootstrap, true, receipt, "scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap --deploy", -, -, "Stage 2 compiler completed"
    compiler-stage3, bootstrap, true, receipt, "scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap --deploy", -, -, "Stage 3 admitted self-host compiler completed"
    compiler-stage4, bootstrap, true, receipt, "scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap --deploy", -, -, "Stage 4 full pure-Simple CLI completed"
    stage4-tooling-matrix, bootstrap, true, todo, "", -, -, "49-row CLI MCP LSP tooling matrix has no required FAIL or BLOCKED row and is bound to the admitted Stage 4 candidate"
    rules-full, bootstrap, false, automated, "sh scripts/check/check-rules-sdl.shs --group full", -, -, "full rules and scenario shrink gates"
    tree-guard-exhaustive-selftest, bootstrap, false, automated, "sh scripts/check/check-tree-size-push.shs --selftest", -, -, "exhaustive structural tree detector fixtures moved out of interactive push"
    bootstrap-essential-tools, bootstrap, false, automated, "sh scripts/check/check-bootstrap-essential-tools-smoke.shs", -, -, "fresh Stage 4 test lint duplicate-check and aggregate smoke"
    native-positional-build, bootstrap, false, automated, "sh scripts/check/check-native-inprocess-positional-nonvacuous.shs", -, -, "in-process positional native build"
    predicate-parser-native-build, bootstrap, false, automated, "sh scripts/check/check-predicate-parser-native-build.shs", -, -, "predicate parser native build"
    native-trailing-defaults, bootstrap, false, automated, "sh scripts/check/check-native-trailing-default-param.shs", -, -, "native trailing default parameters"
    class-identity-matrix, bootstrap, false, automated, "sh scripts/check/check-class-identity-engine-matrix.shs", -, -, "multi-engine class identity matrix"
    engine-differential, bootstrap, false, automated, "sh scripts/check/check-engine-differential.shs", -, -, "interpreter JIT native differential"
    sdoctest-markdown-comments, bootstrap, false, automated, "sh scripts/check/check-sdoctest-bootstrap.shs", -, -, "Markdown and comment sdoctest discovery and execution"
    use-target-resolves, bootstrap, false, automated, "sh scripts/check/check-use-target-resolves.shs", -, -, "every use module path and named member resolves statically"
    c-runtime-compiles, bootstrap, false, automated, "sh scripts/check/check-c-runtime-compiles-push.shs", -, -, "owned C runtime passes clang -fsyntax-only"
    no-direct-rt, bootstrap, false, automated, "sh scripts/check/check-no-direct-rt.shs --roots src", -, -, "direct rt_* call sites in product Simple do not exceed the baseline"
    raw-sffi-unsafe-ratchet, bootstrap, false, automated, "sh scripts/check/check-raw-sffi-unsafe-ratchet.shs", -, -, "no new untagged raw SFFI declaration identity and no stale reviewed baseline row"
    signature-type-import-provenance, bootstrap, false, automated, "sh scripts/check/check-signature-type-import-provenance.shs", -, -, "signature types are imported from their declaring module"
    perf-regression-tests, bootstrap, false, automated, "sh scripts/check/check-perf-regression-tests.shs", -, -, "every landed perf fix is still pinned by its mechanism"
    plan-acceptance-swept, bootstrap, false, automated, "sh scripts/check/check-plan-acceptance-swept.shs", -, -, "bootstrap sweeps test/03_system/plan_acceptance under the in-development contract"
    process-wait-eintr-retry, bootstrap, false, automated, "sh scripts/check/check-process-wait-eintr-retry.shs", -, -, "process wait paths retry on EINTR"
    guard-wiring, bootstrap, false, automated, "sh scripts/check/check-guard-wiring.shs", -, -, "no NEW unwired guard and no stale wiring baseline or opt-out"
    outline-parse-terminates, bootstrap, false, automated, "sh scripts/check/check-outline-parse-terminates.shs", -, -, "treesitter outline-authority parse path terminates"
    runtime-api-regression-selftest, bootstrap, false, automated, "sh scripts/check/check-runtime-api-regression-push.shs --selftest", -, -, "runtime API deletion detector mutation fixtures"
    interpreter-extern-registry-gap-selftest, bootstrap, false, automated, "sh scripts/check/check-interpreter-extern-registry-gap.shs --selftest", -, -, "seed interpreter extern registry mutation fixtures"
