# ninja build log. Progress lines are pure noise; FAILED: is the whole signal.
log_opt | kind, pattern |
    detect, ninja:
    detect, ] Building
    detect, ] Linking
    keep, FAILED:
    keep, ninja: build stopped
    keep, error:
    drop, ] Building
    drop, ] Linking
    drop, ] Generating
    drop, ] Automatic MOC
    drop, ninja: no work to do
