# clang / gcc compile log. Keeps diagnostics, drops include-chain noise.
# kind: detect (claims the log) | keep (always retained) | drop (removed)
log_opt | kind, pattern |
    detect, In file included from
    detect, note: expanded from macro
    detect, clang:
    detect, [-W
    keep, error:
    keep, fatal error:
    keep, undefined reference
    keep, ld:
    drop, In file included from
    drop, note: expanded from macro
    drop, note: candidate
    drop, note: in instantiation of
    drop, note: previous declaration is here
