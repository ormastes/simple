# cmake configure log. Feature-probe chatter out, CMake Error/Warning in.
log_opt | kind, pattern |
    detect, -- Detecting
    detect, -- Check for working
    detect, -- Configuring done
    detect, CMake Error
    keep, CMake Error
    keep, CMake Warning
    keep, error:
    drop, -- Detecting
    drop, -- Check for working
    drop, -- Looking for
    drop, -- Found
    drop, -- The C compiler identification
    drop, -- The CXX compiler identification
    drop, -- Performing Test
    drop, -- Configuring done
    drop, -- Generating done
    drop, -- Build files have been written
