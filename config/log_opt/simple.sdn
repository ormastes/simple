# simple build/test log. The verdict lines are load-bearing (see
# .claude/rules/testing.md) so every one of them is an explicit keep.
log_opt | kind, pattern |
    detect, warning[
    detect, [native-incremental]
    detect, Session setup
    keep, Results:
    keep, SPEC FILE VERDICT:
    keep, examples
    keep, failure
    keep, error:
    keep, FAILED
    drop, warning[
    drop, Session setup
    drop, [native-incremental]
    drop, note:
