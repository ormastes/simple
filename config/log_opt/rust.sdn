# cargo / rustc build log. Keeps E-codes and panics; drops progress + hints.
log_opt | kind, pattern |
    detect, error[E
    detect, Compiling
    detect, Blocking waiting for file lock
    detect, Finished `release`
    keep, error[E
    keep, error:
    keep, panicked at
    keep, test result:
    keep, -->
    drop, Compiling
    drop, Checking
    drop, Downloading
    drop, Downloaded
    drop, Blocking waiting for file lock
    drop, Finished `release`
    drop, = note:
    drop, = help:
    drop, For more information about this error
    drop, Some errors have detailed explanations
