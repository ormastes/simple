# API group overrides — the ONLY hand-maintained input to the rt API registry.
#
# `gen-api-registry.shs` derives a symbol's group mechanically from its family
# (the first `_`-delimited token after `rt_`), and drops any family with fewer
# than 5 distinct symbols into the residual bucket `misc`. `misc` is NOT a
# group (doc/04_architecture/runtime/rt_api/rt_api_group_policy.md §1), and
# `check-rt-api-groups.shs` errors on any symbol that lands there and is not in
# the frozen baseline `scripts/check/rt_api_group_baseline.txt`.
#
# This file is that error's REMEDY: a row here assigns a symbol to an existing
# named group, overriding the family heuristic, so a genuinely small family can
# be grouped instead of being baselined as permanent debt. Without it the only
# way to clear an "ungrouped" error would be to widen the baseline, which is
# the thing the baseline exists to prevent.
#
# A row is a review act and needs a reason. The group named MUST already exist
# in the registry's `api_groups` table — this file assigns membership, it does
# not invent groups (a genuine new group is 5+ symbols sharing a prefix, which
# the heuristic forms on its own).
#
# Columns: surface, symbol, group, reason

api_group_overrides |surface, symbol, group, reason|
    rt, rt_readdir_count, dir, "directory enumeration: readdir is the `dir` group's iteration primitive"
    rt, rt_readdir_entry, dir, "directory enumeration: readdir is the `dir` group's iteration primitive"
    rt, rt_readdir_free, dir, "directory enumeration: readdir is the `dir` group's iteration primitive"
    rt, rt_utf8_count_codepoints, string, "UTF-8 decoding over string storage; the `string` group owns text bytes"
    rt, rt_utf8_find_invalid, string, "UTF-8 validation over string storage; the `string` group owns text bytes"
    rt, rt_utf8_validate, string, "UTF-8 validation over string storage; the `string` group owns text bytes"
    rt, rt_utf8_width, string, "display width of a UTF-8 string; the `string` group owns text bytes"
