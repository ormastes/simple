# CEF (Chromium Embedded Framework) binary-distribution pin.
#
# Consumed by scripts/setup/setup-cef-dynlib.shs (POSIX sh: Linux / macOS / FreeBSD /
# MSYS git-bash) and its Windows twin scripts/setup/setup-cef-dynlib.ps1. This file is the
# SINGLE source of truth for the version and the per-platform archive digests; neither
# script carries a second copy.
#
# HONESTY NOTE (2026-09-11): the authoring sandbox has no network (curl/wget/WebFetch are
# blocked by .claude/hooks), so the version string, the URL template and every sha256 below
# are UNVERIFIED. Each `sha256: UNSET` row is refused by both setup scripts unless
# --allow-unpinned is passed, which prints a loud warning into the receipt. Fill a row in by
# copying the digest from the official cef-builds index for the exact archive name, then
# drop UNSET. Do NOT paste a digest you computed from a file you already downloaded — that
# proves only that the file is itself; the pin must come from the publisher's index.

cef_pin:
  # The "minimal" distribution: Release binaries + headers, no debug symbols, no sample apps.
  distribution: minimal
  version: UNSET-verify-before-use
  chromium_version: UNSET-verify-before-use

  # Archive names follow cef_binary_<version>_<platform>_minimal.tar.bz2.
  # URL template; `{archive}` is the row's archive name. URL-encoding of `+` in the version
  # is what the index does, and is applied by the setup scripts, not stored here.
  url_template: "https://cef-builds.spotifycdn.com/{archive}"
  index_url: "https://cef-builds.spotifycdn.com/index.json"
  archive_suffix: "_minimal.tar.bz2"

  platforms:
    - platform: linux64
      archive: UNSET-verify-before-use
      sha256: UNSET
      lib: Release/libcef.so
    - platform: linuxarm64
      archive: UNSET-verify-before-use
      sha256: UNSET
      lib: Release/libcef.so
    - platform: macosx64
      archive: UNSET-verify-before-use
      sha256: UNSET
      lib: "Release/Chromium Embedded Framework.framework/Chromium Embedded Framework"
    - platform: macosarm64
      archive: UNSET-verify-before-use
      sha256: UNSET
      lib: "Release/Chromium Embedded Framework.framework/Chromium Embedded Framework"
    - platform: windows64
      archive: UNSET-verify-before-use
      sha256: UNSET
      lib: Release/libcef.dll
    - platform: windowsarm64
      archive: UNSET-verify-before-use
      sha256: UNSET
      lib: Release/libcef.dll

  # Where an admitted drop is extracted. Both setup scripts only ever create or delete
  # paths under this prefix.
  install_root: build/cef

  # macOS only: CEF spawns its render/GPU subprocesses from a separate helper .app bundle.
  # Whether that can be satisfied when libcef is dlopen'ed from a NON-bundled CLI binary is
  # UNVERIFIED and is the single largest macOS risk for stage B of the dynlib probe
  # (blocked row B2 in doc/03_plan/ui/chrome_dynlib/chrome_dynlib_vulkan_showcase_plan.md).
  macos_helper_required: true

  # macOS ANGLE backs onto Metal; `--use-angle=vulkan` is not a shipped backend there, so a
  # macOS host records vulkan-angle-unavailable per doc/07_guide/tooling/
  # renderdoc_capture_infra.md:748. Chrome availability is never Vulkan proof.
  macos_vulkan_proof: unavailable
