schema_version: "simple.mir-verify-baseline/v1"
# Ratchet baseline of MIR verifier findings on the compiler's own source.
# Measured 2026-10-10 with the SINGLE-FILE harness (parse -> HIR -> MIR ->
# mir_verify_module per file, no import closure; unresolved imports lower as
# HirTypeKind.Error -> i64), on 15 modules of src/compiler/60.mir_opt/mir_opt/
# (__init__ .. collection_opt) plus bytes_util.spl, perf_facts.spl,
# mir_verify.spl. Counts are UPPER BOUNDS; a full-closure (phase 3 + phase 4)
# run must replace this file before any rule is promoted to `error`.
# Rule: a change may not RAISE any count below; a lower count should be
# written back here in the same change.
