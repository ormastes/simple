schema_version: "simple.mir-verify-rules/v1"
# Rule registry for the mandatory MIR validity verifier (RB-19A, LPH-20261009).
# Record shape follows the robustness update plan §4: detection (id/family),
# desired policy (eventual_profiles), lifecycle, and evidence are separate
# fields. `lifecycle: error` = fatal in every profile (one-level downgrade under
# SIMPLE_ASSURANCE_WARNING_PHASE); `lifecycle: warning` = warn-first because the
# compiler's own source is not yet clean for that rule (see
# C:/dev/simple-bootstrap-storage/robustness/MIR_VERIFY_FINDINGS.md).
# Promotion = edit the record after the evidence gate, never a message change.
# `src/compiler/50.mir/mir_verify.spl::mir_verify_rules()` must agree with this
# file (pinned by test/01_unit/compiler/50.mir/mir_verify/mir_verify_rule_registry_spec.spl).
introduced_revision: 1
rules:
  - id: MIRV-001
    family: unresolved_type
    lifecycle: error
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
    bug: lower_type erases HirTypeKind.Error to i64 (1a MIR half)
  - id: MIRV-002
    family: illegal_cast
    lifecycle: error
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
    bug: unsupported LLVM value conversion from ptr to i8 (bytes_util text[i] as u8)
  - id: MIRV-002b
    family: bitcast_width
    lifecycle: error
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
  - id: MIRV-003
    family: unit_static
    lifecycle: error
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
    bug: global void static
  - id: MIRV-003b
    family: unit_stored_local
    lifecycle: warning
    eventual_profiles: [robust, critical, verified]
    evidence_status: pending
  - id: MIRV-004
    family: call_generic_template
    lifecycle: error
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
    bug: call to un-emitted generic template / unspecialised symbol
  - id: MIRV-004b
    family: call_arity
    lifecycle: error
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
  - id: MIRV-004c
    family: call_arg_type
    lifecycle: warning
    eventual_profiles: [robust, critical, verified]
    evidence_status: pending
  - id: MIRV-004d
    family: call_abi_kind
    lifecycle: warning
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: pending
    note: warn-first; 77 hits on 15 compiler modules (CallIndirect through unit-typed closure locals) -- pre-existing lowering gap, see MIR_VERIFY_FINDINGS.md F3
  - id: MIRV-005
    family: cfg_structure
    lifecycle: error
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
  - id: MIRV-005b
    family: use_undeclared_local
    lifecycle: error
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
  - id: MIRV-005c
    family: unused_condition
    lifecycle: warning
    eventual_profiles: [robust, critical, verified]
    evidence_status: pending
    bug: match guards silently ignored (3a)
  - id: MIRV-005d
    family: invalid_variant
    lifecycle: error
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
  - id: MIRV-005e
    family: local_never_defined
    lifecycle: warning
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: pending
    note: warn-first; 97 hits on 15 compiler modules -- pre-existing lowering gap, see MIR_VERIFY_FINDINGS.md F4
  - id: MIRV-006
    family: field_out_of_layout
    lifecycle: error
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
    bug: silently reads field 0
  - id: MIRV-006b
    family: layout_owner_unresolved
    lifecycle: warning
    eventual_profiles: [robust, critical, verified]
    evidence_status: pending
  - id: MIRV-007
    family: duplicate_symbol
    lifecycle: error
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
    bug: mono specialization symbol id collision (two symbols, one emitted name)
  - id: MIRV-007b
    family: static_initializer_type
    lifecycle: warning
    eventual_profiles: [robust, critical, verified]
