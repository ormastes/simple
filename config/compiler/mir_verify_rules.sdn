schema_version: "simple.mir-verify-rules/v1"
# Rule registry for the mandatory MIR validity verifier (RB-19A, LPH-20261009).
# Record shape follows the robustness update plan §4: detection (id/family),
# desired policy (eventual_profiles), lifecycle, and evidence are separate
# fields.
#
# Configurable rules retain their warn-first lifecycle. A rule is
# promoted to `error` here, per rule, only after a
# phase-3 + phase-4 FULL-CLOSURE run records zero hits for it
# (`promotion_candidate: true` marks the rules that had zero hits on the
# single-file probe and are therefore candidates for that run).
# Per-build override: SIMPLE_MIR_VERIFY_LEVELS="MIRV-002=error,MIRV-005e=off,*=warning"
# (levels: error | warning | off; `*` = every id not named, INCLUDING the two
# MIR-lowering advisories E-MIR-TYPE-Error and E-MIR-MATCH-GUARD: `*=error`
# promotes them to fatal lowering errors on every route, `*=off` silences
# them). The global
# SIMPLE_ASSURANCE_WARNING_PHASE still downgrades configurable `error` one level.
# Exception: MIRV-001n is a mandatory missing-carrier structural error. It cannot
# be disabled/downgraded, and its required walk still runs under `*=off`.
# The spec is resolved once per run. A malformed entry, unknown level or
# unknown id rejects the WHOLE spec (registry defaults stay) and is a build
# error. Structural missing-carrier checks still run when configurable rules
# are `off`. Warning lines
# are capped per rule per build (first 10 + one count line); errors are not.
# The same switch carries the two MIR-lowering advisories E-MIR-TYPE-Error and
# E-MIR-MATCH-GUARD (default `warning` = recorded in MirLowering.mir_advisories,
# never in MirLowering.errors).
# Reference measurement (not a ratchet): config/compiler/mir_verify_baseline.sdn.
# `src/compiler/50.mir/mir_verify_levels.spl::mir_verify_rules()` must agree with this
# file (pinned by test/01_unit/compiler/50.mir/mir_verify/mir_verify_rule_registry_spec.spl).
introduced_revision: 1
rules:
  - id: MIRV-001
    family: unresolved_type
    lifecycle: warning
    promotion_candidate: true
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
    bug: lower_type erases HirTypeKind.Error to i64 (1a MIR half)
  - id: MIRV-001n
    family: missing_type_declaration
    lifecycle: error
    promotion_candidate: false
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs_unrun
    bug: phase2_result_payload_native_crash_2026_10_26
  - id: MIRV-002
    family: illegal_cast
    lifecycle: warning
    promotion_candidate: false
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
    bug: unsupported LLVM value conversion from ptr to i8 (bytes_util text[i] as u8)
    note: narrowed to text/aggregate <-> (<64-bit int | float); 1 real hit (bytes_util)
  - id: MIRV-002b
    family: bitcast_width
    lifecycle: warning
    promotion_candidate: true
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
  - id: MIRV-003
    family: unit_static
    lifecycle: warning
    promotion_candidate: true
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
    bug: global void static
  - id: MIRV-003b
    family: unit_stored_local
    lifecycle: warning
    promotion_candidate: false
    eventual_profiles: [robust, critical, verified]
    evidence_status: pending
  - id: MIRV-004
    family: call_generic_template
    lifecycle: warning
    promotion_candidate: true
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
    bug: call to un-emitted generic template / unspecialised symbol
    note: templates are not inserted into module.functions today (module_lowering.spl), so this rule is currently vacuous
  - id: MIRV-004b
    family: call_arity
    lifecycle: warning
    promotion_candidate: false
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
    note: 1 real hit (auto_vectorize_codegen.spl:86, fixed in the same series); re-run the closure before promotion
  - id: MIRV-004c
    family: call_arg_type
    lifecycle: warning
    promotion_candidate: false
    eventual_profiles: [robust, critical, verified]
    evidence_status: pending
  - id: MIRV-004d
    family: call_abi_kind
    lifecycle: warning
    promotion_candidate: false
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: pending
    note: 77 hits on 15 compiler modules (CallIndirect through unit-typed closure locals) -- lowering gap, MIR_VERIFY_FINDINGS.md F3
  - id: MIRV-005
    family: cfg_structure
    lifecycle: warning
    promotion_candidate: true
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
  - id: MIRV-005b
    family: use_undeclared_local
    lifecycle: warning
    promotion_candidate: true
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
  - id: MIRV-005c
    family: unused_condition
    lifecycle: warning
    promotion_candidate: false
    eventual_profiles: [robust, critical, verified]
    evidence_status: pending
    bug: match guards silently ignored (3a)
  - id: MIRV-005d
    family: invalid_variant
    lifecycle: warning
    promotion_candidate: true
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
  - id: MIRV-005e
    family: local_never_defined
    lifecycle: warning
    promotion_candidate: false
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: pending
    note: not dominance -- a local counts as defined by any direct dest, Arg/Return, address-taking (Ref/GetElementPtr), Store target or intrinsic argument anywhere in the function; 97 hits before that widening, MIR_VERIFY_FINDINGS.md F4
  - id: MIRV-006
    family: field_out_of_layout
    lifecycle: warning
    promotion_candidate: true
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
    bug: silently reads field 0
  - id: MIRV-006b
    family: layout_owner_unresolved
    lifecycle: warning
    promotion_candidate: false
    eventual_profiles: [robust, critical, verified]
    evidence_status: pending
  - id: MIRV-007
    family: duplicate_symbol
    lifecycle: warning
    promotion_candidate: true
    eventual_profiles: [moderate, strict, robust, critical, verified]
    evidence_status: specs
    bug: mono specialization symbol id collision (two symbols, one emitted name)
  - id: MIRV-007b
    family: static_initializer_type
    lifecycle: warning
    promotion_candidate: false
    eventual_profiles: [robust, critical, verified]
    evidence_status: pending
