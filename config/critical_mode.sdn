# Mission-critical mode settings (design 4 of the unified debug/profile
# capability architecture).
#
# Read by:
#   - std.critical.capability_manifest (load_critical_mode_config)
#   - the `dynamic_capability_acquire` lint (DCA001 severity, DCA002 pin check)
#
# Kept in its own file rather than added to a shared project config so that
# parallel streams editing `[gpu]` and friends cannot conflict with these keys.

critical:
  # Is this build a mission-critical build?
  enabled: false

  # Severity of DCA001 (capability acquired outside an `@init_phase` function).
  #   allow  no diagnostics                    (default outside critical mode)
  #   warn   diagnostic, build still succeeds  (critical mode's default TODAY)
  #   error  build fails                       (critical mode's TARGET state)
  #
  # The requirement is "a warning now, promotable to an error later": critical
  # builds start at `warn`, and promoting to `error` is this one line. Do not
  # hard-code the severity anywhere in code.
  dynamic_acquire: warn

  gpu:
    # Under critical mode this MUST name a concrete backend; `auto` is rejected
    # (DCA002) because it defers the choice to a boot probe. At boot the probe
    # must match this value or the process refuses to start (DCA003).
    backend: auto
