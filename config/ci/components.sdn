# Separately buildable components for .github/workflows/component-build.yml.
#
# Each component builds on its own with an already-proven compiler ($SIMPLE_BIN,
# picked by scripts/bootstrap/resolve-bootstrap-compiler.shs per
# config/bootstrap.sdn: local phase > newest RC > none). The compiler and the app
# are never rebuilt for a component.
#
#   paths:  space-separated path prefixes. A change under any of them rebuilds
#           the component. List the component's own sources AND the sources it
#           imports, so a dependency edit rebuilds its dependents.
#   build:  one shell command (no double quotes); runs at the repo root.
#   cache:  directory the build keeps incremental state in (actions/cache).
#   output: the artifact the build must produce.
#
# ponytail: path prefixes over-approximate the import closure (any src/lib/
# edit rebuilds every component). Upgrade path: feed `git diff` into
# src/app/build/targets/change_classifier.spl once a full-CLI binary is
# released and use its affected_targets instead.
schema: "simple.ci.components.v1"

component kernel-x86_64:
    runner: ubuntu-24.04
    host: linux-x86_64
    paths: "src/os/ src/lib/ examples/09_embedded/simple_os/ scripts/os/build-simpleos-x86-64-components-kernel.shs"
    build: "sh scripts/os/build-simpleos-x86-64-components-kernel.shs testrun"
    cache: "build/os/x86_64_components/testrun/kcache"
    output: "build/os/x86_64_components/testrun/kernel.elf"

component kernel-aarch64:
    runner: ubuntu-24.04
    host: linux-x86_64
    paths: "src/os/ src/lib/ examples/09_embedded/simple_os/ scripts/os/build-simpleos-aarch64-components-kernel.shs"
    build: "sh scripts/os/build-simpleos-aarch64-components-kernel.shs testrun"
    cache: "build/os/aarch64_components/testrun/kcache"
    output: "build/os/aarch64_components/testrun/kernel.elf"

component kernel-riscv64:
    runner: ubuntu-24.04
    host: linux-x86_64
    paths: "src/os/ src/lib/ examples/09_embedded/simple_os/ scripts/os/build-simpleos-riscv64-components-kernel.shs"
    build: "sh scripts/os/build-simpleos-riscv64-components-kernel.shs testrun"
    cache: "build/os/riscv64_components/testrun/kcache"
    output: "build/os/riscv64_components/testrun/kernel.elf"

component plugin-backend-wasm:
    runner: ubuntu-24.04
    host: linux-x86_64
    paths: "src/plugins/backend_wasm/ src/lib/ src/compiler/70.backend/"
    build: "$SIMPLE_BIN native-build src/plugins/backend_wasm/wasm_backend.spl --source src --emit-archive --cache-dir build/components/plugin-backend-wasm/cache -o build/components/plugin-backend-wasm/libbackend_wasm.a"
    cache: "build/components/plugin-backend-wasm/cache"
    output: "build/components/plugin-backend-wasm/libbackend_wasm.a"

component provider-cli-native:
    runner: ubuntu-24.04
    host: linux-x86_64
    paths: "src/app/provider_cli/ src/lib/ targets.sdn"
    build: "$SIMPLE_BIN native-build src/app/provider_cli/native_provider_v1.spl --source src --emit-shared --cache-dir build/components/provider-cli-native/cache -o build/components/provider-cli-native/provider_cli_native.so"
    cache: "build/components/provider-cli-native/cache"
    output: "build/components/provider-cli-native/provider_cli_native.so"

component simd-x86_64-avx512:
    runner: ubuntu-24.04
    host: linux-x86_64
    paths: "src/lib/nogc_sync_mut/simd/ src/compiler/60.mir_opt/mir_opt/simd_recipe_infra.spl src/compiler/85.mdsoc/feature/optimization/simd_provider.spl"
    build: "$SIMPLE_BIN native-build src/lib/nogc_sync_mut/simd/mod.spl --source src --cpu x86-64-v4 --emit-archive --cache-dir build/components/simd-x86_64-avx512/cache -o build/components/simd-x86_64-avx512/libsimd_avx512.a"
    cache: "build/components/simd-x86_64-avx512/cache"
    output: "build/components/simd-x86_64-avx512/libsimd_avx512.a"

component simd-aarch64-cross:
    runner: ubuntu-24.04
    host: linux-x86_64
    paths: "src/lib/nogc_sync_mut/simd/ src/compiler/60.mir_opt/mir_opt/simd_recipe_infra.spl src/compiler/85.mdsoc/feature/optimization/simd_provider.spl"
    build: "$SIMPLE_BIN native-build src/lib/nogc_sync_mut/simd/mod.spl --source src --target aarch64-unknown-linux-gnu --emit-archive --cache-dir build/components/simd-aarch64-cross/cache -o build/components/simd-aarch64-cross/libsimd_aarch64.a"
    cache: "build/components/simd-aarch64-cross/cache"
    output: "build/components/simd-aarch64-cross/libsimd_aarch64.a"
