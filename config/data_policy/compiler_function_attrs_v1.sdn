# Compiler function attribute placement policy (simple.data-policy/v1).
#
# Hot scalar attributes on MirFunction / HirFunction stay embedded directly on
# the node (`layout: "embed"`, canonicalized to `AttrPlacementV1.Embedded`),
# while cold sparse metadata (`vhdl_metadata`, `driver_manifest_attr`,
# `export_attr`, `verification_contract`) are pinned to `sparse_hash` so rare
# attributes do not force per-function side allocations.
data_policy:
    schema: "simple.data-policy/v1"
    declarations:
        mir_function:
            tree: "compiler.mir"
            view: "compiler.mir.MirFunctionView"
            attributes:
                symbol:
                    type: "i64"
                    required: true
                is_inline:
                    type: "bool"
                    default: false
                vhdl_metadata:
                    type: "Option"
                    args: ["VhdlHardwareMetadata"]
                driver_manifest_attr:
                    type: "Option"
                    args: ["DriverManifestAttr"]
                verification_contract:
                    type: "Option"
                    args: ["HirContractBlock"]
                export_attr:
                    type: "Option"
                    args: ["ExportAttr"]
    rules:
        mir_fn_symbol_embed:
            site: "compiler.mir.MirFunctionView.symbol"
            layout: "embed"
            pin: true
        mir_fn_is_inline_embed:
            site: "compiler.mir.MirFunctionView.is_inline"
            layout: "embed"
            pin: true
        mir_fn_vhdl_sparse:
            site: "compiler.mir.MirFunctionView.vhdl_metadata"
            layout: "sparse_hash"
            pin: true
        mir_fn_driver_manifest_sparse:
            site: "compiler.mir.MirFunctionView.driver_manifest_attr"
            layout: "sparse_hash"
            pin: true
        mir_fn_contract_sparse:
            site: "compiler.mir.MirFunctionView.verification_contract"
            layout: "sparse_hash"
            pin: true
        mir_fn_export_sparse:
            site: "compiler.mir.MirFunctionView.export_attr"
            layout: "sparse_hash"
            pin: true
