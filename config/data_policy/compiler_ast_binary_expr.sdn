# Data plan W3 pilot (doc/03_plan/compiler/data/data_attributes_layout_containers_xray_2026-11-06.md
# sections 3.1, 6.2, 8.4, 12.1, 12.3): the binary-expression family of the
# compiler AST pool as a typed @node_tree view. `data_policy.declarations` is
# the logical schema resolved by compiler.common.data.data_schema_resolver
# (W1); `data_policy.rules` selects the storage mechanism per attribute
# (layout: direct, column or sparse_hash; site = view.attr, type = view,
# module = tree) and `node_views` binds attributes to the owner
# accessor used by `direct` and to the generated store class used by `column`
# and `sparse_hash`. The same selection can be made in SPL with
# @attr_storage(token) on a @node_tree class or field; a disagreeing pin is
# a diagnostic. Regenerate the view after editing:
# bin/simple run src/app/compiler_schema/main.spl node_views
data_policy:
    schema: "simple.data-policy/v1"
    declarations:
        binary_expr:
            tree: "compiler.ast"
            view: "compiler.ast.BinaryExprView"
            attributes:
                source_span:
                    type: "i64"
                    required: true
                left:
                    type: "i64"
                    required: true
                op:
                    type: "i64"
                    required: true
                inferred_type:
                    type: "Option"
                    args: ["text"]
    rules:
        binary_expr_op_column:
            site: "compiler.ast.BinaryExprView.op"
            layout: "column"
            pin: true
        binary_expr_inferred_type_sparse:
            site: "compiler.ast.BinaryExprView.inferred_type"
            layout: "sparse_hash"
            pin: true
node_views:
    binary_expr:
        class: "BinaryExprView"
        owner_import: "compiler.core.ast"
        accessors:
            source_span: "expr_get_span"
            left: "expr_get_left"
            op: "expr_get_int"
        stores:
            op: "BinaryExprOpColumn"
            inferred_type: "BinaryExprInferredTypeStore"
