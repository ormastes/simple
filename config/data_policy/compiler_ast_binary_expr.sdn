# Data plan W3 pilot (doc/03_plan/compiler/data/data_attributes_layout_containers_xray_2026-11-06.md
# sections 12.1, 12.3): the binary-expression family of the compiler AST pool
# as a typed @node_tree view. `data_policy.declarations` is the logical schema
# resolved by compiler.common.data.data_schema_resolver (W1); `node_views`
# maps each stored attribute to its existing owner accessor. Regenerate the
# view after editing: bin/simple run src/app/compiler_schema/main.spl node_views
data_policy:
    schema: "simple.data-policy/v1"
    declarations:
        binary_expr:
            tree: "compiler.ast"
            view: "compiler.ast.BinaryExprView"
            attributes:
                source_span:
                    type: "i64"
                    required: true
                left:
                    type: "i64"
                    required: true
                op:
                    type: "i64"
                    required: true
                inferred_type:
                    type: "Option"
                    args: ["text"]
node_views:
    binary_expr:
        class: "BinaryExprView"
        owner_import: "compiler.core.ast"
        accessors:
            source_span: "expr_get_span"
            left: "expr_get_left"
            op: "expr_get_int"
        sparse:
            inferred_type: "BinaryExprInferredTypeStore"
