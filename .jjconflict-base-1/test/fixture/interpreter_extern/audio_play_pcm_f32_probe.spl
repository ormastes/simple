# Fixture for test/01_unit/compiler/interpreter_extern/audio_registration_spec.spl.
# rt_audio_play_pcm_f32 takes a native SplArray* -- unlike every other
# rt_audio_* entry point, this one cannot be safely marshalled from the
# interpreter's Value representation (matches the rt_sdl2_present_rgba /
# rt_glfw_present_argb precedent: array-taking entry points are refused
# cleanly with an explanatory message, not attempted via a bad transmute).
# This fixture proves the refusal fires instead of a crash or the generic
# "unknown extern function" text.

extern fn rt_audio_play_pcm_f32(samples: [f32], channels: i64, sample_rate: i64) -> i64

fn main() -> i64:
    val samples: [f32] = [0.0, 0.0]
    val h = rt_audio_play_pcm_f32(samples, 2, 48000)
    print "unexpected success: h={h}"
    0
