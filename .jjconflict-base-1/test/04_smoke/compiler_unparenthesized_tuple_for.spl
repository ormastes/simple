# Regression: unparenthesized tuple bindings must encode exactly like
# `for (index, name) in ...`, including the concrete bound name and value.
fn main() -> i64:
    val names = ["aether", "glass"]
    var result = ""
    for index, name in names.enumerate():
        result = result + index.to_string() + ":" + name + ";"
    if result != "0:aether;1:glass;":
        print "tuple-for-fail=" + result
        return 1
    print "tuple-for-ok=" + result
    0
