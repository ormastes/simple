#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)"
MACOS_GUI_PROVENANCE_SOURCE_ONLY=1
MACOS_GUI_PROVENANCE_ROOT="$ROOT_DIR"
export MACOS_GUI_PROVENANCE_SOURCE_ONLY MACOS_GUI_PROVENANCE_ROOT
. "$ROOT_DIR/scripts/check/build-macos-full-cli-gui-provenance.shs"

fixture_root="$(mktemp -d "${TMPDIR:-/tmp}/macos-gui-provenance-fixture.XXXXXX")"
trap 'rm -rf "$fixture_root"' EXIT HUP INT TERM
fixture_root="$(CDPATH= cd -- "$fixture_root" && pwd -P)"

canonical="$fixture_root/build/bootstrap/full/test-platform/simple"
canonical_full_driver_path "$canonical" "$fixture_root" test-platform
! canonical_full_driver_path \
    "$fixture_root/build/bootstrap/full/other/simple" \
    "$fixture_root" test-platform
for substitution in \
    "$fixture_root/simple_seed" \
    "$fixture_root/stage3/test-platform/simple" \
    "$fixture_root/compiler_rust/target/release/simple" \
    "$fixture_root/debug/simple" \
    "$fixture_root/test/02_integration/rendering/macos_vulkan_2d_live_harness"; do
    forbidden_driver_substitution "$substitution"
done
! forbidden_driver_substitution "$canonical"

duplicate="$fixture_root/duplicate.env"
printf 'schema=one\nschema=two\n' >"$duplicate"
if value_of schema "$duplicate" >/dev/null 2>&1; then
    echo "duplicate manifest key was accepted" >&2
    exit 1
fi

git_fixture="$fixture_root/git"
mkdir -p "$git_fixture"
git -C "$git_fixture" init -q
git -C "$git_fixture" config user.email fixture@example.invalid
git -C "$git_fixture" config user.name fixture
printf 'current\n' >"$git_fixture/source.spl"
git -C "$git_fixture" add source.spl
git -C "$git_fixture" commit -qm fixture
require_clean_git "$git_fixture"
printf 'tampered\n' >>"$git_fixture/source.spl"
if (require_clean_git "$git_fixture" >/dev/null 2>&1); then
    echo "current-source tamper was accepted" >&2
    exit 1
fi
git -C "$git_fixture" checkout -q -- source.spl
printf 'untracked\n' >"$git_fixture/untracked.spl"
if (require_clean_git "$git_fixture" >/dev/null 2>&1); then
    echo "untracked source was accepted" >&2
    exit 1
fi

mkdir -p "$(dirname -- "$canonical")"
printf 'admitted\n' >"$canonical"
chmod 700 "$canonical"
! macos_gui_history_forbidden_role "$canonical"
! forbidden_driver_binary_identity "$canonical"
printf 'bootstrap seed only\n' >"$fixture_root/simple_seed"
if ! forbidden_driver_binary_identity "$fixture_root/simple_seed"; then
    echo "seed binary identity was accepted" >&2
    exit 1
fi
set +e
macos_gui_history_require_trust_root "$ROOT_DIR" >/dev/null 2>&1
trust_status=$?
set -e
[ "$trust_status" = 125 ] || {
    echo "unavailable tracked EndpointSecurity trust root was accepted" >&2
    exit 1
}
set +e
(
    unset MACOS_GUI_PROVENANCE_SOURCE_ONLY MACOS_GUI_PROVENANCE_ROOT
    sh "$ROOT_DIR/scripts/check/build-macos-full-cli-gui-provenance.shs" \
        --verify
) >/dev/null 2>&1
producer_status=$?
set -e
[ "$producer_status" = 125 ] || {
    echo "provenance producer did not preserve unavailable status 125" >&2
    exit 1
}
echo "macOS GUI full CLI provenance trust boundary: PASS"
