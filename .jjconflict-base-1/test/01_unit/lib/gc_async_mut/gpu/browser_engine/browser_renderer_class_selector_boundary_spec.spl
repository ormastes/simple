# Class-selector wiring: a `.foo` lookup must resolve to the `.foo` rule and
# only the `.foo` rule.
#
# br_style_block_rule_for_selector matched a rule by asking whether the rule's
# selector list CONTAINS the wanted selector as a raw substring. ".card" is a
# substring of ".card-header", so looking up class `card` merged the
# ".card-header" declarations into the element's style. Merged declarations are
# cascade-ordered, so the later (wrong) rule WON: an element whose only class is
# `card` rendered with .card-header's colour.

use std.spec.*
use std.gc_async_mut.gpu.browser_engine.style_rule_index.{br_style_block_rule_for_class}

fn _doc(rules: text) -> text:
    "<html><head><style>" + rules + "</style></head><body><div class='card'></div></body></html>"

describe "class selector name boundary":

    it "does not merge a longer class rule into a shorter class lookup":
        # `.card-header` is a DIFFERENT class; the element carries only `card`.
        val resolved = br_style_block_rule_for_class(
            _doc(".card { color: blue; } .card-header { color: red; }"), "card"
        )
        expect(resolved).to_contain("blue")
        expect(resolved.contains("red")).to_equal(false)

    it "still resolves the class rule that really matches":
        val resolved = br_style_block_rule_for_class(
            _doc(".card { color: blue; }"), "card"
        )
        expect(resolved).to_contain("blue")
