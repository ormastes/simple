use std.spec.{describe, it, expect}
use std.test_runner.test_runner_helpers.{display_closure_warnings, display_call_graph_warnings}
use compiler.core.closure_analysis.{closure_warnings_clear, closure_warnings_get, closure_warnings_has}
use compiler.core.call_graph.{call_graph_warnings_clear, call_graph_warnings_get, call_graph_warnings_has}

describe "test runner warning display owners":
    it "reads the shared empty warning state from both compiler owners":
        closure_warnings_clear()
        call_graph_warnings_clear()

        display_closure_warnings()
        display_call_graph_warnings()

        expect(closure_warnings_has()).to_be(false)
        expect(closure_warnings_get().len()).to_equal(0)
        expect(call_graph_warnings_has()).to_be(false)
        expect(call_graph_warnings_get().len()).to_equal(0)
