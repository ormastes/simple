# PROBE (read-only): does pkcs7_unpad fail CLOSED on invalid padding?
#
# Determines empirically whether the reported fail-open behaviour of
# pkcs7_unpad is a SOURCE defect or an ENGINE (JIT element-tag) defect.
# See doc/08_tracking/bug/jit_param_passed_list_element_read_returns_tagged_2026-08-08.md

use std.spec.*
use std.common.aes.padding.{pkcs7_pad, pkcs7_unpad}

fn _all_0x99_block() -> [i64]:
    var b: [i64] = []
    var i = 0
    while i < 16:
        b.push(0x99)
        i = i + 1
    b

describe "pkcs7_unpad fail-closed":

    it "rejects a block of 0x99 bytes (invalid padding)":
        val out = pkcs7_unpad(_all_0x99_block(), 16)
        expect(out == nil).to_equal(true)

    it "rejects a trailer whose bytes disagree with the pad length":
        # 14 data bytes + [0x02, 0x03] -> last byte says 3, run is not 3x0x03
        var b: [i64] = []
        var i = 0
        while i < 14:
            b.push(0x41)
            i = i + 1
        b.push(0x02)
        b.push(0x03)
        expect(pkcs7_unpad(b, 16) == nil).to_equal(true)

    it "rejects a non-block-multiple length":
        var b: [i64] = []
        var i = 0
        while i < 15:
            b.push(0x01)
            i = i + 1
        expect(pkcs7_unpad(b, 16) == nil).to_equal(true)

    it "rejects an empty input":
        var e: [i64] = []
        expect(pkcs7_unpad(e, 16) == nil).to_equal(true)

    it "round-trips valid padding":
        var msg: [i64] = []
        var i = 0
        while i < 5:
            msg.push(0x61 + i)
            i = i + 1
        val padded_opt = pkcs7_pad(msg, 16)
        if val padded = padded_opt:
            expect(padded.len()).to_equal(16)
            val back_opt = pkcs7_unpad(padded, 16)
            if val back = back_opt:
                expect(back.len()).to_equal(5)
                expect(back[0]).to_equal(0x61)
            else:
                expect(false).to_equal(true)
        else:
            expect(false).to_equal(true)
