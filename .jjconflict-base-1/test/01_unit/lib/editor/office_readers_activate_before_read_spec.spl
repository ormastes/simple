"""Office readers activate builtins before reading (IDE extension kernel,
lane L-TPH, 2026-07-31).

Proves the MINIMUM seam from doc/08_tracking/bug/
builtin_extensions_activate_eagerly_2026-07-30.md's fix direction #1:
sheets/formula.spl and slides/slide.spl + slides_app.spl call
extension_host_ensure_command_activated(command_id) before consulting their
process-global registry (function_registry.spl / layout_registry.spl), so
the sheets DOUBLE(n) function and the slides title_diagram layout become
reachable from REAL reading (formula evaluation, slide creation) alone --
with no direct call to sheets_ext_register_builtins() /
slides_ext_register_builtins() and no extension host built or activated by
the test itself. This is what makes "a formula needs DOUBLE" a genuine
onCommand: activation event instead of activation-at-construction.
"""

use std.spec.*
use app.office.sheets.spreadsheet.{Sheet}
use app.office.sheets.cell.{cell_display_text}
use app.office.file_formats.{recalculate_formula_cells}
use app.office.sheets.function_registry.{sheet_function_registry_has, sheet_function_registry_reset}
use app.office.slides.slide.{create_slide_from_layout_id}
use app.office.slides.layout_registry.{slide_layout_registry_has, slide_layout_registry_reset}

describe "sheets/slides builtins activate before their process-global registry is read":

    it "DOUBLE becomes reachable from real formula evaluation alone, no manual registration call":
        sheet_function_registry_reset()
        expect(sheet_function_registry_has("DOUBLE")).to_equal(false)

        var sheet = Sheet.new("ActivateBeforeRead")
        sheet.set_value("A1", "9")
        sheet.set_value("B1", "=DOUBLE(A1)")
        sheet = recalculate_formula_cells(sheet)

        expect(cell_display_text(sheet.get_cell("B1"))).to_equal("18")
        expect(sheet_function_registry_has("DOUBLE")).to_equal(true)

    it "title_diagram becomes reachable from real slide creation alone, no manual registration call":
        slide_layout_registry_reset()
        expect(slide_layout_registry_has("title_diagram")).to_equal(false)

        match create_slide_from_layout_id("title_diagram", "s1"):
            case Ok(slide):
                expect(slide.elements.len()).to_equal(2)
            case Err(_):
                expect("create_slide_from_layout_id(title_diagram)").to_equal("should have succeeded")
        expect(slide_layout_registry_has("title_diagram")).to_equal(true)
