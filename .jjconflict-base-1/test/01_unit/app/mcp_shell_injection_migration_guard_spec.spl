use std.io_runtime.{read_file}
use app.mcp.main_lazy_json.{strip_ansi}

describe "MCP shell injection migration guard":
    # This is a narrow source guard, not a complete taint analysis.
    it "rejects known public-field shell command builders in active VCS/query handlers":
        val vcs = read_file("src/app/mcp/main_lazy_vcs_tools.spl")
        val query = read_file("src/app/mcp/main_lazy_query_tools.spl")
        val process_owner = read_file("src/app/mcp/main_lazy_json.spl")

        expect(vcs.contains("shell_cmd(")).to_equal(false)
        expect(query.contains("shell_cmd(cmd)")).to_equal(false)
        expect(query.contains("shell_cmd(\"timeout")).to_equal(false)
        expect(query).to_contain("shell_cmd(summary_cmd)")
        expect(query).to_contain("shell_cmd(count_cmd)")
        expect(query.split("shell_cmd(").len()).to_equal(3)
        expect(process_owner).to_contain('if ch == "\\033" or ch == "\\x1b"')
        expect(process_owner.contains('process_run(shell, ["-c", r"printf')).to_equal(false)

    it "strips CSI without consuming malformed or ordinary text":
        expect(strip_ansi("plain")).to_equal("plain")
        expect(strip_ansi("a\033[31mred\033[0mz")).to_equal("aredz")
        expect(strip_ansi("a\033Xb")).to_equal("aXb")
        expect(strip_ansi("a\033[\nb")).to_equal("a\nb")
        expect(strip_ansi("a\033[31")).to_equal("a")
