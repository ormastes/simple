"""
# Implicit-self field assignment must never silently no-op

Regression spec for
`doc/08_tracking/bug/interp_implicit_self_field_assignment_silent_noop_2026-07-17.md`.

Inside a `me` method, a bare `field = value` (without `self.`) used to fall
through the AST interpreter's *implicit declaration* path: it minted a fresh
local that shadowed the receiver's field, so `self.field` was left untouched
and the program carried on with a silently wrong value.

Every other lane already rejected that shape --- HIR lowering (`unresolved
name`), MIR lowering (`assignment target has no local binding`), native LLVM
codegen (`llvm global store referenced undeclared symbol`), and the
pure-Simple interpreter (`undefined variable`). The seed's AST interpreter
was the sole outlier, and it was *asymmetric* with itself: a bare field READ
already raised E1001 `variable ... not found`, only the WRITE was silent.

`.claude/memory/ref_coding.md` documents the convention as `self.field` in
the body --- "implicit self" means omitting `self` from the *parameter list*,
not from field access --- so the fix makes the write path loud rather than
inventing implicit field resolution.

This spec drives the seed as a subprocess because the corrected behaviour is
a hard error that aborts the program under test; it cannot be observed from
inside the same interpreter run.
"""

use std.spec

extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val SEED: text = "src/compiler_rust/target/bootstrap/simple"
val TMP_DIR: text = "build/test_tmp/implicit_self_field_assign"

fn sh(command: text) -> (text, text, i64):
    return rt_process_run("/bin/sh", ["-c", command])

fn write_case(name: text, body: text) -> text:
    val (_o, _e, _c) = sh("mkdir -p " + TMP_DIR)
    val path = TMP_DIR + "/" + name + ".spl"
    rt_file_write_text(path, body)
    return path

# Runs a fixture through the seed's AST interpreter lane and returns
# (combined stdout+stderr, exit code).
fn run_case(path: text) -> (text, i64):
    val (out, err, code) = sh(
        "SIMPLE_EXECUTION_MODE=interpreter SIMPLE_RUST_SEED_WARNING=0 " + SEED + " run " + path + " 2>&1")
    return (out + err, code)

# Counts matches of `needle` in the fixture's output, entirely inside the
# shell. `text.contains()` is NOT usable here: on a receiver that came back
# through the rt_process_run tuple the method returns a bogus `false` even
# when the substring is present (erased-receiver method dispatch), which
# would make a negative assertion silently vacuous. `grep -c` is honest.
fn output_match_count(path: text, needle: text) -> text:
    val (out, _err, _code) = sh(
        "SIMPLE_EXECUTION_MODE=interpreter SIMPLE_RUST_SEED_WARNING=0 " + SEED + " run " + path
        + " 2>&1 | grep -c " + "'" + needle + "'" + " | tr -d '\\n'")
    return out

val IMPLICIT_SRC: text = "class Probe:\n" +
    "    flag: bool\n" +
    "\n" +
    "    me set_via_implicit():\n" +
    "        flag = true\n" +
    "\n" +
    "fn main():\n" +
    "    var p = Probe(flag: false)\n" +
    "    p.set_via_implicit()\n" +
    "    print(\"IMPLICIT_RESULT=\" + p.flag.to_text())\n"

val EXPLICIT_SRC: text = "class Probe:\n" +
    "    flag: bool\n" +
    "\n" +
    "    me set_via_explicit():\n" +
    "        self.flag = true\n" +
    "\n" +
    "fn main():\n" +
    "    var p = Probe(flag: false)\n" +
    "    p.set_via_explicit()\n" +
    "    print(\"EXPLICIT_RESULT=\" + p.flag.to_text())\n"

# A bare assignment to a name that is NOT a field must keep working as an
# ordinary implicit local --- the fix must not ban implicit declaration
# generally, only the field-shadowing case.
val PLAIN_LOCAL_SRC: text = "class Probe:\n" +
    "    flag: bool\n" +
    "\n" +
    "    me compute() -> i64:\n" +
    "        scratch = 41\n" +
    "        return scratch + 1\n" +
    "\n" +
    "fn main():\n" +
    "    var p = Probe(flag: false)\n" +
    "    print(\"PLAIN_RESULT=\" + p.compute().to_text())\n"

describe "implicit-self field assignment in a me method":
    """
    Drives three single-purpose fixtures through the seed interpreter: the
    bare field assignment that used to vanish, the explicit `self.` form that
    must keep working, and a bare non-field local that must stay legal.
    """

    it "rejects a bare field assignment instead of silently discarding it":
        val path = write_case("implicit", IMPLICIT_SRC)
        val (_output, code) = run_case(path)
        # The core regression: the old build exited 0 having printed
        # IMPLICIT_RESULT=false, i.e. the mutation was silently dropped.
        assert_not_equal(code, 0)

    it "never reports the silently-unmutated field value":
        val path = write_case("implicit_value", IMPLICIT_SRC)
        assert_equal(output_match_count(path, "IMPLICIT_RESULT=false"), "0")

    it "names the shadowed field and points at the self. form":
        val path = write_case("implicit_msg", IMPLICIT_SRC)
        val (output, _code) = run_case(path)
        assert_contains(output, "is a field of")
        assert_contains(output, "self.flag")

    it "still applies an explicit self.field assignment":
        val path = write_case("explicit", EXPLICIT_SRC)
        val (output, code) = run_case(path)
        assert_contains(output, "EXPLICIT_RESULT=true")
        assert_equal(code, 0)

    it "leaves a bare non-field local assignment working":
        val path = write_case("plain_local", PLAIN_LOCAL_SRC)
        val (output, code) = run_case(path)
        assert_contains(output, "PLAIN_RESULT=42")
        assert_equal(code, 0)
