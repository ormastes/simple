"""
# Staged SSA Local Payload Contract

Keeps nested MirOperand LocalId decoding inside the SSA module so staged-native
value-type payloads do not cross the var-reassign module boundary as nil.
"""

extern fn rt_file_read_text(path: text) -> text

describe "Staged SSA Local Payload":
    it "decodes copy and move operands with the local SSA helper":
        val source = rt_file_read_text(
            "src/compiler/60.mir_opt/mir_opt/var_reassign_ssa.spl") ?? ""
        expect(source).to_contain(
            "local_list_push_unique(locals, ssa_local_id_value(local))")
        expect(source).to_not_contain(
            "local_list_push_unique(locals, var_reassign_local_id_value(local))")
        expect(source).to_contain(
            "if not ssa_inst_operand_payloads_valid(inst):")
        expect(source).to_contain(
            "case Copy(local): local != nil")
