use compiler.backend.cuda.ptx_builder.PtxBuilder
use compiler.backend.common.type_mapper.PrimitiveType
use compiler.hir.hir_types.MemorySpace

describe "CUDA PTX builder atomic contract":
    it "emits global add without a CUDA device":
        var builder = PtxBuilder__create((8, 6))
        builder.emit_atomic_add("%r0", PrimitiveType.U32, "%addr", "%value", MemorySpace.Global)
        expect(builder.build()).to_contain("atom.global.add.u32 %r0, [%addr], %value;")

    it "emits shared compare-and-swap without a CUDA device":
        var builder = PtxBuilder__create((8, 6))
        builder.emit_atomic_cas("%r0", PrimitiveType.U32, "%addr", "%expected", "%desired", MemorySpace.Shared)
        expect(builder.build()).to_contain("atom.shared.cas.b32 %r0, [%addr], %expected, %desired;")
