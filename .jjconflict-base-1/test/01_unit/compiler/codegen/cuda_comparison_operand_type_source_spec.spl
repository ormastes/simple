# @cover src/compiler/70.backend/backend/cuda_backend.spl 5%
# @tag: unit, compiler, gpu, cuda, source-contract

extern fn rt_file_read_text(path: text) -> text

describe "CUDA comparison operand type source contract":
    it "derives comparison suffixes from matching operands":
        val source = rt_file_read_text(
            "src/compiler/70.backend/backend/cuda_backend.spl"
        ) ?? ""

        expect(source).to_contain("if dest_ty != PrimitiveType.Bool:")
        expect(source).to_contain("CUDA comparison destination must be Bool")
        expect(source).to_contain("val left_ty = self.operand_primitive_type(func, left)?")
        expect(source).to_contain(
            "if self.operand_primitive_type(func, right)? != left_ty:"
        )
        expect(source).to_contain("CUDA comparison operand types must match")
        expect(source).to_contain("case I32 | I64 | U32 | U64 | F32 | F64: ()")
        expect(source).to_contain(
            "self.compile_binop(builder, dest, op, left, right, op_ty)"
        )
