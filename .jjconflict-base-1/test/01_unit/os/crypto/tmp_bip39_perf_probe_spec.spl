use std.spipe.*
use os.crypto.bip39.{bip39_entropy_to_mnemonic, bip39_mnemonic_to_entropy}

fn _e16() -> [u8]:
    var r: [u8] = []
    var i = 0
    while i < 16:
        r.push(0)
        i = i + 1
    r

describe "BIP-39 non-PBKDF2 path":
    it "entropy to mnemonic round trip (exercises wordlist lookup)":
        val m = bip39_entropy_to_mnemonic(_e16())
        match m:
            Ok(txt):
                val back = bip39_mnemonic_to_entropy(txt)
                match back:
                    Ok(e): expect(e.len()).to_equal(16)
                    Err(_): expect("err").to_equal("ok")
            Err(_):
                expect("err").to_equal("ok")
