"""Plain runnable probe for rt_renderdoc_* honesty, out-of-process per engine.

A `*_spec.spl` (describe/it) never reaches the Cranelift JIT or a native
build -- `describe`/`it`/`expect` are interpreter-only intrinsics with no
codegen lowering (see `src/lib/nogc_sync_mut/spec/engine_probe.spl`). This
probe has `fn main`, so `renderdoc_honesty_spec.spl` can spawn it under a
NAMED engine (`std.spec.engine_probe.engine_stdout`) and assert on its
printed verdict line instead of asserting in-process. Score by the verdict
line, not the exit code.
"""

extern fn rt_renderdoc_available() -> i64
extern fn rt_renderdoc_set_capture_file_path_template(path: text) -> i64
extern fn rt_renderdoc_is_frame_capturing() -> i64
extern fn rt_renderdoc_start_capture() -> i64
extern fn rt_renderdoc_start_capture_for_device(device: i64) -> i64
extern fn rt_renderdoc_end_capture() -> i64
extern fn rt_renderdoc_end_capture_for_device(device: i64) -> i64
extern fn rt_renderdoc_num_captures() -> i64

fn main():
    val available = rt_renderdoc_available()
    val num_captures = rt_renderdoc_num_captures()
    val start = rt_renderdoc_start_capture()
    val end_v = rt_renderdoc_end_capture()
    val start_dev = rt_renderdoc_start_capture_for_device(4242)
    val end_dev = rt_renderdoc_end_capture_for_device(4242)
    val capturing = rt_renderdoc_is_frame_capturing()
    val set_path = rt_renderdoc_set_capture_file_path_template("build/renderdoc_honesty_probe")
    print "RDOC_PROBE available={available} num_captures={num_captures} start={start} end={end_v} start_dev={start_dev} end_dev={end_dev} capturing={capturing} set_path={set_path}"
