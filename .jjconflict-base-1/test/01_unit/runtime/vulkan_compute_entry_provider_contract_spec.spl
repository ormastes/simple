# @cover src/compiler_rust/runtime/src/vulkan_graphics_runtime_shader.rs 20%
# @cover src/compiler_rust/runtime/src/vulkan/pipeline.rs 10%
# @tag: unit, runtime, gpu, vulkan, source-contract

extern fn rt_file_read_text(path: text) -> text

describe "Vulkan native compute entry provider contract":
    it "passes the exact requested entry into native pipeline creation":
        val provider = rt_file_read_text(
            "src/compiler_rust/runtime/src/vulkan_graphics_runtime_shader.rs"
        ) ?? ""
        val pipeline = rt_file_read_text(
            "src/compiler_rust/runtime/src/vulkan/pipeline.rs"
        ) ?? ""

        expect(provider).to_contain("let entry_name = match runtime_entry_name(entry)")
        expect(provider).to_contain(
            "ComputePipeline::new(device, &spirv_owned, &entry_name, push_size as u32)"
        )
        expect(provider).to_contain("if !(0..=u32::MAX as i64).contains(&push_size)")
        expect(pipeline).to_contain("entry_name: &str")
        expect(pipeline).to_contain("let entry_name = compute_entry_name(entry_name)?")
        expect(pipeline).to_contain(".name(&entry_name)")
        expect(pipeline.contains("CString::new(\"main\")")).to_equal(false)
        expect(pipeline).to_contain("struct ComputePipelineBuildGuard")
        expect(pipeline).to_contain("impl Drop for ComputePipelineBuildGuard")
        expect(pipeline).to_contain(
            "validate_push_constant_size(push_constant_size, device.max_push_constant_size())?"
        )

    it "keeps the legacy kernel API explicitly on main":
        val legacy = rt_file_read_text(
            "src/compiler_rust/runtime/src/value/gpu_vulkan/vulkan_sffi/kernel.rs"
        ) ?? ""

        expect(legacy).to_contain(
            "ComputePipeline::new(device.clone(), spirv_bytes, \"main\", 0)"
        )

    it "passes all three arguments through dynamic Engine2D providers":
        val sffi = rt_file_read_text(
            "src/lib/nogc_sync_mut/gpu/engine2d/sffi_vulkan.spl"
        ) ?? ""
        val ffi = rt_file_read_text(
            "src/lib/nogc_sync_mut/gpu/engine2d/ffi_vulkan.spl"
        ) ?? ""
        val call = "call3(\"rt_vulkan_create_compute_pipeline\", shader, entry_z.ptr(), pc_size)"

        expect(sffi).to_contain(call)
        expect(ffi).to_contain(call)
        expect(sffi).to_contain("val entry_z = entry + \"\\0\"")
        expect(ffi).to_contain("val entry_z = entry + \"\\0\"")
        expect(sffi).to_contain("if entry == \"\" or entry.contains(\"\\0\"):")
        expect(ffi).to_contain("if entry == \"\" or entry.contains(\"\\0\"):")
        expect(sffi.contains("call2(\"rt_vulkan_create_compute_pipeline\"")).to_equal(false)
        expect(ffi.contains("call2(\"rt_vulkan_create_compute_pipeline\"")).to_equal(false)
