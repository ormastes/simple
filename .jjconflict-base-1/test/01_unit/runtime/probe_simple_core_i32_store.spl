extern fn rt_alloc(size: i64) -> i64
extern fn rt_free(ptr: i64)
extern fn rt_memset(ptr: i64, value: i64, size: i64) -> i64
extern fn rt_ptr_read_i64(addr: i64, offset: i64) -> i64
extern fn rt_ptr_write_i32(addr: i64, offset: i64, value: i64) -> i64

fn main() -> i64:
    val address = rt_alloc(8)
    if address == 0:
        return 1
    rt_memset(address, 0x7a, 8)
    rt_ptr_write_i32(address, 2, 0x11223344)
    val actual = rt_ptr_read_i64(address, 0)
    rt_free(address)
    if actual != 0x7a7a112233447a7a:
        return 2
    0
