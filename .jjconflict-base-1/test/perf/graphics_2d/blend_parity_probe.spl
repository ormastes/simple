"""Blend-parity probe: native row kernel vs `_scalar_blend_row`.

`simd_kernels.spl` claims the native path is "bit-identical to
_scalar_blend_row (same floor /255)". This prints every disagreement so the
claim can be checked instead of trusted. Run with SIMPLE_2D_SIMD unset.
"""

use std.nogc_sync_mut.gpu.engine2d.simd_kernels.{simd_blend_row, _scalar_blend_row, native_pixel_rows_enabled}

fn main():
    println("native_rows=" + native_pixel_rows_enabled().to_text())
    var diffs: i64 = 0
    var shown: i64 = 0
    var sa: i64 = 0
    while sa <= 255:
        var da: i64 = 0
        while da <= 255:
            val s = ((sa << 24) | (0x40 << 16) | (0x80 << 8) | 0xC0) as u32
            val d = ((da << 24) | (0x10 << 16) | (0x20 << 8) | 0x30) as u32
            var a: [u32] = [d; 1]
            var b: [u32] = [d; 1]
            val src: [u32] = [s; 1]
            simd_blend_row(a, src, 0, 1)
            _scalar_blend_row(b, src, 0, 1)
            if a[0] != b[0]:
                diffs = diffs + 1
                if shown < 8:
                    println("DIFF sa=" + sa.to_text() + " da=" + da.to_text() + " simd=" + a[0].to_text() + " scalar=" + b[0].to_text())
                    shown = shown + 1
            da = da + 17
        sa = sa + 17
    println("PARITY_DIFFS=" + diffs.to_text())
