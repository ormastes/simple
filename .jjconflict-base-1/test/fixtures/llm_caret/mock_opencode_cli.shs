#!/bin/sh

if [ "$#" -ne 11 ] ||
   [ "$1" != "run" ] ||
   [ "$2" != "--format" ] ||
   [ "$3" != "json" ] ||
   [ "$4" != "--model" ] ||
   [ "$5" != "anthropic/claude" ] ||
   [ "$6" != "--session" ] ||
   [ "$7" != "session-in" ] ||
   [ "$8" != "--attach" ] ||
   [ "$9" != "http://127.0.0.1:4096" ] ||
   [ "${10}" != "--fixture-extra" ] ||
   [ "${11}" != "fixture-success" ]; then
    printf '%s\n' 'unexpected OpenCode fixture arguments' >&2
    exit 64
fi

printf '%s\n' '{"content":"fixture-ok","sessionID":"session-out"}'
