# Source-matched pure-Simple ML-KEM-768 oracle probe.
# This intentionally uses ordinary Simple control flow rather than SPipe DSL so
# native-build evidence does not depend on the bootstrap seed's spec rewriter.

use os.crypto.ml_kem.{ml_kem_keygen_checked, ml_kem_encaps_checked,
    ml_kem_decaps_checked}
use os.crypto.sha256.{sha256}

fn _seed(hex: text) -> list:
    var out: list = []
    var i: i64 = 0
    while i < hex.len():
        val hi_code = hex.char_code_at(i)
        val lo_code = hex.char_code_at(i + 1)
        val hi = if hi_code <= 57: hi_code - 48 else: hi_code - 87
        val lo = if lo_code <= 57: lo_code - 48 else: lo_code - 87
        out.push(hi * 16 + lo)
        i = i + 2
    out

fn _bytes(values: list) -> [u8]:
    var out: [u8] = []
    var i: i64 = 0
    while i < values.len():
        out.push(values.get(i).to_u8())
        i = i + 1
    out

fn _hex_digit(value: i64) -> text:
    if value < 10: value.to_text()
    elif value == 10: "a"
    elif value == 11: "b"
    elif value == 12: "c"
    elif value == 13: "d"
    elif value == 14: "e"
    else: "f"

fn _digest(values: list) -> text:
    val digest = sha256(_bytes(values))
    var out = ""
    var i: i64 = 0
    while i < digest.len().to_i64():
        val value = digest[i].to_i64()
        out = out + _hex_digit((value >> 4) & 15) + _hex_digit(value & 15)
        i = i + 1
    out

fn main() -> i64:
    val d = _seed("934d60b35624d740b30a7f227af2ae7c678e4e04e13c5f509eade2b79aea77e2")
    val z = _seed("3e2a2ea6c9c476fc4937b013c993a793d6c0ab9960695ba838f649da539ca3d0")
    val pair = match ml_kem_keygen_checked(d, z):
        case Ok(value): value
        case Err(reason):
            print "x25519mlkem768_probe=fail phase=keygen reason={reason}"
            return 10
    val (ek, dk) = pair
    if _digest(ek) != "c45a699a9efcb1a799578ce95f24b063b0b9ddc0879afdb3967fd9e1e3e8c247":
        print "x25519mlkem768_probe=fail phase=encapsulation-key"
        return 11
    if _digest(dk) != "1dc4ab0188bfd90b41bbd91884e40a41ccd0f46e5d3754b615373c9656f6af39":
        print "x25519mlkem768_probe=fail phase=decapsulation-key"
        return 12
    val encapsulated = match ml_kem_encaps_checked(ek, d):
        case Ok(value): value
        case Err(reason):
            print "x25519mlkem768_probe=fail phase=encapsulation reason={reason}"
            return 13
    val (shared, ciphertext) = encapsulated
    if _digest(ciphertext) != "0b99b2af81971943e4ef6e6f17f42be4f3caa9fea18da0f63df1d43639a74743":
        print "x25519mlkem768_probe=fail phase=ciphertext"
        return 14
    if _digest(shared) != "340f07be0ffe3d996f44bb05f10eecaca6f494c77a3c353cb1872cacb834f596":
        print "x25519mlkem768_probe=fail phase=shared-secret"
        return 15
    val recovered = match ml_kem_decaps_checked(dk, ciphertext):
        case Ok(value): value
        case Err(reason):
            print "x25519mlkem768_probe=fail phase=decapsulation reason={reason}"
            return 16
    if _digest(recovered) != "340f07be0ffe3d996f44bb05f10eecaca6f494c77a3c353cb1872cacb834f596":
        print "x25519mlkem768_probe=fail phase=recovered-secret"
        return 17
    print "x25519mlkem768_probe=pass oracle=mlkem-native-fd58 outputs=4704"
    0
