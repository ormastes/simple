"""Native same-name method dispatch regression."""

use std.spec.*
use std.io_runtime.{dir_create_all, file_write, remove_file_if_exists, shell}

val BUILD_DIR = "build/native_same_name_has_dispatch"
val ENTRY_PATH = BUILD_DIR + "/main.spl"
val BINARY_PATH = BUILD_DIR + "/main"
val CACHE_DIR = BUILD_DIR + "/cache"

fn write_same_name_has_fixture() -> bool:
    val source = r"""class CustomLookup:
    expected: text

impl CustomLookup:
    fn has(key: text) -> bool:
        key == self.expected

fn main():
    var values: Dict<text, i64> = {}
    values["dict"] = 1
    val custom = CustomLookup(expected: "custom")
    print(values.has("dict"))
    print(custom.has("custom"))
"""
    dir_create_all(BUILD_DIR) and
        file_write(ENTRY_PATH, source) and
        remove_file_if_exists(BINARY_PATH)

fn run_same_name_has_native_probe() -> text:
    val compiled = shell(
        "env -u SIMPLE_BOOTSTRAP -u SIMPLE_RUNTIME_PATH SIMPLE_NO_STUB_FALLBACK=1 " +
        "bin/simple native-build --entry " + ENTRY_PATH +
        " --entry-closure --cache-dir " + CACHE_DIR + " -o " + BINARY_PATH
    )
    if compiled.exit_code != 0:
        return "compile-failed:" + compiled.stderr
    val result = shell(BINARY_PATH)
    if result.exit_code != 0:
        return "run-failed:" + result.stderr
    result.stdout

describe "native same-name has dispatch":
    it "keeps Dict and custom receivers on their own implementations":
        expect(write_same_name_has_fixture()).to_equal(true)
        expect(run_same_name_has_native_probe()).to_equal("truetrue")
