use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.frontend.parser_types_expr.{Expr, ExprKind, Type, TypeKind, parser_type_named_dependencies}
use compiler.frontend.parser_types.{ParserField, Variant, VariantKind, parser_variant_named_dependencies}

extern fn rt_exit(code: i32)

fn ty(kind: TypeKind) -> Type:
    Type(kind: kind, span: Span.empty())

fn named(name: text) -> Type:
    ty(TypeKind.Named(name, []))

fn nil_expr() -> Expr:
    Expr(kind: ExprKind.NilLit, span: Span.empty())

fn field(name: text, type_: Type) -> ParserField:
    ParserField(name: name, type_: type_, has_default: false,
        default: nil_expr(), visibility: Visibility.Private, is_public: false,
        is_volatile: false, has_bits: false, bits: 0,
        has_fixed_address: false, fixed_address: 0, span: Span.empty())

fn variant(name: text, kind: VariantKind) -> Variant:
    Variant(name: name, kind: kind, has_discriminant: false,
        discriminant: nil_expr(), span: Span.empty())

fn require_names(actual: [text], expected: [text], code: i32):
    if actual.len() != expected.len(): rt_exit(code)
    var i = 0
    while i < expected.len():
        if actual[i] != expected[i]: rt_exit(code)
        i = i + 1

fn main() -> i64:
    require_names(parser_type_named_dependencies(ty(TypeKind.Named("Envelope", [
        named("Key"), ty(TypeKind.Named("Vector", [named("Item")]))
    ]))), ["Envelope", "Key", "Vector", "Item"], 40)
    require_names(parser_type_named_dependencies(ty(TypeKind.Tuple([
        named("Tuple"), ty(TypeKind.Optional(named("TupleOptional")))
    ]))), ["Tuple", "TupleOptional"], 41)
    require_names(parser_type_named_dependencies(ty(TypeKind.Array(named("Array"), nil))), ["Array"], 42)
    require_names(parser_type_named_dependencies(ty(TypeKind.Function([
        named("Param"), ty(TypeKind.Reference(named("Ref"), false))
    ], named("Return")))), ["Param", "Ref", "Return"], 43)
    require_names(parser_type_named_dependencies(ty(TypeKind.Optional(named("Optional")))), ["Optional"], 44)
    require_names(parser_type_named_dependencies(ty(TypeKind.Reference(named("Reference"), true))), ["Reference"], 45)
    require_names(parser_type_named_dependencies(ty(TypeKind.Atomic(named("Atomic")))), ["Atomic"], 46)
    require_names(parser_type_named_dependencies(ty(TypeKind.Isolated(named("Isolated")))), ["Isolated"], 47)
    require_names(parser_type_named_dependencies(ty(TypeKind.Union([
        named("Left"), ty(TypeKind.Pointer(named("Right"), false))
    ]))), ["Left", "Right"], 48)
    require_names(parser_type_named_dependencies(ty(TypeKind.Projection(
        ty(TypeKind.Named("Base", [named("Arg")])), "Item"))), ["Base", "Arg"], 49)
    require_names(parser_type_named_dependencies(ty(TypeKind.Pointer(named("Pointer"), true))), ["Pointer"], 50)
    require_names(parser_type_named_dependencies(ty(TypeKind.Infer)), [], 51)
    require_names(parser_type_named_dependencies(ty(TypeKind.Error)), [], 52)

    require_names(parser_variant_named_dependencies(variant("Tuple", VariantKind.Tuple([
        named("TuplePayload"), ty(TypeKind.Optional(named("TupleOptionalPayload")))
    ]))), ["TuplePayload", "TupleOptionalPayload"], 53)
    require_names(parser_variant_named_dependencies(variant("Struct", VariantKind.Struct([
        field("items", ty(TypeKind.Array(named("StructArray"), nil))),
        field("callback", ty(TypeKind.Function([named("StructParam")], named("StructReturn"))))
    ]))), ["StructArray", "StructParam", "StructReturn"], 54)
    require_names(parser_variant_named_dependencies(variant("Unit", VariantKind.Unit)), [], 55)
    rt_exit(30)
    0
