extern fn rt_file_read_text(path: text) -> text

class BootLogger:
    level: i64

    static fn from_env() -> BootLogger:
        BootLogger(level: 0)

    fn debug(message: text):
        if self.level >= 4:
            print "[boot][debug] {message}"

    fn info(message: text):
        if self.level >= 3:
            print "[boot][info] {message}"

    fn warn(message: text):
        if self.level >= 2:
            print "[boot][warn] {message}"

    fn error(message: text):
        if self.level >= 1:
            print "[boot][error] {message}"

    fn trace(message: text):
        if self.level >= 5:
            print "[boot][trace] {message}"

fn source_file_coverage_identity(path: text, raw_content: text) -> (text, text):
    """Recover the authored identity carried by a reserved coverage wrapper."""
    val normalized_path = path.replace("\\", "/")
    val slash = normalized_path.last_index_of("/")
    val basename = if slash >= 0: normalized_path[slash + 1:] else: normalized_path
    if not basename.starts_with("simple_cov_") and not basename.starts_with("spipe_wrapped_"):
        return (path, raw_content)
    val newline = raw_content.index_of("\n")
    if newline <= 0:
        return (path, raw_content)
    val marker = "# simple-coverage-source: "
    val first_line = raw_content[0:newline]
    if not first_line.starts_with(marker):
        return (path, raw_content)
    val original_path = first_line[marker.len():]
    if original_path == "" or original_path != original_path.trim() or original_path.contains("\r"):
        return (path, raw_content)
    (original_path, raw_content[newline + 1:])

struct SourceFile:
    path: text
    authored_path: text = ""
    content: text
    module_name: text

    static fn load(path: text) -> Result<SourceFile, text>:
        var content = rt_file_read_text(path) ?? ""
        if content == "":
            return Err("Failed to read file: {path}")

        val (authored_path, source_content) = source_file_coverage_identity(path, content)
        content = source_content

        var mod_path = path
        if mod_path.starts_with("src/"):
            mod_path = mod_path.substring(4)
        mod_path = mod_path.replace(".spl", "")
        mod_path = mod_path.replace(".sdn", "")
        val module_name = mod_path.replace("/", ".")
        if module_name.starts_with("compiler.10.frontend.core."):
            val _ = module_name
        Ok(SourceFile(
            path: path,
            authored_path: authored_path,
            content: content,
            module_name: module_name
        ))

fn source_file_authored_path(source: SourceFile) -> text:
    if source.authored_path != "": source.authored_path else: source.path
