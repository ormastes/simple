use compiler.common.driver_core_types.{CompileResult}
use compiler.driver.driver_public_shared.{find_simple_binary, clean_child_output, check_compile_delegation_guard, mark_compile_delegated}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_file_exists(path: text) -> bool

pub fn aot_file(path: text, output: text) -> CompileResult:
    run_compile_to_path(path, output, ["--native"])

pub fn aot_c_file(path: text, output: text) -> CompileResult:
    run_compile_to_path(path, output, ["--backend=c"])

pub fn aot_llvm_file(path: text, output: text) -> CompileResult:
    run_compile_to_path(path, output, ["--backend=llvm"])

pub fn aot_llvm_native_file(path: text, output: text) -> CompileResult:
    run_compile_to_path(path, output, ["--backend=llvm", "--native"])

pub fn aot_native_file_with_backend(path: text, output: text, backend: text, release: bool, opt_level: i64) -> CompileResult:
    var flags = ["--backend={backend}", "--native", "--opt-level={opt_level}"]
    if release:
        flags = flags.push("--release")
    run_compile_to_path(path, output, flags)

pub fn aot_native_project_with_backend(source_dirs: [text], entry: text, output: text, backend: text, strip: bool, release: bool, opt_level: i64) -> CompileResult:
    CompileResult.RuntimeError("lightweight external aot_native_project_with_backend is not supported; use the CLI directly for multi-source native builds")

pub fn aot_cuda_file(path: text, output: text) -> CompileResult:
    run_compile_to_path(path, output, ["--backend=cuda"])

pub fn aot_opencl_file(path: text, output: text) -> CompileResult:
    run_compile_to_path(path, output, ["--backend=opencl"])

fn describe_extra_args(extra_args: [text]) -> text:
    if extra_args.len() == 0:
        return "compile"
    var parts: [text] = []
    for extra_arg in extra_args:
        if extra_arg.starts_with("--"):
            parts = parts.push(extra_arg.substring(2))
        else:
            parts = parts.push(extra_arg)
    parts.join(" ")

pub fn run_compile_to_path(path: text, output: text, extra_args: [text]) -> CompileResult:
    val simple_bin = find_simple_binary()
    val guard_error = check_compile_delegation_guard(describe_extra_args(extra_args), simple_bin)
    if guard_error != "":
        return CompileResult.RuntimeError(guard_error)
    mark_compile_delegated()
    var args = ["compile", path]
    var i = 0
    while i < extra_args.len():
        args = args.push(extra_args[i])
        i = i + 1
    args = args.push("-o")
    args = args.push(output)

    val (stdout, stderr, exit_code) = rt_process_run(simple_bin, args)
    val combined = clean_child_output(stdout, stderr)
    if exit_code == 0 and rt_file_exists(output):
        return CompileResult.Success(output)
    if exit_code == 0:
        return CompileResult.RuntimeError("compile reported success but did not create output: {output}")
    CompileResult.RuntimeError(combined)
