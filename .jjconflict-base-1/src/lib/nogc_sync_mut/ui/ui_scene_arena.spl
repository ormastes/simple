# Unified Packed UI Scene — session arena: allocate-once buffers, front/back
# generations with a completion-gated swap (design §3).
#
# Design authority: `doc/05_design/ui/unified_packed_ui_scene.md` §3.
# Lane: L5 (`doc/03_plan/ui/unified_packed_ui_scene_agent_lanes.md`).
#
# `UiSceneArena` is allocated ONCE per session from a
# `UiSceneCapacityExtensionV1`: every front/back column array is pre-sized at
# construction and never rebuilt from scratch afterward — `try_swap()`
# exchanges the front/back array VALUES directly (both are the arena's own
# top-level fields), it never calls the capacity-sizing constructor again.
# `alloc_count()` exposes exactly how many times that constructor ran, so a
# regression that reallocates per generation is observable in-band.
#
# IMPORTANT — verified interpreter behavior (`bin/simple test`, tree-walk
# interpreter; this is what the gate for this spec runs on, see
# `.claude/rules/testing.md` "run and test are DIFFERENT ENGINES"): a class
# instance stored as a FIELD of another class is captured BY VALUE at the
# point of assignment (constructor or field-set) — later mutations performed
# through the ORIGINAL variable are NOT visible through the field, and
# mutations performed through the field are NOT visible through the original
# variable. Confirmed by direct probe (5 minimal cases; the JIT/seed path
# reached via `bin/simple run` does NOT show this, only the interpreter
# does). Reading/mutating THROUGH the SAME holder consistently (one method
# writes `self.x`, another method on the same instance reads `self.x`) DOES
# work, and passing a class instance as a plain FUNCTION parameter and
# mutating it directly within that call DOES propagate back to the caller.
# Consequence for this file: `UiSceneArena` keeps every column as its OWN
# top-level field (no nested "generation buffer" class) so every mutation is
# a single self-level write; `draw_ir_v3_native_writer.spl`'s writers are
# self-contained (they do not store an `arena` field) and a caller commits
# their output into this arena via a free function that receives BOTH the
# arena and the writer as fresh parameters in the same call.

use common.ui.draw_ir_v3.{
    DRAW_IR_V3_NO_ID,
    DrawIrV3Command,
    DrawIrV3Geometry,
    DrawIrV3Paint,
    DrawIrV3TextRun,
    DrawIrV3Glyph,
    DrawIrV3Resource,
    DrawIrV3PathSpan,
    DrawIrV3PathPoint,
    DrawIrV3Clip,
    DrawIrV3Transform,
    DrawIrV3HitShape,
    DrawIrV3Provenance,
    draw_ir_v3_empty_command
}
use common.ui.ui_scene_counts.{
    UiSceneCapacityExtensionV1,
    UI_SCENE_TABLE_COMMANDS,
    UI_SCENE_TABLE_GEOMETRY,
    UI_SCENE_TABLE_PAINT,
    UI_SCENE_TABLE_TEXT_RUNS,
    UI_SCENE_TABLE_GLYPHS,
    UI_SCENE_TABLE_RESOURCES,
    UI_SCENE_TABLE_PATH_SPANS,
    UI_SCENE_TABLE_PATH_POINTS,
    UI_SCENE_TABLE_CLIPS,
    UI_SCENE_TABLE_TRANSFORMS,
    UI_SCENE_TABLE_HIT_SHAPES,
    UI_SCENE_TABLE_PROVENANCE_EDGES,
    UI_SCENE_TABLE_OWNER_RECORDS,
    UI_SCENE_TABLE_ACTION_BINDINGS,
    ui_scene_capacity_max_rows_at
}
use common.ui.ui_scene_owner_table.{UiOwnerRecord, MenuActionBinding}
use common.ui.draw_ir_v3_ports.{DRAW_IR_V3_CAP_COMPUTE_PASSES}
use common.ui.draw_ir_v3_ports_v2.{
    PackedSceneRef,
    Prepared2DRef,
    DirtyRangeRef,
    DrawIrV3SubmitReceipt,
    PackedDrawPortV2,
    DRAW_IR_V3_PORT_V2_REASON_OK,
    DRAW_IR_V3_PORT_V2_REASON_STALE_GENERATION
}

# =========================================================================
# Zero/empty row constructors for the eleven view-row types that
# `draw_ir_v3.spl` does not already provide an empty constructor for
# (it provides one only for `DrawIrV3Command`). `present: false` marks a
# pre-fill slot as not-yet-written, mirroring the v2 `.present` convention
# noted in `draw_ir_v3.spl`.
# =========================================================================

fn _empty_geometry_row() -> DrawIrV3Geometry:
    DrawIrV3Geometry(present: false, x: 0i32, y: 0i32, width: 0i32, height: 0i32, corner_radius: 0i32)

fn _empty_paint_row() -> DrawIrV3Paint:
    DrawIrV3Paint(
        present: false, fill_color: 0u32, stroke_color: 0u32,
        stroke_width_milli: 0i32, opacity_milli: 0i32, blend_mode: 0u16
    )

fn _empty_text_run_row() -> DrawIrV3TextRun:
    DrawIrV3TextRun(
        present: false, glyph_start: 0u32, glyph_count: 0u32,
        font_resource_id: 0u32, font_size_milli: 0i32,
        baseline_x: 0i32, baseline_y: 0i32, color: 0u32
    )

fn _empty_glyph_row() -> DrawIrV3Glyph:
    DrawIrV3Glyph(present: false, glyph_id: 0u32, x: 0i32, y: 0i32, cluster: 0i64)

fn _empty_resource_row() -> DrawIrV3Resource:
    DrawIrV3Resource(present: false, kind: 0u16, format: 0u32, width: 0u32, height: 0u32, content_hash: 0i64)

fn _empty_path_span_row() -> DrawIrV3PathSpan:
    DrawIrV3PathSpan(present: false, point_start: 0u32, point_count: 0u32, fill_rule: 0u16)

fn _empty_path_point_row() -> DrawIrV3PathPoint:
    DrawIrV3PathPoint(present: false, x: 0i32, y: 0i32, verb: 0u16)

fn _empty_clip_row() -> DrawIrV3Clip:
    DrawIrV3Clip(
        present: false, x: 0i32, y: 0i32, width: 0i32, height: 0i32,
        corner_radius: 0i32, parent_id: DRAW_IR_V3_NO_ID
    )

fn _empty_transform_row() -> DrawIrV3Transform:
    DrawIrV3Transform(present: false, m11: 0i32, m12: 0i32, m21: 0i32, m22: 0i32, dx: 0i32, dy: 0i32)

fn _empty_hit_shape_row() -> DrawIrV3HitShape:
    DrawIrV3HitShape(
        present: false, x: 0i32, y: 0i32, width: 0i32, height: 0i32,
        shape_kind: 0u16, hit_flags: 0u16, component_id: DRAW_IR_V3_NO_ID
    )

fn _empty_provenance_row() -> DrawIrV3Provenance:
    DrawIrV3Provenance(
        present: false, command_index: DRAW_IR_V3_NO_ID, edge_kind: 0u16,
        source_node_id: 0u32, source_rule_id: 0u32, source_span_start: 0u32, source_span_len: 0u32
    )

fn _empty_owner_row() -> UiOwnerRecord:
    UiOwnerRecord(
        producer_kind: 0u16, event_policy: 0u16, semantic_id: 0u32,
        semantic_generation: 0u32, parent_owner_id: DRAW_IR_V3_NO_ID,
        action_binding_id: DRAW_IR_V3_NO_ID
    )

fn _empty_action_row() -> MenuActionBinding:
    MenuActionBinding(
        app_id: 0u32, app_generation: 0u32, menu_revision: 0u32,
        action_id: 0u32, default_target_owner_id: DRAW_IR_V3_NO_ID
    )

fn _sized_commands(n: u32) -> [DrawIrV3Command]:
    var out: [DrawIrV3Command] = []
    var i = 0u32
    while i < n:
        out.push(draw_ir_v3_empty_command())
        i = i + 1u32
    out

fn _sized_geometry(n: u32) -> [DrawIrV3Geometry]:
    var out: [DrawIrV3Geometry] = []
    var i = 0u32
    while i < n:
        out.push(_empty_geometry_row())
        i = i + 1u32
    out

fn _sized_paint(n: u32) -> [DrawIrV3Paint]:
    var out: [DrawIrV3Paint] = []
    var i = 0u32
    while i < n:
        out.push(_empty_paint_row())
        i = i + 1u32
    out

fn _sized_text_runs(n: u32) -> [DrawIrV3TextRun]:
    var out: [DrawIrV3TextRun] = []
    var i = 0u32
    while i < n:
        out.push(_empty_text_run_row())
        i = i + 1u32
    out

fn _sized_glyphs(n: u32) -> [DrawIrV3Glyph]:
    var out: [DrawIrV3Glyph] = []
    var i = 0u32
    while i < n:
        out.push(_empty_glyph_row())
        i = i + 1u32
    out

fn _sized_resources(n: u32) -> [DrawIrV3Resource]:
    var out: [DrawIrV3Resource] = []
    var i = 0u32
    while i < n:
        out.push(_empty_resource_row())
        i = i + 1u32
    out

fn _sized_path_spans(n: u32) -> [DrawIrV3PathSpan]:
    var out: [DrawIrV3PathSpan] = []
    var i = 0u32
    while i < n:
        out.push(_empty_path_span_row())
        i = i + 1u32
    out

fn _sized_path_points(n: u32) -> [DrawIrV3PathPoint]:
    var out: [DrawIrV3PathPoint] = []
    var i = 0u32
    while i < n:
        out.push(_empty_path_point_row())
        i = i + 1u32
    out

fn _sized_clips(n: u32) -> [DrawIrV3Clip]:
    var out: [DrawIrV3Clip] = []
    var i = 0u32
    while i < n:
        out.push(_empty_clip_row())
        i = i + 1u32
    out

fn _sized_transforms(n: u32) -> [DrawIrV3Transform]:
    var out: [DrawIrV3Transform] = []
    var i = 0u32
    while i < n:
        out.push(_empty_transform_row())
        i = i + 1u32
    out

fn _sized_hit_shapes(n: u32) -> [DrawIrV3HitShape]:
    var out: [DrawIrV3HitShape] = []
    var i = 0u32
    while i < n:
        out.push(_empty_hit_shape_row())
