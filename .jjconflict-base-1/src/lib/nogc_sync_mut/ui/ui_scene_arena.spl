# =========================================================================
# Arena — allocated once per session (design §3). Front and back generation
# columns are the arena's OWN top-level fields (never a nested class) so
# every mutation below is a single, reliable self-level write.
# =========================================================================

class UiSceneArena:
    capacity: UiSceneCapacityExtensionV1

    front_commands: [DrawIrV3Command]
    front_geometry: [DrawIrV3Geometry]
    front_paint: [DrawIrV3Paint]
    front_text_runs: [DrawIrV3TextRun]
    front_glyphs: [DrawIrV3Glyph]
    front_resources: [DrawIrV3Resource]
    front_path_spans: [DrawIrV3PathSpan]
    front_path_points: [DrawIrV3PathPoint]
    front_clips: [DrawIrV3Clip]
    front_transforms: [DrawIrV3Transform]
    front_hit_shapes: [DrawIrV3HitShape]
    front_provenance: [DrawIrV3Provenance]
    front_owners: [UiOwnerRecord]
    front_actions: [MenuActionBinding]

    back_commands: [DrawIrV3Command]
    back_geometry: [DrawIrV3Geometry]
    back_paint: [DrawIrV3Paint]
    back_text_runs: [DrawIrV3TextRun]
    back_glyphs: [DrawIrV3Glyph]
    back_resources: [DrawIrV3Resource]
    back_path_spans: [DrawIrV3PathSpan]
    back_path_points: [DrawIrV3PathPoint]
    back_clips: [DrawIrV3Clip]
    back_transforms: [DrawIrV3Transform]
    back_hit_shapes: [DrawIrV3HitShape]
    back_provenance: [DrawIrV3Provenance]
    back_owners: [UiOwnerRecord]
    back_actions: [MenuActionBinding]

    back_valid: bool
    # Committed extent (not physical capacity) of the COMMANDS/OWNER_RECORDS
    # columns for front/back -- how many rows the last successful write
    # pass actually populated, so a reader can tell "used" from "pre-sized
    # but still empty". Set by `ui_scene_commit_draw_write` /
    # `ui_scene_commit_owner_write` in `draw_ir_v3_native_writer.spl` and
    # swapped alongside the columns themselves.
    front_commands_used: u32
    back_commands_used: u32
    front_owners_used: u32
    back_owners_used: u32
    front_generation: u32
    completion_signaled: bool
    alloc_count: u32

impl UiSceneArena:
    static fn new(capacity: UiSceneCapacityExtensionV1) -> UiSceneArena:
        val n_commands = ui_scene_capacity_max_rows_at(capacity, UI_SCENE_TABLE_COMMANDS)
        val n_geometry = ui_scene_capacity_max_rows_at(capacity, UI_SCENE_TABLE_GEOMETRY)
        val n_paint = ui_scene_capacity_max_rows_at(capacity, UI_SCENE_TABLE_PAINT)
        val n_text_runs = ui_scene_capacity_max_rows_at(capacity, UI_SCENE_TABLE_TEXT_RUNS)
        val n_glyphs = ui_scene_capacity_max_rows_at(capacity, UI_SCENE_TABLE_GLYPHS)
        val n_resources = ui_scene_capacity_max_rows_at(capacity, UI_SCENE_TABLE_RESOURCES)
        val n_path_spans = ui_scene_capacity_max_rows_at(capacity, UI_SCENE_TABLE_PATH_SPANS)
        val n_path_points = ui_scene_capacity_max_rows_at(capacity, UI_SCENE_TABLE_PATH_POINTS)
        val n_clips = ui_scene_capacity_max_rows_at(capacity, UI_SCENE_TABLE_CLIPS)
        val n_transforms = ui_scene_capacity_max_rows_at(capacity, UI_SCENE_TABLE_TRANSFORMS)
        val n_hit_shapes = ui_scene_capacity_max_rows_at(capacity, UI_SCENE_TABLE_HIT_SHAPES)
        val n_provenance = ui_scene_capacity_max_rows_at(capacity, UI_SCENE_TABLE_PROVENANCE_EDGES)
        val n_owners = ui_scene_capacity_max_rows_at(capacity, UI_SCENE_TABLE_OWNER_RECORDS)
        val n_actions = ui_scene_capacity_max_rows_at(capacity, UI_SCENE_TABLE_ACTION_BINDINGS)

        UiSceneArena(
            capacity: capacity,
            front_commands: _sized_commands(n_commands),
            front_geometry: _sized_geometry(n_geometry),
            front_paint: _sized_paint(n_paint),
            front_text_runs: _sized_text_runs(n_text_runs),
            front_glyphs: _sized_glyphs(n_glyphs),
            front_resources: _sized_resources(n_resources),
            front_path_spans: _sized_path_spans(n_path_spans),
            front_path_points: _sized_path_points(n_path_points),
            front_clips: _sized_clips(n_clips),
            front_transforms: _sized_transforms(n_transforms),
            front_hit_shapes: _sized_hit_shapes(n_hit_shapes),
            front_provenance: _sized_provenance(n_provenance),
            front_owners: _sized_owners(n_owners),
            front_actions: _sized_actions(n_actions),
            back_commands: _sized_commands(n_commands),
            back_geometry: _sized_geometry(n_geometry),
            back_paint: _sized_paint(n_paint),
            back_text_runs: _sized_text_runs(n_text_runs),
            back_glyphs: _sized_glyphs(n_glyphs),
            back_resources: _sized_resources(n_resources),
            back_path_spans: _sized_path_spans(n_path_spans),
            back_path_points: _sized_path_points(n_path_points),
            back_clips: _sized_clips(n_clips),
            back_transforms: _sized_transforms(n_transforms),
            back_hit_shapes: _sized_hit_shapes(n_hit_shapes),
            back_provenance: _sized_provenance(n_provenance),
            back_owners: _sized_owners(n_owners),
            back_actions: _sized_actions(n_actions),
            back_valid: true,
            front_commands_used: 0u32,
            back_commands_used: 0u32,
            front_owners_used: 0u32,
            back_owners_used: 0u32,
            front_generation: 0u32,
            # No swap has happened yet; the first swap still requires an
            # explicit `signal_front_complete()` -- there is no free pass.
            completion_signaled: false,
            # In-band allocation counter (lane L5 gate assertion a): this
            # constructor is the ONLY place the fourteen `_sized_*` column
            # constructors run. A correct implementation never calls them
            # again after `new()` -- repeated generations reuse these same
            # arrays (swapped by value between front_*/back_*, never rebuilt).
            alloc_count: 1u32
        )

    me alloc_count() -> u32:
        self.alloc_count

    me capacity_max_rows(table_id: u16) -> u32:
        ui_scene_capacity_max_rows_at(self.capacity, table_id)

    # Start a fresh write pass into the back columns (reused storage, see
    # module doc -- this does NOT allocate).
    me begin_generation():
        self.back_valid = true
        self.back_commands_used = 0u32
        self.back_owners_used = 0u32

    me mark_back_invalid():
        self.back_valid = false

    me back_is_valid() -> bool:
        self.back_valid

    # Committed extent for the back generation (design §2.3 EMIT): how many
    # COMMANDS/OWNER_RECORDS rows the write pass that just finished actually
    # populated. Called by `ui_scene_commit_draw_write`/
    # `ui_scene_commit_owner_write` after a successful commit.
    me set_back_commands_used(n: u32):
        self.back_commands_used = n

    me set_back_owners_used(n: u32):
        self.back_owners_used = n

    me signal_front_complete():
        self.completion_signaled = true

    # Swap only proceeds after the completion signal for the CURRENT front
    # generation (design §3) -- refuses otherwise. A back generation left
    # invalid by a bounds/deficit violation is also refused: an invalid
    # generation must never become the visible front.
    me try_swap() -> bool:
        if not self.completion_signaled:
            return false
        if not self.back_valid:
            return false

        val tmp_commands = self.front_commands
        self.front_commands = self.back_commands
        self.back_commands = tmp_commands
        val tmp_geometry = self.front_geometry
        self.front_geometry = self.back_geometry
        self.back_geometry = tmp_geometry
        val tmp_paint = self.front_paint
        self.front_paint = self.back_paint
        self.back_paint = tmp_paint
        val tmp_text_runs = self.front_text_runs
        self.front_text_runs = self.back_text_runs
        self.back_text_runs = tmp_text_runs
        val tmp_glyphs = self.front_glyphs
        self.front_glyphs = self.back_glyphs
        self.back_glyphs = tmp_glyphs
        val tmp_resources = self.front_resources
        self.front_resources = self.back_resources
        self.back_resources = tmp_resources
        val tmp_path_spans = self.front_path_spans
        self.front_path_spans = self.back_path_spans
        self.back_path_spans = tmp_path_spans
        val tmp_path_points = self.front_path_points
        self.front_path_points = self.back_path_points
        self.back_path_points = tmp_path_points
        val tmp_clips = self.front_clips
        self.front_clips = self.back_clips
        self.back_clips = tmp_clips
        val tmp_transforms = self.front_transforms
        self.front_transforms = self.back_transforms
        self.back_transforms = tmp_transforms
        val tmp_hit_shapes = self.front_hit_shapes
        self.front_hit_shapes = self.back_hit_shapes
        self.back_hit_shapes = tmp_hit_shapes
        val tmp_provenance = self.front_provenance
        self.front_provenance = self.back_provenance
        self.back_provenance = tmp_provenance
        val tmp_owners = self.front_owners
        self.front_owners = self.back_owners
        self.back_owners = tmp_owners
        val tmp_commands_used = self.front_commands_used
        self.front_commands_used = self.back_commands_used
        self.back_commands_used = tmp_commands_used
        val tmp_owners_used = self.front_owners_used
        self.front_owners_used = self.back_owners_used
        self.back_owners_used = tmp_owners_used
        val tmp_actions = self.front_actions
        self.front_actions = self.back_actions
        self.back_actions = tmp_actions

        self.front_generation = self.front_generation + 1u32
        # Must be re-signaled before the NEXT swap.
        self.completion_signaled = false
        true

    me front_generation_id() -> u32:
        self.front_generation

    # Committed extent, not physical (pre-sized) capacity -- how many rows
    # the write pass that produced the current front generation actually
    # populated (see `front_commands_used` field doc above).
    me front_command_count() -> u32:
        self.front_commands_used

    me front_command_at(idx: u32) -> DrawIrV3Command:
        self.front_commands[idx.to_i64()]

    me front_owner_count() -> u32:
        self.front_owners_used

    me front_owner_at(idx: u32) -> UiOwnerRecord:
        self.front_owners[idx.to_i64()]

    # --- bounds-checked back-column setters (physical bounds; the
    # reservation-level bounds check happens in the native writer, which
    # never even attempts an index past a producer's assigned sub-range).
    me set_back_command(idx: u32, row: DrawIrV3Command) -> bool:
        if idx >= self.back_commands.len().to_u32():
            return false
        self.back_commands[idx.to_i64()] = row
        true

    me set_back_geometry(idx: u32, row: DrawIrV3Geometry) -> bool:
        if idx >= self.back_geometry.len().to_u32():
            return false
        self.back_geometry[idx.to_i64()] = row
        true

    me set_back_paint(idx: u32, row: DrawIrV3Paint) -> bool:
        if idx >= self.back_paint.len().to_u32():
            return false
        self.back_paint[idx.to_i64()] = row
        true

    me set_back_text_run(idx: u32, row: DrawIrV3TextRun) -> bool:
        if idx >= self.back_text_runs.len().to_u32():
            return false
        self.back_text_runs[idx.to_i64()] = row
        true

    me set_back_glyph(idx: u32, row: DrawIrV3Glyph) -> bool:
        if idx >= self.back_glyphs.len().to_u32():
            return false
        self.back_glyphs[idx.to_i64()] = row
        true

    me set_back_resource(idx: u32, row: DrawIrV3Resource) -> bool:
        if idx >= self.back_resources.len().to_u32():
            return false
        self.back_resources[idx.to_i64()] = row
        true

    me set_back_path_span(idx: u32, row: DrawIrV3PathSpan) -> bool:
        if idx >= self.back_path_spans.len().to_u32():
            return false
        self.back_path_spans[idx.to_i64()] = row
        true

    me set_back_path_point(idx: u32, row: DrawIrV3PathPoint) -> bool:
        if idx >= self.back_path_points.len().to_u32():
            return false
        self.back_path_points[idx.to_i64()] = row
        true

    me set_back_clip(idx: u32, row: DrawIrV3Clip) -> bool:
        if idx >= self.back_clips.len().to_u32():
            return false
        self.back_clips[idx.to_i64()] = row
        true

    me set_back_transform(idx: u32, row: DrawIrV3Transform) -> bool:
        if idx >= self.back_transforms.len().to_u32():
            return false
        self.back_transforms[idx.to_i64()] = row
        true

    me set_back_hit_shape(idx: u32, row: DrawIrV3HitShape) -> bool:
        if idx >= self.back_hit_shapes.len().to_u32():
            return false
        self.back_hit_shapes[idx.to_i64()] = row
        true

    me set_back_provenance(idx: u32, row: DrawIrV3Provenance) -> bool:
        if idx >= self.back_provenance.len().to_u32():
            return false
        self.back_provenance[idx.to_i64()] = row
        true

    me set_back_owner(idx: u32, row: UiOwnerRecord) -> bool:
        if idx >= self.back_owners.len().to_u32():
            return false
        self.back_owners[idx.to_i64()] = row
        true

    me set_back_action(idx: u32, row: MenuActionBinding) -> bool:
        if idx >= self.back_actions.len().to_u32():
            return false
        self.back_actions[idx.to_i64()] = row
        true

# =========================================================================
# PackedDrawPortV2 — submits by stable reference (design §2.6). Refuses a
# `PackedSceneRef` whose `object_generation` does not match the generation
# this port currently considers live, with an explicit receipt; a fresh
# reference is accepted and reports how many commands are live in the
# arena's current front generation.
#
# Lives in THIS file, not `draw_ir_v3_native_writer.spl`, so that its
# `DrawIrV3SubmitReceipt` (v2, `draw_ir_v3_ports_v2.spl`) never needs a
# `use ... as ...` alias to coexist with v1's identically-named
# `DrawIrV3SubmitReceipt` (`draw_ir_v3_ports.spl`, used by
# `UiSceneV1CompatPort` in the writer file): confirmed by direct probe (4
# minimal repros) that a struct type imported under a `use X as Y` alias
# cannot be constructed via `Y(...)` from ANY file that also contains an
# `impl Trait for Type:` block -- it fails to compile with `function 'Y'
# not found`, even when the alias and the trait impl are otherwise
# unrelated. The only working fix is to give each conflicting same-named
# type its own file, importing it unaliased.
# =========================================================================

class UiScenePackedPortV2:
    arena: UiSceneArena
    current_object_generation: u32

impl UiScenePackedPortV2:
    static fn new(arena: UiSceneArena, current_object_generation: u32) -> UiScenePackedPortV2:
        UiScenePackedPortV2(arena: arena, current_object_generation: current_object_generation)

impl PackedDrawPortV2 for UiScenePackedPortV2:
    me capabilities() -> u32:
        DRAW_IR_V3_CAP_COMPUTE_PASSES

    me submit_scene_ref(
        scene: PackedSceneRef, prepared: Prepared2DRef, dirty: DirtyRangeRef
    ) -> DrawIrV3SubmitReceipt:
        if scene.object_generation != self.current_object_generation:
            return DrawIrV3SubmitReceipt(
                accepted: false, reason: DRAW_IR_V3_PORT_V2_REASON_STALE_GENERATION,
                scene_generation: scene.scene_generation, commands_seen: 0u32
            )
        DrawIrV3SubmitReceipt(
            accepted: true, reason: DRAW_IR_V3_PORT_V2_REASON_OK,
            scene_generation: scene.scene_generation,
            commands_seen: self.arena.front_command_count()
        )

    me present(scene_generation: u32) -> bool:
        scene_generation == self.arena.front_generation_id()

export UiSceneArena, UiScenePackedPortV2
