use std.gc_async_mut.text_layout.font_renderer.{FontRenderer}

# Owns Engine2D's optional renderer without relying on native flow narrowing
# to restore a concrete receiver after an Option comparison.
#
# One-slot list instead of `FontRenderer?`: an Option-wrapped aggregate
# crossing a function boundary (the old match-the-Option-and-return-the-
# payload shape) is the deterministic payload-loss defect on the
# freestanding native lane (probes/cranelift_aggregate_return_min.spl
# probe 3; doc/08_tracking/bug/
# cranelift_native_aggregate_return_nil_receiver_hosted_wm_2026-07-26.md),
# and `.?` field unwrap is its own baremetal fault class (2026-07-18,
# cr2=0x0). Array-element access is a proven-safe channel.
class Engine2DFontOwner:
    active: [FontRenderer]

    static fn new() -> Engine2DFontOwner:
        Engine2DFontOwner(active: [])

fn engine2d_font_owner_has(owner: Engine2DFontOwner) -> bool:
    owner.active.len() > 0

fn engine2d_font_owner_get_or_create(mut owner: Engine2DFontOwner) -> FontRenderer:
    if owner.active.len() == 0:
        owner.active = [FontRenderer.new()]
    owner.active[0]

fn engine2d_font_owner_store(mut owner: Engine2DFontOwner, renderer: FontRenderer) -> Engine2DFontOwner:
    owner.active = [renderer]
    owner

fn engine2d_font_owner_clear(mut owner: Engine2DFontOwner) -> Engine2DFontOwner:
    if owner.active.len() > 0:
        owner.active[0].clear_ttf()
    owner.active = []
    owner
