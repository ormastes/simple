# Crypto-owned persistent Metal compute session.
# Reuses the canonical Metal SFFI owner; no raw runtime hooks live here.

mod std.gc_async_mut.crypto_accel.metal_session

use std.gc_async_mut.io.metal_sffi.{metal_device_info,
    metal_sffi_init, metal_sffi_is_available, metal_sffi_device_count,
    metal_sffi_create_device, metal_sffi_device_registry_identity,
    metal_sffi_device_supports_metal3,
    metal_sffi_destroy_device,
    metal_sffi_create_command_queue, metal_sffi_destroy_command_queue,
    metal_sffi_compile_shader, metal_sffi_load_library_bytes,
    metal_sffi_destroy_shader,
    metal_sffi_create_compute_pipeline, metal_sffi_destroy_pipeline,
    metal_sffi_alloc_buffer, metal_sffi_free_buffer,
    metal_sffi_buffer_upload, metal_sffi_buffer_download,
    metal_sffi_run_compute_frame}

class CryptoMetalSession:
    device_ordinal: i64
    device: i64
    queue: i64
    shader: i64
    forward_pipeline: i64
    inverse_pipeline: i64
    device_name: text
    stable_device_identity: text
    stable_device_capability: text
    initialized: bool
    completion_unknown: bool
    generation: i64
    input_buffer: i64
    output_buffer: i64
    capacity_bytes: i64

    static fn create() -> CryptoMetalSession:
        CryptoMetalSession.create_for_device(0)

    static fn create_for_device(device_ordinal: i64) -> CryptoMetalSession:
        CryptoMetalSession(device_ordinal: device_ordinal,
            device: 0, queue: 0, shader: 0,
            forward_pipeline: 0, inverse_pipeline: 0, device_name: "",
            stable_device_identity: "", stable_device_capability: "",
            initialized: false, completion_unknown: false, generation: 0,
            input_buffer: 0, output_buffer: 0, capacity_bytes: 0)

    me _device_ordinal_reason(device_count: i64) -> text:
        if self.device_ordinal < 0:
            return "metal-device-ordinal-invalid"
        if self.device_ordinal >= device_count:
            return "metal-device-ordinal-unavailable"
        ""

    me init(source: text, forward_entry: text, inverse_entry: text) -> text:
        if self.initialized or self.completion_unknown:
            return "metal-session-state-invalid"
        if source == "":
            return "metal-artifact-missing"
        if self.device_ordinal < 0:
            return "metal-device-ordinal-invalid"
        val metal_missing = not metal_sffi_is_available()
        if metal_missing:
            return "metal-unavailable"
        val initialization_failed = not metal_sffi_init()
        if initialization_failed:
            return "metal-unavailable"
        val device_count = metal_sffi_device_count()
        if device_count < 1:
            return "metal-unavailable"
        val ordinal_reason = self._device_ordinal_reason(device_count)
        if ordinal_reason != "": return ordinal_reason
        self.device = metal_sffi_create_device(self.device_ordinal)
        if self.device <= 0:
            self.shutdown()
            return "metal-device-create-failed"
        self.device_name = metal_device_info(self.device_ordinal).name
        self.stable_device_identity = metal_sffi_device_registry_identity(self.device)
        if self.stable_device_identity == "":
            self.shutdown()
            return "metal-device-identity-unavailable"
        self.stable_device_capability = if metal_sffi_device_supports_metal3(
                self.device): "metal3" else: ""
        if self.stable_device_capability == "":
            self.shutdown()
            return "metal-device-capability-unavailable"
        self.queue = metal_sffi_create_command_queue(self.device)
        self.shader = metal_sffi_compile_shader(self.device, source)
        if self.queue <= 0 or self.shader <= 0:
            self.shutdown()
            return "metal-queue-or-shader-create-failed"
        self.forward_pipeline = metal_sffi_create_compute_pipeline(
            self.device, self.shader, forward_entry)
        self.inverse_pipeline = metal_sffi_create_compute_pipeline(
            self.device, self.shader, inverse_entry)
        if self.forward_pipeline <= 0 or self.inverse_pipeline <= 0:
            self.shutdown()
            return "metal-pipeline-create-failed"
        self.initialized = true
        self.generation = self.generation + 1
        ""

    me init_binary(artifact_bytes: [u8], forward_entry: text,
            inverse_entry: text) -> text:
        if self.initialized or self.completion_unknown:
            return "metal-session-state-invalid"
        if artifact_bytes.len() == 0:
            return "metal-binary-artifact-invalid"
        if self.device_ordinal < 0:
            return "metal-device-ordinal-invalid"
        val metal_missing = not metal_sffi_is_available()
        if metal_missing:
            return "metal-unavailable"
        val initialization_failed = not metal_sffi_init()
        if initialization_failed:
            return "metal-unavailable"
        val device_count = metal_sffi_device_count()
        if device_count < 1:
            return "metal-unavailable"
        val ordinal_reason = self._device_ordinal_reason(device_count)
        if ordinal_reason != "": return ordinal_reason
        self.device = metal_sffi_create_device(self.device_ordinal)
        if self.device <= 0:
            self.shutdown()
            return "metal-device-create-failed"
        self.device_name = metal_device_info(self.device_ordinal).name
        self.stable_device_identity = metal_sffi_device_registry_identity(self.device)
        if self.stable_device_identity == "":
            self.shutdown()
            return "metal-device-identity-unavailable"
        self.stable_device_capability = if metal_sffi_device_supports_metal3(
                self.device): "metal3" else: ""
        if self.stable_device_capability == "":
            self.shutdown()
            return "metal-device-capability-unavailable"
        self.queue = metal_sffi_create_command_queue(self.device)
        self.shader = metal_sffi_load_library_bytes(self.device, artifact_bytes)
        if self.queue <= 0 or self.shader <= 0:
            self.shutdown()
            return "metal-queue-or-library-load-failed"
        self.forward_pipeline = metal_sffi_create_compute_pipeline(
            self.device, self.shader, forward_entry)
        self.inverse_pipeline = metal_sffi_create_compute_pipeline(
            self.device, self.shader, inverse_entry)
        if self.forward_pipeline <= 0 or self.inverse_pipeline <= 0:
            self.shutdown()
            return "metal-pipeline-create-failed"
        self.initialized = true
        self.generation = self.generation + 1
        ""

    me _release_buffers():
        if not self.completion_unknown:
            if self.input_buffer > 0:
                val _input_freed = metal_sffi_free_buffer(self.input_buffer)
            if self.output_buffer > 0:
                val _output_freed = metal_sffi_free_buffer(self.output_buffer)
        self.input_buffer = 0
        self.output_buffer = 0
        self.capacity_bytes = 0

    me _ensure_capacity(byte_count: i64) -> bool:
        val input_ready = self.capacity_bytes >= byte_count and self.input_buffer > 0
        val output_ready = self.output_buffer > 0
        if input_ready and output_ready:
            return true
        self._release_buffers()
        self.input_buffer = metal_sffi_alloc_buffer(self.device, byte_count)
        self.output_buffer = metal_sffi_alloc_buffer(self.device, byte_count)
        self.capacity_bytes = byte_count
        if self.input_buffer <= 0 or self.output_buffer <= 0:
            self._release_buffers()
            return false
        true

    me prepare_buffers(byte_count: i64) -> text:
        if not self.initialized or self.completion_unknown:
            return "metal-session-unavailable"
        if byte_count <= 0:
            return "metal-buffer-size-invalid"
        if not self._ensure_capacity(byte_count):
            return "metal-buffer-allocation-failed"
        ""

    me execute(input: [u8], polynomial_count: i64,
            inverse: bool) -> Result<[u8], text>:
        if not self.initialized or self.completion_unknown:
            return Err("metal-session-unavailable")
        if polynomial_count <= 0 or input.len().to_i64() != polynomial_count * 1024:
            return Err("metal-input-size-invalid")
        if not self._ensure_capacity(input.len().to_i64()):
            return Err("metal-buffer-allocation-failed")
        var params: [u8] = []
        params.push((polynomial_count & 0xFF).to_u8())
        params.push(((polynomial_count >> 8) & 0xFF).to_u8())
        params.push(((polynomial_count >> 16) & 0xFF).to_u8())
        params.push(((polynomial_count >> 24) & 0xFF).to_u8())
        var zeros: [u8] = []
        var i: i64 = 0
        while i < input.len().to_i64():
            zeros.push(0)
            i = i + 1
        val uploaded = metal_sffi_buffer_upload(
            self.input_buffer, input, input.len().to_i64())
        if not uploaded:
            val _clear_input = metal_sffi_buffer_upload(
                self.input_buffer, zeros, zeros.len().to_i64())
            val _clear_output = metal_sffi_buffer_upload(
                self.output_buffer, zeros, zeros.len().to_i64())
            return Err("metal-upload-failed")
        val pipeline = if inverse: self.inverse_pipeline else: self.forward_pipeline
        val completed = metal_sffi_run_compute_frame(
            self.queue, pipeline, self.input_buffer, self.output_buffer, params,
            polynomial_count, 1, 1, 256, 1, 1)
        if not completed:
            self.completion_unknown = true
            return Err("metal-submit-or-completion-failed")
        var output: [u8] = []
        i = 0
        while i < input.len().to_i64():
            output.push(0)
            i = i + 1
        val copied = metal_sffi_buffer_download(
            output, self.output_buffer, output.len().to_i64())
        val _clear_input = metal_sffi_buffer_upload(
            self.input_buffer, zeros, zeros.len().to_i64())
        val _clear_output = metal_sffi_buffer_upload(
            self.output_buffer, zeros, zeros.len().to_i64())
        if not copied:
            return Err("metal-device-readback-failed")
        Ok(output)

    me shutdown():
        self.stable_device_identity = ""
        self.stable_device_capability = ""
        # A failed submit/completion leaves ownership with the in-flight Metal
        # command. Retain the full dependency graph until a future runtime-owned
        # quarantine/reap API can prove terminal completion.
        if self.completion_unknown:
            return
        self._release_buffers()
        if self.forward_pipeline > 0:
            val _forward_destroyed = metal_sffi_destroy_pipeline(self.forward_pipeline)
        if self.inverse_pipeline > 0:
            val _inverse_destroyed = metal_sffi_destroy_pipeline(self.inverse_pipeline)
        if self.shader > 0:
            val _shader_destroyed = metal_sffi_destroy_shader(self.shader)
        if self.queue > 0:
            val _queue_destroyed = metal_sffi_destroy_command_queue(self.queue)
        if self.device > 0:
            val _device_destroyed = metal_sffi_destroy_device(self.device)
        self.device = 0
        self.device_name = ""
        self.queue = 0
        self.shader = 0
        self.forward_pipeline = 0
        self.inverse_pipeline = 0
        self.initialized = false

export CryptoMetalSession
