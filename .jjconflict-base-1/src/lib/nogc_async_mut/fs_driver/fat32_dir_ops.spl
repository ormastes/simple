# FAT32 — directory mutation operations (create_file, mkdir, unlink, rename).
#
# Free-function helpers that implement the body of Fat32Core directory-mutation
# methods.  Fat32Core.{create_file,mkdir,unlink,rename} delegate here to keep
# fat32_core.spl under the 800-line limit.

use std.fs_driver.types.{FileHandle, DirEntry, Inode}
use std.fs_driver.fat32_core.{
    Fat32Core, OpenFile,
    FAT32_FREE, FAT32_EOC, FAT32_DIR_ENTRY_SIZE,
    FAT32_ATTR_DIRECTORY, FAT32_ATTR_LONG_NAME
}
use std.fs_driver.fat32_parsers.{_read_u16_le, _read_u32_le, _parse_short_name, _split_path, _lower_text}

fn _fat32_sfn_byte(b: u8) -> u8:
    """Map one UTF-8 byte of a filename to its FAT 8.3 short-name byte.

    Lowercase ASCII is upcased. Anything that is not legal in an 8.3 name --
    control bytes, the reserved punctuation set, and every non-ASCII byte --
    becomes `_`, so a non-ASCII filename yields a defined short name instead
    of raw bytes in a directory entry.
    """
    if b >= 0x61 and b <= 0x7A:
        return b - 32
    if b < 0x20 or b > 0x7E:
        return 0x5F
    if b == 0x22 or b == 0x2A or b == 0x2B or b == 0x2C or b == 0x2E or b == 0x2F:
        return 0x5F
    if b == 0x3A or b == 0x3B or b == 0x3C or b == 0x3D or b == 0x3E or b == 0x3F:
        return 0x5F
    if b == 0x5B or b == 0x5C or b == 0x5D or b == 0x7C:
        return 0x5F
    b

fn fat32_short_name_bytes(name: text) -> [u8]:
    """Build the 11-byte FAT 8.3 short name (8 base + 3 extension, space padded).

    Iterates `name.bytes()`. The three call sites below previously read
    `name.char_at(i) as u8` while bounding the loop by `name.len()` -- a BYTE
    count, whereas char_at is CODE POINT indexed. Nothing filters or rejects
    non-ASCII filenames before this point, so an ordinary name like "café.txt"
    over-ran the string; and on the JIT engine `char_at(i) as u8` does not
    yield the code point at all, it truncates a raw pointer. Both produced
    garbage directory entries.
    """
    var out: [u8] = []
    var k: i64 = 0
    while k < 11:
        out.push(0x20)
        k = k + 1
    val nb = name.bytes()
    val n: i64 = nb.len()
    var dot_pos: i64 = -1
    var di: i64 = 0
    while di < n:
        if (nb[di] as i64) == 0x2E:
            dot_pos = di
        di = di + 1
    var base_end: i64 = n
    if dot_pos >= 0:
        base_end = dot_pos
    var ci: i64 = 0
    while ci < base_end and ci < 8:
        out[ci] = _fat32_sfn_byte(nb[ci])
        ci = ci + 1
    if dot_pos >= 0:
        var exi: i64 = 0
        var si: i64 = dot_pos + 1
        while si < n and exi < 3:
            out[8 + exi] = _fat32_sfn_byte(nb[si])
            exi = exi + 1
            si = si + 1
    out

fn fat32_create_file(core: Fat32Core, path: text) -> Result<[u32], text>:
    if not core.mounted:
        return Err("filesystem not mounted")
    val parts = _split_path(path)
    if parts.len() == 0:
        return Err("invalid path")
    var dir_cluster = core.root_cluster
    var pi = 0
    while pi < parts.len() - 1:
        val part = parts[pi]
        if part == "":
            pi = pi + 1
            continue
        val entry_rc = core.find_entry_in_dir(dir_cluster, part)
        if entry_rc.is_err():
            return match entry_rc:
                Ok(_): Err("failed to resolve path entry")
                Err(err): Err(err)
        val entry = match entry_rc:
            Ok(value): value
            Err(err): return Err(err)
        if not entry.is_dir:
            return Err("not a directory in path")
        dir_cluster = entry.inode.id.to_u32()
        pi = pi + 1
    val name = parts[parts.len() - 1]
    val alloc_rc = core.alloc_cluster()
    if alloc_rc.is_err():
        return match alloc_rc:
            Ok(_): Err("failed to allocate FAT32 cluster")
            Err(err): Err(err)
    val new_cluster = match alloc_rc:
        Ok(value): value
        Err(err): return Err(err)
    val dir_rc = core.read_cluster(dir_cluster)
    if dir_rc.is_err():
        return match dir_rc:
            Ok(_): Err("failed to read directory cluster")
            Err(err): Err(err)
    var dir_data = match dir_rc:
        Ok(value): value
        Err(err): return Err(err)
    val epc = (core.bytes_per_sector * core.sectors_per_cluster) / FAT32_DIR_ENTRY_SIZE
    var ei: u32 = 0
    var slot_off: i32 = -1
    while ei < epc:
        val off = (ei * FAT32_DIR_ENTRY_SIZE).to_i32()
        val fb = dir_data[off]
        if fb == 0x00 or fb == 0xE5:
            slot_off = off
            ei = epc
        ei = ei + 1
    if slot_off < 0:
        return Err("directory full")
    val sfn = fat32_short_name_bytes(name)
    var ni = 0
    while ni < 11:
        dir_data[slot_off + ni] = sfn[ni]
        ni = ni + 1
    dir_data[slot_off + 11] = 0x20
    dir_data[slot_off + 20] = ((new_cluster >> 16) & 0xFF).to_u8()
    dir_data[slot_off + 21] = ((new_cluster >> 24) & 0xFF).to_u8()
    dir_data[slot_off + 26] = (new_cluster & 0xFF).to_u8()
    dir_data[slot_off + 27] = ((new_cluster >> 8) & 0xFF).to_u8()
    dir_data[slot_off + 28] = 0
    dir_data[slot_off + 29] = 0
    dir_data[slot_off + 30] = 0
    dir_data[slot_off + 31] = 0
    val wrc = core.write_cluster(dir_cluster, dir_data)
    if wrc.is_err():
        return match wrc:
            Ok(_): Err("failed to write directory cluster")
            Err(err): Err(err)
    core.invalidate_dentry_cache()
    Ok([new_cluster, dir_cluster])

fn fat32_mkdir(core: Fat32Core, path: text) -> Result<(), text>:
    if not core.mounted:
        return Err("filesystem not mounted")
    val parts = _split_path(path)
    if parts.len() == 0:
        return Err("invalid path")
    var dir_cluster = core.root_cluster
    var pi = 0
    while pi < parts.len() - 1:
        val part = parts[pi]
        if part == "":
            pi = pi + 1
            continue
        val entry_rc = core.find_entry_in_dir(dir_cluster, part)
        if entry_rc.is_err():
            return match entry_rc:
                Ok(_): Err("failed to resolve path entry")
                Err(err): Err(err)
        val entry = match entry_rc:
            Ok(value): value
            Err(err): return Err(err)
        if not entry.is_dir:
            return Err("not a directory in path")
        dir_cluster = entry.inode.id.to_u32()
        pi = pi + 1
    val name = parts[parts.len() - 1]
    val alloc_rc = core.alloc_cluster()
    if alloc_rc.is_err():
        return match alloc_rc:
            Ok(_): Err("failed to allocate FAT32 cluster")
            Err(err): Err(err)
    val new_cluster = match alloc_rc:
        Ok(value): value
        Err(err): return Err(err)
    val dir_rc = core.read_cluster(dir_cluster)
    if dir_rc.is_err():
        return match dir_rc:
            Ok(_): Err("failed to read directory cluster")
            Err(err): Err(err)
    var dir_data = match dir_rc:
        Ok(value): value
        Err(err): return Err(err)
    val epc = (core.bytes_per_sector * core.sectors_per_cluster) / FAT32_DIR_ENTRY_SIZE
    var ei: u32 = 0
    var slot_off: i32 = -1
    while ei < epc:
        val off = (ei * FAT32_DIR_ENTRY_SIZE).to_i32()
        val fb = dir_data[off]
        if fb == 0x00 or fb == 0xE5:
            slot_off = off
            ei = epc
        ei = ei + 1
    if slot_off < 0:
        return Err("directory full")
    val sfn = fat32_short_name_bytes(name)
    var ni = 0
    while ni < 11:
        dir_data[slot_off + ni] = sfn[ni]
        ni = ni + 1
    dir_data[slot_off + 11] = FAT32_ATTR_DIRECTORY
    dir_data[slot_off + 20] = ((new_cluster >> 16) & 0xFF).to_u8()
    dir_data[slot_off + 21] = ((new_cluster >> 24) & 0xFF).to_u8()
    dir_data[slot_off + 26] = (new_cluster & 0xFF).to_u8()
    dir_data[slot_off + 27] = ((new_cluster >> 8) & 0xFF).to_u8()
    dir_data[slot_off + 28] = 0
    dir_data[slot_off + 29] = 0
    dir_data[slot_off + 30] = 0
    dir_data[slot_off + 31] = 0
    val wrc = core.write_cluster(dir_cluster, dir_data)
    if wrc.is_err():
        return match wrc:
            Ok(_): Err("failed to write directory cluster")
            Err(err): Err(err)
    core.invalidate_dentry_cache()
    Ok(())

fn fat32_unlink(core: Fat32Core, path: text) -> Result<(), text>:
    if not core.mounted:
        return Err("filesystem not mounted")
    val parts = _split_path(path)
    if parts.len() == 0:
        return Err("invalid path")
    var dir_cluster = core.root_cluster
    var pi = 0
    while pi < parts.len() - 1:
        val part = parts[pi]
        if part == "":
            pi = pi + 1
            continue
        val entry_rc = core.find_entry_in_dir(dir_cluster, part)
        if entry_rc.is_err():
            return match entry_rc:
                Ok(_): Err("failed to resolve path entry")
                Err(err): Err(err)
        val entry = match entry_rc:
            Ok(value): value
            Err(err): return Err(err)
        if not entry.is_dir:
            return Err("not a directory in path")
        dir_cluster = entry.inode.id.to_u32()
        pi = pi + 1
    val target = _lower_text(parts[parts.len() - 1])
    val chain_rc = core.follow_chain(dir_cluster)
    if chain_rc.is_err():
        return match chain_rc:
            Ok(_): Err("failed to follow FAT chain")
            Err(err): Err(err)
    val chain = match chain_rc:
        Ok(value): value
        Err(err): return Err(err)
    var ci = 0
    while ci < chain.len():
        val cdata_rc = core.read_cluster(chain[ci])
        if cdata_rc.is_err():
            return match cdata_rc:
                Ok(_): Err("failed to read directory cluster")
                Err(err): Err(err)
        var cdata = match cdata_rc:
            Ok(value): value
            Err(err): return Err(err)
        val epc = (core.bytes_per_sector * core.sectors_per_cluster) / FAT32_DIR_ENTRY_SIZE
        var ei: u32 = 0
        while ei < epc:
            val off = (ei * FAT32_DIR_ENTRY_SIZE).to_i32()
            val fb = cdata[off]
            if fb == 0x00:
                return Err("file not found")
            if fb == 0xE5 or cdata[off + 11] == FAT32_ATTR_LONG_NAME:
                ei = ei + 1
                continue
            val ename = _parse_short_name(cdata, off)
            if ename == target:
                val hi = _read_u16_le(cdata, off + 20).to_u32()
                val lo = _read_u16_le(cdata, off + 26).to_u32()
                val file_cluster = (hi << 16) | lo
                cdata[off] = 0xE5
                val wrc = core.write_cluster(chain[ci], cdata)
                if wrc.is_err():
                    return match wrc:
                        Ok(_): Err("failed to write directory cluster")
                        Err(err): Err(err)
                core.invalidate_dentry_cache()
                if file_cluster >= 2:
                    val fchain_rc = core.follow_chain(file_cluster)
                    val fchain = match fchain_rc:
                        Ok(value): value
                        Err(_): []
                    var fi = 0
                    while fi < fchain.len():
                        val free_rc = core.write_fat_entry(fchain[fi], FAT32_FREE)
                        fi = fi + 1
                return Ok(())
            ei = ei + 1
        ci = ci + 1
    Err("file not found")

fn fat32_rename(core: Fat32Core, old_path: text, new_path: text) -> Result<(), text>:
    if not core.mounted:
        return Err("filesystem not mounted")
    val old_parts = _split_path(old_path)
    if old_parts.len() == 0:
        return Err("invalid old path")
    val new_parts = _split_path(new_path)
    if new_parts.len() == 0:
        return Err("invalid new path")
    var old_dir_cluster = core.root_cluster
    var pi = 0
    while pi < old_parts.len() - 1:
        val part = old_parts[pi]
        if part == "":
            pi = pi + 1
            continue
        val entry_rc = core.find_entry_in_dir(old_dir_cluster, part)
        if entry_rc.is_err():
            return match entry_rc:
                Ok(_): Err("failed to resolve old path entry")
                Err(err): Err(err)
        val entry = match entry_rc:
            Ok(value): value
            Err(err): return Err(err)
        old_dir_cluster = entry.inode.id.to_u32()
        pi = pi + 1
    val old_name = _lower_text(old_parts[old_parts.len() - 1])
    var new_dir_cluster = core.root_cluster
    pi = 0
    while pi < new_parts.len() - 1:
        val part = new_parts[pi]
        if part == "":
            pi = pi + 1
            continue
        val entry_rc = core.find_entry_in_dir(new_dir_cluster, part)
        if entry_rc.is_err():
            return match entry_rc:
                Ok(_): Err("failed to resolve new path entry")
                Err(err): Err(err)
        val entry = match entry_rc:
            Ok(value): value
            Err(err): return Err(err)
        new_dir_cluster = entry.inode.id.to_u32()
        pi = pi + 1
    val new_name = new_parts[new_parts.len() - 1]
    val old_chain_rc = core.follow_chain(old_dir_cluster)
    if old_chain_rc.is_err():
        return match old_chain_rc:
            Ok(_): Err("failed to follow source directory chain")
            Err(err): Err(err)
    val old_chain = match old_chain_rc:
        Ok(value): value
        Err(err): return Err(err)
    var old_ci = 0
    var found_cluster: u32 = 0
    var found_size: u32 = 0
    var found_attr: u8 = 0
    var found: bool = false
    while old_ci < old_chain.len() and not found:
        val cdata_rc = core.read_cluster(old_chain[old_ci])
        if cdata_rc.is_err():
            return match cdata_rc:
                Ok(_): Err("failed to read source directory cluster")
                Err(err): Err(err)
        var cdata = match cdata_rc:
            Ok(value): value
            Err(err): return Err(err)
        val epc = (core.bytes_per_sector * core.sectors_per_cluster) / FAT32_DIR_ENTRY_SIZE
        var ei: u32 = 0
        while ei < epc:
            val off = (ei * FAT32_DIR_ENTRY_SIZE).to_i32()
            val fb = cdata[off]
            if fb == 0x00:
                ei = epc
                old_ci = old_chain.len()
                continue
            if fb == 0xE5 or cdata[off + 11] == FAT32_ATTR_LONG_NAME:
                ei = ei + 1
                continue
            val ename = _parse_short_name(cdata, off)
            if ename == old_name:
                val hi = _read_u16_le(cdata, off + 20).to_u32()
                val lo = _read_u16_le(cdata, off + 26).to_u32()
                found_cluster = (hi << 16) | lo
                found_size = _read_u32_le(cdata, off + 28)
                found_attr = cdata[off + 11]
                cdata[off] = 0xE5
                val wrc = core.write_cluster(old_chain[old_ci], cdata)
                if wrc.is_err():
                    return match wrc:
                        Ok(_): Err("failed to write source directory cluster")
                        Err(err): Err(err)
                core.invalidate_dentry_cache()
                found = true
                ei = epc
            else:
                ei = ei + 1
        old_ci = old_ci + 1
    if not found:
        return Err("file not found")
    val new_chain_rc = core.follow_chain(new_dir_cluster)
    if new_chain_rc.is_err():
        return match new_chain_rc:
            Ok(_): Err("failed to follow destination directory chain")
            Err(err): Err(err)
    val new_chain = match new_chain_rc:
        Ok(value): value
        Err(err): return Err(err)
    var new_ci = 0
    var placed: bool = false
    while new_ci < new_chain.len() and not placed:
        val cdata_rc = core.read_cluster(new_chain[new_ci])
        if cdata_rc.is_err():
            return match cdata_rc:
                Ok(_): Err("failed to read destination directory cluster")
                Err(err): Err(err)
        var cdata = match cdata_rc:
            Ok(value): value
            Err(err): return Err(err)
        val epc = (core.bytes_per_sector * core.sectors_per_cluster) / FAT32_DIR_ENTRY_SIZE
        var ei: u32 = 0
        while ei < epc:
            val off = (ei * FAT32_DIR_ENTRY_SIZE).to_i32()
            val fb = cdata[off]
            if fb == 0x00 or fb == 0xE5:
                val rsfn = fat32_short_name_bytes(new_name)
                var rni = 0
                while rni < 11:
                    cdata[off + rni] = rsfn[rni]
                    rni = rni + 1
                cdata[off + 11] = found_attr
                cdata[off + 20] = ((found_cluster >> 16) & 0xFF).to_u8()
                cdata[off + 21] = ((found_cluster >> 24) & 0xFF).to_u8()
                cdata[off + 26] = (found_cluster & 0xFF).to_u8()
                cdata[off + 27] = ((found_cluster >> 8) & 0xFF).to_u8()
                cdata[off + 28] = (found_size & 0xFF).to_u8()
                cdata[off + 29] = ((found_size >> 8) & 0xFF).to_u8()
                cdata[off + 30] = ((found_size >> 16) & 0xFF).to_u8()
                cdata[off + 31] = ((found_size >> 24) & 0xFF).to_u8()
                val wrc = core.write_cluster(new_chain[new_ci], cdata)
                if wrc.is_err():
                    return match wrc:
                        Ok(_): Err("failed to write destination directory cluster")
                        Err(err): Err(err)
                core.invalidate_dentry_cache()
                placed = true
                ei = epc
            else:
                ei = ei + 1
        new_ci = new_ci + 1
    if not placed:
        return Err("destination directory full")
    Ok(())
