"""Frozen schema marker and wire encoding for the placement contract group.

PLACE lane (`doc/03_plan/platform/structural_compute/gpu_mmu_plan.md`).

Shared rule 1 ("contract freeze first"): the type set in this directory is
frozen. Any change to a field set, a width, or a tier discriminant is a NEW
version constant here, never an in-place edit of an existing declaration.

INTERPRETATION (recorded because the plan is silent, not because it decided):
  * gpu_mmu_plan.md names the seven residency tiers and the order they are
    listed in, but assigns NO wire discriminants to them. `residency.spl`
    likewise carries no encoder. This file freezes the enum DECLARATION ORDER
    in `residency.spl` as the wire order (DeviceLocal = 0 .. Recomputable = 6).
    If the lane owner intended a different numbering, this constant must change
    BEFORE any consumer serialises a tier.
  * The plan gives no schema version string for the placement group. The name
    below mirrors GPU_WEB_CAPACITY_MANIFEST_SCHEMA_VERSION in
    `src/lib/common/ui/gpu_web_capacity_manifest.spl` and
    DRAW_IR_V3_SCHEMA_VERSION in `src/lib/common/ui/draw_ir_v3.spl`.
"""

use common.compute.placement_contracts.residency.{ResidencyTier}

val PLACEMENT_SCHEMA_VERSION: text = "simple-placement-contracts-v1"
val PLACEMENT_SCHEMA_ID: i64 = 1

# Absent-id sentinel, mirroring DRAW_IR_V3_NO_ID in draw_ir_v3.spl. A slot id
# equal to this never names a descriptor.
val PLACEMENT_NO_SLOT: i64 = 4294967295

# Absent-lease sentinel. A descriptor whose lease epoch is this value has no
# live lease and its device address must not be dereferenced.
val PLACEMENT_NO_EPOCH: i64 = 4294967295

val RESIDENCY_TIER_MAX: i64 = 6

# Naming follows the ID-TAG CONVENTIONS table (`<enum>_to_u8` / `_from_u8` /
# `_valid`); the sibling identity group returns i64 from the same-named
# functions, so this group does too rather than diverging.
fn residency_tier_to_u8(tier: ResidencyTier) -> i64:
    match tier:
        case ResidencyTier.DeviceLocal: 0
        case ResidencyTier.DeviceShared: 1
        case ResidencyTier.HostPinned: 2
        case ResidencyTier.HostHot: 3
        case ResidencyTier.HostCold: 4
        case ResidencyTier.SsdCas: 5
        case ResidencyTier.Recomputable: 6

fn residency_tier_from_u8(v: i64) -> ResidencyTier:
    match v:
        case 1: ResidencyTier.DeviceShared
        case 2: ResidencyTier.HostPinned
        case 3: ResidencyTier.HostHot
        case 4: ResidencyTier.HostCold
        case 5: ResidencyTier.SsdCas
        case 6: ResidencyTier.Recomputable
        case _: ResidencyTier.DeviceLocal

fn residency_tier_valid(v: i64) -> bool:
    v >= 0 and v <= RESIDENCY_TIER_MAX

# Stable diagnostic name. Used only in reason receipts, never as a key in a
# hot structure (draw_ir_v3 convention: no text keys in hot structures).
fn residency_tier_name(v: i64) -> text:
    match v:
        case 0: "DeviceLocal"
        case 1: "DeviceShared"
        case 2: "HostPinned"
        case 3: "HostHot"
        case 4: "HostCold"
        case 5: "SsdCas"
        case 6: "Recomputable"
        case _: "InvalidTier"

# True for the tiers whose bytes occupy the device budget. DeviceLocal and
# DeviceShared are the only two the plan places on the device.
fn residency_tier_is_device(v: i64) -> bool:
    v == 0 or v == 1

export PLACEMENT_SCHEMA_VERSION, PLACEMENT_SCHEMA_ID, PLACEMENT_NO_SLOT
export PLACEMENT_NO_EPOCH, RESIDENCY_TIER_MAX
export residency_tier_to_u8, residency_tier_from_u8, residency_tier_valid
export residency_tier_name, residency_tier_is_device
