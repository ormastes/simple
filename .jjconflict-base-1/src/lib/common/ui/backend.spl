# UI Render Backend Trait
#
# Platform-independent rendering interface.
# Each target (TUI, Web, VSCode, Electron) implements this trait.
#
# Usage:
#   use common.ui.backend.{RenderBackend}
#   use app.ui.tui.backend  # provides TuiBackend impl
#
#   bind RenderBackend = TuiBackend
#   # or dynamic dispatch:
#   fn run(backend: RenderBackend): ...
#
# Follows the same handle-level trait pattern as TorchBackend.
#
# Relation to `common.ui.screen_host.ScreenHost` (ADDITIVE — nothing here
# changes or is deprecated): `RenderBackend` is the `UIState` + HTML-string
# contract and keeps its existing implementors (`src/os/compositor/
# fb_backend.spl`, `src/os/compositor/browser_backend.spl`) and all of its
# importers working unchanged. `ScreenHost` is a SEPARATE, newer trait for
# the DrawIrV3 seam: it presents an already-produced `DrawIrV3Scene` value and
# polls `common.ui.host_input_event.HostInputEvent`. New shared-UI code that
# wants one code path across 2d / gui / web / wm should target `ScreenHost`;
# existing `RenderBackend` code has no migration obligation.

use common.ui.widget.{UITree, UIState, UIEvent}

# =========================================================================
# Core Render Backend Trait
# =========================================================================

trait RenderBackend:
    # --- Lifecycle ---
    fn init() -> Result<bool, text>
    fn shutdown()

    # --- Rendering ---
    fn render(state: UIState) -> Result<bool, text>
    fn render_html(state: UIState) -> text

    # --- Events ---
    fn poll_event(timeout_ms: i32) -> UIEvent?

    # --- Capabilities ---
    fn supports_mouse() -> bool
    fn supports_color() -> bool
    fn supports_images() -> bool
    fn supports_touch() -> bool

    # --- Viewport ---
    fn viewport_width() -> i32
    fn viewport_height() -> i32

    # --- Backend Info ---
    fn backend_name() -> text
