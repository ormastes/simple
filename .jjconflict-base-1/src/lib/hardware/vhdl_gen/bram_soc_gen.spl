# Structured generator for rv32_bram_soc.vhd — the BRAM-only (no DDR, no PS)
# KV260 SoC top, byte-identical to the silicon-proven golden in
# examples/09_embedded/fpga_riscv/rtl/.
#
# The golden's bulk is a three-way power-of-2 bank split repeated across TWO
# memory families (main RAM, read-only ramdisk). That repetition is the whole
# point of structuring this file: ONE SocMemFamily descriptor + a bank index
# derives the bank-size constant, the array type, the BRAM-init function, the
# signal and its init call, the ram_style attribute, the per-bank BRAM process,
# the address-decode elsif chain, and the read-mux arm — 6 banks x 8 artefacts
# from 2 descriptors. Likewise ONE marker descriptor drives both the
# "TEST PASSED" and "TEST FAILED" matchers, and ONE observation-command table
# drives the obs_resp case.
#
# Named literal sections (bram_soc_sections.spl) carry only: the file header
# rationale, the elaboration-time bank_words/at_least_1 helpers, the BRAM-init
# NOTE, chr8, the banner comments, and the irreducible FSM / capture /
# observation glue paragraphs.
#
# Determinism: arrays only, no Dict iteration; two runs are byte-identical.

use std.hardware.vhdl_gen.gen_types.{VgGenericSpec, VgPortSpec, VgAssign, VgConst, vg_pad, vg_append, no_lines, emit_constants, emit_entity_spec}
use std.hardware.vhdl_gen.bus_infra_types.*
use std.hardware.vhdl_gen.bram_soc_sections.*

val SOC_ENTITY: text = "rv32_bram_soc"
val SOC_BANKS: i64 = 3
val SOC_CORE_ENTITY: text = "rv32_exec_core_axi"

# One memory family: three power-of-2 banks cut from a single init file.
struct SocMemFamily:
    bank_prefix: text      # bank-size constant prefix, "RAM_B" / "RD_B"
    type_prefix: text      # array type + init function prefix, "ram" / "rd"
    sig_prefix: text       # memory signal prefix, "ram" / "rdisk"
    idx_prefix: text       # index/output/we/process prefix, "ram" / "rd"
    words_generic: text    # total-size generic, "RAM_WORDS" / "RDISK_WORDS"
    init_file: text        # init-file generic
    base_const: text       # address-space base constant
    region: text           # region_t literal
    writable: bool         # RAM takes byte writes; the ramdisk is a ROM

# One observation command.
struct SocObsCmd:
    sel: text              # hex nibble selector, e.g. "x\"0\""
    expr: text             # "" => the arm is a block, not an inline assign
    body: [text]

fn soc_family_ram() -> SocMemFamily:
    SocMemFamily(bank_prefix: "RAM_B", type_prefix: "ram", sig_prefix: "ram",
                 idx_prefix: "ram", words_generic: "RAM_WORDS",
                 init_file: "RAM_INIT_FILE", base_const: "RAM_BASE",
                 region: "R_RAM", writable: true)

fn soc_family_rdisk() -> SocMemFamily:
    SocMemFamily(bank_prefix: "RD_B", type_prefix: "rd", sig_prefix: "rdisk",
                 idx_prefix: "rd", words_generic: "RDISK_WORDS",
                 init_file: "RDISK_INIT_FILE", base_const: "RDISK_BASE",
                 region: "R_RDISK", writable: false)

fn soc_families() -> [SocMemFamily]:
    var f: [SocMemFamily] = []
    f = f.push(soc_family_ram())
    f = f.push(soc_family_rdisk())
    f

# --- derived names (every per-bank artefact comes from these) --------------

fn soc_bank_const(f: SocMemFamily, i: i64) -> text:
    f.bank_prefix + i.to_text() + "W"

fn soc_type_name(f: SocMemFamily, i: i64) -> text:
    f.type_prefix + i.to_text() + "_t"

fn soc_init_fn(f: SocMemFamily, i: i64) -> text:
    "init_" + f.type_prefix + i.to_text()

fn soc_sig_name(f: SocMemFamily, i: i64) -> text:
    f.sig_prefix + i.to_text()

fn soc_idx_sig(f: SocMemFamily, i: i64) -> text:
    f.idx_prefix + i.to_text() + "_idx_q"

fn soc_out_sig(f: SocMemFamily, i: i64) -> text:
    f.idx_prefix + i.to_text() + "_q"

fn soc_we_sig(f: SocMemFamily, i: i64) -> text:
    f.idx_prefix + i.to_text() + "_we_q"

fn soc_proc_label(f: SocMemFamily, i: i64) -> text:
    "p_" + f.idx_prefix + i.to_text()

# The first `n` bank-size constants of a family, as an array.
fn soc_bank_const_prefix(f: SocMemFamily, n: i64) -> [text]:
    var parts: [text] = []
    var k = 0
    while k < n:
        parts = parts.push(soc_bank_const(f, k))
        k = k + 1
    parts

# Words skipped in the init file before this bank: 0, B0W, B0W + B1W.
fn soc_bank_skip(f: SocMemFamily, i: i64) -> text:
    if i == 0:
        return "0"
    soc_bank_const_prefix(f, i).join(" + ")

# Index offset subtracted inside a bank: "", " - B0W", " - B0W - B1W".
fn soc_bank_minus(f: SocMemFamily, i: i64) -> text:
    if i == 0:
        return ""
    " - " + soc_bank_const_prefix(f, i).join(" - ")

# Upper bound of the decode elsif for bank i (the last bank closes on the
# family total so an over-large index still lands somewhere sane).
fn soc_bank_bound(f: SocMemFamily, i: i64) -> text:
    if i == SOC_BANKS - 1:
        return f.words_generic
    soc_bank_const_prefix(f, i + 1).join(" + ")

fn soc_word32() -> text:
    bi_slv(31)

# ---------------------------------------------------------------------------
# Entity
# ---------------------------------------------------------------------------

fn soc_generic(pre: [text], name: text, ty: text, default_val: text) -> VgGenericSpec:
    VgGenericSpec(pre_comments: pre, name: name, name_w: 16, ty: vg_pad(ty, 7),
                  default_val: default_val)

fn soc_generics() -> [VgGenericSpec]:
    var g: [VgGenericSpec] = []
    g = g.push(soc_generic(no_lines(), "CLK_FREQ", "natural", "25000000"))
    g = g.push(soc_generic(no_lines(), "BAUD_RATE", "natural", "115200"))
    g = g.push(soc_generic(bi_one("    -- 65536 words = 256 KB main RAM (BRAM budget: ~64 of 144 BRAM36)."),
                           "RAM_WORDS", "natural", "65536"))
    g = g.push(soc_generic(bi_one("    -- 81920 words = 320 KB ramdisk bank (FAT32 slice; smoke files live low)."),
                           "RDISK_WORDS", "natural", "81920"))
    g = g.push(soc_generic(bi_one("    -- 2048 words = 8 KB UART capture (boot transcript is ~700 bytes)."),
                           "UARTBUF_WORDS", "natural", "2048"))
    g = g.push(soc_generic(no_lines(), "RAM_INIT_FILE", "string", "\"rv32_flat.mem\""))
    g = g.push(soc_generic(no_lines(), "RDISK_INIT_FILE", "string", "\"rv32_ramdisk.mem\""))
    g

fn soc_ports() -> [VgPortSpec]:
    var p: [VgPortSpec] = []
    p = p.push(bi_port(bi_no_lines(), "clk", 4, "in", 2, "std_logic"))
    p = p.push(bi_port(bi_no_lines(), "rst", 4, "in", 2, "std_logic"))
    p = p.push(bi_port(bi_no_lines(), "uart_tx", 8, "out", 3, "std_logic"))
    p = p.push(bi_port(bi_one("    -- Observation port (clk domain)."), "obs_cmd", 14, "in", 3, soc_word32()))
    p = p.push(bi_port(bi_no_lines(), "obs_cmd_valid", 14, "in", 3, "std_logic"))
    p = p.push(bi_port(bi_no_lines(), "obs_resp", 14, "out", 3, bi_slv(63)))
    p = p.push(bi_port(bi_one("    -- Raw taps for testbenches / ILA."), "debug_uart_valid", 17, "out", 3, "std_logic"))
    p = p.push(bi_port(bi_no_lines(), "debug_uart_byte", 17, "out", 3, bi_slv(7)))
    p = p.push(bi_port(bi_no_lines(), "debug_pc", 17, "out", 3, soc_word32()))
    p

# ---------------------------------------------------------------------------
# Architecture declarations
# ---------------------------------------------------------------------------

fn soc_base_consts() -> [VgConst]:
    var c: [VgConst] = []
    c = c.push(VgConst(pre_comments: no_lines(), name: "RAM_BASE", ty: bi_unsigned(31), value: "x\"80000000\""))
    c = c.push(VgConst(pre_comments: no_lines(), name: "RDISK_BASE", ty: bi_unsigned(31), value: "x\"88000000\""))
    c

fn soc_bank_consts(fams: [SocMemFamily]) -> [VgConst]:
    var c: [VgConst] = []
    var fi = 0
    while fi < fams.len():
        val f = fams[fi]
        var i = 0
        while i < SOC_BANKS:
            c = c.push(VgConst(pre_comments: no_lines(), name: soc_bank_const(f, i), ty: "natural",
                               value: "bank_words(" + f.words_generic + ", " + i.to_text() + ")"))
            i = i + 1
        fi = fi + 1
    c

# Bank array types. The `rd*_t` names are one char shorter than `ram*_t`, and
# the golden aligns both the type-name and the range column across all six.
fn soc_bank_types(fams: [SocMemFamily]) -> [text]:
    var l: [text] = []
    var fi = 0
    while fi < fams.len():
        val f = fams[fi]
        var i = 0
        while i < SOC_BANKS:
            val rng = "(0 to at_least_1(" + soc_bank_const(f, i) + ") - 1)"
            l = l.push("  type " + vg_pad(soc_type_name(f, i), 6) + " is array " + vg_pad(rng, 30)
                       + " of " + soc_word32() + ";")
            i = i + 1
        fi = fi + 1
    l = l.push("  type uartbuf_t is array (0 to UARTBUF_WORDS - 1) of " + soc_word32() + ";")
    l

# One synthesizable BRAM-init function per bank, all from one template.
fn soc_init_fns(fams: [SocMemFamily]) -> [text]:
    var l: [text] = []
    var fi = 0
    while fi < fams.len():
        val f = fams[fi]
        var i = 0
        while i < SOC_BANKS:
            val ty = soc_type_name(f, i)
            l = l.push("  impure function " + soc_init_fn(f, i)
                       + "(fname : string; skip, depth : natural) return " + ty + " is")
            l = l.push("    file f : text open read_mode is fname;")
            l = l.push("    variable line_v : line;")
            l = l.push("    variable word_v : " + soc_word32() + ";")
            l = l.push("    variable mem_v : " + ty + " := (others => x\"00000000\");")
            l = l.push("    variable idx : natural := 0;")
            l = l.push("  begin")
            l = l.push("    while not endfile(f) loop")
            l = l.push("      readline(f, line_v);")
            l = l.push("      hread(line_v, word_v);")
            l = l.push("      if idx >= skip and idx < skip + depth then")
            l = l.push("        mem_v(idx - skip) := word_v;")
            l = l.push("      end if;")
            l = l.push("      idx := idx + 1;")
            l = l.push("    end loop;")
            l = l.push("    return mem_v;")
            l = l.push("  end function;")
            i = i + 1
        fi = fi + 1
    l

fn soc_bank_sigs(fams: [SocMemFamily]) -> [VgSignalSpec]:
    var s: [VgSignalSpec] = []
    var fi = 0
    while fi < fams.len():
        val f = fams[fi]
        var i = 0
        while i < SOC_BANKS:
            val nm = soc_sig_name(f, i)
            val ty = soc_type_name(f, i)
            val call = soc_init_fn(f, i) + "(" + f.init_file + ", " + soc_bank_skip(f, i)
                       + ", " + soc_bank_const(f, i) + ")"
            s = s.push(bi_sig(nm, nm.len() + 1, ty, ty.len() + 1, call))
            i = i + 1
        fi = fi + 1
    s = s.push(bi_sig("uartbuf", 8, "uartbuf_t", 10, "(others => x\"00000000\")"))
    s

fn soc_ram_style_attrs(fams: [SocMemFamily]) -> [text]:
    var l: [text] = []
    l = l.push("  attribute ram_style : string;")
    var fi = 0
    while fi < fams.len():
        val f = fams[fi]
        var i = 0
        while i < SOC_BANKS:
            l = l.push("  attribute ram_style of " + vg_pad(soc_sig_name(f, i), 7)
                       + ": signal is \"block\";")
            i = i + 1
        fi = fi + 1
    l = l.push("  -- The capture buffer is tiny; keep it out of the contended BRAM budget.")
    l = l.push("  attribute ram_style of uartbuf : signal is \"distributed\";")
    l

fn soc_core_link_sigs() -> [VgSignalSpec]:
    val nw = 11
    var s: [VgSignalSpec] = []
    s = s.push(bi_sig_pre(bi_one("  -- Core <-> memory slave."), "mem_req", nw, "std_logic", 0, ""))
    s = s.push(bi_sig("mem_we", nw, "std_logic", 0, ""))
    s = s.push(bi_sig("mem_addr", nw, soc_word32(), 0, ""))
    s = s.push(bi_sig("mem_wdata", nw, soc_word32(), 0, ""))
    s = s.push(bi_sig("mem_wstrb", nw, bi_slv(3), 0, ""))
    s = s.push(bi_sig("mem_rdata", nw, soc_word32(), 30, "(others => '0')"))
    s = s.push(bi_sig("mem_rvalid", nw, "std_logic", 10, "'0'"))
    s

fn soc_slave_sigs(fams: [SocMemFamily]) -> [text]:
    var l: [text] = []
    l = l.push("  type mstate_t is (M_IDLE, M_READ, M_RESP, M_WAIT);")
    var s0: [VgSignalSpec] = []
    s0 = s0.push(bi_sig("mstate_q", 9, "mstate_t", 9, "M_IDLE"))
    l = vg_append(l, emit_signal_decls(s0))
    l = l.push("  type region_t is (R_RAM, R_RDISK, R_NONE);")
    var s1: [VgSignalSpec] = []
    s1 = s1.push(bi_sig("region_q", 9, "region_t", 9, "R_NONE"))
    s1 = s1.push(bi_sig("bank_q", 7, "natural range 0 to " + (SOC_BANKS - 1).to_text(), 21, "0"))
    l = vg_append(l, emit_signal_decls(s1))
    # Per-bank registered read indices (both families).
    var s2: [VgSignalSpec] = []
    var fi = 0
    while fi < fams.len():
        val f = fams[fi]
        var i = 0
        while i < SOC_BANKS:
            val ty = "natural range 0 to at_least_1(" + soc_bank_const(f, i) + ") - 1"
            s2 = s2.push(bi_sig(soc_idx_sig(f, i), 11, ty, ty.len() + 1, "0"))
            i = i + 1
        fi = fi + 1
    l = vg_append(l, emit_signal_decls(s2))
    # Per-bank write enables (writable family only).
    var s3: [VgSignalSpec] = []
    var we_pre: [text] = []
    we_pre = we_pre.push("  -- Per-bank registered write enables (one clean UG901 byte-we template per")
    we_pre = we_pre.push("  -- bank process; a shared case-select write breaks Vivado RAM inference).")
    fi = 0
    while fi < fams.len():
        val f = fams[fi]
        if f.writable:
            var i = 0
            while i < SOC_BANKS:
                var pre = bi_no_lines()
                if i == 0:
                    pre = we_pre
                s3 = s3.push(bi_sig_pre(pre, soc_we_sig(f, i), 10, "std_logic", 10, "'0'"))
                i = i + 1
        fi = fi + 1
    s3 = s3.push(bi_sig("wdata_q", 12, soc_word32(), 30, "(others => '0')"))
    # wstrb_q keeps its own (unpadded) type column, unlike the vector group above.
    s3 = s3.push(bi_sig("wstrb_q", 12, bi_slv(3), bi_slv(3).len() + 1, "(others => '0')"))
    l = vg_append(l, emit_signal_decls(s3))
    # Per-family registered BRAM outputs, one comma list per family.
    var s4: [VgSignalSpec] = []
    fi = 0
    while fi < fams.len():
        val f = fams[fi]
        var outs: [text] = []
        var i = 0
        while i < SOC_BANKS:
            outs = outs.push(soc_out_sig(f, i))
            i = i + 1
        s4 = s4.push(bi_sig(outs.join(", "), 23, soc_word32(), 30, "(others => '0')"))
        fi = fi + 1
    s4 = s4.push(bi_sig("rvalid_cnt_q", 13, bi_unsigned(31), 22, "(others => '0')"))
    l = vg_append(l, emit_signal_decls(s4))
    l

fn soc_capture_sigs() -> [VgSignalSpec]:
    var s: [VgSignalSpec] = []
    s = s.push(bi_sig_pre(bi_one("  -- UART capture."), "dbg_uart_valid", 15, "std_logic", 0, ""))
    s = s.push(bi_sig("dbg_uart_byte", 15, bi_slv(7), 0, ""))
    s = s.push(bi_sig("uart_count_q", 13, bi_unsigned(31), 22, "(others => '0')"))
    s = s.push(bi_sig("ubuf_q", 7, soc_word32(), 30, "(others => '0')"))
    val raddr_ty = "natural range 0 to UARTBUF_WORDS - 1"
    s = s.push(bi_sig("ubuf_raddr_q", 13, raddr_ty, raddr_ty.len() + 1, "0"))
    s

# One descriptor per boot marker string; drives the constant, the two state
# signals and the matcher paragraph in the capture process.
struct SocMarker:
    const_name: text
    idx_sig: text
    seen_sig: text
    literal: text
    comment: text

fn soc_markers() -> [SocMarker]:
    var m: [SocMarker] = []
    m = m.push(SocMarker(const_name: "PASS_S", idx_sig: "pass_idx_q", seen_sig: "pass_seen_q",
                         literal: "TEST PASSED", comment: "\"TEST PASSED\" matcher"))
    m = m.push(SocMarker(const_name: "FAIL_S", idx_sig: "fail_idx_q", seen_sig: "fail_seen_q",
                         literal: "TEST FAILED", comment: "\"TEST FAILED\" matcher"))
    m

fn soc_marker_decls(ms: [SocMarker]) -> [text]:
    var l: [text] = []
    l = l.push("  -- Marker matchers.")
    var c: [VgConst] = []
    var i = 0
    while i < ms.len():
        c = c.push(VgConst(pre_comments: no_lines(), name: ms[i].const_name, ty: "string",
                           value: "\"" + ms[i].literal + "\""))
        i = i + 1
    l = vg_append(l, emit_constants(c, false))
    var s: [VgSignalSpec] = []
    i = 0
    while i < ms.len():
        val ty = "natural range 1 to " + ms[i].const_name + "'length + 1"
        s = s.push(bi_sig(ms[i].idx_sig, 11, ty, ty.len() + 1, "1"))
        i = i + 1
    i = 0
    while i < ms.len():
        s = s.push(bi_sig(ms[i].seen_sig, 12, "std_logic", 10, "'0'"))
        i = i + 1
    l = vg_append(l, emit_signal_decls(s))
    l

fn soc_obs_sigs() -> [VgSignalSpec]:
    var s: [VgSignalSpec] = []
    s = s.push(bi_sig_pre(bi_one("  -- Observation."), "obs_resp_q", 11, bi_slv(63), 30, "(others => '0')"))
    var pend_pre = bi_one("  -- 2-stage pend: stage1 = buffer raddr registered, stage2 = ubuf_q valid.")
    s = s.push(bi_sig_pre(pend_pre, "obs_pend1_q", 12, "std_logic", 10, "'0'"))
    s = s.push(bi_sig("obs_pend2_q", 12, "std_logic", 10, "'0'"))
    s = s.push(bi_sig("obs_cmd_q", 11, soc_word32(), 30, "(others => '0')"))
    s = s.push(bi_sig("cycle_cnt_q", 12, bi_unsigned(31), 22, "(others => '0')"))
    s

fn soc_reset_sigs() -> [VgSignalSpec]:
    var s: [VgSignalSpec] = []
    s = s.push(bi_sig_pre(bi_one("  -- Soft reset (re-run boot from JTAG)."), "soft_cnt_q", 11,
                          bi_unsigned(7), 21, "(others => '0')"))
    s = s.push(bi_sig("core_rst", 9, "std_logic", 0, ""))
    s

fn soc_dbg_sigs() -> [VgSignalSpec]:
    var s: [VgSignalSpec] = []
    val names = "dbg_pc, dbg_ins, dbg_a0, dbg_ra, dbg_sp"
    s = s.push(bi_sig(names, names.len() + 1, soc_word32(), 0, ""))
    s

# ---------------------------------------------------------------------------
# Architecture body: asserts, wiring, core instance
# ---------------------------------------------------------------------------

fn soc_bank_asserts(fams: [SocMemFamily]) -> [text]:
    var l: [text] = []
    var fi = 0
    while fi < fams.len():
        val f = fams[fi]
        val sum = soc_bank_const_prefix(f, SOC_BANKS).join(" + ")
        l = l.push("  assert " + sum + " = " + f.words_generic)
        l = l.push("    report \"" + f.words_generic
                   + " needs more than 3 power-of-2 banks\" severity failure;")
        fi = fi + 1
    l

fn soc_wiring() -> [text]:
    var a: [VgAssign] = []
    a = a.push(bi_assign("core_rst", "'1' when (rst = '1' or soft_cnt_q /= 0) else '0'"))
    var l = emit_assigns_at(2, 8, a)
    var b: [VgAssign] = []
    b = b.push(bi_assign("debug_uart_valid", "dbg_uart_valid"))
    b = b.push(bi_assign("debug_uart_byte", "dbg_uart_byte"))
    l = vg_append(l, emit_assigns_at(2, 16, b))
    var c: [VgAssign] = []
    c = c.push(bi_assign("debug_pc", "dbg_pc"))
    c = c.push(bi_assign("obs_resp", "obs_resp_q"))
    l = vg_append(l, emit_assigns_at(2, 8, c))
    l

# One row of an instantiation port map (several associations per source line).
struct SocMapRow:
    formals: [text]
    actuals: [text]

fn soc_map_row(formals: [text], actuals: [text]) -> SocMapRow:
    SocMapRow(formals: formals, actuals: actuals)

fn soc_row2(f0: text, a0: text, f1: text, a1: text) -> SocMapRow:
    soc_map_row(bi_two(f0, f1), bi_two(a0, a1))

fn soc_row3(f0: text, a0: text, f1: text, a1: text, f2: text, a2: text) -> SocMapRow:
    soc_map_row(bi_three(f0, f1, f2), bi_three(a0, a1, a2))

fn soc_core_port_map() -> [SocMapRow]:
    var r: [SocMapRow] = []
    r = r.push(soc_row3("clk", "clk", "rst", "core_rst", "uart_tx", "uart_tx"))
    r = r.push(soc_row3("mem_req", "mem_req", "mem_we", "mem_we", "mem_addr", "mem_addr"))
    r = r.push(soc_row2("mem_wdata", "mem_wdata", "mem_wstrb", "mem_wstrb"))
    r = r.push(soc_row2("mem_rdata", "mem_rdata", "mem_rvalid", "mem_rvalid"))
    r = r.push(soc_row2("debug_uart_valid", "dbg_uart_valid", "debug_uart_byte", "dbg_uart_byte"))
    r = r.push(soc_row3("debug_pc", "dbg_pc", "debug_ins", "dbg_ins", "debug_a0", "dbg_a0"))
    r = r.push(soc_row2("debug_ra", "dbg_ra", "debug_sp", "dbg_sp"))
    r

fn soc_row_text(r: SocMapRow) -> text:
    var assocs: [text] = []
    var i = 0
    while i < r.formals.len():
        assocs = assocs.push(r.formals[i] + " => " + r.actuals[i])
        i = i + 1
    assocs.join(", ")

fn soc_core_instance() -> [text]:
    val rows = soc_core_port_map()
    var l: [text] = []
    l = l.push("  u_core : entity work." + SOC_CORE_ENTITY)
    l = l.push("    generic map (CLK_FREQ => CLK_FREQ, BAUD_RATE => BAUD_RATE)")
    l = l.push("    port map (")
    var i = 0
    while i < rows.len():
        var line = "      " + soc_row_text(rows[i])
        if i < rows.len() - 1:
            line = line + ","
        else:
            line = line + ");"
        l = l.push(line)
        i = i + 1
    l

# ---------------------------------------------------------------------------
# Per-bank BRAM processes (UG901 templates, one per bank)
# ---------------------------------------------------------------------------

fn soc_bank_processes(fams: [SocMemFamily]) -> [text]:
    var parts: [text] = []
    var fi = 0
    while fi < fams.len():
        val f = fams[fi]
        var i = 0
        while i < SOC_BANKS:
            var body: [text] = []
            body = body.push("    if rising_edge(clk) then")
            if f.writable:
                body = body.push("      if " + soc_we_sig(f, i) + " = '1' then")
                body = body.push("        for i in 0 to 3 loop")
                body = body.push("          if wstrb_q(i) = '1' then")
                body = body.push("            " + soc_sig_name(f, i) + "(" + soc_idx_sig(f, i)
                                 + ")(i * 8 + 7 downto i * 8) <= wdata_q(i * 8 + 7 downto i * 8);")
                body = body.push("          end if;")
                body = body.push("        end loop;")
                body = body.push("      end if;")
            body = body.push("      " + soc_out_sig(f, i) + " <= " + soc_sig_name(f, i)
                             + "(" + soc_idx_sig(f, i) + ");")
            body = body.push("    end if;")
            parts = parts.push(bi_jl(emit_process(2, soc_proc_label(f, i), "clk", bi_no_lines(), body)))
            i = i + 1
        fi = fi + 1
    var l: [text] = []
    var k = 0
    while k < parts.len():
        if k > 0:
            l = l.push("")
        l = l.push(parts[k])
        k = k + 1
    l

# ---------------------------------------------------------------------------
# Memory slave FSM
# ---------------------------------------------------------------------------

fn soc_we_clear(fams: [SocMemFamily]) -> [VgAssign]:
    var a: [VgAssign] = []
    var fi = 0
    while fi < fams.len():
        val f = fams[fi]
        if f.writable:
            var i = 0
            while i < SOC_BANKS:
                a = a.push(bi_assign(soc_we_sig(f, i), "'0'"))
                i = i + 1
        fi = fi + 1
    a

# The bank decode elsif chain for one family (indent 16).
fn soc_bank_decode(f: SocMemFamily) -> [text]:
    var l: [text] = []
    var i = 0
    while i < SOC_BANKS:
        var kw = "elsif"
        if i == 0:
            kw = "if"
        l = l.push("                " + kw + " widx < " + soc_bank_bound(f, i) + " then")
        l = l.push("                  bank_q <= " + i.to_text() + ";")
        l = l.push("                  " + soc_idx_sig(f, i) + " <= widx" + soc_bank_minus(f, i) + ";")
        if f.writable:
            l = l.push("                  " + soc_we_sig(f, i) + " <= mem_we;")
        i = i + 1
    l = l.push("                end if;")
    l

fn soc_region_guard(f: SocMemFamily, first: bool) -> [text]:
    var kw = "elsif"
    if first:
        kw = "if"
    var l: [text] = []
    l = l.push("              " + kw + " unsigned(mem_addr) >= " + f.base_const)
    l = l.push("                 and unsigned(mem_addr) < " + f.base_const + " + to_unsigned("
               + f.words_generic + ", 32) * 4 then")
    if not first:
        l = l.push("                off := unsigned(mem_addr) - " + f.base_const + ";")
    l = l.push("                region_q <= " + f.region + ";")
    l = l.push("                widx := to_integer(off(22 downto 2));")
    l

fn soc_idle_arm(fams: [SocMemFamily]) -> [text]:
    var l = emit_assigns_at(12, 9, soc_we_clear(fams))
    l = vg_append(l, bram_soc_idle_req_head())
    var fi = 0
    while fi < fams.len():
        l = vg_append(l, soc_region_guard(fams[fi], fi == 0))
        l = vg_append(l, soc_bank_decode(fams[fi]))
        fi = fi + 1
    l = vg_append(l, bram_soc_idle_req_tail())
    l

fn soc_read_arm(fams: [SocMemFamily]) -> [text]:
    var l: [text] = []
    l = l.push("            -- BRAM output registers load this cycle (write commits this cycle).")
    l = vg_append(l, emit_assigns_at(12, 9, soc_we_clear(fams)))
    l = l.push("            mstate_q <= M_RESP;")
    l

fn soc_bank_read_arms(f: SocMemFamily) -> [VgCaseArm]:
    var arms: [VgCaseArm] = []
    var i = 0
    while i < SOC_BANKS:
        arms = arms.push(bi_arm_inline(i.to_text(), 0, "mem_rdata <= " + soc_out_sig(f, i) + ";"))
        i = i + 1
    arms

fn soc_region_arms(fams: [SocMemFamily]) -> [VgCaseArm]:
    var arms: [VgCaseArm] = []
    var fi = 0
    while fi < fams.len():
        arms = arms.push(bi_arm(fams[fi].region, emit_case(16, "bank_q", soc_bank_read_arms(fams[fi]))))
        fi = fi + 1
    arms = arms.push(bi_arm_inline("R_NONE", 7, "mem_rdata <= (others => '0');"))
    arms

fn soc_resp_arm(fams: [SocMemFamily]) -> [text]:
    var l = emit_case(12, "region_q", soc_region_arms(fams))
    l = vg_append(l, bram_soc_resp_tail())
    l

fn soc_slave_process(fams: [SocMemFamily]) -> [text]:
    var arms: [VgCaseArm] = []
    arms = arms.push(bi_arm("M_IDLE", soc_idle_arm(fams)))
    arms = arms.push(bi_arm("M_READ", soc_read_arm(fams)))
    arms = arms.push(bi_arm("M_RESP", soc_resp_arm(fams)))
    arms = arms.push(bi_arm("M_WAIT", bram_soc_wait_arm()))
    var reset: [VgAssign] = []
    reset = reset.push(bi_assign("mstate_q", "M_IDLE"))
    reset = vg_reset_append(reset, soc_we_clear(fams))
    reset = reset.push(bi_assign("rvalid_cnt_q", "(others => '0')"))
    var body: [text] = []
    body = body.push("    if rising_edge(clk) then")
    body = body.push("      mem_rvalid <= '0';")
    body = body.push("      if rst = '1' then")
    body = vg_append(body, emit_assigns_at(8, 0, reset))
    body = body.push("      else")
    body = vg_append(body, emit_case(8, "mstate_q", arms))
    body = body.push("      end if;")
    body = body.push("    end if;")
    var decls: [text] = []
    decls = decls.push("    variable off : " + bi_unsigned(31) + ";")
    decls = decls.push("    variable widx : natural;")
    emit_process(2, "", "clk", decls, body)

fn vg_reset_append(dst: [VgAssign], src: [VgAssign]) -> [VgAssign]:
    var out = dst
    var i = 0
    while i < src.len():
        out = out.push(src[i])
        i = i + 1
    out

# ---------------------------------------------------------------------------
# UART capture + marker matchers
# ---------------------------------------------------------------------------

fn soc_marker_matcher(m: SocMarker) -> [text]:
    var l: [text] = []
    l = l.push("        -- " + m.comment)
    l = l.push("        if dbg_uart_byte = chr8(" + m.const_name + "(" + m.idx_sig + ")) then")
    l = l.push("          if " + m.idx_sig + " = " + m.const_name + "'length then")
    l = l.push("            " + m.seen_sig + " <= '1';")
    l = l.push("            " + m.idx_sig + " <= 1;")
    l = l.push("          else")
    l = l.push("            " + m.idx_sig + " <= " + m.idx_sig + " + 1;")
    l = l.push("          end if;")
    l = l.push("        elsif dbg_uart_byte = chr8(" + m.const_name + "(1)) then")
    l = l.push("          " + m.idx_sig + " <= 2;")
    l = l.push("        else")
    l = l.push("          " + m.idx_sig + " <= 1;")
    l = l.push("        end if;")
    l

fn soc_capture_process(ms: [SocMarker]) -> [text]:
    var body: [text] = []
    body = body.push("    if rising_edge(clk) then")
    body = vg_append(body, bram_soc_capture_head())
    var i = 0
    while i < ms.len():
        body = vg_append(body, soc_marker_matcher(ms[i]))
        i = i + 1
    body = body.push("      end if;")
    body = body.push("    end if;")
    var decls: [text] = []
    decls = decls.push("    variable lane : natural range 0 to 3;")
    decls = decls.push("    variable wi : natural;")
    emit_process(2, "", "clk", decls, body)

# ---------------------------------------------------------------------------
# Observation command pipeline
# ---------------------------------------------------------------------------

fn soc_obs_simple(sel: text, expr: text) -> SocObsCmd:
    SocObsCmd(sel: "x\"" + sel + "\"", expr: expr, body: bi_no_lines())

fn soc_obs_cmds() -> [SocObsCmd]:
    var c: [SocObsCmd] = []
    c = c.push(soc_obs_simple("0", "x\"51F0B007\""))
    c = c.push(SocObsCmd(sel: "x\"1\"", expr: "", body: bram_soc_obs_status_body()))
    c = c.push(soc_obs_simple("2", "dbg_pc"))
    c = c.push(soc_obs_simple("3", "ubuf_q"))
    c = c.push(soc_obs_simple("4", "dbg_ins"))
    c = c.push(soc_obs_simple("5", "dbg_sp"))
    c = c.push(soc_obs_simple("6", "dbg_ra"))
    c = c.push(soc_obs_simple("7", "std_logic_vector(cycle_cnt_q)"))
    c = c.push(soc_obs_simple("8", "dbg_a0"))
    c = c.push(soc_obs_simple("9", "std_logic_vector(rvalid_cnt_q)"))
    c = c.push(SocObsCmd(sel: "x\"F\"", expr: "@block", body: bram_soc_obs_softreset_body()))
    c

fn soc_obs_arms(cmds: [SocObsCmd]) -> [VgCaseArm]:
    val lhs = "obs_resp_q(31 downto 0)"
    var arms: [VgCaseArm] = []
    var i = 0
    while i < cmds.len():
        val c = cmds[i]
        if c.expr == "@block":
            arms = arms.push(bi_arm(c.sel, c.body))
        else:
            if c.expr == "":
                # Wrapped right-hand side: the assign target opens the arm and
                # the expression continues on the following lines.
                arms = arms.push(bi_arm_wrapped(c.sel, lhs + " <=", c.body))
            else:
                arms = arms.push(bi_arm_inline(c.sel, 0, lhs + " <= " + c.expr + ";"))
        i = i + 1
    arms = arms.push(bi_arm_inline("others", 0, lhs + " <= (others => '0');"))
    arms

fn soc_obs_process() -> [text]:
    var body: [text] = []
    body = body.push("    if rising_edge(clk) then")
    body = vg_append(body, bram_soc_obs_head())
    body = vg_append(body, emit_case(8, "obs_cmd_q(3 downto 0)", soc_obs_arms(soc_obs_cmds())))
    body = body.push("      end if;")
    body = body.push("    end if;")
    var decls: [text] = []
    decls = decls.push("    variable bidx : natural;")
    emit_process(2, "", "clk", decls, body)

# ---------------------------------------------------------------------------
# Whole-file assembly
# ---------------------------------------------------------------------------

fn soc_library_header() -> [text]:
    var l: [text] = []
    l = l.push("library ieee;")
    l = l.push("use ieee.std_logic_1164.all;")
    l = l.push("use ieee.numeric_std.all;")
    l = l.push("use std.textio.all;")
    l = l.push("use ieee.std_logic_textio.all;")
    l

fn generate_bram_soc() -> text:
    val fams = soc_families()
    val ms = soc_markers()
    var parts: [text] = []
    parts = parts.push(bi_jl(soc_library_header()))
    parts = parts.push("")
    parts = parts.push(bi_jl(bram_soc_head()))
    parts = parts.push("")
    parts = parts.push(bi_jl(emit_entity_spec(SOC_ENTITY, soc_generics(), soc_ports())))
    parts = parts.push("")
    parts = parts.push("architecture rtl of " + SOC_ENTITY + " is")
    parts = parts.push(bi_jl(emit_constants(soc_base_consts(), true)))
    parts = parts.push("")
    parts = parts.push(bi_jl(bram_soc_bank_split_helpers()))
    parts = parts.push("")
    parts = parts.push(bi_jl(emit_constants(soc_bank_consts(fams), true)))
    parts = parts.push("")
    parts = parts.push(bi_jl(soc_bank_types(fams)))
    parts = parts.push("")
    parts = parts.push(bi_jl(bram_soc_init_note()))
    parts = parts.push(bi_jl(soc_init_fns(fams)))
    parts = parts.push("")
    parts = parts.push(bi_jl(emit_signal_decls(soc_bank_sigs(fams))))
    parts = parts.push(bi_jl(soc_ram_style_attrs(fams)))
    parts = parts.push("")
    parts = parts.push(bi_jl(emit_signal_decls(soc_core_link_sigs())))
    parts = parts.push("")
    parts = parts.push(bi_jl(soc_slave_sigs(fams)))
    parts = parts.push("")
    parts = parts.push(bi_jl(emit_signal_decls(soc_capture_sigs())))
    parts = parts.push("")
    parts = parts.push(bi_jl(soc_marker_decls(ms)))
    parts = parts.push("")
    parts = parts.push(bi_jl(emit_signal_decls(soc_obs_sigs())))
    parts = parts.push("")
    parts = parts.push(bi_jl(emit_signal_decls(soc_reset_sigs())))
    parts = parts.push("")
    parts = parts.push(bi_jl(emit_signal_decls(soc_dbg_sigs())))
    parts = parts.push("")
    parts = parts.push(bi_jl(bram_soc_chr8_fn()))
    parts = parts.push("begin")
    parts = parts.push(bi_jl(soc_bank_asserts(fams)))
    parts = parts.push("")
    parts = parts.push(bi_jl(soc_wiring()))
    parts = parts.push("")
    parts = parts.push(bi_jl(soc_core_instance()))
    parts = parts.push("")
    parts = parts.push(bi_jl(bram_soc_bank_process_banner()))
    parts = parts.push(bi_jl(soc_bank_processes(fams)))
    parts = parts.push("")
    parts = parts.push(bi_jl(bram_soc_slave_banner()))
    parts = parts.push(bi_jl(soc_slave_process(fams)))
    parts = parts.push("")
    parts = parts.push(bi_jl(bram_soc_capture_banner()))
    parts = parts.push(bi_jl(soc_capture_process(ms)))
    parts = parts.push("")
    parts = parts.push(bi_jl(bram_soc_obs_banner()))
    parts = parts.push(bi_jl(soc_obs_process()))
    parts = parts.push("end architecture rtl;")
    parts.join("\n") + "\n"
