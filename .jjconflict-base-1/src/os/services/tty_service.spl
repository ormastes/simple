# SimpleOS TTY Service (G8)
#
# Provides POSIX-style terminal (TTY/PTY) management for SimpleOS.
# Supports console TTYs, PTY master/slave pairs, canonical and raw input
# modes, Termios control, and SIGINT delivery via ECS internals.
#
# ECS internals: entities are TTY instances; components live in per-type
# ComponentStore<T> columns owned by TtyWorld.

use std.ecs.entity.{Entity, EntityAllocator}
use std.ecs.component_store.{ComponentStore}
use std.ecs.world.{WorldBase}
use os.services.service_manifest.{ServiceManifest, can_start, mark_starting, mark_ready, mark_stopping, mark_stopped, record_health, record_heartbeat, check_watchdog, should_restart, on_restart, holds_grants}

# ============================================================================
# TTY kind constants
# ============================================================================

val TTY_CONSOLE: u32 = 0
val TTY_PTY_MASTER: u32 = 1
val TTY_PTY_SLAVE: u32 = 2

# ============================================================================
# Termios lflag bit constants
# ============================================================================

val ISIG: u32 = 1        # 1 << 0 — enable signal generation
val ICANON: u32 = 2      # 1 << 1 — canonical (line) mode
val ECHO: u32 = 8        # 1 << 3 — echo input characters

# ============================================================================
# Control character indices (POSIX cc[] array)
# ============================================================================

val VINTR: i32 = 0       # Ctrl-C → SIGINT
val VERASE: i32 = 2      # Ctrl-H / backspace
val VKILL: i32 = 3       # Ctrl-U — kill line
val VEOF: i32 = 4        # Ctrl-D — end of file

# ============================================================================
# Signal number
# ============================================================================

val SIGINT: i32 = 2

# ============================================================================
# Components (per MDSOC+ ECS spec)
# ============================================================================

struct LineBuf:
    """Pending input line buffer for canonical mode accumulation."""
    bytes: [u8]
    cap: i32

struct Termios:
    """POSIX termios control structure for a TTY entity."""
    iflag: u32
    oflag: u32
    lflag: u32
    cc: [u8]

struct ForegroundPgid:
    """Process group ID of the foreground process group for this TTY."""
    value: u32

struct InputSource:
    """Opaque endpoint identifier for the keyboard or serial input source."""
    endpoint: u64

struct OutputSink:
    """Opaque endpoint identifier for the framebuffer or serial output sink."""
    endpoint: u64

struct OutputBuf:
    """Pending output byte queue drained by the console/serial reader.

    Real delivery target for tty_write: bytes accepted by tty_write are
    appended here so a subsequent tty_read_output() observes them.
    """
    bytes: [u8]

struct InputBuf:
    """Pending input byte queue drained by the shell/reader side of a PTY.

    Real delivery target for pty_master_write: bytes written by the PTY
    master are appended to the SLAVE entity's InputBuf so a subsequent
    tty_read_input() (the "shell read") observes them. Every TTY entity
    gets one (not just PTY slaves) so the same drain path works uniformly.
    """
    bytes: [u8]

struct TtyKind:
    """TTY_CONSOLE=0 | TTY_PTY_MASTER=1 | TTY_PTY_SLAVE=2"""
    kind: u32

struct PtyPair:
    """Routing link from a PTY master entity to its slave entity.

    This is the endpoint->entity routing layer P4 deferred: previously
    OutputSink/InputSource only carried an opaque u64 endpoint id with no
    lookup back to an Entity, so a master write could never reach the
    linked slave's queue. Keyed by the MASTER entity in TtyWorld.pty_pairs
    (see tty_create_pty_pair) so pty_master_write/pty_master_read can find
    the linked slave in one lookup.
    """
    master: Entity
    slave: Entity

struct TermCtl:
    """Controlling-terminal ownership + pending-signal model for a TTY.

    session_id / foreground_pgrp implement the POSIX controlling-terminal
    model: only a caller in the TTY's session may change the foreground
    process group (tty_set_foreground, deny-wins). pending_signal records
    the line discipline's ISIG action as a MODEL (no extern delivery on
    this path): a VINTR byte with ISIG on sets pending_signal = SIGINT
    and pending_signal_pgrp = the foreground pgrp at that instant.
    pending_signal == 0 means "no signal pending".
    """
    session_id: i64
    foreground_pgrp: i64
    pending_signal: i64
    pending_signal_pgrp: i64

# ============================================================================
# TtyWorld — ECS world for all TTY state
# ============================================================================

struct TtyWorld:
    """ECS world that owns all TTY entities and their component data."""
    base: WorldBase
    line_bufs:      ComponentStore<LineBuf>
    termios:        ComponentStore<Termios>
    fg_pgids:       ComponentStore<ForegroundPgid>
    input_sources:  ComponentStore<InputSource>
    output_sinks:   ComponentStore<OutputSink>
    output_bufs:    ComponentStore<OutputBuf>
    input_bufs:     ComponentStore<InputBuf>
    kinds:          ComponentStore<TtyKind>
    pty_pairs:      ComponentStore<PtyPair>
    term_ctls:      ComponentStore<TermCtl>

# NOTE(TERM): the `extern fn signal_deliver` declaration that lived here is
# gone with its last in-file caller — VINTR now records into the TermCtl
# pending-signal model and the kernel-side consumer (which declares its own
# extern, as pm_service.spl does) performs real delivery after draining
# tty_take_pending_signal.

# ============================================================================
# TtyService — public API
# ============================================================================

# ============================================================================
# service_v1 MANIFEST DECLARATION — the TTY service itself.
#
# Master plan §4 (service_v1 ABI), §20 (health/watchdog), §21 (a restart
# retains NO stale grant). The declaration is pure data; the lifecycle hooks
# on TtyService below map it onto the service's existing world.
# ============================================================================

fn tty_service_manifest() -> ServiceManifest:
    """Declared service_v1 manifest for the TTY/PTY service.

    The TTY service is a leaf console provider: it needs the device grants for
    its input source and output sink, and it must not come up before the
    device-server that hands those endpoints out.
    """
    var m = ServiceManifest.create("tty", "service_v1")
    m.required_capabilities = ["dev.console", "dev.serial"]
    m.readiness_deps = ["ds"]
    m.health_check_kind = "heartbeat"
    m.restart_policy = "always"
    m.max_restarts = 5
    m.watchdog_timeout_ms = 2000
    m

class TtyService:
    """POSIX TTY/PTY service for SimpleOS.

    Owns a TtyWorld (ECS world) and exposes a simple API for creating
    TTY entities, configuring Termios, processing input, and reading lines.
    PTY pair creation links master/slave endpoint IDs symmetrically.
    """
    world: TtyWorld
    initialized: bool
    default_cc: [u8]
    # service_v1 manifest for the TTY service. Held DIRECTLY (single field
    # hop) and mutated only via extract-mutate-writeback.
    manifest: ServiceManifest

impl TtyService:
    static fn new() -> TtyService:
        """Create a fresh TtyService with default control characters."""
        # Default cc array: 8 entries, VINTR=3(ETX), VERASE=127, VKILL=21, VEOF=4
        val cc: [u8] = [3, 0, 127, 21, 4, 0, 0, 0]
        TtyService(
            world: TtyWorld(
                base:           WorldBase.new(),
                line_bufs:      ComponentStore.new(),
                termios:        ComponentStore.new(),
                fg_pgids:       ComponentStore.new(),
                input_sources:  ComponentStore.new(),
                output_sinks:   ComponentStore.new(),
                output_bufs:    ComponentStore.new(),
                input_bufs:     ComponentStore.new(),
                kinds:          ComponentStore.new(),
                pty_pairs:      ComponentStore.new(),
                term_ctls:      ComponentStore.new()
            ),
            initialized: true,
            default_cc: cc,
            manifest: tty_service_manifest()
        )

    me tty_create(kind: u32, input_ep: u64, output_ep: u64) -> Entity:
        """Spawn a new TTY entity with the given kind and endpoints.

        Default termios: ICANON | ECHO | ISIG enabled, fg_pgid=0.
        Returns the new entity handle.
        """
        # Extract-mutate-writeback (same two-hop chained-mutating-method-call
        # landmine as output_sinks/output_bufs below, one layer deeper): a
        # bare `self.world.base.spawn()` mutates a discarded copy of
        # WorldBase's EntityAllocator, so every entity spawned this way
        # silently comes back as Entity(id: 0, generation: 1) — the SAME
        # entity every time once a world creates more than one. Discovered
        # while wiring the PTY2 cross-talk oracle (two PTY pairs collapsed
        # onto one shared entity id). Found and fixed in this PTY2
        # increment; not present in P4's state.md because P4's specs never
        # created more than one TTY per TtyService instance, so the
        # collision never manifested there. Filed for the shared
        # `src/lib/*/ecs/world.spl` owners, same as the ComponentStore
        # defect below — out of this lane's exclusive-path scope to fix at
        # the root.
        var base = self.world.base
        val e = base.spawn()
        self.world.base = base
        val t = self.world.base.now()
        val cc: [u8] = [3, 0, 127, 21, 4, 0, 0, 0]
        # NOTE: output_sinks/output_bufs use extract-mutate-writeback (see
        # tty_write below) because a two-hop chained mutating method call
        # (self.world.<store>.insert(...)) does not persist under the
        # current runtime — reproduced in isolation, filed in
        # .spipe/simpleos_harden_p4_tty/state.md. The other component
        # stores below (line_bufs/termios/fg_pgids/input_sources/kinds)
        # keep the pre-existing direct-call form; they carry the same
        # latent defect but fixing them is out of this bounded increment's
        # scope (tty_write delivery only) — see state.md "next increments".
        var output_sinks_store = self.world.output_sinks
        output_sinks_store.insert(e, OutputSink(endpoint: output_ep), t)
        self.world.output_sinks = output_sinks_store
        var output_bufs_store = self.world.output_bufs
        output_bufs_store.insert(e, OutputBuf(bytes: []), t)
        self.world.output_bufs = output_bufs_store
        # Same extract-mutate-writeback requirement as output_bufs above —
        # see the NOTE on output_sinks_store for the two-hop landmine.
        var input_bufs_store = self.world.input_bufs
        input_bufs_store.insert(e, InputBuf(bytes: []), t)
        self.world.input_bufs = input_bufs_store
        # Same extract-mutate-writeback requirement (two-hop landmine).
        # Defaults: no session (0), no foreground pgrp (0), no pending signal.
        var term_ctls_store = self.world.term_ctls
        term_ctls_store.insert(e, TermCtl(
            session_id: 0, foreground_pgrp: 0,
            pending_signal: 0, pending_signal_pgrp: 0), t)
        self.world.term_ctls = term_ctls_store
        # TERM increment: these five stores previously used the direct
        # two-hop chained insert form — verified LOST under both available
        # verification binaries on this host (termios/kinds/line_bufs
        # lookups all came back get_slot=-1, turning the whole line
        # discipline and the pre-existing tty_service_spec red). Converted
        # to the same extract-mutate-writeback pattern as the stores above.
        var line_bufs_store = self.world.line_bufs
        line_bufs_store.insert(e, LineBuf(bytes: [], cap: 4096), t)
        self.world.line_bufs = line_bufs_store
        var termios_store = self.world.termios
        termios_store.insert(e,
            Termios(iflag: 0, oflag: 0, lflag: ICANON | ECHO | ISIG, cc: cc), t)
        self.world.termios = termios_store
        var fg_pgids_store = self.world.fg_pgids
        fg_pgids_store.insert(e, ForegroundPgid(value: 0), t)
        self.world.fg_pgids = fg_pgids_store
        var input_sources_store = self.world.input_sources
        input_sources_store.insert(e, InputSource(endpoint: input_ep), t)
        self.world.input_sources = input_sources_store
        var kinds_store = self.world.kinds
        kinds_store.insert(e, TtyKind(kind: kind), t)
        self.world.kinds = kinds_store
        e

    me tty_set_termios(tty: Entity, iflag: u32, oflag: u32, lflag: u32):
        """Update the Termios flags for a TTY, preserving existing cc array."""
        val slot = self.world.termios.get_slot(tty)
        if slot >= 0:
            val old_cc = self.world.termios.dense[slot].cc
            val t = self.world.base.now()
            # Extract-mutate-writeback (two-hop chained insert is lost).
            var termios_store = self.world.termios
            termios_store.insert(tty,
                Termios(iflag: iflag, oflag: oflag, lflag: lflag, cc: old_cc), t)
            self.world.termios = termios_store

    fn tty_get_termios(tty: Entity) -> Termios?:
        """Return the Termios for a TTY, or nil if entity not found."""
        val slot = self.world.termios.get_slot(tty)
        if slot < 0:
            return nil
        self.world.termios.dense[slot]

    me tty_set_fg_pgid(tty: Entity, pgid: u32) -> bool:
        """Set the foreground process group ID for this TTY.

        Returns true if the TTY entity exists, false otherwise.
        """
        val slot = self.world.fg_pgids.get_slot(tty)
        if slot < 0:
            return false
        val t = self.world.base.now()
        # Extract-mutate-writeback (two-hop chained insert is lost).
        var fg_pgids_store = self.world.fg_pgids
        fg_pgids_store.insert(tty, ForegroundPgid(value: pgid), t)
        self.world.fg_pgids = fg_pgids_store
        true

    fn tty_fg_pgid(tty: Entity) -> u32:
        """Return the foreground pgid for this TTY (0 if not set or not found)."""
        val slot = self.world.fg_pgids.get_slot(tty)
        if slot < 0:
            return 0
        self.world.fg_pgids.dense[slot].value

    me tty_input_char(tty: Entity, ch: u8) -> i32:
        """Process one input byte through the TTY line discipline.

        Returns:
          >0  — character should be delivered to the reader
           0  — character swallowed (e.g. Ctrl-C triggered SIGINT, Ctrl-D in canonical)
          <0  — error (TTY entity not found)

        In ICANON|ISIG mode, the byte matching cc[VINTR] causes signal_deliver
        to be called with SIGINT for the foreground pgid, and the byte is swallowed.
        In ICANON mode, printable bytes accumulate in LineBuf; '\\n' delivers the line.
        In raw mode (ICANON off), every byte is immediately delivered.
        """
        val tios_slot = self.world.termios.get_slot(tty)
        if tios_slot < 0:
            return -1
        val tios = self.world.termios.dense[tios_slot]
        val is_canon = (tios.lflag & ICANON) != 0
        val is_sig   = (tios.lflag & ISIG) != 0

        # Check VINTR (Ctrl-C = ETX = 3 by default).
        # TERM increment: records the SIGINT in the TermCtl pending-signal
        # model (targeted at the TERM foreground pgrp) instead of calling
        # the kernel-wired `signal_deliver` extern directly — the extern is
        # only resolvable in-guest, so the direct call made this path
        # unverifiable (and failing) on host. The kernel-side consumer
        # drains via tty_take_pending_signal and performs real delivery.
        if is_canon and is_sig:
            val vintr_char = tios.cc[VINTR]
            if ch == vintr_char:
                val ctl_slot = self.world.term_ctls.get_slot(tty)
                if ctl_slot >= 0:
                    val old_ctl = self.world.term_ctls.dense[ctl_slot]
                    val t0 = self.world.base.now()
                    var ctl_store = self.world.term_ctls
                    ctl_store.insert(tty, TermCtl(
                        session_id: old_ctl.session_id,
                        foreground_pgrp: old_ctl.foreground_pgrp,
                        pending_signal: SIGINT as i64,
                        pending_signal_pgrp: old_ctl.foreground_pgrp), t0)
                    self.world.term_ctls = ctl_store
                return 0

        if is_canon:
            # Accumulate into line buffer
            val buf_slot = self.world.line_bufs.get_slot(tty)
            if buf_slot < 0:
                return -1
            val old_buf = self.world.line_bufs.dense[buf_slot]
            val new_bytes = old_buf.bytes.push(ch)
            val t = self.world.base.now()
            # Extract-mutate-writeback (two-hop chained insert is lost).
            var line_bufs_store = self.world.line_bufs
            line_bufs_store.insert(tty,
                LineBuf(bytes: new_bytes, cap: old_buf.cap), t)
            self.world.line_bufs = line_bufs_store
            # Deliver only when newline arrives
            if ch == 10:
                return 1
            return 0
        else:
            # Raw mode: deliver immediately
            return 1

    me tty_read_line(tty: Entity) -> [u8]:
        """Drain the LineBuf and return its contents if a newline is present.

        In ICANON mode, returns the accumulated line (including '\\n') and clears
        the buffer. Returns an empty array if no newline yet or TTY not found.
        """
        val buf_slot = self.world.line_bufs.get_slot(tty)
        if buf_slot < 0:
            return []
        val old_buf = self.world.line_bufs.dense[buf_slot]
        # Check if a newline is present
        val len = old_buf.bytes.len()
        var has_newline = false
        var i = 0
        while i < len:
            if old_buf.bytes[i] == 10:
                has_newline = true
            i = i + 1
        if not has_newline:
            return []
        # Drain the buffer
        val result = old_buf.bytes
        val t = self.world.base.now()
        # Extract-mutate-writeback (two-hop chained insert is lost).
        var line_bufs_store = self.world.line_bufs
        line_bufs_store.insert(tty,
            LineBuf(bytes: [], cap: old_buf.cap), t)
        self.world.line_bufs = line_bufs_store
        result

    me tty_write(tty: Entity, bytes: [u8]) -> i32:
        """Write bytes to the TTY output sink.

        Appends the bytes to the entity's OutputBuf so a subsequent
        tty_read_output() call observes them (real delivery, not just an
        accepted-count bookkeeping op). Returns the number of bytes
        delivered (== len of input array), or -1 if the TTY entity does
        not exist.
        """
        val sink_slot = self.world.output_sinks.get_slot(tty)
        if sink_slot < 0:
            return -1
        val buf_slot = self.world.output_bufs.get_slot(tty)
        if buf_slot < 0:
            return -1
        val old_buf = self.world.output_bufs.dense[buf_slot]
        var new_bytes = old_buf.bytes
        var i = 0
        val n = bytes.len()
        while i < n:
            new_bytes = new_bytes.push(bytes[i])
            i = i + 1
        val t = self.world.base.now()
        # NOTE: must extract-mutate-writeback rather than call
        # `self.world.output_bufs.insert(...)` directly — a two-hop chained
        # mutating method call (self.<struct-field>.<struct-field>.insert())
        # does not persist under the current interpreter/native runtime
        # (reproduced in isolation; filed as a runtime defect, out of this
        # lane's scope to fix — see .spipe/simpleos_harden_p4_tty/state.md).
        var buf_store = self.world.output_bufs
        buf_store.insert(tty, OutputBuf(bytes: new_bytes), t)
        self.world.output_bufs = buf_store
        bytes.len() as i32

    me tty_read_output(tty: Entity) -> [u8]:
        """Drain the TTY's OutputBuf and return the bytes delivered so far.

        This is the reader side of tty_write's output path — the
        console/serial reader drains this queue to observe written bytes.
        Returns an empty array if the TTY does not exist or nothing has
        been written since the last drain.
        """
        val buf_slot = self.world.output_bufs.get_slot(tty)
        if buf_slot < 0:
            return []
        val old_buf = self.world.output_bufs.dense[buf_slot]
        val result = old_buf.bytes
        val t = self.world.base.now()
        var buf_store = self.world.output_bufs
        buf_store.insert(tty, OutputBuf(bytes: []), t)
        self.world.output_bufs = buf_store
        result

    me tty_write_input(tty: Entity, bytes: [u8]) -> i32:
        """Append bytes directly to an entity's InputBuf (the raw queue op).

        Real delivery, not an accepted-count bookkeeping op — mirrors
        tty_write's contract but targets InputBuf instead of OutputBuf.
        Returns the number of bytes delivered (== len of input array), or
        -1 if the TTY entity does not exist.
        """
        val buf_slot = self.world.input_bufs.get_slot(tty)
        if buf_slot < 0:
            return -1
        val old_buf = self.world.input_bufs.dense[buf_slot]
        var new_bytes = old_buf.bytes
        var i = 0
        val n = bytes.len()
        while i < n:
            new_bytes = new_bytes.push(bytes[i])
            i = i + 1
        val t = self.world.base.now()
        # Same extract-mutate-writeback requirement as tty_write/output_bufs
        # above — two-hop chained `self.world.input_bufs.insert(...)` does
        # not persist under the current runtime.
        var buf_store = self.world.input_bufs
        buf_store.insert(tty, InputBuf(bytes: new_bytes), t)
        self.world.input_bufs = buf_store
        bytes.len() as i32

    me tty_read_input(tty: Entity) -> [u8]:
        """Drain the TTY's InputBuf and return the bytes delivered so far.

        This is the "shell read" side of the PTY master->slave data path —
        the shell attached to the slave drains this queue to observe bytes
        written by the PTY master. Returns an empty array if the TTY does
        not exist or nothing has been written since the last drain.
        """
        val buf_slot = self.world.input_bufs.get_slot(tty)
        if buf_slot < 0:
            return []
        val old_buf = self.world.input_bufs.dense[buf_slot]
        val result = old_buf.bytes
        val t = self.world.base.now()
        var buf_store = self.world.input_bufs
        buf_store.insert(tty, InputBuf(bytes: []), t)
        self.world.input_bufs = buf_store
        result

    me tty_create_pty_pair(self) -> (Entity, Entity):
        """Create a linked PTY master/slave pair.

        The master's InputSource endpoint is used as the slave's OutputSink
        endpoint and vice versa, forming a bidirectional pipe. Also wires
        the real entity->entity routing layer (PtyPair component, keyed by
        the master entity) that pty_master_write/pty_master_read use — this
        is what P4 deferred ("needs an endpoint->entity routing layer that
        did not exist"). Returns (master_entity, slave_entity).
        """
        # Endpoint IDs: use world tick to generate unique values
        val t = self.world.base.now()
        val master_ep: u64 = (t + 1) as u64
        val slave_ep: u64  = (t + 2) as u64
        val master = self.tty_create(TTY_PTY_MASTER, master_ep, slave_ep)
        val slave  = self.tty_create(TTY_PTY_SLAVE,  slave_ep,  master_ep)
        # Extract-mutate-writeback (see landmine notes above) — insert the
        # routing link keyed by the master entity only; both directions of
        # traffic are reachable from `master` via pair.slave.
        var pair_store = self.world.pty_pairs
        pair_store.insert(master, PtyPair(master: master, slave: slave), t)
        self.world.pty_pairs = pair_store
        (master, slave)

    me pty_master_write(master: Entity, bytes: [u8]) -> i32:
        """PTY master write: append bytes to the linked SLAVE's InputBuf.

        This is "master write -> slave input queue" (master plan §10.1).
        The shell attached to the slave observes these bytes via
        tty_read_input(slave). Routes through the PtyPair component keyed
        by `master` (see tty_create_pty_pair) — cross-talk between unrelated
        pairs is impossible because each master entity id maps to exactly
        one PtyPair. Returns the delivered byte count, or -1 if `master` is
        not a known PTY master (no linked pair) or the slave entity is
        somehow gone.
        """
        val pair_slot = self.world.pty_pairs.get_slot(master)
        if pair_slot < 0:
            return -1
        val pair = self.world.pty_pairs.dense[pair_slot]
        self.tty_write_input(pair.slave, bytes)

    me pty_slave_write(slave: Entity, bytes: [u8]) -> i32:
        """PTY slave write ("shell write"): append bytes to the slave's own
        OutputBuf. This is exactly tty_write — a thin, explicitly-named
        wrapper for the "shell write -> slave output queue -> PTY master
        read" direction (master plan §10.1).
        """
        self.tty_write(slave, bytes)

    me pty_master_read(master: Entity) -> [u8]:
        """PTY master read: drain bytes the SLAVE wrote to its OutputBuf.

        This is "shell write -> slave output queue -> PTY master read"
        (master plan §10.1), the reverse direction of pty_master_write.
        Routes through the same PtyPair component keyed by `master`.
        Returns an empty array if `master` has no linked pair.
        """
        val pair_slot = self.world.pty_pairs.get_slot(master)
        if pair_slot < 0:
            return []
        val pair = self.world.pty_pairs.dense[pair_slot]
        self.tty_read_output(pair.slave)

    # ------------------------------------------------------------------
    # Controlling terminal / session / foreground process group (TERM)
    # ------------------------------------------------------------------

    me tty_set_session(tty: Entity, session_id: i64) -> bool:
        """Attach this TTY as the controlling terminal of `session_id`.

        Preserves foreground_pgrp and any pending signal. Returns false
        (fail closed) if the TTY entity does not exist.
        """
        val slot = self.world.term_ctls.get_slot(tty)
        if slot < 0:
            return false
        val old = self.world.term_ctls.dense[slot]
        val t = self.world.base.now()
        var ctl_store = self.world.term_ctls
        ctl_store.insert(tty, TermCtl(
            session_id: session_id,
            foreground_pgrp: old.foreground_pgrp,
            pending_signal: old.pending_signal,
            pending_signal_pgrp: old.pending_signal_pgrp), t)
        self.world.term_ctls = ctl_store
        true

    fn tty_session_id(tty: Entity) -> i64:
        """Return the owning session id (0 = no controlling session / not found)."""
        val slot = self.world.term_ctls.get_slot(tty)
        if slot < 0:
            return 0
        self.world.term_ctls.dense[slot].session_id

    me tty_set_foreground(tty: Entity, caller_session: i64, pgrp: i64) -> bool:
        """Set the foreground process group — session-checked, deny-wins.

        Succeeds ONLY when the caller's session equals the TTY's owning
        session. Unknown entity or session mismatch both fail closed
        (return false, foreground_pgrp unchanged).
        """
        val slot = self.world.term_ctls.get_slot(tty)
        if slot < 0:
            return false
        val old = self.world.term_ctls.dense[slot]
        if caller_session != old.session_id:
            return false
        val t = self.world.base.now()
        var ctl_store = self.world.term_ctls
        ctl_store.insert(tty, TermCtl(
            session_id: old.session_id,
            foreground_pgrp: pgrp,
            pending_signal: old.pending_signal,
            pending_signal_pgrp: old.pending_signal_pgrp), t)
        self.world.term_ctls = ctl_store
        true

    fn tty_foreground_pgrp(tty: Entity) -> i64:
        """Return the foreground process group (0 = none / not found)."""
        val slot = self.world.term_ctls.get_slot(tty)
        if slot < 0:
            return 0
        self.world.term_ctls.dense[slot].foreground_pgrp

    fn tty_pending_signal(tty: Entity) -> i64:
        """Return the pending signal number recorded by ISIG (0 = none)."""
        val slot = self.world.term_ctls.get_slot(tty)
        if slot < 0:
            return 0
        self.world.term_ctls.dense[slot].pending_signal

    fn tty_pending_signal_pgrp(tty: Entity) -> i64:
        """Return the pgrp the pending signal targets (0 = none)."""
        val slot = self.world.term_ctls.get_slot(tty)
        if slot < 0:
            return 0
        self.world.term_ctls.dense[slot].pending_signal_pgrp

    me tty_take_pending_signal(tty: Entity) -> i64:
        """Consume and return the pending signal (0 if none); clears it."""
        val slot = self.world.term_ctls.get_slot(tty)
        if slot < 0:
            return 0
        val old = self.world.term_ctls.dense[slot]
        val signo = old.pending_signal
        if signo == 0:
            return 0
        val t = self.world.base.now()
        var ctl_store = self.world.term_ctls
        ctl_store.insert(tty, TermCtl(
            session_id: old.session_id,
            foreground_pgrp: old.foreground_pgrp,
            pending_signal: 0,
            pending_signal_pgrp: 0), t)
        self.world.term_ctls = ctl_store
        signo

    # ------------------------------------------------------------------
    # Termios line discipline across the PTY boundary (TERM)
    # ------------------------------------------------------------------

    me tty_ld_input(tty: Entity, ch: u8) -> i32:
        """Run ONE input byte through this TTY's termios line discipline.

        The TTY entity itself is the terminal (for a PTY this is the
        SLAVE): delivered bytes land in its InputBuf (drained by
        tty_read_input, the shell-read side), echo lands in its OutputBuf
        (drained by pty_master_read, the master-readable side).

        Order (matches POSIX intent, simplest model):
          1. ISIG on + ch == cc[VINTR]  -> record pending SIGINT targeted
             at the current foreground pgrp; byte NEVER enters the input
             stream and is not echoed. Returns 0.
          2. ECHO on                    -> byte appended to OutputBuf.
          3. ICANON on: accumulate in LineBuf; on '\\n' the whole line
             (newline included) is flushed to InputBuf (returns 1); on
             cc[VEOF] the accumulated partial line (EOF byte excluded) is
             flushed (returns 1 if anything flushed, else 0); otherwise
             returns 0 (line still gated).
             ICANON off: byte delivered to InputBuf immediately (returns 1).
        Returns -1 if the TTY has no Termios (unknown entity).
        """
        val tios_slot = self.world.termios.get_slot(tty)
        if tios_slot < 0:
            return -1
        val tios = self.world.termios.dense[tios_slot]
        val is_sig   = (tios.lflag & ISIG) != 0
        val is_echo  = (tios.lflag & ECHO) != 0
        val is_canon = (tios.lflag & ICANON) != 0

        # 1. ISIG: VINTR is swallowed and recorded, never delivered.
        if is_sig and ch == tios.cc[VINTR]:
            val ctl_slot = self.world.term_ctls.get_slot(tty)
            if ctl_slot >= 0:
                val old = self.world.term_ctls.dense[ctl_slot]
                val t0 = self.world.base.now()
                var ctl_store = self.world.term_ctls
                ctl_store.insert(tty, TermCtl(
                    session_id: old.session_id,
                    foreground_pgrp: old.foreground_pgrp,
                    pending_signal: SIGINT as i64,
                    pending_signal_pgrp: old.foreground_pgrp), t0)
                self.world.term_ctls = ctl_store
            return 0

        # 2. ECHO: input byte echoed to the master-readable output queue.
        if is_echo:
            val echo_bytes: [u8] = [ch]
            self.tty_write(tty, echo_bytes)

        # 3. Canonical gating vs raw passthrough.
        if is_canon:
            val buf_slot = self.world.line_bufs.get_slot(tty)
            if buf_slot < 0:
                return -1
            val old_buf = self.world.line_bufs.dense[buf_slot]
            val t = self.world.base.now()
            if ch == tios.cc[VEOF]:
                # EOF: flush the partial line (EOF byte excluded).
                val pending = old_buf.bytes
                var lb_eof = self.world.line_bufs
                lb_eof.insert(tty, LineBuf(bytes: [], cap: old_buf.cap), t)
                self.world.line_bufs = lb_eof
                if pending.len() == 0:
                    return 0
                self.tty_write_input(tty, pending)
                return 1
            val new_bytes = old_buf.bytes.push(ch)
            if ch == 10:
                # Newline: line (incl. '\n') becomes readable by the slave.
                var lb_nl = self.world.line_bufs
                lb_nl.insert(tty, LineBuf(bytes: [], cap: old_buf.cap), t)
                self.world.line_bufs = lb_nl
                self.tty_write_input(tty, new_bytes)
                return 1
            # Still gated: keep accumulating (extract-mutate-writeback).
            var lb_acc = self.world.line_bufs
            lb_acc.insert(tty, LineBuf(bytes: new_bytes, cap: old_buf.cap), t)
            self.world.line_bufs = lb_acc
            return 0
        else:
            # Raw mode: deliver immediately.
            val one: [u8] = [ch]
            self.tty_write_input(tty, one)
            return 1

    me pty_master_write_ld(master: Entity, bytes: [u8]) -> i32:
        """PTY master write THROUGH the slave's termios line discipline.

        The line-discipline sibling of pty_master_write (which stays the
        raw queue op): each byte runs through tty_ld_input on the linked
        SLAVE, so canonical mode gates lines until '\\n'/VEOF, ECHO
        reflects bytes into the master-readable queue, and ISIG turns
        VINTR into a pending SIGINT for the slave's foreground pgrp.
        Returns the number of bytes consumed, or -1 if `master` has no
        linked pair.
        """
        val pair_slot = self.world.pty_pairs.get_slot(master)
        if pair_slot < 0:
            return -1
        val pair = self.world.pty_pairs.dense[pair_slot]
        var i = 0
        val n = bytes.len()
        while i < n:
            self.tty_ld_input(pair.slave, bytes[i])
            i = i + 1
        n as i32

    fn tty_count(self) -> i32:
        """Return the number of live TTY entities (tracked via kinds store)."""
        self.world.kinds.len()

    # ------------------------------------------------------------------
    # service_v1 lifecycle hooks (SVC lane)
    #
    # Every hook is extract-mutate-writeback on `self.manifest`: a
    # `self.manifest.<mutate>()` chain crosses into the imported
    # ServiceManifest struct and is silently lost (bug
    # selfhost_two_hop_field_method_mutation_lost_2026-07-27). The
    # service_manifest.spl functions are pure and RETURN a new manifest, so
    # the write-back is what commits the transition.
    # ------------------------------------------------------------------

    fn svc_manifest(self) -> ServiceManifest:
        self.manifest

    fn svc_name(self) -> text:
        self.manifest.name

    fn svc_state(self) -> text:
        self.manifest.state

    fn svc_grants(self) -> [text]:
        self.manifest.granted_handles

    fn svc_restart_count(self) -> i64:
        self.manifest.restart_count

    fn svc_holds_grants(self) -> bool:
        holds_grants(self.manifest)

    me svc_start(ready_set: [text]) -> bool:
        """Lifecycle hook: start. Refuses while a readiness dep is missing."""
        if not can_start(self.manifest, ready_set):
            return false
        var m = self.manifest
        m = mark_starting(m)
        self.manifest = m
        true

    me svc_acquire_grant(handle: text):
        """Take a device grant (console/serial endpoint) from the broker."""
        var m = self.manifest
        var g = m.granted_handles
        g = g.push(handle)
        m.granted_handles = g
        self.manifest = m

    me svc_ready():
        var m = self.manifest
        m = mark_ready(m)
        self.manifest = m

    me svc_heartbeat(now_ms: i64):
        var m = self.manifest
        m = record_heartbeat(m, now_ms)
        self.manifest = m

    me svc_watchdog(now_ms: i64) -> text:
        var m = self.manifest
        m = check_watchdog(m, now_ms)
        self.manifest = m
        self.manifest.state

    fn svc_world_invariant(self) -> bool:
        """Health from the service's OWN state: no TTY may carry a pending
        signal whose target pgrp is stale (a recorded signal with no pgrp, or
        a targeted pgrp with no signal, means the ISIG path tore).
        """
        var i = 0
        val n = self.world.term_ctls.dense.len()
        while i < n:
            val c = self.world.term_ctls.dense[i]
            if c.pending_signal != 0 and c.pending_signal_pgrp == 0:
                return false
            if c.pending_signal == 0 and c.pending_signal_pgrp != 0:
                return false
            i = i + 1
        true

    me svc_health_check() -> text:
        val ok = self.svc_world_invariant()
        var m = self.manifest
        m = record_health(m, ok)
        self.manifest = m
        self.manifest.state

    fn svc_restart_allowed(self) -> bool:
        should_restart(self.manifest.restart_policy, self.manifest.restart_count, self.manifest.max_restarts)

    fn svc_pending_signal_total(self) -> i64:
        """How many TTYs still carry a pending signal (0 after a restart)."""
        var total = 0
        var i = 0
        val n = self.world.term_ctls.dense.len()
        while i < n:
            if self.world.term_ctls.dense[i].pending_signal != 0:
                total = total + 1
            i = i + 1
        total

    # ------------------------------------------------------------------
    # Lifecycle hook: RESTART — the §21 invariant for the TTY service.
    #
    # Returns false (nothing changes) once the restart limit is spent. On a
    # permitted restart:
    #   * on_restart() clears the manifest's granted_handles — the respawned
    #     service re-acquires its console/serial device grants from the
    #     broker and inherits none;
    #   * and EVERY TTY's pending_signal / pending_signal_pgrp is cleared.
    #     A pending signal is authority aimed at a process group that was
    #     resolved by the PRE-restart service; letting it survive would
    #     deliver a SIGINT chosen by a dead instance to whatever process
    #     group now happens to own that pgrp number. Session ownership and
    #     the current foreground pgrp are DELIBERATELY preserved — those are
    #     the controlling-terminal binding, not pending authority.
    # ------------------------------------------------------------------
    me svc_restart() -> bool:
        if not self.svc_restart_allowed():
            return false

        # 1. Manifest-level §21: drop every device grant the service held.
        var m = self.manifest
        m = on_restart(m)
        self.manifest = m

        # 2. Per-TTY §21: no pending-signal targeting survives the restart.
        #    Extract-mutate-writeback through the ComponentStore column — a
        #    bare self.world.term_ctls.dense[i] = ... is a two-hop mutation
        #    into an imported struct and is silently discarded.
        var ctl_store = self.world.term_ctls
        var d = ctl_store.dense
        var i = 0
        val n = d.len()
        while i < n:
            val old = d[i]
            d[i] = TermCtl(
                session_id: old.session_id,
                foreground_pgrp: old.foreground_pgrp,
                pending_signal: 0,
                pending_signal_pgrp: 0)
            i = i + 1
        ctl_store.dense = d
        self.world.term_ctls = ctl_store

        # 3. Re-enter Starting — grants must be re-acquired before Ready.
        var m2 = self.manifest
        m2 = mark_starting(m2)
        self.manifest = m2
        true

    me svc_stop():
        var m = self.manifest
        m = mark_stopping(m)
        self.manifest = m
        var m2 = self.manifest
        m2 = mark_stopped(m2)
        self.manifest = m2
