# Driver -> HostInputEvent adapter (WS-C C1).
#
# This is the ONE place where the PS/2-shaped driver vocabulary
# (`ps2_keyboard.KeyEvent` + `ps2_mouse.MouseEvent`) is reconciled with the
# single ingress type `common.ui.host_input_event.HostInputEvent`.
#
# Conventions inherited from host_input_event.spl (that file owns them; nothing
# here re-derives or negates them):
#   - `wheel` positive = content scrolls DOWN. ps2_mouse.MouseEvent.wheel is
#     already in that sign (see its file header), so this adapter copies it
#     through unchanged.
#   - a pure motion event is `button: HOST_BTN_NONE, pressed: true`
#     (`host_pointer_move`); that pair is how the reducer tells move from press.
#   - `HostInputEvent.Pointer` carries NO dx/dy. The PS/2 deltas are already
#     integrated into the absolute x/y by the driver, and the only consumer
#     (compositor cursor placement) read x/y, never dx/dy — so nothing is lost.
#
# `Key.code` is the CANONICAL code space owned by `common.ui.key_code` (Windows
# VK / W3C keyCode). `ps2_key_code` therefore delegates to
# `ps2_keyboard.key_to_canon` rather than carrying a table of its own: this file
# is the only site in the tree that fills `HostInputEvent.Key.code`, so a local
# table here IS the "second, competing code space" the header used to warn
# about. It was one — it named 13 keys and returned 0 for the other 65,
# including every letter, digit and function key.

use os.drivers.input.ps2_keyboard.{Key, KeyEvent, key_to_canon}
use os.drivers.input.ps2_mouse.{MouseEvent}
use common.ui.host_input_event.{
    HostInputEvent,
    HOST_BTN_NONE,
    HOST_BTN_LEFT,
    HOST_BTN_RIGHT,
    HOST_BTN_MIDDLE,
    HOST_MOD_SHIFT,
    HOST_MOD_CTRL,
    HOST_MOD_ALT,
    HOST_MOD_META,
    host_pointer_down,
    host_pointer_up,
    host_pointer_move,
    host_key_down,
    host_key_up,
}

# ============================================================================
# Modifier packing
# ============================================================================

fn mods_pack(shift: bool, ctrl: bool, alt: bool, meta: bool) -> i64:
    """Pack held-modifier booleans into the HostInputEvent `mods` bitfield.

    There is deliberately no caps-lock bit: `HostInputEvent` defines only
    SHIFT/CTRL/ALT/META, and caps-lock is already folded into the resolved
    character by `Ps2Keyboard.key_to_char`."""
    var m: i64 = 0
    if shift:
        m = m | HOST_MOD_SHIFT
    if ctrl:
        m = m | HOST_MOD_CTRL
    if alt:
        m = m | HOST_MOD_ALT
    if meta:
        m = m | HOST_MOD_META
    m

fn mods_has_shift(mods: i64) -> bool:
    """True when the SHIFT bit is set in a HostInputEvent `mods` field."""
    (mods & HOST_MOD_SHIFT) != 0

fn mods_has_ctrl(mods: i64) -> bool:
    """True when the CTRL bit is set in a HostInputEvent `mods` field."""
    (mods & HOST_MOD_CTRL) != 0

fn mods_has_alt(mods: i64) -> bool:
    """True when the ALT bit is set in a HostInputEvent `mods` field."""
    (mods & HOST_MOD_ALT) != 0

# ============================================================================
# Key codes
# ============================================================================

fn ps2_key_code(k: Key) -> i64:
    """Canonical numeric code for a decoded PS/2 key.

    A thin alias of `ps2_keyboard.key_to_canon`, which is the single seam from
    the symbolic `Key` enum to the canonical space and is shared by all four
    producers (PS/2, evdev, SDL2, winit). Unmapped keys are CANON_UNKNOWN (0),
    meaning "no code, use `ch`" — same contract as before, now over the whole
    keyboard instead of 13 keys.

    Cross-producer equality is pinned at absolute VK integers in
    `test/01_unit/os/input/producer_key_canon_spec.spl`."""
    key_to_canon(k)

# ============================================================================
# Event translation
# ============================================================================

fn host_key_event_from_ps2(
    ev: KeyEvent,
    ch: text,
    shift: bool,
    ctrl: bool,
    alt: bool
) -> HostInputEvent:
    """Translate a decoded PS/2 key event into ingress form.

    `ch` is the already-resolved printable character (from
    `Ps2Keyboard.key_to_char`, which owns the shift/caps matrix), or "" for a
    non-printing key. Modifier state is sampled at poll time by the caller."""
    val mods = mods_pack(shift: shift, ctrl: ctrl, alt: alt, meta: false)
    match ev:
        KeyEvent.Press(key):
            host_key_down(ps2_key_code(key), ch, mods)
        KeyEvent.Release(key):
            host_key_up(ps2_key_code(key), ch, mods)

fn host_pointer_event_from_ps2(ev: MouseEvent) -> HostInputEvent:
    """Translate a PS/2 mouse event into exactly ONE ingress pointer event.

    The driver event is level+edge shaped (it carries `left_pressed` AND
    `left_just_pressed` AND `left_just_released` simultaneously); the ingress
    type is one button plus one pressed flag. The priority order below
    reproduces, edge for edge, the branch order the compositor used against the
    driver struct before unification -- see `Compositor._apply_host_event`,
    which decodes it back into the same (button_code, kind_code) pair."""
    # `as` casts, not `.to_i32()`: bare scalar conversions can dispatch to the
    # wrong struct's method under the freestanding alias bridge (lint FSK003),
    # and this adapter runs inside the kernel-side compositor.
    val x = ev.x as i32
    val y = ev.y as i32
    val wheel = ev.wheel as i32
    if ev.left_just_pressed:
        return HostInputEvent.Pointer(
            x: x, y: y, button: HOST_BTN_LEFT, pressed: true, wheel: wheel
        )
    if ev.right_just_pressed:
        return HostInputEvent.Pointer(
            x: x, y: y, button: HOST_BTN_RIGHT, pressed: true, wheel: wheel
        )
    if ev.left_just_released:
        return HostInputEvent.Pointer(
            x: x, y: y, button: HOST_BTN_LEFT, pressed: false, wheel: wheel
        )
    if ev.middle_pressed:
        # Level-held middle button: the legacy path reported the button but
        # kept the "move" kind, so this stays a motion-shaped event that
        # merely names the button.
        return HostInputEvent.Pointer(
            x: x, y: y, button: HOST_BTN_MIDDLE, pressed: true, wheel: wheel
        )
    HostInputEvent.Pointer(
        x: x, y: y, button: HOST_BTN_NONE, pressed: true, wheel: wheel
    )

export mods_pack, mods_has_shift, mods_has_ctrl, mods_has_alt
export ps2_key_code
export host_key_event_from_ps2, host_pointer_event_from_ps2
