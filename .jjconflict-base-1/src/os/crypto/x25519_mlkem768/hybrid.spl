mod os.crypto.x25519_mlkem768.hybrid
use lib.common.crypto.x25519_mlkem768.contract.{
    X25519MlKem768Backend, X25519MlKem768SelectionMode,
    X25519MlKem768Config, X25519MlKem768Evidence,
    X25519MlKem768SimdAdmission, X25519MlKem768KeyPair,
    X25519MlKem768Encapsulation, X25519MlKem768Decapsulation,
    X25519_MLKEM768_CLIENT_SHARE_BYTES,
    X25519_MLKEM768_SERVER_SHARE_BYTES,
    X25519_MLKEM768_SHARED_SECRET_BYTES}
use os.crypto.x25519_mlkem768.execution_policy.{x25519_mlkem768_resolve_backend,
    x25519_mlkem768_resolve_cuda_candidate,
    x25519_mlkem768_resolve_metal_candidate,
    x25519_mlkem768_resolve_vulkan_candidate}
use os.crypto.ml_kem.{
    ml_kem_keygen_checked, ml_kem_encaps_checked, ml_kem_decaps_checked,
    ml_kem_keygen_checked_simd, ml_kem_encaps_checked_simd,
    ml_kem_decaps_checked_simd,
    ml_kem_keygen_checked_provider, ml_kem_encaps_checked_provider,
    ml_kem_decaps_checked_provider}
use os.crypto.x25519_mlkem768.cuda_ntt_provider.{X25519MlKem768CudaNttExecutor}
use os.crypto.x25519_mlkem768.metal_ntt_provider.{X25519MlKem768MetalNttExecutor}
use os.crypto.x25519_mlkem768.vulkan_ntt_provider.{X25519MlKem768VulkanNttExecutor}
use os.crypto.x25519_mlkem768.gpu_operation_evidence.{
    x25519_mlkem768_verify_gpu_keygen,
    x25519_mlkem768_verify_gpu_encapsulate,
    x25519_mlkem768_verify_gpu_decapsulate,
    x25519_mlkem768_cuda_operation_evidence,
    x25519_mlkem768_metal_operation_evidence,
    x25519_mlkem768_vulkan_operation_evidence}
use os.crypto.x25519_mlkem768.simd_operation_evidence.{
    x25519_mlkem768_simd_operation_evidence}
use os.crypto.curve25519.{x25519, x25519_base}
use std.simd.{mlkem_ntt_simd_receipt, mlkem_ntt_simd_reset}
use std.nogc_sync_mut.io.time_ops.{time_now_nanos}
use os.crypto.x25519_mlkem768.hybrid_support.{
    x25519_mlkem768_wipe_owned as _wipe_hybrid_owned,
    x25519_mlkem768_wipe_owned_bytes as _wipe_hybrid_owned_bytes,
    x25519_mlkem768_slice_list as _slice_list,
    x25519_mlkem768_slice_bytes as _slice_bytes,
    x25519_mlkem768_digest as _hybrid_digest,
    x25519_mlkem768_buffer_error_text as _buffer_error_text,
    x25519_mlkem768_append_bytes as _append_bytes,
    x25519_mlkem768_lists_equal as _hybrid_lists_equal,
    x25519_mlkem768_bytes_valid as _hybrid_bytes_valid,
    x25519_mlkem768_bytes_all_zero as _x25519_is_all_zero,
    x25519_mlkem768_resolve_admitted_simd as _resolve_admitted_simd_candidate,
    x25519_mlkem768_keygen_fixture_digest as _keygen_fixture_digest,
    x25519_mlkem768_encapsulate_fixture_digest as _encapsulate_fixture_digest,
    x25519_mlkem768_decapsulate_fixture_digest as _decapsulate_fixture_digest}

fn _slice_list_text(values: list, start: i64,
        count: i64) -> Result<list, text>:
    match _slice_list(values, start, count):
        case Ok(value): Ok(value)
        case Err(error): Err(_buffer_error_text(error))

fn _slice_bytes_text(values: list, start: i64,
        count: i64) -> Result<[u8], text>:
    match _slice_bytes(values, start, count):
        case Ok(value): Ok(value)
        case Err(error): Err(_buffer_error_text(error))

fn _hybrid_digest_text(values: list) -> Result<text, text>:
    match _hybrid_digest(values):
        case Ok(value): Ok(value)
        case Err(error): Err(_buffer_error_text(error))

fn _keygen_fixture_digest_text(values: list) -> Result<text, text>:
    match _keygen_fixture_digest(values):
        case Ok(value): Ok(value)
        case Err(error): Err(_buffer_error_text(error))

fn _encapsulate_fixture_digest_text(values: list) -> Result<text, text>:
    match _encapsulate_fixture_digest(values):
        case Ok(value): Ok(value)
        case Err(error): Err(_buffer_error_text(error))

fn _decapsulate_fixture_digest_text(values: list) -> Result<text, text>:
    match _decapsulate_fixture_digest(values):
        case Ok(value): Ok(value)
        case Err(error): Err(_buffer_error_text(error))

fn _copy_hybrid_list(values: list) -> list:
    var copied: list = []
    var index: i64 = 0
    while index < values.len():
        copied.push(values.get(index))
        index = index + 1
    copied

fn _copy_hybrid_bytes(values: [u8]) -> [u8]:
    var copied: [u8] = []
    var index: i64 = 0
    while index < values.len():
        copied.push(values[index])
        index = index + 1
    copied

fn x25519_mlkem768_combine(mlkem_shared: list,
        x25519_shared: [u8]) -> Result<list, text>:
    if mlkem_shared.len() != 32:
        return Err("ML-KEM-768 shared secret must be 32 bytes")
    if x25519_shared.len() != 32:
        return Err("X25519 shared secret must be 32 bytes")
    if not _hybrid_bytes_valid(mlkem_shared):
        return Err("ML-KEM-768 shared secret contains a non-byte value")
    if _x25519_is_all_zero(x25519_shared):
        return Err("X25519 produced the prohibited all-zero shared secret")
    Ok(_append_bytes(mlkem_shared, x25519_shared))
fn x25519_mlkem768_keygen(config: X25519MlKem768Config,
        x25519_private: [u8], d: list, z: list) -> Result<X25519MlKem768KeyPair, text>:
    if x25519_private.len() != 32 or d.len() != 32 or z.len() != 32:
        return Err("X25519MLKEM768 key generation requires three 32-byte inputs")
    if not _hybrid_bytes_valid(d) or not _hybrid_bytes_valid(z):
        return Err("X25519MLKEM768 key generation inputs must contain bytes")
    var evidence: X25519MlKem768Evidence = match x25519_mlkem768_resolve_backend(config, "keygen"):
        case Ok(value): value
        case Err(reason): return Err(reason)
    val kem_pair = match ml_kem_keygen_checked(d, z):
        case Ok(value): value
        case Err(reason): return Err(reason)
    val (encapsulation_key, decapsulation_key) = kem_pair
    if encapsulation_key.len() != 1184 or decapsulation_key.len() != 2400:
        return Err("ML-KEM-768 key generation returned invalid sizes")
    val x25519_public = x25519_base(x25519_private)
    val client_share = _append_bytes(encapsulation_key, x25519_public)
    evidence.input_fixture_digest = _keygen_fixture_digest_text(client_share)?
    evidence.output_digest = _hybrid_digest_text(client_share)?
    evidence.execution_proof_digest = evidence.output_digest
    Ok(X25519MlKem768KeyPair(
        client_key_share: client_share,
        decapsulation_key: decapsulation_key,
        x25519_private_key: x25519_private,
        evidence: evidence
    ))
fn x25519_mlkem768_encapsulate(config: X25519MlKem768Config,
        client_key_share: list, x25519_private: [u8],
        m: list) -> Result<X25519MlKem768Encapsulation, text>:
    if client_key_share.len() != X25519_MLKEM768_CLIENT_SHARE_BYTES:
        return Err("X25519MLKEM768 client key share must be 1216 bytes")
    if x25519_private.len() != 32 or m.len() != 32:
        return Err("X25519MLKEM768 encapsulation requires 32-byte private and message inputs")
    if not _hybrid_bytes_valid(client_key_share) or not _hybrid_bytes_valid(m):
        return Err("X25519MLKEM768 encapsulation inputs must contain bytes")
    var evidence: X25519MlKem768Evidence = match x25519_mlkem768_resolve_backend(
            config, "encapsulate"):
        case Ok(value): value
        case Err(reason): return Err(reason)
    evidence.input_fixture_digest = _encapsulate_fixture_digest_text(
        client_key_share)?
    val encapsulation_key = _slice_list_text(client_key_share, 0, 1184)?
    val peer_x25519_public = _slice_bytes_text(client_key_share, 1184, 32)?
    val kem_result = match ml_kem_encaps_checked(encapsulation_key, m):
        case Ok(value): value
        case Err(reason): return Err(reason)
    val (mlkem_shared, ciphertext) = kem_result
    val x25519_shared = x25519(x25519_private, peer_x25519_public)
    val shared: list = match x25519_mlkem768_combine(mlkem_shared, x25519_shared):
        case Ok(value): value
        case Err(reason): return Err(reason)
    val server_share = _append_bytes(ciphertext, x25519_base(x25519_private))
    val server_share_size_ok = server_share.len() == X25519_MLKEM768_SERVER_SHARE_BYTES
    val shared_size_ok = shared.len() == X25519_MLKEM768_SHARED_SECRET_BYTES
    if not server_share_size_ok or not shared_size_ok:
        return Err("X25519MLKEM768 encapsulation returned invalid sizes")
    evidence.output_digest = _hybrid_digest_text(server_share)?
    evidence.execution_proof_digest = evidence.output_digest
    Ok(X25519MlKem768Encapsulation(
        server_key_share: server_share,
        shared_secret: shared,
        evidence: evidence
    ))
fn x25519_mlkem768_decapsulate(config: X25519MlKem768Config,
        server_key_share: list, x25519_private: [u8],
        decapsulation_key: list) -> Result<X25519MlKem768Decapsulation, text>:
    if server_key_share.len() != X25519_MLKEM768_SERVER_SHARE_BYTES:
        return Err("X25519MLKEM768 server key share must be 1120 bytes")
    if x25519_private.len() != 32 or decapsulation_key.len() != 2400:
        return Err("X25519MLKEM768 decapsulation received invalid key sizes")
    if (not _hybrid_bytes_valid(server_key_share) or
            not _hybrid_bytes_valid(decapsulation_key)):
        return Err("X25519MLKEM768 decapsulation inputs must contain bytes")
    var evidence: X25519MlKem768Evidence = match x25519_mlkem768_resolve_backend(
            config, "decapsulate"):
        case Ok(value): value
        case Err(reason): return Err(reason)
    evidence.input_fixture_digest = _decapsulate_fixture_digest_text(
        server_key_share)?
    val ciphertext = _slice_list_text(server_key_share, 0, 1088)?
    val peer_x25519_public = _slice_bytes_text(server_key_share, 1088, 32)?
    val mlkem_shared = match ml_kem_decaps_checked(decapsulation_key, ciphertext):
        case Ok(value): value
        case Err(reason): return Err(reason)
    val x25519_shared = x25519(x25519_private, peer_x25519_public)
    val shared: list = match x25519_mlkem768_combine(mlkem_shared, x25519_shared):
        case Ok(value): value
        case Err(reason): return Err(reason)
    evidence.output_digest = _hybrid_digest_text(server_key_share)?
    evidence.execution_proof_digest = evidence.output_digest
    Ok(X25519MlKem768Decapsulation(shared_secret: shared, evidence: evidence))
fn _x25519_mlkem768_keygen_simd_candidate(config: X25519MlKem768Config,
        admission: X25519MlKem768SimdAdmission,
        x25519_private: [u8], d: list, z: list,
        verify_scalar: bool) -> Result<X25519MlKem768KeyPair, text>:
    if x25519_private.len() != 32 or d.len() != 32 or z.len() != 32:
        return Err("X25519MLKEM768 SIMD key generation requires three 32-byte inputs")
    if not _hybrid_bytes_valid(d) or not _hybrid_bytes_valid(z):
        return Err("X25519MLKEM768 SIMD key generation inputs must contain bytes")
    var evidence = match _resolve_admitted_simd_candidate(
            config, admission, "keygen"):
        case Ok(value): value
        case Err(reason): return Err(reason)
    mlkem_ntt_simd_reset()
    val kem_pair = match ml_kem_keygen_checked_simd(d, z):
        case Ok(value): value
        case Err(reason): return Err(reason)
    evidence = match x25519_mlkem768_simd_operation_evidence(
            evidence, mlkem_ntt_simd_receipt()):
        case Ok(value): value
        case Err(reason): return Err(reason)
    val (encapsulation_key, decapsulation_key) = kem_pair
    if verify_scalar:
        val scalar_pair = match ml_kem_keygen_checked(d, z):
            case Ok(value): value
            case Err(reason): return Err(reason)
        val (scalar_encapsulation_key, scalar_decapsulation_key) = scalar_pair
        val ek_matches = _hybrid_lists_equal(
            encapsulation_key, scalar_encapsulation_key)
        val dk_matches = _hybrid_lists_equal(
            decapsulation_key, scalar_decapsulation_key)
        _wipe_hybrid_owned(scalar_encapsulation_key)
        _wipe_hybrid_owned(scalar_decapsulation_key)
        if not ek_matches or not dk_matches:
            return Err("X25519MLKEM768 SIMD key generation failed scalar verification")
    val x25519_public = x25519_base(x25519_private)
    val client_share = _append_bytes(encapsulation_key, x25519_public)
    evidence.input_fixture_digest = _keygen_fixture_digest_text(client_share)?
    val client_share_size_ok = client_share.len() == X25519_MLKEM768_CLIENT_SHARE_BYTES
    val decapsulation_key_size_ok = decapsulation_key.len() == 2400
    if not client_share_size_ok or not decapsulation_key_size_ok:
        return Err("X25519MLKEM768 SIMD key generation returned invalid sizes")
    evidence.output_digest = _hybrid_digest_text(client_share)?
    evidence.oracle_match = verify_scalar
    Ok(X25519MlKem768KeyPair(
        client_key_share: client_share,
        decapsulation_key: decapsulation_key,
        x25519_private_key: x25519_private,
        evidence: evidence))
fn _x25519_mlkem768_encapsulate_simd_candidate(config: X25519MlKem768Config,
        admission: X25519MlKem768SimdAdmission,
        client_key_share: list, x25519_private: [u8],
        m: list, verify_scalar: bool) -> Result<X25519MlKem768Encapsulation, text>:
    if client_key_share.len() != X25519_MLKEM768_CLIENT_SHARE_BYTES:
        return Err("X25519MLKEM768 SIMD client key share must be 1216 bytes")
    if x25519_private.len() != 32 or m.len() != 32:
        return Err("X25519MLKEM768 SIMD encapsulation requires 32-byte inputs")
    if not _hybrid_bytes_valid(client_key_share) or not _hybrid_bytes_valid(m):
        return Err("X25519MLKEM768 SIMD encapsulation inputs must contain bytes")
    var evidence = match _resolve_admitted_simd_candidate(
            config, admission, "encapsulate"):
        case Ok(value): value
        case Err(reason): return Err(reason)
    evidence.input_fixture_digest = _encapsulate_fixture_digest_text(
        client_key_share)?
    mlkem_ntt_simd_reset()
    val encapsulation_key = _slice_list_text(client_key_share, 0, 1184)?
    val kem_result = match ml_kem_encaps_checked_simd(
            encapsulation_key, m):
        case Ok(value): value
        case Err(reason): return Err(reason)
    evidence = match x25519_mlkem768_simd_operation_evidence(
            evidence, mlkem_ntt_simd_receipt()):
        case Ok(value): value
        case Err(reason): return Err(reason)
    val (mlkem_shared, ciphertext) = kem_result
    if verify_scalar:
        val scalar_result = match ml_kem_encaps_checked(encapsulation_key, m):
            case Ok(value): value
            case Err(reason): return Err(reason)
        val (scalar_shared, scalar_ciphertext) = scalar_result
        val shared_matches = _hybrid_lists_equal(mlkem_shared, scalar_shared)
        val ciphertext_matches = _hybrid_lists_equal(
            ciphertext, scalar_ciphertext)
        _wipe_hybrid_owned(scalar_shared)
        _wipe_hybrid_owned(scalar_ciphertext)
        if not shared_matches or not ciphertext_matches:
            return Err("X25519MLKEM768 SIMD encapsulation failed scalar verification")
    val peer_x25519_public = _slice_bytes_text(client_key_share, 1184, 32)?
    val x25519_shared = x25519(x25519_private, peer_x25519_public)
    val shared = match x25519_mlkem768_combine(mlkem_shared, x25519_shared):
        case Ok(value): value
        case Err(reason): return Err(reason)
    val server_share = _append_bytes(ciphertext, x25519_base(x25519_private))
    val server_share_size_ok = server_share.len() == X25519_MLKEM768_SERVER_SHARE_BYTES
    val shared_size_ok = shared.len() == X25519_MLKEM768_SHARED_SECRET_BYTES
    if not server_share_size_ok or not shared_size_ok:
        return Err("X25519MLKEM768 SIMD encapsulation returned invalid sizes")
    evidence.output_digest = _hybrid_digest_text(server_share)?
    evidence.oracle_match = verify_scalar
    Ok(X25519MlKem768Encapsulation(
        server_key_share: server_share, shared_secret: shared,
        evidence: evidence))
fn _x25519_mlkem768_decapsulate_simd_candidate(config: X25519MlKem768Config,
        admission: X25519MlKem768SimdAdmission,
        server_key_share: list, x25519_private: [u8],
        decapsulation_key: list,
        verify_scalar: bool) -> Result<X25519MlKem768Decapsulation, text>:
    if server_key_share.len() != X25519_MLKEM768_SERVER_SHARE_BYTES:
        return Err("X25519MLKEM768 SIMD server key share must be 1120 bytes")
    if x25519_private.len() != 32 or decapsulation_key.len() != 2400:
        return Err("X25519MLKEM768 SIMD decapsulation received invalid key sizes")
    if (not _hybrid_bytes_valid(server_key_share) or
            not _hybrid_bytes_valid(decapsulation_key)):
        return Err("X25519MLKEM768 SIMD decapsulation inputs must contain bytes")
    var evidence = match _resolve_admitted_simd_candidate(
            config, admission, "decapsulate"):
        case Ok(value): value
        case Err(reason): return Err(reason)
    evidence.input_fixture_digest = _decapsulate_fixture_digest_text(
        server_key_share)?
    mlkem_ntt_simd_reset()
    val ciphertext = _slice_list_text(server_key_share, 0, 1088)?
    val mlkem_shared = match ml_kem_decaps_checked_simd(
            decapsulation_key, ciphertext):
        case Ok(value): value
        case Err(reason): return Err(reason)
    evidence = match x25519_mlkem768_simd_operation_evidence(
            evidence, mlkem_ntt_simd_receipt()):
        case Ok(value): value
        case Err(reason): return Err(reason)
    if verify_scalar:
        val scalar_shared = match ml_kem_decaps_checked(
                decapsulation_key, ciphertext):
            case Ok(value): value
            case Err(reason): return Err(reason)
        val scalar_matches = _hybrid_lists_equal(mlkem_shared, scalar_shared)
        _wipe_hybrid_owned(scalar_shared)
        if not scalar_matches:
            return Err("X25519MLKEM768 SIMD decapsulation failed scalar verification")
    val peer_x25519_public = _slice_bytes_text(server_key_share, 1088, 32)?
    val x25519_shared = x25519(x25519_private, peer_x25519_public)
    val shared = match x25519_mlkem768_combine(mlkem_shared, x25519_shared):
        case Ok(value): value
        case Err(reason): return Err(reason)
    evidence.output_digest = _hybrid_digest_text(server_key_share)?
    evidence.oracle_match = verify_scalar
    Ok(X25519MlKem768Decapsulation(shared_secret: shared, evidence: evidence))
fn _x25519_mlkem768_keygen_cuda_candidate(config: X25519MlKem768Config,
        executor: X25519MlKem768CudaNttExecutor,
        x25519_private: [u8], d: list,
        z: list, verify_scalar: bool) -> Result<X25519MlKem768KeyPair, text>:
    if x25519_private.len() != 32 or d.len() != 32 or z.len() != 32:
        return Err("X25519MLKEM768 CUDA key generation requires three 32-byte inputs")
    if not _hybrid_bytes_valid(d) or not _hybrid_bytes_valid(z):
        return Err("X25519MLKEM768 CUDA key generation inputs must contain bytes")
    val evidence = match x25519_mlkem768_resolve_cuda_candidate(config, "keygen"):
        case Ok(value): value
        case Err(reason): return Err(reason)
    val cache_reason = executor.bind_cache_contract(
        config.implementation_version, config.profile_version,
        evidence.configuration_digest)
    if cache_reason != "":
        return Err(cache_reason)
    val before = executor.kernel_invocations
    val kem_pair = match ml_kem_keygen_checked_provider(d, z, executor):
        case Ok(value): value
        case Err(reason): return Err(reason)
    val (encapsulation_key, decapsulation_key) = kem_pair
    if verify_scalar:
        val verification_reason = x25519_mlkem768_verify_gpu_keygen(
            d, z, encapsulation_key, decapsulation_key)
        if verification_reason != "": return Err(verification_reason)
    val client_share = _append_bytes(encapsulation_key, x25519_base(x25519_private))
    val client_share_size_ok = client_share.len() == X25519_MLKEM768_CLIENT_SHARE_BYTES
    val decapsulation_key_size_ok = decapsulation_key.len() == 2400
    if not client_share_size_ok or not decapsulation_key_size_ok:
        return Err("X25519MLKEM768 CUDA key generation returned invalid sizes")
    val fixture_digest = _keygen_fixture_digest_text(client_share)?
    val output_digest = _hybrid_digest_text(client_share)?
    var final_evidence = match x25519_mlkem768_cuda_operation_evidence(
            evidence, executor, before, fixture_digest, output_digest):
        case Ok(value): value
        case Err(reason): return Err(reason)
    final_evidence.oracle_match = verify_scalar
    Ok(X25519MlKem768KeyPair(
        client_key_share: client_share, decapsulation_key: decapsulation_key,
        x25519_private_key: x25519_private, evidence: final_evidence))
fn _x25519_mlkem768_encapsulate_cuda_candidate(config: X25519MlKem768Config,
        executor: X25519MlKem768CudaNttExecutor,
        client_key_share: list, x25519_private: [u8],
        m: list, verify_scalar: bool) -> Result<X25519MlKem768Encapsulation, text>:
    if client_key_share.len() != X25519_MLKEM768_CLIENT_SHARE_BYTES:
        return Err("X25519MLKEM768 CUDA client key share must be 1216 bytes")
    if x25519_private.len() != 32 or m.len() != 32:
        return Err("X25519MLKEM768 CUDA encapsulation requires 32-byte inputs")
    if not _hybrid_bytes_valid(client_key_share) or not _hybrid_bytes_valid(m):
        return Err("X25519MLKEM768 CUDA encapsulation inputs must contain bytes")
    val evidence = match x25519_mlkem768_resolve_cuda_candidate(
            config, "encapsulate"):
        case Ok(value): value
        case Err(reason): return Err(reason)
    val cache_reason = executor.bind_cache_contract(
        config.implementation_version, config.profile_version,
        evidence.configuration_digest)
    if cache_reason != "":
        return Err(cache_reason)
    val before = executor.kernel_invocations
    val encapsulation_key = _slice_list_text(client_key_share, 0, 1184)?
    val kem_result = match ml_kem_encaps_checked_provider(
            encapsulation_key, m, executor):
        case Ok(value): value
        case Err(reason): return Err(reason)
    val (mlkem_shared, ciphertext) = kem_result
    if verify_scalar:
        val verification_reason = x25519_mlkem768_verify_gpu_encapsulate(
            encapsulation_key, m, mlkem_shared, ciphertext)
        if verification_reason != "": return Err(verification_reason)
    val peer_x25519_public = _slice_bytes_text(client_key_share, 1184, 32)?
    val shared = match x25519_mlkem768_combine(mlkem_shared,
            x25519(x25519_private, peer_x25519_public)):
        case Ok(value): value
        case Err(reason): return Err(reason)
    val server_share = _append_bytes(ciphertext, x25519_base(x25519_private))
    val server_share_size_ok = server_share.len() == X25519_MLKEM768_SERVER_SHARE_BYTES
    val shared_size_ok = shared.len() == X25519_MLKEM768_SHARED_SECRET_BYTES
    if not server_share_size_ok or not shared_size_ok:
        return Err("X25519MLKEM768 CUDA encapsulation returned invalid sizes")
