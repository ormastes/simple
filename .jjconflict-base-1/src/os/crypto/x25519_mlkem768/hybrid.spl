# One same-owner operation is the only public authority allowed to execute the
# raw SIMD helpers without their per-operation scalar verification. It owns
# both disjoint timing spans and proves the complete scalar/candidate exchange
# equality before returning public digests and non-secret execution evidence.
struct X25519MlKem768PairedExchangeObservation:
    scalar_started_ns: i64
    scalar_finished_ns: i64
    candidate_started_ns: i64
    candidate_finished_ns: i64
    candidate_simd_chunk_hits: i64
    candidate_observed_rvv_vlen_bits: i64
    candidate_executor_identity: text
    candidate_artifact_digest: text
    client_share_digest: text
    server_share_digest: text

struct _X25519MlKem768PairedRoleObservation:
    started_ns: i64
    finished_ns: i64
    client_share: list
    server_share: list
    shared_secret: list
    keygen_evidence: X25519MlKem768Evidence
    encapsulate_evidence: X25519MlKem768Evidence
    decapsulate_evidence: X25519MlKem768Evidence

fn _paired_role_observation(
        config: X25519MlKem768Config,
        admission: X25519MlKem768SimdAdmission,
        client_private: [u8], d: list, z: list,
        server_private: [u8], m: list,
        candidate: bool) -> Result<_X25519MlKem768PairedRoleObservation, text>:
    defer _wipe_hybrid_owned_bytes(client_private)
    defer _wipe_hybrid_owned_bytes(server_private)
    defer _wipe_hybrid_owned(d)
    defer _wipe_hybrid_owned(z)
    defer _wipe_hybrid_owned(m)
    var selected_config = config
    if not candidate:
        selected_config.requested_backend = X25519MlKem768Backend.ScalarCpu
        selected_config.selection_mode = X25519MlKem768SelectionMode.Require
    val started_ns = time_now_nanos()
    val client = if candidate:
        _x25519_mlkem768_keygen_simd_candidate(
            selected_config, admission, client_private, d, z, false)?
    else:
        x25519_mlkem768_keygen(selected_config, client_private, d, z)?
    defer _wipe_hybrid_owned(client.decapsulation_key)
    defer _wipe_hybrid_owned_bytes(client.x25519_private_key)
    val server = if candidate:
        _x25519_mlkem768_encapsulate_simd_candidate(
            selected_config, admission, client.client_key_share,
            server_private, m, false)?
    else:
        x25519_mlkem768_encapsulate(
            selected_config, client.client_key_share, server_private, m)?
    val recovered = if candidate:
        _x25519_mlkem768_decapsulate_simd_candidate(
            selected_config, admission, server.server_key_share,
            client.x25519_private_key, client.decapsulation_key, false)?
    else:
        x25519_mlkem768_decapsulate(
            selected_config, server.server_key_share,
            client.x25519_private_key, client.decapsulation_key)?
    defer _wipe_hybrid_owned(recovered.shared_secret)
    val finished_ns = time_now_nanos()
    if started_ns <= 0 or finished_ns <= started_ns:
        _wipe_hybrid_owned(server.shared_secret)
        return Err("X25519MLKEM768 paired monotonic timing unavailable")
    if not _hybrid_lists_equal(
            server.shared_secret, recovered.shared_secret):
        _wipe_hybrid_owned(server.shared_secret)
        return Err("X25519MLKEM768 paired role round trip mismatch")
    val common_evidence =
        not client.evidence.fallback_used and
        not server.evidence.fallback_used and
        not recovered.evidence.fallback_used
    if not common_evidence:
        _wipe_hybrid_owned(server.shared_secret)
        return Err("X25519MLKEM768 paired role used fallback")
    if candidate:
        val candidate_evidence =
            client.evidence.selected_backend == config.requested_backend and
            server.evidence.selected_backend == config.requested_backend and
            recovered.evidence.selected_backend == config.requested_backend and
            client.evidence.simd_chunk_hits > 0 and
            server.evidence.simd_chunk_hits > 0 and
            recovered.evidence.simd_chunk_hits > 0 and
            client.evidence.simd_chunk_hits <= 1000000000 and
            server.evidence.simd_chunk_hits <= 1000000000 and
            recovered.evidence.simd_chunk_hits <= 1000000000 and
            client.evidence.executor_identity == server.evidence.executor_identity and
            client.evidence.executor_identity == recovered.evidence.executor_identity and
            client.evidence.artifact_digest == server.evidence.artifact_digest and
            client.evidence.artifact_digest == recovered.evidence.artifact_digest and
            client.evidence.observed_rvv_vlen_bits == server.evidence.observed_rvv_vlen_bits and
            client.evidence.observed_rvv_vlen_bits == recovered.evidence.observed_rvv_vlen_bits
        if not candidate_evidence:
            _wipe_hybrid_owned(server.shared_secret)
            return Err("X25519MLKEM768 paired SIMD evidence mismatch")
    else:
        val scalar_evidence =
            client.evidence.selected_backend == X25519MlKem768Backend.ScalarCpu and
            server.evidence.selected_backend == X25519MlKem768Backend.ScalarCpu and
            recovered.evidence.selected_backend == X25519MlKem768Backend.ScalarCpu and
            client.evidence.simd_chunk_hits == 0 and
            server.evidence.simd_chunk_hits == 0 and
            recovered.evidence.simd_chunk_hits == 0
        if not scalar_evidence:
            _wipe_hybrid_owned(server.shared_secret)
            return Err("X25519MLKEM768 paired scalar evidence mismatch")
    Ok(_X25519MlKem768PairedRoleObservation(
        started_ns: started_ns, finished_ns: finished_ns,
        client_share: client.client_key_share,
        server_share: server.server_key_share,
        shared_secret: server.shared_secret,
        keygen_evidence: client.evidence,
        encapsulate_evidence: server.evidence,
        decapsulate_evidence: recovered.evidence))

fn x25519_mlkem768_paired_exchange_observation(
        config: X25519MlKem768Config,
        admission: X25519MlKem768SimdAdmission,
        client_private: [u8], d: list, z: list,
        server_private: [u8], m: list,
        candidate_first: bool
        ) -> Result<X25519MlKem768PairedExchangeObservation, text>:
    var scalar: _X25519MlKem768PairedRoleObservation
    var candidate: _X25519MlKem768PairedRoleObservation
    if candidate_first:
        candidate = _paired_role_observation(
            config, admission,
            _copy_hybrid_bytes(client_private), _copy_hybrid_list(d),
            _copy_hybrid_list(z), _copy_hybrid_bytes(server_private),
            _copy_hybrid_list(m), true)?
        scalar = _paired_role_observation(
            config, admission,
            _copy_hybrid_bytes(client_private), _copy_hybrid_list(d),
            _copy_hybrid_list(z), _copy_hybrid_bytes(server_private),
            _copy_hybrid_list(m), false)?
    else:
        scalar = _paired_role_observation(
            config, admission,
            _copy_hybrid_bytes(client_private), _copy_hybrid_list(d),
            _copy_hybrid_list(z), _copy_hybrid_bytes(server_private),
            _copy_hybrid_list(m), false)?
        candidate = _paired_role_observation(
            config, admission,
            _copy_hybrid_bytes(client_private), _copy_hybrid_list(d),
            _copy_hybrid_list(z), _copy_hybrid_bytes(server_private),
            _copy_hybrid_list(m), true)?
    defer _wipe_hybrid_owned(scalar.shared_secret)
    defer _wipe_hybrid_owned(candidate.shared_secret)
    val exact_outputs =
        _hybrid_lists_equal(scalar.client_share, candidate.client_share) and
        _hybrid_lists_equal(scalar.server_share, candidate.server_share) and
        _hybrid_lists_equal(scalar.shared_secret, candidate.shared_secret)
    if not exact_outputs:
        return Err("X25519MLKEM768 paired scalar candidate mismatch")
    val candidate_hits =
        candidate.keygen_evidence.simd_chunk_hits +
        candidate.encapsulate_evidence.simd_chunk_hits +
        candidate.decapsulate_evidence.simd_chunk_hits
    Ok(X25519MlKem768PairedExchangeObservation(
        scalar_started_ns: scalar.started_ns,
        scalar_finished_ns: scalar.finished_ns,
        candidate_started_ns: candidate.started_ns,
        candidate_finished_ns: candidate.finished_ns,
        candidate_simd_chunk_hits: candidate_hits,
        candidate_observed_rvv_vlen_bits:
            candidate.decapsulate_evidence.observed_rvv_vlen_bits,
        candidate_executor_identity:
            candidate.decapsulate_evidence.executor_identity,
        candidate_artifact_digest:
            candidate.decapsulate_evidence.artifact_digest,
        client_share_digest: _hybrid_digest_text(scalar.client_share)?,
        server_share_digest: _hybrid_digest_text(scalar.server_share)?))

export x25519_mlkem768_keygen, x25519_mlkem768_encapsulate, x25519_mlkem768_decapsulate, x25519_mlkem768_combine
export x25519_mlkem768_keygen_simd_candidate, x25519_mlkem768_encapsulate_simd_candidate, x25519_mlkem768_decapsulate_simd_candidate
export x25519_mlkem768_keygen_cuda_candidate, x25519_mlkem768_encapsulate_cuda_candidate, x25519_mlkem768_decapsulate_cuda_candidate
export x25519_mlkem768_keygen_metal_candidate, x25519_mlkem768_encapsulate_metal_candidate, x25519_mlkem768_decapsulate_metal_candidate
export x25519_mlkem768_keygen_vulkan_candidate, x25519_mlkem768_encapsulate_vulkan_candidate, x25519_mlkem768_decapsulate_vulkan_candidate
export X25519MlKem768PairedExchangeObservation
export x25519_mlkem768_paired_exchange_observation
