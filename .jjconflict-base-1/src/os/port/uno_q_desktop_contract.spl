# UNO Q desktop target identity and fail-closed backend status.
#
# QRB2210 is the desktop MPU. STM32U585 is an MCU/coprocessor and must never
# satisfy a display, window-event, audio, or full-WM claim.

val UNO_Q_QRB2210_BOARD_ID: text = "qrb2210-uno-q"
val UNO_Q_STM32U585_BOARD_ID: text = "stm32u585-uno-q"

val UNO_Q_DESKTOP_CAP_DISPLAY: i64 = 1
val UNO_Q_DESKTOP_CAP_WINDOW_EVENT: i64 = 2
val UNO_Q_DESKTOP_CAP_AUDIO: i64 = 3

val UNO_Q_DESKTOP_STATUS_OK: i64 = 0
val UNO_Q_DESKTOP_STATUS_PORT_UNAVAILABLE: i64 = -1
val UNO_Q_DESKTOP_STATUS_UNSUPPORTED_MCU: i64 = -2
val UNO_Q_DESKTOP_STATUS_INVALID: i64 = -3

fn uno_q_desktop_backend_status(board_id: text, capability: i64) -> i64:
    if (capability < UNO_Q_DESKTOP_CAP_DISPLAY or
        capability > UNO_Q_DESKTOP_CAP_AUDIO):
        return UNO_Q_DESKTOP_STATUS_INVALID
    if board_id == UNO_Q_QRB2210_BOARD_ID:
        return UNO_Q_DESKTOP_STATUS_PORT_UNAVAILABLE
    if board_id == UNO_Q_STM32U585_BOARD_ID:
        return UNO_Q_DESKTOP_STATUS_UNSUPPORTED_MCU
    UNO_Q_DESKTOP_STATUS_INVALID

fn uno_q_desktop_backend_reason(board_id: text, capability: i64) -> text:
    val status = uno_q_desktop_backend_status(board_id, capability)
    if status == UNO_Q_DESKTOP_STATUS_PORT_UNAVAILABLE:
        return "qrb2210-simpleos-port-unavailable"
    if status == UNO_Q_DESKTOP_STATUS_UNSUPPORTED_MCU:
        return "stm32u585-is-coprocessor-not-desktop"
    if status == UNO_Q_DESKTOP_STATUS_INVALID:
        return "invalid-uno-q-desktop-target-or-capability"
    "ok"

fn uno_q_desktop_can_claim_wm(board_id: text) -> bool:
    (
        uno_q_desktop_backend_status(
            board_id, UNO_Q_DESKTOP_CAP_DISPLAY
        ) == UNO_Q_DESKTOP_STATUS_OK and
        uno_q_desktop_backend_status(
            board_id, UNO_Q_DESKTOP_CAP_WINDOW_EVENT
        ) == UNO_Q_DESKTOP_STATUS_OK and
        uno_q_desktop_backend_status(
            board_id, UNO_Q_DESKTOP_CAP_AUDIO
        ) == UNO_Q_DESKTOP_STATUS_OK
    )

export UNO_Q_QRB2210_BOARD_ID, UNO_Q_STM32U585_BOARD_ID
export UNO_Q_DESKTOP_CAP_DISPLAY, UNO_Q_DESKTOP_CAP_WINDOW_EVENT
export UNO_Q_DESKTOP_CAP_AUDIO
export UNO_Q_DESKTOP_STATUS_OK, UNO_Q_DESKTOP_STATUS_PORT_UNAVAILABLE
export UNO_Q_DESKTOP_STATUS_UNSUPPORTED_MCU, UNO_Q_DESKTOP_STATUS_INVALID
export uno_q_desktop_backend_status, uno_q_desktop_backend_reason
export uno_q_desktop_can_claim_wm
