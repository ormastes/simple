# Spawn authority guard — root-only ambient (`spawn_full`) authority.
#
# Master plan §5.4 ("Remove ambient spawn authority"):
#   `spawn_full()` is legal ONLY for the root task during bootstrap. Everything
#   else must go through a SpawnSpec recipe (cspace_spawn.spawn_with_cspace),
#   and a child's rights are an INTERSECTION, never a widening:
#
#     effective_rights = parent_delegable
#                      & executable_policy_ceiling
#                      & system_policy_ceiling
#                      & manifest_request
#                      - explicit_denials
#
# This module is the loader-side gate. It does NOT modify `cspace_spawn.spl`
# (owned by the IPC lane / ABI freeze) — it wraps the ambient grant so the
# loader can only hand out `spawn_full()` while the guard says yes, and hands
# out the pledged deny-all set (`CapabilitySet.empty()`) otherwise.
#
# Phase model (two scalars, no structs, no classes):
#   g_spawn_bootstrap_sealed = false  ->  bootstrap in progress; ambient spawn
#                                         is allowed (this is the boot path that
#                                         still predates SpawnSpec wiring).
#   g_spawn_bootstrap_sealed = true   ->  post-bootstrap; ONLY the root task
#                                         (`g_spawn_root_task`) may take the
#                                         ambient path; every other caller is
#                                         denied EPERM and must use a SpawnSpec.
#
# FREESTANDING DISCIPLINE (same rules as fs_exec_resolve.spl's header):
#   - No module-level array/[text] initializers — they do NOT run under the
#     freestanding native-build; only scalar module vars are reliable (they land
#     in zeroed .bss, so `false` / `0` ARE the correct fail-safe defaults here:
#     an un-run initializer leaves the kernel in "bootstrap not yet sealed,
#     root == 0 == kernel-origin sentinel", which is exactly the boot state).
#   - No class construction and no trait-object dispatch on this path (they are
#     not proven freestanding-safe; see fs_exec_resolve.spl).
#   - Guards are plain `fn`s over scalar module vars.
#
# Caller convention matches the existing loader gate (cap_exec_gate.spl):
# `caller == 0` is the kernel-origin sentinel, i.e. the root task.

use os.kernel.types.capability_types.{CapabilitySet}
use os.kernel.ipc.cspace_spawn.{SpawnSpec, CspaceMint, spawn_full, spawn_with_cspace}
use os.kernel.loader.spawn_recipes.{
    SPAWN_RECIPE_NONE, spawn_recipe_is_migrated, spawn_recipe_name,
    spawn_recipe_spec, spawn_recipe_rights_mask
}

extern fn serial_println(msg: text)

# EPERM — an ambient-spawn attempt by a non-root caller after bootstrap.
pub val SPAWN_AUTHORITY_EPERM: i32 = -1

# ============================================================================
# Phase / root-task state (scalar module vars only — see FREESTANDING above)
# ============================================================================

var g_spawn_bootstrap_sealed: bool = false
var g_spawn_root_task: i64 = 0
var g_spawn_current_caller: i64 = 0
var g_spawn_ambient_denials: i64 = 0
var g_spawn_current_recipe: i64 = 0
var g_spawn_recipe_mints: i64 = 0
var g_spawn_recipe_rejected: i64 = 0

pub fn spawn_authority_seal_bootstrap():
    """Close the bootstrap window. After this, ambient `spawn_full()` is only
    available to the root task; all other callers must present a SpawnSpec.

    Called once by the boot path after init has been started. Idempotent."""
    g_spawn_bootstrap_sealed = true
    serial_println("[spawn-auth] bootstrap sealed root={g_spawn_root_task}")

pub fn spawn_authority_reopen_bootstrap():
    """Reopen the bootstrap window (boot-phase restart / test harness only)."""
    g_spawn_bootstrap_sealed = false

pub fn spawn_authority_set_root_task(task: i64):
    """Declare which task id counts as root for ambient spawn."""
    g_spawn_root_task = task

pub fn spawn_authority_bootstrap_sealed() -> bool:
    """Accessor — module vars mutated in fns are not readable from spec
    `it` blocks directly, so state is always asserted through accessors."""
    g_spawn_bootstrap_sealed

pub fn spawn_authority_root_task() -> i64:
    """Accessor for the configured root task id."""
    g_spawn_root_task

pub fn spawn_authority_is_root(caller: i64) -> bool:
    """True when `caller` is the root task (0 = kernel-origin sentinel)."""
    caller == g_spawn_root_task

# ============================================================================
# The guard
# ============================================================================

pub fn spawn_authority_check_ambient(caller: i64) -> i32:
    """0 when `caller` may take the ambient full-authority spawn path,
    SPAWN_AUTHORITY_EPERM otherwise.

    Allowed when the bootstrap window is still open (boot/init sequence) OR the
    caller is the root task. Denied for every other caller once bootstrap is
    sealed — that caller must spawn through a SpawnSpec recipe instead."""
    if not g_spawn_bootstrap_sealed:
        return 0
    if spawn_authority_is_root(caller):
        return 0
    serial_println("[spawn-auth] deny ambient spawn caller={caller}")
    SPAWN_AUTHORITY_EPERM

pub fn spawn_authority_ambient_caps(caller: i64) -> CapabilitySet:
    """The capability set the loader may install for an ambient spawn.

    Root/bootstrap -> `spawn_full()` (the named, greppable ambient grant).
    Anyone else after sealing -> `CapabilitySet.empty()`, the PLEDGED deny-all
    set, so an unauthorized ambient spawn produces a powerless task instead of
    a god-mode one (fail closed, never fail open)."""
    if spawn_authority_check_ambient(caller) != 0:
        g_spawn_ambient_denials = g_spawn_ambient_denials + 1
        return CapabilitySet.empty()
    spawn_full()

pub fn spawn_authority_denial_count() -> i64:
    """How many ambient spawns this guard has refused (accessor for gates)."""
    g_spawn_ambient_denials

# ============================================================================
# Caller propagation for the fs-exec bridge
# ============================================================================
#
# `fs_exec_prepare_spawn_from_bytes` is a shared cross-arch bridge with a fixed
# signature used by every per-arch spawn entry (x86_64/arm64/riscv...). Threading
# a new `caller` parameter through all of them is a multi-file ABI change and is
# NOT this increment. Instead the gated entry point (`fs_exec_spawn_as`) records
# the caller in a scalar before descending, and the bridge reads it back. Boot
# paths that never set it read 0 = kernel-origin = root, preserving boot.

pub fn spawn_authority_note_caller(caller: i64):
    """Record the caller about to descend into the fs-exec spawn bridge."""
    g_spawn_current_caller = caller

pub fn spawn_authority_current_caller() -> i64:
    """The caller recorded by the most recent `spawn_authority_note_caller`."""
    g_spawn_current_caller

pub fn spawn_authority_clear_caller():
    """Reset the recorded caller back to the kernel-origin sentinel."""
    g_spawn_current_caller = 0

# ============================================================================
# Recipe propagation and the recipe-aware gate (master plan §5.4, half 2)
# ============================================================================
#
# The guard above answers "may this caller take the AMBIENT path?". A migrated
# caller does not want the ambient path at all — it presents a SpawnSpec recipe
# (`spawn_recipes.spl`) and receives a minted, attenuated pouch instead. The
# functions below are that second half.
#
# This is NOT a second spawn path: the recipe only decides WHICH CapabilitySet
# the child gets. Image build, scheduler task creation, and the arch handoff stay
# on the single existing path. The recipe id rides the same scalar-propagation
# trick as the caller id, because `fs_exec_prepare_spawn_from_bytes` is a shared
# cross-arch bridge with a frozen signature.

pub fn spawn_authority_note_recipe(recipe: i64):
    """Declare the recipe about to be used for the spawn being prepared."""
    g_spawn_current_recipe = recipe

pub fn spawn_authority_current_recipe() -> i64:
    """The recipe declared by the most recent `spawn_authority_note_recipe`."""
    g_spawn_current_recipe

pub fn spawn_authority_clear_recipe():
    """Reset the recorded recipe back to `SPAWN_RECIPE_NONE` (ambient path)."""
    g_spawn_current_recipe = SPAWN_RECIPE_NONE

pub fn spawn_authority_check_spawn(caller: i64, recipe: i64) -> i32:
    """0 when this (caller, recipe) pair may spawn, SPAWN_AUTHORITY_EPERM else.

    A migrated recipe is admitted REGARDLESS of the seal, because a recipe spawn
    never takes ambient authority in the first place — it is bounded by the
    parent's own tokens at mint time. Everything else falls through to the
    unchanged ambient guard, so an unmigrated non-root caller is still EPERM
    once the bootstrap window is sealed.

    This is the function the boot seal's safety rests on: arming the seal is a
    no-op for every caller that reaches here with a migrated recipe."""
    if spawn_recipe_is_migrated(recipe):
        return 0
    spawn_authority_check_ambient(caller)

pub fn spawn_authority_spawn_caps(caller: i64, recipe: i64, parent: CapabilitySet) -> CapabilitySet:
    """The capability set to install for a spawn by `caller` under `recipe`.

    Migrated recipe -> mint through `spawn_with_cspace`, the least-authority
    primitive: the child gets EXACTLY the recipe grants the parent is authorized
    to delegate, and nothing the parent does not already hold. No recipe -> the
    unchanged ambient path (`spawn_authority_ambient_caps`), so every existing
    boot/root spawn is bit-for-bit identical to before this module grew.

    PRECONDITION (cspace_spawn.`_find_source`): `parent` must hold concrete,
    delegable tokens. An ambient `full()` parent has ZERO tokens and therefore
    authorizes nothing — the mint comes back deny-all with every grant counted in
    `rejected`. `spawn_recipes.spawn_recipe_seed_parent_caps` builds the root
    grant that satisfies this; boot must install it on the service task."""
    if not spawn_recipe_is_migrated(recipe):
        return spawn_authority_ambient_caps(caller)
    val spec: SpawnSpec = spawn_recipe_spec(recipe, "")
    val owner = if caller < 0: 0u64 else: caller.to_u64()
    val mint: CspaceMint = spawn_with_cspace(parent, spec, owner, 1u64, 1u64)
    val rejected = mint.rejected
    g_spawn_recipe_mints = g_spawn_recipe_mints + 1
    g_spawn_recipe_rejected = g_spawn_recipe_rejected + rejected
    val label = spawn_recipe_name(recipe)
    serial_println("[spawn-auth] recipe spawn caller={caller} recipe={label} rejected={rejected}")
    mint.caps

pub fn spawn_authority_recipe_mint_count() -> i64:
    """How many recipe pouches this guard has minted (accessor for gates)."""
    g_spawn_recipe_mints

pub fn spawn_authority_recipe_rejected_count() -> i64:
    """Total recipe grants dropped for lack of parent authority.

    A non-zero value after boot means a caller's declared recipe asks for more
    than its seeded root grant holds — a policy bug, not a runtime condition."""
    g_spawn_recipe_rejected

pub fn spawn_authority_reset_recipe_counters():
    """Zero the recipe audit counters (test harness / boot-phase restart only)."""
    g_spawn_recipe_mints = 0
    g_spawn_recipe_rejected = 0

# ============================================================================
# Effective-rights intersection (pure helper — master plan §5.4 formula)
# ============================================================================

pub fn spawn_rights_without(base: u32, denials: u32) -> u32:
    """`base` minus every bit in `denials`. Expressed as xor-of-and so no
    bitwise-not width assumptions are made about u32."""
    base ^ (base & denials)

pub fn spawn_effective_rights(
    parent_delegable: u32,
    executable_ceiling: u32,
    system_ceiling: u32,
    manifest_request: u32,
    explicit_denials: u32
) -> u32:
    """effective = parent & exec_ceiling & system_ceiling & request - denials.

    Pure intersection then subtraction: the result is ALWAYS a subset of every
    input mask, so a child can never amplify past its parent, past the
    executable's policy ceiling, or past the system ceiling."""
    val intersected = parent_delegable & executable_ceiling & system_ceiling & manifest_request
    spawn_rights_without(intersected, explicit_denials)

pub fn spawn_rights_is_subset(child: u32, parent: u32) -> bool:
    """True when every right in `child` is also held by `parent`."""
    (child & parent) == child

pub fn spawn_spec_requested_rights(spec: SpawnSpec, parent_delegable: u32) -> u32:
    """Rights a SpawnSpec asks for, as a mask.

    Per `AttenuationSpec`, a `rights_mask` of 0 means "keep the parent's rights"
    — so a zero mask contributes `parent_delegable`, never "all rights". The
    union is then still bounded by the parent, which is what makes
    `spawn_spec_effective_rights` provably attenuating."""
    var acc: u32 = 0u32
    for g in spec.grants:
        if g.atten.rights_mask == 0u32:
            acc = acc | parent_delegable
        else:
            acc = acc | (g.atten.rights_mask & parent_delegable)
    acc

pub fn spawn_spec_effective_rights(
    spec: SpawnSpec,
    parent_delegable: u32,
    executable_ceiling: u32,
    system_ceiling: u32,
    explicit_denials: u32
) -> u32:
    """Apply the §5.4 formula to a SpawnSpec recipe. The result is always a
    subset of `parent_delegable` (intersection semantics — no amplification via
    child creation)."""
    spawn_effective_rights(
        parent_delegable,
        executable_ceiling,
        system_ceiling,
        spawn_spec_requested_rights(spec, parent_delegable),
        explicit_denials
    )

# ============================================================================
# Meet point — profile attenuation ∧ spawn rights (P8 × P2 hand-off)
# ============================================================================
#
# Recorded cross-lane hand-off (.spipe/simpleos_production_host_master_plan):
# "P8 resolve_effective + P2 spawn_spec_effective_rights must meet at spawn
# time." The LLM profile layer (profile_registry.resolve_effective, mapped into
# the CAP_RIGHT_* space by profile_spawn_adapter.llm_profile_to_spawn_rights)
# and the spawn-rights layer (this module) compose HERE, in one pure function,
# so there is a single provable meet point instead of two independent
# attenuations that could drift apart.
#
# Callers without a profile pass `SPAWN_PROFILE_MASK_ALL` — the identity of the
# meet under intersection — so non-LLM spawns are bit-for-bit unchanged.
# Unknown/unmapped profile bits never reach this function as rights: the
# adapter's mapping resolves them to 0 (fail closed) BEFORE the mask is built.

pub val SPAWN_PROFILE_MASK_ALL: u32 = 0xFFFFFFFFu32

pub fn spawn_effective_rights_with_profile(
    parent_rights: u32,
    requested_rights: u32,
    profile_mask: u32
) -> u32:
    """The meet of both attenuations, deny-wins: the result is simultaneously a
    subset of `parent_rights`, of `requested_rights`, and of `profile_mask`
    (pure triple intersection — no union step, no IO, provable). A profile can
    only REMOVE rights relative to the profile-free path; it can never add a
    right the parent lacks or the request did not ask for."""
    parent_rights & requested_rights & profile_mask

pub fn spawn_spec_effective_rights_with_profile(
    spec: SpawnSpec,
    parent_delegable: u32,
    executable_ceiling: u32,
    system_ceiling: u32,
    explicit_denials: u32,
    profile_mask: u32
) -> u32:
    """The spawn decision point with the profile meet applied: first the §5.4
    SpawnSpec formula (`spawn_spec_effective_rights`), then the meet with the
    caller's profile mask. With `SPAWN_PROFILE_MASK_ALL` this is identical to
    `spawn_spec_effective_rights` (no-profile path unchanged)."""
    val base = spawn_spec_effective_rights(
        spec, parent_delegable, executable_ceiling, system_ceiling, explicit_denials)
    spawn_effective_rights_with_profile(parent_delegable, base, profile_mask)

pub fn spawn_recipe_effective_rights(
    recipe: i64,
    parent_rights: u32,
    profile_mask: u32
) -> u32:
    """The rights a migrated caller's child actually ends up with.

    The triple deny-wins meet of parent ∩ recipe-declared ∩ profile. An
    unmigrated recipe declares 0, so it contributes NO rights — the fail-closed
    answer, not a wildcard. Callers with no LLM profile pass
    `SPAWN_PROFILE_MASK_ALL`, the identity of the meet."""
    spawn_effective_rights_with_profile(
        parent_rights, spawn_recipe_rights_mask(recipe), profile_mask)
