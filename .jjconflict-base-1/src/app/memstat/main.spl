# memstat — out-of-process memory sampler (Stage-4 memory gate, lane L5)
#
# Usage: simple run src/app/memstat/main.spl <pid> <out_csv> [interval_ms]
#        simple run src/app/memstat/main.spl --by-owner
#
# Samples /proc/<pid>/smaps_rollup (Rss, Pss, Pss_Anon, Private_Dirty, Swap)
# plus /proc/<pid>/stat minflt/majflt at a fixed interval (default 1000 ms) and
# appends CSV rows to <out_csv>. Exits cleanly when the target PID disappears.
#
# `--by-owner` is a separate, immediate mode: it prints the per-owner
# live/peak/alloc counts (`rt_mem_attr_report`) for the CURRENT process (i.e.
# the memstat process itself, not a sampled <pid>) and exits. It is only
# meaningful when run under `SIMPLE_MEM_ATTR=1` — with attribution off the
# report is empty by design (zero-overhead-when-off).
#
# Three distinguishable outcomes, all non-crashing and none silently empty:
#   1. rows printed        -> rt_mem_attr_enabled() == 1: attribution ON,
#                              this process's owner counters are real data
#                              (the registry always carries a default
#                              "<unattributed>" row, so report.len()==0 does
#                              NOT mean "off" — rt_mem_attr_enabled() is the
#                              actual on/off signal, not the report body).
#   2. "attribution OFF"   -> the extern resolved but rt_mem_attr_enabled()
#                              returned 0: SIMPLE_MEM_ATTR was not 1 for this
#                              process.
#   3. "extern unavailable" -> rt_mem_attr_report itself could not be called
#                              (report.len() < 0, the same negative-sentinel
#                              convention `parse_dec` below uses for "no
#                              digits found"): the running engine build
#                              predates/lacks the rt_mem_attr_* extern wiring.
#                              This is a build staleness issue, not something
#                              --by-owner can fix by itself — see
#                              doc/08_tracking/bug/ for the tracked
#                              extern-availability gap.
#
# Dependency-light by design: only std.io_runtime facades, no app.io coupling,
# so the same module runs under interpreter and native engines.

use std.io_runtime.{get_args, file_read, file_exists, file_write, file_append_text, thread_sleep, time_now_unix_micros}

extern fn rt_mem_attr_report(n: i64) -> text
extern fn rt_mem_attr_enabled() -> i64

val CSV_HEADER = "timestamp_us,rss_kb,pss_kb,pss_anon_kb,private_dirty_kb,swap_kb,minflt,majflt"

# Workaround: native codegen string == is broken (length-only comparison),
# matching the idiom already used in src/app/mem/main.spl.
fn str_eq(a: text, b: text) -> bool:
    a.len() == b.len() and a.starts_with(b)

# Decimal parser over short tokens. Deliberately avoids `parse_int() ?? -1`
# style: `??` on a raw i64 corrupts the value 3 (nil sentinel collision), and
# fault counters legitimately hit small values. Returns -1 when no digits.
fn parse_dec(s: text) -> i64:
    var i = 0
    var n = 0
    var found = false
    val len = s.len()
    while i < len:
        val c = s.char_code_at(i)
        if c >= 48 and c <= 57:
            found = true
            n = n * 10 + (c - 48)
        elif found:
            # Stop at the first non-digit after the number started.
            return n
        i = i + 1
    if found:
        return n
    -1

# First integer appearing anywhere in a short line ("Rss:  1234 kB" -> 1234).
fn first_int_in(line: text) -> i64:
    parse_dec(line)

# Value for a "Key:   N kB" line in smaps_rollup, or -1 when absent.
fn rollup_value(lines: [text], key: text) -> i64:
    for line in lines:
        if line.starts_with(key):
            return first_int_in(line)
    -1

# minflt (field 10) and majflt (field 12) from /proc/<pid>/stat. The comm
# field can contain spaces, so scan backward for the closing paren first.
# stat content is <1 KB, so the backward char walk is cheap.
fn parse_faults(stat: text) -> (i64, i64):
    var idx = stat.len() - 1
    while idx >= 0 and stat.char_at(idx) != ")":
        idx = idx - 1
    if idx < 0:
        return (-1, -1)
    val rest = stat[idx + 1:].trim()
    val tokens = rest.split(" ")
    # After ')': state ppid pgrp session tty tpgid flags minflt cminflt majflt
    if tokens.len() < 10:
        return (-1, -1)
    (parse_dec(tokens[7]), parse_dec(tokens[9]))

# One CSV row, or "" when the target vanished mid-sample.
fn sample_row(rollup_path: text, stat_path: text) -> text:
    val rollup = file_read(rollup_path)
    val stat = file_read(stat_path)
    if rollup.len() == 0 or stat.len() == 0:
        return ""
    val lines = rollup.split("\n")
    val rss = rollup_value(lines, "Rss:")
    val pss = rollup_value(lines, "Pss:")
    val pss_anon = rollup_value(lines, "Pss_Anon:")
    val private_dirty = rollup_value(lines, "Private_Dirty:")
    val swap = rollup_value(lines, "Swap:")
    val (minflt, majflt) = parse_faults(stat)
    val ts = time_now_unix_micros()
    "{ts},{rss},{pss},{pss_anon},{private_dirty},{swap},{minflt},{majflt}"

# Positional args after the interpreter/script prelude. get_args() yields
# [program, ..., script.spl, user args...]; take everything after the first
# argument ending in ".spl", falling back to argv[1:] for compiled binaries.
fn cli_positional_args() -> [text]:
    val all = get_args()
    var rest: [text] = []
    var seen_script = false
    var i = 1
    while i < all.len():
        val a = all[i]
        if seen_script:
            rest = rest.push(a)
        elif a.ends_with(".spl"):
            seen_script = true
        i = i + 1
    if not seen_script:
        rest = []
        i = 1
        while i < all.len():
            rest = rest.push(all[i])
            i = i + 1
    rest

# Prints per-owner live/peak/alloc counts for the CURRENT process (the
# memstat process itself). Meaningful only under SIMPLE_MEM_ATTR=1 — the
# on/off signal is rt_mem_attr_enabled(), NOT the report body (the owner
# registry always carries a default "<unattributed>" row, so a non-empty
# report does not by itself mean attribution is on). See module doc comment
# for the three distinguishable outcomes this prints.
fn cmd_by_owner() -> i64:
    print "memstat --by-owner: per-owner memory report for the CURRENT process"
    print "  (meaningful under SIMPLE_MEM_ATTR=1; empty when attribution is off)"
    val report = rt_mem_attr_report(32)
    if report.len() < 0:
        print "STATUS\tEXTERN_UNAVAILABLE"
        print "  rt_mem_attr_report could not be called on this engine/build"
        print "  (no crash, no data: the extern is not wired up here yet)"
        return 0
    if rt_mem_attr_enabled() != 1:
        print "STATUS\tATTRIBUTION_OFF"
        print "  attribution is off for this process (SIMPLE_MEM_ATTR != 1)"
        return 0
    print "OWNER\tLIVE\tPEAK\tALLOCS"
    print report
    0

fn main() -> i64:
    val args = cli_positional_args()
    if args.len() >= 1 and str_eq(args[0], "--by-owner"):
        return cmd_by_owner()
    if args.len() < 2:
        print "usage: memstat <pid> <out_csv> [interval_ms]"
        print "  samples /proc/<pid>/smaps_rollup + stat faults to CSV until <pid> exits"
        print "usage: memstat --by-owner"
        print "  prints rt_mem_attr_report per-owner counts for the CURRENT process"
        print "  (meaningful under SIMPLE_MEM_ATTR=1)"
        return 2
    val pid = parse_dec(args[0])
    if pid <= 0:
        print "memstat: invalid pid '{args[0]}'"
        return 2
    val out_path = args[1]
    var interval_ms = 1000
    if args.len() >= 3:
        val iv = parse_dec(args[2])
        if iv > 0:
            interval_ms = iv

    val stat_path = "/proc/{pid}/stat"
    val rollup_path = "/proc/{pid}/smaps_rollup"

    if not file_exists(stat_path):
        print "memstat: pid {pid} not found (no {stat_path})"
        return 1

    if not file_write(out_path, CSV_HEADER + "\n"):
        print "memstat: cannot write {out_path}"
        return 1

    var rows = 0
    while file_exists(stat_path):
        val row = sample_row(rollup_path, stat_path)
        if row.len() > 0:
            file_append_text(out_path, row + "\n")
            rows = rows + 1
        thread_sleep(interval_ms)

    print "memstat: pid {pid} exited after {rows} samples -> {out_path}"
    0
