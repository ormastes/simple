# Pure-Simple producer for exact GPU build-binding artifacts.
mod app.test.x25519mlkem768_gpu_binding

use std.cli.cli_util.{get_cli_args}
use app.io.mod.{file_exists, file_is_regular_no_follow, file_read,
    file_hash_sha256, file_atomic_write, file_create_exclusive}
use std.common.crypto.sha256.{sha256_text}
use lib.common.provenance.stage4_compiler_provenance.{
    stage4_compiler_provenance_from_text,
    stage4_compiler_provenance_reason}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend,
    x25519_mlkem768_evidence_backend_name}

val X25519_MLKEM768_GPU_BINDING_SCHEMA =
    "x25519mlkem768-runner-gpu-binary-binding-v1"

struct X25519MlKem768GpuBinding:
    backend: X25519MlKem768EvidenceBackend
    compiler_artifact_sha256: text
    compiler_provenance_sha256: text
    runner_artifact_sha256: text
    accelerator_source_sha256: text
    accelerator_binary_sha256: text
    accelerator_source_aux_sha256: text
    accelerator_binary_aux_sha256: text
    build_toolchain: text
    device_capability: text
    device_name: text

struct X25519MlKem768GpuBindingProducerRequest:
    backend: X25519MlKem768EvidenceBackend
    fixture_manifest: text
    compiler_artifact: text
    compiler_provenance: text
    runner_artifact: text
    accelerator_source: text
    accelerator_binary: text
    accelerator_source_aux: text
    accelerator_binary_aux: text
    build_toolchain: text
    device_capability: text
    device_name: text
    output: text
    overwrite: bool

struct X25519MlKem768GpuBindingReceipt:
    output: text
    output_sha256: text
    backend: X25519MlKem768EvidenceBackend
    field_count: i64

struct X25519MlKem768GpuCanonicalTuple:
    backend: X25519MlKem768EvidenceBackend
    fixture_manifest: text
    accelerator_source: text
    accelerator_source_sha256: text
    accelerator_binary: text
    accelerator_binary_sha256: text
    accelerator_source_aux: text
    accelerator_source_aux_sha256: text
    accelerator_binary_aux: text
    accelerator_binary_aux_sha256: text
    build_toolchain: text
    device_capability: text
    device_name: text

fn _gpu_binding_backend_valid(
        backend: X25519MlKem768EvidenceBackend) -> bool:
    backend == X25519MlKem768EvidenceBackend.Cuda or
        backend == X25519MlKem768EvidenceBackend.Vulkan or
        backend == X25519MlKem768EvidenceBackend.Metal

fn _gpu_binding_sha256_valid(value: text) -> bool:
    if value.len() != 64: return false
    var index: i64 = 0
    while index < value.len():
        val code = value.char_code_at(index)
        val decimal = code >= 48 and code <= 57
        val lower_hex = code >= 97 and code <= 102
        if not decimal and not lower_hex: return false
        index = index + 1
    true

fn _gpu_binding_field_valid(value: text) -> bool:
    value != "" and value == value.trim() and
        not value.contains("\n") and not value.contains("\r") and
        not value.contains("\t") and not value.contains("=")

fn x25519_mlkem768_gpu_canonical_tuple_reason(
        tuple: X25519MlKem768GpuCanonicalTuple) -> text:
    if tuple.backend == X25519MlKem768EvidenceBackend.Vulkan:
        if (tuple.accelerator_source !=
                "src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt_forward.comp" or
            tuple.accelerator_source_sha256 !=
                "f29443943a381012f34e26a7ab2ac44bee51338d78662109c47e0182aa1fc668" or
            tuple.accelerator_source_aux !=
                "src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt_inverse.comp" or
            tuple.accelerator_source_aux_sha256 !=
                "b1e5a9ed87e4331abb5ac7ab906418aa9e4c927d2e284174990110318382e09c" or
            tuple.accelerator_binary !=
                "build/evidence/x25519mlkem768/vulkan/x25519mlkem768_ntt_forward.spv" or
            tuple.accelerator_binary_sha256 !=
                "0865f588f0825a3ff66a1d5e2cd2a9d0c356bb75b4fceaaf5c2196ffa05f6379" or
            tuple.accelerator_binary_aux !=
                "build/evidence/x25519mlkem768/vulkan/x25519mlkem768_ntt_inverse.spv" or
            tuple.accelerator_binary_aux_sha256 !=
                "07a11b541ef204a4fb6c907338dafc99bdf870d2046edcfad02a3d42dcca2687"):
            return "vulkan-canonical-source-binary-set-mismatch"
        val vulkan_toolchain =
            "glslangValidator-sha256:96ea85d4228d7065507cd58454628e0d3c9ec8bbd29a0cd20ee0f3cefaf6d026" +
            "+spirv-val-sha256:20c5998a46f02310f56bf11be238c34d374bb50104b7ccf85bb909f9da883ff9"
        if tuple.build_toolchain != vulkan_toolchain:
            return "vulkan-build-toolchain-not-pinned"
        if tuple.device_capability != "vulkan1.1":
            return "vulkan-device-capability-not-pinned"
        if (tuple.device_name != "NVIDIA RTX A6000" and
                tuple.device_name != "NVIDIA TITAN RTX"):
            return "vulkan-device-name-not-pinned"
        if (not tuple.fixture_manifest.contains(
                "forward_source: \"" + tuple.accelerator_source + "\"") or
            not tuple.fixture_manifest.contains(
                "forward_source_sha256: \"" +
                    tuple.accelerator_source_sha256 + "\"") or
            not tuple.fixture_manifest.contains(
                "inverse_source: \"" + tuple.accelerator_source_aux + "\"") or
            not tuple.fixture_manifest.contains(
                "inverse_source_sha256: \"" +
                    tuple.accelerator_source_aux_sha256 + "\"") or
            not tuple.fixture_manifest.contains(
                "forward_transient_spirv_sha256: \"" +
                    tuple.accelerator_binary_sha256 + "\"") or
            not tuple.fixture_manifest.contains(
                "inverse_transient_spirv_sha256: \"" +
                    tuple.accelerator_binary_aux_sha256 + "\"") or
            not tuple.fixture_manifest.contains(
                "retained_artifact_targets: \"" + tuple.accelerator_binary +
                    ";" + tuple.accelerator_binary_aux + ";") or
            not tuple.fixture_manifest.contains(
                "affected_devices: \"NVIDIA RTX A6000; NVIDIA TITAN RTX\"")):
            return "vulkan-binary-device-set-not-pinned-by-fixture-manifest"
        return ""
    if tuple.backend == X25519MlKem768EvidenceBackend.Cuda:
        if (tuple.accelerator_source !=
                "src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt_forward.ptx" or
            tuple.accelerator_source_sha256 !=
                "e3201ae10f48e284d703cff81d42a02d9ba7f96e4bcc9b03872094b25a5a26aa"):
            return "cuda-canonical-source-mismatch"
        if tuple.build_toolchain != "CUDA ptxas 13.0 V13.0.88":
            return "cuda-build-toolchain-not-pinned"
        val a6000 = (
            tuple.device_name == "NVIDIA RTX A6000" and
            tuple.device_capability == "8.6" and
            tuple.accelerator_binary ==
                "build/evidence/x25519mlkem768/cuda/sm_86.cubin" and
            tuple.accelerator_binary_sha256 ==
                "562bfee3e9cd630425a69a5b27a0cc6661f0a00609a85078ef376565fb5b7711")
        val titan = (
            tuple.device_name == "NVIDIA TITAN RTX" and
            tuple.device_capability == "7.5" and
            tuple.accelerator_binary ==
                "build/evidence/x25519mlkem768/cuda/sm_75.cubin" and
            tuple.accelerator_binary_sha256 ==
                "41a90792d1286c42014da98d1205972acbf9d60220981c9cc505dddf2b18069f")
        if not a6000 and not titan:
            return "cuda-device-capability-binary-tuple-mismatch"
        if (not tuple.fixture_manifest.contains(
                "assembler: \"" + tuple.build_toolchain + "\"") or
            not tuple.fixture_manifest.contains(
                "retained_artifact: \"" + tuple.accelerator_binary + "\"") or
            not tuple.fixture_manifest.contains(
                "retained_artifact_sha256: \"" +
                    tuple.accelerator_binary_sha256 + "\"") or
            not tuple.fixture_manifest.contains(
                "name: \"" + tuple.device_name + "\" capability: \"" +
                    tuple.device_capability + "\"")):
            return "cuda-binary-device-row-not-pinned-by-fixture-manifest"
        return ""
    if tuple.backend == X25519MlKem768EvidenceBackend.Metal:
        if (tuple.accelerator_source !=
                "src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt.metal" or
            tuple.accelerator_source_sha256 !=
                "74608e1e4f5fb40da7205dd8e8d57038d73f824b2b3ca85de1f159543e6897cc" or
            tuple.accelerator_binary !=
                "build/evidence/x25519mlkem768/metal/x25519mlkem768_ntt.metallib"):
            return "metal-canonical-source-binary-set-mismatch"
        return "metal-binary-digest-not-pinned-by-fixture-manifest"
    "gpu-binding-backend-invalid"

fn x25519_mlkem768_render_gpu_binding(
        binding: X25519MlKem768GpuBinding) -> Result<text, text>:
    if not _gpu_binding_backend_valid(binding.backend):
        return Err("gpu-binding-backend-invalid")
    if (not _gpu_binding_sha256_valid(binding.compiler_artifact_sha256) or
            not _gpu_binding_sha256_valid(
                binding.compiler_provenance_sha256) or
            not _gpu_binding_sha256_valid(binding.runner_artifact_sha256) or
            not _gpu_binding_sha256_valid(
                binding.accelerator_source_sha256) or
            not _gpu_binding_sha256_valid(
                binding.accelerator_binary_sha256)):
        return Err("gpu-binding-required-sha256-invalid")
    val vulkan = binding.backend == X25519MlKem768EvidenceBackend.Vulkan
    if vulkan:
        if (not _gpu_binding_sha256_valid(
                binding.accelerator_source_aux_sha256) or
                not _gpu_binding_sha256_valid(
                    binding.accelerator_binary_aux_sha256)):
            return Err("gpu-binding-vulkan-aux-sha256-invalid")
    elif (binding.accelerator_source_aux_sha256 != "" or
            binding.accelerator_binary_aux_sha256 != ""):
        return Err("gpu-binding-unexpected-aux-sha256")
    if (not _gpu_binding_field_valid(binding.build_toolchain) or
            not _gpu_binding_field_valid(binding.device_capability) or
            not _gpu_binding_field_valid(binding.device_name)):
        return Err("gpu-binding-metadata-invalid")
    var encoded =
        "schema=" + X25519_MLKEM768_GPU_BINDING_SCHEMA + "\n" +
        "backend=" + x25519_mlkem768_evidence_backend_name(binding.backend) +
            "\n" +
        "compiler_artifact_sha256=" + binding.compiler_artifact_sha256 + "\n" +
        "compiler_provenance_sha256=" +
            binding.compiler_provenance_sha256 + "\n" +
        "runner_artifact_sha256=" + binding.runner_artifact_sha256 + "\n" +
        "accelerator_source_sha256=" +
            binding.accelerator_source_sha256 + "\n" +
        "accelerator_binary_sha256=" +
            binding.accelerator_binary_sha256 + "\n"
    if vulkan:
        encoded = encoded + "accelerator_source_aux_sha256=" +
            binding.accelerator_source_aux_sha256 + "\n" +
            "accelerator_binary_aux_sha256=" +
            binding.accelerator_binary_aux_sha256 + "\n"
    encoded = encoded + "build_toolchain=" + binding.build_toolchain + "\n" +
        "device_capability=" + binding.device_capability + "\n" +
        "device_name=" + binding.device_name + "\n"
    Ok(encoded)

fn _gpu_binding_path_collides(
        request: X25519MlKem768GpuBindingProducerRequest) -> bool:
    (request.output == request.fixture_manifest or
        request.output == request.compiler_artifact or
        request.output == request.compiler_provenance or
        request.output == request.runner_artifact or
        request.output == request.accelerator_source or
        request.output == request.accelerator_binary or
        request.output == request.accelerator_source_aux or
        request.output == request.accelerator_binary_aux)

fn _gpu_binding_safe_path(path: text) -> bool:
    path != "" and not path.starts_with("/") and not path.starts_with("\\") and
        not path.starts_with("../") and not path.contains("/../") and
        not path.contains("//") and not path.contains("\\")

fn _gpu_binding_required_files_regular(
        request: X25519MlKem768GpuBindingProducerRequest) -> bool:
    file_is_regular_no_follow(request.fixture_manifest) and
        file_is_regular_no_follow(request.compiler_artifact) and
        file_is_regular_no_follow(request.compiler_provenance) and
        file_is_regular_no_follow(request.runner_artifact) and
        file_is_regular_no_follow(request.accelerator_source) and
        file_is_regular_no_follow(request.accelerator_binary)

fn x25519_mlkem768_produce_gpu_binding(
        request: X25519MlKem768GpuBindingProducerRequest
        ) -> Result<X25519MlKem768GpuBindingReceipt, text>:
    if not _gpu_binding_backend_valid(request.backend):
        return Err("gpu-binding-backend-invalid")
    if (not _gpu_binding_safe_path(request.output) or
            not _gpu_binding_safe_path(request.fixture_manifest) or
            not _gpu_binding_safe_path(request.compiler_artifact) or
            not _gpu_binding_safe_path(request.compiler_provenance) or
            not _gpu_binding_safe_path(request.runner_artifact) or
            not _gpu_binding_safe_path(request.accelerator_source) or
            not _gpu_binding_safe_path(request.accelerator_binary) or
            _gpu_binding_path_collides(request)):
        return Err("gpu-binding-output-path-invalid")
    if request.compiler_provenance != request.compiler_artifact +
            ".provenance.env":
        return Err("gpu-binding-compiler-provenance-not-adjacent")
    if file_exists(request.output) and not request.overwrite:
        return Err("gpu-binding-output-exists")
    if file_exists(request.output) and not file_is_regular_no_follow(request.output):
        return Err("gpu-binding-output-not-regular-no-follow")
    if not _gpu_binding_required_files_regular(request):
        return Err("gpu-binding-input-not-regular-no-follow")
    val vulkan = request.backend == X25519MlKem768EvidenceBackend.Vulkan
    if vulkan:
        if (not _gpu_binding_safe_path(request.accelerator_source_aux) or
                not _gpu_binding_safe_path(request.accelerator_binary_aux) or
                not file_is_regular_no_follow(request.accelerator_source_aux) or
                not file_is_regular_no_follow(request.accelerator_binary_aux)):
            return Err("gpu-binding-vulkan-aux-input-not-regular-no-follow")
    elif (request.accelerator_source_aux != "" or
            request.accelerator_binary_aux != ""):
        return Err("gpu-binding-unexpected-aux-input")
    val manifest_sha256 = file_hash_sha256(request.fixture_manifest)
    val compiler_sha256 = file_hash_sha256(request.compiler_artifact)
    val provenance_sha256 = file_hash_sha256(request.compiler_provenance)
    val runner_sha256 = file_hash_sha256(request.runner_artifact)
    val source_sha256 = file_hash_sha256(request.accelerator_source)
    val binary_sha256 = file_hash_sha256(request.accelerator_binary)
    val source_aux_sha256 = if vulkan:
        file_hash_sha256(request.accelerator_source_aux)
    else:
        ""
    val binary_aux_sha256 = if vulkan:
        file_hash_sha256(request.accelerator_binary_aux)
    else:
        ""
    val fixture_manifest = file_read(request.fixture_manifest)
    val provenance_text = file_read(request.compiler_provenance)
    val provenance = stage4_compiler_provenance_from_text(provenance_text)
    if stage4_compiler_provenance_reason(
            provenance, compiler_sha256, provenance_sha256) != "ready":
        return Err("gpu-binding-compiler-stage4-provenance-invalid")
    val tuple_reason = x25519_mlkem768_gpu_canonical_tuple_reason(
        X25519MlKem768GpuCanonicalTuple(
            backend: request.backend,
            fixture_manifest: fixture_manifest,
            accelerator_source: request.accelerator_source,
            accelerator_source_sha256: source_sha256,
            accelerator_binary: request.accelerator_binary,
            accelerator_binary_sha256: binary_sha256,
            accelerator_source_aux: request.accelerator_source_aux,
            accelerator_source_aux_sha256: source_aux_sha256,
            accelerator_binary_aux: request.accelerator_binary_aux,
            accelerator_binary_aux_sha256: binary_aux_sha256,
            build_toolchain: request.build_toolchain,
            device_capability: request.device_capability,
            device_name: request.device_name))
    if tuple_reason != "": return Err(tuple_reason)
    val binding = X25519MlKem768GpuBinding(
        backend: request.backend,
        compiler_artifact_sha256: compiler_sha256,
        compiler_provenance_sha256: provenance_sha256,
        runner_artifact_sha256: runner_sha256,
        accelerator_source_sha256: source_sha256,
        accelerator_binary_sha256: binary_sha256,
        accelerator_source_aux_sha256: source_aux_sha256,
        accelerator_binary_aux_sha256: binary_aux_sha256,
        build_toolchain: request.build_toolchain,
        device_capability: request.device_capability,
        device_name: request.device_name)
    val encoded = x25519_mlkem768_render_gpu_binding(binding)?
    if (manifest_sha256 != file_hash_sha256(request.fixture_manifest) or
            fixture_manifest != file_read(request.fixture_manifest) or
            compiler_sha256 != file_hash_sha256(request.compiler_artifact) or
            provenance_sha256 != file_hash_sha256(request.compiler_provenance) or
            provenance_text != file_read(request.compiler_provenance) or
            runner_sha256 != file_hash_sha256(request.runner_artifact) or
            source_sha256 != file_hash_sha256(request.accelerator_source) or
            binary_sha256 != file_hash_sha256(request.accelerator_binary) or
            (vulkan and (source_aux_sha256 !=
                file_hash_sha256(request.accelerator_source_aux) or
                binary_aux_sha256 !=
                    file_hash_sha256(request.accelerator_binary_aux)))):
        return Err("gpu-binding-input-changed-during-hash")
    val write_ok = if request.overwrite:
        file_atomic_write(request.output, encoded)
    else:
        file_create_exclusive(request.output, encoded)
    if not write_ok: return Err("gpu-binding-output-write-failed")
    if not file_is_regular_no_follow(request.output):
        return Err("gpu-binding-output-not-regular-after-write")
    val output_sha256 = file_hash_sha256(request.output)
    if file_read(request.output) != encoded or output_sha256 != sha256_text(encoded):
        return Err("gpu-binding-output-sha256-mismatch")
    Ok(X25519MlKem768GpuBindingReceipt(
        output: request.output, output_sha256: output_sha256,
        backend: request.backend, field_count: if vulkan: 12 else: 10))

fn _gpu_binding_parse_backend(value: text
        ) -> Result<X25519MlKem768EvidenceBackend, text>:
    if value == "cuda": return Ok(X25519MlKem768EvidenceBackend.Cuda)
    if value == "vulkan": return Ok(X25519MlKem768EvidenceBackend.Vulkan)
    if value == "metal": return Ok(X25519MlKem768EvidenceBackend.Metal)
    Err("gpu-binding-backend-invalid")

fn x25519_mlkem768_parse_gpu_binding(encoded: text
        ) -> Result<X25519MlKem768GpuBinding, text>:
    if not encoded.ends_with("\n") or encoded.ends_with("\n\n"):
        return Err("gpu-binding-termination-invalid")
    val allowed = ["schema", "backend", "compiler_artifact_sha256",
        "compiler_provenance_sha256", "runner_artifact_sha256",
        "accelerator_source_sha256", "accelerator_binary_sha256",
        "accelerator_source_aux_sha256", "accelerator_binary_aux_sha256",
        "build_toolchain", "device_capability", "device_name"]
    var fields: Dict<text, text> = {}
    for line in encoded.trim().split("\n"):
        val separator = line.index_of("=")
        if separator < 1: return Err("gpu-binding-field-invalid")
        val key = line.substring(0, separator)
        val value = line.substring(separator + 1, line.len())
        if not allowed.contains(key): return Err("gpu-binding-field-unknown-" + key)
        if fields.has(key): return Err("gpu-binding-duplicate-" + key)
        fields[key] = value
    if (fields["schema"] ?? "") != X25519_MLKEM768_GPU_BINDING_SCHEMA:
        return Err("gpu-binding-schema-invalid")
    val backend = _gpu_binding_parse_backend(fields["backend"] ?? "")?
    val vulkan = backend == X25519MlKem768EvidenceBackend.Vulkan
    val expected_fields: i64 = if vulkan: 12 else: 10
    if fields.len().to_i64() != expected_fields:
        return Err("gpu-binding-field-count-invalid")
    val binding = X25519MlKem768GpuBinding(
        backend: backend,
        compiler_artifact_sha256: fields["compiler_artifact_sha256"] ?? "",
        compiler_provenance_sha256:
            fields["compiler_provenance_sha256"] ?? "",
        runner_artifact_sha256: fields["runner_artifact_sha256"] ?? "",
        accelerator_source_sha256:
            fields["accelerator_source_sha256"] ?? "",
        accelerator_binary_sha256:
            fields["accelerator_binary_sha256"] ?? "",
        accelerator_source_aux_sha256:
            fields["accelerator_source_aux_sha256"] ?? "",
        accelerator_binary_aux_sha256:
            fields["accelerator_binary_aux_sha256"] ?? "",
        build_toolchain: fields["build_toolchain"] ?? "",
        device_capability: fields["device_capability"] ?? "",
        device_name: fields["device_name"] ?? "")
    val _ = x25519_mlkem768_render_gpu_binding(binding)?
    Ok(binding)

fn _gpu_binding_parse_overwrite(value: text) -> Result<bool, text>:
    if value == "" or value == "false": return Ok(false)
    if value == "true": return Ok(true)
    Err("gpu-binding-overwrite-invalid")

fn _gpu_binding_cli_value(args: [text], key: text) -> Result<text, text>:
    var value = ""
    var index: i64 = 0
    while index < args.len():
        if index + 1 >= args.len(): return Err("missing-value-for-" + args[index])
        if args[index] == key:
            if value != "": return Err("duplicate-" + key.substring(2, key.len()))
            value = args[index + 1]
        index = index + 2
    Ok(value)

fn _gpu_binding_cli_request(args: [text]
        ) -> Result<X25519MlKem768GpuBindingProducerRequest, text>:
    val known = ["--backend", "--fixture-manifest",
        "--compiler-artifact", "--compiler-provenance",
        "--runner-artifact", "--accelerator-source", "--accelerator-binary",
        "--accelerator-source-aux", "--accelerator-binary-aux",
        "--build-toolchain", "--device-capability", "--device-name", "--output",
        "--overwrite"]
    var index: i64 = 0
    while index < args.len():
        if index + 1 >= args.len(): return Err("missing-value-for-" + args[index])
        if not known.contains(args[index]):
            return Err("unknown-option-" + args[index])
        index = index + 2
    val backend = _gpu_binding_parse_backend(
        _gpu_binding_cli_value(args, "--backend")?)?
    Ok(X25519MlKem768GpuBindingProducerRequest(
        backend: backend,
        fixture_manifest: _gpu_binding_cli_value(
            args, "--fixture-manifest")?,
        compiler_artifact: _gpu_binding_cli_value(
            args, "--compiler-artifact")?,
        compiler_provenance: _gpu_binding_cli_value(
            args, "--compiler-provenance")?,
        runner_artifact: _gpu_binding_cli_value(args, "--runner-artifact")?,
        accelerator_source: _gpu_binding_cli_value(
            args, "--accelerator-source")?,
        accelerator_binary: _gpu_binding_cli_value(
            args, "--accelerator-binary")?,
        accelerator_source_aux: _gpu_binding_cli_value(
            args, "--accelerator-source-aux")?,
        accelerator_binary_aux: _gpu_binding_cli_value(
            args, "--accelerator-binary-aux")?,
        build_toolchain: _gpu_binding_cli_value(args, "--build-toolchain")?,
        device_capability: _gpu_binding_cli_value(args, "--device-capability")?,
        device_name: _gpu_binding_cli_value(args, "--device-name")?,
        output: _gpu_binding_cli_value(args, "--output")?,
        overwrite: _gpu_binding_parse_overwrite(
            _gpu_binding_cli_value(args, "--overwrite")?)?))

fn main() -> i64:
    val request = match _gpu_binding_cli_request(get_cli_args()):
        case Ok(value): value
        case Err(reason):
            print "status=fail\nreason={reason}"
            return 2
    val receipt = match x25519_mlkem768_produce_gpu_binding(request):
        case Ok(value): value
        case Err(reason):
            print "status=fail\nreason={reason}"
            return 1
    print "status=pass"
    print "backend={x25519_mlkem768_evidence_backend_name(receipt.backend)}"
    print "field_count={receipt.field_count}"
    print "output={receipt.output}"
    print "output_sha256={receipt.output_sha256}"
    0

