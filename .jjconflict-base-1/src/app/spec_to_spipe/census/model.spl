# codex-impl
# Deterministic repository-census contracts for the spec-to-SPipe migration.

struct SpecCensusEntry:
    canonical_source: text
    generated_documentation_path: text
    owner: text
    test_tier: text
    quality_classification: text
    migration_state: text
    executable_spec_path: text

fn spec_census_entry(
    executable_spec_path: text,
    canonical_source: text,
    generated_documentation_path: text,
    owner: text,
    test_tier: text,
    quality_classification: text,
    migration_state: text
) -> SpecCensusEntry:
    SpecCensusEntry(
        canonical_source: canonical_source,
        generated_documentation_path: generated_documentation_path,
        owner: owner,
        test_tier: test_tier,
        quality_classification: quality_classification,
        migration_state: migration_state,
        executable_spec_path: executable_spec_path
    )

fn _census_entry_key(entry: SpecCensusEntry) -> text:
    entry.executable_spec_path + "\u{1f}" + entry.canonical_source + "\u{1f}" +
        entry.generated_documentation_path + "\u{1f}" + entry.owner + "\u{1f}" +
        entry.test_tier + "\u{1f}" + entry.quality_classification + "\u{1f}" +
        entry.migration_state

# Return a new, byte-order-stable inventory. The caller's array is not mutated.
fn sort_spec_census_entries(entries: [SpecCensusEntry]) -> [SpecCensusEntry]:
    var remaining: [SpecCensusEntry] = []
    for entry in entries:
        remaining.push(entry)

    var ordered: [SpecCensusEntry] = []
    while remaining.len() > 0:
        var minimum = 0
        var index = 1
        while index < remaining.len():
            if _census_entry_key(remaining[index]) < _census_entry_key(remaining[minimum]):
                minimum = index
            index = index + 1

        ordered.push(remaining[minimum])
        var next_remaining: [SpecCensusEntry] = []
        var retained = 0
        while retained < remaining.len():
            if retained != minimum:
                next_remaining.push(remaining[retained])
            retained = retained + 1
        remaining = next_remaining
    ordered

