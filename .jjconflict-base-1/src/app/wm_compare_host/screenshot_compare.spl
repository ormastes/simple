# Host adapter: pixel-buffer comparison primitives for wm_compare.
#
# Lives outside wm_lane_scope_dirs() (see
# src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl:51) so the
# os.compositor.screenshot_compare import below is legal here. Every symbol
# here is a pure function over in-memory [u32] pixel buffers (no I/O, no
# mutable state), so a facade re-export is the correct boundary, same as
# wave 1's stateless facades.
# See doc/03_plan/ui/wm_lane_boundary_ratchet_lanes.md (tranche W2, wave 2).

export use os.compositor.screenshot_compare.{
    ComparisonResult, ChannelDiffResult, DiffRegion,
    compare_exact, compare_per_channel, compare_pixel_buffers,
    find_diff_regions, generate_diff_image
}
