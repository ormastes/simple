# Stable public model for SSpec maintenance analysis and machine reports.
use std.tooling.easy_fix.types.{EasyFix}

struct SspecRuleDefinition:
    rule_id: text
    dimension: text
    default_severity: text
    deduction: i64
    blocker: bool
    title: text
    detection: text
    rationale: text
    false_positive_limits: text
    suppression_policy: text
    safe_edit: bool

struct SspecScenarioFacts:
    name: text
    line: i64
    end_line: i64
    step_count: i64
    assertion_count: i64
    real_assertion_count: i64
    capture_count: i64
    requirement_count: i64
    pending: bool
    source_only_oracle: bool
    local_arithmetic_oracle: bool
    magic_expected_count: i64

struct SspecSourceFacts:
    path: text
    source_hash: text
    line_count: i64
    has_purpose: bool
    has_placeholder_narrative: bool
    has_manual_sections: bool
    has_folding: bool
    has_troubleshooting: bool
    has_internal_reader_tags: bool
    has_bare_step_annotation: bool
    has_repeated_setup: bool
    has_coverage_case: bool
    scenario_count: i64
    assertion_count: i64
    real_assertion_count: i64
    step_count: i64
    capture_count: i64
    requirement_count: i64
    planned_requirement_count: i64
    dangling_requirement_count: i64
    coverage_required: bool
    coverage_scenario_count: i64
    lifecycle_paths: [text]
    scenarios: [SspecScenarioFacts]

struct SspecManualFacts:
    path: text
    content_hash: text
    line_count: i64
    heading_count: i64
    visible_step_count: i64
    evidence_block_count: i64
    trace_link_count: i64
    has_primary_flow: bool
    has_verification: bool
    has_troubleshooting: bool
    has_source_identity: bool
    has_internal_tags: bool
    missing_professional_sections: [text]

struct SspecDocumentizationFinding:
    rule_id: text
    dimension: text
    severity: text
    confidence: text
    path: text
    line: i64
    column: i64
    end_line: i64
    end_column: i64
    evidence: text
    rationale: text
    remediation: text
    fingerprint: text
    baseline_state: text
    score_deduction: i64
    blocker: bool
    fixable: bool
    safe_fix_id: text
    easy_fix: Option<EasyFix>
    suppressed: bool
    suppression_owner: text
    suppression_reason: text

struct SspecDocumentizationScore:
    narrative: i64
    structure: i64
    oracle: i64
    traceability: i64
    evidence: i64
    coverage: i64
    maintainability: i64
    raw_aggregate: i64
    effective_aggregate: i64
    aggregate: i64
    blocker_count: i64
    blockers: i64
    release_ready: bool

struct SspecDocumentizationReport:
    schema_version: text
    rule_version: text
    tool_version: text
    source_path: text
    source_hash: text
    mirror_path: text
    mirror_hash: text
    mirror_state: text
    cache_disposition: text
    score: SspecDocumentizationScore
    findings: [SspecDocumentizationFinding]
    resolved_fingerprints: [text]
    referenced_lint_rule_ids: [text]
    suppressed_count: i64
    scenario_count: i64
    assertion_count: i64
    real_assertion_count: i64
    step_count: i64
    capture_count: i64
    requirement_count: i64

struct SspecDocumentizeResult:
    content: text
    report: SspecDocumentizationReport

struct SspecMaintenanceOptions:
    format: text
    min_score: i64
    deny_severity: text
    cache_path: text
    baseline_path: text
    suppressions_path: text
    no_cache: bool
    rule_filter: [text]
    interactive: bool
    apply: bool
    output_directory: text
    include_scorecard: bool
    debug_timings: bool

struct ReferenceSpecScaffoldOptions:
    input_path: text
    output_path: text
    overwrite: bool
    preview: bool
    stdout: bool
    requirement_prefix: text
    include_source_identity: bool

struct SspecImprovement:
    content: text
    changed: bool
    rollback_content: text

struct SspecSuppression:
    rule_id: text
    owner: text
    reason: text
    fingerprint: text

fn empty_score() -> SspecDocumentizationScore:
    SspecDocumentizationScore(narrative: 100, structure: 100, oracle: 100,
        traceability: 100, evidence: 100, coverage: 100, maintainability: 100,
        raw_aggregate: 100, effective_aggregate: 100, aggregate: 100,
        blocker_count: 0, blockers: 0, release_ready: true)
