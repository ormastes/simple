# Reviewed suppression codec and application. Blockers cannot be suppressed.
use app.sspec_maintain.model.*
use app.sspec_maintain.score.{score_sspec_findings}
use app.sspec_maintain.rules.{sspec_rule_definition}

fn parse_sspec_suppressions(content: text) -> Result<[SspecSuppression], text>:
    """Parse RULE_ID|owner|reason|optional-fingerprint records; O(lines)."""
    var suppressions: [SspecSuppression] = []
    var line_number: i64 = 0
    for raw in content.split("\n"):
        line_number = line_number + 1
        val line = raw.trim()
        if line == "" or line.starts_with("#"): continue
        val fields = line.split("|")
        if fields.len() < 3 or fields[0].trim() == "" or
                fields[1].trim() == "" or fields[2].trim() == "":
            return Err("invalid suppression at line {line_number}: rule ID, owner, and reason are required")
        if not sspec_rule_definition(fields[0].trim()).?:
            return Err("unknown suppression rule at line {line_number}: {fields[0].trim()}")
        suppressions.push(SspecSuppression(rule_id: fields[0].trim(),
            owner: fields[1].trim(), reason: fields[2].trim(),
            fingerprint: if fields.len() > 3: fields[3].trim() else: ""))
    Ok(suppressions)

fn _suppression_for(finding: SspecDocumentizationFinding,
        suppressions: [SspecSuppression]) -> Option<SspecSuppression>:
    for suppression in suppressions:
        if suppression.rule_id == finding.rule_id and
                (suppression.fingerprint == "" or
                    suppression.fingerprint == finding.fingerprint):
            return Some(suppression)
    None

fn _suppressed_finding(finding: SspecDocumentizationFinding,
        suppression: SspecSuppression) -> SspecDocumentizationFinding:
    SspecDocumentizationFinding(rule_id: finding.rule_id,
        dimension: finding.dimension, severity: finding.severity,
        confidence: finding.confidence, path: finding.path, line: finding.line,
        column: finding.column, end_line: finding.end_line,
        end_column: finding.end_column, evidence: finding.evidence,
        rationale: finding.rationale, remediation: finding.remediation,
        fingerprint: finding.fingerprint, baseline_state: finding.baseline_state,
        score_deduction: finding.score_deduction, blocker: finding.blocker,
        fixable: finding.fixable, safe_fix_id: finding.safe_fix_id,
        easy_fix: finding.easy_fix, suppressed: true,
        suppression_owner: suppression.owner,
        suppression_reason: suppression.reason)

fn apply_sspec_suppressions(report: SspecDocumentizationReport,
        suppressions: [SspecSuppression]) -> Result<SspecDocumentizationReport, text>:
    """Apply reviewed non-blocker suppressions and rescore; O(findings*suppressions)."""
    var updated = report
    var findings: [SspecDocumentizationFinding] = []
    var active: [SspecDocumentizationFinding] = []
    var suppressed_count: i64 = 0
    for finding in report.findings:
        match _suppression_for(finding, suppressions):
            case Some(suppression):
                if finding.blocker:
                    return Err("blocker {finding.rule_id} cannot be suppressed")
                val suppressed = _suppressed_finding(finding, suppression)
                findings.push(suppressed)
                suppressed_count = suppressed_count + 1
            case None:
                findings.push(finding)
                active.push(finding)
    updated.findings = findings
    updated.score = score_sspec_findings(active)
    updated.suppressed_count = suppressed_count
    Ok(updated)
