#!/bin/sh
# GHDL SoC-sim: boot the FULL rv64 SimpleOS kernel on the Simple rv64 soft-core.
#
# rv64 sibling of ghdl_rv32_simpleos_boot.shs. The stock rv64_exec_core confines
# code+data to a 64 KB window; the full SimpleOS smoke kernel enters at
# 0x80200000 with sp=0x80a1e010 and a heap up to 0x84a1f000, so this lane uses
# rv64_exec_core_flat.vhd: the SAME RV64IM/Zicsr datapath plus a ported RV64C
# decoder, backed by a single flat ~80 MB behavioral RAM (word_index = off/8,
# 0x80000000..~0x85000000) with reset PC 0x80200000 (M-mode-direct — the smoke
# kernel executes zero privileged instructions, so no OpenSBI/satp is needed).
# On silicon the ~80 MB is PS DDR over AXI; the behavioral array is the GHDL
# stand-in.
#
# It:
#   1. flattens the kernel ELF's loadable PROGBITS into rv64_flat.mem, zero-
#      padded in front so file byte 0 maps to 0x80000000 and the entry lands at
#      0x80200000. Words are 64-bit LE (16 hex digits/line, hread format).
#   2. truncates the FAT image into rv64_ramdisk.mem (64-bit LE words) for the
#      0x88000000 ramdisk bank (virtio_blk_read_sector() memcpys sectors out of
#      it once the kernel auto-detects the FAT signature there).
#   3. analyses/elaborates the flat core + tb_rv64_simpleos_boot and runs it;
#   4. prints the UART boot markers the kernel emits.
#
# NO Vivado. GHDL simulation only.
set -e
ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR"

RTL_DIR="$ROOT_DIR/examples/09_embedded/fpga_riscv/rtl"
WORK_DIR="$ROOT_DIR/build/ghdl/rv64_simpleos_boot"
KERNEL_ELF="${KERNEL_ELF:-$ROOT_DIR/build/os/simpleos_riscv64_smf_fs.elf}"
FAT_IMG="${FAT_IMG:-$ROOT_DIR/build/os/fat32-riscv64.img}"
# 1 MiB ramdisk window (rv64_exec_core_flat RDISK_WORDS=131072 * 8 bytes).
RAMDISK_BYTES="${RAMDISK_BYTES:-1048576}"
# Flat RAM base; kernel entry LMA determines the zero-pad.
RAM_BASE=$((0x80000000))

command -v ghdl >/dev/null 2>&1 || { echo "ERROR: ghdl not found in PATH"; exit 1; }
[ -f "$KERNEL_ELF" ] || { echo "ERROR: kernel ELF missing: $KERNEL_ELF"; exit 1; }
[ -f "$FAT_IMG" ] || { echo "ERROR: FAT ramdisk image missing: $FAT_IMG"; exit 1; }

mkdir -p "$WORK_DIR"
echo "=== GHDL RV64 SimpleOS kernel boot (flat 80MB core + 1MB ramdisk bank) ==="
echo "  Kernel ELF: $KERNEL_ELF"
echo "  Ramdisk img: $FAT_IMG (first $RAMDISK_BYTES bytes -> 0x88000000)"

# 1. Flatten loadable PROGBITS. objcopy -O binary emits one image from the lowest
#    LMA; zero-pad the front by (lowest_LMA - RAM_BASE) so the kernel lands at
#    its real address in the flat RAM.
riscv64-unknown-elf-objcopy -O binary "$KERNEL_ELF" "$WORK_DIR/kernel.bin"
LOW_LMA=$(riscv64-unknown-elf-readelf -l "$KERNEL_ELF" \
  | awk '/LOAD/ {getline; print strtonum($1); exit}')
# readelf prints PhysAddr on the LOAD line's 3rd field; recompute robustly.
LOW_LMA=$(riscv64-unknown-elf-readelf -l "$KERNEL_ELF" \
  | awk '/LOAD/ {print strtonum($3); exit}')
PAD=$(( LOW_LMA - RAM_BASE ))
echo "  Lowest LMA: $(printf 0x%x "$LOW_LMA")  front zero-pad: $PAD bytes"
[ "$PAD" -ge 0 ] || { echo "ERROR: lowest LMA below RAM base"; exit 1; }
head -c "$PAD" /dev/zero > "$WORK_DIR/flat.bin"
cat "$WORK_DIR/kernel.bin" >> "$WORK_DIR/flat.bin"
# Pad tail so the final od row is a full 8-byte word.
TAIL=$(( 8 - ( $(wc -c < "$WORK_DIR/flat.bin") % 8 ) ))
[ "$TAIL" -eq 8 ] || head -c "$TAIL" /dev/zero >> "$WORK_DIR/flat.bin"
od -An -v -tx8 -w8 "$WORK_DIR/flat.bin" | awk 'NF{print $1}' > "$WORK_DIR/rv64_flat.mem"
echo "  Kernel image: $(wc -l < "$WORK_DIR/rv64_flat.mem") words (rv64_flat.mem)"

# 1b. Truncate the FAT image into the ramdisk-bank init file (64-bit LE words).
head -c "$RAMDISK_BYTES" "$FAT_IMG" > "$WORK_DIR/rv64_ramdisk.img"
od -An -v -tx8 -w8 "$WORK_DIR/rv64_ramdisk.img" | awk 'NF{print $1}' > "$WORK_DIR/rv64_ramdisk.mem"
echo "  Ramdisk image: $(wc -l < "$WORK_DIR/rv64_ramdisk.mem") words (rv64_ramdisk.mem)"

# 2. Analyse + elaborate.
printf "  Analysing flat core + testbench ... "
out="$(ghdl -a --std=08 --workdir="$WORK_DIR" \
  "$RTL_DIR/rv64_exec_core_flat.vhd" \
  "$RTL_DIR/tb_rv64_simpleos_boot.vhd" 2>&1)" || true
if echo "$out" | grep -q ":error:"; then
  echo "FAIL"; echo "$out" | tail -40; exit 1
fi
echo "OK"

printf "  Elaborating ... "
out="$(cd "$WORK_DIR" && ghdl -e --std=08 --workdir="$WORK_DIR" tb_rv64_simpleos_boot 2>&1)" || true
if echo "$out" | grep -qi "error"; then
  echo "FAIL"; echo "$out" | tail -40; exit 1
fi
echo "OK"

# 3. Run from WORK_DIR so the core's relative init_mem opens rv64_flat.mem.
STOP_TIME="${STOP_TIME:-400ms}"
printf "  Running simulation (stop-time=%s) ... \n" "$STOP_TIME"
sim="$(cd "$WORK_DIR" && ghdl -r --std=08 --workdir="$WORK_DIR" \
  tb_rv64_simpleos_boot --stop-time="$STOP_TIME" 2>&1)" || true
echo "----- UART transcript -----"
echo "$sim" | grep -E "RV64_UART_LINE:" | sed 's/.*RV64_UART_LINE: //'
echo "---------------------------"
echo "$sim" | grep -E "RV64_BOOT_(DONE|STUCK)" | tail -4
