#!/bin/sh
set -u

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$ROOT_DIR" || exit 1

BUILD_DIR="${BUILD_DIR:-build/check/cpu-backend-artifacts}"
FIXTURE="test/fixtures/compiler/backend_artifact_validation/probe.spl"
FIXTURE_DIR="test/fixtures/compiler/backend_artifact_validation"
REQUESTED_BACKEND=all
REQUIRE_ALL="${CPU_BACKEND_REQUIRE_ALL:-0}"
FAILURES=0
SKIPS=0

usage() {
    echo "usage: $0 [--backend llvm|cranelift|wasm|all] [--require-all]" >&2
    exit 2
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --backend)
            [ "$#" -ge 2 ] || usage
            REQUESTED_BACKEND="$2"
            shift 2
            ;;
        --require-all)
            REQUIRE_ALL=1
            shift
            ;;
        -h|--help) usage ;;
        *) usage ;;
    esac
done

case "$REQUESTED_BACKEND" in
    llvm|cranelift|wasm|all) ;;
    *) usage ;;
esac

mkdir -p "$BUILD_DIR"

record_result() {
    backend="$1"
    stage="$2"
    status="$3"
    reason="$4"
    artifact="${5:-none}"
    echo "backend=$backend step=$stage status=$status reason=$reason artifact=$artifact"
    case "$status" in
        FAIL) FAILURES=$((FAILURES + 1)) ;;
        SKIP_UNAVAILABLE) SKIPS=$((SKIPS + 1)) ;;
    esac
}

find_simple_binary() {
    if [ -n "${SIMPLE_BIN:-}" ]; then
        printf '%s\n' "$SIMPLE_BIN"
        return
    fi
    for candidate in \
        bin/release/x86_64-unknown-linux-gnu/simple \
        release/x86_64-unknown-linux-gnu/simple \
        build/bootstrap/stage4/x86_64-unknown-linux-gnu/simple
    do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return
        fi
    done
}

is_rust_seed() {
    candidate="$1"
    case "$candidate" in
        src/compiler_rust/*|*/src/compiler_rust/*) return 0 ;;
    esac
    if command -v timeout >/dev/null 2>&1; then
        version_output="$(timeout 10 "$candidate" --version 2>&1 || true)"
    else
        version_output="$("$candidate" --version 2>&1 || true)"
    fi
    case "$version_output" in
        *"bootstrap seed only"*|*"Rust-built"*) return 0 ;;
    esac
    return 1
}

has_backend_fallback() {
    log_path="$1"
    grep -Eiq \
        'falling back to (the )?(llvm|cranelift|native|wasm) backend|requested backend.*unavailable.*using|backend fallback selected' \
        "$log_path"
}

has_rejected_contract() {
    log_path="$1"
    grep -Eiq \
        "unknown option|invalid backend|backend '[^']+' is not available|requires --backend" \
        "$log_path"
}

has_backend_identity() {
    log_path="$1"
    backend_name="$2"
    grep -Fq "Backend: $backend_name" "$log_path"
}

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        printf 'unavailable'
    fi
}

validate_elf_object() {
    object_path="$1"
    [ -s "$object_path" ] || return 1
    magic="$(od -An -tx1 -N4 "$object_path" | tr -d ' \n')"
    [ "$magic" = "7f454c46" ] || return 1
    header_path="${object_path}.readelf"
    if command -v llvm-readelf >/dev/null 2>&1; then
        if ! llvm-readelf -h "$object_path" >"$header_path" 2>&1; then
            return 1
        fi
    elif command -v readelf >/dev/null 2>&1; then
        if ! readelf -h "$object_path" >"$header_path" 2>&1; then
            return 1
        fi
    else
        return 2
    fi
    grep -Eq 'Type:[[:space:]]+REL' "$header_path"
}

run_expect_41() {
    executable="$1"
    stdout_path="$2"
    stderr_path="$3"
    if command -v timeout >/dev/null 2>&1; then
        if timeout 30 "$executable" >"$stdout_path" 2>"$stderr_path"; then
            run_code=0
        else
            run_code=$?
        fi
    else
        if "$executable" >"$stdout_path" 2>"$stderr_path"; then
            run_code=0
        else
            run_code=$?
        fi
    fi
    [ "$run_code" -eq 41 ] && [ ! -s "$stdout_path" ] && [ ! -s "$stderr_path" ]
}

skip_backend() {
    backend="$1"
    reason="$2"
    record_result "$backend" "emit backend IR" SKIP_UNAVAILABLE "$reason"
    record_result "$backend" "validate backend IR" SKIP_UNAVAILABLE "$reason"
    record_result "$backend" "emit object" SKIP_UNAVAILABLE "$reason"
    record_result "$backend" "validate object" SKIP_UNAVAILABLE "$reason"
    record_result "$backend" "link artifact" SKIP_UNAVAILABLE "$reason"
    record_result "$backend" "run or read back" SKIP_UNAVAILABLE "$reason"
}

SIMPLE_BIN="$(find_simple_binary)"
if [ -z "$SIMPLE_BIN" ] || [ ! -x "$SIMPLE_BIN" ]; then
    for backend in llvm cranelift wasm; do
        if [ "$REQUESTED_BACKEND" = all ] || [ "$REQUESTED_BACKEND" = "$backend" ]; then
            skip_backend "$backend" simple-binary-unavailable
        fi
    done
elif is_rust_seed "$SIMPLE_BIN"; then
    for backend in llvm cranelift wasm; do
        if [ "$REQUESTED_BACKEND" = all ] || [ "$REQUESTED_BACKEND" = "$backend" ]; then
            skip_backend "$backend" rust-seed-forbidden
        fi
    done
else
    export SIMPLE_BIN

    check_llvm() {
        backend_dir="$BUILD_DIR/llvm"
        cache_dir="$backend_dir/cache"
        executable="$backend_dir/probe"
        log_path="$backend_dir/build.log"
        mkdir -p "$backend_dir" "$cache_dir"

        missing_tools=""
        for tool in llvm-as opt llc; do
            if ! command -v "$tool" >/dev/null 2>&1; then
                missing_tools="${missing_tools}${missing_tools:+,}$tool"
            fi
        done
        if [ -n "$missing_tools" ]; then
            skip_backend llvm "missing-tools-$missing_tools"
            return
        fi

        if SIMPLE_LIB="$ROOT_DIR/src" SIMPLE_NO_STUB_FALLBACK=1 \
            SIMPLE_LLVM_BITCODE_DEBUG=1 SIMPLE_KEEP_LLVM_IR=1 \
            "$SIMPLE_BIN" native-build --backend llvm \
            --verbose \
            --source "$FIXTURE_DIR" --entry-closure --entry "$FIXTURE" \
            --cache-dir "$cache_dir" -o "$executable" >"$log_path" 2>&1; then
            build_code=0
        else
            build_code=$?
        fi
        if [ "$build_code" -ne 0 ]; then
            record_result llvm "emit backend IR" FAIL native-build-failed "$log_path"
            record_result llvm "validate backend IR" FAIL no-ir-to-validate "$log_path"
            record_result llvm "emit object" FAIL native-build-failed "$log_path"
            record_result llvm "validate object" FAIL no-object-to-validate "$log_path"
            record_result llvm "link artifact" FAIL native-build-failed "$log_path"
            record_result llvm "run or read back" FAIL no-executable "$log_path"
            return
        fi
        if has_backend_fallback "$log_path" || has_rejected_contract "$log_path" || \
            ! has_backend_identity "$log_path" llvm; then
            record_result llvm "emit backend IR" FAIL backend-fallback-detected "$log_path"
            record_result llvm "validate backend IR" FAIL backend-lineage-invalid "$log_path"
            record_result llvm "emit object" FAIL backend-lineage-invalid "$log_path"
            record_result llvm "validate object" FAIL backend-lineage-invalid "$log_path"
            record_result llvm "link artifact" FAIL backend-lineage-invalid "$log_path"
            record_result llvm "run or read back" FAIL backend-lineage-invalid "$log_path"
            return
        fi

        source_ll="$(awk '/\[llvm-bitcode-debug\] ir / {path=$3} END {print path}' "$log_path")"
        source_bc="$(awk '/\[llvm-bitcode-debug\] bitcode / {path=$3} END {print path}' "$log_path")"
        retained_ll="$backend_dir/probe.ll"
        retained_bc="$backend_dir/probe.bc"
        if [ -z "$source_ll" ] || [ -z "$source_bc" ] || [ ! -s "$source_ll" ] || [ ! -s "$source_bc" ]; then
            record_result llvm "emit backend IR" FAIL retained-ir-or-bitcode-missing "$log_path"
            record_result llvm "validate backend IR" FAIL retained-ir-or-bitcode-missing "$log_path"
        else
            cp "$source_ll" "$retained_ll"
            cp "$source_bc" "$retained_bc"
            record_result llvm "emit backend IR" PASS \
                "sha256-$(sha256_of "$retained_bc")" "$retained_ll,$retained_bc"
            replay_dir="$backend_dir/replay"
            if sh scripts/check/replay-llvm-artifact.shs "$retained_ll" "$replay_dir" \
                >"$backend_dir/replay.log" 2>&1 && [ -s "$replay_dir/probe.o" ]; then
                record_result llvm "validate backend IR" PASS llvm-as-opt-llc "$replay_dir/probe.o"
            else
                record_result llvm "validate backend IR" FAIL llvm-replay-failed "$backend_dir/replay.log"
            fi
        fi

        cache_object="$(find "$cache_dir" -type f -name '*.o' -print 2>/dev/null | head -1)"
        retained_object="$backend_dir/probe.native.o"
        if [ -n "$cache_object" ] && [ -s "$cache_object" ]; then
            cp "$cache_object" "$retained_object"
            record_result llvm "emit object" PASS explicit-llvm-backend "$retained_object"
            if validate_elf_object "$retained_object"; then
                object_validation_code=0
            else
                object_validation_code=$?
            fi
            case "$object_validation_code" in
                0) record_result llvm "validate object" PASS elf-object-validated "$retained_object" ;;
                2) record_result llvm "validate object" SKIP_UNAVAILABLE missing-readelf "$retained_object" ;;
                *) record_result llvm "validate object" FAIL invalid-object "$retained_object" ;;
            esac
        else
            record_result llvm "emit object" FAIL native-object-missing "$cache_dir"
            record_result llvm "validate object" FAIL native-object-missing "$cache_dir"
        fi

        if [ -s "$executable" ]; then
            record_result llvm "link artifact" PASS explicit-llvm-backend "$executable"
            if run_expect_41 "$executable" "$backend_dir/run.stdout" "$backend_dir/run.stderr"; then
                record_result llvm "run or read back" PASS expected-exit-41 "$executable"
            else
                record_result llvm "run or read back" FAIL unexpected-runtime-result "$backend_dir/run.stderr"
            fi
        else
            record_result llvm "link artifact" FAIL linked-executable-missing "$log_path"
            record_result llvm "run or read back" FAIL linked-executable-missing "$log_path"
        fi
    }

    check_cranelift() {
        backend_dir="$BUILD_DIR/cranelift"
        cache_dir="$backend_dir/cache"
        object_path="$backend_dir/probe.o"
        executable="$backend_dir/probe"
        object_log="$backend_dir/object.log"
        link_log="$backend_dir/link.log"
        mkdir -p "$backend_dir" "$cache_dir"

        record_result cranelift "emit backend IR" SKIP_UNAVAILABLE \
            clif-dump-not-exposed-by-pure-simple "$object_log"
        record_result cranelift "validate backend IR" SKIP_UNAVAILABLE \
            clif-dump-not-exposed-by-pure-simple "$object_log"

        if SIMPLE_LIB="$ROOT_DIR/src" SIMPLE_NO_STUB_FALLBACK=1 \
            "$SIMPLE_BIN" native-build --backend cranelift --emit-object \
            --verbose \
            --source "$FIXTURE_DIR" --entry-closure --entry "$FIXTURE" \
            --cache-dir "$cache_dir" -o "$object_path" >"$object_log" 2>&1; then
            object_code=0
        else
            object_code=$?
        fi
        if [ "$object_code" -ne 0 ] || has_backend_fallback "$object_log" || \
            has_rejected_contract "$object_log" || ! has_backend_identity "$object_log" cranelift; then
            record_result cranelift "emit object" FAIL object-emission-or-lineage-failed "$object_log"
            record_result cranelift "validate object" FAIL object-emission-or-lineage-failed "$object_log"
        else
            record_result cranelift "emit object" PASS explicit-cranelift-backend "$object_path"
            if validate_elf_object "$object_path"; then
                validation_code=0
            else
                validation_code=$?
            fi
            case "$validation_code" in
                0) record_result cranelift "validate object" PASS elf-object-validated "$object_path" ;;
                2) record_result cranelift "validate object" SKIP_UNAVAILABLE missing-readelf "$object_path" ;;
                *) record_result cranelift "validate object" FAIL invalid-object "$object_path" ;;
            esac
        fi

        if SIMPLE_LIB="$ROOT_DIR/src" SIMPLE_NO_STUB_FALLBACK=1 \
            "$SIMPLE_BIN" native-build --backend cranelift \
            --verbose \
            --source "$FIXTURE_DIR" --entry-closure --entry "$FIXTURE" \
            --cache-dir "$cache_dir" -o "$executable" >"$link_log" 2>&1; then
            link_code=0
        else
            link_code=$?
        fi
        if [ "$link_code" -ne 0 ] || [ ! -s "$executable" ] || \
            has_backend_fallback "$link_log" || has_rejected_contract "$link_log" || \
            ! has_backend_identity "$link_log" cranelift; then
            record_result cranelift "link artifact" FAIL link-or-lineage-failed "$link_log"
            record_result cranelift "run or read back" FAIL no-valid-executable "$link_log"
        else
            record_result cranelift "link artifact" PASS explicit-cranelift-backend "$executable"
            if run_expect_41 "$executable" "$backend_dir/run.stdout" "$backend_dir/run.stderr"; then
                record_result cranelift "run or read back" PASS expected-exit-41 "$executable"
            else
                record_result cranelift "run or read back" FAIL unexpected-runtime-result "$backend_dir/run.stderr"
            fi
        fi
    }

    check_wasm() {
        backend_dir="$BUILD_DIR/wasm"
        wasm_path="$backend_dir/probe.wasm"
        wat_path="$backend_dir/probe.wat"
        log_path="$backend_dir/build.log"
        mkdir -p "$backend_dir"

        if SIMPLE_LIB="$ROOT_DIR/src" SIMPLE_NO_STUB_FALLBACK=1 \
            "$SIMPLE_BIN" compile "$FIXTURE" --backend=wasm --target wasm32 -o "$wasm_path" \
            --verbose \
            >"$log_path" 2>&1; then
            build_code=0
        else
            build_code=$?
        fi
        if [ "$build_code" -ne 0 ] || [ ! -s "$wasm_path" ]; then
            record_result wasm "emit backend IR" FAIL wasm-compile-failed "$log_path"
            record_result wasm "validate backend IR" FAIL no-wasm-artifact "$log_path"
            record_result wasm "emit object" FAIL no-wasm-artifact "$log_path"
            record_result wasm "validate object" FAIL no-wasm-artifact "$log_path"
            record_result wasm "link artifact" FAIL no-wasm-artifact "$log_path"
            record_result wasm "run or read back" FAIL no-wasm-artifact "$log_path"
            return
        fi
        if has_backend_fallback "$log_path" || has_rejected_contract "$log_path"; then
            record_result wasm "emit backend IR" FAIL backend-fallback-detected "$log_path"
            record_result wasm "validate backend IR" FAIL backend-lineage-invalid "$log_path"
            record_result wasm "emit object" FAIL backend-lineage-invalid "$log_path"
            record_result wasm "validate object" FAIL backend-lineage-invalid "$log_path"
            record_result wasm "link artifact" FAIL backend-lineage-invalid "$log_path"
            record_result wasm "run or read back" FAIL backend-lineage-invalid "$log_path"
            return
        fi

        magic="$(od -An -tx1 -N4 "$wasm_path" | tr -d ' \n')"
        if [ "$magic" != "0061736d" ]; then
            record_result wasm "emit backend IR" FAIL invalid-wasm-magic "$wasm_path"
            record_result wasm "validate backend IR" FAIL invalid-wasm-magic "$wasm_path"
            record_result wasm "emit object" FAIL invalid-wasm-magic "$wasm_path"
            record_result wasm "validate object" FAIL invalid-wasm-magic "$wasm_path"
            record_result wasm "link artifact" FAIL invalid-wasm-magic "$wasm_path"
            record_result wasm "run or read back" FAIL invalid-wasm-magic "$wasm_path"
            return
        fi

        if command -v wasm2wat >/dev/null 2>&1; then
            if wasm2wat "$wasm_path" -o "$wat_path" >/dev/null 2>&1 && [ -s "$wat_path" ]; then
                record_result wasm "emit backend IR" SKIP_UNAVAILABLE \
                    source-wat-not-exposed-derived-wat-retained "$wat_path"
            else
                record_result wasm "emit backend IR" SKIP_UNAVAILABLE \
                    source-wat-not-exposed-and-wasm2wat-failed "$wasm_path"
            fi
        else
            record_result wasm "emit backend IR" SKIP_UNAVAILABLE \
                source-wat-not-exposed-and-missing-wasm2wat "$wasm_path"
        fi

        record_result wasm "emit object" PASS final-wasm-binary "$wasm_path"

        if command -v wasm-validate >/dev/null 2>&1; then
            if wasm-validate "$wasm_path" >"$backend_dir/validate.log" 2>&1; then
                record_result wasm "validate backend IR" SKIP_UNAVAILABLE \
                    source-wat-not-retained "$wasm_path"
                record_result wasm "validate object" PASS wasm-validate "$wasm_path"
            else
                record_result wasm "validate backend IR" SKIP_UNAVAILABLE \
                    source-wat-not-retained "$wasm_path"
                record_result wasm "validate object" FAIL wasm-validate-failed "$backend_dir/validate.log"
            fi
        elif command -v node >/dev/null 2>&1; then
            if node - "$wasm_path" >"$backend_dir/validate.log" 2>&1 <<'NODE'
const fs = require('fs');
const bytes = fs.readFileSync(process.argv[2]);
new WebAssembly.Module(bytes);
NODE
            then
                record_result wasm "validate backend IR" SKIP_UNAVAILABLE \
                    source-wat-not-retained "$wasm_path"
                record_result wasm "validate object" PASS node-webassembly-module "$wasm_path"
            else
                record_result wasm "validate backend IR" SKIP_UNAVAILABLE \
                    source-wat-not-retained "$wasm_path"
                record_result wasm "validate object" FAIL node-validation-failed "$backend_dir/validate.log"
            fi
        else
            record_result wasm "validate backend IR" SKIP_UNAVAILABLE \
                source-wat-not-retained "$wasm_path"
            record_result wasm "validate object" SKIP_UNAVAILABLE missing-wasm-validator "$wasm_path"
        fi

        record_result wasm "link artifact" PASS final-wasm-module "$wasm_path"
        if command -v node >/dev/null 2>&1; then
            if node - "$wasm_path" >"$backend_dir/run.log" 2>&1 <<'NODE'
const fs = require('fs');
const bytes = fs.readFileSync(process.argv[2]);
const module = new WebAssembly.Module(bytes);
if (WebAssembly.Module.imports(module).length !== 0) process.exit(20);
const instance = new WebAssembly.Instance(module, {});
const names = Object.keys(instance.exports);
const entryName = names.find((name) => name === 'spl_main') ||
  names.find((name) => name === 'main') ||
  names.find((name) => name.endsWith('$main'));
if (!entryName || typeof instance.exports[entryName] !== 'function') process.exit(21);
const value = instance.exports[entryName]();
if (value !== 41 && value !== 41n) process.exit(22);
console.log(`entry=${entryName} value=${value}`);
NODE
            then
                record_result wasm "run or read back" PASS expected-value-41 "$backend_dir/run.log"
            else
                record_result wasm "run or read back" FAIL node-execution-failed "$backend_dir/run.log"
            fi
        else
            record_result wasm "run or read back" SKIP_UNAVAILABLE missing-wasm-runtime "$wasm_path"
        fi
    }

    if [ "$REQUESTED_BACKEND" = all ] || [ "$REQUESTED_BACKEND" = llvm ]; then
        check_llvm
    fi
    if [ "$REQUESTED_BACKEND" = all ] || [ "$REQUESTED_BACKEND" = cranelift ]; then
        check_cranelift
    fi
    if [ "$REQUESTED_BACKEND" = all ] || [ "$REQUESTED_BACKEND" = wasm ]; then
        check_wasm
    fi
fi

if [ "$FAILURES" -gt 0 ]; then
    echo "cpu_backend_matrix status=FAIL failures=$FAILURES skips=$SKIPS require_all=$REQUIRE_ALL"
    exit 1
fi
if [ "$SKIPS" -gt 0 ]; then
    if [ "$REQUIRE_ALL" = 1 ]; then
        echo "cpu_backend_matrix status=FAIL failures=0 skips=$SKIPS require_all=1"
        exit 1
    fi
    echo "cpu_backend_matrix status=SKIP_UNAVAILABLE failures=0 skips=$SKIPS require_all=0"
    exit 0
fi
echo "cpu_backend_matrix status=PASS failures=0 skips=0 require_all=$REQUIRE_ALL"
