#!/bin/sh
# Compatibility entry point for x86_64 SimpleOS WM render and input evidence.
#
# The old implementation built arch/x86_64/wm_entry.spl, a hand-drawn legacy
# demo. That bypasses the production theme snapshot, DesktopShell and Engine2D
# frame executor, so it cannot establish evidence for the canonical glass WM.
#
# Canonical outputs/options: BUILD_DIR (default
# build/simpleos_wm_fullscreen_evidence), REPORT_PATH, SIMPLE_BIN, and
# SIMPLEOS_WM_NATIVE_BUILD_{,WORKER_}TIMEOUT_SECONDS. The retired
# WM_X86_64_READY_TIMEOUT_MS / WM_X86_64_EVENT_TIMEOUT_MS knobs intentionally
# have no meaning here; callers must use the canonical wrapper contract rather
# than expecting recreated legacy receipts.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
CANONICAL_WRAPPER="$ROOT_DIR/scripts/check/check-simpleos-wm-fullscreen-evidence.shs"

if [ ! -x "$CANONICAL_WRAPPER" ]; then
    echo "simpleos_x86_64_wm_render_event_status=fail"
    echo "simpleos_x86_64_wm_render_event_reason=canonical-wrapper-missing:$CANONICAL_WRAPPER"
    exit 1
fi

echo "simpleos_x86_64_wm_render_event_route=canonical-fullscreen-wrapper"
echo "simpleos_x86_64_wm_render_event_entry=examples/09_embedded/simple_os/arch/x86_64/gui_entry_desktop.spl"
exec "$CANONICAL_WRAPPER" "$@"
