#!/bin/sh
set -eu
# Container test harness (U1.1, doc/03_plan/ui/testing/wm_gui_web_system_test_coverage_plan_2026-08-07.md).
#
# TRAP (2026-08-06/07): do NOT docker build with the repo root as build
# context. tools/docker/Dockerfile.test-isolation used to do
# `COPY . /opt/simple`; in this working tree the build context is 235GB+
# (184GB build/, 51GB .git/) -- a COPY-the-repo build ran 10+ minutes at
# high CPU and was killed. Dockerfile.test-isolation is now a deps-only
# image (no COPY at all); the repo is bind-mounted at container-run time
# and the already-built host binary
# (bin/release/x86_64-unknown-linux-gnu/simple, a glibc binary -- ldd shows
# only libm/libgcc_s/libc/ld-linux, all present in ubuntu:24.04) is
# executed directly from the mount.
#
# Mount is READ-WRITE, not :ro: the test runner writes the shared test DB
# under doc/08_tracking/test/ as part of a normal run, so a read-only mount
# makes ordinary runs fail rather than merely restricting scope.
#
# `bin/simple test` defaults to a session daemon that has been observed to
# misbehave across the container boundary (it expects a socket that lives
# on the host). This script instead runs the direct interpreter path with
# --no-session-daemon --sequential, which needs no daemon.
IMG=simple-test-isolation:local
REPO_ROOT=$(cd "$(dirname "$0")/.." && pwd)
DEFAULT_UNIT_TARGET="test/03_system/wm/wm_window_lifecycle_system_spec.spl"

# Build context is tools/docker/ (a few KB), NOT the repo root "." -- the
# docker builder tars the WHOLE build context even when the Dockerfile has
# no COPY, so "." here would still send the multi-hundred-GB repo tree.
docker image inspect "$IMG" >/dev/null 2>&1 || \
  docker build -f "$REPO_ROOT/tools/docker/Dockerfile.test-isolation" -t "$IMG" "$REPO_ROOT/tools/docker"

run_one() { # $1=spec
  OUT=$(docker run --rm -v "$REPO_ROOT:/opt/simple" --tmpfs /tmp:rw,size=512m \
    --memory=2g --cpus=2.0 --cap-drop=ALL -w /opt/simple "$IMG" \
    -c "bin/release/x86_64-unknown-linux-gnu/simple test '$1' --no-session-daemon --sequential" 2>&1) ; RC=$?
  echo "$OUT" | tail -60
  echo "$OUT" | grep -E '^Results: [0-9]+ total' >/dev/null || { echo "ERROR -- no results line"; exit 2; }
  return $RC
}
case "${1:-}" in
  quick) [ -n "${2:-}" ] || { echo "usage: $0 quick path/to/spec.spl"; exit 2; }; run_one "$2" ;;
  unit)  run_one "$DEFAULT_UNIT_TARGET" ;;
  *) echo "usage: $0 unit | quick path/to/spec.spl"; exit 2 ;;
esac
