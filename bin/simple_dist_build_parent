#!/bin/sh
# Run only a hash-admitted native issued-plan controller for this host.
# Installation is a separate verified build/deploy step; source execution is
# never a production fallback for a missing controller binary.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "${script_dir}/.." && pwd)
. "${repo_root}/scripts/lib/host-executable.shs"
# Production admission may never inherit the host resolver's test fixture mode.
unset SIMPLE_HOST_RESOLVER_FIXTURE_MODE

host_family=$(simple_host_family)
case "$(uname -s 2>/dev/null || printf unknown)" in
  OpenBSD*|NetBSD*|DragonFly*|SimpleOS*)
    if [ -z "${SIMPLE_PLATFORM_TRIPLE:-}" ]; then
      echo 'dist-build-parent: explicit platform triple required on this host' >&2
      exit 127
    fi
    ;;
esac
platform_dir=${SIMPLE_PLATFORM_TRIPLE:-$(simple_default_platform_triple)}
case "$platform_dir" in
  ''|*[!A-Za-z0-9._-]*|.*|*..*)
    echo 'dist-build-parent: invalid platform triple' >&2
    exit 127
    ;;
esac
suffix=$(simple_exe_suffix "$host_family")
native="${script_dir}/release/${platform_dir}/simple_dist_build_issued_parent${suffix}"
sidecar="${native}.sha256"
if ! simple_host_executable_compatible "$native" "$host_family" ||
   [ -L "$native" ] || [ ! -f "$sidecar" ] || [ -L "$sidecar" ]; then
  echo "dist-build-parent: no admitted native controller for ${platform_dir}" >&2
  exit 127
fi

expected=$(sed -n '1p' "$sidecar")
case "$expected" in
  *[!0-9a-f]*|'')
    echo 'dist-build-parent: invalid controller digest sidecar' >&2
    exit 127
    ;;
esac
if [ "${#expected}" -ne 64 ]; then
  echo 'dist-build-parent: invalid controller digest sidecar' >&2
  exit 127
fi
if command -v sha256sum >/dev/null 2>&1; then
  observed=$(sha256sum "$native") || exit 127
  observed=${observed%% *}
elif command -v shasum >/dev/null 2>&1; then
  observed=$(shasum -a 256 "$native") || exit 127
  observed=${observed%% *}
elif command -v sha256 >/dev/null 2>&1; then
  observed=$(sha256 -q "$native") || exit 127
else
  echo 'dist-build-parent: SHA-256 tool unavailable' >&2
  exit 127
fi
if [ "$observed" != "$expected" ]; then
  echo 'dist-build-parent: controller digest mismatch' >&2
  exit 127
fi
exec "$(simple_native_exec_path "$native" "$host_family")" "$@"
