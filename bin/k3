#!/bin/sh
# Launch Claude Code through Kimi's Anthropic-compatible K3 endpoint.
set -eu

token=${MOONSHOT_API_KEY:-}
if [ -z "${token}" ] && [ -r "${HOME}/.config/kimi/token" ]; then
    token=$(sed -n '1p' "${HOME}/.config/kimi/token")
fi
if [ -z "${token}" ]; then
    printf '%s\n' \
        'error: set MOONSHOT_API_KEY or create ~/.config/kimi/token (mode 600)' >&2
    exit 78
fi

export ANTHROPIC_BASE_URL="https://api.moonshot.ai/anthropic"
export ANTHROPIC_AUTH_TOKEN="${token}"
export ANTHROPIC_MODEL="kimi-k3[1m]"
export ANTHROPIC_DEFAULT_OPUS_MODEL="kimi-k3[1m]"
export ANTHROPIC_DEFAULT_SONNET_MODEL="kimi-k3[1m]"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="kimi-k3[1m]"
export ANTHROPIC_DEFAULT_FABLE_MODEL="kimi-k3[1m]"
export CLAUDE_CODE_SUBAGENT_MODEL="kimi-k3[1m]"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="1048576"
export CLAUDE_CODE_EFFORT_LEVEL="max"

exec claude "$@"
