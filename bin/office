#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)

# Office is a separately compiled application. Launch never interprets source
# and never bootstraps the compiler; producing/updating the cached artifact is
# a build or release operation.
native=""
if [ -n "${SIMPLE_OFFICE_NATIVE:-}" ]; then
  if [ ! -x "${SIMPLE_OFFICE_NATIVE}" ]; then
    printf '%s\n' \
      "error: SIMPLE_OFFICE_NATIVE is not executable: ${SIMPLE_OFFICE_NATIVE}" >&2
    exit 127
  fi
  native="${SIMPLE_OFFICE_NATIVE}"
else
  for candidate in \
    "${REPO_ROOT}/build/bootstrap/office-package/office" \
    "${SCRIPT_DIR}/release/aarch64-apple-darwin/office" \
    "${SCRIPT_DIR}/release/aarch64-apple-darwin-macho/office" \
    "${SCRIPT_DIR}/release/x86_64-apple-darwin/office" \
    "${SCRIPT_DIR}/release/x86_64-apple-darwin-macho/office" \
    "${SCRIPT_DIR}/release/x86_64-unknown-linux-gnu/office" \
    "${SCRIPT_DIR}/release/linux-x86_64/office"
  do
    if [ -x "${candidate}" ]; then
      native="${candidate}"
      break
    fi
  done
fi

if [ -n "${native}" ]; then
  exec "${native}" "$@"
fi

{
  printf '%s\n' "error: cached native Office artifact not found"
  printf '%s\n' "checked:"
  printf '%s\n' "  SIMPLE_OFFICE_NATIVE"
  printf '%s\n' "  ${REPO_ROOT}/build/bootstrap/office-package/office"
  printf '%s\n' "  ${SCRIPT_DIR}/release/<target>/office"
  printf '%s\n' \
    "hint: native-build src/app/office_cli/main.spl to build/bootstrap/office-package/office"
} >&2
exit 127
