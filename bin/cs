#!/bin/sh
# cs — caret suite. Interactive dashboard over the multi-agent caret session:
# overall status, agent roster, selected-agent detail, and a command/chat input
# line at the bottom. Launches and manages agents through the agent manager.
# Usage: cs [tmux-session]   (default: caret)
#
# ponytail: reuses bin/caret's runtime probe via CARET_ENTRY rather than
# duplicating it. Upgrade to its own probe only if the entries diverge.
set -eu
CARET_ENTRY=src/app/llm_caret/cs_main.spl
export CARET_ENTRY
exec "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/caret" "$@"
