#!/bin/sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)
runtime=""
runtime_usable() {
  candidate="$1"
  [ -n "${candidate}" ] || return 1
  [ -x "${candidate}" ] || return 1
  # A bootstrap compiler can answer --version while rejecting the `run`
  # command that this wrapper needs. Require the deployed CLI's test command
  # in its help surface so an identity-only bootstrap cannot be selected.
  "${candidate}" --help 2>&1 | grep -q 'simple test' || return 1
}

for candidate in \
  "${SIMPLE_BINARY:-}" \
  "${REPO_ROOT}/bin/simple" \
  "${REPO_ROOT}/bin/release/simple" \
  "${REPO_ROOT}/bin/release/aarch64-apple-darwin/simple" \
  "${REPO_ROOT}/bin/release/aarch64-apple-darwin-macho/simple" \
  "${REPO_ROOT}/bin/release/macos-arm64/simple" \
  "${REPO_ROOT}/bin/release/x86_64-unknown-linux-gnu/simple" \
  "${REPO_ROOT}/bin/release/linux-x86_64/simple"
do
  if runtime_usable "${candidate}"; then
    runtime="${candidate}"
    break
  fi
done
if [ -z "${runtime}" ]; then
  {
    printf '%s\n' "error: no Simple runtime found for devhub"
    printf '%s\n' "checked:"
    printf '%s\n' "  SIMPLE_BINARY"
    printf '%s\n' "  ${REPO_ROOT}/bin/simple"
    printf '%s\n' "  ${REPO_ROOT}/bin/release/simple"
    printf '%s\n' "  ${REPO_ROOT}/bin/release/x86_64-unknown-linux-gnu/simple"
    printf '%s\n' "  ${REPO_ROOT}/bin/release/linux-x86_64/simple"
  } >&2
  exit 127
fi

# Source-hosted launches can emit compiler migration diagnostics before DevHub
# writes its own output. Keep successful operator output clean by default;
# --verbose restores the complete stream. A failed launch always replays the
# captured diagnostics so quiet mode can never hide the cause.
show_diagnostics=0
for arg in "$@"
do
  case "${arg}" in
    --verbose) show_diagnostics=1 ;;
    --quiet) show_diagnostics=0 ;;
  esac
done

if [ "${show_diagnostics}" -eq 1 ]; then
  exec env SIMPLE_RUST_SEED_WARNING=0 "${runtime}" run "${REPO_ROOT}/src/app/devhub/main.spl" "$@"
fi

diagnostic_file=$(mktemp "${TMPDIR:-/tmp}/devhub-diagnostics.XXXXXX")
cleanup_diagnostics() {
  rm -f "${diagnostic_file}"
}
trap cleanup_diagnostics EXIT HUP INT TERM
set +e
env SIMPLE_RUST_SEED_WARNING=0 "${runtime}" run "${REPO_ROOT}/src/app/devhub/main.spl" "$@" 2>"${diagnostic_file}"
status=$?
set -e
if [ "${status}" -ne 0 ]; then
  cat "${diagnostic_file}" >&2
fi
exit "${status}"
