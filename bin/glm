#!/bin/sh
# Launch Claude Code through Z.AI with a flagship main model and cheap fast lane.
set -eu

token=${ZAI_API_KEY:-}
if [ -z "${token}" ] && [ -r "${HOME}/.config/zai/token" ]; then
    token=$(sed -n '1p' "${HOME}/.config/zai/token")
fi
if [ -z "${token}" ]; then
    printf '%s\n' \
        'error: set ZAI_API_KEY or create ~/.config/zai/token (mode 600)' >&2
    exit 78
fi

export ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic"
export ANTHROPIC_AUTH_TOKEN="${token}"
export ANTHROPIC_MODEL="glm-5.2"
export ANTHROPIC_DEFAULT_OPUS_MODEL="glm-5.2"
export ANTHROPIC_DEFAULT_SONNET_MODEL="glm-5.2"
export ANTHROPIC_DEFAULT_FABLE_MODEL="glm-5.2"
export CLAUDE_CODE_SUBAGENT_MODEL="glm-5.2"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="glm-4.5-air"
export ANTHROPIC_SMALL_FAST_MODEL="glm-4.5-air"

exec claude "$@"
