#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
runtime="$script_dir/x86_64-unknown-linux-gnu/simple"
if [ ! -x "$runtime" ]; then
  repo_root="$(cd "$script_dir/../.." && pwd)"
  runtime="$repo_root/release/x86_64-unknown-linux-gnu/simple"
fi
chmod +x "$runtime" 2>/dev/null || true

# Fork-bomb guard (2026-07-24, doc/08_tracking/bug/cli_compile_delegation_fork_bomb_wrapper_2026-07-24.md):
# the full CLI's external-compile path (driver_public_compile.spl
# aot_vhdl_file -> _run_compile_to_path -> find_simple_binary) resolves THIS
# wrapper as the "external" compiler and spawns it recursively with no loop
# guard — an unbounded self-delegation chain (observed ~35k processes, took
# down a Vivado impl run via fork/RAM exhaustion). Every hop passes through
# this wrapper, so a depth flag here terminates the chain. Re-entry must fail
# closed: silently substituting the bootstrap seed makes deployed-runtime and
# architecture acceptance evidence dishonest.
if [ -n "${SIMPLE_WRAPPER_REENTERED:-}" ]; then
  echo "error: recursive deployed Simple delegation refused; no seed fallback" >&2
  exit 1
fi
export SIMPLE_WRAPPER_REENTERED=1

timeout_bin="$(command -v timeout || command -v gtimeout || true)"
if [ -z "$timeout_bin" ]; then
  echo "error: timeout or gtimeout is required to validate the deployed Simple runtime" >&2
  exit 1
fi
if ! runtime_id="$("$timeout_bin" 5 "$runtime" --version 2>&1)"; then
  echo "error: deployed Simple runtime failed its bounded identity probe: $runtime" >&2
  exit 1
fi
if [ -z "$runtime_id" ]; then
  echo "error: deployed Simple runtime returned an empty identity: $runtime" >&2
  exit 1
fi
case "$runtime_id" in
  *"bootstrap seed only"*|*"Rust-built"*|*"debug build"*)
    echo "error: refusing non-production Simple runtime: $runtime" >&2
    exit 1
    ;;
esac
abi_status=0
{ "$timeout_bin" 10 "$runtime" test --help >/dev/null 2>&1; } 2>/dev/null ||
  abi_status=$?
if [ "$abi_status" -eq 124 ] || [ "$abi_status" -ge 128 ]; then
  echo "error: deployed Simple runtime failed its bounded test ABI probe: $runtime" >&2
  exit 1
fi

exec "$runtime" "$@"
