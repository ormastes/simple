#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)

# Production always launches a cached native Caret executable. Source execution
# is an explicit debugging escape hatch so a missing deployment cannot be
# mistaken for a working standalone command.
metal_gui=0
for caret_arg in "$@"; do
  if [ "${caret_arg}" = "--metal-gui" ]; then
    metal_gui=1
    break
  fi
done

if [ "${metal_gui}" -eq 1 ]; then
  metal_native=""
  if [ -n "${SIMPLE_CARET_METAL_NATIVE:-}" ]; then
    if [ ! -x "${SIMPLE_CARET_METAL_NATIVE}" ]; then
      printf '%s\n' \
        "error: SIMPLE_CARET_METAL_NATIVE is not executable: ${SIMPLE_CARET_METAL_NATIVE}" >&2
      exit 127
    fi
    metal_native="${SIMPLE_CARET_METAL_NATIVE}"
  else
    for candidate in \
      "${REPO_ROOT}/build/bootstrap/caret-package/caret_metal" \
      "${SCRIPT_DIR}/release/aarch64-apple-darwin/caret_metal" \
      "${SCRIPT_DIR}/release/aarch64-apple-darwin-macho/caret_metal" \
      "${SCRIPT_DIR}/release/x86_64-apple-darwin/caret_metal"
    do
      if [ -x "${candidate}" ]; then
        metal_native="${candidate}"
        break
      fi
    done
  fi
  if [ -z "${metal_native}" ]; then
    printf '%s\n' "error: cached native Caret Metal companion not found" >&2
    printf '%s\n' "hint: native-build src/app/llm_caret/gui_metal.spl to build/bootstrap/caret-package/caret_metal" >&2
    exit 127
  fi
  SIMPLE_CARET_REPO_ROOT="${REPO_ROOT}"
  export SIMPLE_CARET_REPO_ROOT
  exec "${metal_native}" "$@"
fi

native=""
if [ -n "${SIMPLE_CARET_NATIVE:-}" ]; then
  if [ ! -x "${SIMPLE_CARET_NATIVE}" ]; then
    printf '%s\n' \
      "error: SIMPLE_CARET_NATIVE is not executable: ${SIMPLE_CARET_NATIVE}" >&2
    exit 127
  fi
  native="${SIMPLE_CARET_NATIVE}"
else
  for candidate in \
    "${REPO_ROOT}/build/bootstrap/caret-package/caret" \
    "${SCRIPT_DIR}/release/aarch64-apple-darwin/caret" \
    "${SCRIPT_DIR}/release/aarch64-apple-darwin-macho/caret" \
    "${SCRIPT_DIR}/release/x86_64-apple-darwin/caret" \
    "${SCRIPT_DIR}/release/x86_64-apple-darwin-macho/caret" \
    "${SCRIPT_DIR}/release/x86_64-unknown-linux-gnu/caret" \
    "${SCRIPT_DIR}/release/linux-x86_64/caret" \
    "${REPO_ROOT}/build/bootstrap/full/aarch64-apple-darwin/caret" \
    "${REPO_ROOT}/build/bootstrap/full/x86_64-apple-darwin/caret" \
    "${REPO_ROOT}/build/bootstrap/full/x86_64-unknown-linux-gnu/caret"
  do
    if [ -x "${candidate}" ]; then
      native="${candidate}"
      break
    fi
  done
fi

if [ -n "${native}" ]; then
  SIMPLE_CARET_REPO_ROOT="${REPO_ROOT}"
  export SIMPLE_CARET_REPO_ROOT
  exec "${native}" "$@"
fi

if [ "${SIMPLE_CARET_ALLOW_SOURCE_FALLBACK:-0}" != "1" ]; then
  {
    printf '%s\n' "error: cached native Caret artifact not found"
    printf '%s\n' "checked:"
    printf '%s\n' "  SIMPLE_CARET_NATIVE"
    printf '%s\n' "  ${REPO_ROOT}/build/bootstrap/caret-package/caret"
    printf '%s\n' "  ${SCRIPT_DIR}/release/<target>/caret"
    printf '%s\n' "  ${REPO_ROOT}/build/bootstrap/full/<target>/caret"
    printf '%s\n' \
      "source fallback disabled; set SIMPLE_CARET_ALLOW_SOURCE_FALLBACK=1 only for debugging"
    printf '%s\n' \
      "hint: native-build src/app/llm_caret/main.spl to build/bootstrap/caret-package/caret"
  } >&2
  exit 127
fi

runtime=""
for candidate in \
  "${SIMPLE_BINARY:-}" \
  "${REPO_ROOT}/bin/simple" \
  "${REPO_ROOT}/bin/release/simple" \
  "${REPO_ROOT}/bin/release/aarch64-apple-darwin/simple" \
  "${REPO_ROOT}/bin/release/aarch64-apple-darwin-macho/simple" \
  "${REPO_ROOT}/bin/release/x86_64-apple-darwin/simple" \
  "${REPO_ROOT}/bin/release/x86_64-unknown-linux-gnu/simple" \
  "${REPO_ROOT}/bin/release/linux-x86_64/simple"
do
  if [ -n "${candidate}" ] && [ -x "${candidate}" ]; then
    runtime="${candidate}"
    break
  fi
done
if [ -z "${runtime}" ]; then
  printf '%s\n' "error: source fallback requested but no Simple runtime found" >&2
  exit 127
fi
SIMPLE_CARET_REPO_ROOT="${REPO_ROOT}"
export SIMPLE_CARET_REPO_ROOT
exec "${runtime}" run "${REPO_ROOT}/${CARET_ENTRY:-src/app/llm_caret/main.spl}" "$@"
