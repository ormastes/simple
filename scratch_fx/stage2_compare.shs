#!/bin/sh
# Compile each reduced fixture with the STAGE-2 binary and diff its output
# against the interpreter's. This is the c018ee15926 comparison harness: the
# stage-2 binary is the compiler suspected of miscompiling, and it exposes only
# `compile` and `native-build` (bootstrap CLI, src/app/cli/bootstrap_main.spl).
# Never probe it for `run`/`test` — that is a category error.
#
# Exit statuses are read DIRECTLY into a variable on the line after the command.
set -u
ROOT=/mnt/data/worktrees/lane-stage2-miscompile
S2="${1:-}"
if [ -z "$S2" ] || [ ! -x "$S2" ]; then
    echo "usage: stage2_compare.shs /path/to/stage2/simple"
    echo "ERROR — nothing was checked (no stage2 binary)"
    exit 2
fi
cd "$ROOT" || exit 2
export SIMPLE_TIMEOUT_SECONDS=0
OUTD="$ROOT/scratch_fx/s2out"
mkdir -p "$OUTD"

CHECKED=0
DIVERGED=0
NAMES=""

for fx in ifexpr tupret interp5 chainfield; do
    SRC="$ROOT/scratch_fx/$fx.spl"
    [ -f "$SRC" ] || continue

    # interpreter reference (seed `run`)
    timeout 600 "$ROOT/bin/simple" run "$SRC" > "$OUTD/$fx.interp.raw" 2>&1
    RC_I=$?
    grep -v "^WARNING\|^Build and use\|engine-demotion\|^\[INFO\]" \
        "$OUTD/$fx.interp.raw" > "$OUTD/$fx.interp.txt"

    # stage-2 compiled
    timeout 1800 "$S2" native-build "$SRC" --backend=cranelift \
        -o "$OUTD/$fx.s2bin" > "$OUTD/$fx.build.log" 2>&1
    RC_B=$?
    if [ "$RC_B" -ne 0 ]; then
        echo "$fx: stage2 native-build FAILED rc=$RC_B (see $OUTD/$fx.build.log)"
        DIVERGED=$((DIVERGED + 1))
        NAMES="$NAMES $fx(build-rc=$RC_B)"
        CHECKED=$((CHECKED + 1))
        continue
    fi

    "$OUTD/$fx.s2bin" > "$OUTD/$fx.s2.raw" 2>&1
    RC_R=$?

    # Normalise: native `print` omits newlines, interpreter emits them.
    # Compare the newline-stripped streams so only VALUE differences count.
    tr -d '\n' < "$OUTD/$fx.interp.txt" > "$OUTD/$fx.interp.norm"
    tr -d '\n' < "$OUTD/$fx.s2.raw"     > "$OUTD/$fx.s2.norm"

    CHECKED=$((CHECKED + 1))
    if cmp -s "$OUTD/$fx.interp.norm" "$OUTD/$fx.s2.norm"; then
        echo "$fx: MATCH (interp rc=$RC_I, stage2 run rc=$RC_R)"
    else
        echo "$fx: DIVERGED (interp rc=$RC_I, stage2 run rc=$RC_R)"
        echo "  interp: $(cat "$OUTD/$fx.interp.norm")"
        echo "  stage2: $(cat "$OUTD/$fx.s2.norm")"
        DIVERGED=$((DIVERGED + 1))
        NAMES="$NAMES $fx"
    fi
done

if [ "$CHECKED" -eq 0 ]; then
    echo "ERROR — nothing was checked"
    exit 2
fi
if [ "$DIVERGED" -ne 0 ]; then
    echo "FAIL — $CHECKED fixture(s) checked, $DIVERGED diverged:$NAMES"
    exit 1
fi
echo "PASS — $CHECKED fixture(s) checked, 0 diverged"
exit 0
