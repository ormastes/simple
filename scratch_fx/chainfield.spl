# Fixture: the `visit` log line's real shape — interpolation over CHAINED
# field-of-field owners (`self.ctx.source_module_names_owner.len()`), plus a
# nested-struct `.surfaces.len()`, evaluated inside a method on `self`.
#
#   log_phase("phase3:streaming:visit order={hir_visit_order.len()}
#              surfaces={surfaces.surfaces.len()}
#              names={self.ctx.source_module_names_owner.len()}
#              paths={self.ctx.source_paths_owner.len()}
#              contents={self.ctx.source_contents_owner.len()}")

class Surfaces:
    var surfaces: [i64] = []

class Ctx:
    var source_module_names_owner: [text] = []
    var source_paths_owner: [text] = []
    var source_contents_owner: [text] = []

class Driver:
    var ctx: Ctx = Ctx()

    me emit(order: [i64], s: Surfaces):
        print "V:before"
        print "visit order={order.len()} surfaces={s.surfaces.len()} names={self.ctx.source_module_names_owner.len()} paths={self.ctx.source_paths_owner.len()} contents={self.ctx.source_contents_owner.len()}"
        print "V:after"

fn main():
    var d = Driver()
    d.ctx.source_paths_owner.push("a")
    d.ctx.source_paths_owner.push("b")
    var s = Surfaces()
    s.surfaces.push(1)
    var order: [i64] = []
    print "M:before-call"
    d.emit(order, s)
    print "M:after-call"
    print "FIXTURE:end"
