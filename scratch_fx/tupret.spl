# Fixture: guard that fires `add_error` then `return (self.ctx, false)`,
# the exact shape of every early return in
# driver_hir_pipeline_lowering.spl::lower_and_check_streaming_surfaces_impl.
#
# Hypothesis under test (the surviving alternative to a skipped statement):
# a guard DID fire, but `add_error` silently no-oped AND the tuple's bool slot
# was read back as true. That combination reproduces the reported evidence
# (entry printed, visit absent, zero errors, verdict true) with no vanishing
# statement at all.
#
# All reporting is done by printing pre-bound locals; no method calls inside
# string interpolation (that hits the unresolved-method trap in small builds).

class Ctx:
    var count: i64 = 0

    me add_error(m: text):
        self.count = self.count + 1
        print "  add_error called"

class Runner:
    var ctx: Ctx = Ctx()

    me run(trip: bool) -> (Ctx, bool):
        print "R:entry"
        if trip:
            self.ctx.add_error("tripped")
            return (self.ctx, false)
        print "R:past-guard"
        return (self.ctx, true)

    me run_unsafe(ok: bool) -> (Ctx, bool):
        print "U:entry"
        unsafe(capabilities: [ffi]):
            if not ok:
                self.ctx.add_error("malformed")
                return (self.ctx, false)
        print "U:past-unsafe"
        return (self.ctx, true)

fn report(tag: text, verdict: bool, count: i64):
    print "{tag} verdict={verdict} errors={count}"

fn main():
    var a = Runner()
    val ra = a.run(true)
    val ca: Ctx = ra.0
    val va: bool = ra.1
    val na: i64 = ca.count
    report("A:trip", va, na)

    var b = Runner()
    val rb = b.run(false)
    val cb: Ctx = rb.0
    val vb: bool = rb.1
    val nb: i64 = cb.count
    report("A:notrip", vb, nb)

    var c = Runner()
    val rc = c.run_unsafe(false)
    val cc: Ctx = rc.0
    val vc: bool = rc.1
    val nc: i64 = cc.count
    report("D:bad", vc, nc)

    var d = Runner()
    val rd = d.run_unsafe(true)
    val cd: Ctx = rd.0
    val vd: bool = rd.1
    val nd: i64 = cd.count
    report("D:good", vd, nd)

    print "FIXTURE:end"
