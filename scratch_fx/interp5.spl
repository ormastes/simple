# Fixture: a single log message with FIVE interpolated .len() calls, the exact
# shape of the `phase3:streaming:visit` line that never printed:
#
#   log_phase("phase3:streaming:visit order={a.len()} surfaces={b.len()} \
#              names={c.len()} paths={d.len()} contents={e.len()}")
#
# If a many-slot interpolated message can be dropped or truncated, the "visit
# probe never printed" evidence has an explanation that requires no vanishing
# statement. The r01..r12 literal-only receipts in the instrumented driver
# discriminate this directly; this fixture tests it standalone.

class Owner:
    var xs: [i64] = []

    me count() -> i64:
        return self.xs.len()

fn emit(msg: text):
    print msg

fn main():
    var a = Owner()
    var b = Owner()
    var c = Owner()
    var d = Owner()
    var e = Owner()
    b.xs.push(1)
    b.xs.push(2)
    d.xs.push(9)

    val na: i64 = a.count()
    val nb: i64 = b.count()
    val nc: i64 = c.count()
    val nd: i64 = d.count()
    val ne: i64 = e.count()

    print "P1:literal-receipt"
    emit("visit order={na} surfaces={nb} names={nc} paths={nd} contents={ne}")
    print "P2:literal-receipt"
    print "inline order={na} surfaces={nb} names={nc} paths={nd} contents={ne}"
    print "P3:literal-receipt"
    print "FIXTURE:end"
