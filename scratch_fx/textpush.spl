# MINIMAL reproducer: a `text` value pushed into a class-field array through a
# method parameter comes back CORRUPTED under native codegen.
#
# interpreter: BOOM-0
# native:      RTS
#
# Isolates which step corrupts it: the push, the parameter pass, or the read.

class Box:
    var items: [text] = []

    me add_via_param(m: text):
        self.items.push(m)

    me add_literal():
        self.items.push("LIT-0")

fn main():
    # 1. plain local array, literal push
    var local: [text] = []
    local.push("BOOM-0")
    print "1 local[0]={local[0]}"

    # 2. class field, push of a literal from inside a method
    var b1 = Box()
    b1.add_literal()
    print "2 field-literal[0]={b1.items[0]}"

    # 3. class field, push of a METHOD PARAMETER (the failing shape)
    var b2 = Box()
    b2.add_via_param("BOOM-0")
    print "3 field-param[0]={b2.items[0]}"

    # 4. same, read via iteration instead of index
    for e in b2.items:
        print "4 field-param-iter={e}"

    # 5. class field, push from OUTSIDE the class (no method involved)
    var b3 = Box()
    b3.items.push("OUT-0")
    print "5 field-direct[0]={b3.items[0]}"

    # 6. parameter passed through, but printed without storing
    var b4 = Box()
    b4.add_via_param("KEEP-6")
    print "6 len={b4.items.len()}"
    print "6 field-param[0]={b4.items[0]}"

    print "FIXTURE:end"
