# Reproducer candidate for the Stage-2 control-flow miscompilation.
#
# Exact nesting of the guard at
# src/compiler/80.driver/driver_hir_pipeline_lowering.spl:579-584:
#
#     if self.ctx.module_surfaces != nil:            # outer if
#         unsafe(capabilities: [ffi]):               # unsafe block
#             if not rt_heap_ref_wellformed(...):    # inner if
#                 self.ctx.add_error(...)
#                 return (self.ctx, false)           # <-- does not fire
#
# Observed in the failing compile: the add_error DID run (its message is
# printed) and the method then FELL THROUGH to the following statement, which
# dereferenced the malformed payload and SEGV'd. So the return nested three
# levels deep (if / unsafe / if) is not taken.
#
# `case_d` in the earlier fixture tested only `unsafe:` + `if:` + return (two
# levels) and was CORRECT, so the outer `if` is the added ingredient.

class Ctx:
    var count: i64 = 0

    me add_error(m: text):
        self.count = self.count + 1
        print "  add_error: {m}"

class Driver:
    var ctx: Ctx = Ctx()
    var present: bool = true

    # Three levels: outer if -> unsafe -> inner if -> return
    me guard3(bad: bool) -> (Ctx, bool):
        print "G3:entry"
        if self.present:
            unsafe(capabilities: [ffi]):
                if bad:
                    self.ctx.add_error("G3 malformed")
                    return (self.ctx, false)
        print "G3:FELL-THROUGH"
        return (self.ctx, true)

    # Control: two levels, unsafe -> if -> return (known correct)
    me guard2(bad: bool) -> (Ctx, bool):
        print "G2:entry"
        unsafe(capabilities: [ffi]):
            if bad:
                self.ctx.add_error("G2 malformed")
                return (self.ctx, false)
        print "G2:FELL-THROUGH"
        return (self.ctx, true)

    # Control: three levels WITHOUT unsafe, if -> if -> return
    me guard3_nounsafe(bad: bool) -> (Ctx, bool):
        print "N3:entry"
        if self.present:
            if bad:
                self.ctx.add_error("N3 malformed")
                return (self.ctx, false)
        print "N3:FELL-THROUGH"
        return (self.ctx, true)

fn check(tag: text, verdict: bool, count: i64):
    print "{tag} verdict={verdict} errors={count}"

fn main():
    var a = Driver()
    val ra = a.guard3(true)
    val ca: Ctx = ra.0
    val va: bool = ra.1
    val na: i64 = ca.count
    check("G3:bad", va, na)

    var b = Driver()
    val rb = b.guard2(true)
    val cb: Ctx = rb.0
    val vb: bool = rb.1
    val nb: i64 = cb.count
    check("G2:bad", vb, nb)

    var c = Driver()
    val rc = c.guard3_nounsafe(true)
    val cc: Ctx = rc.0
    val vc: bool = rc.1
    val nc: i64 = cc.count
    check("N3:bad", vc, nc)

    print "FIXTURE:end"
