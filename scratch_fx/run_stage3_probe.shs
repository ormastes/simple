#!/bin/sh
# Stage2 -> receipt -> full run, for the phase-3 receipt bisect.
# Every exit status is read DIRECTLY into a variable on the line AFTER the
# command, never through a pipe (repo evidence rule).
set -u
ROOT=/mnt/data/worktrees/lane-stage2-miscompile
OUT="$ROOT/build/bootstrap/probe1"
LOGD="$ROOT/scratch_fx/logs"
mkdir -p "$LOGD"
cd "$ROOT" || exit 2
export SIMPLE_TIMEOUT_SECONDS=0
export SIMPLE_COMPILER_PHASE_PROFILE=1

BFS=scripts/bootstrap/bootstrap-from-scratch.sh

echo "=== STEP1 stage2 ==="
sh "$BFS" --strategy=adhoc --full-bootstrap --stop-after-stage2 \
    --backend=cranelift --mode=dynload --jobs=full --output="$OUT" \
    > "$LOGD/step1.log" 2>&1
STEP1_RC=$?
echo "STEP1_RC=$STEP1_RC"
if [ "$STEP1_RC" -ne 0 ]; then
    echo "STEP1 failed; tail:"
    tail -30 "$LOGD/step1.log"
    exit 1
fi

STAGE2BIN="$OUT/stage2/simple"
[ -x "$STAGE2BIN" ] || STAGE2BIN=$(find "$OUT" -name simple -type f -perm -u+x 2>/dev/null | head -1)
echo "STAGE2BIN=$STAGE2BIN"

echo "=== STEP2 mint receipt ==="
sh "$BFS" planner-admission-v2 --target=//bootstrap:stage4 \
    --reason=self-host-convergence-check --parent-compiler="$STAGE2BIN" \
    --bootstrap-output="$OUT" --out="$ROOT/scratch_fx/stage4-admission.env" \
    > "$LOGD/step2.log" 2>&1
STEP2_RC=$?
echo "STEP2_RC=$STEP2_RC"
tail -5 "$LOGD/step2.log"

echo "=== STEP3 full run (stage 3) ==="
sh "$BFS" --strategy=adhoc --full-bootstrap --backend=cranelift \
    --mode=dynload --jobs=full --output="$OUT" \
    --bootstrap-receipt="$ROOT/scratch_fx/stage4-admission.env" \
    > "$LOGD/step3.log" 2>&1
STEP3_RC=$?
echo "STEP3_RC=$STEP3_RC"
echo "=== phase3 receipts seen ==="
grep -h "phase3:streaming:" "$OUT"/logs/*/stage3-native-build.log "$LOGD/step3.log" 2>/dev/null | sed 's/.*phase3:streaming:/phase3:streaming:/' | sort -u
echo "=== done ==="
