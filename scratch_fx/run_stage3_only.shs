#!/bin/sh
# Stage 3 only, with the phase-receipt gate ENABLED. Stage 2 is already
# admitted in build/bootstrap/probe1.
#
# SIMPLE_COMPILER_PHASE_PROFILE=1 is mandatory: log_phase is gated behind
# driver_phase_trace_enabled() (driver_log_helpers.spl:25-26). Without it every
# receipt is silent and "no receipts" would look like evidence.
#
# Exit statuses are read DIRECTLY into a variable on the line AFTER the command.
set -u
ROOT=/mnt/data/worktrees/lane-stage2-miscompile
OUT="$ROOT/build/bootstrap/probe1"
LOGD="$ROOT/scratch_fx/logs"
mkdir -p "$LOGD"
cd "$ROOT" || exit 2
export SIMPLE_TIMEOUT_SECONDS=0
export SIMPLE_COMPILER_PHASE_PROFILE=1

BFS=scripts/bootstrap/bootstrap-from-scratch.sh
S2="$OUT/stage2/x86_64-unknown-linux-gnu/simple"
echo "S2=$S2"
ls -la "$S2"

echo "=== STEP2 mint receipt ==="
sh "$BFS" planner-admission-v2 --target=//bootstrap:stage4 \
    --reason=self-host-convergence-check --parent-compiler="$S2" \
    --bootstrap-output="$OUT" --out="$ROOT/scratch_fx/stage4-admission.env" \
    > "$LOGD/step2.log" 2>&1
STEP2_RC=$?
echo "STEP2_RC=$STEP2_RC"
tail -6 "$LOGD/step2.log"

echo "=== STEP3 full run (stage 3) ==="
sh "$BFS" --strategy=adhoc --full-bootstrap --backend=cranelift \
    --mode=dynload --jobs=full --output="$OUT" \
    --bootstrap-receipt="$ROOT/scratch_fx/stage4-admission.env" \
    > "$LOGD/step3.log" 2>&1
STEP3_RC=$?
echo "STEP3_RC=$STEP3_RC"

echo "=== phase3 receipts, in first-seen order ==="
cat "$OUT"/logs/*/stage3-native-build.log "$LOGD/step3.log" 2>/dev/null \
  | grep -o "phase3:streaming:[a-z0-9-]*" | awk '!seen[$0]++'
echo "=== other phase3 markers ==="
cat "$OUT"/logs/*/stage3-native-build.log "$LOGD/step3.log" 2>/dev/null \
  | grep -o "phase3:[a-z_]*:[a-z_]*" | awk '!seen[$0]++'
echo "=== stage3 tail ==="
tail -15 "$LOGD/step3.log"
echo "=== done ==="
