# Reproducer candidate, derived from a gdb-measured NULL receiver.
#
# Crash site (stage-2-compiled): driver_aot_pipeline.spl:97
#     val msg = if self.ctx.error_count_value > 0: self.ctx.error_message_at(0) else: "MIR lowering failed"
#
# gdb at the SIGSEGV inside error_message_at:
#     %rdi = 0            <- the `self` receiver argument is NULL
#     %rax = 0
#     => mov 0xb0(%rax),%r10    <- loading self.errors off a NULL self
#
# Immediately BEFORE that line, `for err in self.ctx.errors:` iterated the same
# field successfully and printed the message, and `self.ctx.error_count_value`
# (a scalar on the same object) read correctly. So `self.ctx` is live; only the
# RECEIVER passed to the method call inside the if-EXPRESSION arm is lost.
#
# Ingredient the earlier `ifexpr.spl` fixture lacked: its arms called a FREE
# FUNCTION. Here the arm calls a METHOD ON A FIELD RECEIVER (`self.ctx.m()`).

class Inner:
    var count_value: i64 = 0
    var items: [text] = []

    fn message_at(index: i64) -> text:
        if index < 0 or index >= self.items.len():
            return ""
        self.items[index]

    me add(m: text):
        self.items.push(m)
        self.count_value = self.count_value + 1

class Outer:
    var ctx: Inner = Inner()

    # THE SHAPE UNDER TEST: method on a field receiver, inside an if-expression
    # arm, bound to a val.
    me report_ifexpr() -> text:
        print "IE:before"
        val msg = if self.ctx.count_value > 0: self.ctx.message_at(0) else: "no-errors"
        print "IE:after msg={msg}"
        return msg

    # Control 1: same call, plain statement-if (not an expression).
    me report_stmtif() -> text:
        print "SI:before"
        var msg: text = "no-errors"
        if self.ctx.count_value > 0:
            msg = self.ctx.message_at(0)
        print "SI:after msg={msg}"
        return msg

    # Control 2: same if-expression, but the receiver is bound to a local first.
    me report_bound() -> text:
        print "BD:before"
        val c: Inner = self.ctx
        val msg = if c.count_value > 0: c.message_at(0) else: "no-errors"
        print "BD:after msg={msg}"
        return msg

fn main():
    var o = Outer()
    o.ctx.add("BOOM-0")

    print "iter-control:"
    for e in o.ctx.items:
        print "  iter sees {e}"

    val a = o.report_ifexpr()
    print "A={a}"
    val b = o.report_stmtif()
    print "B={b}"
    val c = o.report_bound()
    print "C={c}"
    print "FIXTURE:end"
