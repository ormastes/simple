# Minimal fixture: typed if-expression bound to a val, the exact shape of
#   val hir_closure_digest: text = if hir_cache_enabled(): ... else: ""
# in driver_hir_pipeline_lowering.spl (statement between the phase-3
# `entry` receipt that printed and the `visit` receipt that did not).
# No classes, no collections: avoids the unresolved-method trap that
# defeated the c018ee15926 fixture.

fn gate(on: bool) -> bool:
    return on

fn digest_on() -> text:
    return "D-ON"

fn body_text(enabled: bool) -> text:
    print "T:entry"
    val d: text = if gate(enabled):
        digest_on()
    else:
        ""
    print "T:after"
    return d

fn body_int(enabled: bool) -> i64:
    print "I:entry"
    val n: i64 = if gate(enabled):
        7
    else:
        0
    print "I:after"
    return n

fn body_bool(enabled: bool) -> bool:
    print "B:entry"
    val b: bool = if gate(enabled):
        true
    else:
        false
    print "B:after"
    return b

fn main():
    val t1: text = body_text(true)
    print "T:on={t1}"
    val t2: text = body_text(false)
    print "T:off={t2}"
    val n1: i64 = body_int(true)
    print "I:on={n1}"
    val n2: i64 = body_int(false)
    print "I:off={n2}"
    val b1: bool = body_bool(true)
    print "B:on={b1}"
    val b2: bool = body_bool(false)
    print "B:off={b2}"
    print "FIXTURE:end"
