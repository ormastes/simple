# Reduced control-flow fixture for the Stage-2/native miscompilation
# tracked in doc/08_tracking/bug/stage3_n_modules_zero_segv_mir_lowering_x86_64_2026-08-24.md
#
# Each case mirrors ONE construct that sits between the `phase3:streaming:entry`
# probe (which printed) and the `phase3:streaming:visit` probe (which did not)
# in driver_hir_pipeline_lowering.spl::lower_and_check_streaming_surfaces_impl.
#
# Every case prints literal sentinels only. No .len() interpolation on a
# suspect owner: a probe that dereferences the suspect value moves the crash.
# Expected output is identical under the interpreter and under native-build.

class Ctx:
    var errors: [text] = []

    me add_error(m: text):
        self.errors.push(m)

    me error_count() -> i64:
        return self.errors.len()

fn gate_true() -> bool:
    return true

fn gate_false() -> bool:
    return false

fn make_digest(tag: text) -> text:
    return "digest-" + tag

# ---------------------------------------------------------------- case A
# Tuple early return of (heap class, bool) from a method, plus add_error.
# Does the caller actually read `false`, and did the mutation land?
class CaseA:
    var ctx: Ctx = Ctx()

    me run(trip: bool) -> (Ctx, bool):
        print "A:entry"
        if trip:
            self.ctx.add_error("A tripped")
            return (self.ctx, false)
        print "A:past-guard"
        return (self.ctx, true)

fn case_a():
    var a1 = CaseA()
    val r1 = a1.run(true)
    val c1: Ctx = r1.0
    print "A:trip verdict={r1.1} errors={c1.error_count()}"
    var a2 = CaseA()
    val r2 = a2.run(false)
    val c2: Ctx = r2.0
    print "A:notrip verdict={r2.1} errors={c2.error_count()}"

# ---------------------------------------------------------------- case B
# Typed if-expression initializer with a call in the taken arm.
# This is the exact shape of `val hir_closure_digest: text = if ...`.
fn case_b_body(enabled: bool) -> text:
    print "B:entry"
    val digest: text = if enabled:
        make_digest("on")
    else:
        ""
    print "B:after-initializer digest={digest}"
    return digest

fn case_b():
    val d1 = case_b_body(true)
    print "B:enabled returned={d1}"
    val d2 = case_b_body(false)
    print "B:disabled returned={d2}"

# ---------------------------------------------------------------- case C
# Short-circuit `and` / `not ... or ...` guard feeding a later statement,
# mirroring `hir_shard_mode` and the phase-3 readiness guard.
fn case_c_body(a: bool, b: bool) -> text:
    print "C:entry"
    val mode: bool = a and gate_true() and b
    if mode:
        print "C:mode-on"
    else:
        print "C:mode-off"
    print "C:after"
    return "C:done"

fn case_c():
    print case_c_body(true, true)
    print case_c_body(true, false)
    print case_c_body(false, true)

# ---------------------------------------------------------------- case D
# Conditional early return nested inside an `unsafe` block, the shape of the
# rt_heap_ref_wellformed guard.
class CaseD:
    var ctx: Ctx = Ctx()

    me run(ok: bool) -> (Ctx, bool):
        print "D:entry"
        unsafe(capabilities: [ffi]):
            if not ok:
                self.ctx.add_error("D malformed")
                return (self.ctx, false)
        print "D:past-unsafe"
        return (self.ctx, true)

fn case_d():
    var d1 = CaseD()
    val r1 = d1.run(false)
    val c3: Ctx = r1.0
    print "D:bad verdict={r1.1} errors={c3.error_count()}"
    var d2 = CaseD()
    val r2 = d2.run(true)
    val c4: Ctx = r2.0
    print "D:good verdict={r2.1} errors={c4.error_count()}"

fn main():
    case_a()
    case_b()
    case_c()
    case_d()
    # case_e() removed: Array.is_empty is unresolved in small native builds (c018ee15926 trap)
    print "FIXTURE:end"
