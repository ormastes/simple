use compiler.backend.backend.c_backend_translate.{MirToC}
use compiler.mir.mir_instructions.*
use compiler.mir.mir_types.*
use compiler.mir.mir_instruction_support.{mir_operand_const_int}

fn empty_span() -> Span:
    Span(start: 0, end: 0, line: 1, col: 1, file: "", length: 0)

fn emit_call_indirect(ret: MirType?) -> text:
    val sig = MirSignature(params: [], return_type: ret, is_variadic: false)
    val t = MirToC.create("probe.sig")
    t.translate_instruction(MirInst(kind: MirInstKind.CallIndirect(nil, mir_operand_const_int(0), [], sig), span: empty_span()))
    t.builder.build()

use std.spec.step

describe "probe":
    it "nil":
        step("Verify: nil")
        val out = emit_call_indirect(nil)
        expect(out.contains("VOIDMARK")).to_equal(false)
        print("NIL_OUT: " + out)
    it "i64":
        step("Verify: i64")
        val out = emit_call_indirect(MirType.i64())
        print("I64_OUT: " + out)
        expect(true).to_equal(true)
