fn main():
    val s = "日本語"
    print("len=" + s.len().to_text())
    val line = "    val lens = ws.map(\\w: w.len())"
    print("linelen=" + line.len().to_text())
    val two = "日本語ab"
    print("two.len=" + two.len().to_text())
    print("slice0_3=" + two[0:3])
    print("slice0_9=" + two[0:9])
    var cnt = 0
    for _c in two:
        cnt = cnt + 1
    print("itercount=" + cnt.to_text())
