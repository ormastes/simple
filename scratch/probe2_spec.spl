use std.spec.*
use std.spec.step
use std.io_runtime.{env_get}

use app.io.audio_ffi.{audio_init, audio_shutdown, audio_get_master_volume, audio_stop, audio_capture_is_active, AudioEngine, AudioPlayback, AudioSource}
use app.io.gamepad_ffi.{BatteryStatus,GamepadContext, GamepadButton, parse_battery_status, button_to_code, code_to_button, gamepad_is_connected, gamepad_get_name, gamepad_apply_deadzone, gamepad_stick_with_deadzone, StickState, gamepad_count}
use app.io.graphics2d_ffi.{FillRule, fill_rule_to_code, Point2D, graphics_path_builder_new, graphics_path_begin, graphics_path_close, graphics_path_build, PathBuilder, Transform2D, graphics_transform_identity, graphics_transform_translate, graphics_transform_multiply, graphics_transform_free, graphics_last_error}
use app.io.rapier2d_ffi.{Vector2, Rotation2, physics_last_error, physics_body_get_mass, RigidBody, physics_body_is_sleeping, physics_intersection_test}
use app.io.tls_ffi.{TlsCertificate, TlsClientConnection, tls_verify_cert, tls_get_cert_subject, tls_is_handshake_complete, tls_close, tls_write}
use app.io.window_ffi.{VirtualKey,WindowConfig, window_config_default, event_parse_type, parse_virtual_key, Window, window_get_size, window_destroy, window_last_error, window_clipboard_get, window_clipboard_has_text, Size}

describe "probe2":
    it "audio":
        val engine = audio_init()
        step("engine valid: {engine.is_valid}")
        expect(engine.is_valid).to_equal(true)
        val vol = audio_get_master_volume()
        step("vol: {vol}")
        expect(vol).to_be_greater_than(-0.0001)
        expect(audio_shutdown(engine)).to_equal(true)
        val stopped = audio_stop(AudioPlayback(handle: 0, is_valid: false))
        step("stop typed: {stopped}")
        expect(audio_capture_is_active()).to_equal(false)
    it "gamepad":
        expect(parse_battery_status(2)).to_equal(BatteryStatus.Discharging)
        expect(parse_battery_status(99)).to_equal(BatteryStatus.Unknown)
        val code = button_to_code(GamepadButton.South)
        expect(code_to_button(code)).to_equal(GamepadButton.South)
        val invalid = GamepadContext(handle: 0, is_valid: false)
        expect(gamepad_is_connected(invalid, 0)).to_equal(false)
        expect(gamepad_get_name(invalid, 0)).to_equal("")
        expect(gamepad_count(invalid)).to_equal(0)
        expect(gamepad_apply_deadzone(0.05, 0.2)).to_equal(0.0)
        val st = gamepad_stick_with_deadzone(StickState(x: 0.05, y: 0.0), 0.2)
        expect(st.x).to_equal(0.0)
    it "gfx":
        expect(fill_rule_to_code(FillRule.EvenOdd)).to_equal(0)
        expect(fill_rule_to_code(FillRule.NonZero)).to_equal(1)
        val t = graphics_transform_identity()
        step("ident: {t}")
        val t2 = graphics_transform_translate(t, 5.0, 6.0)
        step("t2: {t2}")
        expect(graphics_last_error()).to_equal("")
    it "rapier":
        val v = Vector2(x: 3.0, y: 4.0)
        expect(v.length()).to_equal(5.0)
        expect(v.dot(Vector2(x: 1.0, y: 0.0))).to_equal(3.0)
        val r = Rotation2.from_degrees(90.0)
        expect(r.to_degrees()).to_equal(90.0)
        val dead = RigidBody(handle: 0, is_valid: false)
        expect(physics_body_is_sleeping(dead)).to_equal(false)
        step("err: {physics_last_error()}")
    it "tls":
        val cert = TlsCertificate(handle: 0, is_valid: false)
        expect(tls_verify_cert(cert)).to_equal(false)
        expect(tls_get_cert_subject(cert)).to_equal("")
        val conn = TlsClientConnection(handle: 0, host: "h", port: 1, is_valid: false)
        expect(tls_is_handshake_complete(conn)).to_equal(false)
        expect(tls_write(conn, "x")).to_equal(0)
        expect(tls_close(conn)).to_equal(false)
    it "window":
        val cfg = window_config_default()
        step("cfg: {cfg}")
        expect(cfg.title.len()).to_be_greater_than(0)
        expect(parse_virtual_key(4)).to_equal(VirtualKey.A)
        val dead = Window(handle: 0, is_valid: false)
        val sz = window_get_size(dead)
        step("sz: {sz}")
        expect(sz.width).to_equal(0)
        expect(window_clipboard_has_text(dead)).to_equal(false)
        expect(window_clipboard_get(dead)).to_equal("")
