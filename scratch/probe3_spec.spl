use std.spec.*
use std.spec.step

use app.io.mod.{shell, shell_output, env_get, env_set, ProcessResult}
use app.io.process_governor.{proc_slot_max}
use app.io.file_shell.{file_write, file_size, file_delete}

describe "probe3":
    it "owner shell":
        val r = shell("sh -c 'printf raw-out; printf raw-err 1>&2; exit 3'")
        expect(r.stdout).to_equal("raw-out")
        expect(r.stderr).to_equal("raw-err")
        expect(r.exit_code).to_equal(3)
    it "governor":
        val prev = env_get("SIMPLE_MAX_PROCS")
        env_set("SIMPLE_MAX_PROCS", "7")
        expect(proc_slot_max()).to_equal(7)
        env_set("SIMPLE_MAX_PROCS", "not-a-number")
        val d = proc_slot_max()
        step("default: {d}")
        expect(d >= 4 and d <= 64).to_equal(true)
        env_set("SIMPLE_MAX_PROCS", prev ?? "")
    it "file_size":
        val path = "/tmp/land11/scratch/probe3_file.txt"
        expect(file_write(path, "abc")).to_equal(true)
        expect(file_size(path)).to_equal(3)
        expect(file_size("/tmp/land11/scratch/nope-missing.bin")).to_equal(0)
        expect(file_delete(path)).to_equal(true)
