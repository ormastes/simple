use std.spec.*
use std.spec.step
use app.io.file_shell.{file_write, file_size, file_delete}

describe "probe4":
    it "sizes":
        val path = "/tmp/land11/scratch/p4.txt"
        file_write(path, "abc")
        step("real: {file_size(path)}")
        step("missing: {file_size('/tmp/land11/scratch/definitely-missing-xyz')}")
        step("empty: {file_write('/tmp/land11/scratch/p4e.txt','')}, {file_size('/tmp/land11/scratch/p4e.txt')}")
        expect(true).to_equal(true)
