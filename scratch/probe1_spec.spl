use std.spec.*

use app.io.audio_ffi.{audio_get_master_volume, audio_backend_name, audio_backend_is_real, audio_live_device_count}
use app.io.gamepad_ffi.{parse_battery_status, button_to_code, code_to_button, gamepad_apply_deadzone, gamepad_stick_with_deadzone, StickState}
use app.io.graphics2d_ffi.{fill_rule_to_code, graphics_transform_identity, FillRule, Transform2D}
use app.io.window_ffi.{window_config_default, event_parse_type, parse_virtual_key, window_last_error}
use app.io.rapier2d_ffi.{physics_last_error, Vector2, Rotation2}
use app.io.tls_ffi.{tls_cert_fingerprint}

describe "probe":
    it "audio":
        val v = audio_get_master_volume()
        step("vol: {v}")
        val n = audio_backend_name()
        step("name: {n}")
        val c = audio_live_device_count()
        step("dev: {c}")
        expect(true).to_equal(true)
    it "gamepad":
        step("bat: {parse_battery_status(2)}")
        step("code: {button_to_code(GamepadButton.ButtonSouth)}")
        step("dz: {gamepad_apply_deadzone(0.01, 0.2)}")
        expect(true).to_equal(true)
    it "gfx":
        step("rule: {fill_rule_to_code(FillRule.NonZero)}")
        step("ident: {graphics_transform_identity()}")
        expect(true).to_equal(true)
    it "window":
        step("cfg: {window_config_default()}")
        step("ev: {event_parse_type(3)}")
        step("vk: {parse_virtual_key(4)}")
        expect(true).to_equal(true)
    it "rapier":
        val v = Vector2(x: 3.0, y: 4.0)
        step("len: {v.length()} dot: {v.dot(Vector2(x: 1.0, y: 0.0))}")
        expect(v.length()).to_equal(5.0)
        step("err: {physics_last_error()}")
    it "tls":
        step("fp: {tls_cert_fingerprint(\"/nonexistent/path.pem\")}")
        expect(true).to_equal(true)
