use std.spec.*

class D:
    n: i64
    fn fill(mut buf: [u8]) -> Result<i64, text>:
        var i: i64 = 0
        while i < buf.len() as i64:
            buf[i] = 7u8
            i = i + 1
        Ok(i)

describe "mut buf":
    it "propagates":
        val d = D(n: 0)
        var out: [u8] = [0u8, 0u8]
        expect(d.fill(out).unwrap()).to_equal(2)
        expect(out).to_equal([7u8, 7u8])
