use std.nogc_sync_mut.database.sqlite_format.record.{sqlite_record_decode}
use std.nogc_sync_mut.database.sql.types.{DbValue}

fn main() -> i64:
    val payload: [u8] = [0x08u8, 0x00, 0x01, 0x01, 0x2f, 0x04, 0x01, 0x00,
        0x01, 0x65, 0x6c, 0x61, 0x74, 0x65, 0x2d, 0x73, 0x6f, 0x75, 0x72,
        0x63, 0x65, 0x2d, 0x66, 0x69, 0x72, 0x73, 0x74, 0x65, 0x53, 0xf1,
        0x0b, 0x1e]
    val values = match sqlite_record_decode(payload, 1):
        case Ok(v): v
        case Err(_):
            print "DECODE_ERR"
            return 1
    print "count={values.len()}"
    print "v0={values[0].to_text()}"
    print "v1={values[1].to_text()}"
    print "v2={values[2].to_text()}"
    print "v3={values[3].to_text()}"
    print "v4={values[4].to_text()}"
    print "v5={values[5].to_text()}"
    values[0] = DbValue.Integer(value: 11)
    print "ipk0={values[0].to_text()}"
    val plain: i64 = 11
    print "plain={plain}"
    0
