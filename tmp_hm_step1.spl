use os.compositor.hosted_wm_capture_evidence.{HostedCaptureFramebuffer, render_shared_mdi_frame, shared_mdi_surfaces, local_simple_web_request_pixels, simple_web_capture_request, write_argb_crop_ppm_text, HostedWebRenderRequest, HostedWebRenderPixels, capture_shared_hosted_wm_frame}

print "start"
val fb = HostedCaptureFramebuffer.with_color(340, 240, 0xFF5A7FB5u32)
print "fb" 
fb.fill_rect(0,0,340,240,0xFF000000u32)
print "filled"
val surfs = shared_mdi_surfaces()
print "surfs " + surfs.len().to_text()
print "render"
render_shared_mdi_frame(fb)
print "rendered"
