use std.io_runtime.{file_read}
use std.spec.*
use app.build.manifest_worker.{manifest_worker_usage,
    parse_manifest_worker_request}

describe "standalone build manifest worker":
    it "accepts only the explicit build manifest grammar":
        val build = parse_manifest_worker_request(["build",
            "--manifest=plugins/demo/build.sdn", "--target=all"])
        expect(build.valid()).to_equal(true)
        expect(build.validate_only).to_equal(false)
        expect(build.selector).to_equal("all")
        expect(parse_manifest_worker_request([
            "--manifest=plugins/demo/build.sdn", "--target=all"]).valid()).to_equal(false)
        expect(parse_manifest_worker_request(["build", "--target=all"]).valid()).to_equal(false)

    it "supports validation without executing a target build":
        val validation = parse_manifest_worker_request(["build",
            "--validate-manifest=tools/mcp-registry/build.sdn",
            "--target=simple_mcp_server"])
        expect(validation.valid()).to_equal(true)
        expect(validation.validate_only).to_equal(true)
        expect(validation.manifest_path).to_equal("tools/mcp-registry/build.sdn")
        expect(manifest_worker_usage()).to_contain("--validate-manifest=")

    it "keeps the entry closure independent of the general CLI and editors":
        val source = file_read("src/app/build/manifest_worker.spl")
        expect(source).to_contain("use app.build.target_executor")
        expect(source).to_contain("execute_manifest_build(request.manifest_path")
        expect(source).to_not_contain("app.build.cli_entry")
        expect(source).to_not_contain("app.cli._CliMain")
        expect(source).to_not_contain("app.editor")
        expect(source).to_not_contain("cli_native_build")
        expect(source).to_not_contain("rt_process_run")
