# Regression for the Phase-2 parent crash: querying an untouched context must
# use the scalar counter, never the native representation of the empty names
# array.  This is intentionally a native-sensitive contract even though the
# normal interpreter path also exercises the state transition.
# @cover src/compiler/80.driver/driver_types.spl

use compiler.driver.driver_types.{CompileContext}
use compiler.common.driver_compile_options.{CompileOptions, driver_core_compile_options_default}

fn fresh_poison_context() -> CompileContext:
    var options: CompileOptions = driver_core_compile_options_default()
    options.input_files = ["poisoned_module_counter_spec_input.spl"]
    CompileContext.create(options)

describe "CompileContext poisoned-module counter":

    it "answers zero without dereferencing the empty poisoned-name list":
        val ctx = fresh_poison_context()

        expect(ctx.poisoned_module_count()).to_equal(0)
        expect(ctx.poison_budget_exhausted()).to_equal(false)

    it "updates the scalar count with each poisoned module":
        var ctx = fresh_poison_context()

        ctx.mark_module_poisoned("first")
        ctx.mark_module_poisoned("second")

        expect(ctx.poisoned_module_count()).to_equal(2)
        expect(ctx.is_module_poisoned("first")).to_equal(true)
        expect(ctx.is_module_poisoned("missing")).to_equal(false)
