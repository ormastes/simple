use std.common.compress.gzip.{gzip_compress, gzip_decompress}
use std.nogc_sync_mut.io.time_ops.{current_time_ms}
use std.nogc_sync_mut.io.file_ops.{file_read_bytes, file_write_bytes}

fn main():
    for name in ["f16", "f32", "f64"]:
        val d = file_read_bytes("/mnt/data/soak-3450520/bench/{name}.bin")
        val t0 = current_time_ms()
        val comp = gzip_compress(d)
        val t1 = current_time_ms()
        val back = gzip_decompress(comp)
        val t2 = current_time_ms()
        var ok = back.len() == d.len()
        var j = 0
        while ok and j < d.len():
            if back[j] != d[j]: ok = false
            j = j + 1
        file_write_bytes("/mnt/data/soak-3450520/bench/{name}.out.gz", comp)
        print "{name} in={d.len()} comp_bytes={comp.len()} comp_ms={t1-t0} decomp_ms={t2-t1} roundtrip_ok={ok}"
