use std.nogc_sync_mut.io.file_ops.{file_read_bytes, file_write_bytes}
fn main():
    val d = file_read_bytes("/mnt/data/soak-3450520/bench/f16.bin")
    file_write_bytes("/mnt/data/soak-3450520/bench/copy.bin", d)
    val back = file_read_bytes("/mnt/data/soak-3450520/bench/copy.bin")
    print "read={d.len()} wrote_back_read={back.len()}"
