use std.common.compress.gzip.{gzip_compress, gzip_decompress}
use std.nogc_sync_mut.io.file_ops.{file_write_bytes}

fn main():
    var d: [u8] = []
    var i = 0
    while i < 4096:
        d.push(((i * 7 + (i / 13) * 31 + (i % 97)) % 251).to_u8())
        i = i + 1
    val c = gzip_compress(d)
    file_write_bytes("/tmp/gzb.gz", c)
    val b = gzip_decompress(c)
    print "orig={d.len()} comp={c.len()} back={b.len()}"
