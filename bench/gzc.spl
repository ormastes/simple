use std.common.compress.gzip.{gzip_compress}
use std.nogc_sync_mut.io.time_ops.{current_time_ms}
use std.nogc_sync_mut.io.file_ops.{file_read_bytes}
fn main():
    for name in ["f16", "f32", "f64"]:
        val d = file_read_bytes("/mnt/data/soak-3450520/bench/{name}.bin")
        var best = 0
        var r = 0
        while r < 3:
            val t0 = current_time_ms()
            val c = gzip_compress(d)
            val t1 = current_time_ms()
            if best == 0 or (t1-t0) < best: best = t1-t0
            r = r + 1
        print "{name} in={d.len()} comp_ms_best={best}"
