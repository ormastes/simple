use spec.*
use std.filesystem.*

describe "Effect Pass":
    it "imports its cross-module solver helpers":
        val source = rt_file_read_text("src/compiler/30.types/type_system/effect_pass.spl") ?? ""
        expect(source).to_contain(
            "use compiler.common.effects_solver.{EffectSolver, effectsolver_create, effectsolver_solve}"
        )
