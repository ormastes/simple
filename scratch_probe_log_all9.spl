use lib.nogc_sync_mut.log.{clear_scopes, get_level, get_log_level, log_debug, log_error, log_info, log_verbose, set_scope_level, trace}

fn main():
    clear_scopes()
    set_scope_level(scope: "x", level: 3)
    print("get_level={get_level(scope: 'x')}")
    print("get_log_level={get_log_level()}")
    log_debug("d")
    log_error("e")
    log_info("i")
    log_verbose("v")
    trace(scope: "x", msg: "t")
    print("ALL9_OK")
