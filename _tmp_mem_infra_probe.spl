use app.cli._CliMain.args_and_os_commands.{parse_global_flags, parse_mem_infra_flags}

fn main() -> i64:
    val flags = parse_global_flags(["run", "test/fixture/mem_infra/attr_enabled_probe.spl", "--mem-infra=attr"])
    print "requested_len={flags.mem_infra_requested.len()}"
    if flags.mem_infra_requested.len() > 0:
        print "requested0={flags.mem_infra_requested[0]}"
    print "strict={flags.mem_infra_strict}"

    val mf = parse_mem_infra_flags(["--mem-infra=asan,harden", "--mem-infra-strict"])
    print "mf_len={mf.requested.len()}"
    print "mf0={mf.requested[0]}"
    print "mf1={mf.requested[1]}"
    print "mf_strict={mf.strict}"
    0
