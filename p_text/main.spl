struct Holder:
    m: Dict<text, text>

fn main():
    val k = "k"
    val miss = "nope"
    var d: Dict<text, text> = {}
    d[k] = "VALUE_ALPHA"
    d["k2"] = "VALUE_BETA"

    print "A01 ctl_has={d.contains_key(k)}"
    print "A02 ctl_keys_len={d.keys().len()}"
    print "A03 ctl_idx={d[k]}"
    print "A04 dict_len={d.len()}"

    val g = d.get(k)
    print "A05 loc_get_isnil={g == nil}"
    print "A06 loc_get_RAWPRINT={g}"

    val gm = d.get(miss)
    print "A07 loc_miss_isnil={gm == nil}"

    val h = Holder(m: d)
    print "A08 fld_has={h.m.contains_key(k)}"
    print "A09 fld_keys_len={h.m.keys().len()}"
    print "A10 fld_idx={h.m[k]}"
    print "A11 fld_len={h.m.len()}"

    val fg = h.m.get(k)
    print "A12 fld_get_isnil={fg == nil}"
    print "A13 fld_get_RAWPRINT={fg}"

    val fm = h.m.get(miss)
    print "A14 fld_miss_isnil={fm == nil}"

    print "A15 loc_unwrap={g.unwrap()}"
    print "A16 fld_unwrap={fg.unwrap()}"
    print "A17 DONE"
