# Probe: print "<path>\t<effective>\t<raw>" for each spec path argument.
# Used by the sspec modernization waves to verify post-transform scores >80.
use std.cli.cli_util.{get_cli_args}
use std.nogc_sync_mut.io.file_ops.{file_read}
use app.sspec_maintain.analyzer.{analyze_sspec_text}

fn main():
    val args = get_cli_args()
    var i = 0
    while i < args.len():
        val path = args[i]
        i = i + 1
        val source = file_read(path) ?? ""
        if source == "":
            print path + "\t-1\t-1"
            continue
        val report = analyze_sspec_text(path, source)
        print path + "\t" + report.score.effective_aggregate.to_text() + "\t" + report.score.raw_aggregate.to_text()
