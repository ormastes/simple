"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/app/mcp/wiki_keyword/wiki_tool_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/app/mcp/wiki_keyword/wiki_tool.spl 80%
# @cover src/app/mcp/wiki_keyword/register.spl 60%
"""
# MCP Wiki Keyword Tool Specification

**Feature:** spm-winfs-llm-suite / AC-6
**Status:** Red (no impl yet)

Tool returns `Content` tagged with `ContentAuthority{level, source_trust}`;
lower-clearance reader gets Hold via `release_gate`; registration via
`dispatch_wrap` boundary is exercised.
"""

use std.spipe.*
use lib.common.privilege.id_path.{id_path_intern}
use lib.common.privilege.authority_token.{AuthorityLevel, TrustSource}
use lib.common.llm.content_authority.{ContentAuthority, release_gate}
use app.mcp.wiki_keyword.wiki_tool.{wiki_lookup, WikiContent}
use app.mcp.wiki_keyword.register.{register_wiki_tool}
use lib.nogc_async_mut.mcp.dispatch.{DispatchRegistry}

describe "MCP wiki_keyword tool":
    describe "wiki_lookup":
        it "AC-6: returns Content tagged with ContentAuthority":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-APP-001
            step("Verify: AC-6: returns Content tagged with ContentAuthority")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = wiki_lookup("simple language")
            expect result.ok to_equal true
            val authority = result.value.authority
            expect authority.level to_equal AuthorityLevel.Internal
            expect authority.source_trust to_equal TrustSource.RegistryTrusted

        it "AC-6: release_gate returns Scrub/Block for lower-clearance reader":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-APP-002
            step("Verify: AC-6: release_gate returns Scrub/Block for lower-clearance reader")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = wiki_lookup("simple language")
            val decision = release_gate(result.value.authority, AuthorityLevel.Public)
            val held = (decision.kind == "Scrub") or (decision.kind == "Block")
            expect held to_equal true

    describe "registration via dispatch_wrap":
        it "AC-6: register_wiki_tool adds tool entry to DispatchRegistry":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-APP-003
            step("Verify: AC-6: register_wiki_tool adds tool entry to DispatchRegistry")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val reg = DispatchRegistry.new()
            register_wiki_tool(reg)
            val found = reg.find("wiki.lookup")
            expect found.present to_equal true
