"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/app/simple_process_manager/winfs_shim_host_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/app/simple_process_manager/winfs_shim_host.spl 80%
# @cover src/lib/common/win_fs/fs_encoder.spl 40%
"""
# Host Win-FS shim Specification

**Feature:** spm-winfs-llm-suite / AC-4
**Status:** Red (no impl yet)

Host shim publishes same tree under a temp runtime dir via the same encoder.
Verified by encoding the same record through the shared encoder and comparing
path layout + bytes.
"""

use std.spipe.*
use std.fs.{read_file}
use lib.common.privilege.id_path.{id_path_intern}
use lib.common.win_fs.window_record.{WindowRecord, WindowState, Rect, BufferRef}
use lib.common.win_fs.fs_encoder.{encode_record, tree_has_path}
use app.simple_process_manager.winfs_shim_host.{WinFsShimHost}

describe "winfs_shim_host":
    describe "publish via shared encoder":
        it "AC-4: publish writes /<app>/<wid>/title under runtime dir":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-APP-001
            step("Verify: AC-4: publish writes /<app>/<wid>/title under runtime dir")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val shim = WinFsShimHost.new_for_test(runtime_dir: "/tmp/spm_winfs_host")
            val rec = WindowRecord(
                wid: 42, generation: 1, app: "banking", title: "Acct",
                state: WindowState.Normal,
                geometry: Rect(x: 0, y: 0, w: 1, h: 1),
                buffer_ref: BufferRef(kind: "shm", handle: 7, bytes: 4096),
                acl_id_path: id_path_intern("id.user.banking.view"))
            val result = shim.publish(rec)
            expect result.ok to_equal true
            val title = read_file("/tmp/spm_winfs_host/banking/42/title")
            expect title to_equal "Acct"

        it "AC-4: paths match the shared encoder schema (no drift)":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-APP-002
            step("Verify: AC-4: paths match the shared encoder schema (no drift)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val rec = WindowRecord(
                wid: 42, generation: 1, app: "banking", title: "Acct",
                state: WindowState.Normal,
                geometry: Rect(x: 0, y: 0, w: 1, h: 1),
                buffer_ref: BufferRef(kind: "shm", handle: 7, bytes: 4096),
                acl_id_path: id_path_intern("id.user.banking.view"))
            val tree = encode_record(rec)
            expect tree_has_path(tree, "/banking/42/title") to_equal true
            expect tree_has_path(tree, "/banking/42/state") to_equal true

    describe "grep sentinel":
        it "AC-4: winfs_shim_host.spl imports from common/win_fs/fs_encoder":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-APP-003
            step("Verify: AC-4: winfs_shim_host.spl imports from common/win_fs/fs_encoder")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val source = read_file("src/app/simple_process_manager/winfs_shim_host.spl")
            expect source to_contain "use lib.common.win_fs.fs_encoder"
