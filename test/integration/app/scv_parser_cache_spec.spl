use app.io.mod (process_run)

# The binary under test is `bin/simple`, NOT `bin/release/simple`.
# `bin/release/simple` is a production-guard WRAPPER script, not the compiler: it
# refuses to exec a non-production runtime ("error: refusing non-production Simple
# runtime: .../simple") and exits WITHOUT running anything. The scv subprocess then
# produced no output at all, every `to_contain` below failed, and the result looked
# exactly like a live scv defect -- a plausible, app-shaped FALSE RED.
# `bin/simple` is the documented default tool path and execs whatever is deployed.
fn _run_parser_cache_script(script: text) -> text:
    val (out, err, code) = process_run("/bin/sh", ["-c", script])
    val combined = "{out}{err}\nexit={code}\n"
    # Prevention guard for the whole class: assert the subprocess ACTUALLY RAN
    # before any content assertion. A `to_contain` on empty output fails with the
    # same shape whether the tool misbehaved, the binary path was wrong, a wrapper
    # refused to exec, or a fixture was missing. Fail loudly on "did not run" so it
    # can never masquerade as "ran wrong".
    assert_false(out == "" and err == "")
    assert_false(combined.contains("refusing non-production Simple runtime"))
    combined

describe "the scv subprocess actually ran":
    # Detection example for the CLASS, not one scv behaviour: prove the binary
    # under test really executes before asserting anything about its output.
    # Fails identically for a wrong binary path, a wrapper that refuses to exec,
    # or a missing entrypoint -- all of which otherwise present as a content
    # mismatch and get misread as a live scv defect.
    it "runs the scv entrypoint and produces output with exit 0":
        val script = "set -eu\nREPO=$(pwd)\nTMP=$(mktemp -d /tmp/scv-ran-probe.XXXXXX)\ncd \"$TMP\"\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" init\n"
        val (out, err, code) = process_run("/bin/sh", ["-c", script])
        assert_equal(code, 0)
        assert_false(out == "")
        assert_false("{out}{err}".contains("refusing non-production Simple runtime"))

describe "scv parser cache":
    it "reuses parser-index nodes when raw bytes and parser identity are unchanged":
        val script = "set -eu\nREPO=$(pwd)\nTMP=$(mktemp -d /tmp/scv-parse-cache.XXXXXX)\nprintf 'alpha\\nbeta\\n' > \"$TMP/a.txt\"\ncd \"$TMP\"\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" init >/dev/null\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" snapshot >/dev/null\nFIRST=$(SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" parse-gate a.txt)\nCOUNT1=$(find .scv/objects/syntax -type f | wc -l | tr -d ' ')\nROOT1=$(SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" parse-index | sed -n 's/.*|node=\\(syntax_node_[^|]*\\).*/\\1/p' | head -1)\nSECOND=$(SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" parse-gate a.txt)\nCOUNT2=$(find .scv/objects/syntax -type f | wc -l | tr -d ' ')\nROOT2=$(SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" parse-index | sed -n 's/.*|node=\\(syntax_node_[^|]*\\).*/\\1/p' | head -1)\nprintf '%s\\n%s\\ncount1=%s\\ncount2=%s\\nroot1=%s\\nroot2=%s\\n' \"$FIRST\" \"$SECOND\" \"$COUNT1\" \"$COUNT2\" \"$ROOT1\" \"$ROOT2\"\ntest \"$COUNT1\" = \"$COUNT2\"\ntest \"$ROOT1\" = \"$ROOT2\"\n"
        val out = _run_parser_cache_script(script)
        expect(out).to_contain("cache: reused")
        expect(out).to_contain("count1=3")
        expect(out).to_contain("count2=3")
        expect(out).to_contain("root1=syntax_node_")
        expect(out).to_contain("root2=syntax_node_")
        expect(out).to_contain("exit=0")
