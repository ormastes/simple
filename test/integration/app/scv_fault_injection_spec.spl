# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: This spec proves the SCV snapshot path follows the
write-new-then-publish protocol (stabilization report §6): a crash injected
after any write step leaves the repository in the OLD or NEW state, never half.
Faults are injected via `SCV_FAULT_AFTER=<content|tree|commit|operation|head>`.
Audience: Maintainers of the SCV storage layer.
"""
# @req: REQ-SSPEC-INTEGRATION
use std.spec.step

use std.spec.{describe, it, expect, step}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn _fault_script(point: text) -> [text]:
    [
        "set -eu",
        "REPO=$(pwd)",
        "TMP=$(mktemp -d /tmp/scv-fault-{point}.XXXXXX)",
        "scv() { SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" \"$@\"; }",
        "cd \"$TMP\"",
        "printf 'base\\n' > a.txt",
        "scv init >/dev/null",
        "scv snapshot >/dev/null",
        "OLD_OP=$(cat .scv/HEAD_OP)",
        "OLD_COMMIT=$(sed -n 's/default: //p' .scv/meta/workspaces.sdn)",
        "printf 'edited\\n' > a.txt",
        "set +e",
        "SCV_FAULT_AFTER={point} scv snapshot",
        "FAULT_CODE=$?",
        "set -e",
        "printf 'fault_code=%s\\n' \"$FAULT_CODE\"",
        "test \"$FAULT_CODE\" -eq 3",
        # Restart: run doctor (reconciles a stale derived pointer), then fsck.
        "scv doctor",
        "FSCK1=$(scv fsck || true)",
        "printf 'fsck1_struct_errors=%s\\n' \"$(printf '%s' \"$FSCK1\" | grep -Ec 'missing|corrupt|mismatch|bad (commit|change|tree)' || true)\"",
        "NEW_OP=$(cat .scv/HEAD_OP)",
        "NEW_COMMIT=$(sed -n 's/default: //p' .scv/meta/workspaces.sdn)",
        # OLD or NEW, never half: head and workspace must agree on one state.
        "if [ \"$NEW_OP\" = \"$OLD_OP\" ]; then printf 'state=old\\n'; test \"$NEW_COMMIT\" = \"$OLD_COMMIT\"; else printf 'state=new\\n'; test \"$NEW_COMMIT\" != \"$OLD_COMMIT\"; fi",
        # The repository stays fully usable: a fresh snapshot commits the edit.
        "scv snapshot >/dev/null",
        "scv status",
        "FSCK2=$(scv fsck || true)",
        "printf 'fsck2_struct_errors=%s\\n' \"$(printf '%s' \"$FSCK2\" | grep -Ec 'missing|corrupt|mismatch|bad (commit|change|tree)' || true)\""
    ]

fn _run(lines: [text]) -> text:
    val (out, err, code) = rt_process_run("/bin/sh", ["-c", lines.join("\n") + "\n"])
    val combined = "{out}{err}\nexit={code}\n"
    expect(out == "" and err == "").to_equal(false)
    combined

fn _expect_old_or_new(out: text, point: text, expected_state: text):
    expect(out).to_contain("FAULT injected after {point}")
    expect(out).to_contain("fault_code=3")
    expect(out).to_contain("state={expected_state}")
    expect(out).to_contain("fsck1_struct_errors=0")
    expect(out).to_contain("fsck2_struct_errors=0")
    expect(out).to_contain("clean")
    expect(out).to_contain("exit=0")

describe "scv snapshot fault injection":
    # @manual scenario evidence
    it "stays on the old state when crashed after content writes":
        # @req REQ-SSPEC-INTEGRATION
        step("stays on the old state when crashed after content writes")
        step("Inject a crash after content object writes, restart, verify")
        val out = _run(_fault_script("content"))
        _expect_old_or_new(out, "content", "old")

    it "stays on the old state when crashed after the tree write":
        # @req REQ-SSPEC-INTEGRATION
        step("stays on the old state when crashed after the tree write")
        step("Inject a crash after the tree write, restart, verify")
        val out = _run(_fault_script("tree"))
        _expect_old_or_new(out, "tree", "old")

    it "stays on the old state when crashed after the commit write":
        # @req REQ-SSPEC-INTEGRATION
        step("stays on the old state when crashed after the commit write")
        step("Inject a crash after the commit write, restart, verify")
        val out = _run(_fault_script("commit"))
        _expect_old_or_new(out, "commit", "old")

    it "stays on the old state when crashed after the operation write":
        # @req REQ-SSPEC-INTEGRATION
        step("stays on the old state when crashed after the operation write")
        step("Inject a crash after the operation object write, restart, verify")
        val out = _run(_fault_script("operation"))
        _expect_old_or_new(out, "operation", "old")

    it "lands on the new state when crashed after head publication":
        # @req REQ-SSPEC-INTEGRATION
        step("lands on the new state when crashed after head publication")
        step("Inject a crash after the head marker write, restart, verify")
        val out = _run(_fault_script("head"))
        step("Doctor reconciles the derived workspace pointer to the new head")
        _expect_old_or_new(out, "head", "new")
