# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, expect}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn _run_stub(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/stub/main.spl\" " + joined
    ])

describe "stub log mode CLI options":
    # @manual scenario evidence
    it "shows shared log options in help":
        # @req REQ-SSPEC-INTEGRATION
        step("shows shared log options in help")
        val (out, err, code) = _run_stub(["--help"])
        expect(code).to_equal(0)
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "rejects invalid log mode":
        # @req REQ-SSPEC-INTEGRATION
        step("rejects invalid log mode")
        val (out, err, code) = _run_stub(["--log-mode=noisy"])
        expect(code).to_equal(1)
