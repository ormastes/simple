"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/app/check_skip_log_modes_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec.{describe, it, expect, step}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val FIXTURE_DIR = "/tmp/simple_check_skip_log_mode_fixture"

fn _setup_fixture():
    val (_out, _err, _code) = rt_process_run("/bin/sh", [
        "-c",
        "rm -rf " + FIXTURE_DIR + " && mkdir -p " + FIXTURE_DIR + "/test/unit && cat > " + FIXTURE_DIR + "/test/unit/sample_spec.spl <<'EOF'\n# temporarily disabled\n# @skip\ndescribe \"sample\":\n    it \"works\":\n        assert true\nEOF"
    ])

fn _run_check_skip(args: [text]) -> (text, text, i64):
    val joined = args.join(" ")
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); cd " + FIXTURE_DIR + " && SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/check_skip/main.spl\" " + joined
    ])

describe "check-skip log mode CLI options":
    it "shows shared log options in help":
        # @req: REQ-INTEGRATION-APP-001
        step("Verify: shows shared log options in help")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        _setup_fixture()
        val (out, err, code) = _run_check_skip(["--help"])
        expect(code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(out).to_contain("--log-mode")
        expect(out).to_contain("--progress")

    it "supports log-mode json":
        # @req: REQ-INTEGRATION-APP-002
        step("Verify: supports log-mode json")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        _setup_fixture()
        val (out, err, code) = _run_check_skip(["--log-mode=json"])
        expect(code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(out).to_contain("\"command\":\"check-skip\"")
        expect(out).to_contain("\"total\":1")
        expect(out).to_contain("\"skipped\":1")

    it "supports dot progress":
        # @req: REQ-INTEGRATION-APP-003
        step("Verify: supports dot progress")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        _setup_fixture()
        val (out, err, code) = _run_check_skip(["--progress=dot"])
        expect(code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(out).to_contain(".")
        expect(out).to_contain("Skip/Pending Test Report")

    it "rejects invalid log mode":
        # @req: REQ-INTEGRATION-APP-004
        step("Verify: rejects invalid log mode")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        _setup_fixture()
        val (out, err, code) = _run_check_skip(["--log-mode=noisy"])
        expect(code).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
