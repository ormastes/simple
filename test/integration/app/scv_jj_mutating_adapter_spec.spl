# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: This spec proves SCV-IMPL-B-02 — the MUTATING jj CLI adapter actually
EXECUTES. The read-only adapter (MIG-13, backend_git.spl) never runs jj, and the
sj lane until now only BUILT the jj command string and returned it as stdout with
exit_code 0 (`handle_cli_args` pushed `build_command(...)` into `outputs` and
never reached a process spawn), so `sj raw jj log -r @` printed
`jj --no-pager --color never ...` instead of a commit id. This spec proves real
state change: describe/new/undo/snapshot run against a THROWAWAY jj repo created
by `mktemp -d` + `jj git init`, and the mutation is read back with a
machine-readable `-T` template — never scraped human output, never `.jj`
internals. The jj version is PINNED and a mismatch REFUSES rather than assuming
compatibility.
Safety: every mutating call in this spec runs inside a fresh mktemp scratch repo
and asserts it is inside that scratch path first; nothing here touches the real
repository and nothing here pushes.
Audience: Maintainers of the SCV jj adapter and the sj capsule coordinator (B-01).
"""
# @req: REQ-SCV-JJ-MUTATING-001
# lifecycle: doc/03_plan/app/tools/scv_complete_impl_plan.md
# lifecycle: doc/04_architecture/app/tools/scv.md
# lifecycle: doc/05_design/app/tools/scv.md
use std.spec.step

use std.spec.{describe, it, expect, step}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

# Scratch-repo prelude. Creates a THROWAWAY jj repo under /tmp and refuses to
# continue unless the working directory really is inside it — a mutating VCS
# adapter must never be exercised against the developer's real repository.
fn _prelude(tag: text) -> [text]:
    [
        "set -eu",
        "REPO=$(pwd)",
        "TMP=$(mktemp -d /tmp/scv-jjmut-{tag}.XXXXXX)",
        "cd \"$TMP\"",
        "mkdir work && cd work",
        "git init -q . >/dev/null 2>&1",
        "jj git init --colocate >/dev/null 2>&1 || jj git init >/dev/null 2>&1",
        # Fail closed: prove we are inside the scratch repo before any mutation.
        "case \"$(pwd)\" in \"$TMP\"/*) echo SCRATCH-CONFIRMED ;; *) echo NOT-SCRATCH; exit 9 ;; esac",
        "printf 'alpha\\n' > a.txt"
    ]

# Emit a driver program that calls the adapter API B-01 will adopt, then run it
# with the deployed compiler. This exercises the library API directly, argv-shaped,
# with no shell quoting in between.
# The driver must live inside the repository tree: `use std.scv.*` resolves from
# the project stdlib roots only, so a program written into /tmp cannot import it.
# It is written under the gitignored build/ dir and removed afterwards. The
# adapter addresses the repo as `-R .`, which is resolved against the process
# working directory — the scratch repo — so the driver's own location does not
# affect which repository is mutated.
fn _driver(body: [text]) -> [text]:
    var lines: [text] = ["DRV=\"$REPO/build/scv-b02-drv-$$-{body.len()}\"", "mkdir -p \"$DRV\"", "cat > \"$DRV/drv.spl\" <<'SPL_EOF'"]
    lines.push("use std.scv.jj_adapter")
    lines.push("")
    lines.push("fn main() -> i64:")
    lines.push("    val R = \".\"")
    for l in body:
        lines.push("    {l}")
    lines.push("    0")
    lines.push("SPL_EOF")
    lines.push("\"$REPO/bin/simple\" run \"$DRV/drv.spl\" 2>/dev/null")
    lines.push("rm -rf \"$DRV\"")
    lines

fn _run(lines: [text]) -> text:
    val (out, err, code) = rt_process_run("/bin/sh", ["-c", lines.join("\n") + "\n"])
    val combined = "{out}{err}\nexit={code}\n"
    expect(out == "" and err == "").to_equal(false)
    combined

describe "scv mutating jj adapter (SCV-IMPL-B-02)":
    # @manual SCV commit gates
    it "executes a real jj mutation and reads the new state back with a machine template":
        # @req REQ-SCV-JJ-MUTATING-001
        step("In a throwaway jj repo, describe the working-copy change through the adapter")
        var lines = _prelude("describe")
        var body: [text] = []
        body.push("val r = scv_jj_describe(R, \"two word message\")")
        body.push("print(\"executed=\{r.executed} ok=\{r.ok} exit=\{r.exit_code}\")")
        body.push("print(\"readback=[\{scv_jj_read_description(R, \"@\")}]\")")
        for l in _driver(body):
            lines.push(l)
        step("Cross-check the mutation with jj itself, independently of the adapter")
        lines.push("echo \"independent=[$(jj --no-pager --color never --ignore-working-copy log --no-graph -r @ -T description)]\"")
        val out = _run(lines)
        step("Verify the process really ran and the description round-trips, spaces intact")
        expect(out).to_contain("SCRATCH-CONFIRMED")
        expect(out).to_contain("executed=true ok=true exit=0")
        expect(out).to_contain("readback=[two word message]")
        expect(out).to_contain("independent=[two word message]")
        expect(out).to_contain("exit=0")

    it "refuses to run when the jj version does not match the pin":
        # @req REQ-SCV-JJ-MUTATING-001
        step("Ask the adapter to run a mutation under a deliberately wrong version pin")
        var lines = _prelude("pin")
        var body: [text] = []
        body.push("val r = scv_jj_exec_pinned(R, [\"describe\", \"-m\", \"must-not-land\"], \"9.99\")")
        body.push("print(\"executed=\{r.executed} ok=\{r.ok} exit=\{r.exit_code}\")")
        body.push("print(\"stderr=[\{r.stderr}]\")")
        body.push("print(\"pinned=\{scv_jj_pinned_version()} actual_ok=\{scv_jj_version_matches(scv_jj_version(R))}\")")
        for l in _driver(body):
            lines.push(l)
        step("Confirm nothing was written to the repo despite the request")
        lines.push("echo \"desc=[$(jj --no-pager --color never --ignore-working-copy log --no-graph -r @ -T description)]\"")
        val out = _run(lines)
        step("Verify the refusal is a refusal, not a warning, and state is untouched")
        expect(out).to_contain("executed=false ok=false")
        expect(out).to_contain("ERROR — nothing was checked (jj version")
        expect(out).to_contain("pinned=0.32 actual_ok=true")
        expect(out).to_contain("desc=[]")
        expect(out).to_contain("exit=0")

    it "runs new and undo for real, and undo rolls the mutation back":
        # @req REQ-SCV-JJ-MUTATING-001
        step("describe, then new, then undo the new — all through the adapter")
        var lines = _prelude("undo")
        var body: [text] = []
        body.push("val d = scv_jj_describe(R, \"first-change\")")
        body.push("print(\"describe_ok=\{d.ok}\")")
        body.push("val n = scv_jj_new(R)")
        body.push("print(\"new_ok=\{n.ok} after_new=[\{scv_jj_read_description(R, \"@\")}]\")")
        body.push("val u = scv_jj_undo(R)")
        body.push("print(\"undo_ok=\{u.ok} after_undo=[\{scv_jj_read_description(R, \"@\")}]\")")
        for l in _driver(body):
            lines.push(l)
        val out = _run(lines)
        step("Verify new moved off the described change and undo restored it")
        expect(out).to_contain("describe_ok=true")
        expect(out).to_contain("new_ok=true after_new=[]")
        expect(out).to_contain("undo_ok=true after_undo=[first-change]")
        expect(out).to_contain("exit=0")

    it "snapshot omits --ignore-working-copy while describe/new/undo include it":
        # @req REQ-SCV-JJ-MUTATING-001
        step("Inspect the argv the adapter builds for each mutating operation")
        var lines = _prelude("flags")
        var body: [text] = []
        body.push("print(\"snapshot=[\{scv_jj_argv(R, [\"debug\", \"snapshot\"]).join(\" \")}]\")")
        body.push("print(\"describe=[\{scv_jj_argv(R, [\"describe\", \"-m\", \"x\"]).join(\" \")}]\")")
        for l in _driver(body):
            lines.push(l)
        step("Then prove snapshot actually snapshots the working copy into the op log")
        var body2: [text] = []
        body2.push("val s = scv_jj_snapshot(R)")
        body2.push("print(\"snapshot_ok=\{s.ok} executed=\{s.executed}\")")
        lines.push("printf 'beta\\n' > b.txt")
        for l in _driver(body2):
            lines.push(l)
        lines.push("echo \"tracked=[$(jj --no-pager --color never --ignore-working-copy file list -r @ | tr '\\n' ',')]\"")
        val out = _run(lines)
        step("Verify the flag policy and that the new file was really snapshotted")
        expect(out).to_contain("snapshot_ok=true executed=true")
        expect(out).to_contain("--no-pager --color never")
        expect(out).to_contain("describe=[jj -R . --ignore-working-copy --no-pager --color never describe -m x]")
        expect(out).to_contain("snapshot=[jj -R . --no-pager --color never debug snapshot]")
        expect(out).to_contain("b.txt")
        expect(out).to_contain("exit=0")

    it "the sj lane executes the jj command instead of printing it":
        # @req REQ-SCV-JJ-MUTATING-001
        step("Run a read through the sj lane inside the scratch repo")
        var lines = _prelude("sjlane")
        lines.push("sj() { SIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/sj/main.spl\" \"$@\"; }")
        lines.push("sj raw jj log --no-graph -r @ -T change_id.short\\(8\\) > log.out 2>log.err || echo sj-rc=$?")
        lines.push("echo \"sjlog=[$(cat log.out)]\"")
        step("Then a mutation through the sj lane, read back independently")
        lines.push("sj raw jj describe -m sj-lane-wrote-this >/dev/null 2>&1 || echo describe-rc=$?")
        lines.push("echo \"desc=[$(jj --no-pager --color never --ignore-working-copy log --no-graph -r @ -T description)]\"")
        val out = _run(lines)
        step("Verify sj returned a real change id, not the command string it used to echo")
        expect(out).to_contain("desc=[sj-lane-wrote-this]")
        expect(out.contains("sjlog=[jj ")).to_equal(false)
        expect(out.contains("--no-pager --color never")).to_equal(false)
        expect(out).to_contain("exit=0")
