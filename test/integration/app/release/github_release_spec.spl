"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/app/release/github_release_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spipe.*
use app.release.github.{
    basename, strip_upload_url_template, guess_content_type, build_release_payload
}


describe "GitHub release helpers":
    context "basename":
        it "returns the final path segment":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-APP-001
            step("Verify: returns the final path segment")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect basename("release/simple-bootstrap-1.0.0.spk") to_equal "simple-bootstrap-1.0.0.spk"

        it "returns the original text when no slash exists":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-APP-002
            step("Verify: returns the original text when no slash exists")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect basename("artifact.txt") to_equal "artifact.txt"

    context "strip_upload_url_template":
        it "removes github upload url templates":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-APP-003
            step("Verify: removes github upload url templates")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val raw = "https://uploads.github.com/repos/org/repo/releases/1/assets{?name,label}"
            expect strip_upload_url_template(raw) to_equal "https://uploads.github.com/repos/org/repo/releases/1/assets"

        it "keeps plain urls unchanged":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-APP-004
            step("Verify: keeps plain urls unchanged")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val raw = "https://uploads.github.com/repos/org/repo/releases/1/assets"
            expect strip_upload_url_template(raw) to_equal raw

    context "guess_content_type":
        it "detects text checksum files":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-APP-005
            step("Verify: detects text checksum files")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect guess_content_type("SHA256SUMS.txt") to_equal "text/plain; charset=utf-8"

        it "detects gzip-like bootstrap packages":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-APP-006
            step("Verify: detects gzip-like bootstrap packages")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect guess_content_type("simple-bootstrap-1.0.0.spk") to_equal "application/gzip"

        it "falls back to octet stream":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-APP-007
            step("Verify: falls back to octet stream")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect guess_content_type("simple-binary") to_equal "application/octet-stream"

    context "build_release_payload":
        it "includes required github release fields":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-APP-008
            step("Verify: includes required github release fields")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val payload = build_release_payload("v1.2.3", "Simple Language v1.2.3", "notes", "", false, false)
            expect payload to_contain "\"tag_name\": \"v1.2.3\""
            expect payload to_contain "\"name\": \"Simple Language v1.2.3\""
            expect payload to_contain "\"draft\": false"

        it "adds target_commitish when provided":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-APP-009
            step("Verify: adds target_commitish when provided")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val payload = build_release_payload("v1.2.3", "Simple", "notes", "abc123", false, true)
            expect payload to_contain "\"target_commitish\": \"abc123\""
            expect payload to_contain "\"prerelease\": true"
