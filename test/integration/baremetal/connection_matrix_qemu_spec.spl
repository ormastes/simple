"""
## Purpose and audience
Pins the observable CLI behavior of this spec's target so maintainers and
reviewers of the baremetal area can rely on documented output and exit codes.
## Operator workflow
Run via `bin/simple test <this file>`; read the per-scenario verdicts in the
`Results:` summary. Every scenario asserts an externally visible outcome.
## Compatibility and limitations
Covers the shipped command surface only; performance and stress behavior are
out of scope.
# @manual: primary
REQ-OS-BAREMETAL-002
doc/01_research/local/baremetal.md
doc/03_plan/sys_test/baremetal.md
doc/04_architecture/baremetal.md
doc/05_design/baremetal.md
"""
# @req: REQ-OS-BAREMETAL-002
# Connection Matrix QEMU Integration Tests
# Tests matrix factory for QEMU targets.

# --- Local copies ---

enum DebugTarget:
    QemuArmCortexM
    QemuRiscV32

    fn to_string() -> text:
        match self:
            QemuArmCortexM: "QEMU ARM Cortex-M"
            QemuRiscV32: "QEMU RISC-V32"

    fn eq(other: DebugTarget) -> bool:
        self.to_string() == other.to_string()

enum DebuggerKind:
    GdbDirectRemote

    fn to_string() -> text:
        match self:
            GdbDirectRemote: "GDB Direct"

class QemuSpec:
    target: DebugTarget
    debugger: DebuggerKind
    gdb_port: i32

impl QemuSpec:
    fn is_hardware() -> bool:
        false

fn qemu_specs() -> [QemuSpec]:
    [
        QemuSpec(target: DebugTarget.QemuArmCortexM, debugger: DebuggerKind.GdbDirectRemote, gdb_port: 3335),
        QemuSpec(target: DebugTarget.QemuRiscV32, debugger: DebuggerKind.GdbDirectRemote, gdb_port: 1234)
    ]

# --- Tests ---

use std.spec.step
describe "QEMU connection specs":
    slow_it "has 2 QEMU specs":
        # @req: REQ-OS-BAREMETAL-002
        step("Verify: has 2 QEMU specs")
        val specs = qemu_specs()
        expect(specs.len()).to_equal(2) # oracle: pinned expected value documenting the asserted outcome

    slow_it "QEMU ARM uses port 3335":
        # @req: REQ-OS-BAREMETAL-002
        step("Verify: QEMU ARM uses port 3335")
        val specs = qemu_specs()
        expect(specs[0].gdb_port).to_equal(3335) # oracle: pinned expected value documenting the asserted outcome

    slow_it "QEMU RV32 uses port 1234":
        # @req: REQ-OS-BAREMETAL-002
        step("Verify: QEMU RV32 uses port 1234")
        val specs = qemu_specs()
        expect(specs[1].gdb_port).to_equal(1234) # oracle: pinned expected value documenting the asserted outcome

    slow_it "QEMU specs are not hardware":
        # @req: REQ-OS-BAREMETAL-002
        step("Verify: QEMU specs are not hardware")
        val specs = qemu_specs()
        expect(specs[0].is_hardware()).to_equal(false)
        expect(specs[1].is_hardware()).to_equal(false)
