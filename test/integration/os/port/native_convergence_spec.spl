"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/os/port/native_convergence_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
## Stage2 == Stage3 convergence spec — IF-09 wave-3 scaffold.
##
## Pins the public API surface of `verify_native_convergence(stage2,
## stage3) -> Result<(), text>` exported by `bootstrap_native_verify.spl`.
## Wave-3 keeps this lint-only (SIMPLEOS_RUNTIME-gated). Wave-4 calls
## it from inside QEMU SimpleOS via the initramfs harness with real
## stage2/stage3 byte blobs pulled from the guest filesystem.
##
## Run:
##   bin/simple test test/integration/os/port/native_convergence_spec.spl

use std.spec

extern fn rt_env_get(key: text) -> text

fn simpleos_runtime() -> text:
    """Return the SIMPLEOS_RUNTIME env var, or empty string if unset."""
    val sr = rt_env_get("SIMPLEOS_RUNTIME")
    if sr == nil:
        ""
    else:
        sr

describe "IF-09 native-convergence contract":
    """
    Documents `verify_native_convergence(stage2, stage3) -> Result<(), text>`
    exported by `src/os/port/bootstrap_native_verify.spl`.

    Wave-3 byte-equality. Wave-4 replaces with ELF symbol-table compare
    via `count_symbols_matching`.
    """

    it "identical stage2 and stage3 blobs converge":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-OS-001
        step("Verify: identical stage2 and stage3 blobs converge")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        """
        IF-09 happy path: byte-identical inputs must return Ok(()).
        """
        val sr = simpleos_runtime()
        if sr == "":
            return "skip: SIMPLEOS_RUNTIME not set"
        val converged = 1
        converged.to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "differing stage2 and stage3 blobs diverge":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-OS-002
        step("Verify: differing stage2 and stage3 blobs diverge")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        """
        IF-09 reject path: differing bytes must produce Err with a
        non-empty diagnostic. Wave-4 asserts the diagnostic names the
        first diverging symbol.
        """
        val sr = simpleos_runtime()
        if sr == "":
            return "skip: SIMPLEOS_RUNTIME not set"
        val diverged = 1
        diverged.to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "verifier is callable without side effects":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-OS-003
        step("Verify: verifier is callable without side effects")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        """
        Pure: same inputs always produce same Result. Wave-4 tightens
        to no fs reads and no time-based branches.
        """
        val sr = simpleos_runtime()
        if sr == "":
            return "skip: SIMPLEOS_RUNTIME not set"
        val pure = 1
        pure.to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
