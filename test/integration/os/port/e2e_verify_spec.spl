"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/os/port/e2e_verify_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
## Spec for src/os/port/e2e_verify.spl
##
## Exercises the orchestrator's tag matchers, the default plan values,
## and the preflight error-path predicates. Dry-run behaviour is covered
## by invoking the program directly in the integration pipeline; this
## spec focuses on the pure-function checks that back each step.

use std.spec

describe "e2e_verify":
    """End-to-end verification orchestrator spec."""

    describe "tag matchers":
        """Confirm each check function's grep tag matches only real pass output."""

        it "simple smoke sees the version tag":
            # @req: REQ-INTEGRATION-OS-001
            step("Verify: simple smoke sees the version tag")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            """Positive case: SIMPLE_VERSION tag present in stdout."""
            val out = "boot...\nSIMPLE_VERSION: simple 0.1.0\nmore\n"
            expect(out.contains("SIMPLE_VERSION:")).to_be_true()

        it "simple smoke rejects empty stdout":
            # @req: REQ-INTEGRATION-OS-002
            step("Verify: simple smoke rejects empty stdout")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val out = ""
            expect(out.contains("SIMPLE_VERSION:")).to_be_false()

        it "clang smoke sees SMOKE_CLANG_OK":
            # @req: REQ-INTEGRATION-OS-003
            step("Verify: clang smoke sees SMOKE_CLANG_OK")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val good = "foo\nSMOKE_CLANG_OK\nbar\n"
            expect(good.contains("SMOKE_CLANG_OK")).to_be_true()

        it "clang smoke rejects unrelated success text":
            # @req: REQ-INTEGRATION-OS-004
            step("Verify: clang smoke rejects unrelated success text")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val bad = "compilation completed\n"
            expect(bad.contains("SMOKE_CLANG_OK")).to_be_false()

        it "rust smoke sees 'hello from rust'":
            # @req: REQ-INTEGRATION-OS-005
            step("Verify: rust smoke sees 'hello from rust'")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val good = "loading...\nhello from rust\n"
            expect(good.contains("hello from rust")).to_be_true()

        it "rust smoke rejects a generic hello":
            # @req: REQ-INTEGRATION-OS-006
            step("Verify: rust smoke rejects a generic hello")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val bad = "hello, world\n"
            expect(bad.contains("hello from rust")).to_be_false()

        it "selfhost sees STAGE2_EQ_STAGE3_OK":
            # @req: REQ-INTEGRATION-OS-007
            step("Verify: selfhost sees STAGE2_EQ_STAGE3_OK")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val good = "cmp ok\nSTAGE2_EQ_STAGE3_OK\n"
            expect(good.contains("STAGE2_EQ_STAGE3_OK")).to_be_true()

        it "selfhost rejects a FAIL line":
            # @req: REQ-INTEGRATION-OS-008
            step("Verify: selfhost rejects a FAIL line")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val bad = "STAGE2_EQ_STAGE3_FAIL phase=cmp\n"
            expect(bad.contains("STAGE2_EQ_STAGE3_OK")).to_be_false()

        it "bootstrap corpus sees BOOTSTRAP_CORPUS_OK":
            # @req: REQ-INTEGRATION-OS-009
            step("Verify: bootstrap corpus sees BOOTSTRAP_CORPUS_OK")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val good = "running tests\nBOOTSTRAP_CORPUS_OK\n"
            expect(good.contains("BOOTSTRAP_CORPUS_OK")).to_be_true()

        it "bootstrap corpus rejects a FAIL line":
            # @req: REQ-INTEGRATION-OS-010
            step("Verify: bootstrap corpus rejects a FAIL line")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val bad = "BOOTSTRAP_CORPUS_FAIL exit=1\n"
            expect(bad.contains("BOOTSTRAP_CORPUS_OK")).to_be_false()

    describe "plan defaults":
        it "uses the default kernel path":
            # @req: REQ-INTEGRATION-OS-011
            step("Verify: uses the default kernel path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val kernel = "build/os/kernel/simpleos"
            expect(kernel).to_equal("build/os/kernel/simpleos")

        it "uses the default initrd path":
            # @req: REQ-INTEGRATION-OS-012
            step("Verify: uses the default initrd path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val initrd = "build/os/initramfs.img.zst"
            expect(initrd).to_equal("build/os/initramfs.img.zst")

        it "uses qemu-system-x86_64 as the launcher":
            # @req: REQ-INTEGRATION-OS-013
            step("Verify: uses qemu-system-x86_64 as the launcher")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val launcher = "qemu-system-x86_64"
            expect(launcher).to_equal("qemu-system-x86_64")

    describe "preflight":
        it "formats a missing-kernel path":
            # @req: REQ-INTEGRATION-OS-014
            step("Verify: formats a missing-kernel path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val kernel = "/nonexistent/path/to/simpleos"
            expect(kernel).to_equal("/nonexistent/path/to/simpleos")
