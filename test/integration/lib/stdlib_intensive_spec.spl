"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/lib/stdlib_intensive_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-INTEGRATION-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# # Standard Library Intensive Tests
#
#
# **Feature IDs:** #1011-1020
# **Category:** Testing
# **Difficulty:** 4/5
# **Status:** Implemented
#
# ## Overview
#
# Comprehensive integration testing of all stdlib modules working together.
# Tests realistic workflows using multiple stdlib components simultaneously.
#
# ## Key Concepts
#
# | Concept | Description |
# |---------|-------------|
# | Module Integration | Multiple stdlib modules working together |
# | Real Workflows | Practical use cases combining features |
# | Performance | Test under load with realistic data |
#
# ## Related Specifications
#
# - [Collections](../../src/lib/src/collections/) - Data structures
# - [String](../../src/lib/common/text.spl) - String operations
# - [Math](../../src/lib/src/math/) - Mathematical functions
# - [Path](../../src/lib/common/path.spl) - Path manipulation
#
# ## Examples
#
# ```simple
# # Multi-module workflow
# var data = read_file(path) |> parse_json |> validate
# ```

fn check(condition: bool):
    expect(condition).to_equal(true)
fn check_msg(condition: bool, message: text):
    if not condition:
        expect(message).to_equal("")


fn slow_it(name: text, block: fn()):
    it(name, block)

describe "String + Collections Integration - Intensive":
    # ## String and Collection Operations
    #
    # Test string processing with collection manipulation.
    
    context "text processing pipeline":
        slow_it "processes 1000 strings with split/join":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-001
            step("Verify: processes 1000 strings with split/join")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var lines = []
            for i in 0..1000:
                lines = lines + ["item_{i},value_{i},status_{i}"]
            
            # Split each line
            var processed = 0
            for line in lines:
                val parts = line.split(",")
                if parts.len() == 3:
                    processed = processed + 1
            
            check(processed == 1000)
            
        slow_it "builds text with array concatenation":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-002
            step("Verify: builds text with array concatenation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var words = []
            for i in 0..500:
                words = words + ["word{i}"]
            
            val text = words.join(" ")
            check(text.len() > 2000)
            check(text.contains("word0"))
            check(text.contains("word499"))
            
    context "filtering and transformation":
        slow_it "filters and maps 1000 items":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-003
            step("Verify: filters and maps 1000 items")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var items = []
            for i in 0..1000:
                items = items + [i]
            
            # Filter evens
            var evens = []
            for item in items:
                if item % 2 == 0:
                    evens = evens + [item]
            
            check(evens.len() == 500)
            
        slow_it "transforms strings to uppercase pattern":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-004
            step("Verify: transforms strings to uppercase pattern")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var words = ["hello", "world", "test", "simple"]
            
            var uppers = []
            for word in words:
                # Simulate uppercase (actual impl may vary)
                uppers = uppers + [word]
            
            check(uppers.len() == 4)


describe "Math + Collections Integration - Intensive":
    # ## Mathematical Operations on Collections
    #
    # Test math functions with large datasets.
    
    context "statistical operations":
        slow_it "computes sum of 1000 numbers":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-005
            step("Verify: computes sum of 1000 numbers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var numbers = []
            for i in 0..1000:
                numbers = numbers + [i]
            
            var sum = 0
            for n in numbers:
                sum = sum + n
            
            # Sum of 0..999 = 499500
            check(sum == 499500)
            
        slow_it "finds min/max in large dataset":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-006
            step("Verify: finds min/max in large dataset")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var numbers = []
            for i in 0..1000:
                val n = (i * 7) % 100  # Generate varied numbers
                numbers = numbers + [n]
            
            var min_val = 999999
            var max_val = -999999
            
            for n in numbers:
                if n < min_val:
                    min_val = n
                if n > max_val:
                    max_val = n
            
            check(min_val >= 0)
            check(max_val < 100)
            
    context "numeric transformations":
        slow_it "applies arithmetic to 500 items":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-007
            step("Verify: applies arithmetic to 500 items")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var values = []
            for i in 0..500:
                values = values + [i]
            
            # Square each value
            var squared = []
            for v in values:
                squared = squared + [v * v]
            
            check(squared.len() == 500)
            check(squared[0] == 0)
            check(squared[10] == 100)


describe "Path + String Integration - Intensive":
    # ## Path Manipulation and String Operations
    #
    # Test path handling with string processing.
    
    context "path construction":
        slow_it "builds 500 file paths":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-008
            step("Verify: builds 500 file paths")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var paths = []
            for i in 0..500:
                val path = "dir/subdir/file{i}.spl"
                paths = paths + [path]
            
            check(paths.len() == 500)
            check(paths[0].contains("file0.spl"))
            check(paths[499].contains("file499.spl"))
            
        slow_it "extracts components from paths":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-009
            step("Verify: extracts components from paths")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var paths = [
                "src/compiler/10.frontend/core/lexer.spl",
                "test/unit/std/string_spec.spl",
                "doc/07_guide/syntax.md"
            ]
            
            for path in paths:
                val has_slash = path.contains("/")
                check(has_slash)
                
                val parts = path.split("/")
                check(parts.len() >= 2)
                
    context "path validation":
        slow_it "validates 1000 path patterns":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-010
            step("Verify: validates 1000 path patterns")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var valid_count = 0
            
            for i in 0..1000:
                val path = "test/file{i}.txt"
                
                # Simple validation
                if path.contains("/") and path.contains("."):
                    valid_count = valid_count + 1
            
            check(valid_count == 1000)


describe "Multi-Module Workflow - Intensive":
    # ## Complete Workflow Integration
    #
    # Test realistic workflows using multiple stdlib modules.
    
    context "data processing pipeline":
        slow_it "processes CSV-like data end-to-end":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-011
            step("Verify: processes CSV-like data end-to-end")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Generate CSV data
            var csv_lines = []
            csv_lines = csv_lines + ["name,age,city"]
            
            for i in 0..100:
                val line = "user{i},{i + 20},city{i % 10}"
                csv_lines = csv_lines + [line]
            
            # Parse CSV
            var records = []
            for line in csv_lines:
                if line.contains("name"):  # Skip header
                    pass
                else:
                    val fields = line.split(",")
                    if fields.len() == 3:
                        records = records + [fields]
            
            check(records.len() == 100)
            
        slow_it "aggregates data by category":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-012
            step("Verify: aggregates data by category")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var data = []
            for i in 0..200:
                val category = i % 5
                data = data + [category]
            
            # Count by category
            var counts = [0, 0, 0, 0, 0]
            for item in data:
                if item >= 0 and item < 5:
                    counts[item] = counts[item] + 1
            
            # Each category should have 40 items
            for count in counts:
                check(count == 40)
                
    context "text analysis workflow":
        slow_it "analyzes 500 text documents":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-013
            step("Verify: analyzes 500 text documents")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var docs = []
            for i in 0..500:
                val doc = "Document {i} contains multiple words and numbers like {i * 2}"
                docs = docs + [doc]
            
            var word_count = 0
            for doc in docs:
                var words = doc.split(" ")
                word_count = word_count + words.len()
            
            check(word_count > 3000)
            
        slow_it "filters and sorts text data":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-014
            step("Verify: filters and sorts text data")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var items = []
            for i in 0..300:
                if i % 3 == 0:
                    items = items + ["special_{i}"]
                else:
                    items = items + ["regular_{i}"]
            
            # Filter special items
            var special = []
            for item in items:
                if item.contains("special"):
                    special = special + [item]
            
            check(special.len() == 100)


describe "Collections Stress Test - Intensive":
    # ## Collection Performance Testing
    #
    # Stress test collection operations with large datasets.
    
    context "array operations":
        slow_it "appends 2000 items":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-015
            step("Verify: appends 2000 items")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var arr = []
            for i in 0..2000:
                arr = arr + [i]
            
            check(arr.len() == 2000)
            check(arr[0] == 0)
            check(arr[1999] == 1999)
            
        slow_it "concatenates arrays repeatedly":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-016
            step("Verify: concatenates arrays repeatedly")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var base = [1, 2, 3]
            var result = []
            
            for i in 0..100:
                for item in base:
                    result = result + [item]
            
            check(result.len() == 300)
            
    context "nested collections":
        slow_it "handles nested arrays":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-017
            step("Verify: handles nested arrays")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var matrix = []
            for row in 0..50:
                var row_data = []
                for col in 0..50:
                    row_data = row_data + [row * 50 + col]
                matrix = matrix + [row_data]
            
            check(matrix.len() == 50)
            check(matrix[0].len() == 50)
            
        slow_it "processes nested data structures":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-018
            step("Verify: processes nested data structures")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var groups = []
            for g in 0..10:
                var items = []
                for i in 0..20:
                    items = items + [g * 100 + i]
                groups = groups + [items]

            # Flatten
            var flattened = []
            for group in groups:
                for item in group:
                    flattened = flattened + [item]

            check(flattened.len() == 200)


describe "String Operations Stress Test - Intensive":
    # ## String Performance Testing
    #
    # Test string operations under load.
    
    context "string building":
        slow_it "concatenates 500 strings":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-019
            step("Verify: concatenates 500 strings")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var parts: [text] = []
            for i in 0..500:
                parts = parts + ["item{i},"]
            val result = parts.join("")

            check(result.len() > 2500)
            
        slow_it "splits and rejoins strings":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-020
            step("Verify: splits and rejoins strings")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var original = "a,b,c,d,e,f,g,h,i,j"
            
            for i in 0..100:
                val parts = original.split(",")
                val rejoined = parts.join(",")
                check(rejoined == original)
                
    context "pattern matching":
        slow_it "searches in 1000 strings":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-021
            step("Verify: searches in 1000 strings")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var matches = 0
            
            for i in 0..1000:
                val text = "test_string_{i}_with_pattern"
                if text.contains("pattern"):
                    matches = matches + 1
            
            check(matches == 1000)
            
        slow_it "extracts substrings repeatedly":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-022
            step("Verify: extracts substrings repeatedly")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val text = "0123456789abcdefghij"
            
            var extracts = []
            for i in 0..10:
                if i + 5 <= text.len():
                    val substr = text[i..i+5]
                    extracts = extracts + [substr]
            
            check(extracts.len() == 10)


# Helper functions

fn generate_test_data(count: i64) -> [i64]:
    var data = []
    for i in 0..count:
        data = data + [i]
    data

fn sum_array(arr: [i64]) -> i64:
    var total = 0
    for item in arr:
        total = total + item
    total
