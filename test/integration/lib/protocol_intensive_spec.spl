    context "key existence checks":
        slow_it "detects existing keys":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-052
            step("Verify: detects existing keys")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val json = jobj([
                jpair("name", jstr("Alice")),
                jpair("age", jnum(30))
            ])

            check(json_contains_key(json, "name"))
            check(json_contains_key(json, "age"))

        slow_it "detects missing keys":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-053
            step("Verify: detects missing keys")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val json = jobj([jpair("name", jstr("Alice"))])

            check(not json_contains_key(json, "nonexistent"))

        slow_it "handles nested keys":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-054
            step("Verify: handles nested keys")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val nested = jobj([
                jpair("user", jobj([
                    jpair("name", jstr("Alice"))
                ]))
            ])

            check(json_contains_key(nested, "user"))
            check(json_contains_key(nested, "name"))
