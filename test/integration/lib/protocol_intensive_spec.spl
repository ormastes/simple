"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/lib/protocol_intensive_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# MCP Protocol Intensive Testing
# Comprehensive tests for JSON-RPC protocol, request/response handling
# NOTE: Removed unused imports (std.io.file, src.app.mcp.main) that
# trigger "cannot convert dict to int" during module evaluation.


use test.perf.intensive.helpers.mcp_fixtures
use std.spec.{step}
fn check(condition: bool):
    expect(condition).to_equal(true)
fn check_msg(condition: bool, message: text):
    if not condition:
        expect(message).to_equal("")


fn slow_it(name: text, block: fn()):
    it(name, block)

describe "MCP Protocol - Intensive":
    context "initialization":
        slow_it "handles initialize request correctly":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-001
            step("Verify: handles initialize request correctly")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val request = build_initialize_request(1)

            # Request should be valid JSON
            check(request.?)
            check(json_contains(request, "initialize"))
            check(json_contains(request, "protocolVersion"))

        slow_it "validates protocol version":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-002
            step("Verify: validates protocol version")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val request = build_initialize_request(1)

            check(json_contains(request, "2024-11-05"))

        slow_it "includes client info":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-003
            step("Verify: includes client info")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val request = build_initialize_request(1)

            check(json_contains(request, "clientInfo"))
            check(json_contains(request, "test-client"))

        slow_it "includes capabilities":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-004
            step("Verify: includes capabilities")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val request = build_initialize_request(1)

            check(json_contains(request, "capabilities"))

        slow_it "has correct JSON-RPC version":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-005
            step("Verify: has correct JSON-RPC version")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val request = build_initialize_request(1)

            assert_valid_json_rpc(request)

    context "resources/list requests":
        slow_it "builds valid resources/list request":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-006
