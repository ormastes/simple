"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/lib/std/screenshot/screenshot_sffi_extern_dispatch_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Screenshot SFFI extern dispatch coverage
#
# Defect class: an `rt_*` symbol implemented in the Rust runtime and listed in
# runtime_symbols.rs, but with no handler under
# src/compiler_rust/compiler/src/interpreter_extern/, makes the interpret lane
# (which `bin/simple test` uses) fail closed with
# `semantic: unknown extern function: <name>`.
#
# This spec drives every std.spec.screenshot wrapper so that a missing handler
# for any rt_screenshot_* extern fails here rather than only in the one spec
# that happens to touch it.

use std.spec.*
use std.spec.screenshot.*

describe "Screenshot SFFI extern dispatch":
    context "every wrapped rt_screenshot_* extern dispatches":
        it "dispatches the enable/disable/query externs":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-001
            step("Verify: dispatches the enable/disable/query externs")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            enable_sffi_screenshots()
            expect is_sffi_screenshots_enabled() == true
            disable_sffi_screenshots()
            expect is_sffi_screenshots_enabled() == false

        it "dispatches the refresh extern":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-002
            step("Verify: dispatches the refresh extern")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            set_sffi_refresh(true)
            set_sffi_refresh(false)
            expect is_sffi_screenshots_enabled() == false

        it "dispatches the output-dir and context externs":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-003
            step("Verify: dispatches the output-dir and context externs")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            set_sffi_output_dir("build/screenshot_sffi_dispatch")
            set_sffi_test_context("test/dispatch/spec.spl", "dispatch case")
            val path = get_screenshot_path_sffi(CAPTURE_TYPE_BEFORE)
            expect path.contains("dispatch") == true
            clear_sffi_test_context()

        it "dispatches the capture and clear externs":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-004
            step("Verify: dispatches the capture and clear externs")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            enable_sffi_screenshots()
            set_sffi_refresh(true)
            set_sffi_output_dir("build/screenshot_sffi_dispatch")
            set_sffi_test_context("test/dispatch/spec.spl", "capture case")
            expect capture_before_sffi("before-buffer") == true
            expect capture_after_sffi("after-buffer") == true
            clear_sffi_captures()
            clear_sffi_test_context()
            disable_sffi_screenshots()

        it "dispatches the exists extern for a missing capture":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-005
            step("Verify: dispatches the exists extern for a missing capture")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            set_sffi_test_context("test/dispatch/never_captured.spl", "absent case")
            val found = screenshot_exists_ffi(CAPTURE_TYPE_AFTER)
            expect found == false
            clear_sffi_test_context()
