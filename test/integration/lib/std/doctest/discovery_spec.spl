"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/lib/std/doctest/discovery_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Integration tests for doctest discovery
# Tests DiscoveryConfig and discovery functions

use std.doctest.discovery.*
use std.doctest.parser.DoctestExample
use std.spec.{step}

describe "DiscoveryConfig":
    context "default configuration":
        it "has default search paths":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-001
            step("Verify: has default search paths")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = DiscoveryConfig.default()
            expect config.get_search_paths().len() to_be 3
            expect config.has_search_path("lib/") to_be true
            expect config.has_search_path("src/") to_be true
            expect config.has_search_path("doc/") to_be true

        it "has default include patterns":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-002
            step("Verify: has default include patterns")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = DiscoveryConfig.default()
            val patterns = config.get_include_patterns()
            expect patterns.len() to_be 3

        it "has default exclude patterns":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-003
            step("Verify: has default exclude patterns")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = DiscoveryConfig.default()
            val patterns = config.get_exclude_patterns()
            expect patterns.len() to_be 2

    context "configuration modification":
        it "adds search path":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-004
            step("Verify: adds search path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = DiscoveryConfig.default()
                .add_search_path("tests/")
            expect config.has_search_path("tests/") to_be true
            expect config.get_search_paths().len() to_be 4

        it "adds include pattern":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-005
            step("Verify: adds include pattern")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = DiscoveryConfig.default()
                .add_include_pattern("**/*.rst")
            val patterns = config.get_include_patterns()
            expect patterns.len() to_be 4

        it "adds exclude pattern":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-006
            step("Verify: adds exclude pattern")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = DiscoveryConfig.default()
                .add_exclude_pattern("**/cache/**")
            val patterns = config.get_exclude_patterns()
            expect patterns.len() to_be 3

    context "summary":
        it "provides configuration summary":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-007
            step("Verify: provides configuration summary")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = DiscoveryConfig.default()
            val summary = config.summary()
            expect summary.contains("search paths") to_be true
            expect summary.contains("include patterns") to_be true
            expect summary.contains("exclude patterns") to_be true

describe "File Discovery":
    context "discover_file function":
        it "returns empty list for unknown extensions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-008
            step("Verify: returns empty list for unknown extensions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val found = discover_file("unknown.xyz")
            expect found.len() to_be 0

        it "recognizes spl files":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-009
            step("Verify: recognizes spl files")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val found = discover_file("test.spl")
            expect found.is_list() to_be true

        it "recognizes md files":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-010
            step("Verify: recognizes md files")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val found = discover_file("test.md")
            expect found.is_list() to_be true

describe "Pattern Matching":
    context "should_exclude function":
        it "excludes paths matching target pattern":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-011
            step("Verify: excludes paths matching target pattern")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val exclude_patterns = ["**/target/**"]
            expect should_exclude("project/target/debug/test.spl", exclude_patterns) to_be true

        it "does not exclude non-matching paths":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-012
            step("Verify: does not exclude non-matching paths")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val exclude_patterns = ["**/target/**", "**/build/**"]
            expect should_exclude("src/lib/module.spl", exclude_patterns) to_be false

    context "matches_any_pattern function":
        it "matches spl files":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-013
            step("Verify: matches spl files")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val include_patterns = ["**/*.spl"]
            expect matches_any_pattern("src/module.spl", include_patterns) to_be true

        it "does not match non-matching extensions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-014
            step("Verify: does not match non-matching extensions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val include_patterns = ["**/*.spl"]
            expect matches_any_pattern("src/module.rs", include_patterns) to_be false

describe "Full Discovery":
    context "discover_all function":
        it "returns a list":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-015
            step("Verify: returns a list")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = DiscoveryConfig.default()
            val found = discover_all(config)
            expect found.is_list() to_be true
