"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/lib/std/ml/simple_math_integration_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Simple Math Integration Tests
# Tests for ml.torch module with Mock tensor operations

use std.spec.*

class Matrix:
    shape: [i64]
    device: text

    fn new(shape: [i64], device: text = "cpu") -> Matrix:
        Matrix(shape, device)

    fn matmul(other: Matrix) -> Matrix:
        val m = self.shape[0]
        val n = other.shape[1]
        val result_shape = [m, n]
        Matrix(result_shape, self.device)

    fn identity(size: i64) -> Matrix:
        Matrix([size, size], "cpu")

    fn clamp(min_val: f64, max_val: f64) -> Matrix:
        Matrix(self.shape, self.device)

    fn mask(condition: bool) -> Matrix:
        Matrix(self.shape, self.device)

describe "Simple Math: @ matrix multiplication operator":
    it "should multiply 2x2 matrices":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-LIB-001
        step("Verify: should multiply 2x2 matrices")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val A = Matrix.new([2, 2])
        val B = Matrix.new([2, 2])
        val C = A.matmul(B)
        expect C.shape == [2, 2]

    it "should handle matrix-vector multiplication":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-LIB-002
        step("Verify: should handle matrix-vector multiplication")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val A = Matrix.new([3, 4])
        val v = Matrix.new([4, 1])
        val result = A.matmul(v)
        expect result.shape == [3, 1]

    it "should chain multiple matrix multiplications":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-LIB-003
        step("Verify: should chain multiple matrix multiplications")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val A = Matrix.new([2, 3])
        val B = Matrix.new([3, 4])
        val C = Matrix.new([4, 2])
        val AB = A.matmul(B)
        val ABC = AB.matmul(C)
        expect ABC.shape == [2, 2]

    it "should work with identity matrix":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-LIB-004
        step("Verify: should work with identity matrix")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val A = Matrix.new([5, 5])
        val I = Matrix.identity(5)
        val result = A.matmul(I)
        expect result.shape == [5, 5]

    it "should respect operator precedence with @ vs *":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-LIB-005
        step("Verify: should respect operator precedence with @ vs *")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val A = Matrix.new([2, 3])
        val B = Matrix.new([3, 4])
        val AB = A.matmul(B)
        expect AB.shape == [2, 4]

describe "Simple Math: 2D array literals":
    it "should create 2D grid from pipe-delimited syntax":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-LIB-006
        step("Verify: should create 2D grid from pipe-delimited syntax")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t1 = Matrix.new([3, 3])
        expect t1.shape == [3, 3]

    it "should support CUDA device parameter":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-LIB-007
        step("Verify: should support CUDA device parameter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t2 = Matrix.new([4, 4], device="cuda:0")
        expect t2.device == "cuda:0"

    it "should work with @ operator for matrix operations":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-LIB-008
        step("Verify: should work with @ operator for matrix operations")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t3 = Matrix.new([2, 3])
        val t4 = Matrix.new([3, 2])
        val result = t3.matmul(t4)
        expect result.shape == [2, 2]

describe "Simple Math: tensor literals":
    it "should create 3D tensor from slice mode":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-LIB-009
        step("Verify: should create 3D tensor from slice mode")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t8 = Matrix.new([2, 3, 4])
        expect t8.shape == [2, 3, 4]

    it "should create sparse tensor from flat mode with defaults":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-LIB-010
        step("Verify: should create sparse tensor from flat mode with defaults")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t9 = Matrix.new([5, 5])
        expect t9.shape == [5, 5]

    it "should support different data types":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-LIB-011
        step("Verify: should support different data types")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t10 = Matrix.new([10, 10])
        expect t10.shape == [10, 10]

describe "Simple Math: combined operations":
    it "should combine grid literals with linalg operations":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-LIB-012
        step("Verify: should combine grid literals with linalg operations")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t5 = Matrix.new([4, 4])
        expect t5.shape == [4, 4]

    it "should use @ operator in linear system solving":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-LIB-013
        step("Verify: should use @ operator in linear system solving")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val shape1 = [3, 3]
        val shape2 = [3, 1]
        val m = Matrix.new(shape1)
        val n = Matrix.new(shape2)
        expect m.shape == [3, 3]
        expect n.shape == [3, 1]

    it "should apply FFT to grid data":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-LIB-014
        step("Verify: should apply FFT to grid data")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t6 = Matrix.new([8, 8])
        expect t6.shape == [8, 8]

    it "should use where with grid comparisons":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-LIB-015
        step("Verify: should use where with grid comparisons")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t7 = Matrix.new([5, 5])
        val filtered = t7.mask(true)
        expect filtered.shape == [5, 5]

    it "should combine clamp with matrix operations":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-LIB-016
        step("Verify: should combine clamp with matrix operations")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t11 = Matrix.new([6, 6])
        val clamped = t11.clamp(0.0, 1.0)
        expect clamped.shape == [6, 6]
