"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/lib/std/improvements/stdlib_improvements_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Standard Library Improvement Tests
# Tests for stdlib improvements documented in simple/improve_request.md
#
# Tests marked with `it` are WORKING features.
# Tests marked with `skip` are NOT YET IMPLEMENTED.

use std.spec.*

# Mock File System for testing
class MockFileSystem:
    files: text
    dirs: text

impl MockFileSystem:
    static fn create() -> MockFileSystem:
        MockFileSystem(files: "/tmp/test.txt,/etc/hostname", dirs: "/tmp,/etc")

    fn read_file(path: text) -> text:
        if path == "/tmp/test.txt":
            "Hello, World!"
        else:
            ""

    fn read_bytes(path: text) -> [i32]:
        if path == "/tmp/test.txt":
            [72, 101, 108, 108, 111]
        else:
            []

    fn read_lines(path: text) -> [text]:
        if path == "/tmp/test.txt":
            ["line1", "line2", "line3"]
        else:
            []

    fn write_file(path: text, content: text) -> bool:
        path.len() > 0 and content.len() >= 0

    fn write_bytes(path: text, data: [i32]) -> bool:
        path.len() > 0

    fn append_file(path: text, content: text) -> bool:
        path.len() > 0

    fn path_exists(path: text) -> bool:
        self.files.contains(path) or self.dirs.contains(path)

    fn is_file(path: text) -> bool:
        self.files.split(",").contains(path)

    fn is_dir(path: text) -> bool:
        self.dirs.contains(path)

    fn file_size(path: text) -> i32:
        if path == "/tmp/test.txt":
            13
        else:
            0

    fn list_dir(path: text) -> [text]:
        if path == "/tmp":
            ["test.txt", "other.txt"]
        else:
            []

    fn create_dir(path: text) -> bool:
        path.len() > 0

    fn remove_file(path: text) -> bool:
        self.files.contains(path)

    fn remove_dir(path: text) -> bool:
        self.dirs.contains(path)

# Mock JSON for testing
class MockJson:
    data: text

impl MockJson:
    static fn from_json(s: text) -> MockJson:
        MockJson(data: s)

    fn get(key: text) -> text:
        key

    fn is_object() -> bool:
        self.data.starts_with("object:")

    fn is_array() -> bool:
        self.data.starts_with("array:")

    static fn to_json(obj: text) -> text:
        "json:" + obj

    static fn escape(s: text) -> text:
        "escaped:" + s

# Mock JSON Builder
class MockJsonBuilder:
    content: text

impl MockJsonBuilder:
    static fn object() -> MockJsonBuilder:
        MockJsonBuilder(content: "object:empty")

    static fn array() -> MockJsonBuilder:
        MockJsonBuilder(content: "array:empty")

    me add(key: text, value: text) -> MockJsonBuilder:
        self.content = "object:" + key + "=" + value
        self

    me append(value: text) -> MockJsonBuilder:
        self.content = "array:" + value
        self

    fn build() -> text:
        self.content

describe "text Method Improvements":

    context "Substring Operations":
        it "substring extracts range":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-001
            step("Verify: substring extracts range")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val text = "hello world"
            expect text.substring(start=0, end=5) == "hello"

        it "substr extracts with length":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-002
            step("Verify: substr extracts with length")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val text = "hello world"
            expect text.substr(start=6, length=5) == "world"

        it "char_at gets single character":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-003
            step("Verify: char_at gets single character")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val text = "hello"
            expect text.char_at(0) == "h"
            expect text.char_at(4) == "o"

        it "chars returns list of characters":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-004
            step("Verify: chars returns list of characters")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val text = "abc"
            val chars = text.chars()
            expect chars.len() == 3
            expect chars[0] == "a"

    context "Search Operations":
