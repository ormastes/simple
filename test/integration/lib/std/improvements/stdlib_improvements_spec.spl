        it "join combines list with delimiter":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-018
            step("Verify: join combines list with delimiter")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val parts = ["a", "b", "c"]
            expect ",".join(parts) == "a,b,c"

        it "lines splits by newlines":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-019
            step("Verify: lines splits by newlines")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val text = "line1\nline2\nline3"
            val lines = text.lines()
            expect lines.len() == 3

        it "lines aliases preserve Rust-compatible edge cases":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-020
            step("Verify: lines aliases preserve Rust-compatible edge cases")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect "".lines().len() == 0
            expect "".split_lines().len() == 0
            val crlf = "a\r\nb".lines()
            expect crlf.len() == 2
            expect crlf[0] == "a"
            expect crlf[1] == "b"
            val trailing = "a\n\n".split_lines()
            expect trailing.len() == 2
            expect trailing[1] == ""
            val lone_cr = "a\rb".lines()
            expect lone_cr.len() == 1
            expect lone_cr[0] == "a\rb"

    context "Replacement":
        it "replace replaces all occurrences":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-LIB-021
            step("Verify: replace replaces all occurrences")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val text = "hello hello"
            expect text.replace(old="hello", new="hi") == "hi hi"

        it "replace_first replaces first occurrence":
