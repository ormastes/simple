# @req: REQ-SYS-BuildTestIntegration-001
# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%

use std.spec

describe "BuildTestIntegration subsystem spec execution contract":
    it "integer division and remainder follow truncation":
        step("Verify: integer division and remainder follow truncation")
        # @req: REQ-SYS-BuildTestIntegration-001
        expect(17 / 5).to_equal(3) # oracle: truncated quotient
        expect(17 % 5).to_equal(2) # oracle: remainder

    it "arithmetic precedence binds multiplication before addition":
        step("Verify: arithmetic precedence binds multiplication before addition")
        # @req: REQ-SYS-BuildTestIntegration-002
        expect(2 + 3 * 4).to_equal(14) # oracle: precedence, not left-to-right (would be 20)
        expect((2 + 3) * 4).to_equal(20) # oracle: parenthesised grouping

    it "loop accumulation sums the inclusive range 0..4":
        step("Verify: loop accumulation sums the inclusive range 0..4")
        # @req: REQ-SYS-BuildTestIntegration-003
        var total = 0
        for i in 0..5:
            total = total + i
        expect(total).to_equal(10) # oracle: 0+1+2+3+4 = 10

    it "nested collection read goes through both keys":
        step("Verify: nested collection read goes through both keys")
        # @req: REQ-SYS-BuildTestIntegration-004
        val table = {"outer": {"inner": 9}}
        expect(table["outer"]["inner"]).to_equal(9) # oracle: nested lookup path

    it "array push grows length and preserves order":
        step("Verify: array push grows length and preserves order")
        # @req: REQ-SYS-BuildTestIntegration-005
        var xs = [10]
        xs.push(20)
        xs.push(30)
        expect(xs.len()).to_equal(3) # oracle: 1 initial + 2 pushes
        expect(xs[1]).to_equal(20) # oracle: FIFO order preserved

