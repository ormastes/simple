"""
Executable HIR type transport regression.

Each declared HirTypeKind is encoded and decoded through the generated HIR
codec, then installed in a real fixture function.  The fixture is walked by
post_mono_verify and lowered through the MIR backend so a transport test cannot
pass by checking only an empty module or only the unreachable counter.  This
is pure in-process evidence and makes no Rust-seed PASS claim.
"""

use std.spec
use std.io_runtime.{file_read, file_exists}
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.statements.*
use compiler.hir.hir_types.{
    HirModule, HirType, HirTypeKind, SymbolId, DimExpr, DimExprKind, DeviceType
}
use compiler.hir.hir_codec_support.{HirCodecWriter}
use compiler.hir.generated.hir_codec.{hc_enc_hir_type, hc_dec_hir_type}
use compiler.verify.post_mono_verify.{post_mono_verify}
use compiler.mir.mir_lowering.{MirLowering}

extern fn rt_enum_discriminant(value: Any) -> i64

val FIXTURE = "test/fixtures/compiler/hirtype_signature_transport_minimal.spl"

fn span() -> Span:
    Span.empty()

fn scalar() -> HirType:
    HirType(kind: HirTypeKind.Int(64, true), span: span())

fn text_type() -> HirType:
    HirType(kind: HirTypeKind.Str, span: span())

fn dim() -> DimExpr:
    DimExpr(kind: DimExprKind.Literal(1), span: span())

fn discriminant(value: Any) -> i64:
    unsafe(capabilities: [ffi]):
        rt_enum_discriminant(value)

fn samples() -> [HirType]:
    [
        HirType(kind: HirTypeKind.Int(64, true), span: span()),
        HirType(kind: HirTypeKind.Float(64), span: span()),
        HirType(kind: HirTypeKind.Bool, span: span()),
        HirType(kind: HirTypeKind.Char, span: span()),
        text_type(),
        HirType(kind: HirTypeKind.Unit, span: span()),
        HirType(kind: HirTypeKind.Tuple([scalar()]), span: span()),
        HirType(kind: HirTypeKind.Array(scalar(), nil), span: span()),
        HirType(kind: HirTypeKind.Slice(scalar()), span: span()),
        HirType(kind: HirTypeKind.Dict(scalar(), text_type()), span: span()),
        HirType(kind: HirTypeKind.Ref(scalar(), false), span: span()),
        HirType(kind: HirTypeKind.Ptr(scalar(), false), span: span()),
        HirType(kind: HirTypeKind.Optional(scalar()), span: span()),
        HirType(kind: HirTypeKind.Result(scalar(), text_type()), span: span()),
        HirType(kind: HirTypeKind.Named(SymbolId(id: 7), []), span: span()),
        HirType(kind: HirTypeKind.TypeParam("T", []), span: span()),
        HirType(kind: HirTypeKind.Union([scalar(), text_type()]), span: span()),
        HirType(kind: HirTypeKind.DynTrait(SymbolId(id: 8)), span: span()),
        HirType(kind: HirTypeKind.Function([scalar()], text_type(), []), span: span()),
        HirType(kind: HirTypeKind.Projection(scalar(), "Item"), span: span()),
        HirType(kind: HirTypeKind.Isolated(scalar()), span: span()),
        HirType(kind: HirTypeKind.Infer(1, 0), span: span()),
        HirType(kind: HirTypeKind.Error, span: span()),
        HirType(kind: HirTypeKind.Never, span: span()),
        HirType(kind: HirTypeKind.Any, span: span()),
        HirType(kind: HirTypeKind.Tensor(scalar(), [dim()], Some(DeviceType.CPU)), span: span()),
        HirType(kind: HirTypeKind.Layer([dim()], [dim()]), span: span())
    ]

fn type_param_type() -> HirType:
    HirType(kind: HirTypeKind.TypeParam("T", []), span: span())

fn projection_type() -> HirType:
    HirType(kind: HirTypeKind.Projection(scalar(), "Item"), span: span())

fn nil_error_tuple_type() -> HirType:
    HirType(kind: HirTypeKind.Tuple([nil, HirType(kind: HirTypeKind.Error, span: span())]), span: span())

fn nested_transport_type() -> HirType:
    HirType(kind: HirTypeKind.Tuple([type_param_type(), projection_type()]), span: span())

fn roundtrip(type_: HirType) -> HirType:
    var writer = HirCodecWriter.create()
    hc_enc_hir_type(writer, type_)
    expect(writer.ok).to_equal(true)
    val decoded = hc_dec_hir_type(FlatPoolReader.new(writer.finish()))
    expect(decoded != nil).to_equal(true)
    decoded

fn lowered_fixture() -> HirModule:
    if not file_exists(FIXTURE):
        fail("required transport fixture missing: {FIXTURE}")
        return nil
    val parsed = parse_full_frontend(
        file_read(FIXTURE), FIXTURE, "hirtype_signature_transport_minimal", Logger(level: 0))
    var lowering = HirLowering.with_filename(FIXTURE)
    lowering.lower_module(parsed)

fn carry_type_count(module: HirModule) -> i64:
    var count = 0
    for symbol in module.functions.keys():
        if module.functions[symbol].name == "carry_type":
            count = count + 1
    count

fn with_transport_type(module: HirModule, type_: HirType) -> HirModule:
    var injected = 0
    for symbol in module.functions.keys():
        var function_ = module.functions[symbol]
        if function_.name == "carry_type":
            injected = injected + 1
            function_.return_type = type_
            var params = function_.params
            if params.len() == 1:
                var first = params[0]
                first.type_ = type_
                params[0] = first
                function_.params = params
            module.functions[symbol] = function_
    expect(injected).to_equal(1)
    module

describe "HIR type transport through post-mono verification [importance=critical; importance_weight=3]":
    it "round-trips every producer variant and reaches the named verifier arm":
        step("Encode/decode every HirTypeKind tag before post-mono verification")
        expect(file_exists(FIXTURE)).to_equal(true)
        val fixture = lowered_fixture()
        expect(carry_type_count(fixture)).to_be_greater_than(0)
        expect(carry_type_count(fixture)).to_equal(1)
        val all_types = samples()
        expect(all_types.len()).to_equal(27)
        var i = 0
        while i < all_types.len():
            val original = all_types[i]
            val decoded = roundtrip(original)
            expect(decoded.kind != nil).to_equal(true)
            expect(discriminant(decoded.kind)).to_equal(discriminant(original.kind))
            val module = with_transport_type(lowered_fixture(), decoded)
            val report = post_mono_verify(module)
            expect(report.unreachable_variant).to_equal(0)
            i = i + 1

    it "counts nested generic residues and preserves nil-before-error payload order":
        val decoded = roundtrip(nil_error_tuple_type())
        match decoded.kind:
            case HirTypeKind.Tuple(elements):
                expect(elements.len()).to_equal(2)
                expect(elements[0] == nil).to_equal(true)
                expect(elements[1] != nil).to_equal(true)
                expect(discriminant(elements[1].kind)).to_equal(discriminant(HirTypeKind.Error))
            case _:
                fail("nil/error transport fixture did not decode as a tuple")
        val nil_error_report = post_mono_verify(with_transport_type(lowered_fixture(), decoded))
        expect(nil_error_report.unreachable_variant).to_equal(0)
        expect(nil_error_report.error_from_substitution).to_equal(0)

        val type_param_report = post_mono_verify(
            with_transport_type(lowered_fixture(), roundtrip(type_param_type())))
        expect(type_param_report.unresolved_type_param).to_equal(2)
        expect(type_param_report.unresolved_projection).to_equal(0)
        expect(type_param_report.violations.len()).to_equal(2)

        val projection_report = post_mono_verify(
            with_transport_type(lowered_fixture(), roundtrip(projection_type())))
        expect(projection_report.unresolved_type_param).to_equal(0)
        expect(projection_report.unresolved_projection).to_equal(2)
        expect(projection_report.violations.len()).to_equal(2)

        val nested_report = post_mono_verify(
            with_transport_type(lowered_fixture(), roundtrip(nested_transport_type())))
        expect(nested_report.unresolved_type_param).to_equal(2)
        expect(nested_report.unresolved_projection).to_equal(2)
        expect(nested_report.violations.len()).to_equal(4)

    it "hands the transported fixture to the MIR backend traversal":
        val module = with_transport_type(
            lowered_fixture(),
            roundtrip(HirType(kind: HirTypeKind.Tuple([scalar(), text_type()]), span: span())))
        var backend_functions = 0
        for symbol in module.functions.keys():
            val function_ = module.functions[symbol]
            if function_.name == "carry_type":
                backend_functions = backend_functions + 1
                var lowering = MirLowering.new(module.symbols)
                val mir_function = lowering.lower_function(function_)
                expect(mir_function.blocks.len()).to_be_greater_than(0)
                expect(mir_function.signature.params.len()).to_equal(1)
                expect(lowering.errors.len()).to_equal(0)
        expect(backend_functions).to_equal(1)
