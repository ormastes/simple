"""
## Purpose and audience
Pins the observable execution contract of the LexerParserIntegration subsystem spec lane
(lexer_parser_integration_1_spec.spl): every scenario asserts a concrete language/stdlib outcome the runner
must report green for this subsystem spec to carry evidence weight.
Audience: compiler and test-infrastructure engineers triaging the LexerParserIntegration lane.
## Operator workflow
Run `bin/simple test test/integration/e2e/lexer_parser_integration_1_spec.spl` and read the per-scenario verdicts in the
`Results:` summary; each scenario asserts one externally visible outcome.
## Compatibility and limitations
Covers interpreter-path semantics exercised by this lane; native codegen
and performance envelopes are out of scope.
# @manual: primary
REQ-SYS-LexerParserIntegration-001
doc/01_research/local/LexerParserIntegration_lane.md
doc/03_plan/sys_test/LexerParserIntegration_lane.md
doc/04_architecture/LexerParserIntegration_lane.md
doc/05_design/LexerParserIntegration_lane.md
"""
# @req: REQ-SYS-LexerParserIntegration-001
# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%

use std.spec

describe "LexerParserIntegration subsystem spec execution contract":
    it "dict lookup returns the stored value per key":
        step("Verify: dict lookup returns the stored value per key")
        # @req: REQ-SYS-LexerParserIntegration-001
        val d = {"alpha": 1, "beta": 2}
        expect(d["beta"]).to_equal(2) # oracle: value stored under "beta"
        expect(d["alpha"]).to_equal(1)

    it "reversal via index walk yields the mirrored array":
        step("Verify: reversal via index walk yields the mirrored array")
        # @req: REQ-SYS-LexerParserIntegration-002
        val src = [1, 2, 3, 4]
        var rev = []
        var i = src.len() - 1
        while i >= 0:
            rev.push(src[i])
            i = i - 1
        expect(rev.len()).to_equal(4) # oracle: reversal preserves length
        expect(rev[0]).to_equal(4) # oracle: last becomes first
        expect(rev[3]).to_equal(1)

    it "boolean operators short-circuit to the pinned result":
        step("Verify: boolean operators short-circuit to the pinned result")
        # @req: REQ-SYS-LexerParserIntegration-003
        expect(true and false).to_equal(false)
        expect(true or false).to_equal(true)
        expect(not false).to_equal(true)

    it "string concatenation length is the sum of parts":
        step("Verify: string concatenation length is the sum of parts")
        # @req: REQ-SYS-LexerParserIntegration-004
        val joined = "foo" + "bar"
        expect(joined).to_equal("foobar")
        expect(joined.len()).to_equal(6) # oracle: 3 + 3 chars

    it "recursive factorial computes 5! exactly":
        step("Verify: recursive factorial computes 5! exactly")
        # @req: REQ-SYS-LexerParserIntegration-005
        fn fact(n: i64) -> i64:
            if n <= 1:
                return 1
            n * fact(n - 1)
        expect(fact(5)).to_equal(120) # oracle: 5! = 120
        expect(fact(0)).to_equal(1) # oracle: base case

