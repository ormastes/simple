"""
## Purpose and audience
Pins the observable execution contract of the LintFixIntegration subsystem spec lane
(lint_fix_integration_1_spec.spl): every scenario asserts a concrete language/stdlib outcome the runner
must report green for this subsystem spec to carry evidence weight.
Audience: compiler and test-infrastructure engineers triaging the LintFixIntegration lane.
## Operator workflow
Run `bin/simple test test/integration/e2e/lint_fix_integration_1_spec.spl` and read the per-scenario verdicts in the
`Results:` summary; each scenario asserts one externally visible outcome.
## Compatibility and limitations
Covers interpreter-path semantics exercised by this lane; native codegen
and performance envelopes are out of scope.
# @manual: primary
REQ-SYS-LintFixIntegration-001
doc/01_research/local/LintFixIntegration_lane.md
doc/03_plan/sys_test/LintFixIntegration_lane.md
doc/04_architecture/LintFixIntegration_lane.md
doc/05_design/LintFixIntegration_lane.md
"""
# @req: REQ-SYS-LintFixIntegration-001
# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%

use std.spec

describe "LintFixIntegration subsystem spec execution contract":
    it "string concatenation length is the sum of parts":
        step("Verify: string concatenation length is the sum of parts")
        # @req: REQ-SYS-LintFixIntegration-001
        val joined = "foo" + "bar"
        expect(joined).to_equal("foobar")
        expect(joined.len()).to_equal(6) # oracle: 3 + 3 chars

    it "recursive factorial computes 5! exactly":
        step("Verify: recursive factorial computes 5! exactly")
        # @req: REQ-SYS-LintFixIntegration-002
        fn fact(n: i64) -> i64:
            if n <= 1:
                return 1
            n * fact(n - 1)
        expect(fact(5)).to_equal(120) # oracle: 5! = 120
        expect(fact(0)).to_equal(1) # oracle: base case

    it "split reports every separator occurrence":
        step("Verify: split reports every separator occurrence")
        # @req: REQ-SYS-LintFixIntegration-003
        val parts = "alpha,beta,gamma".split(",")
        expect(parts.len()).to_equal(3) # oracle: 2 separators split into 3 fields
        expect(parts[0]).to_equal("alpha")
        expect(parts[2]).to_equal("gamma")

    it "option match binds the carried payload":
        step("Verify: option match binds the carried payload")
        # @req: REQ-SYS-LintFixIntegration-004
        val opt = Some(41)
        match opt:
            Some(v):
                expect(v + 1).to_equal(42) # oracle: payload is 41
            nil:
                expect(false).to_equal(true) # oracle: nil arm must not run

    it "repetition via loop builds the expected run":
        step("Verify: repetition via loop builds the expected run")
        # @req: REQ-SYS-LintFixIntegration-005
        var run = ""
        for i in 0..4:
            run = run + "ab"
        expect(run.len()).to_equal(8) # oracle: 4 iterations x 2 chars
        expect(run).to_equal("abababab")

