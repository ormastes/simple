# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @session-kind: trace32_board
# @target: arm
# @tag: t32_hw, backend_config
# @reuse: exclusive_reused
"""
# T32 Backend: SDN Config File

Tests core T32 operations using the backend configured in t32_mcp.sdn.
Uses whatever backend_preference is set in the config file.
"""

use std.spec.step

use std.spipe.*
use test.integration.t32_hw.t32_hw_helpers.{
    t32_hw_probe_available, t32_hw_backend_preference
}
use test.integration.t32_hw.backends._shared_backend_tests.{
    shared_test_connect_and_ping, shared_test_eval_version,
    shared_test_cmd_run, shared_test_state_query,
    shared_test_register_read, shared_test_step_and_halt,
    shared_test_error_recovery
}

describe "T32 via config file backend":
    # @manual scenario evidence
    context "when SDN config is loaded":
        it "backend preference is set":
            # @req REQ-SSPEC-INTEGRATION
            step("backend preference is set")
            val pref = t32_hw_backend_preference()
            # May be empty (auto-detect) or a specific backend
            expect(pref.len() >= 0).to_equal(true)

        it "connects and pings":
            # @req REQ-SSPEC-INTEGRATION
            step("connects and pings")
            shared_test_connect_and_ping()

        it "evaluates VERSION.BUILD()":
            # @req REQ-SSPEC-INTEGRATION
            step("evaluates VERSION.BUILD()")
            shared_test_eval_version()

        it "runs PRACTICE command":
            # @req REQ-SSPEC-INTEGRATION
            step("runs PRACTICE command")
            shared_test_cmd_run()

        it "queries STATE.RUN()":
            # @req REQ-SSPEC-INTEGRATION
            step("queries STATE.RUN()")
            shared_test_state_query()

        it "reads PC register":
            # @req REQ-SSPEC-INTEGRATION
            step("reads PC register")
            shared_test_register_read()

        it "halt-step-halt cycle":
            # @req REQ-SSPEC-INTEGRATION
            step("halt-step-halt cycle")
            shared_test_step_and_halt()

        it "recovers from error":
            # @req REQ-SSPEC-INTEGRATION
            step("recovers from error")
            shared_test_error_recovery()
