# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @session-kind: trace32_board
# @target: arm
# @tag: t32_hw, backend_ctypes
# @reuse: exclusive_reused
# @execution-mode: compiled
"""
# T32 Backend: C API (ctypes)

Tests core T32 operations using the C API via ctypes/dlopen.
Requires compiled mode (spl_dlopen is not available in interpreter).
Requires t32api64.so library.
"""

use std.spec.step

use std.spipe.*
use test.integration.t32_hw.t32_hw_helpers.{
    t32_hw_probe_available, t32_hw_ctypes_available
}
use test.integration.t32_hw.backends._shared_backend_tests.{
    shared_test_connect_and_ping, shared_test_eval_version,
    shared_test_cmd_run, shared_test_state_query,
    shared_test_register_read, shared_test_step_and_halt,
    shared_test_error_recovery
}

describe "T32 via ctypes backend":
    # @manual scenario evidence
    context "when C API library is available":
        it "t32api64.so exists":
            # @req REQ-SSPEC-INTEGRATION
            step("t32api64.so exists")
            if not t32_hw_ctypes_available():
                expect("ctypes not available").to_contain("not available")
                return
            expect(t32_hw_ctypes_available()).to_equal(true)

        it "connects and pings":
            # @req REQ-SSPEC-INTEGRATION
            step("connects and pings")
            if not t32_hw_ctypes_available():
                return
            shared_test_connect_and_ping()

        it "evaluates VERSION.BUILD()":
            # @req REQ-SSPEC-INTEGRATION
            step("evaluates VERSION.BUILD()")
            if not t32_hw_ctypes_available():
                return
            shared_test_eval_version()

        it "runs PRACTICE command":
            # @req REQ-SSPEC-INTEGRATION
            step("runs PRACTICE command")
            if not t32_hw_ctypes_available():
                return
            shared_test_cmd_run()

        it "queries STATE.RUN()":
            # @req REQ-SSPEC-INTEGRATION
            step("queries STATE.RUN()")
            if not t32_hw_ctypes_available():
                return
            shared_test_state_query()

        it "reads PC register":
            # @req REQ-SSPEC-INTEGRATION
            step("reads PC register")
            if not t32_hw_ctypes_available():
                return
            shared_test_register_read()

        it "halt-step-halt cycle":
            # @req REQ-SSPEC-INTEGRATION
            step("halt-step-halt cycle")
            if not t32_hw_ctypes_available():
                return
            shared_test_step_and_halt()

        it "recovers from error":
            # @req REQ-SSPEC-INTEGRATION
            step("recovers from error")
            if not t32_hw_ctypes_available():
                return
            shared_test_error_recovery()
