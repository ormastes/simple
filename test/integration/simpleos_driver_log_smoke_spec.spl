"""
## Purpose and audience

log-lib-drivers Phase 4 spec — SimpleOS driver pilot smoke.

Covers AC-4 (driver-level logging routes through unified facade) and
AC-6d (one driver integration smoke).

Status: RED PHASE. Pilot driver `null_block.spl` has not been rerouted
through the facade yet; backend slot table not present yet.

Pilot driver: `examples/simple_os/src/drivers/null_block.spl` is the
single driver in the SimpleOS tree today (per Phase 2 audit). Phase 5
must wire its registration log line through `log_info_subsys(SUBSYS_DRIVER_BLOCK, ...)`.

Two-layer test:
  (a) Hosted-callable layer (this file): exercise the driver register
      function directly with the facade in-process; assert a log record
      with subsys=SUBSYS_DRIVER_BLOCK level=INFO appears.
  (b) Full QEMU smoke: documented as a manual command at the bottom of
      this file. Phase 7 (verify) runs it as a release-build gate.

This specification is maintained for compiler and library engineers reviewing INTEGRATION-SIMPLEOS_DRIVER_LOG_SMOK behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/simpleos_driver_log_smoke_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-SIMPLEOS_DRIVER_LOG_SMOK-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec
use std.io_runtime  # NOTE: never `app.io` — see project memory.
describe "SimpleOS driver smoke — null_block emits via facade (AC-4, AC-6d)":

    it "AC-6d: null_block_register routes its registration record through std.log":
        # @req: REQ-INTEGRATION-SIMPLEOS_DRIVER_LOG_SMOK-001
        step("Verify: AC-6d: null_block_register routes its registration record through std.log")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = rt_file_read_text("examples/simple_os/src/drivers/null_block.spl") ?? ""
        expect(source.contains("fn null_block_register()")).to_equal(true)
        expect(source.contains("log_info_subsys(SUBSYS_DRIVER_BLOCK")).to_equal(true)
        expect(source.contains("null_block: registered")).to_equal(true)
        expect(source.contains("null_block_smoke()")).to_equal(true)

    it "AC-4: driver does NOT emit via uart_writeln directly (facade only)":
        # @req: REQ-INTEGRATION-SIMPLEOS_DRIVER_LOG_SMOK-002
        step("Verify: AC-4: driver does NOT emit via uart_writeln directly (facade only)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # The production contract is source-level for this hosted spec:
        # driver logging must enter std.log, not raw UART output.
        val source = rt_file_read_text("examples/simple_os/src/drivers/null_block.spl") ?? ""
        expect(source.contains("log_info_subsys(SUBSYS_DRIVER_BLOCK")).to_equal(true)
        expect(source.index_of("uart_writeln(")).to_equal(-1)  # oracle: expected value -1 is the behavior asserted by this regression spec
        expect(source.index_of("log_raw_println(")).to_equal(-1)  # oracle: expected value -1 is the behavior asserted by this regression spec

    it "does not leave pass_todo in the SimpleOS null_block driver":
        # @req: REQ-INTEGRATION-SIMPLEOS_DRIVER_LOG_SMOK-003
        step("Verify: does not leave pass_todo in the SimpleOS null_block driver")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = rt_file_read_text("examples/simple_os/src/drivers/null_block.spl") ?? ""
        expect(source.index_of("pass_todo(")).to_equal(-1)  # oracle: expected value -1 is the behavior asserted by this regression spec
        expect(source).to_contain("fn register_null_block_driver_auto()")
        expect(source).to_contain("return register_static_driver(m, ops)")


# ----------------------------------------------------------------------------
# Manual QEMU smoke — Phase 7 (verify) runs this on a release build.
#
#   bin/simple build && \
#   bin/simple run examples/simple_os/src/main.spl --target=simpleos-x86_64 --qemu
#
# Expected output on the QEMU UART/semihost stream:
#
#   [INFO] [driver_block] null_block: registered (capacity=...)
#
# A fully-automated QEMU harness is out of scope for Phase 4; the
# `null_block_register_smoke` row in Phase 3 §I integration table is
# satisfied by the in-process test above plus this manual command.
# ----------------------------------------------------------------------------
