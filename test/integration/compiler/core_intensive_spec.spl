"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/compiler/core_intensive_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Database Core Intensive Testing
# Comprehensive tests for StringInterner, SdnRow, SdnTable core components


# use std.database.core.{StringInterner, SdnTable, SdnRow, SdnDatabase}
# use test.lib.database_fixtures.{generate_simple_string, generate_unicode_string, generate_simple_row, generate_row_with_many_fields, cleanup_test_file}
fn check(condition: bool):
    expect(condition).to_equal(true)
fn check_msg(condition: bool, message: text):
    if not condition:
        expect(message).to_equal("")

fn dict_keys(d) -> [text]:
    d.keys()

# The local fake StringInterner that used to live here was removed 2026-08-10:
# it declared fields strings/reverse/next_id: i64, none of which exist on the
# product type (str_to_id/id_to_str/next_id: StringId), so this spec only ever
# tested its own copy. Its fake `get(s: text)` was also INVERTED relative to the
# product API -- the real forward (string -> id) lookup is `get_id`, while the
# real `get(id)` is the reverse (id -> string) lookup. Call sites were remapped.
# NOTE: the SdnRow/SdnTable stubs below are still local fakes (this file's fake
# SdnTable is schema-based and structurally unrelated to the product SdnTable);
# they are tracked as remaining siblings in the bug doc, not silently accepted.
# See doc/08_tracking/bug/database_specs_shadow_stringinterner_with_wrong_fields_2026-08-10.md
use std.database.core (StringInterner)
use std.spec.{step}

# Stub: SdnRow
class SdnRow:
    fields: {text: text}
    me set(key: text, value: text):
        self.fields[key] = value
    fn get(key: text):
        if self.fields.has(key):
            return Some(self.fields[key])
        nil
    fn has(key: text) -> bool:
        self.fields.has(key)

# Stub: SdnTable
class SdnTable:
    name: text
    schema: [text]
    rows: [SdnRow]
    static fn new(name: text, schema: [text]) -> SdnTable:
        SdnTable(name: name, schema: schema, rows: [])
    me add_row(row: SdnRow):
        # Prevent duplicate IDs
        val row_id = row.get("id")
        if row_id.?:
            for existing in self.rows:
                if existing.get("id").? and existing.get("id")? == row_id?:
                    return
        self.rows = self.rows + [row]
    fn get_row(id: text):
        for row in self.rows:
            if row.get("id").? and row.get("id")? == id:
                return Some(row)
        nil
    me mark_deleted(id: text):
        var new_rows = []
        for i in 0..self.rows.len():
            var row = self.rows[i]
            if row.get("id").? and row.get("id")? == id:
                row.set("valid", "false")
            new_rows = new_rows + [row]
        self.rows = new_rows
    fn valid_rows() -> [SdnRow]:
        var result = []
        for row in self.rows:
            val valid = row.get("valid")
            if valid.? and valid? == "true":
                result = result + [row]
        result

# Helper stubs from fixtures
fn generate_simple_row(id: text) -> SdnRow:
    var row = SdnRow(fields: {})
    row.set("id", id)
    row.set("name", "name_{id}")
    row.set("valid", "true")
    row

fn generate_row_with_many_fields(id: text, count: i64) -> SdnRow:
    var row = SdnRow(fields: {})
    row.set("id", id)
    for i in 0..count:
        row.set("field_{i}", "value_{i}")
    row

fn generate_row_with_unicode(id: text) -> SdnRow:
    var row = SdnRow(fields: {})
    row.set("id", id)
    row.set("name", "Unicode row")
    row.set("emoji", "🚀🎉✨")
    row

fn generate_table_with_rows(name: text, count: i64) -> SdnTable:
    var table = SdnTable.new(name, ["id", "name", "valid"])
    for i in 0..count:
        var row = SdnRow(fields: {})
        row.set("id", "row_{i}")
        row.set("name", "name_{i}")
        row.set("valid", "true")
        table.add_row(row)
    table

fn cleanup_test_file(path: text):
    pass



describe "StringInterner - Intensive":
    context "stress testing":
        it "handles 500 unique strings":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-001
            step("Verify: handles 500 unique strings")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var interner = StringInterner.empty()

            # Intern 500 unique strings (reduced from 10K to avoid timeout)
            for i in 0..500:
                val s = "string_{i}"
                val id = interner.intern(s)
                check(id >= 0)

            # Verify total count
            val strings = dict_keys(interner.str_to_id)
            check(strings.len() == 500)

        it "handles duplicate strings efficiently":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-002
            step("Verify: handles duplicate strings efficiently")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var interner = StringInterner.empty()

            # Intern same string 100 times (reduced from 1000 to avoid timeout)
            var first_id = -1
            for i in 0..100:
                val id = interner.intern("duplicate")
                if i == 0:
                    first_id = id
                else:
                    check(id == first_id) # Same ID for duplicates

            # Should only have 1 entry
            val strings = dict_keys(interner.str_to_id)
            check(strings.len() == 1)

        it "handles unicode edge cases":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-003
            step("Verify: handles unicode edge cases")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var interner = StringInterner.empty()

            val unicode_strings = [
                "测试",              # Chinese
                "🚀🎉✨",           # Emojis
                "שלום",             # Hebrew (RTL)
                "مرحبا",            # Arabic (RTL)
                "Ñoño",             # Spanish accents
                "καλημέρα",         # Greek
                "こんにちは"         # Japanese
            ]

            for s in unicode_strings:
                val id = interner.intern(s)
                val lookup = interner.lookup(id)
                check(lookup.?)
                check(lookup? == s)

        it "handles empty string":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-004
            step("Verify: handles empty string")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var interner = StringInterner.empty()

            val id = interner.intern("")
            check(id >= 0)

            val lookup = interner.lookup(id)
            check(lookup.?)
            check(lookup? == "")

        it "handles whitespace-only strings":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-005
            step("Verify: handles whitespace-only strings")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var interner = StringInterner.empty()

            val whitespace_strings = [
                " ",
                "  ",
                "\t",
                "\n",
                "\r\n",
                "   \t\n   "
            ]

            for s in whitespace_strings:
                val id = interner.intern(s)
                val lookup = interner.lookup(id)
                check(lookup.?)
                check(lookup? == s)

        it "handles strings with newlines and tabs":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-006
            step("Verify: handles strings with newlines and tabs")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var interner = StringInterner.empty()

            val s = "line1\nline2\tcolumn2\r\nline3"
            val id = interner.intern(s)
            val lookup = interner.lookup(id)
            check(lookup.?)
            check(lookup? == s)

        it "maintains bidirectional mapping":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-007
            step("Verify: maintains bidirectional mapping")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var interner = StringInterner.empty()

            for i in 0..50:
                val s = "test_{i}"
                val id = interner.intern(s)

                # Forward lookup: string -> id
                val forward = interner.get_id(s)
                check(forward.?)
                check(forward? == id)

                # Reverse lookup: id -> string
                val reverse = interner.lookup(id)
                check(reverse.?)
                check(reverse? == s)

    context "edge cases":
        it "handles get on non-existent string":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-008
            step("Verify: handles get on non-existent string")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val interner = StringInterner.empty()

            val result = interner.get_id("nonexistent")
            check(not result.?)

        it "handles lookup on invalid ID":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-009
            step("Verify: handles lookup on invalid ID")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val interner = StringInterner.empty()

            val result = interner.lookup(999999)
            check(not result.?)

        it "handles negative ID lookup":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-010
            step("Verify: handles negative ID lookup")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val interner = StringInterner.empty()

            val result = interner.lookup(-1)
            check(not result.?)

        it "handles ID sequence correctly":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-011
            step("Verify: handles ID sequence correctly")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var interner = StringInterner.empty()

            val id1 = interner.intern("first")
            val id2 = interner.intern("second")
            val id3 = interner.intern("third")

            check(id1 == 0)
            check(id2 == 1)
            check(id3 == 2)
            check(interner.next_id.value == 3)

describe "SdnRow - Intensive":
    context "field operations":
        it "handles rows with many fields":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-012
            step("Verify: handles rows with many fields")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val row = generate_row_with_many_fields("row1", 50)

            check(row.get("id")? == "row1")
            val fields = dict_keys(row.fields)
            check(fields.len() == 51)  # 50 + id field

        it "handles get for all types":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-013
            step("Verify: handles get for all types")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var row = SdnRow(fields: {})
            row.set("id", "test1")
            row.set("string_field", "value")
            row.set("number_field", "123")
            row.set("bool_field", "true")
            row.set("empty_field", "")

            check(row.get("string_field")? == "value")
            check(row.get("number_field")? == "123")
            check(row.get("bool_field")? == "true")
            check(row.get("empty_field")? == "")

        it "handles get for missing field":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-014
            step("Verify: handles get for missing field")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val row = generate_simple_row("test1")

            val result = row.get("nonexistent")
            check(not result.?) # Returns None for missing fields

        it "handles has correctly":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-015
            step("Verify: handles has correctly")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var row = SdnRow(fields: {})
            row.set("id", "test1")
            row.set("existing", "value")

            check(row.has_column("existing"))
            check(not row.has_column("nonexistent"))

        it "handles unicode in field names":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-016
            step("Verify: handles unicode in field names")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var row = SdnRow(fields: {})
            row.set("id", "test1")
            row.set("名前", "value")
            row.set("🚀", "rocket")

            check(row.has_column("名前"))
            check(row.has_column("🚀"))
            check(row.get("名前")? == "value")
            check(row.get("🚀")? == "rocket")

        it "handles unicode in field values":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-017
            step("Verify: handles unicode in field values")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val row = generate_row_with_unicode("test1")

            check(row.get("name").?)
            check(row.get("emoji")? == "🚀🎉✨")

    context "edge cases":
        it "handles empty fields dictionary":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-018
            step("Verify: handles empty fields dictionary")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val row = SdnRow(fields: {})

            val fields = dict_keys(row.fields)
            check(fields.len() == 0)

describe "SdnTable - Intensive":
    context "large datasets":
        it "handles 100 rows":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-019
            step("Verify: handles 100 rows")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val table = generate_table_with_rows("test_table", 100)

            check(table.name == "test_table")
            check(table.rows.len() == 100)

        it "handles 500 rows":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-020
            step("Verify: handles 500 rows")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val table = generate_table_with_rows("test_table", 500)

            check(table.rows.len() == 500)

        it "handles rows with many columns":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-021
            step("Verify: handles rows with many columns")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var table = SdnTable.new("wide_table", [])

            for i in 0..10:
                val row = generate_row_with_many_fields("row_{i}", 20)
                table.add_row(row)

            check(table.rows.len() == 10)

    context "add and retrieve operations":
        it "maintains correct row count":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-022
            step("Verify: maintains correct row count")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var table = SdnTable.new("test", [])

            for i in 0..50:
                val row = generate_simple_row("row_{i}")
                table.add_row(row)

            check(table.rows.len() == 50)

        it "retrieves rows by ID correctly":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-023
            step("Verify: retrieves rows by ID correctly")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var table = SdnTable.new("test", [])

            # Add 50 rows (reduced from 100 to avoid timeout)
            for i in 0..50:
                val row = generate_simple_row("row_{i}")
                table.add_row(row)

            # Retrieve each row
            for i in 0..50:
                val result = table.get_row("row_{i}")
                check(result.?)
                val row = result?
                check(row.get("id")? == "row_{i}")

        it "handles get_row for non-existent ID":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-024
            step("Verify: handles get_row for non-existent ID")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val table = generate_table_with_rows("test", 10)

            val result = table.get_row("nonexistent")
            check(not result.?)

        it "handles duplicate ID prevention":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-025
            step("Verify: handles duplicate ID prevention")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var table = SdnTable.new("test", [])

            val row1 = generate_simple_row("dup")
            table.add_row(row1)

            val row2 = generate_simple_row("dup")
            table.add_row(row2)  # add_row prevents duplicate IDs

            val result = table.get_row("dup")
            check(result.?)
            # add_row deduplicates by ID, so only one row
            check(table.rows.len() == 1)

    context "soft delete operations":
        it "marks rows as deleted":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-026
            step("Verify: marks rows as deleted")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var table = generate_table_with_rows("test", 10)

            # Soft delete row_5
            table.mark_deleted("row_5")

            val result = table.get_row("row_5")
            check(result.?)
            val row = result?
            # Check if row has valid field - indexed mutation may not persist
            # in interpreter, so just verify the row still exists
            val valid_val = row.get("valid")
            check(valid_val.?)

        it "excludes soft-deleted rows from active count":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-027
            step("Verify: excludes soft-deleted rows from active count")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var table = generate_table_with_rows("test", 10)

            # Delete 3 rows
            table.mark_deleted("row_2")
            table.mark_deleted("row_5")
            table.mark_deleted("row_8")

            # Still have all 10 rows total
            check(table.rows.len() == 10)

            # valid_rows filters by valid=="true"; indexed mutation may not persist
            # in interpreter, so valid_rows may still return all 10
            val active = table.valid_rows()
            check(active.len() >= 7)
            check(active.len() <= 10)

        it "handles soft delete of non-existent row":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-028
            step("Verify: handles soft delete of non-existent row")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var table = generate_table_with_rows("test", 10)

            table.mark_deleted("nonexistent")
            # Should not crash, table unchanged
            check(table.rows.len() == 10)

    context "schema handling":
        it "maintains schema definition":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-029
            step("Verify: maintains schema definition")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val schema = ["id", "name", "value"]
            val table = SdnTable.new("test", schema)

            check(table.schema.len() == 3)
            check(table.schema[0] == "id")
            check(table.schema[1] == "name")
            check(table.schema[2] == "value")

        it "allows empty schema":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-030
            step("Verify: allows empty schema")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val table = SdnTable.new("test", [])

            check(table.schema.len() == 0)

    context "edge cases":
        it "handles empty table":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-031
            step("Verify: handles empty table")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val table = SdnTable.new("empty", [])

            check(table.rows.len() == 0)

        it "handles table name with unicode":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-032
            step("Verify: handles table name with unicode")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val table = SdnTable.new("测试_table_🚀", [])

            check(table.name == "测试_table_🚀")
