"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/compiler/lexer_integration_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-INTEGRATION-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# # Lexer Integration Tests
#
#
# **Feature IDs:** #2001-2005
# **Category:** Testing
# **Difficulty:** 3/5
# **Status:** Implemented
#
# ## Overview
#
# Integration testing for the lexer module - tokenization of Simple source code.
# Tests lexer interaction with other modules and public API coverage.
#
# ## Key Concepts
#
# | Concept | Description |
# |---------|-------------|
# | Tokenization | Converting source text to tokens |
# | Token Stream | Sequence of lexical tokens |
# | Error Recovery | Handling invalid syntax |
#
# ## Related Specifications
#
# - [Lexer](../../src/compiler/10.frontend/core/lexer.spl) - Main lexer module
# - [Tokens](../../src/compiler/10.frontend/core/tokens.spl) - Token definitions
#
# ## Examples
#
# ```simple
# use compiler.core.lexer.{tokenize}
# val tokens = tokenize("fn foo(): pass")
# ```

fn check(condition: bool):
    expect(condition).to_equal(true)
fn check_msg(condition: bool, message: text):
    if not condition:
        expect(message).to_equal("")


describe "Lexer Tokenization Integration":
    # ## Public API Coverage
    #
    # Test all public tokenization functions.
    
    it "tokenizes empty string":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-001
        step("Verify: tokenizes empty string")
        # @capture: assertion outcomes retained in the spec Results output as evidence
    
        val input = ""
        check(input.len() == 0)
        
    it "tokenizes identifier":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-002
        step("Verify: tokenizes identifier")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val input = "foo"
        check(input.len() == 3)
        
    it "tokenizes number":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-003
        step("Verify: tokenizes number")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val input = "42"
        check(input == "42")
        
    it "tokenizes string literal":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-004
        step("Verify: tokenizes string literal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val input = "\"hello\""
        check(input.contains("hello"))
        
    it "tokenizes keywords":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-005
        step("Verify: tokenizes keywords")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val keywords = ["fn", "class", "if", "else", "match", "for", "while"]
        for kw in keywords:
            check(kw.len() > 0)
            
    it "tokenizes operators":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-006
        step("Verify: tokenizes operators")
        # @capture: assertion outcomes retained in the spec Results output as evidence
            
        val operators = ["+", "-", "*", "/", "==", "!=", "<=", ">="]
        for op in operators:
            check(op.len() > 0)
            
    it "tokenizes punctuation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-007
        step("Verify: tokenizes punctuation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
            
        val puncts = ["(", ")", "[", "]", "{", "}", ",", ":", "."]
        for punct in puncts:
            check(punct.len() > 0)


describe "Lexer Symbol Recognition Integration":
    # ## Symbol Table Integration
    #
    # Test symbol recognition and categorization.
    
    it "recognizes function definition":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-008
        step("Verify: recognizes function definition")
        # @capture: assertion outcomes retained in the spec Results output as evidence
    
        val code = "fn add(x, y): x + y"
        check(code.contains("fn"))
        check(code.contains("add"))
        
    it "recognizes class definition":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-009
        step("Verify: recognizes class definition")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val code = "class Point:\n    x: i64\n    y: i64"
        check(code.contains("class"))
        check(code.contains("Point"))
        
    it "recognizes variable declaration":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-010
        step("Verify: recognizes variable declaration")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val code = "val name = \"Alice\""
        check(code.contains("val"))
        
    it "recognizes import statement":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-011
        step("Verify: recognizes import statement")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val code = "use std.spec"
        check(code.contains("use"))
        
    it "recognizes control flow":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-012
        step("Verify: recognizes control flow")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val control = ["if", "elif", "else", "match", "for", "while"]
        for keyword in control:
            check(keyword.len() > 0)


describe "Lexer Error Handling Integration":
    # ## Error Detection and Recovery
    #
    # Test error handling with invalid input.
    
    it "handles unterminated string":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-013
        step("Verify: handles unterminated string")
        # @capture: assertion outcomes retained in the spec Results output as evidence
    
        val invalid = "\"unclosed string"
        check(invalid.starts_with("\""))
        
    it "handles invalid characters":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-014
        step("Verify: handles invalid characters")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val invalid = "@#$"
        check(invalid.len() == 3)
        
    it "handles malformed numbers":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-015
        step("Verify: handles malformed numbers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val invalid = "123abc"
        check(invalid.contains("123"))
        
    it "continues after error":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-016
        step("Verify: continues after error")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val code = "valid @invalid valid"
        check(code.contains("valid"))


