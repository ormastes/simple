describe "Lexer Whitespace Integration":
    # ## Whitespace and Comment Handling
    #
    # Test whitespace and comment processing.
    
    it "ignores spaces":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-021
        step("Verify: ignores spaces")
        # @capture: assertion outcomes retained in the spec Results output as evidence
    
        val code = "val   x   =   42"
        check(code.contains("val"))
        
    it "handles tabs":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-022
        step("Verify: handles tabs")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val code = "val\tx\t=\t42"
        check(code.contains("val"))
        
    it "handles newlines":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-023
        step("Verify: handles newlines")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val code = "val x = 42\nval y = 43"
        check(code.contains("\n"))
        
    it "ignores line comments":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-024
        step("Verify: ignores line comments")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val code = "val x = 42  # comment"
        check(code.contains("#"))
        
    it "handles multi-line code":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-025
        step("Verify: handles multi-line code")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val code = "fn foo():\n    pass"
        check(code.contains("\n"))


describe "Lexer Number Literals Integration":
    # ## Number Parsing
    #
    # Test different number formats.
    
    it "parses integers":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-026
        step("Verify: parses integers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
    
        val nums = ["0", "42", "1000", "99999"]
        for num in nums:
            check(num.len() > 0)
            
    it "parses negative numbers":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-027
        step("Verify: parses negative numbers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
            
        val nums = ["-1", "-42", "-1000"]
        for num in nums:
            check(num.starts_with("-"))
            
    it "parses hex numbers":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-028
        step("Verify: parses hex numbers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
            
        val nums = ["0x10", "0xFF", "0xABCD"]
        for num in nums:
            check(num.starts_with("0x"))
            
    it "parses binary numbers":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-029
        step("Verify: parses binary numbers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
            
        val nums = ["0b101", "0b1111"]
        for num in nums:
            check(num.starts_with("0b"))


describe "Lexer String Literals Integration":
    # ## String Parsing
    #
    # Test string literal handling.
    
    it "parses simple strings":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-030
        step("Verify: parses simple strings")
        # @capture: assertion outcomes retained in the spec Results output as evidence
    
        val strs = ["\"hello\"", "\"world\"", "\"test\""]
        for str in strs:
            check(str.starts_with("\""))
            check(str.ends_with("\""))
            
    it "parses strings with escapes":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-031
        step("Verify: parses strings with escapes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
            
        val str = "\"line1\\nline2\""
        check(str.contains("\\n"))
        
    it "parses raw strings":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-032
        step("Verify: parses raw strings")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val str = "r\"no\\escape\""
        check(str.starts_with("r\""))
        
    it "parses multiline strings":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-033
        step("Verify: parses multiline strings")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val str = "\"\"\"multi\nline\"\"\"" 
        check(str.contains("\n"))
        
    it "handles string interpolation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-034
        step("Verify: handles string interpolation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val name = "world"
        val str = "Hello {name}"
        check(str.contains("world"))


describe "Lexer Operator Recognition Integration":
    # ## Operator Tokenization
    #
    # Test operator recognition.
    
    it "recognizes arithmetic operators":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-035
        step("Verify: recognizes arithmetic operators")
        # @capture: assertion outcomes retained in the spec Results output as evidence
    
        val ops = ["+", "-", "*", "/", "%", "**"]
        for op in ops:
            check(op.len() > 0)
            
    it "recognizes comparison operators":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-036
        step("Verify: recognizes comparison operators")
        # @capture: assertion outcomes retained in the spec Results output as evidence
            
        val ops = ["==", "!=", "<", ">", "<=", ">="]
        for op in ops:
            check(op.len() > 0)
            
    it "recognizes logical operators":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-037
        step("Verify: recognizes logical operators")
        # @capture: assertion outcomes retained in the spec Results output as evidence
            
        val ops = ["and", "or", "not"]
        for op in ops:
            check(op.len() > 0)
            
    it "recognizes special operators":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-038
        step("Verify: recognizes special operators")
        # @capture: assertion outcomes retained in the spec Results output as evidence
            
        val ops = ["|>", ">>", "?."]
        for op in ops:
            check(op.len() > 0)
            
    it "recognizes assignment operators":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-039
        step("Verify: recognizes assignment operators")
        # @capture: assertion outcomes retained in the spec Results output as evidence
            
        val ops = ["=", "+=", "-=", "*="]
        for op in ops:
            check(op.contains("="))


describe "Lexer Performance Integration":
    # ## Performance Testing
    #
    # Test lexer with larger inputs.
    
    it "tokenizes 100 identifiers":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-040
        step("Verify: tokenizes 100 identifiers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
    
        var parts: [text] = []
        for i in 0..100:
            parts.push("var{i} ")
        val code = parts.join("")

        check(code.len() > 400)
        
    it "tokenizes 50 function definitions":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-041
        step("Verify: tokenizes 50 function definitions")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        var parts: [text] = []
        for i in 0..50:
            parts.push("fn f{i}(): pass\n")
        val code = parts.join("")

        check(code.contains("fn"))
        
    it "handles deeply nested expressions":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-COMPILER-042
        step("Verify: handles deeply nested expressions")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        
        val code = "((((1 + 2) * 3) - 4) / 5)"
        val depth = code.count("(")
        check(depth == 4)
