        # val mod1 = "import mod2"
        # val mod2 = "import mod1"
        # expect(load_modules()).to(be_err()
        pass

    it "loads transitive dependencies":
        # Raw (brace-literal) triple-quoted strings: a plain "..." fixture
        # containing `use .c.{from_c}` would have its `{from_c}` consumed as
        # THIS file's own string interpolation instead of being written
        # verbatim to the child fixture.
        val _c = write_fixture("dep_graph", "c.spl", """pub fn from_c() -> i64:
    return 7
""")
        val _b = write_fixture("dep_graph", "b.spl", """use .c.{from_c}

pub fn from_b() -> i64:
    return from_c() * 2
""")
        val main_path = write_fixture("dep_graph", "main.spl", """use .b.{from_b}

print(from_b())
""")
        val result = run_simple_file(main_path)
        expect(result.exit_code).to_equal(0)
        expect(result.stdout).to_contain("14")

    it "handles module reload":
        # TODO: Test hot reload
        pass


