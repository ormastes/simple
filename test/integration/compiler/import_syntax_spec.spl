"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/compiler/import_syntax_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Import Syntax Verification Spec
#
# Tests that both import syntaxes work correctly for mod.spl files


# Test 1: Curly braces syntax
use app.io.{env_get, env_set, shell}

# Test 2: Parentheses syntax (different functions to avoid conflicts)
use app.io.mod (file_exists, cwd)
use std.spec.{step}

describe "Import Syntax for mod.spl Files":
    # Both syntaxes should work when imports are at module level.

    context "Curly braces syntax: use app.io.{...}":
        it "imports env_get with curly braces":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-001
            step("Verify: imports env_get with curly braces")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = env_get("PATH")
            expect result.len() > 0

        it "imports env_set with curly braces":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-002
            step("Verify: imports env_set with curly braces")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = env_set("TEST_VAR_CURLY", "test")
            expect result == true

        it "imports shell with curly braces":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-003
            step("Verify: imports shell with curly braces")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = shell("echo test")
            expect result.exit_code == 0

    context "Parentheses syntax: use app.io.mod (...)":
        it "imports file_exists with parentheses":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-004
            step("Verify: imports file_exists with parentheses")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = file_exists("test/02_integration/compiler/import_syntax_spec.spl")
            expect result == true

        it "imports cwd with parentheses":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-INTEGRATION-COMPILER-005
            step("Verify: imports cwd with parentheses")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = cwd()
            expect result.len() > 0
