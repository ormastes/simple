"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-STORAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/storage/dbfs/fat32_no_regression_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-STORAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Maps to: AC-7, AC-9
# Run: bin/simple test test/integration/storage/dbfs/fat32_no_regression_spec.spl

"""
FAT32 Hosted Seam Specification

Verifies the currently implemented FAT32 mount-table surface:
  - shared FsFat32Driver can still be mounted alongside other filesystems
  - DBFS resolution does not fall through to the FAT32 sibling
  - this seam no longer imports or instantiates the legacy Fat32Driver
"""

use std.spipe.*
use std.io_runtime.{read_file}
use std.fs_driver.block_device.{BlockDevice}
use std.fs_driver.ops.{FsDriver}
use std.fs_driver.fat32_stub.{FsFat32Driver}
use std.fs_driver.types.{OpenFlags, MountOptions, ExecuteTrust}
use std.fs_driver.instance.{DriverInstance}
use std.fs_driver.mount_table.{MountTable}
use std.db.dbfs_driver.{DbFsDriver}

class MockFat32BlockDevice:
    sector: [u8]

impl MockFat32BlockDevice:
    static fn new() -> MockFat32BlockDevice:
        var bytes: [u8] = []
        var i = 0
        while i < 512:
            bytes.push(0)
            i = i + 1
        bytes[11] = 0x00
        bytes[12] = 0x02
        bytes[13] = 0x01
        bytes[14] = 0x20
        bytes[15] = 0x00
        bytes[16] = 0x02
        bytes[32] = 0x00
        bytes[33] = 0x10
        bytes[34] = 0x00
        bytes[35] = 0x00
        bytes[36] = 0xF0
        bytes[37] = 0x03
        bytes[44] = 0x02
        bytes[45] = 0x00
        bytes[46] = 0x00
        bytes[47] = 0x00
        bytes[510] = 0x55
        bytes[511] = 0xAA
        MockFat32BlockDevice(sector: bytes)

impl BlockDevice for MockFat32BlockDevice:
    fn read_sector(lba: u64) -> Result<[u8], text>:
        var buffer: [u8] = []
        var i = 0
        while i < self.sector.len():
            if lba == 0:
                buffer.push(self.sector[i])
            else:
                buffer.push(0)
            i = i + 1
        Result.Ok(buffer)

    fn write_sector(lba: u64, data: [u8]) -> Result<bool, text>:
        Result.Ok(true)

    fn sector_size() -> u32:
        512

fn make_fat32_driver() -> FsFat32Driver:
    FsFat32Driver.new("Fat32Driver", MockFat32BlockDevice.new())

fn make_fat32_mounted() -> MountTable:
    val mt = MountTable.new()
    val fat32 = make_fat32_driver()
    mt.mount("/boot", DriverInstance.Fat32(fat32), MountOptions.read_only()).unwrap()
    mt

describe "FAT32 hosted seam — mount table registration":
    it "shared FAT32 driver registers without error":
        # @req: REQ-INTEGRATION-STORAGE-001
        step("Verify: shared FAT32 driver registers without error")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mt = make_fat32_mounted()
        val boot_driver = mt.resolve_driver("/boot").unwrap()
        expect(boot_driver.driver_name()).to_equal("Fat32Driver")

    it "stays on the shared FsFat32Driver surface":
        # @req: REQ-INTEGRATION-STORAGE-002
        step("Verify: stays on the shared FsFat32Driver surface")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("test/integration/storage/dbfs/fat32_no_regression_spec.spl")
        val legacy_type = "Fat32" + "Driver"
        expect(source.contains("use os.services.fat32.fat32")).to_equal(false)
        expect(source.contains(" " + legacy_type + ".new(")).to_equal(false)
        expect(source.contains("=" + legacy_type + ".new(")).to_equal(false)
        expect(source.contains("(" + legacy_type + ".new(")).to_equal(false)
        expect(source.contains("FsFat32Driver.new(")).to_equal(true)

    it "opens real FAT32 bytes for execution without creating misses":
        var driver = FsFat32Driver.new_ram_backed_with_file("PROGRAM.SMF", "SMF1")
        driver.mount(MountOptions.default()).unwrap()
        var table = MountTable.new()
        table.mount("/boot", DriverInstance.Fat32(driver), MountOptions.default()).unwrap()
        expect(table.stat("/boot/PROGRAM.SMF").unwrap().size).to_equal(4)
        val binding = table.open_for_execute("/boot/PROGRAM.SMF", ExecuteTrust.Trusted).unwrap()
        expect(binding.backend_name).to_equal("Fat32Driver")
        expect(binding.backend_kind).to_equal("fat32")
        expect(binding.size).to_equal(4)
        expect(table.execute_binding_is_current(binding)).to_equal(true)
        expect(table.pread(binding.file_handle, 0, binding.size).unwrap()).to_equal("SMF1")
        table.close(binding.file_handle).unwrap()
        expect(table.open_for_execute("/boot/MISSING.SMF", ExecuteTrust.Trusted).is_err()).to_equal(true)
        expect(table.stat("/boot/MISSING.SMF").is_err()).to_equal(true)

describe "FAT32 hosted seam — DBFS co-existence":
    it "FAT32 and DBFS can both be mounted simultaneously":
        # @req: REQ-INTEGRATION-STORAGE-003
        step("Verify: FAT32 and DBFS can both be mounted simultaneously")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mt = MountTable.new()
        val fat32 = make_fat32_driver()
        mt.mount("/boot", DriverInstance.Fat32(fat32), MountOptions.read_only()).unwrap()
        val dbfs = DbFsDriver.new_hosted()
        mt.mount("/data", DriverInstance.DbFs(dbfs), MountOptions.default()).unwrap()
        val boot_driver = mt.resolve_driver("/boot").unwrap()
        val data_driver = mt.resolve_driver("/data/file.txt").unwrap()
        expect(boot_driver.driver_name()).to_equal("Fat32Driver")
        expect(data_driver.driver_name()).to_equal("DbFsDriver")
