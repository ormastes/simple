"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-STORAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/storage/dbfs/dbfs_mvcc_visibility_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-STORAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.io_runtime
use std.spec.{describe, it, expect, step}
use nogc_sync_mut.db.dbfs_engine.mvcc.{
    MvccHeader, MvccTuple, MvccSnapshot, MvccTable,
    MvccTxnHandle, MvccTxnManager,
    mvcc_is_visible, mvcc_register_txn, mvcc_commit_txn, mvcc_abort_txn,
    mvcc_get_txn_status
}

describe "MvccHeader":
    it "creates with xmin set":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-001
        step("Verify: creates with xmin set")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val h = MvccHeader.create(10)
        expect h.xmin == 10
        expect h.xmax == 0

    it "marks deleted with xmax":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-002
        step("Verify: marks deleted with xmax")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var h = MvccHeader.create(10)
        h.mark_deleted(20)
        expect h.xmax == 20

describe "MvccTuple":
    it "creates tuple with data":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-003
        step("Verify: creates tuple with data")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t = MvccTuple.create(5, "hello")
        expect t.header.xmin == 5
        expect t.data == "hello"

    it "marks tuple deleted":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-004
        step("Verify: marks tuple deleted")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var t = MvccTuple.create(5, "hello")
        t.delete(10)
        expect t.header.xmax == 10

describe "MvccSnapshot":
    it "detects active transactions":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-005
        step("Verify: detects active transactions")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val snap = MvccSnapshot(xmin: 1, xmax: 10, active_txns: [3, 5, 7])
        expect snap.is_txn_active(3) == true
        expect snap.is_txn_active(5) == true
        expect snap.is_txn_active(2) == false

describe "MVCC Visibility":
    it "committed insert is visible":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-006
        step("Verify: committed insert is visible")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val tuple = MvccTuple.create(1, "row1")
        val snap = MvccSnapshot(xmin: 1, xmax: 10, active_txns: [])
        expect mvcc_is_visible(tuple, snap) == true

    it "active insert is not visible":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-007
        step("Verify: active insert is not visible")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val tuple = MvccTuple.create(5, "row1")
        val snap = MvccSnapshot(xmin: 1, xmax: 10, active_txns: [5])
        expect mvcc_is_visible(tuple, snap) == false

    it "future insert is not visible":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-008
        step("Verify: future insert is not visible")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val tuple = MvccTuple.create(15, "row1")
        val snap = MvccSnapshot(xmin: 1, xmax: 10, active_txns: [])
        expect mvcc_is_visible(tuple, snap) == false

    it "deleted tuple is not visible":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-009
        step("Verify: deleted tuple is not visible")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var tuple = MvccTuple.create(1, "row1")
        tuple.delete(5)
        val snap = MvccSnapshot(xmin: 1, xmax: 10, active_txns: [])
        expect mvcc_is_visible(tuple, snap) == false

    it "tuple deleted by active txn is still visible":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-010
        step("Verify: tuple deleted by active txn is still visible")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var tuple = MvccTuple.create(1, "row1")
        tuple.delete(5)
        val snap = MvccSnapshot(xmin: 1, xmax: 10, active_txns: [5])
        expect mvcc_is_visible(tuple, snap) == true

describe "MvccTable":
    it "inserts and scans tuples":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-011
        step("Verify: inserts and scans tuples")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var table = MvccTable.new()
        table.insert(1, "row1")
        table.insert(1, "row2")
        val snap = MvccSnapshot(xmin: 1, xmax: 10, active_txns: [])
        val visible = table.scan(snap)
        expect visible.len() == 2

    it "counts visible tuples":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-012
        step("Verify: counts visible tuples")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var table = MvccTable.new()
        table.insert(1, "a")
        table.insert(1, "b")
        table.insert(5, "c")
        val snap = MvccSnapshot(xmin: 1, xmax: 4, active_txns: [])
        expect table.count_visible(snap) == 2

    it "delete hides tuple from scan":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-013
        step("Verify: delete hides tuple from scan")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var table = MvccTable.new()
        table.insert(1, "row1")
        table.insert(1, "row2")
        table.delete_matching(2, "row1")
        val snap = MvccSnapshot(xmin: 1, xmax: 10, active_txns: [])
        expect table.count_visible(snap) == 1

describe "MvccTxnManager":
    it "assigns incrementing txn ids":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-014
        step("Verify: assigns incrementing txn ids")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var mgr = MvccTxnManager.new()
        val h1 = mgr.begin()
        val h2 = mgr.begin()
        expect h2.txn_id > h1.txn_id

    it "tracks active transactions in snapshot":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-015
        step("Verify: tracks active transactions in snapshot")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var mgr = MvccTxnManager.new()
        val h1 = mgr.begin()
        val h2 = mgr.begin()
        val snap = mgr.snapshot()
        expect snap.is_txn_active(h1.txn_id) == true
        expect snap.is_txn_active(h2.txn_id) == true

    it "commit removes from active":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-016
        step("Verify: commit removes from active")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var mgr = MvccTxnManager.new()
        val h1 = mgr.begin()
        mgr.commit(h1.txn_id)
        val snap = mgr.snapshot()
        expect snap.is_txn_active(h1.txn_id) == false
        expect mgr.get_status(h1.txn_id) == "committed"

    it "abort removes from active":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-017
        step("Verify: abort removes from active")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var mgr = MvccTxnManager.new()
        val h1 = mgr.begin()
        mgr.abort(h1.txn_id)
        val snap = mgr.snapshot()
        expect snap.is_txn_active(h1.txn_id) == false
        expect mgr.get_status(h1.txn_id) == "aborted"
