"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-STORAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/storage/dbfs/nvfs_hosted_no_regression_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-STORAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Maps to: AC-4, AC-9
# Run: bin/simple test test/integration/storage/dbfs/nvfs_hosted_no_regression_spec.spl

"""
NVFS Hosted Seam Specification

Runs the same hosted mount-table contract as FAT32 so NVFS can share the
filesystem regression seam used by FAT32 and DBFS.
"""

use std.spipe.*
use std.fs_driver.types.{MountOptions}
use std.fs_driver.instance.{DriverInstance}
use std.fs_driver.mount_table.{MountTable}
use std.fs_driver.nvfs_driver.{NvfsDriver}
use test.fixtures.storage.dbfs.hosted_fs_no_regression_shared.{
    assert_mount_root_is_dir,
    assert_mount_root_slash_is_dir,
    assert_readdir_on_root_is_stable,
    assert_open_returns_handle,
    assert_read_returns_empty_or_better
}

fn make_nvfs_mounted() -> MountTable:
    val mt = MountTable.new()
    var nvfs = NvfsDriver.new("nvfs-hosted")
    nvfs.mount(MountOptions.default()).unwrap()
    mt.mount("/nvfs", DriverInstance.Nvfs(nvfs), MountOptions.default()).unwrap()
    mt

describe "NVFS hosted seam — mount and stat":
    it "NVFS volume mounts without error":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-001
        step("Verify: NVFS volume mounts without error")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mt = make_nvfs_mounted()
        assert_mount_root_is_dir(mt, "/nvfs")

    it "stat on NVFS root returns is_dir=true":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-002
        step("Verify: stat on NVFS root returns is_dir=true")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mt = make_nvfs_mounted()
        assert_mount_root_slash_is_dir(mt, "/nvfs")

describe "NVFS hosted seam — readdir and open":
    it "readdir on NVFS root returns a stable empty-or-better listing":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-003
        step("Verify: readdir on NVFS root returns a stable empty-or-better listing")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mt = make_nvfs_mounted()
        assert_readdir_on_root_is_stable(mt, "/nvfs")

    it "open on an NVFS path returns a valid handle":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-004
        step("Verify: open on an NVFS path returns a valid handle")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mt = make_nvfs_mounted()
        assert_open_returns_handle(mt, "/nvfs/README.TXT")

    it "read on NVFS returns empty content rather than erroring":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-STORAGE-005
        step("Verify: read on NVFS returns empty content rather than erroring")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mt = make_nvfs_mounted()
        assert_read_returns_empty_or_better(mt, "/nvfs/README.TXT")
