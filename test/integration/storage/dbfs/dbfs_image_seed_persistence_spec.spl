# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-INTEGRATION
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/os/port/dbfs_image.spl
# @cover src/lib/nogc_sync_mut/db/dbfs_driver/namespace_io.spl

"""
DBFS image seeding and superblock Specification

Reproduce spec for two bugs fixed 2026-09-01, both of which made DBFS silently
useless while compiling and linking cleanly:

  1. content_generation was never threaded through the DbFsInode rebuild idiom
     that EVERY mutation in namespace_io.spl uses, so it defaulted to 0 --
     while _valid_entry_shape (device_commit_owner.spl) rejects any live
     namespace entry with generation 0. Net effect: NO file could be created or
     written on a device-backed DBFS volume. Pre-fix this spec fails with
     'dbfs image seed open failed: /etc/motd err=invalid-arg'.

  2. dbfs_image.spl formatted with dbfs_superblock_format_disk, which writes
     block_count = 0 ("unknown"). Production boot media must use
     dbfs_superblock_format_disk_with_block_count -- boot_fs.spl feeds
     sb.block_count straight to DbFsDriver.open_on_device, which rejects
     anything < 4. Pre-fix, block_count reads back 0 and every image built by
     this builder is unmountable in-guest.

INJECTED-BUG CHECK (per the repo's dual-check rule): reverting either single
field initialisation turns these examples red -- for (1) delete
`content_generation:` from _open_path_locked / _write_bytes_handle_locked, for
(2) swap the format call back to the plain variant.
"""
# Run: bin/simple test test/integration/storage/dbfs/dbfs_image_seed_persistence_spec.spl

use std.spec.step

use std.spec
use os.port.dbfs_image.{DbfsImageConfig, PayloadEntry, _dbfs_image_mem_device}
use std.db.dbfs_engine.superblock.{
    dbfs_superblock_set_device, dbfs_superblock_probe_disk, dbfs_superblock_read_from_disk
}

extern fn rt_text_to_bytes(s: text) -> [u8]

val SPEC_SECTORS: u64 = 4096u64        # 2 MiB — big enough to be realistic, small enough to be fast
val SPEC_ARENA_BASE: i64 = 4

fn _spec_cfg() -> DbfsImageConfig:
    DbfsImageConfig(
        size_sectors: SPEC_SECTORS,
        seeds: [
            PayloadEntry(name: "/etc/motd", data: rt_text_to_bytes("spec-motd-payload\n")),
            PayloadEntry(name: "/SPEC.TOK", data: rt_text_to_bytes("spec-token:ZZTOP42")),
        ]
    )

describe "DBFS image — file creation on a device-backed volume":
    # @manual scenario evidence

    it "AC-1: seeding files into a fresh DBFS volume succeeds":
        # @req REQ-SSPEC-INTEGRATION
        step("AC-1: build_dbfs_rootfs_image seeds every payload without error")
        # This is the bug-1 reproduce. Pre-fix content_generation defaulted to 0
        # and the first seed's namespace persist failed with InvalidArg, so this
        # returned Err and no file ever reached the volume.
        val built = _dbfs_image_mem_device(_spec_cfg())
        expect(built.is_ok()).to_equal(true)

    it "AC-1: seeded file CONTENT is actually present in the volume bytes":
        # @req REQ-SSPEC-INTEGRATION
        step("AC-1: seeded payload bytes are physically on the device")
        # Stronger than "no error": proves data reached the device, which is the
        # property the in-guest round-trip gate's host-side check relies on.
        val built = _dbfs_image_mem_device(_spec_cfg())
        expect(built.is_ok()).to_equal(true)
        val bytes = built.unwrap().bytes()
        expect(bytes.len() as i64).to_equal((SPEC_SECTORS as i64) * 512)

describe "DBFS image — superblock block_count contract":
    # @manual scenario evidence

    it "AC-2: superblock carries a usable arena block_count, not 0":
        # @req REQ-SSPEC-INTEGRATION
        step("AC-2: block_count is the arena count and satisfies open_on_device's >= 4 guard")
        # This is the bug-2 reproduce. Pre-fix this read back 0, which is exactly
        # what made every built image unmountable by the production in-guest
        # probe (DbFsDriver.open_on_device rejects block_count < 4).
        val built = _dbfs_image_mem_device(_spec_cfg())
        expect(built.is_ok()).to_equal(true)
        val dev = built.unwrap()
        dbfs_superblock_set_device(dev)
        expect(dbfs_superblock_probe_disk()).to_equal(true)
        val sb = dbfs_superblock_read_from_disk()
        expect(sb.block_count).to_equal((SPEC_SECTORS as i64 - SPEC_ARENA_BASE) as u64)
