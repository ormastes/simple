"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-IO behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/io/native_ops_file_copy_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-IO-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use app.io.file_ops
use std.spec.{step}

extern fn rt_env_get(key: text) -> text

fn check(condition: bool):
    expect(condition).to_equal(true)

fn slow_it(name: text, block: fn()):
    it(name, block)

val tmp = rt_env_get("TEMP") ?? rt_env_get("TMPDIR") ?? "/tmp"

describe "Native File Ops":
    slow_it "copies files":
        # @req: REQ-INTEGRATION-IO-001
        step("Verify: copies files")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val src = "{tmp}/simple_copy_src.txt"
        val dst = "{tmp}/simple_copy_dst.txt"

        check(file_write(src, "Copy test"))
        check(file_copy(src, dst))
        expect(file_read(dst).trim()).to_equal("Copy test")
        check(file_delete(src))
        check(file_delete(dst))

