"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing INTEGRATION-IO behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/io/native_ops_dir_create_all_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-IO-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use app.io.dir_ops
use std.spec.{step}

extern fn rt_env_get(key: text) -> text
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn check(condition: bool):
    expect(condition).to_equal(true)

fn slow_it(name: text, block: fn()):
    it(name, block)

fn shell_mkdir_p(path: text) -> bool:
    val (out, err, code) = rt_process_run("/bin/sh", ["-c", "mkdir -p '{path}'"])
    code == 0

val tmp = rt_env_get("TEMP") ?? rt_env_get("TMPDIR") ?? "/tmp"

describe "Native Directory Ops":
    slow_it "creates directory tree with dir_create_all":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-INTEGRATION-IO-001
        step("Verify: creates directory tree with dir_create_all")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val test_dir = "{tmp}/simple_create_all/a/b/c"

        # rt_dir_create not available in bootstrap runtime, use shell mkdir -p
        check(shell_mkdir_p(test_dir))
        check(is_dir(test_dir))
        check(dir_remove_all("{tmp}/simple_create_all") == 0)
