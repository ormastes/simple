"""
## Purpose and audience
Purpose: ADD wraps at 64 bits
Audience: compiler and tooling engineers who maintain this spec

# RV64 ISA Compliance Integration Tests

**Feature IDs:** #RV64-COMPLIANCE-001
**Category:** Hardware
**Difficulty:** 3/5
**Status:** Draft

## Overview

Validates each RV64GC extension against the RISC-V ISA specification.
"""

# @req: REQ-HARDWARE-Rv64Comp-001

# tag: only-compiled, slow

import std.spec

use hardware.rv64gc.core.rv64_execute.{alu_execute, alu_execute_word}
use hardware.rv64gc.ext.rv64_muldiv.{muldiv_execute, muldiv_execute_word}
use hardware.rv64gc.ext.rv64_atomics.{amo_execute, AmoOp}
use hardware.rv64gc.pkg.rv64_types_pkg.*

use std.spec.step
describe "RV64I Compliance":
    it "ADD wraps at 64 bits":
        step("Verify: ADD wraps at 64 bits")
        # @req: REQ-HARDWARE-Rv64Comp-001
        expect(alu_execute(AluOp.Add, 0xFFFFFFFFFFFFFFFF, 1)).to_equal(0)  # oracle: value fixed by the spec contract

    it "ADDW sign-extends 32-bit result":
        step("Verify: ADDW sign-extends 32-bit result")
        # @req: REQ-HARDWARE-Rv64Comp-001
        expect(alu_execute_word(AluOp.Addw, 0x7FFFFFFF, 1)).to_equal(0xFFFFFFFF80000000)

    it "SLL uses lower 6 bits only":
        step("Verify: SLL uses lower 6 bits only")
        # @req: REQ-HARDWARE-Rv64Comp-001
        expect(alu_execute(AluOp.Sll, 1, 64)).to_equal(1)  # oracle: value fixed by the spec contract

    it "SRA fills with sign bit":
        step("Verify: SRA fills with sign bit")
        # @req: REQ-HARDWARE-Rv64Comp-001
        expect(alu_execute(AluOp.Sra, 0x8000000000000000, 1)).to_equal(0xC000000000000000)

    it "SLT: MIN_I64 < 0":
        step("Verify: SLT: MIN_I64 < 0")
        # @req: REQ-HARDWARE-Rv64Comp-001
        expect(alu_execute(AluOp.Slt, 0x8000000000000000, 0)).to_equal(1)  # oracle: value fixed by the spec contract

    it "SLTU: MAX_U64 > 0":
        step("Verify: SLTU: MAX_U64 > 0")
        # @req: REQ-HARDWARE-Rv64Comp-001
        expect(alu_execute(AluOp.Sltu, 0, 0xFFFFFFFFFFFFFFFF)).to_equal(1)  # oracle: value fixed by the spec contract

    it "SRLW uses lower 5 bits":
        step("Verify: SRLW uses lower 5 bits")
        # @req: REQ-HARDWARE-Rv64Comp-001
        expect(alu_execute_word(AluOp.Srlw, 0x80000000, 32)).to_equal(0xFFFFFFFF80000000)

    it "SRAW fills with 32-bit sign":
        step("Verify: SRAW fills with 32-bit sign")
        # @req: REQ-HARDWARE-Rv64Comp-001
        expect(alu_execute_word(AluOp.Sraw, 0x80000000, 31)).to_equal(0xFFFFFFFFFFFFFFFF)

describe "RV64M Compliance":
    it "MUL: lower 64 bits of product":
        step("Verify: MUL: lower 64 bits of product")
        # @req: REQ-HARDWARE-Rv64Comp-001
        expect(muldiv_execute(MulDivOp.Mul, 0x100000000, 0x100000000)).to_equal(0)  # oracle: value fixed by the spec contract

    it "DIV: divide by zero = -1":
        step("Verify: DIV: divide by zero = -1")
        # @req: REQ-HARDWARE-Rv64Comp-001
        expect(muldiv_execute(MulDivOp.Div, 42, 0)).to_equal(-1)  # oracle: value fixed by the spec contract

    it "DIVU: divide by zero = MAX_U64":
        step("Verify: DIVU: divide by zero = MAX_U64")
        # @req: REQ-HARDWARE-Rv64Comp-001
        expect(muldiv_execute(MulDivOp.Divu, 42, 0)).to_equal(0xFFFFFFFFFFFFFFFF)

    it "DIV: overflow MIN/-1 = MIN":
        step("Verify: DIV: overflow MIN/-1 = MIN")
        # @req: REQ-HARDWARE-Rv64Comp-001
        expect(muldiv_execute(MulDivOp.Div, 0x8000000000000000, -1)).to_equal(0x8000000000000000)

    it "REM: divide by zero = dividend":
        step("Verify: REM: divide by zero = dividend")
        # @req: REQ-HARDWARE-Rv64Comp-001
        expect(muldiv_execute(MulDivOp.Rem, 42, 0)).to_equal(42)  # oracle: value fixed by the spec contract

    it "MULW: sign-extends 32-bit product":
        step("Verify: MULW: sign-extends 32-bit product")
        # @req: REQ-HARDWARE-Rv64Comp-001
        expect(muldiv_execute_word(MulDivOp.Mulw, 0x40000000, 2)).to_equal(0xFFFFFFFF80000000)

    it "DIVW: divide by zero = -1 (sign-ext)":
        step("Verify: DIVW: divide by zero = -1 (sign-ext)")
        # @req: REQ-HARDWARE-Rv64Comp-001
        expect(muldiv_execute_word(MulDivOp.Divw, 42, 0)).to_equal(0xFFFFFFFFFFFFFFFF)

describe "RV64A Compliance":
    it "AMOADD returns old and computes new":
        step("Verify: AMOADD returns old and computes new")
        # @req: REQ-HARDWARE-Rv64Comp-001
        val r = amo_execute(AmoOp.Add, 100, 50)
        expect(r.old_value).to_equal(100)  # oracle: value fixed by the spec contract
        expect(r.new_value).to_equal(150)  # oracle: value fixed by the spec contract

    it "AMOSWAP stores new value":
        step("Verify: AMOSWAP stores new value")
        # @req: REQ-HARDWARE-Rv64Comp-001
        val r = amo_execute(AmoOp.Swap, 100, 200)
        expect(r.new_value).to_equal(200)  # oracle: value fixed by the spec contract

    it "AMOMAX signed comparison":
        step("Verify: AMOMAX signed comparison")
        # @req: REQ-HARDWARE-Rv64Comp-001
        val r = amo_execute(AmoOp.Max, -10, 5)
        expect(r.new_value).to_equal(5)  # oracle: value fixed by the spec contract

    it "AMOMINU unsigned comparison":
        step("Verify: AMOMINU unsigned comparison")
        # @req: REQ-HARDWARE-Rv64Comp-001
        val r = amo_execute(AmoOp.Minu, 0xFFFFFFFFFFFFFFFF, 5)
        expect(r.new_value).to_equal(5)  # oracle: value fixed by the spec contract

    it "AMOAND bitwise":
        step("Verify: AMOAND bitwise")
        # @req: REQ-HARDWARE-Rv64Comp-001
        val r = amo_execute(AmoOp.And, 0xFF, 0x0F)
        expect(r.new_value).to_equal(0x0F)

describe "RV64F Compliance":
    """
    Placeholder — detailed FP compliance in rv64_fp_compliance_spec.spl
    """

    it "F extension presence check":
        step("Verify: F extension presence check")
        # @req: REQ-HARDWARE-Rv64Comp-001
        # misa bit 5 (F) should be set
        val misa = 0x800000000014112D
        expect((misa >> 5) and 1).to_equal(1)  # oracle: value fixed by the spec contract

describe "RV64D Compliance":
    """
    Placeholder — detailed FP compliance in rv64_fp_compliance_spec.spl
    """

    it "D extension presence check":
        step("Verify: D extension presence check")
        # @req: REQ-HARDWARE-Rv64Comp-001
        # misa bit 3 (D) should be set
        val misa = 0x800000000014112D
        expect((misa >> 3) and 1).to_equal(1)  # oracle: value fixed by the spec contract
