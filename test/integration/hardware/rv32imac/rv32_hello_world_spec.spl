"""
## Purpose and audience

# RV32IMAC Hello World Verification

**Feature IDs:** #RV32-HELLO-001
**Category:** Hardware
**Difficulty:** 3/5
**Status:** In Progress

## Overview

Verifies the SoC boots and produces UART output.
Tests the full pipeline from instruction fetch to UART character output.

This specification is maintained for compiler and library engineers reviewing INTEGRATION-HARDWARE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/integration/hardware/rv32imac/rv32_hello_world_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-INTEGRATION-HARDWARE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @req REQ-RV32IMAC
# @feature rv32imac
# tag: only-compiled, vhdl, slow

use std.spec.*

use hardware.rv32gc.periph.rv32_uart.{Rv32Uart, UART_LSR, UART_THR}
use hardware.rv32gc.periph.rv32_clint.Rv32Clint
use hardware.rv32gc.mem.rv32_ram.Rv32Ram
use hardware.rv32gc.mem.rv32_bus.Rv32Bus
use hardware.riscv_common.pkg.riscv_linux_pkg.RiscvPlatformProfile

# ============================================================================
# UART Model Tests
# ============================================================================

describe "RV32 UART Model":
    """
    ## UART Peripheral Verification

    Tests the UART transmit and status register behavior.
    """

    it "starts with TX empty":
        # @req: REQ-INTEGRATION-HARDWARE-001
            # @req: REQ-RV32IMAC
        step("Verify: starts with TX empty")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        """
        **Given:** Fresh UART model
        **When:** Reading LSR
        **Then:** TX empty and TX idle bits are set
        """
        val uart = Rv32Uart.create()
        val lsr = uart.read_reg(UART_LSR)
        expect((lsr and 0x60)).to_equal(0x60)

    it "buffers transmitted bytes":
        # @req: REQ-INTEGRATION-HARDWARE-002
        step("Verify: buffers transmitted bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        """
        **Given:** UART model
        **When:** Writing to THR
        **Then:** Byte appears in TX output buffer
        """
        var uart = Rv32Uart.create()
        uart.write_reg(UART_THR, 0x48)  # 'H'
        uart.write_reg(UART_THR, 0x65)  # 'e'
        expect(uart.tx_count).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(uart.consume_tx()).to_equal(0x48)
        expect(uart.consume_tx()).to_equal(0x65)

# ============================================================================
# Timer Model Tests
# ============================================================================

describe "RV32 Timer Model":
    """
    ## Timer Peripheral Verification
    """

    it "increments mtime on tick":
        # @req: REQ-INTEGRATION-HARDWARE-003
        step("Verify: increments mtime on tick")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var timer = Rv32Clint.create(1)
        timer.tick()
        timer.tick()
        timer.tick()
        expect(timer.read(0xBFF8)).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    it "generates interrupt when mtime >= mtimecmp":
        # @req: REQ-INTEGRATION-HARDWARE-004
        step("Verify: generates interrupt when mtime >= mtimecmp")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var timer = Rv32Clint.create(1)
        timer.write(0x4000, 5)
        timer.tick()
        timer.tick()
        expect(timer.get_mtip(0)).to_equal(false)
        timer.tick()
        timer.tick()
        timer.tick()
        expect(timer.get_mtip(0)).to_equal(true)

# ============================================================================
# SRAM Model Tests
# ============================================================================

describe "RV32 SRAM Model":
    """
    ## SRAM Verification
    """

    it "reads back written data":
        # @req: REQ-INTEGRATION-HARDWARE-005
        step("Verify: reads back written data")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var sram = Rv32Ram.create(16)
        sram.write32(0, 0xDEADBEEF)
        expect(sram.read32(0).value).to_equal(0xDEADBEEF)

    it "supports byte-enable writes":
        # @req: REQ-INTEGRATION-HARDWARE-006
        step("Verify: supports byte-enable writes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var sram = Rv32Ram.create(16)
        sram.write32(0, 0x12345678)
        sram.write8(0, 0xAA)
        expect(sram.read32(0).value and 0xFF).to_equal(0xAA)

# ============================================================================
# Bus Decode Tests
# ============================================================================

describe "RV32 Bus Address Decode":
    """
    ## Memory Map Verification
    """

    it "routes ROM addresses correctly":
        # @req: REQ-INTEGRATION-HARDWARE-007
        step("Verify: routes ROM addresses correctly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val bus = Rv32Bus.create(0x1000, 1)
        expect(bus.read32(0x00001000).fault).to_equal(true)

    it "routes SRAM addresses correctly":
        # @req: REQ-INTEGRATION-HARDWARE-008
        step("Verify: routes SRAM addresses correctly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val bus = Rv32Bus.create(0x1000, 1)
        expect(bus.write32(0x80000100, 0xABCD1234).fault).to_equal(false)
        expect(bus.read32(0x80000100).value).to_equal(0xABCD1234)

    it "routes UART addresses correctly":
        # @req: REQ-INTEGRATION-HARDWARE-009
        step("Verify: routes UART addresses correctly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val bus = Rv32Bus.create(0x1000, 1)
        val platform = RiscvPlatformProfile.qemu_virt_rv32()
        expect(bus.write8(platform.uart_base, 0x41).fault).to_equal(false)
        expect(bus.uart.consume_tx()).to_equal(0x41)

    it "routes Timer addresses correctly":
        # @req: REQ-INTEGRATION-HARDWARE-010
        step("Verify: routes Timer addresses correctly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val bus = Rv32Bus.create(0x1000, 1)
        val platform = RiscvPlatformProfile.qemu_virt_rv32()
        bus.write32(platform.clint_base + 0x4000, 3)
        bus.tick()
        bus.tick()
        expect(bus.clint.get_mtip(0)).to_equal(false)
        bus.tick()
        expect(bus.clint.get_mtip(0)).to_equal(true)
