# Exercise the production path owner before emitting the CI success value.
use std.nogc_sync_mut.path.{normalize, normalize_path}

fn main() -> i64:
    val canonical = normalize("/usr//bin/./tmp/../local")
    if canonical != "/usr/bin/local": return 1
    if normalize("") != ".": return 2
    if normalize("a/../b") != "b": return 3
    if normalize("../../a") != "../../a": return 4
    if normalize("/../../x") != "/x": return 5
    if normalize_path("alpha\\beta\\..\\gamma") != "alpha/gamma": return 6
    print canonical
    0
