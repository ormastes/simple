#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) buffer Framebuffer { uint pixels[]; } fb;
layout(push_constant) uniform Push { uint color; uint width; uint height; uint reserved[13]; } pc;
void main() {
    uint index = gl_GlobalInvocationID.x;
    uint count = pc.width * pc.height;
    if (index < count) fb.pixels[index] = pc.color;
}
