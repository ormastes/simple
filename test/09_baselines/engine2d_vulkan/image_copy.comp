#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, binding = 0) buffer Framebuffer { uint pixels[]; } fb;
layout(std430, binding = 1) readonly buffer Source { uint pixels[]; } src;
layout(push_constant) uniform Push {
    int x; int y; int width; int height;
    int fb_width; int fb_height;
    int clip_x; int clip_y; int clip_width; int clip_height;
    int clip_enabled; int opacity_milli; int composite_mode;
    int src_width; int src_height; int reserved;
} pc;
void main() {
    int lx = int(gl_GlobalInvocationID.x);
    int ly = int(gl_GlobalInvocationID.y);
    if (lx >= pc.width || ly >= pc.height) return;
    int dx = pc.x + lx, dy = pc.y + ly;
    if (dx < 0 || dy < 0 || dx >= pc.fb_width || dy >= pc.fb_height) return;
    if (pc.clip_enabled != 0 &&
        (dx < pc.clip_x || dy < pc.clip_y ||
         dx >= pc.clip_x + pc.clip_width || dy >= pc.clip_y + pc.clip_height)) return;
    int sx = lx * pc.src_width / pc.width;
    int sy = ly * pc.src_height / pc.height;
    fb.pixels[dy * pc.fb_width + dx] = src.pixels[sy * pc.src_width + sx];
}
