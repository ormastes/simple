#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, std430) buffer Framebuffer { uint pixels[]; } fb;
layout(push_constant) uniform Push {
    int x; int y; int width; int height; uint color; int fb_width; int fb_height;
    int clip_x; int clip_y; int clip_width; int clip_height; int clip_enabled;
    int reserved[4];
} pc;
void main() {
    int px = pc.x + int(gl_GlobalInvocationID.x);
    int py = pc.y + int(gl_GlobalInvocationID.y);
    if (px < pc.x || py < pc.y || px >= pc.x + pc.width || py >= pc.y + pc.height ||
        px < 0 || py < 0 || px >= pc.fb_width || py >= pc.fb_height) return;
    if (pc.clip_enabled != 0 && (px < pc.clip_x || py < pc.clip_y ||
        px >= pc.clip_x + pc.clip_width || py >= pc.clip_y + pc.clip_height)) return;
    fb.pixels[py * pc.fb_width + px] = pc.color;
}
