# WS-D6 frame-level benchmark: compositor occlusion culling.
#
# Renders the SAME window layout twice through Compositor.render_all() -- once
# with culling OFF (the full-redraw reference) and once ON -- and reports the
# WHOLE-FRAMEBUFFER mismatch count plus wall time for each. A culling bug is
# invisible to a region-scoped check, so the oracle spans every pixel; `culls`
# is the anti-vacuity counter, without which a 0-mismatch result would pass
# trivially whenever nothing was skipped.
#
# Run:  SIMPLE_TIMEOUT_SECONDS=7200 bin/simple run test/perf/graphics_2d/bench_occlusion_cull.spl
#
# NOTE: render_all() is heavily interpreter-bound here (a jit-fallback drops
# the web-engine module), so absolute times are not desktop-representative --
# only the culled/full ratio within one run is meaningful.

use common.ui.builder.{build_tree, column, label}
use nogc_sync_mut.ui.session.{UISession}
use os.compositor.compositor.{Compositor, wm_set_occlusion_culling, wm_occlusion_culled_count}
use os.compositor.display_backend.{CompositorBackend}
use os.compositor.host_compositor_entry.{HeadlessHostCompositorBackend, headless_host_compositor_pixels}
use os.compositor.simple_web_window_renderer.{simple_web_content_render_request_with_active_theme}
use os.compositor.web_render_surface.{compositor_render_request_artifact}
use std.gc_async_mut.ui.gui_content_renderer.{gui_session_content_frame}

extern fn rt_time_now_nanos() -> i64
fn ms() -> i64:
    rt_time_now_nanos() / 1000000

val SW: i32 = 200
val SH: i32 = 150

fn render(layout: [i32], pixel_content: bool, culling: bool) -> [u32]:
    wm_set_occlusion_culling(culling)
    val headless = HeadlessHostCompositorBackend.new(SW, SH)
    val backend: CompositorBackend = headless
    var comp = Compositor.with_backends(backend, nil, SW, SH)
    var i = 0
    while i + 3 < layout.len().to_i32():
        val w = comp.create_window("w" + (i / 4).to_text(), layout[i], layout[i+1], layout[i+2], layout[i+3])
        if pixel_content:
            val cw = layout[i+2] - 8
            val ch = layout[i+3] - 36
            if cw > 0 and ch > 0:
                val handle = comp.create_pixel_content(cw, ch, 0xFF204060u32 + i.to_u32())
                if handle > 0:
                    comp.attach_window_pixel_content(w.to_u64(), handle)
        i = i + 4
    comp.render_all()
    wm_set_occlusion_culling(true)
    headless_host_compositor_pixels(headless)

fn diffs(a: [u32], b: [u32]) -> i32:
    if a.len() != b.len():
        return -1
    var d = 0
    var i = 0
    while i < a.len().to_i32():
        if a[i] != b[i]:
            d = d + 1
        i = i + 1
    d

fn check(name: text, layout: [i32], pixel_content: bool):
    val t0 = ms()
    val r = render(layout, pixel_content, false)
    val t1 = ms()
    val c = render(layout, pixel_content, true)
    val t2 = ms()
    print(name + " | px=" + r.len().to_text() + " mismatches=" + diffs(r, c).to_text()
        + " culls=" + wm_occlusion_culled_count().to_text()
        + " ms_full=" + (t1 - t0).to_text() + " ms_culled=" + (t2 - t1).to_text())

fn main():
    check("EXPENSIVE-CULL px", [40,40,100,60, 15,12,175,130], true)
    check("contained        ", [40,40,100,60, 15,12,175,130], false)
    check("union-cover      ", [30,25,120,90, 20,15,90,115, 100,15,95,115], false)
    check("no-cull-identical", [20,16,150,110, 20,16,150,110], false)
