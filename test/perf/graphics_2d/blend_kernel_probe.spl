"""Direct probe of the native blend row extern vs the Simple reference formula."""

use std.nogc_sync_mut.gpu.engine2d.simd_kernels.{engine2d_simd_blend_row_u32, _scalar_blend_row}

fn ref_blend(d: i64, s: i64) -> i64:
    val sa = (s >> 24) & 0xFF
    if sa == 255:
        return s
    if sa == 0:
        return d
    val da = (d >> 24) & 0xFF
    val inv = 255 - sa
    val dw = (da * inv) / 255
    val oa = sa + dw
    val r = (((s >> 16) & 0xFF) * sa + ((d >> 16) & 0xFF) * dw) / oa
    val g = (((s >> 8) & 0xFF) * sa + ((d >> 8) & 0xFF) * dw) / oa
    val b = ((s & 0xFF) * sa + (d & 0xFF) * dw) / oa
    (oa << 24) | (r << 16) | (g << 8) | b

fn main():
    val cases: [i64] = [0x11102030, 0x80102030, 0xFF102030, 0x00102030]
    var k: i64 = 0
    while k < 4:
        val s = cases[k.to_i32()]
        val d: i64 = 0x11405060
        var dr: [u32] = [d as u32; 1]
        val sr: [u32] = [s as u32; 1]
        val got = engine2d_simd_blend_row_u32(dr, sr)
        println("s=" + s.to_text() + " d=" + d.to_text() + " native=" + got[0].to_text() + " ref=" + ref_blend(d, s).to_text())
        k = k + 1
