# 8K retained software-frame readback/checksum benchmark.
# Measures sparse old+new cursor damage, not full dynamic repaint.

use std.gc_async_mut.gpu.engine2d.backend_software.{SoftwareBackend}
use common.ui.window_scene.{wm_content_frame_checksum}

extern fn rt_time_now_nanos() -> i64

fn sort_i64(mut values: [i64]):
    var i = 1
    while i < values.len():
        val value = values[i]
        var j = i
        while j > 0 and values[j - 1] > value:
            values[j] = values[j - 1]
            j = j - 1
        values[j] = value
        i = i + 1

fn main():
    val width: i32 = 7680
    val height: i32 = 4320
    val frames: i32 = 40
    var backend = SoftwareBackend.create()
    if not backend.init(width, height):
        println("DAMAGE_CHECKSUM_8K status=FAIL reason=init")
        return
    backend.clear(0xFF101820u32)
    val seeded = backend.read_pixels_damaged_with_checksum(64)
    backend.present()
    var samples: [i64] = []
    var prior_x: i32 = 100
    var frame = 0
    while frame < frames:
        val next_x = 100 + ((frame + 1) % 120)
        backend.draw_rect_filled(prior_x, 100, 16, 16, 0xFF101820u32)
        backend.draw_rect_filled(next_x, 100, 16, 16, 0xFFFFFFFFu32)
        val start = rt_time_now_nanos()
        val readback = backend.read_pixels_damaged_with_checksum(64)
        samples.push(rt_time_now_nanos() - start)
        if readback.1 == 0u64:
            println("DAMAGE_CHECKSUM_8K status=FAIL reason=zero-checksum")
            backend.shutdown()
            return
        backend.present()
        prior_x = next_x
        frame = frame + 1
    sort_i64(samples)
    val final_readback = backend.read_pixels_damaged_with_checksum(64)
    val oracle = wm_content_frame_checksum(backend.read_pixels())
    val parity = final_readback.1 == oracle
    val p50 = samples[samples.len() / 2]
    val p95 = samples[(samples.len() * 95) / 100]
    println("DAMAGE_CHECKSUM_8K status=" +
        (if parity: "PASS" else: "FAIL") +
        " width=" + width.to_text() + " height=" + height.to_text() +
        " frames=" + frames.to_text() +
        " p50_ns=" + p50.to_text() + " p95_ns=" + p95.to_text() +
        " target_ns=12500000 checksum=" + oracle.to_text() +
        " seed_checksum=" + seeded.1.to_text())
    backend.shutdown()

main()
