            Variable { name: "x", value: "1", value_type: "i64" },
            Variable { name: "y", value: "2", value_type: "i64" },
            Variable { name: "result", value: "3", value_type: "i64" }
        ]

        expect len(variables) == 3
        expect variables[0].name == "x"

