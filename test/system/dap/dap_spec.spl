describe "DAP Variable Inspection":

    it "should create variable info":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-DAP-015
        step("Verify: should create variable info")
