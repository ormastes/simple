# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# audio_group_spec
#
# Tests AudioGroupTree from std.nogc_sync_mut.engine.audio.audio_group
# Verifies hierarchical volume control, mute propagation, and tree structure.

use std.spec.step

use std.spec
use std.common.engine.units.{Volume}
use std.nogc_sync_mut.engine.audio.audio_group.{AudioGroup, AudioGroupTree}

describe "AudioGroupTree — empty tree":
    # @manual scenario evidence

    it "new tree has no groups":
        # @req REQ-SSPEC-SYSTEM
        step("new tree has no groups")
        val tree = AudioGroupTree.new()
        val g = tree.get_group("anything")
        expect(g).to_be_nil()

describe "AudioGroupTree — add groups":

    it "add root group makes it retrievable":
        # @req REQ-SSPEC-SYSTEM
        step("add root group makes it retrievable")
        var tree = AudioGroupTree.new()
        tree.add_group("master", "")
        val g = tree.get_group("master")
        expect(g.name).to_equal("master")

    it "add child group with correct parent":
        # @req REQ-SSPEC-SYSTEM
        step("add child group with correct parent")
        var tree = AudioGroupTree.new()
        tree.add_group("master", "")
        tree.add_group("sfx", "master")
        val g = tree.get_group("sfx")
        expect(g.name).to_equal("sfx")

describe "AudioGroupTree — effective volume":

    it "parent 0.5 times child 0.8 equals 0.4":
        # @req REQ-SSPEC-SYSTEM
        step("parent 0.5 times child 0.8 equals 0.4")
        var tree = AudioGroupTree.new()
        tree.add_group("master", "")
        tree.add_group("sfx", "master")
        tree.set_volume("master", Volume(value: 0.5))
        tree.set_volume("sfx", Volume(value: 0.8))
        val vol = tree.get_effective_volume("sfx")
        expect(vol.value > 0.39).to_equal(true)
        expect(vol.value < 0.41).to_equal(true)

describe "AudioGroupTree — effective muted":

    it "mute parent makes child effectively muted":
        # @req REQ-SSPEC-SYSTEM
        step("mute parent makes child effectively muted")
        var tree = AudioGroupTree.new()
        tree.add_group("master", "")
        tree.add_group("sfx", "master")
        tree.set_muted("master", true)
        val muted = tree.get_effective_muted("sfx")
        expect(muted).to_equal(true)

describe "AudioGroupTree — set volume":

    it "set_volume updates group volume":
        # @req REQ-SSPEC-SYSTEM
        step("set_volume updates group volume")
        var tree = AudioGroupTree.new()
        tree.add_group("master", "")
        tree.set_volume("master", Volume(value: 0.7))
        val vol = tree.get_effective_volume("master")
        expect(vol.value > 0.69).to_equal(true)
        expect(vol.value < 0.71).to_equal(true)
