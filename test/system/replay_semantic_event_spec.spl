"""
## Purpose and audience
Verifies the replay semantic event behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

use std.spec
use std.nogc_sync_mut.replay.semantic.trace_events.{SemanticEvent, SemanticEventKind, SEMANTIC_EVENT_SIZE}

# @req: REQ-SYSTEM-ReplaySemanticEvent-001
describe "SemanticEventKind to_i32":
    it "FunctionEnter to_i32 returns 0":
        # @req: REQ-SYSTEM-ReplaySemanticEvent-001
        step("Verify: FunctionEnter to_i32 returns 0")
        val k = SemanticEventKind.FunctionEnter
        expect(k.to_i32()).to_equal(0)  # oracle: value fixed by the spec contract

    it "FunctionExit to_i32 returns 1":
        # @req: REQ-SYSTEM-ReplaySemanticEvent-001
        step("Verify: FunctionExit to_i32 returns 1")
        val k = SemanticEventKind.FunctionExit
        expect(k.to_i32()).to_equal(1)  # oracle: value fixed by the spec contract

    it "ObjectAlloc to_i32 returns 3":
        # @req: REQ-SYSTEM-ReplaySemanticEvent-001
        step("Verify: ObjectAlloc to_i32 returns 3")
        val k = SemanticEventKind.ObjectAlloc
        expect(k.to_i32()).to_equal(3)  # oracle: value fixed by the spec contract

    it "AsyncSpawn to_i32 returns 8":
        # @req: REQ-SYSTEM-ReplaySemanticEvent-001
        step("Verify: AsyncSpawn to_i32 returns 8")
        val k = SemanticEventKind.AsyncSpawn
        expect(k.to_i32()).to_equal(8)  # oracle: value fixed by the spec contract

describe "SemanticEventKind from_i32 roundtrip":
    it "from_i32(0) gives FunctionEnter":
        # @req: REQ-SYSTEM-ReplaySemanticEvent-001
        step("Verify: from_i32(0) gives FunctionEnter")
        val k = SemanticEventKind.from_i32(0)
        expect(k.to_i32()).to_equal(0)  # oracle: value fixed by the spec contract

    it "from_i32(11) gives AsyncComplete":
        # @req: REQ-SYSTEM-ReplaySemanticEvent-001
        step("Verify: from_i32(11) gives AsyncComplete")
        val k = SemanticEventKind.from_i32(11)
        expect(k.to_i32()).to_equal(11)  # oracle: value fixed by the spec contract

describe "SemanticEvent create":
    it "create sets kind field correctly":
        # @req: REQ-SYSTEM-ReplaySemanticEvent-001
        step("Verify: create sets kind field correctly")
        val ev = SemanticEvent.create(SemanticEventKind.VariableWrite)
        expect(ev.kind).to_equal(SemanticEventKind.VariableWrite.to_i32())

    it "create initialises seq to 0":
        # @req: REQ-SYSTEM-ReplaySemanticEvent-001
        step("Verify: create initialises seq to 0")
        val ev = SemanticEvent.create(SemanticEventKind.ObjectDrop)
        expect(ev.seq).to_equal(0)  # oracle: value fixed by the spec contract

    it "event_kind() roundtrips back to BorrowStart":
        # @req: REQ-SYSTEM-ReplaySemanticEvent-001
        step("Verify: event_kind() roundtrips back to BorrowStart")
        val ev = SemanticEvent.create(SemanticEventKind.BorrowStart)
        val k = ev.event_kind()
        expect(k.to_i32()).to_equal(6)  # oracle: value fixed by the spec contract

    it "SEMANTIC_EVENT_SIZE is 68":
        # @req: REQ-SYSTEM-ReplaySemanticEvent-001
        step("Verify: SEMANTIC_EVENT_SIZE is 68")
        expect(SEMANTIC_EVENT_SIZE).to_equal(68)  # oracle: value fixed by the spec contract
