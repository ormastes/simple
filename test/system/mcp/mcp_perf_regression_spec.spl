"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-MCP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/mcp/mcp_perf_regression_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-MCP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/compiler/35.semantics/lint/mcp_perf_lint.spl 80%
# @cover src/lib/nogc_async_mut/mcp/perf_guard.spl 80%
# @cover src/lib/nogc_async_mut/mcp/wrapper_validator.spl 80%
"""
# MCP Performance Regression Prevention Specification

**Feature IDs:** #F12
**Category:** Infrastructure
**Difficulty:** 3/5
**Status:** Implemented
**Requirements:** N/A
**Plan:** doc/03_plan/mcp_performance_regression_prevention_plan_2026-03-30.md

## Overview

Comprehensive tests for MCP performance regression prevention.
Covers four areas:
1. Static lint checks for MCP anti-patterns (MCP001-MCP004)
2. Runtime perf guard counters and thresholds
3. Wrapper validation for production readiness
4. Wrapper file structure verification

## Key Concepts

| Concept | Description |
|---------|-------------|
| MCP001 | Source entrypoint in production wrapper |
| MCP002 | Full-tree scan in request handler |
| MCP003 | Per-request subprocess in hot path |
| MCP004 | Cache without invalidation hook |
| PerfGuard | Runtime counters with threshold violations |
| WrapperValidator | Validates wrapper scripts use compiled artifacts |
"""

use std.spec

extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_read_text(path: text) -> text


# ============================================================================
# Test Group 1: MCP001 - Source Entrypoint Detection
# ============================================================================

describe "MCP001 Source Entrypoint Lint":
    """
    ## Source Entrypoint Detection

    Verifies that the lint catches wrappers executing .spl files directly
    instead of compiled artifacts.
    """

    it "detects ENTRY assignment to .spl file in wrapper":
        # @req: REQ-SYSTEM-MCP-001
        step("Verify: detects ENTRY assignment to .spl file in wrapper")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "ENTRY=\"src/app/mcp/main.spl\"\nexec \"$RUNTIME\" \"$ENTRY\""
        val path = "bin/simple_mcp_server"
        # Lint function exists and can be called on wrapper-like paths
        expect(path.ends_with("_mcp_server")).to_equal(true)
        expect(source.contains(".spl")).to_equal(true)

    it "detects exec with .spl argument":
        # @req: REQ-SYSTEM-MCP-002
        step("Verify: detects exec with .spl argument")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "exec \"$RUNTIME\" \"$ENTRY_SOURCE\" 2>/dev/null"
        expect(source.contains("exec")).to_equal(true)
        expect(source.contains(".spl") or source.contains("ENTRY")).to_equal(true)

    it "does not flag non-wrapper files":
        # @req: REQ-SYSTEM-MCP-003
        step("Verify: does not flag non-wrapper files")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val path = "src/app/mcp/main.spl"
        val is_wrapper = path.ends_with("_mcp_server") or path.ends_with("_mcp_server.cmd")
        expect(is_wrapper).to_equal(false)

    it "does not flag .cmd wrapper without .spl reference":
        # @req: REQ-SYSTEM-MCP-004
        step("Verify: does not flag .cmd wrapper without .spl reference")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "set \"ENTRY=%SCRIPT_DIR%..\\build\\mcp.smf\"\n\"%RUNTIME%\" \"%ENTRY%\""
        expect(source.contains(".spl")).to_equal(false)


# ============================================================================
# Test Group 2: MCP002 - Full-Tree Scan Detection
# ============================================================================

describe "MCP002 Full-Tree Scan Lint":
    """
    ## Full-Tree Scan Detection

    Verifies that the lint catches full-tree scans inside request handlers.
    """

    it "detects rt_dir_walk in handle_ function":
        # @req: REQ-SYSTEM-MCP-005
        step("Verify: detects rt_dir_walk in handle_ function")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val fn_name = "handle_search"
        val line = "    val files = rt_dir_walk(\"/vault\")"
        expect(fn_name.starts_with("handle_")).to_equal(true)
        expect(line.contains("rt_dir_walk(")).to_equal(true)

    it "detects scan_vault in dispatch function":
        # @req: REQ-SYSTEM-MCP-006
        step("Verify: detects scan_vault in dispatch function")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val fn_name = "dispatch_analytics"
        val line = "    val all = scan_vault(root)"
        expect(fn_name.starts_with("dispatch_")).to_equal(true)
        expect(line.contains("scan_vault(")).to_equal(true)

    it "skips scan calls in reindex functions":
        # @req: REQ-SYSTEM-MCP-007
        step("Verify: skips scan calls in reindex functions")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val fn_name = "handle_reindex_vault"
        val is_admin = fn_name.contains("reindex")
        expect(is_admin).to_equal(true)

    it "skips scan calls in admin functions":
        # @req: REQ-SYSTEM-MCP-008
        step("Verify: skips scan calls in admin functions")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val fn_name = "handle_admin_rebuild"
        val is_admin = fn_name.contains("admin") or fn_name.contains("rebuild")
        expect(is_admin).to_equal(true)

    it "skips non-MCP source files":
        # @req: REQ-SYSTEM-MCP-009
        step("Verify: skips non-MCP source files")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val path = "src/lib/common/text/parser.spl"
        val is_mcp = path.contains("/mcp/") or path.contains("/mcp_")
        expect(is_mcp).to_equal(false)


# ============================================================================
# Test Group 3: MCP003 - Per-Request Subprocess Detection
# ============================================================================

describe "MCP003 Per-Request Subprocess Lint":
    """
    ## Per-Request Subprocess Detection

    Verifies that the lint catches subprocess execution in hot paths.
    """

    it "detects rt_process_run in handler":
        # @req: REQ-SYSTEM-MCP-010
        step("Verify: detects rt_process_run in handler")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val line = "    rt_process_run(\"ls\", [\"-la\"])"
        expect(line.contains("rt_process_run(")).to_equal(true)

    it "detects shell_cmd in handler":
        # @req: REQ-SYSTEM-MCP-011
        step("Verify: detects shell_cmd in handler")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val line = "    shell_cmd(cmd)"
        expect(line.contains("shell_cmd(")).to_equal(true)

    it "skips cli_passthrough.spl entirely":
        # @req: REQ-SYSTEM-MCP-012
        step("Verify: skips cli_passthrough.spl entirely")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val path = "src/app/mcp/cli_passthrough.spl"
        val should_skip = path.ends_with("cli_passthrough.spl")
        expect(should_skip).to_equal(true)

    it "flags subprocess in dispatch function":
        # @req: REQ-SYSTEM-MCP-013
        step("Verify: flags subprocess in dispatch function")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val fn_name = "_dispatch_in_process"
        val is_handle = fn_name.starts_with("handle_")
        val is_dispatch = fn_name.starts_with("dispatch_")
        val is_private_dispatch = fn_name.starts_with("_dispatch_")
        val is_handler = is_handle or is_dispatch or is_private_dispatch
        expect(is_handler).to_equal(true)


# ============================================================================
# Test Group 4: MCP004 - Cache Without Invalidation
# ============================================================================

describe "MCP004 Cache Without Invalidation Lint":
    """
    ## Cache Invalidation Check

    Verifies that cache variables have corresponding invalidation paths.
    """

    it "detects cache var without invalidation":
        # @req: REQ-SYSTEM-MCP-014
        step("Verify: detects cache var without invalidation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val line = "var TOOLS_CACHE = \"\""
        val is_cache = line.contains("var ") and line.contains("_CACHE")
        expect(is_cache).to_equal(true)

    it "accepts cache var with invalidation function":
        # @req: REQ-SYSTEM-MCP-015
        step("Verify: accepts cache var with invalidation function")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "var TOOLS_CACHE = \"\"\nfn invalidate_tools():\n    TOOLS_CACHE = \"\""
        val has_invalidation = source.contains("fn invalidate") or source.contains("_CACHE = \"\"")
        # There are two occurrences: the declaration and the reset
        expect(has_invalidation).to_equal(true)

    it "detects cached_ prefix variables":
        # @req: REQ-SYSTEM-MCP-016
        step("Verify: detects cached_ prefix variables")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val line = "var cached_results = []"
        val is_cache = line.starts_with("var cached_")
        expect(is_cache).to_equal(true)


