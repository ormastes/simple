# ============================================================================
# Test Group 9: MCP Main Server Perf Characteristics
# ============================================================================

describe "MCP Server Performance Structure":
    """
    ## Server Performance Structure

    Verifies that the MCP main server has the expected performance
    characteristics: caches, no repeated scans, in-process handlers.
    """

    it "MCP main.spl has tool dispatch cache":
        # @req: REQ-SYSTEM-MCP-042
        step("Verify: MCP main.spl has tool dispatch cache")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = rt_file_read_text("src/app/mcp/main.spl")
        expect(source.contains("TOOLS_CACHE")).to_equal(true)

    it "MCP main.spl has init response cache":
        # @req: REQ-SYSTEM-MCP-043
        step("Verify: MCP main.spl has init response cache")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = rt_file_read_text("src/app/mcp/main.spl")
        expect(source.contains("INIT_CACHE")).to_equal(true)

    it "MCP main.spl uses table-driven dispatch":
        # @req: REQ-SYSTEM-MCP-044
        step("Verify: MCP main.spl uses table-driven dispatch")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = rt_file_read_text("src/app/mcp/main.spl")
        val table_source = rt_file_read_text("src/app/mcp/tool_table.spl")
        expect(source.contains("dispatch_tool")).to_equal(true)
        expect(source.contains("use .tool_table")).to_equal(true)
        expect(table_source.contains("get_tool_table")).to_equal(true)

    it "MCP main.spl has in-process handlers for core tools":
        # @req: REQ-SYSTEM-MCP-045
        step("Verify: MCP main.spl has in-process handlers for core tools")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = rt_file_read_text("src/app/mcp/main_dispatch.spl")
        expect(source.contains("_dispatch_in_process")).to_equal(true)

    it "MCP cli_passthrough is isolated from in-process handlers":
        # @req: REQ-SYSTEM-MCP-046
        step("Verify: MCP cli_passthrough is isolated from in-process handlers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = rt_file_read_text("src/app/mcp/main_dispatch.spl")
        val table_source = rt_file_read_text("src/app/mcp/tool_table.spl")
        # CLI passthrough is used only for handler_kind="cli"
        expect(source.contains("_dispatch_cli_direct")).to_equal(true)
        expect(source.contains("handle_cli_passthrough_direct")).to_equal(true)
        expect(table_source.contains("\"cli\"")).to_equal(true)
