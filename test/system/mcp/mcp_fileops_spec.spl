# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/lib/nogc_sync_mut/io/file_ops.spl 60%
# MCP file-operations tooling exercises the app.io.mod file primitives
# (write/read/exists/delete round-trip) on the real filesystem.

use std.spec.step

use std.spec
use app.io.mod (file_write, file_read, file_exists, file_delete, cwd)

val NL = "\n"

describe "MCP file operations":
    # @manual scenario evidence
    it "round-trips create, read, overwrite, and delete of a workspace file":
        # @req REQ-SSPEC-SYSTEM
        step("write a file, read it back, overwrite, re-read, then delete")
        val test_file = "/tmp/mcp_fileops_spec_roundtrip.txt"
        val content1 = "Initial content{NL}"
        val content2 = "Updated content{NL}"
        # oracle: file_write reports success on a fresh file
        assert_true(file_write(test_file, content1))
        # oracle: the file is visible via file_exists after creation
        assert_true(file_exists(test_file))
        # oracle: read-after-write returns the exact bytes written
        expect(file_read(test_file)).to_equal(content1)
        # oracle: overwrite succeeds and the new content replaces the old
        assert_true(file_write(test_file, content2))
        expect(file_read(test_file)).to_equal(content2)
        # oracle: delete removes the file from existence
        assert_true(file_delete(test_file))
        assert_false(file_exists(test_file))

    it "reads a missing file as empty text without creating it":
        # @req REQ-SSPEC-SYSTEM
        step("file_read on an absent path returns empty and leaves nothing behind")
        val absent = "/tmp/mcp_fileops_spec_absent_v2.txt"
        # oracle: documented miss behaviour is empty text, not a crash
        expect(file_read(absent)).to_equal("")
        assert_false(file_exists(absent))
