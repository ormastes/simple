"""
## Purpose and audience
Pins the observable execution contract of the system spec batch harness
(batch_1_test_23_system_spec.spl): every scenario asserts a concrete language/stdlib outcome that the
spec runner must report green for the batch lane to be trusted.
Audience: compiler and test-infrastructure engineers triaging batch runs.
## Operator workflow
Run `bin/simple test test/system/batch/batch_1_test_23_system_spec.spl` and read the per-scenario verdicts in the
`Results:` summary; each scenario asserts one externally visible outcome.
## Compatibility and limitations
Covers interpreter-path semantics exercised by batch lanes; native codegen
and performance envelopes are out of scope.
# @manual: primary
REQ-SYS-BATCH-003-001
doc/01_research/local/spec_batch.md
doc/03_plan/sys_test/spec_batch.md
doc/04_architecture/spec_batch.md
doc/05_design/spec_batch.md
"""
# @req: REQ-SYS-BATCH-003-001
# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%
# @cover src/compiler/80.driver/pipeline.spl 60%

use std.spec

describe "system test batch execution contract":
    it "integer division and remainder follow truncation":
        step("Verify: integer division and remainder follow truncation")
        # @req: REQ-SYS-BATCH-003-001
        expect(17 / 5).to_equal(3) # oracle: truncated quotient
        expect(17 % 5).to_equal(2) # oracle: remainder

    it "dict lookup returns the stored value per key":
        step("Verify: dict lookup returns the stored value per key")
        # @req: REQ-SYS-BATCH-003-002
        val d = {"alpha": 1, "beta": 2}
        expect(d["beta"]).to_equal(2) # oracle: value stored under "beta"
        expect(d["alpha"]).to_equal(1)

    it "repetition via loop builds the expected run":
        step("Verify: repetition via loop builds the expected run")
        # @req: REQ-SYS-BATCH-003-003
        var run = ""
        for i in 0..4:
            run = run + "ab"
        expect(run.len()).to_equal(8) # oracle: 4 iterations x 2 chars
        expect(run).to_equal("abababab")

    it "array push grows length and preserves order":
        step("Verify: array push grows length and preserves order")
        # @req: REQ-SYS-BATCH-003-004
        var xs = [10]
        xs.push(20)
        xs.push(30)
        expect(xs.len()).to_equal(3) # oracle: 1 initial + 2 pushes
        expect(xs[1]).to_equal(20) # oracle: FIFO order preserved

    it "recursive factorial computes 5! exactly":
        step("Verify: recursive factorial computes 5! exactly")
        # @req: REQ-SYS-BATCH-003-005
        fn fact(n: i64) -> i64:
            if n <= 1:
                return 1
            n * fact(n - 1)
        expect(fact(5)).to_equal(120) # oracle: 5! = 120
        expect(fact(0)).to_equal(1) # oracle: base case

