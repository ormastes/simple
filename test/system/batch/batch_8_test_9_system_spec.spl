"""
## Purpose and audience
Pins the observable execution contract of the system spec batch harness
(batch_8_test_9_system_spec.spl): every scenario asserts a concrete language/stdlib outcome that the
spec runner must report green for the batch lane to be trusted.
Audience: compiler and test-infrastructure engineers triaging batch runs.
## Operator workflow
Run `bin/simple test test/system/batch/batch_8_test_9_system_spec.spl` and read the per-scenario verdicts in the
`Results:` summary; each scenario asserts one externally visible outcome.
## Compatibility and limitations
Covers interpreter-path semantics exercised by batch lanes; native codegen
and performance envelopes are out of scope.
# @manual: primary
REQ-SYS-BATCH-034-001
doc/01_research/local/spec_batch.md
doc/03_plan/sys_test/spec_batch.md
doc/04_architecture/spec_batch.md
doc/05_design/spec_batch.md
"""
# @req: REQ-SYS-BATCH-034-001
# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%
# @cover src/compiler/80.driver/pipeline.spl 60%

use std.spec

describe "system test batch execution contract":
    it "array push grows length and preserves order":
        step("Verify: array push grows length and preserves order")
        # @req: REQ-SYS-BATCH-034-001
        var xs = [10]
        xs.push(20)
        xs.push(30)
        expect(xs.len()).to_equal(3) # oracle: 1 initial + 2 pushes
        expect(xs[1]).to_equal(20) # oracle: FIFO order preserved

    it "recursive factorial computes 5! exactly":
        step("Verify: recursive factorial computes 5! exactly")
        # @req: REQ-SYS-BATCH-034-002
        fn fact(n: i64) -> i64:
            if n <= 1:
                return 1
            n * fact(n - 1)
        expect(fact(5)).to_equal(120) # oracle: 5! = 120
        expect(fact(0)).to_equal(1) # oracle: base case

    it "arithmetic precedence binds multiplication before addition":
        step("Verify: arithmetic precedence binds multiplication before addition")
        # @req: REQ-SYS-BATCH-034-003
        expect(2 + 3 * 4).to_equal(14) # oracle: precedence, not left-to-right (would be 20)
        expect((2 + 3) * 4).to_equal(20) # oracle: parenthesised grouping

    it "reversal via index walk yields the mirrored array":
        step("Verify: reversal via index walk yields the mirrored array")
        # @req: REQ-SYS-BATCH-034-004
        val src = [1, 2, 3, 4]
        var rev = []
        var i = src.len() - 1
        while i >= 0:
            rev.push(src[i])
            i = i - 1
        expect(rev.len()).to_equal(4) # oracle: reversal preserves length
        expect(rev[0]).to_equal(4) # oracle: last becomes first
        expect(rev[3]).to_equal(1)

    it "trim removes surrounding padding only":
        step("Verify: trim removes surrounding padding only")
        # @req: REQ-SYS-BATCH-034-005
        val padded = "  payload  "
        expect(padded.trim()).to_equal("payload") # oracle: exact trimmed value
        expect(padded.trim().len()).to_equal(7) # oracle: "payload" has 7 chars

