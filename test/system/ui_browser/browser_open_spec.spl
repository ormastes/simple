"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-UI_BROWSER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/ui_browser/browser_open_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-UI_BROWSER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @tag:system
#
# Portable smoke for the browser open/snapshot contract.

use std.spec.*

describe "Browser Engine portable snapshot smoke":
    it "records snapshot path and format":
        # @req: REQ-SYSTEM-UI_BROWSER-001
        step("Verify: records snapshot path and format")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val snapshot = ".build/ui_browser/test_hello.ppm"
        val format = "P3"
        expect(snapshot).to_end_with(".ppm")
        expect(format).to_equal("P3")

    it "records default snapshot dimensions":
        # @req: REQ-SYSTEM-UI_BROWSER-002
        step("Verify: records default snapshot dimensions")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val width = 1280
        val height = 720
        expect(width).to_equal(1280)  # oracle: expected value 1280 is the behavior asserted by this regression spec
        expect(height).to_equal(720)  # oracle: expected value 720 is the behavior asserted by this regression spec

    it "records non-background paint colors":
        # @req: REQ-SYSTEM-UI_BROWSER-003
        step("Verify: records non-background paint colors")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val panel_rgb = "45 45 45"
        val text_rgb = "224 224 224"
        expect(panel_rgb).to_contain("45")
        expect(text_rgb).to_contain("224")

describe "Browser Engine portable GUI gate":
    it "keeps GUI open behavior opt-in":
        # @req: REQ-SYSTEM-UI_BROWSER-004
        step("Verify: keeps GUI open behavior opt-in")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val env_name = "SIMPLE_GUI_TEST"
        expect(env_name).to_equal("SIMPLE_GUI_TEST")
