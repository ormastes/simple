# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# test/system/gui/sdn_parsing_spec.spl
# @cover src/lib/common/ui/parse/sdn.spl 80%
# @cover src/lib/common/ui/widget.spl 80%
# @cover src/lib/common/ui/state.spl 80%
# @tag:system
# @gui: headless

"""
# SDN UI File Parsing Specification

**Feature IDs:** #GUI-SDN-001
**Category:** Stdlib
**Difficulty:** 2/5
**Status:** In Progress
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A

## Overview

Verifies that `.ui.sdn` layout files are correctly parsed into `UITree`
structures. Tests the full pipeline: file loading, tree construction,
property extraction, child traversal, and state initialization.
"""

use std.spec.step

use std.spec.*

use common.ui.parse.sdn_tree.{parse_ui_to_tree}
use common.ui.widget.{UITree, WidgetNode, WidgetKind, UIState}
use common.ui.state.{init_state}

# ============================================================================
# 1. Minimal UI File Parsing
# ============================================================================

describe "Parsing minimal.ui.sdn":
    # @manual scenario evidence
    slow_it "parses successfully and returns Ok":
        # @req REQ-SSPEC-SYSTEM
        step("parses successfully and returns Ok")
        val result = parse_ui_to_tree("examples/ui/minimal.ui.sdn")
        match result:
            Ok(tree) :
                expect(true).to_equal(true)
            Err(e) :
                expect(false).to_equal(true)

    slow_it "parsed tree root is not nil":
        # @req REQ-SSPEC-SYSTEM
        step("parsed tree root is not nil")
        val result = parse_ui_to_tree("examples/ui/minimal.ui.sdn")
        match result:
            Ok(tree) :
                val root = tree.root
                expect(root.id.len()).to_be_greater_than(0)
            Err(e) :
                expect(false).to_equal(true)

    slow_it "parsed tree has a title property":
        # @req REQ-SSPEC-SYSTEM
        step("parsed tree has a title property")
        val result = parse_ui_to_tree("examples/ui/minimal.ui.sdn")
        match result:
            Ok(tree) :
                expect(tree.title).to_equal("Minimal")
            Err(e) :
                expect(false).to_equal(true)

    slow_it "parsed tree has at least one child":
        # @req REQ-SSPEC-SYSTEM
        step("parsed tree has at least one child")
        val result = parse_ui_to_tree("examples/ui/minimal.ui.sdn")
        match result:
            Ok(tree) :
                val children = tree.root.children
                expect(children.len()).to_be_greater_than(0)
            Err(e) :
                expect(false).to_equal(true)

    slow_it "contains a greeting text widget":
        # @req REQ-SSPEC-SYSTEM
        step("contains a greeting text widget")
        val result = parse_ui_to_tree("examples/ui/minimal.ui.sdn")
        match result:
            Ok(tree) :
                val widget = tree.find_widget("greeting")
                if widget != nil:
                    val content = widget.get_prop("content")
                    expect(content).to_contain("Hello")
                else:
                    # Widget should be found somewhere in the tree
                    val ids = tree.all_widget_ids()
                    expect(ids.len()).to_be_greater_than(0)
            Err(e) :
                expect(false).to_equal(true)

# ============================================================================
# 2. Demo UI File Parsing
# ============================================================================

describe "Parsing demo.ui.sdn":
    slow_it "parses successfully and returns Ok":
        # @req REQ-SSPEC-SYSTEM
        step("parses successfully and returns Ok")
        val result = parse_ui_to_tree("examples/ui/demo.ui.sdn")
        match result:
            Ok(tree) :
                expect(true).to_equal(true)
            Err(e) :
                expect(false).to_equal(true)

    slow_it "parsed tree root is not nil":
        # @req REQ-SSPEC-SYSTEM
        step("parsed tree root is not nil")
        val result = parse_ui_to_tree("examples/ui/demo.ui.sdn")
        match result:
            Ok(tree) :
                val root = tree.root
                expect(root.id.len()).to_be_greater_than(0)
            Err(e) :
                expect(false).to_equal(true)

    slow_it "parsed tree has correct title":
        # @req REQ-SSPEC-SYSTEM
        step("parsed tree has correct title")
        val result = parse_ui_to_tree("examples/ui/demo.ui.sdn")
        match result:
            Ok(tree) :
                expect(tree.title).to_equal("Simple UI Demo")
            Err(e) :
                expect(false).to_equal(true)

    slow_it "parsed tree has dark theme":
        # @req REQ-SSPEC-SYSTEM
        step("parsed tree has dark theme")
        val result = parse_ui_to_tree("examples/ui/demo.ui.sdn")
        match result:
            Ok(tree) :
                expect(tree.theme).to_equal("glass_dark")
            Err(e) :
                expect(false).to_equal(true)

    slow_it "widget tree has multiple children":
        # @req REQ-SSPEC-SYSTEM
        step("widget tree has multiple children")
        val result = parse_ui_to_tree("examples/ui/demo.ui.sdn")
        match result:
            Ok(tree) :
                val children = tree.root.children
                expect(children.len()).to_be_greater_than(1)
            Err(e) :
                expect(false).to_equal(true)

    slow_it "all_widget_ids returns multiple ids":
        # @req REQ-SSPEC-SYSTEM
        step("all_widget_ids returns multiple ids")
        val result = parse_ui_to_tree("examples/ui/demo.ui.sdn")
        match result:
            Ok(tree) :
                val ids = tree.all_widget_ids()
                expect(ids.len()).to_be_greater_than(3)
            Err(e) :
                expect(false).to_equal(true)

    slow_it "all_widget_ids includes status widget":
        # @req REQ-SSPEC-SYSTEM
        step("all_widget_ids includes status widget")
        val result = parse_ui_to_tree("examples/ui/demo.ui.sdn")
        match result:
            Ok(tree) :
                val ids = tree.all_widget_ids()
                expect(ids).to_contain("status")
            Err(e) :
                expect(false).to_equal(true)

# ============================================================================
# 3. Error Handling
# ============================================================================

describe "SDN parsing error handling":
    slow_it "returns Err for nonexistent file":
        # @req REQ-SSPEC-SYSTEM
        step("returns Err for nonexistent file")
        val result = parse_ui_to_tree("nonexistent/path/does_not_exist.ui.sdn")
        match result:
            Err(e) :
                expect(e.len()).to_be_greater_than(0)
            Ok(tree) :
                expect(false).to_equal(true)

    slow_it "error message contains useful information":
        # @req REQ-SSPEC-SYSTEM
        step("error message contains useful information")
        val result = parse_ui_to_tree("/tmp/no_such_file_12345.ui.sdn")
        match result:
            Err(e) :
                expect(e).to_contain("File not found")
            Ok(tree) :
                expect(false).to_equal(true)

# ============================================================================
# 4. State Initialization from Parsed Tree
# ============================================================================

describe "init_state from parsed tree":
    slow_it "creates a UIState with focused_id set":
        # @req REQ-SSPEC-SYSTEM
        step("creates a UIState with focused_id set")
        val result = parse_ui_to_tree("examples/ui/minimal.ui.sdn")
        match result:
            Ok(tree) :
                val state = init_state(tree)
                # focused_id should be set to the first widget id
                expect(state.focused_id.len()).to_be_greater_than(0)
            Err(e) :
                expect(false).to_equal(true)

    slow_it "creates a UIState in Normal mode":
        # @req REQ-SSPEC-SYSTEM
        step("creates a UIState in Normal mode")
        val result = parse_ui_to_tree("examples/ui/minimal.ui.sdn")
        match result:
            Ok(tree) :
                val state = init_state(tree)
                expect(state.mode_name()).to_equal("NORMAL")
            Err(e) :
                expect(false).to_equal(true)

    slow_it "creates a UIState with empty command buffer":
        # @req REQ-SSPEC-SYSTEM
        step("creates a UIState with empty command buffer")
        val result = parse_ui_to_tree("examples/ui/demo.ui.sdn")
        match result:
            Ok(tree) :
                val state = init_state(tree)
                expect(state.command_buffer).to_equal("")
            Err(e) :
                expect(false).to_equal(true)

    slow_it "state tree preserves the original title":
        # @req REQ-SSPEC-SYSTEM
        step("state tree preserves the original title")
        val result = parse_ui_to_tree("examples/ui/demo.ui.sdn")
        match result:
            Ok(tree) :
                val state = init_state(tree)
                expect(state.tree.title).to_equal("Simple UI Demo")
            Err(e) :
                expect(false).to_equal(true)
