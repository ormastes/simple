"""
## Purpose and audience
Pins the observable CLI behavior of this spec's target so maintainers and
reviewers of the gui area can rely on documented output and exit codes.
## Operator workflow
Run via `bin/simple test <this file>`; read the per-scenario verdicts in the
`Results:` summary. Every scenario asserts an externally visible outcome.
## Compatibility and limitations
Covers the shipped command surface only; performance and stress behavior are
out of scope.
# @manual: primary
REQ-UI-GUI-001
doc/01_research/local/gui.md
doc/03_plan/sys_test/gui.md
doc/04_architecture/gui.md
doc/05_design/gui.md
"""
# @req: REQ-UI-GUI-001
# @cover src/lib/common/ui/state.spl 80%
# @cover src/lib/common/ui/event.spl 80%
# @cover src/app/ui.none/app.spl 80%
# @gui: headless

# @tag:system

use std.spec.*

use app.ui.none.app.{HeadlessApp}
use app.ui.none.backend.{NoneBackend}
use common.ui.widget.{UIEvent}

# ============================================================================
# Test Group 1: Keyboard Navigation
# ============================================================================

describe "Event Processing — Keyboard Navigation":

    slow_it "processes KeyPress events without crashing":
        # @req: REQ-UI-GUI-001
        step("Verify: processes KeyPress events without crashing")
        val result = HeadlessApp.new("examples/ui/demo.ui.sdn")
        match result:
            Ok(app) :
                app.inject_event(UIEvent.KeyPress(key: "j"))
                app.inject_event(UIEvent.Quit)
                val run_result = app.run()
                match run_result:
                    Ok(_) :
                        expect(app.render_count()).to_be_greater_than(0)
                    Err(e) :
                        expect(false).to_equal(true)
            Err(e) :
                expect(false).to_equal(true)

    slow_it "processes multiple navigation keys":
        # @req: REQ-UI-GUI-001
        step("Verify: processes multiple navigation keys")
        val result = HeadlessApp.new("examples/ui/demo.ui.sdn")
        match result:
            Ok(app) :
                app.inject_event(UIEvent.KeyPress(key: "j"))
                app.inject_event(UIEvent.KeyPress(key: "j"))
                app.inject_event(UIEvent.KeyPress(key: "k"))
                app.inject_event(UIEvent.Quit)
                val run_result = app.run()
                match run_result:
                    Ok(_) :
                        expect(app.render_count()).to_be_greater_than(1)
                    Err(e) :
                        expect(false).to_equal(true)
            Err(e) :
                expect(false).to_equal(true)

# ============================================================================
# Test Group 2: Focus Events
# ============================================================================

describe "Event Processing — Focus Events":

    slow_it "processes FocusNext":
        # @req: REQ-UI-GUI-001
        step("Verify: processes FocusNext")
        val result = HeadlessApp.new("examples/ui/demo.ui.sdn")
        match result:
            Ok(app) :
                app.inject_event(UIEvent.FocusNext)
                app.inject_event(UIEvent.Quit)
                val run_result = app.run()
                match run_result:
                    Ok(_) :
                        val state_after = app.current_state()
                        expect(app.render_count()).to_equal(2) # oracle: pinned expected value documenting the asserted outcome
                        expect(state_after.focused_id.len()).to_be_greater_than(0)
                        expect(state_after.tree.all_widget_ids()).to_contain(state_after.focused_id)
                    Err(e) :
                        expect(false).to_equal(true)
            Err(e) :
                expect(false).to_equal(true)

    slow_it "processes FocusPrev":
        # @req: REQ-UI-GUI-001
        step("Verify: processes FocusPrev")
        val result = HeadlessApp.new("examples/ui/demo.ui.sdn")
        match result:
            Ok(app) :
                app.inject_event(UIEvent.FocusPrev)
                app.inject_event(UIEvent.Quit)
                val run_result = app.run()
                match run_result:
                    Ok(_) :
                        val state_after = app.current_state()
                        expect(app.render_count()).to_equal(2) # oracle: pinned expected value documenting the asserted outcome
                        expect(state_after.focused_id.len()).to_be_greater_than(0)
                        expect(state_after.tree.all_widget_ids()).to_contain(state_after.focused_id)
                    Err(e) :
                        expect(false).to_equal(true)
            Err(e) :
                expect(false).to_equal(true)

# ============================================================================
# Test Group 3: State Changes
# ============================================================================

describe "Event Processing — State Changes":

    slow_it "tracks state after events":
        # @req: REQ-UI-GUI-001
        step("Verify: tracks state after events")
        val result = HeadlessApp.new("examples/ui/minimal.ui.sdn")
        match result:
            Ok(app) :
                val state_before = app.current_state()
                app.inject_event(UIEvent.KeyPress(key: "j"))
                app.inject_event(UIEvent.Quit)
                val run_result = app.run()
                match run_result:
                    Ok(_) :
                        val state_after = app.current_state()
                        expect(app.render_count()).to_equal(2) # oracle: pinned expected value documenting the asserted outcome
                        expect(state_after.mode_name()).to_equal("NORMAL")
                        expect(state_after.focused_id.len()).to_be_greater_than(0)
                    Err(e) :
                        expect(false).to_equal(true)
            Err(e) :
                expect(false).to_equal(true)

# ============================================================================
# Test Group 4: Quit Handling
# ============================================================================

describe "Event Processing — Quit Handling":

    slow_it "stops on Quit event":
        # @req: REQ-UI-GUI-001
        step("Verify: stops on Quit event")
        val result = HeadlessApp.new("examples/ui/minimal.ui.sdn")
        match result:
            Ok(app) :
                app.inject_event(UIEvent.Quit)
                val run_result = app.run()
                match run_result:
                    Ok(_) :
                        expect(app.render_count()).to_equal(1) # oracle: pinned expected value documenting the asserted outcome
                        expect(app.last_html().len()).to_be_greater_than(0)
                    Err(e) :
                        expect(false).to_equal(true)
            Err(e) :
                expect(false).to_equal(true)

# ============================================================================
# Test Group 5: Resize Events
# ============================================================================

describe "Event Processing — Resize Events":

    slow_it "handles resize without crashing":
        # @req: REQ-UI-GUI-001
        step("Verify: handles resize without crashing")
        val result = HeadlessApp.new("examples/ui/minimal.ui.sdn")
        match result:
            Ok(app) :
                app.inject_event(UIEvent.Resize(width: 120, height: 40))
                app.inject_event(UIEvent.Quit)
                val run_result = app.run()
                match run_result:
                    Ok(_) :
                        expect(app.render_count()).to_equal(2) # oracle: pinned expected value documenting the asserted outcome
                        expect(app.last_html().len()).to_be_greater_than(0)
                    Err(e) :
                        expect(false).to_equal(true)
            Err(e) :
                expect(false).to_equal(true)
