"""
## Purpose and audience
Purpose: X86_64 to_text
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-REPLAY_EVENT-ReplEvenLog-001

use std.spec
use std.nogc_sync_mut.replay.event_log.{TraceHeader, EventLog}
use std.nogc_sync_mut.replay.types.{Arch, Endian, TargetDesc}
use os.kernel.replay.event_kinds.{EventKind, ReplayEntry}

use std.spec.step
describe "Arch":
    it "X86_64 to_text":
        step("Verify: X86_64 to_text")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        expect(Arch.X86_64.to_text()).to_equal("x86_64")

    it "RISCV32 to_text":
        step("Verify: RISCV32 to_text")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        expect(Arch.RISCV32.to_text()).to_equal("riscv32")

    it "ARM32 to_text":
        step("Verify: ARM32 to_text")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        expect(Arch.ARM32.to_text()).to_equal("arm32")

    it "Arch.from_text riscv32":
        step("Verify: Arch.from_text riscv32")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        expect(Arch.from_text("riscv32").to_text()).to_equal("riscv32")

    it "Arch.from_text x86_64":
        step("Verify: Arch.from_text x86_64")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        expect(Arch.from_text("x86_64").to_text()).to_equal("x86_64")

    it "Arch.from_text amd64 maps to x86_64":
        step("Verify: Arch.from_text amd64 maps to x86_64")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        expect(Arch.from_text("amd64").to_text()).to_equal("x86_64")

    it "X86_64 pointer_bits is 64":
        step("Verify: X86_64 pointer_bits is 64")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        expect(Arch.X86_64.pointer_bits()).to_equal(64)  # oracle: value fixed by the spec contract

    it "RISCV32 pointer_bits is 32":
        step("Verify: RISCV32 pointer_bits is 32")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        expect(Arch.RISCV32.pointer_bits()).to_equal(32)  # oracle: value fixed by the spec contract

    it "ARM32 pointer_bits is 32":
        step("Verify: ARM32 pointer_bits is 32")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        expect(Arch.ARM32.pointer_bits()).to_equal(32)  # oracle: value fixed by the spec contract

    it "RISCV64 pointer_bits is 64":
        step("Verify: RISCV64 pointer_bits is 64")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        expect(Arch.RISCV64.pointer_bits()).to_equal(64)  # oracle: value fixed by the spec contract

describe "TargetDesc":
    it "for_arch X86_64 has correct arch":
        step("Verify: for_arch X86_64 has correct arch")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        val desc = TargetDesc.for_arch(Arch.X86_64)
        expect(desc.arch.to_text()).to_equal("x86_64")

    it "for_arch RISCV32 has correct arch":
        step("Verify: for_arch RISCV32 has correct arch")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        val desc = TargetDesc.for_arch(Arch.RISCV32)
        expect(desc.arch.to_text()).to_equal("riscv32")

    it "for_arch X86_64 has page_size 4096":
        step("Verify: for_arch X86_64 has page_size 4096")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        val desc = TargetDesc.for_arch(Arch.X86_64)
        expect(desc.page_size).to_equal(4096)  # oracle: value fixed by the spec contract

    it "for_arch X86_64 has non-empty register_schema_id":
        step("Verify: for_arch X86_64 has non-empty register_schema_id")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        val desc = TargetDesc.for_arch(Arch.X86_64)
        expect(desc.register_schema_id.len() > 0).to_equal(true)

describe "TraceHeader":
    it "create sets magic to SRPL":
        step("Verify: create sets magic to SRPL")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        val desc = TargetDesc.for_arch(Arch.X86_64)
        val header = TraceHeader.create(desc)
        expect(header.magic).to_equal("SRPL")

    it "create sets version to 1":
        step("Verify: create sets version to 1")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        val desc = TargetDesc.for_arch(Arch.X86_64)
        val header = TraceHeader.create(desc)
        expect(header.version).to_equal(1)  # oracle: value fixed by the spec contract

    it "create sets event_count to 0":
        step("Verify: create sets event_count to 0")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        val desc = TargetDesc.for_arch(Arch.X86_64)
        val header = TraceHeader.create(desc)
        expect(header.event_count).to_equal(0)  # oracle: value fixed by the spec contract

    it "to_sdn contains SRPL magic":
        step("Verify: to_sdn contains SRPL magic")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        val desc = TargetDesc.for_arch(Arch.X86_64)
        val header = TraceHeader.create(desc)
        val sdn = header.to_sdn()
        expect(sdn).to_contain("SRPL")

    it "to_sdn contains arch name":
        step("Verify: to_sdn contains arch name")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        val desc = TargetDesc.for_arch(Arch.X86_64)
        val header = TraceHeader.create(desc)
        val sdn = header.to_sdn()
        expect(sdn).to_contain("x86_64")

    it "to_sdn contains event_count stat":
        step("Verify: to_sdn contains event_count stat")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        val desc = TargetDesc.for_arch(Arch.X86_64)
        val header = TraceHeader.create(desc)
        val sdn = header.to_sdn()
        expect(sdn).to_contain("event_count")

describe "EventLog":
    it "create sets initial event_count to 0":
        step("Verify: create sets initial event_count to 0")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        val log = EventLog.create(Arch.X86_64)
        expect(log.header.event_count).to_equal(0)  # oracle: value fixed by the spec contract

    it "add_event increments event_count":
        step("Verify: add_event increments event_count")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        var log = EventLog.create(Arch.X86_64)
        val entry = ReplayEntry.create(EventKind.Schedule, 1, 1, 0)
        log.add_event(entry)
        expect(log.header.event_count).to_equal(1)  # oracle: value fixed by the spec contract

    it "add_event multiple times — count matches":
        step("Verify: add_event multiple times — count matches")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        var log = EventLog.create(Arch.RISCV32)
        val e0 = ReplayEntry.create(EventKind.TimerRead, 0, 1, 0)
        val e1 = ReplayEntry.create(EventKind.TimerRead, 1, 1, 0)
        val e2 = ReplayEntry.create(EventKind.TimerRead, 2, 1, 0)
        val e3 = ReplayEntry.create(EventKind.TimerRead, 3, 1, 0)
        log.add_event(e0)
        log.add_event(e1)
        log.add_event(e2)
        log.add_event(e3)
        expect(log.header.event_count).to_equal(4)  # oracle: value fixed by the spec contract

    it "entries.len matches header.event_count after add_event":
        step("Verify: entries.len matches header.event_count after add_event")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        var log = EventLog.create(Arch.X86_64)
        val e0 = ReplayEntry.create(EventKind.SyscallEnter, 1, 1, 0)
        val e1 = ReplayEntry.create(EventKind.SyscallExit, 2, 1, 0)
        log.add_event(e0)
        log.add_event(e1)
        expect(log.entries.len()).to_equal(log.header.event_count)

    it "add_events batch sets count correctly":
        step("Verify: add_events batch sets count correctly")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        var log = EventLog.create(Arch.ARM32)
        val e0 = ReplayEntry.create(EventKind.Schedule, 1, 1, 0)
        val e1 = ReplayEntry.create(EventKind.SyscallEnter, 2, 1, 0)
        val e2 = ReplayEntry.create(EventKind.SyscallExit, 3, 1, 0)
        log.add_events([e0, e1, e2])
        expect(log.header.event_count).to_equal(3)  # oracle: value fixed by the spec contract

    it "header arch matches create argument":
        step("Verify: header arch matches create argument")
        # @req: REQ-REPLAY_EVENT-ReplEvenLog-001
        val log = EventLog.create(Arch.RISCV32)
        expect(log.header.target.arch.to_text()).to_equal("riscv32")
