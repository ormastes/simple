# Shared result owner for the baremetal SSH component suite.

use os.apps.sshd.ssh_auth.{SshUserDb}
use os.userlib.syscall_raw.{syscall}

extern fn serial_println(msg: text)

val ISA_DEBUG_EXIT_PORT: u64 = 0xf4

var _pass_count: u32 = 0
var _fail_count: u32 = 0

pub fn os_ssh_configured_users() -> SshUserDb:
    var db = SshUserDb.new()
    db.add_user_identity("root")
    db.add_user_identity("user")
    db

pub fn os_ssh_assert(condition: bool, name: text):
    if condition:
        serial_println("[TEST PASS] {name}")
        _pass_count = _pass_count + 1
    else:
        serial_println("[TEST FAIL: {name}]")
        _fail_count = _fail_count + 1

pub fn os_ssh_bytes_equal(a: [u8], b: [u8]) -> bool:
    if a.len() != b.len():
        return false
    var i: u64 = 0
    while i < a.len():
        if a[i] != b[i]:
            return false
        i = i + 1
    true

pub fn os_ssh_report():
    serial_println("")
    serial_println("SSH tests: {_pass_count} passed, {_fail_count} failed")
    if _fail_count == 0:
        serial_println("[ALL TESTS PASSED]")
    else:
        serial_println("[TESTS FAILED: {_fail_count}]")
    syscall(ISA_DEBUG_EXIT_PORT, 0, 0, 0, 0, 0)

export os_ssh_configured_users, os_ssh_assert, os_ssh_bytes_equal, os_ssh_report
