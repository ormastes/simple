"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-MODULE_IMPORT behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/module_import/module_import_new_submodule_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-SYSTEM-MODULE_IMPORT-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/compiler/99.loader/module_loader.spl 80%
# @cover src/compiler/99.loader/module_resolver/resolution.spl 80%
# Module Import System Test: New Submodules in Compiled-In Packages
# tag: system
#
# Reproduces the issue where adding a new .spl file to a package that is
# compiled into bin/simple (e.g., std.cli_output) results in
# "function not found" errors even though the file loads without parse errors.
#
# Problems tested:
# 1. Existing compiled-in functions import fine (baseline)
# 2. New submodule file in compiled-in package: direct import fails
# 3. buffer.spl specifically: functions not found despite file loading
# 4. New file in a fresh (non-compiled) package (control test)
# 5. Diagnostic: module loading vs function registration
#
# All test scripts are in fixtures/ to avoid string interpolation issues
# with curly braces in import statements.
#
# NOTE: Tuple destructuring `val (a, b, c) = ...` does not work in interpreter
# mode. Use `val r = ...` then `r.0`, `r.1`, `r.2` to access elements.

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool
extern fn rt_dir_create_all(path: text) -> bool

fn find_simple_binary() -> text:
    if rt_file_exists("src/compiler_rust/target/release/simple"):
        return "src/compiler_rust/target/release/simple"
    if rt_file_exists("src/compiler_rust/target/bootstrap/simple"):
        return "src/compiler_rust/target/bootstrap/simple"
    if rt_file_exists("bin/simple"):
        return "bin/simple"
    if rt_file_exists("bin/release/aarch64-apple-darwin-macho/simple"):
        return "bin/release/aarch64-apple-darwin-macho/simple"
    if rt_file_exists("bin/release/macos-arm64/simple"):
        return "bin/release/macos-arm64/simple"
    if rt_file_exists("bin/release/darwin-aarch64/simple"):
        return "bin/release/darwin-aarch64/simple"
    if rt_file_exists("bin/release/macos-x86_64/simple"):
        return "bin/release/macos-x86_64/simple"
    if rt_file_exists("bin/release/linux-x86_64/simple"):
        return "bin/release/linux-x86_64/simple"
    "bin/simple"

val FIXTURES = "test/system/module_import/fixtures"

fn _check_binary_runnable() -> bool:
    val simple_bin = find_simple_binary()
    if simple_bin == "" or not rt_file_exists(simple_bin):
        return false
    # On Windows, the release binary is an ELF (Linux) binary and cannot run.
    if rt_file_exists("C:\\"):
        return false
    true

val _can_run = _check_binary_runnable()

# --- Helpers ---

fn run_fixture(name: text) -> (text, text, i64):
    val path = FIXTURES + "/" + name
    rt_process_run(find_simple_binary(), ["run", path])

fn copy_fixture(fixture_name: text, dest_path: text):
    val src = FIXTURES + "/" + fixture_name
    val content = rt_file_read_text(src) ?? ""
    rt_file_write_text(dest_path, content)

fn setup_probe_module():
    copy_fixture("probe_module.spl", "src/lib/nogc_sync_mut/cli_output/_test_probe.spl")

fn setup_probe_module_with_extern():
    copy_fixture("probe_module_with_extern.spl", "src/lib/nogc_sync_mut/cli_output/_test_probe.spl")

fn cleanup_probe_module():
    rt_file_delete("src/lib/nogc_sync_mut/cli_output/_test_probe.spl")

fn setup_fresh_package():
    rt_dir_create_all("src/lib/nogc_sync_mut/_test_fresh_pkg")
    copy_fixture("fresh_mod.spl", "src/lib/nogc_sync_mut/_test_fresh_pkg/_test_fresh_mod.spl")
    copy_fixture("fresh_init.spl", "src/lib/nogc_sync_mut/_test_fresh_pkg/__init__.spl")

fn cleanup_fresh_package():
    rt_file_delete("src/lib/nogc_sync_mut/_test_fresh_pkg/_test_fresh_mod.spl")
    rt_file_delete("src/lib/nogc_sync_mut/_test_fresh_pkg/__init__.spl")

# --- Module-level helpers to avoid tuple destructuring inside if/else in it blocks ---

fn _run_and_check(fixture: text, label: text):
    val (stdout, stderr, code) = run_fixture(fixture)
    if code != 0:
        print "[FAIL] " + label + ": stderr=" + stderr
    expect(code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

fn _run_and_check_known_bug(fixture: text, label: text):
    val (stdout, stderr, code) = run_fixture(fixture)
    if code != 0:
        print "[KNOWN BUG] " + label + ": " + stderr
    expect(code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

fn _run_and_check_info(fixture: text, label: text):
    val (stdout, stderr, code) = run_fixture(fixture)
    if code != 0:
        print "[INFO] " + label + ": " + stderr
    expect(code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

fn _run_setup_probe_and_check(fixture: text, label: text):
    setup_probe_module()
    val (stdout, stderr, code) = run_fixture(fixture)
    cleanup_probe_module()
    if code != 0:
        print "[KNOWN BUG] " + label + ": " + stderr
    expect(code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

fn _run_setup_probe_direct_and_check():
    setup_probe_module()
    val (stdout, stderr, code) = rt_process_run(find_simple_binary(), ["run", "src/lib/nogc_sync_mut/cli_output/_test_probe.spl"])
    cleanup_probe_module()
    expect(code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

fn _run_setup_fresh_and_check(fixture: text, label: text):
    setup_fresh_package()
    val (stdout, stderr, code) = run_fixture(fixture)
    cleanup_fresh_package()
    if code != 0:
        print "[INFO] " + label + ": " + stderr
    expect(code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

fn _run_setup_probe_extern_and_check():
    setup_probe_module_with_extern()
    val (stdout, stderr, code) = run_fixture("probe_extern_import.spl")
    cleanup_probe_module()
    if code != 0:
        print "[DIAG] extern fn in new submodule: " + stderr
    expect(code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

fn _run_diag_module_loading():
    val (_, stderr_bad, code_bad) = run_fixture("nonexistent_module.spl")
    val (_, stderr_buf, code_buf) = run_fixture("buffer_direct_import.spl")
    print "[DIAG] nonexistent module error: " + stderr_bad
    print "[DIAG] buffer module error: " + stderr_buf
    var is_module_not_found = false
    if stderr_buf.contains("module not found"):
        is_module_not_found = true
    if stderr_buf.contains("file not found"):
        is_module_not_found = true
    expect(is_module_not_found).to_equal(false)

# ============================================================================
# Test Group 1: Baseline - Existing Compiled-In Imports
# ============================================================================

describe "Module Import - Compiled-In Package":

    context "existing functions (baseline)":

        it "imports existing std.cli_output function via init":
            # @req: REQ-SYSTEM-MODULE_IMPORT-001
            step("Verify: imports existing std.cli_output function via init")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            if not _can_run:
                expect(true).to_equal(true)
            else:
                _run_and_check("baseline_init_import.spl", "baseline init import")

        it "imports existing std.cli_output submodule directly":
            # @req: REQ-SYSTEM-MODULE_IMPORT-002
            step("Verify: imports existing std.cli_output submodule directly")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            if not _can_run:
                expect(true).to_equal(true)
            else:
                _run_and_check("baseline_direct_import.spl", "baseline direct import")

# ============================================================================
# Test Group 2: New Submodule in Compiled-In Package
# ============================================================================

    context "new submodule file in compiled-in package":

        it "can load new spl file without parse errors (run directly)":
            # @req: REQ-SYSTEM-MODULE_IMPORT-003
            step("Verify: can load new spl file without parse errors (run directly)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            if not _can_run:
                expect(true).to_equal(true)
            else:
                _run_setup_probe_direct_and_check()

        it "can import function from new submodule via direct path":
            # @req: REQ-SYSTEM-MODULE_IMPORT-004
            step("Verify: can import function from new submodule via direct path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            if not _can_run:
                expect(true).to_equal(true)
            else:
                _run_setup_probe_and_check("probe_direct_import.spl", "New submodule direct import fails")

# ============================================================================
# Test Group 3: buffer.spl Specifically
# ============================================================================

    context "buffer.spl (the actual module we need)":

        it "can import buffer_start via direct submodule path":
            # @req: REQ-SYSTEM-MODULE_IMPORT-005
            step("Verify: can import buffer_start via direct submodule path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            if not _can_run:
                expect(true).to_equal(true)
            else:
                _run_and_check_known_bug("buffer_direct_import.spl", "buffer.spl direct import fails")

        it "can import log_print via direct submodule path":
            # @req: REQ-SYSTEM-MODULE_IMPORT-006
            step("Verify: can import log_print via direct submodule path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            if not _can_run:
                expect(true).to_equal(true)
            else:
                _run_and_check_known_bug("buffer_logprint_import.spl", "buffer.spl log_print import fails")

        it "can import buffer functions via init reexport":
            # @req: REQ-SYSTEM-MODULE_IMPORT-007
            step("Verify: can import buffer functions via init reexport")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            if not _can_run:
                expect(true).to_equal(true)
            else:
                _run_and_check_known_bug("buffer_init_import.spl", "buffer.spl init re-export fails")

# ============================================================================
# Test Group 4: Control - Fresh Non-Compiled Package
# ============================================================================

    context "fresh non-compiled package (control test)":

        it "can import from a completely new package via direct path":
            # @req: REQ-SYSTEM-MODULE_IMPORT-008
            step("Verify: can import from a completely new package via direct path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            if not _can_run:
                expect(true).to_equal(true)
            else:
                _run_setup_fresh_and_check("fresh_pkg_direct_import.spl", "Fresh package direct import")

        it "can import from a completely new package via init":
            # @req: REQ-SYSTEM-MODULE_IMPORT-009
            step("Verify: can import from a completely new package via init")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            if not _can_run:
                expect(true).to_equal(true)
            else:
                _run_setup_fresh_and_check("fresh_pkg_init_import.spl", "Fresh package init import")

# ============================================================================
# Test Group 5: Module Loading vs Function Registration
# ============================================================================

    context "module loading diagnostics":

        it "buffer.spl is found by resolver (not module-not-found)":
            # @req: REQ-SYSTEM-MODULE_IMPORT-010
            step("Verify: buffer.spl is found by resolver (not module-not-found)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            if not _can_run:
                expect(true).to_equal(true)
            else:
                _run_diag_module_loading()

        it "extern fn in module does not prevent function registration":
            # @req: REQ-SYSTEM-MODULE_IMPORT-011
            step("Verify: extern fn in module does not prevent function registration")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            if not _can_run:
                expect(true).to_equal(true)
            else:
                _run_setup_probe_extern_and_check()
