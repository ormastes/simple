"""
## Purpose and audience
Executable system contract for the replay scenario correlator
(`std.nogc_sync_mut.replay.semantic.scenario_correlator`): scenario naming,
step bookkeeping, function/object attachment, and the summary/to_text
projections. Audience: replay-tooling engineers and reviewers of the
debug-replay pipeline who need proof that correlation state is retained.
## Operator workflow
Run: src/compiler_rust/target/bootstrap/simple run test/system/replay_scenario_spec.spl
and read the SPEC FILE VERDICT line; every scenario must pass.
## Compatibility and limitations
Runs on a binary with a `run` surface; `bin/simple` on a bootstrap-only host
cannot execute it. The correlator is exercised in memory only — no trace
files are read or written, and no cross-scenario ordering is assumed.
## Verification guidance and troubleshooting
A failure names the correlator operation under test (from_scenario, add_step,
match_functions, match_objects, summary, to_text). Re-run after touching
src/lib/nogc_sync_mut/replay/semantic/scenario_correlator.spl; a regression
in step ordering typically shows up in the multi-step scenario below.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: replay-scenario-correlator

use std.spec
use std.nogc_sync_mut.replay.semantic.scenario_correlator.{ScenarioStep, ScenarioCorrelator}

describe "ScenarioCorrelator creation":
    it "from_scenario sets scenario_name":
        # @req REQ-REPLAY-SCEN-001
        # @capture(protocol_json): correlator scenario name as constructed
        step("Create a correlator from a named scenario")
        val sc = ScenarioCorrelator.from_scenario("user logs in")
        expect(sc.scenario_name).to_equal("user logs in")

    it "from_scenario starts with zero steps":
        # @req REQ-REPLAY-SCEN-001
        # @capture(statistics): step_count of a fresh correlator
        step("Create a correlator and read its initial step count")
        val sc = ScenarioCorrelator.from_scenario("checkout flow")
        expect(sc.step_count()).to_equal(0)  # oracle: a fresh correlator has no steps yet

describe "ScenarioCorrelator add_step":
    it "add_step increases step_count":
        # @req REQ-REPLAY-SCEN-002
        # @capture(statistics): step_count after one add_step
        step("Add one step and read the step count")
        var sc = ScenarioCorrelator.from_scenario("login")
        sc.add_step("open login page", 0, 100)
        expect(sc.step_count()).to_equal(1)  # oracle: exactly one step was added

    it "add_step stores step name and event range":
        # @req REQ-REPLAY-SCEN-002
        # @capture(protocol_json): stored step name and event range
        step("Add a step with an event range and read it back")
        var sc = ScenarioCorrelator.from_scenario("login")
        sc.add_step("submit credentials", 100, 250)
        val st = sc.get_step(0)
        expect(st.name).to_equal("submit credentials")
        expect(st.start_event_id).to_equal(100)  # oracle: the range passed to add_step is retained verbatim
        expect(st.end_event_id).to_equal(250)  # oracle: the range passed to add_step is retained verbatim

    it "multiple add_step calls maintain order":
        # @req REQ-REPLAY-SCEN-002
        # @capture(bit_table): step order across three add_step calls
        step("Add three steps and verify first and last survive in order")
        var sc = ScenarioCorrelator.from_scenario("purchase")
        sc.add_step("add to cart", 0, 50)
        sc.add_step("checkout", 51, 200)
        sc.add_step("confirm", 201, 300)
        expect(sc.step_count()).to_equal(3)  # oracle: three add_step calls yield three stored steps
        val first = sc.get_step(0)
        expect(first.name).to_equal("add to cart")
        val last = sc.get_step(2)
        expect(last.name).to_equal("confirm")

describe "ScenarioCorrelator match_functions":
    it "match_functions attaches patterns to a step":
        # @req REQ-REPLAY-SCEN-003
        # @capture(statistics): matched function count on step 0
        step("Attach two function patterns to step 0 and count them")
        var sc = ScenarioCorrelator.from_scenario("login")
        sc.add_step("authenticate", 0, 100)
        sc.match_functions(0, ["auth.login", "auth.verify_password"])
        val st = sc.get_step(0)
        expect(st.matched_functions.len()).to_equal(2)  # oracle: two patterns were attached to the step

    it "match_functions does not affect other steps":
        # @req REQ-REPLAY-SCEN-003
        # @capture(statistics): matched function count on the untouched step
        step("Attach patterns to step 0 and confirm step 1 stays empty")
        var sc = ScenarioCorrelator.from_scenario("multi")
        sc.add_step("step-a", 0, 10)
        sc.add_step("step-b", 11, 20)
        sc.match_functions(0, ["fn_a"])
        val sb = sc.get_step(1)
        expect(sb.matched_functions.len()).to_equal(0)  # oracle: match_functions(0, ...) must not leak into step 1

describe "ScenarioCorrelator match_objects":
    it "match_objects attaches object ids to a step":
        # @req REQ-REPLAY-SCEN-004
        # @capture(statistics): matched object count on step 0
        step("Attach three object ids to step 0 and count them")
        var sc = ScenarioCorrelator.from_scenario("alloc test")
        sc.add_step("allocate user", 0, 50)
        sc.match_objects(0, [101, 102, 103])
        val st = sc.get_step(0)
        expect(st.matched_objects.len()).to_equal(3)  # oracle: all three object ids were attached

describe "ScenarioCorrelator summary":
    it "summary contains scenario name":
        # @req REQ-REPLAY-SCEN-005
        # @capture(protocol_json): correlator summary text
        step("Render the summary of a correlator with no steps")
        var sc = ScenarioCorrelator.from_scenario("dashboard load")
        val out = sc.summary()
        expect(out).to_contain("dashboard load")

    it "summary contains step count":
        # @req REQ-REPLAY-SCEN-005
        # @capture(protocol_json): correlator summary with two steps
        step("Render the summary of a correlator with two steps")
        var sc = ScenarioCorrelator.from_scenario("flow")
        sc.add_step("step one", 0, 10)
        sc.add_step("step two", 11, 20)
        val out = sc.summary()
        expect(out).to_contain("2")

describe "ScenarioStep to_text":
    it "to_text contains step name":
        # @req REQ-REPLAY-SCEN-006
        # @capture(protocol_json): ScenarioStep to_text projection
        step("Project a step to text and check its name survives")
        val st = ScenarioStep(
            name: "render page",
            start_event_id: 10,
            end_event_id: 99,
            matched_functions: [],
            matched_objects: []
        )
        val s = st.to_text()
        expect(s).to_contain("render page")

    it "to_text contains event range":
        # @req REQ-REPLAY-SCEN-006
        # @capture(bit_table): event range digits in the to_text projection
        step("Project a step to text and check both range bounds survive")
        val st = ScenarioStep(
            name: "submit",
            start_event_id: 5,
            end_event_id: 42,
            matched_functions: [],
            matched_objects: []
        )
        val s = st.to_text()
        expect(s).to_contain("5")
        expect(s).to_contain("42")
