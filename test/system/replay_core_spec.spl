"""
## Purpose and audience
Executable system contract for the replay core primitives
(`std.replay.core.*`): ReplayEventKind ordinal round-trips, ReplayEvent field
retention, the NoopReplayHook pass-through behaviour, ReplayEngine record/off
modes, and the global replay_init/replay_get/replay_shutdown lifecycle.
Audience: engineers owning the deterministic-replay runtime and reviewers of
recording overhead guarantees.
## Operator workflow
Run: src/compiler_rust/target/bootstrap/simple run test/system/replay_core_spec.spl
and read the SPEC FILE VERDICT line; every scenario must pass.
## Compatibility and limitations
Runs on a binary with a `run` surface. The engine is exercised in memory with
synthetic events only — no trace capture hardware, no debugger attachment, and
the global replay_init/replay_shutdown scenarios must stay last-in-file
independent (each shuts its engine down).
## Verification guidance and troubleshooting
A failure names the primitive under test (ReplayEventKind, ReplayEvent,
NoopReplayHook, ReplayEngine record/off, seq_counter, replay_init/shutdown).
Re-run after touching src/lib/nogc_sync_mut/replay/core/**; an ordinal
round-trip failure usually means the enum declaration and from_i32 drifted.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: replay-core-primitives

use std.spec
use std.replay.core.replay_event.{ReplayEventKind, ReplayEvent}
use std.replay.core.replay_engine.{ReplayEngine, replay_init, replay_shutdown, replay_get}
use std.replay.core.noop_hook.NoopReplayHook

describe "ReplayEventKind":
    it "FunctionEnter to_i32 round-trip":
        # @req REQ-REPLAY-CORE-001
        # @capture(bit_table): FunctionEnter ordinal and from_i32 round-trip
        step("Encode FunctionEnter to an ordinal and decode it back")
        val k = ReplayEventKind.FunctionEnter
        val v = k.to_i32()
        expect(v).to_equal(0)  # oracle: FunctionEnter is the first variant declared in ReplayEventKind
        expect(ReplayEventKind.from_i32(v).to_i32()).to_equal(0)  # oracle: from_i32(v) must reproduce the same ordinal

    it "FunctionExit to_i32 round-trip":
        # @req REQ-REPLAY-CORE-001
        # @capture(bit_table): FunctionExit ordinal and from_i32 round-trip
        step("Encode FunctionExit to an ordinal and decode it back")
        val k = ReplayEventKind.FunctionExit
        val v = k.to_i32()
        expect(v).to_equal(1)  # oracle: FunctionExit is the second variant declared in ReplayEventKind
        expect(ReplayEventKind.from_i32(v).to_i32()).to_equal(1)  # oracle: from_i32(v) must reproduce the same ordinal

    it "Step to_i32 round-trip":
        # @req REQ-REPLAY-CORE-001
        # @capture(bit_table): Step ordinal and from_i32 round-trip
        step("Encode Step to an ordinal and decode it back")
        val k = ReplayEventKind.Step
        val v = k.to_i32()
        expect(v).to_equal(2)  # oracle: Step is the third variant declared in ReplayEventKind
        expect(ReplayEventKind.from_i32(v).to_i32()).to_equal(2)  # oracle: from_i32(v) must reproduce the same ordinal

    it "VariableWrite to_i32 round-trip":
        # @req REQ-REPLAY-CORE-001
        # @capture(bit_table): VariableWrite ordinal and from_i32 round-trip
        step("Encode VariableWrite to an ordinal and decode it back")
        val k = ReplayEventKind.VariableWrite
        val v = k.to_i32()
        expect(v).to_equal(3)  # oracle: VariableWrite is the fourth variant declared in ReplayEventKind
        expect(ReplayEventKind.from_i32(v).to_i32()).to_equal(3)  # oracle: from_i32(v) must reproduce the same ordinal

    it "BreakpointHit to_i32 round-trip":
