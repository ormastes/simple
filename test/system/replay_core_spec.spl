describe "ReplayEvent creation":
    it "ReplayEvent fields are accessible after construction":
        # @req REQ-REPLAY-CORE-002
        # @capture(protocol_binary): full ReplayEvent field retention
        step("Construct a ReplayEvent and read every field back")
        val ev = ReplayEvent(
            seq_id: 7,
            kind: ReplayEventKind.Step,
            timestamp: 1000,
            file_hash: 42,
            line: 99,
            name_hash: 0,
            value_a: 10,
            value_b: 20,
        )
        expect(ev.seq_id).to_equal(7)  # oracle: the seq_id passed to the constructor is retained verbatim
        expect(ev.kind.to_i32()).to_equal(2)  # oracle: the Step kind passed in is retained, ordinal 2 per the enum
        expect(ev.timestamp).to_equal(1000)  # oracle: the timestamp passed to the constructor is retained verbatim
        expect(ev.file_hash).to_equal(42)  # oracle: the file_hash passed to the constructor is retained verbatim
        expect(ev.line).to_equal(99)  # oracle: the line passed to the constructor is retained verbatim
        expect(ev.value_a).to_equal(10)  # oracle: value_a passed to the constructor is retained verbatim
        expect(ev.value_b).to_equal(20)  # oracle: value_b passed to the constructor is retained verbatim

describe "NoopReplayHook":
    it "is_off returns true":
        # @req REQ-REPLAY-CORE-003
        # @capture(statistics): NoopReplayHook mode flags
        step("Query the no-op hook's off flag")
        val hook = NoopReplayHook()
        expect(hook.is_off()).to_equal(true)

    it "is_recording returns false":
        # @req REQ-REPLAY-CORE-003
        # @capture(statistics): NoopReplayHook mode flags
        step("Query the no-op hook's recording flag")
        val hook = NoopReplayHook()
        expect(hook.is_recording()).to_equal(false)

    it "is_replaying returns false":
        # @req REQ-REPLAY-CORE-003
        # @capture(statistics): NoopReplayHook mode flags
        step("Query the no-op hook's replaying flag")
        val hook = NoopReplayHook()
        expect(hook.is_replaying()).to_equal(false)

    it "timer_read passes value through":
        # @req REQ-REPLAY-CORE-003
        # @capture(statistics): timer passthrough value
        step("Push a timer reading through the no-op hook")
        val hook = NoopReplayHook()
        val result = hook.on_timer_read(1, 42)
        expect(result).to_equal(42)  # oracle: a no-op hook must return the timer value it was handed

    it "io_read passes value through":
        # @req REQ-REPLAY-CORE-003
        # @capture(statistics): io passthrough value
        step("Push an io reading through the no-op hook")
        val hook = NoopReplayHook()
        val result = hook.on_io_read(0x1000, 4, 99)
        expect(result).to_equal(99)  # oracle: a no-op hook must return the io value it was handed

describe "ReplayEngine record mode":
    it "record mode logs events on on_step":
        # @req REQ-REPLAY-CORE-004
        # @capture(statistics): event count before and after on_step
        step("Start a record-mode engine and log one step event")
        val eng = ReplayEngine.create("record")
        expect(eng.events.len()).to_equal(0)  # oracle: a fresh engine has an empty event log
        eng.on_step("file.spl", 10, 0)
        expect(eng.events.len()).to_equal(1)  # oracle: exactly one on_step call logs exactly one event

    it "record mode logs events on on_function_enter":
        # @req REQ-REPLAY-CORE-004
        # @capture(statistics): event count after on_function_enter
        step("Start a record-mode engine and log one function-enter event")
        val eng = ReplayEngine.create("record")
        eng.on_function_enter("foo", "mymod")
        expect(eng.events.len()).to_equal(1)  # oracle: one on_function_enter call logs exactly one event

    it "record mode accumulates multiple events":
        # @req REQ-REPLAY-CORE-004
        # @capture(statistics): accumulated event count across three calls
        step("Log step, function-enter, and io-write events in sequence")
        val eng = ReplayEngine.create("record")
        eng.on_step("a.spl", 1, 0)
        eng.on_function_enter("bar", "mod")
        eng.on_io_write(0x10, 4, 255)
        expect(eng.events.len()).to_equal(3)  # oracle: three logging calls accumulate three events in order

    it "record mode is_recording returns true":
        # @req REQ-REPLAY-CORE-004
        # @capture(statistics): record-mode flag state
        step("Query the record-mode engine's recording flag")
        val eng = ReplayEngine.create("record")
        expect(eng.is_recording()).to_equal(true)

    it "record mode is_off returns false":
        # @req REQ-REPLAY-CORE-004
        # @capture(statistics): record-mode flag state
        step("Query the record-mode engine's off flag")
        val eng = ReplayEngine.create("record")
        expect(eng.is_off()).to_equal(false)

    it "record mode timer_read logs and returns value":
        # @req REQ-REPLAY-CORE-004
        # @capture(statistics): timer value and logged event count
        step("Push a timer reading through a record-mode engine")
        val eng = ReplayEngine.create("record")
        val v = eng.on_timer_read(0, 77)
        expect(v).to_equal(77)  # oracle: record mode still returns the timer value it was handed
        expect(eng.events.len()).to_equal(1)  # oracle: the timer read is also logged as one event

    it "record mode io_read logs and returns value":
        # @req REQ-REPLAY-CORE-004
        # @capture(statistics): io value and logged event count
        step("Push an io reading through a record-mode engine")
        val eng = ReplayEngine.create("record")
        val v = eng.on_io_read(0x20, 4, 55)
        expect(v).to_equal(55)  # oracle: record mode still returns the io value it was handed
        expect(eng.events.len()).to_equal(1)  # oracle: the io read is also logged as one event

describe "ReplayEngine off mode":
    it "off mode is zero cost — no events logged on on_step":
        # @req REQ-REPLAY-CORE-005
        # @capture(statistics): event count after on_step in off mode
        step("Log a step event on an off-mode engine and count the log")
        val eng = ReplayEngine.create("off")
        eng.on_step("file.spl", 1, 0)
        expect(eng.events.len()).to_equal(0)  # oracle: off mode must not log any event

    it "off mode is_off returns true":
        # @req REQ-REPLAY-CORE-005
        # @capture(statistics): off-mode flag state
        step("Query the off-mode engine's off flag")
        val eng = ReplayEngine.create("off")
        expect(eng.is_off()).to_equal(true)

    it "off mode is_recording returns false":
        # @req REQ-REPLAY-CORE-005
        # @capture(statistics): off-mode flag state
        step("Query the off-mode engine's recording flag")
        val eng = ReplayEngine.create("off")
        expect(eng.is_recording()).to_equal(false)

    it "off mode timer_read passes value through":
        # @req REQ-REPLAY-CORE-005
        # @capture(statistics): timer passthrough value in off mode
        step("Push a timer reading through an off-mode engine")
        val eng = ReplayEngine.create("off")
        val v = eng.on_timer_read(0, 123)
        expect(v).to_equal(123)  # oracle: off mode must still return the timer value it was handed

describe "ReplayEngine seq_counter":
    it "seq_counter increments per event":
        # @req REQ-REPLAY-CORE-006
        # @capture(bit_table): seq ids of the first two logged events
        step("Log two step events and read their sequence ids")
        val eng = ReplayEngine.create("record")
        eng.on_step("f.spl", 1, 0)
        eng.on_step("f.spl", 2, 0)
        expect(eng.events[0].seq_id).to_equal(0)  # oracle: the first logged event gets seq id 0
        expect(eng.events[1].seq_id).to_equal(1)  # oracle: the second logged event gets seq id 1

describe "replay_init and replay_get":
    it "replay_init then replay_get returns non-None engine":
        # @req REQ-REPLAY-CORE-007
        # @capture(statistics): global engine presence after replay_init
        step("Initialise the global engine and fetch it back")
        replay_init("record")
        val maybe = replay_get()
        var is_some = false
        if val Some(_) = maybe:
            is_some = true
        expect(is_some).to_equal(true)
        replay_shutdown()

    it "replay_get engine after init is in record mode":
        # @req REQ-REPLAY-CORE-007
        # @capture(statistics): global engine mode after replay_init
        step("Initialise the global engine and confirm its mode")
        replay_init("record")
        val maybe = replay_get()
        var is_recording = false
        if val Some(eng) = maybe:
            is_recording = eng.is_recording()
        expect(is_recording).to_equal(true)
        replay_shutdown()

describe "replay_shutdown":
    it "replay_shutdown clears engine — replay_get returns None":
        # @req REQ-REPLAY-CORE-007
        # @capture(statistics): global engine absence after replay_shutdown
        step("Shut the global engine down and fetch it back")
        replay_init("record")
        replay_shutdown()
        val maybe = replay_get()
        var is_none = true
        if val Some(_) = maybe:
            is_none = false
        expect(is_none).to_equal(true)
