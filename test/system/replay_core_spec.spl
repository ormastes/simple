        val v = k.to_i32()
        expect(v).to_equal(4)  # oracle: BreakpointHit is the fifth variant declared in ReplayEventKind
        expect(ReplayEventKind.from_i32(v).to_i32()).to_equal(4)  # oracle: from_i32(v) must reproduce the same ordinal

