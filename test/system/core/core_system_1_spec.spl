"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-CORE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/core/core_system_1_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-CORE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/compiler/80.driver/driver/__init__.spl 60%
"""
# CORE System Test

**Feature IDs:** #CORE-SYS
**Category:** System Testing
**Status:** Implemented
"""

use std.spec

fn check(condition: bool):
    expect(condition).to_equal(true)

describe "CORE System Test":
    slow_it "complete workflow 1":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-CORE-001
        step("Verify: complete workflow 1")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val input = "system test"
        check(input.len() > 0)
        
    slow_it "complete workflow 2":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-CORE-002
        step("Verify: complete workflow 2")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var data = []
        for i in 0..20:
            data = data.append(i)
        check(data.len() == 20)
        
    slow_it "complete workflow 3":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-CORE-003
        step("Verify: complete workflow 3")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val code = "fn test(): pass"
        val code_len = code.len()
        check(code_len > 0)
        
    slow_it "complete workflow 4":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-CORE-004
        step("Verify: complete workflow 4")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val opt = Some(42)
        match opt:
            Some(x): check(x == 42)
            nil: check(false)
            
    slow_it "complete workflow 5":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-CORE-005
        step("Verify: complete workflow 5")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var state = "init"
        if state == "init":
            state = "done"
        check(state == "done")
        
    slow_it "error handling":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-CORE-006
        step("Verify: error handling")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var error = nil
        check(error == nil)
        
    slow_it "edge case":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-CORE-007
        step("Verify: edge case")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val empty = []
        check(empty.len() == 0)
        
    slow_it "boundary":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-CORE-008
        step("Verify: boundary")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val single = [1]
        check(single[0] == 1)
        
    slow_it "integration":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-CORE-009
        step("Verify: integration")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = 10
        val b = 20
        check(a + b == 30)
        
    slow_it "validation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-CORE-010
        step("Verify: validation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        check(true)
        check(not false)
        check(1 == 1)
