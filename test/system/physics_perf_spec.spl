"""
## Purpose and audience
Purpose: BVH inserts 200 bodies without crash
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-PHYSICS_PERF-PhysPerf-001

use std.io_runtime
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.physics.broadphase.bvh2d.{DynamicBvh2D, AABB2D}

# VALUE-TYPE HELPER TRAP (see fix 6f8f3230db4, same family):
# `DynamicBvh2D` is a `struct`, i.e. a VALUE TYPE. The previous
# `fn insert_grid(bvh: DynamicBvh2D, ...)` / `fn insert_cluster(...)` helpers
# received a COPY, so every `bvh.insert(...)` mutated the copy and the caller's
# tree stayed empty -- `node_count` read 0 in all four blocks. Insertions must
# be issued INLINE on the caller's `var`; do not reintroduce a by-value helper.

use std.spec.step
describe "Physics2 BVH Performance":
    it "BVH inserts 200 bodies without crash":
        step("Verify: BVH inserts 200 bodies without crash")
        # @req: REQ-PHYSICS_PERF-PhysPerf-001
        var bvh = DynamicBvh2D.create(0.1)
        var i = 0
        while i < 200:
            val row = i / 20
            val col = i % 20
            val x = (col as f64) * 10.0
            val y = (row as f64) * 10.0
            bvh.insert(AABB2D(min_x: x, min_y: y, max_x: x + 1.0, max_y: y + 1.0), i)
            i = i + 1
        expect(bvh.node_count > 0).to_equal(true)

    it "scattered bodies have nodes proportional to body count":
        step("Verify: scattered bodies have nodes proportional to body count")
        # @req: REQ-PHYSICS_PERF-PhysPerf-001
        var bvh = DynamicBvh2D.create(0.1)
        var i = 0
        while i < 200:
            val row = i / 20
            val col = i % 20
            val x = (col as f64) * 10.0
            val y = (row as f64) * 10.0
            bvh.insert(AABB2D(min_x: x, min_y: y, max_x: x + 1.0, max_y: y + 1.0), i)
            i = i + 1
        # BVH uses 2*N-1 nodes (N leaves + N-1 internal nodes)
        expect(bvh.node_count).to_equal(399)  # oracle: value fixed by the spec contract

    it "clustered bodies have nodes proportional to body count":
        step("Verify: clustered bodies have nodes proportional to body count")
        # @req: REQ-PHYSICS_PERF-PhysPerf-001
        var bvh = DynamicBvh2D.create(0.1)
        var i = 0
        while i < 50:
            val offset = (i as f64) * 0.1
            bvh.insert(AABB2D(min_x: offset, min_y: offset, max_x: offset + 2.0, max_y: offset + 2.0), i)
            i = i + 1
        expect(bvh.node_count).to_equal(99)  # oracle: value fixed by the spec contract

    it "grid with spacing has nodes proportional to body count":
        step("Verify: grid with spacing has nodes proportional to body count")
        # @req: REQ-PHYSICS_PERF-PhysPerf-001
        var bvh = DynamicBvh2D.create(0.1)
        var i = 0
        while i < 100:
            val row = i / 20
            val col = i % 20
            val x = (col as f64) * 3.0
            val y = (row as f64) * 3.0
            bvh.insert(AABB2D(min_x: x, min_y: y, max_x: x + 1.0, max_y: y + 1.0), i)
            i = i + 1
        expect(bvh.node_count).to_equal(199)  # oracle: value fixed by the spec contract
