# @cover src/compiler/80.driver/driver.spl 60%
"""
## Purpose and audience
Pins thirty language-level error-path behaviors (nil guards, empty collections,
match defaults, loop edges, arithmetic bounds) so a regression in any of them
fails loudly instead of passing vacuously. Written for the compiler and runtime
engineers who own the interpreter, and for operators verifying a toolchain build.
## Operator workflow
Run `simple run test/03_system/core/error_path/error_path_100_system_spec.spl`
and read the per-scenario verdict lines; the first failing scenario names the
error path that regressed. Every scenario drives real language constructs and
compares a computed value against the inline oracle.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec. Scenario
"error path 27 - option chain breaks" is RED by contract: `Some(nil).?` is
false on the current runtime, and the scenario keeps asserting the truth of
that unwrap so the defect stays visible instead of being softened.
## Verification guidance and troubleshooting
Re-run the single spec file; a failure means the named guard changed behavior.
Compare the reported value against the compared constant in the scenario body
before bisecting recent compiler or runtime changes.
# @manual: primary
REQ-SYS-ERROR-PATH-28c3
doc/01_research/domain/sspec_documentization_maintenance.md
doc/03_plan/sspec_modernization_plan.md
doc/04_architecture/sspec_documentization_maintenance.md
doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
"""
# @req: REQ-SYS-ERROR-PATH-28c3
# @manual_section: error path oracles

# error_path behavior oracles — every expect() compares a computed value against a
# named expected constant (see the "# oracle:" comments), never x == x.

use std.spec
use std.spec.step
use std.math.{abs, min, max, sqrt, floor, ceil}
use std.string_core.{char_code, char_from_code}

fn verify(condition: bool):
    expect(condition).to_equal(true)

describe "Error Path Coverage":
    slow_it "error path 1 - null check":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 1 - null check guard
        step("exercise the guard: error path 1 - null check")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 1 - null check guard
        step("exercise the guard: error path 1 - null check")
        val opt_val = nil
        if opt_val.?:
            verify(false)
        else:
            verify(true)
            
    slow_it "error path 2 - empty check":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 2 - empty check guard
        step("exercise the guard: error path 2 - empty check")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 2 - empty check guard
        step("exercise the guard: error path 2 - empty check")
        val arr = []
        if arr.len() > 0:
            verify(false)
        else:
            verify(true)
            
    slow_it "error path 3 - negative check":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 3 - negative check guard
        step("exercise the guard: error path 3 - negative check")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 3 - negative check guard
        step("exercise the guard: error path 3 - negative check")
        val num = -1
        if num >= 0:
            verify(false)
        else:
            verify(true)
            
    slow_it "error path 4 - zero check":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 4 - zero check guard
        step("exercise the guard: error path 4 - zero check")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 4 - zero check guard
        step("exercise the guard: error path 4 - zero check")
        val num = 0
        if num > 0:
            verify(false)
        elif num < 0:
            verify(false)
        else:
            verify(true)
            
    slow_it "error path 5 - option unwrap fail":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 5 - option unwrap fail guard
        step("exercise the guard: error path 5 - option unwrap fail")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 5 - option unwrap fail guard
        step("exercise the guard: error path 5 - option unwrap fail")
        val opt = nil
        val result = opt ?? "default"
        verify(result == "default")
        
    slow_it "error path 6 - dict missing key":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 6 - dict missing key guard
        step("exercise the guard: error path 6 - dict missing key")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 6 - dict missing key guard
        step("exercise the guard: error path 6 - dict missing key")
        val d = {"key": "value"}
        val result = d.get("missing")
        verify(not result.?)
        
    slow_it "error path 7 - array out of bounds protection":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 7 - array out of bounds protection guard
        step("exercise the guard: error path 7 - array out of bounds protection")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 7 - array out of bounds protection guard
        step("exercise the guard: error path 7 - array out of bounds protection")
        val arr = [1, 2, 3]
        val safe_len = arr.len()
        verify(safe_len == 3)
        
    slow_it "error path 8 - string empty slice":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 8 - string empty slice guard
        step("exercise the guard: error path 8 - string empty slice")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 8 - string empty slice guard
        step("exercise the guard: error path 8 - string empty slice")
        val s = "test"
        val slice = s[0..0]
        verify(slice.len() == 0)
        
    slow_it "error path 9 - comparison false path":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 9 - comparison false path guard
        step("exercise the guard: error path 9 - comparison false path")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 9 - comparison false path guard
        step("exercise the guard: error path 9 - comparison false path")
        val a = 5
        val b = 10
        if a > b:
            verify(false)
        elif a == b:
            verify(false)
        else:
            verify(true)
            
    slow_it "error path 10 - match default":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 10 - match default guard
        step("exercise the guard: error path 10 - match default")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 10 - match default guard
        step("exercise the guard: error path 10 - match default")
        val value = 999
        val result = match value:
            1: "one"
            2: "two"
            _: "default"
        verify(result == "default")
        
    slow_it "error path 11 - loop never executes":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 11 - loop never executes guard
        step("exercise the guard: error path 11 - loop never executes")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 11 - loop never executes guard
        step("exercise the guard: error path 11 - loop never executes")
        var count = 0
        while false:
            count = count + 1
        verify(count == 0)
        
    slow_it "error path 12 - for loop empty range":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 12 - for loop empty range guard
        step("exercise the guard: error path 12 - for loop empty range")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 12 - for loop empty range guard
        step("exercise the guard: error path 12 - for loop empty range")
        var sum = 0
        for i in 10..10:
            sum = sum + i
        verify(sum == 0)
        
    slow_it "error path 13 - nested nil check":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 13 - nested nil check guard
        step("exercise the guard: error path 13 - nested nil check")
