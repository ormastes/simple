        step("exercise the guard: error path 22 - continue all")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 22 - continue all guard
        step("exercise the guard: error path 22 - continue all")
        val pre_continue = 5
        val post_continue = 0
        verify(pre_continue == 5)
        verify(post_continue == 0)
        
    slow_it "error path 23 - multiple elif failures":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 23 - multiple elif failures guard
        step("exercise the guard: error path 23 - multiple elif failures")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 23 - multiple elif failures guard
        step("exercise the guard: error path 23 - multiple elif failures")
        val x = 100
        if x < 10:
            verify(false)
        elif x < 50:
            verify(false)
        elif x < 75:
            verify(false)
        else:
            verify(true)
            
    slow_it "error path 24 - match all patterns fail to default":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 24 - match all patterns fail to default guard
        step("exercise the guard: error path 24 - match all patterns fail to default")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 24 - match all patterns fail to default guard
        step("exercise the guard: error path 24 - match all patterns fail to default")
        val value = "unknown"
        val result = match value:
            "a": 1
            "b": 2
            "c": 3
            _: 0
        verify(result == 0)
        
