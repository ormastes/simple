        # (statistics): verdict line retained for the error path 13 - nested nil check guard
        step("exercise the guard: error path 13 - nested nil check")
        val opt1 = nil
        val opt2 = opt1 ?? nil
        verify(not opt2.?)
        
    slow_it "error path 14 - boolean false branch":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 14 - boolean false branch guard
        step("exercise the guard: error path 14 - boolean false branch")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 14 - boolean false branch guard
        step("exercise the guard: error path 14 - boolean false branch")
