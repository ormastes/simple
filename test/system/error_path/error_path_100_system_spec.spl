        if cond and true:
            verify(false)
        else:
            verify(true)
            
    slow_it "error path 15 - or first false":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 15 - or first false guard
        step("exercise the guard: error path 15 - or first false")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 15 - or first false guard
        step("exercise the guard: error path 15 - or first false")
        val result = false or true
        verify(result)
        
    slow_it "error path 16 - and first false":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 16 - and first false guard
        step("exercise the guard: error path 16 - and first false")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 16 - and first false guard
        step("exercise the guard: error path 16 - and first false")
        val result = false and true
        verify(not result)
        
    slow_it "error path 17 - not operation":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 17 - not operation guard
        step("exercise the guard: error path 17 - not operation")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 17 - not operation guard
        step("exercise the guard: error path 17 - not operation")
        verify(not false)
        verify(not (not true))
        
    slow_it "error path 18 - empty string operations":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 18 - empty string operations guard
        step("exercise the guard: error path 18 - empty string operations")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 18 - empty string operations guard
        step("exercise the guard: error path 18 - empty string operations")
        val s = ""
        verify(not s.contains("x"))
        verify(s.starts_with(""))
        verify(s.ends_with(""))
        
    slow_it "error path 19 - zero division protection":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 19 - zero division protection guard
        step("exercise the guard: error path 19 - zero division protection")
        #  REQ-SYS-ERROR-PATH-28c3
        # (statistics): verdict line retained for the error path 19 - zero division protection guard
        step("exercise the guard: error path 19 - zero division protection")
        val denom = 1  # Ensure non-zero
        if denom != 0:
            val result = 10 / denom
            verify(result == 10)
        else:
            verify(false)
            
    slow_it "error path 20 - negative index":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 20 - negative index guard
        step("exercise the guard: error path 20 - negative index")
