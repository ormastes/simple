        val last = arr[-1]
        verify(last == 3)
        
    slow_it "error path 21 - break immediately":
        # @req REQ-SYS-ERROR-PATH-28c3
        # @capture(statistics): verdict line retained for the error path 21 - break immediately guard
        step("exercise the guard: error path 21 - break immediately")
        #  REQ-SYS-ERROR-PATH-28c3
