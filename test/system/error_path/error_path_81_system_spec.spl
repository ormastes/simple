"""
## Purpose and audience
Purpose: Verify Language error-path semantics through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test test/system/error_path/error_path_81_system_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-SYS-SYS_ERROR_PATH-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/sys_error_path_behavior.md
# doc-path: doc/03_plan/sys_test/sys_error_path_behavior.md
# doc-path: doc/04_architecture/lib/sys_error_path.md
# doc-path: doc/05_design/lib/sys_error_path_oracles.md
# @manual: primary

use std.spec
use std.spec.step

describe "Language error-path semantics":
    it "nil option is falsy and the ?? operator supplies the default":
        step("Verify: nil option is falsy and the ?? operator supplies the default")
        # @req: REQ-SYS-SYS_ERROR_PATH-001
        val absent: Option<text> = nil
        expect(absent.?).to_equal(false)
        expect((absent ?? "default")).to_equal("default")  # oracle: nil coalesces to the default

    it "an absent dict key reads back as nil, not a panic":
        step("Verify: an absent dict key reads back as nil, not a panic")
        # @req: REQ-SYS-SYS_ERROR_PATH-001
        val table = {"key": "value"}
        val missing = table.get("missing")
        expect(missing.?).to_equal(false)  # oracle: absent key -> nil
        expect(table.get("key").?).to_equal(true)  # oracle: present key -> wrapped value

    it "empty ranges and empty arrays behave as zero-length collections":
        step("Verify: empty ranges and empty arrays behave as zero-length collections")
        # @req: REQ-SYS-SYS_ERROR_PATH-001
        val empty: [i64] = []
        expect(empty.len()).to_equal(0)  # oracle: no elements
        var seen = 0
        for _i in 5..5:
            seen = seen + 1
        expect(seen).to_equal(0)  # oracle: an equal-bounds range iterates zero times

    it "an unmatched value falls through to the match default arm":
        step("Verify: an unmatched value falls through to the match default arm")
        # @req: REQ-SYS-SYS_ERROR_PATH-001
        val outcome = match 999:
            1: "one"
            2: "two"
            _: "default"
        expect(outcome).to_equal("default")  # oracle: the wildcard arm catches unmatched values

    it "break terminates the loop and continue skips one iteration":
        step("Verify: break terminates the loop and continue skips one iteration")
        # @req: REQ-SYS-SYS_ERROR_PATH-001
        var count = 0
        for i in 0..10:
            if i == 3:
                break
            if i == 1:
                continue
            count = count + 1
        expect(count).to_equal(2)  # oracle: iterations 0 and 2 counted before break at 3

    it "elif chains select exactly one arm":
        step("Verify: elif chains select exactly one arm")
        # @req: REQ-SYS-SYS_ERROR_PATH-001
        val x = 100
        var chosen = ""
        if x < 10:
            chosen = "small"
        elif x < 50:
            chosen = "medium"
        elif x < 75:
            chosen = "large"
        else:
            chosen = "huge"
        expect(chosen).to_equal("huge")  # oracle: only the final else arm matches 100

    it "empty string slices and concatenations preserve length laws":
        step("Verify: empty string slices and concatenations preserve length laws")
        # @req: REQ-SYS-SYS_ERROR_PATH-001
        val s = "test"
        expect(s[0..0].len()).to_equal(0)  # oracle: an empty slice has zero length
        expect(("" + "").len()).to_equal(0)  # oracle: concatenating empties stays empty

    it "a filter that matches nothing leaves the result empty":
        step("Verify: a filter that matches nothing leaves the result empty")
        # @req: REQ-SYS-SYS_ERROR_PATH-001
        var kept: [i64] = []
        for x in [1, 2, 3, 4, 5]:
            if x > 10:
                kept = kept.append(x)
        expect(kept.len()).to_equal(0)  # oracle: no element exceeds the threshold

