"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-DATABASE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/database/sdn_checksum_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-DATABASE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.io_runtime
use std.spec.{describe, it, expect, step}

extern fn rt_crc32_text(content: text) -> i64

describe "CRC32 Runtime":
    it "returns consistent hash for same input":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-DATABASE-001
        step("Verify: returns consistent hash for same input")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val crc1 = rt_crc32_text("hello")
        val crc2 = rt_crc32_text("hello")
        expect crc1 == crc2

    it "returns different hash for different input":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-DATABASE-002
        step("Verify: returns different hash for different input")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val crc1 = rt_crc32_text("hello")
        val crc2 = rt_crc32_text("world")
        expect crc1 != crc2

    it "handles empty string":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-DATABASE-003
        step("Verify: handles empty string")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val crc = rt_crc32_text("")
        expect crc == 0

    it "matches known CRC32 test vector":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-DATABASE-004
        step("Verify: matches known CRC32 test vector")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val crc = rt_crc32_text("123456789")
        expect crc == 3421780262

describe "SDN Checksum Integration":
    it "computes and verifies checksum header":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-DATABASE-005
        step("Verify: computes and verifies checksum header")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val body = "test data here\n"
        val crc = rt_crc32_text(body)
        val content = "#sdn-crc32:{crc}\n" + body
        expect content.starts_with("#sdn-crc32:")

    it "detects corruption in body":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-DATABASE-006
        step("Verify: detects corruption in body")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val body = "original data\n"
        val crc = rt_crc32_text(body)
        val corrupted = "corrupted data\n"
        val crc2 = rt_crc32_text(corrupted)
        expect crc != crc2

    it "parses checksum header correctly":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-DATABASE-007
        step("Verify: parses checksum header correctly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val body = "table_data|col1,col2|\n1\tAlice\n"
        val crc = rt_crc32_text(body)
        val content = "#sdn-crc32:{crc}\n" + body
        val lines = content.split("\n")
        val header_line = lines[0]
        expect header_line.starts_with("#sdn-crc32:")
        val stored_str = header_line.slice(11, header_line.len())
        val stored_crc = stored_str.to_int() ?? -1
        expect stored_crc == crc
