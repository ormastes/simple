describe "RequirementDatabase all_requirements", tag: ["system"]:
    it "returns all valid requirements":
        # @req: REQ-SYSTEM-DATABASE-007
        step("Verify: returns all valid requirements")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var db = RequirementDatabase.create()

        val req1 = Requirement(
            id: "REQ-001",
            title: "First",
            category: "feature",
            status: "draft",
            priority: "high",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )
        val req2 = Requirement(
            id: "REQ-002",
            title: "Second",
            category: "bugfix",
            status: "implemented",
            priority: "medium",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )
        db.add_requirement(req1)
        db.add_requirement(req2)

        val all = db.all_requirements()
        expect(all.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec


describe "RequirementDatabase requirements_by_status", tag: ["system"]:
    it "filters requirements by status":
        # @req: REQ-SYSTEM-DATABASE-008
        step("Verify: filters requirements by status")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var db = RequirementDatabase.create()

        val draft_req = Requirement(
            id: "REQ-001",
            title: "Draft requirement",
            category: "feature",
            status: "draft",
            priority: "high",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )
        val approved_req = Requirement(
            id: "REQ-002",
            title: "Approved requirement",
            category: "feature",
            status: "approved",
            priority: "medium",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )
        val impl_req = Requirement(
            id: "REQ-003",
            title: "Implemented requirement",
            category: "bugfix",
            status: "implemented",
            priority: "low",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )

        db.add_requirement(draft_req)
        db.add_requirement(approved_req)
        db.add_requirement(impl_req)

        val drafts = db.requirements_by_status("draft")
        expect(drafts.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(drafts[0].id).to_equal("REQ-001")

        val approved = db.requirements_by_status("approved")
        expect(approved.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(approved[0].id).to_equal("REQ-002")

        val implemented = db.requirements_by_status("implemented")
        expect(implemented.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(implemented[0].id).to_equal("REQ-003")

        val verified = db.requirements_by_status("verified")
        expect(verified.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec


describe "RequirementDatabase requirements_by_category", tag: ["system"]:
    it "filters requirements by category":
        # @req: REQ-SYSTEM-DATABASE-009
        step("Verify: filters requirements by category")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var db = RequirementDatabase.create()

        val feat_req = Requirement(
            id: "REQ-001",
            title: "Feature requirement",
            category: "feature",
            status: "draft",
            priority: "high",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )
        val bugfix_req = Requirement(
            id: "REQ-002",
            title: "Bugfix requirement",
            category: "bugfix",
            status: "draft",
            priority: "critical",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )
        val refactor_req = Requirement(
            id: "REQ-003",
            title: "Refactor requirement",
            category: "refactor",
            status: "approved",
            priority: "low",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )

        db.add_requirement(feat_req)
        db.add_requirement(bugfix_req)
        db.add_requirement(refactor_req)

        val features = db.requirements_by_category("feature")
        expect(features.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(features[0].id).to_equal("REQ-001")

        val bugfixes = db.requirements_by_category("bugfix")
        expect(bugfixes.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(bugfixes[0].id).to_equal("REQ-002")

        val refactors = db.requirements_by_category("refactor")
        expect(refactors.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(refactors[0].id).to_equal("REQ-003")

        val improvements = db.requirements_by_category("improvement")
        expect(improvements.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec


# ============================================================================
# Description Storage
# ============================================================================

describe "RequirementDatabase descriptions", tag: ["system"]:
    it "stores and retrieves multiline description":
        # @req: REQ-SYSTEM-DATABASE-010
        step("Verify: stores and retrieves multiline description")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var db = RequirementDatabase.create()

        val req = Requirement(
            id: "REQ-001",
            title: "Described requirement",
            category: "feature",
            status: "draft",
            priority: "high",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )
        db.add_requirement(req)

        val description = "This is line one.\nThis is line two.\nThis is line three."
        db.add_description("REQ-001", description)

        val retrieved = db.get_description("REQ-001")
        expect(retrieved).to_contain("line one")
        expect(retrieved).to_contain("line two")
        expect(retrieved).to_contain("line three")

    it "returns empty string for unknown req_id":
        # @req: REQ-SYSTEM-DATABASE-011
        step("Verify: returns empty string for unknown req_id")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var db = RequirementDatabase.create()
        val desc = db.get_description("REQ-NONEXISTENT")
        expect(desc).to_equal("")


# ============================================================================
# Persistence
# ============================================================================

describe "RequirementDatabase save", tag: ["system"]:
    it "persists data to disk":
        # @req: REQ-SYSTEM-DATABASE-012
        step("Verify: persists data to disk")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val db_path = "/tmp/test_reqdb_save.sdn"
        cleanup(db_path)
        var db = RequirementDatabase.create()

        val req = Requirement(
            id: "REQ-001",
            title: "Persisted requirement",
            category: "feature",
            status: "approved",
            priority: "high",
            doc_path: "doc/requirement/req_001.md",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )
        db.add_requirement(req)

        val saved = db.save()
        expect(saved).to_equal(true)
        expect(rt_file_exists(db_path)).to_equal(true)
