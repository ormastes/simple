# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# x86_64 Boot QEMU Tests — Architecture-Specific
#
# Detailed x86_64 boot verification: COM1 serial, GDT, IDT, Limine.
#
# @platform: baremetal(x86_64)
# @tag: os,qemu,boot,x86_64

use std.spec.step

use os.qemu_runner.{get_target, build_qemu_command}
use os.kernel.arch.arch_context.{Architecture}

extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)
extern fn rt_file_exists(path: text) -> bool

val TIMEOUT_MS: i64 = 10000
val ARCH = Architecture.X86_64

fn _can_run() -> bool:
    val target = get_target(ARCH)
    val qemu_check = rt_process_run_timeout("which", [target.qemu_system], 5000)
    if qemu_check[2] != 0:
        print "SKIP: {target.qemu_system} not found"
        return false
    if not rt_file_exists(target.output):
        print "SKIP: Kernel not built: {target.output}"
        return false
    true

fn _run_qemu() -> text:
    val target = get_target(ARCH)
    val cmd_parts = build_qemu_command(target)
    val qemu_bin = cmd_parts[0]
    var args: [text] = []
    for i in 1..cmd_parts.len():
        args.push(cmd_parts[i])
    val result = rt_process_run_timeout(qemu_bin, args, TIMEOUT_MS)
    result[0] + result[1]

describe "x86_64 Architecture Boot":
    # @manual scenario evidence
    slow_it "COM1 serial initialized at 0x3F8":
        # @req REQ-SSPEC-SYSTEM
        step("COM1 serial initialized at 0x3F8")
        if _can_run():
            val output = _run_qemu()
            expect(output).to_contain("serial")

    slow_it "prints x86_64 architecture identifier":
        # @req REQ-SSPEC-SYSTEM
        step("prints x86_64 architecture identifier")
        if _can_run():
            val output = _run_qemu()
            expect(output).to_contain("x86_64")

    slow_it "memory map detected":
        # @req REQ-SSPEC-SYSTEM
        step("memory map detected")
        if _can_run():
            val output = _run_qemu()
            expect(output).to_contain("Memory map")

    slow_it "GDT loaded":
        # @req REQ-SSPEC-SYSTEM
        step("GDT loaded")
        if _can_run():
            val output = _run_qemu()
            expect(output).to_contain("GDT")

    slow_it "boot sequence completes":
        # @req REQ-SSPEC-SYSTEM
        step("boot sequence completes")
        if _can_run():
            val output = _run_qemu()
            expect(output).to_contain("boot complete")
