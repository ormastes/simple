"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-BROWSER_RUNTIME_IN_QEMU behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/browser_runtime_in_qemu_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-BROWSER_RUNTIME_IN_QEMU-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @tag:system
# @session:mutating
# @arch:x86_64
use std.spec.*

use os.qemu_runner.{OsTarget, build_os_with_backend}
use os.kernel.arch.arch_context.{Architecture}
use std.nogc_sync_mut.ffi.io.{dir_create_all}
extern fn rt_file_read_text(path: text) -> text
use test.system.qemu.os.common.qemu_os_harness.{
    can_run_target, file_exists, spawn_guest_with_qmp,
    stop_guest, wait_for_serial_marker}

fn _runtime_target(backend: text) -> OsTarget:
    OsTarget(
        arch: Architecture.X86_64,
        entry: "examples/09_embedded/simple_os/arch/x86_64/browser_runtime_probe_entry.spl",
        linker_script: "examples/09_embedded/simple_os/arch/x86_64/linker.ld",
        target_triple: "x86_64-unknown-none",
        output: "build/os/simpleos_browser_runtime_probe_{backend}_x86_64.elf",
        qemu_system: "qemu-system-x86_64",
        qemu_machine: "q35",
        qemu_cpu: "qemu64",
        qemu_memory: "2G",
        qemu_bios: "",
        qemu_extra: ["-device", "isa-debug-exit,iobase=0xf4,iosize=0x04"],
        gui_mode: false
    )

fn _assert_browser_runtime_build(backend: text):
    val target = _runtime_target(backend)
    val ok = build_os_with_backend(target, backend)
    if backend == "llvm" and not ok:
        print "SKIP: LLVM backend unavailable for browser runtime probe"
        expect(backend).to_equal("llvm")
        return
    expect(ok).to_equal(true)
    expect(file_exists(target.output)).to_equal(true)

fn _assert_browser_runtime_boot(backend: text):
    val target = _runtime_target(backend)
    if backend == "llvm" and not file_exists(target.output):
        print "SKIP: LLVM browser runtime kernel was not built"
        expect(backend).to_equal("llvm")
        return
    expect(file_exists(target.output)).to_equal(true)

    if not can_run_target(target):
        print "[browser_runtime_in_qemu_spec] qemu-system-x86_64 not available, skipping live run ({backend})"
        expect(target.qemu_system).to_equal("qemu-system-x86_64")
        expect(file_exists(target.output)).to_equal(true)
        return

    val qmp_socket = "/tmp/simpleos_browser_runtime_spec_{backend}_qmp.sock"
    val serial_log = "build/os/browser_runtime_qemu_spec_{backend}_serial.log"
    dir_create_all("build/os")

    match spawn_guest_with_qmp(target, qmp_socket, serial_log):
        Ok(handle):
            val marker_ok = wait_for_serial_marker(
                handle,
                "[BR] Runtime probe passed",
                30000)
            if not marker_ok and file_exists(serial_log):
                print "[browser_runtime_in_qemu_spec] serial log for {backend}:"
                print rt_file_read_text(serial_log) ?? ""
            expect(marker_ok).to_equal(true)
            expect(stop_guest(handle)).to_equal(true)
            expect(file_exists(qmp_socket)).to_equal(false)
            expect(file_exists(serial_log)).to_equal(false)
        Err(err):
            print "[browser_runtime_in_qemu_spec] failed to spawn guest ({backend}): {err}"
            expect(err.len() > 0).to_equal(true)
            expect(file_exists(target.output)).to_equal(true)

describe "Browser runtime in QEMU Simple OS guest":

    it "builds the browser runtime probe kernel with Cranelift":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-BROWSER_RUNTIME_IN_QEMU-001
        step("Verify: builds the browser runtime probe kernel with Cranelift")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        _assert_browser_runtime_build("cranelift")

    it "builds the browser runtime probe kernel with LLVM":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-BROWSER_RUNTIME_IN_QEMU-002
        step("Verify: builds the browser runtime probe kernel with LLVM")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        _assert_browser_runtime_build("llvm")

    it "boots the Cranelift guest and reaches the browser runtime probe success marker":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-BROWSER_RUNTIME_IN_QEMU-003
        step("Verify: boots the Cranelift guest and reaches the browser runtime probe success marker")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        _assert_browser_runtime_boot("cranelift")

    it "boots the LLVM guest and reaches the browser runtime probe success marker":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-BROWSER_RUNTIME_IN_QEMU-004
        step("Verify: boots the LLVM guest and reaches the browser runtime probe success marker")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        _assert_browser_runtime_boot("llvm")
