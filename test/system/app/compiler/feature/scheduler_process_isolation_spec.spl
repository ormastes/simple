"""
## Purpose and audience

System-facing scheduler process isolation specification.

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/compiler/feature/scheduler_process_isolation_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec.{describe, it, expect, step}
use compiler.common.attributes.{TaskAttr, validate_task_policy_attr}

"""
Traceable coverage for task policy validation requirements.
"""
describe "scheduler_process_isolation":
    describe "REQ-SPI-006: task policy validation":
        it "allows fair tasks in hosted runtime families":
            # @req: REQ-SYSTEM-APP-001 REQ-SPI-006
                # @req: REQ-SYSTEM-APP-002
                # @req: REQ-SYSTEM-APP-003
            step("Verify: allows fair tasks in hosted runtime families")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val attr = TaskAttr(
                instances: 1,
                group: nil,
                frame: nil,
                wait_nodes: 0,
                policy: "fair",
                weight: nil,
                priority: nil,
                latency_hint: nil,
                runtime_ns: nil,
                period_ns: nil,
                deadline_ns: nil
            )
            val result = validate_task_policy_attr(attr, "nogc_async_mut", [])
            expect(result.has_errors).to_equal(false)

        it "rejects realtime task metadata outside noalloc runtime":
            # @req: REQ-SYSTEM-APP-004
            step("Verify: rejects realtime task metadata outside noalloc runtime")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val attr = TaskAttr(
                instances: 1,
                group: nil,
                frame: nil,
                wait_nodes: 0,
                policy: "rt_rr",
                weight: nil,
                priority: nil,
                latency_hint: nil,
                runtime_ns: nil,
                period_ns: nil,
                deadline_ns: nil
            )
            val result = validate_task_policy_attr(attr, "nogc_async_mut", [])
            expect(result.has_errors).to_equal(true)

        it "allows deadline task metadata with valid noalloc budget":
            # @req: REQ-SYSTEM-APP-005
            step("Verify: allows deadline task metadata with valid noalloc budget")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val attr = TaskAttr(
                instances: 1,
                group: nil,
                frame: nil,
                wait_nodes: 0,
                policy: "deadline",
                weight: nil,
                priority: nil,
                latency_hint: nil,
                runtime_ns: 200000,
                period_ns: 1000000,
                deadline_ns: 1000000
            )
            val result = validate_task_policy_attr(attr, "nogc_async_mut_noalloc", [])
            expect(result.has_errors).to_equal(false)

        it "rejects deadline task metadata with invalid budget":
            # @req: REQ-SYSTEM-APP-006
            step("Verify: rejects deadline task metadata with invalid budget")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val attr = TaskAttr(
                instances: 1,
                group: nil,
                frame: nil,
                wait_nodes: 0,
                policy: "deadline",
                weight: nil,
                priority: nil,
                latency_hint: nil,
                runtime_ns: 1200000,
                period_ns: 1000000,
                deadline_ns: 1000000
            )
            val result = validate_task_policy_attr(attr, "nogc_async_mut_noalloc", [])
            expect(result.has_errors).to_equal(true)
