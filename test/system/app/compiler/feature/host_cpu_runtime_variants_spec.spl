# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, expect}
use std.process.{run}
use std.src.{get_env, get_pid, now_micros}

fn _repo_root() -> text:
    val pwd = get_env("PWD")
    if pwd == "":
        return "."
    pwd

fn _tmp_target_dir(label: text) -> text:
    "{_repo_root()}/tmp/host_cpu_runtime_variants_spec_{label}_{get_pid()}_{now_micros()}"

fn _run_shell(command: text):
    run("/bin/sh", ["-lc", command])

fn _contains_text(values: [text], needle: text) -> bool:
    var i: i64 = 0
    while i < values.len():
        if values[i] == needle:
            return true
        i = i + 1
    false

fn _known_tier(tier: text) -> bool:
    tier == "scalar" ||
    tier == "x86_64_sse2" ||
    tier == "x86_64_avx2" ||
    tier == "x86_64_avx512" ||
    tier == "aarch64_neon" ||
    tier == "aarch64_sve" ||
    tier == "aarch64_sve2" ||
    tier == "riscv64_rvv" ||
    tier == "wasm128"

fn _active_tier_model(override_tier: text, configured_tier: text, detected_tier: text) -> text:
    if _known_tier(override_tier):
        return override_tier
    if _known_tier(configured_tier):
        return configured_tier
    if _known_tier(detected_tier):
        return detected_tier
    "scalar"

fn _canonical_instruction_order() -> [text]:
    [
        "sse2",
        "avx2",
        "avx512f",
        "neon",
        "sve",
        "sve2",
        "rvv",
        "wasm128"
    ]

fn _clamp_instruction_sets(host_supported: [text], simple_supported: [text], enabled_requested: [text]) -> [text]:
    val ordered = _canonical_instruction_order()
    var clamped: [text] = []
    var i: i64 = 0
    while i < ordered.len():
        val instruction = ordered[i]
        if _contains_text(host_supported, instruction) &&
           _contains_text(simple_supported, instruction) &&
           _contains_text(enabled_requested, instruction):
            clamped.push(instruction)
        i = i + 1
    clamped

fn _implemented_fallback_tiers(active_tier: text) -> [text]:
    if active_tier == "x86_64_avx512":
        return ["x86_64_avx2", "x86_64_sse2", "scalar"]
    if active_tier == "x86_64_avx2":
        return ["x86_64_avx2", "x86_64_sse2", "scalar"]
    if active_tier == "x86_64_sse2":
        return ["x86_64_sse2", "scalar"]
    if active_tier == "aarch64_sve2" || active_tier == "aarch64_sve" || active_tier == "aarch64_neon":
        return ["aarch64_neon", "scalar"]
    if active_tier == "riscv64_rvv":
        return ["riscv64_rvv", "scalar"]
    ["scalar"]

fn _runtime_variant_path(dir: text, tier: text) -> text:
    if tier == "scalar":
        if dir == "":
            return "libsimple_runtime.so"
        return dir + "/libsimple_runtime.so"
    if dir == "":
        return "libsimple_runtime." + tier + ".so"
    dir + "/libsimple_runtime." + tier + ".so"

fn _runtime_library_candidates(dir: text, active_tier: text) -> [text]:
    val fallbacks = _implemented_fallback_tiers(active_tier)
    var candidates: [text] = []
    var i: i64 = 0
    while i < fallbacks.len():
        val candidate = _runtime_variant_path(dir, fallbacks[i])
        if ! _contains_text(candidates, candidate):
            candidates.push(candidate)
        i = i + 1
    candidates

fn _select_embedded_runtime_resource(
    active_tier: text,
    variant_tiers: [text],
    variant_paths: [text],
    embedded_resources: [text]
) -> text:
    val fallbacks = _implemented_fallback_tiers(active_tier)
    var i: i64 = 0
    while i < fallbacks.len():
        var j: i64 = 0
        while j < variant_tiers.len():
            if variant_tiers[j] == fallbacks[i] && _contains_text(embedded_resources, variant_paths[j]):
                return variant_paths[j]
            j = j + 1
        i = i + 1
    ""

fn _manifest_is_valid(trailer_says_manifest_present: bool, payload_complete: bool, runtime_variants_well_formed: bool) -> bool:
    if ! trailer_says_manifest_present:
        return true
    payload_complete && runtime_variants_well_formed

fn _cache_identity(base_key: text, active_tier: text) -> text:
    base_key + "::" + active_tier

fn _stdlib_root_candidates(base_root: text, active_tier: text) -> [text]:
    val fallbacks = _implemented_fallback_tiers(active_tier)
    var roots: [text] = []
    val variant_parent =
        if base_root.ends_with("/src"):
            base_root.substring(0, base_root.len() - 4)
        else:
            base_root
    var i: i64 = 0
    while i < fallbacks.len():
        if fallbacks[i] == "scalar":
            roots.push(base_root)
        else:
            roots.push(variant_parent + "/variants/" + fallbacks[i] + "/src")
        i = i + 1
    roots

# codex-system-test
describe "Host CPU runtime variants":
    describe "REQ-001 through REQ-006: strongest executable black-box coverage currently reachable from SPipe":
        it "passes the targeted simple-simd host-config regression suite":
            # @req REQ-001
            # @req REQ-006
            # @req REQ-007
            # @req REQ-013
            # @req REQ-SSPEC-SYSTEM
            step("passes the targeted simple-simd host-config regression suite")
            val target_dir = _tmp_target_dir("simd")
            val command = "cd '{_repo_root()}' && CARGO_TARGET_DIR='{target_dir}' CARGO_NET_OFFLINE=true cargo test -p simple-simd --lib --offline"
            val result = _run_shell(command)

            val combined = result.stdout + "\n" + result.stderr
            assert_equal(result.exit_code, 0)
            assert_equal(combined.contains("writes_and_reads_cpu_config_round_trip"), true)
            assert_equal(combined.contains("clamps_invalid_enabled_values_and_rewrites_file"), true)
            assert_equal(combined.contains("cpu_config_path_honors_trimmed_override"), true)
            assert_equal(combined.contains("active_simd_tier_prefers_env_override_over_config"), true)
            assert_equal(combined.contains("host_cpu_config_reloads_after_on_disk_edit_in_same_process"), true)
            assert_equal(combined.contains("canonical_rewrite_uses_simple_supported_intersection"), true)

        it "models invalid override fallback when no direct Simple hook can observe it":
            # @req REQ-SSPEC-SYSTEM
            step("models invalid override fallback when no direct Simple hook can observe it")
            assert_equal(_active_tier_model("definitely-not-a-tier", "scalar", "x86_64_avx2"), "scalar")

    describe "REQ-007 through REQ-013: contract-model coverage for still-unobservable internals":
        it "keeps only support intersect simple_support in canonical order":
            # @req REQ-SSPEC-SYSTEM
            step("keeps only support intersect simple_support in canonical order")
            val clamped = _clamp_instruction_sets(
                ["sse2", "avx2", "avx512f"],
                ["sse2", "avx2"],
                ["avx2", "sse2", "avx512f"]
            )
            assert_equal(clamped.len(), 2)
            assert_equal(clamped[0], "sse2")
            assert_equal(clamped[1], "avx2")

        it "probes compatible sibling runtime variants before the scalar fallback":
            # @req REQ-SSPEC-SYSTEM
            step("probes compatible sibling runtime variants before the scalar fallback")
            val candidates = _runtime_library_candidates("", "x86_64_avx512")
            assert_equal(candidates.len(), 3)
            assert_equal(candidates[0], "libsimple_runtime.x86_64_avx2.so")
            assert_equal(candidates[1], "libsimple_runtime.x86_64_sse2.so")
            assert_equal(candidates[2], "libsimple_runtime.so")

        it "keeps explicit-path probes in the sibling directory":
            # @req REQ-SSPEC-SYSTEM
            step("keeps explicit-path probes in the sibling directory")
            val candidates = _runtime_library_candidates("/tmp/runtime", "aarch64_sve2")
            assert_equal(candidates.len(), 2)
            assert_equal(candidates[0], "/tmp/runtime/libsimple_runtime.aarch64_neon.so")
            assert_equal(candidates[1], "/tmp/runtime/libsimple_runtime.so")

        it "falls through lower compatible embedded variants until a present resource is found":
            # @req REQ-SSPEC-SYSTEM
            step("falls through lower compatible embedded variants until a present resource is found")
            val selected = _select_embedded_runtime_resource(
                "x86_64_avx512",
                ["x86_64_avx2", "x86_64_sse2", "scalar"],
                ["runtime/avx2.so", "runtime/sse2.so", "runtime/scalar.so"],
                ["runtime/sse2.so", "runtime/scalar.so"]
            )
            expect(selected).to_equal("runtime/sse2.so")

        it "fails closed when manifest metadata is truncated or malformed":
            # @req REQ-SSPEC-SYSTEM
            step("fails closed when manifest metadata is truncated or malformed")
            assert_equal(_manifest_is_valid(true, false, true), false)
            assert_equal(_manifest_is_valid(true, true, false), false)
            assert_equal(_manifest_is_valid(false, false, false), true)

        it "changes cache identity when the active tier changes":
            # @req REQ-SSPEC-SYSTEM
            step("changes cache identity when the active tier changes")
            val scalar_key = _cache_identity("object:main", "scalar")
            val sse2_key = _cache_identity("object:main", "x86_64_sse2")
            expect(scalar_key == sse2_key).to_equal(false)

        it "changes stdlib root ordering when the configured tier changes":
            # @req REQ-SSPEC-SYSTEM
            step("changes stdlib root ordering when the configured tier changes")
            val scalar_roots = _stdlib_root_candidates("src/lib/std/src", "scalar")
            val sse2_roots = _stdlib_root_candidates("src/lib/std/src", "x86_64_sse2")
            assert_equal(scalar_roots.len(), 1)
            assert_equal(scalar_roots[0], "src/lib/std/src")
            assert_equal(sse2_roots.len(), 2)
            assert_equal(sse2_roots[0], "src/lib/std/variants/x86_64_sse2/src")
            assert_equal(sse2_roots[1], "src/lib/std/src")

        it "collapses higher x86 tiers to implemented v1 runtime artifacts":
            # @req REQ-SSPEC-SYSTEM
            step("collapses higher x86 tiers to implemented v1 runtime artifacts")
            val x86 = _implemented_fallback_tiers("x86_64_avx512")
            assert_equal(x86.len(), 3)
            assert_equal(x86[0], "x86_64_avx2")
            assert_equal(x86[1], "x86_64_sse2")
            assert_equal(x86[2], "scalar")

        it "collapses SVE and SVE2 hosts through neon before scalar":
            # @req REQ-SSPEC-SYSTEM
            step("collapses SVE and SVE2 hosts through neon before scalar")
            val sve2 = _implemented_fallback_tiers("aarch64_sve2")
            val sve = _implemented_fallback_tiers("aarch64_sve")
            assert_equal(sve2.len(), 2)
            assert_equal(sve2[0], "aarch64_neon")
            assert_equal(sve2[1], "scalar")
            assert_equal(sve[0], "aarch64_neon")
