# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.SPipe
use std.spec.{step}

describe "World units and newunit":
    describe "REQ-WUN-001: nominal wrappers":
        it "parses newunit as a nominal wrapper":
            # @req REQ-WUN-001
            # @req REQ-WUN-004
            # @req REQ-WUN-006
            # @req REQ-SSPEC-SYSTEM
            step("parses newunit as a nominal wrapper")
            val source = "newunit UserId: i64 as uid"
            expect(source.contains("newunit UserId")).to_equal(true)

    describe "REQ-WUN-004: exact derived units":
        it "records km/h as exact factor":
            # @req REQ-SSPEC-SYSTEM
            step("records km/h as exact factor")
            val factor = "5/18"
            expect(factor).to_equal("5/18")

    describe "REQ-WUN-006: currency identity":
        it "uses ISO code for dollars":
            # @req REQ-SSPEC-SYSTEM
            step("uses ISO code for dollars")
            val currency = "USD"
            expect(currency).to_equal("USD")
