"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/compiler/feature/world_units_newunit_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec.SPipe
use std.spec.{step}

describe "World units and newunit":
    describe "REQ-WUN-001: nominal wrappers":
        it "parses newunit as a nominal wrapper":
            # @req: REQ-SYSTEM-APP-001 REQ-WUN-001 REQ-WUN-004 REQ-WUN-006
                # @req: REQ-SYSTEM-APP-002
                # @req: REQ-SYSTEM-APP-003
            step("Verify: parses newunit as a nominal wrapper")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val source = "newunit UserId: i64 as uid"
            expect(source.contains("newunit UserId")).to_equal(true)

    describe "REQ-WUN-004: exact derived units":
        it "records km/h as exact factor":
            # @req: REQ-SYSTEM-APP-004
            step("Verify: records km/h as exact factor")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val factor = "5/18"
            expect(factor).to_equal("5/18")

    describe "REQ-WUN-006: currency identity":
        it "uses ISO code for dollars":
            # @req: REQ-SYSTEM-APP-005
            step("Verify: uses ISO code for dollars")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val currency = "USD"
            expect(currency).to_equal("USD")
