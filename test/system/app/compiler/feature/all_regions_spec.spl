"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/compiler/feature/all_regions_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec.SPipe
use std.spec.{step}

describe "all regions language strategy":
    describe "REQ-001: region map":
        it "keeps SDN as carrier rather than universal authoring surface":
            # @req: REQ-SYSTEM-APP-001 REQ-003 REQ-004
                # @req: REQ-001
            step("Verify: keeps SDN as carrier rather than universal authoring surface")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val sdn_primary = "config manifests metadata snapshots catalogs generated-ir"
            expect(sdn_primary).to_contain("metadata")

    describe "REQ-003: priority order":
        it "starts with schema and style/ui":
            # @req: REQ-SYSTEM-APP-002
            step("Verify: starts with schema and style/ui")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val first = "schema"
            val second = "style/ui"
            expect(first).to_equal("schema")
            expect(second).to_equal("style/ui")

    describe "REQ-004: interchange anchors":
        it "names standards for heavy domains":
            # @req: REQ-SYSTEM-APP-003
            step("Verify: names standards for heavy domains")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val anchors = "MusicXML IFC bSDD gbXML CityGML STEP AP242 VHDL SystemVerilog"
            expect(anchors).to_contain("MusicXML")
            expect(anchors).to_contain("STEP AP242")

