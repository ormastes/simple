"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/scv/feature/scv_restore_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use app.io.mod (process_run)
use std.spec.{step}

fn _scv_restore_doc_script(script: text) -> text:
    val (out, err, code) = process_run("/bin/sh", ["-c", script])
    val combined = "{out}{err}\nexit={code}\n"
    # Prevention guard for this whole shell-out class: assert the subprocess
    # ACTUALLY RAN, before any content assertion in the examples below.
    #
    # The scripts invoke `bin/simple` (the documented default tool path), NOT
    # `bin/release/simple`. The latter is a production-guard shell wrapper that
    # refuses to exec a non-production runtime ("refusing non-production Simple
    # runtime") and exits WITHOUT running anything, leaving stdout empty -- so
    # every `to_contain(...)` below failed and produced a plausible,
    # feature-shaped false RED.
    #
    # These three checks fail identically for a bad binary path, a refusing
    # wrapper, or a missing fixture, and they cost no extra compiler launch
    # because they run inside the helper each example already calls.
    expect(code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
    expect(out == "" and err == "").to_equal(false)
    expect(combined.contains("refusing non-production")).to_equal(false)
    combined

describe "REQ-004 restore operation views":
    it "restores exact files and deletes tracked paths absent from the target tree":
        # @req: REQ-SYSTEM-APP-001
            # @req: REQ-004
        step("Verify: restores exact files and deletes tracked paths absent from the target tree")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val script = "set -eu\nREPO=$(pwd)\nTMP=$(mktemp -d /tmp/scv-doc-restore.XXXXXX)\nprintf 'base\\n' > \"$TMP/a.txt\"\ncd \"$TMP\"\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" init >/dev/null\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" snapshot >/dev/null\nBASE_OP=$(cat .scv/HEAD_OP)\nprintf 'later\\n' > b.txt\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" snapshot >/dev/null\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" restore-op \"$BASE_OP\"\ntest ! -e b.txt\nprintf 'a=%s\\n' \"$(cat a.txt | tr '\\n' '|')\"\n"
        val out = _scv_restore_doc_script(script)
        expect(out).to_contain("restored 1")
        expect(out).to_contain("a=base|")
