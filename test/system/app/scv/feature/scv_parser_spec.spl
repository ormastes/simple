"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/scv/feature/scv_parser_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use app.io.mod (process_run)
use std.spec.{step}

fn _scv_parser_doc_script(script: text) -> text:
    val (out, err, code) = process_run("/bin/sh", ["-c", script])
    val combined = "{out}{err}\nexit={code}\n"
    # Prevention guard for this whole shell-out class: assert the subprocess
    # ACTUALLY RAN, before any content assertion in the examples below.
    #
    # The scripts invoke `bin/simple` (the documented default tool path), NOT
    # `bin/release/simple`. The latter is a production-guard shell wrapper that
    # refuses to exec a non-production runtime ("refusing non-production Simple
    # runtime") and exits WITHOUT running anything, leaving stdout empty -- so
    # every `to_contain(...)` below failed and produced a plausible,
    # feature-shaped false RED.
    #
    # These three checks fail identically for a bad binary path, a refusing
    # wrapper, or a missing fixture, and they cost no extra compiler launch
    # because they run inside the helper each example already calls.
    expect(code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
    expect(out == "" and err == "").to_equal(false)
    expect(combined.contains("refusing non-production")).to_equal(false)
    combined

describe "REQ-008 REQ-009 parser index":
    it "records fallback syntax and semantic hashes":
        # @req: REQ-SYSTEM-APP-001
            # @req: REQ-009
            # @req: REQ-008
        step("Verify: records fallback syntax and semantic hashes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val script = "set -eu\nREPO=$(pwd)\nTMP=$(mktemp -d /tmp/scv-doc-parser.XXXXXX)\nprintf 'alpha\\n' > \"$TMP/a.txt\"\ncd \"$TMP\"\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" init >/dev/null\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" snapshot >/dev/null\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" parse-gate a.txt\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" parse-index\n"
        val out = _scv_parser_doc_script(script)
        expect(out).to_contain("parse-gate a.txt parsed_ok")
        expect(out).to_contain("a.txt|fallback|sha256_")
        expect(out).to_contain("|syntax_")
        expect(out).to_contain("|semantic_")

    it "locks local WASM parser artifacts without executing them":
        # @req: REQ-SYSTEM-APP-002
        step("Verify: locks local WASM parser artifacts without executing them")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val script = "set -eu\nREPO=$(pwd)\nTMP=$(mktemp -d /tmp/scv-doc-parser-install.XXXXXX)\nprintf '\\\\000asmx' > \"$TMP/parser.wasm\"\ncd \"$TMP\"\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" init >/dev/null\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" parser-install simple tree-sitter-simple 0.1.0 parser.wasm\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" parser-verify\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" parsers\n"
        val out = _scv_parser_doc_script(script)
        expect(out).to_contain("parser-install simple tree-sitter-simple 0.1.0")
        expect(out).to_contain("parser-verify checked=1")
        expect(out).to_contain("simple|tree-sitter-simple|0.1.0|wasm32|wasm|sha256_")
