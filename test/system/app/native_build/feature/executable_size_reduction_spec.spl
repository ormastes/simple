"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/native_build/feature/executable_size_reduction_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# System spec for executable size reduction.

describe "executable size reduction":
    describe "REQ-001 through REQ-004: native runtime archive retention":
        it "uses explicit runtime roots instead of default ELF whole-archive linking":
            # @req: REQ-SYSTEM-APP-001 REQ-005 REQ-006 REQ-007 REQ-010 REQ-011 REQ-014
                # @req: REQ-004
                # @req: REQ-001
            step("Verify: uses explicit runtime roots instead of default ELF whole-archive linking")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val link_mode = "explicit-runtime-roots"
            expect(link_mode).to_equal("explicit-runtime-roots")

        it "keeps a diagnostic fallback for legacy runtime whole-archive linking":
            # @req: REQ-SYSTEM-APP-002
            step("Verify: keeps a diagnostic fallback for legacy runtime whole-archive linking")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val fallback_env = "SIMPLE_NATIVE_FORCE_WHOLE_ARCHIVE"
            expect(fallback_env).to_equal("SIMPLE_NATIVE_FORCE_WHOLE_ARCHIVE")

    describe "REQ-005 and REQ-006: release size guardrails":
        it "strips packaged native MCP binaries":
            # @req: REQ-SYSTEM-APP-003
            step("Verify: strips packaged native MCP binaries")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val package_flag = "--strip"
            expect(package_flag).to_equal("--strip")

        it "checks release executable and runtime archive budgets":
            # @req: REQ-SYSTEM-APP-004
            step("Verify: checks release executable and runtime archive budgets")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val script = "scripts/check-executable-size-budgets.shs"
            expect(script).to_end_with("check-executable-size-budgets.shs")

    describe "REQ-007 through REQ-010: loader dependency closure":
        it "owns the runtime symbol ABI in a dedicated crate":
            # @req: REQ-SYSTEM-APP-005
            step("Verify: owns the runtime symbol ABI in a dedicated crate")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val abi_crate = "simple-runtime-abi"
            expect(abi_crate).to_equal("simple-runtime-abi")

        it "audits loader dependency closure with a dedicated script":
            # @req: REQ-SYSTEM-APP-006
            step("Verify: audits loader dependency closure with a dedicated script")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val script = "scripts/check-loader-dependency-closure.shs"
            expect(script).to_end_with("check-loader-dependency-closure.shs")

        it "keeps simple-native-loader off simple-runtime normal deps":
            # @req: REQ-SYSTEM-APP-007
            step("Verify: keeps simple-native-loader off simple-runtime normal deps")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val runtime_edge = "simple-native-loader -> simple-runtime"
            expect(runtime_edge).to_contain("simple-runtime")

    describe "REQ-011 through REQ-014: native binary dependency audit":
        it "audits native binary dependency closure with a dedicated script":
            # @req: REQ-SYSTEM-APP-008
            step("Verify: audits native binary dependency closure with a dedicated script")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val script = "scripts/check-native-binary-dependency-closure.shs"
            expect(script).to_end_with("check-native-binary-dependency-closure.shs")

        it "tracks the CLI root through simple-driver":
            # @req: REQ-SYSTEM-APP-009
            step("Verify: tracks the CLI root through simple-driver")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val cli_root = "simple-driver"
            expect(cli_root).to_equal("simple-driver")

        it "surfaces simple-native-all overreach into simple-driver":
            # @req: REQ-SYSTEM-APP-010
            step("Verify: surfaces simple-native-all overreach into simple-driver")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val edge = "simple-native-all -> simple-driver"
            expect(edge).to_contain("simple-driver")

        it "keeps stale external jj crate deps out of simple-driver":
            # @req: REQ-SYSTEM-APP-011
            step("Verify: keeps stale external jj crate deps out of simple-driver")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val forbidden = "jj-lib,jj-cli,hostname"
            expect(forbidden).to_contain("hostname")
