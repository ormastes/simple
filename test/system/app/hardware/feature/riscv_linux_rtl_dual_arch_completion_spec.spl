"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/hardware/feature/riscv_linux_rtl_dual_arch_completion_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec.*

use hardware.riscv_common.pkg.riscv_linux_pkg.{RiscvPlatformProfile}
use hardware.fpga_linux.riscv_fpga_linux.{create_default_riscv_fpga_linux_manifest}

describe "REQ-RLD-001..006":
    it "keeps dual-arch QEMU virt profiles public and deterministic":
        # @req: REQ-SYSTEM-APP-001 REQ-RLD-001..006
            # @req: REQ-SYSTEM-APP-002
            # @req: REQ-SYSTEM-APP-003
        step("Verify: keeps dual-arch QEMU virt profiles public and deterministic")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(RiscvPlatformProfile.qemu_virt_rv32().name).to_equal("qemu_virt_rv32")
        expect(RiscvPlatformProfile.qemu_virt_rv64().name).to_equal("qemu_virt_rv64")

    it "keeps the default FPGA manifest dual-arch":
        # @req: REQ-SYSTEM-APP-004
        step("Verify: keeps the default FPGA manifest dual-arch")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val manifest = create_default_riscv_fpga_linux_manifest()
        expect(manifest.lanes.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(manifest.readiness_summary()).to_contain("rv32:")
        expect(manifest.readiness_summary()).to_contain("rv64:")
