"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/tooling/feature/workspace_root_write_guard_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec.{describe, it, expect, step}
use std.io_runtime.{read_file, file_exists}

describe "Workspace root write guard":
    it "has a host guard script":
        # @req: REQ-SYSTEM-APP-001
        step("Verify: has a host guard script")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(file_exists("scripts/check-workspace-root-guard.shs")).to_equal(true)

    it "uses FILE.md as policy source":
        # @req: REQ-SYSTEM-APP-002
        step("Verify: uses FILE.md as policy source")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("scripts/check-workspace-root-guard.shs")
        expect(source.contains("FILE.md")).to_equal(true)
        expect(source.contains("load_allowed_root")).to_equal(true)

    it "defines root and immediate-child diagnostics":
        # @req: REQ-SYSTEM-APP-003
        step("Verify: defines root and immediate-child diagnostics")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("scripts/check-workspace-root-guard.shs")
        expect(source.contains("WRG001")).to_equal(true)
        expect(source.contains("WRG002")).to_equal(true)

    it "quarantines instead of deleting":
        # @req: REQ-SYSTEM-APP-004
        step("Verify: quarantines instead of deleting")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("scripts/check-workspace-root-guard.shs")
        expect(source.contains("build/workspace_quarantine")).to_equal(true)
        expect(source.contains("mv \"$rel\" \"$dest\"")).to_equal(true)

    it "has staged lint integration":
        # @req: REQ-SYSTEM-APP-005
        step("Verify: has staged lint integration")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cli_ops = read_file("src/app/io/cli_ops.spl")
        val cli_lint = read_file("src/app/io/cli_lint_commands.spl")
        # Post-self-hosting bin/simple is a native binary, not a shell wrapper; the
        # staged-audit invocation moved into the Simple CLI source (cli_ops runs
        # check-workspace-root-guard.shs with audit --staged). (#38 stale-assertion fix)
        expect(cli_ops.contains("check-workspace-root-guard.shs")).to_equal(true)
        expect(cli_ops.contains("--staged")).to_equal(true)
        expect(cli_ops.contains("_cli_run_workspace_root_guard")).to_equal(true)
        expect(cli_lint.contains("_cli_run_workspace_root_guard()")).to_equal(true)

    it "has tracked repo hygiene integration":
        # @req: REQ-SYSTEM-APP-006
        step("Verify: has tracked repo hygiene integration")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val hygiene = read_file("scripts/check/check-repo-hygiene.shs")
        expect(hygiene.contains("check-workspace-root-guard.shs audit --staged")).to_equal(true)

    it "has a pre-commit hook wrapper":
        # @req: REQ-SYSTEM-APP-007
        step("Verify: has a pre-commit hook wrapper")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val hook = read_file("scripts/hooks/pre-commit")
        expect(hook.contains("check-workspace-root-guard.shs audit --staged")).to_equal(true)
