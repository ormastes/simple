"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/simpleos/feature/simpleos_wine_process_load_bind_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use common.wine_hello_fixture.{wine_known_hello_exe_fixture_bytes}
use common.wine_process_session.{
    wine_process_load_and_bind_known_kernel32_imports,
    wine_process_session_plan,
    wine_process_session_request_new
}

use std.spec.{step}
fn _full_gates() -> text:
    "process=verified exec_env=verified vm=verified renderer=verified user32=verified " +
        "gdi32=verified kernel32_core=verified host=verified posix=verified registry=verified " +
        "pthread=verified dynload=verified audio=verified fonts=verified input=verified " +
        "pe_loader=verified async=verified nt_bridge=verified"

describe "SimpleOS Wine process load and bind":
    describe "REQ-022: load then bind known KERNEL32 imports":
        it "should resolve the first import module before accepting known import bindings":
            # @req: REQ-SYSTEM-APP-001
                # @req: REQ-022
            step("Verify: should resolve the first import module before accepting known import bindings")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val plan = wine_process_session_plan(wine_process_session_request_new("game.exe", [], "C:\\Games"), _full_gates())
            val result = wine_process_load_and_bind_known_kernel32_imports(plan, wine_known_hello_exe_fixture_bytes(), 8)
            expect(result.ok).to_equal(true)
            expect(result.dll_name).to_equal("kernel32.dll")
            expect(result.module_handle).to_equal(0x120)
            expect(result.call_sequence).to_equal("GetStdHandle WriteFile ExitProcess")
            expect(result.binding_count).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
            expect(result.status).to_equal("imports-loaded-bound")

        it "should reject load-and-bind before module resolution passes":
            # @req: REQ-SYSTEM-APP-002
            step("Verify: should reject load-and-bind before module resolution passes")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val plan = wine_process_session_plan(wine_process_session_request_new("game.exe", [], "C:\\Games"), _full_gates())
            val result = wine_process_load_and_bind_known_kernel32_imports(plan, wine_known_hello_exe_fixture_bytes(), 0)
            expect(result.ok).to_equal(false)
            expect(result.error).to_equal("invalid-symbol-limit")
            expect(result.status).to_equal("blocked")
