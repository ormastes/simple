"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/simpleos/feature/simpleos_proton_substrate_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use common.wine_proton_gate.{
    wine_proton_feature_gate,
    wine_proton_fixture_features,
    wine_proton_fixture_wine_gates,
    wine_proton_readiness_gate
}
use common.wine_proton_runtime.{
    wine_proton_fixture_runtime_evidence,
    wine_proton_runtime_gate,
    wine_proton_runtime_readiness_gate
}
use common.proton_runtime_subsystems.{
    proton_fixture_non_wine_runtime_evidence,
    proton_non_wine_feature_evidence,
    proton_non_wine_runtime_gate
}
use common.proton_session.{
    proton_session_launch_handoff,
    proton_session_launch_handoff_with_exec_env,
    proton_session_plan,
    proton_session_request_new
}
use common.wine_simpleos_exec_env_gate.{wine_simpleos_exec_env_fixture_evidence}
use std.spec.{step}

describe "SimpleOS Proton Substrate":
    describe "REQ-PROTON-001: full Wine dependency":
        it "should block Proton readiness until full Wine readiness is complete":
            # @req: REQ-SYSTEM-APP-001
                # @req: REQ-SYSTEM-APP-002
                # @req: REQ-SYSTEM-APP-003
            step("Verify: should block Proton readiness until full Wine readiness is complete")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val state = wine_proton_readiness_gate(
                "process=verified exec_env=verified vm=verified renderer=verified",
                wine_proton_fixture_features()
            )
            expect(state).to_equal("blocked-wine-blocked-missing-user32")

    describe "REQ-PROTON-002: Steam runtime and container":
        it "should require the Proton launcher, Steam runtime, and pressure-vessel style container evidence":
            # @req: REQ-SYSTEM-APP-004
            step("Verify: should require the Proton launcher, Steam runtime, and pressure-vessel style container evidence")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(wine_proton_feature_gate("")).to_equal("missing-steam-runtime")
            expect(wine_proton_feature_gate("steam-runtime")).to_equal("missing-pressure-vessel-container")
            expect(wine_proton_feature_gate("steam-runtime pressure-vessel-container")).to_equal("missing-proton-launcher")

    describe "REQ-PROTON-003: graphics translation":
        it "should require Vulkan, DXVK, and VKD3D-Proton evidence":
            # @req: REQ-SYSTEM-APP-005
            step("Verify: should require Vulkan, DXVK, and VKD3D-Proton evidence")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val features = "steam-runtime pressure-vessel-container proton-launcher wine-full"
            expect(wine_proton_feature_gate(features)).to_equal("missing-vulkan-loader")
            expect(wine_proton_feature_gate(features + " vulkan-loader vulkan-device")).to_equal("missing-dxvk")
            expect(wine_proton_feature_gate(features + " vulkan-loader vulkan-device dxvk")).to_equal("missing-vkd3d-proton")

    describe "REQ-PROTON-004: Steam/game runtime integration":
        it "should require Steamworks, controller input, shader cache, and sync primitive evidence":
            # @req: REQ-SYSTEM-APP-006
            step("Verify: should require Steamworks, controller input, shader cache, and sync primitive evidence")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val features = "steam-runtime pressure-vessel-container proton-launcher wine-full " +
                "vulkan-loader vulkan-device dxvk vkd3d-proton"
            expect(wine_proton_feature_gate(features)).to_equal("missing-steamworks-bridge")
            expect(wine_proton_feature_gate(features + " steamworks-bridge")).to_equal("missing-controller-input")
            expect(wine_proton_feature_gate(features + " steamworks-bridge controller-input")).to_equal("missing-shader-cache")
            expect(wine_proton_feature_gate(features + " steamworks-bridge controller-input shader-cache")).to_equal("missing-esync-or-fsync")

    describe "REQ-PROTON-005: readiness boundary":
        it "should mark Proton ready only when full Wine and all Proton features are present":
            # @req: REQ-SYSTEM-APP-007
            step("Verify: should mark Proton ready only when full Wine and all Proton features are present")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(wine_proton_readiness_gate(wine_proton_fixture_wine_gates(), wine_proton_fixture_features())).to_equal("ready")

    describe "REQ-PROTON-006: structured runtime evidence":
        it "should require structured Steam runtime, pressure-vessel, graphics, integration, and sync evidence":
            # @req: REQ-SYSTEM-APP-008
            step("Verify: should require structured Steam runtime, pressure-vessel, graphics, integration, and sync evidence")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(wine_proton_runtime_gate(wine_proton_fixture_runtime_evidence())).to_equal("ready")
            expect(wine_proton_runtime_readiness_gate(wine_proton_fixture_wine_gates(), wine_proton_fixture_runtime_evidence())).to_equal("ready")

    describe "REQ-PROTON-007: non-Wine Proton subsystem evidence":
        it "should complete every Proton prerequisite outside Wine itself":
            # @req: REQ-SYSTEM-APP-009
            step("Verify: should complete every Proton prerequisite outside Wine itself")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val evidence = proton_fixture_non_wine_runtime_evidence()
            expect(proton_non_wine_runtime_gate(evidence)).to_equal("ready")
            expect(proton_non_wine_feature_evidence(evidence)).to_contain("steam-runtime")
            expect(proton_non_wine_feature_evidence(evidence)).to_contain("pressure-vessel-container")
            expect(proton_non_wine_feature_evidence(evidence)).to_contain("dxvk")
            expect(proton_non_wine_feature_evidence(evidence)).to_contain("vkd3d-proton")
            expect(proton_non_wine_feature_evidence(evidence)).to_contain("steamworks-bridge")
            expect(proton_non_wine_feature_evidence(evidence)).to_contain("esync-or-fsync")

    describe "REQ-PROTON-008: non-Wine launch session planning":
        it "should plan a Proton session after non-Wine subsystem evidence is complete":
            # @req: REQ-SYSTEM-APP-010
            step("Verify: should plan a Proton session after non-Wine subsystem evidence is complete")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val request = proton_session_request_new("480", "steamapps/compatdata/480/pfx", "hl2.exe", ["-novid"])
            val plan = proton_session_plan(request, proton_fixture_non_wine_runtime_evidence())
            expect(plan.ok).to_equal(true)
            expect(plan.status).to_equal("planned")
            expect(plan.launch_command).to_equal("hl2.exe -novid")
            expect(plan.runtime_features).to_contain("pressure-vessel-container")
            expect(plan.runtime_features).to_contain("vkd3d-proton")

    describe "REQ-PROTON-009: non-executing launch handoff":
        it "should emit a dry-run handoff and keep real execution blocked":
            # @req: REQ-SYSTEM-APP-011
            step("Verify: should emit a dry-run handoff and keep real execution blocked")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val request = proton_session_request_new("480", "steamapps/compatdata/480/pfx", "hl2.exe", ["-novid"])
            val plan = proton_session_plan(request, proton_fixture_non_wine_runtime_evidence())
            expect(proton_session_launch_handoff(plan, false).error).to_equal("execution-not-implemented")
            val handoff = proton_session_launch_handoff(plan, true)
            expect(handoff.status).to_equal("dry-run-ready")
            expect(handoff.container_profile).to_contain("pressure-vessel")
            expect(handoff.container_profile).to_contain("container-rootfs-nvfs")
            expect(handoff.container_profile).to_contain("namespace-capability")
            expect(handoff.runtime_features).to_contain("dxvk")

        it "should require SimpleOS MDSOC executable-environment evidence before Proton dry-run handoff":
            # @req: REQ-SYSTEM-APP-012
            step("Verify: should require SimpleOS MDSOC executable-environment evidence before Proton dry-run handoff")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val request = proton_session_request_new("480", "steamapps/compatdata/480/pfx", "hl2.exe", ["-novid"])
            val plan = proton_session_plan(request, proton_fixture_non_wine_runtime_evidence())
            val blocked = proton_session_launch_handoff_with_exec_env(plan, true, "simpleos-qemu-vm")
            expect(blocked.error).to_equal("exec-env:missing-simpleos-full-os-boot")
            val handoff = proton_session_launch_handoff_with_exec_env(plan, true, wine_simpleos_exec_env_fixture_evidence())
            expect(handoff.status).to_equal("dry-run-ready")
