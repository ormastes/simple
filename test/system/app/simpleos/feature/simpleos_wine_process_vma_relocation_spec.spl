"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/simpleos/feature/simpleos_wine_process_vma_relocation_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use common.pe_coff_header.{pe_rva_to_file_offset}
use common.wine_hello_fixture.{wine_known_hello_exe_fixture_bytes}
use common.wine_peb_teb.{wine_peb_teb_apply_layout_byte_writes, wine_peb_teb_init_default, wine_peb_teb_layout_byte_writes, wine_peb_teb_layout_write_plan, wine_peb_teb_memory_write_gate}
use common.wine_process_session.{
    wine_process_apply_loader_relocations_in_vma,
    wine_process_apply_loader_relocations_in_vma_with_peb_teb_vm_writes,
    wine_process_session_plan,
    wine_process_session_request_new
}
use common.wine_vm_adapter.{WineVmSpace, wine_vm_commit, wine_vm_process_space_new, wine_vm_reserve_fixed}
use std.spec.{step}

fn _put_u16_le(data: [u8], offset: i64, value: i64) -> [u8]:
    data[offset] = (value & 0xff) as u8
    data[offset + 1] = ((value >> 8) & 0xff) as u8
    data

fn _put_u32_le(data: [u8], offset: i64, value: i64) -> [u8]:
    data[offset] = (value & 0xff) as u8
    data[offset + 1] = ((value >> 8) & 0xff) as u8
    data[offset + 2] = ((value >> 16) & 0xff) as u8
    data[offset + 3] = ((value >> 24) & 0xff) as u8
    data

fn _put_u64_le(data: [u8], offset: i64, value: i64) -> [u8]:
    var remaining = value
    var i = 0
    while i < 8:
        data[offset + i] = remaining % 256
        remaining = remaining / 256
        i = i + 1
    data

fn _read_u64_le(data: [u8], offset: i64) -> i64:
    var value = 0
    var shift = 0
    var i = 0
    while i < 8:
        value = value | ((data[offset + i] as i64) << shift)
        shift = shift + 8
        i = i + 1
    value

fn _commit_fixed(space: WineVmSpace, base: i64, size: i64, perms: text) -> WineVmSpace:
    val reserved = wine_vm_reserve_fixed(space, base, size)
    if not reserved.ok:
        return reserved.space
    val committed = wine_vm_commit(reserved.space, reserved.region.base, perms)
    committed.space

fn _startup_write_space() -> WineVmSpace:
    var space = wine_vm_process_space_new(10, 30, "pid fs ipc net capability")
    space = _commit_fixed(space, 0x7ffdc000, 0x1000, "rw")
    space = _commit_fixed(space, 0x7ffdd000, 0x1000, "rw")
    space = _commit_fixed(space, 0x7ffde000, 0x1000, "rw")
    _commit_fixed(space, 0x7ffdf000, 0x1000, "rw")

fn _full_gates() -> text:
    "process=verified exec_env=verified vm=verified renderer=verified user32=verified " +
        "gdi32=verified kernel32_core=verified host=verified posix=verified registry=verified " +
        "pthread=verified dynload=verified audio=verified fonts=verified input=verified " +
        "pe_loader=verified async=verified nt_bridge=verified"

fn _known_hello_with_dir64_relocation() -> [u8]:
    var data = wine_known_hello_exe_fixture_bytes()
    data = _put_u32_le(data, 0x98 + 0x70 + 44, 0x0c)
    data = _put_u32_le(data, 0x364, 0x0c)
    data = _put_u16_le(data, 0x368, 0xa018)
    data = _put_u64_le(data, pe_rva_to_file_offset(data, 0x2018), 0x402018)
    data

describe "SimpleOS Wine VMA relocation application":
    describe "REQ-036: loader-owned relocation mutation through process VMA":
        it "should apply a bounded relocation in the mapped process image without executing PE code":
            # @req: REQ-SYSTEM-APP-001
                # @req: REQ-036
            step("Verify: should apply a bounded relocation in the mapped process image without executing PE code")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val plan = wine_process_session_plan(wine_process_session_request_new("game.exe", [], "C:\\Games"), _full_gates())
            val data = _known_hello_with_dir64_relocation()
            val target_offset = pe_rva_to_file_offset(data, 0x2018)
            val result = wine_process_apply_loader_relocations_in_vma(plan, data, 0x400000, 0x500000, "native-module-open tls-callback")
            expect(result.ok).to_equal(true)
            expect(result.relocation_count).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            expect(result.target_rva).to_equal(0x2018)
            expect(_read_u64_le(result.patched_image, target_offset)).to_equal(0x502018)
            expect(result.evidence).to_contain("loader-relocations-vma-applied")
            expect(result.evidence).to_contain("process-vma-rx-restored")
            expect(result.evidence).to_contain("no-arbitrary-execution")
            expect(result.status).to_equal("loader-relocations-vma-applied")

        it "should require PEB/TEB VM byte-write readback before loader relocation mutation":
            # @req: REQ-SYSTEM-APP-002
            step("Verify: should require PEB/TEB VM byte-write readback before loader relocation mutation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val plan = wine_process_session_plan(wine_process_session_request_new("game.exe", [], "C:\\Games"), _full_gates())
            val data = _known_hello_with_dir64_relocation()
            val target_offset = pe_rva_to_file_offset(data, 0x2018)
            val init = wine_peb_teb_init_default()
            val writes = wine_peb_teb_memory_write_gate(init, _startup_write_space())
            val layout = wine_peb_teb_layout_write_plan(init, writes)
            val bytes = wine_peb_teb_layout_byte_writes(layout)
            val vm_writes = wine_peb_teb_apply_layout_byte_writes(_startup_write_space(), bytes)
            val result = wine_process_apply_loader_relocations_in_vma_with_peb_teb_vm_writes(plan, data, 0x400000, 0x500000, "native-module-open tls-callback", vm_writes)

            expect(result.ok).to_equal(true)
            expect(result.status).to_equal("loader-relocations-vma-applied")
            expect(_read_u64_le(result.patched_image, target_offset)).to_equal(0x502018)
            expect(result.evidence).to_contain("peb-teb-vm-writes-ready")
            expect(result.evidence).to_contain("VMWriteReadback:PEBTEBLayoutBytes")
            expect(result.evidence).to_contain("no-arbitrary-execution")
