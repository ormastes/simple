"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/simpleos/feature/tmux_simpleos_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# codex-system-test
# Design-level system spec for the native tmux_simpleos feature.

use std.spec
use os.apps.smux.contract.{
    MuxBackendKind
}
use os.apps.smux.api.{
    smux_reset_for_test,
    smux_is_deferred_feature,
    smux_metrics,
    smux_create_session,
    smux_attach,
    smux_detach,
    smux_new_window,
    smux_split_pane,
    smux_focus_pane,
    smux_resize,
    smux_send_text,
    smux_send_command,
    smux_capture,
    smux_list_sessions,
    smux_list_windows,
    smux_list_panes,
    smux_backend_contract_name
}

describe "tmux_simpleos feature spec":
    describe "REQ-001 session model":
        it "should create a persistent session with an initial window and pane":
            # @req: REQ-SYSTEM-APP-001
                # @req: REQ-001
            step("Verify: should create a persistent session with an initial window and pane")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            smux_reset_for_test()
            val session = smux_create_session("dev")
            expect(session.name).to_equal("dev")

            val windows = smux_list_windows(session.id)
            expect(windows.len()).to_be_greater_than(0)

            val panes = smux_list_panes(session.id, windows[0].id)
            expect(panes.len()).to_be_greater_than(0)

    describe "REQ-002 pane-backed shells":
        it "should start panes on the native backend":
            # @req: REQ-SYSTEM-APP-002
            step("Verify: should start panes on the native backend")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            smux_reset_for_test()
            val session = smux_create_session("shells")
            val windows = smux_list_windows(session.id)
            val panes = smux_list_panes(session.id, windows[0].id)

            expect(panes[0].backend_kind).to_equal(MuxBackendKind.NativeShell)
            expect(panes[0].state).to_equal("running")

    describe "REQ-003 attach and detach":
        it "should detach a client without destroying the session":
            # @req: REQ-SYSTEM-APP-003
            step("Verify: should detach a client without destroying the session")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            smux_reset_for_test()
            val session = smux_create_session("attach")
            expect(smux_attach(session.id, "client-a", 120, 40).attached).to_equal(true)
            expect(smux_detach("client-a")).to_equal(true)

            val sessions = smux_list_sessions()
            expect(sessions[0].name).to_equal("attach")

    describe "REQ-004 split and layout":
        it "should split the active pane and create a second pane":
            # @req: REQ-SYSTEM-APP-004
            step("Verify: should split the active pane and create a second pane")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            smux_reset_for_test()
            val session = smux_create_session("split")
            val window = smux_list_windows(session.id)[0]
            val first = smux_list_panes(session.id, window.id)[0]

            expect(smux_split_pane(session.id, window.id, first.id, "horizontal").is_ok()).to_equal(true)

            val panes = smux_list_panes(session.id, window.id)
            expect(panes.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    describe "REQ-005 input and output routing":
        it "should route sent text and commands to the selected pane":
            # @req: REQ-SYSTEM-APP-005
            step("Verify: should route sent text and commands to the selected pane")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            smux_reset_for_test()
            val session = smux_create_session("io")
            val window = smux_list_windows(session.id)[0]
            val pane = smux_list_panes(session.id, window.id)[0]

            expect(smux_focus_pane(session.id, window.id, pane.id)).to_equal(true)
            expect(smux_send_text(session.id, window.id, pane.id, "echo hi")).to_equal(true)
            expect(smux_send_command(session.id, window.id, pane.id, "pwd")).to_equal(true)

            val metrics = smux_metrics()
            expect(metrics.send_text_count).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            expect(metrics.send_command_count).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    describe "REQ-006 state query API":
        it "should list sessions windows and panes with stable metadata":
            # @req: REQ-SYSTEM-APP-006
            step("Verify: should list sessions windows and panes with stable metadata")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            smux_reset_for_test()
            val session = smux_create_session("query")
            val sessions = smux_list_sessions()
            expect(sessions[0].name).to_equal("query")

            val windows = smux_list_windows(session.id)
            expect(windows[0].session_id).to_equal(session.id)

            val panes = smux_list_panes(session.id, windows[0].id)
            expect(panes[0].window_id).to_equal(windows[0].id)

    describe "REQ-007 capture api":
        it "should capture pane output and preserve pane identity":
            # @req: REQ-SYSTEM-APP-007
            step("Verify: should capture pane output and preserve pane identity")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            smux_reset_for_test()
            val session = smux_create_session("capture")
            val window = smux_list_windows(session.id)[0]
            val pane = smux_list_panes(session.id, window.id)[0]

            val capture = smux_capture(session.id, window.id, pane.id, 50)
            expect(capture.pane_id).to_equal(pane.id)
            expect(capture.rows).to_be_greater_than(0)

    describe "REQ-008 compatibility facing api shape":
        it "should expose tmux-shaped session window pane operations over the native backend":
            # @req: REQ-SYSTEM-APP-008
            step("Verify: should expose tmux-shaped session window pane operations over the native backend")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            smux_reset_for_test()
            val session = smux_create_session("compat")
            val window = smux_new_window(session.id, "build")
            expect(window.name).to_equal("build")

            val panes = smux_list_panes(session.id, window.id)
            expect(panes.len()).to_be_greater_than(0)

    describe "REQ-009 native first backend":
        it "should identify the backend as native rather than host tmux":
            # @req: REQ-SYSTEM-APP-009
            step("Verify: should identify the backend as native rather than host tmux")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            smux_reset_for_test()
            expect(smux_backend_contract_name()).to_equal("smux-native")

    describe "REQ-010 backend swap readiness":
        it "should keep backend identity behind a named contract boundary":
            # @req: REQ-SYSTEM-APP-010
            step("Verify: should keep backend identity behind a named contract boundary")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            smux_reset_for_test()
            expect(smux_backend_contract_name()).to_start_with("smux-")

    describe "REQ-011 explicit non fatal failure handling":
        it "should return an error for an invalid pane target":
            # @req: REQ-SYSTEM-APP-011
            step("Verify: should return an error for an invalid pane target")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            smux_reset_for_test()
            val session = smux_create_session("errors")
            val window = smux_list_windows(session.id)[0]

            val result = smux_resize(session.id, window.id, "missing-pane", 80, 24)
            expect(result.is_err()).to_equal(true)
            expect(result.err().unwrap()).to_contain("pane")

        it "should return an error when split target is invalid":
            # @req: REQ-SYSTEM-APP-012
            step("Verify: should return an error when split target is invalid")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            smux_reset_for_test()
            val session = smux_create_session("split-errors")
            val window = smux_list_windows(session.id)[0]
            val result = smux_split_pane(session.id, window.id, "missing-pane", "vertical")
            expect(result.is_err()).to_equal(true)

    describe "REQ-012 initial scope boundary":
        it "should expose deferred parity features explicitly":
            # @req: REQ-SYSTEM-APP-013
            step("Verify: should expose deferred parity features explicitly")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            smux_reset_for_test()
            expect(smux_is_deferred_feature("copy-mode")).to_equal(true)
            expect(smux_is_deferred_feature("mouse")).to_equal(true)
            expect(smux_is_deferred_feature("key-table-compat")).to_equal(true)
            expect(smux_is_deferred_feature("tmux-conf")).to_equal(true)
            expect(smux_is_deferred_feature("control-mode")).to_equal(true)
            expect(smux_is_deferred_feature("split-pane")).to_equal(false)

    describe "NFR-007 observability":
        it "should expose observable startup and operation counters":
            # @req: REQ-SYSTEM-APP-014
            step("Verify: should expose observable startup and operation counters")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            smux_reset_for_test()
            val session = smux_create_session("obs")
            val window = smux_list_windows(session.id)[0]
            val pane = smux_list_panes(session.id, window.id)[0]

            expect(smux_resize(session.id, window.id, pane.id, 90, 25).is_ok()).to_equal(true)
            val _capture = smux_capture(session.id, window.id, pane.id, 10)
            val metrics = smux_metrics()

            expect(metrics.startup_count).to_be_greater_than(0)
            expect(metrics.last_startup_ns).to_be_greater_than(0u64)
            expect(metrics.resize_count).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            expect(metrics.capture_count).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
