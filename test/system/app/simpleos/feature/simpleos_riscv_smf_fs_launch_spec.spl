"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/simpleos/feature/simpleos_riscv_smf_fs_launch_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec
use os.qemu_runner.{
    get_scenario,
    scenario_riscv64_virtio_fat32_smf,
    scenario_riscv32_virtio_fat32_smf,
    scenario_target,
    scenario_test_timeout_ms,
}
use os.kernel.arch.arch_context.{Architecture}

describe "SimpleOS RISC-V SMF filesystem launch":
    describe "REQ-RISCV-SMF-005: QEMU scenarios":
        it "registers the RV64 filesystem SMF scenario":
            # @req: REQ-SYSTEM-APP-001 REQ-RISCV-SMF-005
                # @req: REQ-SYSTEM-APP-002
                # @req: REQ-SYSTEM-APP-003
            step("Verify: registers the RV64 filesystem SMF scenario")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val scenario = scenario_riscv64_virtio_fat32_smf()
            expect(scenario.name).to_equal("riscv64-virtio-fat32-smf")
            expect(scenario.arch).to_equal(Architecture.Riscv64)
            expect(scenario.qemu_extra).to_contain("virtio-blk-device,drive=rvdisk")
            expect(scenario_test_timeout_ms(scenario)).to_equal(60000)  # oracle: expected value 60000 is the behavior asserted by this regression spec

        it "registers the RV32 filesystem SMF scenario":
            # @req: REQ-SYSTEM-APP-004
            step("Verify: registers the RV32 filesystem SMF scenario")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val scenario = scenario_riscv32_virtio_fat32_smf()
            expect(scenario.name).to_equal("riscv32-virtio-fat32-smf")
            expect(scenario.arch).to_equal(Architecture.Riscv32)
            expect(scenario.qemu_extra).to_contain("virtio-blk-device,drive=rvdisk")
            expect(scenario_test_timeout_ms(scenario)).to_equal(60000)  # oracle: expected value 60000 is the behavior asserted by this regression spec

        it "resolves scenarios by name":
            # @req: REQ-SYSTEM-APP-005
            step("Verify: resolves scenarios by name")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(get_scenario("riscv64-virtio-fat32-smf").unwrap().name).to_equal("riscv64-virtio-fat32-smf")
            expect(get_scenario("riscv32-virtio-fat32-smf").unwrap().name).to_equal("riscv32-virtio-fat32-smf")

        it "binds scenarios to RISC-V smoke entries":
            # @req: REQ-SYSTEM-APP-006
            step("Verify: binds scenarios to RISC-V smoke entries")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(scenario_target(scenario_riscv64_virtio_fat32_smf()).entry).to_equal("examples/09_embedded/simple_os/arch/riscv64/smoke_entry.spl")
            expect(scenario_target(scenario_riscv32_virtio_fat32_smf()).entry).to_equal("examples/09_embedded/simple_os/arch/riscv32/smoke_entry.spl")

