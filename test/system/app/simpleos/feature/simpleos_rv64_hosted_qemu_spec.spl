"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/simpleos/feature/simpleos_rv64_hosted_qemu_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec
use os.qemu_runner.{
    get_scenario,
    scenario_riscv64_hosted,
    scenario_target,
    scenario_test_timeout_ms,
    build_scenario_command,
}
use os.kernel.arch.arch_context.{Architecture}

describe "SimpleOS RV64 hosted QEMU":
    describe "REQ-RV64-HOSTED-001/002: scenario shape":
        it "registers the hosted RV64 scenario with disk and forwarded network":
            # @req: REQ-SYSTEM-APP-001 REQ-RV64-HOSTED-001/002
                # @req: REQ-SYSTEM-APP-002
                # @req: REQ-SYSTEM-APP-003
            step("Verify: registers the hosted RV64 scenario with disk and forwarded network")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val scenario = scenario_riscv64_hosted()
            expect(scenario.name).to_equal("riscv64-hosted")
            expect(scenario.arch).to_equal(Architecture.Riscv64)
            expect(scenario.qemu_extra).to_contain("virtio-blk-device,drive=rvdisk")
            expect(scenario.qemu_extra).to_contain("user,id=n0,hostfwd=tcp::2222-:22,hostfwd=tcp::8080-:80")
            expect(scenario.qemu_extra).to_contain("virtio-net-pci,netdev=n0,disable-legacy=on")
            expect(scenario_test_timeout_ms(scenario)).to_equal(120000)  # oracle: expected value 120000 is the behavior asserted by this regression spec

        it "resolves the scenario and target by name":
            # @req: REQ-SYSTEM-APP-004
            step("Verify: resolves the scenario and target by name")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            if val resolved = get_scenario("riscv64-hosted"):
                expect(resolved.name).to_equal("riscv64-hosted")
            else:
                expect("missing").to_equal("riscv64-hosted")
            val target = scenario_target(scenario_riscv64_hosted())
            expect(target.entry).to_equal("examples/09_embedded/simple_os/arch/riscv64/hosted_entry.spl")
            expect(target.output).to_equal("build/os/simpleos_riscv64_hosted.elf")

        it "builds a QEMU command with host-forwarded SSH and HTTP":
            # @req: REQ-SYSTEM-APP-005
            step("Verify: builds a QEMU command with host-forwarded SSH and HTTP")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val cmd = build_scenario_command(scenario_riscv64_hosted(), "build/os/simpleos_riscv64_hosted.elf")
            expect(cmd[0]).to_equal("qemu-system-riscv64")
            expect(cmd).to_contain("user,id=n0,hostfwd=tcp::2222-:22,hostfwd=tcp::8080-:80")
            expect(cmd).to_contain("virtio-net-pci,netdev=n0,disable-legacy=on")
