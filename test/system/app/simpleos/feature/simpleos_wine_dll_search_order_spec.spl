"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/simpleos/feature/simpleos_wine_dll_search_order_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use common.wine_kernel32_module_loader.{wine_kernel32_plan_dll_search_order}
use std.spec.{step}

describe "SimpleOS Wine DLL search order":
    describe "REQ-041: modeled DLL search order without host DLL execution":
        it "should plan KnownDlls-first DLL candidates without loading host files":
            # @req: REQ-SYSTEM-APP-001
                # @req: REQ-041
            step("Verify: should plan KnownDlls-first DLL candidates without loading host files")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = wine_kernel32_plan_dll_search_order(
                "kernel32.dll",
                "C:\\Games",
                "C:\\Users\\Player",
                ["D:\\GameBin"],
                ["kernel32.dll", "ntdll.dll"]
            )

            expect(result.ok).to_equal(true)
            expect(result.dll_name).to_equal("kernel32.dll")
            expect(result.search_roots[0]).to_equal("\\KnownDlls")
            expect(result.search_roots[1]).to_equal("C:\\Games")
            expect(result.search_roots[6]).to_equal("D:\\GameBin")
            expect(result.candidate_paths[0]).to_equal("\\KnownDlls\\kernel32.dll")
            expect(result.selected_path).to_equal("\\KnownDlls\\kernel32.dll")
            expect(result.evidence).to_contain("dll-search-order-modeled")
            expect(result.evidence).to_contain("knowndlls-first")
            expect(result.evidence).to_contain("application-directory")
            expect(result.evidence).to_contain("no-host-filesystem-access")
            expect(result.evidence).to_contain("no-real-dll-loaded")
            expect(result.evidence).to_contain("no-dll-entrypoint-executed")
            expect(result.status).to_equal("dll-search-order-modeled")
