"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/simpleos/feature/simpleos_wine_dll_load_session_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use common.wine_dll_load_session.{
    wine_dll_load_session_loaded_count,
    wine_dll_load_session_new,
    wine_dll_session_load_with_rollback
}

use std.spec.{step}
describe "REQ-043 SimpleOS Wine modeled DLL load session":
    it "records load state and rollback evidence without executing DLL code":
        # @req: REQ-SYSTEM-APP-001
            # @req: REQ-043
        step("Verify: records load state and rollback evidence without executing DLL code")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val session = wine_dll_load_session_new(0x75000000)
        val committed = wine_dll_session_load_with_rollback(session, "kernel32.dll", "C:\\Games", "C:\\Users\\Player", ["D:\\GameBin"], ["kernel32.dll"], 0x6000, true)
        expect(committed.ok).to_equal(true)
        expect(committed.status).to_equal("dll-load-session-recorded")
        expect(wine_dll_load_session_loaded_count(committed.session)).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(committed.evidence).to_contain("dll-image-map-handoff-ready")
        expect(committed.evidence).to_contain("modeled-loaded-image")
        expect(committed.evidence).to_contain("no-real-dll-loaded")
        expect(committed.evidence).to_contain("no-dll-entrypoint-executed")
        expect(committed.evidence).to_contain("no-tls-callback-executed")

        val rolled = wine_dll_session_load_with_rollback(committed.session, "user32.dll", "C:\\Games", "C:\\Users\\Player", [], ["kernel32.dll"], 0x7000, false)
        expect(rolled.ok).to_equal(false)
        expect(rolled.status).to_equal("rolled-back")
        expect(wine_dll_load_session_loaded_count(rolled.session)).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(rolled.evidence).to_contain("dll-load-session-rolled-back")
        expect(rolled.evidence).to_contain("no-arbitrary-execution")
