"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/simpleos/feature/simpleos_wine_dll_image_map_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use common.wine_dll_image_loader.{wine_dll_prepare_image_map_handoff}
use std.spec.{step}

describe "SimpleOS Wine DLL image map handoff":
    describe "REQ-042: modeled DLL image map handoff without DLL execution":
        it "should map and unmap a searched DLL image through SimpleOS VM evidence":
            # @req: REQ-SYSTEM-APP-001
                # @req: REQ-042
            step("Verify: should map and unmap a searched DLL image through SimpleOS VM evidence")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = wine_dll_prepare_image_map_handoff(
                "kernel32.dll",
                "C:\\Games",
                "C:\\Users\\Player",
                ["D:\\GameBin"],
                ["kernel32.dll", "ntdll.dll"],
                0x5000,
                0x70000000
            )

            expect(result.ok).to_equal(true)
            expect(result.selected_path).to_equal("\\KnownDlls\\kernel32.dll")
            expect(result.mapped_base).to_equal(0x70000000)
            expect(result.mapped_size).to_equal(0x5000)
            expect(result.evidence).to_contain("dll-search-order-modeled")
            expect(result.evidence).to_contain("NtCreateSection NtMapViewOfSection NtUnmapViewOfSection")
            expect(result.evidence).to_contain("os-vma")
            expect(result.evidence).to_contain("dll-section-created")
            expect(result.evidence).to_contain("dll-view-mapped")
            expect(result.evidence).to_contain("dll-view-unmapped")
            expect(result.evidence).to_contain("no-host-filesystem-access")
            expect(result.evidence).to_contain("no-real-dll-loaded")
            expect(result.evidence).to_contain("no-dll-entrypoint-executed")
            expect(result.evidence).to_contain("no-tls-callback-executed")
            expect(result.status).to_equal("dll-image-map-handoff-ready")
