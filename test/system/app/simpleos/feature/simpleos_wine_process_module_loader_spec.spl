"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/simpleos/feature/simpleos_wine_process_module_loader_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use common.wine_process_session.{
    wine_process_resolve_known_kernel32_module,
    wine_process_resolve_known_kernel32_module_ex,
    wine_process_session_plan,
    wine_process_session_request_new
}

use std.spec.{step}
fn _full_gates() -> text:
    "process=verified exec_env=verified vm=verified renderer=verified user32=verified " +
        "gdi32=verified kernel32_core=verified host=verified posix=verified registry=verified " +
        "pthread=verified dynload=verified audio=verified fonts=verified input=verified " +
        "pe_loader=verified async=verified nt_bridge=verified"

fn _hello_gates() -> text:
    "process=verified exec_env=verified vm=verified host=verified posix=verified " +
        "pthread=verified dynload=verified pe_loader=verified async=verified nt_bridge=verified"

describe "SimpleOS Wine process module loader":
    describe "REQ-020: bounded process module resolution":
        it "should resolve a known KERNEL32 module procedure for a full-Wine process plan":
            # @req: REQ-SYSTEM-APP-001
                # @req: REQ-020
            step("Verify: should resolve a known KERNEL32 module procedure for a full-Wine process plan")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val plan = wine_process_session_plan(wine_process_session_request_new("game.exe", [], "C:\\Games"), _full_gates())
            val resolution = wine_process_resolve_known_kernel32_module(plan, "kernel32.dll", "GetProcAddress")
            expect(resolution.ok).to_equal(true)
            expect(resolution.handle).to_equal(0x120)
            expect(resolution.proc_address).to_equal(0x120000 + 3)
            expect(resolution.operations).to_equal("GetModuleHandleW LoadLibraryW GetProcAddress FreeLibrary")
            expect(resolution.status).to_equal("module-resolved")

        it "should resolve a known KERNEL32 module procedure through LoadLibraryExW":
            # @req: REQ-SYSTEM-APP-002
            step("Verify: should resolve a known KERNEL32 module procedure through LoadLibraryExW")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val plan = wine_process_session_plan(wine_process_session_request_new("game.exe", [], "C:\\Games"), _full_gates())
            val resolution = wine_process_resolve_known_kernel32_module_ex(plan, "kernel32.dll", "GetProcAddress", 0)
            expect(resolution.ok).to_equal(true)
            expect(resolution.handle).to_equal(0x120)
            expect(resolution.proc_address).to_equal(0x120000 + 3)
            expect(resolution.operations).to_equal("GetModuleHandleW LoadLibraryExW GetProcAddress FreeLibrary")
            expect(resolution.status).to_equal("module-resolved")

        it "should block module resolution outside the full-Wine process-session gate":
            # @req: REQ-SYSTEM-APP-003
            step("Verify: should block module resolution outside the full-Wine process-session gate")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val plan = wine_process_session_plan(wine_process_session_request_new("hello.exe", [], "C:\\Games"), _hello_gates())
            val resolution = wine_process_resolve_known_kernel32_module(plan, "kernel32.dll", "GetProcAddress")
            expect(resolution.ok).to_equal(false)
            expect(resolution.error).to_equal("unsupported-process-session")
            expect(resolution.status).to_equal("blocked")

        it "should reject unsupported LoadLibraryExW flags":
            # @req: REQ-SYSTEM-APP-004
            step("Verify: should reject unsupported LoadLibraryExW flags")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val plan = wine_process_session_plan(wine_process_session_request_new("game.exe", [], "C:\\Games"), _full_gates())
            val resolution = wine_process_resolve_known_kernel32_module_ex(plan, "kernel32.dll", "GetProcAddress", 8)
            expect(resolution.ok).to_equal(false)
            expect(resolution.error).to_equal("LoadLibraryExW:unsupported-load-flags")
            expect(resolution.status).to_equal("rejected")
