"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/simpleos/feature/simpleos_wine_seh_frame_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use common.wine_seh_frame.{wine_seh_dispatch_fault, wine_seh_frame_new}
use common.wine_vm_adapter.{WineVmFault}
use std.spec.{step}

describe "REQ-046: modeled SEH frame-chain dispatch":
    it "requires a mapped handler frame before SEH dispatch is planned":
        # @req: REQ-SYSTEM-APP-001
            # @req: REQ-046
        step("Verify: requires a mapped handler frame before SEH dispatch is planned")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val fault = WineVmFault(process_id: 77, thread_id: 12, address: 0x402000, access: "execute", policy: "deliver-seh")
        val frame = wine_seh_frame_new(77, 12, 0x701000, 0x403000, 0x700000, 0x710000)
        val result = wine_seh_dispatch_fault(fault, [frame], 0x400000, 0x5000)
        expect(result.ok).to_equal(true)
        expect(result.status).to_equal("seh-dispatch-planned")
        expect(result.evidence).to_contain("seh-frame-chain-present")
        expect(result.evidence).to_contain("seh-handler-mapped")
        expect(result.evidence).to_contain("no-seh-handler-executed")
