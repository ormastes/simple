"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/simpleos/feature/simpleos_wine_dll_entrypoint_lifecycle_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use common.wine_dll_entrypoint_lifecycle.{wine_dll_entrypoint_lifecycle_gate}
use common.wine_dll_load_session.{wine_dll_load_session_new, wine_dll_session_load_modeled}
use std.spec.{step}

describe "REQ-044 SimpleOS Wine DLL entrypoint lifecycle gate":
    it "requires loaded-image evidence and keeps DllMain/TLS execution blocked":
        # @req: REQ-SYSTEM-APP-001
            # @req: REQ-044
        step("Verify: requires loaded-image evidence and keeps DllMain/TLS execution blocked")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val session = wine_dll_load_session_new(0x78000000)
        val loaded = wine_dll_session_load_modeled(session, "kernel32.dll", "C:\\Games", "C:\\Users\\Player", [], ["kernel32.dll"], 0x6000)
        val result = wine_dll_entrypoint_lifecycle_gate(loaded.dll_name, loaded.status, loaded.evidence, 0x1200, 1, false)
        expect(result.ok).to_equal(true)
        expect(result.status).to_equal("dll-entrypoint-lifecycle-modeled")
        expect(result.evidence).to_contain("modeled-loaded-image")
        expect(result.evidence).to_contain("loader-lock-acquired")
        expect(result.evidence).to_contain("tls-callbacks-planned")
        expect(result.evidence).to_contain("DllMain-process-attach-planned")
        expect(result.evidence).to_contain("dll-entrypoint-execution-blocked")
        expect(result.evidence).to_contain("tls-callback-execution-blocked")

        val blocked = wine_dll_entrypoint_lifecycle_gate(loaded.dll_name, loaded.status, loaded.evidence, 0x1200, 1, true)
        expect(blocked.ok).to_equal(false)
        expect(blocked.error).to_equal("dll-entrypoint-execution-not-implemented")
