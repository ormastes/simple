"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/simpleos/feature/simpleos_wine_dll_file_bytes_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use common.wine_dll_file_bytes.{wine_dll_validate_file_bytes}
use std.spec.{step}

fn _zero_bytes(count: i64) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < count:
        out.push(0)
        i = i + 1
    out

fn _put_u16_le(data: [u8], offset: i64, value: i64) -> [u8]:
    data[offset] = (value & 0xff) as u8
    data[offset + 1] = ((value >> 8) & 0xff) as u8
    data

fn _put_u32_le(data: [u8], offset: i64, value: i64) -> [u8]:
    data[offset] = (value & 0xff) as u8
    data[offset + 1] = ((value >> 8) & 0xff) as u8
    data[offset + 2] = ((value >> 16) & 0xff) as u8
    data[offset + 3] = ((value >> 24) & 0xff) as u8
    data

fn _dll_bytes() -> [u8]:
    var data = _zero_bytes(1024)
    data[0] = 0x4d
    data[1] = 0x5a
    data = _put_u32_le(data, 0x3c, 0x80)
    data[0x80] = 0x50
    data[0x81] = 0x45
    data = _put_u16_le(data, 0x84, 0x8664)
    data = _put_u16_le(data, 0x86, 1)
    data = _put_u16_le(data, 0x94, 0xf0)
    data = _put_u16_le(data, 0x96, 0x2022)
    data = _put_u16_le(data, 0x98, 0x20b)
    data = _put_u32_le(data, 0x98 + 0x10, 0x1200)
    data = _put_u32_le(data, 0x98 + 0x38, 0x5000)
    data = _put_u32_le(data, 0x98 + 0x3c, 0x200)
    data

describe "REQ-045 SimpleOS Wine DLL file bytes":
    it "validates selected DLL path bytes without retaining or executing the DLL":
        # @req: REQ-SYSTEM-APP-001
            # @req: REQ-045
        step("Verify: validates selected DLL path bytes without retaining or executing the DLL")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = wine_dll_validate_file_bytes("kernel32.dll", "\\KnownDlls\\kernel32.dll", _dll_bytes())
        expect(result.ok).to_equal(true)
        expect(result.status).to_equal("dll-file-bytes-validated")
        expect(result.image_size).to_equal(0x5000)
        expect(result.entrypoint_rva).to_equal(0x1200)
        expect(result.evidence).to_contain("file-backed-dll-bytes")
        expect(result.evidence).to_contain("pe-dll-characteristic")
        expect(result.evidence).to_contain("no-persistent-dll-view")
        expect(result.evidence).to_contain("no-dll-entrypoint-executed")
        expect(result.evidence).to_contain("no-tls-callback-executed")
