# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use common.wine_ntdll_process_info.{wine_ntdll_execute_process_info_with_peb_teb, wine_ntdll_execute_process_info_with_peb_teb_layout, wine_ntdll_execute_process_info_with_peb_teb_vm_writes, wine_ntdll_execute_process_info_with_peb_teb_writes}
use common.wine_kernel32_critical_section.{wine_kernel32_critical_section_table_new}
use common.wine_peb_teb.{wine_peb_teb_apply_layout_byte_writes, wine_peb_teb_init_default, wine_peb_teb_init_gate, wine_peb_teb_init_with_loader_lock, wine_peb_teb_layout_byte_writes, wine_peb_teb_layout_write_plan, wine_peb_teb_memory_write_gate}
use common.wine_vm_adapter.{WineVmSpace, wine_vm_commit, wine_vm_process_space_new, wine_vm_reserve_fixed}
use std.spec.{step}

fn _classes() -> [text]:
    ["ProcessBasicInformation", "ProcessImageInformation", "ThreadBasicInformation"]

fn _loader_lock_symbols() -> [text]:
    ["InitializeCriticalSection", "EnterCriticalSection", "LeaveCriticalSection", "DeleteCriticalSection"]

fn _commit_fixed(space: WineVmSpace, base: i64, size: i64, perms: text) -> WineVmSpace:
    val reserved = wine_vm_reserve_fixed(space, base, size)
    if not reserved.ok:
        return reserved.space
    val committed = wine_vm_commit(reserved.space, reserved.region.base, perms)
    committed.space

fn _startup_write_space() -> WineVmSpace:
    var space = wine_vm_process_space_new(10, 30, "pid fs ipc net capability")
    space = _commit_fixed(space, 0x7ffdc000, 0x1000, "rw")
    space = _commit_fixed(space, 0x7ffdd000, 0x1000, "rw")
    space = _commit_fixed(space, 0x7ffde000, 0x1000, "rw")
    _commit_fixed(space, 0x7ffdf000, 0x1000, "rw")

describe "SimpleOS Wine PEB/TEB startup evidence":
    describe "REQ-018: bounded known-console process dispatch plan":
        it "validate PEB/TEB/TLS evidence before NTDLL process-info handoff":
            # @req REQ-018
            # @req REQ-SSPEC-SYSTEM
            step("validate PEB/TEB/TLS evidence before NTDLL process-info handoff")
            # evidence(protocol_json): asserted result fields below are the complete typed oracle
            val init = wine_peb_teb_init_gate(wine_peb_teb_init_default())
            expect(init.ok).to_equal(true)
            expect(init.operations).to_equal("PEB TEB TLS ProcessParameters")

            val result = wine_ntdll_execute_process_info_with_peb_teb(["NtQueryInformationProcess", "NtQueryInformationThread"], _classes(), wine_peb_teb_init_default())
            expect(result.ok).to_equal(true)
            expect(result.classes).to_equal("ProcessBasicInformation ProcessImageInformation ThreadBasicInformation")
            expect(result.peb_address).to_equal(0x7ffdf000)
            expect(result.teb_address).to_equal(0x7ffde000)

        it "require loader-lock sequencing around PEB/TEB startup evidence":
            # @req REQ-SSPEC-SYSTEM
            step("require loader-lock sequencing around PEB/TEB startup evidence")
            # evidence(protocol_json): asserted result fields below are the complete typed oracle
            val result = wine_peb_teb_init_with_loader_lock(wine_peb_teb_init_default(), _loader_lock_symbols(), wine_kernel32_critical_section_table_new())
            expect(result.ok).to_equal(true)
            expect(result.operations).to_equal("PEB TEB TLS ProcessParameters LoaderLock")

        it "require writable VM mappings before PEB/TEB startup mutation":
            # @req REQ-SSPEC-SYSTEM
            step("require writable VM mappings before PEB/TEB startup mutation")
            # evidence(protocol_json): asserted result fields below are the complete typed oracle
            val result = wine_peb_teb_memory_write_gate(wine_peb_teb_init_default(), _startup_write_space())
            expect(result.ok).to_equal(true)
            expect(result.state).to_equal("ready")
            expect(result.write_count).to_equal(4)  # oracle: result.write_count must equal 4 — authoritative contract constant
            expect(result.operations).to_contain("PEBWrite")
            expect(result.operations).to_contain("ProcessParametersWrite")

        it "compose PEB/TEB memory-write readiness before NTDLL process-info handoff":
            # @req REQ-SSPEC-SYSTEM
            step("compose PEB/TEB memory-write readiness before NTDLL process-info handoff")
            # evidence(protocol_json): asserted result fields below are the complete typed oracle
            val init = wine_peb_teb_init_default()
            val writes = wine_peb_teb_memory_write_gate(init, _startup_write_space())
            val result = wine_ntdll_execute_process_info_with_peb_teb_writes(["NtQueryInformationProcess", "NtQueryInformationThread"], _classes(), init, writes)
            expect(result.ok).to_equal(true)
            expect(result.operations).to_contain("PEBWrite")
            expect(result.operations).to_contain("NtQueryInformationProcess")
            expect(result.peb_address).to_equal(0x7ffdf000)

        it "plan concrete x64 PEB/TEB startup layout writes":
            # @req REQ-SSPEC-SYSTEM
            step("plan concrete x64 PEB/TEB startup layout writes")
            # evidence(protocol_json): asserted result fields below are the complete typed oracle
            val init = wine_peb_teb_init_default()
            val writes = wine_peb_teb_memory_write_gate(init, _startup_write_space())
            val plan = wine_peb_teb_layout_write_plan(init, writes)
            expect(plan.ok).to_equal(true)
            expect(plan.record_count).to_equal(6)  # oracle: plan.record_count must equal 6 — authoritative contract constant
            expect(plan.records[3].field_name).to_equal("ProcessEnvironmentBlock")
            expect(plan.records[3].address).to_equal(0x7ffde060)
            expect(plan.records[4].field_name).to_equal("ImageBaseAddress")
            expect(plan.records[5].field_name).to_equal("ProcessParameters")

        it "compose PEB/TEB layout writes before NTDLL process-info handoff":
            # @req REQ-SSPEC-SYSTEM
            step("compose PEB/TEB layout writes before NTDLL process-info handoff")
            # evidence(protocol_json): asserted result fields below are the complete typed oracle
            val init = wine_peb_teb_init_default()
            val writes = wine_peb_teb_memory_write_gate(init, _startup_write_space())
            val plan = wine_peb_teb_layout_write_plan(init, writes)
            val result = wine_ntdll_execute_process_info_with_peb_teb_layout(["NtQueryInformationProcess", "NtQueryInformationThread"], _classes(), init, plan)
            expect(result.ok).to_equal(true)
            expect(result.operations).to_contain("PEBTEBLayoutWritePlan")
            expect(result.operations).to_contain("NtQueryInformationProcess")
            expect(result.peb_address).to_equal(0x7ffdf000)

        it "materialize PEB/TEB startup layout writes as byte payloads":
            # @req REQ-SSPEC-SYSTEM
            step("materialize PEB/TEB startup layout writes as byte payloads")
            # evidence(protocol_json): asserted result fields below are the complete typed oracle
            val init = wine_peb_teb_init_default()
            val writes = wine_peb_teb_memory_write_gate(init, _startup_write_space())
            val plan = wine_peb_teb_layout_write_plan(init, writes)
            val bytes = wine_peb_teb_layout_byte_writes(plan)
            expect(bytes.ok).to_equal(true)
            expect(bytes.write_count).to_equal(6)  # oracle: bytes.write_count must equal 6 — authoritative contract constant
            expect(bytes.byte_count).to_equal(48)  # oracle: bytes.byte_count must equal 48 — authoritative contract constant
            expect(bytes.writes[3].field_name).to_equal("ProcessEnvironmentBlock")
            expect(bytes.writes[3].bytes[1]).to_equal(0xf0)
            expect(bytes.writes[3].bytes[2]).to_equal(0xfd)
            expect(bytes.operations).to_contain("PEBTEBLayoutBytesWritten")

        it "apply PEB/TEB startup layout bytes to VM memory with readback":
            # @req REQ-SSPEC-SYSTEM
            step("apply PEB/TEB startup layout bytes to VM memory with readback")
            # evidence(protocol_json): asserted result fields below are the complete typed oracle
            val init = wine_peb_teb_init_default()
            val writes = wine_peb_teb_memory_write_gate(init, _startup_write_space())
            val plan = wine_peb_teb_layout_write_plan(init, writes)
            val bytes = wine_peb_teb_layout_byte_writes(plan)
            val applied = wine_peb_teb_apply_layout_byte_writes(_startup_write_space(), bytes)
            expect(applied.ok).to_equal(true)
            expect(applied.write_count).to_equal(6)  # oracle: applied.write_count must equal 6 — authoritative contract constant
            expect(applied.byte_count).to_equal(48)  # oracle: applied.byte_count must equal 48 — authoritative contract constant
            expect(applied.operations).to_contain("PEBTEBLayoutVMReadback")

        it "compose VM byte-write readback before NTDLL process-info handoff":
            # @req REQ-SSPEC-SYSTEM
            step("compose VM byte-write readback before NTDLL process-info handoff")
            # evidence(protocol_json): asserted result fields below are the complete typed oracle
            val init = wine_peb_teb_init_default()
            val writes = wine_peb_teb_memory_write_gate(init, _startup_write_space())
            val plan = wine_peb_teb_layout_write_plan(init, writes)
            val bytes = wine_peb_teb_layout_byte_writes(plan)
            val applied = wine_peb_teb_apply_layout_byte_writes(_startup_write_space(), bytes)
            val result = wine_ntdll_execute_process_info_with_peb_teb_vm_writes(["NtQueryInformationProcess", "NtQueryInformationThread"], _classes(), init, applied)
            expect(result.ok).to_equal(true)
            expect(result.operations).to_contain("PEBTEBLayoutVMReadback")
            expect(result.operations).to_contain("NtQueryInformationProcess")
            expect(result.teb_address).to_equal(0x7ffde000)
