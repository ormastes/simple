"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/simpleos/feature/simpleos_wine_x86_64_frame_prologue_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use common.wine_x86_64_decode.{wine_x86_64_instruction_at, wine_x86_64_instruction_len_at, wine_x86_64_scan_window}
use std.spec.{step}

fn _zero_bytes(count: i64) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < count:
        out.push(0)
        i = i + 1
    out

fn _frame_prologue_bytes() -> [u8]:
    var data = _zero_bytes(14)
    data[0] = 0x55
    data[1] = 0x48
    data[2] = 0x89
    data[3] = 0xe5
    data[4] = 0x48
    data[5] = 0x83
    data[6] = 0xec
    data[7] = 0x28
    data[8] = 0x48
    data[9] = 0x83
    data[10] = 0xc4
    data[11] = 0x28
    data[12] = 0x5d
    data[13] = 0xc3
    data

fn _wide_stack_frame_prologue_bytes() -> [u8]:
    var data = _zero_bytes(20)
    data[0] = 0x55
    data[1] = 0x48
    data[2] = 0x89
    data[3] = 0xe5
    data[4] = 0x48
    data[5] = 0x81
    data[6] = 0xec
    data[7] = 0x20
    data[8] = 0x01
    data[9] = 0x00
    data[10] = 0x00
    data[11] = 0x48
    data[12] = 0x81
    data[13] = 0xc4
    data[14] = 0x20
    data[15] = 0x01
    data[16] = 0x00
    data[17] = 0x00
    data[18] = 0x5d
    data[19] = 0xc3
    data

describe "SimpleOS Wine x86_64 frame prologue decode":
    describe "REQ-018: bounded known-console process dispatch plan":
        it "should classify frame-pointer prologue and epilogue forms before dispatch handoff":
            # @req: REQ-SYSTEM-APP-001
                # @req: REQ-018
            step("Verify: should classify frame-pointer prologue and epilogue forms before dispatch handoff")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = _frame_prologue_bytes()
            expect(wine_x86_64_instruction_at(data, 0)).to_equal("push-rbp")
            expect(wine_x86_64_instruction_len_at(data, 0)).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            expect(wine_x86_64_instruction_at(data, 1)).to_equal("mov-rbp-rsp")
            expect(wine_x86_64_instruction_len_at(data, 1)).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
            expect(wine_x86_64_instruction_at(data, 12)).to_equal("pop-rbp")
            expect(wine_x86_64_instruction_len_at(data, 12)).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            val scan = wine_x86_64_scan_window(data, 0, 14, 8)
            expect(scan.ok).to_equal(true)
            expect(scan.state).to_equal("ready")
            expect(scan.end_offset).to_equal(14)  # oracle: expected value 14 is the behavior asserted by this regression spec
            expect(scan.instruction_count).to_equal(6)  # oracle: expected value 6 is the behavior asserted by this regression spec
            expect(scan.last_offset).to_equal(13)  # oracle: expected value 13 is the behavior asserted by this regression spec
            expect(scan.last_instruction).to_equal("ret")

        it "should classify wide imm32 stack allocation before dispatch handoff":
            # @req: REQ-SYSTEM-APP-002
            step("Verify: should classify wide imm32 stack allocation before dispatch handoff")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val data = _wide_stack_frame_prologue_bytes()
            expect(wine_x86_64_instruction_at(data, 4)).to_equal("sub-rsp-imm32")
            expect(wine_x86_64_instruction_len_at(data, 4)).to_equal(7)  # oracle: expected value 7 is the behavior asserted by this regression spec
            expect(wine_x86_64_instruction_at(data, 11)).to_equal("add-rsp-imm32")
            expect(wine_x86_64_instruction_len_at(data, 11)).to_equal(7)  # oracle: expected value 7 is the behavior asserted by this regression spec
            val scan = wine_x86_64_scan_window(data, 0, 20, 8)
            expect(scan.ok).to_equal(true)
            expect(scan.state).to_equal("ready")
            expect(scan.end_offset).to_equal(20)  # oracle: expected value 20 is the behavior asserted by this regression spec
            expect(scan.instruction_count).to_equal(6)  # oracle: expected value 6 is the behavior asserted by this regression spec
            expect(scan.last_offset).to_equal(19)  # oracle: expected value 19 is the behavior asserted by this regression spec
            expect(scan.last_instruction).to_equal("ret")
