"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/simpleos/feature/simpleos_wine_process_loader_state_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use common.wine_hello_fixture.{wine_known_hello_exe_fixture_bytes}
use common.wine_process_session.{
    wine_process_plan_import_loader_state,
    wine_process_session_plan,
    wine_process_session_request_new
}

use std.spec.{step}
fn _put_u32_le(data: [u8], offset: i64, value: i64) -> [u8]:
    data[offset] = (value & 0xff) as u8
    data[offset + 1] = ((value >> 8) & 0xff) as u8
    data[offset + 2] = ((value >> 16) & 0xff) as u8
    data[offset + 3] = ((value >> 24) & 0xff) as u8
    data

fn _put_ascii_z(data: [u8], offset: i64, value: text) -> [u8]:
    var i = 0
    while i < value.len():
        data[offset + i] = value[i] as u8
        i = i + 1
    data[offset + value.len()] = 0
    data

fn _put_import_name(data: [u8], offset: i64, value: text) -> [u8]:
    data[offset] = 0
    data[offset + 1] = 0
    _put_ascii_z(data, offset + 2, value)

fn _clear_bytes(data: [u8], offset: i64, count: i64) -> [u8]:
    var i = 0
    while i < count:
        data[offset + i] = 0
        i = i + 1
    data

fn _full_gates() -> text:
    "process=verified exec_env=verified vm=verified renderer=verified user32=verified " +
        "gdi32=verified kernel32_core=verified host=verified posix=verified registry=verified " +
        "pthread=verified dynload=verified audio=verified fonts=verified input=verified " +
        "pe_loader=verified async=verified nt_bridge=verified"

fn _known_hello_with_second_import_descriptor() -> [u8]:
    var data = wine_known_hello_exe_fixture_bytes()
    data = _clear_bytes(data, 0x250, 16)
    data = _put_u32_le(data, 0x220 + 12, 0x21d0)
    data = _put_u32_le(data, 0x220 + 20, 0x2190)
    data = _put_u32_le(data, 0x220 + 20 + 12, 0x21e0)
    data = _put_u32_le(data, 0x220 + 20 + 16, 0x21a0)
    data = _put_u32_le(data, 0x390, 0x21f0)
    data = _put_u32_le(data, 0x3a0, 0x21f0)
    data = _put_ascii_z(data, 0x3d0, "KERNEL32.dll")
    data = _put_ascii_z(data, 0x3e0, "USER32.dll")
    data = _put_import_name(data, 0x3f0, "MessageBoxW")
    data

describe "SimpleOS Wine process import loader state":
    describe "REQ-038: modeled import loader state with refcount release and rollback":
        it "should own modeled multi-DLL loader state without real DLL loading or PE execution":
            # @req: REQ-SYSTEM-APP-001
                # @req: REQ-038
            step("Verify: should own modeled multi-DLL loader state without real DLL loading or PE execution")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val plan = wine_process_session_plan(wine_process_session_request_new("game.exe", [], "C:\\Games"), _full_gates())
            val result = wine_process_plan_import_loader_state(plan, _known_hello_with_second_import_descriptor(), 4, 8)
            expect(result.ok).to_equal(true)
            expect(result.module_count).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
            expect(result.loaded_count).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
            expect(result.released_count).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
            expect(result.max_ref_count).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
            expect(result.evidence).to_contain("import-loader-state-planned")
            expect(result.evidence).to_contain("import-loader-refcounts-tracked")
            expect(result.evidence).to_contain("import-loader-refcounts-restored")
            expect(result.evidence).to_contain("no-real-dll-loaded")
            expect(result.evidence).to_contain("no-arbitrary-execution")
            expect(result.status).to_equal("import-loader-state-planned")
