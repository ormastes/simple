# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use common.wine_hello_fixture.{wine_known_hello_exe_fixture_bytes}
use common.wine_process_session.{
    wine_process_plan_import_loader_state,
    wine_process_session_plan,
    wine_process_session_request_new
}

use std.spec.{step}
fn _put_u32_le(data: [u8], offset: i64, value: i64) -> [u8]:
    data[offset] = (value & 0xff) as u8
    data[offset + 1] = ((value >> 8) & 0xff) as u8
    data[offset + 2] = ((value >> 16) & 0xff) as u8
    data[offset + 3] = ((value >> 24) & 0xff) as u8
    data

fn _put_ascii_z(data: [u8], offset: i64, value: text) -> [u8]:
    var i = 0
    while i < value.len():
        data[offset + i] = value[i] as u8
        i = i + 1
    data[offset + value.len()] = 0
    data

fn _put_import_name(data: [u8], offset: i64, value: text) -> [u8]:
    data[offset] = 0
    data[offset + 1] = 0
    _put_ascii_z(data, offset + 2, value)

fn _clear_bytes(data: [u8], offset: i64, count: i64) -> [u8]:
    var i = 0
    while i < count:
        data[offset + i] = 0
        i = i + 1
    data

fn _full_gates() -> text:
    "process=verified exec_env=verified vm=verified renderer=verified user32=verified " +
        "gdi32=verified kernel32_core=verified host=verified posix=verified registry=verified " +
        "pthread=verified dynload=verified audio=verified fonts=verified input=verified " +
        "pe_loader=verified async=verified nt_bridge=verified"

fn _known_hello_with_second_import_descriptor() -> [u8]:
    var data = wine_known_hello_exe_fixture_bytes()
    data = _clear_bytes(data, 0x250, 16)
    data = _put_u32_le(data, 0x220 + 12, 0x21d0)
    data = _put_u32_le(data, 0x220 + 20, 0x2190)
    data = _put_u32_le(data, 0x220 + 20 + 12, 0x21e0)
    data = _put_u32_le(data, 0x220 + 20 + 16, 0x21a0)
    data = _put_u32_le(data, 0x390, 0x21f0)
    data = _put_u32_le(data, 0x3a0, 0x21f0)
    data = _put_ascii_z(data, 0x3d0, "KERNEL32.dll")
    data = _put_ascii_z(data, 0x3e0, "USER32.dll")
    data = _put_import_name(data, 0x3f0, "MessageBoxW")
    data

describe "SimpleOS Wine process import loader state":
    describe "REQ-038: modeled import loader state with refcount release and rollback":
        it "should own modeled multi-DLL loader state without real DLL loading or PE execution":
            # @req REQ-SSPEC-SYSTEM
            # @req REQ-038
            # @req REQ-SSPEC-SYSTEM
            step("should own modeled multi-DLL loader state without real DLL loading or PE execution")
            val plan = wine_process_session_plan(wine_process_session_request_new("game.exe", [], "C:\\Games"), _full_gates())
            val result = wine_process_plan_import_loader_state(plan, _known_hello_with_second_import_descriptor(), 4, 8)
            assert_equal(result.ok, true)
            assert_equal(result.module_count, 2)
            assert_equal(result.loaded_count, 2)
            assert_equal(result.released_count, 2)
            assert_equal(result.max_ref_count, 2)
            assert_contains(result.evidence, "import-loader-state-planned")
            assert_contains(result.evidence, "import-loader-refcounts-tracked")
            assert_contains(result.evidence, "import-loader-refcounts-restored")
            assert_contains(result.evidence, "no-real-dll-loaded")
            assert_contains(result.evidence, "no-arbitrary-execution")
            assert_equal(result.status, "import-loader-state-planned")
