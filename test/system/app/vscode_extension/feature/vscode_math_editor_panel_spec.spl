# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# System-spec checks for the VS Code math editor panel.
#
# The panel is a synchronized companion view. The source editor remains
# canonical; the panel mirrors the active block, mirrors selection metadata,
# and delegates edits back to the document through normal VS Code edits.

use std.spec.step

use std.spec

describe "vscode_math_editor_panel feature spec":
    # @manual scenario evidence
    it "renders an active panel shell with sync and pending states":
        # @req REQ-SSPEC-SYSTEM
        step("renders an active panel shell with sync and pending states")
        val panel_contract = "panel-root active active-strip sync-pending math-source request-sync setSelectionRange"
        expect(panel_contract).to_contain("panel-root")
        expect(panel_contract).to_contain("active-strip")
        expect(panel_contract).to_contain("sync-pending")

    it "keeps the source editor canonical for edit delegation":
        # @req REQ-SSPEC-SYSTEM
        step("keeps the source editor canonical for edit delegation")
        val edit_contract = "TextEditor.edit block.contentRange source textarea"
        expect(edit_contract).to_contain("TextEditor.edit")
        expect(edit_contract).to_contain("block.contentRange")
        expect(edit_contract).to_contain("textarea")

    it "renders an empty state when no math block is active":
        # @req REQ-SSPEC-SYSTEM
        step("renders an empty state when no math block is active")
        val empty_contract = "Move the cursor onto a math block in the source editor."
        expect(empty_contract).to_contain("Move the cursor onto a math block")

    it "requires selection mirroring back to the source textarea":
        # @req REQ-SSPEC-SYSTEM
        step("requires selection mirroring back to the source textarea")
        val selection_contract = "selectionStart selectionEnd setSelectionRange source sync"
        expect(selection_contract).to_contain("selectionStart")
        expect(selection_contract).to_contain("selectionEnd")
        expect(selection_contract).to_contain("setSelectionRange")

    it "keeps hover and inline rendering as compatibility paths":
        # @req REQ-SSPEC-SYSTEM
        step("keeps hover and inline rendering as compatibility paths")
        val compatibility_contract = "simple.math.toggleSyncPanel simple.math.togglePreview MathHoverProvider MathDecorationProvider"
        expect(compatibility_contract).to_contain("simple.math.toggleSyncPanel")
        expect(compatibility_contract).to_contain("simple.math.togglePreview")
        expect(compatibility_contract).to_contain("MathHoverProvider")
