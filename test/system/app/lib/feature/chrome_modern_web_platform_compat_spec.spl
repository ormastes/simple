"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/lib/feature/chrome_modern_web_platform_compat_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# codex-system-test

use std.spec.{describe, context, it, expect, step}

extern fn rt_file_read_text(path: text) -> text

val PLAN_PATH = "doc/03_plan/platform/chrome_modern_web_platform_compat_plan.md"
val TEST_PLAN_PATH = "doc/03_plan/sys_test/chrome_modern_web_platform_compat.md"
val FEATURE_REQ_PATH = "doc/02_requirements/feature/chrome_modern_web_platform_compat.md"
val NFR_REQ_PATH = "doc/02_requirements/nfr/chrome_modern_web_platform_compat.md"
val AUDIT_PATH = "doc/09_report/chrome_modern_web_platform_compat_2026-05-06.md"
val RENDERER_SPEC_PATH = "test/unit/lib/gc_async_mut/gpu/browser_engine/browser_renderer_spec.spl"
val WPT_SUBSET_PLAN_PATH = "doc/03_plan/ui/web_browser/wpt_subset_migration.md"
val WPT_SELECTOR_COLOR_SPEC_PATH = "test/feature/web_platform/css/selector_color_subset_spec.spl"
val STYLE_BLOCK_PATH = "src/lib/gc_async_mut/gpu/browser_engine/style_block.spl"
val BROWSER_RENDERER_PATH = "src/lib/gc_async_mut/gpu/browser_engine/browser_renderer.spl"

fn _read(path: text) -> text:
    rt_file_read_text(path)

describe "Chrome modern web platform compatibility plan":

    context "REQ-001 compatibility matrix":

        it "should require HTML CSS DOM rendering and JavaScript matrix coverage":
            # @req: REQ-SYSTEM-APP-001
                # @req: REQ-001
            step("Verify: should require HTML CSS DOM rendering and JavaScript matrix coverage")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val plan = _read(PLAN_PATH)
            expect(plan).to_contain("HTML, CSS, DOM/rendering, and JavaScript")
            expect(plan).to_contain("web_platform_feature_matrix.md")

        it "should require explicit compatibility statuses":
            # @req: REQ-SYSTEM-APP-002
            step("Verify: should require explicit compatibility statuses")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val plan = _read(PLAN_PATH)
            expect(plan).to_contain("`supported`, `partial`, `missing`, or `not-applicable`")

        it "should gate migration on first WPT and Test262 subset selection":
            # @req: REQ-SYSTEM-APP-003
            step("Verify: should gate migration on first WPT and Test262 subset selection")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val plan = _read(PLAN_PATH)
            expect(plan).to_contain("identify the first WPT/Test262 subset to migrate")

    context "REQ-002 WPT subset migration":

        it "should define a repeatable WPT subset import surface":
