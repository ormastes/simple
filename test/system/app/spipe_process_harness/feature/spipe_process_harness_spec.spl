"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/app/spipe_process_harness/feature/spipe_process_harness_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.nogc_async_mut.spipe_process_harness.core.{
    normalize_provider, provider_hook_events, hook_jsonl, gate_from_state,
    render_state, render_hud, deploy_snippets
}
use std.nogc_async_mut.spipe_process_harness.types.{HudSnapshot}
use std.spec.{describe, it, expect, step}

describe "SPipe process harness feature":
    describe "REQ-001: shared provider support":
        it "normalizes supported provider names":
            # @req: REQ-SYSTEM-APP-001 REQ-002 REQ-003 REQ-004 REQ-006
                # @req: REQ-001
            step("Verify: normalizes supported provider names")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(normalize_provider("Claude")).to_equal("claude")
            expect(normalize_provider("Codex")).to_equal("codex")
            expect(normalize_provider("Gemini")).to_equal("gemini")

        it "defines hook lifecycle events for each supported provider":
            # @req: REQ-SYSTEM-APP-002
            step("Verify: defines hook lifecycle events for each supported provider")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(provider_hook_events("claude")).to_contain("PreToolUse")
            expect(provider_hook_events("codex")).to_contain("tool_start")
            expect(provider_hook_events("gemini")).to_contain("prompt_submit")

    describe "REQ-002: normalized hook envelope":
        it "preserves provider event session model and raw payload":
            # @req: REQ-SYSTEM-APP-003
            step("Verify: preserves provider event session model and raw payload")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val line = hook_jsonl("Claude", "SessionStart", "sid", "sonnet", "{\"ok\":true}")
            expect(line).to_contain("\"provider\":\"claude\"")
            expect(line).to_contain("\"event\":\"SessionStart\"")
            expect(line).to_contain("\"session_id\":\"sid\"")
            expect(line).to_contain("\"model\":\"sonnet\"")
            expect(line).to_contain("\"raw\"")

    describe "REQ-003: deploy snippets":
        it "renders deploy snippets for all providers":
            # @req: REQ-SYSTEM-APP-004
            step("Verify: renders deploy snippets for all providers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val snippets = deploy_snippets()
            expect(snippets.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
            expect(snippets[0].path).to_contain(".spipe/hook-deploy/")
            expect(snippets[1].path).to_contain(".spipe/hook-deploy/")
            expect(snippets[2].path).to_contain(".spipe/hook-deploy/")

    describe "REQ-004: CLI HUD":
        it "renders all required HUD fields":
            # @req: REQ-SYSTEM-APP-005
            step("Verify: renders all required HUD fields")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val hud = render_hud(HudSnapshot(model: "m", jj_worktree: "w", commit_id: "c", hours_remaining: "h", week_remaining: "wk", goal: "g"))
            expect(hud).to_contain("model=m")
            expect(hud).to_contain("jj=w")
            expect(hud).to_contain("commit=c")
            expect(hud).to_contain("hr=h")
            expect(hud).to_contain("week=wk")
            expect(hud).to_contain("goal=g")

    describe "REQ-006: prevention gate":
        it "blocks state without approval":
            # @req: REQ-SYSTEM-APP-006
            step("Verify: blocks state without approval")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val state = render_state("f", "r", "g", false)
            expect(gate_from_state(state, true).allowed).to_equal(false)

        it "allows approved state":
            # @req: REQ-SYSTEM-APP-007
            step("Verify: allows approved state")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val state = render_state("f", "r", "g", true)
            expect(gate_from_state(state, true).allowed).to_equal(true)

        it "blocks explicit prevention marker":
            # @req: REQ-SYSTEM-APP-008
            step("Verify: blocks explicit prevention marker")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val decision = gate_from_state("User Approved: true\nPrevent: block\n", true)
            expect(decision.allowed).to_equal(false)

