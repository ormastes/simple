# @cover src/compiler/30.types/macro_expander.spl 80%
"""
## Purpose and audience
Purpose: expands simple macro
Audience: compiler and tooling engineers who maintain this spec

Basic macro system specification.

Tests fundamental macro functionality including simple expression macros,
const parameter passing, and template-based code generation.
"""

# @req: REQ-FEATURES-MacrBasi-001

# Macros must be defined at module level

macro basic_answer() -> (returns result: Int):
    emit result:
        42

macro basic_double(x: Int) -> (returns result: Int):
    emit result:
        x * 2

macro basic_add(a: Int, b: Int) -> (returns result: Int):
    emit result:
        a + b

macro basic_max(a: Int, b: Int) -> (returns result: Int):
    emit result:
        if a > b:
            return a
        else:
            return b

use std.spec.step
describe "Basic Macros":
    """
    Tests fundamental macro operations including simple expansion,
    const parameter usage, and basic template generation.
    """

    it "expands simple macro":
        step("Verify: expands simple macro")
        # @req: REQ-FEATURES-MacrBasi-001
        val x = basic_answer!()
        expect(x).to_equal(42)  # oracle: value fixed by the spec contract

    it "uses const parameter":
        step("Verify: uses const parameter")
        # @req: REQ-FEATURES-MacrBasi-001
        val x = basic_double!(21)
        expect(x).to_equal(42)  # oracle: value fixed by the spec contract

    it "generates function with template":
        step("Verify: generates function with template")
        # @req: REQ-FEATURES-MacrBasi-001
        val x = basic_add!(30, 12)
        expect(x).to_equal(42)  # oracle: value fixed by the spec contract

    it "evaluates max correctly":
        step("Verify: evaluates max correctly")
        # @req: REQ-FEATURES-MacrBasi-001
        val x = basic_max!(10, 50)
        expect(x).to_equal(50)  # oracle: value fixed by the spec contract

        val y = basic_max!(100, 5)
        expect(y).to_equal(100)  # oracle: value fixed by the spec contract
