# @cover src/compiler/95.interp/interpreter/mod.spl 80%
#!/usr/bin/env simple
# Test basic with statement functionality

use std.spec

describe "with statement":
    it "calls enter and cleanup on simple context manager":
        # Define a simple context manager
        class TestContext:
            entered: bool
            cleaned: bool

            fn __enter__() -> TestContext:
                self.entered = true
                self

            fn __exit__(exc):
                self.cleaned = true

        # Create context manager
        val ctx = TestContext(entered: false, cleaned: false)

        # Use with statement
        with ctx as c:
            check c.entered

        # Check cleanup was called
        check ctx.cleaned

    it "calls cleanup even when block completes normally":
        class TestContext:
            cleaned: bool

            fn __enter__() -> TestContext:
                self

            fn __exit__(exc):
                self.cleaned = true

        val ctx = TestContext(cleaned: false)

        with ctx:
            val x = 42

        check ctx.cleaned

    it "supports variable binding with as clause":
        class ValueContext:
            value: text

            fn __enter__() -> text:
                self.value

            fn __exit__(exc):
                pass

        val ctx = ValueContext(value: "hello")

        with ctx as val_:
            check val_ == "hello"

    it "supports with statement without variable binding":
        class NoBindContext:
            entered: bool
            cleaned: bool

            fn __enter__() -> NoBindContext:
                self.entered = true
                self

            fn __exit__(exc):
                self.cleaned = true

        val ctx = NoBindContext(entered: false, cleaned: false)

        with ctx:
            check ctx.entered

        check ctx.cleaned
