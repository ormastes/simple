# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/lib/common/ui/reactive.spl 80%
# @cover src/lib/common/ui/widget.spl 60%
"""
# UI Dynamic Structure Specification

Exercises the real widget-store-backed structure machinery behind runtime UI
hierarchy changes: conditional presence of widgets (child membership), list
rendering from collections, structural replacement delivered as patches, and
the reactive state that triggers rebuilds.
"""

use std.spec.step

use std.spec
use common.ui.builder.{column, text_widget}
use common.ui.diff.{diff_trees}
use common.ui.reactive.{ReactiveStore, ReactiveUI}

describe "UI Dynamic Structure":
    # @manual scenario evidence
    it "includes the conditional element in the hierarchy when the condition is true":
        # @req REQ-SSPEC-SYSTEM
        step("build a branch-present tree and assert the child is reachable by id")
        # evidence(protocol_json): child count and id membership asserted below are the complete typed oracle
        val shown = column("cond_true", [text_widget("greeting", "hello")])
        expect(shown.children().len()).to_equal(1)  # oracle: the taken branch contributes exactly one child
        expect(shown.children()[0].id).to_equal("greeting")

    it "omits the conditional element when the condition is false":
        # @req REQ-SSPEC-SYSTEM
        step("build a branch-absent tree and assert the child slot is empty")
        # evidence(protocol_json): child count asserted below is the complete typed oracle
        expect(column("cond_false", []).children().len()).to_equal(0)  # oracle: the untaken branch contributes no child

    it "renders one list child per collection entry":
        # @req REQ-SSPEC-SYSTEM
        step("build a list tree from a three-entry collection")
        # evidence(protocol_json): child count and ids asserted below are the complete typed oracle
        var items: [text] = ["a", "b", "c"]
        var children = []
        for item in items:
            children.push(text_widget("item_" + item, item))
        val list_node = column("list_v1", children)
        expect(list_node.children().len()).to_equal(3)  # oracle: one child per list entry
        expect(list_node.children()[2].id).to_equal("item_c")

    it "delivers a replacement patch when the structure changes":
        # @req REQ-SSPEC-SYSTEM
        step("diff two differently-keyed roots and count the emitted patches")
        # evidence(protocol_json): patch count asserted below is the complete typed oracle
        val old_tree = column("list_v1", [text_widget("item_a", "a")])
        val new_tree = column("list_v2", [text_widget("item_a", "a"), text_widget("item_b", "b")])
        val patches = diff_trees(old_tree, new_tree)
        expect(patches.len()).to_equal(1)  # oracle: a re-keyed structure is one ReplaceNode patch
        expect(patches[0].target_id).to_equal("list_v2")

    it "reactive state flags dirtiness that drives a rebuild":
        # @req REQ-SSPEC-SYSTEM
        step("flip a reactive value and observe dirty tracking and patch output")
        # evidence(protocol_json): dirty flag and patch counts asserted below are the complete typed oracle
        val store = ReactiveStore.new()
        store.define("visible", "0")
        expect(store.is_dirty()).to_equal(false)
        expect(store.set("visible", "1")).to_equal(true)
        expect(store.is_dirty()).to_equal(true)  # oracle: a changed value must mark the store dirty
        expect(store.get("visible")).to_equal("1")
        val ui = ReactiveUI.new()
        expect(ui.update(column("mount_v1", [])).len()).to_equal(0)  # oracle: first mount produces no patches
        expect(ui.update(column("mount_v2", [text_widget("x", "x")])).len()).to_equal(1)  # oracle: a re-keyed rebuild delivers one replacement patch
