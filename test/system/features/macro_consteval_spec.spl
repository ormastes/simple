# @cover src/compiler/35.semantics/const_eval.spl 80%
"""
## Purpose and audience
Purpose: evaluates addition and multiplication
Audience: compiler and tooling engineers who maintain this spec

Const-eval engine specification.

Tests the compile-time evaluation engine for macros including arithmetic
evaluation, conditional expressions, and loop-based code generation.
"""

# @req: REQ-FEATURES-MacrCons-001

# ============================================================================
# Module-level macro definitions
# ============================================================================

# Arithmetic macros
macro ce_compute(a: Int, b: Int) -> (returns result: Int):
    emit result:
        a + b * 2

macro ce_with_zero(a: Int) -> (returns result: Int):
    emit result:
        a + 0

macro ce_subtract(a: Int, b: Int) -> (returns result: Int):
    emit result:
        a - b

# Conditional macros
macro ce_max(a: Int, b: Int) -> (returns result: Int):
    emit result:
        if a > b:
            return a
        else:
            return b

macro ce_min(a: Int, b: Int) -> (returns result: Int):
    emit result:
        if a < b:
            return a
        else:
            return b

macro ce_abs(x: Int) -> (returns result: Int):
    emit result:
        if x < 0:
            return -x
        else:
            return x

# Loop macros
macro ce_gen_funcs(N: Int const) -> (
    intro funcs:
        for i in 0..N:
            enclosing.module.fn "ce_loop_get_{i}"() -> Int
):
    emit funcs:
        for i in 0..N:
            fn "ce_loop_get_{i}"() -> Int:
                return i

macro ce_sum_range(n: Int const) -> (returns result: Int):
    emit result:
        var sum = 0
        for i in 0..n:
            sum = sum + i
        sum

# ============================================================================
# Invoke macros that generate functions at module level
# ============================================================================
ce_gen_funcs!(3)

# ============================================================================
# Tests
# ============================================================================

use std.spec.step
describe "Const-Eval Engine":
    """
    Tests compile-time evaluation of expressions within macros including
    arithmetic, conditionals with if-else, and loop-based function generation.
    """

    describe "Arithmetic evaluation":
        it "evaluates addition and multiplication":
            step("Verify: evaluates addition and multiplication")
            # @req: REQ-FEATURES-MacrCons-001
            val x = ce_compute!(10, 16)
            # 10 + 16 * 2 = 10 + 32 = 42
            expect(x).to_equal(42)  # oracle: value fixed by the spec contract

        it "evaluates with zero":
            step("Verify: evaluates with zero")
            # @req: REQ-FEATURES-MacrCons-001
            val x = ce_with_zero!(42)
            expect(x).to_equal(42)  # oracle: value fixed by the spec contract

        it "evaluates subtraction":
            step("Verify: evaluates subtraction")
            # @req: REQ-FEATURES-MacrCons-001
            val x = ce_subtract!(50, 8)
            expect(x).to_equal(42)  # oracle: value fixed by the spec contract

    describe "Conditional evaluation":
        it "evaluates max correctly":
            step("Verify: evaluates max correctly")
            # @req: REQ-FEATURES-MacrCons-001
            expect(ce_max!(10, 50)).to_equal(50)  # oracle: value fixed by the spec contract
            expect(ce_max!(100, 5)).to_equal(100)  # oracle: value fixed by the spec contract
            expect(ce_max!(42, 42)).to_equal(42)  # oracle: value fixed by the spec contract

        it "evaluates min correctly":
            step("Verify: evaluates min correctly")
            # @req: REQ-FEATURES-MacrCons-001
            expect(ce_min!(10, 50)).to_equal(10)  # oracle: value fixed by the spec contract
            expect(ce_min!(100, 5)).to_equal(5)  # oracle: value fixed by the spec contract

        it "evaluates abs correctly":
            step("Verify: evaluates abs correctly")
            # @req: REQ-FEATURES-MacrCons-001
            expect(ce_abs!(42)).to_equal(42)  # oracle: value fixed by the spec contract
            expect(ce_abs!(-42)).to_equal(42)  # oracle: value fixed by the spec contract
            expect(ce_abs!(0)).to_equal(0)  # oracle: value fixed by the spec contract

    describe "Loop evaluation":
        it "generates functions with for loop":
            step("Verify: generates functions with for loop")
            # @req: REQ-FEATURES-MacrCons-001
            val sum = ce_loop_get_0() + ce_loop_get_1() + ce_loop_get_2()
            expect(sum).to_equal(3)  # oracle: value fixed by the spec contract

        it "handles range iteration":
            step("Verify: handles range iteration")
            # @req: REQ-FEATURES-MacrCons-001
            # 0 + 1 + 2 + 3 + 4 = 10
            val x = ce_sum_range!(5)
            expect(x).to_equal(10)  # oracle: value fixed by the spec contract
