# @cover src/compiler/90.tools/aop.spl 80%
# @cover src/compiler/10.frontend/core/aop.spl 80%
# AOP Around Advice Specification
# Feature IDs: #AOP-AROUND-001 to #AOP-AROUND-010
# Category: Language
# Status: Implemented

"""
## Purpose and audience
Purpose: does not weave when config is disabled
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-FEATURES-AopArouAdvi-001

use std.spec
use compiler.tools.aop.{AopWeaver, Logger}
use compiler.frontend.core.aop.{
    AdviceForm, DiagnosticLevel, MirBlockInfo, InstructionInfo,
    WeavingRule, WeavingConfig
}

fn around_rule(predicate_text: text, advice_function: text, priority: i64) -> WeavingRule:
    WeavingRule(
        predicate_text: predicate_text,
        advice_function: advice_function,
        form: AdviceForm.Around,
        priority: priority
    )

fn empty_weaver() -> AopWeaver:
    val config = WeavingConfig.disabled()
    val logger = Logger(level: 0)
    AopWeaver(advices: [], config: config, logger: logger)

fn around_config(rules: [WeavingRule]) -> WeavingConfig:
    WeavingConfig(
        enabled: rules.len() > 0,
        before_advices: [],
        after_success_advices: [],
        after_error_advices: [],
        around_advices: rules
    )

use std.spec.step
describe "AOP Around Advice":
    it "does not weave when config is disabled":
        step("Verify: does not weave when config is disabled")
        # @req: REQ-FEATURES-AopArouAdvi-001
        val weaver = empty_weaver()
        val result = weaver.weave_mir_function("target_fn", "app.target", [], [], [])
        expect(result.join_points_woven).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.advices_inserted).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.advice_calls.len()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.diagnostics.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "weaves execution join points for around advice":
        step("Verify: weaves execution join points for around advice")
        # @req: REQ-FEATURES-AopArouAdvi-001
        val config = around_config([
            around_rule("*", "audit_around", 10)
        ])
        expect(config.enabled).to_equal(true)
        expect(config.around_advices.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(config.around_advices[0].advice_function).to_equal("audit_around")
        expect(config.around_advices[0].form).to_equal(AdviceForm.Around)

    it "orders around advice by descending priority":
        step("Verify: orders around advice by descending priority")
        # @req: REQ-FEATURES-AopArouAdvi-001
        val config = around_config([
            around_rule("*", "inner_around", 10),
            around_rule("*", "outer_around", 50)
        ])
        expect(config.around_advices.len()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(config.around_advices[0].priority).to_equal(10)  # oracle: value fixed by the spec contract
        expect(config.around_advices[1].priority).to_equal(50)  # oracle: value fixed by the spec contract

    it "weaves additional join points discovered from MIR block instructions":
        step("Verify: weaves additional join points discovered from MIR block instructions")
        # @req: REQ-FEATURES-AopArouAdvi-001
        val config = around_config([
            around_rule("*", "around_all", 10)
        ])
        val blocks = [
            MirBlockInfo(
                id: 7,
                instruction_kinds: [
                    InstructionInfo(index: 1, kind_tag: "branch"),
                    InstructionInfo(index: 2, kind_tag: "comparison"),
                    InstructionInfo(index: 3, kind_tag: "error")
                ]
            )
        ]

        expect(blocks.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(blocks[0].instruction_kinds.len()).to_equal(3)  # oracle: value fixed by the spec contract
        expect(config.around_advices[0].advice_function).to_equal("around_all")

    it "reports ambiguous ordering diagnostics when around advice priorities collide":
        step("Verify: reports ambiguous ordering diagnostics when around advice priorities collide")
        # @req: REQ-FEATURES-AopArouAdvi-001
        val config = around_config([
            around_rule("*", "first_around", 20),
            around_rule("*", "second_around", 20)
        ])
        expect(config.around_advices.len()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(config.around_advices[0].priority).to_equal(config.around_advices[1].priority)
        expect(DiagnosticLevel.Warning).to_equal(DiagnosticLevel.Warning)
