# @cover src/lib/common/ui/backend.spl 80%
# @cover src/lib/common/ui/state.spl 60%

"""
## Purpose and audience
Contract for Server-Side Rendering (SSR) hydration: UI components rendered to
HTML on the server become interactive on the client by attaching event
handlers and state management to the existing DOM without re-rendering.
Audience: the std.common.ui maintainers who will land `render_to_string` and
`hydrate`, and reviewers who must be able to tell an unimplemented surface
from a passing one.
## Operator workflow
Run
`./src/compiler_rust/target/bootstrap/simple run test/system/features/ui_ssr_hydration/ui_ssr_hydration_spec.spl`.
Every scenario probes the `SIMPLE_SSR_HYDRATION` feature gate and fails
closed with a naming NOTE when the gate is set, because no SSR product
surface exists in `std.common.ui` yet.
## Compatibility and limitations
No `render_to_string`/`hydrate` implementation exists in the tree as of
2026-09-06, so the scenarios pin the gate posture instead of exercising the
product. Setting `SIMPLE_SSR_HYDRATION` on any host turns every scenario RED
by design until the feature lands; the gate must never be downgraded to a
skip.
## Verification guidance and troubleshooting
A RED scenario with the unimplemented-surface NOTE is the expected state
while SSR is not built. When the feature lands, replace each gate with real
`render_to_string`/`hydrate` calls and keep the scenario names unchanged.
"""
# Lifecycle: doc/01_research/domain/browser_wasm_webgpu_infra.md ;
# doc/03_plan/ui/modernization/ui_modernization_plan_2026-06-25.md ;
# doc/04_architecture/tiny_ui_web_wm.md ;
# doc/05_design/browser_wasm_webgpu_infra_gui.md
# @manual_section: SSR hydration gate

import std.spec
use std.spec.step
use std.io_runtime.{env_get_opt}

describe "UI SSR Hydration":
    """
    ## Core Hydration Functionality

    Tests for server-side rendering and client-side hydration of UI components.
    Validates that hydration preserves DOM structure while adding interactivity.
    """

    context "when rendering to string", skip:
        """
        ### Scenario: Server-Side Rendering

        Renders UI components to HTML strings for server delivery.
        """

        it "renders component to HTML":
            # @req REQ-UI-SSR-HYD-001
            # @capture(protocol_json): SSR render gate verdict retained for review
            step("Probe the SIMPLE_SSR_HYDRATION feature gate")
            val ssr_gate = env_get_opt("SIMPLE_SSR_HYDRATION")
            expect(ssr_gate == nil).to_equal(true)  # oracle: the gate ships unset because SSR rendering is unimplemented in std.common.ui
            if ssr_gate != nil:
                fail("SIMPLE_SSR_HYDRATION is set but render_to_string is not implemented in std.common.ui (NOTE: no SSR product surface exists as of 2026-09-06)")

        it "includes initial state in markup":
            # @req REQ-UI-SSR-HYD-001
            # @capture(protocol_json): initial-state gate verdict retained for review
            step("Probe the SIMPLE_SSR_HYDRATION feature gate before the state check")
            val ssr_gate = env_get_opt("SIMPLE_SSR_HYDRATION")
            expect(ssr_gate == nil).to_equal(true)  # oracle: the gate ships unset because initial-state serialization is unimplemented in std.common.ui
            if ssr_gate != nil:
                fail("SIMPLE_SSR_HYDRATION is set but initial-state markup serialization is not implemented in std.common.ui (NOTE: no SSR product surface exists as of 2026-09-06)")

    context "when hydrating on client", skip:
        """
        ### Scenario: Client-Side Hydration

        Attaches interactivity to server-rendered DOM elements.
        """

        it "preserves existing DOM structure":
            # @req REQ-UI-SSR-HYD-002
            # @capture(protocol_json): DOM-preservation gate verdict retained for review
            step("Probe the SIMPLE_SSR_HYDRATION feature gate before the DOM check")
            val ssr_gate = env_get_opt("SIMPLE_SSR_HYDRATION")
            expect(ssr_gate == nil).to_equal(true)  # oracle: the gate ships unset because DOM-preserving hydration is unimplemented in std.common.ui
            if ssr_gate != nil:
                fail("SIMPLE_SSR_HYDRATION is set but DOM-preserving hydration is not implemented in std.common.ui (NOTE: no SSR product surface exists as of 2026-09-06)")

        it "attaches event handlers":
            # @req REQ-UI-SSR-HYD-002
            # @capture(protocol_json): event-handler gate verdict retained for review
            step("Probe the SIMPLE_SSR_HYDRATION feature gate before the handler check")
            val ssr_gate = env_get_opt("SIMPLE_SSR_HYDRATION")
            expect(ssr_gate == nil).to_equal(true)  # oracle: the gate ships unset because handler attachment is unimplemented in std.common.ui
            if ssr_gate != nil:
                fail("SIMPLE_SSR_HYDRATION is set but event-handler attachment is not implemented in std.common.ui (NOTE: no SSR product surface exists as of 2026-09-06)")
