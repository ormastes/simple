describe "Variable Declaration Parsing":
    context "immutable variables":
        it "parses val declaration":
            # @req: REQ-SYSTEM-FEATURES-027
            step("Verify: parses val declaration")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 42
            expect(x).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

        it "parses val with type annotation":
            # @req: REQ-SYSTEM-FEATURES-028
            step("Verify: parses val with type annotation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x: i64 = 42
            expect(x).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

    context "mutable variables":
        it "parses var declaration":
            # @req: REQ-SYSTEM-FEATURES-029
            step("Verify: parses var declaration")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var x = 0
            x = 42
            expect(x).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

        it "parses var with type annotation":
            # @req: REQ-SYSTEM-FEATURES-030
            step("Verify: parses var with type annotation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var x: i64 = 0
            x = 42
            expect(x).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

    context "let bindings":
        it "parses let declaration":
            # @req: REQ-SYSTEM-FEATURES-031
            step("Verify: parses let declaration")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            let x = 42
            expect(x).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

        it "parses let with destructuring":
            # @req: REQ-SYSTEM-FEATURES-032
            step("Verify: parses let with destructuring")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            let (a, b) = (1, 2)
            expect(a + b).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec


