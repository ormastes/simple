            expect(true).to_equal(true)

    context "generic structs":
        it "parses generic struct":
            # @req: REQ-SYSTEM-FEATURES-004
            step("Verify: parses generic struct")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(true).to_equal(true)

        it "parses multi-param generic struct":
            # @req: REQ-SYSTEM-FEATURES-005
            step("Verify: parses multi-param generic struct")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(true).to_equal(true)

    context "nested structs":
