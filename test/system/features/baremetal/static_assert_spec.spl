"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-FEATURES behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/features/baremetal/static_assert_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-SYSTEM-FEATURES-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/compiler/35.semantics/const_eval.spl 80%
# Static assert syntax is not available in the runtime parser, so this file
# models the same intent with a local parser-safe harness.
"""
# Static Assertions Specification

**Feature IDs:** #BM-001
**Category:** Language / Bare-Metal
**Status:** Parser-safe local coverage

Static assertions allow compile-time validation of conditions.
They are evaluated during compilation and cause a compile error if false.
"""

fn check(condition: bool):
    expect(condition).to_equal(true)

struct StaticCheck:
    name: text
    condition: bool
    message: text

    fn passes() -> bool:
        self.condition

    fn error_message() -> text:
        if self.condition:
            ""
        else:
            self.message

fn static_assert_case(name: text, condition: bool, message: text) -> StaticCheck:
    StaticCheck(name: name, condition: condition, message: message)

fn is_power_of_two(value: i64) -> bool:
    if value <= 0:
        false
    else:
        var n = value
        while n % 2 == 0:
            n = n / 2
        n == 1

describe "Static Assertions":
    """Compile-time assertion validation."""

    context "Basic Assertions":
        """Simple constant expression assertions."""

        it "validates true literal":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SYSTEM-FEATURES-001
            step("Verify: validates true literal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val record = static_assert_case("true literal", true, "expected true")
            check(record.passes())
            check(record.error_message() == "")

        it "validates integer equality":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SYSTEM-FEATURES-002
            step("Verify: validates integer equality")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val record = static_assert_case("integer equality", 1 + 1 == 2, "1 + 1 must equal 2")
            check(record.passes())
            check(record.error_message() == "")

        it "validates boolean operations":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SYSTEM-FEATURES-003
            step("Verify: validates boolean operations")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val record = static_assert_case("boolean operations", true and true, "boolean expression failed")
            check(record.passes())

    context "Type Size Assertions":
        """Validate type sizes at compile time."""

        it "validates primitive type sizes":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SYSTEM-FEATURES-004
            step("Verify: validates primitive type sizes")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val i64_size = 8
            val u32_size = 4
            check(i64_size > u32_size)
            check(i64_size == 8)

        it "validates float sizes":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SYSTEM-FEATURES-005
            step("Verify: validates float sizes")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val f64_size = 8
            val f32_size = 4
            check(f64_size > f32_size)

        it "validates char size":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SYSTEM-FEATURES-006
            step("Verify: validates char size")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val char_size = 4
            check(char_size > 0)

        it "validates bool size":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SYSTEM-FEATURES-007
            step("Verify: validates bool size")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val bool_size = 1
            check(bool_size == 1)

    context "Alignment Assertions":
        """Validate type alignments at compile time."""

        it "validates primitive alignments":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SYSTEM-FEATURES-008
            step("Verify: validates primitive alignments")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val int_align = 8
            check(is_power_of_two(int_align))

        it "validates float alignments":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SYSTEM-FEATURES-009
            step("Verify: validates float alignments")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val float_align = 8
            check(is_power_of_two(float_align))

    context "Custom Error Messages":
        """Static assertions with custom messages."""

        it "uses custom message on failure":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SYSTEM-FEATURES-010
            step("Verify: uses custom message on failure")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val record = static_assert_case("failure", false, "alignment must be a power of two")
            check(record.passes() == false)
            check(record.error_message() == "alignment must be a power of two")

    context "Complex Expressions":
        """Assertions with compound expressions."""

        it "validates compound comparisons":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SYSTEM-FEATURES-011
            step("Verify: validates compound comparisons")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val lhs = 10
            val rhs = 2
            check((lhs + rhs) == 12)
            check((lhs - rhs) == 8)

        it "validates bitwise operations":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SYSTEM-FEATURES-012
            step("Verify: validates bitwise operations")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            check((0xFF xor 0x0F) == 0xF0)
            check((0xF0 & 0x0F) == 0x00)

        it "validates shift operations":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SYSTEM-FEATURES-013
            step("Verify: validates shift operations")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            check((1 << 4) == 16)
            check((16 >> 2) == 4)

    context "Use Cases - Bare Metal":
        """Real-world static assertion use cases."""

        it "validates GDT entry size":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SYSTEM-FEATURES-014
            step("Verify: validates GDT entry size")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val gdt_entry_size = 8
            check(gdt_entry_size == 8)
            check(is_power_of_two(gdt_entry_size))

        it "validates multiboot header alignment":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SYSTEM-FEATURES-015
            step("Verify: validates multiboot header alignment")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val multiboot_header_alignment = 8
            check(is_power_of_two(multiboot_header_alignment))

        it "validates page size":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SYSTEM-FEATURES-016
            step("Verify: validates page size")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val page_size = 4096
            check(is_power_of_two(page_size))

describe "Const Evaluation":
    """Compile-time constant evaluation."""

    context "Arithmetic":
        it "evaluates integer arithmetic":
            # @req: REQ-SYSTEM-FEATURES-017
            step("Verify: evaluates integer arithmetic")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val a = 10
            val b = 3
            expect(a + b).to_equal(13)  # oracle: expected value 13 is the behavior asserted by this regression spec
            expect(a - b).to_equal(7)  # oracle: expected value 7 is the behavior asserted by this regression spec
            expect(a * b).to_equal(30)  # oracle: expected value 30 is the behavior asserted by this regression spec
            expect(a / b).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
            expect(a % b).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "evaluates negative numbers":
            # @req: REQ-SYSTEM-FEATURES-018
            step("Verify: evaluates negative numbers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val neg = -42
            expect(neg).to_equal(-42)  # oracle: expected value -42 is the behavior asserted by this regression spec
            expect(-neg).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

    context "Comparison":
        it "evaluates comparisons":
            # @req: REQ-SYSTEM-FEATURES-019
            step("Verify: evaluates comparisons")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(1 < 2).to_equal(true)
            expect(2 <= 2).to_equal(true)
            expect(3 > 2).to_equal(true)
            expect(3 >= 3).to_equal(true)
            expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            expect(1).to_not_equal(2)

    context "Boolean Logic":
        it "evaluates boolean operations":
            # @req: REQ-SYSTEM-FEATURES-020
            step("Verify: evaluates boolean operations")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(true and true).to_equal(true)
            expect(not (true and false)).to_equal(true)
            expect(false or true).to_equal(true)
            expect(not (false or false)).to_equal(true)
            expect(not false).to_equal(true)
            expect(not (not true)).to_equal(true)

    context "Bitwise Operations":
        it "evaluates bitwise AND":
            # @req: REQ-SYSTEM-FEATURES-021
            step("Verify: evaluates bitwise AND")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect((0xFF & 0x0F)).to_equal(0x0F)

        it "evaluates bitwise OR":
            # @req: REQ-SYSTEM-FEATURES-022
            step("Verify: evaluates bitwise OR")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect((0xF0 | 0x0F)).to_equal(0xFF)

        it "evaluates bitwise XOR":
            # @req: REQ-SYSTEM-FEATURES-023
            step("Verify: evaluates bitwise XOR")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect((0xFF xor 0xF0)).to_equal(0x0F)

        it "evaluates bit shifts":
            # @req: REQ-SYSTEM-FEATURES-024
            step("Verify: evaluates bit shifts")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect((1 << 0)).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            expect((1 << 1)).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
            expect((1 << 4)).to_equal(16)  # oracle: expected value 16 is the behavior asserted by this regression spec
            expect((16 >> 2)).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
            expect((256 >> 4)).to_equal(16)  # oracle: expected value 16 is the behavior asserted by this regression spec
