use std.spec.{fail}
use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode}
use std.gc_async_mut.gpu.browser_engine.dom_identity_index.{
    DomDocumentGeneration, DomIdentityIndex, DomNodeRoute,
    dom_identity_index_build
}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{be_dom_focused_route}
use std.gc_async_mut.web.browser_session.{BrowserSession}

fn system_dom_identity_index(root: BeDomNode) -> DomIdentityIndex:
    val generation = match DomDocumentGeneration.create(1):
        Ok(value): value
        Err(reason): fail("Expected valid DOM generation: {reason}")
    match dom_identity_index_build(root, generation):
        Ok(index): index
        Err(reason): fail("Expected document identity index: {reason}")

fn system_dom_route(
    index: DomIdentityIndex, author_id: text
) -> DomNodeRoute:
    match index.route_for_author_id(author_id):
        Some(route): route
        nil: fail("Expected indexed route for #{author_id}")

fn system_dom_focused_route(
    root: BeDomNode, index: DomIdentityIndex
) -> DomNodeRoute:
    match be_dom_focused_route(root, index):
        Some(route): route
        nil: fail("Expected focused DOM route")

fn system_browser_dom_identity_index(
    session: BrowserSession
) -> DomIdentityIndex:
    match session.current_dom_identity_index():
        Some(index): index
        nil: fail("Expected BrowserSession document identity index")

export system_dom_identity_index, system_dom_route, system_dom_focused_route
export system_browser_dom_identity_index
