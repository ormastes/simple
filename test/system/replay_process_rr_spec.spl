"""
## Purpose and audience
Purpose: creates with Idle mode
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-REPLAY_PROCE-ReplProcRr-001

use std.spec
use std.replay.process.event_types.{ProcessEventKind, ProcessReplayEvent}
use std.replay.process.recorder.{ProcessRecorder, RecordingMode}
use std.replay.process.replayer.{ProcessReplayer, ReplayVerdict}
use std.replay.process.checkpoint.{DirtyPage, RegisterEntry, PageCheckpoint, CheckpointManager}

# ============================================================================
# ProcessRecorder — in-memory stream API (no shell)
# ============================================================================

use std.spec.step
describe "ProcessRecorder creation":
    it "creates with Idle mode":
        step("Verify: creates with Idle mode")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        val rec = ProcessRecorder.create("echo hello", "/tmp/test_trace")
        expect(rec.command).to_equal("echo hello")
        expect(rec.events.len()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(rec.next_seq).to_equal(0)  # oracle: value fixed by the spec contract

    it "on_syscall_enter records entry event":
        step("Verify: on_syscall_enter records entry event")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        var rec = ProcessRecorder.create("cmd", "/tmp/t")
        rec.pid = 100
        rec.on_syscall_enter(1, [42, 0])
        expect(rec.events.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(rec.events[0].payload_a).to_equal(1)  # oracle: value fixed by the spec contract
        expect(rec.next_seq).to_equal(1)  # oracle: value fixed by the spec contract

    it "on_syscall_exit records exit event":
        step("Verify: on_syscall_exit records exit event")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        var rec = ProcessRecorder.create("cmd", "/tmp/t")
        rec.pid = 100
        rec.on_syscall_enter(1, [])
        rec.on_syscall_exit(0)
        expect(rec.events.len()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(rec.next_seq).to_equal(2)  # oracle: value fixed by the spec contract

    it "on_signal records signal event":
        step("Verify: on_signal records signal event")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        var rec = ProcessRecorder.create("cmd", "/tmp/t")
        rec.pid = 200
        rec.on_signal(9)
        expect(rec.events.len()).to_equal(1)  # oracle: value fixed by the spec contract
        val kind = ProcessEventKind.from_i32(rec.events[0].kind)
        expect(kind.to_text()).to_equal("signal")

    it "sequence numbers are monotonic across mixed events":
        step("Verify: sequence numbers are monotonic across mixed events")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        var rec = ProcessRecorder.create("cmd", "/tmp/t")
        rec.pid = 50
        rec.on_syscall_enter(1, [])
        rec.on_syscall_exit(0)
        rec.on_signal(15)
        expect(rec.events[0].seq).to_equal(0)  # oracle: value fixed by the spec contract
        expect(rec.events[1].seq).to_equal(1)  # oracle: value fixed by the spec contract
        expect(rec.events[2].seq).to_equal(2)  # oracle: value fixed by the spec contract

# ============================================================================
# ProcessReplayer — in-memory stepping
# ============================================================================

describe "ProcessReplayer stepping":
    it "create starts at position 0":
        step("Verify: create starts at position 0")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        val rpl = ProcessReplayer.create("/tmp/trace")
        expect(rpl.position()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(rpl.event_count()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(rpl.has_more()).to_equal(false)

    it "has_more is true when events exist":
        step("Verify: has_more is true when events exist")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        var rpl = ProcessReplayer.create("/tmp/trace")
        val ev = ProcessReplayEvent.syscall_exit(0, 1, 0, 42)
        rpl.events = [ev]
        expect(rpl.has_more()).to_equal(true)
        expect(rpl.event_count()).to_equal(1)  # oracle: value fixed by the spec contract

    it "step_forward returns None at end":
        step("Verify: step_forward returns None at end")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        var rpl = ProcessReplayer.create("/tmp/trace")
        val result = rpl.step_forward()
        expect(result.is_none()).to_equal(true)

    it "step_forward advances cursor and returns result":
        step("Verify: step_forward advances cursor and returns result")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        var rpl = ProcessReplayer.create("/tmp/trace")
        val ev0 = ProcessReplayEvent.syscall_exit(0, 1, 0, 10)
        val ev1 = ProcessReplayEvent.syscall_exit(1, 1, 0, 20)
        rpl.events = [ev0, ev1]
        val first = rpl.step_forward()
        match first:
            case Some(r):
                expect(r.event_seq).to_equal(0)  # oracle: value fixed by the spec contract
            case None:
                expect("should have result").to_equal("")
        expect(rpl.position()).to_equal(1)  # oracle: value fixed by the spec contract

    it "current_event returns event without advancing":
        step("Verify: current_event returns event without advancing")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        var rpl = ProcessReplayer.create("/tmp/trace")
        val ev = ProcessReplayEvent.signal_event(0, 10, 0, 9)
        rpl.events = [ev]
        val cur = rpl.current_event()
        match cur:
            case Some(e):
                expect(e.payload_a).to_equal(9)  # oracle: value fixed by the spec contract
            case None:
                expect("should have event").to_equal("")
        expect(rpl.position()).to_equal(0)  # oracle: value fixed by the spec contract

    it "event_at returns event by index":
        step("Verify: event_at returns event by index")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        var rpl = ProcessReplayer.create("/tmp/trace")
        val ev0 = ProcessReplayEvent.syscall_exit(0, 1, 0, 10)
        val ev1 = ProcessReplayEvent.syscall_exit(1, 1, 0, 20)
        rpl.events = [ev0, ev1]
        match rpl.event_at(1):
            case Some(e):
                expect(e.payload_a).to_equal(20)  # oracle: value fixed by the spec contract
            case None:
                expect("should have event").to_equal("")

# ============================================================================
# CheckpointManager
# ============================================================================

describe "CheckpointManager":
    it "starts with zero checkpoints":
        step("Verify: starts with zero checkpoints")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        val mgr = CheckpointManager.create()
        expect(mgr.count()).to_equal(0)  # oracle: value fixed by the spec contract

    it "create initializes next_id to 0":
        step("Verify: create initializes next_id to 0")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        val mgr = CheckpointManager.create()
        expect(mgr.next_id).to_equal(0)  # oracle: value fixed by the spec contract
        expect(mgr.checkpoints.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "take_checkpoint increments next_id":
        step("Verify: take_checkpoint increments next_id")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        var mgr = CheckpointManager.create()
        val cp = mgr.take_checkpoint(100)
        expect(cp.checkpoint_id).to_equal(0)  # oracle: value fixed by the spec contract
        expect(mgr.next_id).to_equal(1)  # oracle: value fixed by the spec contract
        expect(mgr.count()).to_equal(1)  # oracle: value fixed by the spec contract

    it "find_checkpoint returns None on empty manager":
        step("Verify: find_checkpoint returns None on empty manager")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        val mgr = CheckpointManager.create()
        val result = mgr.find_checkpoint(0)
        expect(result.is_none()).to_equal(true)

    it "nearest_before returns None on empty manager":
        step("Verify: nearest_before returns None on empty manager")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        val mgr = CheckpointManager.create()
        val result = mgr.nearest_before(100)
        expect(result.is_none()).to_equal(true)

    it "nearest_before returns closest checkpoint":
        step("Verify: nearest_before returns closest checkpoint")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        var mgr = CheckpointManager.create()
        mgr.take_checkpoint(10)
        mgr.take_checkpoint(50)
        mgr.take_checkpoint(100)
        val result = mgr.nearest_before(60)
        match result:
            case Some(cp):
                expect(cp.event_seq).to_equal(50)  # oracle: value fixed by the spec contract
            case None:
                expect("should find checkpoint").to_equal("")

    it "latest returns None on empty manager":
        step("Verify: latest returns None on empty manager")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        val mgr = CheckpointManager.create()
        val result = mgr.latest()
        expect(result.is_none()).to_equal(true)

# ============================================================================
# DirtyPage / PageCheckpoint construction (process-level)
# ============================================================================

describe "DirtyPage and PageCheckpoint":
    it "DirtyPage.create stores addr and data":
        step("Verify: DirtyPage.create stores addr and data")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        val page = DirtyPage.create(4096, [0, 1, 2, 3])
        expect(page.addr).to_equal(4096)  # oracle: value fixed by the spec contract
        expect(page.data.len()).to_equal(4)  # oracle: value fixed by the spec contract

    it "PageCheckpoint add_register stores value":
        step("Verify: PageCheckpoint add_register stores value")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        var cp = PageCheckpoint.create(0, 100)
        cp.add_register("rip", 12345)
        match cp.get_register("rip"):
            case Some(v):
                expect(v).to_equal(12345)  # oracle: value fixed by the spec contract
            case None:
                expect("should find register").to_equal("")

    it "PageCheckpoint get_register returns None for missing":
        step("Verify: PageCheckpoint get_register returns None for missing")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        val cp = PageCheckpoint.create(0, 0)
        val result = cp.get_register("nonexistent")
        expect(result.is_none()).to_equal(true)

    it "PageCheckpoint.create_for_pid stores pid":
        step("Verify: PageCheckpoint.create_for_pid stores pid")
        # @req: REQ-REPLAY_PROCE-ReplProcRr-001
        val cp = PageCheckpoint.create_for_pid(1, 500, 9999)
        expect(cp.pid).to_equal(9999)  # oracle: value fixed by the spec contract
        expect(cp.event_seq).to_equal(500)  # oracle: value fixed by the spec contract
