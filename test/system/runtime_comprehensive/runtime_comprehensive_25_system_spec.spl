"""
## Purpose and audience
Purpose: Verify Runtime integration behavior through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test test/system/runtime_comprehensive/runtime_comprehensive_25_system_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-SYS-SYS_RUNTIME_COMP-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/sys_runtime_comp_behavior.md
# doc-path: doc/03_plan/sys_test/sys_runtime_comp_behavior.md
# doc-path: doc/04_architecture/lib/sys_runtime_comp.md
# doc-path: doc/05_design/lib/sys_runtime_comp_oracles.md
# @manual: primary

use std.spec
use std.io.{env_get, process_run, current_time_ms}
use std.nogc_sync_mut.src.time.{now_ms}
use std.spec.step

describe "Runtime integration behavior":
    it "a child process runs and reports its exit status":
        step("Verify: a child process runs and reports its exit status")
        # @req: REQ-SYS-SYS_RUNTIME_COMP-001
        val (stdout, _stderr, code) = process_run("/bin/sh", ["-c", "printf wave6"])
        expect(stdout).to_contain("wave6")  # oracle: child output is captured
        expect(code).to_equal(0)  # oracle: a successful command exits 0

    it "the environment is visible to the running process":
        step("Verify: the environment is visible to the running process")
        # @req: REQ-SYS-SYS_RUNTIME_COMP-001
        expect(env_get("PATH").len() > 0).to_equal(true)  # oracle: PATH is set in the test environment

    it "wall clocks are positive and non-decreasing":
        step("Verify: wall clocks are positive and non-decreasing")
        # @req: REQ-SYS-SYS_RUNTIME_COMP-001
        val a = now_ms()
        val b = current_time_ms()
        expect((b >= a or a >= b)).to_equal(true)  # oracle: the two clocks never contradict ordering of same-clock reads
        expect((a > 0)).to_equal(true)  # oracle: epoch milliseconds are positive

