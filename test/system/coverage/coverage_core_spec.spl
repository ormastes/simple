"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-COVERAGE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/coverage/coverage_core_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-COVERAGE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/compiler/90.tools/coverage.spl 80%
# @req REQ-coverage-core
# @feature coverage_instrumentation
# tag: system
#
# System tests for coverage instrumentation (compiler/90.tools/coverage.spl).
# Validates CoverageStats, CoverageCollector, and data structs.
# Requires compiled mode -- interpreter only verifies file loading.
"""
# Coverage Core Specification

**Feature IDs:** #COV-001 through #COV-025
**Category:** Tooling
**Difficulty:** 2/5
**Status:** Implemented
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A

## Overview

The coverage core module provides line, branch, and function coverage
tracking during test execution. CoverageCollector records hit lines
and function calls; CoverageStats computes ratios; data structs
(SourceLoc, FunctionCoverage, ModuleCoverage, CoverageReport) carry
the results.

## Key Concepts

| Concept           | Description                                      |
|-------------------|--------------------------------------------------|
| CoverageCollector | Mutable recorder of line hits and function calls  |
| CoverageStats     | Computed coverage ratios (line, branch, function) |
| CoverageReport    | Top-level report aggregating module coverages     |

## Behavior

- CoverageStats.empty() returns all-zero counters
- Coverage ratios return 0.0 when denominators are zero (no division by zero)
- CoverageCollector deduplicates line hits per file
- Function call counts increment on repeated calls
- clear() resets collector to empty state
- to_sdn() serialises collector state to SDN text
"""

use std.spec
use compiler.tools.coverage.{SourceLoc, FunctionCoverage, ModuleCoverage, CoverageStats, CoverageCollector, CoverageReport}


# ============================================================================
# CoverageStats
# ============================================================================

describe "CoverageStats":

    context "empty()":
        it "returns all zeros":
            # @req: REQ-SYSTEM-COVERAGE-001 REQ-coverage-core
            step("Verify: returns all zeros")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = CoverageStats.empty()
            expect(s.lines_hit).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(s.lines_total).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(s.branches_hit).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(s.branches_total).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(s.functions_hit).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(s.functions_total).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    context "line_coverage()":
        it "returns 0.0 when lines_total is 0":
            # @req: REQ-SYSTEM-COVERAGE-002
            step("Verify: returns 0.0 when lines_total is 0")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = CoverageStats.empty()
            expect(s.line_coverage()).to_equal(0.0)

        it "computes ratio when lines exist":
            # @req: REQ-SYSTEM-COVERAGE-003
            step("Verify: computes ratio when lines exist")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = CoverageStats(lines_hit: 5, lines_total: 10,
                                   branches_hit: 0, branches_total: 0,
                                   functions_hit: 0, functions_total: 0)
            expect(s.line_coverage()).to_equal(0.5)

    context "branch_coverage()":
        it "returns 0.0 when branches_total is 0":
            # @req: REQ-SYSTEM-COVERAGE-004
            step("Verify: returns 0.0 when branches_total is 0")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = CoverageStats.empty()
            expect(s.branch_coverage()).to_equal(0.0)

        it "computes ratio with data":
            # @req: REQ-SYSTEM-COVERAGE-005
            step("Verify: computes ratio with data")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = CoverageStats(lines_hit: 0, lines_total: 0,
                                   branches_hit: 3, branches_total: 4,
                                   functions_hit: 0, functions_total: 0)
            expect(s.branch_coverage()).to_equal(0.75)

    context "function_coverage()":
        it "returns 0.0 when functions_total is 0":
            # @req: REQ-SYSTEM-COVERAGE-006
            step("Verify: returns 0.0 when functions_total is 0")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = CoverageStats.empty()
            expect(s.function_coverage()).to_equal(0.0)

        it "computes ratio with data":
            # @req: REQ-SYSTEM-COVERAGE-007
            step("Verify: computes ratio with data")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = CoverageStats(lines_hit: 0, lines_total: 0,
                                   branches_hit: 0, branches_total: 0,
                                   functions_hit: 2, functions_total: 5)
            expect(s.function_coverage()).to_equal(0.4)


# ============================================================================
# CoverageCollector
# ============================================================================

describe "CoverageCollector":

    context "create()":
        it "makes empty collector":
            # @req: REQ-SYSTEM-COVERAGE-008
            step("Verify: makes empty collector")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val c = CoverageCollector.create()
            val files = c.executed_files()
            expect(files.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    context "record_line":
        it "creates entry for new file":
            # @req: REQ-SYSTEM-COVERAGE-009
            step("Verify: creates entry for new file")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var c = CoverageCollector.create()
            c.record_line("main.spl", 10)
            val files = c.executed_files()
            expect(files.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            expect(files).to_contain("main.spl")

        it "adds line to existing file":
            # @req: REQ-SYSTEM-COVERAGE-010
            step("Verify: adds line to existing file")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var c = CoverageCollector.create()
            c.record_line("main.spl", 10)
            c.record_line("main.spl", 20)
            val s = c.stats()
            expect(s.lines_hit).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

        it "ignores duplicate line numbers":
            # @req: REQ-SYSTEM-COVERAGE-011
            step("Verify: ignores duplicate line numbers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var c = CoverageCollector.create()
            c.record_line("main.spl", 10)
            c.record_line("main.spl", 10)
            val s = c.stats()
            expect(s.lines_hit).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    context "record_function_call":
        it "records first call with count 1":
            # @req: REQ-SYSTEM-COVERAGE-012
            step("Verify: records first call with count 1")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var c = CoverageCollector.create()
            c.record_function_call("foo")
            expect(c.was_function_called("foo")).to_equal(true)

        it "increments on second call":
            # @req: REQ-SYSTEM-COVERAGE-013
            step("Verify: increments on second call")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var c = CoverageCollector.create()
            c.record_function_call("bar")
            c.record_function_call("bar")
            # After two calls the function is still called
            expect(c.was_function_called("bar")).to_equal(true)
            # Stats should count exactly 1 distinct function
            val s = c.stats()
            expect(s.functions_total).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            expect(s.functions_hit).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    context "was_function_called":
        it "returns true for called function":
            # @req: REQ-SYSTEM-COVERAGE-014
            step("Verify: returns true for called function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var c = CoverageCollector.create()
            c.record_function_call("do_thing")
            expect(c.was_function_called("do_thing")).to_equal(true)

        it "returns false for uncalled function":
            # @req: REQ-SYSTEM-COVERAGE-015
            step("Verify: returns false for uncalled function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val c = CoverageCollector.create()
            expect(c.was_function_called("never_called")).to_equal(false)

    context "executed_files":
        it "returns empty list for fresh collector":
            # @req: REQ-SYSTEM-COVERAGE-016
            step("Verify: returns empty list for fresh collector")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val c = CoverageCollector.create()
            expect(c.executed_files().len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "returns recorded file paths":
            # @req: REQ-SYSTEM-COVERAGE-017
            step("Verify: returns recorded file paths")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var c = CoverageCollector.create()
            c.record_line("a.spl", 1)
            c.record_line("b.spl", 5)
            val files = c.executed_files()
            expect(files.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
            expect(files).to_contain("a.spl")
            expect(files).to_contain("b.spl")

    context "stats()":
        it "computes real statistics":
            # @req: REQ-SYSTEM-COVERAGE-018
            step("Verify: computes real statistics")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var c = CoverageCollector.create()
            c.record_line("a.spl", 1)
            c.record_line("a.spl", 2)
            c.record_line("a.spl", 3)
            c.record_function_call("foo")
            c.record_function_call("bar")
            val s = c.stats()
            expect(s.lines_hit).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
            expect(s.lines_total).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
            expect(s.functions_hit).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
            expect(s.functions_total).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

        it "returns zeros on empty collector":
            # @req: REQ-SYSTEM-COVERAGE-019
            step("Verify: returns zeros on empty collector")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val c = CoverageCollector.create()
            val s = c.stats()
            expect(s.lines_hit).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(s.lines_total).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(s.functions_hit).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(s.functions_total).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(s.branches_hit).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(s.branches_total).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    context "clear()":
        it "resets all state":
            # @req: REQ-SYSTEM-COVERAGE-020
            step("Verify: resets all state")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var c = CoverageCollector.create()
            c.record_line("a.spl", 1)
            c.record_function_call("foo")
            c.clear()
            expect(c.executed_files().len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(c.was_function_called("foo")).to_equal(false)
            val s = c.stats()
            expect(s.lines_hit).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(s.functions_total).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    context "to_sdn()":
        it "returns header on empty collector":
            # @req: REQ-SYSTEM-COVERAGE-021
            step("Verify: returns header on empty collector")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val c = CoverageCollector.create()
            val sdn = c.to_sdn()
            expect(sdn).to_start_with("coverage:")

        it "includes file info and function calls with data":
            # @req: REQ-SYSTEM-COVERAGE-022
            step("Verify: includes file info and function calls with data")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var c = CoverageCollector.create()
            c.record_line("main.spl", 5)
            c.record_function_call("init")
            val sdn = c.to_sdn()
            expect(sdn).to_contain("main.spl")
            expect(sdn).to_contain("init")
            expect(sdn).to_contain("1 calls")


# ============================================================================
# Data Structs
# ============================================================================

describe "Coverage data structs":

    context "SourceLoc":
        it "can be constructed with file, line, column":
            # @req: REQ-SYSTEM-COVERAGE-023
            step("Verify: can be constructed with file, line, column")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val loc = SourceLoc(file: "test.spl", line: 42, column: 8)
            expect(loc.file).to_equal("test.spl")
            expect(loc.line).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec
            expect(loc.column).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

    context "FunctionCoverage":
        it "can be constructed with coverage data":
            # @req: REQ-SYSTEM-COVERAGE-024
            step("Verify: can be constructed with coverage data")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val fc = FunctionCoverage(name: "my_func",
                                       lines_hit: 10, lines_total: 15,
                                       branches_hit: 3, branches_total: 6)
            expect(fc.name).to_equal("my_func")
            expect(fc.lines_hit).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec
            expect(fc.lines_total).to_equal(15)  # oracle: expected value 15 is the behavior asserted by this regression spec
            expect(fc.branches_hit).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
            expect(fc.branches_total).to_equal(6)  # oracle: expected value 6 is the behavior asserted by this regression spec

    context "ModuleCoverage":
        it "can be constructed with name and functions list":
            # @req: REQ-SYSTEM-COVERAGE-025
            step("Verify: can be constructed with name and functions list")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val fc = FunctionCoverage(name: "f", lines_hit: 1, lines_total: 2,
                                       branches_hit: 0, branches_total: 0)
            val mc = ModuleCoverage(name: "my_mod", functions: [fc])
            expect(mc.name).to_equal("my_mod")
            expect(mc.functions.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    context "CoverageReport":
        it "can be constructed with modules and stats":
            # @req: REQ-SYSTEM-COVERAGE-026
            step("Verify: can be constructed with modules and stats")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val stats = CoverageStats.empty()
            val report = CoverageReport(modules: [], stats: stats)
            expect(report.modules.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(report.stats.lines_hit).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
