"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-GENERATED behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/generated/comparison_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-SYSTEM-GENERATED-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%
val NL = "\n"

# Snapshot Testing Framework - Comparison Tests
"""
Tests for snapshot comparison functionality including content matching,
diff generation, output formatting, and context line handling for
displaying differences between actual and expected snapshots.
"""

describe "Snapshot Comparison":
    """
    Verifies the comparison engine that detects differences between
    actual output and stored snapshots, generating readable diffs.
    """
    context "Basic Comparison":
        it "matches identical content":
            # @req: REQ-SYSTEM-GENERATED-001
            step("Verify: matches identical content")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val actual = "Hello World"
            val expected = "Hello World"
            expect(actual).to_equal(expected)

        it "detects content differences":
            # @req: REQ-SYSTEM-GENERATED-002
            step("Verify: detects content differences")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val actual = "Hello World"
            val expected = "Hello World!"
            expect(actual).to_not_equal(expected)

        it "ignores whitespace differences when configured":
            # @req: REQ-SYSTEM-GENERATED-003
            step("Verify: ignores whitespace differences when configured")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val content1 = "hello  world"
            val content2 = "hello world"
            # Different but could be normalized
            expect(content1).to_not_equal(content2)

    context "Diff Generation":
        it "generates diff for changed lines":
            # @req: REQ-SYSTEM-GENERATED-004
            step("Verify: generates diff for changed lines")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val line1 = "old line"
            val line2 = "new line"
            expect(line1).to_not_equal(line2)

        it "handles multiline diffs":
            # @req: REQ-SYSTEM-GENERATED-005
            step("Verify: handles multiline diffs")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val text1 = "line 1{NL}line 2{NL}line 3"
            val text2 = "line 1{NL}line 2{NL}line 3"
            expect(text1).to_equal(text2)

        it "marks added lines":
            # @req: REQ-SYSTEM-GENERATED-006
            step("Verify: marks added lines")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val original_length = 3
            val new_length = 4
            expect(new_length > original_length).to_equal(true)

        it "marks removed lines":
            # @req: REQ-SYSTEM-GENERATED-007
            step("Verify: marks removed lines")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val original_length = 4
            val new_length = 3
            expect(new_length < original_length).to_equal(true)

    context "Formatting":
        it "formats comparison result":
            # @req: REQ-SYSTEM-GENERATED-008
            step("Verify: formats comparison result")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = "Match"
            expect(result).to_equal("Match")

        it "shows unified diff format":
            # @req: REQ-SYSTEM-GENERATED-009
            step("Verify: shows unified diff format")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val diff_format = "unified"
            expect(diff_format).to_equal("unified")

        it "shows side-by-side format":
            # @req: REQ-SYSTEM-GENERATED-010
            step("Verify: shows side-by-side format")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val diff_format = "side-by-side"
            expect(diff_format).to_equal("side-by-side")

    context "Context Lines":
        it "includes context around changes":
            # @req: REQ-SYSTEM-GENERATED-011
            step("Verify: includes context around changes")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val context_size = 3
            expect(context_size > 0).to_equal(true)

        it "handles edge cases at file start":
            # @req: REQ-SYSTEM-GENERATED-012
            step("Verify: handles edge cases at file start")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val line_number = 1
            expect(line_number >= 1).to_equal(true)

        it "handles edge cases at file end":
            # @req: REQ-SYSTEM-GENERATED-013
            step("Verify: handles edge cases at file end")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val total_lines = 100
            val line_number = 100
            expect(line_number <= total_lines).to_equal(true)
