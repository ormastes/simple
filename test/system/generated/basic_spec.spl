"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-GENERATED behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/generated/basic_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-SYSTEM-GENERATED-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%
# Snapshot Testing Framework - Basic Tests
"""
Tests for the snapshot testing framework's basic functionality including
metadata storage, content comparison, supported formats, path generation,
and update mode handling.
"""

describe "Snapshot Testing Framework":
    """
    Verifies core snapshot testing capabilities for storing test outputs
    and comparing them against expected values across test runs.
    """
    context "Snapshot Metadata":
        it "stores snapshot name":
            # @req: REQ-SYSTEM-GENERATED-001
            step("Verify: stores snapshot name")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val test_name = "test_render"
            expect(test_name).to_equal("test_render")

        it "stores snapshot format":
            # @req: REQ-SYSTEM-GENERATED-002
            step("Verify: stores snapshot format")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val format = "text"
            expect(format).to_equal("text")

        it "stores snapshot content":
            # @req: REQ-SYSTEM-GENERATED-003
            step("Verify: stores snapshot content")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val content = "Hello World"
            expect(content).to_equal("Hello World")

    context "Snapshot Comparison":
        it "identifies matching content":
            # @req: REQ-SYSTEM-GENERATED-004
            step("Verify: identifies matching content")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val content1 = "same content"
            val content2 = "same content"
            expect(content1).to_equal(content2)

        it "identifies different content":
            # @req: REQ-SYSTEM-GENERATED-005
            step("Verify: identifies different content")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val content1 = "content A"
            val content2 = "content B"
            expect(content1).to_not_equal(content2)

    context "Snapshot Formats":
        it "supports text format":
            # @req: REQ-SYSTEM-GENERATED-006
            step("Verify: supports text format")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val format = "text"
            expect(format).to_equal("text")

        it "supports json format":
            # @req: REQ-SYSTEM-GENERATED-007
            step("Verify: supports json format")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val format = "json"
            expect(format).to_equal("json")

        it "supports yaml format":
            # @req: REQ-SYSTEM-GENERATED-008
            step("Verify: supports yaml format")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val format = "yaml"
            expect(format).to_equal("yaml")

    context "Snapshot Paths":
        it "generates snapshot path":
            # @req: REQ-SYSTEM-GENERATED-009
            step("Verify: generates snapshot path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val test_file = "test/example_spec.spl"
            val test_name = "test_render"
            val expected_contains = "example_spec"
            expect(test_file.contains(expected_contains)).to_equal(true)
            expect(test_name).to_equal("test_render")

    context "Snapshot Updates":
        it "marks snapshot for update":
            # @req: REQ-SYSTEM-GENERATED-010
            step("Verify: marks snapshot for update")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val should_update = true
            expect(should_update).to_equal(true)

        it "skips update when disabled":
            # @req: REQ-SYSTEM-GENERATED-011
            step("Verify: skips update when disabled")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val should_update = false
            expect(should_update).to_equal(false)
