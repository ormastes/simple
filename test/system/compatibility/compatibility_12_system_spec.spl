"""
## Purpose and audience
Pins observable outcomes of the system system lane
(compatibility_12_system_spec.spl): every scenario asserts a concrete language/stdlib result the runner
must report green before the lane can be trusted as a smoke signal.
Audience: compiler and test-infrastructure engineers triaging system runs.
## Operator workflow
Run `bin/simple test test/system/compatibility/compatibility_12_system_spec.spl` and read the per-scenario verdicts in the
`Results:` summary; each scenario asserts one externally visible outcome.
## Compatibility and limitations
Covers interpreter-path semantics exercised by this lane; native codegen
and performance envelopes are out of scope.
# @manual: primary
REQ-SYS-SYSTEM-001
doc/01_research/local/system_lane.md
doc/03_plan/sys_test/system_lane.md
doc/04_architecture/system_lane.md
doc/05_design/system_lane.md
"""
# @req: REQ-SYS-SYSTEM-001
# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%

use std.spec

describe "system system lane execution contract":
    it "dict lookup returns the stored value per key":
        step("Verify: dict lookup returns the stored value per key")
        # @req: REQ-SYS-SYSTEM-001
        val d = {"alpha": 1, "beta": 2}
        expect(d["beta"]).to_equal(2) # oracle: value stored under "beta"
        expect(d["alpha"]).to_equal(1)

    it "repetition via loop builds the expected run":
        step("Verify: repetition via loop builds the expected run")
        # @req: REQ-SYS-SYSTEM-002
        var run = ""
        for i in 0..4:
            run = run + "ab"
        expect(run.len()).to_equal(8) # oracle: 4 iterations x 2 chars
        expect(run).to_equal("abababab")

    it "array push grows length and preserves order":
        step("Verify: array push grows length and preserves order")
        # @req: REQ-SYS-SYSTEM-003
        var xs = [10]
        xs.push(20)
        xs.push(30)
        expect(xs.len()).to_equal(3) # oracle: 1 initial + 2 pushes
        expect(xs[1]).to_equal(20) # oracle: FIFO order preserved

    it "recursive factorial computes 5! exactly":
        step("Verify: recursive factorial computes 5! exactly")
        # @req: REQ-SYS-SYSTEM-004
        fn fact(n: i64) -> i64:
            if n <= 1:
                return 1
            n * fact(n - 1)
        expect(fact(5)).to_equal(120) # oracle: 5! = 120
        expect(fact(0)).to_equal(1) # oracle: base case

    it "arithmetic precedence binds multiplication before addition":
        step("Verify: arithmetic precedence binds multiplication before addition")
        # @req: REQ-SYS-SYSTEM-005
        expect(2 + 3 * 4).to_equal(14) # oracle: precedence, not left-to-right (would be 20)
        expect((2 + 3) * 4).to_equal(20) # oracle: parenthesised grouping

