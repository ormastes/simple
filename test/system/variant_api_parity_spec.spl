# @cover src/lib/nogc_sync_mut/simd.spl 80%
# @cover src/lib/common/encoding/utf8.spl 80%
# @cover src/lib/common/aes/cipher.spl 80%
# @tag:system
#
# Portable smoke for lib variant API parity.
#
# Full variant imports can load duplicate experimental torch/GPU impls in the
# interpreted system lane. Focused unit specs should cover each variant; this
# system spec exercises the shared SIMD facade across all three variants.

use std.spec.*
use std.gc_async_mut.simd as gc_simd
use std.nogc_async_mut.simd as async_simd
use std.nogc_sync_mut.simd as sync_simd
use std.common.encoding.utf8.{text_codepoint_len, utf8_count_codepoints}
use std.common.aes.cipher.{aes_decrypt_block, aes_encrypt_block}
use std.common.aes.utilities.{bytes_to_hex, hex_to_bytes}

describe "Variant API parity portable smoke":
    it "keeps SIMD profile and capabilities identical across runtime variants":
        expect(gc_simd.profile_name()).to_equal(sync_simd.profile_name())
        expect(async_simd.profile_name()).to_equal(sync_simd.profile_name())
        expect(gc_simd.detect_profile()).to_equal(sync_simd.detect_profile())
        expect(async_simd.detect_profile()).to_equal(sync_simd.detect_profile())
        expect(gc_simd.has_rvv()).to_equal(sync_simd.has_rvv())
        expect(async_simd.has_rvv()).to_equal(sync_simd.has_rvv())
        expect(gc_simd.simd_width()).to_equal(sync_simd.simd_width())
        expect(async_simd.simd_width()).to_equal(sync_simd.simd_width())

    it "keeps the shared utf8 facade available":
        val bytes = [0x41, 0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80]
        expect(utf8_count_codepoints(bytes)).to_equal(3)
        expect(text_codepoint_len("A€😀")).to_equal(3)

    it "keeps the shared aes facade available":
        val key = hex_to_bytes("000102030405060708090a0b0c0d0e0f")
        val plaintext = hex_to_bytes("00112233445566778899aabbccddeeff")
        val ciphertext = aes_encrypt_block(plaintext, key)
        expect(bytes_to_hex(ciphertext)).to_equal("69c4e0d86a7b0430d8cdb78070b4c55a")
        expect(aes_decrypt_block(ciphertext, key)).to_equal(plaintext)
