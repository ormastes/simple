# Platform Capsule Tests — AC-4
#
# Verifies that all four SimpleOS RV64 FPGA platform capsule files exist under
# the correct module path AND declare their capsule surface as real code.
# Build-time source checks; no hardware required.
#
# 2026-08-10: rewritten. Every assertion here previously compared a literal the
# spec itself had just written ("expect(path).to_contain(\"riscv64\")"), so the
# whole file was green even if the capsule directory did not exist. Assertions
# now read the product files and anchor on declaration syntax (`fn name(`,
# `struct Name:`), which a comment mentioning the name cannot satisfy.

extern fn rt_file_read_text(path: text) -> text

val PLATFORM_DIR = "src/os/kernel/arch/riscv64/platform"

fn capsule_source(basename: text) -> text:
    rt_file_read_text("{PLATFORM_DIR}/{basename}") ?? ""

describe "Platform Capsule - fpga.spl (AC-4)":
    it "fpga.spl exists in the riscv64 platform capsule":
        val src = capsule_source("fpga.spl")
        expect(src.len()).to_be_greater_than(0)

    it "fpga.spl declares the platform init entry point":
        val src = capsule_source("fpga.spl")
        expect(src).to_contain("fn fpga_platform_init():")

describe "Platform Capsule - manifest.spl (AC-4)":
    it "manifest.spl exists in the riscv64 platform capsule":
        val src = capsule_source("manifest.spl")
        expect(src.len()).to_be_greater_than(0)

    it "manifest.spl declares BoardConfig and its loaders":
        val src = capsule_source("manifest.spl")
        expect(src).to_contain("struct BoardConfig:")
        expect(src).to_contain("fn default_board_config() -> BoardConfig:")
        expect(src).to_contain("fn load_board_config() -> BoardConfig:")

describe "Platform Capsule - uart_mmio.spl (AC-4)":
    it "uart_mmio.spl exists in the riscv64 platform capsule":
        val src = capsule_source("uart_mmio.spl")
        expect(src.len()).to_be_greater_than(0)

    it "uart_mmio.spl declares the MMIO UART surface":
        val src = capsule_source("uart_mmio.spl")
        expect(src).to_contain("fn uart_mmio_init(base: u64, baud: u64):")
        expect(src).to_contain("fn uart_mmio_putchar(base: u64, ch: u8):")
        expect(src).to_contain("fn uart_mmio_puts(base: u64, msg: text):")

describe "Platform Capsule - timer_mmio.spl (AC-4)":
    it "timer_mmio.spl exists in the riscv64 platform capsule":
        val src = capsule_source("timer_mmio.spl")
        expect(src.len()).to_be_greater_than(0)

    it "timer_mmio.spl declares the CLINT timer surface":
        val src = capsule_source("timer_mmio.spl")
        expect(src).to_contain("fn timer_mmio_init(clint_base: u64):")
        expect(src).to_contain("fn timer_read_mtime(clint_base: u64) -> u64:")
        expect(src).to_contain("fn timer_polling_delay_ms(clint_base: u64, timebase_hz: u64, ms: u64):")

describe "Platform Capsule - Module Count (AC-4)":
    it "all four required capsule files are present and non-empty":
        val files = ["fpga.spl", "manifest.spl", "uart_mmio.spl", "timer_mmio.spl"]
        expect(files.len()).to_equal(4)
        var present = 0
        for f in files:
            if capsule_source(f).len() > 0:
                present = present + 1
        expect(present).to_equal(4)
