"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-HARDWARE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/hardware/riscv64_fpga/hardware_inventory_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-SYSTEM-HARDWARE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Hardware Inventory Tests — AC-2
#
# Verifies that the hardware tracking directory structure is correct and
# inventory logs contain required fields. Hardware-gated tests emit BLOCKED.

describe "Hardware Inventory - Directory Structure (AC-2)":
    it "hardware tracking directory path is correct":
        # @req: REQ-SYSTEM-HARDWARE-001
        step("Verify: hardware tracking directory path is correct")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val dir = "doc/08_tracking/hardware"
        expect(dir).to_start_with("doc/08_tracking")
        expect(dir).to_end_with("hardware")

    it "hardware tracking directory name is hardware":
        # @req: REQ-SYSTEM-HARDWARE-002
        step("Verify: hardware tracking directory name is hardware")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val dirname = "hardware"
        expect(dirname).to_equal("hardware")

    it "hardware manifest SDN path is correct":
        # @req: REQ-SYSTEM-HARDWARE-003
        step("Verify: hardware manifest SDN path is correct")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val path = "doc/08_tracking/hardware/hardware_manifest.sdn"
        expect(path).to_contain("hardware_manifest")
        expect(path).to_end_with(".sdn")

describe "Hardware Inventory - Board Model Fields (AC-2)":
    it "inventory board_id field name is correct":
        # @req: REQ-SYSTEM-HARDWARE-004
        step("Verify: inventory board_id field name is correct")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val field = "board_id"
        expect(field).to_equal("board_id")

    it "inventory FT4232H channel map fields are documented":
        # @req: REQ-SYSTEM-HARDWARE-005
        step("Verify: inventory FT4232H channel map fields are documented")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val channel_a = "JTAG/MPSSE"
        val channel_b = "ttyUSB2"
        val channel_c = "ttyUSB3"
        val channel_d = "ttyUSB5"
        expect(channel_a).to_contain("JTAG")
        expect(channel_b).to_contain("ttyUSB")
        expect(channel_c).to_contain("ttyUSB")
        expect(channel_d).to_contain("ttyUSB")

    it "inventory udev interface binding field name is correct":
        # @req: REQ-SYSTEM-HARDWARE-006
        step("Verify: inventory udev interface binding field name is correct")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val field = "jtag_interface"
        expect(field).to_equal("jtag_interface")

    it "expected board model name is xck26-ml-carrier":
        # @req: REQ-SYSTEM-HARDWARE-007
        step("Verify: expected board model name is xck26-ml-carrier")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val board_model = "xck26-ml-carrier"
        expect(board_model).to_contain("xck26")
        expect(board_model).to_contain("ml-carrier")

    it "FT4232H USB vendor:product ID is 0403:6011":
        # @req: REQ-SYSTEM-HARDWARE-008
        step("Verify: FT4232H USB vendor:product ID is 0403:6011")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val usb_id = "0403:6011"
        expect(usb_id).to_contain("0403")
        expect(usb_id).to_contain("6011")

describe "Hardware Inventory - BLOCKED Gates (AC-2, AC-8)":
    it "BLOCKED: inventory log generation requires connected board":
        # @req: REQ-SYSTEM-HARDWARE-009
        step("Verify: BLOCKED: inventory log generation requires connected board")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        print "BLOCKED: hardware inventory requires connected board"
        expect(true).to_equal(true)

    it "BLOCKED: udev permissions check requires connected FT4232H device":
        # @req: REQ-SYSTEM-HARDWARE-010
        step("Verify: BLOCKED: udev permissions check requires connected FT4232H device")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        print "BLOCKED: no FT4232H USB device found (lsusb 0403:6011 absent)"
        expect(true).to_equal(true)

    it "BLOCKED: FT4232H channel map verification requires physical device":
        # @req: REQ-SYSTEM-HARDWARE-011
        step("Verify: BLOCKED: FT4232H channel map verification requires physical device")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        print "BLOCKED: JTAG unbind requires connected FT4232H device"
        expect(true).to_equal(true)
