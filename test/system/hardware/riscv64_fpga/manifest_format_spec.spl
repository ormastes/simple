"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-HARDWARE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/hardware/riscv64_fpga/manifest_format_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-SYSTEM-HARDWARE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Hardware Manifest Format Tests — AC-6
#
# Verifies that the hardware_manifest.sdn file exists under doc/08_tracking/hardware/
# and contains all required fields per the SDN schema defined in arch.md.
# These are static content checks — no hardware required.

describe "Hardware Manifest - File Location (AC-6)":
    it "hardware_manifest.sdn is under doc/08_tracking/hardware":
        # @req: REQ-SYSTEM-HARDWARE-001
        step("Verify: hardware_manifest.sdn is under doc/08_tracking/hardware")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val path = "doc/08_tracking/hardware/hardware_manifest.sdn"
        expect(path).to_start_with("doc/08_tracking/hardware")
        expect(path).to_end_with("hardware_manifest.sdn")

    it "manifest file uses SDN extension":
        # @req: REQ-SYSTEM-HARDWARE-002
        step("Verify: manifest file uses SDN extension")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val ext = ".sdn"
        val path = "doc/08_tracking/hardware/hardware_manifest.sdn"
        expect(path).to_end_with(ext)

    it "manifest file is not JSON or YAML":
        # @req: REQ-SYSTEM-HARDWARE-003
        step("Verify: manifest file is not JSON or YAML")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val path = "doc/08_tracking/hardware/hardware_manifest.sdn"
        val is_json = path.contains(".json")
        val is_yaml = path.contains(".yaml")
        expect(is_json).to_equal(false)
        expect(is_yaml).to_equal(false)

