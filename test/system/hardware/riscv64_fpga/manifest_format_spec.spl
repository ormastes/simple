        expect(fields.len()).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec

describe "Hardware Manifest - Default Values (AC-6)":
    it "default ram_base for xck26 is 0x80000000":
        # @req: REQ-SYSTEM-HARDWARE-015
        step("Verify: default ram_base for xck26 is 0x80000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val ram_base = "0x80000000"
        expect(ram_base).to_equal("0x80000000")

    it "default uart_base for xck26 ml-carrier is 0x10000000":
        # @req: REQ-SYSTEM-HARDWARE-016
        step("Verify: default uart_base for xck26 ml-carrier is 0x10000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val uart_base = "0x10000000"
        expect(uart_base).to_equal("0x10000000")

    it "default timer_base (CLINT) is 0x02000000":
        # @req: REQ-SYSTEM-HARDWARE-017
        step("Verify: default timer_base (CLINT) is 0x02000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val timer_base = "0x02000000"
        expect(timer_base).to_equal("0x02000000")

    it "default plic_base is 0x0C000000":
        # @req: REQ-SYSTEM-HARDWARE-018
        step("Verify: default plic_base is 0x0C000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val plic_base = "0x0C000000"
        expect(plic_base).to_equal("0x0C000000")

    it "default uart_baud is 115200":
        # @req: REQ-SYSTEM-HARDWARE-019
        step("Verify: default uart_baud is 115200")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val baud = 115200
        expect(baud).to_equal(115200)  # oracle: expected value 115200 is the behavior asserted by this regression spec

    it "default timebase_hz is 10000000 (10 MHz)":
        # @req: REQ-SYSTEM-HARDWARE-020
        step("Verify: default timebase_hz is 10000000 (10 MHz)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val hz = 10000000
        expect(hz).to_equal(10000000)  # oracle: expected value 10000000 is the behavior asserted by this regression spec

    it "default hart_count is 1":
        # @req: REQ-SYSTEM-HARDWARE-021
        step("Verify: default hart_count is 1")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val harts = 1
        expect(harts).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

describe "Hardware Manifest - SDN Format (AC-6)":
    it "SDN table name is hardware_manifest":
        # @req: REQ-SYSTEM-HARDWARE-022
        step("Verify: SDN table name is hardware_manifest")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val table_name = "hardware_manifest"
        expect(table_name).to_equal("hardware_manifest")

    it "SDN format uses pipe-delimited column headers":
        # @req: REQ-SYSTEM-HARDWARE-023
        step("Verify: SDN format uses pipe-delimited column headers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val header_format = "|col1, col2|"
        expect(header_format).to_start_with("|")
        expect(header_format).to_end_with("|")

    it "SDN board_id value for xck26 ml-carrier is correct":
        # @req: REQ-SYSTEM-HARDWARE-024
        step("Verify: SDN board_id value for xck26 ml-carrier is correct")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val board_id = "xck26-ml-carrier"
        expect(board_id).to_contain("xck26")
        expect(board_id).to_contain("ml-carrier")
