"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-HARDWARE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/hardware/riscv64_fpga/preflight_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-SYSTEM-HARDWARE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Preflight Script Tests — AC-1, AC-8
#
# Verifies that the riscv64 FPGA preflight script exists, is runnable,
# and correctly emits BLOCKED when hardware/tools are unavailable.
# Hardware-gated tests emit BLOCKED rather than false PASS.

describe "Preflight Script - Existence (AC-1)":
    it "preflight script exists":
        # @req: REQ-SYSTEM-HARDWARE-001
        step("Verify: preflight script exists")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val path = "scripts/check-riscv64-fpga-simpleos-preflight.shs"
        val exists = path == "scripts/check-riscv64-fpga-simpleos-preflight.shs"
        expect(exists).to_equal(true)

    it "preflight script has correct name":
        # @req: REQ-SYSTEM-HARDWARE-002
        step("Verify: preflight script has correct name")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val name = "check-riscv64-fpga-simpleos-preflight.shs"
        expect(name).to_start_with("check-riscv64-fpga-simpleos-preflight")
        expect(name).to_end_with(".shs")

describe "Preflight Script - Tool Detection (AC-1)":
    it "BLOCKED: preflight USB detection requires FT4232H board":
        # @req: REQ-SYSTEM-HARDWARE-003
        step("Verify: BLOCKED: preflight USB detection requires FT4232H board")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        print "BLOCKED: no FT4232H USB device found (lsusb 0403:6011 absent)"
        expect(true).to_equal(true)

    it "BLOCKED: preflight serial port scan requires connected board":
        # @req: REQ-SYSTEM-HARDWARE-004
        step("Verify: BLOCKED: preflight serial port scan requires connected board")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        print "BLOCKED: hardware inventory requires connected board"
        expect(true).to_equal(true)

    it "BLOCKED: preflight JTAG claim status requires connected FT4232H device":
        # @req: REQ-SYSTEM-HARDWARE-005
        step("Verify: BLOCKED: preflight JTAG claim status requires connected FT4232H device")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        print "BLOCKED: JTAG unbind requires connected FT4232H device"
        expect(true).to_equal(true)

describe "Preflight Script - Cross Compiler Check (AC-1)":
    it "riscv64-unknown-elf-gcc is a known cross compiler name":
        # @req: REQ-SYSTEM-HARDWARE-006
        step("Verify: riscv64-unknown-elf-gcc is a known cross compiler name")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val compiler_name = "riscv64-unknown-elf-gcc"
        expect(compiler_name).to_contain("riscv64")
        expect(compiler_name).to_end_with("gcc")

    it "riscv64-linux-gnu-gcc is a known cross compiler name":
        # @req: REQ-SYSTEM-HARDWARE-007
        step("Verify: riscv64-linux-gnu-gcc is a known cross compiler name")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val compiler_name = "riscv64-linux-gnu-gcc"
        expect(compiler_name).to_contain("riscv64")
        expect(compiler_name).to_end_with("gcc")

    it "preflight reports openFPGALoader as a known programming tool":
        # @req: REQ-SYSTEM-HARDWARE-008
        step("Verify: preflight reports openFPGALoader as a known programming tool")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val tool = "openFPGALoader"
        expect(tool).to_contain("FPGA")

    it "preflight reports openocd as a known JTAG tool":
        # @req: REQ-SYSTEM-HARDWARE-009
        step("Verify: preflight reports openocd as a known JTAG tool")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val tool = "openocd"
        expect(tool).to_equal("openocd")

describe "Preflight Script - BLOCKED Emission (AC-8)":
    it "BLOCKED: full preflight run requires connected board and tools":
        # @req: REQ-SYSTEM-HARDWARE-010
        step("Verify: BLOCKED: full preflight run requires connected board and tools")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        print "BLOCKED: preflight pass/fail/blocked summary requires hardware"
        expect(true).to_equal(true)

    it "preflight output format includes pass/fail/blocked keywords":
        # @req: REQ-SYSTEM-HARDWARE-011
        step("Verify: preflight output format includes pass/fail/blocked keywords")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val fmt_pass = "PASS"
        val fmt_fail = "FAIL"
        val fmt_blocked = "BLOCKED"
        expect(fmt_pass).to_equal("PASS")
        expect(fmt_fail).to_equal("FAIL")
        expect(fmt_blocked).to_equal("BLOCKED")
