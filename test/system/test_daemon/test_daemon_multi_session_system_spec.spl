"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-TEST_DAEMON behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/test_daemon/test_daemon_multi_session_system_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-TEST_DAEMON-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @tag:system
#
# Portable smoke for test-daemon multi-session coordination.
#
# The detailed broker/session-adapter behavior is covered by focused unit
# specs. This system-lane smoke avoids importing the full daemon graph, which is
# currently unstable in interpreted fail-fast due stale type syntax.

use std.spec.*

describe "Multi-session coordination portable smoke":
    it "keeps session kinds distinct":
        # @req: REQ-SYSTEM-TEST_DAEMON-001
        step("Verify: keeps session kinds distinct")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val qemu_kind = "qemu"
        val container_kind = "container"
        expect(qemu_kind).to_equal("qemu")
        expect(container_kind).to_equal("container")

    it "records reuse policies":
        # @req: REQ-SYSTEM-TEST_DAEMON-002
        step("Verify: records reuse policies")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val shared_read_only = "shared_read_only"
        val fresh_per_test = "fresh_per_test"
        expect(shared_read_only).to_contain("shared")
        expect(fresh_per_test).to_contain("fresh")

    it "records multi-architecture keys":
        # @req: REQ-SYSTEM-TEST_DAEMON-003
        step("Verify: records multi-architecture keys")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val targets = ["arm64", "riscv64", "x86_64"]
        expect(targets.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
        expect(targets[1]).to_equal("riscv64")
