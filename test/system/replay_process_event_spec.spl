"""
## Purpose and audience
Purpose: SyscallEntry to_i32 returns 0
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-REPLAY_PROCE-ReplProcEven-001

use std.spec
use std.nogc_sync_mut.replay.process.event_types.{ProcessEventKind, ProcessReplayEvent}

use std.spec.step
describe "ProcessEventKind to_i32":
    it "SyscallEntry to_i32 returns 0":
        step("Verify: SyscallEntry to_i32 returns 0")
        # @req: REQ-REPLAY_PROCE-ReplProcEven-001
        val k = ProcessEventKind.SyscallEntry
        expect(k.to_i32()).to_equal(0)  # oracle: value fixed by the spec contract

    it "SyscallExit to_i32 returns 1":
        step("Verify: SyscallExit to_i32 returns 1")
        # @req: REQ-REPLAY_PROCE-ReplProcEven-001
        val k = ProcessEventKind.SyscallExit
        expect(k.to_i32()).to_equal(1)  # oracle: value fixed by the spec contract

    it "Signal to_i32 returns 2":
        step("Verify: Signal to_i32 returns 2")
        # @req: REQ-REPLAY_PROCE-ReplProcEven-001
        val k = ProcessEventKind.Signal
        expect(k.to_i32()).to_equal(2)  # oracle: value fixed by the spec contract

    it "ProcessExit to_i32 returns 9":
        step("Verify: ProcessExit to_i32 returns 9")
        # @req: REQ-REPLAY_PROCE-ReplProcEven-001
        val k = ProcessEventKind.ProcessExit
        expect(k.to_i32()).to_equal(9)  # oracle: value fixed by the spec contract

describe "ProcessReplayEvent constructors":
    it "syscall_entry sets kind to SyscallEntry":
        step("Verify: syscall_entry sets kind to SyscallEntry")
        # @req: REQ-REPLAY_PROCE-ReplProcEven-001
        val ev = ProcessReplayEvent.syscall_entry(1, 100, 999, 60, 0, 0)
        expect(ev.kind).to_equal(ProcessEventKind.SyscallEntry.to_i32())

    it "syscall_entry stores syscall number in payload_a":
        step("Verify: syscall_entry stores syscall number in payload_a")
        # @req: REQ-REPLAY_PROCE-ReplProcEven-001
        val ev = ProcessReplayEvent.syscall_entry(1, 100, 999, 60, 0, 0)
        expect(ev.payload_a).to_equal(60)  # oracle: value fixed by the spec contract

    it "syscall_exit stores retval in payload_a":
        step("Verify: syscall_exit stores retval in payload_a")
        # @req: REQ-REPLAY_PROCE-ReplProcEven-001
        val ev = ProcessReplayEvent.syscall_exit(2, 100, 1000, 42)
        expect(ev.payload_a).to_equal(42)  # oracle: value fixed by the spec contract

    it "signal_event sets kind to Signal":
        step("Verify: signal_event sets kind to Signal")
        # @req: REQ-REPLAY_PROCE-ReplProcEven-001
        val ev = ProcessReplayEvent.signal_event(3, 200, 2000, 9)
        expect(ev.kind).to_equal(ProcessEventKind.Signal.to_i32())

    it "exit_event stores exit_code in payload_a":
        step("Verify: exit_event stores exit_code in payload_a")
        # @req: REQ-REPLAY_PROCE-ReplProcEven-001
        val ev = ProcessReplayEvent.exit_event(4, 300, 3000, 1)
        expect(ev.payload_a).to_equal(1)  # oracle: value fixed by the spec contract

    it "event_kind() roundtrips for SyscallExit":
        step("Verify: event_kind() roundtrips for SyscallExit")
        # @req: REQ-REPLAY_PROCE-ReplProcEven-001
        val ev = ProcessReplayEvent.syscall_exit(5, 1, 100, 0)
        val k = ev.event_kind()
        expect(k.to_i32()).to_equal(1)  # oracle: value fixed by the spec contract
