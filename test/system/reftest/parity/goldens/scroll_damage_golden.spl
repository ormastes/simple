# Golden: scroll_damage - green content rect, then a red alpha-180 rect 50 px lower.
#
# Probe rows: [x, y, r, g, b, a].

fn probes() -> [[i64]]:
    [
        # pre-scroll content only
        [100, 30, 100, 180, 100, 255],
        # overlap: red alpha-180 over green
        [100, 100, 185, 109, 86, 255],
        # post-scroll rect over transparent (premultiplied)
        [100, 180, 155, 56, 56, 180],
        # below both rects
        [100, 300, 0, 0, 0, 0]
    ]
