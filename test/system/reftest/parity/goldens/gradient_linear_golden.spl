# Golden: gradient_linear - two abutting rects (red | blue) split at x = 101.
#
# Probe rows: [x, y, r, g, b, a].

fn probes() -> [[i64]]:
    [
        # left half red
        [50, 100, 255, 0, 0, 255],
        # last red column
        [100, 100, 255, 0, 0, 255],
        # first blue column
        [101, 100, 0, 0, 255, 255],
        # right half blue
        [150, 100, 0, 0, 255, 255]
    ]
