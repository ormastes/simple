# Pixel expectations for the parity reftest scenes.
#
# Each golden lists probe pixels (x, y, r, g, b, a) in the CPU backend's
# premultiplied RGBA8 canvas. Values are derived ANALYTICALLY from the scene
# description (Porter-Duff / separable blend formulas over the scene's
# colours, exact coverage for axis-aligned edges), not captured from the
# renderer, and every scene was rendered and inspected visually on
# 2026-10-05 (fill_path_aa with real sub-scanline AA, PR #2550).

use test.system.reftest.parity.goldens.path_winding_golden.{probes as path_winding_probes}
use test.system.reftest.parity.goldens.path_evenodd_golden.{probes as path_evenodd_probes}
use test.system.reftest.parity.goldens.dashed_strokes_golden.{probes as dashed_strokes_probes}
use test.system.reftest.parity.goldens.gradient_linear_golden.{probes as gradient_linear_probes}
use test.system.reftest.parity.goldens.text_arabic_golden.{probes as text_arabic_probes}
use test.system.reftest.parity.goldens.porter_duff_golden.{probes as porter_duff_probes}
use test.system.reftest.parity.goldens.mix_blend_mode_golden.{probes as mix_blend_mode_probes}
use test.system.reftest.parity.goldens.backdrop_filter_golden.{probes as backdrop_filter_probes}
use test.system.reftest.parity.goldens.scroll_damage_golden.{probes as scroll_damage_probes}
use test.system.reftest.parity.goldens.transform_tree_golden.{probes as transform_tree_probes}
use test.system.reftest.parity.goldens.opacity_layer_golden.{probes as opacity_layer_probes}
