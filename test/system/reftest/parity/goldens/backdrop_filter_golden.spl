# Golden: backdrop_filter - bg, then a white alpha-200 rect inside a Multiply SaveLayer.
#
# Probe rows: [x, y, r, g, b, a].

fn probes() -> [[i64]]:
    [
        # background only
        [10, 10, 180, 200, 220, 255],
        # multiplying by (premultiplied) white leaves the background unchanged
        [150, 150, 180, 200, 220, 255]
    ]
