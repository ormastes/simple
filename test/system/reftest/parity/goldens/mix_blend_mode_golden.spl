# Golden: mix_blend_mode - yellow rect, then blue rect drawn with Darken.
#
# Probe rows: [x, y, r, g, b, a].

fn probes() -> [[i64]]:
    [
        # bottom (yellow) only
        [40, 40, 255, 220, 0, 255],
        # top (blue) only, over transparent
        [260, 240, 0, 100, 200, 255],
        # overlap: darken = per-channel min of opaque colours
        [200, 150, 0, 100, 0, 255]
    ]
