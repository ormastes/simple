# Golden: dashed_strokes - three horizontal strokes, widths 1 / 2 / 4 px centred on y = 50 / 100 / 150.
#
# Probe rows: [x, y, r, g, b, a].

fn probes() -> [[i64]]:
    [
        # 1 px stroke on y=50 covers rows 49 and 50 by half each (anti-aliased)
        [100, 49, 0, 0, 0, 127],
        # other half of the 1 px stroke
        [100, 50, 0, 0, 0, 127],
        # 2 px stroke fully covers rows 99..100
        [100, 99, 60, 60, 60, 255],
        # 2 px stroke, second row
        [100, 100, 60, 60, 60, 255],
        # 4 px stroke covers rows 148..151
        [100, 148, 120, 120, 120, 255],
        # 4 px stroke, last row
        [100, 151, 120, 120, 120, 255],
        # just below the 4 px stroke
        [100, 152, 0, 0, 0, 0],
        # left of the stroke start (x=10)
        [5, 100, 0, 0, 0, 0]
    ]
