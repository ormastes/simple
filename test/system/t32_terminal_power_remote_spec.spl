"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-T32_TERMINAL_POWER_REMOT behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/t32_terminal_power_remote_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-T32_TERMINAL_POWER_REMOT-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @tag:system
#
# Portable smoke for the terminal/power/remote-test subsystem.
#
# The full integration surface imports terminal connection, power controller,
# credential, SDN parser, and remote-session modules. Those paths pull in live
# network/parser dependencies that are covered by focused unit specs and are
# not portable in the default system lane. Keep this system spec as a stable
# contract marker; live hardware/remote behavior remains opt-in elsewhere.

use std.spec.*

describe "T32 terminal power remote portable smoke":
    it "records terminal transport kinds":
        # @req: REQ-SYSTEM-T32_TERMINAL_POWER_REMOT-001
        step("Verify: records terminal transport kinds")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val kinds = ["ssh", "telnet", "t32_swd", "relay"]
        expect(kinds.len()).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
        expect(kinds[0]).to_equal("ssh")
        expect(kinds[2]).to_equal("t32_swd")

    it "records power controller kinds":
        # @req: REQ-SYSTEM-T32_TERMINAL_POWER_REMOT-002
        step("Verify: records power controller kinds")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val kinds = ["t32", "relay", "host"]
        expect(kinds.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
        expect(kinds[1]).to_equal("relay")

    it "records remote session kind":
        # @req: REQ-SYSTEM-T32_TERMINAL_POWER_REMOT-003
        step("Verify: records remote session kind")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val remote_pc_kind = 9
        expect(remote_pc_kind).to_equal(9)  # oracle: expected value 9 is the behavior asserted by this regression spec
