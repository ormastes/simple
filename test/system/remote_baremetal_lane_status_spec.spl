"""
## Purpose and audience

# Remote Baremetal Lane Status System Spec
# @session:mutating
# @arch:riscv32
#
# @cover src/lib/nogc_sync_mut/debug/remote/exec/lane_registry.spl 80%
#
# Validates that the lane descriptor, capability report, and lane
# registry infrastructure works correctly. This is the authoritative
# test for the lane classification and status reporting system.

This specification is maintained for compiler and library engineers reviewing SYSTEM-REMOTE_BAREMETAL_LANE_ST behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/remote_baremetal_lane_status_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.nogc_sync_mut.debug.remote.exec.lane_descriptor.{
    LaneDescriptor, LaneStatus, ProofClass, AdapterKind, ResultChannelKind
}
use std.nogc_sync_mut.debug.remote.exec.capability_report.{
    CapabilityReport, CapabilityStatus, probe_command, probe_external_formal,
    probe_openocd_capability, probe_trace32_capability
}
use std.nogc_sync_mut.debug.remote.exec.result_channel.{
    ResultPacket, ResultVerifier
}
use std.nogc_sync_mut.debug.remote.exec.lane_registry.{
    LaneRegistry, probe_for_lane
}
use std.nogc_sync_mut.debug.remote.exec.lane_status.{
    LaneStatusReporter
}

use std.spec.{step}

# ============================================================================
# LaneDescriptor
# ============================================================================

describe "LaneDescriptor":
    it "creates a descriptor with all fields":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-001 REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-041
        step("Verify: creates a descriptor with all fields")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val lane = LaneDescriptor(
            lane_id: "qemu_rv32",
            target_arch: "riscv32",
            adapter_kind: AdapterKind.qemu_gdb,
            proof_class: ProofClass.compiled,
            primary_result_channel: ResultChannelKind.semihost_text,
            fallback_result_channel: Some(ResultChannelKind.exit_code),
            authoritative_spec_path: "test/some_spec.spl",
            status: LaneStatus.stable
        )
        expect(lane.lane_id).to_equal("qemu_rv32")
        expect(lane.target_arch).to_equal("riscv32")
        expect(lane.is_authoritative()).to_equal(true)

    it "formats to_text correctly":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-002
        step("Verify: formats to_text correctly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val lane = LaneDescriptor(
            lane_id: "qemu_rv32_semihost",
            target_arch: "riscv32",
            adapter_kind: AdapterKind.qemu_gdb,
            proof_class: ProofClass.compiled,
            primary_result_channel: ResultChannelKind.semihost_text,
            fallback_result_channel: nil,
            authoritative_spec_path: "",
            status: LaneStatus.stable
        )
        val text_repr = lane.to_text()
        expect(text_repr).to_contain("qemu_rv32_semihost")
        expect(text_repr).to_contain("riscv32")

    it "classifies stable lanes as authoritative":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-003
        step("Verify: classifies stable lanes as authoritative")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val lane = LaneDescriptor(
            lane_id: "stable_lane",
            target_arch: "riscv32",
            adapter_kind: AdapterKind.qemu_gdb,
            proof_class: ProofClass.compiled,
            primary_result_channel: ResultChannelKind.semihost_text,
            fallback_result_channel: nil,
            authoritative_spec_path: "",
            status: LaneStatus.stable
        )
        expect(lane.is_authoritative()).to_equal(true)

    it "classifies in_progress lanes as non-authoritative":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-004
        step("Verify: classifies in_progress lanes as non-authoritative")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val lane = LaneDescriptor(
            lane_id: "wip_lane",
            target_arch: "arm32",
            adapter_kind: AdapterKind.openocd_gdb,
            proof_class: ProofClass.structural,
            primary_result_channel: ResultChannelKind.register_readback,
            fallback_result_channel: nil,
            authoritative_spec_path: "",
            status: LaneStatus.in_progress
        )
        expect(lane.is_authoritative()).to_equal(false)

    it "treats host-aware lanes as authoritative when the lane contract is satisfied":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-005
        step("Verify: treats host-aware lanes as authoritative when the lane contract is satisfied")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val lane = LaneDescriptor(
            lane_id: "host_lane",
            target_arch: "arm32",
            adapter_kind: AdapterKind.trace32,
            proof_class: ProofClass.compiled,
            primary_result_channel: ResultChannelKind.debugger_console,
            fallback_result_channel: Some(ResultChannelKind.register_readback),
            authoritative_spec_path: "test/system/t32_terminal_power_remote_spec.spl",
            status: LaneStatus.host_aware
        )
        expect(lane.is_authoritative()).to_equal(true)


# ============================================================================
# CapabilityReport
# ============================================================================

describe "CapabilityReport":
    it "creates ready reports":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-006
        step("Verify: creates ready reports")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val report = CapabilityReport.ready("test_lane", "qemu-system-riscv32")
        expect(report.is_runnable()).to_equal(true)
        expect(report.is_acceptable()).to_equal(true)

    it "creates skip_tool reports":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-007
        step("Verify: creates skip_tool reports")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val report = CapabilityReport.skip_tool("test_lane", "missing_tool")
        expect(report.is_runnable()).to_equal(false)
        expect(report.is_acceptable()).to_equal(true)

    it "creates failed reports":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-008
        step("Verify: creates failed reports")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val report = CapabilityReport.failed("test_lane", "critical error")
        expect(report.is_runnable()).to_equal(false)
        expect(report.is_acceptable()).to_equal(false)

    it "formats report text":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-009
        step("Verify: formats report text")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val report = CapabilityReport.ready("my_lane", "tool_name")
        val text_repr = report.to_text()
        expect(text_repr).to_contain("my_lane")
        expect(text_repr).to_contain("ready")


# ============================================================================
# ResultPacket
# ============================================================================

describe "ResultPacket":
    it "creates semihost packets":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-010
        step("Verify: creates semihost packets")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val packet = ResultPacket.from_semihost("test_lane", "PASS: all tests passed", 100)
        expect(packet.is_pass()).to_equal(true)

    it "creates register packets":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-011
        step("Verify: creates register packets")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val pass_packet = ResultPacket.from_register("test_lane", 0, 50)
        expect(pass_packet.is_pass()).to_equal(true)
        val fail_packet = ResultPacket.from_register("test_lane", 1, 50)
        expect(fail_packet.is_pass()).to_equal(false)

    it "creates exit code packets":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-012
        step("Verify: creates exit code packets")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val packet = ResultPacket.from_exit_code("test_lane", 0, "", 75)
        expect(packet.is_pass()).to_equal(true)

    it "creates skipped packets":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-013
        step("Verify: creates skipped packets")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val packet = ResultPacket.skipped("test_lane", "exit_code", "missing toolchain", 5)
        expect(packet.is_skip()).to_equal(true)
        expect(packet.is_pass()).to_equal(false)
        expect(packet.to_text()).to_contain("SKIP")


# ============================================================================
# ResultVerifier
# ============================================================================

describe "ResultVerifier":
    it "verifies default pass":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-014
        step("Verify: verifies default pass")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val verifier = ResultVerifier.default_pass()
        val packet = ResultPacket.from_exit_code("test_lane", 0, "", 10)
        val result = verifier.verify(packet)
        expect(result.is_ok()).to_equal(true)

    it "rejects failed packets":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-015
        step("Verify: rejects failed packets")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val verifier = ResultVerifier.default_pass()
        val packet = ResultPacket.from_exit_code("test_lane", 1, "", 10)
        val result = verifier.verify(packet)
        expect(result.is_err()).to_equal(true)

    it "checks output patterns":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-016
        step("Verify: checks output patterns")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val verifier = ResultVerifier.with_output(["PASS"])
        val packet = ResultPacket.from_semihost("test_lane", "PASS: all tests passed", 10)
        val result = verifier.verify(packet)
        expect(result.is_ok()).to_equal(true)

    it "accepts skipped packets when configured":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-017
        step("Verify: accepts skipped packets when configured")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val verifier = ResultVerifier.allow_skip()
        val packet = ResultPacket.skipped("test_lane", "exit_code", "missing toolchain", 5)
        val result = verifier.verify(packet)
        expect(result.is_ok()).to_equal(true)


# ============================================================================
# LaneRegistry
# ============================================================================

describe "LaneRegistry":
    """The default registry is the source of truth for public lane classification."""
    it "contains exactly 12 lanes":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-018
        step("Verify: contains exactly 12 lanes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()
        expect(registry.all().len()).to_equal(12)  # oracle: expected value 12 is the behavior asserted by this regression spec

    it "has 3 stable lanes":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-019
        step("Verify: has 3 stable lanes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()
        expect(registry.stable_lanes().len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    it "has 5 host-aware lanes":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-020
        step("Verify: has 5 host-aware lanes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()
        expect(registry.host_aware_lanes().len()).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

    it "has 3 transport-only lanes":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-021
        step("Verify: has 3 transport-only lanes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()
        expect(registry.transport_only_lanes().len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    it "has no in-progress lanes":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-022
        step("Verify: has no in-progress lanes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()
        expect(registry.in_progress_lanes().len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "has 1 publicly excluded lane":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-023
        step("Verify: has 1 publicly excluded lane")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()
        expect(registry.excluded_public_lanes().len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "has 8 authoritative lanes":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-024
        step("Verify: has 8 authoritative lanes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()
        expect(registry.authoritative_lanes().len()).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

    it "assigns concrete result channels to every authoritative lane":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-025
        step("Verify: assigns concrete result channels to every authoritative lane")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()
        val lanes = registry.authoritative_lanes()
        for lane in lanes:
            expect(lane.authoritative_spec_path.len()).to_be_greater_than(0)

        val qemu_rv32 = registry.find("qemu_rv32_semihost")
        match qemu_rv32:
            Some(l):
                expect(l.primary_result_channel).to_equal(ResultChannelKind.semihost_text)
                expect(l.fallback_result_channel).to_equal(Some(ResultChannelKind.exit_code))
            nil: expect(false).to_equal(true)

        val direct_boot = registry.find("x86_64_direct_boot")
        match direct_boot:
            Some(l):
                expect(l.primary_result_channel).to_equal(ResultChannelKind.exit_code)
                expect(l.fallback_result_channel).to_be_nil()
            nil: expect(false).to_equal(true)

        val openocd = registry.find("stm32h7_openocd")
        match openocd:
            Some(l):
                expect(l.primary_result_channel).to_equal(ResultChannelKind.register_readback)
                expect(l.fallback_result_channel).to_equal(Some(ResultChannelKind.ram_sentinel))
            nil: expect(false).to_equal(true)

        val trace32 = registry.find("stm32h7_trace32")
        match trace32:
            Some(l):
                expect(l.primary_result_channel).to_equal(ResultChannelKind.debugger_console)
                expect(l.fallback_result_channel).to_equal(Some(ResultChannelKind.register_readback))
            nil: expect(false).to_equal(true)

        val mailbox = registry.find("ghdl_rv32_mailbox")
        match mailbox:
            Some(l):
                expect(l.primary_result_channel).to_equal(ResultChannelKind.ram_sentinel)
                expect(l.fallback_result_channel).to_equal(Some(ResultChannelKind.register_readback))
            nil: expect(false).to_equal(true)

    it "finds lanes by id":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-026
        step("Verify: finds lanes by id")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()
        val lane = registry.find("qemu_rv32_semihost")
        match lane:
            Some(l): expect(l.lane_id).to_equal("qemu_rv32_semihost")
            nil: expect(false).to_equal(true)

    it "uses the x86_64 boot spec for the direct boot lane":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-027
        step("Verify: uses the x86_64 boot spec for the direct boot lane")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()
        val lane = registry.find("x86_64_direct_boot")
        match lane:
            Some(l):
                expect(l.status).to_equal(LaneStatus.stable)
                expect(l.authoritative_spec_path).to_equal("test/system/qemu/os/boot/x86_64_boot_qemu_spec.spl")
                expect(l.is_authoritative()).to_equal(true)
            nil: expect(false).to_equal(true)

    it "returns nil for unknown lanes":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-028
        step("Verify: returns nil for unknown lanes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()
        val lane = registry.find("nonexistent")
        expect(lane).to_be_nil()

    it "looks up ghdl_rv32_semihost as host_aware":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-029
        step("Verify: looks up ghdl_rv32_semihost as host_aware")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()
        val lane = registry.find("ghdl_rv32_semihost")
        match lane:
            Some(l):
                expect(l.status).to_equal(LaneStatus.host_aware)
                expect(l.is_authoritative()).to_equal(true)
            nil: expect(false).to_equal(true)

    it "looks up ghdl_rv32_mailbox as host_aware":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-030
        step("Verify: looks up ghdl_rv32_mailbox as host_aware")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()
        val lane = registry.find("ghdl_rv32_mailbox")
        match lane:
            Some(l):
                expect(l.status).to_equal(LaneStatus.host_aware)
                expect(l.is_authoritative()).to_equal(true)
            nil: expect(false).to_equal(true)

    it "looks up riscv_external_formal as transport_only":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-031
        step("Verify: looks up riscv_external_formal as transport_only")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()
        val lane = registry.find("riscv_external_formal")
        match lane:
            Some(l):
                expect(l.status).to_equal(LaneStatus.transport_only)
                expect(l.adapter_kind).to_equal(AdapterKind.external_formal)
                expect(l.is_authoritative()).to_equal(false)
            nil: expect(false).to_equal(true)

    it "returns nil for removed ghdl_rv32_sim":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-032
        step("Verify: returns nil for removed ghdl_rv32_sim")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()
        val lane = registry.find("ghdl_rv32_sim")
        expect(lane).to_be_nil()

    it "looks up fpga_jtag_zedboard as publicly excluded":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-033
        step("Verify: looks up fpga_jtag_zedboard as publicly excluded")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()
        val lane = registry.find("fpga_jtag_zedboard")
        match lane:
            Some(l):
                expect(l.status).to_equal(LaneStatus.excluded_public)
                expect(l.is_authoritative()).to_equal(false)
            nil: expect(false).to_equal(true)


# ============================================================================
# LaneStatusReporter
# ============================================================================

describe "LaneStatusReporter":
    it "generates text report":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-034
        step("Verify: generates text report")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val reporter = LaneStatusReporter.new()
        val report = reporter.report_text()
        expect(report).to_contain("Stable Lanes")
        expect(report).to_contain("Host-Aware")
        expect(report).to_contain("Publicly Excluded Lanes")
        expect(report).to_contain("stable and host-aware lanes are authoritative")

    it "generates markdown report":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-035
        step("Verify: generates markdown report")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val reporter = LaneStatusReporter.new()
        val report = reporter.generate_matrix_markdown()
        expect(report).to_contain("| Lane ID |")
        expect(report).to_contain("| Authoritative |")
        expect(report).to_contain("- **Authoritative**: 8 lanes (stable + host-aware)")
        expect(report).to_contain("- **Publicly excluded**: 1 lanes")

    it "generates SDN report":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-036
        step("Verify: generates SDN report")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val reporter = LaneStatusReporter.new()
        val report = reporter.report_sdn()
        expect(report).to_contain("[lane_matrix]")
        expect(report).to_contain("authoritative =")


# ============================================================================
# Probe infrastructure
# ============================================================================

describe "Probe infrastructure":
    it "detects available commands":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-037
        step("Verify: detects available commands")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val found = probe_command("ls")
        expect(found).to_equal(true)

    it "detects missing commands":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-038
        step("Verify: detects missing commands")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val found = probe_command("nonexistent_tool_xyz")
        expect(found).to_equal(false)

    it "probes external formal capability cleanly":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-039
        step("Verify: probes external formal capability cleanly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val report = probe_external_formal()
        expect(report.lane_id).to_equal("riscv_external_formal")
        expect(report.is_acceptable()).to_equal(true)
        expect(report.detail.len()).to_be_greater_than(0)

    it "treats missing OpenOCD and TRACE32 tools as acceptable host-aware skips":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-040
        step("Verify: treats missing OpenOCD and TRACE32 tools as acceptable host-aware skips")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()

        val openocd_lane = registry.find("stm32h7_openocd")
        match openocd_lane:
            Some(l):
                expect(l.status).to_equal(LaneStatus.host_aware)
                val report = probe_openocd_capability(false)
                expect(report.status).to_equal(CapabilityStatus.skip_missing_tool)
                expect(report.tool_name).to_equal("openocd")
                expect(report.is_runnable()).to_equal(false)
                expect(report.is_acceptable()).to_equal(true)
            nil: expect(false).to_equal(true)

        val trace32_lane = registry.find("stm32h7_trace32")
        match trace32_lane:
            Some(l):
                expect(l.status).to_equal(LaneStatus.host_aware)
                val report = probe_trace32_capability(false)
                expect(report.status).to_equal(CapabilityStatus.skip_missing_tool)
                expect(report.tool_name).to_equal("t32rem")
                expect(report.is_runnable()).to_equal(false)
                expect(report.is_acceptable()).to_equal(true)
            nil: expect(false).to_equal(true)

    slow_it "probes all lanes without crashing":
        # @req: REQ-SYSTEM-REMOTE_BAREMETAL_LANE_ST-041
        step("Verify: probes all lanes without crashing")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val registry = LaneRegistry.default()
        val lanes = registry.all()
        var i = 0
        while i < lanes.len():
            val lane = lanes[i]
            val report = probe_for_lane(lane)
            expect(report.is_acceptable()).to_equal(true)
            i = i + 1
