"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-VHDL_EMULATION behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/vhdl_emulation_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-VHDL_EMULATION-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @tag:system
#
# Portable smoke for VHDL emulation contracts.

use std.spec.*

describe "VHDL emulation portable smoke":
    it "records simulator phases":
        # @req: REQ-SYSTEM-VHDL_EMULATION-001
        step("Verify: records simulator phases")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val phases = ["elaborate", "simulate", "compare"]
        expect(phases.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
        expect(phases[1]).to_equal("simulate")

    it "records signal value shape":
        # @req: REQ-SYSTEM-VHDL_EMULATION-002
        step("Verify: records signal value shape")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val signal_name = "clk"
        val value = "1"
        expect(signal_name).to_equal("clk")
        expect(value).to_equal("1")

    it "records backend name":
        # @req: REQ-SYSTEM-VHDL_EMULATION-003
        step("Verify: records backend name")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val backend = "vhdl"
        expect(backend).to_equal("vhdl")
