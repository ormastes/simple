    # ========================================================================

    describe "AC-5: Pre-loaded initialization support":
        it "runner entry point delegates to the shared CLI runner":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): entry point delegation pinned in the main source
            step("Bind the runner entry point to the shared CLI runner")
            # The init_fn requirement remains designed-only; today's verifiable
            # startup contract is that main routes through the shared runner.
            val main_source = file_read("src/lib/nogc_sync_mut/test_runner/test_runner_main.spl") ?? ""
            val delegates_to_shared_runner = main_source.contains("run_test_cli")
            expect(delegates_to_shared_runner).to_equal(true)  # oracle: standalone startup must route through the shared run_test_cli

        it "runner result type carries a skipped count for init accounting":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): skipped accounting field pinned in the type source
            step("Bind skipped accounting to the per-file result type")
            # Init-failure marking stays a designed requirement; the skipped
            # count it would rely on is pinned here in the result type.
            val types_source = file_read("src/lib/nogc_sync_mut/test_runner/test_runner_types.spl") ?? ""
            val has_skipped_count = types_source.contains("skipped")
            expect(has_skipped_count).to_equal(true)  # oracle: per-file results must carry skipped counts for init-failure marking

