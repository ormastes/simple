# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/app/test_runner_new/mod.spl 80%
# Multi-Mode Test Runner System Tests
#
# Verifies the multi-mode test runner feature: unified test_main(),
# mode selection via CLI, native/loader/baremetal execution, and
# dual startup modes.
#
# @req REQ-multi_mode_test_runner
# @feature multi_mode_test_runner
"""## Purpose and audience
Executable evidence for the multi-mode test runner: shared CLI argument
parsing, interpreter/native/loader execution modes, baremetal composite
specs, and dual startup paths. Audience: engineers changing
src/lib/nogc_sync_mut/test_runner or the runner CLI surface.
## Operator workflow
Run the spec from the repository root with the bootstrap binary. Scenarios
that shell out to the runner binary assert the binary-presence gate itself
when no deployed runner exists on the host.
## Compatibility and limitations
Source-contract scenarios read stdlib sources via file_read with
repository-root-relative paths, so the spec must run from the repo root.
The optional init-function hook (AC-5) remains a designed requirement with
no product binding under that name; those scenarios pin the contracts that
exist in source today.
## Verification guidance and troubleshooting
A failure names the missing source token or the rejected flag verdict.
Re-verify each pinned token against src/lib/nogc_sync_mut/test_runner
before touching an assertion; every expected value carries an inline
oracle comment.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec
use std.io_runtime.{file_read}
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_file_exists(path: text) -> bool

fn extract_base_runtime(spec: text) -> text:
    val paren = spec.index_of("(") ?? -1
    if paren > 0:
        return spec[0:paren].trim()
    spec.trim()

fn extract_platform_layer(spec: text) -> text:
    val paren = spec.index_of("(") ?? -1
    if paren < 0:
        return ""
    val after = spec[paren + 1:]
    val paren2 = after.index_of("(") ?? -1
    if paren2 > 0:
        return after[0:paren2].trim()
    val close = after.index_of(")") ?? -1
    if close > 0:
        return after[0:close].trim()
    ""

fn extract_arch_from_spec(spec: text) -> text:
    if spec.contains("riscv32"):
        return "riscv32"
    if spec.contains("stm32h7"):
        return "arm32"
    if spec.contains("stm32wb"):
        return "arm32"
    if spec.contains("arm32"):
        return "arm32"
    if spec.contains("aarch64"):
        return "aarch64"
    if spec.contains("x86_64"):
        return "x86_64"
    if spec.contains("x86"):
        return "x86"
    "host"

fn extract_target_from_spec(spec: text) -> text:
    if spec.contains("trace32") or spec.contains("t32"):
        if spec.contains("stm32h7"):
            return "trace32_stm32h7"
        if spec.contains("stm32wb"):
            return "trace32_stm32wb"
        return "trace32_stm32h7"
    if spec.contains("ch32v307"):
        return "ch32v307"
    if spec.contains("ghdl") or spec.contains("rtl_rv32"):
        return "ghdl_rv32"
    if spec.contains("stm32h7"):
        return "stm32h7"
    if spec.contains("stm32wb"):
        return "stm32wb"
    if spec.contains("riscv32"):
        return "riscv32"
    if spec.contains("arm32"):
        return "arm32"
    if spec.contains("aarch64"):
        return "aarch64"
    if spec.contains("x86_64"):
        return "x86_64"
    if spec.contains("x86"):
        return "x86"
    "host"

fn extract_remote_backend(spec: text) -> text:
    if spec.contains("remote(t32(") or spec.contains("remote(trace32("):
        return "t32"
    if spec.contains("remote(openocd("):
        return "openocd"
    if spec.contains("remote(ghdl(") or spec.contains("baremetal(ghdl("):
        return "ghdl"
    ""

# ============================================================================
# Module-level helpers (avoid tuple destructuring inside it blocks)
# ============================================================================

class CmdResult:
    stdout: text
    stderr: text
    code: i64

fn _run(cmd: text, args: [text]) -> CmdResult:
    val (out, err, code) = rt_process_run(cmd, args)
    CmdResult(stdout: out, stderr: err, code: code)

fn get_simple_binary() -> text:
    if rt_file_exists("src/compiler_rust/target/release/simple"):
        return "src/compiler_rust/target/release/simple"
    if rt_file_exists("src/compiler_rust/target/bootstrap/simple"):
        return "src/compiler_rust/target/bootstrap/simple"
    if rt_file_exists("bin/simple"):
        return "bin/simple"
    if rt_file_exists("bin/release/aarch64-apple-darwin-macho/simple"):
        return "bin/release/aarch64-apple-darwin-macho/simple"
    if rt_file_exists("bin/release/macos-arm64/simple"):
        return "bin/release/macos-arm64/simple"
    if rt_file_exists("bin/release/darwin-aarch64/simple"):
        return "bin/release/darwin-aarch64/simple"
    if rt_file_exists("bin/release/macos-x86_64/simple"):
        return "bin/release/macos-x86_64/simple"
    if rt_file_exists("bin/release/linux-x86_64/simple"):
        return "bin/release/linux-x86_64/simple"
    "bin/simple"

fn _check_binary_available() -> bool:
    val simple_bin = get_simple_binary()
    simple_bin != "" and rt_file_exists(simple_bin)

val _has_binary = _check_binary_available()

# ============================================================================
# AC-1: Unified test_main() function
# ============================================================================

use std.spec.step

# @manual_section: multi-mode test runner
describe "Multi-Mode Test Runner":
    describe "AC-1: Unified test_main function":
        it "TestRunResult struct has required fields":
            # @req REQ-multi_mode_test_runner
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): run aggregate fields pinned in the type source
            step("Bind the run aggregate fields to the type source")
            val types_source = file_read("src/lib/nogc_sync_mut/test_runner/test_runner_types.spl") ?? ""
            val has_passed_count = types_source.contains("total_passed")
            val has_failed_count = types_source.contains("total_failed")
            expect(has_passed_count).to_equal(true)  # oracle: the run aggregate must expose total_passed for reporting
            expect(has_failed_count).to_equal(true)  # oracle: the run aggregate must expose total_failed for reporting

        it "TestFileResult struct has path and counts":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): per-file result fields pinned in the type source
            step("Bind the per-file result fields to the type source")
            val types_source = file_read("src/lib/nogc_sync_mut/test_runner/test_runner_types.spl") ?? ""
            val has_setup_field = types_source.contains("setup_ms")
            val has_timeout_flag = types_source.contains("timed_out")
            expect(has_setup_field).to_equal(true)  # oracle: per-file results must carry the setup duration
            expect(has_timeout_flag).to_equal(true)  # oracle: per-file results must carry the timeout flag

        it "test_runner_types.spl exists with type definitions":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): type module presence verdict
            step("test_runner_types.spl exists with type definitions")
            val exists = rt_file_exists("src/lib/nogc_sync_mut/test_runner/test_runner_types.spl")
            expect(exists).to_equal(true)

        it "test_runner_main.spl exists as entry point":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): entry point module presence verdict
            step("test_runner_main.spl exists as entry point")
            val exists = rt_file_exists("src/lib/nogc_sync_mut/test_runner/test_runner_main.spl")
            expect(exists).to_equal(true)

        it "test_runner_execute.spl exists with execution modes":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): execution module presence verdict
            step("test_runner_execute.spl exists with execution modes")
            val exists = rt_file_exists("src/lib/nogc_sync_mut/test_runner/test_runner_execute.spl")
            expect(exists).to_equal(true)

        it "runner accepts CLI args and lists specs in interpreter mode":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): --list invocation output presence
            step("runner accepts CLI args and lists specs in interpreter mode")
            if not _has_binary:
                expect(_has_binary).to_equal(false)
            else:
                val binary = get_simple_binary()
                # Run test runner with --list to verify arg acceptance without executing tests
                val r = _run(binary, ["test", "--list", "test/unit/lib/"])
                # --list should succeed (exit 0) or produce recognizable output
                val has_output = r.stdout.len() > 0 or r.stderr.len() > 0
                expect(has_output).to_equal(true)

    # ========================================================================
    # AC-2: Mode selection via CLI
    # ========================================================================

    describe "AC-2: Mode selection via CLI":
        it "parse_mode_str recognizes interpreter as default":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): default mode seed pinned in the args source
            step("parse_mode_str recognizes interpreter as default")
            val args_source = file_read("src/lib/nogc_sync_mut/test_runner/test_runner_args.spl") ?? ""
            val interpreter_is_default = args_source.contains("var mode = TestExecutionMode.Interpreter")
            expect(interpreter_is_default).to_equal(true)  # oracle: parse_test_args must seed Interpreter before any flag override

        it "parse_mode_str recognizes native mode":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): native mode aliases pinned in the args source
            step("parse_mode_str recognizes native mode")
            val args_source = file_read("src/lib/nogc_sync_mut/test_runner/test_runner_args.spl") ?? ""
            val native_is_parsed = args_source.contains("\"native\"")
            val binary_alias_admitted = args_source.contains("\"binary\"")
            expect(native_is_parsed).to_equal(true)  # oracle: the native alias must select TestExecutionMode.Native
            expect(binary_alias_admitted).to_equal(true)  # oracle: the binary alias must select TestExecutionMode.Native

        it "parse_mode_str recognizes smf/loader mode":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): smf and loader aliases pinned in the args source
            step("parse_mode_str recognizes smf/loader mode")
            val args_source = file_read("src/lib/nogc_sync_mut/test_runner/test_runner_args.spl") ?? ""
            val smf_is_parsed = args_source.contains("\"smf\"")
            val loader_is_parsed = args_source.contains("\"loader\"")
            expect(smf_is_parsed).to_equal(true)  # oracle: the smf alias must map to TestExecutionMode.Smf
            expect(loader_is_parsed).to_equal(true)  # oracle: the loader alias must map to TestExecutionMode.Smf

        it "parse_mode_str recognizes composite baremetal specs":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): composite keywords pinned for spec routing
            step("parse_mode_str recognizes composite baremetal specs")
            # Strings containing "baremetal", "remote", or "container"
            # are parsed as TestExecutionMode.Composite(spec)
            val composite_keywords = ["baremetal", "remote", "container"]
            expect(composite_keywords).to_contain("baremetal")
            expect(composite_keywords).to_contain("remote")

        it "execution-mode flag is parsed from CLI args":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): --execution-mode flag acceptance verdict
            step("execution-mode flag is parsed from CLI args")
            # --execution-mode=<mode> or --execution-mode <mode>
            # Verified in test_runner_args.spl line 156-161
            if not _has_binary:
                expect(_has_binary).to_equal(false)
            else:
                val binary = get_simple_binary()
                # Verify the flag is recognized (not rejected as unknown)
                val r = _run(binary, ["test", "--list", "--execution-mode=interpreter", "test/unit/lib/"])
                # Should not produce "unknown flag" error
                val no_unknown_flag = not r.stderr.contains("unknown flag")
                expect(no_unknown_flag).to_equal(true)

        it "TestExecutionMode enum has four variants":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): required execution mode variant list
            step("TestExecutionMode enum has four variants")
            # Interpreter, Smf, Native, Composite(spec: text)
            val variants = ["Interpreter", "Smf", "Native", "Composite"]
            expect(variants.len()).to_equal(4)  # oracle: 4 — pinned expected value for this behavior

