            val main_source = file_read("src/lib/nogc_sync_mut/test_runner/test_runner_main.spl") ?? ""
            val single_entry_main = main_source.contains("fn main")
            expect(single_entry_main).to_equal(true)  # oracle: startup must begin at the single main entry before discovery

        it "TestOptions has execution_mode field for init context":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): execution_mode field pinned in the args source
            step("TestOptions has execution_mode field for init context")
            val args_source = file_read("src/lib/nogc_sync_mut/test_runner/test_runner_args.spl") ?? ""
            val options_carry_execution_mode = args_source.contains("execution_mode")
            expect(options_carry_execution_mode).to_equal(true)  # oracle: parsed options must retain the execution mode for run context

