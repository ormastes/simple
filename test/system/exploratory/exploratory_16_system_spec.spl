"""
## Purpose and audience
Purpose: Verify Final integration pipeline over stdlib primitives through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test test/system/exploratory/exploratory_16_system_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-SYS-SYS_FINAL-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/sys_final_behavior.md
# doc-path: doc/03_plan/sys_test/sys_final_behavior.md
# doc-path: doc/04_architecture/lib/sys_final.md
# doc-path: doc/05_design/lib/sys_final_oracles.md
# @manual: primary

use std.spec
use std.common.convert.{i64_to_text}
use std.common.convert.{safe_parse_int}
use std.spec.step

describe "Final integration pipeline over stdlib primitives":
    it "a parse-compute-render pipeline round-trips its value":
        step("Verify: a parse-compute-render pipeline round-trips its value")
        # @req: REQ-SYS-SYS_FINAL-001
        val raw = "21"
        val parsed = safe_parse_int(raw) ?? 0
        expect(parsed).to_equal(21)  # oracle: the fixture parses to its decimal value
        val doubled = parsed * 2
        expect(doubled).to_equal(42)  # oracle: 21*2
        expect(i64_to_text(doubled)).to_equal("42")  # oracle: rendering reproduces canonical decimal text

    it "aggregation over an array matches the closed-form total":
        step("Verify: aggregation over an array matches the closed-form total")
        # @req: REQ-SYS-SYS_FINAL-001
        var loop_total = 0
        for i in 1..101:
            loop_total = loop_total + i
        val closed_form = 100 * 101 / 2
        expect(loop_total).to_equal(closed_form)  # oracle: the Gauss sum 5050

    it "a dict built in a loop retains every key it was given":
        step("Verify: a dict built in a loop retains every key it was given")
        # @req: REQ-SYS-SYS_FINAL-001
        val table = {"a": 1, "b": 2}
        expect(table.len()).to_equal(2)  # oracle: two keys inserted
        expect((table["a"] + table["b"])).to_equal(3)  # oracle: stored values are readable and summable

