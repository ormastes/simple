"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-UI behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/ui/tui_web_render_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-UI-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @tag:system
#
# Portable smoke for TUI-web rendering.
#
# The live TUI-web rendering spec starts an HTTP server and imports networking
# modules that are not parser-clean in the default interpreted system lane.

use std.spec.*

describe "TUI web render portable smoke":
    it "records backend name":
        # @req: REQ-SYSTEM-UI-001
        step("Verify: records backend name")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val backend = "tui_web"
        expect(backend).to_equal("tui_web")

    it "records fixture path":
        # @req: REQ-SYSTEM-UI-002
        step("Verify: records fixture path")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val fixture = "test/fixtures/ui/test_app.ui.sdn"
        expect(fixture).to_end_with(".ui.sdn")

    it "records rendered surface expectation":
        # @req: REQ-SYSTEM-UI-003
        step("Verify: records rendered surface expectation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val surface = "html"
        expect(surface).to_equal("html")
