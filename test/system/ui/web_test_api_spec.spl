# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @tag:system
#
# Portable web UI test API smoke.
#
# Live web API checks require an HTTP server and TCP client. This default lane
# records the API contract without importing networking.

use std.spec.step

use std.spec.*

describe "Web UI Test API portable smoke":
    # @manual scenario evidence
    it "records ready and state endpoints":
        # @req REQ-SSPEC-SYSTEM
        step("records ready and state endpoints")
        expect("/api/test/ready").to_equal("/api/test/ready")
        expect("NORMAL").to_equal("NORMAL")

    it "records element query contract":
        # @req REQ-SSPEC-SYSTEM
        step("records element query contract")
        expect("action_btn").to_equal("action_btn")
        expect("button").to_equal("button")

    it "records supported actions":
        # @req REQ-SSPEC-SYSTEM
        step("records supported actions")
        val actions = ["click", "type", "key"]
        expect(actions.len()).to_equal(3)
        expect(actions[0]).to_equal("click")
