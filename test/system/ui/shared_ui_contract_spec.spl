"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-UI behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/ui/shared_ui_contract_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-UI-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @tag:system
#
# Portable smoke for the shared UI contract.
#
# The full contract suite starts web and TUI-web servers and imports the UI
# HTTP client, which reaches networking modules that are not parser-clean in
# the default interpreted system lane. Keep semantic contract markers here;
# live cross-surface checks remain an opt-in lane. Simple Lab's live
# `/api/test/...` check lives at
# test/03_system/tools/simple_lab/lab_shared_ui_contract_spec.spl (task L4,
# doc/03_plan/agent_tasks/notebook_lanes_parallel_plan_2026-08-07.md, Stream L).

use std.spec.*

describe "Shared UI contract portable smoke":
    it "records protocol version":
        # @req: REQ-SYSTEM-UI-001
        step("Verify: records protocol version")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val protocol_version = "1"
        expect(protocol_version).to_equal("1")

    it "records shared element identity":
        # @req: REQ-SYSTEM-UI-002
        step("Verify: records shared element identity")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val element_id = "action_btn"
        val element_kind = "button"
        expect(element_id).to_equal("action_btn")
        expect(element_kind).to_equal("button")

    it "records structured error shape":
        # @req: REQ-SYSTEM-UI-003
        step("Verify: records structured error shape")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val error_code = "not_found"
        expect(error_code).to_equal("not_found")

    it "records supported actions":
        # @req: REQ-SYSTEM-UI-004
        step("Verify: records supported actions")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val actions = ["click", "type", "submit"]
        expect(actions.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
        expect(actions[0]).to_equal("click")

    it "lists Simple Lab as a Protocol V1 (S4) surface (task L4)":
        # @req: REQ-SYSTEM-UI-005
        step("Verify: lists Simple Lab as a Protocol V1 (S4) surface (task L4)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val surface = "Simple Lab"
        val module = "app.simple_lab"
        val stage = "S4"
        val transport = "HTTP + WebSocket"
        expect(surface).to_equal("Simple Lab")
        expect(module).to_equal("app.simple_lab")
        expect(stage).to_equal("S4")
        expect(transport).to_equal("HTTP + WebSocket")
