# @tag:system
# @cover src/lib/nogc_async_mut_noalloc/tls/x25519.spl 80%
# 80% is the required decision-coverage floor, not a measured result.
# Matches the existing x25519_rfc7748_kat_spec.spl owner requirement.
# RFC values copied from test/01_unit/lib/common/crypto/x25519_rfc7748_kat_spec.spl.
# These probes exercise product calls; coverage instrumentation must verify the floor.
use std.spec.*
use src.lib.nogc_async_mut_noalloc.tls.x25519.{x25519, x25519_pubkey}

fn probe_scalar() -> [u8]:
    [
        0x77u8, 0x07u8, 0x6du8, 0x0au8, 0x73u8, 0x18u8, 0xa5u8, 0x7du8,
        0x3cu8, 0x16u8, 0xc1u8, 0x72u8, 0x51u8, 0xb2u8, 0x66u8, 0x45u8,
        0xdfu8, 0x4cu8, 0x2fu8, 0x87u8, 0xebu8, 0xc0u8, 0x99u8, 0x2au8,
        0xb1u8, 0x77u8, 0xfbu8, 0xa5u8, 0x1du8, 0xb9u8, 0x2cu8, 0x2au8
    ]

fn probe_peer() -> [u8]:
    [
        0xdeu8, 0x9eu8, 0xdbu8, 0x7du8, 0x7bu8, 0x7du8, 0xc1u8, 0xb4u8,
        0xd3u8, 0x5bu8, 0x61u8, 0xc2u8, 0xecu8, 0xe4u8, 0x35u8, 0x37u8,
        0x3fu8, 0x83u8, 0x43u8, 0xc8u8, 0x5bu8, 0x78u8, 0x67u8, 0x4du8,
        0xadu8, 0xfcu8, 0x7eu8, 0x14u8, 0x6fu8, 0x88u8, 0x2bu8, 0x4fu8
    ]

fn expected_shared_secret() -> [u8]:
    [
        0x4au8, 0x5du8, 0x9du8, 0x5bu8, 0xa4u8, 0xceu8, 0x2du8, 0xe1u8,
        0x72u8, 0x8eu8, 0x3bu8, 0xf4u8, 0x80u8, 0x35u8, 0x0fu8, 0x25u8,
        0xe0u8, 0x7eu8, 0x21u8, 0xc9u8, 0x47u8, 0xd1u8, 0x9eu8, 0x33u8,
        0x76u8, 0xf0u8, 0x9bu8, 0x3cu8, 0x1eu8, 0x16u8, 0x17u8, 0x42u8
    ]

describe "X25519 caller input preservation":
    it "derives the RFC secret without changing either caller input":
        val scalar = probe_scalar()
        val peer = probe_peer()
        val secret = x25519(scalar, peer)
        expect(secret).to_equal(expected_shared_secret())
        expect(scalar).to_equal(probe_scalar())
        expect(peer).to_equal(probe_peer())
