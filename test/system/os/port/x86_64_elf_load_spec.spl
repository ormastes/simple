# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

## Lint-only spec: x86_64 fs-exec-spawn contract (P0-B1).
## Behavioural run blocks on P0-C QEMU smoke (disk image + VFS mount).
## Run: bin/simple test test/system/os/port/x86_64_elf_load_spec.spl

use std.spec.step

use std.spec
use os.kernel.loader.x86_64_fs_exec_spawn.{x86_64_fs_exec_spawn_hello_world_smf}
use os.kernel.arch.arch_context.{Architecture}

extern fn rt_env_get(key: text) -> text

fn simpleos_runtime() -> text:
    val sr = rt_env_get("SIMPLEOS_RUNTIME")
    if sr == nil:
        ""
    else:
        sr

describe "x86_64 fs-exec-spawn loader contract":
    # @manual scenario evidence
    """
    Validates symbol resolution for the x86_64 filesystem-exec scheduler bridge.
    Lint-only until P0-C QEMU smoke wires disk image + VFS mount.
    """

    it "x86_64_fs_exec_spawn_hello_world_smf resolves and Architecture.X86_64 is reachable":
        # @req REQ-SSPEC-SYSTEM
        step("x86_64_fs_exec_spawn_hello_world_smf resolves and Architecture.X86_64 is reachable")
        """
        Confirms import path os.kernel.loader.x86_64_fs_exec_spawn is lint-clean
        and Architecture.X86_64 enum variant exists. Function is not invoked —
        VFS + scheduler require kernel context.
        """
        val sr = simpleos_runtime()
        if sr == "":
            return "skip: SIMPLEOS_RUNTIME not set — lint-only validation passed"
        val arch = Architecture.X86_64
        assert_equal(arch, Architecture.X86_64)
        if false:
            val _pid = x86_64_fs_exec_spawn_hello_world_smf()
        return "skip: behavioural run blocked on P0-C QEMU smoke"
