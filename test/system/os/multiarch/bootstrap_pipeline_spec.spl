# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Multi-arch harden: AC-6 — bootstrap-from-scratch.sh --arch=<triple>.
#
# Phase 5 adds the --arch dispatch; Phase 7 produces per-arch result
# files at build/multiarch/<triple>/bootstrap_result.json.
#
# Run:
#   bin/simple test test/system/os/multiarch/bootstrap_pipeline_spec.spl
#
# @cover scripts/bootstrap/bootstrap-from-scratch.sh
# @cover src/os/qemu_runner.spl
# @cover src/lib/nogc_sync_mut/spec.spl

use std.spec.step

use std.spec
use std.io_runtime.{file_exists, file_read}

fn _bootstrap_path(triple: text) -> text:
    "build/multiarch/" + triple + "/bootstrap_result.json"

describe "AC-6 — x86_64 bootstrap lane succeeds":
    # @manual scenario evidence
    it "result file exists":
        # @req REQ-SSPEC-SYSTEM
        step("result file exists")
        expect(file_exists(_bootstrap_path("x86_64"))).to_equal(true)
    it "exit code is 0":
        # @req REQ-SSPEC-SYSTEM
        step("exit code is 0")
        val r: text = file_read(_bootstrap_path("x86_64"))
        expect(r.contains("\"exit_code\": 0")).to_equal(true)
    it "bootable image artifact path is recorded":
        # @req REQ-SSPEC-SYSTEM
        step("bootable image artifact path is recorded")
        val r: text = file_read(_bootstrap_path("x86_64"))
        expect(r.contains("\"image_path\"")).to_equal(true)
    it "post-deploy smoke is green":
        # @req REQ-SSPEC-SYSTEM
        step("post-deploy smoke is green")
        val r: text = file_read(_bootstrap_path("x86_64"))
        expect(r.contains("\"smoke_status\": \"pass\"")).to_equal(true)
    it "uses Limine boot loader":
        # @req REQ-SSPEC-SYSTEM
        step("uses Limine boot loader")
        val r: text = file_read(_bootstrap_path("x86_64"))
        expect(r.contains("\"loader\": \"limine\"")).to_equal(true)

describe "AC-6 — i686 bootstrap lane succeeds":
    it "result file exists":
        # @req REQ-SSPEC-SYSTEM
