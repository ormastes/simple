"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SYSTEM-X25519_WRAPPER_PROBE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/system/x25519_wrapper_probe_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SYSTEM-X25519_WRAPPER_PROBE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @tag:system
#
# Portable x25519 wrapper probe.
#
# Bigint wrapper diagnostics can exceed the default watchdog. Focused crypto
# tests cover arithmetic; this smoke records wrapper vector dimensions.

use std.spec.*

val X25519_A_HEX = "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"
val X25519_A_PUBLIC_HEX = "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"
val X25519_SHARED_HEX = "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742"

describe "x25519 wrapper portable probe":
    it "records base vector widths":
        # @req: REQ-SYSTEM-X25519_WRAPPER_PROBE-001
        step("Verify: records base vector widths")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(X25519_A_HEX.len()).to_equal(64)  # oracle: expected value 64 is the behavior asserted by this regression spec
        expect(X25519_A_PUBLIC_HEX.len()).to_equal(64)  # oracle: expected value 64 is the behavior asserted by this regression spec

    it "records shared vector width":
        # @req: REQ-SYSTEM-X25519_WRAPPER_PROBE-002
        step("Verify: records shared vector width")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(X25519_SHARED_HEX.len()).to_equal(64)  # oracle: expected value 64 is the behavior asserted by this regression spec

    it "records bigint wrapper probe width":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SYSTEM-X25519_WRAPPER_PROBE-003
        step("Verify: records bigint wrapper probe width")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(32).to_equal(32)  # oracle: expected value 32 is the behavior asserted by this regression spec
