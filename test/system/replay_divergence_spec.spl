# ============================================================================
# DivergenceRecord construction
# ============================================================================

describe "DivergenceRecord":
    it "fields are accessible after construction":
        step("Verify: fields are accessible after construction")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        clear_divergences()
        report_divergence(DivergenceKind.ScheduleMismatch, 42, 100, 200)
        val rec = get_divergence(0)
        match rec:
            case Some(r):
                expect(r.event_id).to_equal(42)  # oracle: value fixed by the spec contract
                expect(r.expected).to_equal(100)  # oracle: value fixed by the spec contract
                expect(r.actual).to_equal(200)  # oracle: value fixed by the spec contract
                expect(r.kind.to_i32()).to_equal(DivergenceKind.ScheduleMismatch.to_i32())
            case None:
                expect(false).to_equal(true)

# ============================================================================
# report_divergence logs correctly
# ============================================================================

describe "report_divergence":
    it "logs a single divergence":
        step("Verify: logs a single divergence")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        clear_divergences()
        report_divergence(DivergenceKind.SyscallMismatch, 10, 50, 60)
        expect(get_divergence_count()).to_equal(1)  # oracle: value fixed by the spec contract

    it "records expected and actual values":
        step("Verify: records expected and actual values")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        clear_divergences()
        report_divergence(DivergenceKind.IrqMismatch, 7, 300, 400)
        val rec = get_divergence(0)
        match rec:
            case Some(r):
                expect(r.expected).to_equal(300)  # oracle: value fixed by the spec contract
                expect(r.actual).to_equal(400)  # oracle: value fixed by the spec contract
            case None:
                expect(false).to_equal(true)

# ============================================================================
# get_divergence_count
# ============================================================================

describe "get_divergence_count":
    it "starts at zero after clear":
        step("Verify: starts at zero after clear")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        clear_divergences()
        expect(get_divergence_count()).to_equal(0)  # oracle: value fixed by the spec contract

    it "increments on each report":
        step("Verify: increments on each report")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        clear_divergences()
        report_divergence(DivergenceKind.TimerMismatch, 1, 10, 20)
        expect(get_divergence_count()).to_equal(1)  # oracle: value fixed by the spec contract
        report_divergence(DivergenceKind.RandomMismatch, 2, 30, 40)
        expect(get_divergence_count()).to_equal(2)  # oracle: value fixed by the spec contract

# ============================================================================
# get_divergence retrieves by index
# ============================================================================

describe "get_divergence":
    it "returns Some for valid index":
        step("Verify: returns Some for valid index")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        clear_divergences()
        report_divergence(DivergenceKind.IpcMismatch, 5, 77, 88)
        val rec = get_divergence(0)
        match rec:
            case Some(r):
                expect(r.kind.to_i32()).to_equal(DivergenceKind.IpcMismatch.to_i32())
            case None:
                expect(false).to_equal(true)

    it "returns None for out-of-bounds index":
        step("Verify: returns None for out-of-bounds index")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        clear_divergences()
        val rec = get_divergence(99)
        match rec:
            case Some(r):
                expect(false).to_equal(true)
            case None:
                expect(true).to_equal(true)

    it "returns None for negative index":
        step("Verify: returns None for negative index")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        clear_divergences()
        val rec = get_divergence(-1)
        match rec:
            case Some(r):
                expect(false).to_equal(true)
            case None:
                expect(true).to_equal(true)

# ============================================================================
# clear_divergences
# ============================================================================

describe "clear_divergences":
    it "resets count to zero":
        step("Verify: resets count to zero")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        clear_divergences()
        report_divergence(DivergenceKind.ThreadMismatch, 1, 10, 20)
        report_divergence(DivergenceKind.CheckpointMismatch, 2, 30, 40)
        expect(get_divergence_count()).to_equal(2)  # oracle: value fixed by the spec contract
        clear_divergences()
        expect(get_divergence_count()).to_equal(0)  # oracle: value fixed by the spec contract

    it "clears the log so get_divergence returns None":
        step("Verify: clears the log so get_divergence returns None")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        clear_divergences()
        report_divergence(DivergenceKind.ScheduleMismatch, 1, 5, 6)
        clear_divergences()
        val rec = get_divergence(0)
        match rec:
            case Some(r):
                expect(false).to_equal(true)
            case None:
                expect(true).to_equal(true)

# ============================================================================
# has_diverged
# ============================================================================

describe "has_diverged":
    it "returns false when no divergences reported":
        step("Verify: returns false when no divergences reported")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        clear_divergences()
        expect(has_diverged()).to_equal(false)

    it "returns true after a divergence is reported":
        step("Verify: returns true after a divergence is reported")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        clear_divergences()
        report_divergence(DivergenceKind.SyscallMismatch, 1, 10, 20)
        expect(has_diverged()).to_equal(true)

    it "returns false after clear":
        step("Verify: returns false after clear")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        clear_divergences()
        report_divergence(DivergenceKind.IrqMismatch, 1, 10, 20)
        expect(has_diverged()).to_equal(true)
        clear_divergences()
        expect(has_diverged()).to_equal(false)

# ============================================================================
# Multiple divergences accumulate
# ============================================================================

describe "multiple divergences":
    it "accumulate in order":
        step("Verify: accumulate in order")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        clear_divergences()
        report_divergence(DivergenceKind.ScheduleMismatch, 1, 10, 11)
        report_divergence(DivergenceKind.SyscallMismatch, 2, 20, 22)
        report_divergence(DivergenceKind.IrqMismatch, 3, 30, 33)
        expect(get_divergence_count()).to_equal(3)  # oracle: value fixed by the spec contract

        val first = get_divergence(0)
        match first:
            case Some(r):
                expect(r.kind.to_i32()).to_equal(DivergenceKind.ScheduleMismatch.to_i32())
                expect(r.event_id).to_equal(1)  # oracle: value fixed by the spec contract
            case None:
                expect(false).to_equal(true)

        val second = get_divergence(1)
        match second:
            case Some(r):
                expect(r.kind.to_i32()).to_equal(DivergenceKind.SyscallMismatch.to_i32())
                expect(r.event_id).to_equal(2)  # oracle: value fixed by the spec contract
            case None:
                expect(false).to_equal(true)

        val third = get_divergence(2)
        match third:
            case Some(r):
                expect(r.kind.to_i32()).to_equal(DivergenceKind.IrqMismatch.to_i32())
                expect(r.event_id).to_equal(3)  # oracle: value fixed by the spec contract
            case None:
                expect(false).to_equal(true)
