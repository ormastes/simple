"""
## Purpose and audience
Purpose: ScheduleMismatch round-trips
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-REPLAY_DIVER-ReplDive-001

use std.spec
use os.kernel.replay.divergence.{DivergenceKind, DivergenceRecord, report_divergence, get_divergence_count, get_divergence, clear_divergences, has_diverged}

# ============================================================================
# DivergenceKind enum round-trips
# ============================================================================

use std.spec.step
describe "DivergenceKind to_i32 round-trip":
    it "ScheduleMismatch round-trips":
        step("Verify: ScheduleMismatch round-trips")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        val v = DivergenceKind.ScheduleMismatch.to_i32()
        expect(v).to_equal(0)  # oracle: value fixed by the spec contract
        expect(DivergenceKind.from_i32(v).to_i32()).to_equal(0)  # oracle: value fixed by the spec contract

    it "SyscallMismatch round-trips":
        step("Verify: SyscallMismatch round-trips")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        val v = DivergenceKind.SyscallMismatch.to_i32()
        expect(v).to_equal(1)  # oracle: value fixed by the spec contract
        expect(DivergenceKind.from_i32(v).to_i32()).to_equal(1)  # oracle: value fixed by the spec contract

    it "IrqMismatch round-trips":
        step("Verify: IrqMismatch round-trips")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        val v = DivergenceKind.IrqMismatch.to_i32()
        expect(v).to_equal(2)  # oracle: value fixed by the spec contract
        expect(DivergenceKind.from_i32(v).to_i32()).to_equal(2)  # oracle: value fixed by the spec contract

    it "TimerMismatch round-trips":
        step("Verify: TimerMismatch round-trips")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        val v = DivergenceKind.TimerMismatch.to_i32()
        expect(v).to_equal(3)  # oracle: value fixed by the spec contract
        expect(DivergenceKind.from_i32(v).to_i32()).to_equal(3)  # oracle: value fixed by the spec contract

    it "RandomMismatch round-trips":
        step("Verify: RandomMismatch round-trips")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        val v = DivergenceKind.RandomMismatch.to_i32()
        expect(v).to_equal(4)  # oracle: value fixed by the spec contract
        expect(DivergenceKind.from_i32(v).to_i32()).to_equal(4)  # oracle: value fixed by the spec contract

    it "IpcMismatch round-trips":
        step("Verify: IpcMismatch round-trips")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        val v = DivergenceKind.IpcMismatch.to_i32()
        expect(v).to_equal(5)  # oracle: value fixed by the spec contract
        expect(DivergenceKind.from_i32(v).to_i32()).to_equal(5)  # oracle: value fixed by the spec contract

    it "ThreadMismatch round-trips":
        step("Verify: ThreadMismatch round-trips")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        val v = DivergenceKind.ThreadMismatch.to_i32()
        expect(v).to_equal(6)  # oracle: value fixed by the spec contract
        expect(DivergenceKind.from_i32(v).to_i32()).to_equal(6)  # oracle: value fixed by the spec contract

    it "CheckpointMismatch round-trips":
        step("Verify: CheckpointMismatch round-trips")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        val v = DivergenceKind.CheckpointMismatch.to_i32()
        expect(v).to_equal(7)  # oracle: value fixed by the spec contract
        expect(DivergenceKind.from_i32(v).to_i32()).to_equal(7)  # oracle: value fixed by the spec contract

describe "DivergenceKind to_text":
    it "ScheduleMismatch to_text":
        step("Verify: ScheduleMismatch to_text")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
        expect(DivergenceKind.ScheduleMismatch.to_text()).to_equal("schedule-mismatch")

    it "SyscallMismatch to_text":
        step("Verify: SyscallMismatch to_text")
        # @req: REQ-REPLAY_DIVER-ReplDive-001
