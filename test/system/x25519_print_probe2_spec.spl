# @tag:system
# @cover src/lib/nogc_async_mut_noalloc/tls/x25519.spl 80%
# 80% is the required decision-coverage floor, not a measured result.
# Matches the existing x25519_rfc7748_kat_spec.spl owner requirement.
# RFC values copied from test/01_unit/lib/common/crypto/x25519_rfc7748_kat_spec.spl.
# These probes exercise product calls; coverage instrumentation must verify the floor.
use std.spec.*
use src.lib.nogc_async_mut_noalloc.tls.x25519.{x25519, x25519_pubkey}

fn probe_scalar() -> [u8]:
    [
        0x5du8, 0xabu8, 0x08u8, 0x7eu8, 0x62u8, 0x4au8, 0x8au8, 0x4bu8,
        0x79u8, 0xe1u8, 0x7fu8, 0x8bu8, 0x83u8, 0x80u8, 0x0eu8, 0xe6u8,
        0x6fu8, 0x3bu8, 0xb1u8, 0x29u8, 0x26u8, 0x18u8, 0xb6u8, 0xfdu8,
        0x1cu8, 0x2fu8, 0x8bu8, 0x27u8, 0xffu8, 0x88u8, 0xe0u8, 0xebu8
    ]

fn expected_public_key() -> [u8]:
    [
        0xdeu8, 0x9eu8, 0xdbu8, 0x7du8, 0x7bu8, 0x7du8, 0xc1u8, 0xb4u8,
        0xd3u8, 0x5bu8, 0x61u8, 0xc2u8, 0xecu8, 0xe4u8, 0x35u8, 0x37u8,
        0x3fu8, 0x83u8, 0x43u8, 0xc8u8, 0x5bu8, 0x78u8, 0x67u8, 0x4du8,
        0xadu8, 0xfcu8, 0x7eu8, 0x14u8, 0x6fu8, 0x88u8, 0x2bu8, 0x4fu8
    ]

describe "X25519 Bob public key":
    it "matches the RFC 7748 public key exactly":
        expect(x25519_pubkey(probe_scalar())).to_equal(expected_public_key())
