"""
## Purpose and audience
Pins the observable execution contract of the CompilerComprehensive subsystem spec lane
(compiler_comprehensive_16_system_spec.spl): every scenario asserts a concrete language/stdlib outcome the runner
must report green for this subsystem spec to carry evidence weight.
Audience: compiler and test-infrastructure engineers triaging the CompilerComprehensive lane.
## Operator workflow
Run `bin/simple test test/system/compiler_comprehensive/compiler_comprehensive_16_system_spec.spl` and read the per-scenario verdicts in the
`Results:` summary; each scenario asserts one externally visible outcome.
## Compatibility and limitations
Covers interpreter-path semantics exercised by this lane; native codegen
and performance envelopes are out of scope.
# @manual: primary
REQ-SYS-CompilerComprehensive-001
doc/01_research/local/CompilerComprehensive_lane.md
doc/03_plan/sys_test/CompilerComprehensive_lane.md
doc/04_architecture/CompilerComprehensive_lane.md
doc/05_design/CompilerComprehensive_lane.md
"""
# @req: REQ-SYS-CompilerComprehensive-001
# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%

use std.spec

describe "CompilerComprehensive subsystem spec execution contract":
    it "boolean operators short-circuit to the pinned result":
        step("Verify: boolean operators short-circuit to the pinned result")
        # @req: REQ-SYS-CompilerComprehensive-001
        expect(true and false).to_equal(false)
        expect(true or false).to_equal(true)
        expect(not false).to_equal(true)

    it "dict lookup returns the stored value per key":
        step("Verify: dict lookup returns the stored value per key")
        # @req: REQ-SYS-CompilerComprehensive-002
        val d = {"alpha": 1, "beta": 2}
        expect(d["beta"]).to_equal(2) # oracle: value stored under "beta"
        expect(d["alpha"]).to_equal(1)

    it "reversal via index walk yields the mirrored array":
        step("Verify: reversal via index walk yields the mirrored array")
        # @req: REQ-SYS-CompilerComprehensive-003
        val src = [1, 2, 3, 4]
        var rev = []
        var i = src.len() - 1
        while i >= 0:
            rev.push(src[i])
            i = i - 1
        expect(rev.len()).to_equal(4) # oracle: reversal preserves length
        expect(rev[0]).to_equal(4) # oracle: last becomes first
        expect(rev[3]).to_equal(1)

    it "split reports every separator occurrence":
        step("Verify: split reports every separator occurrence")
        # @req: REQ-SYS-CompilerComprehensive-004
        val parts = "alpha,beta,gamma".split(",")
        expect(parts.len()).to_equal(3) # oracle: 2 separators split into 3 fields
        expect(parts[0]).to_equal("alpha")
        expect(parts[2]).to_equal("gamma")

    it "string concatenation length is the sum of parts":
        step("Verify: string concatenation length is the sum of parts")
        # @req: REQ-SYS-CompilerComprehensive-005
        val joined = "foo" + "bar"
        expect(joined).to_equal("foobar")
        expect(joined.len()).to_equal(6) # oracle: 3 + 3 chars

