"""
## Purpose and audience
Pins the observable execution contract of the CompilerComprehensive subsystem spec lane
(compiler_comprehensive_19_system_spec.spl): every scenario asserts a concrete language/stdlib outcome the runner
must report green for this subsystem spec to carry evidence weight.
Audience: compiler and test-infrastructure engineers triaging the CompilerComprehensive lane.
## Operator workflow
Run `bin/simple test test/system/compiler_comprehensive/compiler_comprehensive_19_system_spec.spl` and read the per-scenario verdicts in the
`Results:` summary; each scenario asserts one externally visible outcome.
## Compatibility and limitations
Covers interpreter-path semantics exercised by this lane; native codegen
and performance envelopes are out of scope.
# @manual: primary
REQ-SYS-CompilerComprehensive-001
doc/01_research/local/CompilerComprehensive_lane.md
doc/03_plan/sys_test/CompilerComprehensive_lane.md
doc/04_architecture/CompilerComprehensive_lane.md
doc/05_design/CompilerComprehensive_lane.md
"""
# @req: REQ-SYS-CompilerComprehensive-001
# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%

use std.spec

describe "CompilerComprehensive subsystem spec execution contract":
    it "arithmetic precedence binds multiplication before addition":
        step("Verify: arithmetic precedence binds multiplication before addition")
        # @req: REQ-SYS-CompilerComprehensive-001
        expect(2 + 3 * 4).to_equal(14) # oracle: precedence, not left-to-right (would be 20)
        expect((2 + 3) * 4).to_equal(20) # oracle: parenthesised grouping

    it "loop accumulation sums the inclusive range 0..4":
        step("Verify: loop accumulation sums the inclusive range 0..4")
        # @req: REQ-SYS-CompilerComprehensive-002
        var total = 0
        for i in 0..5:
            total = total + i
        expect(total).to_equal(10) # oracle: 0+1+2+3+4 = 10

    it "integer division and remainder follow truncation":
        step("Verify: integer division and remainder follow truncation")
        # @req: REQ-SYS-CompilerComprehensive-003
        expect(17 / 5).to_equal(3) # oracle: truncated quotient
        expect(17 % 5).to_equal(2) # oracle: remainder

    it "array push grows length and preserves order":
        step("Verify: array push grows length and preserves order")
        # @req: REQ-SYS-CompilerComprehensive-004
        var xs = [10]
        xs.push(20)
        xs.push(30)
        expect(xs.len()).to_equal(3) # oracle: 1 initial + 2 pushes
        expect(xs[1]).to_equal(20) # oracle: FIFO order preserved

    it "conditional branches select exactly one arm":
        step("Verify: conditional branches select exactly one arm")
        # @req: REQ-SYS-CompilerComprehensive-005
        val n = 7
        var tag = ""
        if n % 2 == 0:
            tag = "even"
        else:
            tag = "odd"
        expect(tag).to_equal("odd") # oracle: 7 is odd

