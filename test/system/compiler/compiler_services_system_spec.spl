        # @capture: assertion outcomes retained in the spec Results output as evidence
        val svc = create_default_services()
        val lower = svc.hir_lowerer.lower_fn
        val e1 = lower("module_a")
        val e2 = lower("module_b")
        expect(e1.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(e2.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

