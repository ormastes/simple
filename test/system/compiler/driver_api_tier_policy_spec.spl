# @cover src/compiler/80.driver/driver_api.spl 80%
# Driver API Tier Policy Guardrails - Structural Tests
#
# Verifies that the tiered driver API module structure follows dependency rules:
#   - Tier 0 (driver_api_types) has no compiler graph imports
#   - Facade (driver_api) does not import from driver_api_core
#   - __init__.spl uses explicit export use, not bare exports
#   - No upward tier dependencies (lower tiers must not import higher tiers)
#
# These are regression tests to prevent future helpers from quietly
# reintroducing heavy-path hangs.

"""
## Purpose and audience
Purpose: tier 0 driver_api_types has no compiler graph imports
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-COMPILER-DrivApiTierPoli-001

use std.spec

extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_exists(path: text) -> bool

fn read_file(path: text) -> text:
    rt_file_read_text(path) ?? ""

fn contains_import_line(content: text, pattern: text) -> bool:
    val lines = content.split("\n")
    var i = 0
    while i < lines.len():
        val line = lines[i].trim()
        if line != "" and not line.starts_with("#"):
            # `pub use` is an import line too — the driver tree migrated to it,
            # so omitting it made every positive check false and every
            # "does not import" check vacuously true.
            if (line.starts_with("use ") or line.starts_with("use lazy ") or line.starts_with("export use ") or line.starts_with("pub use ") or line.starts_with("pub use lazy ")) and line.contains(pattern):
                return true
        i = i + 1
    false

fn contains_line(content: text, pattern: text) -> bool:
    val lines = content.split("\n")
    var i = 0
    while i < lines.len():
        val line = lines[i].trim()
        if line != "" and not line.starts_with("#") and line.contains(pattern):
            return true
        i = i + 1
    false

fn count_exact_lines(content: text, expected_lines: [text]) -> i64:
    val lines = content.split("\n")
    var count = 0
    var i = 0
    while i < lines.len():
        val line = lines[i].trim()
        var j = 0
        while j < expected_lines.len():
            if line == expected_lines[j]:
                count = count + 1
                break
            j = j + 1
        i = i + 1
    count

use std.spec.step
describe "Driver API Tier Policy Guardrails":

    # ---------------------------------------------------------------
    # Tier 0: driver_api_types must be compiler-graph-free
    # ---------------------------------------------------------------

    it "tier 0 driver_api_types has no compiler graph imports":
        step("Verify: tier 0 driver_api_types has no compiler graph imports")
        # @req: REQ-COMPILER-DrivApiTierPoli-001
        val content = read_file("src/compiler/80.driver/driver_api_types.spl")
        val heavy_imports = [
            "compiler.hir", "compiler.mir", "compiler.backend",
            "compiler.frontend", "compiler.types", "compiler.mono",
            "compiler.borrow", "compiler.semantics", "compiler.tools",
            "compiler.mir_opt", "CompilerDriver"
        ]
        var i = 0
        while i < heavy_imports.len():
            expect(contains_import_line(content, heavy_imports[i])).to_equal(false)
            i = i + 1

    it "tier 0 driver_api_types exports find_runtime_lib_dir":
        step("Verify: tier 0 driver_api_types exports find_runtime_lib_dir")
        # @req: REQ-COMPILER-DrivApiTierPoli-001
        val content = rt_file_read_text("src/compiler/80.driver/driver_api_types.spl") ?? ""
        # The declaration carries its own visibility now (`pub fn`); the
        # separate `export` line form it used to need is gone.
        val exported = contains_line(content, "export find_runtime_lib_dir") or contains_line(content, "pub fn find_runtime_lib_dir")
        expect(exported).to_equal(true)

    # ---------------------------------------------------------------
    # Facade: driver_api must not import driver_api_core
    # ---------------------------------------------------------------

    it "facade driver_api does not import from driver_api_core":
        step("Verify: facade driver_api does not import from driver_api_core")
        # @req: REQ-COMPILER-DrivApiTierPoli-001
        val content = rt_file_read_text("src/compiler/80.driver/driver_api.spl") ?? ""
        expect(contains_import_line(content, "driver_api_core")).to_equal(false)

    it "facade driver_api delegates to lightweight public modules":
        step("Verify: facade driver_api delegates to lightweight public modules")
        # @req: REQ-COMPILER-DrivApiTierPoli-001
        val content = rt_file_read_text("src/compiler/80.driver/driver_api.spl") ?? ""
        expect(contains_line(content, "driver_public_compile")).to_equal(true)
        expect(contains_line(content, "driver_public_api")).to_equal(true)
        expect(contains_line(content, "driver_public_shared")).to_equal(true)

    # ---------------------------------------------------------------
    # __init__.spl uses explicit export use (no bare exports)
    # ---------------------------------------------------------------

    it "driver __init__.spl uses explicit export use statements":
        step("Verify: driver __init__.spl uses explicit export use statements")
        # @req: REQ-COMPILER-DrivApiTierPoli-001
        val content = rt_file_read_text("src/compiler/80.driver/__init__.spl") ?? ""
        val lines = content.split("\n")
        val allowed_shared_exports = [
            "export compiler_shared.backend.*",
            "export compiler_shared.blocks.*",
            "export compiler_shared.type_system.*",
            "export compiler_shared.hir.*",
            "export compiler_shared.mir.*",
            "export compiler_shared.error_explanations.*",
            "export compiler_shared.pattern_analysis.*",
            "export compiler_shared.semantics.*"
        ]
        var unexpected_bare_export_count = 0
        var explicit_export_use_count = 0
        var i = 0
        while i < lines.len():
            val line = lines[i].trim()
            if line != "" and not line.starts_with("#") and line.starts_with("export "):
                var matched_allowed = false
                var j = 0
                while j < allowed_shared_exports.len():
                    if line == allowed_shared_exports[j]:
                        matched_allowed = true
                        break
                    j = j + 1
                if line.starts_with("export use "):
                    explicit_export_use_count = explicit_export_use_count + 1
                elif not matched_allowed:
                    unexpected_bare_export_count = unexpected_bare_export_count + 1
            i = i + 1
        expect(unexpected_bare_export_count).to_equal(0)  # oracle: value fixed by the spec contract
        # The 8 `export compiler_shared.*` lines above were grandfathered bare
        # exports; the driver tree has since removed all of them, so requiring
        # them to still be present asserted the opposite of the invariant this
        # example is named for. Assert the end state instead: every export line
        # in the file is an explicit `export use`, and there is at least one.
        expect(count_exact_lines(content, allowed_shared_exports)).to_equal(0)  # oracle: value fixed by the spec contract
        expect(explicit_export_use_count).to_be_greater_than(0)

    # ---------------------------------------------------------------
    # No upward tier dependencies
    # ---------------------------------------------------------------

    it "tier 1 driver_api_interpret does not import from tier 2+":
        step("Verify: tier 1 driver_api_interpret does not import from tier 2+")
        # @req: REQ-COMPILER-DrivApiTierPoli-001
        val content = rt_file_read_text("src/compiler/80.driver/driver_api_interpret.spl") ?? ""
        val forbidden = [
            "driver_api_compile_single", "driver_api_codegen_backends",
            "driver_api_native_single", "driver_api_project_build"
        ]
        var i = 0
        while i < forbidden.len():
            expect(contains_import_line(content, forbidden[i])).to_equal(false)
            i = i + 1

    it "tier 2 driver_api_compile_single does not import from tier 3+":
        step("Verify: tier 2 driver_api_compile_single does not import from tier 3+")
        # @req: REQ-COMPILER-DrivApiTierPoli-001
        val content = rt_file_read_text("src/compiler/80.driver/driver_api_compile_single.spl") ?? ""
        val forbidden = [
            "driver_api_codegen_backends", "driver_api_native_single",
            "driver_api_project_build"
