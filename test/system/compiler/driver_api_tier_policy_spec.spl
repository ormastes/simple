    # ---------------------------------------------------------------
    # Type extraction verification
    # ---------------------------------------------------------------

    it "driver_core_types canonical source is in compiler.common":
        step("Verify: driver_core_types canonical source is in compiler.common")
        # @req: REQ-COMPILER-DrivApiTierPoli-001
        # 00.common/driver_core_types.spl is now itself a facade; the three
        # declarations live in sibling compiler.common modules. The invariant
        # under test is unchanged — the canonical source is under
        # compiler.common, never under 80.driver.
        val modes = rt_file_read_text("src/compiler/00.common/driver_core_modes.spl") ?? ""
        expect(contains_line(modes, "enum CompileMode")).to_equal(true)
        val result = rt_file_read_text("src/compiler/00.common/driver_compile_result.spl") ?? ""
        expect(contains_line(result, "enum CompileResult")).to_equal(true)
        val options = rt_file_read_text("src/compiler/00.common/driver_compile_options.spl") ?? ""
        expect(contains_line(options, "struct CompileOptions")).to_equal(true)
        # ... and the facade still re-exports all three.
        val facade = rt_file_read_text("src/compiler/00.common/driver_core_types.spl") ?? ""
        expect(contains_line(facade, "CompileMode")).to_equal(true)
        expect(contains_line(facade, "CompileResult")).to_equal(true)
        expect(contains_line(facade, "CompileOptions")).to_equal(true)

    it "driver_core_types shim in 80.driver re-exports from compiler.common":
        step("Verify: driver_core_types shim in 80.driver re-exports from compiler.common")
        # @req: REQ-COMPILER-DrivApiTierPoli-001
        val content = rt_file_read_text("src/compiler/80.driver/driver_core_types.spl") ?? ""
        expect(contains_import_line(content, "compiler.common.driver_core_types")).to_equal(true)
