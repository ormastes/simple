# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/lib/hardware/fpga_linux/fpga_linux_manifest.spl 80%
# @cover src/compiler/35.semantics/lint/riscv_rtl_debuggability_lint.spl 80%
"""
# Debug Sidecar JSON Key-Order Specification

**Feature IDs:** #rtl-mdsoc-reorg
**Category:** Infrastructure
**Difficulty:** 3/5
**Status:** Draft
**Requirements:** doc/02_requirements/feature/rtl_riscv_mdsoc_reorg.md
**Design:** doc/05_design/rtl_riscv_mdsoc_capsules.md
**Artifacts:** doc/09_report/verify/rtl_mdsoc_baseline_2026-05-02.md

## Overview

Verifies that the generated `*.debug.json` sidecar files produced by the FPGA
Linux generation scripts maintain their exact key order after the MDSOC
capsule reorganization.

The `debug_sidecar_json` function in `fpga_linux_manifest.spl` emits JSON via
string concatenation in literal source order. This is an immutable contract —
no serializer, no key shuffling allowed.

## Key Order Contract (AC-3, D-4)

Expected JSON key order:
1. `reportMarkers`
2. `runnerSuccessMarkers`
3. `sourceMap`
4. `proofLane` (header field)

The exact expected order is recorded in the baseline at:
`doc/09_report/verify/rtl_mdsoc_baseline_2026-05-02.md`

Pending: tests that require the baseline are gated on SA-1 creating it.

## Acceptance Criteria

- AC-3: *.debug.json sidecar contract preserved (reportMarkers,
  runnerSuccessMarkers byte-equivalent)
- AC-8: Verify in interpreter mode
"""

use std.spec

extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_read_text(path: text) -> text?
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn check_msg(condition: bool, msg: text):
    if not condition:
        expect(msg).to_equal("")

fn read_file(path: text) -> text:
    rt_file_read_text(path) ?? ""

fn baseline_path() -> text:
    "doc/09_report/verify/rtl_mdsoc_baseline_2026-05-02.md"

fn rv32_build_dir() -> text:
    "build/rtl_linux/generated_rv32"

fn rv64_build_dir() -> text:
    "build/rtl_linux/generated_rv64"

fn manifest_src_path() -> text:
    "src/lib/hardware/fpga_linux/fpga_linux_manifest.spl"

fn orchestrator_src_path() -> text:
    "src/lib/hardware/fpga_linux/fpga_linux_orchestrator.spl"

fn json_key_byte_offset(file_path: text, key: text) -> i64:
    # Use grep to find the byte offset of `"key":` in file_path.
    # Returns -1 if not found or on error.
    val search = "\"" + key + "\":"
    val cmd = "grep -Fboa '" + search + "' '" + file_path + "' 2>/dev/null | head -1 | cut -d: -f1"
    val (stdout, _stderr, code) = rt_process_run("sh", ["-c", cmd])
    if code != 0:
        return -1
    val trimmed = stdout.trim()
    if trimmed == "":
        return -1
    trimmed.to_i64() ?? -1

fn source_key_byte_offset(file_path: text, key: text) -> i64:
    # SPL source stores the JSON literal with escaped quotes, unlike output.
    val search = "\\\"" + key + "\\\":"
    val cmd = "grep -Fboa '" + search + "' '" + file_path + "' 2>/dev/null | head -1 | cut -d: -f1"
    val (stdout, _stderr, code) = rt_process_run("sh", ["-c", cmd])
    if code != 0:
        return -1
    stdout.trim().to_i64() ?? -1

fn source_key_offset(key: text) -> i64:
    # Find byte offset of `"key":` in fpga_linux_manifest.spl source.
    val path = manifest_src_path()
    if not rt_file_exists(path):
        return -1
    source_key_byte_offset(path, key)

fn debug_json_path(dir: text, lane: text) -> text:
    "{dir}/rtl/simple_{lane}gc_core.debug.json"

fn debug_json_key_offset(dir: text, lane: text, key: text) -> i64:
    # The canonical lane path rejects stale or unrelated sidecars.
    val json_path = debug_json_path(dir, lane)
    if json_path == "":
        return -1
    json_key_byte_offset(json_path, key)

fn file_sha256(path: text) -> text:
    val cmd = "sha256sum '" + path + "' 2>/dev/null | cut -d' ' -f1"
    val (stdout, _stderr, code) = rt_process_run("sh", ["-c", cmd])
    if code != 0:
        return ""
    stdout.trim()

fn baseline_debug_json_sha256(lane: text) -> text:
    val cmd = "grep -E '^debug_json_" + lane + "_sha256 = [0-9a-f]{64}$' '" + baseline_path() + "' 2>/dev/null | head -1 | cut -d' ' -f3"
    val (stdout, _stderr, code) = rt_process_run("sh", ["-c", cmd])
    if code != 0:
        return ""
    stdout.trim()

describe "Debug Sidecar JSON Key Order: source contract (AC-3, D-4)":
    """
    ## JSON Key-Order Source Contract

    Verifies that the manifest source file (fpga_linux_manifest.spl)
    contains `reportMarkers` before `runnerSuccessMarkers` before `sourceMap`
    in the `debug_sidecar_json` function body.
    These are static text-grep assertions that do not require SA-1 baseline.
    """

    it "AC-3: fpga_linux_manifest.spl contains reportMarkers key string":
        # @req REQ-SSPEC-SYSTEM
        step("AC-3: fpga_linux_manifest.spl contains reportMarkers key string")
        val path = manifest_src_path()
        check_msg(rt_file_exists(path), "file not found (SA-3 not run yet): " + path)
        val content = read_file(path)
        val has_key = content.contains("reportMarkers")
        expect(has_key).to_equal(true)

    it "AC-3: fpga_linux_manifest.spl contains runnerSuccessMarkers key string":
        # @req REQ-SSPEC-SYSTEM
        step("AC-3: fpga_linux_manifest.spl contains runnerSuccessMarkers key string")
        val path = manifest_src_path()
        check_msg(rt_file_exists(path), "file not found (SA-3 not run yet): " + path)
        val content = read_file(path)
        val has_key = content.contains("runnerSuccessMarkers")
        expect(has_key).to_equal(true)

    it "AC-3: reportMarkers appears before runnerSuccessMarkers in manifest source":
        # @req REQ-SSPEC-SYSTEM
        step("AC-3: reportMarkers appears before runnerSuccessMarkers in manifest source")
        val path = manifest_src_path()
        check_msg(rt_file_exists(path), "file not found (SA-3 not run yet): " + path)
        val pos_report = source_key_offset("reportMarkers")
        val pos_runner = source_key_offset("runnerSuccessMarkers")
        check_msg(pos_report >= 0, "reportMarkers not found in manifest source")
        check_msg(pos_runner >= 0, "runnerSuccessMarkers not found in manifest source")
        check_msg(pos_report < pos_runner, "reportMarkers must appear before runnerSuccessMarkers in source")
        expect(pos_report).to_be_less_than(pos_runner)

    it "AC-3: sourceMap appears after runnerSuccessMarkers in manifest source":
        # @req REQ-SSPEC-SYSTEM
        step("AC-3: sourceMap appears after runnerSuccessMarkers in manifest source")
        val path = manifest_src_path()
        check_msg(rt_file_exists(path), "file not found (SA-3 not run yet): " + path)
        val pos_runner = source_key_offset("runnerSuccessMarkers")
        val pos_source_map = source_key_offset("sourceMap")
        check_msg(pos_runner >= 0, "runnerSuccessMarkers not found in manifest source")
        check_msg(pos_source_map >= 0, "sourceMap not found in manifest source")
        check_msg(pos_runner < pos_source_map, "runnerSuccessMarkers must appear before sourceMap in source")
        expect(pos_runner).to_be_less_than(pos_source_map)

    it "AC-3: D-4 invariant — no json_ helper functions exist outside fpga_linux_manifest.spl":
        # @req REQ-SSPEC-SYSTEM
        step("AC-3: D-4 invariant — no json_ helper functions exist outside fpga_linux_manifest.spl")
        # The D-4 decision states all json_* helpers live exclusively in
        # fpga_linux_manifest.spl. Verify that fpga_linux_orchestrator.spl
        # does not contain json_ helper definitions.
        val path = orchestrator_src_path()
        check_msg(rt_file_exists(path), "file not found (SA-3 not run yet): " + path)
        val content = read_file(path)
        val has_json_helper = content.contains("fn json_")
        check_msg(not has_json_helper, "D-4 violation: json_ helper defined in orchestrator, must be in manifest only")
        expect(has_json_helper).to_equal(false)

describe "Debug Sidecar JSON Key Order: generated output (AC-3)":
    """
    ## Generated JSON Key Order in Build Output

    Tests that parse actual generated *.debug.json files from the build
    directory and verify key ordering. Pending until SA-1 baseline exists
    and SA-3 split is complete.
    """

    it "AC-3: RV32 generated debug.json key-order check is pending until SA-3 complete":
        # @req REQ-SSPEC-SYSTEM
        step("AC-3: RV32 generated debug.json key-order check is pending until SA-3 complete")
        expect(rt_file_exists(rv32_build_dir())).to_equal(true)

    it "AC-3: RV32 generated debug.json has reportMarkers key":
        # @req REQ-SSPEC-SYSTEM
        step("AC-3: RV32 generated debug.json has reportMarkers key")
        check_msg(rt_file_exists(rv32_build_dir()), "RV32 split-build output is missing")
        val pos = debug_json_key_offset(rv32_build_dir(), "rv32", "reportMarkers")
        check_msg(pos >= 0, "reportMarkers missing from generated debug.json in " + rv32_build_dir())
        expect(pos).to_be_greater_than(-1)

    it "AC-3: RV32 generated debug.json has runnerSuccessMarkers key":
        # @req REQ-SSPEC-SYSTEM
        step("AC-3: RV32 generated debug.json has runnerSuccessMarkers key")
        check_msg(rt_file_exists(rv32_build_dir()), "RV32 split-build output is missing")
        val pos = debug_json_key_offset(rv32_build_dir(), "rv32", "runnerSuccessMarkers")
        check_msg(pos >= 0, "runnerSuccessMarkers missing from generated debug.json in " + rv32_build_dir())
        expect(pos).to_be_greater_than(-1)

    it "AC-3: RV32 generated debug.json reportMarkers precedes runnerSuccessMarkers":
        # @req REQ-SSPEC-SYSTEM
        step("AC-3: RV32 generated debug.json reportMarkers precedes runnerSuccessMarkers")
        check_msg(rt_file_exists(rv32_build_dir()), "RV32 split-build output is missing")
        val pos_report = debug_json_key_offset(rv32_build_dir(), "rv32", "reportMarkers")
        val pos_runner = debug_json_key_offset(rv32_build_dir(), "rv32", "runnerSuccessMarkers")
        check_msg(pos_report >= 0, "reportMarkers not found in generated json")
        check_msg(pos_runner >= 0, "runnerSuccessMarkers not found in generated json")
        expect(pos_report).to_be_less_than(pos_runner)

    it "AC-3: RV64 generated debug.json key-order check is pending until SA-3 complete":
        # @req REQ-SSPEC-SYSTEM
        step("AC-3: RV64 generated debug.json key-order check is pending until SA-3 complete")
        expect(rt_file_exists(rv64_build_dir())).to_equal(true)

    it "AC-3: RV64 generated debug.json has reportMarkers key":
        # @req REQ-SSPEC-SYSTEM
        step("AC-3: RV64 generated debug.json has reportMarkers key")
        check_msg(rt_file_exists(rv64_build_dir()), "RV64 split-build output is missing")
        val pos = debug_json_key_offset(rv64_build_dir(), "rv64", "reportMarkers")
        check_msg(pos >= 0, "reportMarkers missing from generated debug.json in " + rv64_build_dir())
        expect(pos).to_be_greater_than(-1)

    it "AC-3: RV64 generated debug.json reportMarkers precedes runnerSuccessMarkers":
        # @req REQ-SSPEC-SYSTEM
        step("AC-3: RV64 generated debug.json reportMarkers precedes runnerSuccessMarkers")
        check_msg(rt_file_exists(rv64_build_dir()), "RV64 split-build output is missing")
        val pos_report = debug_json_key_offset(rv64_build_dir(), "rv64", "reportMarkers")
        val pos_runner = debug_json_key_offset(rv64_build_dir(), "rv64", "runnerSuccessMarkers")
        check_msg(pos_report >= 0, "reportMarkers not found in generated json")
        check_msg(pos_runner >= 0, "runnerSuccessMarkers not found in generated json")
        expect(pos_report).to_be_less_than(pos_runner)

describe "Debug Sidecar JSON Order: baseline comparison (AC-3)":
    """
    ## Baseline sha256 Comparison for Sidecar Files

    Compares sha256 of generated debug.json files against the SA-1 baseline.
    Pending until baseline file exists.
    """

    it "AC-3: baseline records canonical RV32 and RV64 debug.json hashes":
        # @req REQ-SSPEC-SYSTEM
        step("Read the SA-1 baseline document and require canonical lane hashes")
        check_msg(rt_file_exists(baseline_path()), "baseline file is missing")
        val baseline = read_file(baseline_path())
        val has_rv32_hash = baseline.contains("debug_json_rv32_sha256 = ")
        val has_rv64_hash = baseline.contains("debug_json_rv64_sha256 = ")
        check_msg(has_rv32_hash, "baseline missing canonical RV32 debug.json sha256")
        check_msg(has_rv64_hash, "baseline missing canonical RV64 debug.json sha256")
        expect(has_rv32_hash and has_rv64_hash).to_equal(true)

    it "AC-3: RV32 canonical debug.json sha256 equals the baseline":
        # @req REQ-SSPEC-SYSTEM
        step("Compare the canonical RV32 sidecar sha256 with its baseline")
        val expected = baseline_debug_json_sha256("rv32")
        val actual = file_sha256(debug_json_path(rv32_build_dir(), "rv32"))
        check_msg(expected != "", "baseline lacks a valid RV32 debug.json sha256")
        check_msg(actual != "", "canonical RV32 debug.json is missing or unreadable")
        expect(actual).to_equal(expected)

    it "AC-3: RV64 canonical debug.json sha256 equals the baseline":
        # @req REQ-SSPEC-SYSTEM
        step("Compare the canonical RV64 sidecar sha256 with its baseline")
        val expected = baseline_debug_json_sha256("rv64")
        val actual = file_sha256(debug_json_path(rv64_build_dir(), "rv64"))
        check_msg(expected != "", "baseline lacks a valid RV64 debug.json sha256")
        check_msg(actual != "", "canonical RV64 debug.json is missing or unreadable")
        expect(actual).to_equal(expected)
