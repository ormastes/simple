"""
## Purpose and audience
Purpose: Verify Correctness under repeated load through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test test/system/stress_3_system_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-SYS-SYS_STRESS-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/sys_stress_behavior.md
# doc-path: doc/03_plan/sys_test/sys_stress_behavior.md
# doc-path: doc/04_architecture/lib/sys_stress.md
# doc-path: doc/05_design/lib/sys_stress_oracles.md
# @manual: primary

use std.spec
use std.spec.step

describe "Correctness under repeated load":
    it "a 20000-iteration accumulation matches the closed form":
        step("Verify: a 20000-iteration accumulation matches the closed form")
        # @req: REQ-SYS-SYS_STRESS-001
        var total = 0
        var i = 1
        while i <= 20000:
            total = total + i
            i = i + 1
        expect(total).to_equal(20000 * 20001 / 2)  # oracle: the closed-form arithmetic-series total

    it "appending 2000 elements retains all of them":
        step("Verify: appending 2000 elements retains all of them")
        # @req: REQ-SYS-SYS_STRESS-001
        var xs: [i64] = []
        var j = 0
        while j < 2000:
            xs = xs.append(j)
            j = j + 1
        expect(xs.len()).to_equal(2000)  # oracle: every append is retained
        expect(xs[1999]).to_equal(1999)  # oracle: the final element is the last appended value

    it "building a long string by concatenation keeps its length linear":
        step("Verify: building a long string by concatenation keeps its length linear")
        # @req: REQ-SYS-SYS_STRESS-001
        var s = ""
        var k = 0
        while k < 500:
            s = s + "ab"
            k = k + 1
        expect(s.len()).to_equal(1000)  # oracle: 500 concatenations of a 2-character unit

