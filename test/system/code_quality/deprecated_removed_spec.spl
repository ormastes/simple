# @cover src/lib/nogc_sync_mut/path.spl 80%
# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# Deprecated Items Removed Spec

**Feature IDs:** fix-allow-suppressions
**Category:** Testing
**Difficulty:** 1/5
**Status:** In Progress
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A
**Artifacts:** N/A

## Overview

Canary spec for AC-5: exercises supported collection and text APIs alongside
the deprecated-method removal work. HashSet is the production set type.

NOTE: These specs verify the *replacement method works*. They cannot directly
assert that the deprecated method is gone — that is a grep gate at phase 7-verify:
  `rg -F '@deprecated' src/lib/nogc_sync_mut/ src/compiler_rust/lib/std/src/`
should return zero results after Team G completes.

These specs exercise HashSet.contains / intersect / diff / sym_diff, Map.has,
String.upper / lower / each, List.each, and Path.ext.
Behavioral verification requires the qualified self-hosted runtime. Their purpose
is to lock the replacement contract so it cannot regress.
"""

use std.spec.step

use std.spipe.*
use std.text.{each as text_each}
use std.common.iterable.{each}
use std.nogc_sync_mut.src.collections.hashset.{HashSet}
use std.nogc_sync_mut.src.collections.hashmap.{HashMap}
use std.nogc_sync_mut.path.{extension}


# ============================================================================
# Set replacement methods (AC-5)
# ============================================================================

describe "AC-5 Set deprecated replacements":
    # @manual scenario evidence
    """
    ## HashSet.contains, intersect, diff, sym_diff

    Exercises the production HashSet membership and algebra methods:
    - contains: membership
    - intersection: common elements
    - difference: elements unique to the left operand
    - symmetric_difference: elements in exactly one operand
    """

    it "AC-5: HashSet.contains returns true for a member element":
        # @req REQ-SSPEC-SYSTEM
        step("AC-5: HashSet.contains returns true for a member element")
        var s = HashSet.new()
        s.insert("Alice")
        expect(s.contains("Alice")).to_equal(true)

    it "AC-5: HashSet.contains returns false for a missing element":
        # @req REQ-SSPEC-SYSTEM
        step("AC-5: HashSet.contains returns false for a missing element")
        var s = HashSet.new()
        s.insert("Alice")
        expect(s.contains("Bob")).to_equal(false)

    it "AC-5: HashSet.intersection returns common elements only":
        # @req REQ-SSPEC-SYSTEM
        step("AC-5: HashSet.intersection returns common elements only")
        var a = HashSet.new()
        a.insert("x")
        a.insert("y")
        var b = HashSet.new()
        b.insert("y")
        b.insert("z")
        val result = a.intersection(b)
        expect(result.contains("y")).to_equal(true)
        expect(result.contains("x")).to_equal(false)
        expect(result.contains("z")).to_equal(false)

    it "AC-5: HashSet.difference returns elements only in self":
        # @req REQ-SSPEC-SYSTEM
        step("AC-5: HashSet.difference returns elements only in self")
        var a = HashSet.new()
        a.insert("x")
        a.insert("y")
        var b = HashSet.new()
        b.insert("y")
        b.insert("z")
        val result = a.difference(b)
        expect(result.contains("x")).to_equal(true)
        expect(result.contains("y")).to_equal(false)
        expect(result.contains("z")).to_equal(false)

    it "AC-5: HashSet.symmetric_difference returns elements in exactly one set":
        # @req REQ-SSPEC-SYSTEM
        step("AC-5: HashSet.symmetric_difference returns elements in exactly one set")
        var a = HashSet.new()
        a.insert("x")
        a.insert("y")
        var b = HashSet.new()
        b.insert("y")
        b.insert("z")
        val result = a.symmetric_difference(b)
        expect(result.contains("x")).to_equal(true)
        expect(result.contains("z")).to_equal(true)
        expect(result.contains("y")).to_equal(false)


# ============================================================================
# Map replacement methods (AC-5)
# ============================================================================

describe "AC-5 Map deprecated replacements":
    """
    ## Map.has

    Verifies the replacement for the deprecated Map.contains_key method.
    - contains_key -> has
    """

    it "AC-5: Map.has returns true when key present":
        # @req REQ-SSPEC-SYSTEM
        step("AC-5: Map.has returns true when key present")
        var m = HashMap.new()
        m.insert("name", "Alice")
        expect(m.has("name")).to_equal(true)

    it "AC-5: Map.has returns false when key absent":
        # @req REQ-SSPEC-SYSTEM
        step("AC-5: Map.has returns false when key absent")
        var m = HashMap.new()
        m.insert("name", "Alice")
        expect(m.has("age")).to_equal(false)


# ============================================================================
# String replacement methods (AC-5)
# ============================================================================

describe "AC-5 String deprecated replacements":
    """
    ## String.upper, lower, each

    Verifies the replacements for deprecated toUpperCase, toLowerCase, forEach.
    - toUpperCase -> upper
    - toLowerCase -> lower
    - forEach -> each
    """

    it "AC-5: String.upper converts to uppercase":
        # @req REQ-SSPEC-SYSTEM
        step("AC-5: String.upper converts to uppercase")
        val s = "hello"
        expect(s.upper()).to_equal("HELLO")

    it "AC-5: String.lower converts to lowercase":
        # @req REQ-SSPEC-SYSTEM
        step("AC-5: String.lower converts to lowercase")
        val s = "WORLD"
        expect(s.lower()).to_equal("world")

    it "AC-5: String.each iterates over characters":
        # @req REQ-SSPEC-SYSTEM
        step("AC-5: String.each iterates over characters")
        val s = "abc"
        var seen: [text] = []
        text_each(s, \c:
            seen.push(c.to_string())
        )
        expect(seen.len()).to_equal(3)


# ============================================================================
# List replacement methods (AC-5)
# ============================================================================

describe "AC-5 List deprecated replacements":
    """
    ## List.each

    Verifies the replacement for deprecated List.forEach.
    - forEach -> each
    """

    it "AC-5: List.each iterates over all elements":
        # @req REQ-SSPEC-SYSTEM
        step("AC-5: List.each iterates over all elements")
        val items = [1, 2, 3]
        var seen: [i64] = []
        each(items, \n:
            seen.push(n)
        )
        var sum = 0
        for n in seen:
            sum = sum + n
        expect(sum).to_equal(6)


# ============================================================================
# Path replacement methods (AC-5)
# ============================================================================

describe "AC-5 Path deprecated replacements":
    """
    ## path.extension

    Verifies the supported replacement surface for file-extension lookup.
    - Path.extension -> path.extension(text)
    """

    it "AC-5: Path.ext returns the file extension":
        # @req REQ-SSPEC-SYSTEM
        step("AC-5: Path.ext returns the file extension")
        expect(extension("report.md")).to_equal("md")

    it "AC-5: Path.ext returns empty string for no extension":
        # @req REQ-SSPEC-SYSTEM
        step("AC-5: Path.ext returns empty string for no extension")
        expect(extension("Makefile")).to_equal("")
