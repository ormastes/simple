"""
# List.iter() Deprecation Replacement Spec

**Feature IDs:** fix-foreach-deprecated
**Category:** Testing
**Difficulty:** 1/5
**Status:** In Progress
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A
**Artifacts:** N/A

## Overview

Canary spec verifying that the replacement APIs for the deprecated `List<T>.iter()`
method work correctly. The deprecated `iter()` will be removed; these tests lock
the replacement contract so it cannot regress.

Replacements for `List<T>.iter()`:
- Inline iteration: `for x in list` (preferred — avoids closure capture limits)
- Callback iteration: `list.each(fn)` (use when callback is a named function)
- Indexed iteration: `list.each_with_index(fn)`

NOTE: These specs verify the replacement methods work. They cannot directly
assert that the deprecated method is gone — that is a grep gate at phase 7-verify:
  `rg -F 'iter()' src/compiler_rust/lib/std/src/core/list.spl`
should return zero deprecated usages after phase 5-implement completes.
"""

use std.spipe.*
use std.spec.step
use std.common.iterable.{each, each_with_index}

# Callback closures capture enclosing locals BY VALUE, so a `var` declared
# inside an `it` block and mutated from an `each`/`each_with_index` callback
# silently drops the mutation (compiler warning W-CAPTURE-MUTATION). The
# callback examples below therefore collect through module-level accumulators
# — the compiler-sanctioned workaround — reset at the start of each example.
# The callbacks also only push the RAW parameter: method calls and string
# interpolation on a closure parameter miscompile to "" under the seed test
# evaluator, so all string building happens outside the callback.
var each_order_vals: [i64] = []
var each_empty_seen: [i64] = []
var each_sum_seen: [i64] = []
var ewi_vals: [text] = []
var ewi_idx: [i64] = []
var ewi_empty_seen: [text] = []
var ewi_dup_vals: [text] = []
var ewi_dup_idx: [i64] = []


# ============================================================================
# List.each() — replacement for List.iter() callback usage
# ============================================================================

describe "List.each() iterates all elements (replaces iter())":
    """
    ## List.each(fn) replacement

    `list.each(\x: ...)` is the replacement for callback-style uses of
    `list.iter()`. Verifies correctness of each() as the drop-in for iter().
    """

    it "List.each() visits every element in order":
        val items = [10, 20, 30]
        each_order_vals = []
        each(items, \n:
            each_order_vals.push(n)
        )
        var joined = ""
        for n in each_order_vals:
            joined = joined + n.to_string()
        expect(joined).to_equal("102030")

    it "List.each() on empty list calls fn zero times":
        val items: [i64] = []
        each_empty_seen = []
        each(items, \n:
            each_empty_seen.push(1)
        )
        expect(each_empty_seen.len()).to_equal(0)

    it "List.each() accumulates a sum correctly":
        val items = [1, 2, 3, 4, 5]
        each_sum_seen = []
        each(items, \n:
            each_sum_seen.push(n)
        )
        var sum = 0
        for n in each_sum_seen:
            sum = sum + n
        expect(sum).to_equal(15)


# ============================================================================
# for x in list — preferred replacement for iter()-based for loops
# ============================================================================

describe "for x in list works without iter() (replaces for x in list.iter())":
    """
    ## Direct for-in on List

    `for x in list` is the preferred replacement for `for x in list.iter()`.
    Cleaner syntax and avoids closure capture limitations.
    """

    it "for x in list visits every element":
        val items = ["a", "b", "c"]
        var count = 0
        for item in items:
            count = count + 1
        expect(count).to_equal(3)

    it "for x in list accumulates all values":
        val items = [2, 4, 6]
        var sum = 0
        for n in items:
            sum = sum + n
        expect(sum).to_equal(12)

    it "for x in list on empty list executes zero iterations":
        val items: [i64] = []
        var count = 0
        for n in items:
            count = count + 1
        expect(count).to_equal(0)


# ============================================================================
# List.each_with_index() — indexed iteration replacement
# ============================================================================

describe "List.each_with_index provides index alongside element":
    """
    ## List.each_with_index(fn)

    Replacement for patterns that combined iter() with manual index tracking.
    Verifies index is correct alongside element value.
    """

    it "List.each_with_index passes correct index and value":
        step("Reproduce the exact failure")
        val items = ["x", "y", "z"]
        ewi_vals = []
        ewi_idx = []
        each_with_index(items, \v, i:
            ewi_vals.push(v)
            ewi_idx.push(i)
        )
        var index_sum = 0
        for i in ewi_idx:
            index_sum = index_sum + i
        expect(index_sum).to_equal(3)
        var pairs_text = ""
        var k = 0
        while k < ewi_vals.len():
            if k > 0:
                pairs_text = pairs_text + ","
            pairs_text = pairs_text + "{ewi_vals[k]}:{ewi_idx[k]}"
            k = k + 1
        expect(pairs_text).to_equal("x:0,y:1,z:2")

    it "indexed iteration invokes no callback on an empty array":
        step("Reject the adjacent regression")
        val items: [text] = []
        ewi_empty_seen = []
        each_with_index(items, \v, i:
            ewi_empty_seen.push(v)
        )
        expect(ewi_empty_seen.len()).to_equal(0)

    it "iteration preserves duplicate values and their distinct indices":
        step("Exercise the repaired owner")
        ewi_dup_vals = []
        ewi_dup_idx = []
        each_with_index(["same", "same"], \v, i:
            ewi_dup_vals.push(v)
            ewi_dup_idx.push(i)
        )
        var seen_text = ""
        var k = 0
        while k < ewi_dup_vals.len():
            if k > 0:
                seen_text = seen_text + ","
            seen_text = seen_text + "{ewi_dup_vals[k]}:{ewi_dup_idx[k]}"
            k = k + 1
        expect(seen_text).to_equal("same:0,same:1")
