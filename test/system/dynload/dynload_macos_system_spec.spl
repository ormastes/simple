"""macOS Dynamic Loading System Test.

Exercises the platform-independent dylib_registry ELF pipeline used by the
SimpleOS loader on a macOS host.  The semantic contract runs on every CI host;
the final native-host witness remains gated by is_macos().

# TODO(dynload-system-tests): switch to gcc -shared + file_read_bytes
# once interpreter FFI [u8] wrapping bug is fixed (see D-1 in state.md).
# TODO(dynload-system-tests): add Mach-O loader tests when a Mach-O
# parser is implemented (see D-4).

**Feature IDs:** #DYNLOAD-SYS-011 to #DYNLOAD-SYS-012
**Category:** Infrastructure / System Test
"""

# @cover src/os/kernel/loader/dylib_registry.spl 80%

use std.spec
use std.env.platform.{is_macos}
use os.kernel.loader.dylib_registry.{
    dylib_registry_reset_for_test,
    dylib_registry_register,
    dylib_registry_close,
    dylib_registry_symbol
}
use test.system.dynload.dynload_fixture_helpers.{
    make_elf64_exec
}

# ============================================================================
# Tests
# ============================================================================

describe "Dynload macOS System":
    describe "ELF cross-load via registry":
        it "registers and resolves the ELF64 loader contract for a macOS host":
            dylib_registry_reset_for_test()
            val handle = dylib_registry_register("/usr/local/lib/cross.so", make_elf64_exec())
            expect(handle).to_be_greater_than(0)
            expect(dylib_registry_symbol(handle, "_start")).to_equal(0x400000)
            expect(dylib_registry_close(handle)).to_equal(0)
            dylib_registry_reset_for_test()

        it "provides a native macOS host witness when running on macOS":
            if is_macos():
                dylib_registry_reset_for_test()
                val handle = dylib_registry_register("/lib/mac.so", make_elf64_exec())
                expect(handle).to_be_greater_than(0)
                expect(dylib_registry_symbol(handle, "main")).to_equal(0x400000)
                expect(dylib_registry_close(handle)).to_equal(0)
                dylib_registry_reset_for_test()
            else:
                print("SKIP: macOS symbol resolve (not on macOS)")
