            step("Verify: rejects dimension with wrong name")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var dim = DimensionDef.new("logging", r"logging/{name}")
            dim.layer = LayerDef.new(security_layer_order(), LayerDirection.LowerToUpper)
