            expect(result.is_err()).to_equal(true)

        it "rejects dimension with missing layers":
            # @req: REQ-SYSTEM-SECURITY_AOP-144
            step("Verify: rejects dimension with missing layers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var dim = DimensionDef.new("security", r"security/{name}")
            dim.layer = LayerDef.new(["crypto", "auth"], LayerDirection.LowerToUpper)
            val result = validate_security_dimension(dim)
            expect(result.is_err()).to_equal(true)

    context "enable_security_weaving":
        it "enables weaving on a disabled base config":
            # @req: REQ-SYSTEM-SECURITY_AOP-145
            step("Verify: enables weaving on a disabled base config")
