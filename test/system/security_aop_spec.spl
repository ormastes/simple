# Security Dimension Integration — Compile-Time Weaving Orchestrator
# ============================================================================

describe "Security Dimension Integration (compiler.mdsoc.security)":
    """
    ## Compile-Time Security Weaving Orchestrator

    Tests for the MDSOC security dimension integration module that:
    - Builds the canonical 5-layer security DimensionDef
    - Validates layer ordering and dependency direction
    - Merges security AOP aspects into the weaving pipeline
    - Detects SecurityGate join points for capability-gated code
    """

    context "security_dimension_def":
        it "returns dimension named security":
            # @req: REQ-SYSTEM-SECURITY_AOP-131
            step("Verify: returns dimension named security")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dim = security_dimension_def()
            expect(dim.name).to_equal("security")

        it "has exactly 5 layers":
            # @req: REQ-SYSTEM-SECURITY_AOP-132
            step("Verify: has exactly 5 layers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dim = security_dimension_def()
            expect(dim.layer.layer_count()).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

        it "crypto is at level 0":
            # @req: REQ-SYSTEM-SECURITY_AOP-133
            step("Verify: crypto is at level 0")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dim = security_dimension_def()
            val level = dim.layer.get_level("crypto")
            expect(level).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "enforcement is at level 1":
            # @req: REQ-SYSTEM-SECURITY_AOP-134
            step("Verify: enforcement is at level 1")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dim = security_dimension_def()
            val level = dim.layer.get_level("enforcement")
            expect(level).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "validation is at level 2":
            # @req: REQ-SYSTEM-SECURITY_AOP-135
            step("Verify: validation is at level 2")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dim = security_dimension_def()
            val level = dim.layer.get_level("validation")
            expect(level).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

        it "auth is at level 3":
            # @req: REQ-SYSTEM-SECURITY_AOP-136
            step("Verify: auth is at level 3")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dim = security_dimension_def()
            val level = dim.layer.get_level("auth")
            expect(level).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

        it "audit is at level 4":
            # @req: REQ-SYSTEM-SECURITY_AOP-137
            step("Verify: audit is at level 4")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dim = security_dimension_def()
            val level = dim.layer.get_level("audit")
            expect(level).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

        it "dimension_kind is horizontal":
            # @req: REQ-SYSTEM-SECURITY_AOP-138
            step("Verify: dimension_kind is horizontal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dim = security_dimension_def()
            expect(dim.dimension_kind).to_equal("horizontal")

    context "security_layer_order":
        it "returns 5 layers in correct order":
            # @req: REQ-SYSTEM-SECURITY_AOP-139
            step("Verify: returns 5 layers in correct order")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val layers = security_layer_order()
            expect(layers.len()).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec
            expect(layers[0]).to_equal("crypto")
            expect(layers[1]).to_equal("enforcement")
            expect(layers[2]).to_equal("validation")
            expect(layers[3]).to_equal("auth")
            expect(layers[4]).to_equal("audit")

    context "is_valid_security_layer":
        it "accepts all 5 valid layer names":
            # @req: REQ-SYSTEM-SECURITY_AOP-140
            step("Verify: accepts all 5 valid layer names")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(is_valid_security_layer("crypto")).to_equal(true)
            expect(is_valid_security_layer("enforcement")).to_equal(true)
            expect(is_valid_security_layer("validation")).to_equal(true)
            expect(is_valid_security_layer("auth")).to_equal(true)
            expect(is_valid_security_layer("audit")).to_equal(true)

        it "rejects invalid layer names":
            # @req: REQ-SYSTEM-SECURITY_AOP-141
            step("Verify: rejects invalid layer names")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(is_valid_security_layer("network")).to_equal(false)
            expect(is_valid_security_layer("database")).to_equal(false)
            expect(is_valid_security_layer("")).to_equal(false)

    context "validate_security_dimension":
        it "accepts canonical security dimension":
            # @req: REQ-SYSTEM-SECURITY_AOP-142
            step("Verify: accepts canonical security dimension")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dim = security_dimension_def()
            val result = validate_security_dimension(dim)
            expect(result.is_err()).to_equal(false)

        it "rejects dimension with wrong name":
