            # @req: REQ-SYSTEM-SECURITY_AOP-147
            step("Verify: adds around advices for audit and sanitization")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val base = weavingconfig_disabled()
            val sec = enable_security_weaving(base)
            expect(sec.around_advices.len()).to_be_greater_than(0)

        it "adds after_success advices for auth event logging":
            # @req: REQ-SYSTEM-SECURITY_AOP-148
            step("Verify: adds after_success advices for auth event logging")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val base = weavingconfig_disabled()
            val sec = enable_security_weaving(base)
            expect(sec.after_success_advices.len()).to_be_greater_than(0)

        it "adds after_error advices for auth failure logging":
            # @req: REQ-SYSTEM-SECURITY_AOP-149
            step("Verify: adds after_error advices for auth failure logging")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val base = weavingconfig_disabled()
            val sec = enable_security_weaving(base)
            expect(sec.after_error_advices.len()).to_be_greater_than(0)

    context "has_security_dimension":
        it "returns false for empty manifest":
            # @req: REQ-SYSTEM-SECURITY_AOP-150
            step("Verify: returns false for empty manifest")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val m = MdsocManifest.new("test")
