# NOT a *_spec.spl: this probe is deliberately RED and is executed only
# manually with the Rust seed binary:
#   bin/simple run test/00_quick/spec_it_accumulation_probe.spl
# (same RED-fixture convention as test/fixture/spec/it_block_last_expect_wins_fixture.spl)
#
# P0 reproduction probe for
# doc/08_tracking/bug/spec_it_block_last_expect_wins_masks_earlier_failure_2026-07-03.md
#
# Honest expected outcome on FIXED code (seed-smoke):
#   - example 1 (fail then pass)   -> FAILED, message "expected 1 to equal 2"
#   - example 2 (pass then fail)   -> FAILED
#   - example 3 (fail, pass, fail) -> FAILED (first failure not cleared, both listed)
#   - example 4 (nested context)   -> FAILED
#   - example 5 (all pass)         -> ok
#   - summary: 5 examples, 4 failures
# Any example above printing a green check marks the bug LIVE.

use std.spec.*

describe "sabotage check (P0 last-expect-wins probe)":
    it "fail then pass in same it-block":
        expect(1).to_equal(2)
        expect(3).to_equal(3)

    it "pass then fail in same it-block":
        expect(3).to_equal(3)
        expect(1).to_equal(2)

    it "fail pass fail accumulates both failures":
        expect(1).to_equal(2)
        expect(3).to_equal(3)
        expect(5).to_equal(6)

    it "all pass control":
        expect(1).to_equal(1)
        expect(2).to_equal(2)

describe "outer frame":
    context "inner context":
        it "nested fail then pass in same it-block":
            expect(1).to_equal(2)
            expect(3).to_equal(3)
