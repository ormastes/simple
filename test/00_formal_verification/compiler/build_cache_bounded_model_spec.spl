"""
Bounded executable verification of production artifact-service transitions and
the proposed cold/warm weighted work accounting. This is not a universal Lean
proof, compiler refinement, runner-death proof, or measured latency result.

The finite source model checks 192 completion inputs and every four-event trace
over two claimers, two completers and cancellation (625 traces). The cost model
checks 512 positive bounded configurations. Phase 1 execution remains diagnostic.
An additional 625 recovery traces compare an independent abstract model with
the service/coordinator bridge after every prefix. Recovery assumes an already
admitted reap proof; it does not model or manufacture process-death evidence.
"""
# @req REQ-FORMAL-BOUNDED REQ-FORMAL-OWNER REQ-IM-007
# codex-system-test: recovery extension AUTHORED_UNRUN, 2026-10-19.
use std.spec.*
use lib.compiler_artifact_service.profile.{artifact_service_profile_v1}
use lib.compiler_artifact_service.protocol.{ArtifactResultV1}
use lib.compiler_artifact_service.service.{ArtifactServiceV1, ArtifactRequestV1, ArtifactLeaseV1, ArtifactRequestStateV1, artifact_service_enqueue_v1, artifact_service_claim_v1, artifact_service_complete_v1, artifact_service_cancel_v1}
use compiler.driver.action_graph.artifact_service_bridge.{DemandArtifactRouteV1, demand_artifact_route_v1, demand_artifact_claim_owned_v1, demand_artifact_commit_owned_v1, demand_artifact_cancel_v1}
use compiler.driver.action_graph.artifact_owner_recovery.{demand_artifact_requeue_retired_v1}
use compiler.driver.action_graph.build_action_v1.{BuildActionV1, BuildActionResultV1, BuildActionPoolV1, BuildActionStateV1}
use compiler.driver.action_graph.persisted_graph.{PersistedBuildGraphV1}
use compiler.driver.action_graph.coordinator.{BuildPoolBudgetV1, coordinator_new_v1}
use compiler.driver.action_graph.demand_compile_integration.{DemandCompileExecutionV1}
use compiler.driver.backend.native_promotion_queue.{NativePromotionQueueV1}
use compiler.driver.perf.demand_compile_counters.{demand_compile_counters_empty_v1}

fn bounded_queued_service() -> ArtifactServiceV1:
    val profile = artifact_service_profile_v1("bounded-build", "compiler-c48", ["parse"], 0, true)
    artifact_service_enqueue_v1(ArtifactServiceV1(profile, []),
        ArtifactRequestV1("action-a", "compiler-c48", "snapshot-a", 1, 1024))

fn bounded_completion_inputs() -> i64:
    val queued = bounded_queued_service()
    val leased = artifact_service_claim_v1(queued, "owner-a", "lease-a", 7, 2048, -1)
    var checked: i64 = 0
    for owner_index in 0..3:
        for lease_index in 0..2:
            for generation_index in 0..2:
                for action_index in 0..2:
                    for snapshot_index in 0..2:
                        for success_index in 0..2:
                            for cancel_index in 0..2:
                                val owner = if owner_index == 0: "owner-a" else: if owner_index == 1: "owner-old" else: "owner-b"
                                val lease_id = if lease_index == 0: "lease-a" else: "lease-old"
                                val generation = if generation_index == 0: 7 else: 6
                                val action = if action_index == 0: "action-a" else: "action-b"
                                val snapshot = if snapshot_index == 0: "snapshot-a" else: "snapshot-b"
                                val success = success_index == 1
                                val cancelled = cancel_index == 1
                                val input_lease = ArtifactLeaseV1(lease_id, "action-a", owner, generation, false)
                                val result = ArtifactResultV1(action, "compiler-c48", snapshot,
                                    if success: "artifact-a" else: "", [], success, cancelled,
                                    if success or cancelled: "" else: "compile-failed")
                                val actual = artifact_service_complete_v1(leased, input_lease, result)
                                val authorized = owner_index == 0 and lease_index == 0 and generation_index == 0 and action_index == 0
                                val can_publish = authorized and snapshot_index == 0 and success and not cancelled
                                val published = actual.entries[0].state == ArtifactRequestStateV1.completed
                                if published != can_publish: return -1
                                if not can_publish and actual.entries[0].cas_artifact_digest != "": return -2
                                if not authorized and actual.entries[0].state != ArtifactRequestStateV1.leased: return -3
                                checked = checked + 1
    checked

fn bounded_service_traces() -> i64:
    val initial = bounded_queued_service()
    var checked: i64 = 0
    # Five possible events to depth four: enumerate the complete finite set.
    for encoded in 0..625:
        var service = initial
        var remaining = encoded
        var build_starts: i64 = 0
        var publications: i64 = 0
        for index in 0..4:
            val event = remaining % 5
            remaining = remaining / 5
            val before = service.entries[0].state
            if event == 0 or event == 1:
                val owner = if event == 0: "owner-a" else: "owner-b"
                val lease = if event == 0: "lease-a" else: "lease-b"
                service = artifact_service_claim_v1(service, owner, lease, 7, 2048, -1)
            elif event == 2 or event == 3:
                val owner = if event == 2: "owner-a" else: "owner-b"
                val lease = if event == 2: "lease-a" else: "lease-b"
                val result = ArtifactResultV1("action-a", "compiler-c48", "snapshot-a", "artifact-a", [], true, false, "")
                service = artifact_service_complete_v1(service,
                    ArtifactLeaseV1(lease, "action-a", owner, 7, false), result)
            else:
                service = artifact_service_cancel_v1(service, "action-a")
            val after = service.entries[0].state
            if before == ArtifactRequestStateV1.queued and after == ArtifactRequestStateV1.leased:
                build_starts = build_starts + 1
            if before != ArtifactRequestStateV1.completed and after == ArtifactRequestStateV1.completed:
                publications = publications + 1
            if build_starts > 1 or publications > 1: return -10
            if publications > build_starts: return -11
            if before == ArtifactRequestStateV1.completed and after != ArtifactRequestStateV1.completed: return -12
            if service.entries.len() != 1: return -13
        checked = checked + 1
    checked

fn bounded_dead_owner_claim_fixedpoint() -> i64:
    var service = artifact_service_claim_v1(bounded_queued_service(), "dead-owner", "dead-lease", 7, 2048, -1)
    for generation in 8..24:
        service = artifact_service_claim_v1(service, "retry-owner", "retry-lease", generation, 2048, -1)
        if service.entries[0].state != ArtifactRequestStateV1.leased: return -20
        if service.entries[0].lease.unwrap().owner_id != "dead-owner": return -21
        if service.entries[0].lease.unwrap().generation != 7: return -22
    16

# Independent finite oracle: phase is running, queued, completed,
# cancelled-running, or cancelled-queued. Generation distinguishes epochs.
# No oracle field is obtained from the production transition's output.
struct BoundedRecoveryModelV1:
    phase: text
    generation: i64
    recovered: bool
    cancelled: bool
    accepted: bool

fn bounded_recovery_model_step(model: BoundedRecoveryModelV1, event: i64) -> BoundedRecoveryModelV1:
    var next = model
    next.accepted = false
    if event == 4:
        next.cancelled = true
        if model.phase == "running": next.phase = "cancelled-running"
        elif model.phase == "queued": next.phase = "cancelled-queued"
    elif not model.cancelled:
        if event == 0 and model.phase == "running" and model.generation == 7:
            next.phase = "queued"
            next.recovered = true
            next.accepted = true
        elif event == 1 and model.phase == "queued":
            next.phase = "running"
            next.generation = 8
            next.accepted = true
        elif model.phase == "running" and ((event == 2 and model.generation == 7) or
                (event == 3 and model.generation == 8)):
            next.phase = "completed"
            next.accepted = true
    next

fn bounded_recovery_lease(generation: i64) -> ArtifactLeaseV1:
    ArtifactLeaseV1(if generation == 7: "lease-a" else: "lease-b", "action-a",
        if generation == 7: "b".repeat(64) else: "c".repeat(64), generation, false)

fn bounded_recovery_initial() -> DemandArtifactRouteV1:
    val action = BuildActionV1("action-a", "compile", ["source-a"], [], ["object-a"],
        BuildActionPoolV1.parse, 1, "snapshot-a", 1024, "")
    val coordinator = coordinator_new_v1(PersistedBuildGraphV1("graph", "", "snapshot-a", [action]),
        [BuildPoolBudgetV1(BuildActionPoolV1.parse, 1, 2048)])
    val execution = DemandCompileExecutionV1(true, "ok", Some(coordinator), None,
        NativePromotionQueueV1([]), "action-a", demand_compile_counters_empty_v1(), None, None, 0, "", 0, 0)
    val route = demand_artifact_route_v1(execution,
        artifact_service_profile_v1("bounded-recovery", "compiler-c48", ["parse"], 0, true),
        true, "b".repeat(64), 7)
    val claimed = demand_artifact_claim_owned_v1(route, "action-a", "lease-a", 2048)
    expect(claimed.claim.valid).to_be(true)
    claimed.route

# Projection is deliberately separate from both the abstract transition table
# and production mutations. Cancellation of a running task retains reservation
# until actual cleanup; requesting cancellation is not a reap proof.
fn bounded_recovery_projection(route: DemandArtifactRouteV1, model: BoundedRecoveryModelV1) -> text:
    if not route.valid or route.service.entries.len() != 1: return "route inventory"
    val coordinator = match route.execution.coordinator:
        Some(value): value
        _: return "coordinator absent"
    if coordinator.runtime.len() != 1 or coordinator.cancelled != model.cancelled: return "coordinator inventory/latch"
    val entry = route.service.entries[0]
    val runtime = coordinator.runtime[0]
    val lease = match entry.lease:
        Some(value): value
        _: return "lease absent"
    val expected_lease = bounded_recovery_lease(model.generation)
    if lease.action_id != expected_lease.action_id or lease.lease_id != expected_lease.lease_id or
            lease.owner_id != expected_lease.owner_id or lease.generation != model.generation:
        return "lease fence"
    val cancelled_work = model.phase == "cancelled-running" or model.phase == "cancelled-queued"
    if lease.cancelled != cancelled_work: return "lease cancellation"
    if route.owner_id != (if model.recovered: "c".repeat(64) else: "b".repeat(64)) or
            route.lease_generation != (if model.recovered: 8 else: 7): return "successor authority"
    if entry.request.action_id != "action-a" or entry.request.compatibility_id != "compiler-c48" or
            entry.request.snapshot_revision != "snapshot-a" or entry.request.memory_budget_bytes != 1024 or
            runtime.action_id != "action-a" or coordinator.graph.snapshot_revision != "snapshot-a":
        return "request authority"
    val expected_service = if cancelled_work: ArtifactRequestStateV1.cancelled else:
        if model.phase == "completed": ArtifactRequestStateV1.completed else:
        if model.phase == "queued": ArtifactRequestStateV1.queued else: ArtifactRequestStateV1.leased
    val running = model.phase == "running" or model.phase == "cancelled-running"
    val expected_runtime = if running: BuildActionStateV1.running else:
        if model.phase == "completed": BuildActionStateV1.succeeded else:
        if model.phase == "queued": BuildActionStateV1.pending else: BuildActionStateV1.cancelled
    if entry.state != expected_service or runtime.state != expected_runtime: return "service/coordinator state"
    if runtime.owner_token != (if running: expected_lease.lease_id else: ""): return "coordinator token"
    if runtime.memory_reserved_bytes != (if running: 1024 else: 0): return "reservation"
    val digest = if model.phase == "completed": "object-a" else: ""
    if entry.cas_artifact_digest != digest: return "publication"
    match runtime.result:
        Some(result):
            if model.phase != "completed" or result.action_id != "action-a" or
                    result.snapshot_revision != "snapshot-a" or not result.success or result.cancelled or
                    result.output_identity != "object-a": return "coordinator result"
        _: if model.phase == "completed": return "completed result absent"
    ""

fn bounded_recovery_traces() -> Result<i64, text>:
    var checked: i64 = 0
    for encoded in 0..625:
        var route = bounded_recovery_initial()
        val dispatched_old_lease = route.service.entries[0].lease.unwrap()
        var model = BoundedRecoveryModelV1("running", 7, false, false, true)
        val initial_error = bounded_recovery_projection(route, model)
        if initial_error != "": return Err("initial: " + initial_error)
        var remaining = encoded
        var starts7: i64 = 1
        var starts8: i64 = 0
        var publications: i64 = 0
        for ordinal in 0..4:
            val event = remaining % 5
            remaining = remaining / 5
            val before = route
            val old_state = route.service.entries[0].state
            val old_runtime_state = route.execution.coordinator.unwrap().runtime[0].state
            val previous_model = model
            model = bounded_recovery_model_step(model, event)
            var accepted = false
            if event == 0:
                # EXTERNAL PRECONDITION: the parent already admitted the exact
                # generation-7 tree-reap proof. No receipt is fabricated here.
                match demand_artifact_requeue_retired_v1(route, dispatched_old_lease, "c".repeat(64), 8):
                    Ok(value):
                        route = value
                        accepted = true
                    Err(_reason): ()
            elif event == 1:
                val transfer = demand_artifact_claim_owned_v1(route, "action-a", "lease-b", 2048)
                route = transfer.route
                accepted = transfer.claim.valid
            elif event == 2 or event == 3:
                val result = BuildActionResultV1("action-a", "snapshot-a", true, false, "object-a", "", [], 512)
                val transfer = demand_artifact_commit_owned_v1(route, result,
                    Some(if event == 2: dispatched_old_lease else: bounded_recovery_lease(8)))
                route = transfer.route
                accepted = transfer.accepted
            else:
                demand_artifact_cancel_v1(&mut route, "action-a")
            if event != 4 and accepted != model.accepted:
                return Err("trace {encoded}, prefix {ordinal}: acceptance")
            if event != 4:
                val prior_error = bounded_recovery_projection(before, previous_model)
                if prior_error != "": return Err("trace {encoded}, prefix {ordinal}: input mutated: " + prior_error)
            val projection_error = bounded_recovery_projection(route, model)
            if projection_error != "": return Err("trace {encoded}, prefix {ordinal}: " + projection_error)
            # Count actual state changes, never a successful/idempotent return.
            val new_state = route.service.entries[0].state
            val new_runtime_state = route.execution.coordinator.unwrap().runtime[0].state
            if old_runtime_state == BuildActionStateV1.pending and new_runtime_state == BuildActionStateV1.running:
                if route.service.entries[0].lease.unwrap().generation == 7: starts7 = starts7 + 1
                else: starts8 = starts8 + 1
            if old_state != ArtifactRequestStateV1.completed and new_state == ArtifactRequestStateV1.completed:
                publications = publications + 1
            if starts7 > 1 or starts8 > 1 or publications > 1:
                return Err("trace {encoded}, prefix {ordinal}: duplicate start/publication")
        checked = checked + 1
    Ok(checked)

# Counts in order: capture entries, enumeration entries, hash bytes, read bytes,
# TLDR decode bytes, parse bytes, HIR nodes, MIR nodes, object work, link work,
# startup work, scheduler steps, receipt entries. Weights are symbolic work
# units, NOT milliseconds. Invalid or oversized domains fail closed.
fn bounded_weighted_cost(counts: [i64], weights: [i64]) -> i64:
    if counts.len() != 13 or weights.len() != 13: return -1
    var result: i64 = 0
    for index in 0..13:
        if counts[index] < 0 or counts[index] > 1000000: return -2
        if weights[index] < 0 or weights[index] > 1000000: return -3
        result = result + counts[index] * weights[index]
    result

fn bounded_weighted_cold_warm() -> i64:
    var checked: i64 = 0
    for weight in 1..9:
        val weights = [weight, weight + 1, weight + 2, weight + 3,
            weight + 4, weight + 5, weight + 6, weight + 7, weight + 8,
            weight + 9, weight + 10, weight + 11, weight + 12]
        for entries in 1..17:
            val bytes = entries * 32
            for targets in 1..5:
                val cold = [entries, entries, bytes, bytes, 0, bytes, entries,
                    entries, targets, 1, 1, targets, entries]
                val duplicate_parse = [entries, entries, bytes, bytes, 0, bytes * 2, entries,
                    entries, targets, 1, 1, targets, entries]
                val per_target_scan = [entries, entries * targets, bytes, bytes, 0, bytes, entries,
                    entries, targets, 1, 1, targets, entries]
                # An admitted immutable no-change generation: cache decode is
                # charged, while no new source parse/enumeration is prescribed.
                val warm = [0, 0, 0, 0, entries * 8, 0, 0, 0, 0, 0, 1, targets, 0]
                val cold_cost = bounded_weighted_cost(cold, weights)
                val warm_cost = bounded_weighted_cost(warm, weights)
                if cold_cost < bytes * weights[3]: return -30
                if bounded_weighted_cost(duplicate_parse, weights) - cold_cost != bytes * weights[5]: return -31
                if bounded_weighted_cost(per_target_scan, weights) - cold_cost != entries * (targets - 1) * weights[1]: return -32
                if warm_cost != entries * 8 * weights[4] + weights[10] + targets * weights[11]: return -33
                checked = checked + 1
    checked

describe "REQ-FORMAL-BOUNDED: build-cache finite state and work model":
    it "should check every completion in the declared 192-case source domain":
        step("Enumerate action, owner, lease, generation, snapshot and result states")
        expect(bounded_completion_inputs()).to_equal(192)

    it "should permit at most one start and publication on every four-event production trace":
        step("Enumerate all 625 claim, completion and cancellation traces")
        expect(bounded_service_traces()).to_equal(625)

    it "should retain the old lease when retries supply no admitted retirement":
        step("Retry a leased action without calling the proof-gated recovery owner")
        expect(bounded_dead_owner_claim_fixedpoint()).to_equal(16)

    it "should refine all 625 admitted-recovery traces against the independent state model":
        step("Claim generation 7 and enumerate four events over recovery, successor claim, both completions and cancellation")
        step("Compare acceptance and both owner states at every prefix while preserving the input value")
        expect(bounded_recovery_traces().unwrap()).to_equal(625)

    it "should detect a forged lease, publication or reservation in the projection":
        step("Mutate one real initial route field without changing the independent expected state")
        val original = bounded_recovery_initial()
        val model = BoundedRecoveryModelV1("running", 7, false, false, true)
        expect(bounded_recovery_projection(original, model)).to_equal("")
        for kind in 0..3:
            var changed = original
            if kind == 0:
                changed.service.entries[0].lease = Some(bounded_recovery_lease(8))
            elif kind == 1:
                changed.service.entries[0].cas_artifact_digest = "unearned-object"
            else:
                var execution = changed.execution
                var coordinator = execution.coordinator.unwrap()
                coordinator.runtime[0].memory_reserved_bytes = 0
                execution.coordinator = Some(coordinator)
                changed.execution = execution
            val expected = if kind == 0: "lease fence" else: if kind == 1: "publication" else: "reservation"
            expect(bounded_recovery_projection(changed, model)).to_equal(expected)
            expect(bounded_recovery_projection(original, model)).to_equal("")

    it "should separate cold byte cost, duplicate parse cost and warm decode cost":
        step("Check 512 bounded weighted cold and warm configurations")
        expect(bounded_weighted_cold_warm()).to_equal(512)
        expect(bounded_weighted_cost([], [])).to_equal(-1)
