# Generalization spec for the 2026-08-17 verification-std API drift fixes.
#
# Reproduced defects (fixed the same day):
# 1. Factory helpers in the verification std tree were declared as instance
#    `fn` but called statically (`CapType.imm_type`, `ContractExpr.variable`,
#    `ProofChecker.create`, ...) — "unknown static method" semantic errors.
# 2. `verification/toolchain.spl` imported the dead module path `host.process`
#    (resolved to an empty dict) and used `.success` / `fs.exists`, neither of
#    which exist on the std.process / io.fs surfaces.
#
# This spec probes the SAME pattern on adjacent classes so a regression or a
# further un-migrated factory/import surfaces here, not only in the original
# failing specs.

"""
## Purpose and audience
Purpose: Verify Verification std static factories (generalization).
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-FV-VERIFICATION-STD-API-001 — stable requirement identity for this spec.

use std.spec.{describe, it, expect}
use verification.models.memory_capabilities as caps
use verification.models.contracts as contracts
use verification.proofs.obligations.{ProofObligation, ObligationSet}
use verification.proofs.checker.{ProofChecker, CheckerConfig}
use verification.lean.verification_checker as vchecker
use verification.toolchain as toolchain

use std.spec.step

describe "Verification std static factories (generalization)":
    it "constructs capability types via every static factory":
        step("Verify: constructs capability types via every static factory")
        # @req: REQ-FV-VERIFICATION-STD-API-001
        expect(caps.CapType.imm_type("Int").to_lean()).to_contain("Shared")
        expect(caps.CapType.mut_type("Int").to_lean()).to_contain("Exclusive")
        expect(caps.CapType.iso_type("Int").to_lean()).to_contain("Isolated")

    it "constructs contract expressions via comparison factories":
        step("Verify: constructs contract expressions via comparison factories")
        val ge = contracts.ContractExpr.ge(
            contracts.ContractExpr.variable("n"),
            contracts.ContractExpr.int_val(0)
        )
        expect(ge.children.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        val eq = contracts.ContractExpr.eq(
            contracts.ContractExpr.result(),
            contracts.ContractExpr.bool_val(true)
        )
        expect(eq.children.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    it "constructs clause helpers statically":
        step("Verify: constructs clause helpers statically")
        val term = contracts.TerminationClause.single(
            contracts.ContractExpr.variable("n"))
        expect(term.exprs.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(contracts.ModifiesClause.nothing().locations.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    it "creates proof obligations and checkers statically":
        step("Verify: creates proof obligations and checkers statically")
        val ob = ProofObligation.create("id1", "n1", "f.spl", 1, "True")
        expect(ob.id).to_equal("id1")
        val set = ObligationSet.create("Mod")
        expect(set.module_name).to_equal("Mod")
        expect(CheckerConfig.create().timeout_ms).to_be_greater_than(0)
        val _checker = ProofChecker.create(CheckerConfig.create())

    it "classifies functions via static VerificationChecker helpers":
        step("Verify: classifies functions via static VerificationChecker helpers")
        assert_true(vchecker.VerificationChecker.is_io_function("print"))
        assert_false(vchecker.VerificationChecker.is_io_function("add"))

describe "Verification toolchain import health (generalization)":
    it "detects the toolchain without dead host.process bindings":
        step("Verify: detects the toolchain without dead host.process bindings")
        # Must not raise "method `run` not found on type `dict`" — the old
        # host.process import resolved to an empty dict. Lean may be absent;
        # only the shape of the result is asserted.
        val info = toolchain.ToolchainInfo.detect()
        expect(info.lean_available == true or info.lean_available == false)
            .to_equal(true)
