"""
Production frontend parse reuse and retained-pool lifetime replay.

Requires the pinned c48-or-candidate source closure and an isolated, enabled
frontend cache supplied by the parent runner. No test silently enables the
ordinary interpreter cache: its memory admission is a separate requirement.
This is parse-owner evidence, not proof that test/build runners or the HIR TLDR
producer are already connected to one retained owner.
"""
use std.spec.*
use std.io_runtime.{file_write_exact, dir_create_all}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.frontend_parse_cache.{frontend_parse_cache_enabled, frontend_parse_cache_stores}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module_scoped, flat_pool_capture_arm, flat_pool_capture_take, flat_parse_module_body_calls, build_module_from_flat_pool_blob}
use compiler.frontend.parser_types.{ParserModule}
use compiler.frontend.parser_types_expr.{StmtKind, ExprKind}
use compiler.core.parser.{parser_has_errors, parser_get_errors}

fn require_retained_literal(module: ParserModule, function_name: text, value: i64):
    expect(module.functions.contains_key(function_name)).to_be(true)
    val statements = module.functions[function_name].body.stmts
    expect(statements.len()).to_equal(1)
    match statements[0].kind:
        case StmtKind.Expr(expression):
            match expression.kind:
                case ExprKind.IntLit(actual): expect(actual).to_equal(value)
                case _: panic("retained function lost its literal expression")
        case _: panic("retained function lost its expression statement")

describe "REQ-FORMAL-PARSE: authoritative parse ownership":
    it "should parse once and restore the retained parse after another module resets every flat pool":
        step("Capture the authoritative parse exactly once")
        val source = "fn held() -> i64:\n    17\n"
        val before = flat_parse_module_body_calls()
        flat_pool_capture_arm()
        val original = parse_and_build_module_scoped(source, "held.spl", false)
        val blob = flat_pool_capture_take()
        expect(blob.len()).to_be_greater_than(0)
        expect(flat_parse_module_body_calls() - before).to_equal(1)
        require_retained_literal(original, "held", 17)

        step("Reset the global pools with another authoritative parse")
        val other = parse_and_build_module_scoped("fn other() -> i64:\n    29\n", "other.spl", false)
        require_retained_literal(other, "other", 29)
        require_retained_literal(original, "held", 17)
        val before_restore = flat_parse_module_body_calls()

        step("Restore the retained bytes without parsing the original source again")
        val restored = build_module_from_flat_pool_blob(blob, source, "held.spl")
        expect(restored.is_some()).to_be(true)
        require_retained_literal(restored.unwrap(), "held", 17)
        require_retained_literal(other, "other", 29)
        expect(flat_parse_module_body_calls()).to_equal(before_restore)
        expect(flat_pool_capture_take()).to_equal("")

        step("Reject a corrupt frame and recover with one fresh parse")
        expect(build_module_from_flat_pool_blob(blob + "unexpected-tail\n", source, "held.spl")).to_be_nil()
        expect(flat_parse_module_body_calls()).to_equal(before_restore)
        val recovered = parse_and_build_module_scoped(source, "held.spl", false)
        require_retained_literal(recovered, "held", 17)
        expect(flat_parse_module_body_calls() - before_restore).to_equal(1)

    it "should key the supplied generation and reuse its parse even when the path contains different bytes":
        step("Require an admitted isolated cache and prepare a different on-disk generation")
        expect(frontend_parse_cache_enabled()).to_be(true)
        val root = "build/native_probe/phase3-enum-nil-arm-fix-20261010/tldr-local-file-validity/formal/runtime"
        expect(dir_create_all(root)).to_be(true)
        val path = root + "/supplied_source.spl"
        val source_a = "fn captured_a() -> i64:\n    17\n"
        val source_b = "fn captured_b() -> i64:\n    29\n"
        expect(file_write_exact(path, source_b)).to_be(true)
        val before = flat_parse_module_body_calls()
        val first = parse_full_frontend(source_a, path, "supplied", Logger(level: 0))
        require_retained_literal(first, "captured_a", 17)
        val second = parse_full_frontend(source_b, path, "supplied", Logger(level: 0))
        require_retained_literal(second, "captured_b", 29)
        expect(second.functions.contains_key("captured_a")).to_be(false)
        expect(flat_parse_module_body_calls() - before).to_equal(2)

        step("Reuse the first captured generation without a third parser invocation")
        val repeated = parse_full_frontend(source_a, path, "supplied", Logger(level: 0))
        require_retained_literal(repeated, "captured_a", 17)
        expect(flat_parse_module_body_calls() - before).to_equal(2)
        require_retained_literal(second, "captured_b", 29)

        step("Keep invalid changed source out of successful cache publication")
        val stores = frontend_parse_cache_stores()
        val invalid = parse_full_frontend("fn captured_a() -> i64:\n    return )\n", path, "supplied", Logger(level: 0))
        expect(parser_has_errors()).to_be(true)
        expect(parser_get_errors().len()).to_be_greater_than(0)
        expect(frontend_parse_cache_stores()).to_equal(stores)
        expect(flat_parse_module_body_calls() - before).to_equal(3)
