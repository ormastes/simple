import spipe
import compiler.tools.verify.checker as checker

describe "Lean Verification Tool Checker":
    context "inventory":
        it "uses the authoritative Lean artifact list":
            val files = checker.known_verification_files()

            expect(files.len()).to_equal(15)
            expect(files.contains("src/verification/nogc_compile/src/NogcCompile.lean")).to_equal(true)
            expect(files.contains("src/verification/type_inference_compile/src/Contracts.lean")).to_equal(true)
            expect(files.contains("src/verification/tensor_dimensions/src/TensorMemory.lean")).to_equal(true)

    context "sorry counting":
        it "flags a proof containing a real sorry":
            val src = "theorem foo : True := by\n  sorry\n"
            expect(checker._count_sorry(src)).to_equal(1)

        it "flags a real admit token":
            val src = "theorem foo : True := by\n  admit\n"
            expect(checker._count_sorry(src)).to_equal(1)

        it "does not flag sorry in line comments":
            val src = "-- no sorry here\ntheorem t : True := trivial\n"
            expect(checker._count_sorry(src)).to_equal(0)

        it "does not flag sorry in block comments":
            val src = "/- sorry-free file, honest -/\ntheorem t : True := trivial\n"
            expect(checker._count_sorry(src)).to_equal(0)

        it "does not flag sorry in nested block comments":
            val src = "/- outer /- sorry inside nested -/ still comment -/\ntheorem t : True := trivial\n"
            expect(checker._count_sorry(src)).to_equal(0)

        it "does not flag identifiers containing sorry":
            val src = "def sorryless := 1\ndef sorryAx' := 2\ndef not_sorry := 3\n"
            expect(checker._count_sorry(src)).to_equal(0)

        it "does not flag sorry inside string literals":
            val src = "def msg := \"sorry not counted\"\n"
            expect(checker._count_sorry(src)).to_equal(0)

        it "still counts sorry after a comment line":
            val src = "-- prose mentions sorry\ntheorem t : True := by\n  sorry\n"
            expect(checker._count_sorry(src)).to_equal(1)

    context "summary formatting":
        it "renders failed proof results with sorry details":
            val result = checker.ProofResult(
                file_path: "src/verification/demo/src/Demo.lean",
                status: checker.ProofStatus.Failed,
                sorry_count: 2,
                error_message: "contains sorry",
                theorem_count: 3
            )

            expect(result.summary_line()).to_contain("[failed]")
            expect(result.summary_line()).to_contain("3 theorems")
            expect(result.summary_line()).to_contain("2 sorry")
            expect(result.summary_line()).to_contain("contains sorry")

        it "aggregates verification summary counts":
            val ok = checker.ProofResult(
                file_path: "src/verification/a.lean",
                status: checker.ProofStatus.ModelProven,
                sorry_count: 0,
                error_message: "",
                theorem_count: 2
            )
            val bad = checker.ProofResult(
                file_path: "src/verification/b.lean",
                status: checker.ProofStatus.Failed,
                sorry_count: 1,
                error_message: "contains sorry",
                theorem_count: 1
            )

            val summary = checker.CheckResult(file_results: [ok, bad]).summary()
            expect(summary).to_contain("Files checked: 2")
            expect(summary).to_contain("Model proven: 1")
            expect(summary).to_contain("Failed:    1")
            expect(summary).to_contain("Theorems: 3")
            expect(summary).to_contain("Pending proofs (sorry): 1")
