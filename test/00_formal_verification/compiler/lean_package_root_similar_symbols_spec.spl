# @cover src/compiler_rust/lib/std/src/verification/lean/__init__.spl 60%
#
# Generalization of the defect fixed in
# doc/08_tracking/bug/verification_lean_init_missing_use_before_export_2026-07-20.md
#
# The original bug affected ALL ~15 submodule re-export groups in
# verification/lean/__init__.spl uniformly (every group used the same broken
# bare `export Name, ...` pattern). This spec checks package-root resolution
# for symbols from two DIFFERENT submodules than the one the primary
# regression spec (lean_package_root_import_spec.spl) exercises, to catch a
# partial fix that repairs one export group's `export use module.*` line but
# leaves others still bare.

use std.spipe.*
use verification.lean.{to_pascal_case, to_camel_case, sanitize_lean_ident}
use verification.lean.{LeanEmitter}

describe "Lean package-root import — similar-problem detection across submodules":
    it "resolves naming.spl symbols (to_pascal_case, to_camel_case) via the package root":
        expect(to_pascal_case("hello_world")).to_equal("HelloWorld")
        expect(to_camel_case("hello_world")).to_equal("helloWorld")

    it "resolves naming.spl's sanitize_lean_ident via the package root":
        val sanitized = sanitize_lean_ident("theorem")
        expect(sanitized).to_not_equal("")

    it "resolves emitter.spl's LeanEmitter class via the package root":
        val emitter = LeanEmitter.new()
        expect(emitter).to_not_equal(nil)
