# Unit A: the trait and every call through an `Option<Trait>` payload.
# A deliberately does NOT import the implementors, so no implementation of
# `Ident` is in this compilation unit.
trait Ident:
    fn identity() -> text
    fn implementation_identity() -> text

struct Holder:
    identity: text
    implementation_identity: text

fn make(reducer: Ident?) -> Holder:
    if val Some(strategy) = reducer:
        return Holder(identity: strategy.identity(), implementation_identity: strategy.implementation_identity())
    Holder(identity: "none", implementation_identity: "none")

fn make_plain(reducer: Ident?) -> text:
    if val strategy = reducer:
        return strategy.implementation_identity()
    "none"

fn make_match(reducer: Ident?) -> text:
    match reducer:
        case Some(strategy):
            return strategy.identity()
        case None:
            return "none"
    "unreachable"
