# Must FAIL to build: `vanished` is declared by a trait that nobody
# implements, and the receiver is untyped, so the call is a bare-name
# reference with no definition anywhere in the link.
# LLVM: refused at codegen. Cranelift AOT: OPEN -- it still builds and prints
# "function not found" at run time with exit 0, because trait-typed field
# receivers in src/compiler reach the same fallback as `Any` (see
# doc/08_tracking/bug/trait_receiver_cross_unit_bare_call_stubbed_2026-10-20.md).
trait Ghost:
    fn vanished() -> text

class Empty:
    tag: text

fn poke(x: Any) -> text:
    x.vanished()

fn main():
    print poke(Empty(tag: "e"))
