# Run: SIMPLE_NATIVE_BUILD_RUST=1 <seed> native-build main.spl --source . --backend {cranelift,llvm} -o <out>;
# both outputs must equal expected_output.txt.
# Unit B: two implementors (`class X with Ident`, the pure_database shape) of
# the trait declared in unit A (ident.spl). With two implementors a bare-name
# call cannot pick the right body by accident.
use ident.{Ident, Holder, make, make_plain, make_match}

class Alpha with Ident:
    tag: text
    fn identity() -> text: "alpha-" + self.tag
    fn implementation_identity() -> text: "alpha-impl-" + self.tag

class Beta with Ident:
    tag: text
    fn identity() -> text: "beta-" + self.tag
    fn implementation_identity() -> text: "beta-impl-" + self.tag

fn main():
    val a = make(Some(Alpha(tag: "1")))
    print "{a.identity} {a.implementation_identity}"
    val b = make(Some(Beta(tag: "2")))
    print "{b.identity} {b.implementation_identity}"
    val n = make(None)
    print "{n.identity} {n.implementation_identity}"
    print make_plain(Some(Beta(tag: "3")))
    print make_match(Some(Alpha(tag: "4")))
    print make_plain(None)
