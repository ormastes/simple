enum SinglePayload:
    Flag(value: bool)
    Count(value: i64)

fn read_flag(value: bool) -> bool:
    match SinglePayload.Flag(value):
        case SinglePayload.Flag(payload): payload
        case _: panic("unexpected variant while reading Flag")

fn read_count(value: i64) -> i64:
    match SinglePayload.Count(value):
        case SinglePayload.Count(payload): payload
        case _: panic("unexpected variant while reading Count")

fn main() -> i64:
    val true_payload = read_flag(true)
    val false_payload = read_flag(false)
    val integer_payload = read_count(37)
    if true_payload and not false_payload and integer_payload == 37:
        print("PASS single-field enum bool payload")
        0
    else:
        panic("single-field enum payload was decoded incorrectly")
