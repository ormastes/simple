# Run: SIMPLE_NATIVE_BUILD_RUST=1 <seed-with-llvm> native-build builtin_method_parity.spl --source . --backend {cranelift,llvm} -o <out>;
# both outputs must equal expected_output.txt.
# LLVM/Cranelift parity: scalar float builtin methods and a trait-typed
# Option payload receiver (the pure_database `strategy.implementation_identity()` shape).
trait Ident:
    fn identity() -> text
    fn implementation_identity() -> text

struct Holder:
    identity: text
    implementation_identity: text

fn make(reducer: Ident?) -> Holder:
    if val Some(strategy) = reducer:
        return Holder(identity: strategy.identity(), implementation_identity: strategy.implementation_identity())
    Holder(identity: "", implementation_identity: "")

fn main():
    val x: f64 = -9.0
    val a = x.abs()
    val r = (a * 1.0).sqrt()
    print "abs={a} sqrt={r}"
    val half: f64 = 0.5
    print "round {half.round()} {(half + 1.0).round()} {(0.0 - half).round()} {(half + 2.0).round()}"
    val h = make(None)
    print "{h.identity} {h.implementation_identity}"
