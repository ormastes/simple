"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-DOC behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/doc/de10nano_quartus_setup_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-DOC-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover doc/07_guide/fpga/de10nano_quartus_setup.md 0%
"""
# DE10-Nano Quartus Setup Guide Specification

**Feature IDs:** opensource-riscv-rtl-simpleos
**Category:** Infrastructure
**Difficulty:** 1/5
**Status:** Draft
**Requirements:** REQ-4
**Artifacts:** N/A

## Overview

Verifies AC-4: the Quartus Prime Lite setup guide for DE10-Nano exists
and contains the required version, device, and workflow information.
Tests that the guide helper module returns the correct constants.

Covers:
- AC-4 (Cyclone V / Quartus setup guide documented for DE10-Nano)
"""

use std.spipe.*
use doc.fpga.de10nano_quartus_setup.{
    quartus_setup_guide_content,
    quartus_lite_version,
    de10nano_device_string,
    litex_de10nano_build_command
}


# ============================================================================
# Helpers
# ============================================================================

fn guide() -> text:
    return quartus_setup_guide_content()


# ============================================================================
# AC-4: Guide content completeness
# ============================================================================

describe "DE10-Nano Quartus Setup Guide":
    it "AC-4: guide content is non-empty":
        # @req: REQ-UNIT-DOC-001
            # @req: REQ-4
        step("Verify: AC-4: guide content is non-empty")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val g = guide()
        val len = g.length()
        expect(len).to_be_greater_than(0)

    it "AC-4: guide contains Quartus Prime version reference":
        # @req: REQ-UNIT-DOC-002
        step("Verify: AC-4: guide contains Quartus Prime version reference")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val g = guide()
        expect(g).to_contain("Quartus")

    it "AC-4: guide contains device string 5CSEBA6U23I7":
        # @req: REQ-UNIT-DOC-003
        step("Verify: AC-4: guide contains device string 5CSEBA6U23I7")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val g = guide()
        expect(g).to_contain("5CSEBA6U23I7")

    it "AC-4: guide contains DE10-Nano board name":
        # @req: REQ-UNIT-DOC-004
        step("Verify: AC-4: guide contains DE10-Nano board name")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val g = guide()
        expect(g).to_contain("DE10-Nano")

    it "AC-4: guide contains LiteX de10nano target":
        # @req: REQ-UNIT-DOC-005
        step("Verify: AC-4: guide contains LiteX de10nano target")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val g = guide()
        expect(g).to_contain("de10nano")

    it "AC-4: guide contains download or install step":
        # @req: REQ-UNIT-DOC-006
        step("Verify: AC-4: guide contains download or install step")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val g = guide()
        expect(g).to_contain("install")

    it "AC-4: guide contains VexRiscv or SMP reference":
        # @req: REQ-UNIT-DOC-007
        step("Verify: AC-4: guide contains VexRiscv or SMP reference")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val g = guide()
        expect(g).to_contain("VexRiscv")


# ============================================================================
# AC-4: Guide module constants
# ============================================================================

describe "Quartus setup guide constants":
    it "AC-4: quartus_lite_version is non-empty":
        # @req: REQ-UNIT-DOC-008
        step("Verify: AC-4: quartus_lite_version is non-empty")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val v = quartus_lite_version()
        val len = v.length()
        expect(len).to_be_greater_than(0)

    it "AC-4: de10nano_device_string is 5CSEBA6U23I7":
        # @req: REQ-UNIT-DOC-009
        step("Verify: AC-4: de10nano_device_string is 5CSEBA6U23I7")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val d = de10nano_device_string()
        expect(d).to_equal("5CSEBA6U23I7")

    it "AC-4: litex_de10nano_build_command contains make.py":
        # @req: REQ-UNIT-DOC-010
        step("Verify: AC-4: litex_de10nano_build_command contains make.py")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cmd = litex_de10nano_build_command()
        expect(cmd).to_contain("make.py")

    it "AC-4: litex_de10nano_build_command contains de10nano":
        # @req: REQ-UNIT-DOC-011
        step("Verify: AC-4: litex_de10nano_build_command contains de10nano")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cmd = litex_de10nano_build_command()
        expect(cmd).to_contain("de10nano")
