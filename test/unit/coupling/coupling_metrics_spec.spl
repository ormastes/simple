        expect(find_method_index(methods, "missing")).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "returns -1 for empty list":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: returns -1 for empty list")
        var methods: [MethodFieldAccess] = []
        expect(find_method_index(methods, "any")).to_equal(-1)  # oracle: -1 — named expected value from the requirement

