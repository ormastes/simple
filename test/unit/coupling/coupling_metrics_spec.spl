    it "returns 0 when total_public is 0":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: returns 0 when total_public is 0")
        val usages = [make_usage("a", 5)]
        val result = compute_eur(usages, 0)
        expect(result).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement

    it "returns 1.0 when all methods used":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: returns 1.0 when all methods used")
