# ============================================================================
# relaxed_tokenizer.spl — to_relaxed_tokens
# ============================================================================

describe "to_relaxed_tokens":
    it "filters out whitespace tokens":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: filters out whitespace tokens")
        val tokens = [
            make_token(SimpleTokenKind.Identifier, 1, 0),
            make_token(SimpleTokenKind.Whitespace, 1, 5),
            make_token(SimpleTokenKind.Operator, 1, 6)
        ]
        val relaxed = to_relaxed_tokens(tokens)
        expect(relaxed.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "filters out comment tokens":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: filters out comment tokens")
        val tokens = [
            make_token(SimpleTokenKind.Keyword, 1, 0),
            make_token(SimpleTokenKind.Comment, 1, 5)
        ]
        val relaxed = to_relaxed_tokens(tokens)
        expect(relaxed.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "preserves line and column info":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: preserves line and column info")
        val tokens = [make_token(SimpleTokenKind.Literal, 7, 12)]
        val relaxed = to_relaxed_tokens(tokens)
        expect(relaxed.get(0).line).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(relaxed.get(0).column).to_equal(12)  # oracle: 12 — named expected value from the requirement

    it "sets correct kind_ordinal":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: sets correct kind_ordinal")
        val tokens = [
            make_token(SimpleTokenKind.Keyword, 1, 0),
            make_token(SimpleTokenKind.Punctuation, 1, 3)
        ]
        val relaxed = to_relaxed_tokens(tokens)
        expect(relaxed.get(0).kind_ordinal).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(relaxed.get(1).kind_ordinal).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "returns empty for empty input":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: returns empty for empty input")
        var tokens: [SimpleToken] = []
        val relaxed = to_relaxed_tokens(tokens)
        expect(relaxed.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "returns empty when all tokens are whitespace/comments":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: returns empty when all tokens are whitespace/comments")
        val tokens = [
            make_token(SimpleTokenKind.Whitespace, 1, 0),
            make_token(SimpleTokenKind.Comment, 2, 0),
            make_token(SimpleTokenKind.Whitespace, 3, 0)
        ]
        val relaxed = to_relaxed_tokens(tokens)
        expect(relaxed.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
