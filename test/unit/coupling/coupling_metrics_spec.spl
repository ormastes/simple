        val dist = type_set_edit_distance(["i64"], ["i64", "text"])
        expect(dist).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "returns 1 for single removal":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: returns 1 for single removal")
        val dist = type_set_edit_distance(["i64", "text"], ["text"])
        expect(dist).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "returns sum of lengths for completely disjoint sets":
