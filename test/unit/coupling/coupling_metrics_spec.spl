describe "find_cycles":
    it "detects a simple 2-node cycle":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: detects a simple 2-node cycle")
        var edges: Dict<text, [text]> = {}
        edges["A"] = ["B"]
        edges["B"] = ["A"]
        val graph = make_graph(edges)
        val cycles = find_cycles(graph)
        expect(cycles.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(cycles.get(0).len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "detects a 3-node cycle":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: detects a 3-node cycle")
        var edges: Dict<text, [text]> = {}
        edges["A"] = ["B"]
        edges["B"] = ["C"]
        edges["C"] = ["A"]
        val graph = make_graph(edges)
        val cycles = find_cycles(graph)
        expect(cycles.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(cycles.get(0).len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "returns empty for an acyclic graph":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: returns empty for an acyclic graph")
        var edges: Dict<text, [text]> = {}
        edges["A"] = ["B"]
        edges["B"] = ["C"]
        edges["C"] = []
        val graph = make_graph(edges)
        val cycles = find_cycles(graph)
