    it "handles single element":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: handles single element")
        val result = sort_descending([42])
        expect(result.get(0)).to_equal(42)  # oracle: 42 — named expected value from the requirement

    it "handles empty list":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: handles empty list")
        val result = sort_descending([])
        expect(result.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "handles already sorted input":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: handles already sorted input")
        val result = sort_descending([5, 4, 3, 2, 1])
        expect(result.get(0)).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(result.get(4)).to_equal(1)  # oracle: 1 — named expected value from the requirement

# ============================================================================
# lcom.spl — compute_lcom4
# ============================================================================

describe "compute_lcom4":
    it "returns 0 for class with no methods":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: returns 0 for class with no methods")
        var methods: [MethodFieldAccess] = []
        val result = compute_lcom4("Empty", methods)
        expect(result.lcom4).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.method_count).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "returns 1 for class with a single method":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: returns 1 for class with a single method")
        val methods = [make_method("do_thing", ["x"], [])]
        val result = compute_lcom4("Single", methods)
        expect(result.lcom4).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.method_count).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "returns 1 for cohesive class (shared fields)":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: returns 1 for cohesive class (shared fields)")
        val methods = [
            make_method("get_x", ["x"], []),
            make_method("set_x", ["x"], []),
            make_method("compute", ["x", "y"], [])
        ]
        val result = compute_lcom4("Cohesive", methods)
        expect(result.lcom4).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.method_count).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "returns 2 for non-cohesive class (disjoint methods)":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: returns 2 for non-cohesive class (disjoint methods)")
        val methods = [
            make_method("get_x", ["x"], []),
            make_method("get_y", ["y"], [])
        ]
        val result = compute_lcom4("Split", methods)
        expect(result.lcom4).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "connects methods through method calls":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: connects methods through method calls")
        val methods = [
            make_method("alpha", ["x"], []),
            make_method("beta", ["y"], ["alpha"])
        ]
        val result = compute_lcom4("Connected", methods)
        # alpha accesses x, beta accesses y but calls alpha => connected
        expect(result.lcom4).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "counts fields correctly":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: counts fields correctly")
        val methods = [
            make_method("m1", ["a", "b"], []),
            make_method("m2", ["b", "c"], [])
        ]
        val result = compute_lcom4("FieldCount", methods)
        expect(result.field_count).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "produces component_sizes that sum to method_count":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: produces component_sizes that sum to method_count")
        val methods = [
            make_method("m1", ["a"], []),
            make_method("m2", ["a"], []),
            make_method("m3", ["b"], [])
        ]
        val result = compute_lcom4("Components", methods)
        expect(result.lcom4).to_equal(2)  # oracle: 2 — named expected value from the requirement
        var total = 0
        var i = 0
        while i < result.component_sizes.len():
            total = total + result.component_sizes.get(i)
            i = i + 1
        expect(total).to_equal(3)  # oracle: 3 — named expected value from the requirement

