describe "is_digit":
    it "returns true for digit characters":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: returns true for digit characters")
        expect(is_digit("0")).to_equal(true)
        expect(is_digit("5")).to_equal(true)
        expect(is_digit("9")).to_equal(true)

    it "returns false for non-digit characters":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: returns false for non-digit characters")
        expect(is_digit("a")).to_equal(false)
        expect(is_digit("Z")).to_equal(false)
        expect(is_digit(" ")).to_equal(false)

# ============================================================================
# layer_check.spl — find_layer_violations
# ============================================================================

describe "find_layer_violations":
    it "detects violation when lower layer imports higher layer":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: detects violation when lower layer imports higher layer")
        var edges: Dict<text, [text]> = {}
        edges["compiler/10.frontend/foo"] = ["compiler/30.types/bar"]
        edges["compiler/30.types/bar"] = []
        val graph = make_graph(edges)
        val violations = find_layer_violations(graph)
        expect(violations.len()).to_be_greater_than(0)
        if violations.len() > 0:
            expect(violations[0].from_layer).to_equal(10)  # oracle: 10 — named expected value from the requirement
            expect(violations[0].to_layer).to_equal(30)  # oracle: 30 — named expected value from the requirement

    it "allows higher layer importing lower layer":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: allows higher layer importing lower layer")
        var edges: Dict<text, [text]> = {}
        edges["compiler/30.types/bar"] = ["compiler/00.common/foo"]
        edges["compiler/00.common/foo"] = []
        val graph = make_graph(edges)
        val violations = find_layer_violations(graph)
        expect(violations.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "no violations for non-layer modules":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: no violations for non-layer modules")
        var edges: Dict<text, [text]> = {}
        edges["std/text/utils"] = ["std/math/ops"]
        edges["std/math/ops"] = []
        val graph = make_graph(edges)
        val violations = find_layer_violations(graph)
        expect(violations.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "returns empty for empty graph":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: returns empty for empty graph")
        var edges: Dict<text, [text]> = {}
        val graph = make_graph(edges)
        val violations = find_layer_violations(graph)
        expect(violations.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "uses detailed_edges when available":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: uses detailed_edges when available")
        var edges: Dict<text, [text]> = {}
        val detailed = [
            make_edge("compiler/10.frontend/parser", "compiler/30.types/checker")
        ]
        val graph = make_graph_with_edges(edges, detailed)
        val violations = find_layer_violations(graph)
        expect(violations.len()).to_be_greater_than(0)
        if violations.len() > 0:
            expect(violations[0].from_layer).to_equal(10)  # oracle: 10 — named expected value from the requirement
            expect(violations[0].to_layer).to_equal(30)  # oracle: 30 — named expected value from the requirement

