# ============================================================================
# metrics.spl — compute_all_metrics
# ============================================================================

describe "compute_all_metrics":
    it "computes instability for a hub-and-spoke graph":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: computes instability for a hub-and-spoke graph")
        var edges: Dict<text, [text]> = {}
        edges["hub"] = ["a", "b", "c"]
        edges["a"] = []
        edges["b"] = []
        edges["c"] = []
        val graph = make_graph(edges)
        val metrics = compute_all_metrics(graph)
        val hub = find_metric_by_name(metrics, "hub")
        # hub: fan_out=3, fan_in=0, instability=3/(0+3)=1.0
        expect(hub.fan_out).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(hub.fan_in).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(hub.instability).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement

    it "leaf modules have instability 0":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: leaf modules have instability 0")
        var edges: Dict<text, [text]> = {}
        edges["hub"] = ["leaf"]
        edges["leaf"] = []
        val graph = make_graph(edges)
        val metrics = compute_all_metrics(graph)
        val leaf = find_metric_by_name(metrics, "leaf")
        # leaf: fan_out=0, fan_in=1, instability=0/(1+0)=0.0
        expect(leaf.fan_out).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(leaf.instability).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement

    it "isolated node has instability 0":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: isolated node has instability 0")
        var edges: Dict<text, [text]> = {}
        edges["solo"] = []
        val graph = make_graph(edges)
        val metrics = compute_all_metrics(graph)
        val solo = find_metric_by_name(metrics, "solo")
        expect(solo.instability).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
        expect(solo.distance).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement

    it "cbo equals fan_out":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: cbo equals fan_out")
        var edges: Dict<text, [text]> = {}
        edges["X"] = ["Y", "Z"]
        edges["Y"] = []
        edges["Z"] = []
        val graph = make_graph(edges)
        val metrics = compute_all_metrics(graph)
        val x = find_metric_by_name(metrics, "X")
        expect(x.cbo).to_equal(x.fan_out)

    it "distance from main sequence is computed correctly":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: distance from main sequence is computed correctly")
        # Module with instability=0.5, abstractness=0 -> distance = |0+0.5-1| = 0.5
        var edges: Dict<text, [text]> = {}
        edges["M"] = ["N"]
        edges["N"] = ["M"]
        val graph = make_graph(edges)
        val metrics = compute_all_metrics(graph)
        val m = find_metric_by_name(metrics, "M")
        # M: fan_out=1, fan_in=1, instability=0.5, abstractness=0 -> distance = |0+0.5-1| = 0.5
        expect(m.instability).to_equal(0.5)  # oracle: 0.5 — named expected value from the requirement
        expect(m.distance).to_equal(0.5)  # oracle: 0.5 — named expected value from the requirement

