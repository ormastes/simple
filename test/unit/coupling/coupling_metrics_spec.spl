# ============================================================================
# dsm.spl — build_dsm
# ============================================================================

describe "build_dsm":
    it "builds NxN matrix for N modules":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: builds NxN matrix for N modules")
        var edges: Dict<text, [text]> = {}
        edges["A"] = ["B"]
        edges["B"] = ["C"]
        edges["C"] = []
        val graph = make_graph(edges)
        val dsm = build_dsm(graph)
        expect(dsm.modules.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(dsm.matrix.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "records dependency in correct cell":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: records dependency in correct cell")
        var edges: Dict<text, [text]> = {}
        edges["A"] = ["B"]
        edges["B"] = []
        val graph = make_graph(edges)
        val dsm = build_dsm(graph)
        # modules sorted alphabetically: [A, B]
        expect(dsm.modules.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(dsm.matrix.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "handles empty graph":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: handles empty graph")
        var edges: Dict<text, [text]> = {}
        val graph = make_graph(edges)
        val dsm = build_dsm(graph)
        expect(dsm.modules.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(dsm.matrix.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "sorts modules alphabetically":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: sorts modules alphabetically")
        var edges: Dict<text, [text]> = {}
        edges["C"] = ["A"]
        edges["B"] = []
        edges["A"] = []
        val graph = make_graph(edges)
        val dsm = build_dsm(graph)
        expect(dsm.modules.get(0)).to_equal("A")
        expect(dsm.modules.get(1)).to_equal("B")
        expect(dsm.modules.get(2)).to_equal("C")

    it "diagonal is always zero":
        # @req: REQ-GEN-COUPLING-001
        step("Verify: diagonal is always zero")
        var edges: Dict<text, [text]> = {}
        edges["A"] = ["B"]
        edges["B"] = ["A"]
        val graph = make_graph(edges)
        val dsm = build_dsm(graph)
        expect(dsm.matrix.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

