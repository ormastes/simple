# Test Group 4: text.char_at() Method
# ============================================================================

describe "text.char_at() method":
    """
    ## Character Access as Text

    char_at(i) returns the character at index i as a text value.
    """

    it "returns first character":
        step("Verify: returns first character")
        val s = "hello"
        expect(s.char_at(0)).to_equal("h")

    it "returns second character":
        step("Verify: returns second character")
        val s = "hello"
        expect(s.char_at(1)).to_equal("e")

    it "returns middle character":
        step("Verify: returns middle character")
        val s = "hello"
        expect(s.char_at(2)).to_equal("l")

    it "returns last character":
        step("Verify: returns last character")
        val s = "hello"
        expect(s.char_at(4)).to_equal("o")

    it "returns empty for out-of-bounds index":
        step("Verify: returns empty for out-of-bounds index")
        val s = "hello"
        expect(s.char_at(10)).to_equal("")

    it "returns empty for negative index":
        step("Verify: returns empty for negative index")
        val s = "hello"
        expect(s.char_at(-1)).to_equal("")


# ============================================================================
# Test Group 5: text.char_code_at() Method
# ============================================================================

describe "text.char_code_at() method":
    """
    ## Character Code Access

    char_code_at(i) returns the Unicode code point of char at index i.
    """

    it "returns code for 'a'":
        step("Verify: returns code for 'a'")
        val s = "abc"
        expect(s.char_code_at(0)).to_equal(97)  # oracle: 97 — named expected value from the requirement

    it "returns code for 'b'":
        step("Verify: returns code for 'b'")
        val s = "abc"
        expect(s.char_code_at(1)).to_equal(98)  # oracle: 98 — named expected value from the requirement

    it "returns code for 'A'":
        step("Verify: returns code for 'A'")
        val s = "ABC"
        expect(s.char_code_at(0)).to_equal(65)  # oracle: 65 — named expected value from the requirement

    it "returns 0 for out-of-bounds":
        step("Verify: returns 0 for out-of-bounds")
        val s = "abc"
        expect(s.char_code_at(10)).to_equal(0)  # oracle: 0 — named expected value from the requirement


