    it "gets first character":
        step("Verify: gets first character")
        val s = "abc"
        val ch = s[0]
        expect(ch).to_equal("a")

    it "gets middle character":
        step("Verify: gets middle character")
        val s = "abc"
        val ch = s[1]
        expect(ch).to_equal("b")

    it "gets last character":
        step("Verify: gets last character")
        val s = "abc"
        val ch = s[2]
        expect(ch).to_equal("c")

    it "gets space character":
        step("Verify: gets space character")
        val s = "a b"
        val ch = s[1]
        expect(ch).to_equal(" ")


# ============================================================================
# Test Group 7: Regression — Other text Methods
# ============================================================================

describe "text methods regression":
    """
    ## Regression Tests

    Ensure existing text methods still work after slice/substring fixes.
    """

    it "len() still works":
        step("Verify: len() still works")
        expect("hello".len()).to_equal(5)
        expect("".len()).to_equal(0)

    it "contains() still works":
        step("Verify: contains() still works")
        expect("hello".contains("ell")).to_equal(true)
        expect("hello".contains("xyz")).to_equal(false)

    it "starts_with() still works":
        step("Verify: starts_with() still works")
        expect("hello".starts_with("hel")).to_equal(true)
        expect("hello".starts_with("xyz")).to_equal(false)

    it "ends_with() still works":
        step("Verify: ends_with() still works")
        expect("hello".ends_with("llo")).to_equal(true)
        expect("hello".ends_with("xyz")).to_equal(false)

    it "trim() still works":
        step("Verify: trim() still works")
        expect("  hello  ".trim()).to_equal("hello")

    it "replace() still works":
        step("Verify: replace() still works")
        expect("hello".replace("l", "r")).to_equal("herro")

    it "split() still works":
        step("Verify: split() still works")
        val parts = "a,b,c".split(",")
        expect(parts.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "index_of() still works":
        step("Verify: index_of() still works")
        val idx = "hello".index_of("ll")
        expect(idx ?? -1).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "to_upper() still works":
        step("Verify: to_upper() still works")
        expect("hello".upper()).to_equal("HELLO")

    it "to_lower() still works":
        step("Verify: to_lower() still works")
        expect("HELLO".lower()).to_equal("hello")

    it "to_string() still works":
        step("Verify: to_string() still works")
        expect("hello".to_string()).to_equal("hello")


# ============================================================================
# Test Group 8: Multi-byte / UTF-8 (non-ASCII) — BYTE-indexed slicing
# ============================================================================

describe "text.slice()/text.substring() with multi-byte UTF-8 content":
    """
    ## Non-ASCII Coverage

    Every assertion above uses pure-ASCII fixtures, where a byte offset and
    a character offset are numerically identical -- so this spec could not
    detect a regression in either direction (naive byte-indexed OR naive
    character-indexed slicing would both pass every prior assertion).

    slice()/substring() on the lane `bin/simple test` actually executes
    (verified 2026-07-29 against a from-source rebuild of the Rust seed,
    commit f119f8b7120: `src/compiler_rust/compiler/src/interpreter_method/
    string.rs`, the "slice"|"substring" arm) are BYTE-indexed, matching
    `len()`/`index_of()` on the same lane and the JIT/native `rt_slice`.
    That is the established end-state this codebase is converging on
    (index_of/len were already byte-valued; slice/substring were the last
    holdout). The cases below pin BYTE-indexed correctness for multi-byte
    content: they go RED if slice()/substring() ever drift back to
    character indexing, or if a byte offset that splits a codepoint stops
    producing the documented U+FFFD replacement.

    Positions were computed from the exact UTF-8 byte layout (verified via
    `char_code_at` on the sliced results, not eyeballed) rather than
    hand-counted, per the same rule call sites must follow: derive a byte
    offset from `index_of()`/`len()`, or from a known encoding width -- 2
    bytes for U+0080-U+07FF (e.g. é), 3 bytes for U+0800-U+FFFF (most CJK),
    4 bytes for U+10000+ (e.g. emoji) -- never assume 1 char == 1 byte.
    """

    context "2-byte codepoints (Latin-1 supplement, e.g. e-acute = U+00E9)":
        it "extracts a 2-byte character using an index_of()-derived byte offset":
            step("Verify: extracts a 2-byte character using an index_of()-derived byte offset")
            val s = "café"
            # "café" = 63 61 66 C3 A9 (5 bytes, 4 characters). index_of
            # returns the BYTE offset of 'é's lead byte; its encoding is
            # 2 bytes wide, so the end offset is start + 2.
            val start = s.index_of("é") ?? -1
            expect(start).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(s.slice(start, start + 2)).to_equal("é")
            expect(s.substring(start, start + 2)).to_equal("é")

        it "keeps a 2-byte character whole inside a longer byte slice":
            step("Verify: keeps a 2-byte character whole inside a longer byte slice")
            val s = "café au lait"
            # bytes: c a f C3 A9 ' ' a u ' ' l a i t (13 bytes total)
            expect(s.slice(0, 5)).to_equal("café")
            val au_at = s.index_of("au") ?? -1
            expect(au_at).to_equal(6)  # oracle: 6 — named expected value from the requirement
            expect(s.slice(0, au_at + 2)).to_equal("café au")

    context "3-byte codepoints (CJK, e.g. 日本語)":
        it "slices individual CJK characters using known 3-byte width":
            step("Verify: slices individual CJK characters using known 3-byte width")
            val s = "日本語"
            # Every character here is in the 3-byte UTF-8 range, so byte
            # offsets are simply 3 * (character index).
            expect(s.len()).to_equal(9)  # oracle: 9 — named expected value from the requirement
            expect(s.slice(0, 3)).to_equal("日")
            expect(s.slice(3, 6)).to_equal("本")
            expect(s.slice(6, 9)).to_equal("語")

        it "slices a CJK range using index_of()-derived byte offsets":
            step("Verify: slices a CJK range using index_of()-derived byte offsets")
            val s = "日本語"
            val ben_at = s.index_of("本") ?? -1
            expect(ben_at).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(s.slice(ben_at, s.len())).to_equal("本語")
            expect(s.substring(0, ben_at)).to_equal("日")

    context "4-byte codepoints (emoji, e.g. grinning face = U+1F600)":
        it "keeps an emoji whole using its known 4-byte width":
            step("Verify: keeps an emoji whole using its known 4-byte width")
            val s = "abc\u{1F600}def"
            # "abc" = 3 bytes, the emoji = 4 bytes (U+10000+), "def" = 3
            # bytes -- 10 bytes total.
            expect(s.len()).to_equal(10)  # oracle: 10 — named expected value from the requirement
            expect(s.slice(3, 7)).to_equal("😀")
            expect(s.substring(3, 7)).to_equal("😀")

        it "keeps an emoji whole inside a longer byte slice":
            step("Verify: keeps an emoji whole inside a longer byte slice")
            val s = "abc\u{1F600}def"
            expect(s.slice(0, 7)).to_equal("abc😀")
            expect(s.slice(3, 10)).to_equal("😀def")

    context "codepoint-boundary safety (the byte-split / U+FFFD case)":
        """
        A byte range that lands inside a multi-byte codepoint's UTF-8
        encoding cannot be represented as valid text: slice()/substring()
        substitute U+FFFD via Rust's `String::from_utf8_lossy` (see
        src/compiler_rust/compiler/src/interpreter_method/string.rs, the
        "slice"|"substring" arm). This is verified, current, intentional
        behavior on the lane `bin/simple test` executes -- not hypothetical.
        Pinning it here means any call site that hand-counts a character
        position instead of deriving a byte offset is exactly one non-ASCII
        input away from silently emitting U+FFFD.
        """
        it "splits a 2-byte codepoint (café) into a lossy replacement char":
            step("Verify: splits a 2-byte codepoint (café) into a lossy replacement char")
            val s = "café"
            # Byte 3 alone is 0xC3, the lead byte of 'é' without its
            # continuation byte (0xA9) -- invalid UTF-8 on its own.
            val bad = s.slice(3, 4)
            expect(bad).to_equal("\u{FFFD}")
            expect(bad.char_code_at(0)).to_equal(65533)  # oracle: 65533 — named expected value from the requirement

        it "splits a 3-byte codepoint (CJK) into a lossy replacement char":
            step("Verify: splits a 3-byte codepoint (CJK) into a lossy replacement char")
            val s = "a日b"
            val bad = s.slice(1, 2)
            expect(bad).to_equal("\u{FFFD}")
            expect(bad.char_code_at(0)).to_equal(65533)  # oracle: 65533 — named expected value from the requirement

        it "splits a 4-byte codepoint (emoji) into a lossy replacement char":
            step("Verify: splits a 4-byte codepoint (emoji) into a lossy replacement char")
            val s = "a😀b"
            val bad = s.slice(1, 2)
            expect(bad).to_equal("\u{FFFD}")
            expect(bad.char_code_at(0)).to_equal(65533)  # oracle: 65533 — named expected value from the requirement
