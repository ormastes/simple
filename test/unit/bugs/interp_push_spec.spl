# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Bug: Module-level .push() → "unsupported path call"
# Severity: P2
# Workaround: Use arr = arr + [item] for module-level arrays

use std.spec.step

fn _len(a): a.len()
fn _get(a, i): a[i]

# Module-level array - .push() fails here
var MODULE_ITEMS: [text] = []
var MODULE_COUNT = 0

# Workaround: concatenation instead of .push()
fn module_add_item(item: text):
    MODULE_ITEMS = MODULE_ITEMS + [item]
    MODULE_COUNT = MODULE_COUNT + 1

fn module_get_items() -> [text]:
    MODULE_ITEMS

# Wrap test logic in module-level functions to avoid closure capture limitation
fn _test_concat_workaround() -> Int:
    MODULE_ITEMS = []
    MODULE_COUNT = 0
    module_add_item("alpha")
    module_add_item("beta")
    module_add_item("gamma")
    MODULE_COUNT

fn _test_concat_items() -> [text]:
    MODULE_ITEMS = []
    MODULE_COUNT = 0
    module_add_item("alpha")
    module_add_item("beta")
    module_add_item("gamma")
    module_get_items()

fn _test_push_local() -> Int:
    var local_items: [text] = []
    local_items.push("one")
    local_items.push("two")
    local_items.len()

fn _test_push_local_first() -> text:
    var local_items: [text] = []
    local_items.push("one")
    local_items.push("two")
    local_items[0]

fn _test_preserve_items() -> text:
    MODULE_ITEMS = []
    MODULE_COUNT = 0
    module_add_item("first")
    module_add_item("second")
    val items = module_get_items()
    items[1]

describe "Module-level .push() bug":
    # @manual scenario evidence
    it "demonstrates workaround with concatenation":
        # @req REQ-SSPEC-UNIT
        step("demonstrates workaround with concatenation")
        expect(_test_concat_workaround()).to_equal(3)
        val items = _test_concat_items()
        expect(_len(items)).to_equal(3)
        expect(_get(items, 0)).to_equal("alpha")
        expect(_get(items, 1)).to_equal("beta")
        expect(_get(items, 2)).to_equal("gamma")

    it "push works inside local scope":
        # @req REQ-SSPEC-UNIT
        step("push works inside local scope")
        expect(_test_push_local()).to_equal(2)
        expect(_test_push_local_first()).to_equal("one")

    it "workaround preserves existing items":
        # @req REQ-SSPEC-UNIT
        step("workaround preserves existing items")
        expect(_test_preserve_items()).to_equal("second")
