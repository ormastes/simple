# @req: REQ-APP-COMPLETE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/app/complete/package_1_complete_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

# @req: REQ-APP-APP_TOOL-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/app_tool_behavior.md
# doc-path: doc/03_plan/sys_test/app_tool_behavior.md
# doc-path: doc/04_architecture/lib/app_tool.md
# doc-path: doc/05_design/lib/app_tool_oracles.md
# @manual: primary

use std.spec
use std.io.{env_get, process_run}
use std.spec.step

# doc-path: doc/01_research/local/package_1_complete.md
# doc-path: doc/03_plan/sys_test/package_1_complete.md
# doc-path: doc/04_architecture/package_1_complete.md
# doc-path: doc/05_design/package_1_complete.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "array filtering and membership":
        step("Verify: array filtering and membership")
        # @req: REQ-APP-COMPLETE-001
        # @req: REQ-APP-APP_TOOL-001
        expect([1, 2, 3].filter(fn(x: i64): x > 1)).to_equal([2, 3])
        expect([1, 2, 3].contains(2)).to_equal(true)
        expect([1, 2].concat([3])).to_equal([1, 2, 3])

    it "integer conversion helpers":
        step("Verify: integer conversion helpers")
        # @req: REQ-APP-COMPLETE-001
        expect(42.to_text()).to_equal("42")
        expect("42".parse_int()).to_equal(42)  # oracle: decimal parse

    it "for-range iterates the half-open span":
        step("Verify: for-range iterates the half-open span")
        # @req: REQ-APP-COMPLETE-001
        var seen = 0
        for i in 0..4:
            seen = seen + 1
        expect(seen).to_equal(4)  # oracle: 0..4 yields four iterations

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "while with break and continue":
        step("Verify: while with break and continue")
        # @req: REQ-APP-COMPLETE-001
        var i = 0
        var acc = 0
        while i < 10:
            i = i + 1
            if i == 3: continue
            if i == 7: break
            acc = acc + i
        expect(acc).to_equal(18)  # oracle: 1+2+4+5+6

    it "truncating division and signed remainder":
        step("Verify: truncating division and signed remainder")
        # @req: REQ-APP-COMPLETE-001
        expect(7 / 2).to_equal(3)  # oracle: i64 division truncates toward zero
        expect(-7 / 2).to_equal(-3)  # oracle: truncation is toward zero
        expect(7 % 2).to_equal(1)  # oracle: remainder of positive dividend
        expect(-7 % 2).to_equal(-1)  # oracle: remainder keeps dividend sign

    it "nil option falls to else arm":
        step("Verify: nil option falls to else arm")
        # @req: REQ-APP-COMPLETE-001
        val opt = nil
        var chosen = 1
        match opt:
            Some(x): chosen = x
            nil: chosen = -1
        expect(chosen).to_equal(-1)  # oracle: nil arm taken
