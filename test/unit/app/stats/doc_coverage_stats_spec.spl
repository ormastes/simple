    it "calculates coverage percentages correctly":
        # @req: REQ-APP-STATS-001
        step("Verify: calculates coverage percentages correctly")
        # Test percentage calculation logic
        val total = 100
        val documented = 79
        val with_tests = 32

        val doc_percent = (documented * 100) / total
        val test_percent = (with_tests * 100) / total

        expect(doc_percent).to_equal(79)  # oracle: 79 — named expected value from the requirement
