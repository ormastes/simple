    it "handles zero division when no public functions":
        # @req: REQ-APP-STATS-001
        step("Verify: handles zero division when no public functions")
        # When total_public = 0, percentages should be 0
        val total = 0
        val documented = 0
        val with_tests = 0

        var doc_percent = 0
        var test_percent = 0

        if total > 0:
            doc_percent = (documented * 100) / total
            test_percent = (with_tests * 100) / total

        expect(doc_percent).to_equal(0)  # oracle: 0 — named expected value from the requirement
