        step("Verify: matches functions to sdoctest blocks")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Test the matching logic
        val func_name = "my_function"
        val block = "Example usage:\nmy_function(42)\n"

        val contains_func = block.contains(func_name)
        expect(contains_func).to_equal(true)

    it "counts documented vs undocumented items":
        # @req: REQ-UNIT-APP-007
        step("Verify: counts documented vs undocumented items")
