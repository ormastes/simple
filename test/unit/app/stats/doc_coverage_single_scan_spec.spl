use app.stats.doc_coverage_dynamic.{
    dc_counts_for_source, dc_get_path, dc_path_roots}
use std.io_runtime.file_read
use std.spec.step

describe "doc coverage single-scan facts":
    it "preserves public documented and grep-context docstring counts":
        step("Model the historical grep union without duplicate context lines")
        val source = ("# documented\n" +
            "pub fn first():\n" +
            "\"\"\" first doc line \"\"\"\n" +
            "\"\"\" second doc line \"\"\"\n" +
            "pub fn second():\n" +
            "pub fn adjacent():\n" +
            "    pub fn indented_not_public():\n")
        val counts = dc_counts_for_source(source)
        expect(counts.total).to_equal(3)
        expect(counts.documented).to_equal(1)
        expect(counts.with_docstring).to_equal(2)

    it "preserves duplicate roots in requested scope parsing":
        step("Retain historical default multiplicity")
        val default_request = dc_get_path([])
        expect(default_request.roots).to_equal(
            ["src/lib", "src/core", "src/lib", "src/app"])
        step("Treat user input as one literal root, not shell syntax")
        expect(dc_path_roots("src/*")).to_equal(["src/*"])
        expect(dc_path_roots("a root with spaces")).to_equal(
            ["a root with spaces"])
        val explicit_default_text = dc_get_path(
            ["src/lib src/core src/lib src/app"])
        expect(explicit_default_text.roots).to_equal(
            ["src/lib src/core src/lib src/app"])

    it "builds one cache entry per distinct root and uses no process in reports":
        step("Prevent repeated tree scans and grep-output retention")
        val source = file_read("src/app/stats/doc_coverage_dynamic.spl")
        expect(source).to_contain("val resolved = path_absolute(root) ?? \"\"")
        expect(source).to_contain("if resolved == child:")
        val cache_start = source.index_of("fn dc_report_facts(requested_roots: [text])")
        val cache_end = source.index_of("# Run a shell command", cache_start)
        val cache_body = source.slice(cache_start, cache_end)
        expect(cache_body).to_contain("var root_index: {text: i64} = {}")
        expect(cache_body).to_contain("if not root_index.has(root)")
        expect(cache_body).to_contain("for root in root_names:\n        root_counts.push(dc_scan_root(root))")
        expect(cache_body).to_contain("for root in requested_roots:\n        requested = dc_add_counts(requested, root_counts[root_index[root]])")

        val terminal = source.slice(
            source.index_of("fn print_terminal_report(request: CoveragePathRequest)"),
            source.index_of("# Print JSON-format coverage report"))
        val json = source.slice(
            source.index_of("fn print_json_report(request: CoveragePathRequest)"),
            source.index_of("# Print Markdown-format coverage report"))
        val markdown = source.slice(
            source.index_of("fn print_md_report(request: CoveragePathRequest)"),
            source.index_of("# Show undocumented"))
        for report_body in [terminal, json, markdown]:
            expect(report_body.split("dc_report_facts(request.roots)").len()).to_equal(2)
            expect(report_body).not.to_contain("process_run(")
            expect(report_body).not.to_contain("dc_scan_root(")
            expect(report_body).not.to_contain("count_public_fns(")
            expect(report_body).not.to_contain("count_documented_fns(")
            expect(report_body).not.to_contain("count_docstring_fns(")
