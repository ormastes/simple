# @manual_section: recursion guard
describe "Simple Test Runner Recursion Guard":

    it "env var name is SIMPLE_TEST_RUNNER_RUST":
        # @req REQ-TOOL-RUNNER-006
        # @capture(bit_table): guard environment-variable contract retained
        step("read the runtime child-spawn source and verify the guard variable name")
        val guard_source = file_read("src/compiler_rust/runtime/src/value/cli_sffi.rs") ?? ""
        val sets_guard_env = guard_source.contains("SIMPLE_TEST_RUNNER_RUST")
        expect(sets_guard_env).to_equal(true)

    it "guard value is 1":
        # @req REQ-TOOL-RUNNER-006
        # @capture(bit_table): guard value contract retained
        step("read the runtime child-spawn source and verify the guard value")
        val guard_source = file_read("src/compiler_rust/runtime/src/value/cli_sffi.rs") ?? ""
        val sets_guard_to_one = guard_source.contains("\"SIMPLE_TEST_RUNNER_RUST\", \"1\"")
        expect(sets_guard_to_one).to_equal(true)

    it "Rust runner detects guard and skips Simple dispatch":
        # @req REQ-TOOL-RUNNER-006
        # @capture(bit_table): driver-side guard detection contract retained
        step("read the driver entry and verify it consults the guard override")
        val driver_source = file_read("src/compiler_rust/driver/src/main.rs") ?? ""
        val rust_side_honors_guard = driver_source.contains("temporary_rust_test_runner_override")
        expect(rust_side_honors_guard).to_equal(true)


