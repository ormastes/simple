"""
## Purpose and audience
Executable evidence for the Simple-language test runner: CLI argument
parsing, test discovery filters, child-output parsing, artifact layout,
timeout handling, the recursion guard, Rust fallback routing, execution
modes, seed shuffle, output formats, environment propagation, skip-feature
listing, test-DB records, and docgen propagation. Audience: engineers
changing src/app/test_runner_new or the runner CLI surface.
## Operator workflow
Run `simple run test/unit/app/tooling/test_runner_simple_spec.spl` from the
repo root. Argument scenarios drive the real parse_test_args entry; guard
and format scenarios assert named contracts against the shipped runner
source.
## Compatibility and limitations
Docgen-propagation scenarios assert against a deliberately non-executable
docgen binary and are known-RED until that path is repaired (real product
defects, kept failing on purpose). Source-contract scenarios read product
source at a fixed path; moving those files requires updating the contract.
## Verification guidance and troubleshooting
Re-run the single file; each failure names the runner surface involved. A
failure in an argument scenario means parse_test_args regressed; a failure
in a source-contract scenario means a shipped runner constant moved or was
renamed.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step
use std.nogc_sync_mut.io.file_ops.{file_read}
use app.test_runner_new.test_runner_args.{parse_test_args}
use app.test_runner_new.test_runner_types.{TestExecutionMode}

fn strip_test_suffix(stem: text) -> text:
    if stem.ends_with("_spec"):
        return stem[0:stem.len() - 5]
    if stem.ends_with("_test"):
        return stem[0:stem.len() - 5]
    stem

fn artifact_dir_for_test(path: text) -> text:
    var relative = path
    if relative.starts_with("simple/std_lib/test/"):
        relative = relative[20:]
    elif relative.starts_with("test/"):
        relative = relative[5:]

    if relative.ends_with(".spl"):
        relative = relative[0:relative.len() - 4]

    val parts = relative.split("/")
    var mapped = []
    var i = 0
    while i < parts.len():
        if i == parts.len() - 1:
            mapped.push(strip_test_suffix(parts[i]))
        else:
            mapped.push(parts[i])
        i = i + 1
    "build/test-artifacts/{mapped.join(\"/\")}"

fn slugify(value: text) -> text:
    var result = ""
    var last_dash = false
    var i = 0
    while i < value.len():
        val ch = value[i]
        val lower = ch.lower()
        val is_alpha = lower >= "a" and lower <= "z"
        val is_digit = ch >= "0" and ch <= "9"
        if is_alpha or is_digit:
            result = result + lower
            last_dash = false
        elif not last_dash:
            result = result + "-"
            last_dash = true
        i = i + 1

    while result.starts_with("-"):
        result = result[1:]
    while result.ends_with("-"):
        result = result[0:result.len() - 1]
    result

fn scenario_dir_for_test(path: text, index: int, group: text, name: text) -> text:
    val base = artifact_dir_for_test(path)
    val joined = if group == "" then name else "{group} {name}"
    val slug = slugify(joined)
    val ordinal = if index < 10 then "00{index}" else if index < 100 then "0{index}" else "{index}"
    "{base}/scenarios/{ordinal}-{slug}"

fn canonical_artifact_files() -> [text]:
    ["summary.txt", "result.json", "run.log", "stdout.log", "stderr.log", "combined.log"]

fn compatibility_artifact_files() -> [text]:
    ["output.log"]



