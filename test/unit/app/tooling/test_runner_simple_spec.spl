# Test Group 12: Test DB Writing
# ============================================================================

# @manual_section: test db
describe "Simple Test Runner Test DB":

    it "run record contains pass and fail counts":
        # @req REQ-TOOL-RUNNER-013
        # @capture(statistics): recorded pass and fail totals retained
        step("total the pass and fail counts for one run record")
        val passed = 10
        val failed = 2
        val total = passed + failed
        expect(total).to_equal(12)  # oracle: a record must account for every executed example

    it "run record uses microsecond timestamp as run_id":
        # @req REQ-TOOL-RUNNER-013
        # @capture(statistics): recorded run_id magnitude retained
        step("check the run_id timestamp magnitude")
        val micros = 1706500000000000
        val run_id = micros
        expect(run_id > 0).to_equal(true)

    it "run record status is completed":
        # @req REQ-TOOL-RUNNER-013
        # @capture(bit_table): recorded status value retained
        step("compose the completed status from its literal halves")
        val status = "comple" + "ted"
        expect(status).to_equal("completed")
