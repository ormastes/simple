describe "Simple Test Runner Timeout":
    # ## Timeout via rt_process_run_timeout FFI
    #
    # Uses `rt_process_run_timeout(cmd, args, timeout_ms)` which returns
    # exit_code=-1 on timeout.

    it "converts seconds to milliseconds":
        # @req: REQ-UNIT-APP-038
        step("Verify: converts seconds to milliseconds")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val timeout_secs = 30
        val timeout_ms = timeout_secs * 1000
        expect(timeout_ms).to_equal(30000)  # oracle: expected value 30000 is the behavior asserted by this regression spec

    it "detects timeout by exit_code -1":
        # @req: REQ-UNIT-APP-039
        step("Verify: detects timeout by exit_code -1")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val exit_code = -1
        val timed_out = exit_code == -1
        expect(timed_out).to_equal(true)

    it "normal exit code is not timeout":
        # @req: REQ-UNIT-APP-040
        step("Verify: normal exit code is not timeout")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val exit_code = 0
        val timed_out = exit_code == -1
        expect(timed_out).to_equal(false)


