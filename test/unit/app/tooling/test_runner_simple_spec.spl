        expect(guard_value).to_equal("1")

    it "Rust runner detects guard and skips Simple dispatch":
        # @req: REQ-UNIT-APP-043
        step("Verify: Rust runner detects guard and skips Simple dispatch")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val guard_set = true
        val uses_rust = guard_set
        expect(uses_rust).to_equal(true)


