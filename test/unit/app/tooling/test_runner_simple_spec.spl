describe "Simple Test Runner SPipe docgen propagation":
    it "does not launch docgen for ordinary formats":
        # @req: REQ-UNIT-APP-018
        step("Verify: does not launch docgen for ordinary formats")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = TestFileResult(path: "fixture_spec.spl", passed: 1, failed: 0, skipped: 0, pending: 0, duration_ms: 0, setup_ms: 0, error: "", timed_out: false, cached: false)
        val options = parse_test_args(["fixture_spec.spl"])
        expect(generate_spipe_docs_for_results([result], options, "/bin/false")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "returns internal-error when docgen fails":
        # @req: REQ-UNIT-APP-019
        step("Verify: returns internal-error when docgen fails")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = TestFileResult(path: "fixture_spec.spl", passed: 1, failed: 0, skipped: 0, pending: 0, duration_ms: 0, setup_ms: 0, error: "", timed_out: false, cached: false)
        val options = parse_test_args(["fixture_spec.spl", "--format", "doc"])
        expect(generate_spipe_docs_for_results([result], options, "/bin/false")).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec


