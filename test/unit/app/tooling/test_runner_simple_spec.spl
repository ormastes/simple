# @manual_section: timeout handling
describe "Simple Test Runner Timeout":

    it "converts seconds to milliseconds":
        # @req REQ-TOOL-RUNNER-005
        # @capture(statistics): converted timeout value retained
        step("convert the configured timeout to milliseconds")
        val timeout_secs = 30
        val timeout_ms = timeout_secs * 1000
        expect(timeout_ms).to_equal(30000)  # oracle: rt_process_run_timeout receives milliseconds

    it "detects timeout by exit_code -1":
        # @req REQ-TOOL-RUNNER-005
        # @capture(bit_table): timeout verdict retained
        step("classify an exit code of -1 as a timeout")
        val exit_code = -1
        val timed_out = exit_code == -1
        expect(timed_out).to_equal(true)

    it "normal exit code is not timeout":
        # @req REQ-TOOL-RUNNER-005
        # @capture(bit_table): timeout verdict retained
        step("classify a zero exit code as not a timeout")
        val exit_code = 0
        val timed_out = exit_code == -1
        expect(timed_out).to_equal(false)


