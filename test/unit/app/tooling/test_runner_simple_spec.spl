# ============================================================================
# Test Group 3: Output Parsing
# ============================================================================

# @manual_section: output parsing
describe "Simple Test Runner Output Parsing":

    it "extracts passed count from examples line":
        # @req REQ-TOOL-RUNNER-003
        # @capture(statistics): parsed pass count retained
        step("subtract reported failures from reported examples")
        val examples = 5
        val failures = 1
        val passed = examples - failures
        expect(passed).to_equal(4)  # oracle: passed = examples - failures is the summary-line contract

    it "handles zero failures":
        # @req REQ-TOOL-RUNNER-003
        # @capture(statistics): parsed pass count retained
        step("subtract zero failures from the examples total")
        val examples = 10
        val failures = 0
        val passed = examples - failures
        expect(passed).to_equal(10)  # oracle: a clean run reports every example as passed

    it "falls back to exit code when no output parsed":
        # @req REQ-TOOL-RUNNER-003
        # @capture(statistics): inferred pass count retained
        step("infer a pass count from a zero exit code with unparsable output")
        val exit_code = 0
        val inferred_passed = if exit_code == 0 then 1 else 0
        expect(inferred_passed).to_equal(1)  # oracle: rc=0 with no parseable summary counts as one passed file

    it "marks non-zero exit as failure when no output parsed":
        # @req REQ-TOOL-RUNNER-003
        # @capture(statistics): inferred failure count retained
        step("infer a failure count from a non-zero exit code with unparsable output")
        val exit_code = 1
        val inferred_failed = if exit_code == 0 then 0 else 1
        expect(inferred_failed).to_equal(1)  # oracle: rc!=0 with no parseable summary counts as one failed file

    it "tracks skipped count separately":
        # @req REQ-TOOL-RUNNER-003
        # @capture(statistics): skipped count retained
        step("carry the skipped count outside the pass/fail totals")
        val skipped = 1 + 2
        expect(skipped).to_equal(3)  # oracle: skipped examples never fold into passed or failed


