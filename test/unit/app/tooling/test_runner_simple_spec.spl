"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/app/tooling/test_runner_simple_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# # Simple Test Runner (SPL) Specification
#
# **Feature IDs:** #920-930
# **Category:** Tooling
# **Difficulty:** 3/5
# **Status:** In Progress
#
# ## Overview
#
# The Simple test runner is a reimplementation of the Rust test runner in Simple
# language. It supports interpreter, SMF, and native execution modes with
# per-test timeout via `rt_process_run_timeout` FFI. A recursion guard
# (`SIMPLE_TEST_RUNNER_RUST=1`) prevents infinite dispatch loops when the
# Simple runner spawns child `simple_old` processes.
#
# ## Key Concepts
#
# | Concept | Description |
# |---------|-------------|
# | Recursion guard | `SIMPLE_TEST_RUNNER_RUST=1` env var forces child to use Rust runner |
# | Subprocess execution | Each test file runs as a child process via `rt_process_run_timeout` |
# | Timeout | `rt_process_run_timeout(cmd, args, timeout_ms)` returns exit_code=-1 on timeout |
# | Mode dispatch | interpreter (default), smf (compile+run .smf), native (compile+run binary) |
# | Seed shuffle | Deterministic test ordering via `--seed N` |
# | ANSI stripping | Strips color codes before output parsing |
# | Test DB | Writes run records to `doc/test/test_db.sdn` |
# | Skip features | Lists unimplemented features from .skip files |

use std.spec.*
use std.test_runner.test_runner_args.{parse_test_args}
use std.test_runner.test_runner_types.{TestFileResult}
use app.test_runner_new.test_runner_main.{generate_spipe_docs_for_results}

fn strip_test_suffix(stem: text) -> text:
    if stem.ends_with("_spec"):
        return stem[0:stem.len() - 5]
    if stem.ends_with("_test"):
        return stem[0:stem.len() - 5]
    stem

fn artifact_dir_for_test(path: text) -> text:
    var relative = path
    if relative.starts_with("simple/std_lib/test/"):
        relative = relative[20:]
    elif relative.starts_with("test/"):
        relative = relative[5:]

    if relative.ends_with(".spl"):
        relative = relative[0:relative.len() - 4]

    val parts = relative.split("/")
    var mapped = []
    var i = 0
    while i < parts.len():
        if i == parts.len() - 1:
            mapped.push(strip_test_suffix(parts[i]))
        else:
            mapped.push(parts[i])
        i = i + 1
    "build/test-artifacts/{mapped.join(\"/\")}"

fn slugify(value: text) -> text:
    var result = ""
    var last_dash = false
    var i = 0
    while i < value.len():
        val ch = value[i]
        val lower = ch.lower()
        val is_alpha = lower >= "a" and lower <= "z"
        val is_digit = ch >= "0" and ch <= "9"
        if is_alpha or is_digit:
            result = result + lower
            last_dash = false
        elif not last_dash:
            result = result + "-"
            last_dash = true
        i = i + 1

    while result.starts_with("-"):
        result = result[1:]
    while result.ends_with("-"):
        result = result[0:result.len() - 1]
    result

fn scenario_dir_for_test(path: text, index: int, group: text, name: text) -> text:
    val base = artifact_dir_for_test(path)
    val joined = if group == "" then name else "{group} {name}"
    val slug = slugify(joined)
    val ordinal = if index < 10 then "00{index}" else if index < 100 then "0{index}" else "{index}"
    "{base}/scenarios/{ordinal}-{slug}"

fn canonical_artifact_files() -> [text]:
    ["summary.txt", "result.json", "run.log", "stdout.log", "stderr.log", "combined.log"]

fn compatibility_artifact_files() -> [text]:
    ["output.log"]



