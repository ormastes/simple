"""
## Purpose and audience

# Traceability Checker Specification

**Feature IDs:** #TRC-001
**Category:** Tooling
**Status:** Draft
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A

This specification is maintained for compiler and library engineers reviewing UNIT-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/app/tooling/traceability_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use app.traceability.core.{
    count_traceability_manifest_default_warnings_by_code, count_traceability_manifest_single_root_warnings_by_code,
    normalize_slug, map_source_to_unit_candidates, map_source_dir_to_integration_candidates,
    extract_relative_paths, extract_trace_ids
}

use std.spec.{step}
describe "traceability helpers":
    it "normalizes date suffixed slugs":
        # @req: REQ-UNIT-APP-001
        step("Verify: normalizes date suffixed slugs")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(normalize_slug("security_aop_architecture_2026-03-28")).to_equal("security_aop_architecture")

    it "extracts relative paths from markdown and plain text":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-APP-002
        step("Verify: extracts relative paths from markdown and plain text")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val content = """
**Requirements:** [Req](doc/02_requirements/feature/security_aop.md)
Related test: doc/06_spec/security_aop_spec.md
"""
        val paths = extract_relative_paths(content)
        expect(paths).to_contain("doc/02_requirements/feature/security_aop.md")
        expect(paths).to_contain("doc/06_spec/security_aop_spec.md")

    it "extracts REQ and NFR identifiers":
        # @req: REQ-UNIT-APP-003
        step("Verify: extracts REQ and NFR identifiers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val ids = extract_trace_ids("REQ-SEC-001 NFR-PERF-001")
        expect(ids).to_contain("REQ-SEC-001")
        expect(ids).to_contain("NFR-PERF-001")

describe "source test mapping":
    it "maps compiler sources to unit candidates":
        # @req: REQ-UNIT-APP-004
        step("Verify: maps compiler sources to unit candidates")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val candidates = map_source_to_unit_candidates("src/compiler/85.mdsoc/layer_checker.spl")
        expect(candidates).to_contain("test/unit/compiler/mdsoc/layer_checker_spec.spl")

    it "maps lib sources to unit candidates":
        # @req: REQ-UNIT-APP-005
        step("Verify: maps lib sources to unit candidates")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val candidates = map_source_to_unit_candidates("src/lib/common/security/sanitize.spl")
        expect(candidates).to_contain("test/unit/lib/security/sanitize_spec.spl")

    it "maps source directories to integration candidates":
        # @req: REQ-UNIT-APP-006
        step("Verify: maps source directories to integration candidates")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val candidates = map_source_dir_to_integration_candidates("src/compiler/85.mdsoc")
        expect(candidates).to_contain("test/integration/compiler/mdsoc/module_spec.spl")

describe "traceability analysis":
    it "warns when a requirement identifier is not covered":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-APP-007
        step("Verify: warns when a requirement identifier is not covered")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val manifest = """
@@ doc/02_requirements/feature/security_aop.md
# Security AOP

REQ-SEC-001:
The system shall ...
REQ-SEC-002:
The system shall ...
@@ doc/03_plan/security_aop.md
# Plan

**Requirements:** doc/02_requirements/feature/security_aop.md
@@ doc/05_design/security_aop.md
# Design

**Requirements:** doc/02_requirements/feature/security_aop.md
@@ doc/01_research/security_aop.md
# Research

**Requirements:** doc/02_requirements/feature/security_aop.md
@@ test/system/security_aop_spec.spl
**Requirements:** doc/02_requirements/feature/security_aop.md
**Plan:** doc/03_plan/security_aop.md
**Design:** doc/05_design/security_aop.md
**Research:** doc/01_research/security_aop.md

# @req REQ-SEC-001
"""
        expect(count_traceability_manifest_default_warnings_by_code(manifest, "all", "TRC401")).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "warns on legacy requirement roots in specs":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-APP-008
        step("Verify: warns on legacy requirement roots in specs")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val manifest = """
@@ doc/02_requirements/feature/foo.md
# Foo
REQ-FOO-001:
@@ doc/03_plan/foo.md
# Foo Plan
@@ doc/05_design/foo.md
# Foo Design
@@ doc/01_research/foo.md
# Foo Research
@@ test/feature/foo_spec.spl
**Requirements:** doc/requirement/foo.md
**Plan:** doc/03_plan/foo.md
**Design:** doc/05_design/foo.md
**Research:** doc/01_research/foo.md

# @req REQ-FOO-001
"""
        expect(count_traceability_manifest_default_warnings_by_code(manifest, "spec", "TRC211")).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "warns when docs point to raw specs":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-APP-009
        step("Verify: warns when docs point to raw specs")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val manifest = """
@@ doc/02_requirements/feature/foo.md
# Foo
REQ-FOO-001:
@@ doc/01_research/foo.md
# Research

**Requirements:** doc/02_requirements/feature/foo.md
See test/foo_spec.spl for details.
"""
        expect(count_traceability_manifest_default_warnings_by_code(manifest, "doc", "TRC205")).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "warns when executable specs lack mirrored generated docs":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-APP-010
        step("Verify: warns when executable specs lack mirrored generated docs")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val manifest = """
@@ test/feature/usage/math_blocks_spec.spl
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A

describe "Math blocks":
    it "evaluates addition":
        # @req: REQ-UNIT-APP-011
        step("Verify: evaluates addition")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(1 + 1).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
"""
        expect(count_traceability_manifest_default_warnings_by_code(manifest, "spec", "TRC231")).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "accepts generated docs that mirror executable spec paths":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-APP-012
        step("Verify: accepts generated docs that mirror executable spec paths")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val manifest = """
@@ test/feature/usage/math_blocks_spec.spl
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A

describe "Math blocks":
    it "evaluates addition":
        # @req: REQ-UNIT-APP-013
        step("Verify: evaluates addition")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(1 + 1).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
@@ doc/06_spec/feature/usage/math_blocks_spec.md
# Math Blocks
"""
        expect(count_traceability_manifest_default_warnings_by_code(manifest, "spec", "TRC231")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "warns when generated docs use a flat legacy path":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-APP-014
        step("Verify: warns when generated docs use a flat legacy path")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val manifest = """
@@ test/feature/usage/math_blocks_spec.spl
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A

describe "Math blocks":
    it "evaluates addition":
        # @req: REQ-UNIT-APP-015
        step("Verify: evaluates addition")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(1 + 1).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
@@ doc/06_spec/math_blocks_spec.md
# Math Blocks
"""
        expect(count_traceability_manifest_default_warnings_by_code(manifest, "spec", "TRC232")).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "warns for opted-in source roots without unit tests":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-APP-016
        step("Verify: warns for opted-in source roots without unit tests")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val manifest = """
@@ src/compiler/85.mdsoc/__init__.spl
export foo
@@ src/compiler/85.mdsoc/layer_checker.spl
fn check():
    1
"""
        expect(count_traceability_manifest_single_root_warnings_by_code(manifest, "src", "src/compiler/85.mdsoc", "TRC101")).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(count_traceability_manifest_single_root_warnings_by_code(manifest, "src", "src/compiler/85.mdsoc", "TRC111")).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
