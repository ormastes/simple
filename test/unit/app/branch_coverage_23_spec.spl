# @req: REQ-APP-APP-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/app/branch_coverage_23_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/branch_coverage_23.md
# doc-path: doc/03_plan/sys_test/branch_coverage_23.md
# doc-path: doc/04_architecture/branch_coverage_23.md
# doc-path: doc/05_design/branch_coverage_23.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "nested conditionals evaluate inner guard independently":
        step("Verify: nested conditionals evaluate inner guard independently")
        # @req: REQ-APP-APP-001
        var r = 0
        if true:
            if false:
                r = 1
            else:
                r = 2
        expect(r).to_equal(2)  # oracle: outer true, inner false

    it "match dispatches on the first equal pattern":
        step("Verify: match dispatches on the first equal pattern")
        # @req: REQ-APP-APP-001
        val k = 2
        var r = 0
        match k:
            1: r = 10
            2: r = 20
            3: r = 30
            _: r = -1
        expect(r).to_equal(20)  # oracle: literal pattern 2

    it "if-then arm executes on true condition":
        step("Verify: if-then arm executes on true condition")
        # @req: REQ-APP-APP-001
        var r = 0
        if 10 > 5:
            r = 1
        expect(r).to_equal(1)  # oracle: then arm taken

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "if-else arm executes on false condition":
        step("Verify: if-else arm executes on false condition")
        # @req: REQ-APP-APP-001
        var r = 0
        if 2 > 5:
            r = 1
        else:
            r = 2
        expect(r).to_equal(2)  # oracle: else arm taken

    it "elif first arm wins when its guard holds":
        step("Verify: elif first arm wins when its guard holds")
        # @req: REQ-APP-APP-001
        var r = 0
        if 7 > 10:
            r = 1
        elif 7 > 5:
            r = 2
        else:
            r = 3
        expect(r).to_equal(2)  # oracle: first true elif

    it "while loop with false guard never runs":
        step("Verify: while loop with false guard never runs")
        # @req: REQ-APP-APP-001
        var i = 7
        while i < 0:
            i = i + 1
        expect(i).to_equal(7)  # oracle: body skipped
