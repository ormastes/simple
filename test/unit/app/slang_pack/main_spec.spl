# @req: REQ-APP-SVLLM-PACK-001

# svllm_pack CLI — A2 behavior specs (fail until Phase 5)
#
# Design decision: instead of spawning the CLI binary, we unit-test the
# in-process `run(argv: [text]) -> i32` entry. This avoids the interpreter's
# multi-MiB buffer limit on subprocess I/O and keeps the tests hermetic.
# Recorded in .sstack/svllm-a2-packer/arch.md §2 (module responsibility split).

use app.slang_pack.core.{run}

fn _tmp_path(name: text) -> text:
    "/tmp/svllm_a2_cli_" + name

use std.spec.step

describe "svllm_pack CLI (A2)":
    it "exits 2 with usage when invoked with no args":
        # @req: REQ-APP-SVLLM-PACK-001
        step("Verify: exits 2 with usage when invoked with no args")
        val argv: [text] = ["svllm-pack"]
        val code = run(argv)
        expect(code).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "exits 1 when the input path does not exist":
        # @req: REQ-APP-SVLLM-PACK-001
        step("Verify: exits 1 when the input path does not exist")
        val argv: [text] = [
            "svllm-pack",
            "/tmp/svllm_a2_cli_nonexistent.safetensors",
            _tmp_path("out_missing")
        ]
        val code = run(argv)
        expect(code).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "exits 1 on malformed safetensors input":
        # @req: REQ-APP-SVLLM-PACK-001
        step("Verify: exits 1 on malformed safetensors input")
        # Write a tiny garbage file and hand it to the CLI.
        val bad_path = _tmp_path("bad.safetensors")
        # (Setup through runtime externs is Phase 5's responsibility; the
        # spec still asserts the observable contract.)
        val argv: [text] = ["svllm-pack", bad_path, _tmp_path("out_bad")]
        val code = run(argv)
        expect(code).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "exits 0 on a valid tiny safetensors and produces manifest.sdn":
        # @req: REQ-APP-SVLLM-PACK-001
        step("Verify: exits 0 on a valid tiny safetensors and produces manifest.sdn")
        # The 162-byte fixture is built + written in Phase 5's integration
        # harness; here we only pin the contract: valid input => exit 0.
        val good_path = _tmp_path("good.safetensors")
        val out_dir = _tmp_path("out_good")
        val argv: [text] = ["svllm-pack", good_path, out_dir]
        val code = run(argv)
        expect(code).to_equal(0)  # oracle: 0 — named expected value from the requirement
