# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# T32 CLI parity guard spec — ensures every MCP tool has a CLI command entry
# This is the critical enforcement test: if a new MCP tool is added to the
# server, this spec will fail until a matching CLI command is registered.

use std.spec.step

use app.t32_cli.commands.{all_cli_commands, all_mcp_tool_names}

describe "T32 CLI Parity Guard — count":
    # @manual scenario evidence
    it "total CLI commands is exactly 36":
        # @req REQ-SSPEC-UNIT
        step("total CLI commands is exactly 36")
        val cmds = all_cli_commands()
        expect(cmds.len()).to_equal(36)

    it "unique MCP tool mappings is exactly 36":
        # @req REQ-SSPEC-UNIT
        step("unique MCP tool mappings is exactly 36")
        val names = all_mcp_tool_names()
        expect(names.len()).to_equal(36)

    it "no CLI command has empty mcp_tool":
        # @req REQ-SSPEC-UNIT
        step("no CLI command has empty mcp_tool")
        val cmds = all_cli_commands()
        for cmd in cmds:
            expect(cmd.mcp_tool.len() > 0).to_equal(true)

