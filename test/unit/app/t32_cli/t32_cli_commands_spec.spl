"""
## Purpose and audience
Purpose: Prove that T32 CLI Commands — all_cli_commands.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-T32-CLI-001 — stable requirement identity for this spec.
# T32 CLI command registry spec — tests all_cli_commands, find, top-level, subcmds, shell verbs

use app.t32_cli.commands.{all_cli_commands, all_mcp_tool_names, find_cli_command, all_top_level_names, subcmds_for, all_shell_verbs}
use std.spec.step


describe "T32 CLI Commands — all_cli_commands":
    it "returns exactly 36 entries":
        step("Verify: returns exactly 36 entries")
        # @req: REQ-APP-T32-CLI-001
        val cmds = all_cli_commands()
        expect(cmds.len()).to_equal(36)  # oracle: 36 — named expected value from the requirement

    it "every command has non-empty name":
        step("Verify: every command has non-empty name")
        val cmds = all_cli_commands()
        for cmd in cmds:
            expect(cmd.name.len() > 0).to_equal(true)

    it "every command has non-empty mcp_tool":
        step("Verify: every command has non-empty mcp_tool")
        val cmds = all_cli_commands()
        for cmd in cmds:
            expect(cmd.mcp_tool.len() > 0).to_equal(true)

    it "every command has non-empty usage text":
        step("Verify: every command has non-empty usage text")
        val cmds = all_cli_commands()
        for cmd in cmds:
            expect(cmd.usage.len() > 0).to_equal(true)

describe "T32 CLI Commands — all_mcp_tool_names":
    it "returns 36 unique names":
        step("Verify: returns 36 unique names")
        val names = all_mcp_tool_names()
        expect(names.len()).to_equal(36)  # oracle: 36 — named expected value from the requirement

    it "contains t32_cmd_run":
        step("Verify: contains t32_cmd_run")
        val names = all_mcp_tool_names()
        expect(names).to_contain("t32_cmd_run")

    it "contains t32_sessions_list":
        step("Verify: contains t32_sessions_list")
        val names = all_mcp_tool_names()
        expect(names).to_contain("t32_sessions_list")

describe "T32 CLI Commands — find_cli_command":
    it "finds cmd/run":
        step("Verify: finds cmd/run")
        val result = find_cli_command("cmd", "run")
        var tool = ""
        if val cmd = result:
            tool = cmd.mcp_tool
        expect(tool).to_equal("t32_cmd_run")

    it "finds sessions/open":
        step("Verify: finds sessions/open")
        val result = find_cli_command("sessions", "open")
        var tool = ""
        if val cmd = result:
            tool = cmd.mcp_tool
        expect(tool).to_equal("t32_session_open")

    it "finds sessions with no subcmd":
        step("Verify: finds sessions with no subcmd")
        val result = find_cli_command("sessions", "")
        var tool = ""
        if val cmd = result:
            tool = cmd.mcp_tool
        expect(tool).to_equal("t32_sessions_list")

    it "finds eval with no subcmd":
        step("Verify: finds eval with no subcmd")
        val result = find_cli_command("eval", "")
        var tool = ""
        if val cmd = result:
            tool = cmd.mcp_tool
        expect(tool).to_equal("t32_eval")

    it "finds jobs/list":
        step("Verify: finds jobs/list")
        val result = find_cli_command("jobs", "list")
        var tool = ""
        if val cmd = result:
            tool = cmd.mcp_tool
        expect(tool).to_equal("t32_job_list")

    it "finds dialog/parse":
        step("Verify: finds dialog/parse")
        val result = find_cli_command("dialog", "parse")
        var tool = ""
        if val cmd = result:
            tool = cmd.mcp_tool
        expect(tool).to_equal("t32_dialog_parse")

    it "returns nil for unknown command":
        step("Verify: returns nil for unknown command")
        val result = find_cli_command("nonexistent", "")
        var found = false
        if val cmd = result:
            found = true
        expect(found).to_equal(false)

    it "falls back to top-level for unknown subcmd":
        step("Verify: falls back to top-level for unknown subcmd")
        val result = find_cli_command("sessions", "nonexistent")
        var tool = ""
        if val cmd = result:
            tool = cmd.mcp_tool
        expect(tool).to_equal("t32_sessions_list")

