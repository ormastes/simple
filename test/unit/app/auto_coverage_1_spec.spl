# @req: REQ-APP-LANGSEM-001 — core Simple language semantics observable from any program.
"""
## Purpose and audience

Purpose: prove baseline Simple language semantics (arithmetic, strings,
arrays, control flow) through executed assertions, as a compiler regression
tripwire.
Audience: compiler engineers and CI gate maintainers.

## Operator workflow

1. Run `bin/simple test test/01_unit/app/auto_coverage_1_spec.spl`.
2. All scenarios must pass; any failure indicates a language-semantics
   regression in the compiler or runtime.

## Compatibility and limitations

Covers i64 arithmetic and interpreter lane; native-only Dict gaps are out of
scope (see doc/07_guide/language/dict_native_pitfalls.md).
"""

use std.spec

# doc-path: doc/01_research/local/auto_coverage_1.md
# doc-path: doc/03_plan/sys_test/auto_coverage_1.md
# doc-path: doc/04_architecture/auto_coverage_1.md
# doc-path: doc/05_design/auto_coverage_1.md

describe "Core language semantics":
    """
    Executed oracles over operators, strings, arrays and control flow that
    every codegen lane must preserve.
    """

    it "arithmetic precedence follows standard binding":
        step("Verify: arithmetic precedence")
        # @req: REQ-APP-LANGSEM-001
        expect(2 + 3 * 4).to_equal(14)  # oracle: 2+3*4 with * binding tighter than +
        expect(10 - 2 * 3).to_equal(4)  # oracle: multiplication precedes subtraction
        expect((2 + 3) * 4).to_equal(20)  # oracle: parentheses force additive grouping

    it "truncating division and signed remainder":
        step("Verify: division and remainder")
        # @req: REQ-APP-LANGSEM-001
        expect(7 / 2).to_equal(3)  # oracle: i64 division truncates toward zero
        expect(7 % 2).to_equal(1)  # oracle: remainder of positive dividend is positive
        expect(-7 % 2).to_equal(-1)  # oracle: remainder keeps dividend sign

    it "string length and indexing":
        step("Verify: string basics")
        # @req: REQ-APP-LANGSEM-001
        expect("hello world".len()).to_equal(11)  # oracle: 11 ASCII characters
        expect("abc".slice(0, 2)).to_equal("ab")  # oracle: half-open slice of first two chars

    it "array construction and access":
        step("Verify: array semantics")
        # @req: REQ-APP-LANGSEM-001
        expect([1, 2, 3].len()).to_equal(3)  # oracle: three-element literal
        expect([10, 20, 30][1]).to_equal(20)  # oracle: zero-based indexing

    it "for-range iterates the half-open span":
        step("Verify: for-range loop")
        # @req: REQ-APP-LANGSEM-001
        var seen = 0
        for i in 0..4:
            seen = seen + 1
        expect(seen).to_equal(4)  # oracle: 0..4 yields four iterations (half-open upper bound)

    it "match selects exactly one arm":
        step("Verify: match dispatch")
        # @req: REQ-APP-LANGSEM-001
        val opt = Some(99)
        var chosen = 0
        match opt:
            Some(x): chosen = x
            nil: chosen = -1
        expect(chosen).to_equal(99)  # oracle: Some arm binds payload 99
