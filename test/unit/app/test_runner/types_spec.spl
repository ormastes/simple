describe "TestFileResult":
    it "creates a result with all fields":
        # @req: REQ-UNIT-APP-017
        step("Verify: creates a result with all fields")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val r = TestFileResult(
            path: "test/example_spec.spl",
            passed: 10,
            failed: 0,
            skipped: 2,
            pending: 1,
            duration_ms: 500,
            error: "",
            timed_out: false
        )
        expect(r.path).to_equal("test/example_spec.spl")
        expect(r.passed).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec
        expect(r.failed).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(r.skipped).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(r.pending).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(r.duration_ms).to_equal(500)  # oracle: expected value 500 is the behavior asserted by this regression spec
        expect(r.error).to_equal("")
        expect(r.timed_out).to_equal(false)

    it "is_ok returns true when no failures and no error and not timed out":
        # @req: REQ-UNIT-APP-018
        step("Verify: is_ok returns true when no failures and no error and not timed out")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val r = TestFileResult(
            path: "passing.spl",
            passed: 5,
            failed: 0,
            skipped: 0,
            pending: 0,
            duration_ms: 100,
            error: "",
            timed_out: false
        )
        expect(file_result_is_ok(r)).to_equal(true)

    it "is_ok returns false when there are failures":
        # @req: REQ-UNIT-APP-019
        step("Verify: is_ok returns false when there are failures")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val r = TestFileResult(
            path: "failing.spl",
            passed: 3,
            failed: 2,
            skipped: 0,
            pending: 0,
            duration_ms: 200,
            error: "",
            timed_out: false
        )
        expect(file_result_is_ok(r)).to_equal(false)

    it "is_ok returns false when there is an error message":
        # @req: REQ-UNIT-APP-020
        step("Verify: is_ok returns false when there is an error message")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val r = TestFileResult(
            path: "error.spl",
            passed: 0,
            failed: 0,
            skipped: 0,
            pending: 0,
            duration_ms: 50,
            error: "parse error on line 5",
            timed_out: false
        )
        expect(file_result_is_ok(r)).to_equal(false)

    it "is_ok returns false when timed out":
        # @req: REQ-UNIT-APP-021
        step("Verify: is_ok returns false when timed out")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val r = TestFileResult(
            path: "slow.spl",
            passed: 0,
            failed: 0,
            skipped: 0,
            pending: 0,
            duration_ms: 120000,
            error: "",
            timed_out: true
        )
        expect(file_result_is_ok(r)).to_equal(false)

    it "is_ok returns false when both failed and error":
        # @req: REQ-UNIT-APP-022
        step("Verify: is_ok returns false when both failed and error")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val r = TestFileResult(
            path: "bad.spl",
            passed: 1,
            failed: 1,
            skipped: 0,
            pending: 0,
            duration_ms: 300,
            error: "runtime error",
            timed_out: false
        )
        expect(file_result_is_ok(r)).to_equal(false)

    it "is_ok returns false when all bad conditions":
        # @req: REQ-UNIT-APP-023
        step("Verify: is_ok returns false when all bad conditions")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val r = TestFileResult(
            path: "worst.spl",
            passed: 0,
            failed: 5,
            skipped: 0,
            pending: 0,
            duration_ms: 120000,
            error: "crash",
            timed_out: true
        )
        expect(file_result_is_ok(r)).to_equal(false)

    it "handles zero counts":
        # @req: REQ-UNIT-APP-024
        step("Verify: handles zero counts")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val r = TestFileResult(
            path: "empty.spl",
            passed: 0,
            failed: 0,
            skipped: 0,
            pending: 0,
            duration_ms: 0,
            error: "",
            timed_out: false
        )
        expect(file_result_is_ok(r)).to_equal(true)
        expect(r.passed).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "stores skipped count separately from failures":
        # @req: REQ-UNIT-APP-025
        step("Verify: stores skipped count separately from failures")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val r = TestFileResult(
            path: "skipped.spl",
            passed: 0,
            failed: 0,
            skipped: 10,
            pending: 5,
            duration_ms: 10,
            error: "",
            timed_out: false
        )
        expect(file_result_is_ok(r)).to_equal(true)
        expect(r.skipped).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec
        expect(r.pending).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

describe "TestRunResult":
    it "creates a result with aggregate counts":
        # @req: REQ-UNIT-APP-026
        step("Verify: creates a result with aggregate counts")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val r = TestRunResult(
            total_passed: 100,
            total_failed: 0,
            total_skipped: 5,
            total_pending: 3,
            total_timed_out: 0,
            total_duration_ms: 5000
        )
        expect(r.total_passed).to_equal(100)  # oracle: expected value 100 is the behavior asserted by this regression spec
        expect(r.total_failed).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(r.total_skipped).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec
        expect(r.total_pending).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
        expect(r.total_timed_out).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(r.total_duration_ms).to_equal(5000)  # oracle: expected value 5000 is the behavior asserted by this regression spec

    it "is_ok returns true when no failures and no timeouts":
        # @req: REQ-UNIT-APP-027
        step("Verify: is_ok returns true when no failures and no timeouts")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val r = TestRunResult(
            total_passed: 50,
            total_failed: 0,
            total_skipped: 2,
            total_pending: 1,
            total_timed_out: 0,
            total_duration_ms: 3000
        )
        expect(run_result_is_ok(r)).to_equal(true)

    it "is_ok returns false when there are failures":
        # @req: REQ-UNIT-APP-028
        step("Verify: is_ok returns false when there are failures")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val r = TestRunResult(
            total_passed: 48,
            total_failed: 2,
            total_skipped: 0,
            total_pending: 0,
            total_timed_out: 0,
            total_duration_ms: 3000
        )
        expect(run_result_is_ok(r)).to_equal(false)

    it "is_ok returns false when there are timeouts":
        # @req: REQ-UNIT-APP-029
        step("Verify: is_ok returns false when there are timeouts")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val r = TestRunResult(
            total_passed: 49,
            total_failed: 0,
            total_skipped: 0,
            total_pending: 0,
            total_timed_out: 1,
            total_duration_ms: 125000
        )
        expect(run_result_is_ok(r)).to_equal(false)

    it "is_ok returns false when both failures and timeouts":
        # @req: REQ-UNIT-APP-030
        step("Verify: is_ok returns false when both failures and timeouts")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val r = TestRunResult(
            total_passed: 40,
            total_failed: 5,
            total_skipped: 0,
            total_pending: 0,
            total_timed_out: 3,
            total_duration_ms: 360000
        )
        expect(run_result_is_ok(r)).to_equal(false)

    it "handles all zeros":
        # @req: REQ-UNIT-APP-031
        step("Verify: handles all zeros")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val r = TestRunResult(
            total_passed: 0,
            total_failed: 0,
            total_skipped: 0,
            total_pending: 0,
            total_timed_out: 0,
            total_duration_ms: 0
        )
        expect(run_result_is_ok(r)).to_equal(true)

describe "SkipFeatureInfo":
    it "creates with all fields":
        # @req: REQ-UNIT-APP-032
        step("Verify: creates with all fields")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val info = SkipFeatureInfo(
            file_path: "test/feature/language/pattern_matching_spec.spl",
            title: "Pattern Matching Exhaustiveness",
            feature_ids: "PM-001,PM-002",
            category: "pattern_matching",
            status: "planned"
        )
        expect(info.file_path).to_equal("test/feature/language/pattern_matching_spec.spl")
        expect(info.title).to_equal("Pattern Matching Exhaustiveness")
        expect(info.feature_ids).to_equal("PM-001,PM-002")
        expect(info.category).to_equal("pattern_matching")
        expect(info.status).to_equal("planned")

    it "handles empty fields":
        # @req: REQ-UNIT-APP-033
        step("Verify: handles empty fields")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val info = SkipFeatureInfo(
            file_path: "",
            title: "",
            feature_ids: "",
            category: "",
            status: ""
        )
        expect(info.file_path).to_equal("")
        expect(info.title).to_equal("")

    it "handles various status values":
        # @req: REQ-UNIT-APP-034
        step("Verify: handles various status values")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val planned = SkipFeatureInfo(
            file_path: "a.spl",
            title: "Feature A",
            feature_ids: "F-001",
            category: "core",
            status: "planned"
        )
        expect(planned.status).to_equal("planned")

        val in_progress = SkipFeatureInfo(
            file_path: "b.spl",
            title: "Feature B",
            feature_ids: "F-002",
            category: "core",
            status: "in_progress"
        )
        expect(in_progress.status).to_equal("in_progress")

        val blocked = SkipFeatureInfo(
            file_path: "c.spl",
            title: "Feature C",
            feature_ids: "F-003",
            category: "core",
            status: "blocked"
        )
        expect(blocked.status).to_equal("blocked")
