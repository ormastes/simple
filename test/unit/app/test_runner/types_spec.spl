"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/app/test_runner/types_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Test Runner Types Specification
#
# Tests for the test runner type definitions:
# - TestExecutionMode enum
# - TestLevel enum
# - OutputFormat enum
# - TestOptions struct
# - TestFileResult struct (with is_ok method)
# - TestRunResult struct (with is_ok method)
# - SkipFeatureInfo struct

# =========================================================================
# TestExecutionMode enum
# =========================================================================

enum TestExecutionMode:
    Interpreter
    Smf
    Native

# =========================================================================
# TestLevel enum
# =========================================================================

enum TestLevel:
    All
    Unit
    Integration
    System

# =========================================================================
# OutputFormat enum
# =========================================================================

enum OutputFormat:
    Text
    Doc

# =========================================================================
# TestFileResult struct
# =========================================================================

struct TestFileResult:
    path: text
    passed: i64
    failed: i64
    skipped: i64
    pending: i64
    duration_ms: i64
    error: text
    timed_out: bool

fn file_result_is_ok(r: TestFileResult) -> bool:
    r.failed == 0 and r.error == "" and not r.timed_out

# =========================================================================
# TestRunResult struct
# =========================================================================

struct TestRunResult:
    total_passed: i64
    total_failed: i64
    total_skipped: i64
    total_pending: i64
    total_timed_out: i64
    total_duration_ms: i64

fn run_result_is_ok(r: TestRunResult) -> bool:
    r.total_failed == 0 and r.total_timed_out == 0

# =========================================================================
# SkipFeatureInfo struct
# =========================================================================

struct SkipFeatureInfo:
    file_path: text
    title: text
    feature_ids: text
    category: text
    status: text

# =========================================================================
# Tests
# =========================================================================

describe "TestExecutionMode":
    it "creates Interpreter variant":
        # @req: REQ-UNIT-APP-001
        step("Verify: creates Interpreter variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mode = TestExecutionMode.Interpreter
        expect(mode).to_equal(TestExecutionMode.Interpreter)

    it "creates Smf variant":
        # @req: REQ-UNIT-APP-002
        step("Verify: creates Smf variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mode = TestExecutionMode.Smf
        expect(mode).to_equal(TestExecutionMode.Smf)

    it "creates Native variant":
        # @req: REQ-UNIT-APP-003
        step("Verify: creates Native variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mode = TestExecutionMode.Native
        expect(mode).to_equal(TestExecutionMode.Native)

    it "distinguishes Interpreter from Smf":
        # @req: REQ-UNIT-APP-004
        step("Verify: distinguishes Interpreter from Smf")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = TestExecutionMode.Interpreter
        val b = TestExecutionMode.Smf
        expect(a).to_not_equal(b)

    it "distinguishes Interpreter from Native":
        # @req: REQ-UNIT-APP-005
        step("Verify: distinguishes Interpreter from Native")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = TestExecutionMode.Interpreter
        val b = TestExecutionMode.Native
        expect(a).to_not_equal(b)

    it "distinguishes Smf from Native":
        # @req: REQ-UNIT-APP-006
        step("Verify: distinguishes Smf from Native")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = TestExecutionMode.Smf
        val b = TestExecutionMode.Native
        expect(a).to_not_equal(b)

    it "compares equal variants":
        # @req: REQ-UNIT-APP-007
        step("Verify: compares equal variants")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = TestExecutionMode.Native
        val b = TestExecutionMode.Native
        expect(a).to_equal(b)

