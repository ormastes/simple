        expect(declares_success_result_factory).to_equal(false)  # oracle: unimplemented today; true means the factory landed and this scenario must assert result.passed against the real type

    it "creates compile failure result":
        # @req REQ-INTEG-FRAMEWORK-014
        # @capture(protocol_json): drafted compile-failure factory vs the shipped runner surface
        step("Scan the shipped runner surface for the drafted IntegrationTestResult.compile_failure factory")
        # NOTE: absence tripwire — the drafted API is unimplemented; see docstring.
        val runner_surface = _framework_surface()
        val declares_compile_failure_factory = runner_surface.contains("IntegrationTestResult.compile_failure")
        expect(declares_compile_failure_factory).to_equal(false)  # oracle: unimplemented today; true means the factory landed and this scenario must assert passed and compile_success against the real type

    it "formats result with status":
        # @req REQ-INTEG-FRAMEWORK-015
        # @capture(bit_table): shipped PASS/FAIL status prefixes in the runner output formatter
        step("Require the shipped status formatter to render both PASS and FAIL prefixes")
        val formatter_source = _status_formatter_source()
        val formats_pass_status = formatter_source.contains("  PASS  ")
        val formats_fail_status = formatter_source.contains("  FAIL  ")
        val status_formatting_contract_holds = formats_pass_status and formats_fail_status
        expect(status_formatting_contract_holds).to_equal(true)  # oracle: test_runner_output.spl renders every result line with a "  PASS  " or "  FAIL  " prefix, which is the shipped status contract

    it "formats failed assertions":
        # @req REQ-INTEG-FRAMEWORK-016
        # @capture(bit_table): shipped FAIL line carrying the failed count
        step("Require the shipped formatter's FAIL line to carry the failed-test count")
        # NOTE: framework-level assertion messages are unimplemented; this pins the
        # shipped failure-formatting contract they must compose with.
        val formatter_source = _status_formatter_source()
        val formats_fail_status = formatter_source.contains("  FAIL  ")
        val reports_failed_count = formatter_source.contains("} failed")
        val failure_formatting_contract_holds = formats_fail_status and reports_failed_count
        expect(failure_formatting_contract_holds).to_equal(true)  # oracle: the FAIL branch prints "(... passed, {failed} failed", so a reader sees the failure count on every red line

