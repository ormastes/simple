        expect(suite_run_contract_declared).to_equal(false)  # oracle: unimplemented today; true means the suite landed and this scenario must assert run_all returns an IntegrationSuiteResult against the real type

# @manual_section: integration-suite-result
describe "IntegrationSuiteResult":
    it "counts passed tests":
        # @req REQ-INTEG-FRAMEWORK-027
        # @capture(statistics): shipped passed-count rendering in the runner output formatter
        step("Require the shipped formatter to report the passed-test count on result lines")
        val formatter_source = _status_formatter_source()
        val reports_passed_count = formatter_source.contains("} passed")
        expect(reports_passed_count).to_equal(true)  # oracle: both status branches print "{passed} passed", so the shipped summary surface already carries the passed count

    it "counts failed tests":
        # @req REQ-INTEG-FRAMEWORK-028
        # @capture(statistics): shipped failed-count rendering in the runner output formatter
        step("Require the shipped formatter to report the failed-test count on result lines")
        val formatter_source = _status_formatter_source()
        val reports_failed_count = formatter_source.contains("} failed")
        expect(reports_failed_count).to_equal(true)  # oracle: the FAIL branch prints "{failed} failed", so the shipped summary surface already carries the failed count

    it "formats summary":
        # @req REQ-INTEG-FRAMEWORK-029
        # @capture(bit_table): shipped summary lines pairing status prefixes with counts
        step("Require the shipped formatter to pair status prefixes with passed and failed counts")
        val formatter_source = _status_formatter_source()
        val formats_pass_status = formatter_source.contains("  PASS  ")
        val formats_fail_status = formatter_source.contains("  FAIL  ")
        val reports_both_counts = formatter_source.contains("} passed") and formatter_source.contains("} failed")
        val summary_contract_holds = formats_pass_status and formats_fail_status and reports_both_counts
        expect(summary_contract_holds).to_equal(true)  # oracle: a summary line pairs a status prefix with "(N passed, M failed", which is exactly the shipped formatter's rendering

