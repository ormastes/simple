# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Tests for LSP handler helper functions

use std.spec.step

use app.lsp.lsp_handlers.{lsp_handle_initialize}
use app.lsp.lsp_json.{extract_field, Q}

describe "LSP handler helpers":
    # @manual scenario evidence
    describe "lsp_handle_initialize":
        it "returns valid JSON-RPC response":
            # @req REQ-SSPEC-UNIT
            step("returns valid JSON-RPC response")
            val response = lsp_handle_initialize("1")
            expect(response).to_contain("jsonrpc")
            expect(response).to_contain("2.0")

        it "includes server info":
            # @req REQ-SSPEC-UNIT
            step("includes server info")
            val response = lsp_handle_initialize("1")
            expect(response).to_contain("simple-lsp")
            expect(response).to_contain("0.1.0")

        it "includes textDocumentSync capability":
            # @req REQ-SSPEC-UNIT
            step("includes textDocumentSync capability")
            val response = lsp_handle_initialize("1")
            expect(response).to_contain("textDocumentSync")

        it "includes hoverProvider":
            # @req REQ-SSPEC-UNIT
            step("includes hoverProvider")
            val response = lsp_handle_initialize("1")
            expect(response).to_contain("hoverProvider")

        it "includes definitionProvider":
            # @req REQ-SSPEC-UNIT
            step("includes definitionProvider")
            val response = lsp_handle_initialize("1")
            expect(response).to_contain("definitionProvider")

        it "includes documentSymbolProvider":
            # @req REQ-SSPEC-UNIT
            step("includes documentSymbolProvider")
            val response = lsp_handle_initialize("1")
            expect(response).to_contain("documentSymbolProvider")

        it "includes completionProvider with triggers":
            # @req REQ-SSPEC-UNIT
            step("includes completionProvider with triggers")
            val response = lsp_handle_initialize("1")
            expect(response).to_contain("completionProvider")
            expect(response).to_contain("triggerCharacters")

        it "includes save capability":
            # @req REQ-SSPEC-UNIT
            step("includes save capability")
            val response = lsp_handle_initialize("1")
            expect(response).to_contain("save")
