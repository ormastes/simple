"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/app/workspace_root_write_guard_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec.{describe, it, expect, step}
use std.io_runtime.{read_file, file_exists}

describe "Workspace root write guard implementation":
    it "ships the root guard script":
        # @req: REQ-UNIT-APP-001
        step("Verify: ships the root guard script")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(file_exists("scripts/check-workspace-root-guard.shs")).to_equal(true)

    it "supports audit fix lock unlock modes":
        # @req: REQ-UNIT-APP-002
        step("Verify: supports audit fix lock unlock modes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("scripts/check-workspace-root-guard.shs")
        expect(source.contains("audit|fix|lock|unlock")).to_equal(true)
        expect(source.contains("--apply")).to_equal(true)
        expect(source.contains("run_audit")).to_equal(true)
        expect(source.contains("run_fix")).to_equal(true)
        expect(source.contains("run_lock_preview")).to_equal(true)
        expect(source.contains("run_lock_apply")).to_equal(true)
        expect(source.contains("run_unlock_apply")).to_equal(true)
        expect(source.contains("load_builtin_allowed_root")).to_equal(true)
        expect(source.contains("FILE.md not found at repository root")).to_equal(false)

    it "does not delete by default":
        # @req: REQ-UNIT-APP-003
        step("Verify: does not delete by default")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("scripts/check-workspace-root-guard.shs")
        expect(source.contains("does not delete files")).to_equal(true)
        expect(source.contains("rm -rf \"$TMP_DIR\"")).to_equal(true)
        expect(source.contains("rm -rf \"$rel\"")).to_equal(false)

    it "documents Windows ACL locking":
        # @req: REQ-UNIT-APP-004
        step("Verify: documents Windows ACL locking")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("scripts/check-workspace-root-guard.shs")
        expect(source.contains("icacls")).to_equal(true)
        expect(source.contains("Administrator")).to_equal(true)
        expect(source.contains("protected_lock_dirs")).to_equal(true)
        expect(source.contains("MUTABLE_ROOT_DIRS")).to_equal(true)

    it "wires lint entrypoints to the staged audit helper":
        # @req: REQ-UNIT-APP-005
        step("Verify: wires lint entrypoints to the staged audit helper")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val lint = read_file("src/app/io/cli_lint_commands.spl")
        val lint_entry = read_file("src/app/cli/lint_entry.spl")
        expect(lint.contains("_cli_run_workspace_root_guard()")).to_equal(true)
        expect(lint_entry.contains("cli_run_lint")).to_equal(true)

    it "wires tracked CLI lint to staged audit":
        # @req: REQ-UNIT-APP-006
        step("Verify: wires tracked CLI lint to staged audit")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val ops = read_file("src/app/io/cli_ops.spl")
        val lint = read_file("src/app/io/cli_lint_commands.spl")
        val lint_entry = read_file("src/app/cli/lint_entry.spl")
        expect(ops.contains("_cli_run_workspace_root_guard")).to_equal(true)
        expect(ops.contains("check-workspace-root-guard.shs")).to_equal(true)
        expect(lint.contains("_cli_run_workspace_root_guard()")).to_equal(true)
        expect(lint_entry.contains("cli_run_lint")).to_equal(true)

    it "wires tracked repo hygiene to staged audit":
        # @req: REQ-UNIT-APP-007
        step("Verify: wires tracked repo hygiene to staged audit")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("scripts/check/check-repo-hygiene.shs")
        expect(source.contains("check-workspace-root-guard.shs audit --staged")).to_equal(true)
