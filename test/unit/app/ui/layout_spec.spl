# UI Layout Engine Specification
#
# Tests compute_layout() for VBox, HBox, Grid, Fixed, and Panel modes.
# Validates flex sizing, fixed sizing, border insets, and rect lookup.

use std.spec.*

use common.ui.layout.{compute_layout, find_rect, find_rect_index, layout_vbox, layout_hbox, layout_grid, layout_fixed, clamp_dim, get_flex, get_fixed_height}
use common.ui.builder.{column, row, panel, text_widget, statusbar, menubar, grid_layout, scroll, textarea, with_width, with_height, with_flex, with_visible, build_tree}
use common.ui.widget.{WidgetNode, WidgetRect, UITree}

# ============================================================================
# Layout: Single Widget
# ============================================================================

describe "compute_layout single widget":

    it "assigns full rect to a single text widget":
        val root = text_widget("t1", "Hello")
        val rects = compute_layout(root, 0, 0, 80, 24)
        val r = find_rect(rects, "t1")
        expect(r != nil).to_equal(true)
        if r != nil:
            expect(r.x).to_equal(0)
            expect(r.y).to_equal(0)
            expect(r.w).to_equal(80)
            expect(r.h).to_equal(24)

# ============================================================================
# Layout: VBox
# ============================================================================

describe "compute_layout vbox":

    it "splits height evenly between two equal children":
        val root = column("vbox1", [
            text_widget("v_a", "A"),
            text_widget("v_b", "B")
        ])
        val rects = compute_layout(root, 0, 0, 80, 24)
        # Panel border: inner area is x+1, y+1, w-2, h-2 => 1,1,78,22
        # Two flex children split 22 evenly => 11 each
        val ra = find_rect(rects, "v_a")
        val rb = find_rect(rects, "v_b")
        expect(ra != nil).to_equal(true)
        expect(rb != nil).to_equal(true)
        if ra != nil:
            expect(ra.h).to_equal(11)
            expect(ra.w).to_equal(78)
        if rb != nil:
            expect(rb.h).to_equal(11)
            expect(rb.y).to_equal(ra.y + 11)

    it "gives statusbar height 1 and remaining to flex child":
        val root = column("vbox2", [
            text_widget("v_content", "Content"),
            statusbar("v_status", "left", "right")
        ])
        val rects = compute_layout(root, 0, 0, 80, 24)
        # Inner area: 1,1,78,22. StatusBar fixed h=1, flex child gets 21
        val rc = find_rect(rects, "v_content")
        val rs = find_rect(rects, "v_status")
        expect(rc != nil).to_equal(true)
        expect(rs != nil).to_equal(true)
        if rc != nil:
            expect(rc.h).to_equal(21)
        if rs != nil:
            expect(rs.h).to_equal(1)

# ============================================================================
# Layout: HBox
# ============================================================================

describe "compute_layout hbox":

    it "splits width evenly between two equal children":
        val root = row("hbox1", [
            text_widget("h_a", "A"),
            text_widget("h_b", "B")
        ])
        val rects = compute_layout(root, 0, 0, 80, 24)
        # Inner area: 1,1,78,22. Two flex=1 children => 39 each
        val ra = find_rect(rects, "h_a")
        val rb = find_rect(rects, "h_b")
        expect(ra != nil).to_equal(true)
        expect(rb != nil).to_equal(true)
        if ra != nil:
            expect(ra.w).to_equal(39)
            expect(ra.h).to_equal(22)
        if rb != nil:
            expect(rb.w).to_equal(39)
            expect(rb.x).to_equal(ra.x + 39)

    it "gives fixed-width child exact width and flex child the remainder":
        val fixed_child = with_width(text_widget("h_fixed", "Fixed"), 20)
        val flex_child = text_widget("h_flex", "Flex")
        val root = row("hbox2", [fixed_child, flex_child])
        val rects = compute_layout(root, 0, 0, 80, 24)
        # Inner area: 1,1,78,22. fixed=20, flex gets 78-20=58
        val rf = find_rect(rects, "h_fixed")
        val rx = find_rect(rects, "h_flex")
        expect(rf != nil).to_equal(true)
        expect(rx != nil).to_equal(true)
        if rf != nil:
            expect(rf.w).to_equal(20)
        if rx != nil:
            expect(rx.w).to_equal(58)

# ============================================================================
# Layout: Panel Border
# ============================================================================

describe "compute_layout panel":

    it "reserves 1-char border for panel children":
        val child = text_widget("p_inner", "Inner")
        val root = panel("p_outer", "Title", [child])
        val rects = compute_layout(root, 0, 0, 40, 20)
        # Outer panel rect: 0,0,40,20 (kind=panel => border)
        # Inner area: 1,1,38,18
        # Child panel is also kind=panel with its own border
        # But text_widget is kind=text (no border) so it gets inner area directly
        val ri = find_rect(rects, "p_inner")
        expect(ri != nil).to_equal(true)
        if ri != nil:
            # panel -> inner 1,1,38,18 -> child gets full inner
            expect(ri.x).to_equal(1)
            expect(ri.y).to_equal(1)
            expect(ri.w).to_equal(38)
            expect(ri.h).to_equal(18)

# ============================================================================
# Layout: Grid
# ============================================================================

describe "compute_layout grid":

    it "arranges 4 children into a 2x2 grid":
        val root = grid_layout("grid1", [
            text_widget("g_a", "A"),
            text_widget("g_b", "B"),
            text_widget("g_c", "C"),
            text_widget("g_d", "D")
        ])
        val rects = compute_layout(root, 0, 0, 80, 24)
        # Inner area: 1,1,78,22. 4 children => cols=2, rows=2
        # cell_w = 78/2 = 39, cell_h = 22/2 = 11
        val ra = find_rect(rects, "g_a")
        val rb = find_rect(rects, "g_b")
        val rc = find_rect(rects, "g_c")
        val rd = find_rect(rects, "g_d")
        expect(ra != nil).to_equal(true)
        expect(rb != nil).to_equal(true)
        expect(rc != nil).to_equal(true)
        expect(rd != nil).to_equal(true)
        if ra != nil:
            expect(ra.x).to_equal(1)
            expect(ra.y).to_equal(1)
            expect(ra.w).to_equal(39)
            expect(ra.h).to_equal(11)
        if rb != nil:
            expect(rb.x).to_equal(40)
            expect(rb.y).to_equal(1)
        if rc != nil:
            expect(rc.x).to_equal(1)
            expect(rc.y).to_equal(12)
        if rd != nil:
            expect(rd.x).to_equal(40)
            expect(rd.y).to_equal(12)

# ============================================================================
# Layout: find_rect
# ============================================================================

describe "find_rect":

    it "locates a rect by id":
        val root = text_widget("find_me", "Find me")
        val rects = compute_layout(root, 5, 10, 60, 30)
        val r = find_rect(rects, "find_me")
        expect(r != nil).to_equal(true)
        if r != nil:
            expect(r.id).to_equal("find_me")
            expect(r.x).to_equal(5)
            expect(r.y).to_equal(10)

    it "returns nil for a missing id":
        val root = text_widget("exists", "Hello")
        val rects = compute_layout(root, 0, 0, 80, 24)
        val r = find_rect(rects, "does_not_exist")
        expect(r).to_be_nil()

# ============================================================================
# Layout: Visibility
# ============================================================================

describe "compute_layout visibility":

    it "does not lay out invisible children":
        val visible_child = text_widget("vis_child", "Visible")
        val invisible_child = with_visible(text_widget("invis_child", "Hidden"), false)
        val root = column("vis_root", [visible_child, invisible_child])
        val rects = compute_layout(root, 0, 0, 80, 24)
        # The invisible child should not appear in the child layout rects
        # (it is excluded by get_visible_children)
        # The visible child should get the full inner height
        val rv = find_rect(rects, "vis_child")
        expect(rv != nil).to_equal(true)
        if rv != nil:
            expect(rv.h).to_equal(22)

# ============================================================================
# Layout: MenuBar
# ============================================================================

describe "compute_layout menubar":

    it "gives menubar height 1 by default":
        val root = column("menu_root", [
            menubar("menu_bar", ["File", "Edit"]),
            text_widget("menu_body", "Body")
        ])
        val rects = compute_layout(root, 0, 0, 80, 24)
        # Inner area: 1,1,78,22. MenuBar fixed h=1, flex child gets 21
        val rm = find_rect(rects, "menu_bar")
        val rb = find_rect(rects, "menu_body")
        expect(rm != nil).to_equal(true)
        expect(rb != nil).to_equal(true)
        if rm != nil:
            expect(rm.h).to_equal(1)
        if rb != nil:
            expect(rb.h).to_equal(21)

# ============================================================================
# Layout: DPI scale (compute_layout scale_permille)
# ============================================================================

describe "compute_layout dpi scale":

    it "scales the root rect by a non-identity permille factor":
        val root = text_widget("s1", "Scaled")
        val rects = compute_layout(root, 10, 20, 40, 12, 2000)
        val r = find_rect(rects, "s1")
        expect(r != nil).to_equal(true)
        if r != nil:
            expect(r.x).to_equal(20)
            expect(r.y).to_equal(40)
            expect(r.w).to_equal(80)
            expect(r.h).to_equal(24)

    it "insets the panel border after scaling, not before":
        val root = column("s_panel", [text_widget("s_child", "C")])
        val rects = compute_layout(root, 0, 0, 40, 12, 2000)
        val rc = find_rect(rects, "s_child")
        expect(rc != nil).to_equal(true)
        if rc != nil:
            expect(rc.x).to_equal(1)
            expect(rc.w).to_equal(78)
            expect(rc.h).to_equal(22)

# ============================================================================
# Layout: early returns
# ============================================================================

describe "compute_layout early returns":

    it "returns only the root rect when the root itself is invisible":
        val root = with_visible(column("inv_root", [text_widget("inv_child", "X")]), false)
        val rects = compute_layout(root, 0, 0, 80, 24)
        expect(rects.len()).to_equal(1)
        expect(find_rect_index(rects, "inv_child")).to_equal(-1)

    it "stops when the panel border collapses the inner width":
        val root = column("tiny", [text_widget("tiny_child", "C")])
        val rects = compute_layout(root, 0, 0, 2, 24)
        expect(rects.len()).to_equal(1)

    it "stops when the panel border collapses the inner height":
        val root = column("tiny_h", [text_widget("tiny_h_child", "C")])
        val rects = compute_layout(root, 0, 0, 80, 2)
        expect(rects.len()).to_equal(1)

    it "returns only the root rect for a container with no children":
        val root = column("empty_root", [])
        val rects = compute_layout(root, 0, 0, 80, 24)
        expect(rects.len()).to_equal(1)

# ============================================================================
# Layout: scroll clipping
# ============================================================================

describe "compute_layout scroll":

    it "clips the child to max_height when the box is taller":
        val sc = scroll("sc_clip", 5, [text_widget("sc_clip_child", "C")])
        val rects = compute_layout(sc, 0, 0, 40, 20)
        val rc = find_rect(rects, "sc_clip_child")
        expect(rc != nil).to_equal(true)
        if rc != nil:
            expect(rc.h).to_equal(5)

    it "does not clip when max_height exceeds the box":
        val sc = scroll("sc_open", 50, [text_widget("sc_open_child", "C")])
        val rects = compute_layout(sc, 0, 0, 40, 20)
        val rc = find_rect(rects, "sc_open_child")
        expect(rc != nil).to_equal(true)
        if rc != nil:
            expect(rc.h).to_equal(20)

    it "treats max_height 0 as unclipped":
        val sc = scroll("sc_zero", 0, [text_widget("sc_zero_child", "C")])
        val rects = compute_layout(sc, 0, 0, 40, 20)
        val rc = find_rect(rects, "sc_zero_child")
        expect(rc != nil).to_equal(true)
        if rc != nil:
            expect(rc.h).to_equal(20)

    it "scales max_height into device units before clipping":
        val sc = scroll("sc_scaled", 5, [text_widget("sc_scaled_child", "C")])
        val rects = compute_layout(sc, 0, 0, 40, 20, 2000)
        val rc = find_rect(rects, "sc_scaled_child")
        expect(rc != nil).to_equal(true)
        if rc != nil:
            expect(rc.h).to_equal(10)

# ============================================================================
# Layout: vbox overflow and remainder
# ============================================================================

describe "layout_vbox sizing":

    it "gives flex children zero height when fixed children overflow":
        val root = column("ov", [
            with_height(text_widget("ov_a", "A"), 30),
            text_widget("ov_b", "B")
        ])
        val rects = compute_layout(root, 0, 0, 80, 10)
        expect(find_rect_index(rects, "ov_b")).to_equal(-1)

    it "awards the rounding remainder to the last flex child":
        val root = column("rem", [
            text_widget("rem_a", "A"),
            text_widget("rem_b", "B"),
            text_widget("rem_c", "C")
        ])
        val rects = compute_layout(root, 0, 0, 80, 12)
        val ra = find_rect(rects, "rem_a")
        val rb = find_rect(rects, "rem_b")
        val rc = find_rect(rects, "rem_c")
        if ra != nil:
            expect(ra.h).to_equal(3)
        if rb != nil:
            expect(rb.h).to_equal(3)
        if rc != nil:
            expect(rc.h).to_equal(4)

    it "uses the rows prop as the fixed height of a textarea":
        val root = column("ta_root", [
            textarea("ta", "", "", 4),
            text_widget("ta_body", "B")
        ])
        val rects = compute_layout(root, 0, 0, 80, 24)
        val rt = find_rect(rects, "ta")
        val rb = find_rect(rects, "ta_body")
        if rt != nil:
            expect(rt.h).to_equal(4)
        if rb != nil:
            expect(rb.h).to_equal(18)

# ============================================================================
# Layout: hbox flex weighting
# ============================================================================

describe "layout_hbox sizing":

    it "weights children by flex and awards the remainder once":
        val root = row("hb", [
            with_flex(text_widget("hb_a", "A"), 3),
            with_flex(text_widget("hb_b", "B"), 0)
        ])
        val rects = compute_layout(root, 0, 0, 12, 6)
        val ra = find_rect(rects, "hb_a")
        expect(ra != nil).to_equal(true)
        if ra != nil:
            expect(ra.w).to_equal(10)
        expect(find_rect_index(rects, "hb_b")).to_equal(-1)

    it "floors a negative flex weight at zero":
        val root = row("hb_neg", [
            with_flex(text_widget("hbn_a", "A"), 2),
            text_widget("hbn_b", "B").set_prop("flex", "-4")
        ])
        val rects = compute_layout(root, 0, 0, 12, 6)
        val ra = find_rect(rects, "hbn_a")
        if ra != nil:
            expect(ra.w).to_equal(10)
        expect(find_rect_index(rects, "hbn_b")).to_equal(-1)

    it "gives flex children zero width when fixed children overflow":
        val root = row("hb_ov", [
            with_width(text_widget("hbo_a", "A"), 100),
            text_widget("hbo_b", "B")
        ])
        val rects = compute_layout(root, 0, 0, 20, 6)
        expect(find_rect_index(rects, "hbo_b")).to_equal(-1)

# ============================================================================
# Layout: min/max size constraints
# ============================================================================

describe "layout size constraints":

    it "caps a vbox child at max_height":
        val root = column("mh_root", [
            text_widget("mh_child", "A").set_prop("max_height", "4")
        ])
        val rects = compute_layout(root, 0, 0, 80, 24)
        val r = find_rect(rects, "mh_child")
        if r != nil:
            expect(r.h).to_equal(4)

    it "raises a vbox child to min_height":
        val root = column("mn_root", [
            with_height(text_widget("mn_child", "A"), 1).set_prop("min_height", "6")
        ])
        val rects = compute_layout(root, 0, 0, 80, 24)
        val r = find_rect(rects, "mn_child")
        if r != nil:
            expect(r.h).to_equal(6)

    it "caps an hbox child at max_width and raises another to min_width":
        val root = row("mw_root", [
            text_widget("mw_a", "A").set_prop("max_width", "5"),
            text_widget("mw_b", "B").set_prop("min_width", "40")
        ])
        val rects = compute_layout(root, 0, 0, 80, 6)
        val ra = find_rect(rects, "mw_a")
        val rb = find_rect(rects, "mw_b")
        if ra != nil:
            expect(ra.w).to_equal(5)
        if rb != nil:
            expect(rb.w).to_equal(40)

# ============================================================================
# Layout: grid columns and spans
# ============================================================================

describe "layout_grid columns and spans":

    it "honours an explicit columns prop":
        val root = grid_layout("g3", [
            text_widget("g3_a", "A"),
            text_widget("g3_b", "B"),
            text_widget("g3_c", "C")
        ]).set_prop("columns", "3")
        val rects = compute_layout(root, 0, 0, 80, 24)
        val ra = find_rect(rects, "g3_a")
        val rb = find_rect(rects, "g3_b")
        val rc = find_rect(rects, "g3_c")
        if ra != nil:
            expect(ra.x).to_equal(1)
            expect(ra.w).to_equal(26)
        if rb != nil:
            expect(rb.x).to_equal(27)
        if rc != nil:
            expect(rc.x).to_equal(53)
            expect(rc.w).to_equal(26)

    it "wraps a col_span that overflows the row and clamps an oversized span":
        val root = grid_layout("gs", [
            text_widget("gs_a", "A").set_prop("col_span", "2"),
            text_widget("gs_b", "B").set_prop("col_span", "5"),
            text_widget("gs_c", "C").set_prop("col_span", "0")
        ]).set_prop("columns", "2")
        val rects = compute_layout(root, 0, 0, 80, 24)
        val ra = find_rect(rects, "gs_a")
        val rb = find_rect(rects, "gs_b")
        val rc = find_rect(rects, "gs_c")
        if ra != nil:
            expect(ra.y).to_equal(1)
            expect(ra.w).to_equal(78)
        if rb != nil:
            expect(rb.y).to_equal(ra.y + 7)
            expect(rb.w).to_equal(78)
        if rc != nil:
            expect(rc.y).to_equal(ra.y + 14)
            expect(rc.w).to_equal(39)

# ============================================================================
# Layout: fixed (absolute) layout
# ============================================================================

describe "layout_fixed":

    it "gives every child the parent area unless it declares a size":
        val root = column("fx_root", [
            text_widget("fx_a", "A"),
            with_width(with_height(text_widget("fx_b", "B"), 4), 10)
        ]).set_layout("fixed")
        val rects = compute_layout(root, 0, 0, 80, 24)
        val ra = find_rect(rects, "fx_a")
        val rb = find_rect(rects, "fx_b")
        if ra != nil:
            expect(ra.w).to_equal(78)
            expect(ra.h).to_equal(22)
        if rb != nil:
            expect(rb.w).to_equal(10)
            expect(rb.h).to_equal(4)

    it "sizes the first child from its own width and height props":
        val root = column("fx1_root", [
            with_width(with_height(text_widget("fx1_a", "A"), 3), 7)
        ]).set_layout("fixed")
        val rects = compute_layout(root, 0, 0, 80, 24)
        val ra = find_rect(rects, "fx1_a")
        if ra != nil:
            expect(ra.w).to_equal(7)
            expect(ra.h).to_equal(3)

# ============================================================================
# Layout: primitives called directly
# ============================================================================

describe "layout primitives":

    it "returns no rects for empty child lists":
        val none: [WidgetNode] = []
        expect(layout_vbox(none, 0, 0, 10, 10).len()).to_equal(0)
        expect(layout_hbox(none, 0, 0, 10, 10).len()).to_equal(0)
        expect(layout_grid(none, 0, 0, 10, 10, 0).len()).to_equal(0)
        expect(layout_fixed(none, 0, 0, 10, 10).len()).to_equal(0)

    it "clamp_dim caps at max, floors at min, and never returns a negative":
        expect(clamp_dim(10, 0, 4)).to_equal(4)
        expect(clamp_dim(2, 5, -1)).to_equal(5)
        expect(clamp_dim(7, 0, -1)).to_equal(7)
        expect(clamp_dim(-3, -10, -1)).to_equal(0)

    it "get_flex defaults to 1 and floors negative weights at 0":
        expect(get_flex(text_widget("gf_a", "A"))).to_equal(1)
        expect(get_flex(with_flex(text_widget("gf_b", "B"), 4))).to_equal(4)
        expect(get_flex(text_widget("gf_c", "C").set_prop("flex", "-2"))).to_equal(0)

    it "get_fixed_height reads props and widget kinds":
        expect(get_fixed_height(text_widget("gh_a", "A"))).to_equal(0)
        expect(get_fixed_height(with_height(text_widget("gh_b", "B"), 9))).to_equal(9)
        expect(get_fixed_height(statusbar("gh_s", "l", "r"))).to_equal(1)
        expect(get_fixed_height(menubar("gh_m", ["File"]))).to_equal(1)

# ============================================================================
# Layout: scroll and textarea as sized vbox children
# ============================================================================

describe "layout_vbox sized children":

    it "uses a scroll child's max_height as its fixed height in a column":
        val root = column("scv_root", [
            scroll("scv", 6, [text_widget("scv_child", "C")]),
            text_widget("scv_body", "B")
        ])
        val rects = compute_layout(root, 0, 0, 80, 24)
        val rs = find_rect(rects, "scv")
        val rb = find_rect(rects, "scv_body")
        expect(rs != nil).to_equal(true)
        expect(rb != nil).to_equal(true)
        if rs != nil:
            expect(rs.h).to_equal(6)
        if rb != nil:
            expect(rb.h).to_equal(16)

    it "treats a scroll with no max_height prop as unsized and unclipped":
        val bare = scroll("scb", 6, [text_widget("scb_child", "C")]).set_prop("max_height", "")
        expect(get_fixed_height(bare)).to_equal(0)
        val rects = compute_layout(bare, 0, 0, 40, 20)
        val rc = find_rect(rects, "scb_child")
        expect(rc != nil).to_equal(true)
        if rc != nil:
            expect(rc.h).to_equal(20)

    it "treats a textarea with no rows prop as unsized":
        val bare = textarea("tab", "", "", 4).set_prop("rows", "")
        expect(get_fixed_height(bare)).to_equal(0)
