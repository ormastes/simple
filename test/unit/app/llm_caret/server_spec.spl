# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# LLM Caret Server Specification

use std.spec.step

use app.llm_caret.server.{build_health_response, build_models_response,
    build_chat_completion_response, build_anthropic_response,
    build_chat_completion_stream_response, build_anthropic_stream_response,
    build_error_response, handle_route}

# ============================================================================
# Tests
# ============================================================================

describe "Health Endpoint":
    # @manual scenario evidence
    it "returns ok status":
        # @req REQ-SSPEC-UNIT
        step("returns ok status")
        val resp = build_health_response()
        expect(resp).to_contain("\"ok\"")

    it "returns service name":
        # @req REQ-SSPEC-UNIT
        step("returns service name")
        val resp = build_health_response()
        expect(resp).to_contain("llm_caret")

    it "returns version":
        # @req REQ-SSPEC-UNIT
        step("returns version")
        val resp = build_health_response()
        expect(resp).to_contain("0.1.0")

describe "Models Endpoint":
    it "returns list object":
        # @req REQ-SSPEC-UNIT
        step("returns list object")
        val resp = build_models_response()
        expect(resp).to_contain("\"list\"")

    it "includes claude sonnet":
        # @req REQ-SSPEC-UNIT
        step("includes claude sonnet")
        val resp = build_models_response()
        expect(resp).to_contain("claude-sonnet-5")

    it "includes claude opus":
        # @req REQ-SSPEC-UNIT
        step("includes claude opus")
        val resp = build_models_response()
        expect(resp).to_contain("claude-opus-4-20250514")

    it "includes gpt-4o":
        # @req REQ-SSPEC-UNIT
        step("includes gpt-4o")
        val resp = build_models_response()
        expect(resp).to_contain("gpt-4o")

describe "Chat Completion Response":
    it "includes content":
        # @req REQ-SSPEC-UNIT
        step("includes content")
        val resp = build_chat_completion_response("Hello!", "gpt-4o", "stop", 10, 5)
        expect(resp).to_contain("Hello!")

    it "includes model":
        # @req REQ-SSPEC-UNIT
        step("includes model")
        val resp = build_chat_completion_response("Hi", "gpt-4o", "stop", 10, 5)
        expect(resp).to_contain("gpt-4o")

    it "includes finish reason":
        # @req REQ-SSPEC-UNIT
        step("includes finish reason")
        val resp = build_chat_completion_response("Hi", "gpt-4o", "stop", 10, 5)
        expect(resp).to_contain("stop")

    it "has chat.completion object type":
        # @req REQ-SSPEC-UNIT
        step("has chat.completion object type")
        val resp = build_chat_completion_response("Hi", "gpt-4o", "stop", 10, 5)
        expect(resp).to_contain("chat.completion")

    it "has assistant role":
        # @req REQ-SSPEC-UNIT
        step("has assistant role")
        val resp = build_chat_completion_response("Hi", "gpt-4o", "stop", 10, 5)
        expect(resp).to_contain("assistant")

    it "includes created timestamp":
        # @req REQ-SSPEC-UNIT
        step("includes created timestamp")
        val resp = build_chat_completion_response("Hi", "gpt-4o", "stop", 10, 5)
        expect(resp).to_contain("\"created\":")

    it "includes usage with token counts":
        # @req REQ-SSPEC-UNIT
        step("includes usage with token counts")
        val resp = build_chat_completion_response("Hi", "gpt-4o", "stop", 10, 5)
        expect(resp).to_contain("\"prompt_tokens\":10")
        expect(resp).to_contain("\"completion_tokens\":5")
        expect(resp).to_contain("\"total_tokens\":15")

    it "is a well-formed JSON envelope":
        # @req REQ-SSPEC-UNIT
        step("is a well-formed JSON envelope")
        val resp = build_chat_completion_response("Hi", "gpt-4o", "stop", 10, 5)
        expect(resp).to_start_with("{")
        expect(resp).to_end_with("}")
        assert_false(resp.contains("<special:"))
        assert_false(resp.contains("<value:0x"))

describe "Anthropic Response":
    it "includes text content":
        # @req REQ-SSPEC-UNIT
        step("includes text content")
        val resp = build_anthropic_response("Hello!", "claude-sonnet-5", "end_turn", 10, 5)
        expect(resp).to_contain("Hello!")

    it "has message type":
        # @req REQ-SSPEC-UNIT
        step("has message type")
        val resp = build_anthropic_response("Hi", "claude-sonnet-5", "end_turn", 10, 5)
        expect(resp).to_contain("\"message\"")

    it "includes stop reason":
        # @req REQ-SSPEC-UNIT
        step("includes stop reason")
        val resp = build_anthropic_response("Hi", "claude-sonnet-5", "end_turn", 10, 5)
        expect(resp).to_contain("end_turn")

    it "has top-level assistant role":
        # @req REQ-SSPEC-UNIT
        step("has top-level assistant role")
        val resp = build_anthropic_response("Hi", "claude-sonnet-5", "end_turn", 10, 5)
        expect(resp).to_contain("\"role\":\"assistant\"")

    it "includes usage with token counts":
        # @req REQ-SSPEC-UNIT
        step("includes usage with token counts")
        val resp = build_anthropic_response("Hi", "claude-sonnet-5", "end_turn", 10, 5)
        expect(resp).to_contain("\"input_tokens\":10")
        expect(resp).to_contain("\"output_tokens\":5")

    it "is a well-formed JSON envelope":
        # @req REQ-SSPEC-UNIT
        step("is a well-formed JSON envelope")
        val resp = build_anthropic_response("Hi", "claude-sonnet-5", "end_turn", 10, 5)
        expect(resp).to_start_with("{")
        expect(resp).to_end_with("}")
        assert_false(resp.contains("<special:"))
        assert_false(resp.contains("<value:0x"))

describe "Error Response":
    it "includes error message":
        # @req REQ-SSPEC-UNIT
        step("includes error message")
        val resp = build_error_response("not found", 404)
        expect(resp).to_contain("not found")

    it "includes status code":
        # @req REQ-SSPEC-UNIT
        step("includes status code")
        val resp = build_error_response("bad request", 400)
        expect(resp).to_contain("400")

describe "Route Handling":
    it "handles health check":
        # @req REQ-SSPEC-UNIT
        step("handles health check")
        val resp = handle_route("GET", "/v1/health", "")
        expect(resp).to_contain("ok")

    it "handles models list":
        # @req REQ-SSPEC-UNIT
        step("handles models list")
        val resp = handle_route("GET", "/v1/models", "")
        expect(resp).to_contain("list")

    it "returns 404 for unknown path":
        # @req REQ-SSPEC-UNIT
        step("returns 404 for unknown path")
        val resp = handle_route("GET", "/unknown", "")
        expect(resp).to_contain("not found")

    it "returns error for empty chat completion":
        # @req REQ-SSPEC-UNIT
        step("returns error for empty chat completion")
        val resp = handle_route("POST", "/v1/chat/completions", "")
        expect(resp).to_contain("messages required")

    it "returns 501 for valid chat request":
        # @req REQ-SSPEC-UNIT
        step("returns 501 for valid chat request")
        val body = "{\"content\":\"Hello\"}"
        val resp = handle_route("POST", "/v1/chat/completions", body)
        expect(resp).to_contain("501")

describe "Streaming Responses":
    it "openai stream terminates with a literal [DONE] frame":
        # @req REQ-SSPEC-UNIT
        step("openai stream terminates with a literal [DONE] frame")
        val resp = build_chat_completion_stream_response("Hello!", "gpt-4o", "stop")
        expect(resp).to_contain("chat.completion.chunk")
        expect(resp).to_end_with("data: [DONE]\n\n")

    it "anthropic stream emits the six SSE events in order":
        # @req REQ-SSPEC-UNIT
        step("anthropic stream emits the six SSE events in order")
        val resp = build_anthropic_stream_response("Hello!", "claude-sonnet-5", "end_turn", 10, 5)
        expect(resp.index_of("event: message_start")).to_be_less_than(resp.index_of("event: content_block_start"))
        expect(resp.index_of("event: content_block_start")).to_be_less_than(resp.index_of("event: content_block_delta"))
        expect(resp.index_of("event: content_block_delta")).to_be_less_than(resp.index_of("event: content_block_stop"))
        expect(resp.index_of("event: content_block_stop")).to_be_less_than(resp.index_of("event: message_delta"))
        expect(resp.index_of("event: message_delta")).to_be_less_than(resp.index_of("event: message_stop"))
