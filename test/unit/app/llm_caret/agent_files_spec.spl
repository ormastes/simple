# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use app.llm_caret.agent_files.{snapshot_agent_files, detect_agent_file_changes}
use app.llm_caret.agent_plan.{AgentFileFingerprint}

describe "LLM Caret agent file snapshots":
    # @manual scenario evidence
    it "skips missing and empty paths":
        # @req REQ-SSPEC-UNIT
        step("skips missing and empty paths")
        val snap = snapshot_agent_files("agent-1", ["", "/nonexistent/path/xyz.spl"])
        expect(snap.len()).to_equal(0)

    it "detects a changed fingerprint between snapshots":
        # @req REQ-SSPEC-UNIT
        step("detects a changed fingerprint between snapshots")
        val before = [AgentFileFingerprint(agent_id: "a", path: "f.spl", fingerprint: "hash1")]
        val after = [AgentFileFingerprint(agent_id: "a", path: "f.spl", fingerprint: "hash2")]
        val changes = detect_agent_file_changes(before, after)
        expect(changes.len()).to_equal(1)
        expect(changes[0].changed_files).to_contain("f.spl")

    it "reports no change for identical fingerprints":
        # @req REQ-SSPEC-UNIT
        step("reports no change for identical fingerprints")
        val fp = [AgentFileFingerprint(agent_id: "a", path: "f.spl", fingerprint: "hash1")]
        val changes = detect_agent_file_changes(fp, fp)
        var changed = 0
        for c in changes:
            changed = changed + c.changed_files.len()
        expect(changed).to_equal(0)
