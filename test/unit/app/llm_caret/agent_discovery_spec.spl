use app.llm_caret.agent_discovery.{parse_mcp_manifest, parse_plugin_manifest, discover_agent_capabilities, build_plugin_install_args}

describe "LLM Caret agent discovery":
    it "keeps every server name in a multi-server MCP manifest":
        val manifest = "{\"servers\":[{\"name\":\"alpha\"},{\"name\":\"beta\"},{\"name\": \"gamma\"}]}"
        val servers = parse_mcp_manifest(manifest)
        expect(servers).to_contain("alpha")
        expect(servers).to_contain("beta")
        expect(servers).to_contain("gamma")

    it "parses identifier keys and dedupes repeats":
        val manifest = "{\"identifier\":\"same\",\"name\":\"same\"}"
        val servers = parse_mcp_manifest(manifest)
        expect(servers.len()).to_equal(1)
        expect(servers[0]).to_equal("same")

    it "keeps every plugin name and merges across manifests":
        val caps = discover_agent_capabilities(
            ["{\"name\":\"srv-a\"}", "{\"name\":\"srv-b\"}"],
            ["{\"plugins\":[{\"name\":\"p1\"},{\"name\":\"p2\"}]}"])
        expect(caps.mcp_servers).to_contain("srv-a")
        expect(caps.mcp_servers).to_contain("srv-b")
        expect(caps.plugins).to_contain("p1")
        expect(caps.plugins).to_contain("p2")

    it "returns empty sets for garbage manifests":
        val caps = discover_agent_capabilities(["not json at all"], [""])
        expect(caps.mcp_servers.len()).to_equal(0)
        expect(caps.plugins.len()).to_equal(0)

    it "builds plugin install args skipping empty extras":
        val args = build_plugin_install_args("my-plugin", "", ["--scope", "", "user"])
        expect(args.len()).to_equal(4)
        expect(args[0]).to_equal("install-plugin")
        expect(args[1]).to_equal("my-plugin")
