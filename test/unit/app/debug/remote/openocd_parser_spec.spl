"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/app/debug/remote/openocd_parser_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# OpenOCD Parser Tests
# Tests OpenOCD telnet output parsing, hex formatting, reset markers.

# --- Local helpers ---

fn rt_hex(value: i64) -> text:
    if value == 0:
        return "0"
    var result = ""
    var v = value
    val hex_chars = "0123456789abcdef"
    while v > 0:
        val digit = v % 16
        result = hex_chars[digit] + result
        v = v / 16
    result

fn parse_mdw_output(output: text) -> [i64]:
    var result: [i64] = []
    val parts = output.split(" ")
    for part in parts:
        if part.starts_with("0x"):
            val hex_val = part[2..]
            val num = hex_val.parse_int() ?? 0
            result = result + [num]
    result

fn format_address(addr: i64) -> text:
    "0x" + rt_hex(addr)

# --- Tests ---

describe "OpenOCD hex formatting":
    it "formats 0 as 0":
        # @req: REQ-UNIT-APP-001
        step("Verify: formats 0 as 0")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(rt_hex(0)).to_equal("0")

    it "formats 255 as ff":
        # @req: REQ-UNIT-APP-002
        step("Verify: formats 255 as ff")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(rt_hex(255)).to_equal("ff")

    it "formats 256 as 100":
        # @req: REQ-UNIT-APP-003
        step("Verify: formats 256 as 100")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(rt_hex(256)).to_equal("100")

    it "formats 0x1000 as 1000":
        # @req: REQ-UNIT-APP-004
        step("Verify: formats 0x1000 as 1000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(rt_hex(4096)).to_equal("1000")

    it "formats address with 0x prefix":
        # @req: REQ-UNIT-APP-005
        step("Verify: formats address with 0x prefix")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(format_address(4096)).to_equal("0x1000")

describe "OpenOCD mdw output parsing":
    it "parses single word":
        # @req: REQ-UNIT-APP-006
        step("Verify: parses single word")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = parse_mdw_output("0x08000000: 0xDEADBEEF")
        expect(result.len()).to_be_greater_than(0)

    it "parses hex values from output":
        # @req: REQ-UNIT-APP-007
        step("Verify: parses hex values from output")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = parse_mdw_output("0x20000000: 0x0 0x0 0x0 0x0")
        expect(result.len()).to_be_greater_than(0)

describe "OpenOCD process config":
    it "OpenOCD config path for STM32H7":
        # @req: REQ-UNIT-APP-008
        step("Verify: OpenOCD config path for STM32H7")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = "board/stm32h7x3i_eval.cfg"
        expect(cfg).to_contain("stm32h7")

    it "OpenOCD config path for STM32WB":
        # @req: REQ-UNIT-APP-009
        step("Verify: OpenOCD config path for STM32WB")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = "board/stm32wb5x_nucleo.cfg"
        expect(cfg).to_contain("stm32wb")

    it "GDB port defaults for STM32H7":
        # @req: REQ-UNIT-APP-010
        step("Verify: GDB port defaults for STM32H7")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val port = 3333
        expect(port).to_equal(3333)  # oracle: expected value 3333 is the behavior asserted by this regression spec

    it "telnet port is GDB port + 1000":
        # @req: REQ-UNIT-APP-011
        step("Verify: telnet port is GDB port + 1000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val gdb_port = 3333
        val telnet_port = gdb_port + 1000
        expect(telnet_port).to_equal(4333)  # oracle: expected value 4333 is the behavior asserted by this regression spec
