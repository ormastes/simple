"""
## Purpose and audience
Purpose: Prove that Trace32 runtime command config.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-APP-DEBUG-001 — stable requirement identity for this spec.

use app.debug.remote.protocol.trace32.{Trace32Client}

use std.spec.step

describe "Trace32 runtime command config":
    it "builds a basic t32rem command without protocol":
        step("Verify: builds a basic t32rem command without protocol")
        # @req: REQ-APP-DEBUG-001
        val cmd = Trace32Client.build_command(
            "/opt/t32/bin/pc_linux64/t32rem", "localhost", 20000, "", "PING"
        )
        expect(cmd).to_equal("/opt/t32/bin/pc_linux64/t32rem localhost port=20000 PING")

    it "includes protocol override when provided":
        step("Verify: includes protocol override when provided")
        val cmd = Trace32Client.build_command(
            "/opt/t32/bin/pc_linux64/t32rem", "localhost", 20000, "NETASSIST", "PING"
        )
        expect(cmd).to_equal("/opt/t32/bin/pc_linux64/t32rem localhost port=20000 protocol=NETASSIST PING")

    it "supports wrapper scripts as the executable path":
        step("Verify: supports wrapper scripts as the executable path")
        val cmd = Trace32Client.build_command(
            "scripts/t32rem_docker.shs", "localhost", 20000, "NETTCP",
            "SETUP.API.GDB.Enable /PORT 2331"
        )
        expect(cmd).to_start_with("scripts/t32rem_docker.shs localhost port=20000 protocol=NETTCP")
        expect(cmd).to_end_with("SETUP.API.GDB.Enable /PORT 2331")

describe "Trace32 wait timing":
    it "uses at least one second for zero timeout":
        step("Verify: uses at least one second for zero timeout")
        expect(Trace32Client.wait_seconds(0)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "rounds sub-second waits up to one second":
        step("Verify: rounds sub-second waits up to one second")
        expect(Trace32Client.wait_seconds(500)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "uses whole seconds for larger waits":
        step("Verify: uses whole seconds for larger waits")
        expect(Trace32Client.wait_seconds(5000)).to_equal(5)  # oracle: 5 — named expected value from the requirement
