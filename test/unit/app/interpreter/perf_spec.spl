        it "string foreach count preserves accumulator":
            # @req REQ-INTERP-PERF-001
            # @capture(statistics): string foreach character count
            step("Verify: string foreach count preserves accumulator")
            val text = "abc"
            var count: i64 = 0
            for ch in text:
                count = count + 1
            expect(count).to_equal(3)  # oracle: 3 — named expected value from the requirement
            # NOTE: the post-loop read of the loop variable that used to be asserted
            # here was REMOVED 2026-08-08. It only ever passed because the `for` loop
            # variable LEAKED into the enclosing scope, clobbering any outer binding of
            # the same name -- a real defect, now fixed. The accumulator assertion above
            # is the actual subject of this perf example and is unchanged.
            # doc/08_tracking/bug/for_loop_variable_leaks_into_enclosing_scope_2026-08-04.md

        it "string foreach match count preserves accumulator":
            # @req REQ-INTERP-PERF-001
            # @capture(statistics): string foreach match count for "a"
            step("Verify: string foreach match count preserves accumulator")
            val text = "abca"
            var count: i64 = 0
            for ch in text:
                if ch == "a":
                    count = count + 1
            expect(count).to_equal(2)  # oracle: 2 — named expected value from the requirement
            # NOTE: the post-loop read of the loop variable that used to be asserted
            # here was REMOVED 2026-08-08. It only ever passed because the `for` loop
            # variable LEAKED into the enclosing scope, clobbering any outer binding of
            # the same name -- a real defect, now fixed. The accumulator assertion above
