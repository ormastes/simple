        val defines_match_converter = converter_source.contains("fn convert_match_expression(")
        val recognizes_match_kind = converter_source.contains("case \"match_expression\":")
        val match_contract_holds = defines_match_converter and recognizes_match_kind
        expect(match_contract_holds).to_equal(true)  # oracle: the match_expression kind is the only dispatch into convert_match_expression

    it "converts match arms via convert_match_arm":
        # @req REQ-AST-CONVERT-044
        # @capture(bit_table): match-arm converter vs the shipped function name
        step("Require the shipped converter to define the match-arm converter")
        val converter_source = _converter_source()
        val defines_arm_converter = converter_source.contains("fn convert_match_arm(")
        expect(defines_arm_converter).to_equal(true)  # oracle: convert_match_arm is the named entry point every case clause routes through

    it "converts range expressions via convert_range_expression":
        # @req REQ-AST-CONVERT-045
        # @capture(bit_table): range-expression converter vs the shipped function name
        step("Require the shipped converter to define the range-expression converter and route the range kind to it")
        val converter_source = _converter_source()
        val defines_range_converter = converter_source.contains("fn convert_range_expression(")
        val recognizes_range_kind = converter_source.contains("case \"range_expression\":")
        val range_contract_holds = defines_range_converter and recognizes_range_kind
        expect(range_contract_holds).to_equal(true)  # oracle: the range_expression kind is the only dispatch into convert_range_expression

# @manual_section: conversion-error-handling
describe "Conversion Error Handling":
    it "returns error for unknown expression kind":
        # @req REQ-AST-CONVERT-046
        # @capture(protocol_json): unknown-kind failure vs the shipped error message
        step("Require the shipped converter to reject unknown node kinds with its named error")
        val converter_source = _converter_source()
        val rejects_unknown_kinds = converter_source.contains("Err(\"Unknown expression kind:")
        expect(rejects_unknown_kinds).to_equal(true)  # oracle: the catch-all case must fail closed naming the kind, or unknown nodes silently become wrong Exprs

    it "returns error for incomplete binary expression":
        # @req REQ-AST-CONVERT-047
        # @capture(protocol_json): incomplete-binary failure vs the shipped error message
        step("Require the shipped converter to fail binary nodes without both operands with its named error")
        val converter_source = _converter_source()
        val rejects_incomplete_binary = converter_source.contains("Err(\"Incomplete binary expression\")")
        expect(rejects_incomplete_binary).to_equal(true)  # oracle: a missing operand must fail closed or the evaluator sees a half-applied operator

    it "returns error for incomplete unary expression":
        # @req REQ-AST-CONVERT-048
        # @capture(protocol_json): incomplete-unary failure vs the shipped error message
        step("Require the shipped converter to fail unary nodes without an operand with its named error")
        val converter_source = _converter_source()
        val rejects_incomplete_unary = converter_source.contains("Err(\"Incomplete unary expression\")")
        expect(rejects_incomplete_unary).to_equal(true)  # oracle: a missing operand must fail closed or the evaluator sees an operator with nothing to apply

    it "returns error for call missing callee":
        # @req REQ-AST-CONVERT-049
        # @capture(protocol_json): callee-less call failure vs the shipped error message
        step("Require the shipped converter to fail call nodes with no callee with its named error")
        val converter_source = _converter_source()
        val rejects_callee_less_calls = converter_source.contains("Err(\"Call missing callee\")")
        expect(rejects_callee_less_calls).to_equal(true)  # oracle: a call with nothing to call must fail closed at conversion, not at dispatch

    it "returns error for method call missing object":
        # @req REQ-AST-CONVERT-050
        # @capture(protocol_json): receiver-less method failure vs the shipped error message
        step("Require the shipped converter to fail method calls with no receiver with its named error")
        val converter_source = _converter_source()
        val rejects_receiver_less_calls = converter_source.contains("Err(\"Method call missing object\")")
        expect(rejects_receiver_less_calls).to_equal(true)  # oracle: a method call with no receiver must fail closed at conversion, not at dispatch

    it "returns error for incomplete index expression":
        # @req REQ-AST-CONVERT-051
        # @capture(protocol_json): index-less index failure vs the shipped error message
        step("Require the shipped converter to fail index nodes without an index with its named error")
        val converter_source = _converter_source()
        val rejects_index_less_indexing = converter_source.contains("Err(\"Incomplete index expression\")")
        expect(rejects_index_less_indexing).to_equal(true)  # oracle: an index expression without an index must fail closed, not index by a default

    it "returns error for field access missing object":
        # @req REQ-AST-CONVERT-052
        # @capture(protocol_json): object-less field failure vs the shipped error message
        step("Require the shipped converter to fail field access with no object with its named error")
        val converter_source = _converter_source()
        val rejects_object_less_fields = converter_source.contains("Err(\"Field access missing object\")")
        expect(rejects_object_less_fields).to_equal(true)  # oracle: a field access with no base object must fail closed at conversion

    it "returns error for incomplete dict entry":
        # @req REQ-AST-CONVERT-053
        # @capture(protocol_json): half-entry failure vs the shipped error message
        step("Require the shipped converter to fail dict entries missing a key or value with its named error")
        val converter_source = _converter_source()
        val rejects_half_entries = converter_source.contains("Err(\"Incomplete dict entry\")")
        expect(rejects_half_entries).to_equal(true)  # oracle: an entry without both key and value must fail closed or the dict silently loses data

    it "returns error for lambda missing body":
        # @req REQ-AST-CONVERT-054
        # @capture(protocol_json): body-less lambda failure vs the shipped error message
        step("Require the shipped converter to fail lambdas without a body with its named error")
        val converter_source = _converter_source()
        val rejects_body_less_lambdas = converter_source.contains("Err(\"Lambda missing body\")")
        expect(rejects_body_less_lambdas).to_equal(true)  # oracle: a bodyless lambda must fail closed, not evaluate to nil when called

    it "returns error for incomplete if expression":
        # @req REQ-AST-CONVERT-055
        # @capture(protocol_json): branch-less if failure vs the shipped error message
        step("Require the shipped converter to fail if nodes missing a branch with its named error")
        val converter_source = _converter_source()
        val rejects_branch_less_ifs = converter_source.contains("Err(\"Incomplete if expression\")")
        expect(rejects_branch_less_ifs).to_equal(true)  # oracle: a missing branch must fail closed or the if silently picks the wrong arm

    it "returns error for match missing value":
        # @req REQ-AST-CONVERT-056
        # @capture(protocol_json): value-less match failure vs the shipped error message
        step("Require the shipped converter to fail match nodes with no scrutinee with its named error")
        val converter_source = _converter_source()
        val rejects_value_less_matches = converter_source.contains("Err(\"Match expression missing value\")")
        expect(rejects_value_less_matches).to_equal(true)  # oracle: a match with nothing to match on must fail closed at conversion

    it "returns error for incomplete match arm":
        # @req REQ-AST-CONVERT-057
        # @capture(protocol_json): half-arm failure vs the shipped error message
        step("Require the shipped converter to fail case clauses without pattern and body with its named error")
        val converter_source = _converter_source()
        val rejects_half_arms = converter_source.contains("Err(\"Incomplete match arm\")")
        expect(rejects_half_arms).to_equal(true)  # oracle: an arm without both a pattern and a body must fail closed or matching is undefined

    it "returns error for incomplete range expression":
        # @req REQ-AST-CONVERT-058
        # @capture(protocol_json): bound-less range failure vs the shipped error message
        step("Require the shipped converter to fail range nodes missing a bound with its named error")
        val converter_source = _converter_source()
        val rejects_bound_less_ranges = converter_source.contains("Err(\"Incomplete range expression\")")
        expect(rejects_bound_less_ranges).to_equal(true)  # oracle: a range without its bounds must fail closed, not iterate an empty default

    it "returns error for empty parenthesized expression":
        # @req REQ-AST-CONVERT-059
        # @capture(protocol_json): empty-parens failure vs the shipped error message
        step("Require the shipped converter to fail empty parentheses with its named error")
        val converter_source = _converter_source()
        val rejects_empty_parens = converter_source.contains("Err(\"Empty parenthesized expression\")")
        expect(rejects_empty_parens).to_equal(true)  # oracle: () carries no expression, so it must fail closed instead of becoming a nil literal

    it "returns error for await missing expression":
        # @req REQ-AST-CONVERT-060
        # @capture(protocol_json): operand-less await failure vs the shipped error message
        step("Require the shipped converter to fail await nodes with no operand with its named error")
        val converter_source = _converter_source()
        val rejects_operand_less_awaits = converter_source.contains("Err(\"Await missing expression\")")
        expect(rejects_operand_less_awaits).to_equal(true)  # oracle: await with nothing to await must fail closed at conversion

    it "returns error for try missing expression":
        # @req REQ-AST-CONVERT-061
        # @capture(protocol_json): operand-less try failure vs the shipped error message
        step("Require the shipped converter to fail try nodes with no operand with its named error")
        val converter_source = _converter_source()
        val rejects_operand_less_trys = converter_source.contains("Err(\"Try missing expression\")")
        expect(rejects_operand_less_trys).to_equal(true)  # oracle: try with nothing to attempt must fail closed at conversion
