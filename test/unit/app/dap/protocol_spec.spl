        # @req REQ-SSPEC-UNIT
        step("creates source with path")
        # Source represents debugged source code file
        expect(true)

    it "creates source with name":
        # @req REQ-SSPEC-UNIT
        step("creates source with name")
        # Source can be created with display name
        expect(true)

