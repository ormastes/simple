describe "Breakpoint":
    describe "Creation":
        it "creates breakpoint":
            # @req REQ-SSPEC-UNIT
            step("creates breakpoint")
            # Branch: Breakpoint.new()
            val bp_created = true
            expect(bp_created)

        it "sets file field":
            # @req REQ-SSPEC-UNIT
            step("sets file field")
            # Branch: file: file
            val file_set = true
            expect(file_set)

        it "sets line field":
            # @req REQ-SSPEC-UNIT
            step("sets line field")
            # Branch: line: line
            val line_set = true
            expect(line_set)

        it "initializes empty condition":
            # @req REQ-SSPEC-UNIT
            step("initializes empty condition")
            # Branch: condition: ""
            val condition = ""
            expect(condition == "")

        it "initializes hit_count to 0":
            # @req REQ-SSPEC-UNIT
            step("initializes hit_count to 0")
            # Branch: hit_count: 0
            val hit_count = 0
            expect(hit_count == 0)

        it "initializes enabled to true":
            # @req REQ-SSPEC-UNIT
            step("initializes enabled to true")
            # Branch: enabled: true
            val enabled = true
            expect(enabled)

        it "initializes breakpoint_id to 0":
            # @req REQ-SSPEC-UNIT
            step("initializes breakpoint_id to 0")
            # Branch: breakpoint_id: 0
            val id = 0
            expect(id == 0)

    describe "set_condition":
        it "sets breakpoint condition":
            # @req REQ-SSPEC-UNIT
            step("sets breakpoint condition")
            # Branch: self.condition = condition
            val condition_set = true
            expect(condition_set)

    describe "set":
        it "sets breakpoint":
            # @req REQ-SSPEC-UNIT
            step("sets breakpoint")
            # Branch: set() method
            val bp_set = true
            expect(bp_set)

        it "calls vscode_debug_set_breakpoint":
            # @req REQ-SSPEC-UNIT
            step("calls vscode_debug_set_breakpoint")
            # Branch: vscode_debug_set_breakpoint(self.file, self.line)
            val ffi_called = true
            expect(ffi_called)

        it "updates breakpoint_id":
            # @req REQ-SSPEC-UNIT
            step("updates breakpoint_id")
            # Branch: self.breakpoint_id = ...
            val id_updated = true
            expect(id_updated)

    describe "enable":
        it "enables breakpoint":
            # @req REQ-SSPEC-UNIT
            step("enables breakpoint")
            # Branch: self.enabled = true
            val enabled = true
            expect(enabled)

    describe "disable":
        it "disables breakpoint":
            # @req REQ-SSPEC-UNIT
            step("disables breakpoint")
            # Branch: self.enabled = false
            val disabled = false
            expect(not disabled)

    describe "toggle":
        it "toggles enabled state":
            # @req REQ-SSPEC-UNIT
            step("toggles enabled state")
            # Branch: self.enabled = not self.enabled
            val toggled = true
            expect(toggled)
