"""
## Purpose and audience
Purpose: Prove generated query diagnostic multi-pattern parity.
Audience: Maintainers changing query diagnostic code inference.
"""
use std.spec.{step}
use app.io.mod.{file_read_text}
use app.cli.query_error_pattern_matcher.{
    QUERY_ERROR_PATTERN_COUNT, query_error_pattern_hits, query_error_pattern_hit
}
use app.query_error_pattern_gen.patterns.{query_error_pattern_specs}
use app.query_error_pattern_gen.generator.{
    QueryErrorGeneratorLimits, query_error_pattern_build, query_error_pattern_build_default
}
use app.query_error_pattern_gen.render.{query_error_pattern_render}
use app.query_error_pattern_gen.rules.{query_error_rule_specs}
use app.query_error_pattern_gen.rule_render.{
    query_error_rule_validate, query_error_rule_block_render,
    query_error_fallback_block_render
}

describe "query diagnostic multi-pattern matcher":
    it "keeps ordered rule priority and generated blocks current":
        step("checks generated query error rules and fallbacks")
        val rules = query_error_rule_specs()
        expect(rules.len()).to_equal(80)
        var priority = 0
        while priority < rules.len():
            expect(rules[priority].priority).to_equal(priority)
            priority = priority + 1
        match query_error_rule_validate(rules, QUERY_ERROR_PATTERN_COUNT):
            case Err(message): expect(message).to_equal("")
            case Ok(valid): expect(valid).to_equal(true)
        val classifier_source = file_read_text("src/app/cli/query_error_codes.spl")
        match query_error_rule_block_render():
            case Err(message): expect(message).to_equal("")
            case Ok(block): expect(classifier_source).to_contain(block)
        match query_error_fallback_block_render():
            case Err(message): expect(message).to_equal("")
            case Ok(block): expect(classifier_source).to_contain(block)

    it "renders the committed matcher exactly and fails closed on bounds":
        step("checks matcher source freshness and generator bounds")
        val specs = query_error_pattern_specs()
        match query_error_pattern_build_default():
            case Err(message):
                expect(message).to_equal("")
            case Ok(model):
                val rendered = query_error_pattern_render(model, specs.len())
                expect(rendered).to_equal(file_read_text("src/app/cli/query_error_pattern_matcher.spl"))
        val tiny = QueryErrorGeneratorLimits(max_patterns: 128, max_states: 1, max_edges: 65535)
        match query_error_pattern_build(specs, tiny):
            case Ok(model):
                expect(model.fail.len()).to_equal(-1)
            case Err(message):
                expect(message).to_equal("query error matcher state limit exceeded")

    it "rebuilds the committed sparse table cardinalities":
        step("builds deterministic query error matcher tables")
        match query_error_pattern_build_default():
            case Err(message):
                expect(message).to_equal("")
            case Ok(model):
                expect(model.root_next.len()).to_equal(128)
                expect(model.fail.len()).to_equal(1160)
                expect(model.edge_byte.len()).to_equal(1159)
                expect(model.edge_next.len()).to_equal(1159)
                expect(model.edge_start.len()).to_equal(1161)
                expect(model.output_lo.len()).to_equal(117)
                expect(model.output_hi.len()).to_equal(117)

    it "keeps generated matcher IDs aligned with the canonical manifest":
        step("checks canonical query error pattern IDs")
        val specs = query_error_pattern_specs()
        expect(specs.len()).to_equal(QUERY_ERROR_PATTERN_COUNT)
        var pattern_id = 0
        while pattern_id < specs.len():
            expect(specs[pattern_id].id).to_equal(pattern_id)
            val hits = query_error_pattern_hits("日本語 " + specs[pattern_id].literal + " café")
            expect(query_error_pattern_hit(hits, pattern_id)).to_equal(true)
            pattern_id = pattern_id + 1

    it "recognizes every generated fixed literal with Unicode neighbors":
        step("recognizes every generated query error literal")
        val cases: [(text, i64)] = [
            ("not found in this scope", 0),
            ("not defined", 1),
            ("variable", 2),
            ("not found", 3),
            ("cannot find", 4),
            ("function", 5),
            ("expected type", 6),
            ("found", 7),
            ("type mismatch", 8),
            ("incompatible type", 9),
            ("cannot assign", 10),
            ("invalid assignment", 11),
            ("cannot apply operator", 12),
            ("invalid pattern", 13),
            ("missing field", 14),
            ("missing required field", 15),
            ("duplicate definition", 16),
            ("already defined", 17),
            ("circular dependency", 18),
            ("circular import", 19),
            ("module", 20),
            ("type", 21),
            ("no field named", 22),
            ("no method named", 23),
            ("unknown class", 24),
            ("unknown enum", 25),
            ("expected", 26),
            ("argument", 27),
            ("missing", 28),
            ("struct field", 29),
            ("duplicate", 30),
            ("method", 31),
            ("trait", 32),
            ("self", 33),
            ("static", 34),
            ("unresolved import", 35),
            ("private", 36),
            ("field", 37),
            ("not callable", 38),
            ("is not callable", 39),
            ("inconsistent bindings", 40),
            ("break", 41),
            ("outside", 42),
            ("loop", 43),
            ("continue", 44),
            ("return", 45),
            ("closure", 46),
            ("yield", 47),
            ("generator", 48),
            ("await", 49),
            ("async", 50),
            ("actor", 51),
            ("send", 52),
            ("recv", 53),
            ("channel closed", 54),
            ("deadlock", 55),
            ("capability", 56),
            ("violation", 57),
            ("isolation", 58),
            ("borrow", 59),
            ("unknown macro", 60),
            ("macro", 61),
            ("before definition", 62),
            ("invocation failed", 63),
            ("pointcut", 64),
            ("syntax", 65),
            ("joinpoint", 66),
            ("undefined", 67),
            ("advice", 68),
            ("invalid", 69),
            ("weaving", 70),
            ("target", 71),
            ("aspect", 72),
            ("circular", 73),
            ("mixin", 74),
            ("conflict", 75),
            ("unsupported feature", 76),
            ("division by zero", 77),
            ("index", 78),
            ("out of bounds", 79),
            ("stack overflow", 80),
            ("assertion failed", 81),
            ("Method resolution", 82),
            ("infinite type", 83),
            ("occurs in", 84),
            ("trait not implemented", 85),
            ("does not implement", 86),
            ("dimension mismatch", 87),
            ("layer dimension mismatch", 88),
            ("tensor rank mismatch", 89),
            ("matrix multiplication dimension", 90),
            ("shapes cannot be broadcast", 91),
            ("batch dimension mismatch", 92),
            ("channel dimension mismatch", 93),
            ("sequence length mismatch", 94),
            ("cannot borrow", 95),
            ("also borrowed", 96),
            ("cannot use", 97),
            ("mutably borrowed", 98),
            ("cannot move", 99),
            ("borrowed", 100),
            ("still be active at return", 101),
            ("foreign trait", 102),
            ("foreign type", 103),
            ("Overlapping implementations", 104),
            ("Blanket implementation", 105),
            ("conflicts", 106),
            ("Conflicting associated type", 107),
            ("ambiguous trait impl", 108),
            ("overlapping impls", 109),
            ("missing method", 110),
            ("impl", 111),
            ("cyclic trait bound", 112),
            ("undefined trait", 113),
            ("missing associated type", 114),
            ("associated type mismatch", 115)
        ]
        expect(cases.len()).to_equal(QUERY_ERROR_PATTERN_COUNT)
        for case in cases:
            val hits = query_error_pattern_hits("日本語 " + case.0 + " café")
            expect(query_error_pattern_hit(hits, case.1)).to_equal(true)

    it "preserves suffix outputs case sensitivity and unrelated Unicode":
        step("preserves matcher overlap and case contracts")
        val overlap = query_error_pattern_hits("layer dimension mismatch")
        expect(query_error_pattern_hit(overlap, 88)).to_equal(true)
        expect(query_error_pattern_hit(overlap, 87)).to_equal(true)

        val uppercase = query_error_pattern_hits("VARIABLE NOT DEFINED")
        expect(query_error_pattern_hit(uppercase, 2)).to_equal(false)

        val unrelated = query_error_pattern_hits("✓ 日本語 café")
        var pattern_id = 0
        while pattern_id < QUERY_ERROR_PATTERN_COUNT:
            expect(query_error_pattern_hit(unrelated, pattern_id)).to_equal(false)
            pattern_id = pattern_id + 1
