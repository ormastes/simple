# Reproducing spec for the `lsp_symbols` unbalanced-JSON defect.
#
# `symbol_range_json` built its closing braces with the literal "}}". Inside an
# ordinary (non-raw) Simple string `}}` is the interpolation escape for ONE
# literal `}`, so the range object was emitted unclosed. A two-symbol file came
# back from the LSP MCP `lsp_symbols` tool with 16 `{` and 12 `}`, and
# `selectionRange` / `simpleVisibility` appeared NESTED inside `range` instead of
# as siblings — invalid JSON and an invalid LSP DocumentSymbol.

use app.cli._QueryVisibility.query_commands.{symbol_range_json, ParsedSymbol}

fn brace_delta(s: text) -> i64:
    var open_count = 0
    var close_count = 0
    var i = 0
    while i < s.len():
        val ch = s.substring(i, i + 1)
        if ch == "{":
            open_count = open_count + 1
        elif ch == "}":
            close_count = close_count + 1
        i = i + 1
    open_count - close_count

fn sym(line_num: i64, start_col: i64, end_col: i64) -> ParsedSymbol:
    ParsedSymbol(
        name: "helper",
        kind: "fn",
        line_num: line_num,
        start_col: start_col,
        end_col: end_col,
        file_path: "fixture.spl")

describe "symbol_range_json emits a closed range object":
    it "returns exactly the LSP Range shape for a one-line symbol":
        expect(symbol_range_json(sym(1, 3, 9))).to_equal(
            "{\"start\":{\"line\":0,\"character\":3},\"end\":{\"line\":0,\"character\":9}" + "}")

    it "closes every brace it opens":
        expect(brace_delta(symbol_range_json(sym(1, 3, 9)))).to_equal(0)

    it "ends with two closing braces, not one":
        val rendered = symbol_range_json(sym(1, 3, 9))
        val tail = rendered.substring(rendered.len() - 2, rendered.len())
        expect(tail).to_equal("}" + "}")
