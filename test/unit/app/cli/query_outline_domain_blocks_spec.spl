use std.spec
use std.common.spec.evidence.untyped_capture.{UntypedCapture, untyped_capture_to_canonical}
use std.common.spec.evidence.model.{EvidenceStatus, oracle_spec, check_exact}
use std.common.spec.evidence.evidence_comparator.{compare_evidence}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

describe "query outline domain blocks":
    it "exposes top-level domain blocks in the outline surface":
        val script = "p=/tmp/simple_query_outline_domain_probe.spl; printf 'use app.cli.query_outline.{OutlineOptions, parse_outline_source}\\nfn main():\\n    val source = \"schemaBlock\\\\nstyleBlock\\\\nval schema = 1\\\\n\"\\n    val outline = parse_outline_source(source, OutlineOptions(parent_for_types: true, include_import_symbols: false, include_fields: true, extract_binding_types: false))\\n    print(outline[0].name)\\n    print(outline[0].token_start)\\n    print(outline[0].token_end)\\n    print(outline[1].name)\\n    print(outline[1].token_start)\\n    print(outline[1].token_end)\\n    print(outline[2].name)\\n    print(outline[2].token_start)\\n    print(outline[2].token_end)\\n' > $p; SIMPLE_LIB=src bin/simple run $p"
        val (out, _err, code) = rt_process_run("/bin/sh", ["-c", script])

        expect(code).to_equal(0)
        expect(out).to_contain("schema" + "{}")
        expect(out).to_contain("0\n6")
        expect(out).to_contain("style" + "{}")
        expect(out).to_contain("0\n5")
        expect(out).to_contain("schema")
        expect(out).to_contain("4\n10")

        step("Verify the real captured outline stdout through the typed-evidence comparator")
        val capture = UntypedCapture(label: "query-outline-domain-blocks-stdout", raw_value: out, source_kind: "stdout")
        val evidence = untyped_capture_to_canonical(capture, "query_outline_domain_blocks_spec/stdout-capture")
        val comparison = compare_evidence(evidence, oracle_spec("query_outline_domain_blocks_spec/stdout-capture", [
            check_exact("value", "schema{}\n0\n6\nstyle{}\n0\n5\nschema\n4\n10\n")
        ]))
        expect(comparison.status).to_equal(EvidenceStatus.passed)
