"""
## Purpose and audience
Purpose: Pin the heuristic parser and module-resolution rules of the CLI
query engine (src/app/cli/query_engine.spl): fn/type extraction, return
types, parameters, imports, path resolution, symbol classification, word
boundaries, binding types, and output formats.
Audience: compiler and tooling engineers who maintain the query engine and
its LSP-facing output surfaces.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the parsing or resolution rule that regressed.
## Compatibility and limitations
Covers the pinned heuristic rules on representative declaration lines;
fixture lines are local to this spec. The product internals under test
(`_resolve_module_path`, `_is_word_char`) are private, so each scenario
mirrors the exact rule shape and pins it against the product's contract.
## Verification guidance and troubleshooting
Rerun with: ./src/compiler_rust/target/bootstrap/simple run <this file>.
A red scenario means a pinned parsing or path-resolution rule changed —
compare against the corresponding branch of `_resolve_module_path` or the
heuristic parser in src/app/cli/query_engine.spl before editing oracles.
Lifecycle: doc/01_research/app/lsp/simple_lsp_visibility_support.md ;
doc/03_plan/app/misc/default_native_runtime_shift_mcp_lsp_dependency_inventory.md ;
doc/04_architecture/app/lsp/simple_lsp_visibility_support.md ;
doc/05_design/app/lsp/simple_lsp_visibility_support.md
"""
# @manual_section: query engine heuristic parser

# Query Engine Specification
#
# **Feature IDs:** #QE-001 to #QE-007
# **Category:** Tooling
# **Difficulty:** 3/5
# **Status:** Implemented
#
# ## Overview
# Tests for the query engine heuristic parser and 7 engine functions.
# Validates symbol extraction, parsing logic, and module resolution.

use std.spec.step

# ============================================================================
# Test Group 1: Heuristic parser — fn extraction
# ============================================================================

describe "heuristic parser fn extraction":
    # @manual scenario evidence
    it "extracts fn name from function line":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): extracted fn name for the typed declaration
        step("Extract the symbol name from a typed fn declaration line")
        val line = "fn query_main() -> i64:"
        val after_fn = line.substring(3)
        val name = after_fn.split("(")[0]
        expect(name).to_equal("query_main")

    it "extracts extern fn name":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): extracted name for the extern fn declaration
        step("Extract the symbol name from an extern fn declaration line")
        val line = "extern fn rt_file_read_text(path: text) -> text"
        val rest = line.substring(10)
        val name = rest.split("(")[0]
        expect(name).to_equal("rt_file_read_text")

    it "extracts static fn name":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): extracted name for the static fn declaration
        step("Extract the symbol name from a static fn declaration line")
        val line = "static fn origin() -> Point:"
        val rest = line.substring(10)
        val name = rest.split("(")[0]
        expect(name).to_equal("origin")

    it "extracts me method name":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): extracted name for the me method declaration
        step("Extract the method name from a me method declaration line")
        val line = "me move(dx: i64):"
        val rest = line.substring(3)
        val name = rest.split("(")[0]
        expect(name).to_equal("move")

    it "extracts fn with no params":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): extracted name for the zero-param fn declaration
        step("Extract the symbol name from a zero-parameter fn line")
        val line = "fn hello():"
        val after_fn = line.substring(3)
        val name = after_fn.split("(")[0]
        expect(name).to_equal("hello")

    it "extracts fn with multiple params":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): extracted name for the two-param fn declaration
        step("Extract the symbol name from a multi-parameter fn line")
        val line = "fn add(a: i64, b: i64) -> i64:"
        val after_fn = line.substring(3)
        val name = after_fn.split("(")[0]
        expect(name).to_equal("add")

