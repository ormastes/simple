        step("Classify a fn declaration line by its kind prefix")
        val line = "fn query_main():"
        val is_fn = line.starts_with("fn ")
        expect(is_fn).to_equal(true)

    it "classifies extern fn":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): extern-kind classification verdict
        step("Classify an extern fn declaration line by its kind prefix")
        val line = "extern fn rt_read():"
        val is_extern = line.starts_with("extern fn ")
        expect(is_extern).to_equal(true)

    it "classifies val as constant":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): constant-kind classification verdict
        step("Classify a val declaration line as a constant")
        val line = "val MAX_SIZE = 100"
        val is_val = line.starts_with("val ")
        expect(is_val).to_equal(true)

    it "classifies var as variable":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): variable-kind classification verdict
        step("Classify a var declaration line as a variable")
        val line = "var count = 0"
        val is_var = line.starts_with("var ")
        expect(is_var).to_equal(true)

    it "classifies class":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): class-kind classification verdict
        step("Classify a class declaration line by its kind prefix")
        val line = "class Server:"
        val is_class = line.starts_with("class ")
        expect(is_class).to_equal(true)

    it "classifies struct":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): struct-kind classification verdict
        step("Classify a struct declaration line by its kind prefix")
        val line = "struct Point:"
        val is_struct = line.starts_with("struct ")
        expect(is_struct).to_equal(true)

    it "classifies trait":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): trait-kind classification verdict
        step("Classify a trait declaration line by its kind prefix")
        val line = "trait Comparable:"
        val is_trait = line.starts_with("trait ")
        expect(is_trait).to_equal(true)

# ============================================================================
# Test Group 8: Word boundary detection
# ============================================================================

describe "word boundary detection":
    it "finds word at start of line":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): word-start detection verdict
        step("Detect the symbol word at the start of a line")
        val line = "query_main()"
        val starts_with = line.starts_with("query_main")
        expect(starts_with).to_equal(true)

    it "does not match partial word":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): exact-match verdict for the partial-word line
        step("Reject a partial-word line as an exact symbol match")
        val line = "query_main_loop()"
        val exact = line == "query_main()"
        expect(exact).to_equal(false)

    it "classifies word chars including underscore":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): per-character word-char verdicts for abcABC09_
        step("Classify every character of a representative word-char set")
        # NOTE: mirrors the word-char rule of query_engine.spl `_is_word_char`:
        # letters, digits and underscore are word chars.
        val word_chars = "abcABC09_"
        var all_word = true
        for ch in word_chars:
            if not ((ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or
                    (ch >= "0" and ch <= "9") or ch == "_"):
                all_word = false
        expect(all_word).to_equal(true)  # oracle: every char of abcABC09_ is a letter, digit or underscore

    it "rejects space as a word char":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): word-char verdict for the space character
        step("Reject the space character as a word char")
        val ch = " "
        val is_word = ch >= "a" and ch <= "z"
        expect(is_word).to_equal(false)

    it "rejects dot as a word char":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): word-char verdict for the dot character
        step("Reject the dot character as a word char")
        val ch = "."
        val is_alpha = (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z")
        val is_digit = ch >= "0" and ch <= "9"
        val is_word = is_alpha or is_digit or ch == "_"
        expect(is_word).to_equal(false)

# ============================================================================
# Test Group 9: Binding type extraction
# ============================================================================

describe "binding type extraction":
    it "extracts type from typed val":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): typed-binding colon detection verdict
        step("Detect the type annotation colon on a typed val binding")
        val line = "val count: i64 = 0"
        val after_name = line.substring(10).trim()
        # after_name is ": i64 = 0" -> starts with ":"
        val has_colon = line.contains(":")
        expect(has_colon).to_equal(true)

    it "no type for untyped val":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): untyped-binding type detection verdict
        step("Confirm the absence of a type annotation on an untyped val")
        val line = "val count = 0"
        # Find colon after name — but the colon is only in the prefix
        val after_val = line.substring(4)
        val name_part = after_val.split(" ")[0]
        val has_type = name_part.contains(":")
        expect(has_type).to_equal(false)

    it "extracts type from typed var":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): typed var-binding colon detection verdict
        step("Detect the type annotation colon on a typed var binding")
        val line = "var items: [text] = []"
        val has_colon = line.contains(":")
        expect(has_colon).to_equal(true)

# ============================================================================
# Test Group 10: Engine function output patterns
# ============================================================================

describe "engine function output patterns":
    it "definition outputs file:line format":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): rendered definition output line
        step("Render a definition hit in the file:line format")
        val file = "src/app/cli/query.spl"
        val line = 42
        val kind = "fn"
        val sig = "fn query_main() -> i64:"
        val output = "{file}:{line}: [{kind}] {sig}"
        expect(output).to_contain("src/app/cli/query.spl:42")
        expect(output).to_contain("[fn]")

    it "hover outputs symbol info sections":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): hover output section names
        step("Render the hover output section headers")
        val sections = ["Symbol:", "Kind:", "Location:", "Signature:", "Parameters:"]
        expect(sections.len()).to_equal(5)  # oracle: hover renders exactly five info sections
        expect(sections).to_contain("Symbol:")

    it "completions outputs categorized sections":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): completions output category headers
        step("Render the completions output category headers")
        val sections = ["--- Local ---", "--- Imported ---", "--- Keywords ---"]
        expect(sections.len()).to_equal(3)  # oracle: completions renders exactly three category sections

    it "document symbols output format":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): rendered document-symbols output line
        step("Render a document symbol in the name:kind:line format")
        val name = "query_main"
        val kind = "fn"
        val line = 27
        val output = "{name}:{kind}:{line}"
        expect(output).to_equal("query_main:fn:27")

    it "signature help outputs function details":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): signature-help output field names
        step("Render the signature-help output field headers")
        val fields = ["Function:", "Parameters:", "Returns:", "Active parameter:"]
        expect(fields.len()).to_equal(4)  # oracle: signature help renders exactly four detail fields

# ============================================================================
# Helpers
# ============================================================================

fn _find_arrow_pos(s: text) -> i64:
    var i = 0
    for ch in s:
        if i < s.len() - 1:
            val two = s.substring(i, i + 2)
            if two == "->":
                return i
        i = i + 1
    -1

fn _extract_between_parens(s: text) -> text:
    val open_idx = _find_char_pos(s, "(")
    val close_idx = _find_char_pos(s, ")")
    if open_idx < 0 or close_idx < 0:
        return ""
    s.substring(open_idx + 1, close_idx)

fn _find_char_pos(s: text, target: text) -> i64:
    var i = 0
    for ch in s:
        if s.substring(i, i + 1) == target:
            return i
        i = i + 1
    -1
