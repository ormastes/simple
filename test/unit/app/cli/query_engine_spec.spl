# ============================================================================
# Test Group 3: Return type extraction
# ============================================================================

describe "return type extraction":
    it "extracts simple return type":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): extracted return type for the text signature
        step("Extract the return type from an arrow return annotation")
        val line = "fn get_name() -> text:"
        val arrow_idx = _find_arrow_pos(line)
        val after_arrow = line.substring(arrow_idx + 2).trim()
        val ret_type = after_arrow.split(":")[0].trim()
        expect(ret_type).to_equal("text")

    it "extracts i64 return type":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): extracted return type for the i64 signature
        step("Extract the i64 return type from an arrow return annotation")
        val line = "fn count() -> i64:"
        val arrow_idx = _find_arrow_pos(line)
        val after_arrow = line.substring(arrow_idx + 2).trim()
        val ret_type = after_arrow.split(":")[0].trim()
        expect(ret_type).to_equal("i64")

    it "extracts bool return type":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): extracted return type for the bool signature
        step("Extract the bool return type from an arrow return annotation")
        val line = "fn is_valid() -> bool:"
        val arrow_idx = _find_arrow_pos(line)
        val after_arrow = line.substring(arrow_idx + 2).trim()
        val ret_type = after_arrow.split(":")[0].trim()
        expect(ret_type).to_equal("bool")

    it "returns empty for no return type":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): arrow detection verdict for the unit signature
        step("Detect the absence of an arrow return annotation")
        val line = "fn do_something():"
        val has_arrow = line.contains("->")
        expect(has_arrow).to_equal(false)

    it "extracts array return type":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): arrow detection verdict for the array signature
        step("Detect the arrow of an array return annotation")
        val line = "fn get_items() -> [text]:"
        val has_arrow = line.contains("->")
        expect(has_arrow).to_equal(true)

# ============================================================================
# Test Group 4: Parameter extraction
# ============================================================================

describe "parameter extraction":
    it "extracts single param":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): parameter text for the single-param signature
        step("Extract the parameter text from a single-parameter signature")
        val line = "fn greet(name: text):"
        val params = _extract_between_parens(line)
        expect(params).to_equal("name: text")

    it "extracts multiple params":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): parameter text for the two-param signature
        step("Extract the parameter text from a two-parameter signature")
        val line = "fn add(a: i64, b: i64) -> i64:"
        val params = _extract_between_parens(line)
        expect(params).to_equal("a: i64, b: i64")

    it "extracts empty params":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): parameter text for the zero-param signature
        step("Extract the parameter text from a zero-parameter signature")
        val line = "fn hello() -> text:"
        val params = _extract_between_parens(line)
        expect(params).to_equal("")

    it "extracts params with default values":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): parameter text for the host/port signature
        step("Extract the parameter text from a host/port signature")
        val line = "fn connect(host: text, port: i64):"
        val params = _extract_between_parens(line)
        expect(params).to_equal("host: text, port: i64")

# ============================================================================
# Test Group 5: Import parsing
# ============================================================================

describe "import parsing":
    it "parses simple use statement":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): module path parsed from the use statement
        step("Parse the module path from a simple use statement")
        val line = "use std.spec"
        val rest = line.substring(4).trim()
        expect(rest).to_equal("std.spec")

    it "parses use with braces":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): use-prefix detection verdict for the braced import
        step("Detect the use prefix on a braced import statement")
        val prefix = "use app.cli.query_engine."
        val items = "hover_fn, completions_fn"
        val line = prefix + items
        val has_prefix = line.starts_with("use ")
        expect(has_prefix).to_equal(true)

    it "extracts module path from braced import":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): module path stripped of its trailing dot
        step("Strip the trailing dot from a braced import module path")
        val module_part = "app.cli.query_engine."
        var mod_path = module_part
        if mod_path.ends_with("."):
            mod_path = mod_path.substring(0, mod_path.len() - 1)
        expect(mod_path).to_equal("app.cli.query_engine")

    it "extracts items from braced import":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): imported item names split from the braced list
        step("Split and trim the item names of a braced import list")
        val items_str = "hover_fn, completions_fn"
        val items = items_str.split(",")
        expect(items.len()).to_equal(2)  # oracle: the braced list names exactly two imported items
        expect(items[0].trim()).to_equal("hover_fn")
        expect(items[1].trim()).to_equal("completions_fn")

    it "parses import statement":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): module path parsed from the import statement
        step("Parse the module path from an import statement")
        val line = "import std.spec"
        val rest = line.substring(7).trim()
        expect(rest).to_equal("std.spec")

# ============================================================================
# Test Group 6: Module path resolution
# ============================================================================

describe "module path resolution":
    it "converts std to lib prefix":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): resolved path for the std-prefixed module
        step("Rewrite a std-prefixed module path to its lib prefix")
        var path = "std.text"
        if path.starts_with("std."):
            path = "lib." + path.substring(4)
        expect(path).to_equal("lib.text")

    it "preserves app prefix":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): prefix verdict for the app-prefixed module
        step("Detect the app prefix on an app-prefixed module path")
        val path = "app.cli.query"
        val starts_with_app = path.starts_with("app.")
        expect(starts_with_app).to_equal(true)

    it "preserves compiler prefix":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): prefix verdict for the compiler-prefixed module
        step("Detect the compiler prefix on a compiler-prefixed module path")
        val path = "compiler.frontend.core"
        val starts_with_compiler = path.starts_with("compiler.")
        expect(starts_with_compiler).to_equal(true)

    it "converts dots to slashes":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): slash path built from the dotted module path
        step("Convert a dotted module path to its slash path under src/")
        val mod_path = "lib.common.text"
        val parts = mod_path.split(".")
        val file_path = "src/" + parts.join("/")
        expect(file_path).to_equal("src/lib/common/text")

    it "tries mod.spl first":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): mod.spl candidate path for the module directory
        step("Build the mod.spl candidate path for a module directory")
        val base = "src/lib/common/text"
        val mod_file = base + "/mod.spl"
        expect(mod_file).to_equal("src/lib/common/text/mod.spl")

    it "falls back to direct .spl":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): direct .spl candidate path for the module
        step("Build the direct .spl candidate path for a module")
        val base = "src/app/cli/query_engine"
        val direct = base + ".spl"
        expect(direct).to_equal("src/app/cli/query_engine.spl")

    it "maps bare type imports to default type domain":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): type path for the bare I64 import
        step("Map a bare type import into the default type domain")
        val mod_path = "I64"
        val type_base = "src/type/simple_lang/" + mod_path
        val type_direct = type_base + ".spl"
        expect(type_direct).to_equal("src/type/simple_lang/I64.spl")

    it "maps owned-domain type imports to underscore directory":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): type path for the owned-domain import
        step("Map an owned-domain type import into its underscore directory")
        # NOTE: the mirror below reproduces query_engine.spl:345 exactly —
        # "src/type/" + owner domain with dashes replaced by underscores.
        val mod_path = "simple-lang/I64"
        val slash_parts = mod_path.split("/")
        val type_base = "src/type/" + slash_parts[0].replace("-", "_") + "/" + slash_parts[1..].join("/")
        val type_direct = type_base + ".spl"
        expect(type_direct).to_equal("src/type/simple_lang/I64.spl")

