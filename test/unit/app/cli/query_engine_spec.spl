        # @capture(statistics): extracted struct name
        step("Extract the type name from a struct declaration line")
        val line = "struct Position:"
        val name = line.substring(7).split(":")[0]
        expect(name).to_equal("Position")

    it "extracts enum name":
        # @req: REQ-APP-CLI-QUERY
        # @capture(statistics): extracted enum name
        step("Extract the type name from an enum declaration line")
        val line = "enum TokenKind:"
        val name = line.substring(5).split(":")[0]
