"""Prove compiler diagnostic output is consumed without a retained line array."""

use app.cli.query_diagnostics.{
    _collect_check_output_diagnostics_json_clean,
    _count_check_output_diagnostics_clean}
use std.io_runtime.file_read
use std.spec.step

describe "query check output line cursor":
    it "preserves admission order trimming and terminal line behavior":
        step("Consume empty CRLF Unicode duplicate and trailing lines in order")
        val output =
            "\n  fixture.spl:2:3: error: café  \r\n" +
            "banner\n" +
            "fixture.spl:4:5: warning: 日本語\n" +
            "fixture.spl:4:5: warning: 日本語\n"
        val diagnostics = _collect_check_output_diagnostics_json_clean(
            "fixture.spl", output)
        expect(diagnostics).to_equal([
            "{\"severity\":1,\"code\":\"E0001\",\"message\":\"café\",\"line\":2,\"col\":3,\"end_line\":2,\"end_col\":3,\"tags\":[],\"source\":\"simple\"}",
            "{\"severity\":2,\"code\":\"E0001\",\"message\":\"日本語\",\"line\":4,\"col\":5,\"end_line\":4,\"end_col\":5,\"tags\":[],\"source\":\"simple\"}",
            "{\"severity\":2,\"code\":\"E0001\",\"message\":\"日本語\",\"line\":4,\"col\":5,\"end_line\":4,\"end_col\":5,\"tags\":[],\"source\":\"simple\"}"])
        expect(_count_check_output_diagnostics_clean(
            "fixture.spl", output)).to_equal(3)
        expect(_collect_check_output_diagnostics_json_clean(
            "fixture.spl", "").len()).to_equal(0)
        expect(_count_check_output_diagnostics_clean(
            "fixture.spl", "\n\n")).to_equal(0)
        expect(_collect_check_output_diagnostics_json_clean(
            "fixture.spl", "other.spl:1:1: error: no").len()).to_equal(0)

    it "uses bounded newline cursors without whole-output split arrays":
        step("Pin monotonic progress and release each transient line")
        val source = file_read("src/app/cli/query_diagnostics.spl")
        val count_start = source.index_of(
            "fn _count_check_output_diagnostics_clean(")
        val count_end = source.index_of(
            "fn _collect_check_output_diagnostics_json(", count_start)
        expect(count_start).to_be_greater_than(-1)
        expect(count_end).to_be_greater_than(count_start)
        val count = source.slice(count_start, count_end)
        expect(count.split(
            "_check_output_line_end(clean_output, line_start)").len()).to_equal(2)
        expect(count).to_contain("_check_output_line_end(clean_output, line_start)")
        expect(count).to_contain("line_start = line_end + 1")
        expect(count).to_contain("if line_end == clean_output.len():")
        expect(count).not.to_contain("clean_output.split(")
        expect(count).not.to_contain("val lines =")
        expect(count).not.to_contain("_parse_check_output_line_json")

        val collect_start = source.index_of(
            "fn _collect_check_output_diagnostics_json_clean(")
        val collect_end = source.index_of(
            "fn _extract_query_check_diagnostics(", collect_start)
        expect(collect_start).to_be_greater_than(-1)
        expect(collect_end).to_be_greater_than(collect_start)
        val collect = source.slice(collect_start, collect_end)
        expect(collect.split(
            "_check_output_line_end(clean_output, line_start)").len()).to_equal(2)
        expect(collect).to_contain("_check_output_line_end(clean_output, line_start)")
        expect(collect).to_contain("line_start = line_end + 1")
        expect(collect).to_contain("if line_end == clean_output.len():")
        expect(collect).not.to_contain("clean_output.split(")
        expect(collect).not.to_contain("val lines =")
        expect(collect.split(
            "_parse_check_output_line_json(file, line)").len()).to_equal(2)

        val helper_start = source.index_of("fn _check_output_line_end(")
        val helper_end = source.index_of(
            "fn _count_check_output_diagnostics_clean(", helper_start)
        val helper = source.slice(helper_start, helper_end)
        expect(helper).to_contain("value.byte_at(i) != 10")
        expect(helper).to_contain("i = i + 1")
        expect(helper).not.to_contain("substring(")
