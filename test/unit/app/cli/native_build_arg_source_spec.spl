"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/app/cli/native_build_arg_source_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.io_runtime.{file_read}
use std.spec.{step}

describe "native-build CLI arg source regressions":
    it "routes omitted --backend through the default Simple LLVM backend":
        # @req: REQ-UNIT-APP-001
        step("Verify: routes omitted --backend through the default Simple LLVM backend")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = file_read("src/app/cli/_CliMain/main_and_help.spl")
        expect(source).to_contain("not saw_backend")

    it "does not treat malformed --backend as omitted":
        # @req: REQ-UNIT-APP-002
        step("Verify: does not treat malformed --backend as omitted")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = file_read("src/app/cli/_CliMain/main_and_help.spl")
        expect(source).to_contain("fn native_build_backend_supported(backend: text) -> bool:")
        expect(source).to_contain("if str_eq(arg, \"--backend\"):")
        expect(source).to_contain("return native_build_backend_supported(args[i + 1])")
        expect(source).to_contain("return false")
        expect(source.contains("arg == \"--backend\"")).to_equal(false)
        expect(source.contains("backend == \"llvm")).to_equal(false)

    it "matches native-build command exactly":
        # @req: REQ-UNIT-APP-003
        step("Verify: matches native-build command exactly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = file_read("src/app/cli/_CliMain/main_and_help.spl")
        expect(source).to_contain("str_eq(args[0], \"native-build\")")
        expect(source.contains("args[0].starts_with(\"native-build\")")).to_equal(false)

    it "keeps native_build_main option checks off raw string equality":
        # @req: REQ-UNIT-APP-004
        step("Verify: keeps native_build_main option checks off raw string equality")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = file_read("src/app/cli/native_build_main.spl")
        expect(source).to_contain("native_build_text_eq(raw_args[i], \"native-build\")")
        expect(source).to_contain("native_build_text_eq(args[i], \"--timeout\")")
        expect(source).to_contain("native_build_text_eq(a, \"-o\")")
        expect(source).to_contain("native_build_text_eq(a, \"--output\")")
        expect(source).to_contain("fn native_build_has_help(args: [text]) -> bool:")
        expect(source.contains("raw_args[i] == \"native-build\"")).to_equal(false)
        expect(source.contains("args[i] == \"--timeout\"")).to_equal(false)
        expect(source.contains("a == \"-o\"")).to_equal(false)
        expect(source.contains("args.contains(\"-h\")")).to_equal(false)

    it "matches only --entry and --entry=value for native-build entry parsing":
        # @req: REQ-UNIT-APP-005
        step("Verify: matches only --entry and --entry=value for native-build entry parsing")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = file_read("src/app/io/_CliCompile/compile_targets.spl")
        expect(source).to_contain("arg == \"--entry\" or arg.starts_with(\"--entry=\")")
        expect(source.contains("elif a.starts_with(\"--entry\")")).to_equal(false)
