"""
## Purpose and audience

# CLI Query LSP Subcommands Specification

**Feature IDs:** #500-510
**Category:** Tooling
**Status:** Implemented

## Overview
Tests for the 10 new `bin/simple query` CLI subcommands.
Validates argument parsing, command construction, and output format.

This specification is maintained for compiler and library engineers reviewing UNIT-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/app/cli/query_lsp_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
extern fn rt_file_read_text(path: text) -> text

describe "query CLI subcommand dispatch":
    """
    ## Subcommand Dispatch
    Validates all 10 new subcommands are recognized.
    """
    it "recognizes signature-help":
        # @req: REQ-UNIT-APP-001
        step("Verify: recognizes signature-help")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val subcmd = "signature-help"
        val valid_subcmds = ["definition", "references", "hover", "completions", "type-at", "signature-help", "rename", "code-actions", "workspace-symbols", "call-hierarchy", "type-hierarchy", "semantic-tokens", "inlay-hints", "selection-range", "document-formatting"]
        expect(valid_subcmds).to_contain(subcmd)

    it "recognizes rename":
        # @req: REQ-UNIT-APP-002
        step("Verify: recognizes rename")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val subcmd = "rename"
        val valid_subcmds = ["signature-help", "rename", "code-actions", "workspace-symbols", "call-hierarchy", "type-hierarchy", "semantic-tokens", "inlay-hints", "selection-range", "document-formatting"]
        expect(valid_subcmds).to_contain(subcmd)

    it "recognizes all 15 subcommands":
        # @req: REQ-UNIT-APP-003
        step("Verify: recognizes all 15 subcommands")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val all_subcmds = ["definition", "references", "hover", "completions", "type-at", "signature-help", "rename", "code-actions", "workspace-symbols", "call-hierarchy", "type-hierarchy", "semantic-tokens", "inlay-hints", "selection-range", "document-formatting"]
        expect(all_subcmds.len()).to_equal(15)  # oracle: expected value 15 is the behavior asserted by this regression spec

describe "query argument parsing":
    """
    ## Argument Parsing
    Different subcommands have different argument patterns.
    """
    it "standard tools parse file line column":
        # @req: REQ-UNIT-APP-004
        step("Verify: standard tools parse file line column")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val args = ["signature-help", "src/test.spl", "42", "10"]
        expect(args[0]).to_equal("signature-help")
        expect(args[1]).to_equal("src/test.spl")
        expect(args[2]).to_equal("42")
        expect(args[3]).to_equal("10")

    it "workspace-symbols parses query flag":
        # @req: REQ-UNIT-APP-005
        step("Verify: workspace-symbols parses query flag")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val args = ["workspace-symbols", "--query", "parse", "--kind", "fn"]
        expect(args[0]).to_equal("workspace-symbols")
        expect(args[1]).to_equal("--query")
        expect(args[2]).to_equal("parse")

    it "rename parses new-name flag":
        # @req: REQ-UNIT-APP-006
        step("Verify: rename parses new-name flag")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val args = ["rename", "src/test.spl", "10", "--new-name", "better"]
        expect(args[0]).to_equal("rename")
        expect(args[3]).to_equal("--new-name")
        expect(args[4]).to_equal("better")

    it "call-hierarchy parses direction flag":
        # @req: REQ-UNIT-APP-007
        step("Verify: call-hierarchy parses direction flag")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val args = ["call-hierarchy", "src/test.spl", "10", "--direction", "incoming"]
        expect(args[3]).to_equal("--direction")
        expect(args[4]).to_equal("incoming")

    it "semantic-tokens parses line range flags":
        # @req: REQ-UNIT-APP-008
        step("Verify: semantic-tokens parses line range flags")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val args = ["semantic-tokens", "src/test.spl", "--start-line", "10", "--end-line", "50"]
        expect(args[2]).to_equal("--start-line")
        expect(args[4]).to_equal("--end-line")

    it "semantic token range flags use guarded integer parsing":
        # @req: REQ-UNIT-APP-009
        step("Verify: semantic token range flags use guarded integer parsing")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val query_source = rt_file_read_text("src/app/cli/query.spl") ?? ""
        val visibility_source = rt_file_read_text("src/app/cli/_QueryVisibility/query_commands.spl") ?? ""

        expect(query_source).to_contain("query_nonnegative_int_or_zero(start_line_str)")
        expect(query_source).to_contain("query_nonnegative_int_or_zero(end_line_str)")
        expect(visibility_source).to_contain("query_visibility_nonnegative_int_or_zero(args[j + 1])")
        expect(query_source.contains("start_line_str.to_int()")).to_equal(false)
        expect(query_source.contains("end_line_str.to_int()")).to_equal(false)

    it "position arguments use guarded integer parsing":
        # @req: REQ-UNIT-APP-010
        step("Verify: position arguments use guarded integer parsing")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val query_source = rt_file_read_text("src/app/cli/query.spl") ?? ""
        val rich_source = rt_file_read_text("src/app/cli/query_rich_common.spl") ?? ""

        expect(query_source).to_contain("val line_num = query_nonnegative_int_or_zero(cmd_args[2])")
        expect(query_source).to_contain("col = query_nonnegative_int_or_zero(cmd_args[3])")
        expect(rich_source).to_contain("query_rich_nonnegative_int_or_zero(line_str)")
        expect(rich_source).to_contain("query_rich_nonnegative_int_or_zero(col_str)")
        expect(query_source.contains("cmd_args[2].to_int()")).to_equal(false)
        expect(query_source.contains("cmd_args[3].to_int()")).to_equal(false)

    it "document-formatting takes only file":
        # @req: REQ-UNIT-APP-011
        step("Verify: document-formatting takes only file")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val args = ["document-formatting", "src/test.spl"]
        expect(args.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

describe "extract_symbol_at function":
    """
    ## Symbol Extraction
    Tests the helper that extracts symbol name at file:line:col position.
    """
    it "extracts fn name from function declaration":
        # @req: REQ-UNIT-APP-012
        step("Verify: extracts fn name from function declaration")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val line = "fn query_main() -> i64:"
        # Extract word after "fn " using split on "("
        val after_fn = line.substring(3)
        val name = after_fn.split("(")[0]
        expect(name).to_equal("query_main")

    it "extracts class name from class declaration":
        # @req: REQ-UNIT-APP-013
        step("Verify: extracts class name from class declaration")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val line = "class LazySession:"
        # Extract word after "class " using split on ":"
        val after_class = line.substring(6)
        val name = after_class.split(":")[0]
        expect(name).to_equal("LazySession")

    it "extracts struct name":
        # @req: REQ-UNIT-APP-014
        step("Verify: extracts struct name")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val line = "struct Position:"
        # Extract word after "struct " using split on ":"
        val after_struct = line.substring(7)
        val name = after_struct.split(":")[0]
        expect(name).to_equal("Position")

    it "extracts val name":
        # @req: REQ-UNIT-APP-015
        step("Verify: extracts val name")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val line = "val SERVER_NAME = \"simple-mcp\""
        # Extract word after "val " using split on " "
        val after_val = line.substring(4)
        val name = after_val.split(" ")[0]
        expect(name).to_equal("SERVER_NAME")

describe "query command construction":
    """
    ## Command Construction
    Tests that CLI commands are built correctly for shell execution.
    """
    it "signature-help uses correct subcommand":
        # @req: REQ-UNIT-APP-016
        step("Verify: signature-help uses correct subcommand")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cmd = "bin/simple query signature-help src/test.spl 10"
        expect(cmd).to_contain("query signature-help")

    it "rename includes new-name flag":
        # @req: REQ-UNIT-APP-017
        step("Verify: rename includes new-name flag")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cmd = "bin/simple query rename src/test.spl 10 --new-name x"
        expect(cmd).to_contain("--new-name x")

    it "workspace-symbols uses query flag":
        # @req: REQ-UNIT-APP-018
        step("Verify: workspace-symbols uses query flag")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cmd = "bin/simple query workspace-symbols --query parse"
        expect(cmd).to_contain("--query parse")

    it "semantic-tokens uses range flags":
        # @req: REQ-UNIT-APP-019
        step("Verify: semantic-tokens uses range flags")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cmd = "bin/simple query semantic-tokens src/test.spl --start-line 1 --end-line 50"
        expect(cmd).to_contain("--start-line 1")
        expect(cmd).to_contain("--end-line 50")

