# Y1 `Any` inventory — classifier unit spec (2026-08-21).
#
# Plan: doc/01_research/compiler/hardening/simple_hardening_plan_2026-08-21.md
#       §8.7, §15 Phase 0 census, §20.5 row Y1.
#
# Every case below is a REAL shape lifted from the tree, not an invented one,
# so a green run means the classifier agrees with the source it will be run on.

use app.any_audit.classify (classify_occurrences, strip_code)
use app.any_audit.scan (scan_source, class_totals)

describe "any_audit: strip_code":
    it "blanks a double-quoted span so a string cannot report an Any":
        expect(classify_occurrences("val s: text = \"x: Any\"").len()).to_equal(0)

    it "drops an unquoted trailing comment":
        expect(classify_occurrences("val n = 1  # d: Any").len()).to_equal(0)

    it "preserves column positions when blanking":
        expect(strip_code("ab\"cd\"e".to_text()).len()).to_equal(7)

describe "any_audit: classification by kind":
    it "classifies a parameter annotation as param":
        expect(classify_occurrences("fn f(x: Any) -> i64:")).to_equal(["param"])

    it "classifies a return annotation as ret":
        expect(classify_occurrences("fn g(n: i64) -> Any:")).to_equal(["ret"])

    it "classifies a struct field annotation as field":
        expect(classify_occurrences("    payload: Any")).to_equal(["field"])

    it "classifies a local annotation as local":
        expect(classify_occurrences("    val v: Any = nil")).to_equal(["local"])

    it "classifies a Dict value position as generic":
        expect(classify_occurrences("    table: Dict<text, Any>")).to_equal(["generic"])

    it "classifies an array element position as generic":
        expect(classify_occurrences("    items: [Any]")).to_equal(["generic"])

    it "classifies a dict-literal type value position as generic":
        expect(classify_occurrences("    specialized_functions: {text: Any}")).to_equal(["generic"])

    it "classifies a cast as cast":
        expect(classify_occurrences("    val e = v as Any")).to_equal(["cast"])

    it "classifies an is-test as match":
        expect(classify_occurrences("    if v is Any:")).to_equal(["match"])

    it "reports every occurrence on a multi-Any parameter list":
        expect(classify_occurrences("me call(a: Any = nil, b: Any = nil) -> Any:").len()).to_equal(3)

describe "any_audit: things that are NOT an Any type":
    it "ignores a qualified enum variant":
        expect(classify_occurrences("    return Ok(VersionConstraint.Any)").len()).to_equal(0)

    it "ignores a bare enum variant declaration line":
        expect(classify_occurrences("    Any").len()).to_equal(0)

    it "ignores English prose that happens to start with Any":
        expect(classify_occurrences("x = 1  # Any other key is a no-op").len()).to_equal(0)

    it "ignores an identifier that merely contains Any":
        expect(classify_occurrences("val AnyKind = 1").len()).to_equal(0)

    it "ignores a longer identifier ending in Any":
        expect(classify_occurrences("fn f(x: NotAny) -> i64:").len()).to_equal(0)

describe "any_audit: scan_source over a whole file":
    it "skips a docstring block containing prose Any":
        val src = "fn f():\n    \"\"\"Any other value is fine.\"\"\"\n    val v: Any = nil\n"
        expect(scan_source("x.spl", src).total).to_equal(1)

    it "records the 1-based line number of a site":
        val src = "fn f():\n    val v: Any = nil\n"
        expect(scan_source("x.spl", src).sites[0].line).to_equal(2)

    it "reports zero for a file with no Any at all":
        expect(scan_source("x.spl", "fn f() -> i64:\n    1\n").total).to_equal(0)

    it "totals classes in ANY_CLASSES order":
        val src = "fn f(a: Any) -> Any:\n    val v: Any = nil\n"
        val t = class_totals(scan_source("x.spl", src).sites)
        expect(t[0]).to_equal(1)
        expect(t[1]).to_equal(1)
        expect(t[3]).to_equal(1)
