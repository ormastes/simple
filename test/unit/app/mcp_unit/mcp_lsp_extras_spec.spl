describe "MCP tool registration for new LSP tools":
    it "total tool count is 63":
        # @req: REQ-UNIT-APP-034
        step("Verify: total tool count is 63")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val tool_count = 63
        expect(tool_count).to_equal(63)  # oracle: expected value 63 is the behavior asserted by this regression spec

    it "all 4 new tools registered in protocol":
        # @req: REQ-UNIT-APP-035
        step("Verify: all 4 new tools registered in protocol")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val new_tools = ["simple_document_highlight", "simple_type_definition", "simple_implementation", "simple_folding_range"]
        expect(new_tools.len()).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

    it "all new tools are read-only":
        # @req: REQ-UNIT-APP-036
        step("Verify: all new tools are read-only")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val read_only = true
        expect(read_only).to_equal(true)

    it "document-highlight schema has file+line+column":
        # @req: REQ-UNIT-APP-037
        step("Verify: document-highlight schema has file+line+column")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val params = ["file", "line", "column"]
        expect(params).to_contain("file")
        expect(params).to_contain("line")
        expect(params).to_contain("column")

    it "folding-range schema has file only":
        # @req: REQ-UNIT-APP-038
        step("Verify: folding-range schema has file only")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val params = ["file"]
        expect(params.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(params[0]).to_equal("file")

    it "dispatch entries added for all 4 tools":
        # @req: REQ-UNIT-APP-039
        step("Verify: dispatch entries added for all 4 tools")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val tool_names = ["simple_document_highlight", "simple_type_definition", "simple_implementation", "simple_folding_range"]
        expect(tool_names.len()).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

# ============================================================================
# Test Group 6: Cross-tool consistency
# ============================================================================

describe "LSP extras cross-tool consistency":
    it "all position tools accept file and line":
        # @req: REQ-UNIT-APP-040
        step("Verify: all position tools accept file and line")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val position_tools = ["document-highlight", "type-definition", "implementation"]
        expect(position_tools.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    it "folding-range is file-only":
        # @req: REQ-UNIT-APP-041
        step("Verify: folding-range is file-only")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val file_only = ["folding-range"]
        expect(file_only.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "all tools use 30 second timeout":
        # @req: REQ-UNIT-APP-042
        step("Verify: all tools use 30 second timeout")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val timeout = "timeout 30"
        val cmd1 = "timeout 30 bin/simple query document-highlight f.spl 1"
        val cmd2 = "timeout 30 bin/simple query folding-range f.spl"
        expect(cmd1).to_start_with(timeout)
        expect(cmd2).to_start_with(timeout)

    it "all tools use bin/simple query prefix":
        # @req: REQ-UNIT-APP-043
        step("Verify: all tools use bin/simple query prefix")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val prefix = "bin/simple query"
        val cmd = "timeout 30 bin/simple query document-highlight test.spl 1"
        expect(cmd).to_contain(prefix)
