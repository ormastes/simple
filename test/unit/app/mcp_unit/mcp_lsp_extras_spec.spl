"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/app/mcp_unit/mcp_lsp_extras_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# MCP LSP Extras Tools Specification
#
# **Feature IDs:** #MCP-LSP-011 to #MCP-LSP-014
# **Category:** Tooling
# **Difficulty:** 3/5
# **Status:** Implemented
#
# ## Overview
# Tests for 4 new MCP LSP tools: document-highlight, type-definition,
# implementation, folding-range. Validates parameter handling, command
# construction, and output format.


# ============================================================================
# Test Group 1: simple_document_highlight tool
# ============================================================================

describe "simple_document_highlight tool":
    it "requires file parameter":
        # @req: REQ-UNIT-APP-001
        step("Verify: requires file parameter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val file = ""
        val is_missing = file == ""
        expect(is_missing).to_equal(true)

    it "requires line parameter":
        # @req: REQ-UNIT-APP-002
        step("Verify: requires line parameter")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val line = ""
        val is_missing = line == ""
        expect(is_missing).to_equal(true)

    it "builds correct command":
        # @req: REQ-UNIT-APP-003
        step("Verify: builds correct command")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val file = "src/app/cli/query.spl"
        val line = "42"
        var cmd = "timeout 30 bin/simple query document-highlight " + file + " " + line
        cmd = cmd + " 2>&1"
        expect(cmd).to_contain("query document-highlight")
        expect(cmd).to_contain(file)

    it "appends column when provided":
        # @req: REQ-UNIT-APP-004
        step("Verify: appends column when provided")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val file = "test.spl"
        val line = "10"
        val column = "5"
        var cmd = "timeout 30 bin/simple query document-highlight " + file + " " + line
        cmd = cmd + " " + column
        expect(cmd).to_contain("10 5")

    it "output format is line:col:length:kind":
        # @req: REQ-UNIT-APP-005
        step("Verify: output format is line:col:length:kind")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val output = "5:10:8:Read"
        val parts = output.split(":")
        expect(parts.len()).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
        expect(parts[3]).to_equal("Read")

    it "kind is Read or Write":
        # @req: REQ-UNIT-APP-006
        step("Verify: kind is Read or Write")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val kinds = ["Read", "Write"]
        expect(kinds).to_contain("Read")
        expect(kinds).to_contain("Write")

    it "classifies declaration as Write":
        # @req: REQ-UNIT-APP-007
        step("Verify: classifies declaration as Write")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val line = "val count = 0"
        val is_decl = line.starts_with("val ") or line.starts_with("var ")
        expect(is_decl).to_equal(true)

    it "classifies usage as Read":
        # @req: REQ-UNIT-APP-008
        step("Verify: classifies usage as Read")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val line = "print count"
        val is_decl = line.starts_with("val ") or line.starts_with("var ")
        expect(is_decl).to_equal(false)

    it "classifies assignment LHS as Write":
        # @req: REQ-UNIT-APP-009
        step("Verify: classifies assignment LHS as Write")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val line = "count = count + 1"
        # count on LHS of = is Write, count on RHS is Read
        val has_assign = line.contains(" = ")
        expect(has_assign).to_equal(true)

