# @req: REQ-APP-MCPUNIT-004
# MCP Logging Specification
# Feature: MCP Log Level and Emission
# Category: MCP, Logging
# Status: Complete

use std.nogc_async_mut.mcp.helpers.{log_level_to_int, make_log_notification}

use std.spec.step
describe "MCP Log Level Mapping":
    slow_it "maps debug to 0":
        # @req: REQ-APP-MCPUNIT-004
        step("Verify: maps debug to 0")
        expect(log_level_to_int("debug")).to_equal(0) # oracle: pinned expected value documenting the asserted outcome

    slow_it "maps info to 1":
        # @req: REQ-APP-MCPUNIT-004
        step("Verify: maps info to 1")
        expect(log_level_to_int("info")).to_equal(1) # oracle: pinned expected value documenting the asserted outcome

    slow_it "maps notice to 2":
        # @req: REQ-APP-MCPUNIT-004
        step("Verify: maps notice to 2")
        expect(log_level_to_int("notice")).to_equal(2) # oracle: pinned expected value documenting the asserted outcome

    slow_it "maps warning to 3":
        # @req: REQ-APP-MCPUNIT-004
        step("Verify: maps warning to 3")
        expect(log_level_to_int("warning")).to_equal(3) # oracle: pinned expected value documenting the asserted outcome

    slow_it "maps error to 4":
        # @req: REQ-APP-MCPUNIT-004
        step("Verify: maps error to 4")
        expect(log_level_to_int("error")).to_equal(4) # oracle: pinned expected value documenting the asserted outcome

    slow_it "maps critical to 5":
        # @req: REQ-APP-MCPUNIT-004
        step("Verify: maps critical to 5")
        expect(log_level_to_int("critical")).to_equal(5) # oracle: pinned expected value documenting the asserted outcome

    slow_it "maps alert to 6":
        # @req: REQ-APP-MCPUNIT-004
        step("Verify: maps alert to 6")
        expect(log_level_to_int("alert")).to_equal(6) # oracle: pinned expected value documenting the asserted outcome

    slow_it "maps emergency to 7":
        # @req: REQ-APP-MCPUNIT-004
        step("Verify: maps emergency to 7")
        expect(log_level_to_int("emergency")).to_equal(7) # oracle: pinned expected value documenting the asserted outcome

    slow_it "returns -1 for unknown level":
        # @req: REQ-APP-MCPUNIT-004
        step("Verify: returns -1 for unknown level")
        expect(log_level_to_int("unknown")).to_equal(-1) # oracle: pinned expected value documenting the asserted outcome

describe "MCP Log Notification Building":
    slow_it "builds log notification with all fields":
        # @req: REQ-APP-MCPUNIT-004
        step("Verify: builds log notification with all fields")
        val notif = make_log_notification("info", "Test message", "mcp.server")
        expect(notif.contains("\"level\":\"info\"")).to_equal(true)
        expect(notif.contains("Test message")).to_equal(true)
        expect(notif.contains("\"logger\":\"mcp.server\"")).to_equal(true)
        expect(notif.contains("notifications/message")).to_equal(true)

    slow_it "builds log notification without logger":
        # @req: REQ-APP-MCPUNIT-004
        step("Verify: builds log notification without logger")
        val notif = make_log_notification("error", "Something failed", "")
        expect(notif.contains("\"level\":\"error\"")).to_equal(true)
        expect(notif.contains("Something failed")).to_equal(true)

describe "MCP Log Level Comparison":
    slow_it "debug is lowest priority":
        # @req: REQ-APP-MCPUNIT-004
        step("Verify: debug is lowest priority")
        expect(log_level_to_int("debug") < log_level_to_int("info")).to_equal(true)

    slow_it "emergency is highest priority":
        # @req: REQ-APP-MCPUNIT-004
        step("Verify: emergency is highest priority")
        expect(log_level_to_int("emergency") > log_level_to_int("error")).to_equal(true)

    slow_it "levels increase monotonically":
        # @req: REQ-APP-MCPUNIT-004
        step("Verify: levels increase monotonically")
        expect(log_level_to_int("debug") < log_level_to_int("info")).to_equal(true)
        expect(log_level_to_int("info") < log_level_to_int("warning")).to_equal(true)
        expect(log_level_to_int("warning") < log_level_to_int("error")).to_equal(true)
        expect(log_level_to_int("error") < log_level_to_int("emergency")).to_equal(true)
