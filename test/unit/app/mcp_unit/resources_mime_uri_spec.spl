"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/app/mcp_unit/resources_mime_uri_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# MCP Resources Extended Specification
#
# Tests for resource manager types, URI handling, MIME type detection,
# and resource utility functions (JSON parsing, string helpers).
# Locally replicates pure functions from:
# - app.mcp.resources (get_mime_type_for_uri, repeat_string, dir_exists)
# - app.mcp.resource_utils (extract_json_string, extract_json_int, etc.)

use std.common.text.{NL}
use std.spec.{step}

# =========================================================================
# Local type definitions (mirrors resources.spl)
# =========================================================================

struct ResourceInfo:
    uri: text
    name: text
    description: text
    mime_type: text

struct ResourceTemplate:
    uri_template: text
    name: text
    description: text
    mime_type: text

struct ResourceContent:
    uri: text
    contents: text
    mime_type: text

# =========================================================================
# Pure functions replicated from resources.spl
# =========================================================================

fn get_mime_type_for_uri(uri: text) -> text:
    if uri.starts_with("file://"):
        if uri.ends_with(".spl") or uri.ends_with(".shs"):
            return "text/x-simple"
        if uri.ends_with(".json"):
            return "application/json"
        if uri.ends_with(".md"):
            return "text/markdown"
        return "text/plain"

    if uri.starts_with("symbol://") or uri.starts_with("type://"):
        return "application/json"

    if uri.starts_with("docs://"):
        return "text/markdown"

    if uri.starts_with("tree://"):
        return "text/plain"

    ""

fn repeat_string(s: text, count: i64) -> text:
    var result = ""
    for i in 0..count:
        result = result + s
    result

fn domain_to_dir_name(domain: text) -> text:
    domain.replace("-", "_")

fn normalize_type_resource_path(module_path: text) -> text:
    if module_path.ends_with(".spl"):
        return module_path

    if module_path.contains("/"):
        val parts = module_path.split("/")
        if parts.len() >= 2 and parts[0].contains("-"):
            return "src/type/" + domain_to_dir_name(parts[0]) + "/" + parts[1..].join("/") + ".spl"
        return ""

    if not module_path.contains("."):
        return "src/type/" + domain_to_dir_name("simple-lang") + "/" + module_path + ".spl"

    ""

# =========================================================================
# Pure functions replicated from resource_utils.spl
# =========================================================================

fn extract_json_string(json: text, key: text) -> text:
    val pattern = "\"" + key + "\": \""
    val idx = json.index_of(pattern)
    if idx == -1:
        return ""

    val value_start = idx + pattern.len()
    val remaining = json.substring(value_start)
    val end_idx = remaining.index_of("\"")
    if end_idx == -1:
        return ""

    remaining.substring(0, end_idx)

fn extract_json_int(json: text, key: text) -> i64:
    val pattern = "\"" + key + "\": "
    val idx = json.index_of(pattern)
    if idx == -1:
        return 0

    val value_start = idx + pattern.len()
    var value_end = value_start
    while value_end < json.len():
        val ch = json.char_at(value_end)
        val is_digit = ch >= "0" and ch <= "9"
        val is_minus = ch == "-"
        if not is_digit and not is_minus:
            break
        value_end = value_end + 1

    if value_end == value_start:
        return 0

    val num_str = json.substring(value_start, value_end)
    int(num_str)

# =========================================================================
# URI routing helper
# =========================================================================

fn route_uri(uri: text) -> text:
    if uri == "project:///info":
        return "project_info"
    if uri.starts_with("file://"):
        return "file"
    if uri.starts_with("symbol://"):
        return "symbol"
    if uri.starts_with("type://"):
        return "type"
    if uri.starts_with("docs://"):
        return "docs"
    if uri.starts_with("tree://"):
        return "tree"
    if uri.starts_with("bugdb://"):
        return "bugdb"
    if uri.starts_with("featuredb://"):
        return "featuredb"
    if uri.starts_with("testdb://"):
        return "testdb"
    "unknown"

# Extract path from file URI
fn extract_file_path(uri: text) -> text:
    uri.substring(7)

# Extract symbol name from symbol URI
fn extract_symbol_name(uri: text) -> text:
    uri.substring(9)

# Extract type name from type URI
fn extract_type_name(uri: text) -> text:
    uri.substring(7)

# Extract bugdb query from bugdb URI
fn extract_bugdb_query(uri: text) -> text:
    uri.substring(8)

# =========================================================================
# Tests
# =========================================================================

describe "ResourceInfo":
    it "creates with all fields":
        # @req: REQ-UNIT-APP-001
        step("Verify: creates with all fields")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val info = ResourceInfo(
            uri: "file:///src/main.spl",
            name: "Main Source",
            description: "Main entry point",
            mime_type: "text/x-simple"
        )
        expect(info.uri).to_equal("file:///src/main.spl")
        expect(info.name).to_equal("Main Source")
        expect(info.description).to_equal("Main entry point")
        expect(info.mime_type).to_equal("text/x-simple")

    it "handles empty description":
        # @req: REQ-UNIT-APP-002
        step("Verify: handles empty description")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val info = ResourceInfo(
            uri: "symbol:///MyClass",
            name: "MyClass",
            description: "",
            mime_type: "application/json"
        )
        expect(info.description).to_equal("")

    it "stores project info URI":
        # @req: REQ-UNIT-APP-003
        step("Verify: stores project info URI")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val info = ResourceInfo(
            uri: "project:///info",
            name: "Project Information",
            description: "Project metadata",
            mime_type: "text/plain"
        )
        expect(info.uri).to_equal("project:///info")

