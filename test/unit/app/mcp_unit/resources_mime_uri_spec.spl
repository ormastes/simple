        # @req: REQ-UNIT-APP-041
        step("Verify: does not rewrite dotted module paths")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val normalized = normalize_type_resource_path("compiler.frontend.core")
        expect(normalized).to_equal("")

