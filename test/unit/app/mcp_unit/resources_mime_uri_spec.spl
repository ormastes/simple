describe "extract_json_string":
    it "extracts string value by key":
        # @req: REQ-UNIT-APP-048
        step("Verify: extracts string value by key")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val json = "{\"name\": \"Alice\", \"age\": 30}"
        val name = extract_json_string(json, "name")
        expect(name).to_equal("Alice")

    it "returns empty string for missing key":
        # @req: REQ-UNIT-APP-049
        step("Verify: returns empty string for missing key")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val json = "{\"name\": \"Alice\"}"
        val missing = extract_json_string(json, "email")
        expect(missing).to_equal("")

    it "extracts from complex JSON":
        # @req: REQ-UNIT-APP-050
        step("Verify: extracts from complex JSON")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val json = "{\"status\": \"open\", \"priority\": \"P0\", \"title\": \"Fix bug\"}"
        expect(extract_json_string(json, "status")).to_equal("open")
        expect(extract_json_string(json, "priority")).to_equal("P0")
        expect(extract_json_string(json, "title")).to_equal("Fix bug")

    it "handles empty string value":
        # @req: REQ-UNIT-APP-051
        step("Verify: handles empty string value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val json = "{\"value\": \"\"}"
        val result = extract_json_string(json, "value")
        expect(result).to_equal("")

    it "extracts first occurrence of key":
        # @req: REQ-UNIT-APP-052
        step("Verify: extracts first occurrence of key")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val json = "{\"key\": \"first\", \"other\": \"second\"}"
        val result = extract_json_string(json, "key")
        expect(result).to_equal("first")

    it "returns empty for empty JSON":
        # @req: REQ-UNIT-APP-053
        step("Verify: returns empty for empty JSON")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = extract_json_string("{}", "key")
        expect(result).to_equal("")

describe "extract_json_int":
    it "extracts integer value by key":
        # @req: REQ-UNIT-APP-054
        step("Verify: extracts integer value by key")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val json = "{\"count\": 42, \"name\": \"test\"}"
        val count = extract_json_int(json, "count")
        expect(count).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

    it "returns 0 for missing key":
        # @req: REQ-UNIT-APP-055
        step("Verify: returns 0 for missing key")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val json = "{\"count\": 42}"
        val missing = extract_json_int(json, "other")
        expect(missing).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "extracts zero value":
        # @req: REQ-UNIT-APP-056
        step("Verify: extracts zero value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val json = "{\"count\": 0}"
        val count = extract_json_int(json, "count")
        expect(count).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "extracts large numbers":
        # @req: REQ-UNIT-APP-057
        step("Verify: extracts large numbers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val json = "{\"total\": 999999}"
        val total = extract_json_int(json, "total")
        expect(total).to_equal(999999)  # oracle: expected value 999999 is the behavior asserted by this regression spec

    it "returns 0 for empty JSON":
        # @req: REQ-UNIT-APP-058
        step("Verify: returns 0 for empty JSON")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = extract_json_int("{}", "key")
        expect(result).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

describe "bugdb query routing":
    it "recognizes /all query":
        # @req: REQ-UNIT-APP-059
        step("Verify: recognizes /all query")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val query = extract_bugdb_query("bugdb:///all")
        var is_all = query == "/all" or query == "all"
        expect(is_all).to_equal(true)

    it "recognizes /open query":
