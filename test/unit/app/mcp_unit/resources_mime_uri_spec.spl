    it "handles empty contents":
        # @req: REQ-UNIT-APP-008
        step("Verify: handles empty contents")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val content = ResourceContent(
            uri: "file:///empty.spl",
            contents: "",
            mime_type: "text/x-simple"
        )
        expect(content.contents).to_equal("")

    it "handles large content":
        # @req: REQ-UNIT-APP-009
        step("Verify: handles large content")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var large = ""
        for i in 0..100:
            large = large + "line {i}{NL}"
        val content = ResourceContent(
            uri: "file:///large.spl",
            contents: large,
            mime_type: "text/plain"
        )
        expect(content.contents).to_contain("line 0")
        expect(content.contents).to_contain("line 99")

