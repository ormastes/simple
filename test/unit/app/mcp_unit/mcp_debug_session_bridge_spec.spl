use app.mcp.dap_bridge.{dap_create_session, dap_close_session, dap_add_breakpoint}
use std.common.debug.contracts_v1.{DebugSessionId, DebugVerificationV1}
use std.common.debug.capability.{CapLevel}
use std.common.debug.service_v1.{central_debug_service_v1_graph, central_debug_service_v1_receipts}

describe "MCP debug session bridge":
    it "captures RTL remote_bitbang bootstrap metadata in session creation":
        val session = dap_create_session(
            "build/rtl.elf",
            "openocd",
            "openocd_remote_bitbang",
            "riscv32",
            "rtl_sim",
            "generic",
            "",
            "",
            "localhost",
            "3333",
            "",
            "",
            "127.0.0.1",
            "5555",
            "",
            "true"
        )
        expect(session.transport).to_equal("openocd_remote_bitbang")
        expect(session.exec_mode).to_equal("rtl_sim")
        expect(session.state).to_equal("bootstrap_ready")
        expect(session.bootstrap_launch_command).to_contain("remote_bitbang")
        expect(session.capabilities).to_contain("virtual_jtag")
        expect(session.debug_session_id == "").to_equal(false)
        expect(session.build_id).to_equal("artifact:build/rtl.elf")
        val graph = central_debug_service_v1_graph(DebugSessionId(value: session.debug_session_id))!
        expect(graph.build_id).to_equal(session.build_id)
        expect(graph.nodes.len()).to_equal(1)
        expect(graph.nodes[0].kind).to_equal("openocd")
        expect(graph.capabilities[0].support).to_equal(CapLevel.Native)
        expect(graph.capabilities[0].verification).to_equal(DebugVerificationV1.Unverified)
        val (bp_id, bp_status) = dap_add_breakpoint(session.id, "src/main.spl", "7", "")
        expect(bp_id).to_be_greater_than(0)
        expect(bp_status).to_equal("set")
        dap_close_session(session.id)
        val receipts = central_debug_service_v1_receipts(DebugSessionId(value: session.debug_session_id))
        expect(receipts.map(_.action)).to_contain("session.open")
        expect(receipts.map(_.action)).to_contain("mcp.dap.breakpoint.set")
        expect(receipts.map(_.action)).to_contain("mcp.dap.transport.close")
        expect(receipts.map(_.action)).to_contain("session.close")

    it "captures Intel jtagd discovery metadata in session creation":
        val session = dap_create_session(
            "build/hw.elf",
            "intel_jtagd",
            "intel_jtagd",
            "riscv32",
            "hw",
            "intel",
            "",
            "",
            "localhost",
            "1309",
            "",
            "",
            "",
            "",
            "@1:10",
            "true"
        )
        expect(session.backend_id).to_equal("intel_jtagd")
        expect(session.bootstrap_discovery_command).to_equal("jtagconfig --enum")
        expect(session.bootstrap_attach_target).to_contain("@1:10")
        expect(session.persistent_session).to_equal(true)
        dap_close_session(session.id)
