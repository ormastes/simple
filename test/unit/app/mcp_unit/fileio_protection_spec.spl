"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/app/mcp_unit/fileio_protection_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# File I/O Protection Engine Tests
# Tests rule matching, action enforcement, and edge cases

use std.nogc_async_mut.mcp.fileio_protection (ProtectionEngine, RuleType, RuleAction, ProtectionResult, create_engine)
use std.io_runtime.{read_file}
use std.spec.{step}
fn check(condition: bool):
    expect(condition).to_equal(true)
fn check_msg(condition: bool, message: text):
    if not condition:
        expect(message).to_equal("")

describe "File I/O Protection Engine":

    describe "Rule Matching":

        it "matches exact paths":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-001
            step("Verify: matches exact paths")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("CLAUDE.md", RuleType.Exact, RuleAction.Protect, "Test")

            val result = engine.check_path("CLAUDE.md", "write")
            match result:
                ProtectionResult.Denied(_): assert true
                _: assert false, "Expected denied result"

        it "matches glob patterns with *":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-002
            step("Verify: matches glob patterns with *")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("*.sdn", RuleType.Glob, RuleAction.Atomic, "Test")

            val result = engine.check_path("test.sdn", "write")
            match result:
                ProtectionResult.RequiresAtomic: assert true
                _: assert false, "Expected requires atomic"

        it "matches glob patterns with multiple *":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-003
            step("Verify: matches glob patterns with multiple *")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("doc/*.sdn", RuleType.Glob, RuleAction.Atomic, "Test")

            val result = engine.check_path("doc/test.sdn", "write")
            match result:
                ProtectionResult.RequiresAtomic: assert true
                _: assert false, "Expected requires atomic"

        it "does not match non-matching patterns":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-004
            step("Verify: does not match non-matching patterns")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("*.sdn", RuleType.Glob, RuleAction.Atomic, "Test")

            val result = engine.check_path("test.txt", "write")
            match result:
                ProtectionResult.Allowed: assert true
                _: assert false, "Expected allowed"

        it "normalizes paths with trailing slash":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-005
            step("Verify: normalizes paths with trailing slash")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("src/", RuleType.Exact, RuleAction.Protect, "Test")

            val result1 = engine.check_path("src/", "write")
            val result2 = engine.check_path("src", "write")

            match result1:
                ProtectionResult.Denied(_): assert true
                _: assert false, "Expected denied for src/"

            match result2:
                ProtectionResult.Denied(_): assert true
                _: assert false, "Expected denied for src"

        it "normalizes relative paths":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-006
            step("Verify: normalizes relative paths")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("test.txt", RuleType.Exact, RuleAction.Protect, "Test")

            val result = engine.check_path("./test.txt", "write")
            match result:
                ProtectionResult.Denied(_): assert true
                _: assert false, "Expected denied"

        it "returns first matching rule":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-007
            step("Verify: returns first matching rule")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("*.txt", RuleType.Glob, RuleAction.Deny, "First")
            engine.add_rule("*.txt", RuleType.Glob, RuleAction.Allow, "Second")

            val result = engine.check_path("test.txt", "write")
            match result:
                ProtectionResult.Denied(reason):
                    check(reason.contains("First"))
                _: assert false, "Expected first rule to match"

    describe "Action Enforcement":

        it "allows read on protected files":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-008
            step("Verify: allows read on protected files")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("test.txt", RuleType.Exact, RuleAction.Protect, "Test")

            val result = engine.check_path("test.txt", "read")
            match result:
                ProtectionResult.Allowed: assert true
                _: assert false, "Expected allowed for read"

        it "denies write on protected files":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-009
            step("Verify: denies write on protected files")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("test.txt", RuleType.Exact, RuleAction.Protect, "Test")

            val result = engine.check_path("test.txt", "write")
            match result:
                ProtectionResult.Denied(_): assert true
                _: assert false, "Expected denied for write"

        it "denies delete on protected files":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-010
            step("Verify: denies delete on protected files")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("test.txt", RuleType.Exact, RuleAction.Protect, "Test")

            val result = engine.check_path("test.txt", "delete")
            match result:
                ProtectionResult.Denied(_): assert true
                _: assert false, "Expected denied for delete"

        it "denies all operations on denied files":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-011
            step("Verify: denies all operations on denied files")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("/", RuleType.Exact, RuleAction.Deny, "Test")

            val read_result = engine.check_path("/", "read")
            val write_result = engine.check_path("/", "write")

            match read_result:
                ProtectionResult.Denied(_): assert true
                _: assert false, "Expected denied for read"

            match write_result:
                ProtectionResult.Denied(_): assert true
                _: assert false, "Expected denied for write"

        it "redirects files to temp directory":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-012
            step("Verify: redirects files to temp directory")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp/test")
            engine.add_rule("*.sh", RuleType.Glob, RuleAction.Redirect, "Test")

            val result = engine.check_path("script.sh", "write")
            match result:
                ProtectionResult.Redirected(path):
                    check(path.contains("/tmp/test"))
                    check(path.contains("script.sh"))
                _: assert false, "Expected redirected"

        it "requires atomic writes for atomic action":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-013
            step("Verify: requires atomic writes for atomic action")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("*.sdn", RuleType.Glob, RuleAction.Atomic, "Test")

            val result = engine.check_path("test.sdn", "write")
            match result:
                ProtectionResult.RequiresAtomic: assert true
                _: assert false, "Expected requires atomic"

        it "allows all operations for allow action":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-014
            step("Verify: allows all operations for allow action")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("doc/", RuleType.Exact, RuleAction.Allow, "Test")

            val result = engine.check_path("doc/", "write")
            match result:
                ProtectionResult.Allowed: assert true
                _: assert false, "Expected allowed"

    describe "Edge Cases":

        it "handles empty path":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-015
            step("Verify: handles empty path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            val result = engine.check_path("", "write")
            match result:
                ProtectionResult.Allowed: assert true
                _: assert false, "Expected allowed for empty path"

        it "handles no matching rules":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-016
            step("Verify: handles no matching rules")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            val result = engine.check_path("random.txt", "write")
            match result:
                ProtectionResult.Allowed: assert true
                _: assert false, "Expected allowed when no rules match"

        it "handles nested paths":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-017
            step("Verify: handles nested paths")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("src/", RuleType.Exact, RuleAction.Protect, "Test")

            # Should not match nested paths
            val result = engine.check_path("src/app/main.spl", "write")
            match result:
                ProtectionResult.Allowed: assert true
                _: assert false, "Expected allowed for nested path"

        it "handles multiple rules for same path":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-018
            step("Verify: handles multiple rules for same path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("test.txt", RuleType.Exact, RuleAction.Protect, "Rule 1")
            engine.add_rule("test.txt", RuleType.Exact, RuleAction.Allow, "Rule 2")

            # First rule should win
            val result = engine.check_path("test.txt", "write")
            match result:
                ProtectionResult.Denied(reason):
                    check(reason.contains("Rule 1"))
                _: assert false, "Expected first rule to match"

        it "lists protected files with wildcard":
            # @req: REQ-UNIT-APP-019
            step("Verify: lists protected files with wildcard")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("CLAUDE.md", RuleType.Exact, RuleAction.Protect, "Test 1")
            engine.add_rule("src/", RuleType.Exact, RuleAction.Protect, "Test 2")
            engine.add_rule("*.txt", RuleType.Glob, RuleAction.Allow, "Test 3")

            val files = engine.list_protected_files("*")
            expect(files.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
            expect(files.contains("CLAUDE.md")).to_equal(true)
            expect(files.contains("src/")).to_equal(true)

        it "lists protected files with pattern":
            # @req: REQ-UNIT-APP-020
            step("Verify: lists protected files with pattern")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("CLAUDE.md", RuleType.Exact, RuleAction.Protect, "Test 1")
            engine.add_rule("src/", RuleType.Exact, RuleAction.Protect, "Test 2")

            val files = engine.list_protected_files("CLAUDE")
            expect(files.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            expect(files.contains("CLAUDE.md")).to_equal(true)

        it "gets protection info for path":
            # @req: REQ-UNIT-APP-021
            step("Verify: gets protection info for path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            engine.add_rule("CLAUDE.md", RuleType.Exact, RuleAction.Protect, "Important file")

            val info = engine.get_protection_info("CLAUDE.md")
            expect(info.contains("Protect")).to_equal(true)
            expect(info.contains("Important file")).to_equal(true)

        it "gets protection info for unprotected path":
            # @req: REQ-UNIT-APP-022
            step("Verify: gets protection info for unprotected path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = ProtectionEngine(rules: [], temp_base: "/tmp")
            val info = engine.get_protection_info("random.txt")
            expect(info.contains("No protection")).to_equal(true)

    describe "Server Integration":

        it "safe_atomic_write uses protection checks":
            # @req: REQ-UNIT-APP-023
            step("Verify: safe_atomic_write uses protection checks")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val source = read_file("src/lib/nogc_async_mut/mcp/fileio_server.spl")
            expect(source.contains("fn tool_safe_atomic_write")).to_equal(true)
            expect(source.contains("check_path(path, \"write\")")).to_equal(true)
            expect(source.contains("Atomic write denied")).to_equal(true)

        it "default engine denies new root entries":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-024
            step("Verify: default engine denies new root entries")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = create_engine("missing_workspace_root_guard_config.sdn", "/tmp")
            val result = engine.check_path("new_root_file.tmp", "write")
            match result:
                ProtectionResult.Denied(reason):
                    check(reason.contains("Workspace root policy"))
                _: assert false, "Expected workspace root policy denial"

        it "default engine denies new immediate child entries":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-025
            step("Verify: default engine denies new immediate child entries")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = create_engine("missing_workspace_root_guard_config.sdn", "/tmp")
            val result = engine.check_path("src/new_child_entry", "write")
            match result:
                ProtectionResult.Denied(reason):
                    check(reason.contains("Workspace root policy"))
                _: assert false, "Expected workspace root child policy denial"

        it "default engine keeps mutable build directory writable":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-026
            step("Verify: default engine keeps mutable build directory writable")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = create_engine("missing_workspace_root_guard_config.sdn", "/tmp")
            val result = engine.check_path("build/new_artifact.tmp", "write")
            match result:
                ProtectionResult.Allowed: assert true
                _: assert false, "Expected build artifact path to remain writable"

        it "configured engine still installs workspace root policy":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-APP-027
            step("Verify: configured engine still installs workspace root policy")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val engine = create_engine("config/critical_files.sdn", "/tmp")
            val result = engine.check_path("another_root_file.tmp", "write")
            match result:
                ProtectionResult.Denied(reason):
                    check(reason.contains("Workspace root policy"))
                _: assert false, "Expected configured engine to retain root policy"
