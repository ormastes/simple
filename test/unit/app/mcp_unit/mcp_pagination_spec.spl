fn parse_int(s: String) -> Result<Int, String>:
    # Mock implementation - real version in main.spl
    Ok(42)

fn min_int(a: Int, b: Int) -> Int:
    # Mock implementation - real version in main.spl
    if a < b:
        a
    else:
        b

fn be_true() -> Bool:
    true

fn be_false() -> Bool:
    false

fn eq(expected: Int) -> Bool:
    true

fn eq(expected: String) -> Bool:
    true

fn start_with(prefix: String) -> Bool:
    true
