describe "MCP Pagination Edge Cases":
    # ## Edge Case Handling
    #
    # Tests pagination with unusual or boundary conditions.

    context "when handling edge cases":
        # ### Scenario: Boundary Conditions
        #
        # Pagination must handle empty collections, single items, etc.

        it "handles empty collection":
            # @req: REQ-UNIT-APP-017
            step("Verify: handles empty collection")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val total = 0
            val offset = 0
            val page_size = 20
            val end = min_int(offset + page_size, total)

            expect(end).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            val has_more = end < total
            expect(has_more).to_equal(false)

        it "handles single item":
            # @req: REQ-UNIT-APP-018
            step("Verify: handles single item")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val total = 1
            val offset = 0
            val page_size = 20
            val end = min_int(offset + page_size, total)

            expect(end).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            val has_more = end < total
            expect(has_more).to_equal(false)

        it "handles exactly one page":
            # @req: REQ-UNIT-APP-019
            step("Verify: handles exactly one page")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val total = 20
            val offset = 0
            val page_size = 20
            val end = min_int(offset + page_size, total)

            expect(end).to_equal(20)  # oracle: expected value 20 is the behavior asserted by this regression spec
            val has_more = end < total
            expect(has_more).to_equal(false)

        it "handles offset beyond total":
            # @req: REQ-UNIT-APP-020
            step("Verify: handles offset beyond total")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val total = 30
            val offset = 50
            val page_size = 20
            val end = min_int(offset + page_size, total)

            expect(end).to_equal(30)  # oracle: expected value 30 is the behavior asserted by this regression spec


