        val step_mode = 0
        expect(step_mode).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "set_step_mode stores mode value":
        # @req: REQ-UNIT-APP-015
        step("Verify: set_step_mode stores mode value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mode_over = 1
        val mode_in = 2
        val mode_out = 3
        expect(mode_over).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(mode_in).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(mode_out).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    it "pause_exec is a no-op stub":
        # @req: REQ-UNIT-APP-016
        step("Verify: pause_exec is a no-op stub")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val paused = true
        expect(paused).to_equal(true)

