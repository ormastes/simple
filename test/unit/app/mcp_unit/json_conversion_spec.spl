"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/app/mcp_unit/json_conversion_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# JSON Conversion Tests
# Tests any_to_json and json_value_to_any conversions

use std.nogc_async_mut.mcp.helpers.{LB, RB, Q, jp, js, jo1, jo2, jo3, extract_json_string, extract_json_value, escape_json}
use std.spec.{step}

describe "JSON Conversion":
    describe "any_to_json Type Branches":
        it "converts bool to JSON":
            # @req: REQ-UNIT-APP-001
            step("Verify: converts bool to JSON")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val json = "true"
            expect(json).to_equal("true")

        it "converts i64 to JSON":
            # @req: REQ-UNIT-APP-002
            step("Verify: converts i64 to JSON")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val json = "42"
            expect(json).to_equal("42")

        it "converts f64 to JSON":
            # @req: REQ-UNIT-APP-003
            step("Verify: converts f64 to JSON")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val json = "3.14"
            expect(json.contains("3.14")).to_equal(true)

        it "converts text to JSON":
            # @req: REQ-UNIT-APP-004
            step("Verify: converts text to JSON")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val json = js("hello")
            expect(json.contains("hello")).to_equal(true)

        it "converts list to JSON array":
            # @req: REQ-UNIT-APP-005
            step("Verify: converts list to JSON array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val json = "[1,2,3]"
            expect(json.starts_with("[")).to_equal(true)
            expect(json.ends_with("]")).to_equal(true)

        it "converts dict to JSON object":
            # @req: REQ-UNIT-APP-006
            step("Verify: converts dict to JSON object")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val json = jo1(jp("key", js("value")))
            expect(json.contains("key")).to_equal(true)

        it "handles nil conversion":
            # @req: REQ-UNIT-APP-007
            step("Verify: handles nil conversion")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val json = "null"
            expect(json).to_equal("null")

        it "uses fallback for unknown types":
            # @req: REQ-UNIT-APP-008
            step("Verify: uses fallback for unknown types")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val json = js("unknown")
            expect(json.contains("unknown")).to_equal(true)

    describe "json_value_to_any Type Branches":
        it "converts JSON bool to any":
            # @req: REQ-UNIT-APP-009
            step("Verify: converts JSON bool to any")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val value = extract_json_value(jo1(jp("v", "true")), "v")
            expect(value).to_equal("true")

        it "converts JSON number to any":
            # @req: REQ-UNIT-APP-010
            step("Verify: converts JSON number to any")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val value = extract_json_value(jo1(jp("v", "42")), "v")
            expect(value).to_equal("42")

        it "converts JSON string to any":
            # @req: REQ-UNIT-APP-011
            step("Verify: converts JSON string to any")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val value = extract_json_string(jo1(jp("v", js("text"))), "v")
            expect(value).to_equal("text")

        it "converts JSON array to any":
            # @req: REQ-UNIT-APP-012
            step("Verify: converts JSON array to any")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val json = jo1(jp("v", "[1,2,3]"))
            val value = extract_json_value(json, "v")
            expect(value.starts_with("[")).to_equal(true)

        it "converts JSON object to any":
            # @req: REQ-UNIT-APP-013
            step("Verify: converts JSON object to any")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val inner = jo1(jp("a", "1"))
            val json = jo1(jp("v", inner))
            val value = extract_json_value(json, "v")
            expect(value.contains("a")).to_equal(true)

        it "converts JSON null to any":
            # @req: REQ-UNIT-APP-014
            step("Verify: converts JSON null to any")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val json = jo1(jp("v", "null"))
            val value = extract_json_value(json, "v")
            expect(value).to_equal("null")

    describe "Edge Cases":
        it "handles empty list":
            # @req: REQ-UNIT-APP-015
            step("Verify: handles empty list")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val json = LB() + RB()
            expect(json.len() > 0).to_equal(true)

        it "handles empty dict":
            # @req: REQ-UNIT-APP-016
            step("Verify: handles empty dict")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val json = LB() + RB()
            expect(json.len() > 0).to_equal(true)

        it "handles nested structures":
            # @req: REQ-UNIT-APP-017
            step("Verify: handles nested structures")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val inner = jo1(jp("nested", js("value")))
            val outer = jo1(jp("outer", inner))
            expect(outer.contains("nested")).to_equal(true)
            expect(outer.contains("value")).to_equal(true)

        it "handles special characters in strings":
            # @req: REQ-UNIT-APP-018
            step("Verify: handles special characters in strings")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val escaped = escape_json("hello \"world\"")
            expect(escaped.contains("world")).to_equal(true)

    describe "Round-Trip Conversion":
        it "preserves bool through conversion":
            # @req: REQ-UNIT-APP-019
            step("Verify: preserves bool through conversion")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val original = "true"
            val json = jo1(jp("v", original))
            val extracted = extract_json_value(json, "v")
            expect(extracted).to_equal(original)

        it "preserves number through conversion":
            # @req: REQ-UNIT-APP-020
            step("Verify: preserves number through conversion")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val original = "42"
            val json = jo1(jp("v", original))
            val extracted = extract_json_value(json, "v")
            expect(extracted).to_equal(original)

        it "preserves string through conversion":
            # @req: REQ-UNIT-APP-021
            step("Verify: preserves string through conversion")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val original = "hello"
            val json = jo1(jp("v", js(original)))
            val extracted = extract_json_string(json, "v")
            expect(extracted).to_equal(original)

        it "preserves nested structure through conversion":
            # @req: REQ-UNIT-APP-022
            step("Verify: preserves nested structure through conversion")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val inner = jo1(jp("key", js("val")))
            val outer = jo1(jp("data", inner))
            val extracted = extract_json_value(outer, "data")
            expect(extracted.contains("key")).to_equal(true)
