describe "Log levels":
    slow_it "has trace level":
        # @req: REQ-APP-MCPUNIT-002
        step("Verify: has trace level")
        expect(log_level_to_int("debug")).to_equal(0) # oracle: pinned expected value documenting the asserted outcome

    slow_it "has info level":
        # @req: REQ-APP-MCPUNIT-002
        step("Verify: has info level")
        expect(log_level_to_int("info")).to_equal(1) # oracle: pinned expected value documenting the asserted outcome

    slow_it "has warn level":
        # @req: REQ-APP-MCPUNIT-002
        step("Verify: has warn level")
        expect(log_level_to_int("warning")).to_equal(3) # oracle: pinned expected value documenting the asserted outcome

    slow_it "has error level":
        # @req: REQ-APP-MCPUNIT-002
        step("Verify: has error level")
        expect(log_level_to_int("error")).to_equal(4) # oracle: pinned expected value documenting the asserted outcome

    slow_it "has critical level":
        # @req: REQ-APP-MCPUNIT-002
        step("Verify: has critical level")
        expect(log_level_to_int("critical")).to_equal(5) # oracle: pinned expected value documenting the asserted outcome

    slow_it "has emergency level":
        # @req: REQ-APP-MCPUNIT-002
        step("Verify: has emergency level")
        expect(log_level_to_int("emergency")).to_equal(7) # oracle: pinned expected value documenting the asserted outcome

    slow_it "orders levels correctly":
        # @req: REQ-APP-MCPUNIT-002
        step("Verify: orders levels correctly")
        val debug_val = log_level_to_int("debug")
        val info_val = log_level_to_int("info")
        val warning_val = log_level_to_int("warning")
        val error_val = log_level_to_int("error")
        val emergency_val = log_level_to_int("emergency")
        expect(debug_val < info_val).to_equal(true)
        expect(info_val < warning_val).to_equal(true)
        expect(warning_val < error_val).to_equal(true)
        expect(error_val < emergency_val).to_equal(true)

describe "Validation limits":
    slow_it "has default limits":
        # @req: REQ-APP-MCPUNIT-002
        step("Verify: has default limits")
        val limits = default_validation_limits()
        expect(limits.max_content_length).to_equal(1048576) # oracle: pinned expected value documenting the asserted outcome
        expect(limits.max_string_length).to_equal(65536) # oracle: pinned expected value documenting the asserted outcome
        expect(limits.max_array_length).to_equal(1000) # oracle: pinned expected value documenting the asserted outcome

    slow_it "has strict limits":
        # @req: REQ-APP-MCPUNIT-002
        step("Verify: has strict limits")
        val limits = strict_validation_limits()
        expect(limits.max_content_length).to_equal(524288) # oracle: pinned expected value documenting the asserted outcome
        expect(limits.max_string_length).to_equal(32768) # oracle: pinned expected value documenting the asserted outcome
        expect(limits.max_array_length).to_equal(500) # oracle: pinned expected value documenting the asserted outcome

    slow_it "strict limits are more restrictive":
        # @req: REQ-APP-MCPUNIT-002
        step("Verify: strict limits are more restrictive")
        val d = default_validation_limits()
        val s = strict_validation_limits()
        expect(s.max_content_length < d.max_content_length).to_equal(true)

