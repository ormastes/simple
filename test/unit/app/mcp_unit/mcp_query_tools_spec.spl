# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# MCP Query Tools (Tier 2) Specification
#
# **Feature IDs:** #MCP-QUERY-001
# **Category:** Tooling
# **Difficulty:** 2/5
# **Status:** Implemented
#
# ## Overview
#
# Tests the 5 Tier 2 MCP query tool handlers:
# simple_definition, simple_references, simple_hover, simple_completions, simple_type_at
#
# ## Behavior
#
# - Each tool delegates to bin/simple query CLI
# - Requires file and line parameters
# - Column parameter is optional


# ============================================================================
# Test Group 1: simple_definition tool
# ============================================================================

use std.spec.step

describe "simple_definition tool":
    # @manual scenario evidence
    it "requires file parameter":
        # @req REQ-SSPEC-UNIT
        step("requires file parameter")
        val file = ""
        val has_error = file == ""
        expect(has_error).to_equal(true)

    it "requires line parameter":
        # @req REQ-SSPEC-UNIT
        step("requires line parameter")
        val line = ""
        val has_error = line == ""
        expect(has_error).to_equal(true)

    it "builds definition command":
        # @req REQ-SSPEC-UNIT
        step("builds definition command")
        val file = "src/app/cli/main.spl"
        val line = "42"
        var cmd = "timeout 30 bin/simple query definition " + file + " " + line
        cmd = cmd + " 2>&1"
        expect(cmd).to_contain("query definition")
        expect(cmd).to_contain(file)
        expect(cmd).to_contain(line)

    it "builds definition command with column":
        # @req REQ-SSPEC-UNIT
        step("builds definition command with column")
        val file = "src/app/cli/main.spl"
        val line = "42"
        val column = "10"
        var cmd = "timeout 30 bin/simple query definition " + file + " " + line
        if column != "":
            cmd = cmd + " " + column
        expect(cmd).to_contain("42 10")

