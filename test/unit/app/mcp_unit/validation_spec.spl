describe "Array size validation":
    it "accepts zero size":
        step("Verify: accepts zero size")
        val validator = input_validator()
        val result = validator.validate_array_length(0)
        expect(result).to_be_nil()

    it "accepts normal size":
        step("Verify: accepts normal size")
        val validator = input_validator()
        val result = validator.validate_array_length(100)
        expect(result).to_be_nil()

    it "rejects negative size":
        step("Verify: rejects negative size")
        val validator = input_validator()
        val result = validator.validate_array_length(-10)
        match result:
            case nil: expect(false).to_equal(true)
            case err: expect(err.message.contains("negative")).to_equal(true)

    it "rejects excessive size":
        step("Verify: rejects excessive size")
        val validator = input_validator()
        val result = validator.validate_array_length(2000)
        match result:
            case nil: expect(false).to_equal(true)
            case err: expect(err.message.contains("exceeds")).to_equal(true)

describe "Validation limits constants":
    it "has correct default content limit":
        step("Verify: has correct default content limit")
        val limits = default_validation_limits()
        expect(limits.max_content_length).to_equal(1048576)  # oracle: 1048576 — named expected value from the requirement

    it "has correct strict content limit":
        step("Verify: has correct strict content limit")
        val limits = strict_validation_limits()
        expect(limits.max_content_length).to_equal(524288)  # oracle: 524288 — named expected value from the requirement

    it "has correct default string limit":
        step("Verify: has correct default string limit")
        val limits = default_validation_limits()
        expect(limits.max_string_length).to_equal(65536)  # oracle: 65536 — named expected value from the requirement

    it "has correct strict string limit":
        step("Verify: has correct strict string limit")
        val limits = strict_validation_limits()
        expect(limits.max_string_length).to_equal(32768)  # oracle: 32768 — named expected value from the requirement

    it "has correct default array limit":
        step("Verify: has correct default array limit")
        val limits = default_validation_limits()
        expect(limits.max_array_length).to_equal(1000)  # oracle: 1000 — named expected value from the requirement

    it "has correct strict array limit":
        step("Verify: has correct strict array limit")
        val limits = strict_validation_limits()
        expect(limits.max_array_length).to_equal(500)  # oracle: 500 — named expected value from the requirement

    it "default is more permissive than strict":
        step("Verify: default is more permissive than strict")
        val d = default_validation_limits()
        val s = strict_validation_limits()
        expect(d.max_content_length > s.max_content_length).to_equal(true)
        expect(d.max_string_length > s.max_string_length).to_equal(true)
        expect(d.max_array_length > s.max_array_length).to_equal(true)
