# @req: REQ-APP-APP-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/app/branch_coverage_19_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/branch_coverage_19.md
# doc-path: doc/03_plan/sys_test/branch_coverage_19.md
# doc-path: doc/04_architecture/branch_coverage_19.md
# doc-path: doc/05_design/branch_coverage_19.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "match falls through to default arm":
        step("Verify: match falls through to default arm")
        # @req: REQ-APP-APP-001
        val k = 99
        var r = 0
        match k:
            1: r = 10
            2: r = 20
            _: r = -1
        expect(r).to_equal(-1)  # oracle: default arm

    it "continue skips the rest of the body":
        step("Verify: continue skips the rest of the body")
        # @req: REQ-APP-APP-001
        var c = 0
        for i in 0..5:
            if i == 2: continue
            c = c + 1
        expect(c).to_equal(4)  # oracle: one skipped iteration

    it "if-else arm executes on false condition":
        step("Verify: if-else arm executes on false condition")
        # @req: REQ-APP-APP-001
        var r = 0
        if 2 > 5:
            r = 1
        else:
            r = 2
        expect(r).to_equal(2)  # oracle: else arm taken

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "elif first arm wins when its guard holds":
        step("Verify: elif first arm wins when its guard holds")
        # @req: REQ-APP-APP-001
        var r = 0
        if 7 > 10:
            r = 1
        elif 7 > 5:
            r = 2
        else:
            r = 3
        expect(r).to_equal(2)  # oracle: first true elif

    it "while loop with false guard never runs":
        step("Verify: while loop with false guard never runs")
        # @req: REQ-APP-APP-001
        var i = 7
        while i < 0:
            i = i + 1
        expect(i).to_equal(7)  # oracle: body skipped

    it "match dispatches on the first equal pattern":
        step("Verify: match dispatches on the first equal pattern")
        # @req: REQ-APP-APP-001
        val k = 2
        var r = 0
        match k:
            1: r = 10
            2: r = 20
            3: r = 30
            _: r = -1
        expect(r).to_equal(20)  # oracle: literal pattern 2
