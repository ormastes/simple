# Regression test for the bug-add CLI writer path.

use std.spec (describe, it, expect)
use app.io.mod (dir_create_all, file_read, file_write)
use app.io.process_ops (shell)
use std.common.spec.evidence.untyped_capture.{UntypedCapture, untyped_capture_to_canonical}
use std.common.spec.evidence.model.{EvidenceStatus, oracle_spec, check_exact}
use std.common.spec.evidence.evidence_comparator.{compare_evidence}

extern fn rt_getpid() -> i64

fn bug_add_cli_fixture_root() -> text:
    "/tmp/bug_add_cli_spec_{rt_getpid()}"

fn bug_add_cli_fixture_db_path(root: text) -> text:
    "{root}/doc/08_tracking/bug/bug_db.sdn"

describe "bug-add CLI":
    it "writes a new open bug into the split-schema active table":
        val root = bug_add_cli_fixture_root()
        val db_path = bug_add_cli_fixture_db_path(root)
        val project_root = cwd()
        val simple_bin = project_root + "/bin/simple"
        val simple_src = project_root + "/src"
        val bug_add_main = project_root + "/src/app/bug_add/main.spl"
        expect(simple_bin).to_equal(cwd() + "/bin/simple")
        expect(simple_src).to_equal(cwd() + "/src")
        expect(bug_add_main).to_equal(cwd() + "/src/app/bug_add/main.spl")

        dir_create_all("{root}/doc/08_tracking/bug")
        val copied = file_write(db_path, file_read("doc/08_tracking/bug/bug_db.sdn"))
        expect(copied).to_equal(true)

        val result = shell("cd {root} && SIMPLE_LIB={simple_src} {simple_bin} run {bug_add_main} --id=bug_add_cli_fix_001 --severity=p2 --title='CLI bug add fix' --file=src/app/dashboard/assistant_collectors.spl --repro='bin/simple dashboard assistant'")
        expect(result.exit_code).to_equal(0)

        val content = file_read(db_path)
        expect(content.contains("bugs_active |")).to_equal(true)
        expect(content.contains("bug_add_cli_fix_001")).to_equal(true)
        expect(content.contains("bug_add_cli_fix_001, P2, open")).to_equal(true)
        expect(content.contains("src/app/dashboard/assistant_collectors.spl, 0, bin/simple dashboard assistant")).to_equal(true)
        expect(content.contains("bin/simple dashboard assistant")).to_equal(true)

        val marker = "bug_add_cli_fix_001, P2, open"
        val marker_at = content.index_of(marker)
        val extracted = if marker_at >= 0: content.substring(marker_at, marker_at + marker.len()) else: ""
        val capture = UntypedCapture(label: "bug-add-cli-db-row-status", raw_value: extracted, source_kind: "log_line")
        val evidence = untyped_capture_to_canonical(capture, "bug_add_cli_spec/db-row-status")
        val comparison = compare_evidence(evidence, oracle_spec("bug_add_cli_spec/db-row-status", [
            check_exact("value", marker)
        ]))
        expect(comparison.status).to_equal(EvidenceStatus.passed)

        shell("rm -rf {root}")
