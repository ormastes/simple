"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/app/io/file_ops_bytes_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use app.io.mod (file_read, file_read_bytes, file_write_bytes, process_run)
use std.common.spec.evidence.untyped_capture.{UntypedCapture, untyped_capture_to_canonical}
use std.common.spec.evidence.model.{EvidenceStatus, oracle_spec, check_exact}
use std.common.spec.evidence.evidence_comparator.{compare_evidence}
use std.spec.{step}

describe "app.io file byte operations":
    it "writes byte arrays through shared file ops":
        # @req: REQ-UNIT-APP-001
        step("Verify: writes byte arrays through shared file ops")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val path = "/tmp/simple-file-write-bytes-spec.bin"
        val (_out, _err, _code) = process_run("rm", ["-f", path])
        expect(file_write_bytes(path, [65u8, 66u8, 67u8])).to_equal(true)
        expect(file_read(path)).to_equal("ABC")
        expect(file_read_bytes(path) ?? []).to_equal([65, 66, 67])

        val capture = UntypedCapture(label: "file-write-bytes-readback", raw_value: file_read(path), source_kind: "log_line")
        val evidence = untyped_capture_to_canonical(capture, "file_ops_bytes_spec/file-write-bytes-readback")
        val comparison = compare_evidence(evidence, oracle_spec("file_ops_bytes_spec/file-write-bytes-readback", [
            check_exact("value", "ABC")
        ]))
        expect(comparison.status).to_equal(EvidenceStatus.passed)
