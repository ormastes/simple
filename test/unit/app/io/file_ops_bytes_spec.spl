# @req: REQ-APP-IO-001

use app.io.mod (file_read, file_read_bytes, file_write_bytes, process_run)
use std.common.spec.evidence.untyped_capture.{UntypedCapture, untyped_capture_to_canonical}
use std.common.spec.evidence.model.{EvidenceStatus, oracle_spec, check_exact}
use std.common.spec.evidence.evidence_comparator.{compare_evidence}

use std.spec.step

describe "app.io file byte operations":
    it "writes byte arrays through shared file ops":
        # @req: REQ-APP-IO-001
        step("Verify: writes byte arrays through shared file ops")
        val path = "/tmp/simple-file-write-bytes-spec.bin"
        val (_out, _err, _code) = process_run("rm", ["-f", path])
        expect(file_write_bytes(path, [65u8, 66u8, 67u8])).to_equal(true)
        expect(file_read(path)).to_equal("ABC")
        expect(file_read_bytes(path) ?? []).to_equal([65, 66, 67])

        val capture = UntypedCapture(label: "file-write-bytes-readback", raw_value: file_read(path), source_kind: "log_line")
        val evidence = untyped_capture_to_canonical(capture, "file_ops_bytes_spec/file-write-bytes-readback")
        val comparison = compare_evidence(evidence, oracle_spec("file_ops_bytes_spec/file-write-bytes-readback", [
            check_exact("value", "ABC")
        ]))
        expect(comparison.status).to_equal(EvidenceStatus.passed)
