"""
## Purpose and audience
Executable evidence for the app.io file read/write surface (`app.io.mod`
re-exports of `std.nogc_sync_mut.io.file_ops`): write, read back,
overwrite, copy, append, size, and delete on real temp files. Written for
compiler and tooling engineers who own the io layer and for preflight
gates that need proof the file ops work on the current host.

## Operator workflow
Run this file with the pure-Simple binary, e.g.
`./src/compiler_rust/target/bootstrap/simple run test/01_unit/app/io/file_ops_rw_spec.spl`
and read the per-scenario verdicts; every scenario writes only under
/tmp and cleans up after itself.

## Compatibility and limitations
A historical revision of this spec was fully commented out because the
imports did not resolve; the app.io.mod surface is verified executable
again, so the suite below asserts it live. Hosts without a writable /tmp
will fail every scenario — that is a real environment defect, not a skip.

## Verification guidance and troubleshooting
A failure here means the file ops contract moved: re-run the file, read
the first failing expect, and compare the reported value against the
inline oracle comment before bisecting recent io changes.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: app.io file read/write ops

use std.spec.*
use std.spec.step
use app.io.mod.{file_write, file_read, file_exists, file_copy, file_append, file_delete, file_size, file_size_raw}

describe "app.io file read/write operations":
    it "writes and reads back text content":
        # @req REQ-APP-IO-002
        # @capture(bit_table): write verdict and read-back text for the round trip
        step("Write a text file and read it back through the same module")
        val path = "/tmp/simple_file_ops_rw_a.txt"
        expect(file_write(path, "Hello, Simple!")).to_equal(true)  # oracle: the write must report success or the read-back below is meaningless
        expect(file_read(path)).to_equal("Hello, Simple!")  # oracle: the read-back must equal the exact bytes written
        expect(file_exists(path)).to_equal(true)  # oracle: a successful write leaves the file present on disk

    it "overwrites an existing file with the latest content":
        # @req REQ-APP-IO-002
        # @capture(bit_table): second-write read-back for the overwrite contract
        step("Write a file twice and read back the final content")
        val path = "/tmp/simple_file_ops_rw_b.txt"
        expect(file_write(path, "first")).to_equal(true)  # oracle: the seeding write must succeed
        expect(file_write(path, "second")).to_equal(true)  # oracle: the overwriting write must also succeed
        expect(file_read(path)).to_equal("second")  # oracle: the read-back must reflect only the LATEST write

    it "copies a file to a new path byte for byte":
        # @req REQ-APP-IO-002
        # @capture(bit_table): copy verdict and destination read-back
        step("Write a source file, copy it, and read the copy back")
        val src = "/tmp/simple_file_ops_rw_c.txt"
        val dst = "/tmp/simple_file_ops_rw_d.txt"
        expect(file_write(src, "copy me")).to_equal(true)  # oracle: the copy source must exist before copying
        expect(file_copy(src, dst)).to_equal(true)  # oracle: the copy call must report success
        expect(file_read(dst)).to_equal("copy me")  # oracle: the destination must carry the source's exact content

    it "appends to an existing file without losing prior content":
        # @req REQ-APP-IO-002
        # @capture(bit_table): append read-back combining base and appended text
        step("Write a base file, append a second line, and read both back")
        val path = "/tmp/simple_file_ops_rw_e.txt"
        expect(file_write(path, "start")).to_equal(true)  # oracle: the base write must succeed before appending
        expect(file_append(path, "\nappended")).to_equal(true)  # oracle: the append must report success
        expect(file_read(path)).to_equal("start\nappended")  # oracle: base and appended content must both survive in order

    it "reports a positive size for a non-empty file":
        # @req REQ-APP-IO-002
        # @capture(bit_table): file_size verdict for a written file
        step("Write a known payload and check its reported size")
        val path = "/tmp/simple_file_ops_rw_f.txt"
        expect(file_write(path, "some content here")).to_equal(true)  # oracle: the sized file must exist before measuring
        expect(file_size(path)).to_be_greater_than(0)  # oracle: a non-empty file must never report size 0

    it "surfaces a missing file as size -1 instead of an error":
        # @req REQ-APP-IO-002
        # @capture(bit_table): miss-path size verdict for a path never written
        step("Measure the size of a path that was never written")
        val sz = file_size_raw("/tmp/simple_file_ops_rw_missing_zz.txt")
        expect(sz).to_equal(-1)  # oracle: the miss path is pinned to -1, the documented not-found sentinel

    it "deletes a file so it no longer exists":
        # @req REQ-APP-IO-002
        # @capture(bit_table): delete verdict and post-delete existence check
        step("Write a file, delete it, and confirm it is gone")
        val path = "/tmp/simple_file_ops_rw_g.txt"
        expect(file_write(path, "gone soon")).to_equal(true)  # oracle: the file must exist before the delete
        expect(file_delete(path)).to_equal(true)  # oracle: the delete must report success
        expect(file_exists(path)).to_equal(false)  # oracle: a deleted file must no longer be present
