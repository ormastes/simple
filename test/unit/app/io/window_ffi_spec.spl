# @req: REQ-APP-IO-001

use std.spec.*
use std.io_runtime.{file_read}

use std.spec.step

describe "window FFI compatibility facade":
    it "contains no duplicate foreign declarations":
        # @req: REQ-APP-IO-001
        step("Verify: contains no duplicate foreign declarations")
        val source = file_read("src/app/io/window_ffi.spl")
        expect(source.contains("extern fn ")).to_equal(false)
        expect(source.contains("@extern(")).to_equal(false)

    it "delegates to the canonical SFFI owner with explicit exports":
        # @req: REQ-APP-IO-001
        step("Verify: delegates to the canonical SFFI owner with explicit exports")
        val source = file_read("src/app/io/window_ffi.spl")
        expect(source).to_contain("export use app.io.window_sffi.{{")
        expect(source.contains("window_create_event_loop")).to_equal(true)
        expect(source.contains("window_clipboard_set")).to_equal(true)
        expect(source.contains("window_sffi.*")).to_equal(false)

    it "does not re-export raw runtime symbols":
        # @req: REQ-APP-IO-001
        step("Verify: does not re-export raw runtime symbols")
        val source = file_read("src/app/io/window_ffi.spl")
        expect(source.contains("rt_sdl2_")).to_equal(false)
        expect(source.contains("rt_winit_")).to_equal(false)
