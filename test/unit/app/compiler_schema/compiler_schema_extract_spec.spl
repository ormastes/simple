# Compiler schema generator — extractor, id format, and determinism specs.
#
# Hardening plan §11.2 (doc/01_research/compiler/hardening/
# simple_hardening_plan_2026-08-21.md), agent A1.

use app.compiler_schema.extract.{
    VariantRow, variant_id, variant_owner, extract_enum_variants
}
use app.compiler_schema.registry.{
    enum_sources, registry_file_name, render_registry, extract_all, EnumSource
}
use app.compiler_schema.coverage.{parse_transitions, render_coverage}
use std.io_runtime.{cwd}

val FIXTURE = "# leading noise\nfn unrelated() -> i64:\n    1\n\n\"\"\"Docs.\"\"\"\nenum FixtureKind:\n    \"\"\"A doc line.\n    still doc.\n    \"\"\"\n    # a comment\n    Bare\n    WithPayload(a: i64, b: text)   # trailing note\n    Multi(first: FixtureKind,\n          second: [FixtureKind])\n    Last\n\nstruct After:\n    Ignored(x: i64)\n"

describe "compiler_schema extractor":
    it "extracts every variant of the fixture enum":
        val rows = extract_enum_variants(FIXTURE, "FixtureKind", "test.fixture")
        expect(rows.len()).to_equal(4)

    it "names variants without their payload":
        val rows = extract_enum_variants(FIXTURE, "FixtureKind", "test.fixture")
        expect(rows[0].variant).to_equal("Bare")
        expect(rows[1].variant).to_equal("WithPayload")
        expect(rows[2].variant).to_equal("Multi")
        expect(rows[3].variant).to_equal("Last")

    it "keeps the payload schema and drops trailing comments":
        val rows = extract_enum_variants(FIXTURE, "FixtureKind", "test.fixture")
        expect(rows[1].payload_schema).to_equal("WithPayload(a: i64, b: text)")

    it "folds a multi-line payload onto one line":
        val rows = extract_enum_variants(FIXTURE, "FixtureKind", "test.fixture")
        expect(rows[2].payload_schema).to_equal("Multi(first: FixtureKind, second: [FixtureKind])")

    it "stops at the end of the enum block":
        val rows = extract_enum_variants(FIXTURE, "FixtureKind", "test.fixture")
        var found = false
        for r in rows:
            if r.variant == "Ignored":
                found = true
        expect(found).to_equal(false)

    it "returns nothing for an absent enum":
        val rows = extract_enum_variants(FIXTURE, "NoSuchKind", "test.fixture")
        expect(rows.len()).to_equal(0)

describe "compiler_schema stable ids":
    it "uses the spl:variant@<module>.<Enum>.<Variant> form":
        val rows = extract_enum_variants(FIXTURE, "FixtureKind", "test.fixture")
        expect(variant_id(rows[0])).to_equal("spl:variant@test.fixture.FixtureKind.Bare")

    it "derives the owner from module and enum":
        val rows = extract_enum_variants(FIXTURE, "FixtureKind", "test.fixture")
        expect(variant_owner(rows[0])).to_equal("test.fixture.FixtureKind")

    it "names the registry file after the owner":
        expect(registry_file_name(EnumSource("p.spl", "test.fixture", "FixtureKind"))).to_equal("test.fixture.FixtureKind.sdn")

describe "compiler_schema determinism":
    it "renders the same registry text twice":
        val src = EnumSource("p.spl", "test.fixture", "FixtureKind")
        val rows = extract_enum_variants(FIXTURE, "FixtureKind", "test.fixture")
        expect(render_registry(src, rows)).to_equal(render_registry(src, rows))

    it "sorts variant ids so the diff is stable":
        val src = EnumSource("p.spl", "test.fixture", "FixtureKind")
        val rows = extract_enum_variants(FIXTURE, "FixtureKind", "test.fixture")
        val text_out = render_registry(src, rows)
        val bare = text_out.find("FixtureKind.Bare")
        val last = text_out.find("FixtureKind.Last")
        val multi = text_out.find("FixtureKind.Multi")
        expect(bare < last).to_equal(true)
        expect(last < multi).to_equal(true)

    it "emits no timestamp or host path":
        val src = EnumSource("p.spl", "test.fixture", "FixtureKind")
        val rows = extract_enum_variants(FIXTURE, "FixtureKind", "test.fixture")
        expect(render_registry(src, rows).find("/mnt/") < 0).to_equal(true)

describe "compiler_schema real compiler enums":
    it "tracks at least the twelve authoritative enums":
        expect(enum_sources().len() >= 12).to_equal(true)

    it "extracts a non-empty variant set from every tracked enum":
        var empty = 0
        for r in extract_all(cwd()):
            if r.rows.len() == 0:
                empty = empty + 1
        expect(empty).to_equal(0)

describe "compiler_schema coverage report":
    it "says so when no transition table is declared":
        val out = render_coverage(extract_all(cwd()), [])
        expect(out.find("transitions: none declared") > 0).to_equal(true)

    it "parses the A3 transition row shape":
        val rows = parse_transitions("transition:\n  from: compiler.hir.HirTypeKind\n  to: compiler.mir.MirTypeKind\n  state: covered\n  reason: lowered\n  test: test/x_spec.spl\n")
        expect(rows.len()).to_equal(1)
        expect(rows[0].state).to_equal("covered")
