"""
## Purpose and audience
Purpose: Prove that compiler_schema grammar extractor.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-APP-COMPILER-SCHEMA-001 — stable requirement identity for this spec.

# Compiler schema generator — GRAMMAR axis: production extraction, the
# tag<->production cross-check, and the rendered registry rows.
#
# Hardening plan §11.3 (doc/01_research/compiler/hardening/
# simple_hardening_plan_2026-08-21.md), Wave 2A lane C1.

use app.compiler_schema.grammar_extract.{
    ProductionRow, GrammarModel, TagIndex,
    production_id, extract_productions, extract_rows, collect_call_sites,
    build_grammar_model, grammar_reserved_tags, GRAMMAR_ENTRY_POINTS,
    render_grammar, render_index_grammar, grammar_report, grammar_file_name
}
use std.io_runtime.{cwd}

# A fixture parser module: two real productions, one nested helper, one
# non-production function, and a trailing declaration that must not be swept
# into the last production's body.
val FIXTURE = "use compiler.core.tokens.{TOK_KW_WHILE, TOK_KW_RETURN}\n\nfn helper_not_a_production() -> i64:\n    expr_ident(\"x\")\n\nfn parse_while_stmt(p: i64) -> i64:\n    # dispatch comment mentioning TOK_KW_NEVER\n    if par_kind_get(p) == TOK_KW_WHILE:\n        val body = parse_block(p)\n        return expr_while(body, 0)\n    0\n\nfn parse_return_stmt(p: i64) -> i64:\n    parser_expect(p, TOK_KW_RETURN)\n    stmt_alloc(STMT_RETURN, 0)\n\nconst TRAILING = 1\n"

fn _fixture_index() -> TagIndex:
    var ctors: {text: text} = {}
    ctors["expr_while"] = "EXPR_WHILE"
    ctors["expr_ident"] = "EXPR_IDENT"
    TagIndex(["DECL_FN", "EXPR_IDENT", "EXPR_WHILE", "STMT_RETURN"], ctors)

fn _rows() -> [ProductionRow]:
    extract_productions("/repo", "/repo/parser_fixture.spl", FIXTURE, _fixture_index())

use std.spec.step

describe "compiler_schema grammar extractor":
    it "extracts only parse_* entry points":
        step("Verify: extracts only parse_* entry points")
        # @req: REQ-APP-COMPILER-SCHEMA-001
        val rows = _rows()
        expect(rows.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(rows[0].name).to_equal("parse_while_stmt")
        expect(rows[1].name).to_equal("parse_return_stmt")

    it "records the declaring file relative to the repo root, with its line":
        step("Verify: records the declaring file relative to the repo root, with its line")
        val rows = _rows()
        expect(rows[0].path).to_equal("parser_fixture.spl")
        expect(rows[0].line).to_equal(6)  # oracle: 6 — named expected value from the requirement

    it "records the tokens a production dispatches on, ignoring comments":
        step("Verify: records the tokens a production dispatches on, ignoring comments")
        val rows = _rows()
        expect(rows[0].dispatch.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(rows[0].dispatch[0]).to_equal("TOK_KW_WHILE")
        expect(rows[1].dispatch[0]).to_equal("TOK_KW_RETURN")

    it "maps a node constructor call to the tag it stamps":
        step("Verify: maps a node constructor call to the tag it stamps")
        val rows = _rows()
        expect(rows[0].produces.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(rows[0].produces[0]).to_equal("EXPR_WHILE")

    it "records a directly named tag constant too":
        step("Verify: records a directly named tag constant too")
        val rows = _rows()
        expect(rows[1].produces[0]).to_equal("STMT_RETURN")

    it "records the productions a production calls":
        step("Verify: records the productions a production calls")
        val rows = _rows()
        assert_contains(rows[0].calls, "parse_block")

    it "does not sweep a trailing declaration into the last production":
        step("Verify: does not sweep a trailing declaration into the last production")
        val rows = _rows()
        var saw_trailing = false
        for t in rows[1].produces:
            if t == "DECL_FN":
                saw_trailing = true
        assert_false(saw_trailing)

    it "gives every production a stable id":
        step("Verify: gives every production a stable id")
        val rows = _rows()
        expect(production_id(rows[0])).to_equal("spl:production@parser_fixture.spl:parse_while_stmt")

describe "compiler_schema grammar cross-check":
    it "flags a flat-AST tag no production stamps as E-GRAMMAR-ORPHAN-TAG":
        step("Verify: flags a flat-AST tag no production stamps as E-GRAMMAR-ORPHAN-TAG")
        val model = GrammarModel(_rows(), ["EXPR_WHILE", "STMT_RETURN", "EXPR_NEVER_BUILT"],
                                 ["EXPR_NEVER_BUILT"], [], [], [])
        val body = render_grammar(model)
        assert_contains(body, "E-GRAMMAR-ORPHAN-TAG")
        assert_contains(body, "tag: EXPR_NEVER_BUILT")
        assert_contains(body, "orphan_tag_count: 1")

    it "flags an unreachable production as E-GRAMMAR-DEAD-PRODUCTION":
        step("Verify: flags an unreachable production as E-GRAMMAR-DEAD-PRODUCTION")
        val model = GrammarModel(_rows(), ["EXPR_WHILE", "STMT_RETURN"], [],
                                 ["spl:production@parser_fixture.spl:parse_orphaned"], [], [])
        val body = render_grammar(model)
        assert_contains(body, "E-GRAMMAR-DEAD-PRODUCTION")
        assert_contains(body, "parse_orphaned")
        assert_contains(body, "dead_production_count: 1")

    it "emits no issue rows when both cross-checks are clean":
        step("Verify: emits no issue rows when both cross-checks are clean")
        val model = GrammarModel(_rows(), ["EXPR_WHILE", "STMT_RETURN"], [], [], [], [])
        val body = render_grammar(model)
        expect(body.find("E-GRAMMAR-")).to_be_less_than(0)

    it "renders the same body twice — the registry is deterministic":
        step("Verify: renders the same body twice — the registry is deterministic")
        val model = GrammarModel(_rows(), ["EXPR_WHILE"], [], [], [], [])
        expect(render_grammar(model)).to_equal(render_grammar(model))

    it "names the grammar registry file after its owner":
        step("Verify: names the grammar registry file after its owner")
        expect(grammar_file_name()).to_equal("compiler.frontend.Grammar.sdn")

# A speculative production, a non-production helper that calls a production,
# and a self-recursive production (the self-call must not count as a caller).
val CALLERS_FIXTURE = "use compiler.core.ast.{{parse_imported_only}}\n\nfn try_parse_contract(p: i64) -> i64:\n    stmt_alloc(STMT_RETURN, 0)\n\nfn helper_not_a_production(p: i64) -> i64:\n    parse_leaf(p)  # comment mentioning parse_in_comment\n\nfn parse_self_rec(p: i64) -> i64:\n    parse_self_rec(p)\n"

# A desugar-style module: one fn that stamps a tag via a constructor, one that
# does not. Only the stamping fn becomes a row.
val DESUGAR_FIXTURE = "fn replace_placeholders(eid: i64) -> i64:\n    expr_while(eid, 0)\n\nfn untouched(eid: i64) -> i64:\n    eid\n"

describe "compiler_schema grammar extractor — reachability evidence":
    it "recognises try_parse_* as a production":
        step("Verify: recognises try_parse_* as a production")
        val rows = extract_productions("/repo", "/repo/callers.spl", CALLERS_FIXTURE, _fixture_index())
        expect(rows.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(rows[0].name).to_equal("try_parse_contract")
        expect(rows[0].kind).to_equal("parser")
        expect(rows[0].produces[0]).to_equal("STMT_RETURN")

    it "collects call sites from any fn body, minus use lines, comments and self-recursion":
        step("Verify: collects call sites from any fn body, minus use lines, comments and self-recursion")
        val calls = collect_call_sites(CALLERS_FIXTURE)
        expect(calls.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(calls[0]).to_equal("parse_leaf")

    it "records an auxiliary-root fn only when it stamps a tag, as kind desugar":
        step("Verify: records an auxiliary-root fn only when it stamps a tag, as kind desugar")
        val rows = extract_rows("/repo", "/repo/desugar.spl", DESUGAR_FIXTURE, _fixture_index(), "desugar")
        expect(rows.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(rows[0].name).to_equal("replace_placeholders")
        expect(rows[0].kind).to_equal("desugar")
        expect(rows[0].produces[0]).to_equal("EXPR_WHILE")

    it "renders reserved tags with their reason and never as an issue":
        step("Verify: renders reserved tags with their reason and never as an issue")
        val model = GrammarModel(_rows(), ["EXPR_WHILE", "STMT_RETURN", "STMT_ASSIGN"], [], [],
                                 ["STMT_ASSIGN: parser emits EXPR_ASSIGN"], [])
        val body = render_grammar(model)
        assert_contains(body, "reserved:\n  tag: STMT_ASSIGN\n  reason: parser emits EXPR_ASSIGN")
        assert_contains(body, "reserved_tag_count: 1")
        expect(body.find("E-GRAMMAR-")).to_be_less_than(0)

    it "renders a stale reservation or entry point as a fatal issue row":
        step("Verify: renders a stale reservation or entry point as a fatal issue row")
        val model = GrammarModel(_rows(), ["EXPR_WHILE", "STMT_RETURN"], [], [], [],
                                 ["E-GRAMMAR-STALE-RESERVED STMT_ASSIGN: now stamped by a production"])
        val body = render_grammar(model)
        assert_contains(body, "code: E-GRAMMAR-STALE-RESERVED")
        assert_contains(body, "subject: STMT_ASSIGN")
        assert_contains(body, "stale_count: 1")
        assert_contains(grammar_report(model), "1 stale row(s)")

    it "every reserved tag names a reason, and every entry point is a parse_ name":
        step("Verify: every reserved tag names a reason, and every entry point is a parse_ name")
        val reserved = grammar_reserved_tags()
        for tag in reserved.keys():
            expect(reserved[tag].len()).to_be_greater_than(10)
        for e in GRAMMAR_ENTRY_POINTS:
            expect(e.starts_with("parse_")).to_equal(true)

describe "compiler_schema grammar over the real frontend tree":
    it "finds parser productions and flat-AST tags in the live compiler":
        step("Verify: finds parser productions and flat-AST tags in the live compiler")
        val model = build_grammar_model(cwd())
        expect(model.productions.len()).to_be_greater_than(50)
        expect(model.tags.len()).to_be_greater_than(50)

    it "has a clean cross-check over the live compiler — no orphan, dead or stale rows":
        step("Verify: has a clean cross-check over the live compiler — no orphan, dead or stale rows")
        val model = build_grammar_model(cwd())
        expect(model.orphan_tags.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(model.dead_productions.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(model.stale.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "reports the cross-check counts in the index block":
        step("Verify: reports the cross-check counts in the index block")
        val model = build_grammar_model(cwd())
        val block = render_index_grammar(model)
        assert_contains(block, "owner: compiler.frontend.Grammar")
        assert_contains(block, "orphan_tag_count:")
        assert_contains(block, "dead_production_count:")

    it "summarises the model for the freshness gate to quote":
        step("Verify: summarises the model for the freshness gate to quote")
        val model = build_grammar_model(cwd())
        assert_contains(grammar_report(model), "production(s)")
        assert_contains(grammar_report(model), "orphan tag(s)")
