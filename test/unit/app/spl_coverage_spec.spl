describe "Spl Coverage":
    extern fn rt_file_read_text(path: text) -> text

    fn spl_coverage_source() -> text:
        rt_file_read_text("src/app/spl_coverage/main.spl") ?? ""

    fn coverage_library_source() -> text:
        rt_file_read_text("src/lib/nogc_sync_mut/coverage.spl") ?? ""

    it "keeps spl coverage CLI commands available":
        val source = spl_coverage_source()

        expect(source).to_contain("fn print_help()")
        expect(source).to_contain("fn cmd_dump(args: [text]) -> i64")
        expect(source).to_contain("fn cmd_status(args: [text]) -> i64")
        expect(source).to_contain("fn cmd_clear() -> i64")
        expect(source).to_contain("fn main() -> i64")
        expect(source).to_contain("SIMPLE_COVERAGE=1")

    it "supports loading a persisted coverage artifact via --file instead of live in-memory state":
        val source = spl_coverage_source()

        # dump/status must consult get_arg for --file before falling back to
        # coverage_dump_sdn() (live process state) — this is the cross-process
        # capability gap: prior to this, `dump`/`status` could only ever read
        # THIS process's coverage, never a file written by a prior
        # `simple test --coverage` run.
        expect(source).to_contain("fn _load_coverage_file(path: text) -> CoverageFileLoad")
        expect(source).to_contain("get_arg(args, \"--file\", \"\")")

        # Each of the three deliberate failure modes must produce a distinct,
        # explicit error rather than a silent empty dump that reads as
        # "zero coverage" (the false-green trap this repo has been bitten by
        # before).
        expect(source).to_contain("coverage file not found:")
        expect(source).to_contain("could not read coverage file (unreadable):")
        expect(source).to_contain("coverage file is empty:")
        expect(source).to_contain("coverage file is malformed")

    it "keeps coverage result model and check API available":
        val source = coverage_library_source()

        expect(source).to_contain("struct FileResult:")
        expect(source).to_contain("struct CoverageResult:")
        expect(source).to_contain("fn _parse_coverage_file(content: text) -> [FileResult]")
        expect(source).to_contain("fn _calculate_coverage(coverage_type: text, files: [FileResult]) -> f64")
        expect(source).to_contain("fn check_coverage(coverage_type: text, pattern: text, minimum: f64 = 0.0, maximum: f64 = 100.0, minimum_check: bool = true) -> CoverageResult")
        expect(source).to_contain("fn reload_coverage_data()")
