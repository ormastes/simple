"""
## Purpose and audience
Purpose: Prove that AgentPool.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-TEST-DAEMON-001 — stable requirement identity for this spec.
use std.spec.{describe, it, expect}
use app.test_daemon.agent_pool.{agent_pool_new}

describe "AgentPool":
    it "registers agents":
        step("Verify: registers agents")
        # @req: REQ-APP-TEST-DAEMON-001
        val pool = agent_pool_new(2)
        expect(pool.register_agent("agent-1", "linux")).to_equal(true)
        expect(pool.register_agent("agent-2", "mac")).to_equal(true)
        expect(pool.active_agent_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "claims batches only for registered agents":
        step("Verify: claims batches only for registered agents")
        val pool = agent_pool_new(2)
        pool.load_pending_tests(["test/a.spl", "test/b.spl", "test/c.spl"])
        expect(pool.claim_batch("missing").len()).to_equal(0)

        pool.register_agent("agent-1", "linux")
        val batch = pool.claim_batch("agent-1")
        expect(batch.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(pool.pending_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "does not double-assign completed or in-progress tests when loading pending":
        step("Verify: does not double-assign completed or in-progress tests when loading pending")
        val pool = agent_pool_new(5)
        pool.register_agent("agent-1", "linux")
        pool.load_pending_tests(["test/a.spl", "test/b.spl"])
        val batch = pool.claim_batch("agent-1")
        expect(batch.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

        pool.load_pending_tests(["test/a.spl", "test/b.spl", "test/c.spl"])
        expect(pool.pending_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "records results and updates counts":
        step("Verify: records results and updates counts")
        val pool = agent_pool_new(5)
        pool.register_agent("agent-1", "linux")
        pool.load_pending_tests(["test/a.spl"])
        pool.claim_batch("agent-1")

        expect(pool.report_result("agent-1", "test/a.spl", 2, 1, 0, 10, "ok")).to_equal(true)
        expect(pool.completed_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "returns in-progress work to pending on deregister":
        step("Verify: returns in-progress work to pending on deregister")
        val pool = agent_pool_new(5)
        pool.register_agent("agent-1", "linux")
        pool.load_pending_tests(["test/a.spl", "test/b.spl"])
        val batch = pool.claim_batch("agent-1")
        expect(batch.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

        expect(pool.deregister_agent("agent-1")).to_equal(true)
        expect(pool.active_agent_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(pool.pending_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement
