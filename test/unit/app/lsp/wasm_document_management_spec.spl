"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-APP behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/app/lsp/wasm_document_management_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-APP-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# WASM LSP Document Management Tests
#
# Tests core parser parsing of various document patterns.
# Validates error detection for bracket mismatches.

use app.lsp.parser_adapter.{ParserAdapter, ParseResult, ParseDiagnostic}
use std.spec.{step}

describe "WASM Document Management":

    context "Parsing Simple documents":
        it "parses simple variable declaration":
            # @req: REQ-UNIT-APP-001
            step("Verify: parses simple variable declaration")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val adapter = ParserAdapter.create_core()
            val result = adapter.parse("val name = \"Alice\"")
            expect(result.success).to_equal(true)

        it "parses mutable variable":
            # @req: REQ-UNIT-APP-002
            step("Verify: parses mutable variable")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val adapter = ParserAdapter.create_core()
            val result = adapter.parse("var count = 0")
            expect(result.success).to_equal(true)

        it "parses function with body":
            # @req: REQ-UNIT-APP-003
            step("Verify: parses function with body")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val adapter = ParserAdapter.create_core()
            val code = "fn square(x: i64) -> i64:\n    x * x"
            val result = adapter.parse(code)
            expect(result.success).to_equal(true)

        it "parses empty string":
            # @req: REQ-UNIT-APP-004
            step("Verify: parses empty string")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val adapter = ParserAdapter.create_core()
            val result = adapter.parse("")
            expect(result.success).to_equal(true)

        it "parses whitespace only":
            # @req: REQ-UNIT-APP-005
            step("Verify: parses whitespace only")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val adapter = ParserAdapter.create_core()
            val result = adapter.parse("   \n   \n")
            expect(result.success).to_equal(true)

    context "Bracket error detection":
        it "reports error line for unmatched paren":
            # @req: REQ-UNIT-APP-006
            step("Verify: reports error line for unmatched paren")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val adapter = ParserAdapter.create_core()
            val result = adapter.parse("val x = )")
            expect(result.diagnostics.len()).to_be_greater_than(0)
            expect(result.diagnostics[0].line).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(result.diagnostics[0].severity).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "reports error for unmatched bracket":
            # @req: REQ-UNIT-APP-007
            step("Verify: reports error for unmatched bracket")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val adapter = ParserAdapter.create_core()
            val result = adapter.parse("val arr = ]")
            expect(result.diagnostics.len()).to_be_greater_than(0)
            expect(result.diagnostics[0].line).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "handles nested brackets correctly":
            # @req: REQ-UNIT-APP-008
            step("Verify: handles nested brackets correctly")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val adapter = ParserAdapter.create_core()
            val result = adapter.parse("val x = [[1, 2], [3, 4]]")
            expect(result.success).to_equal(true)

        it "handles mixed brackets and parens":
            # @req: REQ-UNIT-APP-009
            step("Verify: handles mixed brackets and parens")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val adapter = ParserAdapter.create_core()
            val result = adapter.parse("val x = foo([1, 2], (3 + 4))")
            expect(result.success).to_equal(true)

    context "Multi-line document parsing":
        it "parses describe/it test blocks":
            # @req: REQ-UNIT-APP-010
            step("Verify: parses describe/it test blocks")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val adapter = ParserAdapter.create_core()
            val code = "describe \"test\":\n    it \"works\":\n        expect(1).to_equal(1)"
            val result = adapter.parse(code)
            expect(result.success).to_equal(true)

        it "parses class with methods":
            # @req: REQ-UNIT-APP-011
            step("Verify: parses class with methods")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val adapter = ParserAdapter.create_core()
            val code = "class Counter:\n    count: i64\n    me increment():\n        self.count = self.count + 1"
            val result = adapter.parse(code)
            expect(result.success).to_equal(true)

        it "parses enum definitions":
            # @req: REQ-UNIT-APP-012
            step("Verify: parses enum definitions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val adapter = ParserAdapter.create_core()
            val code = "enum Color:\n    Red\n    Green\n    Blue"
            val result = adapter.parse(code)
            expect(result.success).to_equal(true)

    context "Diagnostic properties":
        it "diagnostic has correct message for paren":
            # @req: REQ-UNIT-APP-013
            step("Verify: diagnostic has correct message for paren")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val adapter = ParserAdapter.create_core()
            val result = adapter.parse(")")
            expect(result.diagnostics[0].message).to_contain("parenthesis")

        it "diagnostic has correct message for bracket":
            # @req: REQ-UNIT-APP-014
            step("Verify: diagnostic has correct message for bracket")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val adapter = ParserAdapter.create_core()
            val result = adapter.parse("]")
            expect(result.diagnostics[0].message).to_contain("bracket")

        it "diagnostic has error severity":
            # @req: REQ-UNIT-APP-015
            step("Verify: diagnostic has error severity")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val adapter = ParserAdapter.create_core()
            val result = adapter.parse(")")
            expect(result.diagnostics[0].severity).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
