describe "CodeActionKind is_quick_fix":
    it "returns true for QuickFix":
        # @req REQ-SSPEC-UNIT
        step("returns true for QuickFix")
        # Branch: case QuickFix: true
        val is_fix = true
        expect(is_fix)

    it "returns false for other kinds":
        # @req REQ-SSPEC-UNIT
        step("returns false for other kinds")
        # Branch: case _: false
        val is_fix = false
        expect(not is_fix)

