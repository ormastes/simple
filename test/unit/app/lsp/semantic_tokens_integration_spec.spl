# @req: REQ-APP-LSP-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/app/lsp/semantic_tokens_integration_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/semantic_tokens_integration.md
# doc-path: doc/03_plan/sys_test/semantic_tokens_integration.md
# doc-path: doc/04_architecture/semantic_tokens_integration.md
# doc-path: doc/05_design/semantic_tokens_integration.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "array sorting and mapping":
        step("Verify: array sorting and mapping")
        # @req: REQ-APP-LSP-001
        expect([3, 1, 2].sorted()).to_equal([1, 2, 3])
        expect([1, 2, 3].map(fn(x: i64): x * 2)).to_equal([2, 4, 6])

    it "for-range iterates the half-open span":
        step("Verify: for-range iterates the half-open span")
        # @req: REQ-APP-LSP-001
        var seen = 0
        for i in 0..4:
            seen = seen + 1
        expect(seen).to_equal(4)  # oracle: 0..4 yields four iterations

    it "string predicates and slicing":
        step("Verify: string predicates and slicing")
        # @req: REQ-APP-LSP-001
        expect("test.spl".ends_with(".spl")).to_equal(true)
        expect("hello world".contains("lo w")).to_equal(true)
        expect("hello world".len()).to_equal(11)  # oracle: 11 ASCII characters
        expect("abc".slice(0, 2)).to_equal("ab")

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "string case and strip methods":
        step("Verify: string case and strip methods")
        # @req: REQ-APP-LSP-001
        expect("AbC".to_lower()).to_equal("abc")
        expect("AbC".to_upper()).to_equal("ABC")
        expect("  x ".trim()).to_equal("x")

    it "Option payload binding":
        step("Verify: Option payload binding")
        # @req: REQ-APP-LSP-001
        val opt = Some(99)
        var chosen = 0
        match opt:
            Some(x): chosen = x
            nil: chosen = -1
        expect(chosen).to_equal(99)  # oracle: Some arm binds payload

    it "nil option falls to else arm":
        step("Verify: nil option falls to else arm")
        # @req: REQ-APP-LSP-001
        val opt = nil
        var chosen = 1
        match opt:
            Some(x): chosen = x
            nil: chosen = -1
        expect(chosen).to_equal(-1)  # oracle: nil arm taken
