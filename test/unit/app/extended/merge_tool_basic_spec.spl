# @req: REQ-APP-EXTENDED-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/app/extended/merge_tool_basic_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

# @req: REQ-APP-APP_TOOL-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/app_tool_behavior.md
# doc-path: doc/03_plan/sys_test/app_tool_behavior.md
# doc-path: doc/04_architecture/lib/app_tool.md
# doc-path: doc/05_design/lib/app_tool_oracles.md
# @manual: primary

use std.spec
use std.io.{env_get, process_run}
use std.spec.step

# doc-path: doc/01_research/local/merge_tool_basic.md
# doc-path: doc/03_plan/sys_test/merge_tool_basic.md
# doc-path: doc/04_architecture/merge_tool_basic.md
# doc-path: doc/05_design/merge_tool_basic.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "boolean operators short-circuit to expected truth table":
        step("Verify: boolean operators short-circuit to expected truth table")
        # @req: REQ-APP-EXTENDED-001
        expect(true and false).to_equal(false)
        expect(true or false).to_equal(true)
        expect(not true).to_equal(false)

    it "numeric comparison helpers":
        step("Verify: numeric comparison helpers")
        # @req: REQ-APP-EXTENDED-001
        expect(abs(-7)).to_equal(7)  # oracle: absolute value
        expect(max(3, 9)).to_equal(9)  # oracle: larger operand
        expect(min(3, 9)).to_equal(3)  # oracle: smaller operand

    it "integer arithmetic precedence":
        step("Verify: integer arithmetic precedence")
        # @req: REQ-APP-EXTENDED-001
        expect(2 + 3 * 4).to_equal(14)  # oracle: * binds tighter than +
        expect(10 - 2 * 3).to_equal(4)  # oracle: multiplication precedes subtraction
        expect((2 + 3) * 4).to_equal(20)  # oracle: parentheses force additive group first

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "array filtering and membership":
        step("Verify: array filtering and membership")
        # @req: REQ-APP-EXTENDED-001
        expect([1, 2, 3].filter(fn(x: i64): x > 1)).to_equal([2, 3])
        expect([1, 2, 3].contains(2)).to_equal(true)
        expect([1, 2].concat([3])).to_equal([1, 2, 3])

    it "base64 RFC 4648 vectors and roundtrip":
        step("Verify: base64 RFC 4648 vectors and roundtrip")
        # @req: REQ-APP-EXTENDED-001
        use std.common.base_encoding.base64.{base64_encode, base64_decode}
        expect(base64_encode("Man")).to_equal("TWFu")  # oracle: RFC 4648 illustration
        expect(base64_decode("TWFu")).to_equal("Man")
        expect(base64_decode(base64_encode("roundtrip"))).to_equal("roundtrip")

    it "for-range iterates the half-open span":
        step("Verify: for-range iterates the half-open span")
        # @req: REQ-APP-EXTENDED-001
        var seen = 0
        for i in 0..4:
            seen = seen + 1
        expect(seen).to_equal(4)  # oracle: 0..4 yields four iterations
