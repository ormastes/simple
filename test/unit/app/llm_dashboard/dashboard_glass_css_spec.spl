# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use app.llm_dashboard.gui.dashboard_glass_css.{generate_dashboard_glass_css}

describe "dashboard_glass_css":
    # @manual scenario evidence
    describe "generate_dashboard_glass_css":
        it "AC-1: returns a non-empty CSS string":
            # @req REQ-SSPEC-UNIT
            step("AC-1: returns a non-empty CSS string")
            val css = generate_dashboard_glass_css()
            expect(css.len()).to_be_greater_than(0)

        it "AC-1: contains Stitch obsidian accent color #0A84FF":
            # @req REQ-SSPEC-UNIT
            step("AC-1: contains Stitch obsidian accent color #0A84FF")
            val css = generate_dashboard_glass_css()
            expect(css).to_contain("#0A84FF")

        it "AC-1: contains backdrop-filter for glass effect":
            # @req REQ-SSPEC-UNIT
            step("AC-1: contains backdrop-filter for glass effect")
            val css = generate_dashboard_glass_css()
            expect(css).to_contain("backdrop-filter")

        it "AC-2: contains .tab-btn class binding":
            # @req REQ-SSPEC-UNIT
            step("AC-2: contains .tab-btn class binding")
            val css = generate_dashboard_glass_css()
            expect(css).to_contain(".tab-btn")

        it "AC-2: contains body background using Stitch surface token":
            # @req REQ-SSPEC-UNIT
            step("AC-2: contains body background using Stitch surface token")
            val css = generate_dashboard_glass_css()
            expect(css).to_contain("--surface")
