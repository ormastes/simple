# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# TaskKind.Job Variant Spec
#
# Tests that TaskKind.Job exists and task_kind_name returns "job".

use std.spec.step

use app.llm_dashboard.data.types (TaskKind, task_kind_name, ManagedTask)

describe "TaskKind.Job variant":
    # @manual scenario evidence
    it "task_kind_name returns job for TaskKind.Job":
        # @req REQ-SSPEC-UNIT
        step("task_kind_name returns job for TaskKind.Job")
        val name = task_kind_name(TaskKind.Job)
        expect(name).to_equal("job")

    it "existing Loop variant still works":
        # @req REQ-SSPEC-UNIT
        step("existing Loop variant still works")
        expect(task_kind_name(TaskKind.Loop)).to_equal("loop")

    it "existing Schedule variant still works":
        # @req REQ-SSPEC-UNIT
        step("existing Schedule variant still works")
        expect(task_kind_name(TaskKind.Schedule)).to_equal("schedule")

    it "existing Daemon variant still works":
        # @req REQ-SSPEC-UNIT
        step("existing Daemon variant still works")
        expect(task_kind_name(TaskKind.Daemon)).to_equal("daemon")

    it "existing RemoteControl variant still works":
        # @req REQ-SSPEC-UNIT
        step("existing RemoteControl variant still works")
        expect(task_kind_name(TaskKind.RemoteControl)).to_equal("remote")

    it "ManagedTask can be constructed with kind Job":
        # @req REQ-SSPEC-UNIT
        step("ManagedTask can be constructed with kind Job")
        val task = ManagedTask.new("id1", TaskKind.Job, "test job", "bin/simple test")
        expect(task_kind_name(task.kind)).to_equal("job")
        expect(task.id).to_equal("id1")
