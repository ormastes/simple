# MCP Tool Table Generator Homogenization Spec
#
# Tests that generator tool entries in the MCP tool table are correctly
# homogenized: feature_gen/task_gen have no name param, todo_gen has
# read_only=true, path-taking tools have required_json.
#
# Ported from the removed `_find_tool_entry` helper API: entries now come
# from `get_tool_table()` (including CLI tiers) and schema lives in the
# `props_json` / `required_json` text fields of `McpToolEntry`.

use app.mcp.tool_table (get_tool_table)
use app.mcp.tool_registry (McpToolEntry, tool_entry)

fn find_entry(name: text) -> McpToolEntry:
    val table = get_tool_table()
    for e in table:
        if e.tool_name == name:
            return e
    tool_entry("", "", "", "", "", 0)

describe "simple_feature_gen tool entry":
    it "has no name parameter":
        val entry = find_entry("simple_feature_gen")
        val has_name = entry.props_json.contains("\"name\"")
        expect(has_name).to_equal(false)

    it "has a non-empty description":
        val entry = find_entry("simple_feature_gen")
        expect(entry.description.len() > 0).to_equal(true)

    it "description mentions feature or regenerate":
        val entry = find_entry("simple_feature_gen")
        val desc_lower = entry.description.lower()
        val mentions_feature = desc_lower.contains("feature") or desc_lower.contains("regenerate")
        expect(mentions_feature).to_equal(true)

describe "simple_task_gen tool entry":
    it "has no name parameter":
        val entry = find_entry("simple_task_gen")
        val has_name = entry.props_json.contains("\"name\"")
        expect(has_name).to_equal(false)

    it "has a non-empty description":
        val entry = find_entry("simple_task_gen")
        expect(entry.description.len() > 0).to_equal(true)

describe "simple_todo_gen tool entry":
    it "has read_only set to true":
        val entry = find_entry("simple_todo_gen")
        expect(entry.read_only).to_equal(true)

describe "simple_spec_gen tool entry":
    it "has path parameter":
        val entry = find_entry("simple_spec_gen")
        val has_path = entry.props_json.contains("\"path\"")
        expect(has_path).to_equal(true)

describe "simple_spec_coverage tool entry":
    it "has read_only set to true":
        val entry = find_entry("simple_spec_coverage")
        expect(entry.read_only).to_equal(true)
