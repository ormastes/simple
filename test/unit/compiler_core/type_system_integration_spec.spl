"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER_CORE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler_core/type_system_integration_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-COMPILER_CORE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Type System Integration Tests
#
# Tests for advanced type system integration (type_checker, type_erasure, type_inference)


describe "Type Inference in Variable Declarations":
    it "infers i64 from integer literal":
        # @req: REQ-UNIT-COMPILER_CORE-001
        step("Verify: infers i64 from integer literal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 42
        expect(x).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

    it "infers f64 from float literal":
        # @req: REQ-UNIT-COMPILER_CORE-002
        step("Verify: infers f64 from float literal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val pi = 3.14
        expect(pi).to_equal(3.14)

    it "infers text from string literal":
        # @req: REQ-UNIT-COMPILER_CORE-003
        step("Verify: infers text from string literal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val greeting = "Hello"
        expect(greeting).to_equal("Hello")

    it "infers bool from boolean literal":
        # @req: REQ-UNIT-COMPILER_CORE-004
        step("Verify: infers bool from boolean literal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val flag = true
        expect(flag).to_equal(true)

    it "infers type from binary operation":
        # @req: REQ-UNIT-COMPILER_CORE-005
        step("Verify: infers type from binary operation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val sum = 10 + 20
        expect(sum).to_equal(30)  # oracle: expected value 30 is the behavior asserted by this regression spec

    it "infers bool from comparison":
        # @req: REQ-UNIT-COMPILER_CORE-006
        step("Verify: infers bool from comparison")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val is_greater = 5 > 3
        expect(is_greater).to_equal(true)

    it "infers bool from logical operation":
        # @req: REQ-UNIT-COMPILER_CORE-007
        step("Verify: infers bool from logical operation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val both_true = true and true
        expect(both_true).to_equal(true)

describe "Type Checking in Function Calls":
    it "validates correct parameter types":
        # @req: REQ-UNIT-COMPILER_CORE-008
        step("Verify: validates correct parameter types")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn multiply(a: i64, b: i64) -> i64:
            a * b
        val result = multiply(6, 7)
        expect(result).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

    it "works with mixed parameter types":
        # @req: REQ-UNIT-COMPILER_CORE-009
        step("Verify: works with mixed parameter types")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn format_number(num: i64, suffix: text) -> text:
            str(num) + suffix
        val result = format_number(100, " units")
        expect(result).to_equal("100 units")

    it "handles bool parameters":
        # @req: REQ-UNIT-COMPILER_CORE-010
        step("Verify: handles bool parameters")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn negate(x: bool) -> bool:
            not x
        val result = negate(false)
        expect(result).to_equal(true)

    it "handles f64 parameters":
        # @req: REQ-UNIT-COMPILER_CORE-011
        step("Verify: handles f64 parameters")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn square(x: f64) -> f64:
            x * x
        val result = square(4.0)
        expect(result).to_equal(16.0)

describe "Monomorphization Cache":
    it "caches function calls with same types":
        # @req: REQ-UNIT-COMPILER_CORE-012
        step("Verify: caches function calls with same types")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn identity(x):
            x
        val result1 = identity(10)
        val result2 = identity(20)
        expect(result1).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec
        expect(result2).to_equal(20)  # oracle: expected value 20 is the behavior asserted by this regression spec

    it "handles different type instantiations":
        # @req: REQ-UNIT-COMPILER_CORE-013
        step("Verify: handles different type instantiations")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn first(a, b):
            a
        val int_result = first(42, 100)
        val text_result = first("hello", "world")
        expect(int_result).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec
        expect(text_result).to_equal("hello")

describe "Complex Type System Features":
    it "combines type inference with type checking":
        # @req: REQ-UNIT-COMPILER_CORE-014
        step("Verify: combines type inference with type checking")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn process(value: i64) -> i64:
            value * 2
        val input = 21
        val output = process(input)
        expect(output).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

    it "works with nested function calls":
        # @req: REQ-UNIT-COMPILER_CORE-015
        step("Verify: works with nested function calls")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        fn add_ten(x: i64) -> i64:
            x + 10
        fn double_it(y: i64) -> i64:
            y * 2
        val result = double_it(add_ten(5))
        expect(result).to_equal(30)  # oracle: expected value 30 is the behavior asserted by this regression spec

    it "handles array types":
        # @req: REQ-UNIT-COMPILER_CORE-016
        step("Verify: handles array types")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val numbers = [1, 2, 3, 4, 5]
        var sum: i64 = 0
        for n in numbers:
            sum = sum + n
        expect(sum).to_equal(15)  # oracle: expected value 15 is the behavior asserted by this regression spec

    it "infers types in control flow":
        # @req: REQ-UNIT-COMPILER_CORE-017
        step("Verify: infers types in control flow")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val condition = 10 > 5
        val message = if condition: "yes" else: "no"
        expect(message).to_equal("yes")
