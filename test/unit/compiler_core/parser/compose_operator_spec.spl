# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

fn double(x: i64) -> i64: x * 2
fn triple(x: i64) -> i64: x * 3
fn add1(x: i64) -> i64: x + 1

describe "Compose operator >>":
    # @manual scenario evidence
    it "basic compose":
        # @req REQ-SSPEC-UNIT
        step("basic compose")
        val f = double >> triple
        expect(f(2)).to_equal(12)

    it "chained compose":
        # @req REQ-SSPEC-UNIT
        step("chained compose")
        val f = add1 >> double >> triple
        expect(f(1)).to_equal(12)

    it "compose with pipe":
        # @req REQ-SSPEC-UNIT
        step("compose with pipe")
        val f = double >> add1
        val result = 5 |> f
        expect(result).to_equal(11)
