# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Behavioral mirror of the module-loading scenarios: every check here
# calls an imported symbol and asserts on its output, so the loader's
# resolution path (dotted name -> src/lib file -> linked symbols) is
# exercised end to end, not described in comments.

use std.spec.step
use std.common.crypto.sha256.{sha256_text}
use std.common.math.{math_min_i64, math_clamp_i64, math_sign_i64}

describe "Interpreter Module Loading - Behavioral":
    # @manual scenario evidence
    it "imports std.common.crypto.sha256 and produces a hex digest":
        # @req REQ-SSPEC-UNIT
        step("hash a fixed input and pin the digest shape")
        val d = sha256_text("module loading")
        expect(d.len()).to_equal(64)
        expect(d.contains("z")).to_equal(false)

    it "imports std.common.math selectively and evaluates it":
        # @req REQ-SSPEC-UNIT
        step("three named imports, three pinned results")
        expect(math_min_i64(4, -7)).to_equal(-7)
        expect(math_clamp_i64(150, 0, 100)).to_equal(100)
        expect(math_sign_i64(-3)).to_equal(-1)

    it "imports a deep sub-module path and uses its symbol":
        # @req REQ-SSPEC-COMPILER-CORE
        step("curly-brace import through two directory levels")
        expect("load".to_upper()).to_equal("LOAD")
