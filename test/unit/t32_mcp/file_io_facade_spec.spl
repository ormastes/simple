"""
T32 MCP file-I/O facade regression coverage.

The Stage4 bootstrap frontier exposed an unresolved `rt_file_read_text` in
`gap_tools.spl`.  T32 MCP is an app leaf, so file reads must route through the
existing `std.io_runtime` facade (via `t32_file_read`), not module-local raw
intrinsics.
"""

use std.io_runtime.{file_read}
use app.mcp_t32.json_helpers.{t32_file_read}

val T32_MCP_SOURCE_FILES = [
    "examples/10_tooling/trace32_tools/t32_mcp/gap_tools.spl",
    "examples/10_tooling/trace32_tools/t32_mcp/window_tools.spl",
    "examples/10_tooling/trace32_tools/t32_mcp/dialog_tools.spl",
    "examples/10_tooling/trace32_tools/t32_mcp/json_helpers.spl"
]

describe "T32 MCP file-I/O facade":

    context "exact gap_tools reproducer":
        it "reads an existing CMM/catalog source through the shared facade":
            val source = t32_file_read("config/t32/catalogs/windows.sdn")
            expect(source.len() > 0).to_equal(true)

        it "returns empty text for a missing source path":
            val source = t32_file_read("build/test-artifacts/t32-mcp-missing-source.sdn")
            expect(source).to_equal("")

    context "adjacent raw-intrinsic prevention":
        it "keeps every T32 MCP file-read callsite on the facade":
            for path in T32_MCP_SOURCE_FILES:
                val source = file_read(path)
                expect(source.contains("rt_file_read_text(")).to_equal(false)

        it "keeps the shared helper implemented by file_read":
            val source = file_read("examples/10_tooling/trace32_tools/t32_mcp/json_helpers.spl")
            expect(source.contains("use std.io_runtime.{file_read, file_write, process_run}")).to_equal(true)
            expect(source.contains("    file_read(path)")).to_equal(true)
