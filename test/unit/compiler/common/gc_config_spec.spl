# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step
use std.spec.{describe, it, expect}

use compiler.common.gc_config.{is_nogc_family, is_gc_family, is_noalloc_family, is_allocating_family, gc_mode_from_family_prefix}

fn main() -> ():
    describe("compiler common gc config", fn() -> ():
        it("classifies std runtime family prefixes", fn() -> ():
            # @req REQ-SSPEC-UNIT
            step("probe each runtime family prefix")
            expect(is_nogc_family("std.nogc_sync_mut.io")).to_equal(true)
            expect(is_gc_family("std.gc_async_mut.gpu")).to_equal(true)
            expect(is_noalloc_family("std.nogc_async_mut_noalloc.baremetal")).to_equal(true)
            expect(is_allocating_family("std.common.text")).to_equal(true)
            expect(is_nogc_family("std.common.text")).to_equal(false)
        )

        it("derives the gc mode of a module from its family prefix", fn() -> ():
            # @req REQ-SSPEC-UNIT
            step("derive modes for a nogc and a plain module")
            expect(gc_mode_from_family_prefix("std.nogc_sync_mut.io.fs").is_nogc()).to_equal(true)
            expect(gc_mode_from_family_prefix("std.common.text").is_gc()).to_equal(true)
        )
    )
