# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step
use std.spec.{describe, it, expect}

use compiler.common.config.{CompilerProfile}
use compiler.common.di.{DiContainer}

fn main() -> ():
    describe("compiler common dependency injection container", fn() -> ():
        it("starts empty for a profile and records the profile name", fn() -> ():
            # @req REQ-SSPEC-UNIT
            step("create a dev-profile container")
            val di = DiContainer.for_profile(CompilerProfile.Dev)
            expect(di.profile).to_equal("dev")
            expect(di.has_binding("Compiler")).to_equal(false)
            expect(di.is_locked()).to_equal(false)
        )

        it("activates profile-specific bindings only for the matching profile", fn() -> ():
            # @req REQ-SSPEC-UNIT
            step("bind for prod while running dev")
            val di = DiContainer.for_profile(CompilerProfile.Dev)
            di.bind_for_profile("Backend", CompilerProfile.Prod, \: "prod-backend")
            expect(di.has_binding("Backend")).to_equal(false)
            step("bind for dev while running dev")
            di.bind_for_profile("Runner", CompilerProfile.Dev, \: "dev-runner")
            expect(di.has_binding("Runner")).to_equal(true)
        )

        it("locks reject further bindings", fn() -> ():
            # @req REQ-SSPEC-UNIT
            step("lock the container and attempt a bind")
            val di = DiContainer.for_profile(CompilerProfile.Test)
            di.lock()
            di.bind("X", \: 1)
            expect(di.is_locked()).to_equal(true)
            expect(di.has_binding("X")).to_equal(false)
        )
    )
