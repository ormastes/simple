# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step
use std.spec.{describe, it, expect}

use compiler.common.error.{Severity, module_not_found, failed_to_read_file, argument_count_mismatch}

fn main() -> ():
    describe("compiler common error types", fn() -> ():
        it("renders severities as diagnostic labels", fn() -> ():
            # @req REQ-SSPEC-UNIT
            step("convert each severity to its label")
            expect(Severity.Error.to_string()).to_equal("error")
            expect(Severity.Warning.to_string()).to_equal("warning")
            expect(Severity.Note.to_string()).to_equal("note")
        )

        it("formats module-not-found and read-failure messages with the offending names", fn() -> ():
            # @req REQ-SSPEC-UNIT
            step("build two factory errors")
            expect(module_not_found("foo.bar").message.find("foo.bar") ?? -1).to_be_greater_than(-1)
            expect(failed_to_read_file("a.spl", "denied").message.find("denied") ?? -1).to_be_greater_than(-1)
        )

        it("reports argument count mismatches with both counts", fn() -> ():
            # @req REQ-SSPEC-UNIT
            step("build a count-mismatch error")
            # oracle: expected 2 vs found 3 are the counts passed in
            val msg = argument_count_mismatch(2, 3).message
            expect(msg.find("2") ?? -1).to_be_greater_than(-1)
            expect(msg.find("3") ?? -1).to_be_greater_than(-1)
        )
    )
