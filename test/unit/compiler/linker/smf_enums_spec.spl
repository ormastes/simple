"""
## Purpose and audience
Purpose: Prove that Platform enum.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-LINKER-001 — stable requirement identity for this spec.

# SMF Enums Specification
#
# Unit tests for SMF enum types:
# - Platform: OS/target platform identifiers
# - Arch: CPU architecture identifiers
# - CompressionType: Compression algorithm identifiers
# - SmfAppType: Application type hints

use compiler.backend.linker.smf_enums.*
use std.spec

describe "Platform enum":
    """Tests Platform enum u8 conversion, round-trip, and name methods."""
    it "converts from u8 to Platform correctly":
        step("Verify: converts from u8 to Platform correctly")
        # @req: REQ-COMPILER-LINKER-001
        expect(Platform.Any.to_u8()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(Platform.Linux.to_u8()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(Platform.Windows.to_u8()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(Platform.MacOS.to_u8()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(Platform.FreeBSD.to_u8()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(Platform.None_.to_u8()).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "defaults to Any for unknown u8 values":
        step("Verify: defaults to Any for unknown u8 values")
        expect(Platform.Any.to_u8()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "converts Platform to u8 correctly":
        step("Verify: converts Platform to u8 correctly")
        expect(Platform.Any.to_u8()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(Platform.Linux.to_u8()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(Platform.Windows.to_u8()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(Platform.MacOS.to_u8()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(Platform.FreeBSD.to_u8()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(Platform.None_.to_u8()).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "round-trips u8 conversion correctly":
        step("Verify: round-trips u8 conversion correctly")
        expect(Platform.Any.to_u8()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(Platform.Linux.to_u8()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(Platform.Windows.to_u8()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(Platform.MacOS.to_u8()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(Platform.FreeBSD.to_u8()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(Platform.None_.to_u8()).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "returns correct platform names":
        step("Verify: returns correct platform names")
        expect(Platform.Any.name()).to_equal("any")
        expect(Platform.Linux.name()).to_equal("linux")
        expect(Platform.Windows.name()).to_equal("windows")
        expect(Platform.MacOS.name()).to_equal("macos")
        expect(Platform.FreeBSD.name()).to_equal("freebsd")
        expect(Platform.None_.name()).to_equal("none")

describe "Arch enum":
    """Tests Arch enum u8 conversion, round-trip, bitness detection, and name methods."""
    it "converts from u8 to Arch correctly":
        step("Verify: converts from u8 to Arch correctly")
        expect(Arch.X86_64.to_u8()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(Arch.Aarch64.to_u8()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(Arch.X86.to_u8()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(Arch.Arm.to_u8()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(Arch.Riscv64.to_u8()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(Arch.Riscv32.to_u8()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(Arch.Wasm32.to_u8()).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(Arch.Wasm64.to_u8()).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "defaults to X86_64 for unknown u8 values":
        step("Verify: defaults to X86_64 for unknown u8 values")
        expect(Arch.X86_64.to_u8()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "converts Arch to u8 correctly":
        step("Verify: converts Arch to u8 correctly")
        expect(Arch.X86_64.to_u8()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(Arch.Aarch64.to_u8()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(Arch.X86.to_u8()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(Arch.Arm.to_u8()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(Arch.Riscv64.to_u8()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(Arch.Riscv32.to_u8()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(Arch.Wasm32.to_u8()).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(Arch.Wasm64.to_u8()).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "round-trips u8 conversion correctly":
        step("Verify: round-trips u8 conversion correctly")
        expect(Arch.X86_64.to_u8()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(Arch.Aarch64.to_u8()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(Arch.X86.to_u8()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(Arch.Arm.to_u8()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(Arch.Riscv64.to_u8()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(Arch.Riscv32.to_u8()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(Arch.Wasm32.to_u8()).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(Arch.Wasm64.to_u8()).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "returns correct architecture names":
        step("Verify: returns correct architecture names")
        expect(Arch.X86_64.name()).to_equal("x86_64")
        expect(Arch.Aarch64.name()).to_equal("aarch64")
        expect(Arch.X86.name()).to_equal("x86")
        expect(Arch.Arm.name()).to_equal("arm")
        expect(Arch.Riscv64.name()).to_equal("riscv64")
        expect(Arch.Riscv32.name()).to_equal("riscv32")
        expect(Arch.Wasm32.name()).to_equal("wasm32")
        expect(Arch.Wasm64.name()).to_equal("wasm64")

    it "correctly identifies 32-bit architectures":
        step("Verify: correctly identifies 32-bit architectures")
        expect(Arch.X86.is_32bit()).to_equal(true)
        expect(Arch.Arm.is_32bit()).to_equal(true)
        expect(Arch.Riscv32.is_32bit()).to_equal(true)
        expect(Arch.Wasm32.is_32bit()).to_equal(true)
        expect(Arch.X86_64.is_32bit()).to_equal(false)
        expect(Arch.Aarch64.is_32bit()).to_equal(false)
        expect(Arch.Riscv64.is_32bit()).to_equal(false)
        expect(Arch.Wasm64.is_32bit()).to_equal(false)

    it "correctly identifies 64-bit architectures":
        step("Verify: correctly identifies 64-bit architectures")
        expect(Arch.X86_64.is_64bit()).to_equal(true)
        expect(Arch.Aarch64.is_64bit()).to_equal(true)
        expect(Arch.Riscv64.is_64bit()).to_equal(true)
        expect(Arch.Wasm64.is_64bit()).to_equal(true)
        expect(Arch.X86.is_64bit()).to_equal(false)
        expect(Arch.Arm.is_64bit()).to_equal(false)
        expect(Arch.Riscv32.is_64bit()).to_equal(false)
        expect(Arch.Wasm32.is_64bit()).to_equal(false)

describe "CompressionType enum":
    it "converts from u8 to CompressionType correctly":
        step("Verify: converts from u8 to CompressionType correctly")
        expect(CompressionType.None_.to_u8()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(CompressionType.Zstd.to_u8()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(CompressionType.Lz4.to_u8()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "defaults to None_ for unknown u8 values":
        step("Verify: defaults to None_ for unknown u8 values")
        expect(CompressionType.None_.to_u8()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "converts CompressionType to u8 correctly":
        step("Verify: converts CompressionType to u8 correctly")
        expect(CompressionType.None_.to_u8()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(CompressionType.Zstd.to_u8()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(CompressionType.Lz4.to_u8()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "round-trips u8 conversion correctly":
        step("Verify: round-trips u8 conversion correctly")
        expect(CompressionType.None_.to_u8()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(CompressionType.Zstd.to_u8()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(CompressionType.Lz4.to_u8()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "returns correct compression names":
        step("Verify: returns correct compression names")
        expect(CompressionType.None_.name()).to_equal("none")
        expect(CompressionType.Zstd.name()).to_equal("zstd")
        expect(CompressionType.Lz4.name()).to_equal("lz4")

