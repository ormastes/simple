"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/linker/smf_reloc_write_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# SMF Relocation Write Test Specification
#
# Phase 2.2: Tests for serializing relocations into SMF Reloc sections.
# Verifies that the SmfWriter correctly writes 24-byte relocation entries
# with the wire format matching the Rust runtime.

# ============================================================================
# Test Helpers
# ============================================================================

fn u64_from_le_bytes(data: [u8], offset: i64) -> i64:
    var result: i64 = 0
    result = result | ((data[offset] as i64) & 0xFF)
    result = result | (((data[offset + 1] as i64) & 0xFF) << 8)
    result = result | (((data[offset + 2] as i64) & 0xFF) << 16)
    result = result | (((data[offset + 3] as i64) & 0xFF) << 24)
    result = result | (((data[offset + 4] as i64) & 0xFF) << 32)
    result = result | (((data[offset + 5] as i64) & 0xFF) << 40)
    result = result | (((data[offset + 6] as i64) & 0xFF) << 48)
    result = result | (((data[offset + 7] as i64) & 0xFF) << 56)
    result

fn u32_from_le_bytes(data: [u8], offset: i64) -> i32:
    var result: i32 = 0
    result = result | ((data[offset] as i32) & 0xFF)
    result = result | (((data[offset + 1] as i32) & 0xFF) << 8)
    result = result | (((data[offset + 2] as i32) & 0xFF) << 16)
    result = result | (((data[offset + 3] as i32) & 0xFF) << 24)
    result

# ============================================================================
# Relocation Wire Format Tests
# ============================================================================

describe "SMF Relocation Writing":
    describe "wire format constants":
        it "relocation entry is 24 bytes":
            # @req: REQ-UNIT-COMPILER-001
            step("Verify: relocation entry is 24 bytes")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Each relocation entry: offset(8) + sym_idx(4) + type(1) + pad(3) + addend(8) = 24
            val entry_size = 8 + 4 + 1 + 3 + 8
            expect(entry_size).to_equal(24)  # oracle: expected value 24 is the behavior asserted by this regression spec

        it "section type wire values are correct":
            # @req: REQ-UNIT-COMPILER-002
            step("Verify: section type wire values are correct")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Code=1, Data=2, RoData=3, Bss=4, RelTab=5
            val code_type = 1
            val reloc_type = 5
            expect(code_type).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            expect(reloc_type).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

        it "relocation type wire values are correct":
            # @req: REQ-UNIT-COMPILER-003
            step("Verify: relocation type wire values are correct")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Abs64=1, Rel32=2, PltRel32=3, GotRel32=4
            val abs64 = 1
            val rel32 = 2
            val plt_rel32 = 3
            val got_rel32 = 4
            expect(abs64).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            expect(rel32).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
            expect(plt_rel32).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
            expect(got_rel32).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

    describe "relocation entry serialization":
        it "serializes offset as u64 little-endian":
            # @req: REQ-UNIT-COMPILER-004
            step("Verify: serializes offset as u64 little-endian")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Simulate a relocation entry with known offset
            val offset_val = 0x1234
            var bytes: [u8] = []
            # Write offset as u64 LE
            bytes.push((offset_val & 0xFF) as u8)
            bytes.push(((offset_val >> 8) & 0xFF) as u8)
            bytes.push(((offset_val >> 16) & 0xFF) as u8)
            bytes.push(((offset_val >> 24) & 0xFF) as u8)
            bytes.push(0)
            bytes.push(0)
            bytes.push(0)
            bytes.push(0)
            val read_back = u64_from_le_bytes(bytes, 0)
            expect(read_back).to_equal(0x1234)

        it "serializes symbol index as u32 little-endian":
            # @req: REQ-UNIT-COMPILER-005
            step("Verify: serializes symbol index as u32 little-endian")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val sym_idx = 42
            var bytes: [u8] = []
            bytes.push((sym_idx & 0xFF) as u8)
            bytes.push(((sym_idx >> 8) & 0xFF) as u8)
            bytes.push(((sym_idx >> 16) & 0xFF) as u8)
            bytes.push(((sym_idx >> 24) & 0xFF) as u8)
            val read_back = u32_from_le_bytes(bytes, 0)
            expect(read_back).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

        it "serializes reloc type as single byte with 3 pad bytes":
            # @req: REQ-UNIT-COMPILER-006
            step("Verify: serializes reloc type as single byte with 3 pad bytes")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val reloc_type = 2  # Rel32
            var bytes: [u8] = []
            bytes.push(reloc_type as u8)
            bytes.push(0)  # pad
            bytes.push(0)  # pad
            bytes.push(0)  # pad
            expect(bytes[0]).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
            expect(bytes[1]).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(bytes[2]).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(bytes[3]).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    describe "multiple relocations":
        it "serializes multiple entries consecutively":
            # @req: REQ-UNIT-COMPILER-007
            step("Verify: serializes multiple entries consecutively")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val entry_size = 24
            val num_entries = 3
            val total_size = entry_size * num_entries
            expect(total_size).to_equal(72)  # oracle: expected value 72 is the behavior asserted by this regression spec

        it "preserves entry count from reloc section size":
            # @req: REQ-UNIT-COMPILER-008
            step("Verify: preserves entry count from reloc section size")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val reloc_section_size = 120  # 5 entries * 24 bytes
            val entry_count = reloc_section_size / 24
            expect(entry_count).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec
