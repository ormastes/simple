"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/interpreter_system_spec_body_probe_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Agent X probe: verify that interpreter actually executes `it{}` block bodies.
#
# Prior regression: system specs and some unit specs were silently reported as
# `PASSED (0ms)` because the Rust interpreter DSL dispatch for describe/it never
# evaluated block bodies. Agents F (test_runner routing), H (BDD body dispatch),
# and O (cache bypass) fixed the path; Agent X rebuilt `bin/simple` from the
# freshly-built Rust seed so the production binary picks up those fixes.
#
# This probe asserts interpreter execution by causing a deliberate failure
# inside the `it{}` body. If block bodies DO NOT execute, the test will be
# counted as a silent pass (demonstrating regression). When they DO execute,
# the pass count must match the number of intentionally-passing expectations.
#
# The probe uses only primitive value checks (no external imports) so it
# stays self-contained and fast.

describe "interpreter it-body execution probe":
    context "arithmetic inside it body":
        it "evaluates expressions inside the block":
            # @req: REQ-UNIT-COMPILER-001
            step("Verify: evaluates expressions inside the block")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val sum = 2 + 3
            expect(sum).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

        it "evaluates boolean comparisons":
            # @req: REQ-UNIT-COMPILER-002
            step("Verify: evaluates boolean comparisons")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val truthy = 10 > 3
            expect(truthy).to_equal(true)

    context "local variable bindings inside it body":
        it "binds and reads a local variable":
            # @req: REQ-UNIT-COMPILER-003
            step("Verify: binds and reads a local variable")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val name = "agent_x"
            expect(name).to_equal("agent_x")

        it "supports multi-step computation":
            # @req: REQ-UNIT-COMPILER-004
            step("Verify: supports multi-step computation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val a = 7
            val b = 6
            val product = a * b
            expect(product).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec
