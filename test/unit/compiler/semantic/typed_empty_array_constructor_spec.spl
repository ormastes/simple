# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Regression spec for: typed empty-array constructor rejected
# doc/08_tracking/bug/typed_empty_array_constructor_rejected_2026-08-10.md
#
# `val allowed: [i64] = [i64]()` failed at execution time with
# "semantic: variable `i64` not found" because the array-literal callee's
# element TYPE name was resolved as a variable. The typed empty-array
# constructor must yield an empty array.

use std.spec.step

use std.spec.*

describe "typed empty array constructor [i64]()":
    # @manual scenario evidence
    it "constructs an empty i64 array":
        # @req REQ-SSPEC-UNIT
        step("constructs an empty i64 array")
        val allowed: [i64] = [i64]()
        expect(allowed.len()).to_equal(0)

    it "constructed array accepts pushes":
        # @req REQ-SSPEC-UNIT
        step("constructed array accepts pushes")
        var xs: [i64] = [i64]()
        xs.push(41)
        xs.push(1)
        expect(xs.len()).to_equal(2)
        expect(xs[0] + xs[1]).to_equal(42)

    it "matches the [] spelling":
        # @req REQ-SSPEC-UNIT
        step("matches the [] spelling")
        val a: [i64] = [i64]()
        val b: [i64] = []
        expect(a.len()).to_equal(b.len())
