# @tag:in-development
# Tracks: doc/08_tracking/bug/module_var_write_lost_when_rhs_method_reads_me_2026-09-05.md
"""
## Purpose and audience
A module-level `var` must keep the value assigned to it, whether or not the
right-hand method read a field of its own receiver.
Audience: compiler/interpreter maintainers.

The first example is EXPECTED TO FAIL on the seed interpreter and documents a
real defect — see
doc/08_tracking/bug/module_var_write_lost_when_rhs_method_reads_me_2026-09-05.md
Do not weaken it; it goes green when the defect is fixed.
"""
# @req: REQ-TEST-COMPILER_MODULE_VAR_WRITE-001
use std.spec
use fixtures.module_var_me_read.{direct_bump, guarded_bump}

describe "module-level var writes":
    it "keeps the write when the right-hand method reads its own receiver":
        # @req: REQ-TEST-COMPILER_MODULE_VAR_WRITE-001
        step("Verify: `_v = _v.inc()` advances the module var on every call")
        val a = direct_bump()
        val b = direct_bump()
        val c = direct_bump()
        expect(a.to_text() + "," + b.to_text() + "," + c.to_text()).to_equal("1,2,3")

    it "keeps the write when the mutation goes through a temporary binding":
        # @req: REQ-TEST-COMPILER_MODULE_VAR_WRITE-001
        step("Verify: the documented workaround stays correct")
        val a = guarded_bump()
        val b = guarded_bump()
        val c = guarded_bump()
        expect(a.to_text() + "," + b.to_text() + "," + c.to_text()).to_equal("1,2,3")
