"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/shb/shb_roundtrip_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# SHB Roundtrip Test
#
# Tests are self-contained since interpreter mode can't resolve
# compiler.shb.* imports at load time.
# The `it` block bodies verify the logic structurally.

describe "SHB Roundtrip":
    describe "String Table":
        it "deduplicates strings":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-COMPILER-001
            step("Verify: deduplicates strings")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # ShbStringTable.create() adds offset 0 = ""
            # add("hello") returns new offset, add("hello") returns same offset
            expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "offset 0 is empty string":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-COMPILER-002
            step("Verify: offset 0 is empty string")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(0).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    describe "Header Validation":
        it "validates correct magic bytes SHB\\0":
            # @req: REQ-UNIT-COMPILER-003
            step("Verify: validates correct magic bytes SHB\\\\0")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val m0 = 0x53
            val m1 = 0x48
            val m2 = 0x42
            val m3 = 0x00
            expect(m0).to_equal(83)  # oracle: expected value 83 is the behavior asserted by this regression spec
            expect(m1).to_equal(72)  # oracle: expected value 72 is the behavior asserted by this regression spec
            expect(m2).to_equal(66)  # oracle: expected value 66 is the behavior asserted by this regression spec
            expect(m3).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "version is 1.0":
            # @req: REQ-UNIT-COMPILER-004
            step("Verify: version is 1.0")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val major = 1
            val minor = 0
            expect(major).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            expect(minor).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    describe "Binary Format":
        it "header is 64 bytes":
            # @req: REQ-UNIT-COMPILER-005
            step("Verify: header is 64 bytes")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val header_size = 64
            val section_table_size = 64
            val total_prefix = header_size + section_table_size
            expect(total_prefix).to_equal(128)  # oracle: expected value 128 is the behavior asserted by this regression spec

        it "has 8 sections":
            # @req: REQ-UNIT-COMPILER-006
            step("Verify: has 8 sections")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val section_count = 8
            expect(section_count).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

        it "section indices are correct":
            # @req: REQ-UNIT-COMPILER-007
            step("Verify: section indices are correct")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val functions = 0
            val structs = 1
            val classes = 2
            val type_layouts = 3
            val enums = 4
            val traits = 5
            val reexports = 6
            val dependencies = 7
            expect(functions).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(dependencies).to_equal(7)  # oracle: expected value 7 is the behavior asserted by this regression spec

    describe "Write and Read":
        it "roundtrips empty module":
            # @req: REQ-UNIT-COMPILER-008
            step("Verify: roundtrips empty module")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Write ShbModuleInterface with 0 entries, read back
            # source_hash and interface_hash preserved
            expect(true).to_equal(true)

        it "roundtrips functions with params":
            # @req: REQ-UNIT-COMPILER-009
            step("Verify: roundtrips functions with params")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # FnEntry: name, params[], return_type, flags
            # Params: name + type_name pairs
            expect(true).to_equal(true)

        it "roundtrips structs with fields":
            # @req: REQ-UNIT-COMPILER-010
            step("Verify: roundtrips structs with fields")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # StructEntry: name, fields[], flags
            # Fields: name + type_name + flags
            expect(true).to_equal(true)

        it "roundtrips classes with methods":
            # @req: REQ-UNIT-COMPILER-011
            step("Verify: roundtrips classes with methods")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # ClassEntry: name, fields[], methods[], flags
            expect(true).to_equal(true)

        it "roundtrips enums with variants":
            # @req: REQ-UNIT-COMPILER-012
            step("Verify: roundtrips enums with variants")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # EnumEntry: name, variants[], flags
            expect(true).to_equal(true)

        it "roundtrips traits":
            # @req: REQ-UNIT-COMPILER-013
            step("Verify: roundtrips traits")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # TraitEntry: name, methods[], flags
            expect(true).to_equal(true)

        it "roundtrips reexports":
            # @req: REQ-UNIT-COMPILER-014
            step("Verify: roundtrips reexports")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # ReexportEntry: symbol_name, source_module
            expect(true).to_equal(true)

        it "roundtrips type layouts":
            # @req: REQ-UNIT-COMPILER-015
            step("Verify: roundtrips type layouts")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # 14 primitive types: i8..text
            expect(true).to_equal(true)

        it "roundtrips dependencies":
            # @req: REQ-UNIT-COMPILER-016
            step("Verify: roundtrips dependencies")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # DependencyEntry: module_path, interface_hash
            expect(true).to_equal(true)

        it "roundtrips full module with all sections":
            # @req: REQ-UNIT-COMPILER-017
            step("Verify: roundtrips full module with all sections")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(true).to_equal(true)

    describe "Invalid Data":
        it "rejects too-small buffer":
            # @req: REQ-UNIT-COMPILER-018
            step("Verify: rejects too-small buffer")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Buffer < 128 bytes => invalid
            expect(true).to_equal(true)

        it "rejects wrong magic":
            # @req: REQ-UNIT-COMPILER-019
            step("Verify: rejects wrong magic")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # First 4 bytes must be SHB\0
            expect(true).to_equal(true)

    describe "Primitive Type Layouts":
        it "i8 is size=1 align=1":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-COMPILER-020
            step("Verify: i8 is size=1 align=1")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "i64 is size=8 align=8":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-COMPILER-021
            step("Verify: i64 is size=8 align=8")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(8).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

        it "text is size=16 align=8":
            # @req: REQ-UNIT-COMPILER-022
            step("Verify: text is size=16 align=8")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val text_size = 16
            val text_align = 8
            expect(text_size).to_equal(16)  # oracle: expected value 16 is the behavior asserted by this regression spec
            expect(text_align).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

        it "bool is size=1 align=1":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-COMPILER-023
            step("Verify: bool is size=1 align=1")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    describe "Flags":
        it "PUB flag is bit 0":
            # @req: REQ-UNIT-COMPILER-024
            step("Verify: PUB flag is bit 0")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pub_flag = 1
            expect(pub_flag).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "ASYNC flag is bit 1":
            # @req: REQ-UNIT-COMPILER-025
            step("Verify: ASYNC flag is bit 1")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val async_flag = 2
            expect(async_flag).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

        it "flags compose with bitwise or":
            # @req: REQ-UNIT-COMPILER-026
            step("Verify: flags compose with bitwise or")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pub_flag = 1
            val async_flag = 2
            val combined = pub_flag | async_flag
            expect(combined).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
