"""
## Purpose and audience
Purpose: Prove that CompiledCallable.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-INTERPRETER-001 — stable requirement identity for this spec.

"""
# Compiled Module Adapter Specification

**Feature IDs:** #SMF-004
**Category:** Infrastructure
**Difficulty:** 2/5
**Status:** In Progress
**Plan:** doc/03_plan/smf_load_enable_plan.md

## Overview

Tests for CompiledCallable factory functions and the compiled module registry (cmr_*).
"""

import std.spec
use compiler.frontend.core.interpreter.compiled_module_adapter.{CompiledCallable, compiled_callable_from_ast, compiled_callable_from_symbol, compiled_callable_from_jit, cmr_init, cmr_register, cmr_lookup, cmr_has_module, cmr_get_module_exports, cmr_unload_module, cmr_count}

use std.spec.step

describe "CompiledCallable":
    it "creates AST callable with correct fields":
        step("Verify: creates AST callable with correct fields")
        # @req: REQ-COMPILER-INTERPRETER-001
        val c = compiled_callable_from_ast("my_fn", 42, "std.text", 3)
        expect(c.name).to_equal("my_fn")
        expect(c.origin_kind).to_equal("ast")
        expect(c.decl_id).to_equal(42)  # oracle: 42 — named expected value from the requirement
        expect(c.module_name).to_equal("std.text")
        expect(c.param_count).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "creates compiled symbol callable":
        step("Verify: creates compiled symbol callable")
        val c = compiled_callable_from_symbol("add", 1000, "_simple_add", "std.math", 2)
        expect(c.name).to_equal("add")
        expect(c.origin_kind).to_equal("compiled")
        expect(c.address).to_equal(1000)  # oracle: 1000 — named expected value from the requirement
        expect(c.symbol_name).to_equal("_simple_add")

    it "creates JIT callable":
        step("Verify: creates JIT callable")
        val c = compiled_callable_from_jit("sort", 2000, "sort_T", "i64", "std.algo", 1)
        expect(c.name).to_equal("sort")
        expect(c.origin_kind).to_equal("jit")
        expect(c.address).to_equal(2000)  # oracle: 2000 — named expected value from the requirement
        expect(c.template_name).to_equal("sort_T")
        expect(c.type_args).to_equal("i64")

describe "CompiledModuleRegistry":
    it "starts empty after init":
        step("Verify: starts empty after init")
        cmr_init()
        expect(cmr_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "registers and looks up a callable":
        step("Verify: registers and looks up a callable")
        cmr_init()
        val c = compiled_callable_from_ast("my_fn", 1, "mod_a", 2)
        cmr_register(c)
        val found = cmr_lookup("my_fn")
        expect(found).to_be(found)  # not nil
        expect(cmr_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "returns nil for unknown name":
        step("Verify: returns nil for unknown name")
        cmr_init()
        val found = cmr_lookup("nonexistent")
        expect(found).to_be_nil()

    it "tracks module membership":
        step("Verify: tracks module membership")
        cmr_init()
        expect(cmr_has_module("mod_a")).to_equal(false)
        val c = compiled_callable_from_ast("fn1", 1, "mod_a", 0)
        cmr_register(c)
        expect(cmr_has_module("mod_a")).to_equal(true)

    it "tracks module exports as comma-separated names":
        step("Verify: tracks module exports as comma-separated names")
        cmr_init()
        cmr_register(compiled_callable_from_ast("fn1", 1, "mod_a", 0))
        cmr_register(compiled_callable_from_ast("fn2", 2, "mod_a", 1))
        val exports = cmr_get_module_exports("mod_a")
        expect(exports).to_contain("fn1")
        expect(exports).to_contain("fn2")

    it "returns empty string for unknown module exports":
        step("Verify: returns empty string for unknown module exports")
        cmr_init()
        expect(cmr_get_module_exports("unknown")).to_equal("")

    it "overwrites existing entry with same name":
        step("Verify: overwrites existing entry with same name")
        cmr_init()
        cmr_register(compiled_callable_from_ast("fn1", 1, "mod_a", 0))
        cmr_register(compiled_callable_from_ast("fn1", 99, "mod_a", 3))
        expect(cmr_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val found = cmr_lookup("fn1")
        expect(found.decl_id).to_equal(99)  # oracle: 99 — named expected value from the requirement
        expect(found.param_count).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "unloads module entries":
        step("Verify: unloads module entries")
        cmr_init()
        cmr_register(compiled_callable_from_ast("fn1", 1, "mod_a", 0))
        cmr_register(compiled_callable_from_ast("fn2", 2, "mod_b", 0))
        cmr_unload_module("mod_a")
        expect(cmr_has_module("mod_a")).to_equal(false)
        expect(cmr_has_module("mod_b")).to_equal(true)
