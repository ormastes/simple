"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/interpreter/indexed_augmented_assignment_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec

# Generalization spec for the interpreter's indexed-lvalue augmented assignment
# gap.
#
# Bug: doc/08_tracking/bug/spec_runner_indexed_augmented_assignment_unsupported_2026-08-15.md
# Fix: src/compiler_rust/compiler/src/interpreter/node_exec.rs
#      `exec_augmented_assignment` had arms only for `Expr::Identifier` and
#      `Expr::FieldAccess`; every `Expr::Index` target fell through to the
#      catch-all and raised
#      "invalid assignment: unsupported augmented assignment target".
#
# The original bug was reported for `arr[i] += 1`, but the missing arm covers a
# whole CLASS of lvalues, so this spec pins the class rather than the one case:
# every augmented operator, array and dict receivers, a field-access receiver,
# and a side-effecting subscript expression (which must be evaluated once).

class CounterBox:
    slots: [i64]

var subscript_evaluations_: i64 = 0

fn counting_index(i: i64) -> i64:
    subscript_evaluations_ = subscript_evaluations_ + 1
    i

describe "interpreter indexed augmented assignment":
    it "applies every augmented operator to an array element":
        # @req: REQ-UNIT-COMPILER-001
        step("Verify: applies every augmented operator to an array element")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var xs = [10, 20, 30, 40, 50]
        xs[0] += 5
        xs[1] -= 5
        xs[2] *= 2
        xs[3] /= 4
        xs[4] %= 7
        expect(xs[0]).to_equal(15)  # oracle: expected value 15 is the behavior asserted by this regression spec
        expect(xs[1]).to_equal(15)  # oracle: expected value 15 is the behavior asserted by this regression spec
        expect(xs[2]).to_equal(60)  # oracle: expected value 60 is the behavior asserted by this regression spec
        expect(xs[3]).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec
        expect(xs[4]).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "applies an augmented operator to a dict entry":
        # @req: REQ-UNIT-COMPILER-002
        step("Verify: applies an augmented operator to a dict entry")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var counts = {"a": 1, "b": 2}
        counts["a"] += 10
        counts["b"] *= 3
        expect(counts["a"]).to_equal(11)  # oracle: expected value 11 is the behavior asserted by this regression spec
        expect(counts["b"]).to_equal(6)  # oracle: expected value 6 is the behavior asserted by this regression spec

    it "applies an augmented operator through a field-access receiver":
        # @req: REQ-UNIT-COMPILER-003
        step("Verify: applies an augmented operator through a field-access receiver")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var box = CounterBox(slots: [1, 2, 3])
        box.slots[1] += 40
        expect(box.slots[1]).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec
        expect(box.slots[0]).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "evaluates a side-effecting subscript exactly once":
        # @req: REQ-UNIT-COMPILER-004
        step("Verify: evaluates a side-effecting subscript exactly once")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var xs = [7, 7, 7]
        subscript_evaluations_ = 0
        xs[counting_index(2)] += 1
        expect(xs[2]).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec
        expect(subscript_evaluations_).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "leaves no temporary bindings visible after the assignment":
        # @req: REQ-UNIT-COMPILER-005
        step("Verify: leaves no temporary bindings visible after the assignment")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var xs = [1, 2]
        xs[0] += 1
        # The desugaring binds `__aug_idx_temp__`/`__aug_rhs_temp__` internally
        # and must restore the environment; the surrounding names stay intact.
        val after = 9
        expect(xs[0]).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(after).to_equal(9)  # oracle: expected value 9 is the behavior asserted by this regression spec
