"""
## Purpose and audience
Purpose: Prove that interpreter self field assignment.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-INTERPRETER-001 — stable requirement identity for this spec.

use std.spec

class MutableCounter:
    value: i32

    me set_value(next: i32):
        self.value = next

class MutableListHolder:
    values: [i32]

    me set_first(next: i32):
        self.values[0] = next

    me set_first_via_free_function(next: i32):
        write_first(self.values, next)

    me set_first_via_self_free_function(next: i32):
        write_holder_first(self, next)

class MutableDictHolder:
    values: Dict<text, i32>

struct MutableStructDictHolder:
    values: Dict<text, i32>

enum DictWriteResult:
    Success

fn write_first(values: [i32], next: i32):
    values[0] = next

fn write_holder_first(holder: MutableListHolder, next: i32):
    holder.values[0] = next

fn write_holder_named_self(self: MutableListHolder, next: i32):
    self.values[0] = next

fn write_dict_holder(self: MutableDictHolder, key: text, next: i32):
    self.values[key] = next

fn write_struct_dict_holder(self: MutableStructDictHolder, key: text, next: i32) -> DictWriteResult:
    self.values[key] = next
    DictWriteResult.Success

describe "interpreter self field assignment":
    it "allows self.field assignment inside me methods":
        step("Verify: allows self.field assignment inside me methods")
        # @req: REQ-COMPILER-INTERPRETER-001
        var counter = MutableCounter(value: 1)
        counter.set_value(7)
        expect(counter.value).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "allows self.field[index] assignment inside me methods":
        step("Verify: allows self.field[index] assignment inside me methods")
        var holder = MutableListHolder(values: [1, 2])
        holder.set_first(9)
        expect(holder.values[0]).to_equal(9)  # oracle: 9 — named expected value from the requirement

    it "preserves self.field mutations passed through free functions":
        step("Verify: preserves self.field mutations passed through free functions")
        var holder = MutableListHolder(values: [1, 2])
        holder.set_first_via_free_function(11)
        expect(holder.values[0]).to_equal(11)  # oracle: 11 — named expected value from the requirement

    it "preserves self receiver mutations passed through free functions":
        step("Verify: preserves self receiver mutations passed through free functions")
        var holder = MutableListHolder(values: [1, 2])
        holder.set_first_via_self_free_function(13)
        expect(holder.values[0]).to_equal(13)  # oracle: 13 — named expected value from the requirement

    it "preserves mutations through free functions whose parameter is named self":
        step("Verify: preserves mutations through free functions whose parameter is named self")
        var holder = MutableListHolder(values: [1, 2])
        write_holder_named_self(holder, 17)
        expect(holder.values[0]).to_equal(17)  # oracle: 17 — named expected value from the requirement

    it "preserves dictionary-field mutations through free functions":
        step("Verify: preserves dictionary-field mutations through free functions")
        var holder = MutableDictHolder(values: {})
        write_dict_holder(holder, "answer", 42)
        expect(holder.values.has("answer")).to_equal(true)
        expect(holder.values["answer"]).to_equal(42)

    it "preserves struct dictionary-field mutations through returning free functions":
        step("Verify: preserves struct dictionary-field mutations through returning free functions")
        var holder = MutableStructDictHolder(values: {})
        val result = write_struct_dict_holder(holder, "answer", 43)
        # `struct` is a VALUE type: if the helper mutated a copy, `holder` is
        # unchanged. A presence assertion alone is weak, so assert the stored
        # VALUE, and pair it with a control key that must stay ABSENT so a
        # dict that answers `true` to everything cannot fake a pass.
        match result:
            case DictWriteResult.Success:
                expect(holder.values.has("answer")).to_equal(true)
                expect(holder.values["answer"]).to_equal(43)
                expect(holder.values.has("never-written")).to_equal(false)
            case _:
                expect("unexpected").to_equal("success")
