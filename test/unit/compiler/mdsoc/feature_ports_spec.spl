"""
## Purpose and audience
Purpose: Prove that LexerInputPort.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-MDSOC-001 — stable requirement identity for this spec.

# Feature Port Struct Tests
#
# Tests that feature stage port structs can be constructed and
# that their fields are accessible.
#
# Each struct is imported from its own per-struct file to avoid
# the runtime limitation where only the first struct in each
# imported module supports direct field construction.

use compiler.mdsoc.feature.lexing.app.lexer_input_port.{LexerInputPort}
use compiler.mdsoc.feature.lexing.app.lexer_output_port.{LexerOutputPort}
use compiler.mdsoc.feature.parsing.app.parse_error.{ParseError}
use compiler.mdsoc.feature.parsing.app.parser_input_port.{ParserInputPort}
use compiler.mdsoc.feature.parsing.app.parser_output_port.{ParserOutputPort}
use compiler.mdsoc.feature.desugaring.app.desugar_input_port.{DesugarInputPort}
use compiler.mdsoc.feature.desugaring.app.desugar_output_port.{DesugarOutputPort}
use compiler.mdsoc.feature.codegen.app.codegen_input_port.{CodegenInputPort}
use compiler.mdsoc.feature.codegen.app.codegen_output_port.{CodegenOutputPort}
use compiler.mdsoc.feature.monomorphization.app.mono_input_port.{MonomorphizeInputPort}
use compiler.mdsoc.feature.monomorphization.app.mono_output_port.{MonomorphizeOutputPort}
use compiler.mdsoc.feature.optimization.app.optimize_input_port.{OptimizeInputPort}
use compiler.mdsoc.feature.optimization.app.optimize_output_port.{OptimizeOutputPort}
use compiler.mdsoc.feature.linking.app.linker_input_port.{LinkerInputPort}
use compiler.mdsoc.feature.linking.app.linker_output_port.{LinkerOutputPort}

# ============================================================================
# LexerInputPort - from lexing/app/lexer_input_port.spl
# ============================================================================

use std.spec.step

describe "LexerInputPort":
    it "constructs with source_text":
        step("Verify: constructs with source_text")
        # @req: REQ-COMPILER-MDSOC-001
        val port = LexerInputPort(source_text: "val x = 1")
        expect(port.source_text).to_equal("val x = 1")

    it "constructs with empty source":
        step("Verify: constructs with empty source")
        val port = LexerInputPort(source_text: "")
        expect(port.source_text).to_equal("")

    it "constructs with multiline source":
        step("Verify: constructs with multiline source")
        val port = LexerInputPort(source_text: "fn foo():\n    1")
        expect(port.source_text).to_start_with("fn foo")

# ============================================================================
# LexerOutputPort - from lexing/app/lexer_output_port.spl
# ============================================================================

describe "LexerOutputPort":
    it "constructs with token data":
        step("Verify: constructs with token data")
        val port = LexerOutputPort(
            token_tags: [1, 2, 3],
            token_texts: ["val", "x", "="],
            token_lines: [1, 1, 1],
            token_cols: [1, 5, 7],
            token_count: 3
        )
        expect(port.token_count).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "constructs with empty token arrays":
        step("Verify: constructs with empty token arrays")
        val port = LexerOutputPort(
            token_tags: [],
            token_texts: [],
            token_lines: [],
            token_cols: [],
            token_count: 0
        )
        expect(port.token_count).to_equal(0)  # oracle: 0 — named expected value from the requirement

# ============================================================================
# ParseError - from parsing/app/parse_error.spl
# ============================================================================

describe "ParseError":
    it "constructs with message and location":
        step("Verify: constructs with message and location")
        val err = ParseError(message: "unexpected token", line: 5, col: 12)
        expect(err.message).to_equal("unexpected token")
        expect(err.line).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(err.col).to_equal(12)  # oracle: 12 — named expected value from the requirement

    it "stores zero location for start of file":
        step("Verify: stores zero location for start of file")
        val err = ParseError(message: "syntax error", line: 1, col: 1)
        expect(err.line).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(err.col).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "stores large line numbers":
        step("Verify: stores large line numbers")
        val err = ParseError(message: "eof", line: 9999, col: 80)
        expect(err.line).to_equal(9999)  # oracle: 9999 — named expected value from the requirement

# ============================================================================
# ParserInputPort - from parsing/app/parser_input_port.spl
# ============================================================================

describe "ParserInputPort":
    it "constructs with token stream data":
        step("Verify: constructs with token stream data")
        val port = ParserInputPort(
            token_tags: [1, 2],
            token_texts: ["val", "x"],
            token_lines: [1, 1],
            token_cols: [1, 5],
            token_count: 2,
            source_text: "val x"
        )
        expect(port.token_count).to_equal(2)  # oracle: 2 — named expected value from the requirement

# ============================================================================
# ParserOutputPort - from parsing/app/parser_output_port.spl
# ============================================================================

describe "ParserOutputPort":
    it "constructs empty output":
        step("Verify: constructs empty output")
        val port = ParserOutputPort(
            expr_count: 0,
            stmt_count: 0,
            decl_count: 0,
            root_decls: [],
            errors: [],
            error_count: 0
        )
        expect(port.error_count).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "constructs output with counts":
        step("Verify: constructs output with counts")
        val port = ParserOutputPort(
            expr_count: 10,
            stmt_count: 5,
            decl_count: 3,
            root_decls: [0, 1, 2],
            errors: [],
            error_count: 0
        )
        expect(port.expr_count).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(port.stmt_count).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(port.decl_count).to_equal(3)  # oracle: 3 — named expected value from the requirement

# ============================================================================
# DesugarInputPort - from desugaring/app/desugar_input_port.spl
# ============================================================================

describe "DesugarInputPort":
    it "constructs with source and module name":
        step("Verify: constructs with source and module name")
        val port = DesugarInputPort(source_text: "fn foo(): 1", module_name: "test")
        expect(port.module_name).to_equal("test")
        expect(port.source_text).to_equal("fn foo(): 1")

    it "holds the module name":
        step("Verify: holds the module name")
        val port = DesugarInputPort(source_text: "", module_name: "my_module")
        expect(port.module_name).to_equal("my_module")

# ============================================================================
# DesugarOutputPort - from desugaring/app/desugar_output_port.spl
# ============================================================================

describe "DesugarOutputPort":
    it "constructs with desugared source":
        step("Verify: constructs with desugared source")
        val port = DesugarOutputPort(
            desugared_source: "fn foo(): 1",
            injected_fn_names: [],
            pass_count: 5
        )
        expect(port.pass_count).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "constructs with injected function names":
        step("Verify: constructs with injected function names")
        val port = DesugarOutputPort(
            desugared_source: "fn foo(): 1\nfn __foo_impl(): 1",
            injected_fn_names: ["__foo_impl"],
            pass_count: 5
        )
        expect(port.pass_count).to_equal(5)  # oracle: 5 — named expected value from the requirement

# ============================================================================
# CodegenInputPort - from codegen/app/codegen_input_port.spl
# ============================================================================

describe "CodegenInputPort":
    it "constructs with function counts":
        step("Verify: constructs with function counts")
        val port = CodegenInputPort(
            function_count: 3,
            extern_fn_count: 1,
            string_literal_count: 2
        )
        expect(port.function_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(port.extern_fn_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(port.string_literal_count).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "constructs with zero counts":
        step("Verify: constructs with zero counts")
        val port = CodegenInputPort(
            function_count: 0,
            extern_fn_count: 0,
            string_literal_count: 0
        )
        expect(port.function_count).to_equal(0)  # oracle: 0 — named expected value from the requirement

# ============================================================================
# CodegenOutputPort - from codegen/app/codegen_output_port.spl
# ============================================================================

describe "CodegenOutputPort":
    it "reports success":
        step("Verify: reports success")
        val port = CodegenOutputPort(
            object_byte_count: 1024,
            symbol_count: 5,
            target_triple: "x86_64-linux-gnu",
            success: true
        )
        expect(port.success).to_equal(true)
        expect(port.target_triple).to_equal("x86_64-linux-gnu")

    it "reports failure":
        step("Verify: reports failure")
        val port = CodegenOutputPort(
            object_byte_count: 0,
            symbol_count: 0,
            target_triple: "x86_64-linux-gnu",
            success: false
        )
        expect(port.success).to_equal(false)

    it "stores object byte count":
        step("Verify: stores object byte count")
        val port = CodegenOutputPort(
            object_byte_count: 4096,
            symbol_count: 10,
            target_triple: "aarch64-linux-gnu",
            success: true
        )
        expect(port.object_byte_count).to_equal(4096)  # oracle: 4096 — named expected value from the requirement
        expect(port.symbol_count).to_equal(10)  # oracle: 10 — named expected value from the requirement

# ============================================================================
# MonomorphizeInputPort - from monomorphization/app/mono_input_port.spl
# ============================================================================

describe "MonomorphizeInputPort":
    it "constructs with generic function count":
        step("Verify: constructs with generic function count")
        val port = MonomorphizeInputPort(
            typed_decl_count: 10,
            generic_fn_count: 3,
            has_generics: true
        )
        expect(port.typed_decl_count).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(port.generic_fn_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(port.has_generics).to_equal(true)

    it "constructs with no generics":
        step("Verify: constructs with no generics")
        val port = MonomorphizeInputPort(
            typed_decl_count: 5,
            generic_fn_count: 0,
            has_generics: false
        )
        expect(port.generic_fn_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(port.has_generics).to_equal(false)

    it "stores typed declaration count":
        step("Verify: stores typed declaration count")
        val port = MonomorphizeInputPort(
            typed_decl_count: 42,
            generic_fn_count: 7,
            has_generics: true
        )
        expect(port.typed_decl_count).to_equal(42)  # oracle: 42 — named expected value from the requirement

# ============================================================================
# MonomorphizeOutputPort - from monomorphization/app/mono_output_port.spl
# ============================================================================

describe "MonomorphizeOutputPort":
    it "constructs with specialization counts":
        step("Verify: constructs with specialization counts")
        val port = MonomorphizeOutputPort(
            mono_decl_count: 15,
            specialized_count: 6
        )
        expect(port.mono_decl_count).to_equal(15)  # oracle: 15 — named expected value from the requirement
        expect(port.specialized_count).to_equal(6)  # oracle: 6 — named expected value from the requirement

    it "constructs with zero specializations":
        step("Verify: constructs with zero specializations")
        val port = MonomorphizeOutputPort(
            mono_decl_count: 5,
            specialized_count: 0
        )
        expect(port.specialized_count).to_equal(0)  # oracle: 0 — named expected value from the requirement

# ============================================================================
# OptimizeInputPort - from optimization/app/optimize_input_port.spl
# ============================================================================

describe "OptimizeInputPort":
    it "constructs with basic optimization level":
        step("Verify: constructs with basic optimization level")
        val port = OptimizeInputPort(
            mir_fn_count: 8,
            mir_inst_count: 120,
            optimization_level: 1
        )
        expect(port.mir_fn_count).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(port.mir_inst_count).to_equal(120)  # oracle: 120 — named expected value from the requirement
        expect(port.optimization_level).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "constructs with no optimization":
        step("Verify: constructs with no optimization")
        val port = OptimizeInputPort(
            mir_fn_count: 3,
            mir_inst_count: 40,
            optimization_level: 0
        )
        expect(port.optimization_level).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "constructs with aggressive optimization":
        step("Verify: constructs with aggressive optimization")
        val port = OptimizeInputPort(
            mir_fn_count: 20,
            mir_inst_count: 500,
            optimization_level: 3
        )
        expect(port.optimization_level).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(port.mir_fn_count).to_equal(20)  # oracle: 20 — named expected value from the requirement

# ============================================================================
# OptimizeOutputPort - from optimization/app/optimize_output_port.spl
# ============================================================================

describe "OptimizeOutputPort":
    it "constructs with eliminated instruction count":
        step("Verify: constructs with eliminated instruction count")
        val port = OptimizeOutputPort(
            mir_fn_count: 8,
            mir_inst_count: 90,
            eliminated_count: 30
        )
        expect(port.mir_fn_count).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(port.mir_inst_count).to_equal(90)  # oracle: 90 — named expected value from the requirement
        expect(port.eliminated_count).to_equal(30)  # oracle: 30 — named expected value from the requirement

    it "constructs with no eliminated instructions":
        step("Verify: constructs with no eliminated instructions")
        val port = OptimizeOutputPort(
            mir_fn_count: 3,
            mir_inst_count: 40,
            eliminated_count: 0
        )
        expect(port.eliminated_count).to_equal(0)  # oracle: 0 — named expected value from the requirement

# ============================================================================
# LinkerInputPort - from linking/app/linker_input_port.spl
# ============================================================================

describe "LinkerInputPort":
    it "constructs for executable output":
        step("Verify: constructs for executable output")
        val port = LinkerInputPort(
            object_file_count: 3,
            library_count: 2,
            output_type: "exe",
            output_path: "/tmp/out"
        )
        expect(port.object_file_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(port.library_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(port.output_type).to_equal("exe")
        expect(port.output_path).to_equal("/tmp/out")

    it "constructs for library output":
        step("Verify: constructs for library output")
        val port = LinkerInputPort(
            object_file_count: 1,
            library_count: 0,
            output_type: "lib",
            output_path: "/tmp/libfoo.a"
        )
        expect(port.output_type).to_equal("lib")

    it "constructs for smf output":
        step("Verify: constructs for smf output")
        val port = LinkerInputPort(
            object_file_count: 2,
            library_count: 1,
            output_type: "smf",
            output_path: "/tmp/mod.smf"
        )
        expect(port.output_type).to_equal("smf")
        expect(port.object_file_count).to_equal(2)  # oracle: 2 — named expected value from the requirement

# ============================================================================
# LinkerOutputPort - from linking/app/linker_output_port.spl
# ============================================================================

describe "LinkerOutputPort":
    it "constructs successful link result":
        step("Verify: constructs successful link result")
        val port = LinkerOutputPort(
            output_path: "/tmp/out",
            output_size_bytes: 65536,
            success: true,
            error_message: ""
        )
        expect(port.output_path).to_equal("/tmp/out")
        expect(port.output_size_bytes).to_equal(65536)  # oracle: 65536 — named expected value from the requirement
        expect(port.success).to_equal(true)

    it "constructs failed link result":
        step("Verify: constructs failed link result")
        val port = LinkerOutputPort(
            output_path: "",
            output_size_bytes: 0,
            success: false,
            error_message: "undefined symbol: main"
        )
        expect(port.success).to_equal(false)
        expect(port.error_message).to_equal("undefined symbol: main")
