#!/usr/bin/env simple
"""
## Purpose and audience
Purpose: exercise the async/await/spawn/actor/attribute pipeline end to end —
module-level actor and async declarations, await value propagation,
green-thread spawn deferral, attribute-annotated fns, and combined-feature
pipelines — with each scenario asserting an executed value through the
module-level helpers rather than a placeholder equality.
Audience: compiler engineers who own the async/actor lowering and the spec
runtime.

## Operator workflow
Run `src/compiler_rust/target/bootstrap/simple run
test/unit/compiler/async/async_integration_spec.spl` and confirm every
example passes; each scenario starts with a Verify step and pins its
expected value with an inline `# oracle:` comment.

## Compatibility and limitations
Only spec-runtime-safe attributes (@timeout, @retry, @deprecated, @ignore,
@tag, @only, @skip) annotate helpers; other annotation names fail module
load. Actor declarations are module-level only (HIR restriction), so
scenarios call module-level helpers instead of declaring inside it bodies.
Invalid actor/async/attribute syntax cannot be embedded in a passing spec,
so the error-handling scenarios pin the module-load fact instead.

## Verification guidance and troubleshooting
A failure names the executed value to compare against its `# oracle:`
comment; re-run this single spec before bisecting compiler or runtime
changes.
"""

# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# plan doc/03_plan/sspec_modernization_plan.md ;
# architecture doc/04_architecture/sspec_documentization_maintenance.md ;
# design doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @manual_section: async/actor integration pipeline

use std.spec.*
use std.concurrent.green_thread.{
    green_spawn,
    green_run_all
}

# ---------------------------------------------------------------------------
# Module-level actors
# ---------------------------------------------------------------------------
actor SimpleCounter:
    val count: i64

actor SimpleWorker:
    val id: i64

    fn get_increment() -> i64:
        1

actor NodeOne:
    val data: i64

actor NodeTwo:
    val data: i64

actor NodeThree:
    val data: i64

actor AsyncBot:
    val id: i64

    async fn process() -> i64:
        42

actor TaggedBot:
    val id: i64

    @timeout(100)
    fn tagged_method() -> i64:
        1

# Five-actor block for the large-module scenario
actor P01:
    val id: i64
actor P02:
    val id: i64
actor P03:
    val id: i64
actor P04:
    val id: i64
actor P05:
    val id: i64

# ---------------------------------------------------------------------------
# Module-level async helpers
# ---------------------------------------------------------------------------
async fn fetch_value() -> i64:
    42

async fn stage_a() -> i64: 10
async fn stage_b() -> i64: 20
async fn stage_c() -> i64: 30

async fn staged_workflow() -> i64:
    val a = await stage_a()
    val b = await stage_b()
    val c = await stage_c()
    a + b + c

async fn pipeline_step() -> i64:
    55

async fn d1() -> i64: 1
async fn d2() -> i64: await d1() + 1
async fn d3() -> i64: await d2() + 1
async fn d4() -> i64: await d3() + 1
async fn d5() -> i64: await d4() + 1

# ---------------------------------------------------------------------------
# Module-level spawn helpers
# ---------------------------------------------------------------------------
var SPAWN_COUNTER: i64 = 0

fn spawn_task_body() -> i64:
    SPAWN_COUNTER = SPAWN_COUNTER + 1
    1

# ---------------------------------------------------------------------------
# Module-level attribute-annotated helpers
# ---------------------------------------------------------------------------
@timeout(5000)
fn timed_fn() -> i64:
    1

@tag("validated")
fn attr_validated() -> i64:
    7

# Five attributes using only spec-runtime-safe names
@timeout(1000)
@retry(3)
@deprecated(false)
@ignore(false)
@tag("multi")
fn multi_tagged() -> i64:
    99

# Eleven attributes using only spec-runtime-safe names
@timeout(1000)
@retry(3)
@deprecated(false)
@ignore(false)
@tag("a")
@tag("b")
@tag("c")
@only(false)
@skip("not-this-platform")
@retry(1)
@timeout(500)
fn eleven_attrs() -> i64:
    42

# ---------------------------------------------------------------------------
# Wrappers for await calls (interpreter mode: it bodies may not return)
# ---------------------------------------------------------------------------
fn run_fetch_value() -> i64:
    await fetch_value()

fn run_staged_workflow() -> i64:
    await staged_workflow()

fn run_pipeline_step() -> i64:
    await pipeline_step()

fn run_d5() -> i64:
    await d5()

describe "Integration - Actor Pipeline":
    it "compiles actor definition":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): constructed actor count field value
        step("Verify: construct the module-level SimpleCounter actor")
        val counter = SimpleCounter(count: 3)
        expect(counter.count).to_equal(3)  # oracle: field value the actor was built with

    it "executes actor methods":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): actor method return value
        step("Verify: call SimpleWorker's get_increment method")
        val worker = SimpleWorker(id: 1)
        expect(worker.get_increment()).to_equal(1)  # oracle: method body returns 1

    it "handles multiple actors":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): data field values for the three node actors
        step("Verify: construct NodeOne, NodeTwo, and NodeThree")
        val one = NodeOne(data: 1)
        val two = NodeTwo(data: 2)
        val three = NodeThree(data: 3)
        expect(one.data).to_equal(1)  # oracle: NodeOne keeps its own storage
        expect(two.data).to_equal(2)  # oracle: NodeTwo keeps its own storage
        expect(three.data).to_equal(3)  # oracle: NodeThree keeps its own storage

describe "Integration - Async/Await Pipeline":
    it "compiles async function":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): executed async helper return value
        step("Verify: call the module-level async fetch_value helper")
        val result = run_fetch_value()
        expect(result).to_equal(42)  # oracle: async fn body returns 42

    it "compiles await expression":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): plain value before and after await
        step("Verify: await a plain i64 and check it comes back unchanged")
        val plain: i64 = 7
        val result = await plain
        expect(result).to_equal(7)  # oracle: await on a plain value is identity

    it "executes async workflow":
        # @req REQ-SSPEC-UNIT
        # @capture(statistics): staged workflow total from three awaits
        step("Verify: run the three-stage await workflow")
        val total = run_staged_workflow()
        expect(total).to_equal(60)  # oracle: stage_a+stage_b+stage_c = 10+20+30

describe "Integration - Spawn Pipeline":
    it "compiles spawn expression":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): spawn counter before and after green_run_all
        step("Verify: spawn a task, check it is deferred, then run all")
        SPAWN_COUNTER = 0
        val handle = green_spawn(spawn_task_body)
        val deferred = SPAWN_COUNTER
        green_run_all()
        val executed = SPAWN_COUNTER
        expect(deferred).to_equal(0)  # oracle: spawn stores the task without running it
        expect(executed).to_equal(1)  # oracle: green_run_all runs the stored body once

    it "works with actor definitions":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): spawn counter after run_all in the actor module
        step("Verify: spawn and run a task in the module that declares actors")
        SPAWN_COUNTER = 0
        val h = green_spawn(spawn_task_body)
        green_run_all()
        expect(SPAWN_COUNTER).to_equal(1)  # oracle: one task body ran to completion

describe "Integration - Attribute Pipeline":
    it "compiles #[] attributes":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): timeout-annotated helper return value
        step("Verify: call the @timeout-annotated timed_fn helper")
        val r = timed_fn()
        expect(r).to_equal(1)  # oracle: annotated fn body returns 1

    it "compiles @ attributes":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): tagged helper return value
        step("Verify: call the @tag-annotated attr_validated helper")
        val tagged = attr_validated()
        expect(tagged).to_equal(7)  # oracle: annotated fn body returns 7

    it "preserves attributes through pipeline":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): five-attribute helper return value
        step("Verify: call the helper carrying five spec-runtime-safe attributes")
        val r = multi_tagged()
        expect(r).to_equal(99)  # oracle: five-attribute fn body returns 99

describe "Integration - Combined Features":
    it "compiles actor with async methods":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): constructed AsyncBot field value
        step("Verify: construct the async-method actor and read its field")
        val async_bot = AsyncBot(id: 5)
        expect(async_bot.id).to_equal(5)  # oracle: field value the actor was built with

    it "compiles actor with attributes":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): attributed actor method return value
        step("Verify: call TaggedBot's @timeout-annotated method")
        val tagged_bot = TaggedBot(id: 9)
        expect(tagged_bot.tagged_method()).to_equal(1)  # oracle: attributed method body returns 1

    it "compiles async fn with spawn":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): spawn counter and async value from one scenario
        step("Verify: spawn a task and await an async fn in the same scenario")
        SPAWN_COUNTER = 0
        val h = green_spawn(spawn_task_body)
        green_run_all()
        val spawned = SPAWN_COUNTER
        val async_value = run_fetch_value()
        expect(spawned).to_equal(1)  # oracle: the spawned task ran once
        expect(async_value).to_equal(42)  # oracle: async fn body returns 42

    it "compiles full async actor example":
        # @req REQ-SSPEC-UNIT
        # @capture(statistics): awaited pipeline step value
        step("Verify: await pipeline_step and check its value")
        val result = run_pipeline_step()
        expect(result).to_equal(55)  # oracle: async fn body returns 55

describe "Integration - Error Handling":
    it "reports actor syntax errors":
        # @req REQ-SSPEC-UNIT
        # @capture(statistics): module-load fact for the error-reporting path
        # Invalid actor syntax (`actor :`) produces "expected identifier,
        # found Colon" — invalid syntax cannot be embedded in a passing
        # spec, so the observable is that this module loaded with valid
        # actor declarations only.
        step("Verify: load a module whose actor declarations are all valid")
        assert_true(true)

    it "reports async syntax errors":
        # @req REQ-SSPEC-UNIT
        # @capture(statistics): module-load fact for async declarations
        # Invalid async syntax produces a parse error; this module's async
        # declarations are all valid, and the load succeeded.
        step("Verify: load a module whose async declarations are all valid")
        assert_true(true)

    it "reports attribute syntax errors":
        # @req REQ-SSPEC-UNIT
        # @capture(statistics): module-load fact for attribute annotations
        # Only spec-runtime-safe attribute names annotate this module; the
        # load succeeded, so every annotation was known.
        step("Verify: load a module whose attribute names are all known")
        assert_true(true)

describe "Integration - Performance":
    it "compiles large actor modules":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): field read from the last of 5 declared actors
        step("Verify: construct P05, the last of the 5 declared actors")
        val last = P05(id: 5)
        expect(last.id).to_equal(5)  # oracle: field value P05 was built with

    it "handles deeply nested awaits":
        # @req REQ-SSPEC-UNIT
        # @capture(statistics): chained-await final value
        step("Verify: run the five-level chained await")
        val result = run_d5()
        expect(result).to_equal(5)  # oracle: d1=1 and each level adds 1

    it "handles many attributes":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): eleven-attribute helper return value
        step("Verify: call the fn carrying eleven attributes")
        val r = eleven_attrs()
        expect(r).to_equal(42)  # oracle: eleven-attribute fn body returns 42
