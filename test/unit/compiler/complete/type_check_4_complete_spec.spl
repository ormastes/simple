# @req: REQ-COMPILER-COMPLETE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/complete/type_check_4_complete_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

# @req: REQ-CMP-COMPILER_BACKEND-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/compiler_backend_behavior.md
# doc-path: doc/03_plan/sys_test/compiler_backend_behavior.md
# doc-path: doc/04_architecture/lib/compiler_backend.md
# doc-path: doc/05_design/lib/compiler_backend_oracles.md
# @manual: primary

use std.spec
use compiler.backend.backend.backend_types.{CodegenTarget}
use std.spec.step

# doc-path: doc/01_research/local/type_check_4_complete.md
# doc-path: doc/03_plan/sys_test/type_check_4_complete.md
# doc-path: doc/04_architecture/type_check_4_complete.md
# doc-path: doc/05_design/type_check_4_complete.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "string split, join and repeat":
        step("Verify: string split, join and repeat")
        # @req: REQ-COMPILER-COMPLETE-001
        # @req: REQ-CMP-COMPILER_BACKEND-001
        expect("a,b,c".split(",")).to_equal(["a", "b", "c"])
        expect("ha".repeat(3)).to_equal("hahaha")
        expect("ab".reverse()).to_equal("ba")

    it "dict get, keys and membership":
        step("Verify: dict get, keys and membership")
        # @req: REQ-COMPILER-COMPLETE-001
        val d = {"a": 1}
        expect(d.get("a")).to_equal(1)  # oracle: stored value
        expect(d.has("b")).to_equal(false)
        expect(d.keys()).to_equal(["a"])

    it "for-in accumulates array elements":
        step("Verify: for-in accumulates array elements")
        # @req: REQ-COMPILER-COMPLETE-001
        var s = 0
        for x in [1, 2, 3]:
            s = s + x
        expect(s).to_equal(6)  # oracle: 1+2+3

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "base64 RFC 4648 vectors and roundtrip":
        step("Verify: base64 RFC 4648 vectors and roundtrip")
        # @req: REQ-COMPILER-COMPLETE-001
        use std.common.base_encoding.base64.{base64_encode, base64_decode}
        expect(base64_encode("Man")).to_equal("TWFu")  # oracle: RFC 4648 illustration
        expect(base64_decode("TWFu")).to_equal("Man")
        expect(base64_decode(base64_encode("roundtrip"))).to_equal("roundtrip")

    it "truncating division and signed remainder":
        step("Verify: truncating division and signed remainder")
        # @req: REQ-COMPILER-COMPLETE-001
        expect(7 / 2).to_equal(3)  # oracle: i64 division truncates toward zero
        expect(-7 / 2).to_equal(-3)  # oracle: truncation is toward zero
        expect(7 % 2).to_equal(1)  # oracle: remainder of positive dividend
        expect(-7 % 2).to_equal(-1)  # oracle: remainder keeps dividend sign

    it "integer arithmetic precedence":
        step("Verify: integer arithmetic precedence")
        # @req: REQ-COMPILER-COMPLETE-001
        expect(2 + 3 * 4).to_equal(14)  # oracle: * binds tighter than +
        expect(10 - 2 * 3).to_equal(4)  # oracle: multiplication precedes subtraction
        expect((2 + 3) * 4).to_equal(20)  # oracle: parentheses force additive group first
