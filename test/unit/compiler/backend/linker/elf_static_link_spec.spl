# Internal static ELF link errors + input handling — lane A7 slice 1
#
# @cover src/compiler/70.backend/linker/elf/elf_static_link.spl
# @cover src/compiler/70.backend/linker/elf_parser.spl

use compiler.backend.linker.elf.elf_static_link.{elf_static_link}
use compiler.backend.linker.elf_parser.{elf_parse_object, ElfObject, ElfSymbol,
    ElfRelocation, ElfStringTable}
use compiler.backend.linker.elf_inspect.{ElfHeader, ElfSectionHeader}
use compiler.backend.linker.elf.section_gc.{elf_section_gc}
use compiler.backend.linker.sym_resolver.{sym_resolve_objects}
use compiler.backend.linker.reloc_engine.{RelocArch}
use std.io_runtime.{file_read_bytes}

val FIX: text = "test/fixtures/linker/elf"

fn load_fixture(name: text) -> [i64]:
    val raw = file_read_bytes("{FIX}/{name}")
    var out: [i64] = []
    var i: i64 = 0
    while i < raw.len():
        out = out.push(raw[i] as i64)
        i = i + 1
    out

fn link_err(objs: [[i64]], entry: text, target: RelocArch) -> text:
    val r = elf_static_link(objs, [], entry, target)
    if r.is_ok():
        return ""
    r.unwrap_err()

fn _put_u32(raw: [u8], at: i64, value: i64) -> [u8]:
    var out = raw
    out[at] = (value & 0xff) as u8
    out[at + 1] = ((value >> 8) & 0xff) as u8
    out[at + 2] = ((value >> 16) & 0xff) as u8
    out[at + 3] = ((value >> 24) & 0xff) as u8
    out

fn eh_lsda_object() -> ElfObject:
    # .text (1) holds _start; .gcc_except_table (2) is reachable only from
    # the .eh_frame (3) FDE whose pc_begin names .text: CIE at 0, FDE at 16
    # (pc_begin at +8 = 24, LSDA pointer at 32), zero terminator at 36.
    var shstr: [u8] = [0u8]
    for name in [".text", ".gcc_except_table", ".eh_frame"]:
        for ch in name.bytes():
            shstr = shstr.push(ch as u8)
        shstr = shstr.push(0u8)
    var raw: [u8] = []
    while raw.len() < 0x88:
        raw = raw.push(0u8)
    raw = _put_u32(raw, 0x60, 12)
    raw = _put_u32(raw, 0x70, 16)
    raw = _put_u32(raw, 0x74, 20)
    val empty = ElfStringTable(data: [], offset: 0)
    ElfObject(
        header: ElfHeader(e_type: 1, e_machine: 62, e_entry: 0, e_phoff: 0,
            e_shoff: 0, e_shnum: 4, e_shstrndx: 0),
        sections: [
            ElfSectionHeader(sh_name: 0, sh_type: 0, sh_flags: 0, sh_addr: 0, sh_size: 0, sh_info: 0),
            ElfSectionHeader(sh_name: 1, sh_type: 1, sh_flags: 6, sh_addr: 0x40, sh_size: 4, sh_info: 0),
            ElfSectionHeader(sh_name: 7, sh_type: 1, sh_flags: 2, sh_addr: 0x50, sh_size: 4, sh_info: 0),
            ElfSectionHeader(sh_name: 25, sh_type: 1, sh_flags: 2, sh_addr: 0x60, sh_size: 40, sh_info: 0)],
        symbols: [
            ElfSymbol(st_name: 0, st_info: 0, st_other: 0, st_shndx: 0, st_value: 0, st_size: 0, name: ""),
            ElfSymbol(st_name: 0, st_info: 3, st_other: 0, st_shndx: 1, st_value: 0, st_size: 0, name: ""),
            ElfSymbol(st_name: 0, st_info: 3, st_other: 0, st_shndx: 2, st_value: 0, st_size: 0, name: ""),
            ElfSymbol(st_name: 0, st_info: 0x12, st_other: 0, st_shndx: 1, st_value: 0, st_size: 4, name: "_start")],
        relocations: [
            ElfRelocation(r_offset: 24, r_info: (1 << 32) | 2, r_addend: 0, section_idx: 0, target_section_idx: 3),
            ElfRelocation(r_offset: 32, r_info: (2 << 32) | 2, r_addend: 0, section_idx: 0, target_section_idx: 3)],
        strtab: empty, shstrtab: ElfStringTable(data: shstr, offset: 0), raw: raw)

describe "elf_section_gc - .eh_frame LSDA reachability":
    it "keeps the LSDA of a live function's FDE and drops a dead function's":
        val obj = eh_lsda_object()
        val res = sym_resolve_objects([obj])
        val live = elf_section_gc([obj], res, "_start", [], []).live
        expect(live[0][1]).to_equal(true)
        expect(live[0][2]).to_equal(true)
        val dead = elf_section_gc([obj], res, "", [], []).live
        expect(dead[0][1]).to_equal(false)
        expect(dead[0][2]).to_equal(false)

describe "elf_static_link - errors":
    it "duplicate strong definition is an error":
        val lib = load_fixture("lib_a64.o")
        val e = link_err([load_fixture("start_a64.o"), lib, lib], "_start", RelocArch.AArch64)
        expect(e.contains("duplicate symbol: add_val")).to_equal(true)

    it "strong undefined reference is an error":
        val e = link_err([load_fixture("start_a64.o")], "_start", RelocArch.AArch64)
        expect(e.contains("undefined symbol")).to_equal(true)
        expect(e.contains("add_val")).to_equal(true)

    it "missing entry symbol is an error":
        val e = link_err([load_fixture("start_a64.o"), load_fixture("lib_a64.o")], "main", RelocArch.AArch64)
        expect(e.contains("entry symbol not defined: main")).to_equal(true)

    it "object for another machine is rejected":
        val e = link_err([load_fixture("start_x64.o")], "_start", RelocArch.AArch64)
        expect(e.contains("does not match target")).to_equal(true)

    it "riscv target is rejected in slice 1":
        val e = link_err([load_fixture("start_a64.o")], "_start", RelocArch.Riscv64)
        expect(e.contains("slice 1")).to_equal(true)

describe "elf_parser - LLVM combined .strtab":
    it "resolves symbol names when .strtab is also e_shstrndx":
        val obj = elf_parse_object(load_fixture("start_a64.o")).unwrap()
        var names: [text] = []
        for s in obj.symbols:
            names = names.push(s.name)
        expect(names.contains("_start")).to_equal(true)
        expect(names.contains("add_val")).to_equal(true)
