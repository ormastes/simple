use std.spec.*
use compiler.backend.linker.coff.coff_import.{
    CoffImportObject, COFF_IMPORT_CODE, COFF_IMPORT_DATA,
    COFF_IMPORT_ORDINAL, COFF_IMPORT_NAME}
use compiler.backend.linker.coff.pe_import_builder.{pe_build_amd64_imports}

fn _pib_import(name: text, dll: text, import_type: i64, name_type: i64) -> CoffImportObject:
    CoffImportObject(machine: 0x8664, public_name: name,
        import_name: if name_type == COFF_IMPORT_ORDINAL: "" else: name,
        dll_name: dll, hint_or_ordinal: 7,
        import_type: import_type, name_type: name_type)

fn _pib_u32(bytes: [u8], offset: i64) -> i64:
    (bytes[offset] as i64) | ((bytes[offset + 1] as i64) << 8) |
        ((bytes[offset + 2] as i64) << 16) | ((bytes[offset + 3] as i64) << 24)

describe "PE AMD64 import builder":
    it "emits descriptors, IAT symbols, and RIP-relative code thunks":
        val image = pe_build_amd64_imports([
            _pib_import("ExitProcess", "KERNEL32.dll", COFF_IMPORT_CODE, COFF_IMPORT_NAME),
            _pib_import("MessageBoxA", "USER32.dll", COFF_IMPORT_CODE, COFF_IMPORT_NAME),
        ], 0x1000, 0x2000)
        expect(image.is_ok()).to_equal(true)
        val built = image.unwrap()
        expect(built.descriptor_size).to_equal(60)
        expect(built.iat_offset).to_equal(92)
        expect(built.iat_size).to_equal(32)
        expect(built.thunk_data.len()).to_equal(12)
        expect(built.thunk_data[0] as i64).to_equal(0xff)
        expect(built.thunk_data[1] as i64).to_equal(0x25)
        expect(built.symbol_rvas["ExitProcess"]).to_equal(0x1000)
        expect(built.symbol_rvas["MessageBoxA"]).to_equal(0x1006)
        expect(built.symbol_rvas["__imp_ExitProcess"]).to_be_greater_than(0x2000)
        expect(_pib_u32(built.idata_data, 0)).to_equal(0x203c)
        expect(_pib_u32(built.idata_data, 20)).to_be_greater_than(0x203c)

    it "maps data imports directly to their IAT slots":
        val image = pe_build_amd64_imports([
            _pib_import("errno", "ucrtbase.dll", COFF_IMPORT_DATA, COFF_IMPORT_NAME),
        ], 0x1000, 0x2000).unwrap()
        expect(image.thunk_data.len()).to_equal(0)
        expect(image.symbol_rvas["errno"]).to_equal(image.symbol_rvas["__imp_errno"])

    it "encodes ordinal imports with the PE32+ high-bit marker":
        val image = pe_build_amd64_imports([
            _pib_import("OrdinalSeven", "KERNEL32.dll", COFF_IMPORT_CODE, COFF_IMPORT_ORDINAL),
        ], 0x1000, 0x2000).unwrap()
        val lookup_offset = 40
        expect(image.idata_data[lookup_offset + 7] as i64).to_equal(0x80)

    it "returns an empty projection for no imports":
        val image = pe_build_amd64_imports([], 0, 0).unwrap()
        expect(image.idata_data.len()).to_equal(0)
        expect(image.thunk_data.len()).to_equal(0)
