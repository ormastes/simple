fn _ld_roundtrip_path(path: text) -> text:
    val src = file_read(path)
    if src.len() == 0:
        return "empty read: {path}"
    val first = ld_parse(src)
    if first.is_err():
        return "{path}: {first.unwrap_err()}"
    val printed = ld_print(first.unwrap())
    if not ld_tokens_equivalent(src, printed):
        return "{path}: printed script is not token-equivalent"
    val second = ld_parse(printed)
    if second.is_err():
        return "{path}: reparse failed: {second.unwrap_err()}"
    if ld_print(second.unwrap()) != printed:
        return "{path}: print is not idempotent"
    "ok"

describe "linker_script - every in-tree .ld script":
    it "parses and round-trips all 50 scripts":
        var failures: [text] = []
        for path in ALL_LD_SCRIPTS:
            val r = _ld_roundtrip_path(path)
            if r != "ok":
                failures = failures.push(r)
        expect(failures).to_equal([])
        expect(ALL_LD_SCRIPTS.len()).to_equal(50)

describe "linker_script - operators, INCLUDE, EXTERN, bare names":
    it "tokenizes compound and bitwise operators instead of dropping them":
        val tokens = ld_tokenize("a <= b >= c ! d & e % f ~ g")
        expect(tokens[1].kind == LdTokenKind.Op).to_equal(true)
        expect(tokens[1].value).to_equal("<=")
        expect(tokens[3].value).to_equal(">=")
        expect(tokens[5].value).to_equal("!")
        expect(tokens[7].value).to_equal("&")
        expect(tokens[9].value).to_equal("%")
        expect(tokens[11].value).to_equal("~")

    it "keeps an unknown character as a token and rejects it by name":
        val tokens = ld_tokenize("ENTRY(@)")
        expect(tokens[2].kind == LdTokenKind.Unknown).to_equal(true)
        expect(tokens[2].value).to_equal("@")
        val r = ld_parse("ENTRY(_start) _x = 0x1000 @ 4;")
        expect(r.is_err()).to_equal(true)
        expect(r.unwrap_err().contains("'@'")).to_equal(true)

    it "parses ASSERT with <= and ORIGIN/LENGTH":
        val script = ld_parse("ASSERT(_stack_top <= ORIGIN(RAM) + LENGTH(RAM), \"Stack overflows RAM\")").unwrap()
        expect(script.top_stmts[0].kind == LdStmtKind.Assert).to_equal(true)
        expect(script.top_stmts[0].expr).to_equal("_stack_top <= ORIGIN(RAM) + LENGTH(RAM)")

    it "keeps INCLUDE as an unresolved directive node":
        val script = ld_parse("INCLUDE \"common.ld\"").unwrap()
        expect(script.top_stmts[0].kind == LdStmtKind.Include).to_equal(true)
        expect(script.top_stmts[0].message).to_equal("common.ld")

    it "parses EXTERN symbol lists":
        val script = ld_parse("ENTRY(_entry32) EXTERN(_entry32 _other)").unwrap()
        expect(script.top_stmts[0].kind == LdStmtKind.Extern).to_equal(true)
        expect(script.top_stmts[0].patterns).to_equal(["_entry32", "_other"])

    it "parses unquoted OUTPUT_FORMAT and quoted OUTPUT_ARCH":
        val script = ld_parse("OUTPUT_FORMAT(elf32-i386) OUTPUT_ARCH(\"riscv\")").unwrap()
        expect(script.output_format).to_equal("elf32-i386")
        expect(script.output_format_quoted).to_equal(false)
        expect(script.output_arch).to_equal("riscv")
        expect(script.output_arch_quoted).to_equal(true)
