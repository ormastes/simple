        expect(inspected.sections.len()).to_equal(2)
        expect(inspected.sections[1].name).to_equal(".bss")
        expect(inspected.sections[1].virtual_size).to_equal(8)
        expect(inspected.sections[1].raw_size).to_equal(0)

    it "applies SECTION and SECREL debug relocations":
        var section_object = _cl_importing_object()
        section_object[74] = 0x0a
        section_object[106] = 1
        val section_image = coff_link_amd64(CoffLinkRequest(objects: [section_object],
            archives: [], entry: "_start")).unwrap()
        expect(section_image[0x201] as i64).to_equal(1)
        expect(section_image[0x202] as i64).to_equal(0)

        var secrel_object = _cl_importing_object()
        secrel_object[74] = 0x0b
        secrel_object[102] = 4
        secrel_object[106] = 1
