        expect(inspected.sections.len()).to_equal(3)
        expect(inspected.sections[1].name).to_equal(".text$im")
        expect(inspected.sections[2].name).to_equal(".idata")

    it "allocates unresolved nonzero common symbols in zero-file-byte BSS":
        var object = _cl_importing_object()
        object[74] = 3
        object[102] = 8
        val linked = coff_link_amd64(CoffLinkRequest(objects: [object],
            archives: [], entry: "_start"))
        expect(linked.is_ok()).to_equal(true)
