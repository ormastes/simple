            archives: [], entry: "_start")).unwrap()
        expect(secrel_image[0x201] as i64).to_equal(4)
        expect(secrel_image[0x202] as i64).to_equal(0)

    it "uses absolute COFF symbol values without image-base adjustment":
        var object = _cl_importing_object()
        object[74] = 0x02
        object[102] = 0x78
        object[103] = 0x56
        object[104] = 0x34
        object[105] = 0x12
        object[106] = 0xff
        object[107] = 0xff
        object[110] = 3
        val image = coff_link_amd64(CoffLinkRequest(objects: [object],
            archives: [], entry: "_start")).unwrap()

        expect(image[0x201] as i64).to_equal(0x78)
        expect(image[0x202] as i64).to_equal(0x56)
        expect(image[0x203] as i64).to_equal(0x34)
        expect(image[0x204] as i64).to_equal(0x12)

        object[74] = 0x0a
        val invalid = coff_link_amd64(CoffLinkRequest(objects: [object],
            archives: [], entry: "_start"))
        expect(invalid.is_err()).to_equal(true)
        expect(invalid.unwrap_err()).to_contain("cannot target absolute COFF symbol")

    it "resolves an external reference to an absolute definition in another object":
        var reference = _cl_set_second_symbol_name(_cl_importing_object(), "constant")
        reference[74] = 0x02
        var definition = _cl_object("constant", -1)
        definition[69] = 0x78
        definition[70] = 0x56
        definition[71] = 0x34
        definition[72] = 0x12
        val image = coff_link_amd64(CoffLinkRequest(
            objects: [reference, definition], archives: [], entry: "_start")).unwrap()

        expect(image[0x201] as i64).to_equal(0x78)
        expect(image[0x202] as i64).to_equal(0x56)
        expect(image[0x203] as i64).to_equal(0x34)
        expect(image[0x204] as i64).to_equal(0x12)

        reference[74] = 0x0a
        val invalid = coff_link_amd64(CoffLinkRequest(
            objects: [reference, definition], archives: [], entry: "_start"))
        expect(invalid.is_err()).to_equal(true)
        expect(invalid.unwrap_err()).to_contain("cannot target absolute COFF symbol")

    it "applies SECREL7 and rejects offsets outside seven bits":
        var object = _cl_importing_object()
        object[74] = 0x0c
        object[61] = 0x80
        object[102] = 5
        object[106] = 1
        val image = coff_link_amd64(CoffLinkRequest(objects: [object],
            archives: [], entry: "_start")).unwrap()
        expect(image[0x201] as i64).to_equal(0x85)

        object[61] = 0
        object[102] = 128
        val overflow = coff_link_amd64(CoffLinkRequest(objects: [object],
            archives: [], entry: "_start"))
        expect(overflow.is_err()).to_equal(true)
        expect(overflow.unwrap_err()).to_contain("SECREL7 out of 7-bit range")

    it "sorts dollar subsections and merges them into one PE section":
        var z_section = _cl_set_section_name(_cl_object("_start", 1), ".text$z")
        var a_section = _cl_set_section_name(_cl_object("helper", 1), ".text$a")
        z_section[60] = 0x5a
        a_section[60] = 0x41
        val linked = coff_link_amd64(CoffLinkRequest(objects: [z_section, a_section],
            archives: [], entry: "_start")).unwrap()
        val inspected = pe_inspect(linked).unwrap()
        expect(inspected.sections.len()).to_equal(1)
        expect(inspected.sections[0].name).to_equal(".text")
        expect(inspected.header.entry_point_rva).to_equal(0x1001)
        expect(linked[0x200] as i64).to_equal(0x41)
        expect(linked[0x201] as i64).to_equal(0x5a)

    it "preserves input alignment while merging dollar subsections":
        var first = _cl_set_section_name(_cl_object("helper", 1), ".text$a")
        var aligned = _cl_set_section_name(_cl_object("_start", 1), ".text$z")
        aligned[58] = 0x50
        val linked = coff_link_amd64(CoffLinkRequest(objects: [first, aligned],
            archives: [], entry: "_start")).unwrap()
        val inspected = pe_inspect(linked).unwrap()
        expect(inspected.header.entry_point_rva).to_equal(0x1010)
        expect(inspected.sections[0].virtual_size).to_equal(17)
        expect(linked[0x200] as i64).to_equal(0xc3)
        expect(linked[0x20f] as i64).to_equal(0)
        expect(linked[0x210] as i64).to_equal(0xc3)

    it "rejects the reserved COFF section alignment encoding":
        var object = _cl_object("_start", 1)
        object[58] = 0xf0
        val linked = coff_link_amd64(CoffLinkRequest(objects: [object],
            archives: [], entry: "_start"))
        expect(linked.is_err()).to_equal(true)
        expect(linked.unwrap_err()).to_contain("reserved alignment encoding 15")

    it "aligns the first contribution against its absolute image address":
        var object = _cl_object("_start", 1)
        object[58] = 0xe0
        val linked = coff_link_amd64(CoffLinkRequest(objects: [object],
            archives: [], entry: "_start")).unwrap()
        val inspected = pe_inspect(linked).unwrap()
        expect(inspected.header.entry_point_rva).to_equal(0x2000)
        expect(inspected.sections[0].virtual_address).to_equal(0x2000)
        expect(linked[0x200] as i64).to_equal(0xc3)

    it "discards object-only CodeView streams from PE output":
        val debug = _cl_set_section_name(
            _cl_object("debug_record", 1), ".debug$S")
        val linked = coff_link_amd64(CoffLinkRequest(objects: [
            _cl_object("_start", 1), debug], archives: [], entry: "_start")).unwrap()
        val inspected = pe_inspect(linked).unwrap()
        expect(inspected.sections.len()).to_equal(1)
        expect(inspected.sections[0].name).to_equal(".text")
        expect(inspected.sections[0].virtual_size).to_equal(1)
