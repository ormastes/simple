use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "LLVM adapter operation policy":
    it "samples trace and target mode once per direct compile operation":
        val source = file_read(
            "src/compiler/70.backend/backend/llvm_codegen_adapter.spl")
        val direct_start = source.index_of("pub fn llvm_compile_module_direct(")
        val compiled_start = source.index_of(
            "pub fn llvm_compile_module_direct_compiled")
        val impl_start = source.index_of("impl Codegen for LlvmCodegenAdapter")
        val direct = source.substring(direct_start, compiled_start)
        val compiled = source.substring(compiled_start, impl_start)
        expect(direct).to_contain(
            "val trace_enabled = llvm_codegen_trace_enabled()")
        expect(direct).to_contain(
            "val bare_metal = llvm_codegen_bare_metal_requested()")
        expect(direct).not.to_contain("if llvm_codegen_trace_enabled()")
        expect(direct).to_contain("module.functions.len()")
        expect(direct).not.to_contain("module.functions.keys().len()")
        expect(compiled).to_contain(
            "val trace_enabled = llvm_codegen_trace_enabled()")
        expect(compiled).to_contain(
            "val bare_metal = llvm_codegen_bare_metal_requested()")
        expect(compiled).not.to_contain("if llvm_codegen_trace_enabled()")

    it "feeds one target snapshot to config and translator":
        val source = file_read(
            "src/compiler/70.backend/backend/llvm_codegen_adapter.spl")
        expect(source).to_contain(
            "llvm_codegen_target_config_for(options, bare_metal)")
        expect(source).to_contain(
            "llvm_translate_module_direct_ir_for(options, module, bare_metal)")
        expect(source).to_contain(
            "\"app.cli.bootstrap_main\", options.target, bare_metal")
        expect(source).to_contain("[llvm-direct] start")
        expect(source).to_contain("[llvm-direct] done")
        expect(source).to_contain("[llvm-direct] compiled:bytes")

