        step("Verify: UMULLT Z31.S Z31.H Z31.H byte3 is 0x45")
        val result = emit_umullt_z_s(31, 31, 31)
        expect(result[3]).to_equal(69)  # oracle: 69 — named expected value from the requirement

# ============================================================================
# SMULLB Zd.D, Zn.S, Zm.S — signed widening multiply, bottom halves, 64-bit
# Base opcode: 0x45C07000 → LE [0x00, 0x70, 0xC0, 0x45]
# bits[23:22]=11 (D result from S sources); same opcode sub-field as .S form
# ============================================================================

describe "SVE2 emit_smullb_z_d golden Z0 Z0 Z0":
    it "SMULLB Z0.D Z0.S Z0.S emits 4 bytes":
        step("Verify: SMULLB Z0.D Z0.S Z0.S emits 4 bytes")
        val result = emit_smullb_z_d(0, 0, 0)
        expect(result.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "SMULLB Z0.D Z0.S Z0.S byte0 is 0x00":
        step("Verify: SMULLB Z0.D Z0.S Z0.S byte0 is 0x00")
        val result = emit_smullb_z_d(0, 0, 0)
        expect(result[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "SMULLB Z0.D Z0.S Z0.S byte1 is 0x70":
        step("Verify: SMULLB Z0.D Z0.S Z0.S byte1 is 0x70")
        # bits[15:8]=0x70: same widening multiply sub-field as S form
        val result = emit_smullb_z_d(0, 0, 0)
        expect(result[1]).to_equal(112)  # oracle: 112 — named expected value from the requirement

    it "SMULLB Z0.D Z0.S Z0.S byte2 is 0xC0":
        step("Verify: SMULLB Z0.D Z0.S Z0.S byte2 is 0xC0")
        # bits[23:16]=0xC0: size=11 (D result) with Zm=0 → 0xC0 vs 0x80 for S
        val result = emit_smullb_z_d(0, 0, 0)
        expect(result[2]).to_equal(192)  # oracle: 192 — named expected value from the requirement

    it "SMULLB Z0.D Z0.S Z0.S byte3 is 0x45":
        step("Verify: SMULLB Z0.D Z0.S Z0.S byte3 is 0x45")
        val result = emit_smullb_z_d(0, 0, 0)
        expect(result[3]).to_equal(69)  # oracle: 69 — named expected value from the requirement

describe "SVE2 emit_smullb_z_d Z0 Z1 Z2":
    it "SMULLB Z0.D Z1.S Z2.S byte0 is 0x20":
        step("Verify: SMULLB Z0.D Z1.S Z2.S byte0 is 0x20")
        # Zd=0, Zn=1 → byte0 = 1*32 = 32
