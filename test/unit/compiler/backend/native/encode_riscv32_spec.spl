"""
## Purpose and audience
Purpose: Prove that Encode Riscv32.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-BACKEND-001 — stable requirement identity for this spec.

use std.spec.*

use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.backend.backend.riscv_target.{riscv_linux_target_contract}
use compiler.backend.native.encode_riscv32.{ELF32_EI_CLASS, ELF32_HEADER_SIZE}

describe "Encode Riscv32":
    it "retains ELF32 constants for the RV32 Linux lane":
        step("Verify: retains ELF32 constants for the RV32 Linux lane")
        # @req: REQ-COMPILER-BACKEND-001
        expect(ELF32_EI_CLASS).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(ELF32_HEADER_SIZE).to_equal(52)  # oracle: 52 — named expected value from the requirement

    it "shares the Linux call relocation and ABI contract":
        step("Verify: shares the Linux call relocation and ABI contract")
        val contract = riscv_linux_target_contract(CodegenTarget.Riscv32)
        expect(contract.call_plt_reloc).to_equal(19)  # oracle: 19 — named expected value from the requirement
        expect(contract.abi_text()).to_equal("ilp32d")
        expect(contract.march).to_equal("rv32gc")
