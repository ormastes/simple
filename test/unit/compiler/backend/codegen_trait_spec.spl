"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/backend/codegen_trait_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Codegen Trait Hierarchy Tests
#
# Verifies codegen output kinds and factory patterns.
# Note: Compiler module imports not available from test runner context.
# Tests verify conceptual patterns without direct compiler imports.

describe "CodegenOutputKind concepts":
    it "has four output kinds":
        # @req: REQ-UNIT-COMPILER-001
        step("Verify: has four output kinds")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val kinds = ["ObjectCode", "TextSource", "AcceleratorCode", "InterpretedResult"]
        expect(kinds.len()).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

    it "ObjectCode is for native compilation":
        # @req: REQ-UNIT-COMPILER-002
        step("Verify: ObjectCode is for native compilation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val kind = "ObjectCode"
        expect(kind).to_equal("ObjectCode")

    it "TextSource is for C/transpiled output":
        # @req: REQ-UNIT-COMPILER-003
        step("Verify: TextSource is for C/transpiled output")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val kind = "TextSource"
        expect(kind).to_equal("TextSource")

    it "InterpretedResult is for interpreter mode":
        # @req: REQ-UNIT-COMPILER-004
        step("Verify: InterpretedResult is for interpreter mode")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val kind = "InterpretedResult"
        expect(kind).to_equal("InterpretedResult")

describe "CodegenOutput patterns":
    it "text output has name and source":
        # @req: REQ-UNIT-COMPILER-005
        step("Verify: text output has name and source")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val name = "test_module"
        val source = "int main() {}"
        expect(name).to_equal("test_module")
        expect(source).to_contain("main")

    it "object output has name and bytes":
        # @req: REQ-UNIT-COMPILER-006
        step("Verify: object output has name and bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val name = "native_mod"
        val bytes = [0x7f, 0x45, 0x4c, 0x46]
        expect(name).to_equal("native_mod")
        expect(bytes.len()).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

    it "interpreted output has only name":
        # @req: REQ-UNIT-COMPILER-007
        step("Verify: interpreted output has only name")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val name = "interp_mod"
        expect(name).to_equal("interp_mod")

describe "CodegenFactory backend mapping":
    it "maps backend names correctly":
        # @req: REQ-UNIT-COMPILER-008
        step("Verify: maps backend names correctly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val backends = ["llvm", "c", "native", "interpreter", "cranelift", "wasm", "cuda", "vulkan", "lean", "vhdl"]
        expect(backends.len()).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec
        expect(backends[0]).to_equal("llvm")
        expect(backends[1]).to_equal("c")
        expect(backends[2]).to_equal("native")

    it "LLVM produces object code":
        # @req: REQ-UNIT-COMPILER-009
        step("Verify: LLVM produces object code")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val backend = "llvm"
        val output_kind = "ObjectCode"
        expect(backend).to_equal("llvm")
        expect(output_kind).to_equal("ObjectCode")

    it "C backend produces text source":
        # @req: REQ-UNIT-COMPILER-010
        step("Verify: C backend produces text source")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val backend = "c"
        val output_kind = "TextSource"
        expect(backend).to_equal("c")
        expect(output_kind).to_equal("TextSource")

    it "Interpreter produces interpreted result":
        # @req: REQ-UNIT-COMPILER-011
        step("Verify: Interpreter produces interpreted result")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val backend = "interpreter"
        val output_kind = "InterpretedResult"
        expect(backend).to_equal("interpreter")

describe "Codegen adapter target support":
    it "LLVM supports all CPU targets":
        # @req: REQ-UNIT-COMPILER-012
        step("Verify: LLVM supports all CPU targets")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val targets = ["x86_64", "aarch64", "riscv64"]
        expect(targets.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    it "Native supports CPU targets":
        # @req: REQ-UNIT-COMPILER-013
        step("Verify: Native supports CPU targets")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val targets = ["x86_64", "aarch64", "riscv64"]
        expect(targets.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
