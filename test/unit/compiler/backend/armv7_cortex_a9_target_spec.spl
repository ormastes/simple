"""Cortex-A9 soft-float selection for the Cosmos+ bare-metal profile."""

use std.spec.{describe, it, expect}
use compiler.backend.backend.backend_types.{CodegenTarget}
use compiler.backend.backend.llvm_target.{
    LlvmTargetTriple,
    llvm_arm_baremetal_config_for
}

describe "ARMv7 Cortex-A9 bare-metal target profile":
    it "selects Cortex-A9 without VFP4 for the explicit soft-float target":
        val triple = LlvmTargetTriple.from_target_baremetal(CodegenTarget.Arm)
        val config = llvm_arm_baremetal_config_for(
            "armv7-unknown-none-eabi", triple
        )

        expect(config.triple.to_text()).to_equal("armv7-unknown-none-eabi")
        expect(config.cpu).to_equal("cortex-a9")
        expect(config.features.len()).to_equal(0)
        expect(config.abi).to_be_nil()

    it "does not silently apply the board profile to another ARM selector":
        val triple = LlvmTargetTriple.from_target_baremetal(CodegenTarget.Arm)
        val config = llvm_arm_baremetal_config_for(
            "armv7-unknown-linux-gnueabihf", triple
        )

        expect(config.cpu).to_equal("cortex-a7")
        expect(config.features).to_contain("+vfp4")
