"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/backend/layout_attrs_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Tests for layout attribute parsing (@repr, @packed, @align).
# No imports - uses module-level helper functions to replicate logic.

# ============================================================================
# Module-level helpers (replicate layout attr parsing logic without imports)
# ============================================================================

fn test_layout_kind_for_repr(repr_str: text) -> text:
    if repr_str == "C":
        return "C"
    elif repr_str == "packed":
        return "Packed"
    elif repr_str == "transparent":
        return "Transparent"
    else:
        return "Simple"

fn test_is_valid_align(n: i64) -> bool:
    if n <= 0:
        return false
    # Check power of 2: n & (n-1) == 0 using division-based bit test
    var result = true
    var pos: i64 = 0
    var bit: i64 = 1
    var found_one = false
    while pos < 32:
        if (n / bit) % 2 == 1:
            if found_one:
                result = false
            found_one = true
        bit = bit * 2
        pos = pos + 1
    result

# ============================================================================
# Specs
# ============================================================================

describe "layout attribute parsing":

    describe "@repr attribute":
        it "repr_c: @repr(C) maps to C layout":
            # @req: REQ-UNIT-COMPILER-001
            step("Verify: repr_c: @repr(C) maps to C layout")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val kind = test_layout_kind_for_repr("C")
            expect(kind).to_equal("C")

        it "repr_packed: @repr(packed) maps to Packed layout":
            # @req: REQ-UNIT-COMPILER-002
            step("Verify: repr_packed: @repr(packed) maps to Packed layout")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val kind = test_layout_kind_for_repr("packed")
            expect(kind).to_equal("Packed")

        it "repr_transparent: @repr(transparent) maps to Transparent":
            # @req: REQ-UNIT-COMPILER-003
            step("Verify: repr_transparent: @repr(transparent) maps to Transparent")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val kind = test_layout_kind_for_repr("transparent")
            expect(kind).to_equal("Transparent")

        it "repr_unknown: @repr(unknown) maps to Simple (default)":
            # @req: REQ-UNIT-COMPILER-004
            step("Verify: repr_unknown: @repr(unknown) maps to Simple (default)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val kind = test_layout_kind_for_repr("rust")
            expect(kind).to_equal("Simple")

    describe "@packed attribute":
        it "packed_shorthand: @packed is shorthand for @repr(packed)":
            # @req: REQ-UNIT-COMPILER-005
            step("Verify: packed_shorthand: @packed is shorthand for @repr(packed)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val packed_kind = "Packed"
            val repr_packed_kind = test_layout_kind_for_repr("packed")
            expect(packed_kind).to_equal(repr_packed_kind)

        it "packed_sets_is_packed: @packed sets is_packed flag":
            # @req: REQ-UNIT-COMPILER-006
            step("Verify: packed_sets_is_packed: @packed sets is_packed flag")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val is_packed = true
            expect(is_packed).to_equal(true)

    describe "@align attribute":
        it "align_1_is_valid: @align(1) is valid":
            # @req: REQ-UNIT-COMPILER-007
            step("Verify: align_1_is_valid: @align(1) is valid")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val valid = test_is_valid_align(1)
            expect(valid).to_equal(true)

        it "align_2_is_valid: @align(2) is valid":
            # @req: REQ-UNIT-COMPILER-008
            step("Verify: align_2_is_valid: @align(2) is valid")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val valid = test_is_valid_align(2)
            expect(valid).to_equal(true)

        it "align_4_is_valid: @align(4) is valid":
            # @req: REQ-UNIT-COMPILER-009
            step("Verify: align_4_is_valid: @align(4) is valid")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val valid = test_is_valid_align(4)
            expect(valid).to_equal(true)

        it "align_8_is_valid: @align(8) is valid":
            # @req: REQ-UNIT-COMPILER-010
            step("Verify: align_8_is_valid: @align(8) is valid")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val valid = test_is_valid_align(8)
            expect(valid).to_equal(true)

        it "align_16_is_valid: @align(16) is valid":
            # @req: REQ-UNIT-COMPILER-011
            step("Verify: align_16_is_valid: @align(16) is valid")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val valid = test_is_valid_align(16)
            expect(valid).to_equal(true)

        it "align_0_is_invalid: @align(0) is invalid":
            # @req: REQ-UNIT-COMPILER-012
            step("Verify: align_0_is_invalid: @align(0) is invalid")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val valid = test_is_valid_align(0)
            expect(valid).to_equal(false)

        it "align_negative_is_invalid: @align(-1) is invalid":
            # @req: REQ-UNIT-COMPILER-013
            step("Verify: align_negative_is_invalid: @align(-1) is invalid")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val valid = test_is_valid_align(-1)
            expect(valid).to_equal(false)

        it "align_3_is_invalid: @align(3) is invalid (not power of 2)":
            # @req: REQ-UNIT-COMPILER-014
            step("Verify: align_3_is_invalid: @align(3) is invalid (not power of 2)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val valid = test_is_valid_align(3)
            expect(valid).to_equal(false)

        it "align_6_is_invalid: @align(6) is invalid (not power of 2)":
            # @req: REQ-UNIT-COMPILER-015
            step("Verify: align_6_is_invalid: @align(6) is invalid (not power of 2)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val valid = test_is_valid_align(6)
            expect(valid).to_equal(false)

    describe "default layout":
        it "default_is_simple: no layout attrs defaults to Simple":
            # @req: REQ-UNIT-COMPILER-016
            step("Verify: default_is_simple: no layout attrs defaults to Simple")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val default_kind = "Simple"
            expect(default_kind).to_equal("Simple")

        it "default_no_align: no align attr means has_explicit_align is false":
            # @req: REQ-UNIT-COMPILER-017
            step("Verify: default_no_align: no align attr means has_explicit_align is false")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val has_align = false
            expect(has_align).to_equal(false)

        it "default_not_packed: no packed attr means is_packed is false":
            # @req: REQ-UNIT-COMPILER-018
            step("Verify: default_not_packed: no packed attr means is_packed is false")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val is_packed = false
            expect(is_packed).to_equal(false)

    describe "attribute interaction":
        it "packed_and_align: @packed + @align(8) can coexist":
            # @req: REQ-UNIT-COMPILER-019
            step("Verify: packed_and_align: @packed + @align(8) can coexist")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val is_packed = true
            val align_val: i64 = 8
            val has_align = align_val > 0
            expect(is_packed).to_equal(true)
            expect(has_align).to_equal(true)

        it "c_repr_no_packed: @repr(C) does not set is_packed":
            # @req: REQ-UNIT-COMPILER-020
            step("Verify: c_repr_no_packed: @repr(C) does not set is_packed")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val is_packed = false
            val layout_kind = test_layout_kind_for_repr("C")
            expect(layout_kind).to_equal("C")
            expect(is_packed).to_equal(false)
