use std.io_runtime.{env_set}
use compiler.backend.backend.llvm_ir_builder.{LlvmIRBuilder, llvm_ir_builder_build,
    llvm_ir_builder_handle, llvm_ir_builder_push_line}
use compiler.backend.backend.llvm_target.{LlvmTargetTriple}
use compiler.backend.backend_types.{CodegenTarget}

extern fn rt_cli_exit(code: i64)

fn require_once(ir: text, marker: text, code: i64):
    if ir.split(marker).len() != 2:
        rt_cli_exit(code)

fn require_before(ir: text, first: text, second: text, code: i64):
    if ir.split(first)[0].len() >= ir.split(second)[0].len():
        rt_cli_exit(code)

fn main():
    env_set("SIMPLE_BOOTSTRAP", "1")
    val triple = LlvmTargetTriple.from_target(CodegenTarget.X86_64)
    val top = LlvmIRBuilder.create("top", triple)
    val handle = llvm_ir_builder_handle(top)
    top.emit_module_header()
    llvm_ir_builder_push_line(handle, "@g_probe = global i64 42")
    llvm_ir_builder_push_line(handle, "define i64 @body() nounwind {{")
    llvm_ir_builder_push_line(handle, "bb0:")
    top.emit_ret("i64", "42")
    llvm_ir_builder_push_line(handle, "}")
    llvm_ir_builder_push_line(handle, "")

    val incidental = LlvmIRBuilder.create("incidental", triple)
    val _ = incidental.local_counter

    top.emit("; retained tail")
    val ir = llvm_ir_builder_build(top)
    env_set("SIMPLE_BOOTSTRAP", "")

    require_once(ir, "ModuleID = 'top'", 11)
    require_once(ir, "define i64 @body()", 12)
    require_once(ir, "; retained tail", 13)
    require_once(ir, "@g_probe = global i64 42", 15)
    require_once(ir, "bb0:", 16)
    require_before(ir, "ModuleID = 'top'", "@g_probe = global i64 42", 17)
    require_before(ir, "@g_probe = global i64 42", "define i64 @body()", 18)
    require_before(ir, "define i64 @body()", "bb0:", 19)
    if ir.contains("g_undeclared"):
        rt_cli_exit(20)
    if ir.contains("incidental"):
        rt_cli_exit(14)

    print "LLVM_IR_BUILDER_INCIDENTAL_PROBE_PASS"
    rt_cli_exit(0)
