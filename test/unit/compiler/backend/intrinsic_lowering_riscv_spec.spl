# @req: REQ-COMPILER-BACKEND-001

# test/unit/compiler/backend/intrinsic_lowering_riscv_spec.spl
#
# Tests for RV64 Zvk intrinsic lowering.
# Covers: name->idiom mapping, full-caps bytes, no-cap, unknown, bad-arity.

use std.spec
use compiler.backend.feature_caps.{TargetIdiom, Rv64Caps}
use compiler.backend.lowering.intrinsic_lowering_riscv.{
    intrinsic_to_target_idiom_riscv,
    lower_cipher_intrinsic_riscv,
    LoweringResult
}

fn full_caps() -> Rv64Caps:
    Rv64Caps(
        has_zvkned: true,
        has_zvknh: true,
        has_zvkg: true,
        has_zbb: true,
        has_zbkb: true,
        has_v: true,
        vlen_bits: 128
    )

fn aes_only_caps() -> Rv64Caps:
    Rv64Caps(
        has_zvkned: true,
        has_zvknh: false,
        has_zvkg: false,
        has_zbb: false,
        has_zbkb: false,
        has_v: true,
        vlen_bits: 128
    )

fn scalar_zbb_caps() -> Rv64Caps:
    Rv64Caps(
        has_zvkned: false,
        has_zvknh: false,
        has_zvkg: false,
        has_zbb: true,
        has_zbkb: false,
        has_v: false,
        vlen_bits: 128
    )

fn scalar_zbkb_only_caps() -> Rv64Caps:
    Rv64Caps(
        has_zvkned: false,
        has_zvknh: false,
        has_zvkg: false,
        has_zbb: false,
        has_zbkb: true,
        has_v: false,
        vlen_bits: 128
    )

fn scalar_full_bitmanip_caps() -> Rv64Caps:
    Rv64Caps(
        has_zvkned: false,
        has_zvknh: false,
        has_zvkg: false,
        has_zbb: true,
        has_zbkb: true,
        has_v: false,
        vlen_bits: 128
    )

fn bare_caps() -> Rv64Caps:
    Rv64Caps(
        has_zvkned: false,
        has_zvknh: false,
        has_zvkg: false,
        has_zbb: false,
        has_zbkb: false,
        has_v: false,
        vlen_bits: 128
    )

use std.spec.step

describe "intrinsic_lowering_riscv — name to TargetIdiom":
    it "crypto_aes_round maps to AesEnc":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: crypto_aes_round maps to AesEnc")
        var result = intrinsic_to_target_idiom_riscv("crypto_aes_round")
        match result:
            case Some(idiom):
                expect(idiom).to_equal(TargetIdiom.AesEnc)
            case _:
                expect(0).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "crypto_aes_round_last maps to AesEncLast":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: crypto_aes_round_last maps to AesEncLast")
        var result = intrinsic_to_target_idiom_riscv("crypto_aes_round_last")
        match result:
            case Some(idiom):
                expect(idiom).to_equal(TargetIdiom.AesEncLast)
            case _:
                expect(0).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "crypto_aes_inv_round maps to AesDec":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: crypto_aes_inv_round maps to AesDec")
        var result = intrinsic_to_target_idiom_riscv("crypto_aes_inv_round")
        match result:
            case Some(idiom):
                expect(idiom).to_equal(TargetIdiom.AesDec)
            case _:
                expect(0).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "crypto_aes_inv_round_last maps to AesDecLast":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: crypto_aes_inv_round_last maps to AesDecLast")
        var result = intrinsic_to_target_idiom_riscv("crypto_aes_inv_round_last")
        match result:
            case Some(idiom):
                expect(idiom).to_equal(TargetIdiom.AesDecLast)
            case _:
                expect(0).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "crypto_sha256_rnds2 maps to Sha256Rounds2":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: crypto_sha256_rnds2 maps to Sha256Rounds2")
        var result = intrinsic_to_target_idiom_riscv("crypto_sha256_rnds2")
        match result:
            case Some(idiom):
                expect(idiom).to_equal(TargetIdiom.Sha256Rounds2)
            case _:
                expect(0).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "clmul_lo maps to ClmulLo":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: clmul_lo maps to ClmulLo")
        var result = intrinsic_to_target_idiom_riscv("clmul_lo")
        match result:
            case Some(idiom):
                expect(idiom).to_equal(TargetIdiom.ClmulLo)
            case _:
                expect(0).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "clmul_hi maps to ClmulHi":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: clmul_hi maps to ClmulHi")
        var result = intrinsic_to_target_idiom_riscv("clmul_hi")
        match result:
            case Some(idiom):
                expect(idiom).to_equal(TargetIdiom.ClmulHi)
            case _:
                expect(0).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "bit_popcount maps to Popcount":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: bit_popcount maps to Popcount")
        var result = intrinsic_to_target_idiom_riscv("bit_popcount")
        match result:
            case Some(idiom):
                expect(idiom).to_equal(TargetIdiom.Popcount)
            case _:
                expect(0).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "matrix_dot maps to MatrixDot":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: matrix_dot maps to MatrixDot")
        var result = intrinsic_to_target_idiom_riscv("matrix_dot")
        match result:
            case Some(idiom):
                expect(idiom).to_equal(TargetIdiom.MatrixDot)
            case _:
                expect(0).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "unknown name returns nil":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: unknown name returns nil")
        var result = intrinsic_to_target_idiom_riscv("not_a_real_intrinsic")
        match result:
            case Some(_):
                expect(0).to_equal(1)  # oracle: 1 — named expected value from the requirement
            case _:
                expect(1).to_equal(1)  # oracle: 1 — named expected value from the requirement

describe "intrinsic_lowering_riscv — full caps byte results":
    it "crypto_aes_round lowered with 2 args":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: crypto_aes_round lowered with 2 args")
        # vaesem.vv v1,v2 → [0xD7,0x20,0x20,0xA6]
        var args: [i64] = [1, 2]
        var r = lower_cipher_intrinsic_riscv("crypto_aes_round", args, full_caps())
        expect(r.lowered).to_equal(true)
        expect(r.bytes.length).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(r.bytes[0]).to_equal(0xD7)  # oracle: 0xD7 — named expected value from the requirement
        expect(r.bytes[3]).to_equal(0xA6)  # oracle: 0xA6 — named expected value from the requirement

    it "crypto_aes_round_last → vaesef.vv bytes":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: crypto_aes_round_last → vaesef.vv bytes")
        # vaesef.vv v1,v2 → [0xD7,0x20,0x20,0xA2]
        var args: [i64] = [1, 2]
        var r = lower_cipher_intrinsic_riscv("crypto_aes_round_last", args, full_caps())
        expect(r.lowered).to_equal(true)
        expect(r.bytes.length).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(r.bytes[3]).to_equal(0xA2)  # oracle: 0xA2 — named expected value from the requirement

    it "crypto_aes_inv_round → vaesdm.vv bytes":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: crypto_aes_inv_round → vaesdm.vv bytes")
        # vaesdm.vv v1,v2 → [0xD7,0x20,0x20,0xAE]
        var args: [i64] = [1, 2]
        var r = lower_cipher_intrinsic_riscv("crypto_aes_inv_round", args, full_caps())
        expect(r.lowered).to_equal(true)
        expect(r.bytes.length).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(r.bytes[3]).to_equal(0xAE)  # oracle: 0xAE — named expected value from the requirement

    it "crypto_aes_inv_round_last → vaesdf.vv bytes":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: crypto_aes_inv_round_last → vaesdf.vv bytes")
        # vaesdf.vv v1,v2 → [0xD7,0x20,0x20,0xAA]
        var args: [i64] = [1, 2]
        var r = lower_cipher_intrinsic_riscv("crypto_aes_inv_round_last", args, full_caps())
        expect(r.lowered).to_equal(true)
        expect(r.bytes.length).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(r.bytes[3]).to_equal(0xAA)  # oracle: 0xAA — named expected value from the requirement

    it "crypto_sha256_rnds2 → vsha2cl.vv + vsha2ch.vv (8 bytes)":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: crypto_sha256_rnds2 → vsha2cl.vv + vsha2ch.vv (8 bytes)")
        # vsha2cl.vv v1,v2,v3 + vsha2ch.vv v1,v2,v3
        var args: [i64] = [1, 2, 3]
        var r = lower_cipher_intrinsic_riscv("crypto_sha256_rnds2", args, full_caps())
        expect(r.lowered).to_equal(true)
        expect(r.bytes.length).to_equal(8)  # oracle: 8 — named expected value from the requirement
        # First 4 bytes: vsha2cl.vv → byte[3]=0xBE
        expect(r.bytes[0]).to_equal(0xD7)  # oracle: 0xD7 — named expected value from the requirement
        expect(r.bytes[3]).to_equal(0xBE)  # oracle: 0xBE — named expected value from the requirement
        # Next 4 bytes: vsha2ch.vv → byte[3]=0xBA
        expect(r.bytes[4]).to_equal(0xD7)  # oracle: 0xD7 — named expected value from the requirement
        expect(r.bytes[7]).to_equal(0xBA)  # oracle: 0xBA — named expected value from the requirement

    it "clmul_lo → vghsh.vv bytes":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: clmul_lo → vghsh.vv bytes")
        # vghsh.vv v1,v2,v3 → [0xD7,0xA0,0x21,0xB2]
        var args: [i64] = [1, 2, 3]
        var r = lower_cipher_intrinsic_riscv("clmul_lo", args, full_caps())
        expect(r.lowered).to_equal(true)
        expect(r.bytes.length).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(r.bytes[3]).to_equal(0xB2)  # oracle: 0xB2 — named expected value from the requirement

    it "clmul_hi → vgmul.vv bytes":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: clmul_hi → vgmul.vv bytes")
        # vgmul.vv v1,v2 → [0xD7,0x20,0x20,0xA6]
        var args: [i64] = [1, 2]
        var r = lower_cipher_intrinsic_riscv("clmul_hi", args, full_caps())
        expect(r.lowered).to_equal(true)
        expect(r.bytes.length).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(r.bytes[3]).to_equal(0xA6)  # oracle: 0xA6 — named expected value from the requirement

    it "bit_rotate_left lowers to rol bytes":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: bit_rotate_left lowers to rol bytes")
        # rol rd=1, rs1=2, rs2=3 — Zbb: funct7=0x30, funct3=0x1
        var r = lower_cipher_intrinsic_riscv("bit_rotate_left", [1, 2, 3], scalar_zbb_caps())
        expect(r.lowered).to_equal(true)
        expect(r.reason).to_equal("")
        expect(r.bytes).to_equal([179, 16, 49, 96])

    it "bit_rotate_right lowers to ror bytes via zbkb":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: bit_rotate_right lowers to ror bytes via zbkb")
        # ror rd=1, rs1=2, rs2=3 — Zbkb: funct7=0x30, funct3=0x5
        var r = lower_cipher_intrinsic_riscv("bit_rotate_right", [1, 2, 3], scalar_zbkb_only_caps())
        expect(r.lowered).to_equal(true)
        expect(r.reason).to_equal("")
        expect(r.bytes).to_equal([179, 80, 49, 96])

    it "bit_clz lowers to clz bytes":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: bit_clz lowers to clz bytes")
        var r = lower_cipher_intrinsic_riscv("bit_clz", [1, 2], scalar_zbb_caps())
        expect(r.lowered).to_equal(true)
        expect(r.reason).to_equal("")
        expect(r.bytes).to_equal([147, 16, 1, 96])

    it "bit_ctz lowers to ctz bytes":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: bit_ctz lowers to ctz bytes")
        var r = lower_cipher_intrinsic_riscv("bit_ctz", [1, 2], scalar_zbb_caps())
        expect(r.lowered).to_equal(true)
        expect(r.reason).to_equal("")
        expect(r.bytes).to_equal([147, 16, 17, 96])

    it "bit_popcount lowers to cpop bytes":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: bit_popcount lowers to cpop bytes")
        var r = lower_cipher_intrinsic_riscv("bit_popcount", [1, 2], scalar_zbb_caps())
        expect(r.lowered).to_equal(true)
        expect(r.reason).to_equal("")
        expect(r.bytes).to_equal([147, 16, 33, 96])

    it "bit_bswap lowers to rev8 bytes":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: bit_bswap lowers to rev8 bytes")
        var r = lower_cipher_intrinsic_riscv("bit_bswap", [1, 2], scalar_zbb_caps())
        expect(r.lowered).to_equal(true)
        expect(r.reason).to_equal("")
        expect(r.bytes).to_equal([147, 80, 129, 107])

    it "bit_bitreverse lowers to brev8 + rev8 bytes":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: bit_bitreverse lowers to brev8 + rev8 bytes")
        var r = lower_cipher_intrinsic_riscv("bit_bitreverse", [15, 16], scalar_full_bitmanip_caps())
        expect(r.lowered).to_equal(true)
        expect(r.reason).to_equal("")
        expect(r.bytes).to_equal([147, 87, 120, 104, 147, 87, 136, 107])

describe "intrinsic_lowering_riscv — no-cap cases":
    it "crypto_aes_round with bare caps → no-cap":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: crypto_aes_round with bare caps → no-cap")
        var args: [i64] = [1, 2]
        var r = lower_cipher_intrinsic_riscv("crypto_aes_round", args, bare_caps())
        expect(r.lowered).to_equal(false)
        expect(r.reason).to_equal("no-cap")

    it "crypto_sha256_rnds2 with aes_only caps → no-cap":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: crypto_sha256_rnds2 with aes_only caps → no-cap")
