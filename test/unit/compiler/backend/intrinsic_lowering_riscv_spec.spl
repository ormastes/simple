"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/backend/intrinsic_lowering_riscv_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# test/unit/compiler/backend/intrinsic_lowering_riscv_spec.spl
#
# Tests for RV64 Zvk intrinsic lowering.
# Covers: name->idiom mapping, full-caps bytes, no-cap, unknown, bad-arity.

use std.spec
use compiler.backend.feature_caps.{TargetIdiom, Rv64Caps}
use compiler.backend.lowering.intrinsic_lowering_riscv.{
    intrinsic_to_target_idiom_riscv,
    lower_cipher_intrinsic_riscv,
    LoweringResult
}

fn full_caps() -> Rv64Caps:
    Rv64Caps(
        has_zvkned: true,
        has_zvknh: true,
        has_zvkg: true,
        has_zbb: true,
        has_zbkb: true,
        has_v: true,
        vlen_bits: 128
    )

fn aes_only_caps() -> Rv64Caps:
    Rv64Caps(
        has_zvkned: true,
        has_zvknh: false,
        has_zvkg: false,
        has_zbb: false,
        has_zbkb: false,
        has_v: true,
        vlen_bits: 128
    )

fn scalar_zbb_caps() -> Rv64Caps:
    Rv64Caps(
        has_zvkned: false,
        has_zvknh: false,
        has_zvkg: false,
        has_zbb: true,
        has_zbkb: false,
        has_v: false,
        vlen_bits: 128
    )

fn scalar_zbkb_only_caps() -> Rv64Caps:
    Rv64Caps(
        has_zvkned: false,
        has_zvknh: false,
        has_zvkg: false,
        has_zbb: false,
        has_zbkb: true,
        has_v: false,
        vlen_bits: 128
    )

fn scalar_full_bitmanip_caps() -> Rv64Caps:
    Rv64Caps(
        has_zvkned: false,
        has_zvknh: false,
        has_zvkg: false,
        has_zbb: true,
        has_zbkb: true,
        has_v: false,
        vlen_bits: 128
    )

fn bare_caps() -> Rv64Caps:
    Rv64Caps(
        has_zvkned: false,
        has_zvknh: false,
        has_zvkg: false,
        has_zbb: false,
        has_zbkb: false,
        has_v: false,
        vlen_bits: 128
    )

describe "intrinsic_lowering_riscv — name to TargetIdiom":
    it "crypto_aes_round maps to AesEnc":
        # @req: REQ-UNIT-COMPILER-001
        step("Verify: crypto_aes_round maps to AesEnc")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var result = intrinsic_to_target_idiom_riscv("crypto_aes_round")
        match result:
            case Some(idiom):
                expect(idiom).to_equal(TargetIdiom.AesEnc)
            case _:
                expect(0).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "crypto_aes_round_last maps to AesEncLast":
        # @req: REQ-UNIT-COMPILER-002
        step("Verify: crypto_aes_round_last maps to AesEncLast")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var result = intrinsic_to_target_idiom_riscv("crypto_aes_round_last")
        match result:
            case Some(idiom):
                expect(idiom).to_equal(TargetIdiom.AesEncLast)
            case _:
                expect(0).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "crypto_aes_inv_round maps to AesDec":
        # @req: REQ-UNIT-COMPILER-003
        step("Verify: crypto_aes_inv_round maps to AesDec")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var result = intrinsic_to_target_idiom_riscv("crypto_aes_inv_round")
        match result:
            case Some(idiom):
                expect(idiom).to_equal(TargetIdiom.AesDec)
            case _:
                expect(0).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "crypto_aes_inv_round_last maps to AesDecLast":
        # @req: REQ-UNIT-COMPILER-004
        step("Verify: crypto_aes_inv_round_last maps to AesDecLast")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var result = intrinsic_to_target_idiom_riscv("crypto_aes_inv_round_last")
