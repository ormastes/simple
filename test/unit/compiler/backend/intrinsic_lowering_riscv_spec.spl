        var r = lower_cipher_intrinsic_riscv("clmul_lo", args, aes_only_caps())
        expect(r.lowered).to_equal(false)
        expect(r.reason).to_equal("no-cap")

    it "clmul_hi with bare caps → no-cap":
        # @req: REQ-UNIT-COMPILER-028
        step("Verify: clmul_hi with bare caps → no-cap")
        # @capture: assertion outcomes retained in the spec Results output as evidence
