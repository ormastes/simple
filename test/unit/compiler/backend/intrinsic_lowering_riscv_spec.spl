describe "intrinsic_lowering_riscv — matrix scaffolding":
    it "matrix_dot is recognised and returns unimplemented on capable caps":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: matrix_dot is recognised and returns unimplemented on capable caps")
        var args: [i64] = [1, 2, 3]
        var r = lower_cipher_intrinsic_riscv("matrix_dot", args, full_caps())
        expect(r.lowered).to_equal(false)
        expect(r.reason).to_equal("unimplemented")
