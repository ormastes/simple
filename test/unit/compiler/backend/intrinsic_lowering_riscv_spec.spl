        expect(r.reason).to_equal("no-cap")

    it "bit_popcount with zbkb-only caps → no-cap":
        # @req: REQ-UNIT-COMPILER-029
        step("Verify: bit_popcount with zbkb-only caps → no-cap")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var r = lower_cipher_intrinsic_riscv("bit_popcount", [1, 2], scalar_zbkb_only_caps())
        expect(r.lowered).to_equal(false)
        expect(r.reason).to_equal("no-cap")

    it "bit_bitreverse with zbb-only caps → no-cap":
        # @req: REQ-UNIT-COMPILER-030
        step("Verify: bit_bitreverse with zbb-only caps → no-cap")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var r = lower_cipher_intrinsic_riscv("bit_bitreverse", [1, 2], scalar_zbb_caps())
        expect(r.lowered).to_equal(false)
        expect(r.reason).to_equal("no-cap")

describe "intrinsic_lowering_riscv — unknown intrinsic":
    it "unknown name returns reason=unknown":
        # @req: REQ-UNIT-COMPILER-031
        step("Verify: unknown name returns reason=unknown")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var args: [i64] = [1, 2]
        var r = lower_cipher_intrinsic_riscv("crypto_does_not_exist", args, full_caps())
        expect(r.lowered).to_equal(false)
        expect(r.reason).to_equal("unknown")

    it "empty name returns reason=unknown":
        # @req: REQ-UNIT-COMPILER-032
        step("Verify: empty name returns reason=unknown")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var args: [i64] = []
        var r = lower_cipher_intrinsic_riscv("", args, full_caps())
        expect(r.lowered).to_equal(false)
        expect(r.reason).to_equal("unknown")

