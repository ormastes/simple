        expect(r.reason).to_equal("no-cap")

    it "clmul_hi with bare caps → no-cap":
        # @req: REQ-COMPILER-BACKEND-001
        step("Verify: clmul_hi with bare caps → no-cap")
        var args: [i64] = [1, 2]
        var r = lower_cipher_intrinsic_riscv("clmul_hi", args, bare_caps())
