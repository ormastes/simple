            case Some(idiom):
                expect(idiom).to_equal(TargetIdiom.AesDecLast)
            case _:
                expect(0).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "crypto_sha256_rnds2 maps to Sha256Rounds2":
        # @req: REQ-UNIT-COMPILER-005
        step("Verify: crypto_sha256_rnds2 maps to Sha256Rounds2")
        # @capture: assertion outcomes retained in the spec Results output as evidence
