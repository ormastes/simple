            case _:
                expect(0).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "clmul_hi maps to ClmulHi":
        # @req: REQ-UNIT-COMPILER-007
        step("Verify: clmul_hi maps to ClmulHi")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var result = intrinsic_to_target_idiom_riscv("clmul_hi")
        match result:
            case Some(idiom):
                expect(idiom).to_equal(TargetIdiom.ClmulHi)
            case _:
                expect(0).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "bit_popcount maps to Popcount":
        # @req: REQ-UNIT-COMPILER-008
        step("Verify: bit_popcount maps to Popcount")
        # @capture: assertion outcomes retained in the spec Results output as evidence
