    it "unknown name returns nil":
        # @req: REQ-UNIT-COMPILER-010
        step("Verify: unknown name returns nil")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var result = intrinsic_to_target_idiom_riscv("not_a_real_intrinsic")
        match result:
            case Some(_):
                expect(0).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
