                expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

describe "intrinsic_lowering_riscv — full caps byte results":
    it "crypto_aes_round lowered with 2 args":
        # @req: REQ-UNIT-COMPILER-011
        step("Verify: crypto_aes_round lowered with 2 args")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # vaesem.vv v1,v2 → [0xD7,0x20,0x20,0xA6]
        var args: [i64] = [1, 2]
        var r = lower_cipher_intrinsic_riscv("crypto_aes_round", args, full_caps())
        expect(r.lowered).to_equal(true)
        expect(r.bytes.length).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
        expect(r.bytes[0]).to_equal(0xD7)
        expect(r.bytes[3]).to_equal(0xA6)

    it "crypto_aes_round_last → vaesef.vv bytes":
        # @req: REQ-UNIT-COMPILER-012
        step("Verify: crypto_aes_round_last → vaesef.vv bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # vaesef.vv v1,v2 → [0xD7,0x20,0x20,0xA2]
        var args: [i64] = [1, 2]
        var r = lower_cipher_intrinsic_riscv("crypto_aes_round_last", args, full_caps())
        expect(r.lowered).to_equal(true)
        expect(r.bytes.length).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
        expect(r.bytes[3]).to_equal(0xA2)

    it "crypto_aes_inv_round → vaesdm.vv bytes":
        # @req: REQ-UNIT-COMPILER-013
        step("Verify: crypto_aes_inv_round → vaesdm.vv bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # vaesdm.vv v1,v2 → [0xD7,0x20,0x20,0xAE]
        var args: [i64] = [1, 2]
        var r = lower_cipher_intrinsic_riscv("crypto_aes_inv_round", args, full_caps())
        expect(r.lowered).to_equal(true)
        expect(r.bytes.length).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
        expect(r.bytes[3]).to_equal(0xAE)

    it "crypto_aes_inv_round_last → vaesdf.vv bytes":
        # @req: REQ-UNIT-COMPILER-014
        step("Verify: crypto_aes_inv_round_last → vaesdf.vv bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # vaesdf.vv v1,v2 → [0xD7,0x20,0x20,0xAA]
        var args: [i64] = [1, 2]
        var r = lower_cipher_intrinsic_riscv("crypto_aes_inv_round_last", args, full_caps())
        expect(r.lowered).to_equal(true)
        expect(r.bytes.length).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
        expect(r.bytes[3]).to_equal(0xAA)

    it "crypto_sha256_rnds2 → vsha2cl.vv + vsha2ch.vv (8 bytes)":
        # @req: REQ-UNIT-COMPILER-015
        step("Verify: crypto_sha256_rnds2 → vsha2cl.vv + vsha2ch.vv (8 bytes)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # vsha2cl.vv v1,v2,v3 + vsha2ch.vv v1,v2,v3
        var args: [i64] = [1, 2, 3]
        var r = lower_cipher_intrinsic_riscv("crypto_sha256_rnds2", args, full_caps())
        expect(r.lowered).to_equal(true)
        expect(r.bytes.length).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec
        # First 4 bytes: vsha2cl.vv → byte[3]=0xBE
        expect(r.bytes[0]).to_equal(0xD7)
        expect(r.bytes[3]).to_equal(0xBE)
        # Next 4 bytes: vsha2ch.vv → byte[3]=0xBA
        expect(r.bytes[4]).to_equal(0xD7)
        expect(r.bytes[7]).to_equal(0xBA)

    it "clmul_lo → vghsh.vv bytes":
        # @req: REQ-UNIT-COMPILER-016
        step("Verify: clmul_lo → vghsh.vv bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # vghsh.vv v1,v2,v3 → [0xD7,0xA0,0x21,0xB2]
        var args: [i64] = [1, 2, 3]
        var r = lower_cipher_intrinsic_riscv("clmul_lo", args, full_caps())
        expect(r.lowered).to_equal(true)
        expect(r.bytes.length).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
        expect(r.bytes[3]).to_equal(0xB2)

    it "clmul_hi → vgmul.vv bytes":
        # @req: REQ-UNIT-COMPILER-017
        step("Verify: clmul_hi → vgmul.vv bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # vgmul.vv v1,v2 → [0xD7,0x20,0x20,0xA6]
        var args: [i64] = [1, 2]
        var r = lower_cipher_intrinsic_riscv("clmul_hi", args, full_caps())
        expect(r.lowered).to_equal(true)
        expect(r.bytes.length).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
        expect(r.bytes[3]).to_equal(0xA6)

    it "bit_rotate_left lowers to rol bytes":
        # @req: REQ-UNIT-COMPILER-018
        step("Verify: bit_rotate_left lowers to rol bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # rol rd=1, rs1=2, rs2=3 — Zbb: funct7=0x30, funct3=0x1
        var r = lower_cipher_intrinsic_riscv("bit_rotate_left", [1, 2, 3], scalar_zbb_caps())
        expect(r.lowered).to_equal(true)
        expect(r.reason).to_equal("")
        expect(r.bytes).to_equal([179, 16, 49, 96])

    it "bit_rotate_right lowers to ror bytes via zbkb":
        # @req: REQ-UNIT-COMPILER-019
        step("Verify: bit_rotate_right lowers to ror bytes via zbkb")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # ror rd=1, rs1=2, rs2=3 — Zbkb: funct7=0x30, funct3=0x5
        var r = lower_cipher_intrinsic_riscv("bit_rotate_right", [1, 2, 3], scalar_zbkb_only_caps())
        expect(r.lowered).to_equal(true)
        expect(r.reason).to_equal("")
        expect(r.bytes).to_equal([179, 80, 49, 96])

    it "bit_clz lowers to clz bytes":
        # @req: REQ-UNIT-COMPILER-020
        step("Verify: bit_clz lowers to clz bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var r = lower_cipher_intrinsic_riscv("bit_clz", [1, 2], scalar_zbb_caps())
        expect(r.lowered).to_equal(true)
        expect(r.reason).to_equal("")
        expect(r.bytes).to_equal([147, 16, 1, 96])

    it "bit_ctz lowers to ctz bytes":
        # @req: REQ-UNIT-COMPILER-021
        step("Verify: bit_ctz lowers to ctz bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var r = lower_cipher_intrinsic_riscv("bit_ctz", [1, 2], scalar_zbb_caps())
        expect(r.lowered).to_equal(true)
        expect(r.reason).to_equal("")
        expect(r.bytes).to_equal([147, 16, 17, 96])

    it "bit_popcount lowers to cpop bytes":
        # @req: REQ-UNIT-COMPILER-022
        step("Verify: bit_popcount lowers to cpop bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var r = lower_cipher_intrinsic_riscv("bit_popcount", [1, 2], scalar_zbb_caps())
        expect(r.lowered).to_equal(true)
        expect(r.reason).to_equal("")
        expect(r.bytes).to_equal([147, 16, 33, 96])

    it "bit_bswap lowers to rev8 bytes":
        # @req: REQ-UNIT-COMPILER-023
        step("Verify: bit_bswap lowers to rev8 bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var r = lower_cipher_intrinsic_riscv("bit_bswap", [1, 2], scalar_zbb_caps())
        expect(r.lowered).to_equal(true)
        expect(r.reason).to_equal("")
        expect(r.bytes).to_equal([147, 80, 129, 107])

    it "bit_bitreverse lowers to brev8 + rev8 bytes":
        # @req: REQ-UNIT-COMPILER-024
        step("Verify: bit_bitreverse lowers to brev8 + rev8 bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var r = lower_cipher_intrinsic_riscv("bit_bitreverse", [15, 16], scalar_full_bitmanip_caps())
        expect(r.lowered).to_equal(true)
        expect(r.reason).to_equal("")
        expect(r.bytes).to_equal([147, 87, 120, 104, 147, 87, 136, 107])

describe "intrinsic_lowering_riscv — no-cap cases":
    it "crypto_aes_round with bare caps → no-cap":
        # @req: REQ-UNIT-COMPILER-025
        step("Verify: crypto_aes_round with bare caps → no-cap")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var args: [i64] = [1, 2]
        var r = lower_cipher_intrinsic_riscv("crypto_aes_round", args, bare_caps())
        expect(r.lowered).to_equal(false)
        expect(r.reason).to_equal("no-cap")

    it "crypto_sha256_rnds2 with aes_only caps → no-cap":
        # @req: REQ-UNIT-COMPILER-026
        step("Verify: crypto_sha256_rnds2 with aes_only caps → no-cap")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var args: [i64] = [1, 2, 3]
        var r = lower_cipher_intrinsic_riscv("crypto_sha256_rnds2", args, aes_only_caps())
        expect(r.lowered).to_equal(false)
        expect(r.reason).to_equal("no-cap")

    it "clmul_lo with aes_only caps → no-cap":
        # @req: REQ-UNIT-COMPILER-027
        step("Verify: clmul_lo with aes_only caps → no-cap")
