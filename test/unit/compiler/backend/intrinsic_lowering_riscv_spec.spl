        match result:
            case Some(idiom):
                expect(idiom).to_equal(TargetIdiom.Sha256Rounds2)
            case _:
                expect(0).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "clmul_lo maps to ClmulLo":
        # @req: REQ-UNIT-COMPILER-006
        step("Verify: clmul_lo maps to ClmulLo")
