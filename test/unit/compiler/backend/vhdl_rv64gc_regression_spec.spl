"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/backend/vhdl_rv64gc_regression_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/compiler/70.backend/backend/vhdl_backend.spl 0%
# @cover src/compiler/70.backend/backend/vhdl_type_mapper.spl 0%
# @cover src/compiler/70.backend/backend/vhdl_expr.spl 0%
# @cover src/compiler/70.backend/backend/vhdl_process.spl 0%
"""
# VHDL Backend RV64GC RTL Regression Specification

**Feature IDs:** rv64-fpga-linux-boot
**Category:** Tooling
**Difficulty:** 5/5
**Status:** Draft
**Requirements:** REQ-7, REQ-16, REQ-17
**Research:** doc/04_architecture/vhdl_support_matrix.md
**Artifacts:** N/A

## Overview

Regression tests for the VHDL backend covering constructs used by
rv64gc_rtl modules: 64-bit arithmetic, struct records, payloadless
enums, CSR field widths, match lowering for opcode decode, and
64-bit shift patterns.

Covers:
- AC-8 (VHDL backend bugs identified and fixed)
- AC-9 (VHDL backend regression tests pass after fixes)

## Compiled-Mode Notes

These tests verify VHDL backend output patterns (text assertions on
generated VHDL). Interpreter-safe for text pattern checks. Actual
GHDL analysis requires compiled mode.

## Known Unsupported Constructs (Baseline)

Per the VHDL backend completion report:
- Payload enums (tagged-record lowering) — NOT supported
- Indirect calls — NOT supported
- Recursion — NOT supported
- Dynamic allocation — NOT supported
- Nested array memories — NOT supported
- Float types — NOT supported

These constraints are tested as negative assertions (confirm the
backend rejects or documents unsupported patterns).
"""

use std.spipe.*
use compiler.backend.backend.vhdl_type_mapper.{vhdl_type_map_u64, vhdl_type_map_i64, vhdl_type_map_u32, vhdl_type_map_bool}
use compiler.backend.backend.vhdl_backend.{vhdl_compile_struct_record_u64, vhdl_compile_csr_file64_struct, vhdl_compile_payloadless_enum, vhdl_supports_payload_enums}
use compiler.backend.backend.vhdl_expr.{vhdl_compile_u64_add, vhdl_compile_u64_shl, vhdl_compile_u64_shr, vhdl_compile_u64_and, vhdl_compile_u64_or, vhdl_compile_u64_compare}
use compiler.backend.backend.vhdl_process.{vhdl_compile_match_u8, vhdl_compile_match_multi_arm, vhdl_compile_match_default, vhdl_compile_combinational_process, vhdl_compile_clocked_process, vhdl_compile_fixed_u64_array, vhdl_compile_array_index}


# ============================================================================
# AC-8: 64-bit Type Mapping
# ============================================================================

describe "VHDL Backend 64-bit Type Mapping":
    it "AC-8: u64 maps to unsigned(63 downto 0)":
        # @req: REQ-UNIT-COMPILER-001
            # @req: REQ-17
            # @req: REQ-16
            # @req: REQ-7
        step("Verify: AC-8: u64 maps to unsigned(63 downto 0)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_type_map_u64()
        expect(vhdl).to_contain("unsigned")
        expect(vhdl).to_contain("63 downto 0")

    it "AC-8: i64 maps to signed(63 downto 0)":
        # @req: REQ-UNIT-COMPILER-002
        step("Verify: AC-8: i64 maps to signed(63 downto 0)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_type_map_i64()
        expect(vhdl).to_contain("signed")
        expect(vhdl).to_contain("63 downto 0")

    it "AC-8: u32 maps to unsigned(31 downto 0)":
        # @req: REQ-UNIT-COMPILER-003
        step("Verify: AC-8: u32 maps to unsigned(31 downto 0)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_type_map_u32()
        expect(vhdl).to_contain("unsigned")
        expect(vhdl).to_contain("31 downto 0")

    it "AC-8: bool maps to std_logic or boolean":
        # @req: REQ-UNIT-COMPILER-004
        step("Verify: AC-8: bool maps to std_logic or boolean")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_type_map_bool()
        val has_logic = vhdl.contains("std_logic")
        val has_bool = vhdl.contains("boolean")
        val either = has_logic or has_bool
        expect(either).to_equal(true)


# ============================================================================
# AC-8: Struct Record Lowering
# ============================================================================

describe "VHDL Backend Struct Record Lowering":
    it "AC-8: struct with u64 fields produces record type":
        # @req: REQ-UNIT-COMPILER-005
        step("Verify: AC-8: struct with u64 fields produces record type")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_compile_struct_record_u64()
        expect(vhdl).to_contain("record")

    it "AC-8: struct fields preserve names in VHDL record":
        # @req: REQ-UNIT-COMPILER-006
        step("Verify: AC-8: struct fields preserve names in VHDL record")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_compile_struct_record_u64()
        expect(vhdl).to_contain("end record")

    it "AC-9: CsrFile64-shaped struct compiles to valid record":
        # @req: REQ-UNIT-COMPILER-007
        step("Verify: AC-9: CsrFile64-shaped struct compiles to valid record")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # CsrFile64 has multiple u64 fields (mstatus, mie, mip, etc.)
        val vhdl = vhdl_compile_csr_file64_struct()
        expect(vhdl).to_contain("record")
        expect(vhdl).to_contain("mstatus")


# ============================================================================
# AC-8: Payloadless Enum Lowering
# ============================================================================

describe "VHDL Backend Enum Lowering":
    it "AC-8: payloadless enum compiles to VHDL enumeration type":
        # @req: REQ-UNIT-COMPILER-008
        step("Verify: AC-8: payloadless enum compiles to VHDL enumeration type")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_compile_payloadless_enum()
        expect(vhdl).to_contain("type")

    it "AC-8: payload enum is documented as unsupported (REQ-7)":
        # @req: REQ-UNIT-COMPILER-009
        step("Verify: AC-8: payload enum is documented as unsupported (REQ-7)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Backend should reject or document payload enums
        val supported = vhdl_supports_payload_enums()
        expect(supported).to_equal(false)


# ============================================================================
# AC-8: 64-bit Expression Codegen
# ============================================================================

describe "VHDL Backend 64-bit Expressions":
    it "AC-8: 64-bit addition generates correct VHDL operator":
        # @req: REQ-UNIT-COMPILER-010
        step("Verify: AC-8: 64-bit addition generates correct VHDL operator")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_compile_u64_add()
        val has_plus = vhdl.contains("+")
        expect(has_plus).to_equal(true)

    it "AC-8: 64-bit shift-left generates sll or shift_left":
        # @req: REQ-UNIT-COMPILER-011
        step("Verify: AC-8: 64-bit shift-left generates sll or shift_left")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_compile_u64_shl()
        val has_sll = vhdl.contains("shift_left")
        val has_sll2 = vhdl.contains("sll")
        val either = has_sll or has_sll2
        expect(either).to_equal(true)

    it "AC-8: 64-bit shift-right generates srl or shift_right":
        # @req: REQ-UNIT-COMPILER-012
        step("Verify: AC-8: 64-bit shift-right generates srl or shift_right")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_compile_u64_shr()
        val has_srl = vhdl.contains("shift_right")
        val has_srl2 = vhdl.contains("srl")
        val either = has_srl or has_srl2
        expect(either).to_equal(true)

    it "AC-8: 64-bit bitwise AND generates correct operator":
        # @req: REQ-UNIT-COMPILER-013
        step("Verify: AC-8: 64-bit bitwise AND generates correct operator")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_compile_u64_and()
        expect(vhdl).to_contain("and")

    it "AC-8: 64-bit bitwise OR generates correct operator":
        # @req: REQ-UNIT-COMPILER-014
        step("Verify: AC-8: 64-bit bitwise OR generates correct operator")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_compile_u64_or()
        expect(vhdl).to_contain("or")

    it "AC-8: 64-bit comparison generates correct VHDL":
        # @req: REQ-UNIT-COMPILER-015
        step("Verify: AC-8: 64-bit comparison generates correct VHDL")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_compile_u64_compare()
        val has_eq = vhdl.contains("=")
        expect(has_eq).to_equal(true)


