# ============================================================================
# AC-9: Process Lowering for RTL Modules
# ============================================================================

describe "VHDL Backend Process Lowering":
    it "AC-9: combinational logic generates process with sensitivity list":
        # @req: REQ-UNIT-COMPILER-019
        step("Verify: AC-9: combinational logic generates process with sensitivity list")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_compile_combinational_process()
        expect(vhdl).to_contain("process")

    it "AC-9: sequential logic generates clocked process":
        # @req: REQ-UNIT-COMPILER-020
        step("Verify: AC-9: sequential logic generates clocked process")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_compile_clocked_process()
        expect(vhdl).to_contain("rising_edge")

    it "AC-9: process contains signal assignments":
        # @req: REQ-UNIT-COMPILER-021
        step("Verify: AC-9: process contains signal assignments")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_compile_combinational_process()
        expect(vhdl).to_contain("<=")


# ============================================================================
# AC-9: Fixed-Size Array Lowering
# ============================================================================

describe "VHDL Backend Array Lowering":
    it "AC-9: fixed-size u64 array compiles to VHDL array type":
        # @req: REQ-UNIT-COMPILER-022
        step("Verify: AC-9: fixed-size u64 array compiles to VHDL array type")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_compile_fixed_u64_array()
        expect(vhdl).to_contain("array")

    it "AC-9: array indexed access compiles to VHDL index":
        # @req: REQ-UNIT-COMPILER-023
        step("Verify: AC-9: array indexed access compiles to VHDL index")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = vhdl_compile_array_index()
        val has_paren = vhdl.contains("(")
        expect(has_paren).to_equal(true)
