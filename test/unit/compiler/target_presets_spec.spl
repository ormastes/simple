"""
## Purpose and audience
Executable structure contract for the cross-compilation target presets, for
the engineers who own `src/compiler/80.driver/build/baremetal.spl` (TargetPreset
struct, cortex-m4/m0/riscv32/wasm32/linux/macos presets, allowed_families) and
`src/compiler/00.common/driver_core_types.spl` (is_family_allowed /
check_family_allowed). The module-level helpers replicate the preset fields
without imports so the contract asserts without linking the driver; if the
real implementation changes, these helpers must be updated to match.
## Operator workflow
Run: ./src/compiler_rust/target/bootstrap/simple run test/unit/compiler/target_presets_spec.spl
Each scenario builds a preset through the local helper and pins one field or
one family-mapping rule.
## Compatibility and limitations
The presets are replicated, not imported, so this spec can drift from the
driver — it is a structure contract, not a link check. Interpreter mode
executes the bodies; native lowering of the driver itself is out of scope.
## Verification guidance and troubleshooting
A failure names the preset field or family rule that drifted from the
helper's pinned value. Diff the helper against baremetal.spl /
driver_core_types.spl before editing any assertion here.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: target-preset-contracts

# Tests for cross-compilation target presets.
# No imports - all logic is replicated at module level.

# ============================================================================
# Module-level preset helpers (replicate logic without imports)
# ============================================================================

struct TargetPresetSpec:
    name: text
    arch: text
    os: text
    abi: text
    no_std: bool
    no_gc: bool
    stack_size: i64
    heap_size: i64
    pointer_width: i64
    float_support: bool
    allowed_families: [text]
    description: text

fn make_cortex_m4() -> TargetPresetSpec:
    TargetPresetSpec(
        name: "cortex-m4",
        arch: "thumbv7em",
        os: "none",
        abi: "eabihf",
        no_std: true,
        no_gc: true,
        stack_size: 8192,
        heap_size: 0,
        pointer_width: 32,
        float_support: true,
        allowed_families: ["nogc_async_mut_noalloc", "common"],
        description: "ARM Cortex-M4 bare-metal (FPU, 32-bit, no OS)"
    )

fn make_cortex_m0() -> TargetPresetSpec:
    TargetPresetSpec(
        name: "cortex-m0",
        arch: "thumbv6m",
        os: "none",
        abi: "eabi",
        no_std: true,
        no_gc: true,
        stack_size: 2048,
        heap_size: 0,
        pointer_width: 32,
        float_support: false,
        allowed_families: ["nogc_async_mut_noalloc", "common"],
        description: "ARM Cortex-M0/M0+ bare-metal (no FPU, 32-bit, no OS)"
    )

fn make_riscv32_baremetal() -> TargetPresetSpec:
    TargetPresetSpec(
        name: "riscv32-baremetal",
        arch: "riscv32imac",
        os: "none",
        abi: "ilp32",
        no_std: true,
        no_gc: true,
        stack_size: 16384,
        heap_size: 0,
        pointer_width: 32,
        float_support: false,
        allowed_families: ["nogc_async_mut_noalloc", "common"],
        description: "RISC-V 32-bit bare-metal (integer only, no OS)"
    )

fn make_wasm32() -> TargetPresetSpec:
    TargetPresetSpec(
        name: "wasm32",
        arch: "wasm32",
        os: "wasi",
        abi: "wasm",
        no_std: false,
        no_gc: true,
        stack_size: 65536,
        heap_size: 65536,
        pointer_width: 32,
        float_support: true,
        allowed_families: ["nogc_async_mut_noalloc", "nogc_sync_mut", "nogc_async_mut", "common"],
        description: "WebAssembly 32-bit (WASI, browser-compatible)"
    )

fn make_linux_x86_64() -> TargetPresetSpec:
    TargetPresetSpec(
        name: "linux-x86_64",
        arch: "x86_64",
        os: "linux",
        abi: "gnu",
        no_std: false,
        no_gc: false,
        stack_size: 0,
        heap_size: 0,
        pointer_width: 64,
        float_support: true,
        allowed_families: [],
        description: "Linux x86-64 (native, full stdlib)"
    )

fn make_macos_arm64() -> TargetPresetSpec:
    TargetPresetSpec(
        name: "macos-arm64",
        arch: "aarch64",
        os: "macos",
        abi: "macho",
        no_std: false,
        no_gc: false,
        stack_size: 0,
        heap_size: 0,
        pointer_width: 64,
        float_support: true,
        allowed_families: [],
        description: "macOS ARM64 (Apple Silicon, full stdlib)"
    )

fn make_by_name(name: text) -> TargetPresetSpec:
    if name == "cortex-m4":
        return make_cortex_m4()
    elif name == "wasm32":
        return make_wasm32()
    else:
        TargetPresetSpec(
            name: name,
            arch: "unknown",
            os: "none",
            abi: "none",
            no_std: true,
            no_gc: true,
            stack_size: 4096,
            heap_size: 0,
            pointer_width: 32,
            float_support: false,
            allowed_families: ["nogc_async_mut_noalloc", "common"],
            description: "Unknown preset (defaults to bare-metal)"
        )

fn spec_is_baremetal(p: TargetPresetSpec) -> bool:
    p.no_std and p.no_gc

fn spec_triple(p: TargetPresetSpec) -> text:
    p.arch + "-" + p.os + "-" + p.abi

fn spec_all_names() -> [text]:
    ["cortex-m4", "cortex-m0", "riscv32-baremetal", "riscv64-linux",
     "wasm32", "linux-x86_64", "macos-arm64", "windows-x86_64",
     "avr-atmega328", "i8086-dos", "i8086-baremetal"]

# ============================================================================
# Tests
# ============================================================================

describe "TargetPreset":
    context "cortex-m4 preset":
        it "has the correct name":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): cortex-m4 preset name field
            step("Build the cortex-m4 preset and read its name field")
            val p = make_cortex_m4()
            expect(p.name).to_equal("cortex-m4")

        it "has the correct arch":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): cortex-m4 preset arch field
            step("Build the cortex-m4 preset and read its arch field")
            val p = make_cortex_m4()
            expect(p.arch).to_equal("thumbv7em")

        it "is bare-metal (no_std and no_gc)":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): cortex-m4 bare-metal verdict
            step("Build the cortex-m4 preset and evaluate its bare-metal verdict")
            val p = make_cortex_m4()
            expect(spec_is_baremetal(p)).to_equal(true)

        it "has pointer_width of 32":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): cortex-m4 pointer width
            step("Build the cortex-m4 preset and read its pointer width")
            val p = make_cortex_m4()
            expect(p.pointer_width).to_equal(32)  # oracle: ARM Cortex-M4 is a 32-bit target, pinned by the preset contract

        it "has float_support enabled":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): cortex-m4 float support
            step("Build the cortex-m4 preset and read its float support flag")
            val p = make_cortex_m4()
            expect(p.float_support).to_equal(true)

    context "riscv32-baremetal preset":
        it "has os set to none":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): riscv32-baremetal os field
            step("Build the riscv32-baremetal preset and read its os field")
            val p = make_riscv32_baremetal()
            expect(p.os).to_equal("none")

    context "wasm32 preset":
        it "has arch set to wasm32":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): wasm32 preset arch field
            step("Build the wasm32 preset and read its arch field")
            val p = make_wasm32()
            expect(p.arch).to_equal("wasm32")

    context "linux-x86_64 preset":
        it "is not bare-metal":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): hosted linux-x86_64 bare-metal verdict
            step("Build the linux-x86_64 preset and evaluate its bare-metal verdict")
            val p = make_linux_x86_64()
            expect(spec_is_baremetal(p)).to_equal(false)

    context "preset_by_name lookup":
        it "returns cortex-m4 when asked by name":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): by-name lookup hit for cortex-m4
            step("Look up the cortex-m4 preset by name")
            val p = make_by_name("cortex-m4")
            expect(p.name).to_equal("cortex-m4")

        it "returns wasm32 when asked by name":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): by-name lookup arch for wasm32
            step("Look up the wasm32 preset by name and read its arch")
            val p = make_by_name("wasm32")
            expect(p.arch).to_equal("wasm32")

        it "returns unknown-default preset for unknown name":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): by-name lookup miss falls back to unknown
            step("Look up a preset name that no preset defines")
            val p = make_by_name("nonexistent-target")
            expect(p.arch).to_equal("unknown")

    context "preset_triple":
        it "formats triple as arch-os-abi":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): cortex-m4 target triple formatting
            step("Format the cortex-m4 preset into its target triple")
            val p = make_cortex_m4()
            val triple = spec_triple(p)
            expect(triple).to_equal("thumbv7em-none-eabihf")

    context "preset_all_names":
        it "returns a list of 11 preset names":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): full preset name roster size
            step("Enumerate every preset name the roster defines")
            val names = spec_all_names()
            expect(names.len()).to_equal(11)  # oracle: the roster pins eleven targets, cortex-m4 through i8086-baremetal

    context "cortex-m0 preset":
        it "has no float_support":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): cortex-m0 float support absence
            step("Build the cortex-m0 preset and read its float support flag")
            val p = make_cortex_m0()
            expect(p.float_support).to_equal(false)

    context "macos-arm64 preset":
        it "has pointer_width of 64":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): macos-arm64 pointer width
            step("Build the macos-arm64 preset and read its pointer width")
            val p = make_macos_arm64()
            expect(p.pointer_width).to_equal(64)  # oracle: Apple Silicon is a 64-bit target, pinned by the preset contract

    # ================================================================
    # Target preset → runtime family mapping tests
    # ================================================================

    context "baremetal preset family mapping":
        it "restricts to nogc_async_mut_noalloc and common":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): baremetal allowed-family restriction
            step("Build the cortex-m4 preset and read its allowed families")
            val p = make_cortex_m4()
            # Baremetal presets (no_std + no_gc) should only allow these two families
            val families = p.allowed_families
            expect(families.len()).to_equal(2)  # oracle: baremetal allows exactly nogc_async_mut_noalloc and common
            expect(families[0]).to_equal("nogc_async_mut_noalloc")
            expect(families[1]).to_equal("common")

        it "sets gc_off to true for baremetal":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): baremetal gc-off flag
            step("Build the cortex-m4 preset and read its gc-off flag")
            val p = make_cortex_m4()
            expect(p.no_gc).to_equal(true)

        it "disallows allocation for baremetal":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): baremetal heap size zero
            step("Build the cortex-m4 preset and read its heap size")
            val p = make_cortex_m4()
            expect(p.heap_size).to_equal(0)  # oracle: a no_gc baremetal target must declare no heap

    context "hosted preset family mapping":
        it "allows all families (empty restriction)":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): hosted empty family restriction
            step("Build the linux-x86_64 preset and read its family restriction")
            val p = make_linux_x86_64()
            val families = p.allowed_families
            expect(families.len()).to_equal(0)  # oracle: an empty restriction list means every family is allowed on hosted targets

        it "does not set gc_off for hosted":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): hosted gc flag stays off
            step("Build the linux-x86_64 preset and read its gc flag")
            val p = make_linux_x86_64()
            expect(p.no_gc).to_equal(false)

    context "embedded_with_heap preset family mapping":
        it "allows nogc families plus common but not gc":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): embedded-with-heap family ordering
            step("Build the wasm32 preset and read its allowed families in order")
            val p = make_wasm32()
            val families = p.allowed_families
            expect(families.len()).to_equal(4)  # oracle: wasm32 allows the three nogc lanes plus common, exactly four
            expect(families[0]).to_equal("nogc_async_mut_noalloc")
            expect(families[1]).to_equal("nogc_sync_mut")
            expect(families[2]).to_equal("nogc_async_mut")
            expect(families[3]).to_equal("common")

    context "is_family_allowed helper":
        it "allows any family when restriction is empty":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): empty-restriction allow verdicts
            step("Check two families against an empty restriction list")
            val families: [text] = []
            expect(check_family_allowed(families, "gc_async_mut")).to_equal(true)
            expect(check_family_allowed(families, "nogc_sync_mut")).to_equal(true)

        it "blocks non-listed families when restriction is active":
            # @req REQ-SSPEC-UNIT
            # @capture(statistics): active-restriction allow and block verdicts
            step("Check listed and unlisted families against an active restriction")
            val families = ["nogc_async_mut_noalloc", "common"]
            expect(check_family_allowed(families, "nogc_async_mut_noalloc")).to_equal(true)
            expect(check_family_allowed(families, "common")).to_equal(true)
            expect(check_family_allowed(families, "nogc_sync_mut")).to_equal(false)
            expect(check_family_allowed(families, "gc_async_mut")).to_equal(false)

# ============================================================================
# Family mapping helpers (replicate TargetPreset.allowed_families logic)
# ============================================================================

fn baremetal_allowed_families() -> [text]:
    ["nogc_async_mut_noalloc", "common"]

fn hosted_allowed_families() -> [text]:
    []

fn embedded_with_heap_allowed_families() -> [text]:
    ["nogc_async_mut_noalloc", "nogc_sync_mut", "nogc_async_mut", "common"]

fn check_family_allowed(allowed: [text], family: text) -> bool:
    if allowed.len() == 0:
        return true
    for af in allowed:
        if af == family:
            return true
    false
