"""
## Purpose and audience
Purpose: Prove that Type inference correctness.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-TYPE-INFER-001 — stable requirement identity for this spec.

# Type Inference Correctness — real Hindley-Milner engine
#
# Exercises the REAL HmInferContext from src/compiler/30.types/type_infer_types.spl
# and its Algorithm-W implementation (type_infer/core.spl, generalization.spl,
# context.spl) plus the real DimSolver.
#
# History: this spec used to declare a local `HmInferContext` with a single
# `next_id` counter, a local text-keyed `HirType` class, and an `infer_type()`
# that was a chain of `source.contains("...")` substring matches returning canned
# results. Nothing in the product was executed. See
# doc/08_tracking/bug/type_infer_correctness_spec_shadows_hminfercontext_2026-08-10.md

use compiler.types.type_infer_types.*
use compiler.types.type_infer.context.*
use compiler.types.type_infer.core.*
use compiler.types.type_infer.generalization.*
use compiler.types.dim_constraints.*
use compiler.hir.hir.*
use compiler.frontend.core.lexer.*

# ============================================================================
# Fixtures / observation helpers
# ============================================================================

fn sp() -> Span:
    lex_span_empty()

fn t_i64() -> HirType:
    HirType(kind: HirTypeKind.Int(bits: 64, signed: true), span: sp())

fn t_text() -> HirType:
    HirType(kind: HirTypeKind.Str, span: sp())

fn t_bool() -> HirType:
    HirType(kind: HirTypeKind.Bool, span: sp())

fn t_fn(params: [HirType], ret: HirType) -> HirType:
    HirType(kind: HirTypeKind.Function(params, ret, []), span: sp())

fn t_tuple(elems: [HirType]) -> HirType:
    HirType(kind: HirTypeKind.Tuple(elems), span: sp())

fn t_array(elem: HirType) -> HirType:
    HirType(kind: HirTypeKind.Array(elem, nil), span: sp())

fn t_opt(inner: HirType) -> HirType:
    HirType(kind: HirTypeKind.Optional(inner), span: sp())

fn type_tag(ty: HirType) -> text:
    """Short readable tag for a resolved HirType."""
    match ty.kind:
        case Int(bits, signed): "i64"
        case Str: "text"
        case Bool: "bool"
        case Infer(id, level): "var"
        case Function(params, ret, _): "fn"
        case Tuple(elements): "tuple"
        case Array(element, _): "array"
        case Optional(inner): "opt"
        case _: "other"

fn infer_var_id(ty: HirType) -> i64:
    """Type-variable id, or -1 if not a type variable."""
    match ty.kind:
        case Infer(id, level): id
        case _: -1

fn err_tag(e: TypeInferError) -> text:
    match e:
        case Mismatch(_, _, _): "Mismatch"
        case OccursCheck(_, _, _): "OccursCheck"
        case Undefined(_, _): "Undefined"
        case DimensionError(_): "DimensionError"
        case TraitNotImplemented(_, _, _): "TraitNotImplemented"
        case Other(_, _): "Other"

fn fn_return_of(ty: HirType) -> HirType:
    match ty.kind:
        case Function(params, ret, _): ret
        case _: ty

fn fn_params_of(ty: HirType) -> [HirType]:
    match ty.kind:
        case Function(params, ret, _): params
        case _: []

fn dim_lit(v: i64) -> DimExpr:
    DimExpr(kind: DimExprKind.Literal(value: v), span: sp())

# ============================================================================

use std.spec.step

describe "Type inference correctness":

    describe "Basic type inference":
        it "infers identity function type":
            step("Verify: infers identity function type")
            # @req: REQ-COMPILER-TYPE-INFER-001
            # forall a. a -> a : one quantified variable, return type is the param type
            var ctx = HmInferContext.new()
            ctx.enter_level()
            val a = ctx.fresh_var(sp())
            val id_ty = t_fn([a], a)
            ctx.exit_level()

            val scheme = ctx.generalize(id_ty)
            expect(scheme.vars.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(fn_params_of(scheme.ty).len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(infer_var_id(fn_return_of(scheme.ty))).to_equal(infer_var_id(fn_params_of(scheme.ty)[0]))

        it "infers constant function":
            step("Verify: infers constant function")
            var ctx = HmInferContext.new()
            val const_ty = t_fn([], t_i64())
            val scheme = ctx.generalize(const_ty)
            expect(scheme.vars.is_empty()).to_equal(true)
            expect(fn_params_of(scheme.ty).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(type_tag(fn_return_of(scheme.ty))).to_equal("i64")

        it "infers addition":
            step("Verify: infers addition")
            # x + y with i64 operands: both params and the result unify to i64
            var ctx = HmInferContext.new()
            val x = ctx.fresh_var(sp())
            val y = ctx.fresh_var(sp())
            val r = ctx.fresh_var(sp())
            expect(ctx.unify(x, t_i64()).is_ok()).to_equal(true)
            expect(ctx.unify(y, t_i64()).is_ok()).to_equal(true)
            expect(ctx.unify(r, x).is_ok()).to_equal(true)
            expect(type_tag(ctx.resolve(x))).to_equal("i64")
            expect(type_tag(ctx.resolve(y))).to_equal("i64")
            expect(type_tag(ctx.resolve(r))).to_equal("i64")

    describe "Polymorphism and unification":
        it "generalizes let-bound functions":
            step("Verify: generalizes let-bound functions")
            # val id = \x: x  used at both i64 and text -- each use instantiates fresh vars
            var ctx = HmInferContext.new()
            ctx.enter_level()
            val a = ctx.fresh_var(sp())
            val id_ty = t_fn([a], a)
            ctx.exit_level()
            val scheme = ctx.generalize(id_ty)
            expect(scheme.vars.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

            val use1 = ctx.instantiate(scheme)
            val use2 = ctx.instantiate(scheme)
            expect(infer_var_id(fn_params_of(use1)[0]) != infer_var_id(fn_params_of(use2)[0])).to_equal(true)

            expect(ctx.unify(fn_params_of(use1)[0], t_i64()).is_ok()).to_equal(true)
            expect(ctx.unify(fn_params_of(use2)[0], t_text()).is_ok()).to_equal(true)
            expect(type_tag(ctx.resolve(fn_return_of(use1)))).to_equal("i64")
            expect(type_tag(ctx.resolve(fn_return_of(use2)))).to_equal("text")

        it "does not generalize variables at or below the current level":
            step("Verify: does not generalize variables at or below the current level")
            # The monomorphism side of the level rule: a var created at the current
            # level is NOT quantified, so a second conflicting use fails.
            var ctx = HmInferContext.new()
            val x = ctx.fresh_var(sp())
            val scheme = ctx.generalize(x)
            expect(scheme.vars.is_empty()).to_equal(true)

            expect(ctx.unify(x, t_i64()).is_ok()).to_equal(true)
            val second = ctx.unify(x, t_text())
            expect(second.is_ok()).to_equal(false)

        it "unifies generic composition":
            step("Verify: unifies generic composition")
            # compose(f: b->c, g: a->b, x: a) -> c  quantifies three variables
            var ctx = HmInferContext.new()
            ctx.enter_level()
            val a = ctx.fresh_var(sp())
            val b = ctx.fresh_var(sp())
            val c = ctx.fresh_var(sp())
            val compose_ty = t_fn([t_fn([b], c), t_fn([a], b), a], c)
            ctx.exit_level()
            val scheme = ctx.generalize(compose_ty)
            expect(scheme.vars.len() >= 3).to_equal(true)

        it "unifies function types structurally and rejects arity mismatch":
            step("Verify: unifies function types structurally and rejects arity mismatch")
            var ctx = HmInferContext.new()
            val p = ctx.fresh_var(sp())
            val q = ctx.fresh_var(sp())
            expect(ctx.unify(t_fn([p], q), t_fn([t_i64()], t_text())).is_ok()).to_equal(true)
            expect(type_tag(ctx.resolve(p))).to_equal("i64")
            expect(type_tag(ctx.resolve(q))).to_equal("text")

            var ctx2 = HmInferContext.new()
            expect(ctx2.unify(t_fn([t_i64()], t_i64()), t_fn([], t_i64())).is_ok()).to_equal(false)

    describe "Data shapes":
        it "infers tuple and array shapes":
            step("Verify: infers tuple and array shapes")
            var ctx = HmInferContext.new()
            val a = ctx.fresh_var(sp())
            val b = ctx.fresh_var(sp())
            expect(ctx.unify(t_tuple([a, b]), t_tuple([t_i64(), t_text()])).is_ok()).to_equal(true)
            expect(type_tag(ctx.resolve(a))).to_equal("i64")
            expect(type_tag(ctx.resolve(b))).to_equal("text")

            val e = ctx.fresh_var(sp())
            expect(ctx.unify(t_array(e), t_array(t_i64())).is_ok()).to_equal(true)
            expect(type_tag(ctx.resolve(e))).to_equal("i64")
            expect(type_tag(ctx.resolve(t_array(e)))).to_equal("array")

        it "infers option constructors":
            step("Verify: infers option constructors")
            # Some(x) : T -> T?   /  None : T? with T still open
            var ctx = HmInferContext.new()
            val a = ctx.fresh_var(sp())
            expect(ctx.unify(t_opt(a), t_opt(t_text())).is_ok()).to_equal(true)
            expect(type_tag(ctx.resolve(a))).to_equal("text")

            var ctx2 = HmInferContext.new()
            val open = ctx2.fresh_var(sp())
            expect(type_tag(ctx2.resolve(t_opt(open)))).to_equal("opt")
            expect(ctx2.unify(t_opt(open), t_i64()).is_ok()).to_equal(false)

    describe "Annotations and errors":
        it "respects explicit type annotations":
            step("Verify: respects explicit type annotations")
            var ctx = HmInferContext.new()
            ctx.bind_mono("x", t_i64())
            ctx.bind_mono("y", t_i64())
            val lx = ctx.lookup("x", sp())
            val ly = ctx.lookup("y", sp())
            expect(lx.is_ok()).to_equal(true)
            expect(ly.is_ok()).to_equal(true)
            expect(type_tag(lx.unwrap())).to_equal("i64")
            expect(type_tag(ly.unwrap())).to_equal("i64")
            expect(ctx.unify(lx.unwrap(), ly.unwrap()).is_ok()).to_equal(true)

        it "reports clear type mismatch errors":
            step("Verify: reports clear type mismatch errors")
            var ctx = HmInferContext.new()
            val result = ctx.unify(t_i64(), t_text())
            expect(result.is_ok()).to_equal(false)
            val err = result.err.unwrap()
            expect(err_tag(err)).to_equal("Mismatch")
            expect(err.message().starts_with("type mismatch")).to_equal(true)

        it "reports an undefined-name error for an unbound symbol":
            step("Verify: reports an undefined-name error for an unbound symbol")
            var ctx = HmInferContext.new()
            val result = ctx.lookup("no_such_name", sp())
            expect(result.is_ok()).to_equal(false)
            expect(err_tag(result.err.unwrap())).to_equal("Undefined")

        it "detects occurs checks":
            step("Verify: detects occurs checks")
            # a ~ (a -> b) must fail: a occurs in the right-hand side
            var ctx = HmInferContext.new()
            val a = ctx.fresh_var(sp())
            val b = ctx.fresh_var(sp())
            expect(ctx.occurs(infer_var_id(a), t_fn([a], b))).to_equal(true)
            val result = ctx.unify(a, t_fn([a], b))
            expect(result.is_ok()).to_equal(false)
            expect(err_tag(result.err.unwrap())).to_equal("OccursCheck")

        it "does not fire the occurs check for an unrelated variable":
            step("Verify: does not fire the occurs check for an unrelated variable")
            var ctx = HmInferContext.new()
            val a = ctx.fresh_var(sp())
            val b = ctx.fresh_var(sp())
            expect(ctx.occurs(infer_var_id(a), t_fn([b], b))).to_equal(false)
            expect(ctx.unify(a, t_fn([b], b)).is_ok()).to_equal(true)
            expect(type_tag(ctx.resolve(a))).to_equal("fn")

    describe "Context substitution":
        it "resolves substitution chains":
            step("Verify: resolves substitution chains")
            var ctx = HmInferContext.new()
            val t1 = ctx.fresh_var(sp())
            val t2 = ctx.fresh_var(sp())
            val t3 = ctx.fresh_var(sp())

            expect(ctx.unify(t1, t2).is_ok()).to_equal(true)
            expect(ctx.unify(t2, t3).is_ok()).to_equal(true)
            expect(ctx.unify(t3, t_i64()).is_ok()).to_equal(true)

            expect(type_tag(ctx.resolve(t1))).to_equal("i64")
            expect(type_tag(ctx.resolve(t2))).to_equal("i64")
            expect(type_tag(ctx.resolve(t3))).to_equal("i64")

        it "hands out distinct fresh variable ids and tracks the level":
            step("Verify: hands out distinct fresh variable ids and tracks the level")
            var ctx = HmInferContext.new()
            expect(ctx.current_level()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            val v1 = ctx.fresh_var(sp())
            val v2 = ctx.fresh_var(sp())
            expect(infer_var_id(v1) != infer_var_id(v2)).to_equal(true)
            ctx.enter_level()
            expect(ctx.current_level()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            ctx.exit_level()
            expect(ctx.current_level()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    describe "Dimension constraint solving":
        it "accepts matching dimensions and rejects a mismatch":
            step("Verify: accepts matching dimensions and rejects a mismatch")
            var solver = DimSolver.new()
            solver.add_equal(dim_lit(4), dim_lit(4), sp())
            expect(solver.solve().is_ok()).to_equal(true)

            # RED: the mismatch path calls `e1.span.merge(e2.span)`, but the lexer
            # Span has no `merge` -- it resolves to the diagnostics Span's method,
            # which reads a field `end` that the lexer Span does not have. Every
            # dimension-mismatch error in dim_constraints.spl aborts instead of
            # reporting. See
            # doc/08_tracking/bug/dim_solver_mismatch_path_calls_span_merge_2026-08-10.md
            var bad = DimSolver.new()
            bad.add_equal(dim_lit(4), dim_lit(8), sp())
            expect(bad.solve().is_ok()).to_equal(false)

        it "binds a dimension variable through unification":
            step("Verify: binds a dimension variable through unification")
            var solver = DimSolver.new()
            val d = solver.fresh_var(sp())
            val unified = solver.unify(d, dim_lit(16))
            expect(unified.is_ok()).to_equal(true)
            # The binding really landed: the substituted form evaluates to 16.
            expect(solver.try_eval(solver.apply_substitution(d)).unwrap()).to_equal(16)  # oracle: 16 — named expected value from the requirement
            # ... but try_eval on the variable itself must agree. It does not:
            # try_eval never applies the substitution, unlike unify/occurs_in/
            # solve_constraint. See
            # doc/08_tracking/bug/dim_solver_try_eval_ignores_substitution_2026-08-10.md
            expect(solver.try_eval(d) != nil).to_equal(true)
            expect(solver.try_eval(d).unwrap()).to_equal(16)  # oracle: 16 — named expected value from the requirement

        it "a fresh context carries a solver with no outstanding constraints":
            step("Verify: a fresh context carries a solver with no outstanding constraints")
            var ctx = HmInferContext.new()
            expect(ctx.dim_solver.constraints.is_empty()).to_equal(true)

    describe "Regression checks":
        it "handles nested levels and generic examples":
            step("Verify: handles nested levels and generic examples")
            # Nested let: the inner binding generalizes, the outer level is untouched.
            var ctx = HmInferContext.new()
            ctx.enter_level()
            val outer = ctx.fresh_var(sp())
            ctx.enter_level()
            val inner = ctx.fresh_var(sp())
            ctx.exit_level()
            val inner_scheme = ctx.generalize(t_fn([inner], inner))
            expect(inner_scheme.vars.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            ctx.exit_level()
            expect(ctx.current_level()).to_equal(0)  # oracle: 0 — named expected value from the requirement

            # many_vars(x0, x1, x2) -> x0 : three quantified variables
            var ctx2 = HmInferContext.new()
            ctx2.enter_level()
            val x0 = ctx2.fresh_var(sp())
            val x1 = ctx2.fresh_var(sp())
            val x2 = ctx2.fresh_var(sp())
            ctx2.exit_level()
            val many = ctx2.generalize(t_fn([x0, x1, x2], x0))
            expect(many.vars.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

            # complex<T, U, V>(f: T->U, g: U->V, h: V->T, x: T) -> V
            var ctx3 = HmInferContext.new()
            ctx3.enter_level()
            val tv = ctx3.fresh_var(sp())
            val uv = ctx3.fresh_var(sp())
            val vv = ctx3.fresh_var(sp())
            val complex_ty = t_fn([t_fn([tv], uv), t_fn([uv], vv), t_fn([vv], tv), tv], vv)
            ctx3.exit_level()
            val poly = ctx3.generalize(complex_ty)
            expect(poly.vars.len() >= 3).to_equal(true)
