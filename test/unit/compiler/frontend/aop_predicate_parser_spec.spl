"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/frontend/aop_predicate_parser_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/compiler/10.frontend/core/aop_predicate_parser.spl 80%
use std.spec
use compiler.frontend.core.aop_predicate_parser.{validate_predicate, validate_advice_form}

describe "AOP Predicate Parser":
    describe "validate_predicate":
        it "accepts wildcard predicate":
            # @req: REQ-UNIT-COMPILER-001
            step("Verify: accepts wildcard predicate")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_predicate("*")).to_equal("")

        it "accepts execution selector":
            # @req: REQ-UNIT-COMPILER-002
            step("Verify: accepts execution selector")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_predicate("execution(* foo(..))")).to_equal("")

        it "accepts within selector":
            # @req: REQ-UNIT-COMPILER-003
            step("Verify: accepts within selector")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_predicate("within(services.*)")).to_equal("")

        it "accepts attr selector":
            # @req: REQ-UNIT-COMPILER-004
            step("Verify: accepts attr selector")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_predicate("attr(logged)")).to_equal("")

        it "accepts AND operator":
            # @req: REQ-UNIT-COMPILER-005
            step("Verify: accepts AND operator")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_predicate("execution(* foo(..)) & attr(logged)")).to_equal("")

        it "accepts OR operator":
            # @req: REQ-UNIT-COMPILER-006
            step("Verify: accepts OR operator")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_predicate("execution(* a(..)) | execution(* b(..))")).to_equal("")

        it "accepts NOT operator":
            # @req: REQ-UNIT-COMPILER-007
            step("Verify: accepts NOT operator")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_predicate("!execution(* skip(..))")).to_equal("")

        it "accepts grouped expression":
            # @req: REQ-UNIT-COMPILER-008
            step("Verify: accepts grouped expression")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_predicate("(execution(*) | within(svc.*)) & attr(tx)")).to_equal("")

        it "rejects empty predicate":
            # @req: REQ-UNIT-COMPILER-009
            step("Verify: rejects empty predicate")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_predicate("")).to_start_with("E1501")

        it "rejects deferred selector get":
            # @req: REQ-UNIT-COMPILER-010
            step("Verify: rejects deferred selector get")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_predicate("get(field)")).to_start_with("E1507")

        it "rejects deferred selector set":
            # @req: REQ-UNIT-COMPILER-011
            step("Verify: rejects deferred selector set")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_predicate("set(field)")).to_start_with("E1507")

        it "rejects deferred selector init":
            # @req: REQ-UNIT-COMPILER-012
            step("Verify: rejects deferred selector init")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_predicate("init(Type)")).to_start_with("E1507")

        it "rejects deferred selector effect":
            # @req: REQ-UNIT-COMPILER-013
            step("Verify: rejects deferred selector effect")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_predicate("effect(io)")).to_start_with("E1507")

        it "rejects unknown selector":
            # @req: REQ-UNIT-COMPILER-014
            step("Verify: rejects unknown selector")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_predicate("foobar(x)")).to_start_with("E1507")

        it "rejects unmatched parenthesis":
            # @req: REQ-UNIT-COMPILER-015
            step("Verify: rejects unmatched parenthesis")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_predicate("execution(* foo(..")).to_start_with("E1501")

    describe "validate_advice_form":
        it "accepts before":
            # @req: REQ-UNIT-COMPILER-016
            step("Verify: accepts before")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_advice_form("before")).to_equal("")

        it "accepts after_success":
            # @req: REQ-UNIT-COMPILER-017
            step("Verify: accepts after_success")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_advice_form("after_success")).to_equal("")

        it "accepts after_error":
            # @req: REQ-UNIT-COMPILER-018
            step("Verify: accepts after_error")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_advice_form("after_error")).to_equal("")

        it "accepts around":
            # @req: REQ-UNIT-COMPILER-019
            step("Verify: accepts around")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_advice_form("around")).to_equal("")

        it "rejects invalid form":
            # @req: REQ-UNIT-COMPILER-020
            step("Verify: rejects invalid form")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(validate_advice_form("invalid")).to_start_with("E1503")
