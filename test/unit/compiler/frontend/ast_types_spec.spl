# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step
use std.spec.{describe, it, expect}

use compiler.frontend.core.ast_types.{make_core_expr, make_core_stmt, make_core_decl, make_core_arm}

fn main() -> ():
    describe("frontend core ast types", fn() -> ():
        it("constructs core nodes carrying their tag and span id", fn() -> ():
            # @req REQ-SSPEC-UNIT
            step("build one node of each core kind")
            expect(make_core_expr(3, 7).tag).to_equal(3)
            expect(make_core_stmt(11, 21).span_id).to_equal(21)
            expect(make_core_decl(5, 9).tag).to_equal(5)
        )

        it("constructs match arms binding pattern, guard and body", fn() -> ():
            # @req REQ-SSPEC-UNIT
            step("build a core match arm")
            val arm = make_core_arm(1, 2, [3, 4])
            expect(arm.pattern).to_equal(1)
            expect(arm.guard).to_equal(2)
            expect(arm.body.len()).to_equal(2)
        )
    )
