"""
## Purpose and audience
Purpose: Prove that AOP Log Policy.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-FRONTEND-001 — stable requirement identity for this spec.

use std.spec
use compiler.frontend.core.aop_log_policy.{aop_log_join_kind, aop_log_should_weave, aop_log_pointcut_for_kind}

describe "AOP Log Policy":
    it "classifies hardware joins for audit logging":
        step("Verify: classifies hardware joins for audit logging")
        # @req: REQ-COMPILER-FRONTEND-001
        val kind = aop_log_join_kind("lib.hardware.uart", "write_register", [], [])
        expect(kind).to_equal("hardware")
        expect(aop_log_should_weave(kind, "release", false)).to_equal(true)

    it "classifies external access joins for audit logging":
        step("Verify: classifies external access joins for audit logging")
        val kind = aop_log_join_kind("app.net.client", "open_socket", [], ["network"])
        expect(kind).to_equal("external_access")
        expect(aop_log_should_weave(kind, "release", false)).to_equal(true)

    it "omits trace instrumentation in release unless enabled":
        step("Verify: omits trace instrumentation in release unless enabled")
        val kind = aop_log_join_kind("runtime.trace.writer", "record_span", [], [])
        expect(kind).to_equal("trace")
        expect(aop_log_should_weave(kind, "release", false)).to_equal(false)
        expect(aop_log_should_weave(kind, "release", true)).to_equal(true)

    it "keeps debug joins out of release by default":
        step("Verify: keeps debug joins out of release by default")
        val kind = aop_log_join_kind("app.cli.query", "parse_args", [], [])
        expect(kind).to_equal("debug")
        expect(aop_log_should_weave(kind, "release", false)).to_equal(false)
        expect(aop_log_should_weave(kind, "debug", false)).to_equal(true)

    it "publishes stable pointcut templates":
        step("Verify: publishes stable pointcut templates")
        val pointcut = aop_log_pointcut_for_kind("hardware")
        expect(pointcut).to_contain("effect:hardware")
