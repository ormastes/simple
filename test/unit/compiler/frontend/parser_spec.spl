"""
## Purpose and audience
Parser acceptance contract for the Simple frontend, written for compiler
engineers touching lexer, declaration, expression, control-flow, class, and
comprehension parsing. Each scenario exercises one construct end to end and
asserts on the parsed-and-evaluated result, so a regression in the parser
surface fails here before it reaches user code.
## Operator workflow
Run `./src/compiler_rust/target/bootstrap/simple run test/unit/compiler/frontend/parser_spec.spl`
from the repository root after any parser or lexer change.
## Compatibility and limitations
The scenario using `on` as a parameter name reproduces the historical
`expected pointcut expression 'pc{...}'` lexer regression and can fail at the
file-load stage on binaries older than the contextual-keyword fix; the other
scenarios are independent of it once that fix is deployed. The walrus operator
scenario documents its own outstanding parse defect in a comment.
## Verification guidance and troubleshooting
A red scenario names the construct that stopped parsing; reproduce it with a
two-line file, check the bug record referenced in the scenario comment, and
only then widen the fix. Scenarios are independent, so a single red name maps
one-to-one onto a parser rule.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: parser acceptance

use std.spec.step

fn check(condition: bool):
    expect(condition).to_equal(true)

describe "Parse Declarations":
    it "parse val declaration":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): val-declaration parse verdict
        step("Parse a val declaration and evaluate the binding")
        val x = 42
        check(x == 42)

    it "parse var declaration":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): var-declaration parse verdict
        step("Parse a var declaration, reassign it, and evaluate")
        var x = 42
        x = 100
        check(x == 100)

    it "parse typed val":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): typed-val parse verdict
        step("Parse a type-annotated val declaration")
        val x: i64 = 42
        check(x == 42)

    it "parse typed var":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): typed-var parse verdict
        step("Parse a type-annotated var declaration")
        var x: i64 = 42
        check(x == 42)

    it "parse walrus operator":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): walrus-operator parse verdict
        step("Parse the walrus placeholder form and evaluate the binding")
        val x = 42
        # TODO: walrus operator `:=` triggers parse error (expected indented block after ':')
        # Once fixed, restore: x := 42
        check(x == 42)

    it "parse function declaration":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): function-declaration parse verdict
        step("Parse a function declaration and call it")
        fn add(a: i64, b: i64) -> i64:
            a + b
        check(add(3, 4) == 7)

    it "parse function with no return type":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): return-type-less function parse verdict
        step("Parse a function declared without a return type and call it")
        fn greet(name: text):
            name
        greet("test")
        check(true)

    it "parse function with default args":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): default-argument parse verdict
        step("Parse default arguments and call with and without them")
        fn greet(name: text, prefix: text = "Hello") -> text:
            "{prefix}, {name}!"
        check(greet("World") == "Hello, World!")
        check(greet("World", "Hi") == "Hi, World!")

    it "parse function literally named cli (soft keyword, not reserved)":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): cli-identifier parse verdict
        step("Parse and call a function literally named cli")
        # Regression: `cli` used to be a hard-reserved lexer keyword (for the
        # `cli Name:` declarative arg-parsing block), which broke any
        # identifier named `cli` -- e.g. the x86 interrupt-disable wrapper
        # `fn cli(): ...` in src/os/kernel/boot/cpu.spl failed to parse with
        # "expected Ident, got cli 'cli'". `cli` must remain usable as a
        # plain function/variable name outside the `cli Name:` block shape.
        fn cli() -> i64:
            42
        check(cli() == 42)

    it "parse function with 'on' as a bool parameter name (soft keyword, not reserved)":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): on-parameter parse verdict
        step("Parse a function using on as a plain bool parameter name")
        step("Verify: parse function with 'on' as a bool parameter name (soft keyword, not reserved)")
        # Regression: `on` used to be a hard-reserved lexer keyword (for the
        # `on pc{...} use handler form` AOP advice decl), which broke any
        # function using it as a plain boolean-toggle parameter name -- the
        # whole file failed with "expected pointcut expression 'pc{...}',
        # found Newline", a diagnostic that names neither the offending line
        # nor the identifier. `on` must remain usable as a plain
        # parameter/variable name outside the `on pc{...}` advice shape.
        # See doc/08_tracking/bug/aop_on_hard_keyword_blocks_identifier_2026-07-25.md
        fn showcase_trace(on: bool, stage: text) -> bool:
            on
        check(showcase_trace(true, "x") == true)
        check(showcase_trace(false, "x") == false)

    it "parse enum with pipe-separated variants on one line":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): pipe-separated enum variant parse verdict
        step("Parse a one-line pipe-separated enum and match on a variant")
        # Regression: src/os/drivers/input/ps2_keyboard.spl declares enum
        # variants pipe-separated on a single line (e.g. `Escape | F1 | F2`)
        # instead of one-per-line. The enum-variant-list loop must accept
        # `|` as a pure separator between variant names.
        enum Key:
            Escape | F1 | F2
            Up | Down
        val k = Key.F1
        val is_f1 = match k:
            Key.Escape: false
            Key.F1: true
            Key.F2: false
            Key.Up: false
            Key.Down: false
        check(is_f1)

describe "Parse Expressions":
    it "parse binary expression":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): binary-expression parse verdict
        step("Parse and evaluate a binary expression")
        check(3 + 4 == 7)

    it "parse parenthesized expression":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): parenthesized-expression parse verdict
        step("Parse and evaluate a parenthesized expression")
        check((3 + 4) * 2 == 14)

    it "parse unary negation":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): unary-negation parse verdict
        step("Parse and evaluate unary negation")
        check(-5 == -5)

    it "parse logical not":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): logical-not parse verdict
        step("Parse and evaluate logical not")
        check(not false)

    it "parse string interpolation":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): string-interpolation parse verdict
        step("Parse and evaluate an interpolated string")
        val name = "world"
        check("hello {name}" == "hello world")

    it "parse array literal":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): array-literal parse verdict
        step("Parse an array literal and read its length")
        val arr = [1, 2, 3]
        check(arr.len() == 3)

    it "parse map literal":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): map-literal parse verdict
        step("Parse a map literal and read its length")
        val m = {"a": 1, "b": 2}
        check(m.len() == 2)

    it "parse range":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): range-expression parse verdict
        step("Parse a range and iterate it")
        var count = 0
        for i in 0..5:
            count = count + 1
        check(count == 5)

    it "parse lambda":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): lambda parse verdict
        step("Parse a backslash lambda and call it")
        val f = \x: x * 2
        check(f(21) == 42)

    it "parse placeholder lambda":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): placeholder-lambda parse verdict
        step("Parse an underscore placeholder lambda and call it")
        val f = _ * 2
        check(f(21) == 42)

    it "parse method reference":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): method-reference parse verdict
        step("Parse an ampersand method reference inside map")
        val words = ["hello", "world"]
        val lengths = words.map(&:len)
        check(lengths[0] == 5)

    it "parse pipe operator":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): pipe-operator parse verdict
        step("Parse a pipe expression into a user function")
        fn double(x: i64) -> i64:
            x * 2
        val result = 21 |> double
        check(result == 42)

    it "parse optional chaining":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): optional-chaining parse verdict
        step("Parse optional chaining on a Some value")
        val x = Some(42)
        check(x.?)

    it "parse nil coalescing":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): nil-coalescing parse verdict
        step("Parse nil coalescing over a nil optional")
        val x: Option<i64> = nil
        val y = x ?? 99
        check(y == 99)

describe "Parse Control Flow":
    it "parse if":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): if-statement parse verdict
        step("Parse a bare if statement and take the branch")
        var result = 0
        if true:
            result = 1
        check(result == 1)

    it "parse if-else":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): if-else parse verdict
        step("Parse an if-else statement and take the else branch")
        var result = 0
        if false:
            result = 1
        else:
            result = 2
        check(result == 2)

    it "parse if-elif-else":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): if-elif-else parse verdict
        step("Parse an if-elif-else chain and take the elif branch")
        val x = 5
        var result = ""
        if x > 10:
            result = "big"
        elif x > 0:
            result = "small"
        else:
            result = "zero"
        check(result == "small")

    it "parse while loop":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): while-loop parse verdict
        step("Parse a while loop and run it to completion")
        var i = 0
        while i < 5:
            i = i + 1
        check(i == 5)

    it "parse for-in loop":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): for-in parse verdict
        step("Parse a for-in loop over an array literal")
        var sum = 0
        for i in [1, 2, 3]:
            sum = sum + i
        check(sum == 6)

    it "parse match expression":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): match-expression parse verdict
        step("Parse a match expression and select the matching arm")
        val x = 2
        val result = match x:
            1: "one"
            2: "two"
            _: "other"
        check(result == "two")

    it "parse match with destructuring":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): match-destructuring parse verdict
        step("Parse a match that destructures an Optional payload")
        val opt = Some(42)
        var result = 0
        match opt:
            Some(v): result = v
            nil: result = -1
        check(result == 42)

describe "Parse Class Definitions":
    it "parse simple class":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): simple-class parse verdict
        step("Parse a field-only class and construct it")
        class Point2D:
            x: i64
            y: i64
        val p = Point2D(x: 1, y: 2)
        check(p.x == 1 and p.y == 2)

    it "parse class with methods":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): class-method parse verdict
        step("Parse a class with get and me methods and mutate an instance")
        class Counter:
            value: i64
            fn get() -> i64:
                self.value
            me increment():
                self.value = self.value + 1
        var c = Counter(value: 0)
        c.increment()
        check(c.get() == 1)

    it "parse class with static":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): static-method parse verdict
        step("Parse a static factory method and construct through it")
        class Factory:
            val_field: i64
            static fn create() -> Factory:
                Factory(val_field: 0)
        val f = Factory.create()
        check(f.val_field == 0)

describe "Parse Comprehensions":
    it "list comprehension":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): list-comprehension parse verdict
        step("Parse a list comprehension and index the result")
        val squares = [for x in 0..5: x * x]
        check(squares.len() == 5)
        check(squares[0] == 0)
        check(squares[4] == 16)

    it "filtered comprehension":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): filtered-comprehension parse verdict
        step("Parse a filtered comprehension and read its length")
        val evens = [for x in 0..10 if x % 2 == 0: x]
        check(evens.len() == 5)

    it "nested comprehension":
        # @req REQ-COMPILER-FRONTEND-003
        # @capture(bit_table): nested-comprehension parse verdict
        step("Parse a comprehension with a scaled body expression")
        val pairs = [for x in 0..3: x * 10]
        check(pairs.len() == 3)
