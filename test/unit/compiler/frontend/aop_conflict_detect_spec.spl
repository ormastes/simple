"""
## Purpose and audience
Purpose: Prove that AOP Conflict Detection.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-FRONTEND-001 — stable requirement identity for this spec.

# @cover src/compiler/10.frontend/core/aop_conflict_detect.spl 80%
use std.spec
use compiler.frontend.core.aop.{WeavingRule, AdviceForm}
use compiler.frontend.core.aop_conflict_detect.{detect_advice_conflicts}

describe "AOP Conflict Detection":
    it "returns no conflicts for non-overlapping rules":
        step("Verify: returns no conflicts for non-overlapping rules")
        # @req: REQ-COMPILER-FRONTEND-001
        val rules = [
            WeavingRule(predicate_text: "execution(* foo(..))", advice_function: "log_fn", form: AdviceForm.Before, priority: 10),
            WeavingRule(predicate_text: "execution(* bar(..))", advice_function: "trace_fn", form: AdviceForm.Before, priority: 20)
        ]
        val conflicts = detect_advice_conflicts(rules)
        expect(conflicts.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "returns no conflicts for same predicate but different priority":
        step("Verify: returns no conflicts for same predicate but different priority")
        val rules = [
            WeavingRule(predicate_text: "execution(* foo(..))", advice_function: "log_fn", form: AdviceForm.Before, priority: 10),
            WeavingRule(predicate_text: "execution(* foo(..))", advice_function: "trace_fn", form: AdviceForm.Before, priority: 20)
        ]
        val conflicts = detect_advice_conflicts(rules)
        expect(conflicts.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "returns no conflicts for same predicate and priority but different form":
        step("Verify: returns no conflicts for same predicate and priority but different form")
        val rules = [
            WeavingRule(predicate_text: "execution(* foo(..))", advice_function: "log_fn", form: AdviceForm.Before, priority: 10),
            WeavingRule(predicate_text: "execution(* foo(..))", advice_function: "trace_fn", form: AdviceForm.AfterSuccess, priority: 10)
        ]
        val conflicts = detect_advice_conflicts(rules)
        expect(conflicts.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "detects E1504 conflict for same predicate, form, and priority":
        step("Verify: detects E1504 conflict for same predicate, form, and priority")
        val rules = [
            WeavingRule(predicate_text: "execution(* foo(..))", advice_function: "log_fn", form: AdviceForm.Before, priority: 10),
            WeavingRule(predicate_text: "execution(* foo(..))", advice_function: "trace_fn", form: AdviceForm.Before, priority: 10)
        ]
        val conflicts = detect_advice_conflicts(rules)
        expect(conflicts.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(conflicts[0].message).to_contain("E1504")
        expect(conflicts[0].message).to_contain("log_fn")
        expect(conflicts[0].message).to_contain("trace_fn")

    it "does not flag same function name as conflict":
        step("Verify: does not flag same function name as conflict")
        val rules = [
            WeavingRule(predicate_text: "execution(* foo(..))", advice_function: "log_fn", form: AdviceForm.Before, priority: 10),
            WeavingRule(predicate_text: "execution(* foo(..))", advice_function: "log_fn", form: AdviceForm.Before, priority: 10)
        ]
        val conflicts = detect_advice_conflicts(rules)
        expect(conflicts.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
