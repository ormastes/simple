"""
## Purpose and audience
Purpose: Prove that module fn vs builtin name precedence.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-FRONTEND-001 — stable requirement identity for this spec.

# @cover src/compiler_rust/compiler/src/interpreter_call/mod.rs
# Regression specs for doc/08_tracking/bug/module_fn_shadowed_by_builtin_name_2026-08-21.md
#
# A module-level `pub fn` imported by name must win over a same-named
# interpreter builtin. Today Priority 2 (builtins::eval_builtin,
# interpreter_call/mod.rs:480) runs before Priority 4 (user functions),
# so `freeze` and `len` silently resolve to the builtin. These specs are
# RED on purpose until that precedence is fixed.
use std.spec
use builtin_name_shadow_fixture.{freeze, len, push, map}

describe "module fn vs builtin name precedence":
    it "calls the user fn named freeze, not the builtin freeze":
        step("Verify: calls the user fn named freeze, not the builtin freeze")
        # @req: REQ-COMPILER-FRONTEND-001
        val xs = [1, 2, 3]
        expect(freeze(xs)).to_equal(111)  # oracle: 111 — named expected value from the requirement

    it "calls the user fn named len, not the builtin len":
        step("Verify: calls the user fn named len, not the builtin len")
        val xs = [1, 2, 3]
        expect(len(xs)).to_equal(222)  # oracle: 222 — named expected value from the requirement

    it "calls the user fn named push":
        step("Verify: calls the user fn named push")
        val xs = [1, 2, 3]
        expect(push(xs)).to_equal(333)  # oracle: 333 — named expected value from the requirement

    it "calls the user fn named map":
        step("Verify: calls the user fn named map")
        val xs = [1, 2, 3]
        expect(map(xs)).to_equal(444)  # oracle: 444 — named expected value from the requirement
