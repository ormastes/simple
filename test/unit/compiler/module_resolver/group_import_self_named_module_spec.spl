# # Group Import of Self-Named Module Member
#
# **Category:** Module Resolution
# **Status:** Implemented
#
# Reproducer for the `use pkg.Mod.{Mod}` bug: when a module FILE shares its
# name with a class it exports, an explicit `{Mod}` group import used to bind
# the enclosing module namespace dict instead of the class — so static calls
# (`Mod.get()`) silently returned nil via dict lookup.
# Fix: interpreter_eval.rs / evaluation_helpers.rs skip the module-dict
# rebind when a group item explicitly claims the module's own name.
# See doc/08_tracking/bug/group_import_self_named_module_binds_module_dict_2026-08-17.md

use std.spec.*
use fixtures.self_named.Widget.{Widget}

describe "group import of self-named module member":
    it "binds the class, and static methods dispatch on it":
        # Before the fix Widget.kind() was dict.get-style nil.
        expect(Widget.kind()).to_equal("widget")

    it "constructs instances through the imported name":
        val w = Widget(size: 9)
        expect(w.size).to_equal(9)
