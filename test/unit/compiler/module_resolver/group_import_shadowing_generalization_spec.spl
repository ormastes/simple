# # Group Import Shadowing — Generalization Probes
#
# **Category:** Module Resolution
# **Status:** Implemented
#
# Adjacent cases around the `use pkg.Mod.{Mod}` fix, so a recurrence in a
# nearby import form is caught:
#   - nested module path whose last segment equals the imported class
#   - alias form `{Mod as Other}` (module dict must stay bound under `Mod`)
#   - group import of a sibling function next to the self-named class
# See doc/08_tracking/bug/group_import_self_named_module_binds_module_dict_2026-08-17.md

use std.spec.*
use fixtures.self_named.nested.Gadget.{Gadget, gadget_default}
use fixtures.self_named.Widget.{Widget as W}

describe "group import shadowing generalization":
    it "nested self-named module binds the class member":
        expect(Gadget.kind()).to_equal("gadget")
        val g = Gadget(id: 3)
        expect(g.id).to_equal(3)

    it "sibling function imported alongside the self-named class works":
        expect(gadget_default()).to_equal(11)

    it "aliased import binds the class under the alias":
        val w = W(size: 5)
        expect(w.size).to_equal(5)
        expect(W.kind()).to_equal("widget")
