use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_definitions.*
use compiler.hir.hir_types.SymbolTable
use compiler.common.diagnostics.span.Span
use compiler.mir.mir.*
use compiler.mir.mir_lowering.MirLowering
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLoweringExpr.expr_dispatch.*

fn ref_dict_call_count(function: MirFunction, wanted: text) -> i64:
    var count = 0
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.Call(_, callee, _):
                    match callee.kind:
                        case MirOperandKind.Const(MirConstValue.Str(name), _):
                            if name == wanted: count = count + 1
                        case _: ()
                case _: ()
    count

describe "borrowed dictionary indexing owner":
    it "lowers text-key reads and compound writes through dictionary runtime calls":
        val source = "fn update(values: mut Dict<text, f64>, key: text) -> f64:\n    values[key] = 1.25\n    values[key] += 0.5\n    return values[key]\n"
        val ast = parse_full_frontend(source, "ref_dict.spl", "ref_dict.spl", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("ref_dict.spl")
        val hir = hir_lowering.lower_module(ast)
        var lowering = MirLowering.new(hir.symbols)
        val module = lowering.lower_module(hir)
        expect(lowering.errors.len()).to_equal(0)
        var checked = 0
        for function in module.functions.values():
            if function.name == "update":
                checked = checked + 1
                expect(ref_dict_call_count(function, "rt_dict_get")).to_equal(2)
                expect(ref_dict_call_count(function, "rt_dict_set")).to_equal(2)
                expect(ref_dict_call_count(function, "rt_array_set")).to_equal(0)
                # Both the compound read and final read must decode f64.
                expect(ref_dict_call_count(function, "rt_value_as_float")).to_equal(2)
                var geps = 0
                for block in function.blocks:
                    for instruction in block.instructions:
                        match instruction.kind:
                            case MirInstKind.GetElementPtr(_, _, _): geps = geps + 1
                            case _: ()
                expect(geps).to_equal(0)
        expect(checked).to_equal(1)

    it "accepts borrowed Dict views without claiming pointers or array references":
        var lowering = MirLowering.new(SymbolTable.new())
        val dictionary = MirType(kind: MirTypeKind.Dict(MirType.i64(), MirType.f64()))
        for mutable in [false, true]:
            val borrowed = MirType(kind: MirTypeKind.Ref(dictionary, mutable))
            val value_type = lowering.runtime_dict_value_mir_type(borrowed)
            expect(value_type != nil).to_equal(true)
            if val found = value_type:
                var is_float = false
                match found.kind:
                    case MirTypeKind.F64: is_float = true
                    case _: ()
                expect(is_float).to_equal(true)
        val pointer = MirType(kind: MirTypeKind.Ptr(dictionary, true))
        val array = MirType(kind: MirTypeKind.Ref(MirType(kind: MirTypeKind.Array(MirType.i64(), 2)), true))
        expect(lowering.runtime_dict_value_mir_type(pointer) == nil).to_equal(true)
        expect(lowering.runtime_dict_value_mir_type(array) == nil).to_equal(true)
        expect(lowering.runtime_dict_value_mir_type(MirType.i64()) == nil).to_equal(true)

    it "recognizes only bare or singly borrowed Dict locals as runtime dictionaries":
        var lowering = MirLowering.new(SymbolTable.new())
        val dictionary = MirType(kind: MirTypeKind.Dict(MirType.i64(), MirType.f64()))
        val bare = lowering.builder.new_local(nil, dictionary, LocalKind.Var)
        val immutable_ref = lowering.builder.new_local(nil, MirType(kind: MirTypeKind.Ref(dictionary, false)), LocalKind.Arg(index: 0))
        val mutable_ref = lowering.builder.new_local(nil, MirType(kind: MirTypeKind.Ref(dictionary, true)), LocalKind.Arg(index: 1))
        val pointer = lowering.builder.new_local(nil, MirType(kind: MirTypeKind.Ptr(dictionary, true)), LocalKind.Var)
        val array_ref = lowering.builder.new_local(nil, MirType(kind: MirTypeKind.Ref(MirType(kind: MirTypeKind.Array(MirType.i64(), 2)), true)), LocalKind.Var)
        val nested_ref = lowering.builder.new_local(nil, MirType(kind: MirTypeKind.Ref(MirType(kind: MirTypeKind.Ref(dictionary, true)), true)), LocalKind.Var)
        expect(lowering.local_is_runtime_dict(bare)).to_equal(true)
        expect(lowering.local_is_runtime_dict(immutable_ref)).to_equal(true)
        expect(lowering.local_is_runtime_dict(mutable_ref)).to_equal(true)
        expect(lowering.local_is_runtime_dict(pointer)).to_equal(false)
        expect(lowering.local_is_runtime_dict(array_ref)).to_equal(false)
        expect(lowering.local_is_runtime_dict(nested_ref)).to_equal(false)
        expect(lowering.local_is_runtime_dict(LocalId(id: 999))).to_equal(false)

    it "recovers borrowed Dict getter value decoding without HIR type metadata":
        var lowering = MirLowering.new(SymbolTable.new())
        var builder = lowering.builder
        builder.begin_function(
            SymbolId(id: 0), "borrowed_get",
            MirSignature(params: [], return_type: MirType.i64(), is_variadic: false),
            Span.empty()
        )
        val dictionary = MirType(kind: MirTypeKind.Dict(MirType(kind: MirTypeKind.Str), MirType.f64()))
        val dict_local = builder.new_local(nil, MirType(kind: MirTypeKind.Ref(dictionary, true)), LocalKind.Arg(index: 0))
        val key_local = builder.new_local(nil, MirType(kind: MirTypeKind.Str), LocalKind.Arg(index: 1))
        lowering.builder = builder
        val base = HirExpr(kind: HirExprKind.NilLit, has_type_: false,
            type_: HirType(kind: HirTypeKind.Unit, span: Span.empty()), span: Span.empty())
        val result = lowering.lower_dict_runtime_read(base, dict_local, key_local, false)
        if val result_type = lowering.builder.local_type(result):
            var is_float = false
            match result_type.kind:
                case MirTypeKind.F64: is_float = true
                case _: ()
            expect(is_float).to_equal(true)
        else:
            expect(false).to_equal(true)
