use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
# `lower_module` is a `me` method defined in _Items/module_lowering.spl and
# re-exported via hir_lowering.items; types.spl alone does not bring it in scope.
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
# `MirLowering` is NOT re-exported from `compiler.mir` / `compiler.mir.mir`
# (see 50.mir/__init__.spl): import it from its own module.
use compiler.mir.mir_lowering.{MirLowering}

fn lower_function_slot_source(src: text) -> MirModule:
    val ast = parse_full_frontend(src, "function_slot.spl", "function_slot.spl", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("function_slot.spl")
    val hir = hir_lowering.lower_module(ast)
    var mir_lowering = MirLowering.new(hir.symbols)
    mir_lowering.lower_module(hir)

describe "Module-global function pointer MIR lowering", tag: ["only-compiled"]:
    it "loads the mutable slot and calls its current function indirectly":
        val source = "fn default_cleanup():\n    ()\n\nfn replacement_cleanup():\n    ()\n\nvar cleanup: fn() = default_cleanup\n\nfn install():\n    cleanup = replacement_cleanup\n\nfn invoke():\n    cleanup()\n"
        val mir = lower_function_slot_source(source)
        var saw_store_global = false
        var saw_load_global = false
        var saw_indirect_call = false
        var saw_direct_cleanup_call = false

        for function in mir.functions.values():
            if function.name == "install" or function.name == "invoke":
                for block in function.blocks:
                    for instruction in block.instructions:
                        match instruction.kind:
                            case MirInstKind.StoreGlobal(_, _):
                                saw_store_global = true
                            case MirInstKind.LoadGlobal(_, _):
                                saw_load_global = true
                            case MirInstKind.CallIndirect(_, _, _, _):
                                saw_indirect_call = true
                            case MirInstKind.Call(_, operand, _):
                                match operand.kind:
                                    case MirOperandKind.Const(MirConstValue.Str(name), _):
                                        if name == "cleanup":
                                            saw_direct_cleanup_call = true
                                    case _:
                                        pass
                            case _:
                                pass

        expect(saw_store_global).to_equal(true)
        expect(saw_load_global).to_equal(true)
        expect(saw_indirect_call).to_equal(true)
        expect(saw_direct_cleanup_call).to_equal(false)

    # Neighbour 1 (over-demotion guard): an ORDINARY call to a top-level
    # function must still lower to a DIRECT call. The slot demotion added for
    # this bug keys off "callee names a module global with backing static and
    # is not a known top-level function"; if that predicate ever widened to
    # plain function names, every direct call in the tree would silently
    # become an indirect one.
    it "keeps an ordinary top-level function call direct":
        val source = "fn helper() -> i64:\n    7\n\nfn caller() -> i64:\n    helper()\n"
        val mir = lower_function_slot_source(source)
        var saw_direct_helper_call = false
        for function in mir.functions.values():
            if function.name == "caller":
                for block in function.blocks:
                    for instruction in block.instructions:
                        match instruction.kind:
                            case MirInstKind.Call(_, operand, _):
                                match operand.kind:
                                    case MirOperandKind.Const(MirConstValue.Str(name), _):
                                        if name == "helper":
                                            saw_direct_helper_call = true
                                    case _:
                                        pass
                            case _:
                                pass
        expect(saw_direct_helper_call).to_equal(true)

    # Neighbour 2 (same defect class, initializer half): the slot's DECLARED
    # initializer must be installed at module-init time. Without the
    # runtime-module-initializer entry the global has no backing static at
    # all, which is what made the write in `install` vanish and the call in
    # `invoke` bind directly.
    it "installs the slot's initial function pointer in a module initializer":
        val source = "fn default_cleanup():\n    ()\n\nfn replacement_cleanup():\n    ()\n\nvar cleanup: fn() = default_cleanup\n\nfn install():\n    cleanup = replacement_cleanup\n\nfn invoke():\n    cleanup()\n"
        val mir = lower_function_slot_source(source)
        var saw_slot_static = false
        for static_ in mir.statics.values():
            if static_.name.ends_with("cleanup"):
                saw_slot_static = true
        var saw_init_store = false
        for function in mir.functions.values():
            if function.name != "install" and function.name != "invoke":
                for block in function.blocks:
                    for instruction in block.instructions:
                        match instruction.kind:
                            case MirInstKind.StoreGlobal(_, _):
                                saw_init_store = true
                            case _:
                                pass
        expect(saw_slot_static).to_equal(true)
        expect(saw_init_store).to_equal(true)
