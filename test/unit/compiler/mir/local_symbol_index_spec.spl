"""
## Purpose
Prove the staged-native-safe MIR local-symbol index preserves authoritative
binding semantics across collisions, growth, reset, and scope rollback.
"""

use compiler.hir.hir_types.{SymbolTable}
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir.mir_types.{LocalId}
use std.spec.step

extern fn rt_file_read_text(path: text) -> text

describe "MIR local symbol index":
    it "preserves collisions updates and resize mappings":
        step("Bind colliding sparse symbols beyond the first resize threshold")
        var lowering = MirLowering.new(SymbolTable.new())
        var i = 0
        while i < 40:
            lowering.bind_local(i * 16, LocalId(id: 1000 + i))
            i = i + 1
        expect(lowering.local_symbol_ids.len()).to_equal(40)
        expect(lowering.local_symbol_index_slots.len()).to_equal(64)
        var occupied = 0
        for slot in lowering.local_symbol_index_slots:
            if slot >= 0:
                occupied = occupied + 1
        expect(occupied).to_equal(40)
        i = 0
        while i < 40:
            expect(lowering.find_local(i * 16).id).to_equal(1000 + i)
            i = i + 1

        step("Update an existing binding without appending")
        lowering.bind_local(16, LocalId(id: 9001))
        expect(lowering.local_symbol_ids.len()).to_equal(40)
        expect(lowering.find_local(16).id).to_equal(9001)
        expect(lowering.find_local(7).id).to_equal(-1)
        lowering.bind_local(-1, LocalId(id: 1))
        expect(lowering.local_symbol_ids.len()).to_equal(40)

        step("Fail closed to authoritative arrays if cache state is absent")
        lowering.local_symbol_index_slots = []
        expect(lowering.find_local(16).id).to_equal(9001)
        lowering.bind_local(16, LocalId(id: 9016))
        expect(lowering.local_symbol_ids.len()).to_equal(40)
        expect(lowering.local_symbol_index_slots.len()).to_equal(128)
        expect(lowering.find_local(16).id).to_equal(9016)
        i = 0
        while i < 40:
            val expected = if i == 1: 9016 else: 1000 + i
            expect(lowering.find_local(i * 16).id).to_equal(expected)
            i = i + 1

        step("Repair an occupied bucket whose slot is outside authority")
        lowering.local_symbol_index_slots[16] = 999
        expect(lowering.find_local(16).id).to_equal(9016)
        lowering.bind_local(16, LocalId(id: 9116))
        expect(lowering.local_symbol_ids.len()).to_equal(40)
        expect(lowering.find_local(16).id).to_equal(9116)

    it "restores an outer scope without leaking overlay bindings":
        step("Snapshot every authoritative and cached binding component")
        var lowering = MirLowering.new(SymbolTable.new())
        lowering.bind_local(7, LocalId(id: 70))
        val saved_ids = lowering.local_symbol_ids
        val saved_values = lowering.local_symbol_values
        val saved_slots = lowering.local_symbol_index_slots
        lowering.bind_local(7, LocalId(id: 700))
        lowering.bind_local(9, LocalId(id: 90))
        expect(lowering.local_symbol_index_slots).not.to_equal(saved_slots)
        expect(lowering.find_local(7).id).to_equal(700)
        expect(lowering.find_local(9).id).to_equal(90)

        lowering.local_symbol_ids = saved_ids
        lowering.local_symbol_values = saved_values
        lowering.local_symbol_index_slots = saved_slots
        expect(lowering.local_symbol_index_slots).to_equal(saved_slots)
        expect(lowering.find_local(7).id).to_equal(70)
        expect(lowering.find_local(9).id).to_equal(-1)

    it "clears index ownership at the next function boundary":
        step("Reset then reuse the same symbol id")
        var lowering = MirLowering.new(SymbolTable.new())
        lowering.bind_local(5, LocalId(id: 55))
        lowering.reset_function_local_tracking()
        expect(lowering.find_local(5).id).to_equal(-1)
        expect(lowering.local_symbol_index_slots.len()).to_equal(0)
        lowering.bind_local(5, LocalId(id: 66))
        expect(lowering.find_local(5).id).to_equal(66)

    it "keeps constructor reset and both lambda restores aligned":
        step("Pin every wholesale binding-state lifecycle site")
        val module_source = rt_file_read_text(
            "src/compiler/50.mir/_MirLowering/module_lowering.spl") ?? ""
        val function_source = rt_file_read_text(
            "src/compiler/50.mir/_MirLowering/function_lowering.spl") ?? ""
        val call_source = rt_file_read_text(
            "src/compiler/50.mir/_MirLoweringExpr/switch_operators_calls.spl") ?? ""
        expect(module_source.split("local_symbol_index_slots: []").len()).to_equal(2)
        expect(function_source.split(
            "self.local_symbol_index_slots = []").len()).to_equal(2)
        val named_lambda = call_source.slice(
            call_source.index_of("me try_inline_lambda_call("),
            call_source.index_of("me lower_inline_lambda_with_locals("))
        val inline_lambda = call_source.slice(
            call_source.index_of("me lower_inline_lambda_with_locals("),
            call_source.index_of("me lower_iife_call("))
        for body in [named_lambda, inline_lambda]:
            expect(body.split(
                "val saved_index_slots = self.local_symbol_index_slots").len()).to_equal(2)
            expect(body.split(
                "self.local_symbol_index_slots = saved_index_slots").len()).to_equal(2)
