# mir_chained_named_receiver_owner_2026_10_10: a chained call on a named
# receiver must keep the declared owner (ByteSpan) of the inner call's result.
use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_definitions.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering.MirLowering
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLoweringExpr.expr_dispatch.*
use compiler.hir.hir_types.SymbolTable
use compiler.common.diagnostics.span.Span

fn chained_owner_calls(function: MirFunction) -> [text]:
    var names: [text] = []
    for block in function.blocks:
        for instruction in block.instructions:
            match instruction.kind:
                case MirInstKind.Call(_, callee, _):
                    match callee.kind:
                        case MirOperandKind.Const(MirConstValue.Str(name), _): names.push(name)
                        case _: ()
                case _: ()
    names

describe "chained named receiver owner":
    it "dispatches slice and equals to the declared struct methods":
        val source = "struct Sp:\n    data: [u8]\n    off: i64\n    span_len: i64\n\nimpl Sp:\n    fn slice(start: i64, length: i64) -> Sp:\n        var want = length\n        Sp(data: self.data, off: self.off + start, span_len: want)\n    fn equals(other: Sp) -> bool:\n        self.span_len == other.span_len\n    fn starts_with(prefix: Sp) -> bool:\n        if prefix.span_len > self.span_len:\n            return false\n        self.slice(0, prefix.span_len).equals(prefix)\n"
        val ast = parse_full_frontend(source, "chain.spl", "chain.spl", Logger(level: 0))
        var hir_lowering = HirLowering.with_filename("chain.spl")
        val hir = hir_lowering.lower_module(ast)
        var lowering = MirLowering.new(hir.symbols)
        val module = lowering.lower_module(hir)
        expect(lowering.errors.len()).to_equal(0)
        var checked = 0
        for function in module.functions.values():
            if function.name.ends_with("starts_with"):
                checked = checked + 1
                val calls = chained_owner_calls(function)
                print "CALLS {calls}"
                expect(calls.contains("chain.Sp.slice")).to_equal(true)
                expect(calls.contains("chain.Sp.equals")).to_equal(true)
                expect(calls.contains("spl_str_slice")).to_equal(false)
        expect(checked).to_equal(1)

    it "recovers a chained call result owner from the inner call's nominal HIR type":
        # Cross-module shape: the inner call result local carries no remembered
        # HIR type, so only the inner expression's own Named type can supply
        # the owner. Old code returned nil here.
        var lowering = MirLowering.new(SymbolTable.new())
        var builder = lowering.builder
        builder.begin_function(
            SymbolId(id: 0), "chained_owner",
            MirSignature(params: [], return_type: MirType.i64(), is_variadic: false),
            Span.empty()
        )
        val result_local = builder.new_local(nil, MirType.i64(), LocalKind.Arg(index: 0))
        lowering.builder = builder
        val unit_ty = HirType(kind: HirTypeKind.Unit, span: Span.empty())
        val inner_recv = HirExpr(kind: HirExprKind.NilLit, has_type_: false, type_: unit_ty, span: Span.empty())
        val owner_ty = HirType(kind: HirTypeKind.Named(SymbolId(id: 42), []), span: Span.empty())
        val chained = HirExpr(kind: HirExprKind.MethodCall(inner_recv, "slice", [], MethodResolution.Unresolved),
            has_type_: true, type_: owner_ty, span: Span.empty())
        var owner_id = -1
        if val recovered = lowering.receiver_declared_or_result_type(chained, result_local):
            match recovered.kind:
                case HirTypeKind.Named(sym, _): owner_id = sym.id
                case _: ()
        expect(owner_id).to_equal(42)
        val untyped = HirExpr(kind: HirExprKind.MethodCall(inner_recv, "slice", [], MethodResolution.Unresolved),
            has_type_: false, type_: unit_ty, span: Span.empty())
        expect(lowering.receiver_declared_or_result_type(untyped, result_local) == nil).to_equal(true)
