use std.io_runtime.{file_read}
use std.spec.*

describe "MIR lowering of HirTypeKind.Layer":
    it "normalizes Layer to MirTypeKind.Opaque(\"layer\")":
        val source = file_read("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        expect(source).to_contain("case HirTypeKind.Layer(_, _):")
        expect(source).to_contain("MirType(kind: MirTypeKind.Opaque(\"layer\"))")
