use std.io_runtime.{file_read}
use std.spec.*

describe "MIR lowering of HirTypeKind.Isolated":
    it "erases Isolated to its inner type":
        val source = file_read("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        expect(source).to_contain("case HirTypeKind.Isolated(inner):")
        expect(source).to_contain("self.lower_type(inner)")
