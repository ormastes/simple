use std.io_runtime.{file_read}
use std.spec.*

describe "MIR lowering of HirTypeKind.Any":
    it "normalizes Any to MirTypeKind.I64 under a non-critical profile, but never silently":
        val source = file_read("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        expect(source).to_contain("case HirTypeKind.Any:")
        expect(source).to_contain("MirType.i64()")
        # Non-critical erasure is recorded as a non-fatal E-MIR-TYPE-Any warning
        expect(source).to_contain("self.error(\"E-MIR-TYPE-Any: `Any` erased to a tagged i64 slot at MIR lowering")
        expect(source).to_contain("fatal under critical)\", Some(type_.span))")
