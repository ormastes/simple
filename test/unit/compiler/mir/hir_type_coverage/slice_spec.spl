use std.io_runtime.{file_read}
use std.spec.*

describe "MIR lowering of HirTypeKind.Slice":
    it "lowers Slice to MirTypeKind.Slice":
        val source = file_read("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        expect(source).to_contain("case HirTypeKind.Slice(element):")
        expect(source).to_contain("MirType(kind: MirTypeKind.Slice(self.lower_type(element)))")
