use std.io_runtime.{file_read}
use std.spec.*

describe "MIR lowering of HirTypeKind.Any under the critical assurance profile":
    it "raises the fatal named diagnostic E-MIR-TYPE-Any with the source span":
        val source = file_read("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        expect(source).to_contain("if mir_type_any_requires_hard_error(any_profile_name):")
        expect(source).to_contain("self.error_fatal(\"E-MIR-TYPE-Any: `Any` reached MIR lowering")
        expect(source).to_contain("typed interface\", Some(type_.span))")

    it "reads the profile the same way the match-exhaustiveness hard-error decision does":
        val source = file_read("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        expect(source).to_contain("val any_profile_name = mir_lower_env_get(\"SIMPLE_SAFETY_PROFILE\") ?? \"\"")

    it "treats only AssuranceStrictness.Critical as hard, mirroring match_coverage_requires_hard_error":
        val source = file_read("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        expect(source).to_contain("fn mir_type_any_requires_hard_error(strictness_name: text) -> bool:")
        expect(source).to_contain("val canonical = normalize_profile_name(strictness_name)")
        expect(source).to_contain("AssuranceStrictness.Critical: true")
