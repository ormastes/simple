use std.io_runtime.{file_read}
use std.spec.*

describe "MIR lowering of HirTypeKind.TypeParam":
    it "raises the named diagnostic E-MIR-TYPE-TypeParam with the source span":
        val source = file_read("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        expect(source).to_contain("case HirTypeKind.TypeParam(name, _):")
        expect(source).to_contain("E-MIR-TYPE-TypeParam: unsubstituted generic type parameter")
        expect(source).to_contain("reached MIR lowering\", Some(type_.span))")
