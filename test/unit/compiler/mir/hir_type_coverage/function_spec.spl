use std.io_runtime.{file_read}
use std.spec.*

describe "MIR lowering of HirTypeKind.Function":
    it "lowers Function to a MirTypeKind.FuncPtr signature":
        val source = file_read("src/compiler/50.mir/_MirLowering/function_lowering.spl")
        expect(source).to_contain("case HirTypeKind.Function(params, ret, _):")
        expect(source).to_contain("MirType(kind: MirTypeKind.FuncPtr(MirSignature(")
