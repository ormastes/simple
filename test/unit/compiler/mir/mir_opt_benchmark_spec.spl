"""
## Purpose and audience
Source-contract evidence for the engineers who own the MIR optimizer
(`src/compiler/60.mir_opt/`): that every measured optimization — DCE, copy
propagation, CSE, inlining, constant folding, strength reduction, loop
unrolling — has a real, bounded pass behind it, and that the pipeline's
levels, cost classes, and translation validation are wired. Operators gating
an optimizer change rerun this spec before benchmarking.
## Operator workflow
Run
`./src/compiler_rust/target/bootstrap/simple run test/unit/compiler/mir/mir_opt_benchmark_spec.spl`
from the repo root; every scenario reads the named optimizer sources and
asserts the pass entry points, legality gates, counters, and termination
guards those benchmarks measure.
## Compatibility and limitations
Perf spec: no wall-clock assertions. The pass-time scenarios pin the
*structure* a measured time depends on — a single `run_on_function` entry,
bounded iterations, cost-class admission — not a millisecond number; timing
evidence needs a native benchmark receipt. The loop-unroll scenario pins the
shipped disabled-transform state on purpose.
## Verification guidance and troubleshooting
A failing contract local means the measured surface moved: a pass entry point
was renamed, a counter or legality gate was dropped, or a termination/cost
guard was removed. Grep the cited source for the token and restore or
re-pin the contract; never soften the assertion to re-green a benchmark.
"""
# Lifecycle: doc/01_research/domain/runtime_facade_optimization.md ;
# doc/03_plan/compiler/optimization/simple_optimization_architecture_roadmap_2026-06-01.md ;
# doc/04_architecture/compiler/optimization/optimization_plugin_jit_hotspot.md ;
# doc/05_design/compiler/optimization/executable_size_reduction.md
# @manual_section: mir-optimizer-benchmarks

# MIR Optimization Performance Benchmarks
#
# Benchmarks to measure the effectiveness of MIR optimization passes.
# Tests both compile-time cost and runtime improvement.


# ============================================================================
# Benchmark Infrastructure
# ============================================================================

use std.spec
use std.io_runtime.{file_read}

struct BenchmarkResult:
    # Result of a benchmark run.
    name: text
    before_instrs: i64      # Instruction count before optimization
    after_instrs: i64       # Instruction count after optimization
    reduction_pct: f64      # Percentage reduction
    pass_time_ms: f64       # Time spent in optimization pass

fn calculate_reduction(before: i64, after: i64) -> f64:
    # Calculate percentage reduction.
    if before == 0:
        0.0
    else:
        (before - after).to_f64() / before.to_f64() * 100.0

# ============================================================================
# Dead Code Elimination Benchmarks
# ============================================================================

describe "DCE benchmarks":
    it "measures dead assignment elimination":
        # @req REQ-MIR-BENCH-001
        # @capture(statistics): the DCE pass entry points and dead-instruction counters the benchmark reads
        step("Verify the DCE pass entry points and its dead-instruction counter exist for the benchmark")
        val dce = file_read("src/compiler/60.mir_opt/mir_opt/dce.spl")
        val engine = file_read("src/compiler/60.mir_opt/_OptimizationPasses/engine.spl")
        val has_pass_constructor = dce.contains("fn create_dce_pass() -> DeadCodeElimination:")
        val has_function_runner = dce.contains("fn dce_run_on_function(dce_pass: DeadCodeElimination, func: MirFunction) -> MirFunction")
        val engine_counts_dead_instrs = engine.contains("dead_instructions: i64")
        expect(has_pass_constructor).to_equal(true)  # oracle: the benchmark times exactly this constructor-built pass
        expect(has_function_runner).to_equal(true)  # oracle: per-function entry is what the before/after instruction census brackets
        expect(engine_counts_dead_instrs).to_equal(true)  # oracle: the engine-level counter is the benchmark's removal metric

    it "measures unreachable code elimination":
        # @req REQ-MIR-BENCH-002
        # @capture(statistics): the DCE unreachable-block stage and its removed-block counter
        step("Verify DCE removes unreachable blocks and counts them for the benchmark")
        val dce = file_read("src/compiler/60.mir_opt/mir_opt/dce.spl")
        val pins_unreachable_stage = dce.contains("3. Remove unreachable blocks")
        val counts_removed_blocks = dce.contains("removed_blocks: i64")
        expect(pins_unreachable_stage).to_equal(true)  # oracle: unreachable-block removal is the stage the benchmark measures
        expect(counts_removed_blocks).to_equal(true)  # oracle: the removed-block counter is the benchmark's block-reduction metric

    it "measures dead branch elimination":
        # @req REQ-MIR-BENCH-003
        # @capture(statistics): the mandatory-observation legality gate and the engine dead-instruction counter
        step("Verify DCE's branch-removal legality gate and the engine counter for the benchmark")
        val dce = file_read("src/compiler/60.mir_opt/mir_opt/dce.spl")
        val engine = file_read("src/compiler/60.mir_opt/_OptimizationPasses/engine.spl")
        val has_legality_gate = dce.contains("fn dce_instruction_is_mandatory_observation(inst: MirInst) -> bool:")
        val engine_counts_dead_instrs = engine.contains("dead_instructions: i64")
        expect(has_legality_gate).to_equal(true)  # oracle: branch removal may only delete instructions that are not mandatory observations
        expect(engine_counts_dead_instrs).to_equal(true)  # oracle: the engine counter is what the branch benchmark reads

# ============================================================================
# Copy Propagation Benchmarks
# ============================================================================

describe "Copy propagation benchmarks":
    it "measures chain copy elimination":
        # @req REQ-MIR-BENCH-004
        # @capture(statistics): the copy-chain root resolution and the pass runner the benchmark brackets
        step("Verify the copy-chain root and the pass runner exist for the benchmark")
        val copy_prop = file_read("src/compiler/60.mir_opt/mir_opt/copy_prop.spl")
        val has_pass_constructor = copy_prop.contains("fn create_copy_prop_pass() -> CopyPropagation:")
        val has_function_runner = copy_prop.contains("fn copypropagation_run_on_function(self: CopyPropagation, func: MirFunction) -> MirFunction")
        val resolves_chain_roots = copy_prop.contains("fn copychain_get_root(chain: CopyChain, local: LocalId) -> LocalId:")
        expect(has_pass_constructor).to_equal(true)  # oracle: the benchmark measures this constructor-built pass
        expect(has_function_runner).to_equal(true)  # oracle: per-function entry brackets the before/after instruction census
        expect(resolves_chain_roots).to_equal(true)  # oracle: root resolution is the mechanism that collapses copy chains

    it "measures copy through operations":
        # @req REQ-MIR-BENCH-005
        # @capture(statistics): the block and terminator propagation stages the benchmark exercises
        step("Verify copy propagation reaches operands and terminators for the benchmark")
        val copy_prop = file_read("src/compiler/60.mir_opt/mir_opt/copy_prop.spl")
        val propagates_through_blocks = copy_prop.contains("fn copypropagation_propagate_block(self: CopyPropagation, block: MirBlock) -> MirBlock:")
        val propagates_through_terminators = copy_prop.contains("fn copypropagation_propagate_terminator(self: CopyPropagation, term: MirTerminator) -> MirTerminator")
        expect(propagates_through_blocks).to_equal(true)  # oracle: block propagation is what replaces copies feeding operations
        expect(propagates_through_terminators).to_equal(true)  # oracle: terminator propagation is what replaces copies feeding control flow

# ============================================================================
# Common Subexpression Elimination Benchmarks
# ============================================================================

describe "CSE benchmarks":
    it "measures duplicate computation elimination":
        # @req REQ-MIR-BENCH-006
        # @capture(statistics): the CSE reuse rule, purity gate, and engine counter the benchmark reads
        step("Verify CSE's reuse rule, purity gate, and engine counter for the benchmark")
        val cse = file_read("src/compiler/60.mir_opt/mir_opt/cse.spl")
        val engine = file_read("src/compiler/60.mir_opt/_OptimizationPasses/engine.spl")
        val has_pass_constructor = cse.contains("fn create_cse_pass() -> CommonSubexprElimination:")
        val reuse_rule_documented = cse.contains("b. If expression already computed, reuse result")
        val gates_on_purity = cse.contains("fn is_pure() -> bool:")
        val engine_counts_cse = engine.contains("common_subexpressions: i64")
        expect(has_pass_constructor).to_equal(true)  # oracle: the benchmark measures this constructor-built pass
        expect(reuse_rule_documented).to_equal(true)  # oracle: expression reuse is the exact elimination the benchmark counts
        expect(gates_on_purity).to_equal(true)  # oracle: only pure expressions may be reused, so the benchmark's input must be pure
        expect(engine_counts_cse).to_equal(true)  # oracle: the engine counter is the benchmark's elimination metric

    it "measures nested CSE":
        # @req REQ-MIR-BENCH-007
        # @capture(statistics): the canonical expression key and the engine expression table
        step("Verify CSE's canonical expression key and the engine expression table")
        val cse = file_read("src/compiler/60.mir_opt/mir_opt/cse.spl")
        val engine = file_read("src/compiler/60.mir_opt/_OptimizationPasses/engine.spl")
        val canonical_expression_keys = cse.contains("Two expressions are equal if they compute the same value.")
        val engine_has_expression_table = engine.contains("expr_map: {text: i64}")
        expect(canonical_expression_keys).to_equal(true)  # oracle: canonical keys are what make nested subexpressions share one table entry
        expect(engine_has_expression_table).to_equal(true)  # oracle: the expression table is where nested CSE reuse is recorded

# ============================================================================
# Function Inlining Benchmarks
# ============================================================================

describe "Inlining benchmarks":
    it "measures small function inlining":
        # @req REQ-MIR-BENCH-008
        # @capture(statistics): the small-function inline pass and its call-site counters
        step("Verify the small-function inline pass and its call-site counter exist")
        val inline = file_read("src/compiler/60.mir_opt/mir_opt/_Inline/driver.spl")
        val has_small_pass = inline.contains("fn create_inline_small_pass() -> FunctionInlining:")
        val counts_inlined_sites = inline.contains("inlined_call_sites")
        expect(has_small_pass).to_equal(true)  # oracle: the small-function pass is the one the inlining benchmark measures
        expect(counts_inlined_sites).to_equal(true)  # oracle: the inlined call-site counter is the benchmark's replacement metric

    it "measures inlining with DCE benefit":
        # @req REQ-MIR-BENCH-009
        # @capture(statistics): the inline budget and the dead-instruction counter the combined effect reads
        step("Verify the inline budget and the engine dead-instruction counter for the combined effect")
        val inline = file_read("src/compiler/60.mir_opt/mir_opt/_Inline/driver.spl")
        val engine = file_read("src/compiler/60.mir_opt/_OptimizationPasses/engine.spl")
        val bounds_inline_volume = inline.contains("# Per-function inline budget. Bounds total inlined volume so a")
        val engine_counts_dead_instrs = engine.contains("dead_instructions: i64")
        expect(bounds_inline_volume).to_equal(true)  # oracle: the budget keeps inlined volume bounded so the DCE benefit stays measurable
        expect(engine_counts_dead_instrs).to_equal(true)  # oracle: the dead-branch fallout of inlining is what the benchmark reads

# ============================================================================
# Combined Optimization Benchmarks
# ============================================================================

describe "Combined optimization benchmarks":
    it "measures full optimization pipeline":
        # @req REQ-MIR-BENCH-010
        # @capture(statistics): the engine's stats aggregate over every pass counter
        step("Verify the engine aggregates all pass counters into one stats total")
        val engine = file_read("src/compiler/60.mir_opt/_OptimizationPasses/engine.spl")
        val has_stats_struct = engine.contains("static fn create() -> OptimizationStats:")
        val aggregates_all_counters = engine.contains("fn total() -> i64:")
        expect(has_stats_struct).to_equal(true)  # oracle: the pipeline benchmark reads the engine's own stats record
        expect(aggregates_all_counters).to_equal(true)  # oracle: the total is the pipeline-wide reduction metric the benchmark reports

    it "measures optimization levels":
        # @req REQ-MIR-BENCH-011
        # @capture(bit_table): the shipped optimization-level ladder from None_ to Speed
        step("Verify the shipped optimization-level ladder matches the benchmark's level matrix")
        val engine = file_read("src/compiler/60.mir_opt/_OptimizationPasses/engine.spl")
        val has_debug_level = engine.contains("Debug       # Debug-friendly compatibility level")
        val has_size_level = engine.contains("Size        # Size-oriented compatibility level")
        val has_basic_level = engine.contains("Basic       # Constant folding, simple algebraic")
        val has_standard_level = engine.contains("Standard    # + CSE, strength reduction")
        val has_speed_level = engine.contains("Speed       # Compatibility alias for Standard/O2-style optimization")
        expect(has_debug_level).to_equal(true)  # oracle: the level matrix pins Debug as the compatibility rung
        expect(has_size_level).to_equal(true)  # oracle: the level matrix pins Size as the size-oriented rung
        expect(has_basic_level).to_equal(true)  # oracle: the level matrix pins Basic as folding plus algebraic
        expect(has_standard_level).to_equal(true)  # oracle: the level matrix pins Standard as adding CSE and strength reduction
        expect(has_speed_level).to_equal(true)  # oracle: the level matrix pins Speed as the O2-style alias

# ============================================================================
# Compile-Time Cost Benchmarks
# ============================================================================

describe "Compile-time benchmarks":
    it "measures DCE pass time":
        # @req REQ-MIR-BENCH-012
        # @capture(statistics): the bounded DCE iteration guard a measured pass time depends on
        step("Verify DCE runs on a per-function entry with a bounded iteration counter")
        val dce = file_read("src/compiler/60.mir_opt/mir_opt/dce.spl")
        val has_function_runner = dce.contains("fn dce_run_on_function(dce_pass: DeadCodeElimination, func: MirFunction) -> MirFunction")
        val bounds_iterations = dce.contains("self.iterations = self.iterations + 1")
        expect(has_function_runner).to_equal(true)  # oracle: a single per-function entry is the structure a timed DCE run brackets
        expect(bounds_iterations).to_equal(true)  # oracle: the iteration counter makes the measured work bounded and auditable

    it "measures copy propagation time":
        # @req REQ-MIR-BENCH-013
        # @capture(statistics): the copy-propagation per-function entry a measured pass time brackets
        step("Verify copy propagation exposes one per-function entry for a timed run")
        val copy_prop = file_read("src/compiler/60.mir_opt/mir_opt/copy_prop.spl")
        val has_function_runner = copy_prop.contains("fn copypropagation_run_on_function(self: CopyPropagation, func: MirFunction) -> MirFunction")
        expect(has_function_runner).to_equal(true)  # oracle: the per-function entry is the unit a timed copy-prop run brackets

    it "measures CSE pass time":
        # @req REQ-MIR-BENCH-014
        # @capture(statistics): the CSE purity gate that justifies its higher measured cost
        step("Verify CSE checks expression purity, the reason its pass costs more")
        val cse = file_read("src/compiler/60.mir_opt/mir_opt/cse.spl")
        val gates_on_purity = cse.contains("fn is_pure() -> bool:")
        expect(gates_on_purity).to_equal(true)  # oracle: per-expression purity checks are the documented reason CSE costs more than DCE

    it "measures inlining pass time":
        # @req REQ-MIR-BENCH-015
        # @capture(statistics): the inline fixed-point cap that bounds a measured inlining run
        step("Verify inlining terminates at a fixed point or an iteration cap")
        val inline = file_read("src/compiler/60.mir_opt/mir_opt/_Inline/driver.spl")
        val caps_at_fixed_point = inline.contains("3. Repeat until fixed point or max iterations")
        val counts_iterations = inline.contains("self.iterations = self.iterations + 1")
        expect(caps_at_fixed_point).to_equal(true)  # oracle: the fixed-point-or-max-iterations rule is what bounds a timed inlining run
        expect(counts_iterations).to_equal(true)  # oracle: the iteration counter makes the measured work auditable

    it "measures full pipeline time":
        # @req REQ-MIR-BENCH-016
        # @capture(statistics): the manifest cost-class admission that gates what a full pipeline run may schedule
        step("Verify the manifest admits passes by cost class for a full pipeline run")
        val manifest = file_read("src/compiler/60.mir_opt/optimizer_manifest.spl")
        val ranks_cost_classes = manifest.contains("fn manifest_cost_rank(cost_class: text) -> i64:")
        val admits_by_cost = manifest.contains("fn manifest_cost_allowed(cost_class: text, max_cost_class: text) -> bool:")
        expect(ranks_cost_classes).to_equal(true)  # oracle: cost ranking is the structure that orders the pipeline a timed run executes
        expect(admits_by_cost).to_equal(true)  # oracle: cost admission is what bounds which passes a full pipeline run may include

# ============================================================================
# Memory Usage Benchmarks
# ============================================================================

describe "Memory benchmarks":
    it "measures instruction count reduction":
        # @req REQ-MIR-BENCH-017
        # @capture(statistics): the before/after instruction counters the memory benchmark reads
        step("Verify both the pass-level and engine-level removed-instruction counters exist")
        val dce = file_read("src/compiler/60.mir_opt/mir_opt/dce.spl")
        val engine = file_read("src/compiler/60.mir_opt/_OptimizationPasses/engine.spl")
        val pass_counts_removals = dce.contains("removed_instructions: i64")
        val engine_counts_dead_instrs = engine.contains("dead_instructions: i64")
        expect(pass_counts_removals).to_equal(true)  # oracle: the pass counter is the before/after delta the benchmark reports
        expect(engine_counts_dead_instrs).to_equal(true)  # oracle: the engine counter is the pipeline-wide cross-check

    it "measures basic block count reduction":
        # @req REQ-MIR-BENCH-018
        # @capture(statistics): the removed-block counter the block-reduction benchmark reads
        step("Verify DCE counts removed basic blocks for the benchmark")
        val dce = file_read("src/compiler/60.mir_opt/mir_opt/dce.spl")
        val counts_removed_blocks = dce.contains("removed_blocks: i64")
        expect(counts_removed_blocks).to_equal(true)  # oracle: the removed-block counter is the block-reduction metric

    it "measures local variable count reduction":
        # @req REQ-MIR-BENCH-019
        # @capture(statistics): the chain-root unification and algebraic counter behind local-count reduction
        step("Verify copy-chain unification and algebraic simplification reduce live locals")
        val copy_prop = file_read("src/compiler/60.mir_opt/mir_opt/copy_prop.spl")
        val engine = file_read("src/compiler/60.mir_opt/_OptimizationPasses/engine.spl")
        val unifies_to_chain_root = copy_prop.contains("fn copychain_get_root(chain: CopyChain, local: LocalId) -> LocalId:")
        val engine_counts_identity_removals = engine.contains("identity_eliminations: i64")
        expect(unifies_to_chain_root).to_equal(true)  # oracle: routing every chain member to one root local is what shrinks the local count
        expect(engine_counts_identity_removals).to_equal(true)  # oracle: identity eliminations are the algebraic share of local reduction

# ============================================================================
# Real-World Pattern Benchmarks
# ============================================================================

describe "Real-world pattern benchmarks":
    it "measures loop unrolling benefit":
        # @req REQ-MIR-BENCH-020
        # @capture(statistics): the loop unroller's threshold and counter in their shipped disabled state
        step("Verify the loop unroller surface exists and is recorded in its shipped disabled state")
        val loop_opt = file_read("src/compiler/60.mir_opt/mir_opt/loop_opt.spl")
        val has_unroller = loop_opt.contains("LoopUnroller(unroll_threshold: threshold, unrolled_count: 0)")
        val documents_disabled_transforms = loop_opt.contains("# LICM, unrolling, and strength reduction are disabled transforms. Their")
        expect(has_unroller).to_equal(true)  # oracle: the unroller with its pinned threshold is the surface any unroll benchmark would drive
        expect(documents_disabled_transforms).to_equal(true)  # oracle: the shipped state is disabled-by-design, so the benchmark must not claim live unroll wins

    it "measures constant folding benefit":
        # @req REQ-MIR-BENCH-021
        # @capture(statistics): the binop folder and its folded-constant counter
        step("Verify the engine folds binop constants and counts the folds")
        val engine = file_read("src/compiler/60.mir_opt/_OptimizationPasses/engine.spl")
        val folds_binop_constants = engine.contains("fn try_fold_binop(op: MirBinOp, left: MirOperand, right: MirOperand) -> MirConstValue?:")
        val counts_folded_constants = engine.contains("constants_folded: i64")
        expect(folds_binop_constants).to_equal(true)  # oracle: the binop folder is what collapses constant arithmetic at compile time
        expect(counts_folded_constants).to_equal(true)  # oracle: the folded-constant counter is the benchmark's metric

    it "measures strength reduction":
        # @req REQ-MIR-BENCH-022
        # @capture(statistics): the strength-reduction pass and its engine counter with the documented rewrite
        step("Verify the strength-reduction pass and the documented multiply-to-shift rewrite")
        val engine = file_read("src/compiler/60.mir_opt/_OptimizationPasses/engine.spl")
        val loop_strength = file_read("src/compiler/60.mir_opt/mir_opt/loop_strength.spl")
        val has_pass_constructor = loop_strength.contains("fn create_strength_reduction_pass() -> StrengthReduction:")
        val documents_rewrite = engine.contains("strength_reductions: i64        # x * 2 → x << 1")
        expect(has_pass_constructor).to_equal(true)  # oracle: the dedicated pass is the surface the strength benchmark measures
        expect(documents_rewrite).to_equal(true)  # oracle: the pinned multiply-to-shift rewrite is the transformation being counted

# ============================================================================
# Regression Benchmarks
# ============================================================================

describe "Optimization regression tests":
    it "verifies no infinite loops in optimization":
        # @req REQ-MIR-BENCH-023
        # @capture(statistics): the iteration caps in both DCE and inlining that forbid non-termination
        step("Verify DCE and inlining both carry bounded iteration guards")
        val dce = file_read("src/compiler/60.mir_opt/mir_opt/dce.spl")
        val inline = file_read("src/compiler/60.mir_opt/mir_opt/_Inline/driver.spl")
        val dce_counts_runs = dce.contains("self.iterations = self.iterations + 1")
        val inline_caps_at_fixed_point = inline.contains("3. Repeat until fixed point or max iterations")
        expect(dce_counts_runs).to_equal(true)  # oracle: a counted iteration loop is the DCE-side termination guard
        expect(inline_caps_at_fixed_point).to_equal(true)  # oracle: the fixed-point-or-max-iterations rule is the inlining-side termination guard

    it "verifies correctness preserved":
        # @req REQ-MIR-BENCH-024
        # @capture(statistics): the DCE translation validator and its semantic hash
        step("Verify the DCE translation validator compares semantic hashes")
        val dce_tv = file_read("src/compiler/60.mir_opt/mir_opt/dce_translation_validation.spl")
        val has_validator = dce_tv.contains("fn validate_dce_translation_v1(")
        val compares_semantic_hashes = dce_tv.contains("fn semantic_hash() -> text:")
        expect(has_validator).to_equal(true)  # oracle: the validator is the shipped correctness check on optimized output
        expect(compares_semantic_hashes).to_equal(true)  # oracle: semantic-hash comparison is the mechanism that pins optimized == unoptimized behaviour

    it "verifies no code blowup":
        # @req REQ-MIR-BENCH-025
        # @capture(statistics): the profitability gate that refuses unprofitable rewrites
        step("Verify the target profitability gate refuses code-size-increasing rewrites")
        val profitability = file_read("src/compiler/60.mir_opt/mir_opt/target_profitability.spl")
        val scores_rewrites = profitability.contains("pub fn profitability_score(family: InstructionFamily, features: TargetFeatureSet) -> i64:")
        val gates_on_score = profitability.contains("pub fn should_rewrite(score: i64) -> bool:")
        expect(scores_rewrites).to_equal(true)  # oracle: scoring each rewrite family is the size-blowup guard the regression benchmark reads
        expect(gates_on_score).to_equal(true)  # oracle: refusing below-threshold rewrites is what keeps optimized code from growing

# ============================================================================
# Exports
# ============================================================================

export describe, BenchmarkResult, calculate_reduction
