describe "native_file_worker_overlap_spec":
    it "module admitted when own HIR passes and deps records exist":
        var states: Dict<text, text> = {}
        states["module_a"] = "PASS"
        states["dep_x"] = "PASS"
        states["dep_y"] = "PASS"

        val ready = states.contains_key("module_a") and
                    states["module_a"] == "PASS" and
                    states.contains_key("dep_x") and
                    states.contains_key("dep_y")
        assert ready

    it "overlap reported when MIR starts before all HIR finishes":
        val obj_done_first: i64 = 100
        val hir_done_last: i64 = 150
        val overlap = obj_done_first < hir_done_last
        assert overlap

    it "time_to_first_object computed from build start":
        val build_start: i64 = 1000
        val first_obj_done: i64 = 1050
        val ttfo = first_obj_done - build_start
        assert ttfo == 50
