"""
## Purpose and audience
Purpose: Prove that compile option normalization.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-DRIVER-001 — stable requirement identity for this spec.

use std.spec
use compiler.common.driver_core_types.{CompileOptions, compileoptions_effective_mir_opt_level, compileoptions_normalize_mir_optimization}
use compiler.driver.cache.{compile_options_hash_compute}
use compiler.backend.target_presets.{preset_cortex_m4, preset_linux_x86_64, preset_apply_compile_options}

fn normalized_options(release: bool, optimize: bool, profile: text, opt_level: i64?) -> CompileOptions:
    var options = CompileOptions.default()
    options.release = release
    options.optimize = optimize
    options.profile = profile
    options.opt_level = opt_level
    compileoptions_normalize_mir_optimization(options)

describe "compile option normalization":
    it "keeps debug defaults at opt level zero":
        step("Verify: keeps debug defaults at opt level zero")
        # @req: REQ-COMPILER-DRIVER-001
        val options = normalized_options(false, false, "dev", nil)
        expect(options.release).to_equal(false)
        expect(options.optimize).to_equal(false)
        expect(options.opt_level).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(compileoptions_effective_mir_opt_level(options)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "normalizes release-only requests to the standard mir level":
        step("Verify: normalizes release-only requests to the standard mir level")
        val options = normalized_options(true, false, "prod", nil)
        expect(options.release).to_equal(true)
        expect(options.optimize).to_equal(true)
        expect(options.opt_level).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(compileoptions_effective_mir_opt_level(options)).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "normalizes optimize-only requests to the standard mir level":
        step("Verify: normalizes optimize-only requests to the standard mir level")
        val options = normalized_options(false, true, "dev", nil)
        expect(options.release).to_equal(true)
        expect(options.optimize).to_equal(true)
        expect(options.opt_level).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "preserves explicit aggressive opt levels":
        step("Verify: preserves explicit aggressive opt levels")
        val options = normalized_options(true, true, "prod", Some(3))
        expect(options.release).to_equal(true)
        expect(options.optimize).to_equal(true)
        expect(options.opt_level).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "preserves explicit basic opt levels":
        step("Verify: preserves explicit basic opt levels")
        val options = normalized_options(false, true, "dev", Some(1))
        expect(options.release).to_equal(true)
        expect(options.optimize).to_equal(true)
        expect(options.opt_level).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(compileoptions_effective_mir_opt_level(options)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "preserves explicit standard opt levels":
        step("Verify: preserves explicit standard opt levels")
        val options = normalized_options(true, true, "prod", Some(2))
        expect(options.release).to_equal(true)
        expect(options.optimize).to_equal(true)
        expect(options.opt_level).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(compileoptions_effective_mir_opt_level(options)).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "preserves explicit none while keeping release metadata intact":
        step("Verify: preserves explicit none while keeping release metadata intact")
        val options = normalized_options(true, false, "prod", Some(0))
        expect(options.release).to_equal(true)
        expect(options.optimize).to_equal(false)
        expect(options.opt_level).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "keeps hash-relevant effective opt levels unchanged across normalized release paths":
        step("Verify: keeps hash-relevant effective opt levels unchanged across normalized release paths")
        val legacy_release = normalized_options(true, false, "prod", nil)
        val explicit_standard = normalized_options(true, true, "prod", Some(2))
        val release_hash = compile_options_hash_compute(
            legacy_release.backend,
            legacy_release.opt_level ?? 0,
            legacy_release.release,
            legacy_release.debug_info,
            legacy_release.gc_off,
            legacy_release.profile,
            legacy_release.allowed_families
        )
        val explicit_hash = compile_options_hash_compute(
            explicit_standard.backend,
            explicit_standard.opt_level ?? 0,
            explicit_standard.release,
            explicit_standard.debug_info,
            explicit_standard.gc_off,
            explicit_standard.profile,
            explicit_standard.allowed_families
        )
        expect(release_hash.hash).to_equal(explicit_hash.hash)
        expect(release_hash.opt_level).to_equal(explicit_hash.opt_level)

    it "applies baremetal preset family restrictions to compile options":
        step("Verify: applies baremetal preset family restrictions to compile options")
        val options = preset_apply_compile_options(preset_cortex_m4(), CompileOptions.default())
        expect(options.gc_off).to_equal(true)
        expect(options.allowed_families.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(options.allowed_families[0]).to_equal("nogc_async_mut_noalloc")
        expect(options.allowed_families[1]).to_equal("common")

    it "keeps hosted preset compile options unrestricted":
        step("Verify: keeps hosted preset compile options unrestricted")
        val options = preset_apply_compile_options(preset_linux_x86_64(), CompileOptions.default())
        expect(options.gc_off).to_equal(false)
        expect(options.allowed_families.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
