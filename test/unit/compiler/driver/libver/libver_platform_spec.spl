"""
## Purpose and audience

As a linker or dylib loader, I ask libver for the platform-specific name of a
library on the current OS: the soname (ELF), install_name (Mach-O), or DLL file
name. This spec is the manual for those names (AC-13..AC-17).

## Operator workflow

Run: bin/simple test test/unit/compiler/driver/libver/libver_platform_spec.spl

## Verification guidance

Each platform test checks the exact soname, install_name, compatibility_version
and file extension according to the plan. On platforms where the real host is
unavailable, the spec is marked BLOCKED, not SKIPPED.
"""

# @manual_section: platform-specific library names

use compiler.driver.libver.naming.{
    LibPlatformNames,
    libver_platform_names
}
use std.spec.step

describe "Linux platform names":
    # @req AC-13
    it "Linux x86_64 uses so extension and ELF soname":
        step("Get platform names for x86_64-unknown-linux-gnu")
        val names = libver_platform_names("x86_64-unknown-linux-gnu", "mycrypto", 3, 1)
        expect(names.os).to_equal("linux")
        expect(names.ext).to_equal("so")
        expect(names.soname).to_equal("libmycrypto.so.3")
        expect(names.install_name).to_equal("")
        expect(names.compat_version).to_equal("")

    # @req AC-13
    it "Linux aarch64 uses so extension and ELF soname":
        step("Get platform names for aarch64-unknown-linux-gnu")
        val names = libver_platform_names("aarch64-unknown-linux-gnu", "mathlib", 2, 5)
        expect(names.os).to_equal("linux")
        expect(names.ext).to_equal("so")
        expect(names.soname).to_equal("libmathlib.so.2")

    # @req AC-13
    it "Linux riscv64 uses so extension and ELF soname":
        step("Get platform names for riscv64-unknown-linux-gnu")
        val names = libver_platform_names("riscv64-unknown-linux-gnu", "simdlib", 1, 0)
        expect(names.ext).to_equal("so")
        expect(names.soname).to_equal("libsimdlib.so.1")

describe "Windows platform names":
    # @req AC-14
    it "Windows x86_64 uses dll extension and dll soname":
        step("Get platform names for x86_64-pc-windows-gnu")
        val names = libver_platform_names("x86_64-pc-windows-gnu", "mycrypto", 2, 3)
        expect(names.os).to_equal("windows")
        expect(names.ext).to_equal("dll")
        expect(names.soname).to_equal("mycrypto-v2.dll")
        expect(names.install_name).to_equal("")
        expect(names.compat_version).to_equal("")

    # @req AC-14
    it "Windows aarch64 uses dll extension and dll soname":
        step("Get platform names for aarch64-pc-windows-gnu")
        val names = libver_platform_names("aarch64-pc-windows-gnu", "mathlib", 1, 4)
        expect(names.os).to_equal("windows")
        expect(names.ext).to_equal("dll")
        expect(names.soname).to_equal("mathlib-v1.dll")

describe "macOS platform names":
    # @req AC-15
    it "macOS x86_64 uses dylib extension and Mach-O install_name":
        step("Get platform names for x86_64-apple-darwin")
        val names = libver_platform_names("x86_64-apple-darwin", "mycrypto", 4, 2)
        expect(names.os).to_equal("macos")
        expect(names.ext).to_equal("dylib")
        expect(names.install_name).to_equal("@rpath/libmycrypto.4.dylib")
        expect(names.compat_version).to_equal("4.2.0")
        expect(names.soname).to_equal("")

    # @req AC-15
    it "macOS aarch64 uses dylib extension and Mach-O install_name":
        step("Get platform names for aarch64-apple-darwin")
        val names = libver_platform_names("aarch64-apple-darwin", "mathlib", 2, 7)
        expect(names.os).to_equal("macos")
        expect(names.ext).to_equal("dylib")
        expect(names.install_name).to_equal("@rpath/libmathlib.2.dylib")
        expect(names.compat_version).to_equal("2.7.0")

describe "FreeBSD platform names":
    # @req AC-16
    it "FreeBSD x86_64 uses so extension and ELF soname":
        step("Get platform names for x86_64-unknown-freebsd")
        val names = libver_platform_names("x86_64-unknown-freebsd", "mycrypto", 3, 1)
        expect(names.os).to_equal("freebsd")
        expect(names.ext).to_equal("so")
        expect(names.soname).to_equal("libmycrypto.so.3")
        expect(names.install_name).to_equal("")
        expect(names.compat_version).to_equal("")

    # @req AC-16
    it "FreeBSD aarch64 uses so extension and ELF soname":
        step("Get platform names for aarch64-unknown-freebsd")
        val names = libver_platform_names("aarch64-unknown-freebsd", "cryptolib", 2, 0)
        expect(names.ext).to_equal("so")
        expect(names.soname).to_equal("libcryptolib.so.2")

describe "SimpleOS platform names":
    # @req AC-17
    it "SimpleOS x86_64 uses so extension and ELF soname":
        step("Get platform names for x86_64-unknown-simpleos")
        val names = libver_platform_names("x86_64-unknown-simpleos", "mycrypto", 1, 5)
        expect(names.os).to_equal("simpleos")
        expect(names.ext).to_equal("so")
        expect(names.soname).to_equal("libmycrypto.so.1")
        expect(names.install_name).to_equal("")
        expect(names.compat_version).to_equal("")

    # @req AC-17
    it "SimpleOS aarch64 uses so extension and ELF soname":
        step("Get platform names for aarch64-unknown-simpleos")
        val names = libver_platform_names("aarch64-unknown-simpleos", "mathlib", 2, 3)
        expect(names.ext).to_equal("so")
        expect(names.soname).to_equal("libmathlib.so.2")

    # @req AC-17
    it "SimpleOS riscv64 uses so extension and ELF soname":
        step("Get platform names for riscv64-unknown-simpleos")
        val names = libver_platform_names("riscv64-unknown-simpleos", "kernellib", 1, 0)
        expect(names.ext).to_equal("so")
        expect(names.soname).to_equal("libkernellib.so.1")
