"""
## Purpose and audience

As a release engineer, I rely on config/build/lib_versioning.sdn to say how
versioned libraries are named, where their sidecars live, how long an old
ABI stays accepted and where they are installed. This spec is the manual
for that sub-config (AC-1).

## Operator workflow

Run: bin/simple test test/unit/compiler/driver/libver/libver_config_spec.spl

## Verification guidance

A failure names the missing key; restore it in the sub-config rather than
weakening the expectation.
"""

# @manual_section: library versioning sub-config

use std.io_runtime.{file_read}
use std.spec.step

fn config_text() -> text:
    file_read("config/build/lib_versioning.sdn")

fn has_key(src: text, key: text) -> bool:
    for line in src.split("\n"):
        if line.trim().starts_with(key + ":"):
            return true
    false

describe "The lib-versioning sub-config":
    # @req AC-1
    it "declares the three artifact naming patterns":
        step("Read the sub-config and look for each naming key")
        val src = config_text()
        expect(has_key(src, "stdlib_naming")).to_equal(true)
        expect(has_key(src, "backend_naming")).to_equal(true)
        expect(has_key(src, "tier_dylib_naming")).to_equal(true)

    # @req AC-1
    it "declares the sidecar suffix, ABI window and install root":
        val src = config_text()
        expect(has_key(src, "sidecar_suffix")).to_equal(true)
        expect(has_key(src, "abi_window")).to_equal(true)
        expect(has_key(src, "deprecated_abi")).to_equal(true)
        expect(has_key(src, "install_root")).to_equal(true)

    # @req AC-1
    it "keeps the ABI support window at one major version":
        expect(config_text().contains("abi_window: 1")).to_equal(true)

    # @req AC-1
    it "a missing key is detected rather than assumed":
        step("Probe the key checker with text lacking install_root")
        expect(has_key("abi_window: 1\n", "install_root")).to_equal(false)
