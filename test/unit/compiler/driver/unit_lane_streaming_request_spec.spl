use std.spec.*
use app.io.env_ops.{env_get, env_set}
use compiler.driver.driver_phase_gates.{driver_streaming_surface_enabled}
use compiler.driver.driver_types.{CompileContext}
use compiler.common.driver_core_types.{CompileOptions, CompileMode}

describe("unit_lane_streaming_request"):
    it("streaming enabled when native file worker unit is active"):
        step("save SIMPLE_FILE_WORKER_UNIT env var")
        val saved_worker_unit = env_get("SIMPLE_FILE_WORKER_UNIT") ?? ""

        step("set SIMPLE_FILE_WORKER_UNIT=1")
        env_set("SIMPLE_FILE_WORKER_UNIT", "1")

        step("create minimal compile context")
        val options = CompileOptions(
            mode: CompileMode.Check,
            backend: "sif",
            emit_code: false,
            native_file_worker_unit: true,
            bootstrap_input_count: 0,
            bootstrap_input_0: "",
            bootstrap_input_1: "",
            bootstrap_input_2: "",
            bootstrap_input_3: "",
            bootstrap_input_4: "",
            bootstrap_input_5: "",
            bootstrap_input_6: "",
            cli_mode_text: "check",
            lowmem_spec_memory_trigger_gb: 0,
            low_memory: false
        )
        val ctx = CompileContext(
            options: options,
            sources: [],
            config: {}
        )

        step("verify driver_streaming_surface_enabled returns true")
        assert_true(driver_streaming_surface_enabled(ctx), "expected streaming surface to be enabled when file worker unit is active")

        step("restore SIMPLE_FILE_WORKER_UNIT env var")
        env_set("SIMPLE_FILE_WORKER_UNIT", saved_worker_unit)

    it("streaming disabled by default without env var"):
        step("save and clear SIMPLE_FILE_WORKER_UNIT env var")
        val saved_worker_unit = env_get("SIMPLE_FILE_WORKER_UNIT") ?? ""
        env_set("SIMPLE_FILE_WORKER_UNIT", "")

        step("create minimal compile context")
        val options = CompileOptions(
            mode: CompileMode.Check,
            backend: "sif",
            emit_code: false,
            native_file_worker_unit: false,
            bootstrap_input_count: 0,
            bootstrap_input_0: "",
            bootstrap_input_1: "",
            bootstrap_input_2: "",
            bootstrap_input_3: "",
            bootstrap_input_4: "",
            bootstrap_input_5: "",
            bootstrap_input_6: "",
            cli_mode_text: "check",
            lowmem_spec_memory_trigger_gb: 0,
            low_memory: false
        )
        val ctx = CompileContext(
            options: options,
            sources: [],
            config: {}
        )

        step("verify driver_streaming_surface_enabled returns false")
        assert_false(driver_streaming_surface_enabled(ctx), "expected streaming surface to be disabled by default")

        step("restore SIMPLE_FILE_WORKER_UNIT env var")
        env_set("SIMPLE_FILE_WORKER_UNIT", saved_worker_unit)
