# Lint String Utilities Specification
#
# Covers the shared text-search helpers used by multiple security lint
# modules (SQL injection, SSRF, raw-HTML, insecure-comparison): `is_ident_char`
# was previously copy-pasted verbatim into each of those modules; this spec
# locks down its behavior now that it lives in one place.

use std.spec.*
use compiler.semantics.lint.lint_string_utils.{find_substring, is_ident_char}

describe "is_ident_char":
    it "accepts lowercase letters":
        expect(is_ident_char("a")).to_be_true()
        expect(is_ident_char("z")).to_be_true()

    it "accepts uppercase letters":
        expect(is_ident_char("A")).to_be_true()
        expect(is_ident_char("Z")).to_be_true()

    it "accepts digits":
        expect(is_ident_char("0")).to_be_true()
        expect(is_ident_char("9")).to_be_true()

    it "accepts underscore":
        expect(is_ident_char("_")).to_be_true()

    it "rejects punctuation and whitespace":
        expect(is_ident_char(".")).to_be_false()
        expect(is_ident_char(" ")).to_be_false()
        expect(is_ident_char("(")).to_be_false()

    it "rejects multi-character input":
        expect(is_ident_char("ab")).to_be_false()

describe "find_substring":
    it "finds the first occurrence":
        expect(find_substring("hello world", "world")).to_equal(6)

    it "returns -1 when not found":
        expect(find_substring("hello", "xyz")).to_equal(-1)

    it "returns 0 for an empty needle":
        expect(find_substring("hello", "")).to_equal(0)
