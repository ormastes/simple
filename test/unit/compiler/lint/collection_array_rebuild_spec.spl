# COLL007: array rebuild to pop last element (arr = arr[0:arr.len()-1]).
#
# The rule's own header comment and the bug report that flagged it as
# "never fires" both wrote the fixture with `..` (arr[0..arr.len()-1]).
# That is not valid Simple slice syntax: `..` always builds an EXPR_RANGE
# value, so `arr[a..b]` parses as EXPR_INDEX(base, EXPR_RANGE(...)), which
# errors on evaluation (there is no Range-index case in eval_index_expr /
# cg_index_expr). Only the colon form (`arr[a:b]`, see the language's
# slicing quick reference) parses to EXPR_SLICE, which is what this rule
# actually matches. These examples pin: the colon form fires, a different
# assignment target stays silent, the already-fixed `.pop()` form stays
# silent, and the invalid `..` form correctly never fires (it is not
# runnable code, so warning on it would be worse than useless).
use std.spec.*
use compiler.tools.lint.main.{Linter, lint_cli_source}

val OPEN_SRC = "fn drain(ys: [i64]) -> [i64]:\n    var arr = ys\n    while arr.len() > 0:\n        arr = arr[:-1]\n    arr\n"
val FULL_SRC = "fn drain2(ys: [i64]) -> [i64]:\n    var arr = ys\n    while arr.len() > 0:\n        arr = arr[0:arr.len()-1]\n    arr\n"
val OTHER_VAR_SRC = "fn drain3(ys: [i64], other: [i64]) -> [i64]:\n    var arr = ys\n    while arr.len() > 0:\n        arr = other[0:other.len()-1]\n    arr\n"
val ALREADY_FIXED_SRC = "fn drain4(ys: [i64]) -> [i64]:\n    var arr = ys\n    while arr.len() > 0:\n        arr.pop()\n    arr\n"
val DOTDOT_SRC = "fn drain5(ys: [i64]) -> [i64]:\n    var arr = ys\n    while arr.len() > 0:\n        arr = arr[0..arr.len()-1]\n    arr\n"

fn coll007_count(path: text, src: text) -> i64:
    var count = 0
    for result in lint_cli_source(Linter.new(), path, src):
        if result.lint.code == "COLL007":
            count = count + 1
    count

describe "COLL007 array rebuild to pop last":

    it "flags the colon open-ended slice form arr = arr[:-1]":
        step("Lint a loop that rebinds arr from an open-ended slice of itself")
        expect(coll007_count("/tmp/coll007_open.spl", OPEN_SRC)).to_equal(1)

    it "flags the colon explicit slice form arr = arr[0:arr.len()-1]":
        step("Lint a loop that rebinds arr from an explicit slice of itself")
        expect(coll007_count("/tmp/coll007_full.spl", FULL_SRC)).to_equal(1)

    it "stays silent when the slice receiver is a different variable":
        """`arr = other[0:other.len()-1]` does not rebuild `arr` from
        itself — flagging it would blame the wrong variable."""
        step("Lint a loop that assigns a slice of a DIFFERENT array into arr")
        expect(coll007_count("/tmp/coll007_other.spl", OTHER_VAR_SRC)).to_equal(0)

    it "stays silent on the already-fixed .pop() form":
        step("Lint a loop that already uses .pop() instead of rebuilding")
        expect(coll007_count("/tmp/coll007_fixed.spl", ALREADY_FIXED_SRC)).to_equal(0)

    it "stays silent on the invalid arr[0..arr.len()-1] range-index form":
        """`..` builds a Range value, not a slice; indexing an array by a
        Range errors at runtime. This is not runnable code, so the rule
        must not warn on it — matching it would train people to write
        code that cannot execute."""
        step("Lint a loop written with the non-slicing `..` range operator")
        expect(coll007_count("/tmp/coll007_dotdot.spl", DOTDOT_SRC)).to_equal(0)
