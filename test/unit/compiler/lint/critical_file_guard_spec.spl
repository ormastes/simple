"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/lint/critical_file_guard_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec.{describe, it, expect, step}
use std.io_runtime.{read_file, file_exists}

describe "Critical file guard lint":
    it "config/critical_files.sdn exists":
        # @req: REQ-UNIT-COMPILER-001
        step("Verify: config/critical_files.sdn exists")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(file_exists("config/critical_files.sdn")).to_equal(true)

    it "config has entries section":
        # @req: REQ-UNIT-COMPILER-002
        step("Verify: config has entries section")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val content = read_file("config/critical_files.sdn")
        expect(content.contains("entries:")).to_equal(true)

    it "config protects star_import.spl":
        # @req: REQ-UNIT-COMPILER-003
        step("Verify: config protects star_import.spl")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val content = read_file("config/critical_files.sdn")
        expect(content.contains("src/compiler/35.semantics/lint/star_import.spl")).to_equal(true)

    it "config protects error.spl":
        # @req: REQ-UNIT-COMPILER-004
        step("Verify: config protects error.spl")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val content = read_file("config/critical_files.sdn")
        expect(content.contains("src/compiler/00.common/error.spl")).to_equal(true)

    it "config protects itself":
        # @req: REQ-UNIT-COMPILER-005
        step("Verify: config protects itself")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val content = read_file("config/critical_files.sdn")
        expect(content.contains("config/critical_files.sdn")).to_equal(true)

    it "guard module has CFG001 deletion check":
        # @req: REQ-UNIT-COMPILER-006
        step("Verify: guard module has CFG001 deletion check")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("src/compiler/35.semantics/lint/critical_file_guard.spl")
        expect(source.contains("\"CFG001\"")).to_equal(true)
        expect(source.contains("critical file deleted")).to_equal(true)

    it "guard module has CFG002 shrinkage check":
        # @req: REQ-UNIT-COMPILER-007
        step("Verify: guard module has CFG002 shrinkage check")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("src/compiler/35.semantics/lint/critical_file_guard.spl")
        expect(source.contains("\"CFG002\"")).to_equal(true)
        expect(source.contains("shrunk below")).to_equal(true)

    it "guard is registered in __init__.spl":
        # @req: REQ-UNIT-COMPILER-008
        step("Verify: guard is registered in __init__.spl")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("src/compiler/35.semantics/lint/__init__.spl")
        expect(source.contains("export critical_file_guard.*")).to_equal(true)

    it "guard is integrated in query_lint.spl":
        # @req: REQ-UNIT-COMPILER-009
        step("Verify: guard is integrated in query_lint.spl")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("src/app/cli/query_lint.spl")
        expect(source.contains("check_all_critical_files")).to_equal(true)
