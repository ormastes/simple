# Canonical Primitive-Type Table Parity Specification
#
# Guards the single source of truth for the primitive_api lint family:
# compiler.semantics.lint.primitive_types. Asserts the canonical list matches
# the expected set (i8..i64, u8..u64, f32, f64, bool) — the same set as the
# Rust seed's PRIMITIVE_TYPES in src/compiler_rust/compiler/src/lint/rules.rs —
# so future drift (especially dropping bool again) fails tests.

use std.spec.*
use compiler.semantics.lint.primitive_types.{bare_primitive_types, is_bare_primitive_name}
use compiler.tools.fix.rules.impl_.lint_primitive_api.{primitive_api_types}


describe "canonical primitive type table":
    context "expected set parity (mirrors Rust seed rules.rs PRIMITIVE_TYPES)":
        it "matches the expected 11-entry set exactly":
            val expected = ["i8", "i16", "i32", "i64",
                            "u8", "u16", "u32", "u64",
                            "f32", "f64", "bool"]
            val canonical = bare_primitive_types()
            expect(canonical.len()).to_equal(11)
            var i = 0
            while i < expected.len():
                expect(canonical[i]).to_equal(expected[i])
                i = i + 1

        it "includes bool":
            expect(is_bare_primitive_name("bool")).to_equal(true)

        it "rejects non-primitives and text types":
            expect(is_bare_primitive_name("text")).to_equal(false)
            expect(is_bare_primitive_name("str")).to_equal(false)
            expect(is_bare_primitive_name("MyType")).to_equal(false)
            expect(is_bare_primitive_name("")).to_equal(false)

    context "consumer parity":
        it "fix-rule primitive_api_types() equals the canonical table":
            val ts = primitive_api_types()
            val canonical = bare_primitive_types()
            expect(ts.len()).to_equal(canonical.len())
            var i = 0
            while i < ts.len():
                expect(ts[i]).to_equal(canonical[i])
                i = i + 1
