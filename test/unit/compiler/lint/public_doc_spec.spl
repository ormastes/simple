"""
## Purpose and audience

# Public Documentation Lint Specification

**Feature IDs:** #PDOC-001 through #PDOC-005
**Category:** Tooling / Lint
**Status:** PDOC001 fully tested; PDOC002-005 implemented, require compiled mode
**Requirements:** doc/requirement/doc_ref_lint.md

## Interpreter Limitation

PDOC002-005 use pdoc_extract_refs which calls pdoc_index_of internally.
The interpreter has a bug where .find() returns an Option/enum type that
cannot be compared or used in arithmetic in nested scopes. pdoc_index_of
works around this but the ref extraction still fails when called from
inside while loops in the interpreter. These rules work in compiled mode.

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/lint/public_doc_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use compiler.semantics.lint.public_doc.{check_public_doc, PublicDocWarning}
use std.spec.{step}

fn count_by_code(warnings: [PublicDocWarning], code: text) -> i64:
    var n = 0
    for w in warnings:
        if w.code == code:
            n = n + 1
    n

# ============================================================================
# PDOC001: Missing sdoctest — fully tested in interpreter mode
# ============================================================================

describe "PDOC001":
    it "warns on fn without sdoctest":
        # @req: REQ-UNIT-COMPILER-001
        step("Verify: warns on fn without sdoctest")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "fn helper(x: i64) -> i64:\n    x + 1\n"
        val warnings = check_public_doc(source)
        expect(count_by_code(warnings, "PDOC001")).to_be_greater_than(0)

    it "no warning with sdoctest":
        # @req: REQ-UNIT-COMPILER-002
        step("Verify: no warning with sdoctest")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "\"\"\"\nsdoctest:\n    expect(1).to_equal(1)\n\"\"\"\nfn square(x: i64) -> i64:\n    x * x\n"
        val warnings = check_public_doc(source)
        expect(count_by_code(warnings, "PDOC001")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "no warning with @sdoctest delegation":
        # @req: REQ-UNIT-COMPILER-003
        step("Verify: no warning with @sdoctest delegation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "\"\"\"\nsdoctest:\n    expect(foo(1)).to_equal(2)\n\"\"\"\nfn foo(x: i64) -> i64:\n    x * 2\n\n\"\"\"\n@sdoctest(foo)\n\"\"\"\nfn bar(x: i64) -> i64:\n    foo(x)\n"
        val warnings = check_public_doc(source)
        # bar has @sdoctest(foo), foo has sdoctest — neither should warn
        # (foo has sdoctest, bar has @sdoctest)
        expect(count_by_code(warnings, "PDOC001")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "skips extern fn":
        # @req: REQ-UNIT-COMPILER-004
        step("Verify: skips extern fn")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "extern fn rt_read(path: text) -> text\n"
        val warnings = check_public_doc(source)
        expect(count_by_code(warnings, "PDOC001")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "skips _private":
        # @req: REQ-UNIT-COMPILER-005
        step("Verify: skips _private")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "fn _helper(x: i64) -> i64:\n    x + 1\n"
        val warnings = check_public_doc(source)
        expect(count_by_code(warnings, "PDOC001")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "skips marker function":
        # @req: REQ-UNIT-COMPILER-006
        step("Verify: skips marker function")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "fn future_work(x: i64) -> i64:\n    " + "pass_" + "todo\n"
        val warnings = check_public_doc(source)
        expect(count_by_code(warnings, "PDOC001")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "warns on class":
        # @req: REQ-UNIT-COMPILER-007
        step("Verify: warns on class")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "class Parser:\n    input: text\n"
        val warnings = check_public_doc(source)
        expect(count_by_code(warnings, "PDOC001")).to_be_greater_than(0)

    it "handles empty source":
        # @req: REQ-UNIT-COMPILER-008
        step("Verify: handles empty source")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val warnings = check_public_doc("")
        expect(warnings.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "struct and enum no PDOC001":
        # @req: REQ-UNIT-COMPILER-009
        step("Verify: struct and enum no PDOC001")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = "struct Point:\n    x: i64\n\nenum Color:\n    Red\n"
        val warnings = check_public_doc(source)
        expect(count_by_code(warnings, "PDOC001")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
