# COLL015/016/020/021/022 — dataframe-able collection patterns.
#
# doc/05_design/compiler/collection_planner/adaptive_collections_typed_query_design.md
# section 10.3. Every dirty fixture below must fire its code; every paired
# clean fixture must stay silent. Messages must name the std.common.frame
# call, the inline Dict form, and say "dataframe-able" (per section 10.3's
# message-form contract). Only COLL020 (and COLL002, covered in
# collection_easy_fix_spec.spl) get a machine-applicable fix in this lane;
# COLL015/016/021/022 are advisory-only and must never attach an easy_fix.
use std.spec.*
use compiler.tools.lint.main.{Linter, lint_cli_source}

fn results_for(path: text, src: text) -> [text]:
    var codes: [text] = []
    for result in lint_cli_source(Linter.new(), path, src):
        codes.push(result.lint.code)
    codes

fn has(codes: [text], code: text) -> bool:
    for c in codes:
        if c == code:
            return true
    false

fn message_for(path: text, src: text, code: text) -> text:
    for result in lint_cli_source(Linter.new(), path, src):
        if result.lint.code == code:
            return result.lint.message
    ""

fn position_for(path: text, src: text, code: text) -> (i64, i64):
    for result in lint_cli_source(Linter.new(), path, src):
        if result.lint.code == code:
            return (result.line, result.column)
    (-1, -1)

fn easy_fix_present(path: text, src: text, code: text) -> bool:
    for result in lint_cli_source(Linter.new(), path, src):
        if result.lint.code == code:
            match result.lint.easy_fix:
                case Some(_): return true
                case nil: val _ = 0
    false

describe "COLL015 accidental_cartesian_product":
    # @manual scenario evidence

    it "fires on nested loops compared by == across both loop variables":
        step("fires on nested loops compared by == across both loop variables")
        val src = "fn join_naive(as_: [i64], bs: [i64]) -> [i64]:\n    var out: [i64] = []\n    for a in as_:\n        for b in bs:\n            if a == b:\n                out.push(a)\n    out\n"
        expect(has(results_for("/tmp/coll015_dirty.spl", src), "COLL015")).to_equal(true)
        val msg = message_for("/tmp/coll015_dirty.spl", src, "COLL015")
        expect(msg).to_contain("semi_join")
        expect(msg).to_contain("std.common.frame")
        expect(msg).to_contain("dataframe-able")
        expect(msg).to_contain("Dict")
        expect(easy_fix_present("/tmp/coll015_dirty.spl", src, "COLL015")).to_equal(false)

    it "stays silent when the inner comparison never mentions the inner loop variable":
        step("stays silent when the inner comparison never mentions the inner loop variable")
        val src = "fn no_join(as_: [i64], bs: [i64]) -> [i64]:\n    var out: [i64] = []\n    for a in as_:\n        for b in bs:\n            if a == 0:\n                out.push(b)\n    out\n"
        expect(has(results_for("/tmp/coll015_clean.spl", src), "COLL015")).to_equal(false)

describe "COLL016 missing_index":
    it "fires on .find() inside a loop whose predicate mentions the outer loop variable":
        step("fires on .find() inside a loop whose predicate mentions the outer loop variable")
        val src = "fn lookup_slow(orders: [i64], users: [i64]) -> [i64]:\n    var out: [i64] = []\n    for o in orders:\n        val hit = users.find(\\u: u == o)\n        out.push(hit)\n    out\n"
        expect(has(results_for("/tmp/coll016_dirty.spl", src), "COLL016")).to_equal(true)
        val msg = message_for("/tmp/coll016_dirty.spl", src, "COLL016")
        expect(msg).to_contain("index_by")
        expect(msg).to_contain("std.common.frame")
        expect(msg).to_contain("dataframe-able")
        expect(msg).to_contain("Dict")
        expect(easy_fix_present("/tmp/coll016_dirty.spl", src, "COLL016")).to_equal(false)

    it "stays silent when the predicate never mentions the outer loop variable":
        step("stays silent when the predicate never mentions the outer loop variable")
        val src = "fn lookup_fast(orders: [i64], users: [i64]) -> [i64]:\n    var out: [i64] = []\n    for o in orders:\n        val hit = users.find(\\u: u == 0)\n        out.push(hit)\n    out\n"
        expect(has(results_for("/tmp/coll016_clean.spl", src), "COLL016")).to_equal(false)

describe "COLL020 manual_distinct":
    it "fires on a growing array used as its own contains-guarded seen-set":
        step("fires on a growing array used as its own contains-guarded seen-set")
        val src = "fn distinct_slow(xs: [i64]) -> [i64]:\n    var result: [i64] = []\n    for x in xs:\n        if not result.contains(x):\n            result.push(x)\n    result\n"
        expect(has(results_for("/tmp/coll020_dirty.spl", src), "COLL020")).to_equal(true)
        val msg = message_for("/tmp/coll020_dirty.spl", src, "COLL020")
        expect(msg).to_contain("distinct_by")
        expect(msg).to_contain("std.common.frame")
        expect(msg).to_contain("dataframe-able")
        expect(msg).to_contain("Dict")

    it "fires on the two-array seen/result shape":
        step("fires on the two-array seen/result shape")
        """WAS: "stays silent ... (documented scope limit)", justified as
        needing alias analysis this AST walker lacks. That was not a scope
        limit, it was a lint/fix disagreement: `collection_020_fix` is textual
        and never consulted this detector, so `simple fix --dry-run` reported
        this exact shape as a Certain fix and rewrote it while `simple lint`
        printed "all files clean". No alias analysis was needed — the shape is
        "pushes of the value the guard tested" — and the Certain fix now goes
        through `collection_certain_fixes`, which requires this detector to
        fire first. See doc/08_tracking/bug/
        coll020_lint_fix_disagree_two_array_dedup_2026-09-19.md."""
        val src = "fn distinct_two_array(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    var result: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n            result.push(x)\n    result\n"
        expect(has(results_for("/tmp/coll020_two_array.spl", src), "COLL020")).to_equal(true)

    it "stays silent when the guarded value and the pushed value differ":
        step("stays silent when the guarded value and the pushed value differ")
        """`seen.contains(x)` guarding `seen.push(y)` is not dedup — nothing
        keeps `seen` in step with what was tested, so neither the warning nor
        the membership-Dict rewrite would be true of it."""
        val src = "fn not_distinct(xs: [i64], ys: [i64]) -> [i64]:\n    var seen: [i64] = []\n    for i in 0..xs.len():\n        val x = xs[i]\n        val y = ys[i]\n        if not seen.contains(x):\n            seen.push(y)\n    seen\n"
        expect(has(results_for("/tmp/coll020_diffkey.spl", src), "COLL020")).to_equal(false)

    it "stays silent when the guard body does more than push the guarded value":
        step("stays silent when the guard body does more than push the guarded value")
        """An early `break` (or any non-push statement) inside the guard makes
        the loop something other than a dedup pass over the whole input."""
        val src = "fn first_new(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n            break\n    seen\n"
        expect(has(results_for("/tmp/coll020_break.spl", src), "COLL020")).to_equal(false)

describe "COLL021 manual_group":
    it "fires on a keys-array slot scan followed by a negative-index guard":
        step("fires on a keys-array slot scan followed by a negative-index guard")
        val src = "fn group_slow(rows: [i64], keys: [i64]) -> [i64]:\n    var out: [i64] = []\n    for row in rows:\n        var idx: i64 = -1\n        for j in 0..keys.len():\n            if keys[j] == row:\n                idx = j\n        if idx < 0:\n            keys.push(row)\n        out.push(idx)\n    out\n"
        expect(has(results_for("/tmp/coll021_dirty.spl", src), "COLL021")).to_equal(true)
        val msg = message_for("/tmp/coll021_dirty.spl", src, "COLL021")
        expect(msg).to_contain("group_by_key")
        expect(msg).to_contain("std.common.frame")
        expect(msg).to_contain("dataframe-able")
        expect(msg).to_contain("Dict")
        expect(easy_fix_present("/tmp/coll021_dirty.spl", src, "COLL021")).to_equal(false)

    it "stays silent when the slot scan has no negative-index guard afterward":
        step("stays silent when the slot scan has no negative-index guard afterward")
        val src = "fn group_no_guard(rows: [i64], keys: [i64]) -> [i64]:\n    var out: [i64] = []\n    for row in rows:\n        var idx: i64 = -1\n        for j in 0..keys.len():\n            if keys[j] == row:\n                idx = j\n        out.push(idx)\n    out\n"
        expect(has(results_for("/tmp/coll021_clean.spl", src), "COLL021")).to_equal(false)

describe "COLL022 sort_then_take":
    it "fires on .sort().take(k)":
        step("fires on .sort().take(k)")
        val src = "fn top_slow(xs: [i64]) -> [i64]:\n    val top3 = xs.sort().take(3)\n    top3\n"
        expect(has(results_for("/tmp/coll022_dirty.spl", src), "COLL022")).to_equal(true)
        val msg = message_for("/tmp/coll022_dirty.spl", src, "COLL022")
        expect(msg).to_contain("top_k_by")
        expect(msg).to_contain("std.common.frame")
        expect(msg).to_contain("dataframe-able")
        expect(easy_fix_present("/tmp/coll022_dirty.spl", src, "COLL022")).to_equal(false)

    it "fires on .sort()[0:k]":
        step("fires on .sort()[0:k]")
        val src = "fn top_slow_slice(xs: [i64]) -> [i64]:\n    val top3 = xs.sort()[0:3]\n    top3\n"
        expect(has(results_for("/tmp/coll022_dirty_slice.spl", src), "COLL022")).to_equal(true)

    it "stays silent on .take(k) without a preceding sort":
        step("stays silent on .take(k) without a preceding sort")
        val src = "fn top_fast(xs: [i64]) -> [i64]:\n    val top3 = xs.take(3)\n    top3\n"
        expect(has(results_for("/tmp/coll022_clean.spl", src), "COLL022")).to_equal(false)

    it "fires when the sort result is bound to a val first, then taken":
        step("fires when the sort result is bound to a val first, then taken")
        """Gap: the rule only saw the chained form. `val sorted =
        xs.sort_by(..)` on one line and `sorted.take(3)` on the next is the
        same computation and the shape people actually write once the
        comparator is more than a word long — it was silent."""
        val src = "fn top_bound(xs: [i64]) -> [i64]:\n    val sorted = xs.sort_by(fn(a, b) -> i64: b - a)\n    sorted.take(3)\n"
        expect(has(results_for("/tmp/coll022_bound.spl", src), "COLL022")).to_equal(true)

    it "fires when the bound sort result is sliced instead of taken":
        step("fires when the bound sort result is sliced instead of taken")
        val src = "fn low_bound(xs: [i64]) -> [i64]:\n    val sorted = xs.sort()\n    sorted[0:3]\n"
        expect(has(results_for("/tmp/coll022_bound_slice.spl", src), "COLL022")).to_equal(true)

    it "stays silent when the bound sort result is also used for something else":
        step("stays silent when the bound sort result is also used for something else")
        """The whole sorted array is load-bearing here, so `top_k_by` is NOT
        an equivalent rewrite and the advice would be wrong. This is the
        false-positive the bound-value form has to avoid to be worth having."""
        val src = "fn top_and_count(xs: [i64]) -> [i64]:\n    val sorted = xs.sort()\n    val n = sorted.len()\n    sorted[0:3]\n"
        expect(has(results_for("/tmp/coll022_bound_reused.spl", src), "COLL022")).to_equal(false)

    it "stays silent when an interpolation hole could be using the sort result":
        step("stays silent when an interpolation hole could be using the sort result")
        """A `"{...}"` hole is a plain EXPR_STRING_LIT with no child
        expressions at this stage (measured), so a use inside one is
        unrecoverable from this AST — treated as an unknown use and left
        silent rather than advised wrongly. The fixture builds the braces by
        concatenation because a literal `{` in this spec's own source would
        be interpolated here instead of reaching the linter."""
        val hole = "{" + "sorted.len()" + "}"
        val src = "fn top_and_label(xs: [i64]) -> [i64]:\n    val sorted = xs.sort()\n    val label = \"" + hole + "\"\n    sorted[0:3]\n"
        expect(has(results_for("/tmp/coll022_bound_interp.spl", src), "COLL022")).to_equal(false)

    it "stays silent when the bound sort result is never taken or sliced":
        step("stays silent when the bound sort result is never taken or sliced")
        val src = "fn all_sorted(xs: [i64]) -> [i64]:\n    val sorted = xs.sort()\n    sorted\n"
        expect(has(results_for("/tmp/coll022_bound_whole.spl", src), "COLL022")).to_equal(false)

describe "COLL diagnostics carry a real source position":
    # Every COLL finding used to be reported at `<file>:1:0` — the enclosing
    # function's declaration line (line 1 for a single-function file) with the
    # column literally always 0. Positions now come from the offending AST
    # node's span. Asserted for two rules on two different anchor kinds:
    # COLL020 anchors on the guard `if` statement, COLL022 on the sort call.
    it "COLL020 points at the guard line, not line 1 column 0":
        step("COLL020 points at the guard line, not line 1 column 0")
        val src = "fn head(xs: [i64]) -> i64:\n    xs.len()\n\nfn distinct_two_array(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    var result: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n            result.push(x)\n    result\n"
        val pos = position_for("/tmp/coll020_pos.spl", src, "COLL020")
        expect(pos.0).to_equal(8)
        expect(pos.1).to_equal(9)

    it "COLL022 points at the sort line, not line 1 column 0":
        step("COLL022 points at the sort line, not line 1 column 0")
        val src = "fn head(xs: [i64]) -> i64:\n    xs.len()\n\nfn top_bound(xs: [i64]) -> [i64]:\n    val sorted = xs.sort()\n    sorted.take(3)\n"
        val pos = position_for("/tmp/coll022_pos.spl", src, "COLL022")
        expect(pos.0).to_equal(5)
        expect(pos.1 > 0).to_equal(true)

    it "COLL015 points at the offending == comparison":
        step("COLL015 points at the offending == comparison")
        val src = "fn join_naive(as_: [i64], bs: [i64]) -> [i64]:\n    var out: [i64] = []\n    for a in as_:\n        for b in bs:\n            if a == b:\n                out.push(a)\n    out\n"
        val pos = position_for("/tmp/coll015_pos.spl", src, "COLL015")
        expect(pos.0).to_equal(5)
        expect(pos.1 > 0).to_equal(true)

# ---------------------------------------------------------------------------
# What the rules SEE, which is a different question from what the fix may
# rewrite. Measured over the tree: 26 of 68 real dedup sites got NO diagnostic
# at all, because both rules only matched a guard whose value was a bare
# identifier and the negated-filter form was silent. A warning that is never
# emitted is the expensive miss; a fix that declines to apply is not.
# Record: doc/08_tracking/bug/
# coll020_detector_blind_to_non_identifier_guarded_value_2026-09-19.md
# ---------------------------------------------------------------------------

fn count_of(path: text, src: text, code: text) -> i64:
    var n = 0
    for result in lint_cli_source(Linter.new(), path, src):
        if result.lint.code == code:
            n = n + 1
    n

describe "the guarded value may be any expression, not just an identifier":
    it "COLL020 sees a dedup keyed on a FIELD ACCESS":
        step("COLL020 sees a dedup keyed on a FIELD ACCESS")
        """`seen.contains(dep.path)` / `seen.push(dep.path)` is the single
        most common real shape in the tree and produced nothing at all. The
        two values are now compared structurally rather than by identifier
        name."""
        val field = "struct Dep:\n    path: text\n\nfn uniq(deps: [Dep]) -> [text]:\n    val seen: [text] = []\n    for dep in deps:\n        if not seen.contains(dep.path):\n            seen.push(dep.path)\n    return seen\n"
        assert_true(has(results_for("/tmp/coll_field.spl", field), "COLL020"))

    it "COLL020 sees a dedup keyed on an INDEX":
        step("COLL020 sees a dedup keyed on an INDEX")
        val indexed = "fn uniq(rows: [[text]]) -> [text]:\n    val seen: [text] = []\n    for r in rows:\n        if not seen.contains(r[0]):\n            seen.push(r[0])\n    return seen\n"
        assert_true(has(results_for("/tmp/coll_index.spl", indexed), "COLL020"))

    it "but a push of a DIFFERENT value is still not dedup":
        step("but a push of a DIFFERENT value is still not dedup")
        """Structural comparison must stay exact, or the rule starts firing
        on loops that are not deduplicating anything."""
        val mismatched = "struct Dep:\n    path: text\n    name: text\n\nfn uniq(deps: [Dep]) -> [text]:\n    val seen: [text] = []\n    for dep in deps:\n        if not seen.contains(dep.path):\n            seen.push(dep.name)\n    return seen\n"
        assert_false(has(results_for("/tmp/coll_mismatch.spl", mismatched), "COLL020"))

describe "the negated filter form is seen too":
    it "COLL002 sees `if not allowed.contains(x)` with no push":
        step("COLL002 sees `if not allowed.contains(x)` with no push")
        """The condition node is a unary `not`, not the method call, so the
        matcher never fired — yet it is the same O(n) scan per iteration."""
        val negated = "fn keep(xs: [i64]) -> i64:\n    val allowed: [i64] = [1, 2, 3]\n    var n = 0\n    for x in xs:\n        if not allowed.contains(x):\n            n = n + 1\n    n\n"
        assert_true(has(results_for("/tmp/coll_neg.spl", negated), "COLL002"))

    it "a dedup guard reports ONCE, as COLL020, not twice":
        step("a dedup guard reports ONCE, as COLL020, not twice")
        """Every COLL020 site IS a negated contains guard, so widening
        COLL002 to see through `not` without excluding the guards COLL020
        already claims would make every dedup site warn twice."""
        val dedup = "fn uniq(xs: [i64]) -> [i64]:\n    val seen: [i64] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n    return seen\n"
        val codes = results_for("/tmp/coll_once.spl", dedup)
        assert_true(has(codes, "COLL020"))
        assert_equal(0, count_of("/tmp/coll_once.spl", dedup, "COLL002"))

# ---------------------------------------------------------------------------
# Method bodies. Every rule walks the module's declarations and acts on
# `DECL_FN`; a `fn` inside a `class`/`impl` is a CHILD of the enclosing
# declaration, so the whole COLL family was silent on methods. In this
# codebase most real logic lives in methods, which makes that the family's
# largest blind spot rather than a corner case.
# `coll_all_decls` flattens using `flat_decl_child_decls`, the arena's own
# nested-declaration contract, so no container kind is enumerated here.
# Record: doc/08_tracking/bug/coll_rules_do_not_walk_methods_2026-09-19.md
# ---------------------------------------------------------------------------

describe "the rules walk method bodies too":
    it "COLL020 sees a dedup loop inside a method":
        step("COLL020 sees a dedup loop inside a method")
        val in_method = "class Box:\n    var items: [text]\n\n    fn uniq(self) -> [text]:\n        var seen: [text] = []\n        for it in self.items:\n            if not seen.contains(it):\n                seen.push(it)\n        seen\n"
        assert_true(has(results_for("/tmp/coll_method.spl", in_method), "COLL020"))

    it "a method and a free function with the same idiom each report once":
        step("a method and a free function with the same idiom each report once")
        """Flattening must not double-count: a declaration reachable both as
        a module child and as a container child would report twice."""
        val both = "class Box:\n    var items: [text]\n\n    fn uniq(self) -> [text]:\n        var seen: [text] = []\n        for it in self.items:\n            if not seen.contains(it):\n                seen.push(it)\n        seen\n\nfn toplevel(xs: [text]) -> [text]:\n    var seen: [text] = []\n    for x in xs:\n        if not seen.contains(x):\n            seen.push(x)\n    seen\n"
        assert_equal(2, count_of("/tmp/coll_both.spl", both, "COLL020"))

    it "COLL002 sees a plain contains-in-loop inside a method":
        step("COLL002 sees a plain contains-in-loop inside a method")
        val filt = "class Box:\n    var allowed: [text]\n\n    fn hits(self, xs: [text]) -> i64:\n        var n = 0\n        for x in xs:\n            if self.allowed.contains(x):\n                n = n + 1\n        n\n"
        assert_true(has(results_for("/tmp/coll_m2.spl", filt), "COLL002"))

# ---------------------------------------------------------------------------
# Round 5, from an adversarial review of the widened matcher.
# ---------------------------------------------------------------------------

describe "a text receiver is a substring search, not an element scan":
    it "COLL002 does not fire on `.contains` over a text value":
        step("COLL002 does not fire on `.contains` over a text value")
        """Real false positive, found in the tree at
        src/compiler/80.driver/driver_build/incremental.spl:308 —
        `val alphabet = "0123456789abcdef"`. On text `.contains` is a
        substring search, so the rule does not apply and a Dict rewrite would
        change behaviour. `check_loop_body` was already being handed
        `text_vars` for COLL001 and simply was not consulting it here."""
        val txt = "fn f(xs: [i64]) -> i64:\n    val alphabet = \"0123456789abcdef\"\n    var n = 0\n    for x in xs:\n        if alphabet.contains(\"a\"):\n            n = n + 1\n    n\n"
        assert_false(has(results_for("/tmp/coll_text_pos.spl", txt), "COLL002"))

    it "nor in the negated form":
        step("nor in the negated form")
        """The positive form had this defect already; the negated-filter
        widening added a second way in. Both are gated."""
        val txt = "fn f(xs: [i64]) -> i64:\n    val alphabet = \"0123456789abcdef\"\n    var n = 0\n    for x in xs:\n        if not alphabet.contains(\"a\"):\n            n = n + 1\n    n\n"
        assert_false(has(results_for("/tmp/coll_text_neg.spl", txt), "COLL002"))

    it "but an ARRAY receiver still fires (non-vacuity)":
        step("but an ARRAY receiver still fires (non-vacuity)")
        val arr = "fn f(xs: [text]) -> i64:\n    val allowed: [text] = [\"a\", \"b\"]\n    var n = 0\n    for x in xs:\n        if allowed.contains(x):\n            n = n + 1\n    n\n"
        assert_true(has(results_for("/tmp/coll_arr.spl", arr), "COLL002"))

describe "a block inside the loop does not end the iteration":
    it "COLL020 sees a dedup guard nested under an `if`":
        step("COLL020 sees a dedup guard nested under an `if`")
        """`check_loop_body` only ever looked at the loop body's TOP level,
        and `check_fn_body` descends into blocks hunting for LOOPS, not for
        in-loop patterns — so a guard under `if x > 0:` was checked by
        neither. All 14 remaining silent dedup sites in the tree were nested
        this way, which made it the real coverage gap rather than the
        multi-statement guard body it had been attributed to."""
        val nested = "fn f(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    for x in xs:\n        if x > 0:\n            if not seen.contains(x):\n                seen.push(x)\n    seen\n"
        assert_true(has(results_for("/tmp/coll_nest.spl", nested), "COLL020"))

    it "and reports it ONCE, not once per enclosing block":
        step("and reports it ONCE, not once per enclosing block")
        val nested = "fn f(xs: [i64]) -> [i64]:\n    var seen: [i64] = []\n    for x in xs:\n        if x > 0:\n            if not seen.contains(x):\n                seen.push(x)\n    seen\n"
        assert_equal(1, count_of("/tmp/coll_nest1.spl", nested, "COLL020"))
        assert_equal(0, count_of("/tmp/coll_nest1.spl", nested, "COLL002"))

    it "a nested LOOP body is not checked twice":
        step("a nested LOOP body is not checked twice")
        """Loops are skipped by the new descent deliberately: a nested loop is
        reached by `check_fn_body`, which runs `check_loop_body` on it in its
        own right."""
        val two = "fn f(gs: [[i64]]) -> [i64]:\n    var seen: [i64] = []\n    for g in gs:\n        for x in g:\n            if not seen.contains(x):\n                seen.push(x)\n    seen\n"
        assert_equal(1, count_of("/tmp/coll_two.spl", two, "COLL020"))

describe "structural equality compares the whole value":
    it "float literals that differ are not the same value":
        step("float literals that differ are not the same value")
        """A float's value lives in `expr_get_float`, not `expr_get_str` or
        `expr_get_int`, so `seen.contains(1.5)` / `seen.push(2.5)` compared
        EQUAL and reported as dedup. The fix refused it anyway, so this was
        warning noise, not a wrong rewrite — but it falsified the
        "conservative by construction" claim, so it is closed."""
        val floats = "fn f(xs: [f64]) -> [f64]:\n    var seen: [f64] = []\n    for x in xs:\n        if not seen.contains(1.5):\n            seen.push(2.5)\n    seen\n"
        assert_false(has(results_for("/tmp/coll_f.spl", floats), "COLL020"))

    it "float literals that match still are":
        step("float literals that match still are")
        val floats = "fn f(xs: [f64]) -> [f64]:\n    var seen: [f64] = []\n    for x in xs:\n        if not seen.contains(1.5):\n            seen.push(1.5)\n    seen\n"
        assert_true(has(results_for("/tmp/coll_f2.spl", floats), "COLL020"))
