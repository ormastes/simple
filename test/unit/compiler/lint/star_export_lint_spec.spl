"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/lint/star_export_lint_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec.{describe, it, expect, step}
use std.io_runtime.{read_file}

describe "Star export lint (W0407)":
    it "star_import.spl contains check_star_export function":
        # @req: REQ-UNIT-COMPILER-001
        step("Verify: star_import.spl contains check_star_export function")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("src/compiler/35.semantics/lint/star_import.spl")
        expect(source.contains("fn check_star_export(")).to_equal(true)

    it "detects wildcard via ends_with check":
        # @req: REQ-UNIT-COMPILER-002
        step("Verify: detects wildcard via ends_with check")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("src/compiler/35.semantics/lint/star_import.spl")
        expect(source.contains("ends_with(\".*\")")).to_equal(true)

    it "emits W0407 code":
        # @req: REQ-UNIT-COMPILER-003
        step("Verify: emits W0407 code")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("src/compiler/35.semantics/lint/star_import.spl")
        expect(source.contains("\"W0407\"")).to_equal(true)

    it "has facade exemption for __init__.spl":
        # @req: REQ-UNIT-COMPILER-004
        step("Verify: has facade exemption for __init__.spl")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("src/compiler/35.semantics/lint/star_import.spl")
        expect(source.contains("__init__.spl")).to_equal(true)

    it "has facade exemption for mod.spl":
        # @req: REQ-UNIT-COMPILER-005
        step("Verify: has facade exemption for mod.spl")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("src/compiler/35.semantics/lint/star_import.spl")
        expect(source.contains("mod.spl")).to_equal(true)

    it "strips .* suffix to get module_path":
        # @req: REQ-UNIT-COMPILER-006
        step("Verify: strips .* suffix to get module_path")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("src/compiler/35.semantics/lint/star_import.spl")
        expect(source.contains("n.slice(0, n.len() - 2)")).to_equal(true)

    it "uses unified StarWildcardWarning struct":
        # @req: REQ-UNIT-COMPILER-007
        step("Verify: uses unified StarWildcardWarning struct")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("src/compiler/35.semantics/lint/star_import.spl")
        expect(source.contains("struct StarWildcardWarning:")).to_equal(true)

    it "has shared _is_facade_file helper":
        # @req: REQ-UNIT-COMPILER-008
        step("Verify: has shared _is_facade_file helper")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("src/compiler/35.semantics/lint/star_import.spl")
        expect(source.contains("fn _is_facade_file(")).to_equal(true)

    it "is registered in __init__.spl":
        # @req: REQ-UNIT-COMPILER-009
        step("Verify: is registered in __init__.spl")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("src/compiler/35.semantics/lint/__init__.spl")
        expect(source.contains("export check_star_export, check_star_export_file")).to_equal(true)

    it "is integrated in query_lint.spl":
        # @req: REQ-UNIT-COMPILER-010
        step("Verify: is integrated in query_lint.spl")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("src/app/cli/query_lint.spl")
        # Anchored to the real import and the real call site; the
        # "# --- C5a/C5c: Star wildcard warnings ---" banner comment must not
        # be able to satisfy this on its own.
        expect(source.contains("check_star_export_file}")).to_equal(true)
        expect(source.contains("val star_export_warnings = check_star_export_file(decl_indices, file)")).to_equal(true)
