"""Semantic HIR constant-fold ownership contracts."""

use std.spec.*
use std.fs.{file_exists, read_file}

describe "HIR constant-fold quarantine":
    it "routes resolved HIR directly without a discarded folding walk":
        step("Keep constant optimization under the typed MIR registry")
        val driver = read_file(
            "src/compiler/80.driver/driver_hir_pipeline_lowering.spl")
        val barrel = read_file("src/compiler/35.semantics/__init__.spl")
        expect(driver).not.to_contain("run_const_fold_pass")
        expect(driver).not.to_contain("folded_module")
        expect(driver).to_contain("bootstrap_hir_modules[name] = resolved_module")
        expect(barrel).not.to_contain("compiler.semantics.const_fold")
        expect(file_exists("src/compiler/35.semantics/const_fold.spl")).to_equal(false)

    it "preserves semantic constant evaluation as a separate language service":
        step("Do not confuse const evaluation with the removed no-op transform")
        val barrel = read_file("src/compiler/35.semantics/__init__.spl")
        expect(file_exists("src/compiler/35.semantics/const_eval.spl")).to_equal(true)
        expect(barrel).to_contain("compiler.semantics.const_eval")
        expect(barrel).to_contain("EvaluatedConstValue")
