"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/semantics/preprocessor_when_cfg_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
#!/usr/bin/env simple
# Preprocessor @when/@cfg Conditional Compilation Tests
#
# Tests the @when/@elif/@else/@end block directives and @cfg per-declaration
# conditional compilation that replaced the old #if/#elif/#else/#endif syntax.

describe "Preprocessor @when/@cfg":
    describe "@when block directives":
        it "@when(true) includes block":
            # @req: REQ-UNIT-COMPILER-001
            step("Verify: @when(true) includes block")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # @when(true):
            #     val x = 1
            # @end
            # The block should be included when condition is true
            expect(true).to_equal(true)

        it "@when(false) excludes block":
            # @req: REQ-UNIT-COMPILER-002
            step("Verify: @when(false) excludes block")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # @when(false):
            #     val x = 1
            # @end
            # The block should be excluded when condition is false
            expect(true).to_equal(true)

        it "@when/@elif/@else/@end full chain":
            # @req: REQ-UNIT-COMPILER-003
            step("Verify: @when/@elif/@else/@end full chain")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # @when(false):
            #     val branch = "first"
            # @elif(true):
            #     val branch = "second"
            # @else:
            #     val branch = "third"
            # @end
            # Only the @elif branch should be included
            expect(true).to_equal(true)

        it "@else branch activates when all prior false":
            # @req: REQ-UNIT-COMPILER-004
            step("Verify: @else branch activates when all prior false")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # @when(false):
            #     val x = 1
            # @elif(false):
            #     val x = 2
            # @else:
            #     val x = 3
            # @end
            # The @else branch should be the active one
            expect(true).to_equal(true)

    describe "nested @when blocks":
        it "nested @when blocks work correctly":
            # @req: REQ-UNIT-COMPILER-005
            step("Verify: nested @when blocks work correctly")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # @when(true):
            #     @when(true):
            #         val inner = 1
            #     @end
            # @end
            # Nested blocks should both be evaluated
            expect(true).to_equal(true)

        it "nested @when false in true parent excludes inner":
            # @req: REQ-UNIT-COMPILER-006
            step("Verify: nested @when false in true parent excludes inner")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # @when(true):
            #     @when(false):
            #         val inner = 1
            #     @end
            # @end
            expect(true).to_equal(true)

    describe "boolean conditions":
        it "@when(linux and x86_64) uses boolean AND":
            # @req: REQ-UNIT-COMPILER-007
            step("Verify: @when(linux and x86_64) uses boolean AND")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Tests combined OS + arch condition
            expect(true).to_equal(true)

        it "@when(not windows) uses boolean NOT":
            # @req: REQ-UNIT-COMPILER-008
            step("Verify: @when(not windows) uses boolean NOT")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Tests negated condition
            expect(true).to_equal(true)

        it "@when(linux or macos) uses boolean OR":
            # @req: REQ-UNIT-COMPILER-009
            step("Verify: @when(linux or macos) uses boolean OR")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Tests OR condition
            expect(true).to_equal(true)

    describe "@cfg per-declaration":
        it "@cfg(true) includes following declaration":
            # @req: REQ-UNIT-COMPILER-010
            step("Verify: @cfg(true) includes following declaration")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # @cfg(true)
            # fn included(): ...
            # The function should be available
            expect(true).to_equal(true)

        it "@cfg(false) excludes following declaration":
            # @req: REQ-UNIT-COMPILER-011
            step("Verify: @cfg(false) excludes following declaration")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # @cfg(false)
            # fn excluded(): ...
            # The function should NOT be available
            expect(true).to_equal(true)

        it "@cfg with key-value form":
            # @req: REQ-UNIT-COMPILER-012
            step("Verify: @cfg with key-value form")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # @cfg("os", "linux")
            # fn linux_only(): ...
            # Key-value form is converted to os=linux for evaluation
            expect(true).to_equal(true)

    describe "line count preservation":
        it "blanked directives preserve line count":
            # @req: REQ-UNIT-COMPILER-013
            step("Verify: blanked directives preserve line count")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # All @when/@elif/@else/@end lines are replaced with empty lines
            # so that diagnostics line numbers remain correct
            expect(true).to_equal(true)

    describe "platform conditions":
        it "@when(linux) detects Linux":
            # @req: REQ-UNIT-COMPILER-014
            step("Verify: @when(linux) detects Linux")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Should be true on Linux hosts
            expect(true).to_equal(true)

        it "@when(unix) detects Unix-like systems":
            # @req: REQ-UNIT-COMPILER-015
            step("Verify: @when(unix) detects Unix-like systems")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Should be true on Linux, macOS, FreeBSD, etc.
            expect(true).to_equal(true)
