"""
## Purpose and audience
Purpose: Prove that @tailrec annotation.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-SEMANTICS-001 — stable requirement identity for this spec.

# Tail recursion spec
#
# Tests for @tailrec annotation support

# @tailrec
fn factorial_tr(n: i64, acc: i64) -> i64:
    if n <= 1:
        return acc
    factorial_tr(n - 1, n * acc)

# @tailrec
fn sum_to(n: i64, acc: i64) -> i64:
    if n <= 0:
        return acc
    sum_to(n - 1, acc + n)

use std.spec.step

describe "@tailrec annotation":
    it "tailrec annotated function works correctly":
        step("Verify: tailrec annotated function works correctly")
        # @req: REQ-COMPILER-SEMANTICS-001
        # factorial(5) = 120
        val result = factorial_tr(5, 1)
        expect(result).to_equal(120)  # oracle: 120 — named expected value from the requirement

    it "tailrec accumulator pattern":
        step("Verify: tailrec accumulator pattern")
        # sum 1..10 = 55
        val result = sum_to(10, 0)
        expect(result).to_equal(55)  # oracle: 55 — named expected value from the requirement

    it "base case returns directly":
        step("Verify: base case returns directly")
        val result = factorial_tr(1, 1)
        expect(result).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "tailrec with zero":
        step("Verify: tailrec with zero")
        val result = sum_to(0, 42)
        expect(result).to_equal(42)  # oracle: 42 — named expected value from the requirement
