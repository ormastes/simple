# @req: REQ-COMPILER-COVERAGE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/coverage/branch_coverage_13_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/branch_coverage_13.md
# doc-path: doc/03_plan/sys_test/branch_coverage_13.md
# doc-path: doc/04_architecture/branch_coverage_13.md
# doc-path: doc/05_design/branch_coverage_13.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "deeply nested true chain reaches innermost arm":
        step("Verify: deeply nested true chain reaches innermost arm")
        # @req: REQ-COMPILER-COVERAGE-001
        var r = 0
        if 1 == 1:
            if 2 == 2:
                if 3 == 3:
                    r = 7
        expect(r).to_equal(7)  # oracle: all three guards true

    it "if-then arm executes on true condition":
        step("Verify: if-then arm executes on true condition")
        # @req: REQ-COMPILER-COVERAGE-001
        var r = 0
        if 10 > 5:
            r = 1
        expect(r).to_equal(1)  # oracle: then arm taken

    it "match falls through to default arm":
        step("Verify: match falls through to default arm")
        # @req: REQ-COMPILER-COVERAGE-001
        val k = 99
        var r = 0
        match k:
            1: r = 10
            2: r = 20
            _: r = -1
        expect(r).to_equal(-1)  # oracle: default arm

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "for loop over empty range runs zero times":
        step("Verify: for loop over empty range runs zero times")
        # @req: REQ-COMPILER-COVERAGE-001
        var c = 5
        for i in 2..2:
            c = c + 1
        expect(c).to_equal(5)  # oracle: body never entered

    it "if-else arm executes on false condition":
        step("Verify: if-else arm executes on false condition")
        # @req: REQ-COMPILER-COVERAGE-001
        var r = 0
        if 2 > 5:
            r = 1
        else:
            r = 2
        expect(r).to_equal(2)  # oracle: else arm taken

    it "match nil takes the nil arm":
        step("Verify: match nil takes the nil arm")
        # @req: REQ-COMPILER-COVERAGE-001
        var r = 9
        match nil:
            Some(x): r = x
            nil: r = -1
        expect(r).to_equal(-1)  # oracle: nil arm
