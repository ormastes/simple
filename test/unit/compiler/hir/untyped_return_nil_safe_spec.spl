"""Regression for PID1 native-build D1: return-signature scanning is nil-safe."""

use std.spec
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirTypeKind}

describe "HIR untyped return inference":
    it "treats an absent AST expression as no inferred return":
        var lowering = HirLowering.with_filename("nil_return_scan.spl")
        val scan = lowering.scan_ast_expr_for_returns(nil, [])
        expect(scan.found_value_return).to_equal(false)
        expect(scan.ambiguous).to_equal(false)

    it "keeps scalar inference after the nil-safe guard":
        val source = "fn void_helper():\n    print(\"ok\")\n\nfn inferred():\n    return 7\n"
        val module = parse_full_frontend(source, "untyped_return_scan.spl", "untyped_return_scan.spl", Logger(level: 0))
        var lowering = HirLowering.with_filename("untyped_return_scan.spl")
        val hir = lowering.lower_module(module)
        match hir.symbols.lookup("inferred"):
            Some(symbol):
                val fn_ = hir.functions[symbol]
                match fn_.return_type.kind:
                    HirTypeKind.Int(bits, signed):
                        expect(bits).to_equal(64u8)
                        expect(signed).to_equal(true)
                    _:
                        expect(false).to_equal(true)
            nil:
                expect(false).to_equal(true)

extern fn rt_env_get(key: text) -> text?
extern fn rt_env_set(key: text, value: text)

describe "bootstrap helper return signatures":
    it "keeps side-effect and bare-return helpers Unit while retaining value returns":
        val source = "fn print_usage():\n    print(\"ok\")\n\nfn reset_location():\n    val unused = 1\n\nfn early_exit():\n    return\n\nfn inferred():\n    return 7\n"
        val module = parse_full_frontend(source, "bootstrap_helper_returns.spl", "bootstrap_helper_returns.spl", Logger(level: 0))
        val saved = rt_env_get("SIMPLE_BOOTSTRAP") ?? ""
        rt_env_set("SIMPLE_BOOTSTRAP", "1")
        var lowering = HirLowering.with_filename("bootstrap_helper_returns.spl")
        val hir = lowering.lower_module(module)
        rt_env_set("SIMPLE_BOOTSTRAP", saved)
        for name in ["print_usage", "reset_location", "early_exit"]:
            match hir.symbols.lookup(name):
                Some(symbol):
                    val fn_ = hir.functions[symbol]
                    expect(fn_.return_type.kind).to_equal(HirTypeKind.Unit)
                nil:
                    expect(false).to_equal(true)
        match hir.symbols.lookup("inferred"):
            Some(symbol):
                val fn_ = hir.functions[symbol]
                match fn_.return_type.kind:
                    HirTypeKind.Int(bits, signed):
                        expect(bits).to_equal(64u8)
                        expect(signed).to_equal(true)
                    _:
                        expect(false).to_equal(true)
            nil:
                expect(false).to_equal(true)
