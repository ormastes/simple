extern fn rt_file_read_text(path: text) -> text

describe "SymbolTable Dict lookup source":
    it "uses the Dict runtime owner for scope symbol lookup":
        val source = rt_file_read_text("src/compiler/20.hir/hir_types.spl") ?? ""

        expect(source).to_contain("extern fn rt_dict_contains(dict: i64, key: Any) -> bool")
        expect(source.contains("use std.alloc.sffi")).to_be(false)
        expect(source).to_contain("if rt_dict_contains(scope.symbols, name):")
        expect(source).to_contain("val found: i64 = scope.symbols[name]")
        expect(source.contains("rt_dict_get(scope.symbols, name)")).to_be(false)

    it "keeps display names on the stored symbol with in-place rename":
        val source = rt_file_read_text("src/compiler/20.hir/hir_types.spl") ?? ""

        expect(source).to_contain("me symbol_display_name(id: SymbolId, fallback: text) -> text:")
        expect(source).to_contain("me rename_symbol(id: SymbolId, new_name: text):")
        expect(source).to_contain("name: new_name,")
        expect(source).to_contain("self.symbols[raw] = renamed")

    it "lowers identifiers through an explicit nil re-check":
        val source = rt_file_read_text("src/compiler/20.hir/hir_lowering/expressions.spl") ?? ""

        expect(source).to_contain("val symbol = self.symbols.lookup(ident_name_t)")
        expect(source).to_contain("if found_symbol == nil:")
        expect(source).to_contain("lookup_or_invalid")
