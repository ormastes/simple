"""
## Purpose and audience
Purpose: Prove that REPRODUCE — wildcard over a closed enum under critical.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-HIR-001 — stable requirement identity for this spec.

"""
# Critical-Profile Wildcard Ban (A2, hardening plan 2026-08-21 6.4/6.5/17.3)

Under the `critical` assurance profile — and on any `@exhaustive`-annotated
match at ANY profile — a `case _:` wildcard no longer satisfies coverage. The
witness set `StaticRequired(E) - StaticCovered(match)` must be empty, which
means every static variant is named explicitly.

The defect this guards is a silent one: a wildcard over a closed enum compiles
clean, and then a NEW variant added to that enum falls into the wildcard
instead of failing the build. In compiler IR that is a miscompile, not a
default. `is_exhaustive()` keeps its old wildcard-absorbs contract for
moderate/strict/robust, so nothing outside critical changes behaviour.
"""

use std.spec
use compiler.hir.match_coverage.{ResolvedMatchCoverage}
use compiler.common.assurance.policy_schema.{AssuranceStrictness}
use compiler.hir.exhaustiveness.coverage_witness.{coverage_witness_for, coverage_witness_code}

# A closed three-variant enum, ids 0/1/2, mirroring what MIR switch lowering
# resolves for `enum Color: Red, Green, Blue`.
fn full_ids() -> [i64]:
    [0, 1, 2]

fn full_names() -> [text]:
    ["Red", "Green", "Blue"]

# Covers Red and Green explicitly, leaves Blue to a wildcard — the exact shape
# of plan 17.3's "static variant hidden by wildcard".
fn wildcard_over_blue() -> ResolvedMatchCoverage:
    ResolvedMatchCoverage(
        scrutinee_type_id: 42,
        enum_symbol_id: 42,
        enum_name: "Color",
        all_variant_ids: full_ids(),
        all_variant_names: full_names(),
        covered_variant_ids: [0, 1],
        has_wildcard: true
    )

describe "REPRODUCE — wildcard over a closed enum under critical":

    it "is exhaustive under the legacy wildcard-absorbs contract":
        step("Verify: is exhaustive under the legacy wildcard-absorbs contract")
        # @req: REQ-COMPILER-HIR-001
        # The pre-existing behaviour, unchanged: this is what let the defect hide.
        assert_true(wildcard_over_blue().is_exhaustive())

    it "is NOT exhaustive under the critical profile":
        step("Verify: is NOT exhaustive under the critical profile")
        val cov = wildcard_over_blue()
        assert_false(cov.is_exhaustive_for(AssuranceStrictness.Critical, false))

    it "names the uncovered variant in the static witness set":
        step("Verify: names the uncovered variant in the static witness set")
        val missing = wildcard_over_blue().static_missing_variant_names()
        expect(missing.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(missing[0]).to_equal("Blue")

    it "reports an empty legacy missing set, proving the wildcard hid it":
        step("Verify: reports an empty legacy missing set, proving the wildcard hid it")
        # static_missing_* sees through the wildcard; missing_* deliberately
        # does not. Both contracts asserted side by side so neither can drift.
        expect(wildcard_over_blue().missing_variant_ids().len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "E-COMPLETE-001 diagnostic (plan 17.3)":

    it "renders the code, the enum, and the missing variant":
        step("Verify: renders the code, the enum, and the missing variant")
        val w = coverage_witness_for(wildcard_over_blue(), AssuranceStrictness.Critical, false)
        assert_false(w.is_satisfied())
        val text_out = w.render()
        assert_contains(text_out, coverage_witness_code())
        assert_contains(text_out, "non-exhaustive static match over Color")
        assert_contains(text_out, "missing:")
        assert_contains(text_out, "Color.Blue")
        assert_contains(text_out, "wildcards are forbidden for critical compiler IR.")

    it "renders nothing for a satisfied witness":
        step("Verify: renders nothing for a satisfied witness")
        val cov = ResolvedMatchCoverage(
            scrutinee_type_id: 42, enum_symbol_id: 42, enum_name: "Color",
            all_variant_ids: full_ids(), all_variant_names: full_names(),
            covered_variant_ids: [0, 1, 2], has_wildcard: false
        )
        val w = coverage_witness_for(cov, AssuranceStrictness.Critical, false)
        assert_true(w.is_satisfied())
        expect(w.render()).to_equal("")

describe "NEIGHBOUR — non-critical profiles are unchanged":

    it "still accepts a wildcard at moderate, strict and robust":
        step("Verify: still accepts a wildcard at moderate, strict and robust")
        val cov = wildcard_over_blue()
        assert_true(cov.is_exhaustive_for(AssuranceStrictness.Moderate, false))
        assert_true(cov.is_exhaustive_for(AssuranceStrictness.Strict, false))
        assert_true(cov.is_exhaustive_for(AssuranceStrictness.Robust, false))

    it "still rejects a genuinely incomplete match with no wildcard everywhere":
        step("Verify: still rejects a genuinely incomplete match with no wildcard everywhere")
        # No wildcard, Blue uncovered: this was ALREADY an error at every
        # profile and must stay one — the new gate must not have narrowed it.
        val cov = ResolvedMatchCoverage(
            scrutinee_type_id: 42, enum_symbol_id: 42, enum_name: "Color",
            all_variant_ids: full_ids(), all_variant_names: full_names(),
            covered_variant_ids: [0, 1], has_wildcard: false
        )
        assert_false(cov.is_exhaustive_for(AssuranceStrictness.Moderate, false))
        assert_false(cov.is_exhaustive_for(AssuranceStrictness.Critical, false))

describe "NEIGHBOUR — @exhaustive bans the wildcard outside critical too":

    it "rejects a wildcard at moderate when the match is annotated":
        step("Verify: rejects a wildcard at moderate when the match is annotated")
        assert_false(wildcard_over_blue().is_exhaustive_for(AssuranceStrictness.Moderate, true))

    it "accepts an annotated match that names every variant":
        step("Verify: accepts an annotated match that names every variant")
        val cov = ResolvedMatchCoverage(
            scrutinee_type_id: 42, enum_symbol_id: 42, enum_name: "Color",
            all_variant_ids: full_ids(), all_variant_names: full_names(),
            covered_variant_ids: [0, 1, 2], has_wildcard: true
        )
        assert_true(cov.is_exhaustive_for(AssuranceStrictness.Moderate, true))

describe "NEIGHBOUR — a newly injected variant fails the gate (A2 exit gate)":

    it "goes non-exhaustive under critical when a fourth variant appears":
        step("Verify: goes non-exhaustive under critical when a fourth variant appears")
        # The enum grew a variant; the match did not. A wildcard would have
        # swallowed it. This is the exit gate of plan 20.3 row A2.
        val cov = ResolvedMatchCoverage(
            scrutinee_type_id: 42, enum_symbol_id: 42, enum_name: "Color",
            all_variant_ids: [0, 1, 2, 3],
            all_variant_names: ["Red", "Green", "Blue", "Ultraviolet"],
            covered_variant_ids: [0, 1, 2],
            has_wildcard: true
        )
        assert_true(cov.is_exhaustive())
        assert_false(cov.is_exhaustive_for(AssuranceStrictness.Critical, false))
        val missing = cov.static_missing_variant_names()
        expect(missing.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(missing[0]).to_equal("Ultraviolet")

describe "id-keyed comparison survives name collisions":

    it "does not let a same-named variant of another enum satisfy coverage":
        step("Verify: does not let a same-named variant of another enum satisfy coverage")
        # Ids 10/11 are another enum's Red/Green. Covering them must leave all
        # three of THIS enum's variants missing.
        val cov = ResolvedMatchCoverage(
            scrutinee_type_id: 42, enum_symbol_id: 42, enum_name: "Color",
            all_variant_ids: full_ids(), all_variant_names: full_names(),
            covered_variant_ids: [10, 11], has_wildcard: true
        )
        expect(cov.static_missing_variant_names().len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        assert_false(cov.is_exhaustive_for(AssuranceStrictness.Critical, false))
