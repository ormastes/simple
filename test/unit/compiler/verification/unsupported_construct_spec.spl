"""
## Purpose and audience
Purpose: Prove that Unsupported Construct Detection.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-VERIFICATION-001 — stable requirement identity for this spec.

# @cover src/compiler_rust/lib/std/src/verification/lean/verification_checker.spl 70%
"""
# Unsupported Construct Verification Specification

**Feature IDs:** #LEAN-UNSUP-001
**Category:** Infrastructure
**Difficulty:** 2/5
**Status:** Implemented
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A

## Overview

Verifies that the verification checker correctly rejects unsupported constructs
when used with @verify. Async functions, FFI calls, and unsafe operations must
produce clear error diagnostics rather than silently generating incorrect Lean.

## Behavior

- IO functions in verified context produce V-EFFECT-001 errors
- Unsafe operations in verified context produce V-UNSAFE-001 errors
- FFI calls are detected via the `check_unsafe_operation("ffi_call")` path
- Recursive functions without termination proof produce V-TERM-001 errors
- Multiple violations are all reported (not just the first)
"""

use verification.lean.verification_checker as checker
use verification.lean.verification_diagnostics as diag

# ============================================================================
# Test Group 1: IO/Effect Violations
# ============================================================================

use std.spec.step

describe "Unsupported Construct Detection":
    context "IO effects in verified context":
        it "rejects verified function calling IO functions":
            step("Verify: rejects verified function calling IO functions")
            # @req: REQ-COMPILER-VERIFICATION-001
            val result = checker.validate_verified_function(
                "my_verified_fn",
                false,       # not recursive
                false,       # no termination needed
                ["print", "read_file"],  # IO calls
                false        # no unsafe ops
            )
            expect(result.has_errors()).to_equal(true)
            expect(result.error_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement

        it "produces V-EFFECT-001 error code for IO violations":
            step("Verify: produces V-EFFECT-001 error code for IO violations")
            val check = checker.check_call_in_verified("print")
            expect(check).to_equal(Some(diag.VerificationErrorCode.IoInVerified))

        it "allows pure functions in verified context":
            step("Verify: allows pure functions in verified context")
            val result = checker.validate_verified_function(
                "pure_fn",
                false,
                false,
                [],          # no IO calls
                false        # no unsafe ops
            )
            expect(result.has_errors()).to_equal(false)

    context "unsafe operations in verified context":
        it "rejects verified function with unsafe operations":
            step("Verify: rejects verified function with unsafe operations")
            val result = checker.validate_verified_function(
                "unsafe_verified_fn",
                false,
                false,
                [],
                true         # has unsafe ops
            )
            expect(result.has_errors()).to_equal(true)
            expect(result.error_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "detects raw pointer dereference as unsafe":
            step("Verify: detects raw pointer dereference as unsafe")
            val check = checker.check_unsafe_operation("raw_pointer_deref")
            expect(check).to_equal(Some(diag.VerificationErrorCode.RawPointerInVerified))

        it "detects unsafe cast as violation":
            step("Verify: detects unsafe cast as violation")
            val check = checker.check_unsafe_operation("unsafe_cast")
            expect(check).to_equal(Some(diag.VerificationErrorCode.UnsafeInVerified))

    context "FFI calls in verified context":
        it "detects FFI call as unsupported in verified code":
            step("Verify: detects FFI call as unsupported in verified code")
            val check = checker.check_unsafe_operation("ffi_call")
            expect(check).to_equal(Some(diag.VerificationErrorCode.FfiInVerified))

        it "produces clear FFI error via VerificationChecker":
            step("Verify: produces clear FFI error via VerificationChecker")
            var vc = checker.VerificationChecker.new()
            val span = diag.Span.empty()
            vc.report_ffi_error(span, "extern_crypto_hash")
            val result = vc.get_result()
            expect(result.has_errors()).to_equal(true)
            expect(result.error_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "recursive functions without termination":
        it "rejects recursive function missing decreases clause":
            step("Verify: rejects recursive function missing decreases clause")
            val result = checker.validate_verified_function(
                "recursive_fn",
                true,        # is recursive
                false,       # NO termination proof
                [],
                false
            )
            expect(result.has_errors()).to_equal(true)
            expect(result.error_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "allows recursive function with termination proof":
            step("Verify: allows recursive function with termination proof")
            val result = checker.validate_verified_function(
                "recursive_fn",
                true,        # is recursive
                true,        # has termination proof
                [],
                false
            )
            expect(result.has_errors()).to_equal(false)

    context "multiple violations":
        it "reports all violations, not just the first":
            step("Verify: reports all violations, not just the first")
            val result = checker.validate_verified_function(
                "bad_fn",
                true,        # recursive
                false,       # no termination
                ["println", "write_file", "sleep"],  # 3 IO calls
                true         # unsafe ops
            )
            # 1 termination + 3 IO + 1 unsafe = 5 errors
            expect(result.has_errors()).to_equal(true)
            expect(result.error_count()).to_equal(5)  # oracle: 5 — named expected value from the requirement

    context "contract purity":
        it "rejects mutating calls in contract expressions":
            step("Verify: rejects mutating calls in contract expressions")
            val check = checker.check_call_in_contract("set_value")
            expect(check).to_equal(Some(diag.VerificationErrorCode.ContractHasSideEffects))

        it "allows pure reads in contract expressions":
            step("Verify: allows pure reads in contract expressions")
            val check = checker.check_call_in_contract("get_value")
            expect(check).to_equal(nil)

    context "allowed operations pass cleanly":
        it "returns nil for unknown operations":
            step("Verify: returns nil for unknown operations")
            val check = checker.check_unsafe_operation("normal_call")
            expect(check).to_equal(nil)

        it "allows non-IO function names":
            step("Verify: allows non-IO function names")
            val check = checker.check_call_in_verified("calculate_sum")
            expect(check).to_equal(nil)
