use std.spec.{describe, it, assert_true, assert_false}
use std.fs.{read_file}

describe "storage layout overlap sweep contract":
    it "uses deterministic region-local interval ordering":
        val source = read_file(
            "src/compiler/60.mir_opt/mir_opt/storage_layout_access_advisory.spl")
        assert_true(source.contains("fn storage_layout_sort_intervals("))
        assert_true(source.contains("fn storage_layout_has_cross_field_overlap("))
        assert_true(source.contains("primary_field != current.field_id"))
        assert_true(source.contains("storage_layout_intervals_overlap(intervals[prior], current)"))
        assert_false(source.contains("while right < summary.typed_facts.len()"))
