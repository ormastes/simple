use std.spec.*
use std.fs.{read_file}
use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirBlock}
use compiler.mir_opt.mir_opt.loop_strength.{
    create_strength_reduction_pass, strength_reduction_provider}
use compiler.mir_opt.pattern.rule_engine.{optimization_rule_provider_has_required_fact}

describe "MIR strength reduction skeleton":
    it "retains proof requirements and keeps direct block calls inert":
        val provider = strength_reduction_provider()
        expect(optimization_rule_provider_has_required_fact(
            provider, "integer_widths")).to_equal(true)
        expect(optimization_rule_provider_has_required_fact(
            provider, "non_negative_or_unsigned_operands")).to_equal(true)
        val block = MirBlock(
            id: BlockId(id: 0), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.BinOp(
                LocalId(id: 2), MirBinOp.Rem,
                MirOperand.copy(LocalId(id: 1)),
                MirOperand.const_int(8)), span: nil)],
            terminator: MirTerminator.Ret(nil))
        var pass = create_strength_reduction_pass()
        val result = pass.reduce_block(block)
        expect(result.instructions[0].kind).to_equal(block.instructions[0].kind)
        expect(pass.reduced_count).to_equal(0)

    it "contains no dormant rewrite helpers":
        val source = read_file(
            "src/compiler/60.mir_opt/mir_opt/loop_strength.spl")
        expect(source).not.to_contain("try_reduce_binop")
        expect(source).not.to_contain("next_local_id")
