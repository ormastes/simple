"""Legacy-layout mirror of fail-closed loop-transform contracts."""
# @req: REQ-COMPILER-MIR-OPT-001

use std.spec.*
use std.fs.{read_file}

describe "general loop transform skeletons":
    it "contains no dormant LICM or unroll rewrite bodies":
        val licm = read_file("src/compiler/60.mir_opt/mir_opt/loop_licm.spl")
        val loops = read_file("src/compiler/60.mir_opt/mir_opt/loop_opt.spl")
        expect(licm).not.to_contain("redirect_to_preheader")
        expect(licm).not.to_contain("invariant_insts")
        expect(loops).not.to_contain("body_insts")
        expect(loops).not.to_contain("current = self.licm.optimize_function")
