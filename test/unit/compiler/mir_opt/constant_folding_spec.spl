"""MIR constant-folding quarantine contracts."""

use std.spec.*
use std.fs.{read_file}
use compiler.mir.mir_data.*
use compiler.mir.mir_instructions.{MirBlock}
use compiler.mir_opt.mir_opt.const_fold.{create_const_fold_pass}
use compiler.mir_opt.mir_opt.mod.{
    OptLevel, optimizationpipeline_passes_for_level,
    optimizationpipeline_effective_passes_for_level}

describe "MIR ConstantFolding Skeleton":
    it "is requested for compatibility but excluded from effective pipelines":
        step("Keep requested and executable optimizer truth separate")
        val requested = optimizationpipeline_passes_for_level(OptLevel.Speed)
        val effective = optimizationpipeline_effective_passes_for_level(OptLevel.Speed)
        expect(requested.contains("constant_folding")).to_equal(true)
        expect(effective.contains("constant_folding")).to_equal(false)

    it "keeps a direct block call unchanged with zero statistics":
        step("Prevent the class method from bypassing Skeleton admission")
        val inst = MirInst(kind: MirInstKind.BinOp(
            LocalId(id: 2), MirBinOp.Add,
            MirOperand.const_int(1), MirOperand.const_int(2)), span: nil)
        val block = MirBlock(
            id: BlockId(id: 0), label: Some("entry"), instructions: [inst],
            terminator: MirTerminator.Ret(nil))
        var fold_pass = create_const_fold_pass()
        val result = fold_pass.fold_block(block)
        expect(result.instructions.len()).to_equal(1)
        match result.instructions[0].kind:
            case BinOp(dest, Add, _, _): expect(dest.id).to_equal(2)
            case _: fail("constant-fold Skeleton changed the instruction")
        expect(fold_pass.folded_instructions).to_equal(0)
        expect(fold_pass.folded_branches).to_equal(0)

    it "contains no host-arithmetic or MIR rewrite implementation":
        step("Require typed arithmetic and trap proofs before rehabilitation")
        val source = read_file("src/compiler/60.mir_opt/mir_opt/const_fold.spl")
        expect(source).not.to_contain("try_fold_int_binop")
        expect(source).not.to_contain("try_fold_float_binop")
        expect(source).not.to_contain("is_additive_identity")
        expect(source).not.to_contain("MirInstKind.Const(dest, folded.unwrap()")
        expect(source).not.to_contain("MirTerminator.Goto(then_)")
