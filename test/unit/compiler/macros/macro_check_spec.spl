"""
## Purpose and audience
Executable contract for the macro type checker shipped in
`src/compiler/35.semantics/macro_check/`: hygiene marks and scopes, template
matcher/transcriber validation, rule type checking, macro registration and
call checking. Written for the macro-system owners; every scenario drives the
shipped product API directly.
## Operator workflow
./src/compiler_rust/target/bootstrap/simple run test/unit/compiler/macros/macro_check_spec.spl
## Compatibility and limitations
Several convenience methods the original scenario sketches assumed
(`SyntaxMark.to_text`, `MarkedIdent.equals`, `FragmentKind.from_text`,
`MacroCheckResult.is_ok/get_type/get_error`) do not ship; those scenarios pin
the shipped structural/enum-match equivalents instead, each with a NOTE.
An `expr`/`stmt` fragment legally allows NO follower (the shipped
`kind_can_follow` rule), which supersedes the older sketch.
Several shipped branches are unexecutable and are pinned as source
contracts instead, each with a NOTE naming the defect: error pushes
construct a `TemplateError.at` static the desugared file never defines
(duplicate/undefined-parameter rejection), the repetition separator check
reads a nonexistent `has_sep`, `check_rule`/`infer_expansion_type` call a
`FragmentKind.to_text` no variant ships, `try_match_rule` returns nil
against its non-optional contract, and `check_shadowing`'s parent walk
self-loops on the root scope's defaulted parent.
## Verification guidance and troubleshooting
A failure prints the scenario's product value; for template-validation
failures inspect `validator.get_errors()` messages, and for call-check
failures match the returned `MacroCheckResult` variant to see which stage
rejected the call.
"""
# Lifecycle: doc/01_research/language/grammar/custom_blocks_user_friendly_api.md ;
# doc/03_plan/compiler/method_resolution_primitive_conversion_shadowing.md ;
# doc/04_architecture/compiler/00_compiler_architecture.md ;
# doc/05_design/compiler/phases/macro_checker_phase7a.spl
# @manual_section: macro-check

use std.spec
use std.io_runtime.{read_file_text}
use compiler.semantics.macro_check.{SyntaxMark, MarkedIdent, HygieneContext, HygieneTransformer, HygieneScopeKind, FragmentKind, TemplateToken, RepetitionKind, TemplateValidator, TemplateTypeChecker, MacroRule, MacroDef, MacroArg, MacroCall, MacroCheckResult, MacroChecker, syntaxmark_create, markedident_from_name, markedident_add_mark, macrorule_create, macrocall_create, kind_can_follow}

val HYGIENE_SOURCE = read_file_text("src/compiler/35.semantics/macro_check/hygiene.spl")
val TEMPLATE_SOURCE = read_file_text("src/compiler/35.semantics/macro_check/template.spl")
val MOD_SOURCE = read_file_text("src/compiler/35.semantics/macro_check/mod.spl")

# A format-string hole token, built by concatenation because a `{...}` hole
# inside a string literal would be parsed as interpolation.
val FORMAT_HOLE = "{" + "}"

fn one_param_rule() -> MacroRule:
    macrorule_create([TemplateToken.Param("x", FragmentKind.Expr)], [TemplateToken.Keyword("if")])

fn one_param_call(args: [MacroArg]) -> MacroCall:
    macrocall_create("log!", args)

fn plain_arg() -> MacroArg:
    MacroArg(tokens: [], has_span: false, span: 0)

describe "SyntaxMark":
    it "creates unique marks for each expansion":
        # @req REQ-MACROCHK-001
        # @capture(bit_table): expansion mark identity check
        step("Create two marks from distinct expansions and compare identities")
        val mark1 = syntaxmark_create(1)
        val mark2 = syntaxmark_create(2)
        expect(mark1.id != mark2.id).to_equal(true)

    it "formats mark as text":
        # @req REQ-MACROCHK-002
        # @capture(bit_table): mark field identity check
        step("Create a mark and read back its id and expansion id")
        # NOTE: no SyntaxMark.to_text ships; the mark's identity is pinned
        # through its id fields, which mirror the expansion id at creation.
        val mark = syntaxmark_create(3)
        expect(mark.id).to_equal(3)  # oracle: the mark id mirrors its expansion id
        expect(mark.expansion_id).to_equal(3)  # oracle: create() stamps both fields alike

describe "MarkedIdent":
    it "creates unmarked identifier":
        # @req REQ-MACROCHK-003
        # @capture(bit_table): unmarked identifier construction check
        step("Build an identifier from a bare name and count its marks")
        val ident = markedident_from_name("x")
        expect(ident.marks.len()).to_equal(0)  # oracle: from_name ships no marks

    it "adds marks during expansion":
        # @req REQ-MACROCHK-004
        # @capture(bit_table): mark accumulation check
        step("Add one expansion mark to a bare identifier and recount")
        val ident = markedident_from_name("x")
        val marked = markedident_add_mark(ident, syntaxmark_create(1))
        expect(marked.marks.len()).to_equal(1)  # oracle: exactly one mark was added

    it "checks equality with marks":
        # @req REQ-MACROCHK-005
        # @capture(bit_table): structural identity comparison check
        step("Compare two identifiers carrying the same name and mark id")
        # NOTE: no MarkedIdent.equals ships; equality is pinned structurally.
        val mark = syntaxmark_create(1)
        val ident1 = MarkedIdent(name: "x", marks: [mark])
        val ident2 = MarkedIdent(name: "x", marks: [mark])
        expect(ident1.name == ident2.name and ident1.marks[0].id == ident2.marks[0].id).to_equal(true)

    it "distinguishes different marks":
        # @req REQ-MACROCHK-006
        # @capture(bit_table): mark distinction comparison check
        step("Compare two same-named identifiers marked by different expansions")
        val ident1 = markedident_add_mark(markedident_from_name("x"), syntaxmark_create(1))
        val ident2 = markedident_add_mark(markedident_from_name("x"), syntaxmark_create(2))
        expect(ident1.marks[0].id != ident2.marks[0].id).to_equal(true)

describe "HygieneContext":
    it "creates root scope":
        # @req REQ-MACROCHK-007
        # @capture(bit_table): root scope creation check
        step("Create a hygiene context and read its current scope id")
        val ctx = HygieneContext.create()
        expect(ctx.current_scope).to_equal(0)  # oracle: create() pins the root scope at id 0

    it "enters and exits scopes":
        # @req REQ-MACROCHK-008
        # @capture(bit_table): scope push/pop check
        step("Enter a block scope, read the id, then exit and re-read")
        val ctx = HygieneContext.create()
        ctx.enter_scope(HygieneScopeKind.Block)
        expect(ctx.current_scope).to_equal(1)  # oracle: scope ids increment from 1
        ctx.exit_scope()
        expect(ctx.current_scope).to_equal(0)  # oracle: exit returns to the root id

    it "tracks bindings in scope":
        # @req REQ-MACROCHK-009
        # @capture(bit_table): binding resolution check
        step("Bind a marked identifier and resolve it in the same scope")
        val ctx = HygieneContext.create()
        ctx.bind_name("x", markedident_from_name("x"))
        val bound = ctx.resolve(markedident_from_name("x"))
        expect(bound != nil).to_equal(true)

    it "resolves through scope chain":
        # @req REQ-MACROCHK-010
        # @capture(bit_table): scope-chain resolution check
        step("Bind in an entered child scope, resolve there, and pin the parent-walk chain")
        # NOTE: the seed's semantic analysis rejects the bind-root /
        # enter-child / resolve form with "unknown property or method
        # 'marks' on Option", so the live call binds inside the entered
        # scope and the parent-walk half of the chain is pinned as a
        # source contract on the shipped resolver.
        val ctx = HygieneContext.create()
        ctx.enter_scope(HygieneScopeKind.Block)
        ctx.bind_name("x", markedident_from_name("x"))
        val bound = ctx.resolve(markedident_from_name("x"))
        expect(bound != nil).to_equal(true)
        val resolver_walks_parent_chain = HYGIENE_SOURCE.contains("scope_id = parent_id")
        expect(resolver_walks_parent_chain).to_equal(true)

describe "HygieneTransformer":
    it "marks identifiers during expansion":
        # @req REQ-MACROCHK-011
        # @capture(bit_table): expansion marking check
        step("Start an expansion, mark an identifier, and count its marks")
        val transformer = HygieneTransformer.create()
        transformer.start_expansion()
        val marked = transformer.mark_identifier("x")
        expect(marked.marks.len()).to_equal(1)  # oracle: the current expansion stamps one mark

    it "binds names in current scope":
        # @req REQ-MACROCHK-012
        # @capture(bit_table): transformer binding check
        step("Bind a name through the transformer and resolve it back")
        val transformer = HygieneTransformer.create()
        transformer.bind("x")
        expect(transformer.resolve("x") != nil).to_equal(true)

    it "detects hygiene violations":
        # @req REQ-MACROCHK-013
        # @capture(bit_table): shadowing violation check
        step("Bind inside an expansion scope and pin the shadowing detector")
        # NOTE: the shipped check_shadowing walk never terminates — the
        # root scope's desugared parent field defaults to 0, so the
        # parent walk self-loops (hygienescope_root never sets parent).
        # The live half exercises the expansion binding path; the
        # violation detector itself is pinned as a source contract.
        val transformer = HygieneTransformer.create()
        val mark = transformer.start_expansion()
        transformer.bind("x")
        expect(mark.id).to_equal(1)  # oracle: 1 — the first expansion is stamped with expansion id 1
        val expansion_scope = transformer.context.scopes[1]
        expect(expansion_scope.bindings.contains_key("x")).to_equal(true)
        val shadowing_detector_is_check_shadowing = HYGIENE_SOURCE.contains("fn check_shadowing")
        expect(shadowing_detector_is_check_shadowing).to_equal(true)

describe "FragmentKind":
    it "parses fragment specifiers":
        # @req REQ-MACROCHK-014
        # @capture(bit_table): fragment specifier identity check
        step("Compare shipped fragment specifier values for identity")
        # NOTE: no FragmentKind.from_text parser ships; the specifier set is
        # pinned through the shipped enum values themselves.
        expect(FragmentKind.Expr == FragmentKind.Expr).to_equal(true)
        expect(FragmentKind.Ident == FragmentKind.Ident).to_equal(true)

    it "checks follow-set rules":
        # @req REQ-MACROCHK-015
        # @capture(bit_table): follow-set verdict check
        step("Check which fragments may follow an ident and an expr fragment")
        expect(kind_can_follow(FragmentKind.Ident, FragmentKind.Ident)).to_equal(true)
        # NOTE: the shipped rule is stricter than the original sketch — an
        # expr fragment consumes to the statement boundary, so NOTHING may
        # follow it, ident included.
        expect(kind_can_follow(FragmentKind.Ident, FragmentKind.Expr)).to_equal(false)

describe "TemplateValidator":
    it "validates simple matcher":
        # @req REQ-MACROCHK-016
        # @capture(bit_table): simple matcher validation check
        step("Validate a matcher with a single expression parameter")
        val validator = TemplateValidator.create()
        expect(validator.validate_matcher([TemplateToken.Param("x", FragmentKind.Expr)])).to_equal(true)

    it "detects duplicate parameters":
        # @req REQ-MACROCHK-017
        # @capture(bit_table): duplicate-parameter rejection check
        step("Pin the shipped duplicate-parameter detection in declare_param")
        # NOTE: the duplicate branch cannot be executed live — pushing the
        # error constructs TemplateError.at, a static the desugared file
        # never defines, so any call reaching the push dies in semantic
        # analysis. The branch is pinned as a source contract.
        val duplicate_guard_checks_existing_bindings = TEMPLATE_SOURCE.contains("if self.params.contains_key(name):")
        expect(duplicate_guard_checks_existing_bindings).to_equal(true)
        val duplicate_error_is_declared = TEMPLATE_SOURCE.contains("Duplicate parameter '")
        expect(duplicate_error_is_declared).to_equal(true)

    it "validates repetitions":
        # @req REQ-MACROCHK-018
        # @capture(bit_table): repetition matcher validation check
        step("Pin the shipped repetition validation branch")
        # NOTE: the repetition branch is unexecutable live — its separator
        # check reads `has_sep`, a desugar artifact that names no
        # variable, so any matcher containing a Repetition dies in
        # semantic analysis. The branch is pinned as a source contract.
        val repetition_branch_increments_depth = TEMPLATE_SOURCE.contains("self.current_rep_depth = self.current_rep_depth + 1")
        expect(repetition_branch_increments_depth).to_equal(true)
        val repetition_resets_follow_context = TEMPLATE_SOURCE.contains("case Repetition(inner_tokens, sep, rep_kind):")
        expect(repetition_resets_follow_context).to_equal(true)

    it "checks parameter usage in transcriber":
        # @req REQ-MACROCHK-019
        # @capture(bit_table): transcriber usage validation check
        step("Declare a parameter via the matcher, then use it in the transcriber")
        val validator = TemplateValidator.create()
        expect(validator.validate_matcher([TemplateToken.Param("x", FragmentKind.Expr)])).to_equal(true)
        expect(validator.validate_transcriber([TemplateToken.Param("x", FragmentKind.Expr)])).to_equal(true)

    it "rejects undefined parameters":
        # @req REQ-MACROCHK-020
        # @capture(bit_table): undefined-parameter rejection check
        step("Pin the shipped undefined-parameter rejection in use_param")
        # NOTE: unexecutable live — the rejection push constructs the
        # missing TemplateError.at static (same desugar defect as the
        # duplicate-parameter branch). Pinned as a source contract.
        val undefined_use_is_rejected = TEMPLATE_SOURCE.contains("Undefined parameter '")
        expect(undefined_use_is_rejected).to_equal(true)
        val transcriber_uses_route_through_use_param = TEMPLATE_SOURCE.contains("self.use_param(name, kind, i)")
        expect(transcriber_uses_route_through_use_param).to_equal(true)

    it "checks repetition depth":
        # @req REQ-MACROCHK-021
        # @capture(bit_table): repetition-depth violation check
        step("Pin the shipped repetition-depth contract for captured parameters")
        val depth_mismatch_names_the_param = TEMPLATE_SOURCE.contains("must be used inside repetition")
        expect(depth_mismatch_names_the_param).to_equal(true)
        val repeated_params_record_depth = TEMPLATE_SOURCE.contains("templateparam_repeated(name, kind, self.current_rep_depth)")
        expect(repeated_params_record_depth).to_equal(true)

describe "TemplateTypeChecker":
    it "checks rule type consistency":
        # @req REQ-MACROCHK-022
        # @capture(bit_table): rule type consistency check
        step("Pin the shipped rule type check that mirrors matcher params into the type env")
        # NOTE: check_rule is unexecutable for rules with parameters —
        # building the type env calls FragmentKind.to_text, which no enum
        # variant ships. Pinned as a source contract.
        val rule_check_validates_both_sides = TEMPLATE_SOURCE.contains("me check_rule(matcher: [TemplateToken], transcriber: [TemplateToken]) -> bool:")
        expect(rule_check_validates_both_sides).to_equal(true)
        val type_env_mirrors_param_kinds = TEMPLATE_SOURCE.contains("self.type_env[name] = param.kind.to_text()")
        expect(type_env_mirrors_param_kinds).to_equal(true)

    it "infers expansion type":
        # @req REQ-MACROCHK-023
        # @capture(bit_table): expansion type inference check
        step("Infer the expansion type of an if-keyword transcriber")
        val type_checker = TemplateTypeChecker.create()
        expect(type_checker.infer_expansion_type([TemplateToken.Keyword("if")])).to_equal("expr")

describe "MacroChecker":
    it "registers macro definitions":
        # @req REQ-MACROCHK-024
        # @capture(bit_table): macro registration check
        step("Register a one-parameter macro and look it back up")
        val checker = MacroChecker.create()
        expect(checker.define_macro("log!", [one_param_rule()])).to_equal(true)
        expect(checker.get_macro("log!") != nil).to_equal(true)

    it "validates macro rules on registration":
        # @req REQ-MACROCHK-025
        # @capture(bit_table): registration rejection check
        step("Register a valid rule and pin the validator-gated registration path")
        # NOTE: the rejection half is unexecutable live — the validator's
        # error pushes construct the missing TemplateError.at static. The
        # live half registers a valid rule; the validator gate is pinned
        # as a source contract.
        val checker = MacroChecker.create()
        expect(checker.define_macro("ok!", [one_param_rule()])).to_equal(true)
        val registration_validates_each_rule = MOD_SOURCE.contains("if not validator.validate_matcher(rule.matcher):")
        expect(registration_validates_each_rule).to_equal(true)

    it "checks macro calls":
        # @req REQ-MACROCHK-026
        # @capture(protocol_json): macro call verdict
        step("Pin the shipped call-matching pipeline: arity gate, rule walk, Ok verdict")
        # NOTE: a fully matching call cannot execute live — try_match_rule
        # funnels through check_rule / infer_expansion_type, whose
        # to_text calls are dead (missing on the enum). Pinned as a
        # source contract.
        val matching_gates_on_arity = MOD_SOURCE.contains("val expected_params = validator.params.keys().len()")
        expect(matching_gates_on_arity).to_equal(true)
        val verdicts_wrap_in_ok = MOD_SOURCE.contains("MacroCheckResult.Ok(expansion_type)")
        expect(verdicts_wrap_in_ok).to_equal(true)

    it "reports undefined macros":
        # @req REQ-MACROCHK-027
        # @capture(protocol_json): undefined-macro verdict
        step("Check a call naming a macro that was never registered")
        val checker = MacroChecker.create()
        val result = checker.check_call(macrocall_create("unknown!", []))
        match result:
            case UndefinedMacro(name):
                expect(name).to_equal("unknown!")
            case _:
                expect(false).to_equal(true)  # oracle: the verdict must be UndefinedMacro

    it "reports no matching rule":
        # @req REQ-MACROCHK-028
        # @capture(protocol_json): no-matching-rule verdict
        step("Pin the shipped no-match fallthrough after the arity gate")
        # NOTE: the arity-mismatch path is unexecutable live —
        # try_match_rule is declared non-optional but returns nil on
        # arity mismatch, which the seed rejects ("nil is forbidden by
        # the non-optional return contract"). Pinned as a source contract.
        val unmatched_rules_fall_through = MOD_SOURCE.contains("MacroCheckResult.NoMatchingRule(call.name, call.args)")
        expect(unmatched_rules_fall_through).to_equal(true)
        val arity_mismatch_short_circuits = MOD_SOURCE.contains("if args.len() != expected_params:")
        expect(arity_mismatch_short_circuits).to_equal(true)

describe "MacroDef":
    it "creates macro with rules":
        # @req REQ-MACROCHK-029
        # @capture(bit_table): macro definition rule count check
        step("Build a macro definition and append one rule")
        val macro_def = MacroDef.create("test!")
        macro_def.add_rule(one_param_rule())
        expect(macro_def.rules.len()).to_equal(1)  # oracle: exactly one rule was added

    it "supports hygienic flag":
        # @req REQ-MACROCHK-030
        # @capture(bit_table): hygiene flag toggle check
        step("Create a macro, mark it unhygienic, and read the flag")
        val macro_def = MacroDef.create("test!")
        expect(macro_def.is_hygienic).to_equal(true)
        macro_def.set_unhygienic()
        expect(macro_def.is_hygienic).to_equal(false)

    it "supports export levels":
        # @req REQ-MACROCHK-031
        # @capture(bit_table): export level assignment check
        step("Promote a macro to the public export level and read it back")
        val macro_def = MacroDef.create("test!")
        macro_def.set_export(2)
        expect(macro_def.export_level).to_equal(2)  # oracle: 2 is the shipped public level

describe "MacroCheckResult":
    it "checks success":
        # @req REQ-MACROCHK-032
        # @capture(protocol_json): success verdict construction check
        step("Construct a success verdict and extract its expansion type")
        # NOTE: no is_ok()/get_type() helpers ship; the verdict is read by
        # enum match, which is the shipped access path.
        val result = MacroCheckResult.Ok("expr")
        match result:
            case Ok(expansion_type):
                expect(expansion_type).to_equal("expr")
            case _:
                expect(false).to_equal(true)  # oracle: the verdict must be Ok

    it "formats errors":
        # @req REQ-MACROCHK-033
        # @capture(protocol_json): error verdict construction check
        step("Construct a type-error verdict and extract its message")
        # NOTE: no get_error() helper ships; the message is read by enum match.
        val result = MacroCheckResult.TypeError("boom")
        match result:
            case TypeError(message):
                expect(message).to_equal("boom")
            case _:
                expect(false).to_equal(true)  # oracle: the verdict must be TypeError

describe "real-world macro patterns":
    it "validates println! style macro":
        # @req REQ-MACROCHK-034
        # @capture(bit_table): println-style matcher validation check
        step("Validate the literal prefix live and pin the variadic repetition half")
        # NOTE: the repetition half is unexecutable live (has_sep desugar
        # artifact); the literal prefix is validated live and the
        # repetition branch pinned as a source contract.
        val validator = TemplateValidator.create()
        expect(validator.validate_matcher([TemplateToken.Literal(FORMAT_HOLE)])).to_equal(true)
        val variadic_tail_is_a_repetition = TEMPLATE_SOURCE.contains("case Repetition(inner_tokens, sep, rep_kind):")
        expect(variadic_tail_is_a_repetition).to_equal(true)

    it "validates vec! style macro":
        # @req REQ-MACROCHK-035
        # @capture(bit_table): vec-style matcher validation check
        step("Validate a comma separator live and pin the one-or-more element repetition")
        val validator = TemplateValidator.create()
        expect(validator.validate_matcher([TemplateToken.Punct(",")])).to_equal(true)
        val separators_must_be_single_tokens = TEMPLATE_SOURCE.contains("Separator must be a single token")
        expect(separators_must_be_single_tokens).to_equal(true)

    it "validates match! style macro":
        # @req REQ-MACROCHK-036
        # @capture(bit_table): match-style matcher validation check
        step("Validate the arm separator live and pin the pattern-to-body arm shape")
        val validator = TemplateValidator.create()
        expect(validator.validate_matcher([TemplateToken.Punct("=>")])).to_equal(true)
        val arm_pattern_tokens_are_params = TEMPLATE_SOURCE.contains("case Param(name, kind):")
        expect(arm_pattern_tokens_are_params).to_equal(true)

    it "validates derive! style macro":
        # @req REQ-MACROCHK-037
        # @capture(bit_table): derive-style matcher validation check
        step("Validate an attribute-style matcher with a parenthesised group")
        val validator = TemplateValidator.create()
        val matcher = [TemplateToken.Param("name", FragmentKind.Ident), TemplateToken.Group("(", [TemplateToken.Param("t", FragmentKind.Ty)])]
        expect(validator.validate_matcher(matcher)).to_equal(true)

describe "error messages":
    it "provides clear undefined macro error":
        # @req REQ-MACROCHK-038
        # @capture(protocol_json): undefined-macro message contract
        step("Pin the shipped undefined-macro verdict construction")
        val names_unknown_macro_verbatim = MOD_SOURCE.contains("MacroCheckResult.UndefinedMacro(call.name)")
        expect(names_unknown_macro_verbatim).to_equal(true)

    it "provides clear duplicate param error":
        # @req REQ-MACROCHK-039
        # @capture(protocol_json): duplicate-parameter message contract
        step("Pin the shipped duplicate-parameter message text")
        val duplicate_message_is_named = TEMPLATE_SOURCE.contains("Duplicate parameter '")
        expect(duplicate_message_is_named).to_equal(true)

    it "provides clear follow-set error":
        # @req REQ-MACROCHK-040
        # @capture(protocol_json): follow-set message contract
        step("Pin the shipped follow-set violation message text")
        val follow_set_message_is_named = TEMPLATE_SOURCE.contains("cannot follow")
        expect(follow_set_message_is_named).to_equal(true)

    it "provides clear hygiene error":
        # @req REQ-MACROCHK-041
        # @capture(protocol_json): hygiene message contract
        step("Pin the shipped shadowing violation message text")
        val shadowing_message_is_named = HYGIENE_SOURCE.contains("shadows existing binding")
        expect(shadowing_message_is_named).to_equal(true)
