"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/parser/paren_call_block_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Regression spec for paren-form call followed by indented colon-block.
#
# Before the fix, `describe("x"):` with an indented body leaked the trailing
# colon back to the statement parser, producing
#   "parse error: Unexpected token: expected expression, found Colon"
# because parse_with_no_paren_calls only attached a colon-block to plain
# Identifier/FieldAccess/Path callees, not to already-built Call/MethodCall
# expressions.
#
# See: src/compiler_rust/parser/src/expressions/no_paren.rs
# Found via: test/unit/os/kernel/arch/syscall_dispatch_spec.spl (Wave 10B)

use std.spec

describe("paren-form describe block parses"):
    it("accepts describe(string): with indented body"):
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-COMPILER-001
        step("Verify: accepts describe(string): with indented body")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it("accepts it(string): with indented body"):
        # @req: REQ-UNIT-COMPILER-002
        step("Verify: accepts it(string): with indented body")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(true).to_equal(true)

    it("accepts val with type annotation at module level"):
        # @req: REQ-UNIT-COMPILER-003
        step("Verify: accepts val with type annotation at module level")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val X: u64 = 0
        val Y:  u64 = 1
        val Z:                u64 = 2
        expect(X).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(Y).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(Z).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
