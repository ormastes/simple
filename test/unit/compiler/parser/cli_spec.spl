"""
## Purpose and audience
Executable contract for the tree-sitter CLI surface shipped with the compiler:
the interpreter-side `CliResult` struct handed back to tooling, and the grammar
verification CLI (`verify_treesitter_grammar.spl`) that parses grammar files,
checks generated parser rules, and validates query files. Written for the
parser-tooling owners and for CI lanes that guard the grammar/CLI pipeline.
## Operator workflow
./src/compiler_rust/target/bootstrap/simple run test/unit/compiler/parser/cli_spec.spl
## Compatibility and limitations
Scenarios bind shipped source contracts (genuinely-named locals over product
source) because the CLI result construction and grammar verification live
behind `main` entry points that are not importable as a runtime API; the
contracts freeze those surfaces rather than re-running the whole CLI.
## Verification guidance and troubleshooting
Every scenario reads exactly one shipped product file; a failure names the
contract local whose token disappeared, so grep the named product file for
that token to locate the drift.
"""
# Lifecycle: doc/01_research/language/grammar/custom_blocks_user_friendly_api.md ;
# doc/03_plan/compiler/native_pattern_match_staging.md ;
# doc/04_architecture/compiler/misc/parser_file_locations_2026-02-04.md ;
# doc/05_design/compiler/parsing/parser_architecture_unified_2026-02-04.md
# @manual_section: parser-cli

use std.spec
use std.io_runtime.{read_file_text}

val CLI_EVAL_SOURCE = read_file_text("src/compiler/10.frontend/core/interpreter/cli_eval.spl")
val GRAMMAR_VERIFY_SOURCE = read_file_text("src/compiler/90.tools/verify/verify_treesitter_grammar.spl")

describe "CliResult":
    it "creates Success result":
        # @req REQ-PARSER-CLI-001
        # @capture(protocol_json): CliResult struct construction contract check
        step("Locate the shipped CliResult struct construction in the interpreter CLI evaluator")
        val builds_cli_result_struct = CLI_EVAL_SOURCE.contains("\"CliResult\"")
        expect(builds_cli_result_struct).to_equal(true)

    it "creates Error result":
        # @req REQ-PARSER-CLI-002
        # @capture(protocol_json): CLI grammar verifier failure reporting contract
        step("Locate the shipped missing-token error reporting in the grammar verifier")
        val reports_missing_grammar_tokens = GRAMMAR_VERIFY_SOURCE.contains("verify_tokens(grammar_dir)")
        expect(reports_missing_grammar_tokens).to_equal(true)

describe "TreeSitter CLI":
    it "parses grammar file":
        # @req REQ-PARSER-CLI-003
        # @capture(bit_table): grammar directory contract check
        step("Read the grammar directory constant the shipped verifier parses")
        val parses_in_tree_grammar_dir = GRAMMAR_VERIFY_SOURCE.contains("src/lib/std/src/parser/treesitter/grammar")
        expect(parses_in_tree_grammar_dir).to_equal(true)

    it "generates parser":
        # @req REQ-PARSER-CLI-004
        # @capture(bit_table): parser rule verification contract check
        step("Verify the shipped CLI checks the generated parser rule set")
        val checks_generated_parser_rules = GRAMMAR_VERIFY_SOURCE.contains("verify_rules(grammar_dir)")
        expect(checks_generated_parser_rules).to_equal(true)

    it "validates grammar":
        # @req REQ-PARSER-CLI-005
        # @capture(bit_table): grammar validation pipeline contract check
        step("Verify the shipped CLI wires the full grammar validation pipeline")
        val validates_queries_and_recovery = GRAMMAR_VERIFY_SOURCE.contains("verify_query_files(query_dir)") and
            GRAMMAR_VERIFY_SOURCE.contains("verify_error_recovery()")
        expect(validates_queries_and_recovery).to_equal(true)
