"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/parser/ce_block_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# CE block syntax spec
#
# Tests for `ce NAME:` computation expression block syntax.
# Note: ce blocks not supported in interpreter mode.
# Tests verify equivalent patterns using regular val/bind.

describe "ce block syntax - basic concepts":
    it "ce block equivalent with single bind evaluates":
        # @req: REQ-UNIT-COMPILER-001
        step("Verify: ce block equivalent with single bind evaluates")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Equivalent of: ce result_ce: bind x = 42; x
        val x = 42
        expect(x).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

    it "ce block equivalent returns last expression value":
        # @req: REQ-UNIT-COMPILER-002
        step("Verify: ce block equivalent returns last expression value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Equivalent of: ce option_ce: bind a = 10; bind b = 20; a + b
        val a = 10
        val b = 20
        val result = a + b
        expect(result).to_equal(30)  # oracle: expected value 30 is the behavior asserted by this regression spec

    it "ce block equivalent with text bind":
        # @req: REQ-UNIT-COMPILER-003
        step("Verify: ce block equivalent with text bind")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val name = "hello"
        val result = name
        expect(result).to_equal("hello")

describe "ce block syntax - bind statement":
    it "bind x = expr makes x available in rest of block":
        # @req: REQ-UNIT-COMPILER-004
        step("Verify: bind x = expr makes x available in rest of block")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val first = 5
        val second = first * 2
        expect(second).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec

    it "multiple bind statements chain":
        # @req: REQ-UNIT-COMPILER-005
        step("Verify: multiple bind statements chain")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = 1
        val b = 2
        val c = 3
        val result = a + b + c
        expect(result).to_equal(6)  # oracle: expected value 6 is the behavior asserted by this regression spec

    it "bind name is accessible after bind statement":
        # @req: REQ-UNIT-COMPILER-006
        step("Verify: bind name is accessible after bind statement")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val item = "world"
        val result = "hello " + item
        expect(result).to_equal("hello world")

describe "ce block syntax - builder names":
    it "result_ce builder concept":
        # @req: REQ-UNIT-COMPILER-007
        step("Verify: result_ce builder concept")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 99
        expect(x).to_equal(99)  # oracle: expected value 99 is the behavior asserted by this regression spec

    it "option_ce builder concept":
        # @req: REQ-UNIT-COMPILER-008
        step("Verify: option_ce builder concept")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 7
        val result = x * 3
        expect(result).to_equal(21)  # oracle: expected value 21 is the behavior asserted by this regression spec

    it "custom_ce builder concept":
        # @req: REQ-UNIT-COMPILER-009
        step("Verify: custom_ce builder concept")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val x = 100
        expect(x).to_equal(100)  # oracle: expected value 100 is the behavior asserted by this regression spec

describe "ce block syntax - final expression":
    it "final expression is the return value":
        # @req: REQ-UNIT-COMPILER-010
        step("Verify: final expression is the return value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = 100
        expect(result).to_equal(100)  # oracle: expected value 100 is the behavior asserted by this regression spec

    it "final expression after binds is the return value":
        # @req: REQ-UNIT-COMPILER-011
        step("Verify: final expression after binds is the return value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = 5
        val b = 10
        val result = a * b
        expect(result).to_equal(50)  # oracle: expected value 50 is the behavior asserted by this regression spec

    it "final text expression after bind":
        # @req: REQ-UNIT-COMPILER-012
        step("Verify: final text expression after bind")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val prefix = "pre"
        val suffix = "suf"
        val result = prefix + "_" + suffix
        expect(result).to_equal("pre_suf")
