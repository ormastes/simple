"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/parser/desugaring_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
#!/usr/bin/env simple
# Desugaring Transformation Tests
#
# Tests that the desugaring pass correctly transforms async/await/spawn/actor syntax.


describe "Desugaring - Actor to Class":
    it "transforms simple actor to class":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-COMPILER-001
        step("Verify: transforms simple actor to class")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # actor Counter: ... → class Counter: ...
        # Structure should be preserved
        expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "preserves actor methods":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-COMPILER-002
        step("Verify: preserves actor methods")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Actor methods should become class methods
        # All methods should be copied
        expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "preserves actor type parameters":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-COMPILER-003
        step("Verify: preserves actor type parameters")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # actor Worker<T>: ... → class Worker<T>: ...
        # Type parameters should be copied
        expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "preserves actor visibility":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-COMPILER-004
        step("Verify: preserves actor visibility")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # pub actor → pub class
        # Visibility flag should be copied
        expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "preserves actor attributes":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-COMPILER-005
        step("Verify: preserves actor attributes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # @attr actor → @attr class
        # Attributes should be copied
        expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "clears module.actors after transformation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-COMPILER-006
        step("Verify: clears module.actors after transformation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # After desugaring, module.actors should be empty
        # All actors should be in module.classes
        expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

