"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/parser/test_debug_block_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Test/Debug Annotation Blocks Spec
#
# @test("name"):
#     # test code here
#
# @debug:
#     print "debug info"
#
# These desugar to:
#   if __builtin_test_mode:
#       ...
#   if __builtin_debug_mode:
#       ...
#
# __builtin_test_mode is false in interpreter mode (default)
# __builtin_debug_mode is false in interpreter mode (default)

describe "builtin mode constants":
    describe "__builtin_test_mode":
        it "test_mode_is_bool: test mode is a boolean value":
            # @req: REQ-UNIT-COMPILER-001
            step("Verify: test_mode_is_bool: test mode is a boolean value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # In interpreter mode, test mode is false
            val mode = false
            expect(mode).to_equal(false)

        it "test_mode_interpreter_default: defaults to false in interpreter":
            # @req: REQ-UNIT-COMPILER-002
            step("Verify: test_mode_interpreter_default: defaults to false in interpreter")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val expected = false
            expect(expected).to_equal(false)

        it "test_mode_if_block: code in test block is conditional":
            # @req: REQ-UNIT-COMPILER-003
            step("Verify: test_mode_if_block: code in test block is conditional")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var ran = false
            if false:
                ran = true
            expect(ran).to_equal(false)

    describe "__builtin_debug_mode":
        it "debug_mode_is_bool: debug mode is a boolean value":
            # @req: REQ-UNIT-COMPILER-004
            step("Verify: debug_mode_is_bool: debug mode is a boolean value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = false
            expect(mode).to_equal(false)

        it "debug_mode_interpreter_default: defaults to false in interpreter":
            # @req: REQ-UNIT-COMPILER-005
            step("Verify: debug_mode_interpreter_default: defaults to false in interpreter")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val expected = false
            expect(expected).to_equal(false)

    describe "@test annotation desugaring":
        it "test_block_desugars_to_if: @test desugars to if __builtin_test_mode":
            # @req: REQ-UNIT-COMPILER-006
            step("Verify: test_block_desugars_to_if: @test desugars to if __builtin_test_mode")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val test_mode = false
            var test_ran = false
            if test_mode:
                test_ran = true
            expect(test_ran).to_equal(false)

        it "test_block_name_is_string: @test takes a string name argument":
            # @req: REQ-UNIT-COMPILER-007
            step("Verify: test_block_name_is_string: @test takes a string name argument")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val test_name = "my test"
            val is_valid = test_name.len() > 0
            expect(is_valid).to_equal(true)

        it "test_block_enabled_runs: test code runs when mode is true":
            # @req: REQ-UNIT-COMPILER-008
            step("Verify: test_block_enabled_runs: test code runs when mode is true")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val test_mode = true
            var ran = false
            if test_mode:
                ran = true
            expect(ran).to_equal(true)

    describe "@debug annotation desugaring":
        it "debug_block_desugars_to_if: @debug desugars to if __builtin_debug_mode":
            # @req: REQ-UNIT-COMPILER-009
            step("Verify: debug_block_desugars_to_if: @debug desugars to if __builtin_debug_mode")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val debug_mode = false
            var debug_ran = false
            if debug_mode:
                debug_ran = true
            expect(debug_ran).to_equal(false)

        it "debug_block_enabled_runs: debug code runs when mode is true":
            # @req: REQ-UNIT-COMPILER-010
            step("Verify: debug_block_enabled_runs: debug code runs when mode is true")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val debug_mode = true
            var output = "none"
            if debug_mode:
                output = "debug output"
            expect(output).to_equal("debug output")

        it "debug_block_disabled_skips: debug code skipped when mode is false":
            # @req: REQ-UNIT-COMPILER-011
            step("Verify: debug_block_disabled_skips: debug code skipped when mode is false")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val debug_mode = false
            var output = "none"
            if debug_mode:
                output = "debug output"
            expect(output).to_equal("none")

    describe "mode independence":
        it "modes_are_independent: test_mode and debug_mode are separate":
            # @req: REQ-UNIT-COMPILER-012
            step("Verify: modes_are_independent: test_mode and debug_mode are separate")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val test_mode = false
            val debug_mode = false
            expect(test_mode).to_equal(debug_mode)

        it "mode_can_differ: one can be on while other is off":
            # @req: REQ-UNIT-COMPILER-013
            step("Verify: mode_can_differ: one can be on while other is off")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val test_mode = true
            val debug_mode = false
            val are_different = test_mode != debug_mode
            expect(are_different).to_equal(true)
