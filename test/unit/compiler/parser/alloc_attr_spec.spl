"""
## Purpose and audience
Purpose: Prove that #[alloc] attribute.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-PARSER-001 — stable requirement identity for this spec.

# Allocation attribute spec
#
# Tests for @alloc and @no_alloc function-level attributes (Phase 2).
# These attributes annotate whether a function performs allocation.
# In Phase 2 they are recognized and stored but not enforced.

struct Widget:
    id: i64
    name: text

@alloc
fn create_widget(id: i64, name: text) -> Widget:
    Widget(id: id, name: name)

@no_alloc
fn add_pure(a: i64, b: i64) -> i64:
    a + b

fn plain_fn(x: i64) -> i64:
    x * 2

use std.spec.step

describe "#[alloc] attribute":
    it "parses without error on a function":
        step("Verify: parses without error on a function")
        # @req: REQ-COMPILER-PARSER-001
        val w = create_widget(1, "test")
        expect(w.id).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(w.name).to_equal("test")

    it "function with #[alloc] returns correct value":
        step("Verify: function with #[alloc] returns correct value")
        val w = create_widget(42, "hello")
        expect(w.id).to_equal(42)  # oracle: 42 — named expected value from the requirement

    it "function with #[alloc] works with new keyword":
        step("Verify: function with #[alloc] works with new keyword")
        val w = new create_widget(7, "alloc")
        expect(w.id).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(w.name).to_equal("alloc")

describe "#[no_alloc] attribute":
    it "parses without error on a function":
        step("Verify: parses without error on a function")
        val result = add_pure(3, 4)
        expect(result).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "function with #[no_alloc] returns correct value":
        step("Verify: function with #[no_alloc] returns correct value")
        val result = add_pure(100, 200)
        expect(result).to_equal(300)  # oracle: 300 — named expected value from the requirement

    it "function with #[no_alloc] works with new keyword":
        step("Verify: function with #[no_alloc] works with new keyword")
        val result = new add_pure(10, 20)
        expect(result).to_equal(30)  # oracle: 30 — named expected value from the requirement

    it "function with #[no_alloc] works without new keyword":
        step("Verify: function with #[no_alloc] works without new keyword")
        val result = add_pure(5, 5)
        expect(result).to_equal(10)  # oracle: 10 — named expected value from the requirement

describe "combination of alloc attributes and new":
    it "#[alloc] function called with new returns correct value":
        step("Verify: #[alloc] function called with new returns correct value")
        val w = new create_widget(99, "combo")
        expect(w.id).to_equal(99)  # oracle: 99 — named expected value from the requirement
        expect(w.name).to_equal("combo")

    it "plain function without attributes still works":
        step("Verify: plain function without attributes still works")
        val result = plain_fn(5)
        expect(result).to_equal(10)  # oracle: 10 — named expected value from the requirement

    it "plain function works with new":
        step("Verify: plain function works with new")
        val result = new plain_fn(8)
        expect(result).to_equal(16)  # oracle: 16 — named expected value from the requirement
