"""
## Purpose and audience
Purpose: Prove that TreeSitter Outline Parsing.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-PARSER-001 — stable requirement identity for this spec.

# TreeSitter Specification
#
# **Feature IDs:** #TS-CORE-001
# **Category:** Compiler | Parser
# **Status:** Active
# @cover src/compiler/10.frontend/treesitter.spl 80%
#
# Core outline parsing tests — TreeSitter.new(source).parse_outline()

use compiler.treesitter.*


use std.spec.step

describe "TreeSitter Outline Parsing", tag: ["only-compiled"]:
    it "parses single function":
        step("Verify: parses single function")
        # @req: REQ-COMPILER-PARSER-001
        val src = "fn main() -> i64:\n    0\n"
        var ts = TreeSitter.new(src)
        val outline = ts.parse_outline()
        expect(outline.functions.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "finds function name":
        step("Verify: finds function name")
        val src = "fn hello():\n    42\n"
        var ts = TreeSitter.new(src)
        val outline = ts.parse_outline()
        expect(outline.functions[0].name).to_equal("hello")

    it "parses class declaration":
        step("Verify: parses class declaration")
        val src = "class Point:\n    x: i64\n    y: i64\n"
        var ts = TreeSitter.new(src)
        val outline = ts.parse_outline()
        expect(outline.classes.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "parses multiple declarations":
        step("Verify: parses multiple declarations")
        val src = "fn a():\n    1\n\nfn b():\n    2\n\nclass C:\n    v: i64\n"
        var ts = TreeSitter.new(src)
        val outline = ts.parse_outline()
        expect(outline.functions.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(outline.classes.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "handles empty source":
        step("Verify: handles empty source")
        var ts = TreeSitter.new("")
        val outline = ts.parse_outline()
        expect(outline.functions.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(outline.classes.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "captures canonical asm block outline without warning":
        step("Verify: captures canonical asm block outline without warning")
        val src = "fn test():\n    asm { cli }\n"
        var ts = TreeSitter.new(src)
        val outline = ts.parse_outline()
        expect(outline.asm_blocks.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(outline.asm_blocks[0].payload).to_equal("cli")
        expect(outline.asm_blocks[0].syntax_form).to_equal("braced")
        expect(outline.asm_blocks[0].is_legacy).to_equal(false)
        expect(outline.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "captures volatile asm block with ARM hash immediate":
        step("Verify: captures volatile asm block with ARM hash immediate")
        val src = "fn test():\n    asm volatile { bkpt #0 }\n"
        var ts = TreeSitter.new(src)
        val outline = ts.parse_outline()
        expect(outline.asm_blocks.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(outline.asm_blocks[0].is_volatile).to_equal(true)
        expect(outline.asm_blocks[0].payload).to_equal("bkpt #0")

    it "captures RISC-V asm operands with commas":
        step("Verify: captures RISC-V asm operands with commas")
        val src = "fn test():\n    asm { fence rw, rw }\n"
        var ts = TreeSitter.new(src)
        val outline = ts.parse_outline()
        expect(outline.asm_blocks[0].payload).to_equal("fence rw, rw")

    it "keeps placeholder braces inside asm content":
        step("Verify: keeps placeholder braces inside asm content")
        val src = "fn test():\n    asm { mov {out}, eax }\n"
        var ts = TreeSitter.new(src)
        val outline = ts.parse_outline()
        expect(outline.asm_blocks[0].payload).to_equal("mov {{out}}, eax")

    it "warns for legacy parenthesized asm":
        step("Verify: warns for legacy parenthesized asm")
        val src = "fn test():\n    asm(\"nop\")\n"
        var ts = TreeSitter.new(src)
        val outline = ts.parse_outline()
        expect(outline.asm_blocks.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(outline.asm_blocks[0].is_legacy).to_equal(true)
        expect(outline.asm_blocks[0].syntax_form).to_equal("paren")
        expect(outline.errors.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "warns for legacy colon asm":
        step("Verify: warns for legacy colon asm")
        val src = "fn test():\n    asm: \"nop\"\n"
        var ts = TreeSitter.new(src)
        val outline = ts.parse_outline()
        expect(outline.asm_blocks.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(outline.asm_blocks[0].syntax_form).to_equal("colon_string")
        expect(outline.errors.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
