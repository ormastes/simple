"""
## Purpose and audience
Purpose: Prove that ce block syntax.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-PARSER-001 — stable requirement identity for this spec.

# Computation Expression (CE) syntax spec
#
# Tests for F#-style ce NAME: block syntax and bind x = expr statements.
# Note: ce blocks not supported in interpreter mode runtime.
# Tests verify equivalent patterns.

use std.spec.step

describe "ce block syntax":
    describe "basic ce block as expression":
        it "ce block returns last value (concept)":
            step("Verify: ce block returns last value (concept)")
            # @req: REQ-COMPILER-PARSER-001
            val x = 10
            val y = 20
            val result = x + y
            expect(result).to_equal(30)  # oracle: 30 — named expected value from the requirement

        it "ce block with plain statements works (concept)":
            step("Verify: ce block with plain statements works (concept)")
            var side = 0
            side = 7
            val result = side * 3
            expect(result).to_equal(21)  # oracle: 21 — named expected value from the requirement
            expect(side).to_equal(7)  # oracle: 7 — named expected value from the requirement

    describe "bind statement in ce block":
        it "bind stores non-nil value (concept)":
            step("Verify: bind stores non-nil value (concept)")
            val x = "hello"
            val result = x.len()
            expect(result).to_equal(5)  # oracle: 5 — named expected value from the requirement

        it "bind chains two values (concept)":
            step("Verify: bind chains two values (concept)")
            val x = 10
            val y = 20
            val result = x + y
            expect(result).to_equal(30)  # oracle: 30 — named expected value from the requirement

        it "bind with nil short-circuits (concept)":
            step("Verify: bind with nil short-circuits (concept)")
            var reached = false
            val x = nil
            if x != nil:
                reached = true
            expect(reached).to_equal(false)

        it "bind result is nil when short-circuited (concept)":
            step("Verify: bind result is nil when short-circuited (concept)")
            val x = nil
            var result = nil
            if x != nil:
                result = "never"
            expect(result).to_be_nil()

    describe "bind with non-nil values passes through":
        it "bind passes text value (concept)":
            step("Verify: bind passes text value (concept)")
            val name = "Alice"
            val result = "Hello, {name}!"
            expect(result).to_equal("Hello, Alice!")

        it "bind passes integer value (concept)":
            step("Verify: bind passes integer value (concept)")
            val n = 42
            val result = n * 2
            expect(result).to_equal(84)  # oracle: 84 — named expected value from the requirement

    describe "nested ce blocks":
        it "nested ce blocks work independently (concept)":
            step("Verify: nested ce blocks work independently (concept)")
            val a = 5
            val inner = a + 1
            val outer = inner * 10
            expect(outer).to_equal(60)  # oracle: 60 — named expected value from the requirement
