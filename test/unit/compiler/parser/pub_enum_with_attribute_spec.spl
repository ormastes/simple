"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-COMPILER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/compiler/parser/pub_enum_with_attribute_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-COMPILER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Regression: parser must accept `@attr` followed by `pub enum`
#
# Prior bug: `parse_pub_item_with_attrs` only handled fn/struct/class/mixin/mod,
# rejecting `pub enum` and `pub union` after attributes with:
#   "Unexpected token: expected fn, struct, class, mixin, or mod after pub with
#    attributes, found Enum"
#
# Trigger from stdlib: src/compiler_rust/lib/std/src/core/json.spl had
#   @cfg(hosted)
#   pub enum JsonValue:
# which failed to parse, cascading to every test that imports `std.spec`.

@doc("Parser regression enum")
pub enum Color:
    Red
    Green
    Blue

@doc("Parser regression shape enum")
pub enum Shape:
    Circle(f64)
    Square(f64)
    Rectangle(f64, f64)

@doc("Parser regression tagged union")
pub union Tagged:
    Int(i64)
    Text(text)

describe "pub enum with attribute":
    "Regression suite covering the `@attr pub enum` parser path."

    it "parses a known attribute followed by pub enum":
        # @req: REQ-UNIT-COMPILER-001
        step("Verify: parses a known attribute followed by pub enum")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        "Simple unit-variant enum after an attribute must parse."
        val c = Color.Red
        expect(c).to_equal(Color.Red)

    it "parses a known attribute followed by pub enum with data variants":
        # @req: REQ-UNIT-COMPILER-002
        step("Verify: parses a known attribute followed by pub enum with data variants")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        "Data-variant enum after an attribute must parse."
        val s = Shape.Circle(2.0)
        expect(s).to_equal(Shape.Circle(2.0))

    it "parses a known attribute followed by pub union":
        # @req: REQ-UNIT-COMPILER-003
        step("Verify: parses a known attribute followed by pub union")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        "Public union (enum alias) after an attribute must parse."
        val t = Tagged.Int(42)
        expect(t).to_equal(Tagged.Int(42))
