"""
## Purpose and audience
Purpose: Prove that associated types.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-PARSER-001 — stable requirement identity for this spec.

# Associated types spec
#
# Tests for type aliases within struct contexts.
# Associated types allow structs and traits to define type aliases
# that can be used in their method signatures.

# Struct with type alias using 'type' keyword (at module level, works fine)
type ItemType = i64
type KeyType = text

struct IntList:
    items: [i64]

    fn size() -> i64:
        self.items.len()

    fn get(idx: i64) -> i64:
        self.items[idx]

struct TextMap:
    keys: [text]
    values: [text]

    fn count() -> i64:
        self.keys.len()

use std.spec.step

describe "associated types":
    it "struct with associated type alias works":
        step("Verify: struct with associated type alias works")
        # @req: REQ-COMPILER-PARSER-001
        val x: ItemType = 42
        expect(x).to_equal(42)  # oracle: 42 — named expected value from the requirement

    it "struct fields are accessible":
        step("Verify: struct fields are accessible")
        val list = IntList(items: [1, 2, 3])
        expect(list.size()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "struct item access via type alias":
        step("Verify: struct item access via type alias")
        val list = IntList(items: [10, 20])
        val item: ItemType = list.get(0)
        expect(item).to_equal(10)  # oracle: 10 — named expected value from the requirement

    it "key type alias works with text struct":
        step("Verify: key type alias works with text struct")
        val key: KeyType = "hello"
        expect(key.len()).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "struct with key/value works":
        step("Verify: struct with key/value works")
        val m = TextMap(keys: ["a", "b"], values: ["1", "2"])
        expect(m.count()).to_equal(2)  # oracle: 2 — named expected value from the requirement
