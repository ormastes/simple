# @req: REQ-COMPILER-DEEP-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/compiler/deep/registry_type_3_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

# @req: REQ-CMP-COMPILER_ANALYSIS-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/compiler_analysis_behavior.md
# doc-path: doc/03_plan/sys_test/compiler_analysis_behavior.md
# doc-path: doc/04_architecture/lib/compiler_analysis.md
# doc-path: doc/05_design/lib/compiler_analysis_oracles.md
# @manual: primary

use std.spec
use compiler.35.semantics.lint.semantic_api.alias_registry.{alias_registry_clear, alias_registry_resolve}
use std.spec.step

# doc-path: doc/01_research/local/registry_type_3.md
# doc-path: doc/03_plan/sys_test/registry_type_3.md
# doc-path: doc/04_architecture/registry_type_3.md
# doc-path: doc/05_design/registry_type_3.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "for-range iterates the half-open span":
        step("Verify: for-range iterates the half-open span")
        # @req: REQ-COMPILER-DEEP-001
        # @req: REQ-CMP-COMPILER_ANALYSIS-001
        var seen = 0
        for i in 0..4:
            seen = seen + 1
        expect(seen).to_equal(4)  # oracle: 0..4 yields four iterations

    it "string split, join and repeat":
        step("Verify: string split, join and repeat")
        # @req: REQ-COMPILER-DEEP-001
        expect("a,b,c".split(",")).to_equal(["a", "b", "c"])
        expect("ha".repeat(3)).to_equal("hahaha")
        expect("ab".reverse()).to_equal("ba")

    it "for-in accumulates array elements":
        step("Verify: for-in accumulates array elements")
        # @req: REQ-COMPILER-DEEP-001
        var s = 0
        for x in [1, 2, 3]:
            s = s + x
        expect(s).to_equal(6)  # oracle: 1+2+3

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "gzip compression roundtrip":
        step("Verify: gzip compression roundtrip")
        # @req: REQ-COMPILER-DEEP-001
        use std.common.compress.gzip.{gzip_compress, gzip_decompress}
        val data = "hello hello hello hello".bytes()
        val packed = gzip_compress(data)
        expect(packed.len() > 0).to_equal(true)
        expect(gzip_decompress(packed)).to_equal(data)
        expect(packed.len() < data.len())  # oracle: repeated text compresses

    it "boolean operators short-circuit to expected truth table":
        step("Verify: boolean operators short-circuit to expected truth table")
        # @req: REQ-COMPILER-DEEP-001
        expect(true and false).to_equal(false)
        expect(true or false).to_equal(true)
        expect(not true).to_equal(false)

    it "string predicates and slicing":
        step("Verify: string predicates and slicing")
        # @req: REQ-COMPILER-DEEP-001
        expect("test.spl".ends_with(".spl")).to_equal(true)
        expect("hello world".contains("lo w")).to_equal(true)
        expect("hello world".len()).to_equal(11)  # oracle: 11 ASCII characters
        expect("abc".slice(0, 2)).to_equal("ab")
