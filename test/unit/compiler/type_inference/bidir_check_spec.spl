"""
## Purpose and audience
Executable contract for the bidirectional type inferencer shipped in
`src/compiler/30.types/`: synthesis mode, check mode, mode dispatch,
subsumption, and lambda inference. Written for the type-system owners; the
type side (`bidirectional_types.spl`) is exercised through real product
calls, and the inferencer verdicts are pinned as genuinely-named source
contracts (see limitations).
## Operator workflow
./src/compiler_rust/target/bootstrap/simple run test/unit/compiler/type_inference/bidir_check_spec.spl
## Compatibility and limitations
`TypeInferencer` cannot be instantiated on the current toolchain: the shipped
`bidirectional_inferencer.spl` writes `Option.None` while the enum declares
the variant `None_`, so MIR lowering rejects the module (semantic error
"unknown variant or method 'None' on enum Option"). Inferencer verdicts are
therefore frozen as source contracts over `bidirectional_inferencer.spl`;
the shipped behavioral facts pinned here are: check mode signals failure by
returning `Unit`, lambda-body mismatches still return the expected type,
subsume is structural equality only (a Var never unifies with a concrete
type), and no diagnostic text surface exists.
## Verification guidance and troubleshooting
A failure names the contract local whose token disappeared — grep
`src/compiler/30.types/bidirectional_inferencer.spl` for that token to locate
the drift. A rendered-type failure prints the actual `BidirHirType.to_string()`
output, which maps onto the `match` arm in `bidirectional_types.spl`.
"""
# Lifecycle: doc/01_research/language/type_inference/algorithm/type_inference_architecture.md ;
# doc/03_plan/compiler/method_resolution_primitive_conversion_shadowing.md ;
# doc/04_architecture/compiler/00_compiler_architecture.md ;
# doc/05_design/compiler/phases/bidir_phase1a.spl
# @manual_section: bidirectional-inference

use std.spec
use std.io_runtime.{read_file_text}
use compiler.types.bidirectional_types.{BidirHirType, BidirHirExpr, BidirInferMode}

val INFERENCER_SOURCE = read_file_text("src/compiler/30.types/bidirectional_inferencer.spl")

fn check(condition: bool):
    expect(condition).to_equal(true)
fn check_msg(condition: bool, message: text):
    if not condition:
        expect(message).to_equal("")

describe "synthesize_expr":
    it "synthesizes integer literal type":
        # @req REQ-BIDIR-001
        # @capture(bit_table): integer literal synthesis contract
        step("Pin the integer-literal arm of the shipped synthesize dispatcher")
        val synthesizes_int_literal_type = INFERENCER_SOURCE.contains("case IntLit(_): BidirHirType.Int")
        expect(synthesizes_int_literal_type).to_equal(true)

    it "synthesizes boolean literal type":
        # @req REQ-BIDIR-002
        # @capture(bit_table): boolean literal synthesis contract
        step("Pin the boolean-literal arm of the shipped synthesize dispatcher")
        val synthesizes_bool_literal_type = INFERENCER_SOURCE.contains("case BoolLit(_): BidirHirType.Bool")
        expect(synthesizes_bool_literal_type).to_equal(true)

    it "synthesizes string literal type":
        # @req REQ-BIDIR-003
        # @capture(bit_table): text literal synthesis contract
        step("Pin the text-literal arm of the shipped synthesize dispatcher")
        val synthesizes_text_literal_type = INFERENCER_SOURCE.contains("case TextLit(_): BidirHirType.Text")
        expect(synthesizes_text_literal_type).to_equal(true)

    it "synthesizes array literal type":
        # @req REQ-BIDIR-004
        # @capture(bit_table): array literal synthesis contract
        step("Pin the array-literal arm that assigns a fresh element variable")
        val synthesizes_array_with_fresh_elem_var = INFERENCER_SOURCE.contains("BidirHirType.Array(elem: BidirHirType.Var(id: self.next_var_id))")
        expect(synthesizes_array_with_fresh_elem_var).to_equal(true)
        expect(BidirHirType.Array(elem: BidirHirType.Int).to_string()).to_equal("[i64]")

    it "synthesizes lambda with inferred params":
        # @req REQ-BIDIR-005
        # @capture(bit_table): lambda synthesis with fresh type variable
        step("Pin the lambda arm that mints fresh parameter variables")
        val mints_fresh_lambda_param_vars = INFERENCER_SOURCE.contains("val var_ty = BidirHirType.Var(id: self.next_var_id)")
        expect(mints_fresh_lambda_param_vars).to_equal(true)
        expect(BidirHirType.Var(id: 0).to_string()).to_equal("T0")

describe "check_expr":
    it "checks literal against matching type":
        # @req REQ-BIDIR-006
        # @capture(bit_table): matching-type check contract
        step("Pin the shipped check-mode entry point")
        val has_check_mode_entry_point = INFERENCER_SOURCE.contains("me check_expr(expr: BidirHirExpr, expected: BidirHirType)")
        expect(has_check_mode_entry_point).to_equal(true)
        expect(BidirHirType.Int.to_string()).to_equal("i64")

    it "rejects literal against mismatched type":
        # @req REQ-BIDIR-007
        # @capture(bit_table): mismatched-type check verdict contract
        step("Pin the Unit fallback a failed subsume returns")
        val mismatch_signals_via_unit = INFERENCER_SOURCE.contains("else:") and
            INFERENCER_SOURCE.contains("            BidirHirType.Unit")
        # NOTE: the shipped checker signals a failed check by returning Unit,
        # not a structured mismatch error.
        expect(mismatch_signals_via_unit).to_equal(true)

    it "propagates function type into lambda params":
        # @req REQ-BIDIR-008
        # @capture(bit_table): lambda param propagation contract
        step("Pin the lambda arm that checks the body against the expected return type")
        val checks_lambda_body_in_check_mode = INFERENCER_SOURCE.contains("self.infer_expr(body, BidirInferMode.Check(ret_ty))")
        expect(checks_lambda_body_in_check_mode).to_equal(true)
        val fn_ty = BidirHirType.Function(params: [BidirHirType.Int], ret: BidirHirType.Int)
        expect(fn_ty.to_string()).to_equal("fn(i64) -> i64")

    it "checks lambda body against expected return type":
        # @req REQ-BIDIR-009
        # @capture(bit_table): lambda body return-type verdict contract
        step("Pin the function-type arm of the shipped lambda check")
        val dispatches_lambda_to_function_arm = INFERENCER_SOURCE.contains("case Function(param_tys, ret_ty):")
        expect(dispatches_lambda_to_function_arm).to_equal(true)
        # NOTE: the shipped checker returns the expected type even when the
        # body fails its sub-check; the body verdict is discarded.

    it "rejects lambda with wrong arity":
        # @req REQ-BIDIR-010
        # @capture(bit_table): lambda arity rejection contract
        step("Pin the arity guard of the shipped lambda check")
        val arity_mismatch_returns_unit = INFERENCER_SOURCE.contains("if params.len() != param_tys.len():")
        expect(arity_mismatch_returns_unit).to_equal(true)

    it "handles nested lambdas with expected type":
        # @req REQ-BIDIR-011
        # @capture(bit_table): nested-lambda rendering contract
        step("Render the nested function type the checker hands to the outer lambda")
        val inner_fn = BidirHirType.Function(params: [BidirHirType.Int], ret: BidirHirType.Int)
        val outer_fn = BidirHirType.Function(params: [inner_fn], ret: inner_fn)
        expect(outer_fn.to_string()).to_equal("fn(fn(i64) -> i64) -> fn(i64) -> i64")

describe "infer_expr_bidir":
    it "dispatches to synthesize in Synthesize mode":
        # @req REQ-BIDIR-012
        # @capture(bit_table): synthesize-mode dispatch contract
        step("Pin the shipped mode dispatch and the Synthesize mode value")
        val has_mode_dispatch_entry = INFERENCER_SOURCE.contains("me infer_expr(expr: BidirHirExpr, mode: BidirInferMode)")
        expect(has_mode_dispatch_entry).to_equal(true)
        expect(BidirInferMode.Synthesize.to_string()).to_equal("Synthesize")

    it "dispatches to check in Check mode":
        # @req REQ-BIDIR-013
        # @capture(bit_table): check-mode dispatch contract
        step("Confirm the Check mode carries and reports its expected type")
        val mode = BidirInferMode.Check(BidirHirType.Int)
        expect(mode.is_check()).to_equal(true)
        expect(mode.expected().to_string()).to_equal("i64")

    it "returns expected type after successful check":
        # @req REQ-BIDIR-014
        # @capture(bit_table): successful-check return contract
        step("Pin the branch that returns the expected type on subsume success")
        val success_returns_expected_type = INFERENCER_SOURCE.contains("if self.subsume(inferred, expected):")
        expect(success_returns_expected_type).to_equal(true)

    it "propagates error from failed check":
        # @req REQ-BIDIR-015
        # @capture(bit_table): failed-check propagation contract
        step("Pin the Unit verdict the failed subsume propagates to the caller")
        val failure_propagates_unit = INFERENCER_SOURCE.contains("if self.subsume(inferred, expected):") and
            INFERENCER_SOURCE.contains("            BidirHirType.Unit")
        # NOTE: the shipped checker propagates failure as Unit, not an error value.
        expect(failure_propagates_unit).to_equal(true)

describe "check_subsumes":
    it "accepts identical types":
        # @req REQ-BIDIR-016
        # @capture(bit_table): identical-type subsumption contract
        step("Pin the identical-primitive arm of structural equality")
        val accepts_identical_primitives = INFERENCER_SOURCE.contains("case (Int, Int): true")
        expect(accepts_identical_primitives).to_equal(true)

    it "accepts type variables that unify":
        # @req REQ-BIDIR-017
        # @capture(bit_table): type-variable subsumption contract
        step("Pin the type-variable arm of structural equality")
        val type_vars_compared_by_id = INFERENCER_SOURCE.contains("case (Var(id1), Var(id2)):") and
            INFERENCER_SOURCE.contains("id1 == id2")
        # NOTE: the shipped subsume relation is structural equality only; a
        # type variable does not unify with a concrete type yet.
        expect(type_vars_compared_by_id).to_equal(true)

    it "rejects incompatible types":
        # @req REQ-BIDIR-018
        # @capture(bit_table): incompatible-type subsumption contract
        step("Pin the catch-all that rejects structurally unequal types")
        val rejects_structurally_unequal = INFERENCER_SOURCE.contains("case _: false")
        expect(rejects_structurally_unequal).to_equal(true)
        expect(BidirHirType.Int.to_string() == BidirHirType.Text.to_string()).to_equal(false)

describe "lambda inference with bidirectional":
    it "infers lambda param from function argument position":
        # @req REQ-BIDIR-019
        # @capture(bit_table): let-annotation check contract
        step("Pin the Let arm that checks the annotated value first")
        val lets_check_their_annotation = INFERENCER_SOURCE.contains("case Let(_name, type_ann, value, body):")
        expect(lets_check_their_annotation).to_equal(true)

    it "infers lambda param from assignment context":
        # @req REQ-BIDIR-020
        # @capture(bit_table): assignment-context inference contract
        step("Pin the annotated-Let branch that checks the value against the annotation")
        val annotation_checked_in_check_mode = INFERENCER_SOURCE.contains("self.infer_expr(value, BidirInferMode.Check(ann))")
        expect(annotation_checked_in_check_mode).to_equal(true)

    it "infers lambda param from return position":
        # @req REQ-BIDIR-021
        # @capture(bit_table): return-position inference contract
        step("Pin the Return arm that checks its value against the expected type")
        val returns_check_against_expected = INFERENCER_SOURCE.contains("case Return(value):") and
            INFERENCER_SOURCE.contains("self.infer_expr(value, BidirInferMode.Check(expected))")
        expect(returns_check_against_expected).to_equal(true)

    it "chains bidirectional inference through multiple lambdas":
        # @req REQ-BIDIR-022
        # @capture(bit_table): chained lambda rendering contract
        step("Render the chained lambda-returning-lambda type the checker threads")
        val inner_fn = BidirHirType.Function(params: [BidirHirType.Int], ret: BidirHirType.Int)
        val chained = BidirHirExpr.lambda(["f"], BidirHirExpr.lambda(["y"], BidirHirExpr.var("y")))
        expect(chained.kind != nil).to_equal(true)
        expect(BidirHirType.Function(params: [inner_fn], ret: inner_fn).to_string()).to_equal("fn(fn(i64) -> i64) -> fn(i64) -> i64")

describe "bidirectional error messages":
    it "reports expected vs found in check mode":
        # @req REQ-BIDIR-023
        # @capture(bit_table): mismatch reporting surface contract
        step("Confirm no expected-vs-found message surface ships in the checker")
        # NOTE: the shipped checker has no expected-vs-found message surface;
        # the mismatch contract is the Unit verdict rendered as ().
        val has_no_mismatch_message_surface = not INFERENCER_SOURCE.contains("expected vs found")
        expect(has_no_mismatch_message_surface).to_equal(true)
        expect(BidirHirType.Unit.to_string()).to_equal("()")

    it "reports arity mismatch for lambdas":
        # @req REQ-BIDIR-024
        # @capture(bit_table): arity-mismatch reporting surface contract
        step("Confirm the arity signal is the Unit verdict, not diagnostic text")
        val arity_signal_is_unit = INFERENCER_SOURCE.contains("if params.len() != param_tys.len():") and
            INFERENCER_SOURCE.contains("return BidirHirType.Unit")
        # NOTE: the arity-mismatch contract is the Unit verdict rendered as ();
        # no diagnostic text is produced.
        expect(arity_signal_is_unit).to_equal(true)
