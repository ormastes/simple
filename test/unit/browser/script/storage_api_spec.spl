"""
## Purpose and audience
Purpose: Prove that Storage API - Get/Set.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-BROWSER-SCRIPT-001 — stable requirement identity for this spec.

"""
# Storage API Spec

Unit tests for the Simple browser engine Storage API.
"""

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.browser_engine.script.storage_api.{
    BrowserStorage,
    storage_get_item, storage_set_item, storage_remove_item,
    storage_clear, storage_length, storage_key
}

describe "Storage API - Get/Set":
    it "stores and retrieves a value":
        step("Verify: stores and retrieves a value")
        # @req: REQ-BROWSER-SCRIPT-001
        var store = BrowserStorage.new()
        store = storage_set_item(store, "name", "alice")
        val v = storage_get_item(store, "name")
        expect(v ?? "").to_equal("alice")

    it "returns nil for missing key":
        step("Verify: returns nil for missing key")
        val store = BrowserStorage.new()
        val v = storage_get_item(store, "missing")
        expect(v).to_equal(nil)

    it "updates an existing key":
        step("Verify: updates an existing key")
        var store = BrowserStorage.new()
        store = storage_set_item(store, "x", "1")
        store = storage_set_item(store, "x", "2")
        expect(storage_length(store)).to_equal(1)  # oracle: 1 — named expected value from the requirement

describe "Storage API - Remove":
    it "removes an item":
        step("Verify: removes an item")
        var store = BrowserStorage.new()
        store = storage_set_item(store, "a", "1")
        store = storage_remove_item(store, "a")
        val v = storage_get_item(store, "a")
        expect(v).to_equal(nil)

describe "Storage API - Clear":
    it "clears all items":
        step("Verify: clears all items")
        var store = BrowserStorage.new()
        store = storage_set_item(store, "a", "1")
        store = storage_set_item(store, "b", "2")
        store = storage_clear(store)
        expect(storage_length(store)).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "Storage API - Length":
    it "returns zero for empty store":
        step("Verify: returns zero for empty store")
        val store = BrowserStorage.new()
        expect(storage_length(store)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "returns correct count":
        step("Verify: returns correct count")
        var store = BrowserStorage.new()
        store = storage_set_item(store, "a", "1")
        store = storage_set_item(store, "b", "2")
        expect(storage_length(store)).to_equal(2)  # oracle: 2 — named expected value from the requirement

describe "Storage API - Key":
    it "returns key at index":
        step("Verify: returns key at index")
        var store = BrowserStorage.new()
        store = storage_set_item(store, "first", "1")
        store = storage_set_item(store, "second", "2")
        val k = storage_key(store, 0)
        expect(k ?? "").to_equal("first")

    it "treats API method names as regular storage keys":
        step("Verify: treats API method names as regular storage keys")
        var store = BrowserStorage.new()
        store = storage_set_item(store, "getItem", "stored")
        store = storage_set_item(store, "length", "manual")
        expect(storage_get_item(store, "getItem") ?? "").to_equal("stored")
        expect(storage_get_item(store, "length") ?? "").to_equal("manual")
        expect(storage_length(store)).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "returns nil for out-of-bounds index":
        step("Verify: returns nil for out-of-bounds index")
        val store = BrowserStorage.new()
        val k = storage_key(store, 5)
        expect(k).to_equal(nil)
