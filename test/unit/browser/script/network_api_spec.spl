"""
## Purpose and audience
Purpose: Prove that Network API - Fetch Request.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-BROWSER-SCRIPT-001 — stable requirement identity for this spec.

"""
# Network API Spec

Unit tests for the Simple browser engine Network API.
"""

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.browser_engine.script.network_api.{
    ScriptFetchRequest, ScriptFetchResponse,
    fetch_create_request, fetch_set_header, fetch_send, fetch_send_with_dispatch,
    ScriptStaticFetchDispatch,
    WebSocketConnection, websocket_connect, websocket_close,
    WEBSOCKET_OPEN, WEBSOCKET_CLOSED
}

describe "Network API - Fetch Request":
    it "creates a GET request":
        step("Verify: creates a GET request")
        # @req: REQ-BROWSER-SCRIPT-001
        val req = fetch_create_request("https://example.com", "GET")
        expect(req.url).to_equal("https://example.com")

    it "request has correct method":
        step("Verify: request has correct method")
        val req = fetch_create_request("https://example.com", "POST")
        expect(req.method).to_equal("POST")

    it "adds headers to request":
        step("Verify: adds headers to request")
        var req = fetch_create_request("https://example.com", "GET")
        req = fetch_set_header(req, "Content-Type", "application/json")
        expect(req.headers.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

describe "Network API - Fetch Response":
    it "fetch without host dispatch returns an opaque network error response":
        step("Verify: fetch without host dispatch returns an opaque network error response")
        val req = fetch_create_request("https://example.com", "GET")
        val resp = fetch_send(req)
        expect(resp.status).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "opaque network error response is not ok":
        step("Verify: opaque network error response is not ok")
        val req = fetch_create_request("https://example.com", "GET")
        val resp = fetch_send(req)
        expect(resp.ok).to_equal(false)

    it "fetch through dispatch returns status headers and body":
        step("Verify: fetch through dispatch returns status headers and body")
        val req = fetch_create_request("https://example.com/api", "GET")
        val dispatch = ScriptStaticFetchDispatch.create(201, "Content-Type: application/json\nX-Trace: abc", "{\"ok\":true}")
        val resp = fetch_send_with_dispatch(req, dispatch)
        expect(resp.status).to_equal(201)  # oracle: 201 — named expected value from the requirement
        expect(resp.ok).to_equal(true)
        expect(resp.headers.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(resp.headers[0]).to_equal("Content-Type")
        expect(resp.headers[1]).to_equal("application/json")
        expect(resp.headers[2]).to_equal("X-Trace")
        expect(resp.headers[3]).to_equal("abc")
        expect(resp.body).to_equal("{\"ok\":true}")

describe "Network API - WebSocket":
    it "creates a websocket connection":
        step("Verify: creates a websocket connection")
        val ws = websocket_connect("wss://example.com/ws")
        expect(ws.url).to_equal("wss://example.com/ws")

    it "websocket starts in open state":
        step("Verify: websocket starts in open state")
        val ws = websocket_connect("wss://example.com/ws")
        expect(ws.state).to_equal("open")
        expect(ws.ready_state).to_equal(WEBSOCKET_OPEN)
        expect(ws.buffered_amount).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(ws.protocol).to_equal("")
        expect(ws.extensions).to_equal("")

    it "rejects fragment URLs":
        step("Verify: rejects fragment URLs")
        val ws = websocket_connect("wss://example.com/ws#frag")
        expect(ws.state).to_equal("closed")
        expect(ws.ready_state).to_equal(WEBSOCKET_CLOSED)
        expect(ws.protocol).to_equal("")
        expect(ws.extensions).to_equal("")
        expect(ws.buffered_amount).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "closes a websocket":
        step("Verify: closes a websocket")
        var ws = websocket_connect("wss://example.com/ws")
        ws = websocket_close(ws)
        expect(ws.state).to_equal("closed")
        expect(ws.ready_state).to_equal(WEBSOCKET_CLOSED)
