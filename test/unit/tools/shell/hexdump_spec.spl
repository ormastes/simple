# Test: hexdump tool
# Feature: TOOL-HEXDUMP - Display file in hex
# @cover tools/shell/hexdump/hexdump_tool.spl

"""
## Purpose and audience
Purpose: converts byte to hex digits
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-TOOLS-Hexd-001

use std.spec.step
describe "hexdump tool":
    context "hex formatting":
        it "converts byte to hex digits":
            step("Verify: converts byte to hex digits")
            # @req: REQ-TOOLS-Hexd-001
            val byte_val = 0xFF
            val hi = (byte_val >> 4) & 0xF
            val lo = byte_val & 0xF
            expect(hi).to_equal(15)  # oracle: value fixed by the spec contract
            expect(lo).to_equal(15)  # oracle: value fixed by the spec contract

        it "formats offset as 8 digits":
            step("Verify: formats offset as 8 digits")
            # @req: REQ-TOOLS-Hexd-001
            val offset: u64 = 0
            # Offset 0 should produce "00000000"
            expect(offset).to_equal(0)  # oracle: value fixed by the spec contract

    context "ascii display":
        it "shows printable characters":
            step("Verify: shows printable characters")
            # @req: REQ-TOOLS-Hexd-001
            val code = 65  # 'A'
            val is_printable = code >= 32 and code < 127
            expect(is_printable).to_equal(true)

        it "replaces non-printable with dot":
            step("Verify: replaces non-printable with dot")
            # @req: REQ-TOOLS-Hexd-001
            val code = 0
            val is_printable = code >= 32 and code < 127
            expect(is_printable).to_equal(false)
