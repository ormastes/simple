# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Test: file tool
# Feature: TOOL-FILE - Identify file type
# @cover src/os/tools/shell/file/file_tool.spl

use std.spec.step

describe "file tool":
    # @manual scenario evidence
    context "extension detection":
        it "identifies .spl as Simple source":
            # @req REQ-SSPEC-UNIT
            step("identifies .spl as Simple source")
            val name = "main.spl"
            val is_spl = name.ends_with(".spl")
            expect(is_spl).to_equal(true)

        it "identifies .shs as Simple shell":
            # @req REQ-SSPEC-UNIT
            step("identifies .shs as Simple shell")
            val name = "build.shs"
            val is_shs = name.ends_with(".shs")
            expect(is_shs).to_equal(true)

        it "identifies .md as Markdown":
            # @req REQ-SSPEC-UNIT
            step("identifies .md as Markdown")
            val name = "README.md"
            val is_md = name.ends_with(".md")
            expect(is_md).to_equal(true)

    context "content inspection":
        it "detects shebang scripts":
            # @req REQ-SSPEC-UNIT
            step("detects shebang scripts")
            val content = "#!/bin/sh\necho hello"
            expect(content.starts_with("#!")).to_equal(true)

        it "detects JSON by opening brace":
            # @req REQ-SSPEC-UNIT
            step("detects JSON by opening brace")
            val content = "{\"key\": \"value\"}"
            expect(content.starts_with("{")).to_equal(true)
