"""
## Purpose and audience
Pins the string, integer, and negation operand contracts that the shell
`test` tool (`test [ ... ]`) applies to its arguments. Written for the
maintainers of src/os/tools/shell/test/test_tool.spl and for script authors
who rely on shell-style guards behaving identically in Simple.
## Operator workflow
./src/compiler_rust/target/bootstrap/simple run test/01_unit/tools/shell/test_spec.spl
## Compatibility and limitations
Covers the operand-evaluation contracts at unit level; tool-level dispatch
and process wiring live in the shell integration lanes. A bootstrap-only
host without the `run` subcommand cannot execute this file.
## Verification guidance and troubleshooting
A failure names the exact operand contract that drifted. Rerun the single
scenario and compare the observed value against the oracle comment on the
failing expect line; the oracle states why that value is authoritative.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/app/testing/in_development_tag.md
# @manual_section: shell-test-tool

use std.spec.step

describe "shell test tool operand contracts":
    context "string tests":
        it "detects empty string with -z":
            # @req REQ-SHELL-TEST-001
            # @capture(statistics): zero-length probe verdict for the -z contract
            step("Evaluate the length of an empty operand")
            val empty_operand = ""
            expect(empty_operand.len()).to_equal(0)  # oracle: -z holds exactly when the operand carries zero characters

        it "detects non-empty string with -n":
            # @req REQ-SHELL-TEST-002
            # @capture(statistics): positive-length probe verdict for the -n contract
            step("Evaluate the length of a populated operand")
            val populated_operand = "hello"
            expect(populated_operand.len()).to_be_greater_than(0)

        it "compares strings for equality":
            # @req REQ-SHELL-TEST-003
            # @capture(statistics): equal-string probe verdict for the = operator
            step("Compare two identical string operands")
            expect("abc").to_equal("abc")

        it "compares strings for inequality":
            # @req REQ-SHELL-TEST-004
            # @capture(statistics): distinct-string probe verdict for the != operator
            step("Compare two different string operands")
            expect("abc" != "def").to_equal(true)

    context "integer tests":
        it "integer equality":
            # @req REQ-SHELL-TEST-005
            # @capture(statistics): evaluated-sum verdict for the -eq contract
            step("Evaluate both integer operands, then compare")
            expect(2 + 3).to_equal(5)  # oracle: 2 + 3 must evaluate to 5, the value -eq compares

        it "integer less-than":
            # @req REQ-SHELL-TEST-006
            # @capture(statistics): ordering verdict for the -lt contract
            step("Order two integer operands ascending")
            expect(3 < 5).to_equal(true)

        it "integer greater-than":
            # @req REQ-SHELL-TEST-007
            # @capture(statistics): ordering verdict for the -gt contract
            step("Order two integer operands descending")
            expect(7 > 2).to_equal(true)

    context "negation":
        it "negates true to false":
            # @req REQ-SHELL-TEST-008
            # @capture(statistics): negated-arm verdict for the ! operator
            step("Negate a true operand and evaluate the surviving branch")
            val negated_result = if not true: 1 else: 0
            expect(negated_result).to_equal(0)  # oracle: not true must select the else branch, yielding 0
