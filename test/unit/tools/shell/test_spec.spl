# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
use std.spec.step
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/tools/shell/test_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/test_spec.md
# doc-path: doc/03_plan/sys_test/test_spec.md
# doc-path: doc/04_architecture/test_spec.md
# doc-path: doc/05_design/test_spec_oracles.md
# @manual: primary

# Test: test/[ tool
# Feature: TOOL-TEST - Conditional expressions
# @cover tools/shell/test/test_tool.spl

describe "test tool":
    context "string tests":
        it "detects empty string with -z":
            # @req: REQ-SSPEC-LOCAL-001
            step("Verify: detects empty string with -z")
            val s = ""
            expect(s.len()).to_equal(0)

        it "detects non-empty string with -n":
            step("Verify: detects non-empty string with -n")
            # @req: REQ-SSPEC-LOCAL-001
            val s = "hello"
            expect(s.len()).to_be_greater_than(0)

        it "compares strings for equality":
            # @req: REQ-SSPEC-LOCAL-001
            step("Verify: compares strings for equality")
            expect("abc").to_equal("abc")

        it "compares strings for inequality":
            step("Verify: compares strings for inequality")
            # @req: REQ-SSPEC-LOCAL-001
            expect("abc" != "def").to_equal(true)

    context "integer tests":
        it "integer equality":
            step("Verify: integer equality")
            # @req: REQ-SSPEC-LOCAL-001
            expect(5).to_equal(5)

        it "integer less-than":
            step("Verify: integer less-than")
            # @req: REQ-SSPEC-LOCAL-001
            expect(3 < 5).to_equal(true)

        it "integer greater-than":
            step("Verify: integer greater-than")
            # @req: REQ-SSPEC-LOCAL-001
            expect(7 > 2).to_equal(true)

    context "negation":
        it "negates true to false":
            step("Verify: negates true to false")
            # @req: REQ-SSPEC-LOCAL-001
            val result = if not true: 1 else: 0
            expect(result).to_equal(0)
