# Test: expr tool
# Feature: TOOL-EXPR - Evaluate arithmetic expressions
# @cover tools/shell/expr/expr_tool.spl

"""
## Purpose and audience
Purpose: adds integers
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-TOOLS-Expr-001

use std.spec.step
describe "expr tool":
    context "arithmetic":
        it "adds integers":
            step("Verify: adds integers")
            # @req: REQ-TOOLS-Expr-001
            expect(3 + 4).to_equal(7)  # oracle: value fixed by the spec contract

        it "subtracts integers":
            step("Verify: subtracts integers")
            # @req: REQ-TOOLS-Expr-001
            expect(10 - 3).to_equal(7)  # oracle: value fixed by the spec contract

        it "multiplies integers":
            step("Verify: multiplies integers")
            # @req: REQ-TOOLS-Expr-001
            expect(6 * 7).to_equal(42)  # oracle: value fixed by the spec contract

        it "divides integers":
            step("Verify: divides integers")
            # @req: REQ-TOOLS-Expr-001
            expect(15 / 3).to_equal(5)  # oracle: value fixed by the spec contract

        it "computes modulo":
            step("Verify: computes modulo")
            # @req: REQ-TOOLS-Expr-001
            expect(17 % 5).to_equal(2)  # oracle: value fixed by the spec contract

    context "comparison":
        it "equal returns 1 for match":
            step("Verify: equal returns 1 for match")
            # @req: REQ-TOOLS-Expr-001
            val result = if 5 == 5: 1 else: 0
            expect(result).to_equal(1)  # oracle: value fixed by the spec contract

        it "not-equal returns 1 for mismatch":
            step("Verify: not-equal returns 1 for mismatch")
            # @req: REQ-TOOLS-Expr-001
            val result = if 5 != 3: 1 else: 0
            expect(result).to_equal(1)  # oracle: value fixed by the spec contract
