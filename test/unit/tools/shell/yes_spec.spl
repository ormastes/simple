# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md


# Test: yes tool
# Feature: TOOL-YES - Repeatedly output string
# @cover tools/shell/yes/yes_tool.spl

use std.spec.step
use std.spec.{describe, it, expect}

use os.apps.terminal.terminal.{Terminal}
use os.tools.shell.yes.yes_tool.{tool_yes}

fn main() -> ():
    describe("yes tool"):
        # @manual scenario evidence
        context("default output"):
            it("outputs y by default, 1000 times, and exits 0"):
                # @req REQ-SSPEC-UNIT
                step("run the tool with no arguments")
                var term = Terminal.new(80, 24)
                val rc = tool_yes([], term)
                val out = term.take_mirrored_output()
                expect(rc).to_equal(0)
                # oracle: the tool caps output at 1000 lines
                expect(out.count("y\n")).to_equal(1000)

        context("custom string"):
            it("outputs the custom message 1000 times"):
                # @req REQ-SSPEC-UNIT
                step("run the tool with one argument")
                var term = Terminal.new(80, 24)
                val _ = tool_yes(["hello"], term)
                val out = term.take_mirrored_output()
                expect(out.count("hello\n")).to_equal(1000)
                # oracle: 1000 lines of "hello\n" is 6000 bytes
                expect(out.len()).to_equal(6000)
