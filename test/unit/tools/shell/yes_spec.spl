"""
## Purpose and audience

Executes the `yes` shell tool through its real implementation
(os.tools.shell.yes.yes_tool.tool_yes) against an in-memory Terminal, for the
engineers maintaining the shell coreutils layer and for operators verifying a
build before deploy.

## Operator workflow

Run this spec and confirm the Results line reports 0 failed. Each scenario
drives the real tool and asserts on the terminal output buffer the tool
actually produced.

## Compatibility and limitations

The tool runs in-process with a buffered Terminal; no TTY transport or pipe
consumer is involved. Output volume is capped by the tool's own 1000-line
quota, so the buffer length oracles below are exact.

## Verification guidance and troubleshooting

If a scenario fails, re-run this spec alone and compare the captured buffer
with the inline oracle comment: yes emits its message once per line for
exactly 1000 lines and exits 0.
"""
# Lifecycle: research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @cover src/os/tools/shell/yes/yes_tool.spl
# @manual_section: shell yes tool

use std.spec.step

use std.spec.{describe, it, expect}
use os.apps.terminal.terminal.{Terminal}
use os.tools.shell.yes.yes_tool.{tool_yes}

describe "yes tool":
    context "default output":
        it "outputs y on every emitted line by default":
            # @req REQ-SSPEC-UNIT
            # @capture(tui_grid): first and last emitted lines of the default-y run
            step("run yes with no arguments and read the terminal buffer")
            val term = Terminal.new(80, 24)
            val rc = tool_yes([], term)
            expect(rc).to_equal(0)  # oracle: tool_yes returns 0 after emitting its full line quota
            expect(term.output_buffer.starts_with("y\n")).to_equal(true)
            expect(term.output_buffer.ends_with("y\n")).to_equal(true)
            expect(term.output_buffer.len()).to_equal(2000)  # oracle: 1000 lines of "y\n" is 2000 characters

    context "custom string":
        it "outputs the requested message on every emitted line":
            # @req REQ-SSPEC-UNIT
            # @capture(tui_grid): first emitted line of the custom-message run
            step("run yes with a custom message and read the terminal buffer")
            val term = Terminal.new(80, 24)
            val rc = tool_yes(["hello"], term)
            expect(rc).to_equal(0)  # oracle: tool_yes returns 0 after emitting its full line quota
            expect(term.output_buffer.starts_with("hello\n")).to_equal(true)
            expect(term.output_buffer.len()).to_equal(6000)  # oracle: 1000 lines of "hello\n" is 6000 characters
