# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Test: tail tool
# Feature: TOOL-TAIL - Output last part of files

# Local reimplementation to avoid interpreter-mode import issues
# (importing app.tools.tail.main fails with "cannot index string with type `symbol`")

use std.spec.step

fn tail_lines(content: text, n: i64) -> text:
    """Get last n lines of content."""
    val lines = content.split("\n")
    if n >= lines.len():
        return content
    val start = lines.len() - n
    var result: [text] = []
    var i = start
    while i < lines.len():
        result.push(lines[i])
        i = i + 1
    result.join("\n")

fn tail_bytes(content: text, n: i64) -> text:
    """Get last n bytes of content."""
    if n >= content.len():
        return content
    content[content.len() - n:]

describe "tail tool":
    # @manual scenario evidence
    context "line selection":
        it "gets last N lines":
            # @req REQ-SSPEC-UNIT
            step("gets last N lines")
            val content = "line1\nline2\nline3\nline4\nline5"
            val result = tail_lines(content, 3)
            expect(result).to_equal("line3\nline4\nline5")

        it "returns all lines when N exceeds count":
            # @req REQ-SSPEC-UNIT
            step("returns all lines when N exceeds count")
            val content = "line1\nline2"
            val result = tail_lines(content, 10)
            expect(result).to_equal("line1\nline2")

        it "returns last line":
            # @req REQ-SSPEC-UNIT
            step("returns last line")
            val content = "first\nlast"
            val result = tail_lines(content, 1)
            expect(result).to_equal("last")

    context "byte selection":
        it "gets last N bytes":
            # @req REQ-SSPEC-UNIT
            step("gets last N bytes")
            val content = "hello world"
            val result = tail_bytes(content, 5)
            expect(result).to_equal("world")

        it "returns all when N exceeds length":
            # @req REQ-SSPEC-UNIT
            step("returns all when N exceeds length")
            val content = "hi"
            val result = tail_bytes(content, 100)
            expect(result).to_equal("hi")
