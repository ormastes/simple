# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec
use common.package_command_model.{package_command_summary, parse_package_command}

describe "package command model":
    # @manual scenario evidence
    it "plans package installation":
        # @req REQ-SSPEC-UNIT
        step("plans package installation")
        val plan = parse_package_command(["install", "-y", "git"]).unwrap()

        expect(plan.action).to_equal("install")
        expect(plan.package_name).to_equal("git")
        expect(plan.assume_yes).to_equal(true)

    it "plans list without a package name":
        # @req REQ-SSPEC-UNIT
        step("plans list without a package name")
        val plan = parse_package_command(["list"]).unwrap()

        expect(plan.action).to_equal("list")
        expect(plan.package_name).to_equal("")

    it "rejects missing package names for install":
        # @req REQ-SSPEC-UNIT
        step("rejects missing package names for install")
        expect(parse_package_command(["install"]).is_err()).to_equal(true)

    it "summarizes planned action":
        # @req REQ-SSPEC-UNIT
        step("summarizes planned action")
        val plan = parse_package_command(["remove", "--dry-run", "tmux"]).unwrap()

        expect(plan.dry_run).to_equal(true)
        expect(package_command_summary(plan)).to_equal("pkg remove tmux")
