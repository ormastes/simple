"""
## Purpose and audience
Purpose: creates a session with one active shell pane
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-TOOLS-TmuxSessMode-001

use std.spec
use common.tmux_session_model.{
    tmux_active_command,
    tmux_add_window,
    tmux_select_next_window,
    tmux_session,
    tmux_split_active_pane
}

use std.spec.step
describe "tmux session model":
    it "creates a session with one active shell pane":
        step("Verify: creates a session with one active shell pane")
        # @req: REQ-TOOLS-TmuxSessMode-001
        val session = tmux_session("dev", "/bin/shell")

        expect(session.name).to_equal("dev")
        expect(session.windows.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(tmux_active_command(session)).to_equal("/bin/shell")

    it "adds a new active window":
        step("Verify: adds a new active window")
        # @req: REQ-TOOLS-TmuxSessMode-001
        val session = tmux_add_window(tmux_session("dev", "/bin/shell"), "logs", "log")

        expect(session.windows.len()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(session.active_window).to_equal(1)  # oracle: value fixed by the spec contract
        expect(tmux_active_command(session)).to_equal("log")

    it "splits the active pane":
        step("Verify: splits the active pane")
        # @req: REQ-TOOLS-TmuxSessMode-001
        val session = tmux_split_active_pane(tmux_session("dev", "/bin/shell"), "ssh host")

        expect(session.windows[0].panes.len()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(session.windows[0].panes[1].command).to_equal("ssh host")

    it "cycles active windows":
        step("Verify: cycles active windows")
        # @req: REQ-TOOLS-TmuxSessMode-001
        val session = tmux_add_window(tmux_session("dev", "/bin/shell"), "pkg", "pkg list")
        val cycled = tmux_select_next_window(session)

        expect(cycled.active_window).to_equal(0)  # oracle: value fixed by the spec contract
