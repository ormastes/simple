"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-MULTI_MODE_TEST_RUNNER behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/multi_mode_test_runner_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-MULTI_MODE_TEST_RUNNER-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec

# @parent test/system/multi_mode_test_runner_spec.spl
# @req REQ-multi_mode_test_runner
# tag: unit

# =========================================================================
# Test helper types at module level (enums with data CANNOT be inside it blocks)
# =========================================================================

fn make_passing_result(path: text) -> TestFileResult:
    TestFileResult(
        path: path, passed: 3, failed: 0, skipped: 0, pending: 0,
        duration_ms: 100, setup_ms: 10, error: "", timed_out: false
    )

fn make_failing_result(path: text) -> TestFileResult:
    TestFileResult(
        path: path, passed: 1, failed: 2, skipped: 0, pending: 0,
        duration_ms: 200, setup_ms: 20, error: "assertion failed", timed_out: false
    )

fn make_empty_run_result() -> TestRunResult:
    TestRunResult(
        files: [], total_passed: 0, total_failed: 0, total_skipped: 0,
        total_pending: 0, total_timed_out: 0, total_duration_ms: 0, total_setup_ms: 0
    )

fn make_passing_run_result() -> TestRunResult:
    TestRunResult(
        files: [], total_passed: 5, total_failed: 0, total_skipped: 0,
        total_pending: 0, total_timed_out: 0, total_duration_ms: 100, total_setup_ms: 10
    )

fn make_failing_run_result() -> TestRunResult:
    TestRunResult(
        files: [], total_passed: 3, total_failed: 2, total_skipped: 0,
        total_pending: 0, total_timed_out: 0, total_duration_ms: 200, total_setup_ms: 20
    )

# =========================================================================
# Tests
# =========================================================================

describe "Multi-Mode Test Runner Unit Tests":

    describe "TestExecutionMode":
        it "has Interpreter variant":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-001
            step("Verify: has Interpreter variant")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = TestExecutionMode.Interpreter
            val name = execution_mode_to_string(mode)
            expect(name).to_equal("interpreter")

        it "has Smf variant":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-002
            step("Verify: has Smf variant")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = TestExecutionMode.Smf
            val name = execution_mode_to_string(mode)
            expect(name).to_equal("smf")

        it "has Native variant":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-003
            step("Verify: has Native variant")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = TestExecutionMode.Native
            val name = execution_mode_to_string(mode)
            expect(name).to_equal("native")

        it "has AllModes variant":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-004
            step("Verify: has AllModes variant")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = TestExecutionMode.AllModes
            val name = execution_mode_to_string(mode)
            expect(name).to_equal("all-modes")

        it "composite is detected correctly":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-005
            step("Verify: composite is detected correctly")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = TestExecutionMode.Composite("baremetal(riscv32)")
            expect(execution_mode_is_composite(mode)).to_equal(true)

        it "non-composite is detected correctly":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-006
            step("Verify: non-composite is detected correctly")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = TestExecutionMode.Interpreter
            expect(execution_mode_is_composite(mode)).to_equal(false)

    describe "execution_mode_from_string":
        it "parses interpreter":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-007
            step("Verify: parses interpreter")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = execution_mode_from_string("interpreter")
            expect(execution_mode_to_string(mode)).to_equal("interpreter")

        it "parses native":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-008
            step("Verify: parses native")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = execution_mode_from_string("native")
            expect(execution_mode_to_string(mode)).to_equal("native")

        it "parses smf":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-009
            step("Verify: parses smf")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = execution_mode_from_string("smf")
            expect(execution_mode_to_string(mode)).to_equal("smf")

        it "parses all":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-010
            step("Verify: parses all")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = execution_mode_from_string("all")
            expect(execution_mode_to_string(mode)).to_equal("all-modes")

        it "parses all-modes":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-011
            step("Verify: parses all-modes")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = execution_mode_from_string("all-modes")
            expect(execution_mode_to_string(mode)).to_equal("all-modes")

    describe "parse_mode_str":
        it "parses native string":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-012
            step("Verify: parses native string")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = parse_mode_str("native")
            expect(execution_mode_to_string(mode)).to_equal("native")

        it "parses binary as native":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-013
            step("Verify: parses binary as native")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = parse_mode_str("binary")
            expect(execution_mode_to_string(mode)).to_equal("native")

        it "parses loader as smf":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-014
            step("Verify: parses loader as smf")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = parse_mode_str("loader")
            expect(execution_mode_to_string(mode)).to_equal("smf")

        it "parses smf":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-015
            step("Verify: parses smf")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = parse_mode_str("smf")
            expect(execution_mode_to_string(mode)).to_equal("smf")

        it "parses all as all-modes":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-016
            step("Verify: parses all as all-modes")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = parse_mode_str("all")
            expect(execution_mode_to_string(mode)).to_equal("all-modes")

        it "parses all-modes":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-017
            step("Verify: parses all-modes")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = parse_mode_str("all-modes")
            expect(execution_mode_to_string(mode)).to_equal("all-modes")

        it "defaults to interpreter":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-018
            step("Verify: defaults to interpreter")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mode = parse_mode_str("unknown")
            expect(execution_mode_to_string(mode)).to_equal("interpreter")

    describe "TestInitConfig":
        it "default has nil init_fn":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-019
            step("Verify: default has nil init_fn")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = test_init_config_default()
            expect(config.init_fn == nil).to_equal(true)

        it "default has nil init_module":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-020
            step("Verify: default has nil init_module")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = test_init_config_default()
            expect(config.init_module == nil).to_equal(true)

        it "default timeout is 30000":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-021
            step("Verify: default timeout is 30000")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = test_init_config_default()
            expect(config.timeout_ms).to_equal(30000)  # oracle: expected value 30000 is the behavior asserted by this regression spec

        it "with_module sets module path":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-022
            step("Verify: with_module sets module path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val config = test_init_config_with_module("test/init.spl")
            expect(config.init_module == nil).to_equal(false)
            expect(config.init_module.unwrap()).to_equal("test/init.spl")

    describe "TestFileResult":
        it "is_ok when no failures":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-023
            step("Verify: is_ok when no failures")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val r = make_passing_result("test.spl")
            expect(r.is_ok()).to_equal(true)

        it "is not ok when failures exist":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-024
            step("Verify: is not ok when failures exist")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val r = make_failing_result("test.spl")
            expect(r.is_ok()).to_equal(false)

    describe "TestRunResult":
        it "is_ok when total_failed is zero":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-025
            step("Verify: is_ok when total_failed is zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val r = make_passing_run_result()
            expect(r.is_ok()).to_equal(true)

        it "is not ok when total_failed > 0":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-026
            step("Verify: is not ok when total_failed > 0")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val r = make_failing_run_result()
            expect(r.is_ok()).to_equal(false)

    describe "TestModeResult":
        it "is_ok delegates to inner result":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-027
            step("Verify: is_ok delegates to inner result")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mr = TestModeResult(
                mode: TestExecutionMode.Interpreter,
                result: make_passing_run_result(),
                duration_ms: 100
            )
            expect(mr.is_ok()).to_equal(true)

        it "is not ok when inner result has failures":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-028
            step("Verify: is not ok when inner result has failures")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mr = TestModeResult(
                mode: TestExecutionMode.Native,
                result: make_failing_run_result(),
                duration_ms: 200
            )
            expect(mr.is_ok()).to_equal(false)

    describe "TestAllModesResult":
        it "summary contains mode names":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-029
            step("Verify: summary contains mode names")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mr1 = TestModeResult(
                mode: TestExecutionMode.Interpreter,
                result: make_passing_run_result(),
                duration_ms: 100
            )
            val all = TestAllModesResult(mode_results: [mr1], all_passed: true)
            val s = all.summary()
            expect(s).to_contain("interpreter")

        it "summary contains pass/fail counts":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-030
            step("Verify: summary contains pass/fail counts")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val mr1 = TestModeResult(
                mode: TestExecutionMode.Interpreter,
                result: make_passing_run_result(),
                duration_ms: 100
            )
            val all = TestAllModesResult(mode_results: [mr1], all_passed: true)
            val s = all.summary()
            expect(s).to_contain("5 passed")
            expect(s).to_contain("0 failed")

    describe "parse_test_args":
        it "parses --mode=native":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-031
            step("Verify: parses --mode=native")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val opts = parse_test_args(["--mode=native", "test/"])
            expect(execution_mode_to_string(opts.mode)).to_equal("native")

        it "parses --mode=loader":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-032
            step("Verify: parses --mode=loader")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val opts = parse_test_args(["--mode=loader", "test/"])
            expect(execution_mode_to_string(opts.mode)).to_equal("smf")

        it "parses --all-modes":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-033
            step("Verify: parses --all-modes")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val opts = parse_test_args(["--all-modes", "test/"])
            expect(execution_mode_to_string(opts.mode)).to_equal("all-modes")

        it "defaults to interpreter mode":
            # @req: REQ-UNIT-MULTI_MODE_TEST_RUNNER-034
            step("Verify: defaults to interpreter mode")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val opts = parse_test_args(["test/"])
            expect(execution_mode_to_string(opts.mode)).to_equal("interpreter")
