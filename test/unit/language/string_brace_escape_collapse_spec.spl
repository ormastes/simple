# Generalizing spec for the defect class behind the `lsp_symbols` unbalanced
# JSON bug (see test/01_unit/app/cli/lsp_symbol_range_json_balanced_spec.spl).
#
# The bug was not in the JSON builder's logic — the source READ correctly. It
# was the string lexer: in an ordinary (non-raw) string literal, `{{` and `}}`
# are interpolation escapes that each render ONE brace. Any hand-built JSON that
# needs two adjacent closing braces and writes "}}" therefore silently emits one
# and produces unparseable output, with no error at any layer.
#
# These specs pin the rule so the escape semantics cannot drift silently, and
# record the two forms that are safe to use when two literal braces are wanted.

fn brace_delta(s: text) -> i64:
    var open_count = 0
    var close_count = 0
    var i = 0
    while i < s.len():
        val ch = s.substring(i, i + 1)
        if ch == "{":
            open_count = open_count + 1
        elif ch == "}":
            close_count = close_count + 1
        i = i + 1
    open_count - close_count

describe "ordinary string literals collapse doubled braces":
    it "renders a doubled closing brace as one closing brace":
        # "a}}b" and "a}b" are DIFFERENT source text that render identically.
        expect("a}}b").to_equal("a}b")
        expect("a}}b".len()).to_equal(3)

    it "renders a doubled opening brace as one opening brace":
        expect("a{{b").to_equal("a{b")
        expect("a{{b".len()).to_equal(3)

    it "leaves a lone brace alone":
        expect("a}b".len()).to_equal(3)

    it "makes a naive two-brace JSON tail unbalanced":
        # This is exactly what symbol_range_json used to do.
        val naive = "{\"end\":{\"line\":0}}"
        expect(brace_delta(naive)).to_equal(1)

describe "safe ways to emit two adjacent literal braces":
    it "concatenating two single-brace literals is engine-portable":
        val safe = "{\"end\":{\"line\":0}" + "}"
        expect(brace_delta(safe)).to_equal(0)
        expect(safe.len()).to_equal(18)

    it "a raw string does not collapse braces at all":
        val raw = """{"end":{"line":0}}"""
        expect(brace_delta(raw)).to_equal(0)
        expect(raw.len()).to_equal(18)
