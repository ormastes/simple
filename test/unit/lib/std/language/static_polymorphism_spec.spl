# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Static polymorphism, observed by executing bound traits and generic
# functions: each scenario constructs concrete types, binds them, and
# asserts on dispatched results.

use std.spec.step

trait Greeter:
    fn greet(self, name: text) -> text

class PlainGreeter:
    fn greet(self, name: text) -> text:
        "hello " + name

class LoudGreeter:
    fn greet(self, name: text) -> text:
        "HELLO " + name

fn pick_greet<T: Greeter>(g: T, name: text) -> text:
    g.greet(name)

describe "Static Polymorphism":
    # @manual scenario evidence
    it "dispatches a bound trait to its concrete class":
        # @req REQ-SSPEC-UNIT
        step("bind trait to class and call through the trait")
        bind Greeter = PlainGreeter
        val g: Greeter = PlainGreeter {}
        expect(g.greet("ada")).to_equal("hello ada")

    it "specializes a generic function per concrete type":
        # @req REQ-SSPEC-UNIT
        step("call the same generic fn with two implementations")
        expect(pick_greet(PlainGreeter {}, "bob")).to_equal("hello bob")
        expect(pick_greet(LoudGreeter {}, "bob")).to_equal("HELLO bob")

    it "keeps generic data structures type-safe over their parameter":
        # @req REQ-SSPEC-UNIT
        step("instantiate one generic holder over two element types")
        val numbers = [1, 2, 3]
        val words = ["a", "b"]
        expect(numbers.len()).to_equal(3)
        expect(words.len()).to_equal(2)
        expect(numbers[1]).to_equal(2)
        expect(words[1]).to_equal("b")
