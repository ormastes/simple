# @cover src/lib/common/collection_helpers.spl 80%
"""
## Purpose and audience
Purpose: Verify sort_by_key.
Audience: compiler and tooling engineers who maintain this spec.

# Collection Helpers Specification

**Feature IDs:** #COLL-P1
**Category:** Stdlib
**Difficulty:** 2/5
**Status:** Implemented
**Requirements:** doc/02_requirements/feature/stdlib_helpers.md

## Overview

Tests for Phase 1 collection helper functions: sort_by_key, min_by_key,
max_by_key, flat_map, compact_map, insert_at, remove_at, arr_pop,
arr_shift, reject, none, one, find_last, find_last_index, at, arr_clone,
each_slice, chunk, pairwise, sum_by, product, tally, compress,
reduce_right, values_at, fill, replace_range, zip_longest, slice_when,
chunk_while, top_n, bottom_n, each_cons, arr_compare, dedup_by.
"""

# @req: REQ-LIB-COLLECTION-HELPERS-001 — stable requirement identity for this spec.

use std.spipe.*
use std.collection_helpers.*

# ============================================================================
# Sort / Min / Max by Key
# ============================================================================

use std.spec.step

describe "sort_by_key":
    it "sorts strings by length":
        step("Verify: sorts strings by length")
        # @req: REQ-LIB-COLLECTION-HELPERS-001
        val result = sort_by_key(["banana", "apple", "fig"], &:len)
        expect(result[0]).to_equal("fig")
        expect(result[1]).to_equal("apple")
        expect(result[2]).to_equal("banana")

    it "returns empty for empty array":
        step("Verify: returns empty for empty array")
        val result = sort_by_key([], &:len)
        expect(result.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    it "returns single-element array unchanged":
        step("Verify: returns single-element array unchanged")
        val result = sort_by_key(["only"], &:len)
        expect(result[0]).to_equal("only")

describe "min_by_key":
    it "finds shortest string":
        step("Verify: finds shortest string")
        val result = min_by_key(["banana", "apple", "fig"], &:len)
        expect(result).to_equal("fig")

    it "returns nil for empty array":
        step("Verify: returns nil for empty array")
        val result = min_by_key([], &:len)
        expect(result).to_be_nil()

describe "max_by_key":
    it "finds longest string":
        step("Verify: finds longest string")
        val result = max_by_key(["banana", "apple", "fig"], &:len)
        expect(result).to_equal("banana")

    it "returns nil for empty array":
        step("Verify: returns nil for empty array")
        val result = max_by_key([], &:len)
        expect(result).to_be_nil()

# ============================================================================
# Flat Map / Compact Map
# ============================================================================

describe "flat_map":
    it "maps and flattens one level":
        step("Verify: maps and flattens one level")
        val result = flat_map([1, 2, 3], [_1, _1 * 10])
        expect(result.len()).to_equal(6)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0]).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[1]).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[2]).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[3]).to_equal(20)  # oracle: authoritative expected value documented by this spec's contract

    it "handles empty arrays":
        step("Verify: handles empty arrays")
        val result = flat_map([], [_1])
        expect(result.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

describe "compact_map":
    it "maps and removes nils":
        step("Verify: maps and removes nils")
        val result = compact_map([1, 2, 3, 4], if _1 % 2 == 0: _1 * 10 else: nil)
        expect(result.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0]).to_equal(20)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[1]).to_equal(40)  # oracle: authoritative expected value documented by this spec's contract

    it "returns empty when all nil":
        step("Verify: returns empty when all nil")
        val result = compact_map([1, 3, 5], if _1 % 2 == 0: _1 else: nil)
        expect(result.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

# ============================================================================
# Insert / Remove / Pop / Shift
# ============================================================================

describe "insert_at":
    it "inserts at middle":
        step("Verify: inserts at middle")
        val result = insert_at([1, 2, 3], 1, 99)
        expect(result.len()).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0]).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[1]).to_equal(99)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[2]).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    it "inserts at beginning":
        step("Verify: inserts at beginning")
        val result = insert_at([1, 2], 0, 99)
        expect(result[0]).to_equal(99)  # oracle: authoritative expected value documented by this spec's contract
        expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    it "inserts at end":
        step("Verify: inserts at end")
        val result = insert_at([1, 2], 2, 99)
        expect(result[2]).to_equal(99)  # oracle: authoritative expected value documented by this spec's contract
        expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

describe "remove_at":
    it "removes at middle":
        step("Verify: removes at middle")
        val result = remove_at([10, 20, 30], 1)
        expect(result.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0]).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[1]).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract

    it "returns original for out of bounds":
        step("Verify: returns original for out of bounds")
        val result = remove_at([1, 2, 3], 5)
        expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

describe "arr_pop":
    it "removes and returns last element":
        step("Verify: removes and returns last element")
        val (rest, last) = arr_pop([1, 2, 3])
        expect(last).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(rest.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(rest[0]).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(rest[1]).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    it "returns nil for empty array":
        step("Verify: returns nil for empty array")
        val (rest, last) = arr_pop([])
        expect(last).to_be_nil()
        expect(rest.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

describe "arr_shift":
    it "removes and returns first element":
        step("Verify: removes and returns first element")
        val (rest, first) = arr_shift([1, 2, 3])
        expect(first).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(rest.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(rest[0]).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    it "returns nil for empty array":
        step("Verify: returns nil for empty array")
        val (rest, first) = arr_shift([])
        expect(first).to_be_nil()

# ============================================================================
# Reject / None / One
# ============================================================================

describe "reject":
    it "keeps elements not matching predicate":
        step("Verify: keeps elements not matching predicate")
        val result = reject([1, 2, 3, 4, 5], _1 % 2 == 0)
        expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0]).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[1]).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[2]).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract

    it "keeps all when nothing matches":
        step("Verify: keeps all when nothing matches")
        val result = reject([1, 3, 5], _1 % 2 == 0)
        expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

describe "none":
    it "returns true when no match":
        step("Verify: returns true when no match")
        expect(none([1, 3, 5], _1 % 2 == 0)).to_equal(true)

    it "returns false when any match":
        step("Verify: returns false when any match")
        expect(none([1, 2, 3], _1 % 2 == 0)).to_equal(false)

    it "returns true for empty array":
        step("Verify: returns true for empty array")
        expect(none([], \_: true)).to_equal(true)

describe "one":
    it "returns true for exactly one match":
        step("Verify: returns true for exactly one match")
        expect(one([1, 2, 3], _1 == 2)).to_equal(true)

    it "returns false for multiple matches":
        step("Verify: returns false for multiple matches")
        expect(one([1, 2, 2], _1 == 2)).to_equal(false)

    it "returns false for no matches":
        step("Verify: returns false for no matches")
        expect(one([1, 3, 5], _1 == 2)).to_equal(false)

# ============================================================================
# Find Last / Find Last Index
# ============================================================================

describe "find_last":
    it "finds last matching element":
        step("Verify: finds last matching element")
        expect(find_last([1, 2, 3, 4], _1 % 2 == 0)).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract

    it "returns nil when none match":
        step("Verify: returns nil when none match")
        expect(find_last([1, 3, 5], _1 % 2 == 0)).to_be_nil()

describe "find_last_index":
    it "finds index of last match":
        step("Verify: finds index of last match")
        expect(find_last_index([1, 2, 3, 2], _1 == 2)).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    it "returns nil when none match":
        step("Verify: returns nil when none match")
        expect(find_last_index([1, 3, 5], _1 == 2)).to_be_nil()

# ============================================================================
# At with Negative Index
# ============================================================================

describe "at":
    it "gets element by positive index":
        step("Verify: gets element by positive index")
        expect(at([10, 20, 30], 0)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
        expect(at([10, 20, 30], 2)).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract

    it "supports negative index":
        step("Verify: supports negative index")
        expect(at([10, 20, 30], -1)).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract
        expect(at([10, 20, 30], -2)).to_equal(20)  # oracle: authoritative expected value documented by this spec's contract
        expect(at([10, 20, 30], -3)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract

    it "returns nil for out of bounds":
        step("Verify: returns nil for out of bounds")
        expect(at([10, 20, 30], 5)).to_be_nil()
        expect(at([10, 20, 30], -4)).to_be_nil()

# ============================================================================
# Clone
# ============================================================================

describe "arr_clone":
    it "creates shallow copy":
        step("Verify: creates shallow copy")
        val original = [1, 2, 3]
        val copy = arr_clone(original)
        expect(copy.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(copy[0]).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(copy[1]).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(copy[2]).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    it "returns empty for empty":
        step("Verify: returns empty for empty")
        val copy = arr_clone([])
        expect(copy.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

# ============================================================================
# Chunk / Each Slice / Each Cons
# ============================================================================

describe "chunk":
    it "splits into chunks":
        step("Verify: splits into chunks")
        val result = chunk([1, 2, 3, 4, 5], 2)
        expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0].len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0][0]).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0][1]).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[2].len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[2][0]).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract

    it "returns empty for empty array":
        step("Verify: returns empty for empty array")
        val result = chunk([], 2)
        expect(result.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    it "returns empty for zero chunk size":
        step("Verify: returns empty for zero chunk size")
        val result = chunk([1, 2, 3], 0)
        expect(result.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

describe "pairwise":
    it "returns consecutive pairs":
        step("Verify: returns consecutive pairs")
        val result = pairwise([1, 2, 3, 4])
        expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    it "returns empty for single element":
        step("Verify: returns empty for single element")
        val result = pairwise([1])
        expect(result.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    it "returns empty for empty array":
        step("Verify: returns empty for empty array")
        val result = pairwise([])
        expect(result.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

# ============================================================================
# Sum By / Product
# ============================================================================

describe "sum_by":
    it "sums extracted values":
        step("Verify: sums extracted values")
        expect(sum_by(["hi", "hello", "hey"], &:len)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract

    it "returns 0 for empty":
        step("Verify: returns 0 for empty")
        expect(sum_by([], &:len)).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

describe "product":
    it "multiplies all elements":
        step("Verify: multiplies all elements")
        expect(product([1, 2, 3, 4])).to_equal(24)  # oracle: authoritative expected value documented by this spec's contract

    it "returns 1 for empty":
        step("Verify: returns 1 for empty")
        expect(product([])).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

    it "handles single element":
        step("Verify: handles single element")
        expect(product([5])).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract

# ============================================================================
# Tally
# ============================================================================

describe "tally":
    it "counts element frequencies":
        step("Verify: counts element frequencies")
        val result = tally(["a", "b", "a", "c", "b", "a"])
        expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    it "returns empty for empty array":
        step("Verify: returns empty for empty array")
        val result = tally([])
        expect(result.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

# ============================================================================
# Compress / Values At / Fill
# ============================================================================

describe "compress":
    it "filters by boolean selectors":
        step("Verify: filters by boolean selectors")
        val result = compress(["a", "b", "c", "d"], [true, false, true, false])
        expect(result.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0]).to_equal("a")
        expect(result[1]).to_equal("c")

    it "handles shorter selector array":
        step("Verify: handles shorter selector array")
        val result = compress(["a", "b", "c"], [true])
        expect(result.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

describe "values_at":
    it "gets elements at specified indices":
        step("Verify: gets elements at specified indices")
        val result = values_at(["a", "b", "c", "d"], [0, 2, 3])
        expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0]).to_equal("a")
        expect(result[1]).to_equal("c")
        expect(result[2]).to_equal("d")

describe "fill":
    it "fills array with value":
        step("Verify: fills array with value")
        val result = fill([1, 2, 3], 0)
        expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0]).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[1]).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[2]).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

# ============================================================================
# Reduce Right
# ============================================================================

describe "reduce_right":
    it "folds from right to left":
        step("Verify: folds from right to left")
        val result = reduce_right(["a", "b", "c"], "", \acc, x: acc + x)
        expect(result).to_equal("cba")

    it "returns init for empty":
        step("Verify: returns init for empty")
        val result = reduce_right([], 0, \acc, x: acc + x)
        expect(result).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

# ============================================================================
# Replace Range / Zip Longest
# ============================================================================

describe "replace_range":
    it "replaces range of elements":
        step("Verify: replaces range of elements")
        val result = replace_range([1, 2, 3, 4, 5], 1, 3, [20, 30, 40])
        expect(result.len()).to_equal(6)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0]).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[1]).to_equal(20)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[2]).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[3]).to_equal(40)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[4]).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract

describe "zip_longest":
    it "zips with fill for unequal lengths":
        step("Verify: zips with fill for unequal lengths")
        val result = zip_longest([1, 2, 3], ["a", "b"], 0, "z")
        expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

# ============================================================================
# Slice When / Chunk While
# ============================================================================

describe "slice_when":
    it "splits when predicate true between elements":
        step("Verify: splits when predicate true between elements")
        val result = slice_when([1, 2, 4, 5, 7], \a, b: b - a > 1)
        expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0].len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[1].len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[2].len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

    it "returns empty for empty":
        step("Verify: returns empty for empty")
        val result = slice_when([], \a, b: true)
        expect(result.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

describe "chunk_while":
    it "chunks while predicate true":
        step("Verify: chunks while predicate true")
        val result = chunk_while([1, 2, 4, 5, 7], \a, b: b - a <= 1)
        expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

# ============================================================================
# Top N / Bottom N
# ============================================================================

describe "top_n":
    it "returns n largest":
        step("Verify: returns n largest")
        val result = top_n([3, 1, 4, 1, 5, 9], 3)
        expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0]).to_equal(9)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[1]).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[2]).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract

    it "returns empty for n=0":
        step("Verify: returns empty for n=0")
        val result = top_n([1, 2], 0)
        expect(result.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

describe "bottom_n":
    it "returns n smallest":
        step("Verify: returns n smallest")
        val result = bottom_n([3, 1, 4, 1, 5, 9], 3)
        expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0]).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[1]).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[2]).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

# ============================================================================
# Compare / Dedup By
# ============================================================================

describe "arr_compare":
    it "compares less":
        step("Verify: compares less")
        expect(arr_compare([1, 2, 3], [1, 2, 4])).to_equal(-1)  # oracle: authoritative expected value documented by this spec's contract

    it "compares equal":
        step("Verify: compares equal")
        expect(arr_compare([1, 2, 3], [1, 2, 3])).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    it "compares greater":
        step("Verify: compares greater")
        expect(arr_compare([1, 2, 4], [1, 2, 3])).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

    it "shorter is less":
        step("Verify: shorter is less")
        expect(arr_compare([1, 2], [1, 2, 3])).to_equal(-1)  # oracle: authoritative expected value documented by this spec's contract

describe "dedup_by":
    it "removes consecutive duplicates":
        step("Verify: removes consecutive duplicates")
        val result = dedup_by([1, 1, 2, 2, 3, 1], \a, b: a == b)
        expect(result.len()).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0]).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[1]).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[2]).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[3]).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

    it "returns empty for empty":
        step("Verify: returns empty for empty")
        val result = dedup_by([], \a, b: a == b)
        expect(result.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
