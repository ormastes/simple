describe "index_of_any":
    it "finds first vowel":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "finds first vowel"
        step("Verify: finds first vowel")
        expect(index_of_any("hello", "aeiou")).to_equal(1)  # oracle: 1 is the pinned authoritative contract value

    it "returns nil when not found":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "returns nil when not found"
        step("Verify: returns nil when not found")
        expect(index_of_any("xyz", "aeiou")).to_be_nil()

    it "handles empty":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "handles empty"
        step("Verify: handles empty")
        expect(index_of_any("", "abc")).to_be_nil()

describe "index_of_func":
    # NOTE: `_1 == "l"` (placeholder-lambda syntax) used INLINE as an argument
    # nested inside another call's argument list (here `expect(...)`) is
    # mis-scoped by the Rust-seed parser: `index_of_func` is not on the
    # hardcoded higher-order-callee name list
    # (src/compiler_rust/parser/src/expressions/postfix.rs
    # name_is_higher_order_callback_callee), so placeholder consumption
    # defers past it to the OUTER `expect(...)` call, which then becomes a
    # lambda itself instead of being invoked — `expect()` receives `<lambda>`
    # instead of the i64 result. Reproduced standalone; `val pred = _1 == "l"`
    # extracted to its own statement works fine, only the inline-nested form
    # fails. Filed:
    # doc/08_tracking/bug/placeholder_lambda_scoping_nested_ordinary_call_2026-08-31.md
    # Using an explicit lambda here (as this file's other predicate tests and
    # index_of_func's own sdoctest already do) sidesteps the parser bug
    # without changing what is being verified.
    it "finds by predicate":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for the stepped flow above
        step("Verify: finds by predicate")
        expect(index_of_func("hello", \c: c == "l")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    it "returns nil when not found":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for the stepped flow above
        step("Verify: returns nil when not found")
        expect(index_of_func("hello", \c: c == "z")).to_be_nil()

describe "last_index_of_func":
    it "finds last by predicate":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for the stepped flow above
        step("Verify: finds last by predicate")
        expect(last_index_of_func("hello", \c: c == "l")).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    it "returns nil when not found":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for the stepped flow above
        step("Verify: returns nil when not found")
        expect(last_index_of_func("hello", \c: c == "z")).to_be_nil()

describe "fields_func":
    it "splits by custom predicate":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "splits by custom predicate"
        step("Verify: splits by custom predicate")
        val result = fields_func("hello world\tfoo", _1 == " " or _1 == "\t")
        expect(result.len()).to_equal(3)  # oracle: 3 is the pinned authoritative contract value
        expect(result[0]).to_equal("hello")
        expect(result[1]).to_equal("world")
        expect(result[2]).to_equal("foo")

    it "handles consecutive separators":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "handles consecutive separators"
        step("Verify: handles consecutive separators")
        val result = fields_func("a  b", _1 == " ")
        expect(result.len()).to_equal(2)  # oracle: 2 is the pinned authoritative contract value

