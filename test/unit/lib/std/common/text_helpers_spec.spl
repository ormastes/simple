describe "to_kebab_case":
    it "converts PascalCase":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "converts PascalCase"
        step("Verify: converts PascalCase")
        expect(to_kebab_case("HelloWorld")).to_equal("hello-world")

    it "converts snake_case":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "converts snake_case"
        step("Verify: converts snake_case")
        expect(to_kebab_case("hello_world")).to_equal("hello-world")

    it "converts camelCase":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "converts camelCase"
        step("Verify: converts camelCase")
        expect(to_kebab_case("helloWorld")).to_equal("hello-world")

    it "handles SCREAMING_SNAKE":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "handles SCREAMING_SNAKE"
        step("Verify: handles SCREAMING_SNAKE")
        expect(to_kebab_case("HELLO_WORLD")).to_equal("hello-world")

    it "preserves existing kebab":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "preserves existing kebab"
        step("Verify: preserves existing kebab")
        expect(to_kebab_case("already-kebab")).to_equal("already-kebab")

    it "handles empty":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "handles empty"
        step("Verify: handles empty")
        expect(to_kebab_case("")).to_equal("")

