# P2: String Predicates
# ============================================================================

describe "is_ascii":
    it "returns true for ASCII":
        step("Verify: returns true for ASCII")
        expect(is_ascii("hello")).to_equal(true)

    it "returns true for empty":
        step("Verify: returns true for empty")
        expect(is_ascii("")).to_equal(true)

describe "is_upper":
    it "returns true for uppercase":
        step("Verify: returns true for uppercase")
        expect(is_upper("HELLO")).to_equal(true)

    it "returns false for mixed":
        step("Verify: returns false for mixed")
        expect(is_upper("Hello")).to_equal(false)

    it "ignores non-alpha":
        step("Verify: ignores non-alpha")
        expect(is_upper("HELLO 123")).to_equal(true)

    it "returns false for empty":
        step("Verify: returns false for empty")
        expect(is_upper("")).to_equal(false)

describe "is_lower":
    it "returns true for lowercase":
        step("Verify: returns true for lowercase")
        expect(is_lower("hello")).to_equal(true)

    it "returns false for mixed":
        step("Verify: returns false for mixed")
        expect(is_lower("Hello")).to_equal(false)

    it "ignores non-alpha":
        step("Verify: ignores non-alpha")
        expect(is_lower("hello 123")).to_equal(true)

    it "returns false for empty":
        step("Verify: returns false for empty")
        expect(is_lower("")).to_equal(false)

describe "is_printable":
    it "returns true for printable":
        step("Verify: returns true for printable")
        expect(is_printable("hello world")).to_equal(true)

    it "returns true for empty":
        step("Verify: returns true for empty")
        expect(is_printable("")).to_equal(true)

describe "is_title":
    it "returns true for title case":
        step("Verify: returns true for title case")
        expect(is_title("Hello World")).to_equal(true)

    it "returns false for lowercase start":
        step("Verify: returns false for lowercase start")
        expect(is_title("hello World")).to_equal(false)

    it "returns true for single word":
        step("Verify: returns true for single word")
        expect(is_title("Hello")).to_equal(true)

    it "returns false for empty":
        step("Verify: returns false for empty")
        expect(is_title("")).to_equal(false)

