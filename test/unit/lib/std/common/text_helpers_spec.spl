        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "parses binary"
        step("Verify: parses binary")
        expect(to_int_radix("1010", 2)).to_equal(10)  # oracle: 10 is the pinned authoritative contract value

    it "parses hex":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "parses hex"
        step("Verify: parses hex")
        expect(to_int_radix("ff", 16)).to_equal(255)  # oracle: 255 is the pinned authoritative contract value

    it "parses octal":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "parses octal"
        step("Verify: parses octal")
        expect(to_int_radix("77", 8)).to_equal(63)  # oracle: 63 is the pinned authoritative contract value

    it "parses base 36":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "parses base 36"
        step("Verify: parses base 36")
        expect(to_int_radix("z", 36)).to_equal(35)  # oracle: 35 is the pinned authoritative contract value

    it "returns nil for invalid base":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "returns nil for invalid base"
        step("Verify: returns nil for invalid base")
        expect(to_int_radix("10", 1)).to_be_nil()

    it "returns nil for empty":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "returns nil for empty"
        step("Verify: returns nil for empty")
        expect(to_int_radix("", 10)).to_be_nil()

