# ============================================================================

describe "text_insert":
    it "inserts at middle":
        step("Verify: inserts at middle")
        expect(text_insert("hello", 2, "XY")).to_equal("heXYllo")

    it "inserts at beginning":
        step("Verify: inserts at beginning")
        expect(text_insert("hello", 0, "AB")).to_equal("ABhello")

    it "inserts at end":
        step("Verify: inserts at end")
        expect(text_insert("hello", 5, "!")).to_equal("hello!")

