describe "split_after":
    it "keeps separator at end of each part":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "keeps separator at end of each part"
        step("Verify: keeps separator at end of each part")
        val result = split_after("a,b,c", ",")
        expect(result.len()).to_equal(3)  # oracle: 3 is the pinned authoritative contract value
        expect(result[0]).to_equal("a,")
        expect(result[1]).to_equal("b,")
        expect(result[2]).to_equal("c")

    it "handles no separator found":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "handles no separator found"
        step("Verify: handles no separator found")
        val result = split_after("hello", ",")
        expect(result.len()).to_equal(1)  # oracle: 1 is the pinned authoritative contract value
        expect(result[0]).to_equal("hello")

