describe "split_n":
    it "splits into at most n parts":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "splits into at most n parts"
        step("Verify: splits into at most n parts")
        val result = split_n("a,b,c,d", ",", 2)
        expect(result.len()).to_equal(2)  # oracle: 2 is the pinned authoritative contract value
        expect(result[0]).to_equal("a")
        expect(result[1]).to_equal("b,c,d")

    it "returns full split if fewer than n parts":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "returns full split if fewer than n parts"
        step("Verify: returns full split if fewer than n parts")
        val result = split_n("hello", ",", 5)
        expect(result.len()).to_equal(1)  # oracle: 1 is the pinned authoritative contract value
        expect(result[0]).to_equal("hello")

describe "cut":
    it "cuts at separator":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "cuts at separator"
        step("Verify: cuts at separator")
        val (before, after, found) = cut("hello=world", "=")
        expect(before).to_equal("hello")
        expect(after).to_equal("world")
        expect(found).to_equal(true)

    it "returns false when not found":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "returns false when not found"
        step("Verify: returns false when not found")
        val (before, after, found) = cut("hello", "=")
        expect(before).to_equal("hello")
        expect(after).to_equal("")
        expect(found).to_equal(false)

describe "contains_any":
    it "finds vowels":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "finds vowels"
