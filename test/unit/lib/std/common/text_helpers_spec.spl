describe "delete_chars":
    it "deletes specified characters":
        step("Verify: deletes specified characters")
        expect(delete_chars("hello world", "lo")).to_equal("he wrd")

    it "handles empty chars":
        step("Verify: handles empty chars")
        expect(delete_chars("abc", "")).to_equal("abc")

    it "handles empty string":
        step("Verify: handles empty string")
        expect(delete_chars("", "abc")).to_equal("")

# ============================================================================
# P2: Advanced Search
# ============================================================================

describe "index_of_any":
    it "finds first vowel":
        step("Verify: finds first vowel")
        expect(index_of_any("hello", "aeiou")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

    it "returns nil when not found":
        step("Verify: returns nil when not found")
        expect(index_of_any("xyz", "aeiou")).to_be_nil()

    it "handles empty":
        step("Verify: handles empty")
        expect(index_of_any("", "abc")).to_be_nil()

describe "index_of_func":
    it "finds by predicate":
        step("Verify: finds by predicate")
        expect(index_of_func("hello", _1 == "l")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    it "returns nil when not found":
        step("Verify: returns nil when not found")
        expect(index_of_func("hello", _1 == "z")).to_be_nil()

describe "last_index_of_func":
    it "finds last by predicate":
        step("Verify: finds last by predicate")
        expect(last_index_of_func("hello", _1 == "l")).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    it "returns nil when not found":
        step("Verify: returns nil when not found")
        expect(last_index_of_func("hello", _1 == "z")).to_be_nil()

describe "fields_func":
    it "splits by custom predicate":
        step("Verify: splits by custom predicate")
        val result = fields_func("hello world\tfoo", _1 == " " or _1 == "\t")
        expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0]).to_equal("hello")
        expect(result[1]).to_equal("world")
        expect(result[2]).to_equal("foo")

    it "handles consecutive separators":
        step("Verify: handles consecutive separators")
        val result = fields_func("a  b", _1 == " ")
        expect(result.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

# ============================================================================
# P2: Replacement
# ============================================================================

describe "replace_n":
    it "replaces first n occurrences":
        step("Verify: replaces first n occurrences")
        expect(replace_n("aaa", "a", "b", 2)).to_equal("bba")

    it "replaces first only":
        step("Verify: replaces first only")
        expect(replace_n("hello", "l", "r", 1)).to_equal("herlo")

    it "handles no match":
        step("Verify: handles no match")
        expect(replace_n("hello", "x", "y", 5)).to_equal("hello")

describe "multi_replace":
    it "replaces multiple pairs":
        step("Verify: replaces multiple pairs")
        val result = multi_replace("hello world", [("hello", "hi"), ("world", "earth")])
        expect(result).to_equal("hi earth")

    it "handles no pairs":
        step("Verify: handles no pairs")
        expect(multi_replace("hello", [])).to_equal("hello")

