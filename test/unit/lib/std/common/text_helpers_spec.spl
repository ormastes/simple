describe "hex_to_int":
    it "parses hex":
        step("Verify: parses hex")
        expect(hex_to_int("ff")).to_equal(255)  # oracle: authoritative expected value documented by this spec's contract

    it "parses with 0x prefix":
        step("Verify: parses with 0x prefix")
        expect(hex_to_int("0xFF")).to_equal(255)  # oracle: authoritative expected value documented by this spec's contract

    it "parses simple hex":
        step("Verify: parses simple hex")
        expect(hex_to_int("10")).to_equal(16)  # oracle: authoritative expected value documented by this spec's contract

    it "returns nil for invalid":
        step("Verify: returns nil for invalid")
        expect(hex_to_int("xyz")).to_be_nil()

describe "oct_to_int":
    it "parses octal":
        step("Verify: parses octal")
        expect(oct_to_int("77")).to_equal(63)  # oracle: authoritative expected value documented by this spec's contract

    it "parses with prefix":
        step("Verify: parses with prefix")
        expect(oct_to_int("0o77")).to_equal(63)  # oracle: authoritative expected value documented by this spec's contract

describe "to_int_radix":
    it "parses binary":
        step("Verify: parses binary")
        expect(to_int_radix("1010", 2)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract

    it "parses hex":
        step("Verify: parses hex")
        expect(to_int_radix("ff", 16)).to_equal(255)  # oracle: authoritative expected value documented by this spec's contract

    it "parses octal":
        step("Verify: parses octal")
        expect(to_int_radix("77", 8)).to_equal(63)  # oracle: authoritative expected value documented by this spec's contract

    it "parses base 36":
        step("Verify: parses base 36")
        expect(to_int_radix("z", 36)).to_equal(35)  # oracle: authoritative expected value documented by this spec's contract

    it "returns nil for invalid base":
        step("Verify: returns nil for invalid base")
        expect(to_int_radix("10", 1)).to_be_nil()

    it "returns nil for empty":
        step("Verify: returns nil for empty")
        expect(to_int_radix("", 10)).to_be_nil()

