        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "parses with 0x prefix"
        step("Verify: parses with 0x prefix")
        expect(hex_to_int("0xFF")).to_equal(255)  # oracle: 255 is the pinned authoritative contract value

    it "parses simple hex":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "parses simple hex"
        step("Verify: parses simple hex")
        expect(hex_to_int("10")).to_equal(16)  # oracle: 16 is the pinned authoritative contract value

