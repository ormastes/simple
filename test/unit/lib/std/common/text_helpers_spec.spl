    it "finds no match":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "finds no match"
        step("Verify: finds no match")
        expect(contains_any("xyz", "aeiou")).to_equal(false)

    it "handles empty string":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "handles empty string"
        step("Verify: handles empty string")
        expect(contains_any("", "abc")).to_equal(false)

    it "handles empty chars":
        # @req REQ-TEXT-HELPERS-001
        # @capture(statistics): retained evidence for scenario "handles empty chars"
        step("Verify: handles empty chars")
        expect(contains_any("hello", "")).to_equal(false)

