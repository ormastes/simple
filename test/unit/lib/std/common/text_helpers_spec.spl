# @cover src/lib/common/text_advanced.spl 80%
"""
## Purpose and audience
Purpose: Verify to_kebab_case.
Audience: compiler and tooling engineers who maintain this spec.

# Text Helpers Specification

**Feature IDs:** #TEXT-P1, #TEXT-P2
**Category:** Stdlib
**Difficulty:** 2/5
**Status:** Implemented
**Requirements:** doc/02_requirements/feature/stdlib_helpers.md

## Overview

Tests for text helper functions: P1 case conversions (to_kebab_case,
to_pascal_case, to_screaming_snake), character transforms (chars_map,
tr, gsub), tokenization (split_n, cut, contains_any), and P2 string
predicates, character ops, search, replacement, radix parsing, quote.
"""

# @req: REQ-LIB-TEXT-HELPERS-001 — stable requirement identity for this spec.

use std.spipe.*
use std.text_advanced.*

# ============================================================================
# P1: Case Conversion
# ============================================================================

use std.spec.step

describe "to_kebab_case":
    it "converts PascalCase":
        step("Verify: converts PascalCase")
        # @req: REQ-LIB-TEXT-HELPERS-001
        expect(to_kebab_case("HelloWorld")).to_equal("hello-world")

    it "converts snake_case":
        step("Verify: converts snake_case")
        expect(to_kebab_case("hello_world")).to_equal("hello-world")

    it "converts camelCase":
        step("Verify: converts camelCase")
        expect(to_kebab_case("helloWorld")).to_equal("hello-world")

    it "handles SCREAMING_SNAKE":
        step("Verify: handles SCREAMING_SNAKE")
        expect(to_kebab_case("HELLO_WORLD")).to_equal("hello-world")

    it "preserves existing kebab":
        step("Verify: preserves existing kebab")
        expect(to_kebab_case("already-kebab")).to_equal("already-kebab")

    it "handles empty":
        step("Verify: handles empty")
        expect(to_kebab_case("")).to_equal("")

describe "to_pascal_case":
    it "converts snake_case":
        step("Verify: converts snake_case")
        expect(to_pascal_case("hello_world")).to_equal("HelloWorld")

    it "converts kebab-case":
        step("Verify: converts kebab-case")
        expect(to_pascal_case("hello-world")).to_equal("HelloWorld")

    it "handles empty":
        step("Verify: handles empty")
        expect(to_pascal_case("")).to_equal("")

describe "to_screaming_snake":
    it "converts camelCase":
        step("Verify: converts camelCase")
        expect(to_screaming_snake("helloWorld")).to_equal("HELLO_WORLD")

    it "converts PascalCase":
        step("Verify: converts PascalCase")
        expect(to_screaming_snake("HelloWorld")).to_equal("HELLO_WORLD")

    it "handles empty":
        step("Verify: handles empty")
        expect(to_screaming_snake("")).to_equal("")

# ============================================================================
# P1: Character Transforms
# ============================================================================

describe "chars_map":
    it "maps each character":
        step("Verify: maps each character")
        expect(chars_map("hello", &:upper)).to_equal("HELLO")

    it "handles empty":
        step("Verify: handles empty")
        expect(chars_map("", \c: c)).to_equal("")

describe "tr":
    it "transliterates characters":
        step("Verify: transliterates characters")
        expect(tr("hello", "elo", "ELO")).to_equal("hELLO")

    it "maps character by character":
        step("Verify: maps character by character")
        expect(tr("aabbcc", "abc", "xyz")).to_equal("xxyyzz")

    it "handles empty source":
        step("Verify: handles empty source")
        expect(tr("", "a", "b")).to_equal("")

    it "handles empty from":
        step("Verify: handles empty from")
        expect(tr("hello", "", "")).to_equal("hello")

describe "gsub":
    it "replaces with callback":
        step("Verify: replaces with callback")
        expect(gsub("hello world", "o", &:upper)).to_equal("hellO wOrld")

    it "handles no matches":
        step("Verify: handles no matches")
        expect(gsub("hello", "x", \_: "Y")).to_equal("hello")

    it "handles empty string":
        step("Verify: handles empty string")
        expect(gsub("", "a", \_: "b")).to_equal("")

# ============================================================================
# P1: Tokenization
# ============================================================================

describe "split_n":
    it "splits into at most n parts":
        step("Verify: splits into at most n parts")
        val result = split_n("a,b,c,d", ",", 2)
        expect(result.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0]).to_equal("a")
        expect(result[1]).to_equal("b,c,d")

    it "returns full split if fewer than n parts":
        step("Verify: returns full split if fewer than n parts")
        val result = split_n("hello", ",", 5)
        expect(result.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(result[0]).to_equal("hello")

describe "cut":
    it "cuts at separator":
        step("Verify: cuts at separator")
        val (before, after, found) = cut("hello=world", "=")
        expect(before).to_equal("hello")
        expect(after).to_equal("world")
        expect(found).to_equal(true)

    it "returns false when not found":
        step("Verify: returns false when not found")
        val (before, after, found) = cut("hello", "=")
        expect(before).to_equal("hello")
        expect(after).to_equal("")
        expect(found).to_equal(false)

describe "contains_any":
    it "finds vowels":
        step("Verify: finds vowels")
        expect(contains_any("hello", "aeiou")).to_equal(true)

    it "finds no match":
        step("Verify: finds no match")
        expect(contains_any("xyz", "aeiou")).to_equal(false)

    it "handles empty string":
        step("Verify: handles empty string")
        expect(contains_any("", "abc")).to_equal(false)

    it "handles empty chars":
        step("Verify: handles empty chars")
        expect(contains_any("hello", "")).to_equal(false)

