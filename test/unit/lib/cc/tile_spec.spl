"""
## Purpose and audience
Purpose: Prove that Tile.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-CC-001 — stable requirement identity for this spec.

# Tests for cc::Tile — single raster tile in the compositor tile cache.

use std.spipe.*
use std.cc.entity.tile.{
    Tile, TileId, TilePriority, TileDrawState,
    tile_id_new, tile_new
}
use std.skia.entity.geometry.{SkRect, sk_rect}
use std.skia.backend.cpu.raster_prims.{Bitmap}

fn _make_tile() -> Tile:
    val id = tile_id_new(7, 2, 3, 1.0)
    val rect = sk_rect(0.0, 0.0, 256.0, 256.0)
    tile_new(id, rect)

use std.spec.step

describe "Tile":
    it "tile_new: default priority is Eventually, draw_state is Unrasterized":
        step("Verify: tile_new: default priority is Eventually, draw_state is Unrasterized")
        # @req: REQ-LIB-CC-001
        val t = _make_tile()
        expect(t.priority).to_equal(TilePriority.Eventually)
        expect(t.draw_state).to_equal(TileDrawState.Unrasterized)
        expect(t.has_raster_task).to_equal(false)
        expect(t.required_for_activation).to_equal(false)
        expect(t.id.layer_id).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(t.content_rect.right).to_be_greater_than(0.0)

    it "set_priority: updates priority field":
        step("Verify: set_priority: updates priority field")
        var t = _make_tile()
        t.set_priority(TilePriority.Now)
        expect(t.priority).to_equal(TilePriority.Now)
        t.set_priority(TilePriority.Soon)
        expect(t.priority).to_equal(TilePriority.Soon)

    it "begin_raster: sets InProgress and has_raster_task=true":
        step("Verify: begin_raster: sets InProgress and has_raster_task=true")
        var t = _make_tile()
        t.begin_raster()
        expect(t.draw_state).to_equal(TileDrawState.InProgress)
        expect(t.has_raster_task).to_equal(true)

    it "complete_raster: sets Ready state with provided bitmap":
        step("Verify: complete_raster: sets Ready state with provided bitmap")
        var t = _make_tile()
        t.begin_raster()
        val bmp = Bitmap.zeros(64, 64)
        t.complete_raster(bmp)
        expect(t.draw_state).to_equal(TileDrawState.Ready)
        expect(t.has_raster_task).to_equal(false)
        expect(t.bitmap.width).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(t.bitmap.height).to_equal(64)  # oracle: 64 — named expected value from the requirement

    it "fail_raster: sets Failed state":
        step("Verify: fail_raster: sets Failed state")
        var t = _make_tile()
        t.begin_raster()
        t.fail_raster()
        expect(t.draw_state).to_equal(TileDrawState.Failed)
        expect(t.has_raster_task).to_equal(false)

    it "is_ready: true only when draw_state is Ready":
        step("Verify: is_ready: true only when draw_state is Ready")
        var t = _make_tile()
        expect(t.is_ready).to_equal(false)
        t.begin_raster()
        expect(t.is_ready).to_equal(false)
        val bmp = Bitmap.zeros(32, 32)
        t.complete_raster(bmp)
        expect(t.is_ready).to_equal(true)
        # Failed is not Ready
        var t2 = _make_tile()
        t2.begin_raster()
        t2.fail_raster()
        expect(t2.is_ready).to_equal(false)

    it "mark_required_for_activation: updates flag":
        step("Verify: mark_required_for_activation: updates flag")
        var t = _make_tile()
        expect(t.required_for_activation).to_equal(false)
        t.mark_required_for_activation(true)
        expect(t.required_for_activation).to_equal(true)
        t.mark_required_for_activation(false)
        expect(t.required_for_activation).to_equal(false)
