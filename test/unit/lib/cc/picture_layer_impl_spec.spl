"""
## Purpose and audience
Purpose: Prove that RasterSource.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-CC-001 — stable requirement identity for this spec.

# @cover src/lib/cc/feature/picture_layer_impl.spl 80%
#
# PictureLayerImpl is the compositor-side layer that owns a RasterSource.
# These examples deliberately OBSERVE the raster source (op count, cull rect,
# emptiness) and the drawability decision derived from it, rather than merely
# echoing back the Layer that was handed to the constructor. A stub that
# stores its arguments and returns default/empty values fails here: the
# recorded-vs-empty picture pair below must produce DIFFERENT answers.

use std.spipe.*
use std.cc.entity.layer.{Layer, LayerKind}
use std.cc.feature.raster_source.{RasterSource}
use std.cc.feature.picture_layer_impl.{PictureLayerImpl}
use std.skia.entity.geometry.{SkRect}
use std.skia.entity.paint.{SkPaint, sk_paint_new}
use std.skia.entity.picture.{SkPicture, SkPictureOp, sk_picture_op_draw_rect}

fn _bounds() -> SkRect:
    SkRect(left: 0.0, top: 0.0, right: 256.0, bottom: 256.0)

# A picture that actually recorded two draw ops covering `_bounds()`.
fn _recorded_picture() -> SkPicture:
    val paint = sk_paint_new()
    val ops = [
        sk_picture_op_draw_rect(SkRect(left: 0.0, top: 0.0, right: 128.0, bottom: 128.0), paint),
        sk_picture_op_draw_rect(SkRect(left: 128.0, top: 128.0, right: 256.0, bottom: 256.0), paint)
    ]
    SkPicture(cull_rect: _bounds(), op_count: 2, ops: ops)

# A picture that recorded nothing at all.
fn _blank_picture() -> SkPicture:
    val no_ops: [SkPictureOp] = []
    SkPicture(cull_rect: SkRect(left: 0.0, top: 0.0, right: 0.0, bottom: 0.0),
              op_count: 0, ops: no_ops)

fn _layer(id: i64) -> Layer:
    Layer(id: id, kind: LayerKind.Picture, bounds: _bounds(),
          opacity: 1.0, draws_content: true)

use std.spec.step

describe "RasterSource":
    it "carries the recorded op count of the picture it wraps":
        step("Verify: carries the recorded op count of the picture it wraps")
        # @req: REQ-LIB-CC-001
        val rs = RasterSource.from_picture(_recorded_picture())
        expect(rs.op_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "is not empty when the picture recorded ops":
        step("Verify: is not empty when the picture recorded ops")
        val rs = RasterSource.from_picture(_recorded_picture())
        expect(rs.is_empty()).to_equal(false)

    it "is empty when the picture recorded nothing":
        step("Verify: is empty when the picture recorded nothing")
        val rs = RasterSource.from_picture(_blank_picture())
        expect(rs.is_empty()).to_equal(true)
        expect(rs.op_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "adopts the picture's cull rect as its rasterizable area":
        step("Verify: adopts the picture's cull rect as its rasterizable area")
        val rs = RasterSource.from_picture(_recorded_picture())
        expect(rs.cull_rect.right).to_equal(256.0)  # oracle: 256.0 — named expected value from the requirement
        expect(rs.cull_rect.bottom).to_equal(256.0)  # oracle: 256.0 — named expected value from the requirement

describe "PictureLayerImpl":
    it "from_layer keeps the layer it was given":
        step("Verify: from_layer keeps the layer it was given")
        val impl = PictureLayerImpl.from_layer(_layer(7),
                                               RasterSource.from_picture(_recorded_picture()))
        expect(impl.base.id).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "exposes the raster source's recorded content, not a fresh empty one":
        step("Verify: exposes the raster source's recorded content, not a fresh empty one")
        val impl = PictureLayerImpl.from_layer(_layer(7),
                                               RasterSource.from_picture(_recorded_picture()))
        expect(impl.raster_source.op_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(impl.raster_source.is_empty()).to_equal(false)

    # The positive/negative pair is the discriminator: a stub returning a
    # constant for is_drawable() fails one of these two examples.
    it "is drawable when its raster source has recorded ops":
        step("Verify: is drawable when its raster source has recorded ops")
        val impl = PictureLayerImpl.from_layer(_layer(7),
                                               RasterSource.from_picture(_recorded_picture()))
        expect(impl.is_drawable()).to_equal(true)

    it "is not drawable when its raster source recorded nothing":
        step("Verify: is not drawable when its raster source recorded nothing")
        val impl = PictureLayerImpl.from_layer(_layer(7),
                                               RasterSource.from_picture(_blank_picture()))
        expect(impl.is_drawable()).to_equal(false)

    it "is not drawable when the base layer does not draw content":
        step("Verify: is not drawable when the base layer does not draw content")
        val quiet = Layer(id: 7, kind: LayerKind.Picture, bounds: _bounds(),
                          opacity: 1.0, draws_content: false)
        val impl = PictureLayerImpl.from_layer(quiet,
                                               RasterSource.from_picture(_recorded_picture()))
        expect(impl.is_drawable()).to_equal(false)
