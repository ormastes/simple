"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/blink/html_tokenizer_tree_builder_pipeline_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/lib/blink/html_parser/tokenizer.spl 80%
# @req REQ-BLINK-HTML-TOK-PIPELINE-001
"""
# HTML Tokenizer → Tree Builder Pipeline Specification

**Category:** Browser / Blink port
**Status:** Active

## Overview

Every other tokenizer spec hand-builds `HtmlToken` values and every tree
builder spec consumes those hand-built tokens directly — neither proves the
two stages actually agree with each other. This spec closes that gap: it
hands `tokenize_html` a real HTML source string and feeds the resulting
token stream straight into `build_html_tree`, asserting on the DOM tree
that comes out the other end. A tag-name bug, an attribute-parsing bug, or
a mismatch in how the tokenizer chunks text would show up here even though
each half's own unit spec stays green.

Deliberately out of scope (inherited from both stages): entity decoding,
RAWTEXT/RCDATA modes, CDATA sections, HTML5 insertion-mode algorithms
(implied tags, adoption agency, foster parenting).

@manual_section Browser Rendering
"""

use std.spipe.*
use std.blink.html_parser.{tokenize_html, HtmlTokenKind}
use std.blink.html_parser.tree_builder.{build_html_tree}
use std.blink.dom.node.{NodeType}

describe "tokenize_html piped into build_html_tree":
    it "builds a nested element tree from a real HTML string, not hand-built tokens":
        # @req: REQ-UNIT-LIB-001
            # @req: REQ-UNIT-LIB-002
            # @req: REQ-UNIT-LIB-003
        step("Verify: builds a nested element tree from a real HTML string, not hand-built tokens")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a small page: html > body > p with a class, plus text")
        val html = "<html><body><p class=\"greet\">hi there</p></body></html>"
        val tree = build_html_tree(tokenize_html(html))

        step("root(0) + html(1) + body(2) + p(3) + text(4) = 5 nodes")
        expect(tree.nodes.len()).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

        step("html is a child of the document root")
        match tree.get_node(1):
            Some(html_node):
                expect(html_node.tag_name).to_equal("html")
                expect(html_node.node_type).to_equal(NodeType.Element)
                expect(html_node.parent).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            None:
                expect("html element created").to_equal("it was not")

        step("body nests under html")
        match tree.get_node(2):
            Some(body_node):
                expect(body_node.tag_name).to_equal("body")
                expect(body_node.parent).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            None:
                expect("body element created").to_equal("it was not")

        step("p nests under body and kept its class attribute from the source text")
        match tree.get_node(3):
            Some(p_node):
                expect(p_node.tag_name).to_equal("p")
                expect(p_node.parent).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
                match tree.get_attribute(3, "class"):
                    Some(v):
                        expect(v).to_equal("greet")
                    None:
                        expect("class attribute parsed").to_equal("it was not")
            None:
                expect("p element created").to_equal("it was not")

        step("the tokenizer coalesced \"hi there\" into one text node under p")
        match tree.get_node(4):
            Some(text_node):
                expect(text_node.node_type).to_equal(NodeType.Text)
                expect(text_node.text_content).to_equal("hi there")
                expect(text_node.parent).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
            None:
                expect("text node created").to_equal("it was not")

    it "keeps a self-closing void element childless and its trailing text a sibling":
        # @req: REQ-UNIT-LIB-004
        step("Verify: keeps a self-closing void element childless and its trailing text a sibling")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a line break followed by text, with no matching end tag")
        val html = "<div>before<br/>after</div>"
        val tree = build_html_tree(tokenize_html(html))

        step("root(0) + div(1) + text(2) + br(3) + text(4) = 5 nodes")
        expect(tree.nodes.len()).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

        step("br is self-closing, so it never opened as an insertion point")
        match tree.get_node(3):
            Some(br_node):
                expect(br_node.tag_name).to_equal("br")
                expect(br_node.first_child).to_equal(-1)  # oracle: expected value -1 is the behavior asserted by this regression spec
                expect(br_node.parent).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            None:
                expect("br element created").to_equal("it was not")

        step("the trailing text after <br/> lands as div's child, not br's")
        match tree.get_node(4):
            Some(text_node):
                expect(text_node.text_content).to_equal("after")
                expect(text_node.parent).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            None:
                expect("trailing text node created").to_equal("it was not")

    it "drops a comment and a doctype from the tree while keeping surrounding elements":
        # @req: REQ-UNIT-LIB-005
        step("Verify: drops a comment and a doctype from the tree while keeping surrounding elements")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a doctype, a comment, then a real element")
        val html = "<!DOCTYPE html><!-- note --><span>x</span>"
        val toks = tokenize_html(html)

        step("the tokenizer itself still reports the doctype and comment tokens")
        expect(toks[0].kind).to_equal(HtmlTokenKind.Doctype)
        expect(toks[0].name).to_equal("html")
        expect(toks[1].kind).to_equal(HtmlTokenKind.Comment)

        step("but the tree builder ignores Doctype and has no dedicated Comment-skip for span's parent")
        val tree = build_html_tree(toks)
        # root(0) + comment(1, still a real DOM node) + span(2) + text(3) = 4 nodes
        expect(tree.nodes.len()).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
        match tree.get_node(2):
            Some(span_node):
                expect(span_node.tag_name).to_equal("span")
                expect(span_node.parent).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            None:
                expect("span element created").to_equal("it was not")
