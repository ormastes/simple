"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/blink/paint/effect_paint_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/lib/blink/paint/effect_paint.spl 90%
# @req REQ-BLINK-PAINT-EFFECTS-002
"""
# Blink Visual-Effect Lowering Specification

**Category:** Browser / Blink
**Status:** Active

## Overview

Parsing a `box-shadow` is only half the job; the other half is turning it into
something the rasterizer can actually draw. blink's paint output is a flat list
of axis-aligned rects, each with one solid colour — that is the entire drawing
vocabulary, and these examples pin exactly what it can and cannot express.

Shadows become an offset, spread rect plus concentric alpha bands standing in
for blur. Gradients become solid strips. Transforms move and scale the rect.

Where the vocabulary runs out, I want an error, not an approximation dressed up
as success: an `inset` shadow is a clipped inner ring, a rotated box is a
quadrilateral, and a diagonal gradient's colour bands do not follow any rect
edge. All three are refused rather than painted wrong.

@manual_section Browser Rendering
"""

use std.spipe.*
use std.common.color.types.{from_rgba}
use std.common.ui.render_opt.paint_chunk_rasterizer.{PaintChunkRects}
use std.blink.paint.effects.{BoxShadow, Transform2D, parse_box_shadow, parse_transform, parse_linear_gradient}
use std.blink.paint.effect_paint.{paint_box_shadow, paint_box_shadows, transform_bounds, paint_transformed_rect, gradient_color_at, paint_linear_gradient}

fn _shadow(raw: text) -> BoxShadow:
    match parse_box_shadow(raw):
        Ok(layers):
            layers[0 as i32]
        Err(m):
            BoxShadow(offset_x: 0.0, offset_y: 0.0, blur: 0.0, spread: 0.0,
                      color: from_rgba(0, 0, 0, 0), inset: false)

describe "paint_box_shadow":
    it "offsets the shadow rect by the shadow's offset and leaves size alone":
        # @req: REQ-UNIT-LIB-001
            # @req: REQ-UNIT-LIB-002
            # @req: REQ-UNIT-LIB-003
        step("Verify: offsets the shadow rect by the shadow's offset and leaves size alone")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("a 100x50 box at (10, 20) with a 5px/7px unblurred shadow")
        var rects = PaintChunkRects.create()
        val r = paint_box_shadow(rects, 10.0, 20.0, 100.0, 50.0, _shadow("5px 7px black"))

        step("one rect is emitted — no blur means no bands")
        expect(r.is_ok()).to_equal(true)
        expect(rects.rect_count).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        step("the rect sits at box origin plus offset: 10+5 = 15, 20+7 = 27")
        expect(rects.rect_x[0]).to_equal(15)  # oracle: expected value 15 is the behavior asserted by this regression spec
        expect(rects.rect_y[0]).to_equal(27)  # oracle: expected value 27 is the behavior asserted by this regression spec

        step("with no spread the shadow is exactly the box's size")
        expect(rects.rect_w[0]).to_equal(100)  # oracle: expected value 100 is the behavior asserted by this regression spec
        expect(rects.rect_h[0]).to_equal(50)  # oracle: expected value 50 is the behavior asserted by this regression spec

    it "grows the shadow by the spread on every side":
        # @req: REQ-UNIT-LIB-004
        step("Verify: grows the shadow by the spread on every side")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("the same box with a 10px spread and no offset")
        var rects = PaintChunkRects.create()
        paint_box_shadow(rects, 10.0, 20.0, 100.0, 50.0, _shadow("0 0 0 10px black"))

        step("spread outsets each edge by 10, so origin moves back by 10")
        expect(rects.rect_x[0]).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(rects.rect_y[0]).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec

        step("and each dimension grows by 10 on BOTH sides: 100+20 = 120, 50+20 = 70")
        expect(rects.rect_w[0]).to_equal(120)  # oracle: expected value 120 is the behavior asserted by this regression spec
        expect(rects.rect_h[0]).to_equal(70)  # oracle: expected value 70 is the behavior asserted by this regression spec

    it "approximates blur with four outset bands of rising alpha plus the core":
        # @req: REQ-UNIT-LIB-005
        step("Verify: approximates blur with four outset bands of rising alpha plus the core")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("an 8px blurred shadow on a 100x50 box at the origin")
        var rects = PaintChunkRects.create()
        val r = paint_box_shadow(rects, 0.0, 0.0, 100.0, 50.0, _shadow("0 0 8px black"))

        step("four blur bands plus the solid core rect = 5 rects")
        match r:
            Ok(n):
                expect(n).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec
            Err(m):
                expect(m).to_equal("")
        expect(rects.rect_count).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

        step("band 0 is the outermost: outset 8*(4-0)/4 = 8, so it starts at -8")
        expect(rects.rect_x[0]).to_equal(-8)  # oracle: expected value -8 is the behavior asserted by this regression spec
        # 100 + 2*8
        expect(rects.rect_w[0]).to_equal(116)  # oracle: expected value 116 is the behavior asserted by this regression spec

        step("band 0 is also the faintest: alpha 255 * (0+1)/4 = 63.75 -> 64")
        # Packed 0xAARRGGBB over an opaque-black shadow: only the alpha byte varies.
        expect(rects.colour[0]).to_equal(64 * 16777216)

        step("band 3 is the innermost: outset 8*(4-3)/4 = 2, alpha 255*4/4 = 255")
        expect(rects.rect_x[3]).to_equal(-2)  # oracle: expected value -2 is the behavior asserted by this regression spec
        expect(rects.rect_w[3]).to_equal(104)  # oracle: expected value 104 is the behavior asserted by this regression spec

        step("the core is painted last, unoutset and fully opaque, so it wins the overlap")
        expect(rects.rect_x[4]).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(rects.rect_w[4]).to_equal(100)  # oracle: expected value 100 is the behavior asserted by this regression spec
        expect(rects.rect_h[4]).to_equal(50)  # oracle: expected value 50 is the behavior asserted by this regression spec

    it "paints nothing for a spread that collapses the box":
        # @req: REQ-UNIT-LIB-006
        step("Verify: paints nothing for a spread that collapses the box")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("a 20x20 box with a -15px spread, which removes 30 from each dimension")
        var rects = PaintChunkRects.create()
        val r = paint_box_shadow(rects, 0.0, 0.0, 20.0, 20.0, _shadow("0 0 0 -15px black"))

        step("a collapsed shadow is a real CSS outcome — zero rects, not an error")
        match r:
            Ok(n):
                expect(n).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            Err(m):
                expect(m).to_equal("")
        expect(rects.rect_count).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "refuses an inset shadow rather than painting it outside the box":
        # @req: REQ-UNIT-LIB-007
        step("Verify: refuses an inset shadow rather than painting it outside the box")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("lower an inset shadow")
        var rects = PaintChunkRects.create()
        val r = paint_box_shadow(rects, 0.0, 0.0, 100.0, 50.0, _shadow("inset 2px 2px black"))

        step("an inner ring clipped to the padding box has no flat-rect form, so it errors")
        expect(r.is_ok()).to_equal(false)

        step("and nothing was appended on the way to failing")
        expect(rects.rect_count).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

describe "paint_box_shadows":
    it "paints layers back-to-front so the first-authored layer ends up on top":
        # @req: REQ-UNIT-LIB-008
        step("Verify: paints layers back-to-front so the first-authored layer ends up on top")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("a two-layer shadow whose layers have distinct offsets")
        var rects = PaintChunkRects.create()
        var layers: [BoxShadow] = []
        match parse_box_shadow("1px 1px red, 5px 5px blue"):
            Ok(ls):
                layers = ls
            Err(m):
                expect(m).to_equal("")
        paint_box_shadows(rects, 0.0, 0.0, 10.0, 10.0, layers)

        step("two rects, and the LAST-authored layer (offset 5) is appended first")
        expect(rects.rect_count).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(rects.rect_x[0]).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

        step("so the first-authored layer (offset 1) is appended last and overwrites it")
        expect(rects.rect_x[1]).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

describe "transform_bounds":
    it "returns the moved rect for a pure translation":
        # @req: REQ-UNIT-LIB-009
        step("Verify: returns the moved rect for a pure translation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("translate a 100x50 box at the origin by (10, 20)")
        var t = Transform2D.identity()
        match parse_transform("translate(10px, 20px)"):
            Ok(m):
                t = m
            Err(e):
                expect(e).to_equal("")
        val b = transform_bounds(t, 0.0, 0.0, 100.0, 50.0)

        step("every corner shifts by the same vector, so the bounds are the box moved")
        expect(b.0).to_equal(10.0)
        expect(b.1).to_equal(20.0)
        expect(b.2).to_equal(110.0)
        expect(b.3).to_equal(70.0)

    it "grows the bounds of a rotated box beyond the box itself":
        # @req: REQ-UNIT-LIB-010
        step("Verify: grows the bounds of a rotated box beyond the box itself")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("rotate a 100x50 box by 45 degrees")
        var t = Transform2D.identity()
        match parse_transform("rotate(45deg)"):
            Ok(m):
                t = m
            Err(e):
                expect(e).to_equal("")
        val b = transform_bounds(t, 0.0, 0.0, 100.0, 50.0)

        step("the diagonal projects onto both axes, so the bounds width is (100+50)/sqrt(2) ~= 106.07")
        val w = b.2 - b.0
        expect(w > 106.0 and w < 106.1).to_equal(true)

        step("which is strictly larger than the 100 the box occupied — the bounds are NOT the shape")
        expect(w > 100.0).to_equal(true)

describe "paint_transformed_rect":
    it "scales a box about the origin":
        # @req: REQ-UNIT-LIB-011
        step("Verify: scales a box about the origin")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("scale a 10x10 box at (4, 6) by 2")
        var rects = PaintChunkRects.create()
        var t = Transform2D.identity()
        match parse_transform("scale(2)"):
            Ok(m):
                t = m
            Err(e):
                expect(e).to_equal("")
        paint_transformed_rect(rects, t, 4.0, 6.0, 10.0, 10.0, from_rgba(255, 0, 0, 255))

        step("scaling about the origin doubles the position too: 4*2 = 8, 6*2 = 12")
        expect(rects.rect_x[0]).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec
        expect(rects.rect_y[0]).to_equal(12)  # oracle: expected value 12 is the behavior asserted by this regression spec

        step("and doubles the size: 10*2 = 20")
        expect(rects.rect_w[0]).to_equal(20)  # oracle: expected value 20 is the behavior asserted by this regression spec
        expect(rects.rect_h[0]).to_equal(20)  # oracle: expected value 20 is the behavior asserted by this regression spec

        step("the fill colour is packed 0xAARRGGBB, so opaque red is 0xFFFF0000")
        expect(rects.colour[0]).to_equal(4294901760)  # oracle: expected value 4294901760 is the behavior asserted by this regression spec

    it "refuses a rotated box rather than painting its bounding box":
        # @req: REQ-UNIT-LIB-012
        step("Verify: refuses a rotated box rather than painting its bounding box")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("paint a box under a 30-degree rotation")
        var rects = PaintChunkRects.create()
        var t = Transform2D.identity()
        match parse_transform("rotate(30deg)"):
            Ok(m):
                t = m
            Err(e):
                expect(e).to_equal("")
        val r = paint_transformed_rect(rects, t, 0.0, 0.0, 10.0, 10.0, from_rgba(0, 0, 0, 255))

        step("the true shape is a quadrilateral; its bounds would colour pixels the element does not cover")
        expect(r.is_ok()).to_equal(false)
        expect(rects.rect_count).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "paints an exact quarter turn, whose shape really is its bounds":
        # @req: REQ-UNIT-LIB-013
        step("Verify: paints an exact quarter turn, whose shape really is its bounds")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("rotate a 40-wide, 10-tall box at the origin by exactly 90 degrees")
        var rects = PaintChunkRects.create()
        var t = Transform2D.identity()
        match parse_transform("rotate(90deg)"):
            Ok(m):
                t = m
            Err(e):
                expect(e).to_equal("")
        val r = paint_transformed_rect(rects, t, 0.0, 0.0, 40.0, 10.0, from_rgba(0, 0, 255, 255))

        step("a quarter turn maps a rect onto a rect, so painting the bounds is exact, not an approximation")
        expect(r.is_ok()).to_equal(true)
        expect(rects.rect_count).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        step("clockwise-in-y-down 90deg sends (x,y) to (-y,x): the corners (0,0) and (40,10) become (0,0) and (-10,40)")
        step("so the bounds run x from -10 to 0 and y from 0 to 40 — origin (-10, 0)")
        expect(rects.rect_x[0]).to_equal(-10)  # oracle: expected value -10 is the behavior asserted by this regression spec
        expect(rects.rect_y[0]).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        step("width and height swap: the 40-wide, 10-tall box becomes 10 wide and 40 tall")
        expect(rects.rect_w[0]).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec
        expect(rects.rect_h[0]).to_equal(40)  # oracle: expected value 40 is the behavior asserted by this regression spec

describe "gradient_color_at":
    it "interpolates linearly between the two bracketing stops":
        # @req: REQ-UNIT-LIB-014
        step("Verify: interpolates linearly between the two bracketing stops")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("a red-to-blue gradient sampled at its midpoint")
        match parse_linear_gradient("linear-gradient(red, blue)"):
            Ok(g):
                val c = gradient_color_at(g, 0.5)

                step("halfway from 255 to 0 is 127.5, rounded to 128")
                expect(c.r).to_equal(128)  # oracle: expected value 128 is the behavior asserted by this regression spec

                step("and halfway from 0 to 255 is likewise 128")
                expect(c.b).to_equal(128)  # oracle: expected value 128 is the behavior asserted by this regression spec

                step("alpha is 255 at both ends, so it stays 255")
                expect(c.a).to_equal(255)  # oracle: expected value 255 is the behavior asserted by this regression spec
            Err(m):
                expect(m).to_equal("")

    it "clamps to the end colours outside the stop range":
        # @req: REQ-UNIT-LIB-015
        step("Verify: clamps to the end colours outside the stop range")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("sample a red-to-blue gradient before its first stop")
        match parse_linear_gradient("linear-gradient(red, blue)"):
            Ok(g):
                val c = gradient_color_at(g, 0.0 - 1.0)

                step("CSS extends the first stop's colour backwards, so this is pure red")
                expect(c.r).to_equal(255)  # oracle: expected value 255 is the behavior asserted by this regression spec
                expect(c.b).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            Err(m):
                expect(m).to_equal("")

describe "paint_linear_gradient":
    it "splits a to-bottom gradient into seamless horizontal strips":
        # @req: REQ-UNIT-LIB-016
        step("Verify: splits a to-bottom gradient into seamless horizontal strips")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("a black-to-white to-bottom gradient over a 100x100 box, in 4 bands")
        var rects = PaintChunkRects.create()
        match parse_linear_gradient("linear-gradient(black, white)"):
            Ok(g):
                val r = paint_linear_gradient(rects, 0.0, 0.0, 100.0, 100.0, g, 4)
                expect(r.is_ok()).to_equal(true)

                step("four bands, each a full-width strip 100/4 = 25 tall")
                expect(rects.rect_count).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
                expect(rects.rect_w[0]).to_equal(100)  # oracle: expected value 100 is the behavior asserted by this regression spec
                expect(rects.rect_h[0]).to_equal(25)  # oracle: expected value 25 is the behavior asserted by this regression spec

                step("band edges abut with no seam: band 1 starts where band 0 ended")
                expect(rects.rect_y[0]).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
                expect(rects.rect_y[1]).to_equal(25)  # oracle: expected value 25 is the behavior asserted by this regression spec
                expect(rects.rect_y[2]).to_equal(50)  # oracle: expected value 50 is the behavior asserted by this regression spec
                expect(rects.rect_y[3]).to_equal(75)  # oracle: expected value 75 is the behavior asserted by this regression spec

                step("band 0 samples its midpoint 0.5/4 = 0.125, giving grey 0.125*255 = 31.875 -> 32")
                # 0xFF202020 = 255<<24 | 32<<16 | 32<<8 | 32
                expect(rects.colour[0]).to_equal(4280295456)  # oracle: expected value 4280295456 is the behavior asserted by this regression spec

                step("band 3 samples 3.5/4 = 0.875, giving 223 — brighter, since to-bottom runs black to white")
                # 0xFFDFDFDF
                expect(rects.colour[3]).to_equal(4292861919)  # oracle: expected value 4292861919 is the behavior asserted by this regression spec
            Err(m):
                expect(m).to_equal("")

    it "runs a to-top gradient against the pixel axis":
        # @req: REQ-UNIT-LIB-017
        step("Verify: runs a to-top gradient against the pixel axis")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("the same black-to-white gradient, but pointing to the top")
        var rects = PaintChunkRects.create()
        match parse_linear_gradient("linear-gradient(to top, black, white)"):
            Ok(g):
                paint_linear_gradient(rects, 0.0, 0.0, 100.0, 100.0, g, 4)

                step("0deg points up, so the FIRST (topmost) band is now the white end: 223")
                expect(rects.colour[0]).to_equal(4292861919)  # oracle: expected value 4292861919 is the behavior asserted by this regression spec

                step("and the bottom band is the black end: 32")
                expect(rects.colour[3]).to_equal(4280295456)  # oracle: expected value 4280295456 is the behavior asserted by this regression spec
            Err(m):
                expect(m).to_equal("")

    it "splits a to-right gradient into vertical strips":
        # @req: REQ-UNIT-LIB-018
        step("Verify: splits a to-right gradient into vertical strips")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("a to-right gradient over a 100x40 box in 2 bands")
        var rects = PaintChunkRects.create()
        match parse_linear_gradient("linear-gradient(to right, black, white)"):
            Ok(g):
                paint_linear_gradient(rects, 0.0, 0.0, 100.0, 40.0, g, 2)

                step("bands now run along x: each is 100/2 = 50 wide and full height")
                expect(rects.rect_w[0]).to_equal(50)  # oracle: expected value 50 is the behavior asserted by this regression spec
                expect(rects.rect_h[0]).to_equal(40)  # oracle: expected value 40 is the behavior asserted by this regression spec
                expect(rects.rect_x[0]).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
                expect(rects.rect_x[1]).to_equal(50)  # oracle: expected value 50 is the behavior asserted by this regression spec
            Err(m):
                expect(m).to_equal("")

    it "refuses a diagonal gradient rather than snapping it to an axis":
        # @req: REQ-UNIT-LIB-019
        step("Verify: refuses a diagonal gradient rather than snapping it to an axis")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("lower a 45-degree gradient")
        var rects = PaintChunkRects.create()
        match parse_linear_gradient("linear-gradient(45deg, black, white)"):
            Ok(g):
                val r = paint_linear_gradient(rects, 0.0, 0.0, 100.0, 100.0, g, 4)

                step("its iso-colour lines follow no rect edge, so no strip decomposition is faithful")
                expect(r.is_ok()).to_equal(false)
                expect(rects.rect_count).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            Err(m):
                expect(m).to_equal("")

    it "refuses a non-positive band count":
        # @req: REQ-UNIT-LIB-020
        step("Verify: refuses a non-positive band count")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("ask for zero bands")
        var rects = PaintChunkRects.create()
        match parse_linear_gradient("linear-gradient(black, white)"):
            Ok(g):
                val r = paint_linear_gradient(rects, 0.0, 0.0, 10.0, 10.0, g, 0)

                step("zero bands would paint nothing while reporting success — an error instead")
                expect(r.is_ok()).to_equal(false)
            Err(m):
                expect(m).to_equal("")
