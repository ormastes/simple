"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/blink/paint/effects_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/lib/blink/paint/effects.spl 90%
# @req REQ-BLINK-PAINT-EFFECTS-001
"""
# Blink Visual-Effect Value Parsing Specification

**Category:** Browser / Blink
**Status:** Active

## Overview

I want blink to understand the three visual-effect properties it was missing —
`box-shadow`, `transform` and `linear-gradient()` — and, just as importantly, to
tell me clearly when it does not understand a value.

Blink's earlier habit was to answer opaque black for any colour it could not
parse: a wrong pixel rather than an error, invisible to every smoke test. These
examples pin the opposite contract. Every entry point returns a `Result`, so an
unsupported unit, a malformed function or a nonsense keyword comes back as a
failure I can see, never as a substituted default.

Colours inside these values are not parsed here at all — they go through the
one shared CSS colour parser in `common.color.css`, so there is no second
colour implementation to drift.

@manual_section Browser Rendering
"""

use std.spipe.*
use std.blink.paint.effects.{parse_box_shadow, parse_transform, parse_linear_gradient}

describe "parse_box_shadow":
    it "reads offset, blur, spread and colour from a full four-length layer":
        # @req: REQ-UNIT-LIB-001
            # @req: REQ-UNIT-LIB-002
            # @req: REQ-UNIT-LIB-003
        step("Verify: reads offset, blur, spread and colour from a full four-length layer")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a shadow with all four lengths and an explicit colour")
        val r = parse_box_shadow("2px 4px 6px 8px red")

        step("every field lands on the value authored in that position")
        expect(r.is_ok()).to_equal(true)
        match r:
            Ok(layers):
                # One comma-free value is exactly one shadow layer.
                expect(layers.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
                val s = layers[0 as i32]
                expect(s.offset_x).to_equal(2.0)
                expect(s.offset_y).to_equal(4.0)
                # Third length is blur, fourth is spread — CSS order.
                expect(s.blur).to_equal(6.0)
                expect(s.spread).to_equal(8.0)
                # `red` is CSS #FF0000, fully opaque.
                expect(s.color.r).to_equal(255)  # oracle: expected value 255 is the behavior asserted by this regression spec
                expect(s.color.g).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
                expect(s.color.b).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
                expect(s.color.a).to_equal(255)  # oracle: expected value 255 is the behavior asserted by this regression spec
                expect(s.inset).to_equal(false)
            Err(m):
                expect(m).to_equal("")

    it "defaults blur and spread to zero when only the two offsets are given":
        # @req: REQ-UNIT-LIB-004
        step("Verify: defaults blur and spread to zero when only the two offsets are given")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse the minimal legal shadow: two offsets and a colour")
        val r = parse_box_shadow("1px 2px black")

        step("the two omitted lengths are the CSS initial 0, not garbage")
        match r:
            Ok(layers):
                expect(layers[0 as i32].blur).to_equal(0.0)
                expect(layers[0 as i32].spread).to_equal(0.0)
            Err(m):
                expect(m).to_equal("")

    it "keeps comma-separated layers in source order":
        # @req: REQ-UNIT-LIB-005
        step("Verify: keeps comma-separated layers in source order")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a two-layer shadow")
        val r = parse_box_shadow("1px 1px red, 5px 5px blue")

        step("layer 0 is the first-authored one, which CSS paints on top")
        match r:
            Ok(layers):
                expect(layers.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
                expect(layers[0 as i32].offset_x).to_equal(1.0)
                expect(layers[0 as i32].color.r).to_equal(255)  # oracle: expected value 255 is the behavior asserted by this regression spec
                expect(layers[1 as i32].offset_x).to_equal(5.0)
                # `blue` is #0000FF.
                expect(layers[1 as i32].color.b).to_equal(255)  # oracle: expected value 255 is the behavior asserted by this regression spec
            Err(m):
                expect(m).to_equal("")

    it "survives a colour function containing commas":
        # @req: REQ-UNIT-LIB-006
        step("Verify: survives a colour function containing commas")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a shadow whose colour is rgba(), whose commas are nested")
        val r = parse_box_shadow("0 0 4px rgba(0, 0, 0, 0.5)")

        step("the value is ONE layer, not four split on the inner commas")
        match r:
            Ok(layers):
                expect(layers.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
                # 0.5 alpha scaled to a byte and rounded: 0.5*255 = 127.5 -> 128.
                expect(layers[0 as i32].color.a).to_equal(128)  # oracle: expected value 128 is the behavior asserted by this regression spec
            Err(m):
                expect(m).to_equal("")

    it "reads the inset keyword in either position":
        # @req: REQ-UNIT-LIB-007
        step("Verify: reads the inset keyword in either position")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse an inset shadow")
        val r = parse_box_shadow("inset 0 0 2px red")

        step("the keyword is recorded rather than dropped")
        match r:
            Ok(layers):
                expect(layers[0 as i32].inset).to_equal(true)
            Err(m):
                expect(m).to_equal("")

    it "reports `none` as an empty layer list rather than a failure":
        # @req: REQ-UNIT-LIB-008
        step("Verify: reports `none` as an empty layer list rather than a failure")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse the CSS initial value")
        val r = parse_box_shadow("none")

        step("`none` is a legal value meaning zero shadows")
        match r:
            Ok(layers):
                expect(layers.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            Err(m):
                expect(m).to_equal("")

    it "fails on a single offset because CSS requires two":
        # @req: REQ-UNIT-LIB-009
        step("Verify: fails on a single offset because CSS requires two")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a shadow with one length")
        val r = parse_box_shadow("4px red")

        step("this is an error, not a shadow with a guessed second offset")
        expect(r.is_ok()).to_equal(false)

    it "fails on a unit it cannot resolve without font context":
        # @req: REQ-UNIT-LIB-010
        step("Verify: fails on a unit it cannot resolve without font context")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a shadow measured in em")
        val r = parse_box_shadow("1em 1em red")

        step("em would need a font size this leaf does not carry, so it errors rather than silently meaning 0px")
        expect(r.is_ok()).to_equal(false)

    it "fails on an unknown colour keyword instead of substituting black":
        # @req: REQ-UNIT-LIB-011
        step("Verify: fails on an unknown colour keyword instead of substituting black")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a shadow with a colour name that does not exist")
        val r = parse_box_shadow("1px 1px notacolour")

        step("the historic silent-black bug would have made this succeed")
        expect(r.is_ok()).to_equal(false)

describe "parse_transform":
    it "turns translate into the matching affine translation":
        # @req: REQ-UNIT-LIB-012
        step("Verify: turns translate into the matching affine translation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a two-axis translate")
        val r = parse_transform("translate(10px, 20px)")

        step("translation lands in the e/f column; the linear part stays identity")
        match r:
            Ok(t):
                expect(t.a).to_equal(1.0)
                expect(t.d).to_equal(1.0)
                expect(t.e).to_equal(10.0)
                expect(t.f).to_equal(20.0)
            Err(m):
                expect(m).to_equal("")

    it "applies a one-argument scale to both axes":
        # @req: REQ-UNIT-LIB-013
        step("Verify: applies a one-argument scale to both axes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a uniform scale")
        val r = parse_transform("scale(2)")

        step("CSS says scale(s) means scale(s, s), so both diagonal entries are 2")
        match r:
            Ok(t):
                expect(t.a).to_equal(2.0)
                expect(t.d).to_equal(2.0)
            Err(m):
                expect(m).to_equal("")

    it "composes a transform list left-to-right":
        # @req: REQ-UNIT-LIB-014
        step("Verify: composes a transform list left-to-right")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse translate followed by scale")
        val r = parse_transform("translate(10px, 0px) scale(2)")

        step("a point at x=1 maps to 10 + 2*1 = 12, so the translation is NOT scaled")
        match r:
            Ok(t):
                val p = t.apply(1.0, 0.0)
                expect(p.0).to_equal(12.0)
                # The scale still shows in the linear part.
                expect(t.a).to_equal(2.0)
                expect(t.e).to_equal(10.0)
            Err(m):
                expect(m).to_equal("")

    it "reads a 90-degree rotation as an exactly axis-aligned matrix":
        # @req: REQ-UNIT-LIB-015
        step("Verify: reads a 90-degree rotation as an exactly axis-aligned matrix")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a quarter turn")
        val r = parse_transform("rotate(90deg)")

        step("cos(90deg)=0 and sin(90deg)=1, so the point (1,0) maps to (0,1)")
        match r:
            Ok(t):
                val p = t.apply(1.0, 0.0)
                # The series evaluation is not bit-exact, so assert to 1e-9 —
                # far tighter than any pixel could distinguish.
                expect(p.0 < 0.000000001 and p.0 > 0.0 - 0.000000001).to_equal(true)
                expect(p.1 > 0.999999999 and p.1 < 1.000000001).to_equal(true)
            Err(m):
                expect(m).to_equal("")

    it "reads matrix() entries in CSS a,b,c,d,e,f order":
        # @req: REQ-UNIT-LIB-016
        step("Verify: reads matrix() entries in CSS a,b,c,d,e,f order")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse an explicit matrix")
        val r = parse_transform("matrix(1, 2, 3, 4, 5, 6)")

        step("each argument lands in its named slot")
        match r:
            Ok(t):
                expect(t.a).to_equal(1.0)
                expect(t.b).to_equal(2.0)
                expect(t.c).to_equal(3.0)
                expect(t.d).to_equal(4.0)
                expect(t.e).to_equal(5.0)
                expect(t.f).to_equal(6.0)
            Err(m):
                expect(m).to_equal("")

    it "reports `none` as the identity matrix":
        # @req: REQ-UNIT-LIB-017
        step("Verify: reports `none` as the identity matrix")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse the CSS initial value")
        val r = parse_transform("none")

        step("identity maps every point to itself")
        match r:
            Ok(t):
                val p = t.apply(7.0, 9.0)
                expect(p.0).to_equal(7.0)
                expect(p.1).to_equal(9.0)
            Err(m):
                expect(m).to_equal("")

    it "fails on a 3D function rather than dropping the third axis":
        # @req: REQ-UNIT-LIB-018
        step("Verify: fails on a 3D function rather than dropping the third axis")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse translate3d")
        val r = parse_transform("translate3d(1px, 2px, 3px)")

        step("silently discarding the z term would be a wrong transform, so this errors")
        expect(r.is_ok()).to_equal(false)

    it "fails on an angle unit it does not support":
        # @req: REQ-UNIT-LIB-019
        step("Verify: fails on an angle unit it does not support")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a rotation in radians")
        val r = parse_transform("rotate(1rad)")

        step("treating rad as deg would be off by a factor of 57, so it errors")
        expect(r.is_ok()).to_equal(false)

describe "parse_linear_gradient":
    it "defaults an undirected gradient to `to bottom` and spreads stops evenly":
        # @req: REQ-UNIT-LIB-020
        step("Verify: defaults an undirected gradient to `to bottom` and spreads stops evenly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a three-stop gradient with no direction and no positions")
        val r = parse_linear_gradient("linear-gradient(red, green, blue)")

        step("CSS's default gradient direction is to-bottom, which is 180deg")
        match r:
            Ok(g):
                expect(g.angle_deg).to_equal(180.0)
                expect(g.stops.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
                # n=3 stops distribute at k/(n-1): 0, 0.5, 1.
                expect(g.stops[0 as i32].position).to_equal(0.0)
                expect(g.stops[1 as i32].position).to_equal(0.5)
                expect(g.stops[2 as i32].position).to_equal(1.0)
            Err(m):
                expect(m).to_equal("")

    it "reads an explicit angle":
        # @req: REQ-UNIT-LIB-021
        step("Verify: reads an explicit angle")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a 45-degree gradient")
        val r = parse_linear_gradient("linear-gradient(45deg, red, blue)")

        step("the angle is kept verbatim; whether it can be PAINTED is a separate concern")
        match r:
            Ok(g):
                expect(g.angle_deg).to_equal(45.0)
            Err(m):
                expect(m).to_equal("")

    it "maps a `to <side>` keyword to its CSS gradient angle":
        # @req: REQ-UNIT-LIB-022
        step("Verify: maps a `to <side>` keyword to its CSS gradient angle")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a to-right gradient")
        val r = parse_linear_gradient("linear-gradient(to right, red, blue)")

        step("CSS gradient angles are clockwise from up, so `to right` is 90deg")
        match r:
            Ok(g):
                expect(g.angle_deg).to_equal(90.0)
            Err(m):
                expect(m).to_equal("")

    it "keeps an authored stop position instead of redistributing it":
        # @req: REQ-UNIT-LIB-023
        step("Verify: keeps an authored stop position instead of redistributing it")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a gradient whose middle stop is pinned at 25%")
        val r = parse_linear_gradient("linear-gradient(red, green 25%, blue)")

        step("the pinned stop stays at 0.25 while the unpinned ends stay at 0 and 1")
        match r:
            Ok(g):
                expect(g.stops[0 as i32].position).to_equal(0.0)
                expect(g.stops[1 as i32].position).to_equal(0.25)
                expect(g.stops[2 as i32].position).to_equal(1.0)
            Err(m):
                expect(m).to_equal("")

    it "parses colour functions inside stops without splitting on their commas":
        # @req: REQ-UNIT-LIB-024
        step("Verify: parses colour functions inside stops without splitting on their commas")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a gradient whose stops are rgb() functions")
        val r = parse_linear_gradient("linear-gradient(rgb(255, 0, 0), rgb(0, 0, 255))")

        step("two stops, not six")
        match r:
            Ok(g):
                expect(g.stops.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
                expect(g.stops[0 as i32].color.r).to_equal(255)  # oracle: expected value 255 is the behavior asserted by this regression spec
                expect(g.stops[1 as i32].color.b).to_equal(255)  # oracle: expected value 255 is the behavior asserted by this regression spec
            Err(m):
                expect(m).to_equal("")

    it "fails on a one-stop gradient because a gradient needs two ends":
        # @req: REQ-UNIT-LIB-025
        step("Verify: fails on a one-stop gradient because a gradient needs two ends")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a gradient with a single colour")
        val r = parse_linear_gradient("linear-gradient(red)")

        step("there is nothing to interpolate towards, so this is an error not a solid fill")
        expect(r.is_ok()).to_equal(false)

    it "fails on radial-gradient rather than treating it as linear":
        # @req: REQ-UNIT-LIB-026
        step("Verify: fails on radial-gradient rather than treating it as linear")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a radial gradient")
        val r = parse_linear_gradient("radial-gradient(red, blue)")

        step("a different gradient shape is unsupported, not a linear one")
        expect(r.is_ok()).to_equal(false)

    it "fails on an unknown colour in a stop instead of substituting black":
        # @req: REQ-UNIT-LIB-027
        step("Verify: fails on an unknown colour in a stop instead of substituting black")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse a gradient with a bogus colour name")
        val r = parse_linear_gradient("linear-gradient(red, notacolour)")

        step("same anti-silent-black contract as box-shadow")
        expect(r.is_ok()).to_equal(false)
