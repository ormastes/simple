"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/blink/style_shorthand_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/lib/blink/style/shorthand.spl 80%
"""
# Blink Shorthand Expansion Specification

**Category:** Browser / Blink
**Status:** Active

## Overview

Expanding a shorthand into longhands is only correct if the CASCADE ORDER
survives it. Two rules carry the whole risk, and both fail silently when
broken because the result is a plausible style rather than an error:

- a shorthand resets EVERY longhand it covers, including ones the author never
  mentioned, so a longhand written BEFORE it is gone;
- expansion happens IN PLACE, so a longhand written AFTER it still wins.

This specification pins both directions, plus the rule that a shorthand which
cannot be decomposed is dropped and reported rather than half-applied.
"""

use std.spipe.*
use std.blink.css_parser.tokenizer.{tokenize_css}
use std.blink.css_parser.parser.{parse_css, parse_declarations, CssDeclaration}
use std.blink.style.shorthand.{
    expand_declarations, expand_rules, expand_rule, shorthand_longhands
}

# Expand an inline declaration list and render it as `prop=value` in order, so
# the ORDER of the result — not merely its contents — is under test.
fn _expanded(source: text) -> text:
    val result = expand_declarations(parse_declarations(source))
    var out: text = ""
    var i = 0
    while i < result.declarations.len():
        val d = result.declarations[i as i32]
        if out.len() > 0:
            out = out + ";"
        out = out + d.property + "=" + d.value
        i = i + 1
    out

# The value the cascade would end up with for `property`: the LAST write wins,
# which is what makes ordering observable.
fn _final(source: text, property: text) -> text:
    val result = expand_declarations(parse_declarations(source))
    var found: text = "unset"
    var i = 0
    while i < result.declarations.len():
        val d = result.declarations[i as i32]
        if d.property == property:
            found = d.value
        i = i + 1
    found

fn _dropped(source: text) -> i64:
    expand_declarations(parse_declarations(source)).dropped.len()

# @manual_section: Ordering and precedence
describe "shorthand ordering":
    """
    As a browser engine, I want a shorthand and a longhand to override each
    other purely by the order the author wrote them, so that the style on
    screen is the one the last declaration asked for.
    """

    # @req REQ-BLINK-SHORTHAND-ORDER
    it "lets a longhand written after a shorthand win":
        # @req: REQ-UNIT-LIB-001
            # @req: REQ-BLINK-SHORTHAND-ORDER
        step("Verify: lets a longhand written after a shorthand win")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("expand `margin: 5px; margin-left: 20px` and read margin-left")
        expect(_final("margin: 5px; margin-left: 20px", "margin-left")).to_equal("20px")

    # @req REQ-BLINK-SHORTHAND-ORDER
    it "lets a shorthand written after a longhand clobber it":
        # @req: REQ-UNIT-LIB-002
        step("Verify: lets a shorthand written after a longhand clobber it")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("expand `margin-left: 20px; margin: 5px` and read margin-left")
        expect(_final("margin-left: 20px; margin: 5px", "margin-left")).to_equal("5px")

    # @req REQ-BLINK-SHORTHAND-RESET
    it "resets a longhand the shorthand never mentions":
        # @req: REQ-UNIT-LIB-003
        step("Verify: resets a longhand the shorthand never mentions")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("write margin-left, then `margin: 0 auto`, which mentions no single side")
        expect(_final("margin-left: 20px; margin: 0 auto", "margin-left")).to_equal("auto")

    # @req REQ-BLINK-SHORTHAND-RESET
    it "resets a border colour the later shorthand omits":
        # @req: REQ-UNIT-LIB-004
        step("Verify: resets a border colour the later shorthand omits")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("write border-top-color, then `border-top: 1px solid`")
        expect(_final("border-top-color: red; border-top: 1px solid", "border-top-color")).to_equal(
            "currentcolor")

    # @req REQ-BLINK-SHORTHAND-ORDER
    it "expands in place rather than hoisting the longhands":
        # @req: REQ-UNIT-LIB-005
        step("Verify: expands in place rather than hoisting the longhands")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("expand `color: red; margin: 1px; display: block` and read the sequence")
        expect(_expanded("color: red; margin: 1px; display: block")).to_equal(
            "color=red;margin-top=1px;margin-right=1px;margin-bottom=1px;margin-left=1px;display=block")

    # @req REQ-BLINK-SHORTHAND-ORDER
    it "leaves a non-shorthand declaration untouched":
        # @req: REQ-UNIT-LIB-006
        step("Verify: leaves a non-shorthand declaration untouched")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("expand a block with no shorthands at all")
        expect(_expanded("color: red; display: block")).to_equal("color=red;display=block")

# @manual_section: Importance
describe "important shorthands":
    """
    As a browser engine, I want `!important` on a shorthand carried to every
    longhand it produces, because that is what the author declared and losing
    it would let a later normal declaration override an important one.
    """

    # @req REQ-BLINK-SHORTHAND-IMPORTANT
    it "marks every expanded longhand important when the shorthand was":
        # @req: REQ-UNIT-LIB-007
        step("Verify: marks every expanded longhand important when the shorthand was")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("expand `margin: 1px !important` and count important longhands")
        val result = expand_declarations(parse_declarations("margin: 1px !important"))
        var important_count = 0
        var i = 0
        while i < result.declarations.len():
            if result.declarations[i as i32].important:
                important_count = important_count + 1
            i = i + 1
        expect(important_count).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

    # @req REQ-BLINK-SHORTHAND-IMPORTANT
    it "does not mark longhands important when the shorthand was not":
        # @req: REQ-UNIT-LIB-008
        step("Verify: does not mark longhands important when the shorthand was not")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("expand a plain `margin: 1px`")
        val result = expand_declarations(parse_declarations("margin: 1px"))
        expect(result.declarations[0 as i32].important).to_equal(false)

# @manual_section: Invalid shorthands
describe "undecomposable shorthands":
    """
    As a browser engine, I want a shorthand whose value I cannot decompose
    dropped and reported, because a partial expansion would reset some
    longhands off a value I did not understand and leave the rest stale — a
    wrong style rather than a missing one.
    """

    # @req REQ-BLINK-SHORTHAND-INVALID
    it "drops an undecomposable shorthand rather than expanding it partially":
        # @req: REQ-UNIT-LIB-009
        step("Verify: drops an undecomposable shorthand rather than expanding it partially")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("expand `border: 1px wiggly red` alongside a valid declaration")
        expect(_expanded("color: red; border: 1px wiggly red")).to_equal("color=red")

    # @req REQ-BLINK-SHORTHAND-INVALID
    it "reports the dropped shorthand instead of losing it silently":
        # @req: REQ-UNIT-LIB-010
        step("Verify: reports the dropped shorthand instead of losing it silently")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("count the dropped shorthands of the same block")
        expect(_dropped("color: red; border: 1px wiggly red")).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    # @req REQ-BLINK-SHORTHAND-INVALID
    it "leaves an earlier longhand alive when the later shorthand is invalid":
        # @req: REQ-UNIT-LIB-011
        step("Verify: leaves an earlier longhand alive when the later shorthand is invalid")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("write border-top-color, then an invalid `border-top`")
        expect(_final("border-top-color: red; border-top: 1px wiggly", "border-top-color")).to_equal(
            "red")

    # @req REQ-BLINK-SHORTHAND-INVALID
    it "reports nothing dropped for a block it fully understands":
        # @req: REQ-UNIT-LIB-012
        step("Verify: reports nothing dropped for a block it fully understands")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("expand a block of valid shorthands")
        expect(_dropped("margin: 1px; padding: 2px; flex: 1")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

# @manual_section: Whole rules
describe "expanding parsed rules":
    """
    As a browser engine, I want a whole parsed stylesheet expanded to longhands
    before the cascade sees it, so that the cascade never has to know which
    properties are shorthands.
    """

    # @req REQ-BLINK-SHORTHAND-RULES
    it "expands the declarations of every rule in a sheet":
        # @req: REQ-UNIT-LIB-013
        step("Verify: expands the declarations of every rule in a sheet")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("parse and expand two rules, each carrying one shorthand")
        val sheet = parse_css(tokenize_css("p { margin: 1px; } div { flex: none; }"))
        val expanded = expand_rules(sheet.rules)
        expect(expanded[0 as i32].declarations.len()).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
        expect(expanded[1 as i32].declarations.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    # @req REQ-BLINK-SHORTHAND-RULES
    it "keeps the selector when expanding a rule":
        # @req: REQ-UNIT-LIB-014
        step("Verify: keeps the selector when expanding a rule")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("expand a single rule and read its selector back")
        val sheet = parse_css(tokenize_css("p.lead { padding: 2px; }"))
        expect(expand_rule(sheet.rules[0 as i32]).selector).to_equal("p.lead")

    # @req REQ-BLINK-SHORTHAND-RESET
    it "names the full reset set of a shorthand without a value":
        # @req: REQ-UNIT-LIB-015
        step("Verify: names the full reset set of a shorthand without a value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("ask for the longhands `margin` writes")
        expect(shorthand_longhands("margin").len()).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
