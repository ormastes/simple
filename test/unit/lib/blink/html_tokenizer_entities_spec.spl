## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/blink/html_tokenizer_entities_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/lib/blink/html_parser/tokenizer.spl 60%
# @req REQ-BLINKENT-001
"""
# Blink HTML Tokenizer — Character References

**Category:** Browser / Blink
**Status:** Implemented

## Purpose and Audience

A page author writes `AT&amp;T` in a paragraph and `href="?a=1&amp;b=2"` in a
link, and expects the rendered page to read `AT&T` and the link to point at
`?a=1&b=2`. Until now blink's tokenizer passed every reference through raw, so
readers saw the literal text `&amp;` on screen and links carried a doubled
escape. This spec covers the decoding blink now performs.

## Scope and Preconditions

WHATWG recognises character references in exactly two places, and so does
blink: text data (the coalesced `Character` tokens) and attribute values.
Comment and doctype data are NOT decoded, also per spec.

The decoding itself is not blink's own — it delegates to
`std.common.html.character_references`, so blink cannot drift away from the
other lanes that decode HTML. That module's spec covers the table and the
numeric forms exhaustively; this one covers the WIRING: that the tokenizer
calls it, in the right places, and only those places.

## Primary Workflow

A reference the shared decoder understands reaches the DOM as its character. A
reference it does not understand reaches the DOM as the literal source text —
`&bogus;` stays `&bogus;`. The tokenizer never substitutes a stand-in
character, because a wrong glyph reads as content and no pixel test can see it.

## Key Concepts

| Concept | Description |
|---------|-------------|
| Character token | A coalesced run of text between tags; its `data` is decoded. |
| Attribute value | Decoded at the point the attribute is recorded. |
| Comment data | Left raw — a comment is not parsed content. |

## Related Specifications

- [HTML Character References](../common/html/character_references_spec.md)
- [Blink HTML tokenizer](html_tokenizer_spec.md)
"""

use std.spipe.*
use std.blink.html_parser.tokenizer.{tokenize_html}
use std.blink.html_parser.token.{HtmlTokenKind, HtmlToken}

# Join the data of every Character token, so a test states the visible text of a
# document rather than indexing a token stream whose shape is not the subject.
fn _text_of(html: text) -> text:
    var out = ""
    val tokens = tokenize_html(html)
    var i = 0
    while i < tokens.len():
        val t = tokens.get(i)
        if t.kind == HtmlTokenKind.Character:
            out = out + t.data
        i = i + 1
    out

# The value of the named attribute on the first start tag that carries it, or
# "absent" when no tag does.
fn _attr_of(html: text, name: text) -> text:
    val tokens = tokenize_html(html)
    var i = 0
    while i < tokens.len():
        val t = tokens.get(i)
        if t.kind == HtmlTokenKind.StartTag:
            var a = 0
            while a < t.attributes.len():
                val at = t.attributes.get(a)
                if at.name == name:
                    return at.value
                a = a + 1
        i = i + 1
    "absent"

# The data of the first Comment token, or "absent".
fn _comment_of(html: text) -> text:
    val tokens = tokenize_html(html)
    var i = 0
    while i < tokens.len():
        val t = tokens.get(i)
        if t.kind == HtmlTokenKind.Comment:
            return t.data
        i = i + 1
    "absent"

describe "reading text that contains character references":
    it "shows the character an author wrote a named reference for":
        # @req: REQ-UNIT-LIB-001
            # @req: REQ-UNIT-LIB-002
            # @req: REQ-UNIT-LIB-003
        step("Verify: shows the character an author wrote a named reference for")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("tokenize a paragraph containing `&amp;`")
        expect(_text_of("<p>AT&amp;T</p>")).to_equal("AT&T")
        step("tokenize escaped angle brackets, which must NOT reopen as tags")
        expect(_text_of("<p>&lt;p&gt;</p>")).to_equal("<p>")

    it "shows the character an author wrote a numeric reference for":
        # @req: REQ-UNIT-LIB-004
        step("Verify: shows the character an author wrote a numeric reference for")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("tokenize decimal and hexadecimal references in text")
        expect(_text_of("<p>caf&#233;</p>")).to_equal("café")
        expect(_text_of("<p>a&#x2014;b</p>")).to_equal("a—b")

    it "decodes across a run split by tags, one run at a time":
        # @req: REQ-UNIT-LIB-005
        step("Verify: decodes across a run split by tags, one run at a time")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("tokenize two sibling elements that each contain a reference")
        expect(_text_of("<b>&lt;</b><i>&gt;</i>")).to_equal("<>")

    it "leaves a reference it cannot decode exactly as the author wrote it":
        # @req: REQ-UNIT-LIB-006
        step("Verify: leaves a reference it cannot decode exactly as the author wrote it")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("tokenize text containing an unknown name and a bad number")
        expect(_text_of("<p>&bogus; &#0;</p>")).to_equal("&bogus; &#0;")
        step("tokenize an unterminated reference")
        expect(_text_of("<p>a &amp b</p>")).to_equal("a &amp b")

    it "leaves ordinary prose containing a bare ampersand readable":
        # @req: REQ-UNIT-LIB-007
        step("Verify: leaves ordinary prose containing a bare ampersand readable")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("tokenize a sentence with an ampersand used as a word")
        expect(_text_of("<p>Tom & Jerry</p>")).to_equal("Tom & Jerry")

describe "reading an attribute value that contains character references":
    it "gives a link the URL the author meant, not the escaped spelling":
        # @req: REQ-UNIT-LIB-008
        step("Verify: gives a link the URL the author meant, not the escaped spelling")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("tokenize an anchor whose query string escapes its separator")
        expect(_attr_of("<a href=\"?a=1&amp;b=2\">x</a>", "href")).to_equal("?a=1&b=2")

    it "decodes a single-quoted attribute value the same way":
        # @req: REQ-UNIT-LIB-009
        step("Verify: decodes a single-quoted attribute value the same way")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("tokenize the same attribute written with single quotes")
        expect(_attr_of("<a href='?a=1&amp;b=2'>x</a>", "href")).to_equal("?a=1&b=2")

    it "decodes an unquoted attribute value the same way":
        # @req: REQ-UNIT-LIB-010
        step("Verify: decodes an unquoted attribute value the same way")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("tokenize an unquoted value carrying a reference")
        expect(_attr_of("<a href=x&amp;y>t</a>", "href")).to_equal("x&y")

    it "decodes a numeric reference in an attribute value":
        # @req: REQ-UNIT-LIB-011
        step("Verify: decodes a numeric reference in an attribute value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("tokenize a title attribute using a decimal reference")
        expect(_attr_of("<img alt=\"caf&#233;\">", "alt")).to_equal("café")

    it "leaves an undecodable attribute reference as written":
        # @req: REQ-UNIT-LIB-012
        step("Verify: leaves an undecodable attribute reference as written")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("tokenize an attribute holding an unknown name")
        expect(_attr_of("<a title=\"&bogus;\">x</a>", "title")).to_equal("&bogus;")

describe "reading places where references are not recognised":
    it "leaves comment data raw, because a comment is not parsed content":
        # @req: REQ-UNIT-LIB-013
        step("Verify: leaves comment data raw, because a comment is not parsed content")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("tokenize a comment containing what looks like a reference")
        expect(_comment_of("<!-- a &amp; b -->")).to_equal(" a &amp; b ")

    it "does not decode a reference a second time":
        # @req: REQ-UNIT-LIB-014
        step("Verify: does not decode a reference a second time")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        step("tokenize text whose author escaped the ampersand of a reference")
        expect(_text_of("<p>&amp;amp;</p>")).to_equal("&amp;")
