# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, expect, assert_true, assert_false, assert_equal, assert_not_equal, assert_contains, assert_nil}

describe "standalone assert functions":
    # @manual scenario evidence
    it "assert_true passes for true":
        # @req REQ-SSPEC-UNIT
        step("assert_true passes for true")
        assert_true(true)

    it "assert_false passes for false":
        # @req REQ-SSPEC-UNIT
        step("assert_false passes for false")
        assert_false(false)

    it "assert_equal passes for equal integers":
        # @req REQ-SSPEC-UNIT
        step("assert_equal passes for equal integers")
        assert_equal(42, 42)

    it "assert_equal passes for equal strings":
        # @req REQ-SSPEC-UNIT
        step("assert_equal passes for equal strings")
        assert_equal("hello", "hello")

    it "assert_not_equal passes for different values":
        # @req REQ-SSPEC-UNIT
        step("assert_not_equal passes for different values")
        assert_not_equal(1, 2)

    it "assert_contains passes when substring is present":
        # @req REQ-SSPEC-UNIT
        step("assert_contains passes when substring is present")
        assert_contains("hello world", "world")

    it "assert_nil passes for nil":
        # @req REQ-SSPEC-UNIT
        step("assert_nil passes for nil")
        assert_nil(nil)
