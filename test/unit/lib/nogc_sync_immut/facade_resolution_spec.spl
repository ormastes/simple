# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Regression coverage for the no-GC sync immutable compatibility family.

use std.spec.step

use std.nogc_sync_immut.{Atom, VersionedSnapshot, pfold, nogc_async_immut_version}

describe "nogc_sync_immut facade resolution":
    # @manual scenario evidence
    it "resolves persistent helpers through the no-GC async immutable backing family":
        # @req REQ-SSPEC-UNIT
        step("resolves persistent helpers through the no-GC async immutable backing family")
        expect(pfold([1, 2, 3], 0, \acc, x: acc + x)).to_equal(6)
        expect(nogc_async_immut_version()).to_equal("0.1.0")

    it "preserves root coordination type behavior through the no-GC sync facade":
        # @req REQ-SSPEC-UNIT
        step("preserves root coordination type behavior through the no-GC sync facade")
        var atom = Atom.new(21)
        atom.reset(22)
        expect(atom.deref()).to_equal(22)

        var snapshot = VersionedSnapshot.new("base")
        snapshot.update("head")
        expect(snapshot.current()).to_equal("head")
