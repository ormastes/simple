"""
## Purpose and audience
Purpose: Verify nogc_sync_immut PersistentSet native backend.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-SET-FACADE-NATIVE-001 — stable requirement identity for this spec.

use std.nogc_sync_immut.{PersistentSet}

use std.spec.step

describe "nogc_sync_immut PersistentSet native backend":
    it "adds and finds a root-facade entry":
        step("Verify: adds and finds a root-facade entry")
        # @req: REQ-LIB-SET-FACADE-NATIVE-001
        val base = PersistentSet.empty()
        val first = base.add("a")

        expect(base.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(first.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(first.contains("a")).to_equal(true)

    it "stores two root-facade entries":
        step("Verify: stores two root-facade entries")
        val first = PersistentSet.empty().add("a").add("b")

        expect(first.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(first.contains("a")).to_equal(true)
        expect(first.contains("b")).to_equal(true)

    it "stores branch-shaped root-facade entries":
        step("Verify: stores branch-shaped root-facade entries")
        val base: PersistentSet = PersistentSet.empty()
        val first: PersistentSet = base.add("app").add("apple")

        expect(first.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(first.contains("app")).to_equal(true)
        expect(first.contains("apple")).to_equal(true)

    it "deduplicates and removes branch-shaped root-facade entries":
        step("Verify: deduplicates and removes branch-shaped root-facade entries")
        val base: PersistentSet = PersistentSet.empty()
        val first: PersistentSet = base.add("app").add("apple").add("app")
        val removed: PersistentSet = first.remove("apple")

        expect(first.contains("app")).to_equal(true)
        expect(first.contains("apple")).to_equal(true)
        expect(first.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(removed.contains("app")).to_equal(true)
        expect(removed.contains("apple")).to_equal(false)
        expect(removed.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
