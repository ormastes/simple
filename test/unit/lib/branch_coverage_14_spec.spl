# @req: REQ-LIB-LIB-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/lib/branch_coverage_14_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/branch_coverage_14.md
# doc-path: doc/03_plan/sys_test/branch_coverage_14.md
# doc-path: doc/04_architecture/branch_coverage_14.md
# doc-path: doc/05_design/branch_coverage_14.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "else arm runs when all guards fail":
        step("Verify: else arm runs when all guards fail")
        # @req: REQ-LIB-LIB-001
        var r = 0
        if 1 > 2:
            r = 1
        elif 2 > 3:
            r = 2
        else:
            r = 9
        expect(r).to_equal(9)  # oracle: terminal else

    it "elif first arm wins when its guard holds":
        step("Verify: elif first arm wins when its guard holds")
        # @req: REQ-LIB-LIB-001
        var r = 0
        if 7 > 10:
            r = 1
        elif 7 > 5:
            r = 2
        else:
            r = 3
        expect(r).to_equal(2)  # oracle: first true elif

    it "match falls through to default arm":
        step("Verify: match falls through to default arm")
        # @req: REQ-LIB-LIB-001
        val k = 99
        var r = 0
        match k:
            1: r = 10
            2: r = 20
            _: r = -1
        expect(r).to_equal(-1)  # oracle: default arm

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "continue skips the rest of the body":
        step("Verify: continue skips the rest of the body")
        # @req: REQ-LIB-LIB-001
        var c = 0
        for i in 0..5:
            if i == 2: continue
            c = c + 1
        expect(c).to_equal(4)  # oracle: one skipped iteration

    it "boolean value selects via match on true/false":
        step("Verify: boolean value selects via match on true/false")
        # @req: REQ-LIB-LIB-001
        val flag = false
        var r = 0
        match flag:
            true: r = 1
            false: r = 2
        expect(r).to_equal(2)  # oracle: false pattern arm

    it "match nil takes the nil arm":
        step("Verify: match nil takes the nil arm")
        # @req: REQ-LIB-LIB-001
        var r = 9
        match nil:
            Some(x): r = x
            nil: r = -1
        expect(r).to_equal(-1)  # oracle: nil arm
