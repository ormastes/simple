"""
# DELETE ... WHERE col [NOT] IN (SELECT ...) specification

Regression: UiAccessStore retention runs
`DELETE FROM ui_access_events WHERE id NOT IN (SELECT id FROM ui_access_events
ORDER BY sequence DESC, id DESC LIMIT 64)`, which the rt_sqlite emulation
rejected as an unsupported DELETE WHERE clause.
"""

use std.spec.step
use std.database.sql.types.{DbValue, DbRow, DbError}
use std.database.sql.connection.{Database}

fn _seeded() -> Database:
    var db = Database.memory().unwrap()
    db.exec_sql("CREATE TABLE ev (id INTEGER PRIMARY KEY AUTOINCREMENT, seq INTEGER)").unwrap()
    # ids 1..5 with seq 5,100,40,20,30 (mixed widths: literal INSERTs store text,
    # so ORDER BY must compare numerically, not lexicographically)
    db.exec_sql("INSERT INTO ev (seq) VALUES (5)").unwrap()
    db.exec_sql("INSERT INTO ev (seq) VALUES (100)").unwrap()
    db.exec_sql("INSERT INTO ev (seq) VALUES (40)").unwrap()
    db.exec_sql("INSERT INTO ev (seq) VALUES (20)").unwrap()
    db.exec_sql("INSERT INTO ev (seq) VALUES (30)").unwrap()
    db

fn _ids(db: Database) -> [i64]:
    var d = db
    val rows = d.query("SELECT id FROM ev", []).unwrap()
    var out: [i64] = []
    for r in rows:
        # The interpreter emulation currently surfaces INTEGER columns as text.
        val as_int = r.get_int("id")
        if as_int.?:
            out.push(as_int.unwrap())
        else:
            out.push(r.get_text("id").unwrap().to_int())
    out

fn _mx_ids(db: Database) -> [i64]:
    var d = db
    var out: [i64] = []
    for r in d.query("SELECT id FROM mx", []).unwrap():
        val as_int = r.get_int("id")
        if as_int.?:
            out.push(as_int.unwrap())
        else:
            out.push(r.get_text("id").unwrap().to_int())
    out

fn _bg_ids(db: Database) -> [i64]:
    var d = db
    var out: [i64] = []
    for r in d.query("SELECT id FROM bg", []).unwrap():
        val as_int = r.get_int("id")
        if as_int.?:
            out.push(as_int.unwrap())
        else:
            out.push(r.get_text("id").unwrap().to_int())
    out

describe "DELETE with IN subquery":
    it "NOT IN keeps the top-N rows by ORDER BY ... DESC LIMIT":
        step("retention")
        var db = _seeded()
        val r = db.exec_sql("DELETE FROM ev WHERE id NOT IN (SELECT id FROM ev ORDER BY seq DESC, id DESC LIMIT 2)")
        expect(r.is_ok()).to_equal(true)
        # top-2 by seq are ids 2 (100) and 3 (40)
        expect(_ids(db)).to_equal([2, 3])
        db.close().unwrap()

    it "NOT IN with LIMIT larger than the table deletes nothing":
        step("retention no-op")
        var db = _seeded()
        db.exec_sql("DELETE FROM ev WHERE id NOT IN (SELECT id FROM ev ORDER BY seq DESC LIMIT 64)").unwrap()
        expect(_ids(db).len()).to_equal(5)
        db.close().unwrap()

    it "IN deletes only the subquery rows (ASC order)":
        step("in")
        var db = _seeded()
        db.exec_sql("DELETE FROM ev WHERE id IN (SELECT id FROM ev ORDER BY seq ASC LIMIT 2)").unwrap()
        # lowest seq are ids 1 (5) and 4 (20)
        expect(_ids(db)).to_equal([2, 3, 5])
        db.close().unwrap()

    it "fails closed on an unsupported subquery instead of widening the delete":
        step("where in subquery")
        var db = _seeded()
        val r = db.exec_sql("DELETE FROM ev WHERE id NOT IN (SELECT id FROM ev WHERE seq > 10)")
        expect(r.is_err()).to_equal(true)
        expect(_ids(db).len()).to_equal(5)
        db.close().unwrap()

    it "errors on an unknown subquery table":
        step("bad table")
        var db = _seeded()
        expect(db.exec_sql("DELETE FROM ev WHERE id IN (SELECT id FROM nope)").is_err()).to_equal(true)
        expect(_ids(db).len()).to_equal(5)
        db.close().unwrap()

    it "orders mixed numeric and non-numeric text totally: 9, 10, 10a":
        step("mixed text")
        var db = Database.memory().unwrap()
        db.exec_sql("CREATE TABLE mx (id INTEGER PRIMARY KEY AUTOINCREMENT, v TEXT)").unwrap()
        db.exec_sql("INSERT INTO mx (v) VALUES ('10a')").unwrap()
        db.exec_sql("INSERT INTO mx (v) VALUES ('9')").unwrap()
        db.exec_sql("INSERT INTO mx (v) VALUES ('10')").unwrap()
        # ascending: 9 (id 2), 10 (id 3), 10a (id 1); keep the first two
        db.exec_sql("DELETE FROM mx WHERE id NOT IN (SELECT id FROM mx ORDER BY v ASC LIMIT 2)").unwrap()
        expect(_mx_ids(db)).to_equal([2, 3])
        # descending: 10 (id 3) is the largest of the remaining {9, 10}
        db.exec_sql("DELETE FROM mx WHERE id NOT IN (SELECT id FROM mx ORDER BY v DESC LIMIT 1)").unwrap()
        expect(_mx_ids(db)).to_equal([3])
        db.close().unwrap()

    it "distinguishes integers above 2^53 in ORDER BY and IN":
        step("big ints")
        var db = Database.memory().unwrap()
        db.exec_sql("CREATE TABLE bg (id INTEGER PRIMARY KEY AUTOINCREMENT, n INTEGER)").unwrap()
        # bound parameters keep these as integers (a literal INSERT would store text)
        db.exec("INSERT INTO bg (n) VALUES (?)", [DbValue.Integer(value: 9007199254740993)]).unwrap()
        db.exec("INSERT INTO bg (n) VALUES (?)", [DbValue.Integer(value: 9007199254740992)]).unwrap()
        # ASC LIMIT 1 keeps the smaller value, ...992 (id 2); a lossy f64 compare ties and keeps id 1
        db.exec_sql("DELETE FROM bg WHERE id NOT IN (SELECT id FROM bg ORDER BY n ASC LIMIT 1)").unwrap()
        expect(_bg_ids(db)).to_equal([2])
        db.close().unwrap()

    it "IN matches only the exact integer above 2^53":
        step("big ints in")
        var db = Database.memory().unwrap()
        db.exec_sql("CREATE TABLE bg (id INTEGER PRIMARY KEY AUTOINCREMENT, n INTEGER)").unwrap()
        db.exec("INSERT INTO bg (n) VALUES (?)", [DbValue.Integer(value: 9007199254740993)]).unwrap()
        db.exec("INSERT INTO bg (n) VALUES (?)", [DbValue.Integer(value: 9007199254740992)]).unwrap()
        db.exec_sql("DELETE FROM bg WHERE n IN (SELECT n FROM bg ORDER BY n ASC LIMIT 1)").unwrap()
        expect(_bg_ids(db)).to_equal([1])
        db.close().unwrap()
