"""
## Purpose and audience
Purpose: Prove that TimingInterceptor.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-DATABASE-001 — stable requirement identity for this spec.

# SQL Interceptor Specification
#
# Tests TimingInterceptor, LoggingInterceptor, and RetryInterceptor.

use std.database.sql.interceptor.{TimingInterceptor, LoggingInterceptor, RetryInterceptor}

use std.spec.step

describe "TimingInterceptor":
    context "after_execute":
        it "records slow queries above threshold":
            step("Verify: records slow queries above threshold")
            # @req: REQ-LIB-DATABASE-001
            var ti = TimingInterceptor.new(100)
            ti.after_execute("SELECT * FROM users", 150, true)
            val slow = ti.get_slow_queries()
            expect(slow.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(slow[0]).to_contain("SELECT * FROM users")
            expect(slow[0]).to_contain("150ms")

        it "does not record queries below threshold":
            step("Verify: does not record queries below threshold")
            var ti = TimingInterceptor.new(100)
            ti.after_execute("SELECT 1", 50, true)
            val slow = ti.get_slow_queries()
            expect(slow.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "records query at exact threshold":
            step("Verify: records query at exact threshold")
            var ti = TimingInterceptor.new(100)
            ti.after_execute("SELECT 1", 100, true)
            val slow = ti.get_slow_queries()
            expect(slow.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "records multiple slow queries":
            step("Verify: records multiple slow queries")
            var ti = TimingInterceptor.new(50)
            ti.after_execute("query1", 60, true)
            ti.after_execute("query2", 70, true)
            ti.after_execute("fast_query", 10, true)
            val slow = ti.get_slow_queries()
            expect(slow.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    context "after_query":
        it "records slow SELECT queries":
            step("Verify: records slow SELECT queries")
            var ti = TimingInterceptor.new(100)
            ti.after_query("SELECT * FROM users", 200, 50)
            val slow = ti.get_slow_queries()
            expect(slow.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(slow[0]).to_contain("QUERY")
            expect(slow[0]).to_contain("200ms")
            expect(slow[0]).to_contain("50 rows")

        it "does not record fast SELECT queries":
            step("Verify: does not record fast SELECT queries")
            var ti = TimingInterceptor.new(100)
            ti.after_query("SELECT 1", 10, 1)
            val slow = ti.get_slow_queries()
            expect(slow.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "before_execute":
        it "is a no-op":
            step("Verify: is a no-op")
            val ti = TimingInterceptor.new(100)
            ti.before_execute("SELECT 1")
            # No exception, no state change
            expect(ti.get_slow_queries().len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "before_query":
        it "is a no-op":
            step("Verify: is a no-op")
            val ti = TimingInterceptor.new(100)
            ti.before_query("SELECT 1")
            expect(ti.get_slow_queries().len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "LoggingInterceptor":
    context "before_execute":
        it "logs before execute":
            step("Verify: logs before execute")
            var li = LoggingInterceptor.new()
            li.before_execute("INSERT INTO users VALUES (1, 'Alice')")
            val log = li.get_log()
            expect(log.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(log[0]).to_start_with("[EXEC]")
            expect(log[0]).to_contain("INSERT INTO")

    context "after_execute":
        it "logs after execute with duration and success":
            step("Verify: logs after execute with duration and success")
            var li = LoggingInterceptor.new()
            li.after_execute("UPDATE users SET name='Bob'", 5, true)
            val log = li.get_log()
            expect(log.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(log[0]).to_start_with("[EXEC DONE]")
            expect(log[0]).to_contain("5ms")
            expect(log[0]).to_contain("success=true")

        it "logs failed execution":
            step("Verify: logs failed execution")
            var li = LoggingInterceptor.new()
            li.after_execute("BAD SQL", 2, false)
            val log = li.get_log()
            expect(log[0]).to_contain("success=false")

    context "before_query":
        it "logs before query":
            step("Verify: logs before query")
            var li = LoggingInterceptor.new()
            li.before_query("SELECT * FROM users")
            val log = li.get_log()
            expect(log.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(log[0]).to_start_with("[QUERY]")

    context "after_query":
        it "logs after query with duration and row count":
            step("Verify: logs after query with duration and row count")
            var li = LoggingInterceptor.new()
            li.after_query("SELECT * FROM users", 10, 25)
            val log = li.get_log()
            expect(log.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(log[0]).to_start_with("[QUERY DONE]")
            expect(log[0]).to_contain("10ms")
            expect(log[0]).to_contain("25 rows")

    context "full lifecycle":
        it "logs before and after execute in sequence":
            step("Verify: logs before and after execute in sequence")
            var li = LoggingInterceptor.new()
            li.before_execute("INSERT INTO t VALUES (1)")
            li.after_execute("INSERT INTO t VALUES (1)", 3, true)
            val log = li.get_log()
            expect(log.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(log[0]).to_start_with("[EXEC]")
            expect(log[1]).to_start_with("[EXEC DONE]")

        it "logs before and after query in sequence":
            step("Verify: logs before and after query in sequence")
            var li = LoggingInterceptor.new()
            li.before_query("SELECT 1")
            li.after_query("SELECT 1", 1, 1)
            val log = li.get_log()
            expect(log.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(log[0]).to_start_with("[QUERY]")
            expect(log[1]).to_start_with("[QUERY DONE]")

    context "clear_log":
        it "clears all log entries":
            step("Verify: clears all log entries")
            var li = LoggingInterceptor.new()
            li.before_execute("sql1")
            li.before_execute("sql2")
            expect(li.get_log().len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            li.clear_log()
            expect(li.get_log().len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "RetryInterceptor":
    context "retry counting":
        it "starts with zero retry count":
            step("Verify: starts with zero retry count")
            val ri = RetryInterceptor.new(3, 100)
            expect(ri.get_retry_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "increments retry count on failure":
            step("Verify: increments retry count on failure")
            var ri = RetryInterceptor.new(3, 100)
            ri.after_execute("SELECT 1", 10, false)
            expect(ri.get_retry_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "does not increment on success":
            step("Verify: does not increment on success")
            var ri = RetryInterceptor.new(3, 100)
            ri.after_execute("SELECT 1", 10, true)
            expect(ri.get_retry_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "counts multiple failures":
            step("Verify: counts multiple failures")
            var ri = RetryInterceptor.new(5, 100)
            ri.after_execute("sql1", 1, false)
            ri.after_execute("sql2", 1, false)
            ri.after_execute("sql3", 1, false)
            expect(ri.get_retry_count()).to_equal(3)  # oracle: 3 — named expected value from the requirement

        it "counts mixed success and failure":
            step("Verify: counts mixed success and failure")
            var ri = RetryInterceptor.new(5, 100)
            ri.after_execute("ok", 1, true)
            ri.after_execute("fail", 1, false)
            ri.after_execute("ok2", 1, true)
            ri.after_execute("fail2", 1, false)
            expect(ri.get_retry_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    context "configuration":
        it "stores max_retries":
            step("Verify: stores max_retries")
            val ri = RetryInterceptor.new(3, 200)
            expect(ri.max_retries).to_equal(3)  # oracle: 3 — named expected value from the requirement

        it "stores delay_ms":
            step("Verify: stores delay_ms")
            val ri = RetryInterceptor.new(3, 200)
            expect(ri.delay_ms).to_equal(200)  # oracle: 200 — named expected value from the requirement
