# # Editor Recent Files Tests
#
# **Feature ID:** #EDITOR-RECENT-001
# **Category:** Editor | Core
# **Status:** Implemented
#
# @cover src/lib/editor/core/recent.spl 80%

"""
## Purpose and audience
Purpose: Verify recent files creation.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-RECENT-FILES-001 — stable requirement identity for this spec.

use std.editor.core.recent.*

use std.spec.step

describe "recent files creation":
    it "creates empty recent list":
        step("Verify: creates empty recent list")
        # @req: REQ-LIB-RECENT-FILES-001
        val recent = recent_files_new("/tmp/test_recent.txt")
        expect(recent.entries.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(recent.max_entries).to_equal(50)  # oracle: authoritative expected value documented by this spec's contract

describe "recent files add":
    it "adds a file path":
        step("Verify: adds a file path")
        var recent = recent_files_new("/tmp/test_recent.txt")
        recent = recent_files_add(recent, "/home/user/a.spl")
        expect(recent.entries.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

    it "adds multiple file paths in order":
        step("Verify: adds multiple file paths in order")
        var recent = recent_files_new("/tmp/test_recent.txt")
        recent = recent_files_add(recent, "/home/user/a.spl")
        recent = recent_files_add(recent, "/home/user/b.spl")
        recent = recent_files_add(recent, "/home/user/c.spl")
        expect(recent.entries.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(recent.entries[2]).to_equal("/home/user/c.spl")

    it "deduplicates by moving to end":
        step("Verify: deduplicates by moving to end")
        var recent = recent_files_new("/tmp/test_recent.txt")
        recent = recent_files_add(recent, "/a.spl")
        recent = recent_files_add(recent, "/b.spl")
        recent = recent_files_add(recent, "/a.spl")
        expect(recent.entries.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(recent.entries[0]).to_equal("/b.spl")
        expect(recent.entries[1]).to_equal("/a.spl")

    it "trims oldest when max_entries exceeded":
        step("Verify: trims oldest when max_entries exceeded")
        var recent = RecentFiles(entries: [], max_entries: 3, storage_path: "/tmp/t.txt")
        recent = recent_files_add(recent, "/1.spl")
        recent = recent_files_add(recent, "/2.spl")
        recent = recent_files_add(recent, "/3.spl")
        recent = recent_files_add(recent, "/4.spl")
        expect(recent.entries.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(recent.entries[0]).to_equal("/2.spl")
        expect(recent.entries[2]).to_equal("/4.spl")

    it "handles adding same file repeatedly":
        step("Verify: handles adding same file repeatedly")
        var recent = recent_files_new("/tmp/test_recent.txt")
        recent = recent_files_add(recent, "/same.spl")
        recent = recent_files_add(recent, "/same.spl")
        recent = recent_files_add(recent, "/same.spl")
        expect(recent.entries.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(recent.entries[0]).to_equal("/same.spl")

describe "recent files edge cases":
    it "handles empty path":
        step("Verify: handles empty path")
        var recent = recent_files_new("/tmp/test_recent.txt")
        recent = recent_files_add(recent, "")
        expect(recent.entries.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

    it "max_entries of 1 keeps only latest":
        step("Verify: max_entries of 1 keeps only latest")
        var recent = RecentFiles(entries: [], max_entries: 1, storage_path: "/tmp/t.txt")
        recent = recent_files_add(recent, "/old.spl")
        recent = recent_files_add(recent, "/new.spl")
        expect(recent.entries.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(recent.entries[0]).to_equal("/new.spl")
