"""
# i18n Resource Bundle Specification

## Purpose and audience

Executable specification for the internationalization resource-bundle
system (`std.i18n.bundle`, `std.i18n.global`), for library engineers
changing SDN message parsing, bundle lookup/fallback, locale handling, or
placeholder substitution in Simple web applications packaged as SWA
archives.

## Operator workflow

Run this spec with the repo test runner and confirm zero failed
scenarios. Each scenario names the requirement it traces to, starts with
an imperative step, and asserts on values returned by the real bundle
and parser APIs.

## Compatibility and limitations

Resource bundles provide localized strings keyed in SDN `key: value`
message files (`messages.sdn` default, `messages.<locale>.sdn` per
locale). Coverage here is the pure layer: `parse_i18n_file`, the
`ResourceBundle` lookup/fallback/substitution surface, the pure locale
helpers, and the uninitialized `t()`/`t_fmt()` fallback. Environment
detection (`detect_locale`) and directory scanning do file/env IO and
are exercised only through the pure helpers they delegate to.

## Verification guidance and troubleshooting

Re-run after any change to `src/lib/nogc_sync_mut/i18n/`. A parse
failure means SDN first-colon or comment semantics regressed; a lookup
failure means locale-over-fallback precedence or the `{missing:key}`
marker regressed; a substitution failure means `{name}` placeholder
replacement regressed.
"""
# Lifecycle: doc/01_research/lib/text_i18n/simple_utf8_internationalized_text_architecture_2026-08-25.md ;
# doc/03_plan/agent_tasks/utf8_internationalized_text_architecture.md ;
# doc/04_architecture/lib/text_i18n/utf8_internationalized_text_architecture.md ;
# doc/05_design/infra/i18n_complete_specification.md
# @req: REQ-SSPEC-LIB
# @feature i18n_resource_bundles
# @cover src/lib/nogc_sync_mut/i18n/bundle.spl 80%
# @cover src/lib/nogc_sync_mut/i18n/global.spl 80%
# @tag:system

use std.spec.{describe, it, expect, step}
use std.i18n.bundle.{
    ResourceBundle, parse_i18n_file,
    _language_from_locale, _normalize_locale, _extract_lang_code
}
use std.i18n.global.{t, i18n_is_initialized}

fn placeholder(name: text) -> text:
    "{" + name + "}"

fn localized_bundle() -> ResourceBundle:
    ResourceBundle(
        locale: "ko",
        messages: {"greeting": "안녕하세요", "shared": "지역"},
        fallback_messages: {
            "greeting": "Hello", "farewell": "Goodbye", "shared": "default"})

# ============================================================================
# Test Group 1: SDN i18n Parsing
# ============================================================================

describe "SDN i18n Parsing":
    # @manual_section: sdn message parsing
    """
    ## AC-1: SDN Message File Format

    Validates parsing of SDN-format i18n message files through the real
    parse_i18n_file product entry point. Messages are stored as key: value
    pairs, one per line. Blank lines and # comments are ignored. Nested
    keys use dot-separated paths.
    """

    # @scenario SC-001
    it "parses simple key: value pairs":
        # @req REQ-SSPEC-LIB
        step("Parse a one-line SDN message body")
        # @capture(statistics): parsed key/value pair retained
        val parsed = parse_i18n_file("greeting: Hello, World!")
        expect(parsed["greeting"]).to_equal("Hello, World!")

    # @scenario SC-002
    it "keeps nested keys with dot separators verbatim":
        # @req REQ-SSPEC-LIB
        step("Parse a message whose key carries a dot path")
        # @capture(statistics): dot-path key retained with its value
        val parsed = parse_i18n_file("errors.not_found: Resource not found")
        expect(parsed["errors.not_found"]).to_equal("Resource not found")

    # @scenario SC-003
    it "skips blank lines between messages":
        # @req REQ-SSPEC-LIB
        step("Parse a body containing an interior blank line")
        # @capture(statistics): surviving key count retained
        val parsed = parse_i18n_file("greeting: Hello\n\nfarewell: Goodbye")
        expect(parsed.keys().len()).to_equal(2)  # oracle: only the two real messages survive

    # @scenario SC-004
    it "skips comment lines starting with #":
        # @req REQ-SSPEC-LIB
        step("Parse a body wrapped in comment lines")
        # @capture(statistics): surviving key count retained
        val parsed = parse_i18n_file("# This is a comment\ngreeting: Hello\n# Another comment")
        expect(parsed.keys().len()).to_equal(1)  # oracle: only the uncommented message survives

    # @scenario SC-005
    it "trims leading and trailing whitespace from values":
        # @req REQ-SSPEC-LIB
        step("Parse a value padded with spaces on both sides")
        # @capture(statistics): trimmed value retained
        val parsed = parse_i18n_file("greeting:   Hello, World!  ")
        expect(parsed["greeting"]).to_equal("Hello, World!")

    # @scenario SC-006
    it "keeps colons in the value portion":
        # @req REQ-SSPEC-LIB
        step("Parse a value that itself contains colons")
        # @capture(statistics): first-colon split retained
        val parsed = parse_i18n_file("time_format: HH:MM:SS")
        expect(parsed["time_format"]).to_equal("HH:MM:SS")

    # @scenario SC-007
    it "parses keys with underscores and dots":
        # @req REQ-SSPEC-LIB
        step("Parse message keys mixing underscores and dot paths")
        # @capture(statistics): all three key shapes retained
        val parsed = parse_i18n_file(
            "error_message: bad\nnav.home_link: home\napp.settings.theme_color: dark")
        expect(parsed["error_message"]).to_equal("bad")
        expect(parsed["nav.home_link"]).to_equal("home")
        expect(parsed["app.settings.theme_color"]).to_equal("dark")


# ============================================================================
# Test Group 2: Locale Detection
# ============================================================================

describe "Locale Detection":
    # @manual_section: locale detection chain
    """
    ## AC-2: Locale Detection Chain

    Validates the pure helpers behind the detection priority: the
    SIMPLE_LOCALE value is normalized verbatim, LANG values are reduced to
    their language code, and the platform fallback is "en". The env-reading
    entry point delegates to these helpers.
    """

    # @scenario SC-008
    it "uses the SIMPLE_LOCALE value verbatim when set":
        # @req REQ-SSPEC-LIB
        step("Normalize an explicit locale selection")
        # @capture(statistics): normalized locale retained
        expect(_normalize_locale("ko")).to_equal("ko")

    # @scenario SC-009
    it "falls back to the LANG language code":
        # @req REQ-SSPEC-LIB
        step("Extract the language code from a LANG value")
        # @capture(statistics): extracted language retained
        expect(_extract_lang_code("ja_JP.UTF-8")).to_equal("ja")

    # @scenario SC-010
    it "extracts language code from LANG with country suffix":
        # @req REQ-SSPEC-LIB
        step("Reduce a locale with country and encoding suffixes")
        # @capture(statistics): extracted language retained
        expect(_extract_lang_code("ko_KR.UTF-8")).to_equal("ko")

    # @scenario SC-011
    it "defaults to en for unset and POSIX-style locales":
        # @req REQ-SSPEC-LIB
        step("Resolve empty, C, and POSIX environment values")
        # @capture(statistics): fallback locale per env shape retained
        expect(_extract_lang_code("")).to_equal("en")
        expect(_extract_lang_code("C")).to_equal("en")
        expect(_extract_lang_code("POSIX")).to_equal("en")

    # @scenario SC-012
    it "handles LANG without country code":
        # @req REQ-SSPEC-LIB
        step("Extract the language from a bare language value")
        # @capture(statistics): extracted language retained
        expect(_extract_lang_code("fr")).to_equal("fr")

    # @scenario SC-013
    it "trims surrounding whitespace when normalizing a locale":
        # @req REQ-SSPEC-LIB
        step("Normalize a padded locale value")
        # @capture(statistics): normalized locale retained
        expect(_normalize_locale("  ko-KR  ")).to_equal("ko-KR")


# ============================================================================
# Test Group 3: ResourceBundle Loading
# ============================================================================

describe "ResourceBundle Loading":
    # @manual_section: bundle loading and fallback
    """
    ## AC-3: Bundle File Loading and Fallback

    Validates ResourceBundle lookup precedence through the real bundle
    type: the default (fallback) table serves keys the locale table lacks,
    the locale table overrides shared keys, and a missing key yields the
    explicit {missing:key} marker.
    """

    # @scenario SC-014
    it "serves default messages as the base table":
        # @req REQ-SSPEC-LIB
        step("Look up a key that exists only in the default table")
        # @capture(statistics): fallback lookup result retained
        val bundle = localized_bundle()
        expect(bundle.get("farewell")).to_equal("Goodbye")

    # @scenario SC-015
    it "loads the locale-specific table over the default":
        # @req REQ-SSPEC-LIB
        step("Look up a key present in both tables")
        # @capture(statistics): locale-over-fallback verdict retained
        val bundle = localized_bundle()
        expect(bundle.get("shared")).to_equal("지역")

    # @scenario SC-016
    it "falls back to the default for a missing locale key":
        # @req REQ-SSPEC-LIB
        step("Look up a default-table key the locale table lacks")
        # @capture(statistics): fallback value retained
        val bundle = localized_bundle()
        expect(bundle.get("farewell")).to_equal("Goodbye")

    # @scenario SC-017
    it "overrides the default value with the locale-specific value":
        # @req REQ-SSPEC-LIB
        step("Look up the greeting key in the localized bundle")
        # @capture(statistics): localized greeting retained
        val bundle = localized_bundle()
        expect(bundle.get("greeting")).to_equal("안녕하세요")

    # @scenario SC-018
    it "returns the explicit missing marker for a completely unknown key":
        # @req REQ-SSPEC-LIB
        step("Look up a key absent from both tables")
        # @capture(statistics): missing-key marker retained
        val bundle = localized_bundle()
        expect(bundle.get("nonexistent.key.path")).to_equal(
            "{missing:nonexistent.key.path}")

    # @scenario SC-019
    it "reports the configured locale for the loaded bundle":
        # @req REQ-SSPEC-LIB
        step("Read the locale a loaded bundle was configured with")
        # @capture(statistics): configured locale retained
        val bundle = localized_bundle()
        expect(bundle.current_locale()).to_equal("ko")

    # @scenario SC-020
    it "steps through the locale fallback chain by language":
        # @req REQ-SSPEC-LIB
        step("Reduce zh-TW to its language chain step")
        # @capture(statistics): chain step and default fallback retained
        expect(_language_from_locale("zh-TW")).to_equal("zh")
        expect(_extract_lang_code("")).to_equal("en")


# ============================================================================
# Test Group 4: Parameter Substitution
# ============================================================================

describe "Parameter Substitution":
    # @manual_section: placeholder substitution
    """
    ## AC-4: Placeholder Replacement

    Validates that {name} placeholders in translated strings are replaced
    with corresponding values from a parameters dictionary, and that
    unknown placeholders survive unchanged.
    """

    # @scenario SC-021
    it "replaces a single {name} placeholder":
        # @req REQ-SSPEC-LIB
        step("Format a message with one placeholder")
        # @capture(statistics): substituted message retained
        val bundle = ResourceBundle(
            locale: "en",
            messages: {"welcome": "Hello, " + placeholder("name") + "!"},
            fallback_messages: {})
        expect(bundle.get_fmt("welcome", {"name": "Alice"})).to_equal(
            "Hello, Alice!")

    # @scenario SC-022
    it "replaces multiple different placeholders":
        # @req REQ-SSPEC-LIB
        step("Format a message with greeting, name, and count placeholders")
        # @capture(statistics): fully substituted message retained
        val bundle = ResourceBundle(
            locale: "en",
            messages: {"status": "Hello, " + placeholder("name") +
                "! You have " + placeholder("count") + " messages."},
            fallback_messages: {})
        expect(bundle.get_fmt("status", {"name": "Bob", "count": "5"})).to_equal(
            "Hello, Bob! You have 5 messages.")

    # @scenario SC-023
    it "leaves unknown placeholders as-is gracefully":
        # @req REQ-SSPEC-LIB
        step("Format a message whose role placeholder has no parameter")
        # @capture(statistics): surviving placeholder retained
        val bundle = ResourceBundle(
            locale: "en",
            messages: {"role_line": "Hello, " + placeholder("name") +
                "! Your role is " + placeholder("role") + "."},
            fallback_messages: {})
        expect(bundle.get_fmt("role_line", {"name": "Alice"})).to_equal(
            "Hello, Alice! Your role is " + placeholder("role") + ".")

    # @scenario SC-024
    it "returns a template with no placeholders unchanged":
        # @req REQ-SSPEC-LIB
        step("Format a message that carries no placeholder")
        # @capture(statistics): unchanged template retained
        val bundle = ResourceBundle(
            locale: "en",
            messages: {"plain": "Welcome to the application."},
            fallback_messages: {})
        expect(bundle.get_fmt("plain", {})).to_equal(
            "Welcome to the application.")

    # @scenario SC-025
    it "replaces the same placeholder appearing multiple times":
        # @req REQ-SSPEC-LIB
        step("Format a message repeating one placeholder")
        # @capture(statistics): repeated substitution retained
        val bundle = ResourceBundle(
            locale: "en",
            messages: {"session": placeholder("name") +
                " logged in. Welcome back, " + placeholder("name") + "!"},
            fallback_messages: {})
        expect(bundle.get_fmt("session", {"name": "Alice"})).to_equal(
            "Alice logged in. Welcome back, Alice!")

    # @scenario SC-026
    it "handles an empty parameter value":
        # @req REQ-SSPEC-LIB
        step("Format a message whose parameter is the empty string")
        # @capture(statistics): emptied substitution retained
        val bundle = ResourceBundle(
            locale: "en",
            messages: {"user_line": "User: " + placeholder("name")},
            fallback_messages: {})
        expect(bundle.get_fmt("user_line", {"name": ""})).to_equal("User: ")


# ============================================================================
# Test Group 5: Global Accessor
# ============================================================================

describe "Global Accessor":
    # @manual_section: global translation accessors
    """
    ## AC-5: t() and t_fmt() Global Functions

    Validates the global translation accessors. t("key") and
    t_fmt("key", params) delegate to the loaded bundle's lookup and
    substitution; before any bundle is loaded they return the key itself.
    The bundle-backed scenarios exercise the same mechanism the global
    accessors delegate to.
    """

    # @scenario SC-027
    it "resolves a known key through the loaded bundle lookup":
        # @req REQ-SSPEC-LIB
        step("Look up the greeting key the accessors delegate to")
        # @capture(statistics): translated greeting retained
        val bundle = localized_bundle()
        expect(bundle.get("greeting")).to_equal("안녕하세요")

    # @scenario SC-028
    it "yields the missing marker for an unknown key lookup":
        # @req REQ-SSPEC-LIB
        step("Look up a key the accessors cannot resolve")
        # @capture(statistics): missing-key marker retained
        val bundle = localized_bundle()
        expect(bundle.get("does.not.exist")).to_equal("{missing:does.not.exist}")

    # @scenario SC-029
    it "substitutes params through the fmt accessor mechanism":
        # @req REQ-SSPEC-LIB
        step("Format the welcome key with a name parameter")
        # @capture(statistics): substituted welcome retained
        val bundle = ResourceBundle(
            locale: "en",
            messages: {"welcome_message": "Welcome, " + placeholder("name") + "!"},
            fallback_messages: {})
        expect(bundle.get_fmt("welcome_message", {"name": "Charlie"})).to_equal(
            "Welcome, Charlie!")

    # @scenario SC-030
    it "returns the template as-is for empty params":
        # @req REQ-SSPEC-LIB
        step("Format a message with an empty parameter table")
        # @capture(statistics): unchanged template retained
        val bundle = ResourceBundle(
            locale: "en",
            messages: {"plain": "No placeholders here."},
            fallback_messages: {})
        expect(bundle.get_fmt("plain", {})).to_equal("No placeholders here.")

    # @scenario SC-031
    it "respects the configured locale when translating":
        # @req REQ-SSPEC-LIB
        step("Compare the same key across en and ko bundles")
        # @capture(bit_table): greeting per locale retained
        val en = ResourceBundle(
            locale: "en", messages: {"greeting": "Hello"}, fallback_messages: {})
        val ko = ResourceBundle(
            locale: "ko", messages: {"greeting": "안녕하세요"}, fallback_messages: {})
        expect(en.get("greeting")).to_equal("Hello")
        expect(ko.get("greeting")).to_equal("안녕하세요")

    # @scenario SC-032
    it "substitutes numeric parameter values as text":
        # @req REQ-SSPEC-LIB
        step("Format a message whose count parameter is numeric text")
        # @capture(statistics): numeric substitution retained
        val bundle = ResourceBundle(
            locale: "en",
            messages: {"cart": "You have " + placeholder("count") +
                " items in your cart."},
            fallback_messages: {})
        expect(bundle.get_fmt("cart", {"count": "3"})).to_equal(
            "You have 3 items in your cart.")

    # @scenario SC-033
    it "returns the key itself when no bundle is loaded":
        # @req REQ-SSPEC-LIB
        step("Call the global accessor before any bundle is loaded")
        # @capture(statistics): uninitialized fallback verdict retained
        expect(i18n_is_initialized()).to_equal(false)  # oracle: this spec never initializes the global bundle
        expect(t("some.key")).to_equal("some.key")  # oracle: documented uninitialized fallback returns the key
