"""
# TLS ECH Parse Check Specification

**Feature IDs:** #AC-11
**Category:** Stdlib / TLS / ECH
**Difficulty:** 3/5
**Status:** Active
"""
# @req: REQ-LIB-TLS_ECH-001

use std.spec
use std.tls.ech.{
    EchConfigVersion, HpkeSymmetricCipherSuite, EchConfigContents,
    EchConfig, EchConfigList,
    EchClientHelloType, EchClientHelloPayload,
    EchServerConfig, ech_server_config_disabled,
    detect_ech_extension,
    EchDecision, ech_server_decide, ech_build_retry_config_extension,
    ech_grease_extension_data
}

describe "ECH types and disabled config (AC-11)":
    it "disabled config has empty config list":
        # @req: REQ-LIB-TLS_ECH-001
        step("Verify: disabled config has empty config list")
        val cfg = ech_server_config_disabled()
        expect(cfg.enabled).to_equal(false)
        expect(cfg.config_list.configs.len()).to_equal(0)  # oracle: expected value pinned by spec

    it "detect returns nil for empty extensions":
        # @req: REQ-LIB-TLS_ECH-001
        step("Verify: detect returns nil for empty extensions")
        val result = detect_ech_extension([])
        expect(result == nil).to_equal(true)

    it "detect returns nil for short extensions":
        # @req: REQ-LIB-TLS_ECH-001
        step("Verify: detect returns nil for short extensions")
        val result = detect_ech_extension([0, 0])
        expect(result == nil).to_equal(true)

    it "server decides NotPresent when no ECH":
        # @req: REQ-LIB-TLS_ECH-001
        step("Verify: server decides NotPresent when no ECH")
        val decision = ech_server_decide(nil, ech_server_config_disabled())
        match decision:
            case EchDecision.NotPresent:
                expect(true).to_equal(true)
            case EchDecision.ProviderUnavailable:
                expect(false).to_equal(true)
            case EchDecision.AcceptInner:
                expect(false).to_equal(true)
            case EchDecision.RejectWithRetryConfig:
                expect(false).to_equal(true)

    it "retry config extension is empty when disabled":
        # @req: REQ-LIB-TLS_ECH-001
        step("Verify: retry config extension is empty when disabled")
        val cfg = ech_server_config_disabled()
        val ext = ech_build_retry_config_extension(cfg)
        expect(ext.len()).to_equal(0)  # oracle: expected value pinned by spec

    it "grease extension needs at least 10 random bytes":
        # @req: REQ-LIB-TLS_ECH-001
        step("Verify: grease extension needs at least 10 random bytes")
        val short = ech_grease_extension_data([1, 2, 3])
        expect(short.len()).to_equal(0)  # oracle: expected value pinned by spec
