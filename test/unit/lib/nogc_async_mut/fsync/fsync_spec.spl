"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/nogc_async_mut/fsync/fsync_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/lib/nogc_async_mut/fsync/fsync.spl

use std.spec
use std.nogc_async_mut.fsync.fsync.{
    fsync_mutex_lock,
    fsync_mutex_unlock
}

describe "fsync mutex/condvar":
    it "lock and unlock on address 0 complete without error":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-LIB-001
        step("Verify: lock and unlock on address 0 complete without error")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val addr: u32 = 0
        fsync_mutex_lock(addr)
        fsync_mutex_unlock(addr)
        expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "lock and unlock on non-zero address complete without error":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-LIB-002
        step("Verify: lock and unlock on non-zero address complete without error")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val addr: u32 = 42
        fsync_mutex_lock(addr)
        fsync_mutex_unlock(addr)
        expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "multiple lock/unlock pairs on different addresses do not interfere":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-LIB-003
        step("Verify: multiple lock/unlock pairs on different addresses do not interfere")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a: u32 = 1
        val b: u32 = 2
        fsync_mutex_lock(a)
        fsync_mutex_lock(b)
        fsync_mutex_unlock(b)
        fsync_mutex_unlock(a)
        expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
