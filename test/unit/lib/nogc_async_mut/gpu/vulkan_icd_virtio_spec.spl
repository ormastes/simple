# @cover src/lib/nogc_async_mut/gpu/vulkan_icd_virtio.spl

use std.spec
use std.nogc_async_mut.gpu.vulkan_icd_virtio.{
    venus_icd_connect,
    venus_icd_disconnect,
    venus_icd_is_connected,
    venus_icd_create_instance,
    venus_icd_create_device,
    venus_icd_allocate_memory,
    venus_icd_create_buffer,
    venus_icd_destroy_instance,
    venus_icd_protocol_version
}

# 2026-08-11: updated for the fail-closed fix (see
# doc/08_tracking/bug/vulkan_icd_virtio_and_gpu_probe_report_no_real_device_enumeration_2026-08-11.md).
# There is no real virtio-gpu venus transport wired up, so every operation
# that reaches `_venus_transport_send` now honestly reports "unavailable"
# instead of fabricating success. `venus_icd_connect` only records local
# intent (device path bookkeeping) — it never proves a device exists — so
# "connected" state must NOT flip these to is_ok: true.
describe "Virtio Venus ICD transport":
    it "connect with valid device path succeeds":
        val ok = venus_icd_connect("/dev/vgpu0", 256)
        expect(ok).to_equal(true)
        venus_icd_disconnect()

    it "connect with empty path fails":
        val ok = venus_icd_connect("", 256)
        expect(ok).to_equal(false)

    it "is_connected reflects state":
        venus_icd_connect("/dev/vgpu0", 256)
        expect(venus_icd_is_connected()).to_equal(true)
        venus_icd_disconnect()
        expect(venus_icd_is_connected()).to_equal(false)

    it "create_instance reports unavailable, not a fabricated success":
        venus_icd_connect("/dev/vgpu0", 256)
        val result = venus_icd_create_instance()
        expect(result.is_ok).to_equal(false)
        expect(result.handle).to_equal(0)
        venus_icd_disconnect()

    it "create_device with valid instance still reports unavailable":
        venus_icd_connect("/dev/vgpu0", 256)
        val inst = venus_icd_create_instance()
        val dev = venus_icd_create_device(inst.handle)
        expect(dev.is_ok).to_equal(false)
        expect(dev.handle).to_equal(0)
        venus_icd_disconnect()

    it "create_device with invalid instance fails":
        venus_icd_connect("/dev/vgpu0", 256)
        val result = venus_icd_create_device(0)
        expect(result.is_ok).to_equal(false)
        expect(result.error).to_equal("invalid-instance")
        venus_icd_disconnect()

    it "allocate_memory reports unavailable, issues no handle":
        venus_icd_connect("/dev/vgpu0", 256)
        val inst = venus_icd_create_instance()
        val dev = venus_icd_create_device(inst.handle)
        val mem = venus_icd_allocate_memory(dev.handle, 4096)
        expect(mem.is_ok).to_equal(false)
        expect(mem.handle).to_equal(0)
        venus_icd_disconnect()

    it "create_buffer reports unavailable, issues no handle":
        venus_icd_connect("/dev/vgpu0", 256)
        val inst = venus_icd_create_instance()
        val dev = venus_icd_create_device(inst.handle)
        val buf = venus_icd_create_buffer(dev.handle, 2048)
        expect(buf.is_ok).to_equal(false)
        expect(buf.handle).to_equal(0)
        venus_icd_disconnect()

    it "destroy_instance accepted":
        venus_icd_connect("/dev/vgpu0", 256)
        val inst = venus_icd_create_instance()
        venus_icd_destroy_instance(inst.handle)
        expect(1).to_equal(1)
        venus_icd_disconnect()

    it "disconnect resets state":
        venus_icd_connect("/dev/vgpu0", 256)
        venus_icd_disconnect()
        expect(venus_icd_is_connected()).to_equal(false)

    it "protocol_version returns expected value":
        venus_icd_connect("/dev/vgpu0", 256)
        expect(venus_icd_protocol_version()).to_equal(1)
        venus_icd_disconnect()

    it "operations fail when not connected":
        venus_icd_disconnect()
        val result = venus_icd_create_instance()
        expect(result.is_ok).to_equal(false)
        expect(result.error).to_equal("not-connected")
