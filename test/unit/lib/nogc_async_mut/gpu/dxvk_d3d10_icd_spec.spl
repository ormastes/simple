"""
## Purpose and audience
Behavioral specification for dxvk d3d10 icd.
Audience: compiler/runtime developers and spec maintainers who need
to verify this component's observable behavior and pinned values.
"""
# @req: REQ-LIB-GPU_DXVK_D3D10_ICD-001
use std.nogc_async_mut.gpu.dxvk_d3d10.{
    dxvk_d3d10_create_device,
    dxvk_d3d10_draw,
    dxvk_d3d10_create_render_target,
    dxvk_d3d10_present,
    dxvk_d3d10_destroy_device
}

use std.spec.step
describe "DXVK D3D10 ICD dispatch chain":
    it "creates a D3D10 device routed through vulkan_icd_sffi":
        # @req: REQ-LIB-GPU_DXVK_D3D10_ICD-001
        step("Verify: creates a D3D10 device routed through vulkan_icd_sffi")
        val dev = dxvk_d3d10_create_device()
        expect(dev.is_ok).to_equal(true)
        expect(dev.device_handle).to_be_greater_than(0)
        expect(dev.icd_instance).to_be_greater_than(0)
        expect(dev.icd_device).to_be_greater_than(0)
        expect(dev.icd_dispatch).to_be_greater_than(0)

    it "draws vertices through ICD queue submit":
        # @req: REQ-LIB-GPU_DXVK_D3D10_ICD-001
        step("Verify: draws vertices through ICD queue submit")
        val dev = dxvk_d3d10_create_device()
        expect(dxvk_d3d10_draw(dev.device_handle, 3)).to_equal(true)  # oracle: expected value pinned by spec

    it "rejects draw on invalid device":
        # @req: REQ-LIB-GPU_DXVK_D3D10_ICD-001
        step("Verify: rejects draw on invalid device")
        expect(dxvk_d3d10_draw(0, 3)).to_equal(false)  # oracle: expected value pinned by spec
        expect(dxvk_d3d10_draw(-1, 3)).to_equal(false)  # oracle: expected value pinned by spec

    it "rejects draw with zero vertices":
        # @req: REQ-LIB-GPU_DXVK_D3D10_ICD-001
        step("Verify: rejects draw with zero vertices")
        val dev = dxvk_d3d10_create_device()
        expect(dxvk_d3d10_draw(dev.device_handle, 0)).to_equal(false)  # oracle: expected value pinned by spec

    it "creates a render target on a valid device":
        # @req: REQ-LIB-GPU_DXVK_D3D10_ICD-001
        step("Verify: creates a render target on a valid device")
        val dev = dxvk_d3d10_create_device()
        val rt = dxvk_d3d10_create_render_target(dev.device_handle, 1920, 1080)
        expect(rt).to_be_greater_than(0)

    it "rejects render target on invalid device":
        # @req: REQ-LIB-GPU_DXVK_D3D10_ICD-001
        step("Verify: rejects render target on invalid device")
        expect(dxvk_d3d10_create_render_target(0, 1920, 1080)).to_equal(0)  # oracle: expected value pinned by spec

    it "rejects render target with invalid dimensions":
        # @req: REQ-LIB-GPU_DXVK_D3D10_ICD-001
        step("Verify: rejects render target with invalid dimensions")
        val dev = dxvk_d3d10_create_device()
        expect(dxvk_d3d10_create_render_target(dev.device_handle, 0, 1080)).to_equal(0)  # oracle: expected value pinned by spec
        expect(dxvk_d3d10_create_render_target(dev.device_handle, 1920, 0)).to_equal(0)  # oracle: expected value pinned by spec

    it "presents through ICD queue present":
        # @req: REQ-LIB-GPU_DXVK_D3D10_ICD-001
        step("Verify: presents through ICD queue present")
        val dev = dxvk_d3d10_create_device()
        expect(dxvk_d3d10_present(dev.device_handle)).to_equal(true)  # oracle: expected value pinned by spec

    it "rejects present on invalid device":
        # @req: REQ-LIB-GPU_DXVK_D3D10_ICD-001
        step("Verify: rejects present on invalid device")
        expect(dxvk_d3d10_present(0)).to_equal(false)  # oracle: expected value pinned by spec

    it "destroys a device and invalidates further use":
        # @req: REQ-LIB-GPU_DXVK_D3D10_ICD-001
        step("Verify: destroys a device and invalidates further use")
        val dev = dxvk_d3d10_create_device()
        expect(dxvk_d3d10_destroy_device(dev.device_handle)).to_equal(true)  # oracle: expected value pinned by spec
        expect(dxvk_d3d10_draw(dev.device_handle, 3)).to_equal(false)  # oracle: expected value pinned by spec
        expect(dxvk_d3d10_present(dev.device_handle)).to_equal(false)  # oracle: expected value pinned by spec
        expect(dxvk_d3d10_destroy_device(dev.device_handle)).to_equal(false)  # oracle: expected value pinned by spec

    it "rejects destroy on invalid device":
        # @req: REQ-LIB-GPU_DXVK_D3D10_ICD-001
        step("Verify: rejects destroy on invalid device")
        expect(dxvk_d3d10_destroy_device(0)).to_equal(false)  # oracle: expected value pinned by spec
        expect(dxvk_d3d10_destroy_device(-1)).to_equal(false)  # oracle: expected value pinned by spec
