"""
## Purpose and audience
Purpose: Prove that NDArray view bounds hardening.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-NOGC-ASYNC-MUT-001 — stable requirement identity for this spec.

use std.nogc_async_mut.ndarray.{array, Index, Shape}

use std.spec.step

describe "NDArray view bounds hardening":
    it "returns empty row for out-of-range row index":
        step("Verify: returns empty row for out-of-range row index")
        # @req: REQ-LIB-NOGC-ASYNC-MUT-001
        val matrix = array([1.0, 2.0, 3.0, 4.0]).reshape(Shape.new([Index.new(2), Index.new(2)]))
        val row = matrix.row(Index.new(9))
        expect(row.len().value).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(row.to_f64_values().len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "returns empty column for out-of-range column index":
        step("Verify: returns empty column for out-of-range column index")
        val matrix = array([1.0, 2.0, 3.0, 4.0]).reshape(Shape.new([Index.new(2), Index.new(2)]))
        val col = matrix.column(Index.new(9))
        expect(col.len().value).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(col.to_f64_values().len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
