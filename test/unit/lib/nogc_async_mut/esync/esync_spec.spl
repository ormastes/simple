"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/nogc_async_mut/esync/esync_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/lib/nogc_async_mut/esync/esync.spl

use std.spec
use std.nogc_async_mut.esync.esync.{
    esync_create,
    esync_signal,
    esync_wait,
    esync_reset,
    esync_close
}

describe "esync NT event/semaphore":
    it "create returns a positive handle":
        # @req: REQ-UNIT-LIB-001
        step("Verify: create returns a positive handle")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val h = esync_create()
        expect(h).to_be_greater_than(0)

    it "two creates return distinct handles":
        # @req: REQ-UNIT-LIB-002
        step("Verify: two creates return distinct handles")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val h1 = esync_create()
        val h2 = esync_create()
        expect(h1).to_not_equal(h2)

    it "wait on unsignaled handle with timeout=0 returns timeout":
        # @req: REQ-UNIT-LIB-003
        step("Verify: wait on unsignaled handle with timeout=0 returns timeout")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val h = esync_create()
        val result = esync_wait(h, 0)
        expect(result).to_equal("timeout")

    it "signal then wait returns signaled":
        # @req: REQ-UNIT-LIB-004
        step("Verify: signal then wait returns signaled")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val h = esync_create()
        esync_signal(h)
        val result = esync_wait(h, 0)
        expect(result).to_equal("signaled")

    it "wait consumes signal (auto-reset)":
        # @req: REQ-UNIT-LIB-005
        step("Verify: wait consumes signal (auto-reset)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val h = esync_create()
        esync_signal(h)
        esync_wait(h, 0)
        val result2 = esync_wait(h, 0)
        expect(result2).to_equal("timeout")

    it "reset clears a signaled handle":
        # @req: REQ-UNIT-LIB-006
        step("Verify: reset clears a signaled handle")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val h = esync_create()
        esync_signal(h)
        esync_reset(h)
        val result = esync_wait(h, 0)
        expect(result).to_equal("timeout")

    it "wait on invalid handle returns invalid":
        # @req: REQ-UNIT-LIB-007
        step("Verify: wait on invalid handle returns invalid")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = esync_wait(-1, 0)
        expect(result).to_equal("invalid")

    it "signal on invalid handle does not panic":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-LIB-008
        step("Verify: signal on invalid handle does not panic")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        esync_signal(-99)
        expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "close removes handle from active set":
        # @req: REQ-UNIT-LIB-009
        step("Verify: close removes handle from active set")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val h = esync_create()
        esync_close(h)
        val result = esync_wait(h, 0)
        expect(result).to_equal("invalid")
