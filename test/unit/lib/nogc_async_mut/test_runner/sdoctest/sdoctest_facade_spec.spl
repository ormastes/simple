"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/nogc_async_mut/test_runner/sdoctest/sdoctest_facade_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec
use std.nogc_async_mut.test_runner.sdoctest.{BlockStatus, SdoctestBlock, SdoctestModifier, SdoctestRunResult}
use std.nogc_async_mut.test_runner.sdoctest.{block_status_to_str, default_sdoctest_config, glob_match_path, parse_config_from_text, parse_fence_line}

describe "nogc_async_mut sdoctest facade":

    it "re-exports config parsing":
        # @req: REQ-UNIT-LIB-001
        step("Verify: re-exports config parsing")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val config = default_sdoctest_config()
        expect(config.default_timeout).to_equal(5000)  # oracle: expected value 5000 is the behavior asserted by this regression spec
        expect(config.environments[0].name).to_equal("default")

        val parsed = parse_config_from_text("sdoctest:\n  version: 1\n  default_timeout: 9000\nenvironments:\n  ci:\n    timeout: 12000\n")
        expect(parsed.default_timeout).to_equal(9000)  # oracle: expected value 9000 is the behavior asserted by this regression spec
        expect(parsed.environments[0].name).to_equal("ci")
        expect(parsed.environments[0].timeout).to_equal(12000)  # oracle: expected value 12000 is the behavior asserted by this regression spec

    it "re-exports extraction and result helpers":
        # @req: REQ-UNIT-LIB-002
        step("Verify: re-exports extraction and result helpers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val parsed = parse_fence_line("```spl:skip,tag=fast")
        expect(parsed.0).to_equal("spl")
        expect(parsed.1.len() as i64).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

        val block = SdoctestBlock(source_file: "README.md", line_number: 7, code: "1 + 1", language: "spl", modifiers: [SdoctestModifier.Skip])
        expect(block.has_modifier_skip()).to_equal(true)
        expect(block.has_modifier_should_fail()).to_equal(false)
        expect(block_status_to_str(BlockStatus.Passed)).to_equal("passed")

        val run = SdoctestRunResult(files: [], total: 1, passed: 1, failed: 0, skipped: 0, errors: 0, accepted: 0, duration_ms: 1)
        expect(run.is_ok()).to_equal(true)

    it "re-exports glob helpers":
        # @req: REQ-UNIT-LIB-003
        step("Verify: re-exports glob helpers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(glob_match_path("doc/guide/example.md", "doc/**/*.md")).to_equal(true)
        expect(glob_match_path("src/main.spl", "doc/**/*.md")).to_equal(false)
