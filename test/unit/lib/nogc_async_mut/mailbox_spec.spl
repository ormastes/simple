describe "Mailbox":
    extern fn rt_file_read_text(path: text) -> text
    extern fn rt_file_exists(path: text) -> bool

    it "does not reintroduce a duplicate bare `Mailbox` package export":
        # Regression for the ambiguous-export Stage-2 build failure
        # (2026-08-07): src/lib/nogc_async_mut/mailbox.spl used to define
        # a second, dead `struct Mailbox` alongside mailbox_actor.spl's
        # `class Mailbox`, and both were exported bare from the package,
        # which native_project/discovery.rs's package-export ambiguity
        # check rejects as a hard build error. mailbox.spl was deleted as
        # dead code, then deliberately RE-INTRODUCED (2026-09, commit
        # eb73528fc34 "fix(contract): src/lib mut trees") with contract
        # coverage — so the pinned invariant is no longer "file gone" but
        # "its local struct is not exported bare from the package": the
        # sole package-level mailbox owner stays `PriorityMailbox`.
        expect(rt_file_exists("src/lib/nogc_async_mut/mailbox.spl")).to_equal(true)

        val actor_source = rt_file_read_text("src/lib/nogc_async_mut/mailbox_actor.spl") ?? ""
        expect(actor_source).to_contain("class PriorityMailbox:")
        val package_source = rt_file_read_text("src/lib/nogc_async_mut/__init__.spl") ?? ""
        expect(package_source).to_contain("export PriorityMailbox")
        expect(package_source.contains("export Mailbox\n")).to_equal(false)
