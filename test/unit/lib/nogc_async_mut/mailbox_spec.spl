describe "Mailbox":
    extern fn rt_file_read_text(path: text) -> text

    it "does not reintroduce a duplicate bare `Mailbox` package export":
        # Regression for the ambiguous-export Stage-2 build failure
        # (2026-08-07): src/lib/nogc_async_mut/mailbox.spl used to define
        # a second, dead `struct Mailbox` alongside mailbox_actor.spl's
        # `class Mailbox`, and both were exported bare from the package,
        # which native_project/discovery.rs's package-export ambiguity
        # check rejects as a hard build error. mailbox.spl was deleted as
        # dead code (no real consumer, only text-scan specs). This spec
        # pins both halves of the invariant: the dead file stays gone, and
        # the sole surviving `Mailbox` is the actor-mailbox class.
        val dead_mailbox_source = rt_file_read_text("src/lib/nogc_async_mut/mailbox.spl") ?? ""
        expect(dead_mailbox_source).to_equal("")

        val actor_source = rt_file_read_text("src/lib/nogc_async_mut/mailbox_actor.spl") ?? ""
        expect(actor_source).to_contain("class Mailbox:")
