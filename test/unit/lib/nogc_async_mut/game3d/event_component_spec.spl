describe "GameEvent":
    context "simple factory":
        it "creates event with given type":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: creates event with given type")
            val ev = GameEvent.simple(GameEventType.EntityCreated)
            expect(ev.event_type.to_i32()).to_equal(GameEventType.EntityCreated.to_i32())

        it "sets entity_a to -1 by default":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: sets entity_a to -1 by default")
            val ev = GameEvent.simple(GameEventType.Custom)
            expect(ev.entity_a).to_equal(-1)  # oracle: value fixed by the spec contract

        it "sets entity_b to -1 by default":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: sets entity_b to -1 by default")
            val ev = GameEvent.simple(GameEventType.Custom)
            expect(ev.entity_b).to_equal(-1)  # oracle: value fixed by the spec contract

        it "sets param_x to 0.0 by default":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: sets param_x to 0.0 by default")
            val ev = GameEvent.simple(GameEventType.SceneLoaded)
            expect(ev.param_x).to_equal(0.0)  # oracle: value fixed by the spec contract

        it "sets param_y to 0.0 by default":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: sets param_y to 0.0 by default")
            val ev = GameEvent.simple(GameEventType.SceneLoaded)
            expect(ev.param_y).to_equal(0.0)  # oracle: value fixed by the spec contract

        it "sets param_z to 0.0 by default":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: sets param_z to 0.0 by default")
            val ev = GameEvent.simple(GameEventType.SceneLoaded)
            expect(ev.param_z).to_equal(0.0)  # oracle: value fixed by the spec contract

    context "collision factory":
        it "sets event_type to CollisionEnter":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: sets event_type to CollisionEnter")
            val ev = GameEvent.collision(1, 2, 0.0, 1.0, 0.0)
            expect(ev.event_type.to_i32()).to_equal(GameEventType.CollisionEnter.to_i32())

        it "stores entity_a":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: stores entity_a")
            val ev = GameEvent.collision(10, 20, 0.0, 0.0, 0.0)
            expect(ev.entity_a).to_equal(10)  # oracle: value fixed by the spec contract

        it "stores entity_b":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: stores entity_b")
            val ev = GameEvent.collision(10, 20, 0.0, 0.0, 0.0)
            expect(ev.entity_b).to_equal(20)  # oracle: value fixed by the spec contract

        it "stores normal x component":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: stores normal x component")
            val ev = GameEvent.collision(1, 2, 1.0, 0.0, 0.0)
            expect(ev.param_x).to_equal(1.0)  # oracle: value fixed by the spec contract

        it "stores normal y component":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: stores normal y component")
            val ev = GameEvent.collision(1, 2, 0.0, 1.0, 0.0)
            expect(ev.param_y).to_equal(1.0)  # oracle: value fixed by the spec contract

        it "stores normal z component":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: stores normal z component")
            val ev = GameEvent.collision(1, 2, 0.0, 0.0, 1.0)
            expect(ev.param_z).to_equal(1.0)  # oracle: value fixed by the spec contract

    context "trigger factory - entered":
        it "sets event_type to TriggerEnter when entered is true":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: sets event_type to TriggerEnter when entered is true")
            val ev = GameEvent.trigger(5, 6, true)
            expect(ev.event_type.to_i32()).to_equal(GameEventType.TriggerEnter.to_i32())

        it "stores entity_a for trigger enter":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: stores entity_a for trigger enter")
            val ev = GameEvent.trigger(5, 6, true)
            expect(ev.entity_a).to_equal(5)  # oracle: value fixed by the spec contract

        it "stores entity_b for trigger enter":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: stores entity_b for trigger enter")
            val ev = GameEvent.trigger(5, 6, true)
            expect(ev.entity_b).to_equal(6)  # oracle: value fixed by the spec contract

    context "trigger factory - exited":
        it "sets event_type to TriggerExit when entered is false":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: sets event_type to TriggerExit when entered is false")
            val ev = GameEvent.trigger(3, 4, false)
            expect(ev.event_type.to_i32()).to_equal(GameEventType.TriggerExit.to_i32())

        it "stores entity_a for trigger exit":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: stores entity_a for trigger exit")
            val ev = GameEvent.trigger(3, 4, false)
            expect(ev.entity_a).to_equal(3)  # oracle: value fixed by the spec contract

describe "EventQueue":
    context "creation":
        it "creates an empty queue":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: creates an empty queue")
            val q = EventQueue.create(10)
            expect(q.count()).to_equal(0)  # oracle: value fixed by the spec contract

        it "has_events returns false when empty":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: has_events returns false when empty")
            val q = EventQueue.create(10)
            expect(q.has_events()).to_equal(false)

    context "push and count":
        it "count increases after push":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: count increases after push")
            var q = EventQueue.create(10)
            val ev = GameEvent.simple(GameEventType.Custom)
            q.push(ev)
            expect(q.count()).to_equal(1)  # oracle: value fixed by the spec contract

        it "count increases with multiple pushes":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: count increases with multiple pushes")
            var q = EventQueue.create(10)
            val ev1 = GameEvent.simple(GameEventType.EntityCreated)
            val ev2 = GameEvent.simple(GameEventType.EntityDestroyed)
            q.push(ev1)
            q.push(ev2)
            expect(q.count()).to_equal(2)  # oracle: value fixed by the spec contract

        it "has_events returns true after push":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: has_events returns true after push")
            var q = EventQueue.create(10)
            val ev = GameEvent.simple(GameEventType.Custom)
            q.push(ev)
            expect(q.has_events()).to_equal(true)

    context "get":
        it "retrieves the event at index 0":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: retrieves the event at index 0")
            var q = EventQueue.create(10)
            val ev = GameEvent.simple(GameEventType.EntityCreated)
            q.push(ev)
            val got = q.get(0)
            expect(got.event_type.to_i32()).to_equal(GameEventType.EntityCreated.to_i32())

        it "retrieves events in insertion order":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: retrieves events in insertion order")
            var q = EventQueue.create(10)
            val ev1 = GameEvent.simple(GameEventType.EntityCreated)
            val ev2 = GameEvent.simple(GameEventType.EntityDestroyed)
            q.push(ev1)
            q.push(ev2)
            val first = q.get(0)
            val second = q.get(1)
            expect(first.event_type.to_i32()).to_equal(GameEventType.EntityCreated.to_i32())
            expect(second.event_type.to_i32()).to_equal(GameEventType.EntityDestroyed.to_i32())

        it "retrieves collision event fields correctly":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: retrieves collision event fields correctly")
            var q = EventQueue.create(10)
            val ev = GameEvent.collision(7, 8, 0.5, 0.5, 0.0)
            q.push(ev)
            val got = q.get(0)
            expect(got.entity_a).to_equal(7)  # oracle: value fixed by the spec contract
            expect(got.entity_b).to_equal(8)  # oracle: value fixed by the spec contract

    context "clear":
        it "removes all events":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: removes all events")
            var q = EventQueue.create(10)
            q.push(GameEvent.simple(GameEventType.Custom))
            q.push(GameEvent.simple(GameEventType.Custom))
            q.clear()
            expect(q.count()).to_equal(0)  # oracle: value fixed by the spec contract

        it "has_events returns false after clear":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: has_events returns false after clear")
            var q = EventQueue.create(10)
            q.push(GameEvent.simple(GameEventType.Custom))
            q.clear()
            expect(q.has_events()).to_equal(false)

        it "can push events again after clear":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: can push events again after clear")
            var q = EventQueue.create(10)
            q.push(GameEvent.simple(GameEventType.Custom))
            q.clear()
            q.push(GameEvent.simple(GameEventType.SceneLoaded))
            expect(q.count()).to_equal(1)  # oracle: value fixed by the spec contract

    context "overflow protection":
        it "does not exceed max_size on overflow":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: does not exceed max_size on overflow")
            var q = EventQueue.create(3)
            q.push(GameEvent.simple(GameEventType.Custom))
            q.push(GameEvent.simple(GameEventType.Custom))
            q.push(GameEvent.simple(GameEventType.Custom))
            q.push(GameEvent.simple(GameEventType.Custom))
            expect(q.count()).to_equal(3)  # oracle: value fixed by the spec contract

        it "count stays at max_size after many pushes":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: count stays at max_size after many pushes")
            var q = EventQueue.create(2)
            var i = 0
            while i < 10:
                q.push(GameEvent.simple(GameEventType.Custom))
                i = i + 1
            expect(q.count()).to_equal(2)  # oracle: value fixed by the spec contract

        it "existing events are preserved on overflow":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: existing events are preserved on overflow")
            var q = EventQueue.create(2)
            val ev1 = GameEvent.simple(GameEventType.EntityCreated)
            val ev2 = GameEvent.simple(GameEventType.EntityDestroyed)
            val ev3 = GameEvent.simple(GameEventType.SceneLoaded)
            q.push(ev1)
            q.push(ev2)
            q.push(ev3)
            val first = q.get(0)
            expect(first.event_type.to_i32()).to_equal(GameEventType.EntityCreated.to_i32())

        it "queue with max_size 1 holds exactly one event":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: queue with max_size 1 holds exactly one event")
            var q = EventQueue.create(1)
            q.push(GameEvent.simple(GameEventType.Custom))
            q.push(GameEvent.simple(GameEventType.EntityCreated))
            expect(q.count()).to_equal(1)  # oracle: value fixed by the spec contract


