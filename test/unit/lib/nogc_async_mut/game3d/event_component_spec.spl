describe "ComponentRegistry":
    context "creation":
        it "creates an empty registry":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: creates an empty registry")
            val reg = ComponentRegistry.create()
            expect(reg.count()).to_equal(0)  # oracle: value fixed by the spec contract

    context "add":
        it "count increases after add":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: count increases after add")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 100)
            expect(reg.count()).to_equal(1)  # oracle: value fixed by the spec contract

        it "adding multiple components increases count":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: adding multiple components increases count")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 100)
            reg.add(1, ComponentTag.Render, 200)
            reg.add(2, ComponentTag.Physics, 300)
            expect(reg.count()).to_equal(3)  # oracle: value fixed by the spec contract

    context "has":
        it "returns true after adding component":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: returns true after adding component")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 100)
            expect(reg.has(1, ComponentTag.Transform)).to_equal(true)

        it "returns false when component not added":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: returns false when component not added")
            val reg = ComponentRegistry.create()
            expect(reg.has(1, ComponentTag.Transform)).to_equal(false)

        it "returns false for different entity":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: returns false for different entity")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 100)
            expect(reg.has(2, ComponentTag.Transform)).to_equal(false)

        it "returns false for different tag on same entity":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: returns false for different tag on same entity")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 100)
            expect(reg.has(1, ComponentTag.Render)).to_equal(false)

        it "returns true for each added tag on same entity":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: returns true for each added tag on same entity")
            var reg = ComponentRegistry.create()
            reg.add(5, ComponentTag.Transform, 10)
            reg.add(5, ComponentTag.Render, 20)
            expect(reg.has(5, ComponentTag.Transform)).to_equal(true)
            expect(reg.has(5, ComponentTag.Render)).to_equal(true)

    context "get_data_id":
        it "returns data_id for registered component":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: returns data_id for registered component")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 42)
            expect(reg.get_data_id(1, ComponentTag.Transform)).to_equal(42)  # oracle: value fixed by the spec contract

        it "returns -1 for unregistered component":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: returns -1 for unregistered component")
            val reg = ComponentRegistry.create()
            expect(reg.get_data_id(1, ComponentTag.Transform)).to_equal(-1)  # oracle: value fixed by the spec contract

        it "returns -1 for wrong entity":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: returns -1 for wrong entity")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 99)
            expect(reg.get_data_id(2, ComponentTag.Transform)).to_equal(-1)  # oracle: value fixed by the spec contract

        it "returns -1 for wrong tag on same entity":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: returns -1 for wrong tag on same entity")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 99)
            expect(reg.get_data_id(1, ComponentTag.Render)).to_equal(-1)  # oracle: value fixed by the spec contract

        it "returns correct data_id for each of multiple components":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: returns correct data_id for each of multiple components")
            var reg = ComponentRegistry.create()
            reg.add(3, ComponentTag.Transform, 10)
            reg.add(3, ComponentTag.Render, 20)
            reg.add(3, ComponentTag.Physics, 30)
            expect(reg.get_data_id(3, ComponentTag.Transform)).to_equal(10)  # oracle: value fixed by the spec contract
            expect(reg.get_data_id(3, ComponentTag.Render)).to_equal(20)  # oracle: value fixed by the spec contract
            expect(reg.get_data_id(3, ComponentTag.Physics)).to_equal(30)  # oracle: value fixed by the spec contract

    context "remove":
        it "component is gone after remove":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: component is gone after remove")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 100)
            reg.remove(1, ComponentTag.Transform)
            expect(reg.has(1, ComponentTag.Transform)).to_equal(false)

        it "count decreases after remove":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: count decreases after remove")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 100)
            reg.add(1, ComponentTag.Render, 200)
            reg.remove(1, ComponentTag.Transform)
            expect(reg.count()).to_equal(1)  # oracle: value fixed by the spec contract

        it "other components remain after targeted remove":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: other components remain after targeted remove")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 100)
            reg.add(1, ComponentTag.Render, 200)
            reg.remove(1, ComponentTag.Transform)
            expect(reg.has(1, ComponentTag.Render)).to_equal(true)

        it "get_data_id returns -1 after remove":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: get_data_id returns -1 after remove")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 55)
            reg.remove(1, ComponentTag.Transform)
            expect(reg.get_data_id(1, ComponentTag.Transform)).to_equal(-1)  # oracle: value fixed by the spec contract

        it "removing non-existent component leaves count unchanged":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: removing non-existent component leaves count unchanged")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Render, 10)
            reg.remove(1, ComponentTag.Transform)
            expect(reg.count()).to_equal(1)  # oracle: value fixed by the spec contract

        it "components of other entities are unaffected by remove":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: components of other entities are unaffected by remove")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 100)
            reg.add(2, ComponentTag.Transform, 200)
            reg.remove(1, ComponentTag.Transform)
            expect(reg.has(2, ComponentTag.Transform)).to_equal(true)

    context "count_by_tag":
        it "returns 0 for empty registry":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: returns 0 for empty registry")
            val reg = ComponentRegistry.create()
            expect(reg.count_by_tag(ComponentTag.Transform)).to_equal(0)  # oracle: value fixed by the spec contract

        it "counts components of a specific tag":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: counts components of a specific tag")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 10)
            reg.add(2, ComponentTag.Transform, 20)
            reg.add(3, ComponentTag.Render, 30)
            expect(reg.count_by_tag(ComponentTag.Transform)).to_equal(2)  # oracle: value fixed by the spec contract

        it "does not count other tags":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: does not count other tags")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Render, 10)
            reg.add(2, ComponentTag.Physics, 20)
            expect(reg.count_by_tag(ComponentTag.Transform)).to_equal(0)  # oracle: value fixed by the spec contract

        it "counts each tag independently":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: counts each tag independently")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 1)
            reg.add(2, ComponentTag.Transform, 2)
            reg.add(3, ComponentTag.Transform, 3)
            reg.add(1, ComponentTag.Render, 4)
            expect(reg.count_by_tag(ComponentTag.Transform)).to_equal(3)  # oracle: value fixed by the spec contract
            expect(reg.count_by_tag(ComponentTag.Render)).to_equal(1)  # oracle: value fixed by the spec contract

        it "decreases after remove":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: decreases after remove")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Audio, 10)
            reg.add(2, ComponentTag.Audio, 20)
            reg.remove(1, ComponentTag.Audio)
            expect(reg.count_by_tag(ComponentTag.Audio)).to_equal(1)  # oracle: value fixed by the spec contract

    context "remove_all":
        it "removes all components for an entity":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: removes all components for an entity")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 10)
            reg.add(1, ComponentTag.Render, 20)
            reg.add(1, ComponentTag.Physics, 30)
            reg.remove_all(1)
            expect(reg.has(1, ComponentTag.Transform)).to_equal(false)
            expect(reg.has(1, ComponentTag.Render)).to_equal(false)
            expect(reg.has(1, ComponentTag.Physics)).to_equal(false)

        it "count drops to zero after remove_all for sole entity":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: count drops to zero after remove_all for sole entity")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 10)
            reg.add(1, ComponentTag.Camera, 20)
            reg.remove_all(1)
            expect(reg.count()).to_equal(0)  # oracle: value fixed by the spec contract

        it "other entities are unaffected by remove_all":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: other entities are unaffected by remove_all")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 10)
            reg.add(2, ComponentTag.Transform, 20)
            reg.add(2, ComponentTag.Render, 30)
            reg.remove_all(1)
            expect(reg.has(2, ComponentTag.Transform)).to_equal(true)
            expect(reg.has(2, ComponentTag.Render)).to_equal(true)

        it "count reflects only remaining components after remove_all":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: count reflects only remaining components after remove_all")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Script, 1)
            reg.add(1, ComponentTag.Light, 2)
            reg.add(2, ComponentTag.Camera, 3)
            reg.remove_all(1)
            expect(reg.count()).to_equal(1)  # oracle: value fixed by the spec contract

        it "remove_all on non-existent entity leaves registry unchanged":
            # @req: REQ-GAME3D-EventComponent-001
            step("Verify: remove_all on non-existent entity leaves registry unchanged")
            var reg = ComponentRegistry.create()
            reg.add(1, ComponentTag.Transform, 10)
            reg.remove_all(99)
            expect(reg.count()).to_equal(1)  # oracle: value fixed by the spec contract
