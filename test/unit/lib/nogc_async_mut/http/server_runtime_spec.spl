# @req: REQ-LIB-HTTP_SERVER_RUNTIME-001

use std.spec
use std.nogc_async_mut.http.server_runtime.{
    WorkerConfig, WorkerState, RuntimeStatus, ServerRuntime, BoundedLogger,
    default_worker_config, worker_config_for_cores,
    create_worker_state, worker_is_overloaded,
    supports_reuseport,
    runtime_status_name, runtime_status_is_accepting,
    bounded_logger_new, bounded_logger_log,
    bounded_logger_entry_count, bounded_logger_dropped, bounded_logger_is_full
}

describe "WorkerConfig defaults":
    it "default config has positive worker count":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: default config has positive worker count")
        val config = default_worker_config()
        expect(config.worker_count).to_equal(4)  # oracle: expected value pinned by spec

    it "default config has positive backpressure limit":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: default config has positive backpressure limit")
        val config = default_worker_config()
        expect(config.backpressure_limit).to_equal(1024)  # oracle: expected value pinned by spec

    it "default config has positive log bound":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: default config has positive log bound")
        val config = default_worker_config()
        expect(config.log_bound).to_equal(4096)  # oracle: expected value pinned by spec

    it "default config enables SO_REUSEPORT":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: default config enables SO_REUSEPORT")
        val config = default_worker_config()
        expect(config.enable_reuseport).to_equal(true)

describe "worker_config_for_cores":
    it "matches requested core count":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: matches requested core count")
        val config = worker_config_for_cores(8)
        expect(config.worker_count).to_equal(8)  # oracle: expected value pinned by spec

    it "clamps zero cores to one":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: clamps zero cores to one")
        val config = worker_config_for_cores(0)
        expect(config.worker_count).to_equal(1)  # oracle: expected value pinned by spec

    it "clamps negative cores to one":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: clamps negative cores to one")
        val config = worker_config_for_cores(-2)
        expect(config.worker_count).to_equal(1)  # oracle: expected value pinned by spec

    it "single core config":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: single core config")
        val config = worker_config_for_cores(1)
        expect(config.worker_count).to_equal(1)  # oracle: expected value pinned by spec

describe "WorkerState creation":
    it "creates fresh state with zeroed counters":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: creates fresh state with zeroed counters")
        val state = create_worker_state(0)
        expect(state.worker_id).to_equal(0)  # oracle: expected value pinned by spec
        expect(state.event_count).to_equal(0)  # oracle: expected value pinned by spec
        expect(state.arena_usage_bytes).to_equal(0)  # oracle: expected value pinned by spec
        expect(state.active_connections).to_equal(0)  # oracle: expected value pinned by spec

    it "assigns correct worker id":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: assigns correct worker id")
        val state = create_worker_state(7)
        expect(state.worker_id).to_equal(7)  # oracle: expected value pinned by spec

describe "worker overload detection":
    it "not overloaded when under limit":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: not overloaded when under limit")
        val config = default_worker_config()
        val state = WorkerState(
            worker_id: 0,
            event_count: 100,
            arena_usage_bytes: 0,
            active_connections: 512
        )
        expect(worker_is_overloaded(state, config)).to_equal(false)

    it "not overloaded at exactly the limit":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: not overloaded at exactly the limit")
        val config = default_worker_config()
        val state = WorkerState(
            worker_id: 0,
            event_count: 0,
            arena_usage_bytes: 0,
            active_connections: 1024
        )
        expect(worker_is_overloaded(state, config)).to_equal(false)

    it "overloaded when exceeding limit":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: overloaded when exceeding limit")
        val config = default_worker_config()
        val state = WorkerState(
            worker_id: 0,
            event_count: 0,
            arena_usage_bytes: 0,
            active_connections: 1025
        )
        expect(worker_is_overloaded(state, config)).to_equal(true)

describe "RuntimeStatus":
    it "idle status name":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: idle status name")
        expect(runtime_status_name(RuntimeStatus.Idle)).to_equal("idle")

    it "running status name":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: running status name")
        expect(runtime_status_name(RuntimeStatus.Running)).to_equal("running")

    it "draining status name":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: draining status name")
        expect(runtime_status_name(RuntimeStatus.Draining)).to_equal("draining")

    it "stopped status name":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: stopped status name")
        expect(runtime_status_name(RuntimeStatus.Stopped)).to_equal("stopped")

    it "only running accepts connections":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: only running accepts connections")
        expect(runtime_status_is_accepting(RuntimeStatus.Running)).to_equal(true)
        expect(runtime_status_is_accepting(RuntimeStatus.Idle)).to_equal(false)
        expect(runtime_status_is_accepting(RuntimeStatus.Draining)).to_equal(false)
        expect(runtime_status_is_accepting(RuntimeStatus.Stopped)).to_equal(false)

describe "ServerRuntime":
    it "creates with correct worker count":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: creates with correct worker count")
        val config = default_worker_config()
        val rt = ServerRuntime.new(config)
        expect(rt.worker_count()).to_equal(4)  # oracle: expected value pinned by spec

    it "starts in idle state":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: starts in idle state")
        val config = default_worker_config()
        val rt = ServerRuntime.new(config)
        expect(rt.is_running()).to_equal(false)

    it "worker count matches config for 8 cores":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: worker count matches config for 8 cores")
        val config = worker_config_for_cores(8)
        val rt = ServerRuntime.new(config)
        expect(rt.worker_count()).to_equal(8)  # oracle: expected value pinned by spec

describe "SO_REUSEPORT detection":
    it "returns a definite bool":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: returns a definite bool")
        val result = supports_reuseport()
        # On Linux the stub returns true; key contract is it returns bool, not crashes
        expect(result).to_equal(true)

describe "BoundedLogger":
    it "starts empty":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: starts empty")
        val logger = bounded_logger_new(10)
        expect(bounded_logger_entry_count(logger)).to_equal(0)  # oracle: expected value pinned by spec
        expect(bounded_logger_dropped(logger)).to_equal(0)  # oracle: expected value pinned by spec

    it "accepts entries within capacity":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: accepts entries within capacity")
        val l0 = bounded_logger_new(3)
        val l1 = bounded_logger_log(l0, "entry 1")
        val l2 = bounded_logger_log(l1, "entry 2")
        expect(bounded_logger_entry_count(l2)).to_equal(2)  # oracle: expected value pinned by spec
        expect(bounded_logger_dropped(l2)).to_equal(0)  # oracle: expected value pinned by spec

    it "drops entries when at capacity":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: drops entries when at capacity")
        val l0 = bounded_logger_new(2)
        val l1 = bounded_logger_log(l0, "entry 1")
        val l2 = bounded_logger_log(l1, "entry 2")
        val l3 = bounded_logger_log(l2, "entry 3 — should be dropped")
        val l4 = bounded_logger_log(l3, "entry 4 — also dropped")
        expect(bounded_logger_entry_count(l4)).to_equal(2)  # oracle: expected value pinned by spec
        expect(bounded_logger_dropped(l4)).to_equal(2)  # oracle: expected value pinned by spec

    it "is_full reports correctly":
        # @req: REQ-LIB-HTTP_SERVER_RUNTIME-001
        step("Verify: is_full reports correctly")
        val l0 = bounded_logger_new(1)
        expect(bounded_logger_is_full(l0)).to_equal(false)  # oracle: expected value pinned by spec
        val l1 = bounded_logger_log(l0, "fill it")
        expect(bounded_logger_is_full(l1)).to_equal(true)  # oracle: expected value pinned by spec
