# std_hash_facade_spec
#
# `src/std` is a symlink to `lib`, so `src/lib/hash.spl` WINS the `std.hash`
# name and shadows the `nogc_async_mut_noalloc/hash/` package that previously
# answered it. The facade must therefore be a SUPERSET: the Hash trait (which
# `use std.hash` could not reach before the facade existed) AND the four
# allocation-free hash functions the shadowed package documented.
#
# Both directions are asserted here so a future facade edit cannot silently
# drop one half. See
# doc/08_tracking/bug/primitive_receiver_trait_impl_dispatch_2026-08-07.md

use std.spec
use std.hash.{Hash, hash_combine, hash_array, rt_hash_text}

struct FacadePoint:
    x: i64
    y: i64

impl Hash for FacadePoint:
    fn hash() -> i64:
        self.x * 31 + self.y

describe "std.hash facade — trait half":

    it "resolves the Hash trait through `use std.hash`":
        val p = FacadePoint(x: 2, y: 3)
        expect(p.hash()).to_equal(65)

    it "hashes text through the trait impl in hash.spl":
        val h = "abc".hash()
        expect(h != 0).to_be_true()

    it "exposes hash_combine":
        val combined = hash_combine(1, 2)
        expect(combined != 0).to_be_true()

describe "std.hash facade — function half must not be dropped":

    it "exposes hash_array":
        val h = hash_array([1, 2, 3])
        expect(h != 0).to_be_true()

    it "exposes rt_hash_text":
        val a = rt_hash_text("a")
        val b = rt_hash_text("b")
        expect(a != b).to_be_true()

    # The four allocation-free functions of the SHADOWED
    # nogc_async_mut_noalloc/hash package (fnv1a_hash_bytes, fnv1a_hash_i64,
    # crc32_byte, crc32_bytes) are not asserted here yet.
    #
    # CORRECTION 2026-08-08 (tiebreaker, supersedes BOTH earlier notes):
    #
    # The first note said the four symbols were unreachable because of an
    # `@noalloc` import defect. The second note (e321ab17c69) said that was a
    # false alarm and "the error does not reproduce in any form". BOTH are
    # wrong, and both were measured correctly on DIFFERENT execution paths:
    #
    #   `bin/simple run`  — `use std.nogc_async_mut_noalloc.hash.{fnv1a_hash_i64}`
    #                       SUCCEEDS (prints a real hash). This is what the
    #                       false-alarm lane measured. It is true.
    #   `bin/simple test` — the SAME import fails at module load with
    #                       `error: semantic: variable noalloc not found`,
    #                       `no examples executed`, 0 passed. This is what the
    #                       defect lane measured. It is also true.
    #
    # `bin/simple test` vs `bin/simple run` is the discriminating condition —
    # NOT the facade, and NOT the `export use` re-export: a spec that imports
    # the noalloc package by its full path with no facade involvement fails
    # identically.
    #
    # ROOT CAUSE: `@noalloc` was never registered as a known annotation in any
    # parser. The Rust seed interpreter treats an unrecognised `@X` on a
    # function as a Python-style runtime decorator and evaluates the bare
    # identifier `X` in the module env — hence "variable noalloc not found".
    # `@inline`/`@pure`/`@unsafe`/`@hardware` are on its skip-list and pass;
    # `@noalloc` and `@zzbogus` were not and fail. The JIT path (`run`) never
    # evaluates decorator expressions, so it never saw it.
    #
    # FIXED IN SOURCE 2026-08-08 (interpreter_eval.rs skip-list). With a
    # locally rebuilt seed this spec passes 5/5 WITH the noalloc re-export
    # added to src/lib/hash.spl. The re-export and the assertions below are
    # deliberately NOT landed yet: on the currently DEPLOYED seed they would
    # poison `std.hash` for every consumer, including map.spl (Map/Dict).
    # Add them in the same change as, or after, a seed redeploy.
    # See doc/08_tracking/bug/noalloc_decorator_unbound_in_seed_interpreter_2026-08-08.md
