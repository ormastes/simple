# std_hash_facade_spec
#
# `src/std` is a symlink to `lib`, so `src/lib/hash.spl` WINS the `std.hash`
# name and shadows the `nogc_async_mut_noalloc/hash/` package that previously
# answered it. The facade must therefore be a SUPERSET: the Hash trait (which
# `use std.hash` could not reach before the facade existed) AND the four
# allocation-free hash functions the shadowed package documented.
#
# Both directions are asserted here so a future facade edit cannot silently
# drop one half. See
# doc/08_tracking/bug/primitive_receiver_trait_impl_dispatch_2026-08-07.md

use std.spec
use std.hash.{Hash, hash_combine, hash_array, rt_hash_text}

struct FacadePoint:
    x: i64
    y: i64

impl Hash for FacadePoint:
    fn hash() -> i64:
        self.x * 31 + self.y

describe "std.hash facade — trait half":

    it "resolves the Hash trait through `use std.hash`":
        val p = FacadePoint(x: 2, y: 3)
        expect(p.hash()).to_equal(65)

    it "hashes text through the trait impl in hash.spl":
        val h = "abc".hash()
        expect(h != 0).to_be_true()

    it "exposes hash_combine":
        val combined = hash_combine(1, 2)
        expect(combined != 0).to_be_true()

describe "std.hash facade — function half must not be dropped":

    it "exposes hash_array":
        val h = hash_array([1, 2, 3])
        expect(h != 0).to_be_true()

    it "exposes rt_hash_text":
        val a = rt_hash_text("a")
        val b = rt_hash_text("b")
        expect(a != b).to_be_true()

    # The four allocation-free functions of the SHADOWED
    # nogc_async_mut_noalloc/hash package (fnv1a_hash_bytes, fnv1a_hash_i64,
    # crc32_byte, crc32_bytes) are not asserted here yet.
    #
    # CORRECTION 2026-08-08: the previous version of this comment said they were
    # "unreachable" because importing them by full path "fails with `semantic:
    # variable `noalloc` not found`", and told the reader to wait for an
    # `@noalloc` import defect to be fixed. That is FALSE and was refuted by
    # measurement in e321ab17c69 (see
    # doc/08_tracking/bug/noalloc_annotations_do_not_survive_import_false_alarm_2026-08-08.md),
    # which landed 109 minutes after this spec. Re-measured against origin/main:
    # `use std.nogc_async_mut_noalloc.hash.{fnv1a_hash_i64}` SUCCEEDS, and the
    # "variable `noalloc` not found" error does not reproduce in any form.
    #
    # There is no compiler defect to wait on. The only reason the four symbols
    # are not reachable via `use std.hash` is ordinary facade shadowing:
    # src/std is a symlink to lib, so src/lib/hash.spl wins the `std.hash` name
    # and simply does not re-export them. The fix is a one-line `export use` in
    # src/lib/hash.spl plus assertions here — not a wait on a phantom defect.
    # Do not cite the old claim as evidence; it never held.
