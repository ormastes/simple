describe "read_bytes boundary cases":
    """
    ## Reading Beyond Array Bounds
    """

    it "handles zero length read":
        # @req: REQ-COMMON-SerializationExtende-001
        step("Verify: handles zero length read")
        val result = read_bytes([1, 2, 3], 0, 0)
        val data = result.0
        expect(data.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "reads exactly all bytes":
        # @req: REQ-COMMON-SerializationExtende-001
        step("Verify: reads exactly all bytes")
        val data = [10, 20, 30]
        val result = read_bytes(data, 0, 3)
        val bytes = result.0
        expect(bytes.len()).to_equal(3)  # oracle: value fixed by the spec contract
        expect(bytes[0]).to_equal(10)  # oracle: value fixed by the spec contract
        expect(bytes[2]).to_equal(30)  # oracle: value fixed by the spec contract

    it "reads partially beyond array end":
        # @req: REQ-COMMON-SerializationExtende-001
        step("Verify: reads partially beyond array end")
        val data = [10, 20]
        val result = read_bytes(data, 0, 4)
        val bytes = result.0
        # Only 2 of 4 requested bytes are in bounds
        expect(result.1).to_equal(4)  # oracle: value fixed by the spec contract

    it "rejects negative offset":
        # @req: REQ-COMMON-SerializationExtende-001
        step("Verify: rejects negative offset")
        val result = read_bytes([10, 20], 0 - 1, 2)
        val bytes = result.0
        expect(bytes.len()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.1).to_equal(2)  # oracle: value fixed by the spec contract

describe "read_bytes_with_length edge cases":
    """
    ## Length-Prefixed Byte Reading
    """

    it "reads empty data":
        # @req: REQ-COMMON-SerializationExtende-001
        step("Verify: reads empty data")
        val data = [0]
        val result = read_bytes_with_length(data, 0)
        val bytes = result.0
        expect(bytes.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "reads single byte data":
        # @req: REQ-COMMON-SerializationExtende-001
        step("Verify: reads single byte data")
        val data = [1, 42]
        val result = read_bytes_with_length(data, 0)
        val bytes = result.0
        expect(bytes.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(bytes[0]).to_equal(42)  # oracle: value fixed by the spec contract

    it "rejects negative offset":
        # @req: REQ-COMMON-SerializationExtende-001
        step("Verify: rejects negative offset")
        val result = read_bytes_with_length([1, 42], 0 - 1)
        val bytes = result.0
        expect(bytes.len()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.1).to_equal(1)  # oracle: value fixed by the spec contract

describe "write_varint edge single byte":
    """
    ## Varint Encoding for Values Exactly at Boundary
    """

    it "encodes 1 as single byte":
        # @req: REQ-COMMON-SerializationExtende-001
        step("Verify: encodes 1 as single byte")
        val result = write_varint(1)
        expect(result.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(result[0]).to_equal(1)  # oracle: value fixed by the spec contract

    it "encodes 127 as single byte":
        # @req: REQ-COMMON-SerializationExtende-001
        step("Verify: encodes 127 as single byte")
        val result = write_varint(127)
        expect(result.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(result[0]).to_equal(127)  # oracle: value fixed by the spec contract

    it "encodes -1 with sign marker":
        # @req: REQ-COMMON-SerializationExtende-001
        step("Verify: encodes -1 with sign marker")
        val result = write_varint(-1)
        expect(result[0]).to_equal(255)  # oracle: value fixed by the spec contract

