"""
## Purpose and audience
Purpose: Prove that Math FFI Functions.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# Math FFI Specification
#
# Tests for mathematical operations available through the runtime,
# including power/exponential via loops, absolute value, and special values.

use std.spec.step

describe "Math FFI Functions":
    # Validates mathematical operations including power, absolute value,
    # and special value handling.
    context "power and exponential":
        it "calculates power correctly via loop":
            step("Verify: calculates power correctly via loop")
            # @req: REQ-LIB-COMMON-001
            var result = 1
            for _ in 0..3:
                result = result * 2
            expect(result).to_equal(8)  # oracle: 8 — named expected value from the requirement

        it "handles zero exponent":
            step("Verify: handles zero exponent")
            # x^0 = 1 for any x
            var result = 1
            # 0 iterations = x^0
            expect(result).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "handles base of 1":
            step("Verify: handles base of 1")
            var result = 1
            for _ in 0..100:
                result = result * 1
            expect(result).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "absolute value":
        it "calculates absolute value of negative":
            step("Verify: calculates absolute value of negative")
            val x = -5
            var abs_x = x
            if abs_x < 0: abs_x = -abs_x
            expect(abs_x).to_equal(5)  # oracle: 5 — named expected value from the requirement

        it "positive value unchanged":
            step("Verify: positive value unchanged")
            val x = 5
            var abs_x = x
            if abs_x < 0: abs_x = -abs_x
            expect(abs_x).to_equal(5)  # oracle: 5 — named expected value from the requirement

        it "zero unchanged":
            step("Verify: zero unchanged")
            val x = 0
            var abs_x = x
            if abs_x < 0: abs_x = -abs_x
            expect(abs_x).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "integer square roots via approximation":
        it "sqrt(16) = 4 via search":
            step("Verify: sqrt(16) = 4 via search")
            var result = 0
            for i in 0..17:
                if i * i == 16:
                    result = i
            expect(result).to_equal(4)  # oracle: 4 — named expected value from the requirement

        it "sqrt(9) = 3 via search":
            step("Verify: sqrt(9) = 3 via search")
            var result = 0
            for i in 0..10:
                if i * i == 9:
                    result = i
            expect(result).to_equal(3)  # oracle: 3 — named expected value from the requirement

        it "sqrt(1) = 1 via search":
            step("Verify: sqrt(1) = 1 via search")
            var result = 0
            for i in 0..2:
                if i * i == 1:
                    result = i
            expect(result).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "sqrt(0) = 0":
            step("Verify: sqrt(0) = 0")
            expect(0 * 0).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "special values":
        it "handles zero correctly":
            step("Verify: handles zero correctly")
            expect(0 * 2).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(0 + 5).to_equal(5)  # oracle: 5 — named expected value from the requirement
            expect(0 - 3).to_equal(-3)  # oracle: -3 — named expected value from the requirement

        it "handles one correctly":
            step("Verify: handles one correctly")
            expect(1 * 100).to_equal(100)  # oracle: 100 — named expected value from the requirement
            expect(1 + 0).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "handles negative numbers":
            step("Verify: handles negative numbers")
            expect(-1 * -1).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(-3 * 2).to_equal(-6)  # oracle: -6 — named expected value from the requirement
            expect(-10 + 10).to_equal(0)  # oracle: 0 — named expected value from the requirement
