"""
## Purpose and audience
Purpose: Prove that i64 overflow behavior.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

use std.spipe.*

use std.spec.step

describe "i64 overflow behavior":
    it "max i64 + 1 wraps to min":
        step("Verify: max i64 + 1 wraps to min")
        # @req: REQ-LIB-COMMON-001
        val max = 9223372036854775807
        val result = max + 1
        expect(result).to_equal(-9223372036854775808)  # oracle: -9223372036854775808 — named expected value from the requirement
    it "large left shift stays in 64 bits":
        step("Verify: large left shift stays in 64 bits")
        val x = 1
        val shifted = x << 63
        # Should be -9223372036854775808 (min i64, bit 63 set)
        expect(shifted).to_equal(-9223372036854775808)  # oracle: -9223372036854775808 — named expected value from the requirement
    it "mask with -1 works as no-op":
        step("Verify: mask with -1 works as no-op")
        val x = 100
        val r = x & -1
        expect(r).to_equal(100)  # oracle: 100 — named expected value from the requirement
    it "two large values add with wrap":
        step("Verify: two large values add with wrap")
        val a = 9223372036854775807
        val b = 9223372036854775807
        val r = a + b
        expect(r).to_equal(-2)  # oracle: -2 — named expected value from the requirement
