"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/common/module_import_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# # Module Import Syntax Specification
#
# **Category:** Syntax
# **Status:** Implemented
#
# Tests for module import/use statement parsing and deprecation warnings.
# Covers modern `use` syntax and deprecated alternatives like `import`, `.`
# and `from...import` patterns.


describe "Module Import Syntax":
    # Verifies parsing and deprecation warnings for module import statements.
    # Covers modern `use` syntax with dot notation, deprecated `.` syntax,
    # and older `import`/`from...import` patterns. Tests export and common use
    # modifiers, relative imports, and module paths with reserved keywords.

    describe "use statement with dot notation":
        # Tests modern `use` statement syntax with dot notation.

        it "parses use module.item":
            # @req: REQ-UNIT-LIB-001
            step("Verify: parses use module.item")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # This should parse without warnings
            # Note: Module may not exist, we're testing parsing
            use lib.core.Option
            expect(true).to_equal(true)

        it "parses use module with group imports":
            # @req: REQ-UNIT-LIB-002
            step("Verify: parses use module with group imports")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            use lib.core.{Option, Result}
            expect(true).to_equal(true)

        it "parses use module":
            # @req: REQ-UNIT-LIB-003
            step("Verify: parses use module")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            use lib.core
            expect(true).to_equal(true)

        it "parses use with alias":
            # @req: REQ-UNIT-LIB-004
            step("Verify: parses use with alias")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            use lib.core.Option as Opt
            expect(true).to_equal(true)

    describe "deprecated double colon syntax":
        # Tests deprecated `.` syntax which should emit deprecation warnings.

        it "warns on use std double colon core":
            # @req: REQ-UNIT-LIB-005
            step("Verify: warns on use std double colon core")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Parser should emit: "Deprecated: '.' in module paths"
            use lib.core
            expect(true).to_equal(true)

        it "warns on use std double colon core double colon star":
            # @req: REQ-UNIT-LIB-006
            step("Verify: warns on use std double colon core double colon star")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Multiple . should emit multiple warnings
            use lib.core
            expect(true).to_equal(true)

        it "warns on use std double colon core with group":
            # @req: REQ-UNIT-LIB-007
            step("Verify: warns on use std double colon core with group")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            use lib.core.{Option, Result}
            expect(true).to_equal(true)

    describe "deprecated import keyword":
        # Tests deprecated `import` keyword which should emit deprecation warnings.

        it "warns on import keyword":
            # @req: REQ-UNIT-LIB-008
            step("Verify: warns on import keyword")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Parser should emit: "Deprecated: 'import' keyword"
            # Use 'use' instead
            import std.core
            expect(true).to_equal(true)

        it "warns on from...import syntax":
            # @req: REQ-UNIT-LIB-009
            step("Verify: warns on from...import syntax")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Parser should emit: "Deprecated: 'from ... import' syntax"
            # Use 'use module.group' instead
            from std.core import Option
            expect(true).to_equal(true)

    describe "export use statements":
        # Tests export statements with use syntax for re-exporting modules.

        it "parses export use module.item":
            # @req: REQ-UNIT-LIB-010
            step("Verify: parses export use module.item")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            export use lib.core.Option
            expect(true).to_equal(true)

        it "parses export use module with group":
            # @req: REQ-UNIT-LIB-011
            step("Verify: parses export use module with group")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            export use lib.core.{Option, Result}
            expect(true).to_equal(true)

        it "warns on export use module", tag: "deprecation":
            # Parser should emit: "Avoid 'export use *' - exposes unnecessary interfaces"
            # Use explicit exports instead
            export use lib.core
            expect(true).to_equal(true)

        it "parses export A, B from module":
            # @req: REQ-UNIT-LIB-012
            step("Verify: parses export A, B from module")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            export Option, Result from std.core
            expect(true).to_equal(true)

        it "parses export group from module":
            # @req: REQ-UNIT-LIB-013
            step("Verify: parses export group from module")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            export { Option, Result } from std.core
            expect(true).to_equal(true)

    describe "common use statements":
        # Tests `common use` syntax for importing from shared module namespaces.

        it "parses common use module.item":
            # @req: REQ-UNIT-LIB-014
            step("Verify: parses common use module.item")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            common use lib.core.Option
            expect(true).to_equal(true)

        it "parses common use module with group":
            # @req: REQ-UNIT-LIB-015
            step("Verify: parses common use module with group")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            common use lib.core.{Option, Result}
            expect(true).to_equal(true)

    describe "relative imports":
        # Tests relative import syntax using .. notation.

        it "parses import .. as parent":
            # @req: REQ-UNIT-LIB-016
            step("Verify: parses import .. as parent")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            import .. as parent
            expect(true).to_equal(true)

        it "parses import ..sibling":
            # @req: REQ-UNIT-LIB-017
            step("Verify: parses import ..sibling")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            import ..sibling
            expect(true).to_equal(true)

    describe "module path with keywords":
        # Tests that reserved keywords are allowed as module path segments.

        it "allows async in path":
            # @req: REQ-UNIT-LIB-018
            step("Verify: allows async in path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            use host.async_nogc_mut.io
            expect(true).to_equal(true)

        it "allows sync in path":
            # @req: REQ-UNIT-LIB-019
            step("Verify: allows sync in path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            use host.sync_nogc_mut.io
            expect(true).to_equal(true)

        it "allows test in path":
            # @req: REQ-UNIT-LIB-020
            step("Verify: allows test in path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            use lib.test.helpers
            expect(true).to_equal(true)
