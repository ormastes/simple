# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use common.wine_host_gate.{
    wine_host_required_features,
    wine_host_missing_features,
    wine_host_gate,
    wine_thread_gate,
    wine_posix_gate,
    wine_dynamic_gate
}

describe "Wine host substrate gate":
    # @manual scenario evidence
    describe "overall host features":
        it "lists POSIX, thread, loader, and service features":
            # @req REQ-SSPEC-UNIT
            step("lists POSIX, thread, loader, and service features")
            val required = wine_host_required_features()
            expect(required.len()).to_be_greater_than(20)
            expect(required[0]).to_equal("fd-table")

        it "reports the first missing host feature":
            # @req REQ-SSPEC-UNIT
            step("reports the first missing host feature")
            val state = wine_host_gate("fd-table stdio pipes sockets poll-wait timers errno cwd-env-argv spawn fs-paths")
            expect(state).to_equal("missing-fs-attrs")

    describe "specific service gates":
        it "requires real pthread, TLS, synchronization, and fault attribution":
            # @req REQ-SSPEC-UNIT
            step("requires real pthread, TLS, synchronization, and fault attribution")
            val state = wine_thread_gate("pthread tls mutex condvar semaphore event")
            expect(state).to_equal("missing-thread-fault")

        it "requires POSIX-shaped fd, wait, timer, env, and spawn services":
            # @req REQ-SSPEC-UNIT
            step("requires POSIX-shaped fd, wait, timer, env, and spawn services")
            val state = wine_posix_gate("fd-table stdio pipes sockets poll-wait timers errno cwd-env-argv")
            expect(state).to_equal("missing-spawn")

        it "requires dynamic loading and structured loader behavior":
            # @req REQ-SSPEC-UNIT
            step("requires dynamic loading and structured loader behavior")
            val state = wine_dynamic_gate("dynload symbol-lookup relocation")
            expect(state).to_equal("missing-loader-errors")

