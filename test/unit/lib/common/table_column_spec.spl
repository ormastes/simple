"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/common/table_column_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Table (DataFrame) Module Extended Specification
#
# Tests for std.table module logic.
# Since the module uses Dict<text, Column> generics not supported by runtime,
# we test inline implementations of Column and Table operations.

# ============================================================================
# Inline Column implementation (mirroring std.table)
# ============================================================================

fn column_create(col_name: text, col_data) -> dict:
    {"name": col_name, "data": col_data}

fn column_len(col: dict) -> i64:
    col["data"].len()

fn column_get(col: dict, idx: i64):
    col["data"][idx]

fn column_sum(col: dict) -> f64:
    var total = 0.0
    for item in col["data"]:
        total = total + item
    total

fn column_mean(col: dict) -> f64:
    if col["data"].len() == 0:
        return 0.0
    column_sum(col) / col["data"].len()

fn column_min(col: dict):
    val data = col["data"]
    if data.len() == 0:
        return nil
    var best = data[0]
    var i = 1
    while i < data.len():
        if data[i] < best:
            best = data[i]
        i = i + 1
    best

fn column_max(col: dict):
    val data = col["data"]
    if data.len() == 0:
        return nil
    var best = data[0]
    var i = 1
    while i < data.len():
        if data[i] > best:
            best = data[i]
        i = i + 1
    best

fn column_unique(col: dict):
    var seen = {}
    var result = []
    for item in col["data"]:
        val key = "{item}"
        if not seen.has(key):
            seen[key] = true
            result.push(item)
    result

fn column_value_counts(col: dict) -> dict:
    var counts = {}
    for item in col["data"]:
        val key = "{item}"
        if counts.has(key):
            counts[key] = counts[key] + 1
        else:
            counts[key] = 1
    counts

# ============================================================================
# Inline Table implementation (mirroring std.table)
# ============================================================================

fn table_empty() -> dict:
    {"columns": {}, "column_names": [], "num_rows": 0}

fn table_from_columns(cols) -> dict:
    var table_cols = {}
    var names = []
    var rows = 0
    for col in cols:
        table_cols[col["name"]] = col
        names.push(col["name"])
        if rows == 0:
            rows = col["data"].len()
    {"columns": table_cols, "column_names": names, "num_rows": rows}

fn table_get(table: dict, col_name: text):
    if table["columns"].has(col_name):
        table["columns"][col_name]
    else:
        nil

fn table_col_index(table: dict, col_name: text) -> i64:
    var i = 0
    while i < table["column_names"].len():
        if table["column_names"][i] == col_name:
            return i
        i = i + 1
    -1

fn table_select(table: dict, col_names) -> dict:
    var new_cols = []
    for col_name in col_names:
        if table["columns"].has(col_name):
            new_cols.push(table["columns"][col_name])
    table_from_columns(new_cols)

fn table_drop(table: dict, col_names) -> dict:
    var keep_names = []
    for col_name in table["column_names"]:
        var should_keep = true
        for drop_name in col_names:
            if col_name == drop_name:
                should_keep = false
        if should_keep:
            keep_names.push(col_name)
    table_select(table, keep_names)

fn table_with_column(table: dict, col_name: text, values) -> dict:
    if values.len() != table["num_rows"]:
        return table
    var new_col_names = []
    for n in table["column_names"]:
        new_col_names.push(n)
    new_col_names.push(col_name)
    var new_cols = {}
    for (k, v) in table["columns"]:
        new_cols[k] = v
    new_cols[col_name] = {"name": col_name, "data": values}
    {"columns": new_cols, "column_names": new_col_names, "num_rows": table["num_rows"]}

# ============================================================================
# Column Tests
# ============================================================================

describe "column_create":

    it "creates a column with name and data":
        # @req: REQ-UNIT-LIB-001
        step("Verify: creates a column with name and data")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("age", [25, 30, 35])
        expect(col["name"]).to_equal("age")
        expect(col["data"].len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    it "creates empty column":
        # @req: REQ-UNIT-LIB-002
        step("Verify: creates empty column")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("empty", [])
        expect(col["name"]).to_equal("empty")
        expect(col["data"].len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

describe "column_len":

    it "returns length of column":
        # @req: REQ-UNIT-LIB-003
        step("Verify: returns length of column")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [1, 2, 3, 4, 5])
        expect(column_len(col)).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

    it "returns 0 for empty column":
        # @req: REQ-UNIT-LIB-004
        step("Verify: returns 0 for empty column")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [])
        expect(column_len(col)).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

describe "column_get":

    it "gets value by index":
        # @req: REQ-UNIT-LIB-005
        step("Verify: gets value by index")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [10, 20, 30])
        expect(column_get(col, 0)).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec
        expect(column_get(col, 1)).to_equal(20)  # oracle: expected value 20 is the behavior asserted by this regression spec
        expect(column_get(col, 2)).to_equal(30)  # oracle: expected value 30 is the behavior asserted by this regression spec

describe "column_sum":

    it "sums integer values":
        # @req: REQ-UNIT-LIB-006
        step("Verify: sums integer values")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [1, 2, 3, 4, 5])
        var result = column_sum(col)
        expect(result).to_equal(15.0)

    it "sums to 0 for empty column":
        # @req: REQ-UNIT-LIB-007
        step("Verify: sums to 0 for empty column")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [])
        var result = column_sum(col)
        expect(result).to_equal(0.0)

describe "column_mean":

    it "computes mean of values":
        # @req: REQ-UNIT-LIB-008
        step("Verify: computes mean of values")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [2, 4, 6])
        var result = column_mean(col)
        expect(result).to_equal(4.0)

    it "returns 0 for empty column":
        # @req: REQ-UNIT-LIB-009
        step("Verify: returns 0 for empty column")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [])
        var result = column_mean(col)
        expect(result).to_equal(0.0)

    it "computes mean of single value":
        # @req: REQ-UNIT-LIB-010
        step("Verify: computes mean of single value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [10])
        var result = column_mean(col)
        expect(result).to_equal(10.0)

describe "column_min":

    it "finds minimum value":
        # @req: REQ-UNIT-LIB-011
        step("Verify: finds minimum value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [5, 3, 8, 1, 4])
        var result = column_min(col)
        expect(result).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "returns nil for empty column":
        # @req: REQ-UNIT-LIB-012
        step("Verify: returns nil for empty column")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [])
        var result = column_min(col)
        expect(result).to_be_nil()

    it "works with single element":
        # @req: REQ-UNIT-LIB-013
        step("Verify: works with single element")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [42])
        var result = column_min(col)
        expect(result).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

describe "column_max":

    it "finds maximum value":
        # @req: REQ-UNIT-LIB-014
        step("Verify: finds maximum value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [5, 3, 8, 1, 4])
        var result = column_max(col)
        expect(result).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

    it "returns nil for empty column":
        # @req: REQ-UNIT-LIB-015
        step("Verify: returns nil for empty column")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [])
        var result = column_max(col)
        expect(result).to_be_nil()

    it "works with single element":
        # @req: REQ-UNIT-LIB-016
        step("Verify: works with single element")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [42])
        var result = column_max(col)
        expect(result).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

describe "column_unique":

    it "returns unique values":
        # @req: REQ-UNIT-LIB-017
        step("Verify: returns unique values")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [1, 2, 2, 3, 3, 3])
        var result = column_unique(col)
        expect(result.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    it "preserves order":
        # @req: REQ-UNIT-LIB-018
        step("Verify: preserves order")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [3, 1, 2, 1, 3])
        var result = column_unique(col)
        expect(result[0]).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
        expect(result[1]).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(result[2]).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    it "handles empty column":
        # @req: REQ-UNIT-LIB-019
        step("Verify: handles empty column")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [])
        var result = column_unique(col)
        expect(result.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "handles all unique values":
        # @req: REQ-UNIT-LIB-020
        step("Verify: handles all unique values")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [10, 20, 30])
        var result = column_unique(col)
        expect(result.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

describe "column_value_counts":

    it "counts value occurrences":
        # @req: REQ-UNIT-LIB-021
        step("Verify: counts value occurrences")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", ["a", "b", "a", "c", "b", "a"])
        val counts = column_value_counts(col)
        expect(counts["a"]).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
        expect(counts["b"]).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(counts["c"]).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "handles single unique value":
        # @req: REQ-UNIT-LIB-022
        step("Verify: handles single unique value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [5, 5, 5])
        val counts = column_value_counts(col)
        expect(counts["5"]).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    it "handles empty column":
        # @req: REQ-UNIT-LIB-023
        step("Verify: handles empty column")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [])
        val counts = column_value_counts(col)
        val count = 0
        for (k, v) in counts:
            pass
        expect(count).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

# ============================================================================
# Table Tests
# ============================================================================

describe "table_empty":

    it "creates table with no columns":
        # @req: REQ-UNIT-LIB-024
        step("Verify: creates table with no columns")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val table = table_empty()
        expect(table["column_names"].len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(table["num_rows"]).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

describe "table_from_columns":

    it "creates table from columns":
        # @req: REQ-UNIT-LIB-025
        step("Verify: creates table from columns")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col1 = column_create("name", ["Alice", "Bob", "Charlie"])
        val col2 = column_create("age", [25, 30, 35])
        val table = table_from_columns([col1, col2])
        expect(table["column_names"].len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(table["num_rows"]).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    it "creates table from single column":
        # @req: REQ-UNIT-LIB-026
        step("Verify: creates table from single column")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [1, 2, 3])
        val table = table_from_columns([col])
        expect(table["column_names"].len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(table["num_rows"]).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    it "creates empty table from no columns":
        # @req: REQ-UNIT-LIB-027
        step("Verify: creates empty table from no columns")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val table = table_from_columns([])
        expect(table["column_names"].len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(table["num_rows"]).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

describe "table_get":

    it "gets column by name":
        # @req: REQ-UNIT-LIB-028
        step("Verify: gets column by name")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col1 = column_create("x", [1, 2, 3])
        val col2 = column_create("y", [4, 5, 6])
        val table = table_from_columns([col1, col2])
        val found = table_get(table, "x")
        expect(found["name"]).to_equal("x")
        expect(found["data"][0]).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "returns nil for non-existent column":
        # @req: REQ-UNIT-LIB-029
        step("Verify: returns nil for non-existent column")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("x", [1, 2])
        val table = table_from_columns([col])
        val found = table_get(table, "z")
        expect(found).to_be_nil()

describe "table_col_index":

    it "returns index of existing column":
        # @req: REQ-UNIT-LIB-030
        step("Verify: returns index of existing column")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col1 = column_create("a", [1])
        val col2 = column_create("b", [2])
        val col3 = column_create("c", [3])
        val table = table_from_columns([col1, col2, col3])
        expect(table_col_index(table, "a")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(table_col_index(table, "b")).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(table_col_index(table, "c")).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    it "returns -1 for non-existent column":
        # @req: REQ-UNIT-LIB-031
        step("Verify: returns -1 for non-existent column")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("a", [1])
        val table = table_from_columns([col])
        expect(table_col_index(table, "z")).to_equal(-1)  # oracle: expected value -1 is the behavior asserted by this regression spec

describe "table_select":

    it "selects specific columns":
        # @req: REQ-UNIT-LIB-032
        step("Verify: selects specific columns")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col1 = column_create("a", [1, 2])
        val col2 = column_create("b", [3, 4])
        val col3 = column_create("c", [5, 6])
        val table = table_from_columns([col1, col2, col3])
        val selected = table_select(table, ["a", "c"])
        expect(selected["column_names"].len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(selected["column_names"][0]).to_equal("a")
        expect(selected["column_names"][1]).to_equal("c")

    it "returns empty table for non-existent columns":
        # @req: REQ-UNIT-LIB-033
        step("Verify: returns empty table for non-existent columns")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("a", [1, 2])
        val table = table_from_columns([col])
        val selected = table_select(table, ["x", "y"])
        expect(selected["column_names"].len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

describe "table_drop":

    it "drops specified columns":
        # @req: REQ-UNIT-LIB-034
        step("Verify: drops specified columns")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col1 = column_create("a", [1, 2])
        val col2 = column_create("b", [3, 4])
        val col3 = column_create("c", [5, 6])
        val table = table_from_columns([col1, col2, col3])
        val dropped = table_drop(table, ["b"])
        expect(dropped["column_names"].len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(dropped["column_names"][0]).to_equal("a")
        expect(dropped["column_names"][1]).to_equal("c")

    it "returns same table when dropping non-existent column":
        # @req: REQ-UNIT-LIB-035
        step("Verify: returns same table when dropping non-existent column")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("a", [1, 2])
        val table = table_from_columns([col])
        val dropped = table_drop(table, ["x"])
        expect(dropped["column_names"].len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(dropped["column_names"][0]).to_equal("a")

describe "table_with_column":

    it "adds a new column":
        # @req: REQ-UNIT-LIB-036
        step("Verify: adds a new column")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("a", [1, 2, 3])
        val table = table_from_columns([col])
        val updated = table_with_column(table, "b", [4, 5, 6])
        expect(updated["column_names"].len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        val new_col = updated["columns"]["b"]
        expect(new_col["data"][0]).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
        expect(new_col["data"][2]).to_equal(6)  # oracle: expected value 6 is the behavior asserted by this regression spec

    it "rejects column with wrong length":
        # @req: REQ-UNIT-LIB-037
        step("Verify: rejects column with wrong length")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val col = column_create("a", [1, 2, 3])
        val table = table_from_columns([col])
        val updated = table_with_column(table, "b", [4, 5])
        # Should return original table unchanged
        expect(updated["column_names"].len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
