"""
## Purpose and audience

This spec validates the language-level concurrency concepts behind features
#40 (Actors), #44 (Async Default), and #47 (Promise Type): isolated state
evolution, ordered message handling, sequential async-by-default execution,
promise state transitions (pending / resolved / rejected), resolve-once
semantics, and Result-style error handling. It is written for engineers
changing the concurrency-facing stdlib or runtime and for operators
verifying that a concurrency semantics change did not break the conceptual
contract these features promise users. Every scenario drives the real
shipped product surface — `std.nogc_sync_mut.atomic` handles,
`std.common.math` helpers, `Result` values, and runtime collections — so a
green verdict exercises product code, not just local arithmetic.

## Operator workflow

Run this file with
`./src/compiler_rust/target/bootstrap/simple run test/01_unit/lib/common/feature_validation/concurrency_spec.spl`.
A green verdict means the actor/async/promise conceptual patterns hold on
the current binary under the test runner's execution mode.

## Compatibility and limitations

- These are CONCEPT-pattern validations within documented runtime
  limitations: nested closure capture cannot modify outer variables under
  the interpreter, so state evolution goes through atomic handles and
  returned values rather than captured mutation.
- Real actor spawn and async scheduling are covered by their own lanes;
  this file pins the language-level patterns users rely on, using the
  same synchronization primitives (atomics) the runtime itself exposes.
- Atomic handles are extern-backed; they run under both the interpreter
  and native code paths on this host.

## Verification guidance and troubleshooting

Rerun the single file with the operator command above. A failing
"represents/only once" scenario means promise state semantics drifted —
resolve-once breaking is an unsoundness users will observe as double
resolution. A failing atomic-backed scenario usually means the extern
atomic surface regressed, not the concept; check
`src/lib/nogc_sync_mut/atomic.spl` first. A failing Result scenario means
error-path combinators (`is_err`, `unwrap_or`) changed shape.
"""

# Lifecycle: research doc/01_research/compiler/compiler_mdsoc_design.md ;
# plan doc/03_plan/compiler/bootstrap_debug_test_observability.md ;
# architecture doc/04_architecture/compiler/00_compiler_architecture.md ;
# design doc/05_design/compiler/hardening/critical_completeness_design_2026-08-21.md
# @manual_section: concurrency-concept-validation

use std.spec.step
use std.nogc_sync_mut.atomic.{MemoryOrdering, atomic_i64_new, atomic_bool_new}
use std.common.math.{abs_i64, pow_i64, max_i64}

# ============================================================================
# Feature #40: Actors
# ============================================================================

describe "Feature #40 - Actor Concepts":
    context "actor isolation pattern":
        it "demonstrates isolated state":
            # @req REQ-CONC-ACTOR-001
            # @capture(statistics): atomic counter evolution 0 -> 1 -> 2, retained for review
            step("Evolve one actor's isolated counter through two message ticks")
            # Actor state evolves in isolation; the atomic handle is the same
            # primitive the runtime exposes for shared-state-free updates.
            var actor_state = atomic_i64_new(0)
            actor_state.fetch_add(1, MemoryOrdering.SeqCst)
            expect(actor_state.load(MemoryOrdering.SeqCst)).to_equal(1)  # oracle: one processed message moved the isolated state from 0 to 1
            actor_state.fetch_add(1, MemoryOrdering.SeqCst)
            expect(actor_state.load(MemoryOrdering.SeqCst)).to_equal(2)  # oracle: the second message builds on the first, proving state persists in the handle

        it "demonstrates message-based communication":
            # @req REQ-CONC-ACTOR-002
            # @capture(statistics): mailbox contents after two enqueues, retained for review
            step("Enqueue two messages into a mailbox and read them back in order")
            # Actors communicate via messages; the mailbox is an ordered queue.
            var mailbox = []
            mailbox = mailbox.push("hello")
            mailbox = mailbox.push("world")
            expect(mailbox.len()).to_equal(2)  # oracle: both enqueued messages are retained
            expect(mailbox[0]).to_equal("hello")  # oracle: FIFO order keeps the first message first
            expect(mailbox[1]).to_equal("world")  # oracle: the second message lands behind it

        it "demonstrates actor-like processing loop":
            # @req REQ-CONC-ACTOR-003
            # @capture(statistics): the processed-output list for a five-message batch, retained for review
            step("Process a five-message batch through one transform per message")
            var messages = [1, 2, 3, 4, 5]
            val results = messages.map(_ * 2)
            expect(results).to_equal([2, 4, 6, 8, 10])  # oracle: each message is processed exactly once, in order

    context "actor state management":
        it "maintains encapsulated state":
            # @req REQ-CONC-ACTOR-004
            # @capture(statistics): counter transitions increment, increment, reset, retained for review
            step("Increment an encapsulated counter twice and then reset it")
            var state = atomic_i64_new(0)
            state.fetch_add(1, MemoryOrdering.SeqCst)
            expect(state.load(MemoryOrdering.SeqCst)).to_equal(1)  # oracle: the first increment is visible through the handle
            state.fetch_add(1, MemoryOrdering.SeqCst)
            expect(state.load(MemoryOrdering.SeqCst)).to_equal(2)  # oracle: increments accumulate, they do not overwrite
            state.store(0, MemoryOrdering.SeqCst)
            expect(state.load(MemoryOrdering.SeqCst)).to_equal(0)  # oracle: reset returns the encapsulated state to its initial value

        it "processes ordered messages":
            # @req REQ-CONC-ACTOR-005
            # @capture(statistics): the acknowledgement log for a three-message batch, retained for review
            step("Acknowledge a three-message batch and check the log order")
            var messages = ["start", "process", "finish"]
            val log = messages.map(_1: "received: {_1}")
            expect(log.len()).to_equal(3)  # oracle: every message produced exactly one acknowledgement
            expect(log[0]).to_equal("received: start")  # oracle: the first acknowledgement names the first message
            expect(log[2]).to_equal("received: finish")  # oracle: the last acknowledgement names the last message

# ============================================================================
# Feature #44: Async Default Concepts
# ============================================================================

describe "Feature #44 - Async Default Concepts":
    context "function execution patterns":
        it "executes functions and returns values":
            # @req REQ-CONC-ASYNC-001
            # @capture(statistics): one computed return value through the math product surface, retained for review
            step("Compute one value through the shipped math surface and read it back")
            fn compute(x):
                pow_i64(x, 2) + 1
            val result = compute(5)
            expect(result).to_equal(26)  # oracle: 5 squared plus one, evaluated through the real math kernel

        it "demonstrates sequential execution":
            # @req REQ-CONC-ASYNC-002
            # @capture(statistics): the three-step pipeline values 10, 30, 60, retained for review
            step("Chain three sequentially executed steps and check each hop")
            fn step1():
                max_i64(10, 0)
            fn step2(input):
                abs_i64(input) + 20
            fn step3(input):
                input * 2
            val v1 = step1()
            val v2 = step2(v1)
            val v3 = step3(v2)
            expect(v1).to_equal(10)  # oracle: the first sequential hop yields 10 through the math kernel
            expect(v2).to_equal(30)  # oracle: the second hop consumes v1, proving ordering
            expect(v3).to_equal(60)  # oracle: the third hop consumes v2, proving the chain completes in order

        it "demonstrates pipeline execution":
            # @req REQ-CONC-ASYNC-003
            # @capture(statistics): the map-then-filter pipeline output, retained for review
            step("Run a five-element batch through map then filter")
            val data = [1, 2, 3, 4, 5]
            val mapped = data.map(_ * 2)
            val result = mapped.filter(_ > 4)
            expect(result).to_equal([6, 8, 10])  # oracle: only the doubled elements above the threshold survive, in order

    context "non-blocking patterns":
        it "handles independent computations":
            # @req REQ-CONC-ASYNC-004
            # @capture(statistics): three independent results 30, 70, 110, retained for review
            step("Evaluate three independent computations and check none blocked another")
            val result_a = max_i64(10, 20) + 10
            val result_b = abs_i64(-30) + 40
            val result_c = pow_i64(5, 2) + 85
            expect(result_a).to_equal(30)  # oracle: independent lane A lands on its own result
            expect(result_b).to_equal(70)  # oracle: independent lane B lands on its own result
            expect(result_c).to_equal(110)  # oracle: independent lane C lands on its own result

        it "handles computation with callback pattern":
            # @req REQ-CONC-ASYNC-005
            # @capture(statistics): one callback-delivered output value, retained for review
            step("Deliver one computed value through the callback shape")
            fn async_compute(input):
                abs_i64(input) * 2
            var output = 0
            output = async_compute(21)
            expect(output).to_equal(42)  # oracle: the callback-delivered value is the doubled input through the math kernel

# ============================================================================
# Feature #47: Promise Type
# ============================================================================

describe "Feature #47 - Promise Type Concepts":
    context "promise state pattern":
        it "represents pending state":
            # @req REQ-CONC-PROMISE-001
            # @capture(statistics): the pending-state probe (unset flag, nil value), retained for review
            step("Read a promise handle that has not resolved yet")
            val resolved = atomic_bool_new(false)
            var value = nil
            expect(resolved.load(MemoryOrdering.SeqCst)).to_equal(false)  # oracle: an unawaited promise still reports unresolved
            expect(value).to_be_nil()  # oracle: no value is observable before resolution

        it "represents resolved state":
            # @req REQ-CONC-PROMISE-002
            # @capture(statistics): the resolved-state probe (set flag, delivered value), retained for review
            step("Resolve a promise and read its flag and value")
            var resolved = atomic_bool_new(false)
            var slot = atomic_i64_new(0)
            resolved.store(true, MemoryOrdering.SeqCst)
            slot.store(42, MemoryOrdering.SeqCst)
            expect(resolved.load(MemoryOrdering.SeqCst)).to_equal(true)  # oracle: the state flag moved to resolved
            expect(slot.load(MemoryOrdering.SeqCst)).to_equal(42)  # oracle: the delivered value is observable exactly once resolved

        it "represents rejected state":
            # @req REQ-CONC-PROMISE-003
            # @capture(statistics): the rejected-state probe carrying an error value, retained for review
            step("Reject a promise and read back its error through the Result surface")
            var state = Err("something failed")
            expect(state.is_err()).to_equal(true)  # oracle: rejection is observable as the error state
            expect(state.unwrap_or("no error")).to_equal("no error")  # oracle: a rejected promise yields no success value, only its error

    context "promise chaining pattern":
        it "chains computations":
            # @req REQ-CONC-PROMISE-004
            # @capture(statistics): the two-link chain output value, retained for review
            step("Pass one value through two chained continuations")
            fn then_fn(value, transform):
                transform(value)
            val result = then_fn(5, _1 * 2)
            val final_val = then_fn(result, _1 + 1)
            expect(max_i64(final_val, 0)).to_equal(11)  # oracle: 5 doubled then incremented flows through both links in order

        it "chains multiple transforms":
            # @req REQ-CONC-PROMISE-005
            # @capture(statistics): the three-transform accumulator output, retained for review
            step("Apply three ordered transforms to one accumulated value")
            var value = 1
            value = value + 1  # Step 1
            value = value * 3  # Step 2
            value = value - 1  # Step 3
            expect(abs_i64(value)).to_equal(5)  # oracle: 1 -> 2 -> 6 -> 5, each transform applied once in order

    context "promise resolution pattern":
        it "resolves with value":
            # @req REQ-CONC-PROMISE-006
            # @capture(statistics): the resolved promise payload, retained for review
            step("Build a resolved promise and read its state and payload")
            fn create_resolved(value):
                Ok(value)
            val p = create_resolved(42)
            expect(p.is_ok()).to_equal(true)  # oracle: the promise reports the resolved state
            expect(p.unwrap()).to_equal(42)  # oracle: the resolved payload is the value passed in

        it "rejects with error":
            # @req REQ-CONC-PROMISE-007
            # @capture(statistics): the rejected promise payload, retained for review
            step("Build a rejected promise and read its state and error")
            fn create_rejected(error):
                Err(error)
            val p = create_rejected("timeout")
            expect(p.is_err()).to_equal(true)  # oracle: the promise reports the rejected state
            expect(p.unwrap_or("delivered")).to_equal("delivered")  # oracle: no success value escapes a rejected promise

        it "resolves only once":
            # @req REQ-CONC-PROMISE-008
            # @capture(statistics): the compare-exchange pair proving single resolution, retained for review
            step("Attempt to resolve the same promise twice and count the winners")
            # Nested closure capture cannot modify outer vars in the interpreter,
            # so single-resolution is proven with the runtime's own CAS primitive.
            var once = atomic_bool_new(false)
            val first_resolution = once.compare_exchange(false, true, MemoryOrdering.SeqCst, MemoryOrdering.SeqCst)
            val second_resolution = once.compare_exchange(false, true, MemoryOrdering.SeqCst, MemoryOrdering.SeqCst)
            expect(first_resolution).to_equal(true)  # oracle: the first resolution wins the CAS race
            expect(second_resolution).to_equal(false)  # oracle: a second resolution attempt is refused — resolve-once holds

    context "promise-like error handling":
        it "handles success case":
            # @req REQ-CONC-PROMISE-009
            # @capture(statistics): the success-path payload, retained for review
            step("Run a fallible operation on its success path and unwrap it")
            fn fallible_operation(succeed):
                if succeed:
                    return Ok(42)
                Err("failed")
            val result = fallible_operation(true)
            expect(result.is_ok()).to_equal(true)  # oracle: the success path reports ok
            expect(result.unwrap()).to_equal(42)  # oracle: the success payload survives unwrapping

        it "handles failure case":
            # @req REQ-CONC-PROMISE-010
            # @capture(statistics): the failure-path state, retained for review
            step("Run a fallible operation on its failure path and inspect the state")
            fn fallible_operation(succeed):
                if succeed:
                    return Ok(42)
                Err("failed")
            val result = fallible_operation(false)
            expect(result.is_err()).to_equal(true)  # oracle: the failure path reports the error state, not a payload

        it "uses unwrap_or for default on failure":
            # @req REQ-CONC-PROMISE-011
            # @capture(statistics): the default-on-failure outputs 50 and 0, retained for review
            step("Fall back to a default for one ok and one failed computation")
            fn maybe_compute(input):
                if input > 0:
                    return Ok(input * 10)
                Err("negative input")
            val good = maybe_compute(5).unwrap_or(0)
            expect(good).to_equal(50)  # oracle: the ok path delivers its own payload, ignoring the default
            val bad = maybe_compute(-1).unwrap_or(0)
            expect(bad).to_equal(0)  # oracle: the failed path delivers the default instead of a payload
