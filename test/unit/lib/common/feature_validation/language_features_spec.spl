"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/common/feature_validation/language_features_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# # Language Features Validation
#
# **Feature IDs:** #15 Variables, #24 Closures, #2 Parser
# **Category:** Language
# **Status:** Complete
#
# ## Overview
#
# Validates core language features including variable declarations (val/var/let),
# lambda syntax and closure capture, and parser functionality basics.


# ============================================================================
# Feature #15: Variables
# ============================================================================

describe "Feature #15 - Variables":
    # ## Variable Declarations
    #
    # Variable declarations with val for immutable bindings, var for mutable
    # bindings, and let as an alternative immutable binding. Supports type
    # annotations and type inference.

    context "val declarations (immutable)":
        it "declares immutable integer":
            # @req: REQ-UNIT-LIB-001
            step("Verify: declares immutable integer")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 42
            expect(x).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

        it "declares immutable string":
            # @req: REQ-UNIT-LIB-002
            step("Verify: declares immutable string")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val name = "Alice"
            expect(name).to_equal("Alice")

        it "declares immutable boolean":
            # @req: REQ-UNIT-LIB-003
            step("Verify: declares immutable boolean")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val flag = true
            expect(flag).to_equal(true)

        it "declares immutable array":
            # @req: REQ-UNIT-LIB-004
            step("Verify: declares immutable array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val items = [1, 2, 3]
            expect(items.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

        it "declares immutable with expression":
            # @req: REQ-UNIT-LIB-005
            step("Verify: declares immutable with expression")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = 2 + 3 * 4
            expect(result).to_equal(14)  # oracle: expected value 14 is the behavior asserted by this regression spec

    context "var declarations (mutable)":
        it "declares mutable integer":
            # @req: REQ-UNIT-LIB-006
            step("Verify: declares mutable integer")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var count = 0
            count = count + 1
            expect(count).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "allows reassignment":
            # @req: REQ-UNIT-LIB-007
            step("Verify: allows reassignment")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var value = 10
            value = 20
            expect(value).to_equal(20)  # oracle: expected value 20 is the behavior asserted by this regression spec

        it "supports mutation in loops":
            # @req: REQ-UNIT-LIB-008
            step("Verify: supports mutation in loops")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var total = 0
            for i in [1, 2, 3, 4, 5]:
                total = total + i
            expect(total).to_equal(15)  # oracle: expected value 15 is the behavior asserted by this regression spec

        it "supports mutable string":
            # @req: REQ-UNIT-LIB-009
            step("Verify: supports mutable string")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var msg = "hello"
            msg = "world"
            expect(msg).to_equal("world")

    context "let declarations":
        it "declares immutable binding with let":
            # @req: REQ-UNIT-LIB-010
            step("Verify: declares immutable binding with let")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            let x = 100
            expect(x).to_equal(100)  # oracle: expected value 100 is the behavior asserted by this regression spec

        it "declares let with string":
            # @req: REQ-UNIT-LIB-011
            step("Verify: declares let with string")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            let greeting = "hi"
            expect(greeting).to_equal("hi")

    context "type inference":
        it "infers integer type":
            # @req: REQ-UNIT-LIB-012
            step("Verify: infers integer type")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val x = 42
            expect(x).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

        it "infers string type":
            # @req: REQ-UNIT-LIB-013
            step("Verify: infers string type")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = "hello"
            expect(s).to_start_with("h")

        it "infers boolean type":
            # @req: REQ-UNIT-LIB-014
            step("Verify: infers boolean type")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val b = true
            expect(b).to_equal(true)

        it "infers from expressions":
            # @req: REQ-UNIT-LIB-015
            step("Verify: infers from expressions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val sum = 1 + 2
            expect(sum).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

# ============================================================================
# Feature #24: Closures
# ============================================================================

describe "Feature #24 - Closures":
    # ## Lambda Functions and Closures
    #
    # Lambda functions (anonymous functions) with lexical closure.
    # Captures variables from enclosing scope (read-only in interpreter).

    context "lambda syntax":
        it "creates simple lambda":
            # @req: REQ-UNIT-LIB-016
            step("Verify: creates simple lambda")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val double = \x: x * 2
            expect(double(5)).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec

        it "creates lambda with two parameters":
            # @req: REQ-UNIT-LIB-017
            step("Verify: creates lambda with two parameters")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val add = \a, b: a + b
            expect(add(3, 4)).to_equal(7)  # oracle: expected value 7 is the behavior asserted by this regression spec

        it "creates identity lambda":
            # @req: REQ-UNIT-LIB-018
            step("Verify: creates identity lambda")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val id = \x: x
            expect(id(42)).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

    context "lambda with higher-order functions":
        it "uses lambda with map":
            # @req: REQ-UNIT-LIB-019
            step("Verify: uses lambda with map")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val numbers = [1, 2, 3]
            val doubled = numbers.map(_ * 2)
            expect(doubled).to_equal([2, 4, 6])

        it "uses lambda with filter":
            # @req: REQ-UNIT-LIB-020
            step("Verify: uses lambda with filter")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val numbers = [1, 2, 3, 4, 5, 6]
            val evens = numbers.filter(_ % 2 == 0)
            expect(evens).to_equal([2, 4, 6])

    context "closure capture (read-only)":
        it "captures outer variable":
            # @req: REQ-UNIT-LIB-021
            step("Verify: captures outer variable")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val factor = 3
            val multiply = \x: x * factor
            expect(multiply(5)).to_equal(15)  # oracle: expected value 15 is the behavior asserted by this regression spec

        it "captures multiple outer variables":
            # @req: REQ-UNIT-LIB-022
            step("Verify: captures multiple outer variables")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val base = 10
            val offset = 5
            val compute = \x: x + base + offset
            expect(compute(1)).to_equal(16)  # oracle: expected value 16 is the behavior asserted by this regression spec

        it "captures string variable":
            # @req: REQ-UNIT-LIB-023
            step("Verify: captures string variable")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val prefix = "Hello"
            val greet = \name: "{prefix}, {name}!"
            expect(greet("World")).to_equal("Hello, World!")

    context "lambdas as values":
        it "stores lambda in val":
            # @req: REQ-UNIT-LIB-024
            step("Verify: stores lambda in val")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val fn_val = \: 42
            expect(fn_val()).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

        it "passes lambda to function":
            # @req: REQ-UNIT-LIB-025
            step("Verify: passes lambda to function")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn apply(f, x):
                f(x)
            val result = apply(\x: x * 10, 5)
            expect(result).to_equal(50)  # oracle: expected value 50 is the behavior asserted by this regression spec

# ============================================================================
# Feature #2: Parser Basics
# ============================================================================

describe "Feature #2 - Parser":
    # ## Parser Functionality
    #
    # Transforms token stream into Abstract Syntax Tree (AST). Uses recursive
    # descent for statements and Pratt parsing for expressions with operator
    # precedence. This validates that the parser correctly handles basic
    # language constructs.

    context "arithmetic expressions":
        it "parses addition":
            # @req: REQ-UNIT-LIB-026
            step("Verify: parses addition")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(1 + 2).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

        it "parses subtraction":
            # @req: REQ-UNIT-LIB-027
            step("Verify: parses subtraction")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(10 - 3).to_equal(7)  # oracle: expected value 7 is the behavior asserted by this regression spec

        it "parses multiplication":
            # @req: REQ-UNIT-LIB-028
            step("Verify: parses multiplication")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(4 * 5).to_equal(20)  # oracle: expected value 20 is the behavior asserted by this regression spec

        it "parses division":
            # @req: REQ-UNIT-LIB-029
            step("Verify: parses division")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(10 / 2).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

        it "parses modulo":
            # @req: REQ-UNIT-LIB-030
            step("Verify: parses modulo")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(10 % 3).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "parses operator precedence":
            # @req: REQ-UNIT-LIB-031
            step("Verify: parses operator precedence")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Multiplication before addition
            expect(2 + 3 * 4).to_equal(14)  # oracle: expected value 14 is the behavior asserted by this regression spec

        it "parses parenthesized expressions":
            # @req: REQ-UNIT-LIB-032
            step("Verify: parses parenthesized expressions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect((2 + 3) * 4).to_equal(20)  # oracle: expected value 20 is the behavior asserted by this regression spec

    context "comparison expressions":
        it "parses equality":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-UNIT-LIB-033
            step("Verify: parses equality")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "parses inequality":
            # @req: REQ-UNIT-LIB-034
            step("Verify: parses inequality")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(1 != 2).to_equal(true)

        it "parses less than":
            # @req: REQ-UNIT-LIB-035
            step("Verify: parses less than")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(1 < 2).to_equal(true)

        it "parses greater than":
            # @req: REQ-UNIT-LIB-036
            step("Verify: parses greater than")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(2 > 1).to_equal(true)

        it "parses less than or equal":
            # @req: REQ-UNIT-LIB-037
            step("Verify: parses less than or equal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(1 <= 1).to_equal(true)

        it "parses greater than or equal":
            # @req: REQ-UNIT-LIB-038
            step("Verify: parses greater than or equal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(2 >= 2).to_equal(true)

    context "logical expressions":
        it "parses and":
            # @req: REQ-UNIT-LIB-039
            step("Verify: parses and")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(true and true).to_equal(true)
            expect(true and false).to_equal(false)

        it "parses or":
            # @req: REQ-UNIT-LIB-040
            step("Verify: parses or")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(false or true).to_equal(true)
            expect(false or false).to_equal(false)

        it "parses not":
            # @req: REQ-UNIT-LIB-041
            step("Verify: parses not")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(not false).to_equal(true)
            expect(not true).to_equal(false)

    context "string expressions":
        it "parses string literals":
            # @req: REQ-UNIT-LIB-042
            step("Verify: parses string literals")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val s = "hello"
            expect(s).to_equal("hello")

        it "parses string interpolation":
            # @req: REQ-UNIT-LIB-043
            step("Verify: parses string interpolation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val name = "world"
            val msg = "hello {name}"
            expect(msg).to_equal("hello world")

        it "parses string concatenation":
            # @req: REQ-UNIT-LIB-044
            step("Verify: parses string concatenation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val a = "foo"
            val b = "bar"
            expect(a + b).to_equal("foobar")

    context "control flow parsing":
        it "parses if/else":
            # @req: REQ-UNIT-LIB-045
            step("Verify: parses if/else")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val result = if true: "yes" else: "no"
            expect(result).to_equal("yes")

        it "parses for loop":
            # @req: REQ-UNIT-LIB-046
            step("Verify: parses for loop")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var sum = 0
            for i in [1, 2, 3]:
                sum = sum + i
            expect(sum).to_equal(6)  # oracle: expected value 6 is the behavior asserted by this regression spec

        it "parses while loop":
            # @req: REQ-UNIT-LIB-047
            step("Verify: parses while loop")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn run_while_loop() -> i64:
                var count = 0
                while count < 3:
                    count = count + 1
                count
            expect(run_while_loop()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    context "function definitions":
        it "parses function with return value":
            # @req: REQ-UNIT-LIB-048
            step("Verify: parses function with return value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn square(x):
                x * x
            expect(square(5)).to_equal(25)  # oracle: expected value 25 is the behavior asserted by this regression spec

        it "parses function with multiple parameters":
            # @req: REQ-UNIT-LIB-049
            step("Verify: parses function with multiple parameters")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn add_three(a, b, c):
                a + b + c
            expect(add_three(1, 2, 3)).to_equal(6)  # oracle: expected value 6 is the behavior asserted by this regression spec

    context "collection literals":
        it "parses array literals":
            # @req: REQ-UNIT-LIB-050
            step("Verify: parses array literals")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val arr = [10, 20, 30]
            expect(arr.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
            expect(arr[0]).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec

        it "parses empty array":
            # @req: REQ-UNIT-LIB-051
            step("Verify: parses empty array")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val empty = []
            expect(empty.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "parses dictionary literals":
            # @req: REQ-UNIT-LIB-052
            step("Verify: parses dictionary literals")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val dict = {"key": "value"}
            expect(dict["key"]).to_equal("value")
