        it "converts x":
            # @req REQ-SSPEC-UNIT
            step("converts x")
            expect(subscript_char("x")).to_equal("\u2093")

        it "converts h":
            # @req REQ-SSPEC-UNIT
            step("converts h")
            expect(subscript_char("h")).to_equal("\u2095")

        it "converts k":
            # @req REQ-SSPEC-UNIT
            step("converts k")
            expect(subscript_char("k")).to_equal("\u2096")

        it "converts l":
            # @req REQ-SSPEC-UNIT
            step("converts l")
