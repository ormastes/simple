# 3. unicode_math — Subscript
# ============================================================================

describe "unicode_math subscript":
    """
    ## Subscript Conversion

    Tests single-character and multi-character subscript conversion.
    Covers digits, operators, letters, and fallback.
    """

    context "subscript_char digits":
        it "converts 0":
            # @req REQ-SSPEC-UNIT
            step("converts 0")
            expect(subscript_char("0")).to_equal("\u2080")

        it "converts 1":
            # @req REQ-SSPEC-UNIT
            step("converts 1")
            expect(subscript_char("1")).to_equal("\u2081")

        it "converts 2":
            # @req REQ-SSPEC-UNIT
            step("converts 2")
            expect(subscript_char("2")).to_equal("\u2082")

        it "converts 3":
            # @req REQ-SSPEC-UNIT
            step("converts 3")
            expect(subscript_char("3")).to_equal("\u2083")

        it "converts 4":
            # @req REQ-SSPEC-UNIT
            step("converts 4")
            expect(subscript_char("4")).to_equal("\u2084")

        it "converts 5":
            # @req REQ-SSPEC-UNIT
            step("converts 5")
            expect(subscript_char("5")).to_equal("\u2085")

        it "converts 6":
            # @req REQ-SSPEC-UNIT
            step("converts 6")
            expect(subscript_char("6")).to_equal("\u2086")

        it "converts 7":
            # @req REQ-SSPEC-UNIT
            step("converts 7")
            expect(subscript_char("7")).to_equal("\u2087")

        it "converts 8":
            # @req REQ-SSPEC-UNIT
            step("converts 8")
            expect(subscript_char("8")).to_equal("\u2088")

        it "converts 9":
            # @req REQ-SSPEC-UNIT
