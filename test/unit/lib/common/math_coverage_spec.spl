# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @covers src/lib/common/unicode_math.spl 80%
"""
# Unicode Math Greek/Superscript/Subscript Coverage Specification

**Feature IDs:** #LIB-MATH-COV
**Category:** Stdlib
**Difficulty:** 2/5
**Status:** Implemented
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A

## Overview

Branch coverage tests for `std.unicode_math` greek, superscript, and subscript
lookup functions. Split from the original monolithic spec for memory safety.
See also: math_symbols_coverage_spec.spl and math_repr_coverage_spec.spl.

## Key Concepts

| Concept | Description |
|---------|-------------|
| unicode_math | Lookup tables: greek, superscript, subscript |
"""

use std.spec.step

use std.unicode_math.{greek, greek_upper, superscript_char, subscript_char}
use std.unicode_math.{superscript, subscript}

# ============================================================================
# 1. unicode_math — Greek Letters
# ============================================================================

describe "unicode_math greek":
    # @manual scenario evidence
    """
    ## Greek Letter Lookup

    Tests lowercase and uppercase Greek letter conversion.
    Each branch returns a specific Unicode character; the fallback returns name unchanged.
    """

    context "lowercase greek letters":
        it "converts alpha":
            # @req REQ-SSPEC-UNIT
            step("converts alpha")
            expect(greek("alpha")).to_equal("\u03B1")

        it "converts beta":
            # @req REQ-SSPEC-UNIT
            step("converts beta")
            expect(greek("beta")).to_equal("\u03B2")

        it "converts gamma":
            # @req REQ-SSPEC-UNIT
            step("converts gamma")
            expect(greek("gamma")).to_equal("\u03B3")

        it "converts delta":
            # @req REQ-SSPEC-UNIT
            step("converts delta")
            expect(greek("delta")).to_equal("\u03B4")

        it "converts epsilon":
            # @req REQ-SSPEC-UNIT
            step("converts epsilon")
            expect(greek("epsilon")).to_equal("\u03B5")

        it "converts zeta":
            # @req REQ-SSPEC-UNIT
            step("converts zeta")
            expect(greek("zeta")).to_equal("\u03B6")

        it "converts eta":
            # @req REQ-SSPEC-UNIT
            step("converts eta")
            expect(greek("eta")).to_equal("\u03B7")

        it "converts theta":
            # @req REQ-SSPEC-UNIT
            step("converts theta")
            expect(greek("theta")).to_equal("\u03B8")

        it "converts iota":
            # @req REQ-SSPEC-UNIT
            step("converts iota")
            expect(greek("iota")).to_equal("\u03B9")

        it "converts kappa":
            # @req REQ-SSPEC-UNIT
            step("converts kappa")
            expect(greek("kappa")).to_equal("\u03BA")

        it "converts lambda":
            # @req REQ-SSPEC-UNIT
            step("converts lambda")
            expect(greek("lambda")).to_equal("\u03BB")

        it "converts mu":
            # @req REQ-SSPEC-UNIT
            step("converts mu")
            expect(greek("mu")).to_equal("\u03BC")

        it "converts nu":
            # @req REQ-SSPEC-UNIT
            step("converts nu")
            expect(greek("nu")).to_equal("\u03BD")

        it "converts xi":
            # @req REQ-SSPEC-UNIT
            step("converts xi")
            expect(greek("xi")).to_equal("\u03BE")

        it "converts omicron":
            # @req REQ-SSPEC-UNIT
            step("converts omicron")
            expect(greek("omicron")).to_equal("\u03BF")

        it "converts pi":
            # @req REQ-SSPEC-UNIT
            step("converts pi")
            expect(greek("pi")).to_equal("\u03C0")

        it "converts rho":
            # @req REQ-SSPEC-UNIT
            step("converts rho")
            expect(greek("rho")).to_equal("\u03C1")

        it "converts sigma":
            # @req REQ-SSPEC-UNIT
            step("converts sigma")
            expect(greek("sigma")).to_equal("\u03C3")

        it "converts tau":
            # @req REQ-SSPEC-UNIT
            step("converts tau")
            expect(greek("tau")).to_equal("\u03C4")

        it "converts upsilon":
            # @req REQ-SSPEC-UNIT
            step("converts upsilon")
            expect(greek("upsilon")).to_equal("\u03C5")

        it "converts phi":
            # @req REQ-SSPEC-UNIT
            step("converts phi")
            expect(greek("phi")).to_equal("\u03C6")

        it "converts chi":
            # @req REQ-SSPEC-UNIT
            step("converts chi")
            expect(greek("chi")).to_equal("\u03C7")

        it "converts psi":
            # @req REQ-SSPEC-UNIT
            step("converts psi")
            expect(greek("psi")).to_equal("\u03C8")

        it "converts omega":
            # @req REQ-SSPEC-UNIT
            step("converts omega")
            expect(greek("omega")).to_equal("\u03C9")

    context "variant greek forms":
        it "converts varepsilon":
            # @req REQ-SSPEC-UNIT
            step("converts varepsilon")
            expect(greek("varepsilon")).to_equal("\u03F5")

        it "converts vartheta":
            # @req REQ-SSPEC-UNIT
            step("converts vartheta")
            expect(greek("vartheta")).to_equal("\u03D1")

        it "converts varphi":
            # @req REQ-SSPEC-UNIT
            step("converts varphi")
            expect(greek("varphi")).to_equal("\u03D5")

        it "converts varrho":
            # @req REQ-SSPEC-UNIT
            step("converts varrho")
            expect(greek("varrho")).to_equal("\u03F1")

        it "converts varpi":
            # @req REQ-SSPEC-UNIT
            step("converts varpi")
            expect(greek("varpi")).to_equal("\u03D6")

        it "converts varkappa":
            # @req REQ-SSPEC-UNIT
            step("converts varkappa")
            expect(greek("varkappa")).to_equal("\u03F0")

        it "converts partial":
            # @req REQ-SSPEC-UNIT
            step("converts partial")
            expect(greek("partial")).to_equal("\u2202")

        it "converts nabla":
            # @req REQ-SSPEC-UNIT
            step("converts nabla")
            expect(greek("nabla")).to_equal("\u2207")

    context "fallback for unknown names":
        it "returns name unchanged for unknown greek":
            # @req REQ-SSPEC-UNIT
            step("returns name unchanged for unknown greek")
            expect(greek("notgreek")).to_equal("notgreek")

        it "returns empty string unchanged":
            # @req REQ-SSPEC-UNIT
            step("returns empty string unchanged")
            expect(greek("")).to_equal("")

    context "uppercase greek letters":
        it "converts Gamma":
            # @req REQ-SSPEC-UNIT
            step("converts Gamma")
            expect(greek_upper("Gamma")).to_equal("\u0393")

        it "converts Delta":
            # @req REQ-SSPEC-UNIT
            step("converts Delta")
            expect(greek_upper("Delta")).to_equal("\u0394")

        it "converts Theta":
            # @req REQ-SSPEC-UNIT
            step("converts Theta")
            expect(greek_upper("Theta")).to_equal("\u0398")

        it "converts Lambda":
            # @req REQ-SSPEC-UNIT
            step("converts Lambda")
            expect(greek_upper("Lambda")).to_equal("\u039B")

        it "converts Xi":
            # @req REQ-SSPEC-UNIT
            step("converts Xi")
            expect(greek_upper("Xi")).to_equal("\u039E")

        it "converts Pi":
            # @req REQ-SSPEC-UNIT
            step("converts Pi")
            expect(greek_upper("Pi")).to_equal("\u03A0")

        it "converts Sigma":
            # @req REQ-SSPEC-UNIT
            step("converts Sigma")
            expect(greek_upper("Sigma")).to_equal("\u03A3")

        it "converts Upsilon":
            # @req REQ-SSPEC-UNIT
            step("converts Upsilon")
            expect(greek_upper("Upsilon")).to_equal("\u03A5")

        it "converts Phi":
            # @req REQ-SSPEC-UNIT
            step("converts Phi")
            expect(greek_upper("Phi")).to_equal("\u03A6")

        it "converts Psi":
            # @req REQ-SSPEC-UNIT
            step("converts Psi")
            expect(greek_upper("Psi")).to_equal("\u03A8")

        it "converts Omega":
            # @req REQ-SSPEC-UNIT
            step("converts Omega")
            expect(greek_upper("Omega")).to_equal("\u03A9")

        it "returns unknown uppercase unchanged":
            # @req REQ-SSPEC-UNIT
            step("returns unknown uppercase unchanged")
            expect(greek_upper("NotUpper")).to_equal("NotUpper")


# ============================================================================
# 2. unicode_math — Superscript
# ============================================================================

describe "unicode_math superscript":
    """
    ## Superscript Conversion

    Tests single-character and multi-character superscript conversion.
    Covers digits 0-9, operators, letters, and the fallback branch.
    """

    context "superscript_char digits":
        it "converts 0":
            # @req REQ-SSPEC-UNIT
            step("converts 0")
            expect(superscript_char("0")).to_equal("\u2070")

        it "converts 1":
            # @req REQ-SSPEC-UNIT
            step("converts 1")
            expect(superscript_char("1")).to_equal("\u00B9")

        it "converts 2":
            # @req REQ-SSPEC-UNIT
            step("converts 2")
            expect(superscript_char("2")).to_equal("\u00B2")

        it "converts 3":
            # @req REQ-SSPEC-UNIT
            step("converts 3")
            expect(superscript_char("3")).to_equal("\u00B3")

        it "converts 4":
            # @req REQ-SSPEC-UNIT
            step("converts 4")
            expect(superscript_char("4")).to_equal("\u2074")

        it "converts 5":
            # @req REQ-SSPEC-UNIT
            step("converts 5")
            expect(superscript_char("5")).to_equal("\u2075")

        it "converts 6":
            # @req REQ-SSPEC-UNIT
            step("converts 6")
            expect(superscript_char("6")).to_equal("\u2076")

        it "converts 7":
            # @req REQ-SSPEC-UNIT
            step("converts 7")
            expect(superscript_char("7")).to_equal("\u2077")

        it "converts 8":
            # @req REQ-SSPEC-UNIT
            step("converts 8")
            expect(superscript_char("8")).to_equal("\u2078")

        it "converts 9":
            # @req REQ-SSPEC-UNIT
            step("converts 9")
            expect(superscript_char("9")).to_equal("\u2079")

    context "superscript_char operators and letters":
        it "converts plus":
            # @req REQ-SSPEC-UNIT
            step("converts plus")
            expect(superscript_char("+")).to_equal("\u207A")

        it "converts minus":
            # @req REQ-SSPEC-UNIT
            step("converts minus")
            expect(superscript_char("-")).to_equal("\u207B")

        it "converts equals":
            # @req REQ-SSPEC-UNIT
            step("converts equals")
            expect(superscript_char("=")).to_equal("\u207C")

        it "converts left paren":
            # @req REQ-SSPEC-UNIT
            step("converts left paren")
            expect(superscript_char("(")).to_equal("\u207D")

        it "converts right paren":
            # @req REQ-SSPEC-UNIT
            step("converts right paren")
            expect(superscript_char(")")).to_equal("\u207E")

        it "converts n":
            # @req REQ-SSPEC-UNIT
            step("converts n")
            expect(superscript_char("n")).to_equal("\u207F")

        it "converts i":
            # @req REQ-SSPEC-UNIT
            step("converts i")
            expect(superscript_char("i")).to_equal("\u2071")

        it "converts x":
            # @req REQ-SSPEC-UNIT
            step("converts x")
            expect(superscript_char("x")).to_equal("\u02E3")

    context "superscript_char fallback":
        it "returns unknown char unchanged":
            # @req REQ-SSPEC-UNIT
            step("returns unknown char unchanged")
            expect(superscript_char("z")).to_equal("z")

        it "returns q unchanged":
            # @req REQ-SSPEC-UNIT
            step("returns q unchanged")
            expect(superscript_char("q")).to_equal("q")

    context "superscript multi-char string":
        it "converts digit string 23":
            # @req REQ-SSPEC-UNIT
            step("converts digit string 23")
            val result = superscript("23")
            expect(result).to_contain("\u00B2")
            expect(result).to_contain("\u00B3")

        it "converts mixed n+1":
            # @req REQ-SSPEC-UNIT
            step("converts mixed n+1")
            val result = superscript("n+1")
            expect(result).to_contain("\u207F")
            expect(result).to_contain("\u207A")
            expect(result).to_contain("\u00B9")

        it "handles empty string":
            # @req REQ-SSPEC-UNIT
            step("handles empty string")
            expect(superscript("")).to_equal("")


