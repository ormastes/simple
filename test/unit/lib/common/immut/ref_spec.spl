"""
## Purpose and audience
Purpose: Prove that Ref.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# Ref -- Validated Atom Wrapper Tests
#
# Tests for the Ref class from nogc_async_immut/ref.
# Ref wraps an Atom and adds a validator function that gates
# every state transition. If the validator rejects a proposed
# value, the transition is rejected and the old value preserved.

use lib.ref.{Ref, Ref__new, Ref__of, Ref__unvalidated}

use std.spec.step

describe "Ref":

    # ========================================================================
    # Creation
    # ========================================================================

    describe "creation":
        it "creates with valid initial value":
            step("Verify: creates with valid initial value")
            # @req: REQ-LIB-COMMON-001
            val r = Ref.new(10, _1 > 0)
            expect(r.deref()).to_equal(10)  # oracle: 10 — named expected value from the requirement

        it "returns nil when initial value fails validation":
            step("Verify: returns nil when initial value fails validation")
            val r = Ref.new(-5, _1 > 0)
            expect(r).to_be_nil()

        it "creates with zero when validator accepts zero":
            step("Verify: creates with zero when validator accepts zero")
            val r = Ref.new(0, _1 >= 0)
            expect(r.deref()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "Ref__of is alias for Ref__new":
            step("Verify: Ref__of is alias for Ref__new")
            val r = Ref.of(42, _1 > 0)
            expect(r.deref()).to_equal(42)  # oracle: 42 — named expected value from the requirement

        it "Ref__of returns nil on invalid initial":
            step("Verify: Ref__of returns nil on invalid initial")
            val r = Ref.of(-1, _1 > 0)
            expect(r).to_be_nil()

        it "Ref__unvalidated creates without constraint":
            step("Verify: Ref__unvalidated creates without constraint")
            val r = Ref.unvalidated(0)
            expect(r.deref()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "Ref__unvalidated accepts any value":
            step("Verify: Ref__unvalidated accepts any value")
            val r = Ref.unvalidated(-999)
            expect(r.deref()).to_equal(-999)  # oracle: -999 — named expected value from the requirement

        it "Ref__unvalidated accepts nil":
            step("Verify: Ref__unvalidated accepts nil")
            val r = Ref.unvalidated(nil)
            expect(r.deref()).to_be_nil()

    # ========================================================================
    # Read operations
    # ========================================================================

    describe "deref":
        it "returns current value":
            step("Verify: returns current value")
            val r = Ref.new(100, _1 > 0)
            expect(r.deref()).to_equal(100)  # oracle: 100 — named expected value from the requirement

        it "returns same value on repeated reads":
            step("Verify: returns same value on repeated reads")
            val r = Ref.new(55, _1 > 0)
            expect(r.deref()).to_equal(55)  # oracle: 55 — named expected value from the requirement
            expect(r.deref()).to_equal(55)  # oracle: 55 — named expected value from the requirement

    describe "version":
        it "starts at 0":
            step("Verify: starts at 0")
            val r = Ref.new(1, _1 > 0)
            expect(r.version()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "unvalidated also starts at 0":
            step("Verify: unvalidated also starts at 0")
            val r = Ref.unvalidated(42)
            expect(r.version()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    describe "is_valid":
        it "returns true for valid value":
            step("Verify: returns true for valid value")
            val r = Ref.new(10, _1 > 0)
            expect(r.is_valid(5)).to_equal(true)

        it "returns false for invalid value":
            step("Verify: returns false for invalid value")
            val r = Ref.new(10, _1 > 0)
            expect(r.is_valid(-1)).to_equal(false)

        it "does not modify the ref":
            step("Verify: does not modify the ref")
            val r = Ref.new(10, _1 > 0)
            r.is_valid(999)
            expect(r.deref()).to_equal(10)  # oracle: 10 — named expected value from the requirement

    # ========================================================================
    # swap
    # ========================================================================

    describe "swap":
        it "applies function when result is valid":
            step("Verify: applies function when result is valid")
            var r = Ref.new(10, _1 > 0)
            val result = r.swap(_1 + 5)
            expect(result).to_equal(15)  # oracle: 15 — named expected value from the requirement
            expect(r.deref()).to_equal(15)  # oracle: 15 — named expected value from the requirement

        it "returns old value when result is invalid":
            step("Verify: returns old value when result is invalid")
            var r = Ref.new(10, _1 > 0)
            val result = r.swap(_1 - 100)
            expect(result).to_equal(10)  # oracle: 10 — named expected value from the requirement
            expect(r.deref()).to_equal(10)  # oracle: 10 — named expected value from the requirement

        it "increments version on valid swap":
            step("Verify: increments version on valid swap")
            var r = Ref.new(1, _1 > 0)
            r.swap(_1 + 1)
            expect(r.version()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "does not increment version on invalid swap":
            step("Verify: does not increment version on invalid swap")
            var r = Ref.new(5, _1 > 0)
            r.swap(_1 - 100)
            expect(r.version()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "identity function succeeds":
            step("Verify: identity function succeeds")
            var r = Ref.new(42, _1 > 0)
            val result = r.swap(\x: x)
            expect(result).to_equal(42)  # oracle: 42 — named expected value from the requirement

    # ========================================================================
    # reset
    # ========================================================================

    describe "reset":
        it "sets new value when valid":
            step("Verify: sets new value when valid")
            var r = Ref.new(10, _1 > 0)
            val result = r.reset(99)
            expect(result).to_equal(99)  # oracle: 99 — named expected value from the requirement
            expect(r.deref()).to_equal(99)  # oracle: 99 — named expected value from the requirement

        it "returns current value when invalid":
            step("Verify: returns current value when invalid")
            var r = Ref.new(10, _1 > 0)
            val result = r.reset(-5)
            expect(result).to_equal(10)  # oracle: 10 — named expected value from the requirement
            expect(r.deref()).to_equal(10)  # oracle: 10 — named expected value from the requirement

        it "increments version on valid reset":
            step("Verify: increments version on valid reset")
            var r = Ref.new(1, _1 > 0)
            r.reset(50)
            expect(r.version()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "does not increment version on invalid reset":
            step("Verify: does not increment version on invalid reset")
            var r = Ref.new(1, _1 > 0)
            r.reset(-1)
            expect(r.version()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # ========================================================================
    # compare_and_set
    # ========================================================================

    describe "compare_and_set":
        it "succeeds when expected matches and value is valid":
            step("Verify: succeeds when expected matches and value is valid")
            var r = Ref.new(10, _1 > 0)
            val ok = r.compare_and_set(10, 20)
            expect(ok).to_equal(true)
            expect(r.deref()).to_equal(20)  # oracle: 20 — named expected value from the requirement

        it "fails when expected does not match":
            step("Verify: fails when expected does not match")
            var r = Ref.new(10, _1 > 0)
            val ok = r.compare_and_set(5, 20)
            expect(ok).to_equal(false)
            expect(r.deref()).to_equal(10)  # oracle: 10 — named expected value from the requirement

        it "fails when new value is invalid":
            step("Verify: fails when new value is invalid")
            var r = Ref.new(10, _1 > 0)
            val ok = r.compare_and_set(10, -5)
            expect(ok).to_equal(false)
            expect(r.deref()).to_equal(10)  # oracle: 10 — named expected value from the requirement

        it "increments version on success":
            step("Verify: increments version on success")
            var r = Ref.new(10, _1 > 0)
            r.compare_and_set(10, 20)
            expect(r.version()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "does not increment version on failure":
            step("Verify: does not increment version on failure")
            var r = Ref.new(10, _1 > 0)
            r.compare_and_set(10, -1)
            expect(r.version()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # ========================================================================
    # swap_validated
    # ========================================================================

    describe "swap_validated":
        it "returns success pair on valid transition":
            step("Verify: returns success pair on valid transition")
            var r = Ref.new(10, _1 > 0)
            val result = r.swap_validated(_1 * 2)
            expect(result[0]).to_equal(true)
            expect(result[1]).to_equal(20)  # oracle: 20 — named expected value from the requirement

        it "returns failure pair on invalid transition":
            step("Verify: returns failure pair on invalid transition")
            var r = Ref.new(10, _1 > 0)
            val result = r.swap_validated(_1 - 100)
            expect(result[0]).to_equal(false)
            expect(result[1]).to_equal(10)  # oracle: 10 — named expected value from the requirement

        it "updates deref on success":
            step("Verify: updates deref on success")
            var r = Ref.new(5, _1 > 0)
            r.swap_validated(_1 + 10)
            expect(r.deref()).to_equal(15)  # oracle: 15 — named expected value from the requirement

        it "preserves deref on failure":
            step("Verify: preserves deref on failure")
            var r = Ref.new(5, _1 > 0)
            r.swap_validated(_1 - 100)
            expect(r.deref()).to_equal(5)  # oracle: 5 — named expected value from the requirement

    # ========================================================================
    # Multiple operations
    # ========================================================================

    describe "multiple operations":
        it "tracks version across valid transitions":
            step("Verify: tracks version across valid transitions")
            var r = Ref.new(1, _1 > 0)
            r.swap(_1 + 1)
            r.reset(10)
            r.compare_and_set(10, 20)
            expect(r.version()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(r.deref()).to_equal(20)  # oracle: 20 — named expected value from the requirement

        it "rejected transitions do not advance version":
            step("Verify: rejected transitions do not advance version")
            var r = Ref.new(5, _1 > 0)
            r.swap(_1 - 100)
            r.reset(-1)
            r.compare_and_set(5, -10)
            expect(r.version()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(r.deref()).to_equal(5)  # oracle: 5 — named expected value from the requirement

    # ========================================================================
    # Unvalidated operations
    # ========================================================================

    describe "unvalidated":
        it "swap always succeeds":
            step("Verify: swap always succeeds")
            var r = Ref.unvalidated(10)
            val result = r.swap(_1 - 100)
            expect(result).to_equal(-90)  # oracle: -90 — named expected value from the requirement
            expect(r.deref()).to_equal(-90)  # oracle: -90 — named expected value from the requirement

        it "reset always succeeds":
            step("Verify: reset always succeeds")
            var r = Ref.unvalidated(0)
            r.reset(-999)
            expect(r.deref()).to_equal(-999)  # oracle: -999 — named expected value from the requirement

        it "compare_and_set succeeds when expected matches":
            step("Verify: compare_and_set succeeds when expected matches")
            var r = Ref.unvalidated(10)
            val ok = r.compare_and_set(10, -5)
            expect(ok).to_equal(true)
            expect(r.deref()).to_equal(-5)  # oracle: -5 — named expected value from the requirement
