"""
## Purpose and audience
Purpose: Prove that PersistentList.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# PersistentList — Cons List Tests
#
# Tests for the PersistentList class from nogc_async_immut/persistent_list.
# Immutable singly-linked list with structural sharing.
# O(1) prepend, O(1) head/tail, O(n) indexed access.

use lib.persistent_list.{PersistentList, PersistentList__empty, PersistentList__of, PersistentList__from_array}

use std.spec.step

describe "PersistentList":

    describe "empty list":
        it "has zero length":
            step("Verify: has zero length")
            # @req: REQ-LIB-COMMON-001
            val l = PersistentList.empty()
            expect(l.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "is empty":
            step("Verify: is empty")
            val l = PersistentList.empty()
            expect(l.is_empty()).to_equal(true)

        it "head is nil":
            step("Verify: head is nil")
            val l = PersistentList.empty()
            expect(l.head()).to_be_nil()

        it "tail is empty":
            step("Verify: tail is empty")
            val l = PersistentList.empty()
            val t = l.tail()
            expect(t.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(t.is_empty()).to_equal(true)

    describe "prepend":
        it "adds element to front":
            step("Verify: adds element to front")
            val l = PersistentList.empty().prepend(1)
            expect(l.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(l.head()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(l.is_empty()).to_equal(false)

        it "preserves order":
            step("Verify: preserves order")
            val l = PersistentList.empty().prepend(3).prepend(2).prepend(1)
            expect(l.head()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(l.get(1)).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(l.get(2)).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(l.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

        it "does not modify original":
            step("Verify: does not modify original")
            val l1 = PersistentList.empty().prepend(1)
            val l2 = l1.prepend(2)
            expect(l1.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(l1.head()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(l2.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(l2.head()).to_equal(2)  # oracle: 2 — named expected value from the requirement

        it "supports multiple branches from same base":
            step("Verify: supports multiple branches from same base")
            val base = PersistentList.empty().prepend(1)
            val branch_a = base.prepend(10)
            val branch_b = base.prepend(20)
            expect(base.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(branch_a.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(branch_b.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(branch_a.head()).to_equal(10)  # oracle: 10 — named expected value from the requirement
            expect(branch_b.head()).to_equal(20)  # oracle: 20 — named expected value from the requirement

    describe "PersistentList__of":
        it "builds list preserving order":
            step("Verify: builds list preserving order")
            val l = PersistentList.of([10, 20, 30])
            expect(l.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(l.head()).to_equal(10)  # oracle: 10 — named expected value from the requirement
            expect(l.get(1)).to_equal(20)  # oracle: 20 — named expected value from the requirement
            expect(l.get(2)).to_equal(30)  # oracle: 30 — named expected value from the requirement

        it "handles single element":
            step("Verify: handles single element")
            val l = PersistentList.of([42])
            expect(l.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(l.head()).to_equal(42)  # oracle: 42 — named expected value from the requirement

    describe "from_array":
        it "builds list from array":
            step("Verify: builds list from array")
            val l = PersistentList.from_array([5, 10, 15])
            expect(l.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(l.head()).to_equal(5)  # oracle: 5 — named expected value from the requirement
            expect(l.get(2)).to_equal(15)  # oracle: 15 — named expected value from the requirement

        it "empty array gives empty list":
            step("Verify: empty array gives empty list")
            val l = PersistentList.from_array([])
            expect(l.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(l.is_empty()).to_equal(true)

    describe "get":
        it "returns element at index":
            step("Verify: returns element at index")
            val l = PersistentList.of([5, 10, 15])
            expect(l.get(0)).to_equal(5)  # oracle: 5 — named expected value from the requirement
            expect(l.get(1)).to_equal(10)  # oracle: 10 — named expected value from the requirement
            expect(l.get(2)).to_equal(15)  # oracle: 15 — named expected value from the requirement

        it "returns nil for out of bounds":
            step("Verify: returns nil for out of bounds")
            val l = PersistentList.of([1, 2])
            expect(l.get(5)).to_be_nil()

        it "returns nil for negative index":
            step("Verify: returns nil for negative index")
            val l = PersistentList.of([1, 2])
            expect(l.get(-1)).to_be_nil()

    describe "contains":
        it "finds existing element":
            step("Verify: finds existing element")
            val l = PersistentList.of(["a", "b", "c"])
            expect(l.contains("b")).to_equal(true)

        it "returns false for missing element":
            step("Verify: returns false for missing element")
            val l = PersistentList.of(["a", "b", "c"])
            expect(l.contains("z")).to_equal(false)

        it "works with integers":
            step("Verify: works with integers")
            val l = PersistentList.of([1, 2, 3, 4, 5])
            expect(l.contains(3)).to_equal(true)
            expect(l.contains(6)).to_equal(false)

        it "returns false for empty list":
            step("Verify: returns false for empty list")
            val l = PersistentList.empty()
            expect(l.contains(1)).to_equal(false)

    describe "tail":
        it "returns rest of list":
            step("Verify: returns rest of list")
            val l = PersistentList.of([1, 2, 3])
            val t = l.tail()
            expect(t.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(t.head()).to_equal(2)  # oracle: 2 — named expected value from the requirement

        it "tail of single element is empty":
            step("Verify: tail of single element is empty")
            val l = PersistentList.of([42])
            val t = l.tail()
            expect(t.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(t.is_empty()).to_equal(true)

        it "chained tail calls":
            step("Verify: chained tail calls")
            val l = PersistentList.of([1, 2, 3])
            val t = l.tail().tail()
            expect(t.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(t.head()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    describe "head":
        it "returns first element":
            step("Verify: returns first element")
            val l = PersistentList.of([99, 88, 77])
            expect(l.head()).to_equal(99)  # oracle: 99 — named expected value from the requirement

        it "returns nil for empty":
            step("Verify: returns nil for empty")
            val l = PersistentList.empty()
            expect(l.head()).to_be_nil()

    describe "reverse":
        it "reverses the list":
            step("Verify: reverses the list")
            val l = PersistentList.of([1, 2, 3])
            val r = l.reverse()
            expect(r.head()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(r.get(1)).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(r.get(2)).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "preserves length":
            step("Verify: preserves length")
            val l = PersistentList.of([1, 2, 3, 4])
            val r = l.reverse()
            expect(r.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement

        it "reverse of single element is same":
            step("Verify: reverse of single element is same")
            val l = PersistentList.of([42])
            val r = l.reverse()
            expect(r.head()).to_equal(42)  # oracle: 42 — named expected value from the requirement
            expect(r.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "reverse of empty is empty":
            step("Verify: reverse of empty is empty")
            val l = PersistentList.empty()
            val r = l.reverse()
            expect(r.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "does not modify original":
            step("Verify: does not modify original")
            val l = PersistentList.of([1, 2, 3])
            val r = l.reverse()
            expect(l.head()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(r.head()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    describe "to_array":
        it "converts to array":
            step("Verify: converts to array")
            val l = PersistentList.of([10, 20, 30])
            val arr = l.to_array()
            expect(arr.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(arr[0]).to_equal(10)  # oracle: 10 — named expected value from the requirement
            expect(arr[1]).to_equal(20)  # oracle: 20 — named expected value from the requirement
            expect(arr[2]).to_equal(30)  # oracle: 30 — named expected value from the requirement

        it "empty list gives empty array":
            step("Verify: empty list gives empty array")
            val l = PersistentList.empty()
            val arr = l.to_array()
            expect(arr.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    describe "concat":
        it "joins two lists":
            step("Verify: joins two lists")
            val l1 = PersistentList.of([1, 2])
            val l2 = PersistentList.of([3, 4])
            val joined = l1.concat(l2)
            expect(joined.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
            expect(joined.head()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(joined.get(1)).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(joined.get(2)).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(joined.get(3)).to_equal(4)  # oracle: 4 — named expected value from the requirement

        it "concat with empty list":
            step("Verify: concat with empty list")
            val l1 = PersistentList.of([1, 2])
            val l2 = PersistentList.empty()
            val joined = l1.concat(l2)
            expect(joined.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(joined.head()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "empty concat with list":
            step("Verify: empty concat with list")
            val l1 = PersistentList.empty()
            val l2 = PersistentList.of([3, 4])
            val joined = l1.concat(l2)
            expect(joined.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(joined.head()).to_equal(3)  # oracle: 3 — named expected value from the requirement

        it "does not modify originals":
            step("Verify: does not modify originals")
            val l1 = PersistentList.of([1, 2])
            val l2 = PersistentList.of([3, 4])
            val joined = l1.concat(l2)
            expect(l1.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(l2.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(joined.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement

    describe "map":
        it "applies function to each element":
            step("Verify: applies function to each element")
            val l = PersistentList.of([1, 2, 3])
            val doubled = l.map(_1 * 2)
            expect(doubled.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(doubled.get(0)).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(doubled.get(1)).to_equal(4)  # oracle: 4 — named expected value from the requirement
            expect(doubled.get(2)).to_equal(6)  # oracle: 6 — named expected value from the requirement

        it "preserves length":
            step("Verify: preserves length")
            val l = PersistentList.of([10, 20, 30])
            val result = l.map(_1 + 1)
            expect(result.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

        it "empty list map is empty":
            step("Verify: empty list map is empty")
            val l = PersistentList.empty()
            val result = l.map(_1 * 2)
            expect(result.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    describe "filter":
        it "keeps matching elements":
            step("Verify: keeps matching elements")
            val l = PersistentList.of([1, 2, 3, 4, 5])
            val evens = l.filter(_1 % 2 == 0)
            expect(evens.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(evens.get(0)).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(evens.get(1)).to_equal(4)  # oracle: 4 — named expected value from the requirement

        it "returns empty when nothing matches":
            step("Verify: returns empty when nothing matches")
            val l = PersistentList.of([1, 3, 5])
            val evens = l.filter(_1 % 2 == 0)
            expect(evens.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "returns all when everything matches":
            step("Verify: returns all when everything matches")
            val l = PersistentList.of([2, 4, 6])
            val evens = l.filter(_1 % 2 == 0)
            expect(evens.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    describe "fold":
        it "accumulates sum":
            step("Verify: accumulates sum")
            val l = PersistentList.of([1, 2, 3, 4])
            val sum = l.fold(0, \acc, x: acc + x)
            expect(sum).to_equal(10)  # oracle: 10 — named expected value from the requirement

        it "accumulates product":
            step("Verify: accumulates product")
            val l = PersistentList.of([1, 2, 3, 4])
            val product = l.fold(1, \acc, x: acc * x)
            expect(product).to_equal(24)  # oracle: 24 — named expected value from the requirement

        it "returns init for empty list":
            step("Verify: returns init for empty list")
            val l = PersistentList.empty()
            val result = l.fold(42, \acc, x: acc + x)
            expect(result).to_equal(42)  # oracle: 42 — named expected value from the requirement

        it "single element":
            step("Verify: single element")
            val l = PersistentList.of([5])
            val result = l.fold(0, \acc, x: acc + x)
            expect(result).to_equal(5)  # oracle: 5 — named expected value from the requirement
