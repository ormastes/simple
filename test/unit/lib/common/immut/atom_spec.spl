"""
## Purpose and audience
Purpose: Prove that Atom.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# Atom — CAS Reference Tests
#
# Tests for the Atom class from nogc_async_immut/atom.
# Atom provides lock-free mutable reference to an immutable value
# using compare-and-swap semantics.

use lib.atom.{Atom, Atom__new, Atom__of}

use std.spec.step

describe "Atom":

    describe "creation":
        it "creates with initial value":
            step("Verify: creates with initial value")
            # @req: REQ-LIB-COMMON-001
            val a = Atom.new(42)
            expect(a.deref()).to_equal(42)  # oracle: 42 — named expected value from the requirement

        it "starts at version 0":
            step("Verify: starts at version 0")
            val a = Atom.new(0)
            expect(a.version()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "Atom__of is alias for Atom__new":
            step("Verify: Atom__of is alias for Atom__new")
            val a = Atom.of("hello")
            expect(a.deref()).to_equal("hello")

        it "creates with nil initial value":
            step("Verify: creates with nil initial value")
            val a = Atom.new(nil)
            expect(a.deref()).to_be_nil()

        it "creates with string value":
            step("Verify: creates with string value")
            val a = Atom.new("test")
            expect(a.deref()).to_equal("test")

    describe "deref":
        it "reads the current value":
            step("Verify: reads the current value")
            val a = Atom.new(100)
            expect(a.deref()).to_equal(100)  # oracle: 100 — named expected value from the requirement

        it "returns same value on repeated reads":
            step("Verify: returns same value on repeated reads")
            val a = Atom.new(77)
            expect(a.deref()).to_equal(77)  # oracle: 77 — named expected value from the requirement
            expect(a.deref()).to_equal(77)  # oracle: 77 — named expected value from the requirement

    describe "swap":
        it "applies function and returns new value":
            step("Verify: applies function and returns new value")
            var a = Atom.new(10)
            val result = a.swap(_1 + 5)
            expect(result).to_equal(15)  # oracle: 15 — named expected value from the requirement
            expect(a.deref()).to_equal(15)  # oracle: 15 — named expected value from the requirement

        it "increments version on swap":
            step("Verify: increments version on swap")
            var a = Atom.new(0)
            a.swap(_1 + 1)
            expect(a.version()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            a.swap(_1 + 1)
            expect(a.version()).to_equal(2)  # oracle: 2 — named expected value from the requirement

        it "applies multiplication":
            step("Verify: applies multiplication")
            var a = Atom.new(5)
            val result = a.swap(_1 * 3)
            expect(result).to_equal(15)  # oracle: 15 — named expected value from the requirement

        it "applies identity function":
            step("Verify: applies identity function")
            var a = Atom.new(42)
            val result = a.swap(\x: x)
            expect(result).to_equal(42)  # oracle: 42 — named expected value from the requirement
            expect(a.version()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    describe "reset":
        it "sets new value unconditionally":
            step("Verify: sets new value unconditionally")
            var a = Atom.new(1)
            a.reset(99)
            expect(a.deref()).to_equal(99)  # oracle: 99 — named expected value from the requirement

        it "increments version":
            step("Verify: increments version")
            var a = Atom.new(0)
            a.reset(42)
            expect(a.version()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "overwrites previous value":
            step("Verify: overwrites previous value")
            var a = Atom.new(10)
            a.reset(20)
            a.reset(30)
            expect(a.deref()).to_equal(30)  # oracle: 30 — named expected value from the requirement
            expect(a.version()).to_equal(2)  # oracle: 2 — named expected value from the requirement

        it "can reset to nil":
            step("Verify: can reset to nil")
            var a = Atom.new(42)
            a.reset(nil)
            expect(a.deref()).to_be_nil()

    describe "compare_and_set":
        it "succeeds when expected matches":
            step("Verify: succeeds when expected matches")
            var a = Atom.new(10)
            val ok = a.compare_and_set(10, 20)
            expect(ok).to_equal(true)
            expect(a.deref()).to_equal(20)  # oracle: 20 — named expected value from the requirement

        it "fails when expected does not match":
            step("Verify: fails when expected does not match")
            var a = Atom.new(10)
            val ok = a.compare_and_set(5, 20)
            expect(ok).to_equal(false)
            expect(a.deref()).to_equal(10)  # oracle: 10 — named expected value from the requirement

        it "does not increment version on failure":
            step("Verify: does not increment version on failure")
            var a = Atom.new(10)
            a.compare_and_set(999, 20)
            expect(a.version()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "increments version on success":
            step("Verify: increments version on success")
            var a = Atom.new(10)
            a.compare_and_set(10, 20)
            expect(a.version()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    describe "swap_returning_old":
        it "returns old value":
            step("Verify: returns old value")
            var a = Atom.new(100)
            val old = a.swap_returning_old(_1 * 2)
            expect(old).to_equal(100)  # oracle: 100 — named expected value from the requirement
            expect(a.deref()).to_equal(200)  # oracle: 200 — named expected value from the requirement

        it "increments version":
            step("Verify: increments version")
            var a = Atom.new(0)
            a.swap_returning_old(_1 + 1)
            expect(a.version()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "returns old on multiple swaps":
            step("Verify: returns old on multiple swaps")
            var a = Atom.new(1)
            val old1 = a.swap_returning_old(_1 + 10)
            val old2 = a.swap_returning_old(_1 + 10)
            expect(old1).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(old2).to_equal(11)  # oracle: 11 — named expected value from the requirement
            expect(a.deref()).to_equal(21)  # oracle: 21 — named expected value from the requirement

    describe "multiple operations":
        it "tracks version across operations":
            step("Verify: tracks version across operations")
            var a = Atom.new(0)
            a.swap(_1 + 1)
            a.reset(50)
            a.compare_and_set(50, 100)
            expect(a.version()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(a.deref()).to_equal(100)  # oracle: 100 — named expected value from the requirement

        it "failed CAS does not affect version":
            step("Verify: failed CAS does not affect version")
            var a = Atom.new(0)
            a.swap(_1 + 1)
            a.compare_and_set(999, 0)
            expect(a.version()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(a.deref()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "sequence of resets":
            step("Verify: sequence of resets")
            var a = Atom.new(0)
            a.reset(1)
            a.reset(2)
            a.reset(3)
            expect(a.deref()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(a.version()).to_equal(3)  # oracle: 3 — named expected value from the requirement
