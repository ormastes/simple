"""
## Purpose and audience
Purpose: Prove that Pooling Layers Integration.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# Integration test for pooling layers exported from nn.spl

use std.pure.tensor.{tensor_from_data}
use std.pure.nn.{MaxPool2d, AvgPool2d, maxpool2d_create, avgpool2d_create}

use std.spec.step

describe "Pooling Layers Integration":
    describe "Import from main nn module":
        it "can import MaxPool2d from nn":
            step("Verify: can import MaxPool2d from nn")
            # @req: REQ-LIB-COMMON-001
            val pool = MaxPool2d.create(kernel_size: 2, stride: 2, padding: 0)
            expect(pool.kernel_size).to_equal(2)  # oracle: 2 — named expected value from the requirement

        it "can import AvgPool2d from nn":
            step("Verify: can import AvgPool2d from nn")
            val pool = AvgPool2d.create(kernel_size: 2, stride: 2, padding: 0)
            expect(pool.kernel_size).to_equal(2)  # oracle: 2 — named expected value from the requirement

        it "can use maxpool2d_create factory":
            step("Verify: can use maxpool2d_create factory")
            val pool = maxpool2d_create(3, 1, 0)
            expect(pool.kernel_size).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(pool.stride).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "can use avgpool2d_create factory":
            step("Verify: can use avgpool2d_create factory")
            val pool = avgpool2d_create(3, 1, 0)
            expect(pool.kernel_size).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(pool.stride).to_equal(1)  # oracle: 1 — named expected value from the requirement

    describe "Usage with other nn layers":
        it "maxpool works in a simple pipeline":
            step("Verify: maxpool works in a simple pipeline")
            # Create a simple input
            val input = tensor_from_data([1.0, 2.0, 3.0, 4.0], [1, 1, 2, 2])

            # Apply maxpool
            val pool = MaxPool2d.create(kernel_size: 2, stride: 2, padding: 0)
            val output = pool.forward(input)

            # Check output
            expect(output.shape).to_equal([1, 1, 1, 1])
            expect(output.data[0]).to_equal(4.0)  # oracle: 4.0 — named expected value from the requirement

        it "avgpool works in a simple pipeline":
            step("Verify: avgpool works in a simple pipeline")
            # Create a simple input
            val input = tensor_from_data([1.0, 2.0, 3.0, 4.0], [1, 1, 2, 2])

            # Apply avgpool
            val pool = AvgPool2d.create(kernel_size: 2, stride: 2, padding: 0)
            val output = pool.forward(input)

            # Check output
            expect(output.shape).to_equal([1, 1, 1, 1])
            expect(output.data[0]).to_equal(2.5)  # oracle: 2.5 — named expected value from the requirement
