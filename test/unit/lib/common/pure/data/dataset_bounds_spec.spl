# Tests for ArrayDataset and LabeledDataset boundary behavior

"""
## Purpose and audience
Verifies the dataset bounds behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

use std.spec.step
use lib.pure.data.dataset.{ArrayDataset, LabeledDataset, LabeledSample}

# @req: REQ-DATA-DatasetBounds-001
describe "Dataset Bounds":
    describe "ArrayDataset":
        it "returns empty for negative index":
            # @req: REQ-DATA-DatasetBounds-001
            step("Verify: returns empty for negative index")
            val data = [[1.0, 2.0], [3.0, 4.0]]
            val ds = ArrayDataset(data: data)
            val result = ds.get_item(-1)
            expect(result.len()).to_equal(0)  # oracle: value fixed by the spec contract

        it "returns empty for out-of-bounds index":
            # @req: REQ-DATA-DatasetBounds-001
            step("Verify: returns empty for out-of-bounds index")
            val data = [[1.0, 2.0], [3.0, 4.0]]
            val ds = ArrayDataset(data: data)
            val result = ds.get_item(5)
            expect(result.len()).to_equal(0)  # oracle: value fixed by the spec contract

        it "returns valid item for in-bounds index":
            # @req: REQ-DATA-DatasetBounds-001
            step("Verify: returns valid item for in-bounds index")
            val data = [[1.0, 2.0], [3.0, 4.0]]
            val ds = ArrayDataset(data: data)
            val result = ds.get_item(0)
            expect(result.len()).to_equal(2)  # oracle: value fixed by the spec contract

        it "returns correct len":
            # @req: REQ-DATA-DatasetBounds-001
            step("Verify: returns correct len")
            val data = [[1.0], [2.0], [3.0]]
            val ds = ArrayDataset(data: data)
            expect(ds.len()).to_equal(3)  # oracle: value fixed by the spec contract

    describe "LabeledDataset":
        it "returns default sample for negative index":
            # @req: REQ-DATA-DatasetBounds-001
            step("Verify: returns default sample for negative index")
            val features = [[1.0, 2.0]]
            val labels = [0.0]
            val ds = LabeledDataset(features: features, labels: labels)
            val result = ds.get_item(-1)
            expect(result.feature.len()).to_equal(0)  # oracle: value fixed by the spec contract
            expect(result.label).to_equal(0.0)  # oracle: value fixed by the spec contract

        it "returns default sample for out-of-bounds index":
            # @req: REQ-DATA-DatasetBounds-001
            step("Verify: returns default sample for out-of-bounds index")
            val features = [[1.0, 2.0]]
            val labels = [0.0]
            val ds = LabeledDataset(features: features, labels: labels)
            val result = ds.get_item(10)
            expect(result.feature.len()).to_equal(0)  # oracle: value fixed by the spec contract
            expect(result.label).to_equal(0.0)  # oracle: value fixed by the spec contract

        it "returns valid sample for in-bounds index":
            # @req: REQ-DATA-DatasetBounds-001
            step("Verify: returns valid sample for in-bounds index")
            val features = [[1.0, 2.0], [3.0, 4.0]]
            val labels = [0.0, 1.0]
            val ds = LabeledDataset(features: features, labels: labels)
            val result = ds.get_item(1)
            expect(result.label).to_equal(1.0)  # oracle: value fixed by the spec contract

        it "returns correct len":
            # @req: REQ-DATA-DatasetBounds-001
            step("Verify: returns correct len")
            val features = [[1.0], [2.0]]
            val labels = [0.0, 1.0]
            val ds = LabeledDataset(features: features, labels: labels)
            expect(ds.len()).to_equal(2)  # oracle: value fixed by the spec contract
