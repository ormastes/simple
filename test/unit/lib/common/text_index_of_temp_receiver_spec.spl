# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, assert_equal}


# Regression pin for
# doc/08_tracking/bug/text_index_of_on_substring_receiver_reported_bool_2026-08-09.md
#
# THE CLASS: `index_of` called on a TEMPORARY receiver (the result of
# `substring(...)` / `trim()`) was reported to return a BOOL instead of the
# i64 offset. That is dangerous rather than merely wrong: a bool coerces to
# `1`, so a `colon > 0` guard still passes and the caller silently splits on
# offset 1 instead of failing loudly.
#
# Probe string: "\n  --radius-sm: 8px;\n" — the colon is at byte 14 in the
# whole string and at 11 in `substring(3, len())`.
describe "text.index_of on a temporary receiver":
    it "returns the offset, not a bool, on a named receiver":
        # @req REQ-SSPEC-UNIT
        step("named receiver is the control case")
        val body = "\n  --radius-sm: 8px;\n"
        assert_equal(body.index_of(":"), 14)
        assert_equal("{body.index_of(":")}", "14")

    it "returns the offset, not a bool, on a substring receiver":
        # @req REQ-SSPEC-UNIT
        step("substring(...) temporary is the reported failing shape")
        val body = "\n  --radius-sm: 8px;\n"
        val sub_offset = body.substring(3, body.len()).index_of(":")
        assert_equal(sub_offset, 11)
        # A bool would render as "true" here even though it compares > 0.
        assert_equal("{sub_offset}", "11")

    it "returns the offset, not a bool, on a trim receiver":
        # @req REQ-SSPEC-UNIT
        step("trim() temporary is the second reported shape")
        val body = "\n  --radius-sm: 8px;\n"
        val trim_offset = body.trim().index_of(":")
        assert_equal(trim_offset, 11)
        assert_equal("{trim_offset}", "11")

    it "splits a css declaration on a temporary-receiver offset":
        # @req REQ-SSPEC-UNIT
        step("the caller shape the bug report said produced garbage")
        val body = "\n  --radius-sm: 8px;\n"
        val line = body.substring(3, body.len()).trim()
        val colon = line.index_of(":")
        assert_equal(colon, 11)
        assert_equal(line.substring(0, colon), "--radius-sm")
        assert_equal(line.substring(colon + 1, line.len()).trim(), "8px;")
