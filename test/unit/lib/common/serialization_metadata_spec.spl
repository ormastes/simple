describe "int_to_hex":
    """
    ## Integer to Hex Conversion
    """

    it "converts zero":
        # @req: REQ-UNIT-LIB-088
        step("Verify: converts zero")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(int_to_hex(0)).to_equal("00")

    it "converts single digit":
        # @req: REQ-UNIT-LIB-089
        step("Verify: converts single digit")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(int_to_hex(10)).to_equal("0a")

    it "converts 255":
        # @req: REQ-UNIT-LIB-090
        step("Verify: converts 255")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(int_to_hex(255)).to_equal("ff")

    it "converts mid-range value":
        # @req: REQ-UNIT-LIB-091
        step("Verify: converts mid-range value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(int_to_hex(171)).to_equal("ab")

describe "bytes_to_hex":
    """
    ## Byte Array to Hex String
    """

    it "converts empty byte array":
        # @req: REQ-UNIT-LIB-092
        step("Verify: converts empty byte array")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(bytes_to_hex([])).to_equal("")

    it "converts single byte":
        # @req: REQ-UNIT-LIB-093
        step("Verify: converts single byte")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(bytes_to_hex([255])).to_equal("ff")

    it "converts multiple bytes":
        # @req: REQ-UNIT-LIB-094
        step("Verify: converts multiple bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(bytes_to_hex([0, 171, 255])).to_equal("00abff")

describe "hex_to_bytes":
    """
    ## Hex String to Byte Array

    Tests even-length, odd-length (trailing nibble), and empty.
    """

    it "converts empty hex string":
        # @req: REQ-UNIT-LIB-095
        step("Verify: converts empty hex string")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = hex_to_bytes("")
        expect(result.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "converts valid hex pairs":
        # @req: REQ-UNIT-LIB-096
        step("Verify: converts valid hex pairs")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = hex_to_bytes("00abff")
        expect(result.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
        expect(result[0]).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(result[1]).to_equal(171)  # oracle: expected value 171 is the behavior asserted by this regression spec
        expect(result[2]).to_equal(255)  # oracle: expected value 255 is the behavior asserted by this regression spec

    it "handles uppercase hex":
        # @req: REQ-UNIT-LIB-097
        step("Verify: handles uppercase hex")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = hex_to_bytes("AB")
        expect(result.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(result[0]).to_equal(171)  # oracle: expected value 171 is the behavior asserted by this regression spec

    it "handles odd-length hex string by skipping trailing nibble":
        # @req: REQ-UNIT-LIB-098
        step("Verify: handles odd-length hex string by skipping trailing nibble")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = hex_to_bytes("abc")
        expect(result.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(result[0]).to_equal(171)  # oracle: expected value 171 is the behavior asserted by this regression spec

    it "roundtrips with bytes_to_hex":
        # @req: REQ-UNIT-LIB-099
        step("Verify: roundtrips with bytes_to_hex")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val original = [0, 42, 255, 128]
        val roundtripped = hex_to_bytes(bytes_to_hex(original))
        expect(deep_equal_list_int(original, roundtripped)).to_equal(true)

