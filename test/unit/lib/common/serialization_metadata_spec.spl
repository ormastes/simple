# Test Group 20: Byte Array Utilities (utilities.spl)
# ============================================================================

describe "write_bytes":
    """
    ## Byte Array Writing
    """

    it "prepends length as varint":
        # @req: REQ-UNIT-LIB-082
        step("Verify: prepends length as varint")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = write_bytes([10, 20, 30])
        expect(result[0]).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
        expect(result.len()).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

    it "writes empty byte array":
        # @req: REQ-UNIT-LIB-083
        step("Verify: writes empty byte array")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = write_bytes([])
        expect(result[0]).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(result.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

describe "read_bytes":
    """
    ## Byte Array Reading

    Tests normal read, read beyond bounds, and empty read.
    """

    it "reads specified number of bytes":
        # @req: REQ-UNIT-LIB-084
        step("Verify: reads specified number of bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val data = [10, 20, 30, 40, 50]
        val result = read_bytes(data, 1, 3)
        val bytes = result.0
        expect(bytes.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
        expect(bytes[0]).to_equal(20)  # oracle: expected value 20 is the behavior asserted by this regression spec
        expect(bytes[1]).to_equal(30)  # oracle: expected value 30 is the behavior asserted by this regression spec
        expect(bytes[2]).to_equal(40)  # oracle: expected value 40 is the behavior asserted by this regression spec

    it "handles read beyond array bounds":
        # @req: REQ-UNIT-LIB-085
        step("Verify: handles read beyond array bounds")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val data = [10, 20]
        val result = read_bytes(data, 0, 5)
        val bytes = result.0
        expect(bytes.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    it "reads zero bytes":
        # @req: REQ-UNIT-LIB-086
        step("Verify: reads zero bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = read_bytes([1, 2, 3], 0, 0)
        val bytes = result.0
        expect(bytes.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

describe "read_bytes_with_length":
    """
    ## Length-Prefixed Byte Reading

    Roundtrip test with write_bytes.
    """

    it "roundtrips with write_bytes":
        # @req: REQ-UNIT-LIB-087
        step("Verify: roundtrips with write_bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val original = [65, 66, 67]
        val written = write_bytes(original)
        val result = read_bytes_with_length(written, 0)
        val data = result.0
        val consumed = result.1
        expect(data.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
        expect(data[0]).to_equal(65)  # oracle: expected value 65 is the behavior asserted by this regression spec
        expect(data[1]).to_equal(66)  # oracle: expected value 66 is the behavior asserted by this regression spec
        expect(data[2]).to_equal(67)  # oracle: expected value 67 is the behavior asserted by this regression spec

