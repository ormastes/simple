"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/common/serialization_metadata_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @covers src/lib/common/serialization/utilities.spl 70%
"""
# Serialization Metadata Coverage Specification

**Feature IDs:** #SERIAL-COV-METADATA
**Category:** Stdlib
**Difficulty:** 2/5
**Status:** Implemented

## Overview

Branch-coverage tests for metadata, tagging, versioning, schema, cloning, hashing,
compression/encryption markers, binary I/O, and hex encoding:
- Type tagging: tag_type, get_type_tag, strip_type_tag (utilities.spl)
- Schema validation: define_schema, validate_field_type (utilities.spl)
- Versioning: add_version, get_version, strip_version (utilities.spl)
- Deep cloning, equality, structural hashing (utilities.spl)
- Compression/encryption markers (utilities.spl)
- Binary I/O: write_bytes, read_bytes (serialize.spl)
- Hex encoding: int_to_hex, bytes_to_hex, hex_to_bytes (serialize.spl)
"""

use serialization.*
use std.spec.{step}

# ============================================================================
# Test Group 13: Type Tagging (utilities.spl)
# ============================================================================

describe "tag_type":
    """
    ## Type Tagging
    """

    it "wraps content with type annotation":
        # @req: REQ-UNIT-LIB-001
        step("Verify: wraps content with type annotation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = tag_type("payload", "MyType")
        expect(result).to_equal("@MyType\{payload\}")

describe "get_type_tag":
    """
    ## Type Tag Extraction

    Tests valid tagged, too short, missing @, no brace, and nil return.
    """

    it "extracts tag from tagged string":
        # @req: REQ-UNIT-LIB-002
        step("Verify: extracts tag from tagged string")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = get_type_tag("@MyType\{payload\}")
        expect(result).to_equal("MyType")

    it "returns nil for short string":
        # @req: REQ-UNIT-LIB-003
        step("Verify: returns nil for short string")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = get_type_tag("ab")
        expect(result).to_be_nil()

    it "returns nil when not starting with @":
        # @req: REQ-UNIT-LIB-004
        step("Verify: returns nil when not starting with @")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = get_type_tag("NoAt\{payload\}")
        expect(result).to_be_nil()

    it "returns nil when no opening brace":
        # @req: REQ-UNIT-LIB-005
        step("Verify: returns nil when no opening brace")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = get_type_tag("@NobraceHere")
        expect(result).to_be_nil()

describe "strip_type_tag":
    """
    ## Type Tag Stripping

    Tests tagged input, untagged input, and edge cases.
    """

    it "strips tag and returns inner content":
        # @req: REQ-UNIT-LIB-006
        step("Verify: strips tag and returns inner content")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = strip_type_tag("@MyType\{payload\}")
        expect(result).to_equal("payload")

    it "returns original when no tag present":
        # @req: REQ-UNIT-LIB-007
        step("Verify: returns original when no tag present")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = strip_type_tag("notatag")
        expect(result).to_equal("notatag")

    it "returns original for short input":
        # @req: REQ-UNIT-LIB-008
        step("Verify: returns original for short input")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = strip_type_tag("ab")
        expect(result).to_equal("ab")

# ============================================================================
# Test Group 14: Schema Validation (utilities.spl)
# ============================================================================

describe "define_schema":
    """
    ## Schema Definition
    """

    it "creates dict representation of schema":
        # @req: REQ-UNIT-LIB-009
        step("Verify: creates dict representation of schema")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = define_schema([("name", "text"), ("age", "int")])
        expect(result).to_contain("name: text")
        expect(result).to_contain("age: int")

describe "validate_field_type":
    """
    ## Field Type Validation

    Tests all type branches: int, bool, nil, text, list, tuple, dict, and unknown.
    """

    it "validates int type":
        # @req: REQ-UNIT-LIB-010
        step("Verify: validates int type")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(validate_field_type("42", "int")).to_equal(true)

    it "rejects non-numeric as int":
        # @req: REQ-UNIT-LIB-011
        step("Verify: rejects non-numeric as int")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(validate_field_type("abc", "int")).to_equal(false)

    it "validates true as bool":
        # @req: REQ-UNIT-LIB-012
        step("Verify: validates true as bool")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(validate_field_type("true", "bool")).to_equal(true)

    it "validates false as bool":
        # @req: REQ-UNIT-LIB-013
        step("Verify: validates false as bool")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(validate_field_type("false", "bool")).to_equal(true)

    it "rejects non-bool as bool":
        # @req: REQ-UNIT-LIB-014
        step("Verify: rejects non-bool as bool")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(validate_field_type("42", "bool")).to_equal(false)

    it "validates nil type":
        # @req: REQ-UNIT-LIB-015
        step("Verify: validates nil type")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(validate_field_type("nil", "nil")).to_equal(true)

    it "rejects non-nil as nil":
        # @req: REQ-UNIT-LIB-016
        step("Verify: rejects non-nil as nil")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(validate_field_type("42", "nil")).to_equal(false)

    it "validates text type by leading quote":
        # @req: REQ-UNIT-LIB-017
        step("Verify: validates text type by leading quote")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(validate_field_type("\"hello\"", "text")).to_equal(true)

    it "rejects non-quoted as text":
        # @req: REQ-UNIT-LIB-018
        step("Verify: rejects non-quoted as text")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(validate_field_type("hello", "text")).to_equal(false)

    it "validates list type by leading bracket":
        # @req: REQ-UNIT-LIB-019
        step("Verify: validates list type by leading bracket")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(validate_field_type("[1, 2]", "list")).to_equal(true)

    it "rejects non-list as list":
        # @req: REQ-UNIT-LIB-020
        step("Verify: rejects non-list as list")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(validate_field_type("42", "list")).to_equal(false)

    it "validates tuple type by leading paren":
        # @req: REQ-UNIT-LIB-021
        step("Verify: validates tuple type by leading paren")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(validate_field_type("(1, 2)", "tuple")).to_equal(true)

    it "rejects non-tuple as tuple":
        # @req: REQ-UNIT-LIB-022
        step("Verify: rejects non-tuple as tuple")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(validate_field_type("42", "tuple")).to_equal(false)

    it "validates dict type by leading brace":
        # @req: REQ-UNIT-LIB-023
        step("Verify: validates dict type by leading brace")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(validate_field_type("{k: v}", "dict")).to_equal(true)

    it "rejects non-dict as dict":
        # @req: REQ-UNIT-LIB-024
        step("Verify: rejects non-dict as dict")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(validate_field_type("42", "dict")).to_equal(false)

    it "returns true for unknown type":
        # @req: REQ-UNIT-LIB-025
        step("Verify: returns true for unknown type")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(validate_field_type("anything", "custom_type")).to_equal(true)

# ============================================================================
# Test Group 15: Versioning (utilities.spl)
# ============================================================================

describe "add_version":
    """
    ## Version Wrapper
    """

    it "wraps data with version number":
        # @req: REQ-UNIT-LIB-026
        step("Verify: wraps data with version number")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = add_version("[1, 2]", 3)
        expect(result).to_contain("v: 3")
        expect(result).to_contain("data: [1, 2]")

describe "get_version":
    """
    ## Version Extraction

    Tests valid versioned string, non-versioned string, and nil return.
    """

    it "extracts version from versioned string":
        # @req: REQ-UNIT-LIB-027
        step("Verify: extracts version from versioned string")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val versioned = add_version("data", 5)
        val result = get_version(versioned)
        expect(result).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

    it "returns nil for non-versioned string":
        # @req: REQ-UNIT-LIB-028
        step("Verify: returns nil for non-versioned string")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = get_version("not versioned")
        expect(result).to_be_nil()

    it "returns nil for empty string":
        # @req: REQ-UNIT-LIB-029
        step("Verify: returns nil for empty string")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = get_version("")
        expect(result).to_be_nil()

describe "strip_version":
    """
    ## Version Stripping

    Tests versioned input and non-versioned input.
    """

    it "strips version and returns inner data":
        # @req: REQ-UNIT-LIB-030
        step("Verify: strips version and returns inner data")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val versioned = add_version("[1, 2]", 1)
        val result = strip_version(versioned)
        expect(result).to_equal("[1, 2]")

    it "returns original for non-versioned input":
        # @req: REQ-UNIT-LIB-031
        step("Verify: returns original for non-versioned input")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = strip_version("plain data")
        expect(result).to_equal("plain data")

describe "parse_int_safe":
    """
    ## Safe Integer Parsing

    Tests empty, positive, negative, non-digit, and zero.
    """

    it "returns 0 for empty string":
        # @req: REQ-UNIT-LIB-032
        step("Verify: returns 0 for empty string")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(parse_int_safe("")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "parses positive integer":
        # @req: REQ-UNIT-LIB-033
        step("Verify: parses positive integer")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(parse_int_safe("42")).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

    it "parses negative integer":
        # @req: REQ-UNIT-LIB-034
        step("Verify: parses negative integer")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(parse_int_safe("-7")).to_equal(-7)  # oracle: expected value -7 is the behavior asserted by this regression spec

    it "stops parsing at non-digit":
        # @req: REQ-UNIT-LIB-035
        step("Verify: stops parsing at non-digit")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(parse_int_safe("12abc")).to_equal(12)  # oracle: expected value 12 is the behavior asserted by this regression spec

    it "parses zero":
        # @req: REQ-UNIT-LIB-036
        step("Verify: parses zero")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(parse_int_safe("0")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

describe "char_to_digit_safe":
    """
    ## Character to Digit Conversion

    Tests all digit characters and fallback.
    """

    it "converts all digit characters":
        # @req: REQ-UNIT-LIB-037
        step("Verify: converts all digit characters")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(char_to_digit_safe("0")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(char_to_digit_safe("1")).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(char_to_digit_safe("2")).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(char_to_digit_safe("3")).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
        expect(char_to_digit_safe("4")).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
        expect(char_to_digit_safe("5")).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec
        expect(char_to_digit_safe("6")).to_equal(6)  # oracle: expected value 6 is the behavior asserted by this regression spec
        expect(char_to_digit_safe("7")).to_equal(7)  # oracle: expected value 7 is the behavior asserted by this regression spec
        expect(char_to_digit_safe("8")).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec
        expect(char_to_digit_safe("9")).to_equal(9)  # oracle: expected value 9 is the behavior asserted by this regression spec

    it "returns 0 for non-digit":
        # @req: REQ-UNIT-LIB-038
        step("Verify: returns 0 for non-digit")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(char_to_digit_safe("x")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

# ============================================================================
# Test Group 16: Deep Cloning (utilities.spl)
# ============================================================================

describe "Deep Cloning":
    """
    ## Deep Clone Functions
    """

    it "clones integer":
        # @req: REQ-UNIT-LIB-039
        step("Verify: clones integer")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_clone_int(42)).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec

    it "clones boolean true":
        # @req: REQ-UNIT-LIB-040
        step("Verify: clones boolean true")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_clone_bool(true)).to_equal(true)

    it "clones boolean false":
        # @req: REQ-UNIT-LIB-041
        step("Verify: clones boolean false")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_clone_bool(false)).to_equal(false)

    it "clones text":
        # @req: REQ-UNIT-LIB-042
        step("Verify: clones text")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_clone_text("hello")).to_equal("hello")

    it "clones int list":
        # @req: REQ-UNIT-LIB-043
        step("Verify: clones int list")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val original = [1, 2, 3]
        val cloned = deep_clone_list_int(original)
        expect(deep_equal_list_int(original, cloned)).to_equal(true)

    it "clones text list":
        # @req: REQ-UNIT-LIB-044
        step("Verify: clones text list")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val original = ["a", "b"]
        val cloned = deep_clone_list_text(original)
        expect(deep_equal_list_text(original, cloned)).to_equal(true)

    it "clones empty int list":
        # @req: REQ-UNIT-LIB-045
        step("Verify: clones empty int list")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cloned = deep_clone_list_int([])
        expect(cloned.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "clones empty text list":
        # @req: REQ-UNIT-LIB-046
        step("Verify: clones empty text list")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cloned = deep_clone_list_text([])
        expect(cloned.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

describe "Shallow Cloning":
    """
    ## Shallow Clone Functions (delegate to deep clone)
    """

    it "shallow clones int list":
        # @req: REQ-UNIT-LIB-047
        step("Verify: shallow clones int list")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val original = [10, 20]
        val cloned = shallow_clone_list_int(original)
        expect(deep_equal_list_int(original, cloned)).to_equal(true)

    it "shallow clones text list":
        # @req: REQ-UNIT-LIB-048
        step("Verify: shallow clones text list")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val original = ["x", "y"]
        val cloned = shallow_clone_list_text(original)
        expect(deep_equal_list_text(original, cloned)).to_equal(true)

# ============================================================================
# Test Group 17: Deep Equality (utilities.spl)
# ============================================================================

describe "Deep Equality":
    """
    ## Deep Equality Comparisons

    Tests equal and unequal cases for each type, plus length mismatch branch.
    """

    it "compares equal integers":
        # @req: REQ-UNIT-LIB-049
        step("Verify: compares equal integers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_equal_int(5, 5)).to_equal(true)

    it "compares unequal integers":
        # @req: REQ-UNIT-LIB-050
        step("Verify: compares unequal integers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_equal_int(5, 6)).to_equal(false)

    it "compares equal booleans":
        # @req: REQ-UNIT-LIB-051
        step("Verify: compares equal booleans")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_equal_bool(true, true)).to_equal(true)

    it "compares unequal booleans":
        # @req: REQ-UNIT-LIB-052
        step("Verify: compares unequal booleans")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_equal_bool(true, false)).to_equal(false)

    it "compares equal text":
        # @req: REQ-UNIT-LIB-053
        step("Verify: compares equal text")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_equal_text("abc", "abc")).to_equal(true)

    it "compares unequal text":
        # @req: REQ-UNIT-LIB-054
        step("Verify: compares unequal text")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_equal_text("abc", "xyz")).to_equal(false)

    it "compares equal int lists":
        # @req: REQ-UNIT-LIB-055
        step("Verify: compares equal int lists")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_equal_list_int([1, 2], [1, 2])).to_equal(true)

    it "compares unequal int lists by element":
        # @req: REQ-UNIT-LIB-056
        step("Verify: compares unequal int lists by element")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_equal_list_int([1, 2], [1, 3])).to_equal(false)

    it "compares int lists of different lengths":
        # @req: REQ-UNIT-LIB-057
        step("Verify: compares int lists of different lengths")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_equal_list_int([1], [1, 2])).to_equal(false)

    it "compares empty int lists":
        # @req: REQ-UNIT-LIB-058
        step("Verify: compares empty int lists")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_equal_list_int([], [])).to_equal(true)

    it "compares equal text lists":
        # @req: REQ-UNIT-LIB-059
        step("Verify: compares equal text lists")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_equal_list_text(["a", "b"], ["a", "b"])).to_equal(true)

    it "compares unequal text lists by element":
        # @req: REQ-UNIT-LIB-060
        step("Verify: compares unequal text lists by element")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_equal_list_text(["a"], ["b"])).to_equal(false)

    it "compares text lists of different lengths":
        # @req: REQ-UNIT-LIB-061
        step("Verify: compares text lists of different lengths")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_equal_list_text(["a"], ["a", "b"])).to_equal(false)

    it "compares empty text lists":
        # @req: REQ-UNIT-LIB-062
        step("Verify: compares empty text lists")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(deep_equal_list_text([], [])).to_equal(true)

# ============================================================================
# Test Group 18: Structural Hashing (utilities.spl)
# ============================================================================

describe "Structural Hashing":
    """
    ## Hash Functions

    Tests determinism, different inputs produce different hashes, and combine_hashes.
    """

    it "hashes integer deterministically":
        # @req: REQ-UNIT-LIB-063
        step("Verify: hashes integer deterministically")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val h1 = structural_hash_int(42)
        val h2 = structural_hash_int(42)
        expect(h1).to_equal(h2)

    it "hashes different integers differently":
        # @req: REQ-UNIT-LIB-064
        step("Verify: hashes different integers differently")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val h1 = structural_hash_int(1)
        val h2 = structural_hash_int(2)
        expect(h1).to_not_equal(h2)

    it "hashes true and false differently":
        # @req: REQ-UNIT-LIB-065
        step("Verify: hashes true and false differently")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val h_true = structural_hash_bool(true)
        val h_false = structural_hash_bool(false)
        expect(h_true).to_not_equal(h_false)

    it "hashes bool true to 1":
        # @req: REQ-UNIT-LIB-066
        step("Verify: hashes bool true to 1")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(structural_hash_bool(true)).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "hashes bool false to 0":
        # @req: REQ-UNIT-LIB-067
        step("Verify: hashes bool false to 0")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(structural_hash_bool(false)).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "hashes empty text to seed value":
        # @req: REQ-UNIT-LIB-068
        step("Verify: hashes empty text to seed value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val h = structural_hash_text("")
        expect(h).to_equal(2166136261)  # oracle: expected value 2166136261 is the behavior asserted by this regression spec

    it "hashes single char text without overflow":
        # @req: REQ-UNIT-LIB-069
        step("Verify: hashes single char text without overflow")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val h = structural_hash_text("a")
        expect(h).to_not_equal(0)

    it "hashes empty int list to seed value":
        # @req: REQ-UNIT-LIB-070
        step("Verify: hashes empty int list to seed value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val h = structural_hash_list_int([])
        expect(h).to_equal(2166136261)  # oracle: expected value 2166136261 is the behavior asserted by this regression spec

    it "hashes single element int list":
        # @req: REQ-UNIT-LIB-071
        step("Verify: hashes single element int list")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val h = structural_hash_list_int([1])
        expect(h).to_not_equal(0)

    it "hashes empty text list to seed value":
        # @req: REQ-UNIT-LIB-072
        step("Verify: hashes empty text list to seed value")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val h = structural_hash_list_text([])
        expect(h).to_equal(2166136261)  # oracle: expected value 2166136261 is the behavior asserted by this regression spec

    it "combines hashes":
        # @req: REQ-UNIT-LIB-073
        step("Verify: combines hashes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val combined = combine_hashes(100, 200)
        expect(combined).to_equal(100 * 31 + 200)

# ============================================================================
# Test Group 19: Compression/Encryption Markers (utilities.spl)
# ============================================================================

describe "Compression Markers":
    """
    ## Compression Marker Functions

    Tests marking and checking, plus negative cases.
    """

    it "marks data as compressed":
        # @req: REQ-UNIT-LIB-074
        step("Verify: marks data as compressed")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = mark_compressed("payload")
        expect(result).to_equal("@Compressed\{payload\}")

    it "detects compressed data":
        # @req: REQ-UNIT-LIB-075
        step("Verify: detects compressed data")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val marked = mark_compressed("payload")
        expect(is_compressed(marked)).to_equal(true)

    it "returns false for non-compressed data":
        # @req: REQ-UNIT-LIB-076
        step("Verify: returns false for non-compressed data")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(is_compressed("plain")).to_equal(false)

    it "returns false for short input":
        # @req: REQ-UNIT-LIB-077
        step("Verify: returns false for short input")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(is_compressed("ab")).to_equal(false)

