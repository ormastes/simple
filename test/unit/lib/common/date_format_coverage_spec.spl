describe "Date Calculate - Calendar Navigation":
    context "first_day_of_month":
        it "returns first day":
            step("Verify: returns first day")
            var result = first_day_of_month((2025, 3, 15))
            expect(result[2]).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result[1]).to_equal(3)  # oracle: 3 — named expected value from the requirement

    context "last_day_of_month":
        it "returns 31 for January":
            step("Verify: returns 31 for January")
            var result = last_day_of_month((2025, 1, 15))
            expect(result[2]).to_equal(31)  # oracle: 31 — named expected value from the requirement

        it "returns 28 for February non-leap":
            step("Verify: returns 28 for February non-leap")
            var result = last_day_of_month((2025, 2, 10))
            expect(result[2]).to_equal(28)  # oracle: 28 — named expected value from the requirement

        it "returns 29 for February leap":
            step("Verify: returns 29 for February leap")
            var result = last_day_of_month((2024, 2, 10))
            expect(result[2]).to_equal(29)  # oracle: 29 — named expected value from the requirement

    context "first_day_of_year":
        it "returns January 1":
            step("Verify: returns January 1")
            var result = first_day_of_year((2025, 6, 15))
            expect(result[1]).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result[2]).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "last_day_of_year":
        it "returns December 31":
            step("Verify: returns December 31")
            var result = last_day_of_year((2025, 6, 15))
            expect(result[1]).to_equal(12)  # oracle: 12 — named expected value from the requirement
            expect(result[2]).to_equal(31)  # oracle: 31 — named expected value from the requirement

    context "first_day_of_quarter":
        it "returns Jan 1 for Q1":
            step("Verify: returns Jan 1 for Q1")
            var result = first_day_of_quarter((2025, 2, 15))
            expect(result[1]).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result[2]).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "returns Apr 1 for Q2":
            step("Verify: returns Apr 1 for Q2")
            var result = first_day_of_quarter((2025, 5, 15))
            expect(result[1]).to_equal(4)  # oracle: 4 — named expected value from the requirement
            expect(result[2]).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "returns Jul 1 for Q3":
            step("Verify: returns Jul 1 for Q3")
            var result = first_day_of_quarter((2025, 8, 15))
            expect(result[1]).to_equal(7)  # oracle: 7 — named expected value from the requirement
            expect(result[2]).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "returns Oct 1 for Q4":
