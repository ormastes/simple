describe "Date Calculate - add_years":
    it "adds years to a normal date":
        step("Verify: adds years to a normal date")
        var result = add_years((2025, 6, 15), 2)
        expect(result[0]).to_equal(2027)  # oracle: 2027 — named expected value from the requirement
        expect(result[1]).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(result[2]).to_equal(15)  # oracle: 15 — named expected value from the requirement

    it "handles Feb 29 landing on non-leap year":
        step("Verify: handles Feb 29 landing on non-leap year")
        # 2024 is leap, 2025 is not
        var result = add_years((2024, 2, 29), 1)
        expect(result[0]).to_equal(2025)  # oracle: 2025 — named expected value from the requirement
        expect(result[1]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(result[2]).to_equal(28)  # oracle: 28 — named expected value from the requirement

    it "handles Feb 29 landing on leap year":
        step("Verify: handles Feb 29 landing on leap year")
        # 2024 is leap, 2028 is also leap
        var result = add_years((2024, 2, 29), 4)
        expect(result[0]).to_equal(2028)  # oracle: 2028 — named expected value from the requirement
        expect(result[1]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(result[2]).to_equal(29)  # oracle: 29 — named expected value from the requirement

    it "does not adjust non-Feb dates":
        step("Verify: does not adjust non-Feb dates")
        var result = add_years((2024, 3, 15), 1)
        expect(result[0]).to_equal(2025)  # oracle: 2025 — named expected value from the requirement
        expect(result[1]).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(result[2]).to_equal(15)  # oracle: 15 — named expected value from the requirement

    it "does not adjust Feb 28":
        step("Verify: does not adjust Feb 28")
        var result = add_years((2024, 2, 28), 1)
        expect(result[0]).to_equal(2025)  # oracle: 2025 — named expected value from the requirement
        expect(result[1]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(result[2]).to_equal(28)  # oracle: 28 — named expected value from the requirement


describe "Date Calculate - subtract_years":
    it "subtracts years":
        step("Verify: subtracts years")
        var result = subtract_years((2025, 6, 15), 5)
        expect(result[0]).to_equal(2020)  # oracle: 2020 — named expected value from the requirement

# ============================================================================
# Test Group 12: date/calculate.spl - Date Comparison
# ============================================================================


describe "Date Calculate - Comparison":
    context "equal":
        it "returns true for same dates":
            step("Verify: returns true for same dates")
            expect(equal((2025, 1, 15), (2025, 1, 15))).to_equal(true)

        it "returns false for different years":
            step("Verify: returns false for different years")
            expect(equal((2025, 1, 15), (2024, 1, 15))).to_equal(false)

        it "returns false for different months":
            step("Verify: returns false for different months")
            expect(equal((2025, 1, 15), (2025, 2, 15))).to_equal(false)

        it "returns false for different days":
            step("Verify: returns false for different days")
            expect(equal((2025, 1, 15), (2025, 1, 16))).to_equal(false)

    context "before":
        it "returns true when date1 is earlier":
            step("Verify: returns true when date1 is earlier")
            expect(before((2025, 1, 1), (2025, 1, 2))).to_equal(true)

        it "returns false when date1 is later":
            step("Verify: returns false when date1 is later")
            expect(before((2025, 1, 2), (2025, 1, 1))).to_equal(false)

        it "returns false for same date":
            step("Verify: returns false for same date")
            expect(before((2025, 1, 1), (2025, 1, 1))).to_equal(false)

    context "after":
        it "returns true when date1 is later":
            step("Verify: returns true when date1 is later")
            expect(after((2025, 1, 2), (2025, 1, 1))).to_equal(true)

        it "returns false when date1 is earlier":
            step("Verify: returns false when date1 is earlier")
            expect(after((2025, 1, 1), (2025, 1, 2))).to_equal(false)

        it "returns false for same date":
            step("Verify: returns false for same date")
            expect(after((2025, 1, 1), (2025, 1, 1))).to_equal(false)

    context "compare":
        it "returns -1 for before":
            step("Verify: returns -1 for before")
            expect(compare((2025, 1, 1), (2025, 1, 2))).to_equal(-1)  # oracle: -1 — named expected value from the requirement

        it "returns 1 for after":
            step("Verify: returns 1 for after")
            expect(compare((2025, 1, 2), (2025, 1, 1))).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "returns 0 for equal":
            step("Verify: returns 0 for equal")
            expect(compare((2025, 1, 1), (2025, 1, 1))).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "before_or_equal":
        it "returns true for before":
            step("Verify: returns true for before")
            expect(before_or_equal((2025, 1, 1), (2025, 1, 2))).to_equal(true)

        it "returns true for equal":
            step("Verify: returns true for equal")
            expect(before_or_equal((2025, 1, 1), (2025, 1, 1))).to_equal(true)

        it "returns false for after":
            step("Verify: returns false for after")
            expect(before_or_equal((2025, 1, 2), (2025, 1, 1))).to_equal(false)

    context "after_or_equal":
        it "returns true for after":
            step("Verify: returns true for after")
            expect(after_or_equal((2025, 1, 2), (2025, 1, 1))).to_equal(true)

        it "returns true for equal":
            step("Verify: returns true for equal")
            expect(after_or_equal((2025, 1, 1), (2025, 1, 1))).to_equal(true)

        it "returns false for before":
            step("Verify: returns false for before")
            expect(after_or_equal((2025, 1, 1), (2025, 1, 2))).to_equal(false)

