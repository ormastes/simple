            var result = first_day_of_quarter((2025, 11, 15))
            expect(result[1]).to_equal(10)  # oracle: 10 — named expected value from the requirement
            expect(result[2]).to_equal(1)  # oracle: 1 — named expected value from the requirement

    context "last_day_of_quarter":
        it "returns Mar 31 for Q1":
            step("Verify: returns Mar 31 for Q1")
            var result = last_day_of_quarter((2025, 2, 15))
            expect(result[1]).to_equal(3)  # oracle: 3 — named expected value from the requirement
