# Test Group 1: date/types.spl - Constants and Day/Month Names
# ============================================================================

use std.spec.step

describe "Date Format - text_from_i64 helper":
    it "converts zero":
        step("Verify: converts zero")
        # @req: REQ-LIB-COMMON-001
        expect(text_from_i64(0)).to_equal("0")

    it "converts positive number":
        step("Verify: converts positive number")
        expect(text_from_i64(42)).to_equal("42")

    it "converts negative number":
        step("Verify: converts negative number")
        expect(text_from_i64(-7)).to_equal("-7")

    it "converts single digit":
        step("Verify: converts single digit")
        expect(text_from_i64(5)).to_equal("5")

    it "converts large number":
        step("Verify: converts large number")
        expect(text_from_i64(2025)).to_equal("2025")

# ============================================================================
# Test Group 11: date/calculate.spl - Date Arithmetic
# ============================================================================


describe "Date Calculate - to_days":
    it "converts epoch to day 1":
        step("Verify: converts epoch to day 1")
        expect(to_days((1, 1, 1))).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "converts Jan 31 year 1 to day 31":
        step("Verify: converts Jan 31 year 1 to day 31")
        expect(to_days((1, 1, 31))).to_equal(31)  # oracle: 31 — named expected value from the requirement

    it "converts Feb 1 year 1 to day 32":
        step("Verify: converts Feb 1 year 1 to day 32")
        expect(to_days((1, 2, 1))).to_equal(32)  # oracle: 32 — named expected value from the requirement

    it "handles year crossing":
        step("Verify: handles year crossing")
        # Year 1 has 365 days, so Jan 1 year 2 = day 366
        expect(to_days((2, 1, 1))).to_equal(366)  # oracle: 366 — named expected value from the requirement

    it "handles leap year in calculation":
        step("Verify: handles leap year in calculation")
        # Year 4 is leap: days = 365*3 + 366 + 1 = 1462
        expect(to_days((5, 1, 1))).to_equal(1462)  # oracle: 1462 — named expected value from the requirement


describe "Date Calculate - add_days":
    it "adds days to a date":
        step("Verify: adds days to a date")
        var result = add_days((2025, 1, 1), 10)
        expect(result[0]).to_equal(2025)  # oracle: 2025 — named expected value from the requirement
        expect(result[1]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result[2]).to_equal(11)  # oracle: 11 — named expected value from the requirement

    it "adds days crossing month boundary":
        step("Verify: adds days crossing month boundary")
        var result = add_days((2025, 1, 30), 5)
        expect(result[0]).to_equal(2025)  # oracle: 2025 — named expected value from the requirement
        expect(result[1]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(result[2]).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "returns nil when result is before epoch":
        step("Verify: returns nil when result is before epoch")
        var result = add_days((1, 1, 1), -5)
        expect(result).to_equal(nil)


describe "Date Calculate - subtract_days":
    it "subtracts days from a date":
        step("Verify: subtracts days from a date")
        var result = subtract_days((2025, 1, 15), 5)
        expect(result[0]).to_equal(2025)  # oracle: 2025 — named expected value from the requirement
        expect(result[1]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result[2]).to_equal(10)  # oracle: 10 — named expected value from the requirement


describe "Date Calculate - difference_in_days":
    it "returns positive for later date first":
        step("Verify: returns positive for later date first")
        var diff = difference_in_days((2025, 1, 15), (2025, 1, 10))
        expect(diff).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "returns negative for earlier date first":
        step("Verify: returns negative for earlier date first")
        var diff = difference_in_days((2025, 1, 10), (2025, 1, 15))
        expect(diff).to_equal(-5)  # oracle: -5 — named expected value from the requirement

    it "returns zero for same date":
        step("Verify: returns zero for same date")
        var diff = difference_in_days((2025, 1, 15), (2025, 1, 15))
        expect(diff).to_equal(0)  # oracle: 0 — named expected value from the requirement


describe "Date Calculate - add_months":
    it "adds months within same year":
        step("Verify: adds months within same year")
        var result = add_months((2025, 1, 15), 3)
        expect(result[0]).to_equal(2025)  # oracle: 2025 — named expected value from the requirement
        expect(result[1]).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(result[2]).to_equal(15)  # oracle: 15 — named expected value from the requirement

    it "adds months crossing year boundary":
        step("Verify: adds months crossing year boundary")
        var result = add_months((2025, 11, 15), 3)
        expect(result[0]).to_equal(2026)  # oracle: 2026 — named expected value from the requirement
        expect(result[1]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(result[2]).to_equal(15)  # oracle: 15 — named expected value from the requirement

    it "clamps day when new month has fewer days":
        step("Verify: clamps day when new month has fewer days")
        # Jan 31 + 1 month -> Feb 28 (2025 non-leap)
        var result = add_months((2025, 1, 31), 1)
        expect(result[0]).to_equal(2025)  # oracle: 2025 — named expected value from the requirement
        expect(result[1]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(result[2]).to_equal(28)  # oracle: 28 — named expected value from the requirement

    it "handles negative months":
        step("Verify: handles negative months")
        var result = add_months((2025, 3, 15), -2)
        expect(result[0]).to_equal(2025)  # oracle: 2025 — named expected value from the requirement
        expect(result[1]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result[2]).to_equal(15)  # oracle: 15 — named expected value from the requirement

    it "handles negative months crossing year boundary":
        step("Verify: handles negative months crossing year boundary")
        var result = add_months((2025, 2, 15), -3)
        expect(result[0]).to_equal(2024)  # oracle: 2024 — named expected value from the requirement
        expect(result[1]).to_equal(11)  # oracle: 11 — named expected value from the requirement
        expect(result[2]).to_equal(15)  # oracle: 15 — named expected value from the requirement


describe "Date Calculate - subtract_months":
