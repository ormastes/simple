"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/common/torch/torch_training_seed_status_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
extern fn rt_file_read_text(path: text) -> text

fn source(path: text) -> text:
    rt_file_read_text(path) ?? ""

fn body_after_marker(source_text: text, marker: text) -> text:
    val start = source_text.find(marker)
    if start < 0:
        return ""
    source_text.slice(start, source_text.len())

fn assert_seed_status_surface(path: text):
    val text = source(path)
    val set_body = body_after_marker(text, "fn set_seed(seed: i64) -> text:")
    val manual_body = body_after_marker(text, "fn manual_seed(seed: i64) -> text:")

    expect(set_body).to_contain("fn set_seed(seed: i64) -> text:")
    expect(set_body).to_contain("\"unsupported\"")
    expect(set_body.contains("Currently a no-op")).to_equal(false)
    expect(set_body.contains("No-op until rt_torch_manual_seed")).to_equal(false)
    expect(manual_body).to_contain("fn manual_seed(seed: i64) -> text:")
    expect(manual_body).to_contain("set_seed(seed)")

describe "Torch training seed status":
    it "makes GC async seed helpers explicitly unsupported":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-LIB-001
        step("Verify: makes GC async seed helpers explicitly unsupported")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        assert_seed_status_surface("src/lib/gc_async_mut/torch/torch_training.spl")

    it "makes NoGC async seed helpers explicitly unsupported":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-LIB-002
        step("Verify: makes NoGC async seed helpers explicitly unsupported")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        assert_seed_status_surface("src/lib/nogc_async_mut/torch/torch_training.spl")

    it "makes NoGC sync seed helpers explicitly unsupported":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-LIB-003
        step("Verify: makes NoGC sync seed helpers explicitly unsupported")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        assert_seed_status_surface("src/lib/nogc_sync_mut/torch/torch_training.spl")
