"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/common/torch/torch_device_placement_status_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.io_runtime.{read_file}
use std.spec.{step}

fn source(path: text) -> text:
    read_file(path) ?? ""

fn body_between(source_text: text, marker: text, next_marker: text) -> text:
    val start = source_text.find(marker)
    if start < 0:
        return ""
    val rest = source_text.slice(start, source_text.len())
    val next = rest.find(next_marker)
    if next < 0:
        return rest
    rest.slice(0, next)

fn assert_backend_uses_requested_cuda_device(path: text):
    val body = body_between(
        source(path),
        "fn tensor_cuda(h: i64, device_id: i64) -> i64:",
        "\n\n    fn tensor_cpu"
    )
    expect(body).to_contain("fn tensor_cuda(h: i64, device_id: i64) -> i64:")
    expect(body).to_contain("rt_torch_torchtensor_cuda(h, device_id as i32)")
    expect(body.contains("rt_torch_torchtensor_cuda(h, 0)")).to_equal(false)

fn assert_tensor_method_uses_requested_cuda_device(path: text):
    val body = body_between(
        source(path),
        "fn cuda(device_id: i64) -> Tensor:",
        "\n\n    fn cpu"
    )
    expect(body).to_contain("fn cuda(device_id: i64) -> Tensor:")
    expect(body).to_contain("val device_i32 = device_id as i32")
    expect(body.contains("val device_i32 = 0")).to_equal(false)

fn assert_gc_tensor_arithmetic_uses_mutable_ownership_handoffs(path: text):
    val sub_body = body_between(
        source(path),
        "fn sub(other: Tensor) -> Tensor:",
        "\n\n    fn mul"
    )
    val div_body = body_between(
        source(path),
        "fn div(other: Tensor) -> Tensor:",
        "\n\n    fn matmul"
    )
    expect(sub_body).to_contain("var scaled = neg_one.mul(other)")
    expect(sub_body).to_contain("scaled.owns_handle = false")
    expect(sub_body.contains("val scaled = neg_one.mul(other)")).to_equal(false)
    expect(div_body).to_contain("var ones_t = Tensor.ones(other.shape())")
    expect(div_body).to_contain("ones_t.owns_handle = false")
    expect(div_body.contains("val ones_t = Tensor.ones(other.shape())")).to_equal(false)

fn assert_stream_uses_requested_device(path: text):
    val body = body_between(
        source(path),
        "static fn create(device_id: i64) -> Stream:",
        "\n\n    fn drop"
    )
    expect(body).to_contain("static fn create(device_id: i64) -> Stream:")
    expect(body).to_contain("val device_i32 = device_id as i32")
    expect(body.contains("val device_i32 = 0")).to_equal(false)

fn assert_optimizer_does_not_force_cuda_zero(path: text):
    val text = source(path)
    expect(text.contains("fn zeros_like_default_device")).to_equal(false)
    expect(text.contains("fn zeros_like_on_cuda")).to_equal(false)
    expect(text.contains("rt_torch_torchtensor_cuda(h, 0)")).to_equal(false)
    expect(text.contains("move tensor to CUDA device 0")).to_equal(false)

fn assert_optimizer_state_uses_parameter_device(path: text):
    val text = source(path)
    expect(text).to_contain("fn zeros_like_param_device(param: i64) -> i64:")
    expect(text).to_contain("val device_id = rt_torch_torchtensor_device(param)")
    expect(text).to_contain("if device_id >= 0:")
    expect(text).to_contain("rt_torch_torchtensor_cuda(zeros, device_id)")
    expect(text).to_contain("rt_torch_torchtensor_free(zeros)")

fn assert_mutating_training_optimizers_use_mut_receiver(path: text):
    val text = source(path)
    val sgd_body = body_between(text, "class SGD:", "\n\nclass Adam:")
    val adam_body = body_between(text, "class Adam:", "\n\nclass RMSprop:")
    val rmsprop_body = body_between(text, "class RMSprop:", "\n\n# =========================================================================")
    expect(sgd_body).to_contain("me step():")
    expect(adam_body).to_contain("me step():")
    expect(rmsprop_body).to_contain("me step():")
    expect(sgd_body.contains("fn step():")).to_equal(false)
    expect(adam_body.contains("fn step():")).to_equal(false)
    expect(rmsprop_body.contains("fn step():")).to_equal(false)

describe "Torch device placement status":
    it "passes explicit CUDA device ids through backend facades":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-LIB-001
        step("Verify: passes explicit CUDA device ids through backend facades")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        assert_backend_uses_requested_cuda_device("src/lib/gc_async_mut/torch/backend.spl")
        assert_backend_uses_requested_cuda_device("src/lib/nogc_sync_mut/torch/backend.spl")

    it "passes explicit CUDA device ids through Tensor methods":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-LIB-002
        step("Verify: passes explicit CUDA device ids through Tensor methods")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        assert_tensor_method_uses_requested_cuda_device("src/lib/gc_async_mut/torch/mod.spl")
        assert_tensor_method_uses_requested_cuda_device("src/lib/nogc_sync_mut/torch/mod.spl")

    it "keeps GC Tensor arithmetic ownership handoffs mutable":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-LIB-003
        step("Verify: keeps GC Tensor arithmetic ownership handoffs mutable")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        assert_gc_tensor_arithmetic_uses_mutable_ownership_handoffs("src/lib/gc_async_mut/torch/mod.spl")

    it "passes explicit stream device ids to stream creation":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-LIB-004
        step("Verify: passes explicit stream device ids to stream creation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        assert_stream_uses_requested_device("src/lib/gc_async_mut/torch/torch_training.spl")
        assert_stream_uses_requested_device("src/lib/nogc_sync_mut/torch/torch_training.spl")

    it "does not initialize optimizer state by forcing CUDA device zero":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-LIB-005
        step("Verify: does not initialize optimizer state by forcing CUDA device zero")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        assert_optimizer_does_not_force_cuda_zero("src/lib/gc_async_mut/torch/optim.spl")
        assert_optimizer_does_not_force_cuda_zero("src/lib/nogc_sync_mut/torch/optim.spl")

    it "initializes optimizer state on the parameter device":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-LIB-006
        step("Verify: initializes optimizer state on the parameter device")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        assert_optimizer_state_uses_parameter_device("src/lib/gc_async_mut/torch/optim.spl")
        assert_optimizer_state_uses_parameter_device("src/lib/nogc_sync_mut/torch/optim.spl")

    it "declares mutating training optimizer steps with mutable receivers":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-LIB-007
        step("Verify: declares mutating training optimizer steps with mutable receivers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        assert_mutating_training_optimizers_use_mut_receiver("src/lib/gc_async_mut/torch/torch_training.spl")
        assert_mutating_training_optimizers_use_mut_receiver("src/lib/nogc_sync_mut/torch/torch_training.spl")
