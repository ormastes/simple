# Audio effects ownership and real offline DSP contracts.

use std.spec.{describe, it, expect}
use std.io_runtime.{file_exists, file_read}
use std.common.engine.audio.sound_synth.{
    apply_lowpass, apply_highpass, apply_delay, apply_pitch_shift
}

describe "Audio effects ownership":
    it "executes real pure-Simple offline PCM effects":
        val impulse: [f64] = [1.0, 0.0, 0.0, 0.0]
        val low = apply_lowpass(impulse, 1000.0, 8000)
        val high = apply_highpass(impulse, 1000.0, 8000)
        val delayed = apply_delay(impulse, 1.0, 0.5, 1000)
        val pitched = apply_pitch_shift(impulse, 1.0, 8000)

        expect(low.len()).to_equal(impulse.len())
        expect(high.len()).to_equal(impulse.len())
        expect(delayed.len()).to_equal(impulse.len())
        expect(pitched).to_equal(impulse)
        expect(low == impulse).to_equal(false)
        expect(high == impulse).to_equal(false)

    it "keeps live effect ABI declarations only at the canonical SFFI boundary":
        val abi = file_read("src/lib/nogc_sync_mut/io/audio_sffi.spl")
        val names = [
            "rt_audio_set_pitch", "rt_audio_add_lowpass",
            "rt_audio_add_highpass", "rt_audio_add_reverb",
            "rt_audio_add_delay", "rt_audio_remove_effect",
            "rt_audio_clear_effects"
        ]
        for name in names:
            expect(abi.contains("extern fn {name}")).to_equal(true)
        expect(file_exists("src/lib/common/audio_effects.spl")).to_equal(false)
