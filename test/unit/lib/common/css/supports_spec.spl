# @cover src/lib/common/css/supports.spl 80%
"""
# CSS @supports Condition Specification

**Category:** Browser / CSS
**Status:** Active

## Overview

`@supports` asks the engine about itself, which makes a flattering answer
uniquely damaging: an author writes `@supports (display: grid)` so that an
engine WITHOUT grid takes the fallback. An engine that claims support for
everything takes the grid branch and then cannot lay it out — worse than having
no `@supports` at all, because the author's own fallback has been disabled.

This specification pins that support is never inferred, only declared, and that
a syntax the evaluator does not implement is reported as unevaluated rather
than answered.
"""

use std.spipe.*
use std.common.css.supports.{
    SupportsRegistry, SupportsFeature,
    supports_registry_empty, registry_supports, evaluate_supports_condition,
    unevaluated_supports_functions
}

# A registry with partial `display` support — the realistic shape of a young
# engine, and the case `@supports` exists for.
fn _registry() -> SupportsRegistry:
    var any: [text] = []
    SupportsRegistry(features: [
        SupportsFeature(property: "display", values: ["block", "inline", "flex"]),
        SupportsFeature(property: "color", values: any),
    ])

fn _verdict(condition: text) -> text:
    if val v = evaluate_supports_condition(condition, _registry()):
        if v:
            return "supported"
        return "unsupported"
    "unevaluated"

# @manual_section: Declared support
describe "declaration conditions":
    """
    As a browser engine, I want a support query answered from what my cascade
    actually implements, so that an author's fallback branch runs whenever the
    feature they asked about is genuinely missing.
    """

    # @req REQ-CSS-SUPPORTS-DECLARED
    it "reports a property and value the engine implements as supported":
        step("evaluate `(display: flex)` against a registry that lists flex")
        expect(_verdict("(display: flex)")).to_equal("supported")

    # @req REQ-CSS-SUPPORTS-HONEST
    it "reports a value outside the engine's partial support as unsupported":
        step("evaluate `(display: grid)` against a registry whose display stops at flex")
        expect(_verdict("(display: grid)")).to_equal("unsupported")

    # @req REQ-CSS-SUPPORTS-HONEST
    it "reports a property the engine never implements as unsupported":
        step("evaluate `(container-type: inline-size)`, absent from the registry")
        expect(_verdict("(container-type: inline-size)")).to_equal("unsupported")

    # @req REQ-CSS-SUPPORTS-DECLARED
    it "accepts any value for a property declared with no value restriction":
        step("evaluate `(color: oklch(0.5 0.1 200))` for a property with open value support")
        expect(_verdict("(color: oklch(0.5 0.1 200))")).to_equal("supported")

    # @req REQ-CSS-SUPPORTS-HONEST
    it "reports a declaration with an empty value as unsupported, not unevaluated":
        step("evaluate `(display: )` — an invalid declaration is a decided answer")
        expect(_verdict("(display: )")).to_equal("unsupported")

    # @req REQ-CSS-SUPPORTS-HONEST
    it "supports nothing at all through an empty registry":
        step("query an empty registry directly")
        expect(registry_supports(supports_registry_empty(), "color", "red")).to_equal(false)

    # @req REQ-CSS-SUPPORTS-DECLARED
    it "matches a property name case-insensitively":
        step("evaluate `(DISPLAY: FLEX)`")
        expect(_verdict("(DISPLAY: FLEX)")).to_equal("supported")

# @manual_section: Logical operators
describe "condition logic":
    """
    As a browser engine, I want not/and/or over support conditions evaluated
    exactly, so that a compound feature test selects the branch the author
    intended rather than the branch that happens to parse.
    """

    # @req REQ-CSS-SUPPORTS-LOGIC
    it "inverts a supported condition under not":
        step("evaluate `not (display: flex)`")
        expect(_verdict("not (display: flex)")).to_equal("unsupported")

    # @req REQ-CSS-SUPPORTS-LOGIC
    it "inverts an unsupported condition under not":
        step("evaluate `not (display: grid)` — the author's fallback guard")
        expect(_verdict("not (display: grid)")).to_equal("supported")

    # @req REQ-CSS-SUPPORTS-LOGIC
    it "requires both operands of an and":
        step("evaluate `(display: flex) and (display: grid)`")
        expect(_verdict("(display: flex) and (display: grid)")).to_equal("unsupported")

    # @req REQ-CSS-SUPPORTS-LOGIC
    it "accepts either operand of an or":
        step("evaluate `(display: grid) or (display: flex)`")
        expect(_verdict("(display: grid) or (display: flex)")).to_equal("supported")

    # @req REQ-CSS-SUPPORTS-LOGIC
    it "evaluates a parenthesised nested condition":
        step("evaluate `((display: flex) and (color: red))`")
        expect(_verdict("((display: flex) and (color: red))")).to_equal("supported")

# @manual_section: The failure contract
describe "unevaluated conditions":
    """
    As a browser engine, I want a `@supports` syntax I have not implemented
    reported as unevaluated, so that it is distinguishable from a genuine
    "not supported" and can be listed as a gap rather than mistaken for a
    considered answer.
    """

    # @req REQ-CSS-SUPPORTS-UNEVALUATED
    it "reports a selector query as unevaluated rather than answering it":
        step("evaluate `selector(a > b)`")
        expect(_verdict("selector(a > b)")).to_equal("unevaluated")

    # @req REQ-CSS-SUPPORTS-UNEVALUATED
    it "reports a wrapped selector query as unevaluated too":
        step("evaluate `(selector(a > b))`")
        expect(_verdict("(selector(a > b))")).to_equal("unevaluated")

    # @req REQ-CSS-SUPPORTS-UNEVALUATED
    it "keeps a negated unevaluated condition unevaluated":
        step("evaluate `not selector(a > b)`")
        expect(_verdict("not selector(a > b)")).to_equal("unevaluated")

    # @req REQ-CSS-SUPPORTS-UNEVALUATED
    it "reports an unparenthesised bare condition as unevaluated":
        step("evaluate `display: flex` with no parentheses — not valid @supports syntax")
        expect(_verdict("display: flex")).to_equal("unevaluated")

    # @req REQ-CSS-SUPPORTS-UNEVALUATED
    it "reports an empty prelude as unevaluated":
        step("evaluate an empty condition")
        expect(_verdict("")).to_equal("unevaluated")

    # @req REQ-CSS-SUPPORTS-UNEVALUATED
    it "names the syntaxes it deliberately does not evaluate":
        step("check the unimplemented-function list is populated")
        expect(unevaluated_supports_functions().len() > 0).to_equal(true)
