# @cover src/lib/common/css/media_query.spl 80%
"""
# CSS Media Query Evaluation Specification

**Category:** Browser / CSS
**Status:** Active

## Overview

A media query engine has three possible answers, not two: matches, does not
match, and *was not evaluated*. This specification pins the third one. A
feature the engine does not implement must be reported as unevaluated (nil) so
the caller can refuse the block and say why — never defaulted to a match, which
turns an unimplemented feature into a silently wrong page.
"""

use std.spipe.*
use std.common.css.media_query.{
    MediaEnvironment, media_environment_screen,
    evaluate_media_query, evaluate_media_query_list, supported_media_features
}

# Render a query verdict as text so "matched", "did not match" and "was not
# evaluated" are three distinguishable outcomes in one assertion. Collapsing
# the third into `false` is precisely the bug this module exists to prevent.
fn _verdict(query: text, env: MediaEnvironment) -> text:
    if val v = evaluate_media_query_list(query, env):
        if v:
            return "match"
        return "no-match"
    "unevaluated"

fn _wide() -> MediaEnvironment:
    media_environment_screen(1200.0, 800.0)

fn _narrow() -> MediaEnvironment:
    media_environment_screen(320.0, 640.0)

fn _dark() -> MediaEnvironment:
    val base = media_environment_screen(1200.0, 800.0)
    MediaEnvironment(
        media_type: base.media_type,
        width_px: base.width_px,
        height_px: base.height_px,
        font_size_px: base.font_size_px,
        resolution_dppx: 2.0,
        color_bits: base.color_bits,
        prefers_dark: true,
        prefers_reduced_motion: base.prefers_reduced_motion,
    )

# @manual_section: Width and height
describe "dimension features":
    """
    As a browser engine, I want min-width and max-width queries answered
    against the real viewport, so that a responsive stylesheet selects the
    layout the author designed for the size actually being rendered.
    """

    # @req REQ-CSS-MEDIA-WIDTH
    it "matches a min-width the viewport exceeds":
        step("evaluate `(min-width: 600px)` at 1200px wide")
        expect(_verdict("(min-width: 600px)", _wide())).to_equal("match")

    # @req REQ-CSS-MEDIA-WIDTH
    it "does not match a min-width the viewport falls short of":
        step("evaluate `(min-width: 600px)` at 320px wide")
        expect(_verdict("(min-width: 600px)", _narrow())).to_equal("no-match")

    # @req REQ-CSS-MEDIA-WIDTH
    it "matches a max-width at its exact boundary":
        step("evaluate `(max-width: 320px)` at 320px wide — max-width is inclusive")
        expect(_verdict("(max-width: 320px)", _narrow())).to_equal("match")

    # @req REQ-CSS-MEDIA-WIDTH
    it "resolves an em width against the root font size":
        step("evaluate `(min-width: 30em)` at 320px with a 16px root font: 30em is 480px")
        expect(_verdict("(min-width: 30em)", _narrow())).to_equal("no-match")

    # @req REQ-CSS-MEDIA-WIDTH
    it "answers the Level 4 range form":
        step("evaluate `(width >= 600px)` at 1200px wide")
        expect(_verdict("(width >= 600px)", _wide())).to_equal("match")

    # @req REQ-CSS-MEDIA-UNEVALUATED
    it "reports the two-sided range form as unevaluated rather than guessing":
        step("evaluate `(400px < width < 700px)`, a form this engine does not implement")
        expect(_verdict("(400px < width < 700px)", _wide())).to_equal("unevaluated")

# @manual_section: Non-dimension features
describe "orientation, scheme and resolution":
    """
    As a browser engine, I want orientation, colour-scheme and resolution
    queries answered from the environment I was handed, so that a dark-mode or
    high-DPI stylesheet applies exactly when the environment says it should.
    """

    # @req REQ-CSS-MEDIA-ORIENTATION
    it "reads a wider-than-tall viewport as landscape":
        step("evaluate `(orientation: landscape)` at 1200x800")
        expect(_verdict("(orientation: landscape)", _wide())).to_equal("match")

    # @req REQ-CSS-MEDIA-ORIENTATION
    it "reads a taller-than-wide viewport as portrait":
        step("evaluate `(orientation: landscape)` at 320x640")
        expect(_verdict("(orientation: landscape)", _narrow())).to_equal("no-match")

    # @req REQ-CSS-MEDIA-SCHEME
    it "matches a dark scheme query only when the environment prefers dark":
        step("evaluate `(prefers-color-scheme: dark)` in both environments")
        expect(_verdict("(prefers-color-scheme: dark)", _dark())).to_equal("match")
        expect(_verdict("(prefers-color-scheme: dark)", _wide())).to_equal("no-match")

    # @req REQ-CSS-MEDIA-RESOLUTION
    it "matches a min-resolution against a 2x environment":
        step("evaluate `(min-resolution: 2dppx)` at 2dppx")
        expect(_verdict("(min-resolution: 2dppx)", _dark())).to_equal("match")

    # @req REQ-CSS-MEDIA-RESOLUTION
    it "converts dpi to dppx before comparing":
        step("evaluate `(min-resolution: 192dpi)`, which is 2dppx")
        expect(_verdict("(min-resolution: 192dpi)", _dark())).to_equal("match")

# @manual_section: Media types and logic
describe "media types and logical operators":
    """
    As a browser engine, I want the media type and the and/or/not operators
    honoured, so that a print stylesheet never reaches a screen and a compound
    query means what its author wrote.
    """

    # @req REQ-CSS-MEDIA-TYPE
    it "matches a screen query on a screen":
        step("evaluate `screen`")
        expect(_verdict("screen", _wide())).to_equal("match")

    # @req REQ-CSS-MEDIA-TYPE
    it "does not match a print query on a screen":
        step("evaluate `print`")
        expect(_verdict("print", _wide())).to_equal("no-match")

    # @req REQ-CSS-MEDIA-TYPE
    it "matches `all` regardless of the media type":
        step("evaluate `all`")
        expect(_verdict("all", _wide())).to_equal("match")

    # @req REQ-CSS-MEDIA-TYPE
    it "ignores the `only` prefix, which exists solely to hide from old parsers":
        step("evaluate `only screen and (min-width: 600px)`")
        expect(_verdict("only screen and (min-width: 600px)", _wide())).to_equal("match")

    # @req REQ-CSS-MEDIA-LOGIC
    it "requires every operand of an and-chain":
        step("evaluate a chain whose second half is false")
        expect(_verdict("screen and (min-width: 600px) and (max-width: 700px)", _wide())).to_equal("no-match")

    # @req REQ-CSS-MEDIA-LOGIC
    it "matches a comma list when any single query matches":
        step("evaluate `print, (min-width: 600px)` on a wide screen")
        expect(_verdict("print, (min-width: 600px)", _wide())).to_equal("match")

    # @req REQ-CSS-MEDIA-LOGIC
    it "inverts a type query under not":
        step("evaluate `not print` on a screen")
        expect(_verdict("not print", _wide())).to_equal("match")

    # @req REQ-CSS-MEDIA-LOGIC
    it "treats an empty query as `all`":
        step("evaluate an empty prelude")
        expect(_verdict("", _wide())).to_equal("match")

# @manual_section: The failure contract
describe "unevaluatable queries":
    """
    As a browser engine, I want a media feature I do not implement reported as
    unevaluated rather than as a match or a non-match, so that the gap shows up
    as one reportable line instead of as a page that is quietly styled wrong.
    """

    # @req REQ-CSS-MEDIA-UNEVALUATED
    it "reports an unknown feature as unevaluated, not as a match":
        step("evaluate `(hover: hover)`, a feature this engine does not implement")
        expect(_verdict("(hover: hover)", _wide())).to_equal("unevaluated")

    # @req REQ-CSS-MEDIA-UNEVALUATED
    it "reports an unknown unit as unevaluated rather than reading the number bare":
        step("evaluate `(min-width: 40qq)`")
        expect(_verdict("(min-width: 40qq)", _wide())).to_equal("unevaluated")

    # @req REQ-CSS-MEDIA-UNEVALUATED
    it "keeps a negated unknown unknown":
        step("evaluate `not (hover: hover)` — negating an unknown does not make it known")
        expect(_verdict("not (hover: hover)", _wide())).to_equal("unevaluated")

    # @req REQ-CSS-MEDIA-UNEVALUATED
    it "lets a decided false operand settle an and-chain containing an unknown":
        step("evaluate `print and (hover: hover)` on a screen — print already decides it")
        expect(_verdict("print and (hover: hover)", _wide())).to_equal("no-match")

    # @req REQ-CSS-MEDIA-UNEVALUATED
    it "lets a matching sibling settle a comma list containing an unknown":
        step("evaluate `(min-width: 600px), (hover: hover)` on a wide screen")
        expect(_verdict("(min-width: 600px), (hover: hover)", _wide())).to_equal("match")

    # @req REQ-CSS-MEDIA-UNEVALUATED
    it "reports an otherwise-false list containing an unknown as unevaluated":
        step("evaluate `(min-width: 6000px), (hover: hover)` on a wide screen")
        expect(_verdict("(min-width: 6000px), (hover: hover)", _wide())).to_equal("unevaluated")

    # @req REQ-CSS-MEDIA-UNEVALUATED
    it "names the features it can actually answer":
        step("check that the supported-feature list is non-empty and finite")
        val features = supported_media_features()
        val bounded = features.len() > 0 and features.len() < 50
        expect(bounded).to_equal(true)
