"""
## Purpose and audience
Purpose: Prove that ctype.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

use std.spec.{describe, it, expect}
use std.common.ctype.{is_digit, is_upper, is_lower, is_alpha, is_alnum, is_xdigit, is_space, to_lower, to_upper}

describe "ctype":
    it "classifies digits correctly":
        step("Verify: classifies digits correctly")
        # @req: REQ-LIB-COMMON-001
        expect(is_digit(48)).to_equal(true)
        expect(is_digit(57)).to_equal(true)
        expect(is_digit(47)).to_equal(false)
        expect(is_digit(58)).to_equal(false)
        expect(is_digit(65)).to_equal(false)

    it "classifies upper case correctly":
        step("Verify: classifies upper case correctly")
        expect(is_upper(65)).to_equal(true)
        expect(is_upper(90)).to_equal(true)
        expect(is_upper(64)).to_equal(false)
        expect(is_upper(91)).to_equal(false)
        expect(is_upper(97)).to_equal(false)

    it "classifies lower case correctly":
        step("Verify: classifies lower case correctly")
        expect(is_lower(97)).to_equal(true)
        expect(is_lower(122)).to_equal(true)
        expect(is_lower(96)).to_equal(false)
        expect(is_lower(123)).to_equal(false)
        expect(is_lower(65)).to_equal(false)

    it "classifies alpha correctly":
        step("Verify: classifies alpha correctly")
        expect(is_alpha(65)).to_equal(true)
        expect(is_alpha(90)).to_equal(true)
        expect(is_alpha(97)).to_equal(true)
        expect(is_alpha(122)).to_equal(true)
        expect(is_alpha(48)).to_equal(false)
        expect(is_alpha(32)).to_equal(false)

    it "classifies alnum correctly":
        step("Verify: classifies alnum correctly")
        expect(is_alnum(65)).to_equal(true)
        expect(is_alnum(97)).to_equal(true)
        expect(is_alnum(48)).to_equal(true)
        expect(is_alnum(57)).to_equal(true)
        expect(is_alnum(32)).to_equal(false)
        expect(is_alnum(33)).to_equal(false)

    it "classifies hex digits correctly":
        step("Verify: classifies hex digits correctly")
        expect(is_xdigit(48)).to_equal(true)
        expect(is_xdigit(57)).to_equal(true)
        expect(is_xdigit(65)).to_equal(true)
        expect(is_xdigit(70)).to_equal(true)
        expect(is_xdigit(97)).to_equal(true)
        expect(is_xdigit(102)).to_equal(true)
        expect(is_xdigit(71)).to_equal(false)
        expect(is_xdigit(103)).to_equal(false)
        expect(is_xdigit(32)).to_equal(false)

    it "classifies whitespace correctly":
        step("Verify: classifies whitespace correctly")
        expect(is_space(32)).to_equal(true)
        expect(is_space(9)).to_equal(true)
        expect(is_space(10)).to_equal(true)
        expect(is_space(13)).to_equal(true)
        expect(is_space(11)).to_equal(true)
        expect(is_space(12)).to_equal(true)
        expect(is_space(65)).to_equal(false)
        expect(is_space(48)).to_equal(false)

    it "converts to lower case":
        step("Verify: converts to lower case")
        expect(to_lower(65)).to_equal(97)  # oracle: 97 — named expected value from the requirement
        expect(to_lower(90)).to_equal(122)  # oracle: 122 — named expected value from the requirement
        expect(to_lower(97)).to_equal(97)  # oracle: 97 — named expected value from the requirement
        expect(to_lower(48)).to_equal(48)  # oracle: 48 — named expected value from the requirement

    it "converts to upper case":
        step("Verify: converts to upper case")
        expect(to_upper(97)).to_equal(65)  # oracle: 65 — named expected value from the requirement
        expect(to_upper(122)).to_equal(90)  # oracle: 90 — named expected value from the requirement
        expect(to_upper(65)).to_equal(65)  # oracle: 65 — named expected value from the requirement
        expect(to_upper(48)).to_equal(48)  # oracle: 48 — named expected value from the requirement
