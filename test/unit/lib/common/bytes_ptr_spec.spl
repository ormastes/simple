"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/common/bytes_ptr_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Spec: [u8].ptr() + .len() — used by SPM syscall wrappers to pass
# buffer pointers through the 5-arg syscall ABI.
#
# Interpreter representation of [u8] is Arc<Vec<Value>> — .ptr() returns
# the backing Vec data address (non-zero, stable per-slice), NOT a tight
# byte buffer. This is sufficient for mock-transport tests today. Real
# kernel calls from compiled mode (LLVM/Cranelift) use fat-pointer ABI
# which yields the true byte-array address at codegen time.

use std.spec

describe("byte slice .ptr() and .len()"):

    it("empty slice has len 0"):
        # @req: REQ-UNIT-LIB-001
        step("Verify: empty slice has len 0")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val b: [u8] = []
        expect(b.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it("non-empty slice has non-zero ptr"):
        # @req: REQ-UNIT-LIB-002
        step("Verify: non-empty slice has non-zero ptr")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val b: [u8] = [1 as u8, 2 as u8, 3 as u8]
        val p = b.ptr()
        expect(p != 0).to_equal(true)

    it("same slice returns same ptr twice"):
        # @req: REQ-UNIT-LIB-003
        step("Verify: same slice returns same ptr twice")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val b: [u8] = [42 as u8, 99 as u8]
        val p1 = b.ptr()
        val p2 = b.ptr()
        expect(p1).to_equal(p2)

    it("len matches slice length"):
        # @req: REQ-UNIT-LIB-004
        step("Verify: len matches slice length")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val b: [u8] = [10 as u8, 20 as u8, 30 as u8, 40 as u8, 50 as u8]
        expect(b.len()).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

    it("val binding keeps ptr stable"):
        # @req: REQ-UNIT-LIB-005
        step("Verify: val binding keeps ptr stable")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val raw: [u8] = [7 as u8, 8 as u8]
        val p_before = raw.ptr()
        val also = raw
        val p_after = also.ptr()
        expect(p_before).to_equal(p_after)

    it("two independent slices have independent ptrs"):
        # @req: REQ-UNIT-LIB-006
        step("Verify: two independent slices have independent ptrs")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # NOTE: coincidence collision is allowed but extremely unlikely.
        val a: [u8] = [1 as u8, 2 as u8, 3 as u8, 4 as u8]
        val b: [u8] = [5 as u8, 6 as u8, 7 as u8, 8 as u8]
        val pa = a.ptr()
        val pb = b.ptr()
        expect(pa != 0).to_equal(true)
        expect(pb != 0).to_equal(true)
