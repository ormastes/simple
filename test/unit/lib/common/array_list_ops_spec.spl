"""
## Purpose and audience
Covers the `std.array` list-manipulation utilities migrated from list_utils:
reverse, take, drop, chunk, windows, interleave, flatten, intersperse, rotate,
dedup, dedup_all, sorted-check, and equality. Audience: stdlib maintainers and
operators verifying a build. Every scenario calls the real `std.array` product
functions and asserts their returned arrays.

## Operator workflow
Run `simple run test/unit/lib/common/array_list_ops_spec.spl` from the repo
root and confirm the results line reports 0 failed. Each scenario names the
requirement it traces to, starts with an imperative step, retains a statistics
capture, and explains every numeric oracle inline.

## Compatibility and limitations
Covers only the behavior explicitly asserted below on the current toolchain.
Boundary behavior is pinned at the documented edges: negative counts are
no-ops for drop and chunk, oversize take clamps to the full input, and a zero
or negative chunk size yields an empty outer array. Element types beyond
integers and empty-input edges beyond those asserted are not covered.

## Verification guidance and troubleshooting
Re-run the single spec file and read the first failing step. A length-oracle
failure means the function returned the wrong number of groups or elements;
an element-oracle failure means ordering or content regressed. Compare the
reported array against the inline oracle comment before bisecting std.array.
"""
# Lifecycle: doc/01_research/lib/collections_impl/collections.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/compiler/00_compiler_architecture.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: std-array-list-ops

use std.spec.step
use std.array.{array_reverse, array_take, array_drop}
use std.array.{array_chunk, array_windows}
use std.array.{array_interleave, array_flatten, array_intersperse}
use std.array.{array_rotate_left, array_rotate_right}
use std.array.{array_dedup, array_dedup_all}
use std.array.{array_is_sorted, array_equals}

describe "std.array (list_utils migration)":
    describe "array_reverse":
        it "returns a list of same length":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): reversed-array length observation
            step("Reverse a three-element list and observe its length")
            val result = array_reverse([1, 2, 3])
            expect(result.len()).to_equal(3)  # oracle: reversal must preserve the three input elements

        it "handles empty list":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): reversed empty-array observation
            step("Reverse an empty list")
            expect(array_reverse([])).to_equal([])  # oracle: reversing zero elements must yield zero elements

    describe "array_take":
        it "takes first n elements":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): take prefix content
            step("Take the first three of five elements")
            expect(array_take([1, 2, 3, 4, 5], 3)).to_equal([1, 2, 3])  # oracle: the prefix must keep input order and stop at three elements

        it "returns all if n > length":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): oversize-take clamp behavior
            step("Take five elements from a two-element list")
            expect(array_take([1, 2], 5)).to_equal([1, 2])  # oracle: an oversize count must clamp to the whole input, not pad or fail

    describe "array_drop":
        it "drops first n elements":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): drop remainder content
            step("Drop the first two of five elements")
            expect(array_drop([1, 2, 3, 4, 5], 2)).to_equal([3, 4, 5])  # oracle: the remainder must start after the dropped prefix in input order

        it "drops nothing for negative count":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): negative-drop no-op behavior
            step("Drop a negative count and observe the untouched input")
            step("Verify: drops nothing for negative count")
            expect(array_drop([1, 2, 3], -1)).to_equal([1, 2, 3])  # oracle: a negative count names no prefix, so the input must pass through untouched

    describe "array_chunk":
        it "splits into chunks of size":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): chunk group count and edge chunks
            step("Chunk five elements into groups of two")
            val chunks = array_chunk([1, 2, 3, 4, 5], 2)
            expect(chunks.len()).to_equal(3)  # oracle: ceil(5/2) = 3 groups — two full pairs plus the remainder
            expect(chunks[0]).to_equal([1, 2])  # oracle: the first group holds the first pair in input order
            expect(chunks[2]).to_equal([5])  # oracle: the odd element must land alone in the final group

        it "returns empty array for invalid chunk size":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): invalid chunk size guard behavior
            step("Chunk with a zero and a negative size")
            step("Verify: returns empty array for invalid chunk size")
            expect(array_chunk([1, 2, 3], 0)).to_equal([])  # oracle: a zero size cannot form any group, so the guard yields no chunks
            expect(array_chunk([1, 2, 3], -1)).to_equal([])  # oracle: a negative size is equally unformable and must hit the same guard

    describe "array_windows":
        it "creates sliding windows":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): sliding-window count and content
            step("Slide a two-element window across four elements")
            val wins = array_windows([1, 2, 3, 4], 2)
            expect(wins.len()).to_equal(3)  # oracle: a size-2 window over 4 elements slides to 4-2+1 = 3 positions
            expect(wins[0]).to_equal([1, 2])  # oracle: the first window starts at the first element
            expect(wins[1]).to_equal([2, 3])  # oracle: the second window slides exactly one element forward

    describe "array_interleave":
        it "interleaves two lists":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): interleaved ordering
            step("Interleave an odd-indexed and an even-indexed list")
            val result = array_interleave([1, 3, 5], [2, 4, 6])
            expect(result).to_equal([1, 2, 3, 4, 5, 6])  # oracle: strict alternation of the two inputs must reconstruct the sorted sequence

    describe "array_flatten":
        it "flattens nested lists":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): flattened element order
            step("Flatten a three-row nested list")
            val result = array_flatten([[1, 2], [3, 4], [5]])
            expect(result).to_equal([1, 2, 3, 4, 5])  # oracle: rows must concatenate left to right, preserving inner order

    describe "array_intersperse":
        it "inserts separator between elements":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): interspersed separator placement
            step("Intersperse zero between three elements")
            val result = array_intersperse([1, 2, 3], 0)
            expect(result).to_equal([1, 0, 2, 0, 3])  # oracle: the separator belongs strictly between elements, never at the ends

    describe "array_rotate_left":
        it "rotates list left":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): left-rotation result order
            step("Rotate a four-element list left by one")
            val result = array_rotate_left([1, 2, 3, 4], 1)
            expect(result).to_equal([2, 3, 4, 1])  # oracle: the head element wraps to the tail exactly once

    describe "array_rotate_right":
        it "rotates list right":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): right-rotation result order
            step("Rotate a four-element list right by one")
            val result = array_rotate_right([1, 2, 3, 4], 1)
            expect(result).to_equal([4, 1, 2, 3])  # oracle: the tail element wraps to the head exactly once

    describe "array_dedup":
        it "removes consecutive duplicates":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): consecutive-dedup result
            step("Dedup runs of repeated adjacent elements")
            val result = array_dedup([1, 1, 2, 2, 3, 3])
            expect(result).to_equal([1, 2, 3])  # oracle: each adjacent run must collapse to its first occurrence

        it "preserves non-consecutive duplicates":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): non-consecutive duplicate preservation
            step("Dedup a list whose duplicates are not adjacent")
            val result = array_dedup([1, 2, 1, 2])
            expect(result).to_equal([1, 2, 1, 2])  # oracle: only ADJACENT duplicates collapse, so the alternating list is unchanged

    describe "array_dedup_all":
        it "removes all duplicates":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): global-dedup distinct count
            step("Dedup all duplicates from a five-element list")
            val result = array_dedup_all([1, 2, 1, 3, 2])
            expect(result.len()).to_equal(3)  # oracle: the input holds exactly three distinct values, 1, 2, and 3

    describe "array_is_sorted":
        it "checks if list is sorted":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): sorted-predicate verdicts
            step("Check the sorted predicate on ascending, unsorted, and empty inputs")
            expect(array_is_sorted([1, 2, 3])).to_equal(true)  # oracle: ascending order satisfies the predicate
            expect(array_is_sorted([3, 1, 2])).to_equal(false)  # oracle: the 3-to-1 descent violates the predicate
            expect(array_is_sorted([])).to_equal(true)  # oracle: an empty sequence is vacuously sorted

    describe "array_equals":
        it "checks equality":
            # @req REQ-LIB-ARRAY-001
            # @capture(statistics): array-equality verdicts
            step("Compare identical and differing arrays")
            expect(array_equals([1, 2, 3], [1, 2, 3])).to_equal(true)  # oracle: same length, same order, same elements
            expect(array_equals([1, 2], [1, 3])).to_equal(false)  # oracle: the differing last element must break equality
