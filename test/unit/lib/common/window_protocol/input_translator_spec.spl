"""
## Purpose and audience
Purpose: Prove that key_char_to_wm_key_event.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-COMMON-001 — stable requirement identity for this spec.

# Tests for common.window_protocol.input_translator.

use common.window_protocol.geometry.{WindowId, Modifiers, WmEventType}
use common.window_protocol.window_protocol.{WmInputEvent}
use common.window_protocol.input_translator.{ascii_code_for_key, key_char_to_wm_key_event,
    pointer_to_wm_mouse_event, wheel_to_wm_scroll_event}

use std.spec.step

describe "key_char_to_wm_key_event":
    context "when key_char is nil":
        it "produces key_code 0 and KeyDown with correct window_id":
            step("Verify: produces key_code 0 and KeyDown with correct window_id")
            # @req: REQ-LIB-COMMON-001
            val evt = key_char_to_wm_key_event(WindowId(value: 42), nil)
            expect(evt.key_code.code).to_equal(0 as u32)
            expect(evt.event_type).to_equal(WmEventType.KeyDown)
            expect(evt.window_id.value).to_equal(42)  # oracle: 42 — named expected value from the requirement

    context "when key_char is a lowercase letter":
        it "maps 'a' to key_code 97 and passes window_id through":
            step("Verify: maps 'a' to key_code 97 and passes window_id through")
            val evt = key_char_to_wm_key_event(WindowId(value: 7), "a")
            expect(evt.key_code.code).to_equal(97 as u32)
            expect(evt.key_code.name).to_equal("a")
            expect(evt.window_id.value).to_equal(7)  # oracle: 7 — named expected value from the requirement
            expect(evt.event_type).to_equal(WmEventType.KeyDown)

    context "when key_char is an uppercase letter":
        it "maps 'A' to key_code 65":
            step("Verify: maps 'A' to key_code 65")
            val evt = key_char_to_wm_key_event(WindowId(value: 0), "A")
            expect(evt.key_code.code).to_equal(65 as u32)
            expect(evt.event_type).to_equal(WmEventType.KeyDown)
            expect(evt.window_id.value).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "mouse_pos defaults":
        it "mouse_x and mouse_y are 0 for key events":
            step("Verify: mouse_x and mouse_y are 0 for key events")
            val evt = key_char_to_wm_key_event(WindowId(value: 1), "z")
            expect(evt.point.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(evt.point.y).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "committed text":
    it "keeps Unicode text separate from physical key events":
        step("Verify: keeps Unicode text separate from physical key events")
        val evt = WmInputEvent.text_input(WindowId(value: 42), "é한")
        expect(evt.event_type).to_equal(WmEventType.Text)
        expect(evt.window_id.value).to_equal(42)  # oracle: 42 — named expected value from the requirement
        expect(evt.committed_text).to_equal("é한")
        expect(evt.key_code.code).to_equal(0 as u32)

describe "pointer_to_wm_mouse_event":
    it "maps pointer down, up, and move into typed WM input events":
        step("Verify: maps pointer down, up, and move into typed WM input events")
        val mods = Modifiers(shift: true, ctrl: false, alt: false, meta: false)
        val down = pointer_to_wm_mouse_event(WindowId(value: 9), "pointer_down", 10, 20, mods)
        val up = pointer_to_wm_mouse_event(WindowId(value: 9), "pointer_up", 11, 21, mods)
        val moved = pointer_to_wm_mouse_event(WindowId(value: 9), "move", 12, 22, mods)

        expect(down.event_type).to_equal(WmEventType.MouseDown)
        expect(up.event_type).to_equal(WmEventType.MouseUp)
        expect(moved.event_type).to_equal(WmEventType.MouseMove)
        expect(down.point.x).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(down.point.y).to_equal(20)  # oracle: 20 — named expected value from the requirement
        expect(down.modifiers.shift).to_equal(true)

describe "wheel_to_wm_scroll_event":
    it "preserves scroll delta, coordinates, window_id, and modifiers":
        step("Verify: preserves scroll delta, coordinates, window_id, and modifiers")
        val mods = Modifiers(shift: false, ctrl: true, alt: false, meta: false)
        val evt = wheel_to_wm_scroll_event(WindowId(value: 5), 30, 40, 1.5, -8.0, mods)

        expect(evt.event_type).to_equal(WmEventType.Scroll)
        expect(evt.window_id.value).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(evt.point.x).to_equal(30)  # oracle: 30 — named expected value from the requirement
        expect(evt.point.y).to_equal(40)  # oracle: 40 — named expected value from the requirement
        expect(evt.scroll_dx).to_equal(1.5)  # oracle: 1.5 — named expected value from the requirement
        expect(evt.scroll_dy).to_equal(-8.0)  # oracle: -8.0 — named expected value from the requirement
        expect(evt.modifiers.ctrl).to_equal(true)

describe "ascii_code_for_key":
    it "uses the first character and returns 0 for unsupported or empty keys":
        step("Verify: uses the first character and returns 0 for unsupported or empty keys")
        expect(ascii_code_for_key("ab")).to_equal(97 as u32)
        expect(ascii_code_for_key("")).to_equal(0 as u32)
        expect(ascii_code_for_key(nil)).to_equal(0 as u32)
