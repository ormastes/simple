"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/common/spec_framework_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# SPipe Framework - Self-Test
#
# Tests the built-in test framework matchers.
# Uses only matchers supported by the bootstrap runtime.
#
# Supported: to_equal, to_be, to_be_nil, to_contain,
#            to_start_with, to_end_with,
#            to_be_greater_than, to_be_less_than
#
# No try/catch/throw - Simple does not support exceptions.


describe "SPipe Framework":

    context "describe and context nesting":

        it "runs basic test":
            # @req: REQ-UNIT-LIB-001
            step("Verify: runs basic test")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(1 + 1).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

        it "supports nested context":
            # @req: REQ-UNIT-LIB-002
            step("Verify: supports nested context")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(true).to_equal(true)

    context "expect() matchers":

        it "to_equal checks equality":
            # @req: REQ-UNIT-LIB-003
            step("Verify: to_equal checks equality")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(42).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec
            expect("hello").to_equal("hello")

        it "to_be is alias for to_equal":
            # @req: REQ-UNIT-LIB-004
            step("Verify: to_be is alias for to_equal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(10).to_be(10)

        it "to_equal true checks boolean true":
            # @req: REQ-UNIT-LIB-005
            step("Verify: to_equal true checks boolean true")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(true).to_equal(true)

        it "to_equal false checks boolean false":
            # @req: REQ-UNIT-LIB-006
            step("Verify: to_equal false checks boolean false")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(false).to_equal(false)

        it "to_be_nil checks nil":
            # @req: REQ-UNIT-LIB-007
            step("Verify: to_be_nil checks nil")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(nil).to_be_nil()

        it "to_contain checks string membership":
            # @req: REQ-UNIT-LIB-008
            step("Verify: to_contain checks string membership")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect("hello world").to_contain("world")

        it "to_contain checks array membership":
            # @req: REQ-UNIT-LIB-009
            step("Verify: to_contain checks array membership")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect([1, 2, 3]).to_contain(2)

        it "to_start_with checks prefix":
            # @req: REQ-UNIT-LIB-010
            step("Verify: to_start_with checks prefix")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect("hello").to_start_with("hel")

        it "to_end_with checks suffix":
            # @req: REQ-UNIT-LIB-011
            step("Verify: to_end_with checks suffix")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect("hello").to_end_with("llo")

        it "to_be_greater_than compares":
            # @req: REQ-UNIT-LIB-012
            step("Verify: to_be_greater_than compares")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(10).to_be_greater_than(5)

        it "to_be_less_than compares":
            # @req: REQ-UNIT-LIB-013
            step("Verify: to_be_less_than compares")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(5).to_be_less_than(10)

    context "value comparisons":

        it "equality with strings":
            # @req: REQ-UNIT-LIB-014
            step("Verify: equality with strings")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect("abc").to_equal("abc")

        it "equality with arrays":
            # @req: REQ-UNIT-LIB-015
            step("Verify: equality with arrays")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect([1, 2]).to_equal([1, 2])

        it "nil equality":
            # @req: REQ-UNIT-LIB-016
            step("Verify: nil equality")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(nil).to_be_nil()
            expect(nil).to_equal(nil)
