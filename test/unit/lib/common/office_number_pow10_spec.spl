# @covers src/lib/common/office/number.spl 80%
"""
## Purpose and audience
# Office Number pow10 Specification

**Feature IDs:** #LIB-OFFICE-NUMBER
**Category:** Stdlib
**Status:** Implemented

## Overview

Tests office_pow10_f64 and office_pow10_i64, which compute 10^exp for small
non-negative exponents. office_pow10_i64 delegates to office_pow10_f64 and
converts, so both must agree for representable values.
"""

use std.spec.step
use common.office.number.{office_pow10_f64, office_pow10_i64}


# @req: REQ-COMMON-OfficeNumberPow10-001
describe "office number - pow10":
    context "office_pow10_f64":
        it "returns 1.0 for exponent 0":
            # @req: REQ-COMMON-OfficeNumberPow10-001
            step("Verify: returns 1.0 for exponent 0")
            expect(office_pow10_f64(0)).to_equal(1.0)  # oracle: value fixed by the spec contract

        it "returns 100.0 for exponent 2":
            # @req: REQ-COMMON-OfficeNumberPow10-001
            step("Verify: returns 100.0 for exponent 2")
            expect(office_pow10_f64(2)).to_equal(100.0)  # oracle: value fixed by the spec contract

        it "returns 10000.0 for exponent 4":
            # @req: REQ-COMMON-OfficeNumberPow10-001
            step("Verify: returns 10000.0 for exponent 4")
            expect(office_pow10_f64(4)).to_equal(10000.0)  # oracle: value fixed by the spec contract

    context "office_pow10_i64":
        it "returns 1 for exponent 0":
            # @req: REQ-COMMON-OfficeNumberPow10-001
            step("Verify: returns 1 for exponent 0")
            expect(office_pow10_i64(0)).to_equal(1)  # oracle: value fixed by the spec contract

        it "returns 100 for exponent 2":
            # @req: REQ-COMMON-OfficeNumberPow10-001
            step("Verify: returns 100 for exponent 2")
            expect(office_pow10_i64(2)).to_equal(100)  # oracle: value fixed by the spec contract

        it "returns 10000 for exponent 4":
            # @req: REQ-COMMON-OfficeNumberPow10-001
            step("Verify: returns 10000 for exponent 4")
            expect(office_pow10_i64(4)).to_equal(10000)  # oracle: value fixed by the spec contract

    context "office_pow10_i64 agrees with office_pow10_f64":
        it "matches at exponent 3":
            # @req: REQ-COMMON-OfficeNumberPow10-001
            step("Verify: matches at exponent 3")
            expect(office_pow10_i64(3)).to_equal(office_pow10_f64(3).to_i64())
