# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Format spec
#
# Tests for src/lib/format.spl

use std.spec.step

use std.format.{
    str_repeat, format_left, format_right, format_center,
    format_zero_pad, format_hex, format_hex_upper, format_binary,
    format_fixed, format_signed, format_align
}

describe "format stdlib":
    # @manual scenario evidence
    describe "str_repeat":
        it "repeats string N times":
            # @req REQ-SSPEC-UNIT
            step("repeats string N times")
            expect(str_repeat("ab", 3)).to_equal("ababab")

        it "repeat 0 times gives empty":
            # @req REQ-SSPEC-UNIT
            step("repeat 0 times gives empty")
            expect(str_repeat("x", 0)).to_equal("")

    describe "format_left":
        it "pads right with spaces":
            # @req REQ-SSPEC-UNIT
            step("pads right with spaces")
            expect(format_left("hi", 5)).to_equal("hi   ")

        it "no padding if already long enough":
            # @req REQ-SSPEC-UNIT
            step("no padding if already long enough")
            expect(format_left("hello", 3)).to_equal("hello")

    describe "format_right":
        it "pads left with spaces":
            # @req REQ-SSPEC-UNIT
            step("pads left with spaces")
            expect(format_right("hi", 5)).to_equal("   hi")

        it "no padding if already long enough":
            # @req REQ-SSPEC-UNIT
            step("no padding if already long enough")
            expect(format_right("hello", 3)).to_equal("hello")

    describe "format_zero_pad":
        it "pads with zeros":
            # @req REQ-SSPEC-UNIT
            step("pads with zeros")
            expect(format_zero_pad("42", 5)).to_equal("00042")

        it "no padding if long enough":
            # @req REQ-SSPEC-UNIT
            step("no padding if long enough")
            expect(format_zero_pad("12345", 3)).to_equal("12345")

    describe "format_hex":
        it "formats zero":
            # @req REQ-SSPEC-UNIT
            step("formats zero")
            expect(format_hex(0)).to_equal("0")

        it "formats decimal 255":
            # @req REQ-SSPEC-UNIT
            step("formats decimal 255")
            expect(format_hex(255)).to_equal("ff")

        it "formats decimal 16":
            # @req REQ-SSPEC-UNIT
            step("formats decimal 16")
            expect(format_hex(16)).to_equal("10")

    describe "format_hex_upper":
        it "formats uppercase hex":
            # @req REQ-SSPEC-UNIT
            step("formats uppercase hex")
            expect(format_hex_upper(255)).to_equal("FF")

    describe "format_binary":
        it "formats zero":
            # @req REQ-SSPEC-UNIT
            step("formats zero")
            expect(format_binary(0)).to_equal("0")

        it "formats 8 as binary":
            # @req REQ-SSPEC-UNIT
            step("formats 8 as binary")
            expect(format_binary(8)).to_equal("1000")

        it "formats 255 as binary":
            # @req REQ-SSPEC-UNIT
            step("formats 255 as binary")
            expect(format_binary(255)).to_equal("11111111")

    describe "format_signed":
        it "positive with plus sign":
            # @req REQ-SSPEC-UNIT
            step("positive with plus sign")
            expect(format_signed(42)).to_equal("+42")

        it "negative keeps minus":
            # @req REQ-SSPEC-UNIT
            step("negative keeps minus")
            expect(format_signed(-5)).to_equal("-5")

    describe "format_align":
        it "left align":
            # @req REQ-SSPEC-UNIT
            step("left align")
            expect(format_align("x", 3, "left")).to_equal("x  ")

        it "right align":
            # @req REQ-SSPEC-UNIT
            step("right align")
            expect(format_align("x", 3, "right")).to_equal("  x")
