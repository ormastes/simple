# @req: REQ-LIB-LIB-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/lib/branch_coverage_5_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/branch_coverage_5.md
# doc-path: doc/03_plan/sys_test/branch_coverage_5.md
# doc-path: doc/04_architecture/branch_coverage_5.md
# doc-path: doc/05_design/branch_coverage_5.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "if-else arm executes on false condition":
        step("Verify: if-else arm executes on false condition")
        # @req: REQ-LIB-LIB-001
        var r = 0
        if 2 > 5:
            r = 1
        else:
            r = 2
        expect(r).to_equal(2)  # oracle: else arm taken

    it "match falls through to default arm":
        step("Verify: match falls through to default arm")
        # @req: REQ-LIB-LIB-001
        val k = 99
        var r = 0
        match k:
            1: r = 10
            2: r = 20
            _: r = -1
        expect(r).to_equal(-1)  # oracle: default arm

    it "deeply nested true chain reaches innermost arm":
        step("Verify: deeply nested true chain reaches innermost arm")
        # @req: REQ-LIB-LIB-001
        var r = 0
        if 1 == 1:
            if 2 == 2:
                if 3 == 3:
                    r = 7
        expect(r).to_equal(7)  # oracle: all three guards true

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "continue skips the rest of the body":
        step("Verify: continue skips the rest of the body")
        # @req: REQ-LIB-LIB-001
        var c = 0
        for i in 0..5:
            if i == 2: continue
            c = c + 1
        expect(c).to_equal(4)  # oracle: one skipped iteration

    it "match Some binds the payload":
        step("Verify: match Some binds the payload")
        # @req: REQ-LIB-LIB-001
        var r = 0
        match Some(5):
            Some(x): r = x
            nil: r = -1
        expect(r).to_equal(5)  # oracle: payload bound

    it "for loop over empty range runs zero times":
        step("Verify: for loop over empty range runs zero times")
        # @req: REQ-LIB-LIB-001
        var c = 5
        for i in 2..2:
            c = c + 1
        expect(c).to_equal(5)  # oracle: body never entered
