"""
## Purpose and audience
Purpose: Verify DB posting-list bitmap primitives.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-POSTING-LIST-BITMAP-001 — stable requirement identity for this spec.

use std.spec
use std.db.accel.{
    posting_list_new,
    posting_list_to_bitmap,
    posting_lists_and_bitmap,
    posting_lists_or_bitmap,
    posting_bitmap_result_rows
}

describe "DB posting-list bitmap primitives":
    it "materializes one posting list into a row bitmap":
        step("Verify: materializes one posting list into a row bitmap")
        # @req: REQ-LIB-POSTING-LIST-BITMAP-001
        val result = posting_list_to_bitmap(posting_list_new("simple", [1, 3, 5]), 8)
        val rows = posting_bitmap_result_rows(result)

        expect(result.terms_evaluated).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(result.postings_scanned).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(result.rows_matched).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(rows).to_equal([1, 3, 5])

    it "evaluates token AND with bitmap intersection":
        step("Verify: evaluates token AND with bitmap intersection")
        val result = posting_lists_and_bitmap([
            posting_list_new("simple", [1, 2, 4, 8]),
            posting_list_new("database", [2, 4, 6]),
            posting_list_new("index", [4, 7, 8])
        ], 10)
        val rows = posting_bitmap_result_rows(result)

        expect(result.terms_evaluated).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(result.postings_scanned).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
        expect(result.rows_matched).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(rows).to_equal([4])

    it "evaluates token OR with bitmap union and deduplication":
        step("Verify: evaluates token OR with bitmap union and deduplication")
        val result = posting_lists_or_bitmap([
            posting_list_new("simple", [1, 2, 4]),
            posting_list_new("database", [2, 3, 5])
        ], 8)
        val rows = posting_bitmap_result_rows(result)

        expect(result.terms_evaluated).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(result.postings_scanned).to_equal(6)  # oracle: authoritative expected value documented by this spec's contract
        expect(result.rows_matched).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract
        expect(rows).to_equal([1, 2, 3, 4, 5])

    it "returns empty rows for empty AND input":
        step("Verify: returns empty rows for empty AND input")
        val result = posting_lists_and_bitmap([], 12)
        val rows = posting_bitmap_result_rows(result)

        expect(result.terms_evaluated).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(result.postings_scanned).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(result.rows_matched).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(rows.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
