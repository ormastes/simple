"""
## Purpose and audience
Purpose: Verify DB accel — bitmap operations.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-ACCEL-001 — stable requirement identity for this spec.

use std.spipe.*
use std.db.accel.{
    RowBitmap, ScanPredicate, ScanPredicateKind,
    byte_span_find_delimiter, make_byte_span,
    accel_capability_report, make_key_span, scan_key_span,
    collect_text_row_indices, scan_text_values, summary_text_hash, text_contains_token,
    text_find_delimiter,
    text_starts_with_span, trigram_extract, trigram_overlap_count
}

fn build_boundary_scan_values() -> [text]:
    var values: [text] = []
    var idx = 0
    while idx < 70:
        if idx == 0 or idx == 31 or idx == 32 or idx == 63 or idx == 64 or idx == 69:
            values.push("src/hit.spl")
        else:
            values.push("doc/miss.md")
        idx = idx + 1
    values

use std.spec.step

describe "DB accel — bitmap operations":
    it "preserves counts across and/or/and_not":
        step("Verify: preserves counts across and/or/and_not")
        # @req: REQ-LIB-ACCEL-001
        val lhs = RowBitmap.empty(8)
        lhs.set(1)
        lhs.set(3)
        lhs.set(5)
        val rhs = RowBitmap.empty(8)
        rhs.set(3)
        rhs.set(4)
        rhs.set(5)

        val both = lhs.and_with(rhs)
        val either = lhs.or_with(rhs)
        val only_lhs = lhs.and_not(rhs)

        expect(both.count()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(either.count()).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract
        expect(only_lhs.count()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

    it "supports full, get, and clear across 31/32 and 63/64 boundaries":
        step("Verify: supports full, get, and clear across 31/32 and 63/64 boundaries")
        val bitmap = RowBitmap.full(65)
        expect(bitmap.count()).to_equal(65)  # oracle: authoritative expected value documented by this spec's contract
        expect(bitmap.get(0)).to_equal(true)
        expect(bitmap.get(31)).to_equal(true)
        expect(bitmap.get(32)).to_equal(true)
        expect(bitmap.get(64)).to_equal(true)
        expect(bitmap.get(65)).to_equal(false)

        bitmap.clear(0)
        bitmap.clear(31)
        bitmap.clear(32)
        bitmap.clear(64)
        expect(bitmap.get(0)).to_equal(false)
        expect(bitmap.get(1)).to_equal(true)
        expect(bitmap.get(31)).to_equal(false)
        expect(bitmap.get(32)).to_equal(false)
        expect(bitmap.get(64)).to_equal(false)
        expect(bitmap.count()).to_equal(61)  # oracle: authoritative expected value documented by this spec's contract

    it "keeps and/or parity across mixed 31/32/63/64 boundaries":
        step("Verify: keeps and/or parity across mixed 31/32/63/64 boundaries")
        val lhs = RowBitmap.empty(96)
        lhs.set(0)
        lhs.set(31)
        lhs.set(32)
        lhs.set(63)
        lhs.set(64)
        lhs.set(95)

        val rhs = RowBitmap.empty(70)
        rhs.set(0)
        rhs.set(32)
        rhs.set(62)
        rhs.set(63)
        rhs.set(64)

        val both = lhs.and_with(rhs)
        val either = lhs.or_with(rhs)

        expect(both.row_count).to_equal(70)  # oracle: authoritative expected value documented by this spec's contract
        expect(both.count()).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract
        expect(both.get(0)).to_equal(true)
        expect(both.get(31)).to_equal(false)
        expect(both.get(32)).to_equal(true)
        expect(both.get(62)).to_equal(false)
        expect(both.get(63)).to_equal(true)
        expect(both.get(64)).to_equal(true)
        expect(both.get(95)).to_equal(false)

        expect(either.row_count).to_equal(96)  # oracle: authoritative expected value documented by this spec's contract
        expect(either.count()).to_equal(7)  # oracle: authoritative expected value documented by this spec's contract
        expect(either.get(0)).to_equal(true)
        expect(either.get(31)).to_equal(true)
        expect(either.get(32)).to_equal(true)
        expect(either.get(62)).to_equal(true)
        expect(either.get(63)).to_equal(true)
        expect(either.get(64)).to_equal(true)
        expect(either.get(95)).to_equal(true)

describe "DB accel — text predicates":
    it "matches prefix and token boundaries":
        step("Verify: matches prefix and token boundaries")
        expect(text_starts_with_span("alpha beta", "alpha")).to_equal(true)
        expect(text_contains_token("alpha|beta,gamma", "beta")).to_equal(true)
        expect(text_contains_token("alphabet soup", "alpha")).to_equal(false)

    it "finds shared delimiter boundaries in bytes and text":
        step("Verify: finds shared delimiter boundaries in bytes and text")
        val span = make_byte_span([("a" as u8), ("|" as u8), ("b" as u8)], 0, 3)
        expect(byte_span_find_delimiter(span)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(text_find_delimiter("path,tail")).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract

    it "extracts trigrams and overlap":
        step("Verify: extracts trigrams and overlap")
        val trigrams = trigram_extract("token")
        expect(trigrams.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(trigram_overlap_count("token", "stokenized")).to_be_greater_than(0)

describe "DB accel — batched scalar scans":
    it "scans keys with identical scalar and bitmap counts":
        step("Verify: scans keys with identical scalar and bitmap counts")
        val span = make_key_span([10, 20, 30, 20, 50], 0, 5)
        val predicate = ScanPredicate(kind: ScanPredicateKind.Eq, text_value: "", key_value: 20)
        val (bitmap, stats) = scan_key_span(span, predicate)
        expect(bitmap.count()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(stats.candidates_kept).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(stats.rows_scanned).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract

    it "scans text values for contains":
        step("Verify: scans text values for contains")
        val predicate = ScanPredicate(kind: ScanPredicateKind.Contains, text_value: "src", key_value: 0)
        val (bitmap, stats) = scan_text_values(["src/main.spl", "doc/readme.md", "src/lib.spl"], predicate)
        expect(bitmap.count()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(stats.bitmap_density).to_be_greater_than(0.5)

    it "collects row indices without bitmap materialization":
        step("Verify: collects row indices without bitmap materialization")
        val predicate = ScanPredicate(kind: ScanPredicateKind.ContainsToken, text_value: "beta", key_value: 0)
        val (rows, stats) = collect_text_row_indices(
            ["alpha|beta,gamma", "alpha beta", "beta", "betamax"],
            predicate
        )
        expect(rows.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(rows[0]).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(rows[1]).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(rows[2]).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(stats.candidates_kept).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(stats.rows_scanned).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract

    it "preserves matches across 31/32 and 63/64 bitmap boundaries":
        step("Verify: preserves matches across 31/32 and 63/64 bitmap boundaries")
        val values = build_boundary_scan_values()
        val predicate = ScanPredicate(kind: ScanPredicateKind.Contains, text_value: "src/", key_value: 0)
        val (bitmap, stats) = scan_text_values(values, predicate)
        expect(bitmap.get(0)).to_equal(true)
        expect(bitmap.get(31)).to_equal(true)
        expect(bitmap.get(32)).to_equal(true)
        expect(bitmap.get(63)).to_equal(true)
        expect(bitmap.get(64)).to_equal(true)
        expect(bitmap.get(69)).to_equal(true)
        expect(bitmap.count()).to_equal(6)  # oracle: authoritative expected value documented by this spec's contract
        expect(stats.candidates_kept).to_equal(6)  # oracle: authoritative expected value documented by this spec's contract

describe "DB accel — capability report":
    it "reports runtime tier and keeps scalar fallback available":
        step("Verify: reports runtime tier and keeps scalar fallback available")
        val report = accel_capability_report()
        expect(report.scalar_fallback).to_equal(true)
        expect(report.tier_name.len()).to_be_greater_than(0)
        expect(report.simd_width_bits).to_be_greater_than(-1)
        expect(report.simd_active).to_equal(false)

    it "uses deterministic summary hashes for scan prefilters":
        step("Verify: uses deterministic summary hashes for scan prefilters")
        expect(summary_text_hash("ab")).to_equal(summary_text_hash("ba"))
