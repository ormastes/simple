# @cover src/lib/gc_async_mut/gpu/engine2d/rendering_opt_provider.spl 80%
# @cover src/lib/gc_async_mut/gpu/engine2d/simd_provider.spl 80%
# @tag: unit, gpu, engine2d, simd, optimization

"""
## Purpose and audience
Verifies the rendering opt provider behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

use std.spec.step
use std.gpu.engine2d.rendering_opt_provider.{rendering_opt_provider_from_simd_counts, current_simd_rendering_opt_provider, rendering_opt_report_from_simd}
use std.gpu.engine2d.simd_provider.{reset_simd_hits, simd_hit_counts, record_simd_fill_hit, record_simd_copy_hit, record_simd_alpha_hit, record_simd_blit_hit, record_simd_scroll_hit, record_simd_vectorize_change, register_simd_provider}

# @req: REQ-ENGINE2D-RenderingOptProvider-001
describe "Engine2D SIMD rendering optimization provider metadata":

    it "maps SIMD kernel hits into one provider hit counter":
        # @req: REQ-ENGINE2D-RenderingOptProvider-001
        step("Verify: maps SIMD kernel hits into one provider hit counter")
        reset_simd_hits()
        record_simd_fill_hit()
        record_simd_copy_hit()
        record_simd_alpha_hit()
        record_simd_blit_hit()
        record_simd_scroll_hit()

        val provider = rendering_opt_provider_from_simd_counts("x86_64", "avx2", simd_hit_counts())

        expect(provider.provider_kind).to_equal("simd_vectorization")
        expect(provider.target_arch).to_equal("x86_64")
        expect(provider.target_features).to_equal("avx2")
        expect(provider.hit_count).to_equal(5)  # oracle: value fixed by the spec contract
        expect(provider.change_count).to_equal(0)  # oracle: value fixed by the spec contract

    it "maps vectorization change events into provider change counter":
        # @req: REQ-ENGINE2D-RenderingOptProvider-001
        step("Verify: maps vectorization change events into provider change counter")
        reset_simd_hits()
        record_simd_fill_hit()
        record_simd_vectorize_change()
        record_simd_vectorize_change()

        val provider = current_simd_rendering_opt_provider("aarch64", "neon")

        expect(provider.hit_count).to_equal(1)  # oracle: value fixed by the spec contract
        expect(provider.change_count).to_equal(2)  # oracle: value fixed by the spec contract
        expect(provider.target_arch).to_equal("aarch64")
        expect(provider.target_features).to_equal("neon")

    it "uses registered provider identity in optimization metadata":
        # @req: REQ-ENGINE2D-RenderingOptProvider-001
        step("Verify: uses registered provider identity in optimization metadata")
        reset_simd_hits()
        register_simd_provider("cpu_simd_frame_provider")
        record_simd_scroll_hit()

        val provider = current_simd_rendering_opt_provider("riscv64", "rvv")

        expect(provider.provider_id).to_equal("cpu_simd_frame_provider")
        expect(provider.hit_count).to_equal(1)  # oracle: value fixed by the spec contract
        expect(provider.target_arch).to_equal("riscv64")
        expect(provider.target_features).to_equal("rvv")

    it "builds a frame report from current SIMD counters":
        # @req: REQ-ENGINE2D-RenderingOptProvider-001
        step("Verify: builds a frame report from current SIMD counters")
        reset_simd_hits()
        record_simd_fill_hit()
        record_simd_copy_hit()
        record_simd_vectorize_change()

        val report = rendering_opt_report_from_simd("x86_64", "avx2")

        expect(report.provider_count).to_equal(1)  # oracle: value fixed by the spec contract
        expect(report.total_hits).to_equal(2)  # oracle: value fixed by the spec contract
        expect(report.total_changes).to_equal(1)  # oracle: value fixed by the spec contract
        expect(report.p0_kind).to_equal("simd_vectorization")
        expect(report.p0_hits).to_equal(2)  # oracle: value fixed by the spec contract
