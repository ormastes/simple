"""
## Purpose and audience
Purpose: Prove that VulkanDynFfi.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-GPU-001 — stable requirement identity for this spec.

"""Vulkan FFI Dispatch Specification

@tag: gpu, engine2d, vulkan, ffi
@cover src/lib/nogc_sync_mut/gpu/engine2d/ffi_vulkan.spl 35%

Exercises the REAL `VulkanDynFfi` class in
`src/lib/nogc_sync_mut/gpu/engine2d/ffi_vulkan.spl`.

History (stream F4, 2026-08-09): every `it` in this file used to be the
single line

    expect(test_env_require("SIMPLE_GPU_TEST")).to_equal("blocked:SIMPLE_GPU_TEST")

which asserts only that the gate is shut. It named
`src/lib/gc_async_mut/gpu/engine2d/ffi_vulkan.spl 80%` as its subject; that
file is a 3-line `export use` facade with no logic, and this spec never
referenced `VulkanDynFfi` at all. Both the body and the coverage claim were
false. See
`doc/08_tracking/bug/gated_specs_are_tautology_shells_2026-08-09.md`.

What is asserted here is `VulkanDynFfi`'s *honest-rejection ledger* — the
contract the class documents on `rejected_op_count()` / `last_rejection()`:
in Dynamic mode every operation whose libvulkan entry point this raw
`call0..call4(i64...)` FFI cannot marshal must be COUNTED as rejected and
must return false/0, rather than silently no-opping and reporting success.
That contract is host-independent, so it is asserted unconditionally and
does not need a hardware gate. `create_dynamic()` really does `dlopen`
libvulkan, so the constructor cases are a real loader exercise.

NOT asserted: that Vulkan rendering works. This spec does not claim it.
"""

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.gpu.engine2d.ffi_vulkan.{VulkanDynFfi}

use std.spec.step

describe "VulkanDynFfi":

    describe "constructors":
        it "create_static yields a Static-mode instance with a clean ledger":
            step("Verify: create_static yields a Static-mode instance with a clean ledger")
            # @req: REQ-LIB-GPU-001
            val ffi = VulkanDynFfi.create_static()
            # Static mode never uses the dynamic loader, so it must never
            # record a rejection and must not claim a loader probe.
            expect(ffi.rejected_op_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(ffi.last_rejection()).to_equal("")
            expect(ffi.loader_probe()).to_equal(false)
            print("DEVICE-RAN: VulkanDynFfi.create_static ledger clean\n")

        it "create_dynamic_from a nonexistent path returns nil":
            step("Verify: create_dynamic_from a nonexistent path returns nil")
            # Real dlopen of a path that cannot exist.
            val ffi = VulkanDynFfi.create_dynamic_from("/nonexistent/libvulkan.so.999")
            expect(ffi == nil).to_equal(true)
            print("DEVICE-RAN: VulkanDynFfi.create_dynamic_from rejected a bad path\n")

    describe "honest-rejection ledger (Dynamic mode)":
        it "starts empty, then counts and names each rejected operation":
            step("Verify: starts empty, then counts and names each rejected operation")
            val ffi = VulkanDynFfi.create_dynamic()
            if ffi == nil:
                # No Vulkan loader on this host. Report it loudly; do NOT
                # let an absent loader masquerade as a passing ledger test.
                print("SKIPPED: no Vulkan loader (create_dynamic returned nil) -- the DEVICE-RAN branch did NOT run\n")
                expect(ffi == nil).to_equal(true)
                return
            print("DEVICE-RAN: libvulkan dlopen succeeded; asserting rejection ledger\n")

            # A freshly constructed instance has rejected nothing.
            expect(ffi.rejected_op_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(ffi.last_rejection()).to_equal("")

            # `init` has no marshallable libvulkan entry point, so the class
            # must reject it: return false AND record it.
            expect(ffi.init()).to_equal(false)
            expect(ffi.rejected_op_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(ffi.last_rejection()).to_equal("init")

            # A second distinct op must ADVANCE the counter (not merely
            # re-set it) and must re-name `last_rejection`.
            expect(ffi.shutdown()).to_equal(false)
            expect(ffi.rejected_op_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(ffi.last_rejection()).to_equal("shutdown")
            print("DEVICE-RAN: rejection ledger advanced 0 -> 1 (init) -> 2 (shutdown)\n")

        it "is_available stays false in Dynamic mode even with a loader present":
            step("Verify: is_available stays false in Dynamic mode even with a loader present")
            val ffi = VulkanDynFfi.create_dynamic()
            if ffi == nil:
                print("SKIPPED: no Vulkan loader (create_dynamic returned nil) -- the DEVICE-RAN branch did NOT run\n")
                expect(ffi == nil).to_equal(true)
                return
            # This is the anti-fake-honesty rule the class documents: a
            # capability gate must not report a capability it cannot drive.
            # Dynamic mode CANNOT drive Vulkan through this raw FFI, so
            # is_available() must be false regardless of the host's driver.
            expect(ffi.is_available()).to_equal(false)
            print("DEVICE-RAN: is_available()==false in Dynamic mode (loader present)\n")
