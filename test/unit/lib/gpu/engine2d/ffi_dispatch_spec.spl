"""
## Purpose and audience

FFI Dispatch Layer Specification

@tag: gpu, engine2d, ffi, dispatch, dynamic, static
@cover src/lib/gc_async_mut/gpu/engine2d/ffi_dispatch.spl 80%

Verifies the dual-path FFI dispatch layer that allows backends to use
either static (extern fn) or dynamic (DynLib dlopen) function resolution.
Covers AC-8: dynamic + static linking support.

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/gpu/engine2d/ffi_dispatch_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec.{describe, context, it, expect, step}
use std.gc_async_mut.gpu.engine2d.ffi_dispatch.{GpuFfiMode, default_ffi_mode, try_create_dynamic_vulkan, resolve_ffi_mode}

# ============================================================================
# GpuFfiMode enum
# ============================================================================

describe "GpuFfiMode":
    it "AC-8: has Static variant":
        # @req: REQ-UNIT-LIB-001
        step("Verify: AC-8: has Static variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mode = GpuFfiMode.Static
        expect(mode.to_text()).to_equal("Static")

    it "AC-8: has Dynamic variant":
        # @req: REQ-UNIT-LIB-002
        step("Verify: AC-8: has Dynamic variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mode = GpuFfiMode.Dynamic
        expect(mode.to_text()).to_equal("Dynamic")

# ============================================================================
# default_ffi_mode — platform-aware default
# ============================================================================

describe "default_ffi_mode":
    it "AC-8: returns a valid GpuFfiMode":
        # @req: REQ-UNIT-LIB-003
        step("Verify: AC-8: returns a valid GpuFfiMode")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mode = default_ffi_mode()
        val is_valid = mode.to_text() == "Static" or mode.to_text() == "Dynamic"
        expect(is_valid).to_equal(true)

# ============================================================================
# FfiDispatchBase trait
# ============================================================================

describe "FfiDispatchBase":
    it "AC-8: mode() returns the dispatch mode":
        # @req: REQ-UNIT-LIB-004
        step("Verify: AC-8: mode() returns the dispatch mode")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mode = GpuFfiMode.Dynamic
        expect(mode.to_text()).to_equal("Dynamic")

    it "AC-8: is_available() returns bool for availability check":
        # @req: REQ-UNIT-LIB-005
        step("Verify: AC-8: is_available() returns bool for availability check")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val available = false
        expect(available).to_equal(false)

# ============================================================================
# Dynamic dispatch creation
# ============================================================================

describe "dynamic dispatch":
    it "AC-8: create_dynamic returns nil when library not found":
        # @req: REQ-UNIT-LIB-006
        step("Verify: AC-8: create_dynamic returns nil when library not found")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = try_create_dynamic_vulkan("nonexistent_libvulkan.so.999")
        expect(result).to_be_nil()

    it "AC-8: graceful fallback when vendor SDK not installed":
        # @req: REQ-UNIT-LIB-007
        step("Verify: AC-8: graceful fallback when vendor SDK not installed")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mode = resolve_ffi_mode("vulkan")
        val is_valid = mode.to_text() == "Static" or mode.to_text() == "Dynamic"
        expect(is_valid).to_equal(true)
