"""
## Purpose and audience
Purpose: Prove that OpenClSession compute contract.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-GPU-001 — stable requirement identity for this spec.

# @cover src/lib/gc_async_mut/gpu/engine2d/opencl_session.spl 60%
# @tag: unit, gpu, engine2d, opencl, session, compute

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.engine2d.backend_session.{BackendSessionKind}
use std.gc_async_mut.gpu.engine2d.opencl_session.{OpenClSession}

use std.spec.step

describe "OpenClSession compute contract":

    it "reports OpenCL kind and unavailable without an injected ICD FFI":
        step("Verify: reports OpenCL kind and unavailable without an injected ICD FFI")
        # @req: REQ-LIB-GPU-001
        val session = OpenClSession.create()

        expect(session.kind()).to_equal(BackendSessionKind.OpenCl)
        expect(session.is_available()).to_equal(false)
        expect(session.is_valid()).to_equal(false)

    it "fails closed when initializing or launching without OpenCL FFI":
        step("Verify: fails closed when initializing or launching without OpenCL FFI")
        val session = OpenClSession.create()

        expect(session.init()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(session.load_module("")).to_equal(0)
        expect(session.synchronize()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(session.launch_kernel("simple_2d_fill_u32", 1, 1, 1, 1)).to_equal(1)
        expect(session.fill_kernel(64, 64, 4096)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(session.copy_kernel(64, 64, 4096)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(session.alpha_blend_kernel(64, 64, 4096)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(session.scroll_kernel(64, 64, 4096)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "shutdown is safe on an uninitialized session":
        step("Verify: shutdown is safe on an uninitialized session")
        var session = OpenClSession.create()

        session.shutdown()
        expect(session.is_valid()).to_equal(false)
        expect(session.ref_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
