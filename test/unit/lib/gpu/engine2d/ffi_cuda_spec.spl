"""CUDA FFI Dispatch Specification

@tag: gpu, engine2d, cuda, ffi
@cover src/lib/nogc_sync_mut/gpu/engine2d/ffi_cuda.spl 30%

Exercises the REAL `CudaDynFfi` class in
`src/lib/nogc_sync_mut/gpu/engine2d/ffi_cuda.spl`.

History (stream F4, 2026-08-09): all 11 `it` bodies here used to be the
single line

    expect(test_env_require("SIMPLE_GPU_TEST")).to_equal("blocked:SIMPLE_GPU_TEST")

which asserts only that the gate is shut, and the header claimed
`@cover src/lib/gc_async_mut/gpu/engine2d/ffi_cuda.spl 80%`. That claim was
false twice over: the spec never mentioned `CudaDynFfi`, and the named file is
a 3-line `export use` facade whose re-export target
(`std.nogc_async_mut.gpu.engine2d.ffi_cuda`) DOES NOT EXIST -- importing
`CudaDynFfi` through it fails at runtime with `Function 'create_static' not
found`. Filed as
`doc/08_tracking/bug/gc_async_mut_gpu_ffi_facades_are_dangling_2026-08-09.md`.
The `@cover` above now names the module this spec actually imports.

The Dynamic path is a real exercise of the installed driver: it `dlopen`s
libcuda and calls `cuInit` through it. On this host that is genuine
hardware contact (2 NVIDIA devices present).

NOT asserted here, because both are broken on a host where CUDA works --
see `doc/08_tracking/bug/cuda_ffi_is_available_and_device_count_wrong_2026-08-09.md`:
`is_available()` (calls `cuInit` with the wrong arity) and `device_count()`
(returns 0 with two devices installed). Those are product defects; this
spec does not paper over them by asserting the wrong values.
"""

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.gpu.engine2d.ffi_cuda.{CudaDynFfi}

describe "CudaDynFfi":

    describe "create_static":
        it "reports the CUDA Driver API as its api_name":
            val ffi = CudaDynFfi.create_static()
            expect(ffi.api_name()).to_equal("CUDA Driver API")
            print("DEVICE-RAN: CudaDynFfi.create_static api_name asserted\n")

    describe "create_dynamic":
        it "returns nil when the given library path does not exist":
            # Real dlopen against a path that cannot resolve.
            val ffi = CudaDynFfi.create_dynamic_from("/nonexistent/libcuda.so.999")
            expect(ffi == nil).to_equal(true)
            print("DEVICE-RAN: CudaDynFfi.create_dynamic_from rejected a bad path\n")

        it "loads the installed CUDA driver and cuInit succeeds":
            val ffi = CudaDynFfi.create_dynamic()
            if ffi == nil:
                # No libcuda on this host. Say so loudly -- an absent driver
                # must not read as a passing driver test.
                print("SKIPPED: libcuda not loadable (create_dynamic returned nil) -- the DEVICE-RAN branch did NOT run\n")
                expect(ffi == nil).to_equal(true)
                return
            expect(ffi.api_name()).to_equal("CUDA Driver API")
            # init() dispatches call1("cuInit", 0) into the real driver.
            # CUDA_SUCCESS(0) => true. This is real hardware contact.
            expect(ffi.init()).to_equal(true)
            print("DEVICE-RAN: real cuInit(0) through dlopen'd libcuda returned CUDA_SUCCESS\n")
