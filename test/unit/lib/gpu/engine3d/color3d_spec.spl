"""
## Purpose and audience
Purpose: Prove that Engine3D Color3D.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-GPU-001 — stable requirement identity for this spec.

# @tag: gpu, engine3d, color
# @cover src/lib/gc_async_mut/gpu/engine3d/color3d.spl 50%

use std.spec.{describe, context, it, expect}
use std.gpu.engine3d.color3d.{
    rgba3d, rgb3d,
    c3d_r, c3d_g, c3d_b, c3d_a,
    luminance3d,
    blend3d, lerp_color3d
}

use std.spec.step

describe "Engine3D Color3D":

    context "rgba3d packing":

        it "packs red channel correctly":
            step("Verify: packs red channel correctly")
            # @req: REQ-LIB-GPU-001
            val c = rgba3d(255, 0, 0, 255)
            expect(c3d_r(c)).to_equal(255)  # oracle: 255 — named expected value from the requirement

        it "packs green channel correctly":
            step("Verify: packs green channel correctly")
            val c = rgba3d(0, 128, 0, 255)
            expect(c3d_g(c)).to_equal(128)  # oracle: 128 — named expected value from the requirement

        it "packs blue channel correctly":
            step("Verify: packs blue channel correctly")
            val c = rgba3d(0, 0, 64, 255)
            expect(c3d_b(c)).to_equal(64)  # oracle: 64 — named expected value from the requirement

        it "packs alpha channel correctly":
            step("Verify: packs alpha channel correctly")
            val c = rgba3d(0, 0, 0, 200)
            expect(c3d_a(c)).to_equal(200)  # oracle: 200 — named expected value from the requirement

    context "rgb3d packing":

        it "packs with alpha 255":
            step("Verify: packs with alpha 255")
            val c = rgb3d(100, 150, 200)
            expect(c3d_a(c)).to_equal(255)  # oracle: 255 — named expected value from the requirement

        it "packs red channel":
            step("Verify: packs red channel")
            val c = rgb3d(100, 150, 200)
            expect(c3d_r(c)).to_equal(100)  # oracle: 100 — named expected value from the requirement

    context "channel extraction":

        it "c3d_r extracts red":
            step("Verify: c3d_r extracts red")
            val c = rgba3d(255, 128, 64, 200)
            expect(c3d_r(c)).to_equal(255)  # oracle: 255 — named expected value from the requirement

        it "c3d_g extracts green":
            step("Verify: c3d_g extracts green")
            val c = rgba3d(255, 128, 64, 200)
            expect(c3d_g(c)).to_equal(128)  # oracle: 128 — named expected value from the requirement

        it "c3d_b extracts blue":
            step("Verify: c3d_b extracts blue")
            val c = rgba3d(255, 128, 64, 200)
            expect(c3d_b(c)).to_equal(64)  # oracle: 64 — named expected value from the requirement

        it "c3d_a extracts alpha":
            step("Verify: c3d_a extracts alpha")
            val c = rgba3d(255, 128, 64, 200)
            expect(c3d_a(c)).to_equal(200)  # oracle: 200 — named expected value from the requirement

    context "luminance3d":

        it "white returns approximately 1.0":
            step("Verify: white returns approximately 1.0")
            val lum = luminance3d(rgba3d(255, 255, 255, 255))
            expect((lum as i32)).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "black returns 0.0":
            step("Verify: black returns 0.0")
            val lum = luminance3d(rgba3d(0, 0, 0, 255))
            expect((lum as i32)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "blend3d":

        it "blending with alpha=0 returns base unchanged":
            step("Verify: blending with alpha=0 returns base unchanged")
            val base = rgba3d(100, 150, 200, 255)
            val overlay = rgba3d(0, 0, 0, 0)
            val result = blend3d(overlay, base)
            expect(c3d_r(result)).to_equal(c3d_r(base))
            expect(c3d_g(result)).to_equal(c3d_g(base))
            expect(c3d_b(result)).to_equal(c3d_b(base))

        it "blending with alpha=255 returns src":
            step("Verify: blending with alpha=255 returns src")
            val base = rgba3d(0, 0, 0, 255)
            val overlay = rgba3d(200, 100, 50, 255)
            val result = blend3d(overlay, base)
            expect(c3d_r(result)).to_equal(200)  # oracle: 200 — named expected value from the requirement

    context "lerp_color3d":

        it "t=0 returns first color":
            step("Verify: t=0 returns first color")
            val a = rgba3d(255, 0, 0, 255)
            val b = rgba3d(0, 255, 0, 255)
            val result = lerp_color3d(a, b, 0.0)
            expect(c3d_r(result)).to_equal(255)  # oracle: 255 — named expected value from the requirement
            expect(c3d_g(result)).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "t=1 returns second color":
            step("Verify: t=1 returns second color")
            val a = rgba3d(255, 0, 0, 255)
            val b = rgba3d(0, 255, 0, 255)
            val result = lerp_color3d(a, b, 1.0)
            expect(c3d_r(result)).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(c3d_g(result)).to_equal(255)  # oracle: 255 — named expected value from the requirement
