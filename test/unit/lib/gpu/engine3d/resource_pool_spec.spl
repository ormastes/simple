# @tag: gpu, engine3d, resource
# @cover src/lib/gc_async_mut/gpu/engine3d/resource_pool.spl 70%

"""
## Purpose and audience
Verifies the resource pool behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

use std.spec.{describe, context, it, expect}
use std.gpu.engine3d.resource_pool.{
    ResourcePool3D, TextureHandle3D, BufferHandle3D,
    ShaderHandle3D, PipelineHandle3D
}
use std.gpu.engine3d.texture3d.{TEX_FMT_RGBA8_UNORM}

# @req: REQ-ENGINE3D-ResourcePool-001
describe "Engine3D ResourcePool3D":

    context "ResourcePool3D.create":

        it "total_resource_count starts at 0":
            # @req: REQ-ENGINE3D-ResourcePool-001
            step("Verify: total_resource_count starts at 0")
            val pool = ResourcePool3D.create()
            expect(pool.total_resource_count()).to_equal(0)  # oracle: value fixed by the spec contract

    context "allocate_texture":

        it "returns handle with correct width":
            # @req: REQ-ENGINE3D-ResourcePool-001
            step("Verify: returns handle with correct width")
            var pool = ResourcePool3D.create()
            val h = pool.allocate_texture(512, 256, 1, TEX_FMT_RGBA8_UNORM, 1, 42)
            expect(h.width).to_equal(512)  # oracle: value fixed by the spec contract

        it "returns handle with correct height":
            # @req: REQ-ENGINE3D-ResourcePool-001
            step("Verify: returns handle with correct height")
            var pool = ResourcePool3D.create()
            val h = pool.allocate_texture(512, 256, 1, TEX_FMT_RGBA8_UNORM, 1, 42)
            expect(h.height).to_equal(256)  # oracle: value fixed by the spec contract

        it "returns handle with correct depth":
            # @req: REQ-ENGINE3D-ResourcePool-001
            step("Verify: returns handle with correct depth")
            var pool = ResourcePool3D.create()
            val h = pool.allocate_texture(512, 256, 4, TEX_FMT_RGBA8_UNORM, 1, 42)
            expect(h.depth).to_equal(4)  # oracle: value fixed by the spec contract

        it "texture_count increments":
            # @req: REQ-ENGINE3D-ResourcePool-001
            step("Verify: texture_count increments")
            var pool = ResourcePool3D.create()
            pool.allocate_texture(64, 64, 1, TEX_FMT_RGBA8_UNORM, 1, 1)
            expect(pool.texture_count()).to_equal(1)  # oracle: value fixed by the spec contract

    context "allocate_buffer":

        it "buffer_count increments":
            # @req: REQ-ENGINE3D-ResourcePool-001
            step("Verify: buffer_count increments")
            var pool = ResourcePool3D.create()
            pool.allocate_buffer(1024, 0, 1)
            expect(pool.buffer_count()).to_equal(1)  # oracle: value fixed by the spec contract

    context "allocate_shader":

        it "shader_count increments":
            # @req: REQ-ENGINE3D-ResourcePool-001
            step("Verify: shader_count increments")
            var pool = ResourcePool3D.create()
            pool.allocate_shader("vs_main", "fs_main", 1)
            expect(pool.shader_count()).to_equal(1)  # oracle: value fixed by the spec contract

    context "allocate_pipeline":

        it "pipeline_count increments":
            # @req: REQ-ENGINE3D-ResourcePool-001
            step("Verify: pipeline_count increments")
            var pool = ResourcePool3D.create()
            pool.allocate_pipeline(1, true, 0, 0, 1)
            expect(pool.pipeline_count()).to_equal(1)  # oracle: value fixed by the spec contract

    context "free_texture":

        it "texture_count decrements":
            # @req: REQ-ENGINE3D-ResourcePool-001
            step("Verify: texture_count decrements")
            var pool = ResourcePool3D.create()
            val h = pool.allocate_texture(64, 64, 1, TEX_FMT_RGBA8_UNORM, 1, 1)
            pool.free_texture(h.id)
            expect(pool.texture_count()).to_equal(0)  # oracle: value fixed by the spec contract

    context "find_texture":

        it "returns handle for valid id":
            # @req: REQ-ENGINE3D-ResourcePool-001
            step("Verify: returns handle for valid id")
            var pool = ResourcePool3D.create()
            val h = pool.allocate_texture(128, 128, 1, TEX_FMT_RGBA8_UNORM, 1, 5)
            expect(h.width).to_equal(128)  # oracle: value fixed by the spec contract

        it "returns nil for invalid id":
            # @req: REQ-ENGINE3D-ResourcePool-001
            step("Verify: returns nil for invalid id")
            var pool = ResourcePool3D.create()
            val found = pool.find_texture(99999)
            expect(found).to_be_nil()

    context "touch_texture":

        it "updates last_used_frame after advance_frame":
            # @req: REQ-ENGINE3D-ResourcePool-001
            step("Verify: updates last_used_frame after advance_frame")
            var pool = ResourcePool3D.create()
            val h = pool.allocate_texture(64, 64, 1, TEX_FMT_RGBA8_UNORM, 1, 1)
            pool.advance_frame()
            pool.touch_texture(h.id)
            pool.advance_frame()
            pool.advance_frame()
            val freed = pool.gc_unused_textures(2)
            expect(freed).to_equal(0)  # oracle: value fixed by the spec contract

    context "gc_unused_textures":

        it "removes old textures":
            # @req: REQ-ENGINE3D-ResourcePool-001
            step("Verify: removes old textures")
            var pool = ResourcePool3D.create()
            pool.allocate_texture(64, 64, 1, TEX_FMT_RGBA8_UNORM, 1, 1)
            pool.advance_frame()
            pool.advance_frame()
            pool.advance_frame()
            val freed = pool.gc_unused_textures(2)
            expect(freed).to_equal(1)  # oracle: value fixed by the spec contract

        it "keeps fresh textures":
            # @req: REQ-ENGINE3D-ResourcePool-001
            step("Verify: keeps fresh textures")
            var pool = ResourcePool3D.create()
            val h = pool.allocate_texture(64, 64, 1, TEX_FMT_RGBA8_UNORM, 1, 1)
            pool.advance_frame()
            pool.touch_texture(h.id)
            val freed = pool.gc_unused_textures(2)
            expect(freed).to_equal(0)  # oracle: value fixed by the spec contract

    context "gpu_id field":

        it "allocated handle has correct gpu_id":
            # @req: REQ-ENGINE3D-ResourcePool-001
            step("Verify: allocated handle has correct gpu_id")
            var pool = ResourcePool3D.create()
            val h = pool.allocate_texture(64, 64, 1, TEX_FMT_RGBA8_UNORM, 1, 77)
            expect(h.gpu_id).to_equal(77)  # oracle: value fixed by the spec contract

    context "gc_unused combined":

        it "returns total freed count":
            # @req: REQ-ENGINE3D-ResourcePool-001
            step("Verify: returns total freed count")
            var pool = ResourcePool3D.create()
            pool.allocate_texture(64, 64, 1, TEX_FMT_RGBA8_UNORM, 1, 1)
            pool.allocate_buffer(256, 0, 1)
            pool.advance_frame()
            pool.advance_frame()
            pool.advance_frame()
            val freed = pool.gc_unused(2)
            expect(freed).to_equal(2)  # oracle: value fixed by the spec contract

    context "total_resource_count":

        it "sums all resource types":
            # @req: REQ-ENGINE3D-ResourcePool-001
            step("Verify: sums all resource types")
            var pool = ResourcePool3D.create()
            pool.allocate_texture(64, 64, 1, TEX_FMT_RGBA8_UNORM, 1, 1)
            pool.allocate_buffer(256, 0, 1)
            pool.allocate_shader("vs", "fs", 1)
            pool.allocate_pipeline(1, false, 0, 0, 1)
            expect(pool.total_resource_count()).to_equal(4)  # oracle: value fixed by the spec contract
