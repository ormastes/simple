use std.spec.{describe, it, expect}

@alloc
fn zz_a(x: i64) -> i64:
    return x + 1

@no_alloc
fn zz_b(x: i64) -> i64:
    return x + 2

@gpu
fn zz_c(x: i64) -> i64:
    return x + 3

@no_mangle
fn zz_d(x: i64) -> i64:
    return x + 4

describe "zz alloc probe":
    it "runs":
        expect(zz_a(1) + zz_b(1) + zz_c(1) + zz_d(1)).to_equal(14)
