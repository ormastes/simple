"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/debug/trace32/practice_runner_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Practice Runner spec — tests CMM script command formatting

describe "T32 Practice Runner":
    it "formats DO command":
        # @req: REQ-UNIT-LIB-001
        step("Verify: formats DO command")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val script = "scripts/startup.cmm"
        val cmd = "DO {script}"
        expect(cmd).to_equal("DO scripts/startup.cmm")

    it "formats DO with arguments":
        # @req: REQ-UNIT-LIB-002
        step("Verify: formats DO with arguments")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val script = "scripts/flash.cmm"
        val args = ["0x08000000", "firmware.elf"]
        val args_str = args.join(" ")
        val cmd = "DO {script} {args_str}"
        expect(cmd).to_equal("DO scripts/flash.cmm 0x08000000 firmware.elf")

    it "formats PRACTICE.STATE query":
        # @req: REQ-UNIT-LIB-003
        step("Verify: formats PRACTICE.STATE query")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cmd = "PRACTICE.STATE()"
        expect(cmd).to_equal("PRACTICE.STATE()")

    it "formats EVAL expression":
        # @req: REQ-UNIT-LIB-004
        step("Verify: formats EVAL expression")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val expr = "Register(PC)"
        val cmd = "EVAL {expr}"
        expect(cmd).to_equal("EVAL Register(PC)")

    it "formats InterCom execute":
        # @req: REQ-UNIT-LIB-005
        step("Verify: formats InterCom execute")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val target = "ARM_A53_0"
        val inner_cmd = "SYStem.Mode.Prepare"
        val cmd = "InterCom.execute {target} {inner_cmd}"
        expect(cmd).to_equal("InterCom.execute ARM_A53_0 SYStem.Mode.Prepare")

    it "formats WinPrint command":
        # @req: REQ-UNIT-LIB-006
        step("Verify: formats WinPrint command")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val window = "Break.List"
        val cmd = "WinPrint.{window}"
        expect(cmd).to_equal("WinPrint.Break.List")
