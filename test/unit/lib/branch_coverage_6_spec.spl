# @req: REQ-LIB-LIB-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/lib/branch_coverage_6_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/branch_coverage_6.md
# doc-path: doc/03_plan/sys_test/branch_coverage_6.md
# doc-path: doc/04_architecture/branch_coverage_6.md
# doc-path: doc/05_design/branch_coverage_6.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "elif first arm wins when its guard holds":
        step("Verify: elif first arm wins when its guard holds")
        # @req: REQ-LIB-LIB-001
        var r = 0
        if 7 > 10:
            r = 1
        elif 7 > 5:
            r = 2
        else:
            r = 3
        expect(r).to_equal(2)  # oracle: first true elif

    it "match Some binds the payload":
        step("Verify: match Some binds the payload")
        # @req: REQ-LIB-LIB-001
        var r = 0
        match Some(5):
            Some(x): r = x
            nil: r = -1
        expect(r).to_equal(5)  # oracle: payload bound

    it "while loop with false guard never runs":
        step("Verify: while loop with false guard never runs")
        # @req: REQ-LIB-LIB-001
        var i = 7
        while i < 0:
            i = i + 1
        expect(i).to_equal(7)  # oracle: body skipped

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "match nil takes the nil arm":
        step("Verify: match nil takes the nil arm")
        # @req: REQ-LIB-LIB-001
        var r = 9
        match nil:
            Some(x): r = x
            nil: r = -1
        expect(r).to_equal(-1)  # oracle: nil arm

    it "continue skips the rest of the body":
        step("Verify: continue skips the rest of the body")
        # @req: REQ-LIB-LIB-001
        var c = 0
        for i in 0..5:
            if i == 2: continue
            c = c + 1
        expect(c).to_equal(4)  # oracle: one skipped iteration

    it "break terminates the innermost loop":
        step("Verify: break terminates the innermost loop")
        # @req: REQ-LIB-LIB-001
        var c = 0
        for i in 0..10:
            if i == 3: break
            c = c + 1
        expect(c).to_equal(3)  # oracle: iterations 0,1,2 counted
