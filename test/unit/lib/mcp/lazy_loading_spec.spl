# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# MCP lazy loading against the live lazy_registry_v2: metadata
# registration, category load state, on-demand category loading, and
# the unknown-tool path. (The old `mcp_lib` module this spec targeted
# was replaced by std.nogc_async_mut.mcp lazy_registry_v2; the cached
# -handler API no longer exists, so those scenarios target the current
# registry surface instead.)

use std.spec.step
use std.nogc_async_mut.mcp.lazy_registry_v2.{
    init_registry,
    register_handler_metadata,
    get_tool_category,
    is_category_loaded,
    mark_category_loaded,
    get_registry_stats
}
use std.nogc_async_mut.mcp.category_loaders_v2.{
    load_fileio_category,
    load_category,
    is_fileio_loaded
}

describe "MCP lazy loading registry v2":
    # @manual scenario evidence
    it "registers handler metadata and resolves its category":
        # @req REQ-SSPEC-UNIT
        step("init, register, look up category")
        init_registry()
        register_handler_metadata("test_tool", "test_category")
        expect(get_tool_category("test_tool")).to_equal("test_category")

    it "tracks category load state and unknown tools":
        # @req REQ-SSPEC-UNIT
        step("mark a category loaded, probe unknown tool")
        init_registry()
        expect(is_category_loaded("test_category")).to_equal(false)
        mark_category_loaded("test_category")
        expect(is_category_loaded("test_category")).to_equal(true)
        expect(get_tool_category("nonexistent_tool")).to_equal("unknown")

    it "lazily loads the fileio category on demand":
        # @req REQ-SSPEC-UNIT
        step("load fileio and observe its loaded flag")
        init_registry()
        load_fileio_category()
        expect(is_fileio_loaded()).to_equal(true)
        expect(is_category_loaded("fileio")).to_equal(true)

    it "loads an arbitrary category by name and reports stats":
        # @req REQ-SSPEC-UNIT
        step("load edit by name, check stats format")
        init_registry()
        load_category("edit")
        expect(is_category_loaded("edit")).to_equal(true)
        val stats = get_registry_stats()
        expect(stats.contains("handlers")).to_equal(true)
