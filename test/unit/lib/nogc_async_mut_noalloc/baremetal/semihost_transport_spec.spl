"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/nogc_async_mut_noalloc/baremetal/semihost_transport_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Semihost Transport Unit Tests
#
# Tests transport constants, config struct defaults, and capability
# flag disjointness. Interpreter-mode tests (no QEMU needed).

describe "Transport Constants":
    it "WRITEC is 1":
        # @req: REQ-UNIT-LIB-001
        step("Verify: WRITEC is 1")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val TRANSPORT_WRITEC = 1
        expect(TRANSPORT_WRITEC).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "WRITE0 is 2":
        # @req: REQ-UNIT-LIB-002
        step("Verify: WRITE0 is 2")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val TRANSPORT_WRITE0 = 2
        expect(TRANSPORT_WRITE0).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    it "WRITE is 3":
        # @req: REQ-UNIT-LIB-003
        step("Verify: WRITE is 3")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val TRANSPORT_WRITE = 3
        expect(TRANSPORT_WRITE).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    it "BATCH_N is 4":
        # @req: REQ-UNIT-LIB-004
        step("Verify: BATCH_N is 4")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val TRANSPORT_BATCH_N = 4
        expect(TRANSPORT_BATCH_N).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

    it "BUFFERED is 5":
        # @req: REQ-UNIT-LIB-005
        step("Verify: BUFFERED is 5")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val TRANSPORT_BUFFERED = 5
        expect(TRANSPORT_BUFFERED).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

    it "UART is 6":
        # @req: REQ-UNIT-LIB-006
        step("Verify: UART is 6")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val TRANSPORT_UART = 6
        expect(TRANSPORT_UART).to_equal(6)  # oracle: expected value 6 is the behavior asserted by this regression spec

    it "RAW_BINARY is 7":
        # @req: REQ-UNIT-LIB-007
        step("Verify: RAW_BINARY is 7")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val TRANSPORT_RAW_BINARY = 7
        expect(TRANSPORT_RAW_BINARY).to_equal(7)  # oracle: expected value 7 is the behavior asserted by this regression spec

    it "INTERNED is 8":
        # @req: REQ-UNIT-LIB-008
        step("Verify: INTERNED is 8")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val TRANSPORT_INTERNED = 8
        expect(TRANSPORT_INTERNED).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

    it "all transport constants are unique":
        # @req: REQ-UNIT-LIB-009
        step("Verify: all transport constants are unique")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val values = [1, 2, 3, 4, 5, 6, 7, 8]
        expect(values.len()).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

describe "Capability Flags":
    it "CAP_WRITEC is 1":
        # @req: REQ-UNIT-LIB-010
        step("Verify: CAP_WRITEC is 1")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val CAP_WRITEC = 1
        expect(CAP_WRITEC).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "CAP_WRITE0 is 2":
        # @req: REQ-UNIT-LIB-011
        step("Verify: CAP_WRITE0 is 2")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val CAP_WRITE0 = 2
        expect(CAP_WRITE0).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    it "CAP_WRITE is 4":
        # @req: REQ-UNIT-LIB-012
        step("Verify: CAP_WRITE is 4")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val CAP_WRITE = 4
        expect(CAP_WRITE).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

    it "CAP_UART is 8":
        # @req: REQ-UNIT-LIB-013
        step("Verify: CAP_UART is 8")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val CAP_UART = 8
        expect(CAP_UART).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

    it "CAP_INTERNED is 16":
        # @req: REQ-UNIT-LIB-014
        step("Verify: CAP_INTERNED is 16")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val CAP_INTERNED = 16
        expect(CAP_INTERNED).to_equal(16)  # oracle: expected value 16 is the behavior asserted by this regression spec

    it "capability flags are disjoint powers of 2":
        # @req: REQ-UNIT-LIB-015
        step("Verify: capability flags are disjoint powers of 2")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val caps = [1, 2, 4, 8, 16]
        # Each pair OR'd must differ from each individual
        var i = 0
        var all_disjoint = true
        while i < 5:
            var j = i + 1
            while j < 5:
                val combined = caps[i] | caps[j]
                if combined == caps[i]:
                    all_disjoint = false
                if combined == caps[j]:
                    all_disjoint = false
                j = j + 1
            i = i + 1
        expect(all_disjoint).to_equal(true)

    it "full capability mask combines all flags":
        # @req: REQ-UNIT-LIB-016
        step("Verify: full capability mask combines all flags")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val all_caps = 1 | 2 | 4 | 8 | 16
        expect(all_caps).to_equal(31)  # oracle: expected value 31 is the behavior asserted by this regression spec

describe "Config Defaults":
    it "default batch_size is 3":
        # @req: REQ-UNIT-LIB-017
        step("Verify: default batch_size is 3")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val default_batch = 3
        expect(default_batch).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    it "default UART base is 0x10000000":
        # @req: REQ-UNIT-LIB-018
        step("Verify: default UART base is 0x10000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val default_uart = 0x10000000
        expect(default_uart).to_equal(268435456)  # oracle: expected value 268435456 is the behavior asserted by this regression spec

    it "RAW_BINARY_MAGIC is 0x53 (ASCII S)":
        # @req: REQ-UNIT-LIB-019
        step("Verify: RAW_BINARY_MAGIC is 0x53 (ASCII S)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val magic = 0x53
        expect(magic).to_equal(83)  # oracle: expected value 83 is the behavior asserted by this regression spec

describe "Ring Buffer Power-of-2":
    it "next_power_of_2 for 1 is 1":
        # @req: REQ-UNIT-LIB-020
        step("Verify: next_power_of_2 for 1 is 1")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var v = 0
        v = v | (v >> 1)
        v = v | (v >> 2)
        v = v | (v >> 4)
        v = v | (v >> 8)
        v = v | (v >> 16)
        # n=1 => v = 1-1 = 0, result = 0+1 = 1
        expect(v + 1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "next_power_of_2 for 5 is 8":
        # @req: REQ-UNIT-LIB-021
        step("Verify: next_power_of_2 for 5 is 8")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var v = 5 - 1  # 4
        v = v | (v >> 1)   # 4|2 = 6
        v = v | (v >> 2)   # 6|1 = 7
        v = v | (v >> 4)   # 7|0 = 7
        v = v | (v >> 8)   # 7
        v = v | (v >> 16)  # 7
        expect(v + 1).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

    it "next_power_of_2 for 16 is 16":
        # @req: REQ-UNIT-LIB-022
        step("Verify: next_power_of_2 for 16 is 16")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var v = 16 - 1  # 15
        v = v | (v >> 1)   # 15
        v = v | (v >> 2)   # 15
        v = v | (v >> 4)   # 15
        v = v | (v >> 8)   # 15
        v = v | (v >> 16)  # 15
        expect(v + 1).to_equal(16)  # oracle: expected value 16 is the behavior asserted by this regression spec

    it "bitmask wrapping works for capacity 4":
        # @req: REQ-UNIT-LIB-023
        step("Verify: bitmask wrapping works for capacity 4")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mask = 3  # capacity 4 - 1
        var idx = 0
        idx = (idx + 1) & mask
        expect(idx).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        idx = (idx + 1) & mask
        expect(idx).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        idx = (idx + 1) & mask
        expect(idx).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
        idx = (idx + 1) & mask
        expect(idx).to_equal(0)  # wraps around
