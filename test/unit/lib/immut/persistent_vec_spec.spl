# PersistentVec Specification
#
# Comprehensive tests for the RRB-tree based immutable PersistentVec.
# Covers construction, element access, immutable updates, slicing,
# higher-order operations, search, conversion, persistence guarantees,
# and stress tests with many elements.

"""
## Purpose and audience
Purpose: Verify PersistentVec.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-PERSISTENT-VEC-001 — stable requirement identity for this spec.

use std.persistent_vec.{
    PersistentVec, PersistentVec__empty, PersistentVec__from_array,
    PersistentVec__of, PersistentVec__repeat, PersistentVec__range
}

use std.spec.step

describe "PersistentVec":

    describe "empty vector":
        it "has zero length":
            step("Verify: has zero length")
            # @req: REQ-LIB-PERSISTENT-VEC-001
            val v = PersistentVec.empty()
            expect(v.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

        it "is empty":
            step("Verify: is empty")
            val v = PersistentVec.empty()
            expect(v.is_empty()).to_equal(true)

        it "get returns nil for any index":
            step("Verify: get returns nil for any index")
            val v = PersistentVec.empty()
            expect(v.get(0)).to_be_nil()
            expect(v.get(5)).to_be_nil()

        it "first returns nil":
            step("Verify: first returns nil")
            val v = PersistentVec.empty()
            expect(v.first()).to_be_nil()

        it "last returns nil":
            step("Verify: last returns nil")
            val v = PersistentVec.empty()
            expect(v.last()).to_be_nil()

        it "to_array returns empty array":
            step("Verify: to_array returns empty array")
            val v = PersistentVec.empty()
            val arr = v.to_array()
            expect(arr.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

        it "pop returns empty":
            step("Verify: pop returns empty")
            val v = PersistentVec.empty()
            val v2 = v.pop()
            expect(v2.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(v2.is_empty()).to_equal(true)

    describe "push":
        it "adds single element":
            step("Verify: adds single element")
            val v = PersistentVec.empty().push(42)
            expect(v.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(0)).to_equal(42)  # oracle: authoritative expected value documented by this spec's contract

        it "adds multiple elements in order":
            step("Verify: adds multiple elements in order")
            val v = PersistentVec.empty().push(10).push(20).push(30)
            expect(v.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(0)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(1)).to_equal(20)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(2)).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract

        it "is no longer empty after push":
            step("Verify: is no longer empty after push")
            val v = PersistentVec.empty().push(1)
            expect(v.is_empty()).to_equal(false)

        it "supports mixed types":
            step("Verify: supports mixed types")
            val v = PersistentVec.empty().push(1).push("two").push(nil)
            expect(v.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(0)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(1)).to_equal("two")
            expect(v.get(2)).to_be_nil()

    describe "get":
        it "retrieves element at valid index":
            step("Verify: retrieves element at valid index")
            val v = PersistentVec.from_array([10, 20, 30, 40, 50])
            expect(v.get(0)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(2)).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(4)).to_equal(50)  # oracle: authoritative expected value documented by this spec's contract

        it "returns nil for index beyond length":
            step("Verify: returns nil for index beyond length")
            val v = PersistentVec.from_array([1, 2, 3])
            expect(v.get(3)).to_be_nil()
            expect(v.get(100)).to_be_nil()

        it "supports negative indexing":
            step("Verify: supports negative indexing")
            val v = PersistentVec.from_array([10, 20, 30, 40])
            expect(v.get(-1)).to_equal(40)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(-2)).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(-4)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract

        it "returns nil for negative index beyond bounds":
            step("Verify: returns nil for negative index beyond bounds")
            val v = PersistentVec.from_array([1, 2])
            expect(v.get(-3)).to_be_nil()
            expect(v.get(-10)).to_be_nil()

    describe "set":
        it "replaces element at index":
            step("Verify: replaces element at index")
            val v = PersistentVec.from_array([1, 2, 3])
            val v2 = v.set(1, 99)
            expect(v2.get(1)).to_equal(99)  # oracle: authoritative expected value documented by this spec's contract

        it "returns new vector - original unchanged":
            step("Verify: returns new vector - original unchanged")
            val v1 = PersistentVec.from_array([10, 20, 30])
            val v2 = v1.set(0, 99)
            expect(v1.get(0)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
            expect(v2.get(0)).to_equal(99)  # oracle: authoritative expected value documented by this spec's contract

        it "preserves other elements":
            step("Verify: preserves other elements")
            val v = PersistentVec.from_array([1, 2, 3, 4, 5])
            val v2 = v.set(2, 99)
            expect(v2.get(0)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(v2.get(1)).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(v2.get(2)).to_equal(99)  # oracle: authoritative expected value documented by this spec's contract
            expect(v2.get(3)).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract
            expect(v2.get(4)).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract

        it "supports negative indexing":
            step("Verify: supports negative indexing")
            val v = PersistentVec.from_array([1, 2, 3])
            val v2 = v.set(-1, 99)
            expect(v2.get(2)).to_equal(99)  # oracle: authoritative expected value documented by this spec's contract

        it "returns self for out of bounds index":
            step("Verify: returns self for out of bounds index")
            val v = PersistentVec.from_array([1, 2, 3])
            val v2 = v.set(10, 99)
            expect(v2.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(v2.get(0)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

    describe "pop":
        it "removes last element":
            step("Verify: removes last element")
            val v = PersistentVec.from_array([1, 2, 3])
            val v2 = v.pop()
            expect(v2.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(v2.get(0)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(v2.get(1)).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

        it "does not modify original":
            step("Verify: does not modify original")
            val v1 = PersistentVec.from_array([10, 20, 30])
            val v2 = v1.pop()
            expect(v1.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(v1.get(2)).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract
            expect(v2.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

        it "pop to single element":
            step("Verify: pop to single element")
            val v = PersistentVec.from_array([1, 2]).pop()
            expect(v.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(0)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "pop to empty":
            step("Verify: pop to empty")
            val v = PersistentVec.from_array([42]).pop()
            expect(v.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.is_empty()).to_equal(true)

    describe "first and last":
        it "first returns element at index 0":
            step("Verify: first returns element at index 0")
            val v = PersistentVec.from_array([5, 10, 15])
            expect(v.first()).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract

        it "last returns element at last index":
            step("Verify: last returns element at last index")
            val v = PersistentVec.from_array([5, 10, 15])
            expect(v.last()).to_equal(15)  # oracle: authoritative expected value documented by this spec's contract

        it "first and last are same for single element":
            step("Verify: first and last are same for single element")
            val v = PersistentVec.from_array([42])
            expect(v.first()).to_equal(42)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.last()).to_equal(42)  # oracle: authoritative expected value documented by this spec's contract

    describe "from_array":
        it "builds from array preserving order":
            step("Verify: builds from array preserving order")
            val v = PersistentVec.from_array([10, 20, 30])
            expect(v.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(0)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(1)).to_equal(20)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(2)).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract

        it "handles empty array":
            step("Verify: handles empty array")
            val v = PersistentVec.from_array([])
            expect(v.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.is_empty()).to_equal(true)

        it "handles single element":
            step("Verify: handles single element")
            val v = PersistentVec.from_array([99])
            expect(v.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(0)).to_equal(99)  # oracle: authoritative expected value documented by this spec's contract

    describe "of":
        it "is alias for from_array":
            step("Verify: is alias for from_array")
            val v = PersistentVec.of([5, 10, 15])
            expect(v.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(0)).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(2)).to_equal(15)  # oracle: authoritative expected value documented by this spec's contract

    describe "repeat":
        it "creates vector with repeated value":
            step("Verify: creates vector with repeated value")
            val v = PersistentVec.repeat(7, 5)
            expect(v.len()).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(0)).to_equal(7)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(4)).to_equal(7)  # oracle: authoritative expected value documented by this spec's contract

        it "repeat zero gives empty":
            step("Verify: repeat zero gives empty")
            val v = PersistentVec.repeat(99, 0)
            expect(v.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.is_empty()).to_equal(true)

    describe "range":
        it "creates integer range":
            step("Verify: creates integer range")
            val v = PersistentVec.range(0, 5)
            expect(v.len()).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(0)).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(4)).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract

        it "creates non-zero start range":
            step("Verify: creates non-zero start range")
            val v = PersistentVec.range(3, 7)
            expect(v.len()).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(0)).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(3)).to_equal(6)  # oracle: authoritative expected value documented by this spec's contract

        it "empty range when start equals end":
            step("Verify: empty range when start equals end")
            val v = PersistentVec.range(5, 5)
            expect(v.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.is_empty()).to_equal(true)

    describe "persistence":
        it "original unchanged after push":
            step("Verify: original unchanged after push")
            val v0 = PersistentVec.empty()
            val v1 = v0.push(1)
            val v2 = v1.push(2)
            val v3 = v2.push(3)
            expect(v0.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(v1.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(v2.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(v3.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

        it "branches share structure":
            step("Verify: branches share structure")
            val base = PersistentVec.from_array([1, 2, 3])
            val branch_a = base.push(40)
            val branch_b = base.push(50)
            expect(base.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(branch_a.len()).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract
            expect(branch_b.len()).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract
            expect(branch_a.get(3)).to_equal(40)  # oracle: authoritative expected value documented by this spec's contract
            expect(branch_b.get(3)).to_equal(50)  # oracle: authoritative expected value documented by this spec's contract
            # Base elements identical in both branches
            expect(branch_a.get(0)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(branch_b.get(0)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "set does not modify original":
            step("Verify: set does not modify original")
            val v1 = PersistentVec.from_array([10, 20, 30])
            val v2 = v1.set(1, 99)
            expect(v1.get(1)).to_equal(20)  # oracle: authoritative expected value documented by this spec's contract
            expect(v2.get(1)).to_equal(99)  # oracle: authoritative expected value documented by this spec's contract

        it "pop does not modify original":
            step("Verify: pop does not modify original")
            val v1 = PersistentVec.from_array([1, 2, 3])
            val v2 = v1.pop()
            expect(v1.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(v1.get(2)).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(v2.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    describe "slice":
        it "takes a slice from the middle":
            step("Verify: takes a slice from the middle")
            val v = PersistentVec.from_array([10, 20, 30, 40, 50])
            val s = v.slice(1, 4)
            expect(s.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(s.get(0)).to_equal(20)  # oracle: authoritative expected value documented by this spec's contract
            expect(s.get(1)).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract
            expect(s.get(2)).to_equal(40)  # oracle: authoritative expected value documented by this spec's contract

        it "full range returns all elements":
            step("Verify: full range returns all elements")
            val v = PersistentVec.from_array([1, 2, 3])
            val s = v.slice(0, 3)
            expect(s.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(s.get(0)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(s.get(2)).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

        it "empty slice when start equals end":
            step("Verify: empty slice when start equals end")
            val v = PersistentVec.from_array([1, 2, 3])
            val s = v.slice(2, 2)
            expect(s.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

        it "clamps end to size":
            step("Verify: clamps end to size")
            val v = PersistentVec.from_array([1, 2, 3])
            val s = v.slice(1, 100)
            expect(s.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(s.get(0)).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    describe "concat":
        it "concatenates two vectors":
            step("Verify: concatenates two vectors")
            val a = PersistentVec.from_array([1, 2])
            val b = PersistentVec.from_array([3, 4])
            val c = a.concat(b)
            expect(c.len()).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract
            expect(c.get(0)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(c.get(1)).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(c.get(2)).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(c.get(3)).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract

        it "concat with empty returns same content":
            step("Verify: concat with empty returns same content")
            val v = PersistentVec.from_array([1, 2, 3])
            val empty = PersistentVec.empty()
            val c = v.concat(empty)
            expect(c.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(c.get(0)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "empty concat with other returns other":
            step("Verify: empty concat with other returns other")
            val empty = PersistentVec.empty()
            val v = PersistentVec.from_array([10, 20])
            val c = empty.concat(v)
            expect(c.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(c.get(0)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract

        it "does not modify originals":
            step("Verify: does not modify originals")
            val a = PersistentVec.from_array([1])
            val b = PersistentVec.from_array([2])
            val c = a.concat(b)
            expect(a.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(c.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    describe "map":
        it "applies function to each element":
            step("Verify: applies function to each element")
            val v = PersistentVec.from_array([1, 2, 3])
            val doubled = v.map(_1 * 2)
            expect(doubled.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(doubled.get(0)).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(doubled.get(1)).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract
            expect(doubled.get(2)).to_equal(6)  # oracle: authoritative expected value documented by this spec's contract

        it "preserves length":
            step("Verify: preserves length")
            val v = PersistentVec.from_array([10, 20, 30])
            val result = v.map(_1 + 1)
            expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

        it "empty vector map is empty":
            step("Verify: empty vector map is empty")
            val v = PersistentVec.empty()
            val result = v.map(_1 * 2)
            expect(result.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

        it "does not modify original":
            step("Verify: does not modify original")
            val v = PersistentVec.from_array([1, 2, 3])
            val v2 = v.map(_1 * 10)
            expect(v.get(0)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(v2.get(0)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract

    describe "filter":
        it "keeps matching elements":
            step("Verify: keeps matching elements")
            val v = PersistentVec.from_array([1, 2, 3, 4, 5, 6])
            val evens = v.filter(_1 % 2 == 0)
            expect(evens.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(evens.get(0)).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(evens.get(1)).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract
            expect(evens.get(2)).to_equal(6)  # oracle: authoritative expected value documented by this spec's contract

        it "returns empty when nothing matches":
            step("Verify: returns empty when nothing matches")
            val v = PersistentVec.from_array([1, 3, 5])
            val evens = v.filter(_1 % 2 == 0)
            expect(evens.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

        it "returns all when everything matches":
            step("Verify: returns all when everything matches")
            val v = PersistentVec.from_array([2, 4, 6])
            val evens = v.filter(_1 % 2 == 0)
            expect(evens.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    describe "fold":
        it "accumulates sum":
            step("Verify: accumulates sum")
            val v = PersistentVec.from_array([1, 2, 3, 4])
            val sum = v.fold(0, \acc, x: acc + x)
            expect(sum).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract

        it "accumulates product":
            step("Verify: accumulates product")
            val v = PersistentVec.from_array([1, 2, 3, 4])
            val product = v.fold(1, \acc, x: acc * x)
            expect(product).to_equal(24)  # oracle: authoritative expected value documented by this spec's contract

        it "returns init for empty vector":
            step("Verify: returns init for empty vector")
            val v = PersistentVec.empty()
            val result = v.fold(42, \acc, x: acc + x)
            expect(result).to_equal(42)  # oracle: authoritative expected value documented by this spec's contract

        it "single element":
            step("Verify: single element")
            val v = PersistentVec.from_array([5])
            val result = v.fold(0, \acc, x: acc + x)
            expect(result).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract

    describe "take":
        it "takes first n elements":
            step("Verify: takes first n elements")
            val v = PersistentVec.from_array([10, 20, 30, 40, 50])
            val t = v.take(3)
            expect(t.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(t.get(0)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
            expect(t.get(2)).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract

        it "takes zero returns empty":
            step("Verify: takes zero returns empty")
            val v = PersistentVec.from_array([1, 2, 3])
            val t = v.take(0)
            expect(t.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

        it "takes more than length returns all":
            step("Verify: takes more than length returns all")
            val v = PersistentVec.from_array([1, 2])
            val t = v.take(10)
            expect(t.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    describe "drop":
        it "drops first n elements":
            step("Verify: drops first n elements")
            val v = PersistentVec.from_array([10, 20, 30, 40, 50])
            val d = v.drop(2)
            expect(d.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(d.get(0)).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract
            expect(d.get(2)).to_equal(50)  # oracle: authoritative expected value documented by this spec's contract

        it "drops zero returns all":
            step("Verify: drops zero returns all")
            val v = PersistentVec.from_array([1, 2, 3])
            val d = v.drop(0)
            expect(d.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

        it "drops more than length returns empty":
            step("Verify: drops more than length returns empty")
            val v = PersistentVec.from_array([1, 2])
            val d = v.drop(10)
            expect(d.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    describe "contains":
        it "finds existing element":
            step("Verify: finds existing element")
            val v = PersistentVec.from_array([10, 20, 30])
            expect(v.contains(20)).to_equal(true)

        it "returns false for missing element":
            step("Verify: returns false for missing element")
            val v = PersistentVec.from_array([10, 20, 30])
            expect(v.contains(99)).to_equal(false)

        it "returns false for empty vector":
            step("Verify: returns false for empty vector")
            val v = PersistentVec.empty()
            expect(v.contains(1)).to_equal(false)

        it "finds string elements":
            step("Verify: finds string elements")
            val v = PersistentVec.from_array(["a", "b", "c"])
            expect(v.contains("b")).to_equal(true)
            expect(v.contains("z")).to_equal(false)

    describe "index_of":
        it "finds index of existing element":
            step("Verify: finds index of existing element")
            val v = PersistentVec.from_array([10, 20, 30, 40])
            expect(v.index_of(30)).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

        it "returns -1 for missing element":
            step("Verify: returns -1 for missing element")
            val v = PersistentVec.from_array([10, 20, 30])
            expect(v.index_of(99)).to_equal(-1)  # oracle: authoritative expected value documented by this spec's contract

        it "returns first occurrence":
            step("Verify: returns first occurrence")
            val v = PersistentVec.from_array([5, 10, 5, 10])
            expect(v.index_of(10)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "returns -1 for empty vector":
            step("Verify: returns -1 for empty vector")
            val v = PersistentVec.empty()
            expect(v.index_of(1)).to_equal(-1)  # oracle: authoritative expected value documented by this spec's contract

    describe "reverse":
        it "reverses the vector":
            step("Verify: reverses the vector")
            val v = PersistentVec.from_array([1, 2, 3])
            val r = v.reverse()
            expect(r.get(0)).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(r.get(1)).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(r.get(2)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "preserves length":
            step("Verify: preserves length")
            val v = PersistentVec.from_array([1, 2, 3, 4])
            val r = v.reverse()
            expect(r.len()).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract

        it "reverse of single element is same":
            step("Verify: reverse of single element is same")
            val v = PersistentVec.from_array([42])
            val r = v.reverse()
            expect(r.get(0)).to_equal(42)  # oracle: authoritative expected value documented by this spec's contract
            expect(r.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "reverse of empty is empty":
            step("Verify: reverse of empty is empty")
            val v = PersistentVec.empty()
            val r = v.reverse()
            expect(r.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

        it "does not modify original":
            step("Verify: does not modify original")
            val v = PersistentVec.from_array([1, 2, 3])
            val r = v.reverse()
            expect(v.get(0)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(r.get(0)).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    describe "to_array":
        it "converts to array in order":
            step("Verify: converts to array in order")
            val v = PersistentVec.from_array([10, 20, 30])
            val arr = v.to_array()
            expect(arr.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(arr[0]).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
            expect(arr[1]).to_equal(20)  # oracle: authoritative expected value documented by this spec's contract
            expect(arr[2]).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract

        it "empty vector gives empty array":
            step("Verify: empty vector gives empty array")
            val v = PersistentVec.empty()
            val arr = v.to_array()
            expect(arr.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

        it "round-trips through array":
            step("Verify: round-trips through array")
            val original = [5, 10, 15, 20]
            val v = PersistentVec.from_array(original)
            val arr = v.to_array()
            expect(arr.len()).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract
            expect(arr[0]).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract
            expect(arr[3]).to_equal(20)  # oracle: authoritative expected value documented by this spec's contract

    describe "each":
        it "visits all elements":
            step("Verify: visits all elements")
            val v = PersistentVec.from_array([1, 2, 3])
            # Note: each uses closures; nested closures cannot modify
            # captured vars in interpreter mode. We just test it runs.
            v.each(\x: x)
            expect(v.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    describe "stress test":
        it "push and get many elements via helper fn":
            step("Verify: push and get many elements via helper fn")
            fn run_push_stress() -> i64:
                var v = PersistentVec.empty()
                var i = 0
                while i < 200:
                    v = v.push(i)
                    i = i + 1
                v.len()
            expect(run_push_stress()).to_equal(200)  # oracle: authoritative expected value documented by this spec's contract

        it "verify elements after many pushes":
            step("Verify: verify elements after many pushes")
            fn run_verify_stress() -> i64:
                var v = PersistentVec.empty()
                var i = 0
                while i < 100:
                    v = v.push(i * 10)
                    i = i + 1
                var ok_count = 0
                i = 0
                while i < 100:
                    if v.get(i) == i * 10:
                        ok_count = ok_count + 1
                    i = i + 1
                ok_count
            expect(run_verify_stress()).to_equal(100)  # oracle: authoritative expected value documented by this spec's contract

        it "push then pop many elements":
            step("Verify: push then pop many elements")
            fn run_pop_stress() -> i64:
                var v = PersistentVec.empty()
                var i = 0
                while i < 50:
                    v = v.push(i)
                    i = i + 1
                i = 0
                while i < 25:
                    v = v.pop()
                    i = i + 1
                v.len()
            expect(run_pop_stress()).to_equal(25)  # oracle: authoritative expected value documented by this spec's contract

        it "range creates correct elements":
            step("Verify: range creates correct elements")
            fn run_range_stress() -> i64:
                val v = PersistentVec.range(0, 100)
                var ok_count = 0
                var i = 0
                while i < 100:
                    if v.get(i) == i:
                        ok_count = ok_count + 1
                    i = i + 1
                ok_count
            expect(run_range_stress()).to_equal(100)  # oracle: authoritative expected value documented by this spec's contract

    describe "edge cases":
        it "set same value returns equivalent vector":
            step("Verify: set same value returns equivalent vector")
            val v = PersistentVec.from_array([1, 2, 3])
            val v2 = v.set(1, 2)
            expect(v2.get(1)).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(v2.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

        it "nil value stored and retrieved":
            step("Verify: nil value stored and retrieved")
            val v = PersistentVec.empty().push(nil)
            expect(v.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.get(0)).to_be_nil()

        it "push after pop restores length":
            step("Verify: push after pop restores length")
            val v = PersistentVec.from_array([1, 2, 3])
            val v2 = v.pop().push(99)
            expect(v2.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(v2.get(2)).to_equal(99)  # oracle: authoritative expected value documented by this spec's contract

        it "concat two empties is empty":
            step("Verify: concat two empties is empty")
            val a = PersistentVec.empty()
            val b = PersistentVec.empty()
            val c = a.concat(b)
            expect(c.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(c.is_empty()).to_equal(true)

        it "filter then map":
            step("Verify: filter then map")
            val v = PersistentVec.from_array([1, 2, 3, 4, 5, 6])
            val result = v.filter(_1 % 2 == 0).map(_1 * 10)
            expect(result.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(result.get(0)).to_equal(20)  # oracle: authoritative expected value documented by this spec's contract
            expect(result.get(1)).to_equal(40)  # oracle: authoritative expected value documented by this spec's contract
            expect(result.get(2)).to_equal(60)  # oracle: authoritative expected value documented by this spec's contract

        it "take and drop partition the vector":
            step("Verify: take and drop partition the vector")
            val v = PersistentVec.from_array([1, 2, 3, 4, 5])
            val head = v.take(3)
            val tail = v.drop(3)
            expect(head.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(tail.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(head.get(0)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(tail.get(0)).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract
