"""
## Purpose and audience
Purpose: Verify multi-line lambda bodies on collections.
Audience: compiler and tooling engineers who maintain this spec.

# Multi-line Lambda Body Forcing Specification

A lambda body written on following indented lines parses to `Expr::DoBlock`
(parser `parse_lambda_body`), and evaluating a `DoBlock` as an expression
yields an unforced, always-truthy `Value::BlockClosure` instead of running the
statements. Every collection helper that called `evaluate_expr(body, ..)`
therefore got a closure object back: `filter` kept EVERY element, `map` stored
closures, and side effects never happened -- all silently, with no diagnostic.

Regression cover for
doc/08_tracking/bug/multiline_lambda_body_unforced_blockclosure_2026-08-21.md.
Each example pairs the single-line form (always worked) with the multi-line
form (silently wrong pre-fix) so a future regression cannot hide by breaking
both consistently.
"""

# @req: REQ-LIB-MULTILINE-LAMBDA-BODY-001 — stable requirement identity for this spec.

use std.spipe.*

use std.spec.step

describe "multi-line lambda bodies on collections":

    it "filters an array with a multi-line predicate":
        step("Verify: filters an array with a multi-line predicate")
        # @req: REQ-LIB-MULTILINE-LAMBDA-BODY-001
        val xs = [1, 2, 3, 4, 5]
        val single = xs.filter(\x: x > 3)
        val multi = xs.filter(\x:
            x > 3
        )
        expect(single.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(multi.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    it "maps an array with a multi-line body":
        step("Verify: maps an array with a multi-line body")
        val xs = [1, 2, 3]
        val doubled = xs.map(\x:
            x * 2
        )
        expect(doubled.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(doubled[0]).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(doubled[2]).to_equal(6)  # oracle: authoritative expected value documented by this spec's contract

    it "answers any with a multi-line predicate":
        step("Verify: answers any with a multi-line predicate")
        val xs = [1, 2, 3]
        expect(xs.any(\x:
            x > 2
        )).to_equal(true)
        expect(xs.any(\x:
            x > 99
        )).to_equal(false)

    it "answers all with a multi-line predicate":
        step("Verify: answers all with a multi-line predicate")
        val xs = [2, 4, 6]
        expect(xs.all(\x:
            x % 2 == 0
        )).to_equal(true)
        expect(xs.all(\x:
            x > 4
        )).to_equal(false)

    it "finds with a multi-line predicate":
        step("Verify: finds with a multi-line predicate")
        val xs = [1, 5, 9]
        val found = xs.find(\x:
            x > 4
        )
        expect(found).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract

    it "reduces with a multi-line body":
        step("Verify: reduces with a multi-line body")
        val xs = [1, 2, 3, 4]
        val total = xs.reduce(0, \acc, x:
            acc + x
        )
        expect(total).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract

    it "filters a dict with a multi-line predicate":
        step("Verify: filters a dict with a multi-line predicate")
        var m: {i64: i64} = {}
        m[1] = 10
        m[2] = 20
        val single = m.filter(\k, v: v > 15)
        val multi = m.filter(\k, v:
            v > 15
        )
        expect(single.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(multi.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

    it "maps dict values with a multi-line body":
        step("Verify: maps dict values with a multi-line body")
        var m: {i64: i64} = {}
        m[1] = 10
        m[2] = 20
        val doubled = m.map_values(\v:
            v * 2
        )
        expect(doubled.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
