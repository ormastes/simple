"""
## Purpose and audience
Behavioral specification for doomgeneric.
Audience: compiler/runtime developers and spec maintainers who need
to verify this component's observable behavior and pinned values.
"""
# @req: REQ-LIB-PORTS_DOOMGENERIC-001
# @cover src/lib/nogc_sync_mut/game2d/ports/doomgeneric.spl 80%

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.game2d.ports.doomgeneric as dg

describe "doomgeneric port proof":
    it "boots from a WAD-like byte buffer":
        # @req: REQ-LIB-PORTS_DOOMGENERIC-001
        step("Verify: boots from a WAD-like byte buffer")
        val state = dg.DoomPortState.boot(dg.proof_wad())
        expect(state.wad_bytes).to_equal(12)  # oracle: expected value pinned by spec
        expect(state.tick).to_equal(0)  # oracle: expected value pinned by spec

    it "advances deterministic ticks and input movement":
        # @req: REQ-LIB-PORTS_DOOMGENERIC-001
        step("Verify: advances deterministic ticks and input movement")
        val s0 = dg.DoomPortState.boot(dg.proof_wad())
        val input = dg.DoomPortInput(forward: true, back: false, turn_left: false, turn_right: false, fire: true)
        val s1 = dg.doom_tick(s0, input)
        expect(s1.tick).to_equal(1)  # oracle: expected value pinned by spec
        expect(s1.shots).to_equal(1)  # oracle: expected value pinned by spec
        expect(s1.x > s0.x).to_equal(true)  # oracle: expected value pinned by spec

    it "turns without host APIs":
        # @req: REQ-LIB-PORTS_DOOMGENERIC-001
        step("Verify: turns without host APIs")
        val s0 = dg.DoomPortState.boot(dg.proof_wad())
        val input = dg.DoomPortInput(forward: false, back: false, turn_left: false, turn_right: true, fire: false)
        val s1 = dg.doom_tick(s0, input)
        expect(s1.angle).to_equal(1)  # oracle: expected value pinned by spec

    it "renders deterministic non-black software frames":
        # @req: REQ-LIB-PORTS_DOOMGENERIC-001
        step("Verify: renders deterministic non-black software frames")
        val state = dg.DoomPortState.boot(dg.proof_wad())
        val frame1 = dg.render_frame(state, 160, 100)
        val frame2 = dg.render_frame(state, 160, 100)
        expect(frame1.non_black_count()).to_equal(160 * 100)  # oracle: expected value pinned by spec
        expect(frame1.hash()).to_equal(frame2.hash())  # oracle: expected value pinned by spec
