# Reproducing spec for:
#   doc/08_tracking/bug/crypto_types_text_to_bytes_collides_with_base_encoding_2026-08-21.md
#
# `bytes_to_text` had 8 co-compiled definitions across 3 distinct signatures
# ([u8]->text, [i64]->text, List<i64>->text, ([u8],i64,i64)->text). A call to
# the websocket module's List<i64> variant silently resolved to
# std.common.string_core's [u8] variant, which drops out-of-range bytes instead
# of substituting '?'. RED before the rename to tree-unique names.
use std.spec
use std.nogc_sync_mut.websocket.handshake.{ws_bytes_to_text, word_to_bytes}

describe "websocket bytes_to_text resolves to its own module definition":

    it "substitutes '?' for an out-of-range byte instead of dropping the run":
        var bytes = word_to_bytes(0x41424344)
        bytes.push(-1)
        val decoded = ws_bytes_to_text(bytes)
        expect(decoded.length()).to_equal(5)
        expect(decoded).to_equal("ABCD?")

    it "decodes ordinary in-range bytes unchanged":
        expect(ws_bytes_to_text([72, 105])).to_equal("Hi")
