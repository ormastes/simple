# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# `expect_not` is imported by name rather than through `use std.spec.*`: the
# glob form does not resolve it on the interpreter even though it is `pub`.
# See doc/08_tracking/bug/interpreter_raw_array_and_glob_import_gaps_2026-08-21.md §3.
use std.spec.step

use std.spec.{describe, it, expect, expect_not, assert_true}

describe "boolean expect helpers":
    # @manual scenario evidence
    it "accepts bare positive boolean expectations":
        # @req REQ-SSPEC-UNIT
        step("accepts bare positive boolean expectations")
        assert_true(true)

    it "accepts bare negative boolean expectations":
        # @req REQ-SSPEC-UNIT
        step("accepts bare negative boolean expectations")
        expect_not(false)

    it "keeps explicit matchers for non-boolean equality":
        # @req REQ-SSPEC-UNIT
        step("keeps explicit matchers for non-boolean equality")
        expect(1 + 1).to_equal(2)
