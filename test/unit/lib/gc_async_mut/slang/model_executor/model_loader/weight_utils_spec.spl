# slang weight_utils — dtype size helpers

use std.gc_async_mut.slang.model_executor.model_loader.weight_utils.{Dtype, dtype_element_size, tensor_byte_len}
use std.spec.step
# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/lib/gc_async_mut/slang/model_executor/model_loader/weight_utils_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/weight_utils_spec.md
# doc-path: doc/03_plan/sys_test/weight_utils_spec.md
# doc-path: doc/04_architecture/weight_utils_spec.md
# doc-path: doc/05_design/weight_utils_spec_oracles.md
# @manual: primary


describe "dtype_element_size":
    it "F32 is 4 bytes":
        step("Verify: F32 is 4 bytes")
        # @req: REQ-SSPEC-LOCAL-001
        expect(dtype_element_size(Dtype.F32)).to_equal(4)

    it "F16 and Bf16 are 2 bytes":
        step("Verify: F16 and Bf16 are 2 bytes")
        # @req: REQ-SSPEC-LOCAL-001
        expect(dtype_element_size(Dtype.F16)).to_equal(2)
        expect(dtype_element_size(Dtype.Bf16)).to_equal(2)

    it "F64 and I64 are 8 bytes":
        step("Verify: F64 and I64 are 8 bytes")
        # @req: REQ-SSPEC-LOCAL-001
        expect(dtype_element_size(Dtype.F64)).to_equal(8)
        expect(dtype_element_size(Dtype.I64)).to_equal(8)

    it "U8 and Bool are 1 byte":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: U8 and Bool are 1 byte")
        expect(dtype_element_size(Dtype.U8)).to_equal(1)
        expect(dtype_element_size(Dtype.Bool)).to_equal(1)

describe "tensor_byte_len":
    it "scalar is one element":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: scalar is one element")
        val shape: [i64] = []
        expect(tensor_byte_len(shape, Dtype.F32)).to_equal(4)

    it "vector of 8 f32 is 32 bytes":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: vector of 8 f32 is 32 bytes")
        val shape: [i64] = [8]
        expect(tensor_byte_len(shape, Dtype.F32)).to_equal(32)

    it "matrix 4x8 bf16 is 64 bytes":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: matrix 4x8 bf16 is 64 bytes")
        val shape: [i64] = [4, 8]
        expect(tensor_byte_len(shape, Dtype.Bf16)).to_equal(64)

    it "returns 0 on negative dim":
        step("Verify: returns 0 on negative dim")
        # @req: REQ-SSPEC-LOCAL-001
        val shape: [i64] = [-1, 8]
        expect(tensor_byte_len(shape, Dtype.F32)).to_equal(0)
