"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/gc_async_mut/slang/model_executor/model_loader/weight_utils_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# slang weight_utils — dtype size helpers

use std.gc_async_mut.slang.model_executor.model_loader.weight_utils.{Dtype, dtype_element_size, tensor_byte_len}
use std.spec.{step}

describe "dtype_element_size":
    it "F32 is 4 bytes":
        # @req: REQ-UNIT-LIB-001
        step("Verify: F32 is 4 bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(dtype_element_size(Dtype.F32)).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

    it "F16 and Bf16 are 2 bytes":
        # @req: REQ-UNIT-LIB-002
        step("Verify: F16 and Bf16 are 2 bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(dtype_element_size(Dtype.F16)).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(dtype_element_size(Dtype.Bf16)).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    it "F64 and I64 are 8 bytes":
        # @req: REQ-UNIT-LIB-003
        step("Verify: F64 and I64 are 8 bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(dtype_element_size(Dtype.F64)).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec
        expect(dtype_element_size(Dtype.I64)).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

    it "U8 and Bool are 1 byte":
        # @req: REQ-UNIT-LIB-004
        step("Verify: U8 and Bool are 1 byte")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(dtype_element_size(Dtype.U8)).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(dtype_element_size(Dtype.Bool)).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

describe "tensor_byte_len":
    it "scalar is one element":
        # @req: REQ-UNIT-LIB-005
        step("Verify: scalar is one element")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val shape: [i64] = []
        expect(tensor_byte_len(shape, Dtype.F32)).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

    it "vector of 8 f32 is 32 bytes":
        # @req: REQ-UNIT-LIB-006
        step("Verify: vector of 8 f32 is 32 bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val shape: [i64] = [8]
        expect(tensor_byte_len(shape, Dtype.F32)).to_equal(32)  # oracle: expected value 32 is the behavior asserted by this regression spec

    it "matrix 4x8 bf16 is 64 bytes":
        # @req: REQ-UNIT-LIB-007
        step("Verify: matrix 4x8 bf16 is 64 bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val shape: [i64] = [4, 8]
        expect(tensor_byte_len(shape, Dtype.Bf16)).to_equal(64)  # oracle: expected value 64 is the behavior asserted by this regression spec

    it "returns 0 on negative dim":
        # @req: REQ-UNIT-LIB-008
        step("Verify: returns 0 on negative dim")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val shape: [i64] = [-1, 8]
        expect(tensor_byte_len(shape, Dtype.F32)).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
