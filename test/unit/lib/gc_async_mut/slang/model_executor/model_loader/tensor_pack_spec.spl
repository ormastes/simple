"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/gc_async_mut/slang/model_executor/model_loader/tensor_pack_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# slang tensor_pack — data type surface + A2 writer specs
#
# A2 adds plan_chunks/write_chunk/sha256_chunk. These tests fail until Phase 5.

use std.gc_async_mut.slang.model_executor.model_loader.tensor_pack.{TensorPack, TensorInfo, ChunkInfo, plan_chunks, write_chunk, sha256_chunk, DEFAULT_CHUNK_ALIGN, DEFAULT_PREFERRED_CHUNK_BYTES}
use std.gc_async_mut.slang.model_executor.model_loader.weight_utils.{Dtype}
use std.spec.{step}

describe "TensorPack.empty":
    it "has the supplied pack_root":
        # @req: REQ-UNIT-LIB-001
        step("Verify: has the supplied pack_root")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val pack = TensorPack.empty("/models/llama3-8b")
        expect(pack.pack_root).to_equal("/models/llama3-8b")

    it "has zero tensors and chunks":
        # @req: REQ-UNIT-LIB-002
        step("Verify: has zero tensors and chunks")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val pack = TensorPack.empty("/x")
        expect(pack.tensor_count()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(pack.chunk_count()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "has empty model_id and revision":
        # @req: REQ-UNIT-LIB-003
        step("Verify: has empty model_id and revision")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val pack = TensorPack.empty("/x")
        expect(pack.model_id).to_equal("")
        expect(pack.revision).to_equal("")

describe "TensorPack.find_tensor":
    it "returns empty-named TensorInfo when missing":
        # @req: REQ-UNIT-LIB-004
        step("Verify: returns empty-named TensorInfo when missing")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val pack = TensorPack.empty("/x")
        val t = pack.find_tensor("missing")
        expect(t.name).to_equal("")

    it "finds a tensor that is present":
        # @req: REQ-UNIT-LIB-005
        step("Verify: finds a tensor that is present")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var pack = TensorPack.empty("/x")
        val shape: [i64] = [4, 8]
        pack.tensors.push(TensorInfo(
            name: "w0",
            shape: shape,
            dtype: Dtype.F16,
            chunk_id: 0,
            offset_in_chunk: 0,
            byte_len: 64
        ))
        val t = pack.find_tensor("w0")
        expect(t.name).to_equal("w0")
        expect(t.byte_len).to_equal(64)  # oracle: expected value 64 is the behavior asserted by this regression spec

describe "ChunkInfo":
    it "stores relative path and digest":
        # @req: REQ-UNIT-LIB-006
        step("Verify: stores relative path and digest")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val c = ChunkInfo(
            id: 0,
            relative_path: "data-000.bin",
            byte_len: 2097152,
            digest_hex: "0011aabb"
        )
        expect(c.relative_path).to_equal("data-000.bin")
        expect(c.digest_hex).to_equal("0011aabb")

# ----- A2 writer specs (failing until Phase 5) -----

describe "DEFAULT constants (A2)":
    it "chunk align is 4 KiB":
        # @req: REQ-UNIT-LIB-007
        step("Verify: chunk align is 4 KiB")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(DEFAULT_CHUNK_ALIGN).to_equal(4096)  # oracle: expected value 4096 is the behavior asserted by this regression spec

    it "preferred chunk bytes is 2 MiB":
        # @req: REQ-UNIT-LIB-008
        step("Verify: preferred chunk bytes is 2 MiB")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(DEFAULT_PREFERRED_CHUNK_BYTES).to_equal(2097152)  # oracle: expected value 2097152 is the behavior asserted by this regression spec

describe "plan_chunks (A2)":
    it "emits a single chunk for two small tensors (16B + 24B, fits in one 2 MiB chunk)":
        # @req: REQ-UNIT-LIB-009
        step("Verify: emits a single chunk for two small tensors (16B + 24B, fits in one 2 MiB chunk)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val tensors = [
            TensorInfo(name: "w", shape: [2, 2], dtype: Dtype.F32,
                       chunk_id: 0, offset_in_chunk: 0, byte_len: 16),
            TensorInfo(name: "b", shape: [3], dtype: Dtype.I64,
                       chunk_id: 0, offset_in_chunk: 0, byte_len: 24)
        ]
        val pack = plan_chunks(tensors, DEFAULT_CHUNK_ALIGN, DEFAULT_PREFERRED_CHUNK_BYTES)
        expect(pack.chunk_count()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(pack.tensor_count()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    it "aligns the second tensor to DEFAULT_CHUNK_ALIGN (4096)":
        # @req: REQ-UNIT-LIB-010
        step("Verify: aligns the second tensor to DEFAULT_CHUNK_ALIGN (4096)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val tensors = [
            TensorInfo(name: "w", shape: [2, 2], dtype: Dtype.F32,
                       chunk_id: 0, offset_in_chunk: 0, byte_len: 16),
            TensorInfo(name: "b", shape: [3], dtype: Dtype.I64,
                       chunk_id: 0, offset_in_chunk: 0, byte_len: 24)
        ]
        val pack = plan_chunks(tensors, DEFAULT_CHUNK_ALIGN, DEFAULT_PREFERRED_CHUNK_BYTES)
        val second = pack.tensors[1]
        # 16 bytes then align-up to 4096.
        expect(second.offset_in_chunk).to_equal(4096)  # oracle: expected value 4096 is the behavior asserted by this regression spec

describe "write_chunk (A2)":
    it "emits chunk bytes of expected length (tensor bytes + align padding)":
        # @req: REQ-UNIT-LIB-011
        step("Verify: emits chunk bytes of expected length (tensor bytes + align padding)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t = TensorInfo(name: "w", shape: [2, 2], dtype: Dtype.F32,
                           chunk_id: 0, offset_in_chunk: 0, byte_len: 16)
        var src: [u8] = []
        var i = 0
        while i < 16:
            src.push(0xAB as u8)
            i = i + 1
        val out = write_chunk(t, src, DEFAULT_CHUNK_ALIGN)
        # First 16 bytes are the tensor; remainder (if any) is zero padding.
        expect(out.len()).to_be_greater_than(15)

describe "sha256_chunk (A2)":
    it "returns a 64-char lowercase hex digest":
        # @req: REQ-UNIT-LIB-012
        step("Verify: returns a 64-char lowercase hex digest")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var bytes: [u8] = []
        var i = 0
        while i < 16:
            bytes.push(0 as u8)
            i = i + 1
        val hex = sha256_chunk(bytes)
        expect(hex.len()).to_equal(64)  # oracle: expected value 64 is the behavior asserted by this regression spec

    it "is deterministic (same input => same hex)":
        # @req: REQ-UNIT-LIB-013
        step("Verify: is deterministic (same input => same hex)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var a: [u8] = []
        var b: [u8] = []
        var i = 0
        while i < 8:
            a.push(0x42 as u8)
            b.push(0x42 as u8)
            i = i + 1
        expect(sha256_chunk(a)).to_equal(sha256_chunk(b))
