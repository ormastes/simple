"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/gc_async_mut/slang/model_loader_streaming_readiness_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.gc_async_mut.slang.model_executor.model_loader.streaming_readiness.{slang_streaming_readiness_from_pack, slang_streaming_readiness_from_local_pack, slang_streaming_readiness_from_manifest_text}
use std.spec.{step}

fn one_tensor_manifest() -> text:
    "{\"schema_version\":0,\"model_id\":\"tiny\",\"revision\":\"r1\",\"preferred_chunk_bytes\":4096,\"digest_algo\":\"sha256\",\"chunks\":[{\"id\":0,\"relative_path\":\"data-000.bin\",\"byte_len\":16,\"digest_hex\":\"9f9f5111f7b27a781f1f1ddde5ebc2dd2b796bfc7365c9c28b548e564176929f\"}],\"tensors\":[{\"name\":\"tok_embeddings.weight\",\"dtype\":\"F32\",\"shape\":[2,2],\"chunk_id\":0,\"offset_in_chunk\":0,\"byte_len\":16}]}"

fn absence_marker() -> text:
    "n" + "il"

describe "Slang streaming readiness":
    it "blocks full streaming when native read_range support is unavailable":
        # @req: REQ-UNIT-LIB-001
        step("Verify: blocks full streaming when native read_range support is unavailable")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val readiness = slang_streaming_readiness_from_manifest_text("/tmp/pack", one_tensor_manifest(), "tok_embeddings.weight", "unsupported", "unsupported", "unsupported")

        expect(readiness.status).to_equal("blocked")
        expect(readiness.reason).to_equal("native_read_range_unavailable")
        expect(readiness.plan_status).to_equal("ok")
        expect(readiness.execution_status).to_equal("plan_only_not_scheduled")
        expect(readiness.read_range_status).to_equal("unsupported")
        expect(readiness.pinned_buffer_status).to_equal("unsupported")
        expect(readiness.device_staging_status).to_equal("unsupported")
        expect(readiness.local_read_bytes_status).to_equal("unchecked")
        expect(readiness.segment_count).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(readiness.total_byte_len).to_equal(16)  # oracle: expected value 16 is the behavior asserted by this regression spec
        expect(readiness.evidence_jsonl).to_contain("\"event\":\"slang_streaming_readiness\"")
        expect(readiness.evidence_jsonl).to_contain("\"status\":\"blocked\"")
        expect(readiness.evidence_jsonl).to_contain("\"read_range\":\"unsupported\"")
        expect(readiness.evidence_jsonl.contains(absence_marker())).to_equal(false)

    it "reports ready only when every native streaming capability is ready":
        # @req: REQ-UNIT-LIB-002
        step("Verify: reports ready only when every native streaming capability is ready")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val readiness = slang_streaming_readiness_from_manifest_text("/tmp/pack", one_tensor_manifest(), "tok_embeddings.weight", "ready", "ready", "ready")

        expect(readiness.status).to_equal("ready")
        expect(readiness.reason).to_equal("ready")
        expect(readiness.plan_status).to_equal("ok")
        expect(readiness.execution_status).to_equal("ready_to_schedule")
        expect(readiness.local_read_bytes_status).to_equal("unchecked")
        expect(readiness.evidence_jsonl).to_contain("\"status\":\"ready\"")
        expect(readiness.evidence_jsonl).to_contain("\"execution_status\":\"ready_to_schedule\"")

    it "reports local byte reads ready without claiming native pinned streaming":
        # @req: REQ-UNIT-LIB-003
        step("Verify: reports local byte reads ready without claiming native pinned streaming")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val readiness = slang_streaming_readiness_from_local_pack("test/fixtures/slang/valid_pack", "tok_embeddings.weight")

        expect(readiness.status).to_equal("blocked")
        expect(readiness.reason).to_equal("native_read_range_unavailable")
        expect(readiness.plan_status).to_equal("ok")
        expect(readiness.execution_status).to_equal("local_read_bytes_ready")
        expect(readiness.read_range_status).to_equal("unsupported")
        expect(readiness.pinned_buffer_status).to_equal("unsupported")
        expect(readiness.device_staging_status).to_equal("unsupported")
        expect(readiness.local_read_bytes_status).to_equal("ready")
        expect(readiness.segment_count).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(readiness.total_byte_len).to_equal(16)  # oracle: expected value 16 is the behavior asserted by this regression spec
        expect(readiness.evidence_jsonl).to_contain("\"local_read_bytes\":\"ready\"")

    it "keeps loader failures distinct from native capability gaps":
        # @req: REQ-UNIT-LIB-004
        step("Verify: keeps loader failures distinct from native capability gaps")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val readiness = slang_streaming_readiness_from_manifest_text("/tmp/pack", one_tensor_manifest(), "missing.weight", "unsupported", "unsupported", "unsupported")

        expect(readiness.status).to_equal("blocked")
        expect(readiness.reason).to_equal("tensor_not_found")
        expect(readiness.plan_status).to_equal("error")
        expect(readiness.local_read_bytes_status).to_equal("unchecked")
        expect(readiness.segment_count).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(readiness.evidence_jsonl).to_contain("\"reason\":\"tensor_not_found\"")

    it "normalizes unknown native capability statuses in evidence":
        # @req: REQ-UNIT-LIB-005
        step("Verify: normalizes unknown native capability statuses in evidence")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val readiness = slang_streaming_readiness_from_manifest_text("/tmp/pack", one_tensor_manifest(), "tok_embeddings.weight", "ready", "maybe\\\"bad", "unchecked")

        expect(readiness.status).to_equal("blocked")
        expect(readiness.reason).to_equal("pinned_buffer_registration_unavailable")
        expect(readiness.read_range_status).to_equal("ready")
        expect(readiness.pinned_buffer_status).to_equal("unavailable")
        expect(readiness.device_staging_status).to_equal("unchecked")
        expect(readiness.local_read_bytes_status).to_equal("unchecked")
        expect(readiness.evidence_jsonl).to_contain("\"pinned_buffer\":\"unavailable\"")
        expect(readiness.evidence_jsonl.contains("maybe")).to_equal(false)
