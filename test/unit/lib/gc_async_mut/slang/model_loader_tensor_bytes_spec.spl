"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/gc_async_mut/slang/model_loader_tensor_bytes_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.gc_async_mut.slang.model_executor.model_loader.loader.{LoaderError, load_tensor_bytes_from_pack}
use std.spec.{step}

fn tensor_byte_status(root: text, name: text) -> text:
    match load_tensor_bytes_from_pack(root, name):
        Ok(_) => "ok"
        Err(e) =>
            match e:
                LoaderError.PackRootNotFound => "missing_root"
                LoaderError.ManifestInvalid => "invalid_manifest"
                LoaderError.ChunkOpenFailed => "chunk_error"
                LoaderError.TensorNotFound => "tensor_not_found"
                LoaderError.TensorRangeInvalid => "tensor_range_invalid"
                LoaderError.NvfsUnavailable => "nvfs_unavailable"
                LoaderError.Unimplemented => "unimplemented"

fn tensor_byte_len(root: text, name: text) -> i64:
    match load_tensor_bytes_from_pack(root, name):
        Ok(bytes) => bytes.len()
        Err(_) => -1

fn tensor_byte_at(root: text, name: text, index: i64) -> i64:
    match load_tensor_bytes_from_pack(root, name):
        Ok(bytes) =>
            if index < 0 or index >= bytes.len():
                return -1
            bytes[index] as i64
        Err(_) => -1

describe "Slang tensor byte range loader":
    it "loads the declared tensor byte range from a validated pack":
        # @req: REQ-UNIT-LIB-001
        step("Verify: loads the declared tensor byte range from a validated pack")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val root = "test/fixtures/slang/valid_pack"
        val name = "tok_embeddings.weight"
        expect(tensor_byte_status(root, name)).to_equal("ok")
        expect(tensor_byte_len(root, name)).to_equal(16)  # oracle: expected value 16 is the behavior asserted by this regression spec
        expect(tensor_byte_at(root, name, 0)).to_equal(48)  # oracle: expected value 48 is the behavior asserted by this regression spec
        expect(tensor_byte_at(root, name, 15)).to_equal(102)  # oracle: expected value 102 is the behavior asserted by this regression spec

    it "loads a declared tensor byte range spanning sequential chunks":
        # @req: REQ-UNIT-LIB-002
        step("Verify: loads a declared tensor byte range spanning sequential chunks")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val root = "test/fixtures/slang/cross_chunk_pack"
        val name = "split.weight"
        expect(tensor_byte_status(root, name)).to_equal("ok")
        expect(tensor_byte_len(root, name)).to_equal(7)  # oracle: expected value 7 is the behavior asserted by this regression spec
        expect(tensor_byte_at(root, name, 0)).to_equal(98)  # oracle: expected value 98 is the behavior asserted by this regression spec
        expect(tensor_byte_at(root, name, 3)).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec
        expect(tensor_byte_at(root, name, 4)).to_equal(69)  # oracle: expected value 69 is the behavior asserted by this regression spec
        expect(tensor_byte_at(root, name, 6)).to_equal(71)  # oracle: expected value 71 is the behavior asserted by this regression spec

    it "reports missing tensor names explicitly":
        # @req: REQ-UNIT-LIB-003
        step("Verify: reports missing tensor names explicitly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(tensor_byte_status("test/fixtures/slang/valid_pack", "missing.weight")).to_equal("tensor_not_found")

    it "does not read bytes from invalid packs":
        # @req: REQ-UNIT-LIB-004
        step("Verify: does not read bytes from invalid packs")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(tensor_byte_status("test/fixtures/slang/missing_chunk_pack", "tok_embeddings.weight")).to_equal("chunk_error")
        expect(tensor_byte_status("test/fixtures/slang/wrong_chunk_pack", "tok_embeddings.weight")).to_equal("chunk_error")
