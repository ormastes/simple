# @req: REQ-LIB-GC-ASYNC-MUT-001

# svllm weight_utils — dtype size helpers

use std.gc_async_mut.svllm.model_executor.model_loader.weight_utils.{Dtype, dtype_element_size, tensor_byte_len}

use std.spec.step

describe "dtype_element_size":
    it "F32 is 4 bytes":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: F32 is 4 bytes")
        expect(dtype_element_size(Dtype.F32)).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "F16 and Bf16 are 2 bytes":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: F16 and Bf16 are 2 bytes")
        expect(dtype_element_size(Dtype.F16)).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(dtype_element_size(Dtype.Bf16)).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "F64 and I64 are 8 bytes":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: F64 and I64 are 8 bytes")
        expect(dtype_element_size(Dtype.F64)).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(dtype_element_size(Dtype.I64)).to_equal(8)  # oracle: 8 — named expected value from the requirement

    it "U8 and Bool are 1 byte":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: U8 and Bool are 1 byte")
        expect(dtype_element_size(Dtype.U8)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(dtype_element_size(Dtype.Bool)).to_equal(1)  # oracle: 1 — named expected value from the requirement

describe "tensor_byte_len":
    it "scalar is one element":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: scalar is one element")
        val shape: [i64] = []
        expect(tensor_byte_len(shape, Dtype.F32)).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "vector of 8 f32 is 32 bytes":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: vector of 8 f32 is 32 bytes")
        val shape: [i64] = [8]
        expect(tensor_byte_len(shape, Dtype.F32)).to_equal(32)  # oracle: 32 — named expected value from the requirement

    it "matrix 4x8 bf16 is 64 bytes":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: matrix 4x8 bf16 is 64 bytes")
        val shape: [i64] = [4, 8]
        expect(tensor_byte_len(shape, Dtype.Bf16)).to_equal(64)  # oracle: 64 — named expected value from the requirement

    it "returns 0 on negative dim":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: returns 0 on negative dim")
        val shape: [i64] = [-1, 8]
        expect(tensor_byte_len(shape, Dtype.F32)).to_equal(0)  # oracle: 0 — named expected value from the requirement
