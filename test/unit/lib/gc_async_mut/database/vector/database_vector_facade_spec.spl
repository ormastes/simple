"""
## Purpose and audience
Facade contract for the gc_async_mut vector-database re-exports, written for
the database-library owners. It pins the public surface (types, distance and
codec helpers, index and store) so a rename or signature drift in any
re-exported symbol fails this facade spec before user code notices.
## Operator workflow
Run `./src/compiler_rust/target/bootstrap/simple run test/unit/lib/gc_async_mut/database/vector/database_vector_facade_spec.spl`
from the repository root after touching any `std.gc_async_mut.database.vector.*` module.
## Compatibility and limitations
The facade imports resolve from the project stdlib roots only; on hosts where
the runner cannot resolve `std.gc_async_mut.database.vector.types` the file
fails at load with executed=0. That is an environment gate, not a product
verdict — the assertions below describe the surface as shipped in `src/lib/gc_async_mut/database/vector/`.
## Verification guidance and troubleshooting
A load failure means the import root moved; fix the runner's stdlib resolution
before trusting any red assertion here. A red assertion on a distance or codec
helper means the re-exported symbol changed behavior, not just its facade row.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: vector database facade

use std.spec
use std.spec.step
use std.gc_async_mut.database.vector.types.{DistanceMetric, VectorEntry, SearchResult, VectorDbConfig, VectorDbError, default_vector_config}
use std.gc_async_mut.database.vector.distance.{cosine_similarity, cosine_distance, euclidean_distance, dot_product, l2_norm, normalize_vector, compute_distance}
use std.gc_async_mut.database.vector.codec.{encode_vector, decode_vector, encode_metadata, decode_metadata}
use std.gc_async_mut.database.vector.index.{BruteForceIndex}
use std.gc_async_mut.database.vector.store.VectorDatabase

describe "gc_async_mut database vector facade":

    it "re-exports vector types, distance, and codec helpers":
        # @req REQ-DATABASE-VECTOR-001
        # @capture(statistics): facade re-export verdicts for types, distance, and codec helpers
        step("Construct the re-exported config, entry, result, and error types")
        val cfg = default_vector_config(3)
        expect(cfg.dimensions).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
        expect(cfg.metric).to_equal(DistanceMetric.Cosine)
        val entry = VectorEntry(id: "a", vector: [1.0, 0.0], metadata: {"kind": "unit"}, norm: 1.0)
        expect(entry.id).to_equal("a")
        val result = SearchResult(id: "a", distance: 0.0, metadata: {})
        expect(result.distance).to_equal(0.0)  # oracle: a freshly constructed result carries distance 0.0
        val err = VectorDbError.EntryNotFound(id: "missing")
        match err:
            VectorDbError.EntryNotFound(id):
                expect(id).to_equal("missing")
            _:
                expect(false).to_equal(true)  # NOTE: wildcard arm is unreachable; this facade only raises EntryNotFound here

        step("Evaluate the re-exported distance helpers on pinned vectors")
        expect(dot_product([1.0, 2.0], [3.0, 4.0])).to_equal(11.0)  # oracle: 1*3 + 2*4 is the textbook dot product
        expect(l2_norm([3.0, 4.0])).to_equal(5.0)  # oracle: the 3-4-5 right triangle fixes the Euclidean norm
        expect(cosine_similarity([1.0, 0.0], [1.0, 0.0])).to_equal(1.0)  # oracle: identical vectors have similarity exactly 1
        expect(cosine_distance([1.0, 0.0], [1.0, 0.0])).to_equal(0.0)  # oracle: distance is 1 minus similarity, so 0 here
        expect(euclidean_distance([0.0, 0.0], [3.0, 4.0])).to_equal(5.0)  # oracle: the 3-4-5 right triangle fixes the distance
        expect(compute_distance([1.0], [1.0], DistanceMetric.Cosine)).to_equal(0.0)  # oracle: identical unit vectors are 0 apart under Cosine
        expect(normalize_vector([3.0, 4.0]).len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

        step("Round-trip a vector and metadata through the codec helpers")
        val encoded = encode_vector([1.0, 2.0])
        expect(encoded).to_contain("1")
        if val Some(decoded) = decode_vector(encoded):
            expect(decoded.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        else:
            expect(false).to_equal(true)  # NOTE: decode failure on an encode_vector output is the defect this arm guards
        val meta = encode_metadata({"a": "b"})
        expect(meta).to_contain("a")
        expect(decode_metadata(meta)["a"]).to_equal("b")

    it "re-exports index and store surfaces":
        # @req REQ-DATABASE-VECTOR-001
        # @capture(statistics): facade re-export verdicts for the index and store surfaces
        step("Construct the re-exported BruteForceIndex and check its empty size")
        val idx = BruteForceIndex.create(2)
        expect(idx.size()).to_equal(0)  # oracle: a freshly created index holds no vectors yet
        val maybe_db: VectorDatabase? = nil
        expect(maybe_db).to_be_nil()
