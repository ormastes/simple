"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/gc_async_mut/database/vector/database_vector_facade_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec
use std.gc_async_mut.database.vector.types.{DistanceMetric, VectorEntry, SearchResult, VectorDbConfig, VectorDbError, default_vector_config}
use std.gc_async_mut.database.vector.distance.{cosine_similarity, cosine_distance, euclidean_distance, dot_product, l2_norm, normalize_vector, compute_distance}
use std.gc_async_mut.database.vector.codec.{encode_vector, decode_vector, encode_metadata, decode_metadata}
use std.gc_async_mut.database.vector.index.{BruteForceIndex}
use std.gc_async_mut.database.vector.store.VectorDatabase

describe "gc_async_mut database vector facade":

    it "re-exports vector types, distance, and codec helpers":
        # @req: REQ-UNIT-LIB-001
        step("Verify: re-exports vector types, distance, and codec helpers")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = default_vector_config(3)
        expect(cfg.dimensions).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
        expect(cfg.metric).to_equal(DistanceMetric.Cosine)
        val entry = VectorEntry(id: "a", vector: [1.0, 0.0], metadata: {"kind": "unit"}, norm: 1.0)
        expect(entry.id).to_equal("a")
        val result = SearchResult(id: "a", distance: 0.0, metadata: {})
        expect(result.distance).to_equal(0.0)
        val err = VectorDbError.EntryNotFound(id: "missing")
        match err:
            VectorDbError.EntryNotFound(id):
                expect(id).to_equal("missing")
            _:
                pass_do_nothing

        expect(dot_product([1.0, 2.0], [3.0, 4.0])).to_equal(11.0)
        expect(l2_norm([3.0, 4.0])).to_equal(5.0)
        expect(cosine_similarity([1.0, 0.0], [1.0, 0.0])).to_equal(1.0)
        expect(cosine_distance([1.0, 0.0], [1.0, 0.0])).to_equal(0.0)
        expect(euclidean_distance([0.0, 0.0], [3.0, 4.0])).to_equal(5.0)
        expect(compute_distance([1.0], [1.0], DistanceMetric.Cosine)).to_equal(0.0)
        expect(normalize_vector([3.0, 4.0]).len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

        val encoded = encode_vector([1.0, 2.0])
        expect(encoded).to_contain("1")
        if val Some(decoded) = decode_vector(encoded):
            expect(decoded.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        else:
            expect(false).to_equal(true)
        val meta = encode_metadata({"a": "b"})
        expect(meta).to_contain("a")
        expect(decode_metadata(meta)["a"]).to_equal("b")

    it "re-exports index and store surfaces":
        # @req: REQ-UNIT-LIB-002
        step("Verify: re-exports index and store surfaces")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val idx = BruteForceIndex.create(2)
        expect(idx.size()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        val maybe_db: VectorDatabase? = nil
        expect(maybe_db).to_be_nil()
