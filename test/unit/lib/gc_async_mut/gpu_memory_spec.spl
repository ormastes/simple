"""
## Purpose and audience
Exercises the `std.gpu.memory` GpuArray upload/download/copy contracts and the
gpu_alloc allocation family against the host fallback path that ships with
every build, so GPU memory behavior stays verified on machines without CUDA
hardware. Audience: maintainers of the GPU session, engine2d, and
browser-engine render lanes who change memory.spl or its torch SFFI surface.
## Operator workflow
Run this file alone with the seed runner:
`./src/compiler_rust/target/bootstrap/simple run test/unit/lib/gc_async_mut/gpu_memory_spec.spl`
## Compatibility and limitations
Device-side CUDA transfers (rt_torch_torchtensor_cuda round-trip) are not
exercised here; the None_-backend host store gives upload/download parity by
design, so the round-trip, copy, and free contracts are asserted on that path.
`size_bytes` is pinned to 4 bytes per element, matching the f32 fallback
buffer, not the generic element type.
## Verification guidance and troubleshooting
A round-trip or copy failure means the host fallback store diverged from GPU
parity: rerun the file alone and compare the failing expect line against
`src/lib/nogc_async_mut/gpu/memory.spl`. The upload size guard failing open is
a security-relevant regression — treat a "rejects" scenario failure as
blocking, not cosmetic.
"""
# Lifecycle: doc/01_research/domain/gpu_dynamic_backend_full_offload.md ;
# doc/03_plan/agent_tasks/gpu_dynamic_backend_full_offload.md ;
# doc/04_architecture/gpu_dynamic_backend_full_offload.md ;
# doc/05_design/gpu_dynamic_backend_full_offload.md
# @manual_section: gpu_array_transfer

use std.spec.step
use std.nogc_async_mut.gpu.device.{GpuBackend, gpu_none}
use std.gpu.memory.{GpuArray, gpu_alloc, gpu_alloc_upload, gpu_alloc_zeros, gpu_copy}

describe "GpuArray transfer contracts":
    it "round-trips uploaded host data through download":
        # @req REQ-GPU-MEM-001
        # @capture(statistics): uploaded vs downloaded payload values retained for review
        step("Allocate a three-element array on the host fallback backend")
        val arr = gpu_alloc<f64>(gpu_none(), 3)
        step("Upload three values and download them back")
        expect(arr.upload([1.0, 2.0, 3.0])).to_equal(true)  # oracle: host fallback stores the payload and reports success
        val back = arr.download()
        expect(back.len()).to_equal(3)  # oracle: allocation held three elements
        expect(back[0]).to_equal(1.0)  # oracle: first uploaded value survives the round trip
        expect(back[2]).to_equal(3.0)  # oracle: last uploaded value survives the round trip

    it "rejects an upload whose length mismatches the allocation":
        # @req REQ-GPU-MEM-001
        # @capture(statistics): rejected-upload verdict retained as evidence
        step("Allocate two elements and attempt a three-element upload")
        val arr = gpu_alloc<f64>(gpu_none(), 2)
        expect(arr.upload([1.0, 2.0, 3.0])).to_equal(false)  # oracle: upload fails closed on the count mismatch guard

    it "downloads reflect the latest upload, starting from allocated zeros":
        # @req REQ-GPU-MEM-001
        # @capture(statistics): pre- and post-upload download values retained as evidence
        step("Allocate two elements and download before any upload")
        val arr = gpu_alloc<f64>(gpu_none(), 2)
        expect(arr.download().len()).to_equal(2)  # oracle: the fallback pre-fills the allocation with count zeros
        step("Upload a new payload and download again")
        arr.upload([9.0, 9.0])
        expect(arr.download()[0]).to_equal(9.0)  # oracle: download serves the latest uploaded payload

    it "records the host payload length as the element count":
        # @req REQ-GPU-MEM-002
        # @capture(statistics): alloc-upload element count retained as evidence
        step("Allocate and upload three values in one call")
        val arr = gpu_alloc_upload<f64>(gpu_none(), [7.0, 8.0, 9.0])
        expect(arr.count).to_equal(3)  # oracle: one element per uploaded value
        expect(arr.device_id).to_equal(-1)  # oracle: the None_ fallback owns no device

    it "allocates count zeros on the fallback path":
        # @req REQ-GPU-MEM-002
        # @capture(statistics): fallback zero-allocation length retained as evidence
        step("Allocate 256 elements without a device and download them")
        val arr = gpu_alloc<f64>(gpu_none(), 256)
        val zeros = arr.download()
        expect(zeros.len()).to_equal(256)  # oracle: fallback mirrors the CUDA zeros allocation
        expect(zeros[0]).to_equal(0.0)  # oracle: buffer is zero-initialized

    it "allocates zeroed memory through gpu_alloc_zeros":
        # @req REQ-GPU-MEM-002
        # @capture(statistics): zeros-allocation device fallback retained as evidence
        step("Allocate four zeroed elements through the zeros helper")
        val arr = gpu_alloc_zeros<f64>(gpu_none(), 4)
        expect(arr.device_id).to_equal(-1)  # oracle: same None_ fallback as gpu_alloc
        expect(arr.count).to_equal(4)  # oracle: requested element count is honored

    it "sizes memory at four bytes per element":
        # @req REQ-GPU-MEM-002
        # @capture(statistics): byte-size computation retained as evidence
        step("Allocate 1024 elements and read the byte size")
        val arr = gpu_alloc<f64>(gpu_none(), 1024)
        expect(arr.size_bytes()).to_equal(4096)  # oracle: fallback buffer stores 4-byte f32 elements per memory.spl size_bytes

    it "copies the host buffer between non-GPU arrays":
        # @req REQ-GPU-MEM-003
        # @capture(statistics): copied payload values retained as evidence
        step("Upload two values into a source array")
        val src = gpu_alloc<f64>(gpu_none(), 2)
        src.upload([4.0, 5.0])
        step("Copy into a second host array and download from it")
        val dst = gpu_alloc<f64>(gpu_none(), 2)
        expect(src.copy_to(dst)).to_equal(true)  # oracle: host-to-host copy is a supported path
        expect(dst.count).to_equal(2)  # oracle: destination inherits the source element count
        expect(dst.download()[1]).to_equal(5.0)  # oracle: second payload value was copied

    it "refuses to copy from a host array into a CUDA array":
        # @req REQ-GPU-MEM-003
        # @capture(statistics): mixed-backend rejection retained as evidence
        step("Attempt a host-to-CUDA copy and expect fail-closed behavior")
        val src = gpu_alloc<f64>(gpu_none(), 1)
        val cuda_dst = GpuArray<f64>(
            backend: GpuBackend.Cuda,
            device_id: 0,
            count: 1,
            torch_handle: 0,
            host_buf: []
        )
        expect(src.copy_to(cuda_dst)).to_equal(false)  # oracle: mixed-backend copy fails closed per the copy_to guard

    it "flags a CUDA array with a null handle as invalid":
        # @req REQ-GPU-MEM-003
        # @capture(statistics): null-handle validity verdict retained as evidence
        step("Construct a CUDA-backed array without a device allocation")
        val orphan = GpuArray<f64>(
            backend: GpuBackend.Cuda,
            device_id: 0,
            count: 1,
            torch_handle: 0,
            host_buf: []
        )
        expect(orphan.is_valid()).to_equal(false)  # oracle: a zero torch handle means no device buffer exists

    it "keeps free idempotent and empties the host buffer":
        # @req REQ-GPU-MEM-003
        # @capture(statistics): post-free download length retained as evidence
        step("Upload two values, then free the array twice")
        val arr = gpu_alloc<f64>(gpu_none(), 2)
        arr.upload([1.0, 2.0])
        arr.free()
        arr.free()
        expect(arr.download().len()).to_equal(0)  # oracle: free() clears the retained payload and is safe to repeat

    it "clones an array without disturbing its source":
        # @req REQ-GPU-MEM-003
        # @capture(statistics): clone and source payload values retained as evidence
        step("Upload two values, clone, and read both arrays")
        val src = gpu_alloc<f64>(gpu_none(), 2)
        src.upload([6.0, 7.0])
        val twin = gpu_copy<f64>(src)
        expect(twin.count).to_equal(2)  # oracle: clone carries the source element count
        expect(twin.download()[0]).to_equal(6.0)  # oracle: clone shares the host payload
        expect(src.download()[0]).to_equal(6.0)  # oracle: source payload is intact after cloning

describe "GPU allocation family":
    it "keeps the allocation functions total for unsupported backends":
        # @req REQ-GPU-MEM-002
        # @capture(statistics): unsupported-backend allocation shape retained as evidence
        step("Allocate through gpu_alloc on the None_ backend")
        val arr = gpu_alloc<f64>(gpu_none(), 512)
        expect(arr.count).to_equal(512)  # oracle: the requested count is preserved on the fallback
        expect(arr.device_id).to_equal(-1)  # oracle: an unsupported backend owns no device id
