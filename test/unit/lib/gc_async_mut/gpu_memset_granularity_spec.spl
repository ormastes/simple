# Regression: typed GPU memset wrappers must use the right fill GRANULARITY.
#
# ORACLE (external -- CUDA Driver API, cuda.h / "CUDA Driver API" reference; NOT
# read out of the code under test):
#     CUresult cuMemsetD8_v2 (CUdeviceptr dstDevice, unsigned char uc, size_t N)
#         -> sets N BYTES to the 8-bit value uc.
#     CUresult cuMemsetD32_v2(CUdeviceptr dstDevice, unsigned int  ui, size_t N)
#         -> sets N 32-BIT ELEMENTS to the 32-bit value ui; dstDevice must be
#            4-byte aligned. N is an ELEMENT count, not a byte count.
#
# The defect: gpu_memset_i32(ptr, v, count) forwarded to the BYTE-granularity
# hook as gpu_memset(ptr, v, count * 4). cuMemsetD8 truncates v to one byte and
# replicates it, so a request to fill with 1 wrote 0x01010101 = 16843009 into
# every i32 -- and returned Ok(()). Every value outside 0..=255, and every
# value in that range that is not byte-uniform, was silently wrong.
#
# These assertions run entirely on the host: gpu_i32_fill_pattern is the pure
# value->32-bit-word conversion the wrapper now feeds to cuMemsetD32_v2, so the
# contract is checkable with no CUDA context and no device.

"""
## Purpose and audience
Verifies the gpu memset granularity behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

use std.spec.step
use std.gc_async_mut.gpu_ops.{gpu_i32_fill_pattern, gpu_status}
use std.gc_async_mut.gpu_types.{GpuError}

fn byte_replicated(value: i64) -> i64:
    """What the OLD byte-granularity path actually wrote into each i32.

    cuMemsetD8 truncates to 8 bits and repeats that byte four times. This models
    the defect from the CUDA oracle above, independently of the fixed code.
    """
    val b = value & 0xFF
    (b << 24) | (b << 16) | (b << 8) | b

# @req: REQ-GCASYNCM-GpuMemsetGranularity-001
describe "gpu typed memset granularity":
    it "fills an i32 with the value itself, not a byte-replicated word":
        # @req: REQ-GCASYNCM-GpuMemsetGranularity-001
        step("Verify: fills an i32 with the value itself, not a byte-replicated word")
        # The regression, stated against the oracle. Before the fix the wrapper
        # produced byte_replicated(1) == 16843009 instead of 1.
        expect(gpu_i32_fill_pattern(1)).to_equal(1)  # oracle: value fixed by the spec contract
        expect(byte_replicated(1)).to_equal(16843009)  # oracle: value fixed by the spec contract

    it "carries values wider than one byte through unchanged":
        # @req: REQ-GCASYNCM-GpuMemsetGranularity-001
        step("Verify: carries values wider than one byte through unchanged")
        # 0x0000BEEF does not survive a byte-granularity fill at all: the low
        # byte 0xEF is replicated to 0xEFEFEFEF.
        expect(gpu_i32_fill_pattern(48879)).to_equal(48879)  # oracle: value fixed by the spec contract
        expect(byte_replicated(48879)).to_equal(4025479151)  # oracle: value fixed by the spec contract

    it "encodes negative i32 as two's complement low 32 bits":
        # @req: REQ-GCASYNCM-GpuMemsetGranularity-001
        step("Verify: encodes negative i32 as two's complement low 32 bits")
        # -1 -> 0xFFFFFFFF (4294967295). cuMemsetD32_v2 takes an unsigned int.
        expect(gpu_i32_fill_pattern(-1)).to_equal(4294967295)  # oracle: value fixed by the spec contract
        expect(gpu_i32_fill_pattern(-2)).to_equal(4294967294)  # oracle: value fixed by the spec contract

    it "agrees with the byte path exactly on byte-uniform values (control)":
        # @req: REQ-GCASYNCM-GpuMemsetGranularity-001
        step("Verify: agrees with the byte path exactly on byte-uniform values (control)")
        # Control: passes in BOTH directions. 0 and 0x01010101 are the only
        # shapes the old path got right, so this proves the suite is not
        # uniformly red and that the fix did not break the overlapping cases.
        expect(gpu_i32_fill_pattern(0)).to_equal(byte_replicated(0))
        expect(gpu_i32_fill_pattern(16843009)).to_equal(byte_replicated(16843009))

    it "keeps the status predicate intact (control)":
        # @req: REQ-GCASYNCM-GpuMemsetGranularity-001
        step("Verify: keeps the status predicate intact (control)")
        # Control: unrelated to granularity, holds in both directions.
        match gpu_status(0):
            case Ok(_):
                expect(true).to_equal(true)
            case Err(e):
                expect("gpu_status(0) reported an error").to_equal("Ok")
