"""
## Purpose and audience
Exercises the torch training stack in `std.gc_async_mut.torch.torch_training` —
loss criteria, the SGD/Adam/RMSprop optimizers, seed utilities, no_grad, and
the Sequential container — on the state and contracts that hold without a CUDA
device. Audience: maintainers of the torch SFFI surface and the ML training
lanes that consume it.
## Operator workflow
Run this file alone with the seed runner:
`./src/compiler_rust/target/bootstrap/simple run test/unit/lib/gc_async_mut/torch_training_spec.spl`
## Compatibility and limitations
The forward-pass SFFI symbols (rt_torch_nn_mse_loss, rt_torch_nn_cross_entropy,
rt_torch_tensor_randn for Linear init) and rt_torch_stream_create are not
backed in the current build, so loss/layer forward paths are not asserted
here. The stream scenario is kept deliberately RED — it asserts the create
contract the unbacked symbol denies, and stays failing until the runtime
exposes it. Optimizer step() runs are gradient-free: with no autograd graph
attached, step updates are no-ops by design and only state transitions
(timestep, velocity bookkeeping) are asserted.
## Verification guidance and troubleshooting
A failure in the optimizer-state scenarios means constructor bookkeeping
(velocities, moments, timestep) drifted from the create() contracts in
torch_training.spl; rerun the file alone and compare against
`src/lib/gc_async_mut/torch/torch_training.spl`. The stream scenario failing
with `unknown extern function: rt_torch_stream_create` is the known gap, not a
regression of this file.
"""
# Lifecycle: doc/01_research/domain/gpu_dynamic_backend_full_offload.md ;
# doc/03_plan/agent_tasks/gpu_dynamic_backend_full_offload.md ;
# doc/04_architecture/gpu_dynamic_backend_full_offload.md ;
# doc/05_design/gpu_dynamic_backend_full_offload.md
# @manual_section: torch_training_stack

use std.spec.step
use std.gc_async_mut.torch.mod.Tensor
use std.gc_async_mut.torch.torch_training.{SGD, Adam, RMSprop, MSELoss, CrossEntropyLoss, Sequential, Stream, set_seed, manual_seed, no_grad}

fn _two_zero_params() -> [Tensor]:
    [Tensor.zeros([3]), Tensor.zeros([4])]

describe "Loss criteria":
    it "constructs MSE and cross-entropy criteria for the training loop":
        # @req REQ-TORCH-TRAIN-001
        # @capture(statistics): constructed criterion objects retained as evidence
        step("Construct both loss criteria through their create factories")
        val mse = MSELoss.create()
        val ce = CrossEntropyLoss.create()
        expect(mse).to_be_truthy()  # oracle: create() must yield a usable criterion object
        expect(ce).to_be_truthy()  # oracle: create() must yield a usable criterion object

describe "SGD optimizer":
    it "initializes one velocity per parameter":
        # @req REQ-TORCH-TRAIN-002
        # @capture(statistics): SGD constructor state retained as evidence
        step("Create SGD over two parameters with lr 1 and no momentum")
        val sgd = SGD.create(_two_zero_params(), 1, 0)
        expect(sgd.velocities.len()).to_equal(2)  # oracle: each parameter gets its own velocity tensor
        expect(sgd.parameters.len()).to_equal(2)  # oracle: constructor retains every parameter
        expect(sgd.lr).to_equal(1)  # oracle: learning rate is stored as given

    it "runs gradient-free step and zero_grad without disturbing the table":
        # @req REQ-TORCH-TRAIN-002
        # @capture(statistics): post-step SGD state retained as evidence
        step("Step and zero-grad an optimizer whose parameters carry no autograd graph")
        val sgd = SGD.create(_two_zero_params(), 1, 0)
        sgd.step()
        sgd.zero_grad()
        expect(sgd.velocities.len()).to_equal(2)  # oracle: a gradient-free step leaves velocity bookkeeping intact

describe "Adam optimizer":
    it "initializes first and second moments per parameter":
        # @req REQ-TORCH-TRAIN-002
        # @capture(statistics): Adam constructor state retained as evidence
        step("Create Adam over two parameters")
        val adam = Adam.create(_two_zero_params(), 1, 0, 0)
        expect(adam.m.len()).to_equal(2)  # oracle: one first-moment tensor per parameter
        expect(adam.v.len()).to_equal(2)  # oracle: one second-moment tensor per parameter
        expect(adam.t).to_equal(0)  # oracle: the timestep starts at zero before any step

    it "increments the timestep on every step call":
        # @req REQ-TORCH-TRAIN-002
        # @capture(statistics): Adam timestep progression retained as evidence
        step("Step the optimizer twice and read the timestep")
        val adam = Adam.create(_two_zero_params(), 1, 0, 0)
        adam.step()
        adam.step()
        expect(adam.t).to_equal(2)  # oracle: step() advances self.t exactly once per call

describe "RMSprop optimizer":
    it "initializes the running average per parameter":
        # @req REQ-TORCH-TRAIN-002
        # @capture(statistics): RMSprop constructor state retained as evidence
        step("Create RMSprop over two parameters with alpha zero")
        val opt = RMSprop.create(_two_zero_params(), 1, 0, 0)
        expect(opt.v.len()).to_equal(2)  # oracle: one running-average tensor per parameter
        expect(opt.alpha).to_equal(0)  # oracle: smoothing constant is stored as given

describe "Seed utilities":
    it "fails closed on set_seed until the runtime exposes manual seeding":
        # @req REQ-TORCH-TRAIN-003
        # @capture(statistics): fail-closed seed verdict retained as evidence
        step("Request a manual seed and check the reported status")
        expect(set_seed(42)).to_equal("unsupported")  # oracle: no rt_torch_manual_seed SFFI exists, so the helper must not claim reproducibility

    it "aliases manual_seed to the same fail-closed contract":
        # @req REQ-TORCH-TRAIN-003
        # @capture(statistics): alias seed verdict retained as evidence
        step("Request a seed through the manual_seed alias")
        expect(manual_seed(123)).to_equal("unsupported")  # oracle: the alias must agree with set_seed, not invent a second behavior

    it "runs a callback under no_grad and restores the autograd state":
        # @req REQ-TORCH-TRAIN-003
        # @capture(statistics): post-no_grad seed status retained as evidence
        step("Execute a callback inside the no_grad scope")
        no_grad(\():
            set_seed(7)
        )
        expect(set_seed(8)).to_equal("unsupported")  # oracle: the no_grad begin/end SFFI pair must leave the runtime responsive after scope exit

describe "Sequential container":
    it "creates an empty container with no layers":
        # @req REQ-TORCH-TRAIN-004
        # @capture(statistics): empty-container layer counts retained as evidence
        step("Create a Sequential container and inspect both layer tables")
        val seq = Sequential.create()
        expect(seq.layers_linear.len()).to_equal(0)  # oracle: a fresh container holds no linear layers
        expect(seq.layers_conv2d.len()).to_equal(0)  # oracle: a fresh container holds no conv layers

    it "forwards a tensor unchanged through an empty container":
        # @req REQ-TORCH-TRAIN-004
        # @capture(statistics): identity-forward tensor handles retained as evidence
        step("Forward a tensor through the empty container")
        val seq = Sequential.create()
        val x = Tensor.zeros([2])
        val y = seq.forward(x)
        expect(y.handle).to_equal(x.handle)  # oracle: with zero layers the forward pass is the identity

describe "CUDA stream":
    it "creates a stream bound to device 0":
        # @req REQ-TORCH-TRAIN-004
        # @capture(statistics): stream creation attempt retained as evidence
        step("Create a stream for device 0 through the SFFI path")
        val s = Stream.create(0)
        expect(s.device_id).to_equal(0)  # oracle: the stream must report the device it was created for
