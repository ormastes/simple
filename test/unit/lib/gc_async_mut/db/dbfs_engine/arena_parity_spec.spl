# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec
use std.gc_async_mut.db.dbfs_engine.arena.{
    arena_create_impl, arena_append_impl, arena_readv_impl,
    arena_seal_impl, arena_is_sealed_impl, arena_total_bytes_impl
}

describe "gc_async_mut DBFS arena facade":
    # @manual scenario evidence

    it "re-exports DBFS arena operations from the canonical backend":
        # @req REQ-SSPEC-UNIT
        step("re-exports DBFS arena operations from the canonical backend")
        val aid = arena_create_impl(0, 128)
        expect(aid > 0).to_equal(true)
        val data: [u8] = [0x44, 0x42, 0x46, 0x53]
        expect(arena_append_impl(aid, data, 0)).to_equal(4)
        expect(arena_total_bytes_impl(aid)).to_equal(4)
        val rd = arena_readv_impl(aid, 0, 4)
        expect(rd.len() as i64).to_equal(4)
        expect(rd[0]).to_equal(0x44)
        expect(rd[3]).to_equal(0x53)
        expect(arena_seal_impl(aid, 1)).to_equal(true)
        expect(arena_is_sealed_impl(aid)).to_equal(true)
