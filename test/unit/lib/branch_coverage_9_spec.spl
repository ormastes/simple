# @req: REQ-LIB-LIB-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/lib/branch_coverage_9_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/branch_coverage_9.md
# doc-path: doc/03_plan/sys_test/branch_coverage_9.md
# doc-path: doc/04_architecture/branch_coverage_9.md
# doc-path: doc/05_design/branch_coverage_9.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "while loop stops when guard turns false":
        step("Verify: while loop stops when guard turns false")
        # @req: REQ-LIB-LIB-001
        var i = 0
        while i < 4:
            i = i + 1
        expect(i).to_equal(4)  # oracle: guard boundary

    it "deeply nested true chain reaches innermost arm":
        step("Verify: deeply nested true chain reaches innermost arm")
        # @req: REQ-LIB-LIB-001
        var r = 0
        if 1 == 1:
            if 2 == 2:
                if 3 == 3:
                    r = 7
        expect(r).to_equal(7)  # oracle: all three guards true

    it "continue skips the rest of the body":
        step("Verify: continue skips the rest of the body")
        # @req: REQ-LIB-LIB-001
        var c = 0
        for i in 0..5:
            if i == 2: continue
            c = c + 1
        expect(c).to_equal(4)  # oracle: one skipped iteration

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "match Some binds the payload":
        step("Verify: match Some binds the payload")
        # @req: REQ-LIB-LIB-001
        var r = 0
        match Some(5):
            Some(x): r = x
            nil: r = -1
        expect(r).to_equal(5)  # oracle: payload bound

    it "if-then arm executes on true condition":
        step("Verify: if-then arm executes on true condition")
        # @req: REQ-LIB-LIB-001
        var r = 0
        if 10 > 5:
            r = 1
        expect(r).to_equal(1)  # oracle: then arm taken

    it "elif second arm wins when first guard fails":
        step("Verify: elif second arm wins when first guard fails")
        # @req: REQ-LIB-LIB-001
        var r = 0
        if 7 > 10:
            r = 1
        elif 7 > 9:
            r = 2
        elif 7 > 5:
            r = 3
        expect(r).to_equal(3)  # oracle: later elif evaluated after earlier false
