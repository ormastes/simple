        val csr = csr_s64_write(csr_s_init(), 0x141, 0x5A5A5A5A)
        expect(csr.sepc).to_equal(0x5A5A5A5A)  # oracle: a write through 0x141 must land in the sepc field

    it "AC-1: scause address is 0x142":
        # @req REQ-1
        # @capture(statistics): scause address mapping verdict retained as evidence
        step("Write a marker through address 0x142 and read scause")
        val csr = csr_s64_write(csr_s_init(), 0x142, 0x5A5A5A5A)
        expect(csr.scause).to_equal(0x5A5A5A5A)  # oracle: a write through 0x142 must land in the scause field

    it "AC-1: stval address is 0x143":
        # @req REQ-1
        # @capture(statistics): stval address mapping verdict retained as evidence
        step("Write a marker through address 0x143 and read stval")
        val csr = csr_s64_write(csr_s_init(), 0x143, 0x5A5A5A5A)
