        # @capture(statistics): medeleg address mapping verdict retained as evidence
        step("Write a marker through address 0x302 and read medeleg")
        val csr = csr64_write(csr64_init(), 0x302, 0x5A5A5A5A)
        expect(csr.medeleg).to_equal(0x5A5A5A5A)  # oracle: a write through 0x302 must land in the machine medeleg field

    it "AC-1: mideleg address is 0x303":
