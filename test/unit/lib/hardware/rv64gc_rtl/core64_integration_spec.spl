describe "LSU64 with MMU Sv39":
    it "AC-1: lsu64_access passes through when satp.MODE=0 (bare)":
        # @req: REQ-UNIT-LIB-028
        step("Verify: AC-1: lsu64_access passes through when satp.MODE=0 (bare)")
