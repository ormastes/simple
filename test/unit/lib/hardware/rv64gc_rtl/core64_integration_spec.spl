# @manual_section: core64_smode_csr_addresses
describe "CsrSMode Addresses":

    it "AC-1: sstatus address is 0x100":
        # @req REQ-1
        # @capture(statistics): sstatus address mapping verdict retained as evidence
        step("Write a masked marker through address 0x100 and read sstatus")
        val csr = csr_s64_write(csr_s_init(), 0x100, 0x2)
        expect(csr.sstatus).to_equal(0x2)  # oracle: the SIE bit survives the writable-field mask, proving a write through 0x100 lands in sstatus

    it "AC-1: sie address is 0x104":
        # @req REQ-1
        # @capture(statistics): sie address mapping verdict retained as evidence
        step("Write a marker through address 0x104 and read sie")
        val csr = csr_s64_write(csr_s_init(), 0x104, 0x5A5A5A5A)
        expect(csr.sie).to_equal(0x5A5A5A5A)  # oracle: a write through 0x104 must land in the sie field

    it "AC-1: stvec address is 0x105":
        # @req REQ-1
        # @capture(statistics): stvec address mapping verdict retained as evidence
        step("Write a marker through address 0x105 and read stvec")
        val csr = csr_s64_write(csr_s_init(), 0x105, 0x5A5A5A5A)
        expect(csr.stvec).to_equal(0x5A5A5A5A)  # oracle: a write through 0x105 must land in the stvec field

    it "AC-1: sepc address is 0x141":
