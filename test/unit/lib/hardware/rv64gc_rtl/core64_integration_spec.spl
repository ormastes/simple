# ============================================================================
# AC-1: Mul/Div Unsigned Division Fix (REQ-3)
# ============================================================================

describe "MulDiv64 Unsigned Division":
    it "AC-1: DIVU of large unsigned values produces correct quotient":
        # @req: REQ-UNIT-LIB-030
        step("Verify: AC-1: DIVU of large unsigned values produces correct quotient")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val state = mul_div64_init()
        # DIVU: 0xFFFF_FFFF_FFFF_FFFE / 2 = 0x7FFF_FFFF_FFFF_FFFF
        val op = 5  # DIVU opcode (MULDIV_DIVU = 5)
        val result = mul_div64_step(state, op, 0xFFFF_FFFF_FFFF_FFFE, 2)
        expect(result.rd_val).to_equal(0x7FFF_FFFF_FFFF_FFFF)

    it "AC-1: REMU of large unsigned values produces correct remainder":
        # @req: REQ-UNIT-LIB-031
        step("Verify: AC-1: REMU of large unsigned values produces correct remainder")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val state = mul_div64_init()
        val op = 7  # REMU opcode (MULDIV_REMU = 7)
        val result = mul_div64_step(state, op, 0xFFFF_FFFF_FFFF_FFFF, 3)
        expect(result.rd_val).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "AC-1: direct DIVU tick path handles large unsigned values":
        # @req: REQ-UNIT-LIB-032
        step("Verify: AC-1: direct DIVU tick path handles large unsigned values")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var state = mul_div_start(5, 0xFFFF_FFFF_FFFF_FFFE, 2)
        while state.busy:
            state = mul_div_tick(state)
        expect(state.result).to_equal(0x7FFF_FFFF_FFFF_FFFF)

    it "AC-1: direct REMU tick path handles large unsigned values":
        # @req: REQ-UNIT-LIB-033
        step("Verify: AC-1: direct REMU tick path handles large unsigned values")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var state = mul_div_start(7, 0xFFFF_FFFF_FFFF_FFFF, 3)
        while state.busy:
            state = mul_div_tick(state)
        expect(state.result).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec


# ============================================================================
# AC-1: Core Step Execution (compiled mode required for full verification)
# ============================================================================

describe "Core64 Step Execution":
    it "AC-1: core64_step returns updated state with incremented PC":
        # @req: REQ-UNIT-LIB-034
        step("Verify: AC-1: core64_step returns updated state with incremented PC")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val state = core64_init(0x8000_0000)
        val bus = soc_bus64_init()
        val result = core64_step(state, bus)
        expect(result.state.pc).to_be_greater_than(0x8000_0000)

    it "AC-1: core64_step handles R-type instruction (compiled mode for full sim)":
        # @req: REQ-UNIT-LIB-035
        step("Verify: AC-1: core64_step handles R-type instruction (compiled mode for full sim)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # ADD x1, x2, x3 = 0x003100B3
        val state = core64_init(0x8000_0000)
        val bus = soc_bus64_init()
        val result = core64_step(state, bus)
        expect(result.state.pc).to_be_greater_than(0)
