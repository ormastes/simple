## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/hardware/fpga_k26/k26_soc_top_vexriscv_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/lib/hardware/fpga_k26/k26_soc_top.spl 0%
"""
# K26 SoC Top VexRiscv-SMP Integration Specification

**Feature IDs:** opensource-riscv-rtl-simpleos
**Category:** Infrastructure
**Difficulty:** 3/5
**Status:** Draft
**Requirements:** REQ-2
**Artifacts:** N/A

## Overview

Verifies AC-2: k26_soc_top wires VexRiscv-SMP .v + AXI-HP bridge +
soc_rtl peripherals (CLINT, PLIC, UART16550). Tests that the generated
VHDL/SV top-level text references VexRiscv-SMP, CLINT, PLIC, and UART.

Covers:
- AC-2 (SOC integration: core wired to CLINT+PLIC+UART16550)
"""

use std.spipe.*
use lib.hardware.fpga_k26.k26_soc_top.{
    generate_k26_soc_top_vexriscv,
    k26_vexriscv_soc_config,
    K26VexRiscvSocConfig
}


# ============================================================================
# Helper
# ============================================================================

fn default_soc_config() -> K26VexRiscvSocConfig:
    return k26_vexriscv_soc_config()

fn soc_top_sv() -> text:
    val cfg = default_soc_config()
    return generate_k26_soc_top_vexriscv(cfg)


# ============================================================================
# AC-2: SoC Top Configuration Sanity
# ============================================================================

describe "K26VexRiscvSocConfig":
    it "AC-2: default config hart_count is 1":
        # @req: REQ-UNIT-LIB-001
            # @req: REQ-2
        step("Verify: AC-2: default config hart_count is 1")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = default_soc_config()
        expect(cfg.hart_count).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "AC-2: default config axi_data_width is 128":
        # @req: REQ-UNIT-LIB-002
        step("Verify: AC-2: default config axi_data_width is 128")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = default_soc_config()
        expect(cfg.axi_data_width).to_equal(128)  # oracle: expected value 128 is the behavior asserted by this regression spec


# ============================================================================
# AC-2: SoC Top Generated Output
# ============================================================================

describe "K26 SoC Top VexRiscv-SMP Wiring":
    it "AC-2: generated text contains VexRiscv reference":
        # @req: REQ-UNIT-LIB-003
        step("Verify: AC-2: generated text contains VexRiscv reference")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val sv = soc_top_sv()
        expect(sv).to_contain("VexRiscv")

    it "AC-2: generated text references CLINT":
        # @req: REQ-UNIT-LIB-004
        step("Verify: AC-2: generated text references CLINT")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val sv = soc_top_sv()
        expect(sv).to_contain("clint")

    it "AC-2: generated text references PLIC":
        # @req: REQ-UNIT-LIB-005
        step("Verify: AC-2: generated text references PLIC")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val sv = soc_top_sv()
        expect(sv).to_contain("plic")

    it "AC-2: generated text references UART":
        # @req: REQ-UNIT-LIB-006
        step("Verify: AC-2: generated text references UART")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val sv = soc_top_sv()
        expect(sv).to_contain("uart")

    it "AC-2: generated text references AXI HP bridge":
        # @req: REQ-UNIT-LIB-007
        step("Verify: AC-2: generated text references AXI HP bridge")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val sv = soc_top_sv()
        expect(sv).to_contain("HP0")

    it "AC-2: generated text is non-empty":
        # @req: REQ-UNIT-LIB-008
        step("Verify: AC-2: generated text is non-empty")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val sv = soc_top_sv()
        val len = sv.length()
        expect(len).to_be_greater_than(0)
