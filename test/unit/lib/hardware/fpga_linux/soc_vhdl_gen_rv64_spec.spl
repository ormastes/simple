"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/hardware/fpga_linux/soc_vhdl_gen_rv64_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/lib/hardware/fpga_linux/_SocVhdlGen/top_testbench.spl 0%
# @cover src/lib/hardware/fpga_linux/riscv_fpga_linux.spl 0%
"""
# RV64GC VHDL Generation Pipeline Specification

**Feature IDs:** rv64-fpga-linux-boot
**Category:** Infrastructure
**Difficulty:** 4/5
**Status:** Draft
**Requirements:** REQ-6, REQ-10, REQ-11
**Research:** doc/01_research/domain/vhdl_backend_linux_rtl.md
**Artifacts:** N/A

## Overview

Tests for VHDL generation pipeline producing valid RV64GC SoC VHDL.
Verifies that generated VHDL text contains the correct entity names,
port declarations, peripheral instantiations, and does NOT reference
the old rv32i_core entity.

Covers: AC-2 (VHDL generation pipeline produces valid VHDL files
that GHDL can analyze without errors)

## Compiled-Mode Notes

Text-pattern checks on generated VHDL are interpreter-safe. Actual
GHDL analysis validation requires compiled mode with GHDL installed.
"""

use std.spipe.*
use lib.hardware.fpga_linux._SocVhdlGen.top_testbench.{generate_soc_top_vhdl_rv64}


# ============================================================================
# AC-2: VHDL Generation — RV64GC Entity (REQ-10)
# ============================================================================

describe "VHDL Gen RV64 Entity":
    it "AC-2: generate_soc_top_vhdl_rv64 returns non-empty text":
        # @req: REQ-UNIT-LIB-001
            # @req: REQ-11
            # @req: REQ-10
            # @req: REQ-6
        step("Verify: AC-2: generate_soc_top_vhdl_rv64 returns non-empty text")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = generate_soc_top_vhdl_rv64()
        val len = vhdl.length()
        expect(len).to_be_greater_than(0)

    it "AC-2: generated VHDL contains rv64gc_core entity reference":
        # @req: REQ-UNIT-LIB-002
        step("Verify: AC-2: generated VHDL contains rv64gc_core entity reference")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = generate_soc_top_vhdl_rv64()
        expect(vhdl).to_contain("rv64gc_core")

    it "AC-2: generated VHDL does NOT contain rv32i_core entity":
        # @req: REQ-UNIT-LIB-003
        step("Verify: AC-2: generated VHDL does NOT contain rv32i_core entity")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = generate_soc_top_vhdl_rv64()
        val has_rv32 = vhdl.contains("rv32i_core")
        expect(has_rv32).to_equal(false)

    it "AC-2: generated VHDL contains entity declaration":
        # @req: REQ-UNIT-LIB-004
        step("Verify: AC-2: generated VHDL contains entity declaration")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = generate_soc_top_vhdl_rv64()
        expect(vhdl).to_contain("entity")

    it "AC-2: generated VHDL contains architecture declaration":
        # @req: REQ-UNIT-LIB-005
        step("Verify: AC-2: generated VHDL contains architecture declaration")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = generate_soc_top_vhdl_rv64()
        expect(vhdl).to_contain("architecture")


# ============================================================================
# AC-2: VHDL Generation — Peripheral Instantiation
# ============================================================================

describe "VHDL Gen Peripheral Instantiation":
    it "AC-2: generated VHDL instantiates CLINT":
        # @req: REQ-UNIT-LIB-006
        step("Verify: AC-2: generated VHDL instantiates CLINT")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = generate_soc_top_vhdl_rv64()
        expect(vhdl).to_contain("clint")

    it "AC-2: generated VHDL instantiates PLIC":
        # @req: REQ-UNIT-LIB-007
        step("Verify: AC-2: generated VHDL instantiates PLIC")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = generate_soc_top_vhdl_rv64()
        expect(vhdl).to_contain("plic")

    it "AC-2: generated VHDL instantiates UART16550":
        # @req: REQ-UNIT-LIB-008
        step("Verify: AC-2: generated VHDL instantiates UART16550")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = generate_soc_top_vhdl_rv64()
        expect(vhdl).to_contain("uart")

    it "AC-2: generated VHDL instantiates RAM":
        # @req: REQ-UNIT-LIB-009
        step("Verify: AC-2: generated VHDL instantiates RAM")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = generate_soc_top_vhdl_rv64()
        expect(vhdl).to_contain("ram")

    it "AC-2: generated VHDL instantiates bootrom":
        # @req: REQ-UNIT-LIB-010
        step("Verify: AC-2: generated VHDL instantiates bootrom")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = generate_soc_top_vhdl_rv64()
        expect(vhdl).to_contain("bootrom")

    it "AC-2: generated VHDL instantiates wishbone interconnect":
        # @req: REQ-UNIT-LIB-011
        step("Verify: AC-2: generated VHDL instantiates wishbone interconnect")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = generate_soc_top_vhdl_rv64()
        expect(vhdl).to_contain("wb")


# ============================================================================
# AC-2: VHDL Generation — Port Widths for 64-bit
# ============================================================================

describe "VHDL Gen 64-bit Port Widths":
    it "AC-2: generated VHDL uses 64-bit data bus width":
        # @req: REQ-UNIT-LIB-012
        step("Verify: AC-2: generated VHDL uses 64-bit data bus width")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = generate_soc_top_vhdl_rv64()
        expect(vhdl).to_contain("63 downto 0")

    it "AC-2: generated VHDL contains clock port":
        # @req: REQ-UNIT-LIB-013
        step("Verify: AC-2: generated VHDL contains clock port")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = generate_soc_top_vhdl_rv64()
        expect(vhdl).to_contain("clk")

    it "AC-2: generated VHDL contains reset port":
        # @req: REQ-UNIT-LIB-014
        step("Verify: AC-2: generated VHDL contains reset port")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val vhdl = generate_soc_top_vhdl_rv64()
        expect(vhdl).to_contain("rst")
