"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/hardware/opensource_rtl/vexriscv_smp/vexriscv_smp_import_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/lib/hardware/opensource_rtl/vexriscv_smp/mod.spl 0%
# @cover src/lib/hardware/opensource_rtl/vexriscv_smp/vexriscv_smp_top.spl 0%
"""
# VexRiscv-SMP Import Specification

**Feature IDs:** opensource-riscv-rtl-simpleos
**Category:** Infrastructure
**Difficulty:** 2/5
**Status:** Draft
**Requirements:** REQ-1
**Artifacts:** N/A

## Overview

Verifies AC-1: at least one proven RV64 core (VexRiscv-SMP) is imported
under src/lib/hardware/opensource_rtl/ with LICENSE and build docs.
Tests that the import manifest, port-map API, and .v filename resolution
functions return correct values.

Covers:
- AC-1 (RV64 core imported with license + build docs)
"""

use std.spipe.*
use lib.hardware.opensource_rtl.vexriscv_smp.vexriscv_smp_top.{
    VexRiscvSmpPortMap,
    vexriscv_smp_v_filename,
    vexriscv_smp_import_path
}


# ============================================================================
# Helper functions
# ============================================================================

fn make_single_core_config() -> VexRiscvSmpPortMap:
    return VexRiscvSmpPortMap {
        axi_data_width: 128,
        axi_addr_width: 32,
        hart_count: 1,
        icache_size_kb: 8,
        dcache_size_kb: 8,
    }

fn make_dual_core_config() -> VexRiscvSmpPortMap:
    return VexRiscvSmpPortMap {
        axi_data_width: 128,
        axi_addr_width: 32,
        hart_count: 2,
        icache_size_kb: 8,
        dcache_size_kb: 8,
    }


# ============================================================================
# AC-1: VexRiscv-SMP Port Map and Filename Resolution
# ============================================================================

describe "VexRiscvSmpPortMap":
    it "AC-1: single-core port map has axi_data_width 128":
        # @req: REQ-UNIT-LIB-001
            # @req: REQ-1
        step("Verify: AC-1: single-core port map has axi_data_width 128")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = make_single_core_config()
        expect(cfg.axi_data_width).to_equal(128)  # oracle: expected value 128 is the behavior asserted by this regression spec

    it "AC-1: single-core port map has hart_count 1":
        # @req: REQ-UNIT-LIB-002
        step("Verify: AC-1: single-core port map has hart_count 1")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = make_single_core_config()
        expect(cfg.hart_count).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "AC-1: dual-core port map has hart_count 2":
        # @req: REQ-UNIT-LIB-003
        step("Verify: AC-1: dual-core port map has hart_count 2")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = make_dual_core_config()
        expect(cfg.hart_count).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    it "AC-1: axi_addr_width is 32":
        # @req: REQ-UNIT-LIB-004
        step("Verify: AC-1: axi_addr_width is 32")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = make_single_core_config()
        expect(cfg.axi_addr_width).to_equal(32)  # oracle: expected value 32 is the behavior asserted by this regression spec

    it "AC-1: icache_size_kb is 8":
        # @req: REQ-UNIT-LIB-005
        step("Verify: AC-1: icache_size_kb is 8")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = make_single_core_config()
        expect(cfg.icache_size_kb).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec


describe "vexriscv_smp_v_filename":
    it "AC-1: single-core filename starts with VexRiscvLitexSmpCluster":
        # @req: REQ-UNIT-LIB-006
        step("Verify: AC-1: single-core filename starts with VexRiscvLitexSmpCluster")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = make_single_core_config()
        val name = vexriscv_smp_v_filename(cfg)
        expect(name).to_start_with("VexRiscvLitexSmpCluster")

    it "AC-1: single-core filename contains Cc1 (1 core)":
        # @req: REQ-UNIT-LIB-007
        step("Verify: AC-1: single-core filename contains Cc1 (1 core)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = make_single_core_config()
        val name = vexriscv_smp_v_filename(cfg)
        expect(name).to_contain("Cc1")

    it "AC-1: dual-core filename contains Cc2 (2 cores)":
        # @req: REQ-UNIT-LIB-008
        step("Verify: AC-1: dual-core filename contains Cc2 (2 cores)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = make_dual_core_config()
        val name = vexriscv_smp_v_filename(cfg)
        expect(name).to_contain("Cc2")

    it "AC-1: filename contains Iw64 (64-bit instruction bus)":
        # @req: REQ-UNIT-LIB-009
        step("Verify: AC-1: filename contains Iw64 (64-bit instruction bus)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = make_single_core_config()
        val name = vexriscv_smp_v_filename(cfg)
        expect(name).to_contain("Iw64")

    it "AC-1: filename contains Dw64 (64-bit data bus)":
        # @req: REQ-UNIT-LIB-010
        step("Verify: AC-1: filename contains Dw64 (64-bit data bus)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = make_single_core_config()
        val name = vexriscv_smp_v_filename(cfg)
        expect(name).to_contain("Dw64")

    it "AC-1: filename contains Ldw128 (128-bit LiteDRAM interface)":
        # @req: REQ-UNIT-LIB-011
        step("Verify: AC-1: filename contains Ldw128 (128-bit LiteDRAM interface)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = make_single_core_config()
        val name = vexriscv_smp_v_filename(cfg)
        expect(name).to_contain("Ldw128")

    it "AC-1: filename ends with .v":
        # @req: REQ-UNIT-LIB-012
        step("Verify: AC-1: filename ends with .v")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = make_single_core_config()
        val name = vexriscv_smp_v_filename(cfg)
        expect(name).to_end_with(".v")


describe "vexriscv_smp_import_path":
    it "AC-1: import path is non-empty":
        # @req: REQ-UNIT-LIB-013
        step("Verify: AC-1: import path is non-empty")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val p = vexriscv_smp_import_path()
        val len = p.length()
        expect(len).to_be_greater_than(0)

    it "AC-1: import path contains opensource_rtl":
        # @req: REQ-UNIT-LIB-014
        step("Verify: AC-1: import path contains opensource_rtl")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val p = vexriscv_smp_import_path()
        expect(p).to_contain("opensource_rtl")

    it "AC-1: import path contains vexriscv_smp":
        # @req: REQ-UNIT-LIB-015
        step("Verify: AC-1: import path contains vexriscv_smp")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val p = vexriscv_smp_import_path()
        expect(p).to_contain("vexriscv_smp")
