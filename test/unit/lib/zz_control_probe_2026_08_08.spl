use std.spec.{describe, it, expect}

@inline
fn zz_i(x: i64) -> i64:
    return x + 1

@pure
fn zz_p(x: i64) -> i64:
    return x + 2

@unsafe
fn zz_u(x: i64) -> i64:
    return x + 3

@hardware
fn zz_h(x: i64) -> i64:
    return x + 4

describe "zz control probe":
    it "runs":
        expect(zz_i(1) + zz_p(1) + zz_u(1) + zz_h(1)).to_equal(14)
