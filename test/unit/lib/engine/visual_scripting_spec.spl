# Visual Scripting spec — graph, nodes, connections

"""
## Purpose and audience
Verifies the visual scripting behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.scripting.visual_graph.{VisualGraph, VisualNode}
use std.nogc_sync_mut.engine.scripting.node_types.{create_event_node, create_branch_node, create_math_node, create_print_node}

# @req: REQ-ENGINE-VisualScripting-001
describe "VisualGraph":
    it "adds nodes with auto-incrementing IDs":
        # @req: REQ-ENGINE-VisualScripting-001
        step("Verify: adds nodes with auto-incrementing IDs")
        var graph = VisualGraph.new("test_graph")
        val n1 = graph.add_node("event", "OnStart")
        val n2 = graph.add_node("print", "Log")
        expect(n1).to_equal(1)  # oracle: value fixed by the spec contract
        expect(n2).to_equal(2)  # oracle: value fixed by the spec contract
        expect(graph.node_count()).to_equal(2)  # oracle: value fixed by the spec contract

    it "connects and disconnects nodes":
        # @req: REQ-ENGINE-VisualScripting-001
        step("Verify: connects and disconnects nodes")
        var graph = VisualGraph.new("test")
        val n1 = graph.add_node("event", "OnStart")
        val n2 = graph.add_node("print", "Log")
        graph.connect(n1, "exec", n2, "exec")
        expect(graph.connection_count()).to_equal(1)  # oracle: value fixed by the spec contract
        graph.disconnect(n1, n2)
        expect(graph.connection_count()).to_equal(0)  # oracle: value fixed by the spec contract

    it "finds connections to a node":
        # @req: REQ-ENGINE-VisualScripting-001
        step("Verify: finds connections to a node")
        var graph = VisualGraph.new("test")
        val n1 = graph.add_node("event", "A")
        val n2 = graph.add_node("event", "B")
        val n3 = graph.add_node("print", "C")
        graph.connect(n1, "exec", n3, "exec")
        graph.connect(n2, "exec", n3, "exec2")
        val conns = graph.get_connections_to(n3)
        expect(conns.len().to_i32()).to_equal(2)  # oracle: value fixed by the spec contract

    it "clears all nodes and connections":
        # @req: REQ-ENGINE-VisualScripting-001
        step("Verify: clears all nodes and connections")
        var graph = VisualGraph.new("test")
        graph.add_node("event", "A")
        graph.add_node("print", "B")
        graph.connect(1, "exec", 2, "exec")
        graph.clear()
        expect(graph.node_count()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(graph.connection_count()).to_equal(0)  # oracle: value fixed by the spec contract

describe "VisualNode":
    it "manages input and output ports":
        # @req: REQ-ENGINE-VisualScripting-001
        step("Verify: manages input and output ports")
        var node = VisualNode.new(1, "math", "Add")
        node.add_input("a", "float")
        node.add_input("b", "float")
        node.add_output("result", "float")
        expect(node.input_count()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(node.output_count()).to_equal(1)  # oracle: value fixed by the spec contract

describe "Node type factories":
    it "creates event node with exec output":
        # @req: REQ-ENGINE-VisualScripting-001
        step("Verify: creates event node with exec output")
        val node = create_event_node(1, "OnStart")
        expect(node.output_count()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(node.input_count()).to_equal(0)  # oracle: value fixed by the spec contract

    it "creates branch node with condition input and two exec outputs":
        # @req: REQ-ENGINE-VisualScripting-001
        step("Verify: creates branch node with condition input and two exec outputs")
        val node = create_branch_node(2)
        expect(node.input_count()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(node.output_count()).to_equal(2)  # oracle: value fixed by the spec contract

    it "creates math node with two inputs and one output":
        # @req: REQ-ENGINE-VisualScripting-001
        step("Verify: creates math node with two inputs and one output")
        val node = create_math_node(3, "add")
        expect(node.input_count()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(node.output_count()).to_equal(1)  # oracle: value fixed by the spec contract

    it "creates print node with exec flow":
        # @req: REQ-ENGINE-VisualScripting-001
        step("Verify: creates print node with exec flow")
        val node = create_print_node(4)
        expect(node.input_count()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(node.output_count()).to_equal(1)  # oracle: value fixed by the spec contract
