"""
## Purpose and audience
Purpose: Prove that InstanceBatch.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

# Instancing spec — GPU instance batching

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.render.instancing.{InstanceData, InstanceBatch, InstanceRenderer}

describe "InstanceBatch":
    it "adds instances up to max":
        step("Verify: adds instances up to max")
        # @req: REQ-LIB-ENGINE-001
        var batch = InstanceBatch.new("tree", "bark_mat", 3)
        val i1 = InstanceData.new(1.0, 0.0, 0.0)
        val i2 = InstanceData.new(2.0, 0.0, 0.0)
        val i3 = InstanceData.new(3.0, 0.0, 0.0)
        batch.add_instance(i1)
        batch.add_instance(i2)
        batch.add_instance(i3)
        expect(batch.instance_count()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "rejects instance when full":
        step("Verify: rejects instance when full")
        var batch = InstanceBatch.new("tree", "bark_mat", 1)
        val i1 = InstanceData.new(1.0, 0.0, 0.0)
        val i2 = InstanceData.new(2.0, 0.0, 0.0)
        batch.add_instance(i1)
        val idx = batch.add_instance(i2)
        expect(idx).to_equal(-1)  # oracle: -1 — named expected value from the requirement
        expect(batch.instance_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "removes instance by index":
        step("Verify: removes instance by index")
        var batch = InstanceBatch.new("rock", "stone_mat", 10)
        val i1 = InstanceData.new(1.0, 0.0, 0.0)
        val i2 = InstanceData.new(2.0, 0.0, 0.0)
        batch.add_instance(i1)
        batch.add_instance(i2)
        batch.remove_instance(0)
        expect(batch.instance_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "toggles visibility":
        step("Verify: toggles visibility")
        var batch = InstanceBatch.new("bush", "leaf_mat", 10)
        expect(batch.is_visible()).to_equal(true)
        batch.set_visible(false)
        expect(batch.is_visible()).to_equal(false)

    it "clears all instances":
        step("Verify: clears all instances")
        var batch = InstanceBatch.new("grass", "grass_mat", 100)
        val i1 = InstanceData.new(1.0, 0.0, 0.0)
        val i2 = InstanceData.new(2.0, 0.0, 0.0)
        batch.add_instance(i1)
        batch.add_instance(i2)
        batch.clear()
        expect(batch.instance_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "InstanceRenderer":
    it "manages batches and counts total instances":
        step("Verify: manages batches and counts total instances")
        var renderer = InstanceRenderer.new()
        var b1 = InstanceBatch.new("tree", "bark", 100)
        var b2 = InstanceBatch.new("rock", "stone", 100)
        val t1 = InstanceData.new(0.0, 0.0, 0.0)
        val t2 = InstanceData.new(1.0, 0.0, 0.0)
        val r1 = InstanceData.new(5.0, 0.0, 0.0)
        b1.add_instance(t1)
        b1.add_instance(t2)
        b2.add_instance(r1)
        renderer.add_batch(b1)
        renderer.add_batch(b2)
        expect(renderer.batch_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(renderer.total_instance_count()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "excludes hidden batches from total count":
        step("Verify: excludes hidden batches from total count")
        var renderer = InstanceRenderer.new()
        var b1 = InstanceBatch.new("tree", "bark", 100)
        val i1 = InstanceData.new(0.0, 0.0, 0.0)
        val i2 = InstanceData.new(1.0, 0.0, 0.0)
        b1.add_instance(i1)
        b1.add_instance(i2)
        b1.set_visible(false)
        renderer.add_batch(b1)
        expect(renderer.total_instance_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "InstanceData":
    it "creates with default scale":
        step("Verify: creates with default scale")
        val inst = InstanceData.new(3.0, 4.0, 5.0)
        expect(inst.scale_x).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement
        expect(inst.scale_y).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement
        expect(inst.position_x).to_equal(3.0)  # oracle: 3.0 — named expected value from the requirement

    it "creates with custom scale":
        step("Verify: creates with custom scale")
        val inst = InstanceData.with_scale(1.0, 2.0, 3.0, 0.5, 0.5, 0.5)
        expect(inst.scale_x).to_equal(0.5)  # oracle: 0.5 — named expected value from the requirement
        expect(inst.position_z).to_equal(3.0)  # oracle: 3.0 — named expected value from the requirement
