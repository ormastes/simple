"""
## Purpose and audience
Purpose: Prove that TerrainData.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

# Terrain spec — heightmap terrain data

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.render.terrain.{TerrainData}

describe "TerrainData":
    it "creates flat terrain with correct cell count":
        step("Verify: creates flat terrain with correct cell count")
        # @req: REQ-LIB-ENGINE-001
        var td = TerrainData.new(8, 8, 100.0)
        expect(td.cell_count()).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(td.get_height(0, 0)).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
        expect(td.get_height(4, 4)).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement

    it "sets and gets individual cell heights":
        step("Verify: sets and gets individual cell heights")
        var td = TerrainData.new(4, 4, 50.0)
        td.set_height(2, 3, 25.5)
        expect(td.get_height(2, 3)).to_equal(25.5)  # oracle: 25.5 — named expected value from the requirement
        expect(td.get_height(0, 0)).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement

    it "clamps height to max":
        step("Verify: clamps height to max")
        var td = TerrainData.new(4, 4, 10.0)
        td.set_height(1, 1, 999.0)
        expect(td.get_height(1, 1)).to_equal(10.0)  # oracle: 10.0 — named expected value from the requirement

    it "clamps negative height to zero":
        step("Verify: clamps negative height to zero")
        var td = TerrainData.new(4, 4, 10.0)
        td.set_height(1, 1, -5.0)
        expect(td.get_height(1, 1)).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement

    it "ignores out-of-bounds set":
        step("Verify: ignores out-of-bounds set")
        var td = TerrainData.new(4, 4, 10.0)
        td.set_height(10, 10, 5.0)
        expect(td.get_height(10, 10)).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement

    it "raises area around center":
        step("Verify: raises area around center")
        var td = TerrainData.new(8, 8, 100.0)
        td.raise_area(4, 4, 1, 10.0)
        expect(td.get_height(4, 4)).to_be_greater_than(0.0)

    it "flattens area to target height":
        step("Verify: flattens area to target height")
        var td = TerrainData.new(8, 8, 100.0)
        td.set_height(3, 3, 50.0)
        td.set_height(4, 4, 20.0)
        td.flatten_area(4, 4, 2, 30.0)
        expect(td.get_height(4, 4)).to_equal(30.0)  # oracle: 30.0 — named expected value from the requirement

    it "manages texture layers":
        step("Verify: manages texture layers")
        var td = TerrainData.new(4, 4, 10.0)
        td.add_layer("grass", 10.0, 0.0, 0.5)
        td.add_layer("rock", 5.0, 0.8, 0.2)
        expect(td.layer_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement
