"""
## Purpose and audience
Purpose: Prove that Engine Units.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

# Engine Units — Domain-specific custom type tests
#
# Tests all 16 unit types from std.common.engine.units:
# Seconds, Angle, Volume, ZIndex, KeyCode, MouseButtonId,
# GamepadButtonId, Distance, ZoomLevel, TileCoord, PixelSize,
# TileIndex, FrameIndex, Speed, Tolerance, RGBA8

use std.spec.{describe, it, expect}
use std.common.engine.units.{Seconds, Angle, Volume, ZIndex, KeyCode, MouseButtonId, GamepadButtonId, Distance, ZoomLevel, TileCoord, PixelSize, TileIndex, FrameIndex, Speed, Tolerance, RGBA8}

describe "Engine Units":
    describe "Seconds":
        it "creates with value":
            step("Verify: creates with value")
            # @req: REQ-LIB-ENGINE-001
            val s = Seconds(value: 1.5)
            expect(s.value).to_equal(1.5)  # oracle: 1.5 — named expected value from the requirement

        it "converts to f64":
            step("Verify: converts to f64")
            val s = Seconds(value: 2.0)
            expect(s.to_f64()).to_equal(2.0)  # oracle: 2.0 — named expected value from the requirement

        it "adds two Seconds":
            step("Verify: adds two Seconds")
            val a = Seconds(value: 1.0)
            val b = Seconds(value: 2.5)
            val result = a.add(b)
            expect(result.value).to_equal(3.5)  # oracle: 3.5 — named expected value from the requirement

        it "subtracts two Seconds":
            step("Verify: subtracts two Seconds")
            val a = Seconds(value: 5.0)
            val b = Seconds(value: 1.5)
            val result = a.sub(b)
            expect(result.value).to_equal(3.5)  # oracle: 3.5 — named expected value from the requirement

    describe "Angle":
        it "creates with radians":
            step("Verify: creates with radians")
            val a = Angle(radians: 3.14)
            expect(a.radians).to_equal(3.14)  # oracle: 3.14 — named expected value from the requirement

        it "converts to radians":
            step("Verify: converts to radians")
            val a = Angle(radians: 1.0)
            expect(a.to_radians()).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement

        it "converts to degrees":
            step("Verify: converts to degrees")
            val a = Angle(radians: 1.0)
            val deg = a.to_degrees()
            expect(deg).to_be_greater_than(57.0)
            expect(deg).to_be_less_than(58.0)

        it "adds two Angles":
            step("Verify: adds two Angles")
            val a = Angle(radians: 1.0)
            val b = Angle(radians: 2.0)
            val result = a.add(b)
            expect(result.radians).to_equal(3.0)  # oracle: 3.0 — named expected value from the requirement

        it "creates zero angle":
            step("Verify: creates zero angle")
            val a = Angle.zero()
            expect(a.radians).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement

    describe "Volume":
        it "creates with value":
            step("Verify: creates with value")
            val v = Volume(value: 0.8)
            expect(v.value).to_equal(0.8)  # oracle: 0.8 — named expected value from the requirement

        it "converts to f64":
            step("Verify: converts to f64")
            val v = Volume(value: 0.5)
            expect(v.to_f64()).to_equal(0.5)  # oracle: 0.5 — named expected value from the requirement

        it "creates full volume":
            step("Verify: creates full volume")
            val v = Volume.full()
            expect(v.value).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement

        it "creates muted volume":
            step("Verify: creates muted volume")
            val v = Volume.mute_vol()
            expect(v.value).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement

    describe "ZIndex":
        it "creates with value":
            step("Verify: creates with value")
            val z = ZIndex(value: 5)
            expect(z.value).to_equal(5)  # oracle: 5 — named expected value from the requirement

        it "converts to i64":
            step("Verify: converts to i64")
            val z = ZIndex(value: 10)
            expect(z.to_i64()).to_equal(10)  # oracle: 10 — named expected value from the requirement

        it "creates zero ZIndex":
            step("Verify: creates zero ZIndex")
            val z = ZIndex.zero()
            expect(z.value).to_equal(0)  # oracle: 0 — named expected value from the requirement

    describe "KeyCode":
        it "creates with code":
            step("Verify: creates with code")
            val k = KeyCode(code: 65)
            expect(k.code).to_equal(65)  # oracle: 65 — named expected value from the requirement

        it "converts to i64":
            step("Verify: converts to i64")
            val k = KeyCode(code: 32)
            expect(k.to_i64()).to_equal(32)  # oracle: 32 — named expected value from the requirement

        it "compares equal KeyCodes":
            step("Verify: compares equal KeyCodes")
            val a = KeyCode(code: 65)
            val b = KeyCode(code: 65)
            expect(a.eq(b)).to_equal(true)

        it "compares different KeyCodes":
            step("Verify: compares different KeyCodes")
            val a = KeyCode(code: 65)
            val b = KeyCode(code: 66)
            expect(a.eq(b)).to_equal(false)

    describe "MouseButtonId":
        it "creates with code":
            step("Verify: creates with code")
            val m = MouseButtonId(code: 0)
            expect(m.code).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "converts to i64":
            step("Verify: converts to i64")
            val m = MouseButtonId(code: 1)
            expect(m.to_i64()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    describe "GamepadButtonId":
        it "creates with code":
            step("Verify: creates with code")
            val g = GamepadButtonId(code: 1)
            expect(g.code).to_equal(1)  # oracle: 1 — named expected value from the requirement

    describe "Distance":
        it "creates with value":
            step("Verify: creates with value")
            val d = Distance(value: 100.0)
            expect(d.value).to_equal(100.0)  # oracle: 100.0 — named expected value from the requirement

        it "converts to f64":
            step("Verify: converts to f64")
            val d = Distance(value: 42.5)
            expect(d.to_f64()).to_equal(42.5)  # oracle: 42.5 — named expected value from the requirement

    describe "ZoomLevel":
        it "creates with value":
            step("Verify: creates with value")
            val z = ZoomLevel(value: 2.0)
            expect(z.value).to_equal(2.0)  # oracle: 2.0 — named expected value from the requirement

        it "converts to f64":
            step("Verify: converts to f64")
            val z = ZoomLevel(value: 1.5)
            expect(z.to_f64()).to_equal(1.5)  # oracle: 1.5 — named expected value from the requirement

        it "creates default zoom":
            step("Verify: creates default zoom")
            val z = ZoomLevel.default_zoom()
            expect(z.value).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement

    describe "TileCoord":
        it "creates with col and row":
            step("Verify: creates with col and row")
            val t = TileCoord(col: 3, row: 7)
            expect(t.col).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(t.row).to_equal(7)  # oracle: 7 — named expected value from the requirement

    describe "PixelSize":
        it "creates with width and height":
            step("Verify: creates with width and height")
            val p = PixelSize(width: 1920, height: 1080)
            expect(p.width).to_equal(1920)  # oracle: 1920 — named expected value from the requirement
            expect(p.height).to_equal(1080)  # oracle: 1080 — named expected value from the requirement

    describe "TileIndex":
        it "creates with value":
            step("Verify: creates with value")
            val t = TileIndex(value: 42)
            expect(t.value).to_equal(42)  # oracle: 42 — named expected value from the requirement

        it "converts to i64":
            step("Verify: converts to i64")
            val t = TileIndex(value: 7)
            expect(t.to_i64()).to_equal(7)  # oracle: 7 — named expected value from the requirement

        it "creates empty TileIndex":
            step("Verify: creates empty TileIndex")
            val t = TileIndex.empty()
            expect(t.value).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    describe "FrameIndex":
        it "creates with value":
            step("Verify: creates with value")
            val f = FrameIndex(value: 10)
            expect(f.value).to_equal(10)  # oracle: 10 — named expected value from the requirement

        it "converts to i64":
            step("Verify: converts to i64")
            val f = FrameIndex(value: 99)
            expect(f.to_i64()).to_equal(99)  # oracle: 99 — named expected value from the requirement

    describe "Speed":
        it "creates with value":
            step("Verify: creates with value")
            val s = Speed(value: 5.5)
            expect(s.value).to_equal(5.5)  # oracle: 5.5 — named expected value from the requirement

        it "converts to f64":
            step("Verify: converts to f64")
            val s = Speed(value: 3.0)
            expect(s.to_f64()).to_equal(3.0)  # oracle: 3.0 — named expected value from the requirement

    describe "Tolerance":
        it "creates with value":
            step("Verify: creates with value")
            val t = Tolerance(value: 0.001)
            expect(t.value).to_equal(0.001)  # oracle: 0.001 — named expected value from the requirement

        it "converts to f64":
            step("Verify: converts to f64")
            val t = Tolerance(value: 0.01)
            expect(t.to_f64()).to_equal(0.01)  # oracle: 0.01 — named expected value from the requirement

    describe "RGBA8":
        it "creates with components":
            step("Verify: creates with components")
            val c = RGBA8(r: 255, g: 128, b: 0, a: 255)
            expect(c.r).to_equal(255)  # oracle: 255 — named expected value from the requirement
            expect(c.g).to_equal(128)  # oracle: 128 — named expected value from the requirement
            expect(c.b).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(c.a).to_equal(255)  # oracle: 255 — named expected value from the requirement

        it "creates black color":
            step("Verify: creates black color")
            val c = RGBA8(r: 0, g: 0, b: 0, a: 255)
            expect(c.r).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(c.g).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(c.b).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(c.a).to_equal(255)  # oracle: 255 — named expected value from the requirement

        it "creates transparent color":
            step("Verify: creates transparent color")
            val c = RGBA8(r: 0, g: 0, b: 0, a: 0)
            expect(c.a).to_equal(0)  # oracle: 0 — named expected value from the requirement
