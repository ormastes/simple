"""
## Purpose and audience
Purpose: Prove that FontHandle.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

"""
Engine Font FFI Types Tests

Tests FontHandle, GlyphMetrics, and GlyphBitmap struct construction and methods.
Does not test FFI extern functions (those require runtime).
"""

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.font_ffi.{FontHandle, GlyphMetrics, GlyphBitmap}

describe "FontHandle":
    it "constructs with handle and path":
        step("Verify: constructs with handle and path")
        # @req: REQ-LIB-ENGINE-001
        val font = FontHandle(handle: 42, path: "/fonts/test.ttf")
        expect(font.handle).to_equal(42)  # oracle: 42 — named expected value from the requirement
        expect(font.path).to_equal("/fonts/test.ttf")

    it "is_valid returns true for positive handle":
        step("Verify: is_valid returns true for positive handle")
        val font = FontHandle(handle: 1, path: "test.ttf")
        expect(font.is_valid()).to_equal(true)

    it "is_valid returns false for zero handle":
        step("Verify: is_valid returns false for zero handle")
        val font = FontHandle(handle: 0, path: "test.ttf")
        expect(font.is_valid()).to_equal(false)

    it "is_valid returns false for negative handle":
        step("Verify: is_valid returns false for negative handle")
        val font = FontHandle(handle: -1, path: "test.ttf")
        expect(font.is_valid()).to_equal(false)

describe "GlyphMetrics":
    it "constructs with all fields":
        step("Verify: constructs with all fields")
        val metrics = GlyphMetrics(width: 12, height: 16, advance: 14, codepoint: 65)
        expect(metrics.width).to_equal(12)  # oracle: 12 — named expected value from the requirement
        expect(metrics.height).to_equal(16)  # oracle: 16 — named expected value from the requirement
        expect(metrics.advance).to_equal(14)  # oracle: 14 — named expected value from the requirement
        expect(metrics.codepoint).to_equal(65)  # oracle: 65 — named expected value from the requirement

    it "stores zero metrics":
        step("Verify: stores zero metrics")
        val metrics = GlyphMetrics(width: 0, height: 0, advance: 0, codepoint: 32)
        expect(metrics.width).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(metrics.height).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(metrics.codepoint).to_equal(32)  # oracle: 32 — named expected value from the requirement

describe "GlyphBitmap":
    it "constructs with dimensions, bitmap handle, and metrics":
        step("Verify: constructs with dimensions, bitmap handle, and metrics")
        val metrics = GlyphMetrics(width: 8, height: 10, advance: 9, codepoint: 65)
        val bitmap = GlyphBitmap(bitmap_handle: 99, width: 8, height: 10, metrics: metrics)
        expect(bitmap.bitmap_handle).to_equal(99)  # oracle: 99 — named expected value from the requirement
        expect(bitmap.width).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(bitmap.height).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(bitmap.metrics.codepoint).to_equal(65)  # oracle: 65 — named expected value from the requirement

    it "is_valid returns true for positive handle and dimensions":
        step("Verify: is_valid returns true for positive handle and dimensions")
        val metrics = GlyphMetrics(width: 8, height: 10, advance: 9, codepoint: 65)
        val bitmap = GlyphBitmap(bitmap_handle: 99, width: 8, height: 10, metrics: metrics)
        expect(bitmap.is_valid()).to_equal(true)

    it "is_valid returns false for zero width":
        step("Verify: is_valid returns false for zero width")
        val metrics = GlyphMetrics(width: 0, height: 10, advance: 0, codepoint: 32)
        val bitmap = GlyphBitmap(bitmap_handle: 99, width: 0, height: 10, metrics: metrics)
        expect(bitmap.is_valid()).to_equal(false)

    it "is_valid returns false for zero height":
        step("Verify: is_valid returns false for zero height")
        val metrics = GlyphMetrics(width: 8, height: 0, advance: 9, codepoint: 65)
        val bitmap = GlyphBitmap(bitmap_handle: 99, width: 8, height: 0, metrics: metrics)
        expect(bitmap.is_valid()).to_equal(false)

    it "is_valid returns false for both dimensions zero":
        step("Verify: is_valid returns false for both dimensions zero")
        val metrics = GlyphMetrics(width: 0, height: 0, advance: 0, codepoint: 0)
        val bitmap = GlyphBitmap(bitmap_handle: 99, width: 0, height: 0, metrics: metrics)
        expect(bitmap.is_valid()).to_equal(false)

    it "is_valid returns false for non-positive bitmap handle":
        step("Verify: is_valid returns false for non-positive bitmap handle")
        val metrics = GlyphMetrics(width: 8, height: 10, advance: 9, codepoint: 65)
        val bitmap = GlyphBitmap(bitmap_handle: -1, width: 8, height: 10, metrics: metrics)
        expect(bitmap.is_valid()).to_equal(false)
