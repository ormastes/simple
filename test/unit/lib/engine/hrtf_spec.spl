"""
## Purpose and audience
Purpose: Prove that HRTFData.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

# HRTF spec — head-related transfer function spatialization

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.audio.hrtf.{HRTFData, HRTFProcessor}

describe "HRTFData":
    it "starts with zero entries":
        step("Verify: starts with zero entries")
        # @req: REQ-LIB-ENGINE-001
        val data = HRTFData.new(44100)
        expect(data.entry_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "adds entries":
        step("Verify: adds entries")
        var data = HRTFData.new(48000)
        data.add_entry(0.0, 0.0, 5, 5, 1.0, 1.0)
        data.add_entry(90.0, 0.0, 10, 3, 0.8, 0.5)
        expect(data.entry_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "finds nearest entry by azimuth and elevation":
        step("Verify: finds nearest entry by azimuth and elevation")
        var data = HRTFData.new(44100)
        data.add_entry(0.0, 0.0, 5, 5, 1.0, 1.0)
        data.add_entry(90.0, 0.0, 10, 3, 0.8, 0.5)
        data.add_entry(180.0, 0.0, 8, 8, 0.6, 0.6)
        val entry = data.find_nearest(85.0, 0.0)
        if val Some(e) = entry:
            expect(e.azimuth).to_equal(90.0)  # oracle: 90.0 — named expected value from the requirement

    it "finds nearest with elevation":
        step("Verify: finds nearest with elevation")
        var data = HRTFData.new(44100)
        data.add_entry(0.0, 0.0, 5, 5, 1.0, 1.0)
        data.add_entry(0.0, 45.0, 7, 7, 0.9, 0.9)
        data.add_entry(0.0, 90.0, 9, 9, 0.7, 0.7)
        val entry = data.find_nearest(0.0, 40.0)
        if val Some(e) = entry:
            expect(e.elevation).to_equal(45.0)  # oracle: 45.0 — named expected value from the requirement

describe "HRTFProcessor":
    it "starts with no sources":
        step("Verify: starts with no sources")
        val data = HRTFData.new(44100)
        val proc = HRTFProcessor.new(data)
        expect(proc.source_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "adds and tracks sources":
        step("Verify: adds and tracks sources")
        val data = HRTFData.new(44100)
        var proc = HRTFProcessor.new(data)
        proc.add_source(1, 5.0, 0.0, 3.0)
        proc.add_source(2, -3.0, 1.0, 0.0)
        expect(proc.source_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "updates source position":
        step("Verify: updates source position")
        val data = HRTFData.new(44100)
        var proc = HRTFProcessor.new(data)
        proc.add_source(1, 0.0, 0.0, 0.0)
        proc.update_source_position(1, 10.0, 5.0, 2.0)
        val src = proc.get_source(1)
        if val Some(s) = src:
            expect(s.position_x).to_equal(10.0)  # oracle: 10.0 — named expected value from the requirement
            expect(s.position_y).to_equal(5.0)  # oracle: 5.0 — named expected value from the requirement

    it "sets listener position":
        step("Verify: sets listener position")
        val data = HRTFData.new(44100)
        var proc = HRTFProcessor.new(data)
        proc.set_listener_position(1.0, 2.0, 3.0)
        expect(proc.source_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "returns nil for unknown source":
        step("Verify: returns nil for unknown source")
        val data = HRTFData.new(44100)
        val proc = HRTFProcessor.new(data)
        val src = proc.get_source(999)
        expect(proc.source_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
