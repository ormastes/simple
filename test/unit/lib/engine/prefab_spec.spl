"""
## Purpose and audience
Engine Prefab System — PrefabTemplate + PrefabStore Tests

Tests prefab template creation, properties, children, registration,
lookup, and instantiation into a NodeStore.
"""

use std.spec.{describe, it, expect}
use std.common.engine.ids.{NodeId}
use std.nogc_sync_mut.engine.scene.node.{NodeStore}
use std.nogc_sync_mut.engine.scene.prefab.{
    PrefabProperty, PrefabTemplate, PrefabStore
}

# @req: REQ-ENGINE-Prefab-001
describe "PrefabTemplate":
    it "creates with type and name":
        # @req: REQ-ENGINE-Prefab-001
        step("Verify: creates with type and name")
        var tmpl = PrefabTemplate.new("Sprite", "player")
        expect(tmpl.type_name).to_equal("Sprite")
        expect(tmpl.name).to_equal("player")
        expect(tmpl.properties.len()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(tmpl.child_count()).to_equal(0)  # oracle: value fixed by the spec contract

    it "sets and gets properties":
        # @req: REQ-ENGINE-Prefab-001
        step("Verify: sets and gets properties")
        var tmpl = PrefabTemplate.new("Sprite", "player")
        tmpl.set_property("speed", "10.0")
        tmpl.set_property("health", "100")
        expect(tmpl.properties.len()).to_equal(2)  # oracle: value fixed by the spec contract

    it "updates existing property":
        # @req: REQ-ENGINE-Prefab-001
        step("Verify: updates existing property")
        var tmpl = PrefabTemplate.new("Sprite", "player")
        tmpl.set_property("speed", "10.0")
        tmpl.set_property("speed", "20.0")
        expect(tmpl.properties.len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "adds child templates":
        # @req: REQ-ENGINE-Prefab-001
        step("Verify: adds child templates")
        var tmpl = PrefabTemplate.new("Node", "root")
        val child = PrefabTemplate.new("Sprite", "arm")
        tmpl.add_child(child)
        expect(tmpl.child_count()).to_equal(1)  # oracle: value fixed by the spec contract

describe "PrefabStore":
    it "registers and retrieves prefabs":
        # @req: REQ-ENGINE-Prefab-001
        step("Verify: registers and retrieves prefabs")
        var pstore = PrefabStore.new()
        val tmpl = PrefabTemplate.new("Sprite", "player")
        val idx = pstore.register(tmpl)
        expect(idx).to_equal(0)  # oracle: value fixed by the spec contract
        expect(pstore.size()).to_equal(1)  # oracle: value fixed by the spec contract

    it "finds prefab by name":
        # @req: REQ-ENGINE-Prefab-001
        step("Verify: finds prefab by name")
        var pstore = PrefabStore.new()
        pstore.register(PrefabTemplate.new("Sprite", "player"))
        pstore.register(PrefabTemplate.new("Light", "sun"))
        val found = pstore.find_by_name("sun")
        if val Some(p) = found:
            expect(p.name).to_equal("sun")
            expect(p.type_name).to_equal("Light")

    it "finds prefabs by type":
        # @req: REQ-ENGINE-Prefab-001
        step("Verify: finds prefabs by type")
        var pstore = PrefabStore.new()
        pstore.register(PrefabTemplate.new("Sprite", "a"))
        pstore.register(PrefabTemplate.new("Light", "b"))
        pstore.register(PrefabTemplate.new("Sprite", "c"))
        val sprites = pstore.find_by_type("Sprite")
        expect(sprites.len()).to_equal(2)  # oracle: value fixed by the spec contract

    it "returns nil for invalid index":
        # @req: REQ-ENGINE-Prefab-001
        step("Verify: returns nil for invalid index")
        var pstore = PrefabStore.new()
        val result = pstore.get(99)
        expect(result).to_equal(nil)

    it "instantiates a simple prefab":
        # @req: REQ-ENGINE-Prefab-001
        step("Verify: instantiates a simple prefab")
        var pstore = PrefabStore.new()
        val tmpl = PrefabTemplate.new("Sprite", "hero")
        val idx = pstore.register(tmpl)
        var node_store = NodeStore.new()
        val node_id = pstore.instantiate(idx, node_store)
        expect(node_id.is_valid()).to_equal(true)
        expect(node_store.node_count()).to_equal(1)  # oracle: value fixed by the spec contract

    it "instantiates prefab with children":
        # @req: REQ-ENGINE-Prefab-001
        step("Verify: instantiates prefab with children")
        var pstore = PrefabStore.new()
        var tmpl = PrefabTemplate.new("Node", "robot")
        tmpl.add_child(PrefabTemplate.new("Sprite", "arm_l"))
        tmpl.add_child(PrefabTemplate.new("Sprite", "arm_r"))
        val idx = pstore.register(tmpl)
        var node_store = NodeStore.new()
        val root_id = pstore.instantiate(idx, node_store)
        expect(root_id.is_valid()).to_equal(true)
        expect(node_store.node_count()).to_equal(3)  # oracle: value fixed by the spec contract

    it "returns invalid id for bad index":
        # @req: REQ-ENGINE-Prefab-001
        step("Verify: returns invalid id for bad index")
        var pstore = PrefabStore.new()
        var node_store = NodeStore.new()
        val bad_id = pstore.instantiate(99, node_store)
        expect(bad_id.is_valid()).to_equal(false)
