"""
## Purpose and audience
Purpose: Prove that LODLevel.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

# LOD System Tests

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.render.lod.{LODLevel, LODGroup, LODManager}

describe "LODLevel":
    it "creates a level with correct fields":
        step("Verify: creates a level with correct fields")
        # @req: REQ-LIB-ENGINE-001
        val lod = LODLevel.new(0, 50.0, "high")
        expect(lod.level).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(lod.max_distance).to_equal(50.0)  # oracle: 50.0 — named expected value from the requirement
        expect(lod.detail_name).to_equal("high")

describe "LODGroup":
    it "starts empty":
        step("Verify: starts empty")
        val group = LODGroup.new("tree")
        expect(group.level_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(group.name).to_equal("tree")

    it "adds levels sorted by distance":
        step("Verify: adds levels sorted by distance")
        var group = LODGroup.new("tree")
        group.add_level(2, 200.0, "low")
        group.add_level(0, 50.0, "high")
        group.add_level(1, 100.0, "medium")
        expect(group.level_count()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(group.levels[0].detail_name).to_equal("high")
        expect(group.levels[1].detail_name).to_equal("medium")
        expect(group.levels[2].detail_name).to_equal("low")

    it "selects correct level for close distance":
        step("Verify: selects correct level for close distance")
        var group = LODGroup.new("building")
        group.add_level(0, 50.0, "high")
        group.add_level(1, 100.0, "medium")
        group.add_level(2, 200.0, "low")
        expect(group.select_level(25.0)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "selects correct level for mid distance":
        step("Verify: selects correct level for mid distance")
        var group = LODGroup.new("building")
        group.add_level(0, 50.0, "high")
        group.add_level(1, 100.0, "medium")
        group.add_level(2, 200.0, "low")
        expect(group.select_level(75.0)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "selects last level for far distance":
        step("Verify: selects last level for far distance")
        var group = LODGroup.new("building")
        group.add_level(0, 50.0, "high")
        group.add_level(1, 100.0, "medium")
        group.add_level(2, 200.0, "low")
        expect(group.select_level(999.0)).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "returns detail name for valid level":
        step("Verify: returns detail name for valid level")
        var group = LODGroup.new("rock")
        group.add_level(0, 30.0, "detailed")
        group.add_level(1, 80.0, "simple")
        expect(group.get_detail_name(0)).to_equal("detailed")
        expect(group.get_detail_name(1)).to_equal("simple")

    it "returns unknown for invalid level":
        step("Verify: returns unknown for invalid level")
        var group = LODGroup.new("rock")
        group.add_level(0, 30.0, "detailed")
        expect(group.get_detail_name(99)).to_equal("unknown")

describe "LODManager":
    it "starts with zero groups":
        step("Verify: starts with zero groups")
        val mgr = LODManager.new()
        expect(mgr.group_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "adds a group and returns its index":
        step("Verify: adds a group and returns its index")
        var mgr = LODManager.new()
        var grp = LODGroup.new("tree")
        grp.add_level(0, 50.0, "high")
        val idx = mgr.add_group(grp)
        expect(idx).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(mgr.group_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "selects LOD for a group by distance":
        step("Verify: selects LOD for a group by distance")
        var mgr = LODManager.new()
        var grp = LODGroup.new("rock")
        grp.add_level(0, 40.0, "high")
        grp.add_level(1, 120.0, "low")
        val idx = mgr.add_group(grp)
        expect(mgr.select_for_distance(idx, 10.0)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(mgr.select_for_distance(idx, 80.0)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "returns 0 for invalid group index":
        step("Verify: returns 0 for invalid group index")
        val mgr = LODManager.new()
        expect(mgr.select_for_distance(99, 10.0)).to_equal(0)  # oracle: 0 — named expected value from the requirement
