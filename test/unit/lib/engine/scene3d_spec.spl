"""
## Purpose and audience
Purpose: Prove that NodeStore3D.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

"""
Engine Scene3D — NodeStore3D Tests

Tests 3D node creation, parent-child relationships,
and world transform computation.
"""

use std.spec.{describe, it, expect}
use std.common.engine.math3d.{Vec3, Quaternion, Transform3D}
use std.nogc_sync_mut.engine.scene.node3d.{NodeStore3D, Node3D, get_world_transform_3d, find_by_name_3d}

describe "NodeStore3D":
    describe "creation":
        it "starts with zero nodes":
            step("Verify: starts with zero nodes")
            # @req: REQ-LIB-ENGINE-001
            val store = NodeStore3D.create()
            expect(store.node_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "creates a node and increments count":
            step("Verify: creates a node and increments count")
            var store = NodeStore3D.create()
            val id = store.create_node("test")
            expect(store.node_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(id.is_valid()).to_equal(true)

        it "creates multiple nodes":
            step("Verify: creates multiple nodes")
            var store = NodeStore3D.create()
            val id1 = store.create_node("node1")
            val id2 = store.create_node("node2")
            val id3 = store.create_node("node3")
            expect(store.node_count()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    describe "get_node":
        it "retrieves created node by id":
            step("Verify: retrieves created node by id")
            var store = NodeStore3D.create()
            val id = store.create_node("hero")
            val maybe = store.get_node(id)
            expect(maybe != nil).to_equal(true)

        it "node has correct name":
            step("Verify: node has correct name")
            var store = NodeStore3D.create()
            val id = store.create_node("camera")
            val maybe = store.get_node(id)
            if val Some(node) = maybe:
                expect(node.name).to_equal("camera")

    describe "parent-child":
        it "sets parent correctly":
            step("Verify: sets parent correctly")
            var store = NodeStore3D.create()
            val parent_id = store.create_node("parent")
            val child_id = store.create_node("child")
            val result = store.set_parent(child_id, parent_id)
            expect(result).to_equal(true)

            val maybe_child = store.get_node(child_id)
            if val Some(child) = maybe_child:
                expect(child.parent.is_valid()).to_equal(true)

            val maybe_parent = store.get_node(parent_id)
            if val Some(parent) = maybe_parent:
                expect(parent.children.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    describe "position":
        it "sets position":
            step("Verify: sets position")
            var store = NodeStore3D.create()
            val id = store.create_node("obj")
            val pos = Vec3(x: 5.0, y: 10.0, z: 15.0)
            store.set_position(id, pos)
            val maybe = store.get_node(id)
            if val Some(node) = maybe:
                expect(node.position.x).to_equal(5.0)  # oracle: 5.0 — named expected value from the requirement
                expect(node.position.y).to_equal(10.0)  # oracle: 10.0 — named expected value from the requirement
                expect(node.position.z).to_equal(15.0)  # oracle: 15.0 — named expected value from the requirement

    describe "world transform":
        it "computes world transform for child":
            step("Verify: computes world transform for child")
            var store = NodeStore3D.create()
            val parent_id = store.create_node("parent")
            val child_id = store.create_node("child")
            store.set_position(parent_id, Vec3(x: 100.0, y: 0.0, z: 0.0))
            store.set_position(child_id, Vec3(x: 10.0, y: 0.0, z: 0.0))
            store.set_parent(child_id, parent_id)

            val world = get_world_transform_3d(store, child_id)
            val p = world.transform_point(Vec3.zero())
            val px_i = p.x * 100.0
            expect(px_i).to_be_greater_than(10999.0)
            expect(px_i).to_be_less_than(11001.0)

    describe "find_by_name":
        it "finds node by name":
            step("Verify: finds node by name")
            var store = NodeStore3D.create()
            val id = store.create_node("target")
            val found = find_by_name_3d(store, "target")
            expect(found != nil).to_equal(true)

        it "returns nil for missing name":
            step("Verify: returns nil for missing name")
            var store = NodeStore3D.create()
            store.create_node("exists")
            val found = find_by_name_3d(store, "missing")
            expect(found).to_equal(nil)
