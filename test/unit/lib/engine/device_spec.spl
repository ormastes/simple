"""
## Purpose and audience
Purpose: Prove that GPU Device.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

# GPU Device — Backend enum and Gpu struct tests
#
# Tests GpuBackend enum variants, Gpu struct construction,
# constructor functions, and preferred_graphics_backend.

use std.spec.{describe, it, expect}
use std.common.gpu.device.{GpuBackend, Gpu, gpu_cuda, gpu_vulkan, gpu_rocm, gpu_oneapi, gpu_metal, gpu_none, preferred_graphics_backend}

describe "GPU Device":
    describe "GpuBackend":
        it "converts Cuda to text":
            step("Verify: converts Cuda to text")
            # @req: REQ-LIB-ENGINE-001
            val b = GpuBackend.Cuda
            expect(b.to_text()).to_equal("CUDA")

        it "converts Vulkan to text":
            step("Verify: converts Vulkan to text")
            val b = GpuBackend.Vulkan
            expect(b.to_text()).to_equal("Vulkan")

        it "converts Rocm to text":
            step("Verify: converts Rocm to text")
            val b = GpuBackend.Rocm
            expect(b.to_text()).to_equal("ROCm")

        it "converts OneApi to text":
            step("Verify: converts OneApi to text")
            val b = GpuBackend.OneApi
            expect(b.to_text()).to_equal("oneAPI")

        it "converts Metal to text":
            step("Verify: converts Metal to text")
            val b = GpuBackend.Metal
            expect(b.to_text()).to_equal("Metal")

        it "converts None_ to text":
            step("Verify: converts None_ to text")
            val b = GpuBackend.None_
            expect(b.to_text()).to_equal("None")

    describe "Gpu struct":
        it "creates a valid Gpu":
            step("Verify: creates a valid Gpu")
            val g = Gpu(backend: GpuBackend.Cuda, device_id: 0, is_initialized: true)
            expect(g.is_valid()).to_equal(true)

        it "creates an uninitialized Gpu":
            step("Verify: creates an uninitialized Gpu")
            val g = Gpu(backend: GpuBackend.Cuda, device_id: 0, is_initialized: false)
            expect(g.is_valid()).to_equal(false)

        it "sync returns true":
            step("Verify: sync returns true")
            val g = Gpu(backend: GpuBackend.Vulkan, device_id: 0, is_initialized: true)
            expect(g.sync()).to_equal(true)

    describe "Constructor functions":
        it "gpu_cuda creates CUDA device":
            step("Verify: gpu_cuda creates CUDA device")
            val g = gpu_cuda(0)
            expect(g.backend.to_text()).to_equal("CUDA")
            expect(g.device_id).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(g.is_valid()).to_equal(true)

        it "gpu_vulkan creates Vulkan device":
            step("Verify: gpu_vulkan creates Vulkan device")
            val g = gpu_vulkan(0)
            expect(g.backend.to_text()).to_equal("Vulkan")
            expect(g.is_valid()).to_equal(true)

        it "gpu_rocm creates ROCm device":
            step("Verify: gpu_rocm creates ROCm device")
            val g = gpu_rocm(0)
            expect(g.backend.to_text()).to_equal("ROCm")
            expect(g.is_valid()).to_equal(true)

        it "gpu_oneapi creates oneAPI device":
            step("Verify: gpu_oneapi creates oneAPI device")
            val g = gpu_oneapi(0)
            expect(g.backend.to_text()).to_equal("oneAPI")
            expect(g.is_valid()).to_equal(true)

        it "gpu_metal creates Metal device":
            step("Verify: gpu_metal creates Metal device")
            val g = gpu_metal(0)
            expect(g.backend.to_text()).to_equal("Metal")
            expect(g.is_valid()).to_equal(true)

        it "gpu_none creates CPU fallback":
            step("Verify: gpu_none creates CPU fallback")
            val g = gpu_none()
            expect(g.backend.to_text()).to_equal("None")
            expect(g.device_id).to_equal(-1)  # oracle: -1 — named expected value from the requirement
            expect(g.is_valid()).to_equal(true)

        it "gpu_cuda with different device ids":
            step("Verify: gpu_cuda with different device ids")
            val g0 = gpu_cuda(0)
            val g1 = gpu_cuda(1)
            expect(g0.device_id).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(g1.device_id).to_equal(1)  # oracle: 1 — named expected value from the requirement

    describe "preferred_graphics_backend":
        it "returns Vulkan":
            step("Verify: returns Vulkan")
            val backend = preferred_graphics_backend()
            expect(backend.to_text()).to_equal("Vulkan")
