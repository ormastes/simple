"""
## Purpose and audience
Acceptance oracles for the cascaded shadow map system: `ShadowMapConfig`
quality presets, `CascadedShadowMap` cascade construction and lookup, and
`ShadowSystem` enable/registry state (REQ-LIB-ENGINE-001).
Audience: engine render engineers changing shadow presets or cascade
bookkeeping, who need one spec that turns RED when a default, split distance,
or registry count regresses.
## Operator workflow
bin/simple test test/01_unit/lib/engine/shadow_map_spec.spl
Each scenario prints a verdict line; a red scenario names the shadow map
surface that regressed (preset, cascade, or system registry).
## Compatibility and limitations
Covers the pinned in-memory config/cascade/system contract only; no GPU
depth-pass execution is exercised here. Fixture cascades are local to this
spec.
## Verification guidance and troubleshooting
Captures record the asserted config fields, split distances, and registry
counts per scenario. A red "returns None" scenario means cascade index
validation regressed; a red total-resolution scenario means per-cascade
resolution halving changed.
"""
# Lifecycle: doc/01_research/domain/engine2d_four_backend_capture.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/ui/engine_2d.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: shadow-map-system
# @req: REQ-LIB-ENGINE-001

use std.spec.step
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.render.shadow_map.{ShadowMapConfig, CascadeLevel, CascadedShadowMap, ShadowSystem}

describe "ShadowMapConfig":
    it "exposes the balanced default quality preset":
        # @req: REQ-LIB-ENGINE-001
        step("Build the default shadow map configuration")
        val cfg = ShadowMapConfig.default_config()
        # @capture(statistics): default preset resolution, biases, and soft-shadow flag
        step("Verify the documented default resolution, biases, and soft shadows")
        expect(cfg.resolution).to_equal(1024)  # oracle: 1024 — documented default shadow atlas width
        expect(cfg.bias).to_equal(0.005)  # oracle: 0.005 — documented default depth bias
        expect(cfg.normal_bias).to_equal(0.02)  # oracle: 0.02 — documented default normal offset bias
        expect(cfg.soft_shadows).to_equal(true)

    it "exposes the high quality preset with tighter bias and a larger atlas":
        # @req: REQ-LIB-ENGINE-001
        step("Build the high quality shadow map configuration")
        val cfg = ShadowMapConfig.high_quality()
        # @capture(statistics): high-quality preset resolution, biases, and soft-shadow flag
        step("Verify the documented high-quality resolution and tightened biases")
        expect(cfg.resolution).to_equal(2048)  # oracle: 2048 — documented high-quality atlas width
        expect(cfg.bias).to_equal(0.003)  # oracle: 0.003 — documented high-quality depth bias
        expect(cfg.normal_bias).to_equal(0.01)  # oracle: 0.01 — documented high-quality normal offset bias
        expect(cfg.soft_shadows).to_equal(true)

describe "CascadedShadowMap":
    it "constructs one cascade map per requested cascade count":
        # @req: REQ-LIB-ENGINE-001
        step("Build a four-cascade shadow map from the default config")
        val cfg = ShadowMapConfig.default_config()
        val csm = CascadedShadowMap.new(4, cfg)
        # @capture(statistics): cascade count and cascade list length
        step("Verify the reported count matches the allocated cascade list")
        expect(csm.cascade_count).to_equal(4)  # oracle: 4 — cascades requested at construction
        expect(csm.cascades.len()).to_equal(4)  # oracle: 4 — one map per requested cascade

    it "generates increasing split distances across cascades":
        # @req: REQ-LIB-ENGINE-001
        step("Build a three-cascade shadow map and read adjacent split distances")
        val cfg = ShadowMapConfig.default_config()
        val csm = CascadedShadowMap.new(3, cfg)
        val c0 = csm.cascades[0]
        val c1 = csm.cascades[1]
        val c2 = csm.cascades[2]
        # @capture(statistics): ordered cascade split distances
        step("Verify each cascade covers strictly farther depth than the previous one")
        expect(c0.split_distance).to_be_less_than(c1.split_distance)
        expect(c1.split_distance).to_be_less_than(c2.split_distance)

    it "returns the requested cascade for a valid index":
        # @req: REQ-LIB-ENGINE-001
        step("Look up cascade zero of a two-cascade shadow map")
        val cfg = ShadowMapConfig.default_config()
        val csm = CascadedShadowMap.new(2, cfg)
        val maybe = csm.get_cascade(0)
        var resolved = false
        if val Some(level) = maybe:
            resolved = true
            # @capture(statistics): resolved cascade split distance for index 0
            step("Verify the resolved cascade starts at a positive split distance")
            expect(level.split_distance).to_be_greater_than(0.0)
        step("Verify the lookup resolved a cascade")
        expect(resolved).to_equal(true)

    it "returns None for an invalid cascade index":
        # @req: REQ-LIB-ENGINE-001
        step("Look up cascade five of a two-cascade shadow map")
        val cfg = ShadowMapConfig.default_config()
        val csm = CascadedShadowMap.new(2, cfg)
        val maybe = csm.get_cascade(5)
        var resolved = false
        if val Some(level) = maybe:
            resolved = true
        # @capture(statistics): out-of-range lookup resolves to no cascade
        step("Verify the out-of-range index resolves to no cascade")
        expect(resolved).to_equal(false)

    it "computes total resolution by halving each successive cascade atlas":
        # @req: REQ-LIB-ENGINE-001
        step("Build a two-cascade shadow map from the 1024-wide default config")
        val cfg = ShadowMapConfig.default_config()
        val csm = CascadedShadowMap.new(2, cfg)
        val total = csm.total_resolution()
        # @capture(statistics): summed cascade atlas widths
        step("Verify the total sums the 1024 atlas plus its 512 half-resolution successor")
        expect(total).to_equal(1536)  # oracle: 1536 — 1024 first cascade + 512 halved second cascade

describe "ShadowSystem":
    it "starts enabled with an empty shadow map registry":
        # @req: REQ-LIB-ENGINE-001
        step("Construct the shadow system from the default config")
        val cfg = ShadowMapConfig.default_config()
        val sys = ShadowSystem.new(cfg)
        # @capture(statistics): initial enabled flag and registry count
        step("Verify the system boots enabled with no registered shadow maps")
        expect(sys.is_enabled()).to_equal(true)
        expect(sys.shadow_map_count()).to_equal(0)  # oracle: 0 — no maps registered at construction

    it "registers each added shadow map under a sequential index":
        # @req: REQ-LIB-ENGINE-001
        step("Add one three-cascade map to a fresh shadow system")
        val cfg = ShadowMapConfig.default_config()
        var sys = ShadowSystem.new(cfg)
        val csm = CascadedShadowMap.new(3, cfg)
        val idx = sys.add_shadow_map(csm)
        # @capture(statistics): assigned index and registry count after one add
        step("Verify the first map gets index zero and the count rises to one")
        expect(idx).to_equal(0)  # oracle: 0 — first registered map takes slot zero
        expect(sys.shadow_map_count()).to_equal(1)  # oracle: 1 — one map registered

    it "toggles enabled state without losing registered maps":
        # @req: REQ-LIB-ENGINE-001
        step("Disable and re-enable the shadow system")
        val cfg = ShadowMapConfig.default_config()
        var sys = ShadowSystem.new(cfg)
        sys.set_enabled(false)
        expect(sys.is_enabled()).to_equal(false)
        sys.set_enabled(true)
        # @capture(statistics): enabled flag after a disable/enable round trip
        step("Verify the system is enabled again after the round trip")
        expect(sys.is_enabled()).to_equal(true)

    it "clears all shadow maps from the registry":
        # @req: REQ-LIB-ENGINE-001
        step("Register a two-cascade and a four-cascade map, then clear the system")
        val cfg = ShadowMapConfig.default_config()
        var sys = ShadowSystem.new(cfg)
        sys.add_shadow_map(CascadedShadowMap.new(2, cfg))
        sys.add_shadow_map(CascadedShadowMap.new(4, cfg))
        expect(sys.shadow_map_count()).to_equal(2)  # oracle: 2 — both maps registered before clear
        sys.clear()
        # @capture(statistics): registry count before and after clear
        step("Verify the registry is empty after clear")
        expect(sys.shadow_map_count()).to_equal(0)  # oracle: 0 — clear empties the registry
