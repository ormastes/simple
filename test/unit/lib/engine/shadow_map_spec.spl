"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-LIB behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/lib/engine/shadow_map_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-LIB-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Shadow Map System Tests

use std.spec.{describe, it, expect, step}
use std.nogc_sync_mut.engine.render.shadow_map.{ShadowMapConfig, CascadeLevel, CascadedShadowMap, ShadowSystem}

describe "ShadowMapConfig":
    it "creates default config":
        # @req: REQ-UNIT-LIB-001
        step("Verify: creates default config")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = ShadowMapConfig.default_config()
        expect(cfg.resolution).to_equal(1024)  # oracle: expected value 1024 is the behavior asserted by this regression spec
        expect(cfg.bias).to_equal(0.005)
        expect(cfg.normal_bias).to_equal(0.02)
        expect(cfg.soft_shadows).to_equal(true)

    it "creates high quality config":
        # @req: REQ-UNIT-LIB-002
        step("Verify: creates high quality config")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = ShadowMapConfig.high_quality()
        expect(cfg.resolution).to_equal(2048)  # oracle: expected value 2048 is the behavior asserted by this regression spec
        expect(cfg.bias).to_equal(0.003)
        expect(cfg.normal_bias).to_equal(0.01)
        expect(cfg.soft_shadows).to_equal(true)

describe "CascadedShadowMap":
    it "creates with correct cascade count":
        # @req: REQ-UNIT-LIB-003
        step("Verify: creates with correct cascade count")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = ShadowMapConfig.default_config()
        val csm = CascadedShadowMap.new(4, cfg)
        expect(csm.cascade_count).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec
        expect(csm.cascades.len()).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

    it "generates increasing split distances":
        # @req: REQ-UNIT-LIB-004
        step("Verify: generates increasing split distances")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = ShadowMapConfig.default_config()
        val csm = CascadedShadowMap.new(3, cfg)
        val c0 = csm.cascades[0]
        val c1 = csm.cascades[1]
        val c2 = csm.cascades[2]
        expect(c0.split_distance < c1.split_distance).to_equal(true)
        expect(c1.split_distance < c2.split_distance).to_equal(true)

    it "gets cascade by valid index":
        # @req: REQ-UNIT-LIB-005
        step("Verify: gets cascade by valid index")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = ShadowMapConfig.default_config()
        val csm = CascadedShadowMap.new(2, cfg)
        val maybe = csm.get_cascade(0)
        if val Some(level) = maybe:
            expect(level.split_distance > 0.0).to_equal(true)

    it "returns None for invalid cascade index":
        # @req: REQ-UNIT-LIB-006
        step("Verify: returns None for invalid cascade index")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = ShadowMapConfig.default_config()
        val csm = CascadedShadowMap.new(2, cfg)
        val maybe = csm.get_cascade(5)
        if val Some(level) = maybe:
            expect(1).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "computes total resolution":
        # @req: REQ-UNIT-LIB-007
        step("Verify: computes total resolution")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = ShadowMapConfig.default_config()
        val csm = CascadedShadowMap.new(2, cfg)
        val total = csm.total_resolution()
        # First cascade: 1024, second: 512
        expect(total).to_equal(1536)  # oracle: expected value 1536 is the behavior asserted by this regression spec

describe "ShadowSystem":
    it "starts enabled":
        # @req: REQ-UNIT-LIB-008
        step("Verify: starts enabled")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = ShadowMapConfig.default_config()
        val sys = ShadowSystem.new(cfg)
        expect(sys.is_enabled()).to_equal(true)
        expect(sys.shadow_map_count()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "adds shadow maps":
        # @req: REQ-UNIT-LIB-009
        step("Verify: adds shadow maps")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = ShadowMapConfig.default_config()
        var sys = ShadowSystem.new(cfg)
        val csm = CascadedShadowMap.new(3, cfg)
        val idx = sys.add_shadow_map(csm)
        expect(idx).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(sys.shadow_map_count()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "toggles enabled state":
        # @req: REQ-UNIT-LIB-010
        step("Verify: toggles enabled state")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = ShadowMapConfig.default_config()
        var sys = ShadowSystem.new(cfg)
        sys.set_enabled(false)
        expect(sys.is_enabled()).to_equal(false)
        sys.set_enabled(true)
        expect(sys.is_enabled()).to_equal(true)

    it "clears all shadow maps":
        # @req: REQ-UNIT-LIB-011
        step("Verify: clears all shadow maps")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cfg = ShadowMapConfig.default_config()
        var sys = ShadowSystem.new(cfg)
        sys.add_shadow_map(CascadedShadowMap.new(2, cfg))
        sys.add_shadow_map(CascadedShadowMap.new(4, cfg))
        expect(sys.shadow_map_count()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        sys.clear()
        expect(sys.shadow_map_count()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
