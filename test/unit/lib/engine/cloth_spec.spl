"""Cloth Simulation Tests"""
## Purpose and audience

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.physics.cloth.{ClothSimulation, ClothParticle}

# @req: REQ-ENGINE-Cloth-001
describe "ClothSimulation":
    it "creates empty simulation":
        # @req: REQ-ENGINE-Cloth-001
        step("Verify: creates empty simulation")
        var cloth = ClothSimulation.new(9.81, 0.99, 5)
        expect(cloth.particle_count()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(cloth.constraint_count()).to_equal(0)  # oracle: value fixed by the spec contract

    it "adds particles":
        # @req: REQ-ENGINE-Cloth-001
        step("Verify: adds particles")
        var cloth = ClothSimulation.new(9.81, 0.99, 5)
        val i0 = cloth.add_particle(0.0, 0.0, 1.0, true)
        val i1 = cloth.add_particle(1.0, 0.0, 1.0, false)
        expect(cloth.particle_count()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(i0).to_equal(0)  # oracle: value fixed by the spec contract
        expect(i1).to_equal(1)  # oracle: value fixed by the spec contract

    it "adds constraints with auto rest length":
        # @req: REQ-ENGINE-Cloth-001
        step("Verify: adds constraints with auto rest length")
        var cloth = ClothSimulation.new(9.81, 0.99, 5)
        cloth.add_particle(0.0, 0.0, 1.0, false)
        cloth.add_particle(1.0, 0.0, 1.0, false)
        val ci = cloth.add_constraint(0, 1)
        expect(cloth.constraint_count()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(ci).to_equal(0)  # oracle: value fixed by the spec contract

    it "pins and unpins particles":
        # @req: REQ-ENGINE-Cloth-001
        step("Verify: pins and unpins particles")
        var cloth = ClothSimulation.new(9.81, 0.99, 5)
        cloth.add_particle(0.0, 0.0, 1.0, false)
        cloth.pin_particle(0)
        if val Some(p) = cloth.get_particle(0):
            expect(p.pinned).to_equal(true)
        cloth.unpin_particle(0)
        if val Some(p2) = cloth.get_particle(0):
            expect(p2.pinned).to_equal(false)

    it "pinned particles stay fixed during simulation":
        # @req: REQ-ENGINE-Cloth-001
        step("Verify: pinned particles stay fixed during simulation")
        var cloth = ClothSimulation.new(9.81, 0.99, 5)
        cloth.add_particle(0.0, 0.0, 1.0, true)
        cloth.add_particle(1.0, 0.0, 1.0, false)
        cloth.add_constraint(0, 1)
        cloth.simulate(0.016)
        if val Some(p) = cloth.get_particle(0):
            expect(p.x).to_equal(0.0)  # oracle: value fixed by the spec contract
            expect(p.y).to_equal(0.0)  # oracle: value fixed by the spec contract

    it "unpinned particles move under gravity":
        # @req: REQ-ENGINE-Cloth-001
        step("Verify: unpinned particles move under gravity")
        var cloth = ClothSimulation.new(9.81, 0.99, 5)
        cloth.add_particle(0.0, 0.0, 1.0, false)
        cloth.simulate(0.1)
        if val Some(p) = cloth.get_particle(0):
            expect(p.y).to_be_greater_than(0.0)

    it "retrieves particle by index":
        # @req: REQ-ENGINE-Cloth-001
        step("Verify: retrieves particle by index")
        var cloth = ClothSimulation.new(9.81, 0.99, 5)
        cloth.add_particle(3.0, 4.0, 2.0, false)
        if val Some(p) = cloth.get_particle(0):
            expect(p.x).to_equal(3.0)  # oracle: value fixed by the spec contract
            expect(p.y).to_equal(4.0)  # oracle: value fixed by the spec contract
            expect(p.mass).to_equal(2.0)  # oracle: value fixed by the spec contract
