# Engine Signal & EventBus Tests

use std.spec.{describe, it, expect}
use std.common.engine.signal.signal.{Signal}
use std.common.engine.signal.event_bus.{EventBus}

# @req: REQ-ENGINE-Signal-001
# Module-level recorders: closures capture enclosing locals by value and are
# read-only (.claude/rules/language.md:22), so a write to a captured local
# is a compile error. Examples reset these at the old declaration site.
var received_cw = ""
var count_cw = 0
var count_cw2 = 0
var a_val_cw = ""
var b_val_cw = ""
var result_cw = ""
var result_cw2 = ""
var a_result_cw = ""
var b_result_cw = ""

describe "Signal":
    it "creates a signal with a name":
        # @req: REQ-ENGINE-Signal-001
        step("Verify: creates a signal with a name")
        val sig = Signal(name: "on_hit", connections: [], next_id: 0, enabled: true)
        expect(sig.name).to_equal("on_hit")
        expect(sig.enabled).to_equal(true)

    it "connects and emits to a listener":
        # @req: REQ-ENGINE-Signal-001
        step("Verify: connects and emits to a listener")
        received_cw = ""
        var sig = Signal(name: "test", connections: [], next_id: 0, enabled: true)
        fn on_data(data: text):
            received_cw = data
        val conn = sig.connect(on_data)
        sig.emit("hello")
        expect(received_cw).to_equal("hello")

    it "disconnects a listener":
        # @req: REQ-ENGINE-Signal-001
        step("Verify: disconnects a listener")
        count_cw = 0
        var sig = Signal(name: "test", connections: [], next_id: 0, enabled: true)
        fn on_inc(data: text):
            count_cw = count_cw + 1
        val conn = sig.connect(on_inc)
        sig.emit("a")
        expect(count_cw).to_equal(1)  # oracle: value fixed by the spec contract
        val removed = sig.disconnect(conn)
        expect(removed).to_equal(true)
        sig.emit("b")
        expect(count_cw).to_equal(1)  # oracle: value fixed by the spec contract

    it "supports one-shot connections":
        # @req: REQ-ENGINE-Signal-001
        step("Verify: supports one-shot connections")
        count_cw2 = 0
        var sig = Signal(name: "test", connections: [], next_id: 0, enabled: true)
        fn on_once(data: text):
            count_cw2 = count_cw2 + 1
        val conn = sig.connect_once(on_once)
        sig.emit("first")
        sig.emit("second")
        expect(count_cw2).to_equal(1)  # oracle: value fixed by the spec contract

    it "emits to multiple listeners":
        # @req: REQ-ENGINE-Signal-001
        step("Verify: emits to multiple listeners")
        a_val_cw = ""
        b_val_cw = ""
        var sig = Signal(name: "multi", connections: [], next_id: 0, enabled: true)
        fn on_a(data: text):
            a_val_cw = data
        fn on_b(data: text):
            b_val_cw = data
        val ca = sig.connect(on_a)
        val cb = sig.connect(on_b)
        sig.emit("msg")
        expect(a_val_cw).to_equal("msg")
        expect(b_val_cw).to_equal("msg")

describe "EventBus":
    it "registers and emits named signals":
        # @req: REQ-ENGINE-Signal-001
        step("Verify: registers and emits named signals")
        result_cw = ""
        var bus = EventBus(signals: {})
        bus.register("damage")
        fn on_damage(data: text):
            result_cw = data
        val conn = bus.connect("damage", on_damage)
        bus.emit("damage", "50")
        expect(result_cw).to_equal("50")

    it "auto-registers on connect":
        # @req: REQ-ENGINE-Signal-001
        step("Verify: auto-registers on connect")
        result_cw2 = ""
        var bus = EventBus(signals: {})
        fn on_score(data: text):
            result_cw2 = data
        val conn = bus.connect("score", on_score)
        bus.emit("score", "100")
        expect(result_cw2).to_equal("100")

    it "does not cross-emit between different signals":
        # @req: REQ-ENGINE-Signal-001
        step("Verify: does not cross-emit between different signals")
        a_result_cw = ""
        b_result_cw = ""
        var bus = EventBus(signals: {})
        fn on_alpha(data: text):
            a_result_cw = data
        fn on_beta(data: text):
            b_result_cw = data
        val ca = bus.connect("alpha", on_alpha)
        val cb = bus.connect("beta", on_beta)
        bus.emit("alpha", "aaa")
        expect(a_result_cw).to_equal("aaa")
        expect(b_result_cw).to_equal("")
