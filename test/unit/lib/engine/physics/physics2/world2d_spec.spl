# Physics2 World2D — Unit Tests
#
# Tests the multi-backend PhysicsWorld2D against known physics scenarios.

"""
## Purpose and audience
Verifies the world2d behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

use std.io_runtime
use std.spec.{describe, it, expect}
use std.common.engine.ids.{NodeId}
use std.nogc_sync_mut.engine.physics.config.{default_physics_config_2d, PhysicsConfig2D}
use std.nogc_sync_mut.engine.physics.backend.{PhysicsBackend}
use std.nogc_sync_mut.engine.physics.world2d.{PhysicsWorld2D}

fn make_node(idx: i64) -> NodeId:
    NodeId(raw: idx)

# @req: REQ-PHYSICS2-World2d-001
describe "PhysicsWorld2D":
    it "creates with default config":
        # @req: REQ-PHYSICS2-World2d-001
        step("Verify: creates with default config")
        val config = default_physics_config_2d()
        var world = PhysicsWorld2D.create(config)
        expect(world.body_count()).to_equal(0)  # oracle: value fixed by the spec contract
        world.destroy()

    it "adds dynamic body":
        # @req: REQ-PHYSICS2-World2d-001
        step("Verify: adds dynamic body")
        val config = default_physics_config_2d()
        var world = PhysicsWorld2D.create(config)
        val node = make_node(1)
        val idx = world.add_dynamic_body(node, 0.0, 5.0, 1.0)
        expect(world.body_count()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(idx).to_equal(0)  # oracle: value fixed by the spec contract
        world.destroy()

    it "adds static body":
        # @req: REQ-PHYSICS2-World2d-001
        step("Verify: adds static body")
        val config = default_physics_config_2d()
        var world = PhysicsWorld2D.create(config)
        val node = make_node(2)
        val idx = world.add_static_body(node, 0.0, 0.0)
        expect(world.body_count()).to_equal(1)  # oracle: value fixed by the spec contract
        world.destroy()

    it "body falls under gravity":
        # @req: REQ-PHYSICS2-World2d-001
        step("Verify: body falls under gravity")
        var config = default_physics_config_2d()
        config.backend = PhysicsBackend.CpuScalar
        var world = PhysicsWorld2D.create(config)
        val node = make_node(1)
        world.add_dynamic_body(node, 0.0, 10.0, 1.0)
        world.add_circle_collider(node, 0.5)
        world.step(0.1)
        val pos = world.get_position(node)
        expect(pos.y < 10.0).to_equal(true)
        world.destroy()

    it "static body does not move":
        # @req: REQ-PHYSICS2-World2d-001
        step("Verify: static body does not move")
        var config = default_physics_config_2d()
        config.backend = PhysicsBackend.CpuScalar
        var world = PhysicsWorld2D.create(config)
        val node = make_node(1)
        world.add_static_body(node, 5.0, 3.0)
        world.step(0.1)
        val pos = world.get_position(node)
        expect(pos.x).to_equal(5.0)  # oracle: value fixed by the spec contract
        expect(pos.y).to_equal(3.0)  # oracle: value fixed by the spec contract
        world.destroy()

    it "collision stops falling body on floor":
        # @req: REQ-PHYSICS2-World2d-001
        step("Verify: collision stops falling body on floor")
        var config = default_physics_config_2d()
        config.backend = PhysicsBackend.CpuScalar
        var world = PhysicsWorld2D.create(config)
        val floor_id = make_node(1)
        val ball_id = make_node(2)
        world.add_static_body(floor_id, 0.0, 0.0)
        world.add_box_collider(floor_id, 10.0, 0.5)
        world.add_dynamic_body(ball_id, 0.0, 2.0, 1.0)
        world.add_circle_collider(ball_id, 0.5)
        var step = 0
        while step < 200:
            world.step(0.016)
            step = step + 1
        val pos = world.get_position(ball_id)
        expect(pos.y > -1.0).to_equal(true)
        expect(pos.y < 3.0).to_equal(true)
        world.destroy()

    it "apply_force accelerates body":
        # @req: REQ-PHYSICS2-World2d-001
        step("Verify: apply_force accelerates body")
        var config = default_physics_config_2d()
        config.backend = PhysicsBackend.CpuScalar
        var world = PhysicsWorld2D.create(config)
        val node = make_node(1)
        world.add_dynamic_body(node, 0.0, 0.0, 1.0)
        world.add_circle_collider(node, 0.5)
        world.apply_force(node, 10.0, 0.0)
        world.step(0.1)
        val vel = world.get_velocity(node)
        expect(vel.x > 0.0).to_equal(true)
        world.destroy()

    it "get_all_dynamic_transforms returns only dynamic bodies":
        # @req: REQ-PHYSICS2-World2d-001
        step("Verify: get_all_dynamic_transforms returns only dynamic bodies")
        var config = default_physics_config_2d()
        config.backend = PhysicsBackend.CpuScalar
        var world = PhysicsWorld2D.create(config)
        val s = make_node(1)
        val d1 = make_node(2)
        val d2 = make_node(3)
        world.add_static_body(s, 0.0, 0.0)
        world.add_dynamic_body(d1, 1.0, 1.0, 1.0)
        world.add_dynamic_body(d2, 2.0, 2.0, 1.0)
        val transforms = world.get_all_dynamic_transforms()
        expect(transforms.len()).to_equal(2)  # oracle: value fixed by the spec contract
        world.destroy()
