# Profiler Tests

"""
## Purpose and audience
Verifies the profiler behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.core.profiler.{Profiler, ProfileSample}

# @req: REQ-ENGINE-Profiler-001
describe "ProfileSample":
    it "computes duration":
        # @req: REQ-ENGINE-Profiler-001
        step("Verify: computes duration")
        val s = ProfileSample(name: "test", start_ms: 10.0, end_ms: 25.0, depth: 0)
        expect(s.duration_ms()).to_equal(15.0)  # oracle: value fixed by the spec contract

describe "Profiler":
    it "starts enabled with zero samples":
        # @req: REQ-ENGINE-Profiler-001
        step("Verify: starts enabled with zero samples")
        val p = Profiler.new(100)
        expect(p.is_enabled()).to_equal(true)
        expect(p.sample_count()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(p.get_frame_count()).to_equal(0)  # oracle: value fixed by the spec contract

    it "records a scope":
        # @req: REQ-ENGINE-Profiler-001
        step("Verify: records a scope")
        var p = Profiler.new(100)
        p.begin_scope("update", 0.0)
        p.end_scope(16.0)
        expect(p.sample_count()).to_equal(1)  # oracle: value fixed by the spec contract
        val samples = p.get_samples()
        expect(samples[0].name).to_equal("update")
        expect(samples[0].start_ms).to_equal(0.0)  # oracle: value fixed by the spec contract
        expect(samples[0].end_ms).to_equal(16.0)  # oracle: value fixed by the spec contract

    it "tracks nesting depth":
        # @req: REQ-ENGINE-Profiler-001
        step("Verify: tracks nesting depth")
        var p = Profiler.new(100)
        p.begin_scope("frame", 0.0)
        p.begin_scope("physics", 1.0)
        p.end_scope(5.0)
        p.end_scope(16.0)
        val samples = p.get_samples()
        expect(samples[0].depth).to_equal(0)  # oracle: value fixed by the spec contract
        expect(samples[1].depth).to_equal(1)  # oracle: value fixed by the spec contract

    it "increments frame count":
        # @req: REQ-ENGINE-Profiler-001
        step("Verify: increments frame count")
        var p = Profiler.new(100)
        p.begin_frame()
        p.begin_frame()
        p.begin_frame()
        expect(p.get_frame_count()).to_equal(3)  # oracle: value fixed by the spec contract

    it "does not record when disabled":
        # @req: REQ-ENGINE-Profiler-001
        step("Verify: does not record when disabled")
        var p = Profiler.new(100)
        p.set_enabled(false)
        expect(p.is_enabled()).to_equal(false)
        p.begin_scope("ignored", 0.0)
        expect(p.sample_count()).to_equal(0)  # oracle: value fixed by the spec contract

    it "trims to max_samples":
        # @req: REQ-ENGINE-Profiler-001
        step("Verify: trims to max_samples")
        var p = Profiler.new(2)
        p.begin_scope("a", 0.0)
        p.end_scope(1.0)
        p.begin_scope("b", 1.0)
        p.end_scope(2.0)
        p.begin_scope("c", 2.0)
        p.end_scope(3.0)
        expect(p.sample_count()).to_equal(2)  # oracle: value fixed by the spec contract
        val samples = p.get_samples()
        expect(samples[0].name).to_equal("b")
        expect(samples[1].name).to_equal("c")

    it "finds samples by name":
        # @req: REQ-ENGINE-Profiler-001
        step("Verify: finds samples by name")
        var p = Profiler.new(100)
        p.begin_scope("render", 0.0)
        p.end_scope(5.0)
        p.begin_scope("physics", 5.0)
        p.end_scope(8.0)
        p.begin_scope("render", 8.0)
        p.end_scope(14.0)
        val renders = p.find_samples_by_name("render")
        expect(renders.len()).to_equal(2)  # oracle: value fixed by the spec contract

    it "clears all state":
        # @req: REQ-ENGINE-Profiler-001
        step("Verify: clears all state")
        var p = Profiler.new(100)
        p.begin_frame()
        p.begin_scope("test", 0.0)
        p.end_scope(1.0)
        p.clear()
        expect(p.sample_count()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(p.get_frame_count()).to_equal(0)  # oracle: value fixed by the spec contract
