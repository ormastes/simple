"""
## Purpose and audience
Purpose: Prove that EngineColor.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

"""
Engine Color — EngineColor Tests

Tests RGBA constructors, presets, lerp, to_rgba8, from_hex.
"""

use std.spec.{describe, it, expect}
use std.common.engine.color.{EngineColor}

describe "EngineColor":
    describe "constructors":
        it "creates RGBA color":
            step("Verify: creates RGBA color")
            # @req: REQ-LIB-ENGINE-001
            val c = EngineColor.rgba(0.5, 0.6, 0.7, 0.8)
            expect(c.r).to_equal(0.5)  # oracle: 0.5 — named expected value from the requirement
            expect(c.g).to_equal(0.6)  # oracle: 0.6 — named expected value from the requirement
            expect(c.b).to_equal(0.7)  # oracle: 0.7 — named expected value from the requirement
            expect(c.a).to_equal(0.8)  # oracle: 0.8 — named expected value from the requirement

        it "creates RGB color with alpha 1.0":
            step("Verify: creates RGB color with alpha 1.0")
            val c = EngineColor.rgb(0.1, 0.2, 0.3)
            expect(c.a).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement

    describe "presets":
        it "creates white":
            step("Verify: creates white")
            val c = EngineColor.white()
            expect(c.r).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement
            expect(c.g).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement
            expect(c.b).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement

        it "creates black":
            step("Verify: creates black")
            val c = EngineColor.black()
            expect(c.r).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
            expect(c.g).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
            expect(c.b).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement

        it "creates red":
            step("Verify: creates red")
            val c = EngineColor.red()
            expect(c.r).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement
            expect(c.g).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
            expect(c.b).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement

    describe "operations":
        it "lerps between two colors at t=0.5":
            step("Verify: lerps between two colors at t=0.5")
            val a = EngineColor.black()
            val b = EngineColor.white()
            val mid = a.lerp(b, 0.5)
            # Each channel should be ~0.5
            val ri = mid.r * 1000.0
            expect(ri).to_be_greater_than(499.0)
            expect(ri).to_be_less_than(501.0)

        it "converts to rgba8 struct":
            step("Verify: converts to rgba8 struct")
            val c = EngineColor.rgba(1.0, 0.0, 0.5, 1.0)
            val rgba = c.to_rgba8()
            expect(rgba.r).to_equal(255)  # oracle: 255 — named expected value from the requirement
            expect(rgba.g).to_equal(0)  # oracle: 0 — named expected value from the requirement
            # 0.5 * 255 ~= 128
            expect(rgba.b).to_be_greater_than(126)
            expect(rgba.b).to_be_less_than(129)
            expect(rgba.a).to_equal(255)  # oracle: 255 — named expected value from the requirement

        it "creates from hex integer":
            step("Verify: creates from hex integer")
            # 0xFF0000 = red (255, 0, 0)
            val c = EngineColor.from_hex(16711680)
            expect(c.r).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement
            expect(c.g).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
            expect(c.b).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement

        it "creates color with modified alpha":
            step("Verify: creates color with modified alpha")
            val c = EngineColor.red()
            val faded = c.with_alpha(0.5)
            expect(faded.r).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement
            expect(faded.a).to_equal(0.5)  # oracle: 0.5 — named expected value from the requirement
