"""
## Purpose and audience
Purpose: Prove that AtlasBuilder.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

"""
Engine Atlas Builder Tests

Tests AtlasBuilder sprite registration, shelf-based packing, and AtlasLayout lookups.
"""

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.sprite.atlas_builder.{AtlasBuilder, AtlasLayout, SpriteEntry, PackedSprite}

describe "AtlasBuilder":
    it "starts with zero entries":
        step("Verify: starts with zero entries")
        # @req: REQ-LIB-ENGINE-001
        val builder = AtlasBuilder.new(1)
        expect(builder.entry_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "adds sprite entries":
        step("Verify: adds sprite entries")
        var builder = AtlasBuilder.new(1)
        builder.add_sprite("hero", 32, 32)
        builder.add_sprite("enemy", 16, 16)
        expect(builder.entry_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "clears all entries":
        step("Verify: clears all entries")
        var builder = AtlasBuilder.new(1)
        builder.add_sprite("hero", 32, 32)
        builder.clear()
        expect(builder.entry_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "packs a single sprite":
        step("Verify: packs a single sprite")
        var builder = AtlasBuilder.new(0)
        builder.add_sprite("hero", 32, 32)
        val layout = builder.pack()
        expect(layout.sprite_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val sp = layout.find_sprite("hero")
        if val Some(s) = sp:
            expect(s.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(s.y).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(s.width).to_equal(32)  # oracle: 32 — named expected value from the requirement
            expect(s.height).to_equal(32)  # oracle: 32 — named expected value from the requirement

    it "packs multiple sprites on one shelf":
        step("Verify: packs multiple sprites on one shelf")
        var builder = AtlasBuilder.new(0)
        builder.add_sprite("a", 16, 32)
        builder.add_sprite("b", 16, 32)
        val layout = builder.pack()
        expect(layout.sprite_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        # Both same height, should be on same shelf
        val sa = layout.find_sprite("a")
        val sb = layout.find_sprite("b")
        if val Some(a) = sa:
            if val Some(b) = sb:
                # Same y (same shelf)
                expect(a.y).to_equal(b.y)

    it "packs with padding between sprites":
        step("Verify: packs with padding between sprites")
        var builder = AtlasBuilder.new(2)
        builder.add_sprite("a", 10, 10)
        builder.add_sprite("b", 10, 10)
        val layout = builder.pack()
        expect(layout.sprite_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        # With padding=2, second sprite should start at x=12
        val sb = layout.find_sprite("b")
        if val Some(b) = sb:
            expect(b.x).to_equal(12)  # oracle: 12 — named expected value from the requirement

    it "computes atlas dimensions":
        step("Verify: computes atlas dimensions")
        var builder = AtlasBuilder.new(0)
        builder.add_sprite("a", 16, 32)
        builder.add_sprite("b", 16, 32)
        val layout = builder.pack()
        # Two 16-wide sprites side by side = 32 wide, 32 tall
        expect(layout.width).to_equal(32)  # oracle: 32 — named expected value from the requirement
        expect(layout.height).to_equal(32)  # oracle: 32 — named expected value from the requirement

describe "AtlasLayout":
    it "returns nil for missing sprite name":
        step("Verify: returns nil for missing sprite name")
        var builder = AtlasBuilder.new(0)
        builder.add_sprite("hero", 32, 32)
        val layout = builder.pack()
        val missing = layout.find_sprite("nonexistent")
        var found = false
        if val Some(m) = missing:
            found = true
        expect(found).to_equal(false)
