"""
## Purpose and audience
Purpose: Prove that Rect2.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

"""
Engine Rect2 — Rectangle Tests

Tests constructors, edges, containment, intersection, merge, expand.
"""

use std.spec.{describe, it, expect}
use std.common.engine.rect.{Rect2}

describe "Rect2":
    describe "constructors":
        it "creates with new":
            step("Verify: creates with new")
            # @req: REQ-LIB-ENGINE-001
            val r = Rect2.new(10.0, 20.0, 100.0, 50.0)
            expect(r.x).to_equal(10.0)  # oracle: 10.0 — named expected value from the requirement
            expect(r.y).to_equal(20.0)  # oracle: 20.0 — named expected value from the requirement
            expect(r.width).to_equal(100.0)  # oracle: 100.0 — named expected value from the requirement
            expect(r.height).to_equal(50.0)  # oracle: 50.0 — named expected value from the requirement

        it "creates from center":
            step("Verify: creates from center")
            val r = Rect2.from_center(50.0, 50.0, 20.0, 10.0)
            expect(r.x).to_equal(40.0)  # oracle: 40.0 — named expected value from the requirement
            expect(r.y).to_equal(45.0)  # oracle: 45.0 — named expected value from the requirement
            expect(r.width).to_equal(20.0)  # oracle: 20.0 — named expected value from the requirement
            expect(r.height).to_equal(10.0)  # oracle: 10.0 — named expected value from the requirement

    describe "edge accessors":
        it "returns correct edges":
            step("Verify: returns correct edges")
            val r = Rect2.new(10.0, 20.0, 30.0, 40.0)
            expect(r.left()).to_equal(10.0)  # oracle: 10.0 — named expected value from the requirement
            expect(r.right()).to_equal(40.0)  # oracle: 40.0 — named expected value from the requirement
            expect(r.top()).to_equal(20.0)  # oracle: 20.0 — named expected value from the requirement
            expect(r.bottom()).to_equal(60.0)  # oracle: 60.0 — named expected value from the requirement

    describe "queries":
        it "contains interior point":
            step("Verify: contains interior point")
            val r = Rect2.new(0.0, 0.0, 100.0, 100.0)
            expect(r.contains_point(50.0, 50.0)).to_equal(true)

        it "does not contain exterior point":
            step("Verify: does not contain exterior point")
            val r = Rect2.new(0.0, 0.0, 100.0, 100.0)
            expect(r.contains_point(150.0, 50.0)).to_equal(false)

        it "contains edge point":
            step("Verify: contains edge point")
            val r = Rect2.new(0.0, 0.0, 100.0, 100.0)
            expect(r.contains_point(0.0, 0.0)).to_equal(true)
            expect(r.contains_point(100.0, 100.0)).to_equal(true)

    describe "intersection":
        it "detects overlapping rects":
            step("Verify: detects overlapping rects")
            val a = Rect2.new(0.0, 0.0, 10.0, 10.0)
            val b = Rect2.new(5.0, 5.0, 10.0, 10.0)
            expect(a.intersects(b)).to_equal(true)

        it "detects non-overlapping rects":
            step("Verify: detects non-overlapping rects")
            val a = Rect2.new(0.0, 0.0, 10.0, 10.0)
            val b = Rect2.new(20.0, 20.0, 10.0, 10.0)
            expect(a.intersects(b)).to_equal(false)

    describe "merge and expand":
        it "merges two rects into bounding rect":
            step("Verify: merges two rects into bounding rect")
            val a = Rect2.new(0.0, 0.0, 10.0, 10.0)
            val b = Rect2.new(20.0, 20.0, 10.0, 10.0)
            val m = a.merge(b)
            expect(m.x).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
            expect(m.y).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
            expect(m.right()).to_equal(30.0)  # oracle: 30.0 — named expected value from the requirement
            expect(m.bottom()).to_equal(30.0)  # oracle: 30.0 — named expected value from the requirement

        it "expands rect by margin":
            step("Verify: expands rect by margin")
            val r = Rect2.new(10.0, 10.0, 20.0, 20.0)
            val e = r.expand(5.0)
            expect(e.x).to_equal(5.0)  # oracle: 5.0 — named expected value from the requirement
            expect(e.y).to_equal(5.0)  # oracle: 5.0 — named expected value from the requirement
            expect(e.width).to_equal(30.0)  # oracle: 30.0 — named expected value from the requirement
            expect(e.height).to_equal(30.0)  # oracle: 30.0 — named expected value from the requirement
