"""
## Purpose and audience
Purpose: Prove that SkPicture.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-SKIA-001 — stable requirement identity for this spec.

# @cover src/lib/skia/entity/picture.spl 80%
"""
# Skia Picture Specification

**Feature IDs:** #SKI-007
**Category:** Stdlib
**Difficulty:** 1/5
**Status:** Implemented

## Overview

Tests for SkPicture and SkPictureRecorder construction and state.
"""

use std.skia.entity.picture.{
    SkPicture, SkPictureRecorder,
    sk_picture_empty, sk_picture_recorder_new
}
use std.skia.entity.geometry.{SkRect, sk_rect_make_wh}

use std.spec.step

describe "SkPicture":
    it "sk_picture_empty creates zero op picture":
        step("Verify: sk_picture_empty creates zero op picture")
        # @req: REQ-LIB-SKIA-001
        val pic = sk_picture_empty()
        expect(pic.approximate_op_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "empty picture cull_rect is zero":
        step("Verify: empty picture cull_rect is zero")
        val pic = sk_picture_empty()
        val cr = pic.cull_rect()
        expect(cr.left).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
        expect(cr.right).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement

describe "SkPictureRecorder":
    it "new recorder is not recording":
        step("Verify: new recorder is not recording")
        val rec = sk_picture_recorder_new()
        expect(rec.is_recording()).to_equal(false)

    it "begin_recording sets recording flag":
        step("Verify: begin_recording sets recording flag")
        val rec = sk_picture_recorder_new()
        val bounds = sk_rect_make_wh(800.0, 600.0)
        val rec2 = rec.begin_recording(bounds)
        expect(rec2.is_recording()).to_equal(true)

    it "begin_recording stores bounds":
        step("Verify: begin_recording stores bounds")
        val rec = sk_picture_recorder_new()
        val bounds = sk_rect_make_wh(800.0, 600.0)
        val rec2 = rec.begin_recording(bounds)
        expect(rec2.cull_rect.right).to_equal(800.0)  # oracle: 800.0 — named expected value from the requirement
        expect(rec2.cull_rect.bottom).to_equal(600.0)  # oracle: 600.0 — named expected value from the requirement

    it "finish_recording returns a picture":
        step("Verify: finish_recording returns a picture")
        val rec = sk_picture_recorder_new()
        val bounds = sk_rect_make_wh(200.0, 200.0)
        val rec2 = rec.begin_recording(bounds)
        val pic = rec2.finish_recording()
        expect(pic.approximate_op_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "finished picture preserves cull_rect":
        step("Verify: finished picture preserves cull_rect")
        val rec = sk_picture_recorder_new()
        val bounds = sk_rect_make_wh(500.0, 300.0)
        val pic = rec.begin_recording(bounds).finish_recording()
        val cr = pic.cull_rect()
        expect(cr.right).to_equal(500.0)  # oracle: 500.0 — named expected value from the requirement
        expect(cr.bottom).to_equal(300.0)  # oracle: 300.0 — named expected value from the requirement
