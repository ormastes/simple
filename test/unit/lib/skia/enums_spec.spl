"""
# Skia Enums Specification

**Feature IDs:** #SKI-001
**Category:** Stdlib
**Difficulty:** 1/5
**Status:** Implemented

## Overview

Tests that all Skia enum variants construct correctly and compare by identity.
"""

use std.skia.entity.enums.{
    SkPaintStyle, SkPaintCap, SkPaintJoin,
    SkBlendMode,
    SkPathFillType, SkPathDirection,
    SkClipOp,
    SkTileMode,
    SkAlphaType, SkColorType,
    SkFilterMode, SkMipmapMode,
    SkTextEncoding
}

use std.spec.{step}
describe "SkPaintStyle":
    it "Fill variant exists":
        # @req: REQ-UNIT-LIB-001
        step("Verify: Fill variant exists")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val s = SkPaintStyle.Fill
        expect(s).to_equal(SkPaintStyle.Fill)

    it "Stroke variant exists":
        # @req: REQ-UNIT-LIB-002
        step("Verify: Stroke variant exists")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val s = SkPaintStyle.Stroke
        expect(s).to_equal(SkPaintStyle.Stroke)

    it "StrokeAndFill variant exists":
        # @req: REQ-UNIT-LIB-003
        step("Verify: StrokeAndFill variant exists")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val s = SkPaintStyle.StrokeAndFill
        expect(s).to_equal(SkPaintStyle.StrokeAndFill)

    it "Fill != Stroke":
        # @req: REQ-UNIT-LIB-004
        step("Verify: Fill != Stroke")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(SkPaintStyle.Fill).to_not_equal(SkPaintStyle.Stroke)

