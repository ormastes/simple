"""
## Purpose and audience
Behavioral specification for remote security quorum.
Audience: compiler/runtime developers and spec maintainers who need
to verify this component's observable behavior and pinned values.
"""
# @req: REQ-LIB-SECURITY_REMOTE_SECURITY_QUORU-001
use std.security.remote_quorum.{RemoteSecurityQuorumSessionStore, remote_security_quorum_clamp, remote_security_quorum_pick}
use std.security.types.{RemoteSecuritySession, RemoteSecuritySessionStoreAdapter}

fn quorum_session(session_id: text, expires_at_ms: i64, revoked: bool, capabilities: List<text>) -> RemoteSecuritySession:
    RemoteSecuritySession(
        session_id: session_id,
        user_id: "user-10",
        capabilities: capabilities,
        expires_at_ms: expires_at_ms,
        revoked: revoked
    )

use std.spec.step
describe "remote security quorum session store":
    it "reports write quorum success":
        # @req: REQ-LIB-SECURITY_REMOTE_SECURITY_QUORU-001
        step("Verify: reports write quorum success")
        var replica_a = RemoteSecuritySessionStoreAdapter.replicated("redis", "security:a")
        var replica_b = RemoteSecuritySessionStoreAdapter.replicated("redis", "security:b")
        var replica_c = RemoteSecuritySessionStoreAdapter.replicated("redis", "security:c")
        var quorum = RemoteSecurityQuorumSessionStore.new([replica_a, replica_b, replica_c], 2, 2)

        expect(quorum.create_session("write-only-session", "user-10", ["profile.read"], 9000)).to_equal(true)

    it "clamps impossible quorum counts to the replica count":
        # @req: REQ-LIB-SECURITY_REMOTE_SECURITY_QUORU-001
        step("Verify: clamps impossible quorum counts to the replica count")
        expect(remote_security_quorum_clamp(0, 3)).to_equal(1)  # oracle: expected value pinned by spec
        expect(remote_security_quorum_clamp(5, 3)).to_equal(3)  # oracle: expected value pinned by spec
        expect(remote_security_quorum_clamp(2, 3)).to_equal(2)  # oracle: expected value pinned by spec

    it "chooses the later active expiry when no revocation is present":
        # @req: REQ-LIB-SECURITY_REMOTE_SECURITY_QUORU-001
        step("Verify: chooses the later active expiry when no revocation is present")
        val older = quorum_session("merge-session", 4000, false, ["profile.read"])
        val newer = quorum_session("merge-session", 9000, false, ["profile.read", "billing.write"])
        val winner = remote_security_quorum_pick(Some(older), newer)
        val loaded: RemoteSecuritySession = winner.unwrap()

        expect(loaded.expires_at_ms).to_equal(9000)  # oracle: expected value pinned by spec
        expect(loaded.capabilities[1]).to_equal("billing.write")

    it "lets revocation win over a later active session":
        # @req: REQ-LIB-SECURITY_REMOTE_SECURITY_QUORU-001
        step("Verify: lets revocation win over a later active session")
        val active = quorum_session("revoked-session", 9000, false, ["admin.read"])
        val revoked = quorum_session("revoked-session", 4000, true, ["admin.read"])
        val winner = remote_security_quorum_pick(Some(active), revoked)
        val loaded: RemoteSecuritySession = winner.unwrap()

        expect(loaded.revoked).to_equal(true)

    it "exports quorum topology without session payloads":
        # @req: REQ-LIB-SECURITY_REMOTE_SECURITY_QUORU-001
        step("Verify: exports quorum topology without session payloads")
        var replica_a = RemoteSecuritySessionStoreAdapter.replicated("redis", "security:a")
        var replica_b = RemoteSecuritySessionStoreAdapter.replicated("redis", "security:b")
        var replica_c = RemoteSecuritySessionStoreAdapter.replicated("redis", "security:c")
        var quorum = RemoteSecurityQuorumSessionStore.new([replica_a, replica_b, replica_c], 2, 2)

        val sdn = quorum.export_sdn()

        expect(sdn).to_contain("remote_security_quorum_session_store:")
        expect(sdn).to_contain("read_quorum: 2")
        expect(sdn).to_contain("write_quorum: 2")
        expect(sdn).to_contain("replica|1|redis|security:b")
