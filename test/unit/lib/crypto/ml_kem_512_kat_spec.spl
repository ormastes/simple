# ML-KEM-512 — NIST FIPS 203 Property Spec
"""
## Purpose and audience
Known-answer property spec for ML-KEM-512 (FIPS 203, security category 1):
parameter set k = 2, η1 = 3, η2 = 2, du = 10, dv = 4. Audience: os.crypto
maintainers and protocol reviewers who need the shipped size invariants,
parameter table, and a deterministic KeyGen/Encaps/Decaps round-trip checked
against the NIST standard values.
## Operator workflow
Run
`./src/compiler_rust/target/bootstrap/simple run test/unit/lib/crypto/ml_kem_512_kat_spec.spl`.
The size and parameter scenarios call the product constants directly; the
ITEM-3 scenario records the flag computed by the load-time round-trip harness
at this file's tail.
## Compatibility and limitations
The round-trip harness runs at module load (top-level), per the 768
precedent, because the interpreter spec runner reports load-only PASS for
`it` blocks (`feedback_compile_mode_false_greens.md`); a harness crash
surfaces as a load-time error, not a silent green. Vectors are the
deterministic zero-seed case, not the full NIST KAT suite.
## Verification guidance and troubleshooting
A size or parameter failure means a product constant drifted from FIPS 203
§8 Table 3 / §2.3 Table 2 — fix `os.crypto.ml_kem*`, never the expected
literal here. An ITEM-3 failure means Decaps returned a shared secret that
differs from Encaps for the zero seed; bisect the NTT ladder first.
"""
# Lifecycle: doc/01_research/domain/x25519mlkem768_acceleration.md ;
# doc/03_plan/sys_test/x25519mlkem768_acceleration.md ;
# doc/04_architecture/lib/pqc_hybrid_kex_design.md ;
# doc/05_design/lib/x25519mlkem768_remaining_detail_design.md
# @manual_section: ML-KEM-512 known-answer properties

use std.spipe.*
use std.spec.step
use os.crypto.ml_kem_ntt.{ml_kem_q,
    ml_kem_k_512, ml_kem_eta1_512, ml_kem_eta2_512,
    ml_kem_du_512, ml_kem_dv_512}
use os.crypto.ml_kem.{ml_kem_512_ek_bytes, ml_kem_512_dk_bytes,
    ml_kem_512_ct_bytes, ml_kem_512_ss_bytes,
    ml_kem_keygen_512, ml_kem_encaps_512, ml_kem_decaps_512}

# Reference: NIST FIPS 203 — Module-Lattice-Based Key-Encapsulation Mechanism
#            Standard, https://csrc.nist.gov/pubs/fips/203/final §8 Table 3.

# ----------------------------------------------------------------------------
# Top-level deterministic round-trip harness (load-time guard).
# ----------------------------------------------------------------------------
# A fully zero seed (d = z = 0^32, m = 0^32) is a fixed deterministic vector
# that any FIPS 203 ML-KEM-512 implementation must round-trip: the shared
# secret returned by Decaps(dk, Encaps(ek, m).c) must equal Encaps(ek, m).K.
# We materialise the seeds at module scope so that any panic during
# arithmetic / slicing surfaces at file load (the interpreter spec runner's
# load-only model still catches that — `feedback_compile_mode_false_greens.md`).

fn _ml_kem_512_zero32() -> list:
    var v = []
    var i = 0
    while i < 32:
        v.push(0)
        i = i + 1
    v

fn ml_kem_512_round_trip_check() -> i64:
    val d = _ml_kem_512_zero32()
    val z = _ml_kem_512_zero32()
    val m = _ml_kem_512_zero32()
    val kp = ml_kem_keygen_512(d, z)
    val ek = kp[0]
    val dk = kp[1]
    val enc = ml_kem_encaps_512(ek, m)
    val k_send = enc[0]
    val ct = enc[1]
    val k_recv = ml_kem_decaps_512(dk, ct)
    # Sizes must match Table 3 ML-KEM-512 row.
    var ok = 1
    if ek.len() != 800:
        ok = 0
    if dk.len() != 1632:
        ok = 0
    if ct.len() != 768:
        ok = 0
    if k_send.len() != 32:
        ok = 0
    if k_recv.len() != 32:
        ok = 0
    var i = 0
    while i < 32:
        if k_send.get(i) != k_recv.get(i):
            ok = 0
        i = i + 1
    ok

val ml_kem_512_round_trip_ok = ml_kem_512_round_trip_check()

describe "ML-KEM-512 size invariants (FIPS 203 §8 Table 3)":

    it "ITEM-1a ek = 800 bytes":
        # @req REQ-CRYPTO-MLKEM-512-001
        # @capture(bit_table): FIPS 203 Table 3 ek size row retained for review
        step("Read the ML-KEM-512 encapsulation key length from the product")
        expect(ml_kem_512_ek_bytes()).to_equal(800)  # oracle: FIPS 203 §8 Table 3 ML-KEM-512 ek = 800 bytes

    it "ITEM-1b dk = 1632 bytes":
        # @req REQ-CRYPTO-MLKEM-512-001
        # @capture(bit_table): FIPS 203 Table 3 dk size row retained for review
        step("Read the ML-KEM-512 decapsulation key length from the product")
        expect(ml_kem_512_dk_bytes()).to_equal(1632)  # oracle: FIPS 203 §8 Table 3 ML-KEM-512 dk = 1632 bytes

    it "ITEM-1c ciphertext = 768 bytes":
        # @req REQ-CRYPTO-MLKEM-512-001
        # @capture(bit_table): FIPS 203 Table 3 ct size row retained for review
        step("Read the ML-KEM-512 ciphertext length from the product")
        expect(ml_kem_512_ct_bytes()).to_equal(768)  # oracle: FIPS 203 §8 Table 3 ML-KEM-512 ct = 768 bytes

    it "ITEM-1d shared secret = 32 bytes":
        # @req REQ-CRYPTO-MLKEM-512-001
        # @capture(bit_table): FIPS 203 Table 3 ss size row retained for review
        step("Read the ML-KEM-512 shared secret length from the product")
        expect(ml_kem_512_ss_bytes()).to_equal(32)  # oracle: FIPS 203 §8 Table 3 ML-KEM-512 ss = 32 bytes

describe "ML-KEM-512 parameter table (FIPS 203 §2.3 Table 2)":

    it "ITEM-2a k = 2":
        # @req REQ-CRYPTO-MLKEM-512-002
        # @capture(bit_table): FIPS 203 Table 2 k row retained for review
        step("Read the ML-KEM-512 lattice dimension from the product")
        expect(ml_kem_k_512()).to_equal(2)  # oracle: FIPS 203 §2.3 Table 2 ML-KEM-512 k = 2

    it "ITEM-2b η1 = 3":
        # @req REQ-CRYPTO-MLKEM-512-002
        # @capture(bit_table): FIPS 203 Table 2 eta1 row retained for review
        step("Read the ML-KEM-512 eta1 noise parameter from the product")
        expect(ml_kem_eta1_512()).to_equal(3)  # oracle: FIPS 203 §2.3 Table 2 ML-KEM-512 eta1 = 3

    it "ITEM-2c η2 = 2":
        # @req REQ-CRYPTO-MLKEM-512-002
        # @capture(bit_table): FIPS 203 Table 2 eta2 row retained for review
        step("Read the ML-KEM-512 eta2 noise parameter from the product")
        expect(ml_kem_eta2_512()).to_equal(2)  # oracle: FIPS 203 §2.3 Table 2 ML-KEM-512 eta2 = 2

    it "ITEM-2d du = 10":
        # @req REQ-CRYPTO-MLKEM-512-002
        # @capture(bit_table): FIPS 203 Table 2 du row retained for review
        step("Read the ML-KEM-512 du compression parameter from the product")
        expect(ml_kem_du_512()).to_equal(10)  # oracle: FIPS 203 §2.3 Table 2 ML-KEM-512 du = 10

    it "ITEM-2e dv = 4":
        # @req REQ-CRYPTO-MLKEM-512-002
        # @capture(bit_table): FIPS 203 Table 2 dv row retained for review
        step("Read the ML-KEM-512 dv compression parameter from the product")
        expect(ml_kem_dv_512()).to_equal(4)  # oracle: FIPS 203 §2.3 Table 2 ML-KEM-512 dv = 4

    it "ITEM-2f q = 3329 (shared)":
        # @req REQ-CRYPTO-MLKEM-512-002
        # @capture(bit_table): Kyber modulus row retained for review
        step("Read the shared Kyber modulus from the product")
        expect(ml_kem_q()).to_equal(3329)  # oracle: FIPS 203 §2.3 Table 2 module lattice modulus q = 3329

describe "ML-KEM-512 deterministic round-trip (top-level harness)":

    it "ITEM-3 KeyGen + Encaps + Decaps round-trip with d = z = m = 0^32":
        # @req REQ-CRYPTO-MLKEM-512-003
        # @capture(bit_table): round-trip harness verdict flag retained
        step("Record the load-time KeyGen/Encaps/Decaps round-trip verdict")
        # The actual round-trip computation runs at file load via
        # `ml_kem_512_round_trip_check()`. This `it` block records the
        # outcome flag; if loading succeeded with a wrong shared secret,
        # the flag is 0 and this assertion fails.
        expect(ml_kem_512_round_trip_ok).to_equal(1)  # oracle: 1 means the harness matched every shared-secret byte for the zero seed
