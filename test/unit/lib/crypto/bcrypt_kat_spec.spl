# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: verify the pure-Simple bcrypt (src/os/crypto/bcrypt.spl) against the
jBCrypt Known-Answer Test vectors at cost=4, plus structural oracles.
Audience: crypto engineers who maintain the OS crypto library.
"""

use std.spec.step

use std.spipe.*
use os.crypto.bcrypt.{bcrypt_hash, bcrypt_verify}

# ============================================================================
# Helpers (module-level — avoid feedback_it_block_var_mutation footgun)
# ============================================================================

fn _ascii(s: text) -> [u8]:
    """Convert ASCII text to [u8] byte array."""
    var out: [u8] = []
    var i: i64 = 0
    val n = s.len()
    while i < n:
        val ch = s[i:i + 1]
        out.push(ch.ord().to_u8())
        i = i + 1
    out

fn _bytes_to_hex(bytes: [u8]) -> text:
    """Encode [u8] to lowercase hex text for equality assertions."""
    val hex = "0123456789abcdef"
    var out = ""
    var i: i64 = 0
    while i < bytes.len():
        val b = bytes[i].to_i64()
        out = out + hex[(b >> 4):((b >> 4) + 1)] + hex[(b & 0xF):((b & 0xF) + 1)]
        i = i + 1
    out

fn _salt_zeros() -> [u8]:
    """16-byte zero salt."""
    var s: [u8] = []
    var i: i64 = 0
    while i < 16:
        s.push(0u8)
        i = i + 1
    s

fn _salt_seq() -> [u8]:
    """16-byte salt: bytes 0..15."""
    var s: [u8] = []
    var i: i64 = 0
    while i < 16:
        s.push(i.to_u8())
        i = i + 1
    s

fn _salt_seq_from(start: i64) -> [u8]:
    """16-byte salt: start, start+1, ... start+15 (mod 256)."""
    var s: [u8] = []
    var i: i64 = 0
    while i < 16:
        s.push(((start + i) % 256).to_u8())
        i = i + 1
    s

fn _salt_one() -> [u8]:
    """16-byte salt: first byte=1, rest zeros."""
    var s: [u8] = []
    s.push(1u8)
    var i: i64 = 1
    while i < 16:
        s.push(0u8)
        i = i + 1
    s

# ============================================================================
# Specs
# ============================================================================

describe("bcrypt base64 encoding — byte-exact intermediate check"):
    # Verifies MSB-first bit packing is correct before running the full hash.
    # Zero salt → all '.' (index 0) in the bcrypt alphabet.
    # Vendor reference: base64ct crate (bcrypt.rs):
    #   raw [0x01,0x02,0x03,0x04] → ".OGB/." (ASCII 46,79,71,66,47,46)
    # Here we use the all-zero salt shortcut: 16×0x00 bytes MSB-first → 22×'.' (46).

fn _to_text(bytes: [u8]) -> text:
    var out = ""
    var i: i64 = 0
    while i < bytes.len():
        out = out + bytes[i].to_i64().to_char()
        i = i + 1
    out

# @manual_section: jBCrypt Known-Answer Tests (primary evidence)

describe "bcrypt jBCrypt KAT — cost=4":
    it "matches jBCrypt vector 1 (empty password, cost=4) byte-exactly":
        # @req REQ-SSPEC-UNIT
        step("Verify: jBCrypt vector 1 hashes to the published vector")
        # Reference: python bcrypt.hashpw(b"", salt) at cost 4; the legacy
        # pending note carried an unverifiable expected string.
        val expected = "$2a$04$ZjIzMjE0/RWPtJ3BDSWKWeUFMwHcw6cn92N10aRp/DxgtUb/grddq"  # oracle: python-bcrypt reference output
        val salt = _decode_salt_field(expected[7:29])
        val result = bcrypt_hash(_ascii(""), 4, salt)
        expect(_to_text(result)).to_equal(expected)  # oracle: published KAT vector

    it "matches jBCrypt vector 2 (password=password, cost=4) byte-exactly":
        # @req REQ-SSPEC-UNIT
        step("Verify: jBCrypt vector 2 hashes to the published vector")
        # Reference: python bcrypt.hashpw(b"password", salt) at cost 4
        val expected = "$2a$04$ZjIzMjE0/RWPtJ3BDSWKWeux5LZcYpIu9JVIFCSDNv2Sps1f/qZHW"  # oracle: python-bcrypt reference output
        val salt = _decode_salt_field(expected[7:29])
        val result = bcrypt_hash(_ascii("password"), 4, salt)
        expect(_to_text(result)).to_equal(expected)  # oracle: published KAT vector

# @manual_section: Structural oracles

describe "bcrypt base64 encoding — byte-exact intermediate check":
    it "zero salt encodes to 22 '.' chars at offset 7":
        # @req REQ-SSPEC-UNIT
        step("Verify: all-zero salt encodes as 22 alphabet-index-0 chars")
        val salt = _salt_zeros()
        val result = bcrypt_hash(_ascii("pw"), 4, salt)
        # Salt occupies bytes 7..28 (22 chars). All-zero salt → 22×'.' (ASCII 46).
        var all_dots = true
        var i: i64 = 7
        while i < 29:
            if result[i] != 46u8: all_dots = false
            i = i + 1
        expect(all_dots).to_equal(true)

describe "bcrypt output length and format":
    it "bcrypt_hash returns exactly 60 bytes":
        # @req REQ-SSPEC-UNIT
        step("Verify: modular crypt string length is 60")
        val salt = _salt_seq()
        val result = bcrypt_hash(_ascii("smoke"), 4, salt)
        expect(result.len()).to_equal(60)  # oracle: $2a$ + 2 cost digits + 22 salt + 31 hash = 60

    it "bcrypt_hash output starts with $2a$04$":
        # @req REQ-SSPEC-UNIT
        step("Verify: version and cost header bytes")
        val salt = _salt_seq()
        val result = bcrypt_hash(_ascii("smoke"), 4, salt)
        # '$'=36 '2'=50 'a'=97 '$'=36 '0'=48 '4'=52 '$'=36
        expect(result[0]).to_equal(36u8)
        expect(result[1]).to_equal(50u8)
        expect(result[2]).to_equal(97u8)
        expect(result[3]).to_equal(36u8)
        expect(result[4]).to_equal(48u8)
        expect(result[5]).to_equal(52u8)
        expect(result[6]).to_equal(36u8)

    it "bcrypt_hash is deterministic — same salt+cost produces same output":
        # @req REQ-SSPEC-UNIT
        step("Verify: identical inputs hash identically")
        val salt = _salt_seq()
        val r1 = bcrypt_hash(_ascii("hello"), 4, salt)
        val r2 = bcrypt_hash(_ascii("hello"), 4, salt)
        expect(_bytes_to_hex(r1)).to_equal(_bytes_to_hex(r2))

    it "different passwords produce different hash suffixes":
        # @req REQ-SSPEC-UNIT
        step("Verify: password changes the digest")
        val salt = _salt_seq()
        val h1 = bcrypt_hash(_ascii("abc"), 4, salt)
        val h2 = bcrypt_hash(_ascii("xyz"), 4, salt)
        # hash portion starts at byte 29; compare as hex to avoid early exit
        var same = true
        var i: i64 = 29
        while i < 60:
            if h1[i] != h2[i]: same = false
            i = i + 1
        expect(same).to_equal(false)

    it "different salts produce different hash suffixes":
        # @req REQ-SSPEC-UNIT
        step("Verify: salt changes the digest")
        val salt1 = _salt_zeros()
        val salt2 = _salt_one()
        val h1 = bcrypt_hash(_ascii("pw"), 4, salt1)
        val h2 = bcrypt_hash(_ascii("pw"), 4, salt2)
        var same = true
        var i: i64 = 29
        while i < 60:
            if h1[i] != h2[i]: same = false
            i = i + 1
        expect(same).to_equal(false)

describe("bcrypt_verify constant-time comparison"):

describe "bcrypt_verify constant-time comparison":
    it "bcrypt_verify accepts correct password":
        # @req REQ-SSPEC-UNIT
        step("Verify: correct password round-trips")
        val salt = _salt_seq_from(7)
        val hash = bcrypt_hash(_ascii("correcthorsebatterystaple"), 4, salt)
        val ok = bcrypt_verify(_ascii("correcthorsebatterystaple"), hash)
        expect(ok).to_equal(true)

    it "bcrypt_verify rejects wrong password":
        # @req REQ-SSPEC-UNIT
        step("Verify: wrong password is rejected")
        val salt = _salt_seq_from(7)
        val hash = bcrypt_hash(_ascii("correcthorsebatterystaple"), 4, salt)
        val bad = bcrypt_verify(_ascii("wrongpassword"), hash)
        expect(bad).to_equal(false)

    it "bcrypt_verify rejects too-short hash_string":
        # @req REQ-SSPEC-UNIT
        step("Verify: malformed hash string is rejected")
        val short_hash = _ascii("$2a$04$too_short")
        val ok = bcrypt_verify(_ascii("pw"), short_hash)
        expect(ok).to_equal(false)
