        step("Verify: UART LSR register is at offset 5")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val lsr_offset = 5
        expect(lsr_offset).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec
