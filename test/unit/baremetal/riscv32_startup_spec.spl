"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-BAREMETAL behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/baremetal/riscv32_startup_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-UNIT-BAREMETAL-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @platform: baremetal(riscv32)
# RISC-V 32-bit Baremetal Startup Unit Tests
#
# Tests for RV32 startup code: TrapFrame32 structure, memory constants,
# UART configuration, CSR addresses, interrupt handling, and stack setup.

# ============================================================================
# Memory Configuration Constants
# ============================================================================

describe "RV32 Startup - Memory Configuration":
    it "RAM base address is 0x80000000":
        # @req: REQ-UNIT-BAREMETAL-001
        step("Verify: RAM base address is 0x80000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val ram_base = 0x80000000
        expect(ram_base).to_equal(0x80000000)

    it "RAM size is 128MB":
        # @req: REQ-UNIT-BAREMETAL-002
        step("Verify: RAM size is 128MB")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val ram_size = 128 * 1024 * 1024
        expect(ram_size).to_equal(134217728)  # oracle: expected value 134217728 is the behavior asserted by this regression spec

    it "stack size is 64KB per hart":
        # @req: REQ-UNIT-BAREMETAL-003
        step("Verify: stack size is 64KB per hart")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val stack_size = 65536
        expect(stack_size).to_equal(65536)  # oracle: expected value 65536 is the behavior asserted by this regression spec

