"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-BAREMETAL behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/baremetal/riscv/fpga_boot_linux_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-BAREMETAL-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/lib/nogc_async_mut_noalloc/baremetal/riscv/dtb_gen.spl 0%
# @cover src/os/kernel/arch/riscv64/fpga_boot.spl 0%
# @cover src/lib/nogc_async_mut_noalloc/baremetal/riscv/sbi.spl 0%
"""
# FPGA Boot and Linux DTB Specification

**Feature IDs:** rv64-fpga-linux-boot
**Category:** Infrastructure
**Difficulty:** 4/5
**Status:** Draft
**Requirements:** REQ-14, REQ-15
**Research:** doc/01_research/domain/vhdl_backend_linux_rtl.md
**Artifacts:** N/A

## Overview

Tests for the FPGA Linux boot chain: DTB generation for the RV64 SoC
memory map, boot contract validation (a0=hartid, a1=dtb_addr, satp=0),
and SBI interface verification.

Covers:
- AC-6 (FPGA boots, UART outputs SBI banner and Linux boot messages)
- AC-7 (Linux reaches userspace on the FPGA-hosted RV64GC)

## Compiled-Mode Notes

DTB generation and structural checks (magic bytes, node presence,
memory map values) are interpreter-safe. Actual UART output verification
and userspace boot require FPGA hardware or GHDL cosimulation.
"""

use std.spipe.*
use std.nogc_async_mut_noalloc.baremetal.riscv.dtb_gen.{
    Rv64SocMemoryMap,
    rv64_linux_dtb_generate,
    rv64_linux_dtb_to_dts,
    dtb_verify_magic
}


# ============================================================================
# AC-6/AC-7: DTB Generation — FDT Structure (REQ-14)
# ============================================================================

describe "DTB Generation for RV64 SoC":
    it "AC-6: rv64_linux_dtb_generate returns non-empty byte array":
        # @req: REQ-UNIT-BAREMETAL-001
            # @req: REQ-15
            # @req: REQ-14
        step("Verify: AC-6: rv64_linux_dtb_generate returns non-empty byte array")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mem_map = rv64_soc_memory_map_default()
        val dtb = rv64_linux_dtb_generate(mem_map)
        val len = dtb.length()
        expect(len).to_be_greater_than(0)

    it "AC-6: DTB starts with FDT magic bytes 0xD00DFEED":
        # @req: REQ-UNIT-BAREMETAL-002
        step("Verify: AC-6: DTB starts with FDT magic bytes 0xD00DFEED")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mem_map = rv64_soc_memory_map_default()
        val dtb = rv64_linux_dtb_generate(mem_map)
        # FDT magic: big-endian 0xD00DFEED = [0xD0, 0x0D, 0xFE, 0xED]
        val magic_ok = dtb_check_magic(dtb)
        expect(magic_ok).to_equal(true)

    it "AC-6: DTB size is at least 256 bytes (minimal valid FDT)":
        # @req: REQ-UNIT-BAREMETAL-003
        step("Verify: AC-6: DTB size is at least 256 bytes (minimal valid FDT)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mem_map = rv64_soc_memory_map_default()
        val dtb = rv64_linux_dtb_generate(mem_map)
        val len = dtb.length()
        expect(len).to_be_greater_than(256)


