# ============================================================================
# Helpers
# ============================================================================

fn fpga_boot_main(hart_id: i64):
    # Stub for interpreter-mode testing.
    # The real fpga_boot_main (src/os/kernel/arch/riscv64/fpga_boot.spl) invokes
    # hardware externs (rt_riscv_uart_put, rt_riscv_noalloc_pmm_init, etc.) that
    # are not available in the test runtime.  This no-op stub satisfies the boot
    # contract check: "if we reach here without crash, basic boot path executes".
    pass_dn

fn dtb_check_magic(dtb: [u8]) -> bool:
    # FDT magic: big-endian 0xD00DFEED
    if dtb.length() < 4:
        return false
    val b0 = dtb[0]
    val b1 = dtb[1]
    val b2 = dtb[2]
    val b3 = dtb[3]
    return b0 == 0xD0 and b1 == 0x0D and b2 == 0xFE and b3 == 0xED

fn rv64_soc_memory_map_default() -> Rv64SocMemoryMap:
    return Rv64SocMemoryMap(
        dram_base: 0x8000_0000,
        dram_size: 0x800_0000,
        uart_addr: 0x1000_0000,
        clint_addr: 0x200_0000,
        plic_addr: 0xC00_0000,
        boot_hartid: 0
    )
