"""
## Purpose and audience

# ScriptHost Specification

**Feature IDs:** #M15-SCRIPT-HOST
**Category:** Stdlib
**Difficulty:** 3/5
**Status:** Draft
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A
**Artifacts:** N/A

## Overview

Tests for `ScriptHost` in
`src/lib/gc_async_mut/gpu/browser_engine/script/script_host.spl` (REQ-1 / AC-1).
All specs FAIL until that module is implemented.

## Key Behaviors

- `ScriptHost.new()` creates a host ready to execute scripts.
- After creation: `dom_dirty()` is false, `console_buffer().entries()` is empty.
- `execute(source, dom_root)` does not panic on an empty script string.
- `dom_dirty()` starts false, `clear_dirty()` resets it.
- `inject_dom_event(event)` accepts a `BeDomEvent` without crashing when no
  listener is registered.
- `tick(now_micros)` can be called without an execute having run first.

This specification is maintained for compiler and library engineers reviewing UNIT-BROWSER_ENGINE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/browser_engine/script/script_host_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-BROWSER_ENGINE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.script.script_host.{ScriptHost,
    script_host_apply_event_action}
use std.gc_async_mut.gpu.browser_engine.script.network_api.{ScriptStaticFetchDispatch,
    fetch_create_request}
use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode, BeDomEvent}
use std.gc_async_mut.gpu.browser_engine.dom_identity_index.{
    DomDocumentGeneration, DomIdentityIndex, DomNodeRoute,
    dom_identity_index_build
}

# ===========================================================================
# Helper functions
# ===========================================================================

fn _make_host() -> ScriptHost:
    return ScriptHost.new()

fn _make_div_root() -> BeDomNode:
    return BeDomNode.element("div")

fn _make_click_event() -> BeDomEvent:
    return BeDomEvent.create("click", "", true, true)

fn _install_host_document(
    host: ScriptHost, root: BeDomNode
) -> DomIdentityIndex:
    val generation = DomDocumentGeneration.create(1).unwrap()
    val index = dom_identity_index_build(root, generation).unwrap()
    expect(host.install_document_state(root, index, generation)).to_be(true)
    index

# ===========================================================================
# Specs
# ===========================================================================

describe "ScriptHost":
    describe "AC-1: lifecycle — creation":
        it "AC-1: new ScriptHost has dom_dirty false":
            # @req: REQ-UNIT-BROWSER_ENGINE-001
                # @req: REQ-1
            step("Verify: AC-1: new ScriptHost has dom_dirty false")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val host = _make_host()
            val dirty = host.dom_dirty()
            expect(dirty).to_equal(false)

        it "AC-1: new ScriptHost has empty console buffer":
            # @req: REQ-UNIT-BROWSER_ENGINE-002
            step("Verify: AC-1: new ScriptHost has empty console buffer")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val host = _make_host()
            val buf = host.console_buffer()
            val count = buf.entries().len()
            expect(count).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    describe "AC-1: execute — basic script intake":
        it "AC-1: execute with empty string does not crash":
            # @req: REQ-UNIT-BROWSER_ENGINE-003
            step("Verify: AC-1: execute with empty string does not crash")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var host = _make_host()
            val root = _make_div_root()
            val _ = _install_host_document(host, root)
            val dirty = host.dom_dirty()
            expect(dirty).to_equal(false)

        it "AC-1: execute_with_type captures transpiled console output":
            # @req: REQ-UNIT-BROWSER_ENGINE-004
            step("Verify: AC-1: execute_with_type captures transpiled console output")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var host = _make_host()
            val root = _make_div_root()
            host.execute_with_type("console.log(\"hello from js\")\nconsole.warn(\"careful\")\nconsole.error(\"bad\")", "text/javascript", root)
            val entries = host.console_buffer().entries()
            expect(entries.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
            expect(entries[0].level).to_equal("log")
            expect(entries[0].message).to_contain("hello from js")
            expect(entries[1].level).to_equal("warn")
            expect(entries[1].message).to_contain("careful")
            expect(entries[2].level).to_equal("error")
            expect(entries[2].message).to_contain("bad")

    describe "AC-1: dirty flag management":
        it "AC-1: dom_dirty starts false before any tick":
            # @req: REQ-UNIT-BROWSER_ENGINE-005
            step("Verify: AC-1: dom_dirty starts false before any tick")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val host = _make_host()
            val dirty = host.dom_dirty()
            expect(dirty).to_equal(false)

        it "AC-1: clear_dirty leaves dom_dirty false when already false":
            # @req: REQ-UNIT-BROWSER_ENGINE-006
            step("Verify: AC-1: clear_dirty leaves dom_dirty false when already false")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var host = _make_host()
            host.clear_dirty()
            val dirty = host.dom_dirty()
            expect(dirty).to_equal(false)

    describe "AC-1: tick — callable without prior execute":
        it "AC-1: tick with zero timestamp does not crash":
            # @req: REQ-UNIT-BROWSER_ENGINE-007
            step("Verify: AC-1: tick with zero timestamp does not crash")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var host = _make_host()
            host.tick(0)
            val dirty = host.dom_dirty()
            expect(dirty).to_equal(false)

        it "AC-1: tick with large timestamp does not crash":
            # @req: REQ-UNIT-BROWSER_ENGINE-008
            step("Verify: AC-1: tick with large timestamp does not crash")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var host = _make_host()
            host.tick(9999999999)
            val dirty = host.dom_dirty()
            expect(dirty).to_equal(false)

    describe "AC-1: inject_dom_event — no registered listeners":
        it "AC-1: inject_dom_event does not crash when no listeners registered":
            # @req: REQ-UNIT-BROWSER_ENGINE-009
            step("Verify: AC-1: inject_dom_event does not crash when no listeners registered")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var host = _make_host()
            val index = _install_host_document(host, host.dom_root())
            val event = _make_click_event()
            host.inject_dom_event_route(
                DomNodeRoute(
                    generation: index.generation,
                    node_id: host.dom_root().node_id
                ),
                event
            ).unwrap()
            val dirty = host.dom_dirty()
            expect(dirty).to_equal(false)

        it "AC-1: inject_dom_event executes deterministic set-text listener action":
            # @req: REQ-UNIT-BROWSER_ENGINE-010
            step("Verify: AC-1: inject_dom_event executes deterministic set-text listener action")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var host = _make_host()
            var root = _make_div_root()
            root.add_event_listener("click", "set-text:clicked")
            val index = _install_host_document(host, root)
            val event = BeDomEvent.create("click", "", true, true)
            host.inject_dom_event_route(
                DomNodeRoute(
                    generation: index.generation, node_id: root.node_id
                ),
                event
            ).unwrap()
            expect(host.dom_dirty()).to_equal(true)
            expect(host.dom_root().text_content).to_equal("clicked")

        it "AC-1: deterministic listener action sets and removes attributes":
            # @req: REQ-UNIT-BROWSER_ENGINE-011
            step("Verify: AC-1: deterministic listener action sets and removes attributes")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var root = _make_div_root()
            root = script_host_apply_event_action(root, "set-attr:aria-expanded=true")
            expect(root.get_attr("aria-expanded")).to_equal("true")
            root = script_host_apply_event_action(root, "remove-attr:aria-expanded")
            expect(root.has_attr("aria-expanded")).to_equal(false)

        it "AC-1: deterministic listener action updates class tokens":
            # @req: REQ-UNIT-BROWSER_ENGINE-012
            step("Verify: AC-1: deterministic listener action updates class tokens")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var root = _make_div_root()
            root = script_host_apply_event_action(root, "add-class:active")
            expect(root.classes).to_contain("active")
            root = script_host_apply_event_action(root, "add-class:active")
            expect(root.classes.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            root = script_host_apply_event_action(root, "toggle-class:active")
            expect(root.classes.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            root = script_host_apply_event_action(root, "toggle-class:active")
            expect(root.classes).to_contain("active")
            root = script_host_apply_event_action(root, "remove-class:active")
            expect(root.classes.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "AC-1: inject_dom_event executes deterministic attribute and class actions":
            # @req: REQ-UNIT-BROWSER_ENGINE-013
            step("Verify: AC-1: inject_dom_event executes deterministic attribute and class actions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var host = _make_host()
            var root = _make_div_root()
            root.add_event_listener("click", "set-attr:data-clicked=yes")
            root.add_event_listener("click", "add-class:clicked")
            val index = _install_host_document(host, root)
            val event = BeDomEvent.create("click", "", true, true)
            host.inject_dom_event_route(
                DomNodeRoute(
                    generation: index.generation, node_id: root.node_id
                ),
                event
            ).unwrap()
            expect(host.dom_root().get_attr("data-clicked")).to_equal("yes")
            expect(host.dom_root().classes).to_contain("clicked")
            expect(host.dom_dirty()).to_equal(true)

    describe "AC-1: dom_root — returns current root":
        it "AC-1: dom_root after execute returns a BeDomNode":
            # @req: REQ-UNIT-BROWSER_ENGINE-014
            step("Verify: AC-1: dom_root after execute returns a BeDomNode")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var host = _make_host()
            val root = _make_div_root()
            val _ = _install_host_document(host, root)
            val returned_root = host.dom_root()
            expect(returned_root.tag).to_equal("div")

    describe "fetch dispatch bridge":
        it "uses safe fallback when no fetch dispatch is installed":
            # @req: REQ-UNIT-BROWSER_ENGINE-015
            step("Verify: uses safe fallback when no fetch dispatch is installed")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val host = _make_host()
            val resp = host.fetch(fetch_create_request("https://example.test/data", "GET"))
            expect(resp.status).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(resp.ok).to_equal(false)

        it "sends fetch requests through installed dispatch":
            # @req: REQ-UNIT-BROWSER_ENGINE-016
            step("Verify: sends fetch requests through installed dispatch")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var host = _make_host()
            host.set_fetch_dispatch(ScriptStaticFetchDispatch.create(200, "x-host: yes", "body"))
            val resp = host.fetch(fetch_create_request("https://example.test/data", "GET"))
            expect(resp.status).to_equal(200)  # oracle: expected value 200 is the behavior asserted by this regression spec
            expect(resp.ok).to_equal(true)
            expect(resp.headers[0]).to_equal("x-host")
            expect(resp.headers[1]).to_equal("yes")
            expect(resp.body).to_equal("body")
