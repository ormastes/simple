"""
## Purpose and audience

# ConsoleBuffer Specification

**Feature IDs:** #M15-CONSOLE-BUFFER
**Category:** Stdlib
**Difficulty:** 1/5
**Status:** Draft
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A
**Artifacts:** N/A

## Overview

Tests for `ConsoleBuffer` in
`src/lib/gc_async_mut/gpu/browser_engine/script/console_buffer.spl` (REQ-5 / AC-4).
All specs FAIL until that module is implemented.

## Key Behaviors

- `ConsoleBuffer.new()` creates an empty buffer.
- `append(level, message, now_micros)` adds a `ConsoleEntry`.
- `entries()` returns all appended entries in insertion order.
- `clear()` empties the buffer.
- Buffer is bounded at 512 entries; on overflow the oldest entry is
  overwritten (ring semantics).

This specification is maintained for compiler and library engineers reviewing UNIT-BROWSER_ENGINE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/browser_engine/script/console_buffer_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-BROWSER_ENGINE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.script.console_buffer.{
    ConsoleBuffer,
    ConsoleEntry
}

# ===========================================================================
# Helper functions
# ===========================================================================

fn _make_empty_buffer() -> ConsoleBuffer:
    return ConsoleBuffer.new()

fn _buffer_with_one_log() -> ConsoleBuffer:
    var buf = ConsoleBuffer.new()
    buf.append("log", "hello world", 1000)
    return buf

fn _buffer_with_three_levels() -> ConsoleBuffer:
    var buf = ConsoleBuffer.new()
    buf.append("log", "info message", 1000)
    buf.append("warn", "warning message", 2000)
    buf.append("error", "error message", 3000)
    return buf

fn _first_entry_message(buf: ConsoleBuffer) -> text:
    val entries = buf.entries()
    return entries[0].message

fn _first_entry_level(buf: ConsoleBuffer) -> text:
    val entries = buf.entries()
    return entries[0].level

fn _entry_count(buf: ConsoleBuffer) -> i32:
    return buf.entries().len()

fn _buffer_filled_to(n: i32) -> ConsoleBuffer:
    var buf = ConsoleBuffer.new()
    var i = 0
    while i < n:
        buf.append("log", "msg", i)
        i = i + 1
    return buf

# ===========================================================================
# Specs
# ===========================================================================

describe "ConsoleBuffer":
    describe "AC-4: creation":
        it "AC-4: new buffer starts with zero entries":
            # @req: REQ-UNIT-BROWSER_ENGINE-001
                # @req: REQ-5
            step("Verify: AC-4: new buffer starts with zero entries")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val buf = _make_empty_buffer()
            val count = _entry_count(buf)
            expect(count).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    describe "AC-4: append and read":
        it "AC-4: appended log message is stored in entries":
            # @req: REQ-UNIT-BROWSER_ENGINE-002
            step("Verify: AC-4: appended log message is stored in entries")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val buf = _buffer_with_one_log()
            val msg = _first_entry_message(buf)
            expect(msg).to_equal("hello world")

        it "AC-4: appended level is stored in entries":
            # @req: REQ-UNIT-BROWSER_ENGINE-003
            step("Verify: AC-4: appended level is stored in entries")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val buf = _buffer_with_one_log()
            val lvl = _first_entry_level(buf)
            expect(lvl).to_equal("log")

        it "AC-4: entries count grows with each append":
            # @req: REQ-UNIT-BROWSER_ENGINE-004
            step("Verify: AC-4: entries count grows with each append")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val buf = _buffer_with_three_levels()
            val count = _entry_count(buf)
            expect(count).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

        it "AC-4: entries are in insertion order — first is log level":
            # @req: REQ-UNIT-BROWSER_ENGINE-005
            step("Verify: AC-4: entries are in insertion order — first is log level")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val buf = _buffer_with_three_levels()
            val entries = buf.entries()
            expect(entries[0].level).to_equal("log")

        it "AC-4: entries are in insertion order — second is warn level":
            # @req: REQ-UNIT-BROWSER_ENGINE-006
            step("Verify: AC-4: entries are in insertion order — second is warn level")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val buf = _buffer_with_three_levels()
            val entries = buf.entries()
            expect(entries[1].level).to_equal("warn")

        it "AC-4: entries are in insertion order — third is error level":
            # @req: REQ-UNIT-BROWSER_ENGINE-007
            step("Verify: AC-4: entries are in insertion order — third is error level")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val buf = _buffer_with_three_levels()
            val entries = buf.entries()
            expect(entries[2].level).to_equal("error")

        it "AC-4: timestamp_micros is stored in entry":
            # @req: REQ-UNIT-BROWSER_ENGINE-008
            step("Verify: AC-4: timestamp_micros is stored in entry")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val buf = _buffer_with_one_log()
            val entries = buf.entries()
            expect(entries[0].timestamp_micros).to_equal(1000)  # oracle: expected value 1000 is the behavior asserted by this regression spec

    describe "AC-4: clear":
        it "AC-4: clear removes all entries":
            # @req: REQ-UNIT-BROWSER_ENGINE-009
            step("Verify: AC-4: clear removes all entries")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var buf = _buffer_with_three_levels()
            buf.clear()
            val count = _entry_count(buf)
            expect(count).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    describe "AC-4: ring overflow at 512":
        it "AC-4: buffer accepts exactly 512 entries without loss":
            # @req: REQ-UNIT-BROWSER_ENGINE-010
            step("Verify: AC-4: buffer accepts exactly 512 entries without loss")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val buf = _buffer_filled_to(512)
            val count = _entry_count(buf)
            expect(count).to_equal(512)  # oracle: expected value 512 is the behavior asserted by this regression spec

        it "AC-4: buffer stays at 512 entries after 513th append":
            # @req: REQ-UNIT-BROWSER_ENGINE-011
            step("Verify: AC-4: buffer stays at 512 entries after 513th append")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val buf = _buffer_filled_to(513)
            val count = _entry_count(buf)
            expect(count).to_equal(512)  # oracle: expected value 512 is the behavior asserted by this regression spec
