"""
## Purpose and audience
Verifies the simple script behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

use std.spec.*
use std.gc_async_mut.gpu.browser_engine.script.simple_script.{SimpleScriptExecutor}
use std.gc_async_mut.gpu.browser_engine.script.event_loop.{EventLoop}
use std.gc_async_mut.gpu.browser_engine.script.console_buffer.{ConsoleBuffer}
use std.gc_async_mut.gpu.browser_engine.script.network_api.{ScriptStaticFetchDispatch,
    fetch_create_request}
use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode, BeDomEvent}
use std.gc_async_mut.gpu.browser_engine.dom_identity_index.{
    DomDocumentGeneration, DomIdentityIndex, DomNodeRoute,
    dom_identity_index_build
}

fn _executor() -> SimpleScriptExecutor:
    SimpleScriptExecutor.new(EventLoop.new(), ConsoleBuffer.new())

fn _install_executor_document(
    exec: SimpleScriptExecutor, root: BeDomNode
) -> DomIdentityIndex:
    val generation = DomDocumentGeneration.create(1).unwrap()
    val index = dom_identity_index_build(root, generation).unwrap()
    expect(exec.install_document_state(root, index, generation)).to_be(true)
    index

# @req: REQ-SCRIPT-SimpleScript-001
describe "SimpleScriptExecutor":
    it "marks non-empty source execution as dirty and stores the DOM root":
        # @req: REQ-SCRIPT-SimpleScript-001
        step("Verify: marks non-empty source execution as dirty and stores the DOM root")
        var exec = _executor()
        val root = BeDomNode.element("main")
        val _ = _install_executor_document(exec, root)
        exec.execute("console_log(\"hello\")")
        expect(exec.dom_dirty()).to_equal(true)
        expect(exec.dom_root().tag).to_equal("main")

    it "drains timer and raf callback slots on tick":
        # @req: REQ-SCRIPT-SimpleScript-001
        step("Verify: drains timer and raf callback slots on tick")
        var event_loop = EventLoop.new()
        event_loop.schedule_timer(7, 10, 0)
        event_loop.schedule_raf(8, 0, 0)
        var exec = SimpleScriptExecutor.new(event_loop, ConsoleBuffer.new())
        exec.tick(16000)
        expect(exec.dom_dirty()).to_equal(true)
        expect(exec.event_loop().pending_timer_count()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(exec.event_loop().pending_raf_count()).to_equal(0)  # oracle: value fixed by the spec contract

    it "runs deterministic listener actions during DOM event injection":
        # @req: REQ-SCRIPT-SimpleScript-001
        step("Verify: runs deterministic listener actions during DOM event injection")
        var exec = _executor()
        var root = BeDomNode.element("div")
        root.add_event_listener("click", "set-attr:data-clicked=yes")
        root.add_event_listener("click", "add-class:clicked")
        val index = _install_executor_document(exec, root)
        val event = BeDomEvent.create("click", "", true, true)
        exec.inject_dom_event_route(
            DomNodeRoute(
                generation: index.generation, node_id: root.node_id
            ),
            event
        ).unwrap()
        expect(exec.dom_dirty()).to_equal(true)
        expect(exec.dom_root().get_attr("data-clicked")).to_equal("yes")
        expect(exec.dom_root().classes).to_contain("clicked")

    it "uses safe fetch fallback without a dispatch":
        # @req: REQ-SCRIPT-SimpleScript-001
        step("Verify: uses safe fetch fallback without a dispatch")
        val exec = _executor()
        val resp = exec.fetch(fetch_create_request("https://example.test/data", "GET"))
        expect(resp.status).to_equal(0)  # oracle: value fixed by the spec contract
        expect(resp.ok).to_equal(false)

    it "sends fetch requests through installed dispatch":
        # @req: REQ-SCRIPT-SimpleScript-001
        step("Verify: sends fetch requests through installed dispatch")
        var exec = _executor()
        exec.set_fetch_dispatch(ScriptStaticFetchDispatch.create(201, "x-exec: yes", "created"))
        val resp = exec.fetch(fetch_create_request("https://example.test/data", "POST"))
        expect(resp.status).to_equal(201)  # oracle: value fixed by the spec contract
        expect(resp.ok).to_equal(true)
        expect(resp.headers[0]).to_equal("x-exec")
        expect(resp.headers[1]).to_equal("yes")
        expect(resp.body).to_equal("created")
