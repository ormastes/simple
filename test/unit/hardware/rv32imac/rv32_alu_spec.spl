"""
## Purpose and audience
Purpose: Prove that ALU Arithmetic.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-HARDWARE-RV32IMAC-001 — stable requirement identity for this spec.

"""
# RV32 ALU Unit Tests

**Feature IDs:** #RV32-ALU-001
**Category:** Hardware
**Difficulty:** 2/5
**Status:** In Progress

## Overview

Unit tests for ALU operations with edge cases.
"""

import std.spec

use hardware.rv32imac.core.rv32_execute.alu_execute
use hardware.rv32imac.pkg.rv32_types_pkg.*

use std.spec.step

describe "ALU Arithmetic":
    """
    ## Arithmetic Operations

    Tests ADD, SUB with overflow and edge cases.
    """

    it "ADD: 0 + 0 = 0":
        step("Verify: ADD: 0 + 0 = 0")
        # @req: REQ-HARDWARE-RV32IMAC-001
        expect(alu_execute(AluOp.Add, 0, 0)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "ADD: max + 1 wraps to 0":
        step("Verify: ADD: max + 1 wraps to 0")
        expect(alu_execute(AluOp.Add, 0xFFFFFFFF, 1)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "SUB: 0 - 1 = 0xFFFFFFFF":
        step("Verify: SUB: 0 - 1 = 0xFFFFFFFF")
        expect(alu_execute(AluOp.Sub, 0, 1)).to_equal(0xFFFFFFFF)

    it "PASS_B returns second operand":
        step("Verify: PASS_B returns second operand")
        expect(alu_execute(AluOp.PassB, 42, 99)).to_equal(99)  # oracle: 99 — named expected value from the requirement

describe "ALU Logic":
    """
    ## Bitwise Logic Operations
    """

    it "AND with all ones":
        step("Verify: AND with all ones")
        expect(alu_execute(AluOp.And, 0xDEADBEEF, 0xFFFFFFFF)).to_equal(0xDEADBEEF)

    it "OR with zero":
        step("Verify: OR with zero")
        expect(alu_execute(AluOp.Or, 0xDEADBEEF, 0)).to_equal(0xDEADBEEF)

    it "XOR with self":
        step("Verify: XOR with self")
        expect(alu_execute(AluOp.Xor, 0xDEADBEEF, 0xDEADBEEF)).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "ALU Shifts":
    """
    ## Shift Operations
    """

    it "SLL by 0":
        step("Verify: SLL by 0")
        expect(alu_execute(AluOp.Sll, 42, 0)).to_equal(42)  # oracle: 42 — named expected value from the requirement

    it "SLL by 31":
        step("Verify: SLL by 31")
        expect(alu_execute(AluOp.Sll, 1, 31)).to_equal(0x80000000)

    it "SRL by 0":
        step("Verify: SRL by 0")
        expect(alu_execute(AluOp.Srl, 42, 0)).to_equal(42)  # oracle: 42 — named expected value from the requirement

    it "SRL uses only lower 5 bits of shamt":
        step("Verify: SRL uses only lower 5 bits of shamt")
        expect(alu_execute(AluOp.Srl, 0x80000000, 32)).to_equal(0x80000000)

describe "ALU Comparisons":
    """
    ## Set-Less-Than Operations
    """

    it "SLT: equal values":
        step("Verify: SLT: equal values")
        expect(alu_execute(AluOp.Slt, 5, 5)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "SLT: negative < positive (signed)":
        step("Verify: SLT: negative < positive (signed)")
        expect(alu_execute(AluOp.Slt, 0x80000000, 0)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "SLTU: 0 < 1":
        step("Verify: SLTU: 0 < 1")
        expect(alu_execute(AluOp.Sltu, 0, 1)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "SLTU: max unsigned > 0":
        step("Verify: SLTU: max unsigned > 0")
        expect(alu_execute(AluOp.Sltu, 0xFFFFFFFF, 0)).to_equal(0)  # oracle: 0 — named expected value from the requirement
