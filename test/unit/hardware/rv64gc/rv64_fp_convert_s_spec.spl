"""
## Purpose and audience
Purpose: Prove that FCVT.W.S (float → i32).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-HARDWARE-RV64GC-001 — stable requirement identity for this spec.

"""
# RV64 Single-Precision FP Conversion Tests

**Feature IDs:** #RV64-FP-CONVERT-S-001
**Category:** Hardware
**Difficulty:** 3/5
**Status:** Draft

## Overview

Unit tests for fcvt, fmv single-precision conversions.
"""

# tag: only-compiled

import std.spec

use hardware.rv64gc.ext.rv64_float.{fcvt_w_s, fcvt_s_w, fcvt_l_s, fcvt_s_l, fcvt_wu_s, fcvt_s_wu, fcvt_lu_s, fcvt_s_lu, fmv_x_w, fmv_w_x}
use hardware.rv64gc.pkg.rv64_fp_types_pkg.*

val ONE_S: i64 = 0x3F800000
val NEG_ONE_S: i64 = 0xBF800000
val POS_INF_S: i64 = 0x7F800000
val QNAN_S: i64 = 0x7FC00000

use std.spec.step

describe "FCVT.W.S (float → i32)":
    it "1.0 → 1":
        step("Verify: 1.0 → 1")
        # @req: REQ-HARDWARE-RV64GC-001
        val r = fcvt_w_s(ONE_S, RoundMode.RTZ)
        expect(r.value).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "-1.0 → -1":
        step("Verify: -1.0 → -1")
        val r = fcvt_w_s(NEG_ONE_S, RoundMode.RTZ)
        expect(r.value).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "+inf → INT32_MAX":
        step("Verify: +inf → INT32_MAX")
        val r = fcvt_w_s(POS_INF_S, RoundMode.RTZ)
        expect(r.value).to_equal(0x7FFFFFFF)

describe "FCVT.S.W (i32 → float)":
    it "1 → 1.0":
        step("Verify: 1 → 1.0")
        val r = fcvt_s_w(1, RoundMode.RNE)
        expect(r.value).to_equal(ONE_S)

    it "-1 → -1.0":
        step("Verify: -1 → -1.0")
        val r = fcvt_s_w(-1, RoundMode.RNE)
        expect(r.value).to_equal(NEG_ONE_S)

describe "FCVT.L.S (float → i64)":
    it "1.0 → 1":
        step("Verify: 1.0 → 1")
        val r = fcvt_l_s(ONE_S, RoundMode.RTZ)
        expect(r.value).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "+inf → INT64_MAX":
        step("Verify: +inf → INT64_MAX")
        val r = fcvt_l_s(POS_INF_S, RoundMode.RTZ)
        expect(r.value).to_equal(0x7FFFFFFFFFFFFFFF)

    it "NaN → INT64_MAX":
        step("Verify: NaN → INT64_MAX")
        val r = fcvt_l_s(QNAN_S, RoundMode.RTZ)
        expect(r.value).to_equal(0x7FFFFFFFFFFFFFFF)

describe "FCVT.S.L (i64 → float)":
    it "1 → 1.0":
        step("Verify: 1 → 1.0")
        val r = fcvt_s_l(1, RoundMode.RNE)
        expect(r.value).to_equal(ONE_S)

    it "large value may be inexact":
        step("Verify: large value may be inexact")
        val r = fcvt_s_l(0x7FFFFFFFFFFFFFFF, RoundMode.RNE)
        expect((r.flags and 0x01) != 0).to_equal(true)

describe "FCVT.WU.S (float → u32)":
    it "1.0 → 1":
        step("Verify: 1.0 → 1")
        val r = fcvt_wu_s(ONE_S, RoundMode.RTZ)
        expect(r.value).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "-1.0 → 0 (clamp)":
        step("Verify: -1.0 → 0 (clamp)")
        val r = fcvt_wu_s(NEG_ONE_S, RoundMode.RTZ)
        expect(r.value).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "FCVT.S.WU (u32 → float)":
    it "1 → 1.0":
        step("Verify: 1 → 1.0")
        val r = fcvt_s_wu(1, RoundMode.RNE)
        expect(r.value).to_equal(ONE_S)

    it "0xFFFFFFFF → large float":
        step("Verify: 0xFFFFFFFF → large float")
        val r = fcvt_s_wu(0xFFFFFFFF, RoundMode.RNE)
        expect(r.value).to_be_greater_than(0)

describe "FCVT.LU.S / FCVT.S.LU":
    it "FCVT.LU.S: 1.0 → 1":
        step("Verify: FCVT.LU.S: 1.0 → 1")
        val r = fcvt_lu_s(ONE_S, RoundMode.RTZ)
        expect(r.value).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "FCVT.S.LU: 1 → 1.0":
        step("Verify: FCVT.S.LU: 1 → 1.0")
        val r = fcvt_s_lu(1, RoundMode.RNE)
        expect(r.value).to_equal(ONE_S)

describe "FMV.X.W / FMV.W.X (bit copy)":
    it "FMV.X.W: copy float bits to integer (sign-extended)":
        step("Verify: FMV.X.W: copy float bits to integer (sign-extended)")
        val result = fmv_x_w(NEG_ONE_S)
        expect(result).to_equal(0xFFFFFFFFBF800000)

    it "FMV.W.X: copy integer bits to float register":
        step("Verify: FMV.W.X: copy integer bits to float register")
        val result = fmv_w_x(ONE_S)
        expect(result).to_equal(ONE_S)
