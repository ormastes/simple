"""
## Purpose and audience
Purpose: Prove that MUL (64-bit).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-HARDWARE-RV64GC-001 — stable requirement identity for this spec.

"""
# RV64 Multiply/Divide Unit Tests

**Feature IDs:** #RV64-MULDIV-001
**Category:** Hardware
**Difficulty:** 2/5
**Status:** Draft

## Overview

Unit tests for 64-bit multiply and divide operations (RV64M extension).
"""

import std.spec

use hardware.rv64gc.ext.rv64_muldiv.muldiv_execute
use hardware.rv64gc.pkg.rv64_types_pkg.*

use std.spec.step

describe "MUL (64-bit)":
    it "MUL: 3 * 4 = 12":
        step("Verify: MUL: 3 * 4 = 12")
        # @req: REQ-HARDWARE-RV64GC-001
        expect(muldiv_execute(MulDivOp.Mul, 3, 4)).to_equal(12)  # oracle: 12 — named expected value from the requirement

    it "MUL: large values (lower 64 bits)":
        step("Verify: MUL: large values (lower 64 bits)")
        expect(muldiv_execute(MulDivOp.Mul, 0x100000000, 2)).to_equal(0x200000000)

    it "MUL: negative * positive":
        step("Verify: MUL: negative * positive")
        expect(muldiv_execute(MulDivOp.Mul, -3, 4)).to_equal(-12)  # oracle: -12 — named expected value from the requirement

    it "MUL: negative * negative":
        step("Verify: MUL: negative * negative")
        expect(muldiv_execute(MulDivOp.Mul, -3, -4)).to_equal(12)  # oracle: 12 — named expected value from the requirement

describe "MULH (signed upper 64 bits)":
    it "MULH: small values produce 0 upper bits":
        step("Verify: MULH: small values produce 0 upper bits")
        expect(muldiv_execute(MulDivOp.Mulh, 3, 4)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "MULH: large positive * positive":
        step("Verify: MULH: large positive * positive")
        expect(muldiv_execute(MulDivOp.Mulh, 0x7FFFFFFFFFFFFFFF, 2)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "MULH: -1 * -1 = upper bits 0":
        step("Verify: MULH: -1 * -1 = upper bits 0")
        expect(muldiv_execute(MulDivOp.Mulh, -1, -1)).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "MULHSU (signed * unsigned upper bits)":
    it "MULHSU: positive * positive same as MULHU":
        step("Verify: MULHSU: positive * positive same as MULHU")
        expect(muldiv_execute(MulDivOp.Mulhsu, 3, 4)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "MULHSU: negative * unsigned":
        step("Verify: MULHSU: negative * unsigned")
        val result = muldiv_execute(MulDivOp.Mulhsu, -1, 1)
        expect(result).to_equal(-1)  # oracle: -1 — named expected value from the requirement

describe "MULHU (unsigned upper 64 bits)":
    it "MULHU: small values produce 0":
        step("Verify: MULHU: small values produce 0")
        expect(muldiv_execute(MulDivOp.Mulhu, 3, 4)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "MULHU: max * 2":
        step("Verify: MULHU: max * 2")
        val result = muldiv_execute(MulDivOp.Mulhu, 0xFFFFFFFFFFFFFFFF, 2)
        expect(result).to_equal(1)  # oracle: 1 — named expected value from the requirement

describe "DIV (signed)":
    it "DIV: 20 / 4 = 5":
        step("Verify: DIV: 20 / 4 = 5")
        expect(muldiv_execute(MulDivOp.Div, 20, 4)).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "DIV: -20 / 4 = -5":
        step("Verify: DIV: -20 / 4 = -5")
        expect(muldiv_execute(MulDivOp.Div, -20, 4)).to_equal(-5)  # oracle: -5 — named expected value from the requirement

    it "DIV: divide by zero returns -1":
        step("Verify: DIV: divide by zero returns -1")
        expect(muldiv_execute(MulDivOp.Div, 20, 0)).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "DIV: overflow MIN_I64 / -1 = MIN_I64":
        step("Verify: DIV: overflow MIN_I64 / -1 = MIN_I64")
        expect(muldiv_execute(MulDivOp.Div, 0x8000000000000000, -1)).to_equal(0x8000000000000000)

describe "DIVU (unsigned)":
    it "DIVU: 20 / 4 = 5":
        step("Verify: DIVU: 20 / 4 = 5")
        expect(muldiv_execute(MulDivOp.Divu, 20, 4)).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "DIVU: divide by zero returns MAX_U64":
        step("Verify: DIVU: divide by zero returns MAX_U64")
        expect(muldiv_execute(MulDivOp.Divu, 20, 0)).to_equal(0xFFFFFFFFFFFFFFFF)

    it "DIVU: large unsigned values":
        step("Verify: DIVU: large unsigned values")
        expect(muldiv_execute(MulDivOp.Divu, 0xFFFFFFFFFFFFFFFF, 2)).to_equal(0x7FFFFFFFFFFFFFFF)

describe "REM (signed)":
    it "REM: 20 % 3 = 2":
        step("Verify: REM: 20 % 3 = 2")
        expect(muldiv_execute(MulDivOp.Rem, 20, 3)).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "REM: -20 % 3 = -2 (sign follows dividend)":
        step("Verify: REM: -20 % 3 = -2 (sign follows dividend)")
        expect(muldiv_execute(MulDivOp.Rem, -20, 3)).to_equal(-2)  # oracle: -2 — named expected value from the requirement

    it "REM: divide by zero returns dividend":
        step("Verify: REM: divide by zero returns dividend")
        expect(muldiv_execute(MulDivOp.Rem, 20, 0)).to_equal(20)  # oracle: 20 — named expected value from the requirement

describe "REMU (unsigned)":
    it "REMU: 20 % 3 = 2":
        step("Verify: REMU: 20 % 3 = 2")
        expect(muldiv_execute(MulDivOp.Remu, 20, 3)).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "REMU: divide by zero returns dividend":
        step("Verify: REMU: divide by zero returns dividend")
        expect(muldiv_execute(MulDivOp.Remu, 20, 0)).to_equal(20)  # oracle: 20 — named expected value from the requirement
