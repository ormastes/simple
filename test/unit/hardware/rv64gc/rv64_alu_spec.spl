"""
## Purpose and audience
Purpose: Prove that ALU Arithmetic.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-HARDWARE-RV64GC-001 — stable requirement identity for this spec.

"""
# RV64 ALU Unit Tests

**Feature IDs:** #RV64-ALU-001
**Category:** Hardware
**Difficulty:** 2/5
**Status:** Draft

## Overview

Unit tests for 64-bit ALU operations with edge cases.
"""

import std.spec

use hardware.rv64gc.core.rv64_execute.alu_execute
use hardware.rv64gc.pkg.rv64_types_pkg.*

use std.spec.step

describe "ALU Arithmetic":
    """
    ## Arithmetic Operations

    Tests ADD, SUB with 64-bit overflow and edge cases.
    """

    it "ADD: 0 + 0 = 0":
        step("Verify: ADD: 0 + 0 = 0")
        # @req: REQ-HARDWARE-RV64GC-001
        expect(alu_execute(AluOp.Add, 0, 0)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "ADD: basic addition":
        step("Verify: ADD: basic addition")
        expect(alu_execute(AluOp.Add, 10, 20)).to_equal(30)  # oracle: 30 — named expected value from the requirement

    it "ADD: max + 1 wraps to min (signed overflow)":
        step("Verify: ADD: max + 1 wraps to min (signed overflow)")
        expect(alu_execute(AluOp.Add, 0x7FFFFFFFFFFFFFFF, 1)).to_equal(0x8000000000000000)

    it "ADD: unsigned max + 1 wraps to 0":
        step("Verify: ADD: unsigned max + 1 wraps to 0")
        expect(alu_execute(AluOp.Add, 0xFFFFFFFFFFFFFFFF, 1)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "SUB: 0 - 1 = -1 (all bits set)":
        step("Verify: SUB: 0 - 1 = -1 (all bits set)")
        expect(alu_execute(AluOp.Sub, 0, 1)).to_equal(0xFFFFFFFFFFFFFFFF)

    it "SUB: basic subtraction":
        step("Verify: SUB: basic subtraction")
        expect(alu_execute(AluOp.Sub, 50, 20)).to_equal(30)  # oracle: 30 — named expected value from the requirement

    it "PASS_B returns second operand":
        step("Verify: PASS_B returns second operand")
        expect(alu_execute(AluOp.PassB, 42, 99)).to_equal(99)  # oracle: 99 — named expected value from the requirement

describe "ALU Logic":
    """
    ## Bitwise Logic Operations (64-bit)
    """

    it "AND with all ones":
        step("Verify: AND with all ones")
        expect(alu_execute(AluOp.And, 0xDEADBEEFCAFEBABE, 0xFFFFFFFFFFFFFFFF)).to_equal(0xDEADBEEFCAFEBABE)

    it "AND masks upper 32 bits":
        step("Verify: AND masks upper 32 bits")
        expect(alu_execute(AluOp.And, 0xFFFFFFFF00000000, 0x00000000FFFFFFFF)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "OR with zero":
        step("Verify: OR with zero")
        expect(alu_execute(AluOp.Or, 0xDEADBEEFCAFEBABE, 0)).to_equal(0xDEADBEEFCAFEBABE)

    it "OR combines upper and lower halves":
        step("Verify: OR combines upper and lower halves")
        expect(alu_execute(AluOp.Or, 0xFFFF000000000000, 0x000000000000FFFF)).to_equal(0xFFFF00000000FFFF)

    it "XOR with self is zero":
        step("Verify: XOR with self is zero")
        expect(alu_execute(AluOp.Xor, 0xDEADBEEFCAFEBABE, 0xDEADBEEFCAFEBABE)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "XOR flips all bits":
        step("Verify: XOR flips all bits")
        expect(alu_execute(AluOp.Xor, 0xAAAAAAAAAAAAAAAA, 0xFFFFFFFFFFFFFFFF)).to_equal(0x5555555555555555)

describe "ALU Shifts (64-bit)":
    """
    ## Shift Operations

    SLL/SRL/SRA use only lower 6 bits of shift amount (0-63).
    """

    it "SLL by 0":
        step("Verify: SLL by 0")
        expect(alu_execute(AluOp.Sll, 42, 0)).to_equal(42)  # oracle: 42 — named expected value from the requirement

    it "SLL by 32 shifts into upper half":
        step("Verify: SLL by 32 shifts into upper half")
        expect(alu_execute(AluOp.Sll, 1, 32)).to_equal(0x100000000)

    it "SLL by 63":
        step("Verify: SLL by 63")
        expect(alu_execute(AluOp.Sll, 1, 63)).to_equal(0x8000000000000000)

    it "SLL uses only lower 6 bits of shamt":
        step("Verify: SLL uses only lower 6 bits of shamt")
        expect(alu_execute(AluOp.Sll, 1, 64)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "SRL by 0":
        step("Verify: SRL by 0")
        expect(alu_execute(AluOp.Srl, 42, 0)).to_equal(42)  # oracle: 42 — named expected value from the requirement

    it "SRL by 32 shifts from upper half":
        step("Verify: SRL by 32 shifts from upper half")
        expect(alu_execute(AluOp.Srl, 0x100000000, 32)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "SRL does not sign-extend":
        step("Verify: SRL does not sign-extend")
        expect(alu_execute(AluOp.Srl, 0x8000000000000000, 63)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "SRA preserves sign bit":
        step("Verify: SRA preserves sign bit")
        expect(alu_execute(AluOp.Sra, 0x8000000000000000, 63)).to_equal(0xFFFFFFFFFFFFFFFF)

    it "SRA positive number":
        step("Verify: SRA positive number")
        expect(alu_execute(AluOp.Sra, 0x7FFFFFFFFFFFFFFF, 1)).to_equal(0x3FFFFFFFFFFFFFFF)

describe "ALU Comparisons (64-bit)":
    """
    ## Set-Less-Than Operations

    SLT: signed comparison. SLTU: unsigned comparison.
    """

    it "SLT: equal values":
        step("Verify: SLT: equal values")
        expect(alu_execute(AluOp.Slt, 5, 5)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "SLT: negative < positive (signed)":
        step("Verify: SLT: negative < positive (signed)")
        expect(alu_execute(AluOp.Slt, 0x8000000000000000, 0)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "SLT: positive < negative is false (signed)":
        step("Verify: SLT: positive < negative is false (signed)")
        expect(alu_execute(AluOp.Slt, 0, 0x8000000000000000)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "SLT: -1 < 0 (signed)":
        step("Verify: SLT: -1 < 0 (signed)")
        expect(alu_execute(AluOp.Slt, 0xFFFFFFFFFFFFFFFF, 0)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "SLTU: 0 < 1":
        step("Verify: SLTU: 0 < 1")
        expect(alu_execute(AluOp.Sltu, 0, 1)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "SLTU: 0x8000000000000000 > 0 (unsigned)":
        step("Verify: SLTU: 0x8000000000000000 > 0 (unsigned)")
        expect(alu_execute(AluOp.Sltu, 0, 0x8000000000000000)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "SLTU: max unsigned > 0":
        step("Verify: SLTU: max unsigned > 0")
        expect(alu_execute(AluOp.Sltu, 0, 0xFFFFFFFFFFFFFFFF)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "SLTU: equal values":
        step("Verify: SLTU: equal values")
        expect(alu_execute(AluOp.Sltu, 42, 42)).to_equal(0)  # oracle: 0 — named expected value from the requirement
