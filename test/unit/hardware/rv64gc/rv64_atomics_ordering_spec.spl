## Overview

Unit tests for memory ordering semantics: acquire/release bits, FENCE.

This specification is maintained for compiler and library engineers reviewing UNIT-HARDWARE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/hardware/rv64gc/rv64_atomics_ordering_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-HARDWARE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# tag: only-compiled

use std.spec.step

import std.spec

use hardware.rv64gc.ext.rv64_atomics.{decode_amo_ordering, AmoOrdering}
use std.spec.{step}

describe "Acquire/Release Bits":
    # @manual scenario evidence
    """
    ## Memory Ordering from aq/rl Fields

    Bits 26 (aq) and 25 (rl) in atomic instruction encoding.
    """

    it "no ordering (aq=0, rl=0)":
        val ord = decode_amo_ordering(0, 0)
        expect(ord == AmoOrdering.Relaxed).to_equal(true)

    it "acquire (aq=1, rl=0)":
        val ord = decode_amo_ordering(1, 0)
        expect(ord == AmoOrdering.Acquire).to_equal(true)

    it "release (aq=0, rl=1)":
        val ord = decode_amo_ordering(0, 1)
        expect(ord == AmoOrdering.Release).to_equal(true)

    it "sequentially consistent (aq=1, rl=1)":
        val ord = decode_amo_ordering(1, 1)
        expect(ord == AmoOrdering.SeqCst).to_equal(true)

describe "FENCE Instruction":
    """
    ## FENCE Ordering

    FENCE pred, succ where pred/succ are IORW bits.
    """

    it "FENCE rw, rw orders all memory ops":
        # pred=0x3 (rw), succ=0x3 (rw)
        val pred = 0x3
        val succ = 0x3
        expect(pred and 0x3).to_equal(0x3)
        expect(succ and 0x3).to_equal(0x3)

    it "FENCE.TSO: acquire+release for loads/stores":
        # FENCE.TSO = FENCE rw, rw with fm=1000
        val fm = 8
        expect(fm).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

    it "FENCE w, r orders store-to-load":
        val pred = 0x1  # w
        val succ = 0x2  # r
        expect(pred and 0x1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(succ and 0x2).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    it "FENCE i instruction fence (FENCE.I)":
        # FENCE.I flushes instruction cache
        val is_fence_i = true
        expect(is_fence_i).to_equal(true)
