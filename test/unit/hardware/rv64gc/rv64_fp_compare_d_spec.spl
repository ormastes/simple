"""
## Purpose and audience
Purpose: Prove that FEQ.D.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-HARDWARE-RV64GC-001 — stable requirement identity for this spec.

"""
# RV64 Double-Precision FP Comparison Tests

**Feature IDs:** #RV64-FP-COMPARE-D-001
**Category:** Hardware
**Difficulty:** 3/5
**Status:** Draft

## Overview

Unit tests for feq.d, flt.d, fle.d, fmin.d, fmax.d, fclass.d.
"""

# tag: only-compiled

import std.spec

use hardware.rv64gc.ext.rv64_double.{fp_eq_d, fp_lt_d, fp_le_d, fp_min_d, fp_max_d, fp_class_d}

val POS_ZERO_D: i64 = 0x0000000000000000
val NEG_ZERO_D: i64 = 0x8000000000000000
val POS_INF_D: i64 = 0x7FF0000000000000
val NEG_INF_D: i64 = 0xFFF0000000000000
val QNAN_D: i64 = 0x7FF8000000000000
val SNAN_D: i64 = 0x7FF0000000000001
val ONE_D: i64 = 0x3FF0000000000000
val TWO_D: i64 = 0x4000000000000000
val NEG_ONE_D: i64 = 0xBFF0000000000000
val POS_SUBNORM_D: i64 = 0x0000000000000001
val NEG_SUBNORM_D: i64 = 0x8000000000000001

use std.spec.step

describe "FEQ.D":
    it "equal values":
        step("Verify: equal values")
        # @req: REQ-HARDWARE-RV64GC-001
        expect(fp_eq_d(ONE_D, ONE_D)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "unequal values":
        step("Verify: unequal values")
        expect(fp_eq_d(ONE_D, TWO_D)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "+0.0 == -0.0":
        step("Verify: +0.0 == -0.0")
        expect(fp_eq_d(POS_ZERO_D, NEG_ZERO_D)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "NaN != NaN":
        step("Verify: NaN != NaN")
        expect(fp_eq_d(QNAN_D, QNAN_D)).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "FLT.D":
    it "1.0 < 2.0":
        step("Verify: 1.0 < 2.0")
        expect(fp_lt_d(ONE_D, TWO_D)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "2.0 not < 1.0":
        step("Verify: 2.0 not < 1.0")
        expect(fp_lt_d(TWO_D, ONE_D)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "equal not less":
        step("Verify: equal not less")
        expect(fp_lt_d(ONE_D, ONE_D)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "NaN comparison returns 0":
        step("Verify: NaN comparison returns 0")
        expect(fp_lt_d(QNAN_D, ONE_D)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "-0.0 not < +0.0":
        step("Verify: -0.0 not < +0.0")
        expect(fp_lt_d(NEG_ZERO_D, POS_ZERO_D)).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "FLE.D":
    it "1.0 <= 2.0":
        step("Verify: 1.0 <= 2.0")
        expect(fp_le_d(ONE_D, TWO_D)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "1.0 <= 1.0":
        step("Verify: 1.0 <= 1.0")
        expect(fp_le_d(ONE_D, ONE_D)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "2.0 not <= 1.0":
        step("Verify: 2.0 not <= 1.0")
        expect(fp_le_d(TWO_D, ONE_D)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "-0.0 <= +0.0":
        step("Verify: -0.0 <= +0.0")
        expect(fp_le_d(NEG_ZERO_D, POS_ZERO_D)).to_equal(1)  # oracle: 1 — named expected value from the requirement

describe "FMIN.D":
    it "min(1.0, 2.0) = 1.0":
        step("Verify: min(1.0, 2.0) = 1.0")
        expect(fp_min_d(ONE_D, TWO_D)).to_equal(ONE_D)

    it "min(-1.0, 1.0) = -1.0":
        step("Verify: min(-1.0, 1.0) = -1.0")
        expect(fp_min_d(NEG_ONE_D, ONE_D)).to_equal(NEG_ONE_D)

    it "min(NaN, 1.0) = 1.0":
        step("Verify: min(NaN, 1.0) = 1.0")
        expect(fp_min_d(QNAN_D, ONE_D)).to_equal(ONE_D)

    it "min(-0.0, +0.0) = -0.0":
        step("Verify: min(-0.0, +0.0) = -0.0")
        expect(fp_min_d(NEG_ZERO_D, POS_ZERO_D)).to_equal(NEG_ZERO_D)

describe "FMAX.D":
    it "max(1.0, 2.0) = 2.0":
        step("Verify: max(1.0, 2.0) = 2.0")
        expect(fp_max_d(ONE_D, TWO_D)).to_equal(TWO_D)

    it "max(-1.0, 1.0) = 1.0":
        step("Verify: max(-1.0, 1.0) = 1.0")
        expect(fp_max_d(NEG_ONE_D, ONE_D)).to_equal(ONE_D)

    it "max(NaN, 1.0) = 1.0":
        step("Verify: max(NaN, 1.0) = 1.0")
        expect(fp_max_d(QNAN_D, ONE_D)).to_equal(ONE_D)

    it "max(-0.0, +0.0) = +0.0":
        step("Verify: max(-0.0, +0.0) = +0.0")
        expect(fp_max_d(NEG_ZERO_D, POS_ZERO_D)).to_equal(POS_ZERO_D)

describe "FCLASS.D":
    it "-inf → bit 0":
        step("Verify: -inf → bit 0")
        expect(fp_class_d(NEG_INF_D)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "-normal → bit 1":
        step("Verify: -normal → bit 1")
        expect(fp_class_d(NEG_ONE_D)).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "-subnormal → bit 2":
        step("Verify: -subnormal → bit 2")
        expect(fp_class_d(NEG_SUBNORM_D)).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "-0 → bit 3":
        step("Verify: -0 → bit 3")
        expect(fp_class_d(NEG_ZERO_D)).to_equal(8)  # oracle: 8 — named expected value from the requirement

    it "+0 → bit 4":
        step("Verify: +0 → bit 4")
        expect(fp_class_d(POS_ZERO_D)).to_equal(16)  # oracle: 16 — named expected value from the requirement

    it "+subnormal → bit 5":
        step("Verify: +subnormal → bit 5")
        expect(fp_class_d(POS_SUBNORM_D)).to_equal(32)  # oracle: 32 — named expected value from the requirement

    it "+normal → bit 6":
        step("Verify: +normal → bit 6")
        expect(fp_class_d(ONE_D)).to_equal(64)  # oracle: 64 — named expected value from the requirement

    it "+inf → bit 7":
        step("Verify: +inf → bit 7")
        expect(fp_class_d(POS_INF_D)).to_equal(128)  # oracle: 128 — named expected value from the requirement

    it "sNaN → bit 8":
        step("Verify: sNaN → bit 8")
        expect(fp_class_d(SNAN_D)).to_equal(256)  # oracle: 256 — named expected value from the requirement

    it "qNaN → bit 9":
        step("Verify: qNaN → bit 9")
        expect(fp_class_d(QNAN_D)).to_equal(512)  # oracle: 512 — named expected value from the requirement

describe "FSGNJ.D / FSGNJN.D / FSGNJX.D":
    it "FSGNJ.D: copy sign positive":
        step("Verify: FSGNJ.D: copy sign positive")
        val a = ONE_D
        val b = TWO_D
        val result = (a and 0x7FFFFFFFFFFFFFFF) or (b and 0x8000000000000000)
        expect(result).to_equal(ONE_D)

    it "FSGNJ.D: copy sign negative":
        step("Verify: FSGNJ.D: copy sign negative")
        val a = ONE_D
        val b = NEG_ONE_D
        val result = (a and 0x7FFFFFFFFFFFFFFF) or (b and 0x8000000000000000)
        expect(result).to_equal(NEG_ONE_D)

    it "FSGNJN.D: negate sign":
        step("Verify: FSGNJN.D: negate sign")
        val a = ONE_D
        val b = TWO_D
        val sign_b = b and 0x8000000000000000
        val neg_sign = sign_b xor 0x8000000000000000
        val result = (a and 0x7FFFFFFFFFFFFFFF) or neg_sign
        expect(result).to_equal(NEG_ONE_D)

    it "FSGNJX.D: XOR signs positive+positive":
        step("Verify: FSGNJX.D: XOR signs positive+positive")
        val a = ONE_D
        val b = TWO_D
        val sign_xor = (a xor b) and 0x8000000000000000
        val result = (a and 0x7FFFFFFFFFFFFFFF) or sign_xor
        expect(result).to_equal(ONE_D)

    it "FSGNJX.D: XOR signs positive+negative":
        step("Verify: FSGNJX.D: XOR signs positive+negative")
        val a = ONE_D
        val b = NEG_ONE_D
        val sign_xor = (a xor b) and 0x8000000000000000
        val result = (a and 0x7FFFFFFFFFFFFFFF) or sign_xor
        expect(result).to_equal(NEG_ONE_D)
