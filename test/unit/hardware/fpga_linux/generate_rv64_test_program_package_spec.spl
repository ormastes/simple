"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-HARDWARE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/hardware/fpga_linux/generate_rv64_test_program_package_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-HARDWARE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec.*
use app.io.mod.{file_read}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn shell(command: text) -> i64:
    val (stdout, stderr, code) = rt_process_run("/bin/sh", ["-c", command])
    if code != 0:
        print stdout
        print stderr
    code

describe "generate_rv64_test_program_package":
    it "emits 64-bit preload rows and keeps byte-array metadata coherent":
        # @req: REQ-UNIT-HARDWARE-001
        step("Verify: emits 64-bit preload rows and keeps byte-array metadata coherent")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val root = "/tmp/generate_rv64_test_program_package_spec"
        val fw_bin = "{root}/fw.bin"
        val fw_hex = "{root}/fw.hex"
        val payload_bin = "{root}/payload.bin"
        val payload_hex = "{root}/payload.hex"
        val pkg = "{root}/test_program.vhd"

        expect(shell("rm -rf '" + root + "' && mkdir -p '" + root + "'")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        expect(shell("printf '\\001\\002\\003\\004\\005\\006\\007\\010\\011' > '" + fw_bin + "'")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(shell("printf '\\252\\273\\314\\335' > '" + payload_bin + "'")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        expect(shell("bin/simple run src/hardware/fpga_linux/generate_rv64_test_program_package.spl -- '" + fw_bin + "' '" + fw_hex + "' '" + payload_bin + "' '" + payload_hex + "' '" + pkg + "'")).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        expect(file_read(fw_hex)).to_equal("0807060504030201\n0000000000000009\n")
        expect(file_read(payload_hex)).to_equal("00000000DDCCBBAA\n")

        val pkg_text = file_read(pkg)
        expect(pkg_text).to_contain("constant HEX_WORD_BYTES : integer := 8;")
        expect(pkg_text).to_contain("constant FW_SIZE_BYTES : integer := 9;")
        expect(pkg_text).to_contain("constant FW_HEX_PATH : string := \"" + fw_hex + "\";")
        expect(pkg_text).to_contain("constant PAYLOAD_SIZE_BYTES : integer := 4;")
        expect(pkg_text).to_contain("constant PAYLOAD_HEX_PATH : string := \"" + payload_hex + "\";")
        expect(pkg_text).to_contain("constant FW_BYTES : byte_array_t(0 to 8) := (")
        expect(pkg_text).to_contain("        x\"01\",")
        expect(pkg_text).to_contain("        x\"09\"\n    );")
        expect(pkg_text).to_contain("constant PAYLOAD_BYTES : byte_array_t(0 to 3) := (")
        expect(pkg_text).to_contain("        x\"AA\",")
        expect(pkg_text).to_contain("        x\"DD\"\n    );")
