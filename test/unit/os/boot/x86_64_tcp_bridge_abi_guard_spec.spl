"""x86_64 SimpleOS TCP bridge tagged-ABI and bounds regression guard.

The provider sources are freestanding guest C and cannot be linked into the
host SSpec process.  These assertions keep the std.io adapter and its
bare-metal rt_net owner aligned until the same cases run in QEMU.
"""
# @req REQ-SIMPLEOS-TCP-BRIDGE-ABI-001

use std.spec.*
use std.io_runtime.{file_read}

describe "x86_64 SimpleOS TCP bridge ABI":

    it "rejects non-integer descriptors instead of treating them as raw indices":
        step("Read the filesystem-program TCP adapter")
        val adapter = file_read("examples/09_embedded/simple_os/arch/x86_64/boot/rt_extras.c")
        expect(adapter).to_contain("if (!out || !IS_INT(value)) return 0;")
        expect(adapter).to_contain("if (!_simpleos_tcp_decode_i64(fd, &fd_i64) || fd_i64 < 0) return ENCODE_INT(-1);")
        expect(adapter).to_not_contain("return IS_INT(value) ? DECODE_INT(value) : (int64_t)value;")

    it "decodes every tagged rt_net status before branching":
        step("Read the tagged result adapter")
        val adapter = file_read("examples/09_embedded/simple_os/arch/x86_64/boot/rt_extras.c")
        expect(adapter).to_contain("static int64_t _simpleos_tcp_result_i64(RuntimeValue value)")
        expect(adapter).to_contain("return IS_INT(value) ? DECODE_INT(value) : -1;")
        expect(adapter).to_contain("_simpleos_tcp_result_i64((RuntimeValue)rt_net_bind(fd, port))")
        expect(adapter).to_contain("_simpleos_tcp_result_i64((RuntimeValue)rt_net_close(fd_i64))")

    it "does not index the socket table while reporting an invalid descriptor":
        step("Read the bare-metal TCP owner")
        val owner = file_read("examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c")
        expect(owner).to_contain("if (fd >= 0 && fd < MAX_SOCKETS) {")
        expect(owner).to_contain("serial_put_dec(_sockets[fd].state);")

    it "bounds send arrays and returns a byte array for failed reads":
        step("Read the bare-metal TCP send and receive contracts")
        val owner = file_read("examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c")
        expect(owner).to_contain("arr->hdr.type != HEAP_ARRAY || arr->len > UINT32_MAX")
        expect(owner).to_contain("!_sockets[fd].in_use || max_len <= 0")
        expect(owner).to_contain("return _rt_bytes_new(NULL, 0);")
        val adapter = file_read("examples/09_embedded/simple_os/arch/x86_64/boot/rt_extras.c")
        expect(adapter).to_contain("return IS_HEAP(result) ? result : rt_bytes_alloc_packed_empty();")
        expect(adapter).to_not_contain("return IS_HEAP(result) ? result : rt_array_new(ENCODE_INT(0));")
