"""
## Purpose and audience
Purpose: parses a basic URL with no port and no path
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-OS-PkgRepo-001

use std.spipe.*
use os.tools.pkg.pkg_repository.{parse_http_url}

use std.spec.step
describe "parse_http_url":

    it "parses a basic URL with no port and no path":
        step("Verify: parses a basic URL with no port and no path")
        # @req: REQ-OS-PkgRepo-001
        val result = parse_http_url("http://repo.example.com")
        expect(result.0).to_equal("repo.example.com")
        expect(result.1).to_equal(80)  # oracle: value fixed by the spec contract
        expect(result.2).to_equal("/")

    it "parses a URL with explicit port and path":
        step("Verify: parses a URL with explicit port and path")
        # @req: REQ-OS-PkgRepo-001
        val result = parse_http_url("http://repo.example.com:8080/index.sdn")
        expect(result.0).to_equal("repo.example.com")
        expect(result.1).to_equal(8080)  # oracle: value fixed by the spec contract
        expect(result.2).to_equal("/index.sdn")

    it "parses a URL with default port and sub-path":
        step("Verify: parses a URL with default port and sub-path")
        # @req: REQ-OS-PkgRepo-001
        val result = parse_http_url("http://pkg.simpleos.org/v1/index.sdn")
        expect(result.0).to_equal("pkg.simpleos.org")
        expect(result.1).to_equal(80)  # oracle: value fixed by the spec contract
        expect(result.2).to_equal("/v1/index.sdn")

    it "parses an https URL stripping scheme":
        step("Verify: parses an https URL stripping scheme")
        # @req: REQ-OS-PkgRepo-001
        val result = parse_http_url("https://secure.example.com:443/pkgs/index.sdn")
        expect(result.0).to_equal("secure.example.com")
        expect(result.1).to_equal(443)  # oracle: value fixed by the spec contract
        expect(result.2).to_equal("/pkgs/index.sdn")

    it "defaults to port 443 for https URL without explicit port":
        step("Verify: defaults to port 443 for https URL without explicit port")
        # @req: REQ-OS-PkgRepo-001
        val result = parse_http_url("https://secure.example.com/pkgs/index.sdn")
        expect(result.0).to_equal("secure.example.com")
        expect(result.1).to_equal(443)  # oracle: value fixed by the spec contract
        expect(result.2).to_equal("/pkgs/index.sdn")
