"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/os/desktop/desktop_e2e_shortcut_flow_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec.*

extern fn rt_file_read_text(path: text) -> text

val DESKTOP_E2E_ENTRY: text = "examples/09_embedded/simple_os/arch/x86_64/desktop_e2e_entry.spl"

describe "desktop e2e shortcut flow":

    it "does not return before SYS-GUI-002 shortcut and wm markers on no-vfs boots":
        # @req: REQ-UNIT-OS-001
        step("Verify: does not return before SYS-GUI-002 shortcut and wm markers on no-vfs boots")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = rt_file_read_text(DESKTOP_E2E_ENTRY)
        val skip_idx = source.find("[desktop-e2e] storage-backed-launch:skip reason=no-vfs")
        val shortcut_idx = source.find("[desktop-e2e] shortcut dispatch begin")
        val wm_idx = source.find("[desktop-e2e] wm:ok pid=")
        val old_cutoff = "storage-backed-launch:skip reason=no-vfs\")\n        return true"

        expect(skip_idx).to_be_greater_than(0)
        expect(shortcut_idx).to_be_greater_than(skip_idx)
        expect(wm_idx).to_be_greater_than(shortcut_idx)
        expect(source.contains(old_cutoff)).to_equal(false)
