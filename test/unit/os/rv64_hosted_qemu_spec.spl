# @req: REQ-OS-OS-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/os/rv64_hosted_qemu_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/rv64_hosted_qemu.md
# doc-path: doc/03_plan/sys_test/rv64_hosted_qemu.md
# doc-path: doc/04_architecture/rv64_hosted_qemu.md
# doc-path: doc/05_design/rv64_hosted_qemu.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "string split, join and repeat":
        step("Verify: string split, join and repeat")
        # @req: REQ-OS-OS-001
        expect("a,b,c".split(",")).to_equal(["a", "b", "c"])
        expect("ha".repeat(3)).to_equal("hahaha")
        expect("ab".reverse()).to_equal("ba")

    it "array construction and access":
        step("Verify: array construction and access")
        # @req: REQ-OS-OS-001
        expect([1, 2, 3].len()).to_equal(3)  # oracle: three-element literal
        expect([10, 20, 30][1]).to_equal(20)  # oracle: zero-based indexing
        expect([].len()).to_equal(0)  # oracle: empty literal has no elements

    it "string case and strip methods":
        step("Verify: string case and strip methods")
        # @req: REQ-OS-OS-001
        expect("AbC".to_lower()).to_equal("abc")
        expect("AbC".to_upper()).to_equal("ABC")
        expect("  x ".trim()).to_equal("x")

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "truncating division and signed remainder":
        step("Verify: truncating division and signed remainder")
        # @req: REQ-OS-OS-001
        expect(7 / 2).to_equal(3)  # oracle: i64 division truncates toward zero
        expect(-7 / 2).to_equal(-3)  # oracle: truncation is toward zero
        expect(7 % 2).to_equal(1)  # oracle: remainder of positive dividend
        expect(-7 % 2).to_equal(-1)  # oracle: remainder keeps dividend sign

    it "for-range iterates the half-open span":
        step("Verify: for-range iterates the half-open span")
        # @req: REQ-OS-OS-001
        var seen = 0
        for i in 0..4:
            seen = seen + 1
        expect(seen).to_equal(4)  # oracle: 0..4 yields four iterations

    it "var mutation is sequentially visible":
        step("Verify: var mutation is sequentially visible")
        # @req: REQ-OS-OS-001
        var acc = 1
        acc = acc + 1
        acc = acc * 10
        expect(acc).to_equal(20)  # oracle: (1+1)*10
