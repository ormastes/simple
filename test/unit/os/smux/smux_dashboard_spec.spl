# smux_dashboard_spec.spl — Unit tests for the smux dashboard adapter.
#
# Tests for session overview, pane layout info, status bar data, attach/detach
# helpers, and resize hint generation.
#
# Pattern: plain fn test_X() with print("PASS:...") / print("FAIL:...").
# Text-grep verifiable: grep "PASS:" output to confirm each AC.
# No imports from smux — all types are replicated at module level to avoid
# import resolution issues in interpreter mode.

# =========================================================================
# Module-level replicas of dashboard types (no imports needed)
# =========================================================================

class DashSessionRow:
    session_id: text
    session_name: text
    window_count: int
    pane_count: int
    is_attached: bool

    me to_text() -> text:
        val att = if self.is_attached: "attached" else: "detached"
        return self.session_name + " (" + att + ") w=" + self.window_count.to_text() + " p=" + self.pane_count.to_text()

    static fn make(sid: text, name: text, wc: int, pc: int, att: bool) -> DashSessionRow:
        return DashSessionRow(session_id: sid, session_name: name, window_count: wc, pane_count: pc, is_attached: att)

class DashPaneInfo:
    pane_id: text
    window_id: text
    session_id: text
    width: int
    height: int
    is_active: bool
    preview_line: text

    me geometry_text() -> text:
        return self.width.to_text() + "x" + self.height.to_text()

    me to_text() -> text:
        val active_flag = if self.is_active: "*" else: " "
        return active_flag + "pane[" + self.pane_id + "] " + self.geometry_text() + " > " + self.preview_line

    static fn make(pid: text, wid: text, sid: text, w: int, h: int, active: bool, preview: text) -> DashPaneInfo:
        return DashPaneInfo(pane_id: pid, window_id: wid, session_id: sid, width: w, height: h, is_active: active, preview_line: preview)

class DashStatusBar:
    session_count: int
    active_session_name: text
    active_window_name: text
    active_pane_geometry: text
    has_attached: bool

    me to_text() -> text:
        return "[smux " + self.session_count.to_text() + "s] " + self.active_session_name + ":" + self.active_window_name + " " + self.active_pane_geometry

    static fn empty() -> DashStatusBar:
        return DashStatusBar(session_count: 0, active_session_name: "", active_window_name: "", active_pane_geometry: "", has_attached: false)

    static fn build(sc: int, sname: text, wname: text, geom: text, att: bool) -> DashStatusBar:
        return DashStatusBar(session_count: sc, active_session_name: sname, active_window_name: wname, active_pane_geometry: geom, has_attached: att)

class DashAttachResult:
    ok: bool
    session_id: text
    error_msg: text

    me to_text() -> text:
        if self.ok:
            return "attached:" + self.session_id
        return "error:" + self.error_msg

    static fn success(sid: text) -> DashAttachResult:
        return DashAttachResult(ok: true, session_id: sid, error_msg: "")

    static fn failure(msg: text) -> DashAttachResult:
        return DashAttachResult(ok: false, session_id: "", error_msg: msg)

# =========================================================================
# Resize hint helper (replicated)
# =========================================================================

fn dashboard_resize_hint(session_id: text, window_id: text, pane_id: text, cols: int, rows: int) -> text:
    return "resize " + session_id + "/" + window_id + "/" + pane_id + " -> " + cols.to_text() + "x" + rows.to_text()

# =========================================================================
# DashSessionRow tests
# =========================================================================

fn test_session_row_to_text_attached() -> bool:
    val row = DashSessionRow.make("s0", "dev", 3, 5, true)
    val t = row.to_text()
    if t == "dev (attached) w=3 p=5":
        return true
    else:
        return false

fn test_session_row_to_text_detached() -> bool:
    val row = DashSessionRow.make("s1", "ci", 1, 2, false)
    val t = row.to_text()
    if t == "ci (detached) w=1 p=2":
        return true
    else:
        return false

fn test_session_row_fields() -> bool:
    val row = DashSessionRow.make("sid99", "prod", 4, 8, true)
    if row.session_id == "sid99":
        if row.window_count == 4:
            if row.pane_count == 8:
                return true
    return false

fn test_session_row_window_count_zero() -> bool:
    val row = DashSessionRow.make("s2", "empty", 0, 0, false)
    if row.window_count == 0:
        return true
    else:
        return false

# =========================================================================
# DashPaneInfo tests
# =========================================================================

fn test_pane_info_geometry_text() -> bool:
    val info = DashPaneInfo.make("p0", "w0", "s0", 80, 24, false, "")
    val g = info.geometry_text()
    if g == "80x24":
        return true
    else:
        return false

fn test_pane_info_to_text_active() -> bool:
    val info = DashPaneInfo.make("p1", "w0", "s0", 120, 40, true, "$ ls")
    val t = info.to_text()
    if t == "*pane[p1] 120x40 > $ ls":
        return true
    else:
        return false

fn test_pane_info_to_text_inactive() -> bool:
    val info = DashPaneInfo.make("p2", "w0", "s0", 80, 24, false, "")
    val t = info.to_text()
    if t == " pane[p2] 80x24 > ":
        return true
    else:
        return false

fn test_pane_info_preview_stored() -> bool:
    val info = DashPaneInfo.make("p3", "w1", "s1", 80, 24, false, "hello world")
    if info.preview_line == "hello world":
        return true
    else:
        return false

fn test_pane_info_width_height() -> bool:
    val info = DashPaneInfo.make("p4", "w2", "s2", 160, 50, true, "")
    if info.width == 160:
        if info.height == 50:
            return true
    return false

# =========================================================================
# DashStatusBar tests
# =========================================================================

fn test_status_bar_empty() -> bool:
    val sb = DashStatusBar.empty()
    if sb.session_count == 0:
        if sb.active_session_name == "":
            return true
    return false

fn test_status_bar_to_text() -> bool:
    val sb = DashStatusBar.build(2, "dev", "main", "80x24", true)
    val t = sb.to_text()
    if t == "[smux 2s] dev:main 80x24":
        return true
    else:
        return false

fn test_status_bar_no_session() -> bool:
    val sb = DashStatusBar.empty()
    val t = sb.to_text()
    if t == "[smux 0s] : ":
        return true
    else:
        return false

fn test_status_bar_has_attached() -> bool:
    val sb = DashStatusBar.build(1, "work", "editor", "100x30", true)
    if sb.has_attached:
        return true
    else:
        return false

fn test_status_bar_detached() -> bool:
    val sb = DashStatusBar.build(1, "ci", "build", "80x24", false)
    if sb.has_attached == false:
        return true
    else:
        return false

# =========================================================================
# DashAttachResult tests
# =========================================================================

fn test_attach_result_success() -> bool:
    val r = DashAttachResult.success("s42")
    if r.ok:
        if r.session_id == "s42":
            return true
    return false

fn test_attach_result_failure() -> bool:
    val r = DashAttachResult.failure("session not found: ghost")
    if r.ok == false:
        if r.error_msg == "session not found: ghost":
            return true
    return false

fn test_attach_result_to_text_ok() -> bool:
    val r = DashAttachResult.success("sid1")
    val t = r.to_text()
    if t == "attached:sid1":
        return true
    else:
        return false

fn test_attach_result_to_text_err() -> bool:
    val r = DashAttachResult.failure("not found")
    val t = r.to_text()
    if t == "error:not found":
        return true
    else:
        return false

# =========================================================================
# Resize hint tests
# =========================================================================

fn test_resize_hint_format() -> bool:
    val h = dashboard_resize_hint("s0", "w0", "p0", 120, 40)
    if h == "resize s0/w0/p0 -> 120x40":
        return true
    else:
        return false

fn test_resize_hint_small() -> bool:
    val h = dashboard_resize_hint("sid", "wid", "pid", 80, 24)
    if h == "resize sid/wid/pid -> 80x24":
        return true
    else:
        return false

fn test_resize_hint_ids_preserved() -> bool:
    val h = dashboard_resize_hint("my-session", "win-3", "pane-7", 200, 60)
    val expected = "resize my-session/win-3/pane-7 -> 200x60"
    if h == expected:
        return true
    else:
        return false

# =========================================================================
# Entry point
# =========================================================================

describe "smux dashboard":
    it "session row to text attached":
        expect(test_session_row_to_text_attached()).to_equal(true)

    it "session row to text detached":
        expect(test_session_row_to_text_detached()).to_equal(true)

    it "session row fields":
        expect(test_session_row_fields()).to_equal(true)

    it "session row window count zero":
        expect(test_session_row_window_count_zero()).to_equal(true)

    it "pane info geometry text":
        expect(test_pane_info_geometry_text()).to_equal(true)

    it "pane info to text active":
        expect(test_pane_info_to_text_active()).to_equal(true)

    it "pane info to text inactive":
        expect(test_pane_info_to_text_inactive()).to_equal(true)

    it "pane info preview stored":
        expect(test_pane_info_preview_stored()).to_equal(true)

    it "pane info width height":
        expect(test_pane_info_width_height()).to_equal(true)

    it "status bar empty":
        expect(test_status_bar_empty()).to_equal(true)

    it "status bar to text":
        expect(test_status_bar_to_text()).to_equal(true)

    it "status bar no session":
        expect(test_status_bar_no_session()).to_equal(true)

    it "status bar has attached":
        expect(test_status_bar_has_attached()).to_equal(true)

    it "status bar detached":
        expect(test_status_bar_detached()).to_equal(true)

    it "attach result success":
        expect(test_attach_result_success()).to_equal(true)

    it "attach result failure":
        expect(test_attach_result_failure()).to_equal(true)

    it "attach result to text ok":
        expect(test_attach_result_to_text_ok()).to_equal(true)

    it "attach result to text err":
        expect(test_attach_result_to_text_err()).to_equal(true)

    it "resize hint format":
        expect(test_resize_hint_format()).to_equal(true)

    it "resize hint small":
        expect(test_resize_hint_small()).to_equal(true)

    it "resize hint ids preserved":
        expect(test_resize_hint_ids_preserved()).to_equal(true)

