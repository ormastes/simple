"""
## Purpose and audience
Behavioral specification for riscv dual arch.
Audience: compiler/runtime developers and spec maintainers who need
to verify this component's observable behavior and pinned values.
"""
# @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
use std.spec
use os.kernel.arch.riscv_shared.dual_arch_contract.{ArchDescriptor, DualArchContract, Rv32HardwareTree, QemuVirtContract}
use os.kernel.arch.riscv_shared.fpga_orchestration.{FpgaOrchestration, LaneStatus}
use os.kernel.arch.riscv_shared.backend_test_verify.{BackendTestEntry, VerificationStage, AcceptanceMatrix, PromotionGate}

describe "RISC-V dual-arch contract (ArchDescriptor)":
    it "reports rv32gc as a complete G+C profile":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: reports rv32gc as a complete G+C profile")
        val d = ArchDescriptor.rv32gc()
        expect(d.is_rv32()).to_equal(true)  # oracle: expected value pinned by spec
        expect(d.is_gc()).to_equal(true)

    it "reports rv64gc as a complete G+C profile":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: reports rv64gc as a complete G+C profile")
        val d = ArchDescriptor.rv64gc()
        expect(d.is_rv64()).to_equal(true)  # oracle: expected value pinned by spec
        expect(d.is_gc()).to_equal(true)

    it "treats rv64gc with Sv39 mmu as linux-capable":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: treats rv64gc with Sv39 mmu as linux-capable")
        val d = ArchDescriptor.rv64gc()
        expect(d.linux_capable()).to_equal(true)

    it "treats rv32i-only (no mmu) as not linux-capable":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: treats rv32i-only (no mmu) as not linux-capable")
        val d = ArchDescriptor.rv32i_only()
        expect(d.linux_capable()).to_equal(false)
        expect(d.is_gc()).to_equal(false)

describe "RISC-V dual-arch contract (DualArchContract)":
    it "reports both arches linux-capable for the gc contract":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: reports both arches linux-capable for the gc contract")
        val c = DualArchContract.gc_contract()
        expect(c.both_linux_capable()).to_equal(true)
        expect(c.any_linux_capable()).to_equal(true)
        expect(c.is_symmetric()).to_equal(true)

    it "reports only rv64 linux-capable for the rv64-only contract":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: reports only rv64 linux-capable for the rv64-only contract")
        val c = DualArchContract.rv64_only()
        expect(c.both_linux_capable()).to_equal(false)
        expect(c.any_linux_capable()).to_equal(true)
        expect(c.is_symmetric()).to_equal(false)

describe "RISC-V dual-arch contract (Rv32HardwareTree)":
    it "treats the qemu virt hardware tree as linux-minimal with console":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: treats the qemu virt hardware tree as linux-minimal with console")
        val h = Rv32HardwareTree.qemu_virt()
        expect(h.is_linux_minimal()).to_equal(true)
        expect(h.has_console()).to_equal(true)

    it "treats the minimal hardware tree (no PLIC) as not linux-minimal":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: treats the minimal hardware tree (no PLIC) as not linux-minimal")
        val h = Rv32HardwareTree.minimal()
        expect(h.is_linux_minimal()).to_equal(false)

describe "RISC-V dual-arch contract (QemuVirtContract)":
    it "identifies an rv32 linux target with a kernel and dtb":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: identifies an rv32 linux target with a kernel and dtb")
        val q = QemuVirtContract.rv32_linux("/boot/Image", "/boot/rv32.dtb")
        expect(q.is_rv32()).to_equal(true)  # oracle: expected value pinned by spec
        expect(q.has_kernel()).to_equal(true)
        expect(q.has_dtb()).to_equal(true)

    it "identifies an rv64 linux target":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: identifies an rv64 linux target")
        val q = QemuVirtContract.rv64_linux("/boot/Image", "/boot/rv64.dtb")
        expect(q.is_rv64()).to_equal(true)  # oracle: expected value pinned by spec
        expect(q.is_rv32()).to_equal(false)  # oracle: expected value pinned by spec

describe "RISC-V dual-arch contract (FpgaOrchestration)":
    it "is not ready for a freshly created rv32 board":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: is not ready for a freshly created rv32 board")
        val f = FpgaOrchestration.rv32_board("ZedBoard")
        expect(f.is_ready()).to_equal(false)
        expect(f.is_rv32()).to_equal(true)  # oracle: expected value pinned by spec

    it "is ready once bitstream/dtb/firmware are all set for rv64":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: is ready once bitstream/dtb/firmware are all set for rv64")
        val f = FpgaOrchestration.ready_rv64("ZedBoard")
        expect(f.is_ready()).to_equal(true)
        expect(f.is_rv64()).to_equal(true)  # oracle: expected value pinned by spec

describe "RISC-V dual-arch contract (LaneStatus)":
    it "reports all_pass and full pass_count for a fully-passing rv64 lane":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: reports all_pass and full pass_count for a fully-passing rv64 lane")
        val l = LaneStatus.rv64_passing()
        expect(l.all_pass()).to_equal(true)
        expect(l.pass_count()).to_equal(4)  # oracle: expected value pinned by spec
        expect(l.has_skips()).to_equal(false)

    it "reports partial progress and skip tracking for a partial rv32 lane":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: reports partial progress and skip tracking for a partial rv32 lane")
        val l = LaneStatus.rv32_partial()
        expect(l.all_pass()).to_equal(false)
        expect(l.pass_count()).to_equal(2)  # oracle: expected value pinned by spec
        expect(l.has_skips()).to_equal(true)

describe "RISC-V dual-arch contract (BackendTestEntry)":
    it "is aligned to shared truth but not yet passing when actual is empty":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: is aligned to shared truth but not yet passing when actual is empty")
        val e = BackendTestEntry.compile_test("rv64", "add", "shared/add.json")
        expect(e.is_aligned()).to_equal(true)
        expect(e.is_compile_test()).to_equal(true)
        expect(e.is_passing()).to_equal(false)

    it "is a simulate-category entry for sim_test":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: is a simulate-category entry for sim_test")
        val e = BackendTestEntry.sim_test("rv32", "div", "shared/div.json")
        expect(e.is_simulate_test()).to_equal(true)

describe "RISC-V dual-arch contract (VerificationStage)":
    it "treats a generated-only, non-optional stage as a gate":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: treats a generated-only, non-optional stage as a gate")
        val s = VerificationStage.generated_gate("codegen", 10)
        expect(s.is_gate()).to_equal(true)
        expect(s.is_diagnostic()).to_equal(false)

    it "treats an external-rtl, optional stage as diagnostic":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: treats an external-rtl, optional stage as diagnostic")
        val s = VerificationStage.external_diag("lint", 5)
        expect(s.is_diagnostic()).to_equal(true)
        expect(s.is_gate()).to_equal(false)

describe "RISC-V dual-arch contract (AcceptanceMatrix)":
    it "reports rv64-only pass state for the rv64_only factory":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: reports rv64-only pass state for the rv64_only factory")
        val m = AcceptanceMatrix.rv64_only()
        expect(m.rv64_all_pass()).to_equal(true)  # oracle: expected value pinned by spec
        expect(m.rv32_all_pass()).to_equal(false)  # oracle: expected value pinned by spec
        expect(m.all_pass()).to_equal(false)
        expect(m.total_pass()).to_equal(4)  # oracle: expected value pinned by spec

    it "reports all_pass true for the full_pass factory":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: reports all_pass true for the full_pass factory")
        val m = AcceptanceMatrix.full_pass()
        expect(m.all_pass()).to_equal(true)
        expect(m.total_pass()).to_equal(8)  # oracle: expected value pinned by spec

describe "RISC-V dual-arch contract (PromotionGate)":
    it "can promote when the ready gate has no blockers":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: can promote when the ready gate has no blockers")
        val g = PromotionGate.ready()
        expect(g.can_promote()).to_equal(true)
        expect(g.has_blockers()).to_equal(false)

    it "cannot promote and reports the first blocker when blocked":
        # @req: REQ-TEST-OS_RISCV_DUAL_ARCH-001
        step("Verify: cannot promote and reports the first blocker when blocked")
        val g = PromotionGate.blocked("rv32 synth failing")
        expect(g.can_promote()).to_equal(false)
        expect(g.has_blockers()).to_equal(true)
        expect(g.first_blocker()).to_equal("rv32 synth failing")
