    it "Alice public key is in range (1 < pub < p-1)":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-OS-014
        step("Verify: Alice public key is in range (1 < pub < p-1)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        pending("2048-bit modexp is O(minutes) in interpreter; deferred to native rt_modexp (see doc/02_requirements/feature/ffdhe_native_modexp_2026-05-02.md)")
