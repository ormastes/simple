# GF(2^128) multiplication / GHASH helper — extracted from what were
# byte-for-byte duplicated bodies in aes128_gcm.spl and aes256_gcm.spl.
#
# KAT source: NIST GCM Test Case 1 (empty plaintext/AAD, key=0^128,
# H = AES-128_K(0^128) = 0x66e94bd4ef8a2c3b884cfa59ca342b2e).
# GHASH(H, "", "") is defined as GHASH_H of the single length block
# (0 || 0), i.e. gcm_ghash_block(H, 0^128, 0^128) since both AAD and CT
# are empty (no data blocks, only the trailing length block, itself zero).
#
# Reference: NIST SP 800-38D, Appendix B, Test Case 1.

use std.spipe.*
use os.crypto.gcm_gf128.{gcm_gf128_mul, gcm_ghash_block, gcm_pad_to_16, gcm_ghash}

fn _zeros16() -> [u8]:
    var out: [u8] = []
    var i: u64 = 0
    while i < 16:
        out.push(0x00)
        i = i + 1
    out

fn _h_tc1() -> [u8]:
    # H = AES-128_K(0^128) for key = 0^128 (NIST GCM Test Case 1).
    var out: [u8] = []
    out.push(0x66); out.push(0xe9); out.push(0x4b); out.push(0xd4)
    out.push(0xef); out.push(0x8a); out.push(0x2c); out.push(0x3b)
    out.push(0x88); out.push(0x4c); out.push(0xfa); out.push(0x59)
    out.push(0xca); out.push(0x34); out.push(0x2b); out.push(0x2e)
    out

describe "gcm_gf128_mul / gcm_ghash — shared GCM helper":

    it "x * 0 = 0 for any x (identity of GF(2^128) zero element)":
        val product = gcm_gf128_mul(_h_tc1(), _zeros16())
        var i: u64 = 0
        while i < 16:
            expect(product[i]).to_equal(0x00)
            i = i + 1

    it "gcm_pad_to_16 is a no-op on already-16-byte-aligned input":
        val padded = gcm_pad_to_16(_zeros16())
        expect(padded.len()).to_equal(16)

    it "gcm_pad_to_16 zero-pads a 1-byte input up to 16 bytes":
        var one: [u8] = []
        one.push(0xAB)
        val padded = gcm_pad_to_16(one)
        expect(padded.len()).to_equal(16)
        expect(padded[0]).to_equal(0xAB)
        expect(padded[15]).to_equal(0x00)

    it "gcm_ghash_block(H, 0, 0) = 0 (XOR of zero blocks times H is zero)":
        val block = gcm_ghash_block(_h_tc1(), _zeros16(), _zeros16())
        var i: u64 = 0
        while i < 16:
            expect(block[i]).to_equal(0x00)
            i = i + 1

    it "gcm_ghash(H, empty, empty) matches NIST GCM Test Case 1 GHASH result":
        var empty: [u8] = []
        val tag = gcm_ghash(_h_tc1(), empty, empty)
        # Only the trailing all-zero length block is hashed: GHASH_H(0^128) = 0.
        var i: u64 = 0
        while i < 16:
            expect(tag[i]).to_equal(0x00)
            i = i + 1
