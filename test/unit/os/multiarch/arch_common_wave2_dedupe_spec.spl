"""
## Purpose and audience
Behavioral specification for arch common wave2 dedupe.
Audience: compiler/runtime developers and spec maintainers who need
to verify this component's observable behavior and pinned values.
"""
# @req: REQ-TEST-MULTIARCH_ARCH_COMMON_WAVE2_DE-001
# Multi-arch dedupe, wave 2 — the shared arch/common helpers that replaced
# copy-pasted per-arch GIC register offsets and x86 GDT selectors must hold
# the single source of truth, and the copies must stay gone.
#
# Run:
#   bin/simple test test/01_unit/os/multiarch/arch_common_wave2_dedupe_spec.spl
#
# @cover src/os/kernel/arch/common/gic_common.spl
# @cover src/os/kernel/arch/common/x86_descriptor.spl

use std.spec
use std.io_runtime.{file_read}
use os.kernel.arch.common.gic_common.{
    GICD_CTLR, GICD_TYPER, GICD_ISENABLER, GICD_ICENABLER,
    GICD_IPRIORITYR, GICD_ITARGETSR, GICD_ICFGR,
    GICC_CTLR, GICC_PMR, GICC_IAR, GICC_EOIR,
    is_sgi, is_ppi, is_spi, gicd_typer_irq_lines, priority_byte_offset,
}
use os.kernel.arch.common.x86_descriptor.{
    RPL_USER,
    SEL_KERNEL_CODE_64, SEL_KERNEL_DATA_64, SEL_USER_COMPAT_CODE_64,
    SEL_USER_DATA_64, SEL_USER_CODE_64, SEL_TSS_64,
    SEL_KERNEL_CODE_32, SEL_KERNEL_DATA_32,
    SEL_USER_CODE_32, SEL_USER_DATA_32, SEL_TSS_32,
}

val GIC_ARCHES: [text] = ["arm32", "arm64"]

val GICD_OFFSET_NAMES: [text] = [
    "GICD_CTLR", "GICD_TYPER", "GICD_ISENABLER", "GICD_ICENABLER",
    "GICD_ISPENDR", "GICD_ICPENDR", "GICD_IPRIORITYR", "GICD_ITARGETSR",
    "GICD_ICFGR",
]

describe "gic_common — GICv2 register offsets are shared, bases are not":
    """arm32 and arm64 drive the SAME GICv2 hardware. The register offsets
    were byte-identical copies in both interrupt.spl files; only the MMIO
    base addresses are genuinely per-platform and stay per-arch."""

    it "holds the GICv2 distributor offsets from the GIC architecture spec":
        # @req: REQ-TEST-MULTIARCH_ARCH_COMMON_WAVE2_DE-001
        step("Verify: holds the GICv2 distributor offsets from the GIC architecture spec")
        expect(GICD_CTLR).to_equal(0x000)  # oracle: expected value pinned by spec
        expect(GICD_TYPER).to_equal(0x004)  # oracle: expected value pinned by spec
        expect(GICD_ISENABLER).to_equal(0x100)  # oracle: expected value pinned by spec
        expect(GICD_ICENABLER).to_equal(0x180)  # oracle: expected value pinned by spec
        expect(GICD_IPRIORITYR).to_equal(0x400)  # oracle: expected value pinned by spec
        expect(GICD_ITARGETSR).to_equal(0x800)  # oracle: expected value pinned by spec
        expect(GICD_ICFGR).to_equal(0xC00)  # oracle: expected value pinned by spec

    it "holds the GICv2 CPU-interface offsets from the GIC architecture spec":
        # @req: REQ-TEST-MULTIARCH_ARCH_COMMON_WAVE2_DE-001
        step("Verify: holds the GICv2 CPU-interface offsets from the GIC architecture spec")
        expect(GICC_CTLR).to_equal(0x0000)  # oracle: expected value pinned by spec
        expect(GICC_PMR).to_equal(0x0004)  # oracle: expected value pinned by spec
        expect(GICC_IAR).to_equal(0x000C)  # oracle: expected value pinned by spec
        expect(GICC_EOIR).to_equal(0x0010)  # oracle: expected value pinned by spec

    it "leaves no local GICD offset copy in any arm arch":
        # @req: REQ-TEST-MULTIARCH_ARCH_COMMON_WAVE2_DE-001
        step("Verify: leaves no local GICD offset copy in any arm arch")
        var copies = 0
        for a in GIC_ARCHES:
            val body = file_read("src/os/kernel/arch/" + a + "/interrupt.spl")
            for n in GICD_OFFSET_NAMES:
                if body.contains("val " + n + ":"):
                    copies = copies + 1
        expect(copies).to_equal(0)  # oracle: expected value pinned by spec

    it "leaves no local GICC offset copy in any arm arch":
        # @req: REQ-TEST-MULTIARCH_ARCH_COMMON_WAVE2_DE-001
        step("Verify: leaves no local GICC offset copy in any arm arch")
        var copies = 0
        for a in GIC_ARCHES:
            val body = file_read("src/os/kernel/arch/" + a + "/interrupt.spl")
            if body.contains("val GICC_CTLR:"):
                copies = copies + 1
            if body.contains("val GICC_IAR:"):
                copies = copies + 1
        expect(copies).to_equal(0)  # oracle: expected value pinned by spec

    it "every arm arch imports the shared offsets":
        # @req: REQ-TEST-MULTIARCH_ARCH_COMMON_WAVE2_DE-001
        step("Verify: every arm arch imports the shared offsets")
        var wired = 0
        for a in GIC_ARCHES:
            val body = file_read("src/os/kernel/arch/" + a + "/interrupt.spl")
            if body.contains("os.kernel.arch.common.gic_common"):
                wired = wired + 1
        expect(wired).to_equal(2)  # oracle: expected value pinned by spec

    it "keeps the MMIO base addresses per-arch — they are NOT shared":
        # @req: REQ-TEST-MULTIARCH_ARCH_COMMON_WAVE2_DE-001
        step("Verify: keeps the MMIO base addresses per-arch — they are NOT shared")
        # This is the boundary of the dedupe: a base address is a platform
        # fact, not a GIC-architecture fact, so it must stay local.
        var bases = 0
        for a in GIC_ARCHES:
            val body = file_read("src/os/kernel/arch/" + a + "/interrupt.spl")
            if body.contains("val GICD_BASE:"):
                bases = bases + 1
            if body.contains("val GICC_BASE:"):
                bases = bases + 1
        expect(bases).to_equal(4)  # oracle: expected value pinned by spec

    it "classifies IRQ ranges the way both arm interrupt modules assume":
        # @req: REQ-TEST-MULTIARCH_ARCH_COMMON_WAVE2_DE-001
        step("Verify: classifies IRQ ranges the way both arm interrupt modules assume")
        expect(is_sgi(0)).to_equal(true)  # oracle: expected value pinned by spec
        expect(is_sgi(15)).to_equal(true)  # oracle: expected value pinned by spec
        expect(is_ppi(16)).to_equal(true)  # oracle: expected value pinned by spec
        expect(is_ppi(30)).to_equal(true)     # arm generic timer PPI
        expect(is_spi(32)).to_equal(true)  # oracle: expected value pinned by spec
        expect(is_spi(1020)).to_equal(false)  # 1020..1023 are reserved

    it "decodes GICD_TYPER ITLinesNumber the way the arm init loops do":
        # @req: REQ-TEST-MULTIARCH_ARCH_COMMON_WAVE2_DE-001
        step("Verify: decodes GICD_TYPER ITLinesNumber the way the arm init loops do")
        # Both arches compute (typer & 0x1F) + 1) * 32.
        expect(gicd_typer_irq_lines(0x00)).to_equal(32)  # oracle: expected value pinned by spec
        expect(gicd_typer_irq_lines(0x1F)).to_equal(1024)  # oracle: expected value pinned by spec

    it "computes the priority byte offset used by set_priority":
        # @req: REQ-TEST-MULTIARCH_ARCH_COMMON_WAVE2_DE-001
        step("Verify: computes the priority byte offset used by set_priority")
        # One priority BYTE per IRQ, so the offset into GICD_IPRIORITYR is
        # the IRQ number itself; both arm modules then split it into a word
        # index (irq / 4) and a shift ((irq % 4) * 8).
        expect(priority_byte_offset(0)).to_equal(0)  # oracle: expected value pinned by spec
        expect(priority_byte_offset(7)).to_equal(7)  # oracle: expected value pinned by spec
        expect(priority_byte_offset(7) / 4).to_equal(1)  # oracle: expected value pinned by spec
        expect((priority_byte_offset(7) % 4) * 8).to_equal(24)  # oracle: expected value pinned by spec

describe "x86_descriptor — GDT selector layouts are shared per mode":
    """Five copies of the x86 selector table existed. The 64-bit and 32-bit
    layouts genuinely differ (the 64-bit table carries a 32-bit COMPAT code
    slot), so they stay as two named layouts — but each is single-sourced."""

    it "matches the live x86_64 GDT builder in interrupts/gdt.spl":
        # @req: REQ-TEST-MULTIARCH_ARCH_COMMON_WAVE2_DE-001
        step("Verify: matches the live x86_64 GDT builder in interrupts/gdt.spl")
        val body = file_read("src/os/kernel/interrupts/gdt.spl")
        expect(body.contains("val GDT_KERNEL_CS: u16   = 0x08")).to_equal(true)
        expect(body.contains("val GDT_USER_CS: u16     = 0x28")).to_equal(true)
        expect(body.contains("val GDT_TSS_SEL: u16     = 0x30")).to_equal(true)
        expect(SEL_KERNEL_CODE_64).to_equal(0x08)  # oracle: expected value pinned by spec
        expect(SEL_USER_CODE_64).to_equal(0x28)  # oracle: expected value pinned by spec
        expect(SEL_TSS_64).to_equal(0x30)  # oracle: expected value pinned by spec

    it "keeps the 64-bit compat-code slot distinct from the 64-bit user code":
        # @req: REQ-TEST-MULTIARCH_ARCH_COMMON_WAVE2_DE-001
        step("Verify: keeps the 64-bit compat-code slot distinct from the 64-bit user code")
        # The pre-dedupe arch/common copy had SEL_USER_CODE_64 = 0x18|3,
        # i.e. it named the COMPAT slot as the 64-bit user code segment and
        # baked RPL into the constant. That was a latent wrong value.
        expect(SEL_USER_COMPAT_CODE_64).to_equal(0x18)  # oracle: expected value pinned by spec
        expect(SEL_USER_DATA_64).to_equal(0x20)  # oracle: expected value pinned by spec
        expect(SEL_USER_CODE_64 == SEL_USER_COMPAT_CODE_64).to_equal(false)  # oracle: expected value pinned by spec

    it "carries RPL separately so callers OR it in at the point of use":
        # @req: REQ-TEST-MULTIARCH_ARCH_COMMON_WAVE2_DE-001
        step("Verify: carries RPL separately so callers OR it in at the point of use")
        expect(RPL_USER).to_equal(3)  # oracle: expected value pinned by spec
        expect(SEL_USER_CODE_64 & 0x3).to_equal(0)  # oracle: expected value pinned by spec
        expect(SEL_USER_CODE_32 & 0x3).to_equal(0)  # oracle: expected value pinned by spec

    it "holds the 32-bit protected-mode layout":
        # @req: REQ-TEST-MULTIARCH_ARCH_COMMON_WAVE2_DE-001
        step("Verify: holds the 32-bit protected-mode layout")
        expect(SEL_KERNEL_CODE_32).to_equal(0x08)  # oracle: expected value pinned by spec
        expect(SEL_KERNEL_DATA_32).to_equal(0x10)  # oracle: expected value pinned by spec
        expect(SEL_USER_CODE_32).to_equal(0x18)  # oracle: expected value pinned by spec
        expect(SEL_USER_DATA_32).to_equal(0x20)  # oracle: expected value pinned by spec
        expect(SEL_TSS_32).to_equal(0x28)  # oracle: expected value pinned by spec

    it "keeps the two mode layouts distinct where the hardware differs":
        # @req: REQ-TEST-MULTIARCH_ARCH_COMMON_WAVE2_DE-001
        step("Verify: keeps the two mode layouts distinct where the hardware differs")
        expect(SEL_KERNEL_DATA_64).to_equal(SEL_KERNEL_DATA_32)  # oracle: expected value pinned by spec
        expect(SEL_TSS_64 == SEL_TSS_32).to_equal(false)  # oracle: expected value pinned by spec

    it "leaves no hardcoded selector copy in x86_32/cpu.spl":
        # @req: REQ-TEST-MULTIARCH_ARCH_COMMON_WAVE2_DE-001
        step("Verify: leaves no hardcoded selector copy in x86_32/cpu.spl")
        val body = file_read("src/os/kernel/arch/x86_32/cpu.spl")
        expect(body.contains("os.kernel.arch.common.x86_descriptor")).to_equal(true)
        expect(body.contains("val GDT_USER_CODE: u16 = 0x18")).to_equal(false)
        expect(body.contains("val GDT_TSS: u16 = 0x28")).to_equal(false)

    it "leaves no hardcoded selector copy in x86_64/gdt.spl":
        # @req: REQ-TEST-MULTIARCH_ARCH_COMMON_WAVE2_DE-001
        step("Verify: leaves no hardcoded selector copy in x86_64/gdt.spl")
        val body = file_read("src/os/kernel/arch/x86_64/gdt.spl")
        expect(body.contains("os.kernel.arch.common.x86_descriptor")).to_equal(true)
        expect(body.contains("val GDT_USER_CODE: u16 = 0x28")).to_equal(false)
        expect(body.contains("val GDT_TSS: u16 = 0x30")).to_equal(false)
