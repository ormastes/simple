# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/os/posix/async_io.spl 80%
"""
# Async I/O Backend Routing Specification

Native async I/O owns serial and VFS-backed file descriptor completion. Pipe
descriptors remain owned by the native pipe backend and must not be treated as
VFS file descriptors.
"""

use std.spec.step

use std.spec
use os.posix.fd_table.{FD_TYPE_FILE, FD_TYPE_SERIAL, FD_TYPE_PIPE_READ, FD_TYPE_PIPE_WRITE, FD_TYPE_FREE}
use os.posix.async_io.{async_io_backend_for_fd_type, ASYNC_IO_BACKEND_INVALID, ASYNC_IO_BACKEND_SERIAL, ASYNC_IO_BACKEND_VFS}

describe "async_io backend ownership":
    # @manual scenario evidence
    it "owns serial descriptors":
        # @req REQ-SSPEC-UNIT
        step("owns serial descriptors")
        expect(async_io_backend_for_fd_type(FD_TYPE_SERIAL)).to_equal(ASYNC_IO_BACKEND_SERIAL)

    it "owns VFS-backed file descriptors":
        # @req REQ-SSPEC-UNIT
        step("owns VFS-backed file descriptors")
        expect(async_io_backend_for_fd_type(FD_TYPE_FILE)).to_equal(ASYNC_IO_BACKEND_VFS)

    it "does not own pipe descriptors":
        # @req REQ-SSPEC-UNIT
        step("does not own pipe descriptors")
        expect(async_io_backend_for_fd_type(FD_TYPE_PIPE_READ)).to_equal(ASYNC_IO_BACKEND_INVALID)
        expect(async_io_backend_for_fd_type(FD_TYPE_PIPE_WRITE)).to_equal(ASYNC_IO_BACKEND_INVALID)

    it "rejects free descriptors":
        # @req REQ-SSPEC-UNIT
        step("rejects free descriptors")
        expect(async_io_backend_for_fd_type(FD_TYPE_FREE)).to_equal(ASYNC_IO_BACKEND_INVALID)
