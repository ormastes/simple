"""
## Purpose and audience
Behavioral specification for fd table.
Audience: compiler/runtime developers and spec maintainers who need
to verify this component's observable behavior and pinned values.
"""
# @req: REQ-TEST-POSIX_FD_TABLE-001
# @cover src/os/posix/fd_table.spl 80%
"""
# POSIX fd table specification

The fd table maps descriptors to open file descriptions. Duplicated
descriptors share status flags and file offsets, while FD_CLOEXEC remains
per descriptor.
"""

use std.spec
use os.posix.errno.{EBADF, EMFILE}
use os.posix.fd_table.{fd_table_init, fd_activate_task, fd_current_task, fd_alloc, fd_set, fd_close, fd_is_valid, fd_dup, fd_dup2, fd_get_cloexec, fd_set_cloexec, fd_close_on_exec, fd_exec_cleanup, fd_prepare_fork, fd_prepare_fork_to_task, fd_release_on_process_exit, fd_release_task, fd_get_status_flags, fd_set_status_flags, fd_get_offset, fd_set_offset, fd_get_type, fd_get_backend_handle, fd_get_object_id, fd_get_refcount, fd_poll_ready, fd_set_poll_notification, fd_poll_notification, fd_update_ready, fd_get_ready_generation, fd_types, fd_ports, fd_refcounts, FD_TYPE_FREE, FD_TYPE_FILE, FD_TYPE_PIPE_READ, FD_TYPE_SERIAL, O_RDONLY, O_WRONLY, O_RDWR, O_NONBLOCK, O_CLOEXEC, POLLIN, POLLOUT, POLLHUP, POLLNVAL, MAX_FDS}

describe "POSIX fd table":
    it "initializes stdio descriptors and allocates the lowest free descriptor":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: initializes stdio descriptors and allocates the lowest free descriptor")
        fd_table_init()

        expect(fd_is_valid(0)).to_equal(true)  # oracle: expected value pinned by spec
        expect(fd_is_valid(1)).to_equal(true)  # oracle: expected value pinned by spec
        expect(fd_is_valid(2)).to_equal(true)  # oracle: expected value pinned by spec
        expect(fd_types[0]).to_equal(FD_TYPE_SERIAL)  # oracle: expected value pinned by spec
        expect(fd_alloc()).to_equal(3)  # oracle: expected value pinned by spec

        expect(fd_close(0)).to_equal(0)  # oracle: expected value pinned by spec
        expect(fd_alloc()).to_equal(0)  # oracle: expected value pinned by spec

    it "keeps O_CLOEXEC as a per-descriptor flag":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: keeps O_CLOEXEC as a per-descriptor flag")
        fd_table_init()
        expect(fd_set(3, FD_TYPE_FILE, O_RDWR | O_NONBLOCK | O_CLOEXEC, 99u64)).to_equal(0)  # oracle: expected value pinned by spec

        expect(fd_get_cloexec(3)).to_equal(true)  # oracle: expected value pinned by spec
        expect(fd_get_status_flags(3) & O_CLOEXEC).to_equal(0u32)  # oracle: expected value pinned by spec
        expect(fd_get_status_flags(3) & O_NONBLOCK).to_equal(O_NONBLOCK)  # oracle: expected value pinned by spec

    it "reports open-file-description exhaustion through fd_set":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: reports open-file-description exhaustion through fd_set")
        fd_table_init()
        var fd: i32 = 3
        while (fd as u64) < MAX_FDS - 1:
            expect(fd_set(fd, FD_TYPE_FILE, O_RDONLY, fd as u64)).to_equal(0)  # oracle: expected value pinned by spec
            fd = fd + 1

        expect(fd_set(255, FD_TYPE_FILE, O_RDONLY, 255u64)).to_equal(0 - EMFILE)  # oracle: expected value pinned by spec
        expect(fd_is_valid(255)).to_equal(false)  # oracle: expected value pinned by spec

    it "duplicates descriptors onto a shared open file description":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: duplicates descriptors onto a shared open file description")
        fd_table_init()
        fd_set(3, FD_TYPE_FILE, O_RDWR | O_CLOEXEC, 99u64)
        expect(fd_set_offset(3, 44u64)).to_equal(0)  # oracle: expected value pinned by spec
        expect(fd_set_status_flags(3, O_RDWR | O_NONBLOCK)).to_equal(0)  # oracle: expected value pinned by spec

        val dup_fd = fd_dup(3)

        expect(dup_fd).to_equal(4)  # oracle: expected value pinned by spec
        expect(fd_get_cloexec(dup_fd)).to_equal(false)
        expect(fd_refcounts[3]).to_equal(2u32)  # oracle: expected value pinned by spec
        expect(fd_refcounts[4]).to_equal(2u32)  # oracle: expected value pinned by spec
        expect(fd_get_offset(dup_fd)).to_equal(44u64)  # oracle: expected value pinned by spec
        expect(fd_get_status_flags(dup_fd) & O_NONBLOCK).to_equal(O_NONBLOCK)

        expect(fd_set_offset(dup_fd, 88u64)).to_equal(0)  # oracle: expected value pinned by spec
        expect(fd_get_offset(3)).to_equal(88u64)  # oracle: expected value pinned by spec

        expect(fd_set_status_flags(dup_fd, O_RDWR)).to_equal(0)  # oracle: expected value pinned by spec
        expect(fd_get_status_flags(3) & O_NONBLOCK).to_equal(0u32)  # oracle: expected value pinned by spec

    it "exposes a stable token for duplicated open file descriptions":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: exposes a stable token for duplicated open file descriptions")
        fd_table_init()
        fd_set(3, FD_TYPE_FILE, O_RDONLY, 10u64)
        val original_token = fd_get_object_id(3)

        val dup_fd = fd_dup(3)
        expect(dup_fd).to_equal(4)  # oracle: expected value pinned by spec
        expect(fd_get_object_id(dup_fd)).to_equal(original_token)

        fd_set(5, FD_TYPE_FILE, O_RDONLY, 20u64)
        expect(fd_get_object_id(5)).to_equal(20u64)  # oracle: expected value pinned by spec
        expect(fd_dup2(3, 5)).to_equal(5)  # oracle: expected value pinned by spec
        expect(fd_get_object_id(5)).to_equal(original_token)  # oracle: expected value pinned by spec

    it "implements dup2 replacement semantics":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: implements dup2 replacement semantics")
        fd_table_init()
        fd_set(3, FD_TYPE_FILE, O_RDONLY, 10u64)
        fd_set(4, FD_TYPE_FILE, O_WRONLY | O_CLOEXEC, 20u64)
        expect(fd_set_offset(3, 7u64)).to_equal(0)  # oracle: expected value pinned by spec
        expect(fd_set_offset(4, 99u64)).to_equal(0)  # oracle: expected value pinned by spec

        expect(fd_dup2(3, 4)).to_equal(4)  # oracle: expected value pinned by spec

        expect(fd_ports[4]).to_equal(10u64)  # oracle: expected value pinned by spec
        expect(fd_get_cloexec(4)).to_equal(false)  # oracle: expected value pinned by spec
        expect(fd_refcounts[3]).to_equal(2u32)  # oracle: expected value pinned by spec
        expect(fd_refcounts[4]).to_equal(2u32)  # oracle: expected value pinned by spec
        expect(fd_get_offset(4)).to_equal(7u64)  # oracle: expected value pinned by spec

        expect(fd_set_offset(4, 12u64)).to_equal(0)  # oracle: expected value pinned by spec
        expect(fd_get_offset(3)).to_equal(12u64)  # oracle: expected value pinned by spec

    it "preserves descriptor flags when dup2 targets the same descriptor":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: preserves descriptor flags when dup2 targets the same descriptor")
        fd_table_init()
        fd_set(3, FD_TYPE_FILE, O_RDONLY | O_CLOEXEC, 10u64)

        expect(fd_dup2(3, 3)).to_equal(3)  # oracle: expected value pinned by spec
        expect(fd_get_cloexec(3)).to_equal(true)  # oracle: expected value pinned by spec
        expect(fd_refcounts[3]).to_equal(1u32)  # oracle: expected value pinned by spec

    it "rejects invalid dup descriptors with EBADF":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: rejects invalid dup descriptors with EBADF")
        fd_table_init()
        fd_set(3, FD_TYPE_FILE, O_RDONLY, 10u64)

        expect(fd_dup(-1)).to_equal(0 - EBADF)  # oracle: expected value pinned by spec
        expect(fd_dup2(99, 4)).to_equal(0 - EBADF)  # oracle: expected value pinned by spec
        expect(fd_dup2(3, -1)).to_equal(0 - EBADF)  # oracle: expected value pinned by spec
        expect(fd_dup2(3, 256)).to_equal(0 - EBADF)  # oracle: expected value pinned by spec

    it "closes only descriptors marked close-on-exec":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: closes only descriptors marked close-on-exec")
        fd_table_init()
        fd_set(3, FD_TYPE_FILE, O_RDONLY, 10u64)
        fd_set(4, FD_TYPE_FILE, O_RDONLY, 20u64)
        expect(fd_set_cloexec(3, true)).to_equal(0)  # oracle: expected value pinned by spec
        expect(fd_set_cloexec(4, false)).to_equal(0)  # oracle: expected value pinned by spec

        expect(fd_close_on_exec()).to_equal(1u32)  # oracle: expected value pinned by spec
        expect(fd_is_valid(3)).to_equal(false)  # oracle: expected value pinned by spec
        expect(fd_is_valid(4)).to_equal(true)  # oracle: expected value pinned by spec
        expect(fd_types[3]).to_equal(FD_TYPE_FREE)  # oracle: expected value pinned by spec

    it "applies exec cleanup through the exec lifecycle alias":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: applies exec cleanup through the exec lifecycle alias")
        fd_table_init()
        fd_set(3, FD_TYPE_FILE, O_RDONLY | O_CLOEXEC, 10u64)
        fd_set(4, FD_TYPE_FILE, O_RDONLY, 20u64)

        expect(fd_exec_cleanup()).to_equal(1u32)  # oracle: expected value pinned by spec
        expect(fd_is_valid(3)).to_equal(false)  # oracle: expected value pinned by spec
        expect(fd_is_valid(4)).to_equal(true)  # oracle: expected value pinned by spec

    it "inherits live descriptors across fork without changing cloexec flags":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: inherits live descriptors across fork without changing cloexec flags")
        fd_table_init()
        fd_set(3, FD_TYPE_FILE, O_RDONLY | O_CLOEXEC, 10u64)
        fd_set(4, FD_TYPE_FILE, O_WRONLY, 20u64)

        expect(fd_get_refcount(3)).to_equal(1u32)  # oracle: expected value pinned by spec
        expect(fd_prepare_fork()).to_equal(5u32)  # oracle: expected value pinned by spec

        expect(fd_get_refcount(3)).to_equal(2u32)  # oracle: expected value pinned by spec
        expect(fd_get_refcount(4)).to_equal(2u32)  # oracle: expected value pinned by spec
        expect(fd_get_cloexec(3)).to_equal(true)  # oracle: expected value pinned by spec
        expect(fd_get_cloexec(4)).to_equal(false)  # oracle: expected value pinned by spec

    it "releases every live descriptor on process exit":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: releases every live descriptor on process exit")
        fd_table_init()
        fd_set(3, FD_TYPE_FILE, O_RDONLY, 10u64)
        fd_set(4, FD_TYPE_FILE, O_WRONLY, 20u64)

        expect(fd_release_on_process_exit()).to_equal(5u32)  # oracle: expected value pinned by spec
        expect(fd_is_valid(0)).to_equal(false)  # oracle: expected value pinned by spec
        expect(fd_is_valid(3)).to_equal(false)  # oracle: expected value pinned by spec
        expect(fd_is_valid(4)).to_equal(false)  # oracle: expected value pinned by spec

    it "keeps descriptor tables isolated between active tasks":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: keeps descriptor tables isolated between active tasks")
        fd_table_init()
        fd_activate_task(10u64)
        fd_set(3, FD_TYPE_FILE, O_RDONLY, 10u64)
        expect(fd_current_task()).to_equal(10u64)  # oracle: expected value pinned by spec
        expect(fd_is_valid(3)).to_equal(true)  # oracle: expected value pinned by spec

        fd_activate_task(11u64)
        expect(fd_current_task()).to_equal(11u64)  # oracle: expected value pinned by spec
        expect(fd_is_valid(3)).to_equal(false)  # oracle: expected value pinned by spec
        expect(fd_is_valid(0)).to_equal(true)  # oracle: expected value pinned by spec

        fd_activate_task(10u64)
        expect(fd_is_valid(3)).to_equal(true)  # oracle: expected value pinned by spec
        expect(fd_get_backend_handle(3)).to_equal(10u64)  # oracle: expected value pinned by spec

    it "does not alias descriptor contexts with modulo-colliding task ids":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: does not alias descriptor contexts with modulo-colliding task ids")
        fd_table_init()
        fd_activate_task(10u64)
        fd_set(3, FD_TYPE_FILE, O_RDONLY, 10u64)

        fd_activate_task(266u64)
        expect(fd_current_task()).to_equal(266u64)  # oracle: expected value pinned by spec
        expect(fd_is_valid(3)).to_equal(false)  # oracle: expected value pinned by spec
        fd_set(3, FD_TYPE_FILE, O_RDONLY, 266u64)

        fd_activate_task(10u64)
        expect(fd_is_valid(3)).to_equal(true)  # oracle: expected value pinned by spec
        expect(fd_get_backend_handle(3)).to_equal(10u64)  # oracle: expected value pinned by spec

        fd_activate_task(266u64)
        expect(fd_is_valid(3)).to_equal(true)  # oracle: expected value pinned by spec
        expect(fd_get_backend_handle(3)).to_equal(266u64)  # oracle: expected value pinned by spec

    it "clones active descriptor table into fork child context":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: clones active descriptor table into fork child context")
        fd_table_init()
        fd_activate_task(20u64)
        fd_set(3, FD_TYPE_FILE, O_RDONLY | O_CLOEXEC, 30u64)
        expect(fd_set_offset(3, 44u64)).to_equal(0)  # oracle: expected value pinned by spec

        expect(fd_prepare_fork_to_task(21u64)).to_equal(4u32)  # oracle: expected value pinned by spec
        expect(fd_get_refcount(3)).to_equal(2u32)  # oracle: expected value pinned by spec

        fd_activate_task(21u64)
        expect(fd_is_valid(3)).to_equal(true)  # oracle: expected value pinned by spec
        expect(fd_get_cloexec(3)).to_equal(true)  # oracle: expected value pinned by spec
        expect(fd_get_offset(3)).to_equal(44u64)  # oracle: expected value pinned by spec
        expect(fd_set_offset(3, 88u64)).to_equal(0)  # oracle: expected value pinned by spec

        fd_activate_task(20u64)
        expect(fd_get_offset(3)).to_equal(88u64)  # oracle: expected value pinned by spec

    it "releases inactive task descriptor contexts":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: releases inactive task descriptor contexts")
        fd_table_init()
        fd_activate_task(30u64)
        fd_set(3, FD_TYPE_FILE, O_RDONLY, 40u64)
        expect(fd_prepare_fork_to_task(31u64)).to_equal(4u32)  # oracle: expected value pinned by spec
        expect(fd_get_refcount(3)).to_equal(2u32)  # oracle: expected value pinned by spec

        expect(fd_release_task(31u64)).to_equal(4u32)  # oracle: expected value pinned by spec
        expect(fd_get_refcount(3)).to_equal(1u32)  # oracle: expected value pinned by spec
        fd_activate_task(31u64)
        expect(fd_is_valid(3)).to_equal(false)  # oracle: expected value pinned by spec

    it "keeps duplicated open descriptions alive until the last close":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: keeps duplicated open descriptions alive until the last close")
        fd_table_init()
        fd_set(3, FD_TYPE_FILE, O_RDONLY, 10u64)
        expect(fd_set_offset(3, 55u64)).to_equal(0)  # oracle: expected value pinned by spec

        val dup_fd = fd_dup(3)
        expect(dup_fd).to_equal(4)  # oracle: expected value pinned by spec
        expect(fd_close(3)).to_equal(0)  # oracle: expected value pinned by spec

        expect(fd_is_valid(3)).to_equal(false)  # oracle: expected value pinned by spec
        expect(fd_is_valid(4)).to_equal(true)  # oracle: expected value pinned by spec
        expect(fd_get_offset(4)).to_equal(55u64)  # oracle: expected value pinned by spec
        expect(fd_refcounts[4]).to_equal(1u32)  # oracle: expected value pinned by spec

        expect(fd_close(4)).to_equal(0)  # oracle: expected value pinned by spec
        expect(fd_is_valid(4)).to_equal(false)  # oracle: expected value pinned by spec

    it "exposes fd backend metadata without direct table access":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: exposes fd backend metadata without direct table access")
        fd_table_init()
        fd_set(3, FD_TYPE_FILE, O_RDONLY, 77u64)

        expect(fd_get_type(3)).to_equal(FD_TYPE_FILE)  # oracle: expected value pinned by spec
        expect(fd_get_backend_handle(3)).to_equal(77u64)  # oracle: expected value pinned by spec
        expect(fd_get_type(99)).to_equal(FD_TYPE_FREE)  # oracle: expected value pinned by spec

    it "tracks readiness and notifications on the shared open description":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: tracks readiness and notifications on the shared open description")
        fd_table_init()
        fd_set(3, FD_TYPE_PIPE_READ, O_RDONLY, 11u64)
        expect(fd_set_poll_notification(3, POLLIN, 500u64)).to_equal(0)  # oracle: expected value pinned by spec

        val dup_fd = fd_dup(3)
        expect(dup_fd).to_equal(4)  # oracle: expected value pinned by spec
        expect(fd_poll_notification(dup_fd, POLLIN)).to_equal(500u64)  # oracle: expected value pinned by spec
        expect(fd_poll_ready(dup_fd, POLLIN)).to_equal(0 as i16)  # oracle: expected value pinned by spec
        expect(fd_get_ready_generation(3)).to_equal(0u64)  # oracle: expected value pinned by spec

        expect(fd_update_ready(3, POLLIN, 0 as i16)).to_equal(0)  # oracle: expected value pinned by spec
        expect(fd_poll_ready(dup_fd, POLLIN)).to_equal(POLLIN)
        expect(fd_get_ready_generation(dup_fd)).to_equal(1u64)  # oracle: expected value pinned by spec

        expect(fd_update_ready(dup_fd, POLLHUP, POLLIN)).to_equal(0)  # oracle: expected value pinned by spec
        expect(fd_poll_ready(3, POLLIN)).to_equal(POLLHUP)  # oracle: expected value pinned by spec
        expect(fd_get_ready_generation(3)).to_equal(2u64)  # oracle: expected value pinned by spec

    it "reports invalid descriptors through poll readiness":
        # @req: REQ-TEST-POSIX_FD_TABLE-001
        step("Verify: reports invalid descriptors through poll readiness")
        fd_table_init()

        expect(fd_poll_ready(99, POLLIN | POLLOUT)).to_equal(POLLNVAL)  # oracle: expected value pinned by spec
