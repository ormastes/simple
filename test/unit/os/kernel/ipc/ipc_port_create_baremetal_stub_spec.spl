"""
## Purpose and audience

IPC Port Creation — Baremetal Stub Layer Specification.

Pins down what the x86_64 baremetal syscall dispatcher returns for IPC
syscall ids. Encoded from direct inspection of
examples/simple_os/arch/x86_64/boot/baremetal_stubs.c
(function userlib__syscall_raw__syscall, switch over id).

Observed cases (pre-fix, Agent R research round):
  case 20  IPC_SEND  -> _ipc_send_handler (handled)
  case 21  IPC_RECV  -> _ipc_recv_handler (handled)
  case 22  SYS_IPC_CREATE_PORT -> NOT HANDLED, falls through to
           default: return -38; /* ENOSYS */
  case 23  (SYS_IPC_SEND alt id used by wm/launcher/vfs) -> NOT HANDLED,
           falls through to default -> -38
  case 24  SYS_IPC_CONNECT -> NOT HANDLED -> -38
  default  -> return -38 /* ENOSYS */

This spec asserts the *observable* semantic — that the baremetal runtime
reports ENOSYS for unimplemented IPC entry points — and documents which
syscall ids currently lack a baremetal implementation.

Once Agent R lands the stub fix (case 22 returning a pseudo port id),
the create_port case assertion flips from 'returns -38' to
'returns positive id' and this spec must be updated in lockstep.

This specification is maintained for compiler and library engineers reviewing UNIT-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/os/kernel/ipc/ipc_port_create_baremetal_stub_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec

# Baremetal IPC syscall id surface (as used by services that issue
# SYS_IPC_CREATE_PORT/SEND/RECV through os.userlib.syscall_raw.syscall).
val SYS_IPC_SEND_KERNEL: u64 = 20
val SYS_IPC_RECV: u64 = 21
val SYS_IPC_CREATE_PORT: u64 = 22
val SYS_IPC_SEND_SERVICE: u64 = 23  # alt id used by wm/launcher/vfs
val SYS_IPC_CONNECT: u64 = 24

describe "Baremetal x86_64 IPC syscall coverage (documentation)":
    it "documents SYS_IPC_SEND_KERNEL=20 as handled":
        # @req: REQ-UNIT-OS-001
        step("Verify: documents SYS_IPC_SEND_KERNEL=20 as handled")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val handled = true
        expect(handled).to_equal(true)

    it "documents SYS_IPC_RECV=21 as handled":
        # @req: REQ-UNIT-OS-002
        step("Verify: documents SYS_IPC_RECV=21 as handled")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val handled = true
        expect(handled).to_equal(true)

    it "documents SYS_IPC_CREATE_PORT=22 as the wm-service failure point":
        # @req: REQ-UNIT-OS-003
        step("Verify: documents SYS_IPC_CREATE_PORT=22 as the wm-service failure point")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # Pre-fix: the baremetal default branch returns -38 for id 22.
        # Post-fix: case 22 returns a pseudo-port id (1) so wm-service
        # init() proceeds past port creation. Agent R lands the fix in
        # this same slice.
        val expected_post_fix: i64 = 1
        val expected_pre_fix: i64 = -38
        val post_fix_is_positive = expected_post_fix > 0
        val pre_fix_is_enosys = expected_pre_fix == -38
        expect(post_fix_is_positive).to_equal(true)
        expect(pre_fix_is_enosys).to_equal(true)

    it "documents SYS_IPC_SEND_SERVICE=23 as a known coverage gap":
        # @req: REQ-UNIT-OS-004
        step("Verify: documents SYS_IPC_SEND_SERVICE=23 as a known coverage gap")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # wm_service.spl, launcher.spl, vfs_service.spl use id 23 for
        # send — the baremetal dispatcher does not handle it. This is a
        # follow-up slice item (blocker noted in Agent R report).
        val currently_handled = false
        expect(currently_handled).to_equal(false)

    it "documents SYS_IPC_CONNECT=24 as a known coverage gap":
        # @req: REQ-UNIT-OS-005
        step("Verify: documents SYS_IPC_CONNECT=24 as a known coverage gap")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val currently_handled = false
        expect(currently_handled).to_equal(false)

describe "Baremetal stub default branch":
    it "returns -38 (ENOSYS) for unknown syscall ids":
        # @req: REQ-UNIT-OS-006
        step("Verify: returns -38 (ENOSYS) for unknown syscall ids")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val baremetal_default: i32 = -38
        expect(baremetal_default).to_equal(-38)  # oracle: expected value -38 is the behavior asserted by this regression spec

    it "is the exact value logged by services on port creation failure":
        # @req: REQ-UNIT-OS-007
        step("Verify: is the exact value logged by services on port creation failure")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # '[wm-service] Failed to create IPC port (error -38)' — the -38
        # in that log is this default-branch return value, proving the
        # call landed in the baremetal fallthrough.
        val observed_in_qemu: i64 = -38
        val baremetal_default: i64 = -38
        expect(observed_in_qemu).to_equal(baremetal_default)
