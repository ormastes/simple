"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/os/kernel/ipc/spm_port_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Spec: src/os/kernel/ipc/spm_port.spl
use std.spec.{describe, it, expect, step}
use os.kernel.ipc.spm_port.{spm_port_register, spm_port_send, spm_port_listen, spm_port_is_registered, spm_port_registered_task, spm_port_reset, spm_port_post_response}

describe("spm_port"):

    it("starts unregistered"):
        # @req: REQ-UNIT-OS-001
        step("Verify: starts unregistered")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        spm_port_reset()
        expect(spm_port_is_registered()).to_equal(false)

    it("register accepts a task id"):
        # @req: REQ-UNIT-OS-002
        step("Verify: register accepts a task id")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        spm_port_reset()
        val ok = spm_port_register(42 as u64)
        expect(ok).to_equal(true)
        expect(spm_port_is_registered()).to_equal(true)
        expect(spm_port_registered_task()).to_equal(42 as u64)

    it("register is idempotent for the same task"):
        # @req: REQ-UNIT-OS-003
        step("Verify: register is idempotent for the same task")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        spm_port_reset()
        spm_port_register(7 as u64)
        val again = spm_port_register(7 as u64)
        expect(again).to_equal(true)

    it("register rejects a second distinct task"):
        # @req: REQ-UNIT-OS-004
        step("Verify: register rejects a second distinct task")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        spm_port_reset()
        spm_port_register(7 as u64)
        val ok = spm_port_register(8 as u64)
        expect(ok).to_equal(false)

    it("listen on empty inbox returns empty bytes"):
        # @req: REQ-UNIT-OS-005
        step("Verify: listen on empty inbox returns empty bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        spm_port_reset()
        val r = spm_port_listen()
        expect(r.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it("send enqueues a request"):
        # @req: REQ-UNIT-OS-006
        step("Verify: send enqueues a request")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        spm_port_reset()
        val req: [u8] = [1 as u8, 2 as u8, 3 as u8]
        spm_port_send(req)
        val got = spm_port_listen()
        expect(got.len()).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    it("send returns the last stashed response"):
        # @req: REQ-UNIT-OS-007
        step("Verify: send returns the last stashed response")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        spm_port_reset()
        val resp: [u8] = [9 as u8, 9 as u8]
        spm_port_post_response(resp)
        val req: [u8] = [1 as u8]
        val r = spm_port_send(req)
        expect(r.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    it("FIFO: first in first out"):
        # @req: REQ-UNIT-OS-008
        step("Verify: FIFO: first in first out")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        spm_port_reset()
        val a: [u8] = [1 as u8]
        val b: [u8] = [2 as u8, 2 as u8]
        spm_port_send(a)
        spm_port_send(b)
        val first = spm_port_listen()
        val second = spm_port_listen()
        expect(first.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(second.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    it("listen drains the inbox"):
        # @req: REQ-UNIT-OS-009
        step("Verify: listen drains the inbox")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        spm_port_reset()
        spm_port_send([1 as u8])
        spm_port_listen()
        val again = spm_port_listen()
        expect(again.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it("reset clears state"):
        # @req: REQ-UNIT-OS-010
        step("Verify: reset clears state")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        spm_port_register(1 as u64)
        spm_port_send([1 as u8])
        spm_port_reset()
        expect(spm_port_is_registered()).to_equal(false)
        expect(spm_port_listen().len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
