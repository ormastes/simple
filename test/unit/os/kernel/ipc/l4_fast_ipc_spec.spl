# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, expect}
use os.kernel.ipc.l4_fast_ipc.{
    L4BufferPool,
    l4_inline_message32_from_counter,
    l4_inline_message64_from_counter,
    l4_inline_checksum32,
    l4_inline_checksum64,
    l4_inline_round_trip_32bit,
    l4_inline_round_trip_64bit,
    l4_inline_round_trip_32bit_index,
    l4_inline_round_trip_64bit_index
}

describe "L4 fast IPC pure Simple primitives":
    # @manual scenario evidence
    it "builds deterministic 32-bit register messages":
        # @req REQ-SSPEC-UNIT
        step("builds deterministic 32-bit register messages")
        val msg = l4_inline_message32_from_counter(5)
        expect(msg.method_id).to_equal(5)
        expect(msg.payload_len).to_equal(32)
        expect(msg.r0).to_equal(5)
        expect(msg.r7).to_equal(12)
        expect(l4_inline_checksum32(msg)).to_equal(54)
        expect(l4_inline_round_trip_32bit(5)).to_equal(54)
        expect(l4_inline_round_trip_32bit_index(5)).to_equal(54)

    it "builds deterministic 64-bit register messages":
        # @req REQ-SSPEC-UNIT
        step("builds deterministic 64-bit register messages")
        val msg = l4_inline_message64_from_counter(5)
        expect(msg.method_id).to_equal(5)
        expect(msg.payload_len).to_equal(32)
        expect(msg.r0).to_equal(5)
        expect(msg.r7).to_equal(12)
        expect(l4_inline_checksum64(msg)).to_equal(86)
        expect(l4_inline_round_trip_64bit(5)).to_equal(86)
        expect(l4_inline_round_trip_64bit_index(5)).to_equal(86)

    it "transfers a 4096-byte buffer slot and clears ownership":
        # @req REQ-SSPEC-UNIT
        step("transfers a 4096-byte buffer slot and clears ownership")
        var pool = L4BufferPool.new(4)
        val checksum = pool.transfer_4096(6, 11, 12)
        expect(checksum).to_equal(4111)
        expect(pool.states[2]).to_equal(0)
        expect(pool.owners[2]).to_equal(0)
        expect(pool.msg_lens[2]).to_equal(0)
