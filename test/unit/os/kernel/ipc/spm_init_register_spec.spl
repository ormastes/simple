"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/os/kernel/ipc/spm_init_register_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Spec: kernel boot wires spm_port_register via init_services.
#
# Verifies that `init_spm_port()` (called from init_all_services at boot)
# claims the SPM kernel-port slot with the well-known placeholder TaskId,
# so syscalls 110-114 have a registered receiver from the first scheduler
# tick. The real userland SPM task rebinds this slot later.
#
# Feature: spm-winfs-llm-suite (Task 1 wiring).

use std.spec.{describe, it, expect, step}
use os.kernel.ipc.spm_port.{spm_port_is_registered, spm_port_registered_task, spm_port_reset}
use os.kernel.boot.init_services.{init_spm_port, spm_well_known_task_id}

describe("init_services spm_port wiring"):

    it("registers the SPM port during boot-time init"):
        # @req: REQ-UNIT-OS-001
        step("Verify: registers the SPM port during boot-time init")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        spm_port_reset()
        expect(spm_port_is_registered()).to_equal(false)
        val ok = init_spm_port()
        expect(ok).to_equal(true)
        expect(spm_port_is_registered()).to_equal(true)

    it("registers the well-known placeholder task id"):
        # @req: REQ-UNIT-OS-002
        step("Verify: registers the well-known placeholder task id")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        spm_port_reset()
        init_spm_port()
        expect(spm_port_registered_task()).to_equal(spm_well_known_task_id())

    it("well-known placeholder is non-zero (0 is the unregistered sentinel)"):
        # @req: REQ-UNIT-OS-003
        step("Verify: well-known placeholder is non-zero (0 is the unregistered sentinel)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val wk = spm_well_known_task_id()
        expect(wk != (0 as u64)).to_equal(true)

    it("init_spm_port is idempotent for the same placeholder id"):
        # @req: REQ-UNIT-OS-004
        step("Verify: init_spm_port is idempotent for the same placeholder id")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        spm_port_reset()
        val first = init_spm_port()
        val second = init_spm_port()
        expect(first).to_equal(true)
        expect(second).to_equal(true)
        expect(spm_port_registered_task()).to_equal(spm_well_known_task_id())
