"""
## Purpose and audience

# VMM VMA Operations Specification

**Feature IDs:** #OS-010
**Category:** Runtime
**Difficulty:** 3/5
**Status:** Implemented
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A

## Overview

Tests for VMA (Virtual Memory Area) data model and operations:
vma_add, vma_find, vma_remove, vma_split, overlap rejection.

Tests operate on ProcessVmSpace with stub pml4 values — no real page
tables are required. All assertions use type-level struct fields only.

This specification is maintained for compiler and library engineers reviewing UNIT-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/os/kernel/memory/vmm_vma_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec.{describe, it, expect, step}
use os.kernel.types.vmspace_types.{
    VmArea, ProcessVmSpace,
    VMA_ANON, VMA_FILE, VMA_SHARED,
    VMA_READ, VMA_WRITE, VMA_EXEC, VMA_COW
}
use os.kernel.memory.vmm_vma.{vma_add, vma_find, vma_remove, vma_split}

# ============================================================================
# Helpers
# ============================================================================

fn _make_space() -> ProcessVmSpace:
    """Create an empty ProcessVmSpace with a stub pml4 for testing."""
    ProcessVmSpace(
        pml4: 0xDEAD0000,
        id: 1,
        vma_count: 0,
        areas: []
    )

fn _make_anon(start: u64, len: u64) -> VmArea:
    """Create a basic anonymous RW VmArea."""
    VmArea(
        start: start,
        len: len,
        kind: VMA_ANON,
        flags: VMA_READ | VMA_WRITE,
        backing: 0,
        backing_offset: 0
    )

fn _make_file(start: u64, len: u64, backing: u64, offset: u64) -> VmArea:
    """Create a file-backed RX VmArea."""
    VmArea(
        start: start,
        len: len,
        kind: VMA_FILE,
        flags: VMA_READ | VMA_EXEC,
        backing: backing,
        backing_offset: offset
    )

# NOTE: vma_add/vma_find/vma_remove/vma_split below are the REAL product
# functions imported from os.kernel.memory.vmm_vma — no local reimplementation.
# `ProcessVmSpace` is a value type, so `vma_add`/`vma_split` return the
# updated space alongside a result code; tests below reassign `space` from
# that return value (see VmaAddResult/VmaSplitResult in vmm_vma.spl).

# ============================================================================
# Test Group 1: VmArea construction
# ============================================================================

describe "VmArea construction":
    it "creates anon area with correct fields":
        # @req: REQ-UNIT-OS-001
        step("Verify: creates anon area with correct fields")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val area = _make_anon(0x400000, 0x1000)
        expect(area.start).to_equal(0x400000)
        expect(area.len).to_equal(0x1000)
        expect(area.kind).to_equal(VMA_ANON)
        expect(area.flags).to_equal(VMA_READ | VMA_WRITE)

    it "creates file-backed area with backing handle":
        # @req: REQ-UNIT-OS-002
        step("Verify: creates file-backed area with backing handle")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val area = _make_file(0x600000, 0x2000, 42, 0x100)
        expect(area.kind).to_equal(VMA_FILE)
        expect(area.backing).to_equal(42)  # oracle: expected value 42 is the behavior asserted by this regression spec
        expect(area.backing_offset).to_equal(0x100)

    it "VMA_COW flag is distinct from VMA_WRITE":
        # @req: REQ-UNIT-OS-003
        step("Verify: VMA_COW flag is distinct from VMA_WRITE")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val cow_flags = VMA_READ | VMA_WRITE | VMA_COW
        expect(cow_flags & VMA_COW).to_be_greater_than(0)
        expect(cow_flags & VMA_WRITE).to_be_greater_than(0)
        expect(VMA_COW).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec

    it "VMA kind constants are distinct":
        # @req: REQ-UNIT-OS-004
        step("Verify: VMA kind constants are distinct")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(VMA_ANON).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(VMA_FILE).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(VMA_SHARED).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

# ============================================================================
# Test Group 2: ProcessVmSpace construction
# ============================================================================

describe "ProcessVmSpace construction":
    it "starts with zero VMAs":
        # @req: REQ-UNIT-OS-005
        step("Verify: starts with zero VMAs")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val space = _make_space()
        expect(space.vma_count).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "stores pml4 address":
        # @req: REQ-UNIT-OS-006
        step("Verify: stores pml4 address")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val space = _make_space()
        expect(space.pml4).to_equal(0xDEAD0000)

    it "stores id":
        # @req: REQ-UNIT-OS-007
        step("Verify: stores id")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val space = _make_space()
        expect(space.id).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

# ============================================================================
# Test Group 3: vma_add
# ============================================================================

describe "vma_add":
    it "adds single VMA — count becomes 1":
        # @req: REQ-UNIT-OS-008
        step("Verify: adds single VMA — count becomes 1")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var space = _make_space()
        val area = _make_anon(0x400000, 0x1000)
        val result = vma_add(space, area)
        space = result.space
        expect(result.code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(space.vma_count).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "adds two non-overlapping VMAs":
        # @req: REQ-UNIT-OS-009
        step("Verify: adds two non-overlapping VMAs")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var space = _make_space()
        val a1 = _make_anon(0x400000, 0x1000)
        val a2 = _make_anon(0x402000, 0x1000)
        val r1 = vma_add(space, a1)
        space = r1.space
        val r2 = vma_add(space, a2)
        space = r2.space
        expect(r1.code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(r2.code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(space.vma_count).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

    it "rejects overlapping VMA — returns -EEXIST":
        # @req: REQ-UNIT-OS-010
        step("Verify: rejects overlapping VMA — returns -EEXIST")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var space = _make_space()
        val a1 = _make_anon(0x400000, 0x2000)
        val a2 = _make_anon(0x401000, 0x1000)  # overlaps a1
        val r1 = vma_add(space, a1)
        space = r1.space
        val r2 = vma_add(space, a2)
        space = r2.space
        expect(r1.code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(r2.code).to_equal(-17)  # oracle: expected value -17 is the behavior asserted by this regression spec
        expect(space.vma_count).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "rejects VMA touching the end of existing one at exact boundary — no overlap":
        # @req: REQ-UNIT-OS-011
        step("Verify: rejects VMA touching the end of existing one at exact boundary — no overlap")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var space = _make_space()
        val a1 = _make_anon(0x400000, 0x1000)
        val a2 = _make_anon(0x401000, 0x1000)  # starts exactly at end of a1
        val r1 = vma_add(space, a1)
        space = r1.space
        val r2 = vma_add(space, a2)
        space = r2.space
        expect(r1.code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(r2.code).to_equal(0)   # adjacent, not overlapping
        expect(space.vma_count).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

# ============================================================================
# Test Group 4: vma_find
# ============================================================================

describe "vma_find":
    it "finds VMA by address inside it":
        # @req: REQ-UNIT-OS-012
        step("Verify: finds VMA by address inside it")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var space = _make_space()
        val area = _make_anon(0x400000, 0x4000)
        space = vma_add(space, area).space
        val found = vma_find(space, 0x401000)
        if val Some(a) = found:
            expect(a.start).to_equal(0x400000)
            expect(a.len).to_equal(0x4000)
        else:
            expect(0).to_equal(1)   # force failure if nil

    it "returns nil for unmapped address":
        # @req: REQ-UNIT-OS-013
        step("Verify: returns nil for unmapped address")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var space = _make_space()
        val area = _make_anon(0x400000, 0x1000)
        space = vma_add(space, area).space
        val found = vma_find(space, 0x800000)
        # 0x800000 is outside any VMA — vma_count stays 1 (nothing removed)
        expect(space.vma_count).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        if val Some(_a) = found:
            expect(0).to_equal(1)   # should be nil — fail if reached

    it "finds correct VMA among multiple":
        # @req: REQ-UNIT-OS-014
        step("Verify: finds correct VMA among multiple")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var space = _make_space()
        val a1 = _make_anon(0x400000, 0x1000)
        val a2 = _make_anon(0x402000, 0x1000)
        val a3 = _make_anon(0x500000, 0x2000)
        space = vma_add(space, a1).space
        space = vma_add(space, a2).space
        space = vma_add(space, a3).space
        val found = vma_find(space, 0x500800)
        if val Some(a) = found:
            expect(a.start).to_equal(0x500000)
        else:
            expect(0).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "does not find address exactly at end (exclusive)":
        # @req: REQ-UNIT-OS-015
        step("Verify: does not find address exactly at end (exclusive)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var space = _make_space()
        val area = _make_anon(0x400000, 0x1000)
        space = vma_add(space, area).space
        val found = vma_find(space, 0x401000)  # one byte past end
        # The VMA ends at 0x401000 (exclusive), so nothing should match
        expect(space.vma_count).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        if val Some(_a) = found:
            expect(0).to_equal(1)   # should be nil — fail if reached

# ============================================================================
# Test Group 5: vma_remove / split semantics
# ============================================================================

describe "vma_remove":
    it "removing entire VMA reduces count to 0":
        # @req: REQ-UNIT-OS-016
        step("Verify: removing entire VMA reduces count to 0")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var space = _make_space()
        val area = _make_anon(0x400000, 0x4000)
        space = vma_add(space, area).space
        expect(space.vma_count).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        val found_before = vma_find(space, 0x401000)
        if val Some(_a) = found_before:
            expect(_a.start).to_equal(0x400000)

        space = vma_remove(space, 0x400000, 0x4000)
        expect(space.vma_count).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        # After removal, vma_count is 0 — scan returns nil implicitly
        val found_after = vma_find(space, 0x401000)
        if val Some(_b) = found_after:
            expect(0).to_equal(1)   # should be nil — fail if reached

    it "splitting a VMA produces two smaller VMAs":
        # @req: REQ-UNIT-OS-017
        step("Verify: splitting a VMA produces two smaller VMAs")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var space = _make_space()
        val area = _make_anon(0x400000, 0x4000)
        space = vma_add(space, area).space

        val split_result = vma_split(space, 0x402000)
        space = split_result.space

        expect(split_result.code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(space.vma_count).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(space.areas[0].len).to_equal(0x2000)
        expect(space.areas[1].start).to_equal(0x402000)
        expect(space.areas[1].len).to_equal(0x2000)

    it "backing_offset of right fragment is correct after split":
        # @req: REQ-UNIT-OS-018
        step("Verify: backing_offset of right fragment is correct after split")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var space = _make_space()
        val area = _make_file(0x500000, 0x8000, 7, 0x1000)
        space = vma_add(space, area).space

        val split_result = vma_split(space, 0x504000)
        space = split_result.space

        expect(split_result.code).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(space.areas[1].backing_offset).to_equal(0x1000 + 0x4000)
