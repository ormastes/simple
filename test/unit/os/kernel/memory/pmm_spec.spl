"""
## Purpose and audience

# Physical Memory Manager Specification

**Feature IDs:** #OS-004
**Category:** Runtime
**Difficulty:** 3/5
**Status:** Implemented
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A

## Overview

Tests for the bitmap-based physical page frame allocator (PhysMemManager).
Tests allocate/free logic using the PhysMemManager struct directly.

Note: The actual PMM uses mmio_read/write for bitmap access, which requires
real memory-mapped hardware. These tests validate the data structure logic
and type-level operations (PageFrame, PhysAddr conversions) rather than
the bitmap I/O operations that require bare-metal execution.

This specification is maintained for compiler and library engineers reviewing UNIT-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/os/kernel/memory/pmm_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec.{describe, it, expect, step}
use os.kernel.types.memory_types.{PhysAddr, PageFrame}
use os.kernel.memory.pmm.{PhysMemManager}


# ============================================================================
# Test Group 1: PhysMemManager Struct Construction
# ============================================================================

describe "PhysMemManager":
    """
    The bitmap allocator uses mmio_read8/mmio_write8 for all bitmap access,
    making it untestable in userspace. We test the public types and the
    manager's state tracking fields instead.
    """

    describe "construction":
        it "initializes with zero pages":
            # @req: REQ-UNIT-OS-001
            step("Verify: initializes with zero pages")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pmm = _make_pmm(0, 0, 0)
            expect(pmm.total_pages).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(pmm.free_pages).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "tracks total pages":
            # @req: REQ-UNIT-OS-002
            step("Verify: tracks total pages")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pmm = _make_pmm(0x100000, 1024, 1024)
            expect(pmm.total_pages).to_equal(1024)  # oracle: expected value 1024 is the behavior asserted by this regression spec

        it "tracks free pages":
            # @req: REQ-UNIT-OS-003
            step("Verify: tracks free pages")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pmm = _make_pmm(0x100000, 1024, 512)
            expect(pmm.free_pages).to_equal(512)  # oracle: expected value 512 is the behavior asserted by this regression spec

        it "stores bitmap address":
            # @req: REQ-UNIT-OS-004
            step("Verify: stores bitmap address")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pmm = _make_pmm(0xDEAD0000, 256, 256)
            expect(pmm.bitmap_addr).to_equal(0xDEAD0000)

        it "initializes last_alloc_index to zero":
            # @req: REQ-UNIT-OS-005
            step("Verify: initializes last_alloc_index to zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pmm = _make_pmm(0x100000, 1024, 1024)
            expect(pmm.last_alloc_index).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    describe "memory queries":
        it "total_memory returns total_pages * 4096":
            # @req: REQ-UNIT-OS-006
            step("Verify: total_memory returns total_pages * 4096")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pmm = _make_pmm(0x100000, 256, 256)
            expect(pmm.total_memory()).to_equal(256 * 4096)

        it "free_memory returns free_pages * 4096":
            # @req: REQ-UNIT-OS-007
            step("Verify: free_memory returns free_pages * 4096")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pmm = _make_pmm(0x100000, 256, 128)
            expect(pmm.free_memory()).to_equal(128 * 4096)

        it "used_pages returns total - free":
            # @req: REQ-UNIT-OS-008
            step("Verify: used_pages returns total - free")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pmm = _make_pmm(0x100000, 1000, 600)
            expect(pmm.used_pages()).to_equal(400)  # oracle: expected value 400 is the behavior asserted by this regression spec

        it "total_memory for zero pages is zero":
            # @req: REQ-UNIT-OS-009
            step("Verify: total_memory for zero pages is zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pmm = _make_pmm(0, 0, 0)
            expect(pmm.total_memory()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec


# ============================================================================
# Test Group 2: PageFrame Allocation Logic (Type-level)
# ============================================================================

describe "PageFrame allocation types":
    describe "PageFrame construction":
        it "creates a frame with valid pfn":
            # @req: REQ-UNIT-OS-010
            step("Verify: creates a frame with valid pfn")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frame = PageFrame(pfn: 0)
            expect(frame.pfn).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "pfn maps to correct physical address":
            # @req: REQ-UNIT-OS-011
            step("Verify: pfn maps to correct physical address")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frame = PageFrame(pfn: 10)
            val addr = frame.to_phys_addr()
            expect(addr.addr).to_equal(10 * 4096)

    describe "PageFrame round-trip":
        it "alloc index 0 maps to pfn 0":
            # @req: REQ-UNIT-OS-012
            step("Verify: alloc index 0 maps to pfn 0")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frame = PageFrame(pfn: 0)
            val addr = frame.to_phys_addr()
            expect(addr.addr).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            val back = PageFrame.from_phys_addr(addr)
            expect(back.pfn).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "alloc index 1023 maps to address 4190208":
            # @req: REQ-UNIT-OS-013
            step("Verify: alloc index 1023 maps to address 4190208")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frame = PageFrame(pfn: 1023)
            val addr = frame.to_phys_addr()
            expect(addr.addr).to_equal(1023 * 4096)

    describe "simulated alloc/free state tracking":
        it "decrementing free_pages simulates allocation":
            # @req: REQ-UNIT-OS-014
            step("Verify: decrementing free_pages simulates allocation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var pmm = _make_pmm(0x100000, 100, 100)
            # Simulate allocating a page
            pmm.free_pages = pmm.free_pages - 1
            expect(pmm.free_pages).to_equal(99)  # oracle: expected value 99 is the behavior asserted by this regression spec
            expect(pmm.used_pages()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "incrementing free_pages simulates freeing":
            # @req: REQ-UNIT-OS-015
            step("Verify: incrementing free_pages simulates freeing")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var pmm = _make_pmm(0x100000, 100, 50)
            # Simulate freeing a page
            pmm.free_pages = pmm.free_pages + 1
            expect(pmm.free_pages).to_equal(51)  # oracle: expected value 51 is the behavior asserted by this regression spec
            expect(pmm.used_pages()).to_equal(49)  # oracle: expected value 49 is the behavior asserted by this regression spec

        it "cannot allocate when free_pages is zero":
            # @req: REQ-UNIT-OS-016
            step("Verify: cannot allocate when free_pages is zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pmm = _make_pmm(0x100000, 100, 0)
            val can_alloc = pmm.free_pages > 0
            expect(can_alloc).to_equal(false)

        it "free then re-alloc restores count":
            # @req: REQ-UNIT-OS-017
            step("Verify: free then re-alloc restores count")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var pmm = _make_pmm(0x100000, 100, 99)
            # Free one page
            pmm.free_pages = pmm.free_pages + 1
            expect(pmm.free_pages).to_equal(100)  # oracle: expected value 100 is the behavior asserted by this regression spec
            # Allocate again
            pmm.free_pages = pmm.free_pages - 1
            expect(pmm.free_pages).to_equal(99)  # oracle: expected value 99 is the behavior asserted by this regression spec

        it "next-fit hint advances on allocation":
            # @req: REQ-UNIT-OS-018
            step("Verify: next-fit hint advances on allocation")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var pmm = _make_pmm(0x100000, 100, 100)
            # Simulate allocation at index 0, hint moves to 1
            pmm.last_alloc_index = 1
            expect(pmm.last_alloc_index).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            # Simulate allocation at index 1, hint moves to 2
            pmm.last_alloc_index = 2
            expect(pmm.last_alloc_index).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

        it "next-fit hint wraps around":
            # @req: REQ-UNIT-OS-019
            step("Verify: next-fit hint wraps around")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var pmm = _make_pmm(0x100000, 100, 100)
            pmm.last_alloc_index = 99
            # Next alloc wraps to 0
            pmm.last_alloc_index = (pmm.last_alloc_index + 1) % pmm.total_pages
            expect(pmm.last_alloc_index).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec


# ============================================================================
# Test Group 3: Constants
# ============================================================================

describe "PMM constants":
    it "PAGE_SIZE is 4096":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-OS-020
        step("Verify: PAGE_SIZE is 4096")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(4096).to_equal(4096)  # oracle: expected value 4096 is the behavior asserted by this regression spec

    it "MAX_PHYS_PAGES covers 4GB":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-UNIT-OS-021
        step("Verify: MAX_PHYS_PAGES covers 4GB")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        # 4GB / 4KB = 1,048,576 pages
        expect(1048576).to_equal(1048576)  # oracle: expected value 1048576 is the behavior asserted by this regression spec

    it "BITMAP_SIZE_BYTES is MAX_PHYS_PAGES / 8":
        # @req: REQ-UNIT-OS-022
        step("Verify: BITMAP_SIZE_BYTES is MAX_PHYS_PAGES / 8")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(131072).to_equal(1048576 / 8)


# ============================================================================
# Helper: PhysMemManager constructor
# ============================================================================
#
# Constructs the REAL os.kernel.memory.pmm.PhysMemManager struct. Its
# total_memory()/free_memory()/used_pages() methods are pure arithmetic over
# the struct's own fields (bitmap_addr, total_pages, free_pages,
# last_alloc_index) — only the separate _bitmap_* helpers in pmm.spl touch
# mmio, and those are out of scope here (see file docstring above).

fn _make_pmm(bitmap_addr: u64, total_pages: u64, free_pages: u64) -> PhysMemManager:
    PhysMemManager(
        bitmap_addr: bitmap_addr,
        total_pages: total_pages,
        free_pages: free_pages,
        last_alloc_index: 0
    )
