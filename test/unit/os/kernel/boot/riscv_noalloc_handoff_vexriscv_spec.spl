"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/os/kernel/boot/riscv_noalloc_handoff_vexriscv_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/os/kernel/boot/riscv_noalloc_handoff.spl 0%
"""
# RiscvNoallocHandoff Memory Map Parameterization Specification

**Feature IDs:** opensource-riscv-rtl-simpleos
**Category:** Infrastructure
**Difficulty:** 2/5
**Status:** Draft
**Requirements:** REQ-6
**Artifacts:** N/A

## Overview

Verifies AC-6: riscv_noalloc_handoff accepts board-specific layouts through the
RISC-V64 arch adapter so the boot chain works for both K26 (Kria) and
DE10-Nano (LiteX) without hard-coded addresses in the handoff module. Tests
that the layout struct produced for each board has correct fields.

Covers:
- AC-6 (Scheduler/handoff parameterization for real-hardware idle loop)
"""

use std.spipe.*
use os.kernel.boot.riscv_noalloc_handoff.{
    RiscvMemoryLayout,
    riscv_noalloc_layout_from_kria,
    riscv_noalloc_layout_from_litex
}


# ============================================================================
# Helpers
# ============================================================================

fn kria_layout() -> RiscvMemoryLayout:
    return riscv_noalloc_layout_from_kria()

fn litex_layout() -> RiscvMemoryLayout:
    return riscv_noalloc_layout_from_litex()


# ============================================================================
# AC-6: Kria memory layout
# ============================================================================

describe "RiscvNoallocHandoff Kria layout":
    it "AC-6: Kria layout uart_base matches KriaFpgaMemoryMap":
        # @req: REQ-UNIT-OS-001
            # @req: REQ-6
        step("Verify: AC-6: Kria layout uart_base matches KriaFpgaMemoryMap")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val layout = kria_layout()
        expect(layout.uart_base).to_equal(268435456)  # oracle: expected value 268435456 is the behavior asserted by this regression spec

    it "AC-6: Kria layout ram_base is 0x80000000":
        # @req: REQ-UNIT-OS-002
        step("Verify: AC-6: Kria layout ram_base is 0x80000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val layout = kria_layout()
        expect(layout.ram_base).to_equal(2147483648)  # oracle: expected value 2147483648 is the behavior asserted by this regression spec

    it "AC-6: Kria layout heap_start is 0x87000000":
        # @req: REQ-UNIT-OS-003
        step("Verify: AC-6: Kria layout heap_start is 0x87000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val layout = kria_layout()
        expect(layout.heap_start).to_equal(2264924160)  # oracle: expected value 2264924160 is the behavior asserted by this regression spec

    it "AC-6: Kria layout heap_size is 16MB":
        # @req: REQ-UNIT-OS-004
        step("Verify: AC-6: Kria layout heap_size is 16MB")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val layout = kria_layout()
        expect(layout.heap_size).to_equal(16777216)  # oracle: expected value 16777216 is the behavior asserted by this regression spec


# ============================================================================
# AC-6: LiteX memory layout
# ============================================================================

describe "RiscvNoallocHandoff LiteX layout":
    it "AC-6: LiteX layout uart_base is 0xf0001000":
        # @req: REQ-UNIT-OS-005
        step("Verify: AC-6: LiteX layout uart_base is 0xf0001000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val layout = litex_layout()
        expect(layout.uart_base).to_equal(4026535936)  # oracle: expected value 4026535936 is the behavior asserted by this regression spec

    it "AC-6: LiteX layout ram_base is 0x40000000":
        # @req: REQ-UNIT-OS-006
        step("Verify: AC-6: LiteX layout ram_base is 0x40000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val layout = litex_layout()
        expect(layout.ram_base).to_equal(1073741824)  # oracle: expected value 1073741824 is the behavior asserted by this regression spec

    it "AC-6: LiteX layout heap_start is 0x4f000000":
        # @req: REQ-UNIT-OS-007
        step("Verify: AC-6: LiteX layout heap_start is 0x4f000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val layout = litex_layout()
        expect(layout.heap_start).to_equal(1325400064)  # oracle: expected value 1325400064 is the behavior asserted by this regression spec

    it "AC-6: LiteX and Kria uart_base differ":
        # @req: REQ-UNIT-OS-008
        step("Verify: AC-6: LiteX and Kria uart_base differ")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val kria = kria_layout()
        val litex = litex_layout()
        expect(kria.uart_base).to_equal(268435456)  # oracle: expected value 268435456 is the behavior asserted by this regression spec
        expect(litex.uart_base).to_equal(4026535936)  # oracle: expected value 4026535936 is the behavior asserted by this regression spec
