use std.spec.{describe, it, expect}
use os.kernel.loader.x86_64_fs_exec_spawn.{
    x86_64_fs_exec_spawn,
    x86_64_fs_exec_spawn_as,
    x86_64_fs_exec_spawn_scheduler_owned,
    x86_64_fs_exec_spawn_heap
}

describe "x86_64 authenticated filesystem execution gate":
    it "rejects all path-only compatibility entrypoints":
        expect(x86_64_fs_exec_spawn(
            "/sys/apps/unsigned.elf", [], [])).to_equal(-13)
        expect(x86_64_fs_exec_spawn_as(
            0, "/sys/apps/unsigned.elf", [], [])).to_equal(-13)
        expect(x86_64_fs_exec_spawn_scheduler_owned(
            "/sys/apps/unsigned.elf", [], [])).to_equal(-13)
        expect(x86_64_fs_exec_spawn_heap(
            "/sys/apps/unsigned.elf", [], [])).to_equal(-13)
