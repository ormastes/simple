# @req: REQ-OS-KERNEL-001

"""
# SMF parser
**Feature IDs:** #WAVE2-G10
**Category:** Kernel loader

Verifies magic check + header parse of the minimal SMF loader.
"""
use std.spec.*
use os.kernel.arch.arch_context.{Architecture}
use os.kernel.loader.smf.{
    smf_check_magic, smf_has_header, smf_header_offset, smf_parse_header,
    smf_extract_executable_stub, smf_extract_executable_stub_for_arch,
    SMF64_MAGIC_0, SMF64_MAGIC_1, SMF64_MAGIC_2, SMF64_MAGIC_3,
    SMF_HEADER_TRAILER_SIZE, SMF_ERR_MALFORMED, SMF_ERR_WRONG_ROLE,
    SMF_ERR_WRONG_ARCH, SMF_ERR_ABI_MISMATCH, SMF_ERR_MISSING_ELF
}

fn _empty() -> [u8]:
    """Zero bytes — too short for any SMF."""
    var b: [u8] = []
    b

fn _good_magic() -> [u8]:
    """Minimum-length buffer starting with the SMF magic bytes."""
    var b: [u8] = []
    b.push(SMF64_MAGIC_0)
    b.push(SMF64_MAGIC_1)
    b.push(SMF64_MAGIC_2)
    b.push(SMF64_MAGIC_3)
    var i = 4
    while i < (SMF_HEADER_TRAILER_SIZE as i32):
        b.push(0u8)
        i = i + 1
    b

fn _trailer_magic() -> [u8]:
    """Full v1.1-style SMF bytes with payload before the header trailer."""
    var b: [u8] = [1u8, 2u8, 3u8, 4u8, 5u8]
    b.push(SMF64_MAGIC_0)
    b.push(SMF64_MAGIC_1)
    b.push(SMF64_MAGIC_2)
    b.push(SMF64_MAGIC_3)
    var i = 4
    while i < 44:
        b.push(0u8)
        i = i + 1
    b.push(52u8)  # entry_point low byte at header offset 44
    i = 45
    while i < 52:
        b.push(0u8)
        i = i + 1
    b.push(5u8)   # stub_size low byte
    b.push(0u8)
    b.push(0u8)
    b.push(0u8)
    b.push(5u8)   # smf_data_offset low byte
    b.push(0u8)
    b.push(0u8)
    b.push(0u8)
    while b.len() < 5 + (SMF_HEADER_TRAILER_SIZE as i32):
        b.push(0u8)
    b

fn _elf_stub_smf() -> [u8]:
    """SMF envelope whose executable stub starts with ELF magic."""
    var b: [u8] = [0x7Fu8, 0x45u8, 0x4Cu8, 0x46u8, 2u8, 1u8, 1u8, 0u8]
    val stub_len = b.len()
    b.push(SMF64_MAGIC_0)
    b.push(SMF64_MAGIC_1)
    b.push(SMF64_MAGIC_2)
    b.push(SMF64_MAGIC_3)
    var i = 4
    while i < 44:
        b.push(0u8)
        i = i + 1
    b.push(0u8)
    i = 45
    while i < 52:
        b.push(0u8)
        i = i + 1
    b.push(stub_len as u8)
    b.push(0u8)
    b.push(0u8)
    b.push(0u8)
    b.push(stub_len as u8)
    b.push(0u8)
    b.push(0u8)
    b.push(0u8)
    while b.len() < stub_len + (SMF_HEADER_TRAILER_SIZE as i32):
        b.push(0u8)
    b

fn _set_header_byte(bytes: [u8], relative_offset: i64, value: u8) -> [u8]:
    var out = bytes
    val header_offset = out.len() - (SMF_HEADER_TRAILER_SIZE as i32)
    out[header_offset + (relative_offset as i32)] = value
    out

use std.spec.step

describe "smf_check_magic":
    """Magic validation."""

    it "rejects an empty buffer":
        # @req: REQ-OS-KERNEL-001
        step("Verify: rejects an empty buffer")
        """Empty input cannot carry magic bytes."""
        expect(smf_check_magic(_empty())).to_equal(false)

    it "accepts a buffer starting with the SMF magic bytes":
        # @req: REQ-OS-KERNEL-001
        step("Verify: accepts a buffer starting with the SMF magic bytes")
        """A conforming prefix is required for smf_load to proceed."""
        expect(smf_check_magic(_good_magic())).to_equal(true)

    it "does not treat trailer-only SMF as offset-zero magic":
        # @req: REQ-OS-KERNEL-001
        step("Verify: does not treat trailer-only SMF as offset-zero magic")
        """Offset-zero checks stay strict for legacy callers."""
        expect(smf_check_magic(_trailer_magic())).to_equal(false)

describe "smf_has_header":
    """Header location detection."""

    it "accepts a v1.1 trailer header":
        # @req: REQ-OS-KERNEL-001
        step("Verify: accepts a v1.1 trailer header")
        """The kernel loader should sniff the same EOF-128 header as the compiler loader."""
        expect(smf_has_header(_trailer_magic())).to_equal(true)
        expect(smf_header_offset(_trailer_magic())).to_equal(5)  # oracle: 5 — named expected value from the requirement

describe "smf_parse_header":
    """Header parsing either yields a descriptor or nil."""

    it "returns nil on an empty buffer":
        # @req: REQ-OS-KERNEL-001
        step("Verify: returns nil on an empty buffer")
        """Too-short input must be rejected without crashing."""
        val h = smf_parse_header(_empty())
        expect(h).to_be_nil()

    it "parses v1.1 trailer header fields":
        # @req: REQ-OS-KERNEL-001
        step("Verify: parses v1.1 trailer header fields")
        """Entry and stub metadata come from the trailer, not byte zero."""
        val h = smf_parse_header(_trailer_magic())
        expect(h).to_not_be_nil()
        val parsed = h.unwrap()
        expect(parsed.header_offset).to_equal(5i64)
        expect(parsed.entry_point).to_equal(52i64)
        expect(parsed.stub_size).to_equal(5i64)
        expect(parsed.smf_data_offset).to_equal(5i64)

    it "magic constants spell 'SMF\\0'":
        # @req: REQ-OS-KERNEL-001
        step("Verify: magic constants spell 'SMF0'")
        """Pin the magic-byte assignment so accidental refactors fail here."""
        expect(SMF64_MAGIC_0).to_equal(83u8)
        expect(SMF64_MAGIC_1).to_equal(77u8)
        expect(SMF64_MAGIC_2).to_equal(70u8)
        expect(SMF64_MAGIC_3).to_equal(0u8)

describe "smf_extract_executable_stub":
    """Executable-stub extraction for SMF-as-package loading."""

    it "extracts an ELF executable stub from a trailer SMF":
        # @req: REQ-OS-KERNEL-001
        step("Verify: extracts an ELF executable stub from a trailer SMF")
        val stub = smf_extract_executable_stub(_elf_stub_smf())
        expect(stub.is_ok()).to_equal(true)
        val bytes = stub.unwrap()
        expect(bytes.len()).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(bytes[0]).to_equal(0x7Fu8)
        expect(bytes[1]).to_equal(0x45u8)
        expect(bytes[2]).to_equal(0x4Cu8)
        expect(bytes[3]).to_equal(0x46u8)

    it "rejects SMF payloads that do not carry an ELF stub":
        # @req: REQ-OS-KERNEL-001
        step("Verify: rejects SMF payloads that do not carry an ELF stub")
        val stub = smf_extract_executable_stub(_trailer_magic())
        expect(stub.is_err()).to_equal(true)

    it "returns typed errors for malformed packages":
        # @req: REQ-OS-KERNEL-001
        step("Verify: returns typed errors for malformed packages")
        val stub = smf_extract_executable_stub(_empty())
        expect(stub.is_err()).to_equal(true)
        expect(stub.err().unwrap()).to_equal(SMF_ERR_MALFORMED)

    it "returns typed errors for wrong role":
        # @req: REQ-OS-KERNEL-001
        step("Verify: returns typed errors for wrong role")
        val package = _set_header_byte(_elf_stub_smf(), 60, 2u8)
        val stub = smf_extract_executable_stub_for_arch(package, Architecture.X86_64)
        expect(stub.is_err()).to_equal(true)
        expect(stub.err().unwrap()).to_equal(SMF_ERR_WRONG_ROLE)

    it "returns typed errors for wrong architecture":
        # @req: REQ-OS-KERNEL-001
        step("Verify: returns typed errors for wrong architecture")
        val package = _set_header_byte(_elf_stub_smf(), 61, 5u8)
        val stub = smf_extract_executable_stub_for_arch(package, Architecture.X86_64)
        expect(stub.is_err()).to_equal(true)
        expect(stub.err().unwrap()).to_equal(SMF_ERR_WRONG_ARCH)

    it "returns typed errors for ABI mismatch":
        # @req: REQ-OS-KERNEL-001
        step("Verify: returns typed errors for ABI mismatch")
        val package = _set_header_byte(_elf_stub_smf(), 62, 9u8)
        val stub = smf_extract_executable_stub_for_arch(package, Architecture.X86_64)
        expect(stub.is_err()).to_equal(true)
        expect(stub.err().unwrap()).to_equal(SMF_ERR_ABI_MISMATCH)

    it "returns typed errors for missing embedded ELF":
        # @req: REQ-OS-KERNEL-001
        step("Verify: returns typed errors for missing embedded ELF")
        val stub = smf_extract_executable_stub_for_arch(_trailer_magic(), Architecture.X86_64)
        expect(stub.is_err()).to_equal(true)
        expect(stub.err().unwrap()).to_equal(SMF_ERR_MISSING_ELF)
