"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/os/kernel/wine/kernel_vm_fault_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Spec for kernel_vm_fault — demand-paging page-fault handler (M1, REQ-4).
#
# These specs lock the public API surface and invariants for:
#   src/lib/nogc_async_mut_noalloc/baremetal/vm_fault.spl
#
# Tests are in the red phase: the implementation does not yet exist.
# Run with:
#   bin/simple test test/unit/os/kernel/wine/kernel_vm_fault_spec.spl
#
# @cover src/lib/nogc_async_mut_noalloc/baremetal/vm_fault.spl

use std.spec
use std.nogc_async_mut_noalloc.baremetal.vm_fault.{
    vm_fault_handle,
    vm_fault_map_anonymous,
    vm_fault_register_vma,
    vm_fault_unregister_vma,
    VmaKind
}

describe "kernel_vm_fault — demand-paging handler":

    describe "AC-4: VmaKind constants":
        it "AC-4: anonymous VMA kind value is defined":
            # @req: REQ-UNIT-OS-001
                # @req: REQ-4
            step("Verify: AC-4: anonymous VMA kind value is defined")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val k = VmaKind.anonymous
            expect(k).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "AC-4: guard VMA kind value is defined":
            # @req: REQ-UNIT-OS-002
            step("Verify: AC-4: guard VMA kind value is defined")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val k = VmaKind.guard
            expect(k).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "AC-4: copy-on-write VMA kind value is defined":
            # @req: REQ-UNIT-OS-003
            step("Verify: AC-4: copy-on-write VMA kind value is defined")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val k = VmaKind.copy_on_write
            expect(k).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

        it "AC-4: file-backed VMA kind value is defined":
            # @req: REQ-UNIT-OS-004
            step("Verify: AC-4: file-backed VMA kind value is defined")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val k = VmaKind.file_backed
            expect(k).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

    describe "AC-4: vm_fault_register_vma — VMA region registration":
        it "AC-4: register_vma accepts base, size, and kind without error":
            # @req: REQ-UNIT-OS-005
            step("Verify: AC-4: register_vma accepts base, size, and kind without error")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # base=0x10000, size=4096 (one page), kind=anonymous
            val ok = vm_fault_register_vma(0x10000, 4096, VmaKind.anonymous)
            expect(ok).to_equal(true)

        it "AC-4: register_vma with guard kind marks the region as guard":
            # @req: REQ-UNIT-OS-006
            step("Verify: AC-4: register_vma with guard kind marks the region as guard")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ok = vm_fault_register_vma(0x20000, 4096, VmaKind.guard)
            expect(ok).to_equal(true)

        it "AC-4: register_vma with copy-on-write kind succeeds":
            # @req: REQ-UNIT-OS-007
            step("Verify: AC-4: register_vma with copy-on-write kind succeeds")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ok = vm_fault_register_vma(0x30000, 4096, VmaKind.copy_on_write)
            expect(ok).to_equal(true)

        it "AC-4: register_vma rejects zero-size region":
            # @req: REQ-UNIT-OS-008
            step("Verify: AC-4: register_vma rejects zero-size region")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ok = vm_fault_register_vma(0x40000, 0, VmaKind.anonymous)
            expect(ok).to_equal(false)

    describe "AC-4: vm_fault_map_anonymous — page allocation":
        it "AC-4: map_anonymous returns a non-zero physical frame address":
            # @req: REQ-UNIT-OS-009
            step("Verify: AC-4: map_anonymous returns a non-zero physical frame address")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val frame_pa = vm_fault_map_anonymous(0x10000)
            expect(frame_pa).to_be_greater_than(0)

        it "AC-4: map_anonymous for same vaddr in guard region returns zero (fault)":
            # @req: REQ-UNIT-OS-010
            step("Verify: AC-4: map_anonymous for same vaddr in guard region returns zero (fault)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Guard region: expected to return 0 (access fault / kill signal)
            vm_fault_register_vma(0x50000, 4096, VmaKind.guard)
            val result = vm_fault_map_anonymous(0x50000)
            expect(result).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    describe "AC-4: vm_fault_handle — fault dispatch":
        it "AC-4: handle on registered anonymous region succeeds with FaultResult.mapped":
            # @req: REQ-UNIT-OS-011
            step("Verify: AC-4: handle on registered anonymous region succeeds with FaultResult.mapped")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            vm_fault_register_vma(0x60000, 4096, VmaKind.anonymous)
            val result = vm_fault_handle(0x60000, false)
            expect(result).to_equal("mapped")

        it "AC-4: handle on guard region returns FaultResult.kill":
            # @req: REQ-UNIT-OS-012
            step("Verify: AC-4: handle on guard region returns FaultResult.kill")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            vm_fault_register_vma(0x70000, 4096, VmaKind.guard)
            val result = vm_fault_handle(0x70000, false)
            expect(result).to_equal("kill")

        it "AC-4: handle on unregistered region returns FaultResult.unhandled":
            # @req: REQ-UNIT-OS-013
            step("Verify: AC-4: handle on unregistered region returns FaultResult.unhandled")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # An address with no VMA registered
            val result = vm_fault_handle(0xDEAD0000, false)
            expect(result).to_equal("unhandled")

        it "AC-4: handle on copy-on-write region with write fault returns FaultResult.mapped":
            # @req: REQ-UNIT-OS-014
            step("Verify: AC-4: handle on copy-on-write region with write fault returns FaultResult.mapped")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            vm_fault_register_vma(0x80000, 4096, VmaKind.copy_on_write)
            val result = vm_fault_handle(0x80000, true)
            expect(result).to_equal("mapped")

    describe "AC-4: vm_fault_unregister_vma — VMA deregistration":
        it "AC-4: unregister removes the region so faults become unhandled":
            # @req: REQ-UNIT-OS-015
            step("Verify: AC-4: unregister removes the region so faults become unhandled")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            vm_fault_register_vma(0x90000, 4096, VmaKind.anonymous)
            val before = vm_fault_handle(0x90000, false)
            expect(before).to_equal("mapped")
            vm_fault_unregister_vma(0x90000, 4096)
            val after = vm_fault_handle(0x90000, false)
            expect(after).to_equal("unhandled")
