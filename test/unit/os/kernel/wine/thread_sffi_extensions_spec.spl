"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/os/kernel/wine/thread_sffi_extensions_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Spec for thread_sffi extensions — TLS keys, semaphore, event-wait (M1, REQ-3).
#
# These specs cover the new functions added to:
#   src/lib/nogc_async_mut/thread_sffi.spl
#
# Tests are in the red phase: the new functions do not yet exist.
# Run with:
#   bin/simple test test/unit/os/kernel/wine/thread_sffi_extensions_spec.spl
#
# @cover src/lib/nogc_async_mut/thread_sffi.spl

use std.spec
use std.nogc_async_mut.thread_sffi.{
    tls_key_alloc,
    tls_key_set,
    tls_key_get,
    semaphore_create,
    semaphore_post,
    semaphore_wait,
    event_wait_create,
    event_wait_set,
    event_wait_reset,
    event_wait_wait
}

describe "thread_sffi extensions — TLS keys, semaphore, event-wait":

    describe "AC-3: tls_key_alloc / set / get — per-thread storage":
        it "AC-3: tls_key_alloc returns a positive key":
            # @req: REQ-UNIT-OS-001
                # @req: REQ-3
            step("Verify: AC-3: tls_key_alloc returns a positive key")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn no_destructor(p: *void) -> void:
                val _ = 0
            val key = tls_key_alloc(no_destructor)
            expect(key).to_be_greater_than(0)

        it "AC-3: consecutive tls_key_alloc calls return distinct keys":
            # @req: REQ-UNIT-OS-002
            step("Verify: AC-3: consecutive tls_key_alloc calls return distinct keys")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn no_destructor(p: *void) -> void:
                val _ = 0
            val k1 = tls_key_alloc(no_destructor)
            val k2 = tls_key_alloc(no_destructor)
            expect(k1).to_not_equal(k2)

        it "AC-3: tls_key_set and tls_key_get round-trip a value":
            # @req: REQ-UNIT-OS-003
            step("Verify: AC-3: tls_key_set and tls_key_get round-trip a value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn no_destructor(p: *void) -> void:
                val _ = 0
            val key = tls_key_alloc(no_destructor)
            tls_key_set(key, 0xABCD)
            val got = tls_key_get(key)
            expect(got).to_equal(0xABCD)

        it "AC-3: tls_key_get on unused key returns null (0)":
            # @req: REQ-UNIT-OS-004
            step("Verify: AC-3: tls_key_get on unused key returns null (0)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn no_destructor(p: *void) -> void:
                val _ = 0
            val key = tls_key_alloc(no_destructor)
            val got = tls_key_get(key)
            expect(got).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "AC-3: tls_key_set overwrite updates the stored value":
            # @req: REQ-UNIT-OS-005
            step("Verify: AC-3: tls_key_set overwrite updates the stored value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn no_destructor(p: *void) -> void:
                val _ = 0
            val key = tls_key_alloc(no_destructor)
            tls_key_set(key, 0x11)
            tls_key_set(key, 0x22)
            val got = tls_key_get(key)
            expect(got).to_equal(0x22)

    describe "AC-3: semaphore — create / post / wait":
        it "AC-3: semaphore_create with initial=0 returns a valid handle":
            # @req: REQ-UNIT-OS-006
            step("Verify: AC-3: semaphore_create with initial=0 returns a valid handle")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val h = semaphore_create(0)
            expect(h).to_be_greater_than(0)

        it "AC-3: semaphore_create with initial=1 returns a valid handle":
            # @req: REQ-UNIT-OS-007
            step("Verify: AC-3: semaphore_create with initial=1 returns a valid handle")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val h = semaphore_create(1)
            expect(h).to_be_greater_than(0)

        it "AC-3: semaphore_create returns distinct handles":
            # @req: REQ-UNIT-OS-008
            step("Verify: AC-3: semaphore_create returns distinct handles")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val h1 = semaphore_create(0)
            val h2 = semaphore_create(0)
            expect(h1).to_not_equal(h2)

        it "AC-3: semaphore_wait with initial=1 and timeout_ns=0 returns signaled":
            # @req: REQ-UNIT-OS-009
            step("Verify: AC-3: semaphore_wait with initial=1 and timeout_ns=0 returns signaled")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val h = semaphore_create(1)
            val result = semaphore_wait(h, 0)
            expect(result).to_equal("signaled")

        it "AC-3: semaphore_wait on zero-count semaphore with timeout_ns=0 returns timeout":
            # @req: REQ-UNIT-OS-010
            step("Verify: AC-3: semaphore_wait on zero-count semaphore with timeout_ns=0 returns timeout")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val h = semaphore_create(0)
            val result = semaphore_wait(h, 0)
            expect(result).to_equal("timeout")

        it "AC-3: semaphore_post followed by semaphore_wait returns signaled":
            # @req: REQ-UNIT-OS-011
            step("Verify: AC-3: semaphore_post followed by semaphore_wait returns signaled")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val h = semaphore_create(0)
            semaphore_post(h)
            val result = semaphore_wait(h, 0)
            expect(result).to_equal("signaled")

        it "AC-3: semaphore count decrements after successful wait":
            # @req: REQ-UNIT-OS-012
            step("Verify: AC-3: semaphore count decrements after successful wait")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val h = semaphore_create(1)
            val r1 = semaphore_wait(h, 0)
            expect(r1).to_equal("signaled")
            # Count is now 0; next wait should timeout
            val r2 = semaphore_wait(h, 0)
            expect(r2).to_equal("timeout")

    describe "AC-3: event_wait — create / set / reset / wait":
        it "AC-3: event_wait_create with manual_reset=false returns a valid handle":
            # @req: REQ-UNIT-OS-013
            step("Verify: AC-3: event_wait_create with manual_reset=false returns a valid handle")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val h = event_wait_create(false)
            expect(h).to_be_greater_than(0)

        it "AC-3: event_wait_create with manual_reset=true returns a valid handle":
            # @req: REQ-UNIT-OS-014
            step("Verify: AC-3: event_wait_create with manual_reset=true returns a valid handle")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val h = event_wait_create(true)
            expect(h).to_be_greater_than(0)

        it "AC-3: event_wait_wait on unset event with timeout_ns=0 returns timeout":
            # @req: REQ-UNIT-OS-015
            step("Verify: AC-3: event_wait_wait on unset event with timeout_ns=0 returns timeout")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val h = event_wait_create(false)
            val result = event_wait_wait(h, 0)
            expect(result).to_equal("timeout")

        it "AC-3: event_wait_set then event_wait_wait returns signaled":
            # @req: REQ-UNIT-OS-016
            step("Verify: AC-3: event_wait_set then event_wait_wait returns signaled")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val h = event_wait_create(false)
            event_wait_set(h)
            val result = event_wait_wait(h, 0)
            expect(result).to_equal("signaled")

        it "AC-3: manual-reset event remains set after first wait":
            # @req: REQ-UNIT-OS-017
            step("Verify: AC-3: manual-reset event remains set after first wait")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val h = event_wait_create(true)
            event_wait_set(h)
            val r1 = event_wait_wait(h, 0)
            expect(r1).to_equal("signaled")
            val r2 = event_wait_wait(h, 0)
            expect(r2).to_equal("signaled")

        it "AC-3: auto-reset event is consumed after first wait":
            # @req: REQ-UNIT-OS-018
            step("Verify: AC-3: auto-reset event is consumed after first wait")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val h = event_wait_create(false)
            event_wait_set(h)
            val r1 = event_wait_wait(h, 0)
            expect(r1).to_equal("signaled")
            val r2 = event_wait_wait(h, 0)
            expect(r2).to_equal("timeout")

        it "AC-3: event_wait_reset on set event causes next wait to timeout":
            # @req: REQ-UNIT-OS-019
            step("Verify: AC-3: event_wait_reset on set event causes next wait to timeout")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val h = event_wait_create(true)
            event_wait_set(h)
            event_wait_reset(h)
            val result = event_wait_wait(h, 0)
            expect(result).to_equal("timeout")
