"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/os/kernel/wine/kernel_process_table_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Spec for kernel_process_table — scheduler-owned PID registry (M1, REQ-1/REQ-4).
#
# These specs lock the public API surface and invariants for:
#   src/lib/nogc_async_mut_noalloc/baremetal/process_table.spl
#
# Tests are in the red phase: the implementation does not yet exist.
# Run with:
#   bin/simple test test/unit/os/kernel/wine/kernel_process_table_spec.spl
#
# @cover src/lib/nogc_async_mut_noalloc/baremetal/process_table.spl

use std.spec
use std.nogc_async_mut_noalloc.baremetal.process_table.{
    process_table_alloc_pid,
    process_table_register,
    process_table_lookup,
    process_table_reap
}

describe "kernel_process_table — PID registry":

    describe "AC-1: process_table_alloc_pid — real PID allocation":
        it "AC-1: alloc_pid returns a positive non-zero PID":
            # @req: REQ-UNIT-OS-001
                # @req: REQ-4
                # @req: REQ-1
            step("Verify: AC-1: alloc_pid returns a positive non-zero PID")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pid = process_table_alloc_pid()
            expect(pid).to_be_greater_than(0)

        it "AC-1: consecutive alloc_pid calls return distinct PIDs":
            # @req: REQ-UNIT-OS-002
            step("Verify: AC-1: consecutive alloc_pid calls return distinct PIDs")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pid1 = process_table_alloc_pid()
            val pid2 = process_table_alloc_pid()
            expect(pid1).to_be_greater_than(0)
            expect(pid2).to_be_greater_than(0)
            # PIDs must be distinct (no duplicate allocation)
            expect(pid1).to_not_equal(pid2)

        it "AC-1: PID zero is reserved and never allocated":
            # @req: REQ-UNIT-OS-003
            step("Verify: AC-1: PID zero is reserved and never allocated")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # The kernel convention: PID 0 = idle/swapper; never returned to userland
            val pid = process_table_alloc_pid()
            expect(pid).to_not_equal(0)

    describe "AC-1: process_table_register — process entry creation":
        it "AC-1: registered process is visible via lookup":
            # @req: REQ-UNIT-OS-004
            step("Verify: AC-1: registered process is visible via lookup")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pid = process_table_alloc_pid()
            # asid=1 and a sentinel ns_id=42 represent a real ASID and namespace
            process_table_register(pid, 1, 42)
            val entry = process_table_lookup(pid)
            expect(entry.is_some).to_equal(true)

        it "AC-1: registered entry carries the correct PID":
            # @req: REQ-UNIT-OS-005
            step("Verify: AC-1: registered entry carries the correct PID")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pid = process_table_alloc_pid()
            process_table_register(pid, 2, 1)
            val entry = process_table_lookup(pid)
            expect(entry.is_some).to_equal(true)
            expect(entry.value.pid).to_equal(pid)

        it "AC-1: registered entry carries the supplied asid":
            # @req: REQ-UNIT-OS-006
            step("Verify: AC-1: registered entry carries the supplied asid")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pid = process_table_alloc_pid()
            val asid: u64 = 7
            process_table_register(pid, asid, 1)
            val entry = process_table_lookup(pid)
            expect(entry.is_some).to_equal(true)
            expect(entry.value.asid).to_equal(asid)

        it "AC-1: registered entry carries the supplied namespace ref":
            # @req: REQ-UNIT-OS-007
            step("Verify: AC-1: registered entry carries the supplied namespace ref")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pid = process_table_alloc_pid()
            val ns_id: u64 = 99
            process_table_register(pid, 1, ns_id)
            val entry = process_table_lookup(pid)
            expect(entry.is_some).to_equal(true)
            expect(entry.value.ns_id).to_equal(ns_id)

    describe "AC-1: process_table_lookup — process query":
        it "AC-1: lookup of unregistered PID returns None":
            # @req: REQ-UNIT-OS-008
            step("Verify: AC-1: lookup of unregistered PID returns None")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # A large PID unlikely to be registered
            val entry = process_table_lookup(65534)
            expect(entry.is_some).to_equal(false)

        it "AC-1: lookup returns Some after register and None after reap":
            # @req: REQ-UNIT-OS-009
            step("Verify: AC-1: lookup returns Some after register and None after reap")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pid = process_table_alloc_pid()
            process_table_register(pid, 3, 1)
            val before = process_table_lookup(pid)
            expect(before.is_some).to_equal(true)
            process_table_reap(pid)
            val after = process_table_lookup(pid)
            expect(after.is_some).to_equal(false)

    describe "AC-1: process_table_reap — entry removal":
        it "AC-1: reap on a registered PID succeeds without error":
            # @req: REQ-UNIT-OS-010
            step("Verify: AC-1: reap on a registered PID succeeds without error")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val pid = process_table_alloc_pid()
            process_table_register(pid, 4, 1)
            # reap returns void; we verify by confirming lookup is None afterward
            process_table_reap(pid)
            val entry = process_table_lookup(pid)
            expect(entry.is_some).to_equal(false)

        it "AC-1: no resident fallback markers remain after reap":
            # @req: REQ-UNIT-OS-011
            step("Verify: AC-1: no resident fallback markers remain after reap")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Validates AC-1: apps launch with real PIDs, no fallback markers
            val pid = process_table_alloc_pid()
            expect(pid).to_be_greater_than(0)
            process_table_register(pid, 5, 1)
            val entry = process_table_lookup(pid)
            expect(entry.is_some).to_equal(true)
            expect(entry.value.state).to_equal("running")
            process_table_reap(pid)
            val reaped = process_table_lookup(pid)
            expect(reaped.is_some).to_equal(false)
