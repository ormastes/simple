# @req: REQ-OS-KERNEL-001

"""
# x86_64 Scheduler Topology Probe Specification
"""

use std.spec.{describe, it, expect}
use os.kernel.arch.x86_64.topology.{
    x86_select_topology_leaf,
    x86_scheduler_topology_from_shape,
    x86_scheduler_topology_from_apic_ids
}

use std.spec.step

describe "x86_64 scheduler topology probe":
    it "prefers CPUID topology v2 leaf over v1":
        # @req: REQ-OS-KERNEL-001
        step("Verify: prefers CPUID topology v2 leaf over v1")
        expect(x86_select_topology_leaf(0x20u32)).to_equal(0x1Fu32)
        expect(x86_select_topology_leaf(0x0Bu32)).to_equal(0x0Bu32)
        expect(x86_select_topology_leaf(0x07u32)).to_equal(0u32)

    it "builds SMT and cache groups from decoded APIC-id shifts":
        # @req: REQ-OS-KERNEL-001
        step("Verify: builds SMT and cache groups from decoded APIC-id shifts")
        val info = x86_scheduler_topology_from_shape(
            cpu_count: 4u32,
            smt_shift: 1u32,
            core_shift: 2u32,
            base_apic_id: 0u32
        )

        expect(info.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(info[0].cpu_id).to_equal(0u32)
        expect(info[1].cpu_id).to_equal(1u32)
        expect(info[0].smt_id).to_equal(0u32)
        expect(info[1].smt_id).to_equal(0u32)
        expect(info[2].smt_id).to_equal(1u32)
        expect(info[3].smt_id).to_equal(1u32)
        expect(info[0].cache_id).to_equal(0u32)
        expect(info[3].cache_id).to_equal(0u32)

    it "normalizes zero CPUs for early boot fallback":
        # @req: REQ-OS-KERNEL-001
        step("Verify: normalizes zero CPUs for early boot fallback")
        val info = x86_scheduler_topology_from_shape(
            cpu_count: 0u32,
            smt_shift: 0u32,
            core_shift: 0u32,
            base_apic_id: 0u32
        )

        expect(info.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(info[0].cpu_id).to_equal(0u32)

    it "uses firmware APIC ids while keeping scheduler CPU ids contiguous":
        # @req: REQ-OS-KERNEL-001
        step("Verify: uses firmware APIC ids while keeping scheduler CPU ids contiguous")
        val info = x86_scheduler_topology_from_apic_ids(
            apic_ids: [4u32, 5u32, 8u32, 9u32],
            smt_shift: 1u32,
            core_shift: 2u32
        )

        expect(info.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(info[0].cpu_id).to_equal(0u32)
        expect(info[3].cpu_id).to_equal(3u32)
        expect(info[0].smt_id).to_equal(2u32)
        expect(info[1].smt_id).to_equal(2u32)
        expect(info[2].smt_id).to_equal(4u32)
        expect(info[3].smt_id).to_equal(4u32)
        expect(info[0].cache_id).to_equal(1u32)
        expect(info[3].cache_id).to_equal(2u32)
