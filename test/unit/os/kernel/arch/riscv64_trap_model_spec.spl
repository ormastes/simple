"""
## Purpose and audience
Behavioral specification for riscv64 trap model.
Audience: compiler/runtime developers and spec maintainers who need
to verify this component's observable behavior and pinned values.
"""
# @req: REQ-TEST-ARCH_RISCV64_TRAP_MODEL-001
use std.spec
use os.kernel.arch.riscv64.trap_model.{RV64_CAUSE_INTERRUPT_BIT, RV64_CAUSE_S_TIMER_INTERRUPT, RV64_CAUSE_ECALL_FROM_U, RV64_SSTATUS_SPIE, RV64_SSTATUS_SPP, RV64_SSTATUS_FS_MASK, RV64_SSTATUS_FS_INITIAL, RV64_CONTEXT_BYTES, Rv64TrapKind, rv64_initial_kernel_sstatus, rv64_initial_user_sstatus, create_rv64_user_context, create_rv64_kernel_context, classify_rv64_trap, rv64_syscall_args_from_context, rv64_apply_syscall_result}
use os.kernel.arch.arch_context.{ExtendedCtxRv, Riscv64Context}
use os.kernel.types.syscall_types.{SyscallResult}

describe "rv64 trap model":
    it "builds kernel contexts that return to supervisor mode":
        # @req: REQ-TEST-ARCH_RISCV64_TRAP_MODEL-001
        step("Verify: builds kernel contexts that return to supervisor mode")
        val ctx = create_rv64_kernel_context(0x80200000, 0x80400000, 7)
        expect(rv64_initial_kernel_sstatus() & RV64_SSTATUS_SPIE).to_equal(RV64_SSTATUS_SPIE)  # oracle: expected value pinned by spec
        expect(rv64_initial_kernel_sstatus() & RV64_SSTATUS_SPP).to_equal(RV64_SSTATUS_SPP)  # oracle: expected value pinned by spec
        expect(ctx.sepc).to_equal(0x80200000)  # oracle: expected value pinned by spec
        expect(ctx.sp).to_equal(0x80400000)  # oracle: expected value pinned by spec
        expect(ctx.a0).to_equal(7)  # oracle: expected value pinned by spec
        expect(ctx.sstatus & RV64_SSTATUS_SPP).to_equal(RV64_SSTATUS_SPP)  # oracle: expected value pinned by spec
        expect(ctx.sstatus & RV64_SSTATUS_FS_MASK).to_equal(RV64_SSTATUS_FS_INITIAL)  # oracle: expected value pinned by spec
        expect(RV64_CONTEXT_BYTES).to_equal(544)  # oracle: expected value pinned by spec

    it "builds user contexts that return to user mode":
        # @req: REQ-TEST-ARCH_RISCV64_TRAP_MODEL-001
        step("Verify: builds user contexts that return to user mode")
        val ctx = create_rv64_user_context(0x400000, 0x410000, 11)
        expect(rv64_initial_user_sstatus() & RV64_SSTATUS_SPIE).to_equal(RV64_SSTATUS_SPIE)  # oracle: expected value pinned by spec
        expect(rv64_initial_user_sstatus() & RV64_SSTATUS_SPP).to_equal(0)  # oracle: expected value pinned by spec
        expect(ctx.sepc).to_equal(0x400000)  # oracle: expected value pinned by spec
        expect(ctx.sp).to_equal(0x410000)  # oracle: expected value pinned by spec
        expect(ctx.a0).to_equal(0)  # oracle: expected value pinned by spec
        expect(ctx.sstatus & RV64_SSTATUS_SPP).to_equal(0)  # oracle: expected value pinned by spec
        expect(ctx.sstatus & RV64_SSTATUS_FS_MASK).to_equal(RV64_SSTATUS_FS_INITIAL)  # oracle: expected value pinned by spec

    it "classifies user ecalls":
        # @req: REQ-TEST-ARCH_RISCV64_TRAP_MODEL-001
        step("Verify: classifies user ecalls")
        val kind = classify_rv64_trap(RV64_CAUSE_ECALL_FROM_U)
        expect(kind).to_equal(Rv64TrapKind.UserEcall)  # oracle: expected value pinned by spec

    it "classifies supervisor timer interrupts":
        # @req: REQ-TEST-ARCH_RISCV64_TRAP_MODEL-001
        step("Verify: classifies supervisor timer interrupts")
        val kind = classify_rv64_trap(RV64_CAUSE_INTERRUPT_BIT | RV64_CAUSE_S_TIMER_INTERRUPT)
        expect(kind).to_equal(Rv64TrapKind.TimerInterrupt)  # oracle: expected value pinned by spec

    it "marshals syscall registers from rv64 user context":
        # @req: REQ-TEST-ARCH_RISCV64_TRAP_MODEL-001
        step("Verify: marshals syscall registers from rv64 user context")
        val ctx = Riscv64Context(
            ra: 0, sp: 0, gp: 0, tp: 0,
            t0: 0, t1: 0, t2: 0,
            s0: 0, s1: 0,
            a0: 10, a1: 11, a2: 12, a3: 13, a4: 14, a5: 15, a6: 0, a7: 60,
            s2: 0, s3: 0, s4: 0, s5: 0, s6: 0, s7: 0, s8: 0, s9: 0, s10: 0, s11: 0,
            t3: 0, t4: 0, t5: 0, t6: 0,
            sepc: 0x1000,
            sstatus: 0,
            scause: 0,
            fp_state: ExtendedCtxRv(bytes: [0; 264]),
            fp_pad: 0
        )
        val args = rv64_syscall_args_from_context(ctx)
        expect(args.id).to_equal(60)  # oracle: expected value pinned by spec
        expect(args.arg0).to_equal(10)  # oracle: expected value pinned by spec
        expect(args.arg1).to_equal(11)  # oracle: expected value pinned by spec
        expect(args.arg2).to_equal(12)  # oracle: expected value pinned by spec
        expect(args.arg3).to_equal(13)  # oracle: expected value pinned by spec
        expect(args.arg4).to_equal(14)  # oracle: expected value pinned by spec
        expect(args.arg5).to_equal(15)  # oracle: expected value pinned by spec

    it "applies syscall results back into rv64 user context":
        # @req: REQ-TEST-ARCH_RISCV64_TRAP_MODEL-001
        step("Verify: applies syscall results back into rv64 user context")
        val ctx = create_rv64_user_context(0x400000, 0x410000, 1)
        val updated = rv64_apply_syscall_result(ctx, SyscallResult(value: 42))
        expect(updated.a0).to_equal(42)  # oracle: expected value pinned by spec
        expect(updated.sepc).to_equal(0x400004)  # oracle: expected value pinned by spec
        expect(updated.sp).to_equal(0x410000)  # oracle: expected value pinned by spec
