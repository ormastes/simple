"""
## Purpose and audience
Behavioral specification for riscv64 trap frame.
Audience: compiler/runtime developers and spec maintainers who need
to verify this component's observable behavior and pinned values.
"""
# @req: REQ-TEST-ARCH_RISCV64_TRAP_FRAME-001
use std.spec
use os.kernel.arch.riscv64.trap_frame.{
    RV64_TRAP_FRAME_SLOT_BYTES,
    RV64_TRAP_FRAME_FIELD_COUNT,
    RV64_TRAP_FRAME_SIZE_BYTES,
    RV64_TRAP_RA_OFFSET,
    RV64_TRAP_SP_OFFSET,
    RV64_TRAP_A0_OFFSET,
    RV64_TRAP_A7_OFFSET,
    RV64_TRAP_SEPC_OFFSET,
    RV64_TRAP_SSTATUS_OFFSET,
    RV64_TRAP_SCAUSE_OFFSET,
    rv64_trap_frame_field_offsets
}

describe "rv64 trap frame layout":
    it "uses 8-byte slots for each saved field":
        # @req: REQ-TEST-ARCH_RISCV64_TRAP_FRAME-001
        step("Verify: uses 8-byte slots for each saved field")
        expect(RV64_TRAP_FRAME_SLOT_BYTES).to_equal(8)  # oracle: expected value pinned by spec

    it "reports the full saved frame size":
        # @req: REQ-TEST-ARCH_RISCV64_TRAP_FRAME-001
        step("Verify: reports the full saved frame size")
        expect(RV64_TRAP_FRAME_FIELD_COUNT).to_equal(34)  # oracle: expected value pinned by spec
        expect(RV64_TRAP_FRAME_SIZE_BYTES).to_equal(272)  # oracle: expected value pinned by spec

    it "keeps key register offsets stable":
        # @req: REQ-TEST-ARCH_RISCV64_TRAP_FRAME-001
        step("Verify: keeps key register offsets stable")
        expect(RV64_TRAP_RA_OFFSET).to_equal(0)  # oracle: expected value pinned by spec
        expect(RV64_TRAP_SP_OFFSET).to_equal(8)  # oracle: expected value pinned by spec
        expect(RV64_TRAP_A0_OFFSET).to_equal(72)  # oracle: expected value pinned by spec
        expect(RV64_TRAP_A7_OFFSET).to_equal(128)  # oracle: expected value pinned by spec
        expect(RV64_TRAP_SEPC_OFFSET).to_equal(248)  # oracle: expected value pinned by spec
        expect(RV64_TRAP_SSTATUS_OFFSET).to_equal(256)  # oracle: expected value pinned by spec
        expect(RV64_TRAP_SCAUSE_OFFSET).to_equal(264)  # oracle: expected value pinned by spec

    it "returns a monotonic ordered field list":
        # @req: REQ-TEST-ARCH_RISCV64_TRAP_FRAME-001
        step("Verify: returns a monotonic ordered field list")
        val offsets = rv64_trap_frame_field_offsets()
        expect(offsets.len()).to_equal(34)  # oracle: expected value pinned by spec

        var i = 1
        while i < offsets.len():
            expect(offsets[i]).to_equal(offsets[i - 1] + RV64_TRAP_FRAME_SLOT_BYTES)  # oracle: expected value pinned by spec
            i = i + 1
