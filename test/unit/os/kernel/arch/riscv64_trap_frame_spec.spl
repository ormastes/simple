# @req: REQ-OS-KERNEL-001

use std.spec
use os.kernel.arch.riscv64.trap_frame.{
    RV64_TRAP_FRAME_SLOT_BYTES,
    RV64_TRAP_FRAME_FIELD_COUNT,
    RV64_TRAP_FRAME_SIZE_BYTES,
    RV64_TRAP_RA_OFFSET,
    RV64_TRAP_SP_OFFSET,
    RV64_TRAP_A0_OFFSET,
    RV64_TRAP_A7_OFFSET,
    RV64_TRAP_SEPC_OFFSET,
    RV64_TRAP_SSTATUS_OFFSET,
    RV64_TRAP_SCAUSE_OFFSET,
    rv64_trap_frame_field_offsets
}

describe "rv64 trap frame layout":
    it "uses 8-byte slots for each saved field":
        # @req: REQ-OS-KERNEL-001
        step("Verify: uses 8-byte slots for each saved field")
        expect(RV64_TRAP_FRAME_SLOT_BYTES).to_equal(8)  # oracle: 8 — named expected value from the requirement

    it "reports the full saved frame size":
        # @req: REQ-OS-KERNEL-001
        step("Verify: reports the full saved frame size")
        expect(RV64_TRAP_FRAME_FIELD_COUNT).to_equal(34)  # oracle: 34 — named expected value from the requirement
        expect(RV64_TRAP_FRAME_SIZE_BYTES).to_equal(272)  # oracle: 272 — named expected value from the requirement

    it "keeps key register offsets stable":
        # @req: REQ-OS-KERNEL-001
        step("Verify: keeps key register offsets stable")
        expect(RV64_TRAP_RA_OFFSET).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(RV64_TRAP_SP_OFFSET).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(RV64_TRAP_A0_OFFSET).to_equal(72)  # oracle: 72 — named expected value from the requirement
        expect(RV64_TRAP_A7_OFFSET).to_equal(128)  # oracle: 128 — named expected value from the requirement
        expect(RV64_TRAP_SEPC_OFFSET).to_equal(248)  # oracle: 248 — named expected value from the requirement
        expect(RV64_TRAP_SSTATUS_OFFSET).to_equal(256)  # oracle: 256 — named expected value from the requirement
        expect(RV64_TRAP_SCAUSE_OFFSET).to_equal(264)  # oracle: 264 — named expected value from the requirement

    it "returns a monotonic ordered field list":
        # @req: REQ-OS-KERNEL-001
        step("Verify: returns a monotonic ordered field list")
        val offsets = rv64_trap_frame_field_offsets()
        expect(offsets.len()).to_equal(34)  # oracle: 34 — named expected value from the requirement

        var i = 1
        while i < offsets.len():
            expect(offsets[i]).to_equal(offsets[i - 1] + RV64_TRAP_FRAME_SLOT_BYTES)
            i = i + 1
