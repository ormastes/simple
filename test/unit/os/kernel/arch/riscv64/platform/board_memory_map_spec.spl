"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/os/kernel/arch/riscv64/platform/board_memory_map_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/os/kernel/arch/riscv64/platform/board_memory_map.spl 0%
# @cover src/os/kernel/arch/riscv64/platform/kria_memory_map.spl 0%
# @cover src/os/kernel/arch/riscv64/platform/litex_memory_map.spl 0%
"""
# RiscvBoardMemoryMap Trait Specification

**Feature IDs:** opensource-riscv-rtl-simpleos
**Category:** Infrastructure
**Difficulty:** 2/5
**Status:** Draft
**Requirements:** REQ-5
**Artifacts:** N/A

## Overview

Verifies AC-5: RiscvBoardMemoryMap trait and its two concrete implementations
(KriaFpgaMemoryMap for K26, LitexFpgaMemoryMap for DE10-Nano) return correct
address constants. These constants gate the minimal-host boot chain.

Covers:
- AC-5 (SimpleOS boots with correct memory map: UART, RAM, heap, CLINT, PLIC)
"""

use std.spipe.*
use os.kernel.arch.riscv64.platform.kria_memory_map.{
    KriaFpgaMemoryMap,
    kria_memory_map_new
}
use os.kernel.arch.riscv64.platform.litex_memory_map.{
    LitexFpgaMemoryMap,
    litex_memory_map_new
}


# ============================================================================
# Helpers
# ============================================================================

fn kria_map() -> KriaFpgaMemoryMap:
    return kria_memory_map_new()

fn litex_map() -> LitexFpgaMemoryMap:
    return litex_memory_map_new()


# ============================================================================
# AC-5: KriaFpgaMemoryMap constants
# ============================================================================

describe "KriaFpgaMemoryMap":
    it "AC-5: uart_base returns 0x10000000":
        # @req: REQ-UNIT-OS-001
            # @req: REQ-5
        step("Verify: AC-5: uart_base returns 0x10000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val m = kria_map()
        expect(m.uart_base()).to_equal(268435456)  # oracle: expected value 268435456 is the behavior asserted by this regression spec

    it "AC-5: ram_base returns 0x80000000":
        # @req: REQ-UNIT-OS-002
        step("Verify: AC-5: ram_base returns 0x80000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val m = kria_map()
        expect(m.ram_base()).to_equal(2147483648)  # oracle: expected value 2147483648 is the behavior asserted by this regression spec

    it "AC-5: ram_size returns 128MB (134217728 bytes)":
        # @req: REQ-UNIT-OS-003
        step("Verify: AC-5: ram_size returns 128MB (134217728 bytes)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val m = kria_map()
        expect(m.ram_size()).to_equal(134217728)  # oracle: expected value 134217728 is the behavior asserted by this regression spec

    it "AC-5: clint_base returns 0x02000000":
        # @req: REQ-UNIT-OS-004
        step("Verify: AC-5: clint_base returns 0x02000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val m = kria_map()
        expect(m.clint_base()).to_equal(33554432)  # oracle: expected value 33554432 is the behavior asserted by this regression spec

    it "AC-5: plic_base returns 0x0c000000":
        # @req: REQ-UNIT-OS-005
        step("Verify: AC-5: plic_base returns 0x0c000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val m = kria_map()
        expect(m.plic_base()).to_equal(201326592)  # oracle: expected value 201326592 is the behavior asserted by this regression spec

    it "AC-5: heap_start returns 0x87000000":
        # @req: REQ-UNIT-OS-006
        step("Verify: AC-5: heap_start returns 0x87000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val m = kria_map()
        expect(m.heap_start()).to_equal(2264924160)  # oracle: expected value 2264924160 is the behavior asserted by this regression spec

    it "AC-5: heap_size is 16MB (16777216 bytes)":
        # @req: REQ-UNIT-OS-007
        step("Verify: AC-5: heap_size is 16MB (16777216 bytes)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val m = kria_map()
        expect(m.heap_size()).to_equal(16777216)  # oracle: expected value 16777216 is the behavior asserted by this regression spec


# ============================================================================
# AC-5: LitexFpgaMemoryMap constants (DE10-Nano LiteX layout)
# ============================================================================

describe "LitexFpgaMemoryMap":
    it "AC-5: uart_base returns 0xf0001000":
        # @req: REQ-UNIT-OS-008
        step("Verify: AC-5: uart_base returns 0xf0001000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val m = litex_map()
        expect(m.uart_base()).to_equal(4026535936)  # oracle: expected value 4026535936 is the behavior asserted by this regression spec

    it "AC-5: ram_base returns 0x40000000":
        # @req: REQ-UNIT-OS-009
        step("Verify: AC-5: ram_base returns 0x40000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val m = litex_map()
        expect(m.ram_base()).to_equal(1073741824)  # oracle: expected value 1073741824 is the behavior asserted by this regression spec

    it "AC-5: ram_size returns 256MB (268435456 bytes)":
        # @req: REQ-UNIT-OS-010
        step("Verify: AC-5: ram_size returns 256MB (268435456 bytes)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val m = litex_map()
        expect(m.ram_size()).to_equal(268435456)  # oracle: expected value 268435456 is the behavior asserted by this regression spec

    it "AC-5: clint_base returns 0xf0010000":
        # @req: REQ-UNIT-OS-011
        step("Verify: AC-5: clint_base returns 0xf0010000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val m = litex_map()
        expect(m.clint_base()).to_equal(4026597376)  # oracle: expected value 4026597376 is the behavior asserted by this regression spec

    it "AC-5: plic_base returns 0xf0c00000":
        # @req: REQ-UNIT-OS-012
        step("Verify: AC-5: plic_base returns 0xf0c00000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val m = litex_map()
        expect(m.plic_base()).to_equal(4039114752)  # oracle: expected value 4039114752 is the behavior asserted by this regression spec

    it "AC-5: heap_start returns 0x4f000000":
        # @req: REQ-UNIT-OS-013
        step("Verify: AC-5: heap_start returns 0x4f000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val m = litex_map()
        expect(m.heap_start()).to_equal(1325400064)  # oracle: expected value 1325400064 is the behavior asserted by this regression spec

    it "AC-5: LiteX and Kria uart_base are different":
        # @req: REQ-UNIT-OS-014
        step("Verify: AC-5: LiteX and Kria uart_base are different")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val kria = kria_map()
        val litex = litex_map()
        val kria_uart = kria.uart_base()
        val litex_uart = litex.uart_base()
        expect(kria_uart).to_equal(268435456)  # oracle: expected value 268435456 is the behavior asserted by this regression spec
        expect(litex_uart).to_equal(4026535936)  # oracle: expected value 4026535936 is the behavior asserted by this regression spec
