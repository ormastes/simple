"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/os/kernel/arch/riscv64/platform/litex_fpga_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @cover src/os/kernel/arch/riscv64/platform/litex_fpga.spl 0%
"""
# LiteX FPGA Platform Specification

**Feature IDs:** opensource-riscv-rtl-simpleos
**Category:** Infrastructure
**Difficulty:** 2/5
**Status:** Draft
**Requirements:** REQ-6
**Artifacts:** N/A

## Overview

Verifies AC-6: the litex_fpga platform capsule composes LitexFpgaMemoryMap
correctly. Tests that the platform init and UART/timer API exist with the
right types and that the composed memory map returns expected constants.

Covers:
- AC-6 (Minimal host services: console I/O, timer init, idle loop parameterization)
"""

use std.spipe.*
use os.kernel.arch.riscv64.platform.litex_memory_map.{
    LitexFpgaMemoryMap,
    litex_memory_map_new
}
use os.kernel.arch.riscv64.platform.litex_fpga.{
    litex_fpga_platform_init,
    litex_fpga_uart_put,
    litex_fpga_timer_init,
    litex_fpga_platform_name
}


# ============================================================================
# Helpers
# ============================================================================

fn make_litex_map() -> LitexFpgaMemoryMap:
    return litex_memory_map_new()


# ============================================================================
# AC-6: LiteX platform name
# ============================================================================

describe "LiteX FPGA Platform":
    it "AC-6: platform name is non-empty":
        # @req: REQ-UNIT-OS-001
            # @req: REQ-6
        step("Verify: AC-6: platform name is non-empty")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val name = litex_fpga_platform_name()
        val len = name.length()
        expect(len).to_be_greater_than(0)

    it "AC-6: platform name contains litex or de10nano":
        # @req: REQ-UNIT-OS-002
        step("Verify: AC-6: platform name contains litex or de10nano")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val name = litex_fpga_platform_name()
        expect(name).to_contain("litex")


# ============================================================================
# AC-6: LiteX memory map composes correctly into platform
# ============================================================================

describe "LiteX FPGA Memory Map Composition":
    it "AC-6: LitexFpgaMemoryMap uart_base is 0xf0001000":
        # @req: REQ-UNIT-OS-003
        step("Verify: AC-6: LitexFpgaMemoryMap uart_base is 0xf0001000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val m = make_litex_map()
        expect(m.uart_base()).to_equal(4026535936)  # oracle: expected value 4026535936 is the behavior asserted by this regression spec

    it "AC-6: LitexFpgaMemoryMap ram_base is 0x40000000":
        # @req: REQ-UNIT-OS-004
        step("Verify: AC-6: LitexFpgaMemoryMap ram_base is 0x40000000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val m = make_litex_map()
        expect(m.ram_base()).to_equal(1073741824)  # oracle: expected value 1073741824 is the behavior asserted by this regression spec

    it "AC-6: LitexFpgaMemoryMap clint_base is 0xf0010000":
        # @req: REQ-UNIT-OS-005
        step("Verify: AC-6: LitexFpgaMemoryMap clint_base is 0xf0010000")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val m = make_litex_map()
        expect(m.clint_base()).to_equal(4026597376)  # oracle: expected value 4026597376 is the behavior asserted by this regression spec
