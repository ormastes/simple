"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/os/tls13/new_session_ticket_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# NewSessionTicket spec — RFC 8446 §4.6.1
#
# Coverage:
#   1.  NST body encode: fixed fields layout (lifetime, age_add, nonce, ticket, extensions)
#   2.  NST body encode/decode round-trip (ok=true, fields preserved)
#   3.  NST handshake wrap: type=0x04, uint24 body length
#   4.  NST handshake round-trip through decode_new_session_ticket_handshake
#   5.  decode rejects zero-length ticket
#   6.  decode rejects truncated nonce
#   7.  decode rejects truncated ticket
#   8.  decode rejects wrong HandshakeType via handshake wrapper
#   9.  derive_resumption_psk_from_ticket produces HashLen-byte output (SHA-256)
#  10.  derive_resumption_psk_from_ticket is deterministic (same inputs → same output)
#  11.  stored_psk_from_new_session_ticket copies all NST fields into StoredPsk
#  12.  PSK derived by stored_psk_from_new_session_ticket matches direct derivation

use std.spipe.*

use os.tls13.new_session_ticket.{
    NewSessionTicket,
    DecodedNewSessionTicket,
    DecodedNstHandshake,
    encode_new_session_ticket,
    encode_new_session_ticket_handshake,
    decode_new_session_ticket,
    decode_new_session_ticket_handshake,
    derive_resumption_psk_from_ticket,
    stored_psk_from_new_session_ticket,
}
use os.tls13.key_schedule.{tls13_resumption_secret, tls13_resumption_master_secret}
use os.tls13.psk.{StoredPsk}

# ============================================================================
# Module-level helpers
# ============================================================================

fn _zeros_n(n: u64) -> [u8]:
    var out: [u8] = []
    var i: u64 = 0
    while i < n:
        out.push(0x00u8)
        i = i + 1
    out

fn _seq_n(n: u64, base: u8) -> [u8]:
    var out: [u8] = []
    var i: u64 = 0
    while i < n:
        out.push(((base.to_u32() + (i.to_u32() & 0xFFu32)) & 0xFFu32).to_u8())
        i = i + 1
    out

fn _bytes_eq(a: [u8], b: [u8]) -> bool:
    if a.len() != b.len():
        return false
    var i: u64 = 0
    val n = a.len().to_u64()
    while i < n:
        if a[i.to_i64()] != b[i.to_i64()]:
            return false
        i = i + 1
    true

fn _u16_be(buf: [u8], off: u64) -> u32:
    val hi = buf[off.to_i64()].to_u32()
    val lo = buf[(off + 1).to_i64()].to_u32()
    (hi << 8) | lo

fn _u32_be(buf: [u8], off: u64) -> u32:
    val b0 = buf[off.to_i64()].to_u32()
    val b1 = buf[(off + 1).to_i64()].to_u32()
    val b2 = buf[(off + 2).to_i64()].to_u32()
    val b3 = buf[(off + 3).to_i64()].to_u32()
    (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

fn _build_nst() -> NewSessionTicket:
    """Build a simple NST for round-trip testing."""
    val nonce = _seq_n(4u64, 0x01u8)
    val ticket = _seq_n(16u64, 0xAAu8)
    val exts: [u8] = []
    NewSessionTicket(
        ticket_lifetime: 7200u32,
        ticket_age_add: 0xDEADBEEFu32,
        ticket_nonce: nonce,
        ticket: ticket,
        extensions: exts,
    )

fn _build_nst_with_ext() -> NewSessionTicket:
    """Build an NST that has a non-empty extensions block."""
    val nonce = _seq_n(2u64, 0x10u8)
    val ticket = _seq_n(8u64, 0xBBu8)
    # Simple early_data extension: type=0x002A, length=4, max_early_data_size=0x00004000
    var exts: [u8] = []
    exts.push(0x00u8)
    exts.push(0x2Au8)
    exts.push(0x00u8)
    exts.push(0x04u8)
    exts.push(0x00u8)
    exts.push(0x00u8)
    exts.push(0x40u8)
    exts.push(0x00u8)
    NewSessionTicket(
        ticket_lifetime: 3600u32,
        ticket_age_add: 0x12345678u32,
        ticket_nonce: nonce,
        ticket: ticket,
        extensions: exts,
    )

fn _encode_and_decode(nst: NewSessionTicket) -> DecodedNewSessionTicket:
    val enc = encode_new_session_ticket(nst)
    decode_new_session_ticket(enc)

fn _encode_decode_handshake(nst: NewSessionTicket) -> DecodedNstHandshake:
    val enc = encode_new_session_ticket_handshake(nst)
    decode_new_session_ticket_handshake(enc)

fn _derive_psk_twice(rms: [u8], nonce: [u8]) -> bool:
    val a = derive_resumption_psk_from_ticket(rms, nonce, 1u8)
    val b = derive_resumption_psk_from_ticket(rms, nonce, 1u8)
    _bytes_eq(a, b)

fn _psk_matches_key_schedule(rms: [u8], nonce: [u8]) -> bool:
    val got = derive_resumption_psk_from_ticket(rms, nonce, 1u8)
    val expected = tls13_resumption_secret(rms, nonce, 1u8)
    _bytes_eq(got, expected)

fn _stored_psk_from_nst_psk_matches(nst: NewSessionTicket, rms: [u8]) -> bool:
    val sp = stored_psk_from_new_session_ticket(nst, rms, 1u8, 0x1301u16)
    val direct = derive_resumption_psk_from_ticket(rms, nst.ticket_nonce, 1u8)
    _bytes_eq(sp.resumption_secret, direct)

# ============================================================================
# Spec
# ============================================================================

describe("NewSessionTicket — RFC 8446 §4.6.1"):

    it("encode body: fixed fields at correct offsets"):
        # @req: REQ-UNIT-OS-001
        step("Verify: encode body: fixed fields at correct offsets")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val nst = _build_nst()
        val enc = encode_new_session_ticket(nst)
        # ticket_lifetime at offset 0 = 7200 = 0x00001C20
        expect(_u32_be(enc, 0u64)).to_equal(7200u32)
        # ticket_age_add at offset 4
        expect(_u32_be(enc, 4u64)).to_equal(0xDEADBEEFu32)
        # ticket_nonce length byte at offset 8 = 4
        expect(enc[8].to_u32()).to_equal(4u32)
        # nonce bytes 0x01 0x02 0x03 0x04 at offset 9..12
        expect(enc[9].to_u32()).to_equal(0x01u32)
        expect(enc[12].to_u32()).to_equal(0x04u32)
        # ticket length at offset 13 = 16 = 0x0010
        expect(_u16_be(enc, 13u64)).to_equal(16u32)
        # extensions length at offset 31 = 0 (no extensions)
        expect(_u16_be(enc, 31u64)).to_equal(0u32)
        # total length: 4+4+1+4+2+16+2 = 33
        expect(enc.len()).to_equal(33)  # oracle: expected value 33 is the behavior asserted by this regression spec

    it("encode body round-trip: all fields preserved"):
        # @req: REQ-UNIT-OS-002
        step("Verify: encode body round-trip: all fields preserved")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val d = _encode_and_decode(_build_nst())
        expect(d.ok).to_equal(true)
        expect(d.nst.ticket_lifetime).to_equal(7200u32)
        expect(d.nst.ticket_age_add).to_equal(0xDEADBEEFu32)
        expect(_bytes_eq(d.nst.ticket_nonce, _seq_n(4u64, 0x01u8))).to_equal(true)
        expect(_bytes_eq(d.nst.ticket, _seq_n(16u64, 0xAAu8))).to_equal(true)
        expect(d.nst.extensions.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it("encode body round-trip: non-empty extensions preserved"):
        # @req: REQ-UNIT-OS-003
        step("Verify: encode body round-trip: non-empty extensions preserved")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val nst = _build_nst_with_ext()
        val d = _encode_and_decode(nst)
        expect(d.ok).to_equal(true)
        expect(d.nst.ticket_lifetime).to_equal(3600u32)
        expect(d.nst.extensions.len()).to_equal(8)  # oracle: expected value 8 is the behavior asserted by this regression spec
        expect(_bytes_eq(d.nst.extensions, nst.extensions)).to_equal(true)

    it("handshake wrap: type byte is 0x04"):
        # @req: REQ-UNIT-OS-004
        step("Verify: handshake wrap: type byte is 0x04")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val enc = encode_new_session_ticket_handshake(_build_nst())
        expect(enc[0].to_u32()).to_equal(4u32)

    it("handshake wrap: uint24 length matches body"):
        # @req: REQ-UNIT-OS-005
        step("Verify: handshake wrap: uint24 length matches body")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val nst = _build_nst()
        val body = encode_new_session_ticket(nst)
        val wrapped = encode_new_session_ticket_handshake(nst)
        val body_len_hi = wrapped[1].to_u32()
        val body_len_mid = wrapped[2].to_u32()
        val body_len_lo = wrapped[3].to_u32()
        val decoded_len = (body_len_hi << 16) | (body_len_mid << 8) | body_len_lo
        expect(decoded_len).to_equal(body.len().to_u32())
        # total wrapped length = 4 header + body
        expect(wrapped.len()).to_equal(4 + body.len())

    it("handshake round-trip via decode_new_session_ticket_handshake"):
        # @req: REQ-UNIT-OS-006
        step("Verify: handshake round-trip via decode_new_session_ticket_handshake")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val d = _encode_decode_handshake(_build_nst())
        expect(d.ok).to_equal(true)
        expect(d.nst.ticket_lifetime).to_equal(7200u32)
        expect(d.nst.ticket_age_add).to_equal(0xDEADBEEFu32)

    it("decode rejects zero-length ticket"):
        # @req: REQ-UNIT-OS-007
        step("Verify: decode rejects zero-length ticket")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val nst = NewSessionTicket(
            ticket_lifetime: 100u32,
            ticket_age_add: 1u32,
            ticket_nonce: _seq_n(2u64, 0x01u8),
            ticket: [],
            extensions: [],
        )
        val enc = encode_new_session_ticket(nst)
        val d = decode_new_session_ticket(enc)
        expect(d.ok).to_equal(false)

    it("decode rejects truncated buffer"):
        # @req: REQ-UNIT-OS-008
        step("Verify: decode rejects truncated buffer")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val enc = encode_new_session_ticket(_build_nst())
        # truncate to first 5 bytes
        val short = _nst_slice_helper(enc, 0u64, 5u64)
        val d = decode_new_session_ticket(short)
        expect(d.ok).to_equal(false)

    it("handshake decode rejects wrong HandshakeType"):
        # @req: REQ-UNIT-OS-009
        step("Verify: handshake decode rejects wrong HandshakeType")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val enc = encode_new_session_ticket_handshake(_build_nst())
        # replace type byte (0x04) with 0x02 (ServerHello)
        var tampered: [u8] = []
        tampered.push(0x02u8)
        var i: u64 = 1
        val n = enc.len().to_u64()
        while i < n:
            tampered.push(enc[i.to_i64()])
            i = i + 1
        val d = decode_new_session_ticket_handshake(tampered)
        expect(d.ok).to_equal(false)

    it("derive_resumption_psk_from_ticket returns 32 bytes for SHA-256 path"):
        # @req: REQ-UNIT-OS-010
        step("Verify: derive_resumption_psk_from_ticket returns 32 bytes for SHA-256 path")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val rms = _seq_n(32u64, 0x55u8)
        val nonce = _seq_n(4u64, 0x01u8)
        val psk = derive_resumption_psk_from_ticket(rms, nonce, 1u8)
        expect(psk.len()).to_equal(32)  # oracle: expected value 32 is the behavior asserted by this regression spec

    it("derive_resumption_psk_from_ticket is deterministic"):
        # @req: REQ-UNIT-OS-011
        step("Verify: derive_resumption_psk_from_ticket is deterministic")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val rms = _seq_n(32u64, 0x77u8)
        val nonce = _seq_n(3u64, 0x22u8)
        expect(_derive_psk_twice(rms, nonce)).to_equal(true)

    it("derive_resumption_psk_from_ticket matches tls13_resumption_secret"):
        # @req: REQ-UNIT-OS-012
        step("Verify: derive_resumption_psk_from_ticket matches tls13_resumption_secret")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val rms = _seq_n(32u64, 0x33u8)
        val nonce = _seq_n(2u64, 0xFFu8)
        expect(_psk_matches_key_schedule(rms, nonce)).to_equal(true)

    it("stored_psk_from_new_session_ticket: ticket fields copied correctly"):
        # @req: REQ-UNIT-OS-013
        step("Verify: stored_psk_from_new_session_ticket: ticket fields copied correctly")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val nst = _build_nst()
        val rms = _zeros_n(32u64)
        val sp = stored_psk_from_new_session_ticket(nst, rms, 1u8, 0x1301u16)
        expect(sp.lifetime_seconds).to_equal(7200u32)
        expect(sp.age_add).to_equal(0xDEADBEEFu32)
        expect(sp.cipher_suite).to_equal(0x1301u16)
        expect(_bytes_eq(sp.ticket, _seq_n(16u64, 0xAAu8))).to_equal(true)
        expect(_bytes_eq(sp.ticket_nonce, _seq_n(4u64, 0x01u8))).to_equal(true)

    it("stored_psk_from_new_session_ticket: derived PSK matches direct derivation"):
        # @req: REQ-UNIT-OS-014
        step("Verify: stored_psk_from_new_session_ticket: derived PSK matches direct derivation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val nst = _build_nst()
        val rms = _seq_n(32u64, 0xCCu8)
        expect(_stored_psk_from_nst_psk_matches(nst, rms)).to_equal(true)

    it("RMS derivation produces 32 bytes for SHA-256"):
        # @req: REQ-UNIT-OS-015
        step("Verify: RMS derivation produces 32 bytes for SHA-256")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val master = _seq_n(32u64, 0x11u8)
        val thash = _seq_n(32u64, 0x22u8)
        expect(_rms_sha256_len_correct(master, thash)).to_equal(true)

    it("RMS derivation is deterministic"):
        # @req: REQ-UNIT-OS-016
        step("Verify: RMS derivation is deterministic")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val master = _seq_n(32u64, 0xAAu8)
        val thash = _seq_n(32u64, 0xBBu8)
        expect(_rms_sha256_deterministic(master, thash)).to_equal(true)

    it("full pipeline: master_secret → RMS → StoredPsk PSK matches direct derivation"):
        # @req: REQ-UNIT-OS-017
        step("Verify: full pipeline: master_secret → RMS → StoredPsk PSK matches direct derivation")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val master = _seq_n(32u64, 0x42u8)
        val thash = _seq_n(32u64, 0x99u8)
        val nst = _build_nst()
        expect(_full_pipeline_psk_matches_direct(master, thash, nst)).to_equal(true)

    it("full pipeline: StoredPsk fields copied from NST"):
        # @req: REQ-UNIT-OS-018
        step("Verify: full pipeline: StoredPsk fields copied from NST")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val master = _seq_n(32u64, 0x7Fu8)
        val thash = _seq_n(32u64, 0x3Cu8)
        val nst = _build_nst()
        val sp = _full_pipeline_psk(master, thash, nst)
        expect(sp.lifetime_seconds).to_equal(7200u32)
        expect(sp.age_add).to_equal(0xDEADBEEFu32)
        expect(sp.cipher_suite).to_equal(0x1301u16)

    it("handshake-wrapped NST decode → StoredPsk end-to-end"):
        # @req: REQ-UNIT-OS-019
        step("Verify: handshake-wrapped NST decode → StoredPsk end-to-end")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val rms = _seq_n(32u64, 0x55u8)
        expect(_nst_handshake_decode_to_store(rms)).to_equal(true)

# ============================================================================
# Module-level helpers for RMS pipeline tests and truncation test
# ============================================================================

fn _nst_slice_helper(buf: [u8], off: u64, n: u64) -> [u8]:
    var out: [u8] = []
    var i: u64 = 0
    while i < n:
        out.push(buf[(off + i).to_i64()])
        i = i + 1
    out

fn _rms_sha256_len_correct(master: [u8], thash: [u8]) -> bool:
    val rms = tls13_resumption_master_secret(master, thash, 1u8)
    rms.len() == 32

fn _rms_sha256_deterministic(master: [u8], thash: [u8]) -> bool:
    val a = tls13_resumption_master_secret(master, thash, 1u8)
    val b = tls13_resumption_master_secret(master, thash, 1u8)
    _bytes_eq(a, b)

fn _full_pipeline_psk(master: [u8], thash: [u8], nst: NewSessionTicket) -> StoredPsk:
    val rms = tls13_resumption_master_secret(master, thash, 1u8)
    stored_psk_from_new_session_ticket(nst, rms, 1u8, 0x1301u16)

fn _full_pipeline_psk_matches_direct(master: [u8], thash: [u8], nst: NewSessionTicket) -> bool:
    val rms = tls13_resumption_master_secret(master, thash, 1u8)
    val sp = stored_psk_from_new_session_ticket(nst, rms, 1u8, 0x1301u16)
    val direct_psk = derive_resumption_psk_from_ticket(rms, nst.ticket_nonce, 1u8)
    _bytes_eq(sp.resumption_secret, direct_psk)

fn _nst_handshake_decode_to_store(rms: [u8]) -> bool:
    val nst = _build_nst()
    val wrapped = encode_new_session_ticket_handshake(nst)
    val parsed = decode_new_session_ticket_handshake(wrapped)
    if not parsed.ok:
        return false
    val sp = stored_psk_from_new_session_ticket(parsed.nst, rms, 1u8, 0x1301u16)
    if not _bytes_eq(sp.ticket, nst.ticket):
        return false
    sp.resumption_secret.len() == 32
