"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/os/drivers/dma/direct_io_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec.{describe, it, expect, step}
use std.io_runtime.{read_file}

describe "OS DMA DirectIoResult durability":
    it "defaults ordinary completion to non-durable and exposes durable completion":
        # @req: REQ-UNIT-OS-001
        step("Verify: defaults ordinary completion to non-durable and exposes durable completion")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val source = read_file("src/os/drivers/dma/direct_io.spl")
        expect(source.contains("durable: bool")).to_equal(true)
        expect(source.contains("static fn ok(bytes_transferred: i64, latency_us: i64) -> DirectIoResult:")).to_equal(true)
        expect(source.contains("durable: false")).to_equal(true)
        expect(source.contains("static fn durable_ok(bytes_transferred: i64, latency_us: i64) -> DirectIoResult:")).to_equal(true)
        expect(source.contains("durable: true")).to_equal(true)
        expect(source.contains("\",durable=\" + self.durable.to_text()")).to_equal(true)
