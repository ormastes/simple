# @req: REQ-OS-DRIVERS-001

"""
# PS/2 Keyboard Driver Specification

**Feature IDs:** #OS-PS2
**Category:** Infrastructure
**Difficulty:** 2/5
**Status:** In Progress

## Overview

Tests PS/2 keyboard scancode-to-key mapping, modifier state tracking,
and key-to-character conversion with shift/caps awareness.
"""

use std.spec
use os.drivers.input.ps2_keyboard.{
    Key, KeyEvent, Ps2Keyboard, scancode_to_key
}


# ============================================================================
# Reference decoder — a verbatim transcription of the ORIGINAL (pre-split)
# Ps2Keyboard.poll() decode body, kept as an independent oracle so the
# isr_ingest()/decode_pending() split can be proven behaviour-preserving rather
# than merely self-consistent. Do not replace this with a call to the driver.
# ============================================================================

fn reference_decode_scancode(kbd: Ps2Keyboard, scancode: i64) -> KeyEvent:
    """The original poll() body, minus the two port reads."""
    if (scancode & 0x80) != 0:
        val key = scancode_to_key(scancode & 0x7F)
        kbd.update_modifiers_release(key)
        return KeyEvent.Release(key: key)

    val key = scancode_to_key(scancode)
    kbd.update_modifiers_press(key)
    KeyEvent.Press(key: key)


# ============================================================================
# Test Group 1: Scancode to Key Mapping
# ============================================================================

describe "PS/2 Keyboard":
    describe "scancode_to_key":
        it "maps 0x1E to Key.A":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: maps 0x1E to Key.A")
            val key = scancode_to_key(0x1E)
            expect(key).to_equal(Key.A)

        it "maps 0x39 to Key.Space":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: maps 0x39 to Key.Space")
            val key = scancode_to_key(0x39)
            expect(key).to_equal(Key.Space)

        it "maps 0x1C to Key.Enter":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: maps 0x1C to Key.Enter")
            val key = scancode_to_key(0x1C)
            expect(key).to_equal(Key.Enter)

        it "maps 0x01 to Key.Escape":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: maps 0x01 to Key.Escape")
            val key = scancode_to_key(0x01)
            expect(key).to_equal(Key.Escape)

        it "maps 0x0E to Key.Backspace":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: maps 0x0E to Key.Backspace")
            val key = scancode_to_key(0x0E)
            expect(key).to_equal(Key.Backspace)

        it "maps 0x0F to Key.Tab":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: maps 0x0F to Key.Tab")
            val key = scancode_to_key(0x0F)
            expect(key).to_equal(Key.Tab)

        it "maps 0x2A to Key.LeftShift":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: maps 0x2A to Key.LeftShift")
            val key = scancode_to_key(0x2A)
            expect(key).to_equal(Key.LeftShift)

        it "maps 0x36 to Key.RightShift":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: maps 0x36 to Key.RightShift")
            val key = scancode_to_key(0x36)
            expect(key).to_equal(Key.RightShift)

        it "maps 0x1D to Key.LeftCtrl":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: maps 0x1D to Key.LeftCtrl")
            val key = scancode_to_key(0x1D)
            expect(key).to_equal(Key.LeftCtrl)

        it "maps 0x38 to Key.LeftAlt":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: maps 0x38 to Key.LeftAlt")
            val key = scancode_to_key(0x38)
            expect(key).to_equal(Key.LeftAlt)

        it "maps letter scancodes correctly":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: maps letter scancodes correctly")
            expect(scancode_to_key(0x10)).to_equal(Key.Q)
            expect(scancode_to_key(0x11)).to_equal(Key.W)
            expect(scancode_to_key(0x12)).to_equal(Key.E)
            expect(scancode_to_key(0x13)).to_equal(Key.R)
            expect(scancode_to_key(0x14)).to_equal(Key.T)
            expect(scancode_to_key(0x15)).to_equal(Key.Y)

        it "maps number scancodes correctly":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: maps number scancodes correctly")
            expect(scancode_to_key(0x02)).to_equal(Key.Num1)
            expect(scancode_to_key(0x03)).to_equal(Key.Num2)
            expect(scancode_to_key(0x0B)).to_equal(Key.Num0)

        it "returns Unknown for unmapped scancode":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: returns Unknown for unmapped scancode")
            val key = scancode_to_key(0xFF)
            expect(key).to_equal(Key.Unknown)

    # ========================================================================
    # Test Group 2: Modifier State Tracking
    # ========================================================================

    describe "Ps2Keyboard modifier tracking":
        it "starts with shift_held false":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: starts with shift_held false")
            val kb = Ps2Keyboard.new()
            expect(kb.shift_held).to_equal(false)

        it "starts with ctrl_held false":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: starts with ctrl_held false")
            val kb = Ps2Keyboard.new()
            expect(kb.ctrl_held).to_equal(false)

        it "starts with alt_held false":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: starts with alt_held false")
            val kb = Ps2Keyboard.new()
            expect(kb.alt_held).to_equal(false)

        it "starts with caps_lock false":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: starts with caps_lock false")
            val kb = Ps2Keyboard.new()
            expect(kb.caps_lock).to_equal(false)

        it "sets shift_held on LeftShift press":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: sets shift_held on LeftShift press")
            var kb = Ps2Keyboard.new()
            kb.update_modifiers_press(Key.LeftShift)
            expect(kb.shift_held).to_equal(true)

        it "sets shift_held on RightShift press":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: sets shift_held on RightShift press")
            var kb = Ps2Keyboard.new()
            kb.update_modifiers_press(Key.RightShift)
            expect(kb.shift_held).to_equal(true)

        it "clears shift_held on LeftShift release":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: clears shift_held on LeftShift release")
            var kb = Ps2Keyboard.new()
            kb.update_modifiers_press(Key.LeftShift)
            kb.update_modifiers_release(Key.LeftShift)
            expect(kb.shift_held).to_equal(false)

        it "sets ctrl_held on LeftCtrl press":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: sets ctrl_held on LeftCtrl press")
            var kb = Ps2Keyboard.new()
            kb.update_modifiers_press(Key.LeftCtrl)
            expect(kb.ctrl_held).to_equal(true)

        it "clears ctrl_held on LeftCtrl release":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: clears ctrl_held on LeftCtrl release")
            var kb = Ps2Keyboard.new()
            kb.update_modifiers_press(Key.LeftCtrl)
            kb.update_modifiers_release(Key.LeftCtrl)
            expect(kb.ctrl_held).to_equal(false)

        it "toggles caps_lock on CapsLock press":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: toggles caps_lock on CapsLock press")
            var kb = Ps2Keyboard.new()
            kb.update_modifiers_press(Key.CapsLock)
            expect(kb.caps_lock).to_equal(true)
            kb.update_modifiers_press(Key.CapsLock)
            expect(kb.caps_lock).to_equal(false)

    # ========================================================================
    # Test Group 3: Key to Character Conversion
    # ========================================================================

    describe "key_to_char":
        it "converts Key.A to lowercase a":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: converts Key.A to lowercase a")
            val kb = Ps2Keyboard.new()
            val ch = kb.key_to_char(Key.A)
            expect(ch == nil).to_equal(false)
            expect(ch.unwrap()).to_equal("a")

        it "converts Key.A to uppercase A with shift":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: converts Key.A to uppercase A with shift")
            var kb = Ps2Keyboard.new()
            kb.update_modifiers_press(Key.LeftShift)
            val ch = kb.key_to_char(Key.A)
            expect(ch == nil).to_equal(false)
            expect(ch.unwrap()).to_equal("A")

        it "converts Key.A to uppercase A with caps lock":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: converts Key.A to uppercase A with caps lock")
            var kb = Ps2Keyboard.new()
            kb.update_modifiers_press(Key.CapsLock)
            val ch = kb.key_to_char(Key.A)
            expect(ch == nil).to_equal(false)
            expect(ch.unwrap()).to_equal("A")

        it "converts Key.Space to space":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: converts Key.Space to space")
            val kb = Ps2Keyboard.new()
            val ch = kb.key_to_char(Key.Space)
            expect(ch == nil).to_equal(false)
            expect(ch.unwrap()).to_equal(" ")

        it "converts Key.Enter to newline":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: converts Key.Enter to newline")
            val kb = Ps2Keyboard.new()
            val ch = kb.key_to_char(Key.Enter)
            expect(ch == nil).to_equal(false)
            expect(ch.unwrap()).to_equal("\n")

        it "converts Key.Num0 to 0":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: converts Key.Num0 to 0")
            val kb = Ps2Keyboard.new()
            val ch = kb.key_to_char(Key.Num0)
            expect(ch == nil).to_equal(false)
            expect(ch.unwrap()).to_equal("0")

        it "returns nil for Key.Escape":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: returns nil for Key.Escape")
            val kb = Ps2Keyboard.new()
            val ch = kb.key_to_char(Key.Escape)
            expect(ch == nil).to_equal(true)

        it "returns nil for Key.Unknown":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: returns nil for Key.Unknown")
            val kb = Ps2Keyboard.new()
            val ch = kb.key_to_char(Key.Unknown)
            expect(ch == nil).to_equal(true)

    # ========================================================================
    # Test Group 4: KeyEvent Construction
    # ========================================================================

    describe "KeyEvent":
        it "constructs Press event":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: constructs Press event")
            val event = KeyEvent.Press(key: Key.A)
            expect(event).to_equal(KeyEvent.Press(key: Key.A))

        it "constructs Release event":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: constructs Release event")
            val event = KeyEvent.Release(key: Key.A)
            expect(event).to_equal(KeyEvent.Release(key: Key.A))

    # ========================================================================
    # ISR ingest / decode split (WS-C, C2 driver half)
    #
    # feed_raw_byte() is the exact store half of isr_ingest(); driving it
    # directly exercises the same decode path the ISR and the poll loop share,
    # without a live PS/2 controller.
    # ========================================================================

    describe "isr_ingest / decode_pending split":
        it "starts with an empty ring and nothing dropped":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: starts with an empty ring and nothing dropped")
            val kbd = Ps2Keyboard.new()
            expect(kbd.raw_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(kbd.raw_dropped).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "decode_pending returns nil on an empty ring":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: decode_pending returns nil on an empty ring")
            var kbd = Ps2Keyboard.new()
            expect(kbd.decode_pending() == nil).to_equal(true)

        # NOTE: these assert against `scancode_to_key(...)` rather than a
        # hardcoded `Key.A`, deliberately. `scancode_to_key` currently returns
        # Key.Unknown for every mapped scancode — a PRE-EXISTING defect (12
        # examples in Test Group 1 of this same file fail on it at HEAD, before
        # the isr_ingest/decode_pending split). These tests are about the SPLIT:
        # they must prove that ingest+decode yields whatever the mapping says,
        # and they must stay green once the mapping defect is fixed. They are
        # not vacuous — the press/release polarity, FIFO order and ring
        # accounting are all real assertions independent of the mapping.

        it "decodes a press scancode into KeyEvent.Press":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: decodes a press scancode into KeyEvent.Press")
            var kbd = Ps2Keyboard.new()
            kbd.feed_raw_byte(0x1E)   # 'A' make code
            expect(kbd.decode_pending()).to_equal(
                KeyEvent.Press(key: scancode_to_key(0x1E))
            )

        it "decodes a break scancode into KeyEvent.Release":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: decodes a break scancode into KeyEvent.Release")
            var kbd = Ps2Keyboard.new()
            kbd.feed_raw_byte(0x9E)   # 'A' break code = 0x1E | 0x80
            expect(kbd.decode_pending()).to_equal(
                KeyEvent.Release(key: scancode_to_key(0x1E))
            )

        it "distinguishes make from break by bit 7":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: distinguishes make from break by bit 7")
            var kbd = Ps2Keyboard.new()
            kbd.feed_raw_byte(0x1E)
            kbd.feed_raw_byte(0x9E)
            val mapped = scancode_to_key(0x1E)
            val down = kbd.decode_pending()
            val up = kbd.decode_pending()
            # Same key, opposite polarity — the 0x80 bit is the only difference
            # between the two input bytes.
            expect(down).to_equal(KeyEvent.Press(key: mapped))
            expect(up).to_equal(KeyEvent.Release(key: mapped))
            expect(down != up).to_equal(true)

        it "emits exactly one event per call, in FIFO order":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: emits exactly one event per call, in FIFO order")
            var kbd = Ps2Keyboard.new()
            kbd.feed_raw_byte(0x1E)   # A down
            kbd.feed_raw_byte(0x9E)   # A up
            kbd.feed_raw_byte(0x30)   # B down
            expect(kbd.raw_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(kbd.decode_pending()).to_equal(
                KeyEvent.Press(key: scancode_to_key(0x1E))
            )
            expect(kbd.decode_pending()).to_equal(
                KeyEvent.Release(key: scancode_to_key(0x1E))
            )
            expect(kbd.decode_pending()).to_equal(
                KeyEvent.Press(key: scancode_to_key(0x30))
            )
            expect(kbd.raw_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(kbd.decode_pending() == nil).to_equal(true)

        it "ingest never mutates modifier state; only decode does":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: ingest never mutates modifier state; only decode does")
            var kbd = Ps2Keyboard.new()
            kbd.feed_raw_byte(0x2A)   # LeftShift make
            kbd.feed_raw_byte(0xAA)   # LeftShift break
            # Two bytes buffered, and the ISR half has touched nothing else.
            expect(kbd.raw_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(kbd.shift_held).to_equal(false)
            expect(kbd.ctrl_held).to_equal(false)
            expect(kbd.alt_held).to_equal(false)

            # The modifier setters themselves are what decode invokes; prove
            # they work independently of the scancode-mapping defect.
            var direct = Ps2Keyboard.new()
            direct.update_modifiers_press(Key.LeftShift)
            expect(direct.shift_held).to_equal(true)
            direct.update_modifiers_release(Key.LeftShift)
            expect(direct.shift_held).to_equal(false)
            direct.update_modifiers_press(Key.LeftCtrl)
            expect(direct.ctrl_held).to_equal(true)
            direct.update_modifiers_press(Key.LeftAlt)
            expect(direct.alt_held).to_equal(true)

        it "drops bytes past ring capacity instead of growing":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: drops bytes past ring capacity instead of growing")
            var kbd = Ps2Keyboard.new()
            var i: i64 = 0
            while i < 64:
                expect(kbd.feed_raw_byte(0x1E)).to_equal(true)
                i = i + 1
            expect(kbd.raw_count).to_equal(64)  # oracle: 64 — named expected value from the requirement
            expect(kbd.feed_raw_byte(0x1E)).to_equal(false)
            expect(kbd.raw_count).to_equal(64)  # oracle: 64 — named expected value from the requirement
            expect(kbd.raw_dropped).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "wraps the ring around capacity without loss":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: wraps the ring around capacity without loss")
            var kbd = Ps2Keyboard.new()
            var round: i64 = 0
            while round < 100:
                kbd.feed_raw_byte(0x1E)
                expect(kbd.decode_pending()).to_equal(
                    KeyEvent.Press(key: scancode_to_key(0x1E))
                )
                round = round + 1
            expect(kbd.raw_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(kbd.raw_dropped).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # ========================================================================
    # NO-REGRESSION PROOF vs the pre-split poll() algorithm.
    #
    # reference_decode_scancode below is a verbatim transcription of the
    # ORIGINAL poll() decode body (bit-7 break test, 0x7F mask, modifier
    # update, Press/Release construction). The split path must agree with it
    # on a recorded scancode sequence.
    # ========================================================================

    describe "no-regression vs the pre-split poll algorithm":
        it "agrees with the reference decoder on a recorded scancode stream":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: agrees with the reference decoder on a recorded scancode stream")
            val recorded = [
                0x2A,   # LeftShift down
                0x1E,   # A down
                0x9E,   # A up
                0xAA,   # LeftShift up
                0x1D,   # LeftCtrl down
                0x2E,   # C down
                0xAE,   # C up
                0x9D,   # LeftCtrl up
                0x39,   # Space down
                0xB9    # Space up
            ]

            var kbd = Ps2Keyboard.new()
            var ref_kbd = Ps2Keyboard.new()

            for code in recorded:
                kbd.feed_raw_byte(code)
                val got = kbd.decode_pending()
                val want = reference_decode_scancode(ref_kbd, code)
                expect(got).to_equal(want)
                # Modifier state must track identically too
                expect(kbd.shift_held).to_equal(ref_kbd.shift_held)
                expect(kbd.ctrl_held).to_equal(ref_kbd.ctrl_held)
                expect(kbd.alt_held).to_equal(ref_kbd.alt_held)
