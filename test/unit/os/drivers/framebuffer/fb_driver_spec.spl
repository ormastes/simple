# @req: REQ-OS-DRIVERS-001

"""
# Framebuffer Driver Specification

**Feature IDs:** #OS-FB
**Category:** Infrastructure
**Difficulty:** 2/5
**Status:** In Progress

## Overview

Tests Color struct construction, ARGB packing, static color constructors,
and the 8x16 bitmap font glyph lookup.
"""

use std.spec
use os.drivers.framebuffer.fb_driver.{Color}
use common.ui.glyph_bitmap_8x16.{get_glyph_8x16}


# ============================================================================
# Test Group 1: Color Construction
# ============================================================================

describe "Color":
    describe "rgb":
        it "creates color with full alpha":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: creates color with full alpha")
            val c = Color.rgb(128, 64, 32)
            expect(c.r).to_equal(128)  # oracle: 128 — named expected value from the requirement
            expect(c.g).to_equal(64)  # oracle: 64 — named expected value from the requirement
            expect(c.b).to_equal(32)  # oracle: 32 — named expected value from the requirement
            expect(c.a).to_equal(255)  # oracle: 255 — named expected value from the requirement

        it "creates color with zero components":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: creates color with zero components")
            val c = Color.rgb(0, 0, 0)
            expect(c.r).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(c.g).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(c.b).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "creates color with max components":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: creates color with max components")
            val c = Color.rgb(255, 255, 255)
            expect(c.r).to_equal(255)  # oracle: 255 — named expected value from the requirement
            expect(c.g).to_equal(255)  # oracle: 255 — named expected value from the requirement
            expect(c.b).to_equal(255)  # oracle: 255 — named expected value from the requirement

    # ========================================================================
    # Test Group 2: ARGB Packing
    # ========================================================================

    describe "to_u32":
        it "packs black as 0xFF000000":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: packs black as 0xFF000000")
            val c = Color.black()
            expect(c.to_u32()).to_equal(0xFF000000)

        it "packs white as 0xFFFFFFFF":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: packs white as 0xFFFFFFFF")
            val c = Color.white()
            expect(c.to_u32()).to_equal(0xFFFFFFFF)

        it "packs red as 0xFFFF0000":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: packs red as 0xFFFF0000")
            val c = Color.red()
            expect(c.to_u32()).to_equal(0xFFFF0000)

        it "packs green as 0xFF00FF00":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: packs green as 0xFF00FF00")
            val c = Color.green()
            expect(c.to_u32()).to_equal(0xFF00FF00)

        it "packs blue as 0xFF0000FF":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: packs blue as 0xFF0000FF")
            val c = Color.blue()
            expect(c.to_u32()).to_equal(0xFF0000FF)

        it "encodes alpha in bits 31-24":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: encodes alpha in bits 31-24")
            val c = Color(r: 0, g: 0, b: 0, a: 128)
            val alpha_bits = (c.to_u32() >> 24) & 0xFF
            expect(alpha_bits).to_equal(128)  # oracle: 128 — named expected value from the requirement

        it "encodes red in bits 23-16":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: encodes red in bits 23-16")
            val c = Color.rgb(0xAB, 0, 0)
            val red_bits = (c.to_u32() >> 16) & 0xFF
            expect(red_bits).to_equal(0xAB)

        it "encodes green in bits 15-8":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: encodes green in bits 15-8")
            val c = Color.rgb(0, 0xCD, 0)
            val green_bits = (c.to_u32() >> 8) & 0xFF
            expect(green_bits).to_equal(0xCD)

        it "encodes blue in bits 7-0":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: encodes blue in bits 7-0")
            val c = Color.rgb(0, 0, 0xEF)
            val blue_bits = c.to_u32() & 0xFF
            expect(blue_bits).to_equal(0xEF)

    # ========================================================================
    # Test Group 3: Static Color Constructors
    # ========================================================================

    describe "static constructors":
        it "black is (0,0,0)":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: black is (0,0,0)")
            val c = Color.black()
            expect(c.r).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(c.g).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(c.b).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "white is (255,255,255)":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: white is (255,255,255)")
            val c = Color.white()
            expect(c.r).to_equal(255)  # oracle: 255 — named expected value from the requirement
            expect(c.g).to_equal(255)  # oracle: 255 — named expected value from the requirement
            expect(c.b).to_equal(255)  # oracle: 255 — named expected value from the requirement

        it "red is (255,0,0)":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: red is (255,0,0)")
            val c = Color.red()
            expect(c.r).to_equal(255)  # oracle: 255 — named expected value from the requirement
            expect(c.g).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(c.b).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "green is (0,255,0)":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: green is (0,255,0)")
            val c = Color.green()
            expect(c.r).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(c.g).to_equal(255)  # oracle: 255 — named expected value from the requirement
            expect(c.b).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "blue is (0,0,255)":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: blue is (0,0,255)")
            val c = Color.blue()
            expect(c.r).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(c.g).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(c.b).to_equal(255)  # oracle: 255 — named expected value from the requirement

        it "gray is (128,128,128)":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: gray is (128,128,128)")
            val c = Color.gray()
            expect(c.r).to_equal(128)  # oracle: 128 — named expected value from the requirement
            expect(c.g).to_equal(128)  # oracle: 128 — named expected value from the requirement
            expect(c.b).to_equal(128)  # oracle: 128 — named expected value from the requirement

        it "dark_gray is (64,64,64)":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: dark_gray is (64,64,64)")
            val c = Color.dark_gray()
            expect(c.r).to_equal(64)  # oracle: 64 — named expected value from the requirement
            expect(c.g).to_equal(64)  # oracle: 64 — named expected value from the requirement
            expect(c.b).to_equal(64)  # oracle: 64 — named expected value from the requirement

        it "light_gray is (192,192,192)":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: light_gray is (192,192,192)")
            val c = Color.light_gray()
            expect(c.r).to_equal(192)  # oracle: 192 — named expected value from the requirement
            expect(c.g).to_equal(192)  # oracle: 192 — named expected value from the requirement
            expect(c.b).to_equal(192)  # oracle: 192 — named expected value from the requirement


# ============================================================================
# Test Group 4: 8x16 Glyph Lookup
# ============================================================================

describe "get_glyph_8x16":
    it "returns 16 bytes per glyph":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: returns 16 bytes per glyph")
        val glyph = get_glyph_8x16(0x41)  # 'A'
        expect(glyph.len()).to_equal(16)  # oracle: 16 — named expected value from the requirement

    it "returns all zeros for space (0x20)":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: returns all zeros for space (0x20)")
        val glyph = get_glyph_8x16(0x20)
        var all_zero = true
        for byte in glyph:
            if byte != 0:
                all_zero = false
        expect(all_zero).to_equal(true)

    it "returns non-zero bitmap for A (0x41)":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: returns non-zero bitmap for A (0x41)")
        val glyph = get_glyph_8x16(0x41)
        var has_nonzero = false
        for byte in glyph:
            if byte != 0:
                has_nonzero = true
        expect(has_nonzero).to_equal(true)

    it "returns non-zero bitmap for B (0x42)":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: returns non-zero bitmap for B (0x42)")
        val glyph = get_glyph_8x16(0x42)
        var has_nonzero = false
        for byte in glyph:
            if byte != 0:
                has_nonzero = true
        expect(has_nonzero).to_equal(true)

    it "returns non-zero bitmap for S (0x53)":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: returns non-zero bitmap for S (0x53)")
        val glyph = get_glyph_8x16(0x53)
        var has_nonzero = false
        for byte in glyph:
            if byte != 0:
                has_nonzero = true
        expect(has_nonzero).to_equal(true)

    it "returns filled block for unknown char":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: returns filled block for unknown char")
        val glyph = get_glyph_8x16(0x7F)  # DEL - not defined, gets default
        var all_ff = true
        for byte in glyph:
            if byte != 0xFF:
                all_ff = false
        expect(all_ff).to_equal(true)

    it "space glyph first row is zero":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: space glyph first row is zero")
        val glyph = get_glyph_8x16(0x20)
        expect(glyph[0]).to_equal(0x00)

    it "A glyph has specific known row values":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: A glyph has specific known row values")
        val glyph = get_glyph_8x16(0x41)
        # Row 2 (index 2) = 0x10, Row 3 (index 3) = 0x38
        expect(glyph[2]).to_equal(0x10)
        expect(glyph[3]).to_equal(0x38)
