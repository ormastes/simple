"""
## Purpose and audience
Purpose: Prove that WindowSurface.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-OS-COMPOSITOR-001 — stable requirement identity for this spec.

# Compositor Unit Tests
#
# Tests for WindowSurface, Compositor: construction, create_window,
# destroy_window, focus_window, and Z-order management.

use std.spec
use os.compositor.compositor.{Compositor, WindowSurface, WM_CONTENT_KIND_EMPTY}
use os.compositor.cursor.{CursorState}
use os.compositor.display_backend.{CompositorBackend, CompositorGlassCapable}
use os.compositor.host_compositor_entry.{HeadlessHostCompositorBackend}
use os.drivers.framebuffer.fb_driver.{Color}

# ============================================================================
# WindowSurface Construction
# ============================================================================

describe "WindowSurface":
    it "constructs with all fields":
        step("Verify: constructs with all fields")
        # @req: REQ-OS-COMPOSITOR-001
        val surface = WindowSurface(
            id: 1,
            title: "Test Window",
            x: 100,
            y: 50,
            width: 640,
            height: 480,
            visible: true,
            content_kind: WM_CONTENT_KIND_EMPTY,
            content_handle: 0,
            content_html: "<p>runtime</p>",
            content_revision: 2,
            dirty: false,
            owner_port: 0,
            process_id: 0,
            app_id: ""
        )
        expect(surface.id).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(surface.title).to_equal("Test Window")
        expect(surface.x).to_equal(100)  # oracle: 100 — named expected value from the requirement
        expect(surface.y).to_equal(50)  # oracle: 50 — named expected value from the requirement
        expect(surface.width).to_equal(640)  # oracle: 640 — named expected value from the requirement
        expect(surface.height).to_equal(480)  # oracle: 480 — named expected value from the requirement
        expect(surface.visible).to_equal(true)
        expect(surface.dirty).to_equal(false)

    it "has correct title":
        step("Verify: has correct title")
        val surface = WindowSurface(
            id: 42,
            title: "My App",
            x: 0, y: 0,
            width: 800, height: 600,
            visible: true, content_kind: WM_CONTENT_KIND_EMPTY,
            content_handle: 0, dirty: true,
            content_html: "", content_revision: 1,
            owner_port: 0,
            process_id: 0,
            app_id: ""
        )
        expect(surface.title).to_equal("My App")

    it "supports dirty flag":
        step("Verify: supports dirty flag")
        val surface = WindowSurface(
            id: 1,
            title: "Dirty",
            x: 0, y: 0,
            width: 100, height: 100,
            visible: true, content_kind: WM_CONTENT_KIND_EMPTY,
            content_handle: 0, dirty: true,
            content_html: "", content_revision: 1,
            owner_port: 0,
            process_id: 0,
            app_id: ""
        )
        expect(surface.dirty).to_equal(true)

# ============================================================================
# Compositor Construction
# ============================================================================

describe "Compositor":
    context "when newly created":
        it "starts with empty surfaces":
            step("Verify: starts with empty surfaces")
            val comp = _make_test_compositor()
            expect(comp.surfaces.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "starts with focused_idx at -1":
            step("Verify: starts with focused_idx at -1")
            val comp = _make_test_compositor()
            expect(comp.focused_idx).to_equal(-1)  # oracle: -1 — named expected value from the requirement

        it "starts with next_id at 1":
            step("Verify: starts with next_id at 1")
            val comp = _make_test_compositor()
            expect(comp.next_id).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "starts not running":
            step("Verify: starts not running")
            val comp = _make_test_compositor()
            expect(comp.running).to_equal(false)

# ============================================================================
# Window Creation
# ============================================================================

describe "Compositor create_window":
    it "returns window ID":
        step("Verify: returns window ID")
        var comp = _make_test_compositor()
        val id = comp.create_window("Test", 0, 0, 640, 480)
        expect(id).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "adds surface to list":
        step("Verify: adds surface to list")
        var comp = _make_test_compositor()
        val id = comp.create_window("Test", 0, 0, 640, 480)
        expect(comp.surfaces.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "increments next_id":
        step("Verify: increments next_id")
        var comp = _make_test_compositor()
        val id1 = comp.create_window("Win1", 0, 0, 640, 480)
        val id2 = comp.create_window("Win2", 100, 100, 640, 480)
        expect(id1).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(id2).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "creates multiple windows":
        step("Verify: creates multiple windows")
        var comp = _make_test_compositor()
        val _ = comp.create_window("A", 0, 0, 640, 480)
        val _ = comp.create_window("B", 100, 0, 640, 480)
        val _ = comp.create_window("C", 200, 0, 640, 480)
        expect(comp.surfaces.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "sets correct title on created surface":
        step("Verify: sets correct title on created surface")
        var comp = _make_test_compositor()
        val id = comp.create_window("My Window", 10, 20, 800, 600)
        expect(comp.surfaces[0].title).to_equal("My Window")

    it "sets correct position on created surface":
        step("Verify: sets correct position on created surface")
        var comp = _make_test_compositor()
        val id = comp.create_window("Pos", 50, 75, 400, 300)
        expect(comp.surfaces[0].x).to_equal(50)  # oracle: 50 — named expected value from the requirement
        expect(comp.surfaces[0].y).to_equal(75)  # oracle: 75 — named expected value from the requirement

    it "sets correct size on created surface":
        step("Verify: sets correct size on created surface")
        var comp = _make_test_compositor()
        val id = comp.create_window("Size", 0, 0, 1024, 768)
        expect(comp.surfaces[0].width).to_equal(1024)  # oracle: 1024 — named expected value from the requirement
        expect(comp.surfaces[0].height).to_equal(768)  # oracle: 768 — named expected value from the requirement

    it "creates visible window":
        step("Verify: creates visible window")
        var comp = _make_test_compositor()
        val id = comp.create_window("Visible", 0, 0, 640, 480)
        expect(comp.surfaces[0].visible).to_equal(true)

    it "focuses newly created window":
        step("Verify: focuses newly created window")
        var comp = _make_test_compositor()
        val id = comp.create_window("Focus", 0, 0, 640, 480)
        expect(comp.focused_idx).to_be_greater_than(-1)

# ============================================================================
# Window Identity Metadata
# ============================================================================

describe "Compositor identity metadata":
    it "preserves process and app identity across window updates":
        step("Verify: preserves process and app identity across window updates")
        var comp = _make_test_compositor()
        val id = comp.create_window("Identity", 0, 0, 640, 480)
        comp.set_window_identity(id, 99, "app.identity")
        comp.move_window(id, 20, 30)
        expect(comp.window_process_id(id)).to_equal(99)  # oracle: 99 — named expected value from the requirement
        expect(comp.window_app_id(id)).to_equal("app.identity")
        expect(comp.window_count_for_process(99)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(comp.windows_for_process(99).len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

# ============================================================================
# Window Destruction
# ============================================================================

describe "Compositor destroy_window":
    it "removes window by ID":
        step("Verify: removes window by ID")
        var comp = _make_test_compositor()
        val id = comp.create_window("ToRemove", 0, 0, 640, 480)
        comp.destroy_window(id)
        expect(comp.surfaces.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "does not remove other windows":
        step("Verify: does not remove other windows")
        var comp = _make_test_compositor()
        val id1 = comp.create_window("Keep", 0, 0, 640, 480)
        val id2 = comp.create_window("Remove", 100, 0, 640, 480)
        comp.destroy_window(id2)
        expect(comp.surfaces.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(comp.surfaces[0].title).to_equal("Keep")

    it "handles destroying from list of three":
        step("Verify: handles destroying from list of three")
        var comp = _make_test_compositor()
        val id1 = comp.create_window("A", 0, 0, 640, 480)
        val id2 = comp.create_window("B", 100, 0, 640, 480)
        val id3 = comp.create_window("C", 200, 0, 640, 480)
        comp.destroy_window(id2)
        expect(comp.surfaces.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

# ============================================================================
# Window Focus
# ============================================================================

describe "Compositor focus_window":
    it "updates focused_idx":
        step("Verify: updates focused_idx")
        var comp = _make_test_compositor()
        val id1 = comp.create_window("A", 0, 0, 640, 480)
        val id2 = comp.create_window("B", 100, 0, 640, 480)
        comp.focus_window(id1)
        # The focused window should be moved to front (last position in Z-order)
        val last_idx = comp.surfaces.len() - 1
        expect(comp.surfaces[last_idx].id).to_equal(id1)

    it "brings focused window to front of Z-order":
        step("Verify: brings focused window to front of Z-order")
        var comp = _make_test_compositor()
        val id1 = comp.create_window("Back", 0, 0, 640, 480)
        val id2 = comp.create_window("Front", 100, 0, 640, 480)
        # id2 is currently front; focus id1 should bring it to front
        comp.focus_window(id1)
        val last = comp.surfaces[comp.surfaces.len() - 1]
        expect(last.id).to_equal(id1)

    it "updates focused_idx to correct position":
        step("Verify: updates focused_idx to correct position")
        var comp = _make_test_compositor()
        val id1 = comp.create_window("A", 0, 0, 640, 480)
        val id2 = comp.create_window("B", 100, 0, 640, 480)
        comp.focus_window(id1)
        expect(comp.focused_idx).to_be_greater_than(-1)
        expect(comp.focused_idx).to_be_less_than(comp.surfaces.len())

# ============================================================================
# Z-Order Management
# ============================================================================

describe "Compositor Z-order":
    it "new windows are added at end (front)":
        step("Verify: new windows are added at end (front)")
        var comp = _make_test_compositor()
        val id1 = comp.create_window("Back", 0, 0, 640, 480)
        val id2 = comp.create_window("Front", 100, 0, 640, 480)
        val last = comp.surfaces[comp.surfaces.len() - 1]
        expect(last.id).to_equal(id2)

    it "first window is at index 0 (backmost)":
        step("Verify: first window is at index 0 (backmost)")
        var comp = _make_test_compositor()
        val id1 = comp.create_window("First", 0, 0, 640, 480)
        val id2 = comp.create_window("Second", 100, 0, 640, 480)
        expect(comp.surfaces[0].id).to_equal(id1)

    it "surfaces list length matches window count":
        step("Verify: surfaces list length matches window count")
        var comp = _make_test_compositor()
        expect(comp.surfaces.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val _ = comp.create_window("A", 0, 0, 640, 480)
        expect(comp.surfaces.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val _ = comp.create_window("B", 100, 0, 640, 480)
        expect(comp.surfaces.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

# ============================================================================
# Cycle Focus
# ============================================================================

describe "Compositor cycle_focus":
    it "does nothing with single window":
        step("Verify: does nothing with single window")
        var comp = _make_test_compositor()
        val _ = comp.create_window("Only", 0, 0, 640, 480)
        val before = comp.focused_idx
        comp.cycle_focus()
        # Should still be focused on the only window
        expect(comp.surfaces.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "does nothing with no windows":
        step("Verify: does nothing with no windows")
        var comp = _make_test_compositor()
        comp.cycle_focus()
        expect(comp.focused_idx).to_equal(-1)  # oracle: -1 — named expected value from the requirement

# ============================================================================
# Helpers
# ============================================================================

fn _make_test_compositor() -> Compositor:
    """Create a minimal Compositor for testing.

    Uses stubbed framebuffer, keyboard, and mouse since we only test
    window management logic, not rendering or input hardware.
    """
    val cursor = CursorState(
        x: 512,
        y: 384,
        visible: true,
        hotspot_x: 1,
        hotspot_y: 1
    )
    val backend = HeadlessHostCompositorBackend.new(1024, 768)
    return Compositor(
        surfaces: [],
        focused_idx: -1,
        backend: backend,
        input: nil,
        cursor: cursor,
        desktop_bg: Color.rgb(0, 48, 96),
        next_id: 1,
        screen_width: 1024,
        screen_height: 768,
        running: false,
        dragging: false,
        drag_window_id: 0,
        drag_offset_x: 0,
        drag_offset_y: 0,
        pending_meta_key: 0,
        pending_shortcut: ""
    )
