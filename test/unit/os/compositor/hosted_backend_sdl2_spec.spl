# @cover src/os/compositor/hosted_backend_sdl2.spl 70%
"""
# Hosted SDL2 Backend Spec

Unit tests for the SDL2 compositor backend. Tests use the headless
fallback path since rt_sdl2_* externs return stubs in test mode.
"""

use std.spec.{describe, it, expect}
use os.compositor.display_backend.{CompositorBackend, CompositorGlassCapable}
use os.compositor.hosted_backend_sdl2.{HostedSdl2Backend}

describe "HostedSdl2Backend":

    it "reports sdl2-native as implementation name":
        expect(HostedSdl2Backend.implementation_name()).to_equal("sdl2-native")

    it "rejects zero-width creation":
        val result = HostedSdl2Backend.try_create(0, 480, "test")
        expect(result).to_equal(nil)

    it "rejects zero-height creation":
        val result = HostedSdl2Backend.try_create(640, 0, "test")
        expect(result).to_equal(nil)

    it "rejects negative dimensions":
        val result = HostedSdl2Backend.try_create(-1, -1, "test")
        expect(result).to_equal(nil)

    # Regression coverage for doc/04_architecture/ui/sdl2_seam_subset_audit.md:
    # `clear`/`fill_rect`/`present` used to call rt_sdl2_clear/rt_sdl2_fill_rect/
    # rt_sdl2_present, none of which exist in runtime_sdl2.c. clear/fill_rect/
    # put_pixel are fixed to be CPU-buffer-only (there is no native
    # per-primitive draw entry point, only whole-frame rt_sdl2_present_rgba);
    # this exercises that buffer directly via a hand-built instance, bypassing
    # try_create (which needs a real display and returns nil headless).
    it "clear/fill_rect/put_pixel update the CPU pixel buffer directly":
        val be = HostedSdl2Backend(window_handle: 0, w: 4, h: 4, pixels: [0u32; 16])
        be.clear(0xAABBCCDDu32)
        expect(be.read_pixel(0, 0)).to_equal(0xAABBCCDDu32)
        be.fill_rect(1, 1, 2, 2, 0x11223344u32)
        expect(be.read_pixel(1, 1)).to_equal(0x11223344u32)
        be.put_pixel(3, 3, 0x99999999u32)
        expect(be.read_pixel(3, 3)).to_equal(0x99999999u32)

    # `resize_window` used to call a nonexistent rt_sdl2_resize_window; fixed
    # to call the real status-returning rt_sdl2_set_window_size. This proves
    # the wrapper rejects a dead handle before mutating its local dimensions.
    it "resize() refuses on a dead window handle instead of reporting fake success":
        val be = HostedSdl2Backend(window_handle: 0, w: 4, h: 4, pixels: [0u32; 16])
        expect(be.resize(8, 8)).to_equal(false)
        expect(be.width()).to_equal(4)
        expect(be.height()).to_equal(4)
