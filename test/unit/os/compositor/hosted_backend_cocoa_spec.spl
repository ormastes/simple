"""
## Purpose and audience
Behavioral specification for hosted backend cocoa.
Audience: compiler/runtime developers and spec maintainers who need
to verify this component's observable behavior and pinned values.
"""
# @req: REQ-TEST-COMPOSITOR_HOSTED_BACKEND_COCO-001
# Hosted Cocoa Backend — native SFFI boundary spec
#
# `HostedCocoaBackend` binds the runtime `rt_cocoa_*` symbols. The default
# non-macOS/non-cocoa-real runtime exports stubs, so tests avoid requiring a
# native window while still locking the Simple-side contract.

use std.spec.{describe, it, expect}
use std.io_runtime.{host_os}
use os.compositor.hosted_backend_cocoa.{HostedCocoaBackend}

describe "HostedCocoaBackend native boundary":

    it "names the implementation as the Cocoa SFFI backend":
        # @req: REQ-TEST-COMPOSITOR_HOSTED_BACKEND_COCO-001
        step("Verify: names the implementation as the Cocoa SFFI backend")
        expect(HostedCocoaBackend.implementation_name()).to_equal("cocoa-real-sffi")

    it "reports native Cocoa symbol use only when actually running on macOS":
        # @req: REQ-TEST-COMPOSITOR_HOSTED_BACKEND_COCO-001
        step("Verify: reports native Cocoa symbol use only when actually running on macOS")
        # Was a hardcoded `true` (false-success on every non-macOS host); now
        # a real is_macos() runtime OS probe. This suite runs on Linux CI, so
        # the honest answer here is false.
        expect(HostedCocoaBackend.uses_native_cocoa_symbols()).to_equal(host_os() == "macos")

    it "instantiates through the test seam without touching SFFI":
        # @req: REQ-TEST-COMPOSITOR_HOSTED_BACKEND_COCO-001
        step("Verify: instantiates through the test seam without touching SFFI")
        val be = HostedCocoaBackend.new(11, 22, 320, 240)
        expect(be.window_id).to_equal(11)  # oracle: expected value pinned by spec
        expect(be.buffer_id).to_equal(22)  # oracle: expected value pinned by spec
        expect(be.w).to_equal(320)  # oracle: expected value pinned by spec
        expect(be.h).to_equal(240)  # oracle: expected value pinned by spec

    it "keeps CompositorBackend method signatures aligned with u32/i32 contract":
        # @req: REQ-TEST-COMPOSITOR_HOSTED_BACKEND_COCO-001
        step("Verify: keeps CompositorBackend method signatures aligned with u32/i32 contract")
        val be = HostedCocoaBackend.new(0, 0, 128, 128)
        if false:
            be.clear(0xFF000000)
            be.fill_rect(0, 0, 10, 10, 0xFFFFFFFF)
            be.draw_text(0, 0, "x", 0xFFFFFFFF, 0xFF000000)
            val ch: u8 = 65
            be.draw_char_8x16(0, 0, ch, 0xFFFFFFFF, 0xFF000000)
            be.put_pixel(0, 0, 0xFF0000FF)
            be.present()
            be.present_rect(0, 0, 64, 64)
        expect(be.w).to_equal(128)  # oracle: expected value pinned by spec

    it "keeps glass method signatures aligned with u32/i32 contract":
        # @req: REQ-TEST-COMPOSITOR_HOSTED_BACKEND_COCO-001
        step("Verify: keeps glass method signatures aligned with u32/i32 contract")
        val be = HostedCocoaBackend.new(0, 0, 128, 128)
        if false:
            val alpha: u8 = 128
            be.blend_rect(0, 0, 64, 64, 0x80FFFFFF, alpha)
            val radius: u32 = 4
            be.blur_region(0, 0, 64, 64, radius)
            be.gradient_v(0, 0, 64, 64, 0xFF000000, 0xFFFFFFFF)
            val _px = be.read_pixel(0, 0)
        expect(be.h).to_equal(128)  # oracle: expected value pinned by spec

    it "keeps lifecycle signatures deterministic":
        # @req: REQ-TEST-COMPOSITOR_HOSTED_BACKEND_COCO-001
        step("Verify: keeps lifecycle signatures deterministic")
        val be = HostedCocoaBackend.new(0, 0, 64, 64)
        if false:
            val _created = HostedCocoaBackend.try_create(1, 64, 64, 0xFF000000)
            val _ok = be.resize(128, 128)
            be.free()
        expect(be.w + be.h).to_equal(128)  # oracle: expected value pinned by spec

    it "rejects invalid native Cocoa surface sizes before SFFI":
        # @req: REQ-TEST-COMPOSITOR_HOSTED_BACKEND_COCO-001
        step("Verify: rejects invalid native Cocoa surface sizes before SFFI")
        val created = HostedCocoaBackend.try_create(0, 0, 64, 0xFF000000)
        expect(created).to_equal(nil)
