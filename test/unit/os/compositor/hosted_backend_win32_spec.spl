"""
## Purpose and audience
Purpose: Prove that HostedWin32Backend alias boundary.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-OS-COMPOSITOR-001 — stable requirement identity for this spec.

# Hosted Win32 Backend — native Win32 coverage spec
#
# `HostedWin32Backend` wraps native Win32 API (CreateWindowEx, DIB, BitBlt)
# via rt_win32_* SFFI externs. These tests avoid host SFFI calls and assert
# the backend contract explicitly.

use std.spec.{describe, it, expect}
use std.io_runtime.{host_os}
use os.compositor.hosted_backend_win32.{HostedWin32Backend}

use std.spec.step

describe "HostedWin32Backend alias boundary":

    it "names the implementation as win32-native":
        step("Verify: names the implementation as win32-native")
        # @req: REQ-OS-COMPOSITOR-001
        expect(HostedWin32Backend.implementation_name()).to_equal("win32-native")

    it "reports native Win32 symbol use only when actually running on Windows":
        step("Verify: reports native Win32 symbol use only when actually running on Windows")
        expect(HostedWin32Backend.uses_native_win32_symbols()).to_equal(host_os() == "windows")

    it "instantiates through the test seam without touching SFFI":
        step("Verify: instantiates through the test seam without touching SFFI")
        val be = HostedWin32Backend.new(11, 22, 320, 240)
        expect(be.window_id).to_equal(11)  # oracle: 11 — named expected value from the requirement
        expect(be.buffer_id).to_equal(22)  # oracle: 22 — named expected value from the requirement
        expect(be.w).to_equal(320)  # oracle: 320 — named expected value from the requirement
        expect(be.h).to_equal(240)  # oracle: 240 — named expected value from the requirement

    it "keeps CompositorBackend method signatures aligned with u32/i32 contract":
        step("Verify: keeps CompositorBackend method signatures aligned with u32/i32 contract")
        val be = HostedWin32Backend.new(0, 0, 128, 128)
        if false:
            be.clear(0xFF000000)
            be.fill_rect(0, 0, 10, 10, 0xFFFFFFFF)
            be.draw_text(0, 0, "x", 0xFFFFFFFF, 0xFF000000)
            val ch: u8 = 65
            be.draw_char_8x16(0, 0, ch, 0xFFFFFFFF, 0xFF000000)
            be.put_pixel(0, 0, 0xFF0000FF)
            be.present()
            be.present_rect(0, 0, 64, 64)
        expect(be.w).to_equal(128)  # oracle: 128 — named expected value from the requirement

    it "keeps glass method signatures aligned with u32/i32 contract":
        step("Verify: keeps glass method signatures aligned with u32/i32 contract")
        val be = HostedWin32Backend.new(0, 0, 128, 128)
        if false:
            val alpha: u8 = 128
            be.blend_rect(0, 0, 64, 64, 0x80FFFFFF, alpha)
            val radius: u32 = 4
            be.blur_region(0, 0, 64, 64, radius)
            be.gradient_v(0, 0, 64, 64, 0xFF000000, 0xFFFFFFFF)
            val _px = be.read_pixel(0, 0)
        expect(be.h).to_equal(128)  # oracle: 128 — named expected value from the requirement

    it "keeps lifecycle signatures deterministic":
        step("Verify: keeps lifecycle signatures deterministic")
        val be = HostedWin32Backend.new(0, 0, 64, 64)
        if false:
            val _created = HostedWin32Backend.try_create(1, 64, 64, 0xFF000000)
            val _ok = be.resize(128, 128)
            be.free()
        expect(be.w + be.h).to_equal(128)  # oracle: 128 — named expected value from the requirement
