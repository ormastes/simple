use std.spec.{describe, it, expect}
use os._QemuRunner.guest_evidence_contract.{GuestEvidenceOperation, SimpleOsQemuEvidenceDescriptor, simpleos_qemu_evidence_contract_only}

describe "SimpleOS QEMU guest evidence descriptor":
    it "accepts only bundle-relative safe program paths and all ISA widths":
        val isas = ["x86_32", "x86_64", "arm32", "arm64", "riscv32", "riscv64"]
        for isa in isas:
            val d = SimpleOsQemuEvidenceDescriptor(isa: isa, accelerator: "tcg", base_image: "/base", overlay_image: "/overlay", firmware: "/firmware", cloudinit: "/cloudinit", ssh_port: 2222, ssh_user: "root", guest_program: "/bin/simple", operation: GuestEvidenceOperation.Version, challenge: "0123456789abcdef", serial_log: "/serial", ssh_log: "/ssh", timeout_ms: 1000, contract_only: true)
            expect simpleos_qemu_evidence_contract_only(d)

    it "rejects traversal and non-contract promotion":
        val d = SimpleOsQemuEvidenceDescriptor(isa: "riscv64", accelerator: "kvm", base_image: "/base", overlay_image: "/overlay", firmware: "/firmware", cloudinit: "/cloudinit", ssh_port: 2222, ssh_user: "root", guest_program: "/tmp/../bin/simple", operation: GuestEvidenceOperation.Run, challenge: "0123456789abcdef", serial_log: "/serial", ssh_log: "/ssh", timeout_ms: 1000, contract_only: false)
        expect not simpleos_qemu_evidence_contract_only(d)
