# @cover src/os/tools/shell/awk/awk_tool.spl 75%
"""
## Purpose and audience
Purpose: prints whole line via $0
Audience: compiler and tooling engineers who maintain this spec

# AWK Tool Specification

**Feature IDs:** #shell-awk-tool
**Category:** Infrastructure
**Difficulty:** 3/5
**Status:** Draft
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A
**Artifacts:** N/A
**Screenshots:** N/A
**TUI Captures:** N/A
**Logs:** N/A

## Overview

Validates the basic POSIX awk implementation (awk_tool.spl) that is invoked
via the shell `awk` command inside SimpleOS.

Scope (this iteration):
- Field splitting with default IFS (whitespace)
- $0 (whole record), $1..$NF (fields), NF (field count), NR (record number)
- BEGIN and END blocks
- Pattern/action pairs — pattern is a string literal or /regex/ match
- Built-in print and printf actions
- Exit code 0 on success, nonzero on bad program syntax

## Key Concepts

| Concept | Description |
|---------|-------------|
| tool_awk | Entry fn: tool_awk(vfs, cwd, args, terminal) -> i32 |
| Record | One input line; $0 is full text, $1..$NF are whitespace-split fields |
| NR | Current record (line) number, 1-based |
| NF | Number of fields in the current record |
| BufferingTerminal | Used by $(cmd) substitution to capture awk output |
"""

# @req: REQ-OS-Awk-001

use std.spipe.*
use os.tools.shell.awk.awk_tool.{tool_awk}
use os.apps.terminal.terminal.{Terminal, BufferingTerminal}


# ============================================================================
# Helpers
# ============================================================================

fn _run_awk(program: text, input: text) -> text:
    """Run awk program against input text; return captured stdout."""
    val term = BufferingTerminal.new()
    val args = [program]
    tool_awk(nil, "/", args, term, input)
    return term.captured()

fn _run_awk_exit(program: text, input: text) -> i32:
    """Return exit code from running awk program against input."""
    val term = BufferingTerminal.new()
    val args = [program]
    return tool_awk(nil, "/", args, term, input)


# ============================================================================
# Test Group 1: Field splitting
# ============================================================================

use std.spec.step
describe "awk field splitting":
    """
    ## Field Splitting

    By default awk splits each record on whitespace. $0 is the whole line,
    $1 is the first field, $NF is the last field, NF is the count.
    """

    it "prints whole line via $0":
        step("Verify: prints whole line via $0")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("{ print $0 }", "hello world")
        val t0 = out.trim()
        expect(t0).to_equal("hello world")

    it "prints first field via $1":
        step("Verify: prints first field via $1")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("{ print $1 }", "alpha beta gamma")
        val t1 = out.trim()
        expect(t1).to_equal("alpha")

    it "prints second field via $2":
        step("Verify: prints second field via $2")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("{ print $2 }", "alpha beta gamma")
        val t2 = out.trim()
        expect(t2).to_equal("beta")

    it "prints last field via $NF":
        step("Verify: prints last field via $NF")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("{ print $NF }", "alpha beta gamma")
        val tnf = out.trim()
        expect(tnf).to_equal("gamma")

    it "NF equals number of whitespace-separated tokens":
        step("Verify: NF equals number of whitespace-separated tokens")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("{ print NF }", "a b c d")
        val tnfc = out.trim()
        expect(tnfc).to_equal("4")

    it "handles multiple spaces between fields":
        step("Verify: handles multiple spaces between fields")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("{ print $2 }", "x   y   z")
        val tsp = out.trim()
        expect(tsp).to_equal("y")

    it "handles leading and trailing whitespace":
        step("Verify: handles leading and trailing whitespace")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("{ print $1 }", "  foo  ")
        val tws = out.trim()
        expect(tws).to_equal("foo")


# ============================================================================
# Test Group 2: NR — record number
# ============================================================================

describe "awk NR record counter":
    """
    ## Record Number (NR)

    NR is incremented for each input record (line). It starts at 1.
    Printing NR alongside $0 annotates each line.
    """

    it "NR is 1 for the first record":
        step("Verify: NR is 1 for the first record")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("NR==1 { print NR }", "first\nsecond\nthird")
        val tnr1 = out.trim()
        expect(tnr1).to_equal("1")

    it "NR is 2 for the second record":
        step("Verify: NR is 2 for the second record")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("NR==2 { print NR }", "first\nsecond\nthird")
        val tnr2 = out.trim()
        expect(tnr2).to_equal("2")

    it "prints NR and $0 for all records":
        step("Verify: prints NR and $0 for all records")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("{ print NR, $0 }", "a\nb")
        val trimmed = out.trim()
        val lines = trimmed.split("\n")
        val lines_len = lines.len()
        expect(lines_len).to_equal(2)  # oracle: value fixed by the spec contract
        val line0 = lines[0]
        val line1 = lines[1]
        val starts1 = line0.starts_with("1")
        val starts2 = line1.starts_with("2")
        expect(starts1).to_equal(true)
        expect(starts2).to_equal(true)


# ============================================================================
# Test Group 3: BEGIN and END blocks
# ============================================================================

describe "awk BEGIN and END blocks":
    """
    ## BEGIN and END

    BEGIN runs before any input is processed; END runs after all input.
    They are useful for headers, footers, and accumulation.
    """

    it "BEGIN block executes before input":
        step("Verify: BEGIN block executes before input")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("BEGIN { print \"start\" } { print $0 }", "line")
        val trimmed_begin = out.trim()
        val lines_begin = trimmed_begin.split("\n")
        expect(lines_begin[0]).to_equal("start")
        expect(lines_begin[1]).to_equal("line")

    it "END block executes after all input":
        step("Verify: END block executes after all input")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("{ print $0 } END { print \"done\" }", "line")
        val trimmed_end = out.trim()
        val lines_end = trimmed_end.split("\n")
        val last_idx = lines_end.len() - 1
        expect(lines_end[last_idx]).to_equal("done")

    it "BEGIN and END can run without any input records":
        step("Verify: BEGIN and END can run without any input records")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("BEGIN { print \"hi\" } END { print \"bye\" }", "")
        val trimmed_be = out.trim()
        val lines_be = trimmed_be.split("\n")
        expect(lines_be[0]).to_equal("hi")
        expect(lines_be[1]).to_equal("bye")

    it "END sees correct NR after processing all records":
        step("Verify: END sees correct NR after processing all records")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("END { print NR }", "a\nb\nc")
        expect(out.trim()).to_equal("3")


# ============================================================================
# Test Group 4: Pattern/action filtering
# ============================================================================

describe "awk pattern/action pairs":
    """
    ## Pattern Filtering

    A pattern before { action } causes the action to run only on matching records.
    String equality patterns and /regex/ patterns must both be supported.
    """

    it "string pattern selects matching records":
        step("Verify: string pattern selects matching records")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("/ERROR/ { print $0 }", "INFO ok\nERROR bad\nINFO ok2")
        val tpat = out.trim()
        expect(tpat).to_equal("ERROR bad")

    it "pattern can negate with ! operator":
        step("Verify: pattern can negate with ! operator")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("!/INFO/ { print $0 }", "INFO ok\nERROR bad")
        val tneg = out.trim()
        expect(tneg).to_equal("ERROR bad")

    it "NR-based pattern selects specific lines":
        step("Verify: NR-based pattern selects specific lines")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("NR==2 { print $0 }", "line1\nline2\nline3")
        val tnrpat = out.trim()
        expect(tnrpat).to_equal("line2")

    it "multiple pattern/action pairs apply independently":
        step("Verify: multiple pattern/action pairs apply independently")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("/A/ { print \"matched-A\" } /B/ { print \"matched-B\" }", "A\nB\nC")
        val trimmed_multi = out.trim()
        val lines_multi = trimmed_multi.split("\n")
        val lines_multi_len = lines_multi.len()
        expect(lines_multi_len).to_equal(2)  # oracle: value fixed by the spec contract
        expect(lines_multi[0]).to_equal("matched-A")
        expect(lines_multi[1]).to_equal("matched-B")


# ============================================================================
# Test Group 5: print and printf
# ============================================================================

describe "awk print and printf":
    """
    ## Output Actions

    print emits fields separated by OFS (default space) with a trailing newline.
    printf uses a format string like C printf without an automatic newline.
    """

    it "print with comma joins fields with space":
        step("Verify: print with comma joins fields with space")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("{ print $1, $2 }", "foo bar")
        val tcomma = out.trim()
        expect(tcomma).to_equal("foo bar")

    it "print with no args prints $0":
        step("Verify: print with no args prints $0")
        # @req: REQ-OS-Awk-001
        val lb = "{"
        val rb = "}"
        val prog_bare = "{lb} print {rb}"
        val out = _run_awk(prog_bare, "whole line here")
        val tprint = out.trim()
        expect(tprint).to_equal("whole line here")

    it "printf formats a string without trailing newline":
        step("Verify: printf formats a string without trailing newline")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("{ printf \"%s:%s\", $1, $2 }", "key value")
        expect(out).to_equal("key:value")

    it "printf %d formats an integer":
        step("Verify: printf %d formats an integer")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("{ printf \"%d\", NR }", "x")
        expect(out).to_equal("1")


# ============================================================================
# Test Group 6: Multi-record accumulation
# ============================================================================

describe "awk multi-record accumulation":
    """
    ## Accumulation Patterns

    Common awk idiom: sum a numeric column, count matching records, etc.
    """

    it "sums a numeric column across all records":
        step("Verify: sums a numeric column across all records")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("{ sum += $1 } END { print sum }", "10\n20\n30")
        val tsum = out.trim()
        expect(tsum).to_equal("60")

    it "counts records matching a pattern":
        step("Verify: counts records matching a pattern")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("/yes/ { n++ } END { print n }", "yes\nno\nyes\nno\nyes")
        val tcnt = out.trim()
        expect(tcnt).to_equal("3")

    it "prints running total with NR":
        step("Verify: prints running total with NR")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("{ sum += $1; print NR, sum }", "5\n3")
        val trimmed_run = out.trim()
        val lines_run = trimmed_run.split("\n")
        expect(lines_run[0]).to_equal("1 5")
        expect(lines_run[1]).to_equal("2 8")


# ============================================================================
# Test Group 7: Exit codes and error handling
# ============================================================================

describe "awk exit codes":
    """
    ## Exit Codes

    tool_awk returns 0 on success. A syntactically invalid program must return
    a nonzero exit code without panicking.
    """

    it "returns 0 for a valid program with input":
        step("Verify: returns 0 for a valid program with input")
        # @req: REQ-OS-Awk-001
        val code = _run_awk_exit("{ print $1 }", "hello")
        expect(code).to_equal(0)  # oracle: value fixed by the spec contract

    it "returns 0 for a valid program with no input":
        step("Verify: returns 0 for a valid program with no input")
        # @req: REQ-OS-Awk-001
        val code = _run_awk_exit("BEGIN { print \"ok\" }", "")
        expect(code).to_equal(0)  # oracle: value fixed by the spec contract

    it "returns nonzero for an unparseable program":
        step("Verify: returns nonzero for an unparseable program")
        # @req: REQ-OS-Awk-001
        val code = _run_awk_exit("{ INVALID SYNTAX !!! }", "x")
        expect(code).to_be_greater_than(0)


# ============================================================================
# Test Group 8: Action state threading (_exec_action arity + tuple return)
# ============================================================================

describe "awk action state threading":
    """
    ## Action State Threading

    `_exec_action` takes the awk variable environment as its 8th parameter and
    returns `(ctrl, vars)`. Every call site must pass the environment in and
    bind both halves of the tuple back out:

    - `.0` is the control code — 1 means the action ran `next`, 2 means the
      action was not a supported statement.
    - `.1` is the updated environment, which must be fed to the next action so
      accumulations survive across records and reach END.

    These examples pin that contract. Passing 7 arguments instead of 8 leaves
    `vars` as the nil sentinel; binding the `(i32, [(text, text)])` return as a
    bare `i32` makes every `ctrl` comparison compare against a tuple.
    """

    it "BEGIN block assignment is visible in END":
        step("Verify: BEGIN block assignment is visible in END")
        # @req: REQ-OS-Awk-001
        val lb = "{"
        val rb = "}"
        val prog = "BEGIN {lb} t = 5 {rb} END {lb} print t {rb}"
        val out = _run_awk(prog, "")
        expect(out.trim()).to_equal("5")

    it "variable assigned on one record is visible on the next":
        step("Verify: variable assigned on one record is visible on the next")
        # @req: REQ-OS-Awk-001
        val out = _run_awk("{ sum += $1; print sum }", "5\n3\n2")
        val lines_thread = out.trim().split("\n")
        expect(lines_thread[0]).to_equal("5")
        expect(lines_thread[1]).to_equal("8")
        expect(lines_thread[2]).to_equal("10")

    it "counter accumulated across records reaches END":
        step("Verify: counter accumulated across records reaches END")
        # @req: REQ-OS-Awk-001
        val lb2 = "{"
        val rb2 = "}"
        val prog_n = "{lb2} n++ {rb2} END {lb2} print n {rb2}"
        val out = _run_awk(prog_n, "x\ny\nz")
        expect(out.trim()).to_equal("3")

    it "next stops later rules for the same record":
        step("Verify: next stops later rules for the same record")
        # @req: REQ-OS-Awk-001
        val lb3 = "{"
        val rb3 = "}"
        val q3 = "\""
        val prog_next = "/A/ {lb3} next {rb3} /A/ {lb3} print {q3}second-ran{q3} {rb3}"
        val out = _run_awk(prog_next, "A")
        expect(out.trim()).to_equal("")

    it "without next both rules run on the same record":
        step("Verify: without next both rules run on the same record")
        # @req: REQ-OS-Awk-001
        val lb4 = "{"
        val rb4 = "}"
        val q4 = "\""
        val prog_ctl = "/A/ {lb4} print {q4}first{q4} {rb4} /A/ {lb4} print {q4}second-ran{q4} {rb4}"
        val out = _run_awk(prog_ctl, "A")
        val lines_ctl = out.trim().split("\n")
        expect(lines_ctl.len()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(lines_ctl[0]).to_equal("first")
        expect(lines_ctl[1]).to_equal("second-ran")

    it "next on an earlier record does not leak into a later record":
        step("Verify: next on an earlier record does not leak into a later record")
        # @req: REQ-OS-Awk-001
        val lb5 = "{"
        val rb5 = "}"
        val q5 = "\""
        val prog_leak = "/skip/ {lb5} next {rb5} {lb5} print {q5}saw{q5} {rb5}"
        val out = _run_awk(prog_leak, "skip\nkeep")
        expect(out.trim()).to_equal("saw")

    it "an unsupported statement is reported as a nonzero exit":
        step("Verify: an unsupported statement is reported as a nonzero exit")
        # @req: REQ-OS-Awk-001
        val code = _run_awk_exit("{ TOTALLY BOGUS }", "x")
        expect(code).to_equal(1)  # oracle: value fixed by the spec contract
