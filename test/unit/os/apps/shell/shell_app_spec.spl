"""
## Purpose and audience
Behavioral specification for shell app.
Audience: compiler/runtime developers and spec maintainers who need
to verify this component's observable behavior and pinned values.
"""
# @req: REQ-TEST-SHELL_SHELL_APP-001
# Shell Application Unit Tests
#
# Tests for ShellApp: construction, command parsing, environment variables,
# history tracking, and built-in commands.

use os.tools.tool_registry.{ToolRegistry, ToolEntry}

fn _fake_registry_tool(args: [text]) -> i32:
    41

# ============================================================================
# ShellApp Construction
# ============================================================================

use std.spec.step
describe "ShellApp":
    context "when newly created":
        it "starts with cwd at root":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: starts with cwd at root")
            val shell = ShellApp.new()
            expect(shell.cwd).to_equal("/")

        it "starts with empty history":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: starts with empty history")
            val shell = ShellApp.new()
            expect(shell.history.len()).to_equal(0)  # oracle: expected value pinned by spec

        it "starts with history_pos at -1":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: starts with history_pos at -1")
            val shell = ShellApp.new()
            expect(shell.history_pos).to_equal(-1)  # oracle: expected value pinned by spec

        it "starts in running state":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: starts in running state")
            val shell = ShellApp.new()
            expect(shell.running).to_equal(true)

        it "starts with exit code 0":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: starts with exit code 0")
            val shell = ShellApp.new()
            expect(shell.last_exit_code).to_equal(0)  # oracle: expected value pinned by spec

        it "has a default prompt":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: has a default prompt")
            val shell = ShellApp.new()
            expect(shell.prompt).to_equal("$ ")

        it "has empty output_lines":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: has empty output_lines")
            val shell = ShellApp.new()
            expect(shell.output_lines.len()).to_equal(0)  # oracle: expected value pinned by spec

        it "has nil vfs by default":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: has nil vfs by default")
            val shell = ShellApp.new()
            expect(shell.vfs).to_be_nil

    context "environment variables":
        it "has HOME set to /":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: has HOME set to /")
            val shell = ShellApp.new()
            val env = shell.env
            # env is a list of (text, text) tuples
            expect(env.len()).to_be_greater_than(0)

        it "has at least 3 default environment variables":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: has at least 3 default environment variables")
            val shell = ShellApp.new()
            # HOME, PATH, SHELL
            expect(shell.env.len()).to_equal(3)  # oracle: expected value pinned by spec

    context "terminal":
        it "has a terminal attached":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: has a terminal attached")
            val shell = ShellApp.new()
            expect(shell.terminal.cols).to_equal(80)  # oracle: expected value pinned by spec
            expect(shell.terminal.rows).to_equal(24)  # oracle: expected value pinned by spec

# ============================================================================
# Command Parsing — _tokenize
# ============================================================================

describe "ShellApp command parsing":
    context "simple commands":
        it "splits simple command into tokens":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: splits simple command into tokens")
            var shell = ShellApp.new()
            val tokens = shell._tokenize("ls -la /home")
            expect(tokens.len()).to_equal(3)  # oracle: expected value pinned by spec
            expect(tokens[0]).to_equal("ls")
            expect(tokens[1]).to_equal("-la")
            expect(tokens[2]).to_equal("/home")

        it "handles single word command":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: handles single word command")
            var shell = ShellApp.new()
            val tokens = shell._tokenize("pwd")
            expect(tokens.len()).to_equal(1)  # oracle: expected value pinned by spec
            expect(tokens[0]).to_equal("pwd")

        it "handles empty input":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: handles empty input")
            var shell = ShellApp.new()
            val tokens = shell._tokenize("")
            expect(tokens.len()).to_equal(0)  # oracle: expected value pinned by spec

        it "handles extra whitespace":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: handles extra whitespace")
            var shell = ShellApp.new()
            val tokens = shell._tokenize("  ls   -la   ")
            expect(tokens.len()).to_equal(2)  # oracle: expected value pinned by spec
            expect(tokens[0]).to_equal("ls")
            expect(tokens[1]).to_equal("-la")

    context "quoted arguments":
        it "handles double-quoted string":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: handles double-quoted string")
            var shell = ShellApp.new()
            val tokens = shell._tokenize("echo \"hello world\"")
            expect(tokens.len()).to_equal(2)  # oracle: expected value pinned by spec
            expect(tokens[0]).to_equal("echo")
            expect(tokens[1]).to_equal("hello world")

        it "handles single-quoted string":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: handles single-quoted string")
            var shell = ShellApp.new()
            val tokens = shell._tokenize("echo 'hello world'")
            expect(tokens.len()).to_equal(2)  # oracle: expected value pinned by spec
            expect(tokens[0]).to_equal("echo")
            expect(tokens[1]).to_equal("hello world")

        it "handles escaped characters":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: handles escaped characters")
            var shell = ShellApp.new()
            val tokens = shell._tokenize("echo hello\\ world")
            expect(tokens.len()).to_equal(2)  # oracle: expected value pinned by spec
            expect(tokens[0]).to_equal("echo")
            expect(tokens[1]).to_equal("hello world")

    context "multiple arguments":
        it "parses command with flag and path":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: parses command with flag and path")
            var shell = ShellApp.new()
            val tokens = shell._tokenize("cat -n /etc/passwd")
            expect(tokens.len()).to_equal(3)  # oracle: expected value pinned by spec
            expect(tokens[0]).to_equal("cat")
            expect(tokens[1]).to_equal("-n")
            expect(tokens[2]).to_equal("/etc/passwd")

        it "parses command with many args":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: parses command with many args")
            var shell = ShellApp.new()
            val tokens = shell._tokenize("cp -r src/ dst/")
            expect(tokens.len()).to_equal(3)  # oracle: expected value pinned by spec

# ============================================================================
# History Tracking
# ============================================================================

describe "ShellApp history":
    it "starts empty":
        # @req: REQ-TEST-SHELL_SHELL_APP-001
        step("Verify: starts empty")
        val shell = ShellApp.new()
        expect(shell.history.len()).to_equal(0)  # oracle: expected value pinned by spec

    it "records executed command":
        # @req: REQ-TEST-SHELL_SHELL_APP-001
        step("Verify: records executed command")
        var shell = ShellApp.new()
        shell._execute_line("help")
        expect(shell.history.len()).to_equal(1)  # oracle: expected value pinned by spec
        expect(shell.history[0]).to_equal("help")

    it "records multiple commands":
        # @req: REQ-TEST-SHELL_SHELL_APP-001
        step("Verify: records multiple commands")
        var shell = ShellApp.new()
        shell._execute_line("help")
        shell._execute_line("pwd")
        expect(shell.history.len()).to_equal(2)  # oracle: expected value pinned by spec

    it "does not record empty input":
        # @req: REQ-TEST-SHELL_SHELL_APP-001
        step("Verify: does not record empty input")
        var shell = ShellApp.new()
        shell._execute_line("")
        expect(shell.history.len()).to_equal(0)  # oracle: expected value pinned by spec

# ============================================================================
# Built-in Commands
# ============================================================================

describe "ShellApp built-in commands":
    context "help command":
        it "executes without error":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: executes without error")
            var shell = ShellApp.new()
            shell._execute_line("help")
            expect(shell.last_exit_code).to_equal(0)  # oracle: expected value pinned by spec

        it "lists kernel MVP commands":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: lists kernel MVP commands")
            var shell = ShellApp.new()
            shell._execute_line("help")
            var seen_run = false
            var seen_mem = false
            var seen_reboot = false
            for line in shell.output_lines:
                if line.contains("run CMD"):
                    seen_run = true
                if line.contains("mem"):
                    seen_mem = true
                if line.contains("reboot"):
                    seen_reboot = true
            expect(seen_run).to_equal(true)
            expect(seen_mem).to_equal(true)
            expect(seen_reboot).to_equal(true)

    context "pwd command":
        it "shows current directory":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: shows current directory")
            var shell = ShellApp.new()
            shell._execute_line("pwd")
            expect(shell.last_exit_code).to_equal(0)  # oracle: expected value pinned by spec

    context "exit command":
        it "sets running to false":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: sets running to false")
            var shell = ShellApp.new()
            shell._execute_line("exit")
            expect(shell.running).to_equal(false)

    context "cd command":
        it "changes cwd":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: changes cwd")
            var shell = ShellApp.new()
            shell._execute_line("cd /home")
            expect(shell.cwd).to_equal("/home")

        it "cd / goes to root":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: cd / goes to root")
            var shell = ShellApp.new()
            shell._execute_line("cd /home")
            shell._execute_line("cd /")
            expect(shell.cwd).to_equal("/")

    context "echo command":
        it "produces output":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: produces output")
            var shell = ShellApp.new()
            shell._execute_line("echo hello")
            expect(shell.last_exit_code).to_equal(0)  # oracle: expected value pinned by spec

    context "env command":
        it "lists environment variables":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: lists environment variables")
            var shell = ShellApp.new()
            shell._execute_line("env")
            expect(shell.last_exit_code).to_equal(0)  # oracle: expected value pinned by spec

    context "export command":
        it "sets environment variable":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: sets environment variable")
            var shell = ShellApp.new()
            shell._execute_line("export FOO=bar")
            # Verify env grew
            expect(shell.env.len()).to_be_greater_than(3)

    context "run command":
        it "is treated as a built-in":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: is treated as a built-in")
            var shell = ShellApp.new()
            expect(shell._is_builtin_command("run")).to_equal(true)

        it "prints usage for --help":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: prints usage for --help")
            var shell = ShellApp.new()
            shell._execute_line("run --help")
            expect(shell.last_exit_code).to_equal(0)  # oracle: expected value pinned by spec

    context "mem command":
        it "is treated as a built-in":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: is treated as a built-in")
            var shell = ShellApp.new()
            expect(shell._is_builtin_command("mem")).to_equal(true)

        it "prints usage for --help":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: prints usage for --help")
            var shell = ShellApp.new()
            shell._execute_line("mem --help")
            expect(shell.last_exit_code).to_equal(0)  # oracle: expected value pinned by spec

    context "reboot command":
        it "is treated as a built-in":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: is treated as a built-in")
            var shell = ShellApp.new()
            expect(shell._is_builtin_command("reboot")).to_equal(true)

        it "prints a validation error when invoked":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: prints a validation error when invoked")
            var shell = ShellApp.new()
            shell._execute_line("reboot")
            expect(shell.last_exit_code).to_equal(1)  # oracle: expected value pinned by spec

    context "bootstrap tool commands":
        it "treats uname as a built-in":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: treats uname as a built-in")
            var shell = ShellApp.new()
            expect(shell._is_builtin_command("uname")).to_be(true)

        it "routes cmake through the external launcher":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: routes cmake through the external launcher")
            var shell = ShellApp.new()
            expect(shell._is_builtin_command("cmake")).to_be(false)

        it "routes ninja through the external launcher":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: routes ninja through the external launcher")
            var shell = ShellApp.new()
            expect(shell._is_builtin_command("ninja")).to_be(false)

        it "does not treat checksum artifacts as built-ins":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: does not treat checksum artifacts as built-ins")
            var shell = ShellApp.new()
            expect(shell._is_builtin_command("sha256sum")).to_be(false)
            expect(shell._is_builtin_command("md5sum")).to_be(false)

        it "routes grep through its filesystem artifact gate":
            # @req: REQ-TEST-SHELL_SHELL_APP-001
            step("Verify: routes grep through its filesystem artifact gate")
            var shell = ShellApp.new()
            expect(shell._is_builtin_command("grep")).to_be(false)

describe "ShellApp external command routing":
    it "blocks a direct checksum alias at its canonical launcher gate":
        # @req: REQ-TEST-SHELL_SHELL_APP-001
        step("Verify: blocks a direct checksum alias at its canonical launcher gate")
        var shell = ShellApp.new()
        shell.aliases = shell.aliases.push(("digest", "sha256sum"))
        shell.take_remote_output()

        shell.execute("digest --version")
        val output = shell.take_remote_output()

        expect(shell.last_exit_code).to_equal(126)  # oracle: expected value pinned by spec
        expect(output).to_contain("CHECKSUM_TOOL_TARGET_ARTIFACT_TOKEN_UNAVAILABLE")
        expect(output).to_contain("path=/usr/bin/sha256sum")

    it "blocks a background checksum alias before spawning":
        # @req: REQ-TEST-SHELL_SHELL_APP-001
        step("Verify: blocks a background checksum alias before spawning")
        var shell = ShellApp.new()
        shell.aliases = shell.aliases.push(("legacy-digest", "md5sum"))
        shell.take_remote_output()

        shell.execute("legacy-digest --help &")
        val output = shell.take_remote_output()

        expect(shell.last_exit_code).to_equal(126)  # oracle: expected value pinned by spec
        expect(output).to_contain("path=/usr/bin/md5sum")
        expect(shell.jobs.count()).to_equal(0)  # oracle: expected value pinned by spec

    it "blocks checksum aliases in pipeline stages before any spawn":
        # @req: REQ-TEST-SHELL_SHELL_APP-001
        step("Verify: blocks checksum aliases in pipeline stages before any spawn")
        var shell = ShellApp.new()
        shell.aliases = shell.aliases.push(("digest", "sha256sum"))
        shell.take_remote_output()

        shell.execute("echo payload | digest --version")
        val final_stage_output = shell.take_remote_output()

        expect(shell.last_exit_code).to_equal(126)  # oracle: expected value pinned by spec
        expect(final_stage_output).to_contain("CHECKSUM_TOOL_TARGET_ARTIFACT_TOKEN_UNAVAILABLE")
        expect(final_stage_output).to_contain("path=/usr/bin/sha256sum")

        shell.execute("digest --version | echo unreachable")
        val first_stage_output = shell.take_remote_output()

        expect(shell.last_exit_code).to_equal(126)  # oracle: expected value pinned by spec
        expect(first_stage_output).to_contain("path=/usr/bin/sha256sum")

    it "does not execute registry callbacks for non-builtins":
        # @req: REQ-TEST-SHELL_SHELL_APP-001
        step("Verify: does not execute registry callbacks for non-builtins")
        var shell = ShellApp.new()
        var registry = ToolRegistry.new()
        registry.register(ToolEntry(
            name: "fake_external",
            description: "test-only external command",
            category: "test",
            run_fn: _fake_registry_tool,
            capabilities: []
        ))
        shell.tool_registry = registry

        shell._execute_line("fake_external")

        expect(shell.last_exit_code).to_equal(127)  # oracle: expected value pinned by spec

    it "still rejects backgrounded built-ins":
        # @req: REQ-TEST-SHELL_SHELL_APP-001
        step("Verify: still rejects backgrounded built-ins")
        var shell = ShellApp.new()

        shell._execute_line("pwd &")

        expect(shell.last_exit_code).to_equal(1)  # oracle: expected value pinned by spec
