"""
## Purpose and audience
Purpose: Prove that smux api.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-OS-APPS-001 — stable requirement identity for this spec.

use std.spec
use os.apps.smux.api.{
    smux_reset_for_test,
    smux_is_deferred_feature,
    smux_metrics,
    smux_create_session,
    smux_list_windows,
    smux_list_panes,
    smux_split_pane,
    smux_capture,
    smux_attach,
    smux_detach,
    smux_resize
}

describe "smux api":
    it "creates a session with an initial pane":
        step("Verify: creates a session with an initial pane")
        # @req: REQ-OS-APPS-001
        smux_reset_for_test()
        val session = smux_create_session("dev")
        val windows = smux_list_windows(session.id)
        val panes = smux_list_panes(session.id, windows[0].id)

        expect(windows.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(panes.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "splits a pane and captures buffered output":
        step("Verify: splits a pane and captures buffered output")
        smux_reset_for_test()
        val session = smux_create_session("split")
        val window = smux_list_windows(session.id)[0]
        val pane = smux_list_panes(session.id, window.id)[0]

        expect(smux_split_pane(session.id, window.id, pane.id, "vertical").is_ok()).to_equal(true)
        val panes = smux_list_panes(session.id, window.id)
        expect(panes.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

        val capture = smux_capture(session.id, window.id, panes[0].id, 20)
        expect(capture.rows).to_be_greater_than(0)

    it "tracks attach and detach":
        step("Verify: tracks attach and detach")
        smux_reset_for_test()
        val session = smux_create_session("attach")
        expect(smux_attach(session.id, "client-a", 100, 30).attached).to_equal(true)
        expect(smux_detach("client-a")).to_equal(true)

    it "records observable metrics and applies resize":
        step("Verify: records observable metrics and applies resize")
        smux_reset_for_test()
        val session = smux_create_session("metrics")
        val window = smux_list_windows(session.id)[0]
        val pane = smux_list_panes(session.id, window.id)[0]

        expect(smux_resize(session.id, window.id, pane.id, 120, 40).is_ok()).to_equal(true)
        expect(smux_capture(session.id, window.id, pane.id, 20).rows).to_be_greater_than(0)

        val metrics = smux_metrics()
        expect(metrics.startup_count).to_be_greater_than(0)
        expect(metrics.resize_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(metrics.capture_count).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "exposes deferred parity features explicitly":
        step("Verify: exposes deferred parity features explicitly")
        expect(smux_is_deferred_feature("copy-mode")).to_equal(true)
        expect(smux_is_deferred_feature("mouse")).to_equal(true)
        expect(smux_is_deferred_feature("split-pane")).to_equal(false)
