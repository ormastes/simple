use os.apps.smux.api.{smux_reset_for_test, smux_create_session, smux_list_sessions, smux_attach, smux_detach}

describe "smux service capacity and client compaction":
    it "holds all eight session slots, not just four":
        smux_reset_for_test()
        var i = 0
        while i < 8:
            val _s = smux_create_session("s" + i.to_text())
            i = i + 1
        expect(smux_list_sessions().len()).to_equal(8)

    it "still finds later clients after an earlier client detaches":
        smux_reset_for_test()
        val s = smux_create_session("main")
        val _a = smux_attach(s.id, "client-a", 80, 24)
        val _b = smux_attach(s.id, "client-b", 80, 24)
        val _c = smux_attach(s.id, "client-c", 80, 24)
        assert_true(smux_detach("client-a"))
        # Before compaction, removing slot 0 orphaned every later client.
        assert_true(smux_detach("client-b"))
        assert_true(smux_detach("client-c"))
