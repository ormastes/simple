use std.spec
use std.spec.step
use os.apps.terminal.terminal.{TerminalChar, TerminalLine, Terminal, AnsiState, default_char, new_line}
# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/os/apps/terminal/terminal_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/terminal_spec.md
# doc-path: doc/03_plan/sys_test/terminal_spec.md
# doc-path: doc/04_architecture/terminal_spec.md
# doc-path: doc/05_design/terminal_spec_oracles.md
# @manual: primary


# ============================================================================
# TerminalChar Construction
# ============================================================================

describe "TerminalChar":
    """
    # Terminal Emulator Unit Tests
    Tests for TerminalChar, TerminalLine, and Terminal class:
    construction, write_char, newline, scroll_up, clear, ANSI parsing.

    This describe block exercises the TerminalChar value type that
    holds a single screen cell (char + fg/bg color + bold flag).
    """
    it "constructs with default values":
        step("Verify: constructs with default values")
        # @req: REQ-SSPEC-LOCAL-001
        """TerminalChar(ch, fg, bg, bold) round-trips its fields unchanged."""
        val ch = TerminalChar(ch: " ", fg: 7, bg: 0, bold: false)
        expect(ch.ch).to_equal(" ")
        expect(ch.fg).to_equal(7)
        expect(ch.bg).to_equal(0)
        expect(ch.bold).to_equal(false)

    it "constructs with custom color":
        step("Verify: constructs with custom color")
        # @req: REQ-SSPEC-LOCAL-001
        val ch = TerminalChar(ch: "A", fg: 1, bg: 4, bold: true)
        expect(ch.ch).to_equal("A")
        expect(ch.fg).to_equal(1)
        expect(ch.bg).to_equal(4)
        expect(ch.bold).to_equal(true)

    it "default_char returns space with white-on-black":
        step("Verify: default_char returns space with white-on-black")
        # @req: REQ-SSPEC-LOCAL-001
        val ch = default_char()
        expect(ch.ch).to_equal(" ")
        expect(ch.fg).to_equal(7)
        expect(ch.bg).to_equal(0)
        expect(ch.bold).to_equal(false)

# ============================================================================
# TerminalLine Construction
# ============================================================================

describe "TerminalLine":
    it "new_line creates line with correct width":
        step("Verify: new_line creates line with correct width")
        # @req: REQ-SSPEC-LOCAL-001
        val line = new_line(80)
        expect(line.chars.len()).to_equal(80)

    it "new_line fills with blank chars":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: new_line fills with blank chars")
        val line = new_line(10)
        expect(line.chars[0].ch).to_equal(" ")
        expect(line.chars[9].ch).to_equal(" ")

    it "line_to_text renders plain text":
        step("Verify: line_to_text renders plain text")
        # @req: REQ-SSPEC-LOCAL-001
        var line = new_line(5)
        line.chars[0] = TerminalChar(ch: "H", fg: 7, bg: 0, bold: false)
        line.chars[1] = TerminalChar(ch: "i", fg: 7, bg: 0, bold: false)
        val text_out = line_to_text(line)
        expect(text_out).to_start_with("Hi")

# ============================================================================
# Terminal Construction
# ============================================================================

describe "Terminal":
    context "when newly created":
        it "has correct cols":
            step("Verify: has correct cols")
            # @req: REQ-SSPEC-LOCAL-001
            val term = Terminal.new(80, 25)
            expect(term.cols).to_equal(80)

        it "has correct rows":
            step("Verify: has correct rows")
            # @req: REQ-SSPEC-LOCAL-001
            val term = Terminal.new(80, 25)
            expect(term.rows).to_equal(25)

        it "starts with cursor at row 0":
            # @req: REQ-SSPEC-LOCAL-001
            step("Verify: starts with cursor at row 0")
            val term = Terminal.new(80, 25)
            expect(term.cursor_row).to_equal(0)

        it "starts with cursor at col 0":
            step("Verify: starts with cursor at col 0")
            # @req: REQ-SSPEC-LOCAL-001
            val term = Terminal.new(80, 25)
            expect(term.cursor_col).to_equal(0)

        it "has correct number of lines":
            step("Verify: has correct number of lines")
            # @req: REQ-SSPEC-LOCAL-001
            val term = Terminal.new(80, 25)
            expect(term.lines.len()).to_equal(25)

        it "starts with default fg color (white)":
            step("Verify: starts with default fg color (white)")
            # @req: REQ-SSPEC-LOCAL-001
            val term = Terminal.new(80, 25)
            expect(term.fg_color).to_equal(7)

        it "starts with default bg color (black)":
            # @req: REQ-SSPEC-LOCAL-001
            step("Verify: starts with default bg color (black)")
            val term = Terminal.new(80, 25)
            expect(term.bg_color).to_equal(0)

        it "starts not bold":
            # @req: REQ-SSPEC-LOCAL-001
            step("Verify: starts not bold")
            val term = Terminal.new(80, 25)
            expect(term.bold).to_equal(false)

        it "starts with empty input buffer":
            step("Verify: starts with empty input buffer")
            # @req: REQ-SSPEC-LOCAL-001
            val term = Terminal.new(80, 25)
            expect(term.input_buffer).to_equal("")

        it "starts with empty output buffer":
            step("Verify: starts with empty output buffer")
            # @req: REQ-SSPEC-LOCAL-001
            val term = Terminal.new(80, 25)
            expect(term.output_buffer).to_equal("")

        it "starts with ANSI state Normal":
            step("Verify: starts with ANSI state Normal")
            # @req: REQ-SSPEC-LOCAL-001
            val term = Terminal.new(80, 25)
            expect(term.ansi_state).to_equal(AnsiState.Normal)

        it "starts with max_scrollback of 1000":
            # @req: REQ-SSPEC-LOCAL-001
            step("Verify: starts with max_scrollback of 1000")
            val term = Terminal.new(80, 25)
            expect(term.max_scrollback).to_equal(1000)

    context "with small dimensions":
        it "creates 1x1 terminal":
            # @req: REQ-SSPEC-LOCAL-001
            step("Verify: creates 1x1 terminal")
            val term = Terminal.new(1, 1)
            expect(term.cols).to_equal(1)
            expect(term.rows).to_equal(1)
            expect(term.lines.len()).to_equal(1)

# ============================================================================
# Terminal write_char
# ============================================================================

describe "Terminal write_char":
    it "places character at cursor position":
        step("Verify: places character at cursor position")
        # @req: REQ-SSPEC-LOCAL-001
        var term = Terminal.new(80, 25)
        term.write_char("A")
        val ch = term.lines[0].chars[0]
        expect(ch.ch).to_equal("A")

    it "advances cursor column after write":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: advances cursor column after write")
        var term = Terminal.new(80, 25)
        term.write_char("A")
        expect(term.cursor_col).to_equal(1)

    it "writes multiple characters sequentially":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: writes multiple characters sequentially")
        var term = Terminal.new(80, 25)
        term.write_char("H")
        term.write_char("i")
        expect(term.cursor_col).to_equal(2)
        expect(term.lines[0].chars[0].ch).to_equal("H")
        expect(term.lines[0].chars[1].ch).to_equal("i")

    it "wraps at end of line":
        step("Verify: wraps at end of line")
        # @req: REQ-SSPEC-LOCAL-001
        var term = Terminal.new(3, 2)
        term.write_char("A")
        term.write_char("B")
        term.write_char("C")
        # After writing 3 chars in a 3-col terminal, cursor should wrap
        expect(term.cursor_row).to_be_greater_than(0)

    it "handles newline character":
        step("Verify: handles newline character")
        # @req: REQ-SSPEC-LOCAL-001
        var term = Terminal.new(80, 25)
        term.write_char("A")
        term.write_char("\n")
        expect(term.cursor_row).to_equal(1)
        expect(term.cursor_col).to_equal(0)

# ============================================================================
# Terminal newline and scroll
# ============================================================================

describe "Terminal newline":
    it "moves cursor to next row":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: moves cursor to next row")
        var term = Terminal.new(80, 25)
        term.newline()
        expect(term.cursor_row).to_equal(1)
        expect(term.cursor_col).to_equal(0)

    it "resets cursor_col to 0":
        step("Verify: resets cursor_col to 0")
        # @req: REQ-SSPEC-LOCAL-001
        var term = Terminal.new(80, 25)
        term.write_char("X")
        term.write_char("Y")
        term.newline()
        expect(term.cursor_col).to_equal(0)

    it "scrolls when at last row":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: scrolls when at last row")
        var term = Terminal.new(80, 3)
        term.cursor_row = 2
        term.newline()
        # After newline at last row, cursor stays at last row
        expect(term.cursor_row).to_equal(2)

describe "Terminal scroll_up":
    it "shifts buffer up by one line":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: shifts buffer up by one line")
        var term = Terminal.new(10, 3)
        term.lines[0].chars[0] = TerminalChar(ch: "A", fg: 7, bg: 0, bold: false)
        term.lines[1].chars[0] = TerminalChar(ch: "B", fg: 7, bg: 0, bold: false)
        term.lines[2].chars[0] = TerminalChar(ch: "C", fg: 7, bg: 0, bold: false)
        term.scroll_up()
        # Line 0 should now be what was line 1
        expect(term.lines[0].chars[0].ch).to_equal("B")
        expect(term.lines[1].chars[0].ch).to_equal("C")

    it "adds blank line at bottom after scroll":
        step("Verify: adds blank line at bottom after scroll")
        # @req: REQ-SSPEC-LOCAL-001
        var term = Terminal.new(10, 3)
        term.lines[2].chars[0] = TerminalChar(ch: "X", fg: 7, bg: 0, bold: false)
        term.scroll_up()
        # Last line should be blank
        expect(term.lines[2].chars[0].ch).to_equal(" ")

    it "preserves line count after scroll":
        step("Verify: preserves line count after scroll")
        # @req: REQ-SSPEC-LOCAL-001
        var term = Terminal.new(10, 5)
        term.scroll_up()
        expect(term.lines.len()).to_equal(5)

# ============================================================================
# Terminal clear
# ============================================================================

describe "Terminal clear":
    it "resets all lines to blank":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: resets all lines to blank")
        var term = Terminal.new(10, 3)
        term.write_char("A")
        term.write_char("B")
        term.clear()
        expect(term.lines[0].chars[0].ch).to_equal(" ")
        expect(term.lines[0].chars[1].ch).to_equal(" ")

    it "resets cursor to origin":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: resets cursor to origin")
        var term = Terminal.new(80, 25)
        term.cursor_row = 10
        term.cursor_col = 20
        term.clear()
        expect(term.cursor_row).to_equal(0)
        expect(term.cursor_col).to_equal(0)

    it "preserves number of lines":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: preserves number of lines")
        var term = Terminal.new(80, 25)
        term.clear()
        expect(term.lines.len()).to_equal(25)

# ============================================================================
# ANSI Escape State Machine
# ============================================================================

describe "Terminal ANSI parsing":
    it "starts in Normal state":
        step("Verify: starts in Normal state")
        # @req: REQ-SSPEC-LOCAL-001
        val term = Terminal.new(80, 25)
        expect(term.ansi_state).to_equal(AnsiState.Normal)

    it "AnsiState enum has Normal variant":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: AnsiState enum has Normal variant")
        val state = AnsiState.Normal
        expect(state).to_equal(AnsiState.Normal)

    it "AnsiState enum has Escape variant":
        step("Verify: AnsiState enum has Escape variant")
        # @req: REQ-SSPEC-LOCAL-001
        val state = AnsiState.Escape
        expect(state).to_equal(AnsiState.Escape)

    it "AnsiState enum has Bracket variant":
        step("Verify: AnsiState enum has Bracket variant")
        # @req: REQ-SSPEC-LOCAL-001
        val state = AnsiState.Bracket
        expect(state).to_equal(AnsiState.Bracket)

    it "AnsiState enum has Param variant":
        step("Verify: AnsiState enum has Param variant")
        # @req: REQ-SSPEC-LOCAL-001
        val state = AnsiState.Param
        expect(state).to_equal(AnsiState.Param)

# ============================================================================
# Terminal write_string (integration)
# ============================================================================

describe "Terminal write_string":
    it "writes multiple characters":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: writes multiple characters")
        var term = Terminal.new(80, 25)
        term.write_string("Hello")
        expect(term.cursor_col).to_equal(5)
        expect(term.lines[0].chars[0].ch).to_equal("H")
        expect(term.lines[0].chars[4].ch).to_equal("o")

    it "handles embedded newlines":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: handles embedded newlines")
        var term = Terminal.new(80, 25)
        term.write_string("AB\nCD")
        expect(term.lines[0].chars[0].ch).to_equal("A")
        expect(term.lines[0].chars[1].ch).to_equal("B")
        expect(term.lines[1].chars[0].ch).to_equal("C")
        expect(term.lines[1].chars[1].ch).to_equal("D")
