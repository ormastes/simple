describe "FileManager format helpers":
    it "format_size returns bytes for small sizes":
        # @req: REQ-UNIT-OS-040
        step("Verify: format_size returns bytes for small sizes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = format_size(512)
        expect(result).to_contain("B")

    it "format_size returns KB for kilobyte sizes":
        # @req: REQ-UNIT-OS-041
        step("Verify: format_size returns KB for kilobyte sizes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = format_size(2048)
        expect(result).to_contain("KB")

    it "format_size returns MB for megabyte sizes":
        # @req: REQ-UNIT-OS-042
        step("Verify: format_size returns MB for megabyte sizes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = format_size(2097152)
        expect(result).to_contain("MB")

    it "format_kind returns File for file":
        # @req: REQ-UNIT-OS-043
        step("Verify: format_kind returns File for file")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = format_kind(FsNodeKind.File)
        expect(result).to_equal("File")

    it "format_kind returns Dir for directory":
        # @req: REQ-UNIT-OS-044
        step("Verify: format_kind returns Dir for directory")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = format_kind(FsNodeKind.Directory)
        expect(result).to_equal("Dir")

    it "kind_icon returns folder for directory":
        # @req: REQ-UNIT-OS-045
        step("Verify: kind_icon returns folder for directory")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val result = kind_icon(FsNodeKind.Directory)
        expect(result).to_equal("folder")

describe "FileManager open path helpers":
    it "_resolve_open_path keeps current directory for dot entries":
        # @req: REQ-UNIT-OS-046
        step("Verify: _resolve_open_path keeps current directory for dot entries")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(_resolve_open_path("/home/user", ".")).to_equal("/home/user")

    it "_resolve_open_path resolves parent for dot-dot entries":
        # @req: REQ-UNIT-OS-047
        step("Verify: _resolve_open_path resolves parent for dot-dot entries")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(_resolve_open_path("/home/user", "..")).to_equal("/home")

    it "_should_navigate_in_place prefers stat-resolved directories":
        # @req: REQ-UNIT-OS-048
        step("Verify: _should_navigate_in_place prefers stat-resolved directories")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var vfs = VfsManager.new()
        val fs = FileManagerOpenStatFs.new(FsNodeKind.Directory)
        val mounted = vfs.mount(path: "/", fs_type: "mock", device: "", read_only: false, fs: fs)
        expect(mounted.is_ok()).to_equal(true)
        expect(_should_navigate_in_place("docs", FsNodeKind.Symlink, "/home/docs", vfs)).to_equal(true)

    it "_should_navigate_in_place leaves regular files to the launcher":
        # @req: REQ-UNIT-OS-049
        step("Verify: _should_navigate_in_place leaves regular files to the launcher")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        expect(_should_navigate_in_place("notes.txt", FsNodeKind.File, "/home/notes.txt", nil)).to_equal(false)
