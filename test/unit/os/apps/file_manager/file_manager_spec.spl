describe "FileManager show_hidden toggle":
    it "toggle_hidden flips from false to true":
        # @req: REQ-UNIT-OS-036
        step("Verify: toggle_hidden flips from false to true")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var fm = FileManager.new("/")
        fm.toggle_hidden()
        expect(fm.show_hidden).to_equal(true)

    it "toggle_hidden flips from true to false":
        # @req: REQ-UNIT-OS-037
        step("Verify: toggle_hidden flips from true to false")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var fm = FileManager.new("/")
        fm.show_hidden = true
        fm.toggle_hidden()
        expect(fm.show_hidden).to_equal(false)

