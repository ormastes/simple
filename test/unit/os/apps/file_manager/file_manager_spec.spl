describe "FileManager selection":
    it "select_next increments selected_index":
        # @req: REQ-UNIT-OS-032
        step("Verify: select_next increments selected_index")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var fm = FileManager.new("/")
        fm.entries = [
            FileEntry(name: "a", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0),
            FileEntry(name: "b", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        ]
        fm.select_next()
        expect(fm.selected_index).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "select_next does not exceed entries length":
        # @req: REQ-UNIT-OS-033
        step("Verify: select_next does not exceed entries length")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var fm = FileManager.new("/")
        fm.entries = [
            FileEntry(name: "a", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        ]
        fm.selected_index = 0
        fm.select_next()
        expect(fm.selected_index).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "select_prev decrements selected_index":
        # @req: REQ-UNIT-OS-034
        step("Verify: select_prev decrements selected_index")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var fm = FileManager.new("/")
        fm.entries = [
            FileEntry(name: "a", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0),
            FileEntry(name: "b", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        ]
        fm.selected_index = 1
        fm.select_prev()
        expect(fm.selected_index).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "select_prev does not go below 0":
        # @req: REQ-UNIT-OS-035
        step("Verify: select_prev does not go below 0")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var fm = FileManager.new("/")
        fm.selected_index = 0
        fm.select_prev()
        expect(fm.selected_index).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

