"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/os/apps/file_manager/file_manager_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec
use os.services.vfs.vfs.{VfsManager, Filesystem, SeekWhence}
use os.kernel.types.fs_types.{FileFlags, FsNode, FsNodeKind, DirEntry}
use os.apps.file_manager.file_manager.{SortField, SortDirection, FileEntry, FileManager, format_size, format_kind, kind_icon}

# ============================================================================
# Mock Filesystem
# ============================================================================

class FileManagerOpenStatFs:
    """Mock filesystem with configurable stat results for open_selected tests."""
    stat_kind: FsNodeKind
    last_stat_path: text

impl FileManagerOpenStatFs:
    static fn new(stat_kind: FsNodeKind) -> FileManagerOpenStatFs:
        FileManagerOpenStatFs(stat_kind: stat_kind, last_stat_path: "")

impl Filesystem for FileManagerOpenStatFs:
    fn fs_name() -> text: "file-manager-open-stat"

    me mount(device: text, options: text) -> Result<bool, text>:
        Result.Ok(true)

    me unmount() -> Result<bool, text>:
        Result.Ok(true)

    me open(path: text, flags: FileFlags) -> Result<u64, text>:
        Result.Ok(0)

    me read(handle: u64, size: u64) -> Result<[u8], text>:
        Result.Ok([])

    me write(handle: u64, data: [u8]) -> Result<u64, text>:
        Result.Ok(0)

    me close(handle: u64) -> Result<bool, text>:
        Result.Ok(true)

    me seek(handle: u64, offset: i64, whence: SeekWhence) -> Result<u64, text>:
        Result.Ok(0)

    fn stat(path: text) -> Result<FsNode, text>:
        self.last_stat_path = path
        Result.Ok(FsNode(
            id: 1,
            kind: self.stat_kind,
            size: 0,
            permissions: 0o755,
            owner: 0,
            group: 0,
            created_ns: 0,
            modified_ns: 0
        ))

    fn chmod(path: text, mode: u16) -> Result<bool, text>:
        Result.Ok(true)

    me mkdir(path: text) -> Result<bool, text>:
        Result.Ok(true)

    me rmdir(path: text) -> Result<bool, text>:
        Result.Ok(true)

    fn readdir(path: text) -> Result<[DirEntry], text>:
        Result.Ok([])

    me unlink(path: text) -> Result<bool, text>:
        Result.Ok(true)

    me rename(old_path: text, new_path: text) -> Result<bool, text>:
        Result.Ok(true)

    me symlink(target: text, link_path: text) -> Result<bool, text>:
        Result.Ok(true)

# ============================================================================
# Enums
# ============================================================================

describe "SortField":
    """
    # File Manager Unit Tests
    Tests for FileManager: construction, sorting, navigation, and
    show_hidden toggle.

    This describe block exercises the SortField enum used by the file
    manager column-sort selector.
    """
    it "has Name variant":
        # @req: REQ-UNIT-OS-001
        step("Verify: has Name variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        """SortField.Name variant exists and equals itself."""
        val field = SortField.Name
        expect(field).to_equal(SortField.Name)

    it "has Size variant":
        # @req: REQ-UNIT-OS-002
        step("Verify: has Size variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val field = SortField.Size
        expect(field).to_equal(SortField.Size)

    it "has Date variant":
        # @req: REQ-UNIT-OS-003
        step("Verify: has Date variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val field = SortField.Date
        expect(field).to_equal(SortField.Date)

describe "SortDirection":
    it "has Ascending variant":
        # @req: REQ-UNIT-OS-004
        step("Verify: has Ascending variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val dir = SortDirection.Ascending
        expect(dir).to_equal(SortDirection.Ascending)

    it "has Descending variant":
        # @req: REQ-UNIT-OS-005
        step("Verify: has Descending variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val dir = SortDirection.Descending
        expect(dir).to_equal(SortDirection.Descending)

# ============================================================================
# FileEntry Construction
# ============================================================================

describe "FileEntry":
    it "constructs with name and size":
        # @req: REQ-UNIT-OS-006
        step("Verify: constructs with name and size")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val entry = FileEntry(
            name: "readme.txt",
            kind: FsNodeKind.File,
            size: 1024,
            modified_ns: 0,
            permissions: 0o644
        )
        expect(entry.name).to_equal("readme.txt")
        expect(entry.size).to_equal(1024)  # oracle: expected value 1024 is the behavior asserted by this regression spec

    it "constructs directory entry":
        # @req: REQ-UNIT-OS-007
        step("Verify: constructs directory entry")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val entry = FileEntry(
            name: "src",
            kind: FsNodeKind.Directory,
            size: 4096,
            modified_ns: 0,
            permissions: 0o755
        )
        expect(entry.name).to_equal("src")
        expect(entry.kind).to_equal(FsNodeKind.Directory)

