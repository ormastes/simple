describe "FileManager":
    context "when newly created":
        it "starts at given path":
            # @req: REQ-UNIT-OS-008
            step("Verify: starts at given path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val fm = FileManager.new("/home")
            expect(fm.current_path).to_equal("/home")

        it "starts with empty entries":
            # @req: REQ-UNIT-OS-009
            step("Verify: starts with empty entries")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val fm = FileManager.new("/")
            expect(fm.entries.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "starts with selected_index at 0":
            # @req: REQ-UNIT-OS-010
            step("Verify: starts with selected_index at 0")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val fm = FileManager.new("/")
            expect(fm.selected_index).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "starts with show_hidden false":
            # @req: REQ-UNIT-OS-011
            step("Verify: starts with show_hidden false")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val fm = FileManager.new("/")
            expect(fm.show_hidden).to_equal(false)

        it "starts with sort_by Name":
            # @req: REQ-UNIT-OS-012
            step("Verify: starts with sort_by Name")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val fm = FileManager.new("/")
            expect(fm.sort_by).to_equal(SortField.Name)

        it "starts with sort_dir Ascending":
            # @req: REQ-UNIT-OS-013
            step("Verify: starts with sort_dir Ascending")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val fm = FileManager.new("/")
            expect(fm.sort_dir).to_equal(SortDirection.Ascending)

        it "starts with dir_tree_paths containing root":
            # @req: REQ-UNIT-OS-014
            step("Verify: starts with dir_tree_paths containing root")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val fm = FileManager.new("/")
            expect(fm.dir_tree_paths.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            expect(fm.dir_tree_paths[0]).to_equal("/")

        it "starts with empty clipboard_path":
            # @req: REQ-UNIT-OS-015
            step("Verify: starts with empty clipboard_path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val fm = FileManager.new("/")
            expect(fm.clipboard_path).to_equal("")

        it "starts with empty clipboard_op":
            # @req: REQ-UNIT-OS-016
            step("Verify: starts with empty clipboard_op")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val fm = FileManager.new("/")
            expect(fm.clipboard_op).to_equal("")

        it "starts with nil vfs":
            # @req: REQ-UNIT-OS-017
            step("Verify: starts with nil vfs")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val fm = FileManager.new("/")
            expect(fm.vfs).to_be_nil

    context "with different paths":
        it "respects /home/user path":
            # @req: REQ-UNIT-OS-018
            step("Verify: respects /home/user path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val fm = FileManager.new("/home/user")
            expect(fm.current_path).to_equal("/home/user")

        it "respects root path":
            # @req: REQ-UNIT-OS-019
            step("Verify: respects root path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val fm = FileManager.new("/")
            expect(fm.current_path).to_equal("/")

# ============================================================================
# Sorting
# ============================================================================

describe "FileManager sorting":
    it "_compare_entries sorts by name ascending":
        # @req: REQ-UNIT-OS-020
        step("Verify: _compare_entries sorts by name ascending")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = FileEntry(name: "alpha", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        val b = FileEntry(name: "beta", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        val result = _compare_entries(a, b, SortField.Name, SortDirection.Ascending)
        expect(result).to_be_less_than(0)

    it "_compare_entries sorts by name descending":
        # @req: REQ-UNIT-OS-021
        step("Verify: _compare_entries sorts by name descending")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = FileEntry(name: "alpha", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        val b = FileEntry(name: "beta", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        val result = _compare_entries(a, b, SortField.Name, SortDirection.Descending)
        expect(result).to_be_greater_than(0)

    it "_compare_entries sorts by size":
        # @req: REQ-UNIT-OS-022
        step("Verify: _compare_entries sorts by size")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = FileEntry(name: "small", kind: FsNodeKind.File, size: 100, modified_ns: 0, permissions: 0)
        val b = FileEntry(name: "big", kind: FsNodeKind.File, size: 9999, modified_ns: 0, permissions: 0)
        val result = _compare_entries(a, b, SortField.Size, SortDirection.Ascending)
        expect(result).to_be_less_than(0)

    it "_compare_entries sorts by date":
        # @req: REQ-UNIT-OS-023
        step("Verify: _compare_entries sorts by date")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = FileEntry(name: "old", kind: FsNodeKind.File, size: 0, modified_ns: 100, permissions: 0)
        val b = FileEntry(name: "new", kind: FsNodeKind.File, size: 0, modified_ns: 9999, permissions: 0)
        val result = _compare_entries(a, b, SortField.Date, SortDirection.Ascending)
        expect(result).to_be_less_than(0)

    it "_sort_file_entries sorts list by name":
        # @req: REQ-UNIT-OS-024
        step("Verify: _sort_file_entries sorts list by name")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val entries = [
            FileEntry(name: "c.txt", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0),
            FileEntry(name: "a.txt", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0),
            FileEntry(name: "b.txt", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        ]
        val sorted = _sort_file_entries(entries, SortField.Name, SortDirection.Ascending)
        expect(sorted[0].name).to_equal("a.txt")
        expect(sorted[1].name).to_equal("b.txt")
        expect(sorted[2].name).to_equal("c.txt")

    it "_compare_entries returns 0 for equal names":
        # @req: REQ-UNIT-OS-025
        step("Verify: _compare_entries returns 0 for equal names")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = FileEntry(name: "same", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        val b = FileEntry(name: "same", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        val result = _compare_entries(a, b, SortField.Name, SortDirection.Ascending)
        expect(result).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

# ============================================================================
# Navigation
# ============================================================================

describe "FileManager navigation":
    it "navigate_to changes current_path":
        # @req: REQ-UNIT-OS-026
        step("Verify: navigate_to changes current_path")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var fm = FileManager.new("/")
        fm.navigate_to("/home")
        expect(fm.current_path).to_equal("/home")

    it "navigate_to resets selected_index":
        # @req: REQ-UNIT-OS-027
        step("Verify: navigate_to resets selected_index")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var fm = FileManager.new("/")
        fm.selected_index = 5
        fm.navigate_to("/home")
        expect(fm.selected_index).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "navigate_up goes to parent directory":
        # @req: REQ-UNIT-OS-028
        step("Verify: navigate_up goes to parent directory")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var fm = FileManager.new("/home/user")
        fm.navigate_up()
        expect(fm.current_path).to_equal("/home")

    it "navigate_up from root stays at root":
        # @req: REQ-UNIT-OS-029
        step("Verify: navigate_up from root stays at root")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var fm = FileManager.new("/")
        fm.navigate_up()
        expect(fm.current_path).to_equal("/")

    it "open_selected resolves parent entries in-place":
        # @req: REQ-UNIT-OS-030
        step("Verify: open_selected resolves parent entries in-place")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var fm = FileManager.new("/home/user")
        fm.entries = [
            FileEntry(name: "..", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        ]
        fm.open_selected()
        expect(fm.current_path).to_equal("/home")

    it "open_selected navigates when stat resolves a non-directory entry to a directory":
        # @req: REQ-UNIT-OS-031
        step("Verify: open_selected navigates when stat resolves a non-directory entry to a directory")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var vfs = VfsManager.new()
        val fs = FileManagerOpenStatFs.new(FsNodeKind.Directory)
        val mounted = vfs.mount(path: "/", fs_type: "mock", device: "", read_only: false, fs: fs)
        expect(mounted.is_ok()).to_equal(true)
        var fm = FileManager.with_vfs("/home", vfs)
        fm.entries = [
            FileEntry(name: "docs", kind: FsNodeKind.Symlink, size: 0, modified_ns: 0, permissions: 0)
        ]
        fm.open_selected()
        expect(fm.current_path).to_equal("/home/docs")
        expect(fs.last_stat_path).to_equal("/home/docs")

