"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/os/apps/browser_demo_launcher_lifecycle_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# SYS-GUI-004 — Browser Demo multi-window launcher lifecycle spec
#
# Exercises the launcher → shell → WM → compositor ownership join for the
# Browser Demo built-in app. Two remote windows are created under a single
# launcher pid/app_id; the spec confirms both windows group under the same
# `/sys/apps/browser_demo` identity, that grouping survives a title change,
# and that destroying one window leaves the other intact.
#
# Covers SYS-GUI-004 Multi-window app live test (serial / unit half).

use std.spec
use os.desktop.shell.{DesktopShell}
use os.compositor.compositor.{Compositor}
use os.compositor.browser_compositor_backend.{BrowserCompositorBackend}
use os.compositor.input_backend.{InputBackend, host_event_from_polled}
use common.ui.host_input_event.{HostInputEvent}
use os.drivers.input.ps2_keyboard.{KeyEvent, Key}
use os.drivers.input.ps2_mouse.{MouseEvent}
use os.services.launcher.launcher.{
    launcher_init, launcher_record_process,
    launcher_get_process_app_id_for_pid, launcher_get_process_window_count,
    launcher_get_app_launch_state, launcher_get_app_window_count,
    launcher_get_app_path, launcher_get_app_identity
}
use os.services.wm.wm_service.{WmAction}

class SilentInputBackend:
    _unused: bool

impl InputBackend for SilentInputBackend:

    me poll_event() -> HostInputEvent?:
        """The ONE trait-level ingress. Composes the inherent poll_key/poll_mouse
        pair through the shared helper, exactly as the real backends do."""
        val key_opt: KeyEvent? = self.poll_key()
        var ch = ""
        if val key_event = key_opt:
            if val Press(pressed_key) = key_event:
                if val Some(c) = self.key_to_char(pressed_key):
                    ch = c
            return host_event_from_polled(
                key_opt, nil, ch,
                self.shift_held(), self.ctrl_held(), self.alt_held()
            )
        val mouse_opt: MouseEvent? = self.poll_mouse()
        host_event_from_polled(
            nil, mouse_opt, "",
            self.shift_held(), self.ctrl_held(), self.alt_held()
        )
    me poll_key() -> KeyEvent?:
        nil

    me poll_mouse() -> MouseEvent?:
        nil

    fn alt_held() -> bool:
        false

    fn shift_held() -> bool:
        false

    fn ctrl_held() -> bool:
        false

    fn key_to_char(key: Key) -> text?:
        nil

impl SilentInputBackend:
    static fn new() -> SilentInputBackend:
        SilentInputBackend(_unused: false)

describe "Browser Demo launcher lifecycle":
    it "exposes the built-in browser_demo manifest identity":
        # @req: REQ-UNIT-OS-001
        step("Verify: exposes the built-in browser_demo manifest identity")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        launcher_init()
        expect(launcher_get_app_path(5)).to_equal("/sys/apps/browser_demo.smf")
        expect(launcher_get_app_identity(5)).to_equal("/sys/apps/browser_demo")

    it "groups two remote windows under one launcher-owned app_id":
        # @req: REQ-UNIT-OS-002
        step("Verify: groups two remote windows under one launcher-owned app_id")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        launcher_init()
        val pid: u64 = 8301
        expect(launcher_record_process(pid, 5, "running", 0, 0, true)).to_be(true)

        var shell = _make_test_shell()
        shell.apply_wm_action(_create_window_action("Browser Demo", pid, 401))
        shell.apply_wm_action(_create_window_action("Browser Demo Inspector", pid, 402))

        expect(shell.compositor.window_count()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(shell.compositor.window_count_for_process(pid)).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(shell.compositor.window_count_for_app("/sys/apps/browser_demo")).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(shell.wm.window_count_for_process(pid)).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(shell.wm.window_count_for_app("/sys/apps/browser_demo")).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(launcher_get_process_app_id_for_pid(pid)).to_equal("/sys/apps/browser_demo")
        expect(launcher_get_process_window_count(0)).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(launcher_get_app_window_count(5)).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(launcher_get_app_launch_state(5)).to_equal("running")

    it "keeps grouping stable after a title change on one window":
        # @req: REQ-UNIT-OS-003
        step("Verify: keeps grouping stable after a title change on one window")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        launcher_init()
        val pid: u64 = 8402
        expect(launcher_record_process(pid, 5, "running", 0, 0, true)).to_be(true)

        var shell = _make_test_shell()
        shell.apply_wm_action(_create_window_action("Browser Demo", pid, 411))
        shell.apply_wm_action(_create_window_action("Browser Demo Inspector", pid, 412))
        expect(shell.compositor.window_count_for_app("/sys/apps/browser_demo")).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

        val ids_before = shell.compositor.windows_for_app("/sys/apps/browser_demo")
        expect(ids_before.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        val first_wid = ids_before[0]

        shell.apply_wm_action(WmAction(
            kind: "update_title",
            window_id: first_wid,
            title: "Browser Demo — new-tab.simple",
            x: 0,
            y: 0,
            width: 0,
            height: 0,
            content: "",
            process_id: 0,
            app_id: "",
            owner_port: 0,
            src_port: 411
        ))

        expect(shell.compositor.window_count_for_app("/sys/apps/browser_demo")).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(shell.wm.window_count_for_app("/sys/apps/browser_demo")).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(shell.wm.window_owner_app_id(first_wid)).to_equal("/sys/apps/browser_demo")

    it "destroys one window without breaking the other window's ownership":
        # @req: REQ-UNIT-OS-004
        step("Verify: destroys one window without breaking the other window's ownership")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        launcher_init()
        val pid: u64 = 8503
        expect(launcher_record_process(pid, 5, "running", 0, 0, true)).to_be(true)

        var shell = _make_test_shell()
        shell.apply_wm_action(_create_window_action("Browser Demo", pid, 421))
        shell.apply_wm_action(_create_window_action("Browser Demo Inspector", pid, 422))
        val ids = shell.compositor.windows_for_app("/sys/apps/browser_demo")
        expect(ids.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

        shell.apply_wm_action(WmAction(
            kind: "destroy_window",
            window_id: ids[0],
            title: "",
            x: 0,
            y: 0,
            width: 0,
            height: 0,
            content: "",
            process_id: 0,
            app_id: "",
            owner_port: 0,
            src_port: 421
        ))

        expect(shell.compositor.window_count()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(shell.compositor.window_count_for_app("/sys/apps/browser_demo")).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(shell.wm.window_count_for_app("/sys/apps/browser_demo")).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(launcher_get_process_window_count(0)).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
        expect(launcher_get_app_window_count(5)).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    # @req REQ-WEB-BROWSER-014 REQ-WEB-BROWSER-016
    it "rejects a client destroying another client's window":
        # @req: REQ-UNIT-OS-005
        step("Verify: rejects a client destroying another client's window")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        launcher_init()
        val pid: u64 = 8504
        expect(launcher_record_process(pid, 5, "running", 0, 0, true)).to_be(true)

        var shell = _make_test_shell()
        shell.apply_wm_action(_create_window_action("Owner", pid, 431))
        shell.apply_wm_action(_create_window_action("Attacker", pid, 432))
        val ids = shell.compositor.windows_for_app("/sys/apps/browser_demo")
        expect(ids.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

        shell.apply_wm_action(WmAction(
            kind: "destroy_window",
            window_id: ids[0],
            title: "",
            x: 0,
            y: 0,
            width: 0,
            height: 0,
            content: "",
            process_id: 0,
            app_id: "",
            owner_port: 0,
            src_port: 432
        ))

        expect(shell.compositor.window_count()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(shell.compositor.window_owner_port(ids[0])).to_equal(431)  # oracle: expected value 431 is the behavior asserted by this regression spec
        expect(shell.wm.window_owner_app_id(ids[0])).to_equal("/sys/apps/browser_demo")
        expect(launcher_get_app_window_count(5)).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

fn _make_test_shell() -> DesktopShell:
    val backend = BrowserCompositorBackend.new(1024, 768)
    val input = SilentInputBackend.new()
    val compositor = Compositor.with_backends(backend, input, 1024, 768)
    var shell = DesktopShell.new(compositor)
    shell.set_task_reaper_enabled(false)
    shell

fn _create_window_action(title: text, process_id: u64, owner_port: u64) -> WmAction:
    WmAction(
        kind: "create_window",
        window_id: 0,
        title: title,
        x: 32,
        y: 48,
        width: 640,
        height: 480,
        content: "",
        process_id: process_id,
        app_id: "",
        owner_port: owner_port,
        src_port: owner_port
    )
