"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing UNIT-OS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/unit/os/apps/editor/editor_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-UNIT-OS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec
use os.apps.editor.editor.{EditorMode, TextEditor, mode_name}

# ============================================================================
# EditorMode Enum
# ============================================================================

describe "EditorMode":
    """
    # Text Editor Unit Tests
    Tests for TextEditor: construction, insert_char, delete_char, newline,
    mode transitions (Normal/Insert/Command), and cursor bounds.

    This describe block covers the EditorMode enum variants and the
    mode_name() formatter used in the status line.
    """
    it "has Normal variant":
        # @req: REQ-UNIT-OS-001
        step("Verify: has Normal variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        """EditorMode.Normal exists and equals itself."""
        val mode = EditorMode.Normal
        expect(mode).to_equal(EditorMode.Normal)

    it "has Insert variant":
        # @req: REQ-UNIT-OS-002
        step("Verify: has Insert variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mode = EditorMode.Insert
        expect(mode).to_equal(EditorMode.Insert)

    it "has Command variant":
        # @req: REQ-UNIT-OS-003
        step("Verify: has Command variant")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val mode = EditorMode.Command
        expect(mode).to_equal(EditorMode.Command)

    it "mode_name returns NORMAL":
        # @req: REQ-UNIT-OS-004
        step("Verify: mode_name returns NORMAL")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val name = mode_name(EditorMode.Normal)
        expect(name).to_equal("NORMAL")

    it "mode_name returns INSERT":
        # @req: REQ-UNIT-OS-005
        step("Verify: mode_name returns INSERT")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val name = mode_name(EditorMode.Insert)
        expect(name).to_equal("INSERT")

    it "mode_name returns COMMAND":
        # @req: REQ-UNIT-OS-006
        step("Verify: mode_name returns COMMAND")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val name = mode_name(EditorMode.Command)
        expect(name).to_equal("COMMAND")

# ============================================================================
# TextEditor Construction
# ============================================================================

describe "TextEditor":
    context "when newly created":
        it "starts with one empty line":
            # @req: REQ-UNIT-OS-007
            step("Verify: starts with one empty line")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ed = TextEditor.new()
            expect(ed.lines.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            expect(ed.lines[0]).to_equal("")

        it "starts with cursor at row 0":
            # @req: REQ-UNIT-OS-008
            step("Verify: starts with cursor at row 0")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ed = TextEditor.new()
            expect(ed.cursor_row).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "starts with cursor at col 0":
            # @req: REQ-UNIT-OS-009
            step("Verify: starts with cursor at col 0")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ed = TextEditor.new()
            expect(ed.cursor_col).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "starts with scroll_row at 0":
            # @req: REQ-UNIT-OS-010
            step("Verify: starts with scroll_row at 0")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ed = TextEditor.new()
            expect(ed.scroll_row).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "starts with no file_path":
            # @req: REQ-UNIT-OS-011
            step("Verify: starts with no file_path")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ed = TextEditor.new()
            expect(ed.file_path).to_be_nil

        it "starts not modified":
            # @req: REQ-UNIT-OS-012
            step("Verify: starts not modified")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ed = TextEditor.new()
            expect(ed.modified).to_equal(false)

        it "starts in Normal mode":
            # @req: REQ-UNIT-OS-013
            step("Verify: starts in Normal mode")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ed = TextEditor.new()
            expect(ed.mode).to_equal(EditorMode.Normal)

        it "starts with empty command_buffer":
            # @req: REQ-UNIT-OS-014
            step("Verify: starts with empty command_buffer")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ed = TextEditor.new()
            expect(ed.command_buffer).to_equal("")

        it "starts with empty yank_buffer":
            # @req: REQ-UNIT-OS-015
            step("Verify: starts with empty yank_buffer")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ed = TextEditor.new()
            expect(ed.yank_buffer.len()).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "starts with Ready status message":
            # @req: REQ-UNIT-OS-016
            step("Verify: starts with Ready status message")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ed = TextEditor.new()
            expect(ed.status_message).to_equal("Ready")

        it "has default visible_rows of 20":
            # @req: REQ-UNIT-OS-017
            step("Verify: has default visible_rows of 20")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ed = TextEditor.new()
            expect(ed.visible_rows).to_equal(20)  # oracle: expected value 20 is the behavior asserted by this regression spec

        it "has default visible_cols of 80":
            # @req: REQ-UNIT-OS-018
            step("Verify: has default visible_cols of 80")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ed = TextEditor.new()
            expect(ed.visible_cols).to_equal(80)  # oracle: expected value 80 is the behavior asserted by this regression spec

        it "has nil vfs by default":
            # @req: REQ-UNIT-OS-019
            step("Verify: has nil vfs by default")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val ed = TextEditor.new()
            expect(ed.vfs).to_be_nil

# ============================================================================
# Insert Character
# ============================================================================

describe "TextEditor insert_char":
    it "adds character at cursor position":
        # @req: REQ-UNIT-OS-020
        step("Verify: adds character at cursor position")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("A")
        expect(ed.lines[0]).to_contain("A")

    it "advances cursor after insert":
        # @req: REQ-UNIT-OS-021
        step("Verify: advances cursor after insert")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("A")
        expect(ed.cursor_col).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "inserts multiple characters sequentially":
        # @req: REQ-UNIT-OS-022
        step("Verify: inserts multiple characters sequentially")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("H")
        ed.insert_char("i")
        expect(ed.cursor_col).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(ed.lines[0]).to_start_with("Hi")

    it "marks document as modified":
        # @req: REQ-UNIT-OS-023
        step("Verify: marks document as modified")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("X")
        expect(ed.modified).to_equal(true)

    it "inserts at middle of existing text":
        # @req: REQ-UNIT-OS-024
        step("Verify: inserts at middle of existing text")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("A")
        ed.insert_char("C")
        ed.cursor_col = 1
        ed.insert_char("B")
        expect(ed.lines[0]).to_equal("ABC")

# ============================================================================
# Delete Character
# ============================================================================

describe "TextEditor delete_char":
    it "removes character at cursor":
        # @req: REQ-UNIT-OS-025
        step("Verify: removes character at cursor")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("A")
        ed.insert_char("B")
        ed.cursor_col = 0
        ed.delete_char()
        expect(ed.lines[0]).to_start_with("B")

    it "marks document as modified":
        # @req: REQ-UNIT-OS-026
        step("Verify: marks document as modified")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("X")
        ed.cursor_col = 0
        ed.delete_char()
        expect(ed.modified).to_equal(true)

describe "TextEditor delete_char_before":
    it "deletes character before cursor (backspace)":
        # @req: REQ-UNIT-OS-027
        step("Verify: deletes character before cursor (backspace)")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("A")
        ed.insert_char("B")
        ed.delete_char_before()
        expect(ed.cursor_col).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "does nothing when cursor at column 0 row 0":
        # @req: REQ-UNIT-OS-028
        step("Verify: does nothing when cursor at column 0 row 0")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.delete_char_before()
        expect(ed.cursor_col).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(ed.cursor_row).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "joins with previous line when at column 0":
        # @req: REQ-UNIT-OS-029
        step("Verify: joins with previous line when at column 0")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("A")
        ed.newline()
        ed.insert_char("B")
        ed.cursor_col = 0
        ed.delete_char_before()
        expect(ed.cursor_row).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
        expect(ed.lines.len()).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

# ============================================================================
# Newline
# ============================================================================

describe "TextEditor newline":
    it "splits line at cursor":
        # @req: REQ-UNIT-OS-030
        step("Verify: splits line at cursor")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("A")
        ed.insert_char("B")
        ed.cursor_col = 1
        ed.newline()
        expect(ed.lines.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(ed.lines[0]).to_equal("A")
        expect(ed.lines[1]).to_start_with("B")

    it "moves cursor to next row":
        # @req: REQ-UNIT-OS-031
        step("Verify: moves cursor to next row")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("X")
        ed.newline()
        expect(ed.cursor_row).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

    it "resets cursor col to 0":
        # @req: REQ-UNIT-OS-032
        step("Verify: resets cursor col to 0")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("X")
        ed.insert_char("Y")
        ed.newline()
        expect(ed.cursor_col).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "marks document as modified":
        # @req: REQ-UNIT-OS-033
        step("Verify: marks document as modified")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.newline()
        expect(ed.modified).to_equal(true)

    it "creates empty line when at end of text":
        # @req: REQ-UNIT-OS-034
        step("Verify: creates empty line when at end of text")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("Z")
        ed.newline()
        expect(ed.lines.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec
        expect(ed.lines[1]).to_equal("")

# ============================================================================
# Mode Transitions
# ============================================================================

describe "TextEditor mode transitions":
    context "Normal to Insert":
        it "switches to Insert on 'i' key":
            # @req: REQ-UNIT-OS-035
            step("Verify: switches to Insert on 'i' key")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var ed = TextEditor.new()
            ed.handle_normal_key("i")
            expect(ed.mode).to_equal(EditorMode.Insert)

        it "sets INSERT status message":
            # @req: REQ-UNIT-OS-036
            step("Verify: sets INSERT status message")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var ed = TextEditor.new()
            ed.handle_normal_key("i")
            expect(ed.status_message).to_equal("-- INSERT --")

        it "switches to Insert on 'a' key (append)":
            # @req: REQ-UNIT-OS-037
            step("Verify: switches to Insert on 'a' key (append)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var ed = TextEditor.new()
            ed.handle_normal_key("a")
            expect(ed.mode).to_equal(EditorMode.Insert)

        it "switches to Insert on 'o' key (open below)":
            # @req: REQ-UNIT-OS-038
            step("Verify: switches to Insert on 'o' key (open below)")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var ed = TextEditor.new()
            ed.handle_normal_key("o")
            expect(ed.mode).to_equal(EditorMode.Insert)

    context "Insert to Normal":
        it "switches to Normal on escape":
            # @req: REQ-UNIT-OS-039
            step("Verify: switches to Normal on escape")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var ed = TextEditor.new()
            ed.mode = EditorMode.Insert
            ed.handle_insert_key("escape")
            expect(ed.mode).to_equal(EditorMode.Normal)

        it "clears status message on escape":
            # @req: REQ-UNIT-OS-040
            step("Verify: clears status message on escape")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var ed = TextEditor.new()
            ed.mode = EditorMode.Insert
            ed.status_message = "-- INSERT --"
            ed.handle_insert_key("escape")
            expect(ed.status_message).to_equal("")

    context "Insert mode key handling":
        it "inserts character on regular key":
            # @req: REQ-UNIT-OS-041
            step("Verify: inserts character on regular key")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var ed = TextEditor.new()
            ed.mode = EditorMode.Insert
            ed.handle_insert_key("A")
            expect(ed.lines[0]).to_contain("A")

        it "handles enter key":
            # @req: REQ-UNIT-OS-042
            step("Verify: handles enter key")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var ed = TextEditor.new()
            ed.mode = EditorMode.Insert
            ed.handle_insert_key("enter")
            expect(ed.lines.len()).to_equal(2)  # oracle: expected value 2 is the behavior asserted by this regression spec

        it "handles backspace key":
            # @req: REQ-UNIT-OS-043
            step("Verify: handles backspace key")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var ed = TextEditor.new()
            ed.mode = EditorMode.Insert
            ed.insert_char("X")
            ed.handle_insert_key("backspace")
            expect(ed.cursor_col).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

# ============================================================================
# Cursor Bounds Checking
# ============================================================================

describe "TextEditor cursor bounds":
    it "h does not go below col 0":
        # @req: REQ-UNIT-OS-044
        step("Verify: h does not go below col 0")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.cursor_col = 0
        ed.handle_normal_key("h")
        expect(ed.cursor_col).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "k does not go below row 0":
        # @req: REQ-UNIT-OS-045
        step("Verify: k does not go below row 0")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.cursor_row = 0
        ed.handle_normal_key("k")
        expect(ed.cursor_row).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "j does not go past last line":
        # @req: REQ-UNIT-OS-046
        step("Verify: j does not go past last line")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        # Only 1 line, so j should not advance
        ed.handle_normal_key("j")
        expect(ed.cursor_row).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    it "0 moves to start of line":
        # @req: REQ-UNIT-OS-047
        step("Verify: 0 moves to start of line")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("A")
        ed.insert_char("B")
        ed.insert_char("C")
        ed.mode = EditorMode.Normal
        ed.handle_normal_key("0")
        expect(ed.cursor_col).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
