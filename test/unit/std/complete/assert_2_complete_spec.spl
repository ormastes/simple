"""
## Purpose and audience
Purpose: Verify Standalone assertion helpers through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/complete/assert_2_complete_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-ASSERT-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/assert_behavior.md
# doc-path: doc/03_plan/sys_test/assert_behavior.md
# doc-path: doc/04_architecture/lib/assert.md
# doc-path: doc/05_design/lib/assert_oracles.md
# @manual: primary

use std.spec
use std.spec.{assert_true, assert_equal, assert_not_equal}
use std.spec.step

describe "Standalone assertion helpers":
    it "standalone assertions pass on true conditions and compare values":
        step("Verify: standalone assertions pass on true conditions and compare values")
        # @req: REQ-LIB-ASSERT-001
        assert_true("Simple".starts_with("S"))
        assert_equal("Simple".len(), 6)  # oracle: the fixture word has six characters
        assert_not_equal("a", "b")

