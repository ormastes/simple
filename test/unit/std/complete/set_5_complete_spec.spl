# @req: REQ-LIB-SET-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/set_behavior.md
# doc-path: doc/03_plan/sys_test/set_behavior.md
# doc-path: doc/04_architecture/lib/set.md
# doc-path: doc/05_design/lib/set_oracles.md
# @manual: primary

use std.spec
use std.nogc_async_immut.persistent_set.{PersistentSet}
use std.spec.step

describe "Persistent set deduplication":
    it "a persistent set deduplicates repeated elements":
        step("Verify: a persistent set deduplicates repeated elements")
        # @req: REQ-LIB-SET-001
        val s = PersistentSet.of([1, 2, 2, 3, 3, 3])
        expect(s.to_array().len()).to_equal(3)  # oracle: duplicates collapse — one entry per distinct element

