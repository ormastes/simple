# @req: REQ-LIB-LIST-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/list_behavior.md
# doc-path: doc/03_plan/sys_test/list_behavior.md
# doc-path: doc/04_architecture/lib/list.md
# doc-path: doc/05_design/lib/list_oracles.md
# @manual: primary

use std.spec
use std.spec.step

describe "List iteration ordering":
    it "iteration follows insertion order":
        step("Verify: iteration follows insertion order")
        # @req: REQ-LIB-LIST-001
        val items = ["a", "b", "c"]
        var joined = ""
        for item in items:
            joined = joined + item
        expect(joined).to_equal("abc")  # oracle: concatenation in insertion order
        expect(items.len()).to_equal(3)  # oracle: length matches the number of literals
        expect(items[0]).to_equal("a")

