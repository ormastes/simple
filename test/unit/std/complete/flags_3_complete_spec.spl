# @req: REQ-STD-COMPLETE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/std/complete/flags_3_complete_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

# @req: REQ-LIB-FLAGS-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/flags_behavior.md
# doc-path: doc/03_plan/sys_test/flags_behavior.md
# doc-path: doc/04_architecture/lib/flags.md
# doc-path: doc/05_design/lib/flags_oracles.md
# @manual: primary

use std.spec
use std.config_parser.{parse_sdn_config}
use std.spec.step

# doc-path: doc/01_research/local/flags_3_complete.md
# doc-path: doc/03_plan/sys_test/flags_3_complete.md
# doc-path: doc/04_architecture/flags_3_complete.md
# doc-path: doc/05_design/flags_3_complete.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "array construction and access":
        step("Verify: array construction and access")
        # @req: REQ-STD-COMPLETE-001
        # @req: REQ-LIB-FLAGS-001
        expect([1, 2, 3].len()).to_equal(3)  # oracle: three-element literal
        expect([10, 20, 30][1]).to_equal(20)  # oracle: zero-based indexing
        expect([].len()).to_equal(0)  # oracle: empty literal has no elements

    it "base64 RFC 4648 vectors and roundtrip":
        step("Verify: base64 RFC 4648 vectors and roundtrip")
        # @req: REQ-STD-COMPLETE-001
        use std.common.base_encoding.base64.{base64_encode, base64_decode}
        expect(base64_encode("Man")).to_equal("TWFu")  # oracle: RFC 4648 illustration
        expect(base64_decode("TWFu")).to_equal("Man")
        expect(base64_decode(base64_encode("roundtrip"))).to_equal("roundtrip")

    it "nil option falls to else arm":
        step("Verify: nil option falls to else arm")
        # @req: REQ-STD-COMPLETE-001
        val opt = nil
        var chosen = 1
        match opt:
            Some(x): chosen = x
            nil: chosen = -1
        expect(chosen).to_equal(-1)  # oracle: nil arm taken

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "array sorting and mapping":
        step("Verify: array sorting and mapping")
        # @req: REQ-STD-COMPLETE-001
        expect([3, 1, 2].sorted()).to_equal([1, 2, 3])
        expect([1, 2, 3].map(fn(x: i64): x * 2)).to_equal([2, 4, 6])

    it "integer arithmetic precedence":
        step("Verify: integer arithmetic precedence")
        # @req: REQ-STD-COMPLETE-001
        expect(2 + 3 * 4).to_equal(14)  # oracle: * binds tighter than +
        expect(10 - 2 * 3).to_equal(4)  # oracle: multiplication precedes subtraction
        expect((2 + 3) * 4).to_equal(20)  # oracle: parentheses force additive group first

    it "string case and strip methods":
        step("Verify: string case and strip methods")
        # @req: REQ-STD-COMPLETE-001
        expect("AbC".to_lower()).to_equal("abc")
        expect("AbC".to_upper()).to_equal("ABC")
        expect("  x ".trim()).to_equal("x")
