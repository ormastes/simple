"""
## Purpose and audience
Purpose: Verify Numeric text parsing and rendering through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/complete/parse_3_complete_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-PARSE-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/parse_behavior.md
# doc-path: doc/03_plan/sys_test/parse_behavior.md
# doc-path: doc/04_architecture/lib/parse.md
# doc-path: doc/05_design/lib/parse_oracles.md
# @manual: primary

use std.spec
use std.common.convert.{safe_parse_int, i64_to_text}
use std.spec.step

describe "Numeric text parsing and rendering":
    it "safe_parse_int accepts canonical decimals and i64_to_text round-trips":
        step("Verify: safe_parse_int accepts canonical decimals and i64_to_text round-trips")
        # @req: REQ-LIB-PARSE-001
        expect((safe_parse_int("42") ?? 0)).to_equal(42)  # oracle: canonical decimal text parses to its value
        expect(i64_to_text(42)).to_equal("42")  # oracle: canonical decimal rendering
        expect((safe_parse_int("42") ?? 0)).to_equal(42)  # oracle: repeated parse is deterministic

