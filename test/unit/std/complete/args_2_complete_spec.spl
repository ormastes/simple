"""
## Purpose and audience
Purpose: Verify Argument vector passing through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/complete/args_2_complete_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-ARGS-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/args_behavior.md
# doc-path: doc/03_plan/sys_test/args_behavior.md
# doc-path: doc/04_architecture/lib/args.md
# doc-path: doc/05_design/lib/args_oracles.md
# @manual: primary

use std.spec
use std.spec.step

describe "Argument vector passing":
    it "argv passed to a child process arrives intact":
        step("Verify: argv passed to a child process arrives intact")
        # @req: REQ-LIB-ARGS-001
        val (stdout, _stderr, _code) = process_run("/bin/echo", ["alpha", "beta"])
        expect(stdout).to_contain("alpha")  # oracle: the first argument reaches the child
        expect(stdout).to_contain("beta")  # oracle: the second argument reaches the child

