# @req: REQ-LIB-CONCURRENT-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/concurrent_behavior.md
# doc-path: doc/03_plan/sys_test/concurrent_behavior.md
# doc-path: doc/04_architecture/lib/concurrent.md
# doc-path: doc/05_design/lib/concurrent_oracles.md
# @manual: primary

use std.spec
use std.concurrent.{mpsc_queue_new, barrier_new}
use std.spec.step

describe "Concurrency primitive construction":
    it "concurrency primitives construct usable values":
        step("Verify: concurrency primitives construct usable values")
        # @req: REQ-LIB-CONCURRENT-001
        expect(mpsc_queue_new().?).to_equal(true)  # oracle: a fresh queue is a real value, not nil
        expect(barrier_new(2).?).to_equal(true)  # oracle: a barrier for two parties constructs

