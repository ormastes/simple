"""
## Purpose and audience
Purpose: Verify Wall-clock monotonic reads through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/complete/time_3_complete_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-TIME-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/time_behavior.md
# doc-path: doc/03_plan/sys_test/time_behavior.md
# doc-path: doc/04_architecture/lib/time.md
# doc-path: doc/05_design/lib/time_oracles.md
# @manual: primary

use std.spec
use std.nogc_sync_mut.src.time.{now_ms}
use std.spec.step

describe "Wall-clock monotonic reads":
    it "now_ms is positive and non-decreasing across successive reads":
        step("Verify: now_ms is positive and non-decreasing across successive reads")
        # @req: REQ-LIB-TIME-001
        val first = now_ms()
        expect((first > 0)).to_equal(true)  # oracle: epoch milliseconds are positive
        val second = now_ms()
        expect((second >= first)).to_equal(true)  # oracle: the clock never runs backwards

