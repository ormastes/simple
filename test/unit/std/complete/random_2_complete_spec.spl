"""
## Purpose and audience
Purpose: Verify Bounded random integers through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/complete/random_2_complete_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-RANDOM-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/random_behavior.md
# doc-path: doc/03_plan/sys_test/random_behavior.md
# doc-path: doc/04_architecture/lib/random.md
# doc-path: doc/05_design/lib/random_oracles.md
# @manual: primary

use std.spec
use std.common.random_pure.{randint}
use std.spec.step

describe "Bounded random integers":
    it "randint stays inside the requested inclusive bounds":
        step("Verify: randint stays inside the requested inclusive bounds")
        # @req: REQ-LIB-RANDOM-001
        var i = 0
        while i < 20:
            val draw = randint(5, 10)
            expect((draw >= 5 and draw <= 10)).to_equal(true)  # oracle: every draw respects the bounds
            i = i + 1

