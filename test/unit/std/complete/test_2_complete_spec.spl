# @req: REQ-LIB-TEST-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/test_behavior.md
# doc-path: doc/03_plan/sys_test/test_behavior.md
# doc-path: doc/04_architecture/lib/test.md
# doc-path: doc/05_design/lib/test_oracles.md
# @manual: primary

use std.spec
use std.spec.step

describe "Scenario body determinism":
    it "runner-visible scenario state behaves deterministically":
        step("Verify: runner-visible scenario state behaves deterministically")
        # @req: REQ-LIB-TEST-001
        var counter = 0
        for x in [1, 2, 3]:
            counter = counter + x
        expect(counter).to_equal(6)  # oracle: 1+2+3 accumulated by the scenario body

