"""
## Purpose and audience
Purpose: Verify Math integer helpers on signed inputs through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/complete/math_4_complete_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-MATH-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/math_behavior.md
# doc-path: doc/03_plan/sys_test/math_behavior.md
# doc-path: doc/04_architecture/lib/math.md
# doc-path: doc/05_design/lib/math_oracles.md
# @manual: primary

use std.spec
use std.math.{abs, min, max}
use std.spec.step

describe "Math integer helpers on signed inputs":
    it "abs, min, max behave on signed inputs":
        step("Verify: abs, min, max behave on signed inputs")
        # @req: REQ-LIB-MATH-001
        expect(abs(-42)).to_equal(42)  # oracle: absolute value flips the sign only
        expect(abs(42)).to_equal(42)
        expect(min(3, 9)).to_equal(3)  # oracle: min returns the smaller operand
        expect(max(3, 9)).to_equal(9)  # oracle: max returns the larger operand
        expect(min(-3, -9)).to_equal(-9)  # oracle: min is correct on negatives

