# @req: REQ-LIB-ITER-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/iter_behavior.md
# doc-path: doc/03_plan/sys_test/iter_behavior.md
# doc-path: doc/04_architecture/lib/iter.md
# doc-path: doc/05_design/lib/iter_oracles.md
# @manual: primary

use std.spec
use std.spec.step

describe "Iteration accumulation":
    it "iterated accumulation preserves element order and count":
        step("Verify: iterated accumulation preserves element order and count")
        # @req: REQ-LIB-ITER-001
        var total = 0
        var count = 0
        for x in [10, 20, 30]:
            total = total + x
            count = count + 1
        expect(total).to_equal(60)  # oracle: 10+20+30 in iteration order
        expect(count).to_equal(3)  # oracle: one iteration per element

