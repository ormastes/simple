"""
## Purpose and audience
Purpose: Verify Log level constants through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/complete/log_1_complete_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-LOG-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/log_behavior.md
# doc-path: doc/03_plan/sys_test/log_behavior.md
# doc-path: doc/04_architecture/lib/log.md
# doc-path: doc/05_design/lib/log_oracles.md
# @manual: primary

use std.spec
use std.log.{LOG_TRACE, LOG_INFO, LOG_ERROR, LOG_FATAL}
use std.spec.step

describe "Log level constants":
    it "log level constants are distinct and totally ordered":
        step("Verify: log level constants are distinct and totally ordered")
        # @req: REQ-LIB-LOG-001
        expect((LOG_TRACE < LOG_FATAL)).to_equal(true)  # oracle: severity increases from TRACE to FATAL
        expect((LOG_INFO == LOG_ERROR)).to_equal(false)  # oracle: distinct severities have distinct constants

