"""
## Purpose and audience
Purpose: Verify SDN document parsing through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/complete/sdn_3_complete_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-SDN-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/sdn_behavior.md
# doc-path: doc/03_plan/sys_test/sdn_behavior.md
# doc-path: doc/04_architecture/lib/sdn.md
# doc-path: doc/05_design/lib/sdn_oracles.md
# @manual: primary

use std.spec
use std.sdn.{parse}
use std.spec.step

describe "SDN document parsing":
    it "the SDN parser accepts a simple key-value document":
        step("Verify: the SDN parser accepts a simple key-value document")
        # @req: REQ-LIB-SDN-001
        val doc = parse("name = \"wave6\"\ncount = 3")
        expect(doc.?).to_equal(true)  # oracle: well-formed SDN parses into a value

