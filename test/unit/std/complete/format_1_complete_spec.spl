# @req: REQ-STD-COMPLETE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/std/complete/format_1_complete_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

# @req: REQ-LIB-FORMAT-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/format_behavior.md
# doc-path: doc/03_plan/sys_test/format_behavior.md
# doc-path: doc/04_architecture/lib/format.md
# doc-path: doc/05_design/lib/format_oracles.md
# @manual: primary

use std.spec
use std.spec.step

# doc-path: doc/01_research/local/format_1_complete.md
# doc-path: doc/03_plan/sys_test/format_1_complete.md
# doc-path: doc/04_architecture/format_1_complete.md
# doc-path: doc/05_design/format_1_complete.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "array filtering and membership":
        step("Verify: array filtering and membership")
        # @req: REQ-STD-COMPLETE-001
        # @req: REQ-LIB-FORMAT-001
        expect([1, 2, 3].filter(fn(x: i64): x > 1)).to_equal([2, 3])
        expect([1, 2, 3].contains(2)).to_equal(true)
        expect([1, 2].concat([3])).to_equal([1, 2, 3])

    it "bitwise operators":
        step("Verify: bitwise operators")
        # @req: REQ-STD-COMPLETE-001
        expect(6 & 3).to_equal(2)  # oracle: 0b110 & 0b011
        expect(6 | 3).to_equal(7)  # oracle: 0b110 | 0b011
        expect(6 ^ 3).to_equal(5)  # oracle: xor of operands
        expect(1 << 4).to_equal(16)  # oracle: shift left by 4
        expect(-8 >> 1).to_equal(-4)  # oracle: arithmetic shift right

    it "Option payload binding":
        step("Verify: Option payload binding")
        # @req: REQ-STD-COMPLETE-001
        val opt = Some(99)
        var chosen = 0
        match opt:
            Some(x): chosen = x
            nil: chosen = -1
        expect(chosen).to_equal(99)  # oracle: Some arm binds payload

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "dict get, keys and membership":
        step("Verify: dict get, keys and membership")
        # @req: REQ-STD-COMPLETE-001
        val d = {"a": 1}
        expect(d.get("a")).to_equal(1)  # oracle: stored value
        expect(d.has("b")).to_equal(false)
        expect(d.keys()).to_equal(["a"])

    it "base64 RFC 4648 vectors and roundtrip":
        step("Verify: base64 RFC 4648 vectors and roundtrip")
        # @req: REQ-STD-COMPLETE-001
        use std.common.base_encoding.base64.{base64_encode, base64_decode}
        expect(base64_encode("Man")).to_equal("TWFu")  # oracle: RFC 4648 illustration
        expect(base64_decode("TWFu")).to_equal("Man")
        expect(base64_decode(base64_encode("roundtrip"))).to_equal("roundtrip")

    it "for-in accumulates array elements":
        step("Verify: for-in accumulates array elements")
        # @req: REQ-STD-COMPLETE-001
        var s = 0
        for x in [1, 2, 3]:
            s = s + x
        expect(s).to_equal(6)  # oracle: 1+2+3
