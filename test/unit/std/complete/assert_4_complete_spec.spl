# @req: REQ-STD-COMPLETE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/std/complete/assert_4_complete_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

# @req: REQ-LIB-ASSERT-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/assert_behavior.md
# doc-path: doc/03_plan/sys_test/assert_behavior.md
# doc-path: doc/04_architecture/lib/assert.md
# doc-path: doc/05_design/lib/assert_oracles.md
# @manual: primary

use std.spec
use std.spec.{assert_true, assert_equal, assert_not_equal}
use std.spec.step

# doc-path: doc/01_research/local/assert_4_complete.md
# doc-path: doc/03_plan/sys_test/assert_4_complete.md
# doc-path: doc/04_architecture/assert_4_complete.md
# doc-path: doc/05_design/assert_4_complete.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "Option payload binding":
        step("Verify: Option payload binding")
        # @req: REQ-STD-COMPLETE-001
        # @req: REQ-LIB-ASSERT-001
        val opt = Some(99)
        var chosen = 0
        match opt:
            Some(x): chosen = x
            nil: chosen = -1
        expect(chosen).to_equal(99)  # oracle: Some arm binds payload

    it "string predicates and slicing":
        step("Verify: string predicates and slicing")
        # @req: REQ-STD-COMPLETE-001
        expect("test.spl".ends_with(".spl")).to_equal(true)
        expect("hello world".contains("lo w")).to_equal(true)
        expect("hello world".len()).to_equal(11)  # oracle: 11 ASCII characters
        expect("abc".slice(0, 2)).to_equal("ab")

    it "function calls and closure values":
        step("Verify: function calls and closure values")
        # @req: REQ-STD-COMPLETE-001
        fn add(a: i64, b: i64) -> i64: a + b
        expect(add(2, 3)).to_equal(5)  # oracle: 2+3
        val f = fn(x: i64) -> i64: x * x
        expect(f(4)).to_equal(16)  # oracle: 4 squared

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "dict literal access":
        step("Verify: dict literal access")
        # @req: REQ-STD-COMPLETE-001
        val d = {"k": "v"}
        expect(d["k"]).to_equal("v")

    it "for-range iterates the half-open span":
        step("Verify: for-range iterates the half-open span")
        # @req: REQ-STD-COMPLETE-001
        var seen = 0
        for i in 0..4:
            seen = seen + 1
        expect(seen).to_equal(4)  # oracle: 0..4 yields four iterations

    it "while with break and continue":
        step("Verify: while with break and continue")
        # @req: REQ-STD-COMPLETE-001
        var i = 0
        var acc = 0
        while i < 10:
            i = i + 1
            if i == 3: continue
            if i == 7: break
            acc = acc + i
        expect(acc).to_equal(18)  # oracle: 1+2+4+5+6
