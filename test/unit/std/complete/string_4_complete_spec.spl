"""
## Purpose and audience
Purpose: Verify String method behavior on fixed fixtures through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/complete/string_4_complete_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-STRING-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/string_behavior.md
# doc-path: doc/03_plan/sys_test/string_behavior.md
# doc-path: doc/04_architecture/lib/string.md
# doc-path: doc/05_design/lib/string_oracles.md
# @manual: primary

use std.spec
use std.spec.step

describe "String method behavior on fixed fixtures":
    it "len, contains, starts_with and ends_with agree on a fixed fixture":
        step("Verify: len, contains, starts_with and ends_with agree on a fixed fixture")
        # @req: REQ-LIB-STRING-001
        val sample = "Simple Language"
        expect(sample.len()).to_equal(15)  # oracle: 15 characters including the space
        expect(sample.contains("Language")).to_equal(true)
        expect(sample.starts_with("Simple")).to_equal(true)
        expect(sample.ends_with("age")).to_equal(true)

    it "replace returns a new string and never mutates the receiver":
        step("Verify: replace returns a new string and never mutates the receiver")
        # @req: REQ-LIB-STRING-001
        val sample = "Simple Language"
        val replaced = sample.replace("Language", "Runtime")
        expect(replaced).to_equal("Simple Runtime")  # oracle: the pattern is substituted in the result
        expect(sample).to_equal("Simple Language")  # oracle: value semantics — receiver unchanged

    it "find reports the index of the first occurrence":
        step("Verify: find reports the index of the first occurrence")
        # @req: REQ-LIB-STRING-001
        val sample = "banana"
        expect(sample.find("a")).to_equal(1)  # oracle: first 'a' sits at index 1
        expect(sample.find("z")).to_equal(-1)  # oracle: absent needle reports -1

