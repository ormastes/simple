use std.spec
use std.blink.url.url_parser.{parse_url}
use std.spec.step

describe "URL parsing":
    it "URL parsing splits scheme, host and path":
        step("Verify: URL parsing splits scheme, host and path")
        # @req: REQ-LIB-NET-001
        val u = parse_url("https://example.com/path")
        expect(u.?).to_equal(true)  # oracle: an absolute URL parses

