"""
## Purpose and audience
Purpose: Verify Regex literal escaping through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/complete/regex_4_complete_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-REGEX-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/regex_behavior.md
# doc-path: doc/03_plan/sys_test/regex_behavior.md
# doc-path: doc/04_architecture/lib/regex.md
# doc-path: doc/05_design/lib/regex_oracles.md
# @manual: primary

use std.spec
use std.gc_async_mut.src.core.regex.{escape}
use std.spec.step

describe "Regex literal escaping":
    it "regex metacharacters are escaped for literal matching":
        step("Verify: regex metacharacters are escaped for literal matching")
        # @req: REQ-LIB-REGEX-001
        expect((escape("a.b") == "a.b")).to_equal(false)  # oracle: metacharacters are escaped, changing the text
        expect(escape("a.b").len()).to_equal(4)  # oracle: one metacharacter adds exactly one escape character
        expect(escape("ab")).to_equal("ab")  # oracle: plain text passes through unchanged

