use std.spec
use std.config_parser.{parse_sdn_config}
use std.spec.step

describe "SDN config parsing":
    it "parse_sdn_config accepts a minimal config document":
        step("Verify: parse_sdn_config accepts a minimal config document")
        # @req: REQ-LIB-CONFIG-001
        val cfg = parse_sdn_config("name = \"wave6\"")
        expect(cfg.?).to_equal(true)  # oracle: a minimal config document parses successfully

