# @req: REQ-STD-COMPLETE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/std/complete/config_2_complete_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

# @req: REQ-LIB-CONFIG-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/config_behavior.md
# doc-path: doc/03_plan/sys_test/config_behavior.md
# doc-path: doc/04_architecture/lib/config.md
# doc-path: doc/05_design/lib/config_oracles.md
# @manual: primary

use std.spec
use std.config_parser.{parse_sdn_config}
use std.spec.step

# doc-path: doc/01_research/local/config_2_complete.md
# doc-path: doc/03_plan/sys_test/config_2_complete.md
# doc-path: doc/04_architecture/config_2_complete.md
# doc-path: doc/05_design/config_2_complete.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "Option payload binding":
        step("Verify: Option payload binding")
        # @req: REQ-STD-COMPLETE-001
        # @req: REQ-LIB-CONFIG-001
        val opt = Some(99)
        var chosen = 0
        match opt:
            Some(x): chosen = x
            nil: chosen = -1
        expect(chosen).to_equal(99)  # oracle: Some arm binds payload

    it "array construction and access":
        step("Verify: array construction and access")
        # @req: REQ-STD-COMPLETE-001
        expect([1, 2, 3].len()).to_equal(3)  # oracle: three-element literal
        expect([10, 20, 30][1]).to_equal(20)  # oracle: zero-based indexing
        expect([].len()).to_equal(0)  # oracle: empty literal has no elements

    it "string predicates and slicing":
        step("Verify: string predicates and slicing")
        # @req: REQ-STD-COMPLETE-001
        expect("test.spl".ends_with(".spl")).to_equal(true)
        expect("hello world".contains("lo w")).to_equal(true)
        expect("hello world".len()).to_equal(11)  # oracle: 11 ASCII characters
        expect("abc".slice(0, 2)).to_equal("ab")

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "string split, join and repeat":
        step("Verify: string split, join and repeat")
        # @req: REQ-STD-COMPLETE-001
        expect("a,b,c".split(",")).to_equal(["a", "b", "c"])
        expect("ha".repeat(3)).to_equal("hahaha")
        expect("ab".reverse()).to_equal("ba")

    it "integer conversion helpers":
        step("Verify: integer conversion helpers")
        # @req: REQ-STD-COMPLETE-001
        expect(42.to_text()).to_equal("42")
        expect("42".parse_int()).to_equal(42)  # oracle: decimal parse

    it "for-range iterates the half-open span":
        step("Verify: for-range iterates the half-open span")
        # @req: REQ-STD-COMPLETE-001
        var seen = 0
        for i in 0..4:
            seen = seen + 1
        expect(seen).to_equal(4)  # oracle: 0..4 yields four iterations
