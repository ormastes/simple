"""
## Purpose and audience
Purpose: Verify Environment variable reading through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/complete/env_4_complete_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-ENV-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/env_behavior.md
# doc-path: doc/03_plan/sys_test/env_behavior.md
# doc-path: doc/04_architecture/lib/env.md
# doc-path: doc/05_design/lib/env_oracles.md
# @manual: primary

use std.spec
use std.io.{env_get}
use std.spec.step

describe "Environment variable reading":
    it "reading a set variable returns its value and unset names stay empty":
        step("Verify: reading a set variable returns its value and unset names stay empty")
        # @req: REQ-LIB-ENV-001
        expect(env_get("PATH").len() > 0).to_equal(true)  # oracle: PATH is present in the test environment
        expect(env_get("SURELY_UNSET_XYZ_123").len()).to_equal(0)  # oracle: unset names read back as empty text

