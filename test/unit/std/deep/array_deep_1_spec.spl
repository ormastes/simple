"""
## Purpose and audience
Purpose: Verify Array value semantics and ordering through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/deep/array_deep_1_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-ARRAY-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/array_behavior.md
# doc-path: doc/03_plan/sys_test/array_behavior.md
# doc-path: doc/04_architecture/lib/array.md
# doc-path: doc/05_design/lib/array_oracles.md
# @manual: primary

use std.spec
use std.spec.step

describe "Array value semantics and ordering":
    it "array length, indexing, and slice bounds are consistent":
        step("Verify: array length, indexing, and slice bounds are consistent")
        # @req: REQ-LIB-ARRAY-001
        val fixture = [30, 10, 20]
        expect(fixture.len()).to_equal(3)  # oracle: fixture declares exactly three elements
        expect(fixture[0]).to_equal(30)  # oracle: arrays are 0-indexed and preserve insertion order
        val sliced = fixture[1..3]
        expect(sliced.len()).to_equal(2)  # oracle: range slices exclude the end bound
        expect(sliced[0]).to_equal(10)  # oracle: slice starts at the low bound

    it "append grows the copy and leaves the original binding untouched":
        step("Verify: append grows the copy and leaves the original binding untouched")
        # @req: REQ-LIB-ARRAY-001
        val original = [1, 2]
        var grown = original
        grown = grown.append(3)
        expect(grown.len()).to_equal(3)  # oracle: append grows the array by exactly one
        expect(grown.contains(3)).to_equal(true)
        expect(original.contains(3)).to_equal(false)  # oracle: value semantics — the original binding is unmodified

    it "iteration order follows insertion order":
        step("Verify: iteration order follows insertion order")
        # @req: REQ-LIB-ARRAY-001
        val items = [10, 20, 30]
        var total = 0
        for x in items:
            total = total + x
        expect(total).to_equal(60)  # oracle: 10+20+30 in insertion order

