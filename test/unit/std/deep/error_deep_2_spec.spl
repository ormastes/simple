"""
## Purpose and audience
Purpose: Verify Error carrier semantics through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/deep/error_deep_2_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-ERROR-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/error_behavior.md
# doc-path: doc/03_plan/sys_test/error_behavior.md
# doc-path: doc/04_architecture/lib/error.md
# doc-path: doc/05_design/lib/error_oracles.md
# @manual: primary

use std.spec
use std.result.{result_is_err}
use std.spec.step

describe "Error carrier semantics":
    it "the error lane is exactly the nil carrier":
        step("Verify: the error lane is exactly the nil carrier")
        # @req: REQ-LIB-ERROR-001
        expect(result_is_err(nil)).to_equal(true)  # oracle: nil is carried as the error side
        expect(result_is_err("message")).to_equal(false)  # oracle: a present value is never the error side

