"""
# STDLIB Deep-Dive Test


**Feature IDs:** #STDLIB-DEEP
**Category:** Standard Library Deep Coverage
**Status:** Implemented
"""

use std.spec

fn check(condition: bool):
    expect(condition).to_equal(true)
use std.text.{NL}

describe "Dict Deep Coverage":
    # These examples previously asserted constant expressions (`check(1 == 1)`,
    # `check(5 - 3 == 2)`, `check(true and true)`). Those observe nothing: they
    # pass identically on broken and fixed code, so this file reported green
    # while covering no dict behavior at all despite its name and its
    # "Standard Library Deep Coverage" claim. They now assert real dict results.
    #
    # Per doc/07_guide/language/dict_native_pitfalls.md, under native codegen
    # `Dict.len()` returns -1 and `.get()` on a hit is corrupt. So these use
    # `keys().len()` and index reads `d[k]` / `contains_key(k)` only.

    it "reads back a value stored under a key":
        val d = {"a": 1}
        check(d["a"] == 1)

    it "keeps distinct keys distinct":
        val d = {"a": 1, "b": 2}
        check(d["a"] == 1 and d["b"] == 2)

    it "reports key presence and absence":
        val d = {"a": 1, "b": 2}
        check(d.contains_key("a"))
        check(not d.contains_key("zzz"))

    it "counts keys via keys().len()":
        val d = {"a": 1, "b": 2, "c": 3}
        check(d.keys().len() == 3)

    it "an empty dict has no keys and reports no membership":
        val d = {}
        check(d.keys().len() == 0)
        check(not d.contains_key("a"))

    it "a later duplicate key overwrites the earlier value":
        val d = {"k": 1, "k": 2}
        check(d["k"] == 2)
        check(d.keys().len() == 1)

    it "distinguishes a stored zero from an absent key":
        val d = {"z": 0}
        check(d["z"] == 0)
        check(d.contains_key("z"))
        check(not d.contains_key("missing"))

    it "keys are case sensitive":
        val d = {"a": 1, "A": 2}
        check(d["a"] == 1)
        check(d["A"] == 2)
        check(d.keys().len() == 2)

    it "handles an empty-string key":
        val d = {"": 7}
        check(d[""] == 7)
        check(d.contains_key(""))

    it "stores text values, not just integers":
        val d = {"name": "simple"}
        check(d["name"] == "simple")

    it "every inserted key appears in keys()":
        val d = {"a": 1, "b": 2, "c": 3}
        var seen = 0
        for k in d.keys():
            if d.contains_key(k):
                seen = seen + 1
        check(seen == 3)

    it "arr 1":

        val a = [1,2,3]
        check(a.len() == 3)
    it "arr 2":
        val a = []
        check(a.len() == 0)
    it "arr 3":
        val a = [1, 2, 3]
        check(a.len() == 3)
    it "arr 4":
        val a = [1,2,3]
        check(a.len() == 3)
    it "arr 5":
        var a = [1,2]
        val b = a.append(3)
        check(b.len() == 3)

    it "str 1":

        check("".len() == 0)
    it "str 2":
        check("a".len() == 1)
    it "str 3":
        check("test".len() == 4)
    it "str 4":
        check("hello".contains("ell"))
    it "str 5":
        check("test".starts_with("te"))
    it "str 6":
        check("test".ends_with("st"))

    it "opt 1":

        val o = Some(1)
        check(o.?)
    it "opt 2":
        val o = nil
        check(not o.?)
    it "opt 3":
        val o = Some(42)
        check(o? == 42)
    it "opt 4":
        val o = nil
        check((o ?? 99) == 99)

    it "dict 1":

        val d = {"a": 1}
        check(d["a"] == 1)
    it "dict 2":
        # was: `val d = {}` then `check(true)` — bound the dict and then
        # ignored it, asserting a constant instead.
        val d = {}
        check(d.keys().len() == 0)
    it "dict 3":
        val d = {"a": 1, "b": 2}
        check(d["a"] == 1)

    it "if 1":

        if true:
            check(true)
        else:
            check(false)
    it "if 2":
        if false:
            check(false)
        else:
            check(true)
    it "if 3":
        val x = 10
        if x > 5:
            check(true)
        else:
            check(false)

    it "for 1":

        var c = 0
        for i in 0..5:
            c = c + 1
        check(c == 5)

    it "for 2":

        var s = 0
        for i in 0..10:
            s = s + i
        check(s == 45)

    it "match 1":

        match Some(1):
            Some(x): check(x == 1)
            nil: check(false)

    it "match 2":

        match nil:
            Some(x): check(false)
            nil: check(true)

    it "nested 1":

        # was: `check(true)` in the inner loop — the loops ran but nothing
        # about them was observed. Now the iteration count is the assertion.
        var n = 0
        for i in 0..3:
            for j in 0..3:
                n = n + 1
        check(n == 9)

    it "complex 1":

        val arr = [1,2,3,4,5]
        var evens = []
        for x in arr:
            if x % 2 == 0:
                evens = evens.append(x)
        check(evens.len() == 2)
