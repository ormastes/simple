"""
## Purpose and audience
Purpose: Verify Path joining and normalization through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/deep/path_deep_17_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-PATH-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/path_behavior.md
# doc-path: doc/03_plan/sys_test/path_behavior.md
# doc-path: doc/04_architecture/lib/path.md
# doc-path: doc/05_design/lib/path_oracles.md
# @manual: primary

use std.spec
use std.path.{join, normalize}
use std.spec.step

describe "Path joining and normalization":
    it "join concatenates segments and normalize folds dot segments":
        step("Verify: join concatenates segments and normalize folds dot segments")
        # @req: REQ-LIB-PATH-001
        val joined = join(["usr", "local", "bin"])
        expect(joined.starts_with("usr")).to_equal(true)  # oracle: first segment leads
        expect(joined.ends_with("bin")).to_equal(true)  # oracle: last segment trails
        expect(joined.contains("local")).to_equal(true)
        val dotted = normalize("usr/./local/../lib")
        expect(dotted.contains("usr")).to_equal(true)
        expect(dotted.ends_with("lib")).to_equal(true)  # oracle: .. folds away the preceding segment
        expect(dotted.contains("local")).to_equal(false)  # oracle: local was removed by ..

