"""
## Purpose and audience
Purpose: Verify Option nil-coalescing and truthiness through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/deep/option_deep_18_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-OPTION-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/option_behavior.md
# doc-path: doc/03_plan/sys_test/option_behavior.md
# doc-path: doc/04_architecture/lib/option.md
# doc-path: doc/05_design/lib/option_oracles.md
# @manual: primary

use std.spec
use std.spec.step

describe "Option nil-coalescing and truthiness":
    it "nil-coalescing yields the default only on nil":
        step("Verify: nil-coalescing yields the default only on nil")
        # @req: REQ-LIB-OPTION-001
        val absent: Option<text> = nil
        expect((absent ?? "fallback")).to_equal("fallback")  # oracle: ?? yields the default on nil
        val present: Option<text> = Some("value")
        expect((present ?? "fallback")).to_equal("value")  # oracle: ?? keeps the wrapped value when present

    it "option truthiness and nested nil chain":
        step("Verify: option truthiness and nested nil chain")
        # @req: REQ-LIB-OPTION-001
        val present: Option<i64> = Some(5)
        expect(present.?).to_equal(true)
        val chained = nil ?? nil
        expect(chained).to_be_nil()  # oracle: coalescing nil with nil stays nil

