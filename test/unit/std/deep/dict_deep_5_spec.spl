"""
## Purpose and audience
Purpose: Verify Dict lookup hit and miss behavior through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/deep/dict_deep_5_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-DICT-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/dict_behavior.md
# doc-path: doc/03_plan/sys_test/dict_behavior.md
# doc-path: doc/04_architecture/lib/dict.md
# doc-path: doc/05_design/lib/dict_oracles.md
# @manual: primary

use std.spec
use std.spec.step

describe "Dict lookup hit and miss behavior":
    it "bracket read, len, and key membership agree with insertion":
        step("Verify: bracket read, len, and key membership agree with insertion")
        # @req: REQ-LIB-DICT-001
        val table = {"alpha": 1, "beta": 2}
        expect(table.len()).to_equal(2)  # oracle: two entries were inserted
        expect(table["alpha"]).to_equal(1)  # oracle: bracket read returns the stored value
        expect(table.contains_key("beta")).to_equal(true)
        expect(table.contains_key("gamma")).to_equal(false)

    it "get on an absent key yields nil rather than panicking":
        step("Verify: get on an absent key yields nil rather than panicking")
        # @req: REQ-LIB-DICT-001
        val table = {"alpha": 1}
        val missing = table.get("gamma")
        expect(missing.?).to_equal(false)  # oracle: absent key -> nil option
        val present = table.get("alpha")
        expect(present.?).to_equal(true)

