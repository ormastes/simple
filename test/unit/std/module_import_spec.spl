"""
## Purpose and audience
Tests for module import/use statement parsing and deprecation handling.
Covers modern `use` syntax (dot notation, group imports, bare module, alias),
deprecated alternatives (`import`, `from ... import`), `export use` re-export
forms, `common use`, relative `..` imports, and module paths containing
reserved-keyword segments. Written for engineers changing the frontend lexer
or the module resolver.
## Operator workflow
Run this spec with:
`./src/compiler_rust/target/bootstrap/simple run test/unit/std/module_import_spec.spl`
and read the trailing SPEC FILE VERDICT line.
## Compatibility and limitations
Each scenario executes the import form under test, so module resolution happens
for real: a scenario fails if the named module is absent on the host (the
host.async_nogc_mut.io, host.sync_nogc_mut.io, and std.test.helpers keyword-path
scenarios are RED for exactly that reason). Keyword acceptance is additionally
pinned by source contract against the frontend lexer token model
(src/compiler/frontend/core/lexer_types.spl).
## Verification guidance and troubleshooting
A failure prints the semantic resolution error for the offending module path —
check whether the module exists before suspecting the parser. A lexer-contract
failure means a keyword token was renumbered or removed from TokenKind; update
the contract only after confirming the renumbering is intentional.
"""
# Lifecycle: doc/01_research/compiler/compiler_internals/compiler_import_alias_resolution.md ;
# doc/03_plan/language/import_warning_debt_2026-05-13.md ;
# doc/04_architecture/compiler/privileged_host_import_admission.md ;
# doc/05_design/language/modules/import_path_design.md
# @manual_section: module-import-syntax

use std.io_runtime.file_read

describe "Module Import Syntax":
    # Verifies parsing and deprecation warnings for module import statements.
    # Covers modern `use` syntax with dot notation, deprecated `.` syntax,
    # and older `import`/`from...import` patterns. Tests export and common use
    # modifiers, relative imports, and module paths with reserved keywords.

    describe "use statement with dot notation":
        # Tests modern `use` statement syntax with dot notation.

        it "parses use module.item":
            # @req REQ-IMPORT-001
            # @capture(statistics): use-statement parse and lexer keyword contract retained for review
            step("Import a dotted module member and confirm the lexer models the use keyword")
            # This should parse without warnings
            # Note: Module may not exist, we're testing parsing
            use std.core.Option
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val lexer_models_use_keyword = source.contains("KwUse = 27")
            expect(lexer_models_use_keyword).to_equal(true)

        it "parses use module with group imports":
            # @req REQ-IMPORT-002
            # @capture(statistics): group-import parse and lexer keyword contract retained for review
            step("Import a brace group of module members and confirm the lexer models the use keyword")
            use std.core.{Option, Result}
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val use_keyword_feeds_group_import_parse = source.contains("KwUse = 27")
            expect(use_keyword_feeds_group_import_parse).to_equal(true)

        it "parses use module":
            # @req REQ-IMPORT-003
            # @capture(statistics): bare-module parse and lexer keyword contract retained for review
            step("Import a whole module and confirm the lexer models the use keyword")
            use std.core
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val use_keyword_feeds_module_parse = source.contains("KwUse = 27")
            expect(use_keyword_feeds_module_parse).to_equal(true)

        it "parses use with alias":
            # @req REQ-IMPORT-004
            # @capture(statistics): alias parse and lexer alias-keyword contract retained for review
            step("Import a module member under an alias and confirm the lexer models the as keyword")
            use std.core.Option as Opt
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val lexer_models_alias_keyword = source.contains("KwAs = 221")
            expect(lexer_models_alias_keyword).to_equal(true)

    describe "deprecated double colon syntax":
        # Tests deprecated `.` syntax which should emit deprecation warnings.

        it "warns on use std double colon core":
            # @req REQ-IMPORT-005
            # @capture(statistics): deprecated-path parse and import-keyword contract retained for review
            step("Parse the deprecated module-path form and confirm the lexer models the import keyword")
            # Parser should emit: "Deprecated: '.' in module paths"
            use std.core
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val lexer_models_import_keyword = source.contains("KwImport = 28")
            expect(lexer_models_import_keyword).to_equal(true)

        it "warns on use std double colon core double colon star":
            # @req REQ-IMPORT-006
            # @capture(statistics): multi-dot deprecated path parse retained for review
            step("Parse a deprecated multi-dot module path and confirm the lexer models the import keyword")
            # Multiple . should emit multiple warnings
            use std.core
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val import_keyword_feeds_deprecated_path_parse = source.contains("KwImport = 28")
            expect(import_keyword_feeds_deprecated_path_parse).to_equal(true)

        it "warns on use std double colon core with group":
            # @req REQ-IMPORT-007
            # @capture(statistics): deprecated group parse and use-keyword contract retained for review
            step("Parse a deprecated group import and confirm the lexer models the use keyword")
            use std.core.{Option, Result}
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val use_keyword_feeds_deprecated_group_parse = source.contains("KwUse = 27")
            expect(use_keyword_feeds_deprecated_group_parse).to_equal(true)

    describe "deprecated import keyword":
        # Tests deprecated `import` keyword which should emit deprecation warnings.

        it "warns on import keyword":
            # @req REQ-IMPORT-008
            # @capture(statistics): import-keyword parse and lexer contract retained for review
            step("Parse the deprecated import keyword statement and confirm the lexer models it")
            # Parser should emit: "Deprecated: 'import' keyword"
            # Use 'use' instead
            import std.core
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val lexer_models_deprecated_import = source.contains("KwImport = 28")
            expect(lexer_models_deprecated_import).to_equal(true)

        it "warns on from...import syntax":
            # @req REQ-IMPORT-009
            # @capture(statistics): from-import parse and import-keyword contract retained for review
            step("Parse the deprecated from-import statement and confirm the lexer models the import keyword")
            # Parser should emit: "Deprecated: 'from ... import' syntax"
            # Use 'use module.group' instead
            from std.core import Option
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val import_keyword_feeds_from_import_parse = source.contains("KwImport = 28")
            expect(import_keyword_feeds_from_import_parse).to_equal(true)

    describe "export use statements":
        # Tests export statements with use syntax for re-exporting modules.

        it "parses export use module.item":
            # @req REQ-IMPORT-010
            # @capture(statistics): export-use parse and export-keyword contract retained for review
            step("Re-export a dotted module member and confirm the lexer models the export keyword")
            export use std.core.Option
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val lexer_models_export_keyword = source.contains("KwExport = 26")
            expect(lexer_models_export_keyword).to_equal(true)

        it "parses export use module with group":
            # @req REQ-IMPORT-011
            # @capture(statistics): export-use group parse retained for review
            step("Re-export a brace group of members and confirm the lexer models the export keyword")
            export use std.core.{Option, Result}
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val export_keyword_feeds_group_reexport_parse = source.contains("KwExport = 26")
            expect(export_keyword_feeds_group_reexport_parse).to_equal(true)

        it "warns on export use module", tag: "deprecation":
            # @req REQ-IMPORT-012
            # @capture(statistics): whole-module export-use parse retained for review
            step("Re-export a whole module and confirm the lexer models the export keyword")
            # Parser should emit: "Avoid 'export use *' - exposes unnecessary interfaces"
            # Use explicit exports instead
            export use std.core
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val export_keyword_feeds_wildcard_reexport_parse = source.contains("KwExport = 26")
            expect(export_keyword_feeds_wildcard_reexport_parse).to_equal(true)

        it "parses export A, B from module":
            # @req REQ-IMPORT-013
            # @capture(statistics): export-from list parse retained for review
            step("Export two named members from a module and confirm the lexer models the export keyword")
            export Option, Result from std.core
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val export_keyword_feeds_named_from_parse = source.contains("KwExport = 26")
            expect(export_keyword_feeds_named_from_parse).to_equal(true)

        it "parses export group from module":
            # @req REQ-IMPORT-014
            # @capture(statistics): export brace-group-from parse retained for review
            step("Export a brace group from a module and confirm the lexer models the export keyword")
            export { Option, Result } from std.core
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val export_keyword_feeds_group_from_parse = source.contains("KwExport = 26")
            expect(export_keyword_feeds_group_from_parse).to_equal(true)

    describe "common use statements":
        # Tests `common use` syntax for importing from shared module namespaces.

        it "parses common use module.item":
            # @req REQ-IMPORT-015
            # @capture(statistics): common-use member parse retained for review
            step("Common-import a dotted module member and confirm the lexer models the use keyword")
            common use std.core.Option
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val use_keyword_feeds_common_member_parse = source.contains("KwUse = 27")
            expect(use_keyword_feeds_common_member_parse).to_equal(true)

        it "parses common use module with group":
            # @req REQ-IMPORT-016
            # @capture(statistics): common-use group parse retained for review
            step("Common-import a brace group and confirm the lexer models the use keyword")
            common use std.core.{Option, Result}
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val use_keyword_feeds_common_group_parse = source.contains("KwUse = 27")
            expect(use_keyword_feeds_common_group_parse).to_equal(true)

    describe "relative imports":
        # Tests relative import syntax using .. notation.

        it "parses import .. as parent":
            # @req REQ-IMPORT-017
            # @capture(statistics): parent-relative import parse retained for review
            step("Import the parent namespace relatively and confirm the lexer models the import keyword")
            import .. as parent
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val import_keyword_feeds_parent_relative_parse = source.contains("KwImport = 28")
            expect(import_keyword_feeds_parent_relative_parse).to_equal(true)

        it "parses import ..sibling":
            # @req REQ-IMPORT-018
            # @capture(statistics): sibling-relative import parse retained for review
            step("Import a sibling namespace relatively and confirm the lexer models the import keyword")
            import ..sibling
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val import_keyword_feeds_sibling_relative_parse = source.contains("KwImport = 28")
            expect(import_keyword_feeds_sibling_relative_parse).to_equal(true)

    describe "module path with keywords":
        # Tests that reserved keywords are allowed as module path segments.

        it "allows async in path":
            # @req REQ-IMPORT-019
            # @capture(statistics): async-keyword module path resolution retained for review
            step("Resolve a module path carrying the async keyword segment")
            use host.async_nogc_mut.io
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val lexer_models_async_keyword = source.contains("KwAsync = 53")
            expect(lexer_models_async_keyword).to_equal(true)

        it "allows sync in path":
            # @req REQ-IMPORT-020
            # @capture(statistics): sync-keyword module path resolution retained for review
            step("Resolve a module path carrying the sync keyword segment")
            use host.sync_nogc_mut.io
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val lexer_models_use_keyword_for_sync_path = source.contains("KwUse = 27")
            expect(lexer_models_use_keyword_for_sync_path).to_equal(true)

        it "allows test in path":
            # @req REQ-IMPORT-021
            # @capture(statistics): test-keyword module path resolution retained for review
            step("Resolve a module path carrying the test keyword segment")
            use std.test.helpers
            val source = file_read("src/compiler/frontend/core/lexer_types.spl")
            val lexer_models_use_keyword_for_test_path = source.contains("KwUse = 27")
            expect(lexer_models_use_keyword_for_test_path).to_equal(true)
