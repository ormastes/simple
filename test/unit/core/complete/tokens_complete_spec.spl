# @req: REQ-CORE-COMPLETE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/core/complete/tokens_complete_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

# @req: REQ-LIB-LIB_GENERIC-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/lib_generic_behavior.md
# doc-path: doc/03_plan/sys_test/lib_generic_behavior.md
# doc-path: doc/04_architecture/lib/lib_generic.md
# doc-path: doc/05_design/lib/lib_generic_oracles.md
# @manual: primary

use std.spec
use std.common.convert.{safe_parse_int, i64_to_text}
use std.hash.adler32.{adler32}
use std.spec.step

# doc-path: doc/01_research/local/tokens_complete.md
# doc-path: doc/03_plan/sys_test/tokens_complete.md
# doc-path: doc/04_architecture/tokens_complete.md
# doc-path: doc/05_design/tokens_complete.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "integer conversion helpers":
        step("Verify: integer conversion helpers")
        # @req: REQ-CORE-COMPLETE-001
        # @req: REQ-LIB-LIB_GENERIC-001
        expect(42.to_text()).to_equal("42")
        expect("42".parse_int()).to_equal(42)  # oracle: decimal parse

    it "truncating division and signed remainder":
        step("Verify: truncating division and signed remainder")
        # @req: REQ-CORE-COMPLETE-001
        expect(7 / 2).to_equal(3)  # oracle: i64 division truncates toward zero
        expect(-7 / 2).to_equal(-3)  # oracle: truncation is toward zero
        expect(7 % 2).to_equal(1)  # oracle: remainder of positive dividend
        expect(-7 % 2).to_equal(-1)  # oracle: remainder keeps dividend sign

    it "base64 RFC 4648 vectors and roundtrip":
        step("Verify: base64 RFC 4648 vectors and roundtrip")
        # @req: REQ-CORE-COMPLETE-001
        use std.common.base_encoding.base64.{base64_encode, base64_decode}
        expect(base64_encode("Man")).to_equal("TWFu")  # oracle: RFC 4648 illustration
        expect(base64_decode("TWFu")).to_equal("Man")
        expect(base64_decode(base64_encode("roundtrip"))).to_equal("roundtrip")

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "string case and strip methods":
        step("Verify: string case and strip methods")
        # @req: REQ-CORE-COMPLETE-001
        expect("AbC".to_lower()).to_equal("abc")
        expect("AbC".to_upper()).to_equal("ABC")
        expect("  x ".trim()).to_equal("x")

    it "numeric comparison helpers":
        step("Verify: numeric comparison helpers")
        # @req: REQ-CORE-COMPLETE-001
        expect(abs(-7)).to_equal(7)  # oracle: absolute value
        expect(max(3, 9)).to_equal(9)  # oracle: larger operand
        expect(min(3, 9)).to_equal(3)  # oracle: smaller operand

    it "array sorting and mapping":
        step("Verify: array sorting and mapping")
        # @req: REQ-CORE-COMPLETE-001
        expect([3, 1, 2].sorted()).to_equal([1, 2, 3])
        expect([1, 2, 3].map(fn(x: i64): x * 2)).to_equal([2, 4, 6])
