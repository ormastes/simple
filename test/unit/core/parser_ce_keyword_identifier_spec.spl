#!/usr/bin/env simple

"""
## Purpose and audience
Verifies the parser ce keyword identifier behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

use std.spec.step
use core.ast.{
    ast_reset, module_get_decls, decl_get_tag, decl_get_name, decl_get_body,
    stmt_get_tag, stmt_get_type, stmt_get_name, stmt_get_expr,
    expr_get_tag, expr_get_left, expr_get_right, expr_get_extra, expr_get_str, expr_get_int,
    elif_get_else, DECL_FN, STMT_IF, STMT_VAL_DECL,
    EXPR_BINARY, EXPR_IDENT, EXPR_INT_LIT, EXPR_IF, EXPR_INDEX
}
use core.parser.{parse_module, parse_module_silent_checked, parser_has_errors}

# @req: REQ-CORE-ParserCeKeywordIdent-001
describe "ce keyword identifier parsing":
    it "rejects function-local val match through the checked entry":
        # @req: REQ-CORE-ParserCeKeywordIdent-001
        step("Verify: rejects function-local val match through the checked entry")
        ast_reset()
        expect(parse_module_silent_checked("fn probe():\n    val match = 1\n", "val_match_reproducer.spl")).to_equal(true)

    it "rejects top-level val match through the declaration parser":
        # @req: REQ-CORE-ParserCeKeywordIdent-001
        step("Verify: rejects top-level val match through the declaration parser")
        ast_reset()
        expect(parse_module_silent_checked("val match = 1\n", "top_level_val_match.spl")).to_equal(true)

    it "preserves accepted contextual match and class bindings":
        # @req: REQ-CORE-ParserCeKeywordIdent-001
        step("Verify: preserves accepted contextual match and class bindings")
        ast_reset()
        expect(parse_module_silent_checked("fn probe():\n    var match = 1\n", "var_match_contextual.spl")).to_equal(false)

        ast_reset()
        expect(parse_module_silent_checked("fn probe():\n    val class = 1\n", "val_class_contextual.spl")).to_equal(false)

    it "preserves rejection of the adjacent case keyword":
        # @req: REQ-CORE-ParserCeKeywordIdent-001
        step("Verify: preserves rejection of the adjacent case keyword")
        ast_reset()
        expect(parse_module_silent_checked("fn probe():\n    val case = 1\n", "val_case_reserved.spl")).to_equal(true)

    it "clears a prior checked-entry failure before the next parse":
        # @req: REQ-CORE-ParserCeKeywordIdent-001
        step("Verify: clears a prior checked-entry failure before the next parse")
        ast_reset()
        expect(parse_module_silent_checked("fn probe():\n    val match = 1\n", "val_match_before_clean.spl")).to_equal(true)

        ast_reset()
        expect(parse_module_silent_checked("fn probe():\n    val ordinary = 1\n", "ordinary_after_error.spl")).to_equal(false)

    it "parses ce comparisons without breaking expression-level ce blocks":
        # @req: REQ-CORE-ParserCeKeywordIdent-001
        step("Verify: parses ce comparisons without breaking expression-level ce blocks")
        val source = "fn classify(x: i64) -> i64:\n" +
            "    if x > 0:\n" +
            "        return 1\n" +
            "    elif x == 0:\n" +
            "        return 2\n" +
            "    else:\n" +
            "        val ce = x\n" +
            "        if ce < 0:\n" +
            "            return ce\n" +
            "        return 0\n" +
            "fn builder_probe() -> i64:\n" +
            "    val value = ce result:\n" +
            "        7\n" +
            "    value\n" +
            "fn inline_chain(basis: i64) -> i64:\n" +
            "    val value = if basis == 0: 30\n" +
            "                elif basis == 3: 31\n" +
            "                else: 32\n" +
            "    value\n" +
            "fn inline_val_chain(x: i64) -> i64:\n" +
            "    val value = if val y = x: y\n" +
            "                else: 0\n" +
            "    value\n" +
            "fn then_chain(level: i64) -> i64:\n" +
            "    val value = if level == 4 then 40 elif level == 5 then 50 else: 60\n" +
            "    value\n" +
            "fn indexed_match() -> i64:\n" +
            "    var match = [10, 20]\n" +
            "    val first = match[0]\n" +
            "    match[0] = 30\n" +
            "    match [first]:\n" +
            "        _:\n" +
            "            return first\n" +
            "fn grouped_arm(name: text) -> i64:\n" +
            "    match name:\n" +
            "        \"A\", \"B\":\n" +
            "            return 1\n" +
            "        case \"C\", \"D\":\n" +
            "            return 2\n" +
            "        _:\n" +
            "            return 0\n"

        ast_reset()
        parse_module(source, "parser_ce_keyword_identifier_spec.spl")
        expect(parser_has_errors()).to_equal(false)

        val decls = module_get_decls()
        expect(decls.len()).to_equal(7)  # oracle: value fixed by the spec contract
        expect(decl_get_tag(decls[0])).to_equal(DECL_FN)
        expect(decl_get_name(decls[1])).to_equal("builder_probe")
        expect(decl_get_name(decls[2])).to_equal("inline_chain")
        expect(decl_get_body(decls[2]).len()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(decl_get_name(decls[3])).to_equal("inline_val_chain")
        expect(decl_get_body(decls[3]).len()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(decl_get_name(decls[4])).to_equal("then_chain")
        val then_expr = stmt_get_expr(decl_get_body(decls[4])[0])
        expect(expr_get_tag(then_expr)).to_equal(EXPR_IF)
        expect(expr_get_tag(expr_get_extra(then_expr))).to_equal(EXPR_IF)
        expect(decl_get_name(decls[5])).to_equal("indexed_match")
        val indexed_expr = stmt_get_expr(decl_get_body(decls[5])[1])
        expect(expr_get_tag(indexed_expr)).to_equal(EXPR_INDEX)
        expect(expr_get_str(expr_get_left(indexed_expr))).to_equal("match")

        val outer = decl_get_body(decls[0])[0]
        val elif_stmt = elif_get_else(stmt_get_type(outer))[0]
        val final_else = elif_get_else(stmt_get_type(elif_stmt))
        expect(stmt_get_tag(final_else[0])).to_equal(STMT_VAL_DECL)
        expect(stmt_get_name(final_else[0])).to_equal("ce")

        val inner = final_else[1]
        expect(stmt_get_tag(inner)).to_equal(STMT_IF)
        val condition = stmt_get_expr(inner)
        expect(expr_get_tag(condition)).to_equal(EXPR_BINARY)
        val left = expr_get_left(condition)
        val right = expr_get_right(condition)
        expect(expr_get_tag(left)).to_equal(EXPR_IDENT)
        expect(expr_get_str(left)).to_equal("ce")
        expect(expr_get_tag(right)).to_equal(EXPR_INT_LIT)
        expect(expr_get_int(right)).to_equal(0)  # oracle: value fixed by the spec contract
