"""
## Purpose and audience
Pins the mode-annotation contract of the test runner: how `# @mode:` and
`# @skip_mode:` comments are extracted from a spec file and how the
extracted tags decide whether a file runs under a given execution mode
(interpreter, native, smf, all-modes). Written for maintainers of the
test-runner mode filter and for authors annotating specs with mode gates.
## Operator workflow
./src/compiler_rust/target/bootstrap/simple run test/01_unit/test_runner/mode_filter_spec.spl
## Compatibility and limitations
Exercises the public std.test_runner.mode_filter surface only; the manifest
scanner lane that feeds it is covered by the integration suites. A
bootstrap-only host without the `run` subcommand cannot execute this file.
## Verification guidance and troubleshooting
A failure names the exact extraction or matching rule that drifted. Rerun
the single scenario and compare the observed tag string or verdict with the
oracle comment on the failing expect line.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/app/testing/in_development_tag.md
# @manual_section: mode-filter

use std.test_runner.mode_filter.{extract_mode_tags, file_mode_matches, file_get_mode_tags}

describe "mode-tag extraction":
    it "returns no tags for a file without annotations":
        # @req REQ-TR-MODEFILTER-001
        # @capture(bit_table): tag extraction of an unannotated fixture
        step("Extract tags from a fixture that carries no mode comments")
        val unannotated_fixture = "# just a comment\ndescribe \"foo\":\n    it \"runs\":\n        step(\"probe\")\n"
        expect(extract_mode_tags(unannotated_fixture)).to_equal("")

    it "extracts a single mode tag":
        # @req REQ-TR-MODEFILTER-002
        # @capture(bit_table): tag extraction of a single-mode fixture
        step("Extract tags from a fixture annotated for one mode")
        val single_mode_fixture = "# @mode: interpreter\ndescribe \"foo\":\n    it \"runs\":\n        step(\"probe\")\n"
        expect(extract_mode_tags(single_mode_fixture)).to_equal("interpreter")

    it "extracts a multi-mode tag":
        # @req REQ-TR-MODEFILTER-003
        # @capture(bit_table): tag extraction of a two-mode fixture
        step("Extract tags from a fixture annotated for two modes")
        val multi_mode_fixture = "# @mode: interpreter, native\ndescribe \"foo\":\n    it \"runs\":\n        step(\"probe\")\n"
        expect(extract_mode_tags(multi_mode_fixture)).to_equal("interpreter,native")

    it "extracts skip_mode as negated":
        # @req REQ-TR-MODEFILTER-004
        # @capture(bit_table): negated tag extraction for skip_mode
        step("Extract tags from a fixture that skips one mode")
        val skip_mode_fixture = "# @skip_mode: native\ndescribe \"foo\":\n    it \"runs\":\n        step(\"probe\")\n"
        expect(extract_mode_tags(skip_mode_fixture)).to_equal("!native")

    it "extracts skip_mode with multiple modes":
        # @req REQ-TR-MODEFILTER-005
        # @capture(bit_table): negated tag extraction for two skip modes
        step("Extract tags from a fixture that skips two modes")
        val multi_skip_fixture = "# @skip_mode: native, smf\ndescribe \"foo\":\n    it \"runs\":\n        step(\"probe\")\n"
        expect(extract_mode_tags(multi_skip_fixture)).to_equal("!native,!smf")

describe "mode verdict matching":
    it "treats untagged files as runnable under every mode":
        # @req REQ-TR-MODEFILTER-006
        # @capture(bit_table): default-allow verdicts for an untagged file
        step("Match an empty tag string against each execution mode")
        expect(file_mode_matches("", "interpreter")).to_equal(true)
        expect(file_mode_matches("", "native")).to_equal(true)
        expect(file_mode_matches("", "smf")).to_equal(true)

    it "always runs a file under the all-modes selector":
        # @req REQ-TR-MODEFILTER-007
        # @capture(bit_table): all-modes override verdicts
        step("Match positive and skip tags against the all-modes selector")
        expect(file_mode_matches("interpreter", "all-modes")).to_equal(true)
        expect(file_mode_matches("!native", "all-modes")).to_equal(true)

    it "matches a positive tag only for its own mode":
        # @req REQ-TR-MODEFILTER-008
        # @capture(bit_table): positive-tag verdict for the matching and foreign modes
        step("Match one positive tag against its own and a foreign mode")
        expect(file_mode_matches("interpreter", "interpreter")).to_equal(true)
        expect(file_mode_matches("interpreter", "native")).to_equal(false)

    it "matches a multi-positive tag under any listed mode":
        # @req REQ-TR-MODEFILTER-009
        # @capture(bit_table): multi-positive verdicts for listed and unlisted modes
        step("Match a two-mode tag string against listed and unlisted modes")
        expect(file_mode_matches("interpreter,native", "interpreter")).to_equal(true)
        expect(file_mode_matches("interpreter,native", "native")).to_equal(true)
        expect(file_mode_matches("interpreter,native", "smf")).to_equal(false)

    it "rejects a mode named by a skip tag":
        # @req REQ-TR-MODEFILTER-010
        # @capture(bit_table): skip-tag exclusion and passthrough verdicts
        step("Match a skip tag against the excluded and surviving modes")
        expect(file_mode_matches("!native", "native")).to_equal(false)
        expect(file_mode_matches("!native", "interpreter")).to_equal(true)
        expect(file_mode_matches("!native", "smf")).to_equal(true)

    it "rejects every mode named by multiple skip tags":
        # @req REQ-TR-MODEFILTER-011
        # @capture(bit_table): multi-skip exclusion verdicts across three modes
        step("Match two skip tags against both excluded and surviving modes")
        expect(file_mode_matches("!native,!smf", "native")).to_equal(false)
        expect(file_mode_matches("!native,!smf", "smf")).to_equal(false)
        expect(file_mode_matches("!native,!smf", "interpreter")).to_equal(true)

describe "tag list projection":
    it "returns an empty tag list for a file without annotations":
        # @req REQ-TR-MODEFILTER-012
        # @capture(statistics): empty tag-list projection for an unannotated file
        step("Project the tag list of an unannotated fixture")
        val unannotated_content = "# nothing here\n"
        val projected_tags = file_get_mode_tags(unannotated_content)
        expect(projected_tags.len()).to_equal(0)  # oracle: no annotation comments means an empty tag list

    it "projects mode annotations into a positive tag list":
        # @req REQ-TR-MODEFILTER-013
        # @capture(statistics): single-tag list projection for one mode annotation
        step("Project the tag list of a single-mode fixture")
        val single_mode_content = "# @mode: interpreter\n"
        val listed_tags = file_get_mode_tags(single_mode_content)
        expect(listed_tags.len()).to_equal(1)  # oracle: exactly one annotation yields exactly one tag
        expect(listed_tags[0]).to_equal("interpreter")

    it "projects skip_mode annotations with the ! prefix":
        # @req REQ-TR-MODEFILTER-014
        # @capture(statistics): negated tag-list projection for a skip annotation
        step("Project the tag list of a skip-mode fixture")
        val skip_mode_content = "# @skip_mode: native\n"
        val skip_tags = file_get_mode_tags(skip_mode_content)
        expect(skip_tags.len()).to_equal(1)  # oracle: exactly one skip annotation yields exactly one negated tag
        expect(skip_tags[0]).to_equal("!native")
