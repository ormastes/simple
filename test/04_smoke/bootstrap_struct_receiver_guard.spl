class BootstrapReceiverGuard:
    value: i64

struct BootstrapCopyGuard:
    value: i64

fn main() -> i64:
    var guard = BootstrapReceiverGuard(value: 1)
    guard.value = 2
    if guard.value != 2:
        print("bootstrap struct receiver guard failed")
        return 1
    val tuple_guard = (11, 22)
    if tuple_guard.1 != 22:
        print("bootstrap tuple receiver guard failed")
        return 2
    val text_guard = "receiver"
    if text_guard.len() != 8:
        print("bootstrap text receiver guard failed")
        return 3
    var original = BootstrapCopyGuard(value: 7)
    var copied = original
    copied.value = 37
    if original.value != 7 or copied.value != 37:
        print("bootstrap aggregate copy receiver guard failed")
        return 4
    print("bootstrap struct receiver guard")
    return 0
