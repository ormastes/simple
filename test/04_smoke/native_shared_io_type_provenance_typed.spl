# Diagnostic typed-local candidate; retain original-form sibling as regression.
enum PacketKind:
    Unknown = 0
    Frozen = 2
    Ack = 3

struct Packet:
    kind: PacketKind

struct Receipt:
    packet: Packet

class Pin:
    value: i64
    static fn open(value: i64) -> Result<Pin, text>:
        if value < 0: return Err("rejected")
        Ok(Pin(value: value))
    fn digest(self) -> Result<[i64], text>:
        Ok([self.value, 7])
    fn close(self) -> bool:
        self.value >= 0

fn windows_value(value: text?) -> bool:
    val payload: text = value ?? ""
    val lowered: text = payload.lower()
    lowered.contains("windows")

fn make_receipt() -> Result<Receipt, text>:
    Ok(Receipt(packet: Packet(kind: PacketKind.Ack)))

fn check_receipt() -> Result<bool, text>:
    val receipt: Receipt = make_receipt()?
    val packet: Packet = receipt.packet
    val kind: PacketKind = packet.kind
    Ok(kind == PacketKind.Ack and kind != PacketKind.Frozen)

fn main() -> i64:
    val opened: Result<Pin, text> = Pin.open(5)
    if opened.is_err(): return 1
    val pin: Pin = opened.unwrap()
    val digest: Result<[i64], text> = pin.digest()
    if digest.is_err(): return 2
    val values: [i64] = digest.unwrap()
    if values.len() != 2 or values[0] != 5 or values[1] != 7: return 3
    if not pin.close(): return 4
    val rejected: Result<Pin, text> = Pin.open(-1)
    if not rejected.is_err(): return 5
    if windows_value(nil) or windows_value("") or windows_value("Linux"): return 6
    if not windows_value("wInDoWs_Nt"): return 7
    val receipt_check: Result<bool, text> = check_receipt()
    if not receipt_check.is_ok() or not receipt_check.unwrap(): return 8
    print("PASS shared-io-type-provenance checks=8")
    0
