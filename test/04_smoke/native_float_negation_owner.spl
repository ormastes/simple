fn negate64(value: f64) -> f64:
    -value

fn negate32(value: f32) -> f32:
    -value

fn check(label: text, condition: bool) -> i64:
    if condition:
        print "PASS {label}"
        return 0
    print "FAIL {label}"
    1

fn main() -> i64:
    val positive_text: text = "7.0"
    val negative_text: text = "-7.0"
    val wide_positive_text: text = "9007199254740991.0"
    val wide_negative_text: text = "-9007199254740991.0"
    val positive: f64 = positive_text.to_float()
    val negative: f64 = negative_text.to_float()
    val wide_positive: f64 = wide_positive_text.to_float()
    val wide_negative: f64 = wide_negative_text.to_float()
    val zero: f64 = 0 as f64
    val one: f64 = 1 as f64
    var failed = 0
    failed = failed + check("dynamic f64 sign", negate64(positive) == negative)
    failed = failed + check("double f64 sign", negate64(negative) == positive)
    failed = failed + check("wide negative sign", negate64(wide_positive) == wide_negative)
    failed = failed + check("wide positive sign", negate64(wide_negative) == wide_positive)
    failed = failed + check("folded cast negative", (-7 as f64) == negative)
    failed = failed + check("negative method conversion", (-7).to_float() == negative)
    val negative_zero: f64 = negate64(zero)
    failed = failed + check("positive zero becomes negative", one / negative_zero < zero)
    failed = failed + check("negative zero becomes positive", one / negate64(negative_zero) > zero)
    failed = failed + check("dynamic f32 sign", negate32(positive as f32) == (negative as f32))
    failed = failed + check("double f32 sign", negate32(negate32(positive as f32)) == (positive as f32))
    val zero32: f32 = zero as f32
    val one32: f32 = one as f32
    val negative_zero32: f32 = negate32(zero32)
    failed = failed + check("f32 positive zero becomes negative", one32 / negative_zero32 < zero32)
    failed = failed + check("f32 negative zero becomes positive", one32 / negate32(negative_zero32) > zero32)
    print "float negation owner: 12 checks, {failed} failures"
    failed
