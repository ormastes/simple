# Expected compile failure: mutability is part of an erased method contract.
struct NativeMutationArgumentProbe:
    value: i64

trait NativeCopyArgumentProbe:
    fn apply_probe_v1(argument: NativeMutationArgumentProbe) -> i64

class NativeMutatingArgumentProbe:
    marker: i64

impl NativeCopyArgumentProbe for NativeMutatingArgumentProbe:
    fn apply_probe_v1(mut argument: NativeMutationArgumentProbe) -> i64:
        argument.value = 99
        argument.value

fn call_copy_argument_probe(owner: NativeCopyArgumentProbe, argument: NativeMutationArgumentProbe) -> i64:
    owner.apply_probe_v1(argument)

fn main() -> i64:
    val argument = NativeMutationArgumentProbe(value: 7)
    call_copy_argument_probe(NativeMutatingArgumentProbe(marker: 1), argument)
