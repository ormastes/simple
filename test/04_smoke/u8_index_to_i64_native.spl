# Repro for BUG-NATIVE-U8-TO-I64-TEXT-DISPATCH-20261017.
# `bytes[i].to_i64()` on a u8 element must widen numerically, not parse text.
# Expected stdout (exactly 2 lines, rc 0):
#   65
#   U8_TO_I64_OK
# Stage3 native: bin/simple native-build --entry test/04_smoke/u8_index_to_i64_native.spl --output build/u8_i64 && build/u8_i64
val bytes = "A".bytes()
val widened = bytes[0].to_i64()
print "{widened}"
if widened == 65:
    print "U8_TO_I64_OK"
else:
    print "U8_TO_I64_FAIL"
