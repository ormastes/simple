# Focused native reproducer for methods called through a trait value.
trait Item5ParserProbeV1:
    fn parse_probe_v1(value: i64) -> i64
    fn close_probe_v1() -> i64

class Item5ParserProbeImplV1 with Item5ParserProbeV1:
    fn parse_probe_v1(value: i64) -> i64:
        value + 1

    fn close_probe_v1() -> i64:
        7

fn parse_through_trait(parser: Item5ParserProbeV1, value: i64) -> i64:
    parser.parse_probe_v1(value)

fn close_through_trait(parser: Item5ParserProbeV1) -> i64:
    parser.close_probe_v1()

fn main() -> i32:
    val parser = Item5ParserProbeImplV1()
    if parse_through_trait(parser, 41) != 42: return 1
    if close_through_trait(parser) != 7: return 2
    println("HTTP_PARSER_TRAIT_DISPATCH_NATIVE_PASS")
    0
