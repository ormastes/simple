struct ReceiverCounter:
    value: i64

impl ReceiverCounter:
    me insert(delta: i64):
        self.value = self.value + delta
    fn get() -> i64:
        self.value

fn check_text(values: [text]) -> bool:
    val first: text = values[0]
    val second: text = first
    (second.byte_at(0) as i64) == 195 and (second.byte_at(1) as i64) == 169

fn check_owner(values: [ReceiverCounter]) -> bool:
    val first: ReceiverCounter = values[0]
    var second: ReceiverCounter = first
    second.insert(3)
    second.get() == 10 and first.get() == 7

fn main() -> i64:
    if not check_text(["é"]): return 1
    if not check_owner([ReceiverCounter(value: 7)]): return 2
    val nested: [[text]] = [["alpha", "beta"]]
    val selected: [text] = nested[0]
    val rebound: [text] = selected
    if rebound.len() != 2: return 3
    if rebound[1] != "beta": return 4
    print "PASS early-let-receiver-metadata checks=4"
    0
