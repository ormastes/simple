# Exact typed-parameter projection shape from process_ops acknowledge guards.
enum ReceiptKind:
    Unknown = 0
    Frozen = 2
    Ack = 3
    CleanupFrozen = 4

struct Packet:
    kind: ReceiptKind
    values: [i64]

struct Receipt:
    packet: Packet
    acknowledged: bool

fn accepts_frozen(receipt: Receipt) -> bool:
    not receipt.acknowledged and receipt.packet.kind == ReceiptKind.Frozen

fn rejects_other_kind(receipt: Receipt) -> bool:
    receipt.packet.kind != ReceiptKind.Frozen

fn array_neighbor(receipt: Receipt) -> bool:
    receipt.packet.values.len() == 2 and receipt.packet.values[1] == 9

fn main() -> i64:
    val frozen = Receipt(packet: Packet(kind: ReceiptKind.Frozen, values: [7, 9]), acknowledged: false)
    val ack = Receipt(packet: Packet(kind: ReceiptKind.Ack, values: [7, 9]), acknowledged: true)
    val cleanup = Receipt(packet: Packet(kind: ReceiptKind.CleanupFrozen, values: [7, 9]), acknowledged: false)
    if not accepts_frozen(frozen): return 1
    if accepts_frozen(ack): return 2
    if accepts_frozen(cleanup): return 3
    if rejects_other_kind(frozen): return 4
    if not rejects_other_kind(ack) or not rejects_other_kind(cleanup): return 5
    if not array_neighbor(frozen): return 6
    print("PASS named-enum-parameter-projection checks=6")
    0
