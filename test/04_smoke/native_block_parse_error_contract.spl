use compiler.blocks.definition.{BlockDefinition}
use compiler.blocks.context.{BlockContext, BlockError, blockerror_parse}
use compiler.blocks.value.{BlockValue}
use compiler.blocks.testing.{mock_block}
use compiler.common.diagnostics.span.{Span}

# The body need not construct a context: callers must supply the real type.
# This fixture exercises the same trait result/Err field boundary as test_parse.
fn error_message(block: BlockDefinition, ctx: BlockContext) -> text:
    match block.parse_payload("bad", ctx):
        case Ok(_): "unexpected success"
        case Err(error): error.message

fn parse_probe(payload: text) -> Result<BlockValue, text>:
    if payload == "bad": return Err("bad payload")
    Ok(BlockValue.Raw(payload))

fn main() -> i64:
    val ctx = BlockContext(source: "accepted", block_kind: "probe",
        span: Span.empty(), payload_span: Span.empty())
    val block = mock_block("probe", parse_probe)
    if error_message(block, ctx) != "bad payload": return 1
    match block.parse_payload("accepted", ctx):
        case Ok(value):
            match value:
                case Raw(text):
                    if text != "accepted": return 2
                case _: return 3
        case Err(_): return 4
    print "BLOCK_PARSE_ERROR_CONTRACT_PASS checks=2"
    0
