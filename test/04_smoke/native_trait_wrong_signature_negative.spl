# Expected compile failure: vtable slots cannot erase a mismatched result ABI.
trait NativeTextResultProbe:
    fn result_probe_v1() -> text

class NativeIntegerResultProbe:
    value: i64

impl NativeTextResultProbe for NativeIntegerResultProbe:
    fn result_probe_v1() -> i64:
        self.value

fn call_text_result_probe(value: NativeTextResultProbe) -> text:
    value.result_probe_v1()

fn main() -> i64:
    val result = call_text_result_probe(NativeIntegerResultProbe(value: 9))
    print result
    0
