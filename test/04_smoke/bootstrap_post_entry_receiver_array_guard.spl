class BootstrapPostEntryGuard:
    value: i64

fn update_guard(guard: BootstrapPostEntryGuard, values: [i64]) -> i64:
    var local_values = values
    local_values[0] = local_values[0] + 1
    guard.value = guard.value + local_values[0]
    guard.value

fn main() -> i64:
    var guard = BootstrapPostEntryGuard(value: 1)
    val values: [i64] = [2]
    val result = update_guard(guard, values)
    if result != 4:
        print("bootstrap post-entry receiver array guard failed")
        return 1
    print("bootstrap post-entry receiver array guard")
    return 0
