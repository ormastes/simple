# Native-only: if-val must retain the declared trait, not a method-name guess.
trait OptionalOwnerProbe:
    fn read_optional_probe() -> i64

class OptionalAddProbe:
    value: i64

impl OptionalOwnerProbe for OptionalAddProbe:
    fn read_optional_probe() -> i64:
        self.value + 10

class OptionalMultiplyProbe:
    value: i64

impl OptionalOwnerProbe for OptionalMultiplyProbe:
    fn read_optional_probe() -> i64:
        self.value * 10

class OptionalHolderProbe:
    item: OptionalOwnerProbe?

fn read_optional_owner(owner: OptionalOwnerProbe?) -> i64:
    if val present = owner:
        return present.read_optional_probe()
    -1

fn main() -> i64:
    val first = OptionalHolderProbe(item: OptionalAddProbe(value: 3))
    val second = OptionalHolderProbe(item: OptionalMultiplyProbe(value: 3))
    val empty = OptionalHolderProbe(item: nil)
    if read_optional_owner(first.item) != 13: return 1
    if read_optional_owner(second.item) != 30: return 2
    if read_optional_owner(empty.item) != -1: return 3
    if val present = first.item:
        if present.read_optional_probe() != 13: return 4
    else:
        return 5
    if val absent = empty.item:
        return 6
    print "PASS native trait optional owner checks=5"
    0
