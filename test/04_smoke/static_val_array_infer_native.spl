# Repro for BUG-X86-EVEX-STATIC-ARRAY-INFERENCE-20261017.
# A top-level typed `[i64]` array literal built from top-level `val` constants
# must be inferable (producer0015 failed "cannot infer register id array").
# Expected stdout (2 lines, rc 0):
#   4
#   STATIC_ARRAY_OK
# Stage3 native: bin/simple native-build --entry test/04_smoke/static_val_array_infer_native.spl --output build/static_arr && build/static_arr
val R0 = 0
val R1 = 1
val R2 = 2
val R3 = 3
val ALLOC: [i64] = [R0, R1, R2, R3]
print "{ALLOC.len()}"
if ALLOC[3] == 3:
    print "STATIC_ARRAY_OK"
else:
    print "STATIC_ARRAY_FAIL"
