struct Flags:
    absent: bool
    present: bool

fn identity(value: bool) -> bool:
    value

fn choose(value: bool) -> i64:
    if value: 7 else: 3

fn check(label: text, value: bool) -> i64:
    if value:
        print("PASS " + label)
        return 0
    print("FAIL " + label)
    1

fn main() -> i64:
    var failures = 0
    val fields = Flags(false, true)
    failures = failures + check("return-false", identity(false) == false)
    failures = failures + check("return-true", identity(true) == true)
    failures = failures + check("field-false", fields.absent == false)
    failures = failures + check("field-true", fields.present == true)
    failures = failures + check("false-branch", choose(false) == 3)
    failures = failures + check("true-branch", choose(true) == 7)
    failures = failures + check("not-false", (not identity(false)) == true)
    failures = failures + check("not-true", (not identity(true)) == false)
    failures = failures + check("equal-bool", identity(true) == fields.present)
    failures = failures + check("unequal-bool", identity(false) != fields.present)
    print("basic-bool-cases=10 failures=" + str(failures))
    if failures == 0: 0 else: 42
