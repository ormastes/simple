use std.spec.*

struct Phase2HelloBuildReceipt:
    code: i64
    label: text

describe "Phase2 Hello struct build", :
    it "constructs a record and reads both fields", :
        val receipt = Phase2HelloBuildReceipt(code: 8, label: "ready")
        print "phase2 hello struct: ready"
        expect(receipt.code).to_equal(8)
        expect(receipt.label).to_equal("ready")
