struct RecordLeft:
    value: i64

impl RecordLeft:
    fn get() -> i64:
        self.value

struct RecordRight:
    value: i64

impl RecordRight:
    fn get() -> i64:
        self.value + 100

fn left_value(values: [RecordLeft]) -> i64:
    val record: RecordLeft = values[0]
    record.get()

fn right_value(values: [RecordRight]) -> i64:
    val record: RecordRight = values[0]
    record.get()

fn main() -> i64:
    if left_value([RecordLeft(value: 7)]) != 7: return 1
    if right_value([RecordRight(value: 7)]) != 107: return 2
    val maybe: RecordLeft? = Some(RecordLeft(value: 9))
    val selected: RecordLeft = maybe ?? RecordLeft(value: 0)
    if selected.get() != 9: return 3
    print "PASS declared-record-method-recovery checks=3"
    0
