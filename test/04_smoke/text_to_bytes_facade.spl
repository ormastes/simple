use std.common.base_encoding.{text_to_bytes}

fn main() -> i32:
    val empty = text_to_bytes("")
    if empty.len() != 0: return 1
    val ascii = text_to_bytes("HTTP\r\n")
    if ascii.len() != 6: return 2
    if ascii[0] != 72u8 or ascii[3] != 80u8 or ascii[4] != 13u8 or ascii[5] != 10u8: return 3
    val unicode_bytes = text_to_bytes("é한😀")
    val expected: [u8] = [195u8, 169u8, 237u8, 149u8, 156u8, 240u8, 159u8, 152u8, 128u8]
    if unicode_bytes.len() != expected.len(): return 4
    var index = 0
    while index < expected.len():
        if unicode_bytes[index] != expected[index]: return 5
        index = index + 1
    val embedded_zero = text_to_bytes("a\0b")
    if embedded_zero.len() != 3: return 6
    if embedded_zero[0] != 97u8 or embedded_zero[1] != 0u8 or embedded_zero[2] != 98u8: return 7
    println("TEXT_TO_BYTES_FACADE_PASS empty=1 ascii=1 utf8=1 nul=1")
    0
