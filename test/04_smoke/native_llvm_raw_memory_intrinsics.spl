# Exercise byte addressing independently of host endianness.
use std.nogc_sync_mut.ptr.raw.{rt_alloc, rt_free}

extern fn spl_load_i64(ptr: i64, offset: i64) -> i64
extern fn spl_store_i64(ptr: i64, offset: i64, value: i64)
extern fn spl_load_u8(ptr: i64, offset: i64) -> i64
extern fn spl_store_u8(ptr: i64, offset: i64, value: i64)

fn main() -> i64:
    val base = rt_alloc(16)
    if base == 0:
        return 1
    var result = 0
    unsafe(capabilities: [ffi, raw_ptr]):
        spl_store_u8(base, 0, 511)
        spl_store_u8(base, 9, 384)
        spl_store_i64(base, 1, -123456789)
        if spl_load_i64(base + 3, -2) != -123456789:
            result = 2
        if spl_load_u8(base, 0) != 255 or spl_load_u8(base, 9) != 128:
            result = 3
    rt_free(base)
    if result == 0:
        print("PASS native_llvm_raw_memory_intrinsics")
    return result
