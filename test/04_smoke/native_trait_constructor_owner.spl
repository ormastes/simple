# Native-only constructor identity regression. Two implementations, three
# erasure boundaries; expected values must come from distinct concrete methods.
trait ConstructorOwnerProbe:
    fn read_probe() -> i64

class ConstructorAddProbe:
    value: i64

impl ConstructorOwnerProbe for ConstructorAddProbe:
    fn read_probe() -> i64:
        self.value + 10

class ConstructorMultiplyProbe:
    value: i64

impl ConstructorOwnerProbe for ConstructorMultiplyProbe:
    fn read_probe() -> i64:
        self.value * 10

class ConstructorHolderProbe:
    item: ConstructorOwnerProbe

fn read_constructor_owner(owner: ConstructorOwnerProbe) -> i64:
    owner.read_probe()

fn make_constructor_owner(choice: i64) -> ConstructorOwnerProbe:
    if choice == 0:
        return ConstructorAddProbe(value: 3)
    ConstructorMultiplyProbe(value: 3)

fn main() -> i64:
    if read_constructor_owner(ConstructorAddProbe(value: 3)) != 13: return 1
    if read_constructor_owner(ConstructorMultiplyProbe(value: 3)) != 30: return 2
    if read_constructor_owner(make_constructor_owner(0)) != 13: return 3
    if read_constructor_owner(make_constructor_owner(1)) != 30: return 4
    val first = ConstructorHolderProbe(item: ConstructorAddProbe(value: 3))
    val second = ConstructorHolderProbe(item: ConstructorMultiplyProbe(value: 3))
    if first.item.read_probe() != 13: return 5
    if second.item.read_probe() != 30: return 6
    print "PASS native trait constructor owner checks=6"
    0
