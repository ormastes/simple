# Repro for BUG-X86-EVEX-STATIC-ARRAY-INFERENCE-20261017 (the real bug, not the
# workaround): a top-level array literal built from top-level `val` integer
# constants, with NO `[i64]` annotation, must infer as [i64] in MIR
# (producer0015 reported "unresolved module-static initializer type").
# Mirrors evex_encoding.spl X86_ZMM_ALLOCATABLE / X86_K_ALLOCATABLE.
# Expected stdout (rc 0):
#   4
#   3
#   STATIC_ARRAY_UNANNOTATED_OK
val Z0 = 48
val Z1 = 49
val Z2 = 64
val Z3 = 79
val K1 = 81
val K7 = 87
val ZALLOC = [Z0, Z1, Z2, Z3]
val KALLOC = [K1, 84, K7]
print "{ZALLOC.len()}"
print "{KALLOC.len()}"
if ZALLOC[0] == 48 and ZALLOC[3] == 79 and KALLOC[2] == 87 and ZALLOC[2] + KALLOC[0] == 145:
    print "STATIC_ARRAY_UNANNOTATED_OK"
else:
    print "STATIC_ARRAY_UNANNOTATED_FAIL"
