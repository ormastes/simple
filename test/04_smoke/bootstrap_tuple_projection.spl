@unsafe(reason: "borrow enum and tuple payloads for compiler generation diagnosis", capabilities: [ffi])
extern fn rt_enum_payload<T>(value: T) -> i64
@unsafe(reason: "inspect payload tuple arity", capabilities: [ffi])
extern fn rt_tuple_len(tuple: i64) -> i64
@unsafe(reason: "tuple-return extern spelling under comparison", capabilities: [ffi])
extern fn rt_tuple_get<T>(tuple: i64, index: i64) -> T?

struct PayloadProbe:
    value: i64

enum PayloadCase:
    Values([i64], PayloadProbe?)
    ScalarPair(i64, i64)

fn payload_get<T>(tuple: i64, index: i64) -> T?:
    unsafe(capabilities: [ffi]):
        rt_tuple_get<T>(tuple, index)

@unsafe(reason: "native tuple payload compiler generation diagnosis", capabilities: [ffi])
fn main():
    val payload_case = PayloadCase.Values([7, 9], Some(PayloadProbe(value: 11)))
    val tuple = rt_enum_payload(payload_case)
    val array_payload_opt: [i64]? = payload_get<[i64]>(tuple, 0)
    val array_payload: [i64] = array_payload_opt ?? []
    val array_len = array_payload.len()
    val array0 = array_payload[0]
    val array1 = array_payload[1]
    val struct_payload_opt: PayloadProbe? = payload_get<PayloadProbe>(tuple, 1)
    val struct_nil = struct_payload_opt == nil
    val struct_payload: PayloadProbe = struct_payload_opt ?? PayloadProbe(value: -1)
    val struct_value = struct_payload.value

    val nil_case = PayloadCase.Values([7, 9], nil)
    val nil_tuple = rt_enum_payload(nil_case)
    val nil_payload: PayloadProbe? = payload_get<PayloadProbe>(nil_tuple, 1)
    val nil_is_nil = nil_payload == nil

    val scalar_case = PayloadCase.ScalarPair(23, 29)
    val scalar_tuple = rt_enum_payload(scalar_case)
    val first_scalar_opt: i64? = payload_get<i64>(scalar_tuple, 0)
    val second_scalar_opt: i64? = payload_get<i64>(scalar_tuple, 1)
    val first_scalar = first_scalar_opt ?? -1
    val second_scalar = second_scalar_opt ?? -1

    val out_of_range_opt: i64? = payload_get<i64>(tuple, 2)
    val out_of_range_is_nil = out_of_range_opt == nil

    print "fixture=array_and_struct array_len={array_len} array0={array0} array1={array1} struct_nil={struct_nil} struct_value={struct_value}"
    print "fixture=nil_optional nil_is_nil={nil_is_nil}"
    print "fixture=scalar_pair first={first_scalar} second={second_scalar}"
    print "fixture=out_of_range is_nil={out_of_range_is_nil}"
