# The Stage-2 LLVM receiver admission fixture deliberately uses immutable `fn`
# methods with zero and one explicit argument.  Both field reads must cross the
# checked Struct receiver lowering path; `self` is the implicit receiver.
struct BootstrapLlvmReceiverGuard:
    value: i64

# This must lower through global_init_structs / __module_init before main.
val bootstrap_llvm_global_receiver = BootstrapLlvmReceiverGuard(value: 40)

impl BootstrapLlvmReceiverGuard:
    fn zero(self) -> i64:
        self.value

    fn plus(self, amount: i64) -> i64:
        self.value + amount

fn main() -> i64:
    val receiver = bootstrap_llvm_global_receiver
    val total = receiver.zero() + receiver.plus(2)
    if total != 82:
        print("bootstrap llvm struct receiver guard failed")
        return 1
    print("bootstrap llvm struct receiver guard")
    0
