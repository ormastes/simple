use runtime.simple_core.core_memory.{rt_allocation_owner_identity_v1}
use runtime.simple_core.core_string.{rt_string_new, rt_string_data, rt_string_starts_with, rt_string_free}
use std.nogc_sync_mut.ptr.raw.{rt_alloc, rt_free, rt_ptr_write_u8}

fn main() -> i64:
    if rt_allocation_owner_identity_v1() != 0:
        return 1
    val raw = rt_alloc(4)
    if raw == 0:
        return 2
    rt_ptr_write_u8(raw, 0, 97)
    rt_ptr_write_u8(raw, 1, 0)
    rt_ptr_write_u8(raw, 2, 98)
    rt_ptr_write_u8(raw, 3, 0)
    val counted = rt_string_new(raw, 3)
    val borrow = rt_string_data(counted)
    val one = rt_string_new(raw, 1)
    val empty = rt_string_new(raw, 0)
    val success =
        rt_string_starts_with(raw, one) == 1 and
        rt_string_starts_with(counted, raw) == 1 and
        rt_string_starts_with(borrow, counted) == 1 and
        rt_string_starts_with(raw, borrow) == 0 and
        rt_string_starts_with(raw, empty) == 1 and
        rt_string_starts_with(3, empty) == 0
    rt_string_free(empty)
    rt_string_free(one)
    rt_string_free(counted)
    rt_free(raw)
    if not success:
        return 3
    print("PASS simple_core_string_starts_with_owner")
    0
