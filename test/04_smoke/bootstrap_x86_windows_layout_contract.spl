# Diagnostic host-native entry for the same explicit target-layout contract.
# Running this proves the host compiler executes the layout algorithms; it does
# not execute a Windows executable or qualify a cross-target ABI end to end.
use test.fixtures.compiler.x86_windows_layout_contract.{x86_windows_layout_c_contract, x86_windows_layout_policy_contract, x86_windows_layout_datalayout_contract, x86_windows_layout_rejects_unknown, x86_windows_layout_alias_bitfield_contract}

fn main():
    assert(x86_windows_layout_c_contract())
    assert(x86_windows_layout_policy_contract())
    assert(x86_windows_layout_datalayout_contract())
    assert(x86_windows_layout_rejects_unknown())
    assert(x86_windows_layout_alias_bitfield_contract())
    print "x86-windows-layout-contract-ok"
