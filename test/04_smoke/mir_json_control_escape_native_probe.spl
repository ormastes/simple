# Bootstrap diagnostic fixture; importing the real MIR owner retains its context.
use compiler.mir.mir_json.{escape_json_string}

@unsafe(reason: "control-byte fixture construction; contract: scalar code becomes UTF-8 text, invalid codes return empty text", capabilities: [ffi])
extern fn rt_char_from_code(code: i64) -> text

fn main() -> i64:
    val expected = ["\\u0000", "\\u0001", "\\u0002", "\\u0003", "\\u0004", "\\u0005", "\\u0006", "\\u0007",
        "\\u0008", "\\t", "\\n", "\\u000b", "\\u000c", "\\r", "\\u000e", "\\u000f",
        "\\u0010", "\\u0011", "\\u0012", "\\u0013", "\\u0014", "\\u0015", "\\u0016", "\\u0017",
        "\\u0018", "\\u0019", "\\u001a", "\\u001b", "\\u001c", "\\u001d", "\\u001e", "\\u001f"]
    var failures = 0
    var code = 0
    while code < 32:
        val control = unsafe(capabilities: [ffi]):
            rt_char_from_code(code)
        if escape_json_string(control) != expected[code]: failures = failures + 1
        code = code + 1
    if escape_json_string("\"\\") != "\\\"\\\\": failures = failures + 1
    if escape_json_string("") != "": failures = failures + 1
    if escape_json_string("é한") != "é한": failures = failures + 1
    if escape_json_string("a/b") != "a/b": failures = failures + 1
    print("MIR JSON escaping: 36 checks, " + str(failures) + " failures")
    if failures == 0: 0 else: 1
