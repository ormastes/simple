# Native compile/run oracle: explicit owners may share variant names.
class Lease:
    slot: i64

class ShadowOwner:
    fn Started(number: i64) -> i64:
        number + 1

enum FirstAdmission:
    Ready
    Unknown(reason: text)
    Started(number: i64)
    Pair(number: i64, label: text)
    Owned(lease: Lease)

enum SecondAdmission:
    Ready
    Unknown(reason: text)
    Started(number: i64)

fn first_value(value: FirstAdmission) -> i64:
    match value:
        case FirstAdmission.Ready: 10
        case FirstAdmission.Unknown(reason): if reason == "first": 20 else: -20
        case FirstAdmission.Started(number): number
        case FirstAdmission.Pair(number, label): if label == "pair": number else: -40
        case FirstAdmission.Owned(lease): lease.slot

fn second_value(value: SecondAdmission) -> i64:
    match value:
        case SecondAdmission.Ready: 50
        case SecondAdmission.Unknown(reason): if reason == "second": 60 else: -60
        case SecondAdmission.Started(number): number

fn main() -> i64:
    var failed = 0
    if first_value(FirstAdmission.Ready()) != 10: failed = failed + 1
    if first_value(FirstAdmission.Unknown("first")) != 20: failed = failed + 1
    if first_value(FirstAdmission.Started(30)) != 30: failed = failed + 1
    if first_value(FirstAdmission.Pair(40, "pair")) != 40: failed = failed + 1
    if second_value(SecondAdmission.Ready()) != 50: failed = failed + 1
    if second_value(SecondAdmission.Unknown("second")) != 60: failed = failed + 1
    if second_value(SecondAdmission.Started(70)) != 70: failed = failed + 1
    if first_value(FirstAdmission.Owned(Lease(slot: 80))) != 80: failed = failed + 1
    val FirstAdmission = ShadowOwner()
    if FirstAdmission.Started(89) != 90: failed = failed + 1
    print "checks=9 failures={failed}"
    failed
