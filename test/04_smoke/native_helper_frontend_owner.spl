use compiler.frontend.core.flat_pool_codec.{FlatPoolReader, flat_pool_dec_i64}
use compiler.frontend.desugar.placeholder_lambda.{parse_placeholder_number}

fn main() -> i64:
    val valid = FlatPoolReader.new_canonical("2\n7\n31\n")
    val values = flat_pool_dec_i64(valid)
    if values.len() != 2 or values[0] != 7 or values[1] != 31: return 1
    if not valid.finish_canonical_frame(): return 2
    val invalid = FlatPoolReader.new_canonical("1\n7")
    if invalid.ok or invalid.failure_kind != "malformed": return 3
    if invalid.failure_detail != "missing_final_newline": return 4
    if valid.pos == invalid.pos: return 5
    if parse_placeholder_number("_109") != 109: return 6
    if parse_placeholder_number("_9") != 9: return 7
    if parse_placeholder_number("_01") != -1: return 8
    if parse_placeholder_number("_pp") != -1: return 9
    if parse_placeholder_number("_９") != -1: return 10
    0
