# Regression: optional trait fields already contain an Option handle. Copying
# them must preserve None and the selected implementation's dispatch table.
trait AssignmentReader:
    fn read_assignment() -> i64

class AssignmentAdd:
    value: i64

impl AssignmentReader for AssignmentAdd:
    fn read_assignment() -> i64:
        self.value + 10

class AssignmentMultiply:
    value: i64

impl AssignmentReader for AssignmentMultiply:
    fn read_assignment() -> i64:
        self.value * 10

class AssignmentHolder:
    reader: AssignmentReader?

impl AssignmentHolder:
    me replace_from(source: AssignmentHolder):
        self.reader = source.reader

fn assignment_read(source: AssignmentHolder) -> i64:
    if val reader = source.reader:
        return reader.read_assignment()
    -1

fn main() -> i64:
    val add = AssignmentHolder(reader: AssignmentAdd(value: 3))
    val multiply = AssignmentHolder(reader: AssignmentMultiply(value: 3))
    val empty = AssignmentHolder(reader: nil)
    var target = AssignmentHolder(reader: nil)
    target.replace_from(add)
    if assignment_read(target) != 13: return 1
    target.replace_from(multiply)
    if assignment_read(target) != 30: return 2
    target.replace_from(empty)
    if assignment_read(target) != -1: return 3
    target.replace_from(add)
    if assignment_read(target) != 13: return 4
    if assignment_read(add) != 13: return 5
    if assignment_read(multiply) != 30: return 6
    if assignment_read(empty) != -1: return 7
    print "PASS native trait optional field assignment checks=7"
    0
