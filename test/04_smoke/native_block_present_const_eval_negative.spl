use compiler.blocks.definition.{BlockDefinition, ConstValue}
use compiler.blocks.context.{BlockContext, BlockError}
use compiler.blocks.value.{BlockValue}
use compiler.blocks.registry.{register_block, is_block_registered}
use compiler.blocks.testing.{test_no_const_eval}

struct ConstantBlockProbe(BlockDefinition):
    fn kind() -> text: "item5_constant_probe"
    fn parse_payload(payload: text, ctx: BlockContext) -> Result<BlockValue, BlockError>:
        Ok(BlockValue.Raw(payload))
    fn eval_const(value: BlockValue) -> ConstValue?:
        ConstValue.Int(7)

fn main() -> i64:
    if not register_block(ConstantBlockProbe()): return 1
    if not is_block_registered("item5_constant_probe"): return 2
    # Must panic in the production assertion helper with its actual payload.
    test_no_const_eval("item5_constant_probe", BlockValue.Raw("constant"))
    print "BLOCK_PRESENT_CONST_EVAL_UNEXPECTED_RETURN"
    0
