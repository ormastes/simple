struct ConcatPayload:
    number: i64

fn main() -> i64:
    var left: [u8] = [1, 2]
    var right: [u8] = [3]
    val alias = left
    var combined = left.concat(right)
    if left.len() != 2 or right.len() != 1 or alias.len() != 2: return 1
    if combined.len() != 3 or combined[0] != 1 or combined[2] != 3: return 2
    combined[0] = 9
    if left[0] != 1 or alias[0] != 1: return 3
    right[0] = 8
    if combined[2] != 3: return 4
    val empty: [u8] = []
    val chained = empty.concat(left).concat(empty).concat(right)
    if chained.len() != 3 or chained[0] != 1 or chained[2] != 8: return 5
    val texts: [text] = ["left"]
    val text_result = texts.concat(["right"])
    if texts.len() != 1 or text_result.len() != 2: return 6
    if text_result[0] != "left" or text_result[1] != "right": return 7
    val records: [ConcatPayload] = [ConcatPayload(number: 11)]
    val record_result = records.concat([ConcatPayload(number: 22)])
    if records.len() != 1 or record_result.len() != 2: return 8
    if record_result[0].number != 11 or record_result[1].number != 22: return 9
    print "PASS array-concat-runtime"
    0
