# Run from repository root. Both public facades must retain the same inventory.
use std.io_runtime.{dir_walk}
use std.nogc_sync_mut.io.dir_ops.{dir_walk as directory_walk}

fn check_walk(paths: [text]) -> bool:
    if paths.len() != 3: return false
    var first = false
    var nested = false
    var quoted = false
    for path in paths:
        val canonical = path.replace("\\", "/")
        if canonical.ends_with("/first.txt"): first = true
        elif canonical.ends_with("/nested/second.txt"): nested = true
        elif canonical.ends_with("/space ' 한/third.txt"): quoted = true
        else: return false
    first and nested and quoted

fn main() -> i64:
    val root = "test/fixtures/io/phase1_directory_walk"
    if not check_walk(dir_walk(root)): return 1
    if not check_walk(directory_walk(root)): return 2
    if dir_walk(root + "/absent").len() != 0: return 3
    print "PHASE1_DIRECTORY_DISCOVERY checks=3 PASS"
    0
