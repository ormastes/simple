use compiler.backend.linker.msvc_response_file.{msvc_response_quote, msvc_response_body}

fn main() -> i64:
    if msvc_response_quote("") != "\"\"": return 1
    if msvc_response_quote("a\"b") != "\"a\\\"b\"": return 2
    if msvc_response_quote("a\\\"b") != "\"a\\\\\\\"b\"": return 3
    if msvc_response_quote("C:\\space dir\\") != "\"C:\\space dir\\\\\"": return 4
    if msvc_response_body(["one.obj", "two words.obj", "one.obj"]) != "\"one.obj\"\n\"two words.obj\"\n\"one.obj\"\n": return 5
    var args: [text] = ["/dll", "/noentry", "/nodefaultlib", "/export:response_probe", "/out:response output.dll", "response input.obj"]
    var count = 0
    while count < 2000:
        args.push("/include:response_probe")
        count = count + 1
    val body = msvc_response_body(args)
    if body.len() <= 32767: return 6
    print body
    0
