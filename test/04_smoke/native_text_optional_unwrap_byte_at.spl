# Native smoke: `text?`.unwrap() must stay a text for chained text methods.
#
# Regression for stage2_new3_native_build_worker_av_c01_2026-11-07: the Rust
# seed typed `digest_opt.unwrap()` ANY, MIR could not route `.byte_at` to
# rt_string_byte_at, and the LLVM suffix-match fallback bound the call to the
# unrelated same-leaf/same-arity class method below. The rebuilt stage2 AV'd
# (0xC0000005, read at 0x48) in every native-build worker. A pre-fix seed
# exits 139 on this file; expected stdout: PASS text_optional_unwrap_byte_at
class HexReader:
    bytes: [u8]
    cursor: i64 = 0

    fn byte_at(offset: i64) -> i64:
        if offset < 0 or offset >= self.bytes.len(): return -1
        self.bytes[offset].to_i64()

    fn peek() -> i64: self.byte_at(self.cursor)

fn reader_probe() -> i64:
    val reader = HexReader(bytes: [48u8, 49u8], cursor: 1)
    reader.peek()

fn digest_valid(digest_opt: text?) -> bool:
    if digest_opt.is_none(): return false
    val digest = digest_opt.unwrap()
    if digest.len() != 8: return false
    for index in 0..8:
        val byte = digest.byte_at(index) as i64
        if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102)):
            return false
    true

fn main() -> i64:
    if reader_probe() != 49:
        print("FAIL reader")
        return 2
    val good: text? = Some("0123abcd")
    val bad: text? = Some("0123abcx")
    val none: text? = None
    if digest_valid(good) and not digest_valid(bad) and not digest_valid(none):
        print("PASS text_optional_unwrap_byte_at")
        return 0
    print("FAIL text_optional_unwrap_byte_at")
    return 1
