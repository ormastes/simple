use compiler.frontend.effect_registry.{effect_parse_budget, EFFECT_REGISTRY_BUDGET_UNSET}
use compiler.frontend.core._ParserPrimary.asm_match_suffix.{parse_int_text}
use compiler.frontend.core.parser_cli.{parse_cli_option_value}
use compiler.core.parser.{parser_init}
use compiler.core.ast_expr.{expr_i_val}

fn main() -> i64:
    if effect_parse_budget("109") != 109: return 1
    if effect_parse_budget("0") != 0: return 2
    if effect_parse_budget("1x9") != EFFECT_REGISTRY_BUDGET_UNSET: return 3
    if effect_parse_budget("９") != EFFECT_REGISTRY_BUDGET_UNSET: return 4
    if effect_parse_budget("") != EFFECT_REGISTRY_BUDGET_UNSET: return 5
    if parse_int_text("109") != 109: return 6
    if parse_int_text("1x9") != 19: return 7
    if parse_int_text("９") != 0: return 8
    parser_init("123")
    val option = parse_cli_option_value()
    if option.type_char != "i" or option.default_str != "123": return 9
    if expr_i_val[option.default_expr] != 123: return 10
    0
