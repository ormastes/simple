# Run the compiled binary with arguments: plain "two words" "한글"
# Link using core-c-bootstrap: optional rt_cli_* dispatch symbols must not enter.
use std.sffi.cli_args.{cli_arg_count, cli_arg_at, cli_get_args}

fn argv_check(ok: bool, label: text) -> i64:
    if ok:
        return 0
    print "FAIL: {label}"
    1

fn main() -> i64:
    val args = cli_get_args()
    val count = args.len()
    if count < 4:
        print "FAIL: expected executable and three fixture arguments"
        return 1
    var failures = 0
    failures = failures + argv_check(cli_arg_count() == count, "count agrees with array")
    failures = failures + argv_check(cli_arg_at(0) == args[0], "executable argument")
    failures = failures + argv_check(cli_arg_at(-1) == "", "negative index")
    failures = failures + argv_check(cli_arg_at(count) == "", "upper boundary")
    failures = failures + argv_check(cli_arg_at(9223372036854775807) == "", "large index")
    failures = failures + argv_check(cli_arg_at(count - 3) == "plain", "plain argument")
    failures = failures + argv_check(cli_arg_at(count - 2) == "two words", "spaced argument")
    failures = failures + argv_check(cli_arg_at(count - 1) == "한글", "Unicode argument")
    print "CLI args: 8 checks, {failures} failures"
    if failures == 0:
        return 0
    1
