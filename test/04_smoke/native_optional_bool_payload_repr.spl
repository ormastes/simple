# Run with an actual self-hosted native compiler on both LLVM and Cranelift.
# The typed externs select existing runtime providers; no mock presence rule.
extern fn rt_value_bool(value: bool) -> i64
extern fn rt_enum_new(enum_id: i32, discriminant: i32, payload: i64) -> bool?

fn raw_optional(value: bool) -> bool?:
    Some(value)

fn tagged_optional(value: bool) -> bool?:
    rt_enum_new(1, 0, rt_value_bool(value))

fn inspect_value(value: bool?) -> i64:
    if val payload = value:
        return if payload: 19 else: 23
    -17

fn inspect_elif(value: bool?) -> i64:
    if false:
        return -99
    elif val payload = value:
        return if payload: 19 else: 23
    -17

fn inspect_presence(value: bool?) -> i64:
    if value:
        return 1
    0

fn check_case(label: text, actual: i64, expected: i64) -> i64:
    if actual == expected:
        print "PASS {label}"
        return 0
    print "FAIL {label} actual={actual} expected={expected}"
    1

fn main() -> i64:
    var failed = 0
    failed = failed + check_case("raw-false", inspect_value(raw_optional(false)), 23)
    failed = failed + check_case("raw-true", inspect_value(raw_optional(true)), 19)
    failed = failed + check_case("tagged-false", inspect_value(tagged_optional(false)), 23)
    failed = failed + check_case("tagged-true", inspect_value(tagged_optional(true)), 19)
    failed = failed + check_case("absent", inspect_value(nil), -17)
    failed = failed + check_case("elif-false", inspect_elif(tagged_optional(false)), 23)
    failed = failed + check_case("elif-true", inspect_elif(tagged_optional(true)), 19)
    failed = failed + check_case("elif-absent", inspect_elif(nil), -17)
    failed = failed + check_case("raw-false-present", inspect_presence(raw_optional(false)), 1)
    failed = failed + check_case("tagged-false-present", inspect_presence(tagged_optional(false)), 1)
    failed = failed + check_case("nil-absent", inspect_presence(nil), 0)
    print "optional bool payload representations: 11 checks, {failed} failures"
    if failed == 0: 0 else: 1
