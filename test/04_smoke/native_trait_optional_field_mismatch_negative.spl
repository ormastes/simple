# Must fail: an Optional<OtherReader> is not an Optional<WantedReader>, even
# when both traits declare the same method spelling and signature.
trait WantedReader:
    fn read_mismatch() -> i64

trait OtherReader:
    fn read_mismatch() -> i64

class WantedHolder:
    reader: WantedReader?

class OtherHolder:
    reader: OtherReader?

impl WantedHolder:
    me replace_from(source: OtherHolder):
        self.reader = source.reader

fn main() -> i64:
    var target = WantedHolder(reader: nil)
    target.replace_from(OtherHolder(reader: nil))
    0
