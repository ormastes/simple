# Models the parser's ElfSymbol: name is slot6, not slot0.
struct ElfSymbol:
    st_name: i64
    st_info: i64
    st_other: i64
    st_shndx: i64
    st_value: i64
    st_size: i64
    name: text

struct SymbolId:
    name: text

struct NamedSymbol:
    id: SymbolId

fn make_right_elf() -> ElfSymbol:
    ElfSymbol(st_name: 101, st_info: 202, st_other: 303,
        st_shndx: 404, st_value: 505, st_size: 606, name: "right-name")

fn read_right_name(value: ElfSymbol) -> text:
    value.name

fn forward_right(value: ElfSymbol) -> ElfSymbol:
    value

fn right_array() -> [ElfSymbol]:
    [make_right_elf()]

fn make_named_id() -> SymbolId:
    SymbolId(name: "named-id")

fn read_named_id(value: SymbolId) -> text:
    value.name

fn named_symbol() -> NamedSymbol:
    NamedSymbol(id: make_named_id())
