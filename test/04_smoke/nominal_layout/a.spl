# Same nominal names as b.spl, deliberately different owned layouts.
struct ElfSymbol:
    name: text
    sym_bind: i64
    sym_type: i64
    section_index: i64
    value: i64
    size: i64

struct SymbolId:
    id: i64

struct NumericSymbol:
    id: SymbolId

fn make_left_elf() -> ElfSymbol:
    ElfSymbol(name: "left-name", sym_bind: 11, sym_type: 22,
        section_index: 33, value: 44, size: 55)

fn read_left_name(value: ElfSymbol) -> text:
    value.name

fn forward_left(value: ElfSymbol) -> ElfSymbol:
    value

fn left_array() -> [ElfSymbol]:
    [make_left_elf()]

fn make_numeric_id() -> SymbolId:
    SymbolId(id: 733)

fn read_numeric_id(value: SymbolId) -> i64:
    value.id

fn numeric_symbol() -> NumericSymbol:
    NumericSymbol(id: make_numeric_id())
