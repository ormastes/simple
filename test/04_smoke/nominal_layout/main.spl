# Native regression for duplicate nominal names with incompatible layouts.
# Compile main.spl with this directory as a source root; run the resulting exe.
mod a
mod b

fn check(ok: bool, label: text) -> i64:
    if ok:
        print "PASS: {label}"
        return 0
    print "FAIL: {label}"
    1

fn main() -> i64:
    val left = a.make_left_elf()
    val right = b.make_right_elf()
    val left_returned = a.forward_left(left)
    val right_returned = b.forward_right(right)
    val lefts = a.left_array()
    val rights = b.right_array()
    val numeric = a.make_numeric_id()
    val named = b.make_named_id()
    val numeric_nested = a.numeric_symbol()
    val named_nested = b.named_symbol()
    var failures = 0
    failures = failures + check(left.name == "left-name", "left.name slot0")
    failures = failures + check(left.sym_bind == 11, "left binding")
    failures = failures + check(left.sym_type == 22, "left type")
    failures = failures + check(left.section_index == 33, "left section")
    failures = failures + check(left.value == 44, "left value")
    failures = failures + check(left.size == 55, "left size")
    failures = failures + check(right.st_name == 101, "right numeric slot0")
    failures = failures + check(right.st_info == 202, "right info")
    failures = failures + check(right.st_other == 303, "right other")
    failures = failures + check(right.st_shndx == 404, "right section")
    failures = failures + check(right.st_value == 505, "right value")
    failures = failures + check(right.st_size == 606, "right size")
    failures = failures + check(right.name == "right-name", "right.name slot6")
    failures = failures + check(a.read_left_name(left) == "left-name", "left parameter ownership")
    failures = failures + check(b.read_right_name(right) == "right-name", "right parameter ownership")
    failures = failures + check(left_returned.name == "left-name", "left return ownership")
    failures = failures + check(right_returned.name == "right-name", "right return ownership")
    failures = failures + check(lefts[0].name == "left-name", "left array element ownership")
    failures = failures + check(rights[0].name == "right-name", "right array element ownership")
    failures = failures + check(numeric.id == 733, "numeric SymbolId slot0")
    failures = failures + check(named.name == "named-id", "text SymbolId slot0")
    failures = failures + check(a.read_numeric_id(numeric) == 733, "numeric SymbolId parameter")
    failures = failures + check(b.read_named_id(named) == "named-id", "text SymbolId parameter")
    failures = failures + check(numeric_nested.id.id == 733, "numeric nested SymbolId")
    failures = failures + check(named_nested.id.name == "named-id", "text nested SymbolId")
    print "Nominal layout: 25 checks, {failures} failures"
    if failures == 0: return 0
    1
