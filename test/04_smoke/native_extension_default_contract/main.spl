use model.{Probe}
use caller.*
use extension.*

fn main() -> i32:
    val probe = Probe(31)
    var failed = 0
    val explicit = probe.explicit_nil()
    print "explicit nil: {explicit} (expected 31)"
    if explicit != 31:
        failed = failed + 1
    val present = probe.present()
    print "present: {present} (expected 73)"
    if present != 73:
        failed = failed + 1
    val omitted = probe.omitted()
    print "omitted: {omitted} (expected 31)"
    if omitted != 31:
        failed = failed + 1
    print "unimported extension defaults: 3 checks, {failed} failures"
    if failed != 0:
        return 1
    0
