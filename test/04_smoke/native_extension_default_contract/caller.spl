use model.{Probe, Request}

# Deliberately no import of extension: native linkage sees the implementation
# through the project's source closure, while this module's import loader does
# not visit its default-argument declaration.
impl Probe:
    fn omitted() -> i64:
        self.inspect()

    fn explicit_nil() -> i64:
        self.inspect(nil)

    fn present() -> i64:
        self.inspect(Some(Request("present")))
