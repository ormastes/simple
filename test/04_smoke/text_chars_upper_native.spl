# Repro for bootstrap-builder-owner-native-string-methods-2026-09-30 and
# bootstrap_raw_byte_loop_unbox_2026_10_16: text.to_upper and for-in over text
# (codepoint iteration + comparison with a text literal) under native producer.
# Expected stdout (3 lines, rc 0):
#   ABC
#   CTRL_FOUND
#   TEXT_ITER_OK
# Stage3 native: bin/simple native-build --entry test/04_smoke/text_chars_upper_native.spl --output build/text_iter && build/text_iter
val s = "abc"
print s.to_upper()
var found = false
for character in "a\x01b":
    if character < " " or character == "\x7f":
        found = true
if found:
    print "CTRL_FOUND"
var count = 0
for ch in "héy":
    count = count + 1
if count == 3:
    print "TEXT_ITER_OK"
else:
    print "TEXT_ITER_FAIL"
