fn integer(value: i64) -> Result<i64, text>:
    Ok(value)

fn extract(value: i64) -> Result<i64, text>:
    val decoded = integer(value)?
    Ok(decoded)

fn check(label: text, passed: bool) -> i64:
    if passed:
        print("PASS " + label)
        return 0
    print("FAIL " + label)
    1

fn main() -> i64:
    var failures = 0
    failures = failures + check("tiny-signed-unwrap", integer(-17).unwrap() == -17)
    failures = failures + check("tiny-signed-question", extract(-17).unwrap() == -17)
    val wide: i64 = 2305843009213693957
    failures = failures + check("wide-boxed-unwrap", integer(wide).unwrap() == wide)
    failures = failures + check("wide-boxed-question", extract(wide).unwrap() == wide)
    failures = failures + check("negative-wide-boxed", integer(-2305843009213693957).unwrap() == -2305843009213693957)
    print("result-integer-cases=5 failures=" + str(failures))
    if failures == 0: 0 else: 42
