use compiler.blocks.definition.{BlockDefinition, ConstValue}
use compiler.blocks.context.{BlockContext, BlockError}
use compiler.blocks.value.{BlockValue}
use compiler.blocks.registry.{register_block, unregister_block, is_block_registered}
use compiler.blocks.testing.{test_no_const_eval}

struct RuntimeOnlyBlockProbe(BlockDefinition):
    fn kind() -> text: "item5_runtime_only_probe"
    fn parse_payload(payload: text, ctx: BlockContext) -> Result<BlockValue, BlockError>:
        Ok(BlockValue.Raw(payload))
    fn eval_const(value: BlockValue) -> ConstValue?:
        nil

fn main() -> i64:
    if not register_block(RuntimeOnlyBlockProbe()): return 1
    if not is_block_registered("item5_runtime_only_probe"): return 2
    test_no_const_eval("item5_runtime_only_probe", BlockValue.Raw("runtime"))
    if not unregister_block("item5_runtime_only_probe"): return 3
    if is_block_registered("item5_runtime_only_probe"): return 4
    print "BLOCK_NO_CONST_EVAL_PASS registered=1 absent=1 removed=1"
    0
