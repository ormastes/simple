# Expected compile failure: same method spelling is not trait membership.
trait NativeRequiredProbe:
    fn inspect_probe_v1() -> i64

class NativeUnrelatedProbe:
    value: i64

impl NativeUnrelatedProbe:
    fn inspect_probe_v1() -> i64:
        self.value

fn inspect_required_probe(value: NativeRequiredProbe) -> i64:
    value.inspect_probe_v1()

fn main() -> i64:
    inspect_required_probe(NativeUnrelatedProbe(value: 17))
