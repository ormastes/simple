# Direct indexed expressions: no typed-local workaround at the use sites.
class AliasOwner:
    aliases: {text: [text]}

fn main() -> i64:
    var values: {text: [text]} = {}
    values["names"] = ["alpha", "beta"]
    values["empty"] = []
    if not values["names"].contains("beta"): return 1
    var count = 0
    for name in values["names"]:
        count = count + name.len()
    if count != 9: return 2
    for name in values["empty"]:
        return 3
    if values.contains_key("missing"):
        for name in values["missing"]:
            return 4
    val owner = AliasOwner(aliases: values)
    if not owner.aliases["names"].contains("alpha"): return 5
    var nested: {text: [[i64]]} = {}
    nested["rows"] = [[2, 3], [5]]
    var sum = 0
    for row in nested["rows"]:
        for value in row:
            sum = sum + value
    if sum != 10: return 6
    var maps: {text: {text: [i64]}} = {}
    var inner: {text: [i64]} = {}
    inner["cells"] = [7, 11]
    maps["grid"] = inner
    if not maps["grid"]["cells"].contains(11): return 7
    0
