use std.nogc_sync_mut.io_runtime.{exit}
use std.nogc_sync_mut.sffi.enum_wire.{enum_wire_nil_slot, enum_wire_restore_nil}

@unsafe(reason: "borrow a live typed enum without ownership transfer or mutation; returns its uint32 runtime identity or minus one for an invalid enum", capabilities: [ffi])
extern fn rt_enum_id<T>(value: T) -> i64
@unsafe(reason: "borrow a live typed enum without ownership transfer or mutation; returns its uint32 runtime discriminant or minus one for an invalid enum; discriminants need not be ordinal", capabilities: [ffi])
extern fn rt_enum_discriminant<T>(value: T) -> i64
@unsafe(reason: "borrow a live typed enum without ownership transfer or mutation; invalid enum returns runtime nil, which may also be a legitimate payload; validate enum identity separately", capabilities: [ffi])
extern fn rt_enum_payload<T>(value: T) -> i64
@unsafe(reason: "borrow a live payload without ownership transfer or mutation; selected runtime returns length for its recognized tuple representation and minus one on rejection; length alone does not distinguish Array from Tuple", capabilities: [ffi])
extern fn rt_tuple_len(tuple: i64) -> i64

fn require(condition: bool):
    if not condition:
        print "ENUM_WIRE_BOUNDARY_FAIL"
        exit(1)

enum WireCase:
    Empty
    Flag(value: bool)
    Row(label: text, enabled: bool, count: i64)
    TupleOnly(value: (i64, i64))
    Pair(label: text, enabled: bool)
    IntFields(bits: i64, signed: bool)

@unsafe(reason: "fixture supplies the declared WireCase variant schema", capabilities: [ffi])
fn require_slot(value: WireCase, arity: i64, index: i64, expected: bool):
    match enum_wire_nil_slot(value, arity, index):
        case Ok(actual): require(actual == expected)
        case Err(_): require(false)

@unsafe(reason: "fixture checks declared payload positions and intentional invalid-schema refusals using real typed constructors", capabilities: [ffi])
fn main():
    val original = WireCase.Row("keep", false, 37)
    # Observe this typed Row's real identity; variant tags need not be ordinal.
    val original_owner = rt_enum_id(original)
    val original_variant = rt_enum_discriminant(original)
    require(original_owner >= 0)
    require(original_variant >= 0)
    # A wrong declared arity must retain the refusal and identify the actual
    # three-field payload, without assuming a particular runtime enum ABI.
    match enum_wire_nil_slot(original, 2, 1):
        case Ok(_): require(false)
        case Err(detail):
            require(detail == "enum wire tuple arity mismatch owner={original_owner} variant={original_variant} expected_arity=2 index=1 actual_arity=3")
    val pair_false = WireCase.Pair("keep false", false)
    require_slot(pair_false, 2, 0, false)
    require_slot(pair_false, 2, 1, false)
    val pair_true = WireCase.Pair("keep true", true)
    require_slot(pair_true, 2, 0, false)
    require_slot(pair_true, 2, 1, false)
    match pair_false:
        case WireCase.Pair(label, enabled):
            require(label == "keep false")
            require(enabled == false)
        case _: require(false)
    match pair_true:
        case WireCase.Pair(label, enabled):
            require(label == "keep true")
            require(enabled == true)
        case _: require(false)
    val int_fields = WireCase.IntFields(64, true)
    require_slot(int_fields, 2, 1, false)
    match enum_wire_restore_nil(int_fields, 2, [1]):
        case Ok(restored):
            require(rt_tuple_len(rt_enum_payload(restored)) == 2)
            require_slot(restored, 2, 1, true)
            require_slot(int_fields, 2, 1, false)
            require(rt_enum_id(restored) == rt_enum_id(int_fields))
            require(rt_enum_discriminant(restored) == rt_enum_discriminant(int_fields))
            match restored:
                case WireCase.IntFields(bits, _): require(bits == 64)
                case _: require(false)
            match int_fields:
                case WireCase.IntFields(bits, signed):
                    require(bits == 64)
                    require(signed == true)
                case _: require(false)
        case Err(_): require(false)
    match enum_wire_restore_nil(original, 3, [1]):
        case Ok(restored):
            require(rt_tuple_len(rt_enum_payload(restored)) == 3)
            require_slot(restored, 3, 1, true)
            require_slot(original, 3, 1, false)
            match restored:
                case WireCase.Row(label, _, count):
                    require(label == "keep")
                    require(count == 37)
                case _: require(false)
        case Err(_): require(false)
    match enum_wire_restore_nil(WireCase.Flag(false), 1, [0]):
        case Ok(restored): require_slot(restored, 1, 0, true)
        case Err(_): require(false)
    require_slot(WireCase.Flag(false), 1, 0, false)
    require_slot(WireCase.Flag(true), 1, 0, false)
    # A scalar payload is not a multi-field collection. Neither runtime's
    # rejected array-length sentinel may satisfy the supplied arity of two.
    match enum_wire_nil_slot(WireCase.Flag(true), 2, 1):
        case Ok(_): require(false)
        case Err(detail):
            require(detail.starts_with("enum wire tuple arity mismatch"))
    match enum_wire_restore_nil(WireCase.Flag(true), 2, []):
        case Ok(_): require(false)
        case Err(detail): require(detail == "enum wire tuple arity mismatch")
    match enum_wire_nil_slot(int_fields, 2, 2):
        case Ok(_): require(false)
        case Err(detail): require(detail == "enum wire slot out of range")
    match enum_wire_nil_slot(int_fields, 2, -1):
        case Ok(_): require(false)
        case Err(detail): require(detail == "enum wire slot out of range")
    match enum_wire_restore_nil(WireCase.Empty, 0, []):
        case Ok(restored):
            match restored:
                case WireCase.Empty: ()
                case _: require(false)
        case Err(_): require(false)
    match enum_wire_restore_nil(original, 2, [1]):
        case Ok(_): require(false)
        case Err(_): ()
    match enum_wire_restore_nil(original, 3, [3]):
        case Ok(_): require(false)
        case Err(_): ()
    # @workaround bug=a174_enum_tuple_literal_provenance_2026_10_16 recover=2b0fe4e6db0 reason=retain-tuple-payload-type-at-constructor
    val tuple_payload: (i64, i64) = (7, 9)
    require_slot(WireCase.TupleOnly(tuple_payload), 1, 0, false)
    match enum_wire_restore_nil(WireCase.TupleOnly(tuple_payload), 1, []):
        case Ok(restored):
            match restored:
                case WireCase.TupleOnly(pair):
                    require(pair.0 == 7)
                    require(pair.1 == 9)
                case _: require(false)
        case Err(_): require(false)
    print "ENUM_WIRE_BOUNDARY_PASS"
