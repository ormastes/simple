# Typed caller boundary for the actual Stage2 ANY.link failure (#3319).
struct AliasLoopEntry:
    path: text
    link: bool
    untracked: bool

fn alias_loop_entries(present: bool) -> [AliasLoopEntry]?:
    if not present: return nil
    Some([AliasLoopEntry("tracked", true, false), AliasLoopEntry("untracked", false, true)])

fn alias_loop_count(present: bool) -> i64:
    val listed = alias_loop_entries(present)
    if listed == nil: return -1
    val listed_entries: [AliasLoopEntry] = listed!
    var count: i64 = 0
    for entry_value in listed_entries:
        val entry: AliasLoopEntry = entry_value
        if not entry.link and not entry.untracked: continue
        val children = alias_loop_entries(true)
        if children == nil: return -2
        val child_entries: [AliasLoopEntry] = children!
        for child_value in child_entries:
            val child: AliasLoopEntry = child_value
            if child.link and child.path == "tracked": count = count + 1
    count

fn main() -> i64:
    if alias_loop_count(true) != 2: return 1
    if alias_loop_count(false) != -1: return 2
    0
