# Core-runtime companion for the parser-shape regression.  Explicit tuples
# make the name/value binding observable without relying on a dynamic
# Array.enumerate registration in the bootstrap runtime bundle.
fn main() -> i64:
    val names = [(0, "aether"), (1, "glass")]
    var result = ""
    for index, name in names:
        result = result + index.to_string() + ":" + name + ";"
    if result != "0:aether;1:glass;":
        print "tuple-for-fail=" + result
        return 1
    print "tuple-for-ok=" + result
    0
