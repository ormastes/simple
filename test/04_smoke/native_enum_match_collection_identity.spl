# @req REQ-ENUM-MATCH-COLLECTION-IDENTITY
# Native compile/run oracle: enum payload identity must survive the match merge.
enum CollectionValue:
    Map(Dict<text, i64>)
    Left([i64])
    Right([i64])
    Empty

fn has_answer(value: CollectionValue) -> bool:
    val fields = match value:
        case CollectionValue.Map(items): items
        case _: return false
    fields.contains_key("answer") and fields["answer"] == 42

fn sum_items(value: CollectionValue) -> i64:
    val items = match value:
        case CollectionValue.Left(found): found
        case CollectionValue.Right(found): found
        case _: return -1
    var total = 0
    for item in items:
        total = total + item
    total + items.len()

fn guarded_items(value: CollectionValue, use_default: bool, fallback: [i64], last: [i64]) -> i64:
    val items = match value:
        case CollectionValue.Left(found): found
        case _ if use_default: fallback
        case _: last
    var total = 0
    for item in items:
        total = total + item
    total

fn main() -> i64:
    var failures = 0
    if not has_answer(CollectionValue.Map({"answer": 42})): failures = failures + 1
    if has_answer(CollectionValue.Map({"other": 42})): failures = failures + 1
    if has_answer(CollectionValue.Empty): failures = failures + 1
    if sum_items(CollectionValue.Left([2, 3])) != 7: failures = failures + 1
    if sum_items(CollectionValue.Right([4, 5, 6])) != 18: failures = failures + 1
    if sum_items(CollectionValue.Empty) != -1: failures = failures + 1
    if guarded_items(CollectionValue.Left([3]), false, [7, 8], [9]) != 3: failures = failures + 1
    if guarded_items(CollectionValue.Empty, true, [7, 8], [9]) != 15: failures = failures + 1
    if guarded_items(CollectionValue.Empty, false, [7, 8], [9]) != 9: failures = failures + 1
    print "checks=9 failures={failures}"
    failures
