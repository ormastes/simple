fn main():
    var fails = 0
    var a: [i64] = []
    var n = 0
    while a.?:
        n = n + 1
        if n > 5:
            break
    if n == 0:
        print "PASS empty [i64] while a.?: 0 iterations"
    else:
        print "FAIL empty [i64] while a.?: {n} iterations, len={a.len()}"
        fails = fails + 1
    var e: [(i64, bool)] = []
    var m = 0
    while e.?:
        m = m + 1
        if m > 5:
            break
    if m == 0:
        print "PASS empty [(i64,bool)] while e.?: 0 iterations"
    else:
        print "FAIL empty [(i64,bool)] while e.?: {m} iterations, len={e.len()}"
        fails = fails + 1
    var f = [7]
    var k = 0
    while f.?:
        f.pop()
        k = k + 1
        if k > 5:
            break
    if k == 1:
        print "PASS one-elem [i64] drained by pop: 1 iteration"
    else:
        print "FAIL one-elem [i64] drained by pop: {k} iterations, len={f.len()}"
        fails = fails + 1
    if a.?:
        print "FAIL if a.?: TAKEN on empty array"
        fails = fails + 1
    else:
        print "PASS if a.?: not taken on empty array"
    var g = [1, 2]
    if g.?:
        print "PASS if g.?: taken on non-empty array"
    else:
        print "FAIL if g.?: not taken on non-empty array"
        fails = fails + 1
    print "probe failures = {fails}"
