# Exercise the production optional-text helper without changing process OS.
use std.nogc_sync_mut.io.env_ops.{os_value_is_windows}

fn check(label: text, condition: bool) -> i64:
    if condition:
        print("PASS " + label)
        return 0
    print("FAIL " + label)
    1

fn main() -> i64:
    var failures = 0
    failures = failures + check("unset OS", not os_value_is_windows(nil))
    failures = failures + check("empty OS", not os_value_is_windows(""))
    failures = failures + check("Windows OS", os_value_is_windows("Windows_NT"))
    failures = failures + check("mixed case OS", os_value_is_windows("wInDoWs_Nt"))
    failures = failures + check("non-Windows OS", not os_value_is_windows("Linux"))
    failures = failures + check("substring compatibility", os_value_is_windows("prefix-WINDOWS-suffix"))
    failures
