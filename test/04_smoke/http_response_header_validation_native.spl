# Focused native reproducer for HTTP header character/code-point validation.
use std.nogc_sync_mut.http_server.response.{
    response_header_name_is_token, response_header_value_is_safe
}

fn main() -> i32:
    if not response_header_name_is_token("X-Item5"): return 1
    if response_header_name_is_token("X-café"): return 2
    if not response_header_value_is_safe("café"): return 3
    if response_header_value_is_safe("line\rbreak"): return 4
    println("HTTP_RESPONSE_HEADER_VALIDATION_NATIVE_PASS")
    0
