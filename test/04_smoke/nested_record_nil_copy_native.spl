# Repro for BUG-NATIVE-NESTED-STRUCT-NIL-COPY-20261016.
# A by-value copy of a record whose nonoptional nested record is "absent"
# (presence flag false, canonical empty payload) must not dereference a nil carrier.
# Expected stdout (2 lines, rc 0):
#   false
#   NESTED_COPY_OK
# Stage3 native: bin/simple native-build --entry test/04_smoke/nested_record_nil_copy_native.spl --output build/nested_copy && build/nested_copy
struct Inner:
    kind: i64
    id: i64

struct Outer:
    has_inner: bool
    inner: Inner
    name: text

fn copy_outer(o: Outer) -> Outer:
    o

val src = Outer(has_inner: false, inner: Inner(kind: 0, id: 0), name: "f")
val dup = copy_outer(src)
print "{dup.has_inner}"
if dup.inner.kind == 0 and dup.name == "f":
    print "NESTED_COPY_OK"
else:
    print "NESTED_COPY_FAIL"
