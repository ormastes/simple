use compiler.blocks.highlighting.{highlight_keywords, highlight_comments}
use compiler.blocks.definition.{HighlightToken, HighlightKind}

fn token_matches(token: HighlightToken, start: i64, end: i64, kind: HighlightKind) -> bool:
    token.start == start and token.end == end and token.kind == kind

fn main() -> i64:
    val words = highlight_keywords("if x iffy if", ["if"])
    if words.len() != 2: return 1
    if not token_matches(words[0], 0, 2, HighlightKind.Keyword): return 2
    if not token_matches(words[1], 10, 12, HighlightKind.Keyword): return 3
    if highlight_keywords("plain", ["if"]).len() != 0: return 4
    if highlight_keywords("plain", [""]).len() != 0: return 5
    if highlight_keywords("", ["if"]).len() != 0: return 6
    val absent = highlight_comments("x /*a*/ y", "//", nil)
    if absent.len() != 0: return 7
    val present = highlight_comments("x /*a*/ y", "//", ("/*", "*/"))
    if present.len() != 1: return 8
    if not token_matches(present[0], 2, 7, HighlightKind.Comment): return 9
    val line = highlight_comments("x //a\ny", "//", nil)
    if line.len() != 1: return 10
    if not token_matches(line[0], 2, 5, HighlightKind.Comment): return 11
    val unfinished = highlight_comments("x /*a", "//", ("/*", "*/"))
    if unfinished.len() != 1: return 12
    if not token_matches(unfinished[0], 2, 5, HighlightKind.Comment): return 13
    print "BLOCK_HIGHLIGHTER_PRESENCE_PASS checks=13"
    0
