# Focused native reproducer for explicitly owned same-name enum variants.
enum Item5ParserResultV1:
    Ok(value: i64)
    Err(code: i64)

enum Item5CloseResultV1:
    Ok(value: i64)
    Err(code: i64)

fn parse_value(result: Item5ParserResultV1) -> i64:
    match result:
        case Item5ParserResultV1.Ok(value): value
        case Item5ParserResultV1.Err(code): -code

fn close_value(result: Item5CloseResultV1) -> i64:
    match result:
        case Item5CloseResultV1.Ok(value): value + 1
        case Item5CloseResultV1.Err(code): -code

fn main() -> i32:
    if parse_value(Item5ParserResultV1.Ok(41)) != 41: return 1
    if parse_value(Item5ParserResultV1.Err(3)) != -3: return 2
    if close_value(Item5CloseResultV1.Ok(41)) != 42: return 3
    if close_value(Item5CloseResultV1.Err(4)) != -4: return 4
    println("HTTP_PARSER_ENUM_MATCH_NATIVE_PASS")
    0
