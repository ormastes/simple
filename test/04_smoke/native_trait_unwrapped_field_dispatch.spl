# Regression for self.bitmap!.reducer.method(): recover the declared trait
# through an explicit unwrap and preserve each implementation's own vtable.
trait UnwrappedReader:
    fn read_unwrapped() -> i64

class UnwrappedAdd:
    value: i64

impl UnwrappedReader for UnwrappedAdd:
    fn read_unwrapped() -> i64:
        self.value + 10

class UnwrappedMultiply:
    value: i64

impl UnwrappedReader for UnwrappedMultiply:
    fn read_unwrapped() -> i64:
        self.value * 10

class UnwrappedHolder:
    reader: UnwrappedReader

class UnwrappedOuter:
    holder: UnwrappedHolder?

impl UnwrappedOuter:
    fn read() -> i64:
        self.holder!.reader.read_unwrapped()

fn main() -> i64:
    val first = UnwrappedOuter(holder: UnwrappedHolder(reader: UnwrappedAdd(value: 3)))
    val second = UnwrappedOuter(holder: UnwrappedHolder(reader: UnwrappedMultiply(value: 3)))
    if first.read() != 13: return 1
    if second.read() != 30: return 2
    if first.holder!.reader.read_unwrapped() != 13: return 3
    if second.holder!.reader.read_unwrapped() != 30: return 4
    print "PASS native trait unwrapped field dispatch checks=4"
    0
