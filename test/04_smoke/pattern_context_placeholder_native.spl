# Focused native regression for placeholder isolation at pattern boundaries.
# Compile through the repaired pure-Simple producer; do not use the Rust parser as oracle.
enum PatternScopeProbe:
    Some((i64, i64))
    Err(i64)
    None

enum PatternScopeInner:
    Value(i64)
    Empty

enum PatternScopeOuter:
    Wrap(PatternScopeInner)
    Other

var pattern_scope_condition_calls: i64 = 0

fn next_pattern_scope_probe() -> PatternScopeProbe:
    pattern_scope_condition_calls = pattern_scope_condition_calls + 1
    PatternScopeProbe.Some((0, 2))

fn conditional(value: PatternScopeProbe) -> i64:
    if val PatternScopeProbe.Some((_, bound)) = value:
        return [bound].map(_ + 1)[0]
    elif val PatternScopeProbe.Err(_) = value:
        return [7].map(_ + 2)[0]
    return -1

fn conditional_expression(value: PatternScopeProbe) -> i64:
    val answer = if val PatternScopeProbe.Some((_, bound)) = value:
        [bound].map(_ + 3)[0]
    elif val PatternScopeProbe.Err(_) = value:
        [0].map(_ + 4)[0]
    else:
        -1
    answer

fn while_binding(value: PatternScopeProbe) -> i64:
    var current = value
    var count: i64 = 0
    var last: i64 = 0
    while val PatternScopeProbe.Some((_, bound)) = current:
        count = count + 1
        last = [bound].map(_ + 5)[0]
        current = PatternScopeProbe.Err(0)
    count * 100 + last

fn nested_constructor(value: PatternScopeOuter) -> i64:
    if val PatternScopeOuter.Wrap(PatternScopeInner.Value(_)) = value:
        return [1].map(_ + 6)[0]
    elif val PatternScopeOuter.Wrap(PatternScopeInner.Empty) = value:
        return [0].map(_ + 17)[0]
    return -1

fn guarded(value: PatternScopeProbe) -> i64:
    match value:
        case PatternScopeProbe.Some((_, bound)) if [bound].map(_ > 0)[0]:
            return [bound].map(_ + 8)[0]
        case _:
            return -1

fn refutable_binding(value: PatternScopeProbe) -> i64:
    val Err(code) = value else:
        return 100
    [code].map(_ + 9)[0]

fn condition_initializer_and_once() -> i64:
    pattern_scope_condition_calls = 0
    if val PatternScopeProbe.Some((_, bound)) = next_pattern_scope_probe():
        val result = [bound].map(_ + 10)[0]
        if pattern_scope_condition_calls != 1: return -1
        return result
    return -2

fn main() -> i32:
    if conditional(PatternScopeProbe.Some((99, 5))) != 6: return 1
    if conditional(PatternScopeProbe.Err(8)) != 9: return 2
    if conditional(PatternScopeProbe.None) != -1: return 3
    if conditional_expression(PatternScopeProbe.Some((0, 5))) != 8: return 4
    if conditional_expression(PatternScopeProbe.Err(8)) != 4: return 5
    if while_binding(PatternScopeProbe.Some((0, 1))) != 106: return 6
    if while_binding(PatternScopeProbe.Err(0)) != 0: return 7
    if nested_constructor(PatternScopeOuter.Wrap(PatternScopeInner.Value(9))) != 7: return 8
    if nested_constructor(PatternScopeOuter.Wrap(PatternScopeInner.Empty)) != 17: return 9
    if nested_constructor(PatternScopeOuter.Other) != -1: return 10
    if guarded(PatternScopeProbe.Some((0, 2))) != 10: return 11
    if guarded(PatternScopeProbe.Some((0, 0))) != -1: return 12
    if refutable_binding(PatternScopeProbe.Err(3)) != 12: return 13
    if refutable_binding(PatternScopeProbe.None) != 100: return 14
    if condition_initializer_and_once() != 12: return 15
    println("PATTERN_CONTEXT_PLACEHOLDER_NATIVE_PASS")
    0
