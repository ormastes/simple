# Native smoke for bug native_build_inprocess_link_access_violation_2026-11-05.
# Replays the two shapes _runtime_dir_not_found_message used on Windows: a nil
# extern text? defaulted with `??`, and an Option-valued if-expression. Each
# result is concatenated; the native lane must print text, not crash (AV).
extern fn rt_path_absolute(path: text) -> text?
extern fn rt_env_get(key: text) -> text?

fn nil_extern_default() -> text:
    val missing = rt_path_absolute("/definitely/missing/simple_w1_probe") ?? "<unknown>"
    var m = "missing=("
    m = m + missing + ")"
    m

fn option_if_expression() -> text:
    val root = rt_env_get("SIMPLE_W1_PROBE_UNSET_VAR")
    val pr = if root != "" and root != nil: root else: "<unset>"
    "pr=" + pr

fn main():
    print nil_extern_default()
    print option_if_expression()

main()
