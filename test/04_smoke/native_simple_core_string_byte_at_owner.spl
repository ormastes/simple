# Execute the pure-Simple primitive twin, separate from the core-C fixture.
# Expected output: PASS simple_core_string_byte_at_owner
use runtime.simple_core.core_string.{rt_string_new, rt_string_data, rt_string_byte_at, __simple_rt_string_byte_at}
use std.nogc_sync_mut.ptr.raw.{rt_alloc, rt_free, rt_ptr_write_u8}

fn byte_owner_check(value: i64, index: i64, expected: i64) -> bool:
    rt_string_byte_at(value, index) == expected and __simple_rt_string_byte_at(value, index) == expected

fn main() -> i64:
    val input = rt_alloc(6)
    if input == 0:
        print("FAIL allocation")
        return 1
    rt_ptr_write_u8(input, 0, 97)
    rt_ptr_write_u8(input, 1, 0)
    rt_ptr_write_u8(input, 2, 195)
    rt_ptr_write_u8(input, 3, 169)
    rt_ptr_write_u8(input, 4, 122)
    rt_ptr_write_u8(input, 5, 0)
    val counted = rt_string_new(input, 5)
    val raw = rt_string_data(counted)
    if not (byte_owner_check(counted, 2, 195) and byte_owner_check(raw, 2, 195)):
        print("FAIL counted NUL bytes")
        return 2
    if not (byte_owner_check(raw, -1, 0) and byte_owner_check(raw, 5, 0)):
        print("FAIL bounds")
        return 3
    if not byte_owner_check(input, 2, 0):
        print("FAIL foreign NUL fallback")
        return 4
    rt_ptr_write_u8(input, 1, 120)
    if not byte_owner_check(input, 2, 195):
        print("FAIL foreign mutation")
        return 5
    rt_ptr_write_u8(input, 1, 0)
    if not byte_owner_check(input, 2, 0):
        print("FAIL stale length")
        return 6
    rt_free(input)
    print("PASS simple_core_string_byte_at_owner")
    return 0
