# Native compile/run oracle for declared scalar and tuple carrier widths.
enum NumberPayload:
    Signed(value: i8)
    Unsigned(value: u8)
    Wide(value: u64)
    SmallFloat(value: f32)
    WideFloat(value: f64)
    Mixed(signed: i8, unsigned: u8, wide: u64, small: f32, large: f64)
    Erased(value: any)
    ErasedPair(value: any, marker: i64)

fn agrees(value: NumberPayload) -> bool:
    match value:
        case NumberPayload.Signed(number): number == -7
        case NumberPayload.Unsigned(number): number == 200
        case NumberPayload.Wide(number): number == 9007199254740993u64
        case NumberPayload.SmallFloat(number): number == 1.5
        case NumberPayload.WideFloat(number): number == 2.25
        case NumberPayload.Mixed(signed, unsigned, wide, small, large):
            signed == -7 and unsigned == 200 and wide == 9007199254740993u64 and small == 1.5 and large == 2.25
        case NumberPayload.Erased(value): (value as i64) == 42
        case NumberPayload.ErasedPair(value, marker): (value as f64) == 2.25 and marker == 73

fn rewrap_erased(value: NumberPayload) -> NumberPayload:
    match value:
        case NumberPayload.Erased(payload): NumberPayload.Erased(payload)
        case NumberPayload.ErasedPair(payload, marker): NumberPayload.ErasedPair(payload, marker)
        case _: value

fn main() -> i64:
    var failed = 0
    if not agrees(NumberPayload.Signed(-7)): failed = failed + 1
    if not agrees(NumberPayload.Unsigned(200)): failed = failed + 1
    if not agrees(NumberPayload.Wide(9007199254740993u64)): failed = failed + 1
    if not agrees(NumberPayload.SmallFloat(1.5)): failed = failed + 1
    if not agrees(NumberPayload.WideFloat(2.25)): failed = failed + 1
    if not agrees(NumberPayload.Mixed(-7, 200, 9007199254740993u64, 1.5, 2.25)): failed = failed + 1
    if not agrees(NumberPayload.Erased(42)): failed = failed + 1
    if not agrees(NumberPayload.ErasedPair(2.25, 73)): failed = failed + 1
    # Declared-order named calls deliberately take the legacy MethodCall route.
    # They must produce the same payload words as the typed positional route.
    if not agrees(NumberPayload.Mixed(signed: -7, unsigned: 200, wide: 9007199254740993u64, small: 1.5, large: 2.25)): failed = failed + 1
    if not agrees(NumberPayload.Erased(value: 42)): failed = failed + 1
    if not agrees(NumberPayload.ErasedPair(value: 2.25, marker: 73)): failed = failed + 1
    if not agrees(rewrap_erased(NumberPayload.Erased(42))): failed = failed + 1
    if not agrees(rewrap_erased(NumberPayload.ErasedPair(2.25, 73))): failed = failed + 1
    print "checks=13 failures={failed}"
    failed
