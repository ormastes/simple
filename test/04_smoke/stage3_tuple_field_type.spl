# Stage3 regression fixture (bug stage2_struct_param_deep_copy_packed_span_2026-11-03):
# a positional tuple field `t.N` once stored a HirType? into HirExpr.type_ and every
# later by-value copy of that expression faulted (AV addr 0x100000000).
# Expected stdout: "ok 4 2 7 9 3 5 1"
struct Holder:
    pair: (i64, text)

fn trio(x: i64) -> Result<(i64, text, [i64]), text>:
    Ok((x, "t", [1, 2]))

fn via_try(x: i64) -> Result<i64, text>:
    val parsed = trio(x)?
    if parsed.2.len() > 0:
        return Ok(parsed.0)
    Ok(0)

fn width(s: text) -> i64:
    s.len() + 1

fn main() -> i64:
    val direct = (2, "ab")
    val nested = ((7, 8), 9)
    val held = Holder(pair: (3, "abcd"))
    var bound = 0
    if val got = Some((1, 2)):
        bound = got.0
    val a = match via_try(4):
        case Ok(v): v
        case Err(_): 0 - 1
    print("ok {a} {direct.0} {nested.0.0} {nested.1} {held.pair.0} {width(held.pair.1)} {bound}")
    0
