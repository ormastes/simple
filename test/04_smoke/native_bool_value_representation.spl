# ABI regression for the canonical I64 -> I8 runtime provider.
extern fn rt_value_as_bool(value: i64) -> bool

fn check_case(label: text, value: i64, expected: bool) -> i64:
    val actual = rt_value_as_bool(value)
    if actual == expected:
        print "PASS {label}"
        return 0
    print "FAIL {label}"
    1

fn main() -> i64:
    var failed = 0
    failed = failed + check_case("tagged-true", 11, true)
    failed = failed + check_case("tagged-false", 19, false)
    failed = failed + check_case("nil", 3, false)
    failed = failed + check_case("integer-zero", 0, false)
    failed = failed + check_case("integer-one", 8, false)
    failed = failed + check_case("other-special", 27, false)
    failed = failed + check_case("heap-tag-only", 1, false)
    print "bool value representation: 7 checks, {failed} failures"
    if failed == 0: 0 else: 1
