struct Bag:
    items: [i64]
    base: i64

impl Bag:
    fn has(x: i64) -> bool:
        for it in self.items:
            if it + self.base == x:
                return true
        false
    fn pick(i: i64, j: i64) -> i64:
        self.items[i] + self.items[j] + self.base

class Box:
    tag: text
    n: i64
    fn same(t: text) -> bool:
        self.tag == t
    me bump(by: i64):
        self.n = self.n + by
    fn total(k: i64) -> i64:
        self.n * k

fn main() -> i64:
    val b = Bag(items: [1, 2, 3], base: 10)
    var bx = Box(tag: "k", n: 1)
    bx.bump(4)
    if b.has(12) and not b.has(99) and b.pick(0, 2) == 14 and bx.same("k") and bx.total(3) == 15:
        print("PASS recv_fn_args")
        return 0
    print("FAIL recv_fn_args")
    return 1
