class Reg:
    names: Dict<text, i64>
    order: [text]

    me put(k: text, v: i64):
        if not self.names.contains_key(k):
            self.order.push(k)
        self.names[k] = v
    fn get_or(k: text, d: i64) -> i64:
        if self.names.contains_key(k):
            return self.names[k]
        d

class Outer:
    reg: Reg
    hits: i64
    me add(k: text, v: i64):
        self.reg.put(k, v)
        self.hits = self.hits + 1
    fn look(k: text) -> i64:
        self.reg.get_or(k, -1)

fn main() -> i64:
    var o = Outer(reg: Reg(names: {}, order: []), hits: 0)
    o.add("a", 5)
    o.add("b", 7)
    o.add("a", 9)
    o.reg.put("c", 1)
    if o.look("a") == 9 and o.look("z") == -1 and o.reg.order.len() == 3 and o.hits == 3:
        print("PASS recv_nested")
        return 0
    print("FAIL recv_nested")
    return 1
