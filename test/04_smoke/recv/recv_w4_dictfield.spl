class Reg:
    names: Dict<text, i64>

    me put(k: text, v: i64):
        if v > 0:
            self.names[k] = v

fn main() -> i64:
    var r = Reg(names: {})
    r.put("a", 5)
    r.put("b", 0)
    if r.names.len() == 1 and r.names["a"] == 5:
        print("PASS w4_dictfield")
        return 0
    print("FAIL w4_dictfield")
    return 1
