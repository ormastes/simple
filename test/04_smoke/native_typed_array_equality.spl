# Keep structural equality distinct from element reads and identity checks.
# The original native_array_mutation_methods assertions remain authoritative.
fn verify(label: text, condition: bool) -> i64:
    if condition:
        print "PASS {label}"
        return 0
    print "FAIL {label}"
    1

fn typed_equal(left: [i64], right: [i64]) -> bool:
    left == right

fn evaluated(counter: [i64], value: [i64]) -> [i64]:
    counter[0] = counter[0] + 1
    value

fn main() -> i64:
    var failures = 0
    val left: [i64] = [7, -3, 0]
    val right: [i64] = [7, -3, 0]
    failures = failures + verify("separate arrays equal", left == right)
    failures = failures + verify("element oracle", left[0] == right[0] and left[1] == right[1] and left[2] == right[2])
    failures = failures + verify("different elements unequal", left != [7, 3, 0])
    failures = failures + verify("different lengths unequal", left != [7, -3])
    failures = failures + verify("typed parameters equal", typed_equal(left, right))
    val empty_left: [i64] = []
    val empty_right: [i64] = []
    failures = failures + verify("empty arrays equal", empty_left == empty_right)
    failures = failures + verify("text array contents", ["λ", "same", ""] == ["λ", "same", ""])
    failures = failures + verify("nested array contents", [[1, 2], [3]] == [[1, 2], [3]])
    failures = failures + verify("nested difference", [[1, 2], [3]] != [[1, 2], [4]])
    failures = failures + verify("separate identity", not (left is right))
    failures = failures + verify("self identity", left is left)
    failures = failures + verify("self equality", left == left)
    val erased: Any = left
    failures = failures + verify("Any typed equality", erased == right)
    failures = failures + verify("typed Any equality", right == erased)
    val scalar: Any = 7
    failures = failures + verify("array scalar negative", erased != scalar)
    failures = failures + verify("array nil negative", left != nil)
    var counter: [i64] = [0]
    val once = evaluated(counter, left) == evaluated(counter, right)
    failures = failures + verify("comparison evaluates each once", once and counter[0] == 2)
    failures = failures + verify("comparison preserves operands", left.len() == 3 and right.len() == 3 and left[1] == -3 and right[1] == -3)
    print "18 checks, {failures} failures"
    failures
