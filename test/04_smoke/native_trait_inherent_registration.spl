# Inherent impls have no trait payload. Registration must skip them while
# retaining both genuine trait implementations in the same HIR module.
trait MixedRegistrationProbe:
    fn read_probe() -> i64

class MixedRegistrationAdd:
    value: i64

impl MixedRegistrationAdd:
    fn inherent_probe() -> i64:
        self.value + 100

impl MixedRegistrationProbe for MixedRegistrationAdd:
    fn read_probe() -> i64:
        self.value + 10

class MixedRegistrationMultiply:
    value: i64

impl MixedRegistrationMultiply:
    fn inherent_probe() -> i64:
        self.value * 100

impl MixedRegistrationProbe for MixedRegistrationMultiply:
    fn read_probe() -> i64:
        self.value * 10

fn read_mixed_registration(item: MixedRegistrationProbe) -> i64:
    item.read_probe()

fn main() -> i64:
    val first = MixedRegistrationAdd(value: 3)
    val second = MixedRegistrationMultiply(value: 3)
    if first.inherent_probe() != 103: return 1
    if second.inherent_probe() != 300: return 2
    if read_mixed_registration(first) != 13: return 3
    if read_mixed_registration(second) != 30: return 4
    print "PASS native trait inherent registration checks=4"
    0
