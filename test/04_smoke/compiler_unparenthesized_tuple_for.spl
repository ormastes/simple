# Regression: unparenthesized tuple bindings must encode exactly like the
# adjacent parenthesized form, including the concrete bound name and value.
# Keep the tuple source explicit: the core-c bootstrap lane deliberately does
# not provide the dynamic `Array.enumerate` method symbol.
fn main() -> i64:
    val rows = [(0, "aether"), (1, "glass")]
    var unparenthesized = ""
    for index, name in rows:
        unparenthesized = unparenthesized + index.to_string() + ":" + name + ";"
    var parenthesized = ""
    for (adjacent_index, adjacent_name) in rows:
        parenthesized = parenthesized + adjacent_index.to_string() + ":" + adjacent_name + ";"
    if unparenthesized != "0:aether;1:glass;" or unparenthesized != parenthesized:
        print "tuple-for-fail=" + unparenthesized + " adjacent=" + parenthesized
        return 1
    print "tuple-for-ok=" + unparenthesized
    0
