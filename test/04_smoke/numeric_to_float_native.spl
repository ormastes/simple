# Compile with the repaired self-hosted compiler and execute the native binary.
# Expected values are explicit IEEE-754 results, not another conversion call.

fn check_int_to_float(value: i64, expected: f64):
    val actual = value.to_float()
    if actual != expected:
        panic("numeric to_float mismatch value={value}")

fn numeric_float_count() -> i64:
    98

fn main():
    check_int_to_float(0, 0.0)
    check_int_to_float(1, 1.0)
    check_int_to_float(-1, -1.0)
    check_int_to_float(98, 98.0)
    check_int_to_float(-98, -98.0)
    check_int_to_float(9007199254740991, 9007199254740991.0)
    check_int_to_float(-9007199254740991, -9007199254740991.0)
    # Above 2^53, nearest-even f64 conversion rounds this odd integer down.
    check_int_to_float(9007199254740993, 9007199254740992.0)
    check_int_to_float(-9007199254740993, -9007199254740992.0)
    check_int_to_float(9223372036854775807, 9223372036854775808.0)
    val minimum: i64 = -9223372036854775807 - 1
    check_int_to_float(minimum, -9223372036854775808.0)
    if numeric_float_count().to_float() != 98.0:
        panic("numeric to_float lost function return type")
    # The existing text parser must retain ownership of text.to_float.
    if "1.25".to_float() != 1.25:
        panic("text to_float was captured by numeric lowering")
    print "NUMERIC_TO_FLOAT_NATIVE_PASS checks=13"
