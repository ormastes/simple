# External exact text oracle; literals retain lexemes through AST/HIR/MIR.
fn main() -> i64:
    val positive: f64 = 9007199254740991.0
    val negative: f64 = -9007199254740991.0
    val decimal: f64 = 0.125
    val exponent: f64 = 1.25e2
    val narrow: f32 = 0.125f32
    val decimal_narrow: f32 = 0.1f32
    val round_down: f32 = 16777217.0f32
    val round_up: f32 = 16777219.0f32
    print "positive={positive}"
    print "negative={negative}"
    print "decimal={decimal}"
    print "exponent={exponent}"
    print "narrow={narrow}"
    print "decimal_narrow={decimal_narrow}"
    print "round_down={round_down}"
    print "round_up={round_up}"
    print "FLOAT_LEXEME_OWNER_PASS cases=8"
    0
