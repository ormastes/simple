# Native stdin regression: compile this entry, then run with a whitespace-
# padded line, CRLF, and EOF. Expected output is respectively `value=hello`,
# `value=hello`, and `value=`. This calls the real TUI input owner; no fake stdin.
use app.ui.tui.app.{read_user_input}

fn main() -> i64:
    print("value=" + read_user_input())
    0
