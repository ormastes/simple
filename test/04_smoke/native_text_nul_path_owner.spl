use std.nogc_sync_mut.io.path_identity.{path_final_existing}

fn report(label: text, path: text):
    match path_final_existing(path):
        case Ok(_): print("{label}=OK")
        case Err(reason): print("{label}={reason}")

fn param_contains(value: text, needle: text) -> bool:
    value.contains(needle)

fn param_length(value: text) -> i64:
    value.len()

fn main() -> i64:
    val root = "/tmp/simple-source82-d-ext4-volume-20261007/phase1-followup-5e8565-complete-source-20261008"
    val normal_contains = root.contains("\0")
    print("NORMAL_CONTAINS_NUL={normal_contains}")
    val nul = "\0"
    val nul_length = nul.len()
    print("NUL_LENGTH={nul_length}")
    val before = "\0/tmp"
    val middle = "/tmp\0suffix"
    val after = "/tmp\0"
    val unicode = "é\0x"
    val unicode_length = unicode.len()
    print("UNICODE_NUL_BYTE_LENGTH={unicode_length}")
    val through_param = param_contains(middle, nul)
    val param_bytes = param_length(unicode)
    print("PARAM_CONTAINS_NUL={through_param}")
    print("PARAM_BYTE_LENGTH={param_bytes}")
    val plain_ascii = param_contains("abc", "b")
    val empty_needle = param_contains("abc", "")
    print("ASCII_CONTAINS={plain_ascii}")
    print("EMPTY_NEEDLE_CONTAINS={empty_needle}")
    val built_nul = text.from_char_code(0)
    val produced = "/tmp" + built_nul + "suffix"
    val produced_length = produced.len()
    val produced_contains = param_contains(produced, built_nul)
    print("CONCAT_BYTE_LENGTH={produced_length}")
    print("CONCAT_CONTAINS_NUL={produced_contains}")
    report("NORMAL_ROOT", root)
    report("EMPTY_PATH", "")
    report("NUL_BEFORE_PATH", before)
    report("NUL_MIDDLE_PATH", middle)
    report("NUL_AFTER_PATH", after)
    report("UNICODE_NUL_PATH", unicode)
    report("CONCAT_NUL_PATH", produced)
    0
