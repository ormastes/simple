fn boolean(value: bool) -> Result<bool, text>:
    Ok(value)

fn array(value: i64) -> Result<[i64], text>:
    Ok([value, 7])

fn empty_array() -> Result<[i64], text>:
    Ok([])

fn error_array() -> Result<text, [i64]>:
    Err([13, 17])

fn main() -> i64:
    if not boolean(true).unwrap(): return 1
    if boolean(false).unwrap(): return 2
    val pending: Result<[i64], text> = array(5)
    var first: [i64] = pending.unwrap()
    val second: [i64] = pending.unwrap()
    if first.len() != 2 or first[0] != 5 or first[1] != 7: return 3
    first[0] = 99
    if second[0] != 5: return 4
    if pending.unwrap()[0] != 5: return 5
    if empty_array().unwrap().len() != 0: return 6
    val failure: [i64] = error_array().unwrap_err()
    if failure.len() != 2 or failure[0] != 13 or failure[1] != 17: return 7
    print("PASS result-bool-array-unwrap checks=7")
    0
