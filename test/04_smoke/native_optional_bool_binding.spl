# Native regression: optional presence and a bound boolean's value differ.
fn bound_boolean(value: bool?) -> i64:
    if val opened = value:
        return if opened: 19 else: 23
    -17

fn returned_boolean(value: bool) -> bool?:
    Some(value)

fn present(value: bool?) -> bool:
    if val opened = value:
        return true
    false

fn check_case(label: text, actual: i64, expected: i64) -> i64:
    if actual == expected:
        print "PASS {label}"
        return 0
    print "FAIL {label} actual={actual} expected={expected}"
    1

fn main() -> i64:
    var failed = 0
    failed = failed + check_case("absent", bound_boolean(nil), -17)
    failed = failed + check_case("some-false-value", bound_boolean(Some(false)), 23)
    failed = failed + check_case("some-true-value", bound_boolean(Some(true)), 19)
    failed = failed + check_case("returned-false-value", bound_boolean(returned_boolean(false)), 23)
    failed = failed + check_case("returned-true-value", bound_boolean(returned_boolean(true)), 19)
    failed = failed + check_case("false-is-present", if present(Some(false)): 1 else: 0, 1)
    failed = failed + check_case("nil-is-absent", if present(nil): 1 else: 0, 0)
    print "optional bool binding: 7 checks, {failed} failures"
    if failed == 0: 0 else: 1