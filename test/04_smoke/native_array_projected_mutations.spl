# Requires a pure-Simple producer rebuilt with projected receiver metadata repair.
struct WordBox:
    words: [text]
    rows: [[i64]]

fn check(label: text, condition: bool) -> i64:
    if condition:
        print("PASS " + label)
        return 0
    print("FAIL " + label)
    1

fn pick(counter: [i64]) -> i64:
    counter[0] = counter[0] + 1
    0

fn main() -> i64:
    var failures = 0
    var box = WordBox(words: ["aa", "z"], rows: [[7, -2]])
    val word = box.words.pop()
    failures = failures + check("field text pop keeps declared decode", (word ?? "missing") == "z" and box.words == ["aa"])
    var nested: [[text]] = [["z", "a"]]
    var counter: [i64] = [0]
    nested[pick(counter)].sort()
    failures = failures + check("index sort evaluates index once", counter[0] == 1 and nested[0] == ["a", "z"])
    val nested_word = nested[pick(counter)].pop()
    failures = failures + check("index pop keeps text decode and one evaluation", counter[0] == 2 and (nested_word ?? "missing") == "z" and nested[0] == ["a"])
    nested[pick(counter)].clear()
    failures = failures + check("index clear writes back once", counter[0] == 3 and nested[0].len() == 0)
    box.rows[0].sort()
    val row_value = box.rows[0].pop()
    failures = failures + check("field then index carries full element type", (row_value ?? -1) == 7 and box.rows[0] == [-2])
    var deep: [[[i64]]] = [[[5, 1]]]
    deep[0][0].sort()
    val deep_value = deep[0][0].pop()
    failures = failures + check("ordinary index feeds a mutating index", (deep_value ?? -1) == 5 and deep[0][0] == [1])
    print("6 checks, {failures} failures")
    failures
