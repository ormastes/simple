# Native regression: tagged false must not become integer 2 after Result<bool>?.
struct BoolPresence:
    args_present: bool
    config_present: bool
    environment_present: bool

fn flag(value: bool) -> Result<bool, text>:
    Ok(value)

fn score() -> Result<i64, text>:
    val absent = flag(false)?
    val present = flag(true)?
    if absent:
        return Ok(99)
    if present:
        return Ok(23)
    Ok(0)

fn presence() -> Result<BoolPresence, text>:
    val args = flag(false)?
    val config = flag(false)?
    val environment = flag(true)?
    Ok(BoolPresence(args, config, environment))

fn nested(value: bool) -> Result<bool, text>:
    val decoded = flag(value)?
    Ok(decoded)

fn rejected() -> Result<bool, text>:
    Err("expected-negative")

fn propagate_error() -> Result<i64, text>:
    val value = rejected()?
    if value: Ok(1) else: Ok(2)

fn check(label: text, passed: bool) -> i64:
    if passed:
        print("PASS " + label)
        return 0
    print("FAIL " + label)
    1

fn main() -> i64:
    var failures = 0
    failures = failures + check("question-false-and-true", score().unwrap() == 23)
    val fields = presence().unwrap()
    failures = failures + check("record-args-false", fields.args_present == false)
    failures = failures + check("record-config-false", fields.config_present == false)
    failures = failures + check("record-environment-true", fields.environment_present == true)
    failures = failures + check("checked-false", flag(false).unwrap() == false)
    failures = failures + check("checked-true", flag(true).unwrap() == true)
    failures = failures + check("nested-false", nested(false).unwrap() == false)
    failures = failures + check("nested-true", nested(true).unwrap() == true)
    val propagated = match propagate_error():
        Ok(_): false
        Err(reason): reason == "expected-negative"
    failures = failures + check("error-propagation", propagated)
    print("result-bool-cases=9 failures=" + str(failures))
    if failures == 0: 0 else: 42
