# Fixed workload for test/03_system/check/mem_attr_report_spec.spl.
# Runs under SIMPLE_MEM_ATTR=1, tags allocations under a known owner name,
# allocates ~1MB of strings, then prints the top-owner report so the parent
# spec can assert the owner name round-trips through rt_mem_attr_report.

extern fn rt_mem_attr_enabled() -> i64
extern fn rt_mem_attr_set_owner(name: text)
extern fn rt_mem_attr_report(n: i64) -> text

fn make_chunk() -> text:
    var s = ""
    var i = 0
    while i < 512:
        s = s + "x"
        i = i + 1
    s

fn main() -> i64:
    rt_mem_attr_set_owner("attr_spec_owner")

    # ~1MB: 2000 strings of 512 bytes each.
    val chunk = make_chunk()
    var acc: [text] = []
    var i = 0
    while i < 2000:
        acc = acc.push(chunk)
        i = i + 1

    val report = rt_mem_attr_report(8)
    print "attr_workload: enabled={rt_mem_attr_enabled()} len={acc.len()}"
    print "attr_workload_report_begin"
    print report
    print "attr_workload_report_end"
    0
