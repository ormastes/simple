# NOT a *_spec.spl: this fixture is deliberately RED and is executed only as a
# child process by
# test/01_unit/lib/std/spec/it_block_error_accumulation_spec.spl.
# Example 1 asserts something false, is followed by a passing assertion, and
# MUST be reported as failing. Example 2 is the reverse order. Example 3 is
# the positive control that must pass.
# Bug: doc/08_tracking/bug/spec_it_block_last_expect_wins_masks_earlier_failure_2026-07-03.md

describe "last-expect-wins fixture":

    it "fail then pass in same it-block MUST FAIL":
        expect(1).to_equal(2)
        expect(3).to_equal(3)

    it "pass then fail in same it-block MUST FAIL":
        expect(3).to_equal(3)
        expect(1).to_equal(2)

    it "all pass MUST PASS":
        expect(1).to_equal(1)
        expect(2).to_equal(2)
