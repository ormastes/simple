# NOT a *_spec.spl: this fixture is deliberately RED and is executed only as a
# child process by
# test/01_unit/lib/std/spec/it_block_error_accumulation_spec.spl.
# Closes the bug doc's "Follow-up" question (nested describe/context framing)
# for doc/08_tracking/bug/spec_it_block_last_expect_wins_masks_earlier_failure_2026-07-03.md
# with an executable guard.
#
# Expected outcome on FIXED code (seed-smoke):
#   - example inside nested describe > context (fail then pass) -> FAILED,
#     message "expected 1 to equal 2"; the later passing assertion must not
#     clear the earlier failure through the nested framing.
#   - the all-pass control inside the same nesting -> ok.
#   - summary: 2 examples, 1 failure.

use std.spec.*

describe "outer describe":
    context "inner context":
        it "nested fail then pass MUST FAIL":
            expect(1).to_equal(2)
            expect(3).to_equal(3)

        it "nested all pass MUST PASS":
            expect(1).to_equal(1)
            expect(2).to_equal(2)
