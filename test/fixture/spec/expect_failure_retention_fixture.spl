# NOT a *_spec.spl: this fixture is deliberately RED and is executed only as a
# child process by test/01_unit/lib/std/spec_expect_failure_retention_spec.spl.
# Every example below asserts something false and MUST be reported as failing;
# example 7 is the positive control that must pass.
# Bug: doc/08_tracking/bug/bare_expect_statement_vacuous_2026-08-18.md

describe "expect failure retention fixture":

    it "bare expect after a passing matcher MUST FAIL":
        expect(1).to_equal(1)
        expect 1 == 2

    it "bare expect before a passing matcher MUST FAIL":
        expect 1 == 2
        expect(1).to_equal(1)

    it "two bare expects after a matcher MUST FAIL":
        expect(1).to_equal(1)
        expect 1 == 2
        expect 3 == 4

    it "failing matcher only MUST FAIL":
        expect(1).to_equal(2)

    it "failing matcher then passing matcher MUST FAIL":
        expect(1).to_equal(2)
        expect(5).to_equal(5)

    it "bare expect only MUST FAIL":
        expect 1 == 2

    it "control all assertions pass MUST PASS":
        expect(1).to_equal(1)
        expect 1 == 1
