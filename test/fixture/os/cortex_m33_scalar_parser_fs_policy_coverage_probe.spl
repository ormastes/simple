use std.tooling.coverage as coverage
use os.kernel.arch.cortex_m33.scalar_parser_fs_policy.{
    cm33_policy_streq,
    cm33_policy_starts_with,
    cm33_policy_parse_hex_prefix,
    cm33_policy_parse_hex_digit,
    cm33_policy_strlen_simple,
    cm33_policy_memcpy_simple,
    cm33_policy_fs_add_file,
    cm33_policy_fs_add_name,
    cm33_policy_fs_init,
    cm33_policy_fs_find
}

fn main():
    coverage.clear_coverage()
    var sink: u32 = 0

    sink = sink + cm33_policy_streq(65, 65)
    sink = sink + cm33_policy_streq(65, 66)
    sink = sink + cm33_policy_streq(0, 0)
    sink = sink + cm33_policy_starts_with(65, 65)
    sink = sink + cm33_policy_starts_with(65, 66)
    sink = sink + cm33_policy_starts_with(65, 0)

    sink = sink + cm33_policy_parse_hex_prefix(49, 120)
    sink = sink + cm33_policy_parse_hex_prefix(48, 113)
    sink = sink + cm33_policy_parse_hex_prefix(48, 120)
    sink = sink + cm33_policy_parse_hex_prefix(48, 88)
    for byte in [1u32, 47u32, 48u32, 57u32, 58u32, 64u32, 65u32, 70u32, 71u32, 96u32, 97u32, 102u32, 103u32]:
        sink = sink + cm33_policy_parse_hex_digit(byte)

    sink = sink + cm33_policy_strlen_simple(0)
    sink = sink + cm33_policy_strlen_simple(65)
    sink = sink + cm33_policy_memcpy_simple(0)
    sink = sink + cm33_policy_memcpy_simple(4)

    sink = sink + cm33_policy_fs_add_file(0, 0, 5, 16, 4096)
    sink = sink + cm33_policy_fs_add_file(16, 0, 1, 16, 4096)
    sink = sink + cm33_policy_fs_add_file(0, 4097, 0, 16, 4096)
    sink = sink + cm33_policy_fs_add_file(0, 4095, 2, 16, 4096)
    sink = sink + cm33_policy_fs_add_file(15, 4092, 4, 16, 4096)
    sink = sink + cm33_policy_fs_add_name(0, 0, 32)
    sink = sink + cm33_policy_fs_add_name(65, 30, 32)
    sink = sink + cm33_policy_fs_add_name(65, 31, 32)

    sink = sink + cm33_policy_fs_init(0)
    sink = sink + cm33_policy_fs_init(5)
    sink = sink + cm33_policy_fs_init(6)
    sink = sink + cm33_policy_fs_find(0, 2, 0)
    sink = sink + cm33_policy_fs_find(1, 2, 1)
    sink = sink + cm33_policy_fs_find(2, 2, 0)

    print "coverage-sink={sink}"
    print_raw(coverage.get_coverage_sdn())
