use os.kernel.arch.cortex_m33.scalar_parser_fs_policy.{
    cm33_policy_streq,
    cm33_policy_starts_with,
    cm33_policy_parse_hex_prefix,
    cm33_policy_parse_hex_digit,
    cm33_policy_strlen_simple,
    cm33_policy_memcpy_simple,
    cm33_policy_fs_add_file,
    cm33_policy_fs_add_name,
    cm33_policy_fs_init,
    cm33_policy_fs_find
}

fn emit2(group: text, case_name: text, a: u32, b: u32, value: u32):
    print "group={group} case={case_name} a={a} b={b} value={value}"

fn emit3(group: text, case_name: text, a: u32, b: u32, c: u32, value: u32):
    print "group={group} case={case_name} a={a} b={b} c={c} value={value}"

fn emit5(group: text, case_name: text, a: u32, b: u32, c: u32, d: u32, e: u32, value: u32):
    print "group={group} case={case_name} a={a} b={b} c={c} d={d} e={e} value={value}"

fn main() -> i64:
    emit2("streq", "advance", 65, 65, cm33_policy_streq(65, 65))
    emit2("streq", "mismatch", 65, 66, cm33_policy_streq(65, 66))
    emit2("streq", "matched", 0, 0, cm33_policy_streq(0, 0))

    emit2("starts", "advance", 65, 65, cm33_policy_starts_with(65, 65))
    emit2("starts", "mismatch", 65, 66, cm33_policy_starts_with(65, 66))
    emit2("starts", "matched", 65, 0, cm33_policy_starts_with(65, 0))

    emit2("prefix", "none-first", 49, 120, cm33_policy_parse_hex_prefix(49, 120))
    emit2("prefix", "none-second", 48, 113, cm33_policy_parse_hex_prefix(48, 113))
    emit2("prefix", "lower", 48, 120, cm33_policy_parse_hex_prefix(48, 120))
    emit2("prefix", "upper", 48, 88, cm33_policy_parse_hex_prefix(48, 88))

    for byte in [1u32, 47u32, 48u32, 57u32, 58u32, 64u32, 65u32, 70u32, 71u32, 96u32, 97u32, 102u32, 103u32]:
        emit2("digit", "matrix", byte, 0, cm33_policy_parse_hex_digit(byte))

    emit2("strlen", "stop", 0, 0, cm33_policy_strlen_simple(0))
    emit2("strlen", "advance", 65, 0, cm33_policy_strlen_simple(65))
    emit2("memcpy", "stop", 0, 0, cm33_policy_memcpy_simple(0))
    emit2("memcpy", "advance", 4, 0, cm33_policy_memcpy_simple(4))

    emit5("fs-add", "admit", 0, 0, 5, 16, 4096, cm33_policy_fs_add_file(0, 0, 5, 16, 4096))
    emit5("fs-add", "table-full", 16, 0, 1, 16, 4096, cm33_policy_fs_add_file(16, 0, 1, 16, 4096))
    emit5("fs-add", "used-invalid", 0, 4097, 0, 16, 4096, cm33_policy_fs_add_file(0, 4097, 0, 16, 4096))
    emit5("fs-add", "storage-full", 0, 4095, 2, 16, 4096, cm33_policy_fs_add_file(0, 4095, 2, 16, 4096))
    emit5("fs-add", "exact-fit", 15, 4092, 4, 16, 4096, cm33_policy_fs_add_file(15, 4092, 4, 16, 4096))

    emit3("fs-name", "nul", 0, 0, 32, cm33_policy_fs_add_name(0, 0, 32))
    emit3("fs-name", "advance", 65, 30, 32, cm33_policy_fs_add_name(65, 30, 32))
    emit3("fs-name", "limit", 65, 31, 32, cm33_policy_fs_add_name(65, 31, 32))
    emit2("fs-init", "first", 0, 0, cm33_policy_fs_init(0))
    emit2("fs-init", "last", 5, 0, cm33_policy_fs_init(5))
    emit2("fs-init", "done", 6, 0, cm33_policy_fs_init(6))

    emit3("fs-find", "next", 0, 2, 0, cm33_policy_fs_find(0, 2, 0))
    emit3("fs-find", "found", 1, 2, 1, cm33_policy_fs_find(1, 2, 1))
    emit3("fs-find", "not-found", 2, 2, 0, cm33_policy_fs_find(2, 2, 0))
    0
