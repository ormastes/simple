use os.kernel.arch.cortex_m33.access_policy.{
    cortex_m_policy_read_receipt,
    cortex_m_policy_write_receipt,
    cortex_m_policy_receipt_decision_mask
}

fn emit_case(
    board: text,
    case_name: text,
    addr: u32,
    flash_base: u32,
    flash_size: u32,
    ram_base: u32,
    ram_size: u32,
    covered: u32
) -> u32:
    val read = cortex_m_policy_read_receipt(addr, flash_base, flash_size, ram_base, ram_size)
    val write = cortex_m_policy_write_receipt(addr, ram_base, ram_size)
    print "board={board} case={case_name} addr={addr} read={read} write={write}"
    covered | cortex_m_policy_receipt_decision_mask(read) | cortex_m_policy_receipt_decision_mask(write)

fn emit_board(
    board: text,
    flash_base: u32,
    flash_size: u32,
    ram_base: u32,
    ram_size: u32,
    decisions: u32
) -> u32:
    var result = decisions
    result = emit_case(board, "flash-misaligned", flash_base + 1, flash_base, flash_size, ram_base, ram_size, result)
    result = emit_case(board, "flash-first", flash_base, flash_base, flash_size, ram_base, ram_size, result)
    result = emit_case(board, "flash-last", flash_base + flash_size - 4, flash_base, flash_size, ram_base, ram_size, result)
    result = emit_case(board, "flash-end", flash_base + flash_size, flash_base, flash_size, ram_base, ram_size, result)
    result = emit_case(board, "ram-first", ram_base, flash_base, flash_size, ram_base, ram_size, result)
    result = emit_case(board, "ram-last", ram_base + ram_size - 4, flash_base, flash_size, ram_base, ram_size, result)
    result = emit_case(board, "ram-end", ram_base + ram_size, flash_base, flash_size, ram_base, ram_size, result)
    result = emit_case(board, "peripheral-first", 0x40000000, flash_base, flash_size, ram_base, ram_size, result)
    result = emit_case(board, "peripheral-last", 0x5FFFFFFC, flash_base, flash_size, ram_base, ram_size, result)
    result = emit_case(board, "peripheral-end", 0x60000000, flash_base, flash_size, ram_base, ram_size, result)
    result = emit_case(board, "ppb-first", 0xE000E000, flash_base, flash_size, ram_base, ram_size, result)
    result = emit_case(board, "ppb-last", 0xE00FFFFC, flash_base, flash_size, ram_base, ram_size, result)
    result = emit_case(board, "ppb-end", 0xE0100000, flash_base, flash_size, ram_base, ram_size, result)
    result

fn main() -> i64:
    var decisions: u32 = 0
    decisions = emit_board("an505-m33", 0x10000000, 0x00400000, 0x20000000, 0x00008000, decisions)
    decisions = emit_board("stm32u585-m33", 0x08000000, 0x00200000, 0x20000000, 0x000C0000, decisions)
    decisions = emit_board("ra4m1-m4", 0x00000000, 0x00040000, 0x20000000, 0x00008000, decisions)
    print "decision_mask={decisions}"
    if decisions == 1023: 0 else: 1
