# Small native link/run probe for the provider digest exported by composition.
use std.nogc_sync_mut.composition.provider_contract.{
    SIMPLE_PROVIDER_QUERY_RESULT_V1_SIZE,
    simple_provider_digest_from_hex_v1,
    simple_provider_digest_to_hex_v1
}

fn main() -> i64:
    val hex = "112233445566778899aabbccddeeff00010203040506070890abcdefdeadbeef"
    val digest = simple_provider_digest_from_hex_v1(hex)
    if SIMPLE_PROVIDER_QUERY_RESULT_V1_SIZE != 84u32:
        return 1
    if digest.word0 != 0x11223344u32 or digest.word7 != 0xdeadbeefu32:
        return 2
    if simple_provider_digest_to_hex_v1(digest) != hex:
        return 3
    0
