# Traced workload for `simple mem trace` (M8) — see
# doc/03_plan/runtime/memory_analysis/memory_infra_next_phase_plan_2026-07-29.md §M8.
#
# `simple mem trace <prog.spl> -o <file>` runs this with SIMPLE_MEM_ATTR=1 and
# SIMPLE_MEM_DUMP_PATH=<file>. The recording contract is that the traced
# program itself emits the snapshot at the point of interest — the CLI cannot
# reach into another process's heap, so `trace` sets the gate and the
# destination and the program writes the file. This fixture allocates enough
# to produce non-trivial KIND/OWNER rows, then dumps.

use std.nogc_sync_mut.mem.dump.{mem_dump_to, mem_dump_target_path}

fn main() -> i64:
    var acc: [text] = []
    var i = 0
    while i < 2000:
        acc = acc.push("trace-workload-payload-{i}")
        i = i + 1
    var total = 0
    for s in acc:
        total = total + s.len()
    print "trace_workload: allocated {acc.len()} strings, {total} bytes of payload"
    val path = mem_dump_target_path()
    if mem_dump_to(path):
        print "trace_workload: snapshot written to {path}"
        return 0
    print "trace_workload: FAILED to write snapshot to {path}"
    1
