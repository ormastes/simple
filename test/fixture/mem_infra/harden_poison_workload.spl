# Fixed workload for test/01_unit/compiler/interp/mem_harden_spec.spl.
# Exercises SIMPLE_MEM_HARDEN's quarantine + 0xDE poison-on-free through the
# hosted rt_alloc/rt_free path, then a raw rt_ptr_read_i64 to observe the
# poison directly, and a raw rt_ptr_write_i64 to prove a write-after-free
# gets caught by rt_mem_harden_check(). Prints each stage as "key=value" so
# the parent spec can assert on the exact numbers.

extern fn rt_mem_harden_check() -> i64
extern fn rt_alloc(size: i64) -> i64
extern fn rt_free(ptr: i64)
extern fn rt_ptr_write_i64(addr: i64, offset: i64, value: i64)
extern fn rt_ptr_read_i64(addr: i64, offset: i64) -> i64

fn main() -> i64:
    val p = rt_alloc(64)
    rt_ptr_write_i64(p, 0, 12345)
    print "harden_poison_workload: clean_before_free={rt_mem_harden_check()}"

    rt_free(p)
    val poisoned = rt_ptr_read_i64(p, 0)
    print "harden_poison_workload: poisoned_bytes={poisoned}"
    print "harden_poison_workload: clean_after_free={rt_mem_harden_check()}"

    # Write-after-free: tamper the still-quarantined (not really deallocated)
    # block. rt_mem_harden_check() must now report at least one violation.
    rt_ptr_write_i64(p, 0, 999)
    print "harden_poison_workload: tampered_check={rt_mem_harden_check()}"
    0
