# Fixed workload for test/01_unit/runtime/mem_attr_gate_spec.spl.
# Tags an owner and prints whether attribution is enabled plus the top-n
# report, so the parent spec can confirm SIMPLE_MEM_ATTR=1 actually makes
# rt_mem_attr_set_owner register the owner (observable as a report row),
# in contrast to the same call being a no-op when the gate is off.

extern fn rt_mem_attr_enabled() -> i64
extern fn rt_mem_attr_set_owner(name: text)
extern fn rt_mem_attr_report(n: i64) -> text

val OWNER_NAME = "attr_gate_probe_owner"

fn main() -> i64:
    rt_mem_attr_set_owner(OWNER_NAME)
    print "attr_gate_probe: enabled={rt_mem_attr_enabled()}"
    print "attr_gate_probe_report_begin"
    print rt_mem_attr_report(10)
    print "attr_gate_probe_report_end"
    0
