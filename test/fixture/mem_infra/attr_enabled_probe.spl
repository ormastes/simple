# Fixed workload for test/03_system/check/mem_infra_flag_spec.spl.
# Prints whether per-owner allocation attribution is enabled in this process
# so the parent spec can confirm `--mem-infra=attr` set SIMPLE_MEM_ATTR=1
# before this program ran.

extern fn rt_mem_attr_enabled() -> i64

fn main() -> i64:
    print "attr_enabled_probe: enabled={rt_mem_attr_enabled()}"
    0
