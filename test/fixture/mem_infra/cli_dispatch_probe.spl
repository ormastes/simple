# Verification harness for test/03_system/check/mem_infra_flag_spec.spl.
#
# Self-interpreting the real CLI entry point (src/app/cli/main.spl or
# src/app/cli/_CliMain/main_and_help.spl directly as the `simple run` target)
# currently hard-fails on an unrelated pre-existing parse error reachable from
# main()'s full dispatch surface (src/lib/skia/feature/shaper/ot_layout_shaper.spl
# — "Unexpected token: expected expression, found Dedent"), because running a
# file as the top-level `simple run` target triggers an eager whole-program
# compile of everything main() can reach.
#
# Two further pitfalls were isolated 2026-07-30 (see doc/08_tracking/bug/):
#   1. Importing `apply_mem_infra_flags`/`apply_jit_env_vars` from
#      main_and_help.spl pulls its full `use lazy app.test_runner_new...` /
#      `app.mcp` / `app.jj` / `os.cli` / etc. graph, which causes
#      `cli_handle_run` (imported separately) to resolve to
#      `app.io.mod_stub`'s "Error: run requires Rust SFFI support" stub
#      instead of the real implementation.
#   2. Even once that's avoided (inlining `apply_mem_infra_flags` here, same
#      library calls/order as main_and_help.spl, and importing the real
#      `cli_handle_run` from its concrete module directly), calling
#      `cli_handle_run` IN-PROCESS on the target fixture still only
#      *interprets* it (`rt_interp_call error: unknown extern function:
#      rt_mem_attr_enabled`) rather than natively compiling+executing it —
#      nested JIT-inside-a-running-JIT-process falls back to the tree-walk
#      interpreter, which has no `rt_mem_attr_*` SFFI registration. A genuine
#      top-level `simple run <fixture>` does not hit this (fresh process, real
#      native compile), so this harness spawns the target fixture as a real
#      OS subprocess (of the SAME already-deployed `bin/simple` this test
#      itself runs against) instead of calling `cli_handle_run` in-process.
#
# What's still under test end-to-end, unmodified from the production library:
# `resolve_mem_infra`/`mem_infra_env_assignments` (std.common.mem_infra.config)
# and `parse_global_flags`/`apply_fault_detection`
# (app.cli._CliMain.args_and_os_commands) — the actual CLI-flag-wiring surface
# this spec verifies. `apply_mem_infra_flags`'s own ~15 lines are mirrored
# here (not reimplemented differently) because importing it from
# main_and_help.spl is what triggers pitfall 1 above.
use app.cli._CliMain.args_and_os_commands.{GlobalFlags, parse_global_flags, apply_fault_detection}
use app.io.env_ops.{env_set}
use app.io.cli_ops.{_cli_eprint}
use std.io_runtime.{process_run}
use std.common.mem_infra.config.{resolve_mem_infra, mem_infra_env_assignments}

# Workaround: native codegen string == is broken (length-only comparison) —
# mirrors main_and_help.spl's own str_eq workaround.
fn str_eq(a: text, b: text) -> bool:
    a.len() == b.len() and a.starts_with(b)

# Mirrors main_and_help.spl::mem_infra_effective_backend exactly.
fn mem_infra_effective_backend(flags: GlobalFlags) -> text:
    if flags.force_interpret:
        return "interpreter"
    if str_eq(flags.backend, "auto"):
        return "cranelift"
    return flags.backend

fn apply_mem_infra_env_assignment(assignment: text):
    val parts = assignment.split("=")
    if parts.len() >= 2:
        val _ = env_set(parts[0], parts[1])

# Mirrors main_and_help.spl::apply_mem_infra_flags exactly.
fn apply_mem_infra_flags(flags: GlobalFlags) -> i64:
    if flags.mem_infra_requested.len() == 0:
        return 0
    val backend = mem_infra_effective_backend(flags)
    val plan = resolve_mem_infra(flags.mem_infra_requested, backend, flags.mem_infra_strict)
    for notice in plan.notices:
        _cli_eprint("mem-infra: {notice}")
    if plan.errors.len() > 0:
        for err in plan.errors:
            _cli_eprint("mem-infra: {err}")
        return 2
    for assignment in mem_infra_env_assignments(plan):
        if assignment.starts_with("BUILD:"):
            val marker = assignment[6:]
            _cli_eprint("mem-infra: '{marker}' is a build-time flag; deferred to build wiring (no runtime env applied)")
        else:
            apply_mem_infra_env_assignment(assignment)
    return 0

# Raw process argv, as returned by rt_cli_get_args(), is
# [this_script_path, ...cli_args] — unlike the OS-level argv, it has already
# had the binary name stripped, and (verified empirically: `simple run
# <script> <args>` and `simple <script> <args>` both yield the identical
# sequence here) does NOT retain an explicit "run" subcommand token as a
# separate leading element either way. Strip only the script path itself
# (index 0); everything after it is this fixture's own cli_args.
extern fn rt_cli_get_args() -> [text]

fn dispatch_probe_args() -> [text]:
    val raw = rt_cli_get_args()
    var out: [text] = []
    var i = 1
    while i < raw.len():
        out.push(raw[i])
        i = i + 1
    out

fn main() -> i64:
    val args = dispatch_probe_args()

    val flags = parse_global_flags(args)
    apply_fault_detection(flags)

    val mem_infra_exit = apply_mem_infra_flags(flags)
    if mem_infra_exit != 0:
        return mem_infra_exit

    if args.len() > 0 and args[0] == "run":
        var subprocess_args: [text] = ["run"]
        var i = 1
        while i < args.len():
            subprocess_args.push(args[i])
            i = i + 1
        # Real OS subprocess (inherits the env vars apply_mem_infra_flags just
        # set via env_set), not an in-process call — see header comment.
        val (out, err, code) = process_run("bin/simple", subprocess_args)
        print out
        if err != "":
            _cli_eprint(err)
        return code

    print "cli_dispatch_probe: unsupported args[0] (expected 'run')"
    1
