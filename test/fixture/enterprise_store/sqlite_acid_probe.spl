use std.nogc_sync_mut.io.sqlite_sffi

fn main():
    var path = "/tmp/acidprobe/p1.db"
    var conn = sqlite_open(path)
    sqlite_execute(conn, "CREATE TABLE IF NOT EXISTS t (id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE)")
    sqlite_execute(conn, "DELETE FROM t")
    print("start_count=" + sqlite_count(conn, "t").to_text())
    sqlite_begin(conn)
    sqlite_execute(conn, "INSERT INTO t (id, name) VALUES (1, 'alpha')")
    print("in_tx_count=" + sqlite_count(conn, "t").to_text())
    sqlite_rollback(conn)
    print("after_rollback_count=" + sqlite_count(conn, "t").to_text())
    sqlite_execute(conn, "INSERT INTO t (id, name) VALUES (2, 'beta')")
    var dup_ok = sqlite_execute(conn, "INSERT INTO t (id, name) VALUES (3, 'beta')")
    print("dup_insert_ok=" + dup_ok.to_text())
    print("final_count=" + sqlite_count(conn, "t").to_text())
    sqlite_close(conn)
