use app.bootstrap_builder.cli_args.{builder_cli_parse_v1}

fn main() -> i64:
    val run = builder_cli_parse_v1(["run", "--manifest", "D:/build lane/tasks.sdn", "--state", "D:/build lane/state"])
    if not (run.error == ""): return 1
    if not (run.manifest == "D:/build lane/tasks.sdn"): return 2
    if not (builder_cli_parse_v1(["worker", "--request", "task.sdn", "--attempt-root", "attempt", "--host", "local"]).error == ""): return 3
    if not (builder_cli_parse_v1(["worker", "--request", "task.sdn"]).error != ""): return 4
    if not (builder_cli_parse_v1(["check", "--manifest", "a", "--manifest", "b"]).error != ""): return 5
    if not (builder_cli_parse_v1(["run", "--manifest"]).error != ""): return 6
    if not (builder_cli_parse_v1(["check", "--manifest", "a", "--state", "b"]).error != ""): return 7
    if not (builder_cli_parse_v1(["run", "--manifest", "--state", "b"]).error != ""): return 8
    if not (builder_cli_parse_v1(["other"]).error != ""): return 9
    if not (builder_cli_parse_v1([]).error != ""): return 10
    if not (builder_cli_parse_v1(["run", "--manifest", "tasks.sdn"]).error != ""): return 11
    if not (builder_cli_parse_v1(["check"]).error != ""): return 12
    if not (builder_cli_parse_v1(["check", "--manifest", "tasks.sdn"]).error == ""): return 13
    if not (builder_cli_parse_v1(["--help"]).error == ""): return 14
    print "BUILDER_CLI_ARGS_PASS"
    0
