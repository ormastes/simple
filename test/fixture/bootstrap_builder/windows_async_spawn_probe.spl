# Focused native regression probe for the canonical process facade.
use app.io.process_ops.{process_run_timeout, process_spawn_async, process_wait}

fn main() -> i64:
    val program = "C:/Windows/System32/cmd.exe"
    val args = ["/d", "/c", "exit", "0"]
    val synchronous = process_run_timeout(program, args, 5000)
    print "spawn-probe synchronous-exit={synchronous.2}"
    val child = process_spawn_async(program, args)
    print "spawn-probe asynchronous-handle={child}"
    if child <= 0:
        return 1
    val status = process_wait(child, 5000)
    print "spawn-probe asynchronous-exit={status}"
    if status != 0:
        return 2
    0
