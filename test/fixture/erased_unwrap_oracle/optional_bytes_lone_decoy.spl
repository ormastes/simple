# Oracle fixture: bare `.unwrap()` on a `[u8]?` local with exactly ONE foreign
# `*.unwrap` method linked in. The lone `Dec.unwrap` is registered in func_ids
# under its raw and mangled keys (2 candidates, 1 FuncId); codegen used to take
# that same-FuncId shortcut before the Optional/Result helper refusal, so the
# Optional unwrap called `Dec.unwrap` and the array came back empty. This is
# the shape that broke `file_read_regular_no_follow_bounded_bytes` (and so the
# hello-world native-build inventory) under the JIT driver, 2026-10-31.
class Dec:
    var v: i64

    fn unwrap() -> i64:
        self.v

fn make_bytes() -> [u8]?:
    var out: [u8] = []
    out.push(1)
    out.push(2)
    out.push(3)
    Some(out)

fn read_len() -> i64:
    var content: [u8]? = nil
    content = make_bytes()
    if content.?:
        val value = content.unwrap()
        return value.len()
    -1

fn main():
    var dec = Dec(v: 7)
    print("DECOY=" + dec.unwrap().to_string() + "\n")
    print("OPTIONAL_BYTES_UNWRAP=" + read_len().to_string() + "\n")
