# RED probe for the `.unwrap()` binding chain.
#
# `Aaa.unwrap()` and `Aaa.ping()` are the SAME class, the SAME concretely-typed
# receiver, and the same call-site shape. `ping` returns correctly; `unwrap`
# does not. That isolates the fault to the resolution of the NAME `unwrap`,
# with `ping` as the built-in control for "user methods work at all here".
use test.fixture.erased_unwrap_oracle.dec_a_mod.{Aaa}

class Payload:
    var n: i64

    fn get_n() -> i64:
        self.n

class Holder:
    var owner: Payload?

    fn take() -> i64:
        val p = self.owner.unwrap()
        p.n

fn main():
    var a = Aaa(v: 1)
    # CONTROL: an ordinary user method on the same receiver. Must print 1.
    print("CONTROL_PING=" + a.ping().to_string() + "\n")
    # NAME CONTROL: byte-identical body to `unwrap`, differing ONLY in name.
    # Must print 111. If this prints 111 while CONCRETE_UNWRAP does not, the
    # fault is isolated to the NAME `unwrap`, not to the class, receiver,
    # body, call shape, or module.
    print("NAME_CONTROL=" + a.unwrap_ctl().to_string() + "\n")
    # PROBE: a user method named `unwrap` on the same receiver. Must print 111.
    print("CONCRETE_UNWRAP=" + a.unwrap().to_string() + "\n")
    # REFERENCE: erased-receiver unwrap. Binds correctly today; must print 4242.
    var h = Holder(owner: Payload(n: 4242))
    print("ERASED_UNWRAP=" + h.take().to_string() + "\n")
