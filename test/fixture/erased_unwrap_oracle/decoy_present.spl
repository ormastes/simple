# Oracle fixture: erased-receiver `.unwrap()` vs a foreign `*_dot_unwrap`.
# `Holder.take` unwraps an Option whose receiver type is erased (class field
# read). If codegen resolves `unwrap` by NAME-SUFFIX over func_ids instead of
# by receiver type, it binds to `Dec.unwrap` (the only other `_dot_unwrap`
# linked in), which matches neither Some tag and returns 0.
class Dec:
    var v: i64

    fn unwrap() -> i64:
        self.v

class Payload:
    var n: i64

class Holder:
    var owner: Payload?

    fn take() -> i64:
        val p = self.owner.unwrap()
        p.n

fn main():
    var dec = Dec(v: 7)
    val d = dec.unwrap()
    print("DECOY=" + d.to_string() + "\n")
    var h = Holder(owner: Payload(n: 4242))
    print("ERASED_UNWRAP=" + h.take().to_string() + "\n")
