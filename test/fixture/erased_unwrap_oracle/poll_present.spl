use std.async.poll.{Poll}
class Payload:
    var n: i64

class Holder:
    var owner: Payload?

    fn take() -> i64:
        val p = self.owner.unwrap()
        p.n

fn main():
    val pv = Poll.Ready(7).unwrap()
    print("POLL=" + pv.to_string())
    var h = Holder(owner: Payload(n: 4242))
    val got = h.take()
    print("ERASED_UNWRAP=" + got.to_string())
