# Fixture for test/01_unit/compiler/interpreter_extern/sdl3_registration_spec.spl.
# Calls a real rt_sdl3_* extern that previously had no entry in
# EXTERN_DISPATCH and no path to the linked C implementation (lane R1).
# Before the fix this died with `unknown extern function: rt_sdl3_init`.
# On this host libSDL3.so.0 (and the libspl_sdl3 satellite) are both absent,
# so a resolved call still errors -- but with an SDL3-specific message, not
# the generic "unknown extern function" text. That text change is the
# resolution oracle this fixture exists to prove.

extern fn rt_sdl3_init() -> i64

fn main() -> i64:
    val ctx = rt_sdl3_init()
    print "sdl3_init_result={ctx}"
    0
