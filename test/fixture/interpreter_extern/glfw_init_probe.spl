# Fixture for test/01_unit/compiler/interpreter_extern/glfw_registration_spec.spl.
# Calls a real rt_glfw_* extern that previously had no entry in
# EXTERN_DISPATCH and no path to the linked C implementation (lane R1).
# Before the fix this died with `unknown extern function: rt_glfw_init`.
# On this host libglfw.so.3 (and the libspl_glfw satellite) are both absent,
# so a resolved call still errors -- but with a GLFW-specific message, not
# the generic "unknown extern function" text. That text change is the
# resolution oracle this fixture exists to prove.

extern fn rt_glfw_init() -> i64

fn main() -> i64:
    val ctx = rt_glfw_init()
    print "glfw_init_result={ctx}"
    0
