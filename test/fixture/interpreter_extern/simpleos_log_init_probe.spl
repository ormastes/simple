# Fixture for test/01_unit/compiler/interpreter_extern/fb_image_log_socket_registration_spec.spl.
# Calls a real rt_simpleos_log_* extern via the hosted fallback
# implementation (src/runtime/startup/common/runtime_log_hosted.c), which
# unconditionally returns false -- that is the documented, correct hosted
# behavior (the Simple-side log lib falls through to println when this
# returns false), not a stand-in for missing work. Before the fix this died
# with `unknown extern function: rt_simpleos_log_init` instead of resolving
# to that real (if trivial) hosted fallback.

extern fn rt_simpleos_log_init(level: i64, targets: i64) -> bool

fn main() -> i64:
    val ok = rt_simpleos_log_init(0, 1)
    print "simpleos_log_init_result={ok}"
    0
