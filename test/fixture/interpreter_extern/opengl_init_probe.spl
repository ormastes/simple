# Fixture for test/01_unit/compiler/interpreter_extern/opengl_registration_spec.spl.
# Calls a real rt_opengl_* extern that previously had no entry in
# EXTERN_DISPATCH and no path to the linked C implementation (lane R2:
# runtime_native.c was absent from the C sources
# src/compiler_rust/runtime/build.rs compiles). Before the fix this died with
# `unknown extern function: rt_opengl_init`. The C implementation
# (src/runtime/runtime_native.c) is a fixed-value capability stub, so a
# resolved call returns -3 (unavailable), not an unknown-extern error.

extern fn rt_opengl_init(width: i64, height: i64) -> i64

fn main() -> i64:
    val ctx = rt_opengl_init(64, 64)
    print "opengl_init_result={ctx}"
    0
