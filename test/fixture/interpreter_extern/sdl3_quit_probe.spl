# Fixture for test/01_unit/compiler/interpreter_extern/sdl3_registration_spec.spl.
# Calls a second rt_sdl3_* entry point (void return, not just rt_sdl3_init)
# to prove the family dispatch table covers more than one symbol, not just
# the one exercised by the init probe.

extern fn rt_sdl3_quit()

fn main() -> i64:
    rt_sdl3_quit()
    print "sdl3_quit_completed"
    0
