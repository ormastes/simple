# Fixture for test/01_unit/compiler/interpreter_extern/oneapi_registration_spec.spl.
# Calls a name in the rt_oneapi_ prefix that has no C definition in
# runtime_native.c. This must return the family-scoped guard refusal
# ("unknown rt_oneapi_* function"), not a crash, and not the generic
# "unknown extern function" text a truly unregistered name would produce.

extern fn rt_oneapi_zzz_bogus() -> i64

fn main() -> i64:
    val n = rt_oneapi_zzz_bogus()
    print "unexpected success: n={n}"
    0
