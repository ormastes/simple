# Fixture for test/01_unit/compiler/interpreter_extern/fb_image_log_socket_registration_spec.spl.
# Calls the real rt_socket_set_nonblocking extern, extracted verbatim from
# src/runtime/platform/async_linux_epoll.c (gated to Linux only, and never
# compiled by either C-source list that gates linkage) into the standalone,
# portable src/runtime/runtime_socket_nonblock.c. Before the fix this died
# with `unknown extern function: rt_socket_set_nonblocking`. fd=-1 is never a
# valid descriptor, so fcntl(F_GETFL) fails and the C implementation returns
# false cleanly (see runtime_socket_nonblock.c) -- deterministic and
# side-effect-free.

extern fn rt_socket_set_nonblocking(fd: i64, enabled: bool) -> bool

fn main() -> i64:
    val ok = rt_socket_set_nonblocking(-1, true)
    print "socket_nonblock_result={ok}"
    0
