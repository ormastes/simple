# @naked twin of src/runtime/startup/linux/x86_64/start.S pasted VERBATIM (bare `$`)
@naked
@section(".text.boot")
@global
fn _start_twin():
    asm {
        xor %rbp, %rbp
        mov (%rsp), %rdi
        lea 8(%rsp), %rsi
        lea 8(%rsi,%rdi,8), %rdx
        and $~0xF, %rsp
        call __spl_start
        ud2
    }

fn main():
    print "ok"
