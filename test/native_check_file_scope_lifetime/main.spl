use app.io.minimal_runtime_ops.{get_args}
use std.nogc_sync_mut.io.process_ops.{eprint}
use app.check.main.{check_one_full}

fn main() -> i64:
    val args = get_args()
    if args.len() != 5: return 2
    for index in 1..5:
        val expected = if index == 3: 1 else: 0
        val counts: (i64, i64) = check_one_full(args[index], true, false, false, index, 4)
        if counts.0 != expected or counts.1 != 0: return 10 + index
    print "native repeated file scope lifetime PASS"
    0
