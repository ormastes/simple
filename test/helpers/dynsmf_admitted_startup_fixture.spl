use std.common.aspect_pack.{
    ApkModuleSourceV2,
    AspectFacetDescriptor,
    AspectPackBinding,
    AspectCatalogEntry,
    apk_build_pack_v2,
    aspect_catalog_build
}
use std.common.crypto.sha256.{sha256_u8_hex}
use compiler.backend.linker.smf_writer.{
    SmfWriter,
    SmfWriterSymbol,
    SmfWriterSymbolBinding,
    SmfWriterSymbolType,
    smf_build_aspect_pack_image
}
use os.smf.aspect_pack_directory.{
    AspectPackDirectory,
    AspectPackArtifactIdentity,
    AspectPackExportContract,
    AspectPackLookupRequest,
    aspect_pack_directory_parse_from_outer_smf_bytes
}
use std.common.aspect_pack.{AspectCatalog}
use os.smf.dynsmf_manifest_contract.{DynSmfManifestEntry}

class DynSmfAdmittedStartupFixture:
    artifact_bytes: [u8]
    manifest: [DynSmfManifestEntry]
    request: AspectPackLookupRequest

fn _dynsmf_fixture_empty() -> DynSmfAdmittedStartupFixture:
    DynSmfAdmittedStartupFixture(
        artifact_bytes: [], manifest: [],
        request: AspectPackLookupRequest(
            directory: AspectPackDirectory(
                schema_version: 0, flags: 0, total_size: 0,
                content_hash: "", entries: []),
            catalog: AspectCatalog(schema_version: 0, entries: []),
            manifest: [], artifact: AspectPackArtifactIdentity(
                library_id: "", path: "", content_hash: ""),
            export_contracts: [], facet_id: ""))

@cfg(x86_64)
fn _dynsmf_fixture_host_arch_byte() -> u8: 0

@cfg(arm64)
fn _dynsmf_fixture_host_arch_byte() -> u8: 1

@cfg(x86)
fn _dynsmf_fixture_host_arch_byte() -> u8: 2

@cfg(arm32)
fn _dynsmf_fixture_host_arch_byte() -> u8: 3

@cfg(riscv64)
fn _dynsmf_fixture_host_arch_byte() -> u8: 4

@cfg(riscv32)
fn _dynsmf_fixture_host_arch_byte() -> u8: 5

@cfg(x86_64)
fn _dynsmf_fixture_return42_code() -> [i64]:
    # mov eax, 42; ret
    [184, 42, 0, 0, 0, 195]

@cfg(arm64)
fn _dynsmf_fixture_return42_code() -> [i64]:
    # mov w0, #42; ret (AArch64 little-endian words)
    [64, 5, 128, 82, 192, 3, 95, 214]

@cfg(x86)
fn _dynsmf_fixture_return42_code() -> [i64]:
    # mov eax, 42; ret
    [184, 42, 0, 0, 0, 195]

@cfg(arm32)
fn _dynsmf_fixture_return42_code() -> [i64]:
    # mov r0, #42; bx lr (ARM little-endian words)
    [42, 0, 160, 227, 30, 255, 47, 225]

@cfg(riscv64)
fn _dynsmf_fixture_return42_code() -> [i64]:
    # addi a0, zero, 42; ret (RV64 little-endian words)
    [19, 5, 160, 2, 103, 128, 0, 0]

@cfg(riscv32)
fn _dynsmf_fixture_return42_code() -> [i64]:
    # addi a0, zero, 42; ret (RV32 little-endian words)
    [19, 5, 160, 2, 103, 128, 0, 0]

fn _dynsmf_fixture_nested_smf_sections(
        export_symbol: text, section_count: i64) -> [u8]:
    var writer = SmfWriter.create()
    val code = _dynsmf_fixture_return42_code()
    var section_index: i64 = 0
    while section_index < section_count:
        writer.add_code_section("code_" + section_index.to_string(), code)
        section_index = section_index + 1
    writer.add_symbol(SmfWriterSymbol(
        name: export_symbol,
        binding: SmfWriterSymbolBinding.Global,
        sym_type: SmfWriterSymbolType.Function,
        section_index: 0,
        value: 0,
        size: code.len(),
        layout_phase: 0,
        is_event_loop_anchor: false,
        layout_pinned: false
    ))
    val built = writer.write()
    var bytes: [u8] = []
    match built:
        case Ok(words):
            for word in words:
                bytes.push(word as u8)
        case Err(_):
            return []
    bytes

fn _dynsmf_admitted_startup_fixture_sections(library_id: text, path: text,
        source_module: text, abi_version: text, export_symbol: text,
        default_autoload: bool, section_count: i64
    ) -> DynSmfAdmittedStartupFixture:
    val facet_id = "startup/" + library_id
    val module_id = library_id + ".module"
    val modules = [
        ApkModuleSourceV2(
            module_id: module_id,
            aspect_id: "startup.aspect",
            module_abi_hash: "startup-module-abi",
            required_core_public_abi_hash: "startup-core-abi",
            variant_fingerprint: "startup-test",
            payload: _dynsmf_fixture_nested_smf_sections(
                export_symbol, section_count)
        )
    ]
    val pack_built = apk_build_pack_v2(modules)
    if not pack_built.ok:
        return _dynsmf_fixture_empty()
    val pack_bytes = pack_built.bytes
    val artifact_built = smf_build_aspect_pack_image(pack_bytes)
    var artifact_bytes: [u8] = []
    match artifact_built:
        case Ok(bytes): artifact_bytes = bytes
        case Err(_): return _dynsmf_fixture_empty()
    # smf_build_aspect_pack_image currently carries an x86-64 default header.
    # The nested writer already emits host arch; make this provider header
    # target-correct too without changing production writer behavior in this
    # test-only fixture.
    val header_offset = artifact_bytes.len() - 128
    if header_offset < 0 or header_offset + 7 >= artifact_bytes.len():
        return _dynsmf_fixture_empty()
    artifact_bytes[header_offset + 7] = _dynsmf_fixture_host_arch_byte()
    val parsed = aspect_pack_directory_parse_from_outer_smf_bytes(artifact_bytes)
    if not parsed.ok:
        return _dynsmf_fixture_empty()
    val manifest = [
        DynSmfManifestEntry(
            id: library_id,
            path: path,
            source_module: source_module,
            artifact_kind: "precompiled_smf",
            abi_version: abi_version,
            default_autoload: default_autoload,
            exports: [export_symbol]
        )
    ]
    val entries = [
        AspectCatalogEntry(
            descriptor: AspectFacetDescriptor(
                facet_id: facet_id,
                export_symbol: export_symbol,
                interface_abi_hash: "startup-facet-abi"
            ),
            binding: AspectPackBinding(
                facet_id: facet_id,
                aspect_id: "startup.aspect",
                library_id: library_id,
                library_path: path,
                library_abi_version: abi_version,
                module_id: module_id,
                module_abi_hash: "startup-module-abi",
                pack_content_hash: parsed.directory.content_hash,
                placement: "dynamic"
            )
        )
    ]
    val built_catalog = aspect_catalog_build(entries)
    if not built_catalog.ok:
        return _dynsmf_fixture_empty()
    val artifact = AspectPackArtifactIdentity(
        library_id: library_id,
        path: path,
        content_hash: sha256_u8_hex(artifact_bytes)
    )
    val contracts = [
        AspectPackExportContract(
            library_id: library_id,
            export_symbol: export_symbol,
            interface_abi_hash: "startup-facet-abi"
        )
    ]
    val request = AspectPackLookupRequest(
        directory: parsed.directory,
        catalog: built_catalog.catalog,
        manifest: manifest,
        artifact: artifact,
        export_contracts: contracts,
        facet_id: facet_id
    )
    DynSmfAdmittedStartupFixture(artifact_bytes: artifact_bytes, manifest: manifest, request: request)

fn dynsmf_admitted_startup_fixture(library_id: text, path: text,
        source_module: text, abi_version: text, export_symbol: text,
        default_autoload: bool) -> DynSmfAdmittedStartupFixture:
    _dynsmf_admitted_startup_fixture_sections(
        library_id, path, source_module, abi_version, export_symbol,
        default_autoload, 1)

fn dynsmf_admitted_startup_fixture_sections(library_id: text, path: text,
        source_module: text, abi_version: text, export_symbol: text,
        default_autoload: bool, section_count: i64
    ) -> DynSmfAdmittedStartupFixture:
    if section_count <= 0 or section_count > 4096:
        return _dynsmf_fixture_empty()
    _dynsmf_admitted_startup_fixture_sections(
        library_id, path, source_module, abi_version, export_symbol,
        default_autoload, section_count)

export DynSmfAdmittedStartupFixture, dynsmf_admitted_startup_fixture
export dynsmf_admitted_startup_fixture_sections
