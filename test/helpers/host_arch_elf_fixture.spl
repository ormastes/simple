"""Host-architecture ELF fixture helpers for loader/launch specs.

Launch specs must build images for the architecture the kernel reports
(`get_arch()`), never a hard-coded one, so they adopt on any host.
"""

use os.kernel.arch.arch_context.{Architecture}
use os.kernel.arch.mod.{get_arch}

fn host_elf_machine() -> i64:
    """ELF e_machine for the architecture the kernel reports."""
    match get_arch():
        Architecture.Arm64: 183
        Architecture.Arm32: 40
        Architecture.Riscv64: 243
        Architecture.Riscv32: 243
        Architecture.X86: 3
        Architecture.X86_64: 62

fn foreign_arch() -> Architecture:
    """An architecture guaranteed to differ from the host."""
    if get_arch() == Architecture.Arm64: Architecture.X86_64 else: Architecture.Arm64

export host_elf_machine, foreign_arch
