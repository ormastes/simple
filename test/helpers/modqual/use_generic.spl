# Resolution step: generic types with a colliding name, one per module,
# imported into the SAME module under different local names.
use test.helpers.modqual.geo_a.{Pair as PairA}
use test.helpers.modqual.geo_b.{Pair as PairB}

pub fn generic_a_total(x: f64, y: f64) -> f64:
    val p = PairA(first: x, second: y)
    p.total()

pub fn generic_b_total(x: f64) -> f64:
    val p = PairB(only: x)
    p.total()
