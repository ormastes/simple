# Consumer of geo_a: every bare `Vec3`/`Config`/`Mode` here must resolve
# through THIS module's import, not whichever same-named type registered last.
use test.helpers.modqual.geo_a.{Vec3, Config, Mode, mode_label}

pub fn a_vec_zero_sum() -> f64:
    val v = Vec3.zero()
    v.sum()

pub fn a_vec_unit_sum() -> f64:
    val v = Vec3.unit()
    v.sum()

pub fn a_vec_literal_sum(x: f64, y: f64, z: f64) -> f64:
    val v = Vec3(x: x, y: y, z: z)
    v.sum()

pub fn a_config_backend() -> text:
    val c = Config.default()
    c.backend

pub fn a_config_label(name: text) -> text:
    val c = Config(backend: name)
    c.label()

pub fn a_mode() -> text:
    mode_label(Mode.Fast)

pub fn a_vec_make(x: f64, y: f64, z: f64) -> Vec3:
    Vec3(x: x, y: y, z: z)

pub fn a_config_make(name: text) -> Config:
    Config(backend: name)
