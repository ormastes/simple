# Fixture B for the module-qualified type registry repro: same three type
# names as geo_a.spl (`Vec3`, `Config`, `Mode`), declared as `struct` + `impl`
# (the physics/config.spl shape). `Vec3` has 2 components and ONLY `one` +
# `unit` (no `zero`); `unit().sum()` is 2.0 here vs 3.0 in A; `Config`'s
# only field is `mode`; `Mode` has a different variant set.
pub struct Vec3:
    x: f64
    y: f64

impl Vec3:
    static fn one() -> Vec3:
        Vec3(x: 1.0, y: 1.0)

    static fn unit() -> Vec3:
        Vec3(x: 1.0, y: 1.0)

    fn sum() -> f64:
        self.x + self.y

pub struct Config:
    mode: int

impl Config:
    static fn default() -> Config:
        Config(mode: 7)

    fn label() -> text:
        "B:" + self.mode.to_string()

pub enum Mode:
    Slow
    Loud

pub fn mode_label(m: Mode) -> text:
    match m:
        case Mode.Slow: "b-slow"
        case Mode.Loud: "b-loud"
