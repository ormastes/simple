# Fixture A for the module-qualified type registry repro. Mirrors the real
# collision (`std.common.engine.math3d.Vec3`, a `class` with inline static
# methods, vs `physics/config.spl`'s `struct Vec3` + `impl`): a 3-component
# `Vec3` whose statics are INLINE in the class body (`zero`, `unit`), a
# `Config` class whose only field is `backend`, and an enum `Mode`.
# geo_b.spl defines the same three names with different shapes.
pub class Vec3:
    x: f64
    y: f64
    z: f64

    static fn zero() -> Vec3:
        Vec3(x: 0.0, y: 0.0, z: 0.0)

    static fn unit() -> Vec3:
        Vec3(x: 1.0, y: 1.0, z: 1.0)

    fn sum() -> f64:
        self.x + self.y + self.z

pub class Config:
    backend: text

    static fn default() -> Config:
        Config(backend: "cpu")

    fn label() -> text:
        "A:" + self.backend

pub enum Mode:
    Fast
    Safe

pub fn mode_label(m: Mode) -> text:
    match m:
        case Mode.Fast: "a-fast"
        case Mode.Safe: "a-safe"

# Generic type whose name collides with geo_b's `Pair<T>` (different fields).
pub class Pair<T>:
    first: T
    second: T

    fn total() -> f64:
        self.first + self.second
