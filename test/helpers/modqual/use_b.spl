# Consumer of geo_b: mirror of use_a.spl against the OTHER same-named types.
use test.helpers.modqual.geo_b.{Vec3, Config, Mode, mode_label}

pub fn b_vec_one_sum() -> f64:
    val v = Vec3.one()
    v.sum()

pub fn b_vec_unit_sum() -> f64:
    val v = Vec3.unit()
    v.sum()

pub fn b_vec_literal_sum(x: f64, y: f64) -> f64:
    val v = Vec3(x: x, y: y)
    v.sum()

pub fn b_config_mode() -> int:
    val c = Config.default()
    c.mode

pub fn b_config_label(n: int) -> text:
    val c = Config(mode: n)
    c.label()

pub fn b_mode() -> text:
    mode_label(Mode.Loud)

pub fn b_vec_make(x: f64, y: f64) -> Vec3:
    Vec3(x: x, y: y)

pub fn b_config_make(n: int) -> Config:
    Config(mode: n)
