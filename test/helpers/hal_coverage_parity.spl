# Test-only HAL coverage and parity evidence contract.
#
# This helper deliberately lives outside every HAL owner module.  A HalRun is
# evidence for one bounded manifest only; 10_000 basis points means every
# branch named by that manifest was hit, never that the whole HAL is covered.

use std.common.crypto.sha256.{sha256_text}

enum HalEvidenceScope:
    HostExecutable
    PhysicalBoard

enum HalImplementation:
    CHal
    SimpleHal

struct HalHashReceipt:
    input_checksum: text
    expected_output_checksum: text
    actual_output_checksum: text

struct HalBranchReceipt:
    branch_id: text
    hit_count: i64

struct HalEvent:
    event_id: text
    implementation: HalImplementation
    evidence_scope: HalEvidenceScope
    branch_id: text
    fallback_used: bool
    hashes: HalHashReceipt

struct HalFixture:
    case_id: text
    manifest_id: text
    evidence_scope: HalEvidenceScope
    input_checksum: text
    expected_output_checksum: text
    required_branches: [text]
    manifest_checksum: text

struct HalRun:
    case_id: text
    manifest_id: text
    implementation: HalImplementation
    evidence_scope: HalEvidenceScope
    required_branches: [text]
    branches: [HalBranchReceipt]
    events: [HalEvent]
    hashes: HalHashReceipt
    manifest_checksum: text
    covered_branch_count: i64
    branch_denominator: i64
    coverage_basis_points: i64
    fallback_count: i64

struct HalEvidenceError:
    code: text
    path: text
    message: text

fn _hal_error(code: text, path: text, message: text) -> HalEvidenceError:
    HalEvidenceError(code: code, path: path, message: message)

fn _contains_branch(branches: [text], wanted: text) -> bool:
    for branch in branches:
        if branch == wanted:
            return true
    false

fn _manifest_checksum(case_id: text, manifest_id: text, branches: [text]) -> text:
    var canonical = "case=" + case_id + "\nmanifest=" + manifest_id + "\n"
    for branch in branches:
        canonical = canonical + "branch=" + branch + "\n"
    sha256_text(canonical)

fn hal_hash_receipt(input_checksum: text, expected_output_checksum: text, actual_output_checksum: text) -> HalHashReceipt:
    HalHashReceipt(
        input_checksum: input_checksum,
        expected_output_checksum: expected_output_checksum,
        actual_output_checksum: actual_output_checksum
    )

fn hal_branch_receipt(branch_id: text, hit_count: i64) -> HalBranchReceipt:
    HalBranchReceipt(branch_id: branch_id, hit_count: hit_count)

fn hal_event(
    event_id: text,
    implementation: HalImplementation,
    evidence_scope: HalEvidenceScope,
    branch_id: text,
    fallback_used: bool,
    hashes: HalHashReceipt
) -> HalEvent:
    HalEvent(
        event_id: event_id,
        implementation: implementation,
        evidence_scope: evidence_scope,
        branch_id: branch_id,
        fallback_used: fallback_used,
        hashes: hashes
    )

fn prepare_hal_fixture(
    case_id: text,
    manifest_id: text,
    evidence_scope: HalEvidenceScope,
    input_payload: text,
    expected_output_payload: text,
    required_branches: [text]
) -> HalFixture:
    HalFixture(
        case_id: case_id,
        manifest_id: manifest_id,
        evidence_scope: evidence_scope,
        input_checksum: sha256_text(input_payload),
        expected_output_checksum: sha256_text(expected_output_payload),
        required_branches: required_branches,
        manifest_checksum: _manifest_checksum(case_id, manifest_id, required_branches)
    )

fn _run_hal_case(
    fixture: HalFixture,
    implementation: HalImplementation,
    hit_branches: [text],
    actual_output_payload: text,
    fallback_used: bool
) -> HalRun:
    val hashes = hal_hash_receipt(
        fixture.input_checksum,
        fixture.expected_output_checksum,
        sha256_text(actual_output_payload)
    )
    var branches: [HalBranchReceipt] = []
    var covered: i64 = 0
    for required in fixture.required_branches:
        val hits: i64 = if _contains_branch(hit_branches, required): 1 else: 0
        branches = branches.push(hal_branch_receipt(required, hits))
        if hits > 0:
            covered = covered + 1

    var events: [HalEvent] = []
    var event_index: i64 = 0
    for hit in hit_branches:
        events = events.push(hal_event(
            fixture.case_id + ":" + event_index.to_text(),
            implementation,
            fixture.evidence_scope,
            hit,
            fallback_used,
            hashes
        ))
        event_index = event_index + 1

    val denominator = fixture.required_branches.len()
    val basis_points: i64 = if denominator > 0: (covered * 10000) / denominator else: 0
    HalRun(
        case_id: fixture.case_id,
        manifest_id: fixture.manifest_id,
        implementation: implementation,
        evidence_scope: fixture.evidence_scope,
        required_branches: fixture.required_branches,
        branches: branches,
        events: events,
        hashes: hashes,
        manifest_checksum: fixture.manifest_checksum,
        covered_branch_count: covered,
        branch_denominator: denominator,
        coverage_basis_points: basis_points,
        fallback_count: if fallback_used: 1 else: 0
    )

fn run_c_hal_case(fixture: HalFixture, hit_branches: [text], actual_output_payload: text, fallback_used: bool) -> HalRun:
    _run_hal_case(fixture, HalImplementation.CHal, hit_branches, actual_output_payload, fallback_used)

fn run_simple_hal_case(fixture: HalFixture, hit_branches: [text], actual_output_payload: text, fallback_used: bool) -> HalRun:
    _run_hal_case(fixture, HalImplementation.SimpleHal, hit_branches, actual_output_payload, fallback_used)

fn assert_hal_branch_coverage(run: HalRun) -> Result<HalRun, HalEvidenceError>:
    if run.branch_denominator <= 0:
        return Err(_hal_error("zero-denominator", "branch_denominator", "HAL coverage needs a nonzero manifest denominator"))
    if run.required_branches.len() != run.branch_denominator:
        return Err(_hal_error("manifest-count-mismatch", "required_branches", "manifest branch count differs from the denominator"))
    if run.branches.len() != run.branch_denominator:
        return Err(_hal_error("receipt-count-mismatch", "branches", "one branch receipt is required per manifest branch"))
    val expected_manifest = _manifest_checksum(run.case_id, run.manifest_id, run.required_branches)
    if run.manifest_checksum != expected_manifest:
        return Err(_hal_error("manifest-checksum-mismatch", "manifest_checksum", "branch manifest checksum does not match its declared branches"))

    var covered: i64 = 0
    var index: i64 = 0
    for receipt in run.branches:
        if receipt.branch_id != run.required_branches[index]:
            return Err(_hal_error("branch-order-mismatch", "branches", "branch receipt does not match the manifest entry"))
        if receipt.hit_count <= 0:
            return Err(_hal_error("missing-branch", receipt.branch_id, "required HAL branch has no execution receipt"))
        covered = covered + 1
        index = index + 1

    for event in run.events:
        if event.implementation != run.implementation or event.evidence_scope != run.evidence_scope:
            return Err(_hal_error("blended-evidence", "events", "event provenance differs from its HAL run"))
        if not _contains_branch(run.required_branches, event.branch_id):
            return Err(_hal_error("undeclared-branch", event.branch_id, "event branch is absent from the bounded manifest"))
        if event.hashes.actual_output_checksum != run.hashes.actual_output_checksum:
            return Err(_hal_error("event-checksum-mismatch", "events", "event and run output checksums differ"))

    if covered != run.covered_branch_count:
        return Err(_hal_error("covered-count-mismatch", "covered_branch_count", "covered count differs from branch receipts"))
    val expected_basis_points = (covered * 10000) / run.branch_denominator
    if run.coverage_basis_points != expected_basis_points:
        return Err(_hal_error("coverage-ratio-mismatch", "coverage_basis_points", "coverage ratio differs from manifest receipts"))
    if run.coverage_basis_points == 10000 and covered != run.branch_denominator:
        return Err(_hal_error("unproven-full-coverage", "coverage_basis_points", "full coverage requires every manifest branch receipt"))
    Ok(run)

fn assert_hal_parity(c_run: HalRun, simple_run: HalRun) -> Result<HalRun, HalEvidenceError>:
    if c_run.implementation != HalImplementation.CHal or simple_run.implementation != HalImplementation.SimpleHal:
        return Err(_hal_error("implementation-order", "implementation", "parity requires C HAL then Simple HAL evidence"))
    if c_run.case_id != simple_run.case_id or c_run.manifest_id != simple_run.manifest_id:
        return Err(_hal_error("fixture-mismatch", "case_id", "parity runs must use the same bounded fixture and manifest"))
    if c_run.evidence_scope != simple_run.evidence_scope:
        return Err(_hal_error("blended-evidence", "evidence_scope", "host-executable and physical-board claims must remain separate"))
    if c_run.fallback_count != 0 or simple_run.fallback_count != 0:
        return Err(_hal_error("fallback-used", "fallback_count", "fallback execution cannot satisfy HAL parity"))
    match assert_hal_branch_coverage(c_run):
        case Err(err): return Err(err)
        case Ok(_valid_c): pass
    match assert_hal_branch_coverage(simple_run):
        case Err(err): return Err(err)
        case Ok(_valid_simple): pass
    if c_run.hashes.expected_output_checksum != simple_run.hashes.expected_output_checksum:
        return Err(_hal_error("fixture-checksum-mismatch", "expected_output_checksum", "parity runs disagree on the expected output"))
    if c_run.hashes.actual_output_checksum != c_run.hashes.expected_output_checksum:
        return Err(_hal_error("checksum-mismatch", "c.actual_output_checksum", "C HAL output differs from the bounded oracle"))
    if simple_run.hashes.actual_output_checksum != simple_run.hashes.expected_output_checksum:
        return Err(_hal_error("checksum-mismatch", "simple.actual_output_checksum", "Simple HAL output differs from the bounded oracle"))
    if c_run.hashes.actual_output_checksum != simple_run.hashes.actual_output_checksum:
        return Err(_hal_error("parity-checksum-mismatch", "actual_output_checksum", "C and Simple HAL outputs differ"))
    Ok(simple_run)
