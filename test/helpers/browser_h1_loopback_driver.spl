"""
# Browser H1 loopback driver

Shared harness that gives the browser engine's HTTP/1.1 network module
(`std.gc_async_mut.gpu.browser_engine.net.h1_client.H1Client`) a REAL peer on a
REAL loopback socket, so a spec can assert on bytes that crossed the kernel
rather than on source text.

Two halves:

* `start_loopback_server()` spawns `test/fixture/net/simple_http_server.spl` as
  a separate OS process. That server calls `TcpListener.bind` ->
  `rt_io_tcp_bind` -> `runtime/src/value/net_tcp.rs` -> `std::net::TcpListener::bind`.
  It is a real listening socket, visible to `ss -ltnp`, and has been driven
  successfully by a non-Simple bash `/dev/tcp` client.

* `browser_h1_get()` drives the real `H1Client`, whose plain-HTTP path calls
  `rt_io_tcp_connect_timeout` / `rt_io_tcp_write_text` / `rt_io_tcp_read`
  directly (`h1_client.spl:344,377,501`). No mock is registered, so
  `h1_mock_response_until` returns nil and the socket path is the only path.

The wire here is plaintext HTTP/1.1. TLS exists on this stack
(`rt_tls_client_connect`, rustls-backed) but needs certificates and is out of
scope for this harness.
"""

#![allow(REQC001)]

use std.gc_async_mut.gpu.browser_engine.net.h1_client.{H1Client}
use std.gc_async_mut.gpu.browser_engine.net.dns.{DnsResolver}
use std.gc_async_mut.gpu.browser_engine.net.tls.{TlsManager}
use std.gc_async_mut.gpu.browser_engine.net.entity.tls_types.{TlsConfig, TlsVersion}
use std.gc_async_mut.gpu.browser_engine.net.entity.request_types.{FetchRequest, RequestMode}
use std.gc_async_mut.gpu.browser_engine.net.entity.url_types.{Url}
use std.gc_async_mut.gpu.browser_engine.shared.logging.{Logger, BrowserLogLevel}
use std.nogc_sync_mut.io.tcp.{TcpStream}

extern fn rt_process_spawn_async(cmd: text, args: [text]) -> i64
extern fn rt_process_kill(pid: i64) -> bool
extern fn rt_process_is_running(pid: i64) -> bool
extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool
extern fn rt_env_get(key: text) -> text
extern fn rt_env_cwd() -> text
extern fn rt_sleep_ms(ms: i64)
extern fn rt_time_now_unix_micros() -> i64
extern fn rt_getpid() -> i64

val SERVER_FIXTURE = "test/fixture/net/simple_http_server.spl"

# The exact body the Simple server writes. A spec that asserts on this is
# asserting on bytes that made a round trip through the kernel.
pub val LOOPBACK_SERVER_BODY = "PONG-FROM-SIMPLE-SERVER-4242"

pub class LoopbackServer:
    """A separate-process Simple web server listening on 127.0.0.1."""
    pid: i64
    addr: text
    port: i64
    portfile: text
    logfile: text
    started: bool

    me stop():
        """Kill the server process and remove its scratch files.

        Always call this, even on failure — otherwise the listener survives the
        run and the handshake files accumulate in the scratch directory.
        """
        if self.pid > 0:
            val _ = rt_process_kill(self.pid)
            self.pid = -1
        if self.portfile != "":
            val _ = rt_file_delete(self.portfile)
        if self.logfile != "":
            val _ = rt_file_delete(self.logfile)

    fn origin() -> text:
        """The http:// origin of the running server."""
        return "http://{self.addr}"

    fn server_log() -> text:
        """Whatever the server process has printed so far."""
        if not rt_file_exists(self.logfile):
            return ""
        val t = rt_file_read_text(self.logfile)
        if t == nil:
            return ""
        return t

    fn wait_for_log(needle: text, timeout_ms: i64) -> bool:
        """Poll the server log until `needle` appears, or time out.

        A bare connect() returns as soon as the kernel completes the handshake,
        which can be before the server process has returned from accept() and
        logged the peer. Without this wait the peer assertions are racy.
        """
        var waited = 0
        while waited < timeout_ms:
            if self.server_log().contains(needle):
                return true
            rt_sleep_ms(25)
            waited = waited + 25
        return self.server_log().contains(needle)

fn scratch_dir() -> text:
    """Directory for the port/log handshake files.

    NOTE: `rt_env_temp()` is NOT used here. Under the spec-runner interpreter it
    returns a raw integer rather than a path (observed: "3330667535009"), which
    silently produced a relative, unwritable portfile and made every example
    fail with an empty server log. `TMPDIR` via `rt_env_get` is text-typed on
    both engines.
    """
    val t = rt_env_get("SIMPLE_TEST_SCRATCH_DIR")
    if t != nil and t != "":
        return t
    val tmp = rt_env_get("TMPDIR")
    if tmp != nil and tmp != "" and tmp.starts_with("/"):
        return tmp
    return "/tmp"

fn repo_root() -> text:
    val r = rt_env_get("SIMPLE_REPO_ROOT")
    if r != nil and r != "":
        return r
    val c = rt_env_cwd()
    if c == nil:
        return "."
    return c

pub fn start_loopback_server(tag: text, max_requests: i64) -> LoopbackServer:
    """Spawn the Simple web server on an ephemeral loopback port.

    Blocks until the server has written its bound address, so the caller knows
    the socket is listening before it connects. Returns a LoopbackServer whose
    `started` is false if the server never came up.
    """
    val root = repo_root()
    val stamp = rt_time_now_unix_micros()
    val me_pid = rt_getpid()
    val dir = scratch_dir()
    val base = "{dir}/simple_h1_loopback_{tag}_{me_pid}_{stamp}"
    val portfile = "{base}.port"
    val logfile = "{base}.log"
    print("H1DRIVER_PORTFILE [{portfile}]")
    print("H1DRIVER_ROOT [{root}]")

    var server = LoopbackServer(
        pid: -1, addr: "", port: -1,
        portfile: portfile, logfile: logfile, started: false
    )

    if rt_file_exists(portfile):
        val _ = rt_file_delete(portfile)

    # `env` sets the child's configuration without a shell and without
    # mutating this process's environment. Output is redirected by the server
    # fixture writing nothing extra; we capture it via a wrapper-free tee is
    # not available, so the server's stdout goes to the spawner's stdout.
    val args = [
        "SIMPLE_TEST_HTTP_PORT=0",
        "SIMPLE_TEST_HTTP_MAX={max_requests}",
        "SIMPLE_TEST_HTTP_PORTFILE={portfile}",
        "SIMPLE_TEST_HTTP_LOGFILE={logfile}",
        "{root}/bin/simple",
        "run",
        "{root}/{SERVER_FIXTURE}"
    ]
    val pid = rt_process_spawn_async("env", args)
    if pid <= 0:
        return server
    server.pid = pid

    # Wait for the bind to complete (portfile appears) — up to ~15s.
    var waited = 0
    var bound = ""
    while waited < 15000:
        if rt_file_exists(portfile):
            val t = rt_file_read_text(portfile)
            if t != nil and t.trim() != "":
                bound = t.trim()
                waited = 15000
        if bound == "":
            rt_sleep_ms(50)
            waited = waited + 50

    if bound == "":
        server.stop()
        return server

    server.addr = bound
    server.started = true
    val colon = bound.last_index_of(":")
    if colon >= 0:
        server.port = bound.substring(colon + 1, bound.len()).to_i64()
    return server

pub class H1Probe:
    """Outcome of one real request over the loopback socket."""
    ok: bool
    status: i64
    headers: text
    body: text
    local_addr: text
    error: text

pub class H1ConnProbe:
    """Outcome of the browser H1 client's socket-open step."""
    ok: bool
    fd: i64
    error: text

pub fn browser_h1_connect(host: text, port: i64, deadline_ms: i64) -> H1ConnProbe:
    """Open a real TCP connection using the browser engine's own H1 client.

    Calls `H1Client.get_connection`, which resolves the host through the
    browser `DnsResolver` and then calls `rt_io_tcp_connect_timeout`
    (h1_client.spl:344) — the same code path a page load takes.

    This stops short of `H1Client.request` deliberately: request serialization
    calls `Url.request_target()` -> `i64.to_char()`, which neither the
    Cranelift JIT nor the spec-runner interpreter implements, so `request()`
    aborts before any assertion can run. See the spec header. The socket that
    `get_connection` opens is nonetheless a real one, and the server observes
    it.
    """
    val logger = Logger.new("h1-loopback", BrowserLogLevel.Error)
    val dns = DnsResolver.new(logger, 60)
    val tls_cfg = TlsConfig(
        min_version: TlsVersion.Tls12, verify_peer: true, sni_hostname: ""
    )
    val tls = TlsManager.new(logger, tls_cfg)
    var client = H1Client.new(logger, dns, tls)

    val result = client.get_connection(host, port, false, deadline_ms)
    match result:
        Ok(conn):
            return H1ConnProbe(ok: conn.tcp_fd >= 0, fd: conn.tcp_fd, error: "")
        Err(e):
            return H1ConnProbe(ok: false, fd: -1, error: "{e.message}")

pub fn socket_http_get(addr: text, path: text) -> H1Probe:
    """Do a full HTTP/1.1 GET over a real client socket.

    TcpStream.connect -> rt_io_tcp_connect -> runtime/src/value/net_tcp.rs.
    Every byte asserted on by the caller crossed the kernel. Also reports the
    client's own local address so the caller can match it against the port the
    server observed.
    """
    val stream_res = TcpStream.connect(addr)
    if stream_res.is_err():
        return H1Probe(
            ok: false, status: -1, headers: "", body: "", local_addr: "",
            error: "connect failed: {addr}"
        )
    var stream = stream_res.unwrap()

    var local = ""
    val local_res = stream.local_addr()
    if local_res.is_ok():
        local = local_res.unwrap()

    val request = "GET {path} HTTP/1.1\r\nHost: {addr}\r\nUser-Agent: simple-tcp-client\r\nConnection: close\r\n\r\n"
    val w = stream.write_text(request)
    if w.is_err():
        val _ = stream.close()
        return H1Probe(
            ok: false, status: -1, headers: "", body: "", local_addr: local,
            error: "write failed"
        )
    val _f = stream.flush()

    val read_res = stream.read_text()
    val _c = stream.close()
    if read_res.is_err():
        return H1Probe(
            ok: false, status: -1, headers: "", body: "", local_addr: local,
            error: "read failed"
        )
    val raw = read_res.unwrap()

    val split = raw.index_of("\r\n\r\n")
    if split < 0:
        return H1Probe(
            ok: false, status: -1, headers: raw, body: "", local_addr: local,
            error: "no header/body separator in response"
        )
    val head = raw.slice(0, split)
    val body = raw.slice(split + 4, raw.len())

    var status = -1
    val first_nl = head.index_of("\r\n")
    val status_line = if first_nl > 0: head.slice(0, first_nl) else: head
    val sp1 = status_line.index_of(" ")
    if sp1 > 0:
        val rest = status_line.slice(sp1 + 1, status_line.len())
        val sp2 = rest.index_of(" ")
        val code_text = if sp2 > 0: rest.slice(0, sp2) else: rest
        status = code_text.to_i64()

    return H1Probe(
        ok: status > 0, status: status, headers: head, body: body,
        local_addr: local, error: ""
    )

pub fn browser_h1_get(addr: text, path: text, deadline_ms: i64) -> H1Probe:
    """Drive the browser engine's H1Client over a real TCP socket.

    `addr` is "127.0.0.1:PORT". No mock is registered, so H1Client takes its
    plain-HTTP path: rt_io_tcp_connect_timeout -> rt_io_tcp_write_text ->
    rt_io_tcp_read.
    """
    val logger = Logger.new("h1-loopback", BrowserLogLevel.Error)
    val dns = DnsResolver.new(logger, 60)
    val tls_cfg = TlsConfig(
        min_version: TlsVersion.Tls12, verify_peer: true, sni_hostname: ""
    )
    val tls = TlsManager.new(logger, tls_cfg)
    var client = H1Client.new(logger, dns, tls)

    val raw = "http://{addr}{path}"
    val parsed = Url.parse(raw)
    if not parsed.?:
        return H1Probe(
            ok: false, status: -1, headers: "", body: "", local_addr: "",
            error: "url parse failed: {raw}"
        )
    val url = parsed.unwrap()

    val req = FetchRequest(
        method: "GET",
        url: url,
        headers: "",
        body: [],
        mode: RequestMode.NoCors,
        credentials: "omit"
    )

    val result = client.request(req, deadline_ms)
    match result:
        Ok(resp):
            return H1Probe(
                ok: true,
                status: resp.status,
                headers: resp.headers,
                body: resp.body_text(),
                local_addr: "",
                error: ""
            )
        Err(e):
            return H1Probe(
                ok: false, status: -1, headers: "", body: "", local_addr: "",
                error: "{e.message}"
            )
