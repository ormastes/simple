    if requirement == "REQ-005":
        return _binding(requirement, "check_simpleos_filesystem_conformance", "test/02_integration/storage/dbfs/dbfs_durable_commit_spec.spl")
    if requirement == "REQ-006":
        return _binding(requirement, "check_simpleos_filesystem_conformance", "test/01_unit/os/services/nvfs/nvfs_durable_roundtrip_spec.spl")
    if requirement == "REQ-007":
        return _binding(requirement, "check_simpleos_filesystem_exec", "test/01_unit/lib/common/contracts/execution/simpleos_executable_admission_v1_spec.spl")
    if requirement == "REQ-008":
        return _binding(requirement, "check_simpleos_filesystem_exec", "test/03_system/os/simpleos_toolchain_deployment_desktop_boot_spec.spl")
    if requirement == "REQ-009":
        return _binding(requirement, "check_simpleos_toolchain_fs", "test/03_system/os/simpleos_deploy_image_simple_toolchain_spec.spl")
    if requirement == "REQ-010":
        return _binding(requirement, "check_simpleos_toolchain_fs", "test/03_system/os/simpleos_toolchain_deployment_desktop_boot_spec.spl")
    if requirement == "REQ-011":
        return _binding(requirement, "check_simpleos_toolchain_fs", "test/03_system/os/os_shell_userland_tools_spec.spl")
    if requirement == "REQ-012":
        return _binding(requirement, "check_simpleos_server_protocols", "test/03_system/os/server/simpleos_server_execution_matrix_spec.spl")
    if requirement == "REQ-013":
        return _binding(requirement, "check_simpleos_server_protocols", "test/03_system/os/server/simpleos_server_execution_matrix_spec.spl")
    if requirement == "REQ-014":
        return _binding(requirement, "check_simpleos_server_protocols", "test/03_system/os/server/simpleos_server_execution_matrix_spec.spl")
    if requirement == "REQ-015":
