    if requirement == "NFR-011":
        return _binding(requirement, "check_simpleos_filesystem_conformance", "test/02_integration/storage/dbfs/dbfs_durable_commit_spec.spl")
    if requirement == "NFR-012":
        return _binding(requirement, "check_simpleos_capability_matrix", "test/01_unit/os/services/evidence/capability_ledger_spec.spl")
    if requirement == "NFR-013":
        return _binding(requirement, "check_simpleos_perf_duplication", "test/03_system/os/simpleos_toolchain_deployment_desktop_boot_spec.spl")
    if requirement == "NFR-014":
        return _binding(requirement, "check_simpleos_capability_matrix", "test/02_integration/app/spipe_docgen_regeneration_live_spec.spl")
    _binding("", "", "")

fn _umbrella_trusted_roots() -> [SimpleOsTrustedEvidenceSignerV1]:
    # Platform provisioning owns this immutable file.  Exactly one canonical
    # key is accepted; missing, extra, or malformed fields fail closed.
    val path = "config/os/simpleos_evidence_trusted_signer_v1.conf"
    if not file_exists(path): return []
    val lines = file_read_text(path).split("\n")
    if lines.len() != 3 or lines[2] != "" or
        not lines[0].starts_with("key_id=") or
        not lines[1].starts_with("public_key_ed25519_hex="):
        return []
    val key_id = lines[0].substring(7, lines[0].len())
    val public_key = simpleos_evidence_public_key_hex_decode(
        lines[1].substring(23, lines[1].len()))
    if key_id == "" or public_key.len() != 32: return []
    [SimpleOsTrustedEvidenceSignerV1(key_id: key_id, public_key: public_key)]

fn _umbrella_snapshot(evidence_dir: text, artifact_count: i64) -> SimpleOsEvidenceArtifactSnapshotV1?:
    val source = evidence_dir + "/source.snapshot"
    val image = evidence_dir + "/image.snapshot"
    val binary = evidence_dir + "/binary.snapshot"
    val config = evidence_dir + "/config.snapshot"
    if not file_exists(source) or not file_exists(image) or
        not file_exists(binary) or not file_exists(config): return nil
    var artifacts: [[u8]] = []
    var i: i64 = 0
    while i < artifact_count:
        val path = evidence_dir + "/artifact-" + i.to_text() + ".snapshot"
        if not file_exists(path): return nil
        artifacts.push(file_read_bytes(path))
        i = i + 1
    Some(SimpleOsEvidenceArtifactSnapshotV1(
        source_manifest_bytes: file_read_bytes(source),
        image_bytes: file_read_bytes(image), binary_bytes: file_read_bytes(binary),
        config_bytes: file_read_bytes(config), artifact_bytes: artifacts,
        performance_fixture_artifact_index: if artifact_count > 0: 0 else: -1))

fn _admit_authentic_evidence(helper: text, requirement: text, evidence_case: text):
    if evidence_case != "happy" and evidence_case != "boundary" and
        evidence_case != "rejection" and evidence_case != "fixture":
        fail("BLOCKED[TRACEABILITY-CASE] requirement=" + requirement + " case=" + evidence_case)
        return
    val binding = _evidence_binding(requirement)
    if binding.requirement_id == "":
        fail("BLOCKED[TRACEABILITY-BINDING] requirement=" + requirement + " reason=unknown-requirement")
        return
    if binding.helper != helper and evidence_case != "fixture":
        fail("BLOCKED[TRACEABILITY-BINDING] requirement=" + requirement + " helper=" + helper + " expected=" + binding.helper)
        return
    val evidence_dir = "build/test-artifacts/simpleos_complete_os_hardening/" + requirement + "/" + evidence_case
    val evidence_file = evidence_dir + "/receipt.v1.bin"
    val resume_command = "bin/simple test " + binding.acceptance_owner + " --mode=interpreter"
    if not file_exists(evidence_file):
        fail("BLOCKED[" + requirement + ":" + evidence_case + "] evidence=" + evidence_file + " reason=receipt-absent resume=" + resume_command)
        return
    val receipt_bytes = file_read_bytes(evidence_file)
    val decoded = decode_simpleos_evidence_receipt_v1(receipt_bytes)
    if not decoded.ok:
        fail("BLOCKED[" + requirement + ":" + evidence_case + "] reason=receipt-decode resume=" + resume_command)
        return
    val snapshot = _umbrella_snapshot(evidence_dir, decoded.value.artifact_hashes.len())
    if not snapshot.?:
        fail("BLOCKED[" + requirement + ":" + evidence_case + "] reason=artifact-snapshot-absent resume=" + resume_command)
        return
    val admitted = simpleos_umbrella_admit_exact_evidence_v1(
        requirement, "simpleos-complete-os-umbrella", _umbrella_trusted_roots(),
        receipt_bytes, snapshot.unwrap())
    if not admitted.ok:
        fail("BLOCKED[" + requirement + ":" + evidence_case + "] reason=" + admitted.reason + " resume=" + resume_command)

fn setup_simpleos_arch_fixture(requirement: text):
    _admit_authentic_evidence("setup_simpleos_arch_fixture", requirement, "fixture")

