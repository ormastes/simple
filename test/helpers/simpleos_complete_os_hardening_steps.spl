        return _binding(requirement, "check_simpleos_wm", "test/03_system/os/wm/simpleos_wm_behavior_evidence_spec.spl")
    if requirement == "REQ-018":
        return _binding(requirement, "check_simpleos_perf_duplication", "test/03_system/os/wm/simple_wm_performance_spec.spl")
    if requirement == "REQ-019":
        return _binding(requirement, "check_simpleos_perf_duplication", "test/03_system/app/cli/duplicate_check_contract_spec.spl")
    if requirement == "REQ-020":
        return _binding(requirement, "check_simpleos_capability_matrix", "test/03_system/os/simpleos_toolchain_deployment_desktop_boot_spec.spl")
    if requirement == "NFR-001":
        return _binding(requirement, "check_simpleos_capability_matrix", "test/03_system/os/qemu/simpleos_three_arch_qemu_evidence_admission_spec.spl")
    if requirement == "NFR-002":
        return _binding(requirement, "check_simpleos_perf_duplication", "test/03_system/os/wm/simple_wm_performance_spec.spl")
    if requirement == "NFR-003":
        return _binding(requirement, "check_simpleos_perf_duplication", "test/03_system/os/wm/simple_wm_performance_spec.spl")
    if requirement == "NFR-004":
        return _binding(requirement, "check_simpleos_perf_duplication", "test/03_system/quality/code_quality/os_harden_runtime_evidence_spec.spl")
    if requirement == "NFR-005":
        return _binding(requirement, "check_simpleos_perf_duplication", "test/03_system/quality/code_quality/os_harden_runtime_evidence_spec.spl")
    if requirement == "NFR-006":
        return _binding(requirement, "check_simpleos_filesystem_exec", "test/01_unit/lib/common/contracts/execution/simpleos_executable_admission_v1_spec.spl")
    if requirement == "NFR-007":
        return _binding(requirement, "check_simpleos_perf_duplication", "test/01_unit/os/services/evidence/capability_ledger_spec.spl")
    if requirement == "NFR-008":
        return _binding(requirement, "check_simpleos_perf_duplication", "test/03_system/app/cli/duplicate_check_contract_spec.spl")
    if requirement == "NFR-009":
        return _binding(requirement, "check_simpleos_perf_duplication", "test/03_system/quality/code_quality/os_harden_runtime_evidence_spec.spl")
    if requirement == "NFR-010":
        return _binding(requirement, "check_simpleos_server_protocols", "test/03_system/os/server/simpleos_server_execution_matrix_spec.spl")
    if requirement == "NFR-011":
        return _binding(requirement, "check_simpleos_filesystem_conformance", "test/02_integration/storage/dbfs/dbfs_durable_commit_spec.spl")
    if requirement == "NFR-012":
        return _binding(requirement, "check_simpleos_capability_matrix", "test/01_unit/os/services/evidence/capability_ledger_spec.spl")
    if requirement == "NFR-013":
        return _binding(requirement, "check_simpleos_perf_duplication", "test/03_system/os/simpleos_toolchain_deployment_desktop_boot_spec.spl")
    if requirement == "NFR-014":
        return _binding(requirement, "check_simpleos_capability_matrix", "test/02_integration/app/spipe_docgen_regeneration_live_spec.spl")
    _binding("", "", "")

fn _placeholder_receipt(requirement: text) -> SimpleOsEvidenceReceiptV1:
    SimpleOsEvidenceReceiptV1(
        schema_version: 1,
        receipt_id: "",
        nonce: "",
        requirement_id: requirement,
        capability: "",
        target: "",
        target_abi: "",
        environment: SimpleOsEvidenceEnvironment.QemuSystem,
        firmware_profile: "",
        board_identity: "",
        accelerator: "",
        filesystem: "",
        protocol_profile: "",
        source_hash: "",
        image_hash: "",
        binary_hash: "",
        config_hash: "",
        exact_argv: [],
        artifact_hashes: [],
        steps: [],
        performance_workload: "",
        performance_unit: "",
        performance_warmup_count: 0,
        performance_cpu_identity: "",
        performance_frequency_hz: 0,
        performance_noise_profile: "",
        performance_comparable: false,
        performance_samples: [],
        started_unix_us: 0,
        finished_unix_us: 0,
        owner: "",
        reviewer: "",
        signer_key_id: "",
        signature: "")

fn _propagate_blocked(helper: text, requirement: text, evidence_case: text):
    if evidence_case != "happy" and evidence_case != "boundary" and
        evidence_case != "rejection" and evidence_case != "fixture":
        fail("BLOCKED[TRACEABILITY-CASE] requirement=" + requirement + " case=" + evidence_case)
        return
    val binding = _evidence_binding(requirement)
    if binding.requirement_id == "":
        fail("BLOCKED[TRACEABILITY-BINDING] requirement=" + requirement + " reason=unknown-requirement")
        return
    if binding.helper != helper and evidence_case != "fixture":
        fail("BLOCKED[TRACEABILITY-BINDING] requirement=" + requirement + " helper=" + helper + " expected=" + binding.helper)
        return
    val evidence_file = "build/test-artifacts/simpleos_complete_os_hardening/" + requirement + "/" + evidence_case + ".receipt.sdn"
    val resume_command = "bin/simple test " + binding.acceptance_owner + " --mode=interpreter"
    # Consult the real world instead of asserting a fixed verdict: the receipt
    # either exists on disk or it does not, and the reported blocker differs.
    # A present receipt still cannot be admitted, because the production
    # admission path terminates in `cryptographic-verifier-unavailable`
    # (src/os/services/evidence/capability_ledger.spl) - no trust-root registry
    # or canonical signature verifier exists yet. That is reported as an
    # explicit BLOCKED reason, never as a pass.
    if file_exists(evidence_file):
        fail("BLOCKED[" + requirement + ":" + evidence_case + "] evidence=" + evidence_file +
             " reason=receipt-present-but-admission-unavailable" +
             " detail=cryptographic-verifier-unavailable resume=" + resume_command)
        return
    val candidate = SimpleOsCapabilityLedgerCandidateV1(
        row: SimpleOsCapabilityRowV1(
            requirement_id: requirement,
            capability: "simpleos-complete-os-hardening-" + evidence_case,
            target: "required-matrix",
            environment: SimpleOsEvidenceEnvironment.QemuSystem,
            filesystem: "",
            protocol_profile: "",
            status: SimpleOsCapabilityStatus.Blocked,
            receipt_id: "",
            receipt_nonce: "",
            source_hash: "",
            image_hash: "",
            binary_hash: "",
            config_hash: "",
            artifacts: [],
            artifact_paths: [evidence_file],
            blocker_reason: "required acceptance receipt is absent or not admitted",
            todo: "run the bound acceptance owner and admit its fresh receipt",
            prerequisite: "admitted pure-Simple runtime and the requirement-specific target fixture",
            resume_command: resume_command,
            owner: binding.acceptance_owner,
            reviewer: "independent-final-reviewer"),
        receipt_present: false,
        receipt: _placeholder_receipt(requirement))
    val checked = simpleos_capability_candidate_validate(candidate)
    if not checked.ok:
        fail("BLOCKED[TRACEABILITY-BINDING] requirement=" + requirement + " reason=" + checked.reason)
        return
    fail("BLOCKED[" + requirement + ":" + evidence_case + "] owner=" + binding.acceptance_owner + " evidence=" + evidence_file + " reason=receipt-absent resume=" + resume_command)

fn setup_simpleos_arch_fixture(requirement: text):
    _propagate_blocked("setup_simpleos_arch_fixture", requirement, "fixture")

fn step_boot_target():
    step("Run the bound architecture evidence owner and retain its admitted receipt")

fn step_mount_filesystem():
    step("Run the bound filesystem conformance owner and retain its admitted receipt")

fn step_launch_from_filesystem():
    step("Run the bound authenticated filesystem execution owner and retain its admitted receipt")

fn step_probe_protocol():
    step("Run the bound live protocol owner and retain its admitted receipt")

fn step_compile_and_run_hello():
    step("Run the bound guest toolchain owner and retain compile link and execution receipts")

fn step_exercise_window_manager():
    step("Run the bound WM behavior owner and retain correlated input scene and frame receipts")

fn step_measure_resource_budget():
    step("Run the bound performance or quality owner and retain its raw admitted evidence")

fn check_simpleos_capability_matrix(requirement: text, evidence_case: text):
