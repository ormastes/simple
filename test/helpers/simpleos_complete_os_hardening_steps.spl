struct SimpleOsHardeningEvidenceBinding:
    requirement_id: text
    helper: text
    acceptance_owner: text

fn _binding(requirement: text, helper: text,
            acceptance_owner: text) -> SimpleOsHardeningEvidenceBinding:
    SimpleOsHardeningEvidenceBinding(
        requirement_id: requirement,
        helper: helper,
        acceptance_owner: acceptance_owner)

