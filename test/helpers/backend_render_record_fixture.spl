        backend_render_field("transitions.000.identity", "transition-target-attachment", "text", true),
        backend_render_field("transitions.000.resource_id", "target-color", "text", true),
        backend_render_field("transitions.000.stage", "color-output", "text", true),
        backend_render_field("transitions.001.access", "read", "text", true),
        backend_render_field("transitions.001.after", "readback", "text", true),
        backend_render_field("transitions.001.before", "color-attachment", "text", true),
