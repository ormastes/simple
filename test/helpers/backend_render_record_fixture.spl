fn backend_render_fixture_replace(record: BackendRenderRecord, path: text, value: text) -> BackendRenderRecord:
    var fields: [BackendRenderField] = []
    for field in record.fields:
        if field.path == path:
            fields = fields.push(backend_render_field(field.path, value, field.value_kind, field.semantic))
        else:
            fields = fields.push(field)
    backend_render_record_finalize(record.producer_id, fields)

fn backend_render_fixture_replace_shape(record: BackendRenderRecord, path: text, value_kind: text, semantic: bool) -> BackendRenderRecord:
    var fields: [BackendRenderField] = []
    for field in record.fields:
        if field.path == path:
            fields = fields.push(backend_render_field(field.path, field.value, value_kind, semantic))
        else:
            fields = fields.push(field)
    backend_render_record_finalize(record.producer_id, fields)

fn backend_render_fixture_remove(record: BackendRenderRecord, path: text) -> BackendRenderRecord:
    var fields: [BackendRenderField] = []
    for field in record.fields:
        if field.path != path:
            fields = fields.push(field)
    backend_render_record_finalize(record.producer_id, fields)

fn backend_render_fixture_add(record: BackendRenderRecord, field: BackendRenderField) -> BackendRenderRecord:
    backend_render_record_finalize(record.producer_id, record.fields.push(field))

fn backend_render_fixture_reverse(record: BackendRenderRecord) -> BackendRenderRecord:
    var fields: [BackendRenderField] = []
    var index = record.fields.len()
    while index > 0:
        index = index - 1
        fields = fields.push(record.fields[index])
    backend_render_record_finalize(record.producer_id, fields)
