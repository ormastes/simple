"""Test-only ParserModule-to-owner projection fixture.

Production surface construction accepts class-handle owners only. Legacy unit
fixtures still assemble ParserModule dictionaries directly; confine their
value extraction here so no production compiler path exposes that copy API.
"""

use compiler.frontend.parser_types.{ParserModule}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.module_surface.{
    ModuleSurfaceParserOwner,
    ModuleSurfacesByName,
    module_surfaces_from_owners
}

fn module_surface_test_owners(
    modules: Dict<text, ParserModule>
) -> Dict<text, ModuleSurfaceParserOwner>:
    var owners: Dict<text, ModuleSurfaceParserOwner> = {}
    for alias in modules.keys():
        val module = modules[alias]
        if module == nil:
            owners[alias] = nil
            continue
        owners[alias] = ModuleSurfaceParserOwner(
            parsed_path: module.name,
            imports: module.imports,
            exports: module.exports,
            functions: module.functions,
            function_headers: module.function_headers,
            classes: module.classes,
            actors: module.actors,
            structs: module.structs,
            enums: module.enums,
            traits: module.traits,
            impls: module.impls,
            type_aliases: module.type_aliases,
            constants: module.constants)
    owners

fn module_surfaces_from_test_modules(
    modules: Dict<text, ParserModule>, sources: [SourceFile]
) -> Result<ModuleSurfacesByName, text>:
    module_surfaces_from_owners(module_surface_test_owners(modules), sources)
