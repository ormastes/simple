"""Test-only ParserModule surface projection fixture.

Legacy unit fixtures still assemble ParserModule dictionaries directly. Route
them through the supported compatibility constructor instead of importing the
removed owner-dictionary bulk helper.
"""

use compiler.frontend.parser_types.{ParserModule}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_lowering.module_surface.{
    ModuleSurfacesByName,
    module_surfaces_from_modules
}

fn module_surfaces_from_test_modules(
    modules: Dict<text, ParserModule>, sources: [SourceFile]
) -> Result<ModuleSurfacesByName, text>:
    module_surfaces_from_modules(modules, sources)
