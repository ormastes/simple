# Source-text contract view over the actual split production owners.
# Reconstruct only their definition blocks in registration order: existing
# contract assertions retain their exact method boundaries and negative scans.
# No implementation text or expected passing fixture is copied into this file.
use std.io_runtime.{file_read}

fn source_parse_definition_block_v1(path: text) -> text:
    val source = file_read(path)
    val marker = "impl CompilerDriver:\n"
    val start = source.index_of(marker)
    assert(start >= 0)
    source.substring(start + marker.len())

pub fn source_parse_implementation_v1() -> text:
    val prefix = "src/compiler/80.driver/driver_source_parse_"
    val support = file_read(prefix + "support.spl")
    val support_end = support.index_of("use compiler.common.diagnostics.span.{Span}\n\n# Shared implementation hooks;")
    assert(support_end >= 0)
    val selected = source_parse_definition_block_v1(prefix + "selected.spl")
    val streaming = source_parse_definition_block_v1(prefix + "streaming.spl")
    val retained = source_parse_definition_block_v1(prefix + "retained.spl")
    val first = support.substring(0, support_end) + "impl CompilerDriver:\n" + selected
    first + streaming + retained + "use compiler.common.diagnostics.span.{Span}\n"

export source_parse_implementation_v1
