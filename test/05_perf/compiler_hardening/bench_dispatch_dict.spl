# A7 §18.2: dict-keyed dynamic dispatch (hash lookup + indirect call), 1M iterations.
extern fn rt_time_now_nanos() -> i64

fn op_add(acc: i64, a: i64) -> i64: acc + a
fn op_sub(acc: i64, a: i64) -> i64: acc - a
fn op_mul(acc: i64, a: i64) -> i64: acc + a * 2
fn op_div(acc: i64, a: i64) -> i64: acc + a / 2
fn op_and(acc: i64, a: i64) -> i64: acc + (a & 7)
fn op_or(acc: i64, a: i64) -> i64: acc + (a | 1)
fn op_xor(acc: i64, a: i64) -> i64: acc + (a ^ 3)
fn op_shl(acc: i64, a: i64) -> i64: acc + (a << 1)

fn main():
    val iters: i64 = 1000000
    var table: {text: fn(i64, i64) -> i64} = {}
    table["add"] = op_add
    table["sub"] = op_sub
    table["mul"] = op_mul
    table["div"] = op_div
    table["and"] = op_and
    table["or"] = op_or
    table["xor"] = op_xor
    table["shl"] = op_shl
    var keys: [text] = ["add", "sub", "mul", "div", "and", "or", "xor", "shl"]
    var acc: i64 = 0
    val t0 = rt_time_now_nanos()
    var i: i64 = 0
    while i < iters:
        val f = table.get(keys[i & 7])
        if f != nil:
            acc = f(acc, i)
        i = i + 1
    val t1 = rt_time_now_nanos()
    print "BENCH dispatch_dict_dynamic {(t1 - t0) / iters}"
    if acc == 12345678987654321: print "# sink"

main()
