# A7 §10.4 comparand: Any box/unbox, 1M iterations.
extern fn rt_time_now_nanos() -> i64

fn unwrap_any(x: Any) -> i64:
    x.to_i64()

fn main():
    val iters: i64 = 1000000
    var acc: i64 = 0
    val t0 = rt_time_now_nanos()
    var i: i64 = 0
    while i < iters:
        val b: Any = i
        acc = acc + unwrap_any(b)
        i = i + 1
    val t1 = rt_time_now_nanos()
    print "BENCH any_box_unbox {(t1 - t0) / iters}"
    if acc == 12345678987654321: print "# sink"

main()
