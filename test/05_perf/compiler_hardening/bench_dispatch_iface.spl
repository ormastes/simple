# A7 §18.2: interface-style indirect dispatch through an fn-value table
# (indirect call, no hashing), 8 targets, 1M iterations.
extern fn rt_time_now_nanos() -> i64

fn op_add(acc: i64, a: i64) -> i64: acc + a
fn op_sub(acc: i64, a: i64) -> i64: acc - a
fn op_mul(acc: i64, a: i64) -> i64: acc + a * 2
fn op_div(acc: i64, a: i64) -> i64: acc + a / 2
fn op_and(acc: i64, a: i64) -> i64: acc + (a & 7)
fn op_or(acc: i64, a: i64) -> i64: acc + (a | 1)
fn op_xor(acc: i64, a: i64) -> i64: acc + (a ^ 3)
fn op_shl(acc: i64, a: i64) -> i64: acc + (a << 1)

fn main():
    val iters: i64 = 1000000
    var slots: [fn(i64, i64) -> i64] = [op_add, op_sub, op_mul, op_div, op_and, op_or, op_xor, op_shl]
    var acc: i64 = 0
    val t0 = rt_time_now_nanos()
    var i: i64 = 0
    while i < iters:
        val f = slots[i & 7]
        acc = f(acc, i)
        i = i + 1
    val t1 = rt_time_now_nanos()
    print "BENCH dispatch_interface_indirect {(t1 - t0) / iters}"
    if acc == 12345678987654321: print "# sink"

main()
