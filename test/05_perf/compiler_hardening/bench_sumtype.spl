# A7 §10.4: sum type (enum with payloads) construct + match, 1M iterations.
extern fn rt_time_now_nanos() -> i64

enum Val:
    I(v: i64)
    F(v: f64)
    S(v: text)

fn unwrap_i(x: Val) -> i64:
    match x:
        case Val.I(v): v
        case Val.F(v): v.to_i64()
        case Val.S(v): v.len()

fn main():
    val iters: i64 = 1000000
    var acc: i64 = 0
    val t0 = rt_time_now_nanos()
    var i: i64 = 0
    while i < iters:
        acc = acc + unwrap_i(Val.I(i))
        i = i + 1
    val t1 = rt_time_now_nanos()
    print "BENCH sumtype_construct_match {(t1 - t0) / iters}"
    if acc == 12345678987654321: print "# sink"

main()
