        case Tok.V37(a): acc + a + 37
        case Tok.V38(a): acc + a + 38
        case Tok.V39(a): acc + a + 39

fn make(k: i64, a: i64) -> Tok:
    if k == 0: Tok.V0(a)
    elif k == 1: Tok.V1(a)
    elif k == 2: Tok.V2(a)
    elif k == 3: Tok.V3(a)
    elif k == 4: Tok.V4(a)
    elif k == 5: Tok.V5(a)
    elif k == 6: Tok.V6(a)
    elif k == 7: Tok.V7(a)
    elif k == 8: Tok.V8(a)
    elif k == 9: Tok.V9(a)
    elif k == 10: Tok.V10(a)
    elif k == 11: Tok.V11(a)
    elif k == 12: Tok.V12(a)
    elif k == 13: Tok.V13(a)
    elif k == 14: Tok.V14(a)
    elif k == 15: Tok.V15(a)
    elif k == 16: Tok.V16(a)
    elif k == 17: Tok.V17(a)
    elif k == 18: Tok.V18(a)
    elif k == 19: Tok.V19(a)
    elif k == 20: Tok.V20(a)
    elif k == 21: Tok.V21(a)
    elif k == 22: Tok.V22(a)
    elif k == 23: Tok.V23(a)
    elif k == 24: Tok.V24(a)
    elif k == 25: Tok.V25(a)
    elif k == 26: Tok.V26(a)
    elif k == 27: Tok.V27(a)
    elif k == 28: Tok.V28(a)
    elif k == 29: Tok.V29(a)
    elif k == 30: Tok.V30(a)
    elif k == 31: Tok.V31(a)
    elif k == 32: Tok.V32(a)
    elif k == 33: Tok.V33(a)
    elif k == 34: Tok.V34(a)
    elif k == 35: Tok.V35(a)
    elif k == 36: Tok.V36(a)
    elif k == 37: Tok.V37(a)
    elif k == 38: Tok.V38(a)
    else: Tok.V39(a)

fn main():
    var acc: i64 = 0
    var i: i64 = 0
    while i < 200000:
        val t = make(i % 40, i)
        acc = eval_c(t, eval_b(t, eval_a(t, acc)))
        i = i + 1
    print "enum_match done {acc}"

main()
