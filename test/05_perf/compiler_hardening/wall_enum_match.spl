# A7 wall/RSS baseline: ~200-line closed enum match (40 variants, 3 match sites).
# Generated shape; keep the variant count stable so the baseline stays comparable.
enum Tok:
    V0(a: i64)
    V1(a: i64)
    V2(a: i64)
    V3(a: i64)
    V4(a: i64)
    V5(a: i64)
    V6(a: i64)
    V7(a: i64)
    V8(a: i64)
    V9(a: i64)
    V10(a: i64)
    V11(a: i64)
    V12(a: i64)
    V13(a: i64)
    V14(a: i64)
    V15(a: i64)
    V16(a: i64)
    V17(a: i64)
    V18(a: i64)
    V19(a: i64)
    V20(a: i64)
    V21(a: i64)
    V22(a: i64)
    V23(a: i64)
    V24(a: i64)
    V25(a: i64)
    V26(a: i64)
    V27(a: i64)
    V28(a: i64)
    V29(a: i64)
    V30(a: i64)
    V31(a: i64)
    V32(a: i64)
    V33(a: i64)
    V34(a: i64)
    V35(a: i64)
    V36(a: i64)
    V37(a: i64)
    V38(a: i64)
    V39(a: i64)

fn eval_a(t: Tok, acc: i64) -> i64:
    match t:
        case Tok.V0(a): acc + a + 0
        case Tok.V1(a): acc + a + 1
        case Tok.V2(a): acc + a + 2
        case Tok.V3(a): acc + a + 3
        case Tok.V4(a): acc + a + 4
        case Tok.V5(a): acc + a + 5
        case Tok.V6(a): acc + a + 6
        case Tok.V7(a): acc + a + 7
        case Tok.V8(a): acc + a + 8
        case Tok.V9(a): acc + a + 9
        case Tok.V10(a): acc + a + 10
        case Tok.V11(a): acc + a + 11
        case Tok.V12(a): acc + a + 12
        case Tok.V13(a): acc + a + 13
        case Tok.V14(a): acc + a + 14
        case Tok.V15(a): acc + a + 15
        case Tok.V16(a): acc + a + 16
        case Tok.V17(a): acc + a + 17
        case Tok.V18(a): acc + a + 18
        case Tok.V19(a): acc + a + 19
        case Tok.V20(a): acc + a + 20
        case Tok.V21(a): acc + a + 21
        case Tok.V22(a): acc + a + 22
        case Tok.V23(a): acc + a + 23
        case Tok.V24(a): acc + a + 24
        case Tok.V25(a): acc + a + 25
        case Tok.V26(a): acc + a + 26
        case Tok.V27(a): acc + a + 27
        case Tok.V28(a): acc + a + 28
        case Tok.V29(a): acc + a + 29
        case Tok.V30(a): acc + a + 30
        case Tok.V31(a): acc + a + 31
        case Tok.V32(a): acc + a + 32
        case Tok.V33(a): acc + a + 33
        case Tok.V34(a): acc + a + 34
        case Tok.V35(a): acc + a + 35
        case Tok.V36(a): acc + a + 36
        case Tok.V37(a): acc + a + 37
        case Tok.V38(a): acc + a + 38
        case Tok.V39(a): acc + a + 39

fn eval_b(t: Tok, acc: i64) -> i64:
    match t:
        case Tok.V0(a): acc + a + 0
        case Tok.V1(a): acc + a + 1
        case Tok.V2(a): acc + a + 2
        case Tok.V3(a): acc + a + 3
        case Tok.V4(a): acc + a + 4
