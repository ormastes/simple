# A7 wall/RSS baseline: generic-heavy — 3 generic fns x 3 instantiation types, 300k iterations.
# NOTE: on the 2026-08-21 seed every generic call returning scalar T yields value<<3 —
# doc/08_tracking/bug/generic_struct_field_untagged_payload_seed_2026-08-21.md.
# The printed values are therefore WRONG; this fixture pins wall/RSS only.
fn combine<T>(a: T, b: T) -> T:
    a + b

fn pick<T>(c: bool, a: T, b: T) -> T:
    if c: a else: b

fn twice<T>(a: T) -> T:
    combine(a, a)

fn main():
    var ai: i64 = 0
    var af: f64 = 0.0
    var at: text = ""
    var i: i64 = 0
    while i < 300000:
        ai = combine(pick(i % 2 == 0, ai, ai), 1)
        af = combine(pick(true, af, af), 1.0)
        at = twice(combine("a", "b"))
        i = i + 1
    print "generic done {ai} {af} {at}"

main()
