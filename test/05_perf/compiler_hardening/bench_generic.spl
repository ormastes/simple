# A7 §18.4: one generic fn called at 3 types, 1M iterations each.
extern fn rt_time_now_nanos() -> i64

fn combine<T>(a: T, b: T) -> T:
    a + b

fn main():
    val iters: i64 = 1000000
    var ai: i64 = 0
    var af: f64 = 0.0
    var at: text = ""
    val t0 = rt_time_now_nanos()
    var i: i64 = 0
    while i < iters:
        ai = combine(ai, 1)
        af = combine(af, 1.0)
        at = combine("a", "b")
        i = i + 1
    val t1 = rt_time_now_nanos()
    print "BENCH generic_3types {(t1 - t0) / (iters * 3)}"
    if ai == 12345678987654321: print "# sink {af} {at}"

main()
