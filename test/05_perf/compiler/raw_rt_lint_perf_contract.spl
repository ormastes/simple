use compiler.semantics.lint.raw_rt_access.{check_raw_rt_access}
use std.io_runtime.{time_now_unix_micros}

extern fn rt_exit(code: i32)

var clean_lines: [text] = []
var i = 0
while i < 20000:
    clean_lines.push("fn clean_{i}(value: i64) -> i64: value + 1")
    i = i + 1
val clean_source = clean_lines.join("\n")

val clean_start = time_now_unix_micros()
val clean_findings = check_raw_rt_access(clean_source, "src/app/generated_clean.spl")
val clean_us = time_now_unix_micros() - clean_start

var raw_lines: [text] = []
i = 0
while i < 2000:
    raw_lines.push("fn call_{i}(): rt_process_run(cmd, args)")
    i = i + 1
val raw_source = raw_lines.join("\n")

val raw_start = time_now_unix_micros()
val raw_findings = check_raw_rt_access(raw_source, "src/app/generated_raw.spl")
val raw_us = time_now_unix_micros() - raw_start

print "raw_rt_lint_perf clean_bytes={clean_source.len()} clean_us={clean_us} raw_findings={raw_findings.len()} raw_us={raw_us}"
if clean_findings.len() != 0 or raw_findings.len() != 2000:
    rt_exit(1)
# Generous regression ceilings for interpreted CI; normal no-rt files take the
# single contains() fast path and should remain far below this bound.
if clean_us > 1000000 or raw_us > 3000000:
    rt_exit(1)
rt_exit(0)
