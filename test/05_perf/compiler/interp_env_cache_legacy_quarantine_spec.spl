# The refuted Rust-seed env-cache hypothesis must not masquerade as a current
# Pure-Simple performance gate.

use std.spec.*
use std.io_runtime.{process_run}

val GATE: text = "scripts/check/check-interp-env-cache-bounded.shs"

describe "legacy interpreter env-cache diagnostic quarantine":

    it "refuses production-style invocation after its bounded selftest":
        step("Run without the explicit historical-diagnostic flag")
        val result = process_run("sh", ["-c", "sh " + GATE + " 2>&1"])
        expect(result.0).to_contain("quarantined Rust-seed diagnostic")
        expect(result.0.contains("PASS — 2 run(s) measured")).to_equal(false)
        expect(result.2).to_equal(2)

    it "labels the opt-in success path as non-production evidence":
        step("Inspect the retained source contract without running the 50-minute legacy probe")
        val result = process_run("sh", ["-c", "grep -F 'LEGACY-DIAGNOSTIC —' " + GATE])
        expect(result.0).to_contain("not production Simple evidence")
        expect(result.2).to_equal(0)

    it "excludes the timeout watchdog from GNU-time RSS":
        step("Inspect the measurement command ordering")
        val result = process_run("sh", ["-c", "grep -F 'timeout \"$m_timeout\" /usr/bin/time' " + GATE])
        expect(result.0).to_contain("timeout \"$m_timeout\" /usr/bin/time")
        expect(result.2).to_equal(0)
