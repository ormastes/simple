use std.spec.*
use std.io.{file_read}

describe "kernel plugin startup budget":
    it "requires an explicit measured baseline and the normative less-than-2ms budget":
        val checker = file_read("scripts/check/check-startup-budget.shs") ?? ""
        expect(checker).to_contain("SIMPLE_STARTUP_BASELINE_MS:-}")
        expect(checker).to_contain("SIMPLE_PLUGIN_STARTUP_DELTA_MS:-}")
        expect(checker).to_contain("no baseline is selected by default")
        expect(checker).to_contain("no threshold is selected by default")
        expect(checker).to_contain("KPM-NFR-001 requires an explicit less-than-2ms threshold")
        expect(checker).to_contain("at least 5 integer millisecond samples")
        expect(checker).to_contain("delta")
        expect(checker).to_contain("-lt")
