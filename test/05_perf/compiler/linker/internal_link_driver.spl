# Timing driver for lane A11 (conformance/perf) - links the A7 fixtures
# (test/fixtures/linker/elf/{start_a64.o,libchain_a64.a}) through the
# internal pure-Simple static ELF engine (`elf_static_link`), exercising the
# archive-fixpoint path (mid_a64.o -> leaf_a64.o pulled from the archive,
# unused_a64.o left out), the same call
# `test/01_unit/compiler/backend/linker/elf_archive_closure_spec.spl`'s "an
# object plus the archive links into an executable" case makes. Invoked by
# `test/05_perf/compiler/linker/link_engine_timing_recipe.shs` via
# `$SIMPLE_BIN run` and timed from the outside (`/usr/bin/time -v`) - this
# file does no timing of its own, so its wall time includes interpreter
# startup, exactly like a real `internal` link would.
#
# @cover src/compiler/70.backend/linker/elf/elf_static_link.spl
# @cover src/compiler/70.backend/linker/elf/archive_closure.spl

use compiler.backend.linker.elf.elf_static_link.{elf_static_link}
use compiler.backend.linker.reloc_engine.{RelocArch}
use std.io_runtime.{file_read_bytes}

val FIX: text = "test/fixtures/linker/elf"

fn load_fixture(name: text) -> [i64]:
    val raw = file_read_bytes("{FIX}/{name}")
    var out: [i64] = []
    var i: i64 = 0
    while i < raw.len():
        out = out.push(raw[i] as i64)
        i = i + 1
    out

fn main():
    val objs = [load_fixture("start_a64.o")]
    val archives = [load_fixture("libchain_a64.a")]
    val r = elf_static_link(objs, archives, "_start", RelocArch.AArch64)
    if r.is_err():
        print "LINK ERROR: {r.unwrap_err()}"
    else:
        print "LINKED bytes={r.unwrap().len()}"
