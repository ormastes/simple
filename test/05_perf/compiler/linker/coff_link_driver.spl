# Driver for the internal PE/COFF linker (Windows x64/arm64, llvm-mingw UCRT).
# Run by scripts/check/check-windows-pe-internal-link.shs.
# Env: LARCH=x86_64|aarch64, LOUT=<image path>, LENTRY=<entry symbol>,
#      LINPUTS=<comma list; *.a/*.lib are archives, everything else objects>.
# @cover src/compiler/70.backend/linker/coff/coff_link.spl

use compiler.backend.linker.coff.coff_link.{CoffLinkRequest, coff_link_amd64, coff_link_arm64}
use std.io_runtime.{file_read_bytes, file_write_bytes, env_get, time_now_monotonic_ms}

fn main():
    val arch = env_get("LARCH")
    var objs: [[u8]] = []
    var archives: [[u8]] = []
    for p in env_get("LINPUTS").split(","):
        if p.ends_with(".a") or p.ends_with(".lib"): archives.push(file_read_bytes(p))
        else: objs.push(file_read_bytes(p))
    val req = CoffLinkRequest(objects: objs, archives: archives, entry: env_get("LENTRY"))
    val t0 = time_now_monotonic_ms()
    val r = if arch == "aarch64": coff_link_arm64(req) else: coff_link_amd64(req)
    val t1 = time_now_monotonic_ms()
    if r.is_err():
        print("LINK-ERR {arch}: {r.unwrap_err()}")
        return
    val img = r.unwrap()
    if not file_write_bytes(env_get("LOUT"), img):
        print("LINK-ERR {arch}: cannot write {env_get(\"LOUT\")}")
        return
    print("LINK-OK {arch} bytes={img.len()} link_ms={t1 - t0}")

main()
