# Full-scale measurement driver for the internal ELF engine (run, or native-build it).
# Mirrors internal_link_native_with_operations' input assembly (native_linking
# cannot be JIT-compiled by the seed), with inputs pre-resolved in LINKSPEC:
#   obj <path> | archive <path> | shared <path> | keep <sym> | out <path>
#   interp <path> | pie 0/1 | gc 0/1 | asneeded 0/1 | strip 0/1
use compiler.backend.linker.elf.elf_static_link.{elf_link_with_operations, ElfLinkRequest, ELF_LINK_DYNAMIC_EXEC, ELF_LINK_DYNAMIC_PIE}
use compiler.backend.linker.elf.elf_operation_bindings.{elf_builtin_file_operations_v1}
use compiler.backend.linker.elf.link_trace.{elf_link_trace}
use compiler.backend.linker.reloc_engine.{RelocArch}
use compiler.backend.linker.native_image_publish.{native_image_publish}
use std.io_runtime.{file_read, env_get, time_now_unix_micros}

fn leaf(p: text) -> text:
    val slash = p.last_index_of("/") ?? -1
    if slash < 0: return p
    p.substring(slash + 1)

fn main():
    val lines = file_read(env_get("LINKSPEC") ?? "").split("\n")
    val ops_r = elf_builtin_file_operations_v1()
    if ops_r.is_err():
        print "LINK-ERR: {ops_r.unwrap_err()}"
        return
    val ops = ops_r.unwrap()
    var objects: [[u8]] = []
    var archives: [[u8]] = []
    var shared: [[u8]] = []
    var shared_names: [text] = []
    var keep: [text] = []
    var out = ""
    var interp = "/lib/ld-linux-aarch64.so.1"
    var pie = false
    var gc = true
    var as_needed = false
    var strip = false
    val t0 = time_now_unix_micros()
    elf_link_trace("inputs: read start")
    for line in lines:
        val t = line.trim()
        if t == "": continue
        val sp = t.index_of(" ") ?? -1
        if sp < 0: continue
        val k = t.substring(0, sp)
        val v = t.substring(sp + 1)
        if k == "obj" or k == "archive" or k == "shared":
            val b = ops.read_bytes(v)
            if b.is_err():
                print "LINK-ERR: read {v}: {b.unwrap_err()}"
                return
            if k == "obj": objects.push(b.unwrap())
            elif k == "archive": archives.push(b.unwrap())
            else:
                shared.push(b.unwrap())
                shared_names.push(leaf(v))
        elif k == "keep": keep.push(v)
        elif k == "out": out = v
        elif k == "interp": interp = v
        elif k == "pie": pie = v == "1"
        elif k == "gc": gc = v == "1"
        elif k == "asneeded": as_needed = v == "1"
        elif k == "strip": strip = v == "1"
    elf_link_trace("inputs: read done")
    val mode = if pie: ELF_LINK_DYNAMIC_PIE else: ELF_LINK_DYNAMIC_EXEC
    val request = ElfLinkRequest(objects: objects, archives: archives, shared: shared,
        entry: "_start", target: RelocArch.AArch64, mode: mode, interp: interp,
        shared_names: shared_names, runpath: "", bind_now: false,
        hash_style: "both", as_needed: as_needed, gc_sections: gc)
    val linked = elf_link_with_operations(request, strip, keep, ops)
    if linked.is_err():
        print "LINK-ERR: {linked.unwrap_err()}"
        print "LINK-TIME-MS: {(time_now_unix_micros() - t0) / 1000}"
        return
    val image = linked.unwrap().image
    elf_link_trace("publish start")
    if not native_image_publish(out, image, true):
        print "LINK-ERR: could not publish {out}"
        return
    elf_link_trace("published")
    print "LINK-OK: {out} {image.len()} bytes"
    print "LINK-TIME-MS: {(time_now_unix_micros() - t0) / 1000}"
main()
