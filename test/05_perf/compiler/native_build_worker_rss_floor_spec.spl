# Native-build worker RSS floor — bounded-RSS regression for
# doc/08_tracking/bug/native_build_interpreted_worker_fixed_2_4gb_floor_2026-08-18.md
# (the worker materialises the compiler closure before compiling anything, so
# its no-argument peak working set is a fixed per-invocation floor; the
# earlyoom mechanism the bug record describes reaps the largest process).
# @req REQ-NATIVE-BUILD-WORKER-RSS-FLOOR-001

use std.spec.step
use std.spec.*
use std.io_runtime.{process_run}
use app.io.env_ops.{env_get}

val CHECK: text = "sh scripts/perf/measure-native-build-worker-floor.shs"

fn run(command: text) -> (text, i64):
    val out = process_run("sh", ["-c", command + " 2>&1"])
    (out.0, out.2)

describe "native-build worker RSS floor":
    it "should keep the no-argument worker peak working set within the floor budget":
        # @req REQ-NATIVE-BUILD-WORKER-RSS-FLOOR-001
        step("Run the no-argument worker repro and compare its peak working set to the budget")
        var binary = "./bin/simple"
        if (env_get("SIMPLE_PERF_BINARY") ?? "") != "":
            binary = env_get("SIMPLE_PERF_BINARY")!
        val (out, code) = run(CHECK + " --binary " + binary)
        expect(code).to_equal(0)
        expect(out).to_contain("worker-rss-floor:")
        expect(out).to_contain("verdict=PASS")
        expect(out).to_contain("peak_kib=")
