# Focused native benchmark for canonical compiler cache-key sequence encoding.
use compiler.common.cache.canonical_identity.{canon_seq, canon_str}

extern fn rt_time_now_unix_micros() -> i64

fn bench_items(count: i64) -> [text]:
    var items: [text] = []
    var index = 0
    while index < count:
        items.push(canon_str("item-" + index.to_text()))
        index = index + 1
    items

fn main():
    if canon_seq([]) != "Q0:" or canon_seq(["a", "", "b"]) != "Q3:ab":
        print "canon_seq_error=small-input"
        return
    val count: i64 = 4096
    val iterations: i64 = 3
    val items = bench_items(count)
    var body_length: i64 = 0
    for item in items:
        body_length = body_length + item.len()
    val expected_length = ("Q" + count.to_text() + ":").len() + body_length
    val started = rt_time_now_unix_micros()
    var index: i64 = 0
    var checksum: i64 = 0
    while index < iterations:
        val encoded = canon_seq(items)
        if encoded.len() != expected_length or not encoded.starts_with("Q4096:S6:item-0"):
            print "canon_seq_error=large-input"
            return
        checksum = checksum + encoded.len()
        index = index + 1
    val elapsed = rt_time_now_unix_micros() - started
    print "canon_seq_count={count}"
    print "canon_seq_iterations={iterations}"
    print "canon_seq_checksum={checksum}"
    print "canon_seq_elapsed_us={elapsed}"
