use app.spipe.testing.*
use compiler.driver.perf.demand_compile_counters.{
    demand_compile_counters_canonical_v1, demand_compile_counters_empty_v1
}

describe "demand compile performance receipt contract":
    it "exposes stable zero-work counters for matched fixtures":
        val encoded = demand_compile_counters_canonical_v1(
            demand_compile_counters_empty_v1())
        expect(encoded).to_contain("source-open=0")
        expect(encoded).to_contain("section-read=0")
        expect(encoded).to_contain("action-scheduled=0")
        expect(encoded).to_contain("cache-hit=0")
