use std.spec.{describe, it, expect}
use app.test.native_module_witness_receipt_perf.{
    shadow_receipt_valid_v1, build_cache_witnesses,
    native_witness_perf_measure_v2, native_witness_perf_json_v2,
    native_witness_peak_rss_from_status_v1
}

fn shadow_fixture(matches: i64, mismatches: i64) -> text:
    "native-module-cache-shadow-receipt-v1\n" +
    "phase=prelookup-attempt\nnon_authoritative=true\n" +
    "authority=closure-wide-sources-fingerprint\nclosure=abc123\n" +
    "matches={matches}\nmismatches={mismatches}\nretained={mismatches}\ntruncated=0\n" +
    (if mismatches > 0: "module=app.main reason=witness-mismatch\n" else: "")

describe "native module witness retained receipt parser":
    it "enforces the NFR schema and consumes persisted witness rows":
        val shadow = shadow_fixture(1000, 0)
        val cache = "{ source: \"a\", module_witness: \"digest-a\" }\n" +
            "{ source: \"b\", module_witness: \"digest-b\" }"
        expect(shadow_receipt_valid_v1(shadow)).to_equal(true)
        expect(build_cache_witnesses(cache).len()).to_equal(2)
        val result = native_witness_perf_measure_v2(
            [shadow], [cache], "a" * 64, "x86_64-unknown-linux-gnu",
            "manifest-sha256", 10000000,
            "Name:\tsimple\nVmRSS:\t1024 kB\nVmHWM:\t4096 kB\n")
        expect(result.valid).to_equal(true)
        expect(result.action_count).to_equal(1000)
        expect(result.hit_rate_ppm).to_equal(1000000)
        expect(result.mismatch_rate_ppm).to_equal(0)
        expect(result.max_rss_kib).to_be_greater_than(0)
        expect(result.max_rss_kib).to_equal(4096)
        expect(native_witness_perf_json_v2(result)).to_contain(
            "\"schema\": \"native-module-cache-witness-perf-v2\"")

    it "rejects incomplete or inconsistent retained evidence":
        val malformed = shadow_fixture(2, 1).replace("retained=1", "retained=2")
        expect(shadow_receipt_valid_v1(malformed)).to_equal(false)
        val incomplete = native_witness_perf_measure_v2(
            [shadow_fixture(1000, 0)], [], "not-a-sha", "", "", 0)
        expect(incomplete.valid).to_equal(false)
        expect(incomplete.nfr_pass).to_equal(false)
        expect(native_witness_peak_rss_from_status_v1(
            "VmHWM:\tunknown kB\n")).to_equal(-1)
        expect(native_witness_peak_rss_from_status_v1(
            "VmHWM:\t42 MB\n")).to_equal(-1)
