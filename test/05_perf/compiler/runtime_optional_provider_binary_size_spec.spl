# codex-system-test
# @req REQ-007 REQ-014 NFR-002 NFR-004 NFR-005 NFR-007
"""# Runtime optional-provider binary-size checker

These executable examples exercise the production BS7 checker and its
mutation-red fixture. The fixture uses synthetic receipts, so passing these
examples proves checker behavior, not Stage4 hello size or startup admission.
The live qualification steps remain in the mirrored manual and test plan.
"""

use std.spec.*
use std.io_runtime.{process_run}

describe "runtime optional-provider binary-size checker":
    it "should accept a clean cohort and reject its five evidence mutations":
        step("Run the production BS7 producer and checker mutation fixture")
        val (output, errors, status) = process_run(
            "/bin/sh",
            ["test/01_unit/scripts/runtime_binary_size_startup_cohort_test.shs"]
        )
        expect(status).to_equal(0)
        expect(errors).to_equal("")
        expect(output).to_contain("BS7 cohort test: PASS — clean cohort and five mutations")

    it "should reject missing admission inputs before returning a size verdict":
        step("Call the production checker without a Stage4 receipt or binaries")
        val (output, errors, status) = process_run(
            "/bin/sh",
            ["scripts/check/check-runtime-binary-size-startup-cohort.shs"]
        )
        expect(status).to_be_greater_than(0)
        expect(output + errors).to_contain("missing-or-symlinked-input")
