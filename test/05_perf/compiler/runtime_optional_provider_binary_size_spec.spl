# BS7 acceptance outline, with no `it` examples or executable assertions.
# The Rust seed also rejects `feature` (feature_block_not_a_bdd_keyword_2026-08-04).
# A current-source admitted Stage4 run is required before any PASS is reported.
feature "Runtime optional-provider binary-size and startup cohorts":
    scenario "development cohort requires thirty admitted Stage4 samples":
        Given "a same-host Simple, C, and Python development cohort"
        When "the BS7 evidence checker validates the retained receipt"
        Then "at least 30 samples per startup lane are required"

    scenario "release cohort requires one hundred admitted Stage4 samples":
        Given "a release qualification cohort"
        When "the BS7 evidence checker validates the retained receipt"
        Then "at least 100 samples per startup lane are required"

    scenario "NoGC hello retains no collector authority":
        Given "a no-allocation NoGC hello binary"
        When "retained sections constructors and initialization roots are inspected"
        Then "the forbidden NoGC inventory is empty"

    scenario "plain-literal hello omits generic string boxing":
        Given "a current-source admitted Stage4 release-small hello build and its unstripped link map"
        When "the hello output and retained runtime sections are inspected"
        Then "output is hello plus newline and rt_string_new_literal rt_to_string and rt_literal_intern_table are absent from retained sections"

    scenario "Linux hello meets both release-small size limits":
        Given "a current-source admitted Stage4 Simple hello and same-host same-toolchain C hello"
        When "both binaries are stripped and checked by the BS7 cohort checker"
        Then "Simple is at most 15360 bytes and at most 105 percent of C"

    scenario "a C-entry runtime probe cannot qualify a Simple hello":
        Given "a direct-writer C-entry probe without a current-source Stage4 Simple executable"
        When "the BS7 qualification checker is given no Stage4 admission receipt"
        Then "the probe is diagnostic only and no Stage4 size verdict is admitted"

    scenario "no-import hello loads no optional provider":
        Given "a no-import interpreter hello"
        When "provider mappings and initializations are traced"
        Then "the optional-provider trace is empty"

    scenario "startup and RSS remain within Python baseline":
        Given "same-host checksum-equivalent Simple and Python samples"
        When "p50 and p95 startup and max RSS are recomputed"
        Then "Simple is no worse than 110 percent of Python"

    scenario "old seed evidence is diagnostic only":
        Given "a Rust seed or pre-Stage4 compiler receipt"
        When "the BS7 qualification checker runs"
        Then "the cohort is rejected as release evidence"
