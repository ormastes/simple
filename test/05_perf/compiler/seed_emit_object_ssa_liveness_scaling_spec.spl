# @req NFR-003 NFR-005
# Bounded microbenchmark for the metadata scans on the LLVM emit-object SSA path.
use std.spec.*
use std.io_runtime.{time_now_unix_micros, file_write, dir_create_all}
use compiler.mir.mir_instructions.{BlockId, MirBlock, MirInst, MirInstKind, MirOperand, MirOperandKind, MirTerminator, MirBinOp}
use compiler.mir.mir_types.{LocalId, LocalKind, MirConstValue, MirLocal, MirType}
use compiler.mir_opt.mir_opt.var_reassign_ssa.{ssa_cross_block_live_locals}

fn seed_emit_local(id: i64) -> LocalId:
    LocalId(id: id)

fn seed_emit_copy(id: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Copy(seed_emit_local(id)))

fn seed_emit_inst(kind: MirInstKind) -> MirInst:
    MirInst(kind: kind, span: nil)

fn seed_emit_liveness_elapsed_us(count: i64) -> i64:
    var locals: [MirLocal] = []
    var blocks: [MirBlock] = []
    var id = 0
    while id < count:
        # Sparse ids prove this path does not allocate a max-id-sized table.
        val local_id = id * 104729
        locals.push(MirLocal(id: seed_emit_local(local_id), name: nil,
            type_: MirType.i64(), kind: LocalKind.Var, is_ghost: false))
        blocks.push(MirBlock(id: BlockId.new(id), label: "b{id}",
            instructions: [seed_emit_inst(MirInstKind.BinOp(seed_emit_local(local_id + 1), MirBinOp.Add, seed_emit_copy(local_id), seed_emit_copy(local_id)))],
            terminator: MirTerminator.Ret(nil)))
        id = id + 1
    val started = time_now_unix_micros()
    val live = ssa_cross_block_live_locals(blocks, locals)
    val elapsed = time_now_unix_micros() - started
    expect(live.len()).to_equal(count)
    elapsed

describe "seed emit-object SSA liveness scaling":
    it "keeps sparse metadata scans bounded and records elapsed time plus peak RSS":
        val small_elapsed_us = seed_emit_liveness_elapsed_us(64)
        val large_elapsed_us = seed_emit_liveness_elapsed_us(256)
        # A hostile shared runner still has a generous absolute ceiling. The
        # receipt retains both measurements for before/after campaign review.
        expect(large_elapsed_us).to_be_less_than(10000001)
        dir_create_all("build/test-artifacts/05_perf/compiler/seed_emit_object_ssa_liveness")
        file_write("build/test-artifacts/05_perf/compiler/seed_emit_object_ssa_liveness/receipt.txt",
            "schema=seed-emit-object-ssa-liveness-v1\nsmall_locals=64\nlarge_locals=256\nsmall_elapsed_us={small_elapsed_us}\nlarge_elapsed_us={large_elapsed_us}\npeak_rss_kib=unavailable_in_bootstrap_seed\nmax_large_elapsed_us=10000000\n")
