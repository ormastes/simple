# Native measurements only. Missing evidence fails; no source-text substitute.
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io_runtime.{env_get_opt}
use std.nogc_sync_mut.io.file_ops.{file_read}

fn store_field(report: text, key: text) -> text:
    var value = ""
    var matches = 0
    for line in report.split("\n"):
        if line.starts_with(key + "="):
            value = line.substring(key.len() + 1).trim()
            matches = matches + 1
    expect(matches).to_equal(1)
    value

fn store_metric(report: text, key: text) -> i64:
    val value = store_field(report, key).to_i64() ?? -1
    expect(value >= 0).to_equal(true)
    value

fn store_report(root: text, count: i64) -> text:
    val report = file_read(root + "/store-{count}.env")
    for key in ["complete", "roundtrip_ok", "warnings_ok", "nested_scope_ok", "write_failure_cleanup_ok", "rename_failure_cleanup_ok"]:
        expect(store_field(report, key)).to_equal("yes")
    expect(store_field(report, "profile")).to_equal("hir-cache-store-retention-v1")
    val producer = env_get_opt("SIMPLE_HIR_STORE_PRODUCER_SHA256") ?? ""
    val producer_source = env_get_opt("SIMPLE_HIR_STORE_PRODUCER_SOURCE_REVISION") ?? ""
    val source = env_get_opt("SIMPLE_HIR_STORE_SOURCE_REVISION") ?? ""
    expect(producer.len()).to_equal(64)
    expect(producer_source.len()).to_equal(40)
    expect(source.len()).to_equal(40)
    for identity in [producer, producer_source, source]:
        for character in identity:
            expect("0123456789abcdef".contains(character)).to_equal(true)
    expect(store_field(report, "producer_sha256")).to_equal(producer)
    expect(store_field(report, "producer_source_revision")).to_equal(producer_source)
    expect(store_field(report, "source_revision")).to_equal(source)
    expect(store_field(report, "fixture_digest").len()).to_equal(64)
    expect(store_metric(report, "count")).to_equal(count)
    expect(store_metric(report, "stores")).to_equal(count + 1)
    expect(store_metric(report, "max_live_growth") <= 65536).to_equal(true)
    expect(store_metric(report, "max_object_growth") <= 128).to_equal(true)
    for key in ["failure_live_growth", "rename_live_growth"]:
        expect(store_metric(report, key) <= 65536).to_equal(true)
    for key in ["failure_object_growth", "rename_object_growth"]:
        expect(store_metric(report, key) <= 128).to_equal(true)
    report

describe "HIR cache publication reclaims serialization scratch":
    it "retains real HIR and warnings through cold stores and failure cleanup":
        val root = env_get_opt("SIMPLE_HIR_STORE_REPORT_DIR") ?? ""
        expect(root != "").to_equal(true)
        val small = store_report(root, 4)
        val large = store_report(root, 8)
        expect(store_metric(large, "elapsed_us") <=
            store_metric(small, "elapsed_us") * 3 + 20000).to_equal(true)
