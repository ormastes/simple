# @req REQ-MIR-CANONICAL-REVERSE-LOOKUP
# Deterministic work evidence, not a wall-time or RSS benchmark.
use std.spec.{describe, it, expect}
use compiler.common.diagnostics.span.Span
use compiler.hir.hir_types.*
use compiler.mir.mir_lowering_types.MirLowering
use compiler.mir.mir_data.*
use compiler.mir.mir_types.*
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir._MirLoweringExpr.switch_operators_calls.*

fn reference_reverse_key(symbols: Dict<text, i64>, id: i64) -> text:
    # Independent oracle: the pre-change lookup, including first-match order.
    for raw_key in symbols.keys():
        val key: text = raw_key
        if symbols[key] == id: return key
    ""

describe "MIR canonical type reverse lookup":
    it "uses the actual lookup without scanning the type inventory":
        var lowering = MirLowering.new(SymbolTable.new())
        var ids: [SymbolId] = []
        var i = 0
        while i < 256:
            val symbol = lowering.canonical_mir_type_symbol_for_key_v1("app.types.Record{i}")
            expect(symbol.id).to_equal(1000000000 + i)
            ids.push(symbol)
            i = i + 1
        var pass_index = 0
        while pass_index < 2:
            i = 0
            while i < ids.len():
                val symbol: SymbolId = ids[i]
                expect(lowering.mir_struct_symbol_name(symbol)).to_equal("Record{i}")
                expect(lowering.canonical_mir_type_key_v1(symbol.id)).to_equal(
                    reference_reverse_key(lowering.canonical_type_symbols, symbol.id))
                i = i + 1
            pass_index = pass_index + 1
        # The old reverse scan visits 2 * (1+...+256) = 65792 rows for
        # these two complete traversals, regardless of Dict iteration order.
        # This counter belongs to the production lookup's fallback loop.
        expect(lowering.canonical_type_reverse_scan_rows).to_equal(0)
        expect(lowering.canonical_type_symbol_names.len()).to_equal(256)
        expect(lowering.next_canonical_type_symbol).to_equal(1000000256)

    it "preserves the HIR mint route, existing IDs and symbol-table precedence":
        var symbols = SymbolTable.new()
        val declared = symbols.define("Node", SymbolKind.Struct, nil,
            Span.empty(), Visibility.Public, false, "lib.nodes")
        var lowering = MirLowering.new(symbols)
        val first = lowering.canonical_mir_type_symbol(declared)
        val again = lowering.canonical_mir_type_symbol(declared)
        expect(first.id).to_equal(1000000000)
        expect(again.id).to_equal(first.id)
        expect(lowering.next_canonical_type_symbol).to_equal(1000000001)
        expect(lowering.canonical_mir_type_key_v1(first.id)).to_equal("lib.nodes.Node")
        lowering.canonical_type_symbol_names[declared.id] = "decoy.Wrong"
        expect(lowering.mir_struct_symbol_name(declared)).to_equal("Node")

    it "preserves direct struct return repair IDs and indexes that mint route":
        var lowering = MirLowering.new(SymbolTable.new())
        val name = "canonical_reverse_fixture_unique_factory"
        bootstrap_fn_ret_shape_register(name, "app.records::Row")
        val signature = MirSignature(params: [], return_type: MirType.unit(),
            is_variadic: false, params_known: true)
        val func = MirOperand(kind: MirOperandKind.Const(MirConstValue.Str(name),
            MirType(kind: MirTypeKind.FuncPtr(signature))))
        val missing = MirType(kind: MirTypeKind.Struct(nil))
        val repaired = lowering.repair_direct_struct_return_type(func, missing)
        val again = lowering.repair_direct_struct_return_type(func, missing)
        expect(repaired).to_equal(again)
        expect(lowering.canonical_type_symbols["app.records.Row"]).to_equal(1000000000)
        expect(lowering.canonical_mir_type_key_v1(1000000000)).to_equal("app.records.Row")
        expect(lowering.canonical_type_reverse_scan_rows).to_equal(0)

    it "indexes canonical array record elements without changing their allocation":
        var lowering = MirLowering.new(SymbolTable.new())
        val owner = "app.records::Element"
        lowering.composite_layout_digests[owner] = "fields[]"
        lowering.composite_layout_owner_counts[owner] = 1
        lowering.struct_field_order[owner] = []
        lowering.struct_field_hir_type[owner] = {}
        lowering.result_err_layout_types[owner] = "fields[]"
        val first = lowering.canonical_array_record_element_type(owner)
        val again = lowering.canonical_array_record_element_type(owner)
        expect(first).to_equal(again)
        expect(lowering.errors.len()).to_equal(0)
        expect(lowering.canonical_type_symbols["app.records.Element"]).to_equal(1000000000)
        expect(lowering.canonical_mir_type_key_v1(1000000000)).to_equal("app.records.Element")
        expect(lowering.canonical_type_reverse_scan_rows).to_equal(0)

    it "checks class membership at lookup time and keeps state per invocation":
        var lowering = MirLowering.new(SymbolTable.new())
        val symbol = lowering.canonical_mir_type_symbol_for_key_v1("app.models.Model")
        expect(lowering.mir_struct_symbol_name(symbol)).to_equal("Model")
        lowering.class_type_names["app.models.Model"] = true
        expect(lowering.mir_struct_symbol_name(symbol)).to_equal("app.models.Model")
        var other = MirLowering.new(SymbolTable.new())
        expect(other.canonical_type_symbol_names.len()).to_equal(0)
        expect(other.mir_struct_symbol_name(symbol)).to_equal("")
        expect(other.next_canonical_type_symbol).to_equal(1000000000)

    it "preserves legacy-map first-match order and caches only the returned key":
        var lowering = MirLowering.new(SymbolTable.new())
        lowering.canonical_type_symbols["app.first.Node"] = 1000000000
        lowering.canonical_type_symbols["app.second.Node"] = 1000000000
        val expected = reference_reverse_key(lowering.canonical_type_symbols, 1000000000)
        expect(lowering.canonical_mir_type_key_v1(1000000000)).to_equal(expected)
        val scanned = lowering.canonical_type_reverse_scan_rows
        expect(scanned).to_be_greater_than(0)
        expect(lowering.canonical_mir_type_key_v1(1000000000)).to_equal(expected)
        expect(lowering.canonical_type_reverse_scan_rows).to_equal(scanned)
