use compiler.driver.cache.package_index_route.{package_index_route_ordered_modules_v1}
use compiler.driver.cache.package_module_index.{PackageModuleIndexEntryV1}
use std.common.crypto.sha256.{sha256_text}

fn main() -> i64:
    val digest = sha256_text("route-benchmark")
    var entries: [PackageModuleIndexEntryV1] = []
    var selected_modules: [text] = []
    var selected: Dict<text, bool> = {}
    var schedule: [text] = []
    var package_heads: Dict<text, i64> = {}
    var package_tails: Dict<text, i64> = {}
    var package_next: [i64] = []
    var i = 0
    while i < 2488:
        val module_identity = "module-{i}"
        val package_identity = "package-{i / 2}"
        entries.push(PackageModuleIndexEntryV1(
            package_identity, module_identity, "src/{module_identity}.spl",
            digest, digest, digest, digest, digest, digest, digest, digest,
            "scc::{package_identity}", [], []))
        selected_modules.push(module_identity)
        selected[module_identity] = true
        package_next.push(-1)
        if package_heads.has(package_identity):
            package_next[package_tails[package_identity]] = i
        else:
            package_heads[package_identity] = i
        package_tails[package_identity] = i
        if i < 1024 and i % 2 == 0:
            schedule.push(package_identity)
        i = i + 1
    var total = 0
    var iteration = 0
    while iteration < 32:
        val ordered = package_index_route_ordered_modules_v1(
            entries, selected_modules, selected, schedule,
            package_heads, package_next)
        if ordered.len() != 2488:
            return 1
        total = total + ordered.len()
        iteration = iteration + 1
    print "ordered_total={total}"
    0
