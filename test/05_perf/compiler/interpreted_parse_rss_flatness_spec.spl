# Interpreted parse RSS flatness — bounded-retention regression for
# doc/08_tracking/bug/native_build_interpreted_worker_rss_blowup_2026-08-18.md
# (term 2: unbounded creep inside the interpreted `parse` step).
# @req REQ-INTERP-PARSE-RSS-FLATNESS-001

use std.spec.step
use std.spec.*
use std.io_runtime.{process_run}
use app.io.env_ops.{env_get}

val CHECK: text = "sh scripts/perf/measure-interpreted-parse-rss-flatness.shs"

fn run(command: text) -> (text, i64):
    val out = process_run("sh", ["-c", command + " 2>&1"])
    (out.0, out.2)

describe "interpreted parse RSS flatness":
    it "should keep peak RSS of N interpreted parses within margin of one parse":
        # @req REQ-INTERP-PARSE-RSS-FLATNESS-001
        step("Run the 1-iteration and N-iteration interpreted parse arms")
        var binary = "./bin/simple"
        if (env_get("SIMPLE_PERF_BINARY") ?? "") != "":
            binary = env_get("SIMPLE_PERF_BINARY")!
        val (out, code) = run(CHECK + " --binary " + binary)
        expect(code).to_equal(0)
        expect(out).to_contain("parse-rss-flatness:")
        expect(out).to_contain("verdict=PASS")
        expect(out).to_contain("delta_kib=")
