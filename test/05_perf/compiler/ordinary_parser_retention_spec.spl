# Native receipts only. Missing measurements fail rather than skip/pass.
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io_runtime.{env_get_opt}
use std.nogc_sync_mut.io.file_ops.{file_read}

fn retention_field(report: text, key: text) -> text:
    var found = ""
    var matches = 0
    for line in report.split("\n"):
        if line.starts_with(key + "="):
            found = line.substring(key.len() + 1).trim()
            matches = matches + 1
    expect(matches).to_equal(1)
    found

fn retention_metric(report: text, key: text) -> i64:
    val value = retention_field(report, key).to_i64() ?? -1
    expect(value >= 0).to_equal(true)
    value

fn retention_report(root: text, mode: text, cache: text, count: i64) -> text:
    val report = file_read(root + "/{mode}-{cache}-{count}.env")
    expect(retention_field(report, "complete")).to_equal("yes")
    expect(retention_field(report, "mode")).to_equal(mode)
    expect(retention_field(report, "cache_state")).to_equal(cache)
    expect(retention_field(report, "profile")).to_equal("ordinary-parser-retention-v1")
    val producer = env_get_opt("SIMPLE_ORDINARY_PARSER_PRODUCER_SHA256") ?? ""
    val producer_source = env_get_opt("SIMPLE_ORDINARY_PARSER_PRODUCER_SOURCE_REVISION") ?? ""
    val source = env_get_opt("SIMPLE_ORDINARY_PARSER_SOURCE_REVISION") ?? ""
    expect(producer.len()).to_equal(64)
    expect(producer_source.len()).to_equal(40)
    expect(source.len()).to_equal(40)
    for identity in [producer, producer_source, source]:
        for character in identity:
            expect("0123456789abcdef".contains(character)).to_equal(true)
    expect(retention_field(report, "producer_sha256")).to_equal(producer)
    expect(retention_field(report, "producer_source_revision")).to_equal(producer_source)
    expect(retention_field(report, "source_revision")).to_equal(source)
    expect(retention_metric(report, "cache_hits")).to_equal(if cache == "warm": count else: 0)
    expect(retention_metric(report, "cache_misses")).to_equal(if cache == "cold": count else: 0)
    expect(retention_metric(report, "parse_work")).to_equal(if cache == "cold": count else: 0)
    expect(retention_metric(report, "count")).to_equal(count)
    expect(retention_metric(report, "functions")).to_equal(count * 128)
    expect(retention_metric(report, "checksum")).to_equal((count * 128) * (count * 128 - 1) / 2)
    var index = 0
    while index < count:
        expect(retention_metric(report, "boundary_{index}_live_bytes") > 0).to_equal(true)
        index = index + 1
    report

describe "ordinary parsing releases scratch while retaining complete modules":
    it "bounds cold and warm retained bytes and objects against a scoped reference":
        val root = env_get_opt("SIMPLE_ORDINARY_PARSER_RETENTION_REPORT_DIR") ?? ""
        expect(root != "").to_equal(true)
        for cache in ["cold", "warm"]:
            for count in [4, 8]:
                val ordinary = retention_report(root, "ordinary", cache, count)
                val reference = retention_report(root, "scoped-reference", cache, count)
                expect(retention_field(ordinary, "fixture_digest").len()).to_equal(64)
                expect(retention_field(ordinary, "fixture_digest")).to_equal(retention_field(reference, "fixture_digest"))
                val ordinary_bytes = retention_metric(ordinary, "live_bytes")
                val reference_bytes = retention_metric(reference, "live_bytes")
                expect(reference_bytes > 0).to_equal(true)
                expect(ordinary_bytes <= reference_bytes + 65536).to_equal(true)
                expect(retention_metric(ordinary, "live_allocations") <=
                    retention_metric(reference, "live_allocations") + 128).to_equal(true)
                expect(retention_metric(ordinary, "elapsed_us") <=
                    retention_metric(reference, "elapsed_us") * 3 / 2 + 20000).to_equal(true)

    it "keeps doubling the module inventory within the existing scaling budget":
        val root = env_get_opt("SIMPLE_ORDINARY_PARSER_RETENTION_REPORT_DIR") ?? ""
        expect(root != "").to_equal(true)
        for cache in ["cold", "warm"]:
            for mode in ["ordinary", "scoped-reference"]:
                val small = retention_report(root, mode, cache, 4)
                val large = retention_report(root, mode, cache, 8)
                expect(retention_metric(large, "elapsed_us") <=
                    retention_metric(small, "elapsed_us") * 3 + 20000).to_equal(true)
