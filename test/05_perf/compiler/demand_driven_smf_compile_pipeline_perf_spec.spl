# codex-system-test
# @manual: primary
# @req NFR-001 NFR-002 NFR-003 NFR-004 NFR-005 NFR-006 PERF-GATE-F PERF-GATE-S PERF-GATE-V PERF-GATE-A PERF-GATE-Q PERF-GATE-J PERF-GATE-R
# @evidence-display: links
use std.spec.*
use std.io_runtime.{process_run}

fn require_perf_evidence(scenario: text, marker: text):
    val (output, errors, status) = process_run(
        "/bin/sh", ["scripts/check/check-demand-driven-smf-compile-performance.shs", "--scenario", scenario])
    expect(status).to_equal(0)
    expect(errors).to_equal("")
    expect(output).to_contain("scenario=" + scenario)
    expect(output).to_contain(marker)
    expect(output).to_contain("samples=100")
    expect(output).to_contain("semantic_equivalence=true")

describe "demand-driven SMF compile performance":
    it "should decide a warm unchanged package within 100 milliseconds for DDSM-NFR-001":
        step("Measure 100 warm package decisions with source-open tracing")
        require_perf_evidence("warm-package-decision", "p50_ms_at_most=100")

    it "should complete a warm unchanged command within 500 milliseconds for DDSM-NFR-002":
        step("Measure 100 warm command invocations")
        require_perf_evidence("warm-command", "p50_ms_at_most=500")

    it "should compile an ordinary package edit within three seconds for DDSM-NFR-003":
        step("Measure isolated package edits with matched semantic output")
        require_perf_evidence("ordinary-package-edit", "p50_ms_at_most=3000")

    it "should compile a broad dependent edit within fifteen seconds for DDSM-NFR-004":
        step("Measure reverse-closure rebuilds on the declared fixture")
        require_perf_evidence("broad-dependent-edit", "p50_ms_at_most=15000")

    it "should build within twice comparable Go after stabilization for DDSM-NFR-005":
        step("Run matched clean Go and Simple builds on pinned hardware")
        require_perf_evidence("matched-go-clean-build", "simple_to_go_ratio_at_most=2.0")

    it "should preserve correctness after daemon loss for DDSM-NFR-006":
        step("Compare warm results before and after daemon loss")
        require_perf_evidence("daemon-loss-correctness", "result_digest_match=true")

    it "should pass the canonical evidence freeze for PERF-GATE-F":
        step("Validate schema vectors, reproducible baseline, and semantic oracle")
        require_perf_evidence("gate-f", "gate=pass")

    it "should pass startup and shared-image admission for PERF-GATE-S":
        step("Validate no-op startup, shared mapping, and foreground isolation")
        require_perf_evidence("gate-s", "gate=pass")

    it "should pass bytecode baseline admission for PERF-GATE-V":
        step("Validate corpus parity, mapped immutability, and startup improvement")
        require_perf_evidence("gate-v", "gate=pass")

    it "should pass precise aspect activation admission for PERF-GATE-A":
        step("Validate zero no-aspect payload and exact invalidation")
        require_perf_evidence("gate-a", "gate=pass")

    it "should pass semantic incremental compilation admission for PERF-GATE-Q":
        step("Validate clean equality, early cutoff, read sets, and cache identity")
        require_perf_evidence("gate-q", "gate=pass")

    it "should pass adaptive native tier admission for PERF-GATE-J":
        step("Validate no cold JIT cost, deoptimization, break-even, and W^X")
        require_perf_evidence("gate-j", "gate=pass")

    it "should pass cross-platform release certification for PERF-GATE-R":
        step("Validate comparative targets, corruption behavior, and determinism")
        require_perf_evidence("gate-r", "gate=pass")
