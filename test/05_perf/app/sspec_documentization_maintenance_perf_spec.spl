# NFR-002, NFR-003, NFR-011: retained deterministic performance/cache gate.
use std.spec.*
use std.io_runtime.{time_now_unix_micros}
use app.sspec_maintain.{analyze_sspec_text}

describe "SSpec documentization maintenance performance":
    it "scans one thousand representative pairs within the selected bound":
        val source = "\"\"\"\n## Purpose and audience\n## Preconditions\n## Evidence and provenance\n## Compatibility and limitations\nREQ-001\n\"\"\"\ndescribe \"perf\":\n    it \"works\":\n        step(\"Act\")\n        expect(1).to_equal(1)\n"
        val started = time_now_unix_micros()
        var i = 0
        var total_score = 0
        while i < 1000:
            total_score = total_score + analyze_sspec_text("fixture_{i}_spec.spl", source).score.aggregate
            i = i + 1
        val elapsed_ms = (time_now_unix_micros() - started) / 1000
        expect(total_score).to_equal(100000)
        expect(elapsed_ms).to_be_less_than(30001)
