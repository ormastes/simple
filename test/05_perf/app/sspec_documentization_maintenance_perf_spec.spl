"""
## Purpose and audience
Purpose: Prove that SSpec documentization maintenance performance.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
# @manual: primary
REQ-APP-SSPEC-DOCUMENTIZATIO-001
doc/01_research/app/REQ-APP-SSPEC-DOCUMENTIZATIO-001.md
doc/03_plan/app/REQ-APP-SSPEC-DOCUMENTIZATIO-001.md
doc/04_architecture/app/REQ-APP-SSPEC-DOCUMENTIZATIO-001.md
doc/05_design/app/REQ-APP-SSPEC-DOCUMENTIZATIO-001.md
"""
# @req: REQ-APP-SSPEC-DOCUMENTIZATIO-001


# NFR-002, NFR-003, NFR-011: retained deterministic performance/cache gate.
use std.spec.*
use std.io_runtime.{time_now_unix_micros, file_read}
use std.crypto.sha256.{sha256_text}
use app.sspec_maintain.{analyze_sspec_pair_text}

fn representative_source() -> text:
    "\"\"\"\n## Purpose and audience\n## Operator workflow\n## Compatibility and limitations\n# @manual: primary\nREQ-001\ndoc/01_research/x.md\ndoc/03_plan/x.md\ndoc/04_architecture/x.md\ndoc/05_design/x.md\n\"\"\"\ndescribe \"performance\":\n    it \"returns the production status\":\n        # @req: REQ-001\n        # @capture(text)\n        step(\"Observe status\")\n        expect(product_status()).to_equal(\"ready\")\n"

fn representative_manual(source_hash: text) -> text:
    "# Performance\n## Purpose and audience\n## Scope and preconditions\n## Primary workflow\n1. Observe status\n## Requirements and traceability\nREQ-001\n## Evidence\nCaptured status\n## Verification and outcomes\nThe captured status is ready.\n## Unsupported behavior and limitations\nNone.\n## Recovery and troubleshooting\nReview diagnostics.\n## Generation history\nGenerated by SPipe.\nSource SHA-256: {source_hash}\n"

fn peak_rss_kib() -> i64:
    # Parse the digits out of `VmHWM:\t   38408 kB` by scanning characters.
    #
    # This deliberately does NOT use `line.split()` with no argument: that form
    # does not split on whitespace here, it yields nothing, so the old
    # `fields.len() > 1` guard was never true and this function always returned
    # 0. That made the `rss_kib > 0` assertion below a hard, permanent RED that
    # had nothing to do with memory use. There is no whitespace-splitting
    # helper in the stdlib (callers such as Trace32Parser.split_whitespace roll
    # their own), so the digits are scanned directly.
    val status = file_read("/proc/self/status")
    for line in status.split("\n"):
        if line.starts_with("VmHWM:"):
            var value: i64 = 0
            var seen_digit = false
            var i = 0
            while i < line.len():
                val c = line.char_code_at(i)
                if c >= 48 and c <= 57:
                    value = value * 10 + (c - 48)
                    seen_digit = true
                else:
                    if seen_digit:
                        return value
                i = i + 1
            if seen_digit:
                return value
    0

use std.spec.step

describe "SSpec documentization maintenance performance":
    it "scans one thousand representative pairs within the selected bound":
        # @req: REQ-APP-SSPEC-DOCUMENTIZATIO-001
        step("Verify: scans one thousand representative pairs within the selected bound")
        val source = representative_source()
        val manual = representative_manual(sha256_text(source))
        val started = time_now_unix_micros()
        var i = 0
        var total_score = 0
        while i < 1000:
            total_score = total_score + analyze_sspec_pair_text(
                "test/fixture_{i}_spec.spl", source, Some(manual)).score.aggregate
            i = i + 1
        val elapsed_ms = (time_now_unix_micros() - started) / 1000
        expect(total_score).to_equal(100000)  # oracle: 100000 — pinned expected value for this behavior
        expect(elapsed_ms).to_be_less_than(30001)
        val rss_kib = peak_rss_kib()
        expect(rss_kib).to_be_greater_than(0)
        expect(rss_kib).to_be_less_than(393217)

    it "keeps warm representative p95 below five hundred milliseconds":
        # @req: REQ-APP-SSPEC-DOCUMENTIZATIO-001
        step("Verify: keeps warm representative p95 below five hundred milliseconds")
        val source = representative_source()
        val manual = representative_manual(sha256_text(source))
        var samples_us: [i64] = []
        var i: i64 = 0
        while i < 20:
            val started = time_now_unix_micros()
            val score = analyze_sspec_pair_text(
                "test/warm_fixture_spec.spl", source, Some(manual)).score.aggregate
            val elapsed = time_now_unix_micros() - started
            samples_us.push(elapsed)
            expect(score).to_equal(100)  # oracle: 100 — pinned expected value for this behavior
            i = i + 1
        samples_us.sort()
        # Nearest-rank p95 for twenty retained warm samples: ceil(20 * .95) - 1.
        expect(samples_us[18]).to_be_less_than(500001)
