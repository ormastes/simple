# @req: REQ-SSPEC-PERF
"""
# Web showcase retained hot path

Repeated presentation cost scales with distinct retained generations rather
than frame count. Byte-identical generation advancement is committed once.
"""

use std.spec.*
use std.io_runtime.{mkdir_p}
use app.ui_showcase.showcase_core.{showcase_build, showcase_scene_with_generation}
use app.ui_showcase.hosts.host_web.{ScreenWebHost}

describe "web showcase retained hot path":

    it "serializes once per distinct byte-identical generation":
        step("Present one hundred frames at each of two generations")
        val root = "build/test-showcase-web-retained-hot-path"
        mkdir_p(root)
        val host = ScreenWebHost.open(7680, 4320, root + "/showcase.html", "")!
        val state = showcase_build("web_perf")
        val first = showcase_scene_with_generation(state, 7680, 4320, 1u32)
        val advanced = showcase_scene_with_generation(state, 7680, 4320, 2u32)
        var frame: i64 = 0
        while frame < 100:
            expect(host.present_scene(first)).to_equal(true)
            frame = frame + 1
        frame = 0
        while frame < 100:
            expect(host.present_scene(advanced)).to_equal(true)
            frame = frame + 1
        expect(host.html_serialize_count).to_equal(2)
        expect(host.html_write_count).to_equal(1)

