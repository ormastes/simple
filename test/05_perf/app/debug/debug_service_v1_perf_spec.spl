# @req NFR-005
# Central-service microbenchmark. Release evidence is valid only when this spec
# runs under the exact admitted Stage 4 binary recorded by the verifier.

use std.spec.{describe, it, expect}
use std.gc_async_mut.io.time_ops.{time_now_nanos}
use std.common.debug.contracts_v1.{
    DebugRootOperationV1, DebugPerturbationV1,
    debug_policy_development_v1,
}
use std.common.debug.service_v1.{DebugServiceV1}

fn debug_perf_sorted_v1(values: [i64]) -> [i64]:
    var sorted = values
    var i: i64 = 1
    while i < sorted.len():
        val key = sorted[i]
        var j = i - 1
        while j >= 0 and sorted[j] > key:
            sorted[j + 1] = sorted[j]
            j = j - 1
        sorted[j + 1] = key
        i = i + 1
    sorted

fn debug_perf_p95_v1(values: [i64]) -> i64:
    val sorted = debug_perf_sorted_v1(values)
    if sorted.len() == 0:
        return -1
    var index = (sorted.len() * 95) / 100
    if index >= sorted.len():
        index = sorted.len() - 1
    sorted[index]

describe "NFR-005 DebugServiceV1 hot-path performance":
    it "keeps warm session lookup p95 at or below one millisecond":
        var service = DebugServiceV1.create()
        var policy = debug_policy_development_v1()
        policy.ttl_ms = -1
        policy.rate_limit_per_minute = -1
        val session_id = service.open_session("sha256:debug-perf-lookup", policy)?
        # Warm the exact path before measuring it.
        expect(service.session(session_id).nil?).to_equal(false)
        var samples: [i64] = []
        for _ in 0..1000:
            val started = time_now_nanos()
            val session = service.session(session_id)
            samples.push(time_now_nanos() - started)
            expect(session.nil?).to_equal(false)
        val p95_ns = debug_perf_p95_v1(samples)
        expect(samples.len()).to_equal(1000)
        expect(p95_ns).to_be_less_than(1000001)

    it "retains bounded passive authorization latency without changing execution":
        var service = DebugServiceV1.create()
        var policy = debug_policy_development_v1()
        policy.ttl_ms = -1
        policy.rate_limit_per_minute = -1
        val session_id = service.open_session("sha256:debug-perf-authorize", policy)?
        var samples: [i64] = []
        for _ in 0..1000:
            val started = time_now_nanos()
            val receipt = service.authorize(
                session_id, DebugRootOperationV1.Observe,
                DebugPerturbationV1.Passive, "perf.observe",
            )
            samples.push(time_now_nanos() - started)
            expect(receipt.allowed).to_equal(true)
            expect(receipt.execution_changed).to_equal(false)
        val p95_ns = debug_perf_p95_v1(samples)
        expect(samples.len()).to_equal(1000)
        # The shared NFR sets passive event handling at 5 ms/event.
        expect(p95_ns).to_be_less_than(5000001)
