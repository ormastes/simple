use http_workload_v1.{item5_http_workload_v1}
use provider_construction_v1.{item5_perf_admission_v1}
use std.nogc_sync_mut.http_server.vector_parser.{HttpVectorRequestParserV1, http_vector_parser_session_open_owned_v1}
use std.nogc_sync_mut.sffi.system.{args}

fn main() -> i32:
    val argv = args()
    if argv.len() < 2: return 1
    val opened = http_vector_parser_session_open_owned_v1(item5_perf_admission_v1(argv[argv.len() - 2], argv[argv.len() - 1], 12))
    if opened.status != 0: return 2
    item5_http_workload_v1(Some(HttpVectorRequestParserV1.from_session(opened.session)))
