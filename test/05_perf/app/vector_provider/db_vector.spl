use db_workload_v1.{item5_db_workload_v1, Item5DbReducerSlotV1}
use provider_construction_v1.{item5_perf_admission_v1}
use nogc_sync_mut.database.pure_sql.bitmap_provider_v1.{pure_database_vector_bitmap_reducer_open_owned_v1}
use std.nogc_sync_mut.sffi.system.{args}

fn main() -> i32:
    val argv = args()
    if argv.len() < 5: return 1
    val base = argv.len() - 5
    val count = argv[base].parse_int() ?? 0
    val opened = pure_database_vector_bitmap_reducer_open_owned_v1(item5_perf_admission_v1(argv[base + 1], argv[base + 2], 1))
    if opened.status != 0: return 2
    if opened.reducer.provider_identity() != argv[base + 3] or opened.reducer.implementation_identity() != argv[base + 4]: return 3
    item5_db_workload_v1(count, Some(Item5DbReducerSlotV1(reducer: opened.reducer)))
