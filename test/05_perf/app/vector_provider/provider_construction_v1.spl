use os.smf.provider_loader.{ProviderAdmissionRequestV1}

fn item5_perf_admission_v1(path: text, digest: text, caps: u64) -> ProviderAdmissionRequestV1:
    ProviderAdmissionRequestV1(
        artifact_path: path, artifact_kind: "native", expected_artifact_digest: digest,
        granted_capability_bits: caps, required_capability_bits: caps,
        host_abi: 1, minimum_host_abi: 1, maximum_host_abi: 1,
        requested_interface_major: 1, requested_interface_minor: 0,
        provided_interface_major: 1, provided_interface_minor: 0)

export item5_perf_admission_v1
