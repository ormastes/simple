#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
SIMPLE_BIN="${SIMPLE_BIN:-$ROOT/bin/simple}"
OUT="${MCDC_RT_HAL_PERF_OUT:-$ROOT/build/perf/mcdc_rt_hal}"
RUNS="${MCDC_RT_HAL_RUNS:-7}"
FIXTURE="$ROOT/test/05_perf/mcdc_rt_hal/mcdc_decision_fixture.spl"
RT_FIXTURE="$ROOT/test/05_perf/mcdc_rt_hal/rt_hal_fixture.spl"
ANALYZER_FIXTURE="$ROOT/test/05_perf/mcdc_rt_hal/mcdc_analyzer_fixture.spl"
CSV="$OUT/evidence.csv"
mkdir -p "$OUT/bin" "$OUT/raw" "$OUT/heaptrack"

blocked() { echo "BLOCKED: $*" >&2; exit 2; }
command -v /usr/bin/time >/dev/null 2>&1 || blocked "GNU /usr/bin/time is required"
command -v size >/dev/null 2>&1 || blocked "binutils size is required"
command -v heaptrack >/dev/null 2>&1 || blocked "heaptrack is required for allocation evidence"
command -v heaptrack_print >/dev/null 2>&1 || blocked "heaptrack_print is required"
[ -x "$SIMPLE_BIN" ] || blocked "Pure Simple compiler not executable: $SIMPLE_BIN"
case "$RUNS" in ''|*[!0-9]*) blocked "MCDC_RT_HAL_RUNS must be an odd integer >= 3" ;; esac
[ "$RUNS" -ge 3 ] && [ $((RUNS % 2)) -eq 1 ] || blocked "MCDC_RT_HAL_RUNS must be an odd integer >= 3"

compile_lane() {
    lane="$1" mode="$2" owner_bytes="$3" output="$4"
    "$SIMPLE_BIN" compile "$FIXTURE" --native --release \
        --mcdc-mode="$mode" --mcdc-owner-bytes="$owner_bytes" \
        --mcdc-global-bytes=67108864 -o "$output" \
        >"$OUT/raw/build-$lane.out" 2>"$OUT/raw/build-$lane.err" || blocked "compile failed for $lane"
}

compile_lane off static-off 1048576 "$OUT/bin/mcdc-off"
compile_lane static-on static-on 1048576 "$OUT/bin/mcdc-static-on"
compile_lane dynamic dynamic-aspect 1048576 "$OUT/bin/mcdc-dynamic"
compile_lane static-saturation static-on 8192 "$OUT/bin/mcdc-static-saturation"
"$SIMPLE_BIN" compile "$RT_FIXTURE" --native --release --mcdc-mode=static-off \
    -o "$OUT/bin/rt-hal" >"$OUT/raw/build-rt-hal.out" \
    2>"$OUT/raw/build-rt-hal.err" || blocked "compile failed for rt(hal) fixture"
"$SIMPLE_BIN" compile "$ANALYZER_FIXTURE" --native --release --mcdc-mode=static-off \
    -o "$OUT/bin/mcdc-analyzer" >"$OUT/raw/build-analyzer.out" \
    2>"$OUT/raw/build-analyzer.err" || blocked "compile failed for analyzer fixture"

median() { sort -n "$1" | awk '{v[++n]=$1} END {if (!n) exit 1; print v[(n+1)/2]}'; }
field() {
    awk -v key="$2" '{for (i=1; i<=NF; i++) if (index($i, key "=")==1) {sub("^" key "=", "", $i); value=$i}} END {print value}' "$1"
}
text_bytes() { size -A "$1" | awk '$1==".text" {print $2; found=1} END {if(!found) exit 1}'; }
allocation_calls() {
    report="$1"
    sed -n 's/.*calls to allocation functions:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$report" | head -1
}

echo 'lane,elapsed_ns_p50,max_rss_kib,allocation_calls,hot_allocation_delta,artifact_bytes,text_bytes,checksum,recorded,dropped,overwritten,saturated,status' >"$CSV"

measure_lane() {
    lane="$1" binary="$2" argument_name="$3" argument_value="$4"
    lane_argument="--$argument_name=$argument_value"
    elapsed_file="$OUT/raw/$lane.elapsed"
    : >"$elapsed_file"
    "$binary" "$lane_argument" >"$OUT/raw/$lane.warm.out" 2>"$OUT/raw/$lane.warm.err" || blocked "$lane warm run failed"
    max_rss=0
    sample=1
    checksum=""
    while [ "$sample" -le "$RUNS" ]; do
        output="$OUT/raw/$lane.$sample.out"
        rss="$OUT/raw/$lane.$sample.rss"
        /usr/bin/time -f '%M' -o "$rss" "$binary" "$lane_argument" >"$output" 2>"$OUT/raw/$lane.$sample.err" || blocked "$lane sample $sample failed"
        value="$(field "$output" elapsed_ns)"; [ -n "$value" ] || blocked "$lane emitted no elapsed_ns"
        printf '%s\n' "$value" >>"$elapsed_file"
        current_checksum="$(field "$output" checksum)"; [ -n "$current_checksum" ] || blocked "$lane emitted no checksum"
        if [ -n "$checksum" ] && [ "$checksum" != "$current_checksum" ]; then blocked "$lane checksum changed"; fi
        checksum="$current_checksum"
        rss_value="$(cat "$rss")"; [ "$rss_value" -gt "$max_rss" ] && max_rss="$rss_value"
        sample=$((sample + 1))
    done

    heap_prefix="$OUT/heaptrack/$lane.full"
    empty_prefix="$OUT/heaptrack/$lane.empty"
    heaptrack -o "$heap_prefix" "$binary" "$lane_argument" >/dev/null 2>"$OUT/raw/$lane.heaptrack.err" || blocked "$lane Heaptrack run failed"
    heaptrack -o "$empty_prefix" "$binary" "$lane_argument" --empty >/dev/null 2>"$OUT/raw/$lane.heaptrack-empty.err" || blocked "$lane empty Heaptrack run failed"
    full_trace="$(ls "$heap_prefix"*.gz | head -1)"; empty_trace="$(ls "$empty_prefix"*.gz | head -1)"
    heaptrack_print "$full_trace" >"$OUT/heaptrack/$lane.full.txt" || blocked "$lane Heaptrack report failed"
    heaptrack_print "$empty_trace" >"$OUT/heaptrack/$lane.empty.txt" || blocked "$lane empty Heaptrack report failed"
    full_alloc="$(allocation_calls "$OUT/heaptrack/$lane.full.txt")"
    empty_alloc="$(allocation_calls "$OUT/heaptrack/$lane.empty.txt")"
    [ -n "$full_alloc" ] && [ -n "$empty_alloc" ] || blocked "$lane allocation totals were not parseable"
    hot_alloc=$((full_alloc - empty_alloc)); [ "$hot_alloc" -ge 0 ] || blocked "$lane allocation delta was negative"

    final="$OUT/raw/$lane.$RUNS.out"
    recorded="$(field "$final" recorded)"; dropped="$(field "$final" dropped)"
    overwritten="$(field "$final" overwritten)"; saturated="$(field "$final" saturated)"
    lane_status="$(field "$final" status)"; [ -n "$lane_status" ] || lane_status="ok"
    case "$lane" in rt-hal-*) [ "$lane_status" = "ok" ] || blocked "$lane unavailable: $lane_status" ;; esac
    printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,PENDING\n' \
        "$lane" "$(median "$elapsed_file")" "$max_rss" "$full_alloc" "$hot_alloc" \
        "$(stat -c %s "$binary")" "$(text_bytes "$binary")" "$checksum" \
        "$recorded" "$dropped" "$overwritten" "$saturated" >>"$CSV"
}

measure_lane off "$OUT/bin/mcdc-off" lane off
measure_lane static-on "$OUT/bin/mcdc-static-on" lane static-on
measure_lane dynamic-dormant "$OUT/bin/mcdc-dynamic" lane dynamic-dormant
measure_lane dynamic-enabled "$OUT/bin/mcdc-dynamic" lane dynamic-enabled
measure_lane static-saturation "$OUT/bin/mcdc-static-saturation" lane static-on
for lane in pure c rust c-rust; do
    measure_lane "rt-hal-$lane" "$OUT/bin/rt-hal" lane "$lane"
done
for scale in base double-e double-c; do
    measure_lane "analyzer-$scale" "$OUT/bin/mcdc-analyzer" scale "$scale"
done

awk -F, '
NR==1 {next}
{time[$1]=$2; rss[$1]=$3; alloc[$1]=$5; text[$1]=$7; sum[$1]=$8; sat[$1]=$12}
END {
  fail=0
  if (sum["off"] != sum["static-on"] || sum["off"] != sum["dynamic-dormant"] || sum["off"] != sum["dynamic-enabled"]) {print "FAIL: checksum parity" > "/dev/stderr"; fail=1}
  if (text["off"] != text["static-saturation"] && text["off"] != text["static-on"]) { } # static-on is expected to contain probes
  if (alloc["off"] != 0 || alloc["static-on"] != 0 || alloc["dynamic-dormant"] != 0 || alloc["dynamic-enabled"] != 0) {print "FAIL: hot-path allocation delta" > "/dev/stderr"; fail=1}
  if ((time["static-on"]-time["off"])*10000 > time["off"]*500) {print "FAIL: NFR-002 time" > "/dev/stderr"; fail=1}
  if ((rss["static-on"]-rss["off"])*10000 > rss["off"]*500) {print "FAIL: NFR-002 RSS" > "/dev/stderr"; fail=1}
  if ((time["dynamic-dormant"]-time["off"])*10000 > time["off"]*100) {print "FAIL: NFR-003 dormant time" > "/dev/stderr"; fail=1}
  if ((rss["dynamic-dormant"]-rss["off"])*10000 > rss["off"]*100) {print "FAIL: NFR-003 dormant RSS" > "/dev/stderr"; fail=1}
  if ((time["dynamic-enabled"]-time["off"])*10000 > time["off"]*1000) {print "FAIL: NFR-003 enabled time" > "/dev/stderr"; fail=1}
  if ((rss["dynamic-enabled"]-rss["off"])*10000 > rss["off"]*500) {print "FAIL: NFR-003 enabled RSS" > "/dev/stderr"; fail=1}
  if (sat["static-saturation"] != "true") {print "FAIL: NFR-004 saturation not observed" > "/dev/stderr"; fail=1}
  if (time["analyzer-double-e"]*10000 > time["analyzer-base"]*25000) {print "FAIL: NFR-005 evaluation scaling" > "/dev/stderr"; fail=1}
  if (time["analyzer-double-c"]*10000 > time["analyzer-base"]*25000) {print "FAIL: NFR-005 condition scaling" > "/dev/stderr"; fail=1}
  if (rss["analyzer-double-e"]*10000 > rss["analyzer-base"]*25000) {print "FAIL: NFR-005 evaluation RSS scaling" > "/dev/stderr"; fail=1}
  if (rss["analyzer-double-c"]*10000 > rss["analyzer-base"]*25000) {print "FAIL: NFR-005 condition RSS scaling" > "/dev/stderr"; fail=1}
  exit fail
}' "$CSV" || exit 1

# Static-off is compared against a second explicit static-off build to make
# the zero attributable text-size gate independent of timestamps/build IDs.
"$SIMPLE_BIN" compile "$FIXTURE" --native --release \
    -o "$OUT/bin/mcdc-off-control" >"$OUT/raw/build-off-control.out" \
    2>"$OUT/raw/build-off-control.err" || blocked "compile failed for no-MC/DC control"
[ "$(text_bytes "$OUT/bin/mcdc-off")" = "$(text_bytes "$OUT/bin/mcdc-off-control")" ] || { echo "FAIL: NFR-001 static-off .text delta" >&2; exit 1; }

echo "revision=$(git -C "$ROOT" rev-parse HEAD)" >"$OUT/run.receipt"
echo "runs=$RUNS" >>"$OUT/run.receipt"
echo "thresholds=test/05_perf/mcdc_rt_hal/thresholds.sdn" >>"$OUT/run.receipt"
echo "evidence=${CSV#$ROOT/}" >>"$OUT/run.receipt"
echo "status=PASS" >>"$OUT/run.receipt"
echo "PASS: evidence written to ${CSV#$ROOT/}"
