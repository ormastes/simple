schema = "simple.mcdc-rt-hal-perf-thresholds.v1"
fixture_revision = "mcdc-rt-hal-v1"
# Requirement mapping is explicit so report tooling cannot silently omit a
# non-numeric gate.
nfr_001_gate = "static-off-text-and-hot-allocation-zero"
nfr_002_gate = "static-on-time-rss-and-hot-allocation"
nfr_003_gate = "dynamic-dormant-enabled-time-rss-allocation"
nfr_004_gate = "fixed-owner-global-cap-and-saturation-counters"
nfr_005_gate = "analyzer-double-e-double-c-scaling"
nfr_006_gate = "bounded-deterministic-rt-hal-and-effect-once"
nfr_007_gate = "ordered-hot-path-review-required"
nfr_008_gate = "same-fixture-combined-evidence-required"
nfr_009_gate = "optimizer-receipts-required"
warmup_processes = 1
measured_processes = 7
mcdc_iterations = 4000000
rt_hal_iterations = 16
static_on_time_basis_points_max = 500
static_on_rss_basis_points_max = 500
dynamic_dormant_time_basis_points_max = 100
dynamic_dormant_rss_basis_points_max = 100
dynamic_enabled_time_basis_points_max = 1000
dynamic_enabled_rss_basis_points_max = 500
analyzer_double_dimension_ratio_basis_points_max = 25000
hot_path_allocation_delta_max = 0
static_off_text_delta_bytes_max = 0
owner_bytes_default = 1048576
global_bytes_default = 67108864
optimizer_level = "O3"
rt_hal_worker_count = 2
rt_hal_queue_capacity = 16
rt_hal_timeout_ticks = 5000
rt_hal_output_bytes_max = 512
rt_hal_effect_count_exact = true
