# Bounded RT/HAL benchmark. Pure owns canonical receipts; foreign providers
# are pinned static processes admitted through the exact registered API.
use test.perf.bench.lib.timing.{bench_now_ns}
use std.cli.cli_util.{get_cli_args}
use std.common.rt_hal.model.{RtHalOperationKind}
use std.nogc_sync_mut.rt_hal.exact_boundary.{RtHalDigest256, RtHalExactRequest, RtHalCanonicalReceipt, RtHalExactStatus}
use std.nogc_sync_mut.rt_hal.process_task_arena.{rt_hal_process_controller_claim, rt_hal_process_arena_shutdown}
use std.nogc_sync_mut.rt_hal.tagged.{RtHalTagPolicy, rt_hal_execute_registered_exact}
use app.io.rt_hal_isolated_host.{rt_hal_install_isolated_exact_host_from_plan}
use test.fixtures.rt_hal_external.fixture_plan.{
    RtHalExternalFixtureConfig, rt_hal_external_provider_plan,
    rt_hal_external_expected_receipt
}

fn argument(args: [text], name: text, fallback: text) -> text:
    val prefix = "--" + name + "="
    for item in args:
        if item.starts_with(prefix): return item.substring(prefix.len())
    fallback

fn has_flag(args: [text], name: text) -> bool:
    for item in args:
        if item == "--" + name: return true
    false

fn digest(base: i64) -> RtHalDigest256:
    RtHalDigest256(word0: base, word1: base + 1, word2: base + 2, word3: base + 3)

fn exact_requests() -> [RtHalExactRequest]:
    var values: [RtHalExactRequest] = []
    var i: i64 = 0
    while i < 8:
        values.push(RtHalExactRequest(case_id: 100 + i,
            operation: if i == 7: RtHalOperationKind.Effectful else: RtHalOperationKind.Query,
            operation_digest: digest(1000 + i * 16), input_digest: digest(2000 + i * 16)))
        i = i + 1
    values

var pure_effect_count: i64 = 0

# Pure owns the effect: incrementing this owner-local counter and producing its
# trace happen once before any foreign replay is admitted.
fn observe_pure_receipts(requests: [RtHalExactRequest]) -> [RtHalCanonicalReceipt]:
    var values: [RtHalCanonicalReceipt] = []
    var i: i64 = 0
    while i < requests.len():
        if requests[i].operation == RtHalOperationKind.Effectful:
            pure_effect_count = pure_effect_count + 1
        values.push(rt_hal_external_expected_receipt(
            requests[i], digest(5000 + i * 16)))
        i = i + 1
    values

# O(cases), no per-iteration container growth or copying.
fn pure_checksum(receipts: [RtHalCanonicalReceipt]) -> i64:
    var checksum: i64 = 0
    for receipt in receipts:
        checksum = checksum + receipt.case_id + receipt.outcome_digest.word0
        checksum = checksum + receipt.error_digest.word0 + receipt.trace_digest.word0
    checksum

fn main():
    val args = get_cli_args()
    val lane = argument(args, "lane", "pure")
    val iterations: i64 = if has_flag(args, "empty"): 0 else: 16
    val compare_c = lane == "c" or lane == "c-rust"
    val compare_rust = lane == "rust" or lane == "c-rust"
    val requests = exact_requests()
    val receipts = observe_pure_receipts(requests)
    val foreign_count = (if compare_c: 1 else: 0) + (if compare_rust: 1 else: 0)
    val expected_results = requests.len() * foreign_count
    val policy = RtHalTagPolicy(compare_c: compare_c, compare_rust: compare_rust,
        worker_count: 2, queue_capacity: 16, timeout_ticks: 5000,
        max_output_bytes: 512, require_all: true)

    if foreign_count > 0:
        val config = RtHalExternalFixtureConfig(repo: argument(args, "repo", ""),
            cc: "", cc_hash: "", rustc: "", rustc_hash: "",
            c_output: argument(args, "c-provider", ""),
            rust_output: argument(args, "rust-provider", ""))
        val providers = rt_hal_external_provider_plan(config,
            argument(args, "c-sha256", ""), argument(args, "rust-sha256", ""))
        val install_problem = rt_hal_install_isolated_exact_host_from_plan(providers,
            compare_c, compare_rust, "rthal-c-v1", "rthal-rust-v1", 2, 16, 5000, 512, 2)
        if install_problem != "":
            print "lane=rt-hal-{lane} iterations=0 elapsed_ns=0 checksum=0 cases=8 status=BLOCKED:{install_problem}"
            return
        val controller_problem = rt_hal_process_controller_claim()
        if controller_problem != "":
            print "lane=rt-hal-{lane} iterations=0 elapsed_ns=0 checksum=0 cases=8 status=BLOCKED:{controller_problem}"
            return

    # Identical unretained owner pass for every lane; foreign warmup is also outside timing.
    var checksum = pure_checksum(receipts)
    if foreign_count > 0:
        val warm = rt_hal_execute_registered_exact(policy, requests, receipts)
        if (warm.error != "" or warm.results.len() != expected_results or
                warm.completed_tasks != expected_results):
            rt_hal_process_arena_shutdown()
            print "lane=rt-hal-{lane} iterations=0 elapsed_ns=0 checksum=0 cases=8 status=BLOCKED:RTHAL-E-WARMUP"
            return

    val start = bench_now_ns()
    var iteration: i64 = 0
    var problem = ""
    while iteration < iterations and problem == "":
        # Receipt construction is inside every timed lane so foreign timings
        # are compared against the same end-to-end Pure ownership cost.
        val iteration_receipts = observe_pure_receipts(requests)
        checksum = checksum + pure_checksum(iteration_receipts)
        if foreign_count > 0:
            val report = rt_hal_execute_registered_exact(
                policy, requests, iteration_receipts)
            if (report.error != "" or report.results.len() != expected_results or
                    report.completed_tasks != expected_results):
                problem = if report.error == "": "RTHAL-E-RESULT-COUNT" else: report.error
            else:
                for result in report.results:
                    if result.status != RtHalExactStatus.Match: problem = "RTHAL-E-NON-MATCH"
                if lane == "c-rust" and not report.actual_parallel: problem = "RTHAL-E-NOT-PARALLEL"
        iteration = iteration + 1
    val elapsed = bench_now_ns() - start
    val expected_effect_count = iterations + 1
    if problem == "" and pure_effect_count != expected_effect_count:
        problem = "RTHAL-E-EFFECT-COUNT"
    if foreign_count > 0:
        val shutdown_problem = rt_hal_process_arena_shutdown()
        if problem == "" and shutdown_problem != "": problem = shutdown_problem
    val status = if problem == "": "ok" else: "BLOCKED:" + problem
    print "lane=rt-hal-{lane} iterations={iterations} elapsed_ns={elapsed} checksum={checksum} cases=8 effect_count={pure_effect_count} status={status}"
