# @req: REQ-LIB-STD-001
# Std Benchmark Library Tests
#
# **Feature IDs:** Testing Infrastructure - Benchmarking
# **Category:** Testing | Performance
# **Status:** Active
#
# Tests for the `std.testing.benchmark` library.
# Note: Many benchmark operations chain methods which are not supported
# in interpreter mode. Tests use intermediate variables to work around this.

use std.benchmark.benchmark_config.{BenchmarkConfig, benchmark_config_default, benchmark_config_quick}
use std.benchmark.benchmark_stats.{BenchmarkStats, calculate_stats, format_time}

fn _text_contains(s: text, sub: text) -> bool:
    s.contains(sub)

use std.spec.step
describe "Benchmarking Library":
    slow_it "default config has correct warmup":
        # @req: REQ-LIB-STD-001
        step("Verify: default config has correct warmup")
        val config = benchmark_config_default()
        expect(config.warmup_iterations).to_equal(3) # oracle: pinned expected value documenting the asserted outcome

    slow_it "default config has correct measurement iterations":
        # @req: REQ-LIB-STD-001
        step("Verify: default config has correct measurement iterations")
        val config = benchmark_config_default()
        expect(config.measurement_iterations).to_equal(100) # oracle: pinned expected value documenting the asserted outcome

    slow_it "default config has correct sample size":
        # @req: REQ-LIB-STD-001
        step("Verify: default config has correct sample size")
        val config = benchmark_config_default()
        expect(config.sample_size).to_equal(10) # oracle: pinned expected value documenting the asserted outcome

    slow_it "quick config has warmup of 1":
        # @req: REQ-LIB-STD-001
        step("Verify: quick config has warmup of 1")
        val config = benchmark_config_quick()
        expect(config.warmup_iterations).to_equal(1) # oracle: pinned expected value documenting the asserted outcome

    slow_it "quick config has sample size of 3":
        # @req: REQ-LIB-STD-001
        step("Verify: quick config has sample size of 3")
        val config = benchmark_config_quick()
        expect(config.sample_size).to_equal(3) # oracle: pinned expected value documenting the asserted outcome

    slow_it "custom config has correct sample size":
        # @req: REQ-LIB-STD-001
        step("Verify: custom config has correct sample size")
        val config = BenchmarkConfig(
            warmup_iterations: 1,
            measurement_iterations: 50,
            sample_size: 5,
            outlier_threshold: 1.5
        )
        expect(config.sample_size).to_equal(5) # oracle: pinned expected value documenting the asserted outcome

    slow_it "format_time formats nanoseconds":
        # @req: REQ-LIB-STD-001
        step("Verify: format_time formats nanoseconds")
        val result = format_time(500.0)
        val has_ns = _text_contains(result, "ns")
        expect(has_ns).to_equal(true)

    slow_it "format_time formats microseconds":
        # @req: REQ-LIB-STD-001
        step("Verify: format_time formats microseconds")
        val result = format_time(1500.0)
        val has_us = _text_contains(result, "us")
        expect(has_us).to_equal(true)

    slow_it "format_time formats milliseconds":
        # @req: REQ-LIB-STD-001
        step("Verify: format_time formats milliseconds")
        val result = format_time(1500000.0)
        val has_ms = _text_contains(result, "ms")
        expect(has_ms).to_equal(true)

    slow_it "format_time formats seconds":
        # @req: REQ-LIB-STD-001
        step("Verify: format_time formats seconds")
        val result = format_time(1500000000.0)
        val has_s = _text_contains(result, "s")
        expect(has_s).to_equal(true)
