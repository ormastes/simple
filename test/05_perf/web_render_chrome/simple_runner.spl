# simple_runner.spl
#
# Simple web renderer fixture runner — real, fail-closed.
#
# Drives the production Simple browser/renderer pipeline
# (simple_web_layout_render_html_software_result, the same entry the
# test/01_unit/lib/gc_async_mut/gpu/browser_engine specs drive) over each HTML
# fixture at the SAME viewport the Chrome runner captures at (3840x2160), and
# writes one JSON artifact per fixture.
#
# Fail-closed contract, mirroring chrome_runner.spl:
#   chrome_runner admits a row only when a real Chrome process returned a
#   3840x2160 PNG with a 64-hex digest. This runner admits a row only when a
#   real render returned a full-size framebuffer that the renderer itself
#   reports presentable — i.e. NOT budget-degraded — and that actually carries
#   non-background pixels. A degraded render is a correctly-sized uniform
#   buffer (see the SimpleWebLayoutPixelResult class comment in
#   src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer.spl)
#   and is therefore NOT a measurement; such a row stays source="synthetic"
#   with every timing at 0 and the reason recorded in `note`.
#
# Phase fields (parse_ms/style_ms/layout_ms/paint_ms/composite_ms/present_ms)
# are all 0.0 and stay 0.0: the public renderer API exposes no per-stage
# timings. The only stage-timed entry,
# simple_web_layout_render_html_software_pixels_traced
# (simple_web_html_layout_renderer.spl:2269), PRINTS its stage times to stdout
# and returns only [u32], so an in-process caller cannot read them; the
# stage-splitting primitives it uses (parse_html, extract_css_vw, layout, ...)
# are module-private. Splitting the measured total across those fields would be
# fabrication, so they are left at 0 instead.
#
# Budget note: budget_ms is deliberately NOT passed. Supplying that explicit
# i64 default-arg is a known seed-interpreter defect that poisons render output
# (doc/08_tracking/bug/seed_interp_explicit_i64_default_arg_poisons_render_backgrounds_2026-07-11.md,
# cited at simple_web_html_layout_renderer_foundation.spl:187-194). The
# sanctioned override is the SIMPLE_WEB_RENDER_BUDGET_MS environment variable.
#
# Output: test/05_perf/web_render_chrome/artifacts/simple_<fixture>.json
#
# Usage:
#   SIMPLE_LIB=src <simple> run test/05_perf/web_render_chrome/simple_runner.spl

use std.io_runtime.{dir_create_all, file_exists, file_read, file_write, time_now_unix_micros}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_software_result,
    simple_web_layout_software_pixels_presentable}

# ---------------------------------------------------------------------------
# Constants — viewport matches chrome_runner.spl exactly so the two sides are
# comparable at all.
# ---------------------------------------------------------------------------

val VIEWPORT_WIDTH: i32 = 3840
val VIEWPORT_HEIGHT: i32 = 2160
val WARMUP_FRAMES = 1
val MEASURE_FRAMES = 3
val FIXTURES = ["static_page", "scroll_heavy", "layout_stress", "paint_heavy"]

# ---------------------------------------------------------------------------
# SimpleFrameRecord: per-fixture collected timings
# ---------------------------------------------------------------------------

class SimpleFrameRecord:
    fixture:      text
    source:       text   # "measured" | "synthetic"
    parse_ms:     f64
    style_ms:     f64
    layout_ms:    f64
    paint_ms:     f64
    composite_ms: f64
    present_ms:   f64
    total_frame_ms: f64
    frame_ms_p50:   f64
    frame_ms_p95:   f64
    warm_sample_count: i64
    pixel_count:       i64
    nonbackground_pixels: i64
    render_degraded:   bool
    degrade_reason:    text
    pixel_hash:     text
    error_msg:      text

fn make_simple_record(fixture: text) -> SimpleFrameRecord:
    SimpleFrameRecord(
        fixture:      fixture,
        source:       "synthetic",
        parse_ms:     0.0,
        style_ms:     0.0,
        layout_ms:    0.0,
        paint_ms:     0.0,
        composite_ms: 0.0,
        present_ms:   0.0,
        total_frame_ms: 0.0,
        frame_ms_p50:   0.0,
        frame_ms_p95:   0.0,
        warm_sample_count: 0,
        pixel_count:       0,
        nonbackground_pixels: 0,
        render_degraded:   false,
        degrade_reason:    "",
        pixel_hash:     "",
        error_msg:      "measurement not attempted",
    )

# ---------------------------------------------------------------------------
# Timing helpers (module-level fns — avoids interpreter it-block var mutation)
# ---------------------------------------------------------------------------

fn now_ms() -> f64:
    time_now_unix_micros().to_f64() / 1000.0

fn percentile_f64(values: [f64], pct: f64) -> f64:
    val n = values.len()
    if n == 0:
        return 0.0
    # Insertion sort (small n — MEASURE_FRAMES frames)
    var sorted: [f64] = []
    var vi = 0
    while vi < n:
        sorted.push(values[vi])
        vi = vi + 1
    var si = 1
    while si < sorted.len():
        val key = sorted[si]
        var j = si - 1
        while j >= 0 and sorted[j] > key:
            sorted[j + 1] = sorted[j]
            j = j - 1
        sorted[j + 1] = key
        si = si + 1
    val idx_f = pct / 100.0 * (n - 1).to_f64()
    val lo = idx_f.floor().to_i64()
    val hi = lo + 1
    if hi >= n:
        return sorted[lo]
    val frac = idx_f - lo.to_f64()
    sorted[lo] * (1.0 - frac) + sorted[hi] * frac

# ---------------------------------------------------------------------------
# Pixel evidence
#
# count_non_background is the analogue of chrome_runner's png_has_4k_ihdr: a
# framebuffer that is one uniform colour is what a truncated render returns,
# and must never be admitted as a rendered page.
# ---------------------------------------------------------------------------

fn count_non_background(pixels: [u32]) -> i64:
    if pixels.len() == 0:
        return 0
    val background = pixels[0]
    var count: i64 = 0
    var i = 0
    while i < pixels.len():
        if pixels[i] != background:
            count = count + 1
        i = i + 1
    count

fn hex16(value: i64) -> text:
    val digits = "0123456789abcdef"
    var out = ""
    var shift = 60
    while shift >= 0:
        val nibble = ((value >> shift) & 15).to_i64()
        out = out + digits.substring(nibble, nibble + 1)
        shift = shift - 4
    out

# FNV-1a over the real framebuffer. This is a content digest of the pixels the
# renderer actually produced — never a per-fixture constant.
fn pixel_hash_of(pixels: [u32]) -> text:
    var hash: i64 = 0x1234567890abcdef
    var i = 0
    while i < pixels.len():
        hash = hash ^ pixels[i].to_i64()
        hash = hash * 1099511628211
        i = i + 1
    hex16(hash)

# ---------------------------------------------------------------------------
# Run one fixture — returns a fully populated SimpleFrameRecord
# ---------------------------------------------------------------------------

fn run_simple_fixture(base_dir: text, fixture: text) -> SimpleFrameRecord:
    var rec = make_simple_record(fixture)
    val html_path = base_dir + "/fixtures/" + fixture + ".html"

    if not file_exists(html_path):
        rec.error_msg = "fixture not found: " + html_path
        return rec

    val html = file_read(html_path)
    if html.len() == 0:
        rec.error_msg = "fixture is empty: " + html_path
        return rec

    # Warm-up frames are rendered and discarded, exactly as the measured ones
    # are rendered; nothing about them is recorded.
    var warm = 0
    while warm < WARMUP_FRAMES:
        val _discarded = simple_web_layout_render_html_software_result(
            html, VIEWPORT_WIDTH, VIEWPORT_HEIGHT)
        warm = warm + 1

    var frame_times: [f64] = []
    var last_pixels: [u32] = []
    var degraded = false
    var degrade_reason = ""
    var measured = 0
    while measured < MEASURE_FRAMES:
        val t0 = now_ms()
        val result = simple_web_layout_render_html_software_result(
            html, VIEWPORT_WIDTH, VIEWPORT_HEIGHT)
        val t1 = now_ms()
        frame_times.push(t1 - t0)
        last_pixels = result.pixels
        if result.render_degraded or not simple_web_layout_software_pixels_presentable(result):
            degraded = true
            degrade_reason = result.degrade_reason
        measured = measured + 1

    rec.warm_sample_count = frame_times.len().to_i64()
    rec.pixel_count = last_pixels.len().to_i64()
    rec.render_degraded = degraded
    rec.degrade_reason = degrade_reason

    val expected_pixels = (VIEWPORT_WIDTH as i64) * (VIEWPORT_HEIGHT as i64)

    # ---- fail-closed gate ---------------------------------------------------
    if degraded:
        val viewport_label = VIEWPORT_WIDTH.to_text() + "x" + VIEWPORT_HEIGHT.to_text()
        rec.error_msg = "render degraded (" + degrade_reason + ") at " + viewport_label + " - a budget-truncated framebuffer is not a rendered page"
        return rec
    if rec.pixel_count != expected_pixels:
        rec.error_msg = "render returned " + rec.pixel_count.to_text() + " pixels, expected " + expected_pixels.to_text()
        return rec
    val non_background = count_non_background(last_pixels)
    rec.nonbackground_pixels = non_background
    if non_background <= 0:
        rec.error_msg = "render returned a uniform framebuffer — no page content"
        return rec

    # ---- admitted -----------------------------------------------------------
    rec.frame_ms_p50 = percentile_f64(frame_times, 50.0)
    rec.frame_ms_p95 = percentile_f64(frame_times, 95.0)
    rec.total_frame_ms = rec.frame_ms_p50
    rec.pixel_hash = pixel_hash_of(last_pixels)
    rec.source = "measured"
    rec.error_msg = "real software render at " + VIEWPORT_WIDTH.to_text() + "x" + VIEWPORT_HEIGHT.to_text() + "; per-stage fields are 0 because the public renderer API exposes no per-stage timings (see file header)"
    rec

# ---------------------------------------------------------------------------
# Serialize a SimpleFrameRecord to JSON
# ---------------------------------------------------------------------------

fn simple_record_to_json(rec: SimpleFrameRecord) -> text:
    var out = "{"
    out = out + "\"source\":\"" + rec.source + "\","
    out = out + "\"fixture\":\"" + rec.fixture + "\","
    out = out + "\"runner\":\"simple-software-4k\","
    out = out + "\"viewport_width\":" + VIEWPORT_WIDTH.to_text() + ","
    out = out + "\"viewport_height\":" + VIEWPORT_HEIGHT.to_text() + ","
    out = out + "\"parse_ms\":" + rec.parse_ms.to_text() + ","
    out = out + "\"style_ms\":" + rec.style_ms.to_text() + ","
    out = out + "\"layout_ms\":" + rec.layout_ms.to_text() + ","
    out = out + "\"paint_ms\":" + rec.paint_ms.to_text() + ","
    out = out + "\"composite_ms\":" + rec.composite_ms.to_text() + ","
    out = out + "\"present_ms\":" + rec.present_ms.to_text() + ","
    out = out + "\"total_frame_ms\":" + rec.total_frame_ms.to_text() + ","
    out = out + "\"frame_ms_p50\":" + rec.frame_ms_p50.to_text() + ","
    out = out + "\"frame_ms_p95\":" + rec.frame_ms_p95.to_text() + ","
    out = out + "\"warm_sample_count\":" + rec.warm_sample_count.to_text() + ","
    out = out + "\"pixel_count\":" + rec.pixel_count.to_text() + ","
    out = out + "\"nonbackground_pixels\":" + rec.nonbackground_pixels.to_text() + ","
    out = out + "\"render_degraded\":" + rec.render_degraded.to_text() + ","
    out = out + "\"degrade_reason\":\"" + rec.degrade_reason + "\","
    out = out + "\"pixel_hash\":\"" + rec.pixel_hash + "\","
    out = out + "\"note\":\"" + rec.error_msg + "\"}"
    out

fn json_text_field_local(json: text, key: text) -> text:
    val search = "\"" + key + "\":"
    val idx = json.index_of(search)
    if idx < 0:
        return ""
    val after = json.substring(idx + search.len(), json.len())
    var ci = 0
    while ci < after.len():
        val c = after.char_at(ci)
        if c != " " and c != "\t" and c != "\n" and c != "\r":
            break
        ci = ci + 1
    if ci >= after.len():
        return ""
    if after.char_at(ci) != "\"":
        return ""
    ci = ci + 1
    var result = ""
    while ci < after.len():
        val c = after.char_at(ci)
        if c == "\"":
            break
        result = result + c
        ci = ci + 1
    result

# ---------------------------------------------------------------------------
# Run all fixtures and write artifacts
#
# The shared `perf.graphics_2d.bench_harness` summary writer is deliberately
# NOT used: that module does not parse on the current seed
# (test/perf/graphics_2d/bench_harness.spl:40 and its 05_perf twin start
# continuation lines with `+`, which this binary rejects with
# "expected expression, found Plus"), so importing it made this runner
# unloadable rather than merely unmeasured.
# ---------------------------------------------------------------------------

fn run_all(base_dir: text):
    val artifact_dir = base_dir + "/artifacts"
    val _created = dir_create_all(artifact_dir)
    var i = 0
    while i < FIXTURES.len():
        val fx = FIXTURES[i]
        val out_path = artifact_dir + "/simple_" + fx + ".json"

        if file_exists(out_path):
            val existing = file_read(out_path)
            if json_text_field_local(existing, "source") == "measured":
                print "[simple_runner] " + fx + ": using existing measured artifact"
                i = i + 1
                continue

        val rec = run_simple_fixture(base_dir, fx)
        val ok = file_write(out_path, simple_record_to_json(rec))
        if ok:
            val summary = rec.source + " p50=" + rec.frame_ms_p50.to_text() + "ms nonbg=" + rec.nonbackground_pixels.to_text()
            print "[simple_runner] " + fx + ": " + summary + " " + rec.error_msg
        else:
            print "[simple_runner] " + fx + ": ERROR writing " + out_path

        i = i + 1

fn main() -> i64:
    run_all("test/05_perf/web_render_chrome")
    0
