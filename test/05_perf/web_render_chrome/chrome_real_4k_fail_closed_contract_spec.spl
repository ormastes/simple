# Prevent synthetic Chrome comparison data from becoming a false PASS.
use std.io_runtime.{file_read}
use std.spec.step

val RUNNER = "test/05_perf/web_render_chrome/chrome_runner.spl"

describe "real Chrome 4K comparison contract":
    it "uses the bounded process facade and exact 4K viewport":
        step("inspect the Chrome execution and viewport contract")
        val source = file_read(RUNNER)
        expect(source).to_contain("process_run_bounded(bin")
        expect(source).to_contain("--window-size=3840,2160")
        expect(source).to_contain("CHROME_TIMEOUT_MS")

    it "admits measured status only after screenshot evidence":
        step("inspect fail-closed measurement admission")
        val source = file_read(RUNNER)
        expect(source).to_contain("if bytes <= 0 or digest.len() != 64 or not png_has_4k_ihdr(png_path)")
        expect(source).to_contain("width == VIEWPORT_WIDTH and height == VIEWPORT_HEIGHT")
        expect(source).to_contain("rec.source = \"measured\"")
        expect(source).to_contain("rec.status = \"MEASURED\"")
        expect(source).to_contain("\"gpu_backend_status\":\"unverified\"")
        expect(source).to_contain("\"comparison_admitted\":false")
        expect(source).to_contain("\"warm_sample_count\":0")

    it "keeps unavailable execution pending and covers every showcase tab":
        step("inspect pending provenance and tab coverage")
        val source = file_read(RUNNER)
        expect(source).to_contain("source: \"synthetic\", status: \"PENDING\"")
        expect(source).to_contain("\"overview\", \"html\", \"css-layout\", \"css-paint\"")
        expect(source).to_contain("\"forms-media\", \"animation\", \"evidence\"")

    it "uses the same inventory-expanded showcase source as Simple":
        step("inspect shared fixture construction")
        val source = file_read(RUNNER)
        expect(source).to_contain("web_renderable_feature_inventory()")
        expect(source).to_contain("web_renderable_feature_inventory_apply_to_showcase")
        expect(source).to_contain("file_read(showcase_path), inventory")
