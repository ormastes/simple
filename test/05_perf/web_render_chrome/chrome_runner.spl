# Real, fail-closed Chrome 4K reference capture.
use std.io_runtime.{cwd_process, dir_create_all, file_exists, file_hash_sha256_or_empty, file_read, file_read_bytes, file_size, file_write, process_run_bounded, remove_file_if_exists, time_now_unix_micros}
use std.gc_async_mut.gpu.browser_engine.web_renderable_feature_inventory.{web_renderable_feature_inventory, web_renderable_feature_inventory_apply_to_showcase}

val VIEWPORT_WIDTH = 3840
val VIEWPORT_HEIGHT = 2160
val CHROME_TIMEOUT_MS = 30000
val CHROME_OUTPUT_LIMIT = 65536
val FIXTURES = ["static_page", "scroll_heavy", "layout_stress", "paint_heavy"]
val SHOWCASE_TABS = ["overview", "html", "css-layout", "css-paint", "forms-media", "animation", "evidence"]

class ChromeTraceRecord:
    fixture: text
    tab: text
    source: text
    status: text
    first_frame_ms: f64
    screenshot_path: text
    screenshot_sha256: text
    screenshot_bytes: i64
    error_msg: text

fn make_chrome_record(fixture: text, tab: text) -> ChromeTraceRecord:
    ChromeTraceRecord(
        fixture: fixture, tab: tab, source: "synthetic", status: "PENDING",
        first_frame_ms: 0.0, screenshot_path: "", screenshot_sha256: "",
        screenshot_bytes: 0, error_msg: "measurement not attempted",
    )

fn chrome_binary() -> text:
    val candidates = [
        "/usr/bin/google-chrome", "/usr/bin/google-chrome-stable",
        "/usr/bin/chromium-browser", "/usr/bin/chromium",
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    ]
    var i = 0
    while i < candidates.len():
        if file_exists(candidates[i]):
            return candidates[i]
        i = i + 1
    ""

fn absolute_path(path: text) -> text:
    if path.starts_with("/"):
        return path
    cwd_process() + "/" + path

fn chrome_record_to_json(rec: ChromeTraceRecord) -> text:
    "{\"source\":\"" + rec.source + "\",\"status\":\"" + rec.status +
    "\",\"fixture\":\"" + rec.fixture + "\",\"tab\":\"" + rec.tab +
    "\",\"runner\":\"chrome-headless-4k\",\"viewport_width\":" + VIEWPORT_WIDTH.to_text() +
    ",\"viewport_height\":" + VIEWPORT_HEIGHT.to_text() +
    ",\"first_frame_ms\":" + rec.first_frame_ms.to_text() +
    ",\"frame_ms_p50\":0.0,\"frame_ms_p95\":0.0,\"warm_sample_count\":0" +
    ",\"screenshot_path\":\"" + rec.screenshot_path +
    "\",\"screenshot_sha256\":\"" + rec.screenshot_sha256 +
    "\",\"screenshot_bytes\":" + rec.screenshot_bytes.to_text() +
    ",\"fps\":0.0,\"dropped_frames\":0.0,\"gpu_raster_ms\":0.0,\"memory_mb\":0.0," +
    "\"gpu_backend_status\":\"unverified\",\"comparison_admitted\":false," +
    "\"note\":\"" + rec.error_msg + "\"}"

fn png_has_4k_ihdr(path: text) -> bool:
    val bytes = file_read_bytes(path)
    if bytes.len() < 24:
        return false
    val width = bytes[16].to_i64() * 16777216 + bytes[17].to_i64() * 65536 + bytes[18].to_i64() * 256 + bytes[19].to_i64()
    val height = bytes[20].to_i64() * 16777216 + bytes[21].to_i64() * 65536 + bytes[22].to_i64() * 256 + bytes[23].to_i64()
    width == VIEWPORT_WIDTH and height == VIEWPORT_HEIGHT

fn capture_chrome(bin: text, fixture: text, tab: text, html_path: text, png_path: text) -> ChromeTraceRecord:
    var rec = make_chrome_record(fixture, tab)
    rec.screenshot_path = png_path
    if bin == "":
        rec.error_msg = "Chrome executable unavailable"
        return rec
    if not file_exists(html_path):
        rec.error_msg = "HTML input unavailable"
        return rec
    val _removed = remove_file_if_exists(png_path)
    val start_us = time_now_unix_micros()
    val (_stdout, _stderr, exit_code) = process_run_bounded(bin, [
        "--headless=new", "--disable-dev-shm-usage", "--no-first-run",
        "--no-default-browser-check", "--hide-scrollbars",
        "--window-size=3840,2160", "--force-device-scale-factor=1",
        "--run-all-compositor-stages-before-draw", "--virtual-time-budget=1000",
        "--screenshot=" + absolute_path(png_path), "file://" + absolute_path(html_path),
    ], CHROME_TIMEOUT_MS, CHROME_OUTPUT_LIMIT)
    val elapsed_ms = (time_now_unix_micros() - start_us).to_f64() / 1000.0
    if exit_code != 0:
        rec.error_msg = "Chrome capture failed with exit " + exit_code.to_text()
        return rec
    val bytes = file_size(png_path)
    val digest = file_hash_sha256_or_empty(png_path)
    if bytes <= 0 or digest.len() != 64 or not png_has_4k_ihdr(png_path):
        rec.error_msg = "Chrome returned without complete 3840x2160 PNG evidence"
        return rec
    rec.source = "measured"
    rec.status = "MEASURED"
    rec.first_frame_ms = elapsed_ms
    rec.screenshot_bytes = bytes
    rec.screenshot_sha256 = digest
    rec.error_msg = "real Chrome process and 4K screenshot evidence; GPU backend and warm aggregates unverified"
    rec

fn write_capture(bin: text, artifact_dir: text, fixture: text, tab: text, html_path: text):
    val suffix = if tab == "": fixture else: fixture + "_tab_" + tab
    val png_path = artifact_dir + "/chrome_" + suffix + "_3840x2160.png"
    val rec = capture_chrome(bin, fixture, tab, html_path, png_path)
    val _written = file_write(artifact_dir + "/chrome_" + suffix + ".json", chrome_record_to_json(rec))
    print "[chrome_runner] " + suffix + ": " + rec.status + " " + rec.first_frame_ms.to_text() + "ms"

fn tab_html(source: text, tab: text) -> text:
    val injection = "<script>(function(){var t=document.getElementById('tab-" + tab + "');if(t)t.click();}());</script>"
    source.replace("</body>", injection + "</body>")

fn run_showcase_tabs(bin: text, artifact_dir: text):
    val showcase_path = "examples/06_io/ui/browser_common_elements_showcase.html"
    if not file_exists(showcase_path):
        var missing = make_chrome_record("showcase", "all")
        missing.error_msg = "canonical showcase unavailable"
        val _written = file_write(artifact_dir + "/chrome_showcase.json", chrome_record_to_json(missing))
        return
    val inventory = web_renderable_feature_inventory()
    # Keep Chrome and Simple source-equivalent: both fill the same named panel
    # slots from the same typed inventory before selecting a tab.
    val source = web_renderable_feature_inventory_apply_to_showcase(
        file_read(showcase_path), inventory)
    var i = 0
    while i < SHOWCASE_TABS.len():
        val tab = SHOWCASE_TABS[i]
        val tab_path = artifact_dir + "/chrome_showcase_input_" + tab + ".html"
        val _written = file_write(tab_path, tab_html(source, tab))
        write_capture(bin, artifact_dir, "showcase", tab, tab_path)
        i = i + 1

fn run_all(base_dir: text):
    val artifact_dir = base_dir + "/artifacts"
    val _created = dir_create_all(artifact_dir)
    val bin = chrome_binary()
    var i = 0
    while i < FIXTURES.len():
        val fixture = FIXTURES[i]
        write_capture(bin, artifact_dir, fixture, "", base_dir + "/fixtures/" + fixture + ".html")
        i = i + 1
    run_showcase_tabs(bin, artifact_dir)

fn main() -> i64:
    run_all("test/05_perf/web_render_chrome")
    0
