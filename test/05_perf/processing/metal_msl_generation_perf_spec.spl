# Host-independent NFR gate for the Metal MSL ProcessingIR generator (TODO 652).
# Budgets (doc/06_spec/03_system/app/simple_2d/feature/processing_metal_msl_backend_spec.md):
# 512 deterministic generations, average latency below 10 ms, procfs VmHWM
# incremental peak RSS below 8 MiB, semantic-key invalidation for changed
# ProcessingIR values/counts. Seed-runner measurements are diagnostic only.

use std.spec.{describe, it, expect}
use std.common.processing.processing_ir.{processing_ir_fill_u32, processing_ir_fill_rect_u32}
use std.common.processing.backend_contract.{ProcessingBackendTarget}
use std.gc_async_mut.processing.backend_pipeline.{compile_processing_backend_artifact}
use std.gc_async_mut.io.time_ops.{time_now_micros}
use std.gc_async_mut.file_system.file_ops.{file_exists}
use std.nogc_sync_mut.io.sysinfo_ops.{process_peak_rss_kb}

val GENERATION_COUNT: i64 = 512
val AVG_LATENCY_BUDGET_US: i64 = 10_000
val RSS_DELTA_BUDGET_KIB: i64 = 8192

struct MetalMslGenerationPerf:
    generations: i64
    total_us: i64
    average_us: i64
    all_valid: bool
    fill_u32_deterministic: bool
    fill_rect_deterministic: bool
    rss_measurable: bool
    rss_delta_kib: i64

fn measure_generations(count: i64) -> MetalMslGenerationPerf:
    val fill_u32 = processing_ir_fill_u32(64, 0xA1B2C3D4u32)
    val fill_rect = processing_ir_fill_rect_u32(8, 8, 8, 2, 2, 4, 3, 0xFF3366CCu32)
    val fill_u32_reference = compile_processing_backend_artifact(fill_u32, ProcessingBackendTarget.MetalMsl)
    val fill_rect_reference = compile_processing_backend_artifact(fill_rect, ProcessingBackendTarget.MetalMsl)
    val fill_u32_source = fill_u32_reference.source
    val fill_u32_key = fill_u32_reference.semantic_key
    val fill_rect_source = fill_rect_reference.source
    val fill_rect_key = fill_rect_reference.semantic_key
    var all_valid = fill_u32_reference.valid and fill_rect_reference.valid
    var fill_u32_deterministic = true
    var fill_rect_deterministic = true
    # procfs VmHWM is the budgeted metric; it exists only on hosts with /proc.
    val procfs_available = file_exists("/proc/self/status")
    val hwm_before = if procfs_available: process_peak_rss_kb() else: -1
    val start_us = time_now_micros()
    var index: i64 = 0
    while index < count:
        if index % 2 == 0:
            val artifact = compile_processing_backend_artifact(fill_u32, ProcessingBackendTarget.MetalMsl)
            if not artifact.valid:
                all_valid = false
            if artifact.source != fill_u32_source or artifact.semantic_key != fill_u32_key:
                fill_u32_deterministic = false
        else:
            val artifact = compile_processing_backend_artifact(fill_rect, ProcessingBackendTarget.MetalMsl)
            if not artifact.valid:
                all_valid = false
            if artifact.source != fill_rect_source or artifact.semantic_key != fill_rect_key:
                fill_rect_deterministic = false
        index = index + 1
    val end_us = time_now_micros()
    val hwm_after = if procfs_available: process_peak_rss_kb() else: -1
    val total = end_us - start_us
    val rss_measurable = hwm_before >= 0 and hwm_after >= 0
    MetalMslGenerationPerf(
        generations: count,
        total_us: total,
        average_us: total / count,
        all_valid: all_valid,
        fill_u32_deterministic: fill_u32_deterministic,
        fill_rect_deterministic: fill_rect_deterministic,
        rss_measurable: rss_measurable,
        rss_delta_kib: if rss_measurable: hwm_after - hwm_before else: -1)

describe "Metal MSL generation host-independent performance":
    it "generates 512 deterministic artifacts under the latency and memory budgets":
        val perf = measure_generations(GENERATION_COUNT)
        expect(perf.generations).to_equal(GENERATION_COUNT)
        expect(perf.all_valid).to_equal(true)
        expect(perf.fill_u32_deterministic).to_equal(true)
        expect(perf.fill_rect_deterministic).to_equal(true)
        expect(perf.total_us).to_be_greater_than(0)
        expect(perf.average_us).to_be_greater_than(0)
        expect(perf.average_us).to_be_less_than(AVG_LATENCY_BUDGET_US)
        if perf.rss_measurable:
            expect(perf.rss_delta_kib).to_be_greater_than(-1)
            expect(perf.rss_delta_kib).to_be_less_than(RSS_DELTA_BUDGET_KIB)
        val procfs_available = file_exists("/proc/self/status")
        print(
            "PROCESSING_METAL_MSL_GEN_PERF generations={perf.generations} " +
            "total_us={perf.total_us} average_us={perf.average_us} " +
            "procfs_available={procfs_available} " +
            "rss_measurable={perf.rss_measurable} rss_delta_kib={perf.rss_delta_kib} " +
            "all_valid={perf.all_valid} fill_u32_deterministic={perf.fill_u32_deterministic} " +
            "fill_rect_deterministic={perf.fill_rect_deterministic}")

    it "invalidates the semantic key when ProcessingIR value or count changes":
        val base = processing_ir_fill_u32(64, 0xA1B2C3D4u32)
        val base_artifact = compile_processing_backend_artifact(base, ProcessingBackendTarget.MetalMsl)
        val regenerated = compile_processing_backend_artifact(base, ProcessingBackendTarget.MetalMsl)
        val changed_value = processing_ir_fill_u32(64, 0xA1B2C3D5u32)
        val changed_value_artifact = compile_processing_backend_artifact(changed_value, ProcessingBackendTarget.MetalMsl)
        val changed_count = processing_ir_fill_u32(128, 0xA1B2C3D4u32)
        val changed_count_artifact = compile_processing_backend_artifact(changed_count, ProcessingBackendTarget.MetalMsl)
        expect(base_artifact.valid).to_equal(true)
        expect(regenerated.semantic_key).to_equal(base_artifact.semantic_key)
        expect(regenerated.source).to_equal(base_artifact.source)
        expect(changed_value_artifact.valid).to_equal(true)
        expect(changed_count_artifact.valid).to_equal(true)
        expect(changed_value_artifact.semantic_key == base_artifact.semantic_key).to_equal(false)
        expect(changed_count_artifact.semantic_key == base_artifact.semantic_key).to_equal(false)
        print(
            "PROCESSING_METAL_MSL_KEY_INVALIDATION base_key={base_artifact.semantic_key} " +
            "value_change_invalidates=true count_change_invalidates=true")
