#!/bin/sh
set -eu

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
fixture="$root_dir/test/05_perf/mcdc_rt_hal/mcdc_decision_fixture.spl"
harness="$root_dir/test/05_perf/mcdc_rt_hal/run_perf_evidence.shs"

grep -Fq 'activation_kind = "static-weave"' "$fixture"
grep -Fq 'activation_kind = "explicit-typed-call"' "$fixture"
grep -Fq 'activation_kind = "builtin-dynamic"' "$fixture"
grep -Fq 'actual_dynload=false fallback=false' "$fixture"
grep -Fq '[ "$activation_kind" = builtin-dynamic ]' "$harness"
grep -Fq 'EXPECTED_MCDC_CHECKSUM=18819052895214' "$harness"
grep -Fq 'EXPECTED_MCDC_WARM_CHECKSUM=47047806664' "$harness"
grep -Fq 'schema=mcdc-rt-hal-perf-v2' "$harness"
grep -Fq 'raw_samples_sha256=' "$harness"
grep -Fq 'evidence_csv_sha256=' "$harness"
grep -Fq 'elapsed_ns_p95,stdout_sha256_set' "$harness"
for receipt in \
    'status=ineligible' \
    'explicit_typed_hook_lane=false' \
    'explicit_probe_candidate=true' \
    'explicit_probe_equivalent_to_static_weave=false' \
    'executable_mapping_receipt=false' \
    'minimum_claim_runs=15' \
    'reason=no-executable-aspect-pack-mapping-receipt'; do
    grep -Fq "$receipt" "$harness" || { echo "FAIL: missing K3 eligibility fact: $receipt" >&2; exit 1; }
done

echo 'PASS: MC/DC static evidence is retained while builtin activation cannot claim K3 dynload'
