#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
HARNESS="$ROOT/scripts/check/profile-cross-language-compile.shs"

fail() { echo "FAIL: $*" >&2; exit 1; }
need() { grep -Fq "$1" "$HARNESS" || fail "missing contract: $1"; }

sh -n "$HARNESS"
help=$(sh "$HARNESS" --help)
printf '%s\n' "$help" | grep -Fq 'process_floor, parse_check, object_or_smf, and native_executable' || fail help-stages
printf '%s\n' "$help" | grep -Fq 'explicit unavailable rows, never zeroes' || fail help-fail-closed

need '. "$ROOT/scripts/lib/storage-roots.shs"'
need 'storage_roots_mktemp cross-language-compile'
need '$SIMPLE_WORKTREE_STORAGE_ROOT/evidence/perf/cross-language-compile/$RUN_ID'
need "LANGUAGES='simple c rust go python'"
need "STAGES='process_floor parse_check object_or_smf native_executable'"
need 'for language in $LANGUAGES'
need 'sample language=%s stage=%s round=%s elapsed_us=%s max_rss_kib=%s'
need 'validate_artifact "$language" "$stage" "$sample"'
need '[ -s "$artifact.smf" ] && "$SIMPLE_CANDIDATE" "$artifact.smf"'
need '[ -x "$artifact" ] && "$artifact"'
need 'rustc may emit a valid zero-byte metadata file for a binary crate'
need 'COMMANDS="$EVIDENCE/commands.tsv"'
need 'verified-stage3-or-stage4-provenance-required'
need 'rust-bootstrap-seed-rejected'
need 'provenance-verification-failed'
need 'incomplete-sample-set'
need 'language-has-no-native-stage'
need 'unique output paths; no cache deletion between samples'
need 'Unavailable and failed rows are never ratios or zero-valued performance evidence.'

echo 'cross_language_compile_matrix_contract=true'
echo 'stages=4 languages=5 fail_closed=true interleaved=true centralized_roots=true'
