#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)"
cd "$ROOT_DIR"
HARNESS=scripts/check/check-cross-language-perf.shs

grep -Fq 'SIMPLE_COMPILER_PROVENANCE must name the admitted Stage 3 manifest or adjacent Stage 4 provenance receipt' "$HARNESS"
grep -Fq 'bootstrap_stage3_verify_manifest "$SIMPLE_COMPILER_PROVENANCE" "$ROOT_DIR" "$SIMPLE_COMPILER_REAL"' "$HARNESS"
grep -Fq 'stage4_verify_candidate_provenance "$SIMPLE_COMPILER_PROVENANCE" "$SIMPLE_COMPILER_REAL" "$ROOT_DIR"' "$HARNESS"
grep -Fq '[ "$SIMPLE_COMPILER_PROVENANCE" = "${SIMPLE_COMPILER_REAL}.provenance.env" ]' "$HARNESS"
grep -Fq 'SIMPLE_COMPILER_ADMISSION=admitted-stage3' "$HARNESS"
grep -Fq 'SIMPLE_COMPILER_ADMISSION=admitted-stage4' "$HARNESS"

fake_dir=$(mktemp -d)
trap 'rm -rf "$fake_dir"' EXIT HUP INT TERM
fake="$fake_dir/simple"
printf '%s\n' '#!/bin/sh' 'echo "Simple 0.0.0 self-hosted"' >"$fake"
chmod +x "$fake"
set +e
output=$(SIMPLE_BINARY="$fake" sh "$HARNESS" 2>&1)
status=$?
set -e
[ "$status" -eq 2 ]
printf '%s\n' "$output" | grep -Fq 'SIMPLE_COMPILER_PROVENANCE must name the admitted Stage 3 manifest or adjacent Stage 4 provenance receipt'

echo 'cross_language_compiler_provenance_contract=true'
echo 'false_banner_only_admission_rejected=true'
