#!/bin/sh
set -eu
ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)"
cd "$ROOT_DIR"
HARNESS=scripts/check/check-cross-language-perf.shs
FIXTURE=test/05_perf/bytes_push_1mib.spl
for bytes in 1048576 4194304 33554432; do
    grep -Fq "retained_byte_measure \"" "$HARNESS"
    grep -Fq "$bytes" "$HARNESS"
    grep -Fq "$bytes" "$FIXTURE"
done
grep -Fq "zero_fill_checksum=0" "$HARNESS"
grep -Fq "total process RSS" "$HARNESS"
grep -Fq 'exit 1' "$HARNESS"
grep -Fq 'PERF_BYTE_SIZE' "$FIXTURE"
echo 'cross_language_byte_retained_contract=true'
echo 'byte_sizes=1048576,4194304,33554432'
echo 'receipt=exact_length,zero_fill_checksum,raw_samples,p50,p95,total_rss'
