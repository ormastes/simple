#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)"
HARNESS="$ROOT_DIR/scripts/check/check-cross-language-perf.shs"
DIAGNOSTIC_PRODUCER="$ROOT_DIR/build/perf/startup_compute_loader_20260820/run_diagnostic_matrix.shs"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT HUP INT TERM
unset GOMAXPROCS CPU_WORKERS OS_THREAD_WORKERS MULTICORE_GREEN_WORKERS
unset FANOUT_WORKERS FANOUT_OS_THREAD_WORKERS FANOUT_MULTICORE_GREEN_WORKERS

sed -n '/^avg_ms() {$/,/^}$/p' "$HARNESS" >"$TMP_DIR/avg_ms.shs"
grep -Fq '[ "$ok" -ne "$_runs" ]' "$TMP_DIR/avg_ms.shs"
grep -Fq 'run_bounded_argv "$@"' "$TMP_DIR/avg_ms.shs"
! grep -Fq 'sh -c "$_cmd"' "$HARNESS"
grep -Fq 'run_bounded_build_argv()' "$HARNESS"
grep -Fq 'timeout "$BUILD_TIMEOUT" "$@"' "$HARNESS"
grep -Fq "run_bounded_checksum_argv 'fib(35) = 9227465'" "$HARNESS"
grep -Fq 'real_peer_toolchain()' "$HARNESS"
grep -Fq '### Retained Workload Source Identities' "$HARNESS"
grep -Fq '**Evidence classification:** diagnostic-only-not-release;' "$HARNESS"
grep -Fq 'thread_spawn_with_args(task, 0, \seed, unused: worker(seed))' "$HARNESS"
grep -Fq 'multicore_green_spawn(\: worker(task))' "$HARNESS"
grep -Fq 'multicore_green_spawn(\: work(task))' "$HARNESS"
grep -Fq 'var x = task' "$HARNESS"
grep -Fq 'if total != ${PARALLEL_EXPECTED_CHECKSUM}' "$HARNESS"
grep -Fq 'if total != ${FANOUT_EXPECTED_CHECKSUM}' "$HARNESS"
! grep -Fq '1103515245' "$HARNESS"

# Retained Simple interpreter, SMF-loader, and native lanes must use the same
# supported monotonic owner.  A raw runtime extern would be native-only again.
sed -n '/^write_simple_fib_warm() {$/,/^}$/p' "$HARNESS" \
    >"$TMP_DIR/simple-fib-warm.shs"
grep -Fq 'use std.io_runtime.{time_now_monotonic_ms}' \
    "$TMP_DIR/simple-fib-warm.shs"
grep -Fq 'val start_ms = time_now_monotonic_ms()' \
    "$TMP_DIR/simple-fib-warm.shs"
grep -Fq 'val elapsed_ms = time_now_monotonic_ms() - start_ms' \
    "$TMP_DIR/simple-fib-warm.shs"
! grep -Fq 'extern fn rt_time_' "$TMP_DIR/simple-fib-warm.shs"

# Only exact-admission lanes belong to the retained claim set.  The sampler
# rotates the first lane once per round and records the realized order.
claim_lanes="$(sed -n "s/^RETAINED_CLAIM_LANES='\(.*\)'$/\1/p" "$HARNESS")"
[ "$claim_lanes" = 'simple_interpreter simple_smf_loader simple_native c rust go python bun' ]
! printf '%s\n' "$claim_lanes" | grep -Eq '(^| )(java|erlang)( |$)'
grep -Fq 'RETAINED_SCHEDULE="$BUILD_DIR/retained_cyclic_schedule.tsv"' "$HARNESS"
grep -Fq '_offset=$(( (_round - 1) % _ready_count ))' "$HARNESS"
grep -Fq '_position=$(( (_offset + _index) % _ready_count + 1 ))' "$HARNESS"
grep -Fq 'retained_sample_lane "$_lane" "$_round" "$((_index + 1))"' "$HARNESS"
grep -Fq 'Java and Erlang remain' "$HARNESS"
! grep -Fq 'retained_measure "simple_native"' "$HARNESS"
! grep -Fq 'retained_simple_mode_measure "simple_interpreter"' "$HARNESS"
grep -F "error=missing retained interpreter fixture" "$HARNESS" \
    | grep -Fq 'return 2;'
grep -F "error=missing retained SMF source fixture" "$HARNESS" \
    | grep -Fq 'return 2;'

# Small oracle for the bound rotation formula: every lane appears exactly once
# per round, while the starting lane advances cyclically.
oracle_lanes='a b c'
oracle_count=3
oracle_result=''
oracle_round=1
while [ "$oracle_round" -le 3 ]; do
    oracle_offset=$(( (oracle_round - 1) % oracle_count ))
    oracle_index=0
    while [ "$oracle_index" -lt "$oracle_count" ]; do
        oracle_position=$(( (oracle_offset + oracle_index) % oracle_count + 1 ))
        oracle_lane="$(printf '%s\n' $oracle_lanes | sed -n "${oracle_position}p")"
        oracle_result="${oracle_result}${oracle_result:+ }${oracle_round}:${oracle_lane}"
        oracle_index=$((oracle_index + 1))
    done
    oracle_round=$((oracle_round + 1))
done
[ "$oracle_result" = '1:a 1:b 1:c 2:b 2:c 2:a 3:c 3:a 3:b' ]

cat >"$TMP_DIR/partial.shs" <<'EOF'
set -eu
calls=0
run_bounded_argv() {
    calls=$((calls + 1))
    [ "$calls" -ne 2 ]
}
EOF
cat "$TMP_DIR/avg_ms.shs" >>"$TMP_DIR/partial.shs"
cat >>"$TMP_DIR/partial.shs" <<'EOF'
[ "$(avg_ms 3 ignored)" = fail ]
EOF
sh "$TMP_DIR/partial.shs"

cat >"$TMP_DIR/complete.shs" <<'EOF'
set -eu
run_bounded_argv() { return 0; }
EOF
cat "$TMP_DIR/avg_ms.shs" >>"$TMP_DIR/complete.shs"
cat >>"$TMP_DIR/complete.shs" <<'EOF'
result="$(avg_ms 3 ignored)"
printf '%s\n' "$result" | grep -Eq '^[0-9]+[.][0-9]{3}$'
EOF
sh "$TMP_DIR/complete.shs"

# Exercise the real harness wrapper, not a copied helper. A path and argument
# containing spaces must arrive as two exact argv entries.
SPACED_DIR="$TMP_DIR/path with spaces"
mkdir -p "$SPACED_DIR"
SPACED_TOOL="$SPACED_DIR/argv tool.shs"
cat >"$SPACED_TOOL" <<'EOF'
#!/bin/sh
[ "$#" -eq 1 ]
[ "$1" = "argument with spaces" ]
printf '%s\n' argv-preserved
EOF
chmod +x "$SPACED_TOOL"
wrapper_output="$(RUN_TIMEOUT=2 BUILD_TIMEOUT=3 /bin/sh "$HARNESS" \
    --argv-wrapper-selftest "$SPACED_TOOL" "argument with spaces")"
[ "$wrapper_output" = argv-preserved ]

# A real bounded argv call must preserve timeout's status 124.
SLEEPER="$SPACED_DIR/sleep tool.shs"
cat >"$SLEEPER" <<'EOF'
#!/bin/sh
/bin/sleep 2
EOF
chmod +x "$SLEEPER"
set +e
RUN_TIMEOUT=1 BUILD_TIMEOUT=3 /bin/sh "$HARNESS" \
    --argv-wrapper-selftest "$SLEEPER"
timeout_status=$?
set -e
[ "$timeout_status" -eq 124 ]

# The report claims bounded durations, so a missing timeout binary must stop
# the actual wrapper before compiler admission or workload execution.
EMPTY_PATH="$TMP_DIR/no-timeout"
mkdir -p "$EMPTY_PATH"
ln -s "$(command -v dirname)" "$EMPTY_PATH/dirname"
set +e
PATH="$EMPTY_PATH" /bin/sh "$HARNESS" --argv-wrapper-selftest /bin/true \
    >"$TMP_DIR/missing-timeout.out" 2>"$TMP_DIR/missing-timeout.err"
missing_timeout_status=$?
set -e
[ "$missing_timeout_status" -eq 2 ]
grep -Fq 'ERROR: timeout is required for claim-bearing benchmark rows' \
    "$TMP_DIR/missing-timeout.err"

expect_invalid() {
    _name="$1"
    _value="$2"
    _expected="$3"
    set +e
    env "$_name=$_value" /bin/sh "$HARNESS" --argv-wrapper-selftest /bin/true \
        >"$TMP_DIR/invalid-${_name}.out" 2>"$TMP_DIR/invalid-${_name}.err"
    _status=$?
    set -e
    [ "$_status" -eq 2 ]
    grep -Fq "$_expected" "$TMP_DIR/invalid-${_name}.err"
}

expect_invalid RUN_TIMEOUT 0 'error=RUN_TIMEOUT must be a strictly positive integer: 0'
expect_invalid RUN_TIMEOUT abc 'error=RUN_TIMEOUT must be a strictly positive integer: abc'
expect_invalid RUN_TIMEOUT 1fortnight 'error=RUN_TIMEOUT must be a strictly positive integer: 1fortnight'
expect_invalid BUILD_TIMEOUT 0 'error=BUILD_TIMEOUT must be a strictly positive integer: 0'
expect_invalid BUILD_TIMEOUT abc 'error=BUILD_TIMEOUT must be a strictly positive integer: abc'
expect_invalid BUILD_TIMEOUT 1fortnight 'error=BUILD_TIMEOUT must be a strictly positive integer: 1fortnight'
expect_invalid CPU_WORKERS 0 'error=CPU_WORKERS must be a strictly positive integer: 0'
expect_invalid CPU_WORKERS abc 'error=CPU_WORKERS must be a strictly positive integer: abc'
expect_invalid RUNS 0 'error=RUNS must be a strictly positive integer: 0'
expect_invalid RUNS abc 'error=RUNS must be a strictly positive integer: abc'
expect_invalid FIB_N 0 'error=FIB_N must be a strictly positive integer: 0'
expect_invalid FIB_N abc 'error=FIB_N must be a strictly positive integer: abc'
expect_invalid FIB_N 34 'error=FIB_N=34 is unsupported; checksum contract requires FIB_N=35'

set +e
CPU_WORKERS=2 GOMAXPROCS=3 /bin/sh "$HARNESS" \
    --argv-wrapper-selftest /bin/true \
    >"$TMP_DIR/worker-parity.out" 2>"$TMP_DIR/worker-parity.err"
worker_parity_status=$?
set -e
[ "$worker_parity_status" -eq 2 ]
grep -Fq 'error=CPU worker parity requires CPU_WORKERS=GOMAXPROCS=OS_THREAD_WORKERS=MULTICORE_GREEN_WORKERS' \
    "$TMP_DIR/worker-parity.err"

expect_retained_status() {
    _expected_status="$1"
    _case_name="$2"
    shift 2
    set +e
    RUN_TIMEOUT=1 BUILD_TIMEOUT=3 /bin/sh "$HARNESS" \
        --retained-contract-selftest "$@" \
        >"$TMP_DIR/retained-${_case_name}.out" 2>"$TMP_DIR/retained-${_case_name}.err"
    _status=$?
    set -e
    [ "$_status" -eq "$_expected_status" ]
}

# Parsed measurements must be strictly positive rather than merely numeric.
RUN_TIMEOUT=1 BUILD_TIMEOUT=3 /bin/sh "$HARNESS" \
    --retained-contract-selftest warm 0.001
RUN_TIMEOUT=1 BUILD_TIMEOUT=3 /bin/sh "$HARNESS" \
    --retained-contract-selftest rss 1
expect_retained_status 2 warm-zero warm 0
expect_retained_status 2 warm-zero-decimal warm 0.000
expect_retained_status 2 warm-nonnumeric warm unavailable
expect_retained_status 2 rss-zero rss 0
expect_retained_status 2 rss-nonnumeric rss 1.5

# Exact compiled-artifact checksum execution remains argv-safe and bounded;
# timeout's 124 and checksum mismatch's 97 are not collapsed into status 1.
RUN_TIMEOUT=1 BUILD_TIMEOUT=3 /bin/sh "$HARNESS" \
    --retained-contract-selftest checksum argv-preserved \
    "$SPACED_TOOL" "argument with spaces"
expect_retained_status 124 checksum-timeout checksum ignored "$SLEEPER"
expect_retained_status 97 checksum-mismatch checksum expected /bin/printf '%s\n' actual

CPU_WORKERS=2 GOMAXPROCS=2 OS_THREAD_WORKERS=2 MULTICORE_GREEN_WORKERS=2 \
    RUN_TIMEOUT=1 BUILD_TIMEOUT=3 /bin/sh "$HARNESS" \
    --retained-contract-selftest gomaxprocs 'GOMAXPROCS=2 NumCPU=8'
set +e
CPU_WORKERS=2 GOMAXPROCS=2 OS_THREAD_WORKERS=2 MULTICORE_GREEN_WORKERS=2 \
    RUN_TIMEOUT=1 BUILD_TIMEOUT=3 /bin/sh "$HARNESS" \
    --retained-contract-selftest gomaxprocs 'GOMAXPROCS=1 NumCPU=8' \
    >"$TMP_DIR/gomax-mismatch.out" 2>"$TMP_DIR/gomax-mismatch.err"
gomax_mismatch_status=$?
set -e
[ "$gomax_mismatch_status" -eq 2 ]
grep -Fq 'error=actual GOMAXPROCS=1 does not match CPU_WORKERS=2' \
    "$TMP_DIR/gomax-mismatch.err"

# Diagnostic producer metadata must remain explicitly non-release and bind
# every peer source plus the real Go/Rust compiler behind driver shims.
grep -Fq 'diagnostic-only-not-release' "$DIAGNOSTIC_PRODUCER"
grep -Fq 'record_identity source go_compute' "$DIAGNOSTIC_PRODUCER"
grep -Fq 'record_identity source rust_compute' "$DIAGNOSTIC_PRODUCER"
grep -Fq 'record_identity source python_compute' "$DIAGNOSTIC_PRODUCER"
grep -Fq 'record_identity source bun_compute' "$DIAGNOSTIC_PRODUCER"
grep -Fq 'record_identity source java_compute' "$DIAGNOSTIC_PRODUCER"
grep -Fq 'record_identity toolchain go_compile' "$DIAGNOSTIC_PRODUCER"
grep -Fq 'record_identity toolchain rustc' "$DIAGNOSTIC_PRODUCER"
grep -Fq 'if [ "$rc" -eq 0 ]; then' "$DIAGNOSTIC_PRODUCER"

set +e
SAMPLES=0 /bin/sh "$DIAGNOSTIC_PRODUCER" \
    >"$TMP_DIR/producer-invalid.out" 2>"$TMP_DIR/producer-invalid.err"
producer_invalid_status=$?
set -e
[ "$producer_invalid_status" -eq 2 ]
grep -Fq 'invalid_positive_integer=SAMPLES:0' "$TMP_DIR/producer-invalid.err"

echo 'cross_language_average_contract=true'
echo 'partial_sample_sets=fail_closed'
echo 'argv_paths=preserved'
echo 'timeout_enforcement=fail_closed'
echo 'timeout_status_124=preserved'
echo 'numeric_inputs=fail_closed'
echo 'cpu_worker_parity=fail_closed'
echo 'task_index_checksum_semantics=matched'
echo 'positive_warm_rss=fail_closed'
echo 'compiled_checksum_timeout=bounded'
echo 'actual_gomaxprocs=asserted'
echo 'diagnostic_provenance=contracted'
echo 'mode_equivalent_monotonic_clock=true'
echo 'retained_cyclic_interleave=true'
echo 'java_erlang_claim_excluded=true'
