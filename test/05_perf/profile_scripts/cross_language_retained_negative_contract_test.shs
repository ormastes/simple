#!/bin/sh
set -eu

# Executable negative coverage for retained report admission. This test only
# invokes the report contract and extracted pure shell helpers; it never runs
# the benchmark harness or a Simple binary.
ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)"
cd "$ROOT_DIR"
HARNESS="scripts/check/check-cross-language-perf.shs"
REPORT_CONTRACT="test/05_perf/profile_scripts/profile_report_contract_test.shs"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"; rm -f doc/09_report/.retained_negative_link.md' EXIT HUP INT TERM

fail() {
    echo "cross_language_retained_negative_contract=false"
    echo "error=$1"
    exit 1
}

outside_report="doc/01_research/local/perf_profile_reporting.md"
validate_line=$(grep -n '^validate_report_path$' "$HARNESS" | head -1 | cut -d: -f1)
mkdir_line=$(grep -n 'mkdir -p "\$BUILD_DIR"' "$HARNESS" | head -1 | cut -d: -f1)
[ -n "$validate_line" ] && [ -n "$mkdir_line" ] && [ "$validate_line" -lt "$mkdir_line" ] ||
    fail "producer report-path validation is not before mkdir/write"
grep -Fq 'validate_report_path' "$HARNESS" || fail "producer report-path guard missing"
grep -Fq 'PROFILE_DOCKER_REPORT_PATH="${REPORT_PATH#"$ROOT_DIR"/}"' "$HARNESS" ||
    fail "Docker report path was not translated to workspace-relative form"

set +e
traversal_output=$(sh "$REPORT_CONTRACT" cross_language "$HARNESS" \
    "doc/09_report/../01_research/local/perf_profile_reporting.md" 2>&1)
traversal_status=$?
set -e
[ "$traversal_status" -ne 0 ] || fail "traversal report path unexpectedly passed"
printf '%s\n' "$traversal_output" | grep -Fq 'resolve to a Markdown file under doc/09_report' ||
    fail "traversal rejection reason missing"

ln -s "../../$outside_report" doc/09_report/.retained_negative_link.md
set +e
symlink_output=$(sh "$REPORT_CONTRACT" cross_language "$HARNESS" \
    doc/09_report/.retained_negative_link.md 2>&1)
symlink_status=$?
set -e
[ "$symlink_status" -ne 0 ] || fail "outside symlink report path unexpectedly passed"
printf '%s\n' "$symlink_output" | grep -Fq 'resolve to a Markdown file under doc/09_report' ||
    fail "symlink rejection reason missing"
rm -f doc/09_report/.retained_negative_link.md

extract_function() {
    _name="$1"
    awk -v name="$_name" '
        $0 ~ ("^" name "\\(\\) \\{") { active=1; depth=0 }
        active {
            print
            line=$0
            depth += gsub(/\{/, "&", line)
            depth -= gsub(/\}/, "&", line)
            if (depth == 0) exit
        }
    ' "$HARNESS"
}

eval "$(extract_function md_cell)"
escaped=$(md_cell "$(printf 'left|right\nnext')")
[ "$escaped" = 'left\|right next' ] || fail "Markdown cell escaping failed"

eval "$(extract_function validate_samples_file)"
printf '1.0\nnot-a-number\n' >"$TMP_DIR/malformed.samples"
set +e
validate_samples_file "$TMP_DIR/malformed.samples" 2 >/dev/null 2>&1
sample_status=$?
set -e
[ "$sample_status" -ne 0 ] || fail "malformed sample line unexpectedly passed"

eval "$(extract_function retained_unavailable_row)"
eval "$(extract_function retained_simple_mode_measure)"
have() { command -v "$1" >/dev/null 2>&1; }
REPORT_PATH="$TMP_DIR/report.md"
BUILD_DIR="$TMP_DIR/build"
RUNS=1
RUN_TIMEOUT=1
WARM_IN_PROCESS=1
SIMPLE_COMPILER_REAL="$TMP_DIR/compiler"
SIMPLE_COMPILER_VERSION="test compiler"
SIMPLE_COMPILER_ADMISSION="admitted-stage3"
RETAINED_MODE_FAILURE=0
mkdir -p "$BUILD_DIR"
fake="$TMP_DIR/failing-mode"
printf '%s\n' '#!/bin/sh' 'exit 17' >"$fake"
chmod +x "$fake"
set +e
retained_simple_mode_measure simple_interpreter interpreter interpreter \
    "$TMP_DIR/fib_warm.spl" "$fake"
mode_status=$?
set -e
[ "$mode_status" -eq 0 ] || fail "mode failure did not retain a rejected row"
[ "$RETAINED_MODE_FAILURE" -eq 1 ] || fail "mode failure did not set aggregate failure"
grep -Fq '| simple_interpreter | unavailable |' "$REPORT_PATH" ||
    fail "mode failure row missing"
grep -Fq '| recursive-fib-35 |' "$REPORT_PATH" ||
    fail "unavailable workload schema is wrong"
grep -Fq '| rejected |' "$REPORT_PATH" || fail "mode failure row is not rejected"

echo 'cross_language_retained_negative_contract=true'
echo 'traversal_rejected=true'
echo 'symlink_rejected=true'
echo 'markdown_escape=true'
echo 'malformed_samples_rejected=true'
echo 'mode_failure_rowed_and_aggregated=true'
