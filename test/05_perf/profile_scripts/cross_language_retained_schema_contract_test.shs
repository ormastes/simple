#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)"
cd "$ROOT_DIR"

HARNESS="scripts/check/check-cross-language-perf.shs"
FIXTURE="$(mktemp)"
trap 'rm -f "$FIXTURE"' EXIT HUP INT TERM

cat >"$FIXTURE" <<'EOF'
| language | toolchain | compiler_path | compiler_sha256 | executable_path | executable_sha256 | selfhost_verdict | workload | requested_mode | actual_mode | fallback | warmups | iterations | wall_samples_ms | wall_ms_p50 | wall_ms_p95 | max_rss_kib | exit_status | checksum | admission / mode receipt | rejection_reason |
|---|---|---|---|---|---|---|---|---|---|---:|---:|---:|---|---:|---:|---:|---:|---:|---|---|
| simple_native | Simple selfhost | /tmp/compiler | ccc | /tmp/simple | abc | admitted-selfhost | recursive-fib-35-in-process | native | native | false | 1 | 5 | 60,61,62,63,65 | 60.000 | 65.000 | 100000 | 0 | 9227465 | admitted: in-process timing and checksum receipt | n/a |
| c | gcc | /tmp/gcc | ccc | /tmp/c | abc | n/a | recursive-fib-35-in-process | native | native | false | 1 | 5 | 20,20,21,21,22 | 20.000 | 22.000 | 1000 | 0 | 9227465 | admitted: in-process timing and checksum receipt | n/a |
| rust | rustc | /tmp/rustc | ccc | /tmp/rust | abc | n/a | recursive-fib-35-in-process | native | native | false | 1 | 5 | 30,30,31,32,33 | 30.000 | 33.000 | 2000 | 0 | 9227465 | admitted: in-process timing and checksum receipt | n/a |
| go | go | /tmp/go-compiler | ccc | /tmp/go | abc | n/a | recursive-fib-35-in-process | native | native | false | 1 | 5 | 50,51,52,53,55 | 50.000 | 55.000 | 3000 | 0 | 9227465 | admitted: in-process timing and checksum receipt | n/a |
| python | CPython | /tmp/python | ccc | /tmp/python | abc | n/a | recursive-fib-35-in-process | interpreter | interpreter | false | 1 | 5 | 1600,1620,1650,1680,1700 | 1600.000 | 1700.000 | 4000 | 0 | 9227465 | admitted: in-process timing and checksum receipt | n/a |
| bun | Bun | /tmp/bun | ccc | /tmp/bun | abc | n/a | recursive-fib-35-in-process | jsc-runtime | jsc-runtime | false | 1 | 5 | 100,101,103,105,110 | 100.000 | 110.000 | 5000 | 0 | 9227465 | admitted: in-process timing and checksum receipt | n/a |
EOF

for language in simple_native c rust go python bun; do
    grep -Eq "^\\| $language \\|" "$FIXTURE" || {
        echo "retained_schema_contract=false"
        echo "error=missing fixture language: $language"
        exit 1
    }
done

awk -F'|' '
    /^\| (simple_native|c|rust|go|python|bun) \|/ {
        rows++
        compiler=$4; compiler_hash=$5; requested=$10; actual=$11; fallback=$12; iterations=$14
        p50=$16; p95=$17; rss=$18; status=$19; checksum=$20; receipt=$21
        gsub(/^ +| +$/, "", compiler); gsub(/^ +| +$/, "", compiler_hash)
        gsub(/^ +| +$/, "", requested); gsub(/^ +| +$/, "", actual)
        gsub(/^ +| +$/, "", fallback); gsub(/^ +| +$/, "", iterations)
        gsub(/^ +| +$/, "", p50); gsub(/^ +| +$/, "", p95)
        gsub(/^ +| +$/, "", rss); gsub(/^ +| +$/, "", status)
        gsub(/^ +| +$/, "", checksum); gsub(/^ +| +$/, "", receipt)
        if (compiler == "" || compiler == "n/a" || compiler_hash == "" || compiler_hash == "n/a" ||
            requested != actual || fallback != "false" || iterations + 0 < 1 ||
            p50 + 0 <= 0 || p95 + 0 < p50 + 0 || rss + 0 <= 0 ||
            status != "0" || checksum != "9227465" || receipt !~ /^admitted:/) bad=1
    }
    END { exit rows == 6 && !bad ? 0 : 1 }
' "$FIXTURE" || {
    echo "retained_schema_contract=false"
    echo "error=valid retained fixture rejected"
    exit 1
}

grep -Fq 'retained_simple_mode_measure "simple_interpreter" "interpreter" "interpreter"' "$HARNESS"
grep -Fq 'SIMPLE_EXECUTION_MODE=interpret "$SIMPLE_BINARY" "$BUILD_DIR/fib_warm.spl"' "$HARNESS"
grep -Fq 'retained_simple_mode_measure "simple_smf_loader" "smf-loader" "smf-loader"' "$HARNESS"
grep -Fq '. "$ROOT_DIR/scripts/check/lib/require-self-hosted.shs"' "$HARNESS"
grep -Fq 'FIB_N=$FIB_N is unsupported' "$HARNESS"
grep -Fq 'SIMPLE_NO_STUB_FALLBACK=1 at compile' "$HARNESS"
grep -Fq "grep -Fxq 'fib(35) = 9227465'" "$HARNESS"

echo "retained_schema_contract=true"
echo "languages=simple_native,c,rust,go,python,bun"
echo "semantic_checksum=9227465"
