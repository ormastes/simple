#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)"
SCRIPT="$ROOT_DIR/scripts/check/check-compiler-loader-perf.shs"

need() {
    grep -Fq "$1" "$SCRIPT" || {
        echo "compiler_loader_retained_contract=false"
        echo "error=missing contract: $1"
        exit 1
    }
}

sh -n "$SCRIPT"
need '. "$ROOT_DIR/scripts/check/lib/require-self-hosted.shs"'
need 'require_self_hosted "$SIMPLE_TARGET" "compiler/loader profiler"'
need 'require_tool timeout "bounded compiler/loader subprocesses"'
need 'WARMUPS="${LOADER_PERF_WARMUPS:-2}"'
need 'RUN_TIMEOUT_SECS="${LOADER_PERF_TIMEOUT_SECS:-${RUN_TIMEOUT:-120}}"'
need 'timeout --foreground --signal=TERM --kill-after=5s'
need 'warmups=$WARMUPS (separate loader processes; excluded from samples)'
need 'SIMPLE_NO_STUB_FALLBACK=1 SIMPLE_NO_BOOTSTRAP_DELEGATE=1'
need 'strace -f -c'
need 'FAILED_PROBE_BASELINE=101725'
need 'FAILED_PROBE_LIMIT=10172'
need 'failed statx+readlink probes'
need 'failed_probes.raw'
need 'failed_probe_raw_sha256'
need 'schema=compiler-loader-perf-v2'
need 'executable_sha256'
need 'command=$current_command'
need 'command_key=$current_command_key'
need 'BASELINE_RECEIPT="${LOADER_PERF_BASELINE_RECEIPT:-}"'
need 'baseline_status=unavailable'
need 'baseline_executable_sha256'
need 'baseline_command'
need 'baseline_failed_probe_raw_receipt'
need 'identity-command-or-raw-receipt-mismatch'
need 'P95_REGRESSION_PCT="${LOADER_PERF_P95_REGRESSION_PCT:-10}"'
need 'RSS_REGRESSION_PCT="${LOADER_PERF_RSS_REGRESSION_PCT:-10}"'
need 'current p95/RSS exceeds comparable baseline regression gate'
need 'wall_ms_p50'
need 'wall_ms_p95'
need 'max_rss_kib'
need 'compiler_sha256'
need 'output_sha256'
need 'admitted:self-hosted,no-fallback,exact-strace'

echo "compiler_loader_retained_contract=true"
echo "failed_probe_reduction_gate=at_least_90_percent"
