#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
output=$(sh "$ROOT/scripts/check/check-engine2d-vulkan-c-parity.shs" --self-test)
printf '%s\n' "$output" | grep -Fxq engine2d_vulkan_c_parity_selftest=pass
grep -Fq 'simple-p95-exceeds-2x-c' "$ROOT/scripts/check/check-engine2d-vulkan-c-parity.shs"
grep -Fq 'workload_hash' "$ROOT/scripts/check/check-engine2d-vulkan-c-parity.shs"
grep -Fq 'timed_readback_bytes' "$ROOT/scripts/check/check-engine2d-vulkan-c-parity.shs"
runner="$ROOT/scripts/check/check-engine2d-vulkan-font-c-parity.shs"
grep -Fq 'ENGINE2D_VULKAN_FONT_MODE=packed' "$runner"
grep -Fq 'ENGINE2D_VULKAN_GLYPHS=64' "$runner"
grep -Fq 'ENGINE2D_VULKAN_SAMPLES=31' "$runner"
grep -Fq 'bootstrap-artifact-inadmissible' "$runner"
grep -Fq 'check-engine2d-vulkan-c-parity.shs" --compare' "$runner"
grep -Fq 'libsimple_runtime.dylib' "$ROOT/scripts/check/check-engine2d-vulkan-font-8k.shs"
grep -Fq 'hash_stdin' "$ROOT/scripts/check/check-engine2d-vulkan-font-8k.shs"
primitive_runner="$ROOT/scripts/check/check-engine2d-vulkan-primitive-c-parity.shs"
grep -Fq 'for feature in rect line axis-line image' "$primitive_runner"
grep -Fq 'ENGINE2D_VULKAN_ACTIVE_BASIS_POINTS=$active' "$primitive_runner"
grep -Fq 'ENGINE2D_VULKAN_RECT_COUNT=$count' "$primitive_runner"
grep -Fq 'ENGINE2D_VULKAN_SAMPLES=31' "$primitive_runner"
grep -Fq 'bootstrap-artifact-inadmissible' "$primitive_runner"
grep -Fq 'libsimple_runtime.dylib' "$ROOT/scripts/check/check-engine2d-vulkan-clear-8k.shs"
grep -Fq 'run_with_icd' "$ROOT/scripts/check/check-engine2d-vulkan-clear-8k.shs"
grep -Fq 'libsimple_runtime.dylib' "$ROOT/scripts/check/check-engine2d-vulkan-mixed-8k.shs"
grep -Fq 'run_with_icd' "$ROOT/scripts/check/check-engine2d-vulkan-mixed-8k.shs"
vector_runner="$ROOT/scripts/check/check-vector-font-raster-c-parity.shs"
vector_producer="$ROOT/src/app/wm_compare/vector_font_raster_feature_producer.spl"
grep -Fq 'bootstrap-artifact-inadmissible' "$vector_runner"
grep -Fq 'stale-chrome-accuracy-evidence' "$vector_runner"
grep -Fq 'simple-p95-exceeds-2x-c' "$vector_runner"
grep -Fq "grep -q '^findings=0$'" "$vector_runner"
grep -Fq 'FIRST_CODEPOINT: i64 = 33' "$vector_producer"
grep -Fq 'LAST_CODEPOINT: i64 = 126' "$vector_producer"
grep -Fq 'vector_font_simple_status=pass' "$vector_producer"
grep -Fq 'Accuracy evidence is deliberately outside every timed sample.' "$vector_producer"
grep -Fq 'Accuracy evidence is deliberately outside every timed sample.' \
    "$ROOT/test/09_baselines/engine2d_vulkan/vector_font_raster_reference.c"
echo engine2d-vulkan-c-parity-contract: PASS
