#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)"
output=$(sh "$ROOT/scripts/check/check-render-perf-8k80-container.shs" --self-test)
printf '%s\n' "$output" | grep -Fxq render_perf_8k80_container_selftest=pass
checker="$ROOT/scripts/check/check-render-perf-8k80-container.shs"
grep -Fq 'A4_DRAWIR_WORKLOAD_HASH=' "$checker"
grep -Fq 'A5_SEMANTIC_WORKLOAD_HASH=' "$checker"
grep -Fq 'CAMPAIGN_CONTRACT_HASH=' "$checker"
grep -Fq 'find src/compiler src/app src/lib -type f -print0' "$checker"
! grep -Fq 'find "$ROOT/src/compiler"' "$checker"
grep -Fq 'commands_considered_per_frame' "$checker"
grep -Fq 'commands_culled_total' "$checker"
grep -Fq 'draw.build.meta' "$checker"
grep -Fq 'producer.build.meta' "$checker"
grep -Fq 'window-producer.build.meta' "$checker"
grep -Fq 'strict_semantic_vulkan_window_producer.spl' "$checker"
grep -Fq 'strict_semantic_vulkan_window_producer.sha256' "$checker"
grep -Fq -- '--cache-dir "$native_cache"' "$checker"
grep -Fq -- '--validate-physical' "$checker"
grep -Fq 'validate_physical_for_producer' "$checker"
grep -Fq 'compiler-provenance.env' "$checker"
grep -Fq 'container-image.env' "$checker"
grep -Fq 'cuda/toolchain.txt' "$checker"
grep -Fq 'cp -R "$PUBLISH_EVIDENCE_DIR"/. "$tmp/evidence/"' "$checker"
grep -Fq 'evidence_manifest.sha256' "$checker"
grep -Fq 'evidence_manifest_hash=' "$checker"
grep -Fq 'chmod -R a-w "$final"' "$checker"
physical="$ROOT/scripts/check/check-render-perf-physical-8k80-hardware.shs"
physical_output=$(sh "$physical" --self-test)
printf '%s\n' "$physical_output" | grep -Fxq render_perf_physical_8k80_hardware_selftest=pass
grep -Fq 'window_matches_producer' "$physical"
grep -Fq -- '--admit-physical-display' "$physical"
grep -Fq 'pwd -P' "$physical"
grep -Fq 'software-run-not-immutable' "$physical"
grep -Fq 'sha256sum -c strict_semantic_vulkan_window_producer.sha256' "$physical"
grep -Fq 'software-evidence-manifest-hash-mismatch' "$physical"
grep -Fq 'render-perf-8k80-physical-publication-v1' "$physical"
grep -Fq 'evidence_manifest.sha256' "$physical"
grep -Fq 'mv -Tf "$current_tmp"' "$physical"
grep -Fq 'physical-scanout-capture-receipt-required' "$physical"
grep -Fq -- '--validate-physical' "$physical"
echo render_perf_8k80_container_contract=true
