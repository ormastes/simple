use std.io.hosted_volatile_u8_device.{
    hosted_volatile_u8_admit,
    hosted_volatile_u8_register
}
use std.io.volatile_ops.{volatile_read_u8, volatile_write_u8}

fn main() -> i64:
    if not hosted_volatile_u8_admit():
        return 2
    if not hosted_volatile_u8_register(4096, 0):
        return 3
    var checksum = 0
    var i = 0
    while i < 2000000:
        volatile_write_u8(4096, i)
        checksum = checksum + volatile_read_u8(4096)
        i = i + 1
    print checksum
    0
