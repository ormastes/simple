use std.io.hosted_volatile_u16_device.{
    hosted_volatile_u16_admit,
    hosted_volatile_u16_register
}
use std.io.volatile_ops.{volatile_read_u16, volatile_write_u16}

fn main() -> i64:
    if not hosted_volatile_u16_admit():
        return 2
    if not hosted_volatile_u16_register(4096, 0):
        return 3
    var checksum = 0
    var i = 0
    while i < 2000000:
        volatile_write_u16(4096, i)
        checksum = checksum + volatile_read_u16(4096)
        i = i + 1
    print checksum
    0
