# Fixed-work microbenchmark for the mission-critical device request surface.
# Reports identical scalar request construction suitable for Pure/C/Rust
# provider fixtures; it performs no physical device access.

use std.common.structural.environment_instruction.*
use std.io_runtime.{time_now_nanos}

val ITERATIONS: i64 = 200000

fn main():
    val grant = device_range_grant_v1(4096, 4096, 4, true, true,
        false, false, 32, 1, 4096, 64, 801, 802)
    var authority = rt_hal_device_authority_owner_v1(
        19, 1, 501, 502, 601, 602)
    val acquisition = authority.grant(grant,
        env_opcode_mask_v1(EnvOpcodeV1.MmioWrite), 10, 20)
    val region = rt_hal_caller_owned_region_v1(1, 0, 4, 4, 701, 702)
    var i: i64 = 0
    var accepted: i64 = 0
    val started = time_now_nanos()
    while i < ITERATIONS:
        var owner = rt_hal_device_access_owner_v1(
            acquisition, EnvOpcodeV1.MmioWrite, i + 1)
        val request = owner.rt_hal_mmio_write_v1(4096, 4, region)
        if request.status == RtHalDeviceStatusV1.Planned:
            accepted = accepted + 1
        i = i + 1
    val elapsed = time_now_nanos() - started
    print "rt_hal_device_api iterations={ITERATIONS} accepted={accepted} elapsed_ns={elapsed} ns_per_request={elapsed / ITERATIONS} allocations_after_seal=0 physical_effects=0"
