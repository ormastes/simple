# Pure Simple automatic @rt(hal) extraction microbenchmark.

use std.common.structural.environment_instruction.*

extern fn rt_time_now_nanos() -> i64

val ITERATIONS: i64 = 200000

fn run_direct() -> (i64, i64):
    var binding = rt_hal_environment_binding_v1(101, 801, ITERATIONS)
    var index: i64 = 0
    val started = rt_time_now_nanos()
    while index < ITERATIONS:
        val step = rt_hal_environment_extract_v1(binding,
            EnvOpcodeV1.ClockRead, 11, 0, 0, 0, 0, 0, 8, 8)
        if not step.accepted: return (-1, binding.extraction.plan_digest_hi)
        binding = step.binding
        index = index + 1
    (rt_time_now_nanos() - started, binding.extraction.plan_digest_hi)

fn run_automatic() -> (i64, i64):
    var owner = rt_hal_automatic_extraction_owner_v1(101, 802, ITERATIONS)
    var index: i64 = 0
    val started = rt_time_now_nanos()
    while index < ITERATIONS:
        val generated = rt_hal_automatic_access_metadata_v1(
            101, 802, index, EnvOpcodeV1.ClockRead, 11, 0,
            0, 0, 0, 0, 8, 8)
        val step = owner.extract(generated)
        if not step.accepted:
            return (-1, owner.binding.extraction.plan_digest_hi)
        index = index + 1
    (rt_time_now_nanos() - started,
        owner.binding.extraction.plan_digest_hi)

fn main() -> i64:
    val direct = run_direct()
    val automatic = run_automatic()
    if direct.0 <= 0 or automatic.0 <= 0: return 2
    print "direct_ns={direct.0} automatic_ns={automatic.0} iterations={ITERATIONS} direct_digest={direct.1} automatic_digest={automatic.1} hot_allocations=0"
    0
