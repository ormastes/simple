# @req: REQ-BROWSER-WEB-BROWSER-001


# codex-system-test
# @req REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-006 REQ-WEB-BROWSER-017 REQ-WEB-BROWSER-018 REQ-WEB-BROWSER-020 REQ-WEB-BROWSER-021 NFR-WEB-BROWSER-001 NFR-WEB-BROWSER-002 NFR-WEB-BROWSER-003 NFR-WEB-BROWSER-004 NFR-WEB-BROWSER-005 NFR-WEB-BROWSER-006 NFR-WEB-BROWSER-007 NFR-WEB-BROWSER-008 NFR-WEB-BROWSER-009 NFR-WEB-BROWSER-010 NFR-WEB-BROWSER-014 NFR-WEB-BROWSER-015 NFR-WEB-BROWSER-016 NFR-WEB-BROWSER-017
# @evidence-display: links
"""# Production Simple Browser Performance and GC Budgets

Measures exact production binaries for startup, render, frame, input,
cancellation, RSS, GC/lifecycle, and 10,000-cycle stability without per-frame
Engine2D/font recreation or unconditional readback.
"""
use std.spec.*
use std.common.web.browser_renderer_protocol.{
    BrowserRendererMessage,
    browser_renderer_decoder_feed,
    browser_renderer_decoder_new,
    browser_renderer_frame_decode
}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}
use os.hosted.hosted_browser_renderer_worker.{
    HostedBrowserRendererWorkerSession
}

val _BROWSER_BUDGET_ANIMATION_HTML = (
    "<style>html,body{{margin:0}}@keyframes Pulse{" +
    "from{{background-color:#ef4444}}" +
    "to{{background-color:#2563eb}}}#stage{width:32px;height:24px;" +
    "animation:Pulse 16ms linear forwards}</style>" +
    "<script type='text/simple'>title \"SimpleReady\"</script>" +
    "<div id='stage'></div><script>requestAnimationFrame(function(frameTime){" +
    "document.title='' + frameTime;});</script>"
)

# @inline
fn _browser_budget_fixture():
    step("Launch the production Simple browser")

# @inline
fn _check_resource_reclaimed():
    step("Close the page and reclaim browser resources")

# @inline
fn _check_budget_row():
    step("Measure production browser budgets")

fn _browser_budget_frame(wire: text):
    browser_renderer_frame_decode(
        browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), wire
        ).message,
        64,
        48
    )

fn _browser_budget_color_count(pixels: [u32], color: u32) -> i64:
    var count: i64 = 0
    for pixel in pixels:
        if pixel == color:
            count = count + 1
    count

fn _browser_budget_animation_evidence() -> text:
    var worker = HostedBrowserRendererWorkerSession.create(64, 48)
    val initial = worker.handle(BrowserRendererMessage(
        kind: "init", generation: 7, request_id: 2,
        payload: _BROWSER_BUDGET_ANIMATION_HTML
    ))
    if not initial.ok:
        worker.close()
        fail("animation initial frame failed")
    val initial_frame = _browser_budget_frame(initial.wire)
    if (
        not initial_frame.ok or
        initial_frame.composition.batches.len() == 0 or
        initial_frame.composition.batches[0].commands.len() == 0
    ):
        worker.close()
        fail("animation initial Draw IR frame missing")
    val initial_title = worker.browser.current_title
    val initial_revision = initial_frame.composition_revision

    val advanced = worker.handle(BrowserRendererMessage(
        kind: "advance", generation: 7, request_id: 3, payload: "16"
    ))
    if not advanced.ok:
        worker.close()
        fail("animation 16ms frame failed")
    val advanced_frame = _browser_budget_frame(advanced.wire)
    if (
        not advanced_frame.ok or
        advanced_frame.composition.batches.len() == 0 or
        advanced_frame.composition.batches[0].commands.len() == 0
    ):
        worker.close()
        fail("animation 16ms Draw IR frame missing")
    val raf_timestamp = worker.browser.current_title

    var initial_stage = initial_frame.composition.batches[0].commands[0]
    var advanced_stage = advanced_frame.composition.batches[0].commands[0]
    var initial_source = ""
    var advanced_source = ""
    for batch in initial_frame.composition.batches:
        for command in batch.commands:
            if command.component_id == "stage" and command.kind == "rect":
                initial_stage = command
                initial_source = batch.source.source_kind
    for batch in advanced_frame.composition.batches:
        for command in batch.commands:
            if command.component_id == "stage" and command.kind == "rect":
                advanced_stage = command
                advanced_source = batch.source.source_kind

    var raster = Engine2dCompositorBackend.create_named(
        64, 48, "software"
    )
    val first = raster.render_draw_ir_composition_resources_revision(
        initial_frame.composition,
        initial_frame.image_resources,
        7,
        initial_revision
    )
    val second = raster.render_draw_ir_composition_resources_revision(
        advanced_frame.composition,
        advanced_frame.image_resources,
        7,
        advanced_frame.composition_revision
    )
    raster.shutdown()
    worker.close()

    (
        "initial_title={initial_title}|raf_ms={raf_timestamp}|" +
        "revision_changed=" +
        (advanced_frame.composition_revision > initial_revision).to_text() +
        "|initial={initial_source}:{initial_stage.component_id}:" +
        "{initial_stage.kind}:{initial_stage.x},{initial_stage.y}," +
        "{initial_stage.width},{initial_stage.height}," +
        "{initial_stage.color}|advanced={advanced_source}:" +
        "{advanced_stage.component_id}:{advanced_stage.kind}:" +
        "{advanced_stage.x},{advanced_stage.y}," +
        "{advanced_stage.width},{advanced_stage.height}," +
        "{advanced_stage.color}|render={first.skipped_command_count}," +
        "{second.skipped_command_count},{first.pixels.len()}," +
        "{second.pixels.len()}," +
        "{_browser_budget_color_count(first.pixels, 0xFFEF4444u32)}," +
        "{_browser_budget_color_count(first.pixels, 0xFF2563EBu32)}," +
        "{_browser_budget_color_count(second.pixels, 0xFF2563EBu32)}," +
        "{_browser_budget_color_count(second.pixels, 0xFFEF4444u32)}," +
        "{(first.pixels == second.pixels).to_text()}"
    )

fn _require_production_budget_evidence():
    fail("NFR-WEB-BROWSER-001..017: production budget evidence not implemented")

fn _require_animation_frame_receipt():
    _check_budget_row()
    fail(
        "NFR-WEB-BROWSER-003: production animation p95/FPS receipt not implemented"
    )

fn _require_animation_resource_receipt():
    _check_budget_row()
    fail(
        "NFR-WEB-BROWSER-005..007/014: production animation RSS/GC/10,000-cycle receipt not implemented"
    )

use std.spec.step

describe "Production Simple browser performance and GC budgets":
    # @manual: show
    # @req REQ-WEB-BROWSER-006 REQ-WEB-BROWSER-018
    it "should bind one animation clock to changed Draw IR and Engine2D pixels":
        # @req: REQ-BROWSER-WEB-BROWSER-001
        step("Verify: should bind one animation clock to changed Draw IR and Engine2D pixels")
        step("Open at clock zero and require the SimpleReady title")
        step("Advance to 16 milliseconds and require rAF timestamp 16")
        step("Require stage Draw IR at 0,0 32x24 from red to blue")
        step("Render exactly 768 red then blue pixels with zero skips")
        val evidence = _browser_budget_animation_evidence()
        expect(evidence).to_equal(
            "initial_title=SimpleReady|raf_ms=16|revision_changed=true|" +
            "initial=html_ast:stage:rect:0,0,32,24,4293870660|" +
            "advanced=html_ast:stage:rect:0,0,32,24,4280640491|" +
            "render=0,0,3072,3072,768,0,768,0,false"
        )

    # @manual: show
    # @capture(log)
    # @req REQ-WEB-BROWSER-018
    it "should count unchanged retained-frame reuse without duplicate stage work":
        # @req: REQ-BROWSER-WEB-BROWSER-001
        step("Verify: should count unchanged retained-frame reuse without duplicate stage work")
        step("Reuse parsed layout work across unchanged animation frames")
        var worker = HostedBrowserRendererWorkerSession.create(64, 48)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<main id='stable'>unchanged</main>"
        )).ok).to_be(true)
        val counters = worker.render_session.counters
        val before_serialize = counters.serialize_count
        val before_parse = counters.parse_count
        val before_css = counters.css_count
        val before_style = counters.style_count
        val before_layout = counters.layout_count
        val before_paint = counters.paint_count
        val before_reuse = counters.reuse_count
        val before_composition_revision = counters.composition_revision
        expect(worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3, payload: "16"
        )).ok).to_be(true)
        val after = worker.render_session.counters

        expect(after.serialize_count).to_equal(before_serialize)
        expect(after.parse_count).to_equal(before_parse)
        expect(after.css_count).to_equal(before_css)
        expect(after.style_count).to_equal(before_style)
        expect(after.layout_count).to_equal(before_layout)
        expect(after.paint_count).to_equal(before_paint)
        expect(after.reuse_count).to_equal(before_reuse + 1)
        expect(after.composition_revision).to_equal(
            before_composition_revision
        )
        step("Close the page and reclaim browser resources")
        worker.close()
        expect(
            worker.render_session.counters.retained_command_count
        ).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

    # @manual: show
    # @capture(exec)
    # @capture(log)
    # @capture(artifact)
    it "should meet warm cold startup first-render and navigation budgets":
        # @req: REQ-BROWSER-WEB-BROWSER-001
        step("Verify: should meet warm cold startup first-render and navigation budgets")
        _browser_budget_fixture()
        _check_budget_row()
        _require_production_budget_evidence()

    # @manual: show
    # @capture(log)
    # @capture(artifact)
    it "should meet changed unchanged frame and input-to-present budgets":
        # @req: REQ-BROWSER-WEB-BROWSER-001
        step("Verify: should meet changed unchanged frame and input-to-present budgets")
        _browser_budget_fixture()
        step("Run animation pointer keyboard text and scroll workloads")
        _require_animation_frame_receipt()

    # @manual: show
    # @capture(log)
    # @capture(artifact)
    it "should stabilize heap RSS and browser resources over ten thousand cycles":
        # @req: REQ-BROWSER-WEB-BROWSER-001
        step("Verify: should stabilize heap RSS and browser resources over ten thousand cycles")
        _browser_budget_fixture()
        step("Run ten thousand navigation interaction and animation cycles")
        _check_resource_reclaimed()
        _require_animation_resource_receipt()

    # @manual: folded
    it "should keep GC pauses within frame budgets and reject stale callbacks":
        # @req: REQ-BROWSER-WEB-BROWSER-001
        step("Verify: should keep GC pauses within frame budgets and reject stale callbacks")
        _browser_budget_fixture()
        step("Measure GC pauses callback queues and post-cancel activity")
        _check_resource_reclaimed()
        _require_animation_resource_receipt()

    # @manual: folded
    it "should create Engine2D device and font state once and release it once":
        # @req: REQ-BROWSER-WEB-BROWSER-001
        step("Verify: should create Engine2D device and font state once and release it once")
        _browser_budget_fixture()
        step("Inspect Engine2D device font render-session and readback counters")
        _check_resource_reclaimed()
        _require_production_budget_evidence()

    # @manual: folded
    it "should block regressions above five percent and cap verification cycles":
        # @req: REQ-BROWSER-WEB-BROWSER-001
        step("Verify: should block regressions above five percent and cap verification cycles")
        step("Compare production receipt with the recorded baseline")
        step("Record one final result per gate and stop after three fix cycles")
        _require_production_budget_evidence()
