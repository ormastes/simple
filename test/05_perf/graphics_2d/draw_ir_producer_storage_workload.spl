# Standalone child-process workload for the AC-6 RSS receipt. It uses the
# canonical widget producer and prints the observed command count; timing/RSS
# belong to app.test.bench.bench_harness in the companion spec.

use common.ui.builder.{button, panel}
use common.ui.draw_ir.{DRAW_IR_BACKEND_CPU}
use common.ui.widget_draw_ir.{WidgetDrawIrStorage}
use nogc_sync_mut.ui.theme_package.{theme_package_render_snapshot}

fn _requested_command_count() -> i32:
    for arg in get_cli_args():
        if arg == "64":
            return 64
        if arg == "1000":
            return 1000
        if arg == "10000":
            return 10000
    64

fn _widget_producer_command_count(command_count: i32) -> i32:
    var children = []
    var child_index = 1
    while child_index < command_count:
        children.push(button("receipt-button-{child_index}", "", ""))
        child_index = child_index + 1
    val root = panel("receipt-root", "", children)
    val storage = WidgetDrawIrStorage.new()
    val snapshot = theme_package_render_snapshot("")
    val _first = storage.compose_with_theme(
        root, 320, 240, DRAW_IR_BACKEND_CPU, snapshot, 1)
    val composition = storage.compose_with_theme(
        root, 320, 240, DRAW_IR_BACKEND_CPU, snapshot, 1)
    var emitted = 0
    for batch in composition.batches:
        emitted = emitted + batch.commands.len()
    emitted

fn main():
    val command_count = _requested_command_count()
    val emitted = _widget_producer_command_count(command_count)
    print("draw_ir_producer_commands={emitted}")
