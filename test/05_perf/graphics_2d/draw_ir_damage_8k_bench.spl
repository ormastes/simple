# Canonical DrawIR retained-damage benchmark. Seed cost and final readback are
# deliberately outside the timed region; each timed frame changes one sparse
# 256x128 region and replays the root through the production damage executor.

use common.ui.draw_ir.{
    DRAW_IR_BACKEND_CPU,
    DrawIrCommand,
    DrawIrComposition,
    draw_ir_batch,
    draw_ir_composition,
    draw_ir_embedding_config,
    draw_ir_rect,
}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{
    Engine2dResolvedDrawIrImage,
    engine2d_draw_ir_adv_composition_present_with_images,
    engine2d_draw_ir_render_composition_damaged_with_images,
}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}

extern fn rt_time_now_nanos() -> i64

val WIDTH: i32 = 7680
val HEIGHT: i32 = 4320
val DAMAGE_X: i32 = 128
val DAMAGE_Y: i32 = 128
val DAMAGE_WIDTH: i32 = 256
val DAMAGE_HEIGHT: i32 = 128
val OFF_DAMAGE_COMMANDS: i32 = 512
val FRAMES: i32 = 20
val BG: u32 = 0xff102030u32
val A: u32 = 0xff315783u32
val B: u32 = 0xff8a4b29u32

fn sort_i64(values: [i64]) -> [i64]:
    var result = values
    var i = 1
    while i < result.len():
        val key = result[i]
        var j = i - 1
        while j >= 0 and result[j] > key:
            result[j + 1] = result[j]
            j -= 1
        result[j + 1] = key
        i += 1
    result

fn composition_for(color: u32) -> DrawIrComposition:
    var commands: [DrawIrCommand] = [
        draw_ir_rect("background", 0, 0, WIDTH, HEIGHT, BG)
    ]
    var i = 0
    while i < OFF_DAMAGE_COMMANDS:
        val ox = 512 + (i % 112) * 64
        val oy = 512 + (i / 112) * 64
        commands.push(draw_ir_rect("off-{i}", ox, oy, 8, 8, BG))
        i += 1
    commands.push(draw_ir_rect(
        "damage-rect", DAMAGE_X, DAMAGE_Y,
        DAMAGE_WIDTH, DAMAGE_HEIGHT, color))
    val root = draw_ir_batch(
        "root", DRAW_IR_BACKEND_CPU,
        draw_ir_embedding_config(
            "root", "root", 0, 0, WIDTH, HEIGHT, 0, 1000, false),
        commands)
    draw_ir_composition(
        "drawir-damage-8k", "drawir-damage-8k", DRAW_IR_BACKEND_CPU,
        [root])

fn main():
    var engine = Engine2D.create_with_backend(WIDTH, HEIGHT, "cpu")
    var images: [Engine2dResolvedDrawIrImage] = []
    val seed = composition_for(A)
    engine.clear(BG)
    val seeded = engine2d_draw_ir_adv_composition_present_with_images(
        engine, seed, false, images)
    if (seeded.fallback_required or
        seeded.rendered_command_count != OFF_DAMAGE_COMMANDS + 2 or
        seeded.skipped_command_count != 0):
        print "draw_ir_damage_8k_status=seed-failed"
        print "draw_ir_damage_8k_seed_backend={seeded.selected_backend}"
        print "draw_ir_damage_8k_seed_fallback={seeded.fallback_required}"
        print "draw_ir_damage_8k_seed_reason={seeded.fallback_reason}"
        print "draw_ir_damage_8k_seed_rendered={seeded.rendered_command_count}"
        print "draw_ir_damage_8k_seed_skipped={seeded.skipped_command_count}"
        engine.shutdown()
        return

    var samples: [i64] = []
    val selected_backend = engine.backend_name()
    var frame = 0
    var valid = true
    var considered_total = 0
    var culled_total = 0
    var rendered_total = 0
    var skipped_total = 0
    while frame < FRAMES:
        val composition = composition_for(if frame % 2 == 0: B else: A)
        val started = rt_time_now_nanos()
        val outcome = engine2d_draw_ir_render_composition_damaged_with_images(
            engine, composition, images,
            [DAMAGE_X.to_i64(), DAMAGE_Y.to_i64(),
             DAMAGE_WIDTH.to_i64(), DAMAGE_HEIGHT.to_i64()], false)
        val finished = rt_time_now_nanos()
        engine = outcome.engine
        if (outcome.unsupported_kinds != "none" or
            outcome.ops_rendered < 1 or
            outcome.ops_rendered > 2 or
            outcome.ops_skipped < OFF_DAMAGE_COMMANDS or
            outcome.commands_considered != 2 or
            outcome.commands_culled_by_damage != OFF_DAMAGE_COMMANDS or
            outcome.commands_considered + outcome.commands_culled_by_damage != OFF_DAMAGE_COMMANDS + 2):
            valid = false
        considered_total += outcome.commands_considered
        culled_total += outcome.commands_culled_by_damage
        rendered_total += outcome.ops_rendered
        skipped_total += outcome.ops_skipped
        samples.push(finished - started)
        frame += 1

    val ordered = sort_i64(samples)
    val readback = engine.read_pixels_with_source()
    val pixels = readback.pixels
    var checksum: i64 = 0
    var mismatches = 0
    var pixel_index = 0
    val final_color = if (FRAMES - 1) % 2 == 0: B else: A
    while pixel_index < pixels.len():
        val pixel = pixels[pixel_index]
        checksum += pixel.to_i64()
        val px = pixel_index % WIDTH
        val py = pixel_index / WIDTH
        val expected = if (px >= DAMAGE_X and px < DAMAGE_X + DAMAGE_WIDTH and
                           py >= DAMAGE_Y and py < DAMAGE_Y + DAMAGE_HEIGHT): final_color else: BG
        if pixel != expected:
            mismatches += 1
        pixel_index += 1
    val first_pixel = pixels[0]
    val damage_first_pixel = pixels[DAMAGE_Y * WIDTH + DAMAGE_X]
    val damage_last_pixel = pixels[(DAMAGE_Y + DAMAGE_HEIGHT - 1) * WIDTH + DAMAGE_X + DAMAGE_WIDTH - 1]
    val below_damage_pixel = pixels[(DAMAGE_Y + DAMAGE_HEIGHT) * WIDTH + DAMAGE_X]
    val last_pixel = pixels[pixels.len() - 1]
    val parity = (valid and pixels.len() == WIDTH * HEIGHT and mismatches == 0 and
        first_pixel == BG and damage_first_pixel == final_color and
        damage_last_pixel == final_color and below_damage_pixel == BG and
        last_pixel == BG and selected_backend == "cpu" and
        considered_total == 2 * FRAMES and
        culled_total == OFF_DAMAGE_COMMANDS * FRAMES)
    print "draw_ir_damage_8k_status={if parity: \"pass\" else: \"fail\"}"
    print "draw_ir_damage_8k_viewport={WIDTH}x{HEIGHT}"
    print "draw_ir_damage_8k_backend=cpu"
    print "draw_ir_damage_8k_selected_backend={selected_backend}"
    print "draw_ir_damage_8k_scope=executor-only-prebuilt-dynamic-composition"
    print "draw_ir_damage_8k_revision_mode=synthetic-color-frame"
    print "draw_ir_damage_8k_revision_count={FRAMES}"
    print "draw_ir_damage_8k_final_frame_revision={FRAMES - 1}"
    print "draw_ir_damage_8k_frames={FRAMES}"
    print "draw_ir_damage_8k_damage_rect={DAMAGE_X},{DAMAGE_Y},{DAMAGE_WIDTH},{DAMAGE_HEIGHT}"
    print "draw_ir_damage_8k_damage_pixels={DAMAGE_WIDTH * DAMAGE_HEIGHT}"
    print "draw_ir_damage_8k_commands_total={OFF_DAMAGE_COMMANDS + 2}"
    print "draw_ir_damage_8k_commands_considered_total={considered_total}"
    print "draw_ir_damage_8k_commands_culled_total={culled_total}"
    print "draw_ir_damage_8k_commands_rendered_total={rendered_total}"
    print "draw_ir_damage_8k_commands_skipped_total={skipped_total}"
    print "draw_ir_damage_8k_p50_ns={ordered[FRAMES * 50 / 100]}"
    print "draw_ir_damage_8k_p95_ns={ordered[FRAMES * 95 / 100]}"
    print "draw_ir_damage_8k_readback_mode={readback.source}-outside-timing"
    print "draw_ir_damage_8k_readback_pixels={pixels.len()}"
    print "draw_ir_damage_8k_seed_fallback={seeded.fallback_required}"
    print "draw_ir_damage_8k_receipts_valid={valid}"
    print "draw_ir_damage_8k_checksum={checksum}"
    print "draw_ir_damage_8k_full_frame_mismatches={mismatches}"
    print "draw_ir_damage_8k_max_rss_kib=outer-harness"
    engine.shutdown()

main()
