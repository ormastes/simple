# Native-typed 8K retained Web -> DrawIR -> Engine2D evidence entry.
use common.ui.draw_ir.{
    draw_ir_batch, draw_ir_composition, draw_ir_embedding_config, draw_ir_rect
}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{Engine2dDrawIrAdvResult}
use os.compositor.compositor_engine2d.Engine2dCompositorBackend

extern fn rt_time_now_nanos() -> i64
extern fn rt_file_read_text(path: text) -> text

val W: i32 = 7680
val H: i32 = 4320
val FRAMES: i64 = 5

fn sort_samples(samples: [i64]):
    var i: i64 = 1
    while i < samples.len():
        val key = samples[i]
        var j = i - 1
        while j >= 0 and samples[j] > key:
            samples[j + 1] = samples[j]
            j = j - 1
        samples[j + 1] = key
        i = i + 1

fn checksum(pixels: [u32]) -> i64:
    var value: i64 = 1469598103934665603
    var i: i64 = 0
    while i < pixels.len():
        value = (value ^ pixels[i].to_i64()) * 1099511628211
        i = i + 1
    value & 0x7FFFFFFFFFFFFFFF

fn rss_kb() -> i64:
    val status = rt_file_read_text("/proc/self/status")
    val start = status.find("VmRSS:")
    if start < 0:
        return 0
    var i = start + 6
    while i < status.len() and (status[i] == ' ' or status[i] == '\t'):
        i = i + 1
    var value: i64 = 0
    while i < status.len() and status[i] >= '0' and status[i] <= '9':
        value = value * 10 + (status[i] as i64 - '0' as i64)
        i = i + 1
    value

fn main():
    val embedding = draw_ir_embedding_config(
        "web", "body", 0, 0, W, H, 0, 1000, true)
    val composition = draw_ir_composition(
        "web-frame-switch-8k", "hosted-web", "software", [
            draw_ir_batch("body", "software", embedding, [
                draw_ir_rect("background", 0, 0, W, H, 0xFF111827u32)
            ])
        ])
    var backend = Engine2dCompositorBackend.create_named(W, H, "software")
    val seed: Engine2dDrawIrAdvResult = backend.render_draw_ir_composition_resources_revision(
        composition, [], 41, 9)
    val seed_checksum = checksum(seed.pixels)
    var samples: [i64] = [0; FRAMES]
    var mismatches: i64 = 0
    var frame: i64 = 0
    while frame < FRAMES:
        val started = rt_time_now_nanos()
        val retained: Engine2dDrawIrAdvResult = backend.render_draw_ir_composition_resources_revision(
            composition, [], 41, 9)
        samples[frame] = rt_time_now_nanos() - started
        if retained.pixels.len() != seed.pixels.len():
            mismatches = mismatches + 1
        frame = frame + 1
    sort_samples(samples)
    val p50 = samples[FRAMES * 50 / 100]
    val p95 = samples[FRAMES * 95 / 100]
    val exact_switch = (
        backend.revision_render_count == 1 and
        backend.revision_reuse_count == FRAMES and mismatches == 0)
    val passes = (p95 <= 12500000 and exact_switch and
        seed.pixels.len() == (W as i64) * (H as i64) and
        not seed.fallback_required)
    print("WEB_DRAW_IR_8K_SWITCH status=" + (if passes: "pass" else: "fail") +
          " viewport=7680x4320 backend=software-retained" +
          " source_revision=working-tree-2026-08-12 frames=" + FRAMES.to_string() +
          " redraw_frames=" + backend.revision_render_count.to_string() +
          " reused_frames=" + backend.revision_reuse_count.to_string() +
          " p50_ns=" + p50.to_string() + " p95_ns=" + p95.to_string() +
          " target_p95_ns=12500000 rss_kb=" + rss_kb().to_string() +
          " fallback=" + seed.fallback_required.to_string() +
          " readback_mode=" + seed.readback_source +
          " checksum=" + seed_checksum.to_string() +
          " checksum_mismatches=" + mismatches.to_string() +
          " render_mode=retained-exact-producer-revision")
    backend.shutdown()

main()
