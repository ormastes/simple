"""
B2 perf gate (compiler_bugs_for_crypto_2026-04-25.md):
  rt_bytes_alloc(n) must produce a 1 MiB zero-filled [u8] in <1 s,
  and 32 MiB in <30 s, in interpreter mode.

Avoids the per-element `buf.push(0u8)` loop that's quadratic in the
interpreter (memory: feedback_interpreter_bulk_buffer.md).
"""

extern fn rt_bytes_alloc(len: u64) -> [u8]
extern fn rt_time_now_unix_micros() -> i64
extern fn rt_cli_exit(code: i64)
use std.io_runtime.{env_get}

fn zero_fill_checksum(buf: [u8]) -> u64:
    var checksum: u64 = 0
    for byte in buf:
        checksum = checksum + byte.to_u64()
    checksum

fn measure(label: text, n: u64):
    val t0 = rt_time_now_unix_micros()
    val buf = rt_bytes_alloc(n)
    val t1 = rt_time_now_unix_micros()
    val elapsed_ms = (t1 - t0) / 1000
    if buf.len() != n:
        print "{label}: requested={n} actual_len={buf.len()} allocation_failed"
        rt_cli_exit(1)
    val checksum = zero_fill_checksum(buf)
    if buf[0] != 0 or buf[buf.len() - 1] != 0 or checksum != 0:
        print "{label}: requested={n} actual_len={buf.len()} zero_fill_checksum={checksum} invalid"
        rt_cli_exit(1)
    print "{label}: len={buf.len()} elapsed_ms={elapsed_ms} zero_fill_checksum={checksum}"

fn main():
    val selected = env_get("PERF_BYTE_SIZE") ?? "all"
    if selected == "1048576" or selected == "all":
        measure("1 MiB", 1048576)
    if selected == "4194304" or selected == "all":
        measure("4 MiB", 4194304)
    if selected == "33554432" or selected == "all":
        measure("32 MiB", 33554432)
    if selected != "all" and selected != "1048576" and selected != "4194304" and selected != "33554432":
        print "unsupported PERF_BYTE_SIZE={selected}"
        rt_cli_exit(2)
