# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# design: doc/04_architecture/adr/ADR-005-text-index-yields-char.md (§ Performance)
#
# Budget for text indexing cost. ADR-005 requires `s[i]` to be O(1) on ASCII
# text (is-ASCII header flag) and `s.chars()` / `s.byte_at(i)` to be the linear
# paths. 20,000 indexed reads of an ASCII text must finish inside the budget.
# Budget is explicit with margin: 2,000 ms on the interpreter. An O(n^2) scan
# of 20,000 chars (~2e8 byte steps) blows well past it.

use std.spec.step
use std.spec.*
use std.io_runtime.{time_now_unix_micros}

val N = 20000
val BUDGET_MS = 2000

fn ascii_text(n: i64) -> text:
    var parts: [text] = []
    var i = 0
    while i < n:
        parts.push("a")
        i = i + 1
    return parts.join("")

describe "text index cost budget":
    it "indexing an ASCII text is linear overall":
        # @req REQ-SSPEC-UNIT
        step("index every position of a 20k ASCII text")
        val s = ascii_text(N)
        val started = time_now_unix_micros()
        var total = 0
        var i = 0
        while i < N:
            total = total + s.char_code_at(i)
            i = i + 1
        val elapsed_ms = (time_now_unix_micros() - started) / 1000
        expect(total).to_equal(97 * N)
        expect(elapsed_ms < BUDGET_MS).to_be(true)

    it "byte_at over an ASCII text is linear overall":
        # @req REQ-SSPEC-UNIT
        step("byte_at every position of a 20k ASCII text")
        val s = ascii_text(N)
        val started = time_now_unix_micros()
        var total = 0
        var i = 0
        while i < N:
            total = total + s.byte_at(i)
            i = i + 1
        val elapsed_ms = (time_now_unix_micros() - started) / 1000
        expect(total).to_equal(97 * N)
        expect(elapsed_ms < BUDGET_MS).to_be(true)
