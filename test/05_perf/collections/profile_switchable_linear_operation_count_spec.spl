# @tag:in-development
# Tracks: doc/08_tracking/bug/pr1870_pr1830_unreviewed_merge_fallout_2026-09-28.md
# @req NFR-PSC-002
# @cover src/lib/nogc_sync_mut/src/collections/adaptive_text_set.spl
# @cover src/lib/nogc_sync_mut/src/collections/adaptive_text_map.spl
# @cover src/lib/nogc_sync_mut/src/collections/adaptive_map.spl
# @cover src/lib/nogc_sync_mut/src/collections/adaptive_set.spl
use std.spec.*
use std.nogc_sync_mut.src.collections.adaptive_text_set.{
    AdaptiveTextSet, AdaptiveSetAttribute}
use std.nogc_sync_mut.src.collections.adaptive_text_map.AdaptiveTextMap
use std.nogc_sync_mut.src.collections.adaptive_map.AdaptiveMap
use std.nogc_sync_mut.src.collections.adaptive_set.AdaptiveSet

describe "profile-switchable linear lookup operation counts":
    it "compares at most n text-set keys at n, 2n, 4n, and 8n":
        for size in [32, 64, 128, 256]:
            var set = AdaptiveTextSet.new()
            set.set_attribute(AdaptiveSetAttribute.Linear)
            expect(set.contains("absent")).to_be(false)
            expect(set.linear_lookup_comparisons()).to_equal(0)
            for key in 0..size:
                set.insert("key-{key}")
            val last = size - 1
            expect(set.len()).to_equal(size)
            expect(set.contains("key-{last}")).to_be(true)
            expect(set.linear_lookup_comparisons()).to_equal(size)
            expect(set.contains("absent")).to_be(false)
            expect(set.linear_lookup_comparisons()).to_equal(size)
            expect(set.contains("key-0")).to_be(true)
            expect(set.linear_lookup_comparisons()).to_equal(1)

    it "compares at most n text-map keys at n, 2n, 4n, and 8n":
        for size in [32, 64, 128, 256]:
            var map = AdaptiveTextMap.new()
            map.set_attribute(AdaptiveSetAttribute.Linear)
            expect(map.get("absent")).to_be_nil()
            expect(map.linear_lookup_comparisons()).to_equal(0)
            for key in 0..size:
                map.put("key-{key}", "value-{key}")
            val last = size - 1
            expect(map.len()).to_equal(size)
            expect(map.get("key-{last}") ?? "").to_equal("value-{last}")
            expect(map.linear_lookup_comparisons()).to_equal(size)
            expect(map.get("absent")).to_be_nil()
            expect(map.linear_lookup_comparisons()).to_equal(size)
            expect(map.contains_key("key-0")).to_be(true)
            expect(map.linear_lookup_comparisons()).to_equal(1)

    it "compares at most n generic-map keys at n, 2n, 4n, and 8n":
        for size in [32, 64, 128, 256]:
            var map: AdaptiveMap<i64, i64> = AdaptiveMap.new()
            map.set_attribute(AdaptiveSetAttribute.Linear)
            expect(map.get(-1)).to_be_nil()
            expect(map.linear_lookup_comparisons()).to_equal(0)
            for key in 0..size:
                map.put(key as i64, key as i64)
            expect(map.len()).to_equal(size)
            expect(map.get((size - 1) as i64) ?? -1).to_equal(size - 1)
            expect(map.linear_lookup_comparisons()).to_equal(size)
            expect(map.contains_key(-1)).to_be(false)
            expect(map.linear_lookup_comparisons()).to_equal(size)
            expect(map.contains_key(0)).to_be(true)
            expect(map.linear_lookup_comparisons()).to_equal(1)

    it "counts delegated generic-set comparisons once per key":
        for size in [32, 64, 128, 256]:
            var set: AdaptiveSet<i64> = AdaptiveSet.new()
            set.set_attribute(AdaptiveSetAttribute.Linear)
            expect(set.contains(-1)).to_be(false)
            expect(set.linear_lookup_comparisons()).to_equal(0)
            for key in 0..size:
                set.insert(key as i64)
            expect(set.len()).to_equal(size)
            expect(set.contains((size - 1) as i64)).to_be(true)
            expect(set.linear_lookup_comparisons()).to_equal(size)
            expect(set.contains(-1)).to_be(false)
            expect(set.linear_lookup_comparisons()).to_equal(size)
            expect(set.contains(0)).to_be(true)
            expect(set.linear_lookup_comparisons()).to_equal(1)
