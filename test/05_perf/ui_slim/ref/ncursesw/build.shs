#!/bin/sh
# Build the ncursesw T1 reference fixture and record a build receipt.
# Reference-only fixture; see doc/07_guide/ui/ui_slim_c_references.md.
set -e

here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../../../../.." && pwd)
out_dir="$repo/build/ui_slim/ref"
receipt="$out_dir/ncursesw.receipt.sdn"
bin="$out_dir/t1_ncursesw"
src="$here/t1_ncursesw.c"

mkdir -p "$out_dir"

CC=${CC:-cc}

# Prefer the Homebrew wide-character build. macOS ships only ncurses 6.0 as a
# NON-wide libncurses.5.4 .tbd stub, which cannot honour NCURSES_WIDECHAR.
NC_CONFIG=${NC_CONFIG:-/opt/homebrew/opt/ncurses/bin/ncursesw6-config}
if [ ! -x "$NC_CONFIG" ]; then
  echo "ERROR — nothing was checked (no ncursesw6-config at $NC_CONFIG; the macOS system ncurses is not a wide-char build)" >&2
  exit 2
fi

nc_prefix=$(dirname "$(dirname "$NC_CONFIG")")
nc_version=$("$NC_CONFIG" --version)
nc_cflags=$("$NC_CONFIG" --cflags)
static_lib="$nc_prefix/lib/libncursesw.a"

CFLAGS="-O2 -Wall -Wextra -std=c99 $nc_cflags"
# Name the archive explicitly: -lncursesw would resolve to the dylib.
if [ -f "$static_lib" ]; then
  LDLIBS="$static_lib"
  link_mode="static-ncursesw (archive named explicitly; libSystem stays dynamic — macOS has no fully static libc)"
else
  LDLIBS=$("$NC_CONFIG" --libs)
  link_mode="dynamic-ncursesw (no libncursesw.a found)"
fi

set -x
$CC $CFLAGS -o "$bin" "$src" $LDLIBS
set +x

cp "$bin" "$bin.stripped"
strip "$bin.stripped" 2>/dev/null || strip -x "$bin.stripped"
stripped_raw_bytes=$(wc -c < "$bin.stripped" | tr -d ' ')
# strip invalidates the arm64 ad-hoc signature; re-sign so the artifact is
# still runnable. The signature blob is larger than the symbols removed, so
# the SIGNED stripped copy can exceed the unstripped binary — both are recorded.
codesign -s - -f "$bin.stripped" >/dev/null 2>&1 || true

case "$(uname -s)" in
  Darwin) sz() { stat -f %z "$1"; } ;;
  *)      sz() { stat -c %s "$1"; } ;;
esac

{
  echo "# Build receipt for the ncursesw T1 reference fixture."
  echo "# Generated by test/05_perf/ui_slim/ref/ncursesw/build.shs"
  echo "fixture: t1_ncursesw"
  echo "workload: T1"
  echo "kind: reference-only"
  echo "generated_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "host_uname: \"$(uname -srm)\""
  echo "compiler: \"$($CC --version 2>&1 | head -1)\""
  echo "cflags: \"$CFLAGS\""
  echo "link_line: \"$CC $CFLAGS -o $bin $src $LDLIBS\""
  echo "ncurses_source: \"$nc_prefix\""
  echo "ncurses_version: $nc_version"
  echo "ncurses_widechar: true"
  echo "system_ncurses: \"$(tput -V 2>&1) at /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib/libncurses.5.4.tbd — NOT a wide-char build, not used\""
  echo "link_mode: \"$link_mode\""
  echo "terminfo_dirs: \"$(infocmp -D 2>&1 | tr '\n' ';')\""
  echo "binary_bytes: $(sz "$bin")"
  echo "stripped_bytes: $stripped_raw_bytes"
  echo "stripped_resigned_bytes: $(sz "$bin.stripped")"
  echo "stripped_note: \"stripped_bytes is measured before re-signing; strip invalidates the arm64 ad-hoc signature, so the copy is re-signed with codesign -s - and stripped_resigned_bytes may exceed binary_bytes\""
  echo "linked_dylibs |name|"
  otool -L "$bin" 2>/dev/null | tail -n +2 | awk '{print "    " $1}'
  echo "binary_sha256: $(shasum -a 256 "$bin" | cut -d' ' -f1)"
} > "$receipt"

echo "built: $bin"
echo "receipt: $receipt"
