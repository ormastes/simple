#!/bin/sh
# Build the termbox2 T1 reference fixture and record a build receipt.
# Reference-only fixture; see doc/07_guide/ui/ui_slim_c_references.md.
set -e

here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../../../../.." && pwd)
out_dir="$repo/build/ui_slim/ref"
receipt="$out_dir/termbox2.receipt.sdn"
bin="$out_dir/t1_termbox2"
src="$here/t1_termbox2.c"
vendor="$here/../vendor/termbox2"

mkdir -p "$out_dir"

CC=${CC:-cc}
CFLAGS="-O2 -Wall -Wextra -std=c99 -D_DARWIN_C_SOURCE"
LDFLAGS=""   # termbox2 is a single header; no external library at all

# termbox2.h uses designated initializers and wide-char tables; it needs no
# library, so this is the whole link line.
set -x
$CC $CFLAGS -o "$bin" "$src" $LDFLAGS
set +x

cp "$bin" "$bin.stripped"
strip "$bin.stripped" 2>/dev/null || strip -x "$bin.stripped"
# strip invalidates the arm64 ad-hoc signature; re-sign so the size measurement
# is taken from an artifact that could actually run.
stripped_raw_bytes=$(wc -c < "$bin.stripped" | tr -d ' ')
# strip invalidates the arm64 ad-hoc signature; re-sign so the artifact is
# still runnable. The signature blob is larger than the symbols removed, so
# the SIGNED stripped copy can exceed the unstripped binary — both are recorded.
codesign -s - -f "$bin.stripped" >/dev/null 2>&1 || true

case "$(uname -s)" in
  Darwin) sz() { stat -f %z "$1"; } ;;
  *)      sz() { stat -c %s "$1"; } ;;
esac

pin=$(cat "$here/../vendor/termbox2.pin" 2>/dev/null || echo unknown)
{
  echo "# Build receipt for the termbox2 T1 reference fixture."
  echo "# Generated by test/05_perf/ui_slim/ref/termbox2/build.shs"
  echo "fixture: t1_termbox2"
  echo "workload: T1"
  echo "kind: reference-only"
  echo "generated_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "host_uname: \"$(uname -srm)\""
  echo "compiler: \"$($CC --version 2>&1 | head -1)\""
  echo "cflags: \"$CFLAGS\""
  echo "link_line: \"$CC $CFLAGS -o $bin $src $LDFLAGS\""
  echo "external_libraries: none (single-header library compiled in)"
  echo "static_link: \"n/a — no external library; libSystem is always dynamic on macOS\""
  echo "upstream_pin: $pin"
  echo "upstream_header_sha256: $(shasum -a 256 "$vendor/termbox2.h" | cut -d' ' -f1)"
  echo "binary_bytes: $(sz "$bin")"
  echo "stripped_bytes: $stripped_raw_bytes"
  echo "stripped_resigned_bytes: $(sz "$bin.stripped")"
  echo "stripped_note: \"stripped_bytes is measured before re-signing; strip invalidates the arm64 ad-hoc signature, so the copy is re-signed with codesign -s - and stripped_resigned_bytes may exceed binary_bytes\""
  echo "linked_dylibs |name|"
  otool -L "$bin" 2>/dev/null | tail -n +2 | awk '{print "    " $1}'
  echo "binary_sha256: $(shasum -a 256 "$bin" | cut -d' ' -f1)"
} > "$receipt"

echo "built: $bin"
echo "receipt: $receipt"
