# @cover test/05_perf/io_parity/io_contract_policy.spl 100%

use std.spec.*
use std.nogc_sync_mut.io.file.{FileHandle}
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.common.io.types.{FileMode}
use std.tooling.coverage as coverage
use io_contract_policy.{io_contract_ok}

describe "C/Pure-Simple file-I/O contract":
    it "covers success, missing, partial, EOF, exact success, and exact failure":
        step("compare C and Pure Simple I/O semantics")
        val root = env_get("IO_PARITY_ROOT")
        val path = root + "/contract.bin"
        val missing = root + "/missing.bin"

        match FileHandle.open(missing, FileMode.ReadOnly):
            case Err(_): expect("missing").to_equal("missing")
            case Ok(_): fail("missing file unexpectedly opened")

        var h = match FileHandle.open(path, FileMode.ReadOnly):
            case Ok(opened): opened
            case Err(_): fail("contract fixture did not open")
        val partial = match h.read(17):
            case Ok(bytes): bytes
            case Err(_): fail("partial read failed")
        expect(partial.len()).to_equal(11)
        val eof = match h.read(1):
            case Ok(bytes): bytes
            case Err(_): fail("EOF read failed")
        expect(eof.len()).to_equal(0)
        expect(h.close().is_ok()).to_be(true)

        var exact_ok = match FileHandle.open(path, FileMode.ReadOnly):
            case Ok(opened): opened
            case Err(_): fail("exact-success fixture did not open")
        expect(exact_ok.read_exact(11).is_ok()).to_be(true)
        expect(exact_ok.close().is_ok()).to_be(true)

        var exact_short = match FileHandle.open(path, FileMode.ReadOnly):
            case Ok(opened): opened
            case Err(_): fail("exact-short fixture did not open")
        expect(exact_short.read_exact(17).is_err()).to_be(true)
        expect(exact_short.close().is_ok()).to_be(true)

    it "covers the contract decision and each individual condition both ways":
        step("measure HAL branch coverage")
        expect(coverage.is_coverage_enabled()).to_be(true)
        coverage.clear_coverage()
        expect(io_contract_ok(true, true, 11, 0, true, true)).to_be(true)
        expect(io_contract_ok(false, true, 11, 0, true, true)).to_be(false)
        expect(io_contract_ok(true, false, 11, 0, true, true)).to_be(false)
        expect(io_contract_ok(true, true, 10, 0, true, true)).to_be(false)
        expect(io_contract_ok(true, true, 11, 1, true, true)).to_be(false)
        expect(io_contract_ok(true, true, 11, 0, false, true)).to_be(false)
        expect(io_contract_ok(true, true, 11, 0, true, false)).to_be(false)

        val sdn = coverage.get_coverage_sdn()
        expect(sdn).to_contain("coverage_extension: decision-condition-v1")
        var section = ""
        var decisions: i64 = 0
        var covered_decisions: i64 = 0
        var conditions: i64 = 0
        var covered_conditions: i64 = 0
        for line in sdn.split("\n"):
            if line.starts_with("decisions |"):
                section = "decisions"
            elif line.starts_with("conditions |"):
                section = "conditions"
            elif line.starts_with("paths |"):
                section = ""
            elif line.contains("test/05_perf/io_parity/io_contract_policy.spl"):
                val fields = line.split(",")
                if section == "decisions" and fields.len() == 6:
                    decisions = decisions + 1
                    val true_count = fields[4].trim().parse_int() ?? 0
                    val false_count = fields[5].trim().parse_int() ?? 0
                    if true_count > 0 and false_count > 0:
                        covered_decisions = covered_decisions + 1
                elif section == "conditions" and fields.len() == 7:
                    conditions = conditions + 1
                    val true_count = fields[5].trim().parse_int() ?? 0
                    val false_count = fields[6].trim().parse_int() ?? 0
                    if true_count > 0 and false_count > 0:
                        covered_conditions = covered_conditions + 1
        expect(decisions).to_equal(1)
        expect(covered_decisions).to_equal(1)
        expect(conditions).to_equal(6)
        expect(covered_conditions).to_equal(6)
