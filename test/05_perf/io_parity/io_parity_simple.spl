"""
Pure-Simple side of the hosted file-I/O parity benchmark.

All host operations route through the public typed `std.io` surface. This
program deliberately contains no direct raw-runtime declaration or call. C and
Simple execute the same three observable workloads: whole-file read, mmap
read-to-text, and repeated 4 KiB append.
"""

use std.nogc_sync_mut.io.file.{FileHandle}
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.io.file_ops.{file_mmap_read_text, file_write_text_at, file_remove}
use std.common.io.types.{FileMode}
use io_contract_policy.{io_contract_ok}

fn checksum_bytes(bytes: [u8]) -> i64:
    var sum: i64 = 0
    var i: i64 = 0
    while i < bytes.len():
        sum = (sum + (bytes[i] as i64)) % 2147483647
        i = i + 1
    sum

fn positive_i64_or(raw: text, fallback: i64) -> i64:
    if raw.len() == 0:
        return fallback
    var value: i64 = 0
    var i: i64 = 0
    while i < raw.len():
        val ch = raw.slice(i, i + 1)
        var digit: i64 = -1
        if ch == "0": digit = 0
        elif ch == "1": digit = 1
        elif ch == "2": digit = 2
        elif ch == "3": digit = 3
        elif ch == "4": digit = 4
        elif ch == "5": digit = 5
        elif ch == "6": digit = 6
        elif ch == "7": digit = 7
        elif ch == "8": digit = 8
        elif ch == "9": digit = 9
        else: return fallback
        value = value * 10 + digit
        i = i + 1
    if value > 0: value else: fallback

fn chunk_4k() -> text:
    var chunk = "simple-io-parity-0123456789abcdef\n"
    while chunk.len() < 4096:
        chunk = chunk + chunk
    chunk.slice(0, 4096)

fn report(case_name: text, bytes_count: i64, iterations: i64, checksum: i64):
    print("[iobench-observation] lang=simple case={case_name} bytes={bytes_count} iters={iterations} checksum={checksum}")

fn contract(path: text, missing: text) -> i64:
    var missing_rejected = false
    match FileHandle.open(missing, FileMode.ReadOnly):
        case Err(_): missing_rejected = true
        case Ok(opened):
            var unexpected = opened
            unexpected.close()

    var h = match FileHandle.open(path, FileMode.ReadOnly):
        case Ok(opened): opened
        case Err(_):
            print("[iobench-contract] lang=simple status=fail reason=open")
            return 1
    val partial = match h.read(17):
        case Ok(bytes): bytes
        case Err(_): []
    val eof = match h.read(1):
        case Ok(bytes): bytes
        case Err(_): [255u8]
    val open_ok = partial.len() == 11 and checksum_bytes(partial) == 1122
    val close_ok = h.close().is_ok()

    var exact_ok_h = match FileHandle.open(path, FileMode.ReadOnly):
        case Ok(opened): opened
        case Err(_):
            print("[iobench-contract] lang=simple status=fail reason=exact-open")
            return 1
    val exact_ok = exact_ok_h.read_exact(11).is_ok()
    val exact_close_ok = exact_ok_h.close().is_ok()

    var exact_short_h = match FileHandle.open(path, FileMode.ReadOnly):
        case Ok(opened): opened
        case Err(_):
            print("[iobench-contract] lang=simple status=fail reason=short-open")
            return 1
    val exact_short_rejected = exact_short_h.read_exact(17).is_err()
    val short_close_ok = exact_short_h.close().is_ok()

    val observations_ok = io_contract_ok(
        open_ok,
        missing_rejected,
        partial.len(),
        eof.len(),
        exact_ok,
        exact_short_rejected,
    )
    if observations_ok and close_ok and exact_close_ok and short_close_ok:
        print("[iobench-contract] lang=simple status=pass partial=11 eof=0 checksum=1122 exact=pass exact_short=rejected missing=rejected")
        return 0
    print("[iobench-contract] lang=simple status=fail reason=observation")
    1

fn bench_read_text(path: text, iterations: i64) -> i64:
    var total_bytes: i64 = 0
    var checksum: i64 = 0
    var iteration: i64 = 0
    while iteration < iterations:
        var h = match FileHandle.open(path, FileMode.ReadOnly):
            case Ok(opened): opened
            case Err(_):
                print("[iobench-error] lang=simple case=read_text reason=open")
                return 1
        val bytes = match h.read_all():
            case Ok(data): data
            case Err(_):
                print("[iobench-error] lang=simple case=read_text reason=read")
                return 1
        if h.close().is_err():
            print("[iobench-error] lang=simple case=read_text reason=close")
            return 1
        total_bytes = total_bytes + bytes.len()
        checksum = (checksum + checksum_bytes(bytes)) % 2147483647
        iteration = iteration + 1
    report("read_text", total_bytes, iterations, checksum)
    0

fn bench_mmap_text(path: text, iterations: i64) -> i64:
    var total_bytes: i64 = 0
    var checksum: i64 = 0
    var iteration: i64 = 0
    while iteration < iterations:
        val content = file_mmap_read_text(path)
        val bytes = content.bytes()
        total_bytes = total_bytes + bytes.len()
        checksum = (checksum + checksum_bytes(bytes)) % 2147483647
        iteration = iteration + 1
    report("mmap_text", total_bytes, iterations, checksum)
    0

fn bench_append_at(path: text, iterations: i64) -> i64:
    file_remove(path)
    val chunk = chunk_4k()
    val chunk_checksum = checksum_bytes(chunk.bytes())
    var checksum: i64 = 0
    var total_bytes: i64 = 0
    var iteration: i64 = 0
    while iteration < iterations:
        val wrote = file_write_text_at(path, total_bytes, chunk)
        if wrote != chunk.len():
            print("[iobench-error] lang=simple case=append_at reason=write")
            return 1
        total_bytes = total_bytes + wrote
        checksum = (checksum + chunk_checksum) % 2147483647
        iteration = iteration + 1
    report("append_at", total_bytes, iterations, checksum)
    0

fn main() -> i64:
    val root = env_get("IO_PARITY_ROOT")
    val mode = env_get("IO_PARITY_MODE")
    if root.len() == 0:
        print("[iobench-error] lang=simple reason=missing-root")
        return 2
    if mode == "contract":
        return contract(root + "/contract.bin", root + "/missing.bin")
    val iterations = positive_i64_or(env_get("IO_PARITY_ITERS"), 8)
    if mode == "read_text":
        return bench_read_text(root + "/payload.bin", iterations)
    if mode == "mmap_text":
        return bench_mmap_text(root + "/payload.bin", iterations)
    if mode == "append_at":
        return bench_append_at(env_get("IO_PARITY_OUTPUT"), iterations)
    print("[iobench-error] lang=simple reason=unsupported-mode mode={mode}")
    2
