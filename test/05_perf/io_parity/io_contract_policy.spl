"""
Shared observation predicate for the C/Pure-Simple file-I/O contract.

The six independent inputs are deliberately kept in one decision so coverage
can be exact and non-vacuous without pretending to cover runtime internals.
"""

pub fn io_contract_ok(open_ok: bool, missing_rejected: bool,
                      partial_len: i64, eof_len: i64,
                      exact_ok: bool, exact_short_rejected: bool) -> bool:
    if open_ok and missing_rejected and partial_len == 11 and eof_len == 0 and exact_ok and exact_short_rejected:
        return true
    false

export io_contract_ok
