"""Mapped checksum parity and raw-boundary call-count coverage."""

use std.spec
use std.nogc_sync_mut.ptr.raw.{raw_alloc, raw_release, raw_write_i64}
use test.perf.io_parity.mapped_checksum.{mapped_byte_checksum, mapped_checksum_read_calls}

fn expected_byte_at(index: i64) -> i64:
    if index < 8:
        1
    elif index < 16:
        3
    elif index < 24:
        7
    else:
        15

fn expected_checksum(start: i64, length: i64) -> i64:
    var checksum: i64 = 0
    var index: i64 = start
    while index < start + length:
        checksum = checksum + expected_byte_at(index)
        index = index + 1
    checksum

describe "I/O parity mapped checksum":
    """The Simple mmap row preserves exact byte semantics while reducing raw reads."""

    it "matches exact byte sums for lengths zero through seventeen at every eight-byte alignment":
        val ptr = raw_alloc(32)
        expect(ptr).to_be_greater_than(0)
        expect(ptr % 8).to_equal(0)
        raw_write_i64(ptr, 0, 0x0101010101010101)
        raw_write_i64(ptr, 8, 0x0303030303030303)
        raw_write_i64(ptr, 16, 0x0707070707070707)
        raw_write_i64(ptr, 24, 0x0F0F0F0F0F0F0F0F)

        var start: i64 = 0
        while start < 8:
            var length: i64 = 0
            while length <= 17:
                expect(mapped_byte_checksum(ptr + start, length)).to_equal(
                    expected_checksum(start, length))
                length = length + 1
            start = start + 1
        raw_release(ptr)

    it "counts aligned word reads and unaligned byte prefix and tail reads":
        val aligned = 4096
        expect(mapped_byte_checksum(0, 8)).to_equal(0)
        expect(mapped_checksum_read_calls(0, 8)).to_equal(0)
        expect(mapped_checksum_read_calls(aligned, 0)).to_equal(0)
        expect(mapped_checksum_read_calls(aligned, 1)).to_equal(1)
        expect(mapped_checksum_read_calls(aligned, 7)).to_equal(7)
        expect(mapped_checksum_read_calls(aligned, 8)).to_equal(1)
        expect(mapped_checksum_read_calls(aligned, 9)).to_equal(2)
        expect(mapped_checksum_read_calls(aligned, 15)).to_equal(8)
        expect(mapped_checksum_read_calls(aligned, 16)).to_equal(2)
        expect(mapped_checksum_read_calls(aligned, 17)).to_equal(3)
        expect(mapped_checksum_read_calls(aligned + 1, 17)).to_equal(10)
        expect(mapped_checksum_read_calls(aligned + 7, 17)).to_equal(3)

    it "reduces the canonical aligned fixture boundary calls by exactly eight times":
        val fixture_bytes: i64 = 16 * 1024 * 1024
        val iterations: i64 = 64
        val scalar_calls = fixture_bytes * iterations
        val packed_calls = mapped_checksum_read_calls(4096, fixture_bytes) * iterations
        expect(scalar_calls).to_equal(1073741824)
        expect(packed_calls).to_equal(134217728)
        expect(scalar_calls / packed_calls).to_equal(8)
