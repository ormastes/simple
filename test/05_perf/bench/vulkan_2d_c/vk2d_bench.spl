# Simple counterpart of test/05_perf/bench/vulkan_2d_c/vk2d_bench.c — identical workload:
# per frame = clear + N rect fills + submit + present + readback, F frames.
# Measures the Engine2D vulkan lane exactly as hosts drive it.
#
# Run:  SIMPLE_LIB=src VK_ICD_FILENAMES=.../MoltenVK_icd.json \
#       <vulkan-seed> run test/05_perf/bench/vulkan_2d_c/vk2d_bench.spl

use std.io_runtime.{time_now_unix_micros, read_file, file_write_bytes}
use app.io.mod.{env_get}
use gpu.engine2d.engine.{Engine2D}

fn _env_i32(key: text, fallback: i32) -> i32:
    val raw = env_get(key).trim()
    if raw == "":
        return fallback
    raw.to_int() ?? fallback

class Vk2dRect:
    var x: i32
    var y: i32
    var w: i32
    var h: i32
    var color: u32

# Parse one hex byte-quad ("FFF34DAD") into a u32 colour.
fn _hex_u32(h: text) -> u32:
    val digits = "0123456789ABCDEF"
    var v: i64 = 0
    var i = 0
    while i < h.len():
        val c = h.substring(i, i + 1).upper()
        val d = digits.index_of(c)
        if d < 0:
            return 0u32
        v = v * 16 + d.to_i64()
        i = i + 1
    v.to_i32().to_u32()

# Load the SHARED scene table. This is the one workload definition; the C leg
# loads the same file. Re-deriving the set per language is exactly how the two
# legs silently diverged before (i64 sign-masking vs u64 wraparound), so a
# missing table is a hard failure, never a silent fallback to a generated set
# that would not match C.
fn _rects_from_table(path: text, count: i32) -> [Vk2dRect]:
    var out: [Vk2dRect] = []
    val body = read_file(path)
    for line in body.split("\n"):
        val t = line.trim()
        if t == "" or t.starts_with("#"):
            continue
        if out.len().to_i32() >= count:
            continue
        val f = t.split(" ")
        if f.len() != 6 or f[0] != "rect":
            continue
        out.push(Vk2dRect(
            x: (f[1].to_int() ?? 0).to_i32(), y: (f[2].to_int() ?? 0).to_i32(),
            w: (f[3].to_int() ?? 0).to_i32(), h: (f[4].to_int() ?? 0).to_i32(),
            color: _hex_u32(f[5])))
    out

fn _rects(count: i32, fb_w: i32, fb_h: i32) -> [Vk2dRect]:
    """Same xorshift64 distribution as the C bench (sign-masked for modulo)."""
    var out: [Vk2dRect] = []
    var rng: i64 = 11400714819323198485
    var i = 0
    while i < count:
        rng = rng ^ ((rng << 13) & 0x7FFFFFFFFFFFFFFF)
        rng = rng ^ (rng >> 7)
        rng = rng ^ ((rng << 17) & 0x7FFFFFFFFFFFFFFF)
        if rng < 0:
            rng = 0 - rng
        val w = 24 + (rng % 160).to_i32()
        val h = 24 + ((rng >> 16) % 120).to_i32()
        val x = ((rng >> 8) % (fb_w - w).to_i64()).to_i32()
        val y = ((rng >> 24) % (fb_h - h).to_i64()).to_i32()
        val color = 0xFF000000u32 | (rng & 0xFFFFFF).to_i32().to_u32()
        out.push(Vk2dRect(x: x, y: y, w: w, h: h, color: color))
        i = i + 1
    out

class Vk2dBench:
    var engine: Engine2D
    var w: i32
    var h: i32

    me run(rects: [Vk2dRect], frames: i32, readback: bool) -> text:
        # Warmup: two full frames so JIT compilation and pipeline setup are
        # outside the measured region.
        var warm = 0
        while warm < 2:
            self.engine.clear(0xFF141414u32)
            for r in rects:
                self.engine.draw_rect_filled(r.x, r.y, r.w, r.h, r.color)
            self.engine.submit_batch()
            self.engine.present()
            warm = warm + 1
        var checksum: i64 = 0
        var draw_us: i64 = 0
        var batch_us: i64 = 0
        var present_us: i64 = 0
        var readback_us: i64 = 0
        val t0 = time_now_unix_micros()
        var frame = 0
        while frame < frames:
            var p0 = time_now_unix_micros()
            self.engine.clear(0xFF141414u32)
            for r in rects:
                self.engine.draw_rect_filled(r.x, r.y, r.w, r.h, r.color)
            var p1 = time_now_unix_micros()
            self.engine.submit_batch()
            var p15 = time_now_unix_micros()
            self.engine.present()
            var p2 = time_now_unix_micros()
            if readback:
                val rb = self.engine.read_pixels_with_source()
                # Fold a stride sample so the readback is real consumed work.
                var acc: i64 = 0
                var i: i64 = 0
                val n = rb.pixels.len()
                while i < n:
                    acc = acc ^ rb.pixels[i].to_i32().to_i64()
                    i = i + 4096
                checksum = checksum ^ acc
                # Raw framebuffer dump for the byte-for-byte comparator,
                # little-endian ARGB exactly as the C leg writes it.
                val dump_path = env_get("VK2D_DUMP_FB").trim()
                if dump_path != "":
                    var raw: [u8] = [0u8; n * 4]
                    var k: i64 = 0
                    while k < n:
                        val pv = rb.pixels[k].to_i32().to_i64() & 0xFFFFFFFF
                        val o = k * 4
                        raw[o] = (pv & 255).to_i32().to_u8()
                        raw[o + 1] = ((pv >> 8) & 255).to_i32().to_u8()
                        raw[o + 2] = ((pv >> 16) & 255).to_i32().to_u8()
                        raw[o + 3] = ((pv >> 24) & 255).to_i32().to_u8()
                        k = k + 1
                    if file_write_bytes(dump_path, raw):
                        print "dump: wrote {n * 4} bytes to {dump_path}"
                if _env_i32("VK2D_DEBUG", 0) == 1:
                    var nonzero: i64 = 0
                    var nonclear: i64 = 0
                    var j: i64 = 0
                    while j < n:
                        val pv = rb.pixels[j].to_i32().to_i64() & 0xFFFFFFFF
                        if pv != 0:
                            nonzero = nonzero + 1
                        if pv != 4279505940:
                            nonclear = nonclear + 1
                        j = j + 1
                    print "debug: px0={rb.pixels[0].to_i32().to_i64() & 0xFFFFFFFF} nonzero={nonzero}/{n} nonclear={nonclear} src={rb.source}"
            var p3 = time_now_unix_micros()
            draw_us = draw_us + (p1 - p0)
            batch_us = batch_us + (p15 - p1)
            present_us = present_us + (p2 - p15)
            readback_us = readback_us + (p3 - p2)
            frame = frame + 1
        val t1 = time_now_unix_micros()
        val ms = (t1 - t0) / 1000
        var fps_num: i64 = 0
        if ms > 0:
            fps_num = frames.to_i64() * 1000 / ms
        "simple-vulkan-2d w={self.w} h={self.h} rects={rects.len()} frames={frames} readback={readback} ms={ms} fps~={fps_num} draw_us={draw_us} batch_us={batch_us} present_us={present_us} readback_us={readback_us} checksum={checksum}"

fn _loop_probe(w: i32, h: i32):
    """Time the three O(pixels) marshalling loop shapes from the engine's
    present/readback path, standalone, no GPU. 20 reps each."""
    val count = w.to_i64() * h.to_i64()
    val bytes: [u8] = [0x11u8; count * 4]
    val src: [u32] = [0xFF141414u32; count]
    var dst: [u32] = [0u32; count]
    var acc: i64 = 0

    # 1. _bytes_to_pixel_array shape: 4 byte loads + combine per pixel
    var t0 = time_now_unix_micros()
    var rep = 0
    while rep < 20:
        var i: i64 = 0
        while i < count:
            val off = i * 4
            val b0 = bytes[off].to_i64()
            val b1 = bytes[off + 1].to_i64()
            val b2 = bytes[off + 2].to_i64()
            val b3 = bytes[off + 3].to_i64()
            dst[i] = (b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)).to_i32().to_u32()
            i = i + 1
        rep = rep + 1
    val t_unpack = (time_now_unix_micros() - t0) / 20

    # 2. host_buf copy shape: one load + one store per pixel
    t0 = time_now_unix_micros()
    rep = 0
    while rep < 20:
        var i: i64 = 0
        while i < count:
            dst[i] = src[i]
            i = i + 1
        rep = rep + 1
    val t_copy = (time_now_unix_micros() - t0) / 20

    # 3. engine2d_readback_with_identity checksum shape: add + modulo per pixel
    t0 = time_now_unix_micros()
    rep = 0
    while rep < 20:
        var checksum: i64 = 0
        var i: i64 = 0
        while i < count:
            checksum = (checksum + src[i].to_i64()) % 2147483647
            i = i + 1
        acc = acc ^ checksum
        rep = rep + 1
    val t_checksum = (time_now_unix_micros() - t0) / 20
    # 4. per-frame fresh [u32] allocation shape (what the readback facade does)
    t0 = time_now_unix_micros()
    rep = 0
    var sink: i64 = 0
    while rep < 20:
        var fresh: [u32] = [0u32; count]
        sink = sink + fresh.len().to_i64()
        rep = rep + 1
    val t_alloc = (time_now_unix_micros() - t0) / 20
    print "loop-probe alloc_us={t_alloc} sink={sink}"
    print "loop-probe w={w} h={h} unpack_us={t_unpack} copy_us={t_copy} checksum_us={t_checksum} acc={acc} dst0={dst[0]}"

fn main():
    val w = _env_i32("VK2D_W", 800)
    val h = _env_i32("VK2D_H", 600)
    val rect_count = _env_i32("VK2D_RECTS", 64)
    val frames = _env_i32("VK2D_FRAMES", 300)
    val readback = _env_i32("VK2D_READBACK", 1) == 1

    if _env_i32("VK2D_PROBE", 0) == 1:
        _loop_probe(w, h)
        return
    # VK2D_BACKEND lets the same scene run on another backend, which is what
    # makes the Simple-vs-Simple parity check possible: the 16 emu_* primitives
    # share CPU code between backends, so any cpu-vs-vulkan divergence is
    # confined to the ~13 GPU-native ones.
    var backend = env_get("VK2D_BACKEND").trim()
    if backend == "":
        backend = "vulkan"
    val engine = Engine2D.create_with_backend_fast(w, h, backend)
    if engine.backend_name() != backend:
        print "simple-vulkan-2d status=blocked reason=backend-unavailable requested={backend} got={engine.backend_name()}"
        engine.shutdown()
        return
    val bench = Vk2dBench(engine: engine, w: w, h: h)
    # Prefer the SHARED table so this leg renders exactly what C renders.
    # VK2D_SCENES="" opts back into the legacy generated set, which does NOT
    # match C and is therefore only valid for throughput, never for a pixel
    # comparison.
    var scenes_path = env_get("VK2D_SCENES").trim()
    if scenes_path == "":
        scenes_path = "test/05_perf/bench/vulkan_2d_c/scenes.txt"
    var rects = _rects(rect_count, w, h)
    var scene_source = "generated-unmatched"
    if scenes_path != "":
        val from_table = _rects_from_table(scenes_path, rect_count)
        if from_table.len() > 0:
            rects = from_table
            scene_source = "table"
        else:
            print "simple-vulkan-2d status=blocked reason=scene-table-unreadable path={scenes_path}"
            return
    print "scene_source={scene_source} rects={rects.len()}"
    print bench.run(rects, frames, readback)
    engine.shutdown()
