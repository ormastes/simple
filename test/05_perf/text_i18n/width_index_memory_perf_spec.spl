"""WidthIndex build/query/free latency and memory smoke."""
# @tag: perf, memory, text, unicode, index

use std.spec.*
use std.io_runtime.{time_now_unix_micros, file_read}
use std.encoding.width_index.{WidthIndex}

fn width_perf_text(count: i64) -> text:
    var parts: [text] = []
    var i: i64 = 0
    while i < count:
        if i % 4 == 0: parts.push("A")
        elif i % 4 == 1: parts.push("é")
        elif i % 4 == 2: parts.push("한")
        else: parts.push("😀")
        i = i + 1
    "".join(parts)

fn width_perf_hwm_kib() -> i64:
    val status = file_read("/proc/self/status")
    for line in status.split("\n"):
        if line.starts_with("VmHWM:"):
            var value: i64 = 0
            var seen = false
            var i: i64 = 0
            while i < line.len():
                val code = line.char_code_at(i)
                if code >= 48 and code <= 57:
                    value = value * 10 + code - 48
                    seen = true
                else:
                    if seen: return value
                i = i + 1
            if seen: return value
    0

fn width_perf_percentiles(samples: [i64]) -> [i64]:
    var ordered = samples
    ordered.sort()
    [ordered[ordered.len() / 2], ordered[ordered.len() - 1]]

describe "WidthIndex memory performance":
    """Exercises repeated index creation, random ordinal queries, and cleanup."""

    it "builds queries and frees a multilingual index across seven samples":
        val value = width_perf_text(4096)
        var samples: [i64] = []
        var checksum: i64 = 0
        var sample: i64 = 0
        while sample < 7:
            val started = time_now_unix_micros()
            val index = WidthIndex.for_text(value)
            var i: i64 = 0
            while i < 512:
                val ordinal = (i * 37) % 4096
                checksum = checksum + index.char_to_byte(ordinal)
                checksum = checksum + index.byte_to_char(ordinal)
                i = i + 1
            index.free()
            expect(index.mode).to_equal("freed")
            samples.push(time_now_unix_micros() - started)
            sample = sample + 1
        val latency = width_perf_percentiles(samples)
        val hwm = width_perf_hwm_kib()
        expect(latency[1]).to_be_less_than(5000001)
        expect(hwm).to_be_greater_than(0)
        expect(checksum).to_be_greater_than(0)
        print "text_perf operation=width_index_build_query_free samples=7" +
            " input_scalars=4096 input_bytes={value.len()} queries=7168" +
            " p50_us={latency[0]} p95_us={latency[1]} process_hwm_kib={hwm}" +
            " allocation_count=unavailable allocated_bytes=unavailable" +
            " index_bytes=unavailable post_free_retained_bytes=unavailable" +
            " checksum={checksum}"
