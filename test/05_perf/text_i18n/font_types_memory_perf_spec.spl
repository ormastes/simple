"""Shared font configuration planning and identity memory-performance smoke."""
# @tag: perf, memory, text-rendering, font

use std.spec.*
use std.io_runtime.{time_now_unix_micros, file_read}
use std.nogc_sync_mut.text_layout.font_types.{
    FontExecutionPolicy, FontRenderConfig, font_execution_plan_into,
    font_render_config_identity}

fn perf_config() -> FontRenderConfig:
    FontRenderConfig(family: "Noto Sans", category: "sans", language: "ko",
        script: "hang", size: 18, weight: "normal", style: "normal",
        hinting: "none", antialiasing: "grayscale",
        atlas_policy: "shared-alpha-1024", execution_target: "vulkan",
        execution_policy: FontExecutionPolicy.Suggested)

fn perf_hwm_kib() -> i64:
    val status = file_read("/proc/self/status")
    for line in status.split("\n"):
        if line.starts_with("VmHWM:"):
            var value: i64 = 0
            var seen = false
            var i: i64 = 0
            while i < line.len():
                val code = line.char_code_at(i)
                if code >= 48 and code <= 57:
                    value = value * 10 + code - 48
                    seen = true
                else:
                    if seen: return value
                i = i + 1
            if seen: return value
    0

fn perf_percentiles(samples: [i64]) -> [i64]:
    var ordered = samples
    ordered.sort()
    [ordered[ordered.len() / 2], ordered[ordered.len() - 1]]

describe "font configuration memory performance":
    it "reports bounded planning and identity construction with explicit memory availability":
        val config = perf_config()
        val targets = ["cuda", "metal", "vulkan", "cpu"]
        var samples: [i64] = []
        var checksum: i64 = 0
        var sample: i64 = 0
        while sample < 7:
            val started = time_now_unix_micros()
            var iteration: i64 = 0
            while iteration < 256:
                var plan: [text] = []
                val count = font_execution_plan_into(config, targets, plan)
                val identity = font_render_config_identity(config)
                checksum = checksum + count + plan.len() + identity.len()
                iteration = iteration + 1
            samples.push(time_now_unix_micros() - started)
            sample = sample + 1
        val latency = perf_percentiles(samples)
        val hwm = perf_hwm_kib()
        expect(latency[1]).to_be_less_than(1000001)
        expect(hwm).to_be_greater_than(0)
        expect(checksum).to_be_greater_than(0)
        print "text_perf operation=font_types_config samples=7 iterations=1792" +
            " targets=4 p50_us={latency[0]} p95_us={latency[1]}" +
            " process_hwm_kib={hwm} allocation_count=unavailable" +
            " allocated_bytes=unavailable retained_bytes=unavailable" +
            " linked_data_bytes=unavailable checksum={checksum}"
