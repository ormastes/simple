"""
## Simple lexer memory performance

Measures the production `CoreLexer`, including its current `source.chars()`
materialization. Corpora are constructed before snapshots. Each scan is capped
and must reach the real EOF token, preventing a dead lexer from masquerading as
performance evidence.
"""

# @req: NFR-005
# @tag: perf, memory, lexer, utf8, i18n
# @cover src/compiler/10.frontend/core/lexer_struct.spl 51%

use std.spec.*
use compiler.frontend.core.lexer_struct.{
    CoreLexer, make_core_lexer, core_lexer_next_token, core_lexer_token_text
}
use compiler.frontend.core.tokens.{TOK_EOF}

extern fn rt_heap_live_bytes() -> i64
extern fn rt_heap_aux_live_bytes() -> i64
extern fn rt_heap_array_capacity_bytes() -> i64

struct MemorySnapshot:
    live_bytes: i64
    aux_bytes: i64
    capacity_bytes: i64

struct LexReceipt:
    tokens: i64
    checksum: i64
    reached_eof: bool

fn snapshot() -> MemorySnapshot:
    MemorySnapshot(
        live_bytes: rt_heap_live_bytes(),
        aux_bytes: rt_heap_aux_live_bytes(),
        capacity_bytes: rt_heap_array_capacity_bytes())

fn growth(after: i64, before: i64) -> i64:
    if after >= before: after - before else: 0

fn counters_available(value: MemorySnapshot) -> bool:
    value.live_bytes > 0 or value.aux_bytes > 0 or value.capacity_bytes > 0

fn lex_receipt(source: text, cap: i64) -> LexReceipt:
    var lexer: CoreLexer = make_core_lexer(source)
    var tokens: i64 = 0
    var checksum: i64 = 0
    var reached_eof = false
    while tokens < cap:
        val next = core_lexer_next_token(lexer)
        lexer = next.0
        val kind = next.1
        checksum = checksum + kind + core_lexer_token_text(lexer).len()
        tokens = tokens + 1
        if kind == TOK_EOF:
            reached_eof = true
            break
        if kind == 0:
            break
    LexReceipt(tokens: tokens, checksum: checksum, reached_eof: reached_eof)

fn ascii_source() -> text:
    var source = ""
    var i: i64 = 0
    while i < 128:
        source = source + "val item_" + i.to_text() + " = " + i.to_text() + "\n"
        i = i + 1
    source

fn multilingual_source() -> text:
    var source = ""
    var i: i64 = 0
    while i < 64:
        source = source + "val message_" + i.to_text() + " = \"한국어 العربية हिन्दी 😀\"\n"
        i = i + 1
    source

fn i18n_source() -> text:
    val open = "{{name}}"
    var source = ""
    var i: i64 = 0
    while i < 64:
        source = source + "val localized_" + i.to_text() +
            " = Welcome_\"Hello, " + open + "!\"\n"
        i = i + 1
    source

fn syntax_stress_source() -> text:
    "# comment\n" +
    "fn main(arg: i64 = 0x2A):\n" +
    "    val binary = 0b1010\n" +
    "    val octal = 0o755\n" +
    "    val decimal = 12_345.67e-2\n" +
    "    val raw = r\"raw {{ brace }}\"\n" +
    "    val items = [1, 2, 3]\n" +
    "    val mapping = {{\"key\": true}}\n" +
    "    if arg >= 1 and arg != 2:\n" +
    "        return items[0] + 1\n" +
    "    elif arg <= 0 or not false:\n" +
    "        return mapping[\"key\"]\n" +
    "    else:\n" +
    "        return nil\n"

fn lexer_edge_probes() -> [text]:
    [
        "", "   ", "\t\t", "\n", "name", "_private", "name_2",
        "0", "123", "0xFF", "0b101", "0o77", "1.25", "1e3", "1_000",
        "'x'", "\"escaped\\ntext\"", "r\"raw text\"",
        "# hash comment\n", "// slash comment\n", "/* block comment */",
        "() [] {{}} , : ; . @ $",
        "+ - * ** / // % = == => -> < <= << > >= >>",
        "& && | || ^ ~ ! != ? ??",
        "if true:\n    pass\nelse:\n    return nil\n",
        "call(a=1, b=[2, 3])\n",
        "val s = \"{{x + 1}}\"\n",
        "Label_: loop:\n    break Label_\n"
    ]

fn check_memory_scan(label: text, source: text, cap: i64):
    val before = snapshot()
    val receipt = lex_receipt(source, cap)
    val after = snapshot()
    val retained = growth(after.live_bytes, before.live_bytes)
    val auxiliary = growth(after.aux_bytes, before.aux_bytes)
    val capacity = growth(after.capacity_bytes, before.capacity_bytes)
    expect(receipt.reached_eof).to_equal(true)
    expect(receipt.tokens).to_be_greater_than(1)
    expect(receipt.checksum).to_be_greater_than(0)
    expect(retained + auxiliary + capacity).to_be_less_than(268435457)
    val status = if counters_available(after): "measured" else: "unavailable"
    print "text_memory operation=lexer_scan corpus={label} counter_status={status} source_utf8_bytes={source.len()} tokens={receipt.tokens} allocation_count=unavailable retained_growth_bytes={retained} aux_growth_bytes={auxiliary} capacity_growth_bytes={capacity} process_hwm_kib=unavailable checksum={receipt.checksum}"

describe "Simple lexer memory performance":
    it "records ASCII source materialization and scan growth":
        check_memory_scan("ascii", ascii_source(), 4096)

    it "records multilingual string materialization and scan growth":
        check_memory_scan("multilingual", multilingual_source(), 4096)

    it "records named i18n interpolation materialization and scan growth":
        check_memory_scan("i18n", i18n_source(), 4096)

    it "records broad syntax and indentation scan growth":
        check_memory_scan("syntax-stress", syntax_stress_source(), 4096)

    it "keeps the lexical edge-probe matrix finite and EOF-complete":
        val probes = lexer_edge_probes()
        var token_total: i64 = 0
        var checksum: i64 = 0
        for source in probes:
            val receipt = lex_receipt(source, 512)
            expect(receipt.reached_eof).to_equal(true)
            token_total = token_total + receipt.tokens
            checksum = checksum + receipt.checksum
        expect(probes.len()).to_be_greater_than(20)
        expect(token_total).to_be_greater_than(probes.len())
        expect(checksum).to_be_greater_than(0)
        print "text_memory operation=lexer_edge_matrix probes={probes.len()} tokens={token_total} checksum={checksum} allocation_count=unavailable process_hwm_kib=unavailable"
