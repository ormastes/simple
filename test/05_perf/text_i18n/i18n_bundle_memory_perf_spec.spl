"""
## Resource-bundle memory performance

Separates catalog construction from lookup/formatting measurement. Receipts
include catalog entries/UTF-8 bytes, iterations, output bytes, and runtime-owned
memory growth. All-zero counters mean unavailable, never zero allocation.
"""

# @req: NFR-005
# @tag: perf, memory, i18n, utf8

use std.spec.*
use std.i18n.bundle.{ResourceBundle}

extern fn rt_heap_live_bytes() -> i64
extern fn rt_heap_aux_live_bytes() -> i64
extern fn rt_heap_array_capacity_bytes() -> i64

struct MemorySnapshot:
    live_bytes: i64
    aux_bytes: i64
    capacity_bytes: i64

fn snapshot() -> MemorySnapshot:
    MemorySnapshot(
        live_bytes: rt_heap_live_bytes(),
        aux_bytes: rt_heap_aux_live_bytes(),
        capacity_bytes: rt_heap_array_capacity_bytes())

fn growth(after: i64, before: i64) -> i64:
    if after >= before: after - before else: 0

fn counters_available(value: MemorySnapshot) -> bool:
    value.live_bytes > 0 or value.aux_bytes > 0 or value.capacity_bytes > 0

fn token(name: text) -> text:
    "{" + name + "}"

fn measured_bundle() -> ResourceBundle:
    ResourceBundle(
        locale: "ar",
        messages: {
            "welcome": "مرحبًا " + token("name") + "، لديك " + token("count") + " رسائل",
            "status": "جاهز",
            "shared": "محلي"
        },
        fallback_messages: {
            "fallback": "Fallback " + token("name"),
            "shared": "default"
        })

fn catalog_utf8_bytes(bundle: ResourceBundle) -> i64:
    var total: i64 = 0
    for key in bundle.messages.keys():
        total = total + key.len() + bundle.messages[key].len()
    for key in bundle.fallback_messages.keys():
        total = total + key.len() + bundle.fallback_messages[key].len()
    total

describe "i18n bundle memory performance":
    it "records repeated borrowed lookup growth":
        val bundle = measured_bundle()
        val entries = bundle.messages.keys().len() + bundle.fallback_messages.keys().len()
        val catalog_bytes = catalog_utf8_bytes(bundle)
        val before = snapshot()
        var checksum: i64 = 0
        var i: i64 = 0
        while i < 4096:
            checksum = checksum + bundle.get(if i % 2 == 0: "status" else: "fallback").len()
            i = i + 1
        val after = snapshot()
        val retained = growth(after.live_bytes, before.live_bytes)
        val auxiliary = growth(after.aux_bytes, before.aux_bytes)
        val capacity = growth(after.capacity_bytes, before.capacity_bytes)
        expect(checksum).to_be_greater_than(0)
        expect(retained + auxiliary + capacity).to_be_less_than(16777217)
        val status = if counters_available(after): "measured" else: "unavailable"
        print "text_memory operation=i18n_lookup counter_status={status} iterations=4096 catalog_entries={entries} catalog_utf8_bytes={catalog_bytes} allocation_count=unavailable retained_growth_bytes={retained} aux_growth_bytes={auxiliary} capacity_growth_bytes={capacity} process_hwm_kib=unavailable checksum={checksum}"

    it "records repeated multilingual formatting growth":
        val bundle = measured_bundle()
        val params = {"name": "ليلى", "count": "١٢"}
        val before = snapshot()
        var output_bytes: i64 = 0
        var i: i64 = 0
        while i < 512:
            output_bytes = output_bytes + bundle.get_fmt("welcome", params).len()
            i = i + 1
        val after = snapshot()
        val retained = growth(after.live_bytes, before.live_bytes)
        val auxiliary = growth(after.aux_bytes, before.aux_bytes)
        val capacity = growth(after.capacity_bytes, before.capacity_bytes)
        expect(output_bytes).to_be_greater_than(0)
        expect(retained + auxiliary + capacity).to_be_less_than(67108865)
        val status = if counters_available(after): "measured" else: "unavailable"
        print "text_memory operation=i18n_format counter_status={status} iterations=512 arguments=2 output_bytes={output_bytes} allocation_count=unavailable retained_growth_bytes={retained} aux_growth_bytes={auxiliary} capacity_growth_bytes={capacity} process_hwm_kib=unavailable"
