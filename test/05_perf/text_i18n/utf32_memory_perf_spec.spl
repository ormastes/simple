"""
## UTF-32 memory-performance evidence

Measures UTF-32 endian roundtrip and UTF-32-to-UTF-8 conversion independently
from corpus construction. Runtime-owned counters and process HWM are printed as
typed evidence. An all-zero runtime snapshot means `unavailable`, never zero
allocation. A controlled matched host is still required for release comparison.
"""

# @req: NFR-005
# @tag: perf, memory, text, utf32

use std.spec.*
use std.common.encoding.utf32.{
    utf32_to_bytes_le, utf32_from_bytes_le, utf32_to_utf8
}

extern fn rt_heap_live_bytes() -> i64
extern fn rt_heap_aux_live_bytes() -> i64
extern fn rt_heap_array_capacity_bytes() -> i64

struct MemorySnapshot:
    live_bytes: i64
    aux_bytes: i64
    capacity_bytes: i64

fn snapshot() -> MemorySnapshot:
    MemorySnapshot(
        live_bytes: rt_heap_live_bytes(),
        aux_bytes: rt_heap_aux_live_bytes(),
        capacity_bytes: rt_heap_array_capacity_bytes())

fn growth(after: i64, before: i64) -> i64:
    if after >= before: after - before else: 0

fn counters_available(value: MemorySnapshot) -> bool:
    value.live_bytes > 0 or value.aux_bytes > 0 or value.capacity_bytes > 0

fn utf32_memory_corpus() -> [i64]:
    val pattern: [i64] = [0x41, 0xE9, 0xD55C, 0x4F60, 0x1F600]
    var values: [i64] = []
    while values.len() < 8190:
        values.extend(pattern)
    values

describe "UTF-32 memory performance":
    it "records endian roundtrip workspace and retained growth":
        val values = utf32_memory_corpus()
        val before = snapshot()
        val bytes = utf32_to_bytes_le(values)
        val restored = utf32_from_bytes_le(bytes)
        val after = snapshot()
        expect(restored).to_equal(values)
        val retained = growth(after.live_bytes, before.live_bytes)
        val auxiliary = growth(after.aux_bytes, before.aux_bytes)
        val capacity = growth(after.capacity_bytes, before.capacity_bytes)
        expect(retained + auxiliary + capacity).to_be_less_than(134217729)
        val status = if counters_available(after): "measured" else: "unavailable"
        print "text_memory operation=utf32_le_roundtrip counter_status={status} input_scalars={values.len()} serialized_bytes={bytes.len()} allocation_count=unavailable retained_growth_bytes={retained} aux_growth_bytes={auxiliary} capacity_growth_bytes={capacity} process_hwm_kib=unavailable"

    it "records UTF-32-to-UTF-8 workspace and retained growth":
        val values = utf32_memory_corpus()
        val before = snapshot()
        val encoded = utf32_to_utf8(values)
        val after = snapshot()
        expect(encoded.len()).to_be_greater_than(values.len())
        val retained = growth(after.live_bytes, before.live_bytes)
        val auxiliary = growth(after.aux_bytes, before.aux_bytes)
        val capacity = growth(after.capacity_bytes, before.capacity_bytes)
        expect(retained + auxiliary + capacity).to_be_less_than(134217729)
        val status = if counters_available(after): "measured" else: "unavailable"
        print "text_memory operation=utf32_to_utf8 counter_status={status} input_scalars={values.len()} output_bytes={encoded.len()} allocation_count=unavailable retained_growth_bytes={retained} aux_growth_bytes={auxiliary} capacity_growth_bytes={capacity} process_hwm_kib=unavailable"
