use fixtures.heavy_import_module.{push_and_call_loop}
extern fn rt_time_now_ms() -> i64

# doc/08_tracking/bug/bootstrap_main_native_build_stalls_after_source_closure_2026-08-21.md
# (second root cause, 2026-08-21). A loop that both grows a frame-local array
# (`out = out.push(x)`) and calls a module fn paid a full callee-env rebuild on
# every call: the method-call self-update write-through took an unconditional
# `borrow_mut()` on MODULE_GLOBALS, which bumps the env-cache generation.
# Pre-fix: 2000 iterations ~3 s; post-fix ~50 ms. Budget 10x above post-fix.
describe "seed interpreter: array push + module call loop":
    it "does not invalidate the env template on every local push":
        val t0 = rt_time_now_ms()
        val acc = push_and_call_loop(2000)
        val elapsed = rt_time_now_ms() - t0
        expect(acc).to_equal(2000)
        expect("{elapsed}ms < 600ms: {elapsed < 600}").to_equal("{elapsed}ms < 600ms: true")
