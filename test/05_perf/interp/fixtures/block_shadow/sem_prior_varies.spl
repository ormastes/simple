# Fixture for test/05_perf/interp/block_scope_shadow_parity_spec.spl.
# Run standalone under SIMPLE_EXECUTION_MODE=interpreter; prints one
# machine-readable RESULT line. Do not edit without updating that spec.

# The pre-block value of a shadowed name DIFFERS on every iteration, so a
# capture that memoised it would be wrong. Outer `t` is bumped each iteration
# before the shadowing block runs; after the block `t` must be the outer value
# again, never the shadowed 100.
extern fn rt_time_now_unix_micros() -> i64

fn main():
    var t = 0
    var acc = 0
    var i = 0
    while i < 10:
        t = t + 1
        if i >= 0:
            var t = 100
            acc = acc + 0 * t
        acc = acc + t
        i = i + 1
    print("RESULT elapsed_us=0 acc={acc}:{t} iters={i}")
