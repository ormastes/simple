# Fixture for test/05_perf/interp/block_scope_shadow_parity_spec.spl.
# Run standalone under SIMPLE_EXECUTION_MODE=interpreter; prints one
# machine-readable RESULT line. Do not edit without updating that spec.

# A block-local `val` shadowing a MODULE GLOBAL that a callee mutates during
# the block. The restore path must publish the global's post-block value, not
# the stale pre-block snapshot -- that is the whole reason the owner-store
# probe exists. `g` is the module global; `bump()` writes it from another
# frame while `g` is shadowed.
extern fn rt_time_now_unix_micros() -> i64

var g = 5

fn bump():
    g = g + 1

fn main():
    var acc = 0
    var i = 0
    while i < 4:
        if i >= 0:
            val g = 1000
            acc = acc + 0 * g
            bump()
        acc = acc + g
        i = i + 1
    print("RESULT elapsed_us=0 acc={acc}:{g} iters={i}")
