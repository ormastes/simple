# Fixture for test/05_perf/interp/block_scope_shadow_parity_spec.spl.
# Run standalone under SIMPLE_EXECUTION_MODE=interpreter; prints one
# machine-readable RESULT line. Do not edit without updating that spec.

# Multi-name declaration: the destructuring arm of the capture, which is the
# only path that still allocates a scratch vector. Both names must be scoped to
# the block and both must be restored.
extern fn rt_time_now_unix_micros() -> i64

fn pair(i: i64) -> (i64, i64):
    (i, i + 1)

fn main():
    var a = 7
    var b = 8
    var acc = 0
    var i = 0
    while i < 10:
        if i >= 0:
            val (a, b) = pair(i)
            acc = acc + a + b
        acc = acc + a + b
        i = i + 1
    print("RESULT elapsed_us=0 acc={acc}:{a}:{b} iters={i}")
