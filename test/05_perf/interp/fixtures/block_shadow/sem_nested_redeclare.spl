# Fixture for test/05_perf/interp/block_scope_shadow_parity_spec.spl.
# Run standalone under SIMPLE_EXECUTION_MODE=interpreter; prints one
# machine-readable RESULT line. Do not edit without updating that spec.

# A nested block redeclaring an OUTER name must not leak past the block:
# bug doc/08_tracking/bug/interpreter_nested_block_var_redeclare_leaks_scope_2026-07-17.md.
# Expected acc trace: outer x stays 1 across every iteration, so the loop sees
# 1 ten times (10) and the inner value 99 is never visible after the block.
extern fn rt_time_now_unix_micros() -> i64

fn main():
    var x = 1
    var acc = 0
    var i = 0
    while i < 10:
        if i >= 0:
            val x = 99
            acc = acc + 0 * x
        acc = acc + x
        i = i + 1
    print("RESULT elapsed_us=0 acc={acc}:{x} iters={i}")
