# Fixture for test/05_perf/interp/block_scope_shadow_parity_spec.spl.
# Run standalone under SIMPLE_EXECUTION_MODE=interpreter; prints one
# machine-readable RESULT line. Do not edit without updating that spec.

# The same name declared TWICE in one block. Only the FIRST declaration may be
# captured: the second sees the first's value, not the enclosing scope's. This
# is what the dropped `seen` HashSet enforced and what the linear scan must
# still enforce.
extern fn rt_time_now_unix_micros() -> i64

fn main():
    var d = 3
    var acc = 0
    var i = 0
    while i < 10:
        if i >= 0:
            val d = 20
            acc = acc + d
            val d = 300
            acc = acc + d
        acc = acc + d
        i = i + 1
    print("RESULT elapsed_us=0 acc={acc}:{d} iters={i}")
