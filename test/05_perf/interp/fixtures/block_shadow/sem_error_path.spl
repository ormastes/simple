# Fixture for test/05_perf/interp/block_scope_shadow_parity_spec.spl.
# Run standalone under SIMPLE_EXECUTION_MODE=interpreter; prints one
# machine-readable RESULT line. Do not edit without updating that spec.

# The ERROR path: a block that declares a name and then leaves through a
# `break` / early `return` (the two non-fallthrough exits `exec_block` handles
# separately from normal exit) must still restore the shadow. If restore were
# skipped on those exits, `e` would leak out of the block and the trailing read
# would see 42 instead of the outer 9.
extern fn rt_time_now_unix_micros() -> i64

fn leaves_early(i: i64) -> i64:
    var e = 9
    var k = 0
    while k < 3:
        if k == i:
            val e = 42
            break
        k = k + 1
    e

fn main():
    var acc = 0
    var i = 0
    while i < 4:
        acc = acc + leaves_early(i)
        i = i + 1
    print("RESULT elapsed_us=0 acc={acc}:0 iters={i}")
