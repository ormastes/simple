# SEMANTICS: a module global written through a cross-module call must be
# visible to the next call and to a direct read. This is the work the
# call-entry publish exists to do; a superset that lost a name would show up
# here as a stale read, and PUBLISHED would be 0.
extern fn rt_time_now_unix_micros() -> i64
use modlib.counter_mod.add_to_total
use modlib.counter_mod.read_total
fn main():
    val n = 200
    var i = 0
    var last = 0
    val t0 = rt_time_now_unix_micros()
    while i < n:
        last = add_to_total(2)
        i = i + 1
    val elapsed = rt_time_now_unix_micros() - t0
    val direct = read_total()
    print("RESULT elapsed_us={elapsed} acc={last}:{direct} iters={i}")
