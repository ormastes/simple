# SEMANTICS + anti-vacuity: the shape the call-entry publish exists for.
# `g` is a module global this file's own `main` WRITES, so it sits in the
# CALLING frame's overlay as a non-local alias and must be published to the
# global store before each call, or `read_g()` reads a stale value.
extern fn rt_time_now_unix_micros() -> i64

var g: i64 = 0

fn read_g() -> i64:
    g

fn main():
    val n = 200
    var i = 0
    var seen = 0
    val t0 = rt_time_now_unix_micros()
    while i < n:
        g = g + 1
        seen = read_g()
        i = i + 1
    val elapsed = rt_time_now_unix_micros() - t0
    print("RESULT elapsed_us={elapsed} acc={seen}:{g} iters={i}")
