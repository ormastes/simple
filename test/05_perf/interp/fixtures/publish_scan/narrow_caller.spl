# NARROW caller: three locals live in the calling frame while the call runs.
extern fn rt_time_now_unix_micros() -> i64
use modlib.counter_mod.ModCounter
fn main():
    val n = 400000
    var c = ModCounter(count: 0)
    var i = 0
    val t0 = rt_time_now_unix_micros()
    while i < n:
        c.bump()
        i = i + 1
    val elapsed = rt_time_now_unix_micros() - t0
    print("RESULT elapsed_us={elapsed} sink={c.value()} iters={i}")
