# WIDE caller: the SAME call, with twenty more locals in the calling frame.
# Byte-for-byte the same loop and the same callee; only the caller's frame
# width differs, which is the whole point.
extern fn rt_time_now_unix_micros() -> i64
use modlib.counter_mod.ModCounter
fn main():
    val n = 400000
    var c = ModCounter(count: 0)
    val p01 = 1
    val p02 = 2
    val p03 = 3
    val p04 = 4
    val p05 = 5
    val p06 = 6
    val p07 = 7
    val p08 = 8
    val p09 = 9
    val p10 = 10
    val p11 = 11
    val p12 = 12
    val p13 = 13
    val p14 = 14
    val p15 = 15
    val p16 = 16
    val p17 = 17
    val p18 = 18
    val p19 = 19
    val p20 = 20
    var i = 0
    val t0 = rt_time_now_unix_micros()
    while i < n:
        c.bump()
        i = i + 1
    val elapsed = rt_time_now_unix_micros() - t0
    val guard = p01 + p20
    print("RESULT elapsed_us={elapsed} sink={c.value()} iters={i} guard={guard}")
