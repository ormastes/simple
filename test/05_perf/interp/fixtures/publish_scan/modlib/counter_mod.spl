# Module-owned class + a module global, so a call into it exercises the
# owner-globals path the call-entry publish exists for.
var mod_total: i64 = 0

class ModCounter:
    count: i64
    me bump(self):
        self.count = self.count + 1
    fn value(self) -> i64:
        self.count

fn add_to_total(n: i64) -> i64:
    mod_total = mod_total + n
    return mod_total

fn read_total() -> i64:
    mod_total
