# Fixture for test/05_perf/interp/while_loop_shape_parity_spec.spl.
# Run standalone under SIMPLE_EXECUTION_MODE=interpreter; prints one
# machine-readable result line. Do not edit without updating that spec.

# The helper body reads a module-level global, not only its parameters.
# Inlining it into the caller frame would resolve BIAS against the CALLER
# environment, so the matcher must decline and the generic walk must run.
val BIAS = 7

fn biased(a: i64, b: i64) -> i64:
    a + BIAS

fn main():
    var acc = 0
    var i = 0
    while i < 1000:
        acc = acc + biased(i, 0)
        i = i + 1
    print "RESULT elapsed_us=0 acc={acc} iters={i}"
