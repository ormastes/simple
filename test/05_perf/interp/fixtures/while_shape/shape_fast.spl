# Fixture for test/05_perf/interp/while_loop_shape_parity_spec.spl.
# Run standalone under SIMPLE_EXECUTION_MODE=interpreter; prints one
# machine-readable result line. Do not edit without updating that spec.

extern fn rt_time_now_unix_micros() -> i64

fn add(a: i64, b: i64) -> i64:
    a + b

fn main():
    val n = 2000000
    var acc = 0
    var i = 0
    val t0 = rt_time_now_unix_micros()
    while i < n:
        acc = add(acc, i)
        i = i + 1
    val elapsed = rt_time_now_unix_micros() - t0
    print "RESULT elapsed_us={elapsed} acc={acc} iters={i}"
