# Fixture for test/05_perf/interp/while_loop_shape_parity_spec.spl.
# Run standalone under SIMPLE_EXECUTION_MODE=interpreter; prints one
# machine-readable result line. Do not edit without updating that spec.

# Division is deliberately outside the inlinable operator set: the generic
# path raises a division-by-zero error, which an inlined wrapping evaluator
# would not reproduce. The matcher must decline.
fn half(a: i64, b: i64) -> i64:
    a / b

fn main():
    var acc = 0
    var i = 0
    while i < 1000:
        acc = acc + half(i, 2)
        i = i + 1
    print "RESULT elapsed_us=0 acc={acc} iters={i}"
