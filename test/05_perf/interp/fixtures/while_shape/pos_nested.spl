# Fixture for test/05_perf/interp/while_loop_shape_parity_spec.spl.
# Run standalone under SIMPLE_EXECUTION_MODE=interpreter; prints one
# machine-readable result line. Do not edit without updating that spec.

# Two levels of inlinable helper inside a binary operand: this MUST be
# recognised (counter moves) and must agree with the generic walk.
fn dbl(x: i64) -> i64:
    x + x

fn twice(x: i64) -> i64:
    dbl(x) + 0

fn main():
    var acc = 0
    var i = 0
    while i < 1000:
        acc = acc + twice(i)
        i = i + 1
    print "RESULT elapsed_us=0 acc={acc} iters={i}"
