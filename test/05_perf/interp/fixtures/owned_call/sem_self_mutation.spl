# Owned-receiver method call: `me` mutation is visible to the caller, and a
# non-`me` method's view of self does not escape.
class Box:
    n: i64
    me bump(self, k: i64):
        self.n = self.n + k
    fn peek(self) -> i64:
        self.n
    fn plus(self, k: i64) -> i64:
        self.n + k
fn main():
    var b = Box(n: 0)
    var i = 0
    while i < 10:
        b.bump(2)
        i = i + 1
    val s = b.plus(5)
    print("RESULT elapsed_us=1 acc={b.peek()}:{s} iters=10")
