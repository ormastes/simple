# Labelled arguments, out of order and mixed with a positional one.
class P:
    out: i64
    me set(self, a: i64, b: i64):
        self.out = a * 10 + b
    fn value(self) -> i64:
        self.out
fn main():
    var p = P(out: 0)
    p.set(b: 3, a: 4)
    val v1 = p.value()
    p.set(1, b: 2)
    val v2 = p.value()
    print("RESULT elapsed_us=1 acc={v1}:{v2} iters=2")
