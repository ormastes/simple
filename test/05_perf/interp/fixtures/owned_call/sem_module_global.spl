# A method body that mutates a module global: the caller must read the LIVE
# value after the call, which is what the frame's global publish/sync exists for.
var counter = 0
class G:
    k: i64
    me tick(self):
        counter = counter + self.k
fn main():
    var g = G(k: 3)
    var i = 0
    while i < 4:
        g.tick()
        i = i + 1
    print("RESULT elapsed_us=1 acc={counter} iters=4")
