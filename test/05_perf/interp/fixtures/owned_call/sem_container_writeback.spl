# A container passed by identifier is written back into the caller's binding,
# positionally and by label.
class Filler:
    tag: i64
    me fill(self, xs: [i64]):
        xs.push(self.tag)
        xs.push(self.tag + 1)
fn main():
    var f = Filler(tag: 7)
    var buf = [1]
    f.fill(buf)
    var buf2 = [0]
    f.fill(xs: buf2)
    print("RESULT elapsed_us=1 acc={buf.len()}:{buf[1]}:{buf[2]}:{buf2.len()}:{buf2[2]} iters=2")
