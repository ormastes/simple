# Default parameter values on an owned-receiver method, at 1, 2 and 3 args.
class Adder:
    total: i64
    me add(self, a: i64, b: i64 = 10, c: i64 = 100):
        self.total = self.total + a + b + c
    fn value(self) -> i64:
        self.total
fn main():
    var a = Adder(total: 0)
    a.add(1)
    val v1 = a.value()
    a.add(1, 2)
    val v2 = a.value()
    a.add(1, 2, 3)
    val v3 = a.value()
    print("RESULT elapsed_us=1 acc={v1}:{v2}:{v3} iters=3")
