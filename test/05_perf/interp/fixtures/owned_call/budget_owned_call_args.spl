# Budget fixture for the ARGUMENT side of the owned-receiver method call.
#
# Two positional arguments, the wholly-positional shape that needs none of the
# routing containers the labelled/default path builds. MECALL_CONTAINER_ALLOCS
# counts those containers, so this fixture reports 0 when the positional fast
# path is taken and 3 per call when it is not.
extern fn rt_time_now_unix_micros() -> i64
class Counter:
    count: i64
    me add2(self, a: i64, b: i64):
        self.count = self.count + a + b
    fn value(self) -> i64:
        self.count
fn main():
    val n = 200000
    var c = Counter(count: 0)
    var i = 0
    val t0 = rt_time_now_unix_micros()
    while i < n:
        c.add2(1, 2)
        i = i + 1
    val elapsed = rt_time_now_unix_micros() - t0
    print("RESULT elapsed_us={elapsed} acc={c.value()} iters={i}")
