# Budget fixture for the owned-receiver method-call kernel.
#
# One `me` call per iteration through the identifier-receiver owned path
# (interpreter_helpers/patterns.rs). The counters report how much per-call work
# the kernel does: MECALL_CALLS is the dispatch count, MECALL_METHOD_LOOKUPS the
# class/impl method-table probes it needed, MECALL_STRING_ALLOCS the owned
# `String` copies it allocated. The spec asserts the RATIOS, which are
# deterministic, rather than a wall-clock time, which on this host is not.
extern fn rt_time_now_unix_micros() -> i64
class Counter:
    count: i64
    me bump(self):
        self.count = self.count + 1
    fn value(self) -> i64:
        self.count
fn main():
    val n = 200000
    var c = Counter(count: 0)
    var i = 0
    val t0 = rt_time_now_unix_micros()
    while i < n:
        c.bump()
        i = i + 1
    val elapsed = rt_time_now_unix_micros() - t0
    print("RESULT elapsed_us={elapsed} acc={c.value()} iters={i}")
