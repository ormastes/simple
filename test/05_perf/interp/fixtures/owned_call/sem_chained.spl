# A chained call whose receiver is a call result must not write its result back
# into the root binding.
class Node:
    v: i64
    fn peek(self) -> i64:
        self.v
    me grow(self, k: i64):
        self.v = self.v + k
fn mk(x: i64) -> Node:
    Node(v: x)
fn main():
    var n = Node(v: 1)
    n.grow(2)
    val a = n.peek()
    val b = mk(5).peek()
    val c = n.peek()
    print("RESULT elapsed_us=1 acc={a}:{b}:{c} iters=3")
