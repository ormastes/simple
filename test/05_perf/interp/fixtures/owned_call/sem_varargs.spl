# Variadic parameter on an owned-receiver method, with and without arguments.
class Sum:
    total: i64
    me addall(self, nums...):
        for n in nums:
            self.total = self.total + n
    fn value(self) -> i64:
        self.total
fn main():
    var s = Sum(total: 0)
    s.addall(1, 2, 3)
    val v1 = s.value()
    s.addall()
    val v2 = s.value()
    print("RESULT elapsed_us=1 acc={v1}:{v2} iters=2")
