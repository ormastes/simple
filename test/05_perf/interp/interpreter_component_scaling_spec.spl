# ---------------------------------------------------------------------------
# Value semantics preserved -- a second binding must still copy-on-write.
# ---------------------------------------------------------------------------

describe "value semantics preserved":
    it "nested_field_push: alias of the inner array does not see a later self.inner.xs.push":
        step("Measure interpreter scaling across component counts")
        # @req REQ-PERF-INTERP-COMPONENT-SCALING-018
        var o = NestedPushOuter(inner: NestedPushInner(xs: [1, 2, 3]))
        val alias = o.inner.xs
        o.add(4)
        expect(alias).to_equal([1, 2, 3])
        expect(o.inner.xs).to_equal([1, 2, 3, 4])

    it "index_arr_push: an alias of the MUTATED row keeps its old contents, and the push does not leak into rows[j]":
        step("Measure interpreter scaling across component counts")
        # @req REQ-PERF-INTERP-COMPONENT-SCALING-019
        var rows: [[i64]] = [[1], [2]]
        val alias_mutated = rows[1]
        rows[1].push(99)
        expect(alias_mutated).to_equal([2])
        expect(rows[1]).to_equal([2, 99])
        expect(rows[0]).to_equal([1])

    it "self_index_push: aliasing the whole object AND aliasing the mutated row both keep their old contents":
        step("Measure interpreter scaling across component counts")
        # @req REQ-PERF-INTERP-COMPONENT-SCALING-020
        var g = SelfIndexGrid(rows: [[1], [2], [3], [4]])
        val alias = g
        val row0_alias = g.rows[0]
        g.add(0, 99)
        expect(alias.rows[0]).to_equal([1])
        expect(row0_alias).to_equal([1])
        expect(g.rows[0]).to_equal([1, 99])
        expect(g.rows[1]).to_equal([2])

    it "field_dict_method: aliasing the whole object AND aliasing the mutated dict both keep their old contents":
        step("Measure interpreter scaling across component counts")
        # @req REQ-PERF-INTERP-COMPONENT-SCALING-021
        var r = FieldDictReg(d: {"a": 1})
        val alias = r
        val d_alias = r.d
        r.put("b", 2)
        expect(alias.d.len()).to_equal(1)
        expect(d_alias.len()).to_equal(1)
        expect(r.d.len()).to_equal(2)

    it "nested_dict_insert: alias of the inner dict does not see a later self.inner.d[k] = v":
        step("Measure interpreter scaling across component counts")
        # @req REQ-PERF-INTERP-COMPONENT-SCALING-022
        var o = NestedDictOuter(inner: NestedDictInner(d: {"a": 1}))
        val alias = o.inner.d
        o.put("b", 2)
        expect(alias.len()).to_equal(1)
        expect(o.inner.d.len()).to_equal(2)

    it "index_obj_mutate_big: alias of an array element does not see a later arr[i].inc()":
        step("Measure interpreter scaling across component counts")
        # @req REQ-PERF-INTERP-COMPONENT-SCALING-023
        var arr: [MutCounter] = [MutCounter(v: 0), MutCounter(v: 0)]
        val alias = arr[0]
        arr[0].inc()
        expect(alias.v).to_equal(0)
        expect(arr[0].v).to_equal(1)
