# Microbenchmark for the module-qualified type registry: 1,000,000 method
# calls on instances of a MULTIPLY-DEFINED type (`Vec3` exists in
# test/helpers/modqual/geo_a.spl and geo_b.spl, both loaded here through
# their consumers), dispatched from the entry, which imports neither.
# Runs on the interpreter lane and prints the elapsed milliseconds:
#   <exe> test test/05_perf/interp/modqual_method_dispatch_bench.spl
# Compare seed vs fixed (uncached) vs fixed (cached) binaries.
use std.spec
use std.io.{time_now_unix_micros}
use test.helpers.modqual.use_a.{a_vec_make}
use test.helpers.modqual.use_b.{b_vec_make}

describe "modqual method dispatch microbenchmark":
    it "calls sum() 1,000,000 times across two same-named Vec3 definitions":
        val a = a_vec_make(1.0, 2.0, 3.0)
        val b = b_vec_make(1.0, 2.0)
        var acc = 0.0
        val t0 = time_now_unix_micros()
        var i = 0
        while i < 500000:
            acc = acc + a.sum()
            acc = acc + b.sum()
            i = i + 1
        val t1 = time_now_unix_micros()
        print("BENCH calls=1000000 acc=" + acc.to_string() + " elapsed_ms=" + ((t1 - t0) / 1000).to_string())
        expect(acc).to_equal(4500000.0)
