# Startup perf budgets (milliseconds, p50 of N=7 runs).
# Update policy (the ONLY recorded escape): edit the value here with a dated
# comment explaining the change. Never override via env var or flag.
# 2026-08-18: initial budgets = measured p50 x3 (seed binary, shared box:
#   version p50=122ms, run-hello p50=133ms) so box noise does not flap.
# 2026-08-18 (later, post 06:12 seed redeploy): four new Phase-D lanes added
#   (help, run-hello-cold, smf-load, compile-body). Measured on
#   /mnt/data/worktrees/simple-main/bin/release/x86_64-unknown-linux-gnu/simple
#   (59645008 bytes, mtime 2026-08-18 10:12): help p50=31/p95=179ms,
#   cold p50=34/p95=74ms, smf p50=33/p95=129ms, compile p50=49/p95=71ms.
#   Budgets set at the same scale as the existing lanes (>= p50 x3 AND
#   >= p95 x2, rounded), because shared-box p95 spikes (~180ms) exceed a
#   naive p50 x3 on a fast run and would flap the lane.
version_ms: 400
help_ms: 400
run_hello_ms: 450
run_hello_cold_ms: 450
smf_load_ms: 450
compile_hello_ms: 500
