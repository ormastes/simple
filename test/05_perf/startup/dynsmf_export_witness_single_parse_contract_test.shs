#!/bin/sh
set -eu

session=src/os/smf/dynsmf_session.spl
loader=src/os/smf/smf_dynlib.spl

grep -q 'smf_artifact_has_exports(data, entry.exports)' "$session"
grep -q 'pub fn smf_artifact_has_exports' "$loader"
grep -q 'val validated = match smf_dynlib_validate(data):' "$loader"
if grep -q 'smf_artifact_has_export(data, entry.exports\[idx\])' "$session"; then
    printf '%s\n' 'FAIL: readiness reparses the artifact once per required export' >&2
    exit 1
fi

printf '%s\n' 'PASS: dynSMF readiness validates each artifact once for its required export subset'
