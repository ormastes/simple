#!/bin/sh
set -eu

source_file="src/app/startup/component_dynsmf_wiring.spl"
body="$(sed -n '/fn _component_dynsmf_loaded_exact/,/fn _component_dynsmf_rollback_new/p' "$source_file")"

printf '%s\n' "$body" | grep -F 'dynsmf_session_find_loaded(session, component_id)' >/dev/null
if printf '%s\n' "$body" | grep -F 'for library in session.loaded' >/dev/null; then
    echo "FAIL: component startup bypasses the dynSMF loaded-library index" >&2
    exit 1
fi

echo "PASS: component dynSMF verification uses the canonical loaded index"
