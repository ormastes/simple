"""Stateless comparison workload for the explicitly-owned hash memo."""

use compiler.core.interpreter.hashmap.{hm_hash_text}

fn main() -> i64:
    var checksum: i64 = 0
    var i: i64 = 0
    while i < 25000:
        checksum = checksum + (hm_hash_text("eval_current_decl_id") & 65535)
        checksum = checksum + (hm_hash_text("frame_locals") & 65535)
        checksum = checksum + (hm_hash_text("module_loader_cache") & 65535)
        checksum = checksum + (hm_hash_text("café_binding") & 65535)
        i = i + 1
    print("hash-uncached {i} {checksum}")
    if i == 25000 and checksum == 3338400000: 0 else: 1
