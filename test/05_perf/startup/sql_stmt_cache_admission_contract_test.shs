#!/bin/sh
set -eu

owner=src/lib/nogc_sync_mut/database/sql/stmt_cache.spl

grep -q 'if self.capacity <= 0:' "$owner"
grep -q 'self.entries.len()' "$owner"

if grep -q 'self.entries.keys().len()' "$owner"; then
    echo "FAIL: SQL statement-cache cardinality materializes every key" >&2
    exit 1
fi

disabled_line=$(grep -n 'if self.capacity <= 0:' "$owner" | cut -d: -f1)
admit_line=$(grep -n 'self.entries\[sql\] = stmt' "$owner" | cut -d: -f1)
if [ "$disabled_line" -ge "$admit_line" ]; then
    echo "FAIL: disabled-cache guard must precede retained admission" >&2
    exit 1
fi

echo "PASS: SQL statement cache uses direct size and disabled admission"
