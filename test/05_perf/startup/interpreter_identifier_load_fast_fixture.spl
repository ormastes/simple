"""Product-shaped identifier hashing plus resolved LOAD_FAST locals."""

use compiler.core.interpreter.hashmap.{InterpreterHashMemo, hm_hash_memo_new, hm_hash_text_memoized}

fn exercise_load_fast(
    memo: InterpreterHashMemo,
    eval_current_decl_id: i64,
    frame_locals: i64,
    module_loader_cache: i64,
    decl_owner_file_table: i64
) -> i64:
    val resolved_local_slot: i64 = 23
    var checksum: i64 = 0
    var iteration: i64 = 0
    while iteration < 25000:
        checksum = checksum + eval_current_decl_id + frame_locals
        checksum = checksum + module_loader_cache + decl_owner_file_table
        checksum = checksum + resolved_local_slot
        checksum = checksum + (hm_hash_text_memoized(memo, "eval_current_decl_id") & 255)
        checksum = checksum + (hm_hash_text_memoized(memo, "frame_locals") & 255)
        checksum = checksum + (hm_hash_text_memoized(memo, "module_loader_cache") & 255)
        checksum = checksum + (hm_hash_text_memoized(memo, "decl_owner_file_table") & 255)
        iteration = iteration + 1
    checksum

fn main() -> i64:
    val memo = hm_hash_memo_new(8)
    val checksum = exercise_load_fast(memo, 11, 13, 17, 19)
    print("identifier-load-fast {checksum} hits={memo.hits} misses={memo.misses}")
    if checksum == 15575000 and memo.hits == 99996 and memo.misses == 4: 0 else: 1
