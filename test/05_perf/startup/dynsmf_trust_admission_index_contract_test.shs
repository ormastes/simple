#!/bin/sh
set -eu

owner=src/os/smf/dynsmf_trust_registry.spl

grep -q 'fn _dynsmf_trust_manifest_indices' "$owner"
grep -q 'fn _dynsmf_trust_image_indices' "$owner"
grep -q 'val manifest_indices = _dynsmf_trust_manifest_indices(manifest)' "$owner"
grep -q 'val image_indices = _dynsmf_trust_image_indices(images)' "$owner"
test "$(grep -c 'indices\[.*\] = -2' "$owner")" -eq 2
! grep -q 'fn _dynsmf_trust_manifest_entry' "$owner"
! grep -q 'fn _dynsmf_trust_image(' "$owner"

printf '%s\n' 'PASS: dynSMF trust admission indexes manifest identities and retained images once with duplicate sentinels'
