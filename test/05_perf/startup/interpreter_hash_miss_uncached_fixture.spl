"""Stateless comparison for the high-cardinality miss-heavy workload."""

use compiler.core.interpreter.hashmap.{hm_hash_text}

fn main() -> i64:
    var checksum: i64 = 0
    var i: i64 = 0
    while i < 4096:
        checksum = checksum + (hm_hash_text("identifier_{i}") & 65535)
        i = i + 1
    print("hash-miss-uncached {i} {checksum}")
    if i == 4096 and checksum == 131475810: 0 else: 1
