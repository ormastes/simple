#!/bin/sh
set -eu

owner=src/os/smf/aspect_pack_directory.spl

grep -q 'section_offsets.sort()' "$owner"
grep -q 'section_sizes_by_offset' "$owner"
grep -q 'while ordered_index < section_offsets.len()' "$owner"
if grep -q 'while previous < section_offsets.len()' "$owner"; then
    echo "FAIL: aspect-pack section validation still performs a quadratic pairwise scan" >&2
    exit 1
fi

echo "PASS: aspect-pack section overlap validation uses sort plus adjacent sweep"
