#!/bin/sh
set -eu

source_file="src/os/smf/dynsmf_session.spl"

grep -q '_issued_facet_tokens_by_library: Dict<text, \[text\]>' "$source_file"
grep -q 'out._issued_facet_tokens_by_library\[library_id\] = library_tokens' "$source_file"

body=$(sed -n '/^fn _dynsmf_revoke_library_facet_refs/,/^fn dynsmf_session_new/p' "$source_file")
printf '%s\n' "$body" | grep -q 'out._issued_facet_tokens_by_library\[library_id\]'
printf '%s\n' "$body" | grep -q 'out._issued_facet_refs = out._issued_facet_refs.remove(token)'
printf '%s\n' "$body" | grep -q 'out._issued_facet_ref_count = out._issued_facet_ref_count - 1'
if printf '%s\n' "$body" | grep -q '_issued_facet_refs.keys()'; then
    echo "FAIL: library revocation still enumerates every session facet token" >&2
    exit 1
fi

echo "PASS: dynSMF issued-facet revocation is indexed by owning library"
