#!/bin/sh
set -eu
ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)"
cd "$ROOT_DIR"
OWNER=src/os/smf/dynsmf_trust_registry.spl
SPEC=test/01_unit/os/smf/dynsmf_trust_registry_spec.spl
for declaration in \
    'var seen_library_ids: Dict<text, bool> = {}' \
    'var seen_paths: Dict<text, bool> = {}' \
    'var seen_facet_ids: Dict<text, bool> = {}' \
    'var seen_export_symbols: Dict<text, bool> = {}'; do
    grep -Fq "$declaration" "$OWNER"
done
for retired in _dynsmf_trust_binding_duplicate _dynsmf_trust_artifact_duplicate; do
    if grep -Fq "fn $retired" "$OWNER"; then
        echo "retired linear duplicate scanner remains: $retired" >&2
        exit 1
    fi
done
grep -Fq 'while index < 64:' "$SPEC"
grep -Fq 'duplicate_facet' "$SPEC"
grep -Fq 'duplicate_export' "$SPEC"
echo 'dynsmf_trust_parse_index_contract=true'
echo 'indexed_dimensions=library_id,path,facet_id,export_symbol'
echo 'complexity=O(artifacts+bindings)'
