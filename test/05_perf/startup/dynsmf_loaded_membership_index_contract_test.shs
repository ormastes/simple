#!/bin/sh
set -eu

owner=src/os/smf/dynsmf_session.spl

grep -q '_loaded_indices: Dict<text, i64>' "$owner"
grep -q '_known_library_slots: Dict<text, i64>' "$owner"
grep -q 'out._loaded_indices\[id\] = slot' "$owner"
grep -q 'out.loaded\[slot\] = published' "$owner"
grep -q 'out._loaded_indices = out._loaded_indices.remove(id)' "$owner"
if grep -q 'while loaded_idx < out.loaded.len()' "$owner"; then
    printf '%s\n' 'FAIL: load admission rescans the loaded-history array' >&2
    exit 1
fi
if grep -q 'while idx < session.loaded.len()' "$owner"; then
    printf '%s\n' 'FAIL: hot session lookup rescans loaded history' >&2
    exit 1
fi
if grep -q 'var loaded: \[DynSmfLoadedLibrary\] = \[\]' "$owner"; then
    printf '%s\n' 'FAIL: unload rebuilds the full loaded-history array' >&2
    exit 1
fi
if grep -q '_known_library_ids' "$owner"; then
    printf '%s\n' 'FAIL: reload history retains a set without a reusable slot' >&2
    exit 1
fi

printf '%s\n' 'PASS: dynSMF live lookup uses active slots and reload replaces bounded per-library history'
