#!/usr/bin/env sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
OWNER="$ROOT_DIR/src/lib/nogc_sync_mut/src/core/decorators.spl"
ASYNC_FACADE="$ROOT_DIR/src/lib/nogc_async_mut/src/core/decorators.spl"
GC_FACADE="$ROOT_DIR/src/lib/gc_async_mut/src/core/decorators.spl"

if grep -F 'self.cache.keys().len()' "$OWNER" >/dev/null; then
    echo "decorator cache stats must not materialize cache keys" >&2
    exit 1
fi
if grep -F 'Dict.len() always returns -1' "$OWNER" >/dev/null; then
    echo "expired decorator-cache Dict.len warning remains" >&2
    exit 1
fi

grep -F '            "size": self.cache.len()' "$OWNER" >/dev/null
grep -F 'export use nogc_sync_mut.src.core.decorators.' "$ASYNC_FACADE" >/dev/null
grep -F 'export use nogc_async_mut.src.core.decorators.' "$GC_FACADE" >/dev/null
echo "decorators-cache-cardinality-contract-ok"
