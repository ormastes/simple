#!/bin/sh
set -eu

source_file="src/app/startup/dynsmf_autoload.spl"
body="$(sed -n '/pub fn dynsmf_startup_options_from_values/,/struct ProductDynloadStartupMetrics/p' "$source_file")"

printf '%s\n' "$body" | grep -F 'val settings_text = settings_parts.join(";")' >/dev/null
if printf '%s\n' "$body" | grep -F 'settings_text = settings_text +' >/dev/null; then
    echo "FAIL: startup settings rebuild their accumulated prefix" >&2
    exit 1
fi

echo "PASS: dynSMF startup settings use one terminal join"
