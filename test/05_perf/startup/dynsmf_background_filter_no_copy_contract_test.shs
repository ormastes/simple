#!/bin/sh
set -eu

owner=src/os/smf/dynsmf_session.spl

grep -q 'autoload_only: bool' "$owner"
grep -q 'if not autoload_only or entry.default_autoload:' "$owner"
if grep -q 'var autoload_only: \[DynSmfManifestEntry\] = \[\]' "$owner"; then
    printf '%s\n' 'FAIL: startup background planning copies manifest entries' >&2
    exit 1
fi
if grep -q 'autoload_only.push(manifest\[idx\])' "$owner"; then
    printf '%s\n' 'FAIL: startup background planning materializes a filtered manifest' >&2
    exit 1
fi

printf '%s\n' 'PASS: startup background planning filters the original manifest in one pass without a copy'
