#!/bin/sh
set -eu

source_file="src/os/smf/dynsmf_session.spl"

grep -q '_trusted_facet_bindings: Dict<text, DynSmfTrustedFacetBinding>' "$source_file"
grep -q '_trusted_facet_keys_by_library: Dict<text, \[text\]>' "$source_file"
grep -q 'out._trusted_facet_bindings\[key\] = binding' "$source_file"
grep -q 'out._trusted_facet_keys_by_library\[id\] = library_keys' "$source_file"
grep -q 'val trusted = session._trusted_facet_bindings\[trusted_key\]' "$source_file"

body=$(sed -n '/^fn _dynsmf_revoke_library_facet_refs/,/^fn dynsmf_session_new/p' "$source_file")
printf '%s\n' "$body" | grep -q 'for key in out._trusted_facet_keys_by_library\[library_id\]:'
printf '%s\n' "$body" | grep -q 'out._trusted_facet_bindings = out._trusted_facet_bindings.remove(key)'
if printf '%s\n' "$body" | grep -q 'for binding in out._trusted_facet_bindings'; then
    echo "FAIL: trusted facet revocation still scans every loaded library binding" >&2
    exit 1
fi

echo "PASS: dynSMF trusted bindings publish, lookup, and revoke through owner indices"
