#!/bin/sh
set -eu

owner=src/os/smf/dynsmf_session.spl

grep -q '_trusted_facet_indices: Dict<text, i64>' "$owner"
grep -q 'fn _dynsmf_facet_binding_key' "$owner"
grep -q 'if not out._trusted_facet_indices.has(key):' "$owner"
grep -q 'if not session._trusted_facet_indices.has(trusted_key):' "$owner"
if grep -q 'for binding in session._trusted_facet_bindings:' "$owner"; then
    printf '%s\n' 'FAIL: facet lease lookup rescans every trusted binding' >&2
    exit 1
fi

printf '%s\n' 'PASS: exact trusted facet publication and lease lookup use one owner-maintained index'
