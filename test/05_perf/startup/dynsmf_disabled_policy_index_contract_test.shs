#!/bin/sh
set -eu

owner=src/os/smf/dynsmf_session.spl

grep -q '_disabled_id_index: Dict<text, bool>' "$owner"
grep -q 'policy._disabled_id_index.has(id)' "$owner"
if grep -q 'while idx < policy.disabled_ids.len()' "$owner"; then
    printf '%s\n' 'FAIL: dynSMF policy membership rescans disabled IDs' >&2
    exit 1
fi

printf '%s\n' 'PASS: dynSMF disabled-policy membership is constant-time after one construction pass'
