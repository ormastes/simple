#!/bin/sh
set -eu

source_file=src/compiler/99.loader/aspect_pack_section.spl

body=$(sed -n '/fn smf_validate_optional_aspect_pack/,/fn smf_register_validated_aspect_pack/p' "$source_file")

printf '%s\n' "$body" | grep -Fq 'val section_count = smf_count_sections_by_wire_type' || {
    echo 'missing authoritative section count validation' >&2
    exit 1
}
printf '%s\n' "$body" | grep -Fq 'val extent = smf_section_extent(reader, 0)?' || {
    echo 'validated single-section index is not reused' >&2
    exit 1
}
if printf '%s\n' "$body" | grep -Fq 'smf_aspect_pack_bytes(reader)'; then
    echo 'successful validation rescans the section table' >&2
    exit 1
fi

echo 'PASS aspect-pack validated single-section scan contract'
