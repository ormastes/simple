# Terra startup/RSS handoff is the single admission authority for this lane.
# The checker owns receipt parsing; this spec proves it is reachable from the
# executable suite and does not silently accept missing production evidence.
# @req REQ-TERRA-STARTUP-RSS-001

use std.spec.step
use std.spec.*
use std.io_runtime.{process_run}

val CHECK: text = "sh test/05_perf/startup/terra_startup_rss_handoff_contract_test.shs"

fn run(command: text) -> (text, i64):
    val out = process_run("sh", ["-c", command + " 2>&1"])
    (out.0, out.2)

describe "Terra startup/RSS handoff":
    it "should validate synthetic evidence and reject a forged successful count":
        # @req REQ-TERRA-STARTUP-RSS-001
        step("Run the checker selftest with 15 raw successful samples")
        val (out, code) = run(CHECK + " --selftest")
        expect(out).to_contain("PASS: terra handoff selftest")
        expect(out).to_contain("N=15")
        expect(code).to_equal(0)

    it "should require the production handoff instead of treating absence as success":
        # @req REQ-TERRA-STARTUP-RSS-001
        step("Run the checker against the production default receipt")
        val (out, code) = run(CHECK)
        expect(code).to_equal(0)
        expect(out).to_contain("PASS: terra startup/RSS handoff admitted")
