"""High-cardinality miss-heavy workload for the bounded owned memo."""

use compiler.core.interpreter.hashmap.{hm_hash_memo_new, hm_hash_text_memoized}

fn main() -> i64:
    val memo = hm_hash_memo_new(8)
    var checksum: i64 = 0
    var i: i64 = 0
    while i < 4096:
        checksum = checksum + (hm_hash_text_memoized(memo, "identifier_{i}") & 65535)
        i = i + 1
    print("hash-miss-memo {i} {checksum} entries={memo.keys.len()} hits={memo.hits} misses={memo.misses}")
    if i == 4096 and checksum == 131475810 and memo.keys.len() == 8 and memo.hits == 0 and memo.misses == 4096: 0 else: 1
