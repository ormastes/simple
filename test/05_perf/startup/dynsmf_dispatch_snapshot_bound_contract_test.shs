#!/bin/sh
set -eu

owner=src/app/startup/dynsmf_autoload.spl

grep -q 'val queued_evidence_count = out.evidence.len()' "$owner"
grep -q 'while idx < queued_evidence_count:' "$owner"
guard_line=$(grep -n 'if not has_queued_compile:' "$owner" | cut -d: -f1)
manifest_line=$(grep -n 'var manifest_indices: Dict<text, i64> = {}' "$owner" | cut -d: -f1)
[ "$guard_line" -lt "$manifest_line" ] || {
    printf '%s\n' 'FAIL: no-queue guard does not precede manifest-index allocation' >&2
    exit 1
}
if grep -q 'while idx < out.evidence.len():' "$owner"; then
    printf '%s\n' 'FAIL: dynSMF dispatch traverses evidence appended by its own loop' >&2
    exit 1
fi

printf '%s\n' 'PASS: dynSMF dispatch returns before manifest indexing when empty and otherwise consumes one fixed evidence snapshot'
