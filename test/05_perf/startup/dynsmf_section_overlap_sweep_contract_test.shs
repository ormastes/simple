#!/bin/sh
set -eu

source_file="src/os/smf/smf_dynlib.spl"
body=$(sed -n '/fn smf_dynlib_validate_sections/,/^fn smf_dynlib_validate_symbols/p' "$source_file")

printf '%s\n' "$body" | grep -q 'var ordered_offsets: \[i64\] = \[\]'
printf '%s\n' "$body" | grep -q 'ordered_offsets.sort()'
printf '%s\n' "$body" | grep -q 'while ordered_index < ordered_offsets.len():'
printf '%s\n' "$body" | grep -q 'if current_offset < previous_end:'
if printf '%s\n' "$body" | grep -q 'for previous in sections:'; then
    echo "FAIL: section validation still performs quadratic pairwise overlap scans" >&2
    exit 1
fi

echo "PASS: dynSMF section overlap validation uses sort plus adjacent sweep"
