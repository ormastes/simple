#!/bin/sh
set -eu
ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)"
cd "$ROOT_DIR"
OWNER=src/app/startup/component_dynsmf_wiring.spl
SPEC=test/02_integration/app/simple/component_dynsmf_production_wiring_spec.spl
grep -Fq 'var seen_binding_ids: Dict<text, bool> = {}' "$OWNER"
[ "$(grep -Fc 'seen_binding_ids.contains_key(binding.component_id)' "$OWNER")" -eq 2 ]
[ "$(grep -Fc 'seen_binding_ids[binding.component_id] = true' "$OWNER")" -eq 2 ]
if grep -Fq 'fn _component_dynsmf_binding_index' "$OWNER"; then
    echo 'linear component binding duplicate scanner remains' >&2
    exit 1
fi
grep -Fq 'while index < 64:' "$SPEC"
grep -Fq 'duplicate_binding:component_31' "$SPEC"
echo 'component_dynsmf_binding_index_contract=true'
echo 'duplicate_check=exact-dict-membership'
echo 'complexity=O(bindings)'
