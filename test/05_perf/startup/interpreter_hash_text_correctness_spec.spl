"""Explicitly-owned interpreter name hashing remains byte-for-byte FNV-1a."""

use compiler.core.interpreter.hashmap.{hm_hash_memo_new, hm_hash_text, hm_hash_text_memoized}
use std.fs.{read_file}

fn reference_hash_text(value: text) -> i64:
    val bytes = value.bytes()
    if bytes.len() == 0: return 0
    var hash: i64 = -3750763034362895579
    var i: i64 = 0
    while i < bytes.len():
        hash = hash xor (bytes[i] as i64)
        hash = hash * 1099511628211
        i = i + 1
    if hash < 0: return 0 - hash
    hash

describe "interpreter environment text hash":
    it "matches the materialized-byte reference for identifiers and UTF-8":
        val values: [text] = [
            "", "x", "eval_current_decl_id", "frame_locals",
            "café_binding", "λ_value", "数据"
        ]
        for value in values:
            expect(hm_hash_text(value)).to_equal(reference_hash_text(value))

    it "is stable for repeated session-owned memo hits":
        val memo = hm_hash_memo_new(8)
        val expected = reference_hash_text("module_loader_cache")
        var i: i64 = 0
        while i < 1000:
            expect(hm_hash_text_memoized(memo, "module_loader_cache")).to_equal(expected)
            i = i + 1
        expect(memo.keys.len()).to_equal(1)
        expect(memo.misses).to_equal(1)
        expect(memo.hits).to_equal(999)

    it "bounds a high-cardinality miss-heavy memo without changing hashes":
        val memo = hm_hash_memo_new(8)
        var i: i64 = 0
        while i < 4096:
            val value = "identifier_{i}"
            expect(hm_hash_text_memoized(memo, value)).to_equal(reference_hash_text(value))
            i = i + 1
        expect(memo.keys.len()).to_equal(8)
        expect(memo.values.len()).to_equal(8)
        expect(memo.misses).to_equal(4096)
        expect(memo.hits).to_equal(0)
        expect(hm_hash_text_memoized(memo, "identifier_4095")).to_equal(reference_hash_text("identifier_4095"))
        expect(memo.hits).to_equal(1)

    it "keeps mutable memo storage out of module globals":
        val source = read_file("src/compiler/10.frontend/core/interpreter/hashmap.spl")
        expect(source.contains("var hm_hash_cache_keys")).to_equal(false)
        expect(source.contains("var hm_hash_cache_values")).to_equal(false)
        expect(source.contains("var hm_hash_cache_next")).to_equal(false)
        expect(source).to_contain("class InterpreterHashMemo:")
