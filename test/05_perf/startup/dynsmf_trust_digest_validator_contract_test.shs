#!/bin/sh
set -eu

source_file="src/os/smf/dynsmf_trust_registry.spl"

grep -F 'use std.common.encoding.sha256_contract.{sha256_lower_hex_valid}' "$source_file" >/dev/null
grep -F 'sha256_lower_hex_valid(artifact.content_hash)' "$source_file" >/dev/null
if grep -F 'digest.slice(index, index + 1)' "$source_file" >/dev/null; then
    echo "FAIL: dynSMF trust digest validation allocates per character" >&2
    exit 1
fi

echo "PASS: dynSMF trust parsing uses the allocation-free Pure Simple digest validator"
