"""Product-shaped identifier hashing plus module/global slow-environment reads."""

use compiler.core.interpreter.hashmap.{InterpreterHashMemo, hm_hash_memo_new, hm_hash_text_memoized}

var eval_current_decl_id: i64 = 11
var frame_locals: i64 = 13
var module_loader_cache: i64 = 17
var decl_owner_file_table: i64 = 19

fn exercise_slow_env(memo: InterpreterHashMemo) -> i64:
    var checksum: i64 = 0
    var iteration: i64 = 0
    while iteration < 25000:
        checksum = checksum + eval_current_decl_id + frame_locals
        checksum = checksum + module_loader_cache + decl_owner_file_table
        checksum = checksum + (hm_hash_text_memoized(memo, "eval_current_decl_id") & 255)
        checksum = checksum + (hm_hash_text_memoized(memo, "frame_locals") & 255)
        checksum = checksum + (hm_hash_text_memoized(memo, "module_loader_cache") & 255)
        checksum = checksum + (hm_hash_text_memoized(memo, "decl_owner_file_table") & 255)
        iteration = iteration + 1
    checksum

fn main() -> i64:
    val memo = hm_hash_memo_new(8)
    val checksum = exercise_slow_env(memo)
    print("identifier-slow-env {checksum} hits={memo.hits} misses={memo.misses}")
    if checksum == 15000000 and memo.hits == 99996 and memo.misses == 4: 0 else: 1
