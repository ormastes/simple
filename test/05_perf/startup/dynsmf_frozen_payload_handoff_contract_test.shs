#!/bin/sh
set -eu

session="src/os/smf/dynsmf_session.spl"
dynlib="src/os/smf/smf_dynlib.spl"

grep -F 'smf_dlopen_frozen_exact_exports(request, reserved_handle, module.payload, entry.exports)' "$session" >/dev/null
grep -F 'val exact_bytes = smf_dynlib_snapshot_bytes(admitted_bytes)' "$dynlib" >/dev/null
grep -F 'smf_dlopen_frozen_exact_exports(req, next_handle, exact_bytes, expected_exports)' "$dynlib" >/dev/null

echo "PASS: session-owned module payload bypasses a redundant defensive snapshot"
