"""Fail-closed contract for interpreter hash-memo performance evidence."""

use std.spec.*
use std.fs.{read_file}
use std.io_runtime.{process_run}

val CHECK: text = "scripts/check/check-interpreter-hash-memo-perf.shs"

fn run_sh(command: text) -> (text, i64):
    val result = process_run("sh", ["-c", command])
    (result.0 + result.1, result.2)

describe "interpreter hash memo evidence admission":
    it "binds binary source harness tool host and every raw interleaved lane":
        val source = read_file(CHECK)
        expect(source).to_contain("schema=interpreter-hash-memo-perf-evidence-v1")
        expect(source).to_contain("binary_sha256=")
        expect(source).to_contain("binary_provenance_sha256=")
        expect(source).to_contain("source_revision=")
        expect(source).to_contain("subject_source_sha256=")
        expect(source).to_contain("fixture_manifest_sha256=")
        expect(source).to_contain("harness_sha256=")
        expect(source).to_contain("timing_tool_sha256=")
        expect(source).to_contain("host_identity_sha256=")
        expect(source).to_contain("interleave_order_raw=")
        expect(source).to_contain("elapsed_ms_raw=")
        expect(source).to_contain("rss_kib_raw=")
        expect(source).to_contain("stdout_sha256_raw=")
        expect(source).to_contain("stderr_sha256_raw=")
        expect(source).to_contain("for lane in hot_uncached hot_memo miss_uncached miss_memo load_fast slow_env")
        expect(source).to_contain("stage4_verify_candidate_provenance")

    it "rejects fewer than seven samples before any measurement":
        val (out, code) = run_sh("INTERPRETER_HASH_SAMPLE_COUNT=6 sh " + CHECK + " 2>&1")
        expect(code).to_equal(2)
        expect(out).to_contain("STATUS: BLOCKED")
        expect(out).to_contain("below the required N>=7")
        expect(out.contains("receipt=")).to_equal(false)

    it "rejects the repository Rust seed instead of publishing a performance row":
        val (out, code) = run_sh("SIMPLE_BINARY=bin/simple sh " + CHECK + " 2>&1")
        expect(code).to_equal(2)
        expect(out).to_contain("STATUS: BLOCKED")
        expect(out).to_contain("performance not measured")
        expect(out.contains("STATUS: PASS")).to_equal(false)
        expect(out.contains("receipt=")).to_equal(false)
