#!/bin/sh
set -eu

owner=src/lib/nogc_async_mut/http_server/response_cache.spl

grep -q 'if self.max_entries <= 0:' "$owner"
grep -q 'not self.entries.contains_key(path) and self.entries.len() >= self.max_entries' "$owner"

if grep -q 'self.entries.keys().len()' "$owner"; then
    echo "FAIL: HTTP cache admission materializes every key for cardinality" >&2
    exit 1
fi

echo "PASS: STATIC source contract confirms cache admission avoids key-list materialization and handles replacement"
