#!/bin/sh
set -eu

owner=src/os/smf/dynsmf_session.spl

grep -q 'var first_indices: Dict<text, i64> = {}' "$owner"
grep -q '_dynsmf_session_load_entry_impl(out, entry, id, require_artifact)' "$owner"
if grep -q 'dynsmf_session_load(out, manifest, manifest\[idx\].id)' "$owner"; then
    printf '%s\n' 'FAIL: autoload rescans the manifest for each entry' >&2
    exit 1
fi
if grep -q 'dynsmf_session_load_checked(out, manifest, manifest\[idx\].id)' "$owner"; then
    printf '%s\n' 'FAIL: checked autoload rescans the manifest for each entry' >&2
    exit 1
fi

printf '%s\n' 'PASS: dynSMF autoload resolves first manifest identities in one indexed pass'
