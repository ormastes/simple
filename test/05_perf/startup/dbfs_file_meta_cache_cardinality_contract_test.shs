#!/usr/bin/env sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
OWNER="$ROOT_DIR/src/lib/nogc_sync_mut/db/dbfs_engine/file_meta.spl"

if grep -F 'self.entries.keys().len()' "$OWNER" >/dev/null; then
    echo "DBFS inode-hint admission must not materialize cache keys" >&2
    exit 1
fi

grep -F 'if not existed and self.entries.len() as i64 >= self.max_entries:' "$OWNER" >/dev/null
echo "dbfs-file-meta-cache-cardinality-contract-ok"
