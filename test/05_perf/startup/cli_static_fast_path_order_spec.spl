"""
Source-order performance contract for the full CLI's exact help/version path.
It prevents backend registry construction from moving back ahead of the static
terminal commands without requiring a rebuilt release binary.
"""

use std.io_runtime.{file_read}
use std.spec.step

val CLI_MAIN_SOURCE = "src/app/cli/_CliMain/main_and_help.spl"

describe "CLI exact help/version startup ordering":
    it "returns before backend table construction":
        step("locate static dispatch and backend installation in main")
        val source = file_read(CLI_MAIN_SOURCE) ?? ""
        val classify_at = source.index_of("val static_fast_path = cli_static_fast_path_kind")
        val help_return_at = source.index_of("if static_fast_path == CLI_STATIC_FAST_PATH_HELP")
        val version_return_at = source.index_of("if static_fast_path == CLI_STATIC_FAST_PATH_VERSION")
        val install_at = source.index_of("if not install_selected_k1_backend_table_v1()")
        expect(classify_at).to_be_greater_than(0)
        expect(help_return_at).to_be_greater_than(classify_at)
        expect(version_return_at).to_be_greater_than(help_return_at)
        expect(install_at).to_be_greater_than(version_return_at)

    it "keeps composition policy validation before the static exit":
        step("retain the fail-closed K1 policy check")
        val source = file_read(CLI_MAIN_SOURCE) ?? ""
        val policy_at = source.index_of("requested_k1_policy != selected_k1_policy")
        val classify_at = source.index_of("val static_fast_path = cli_static_fast_path_kind")
        expect(policy_at).to_be_greater_than(0)
        expect(classify_at).to_be_greater_than(policy_at)
