"""One read per physical file, across the HIR lowering and interpreter lanes.

Before the cross-lane source+AST cache the two lanes each had a private memo the
other could not see, so every file both of them reach was read and fully
re-parsed twice. Measured on `src/app/mcp/main.spl --help` (`SIMPLE_READ_TRACE=1`,
paths resolved to realpaths, binary `simple.c7c5bef`): 301 source reads over 129
physical files, **117 of them read at two different sites** -- 1,265,979 bytes
parsed a second time for nothing.

Pinned as an INVARIANT -- no physical file is read by more than one site -- not
against a recorded count, so the pin survives the import-closure work in the
sibling L5 packages: those change how many files the entry reaches, not how many
times each one is read. It is also blind, deliberately, to a site that re-reads
ONE file many times (`module_resolver/var_overlay.rs` reads
`variants/__init__.spl` 49 times): that is a missing memo at a single site, a
different defect with a different owner.

`spl_opens` is printed for information only and is NOT asserted. It stays far
above the physical count (444 vs 129 here) because the JIT lane
(`pipeline/module_loader.rs`) and the resolver's manifest probes issue the rest;
neither is part of this change.
"""

use std.spec.*
use std.io_runtime.{process_run}

val PROBE: text = "test/05_perf/startup/cross_lane_parse_once_probe.shs"

fn field(report: text, key: text) -> i64:
    for line in report.split("\n"):
        if line.starts_with(key + "="):
            return line.substring(key.len() + 1, line.len()).trim().to_i64()
    -1

describe "cross-lane parsed-source cache":
    it "never reads one physical file from two lanes":
        val result = process_run("sh", [PROBE])
        val report = result.0
        if report.contains("skip="):
            print "[perf] cross_lane_parse_once SKIPPED: " + report.trim()
            expect(true).to_equal(true)
        else:
            val reads = field(report, "reads")
            val physical = field(report, "physical")
            val crosssite = field(report, "crosssite")
            val shared = field(report, "shared")
            val sharedphys = field(report, "sharedphys")
            print "[perf] cross_lane_parse_once reads=" + reads.to_text() + " physical=" + physical.to_text() + " crosssite=" + crosssite.to_text() + " shared=" + shared.to_text() + "/" + sharedphys.to_text() + " spl_opens=" + field(report, "opens").to_text()
            expect(physical > 0).to_equal(true)
            # The defect: 117 files read once per lane. Now zero.
            expect(crosssite).to_equal(0)
            # ... because both lanes read through the one shared cache, which
            # reads each file it serves exactly once.
            expect(shared > 0).to_equal(true)
            expect(shared).to_equal(sharedphys)
