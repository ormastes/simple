# Matched prior/candidate archive-member verification workload.
# Both modes construct and hash the same 8 MiB-plus action member.

use std.common.crypto.sha256.{sha256_text}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}
use std.common.string_core.{text_validate_utf8}

extern fn rt_cli_get_args() -> [text]

fn main():
    val args = rt_cli_get_args()
    if args.len() < 2:
        print "missing-mode"
        return
    val payload = "action|compile|function|foo|{sha256_text("compile")}" +
        "x".repeat(8388608)
    val expected = "f9cdfe29e1df5353c345e0a509b822fc0b88562be8fd0a25663fce4e1a5f8e8c"
    var digest = ""
    if args[1] == "prior":
        var bytes: [u8] = [0u8; payload.len()]
        var i = 0
        while i < payload.len():
            bytes[i] = payload.byte_at(i).to_u8()
            i = i + 1
        val decoded = validated_utf8_bytes_to_text_linear(bytes)
        if decoded.is_err():
            print "utf8-error"
            return
        digest = sha256_text(decoded.unwrap())
    elif args[1] == "candidate":
        val selected = payload.slice(0, payload.len())
        if selected.len() != payload.len() or not text_validate_utf8(selected):
            print "utf8-error"
            return
        digest = sha256_text(selected)
    else:
        print "unknown-mode"
        return
    if digest != expected:
        print "digest-mismatch:{digest}"
        return
    print "pass"
