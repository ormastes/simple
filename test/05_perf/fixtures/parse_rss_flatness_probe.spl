# Bounded-RSS probe for the interpreted parse path.
#
# Regression harness for doc/08_tracking/bug/
# native_build_interpreted_worker_rss_blowup_2026-08-18.md (term 2:
# unbounded creep inside the interpreted `parse` step). Runs the pure-Simple
# `parse_module_silent_checked` on one real compiler source repeatedly and
# prints one line per iteration. The collector
# (scripts/perf/measure-interpreted-parse-rss-flatness.shs) runs this probe
# with 1 and N iterations under measure-peak-rss.shs and bounds
# peak(N) - peak(1): the one-time closure-load floor appears in both arms, so
# the delta is the per-parse retention the bug row recorded as ~1.3 MB/s.
#
# The iteration count below is rewritten by the collector per arm.
use compiler.core.parser.{parse_module_silent_checked}

extern fn rt_file_read_text(path: text) -> text?

fn main() -> i64:
    val path = "src/compiler/80.driver/driver_log_helpers.spl"
    val src = rt_file_read_text(path)
    if src == nil:
        print "HARNESS-ERR cannot read {path}"
        return 1
    print "HARNESS source_bytes={src!.len()}"
    var i = 0
    while i < 12:
        val failed = parse_module_silent_checked(src!, path)
        print "HARNESS iter={i} fail={failed}"
        i = i + 1
    print "HARNESS done"
    0
