use std.crypto.constant_time.{black_box}

@unsafe(reason: "benchmark argument provider; an empty array is the no-arguments or provider-failure sentinel", capabilities: [ffi])
extern fn rt_cli_get_args() -> [text]
@unsafe(reason: "benchmark input read; nil is the unreadable or provider-failure sentinel", capabilities: [ffi])
extern fn rt_file_read_text(path: text) -> text?

fn main():
    val args = unsafe(capabilities: [ffi]):
        rt_cli_get_args()
    if args.len() < 2:
        println("missing input")
        return
    val input = unsafe(capabilities: [ffi]):
        rt_file_read_text(args[1]) ?? ""
    val raw = input.trim()
    val parsed = raw.to_i64() ?? 0
    var value = black_box(parsed)
    for i in 0..100000:
        value = (value * 48271) % 2147483647
    println("checksum={black_box(value)} operations=100000")
