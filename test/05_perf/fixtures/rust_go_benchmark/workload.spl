use std.crypto.constant_time.{black_box}

extern fn rt_cli_get_args() -> [text]
extern fn rt_file_read_text(path: text) -> text

fn main():
    val args = rt_cli_get_args()
    if args.len() < 2:
        println("missing input")
        return
    val raw = rt_file_read_text(args[1]).trim()
    val parsed = raw.to_i64() ?? 0
    var value = black_box(parsed)
    for i in 0..100000:
        value = (value * 48271) % 2147483647
    println("checksum={black_box(value)} operations=100000")
