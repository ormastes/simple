extern fn rt_cli_get_args() -> [text]
extern fn rt_file_read_text(path: text) -> text

fn main():
    val args = rt_cli_get_args()
    if args.len() < 2:
        println("missing input")
        return
    val parsed = (rt_file_read_text(args[1]).trim()).to_i64() ?? 0
    var value = parsed
    for i in 0..100000:
        value = (value * 48271) % 2147483647
    println("checksum={value} operations=100000")
