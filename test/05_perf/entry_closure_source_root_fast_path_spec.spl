"""Entry-closure discovery keeps common server imports on the cheap root lane."""

extern fn rt_file_read_text(path: text) -> text?
extern fn rt_file_exists(path: text) -> bool

fn source(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "native entry-closure source-root fast path":
    it "tries explicit roots before the compatibility resolver":
        val driver = source("src/app/io/_CliCompile/compile_targets.spl")
        val fast_call = driver.index_of(
            "val direct_source_path = _nb_resolve_direct_source_roots(segs, source_dirs)")
        val compat_call = driver.index_of(
            "val resolved = _driver_resolve_entry_import(module_path, entry_dir)")

        expect(fast_call).to_be_greater_than(0)
        expect(compat_call).to_be_greater_than(fast_call)
        expect(driver).to_contain("if direct_source_path != \"\":\n        return direct_source_path")

    it "has direct candidates for the PostgreSQL mimic tier import":
        # These are the paths `_nb_resolve_direct_source_roots` probes for the
        # `std.database.postgres_mimic` import in postgres_mimic_server/main.spl.
        # Before the ordering fix, each unique import first paid the generic
        # resolver's cwd/src/importer compatibility probes; afterward it returns
        # from the declared --source roots here.
        expect(source("src/app/postgres_mimic_server/main.spl")).to_contain(
            "use std.database.postgres_mimic.")
        expect(rt_file_exists(
            "src/lib/nogc_sync_mut/database/postgres_mimic/__init__.spl")).to_equal(true)
        expect(rt_file_exists(
            "src/lib/nogc_async_mut/database/postgres_mimic/__init__.spl")).to_equal(true)
        expect(rt_file_exists(
            "src/lib/nogc_sync_mut/database/postgres_mimic/server.spl")).to_equal(true)

    it "keeps one direct app-root hit in the web server entry":
        expect(rt_file_exists(
            "examples/06_io/simple_web_server/config.spl")).to_equal(true)
        val entry = source("examples/06_io/simple_web_server/main.spl")
        expect(entry).to_contain("use config.")
        expect(entry).to_contain("use std.nogc_sync_mut.http_server.server.")
