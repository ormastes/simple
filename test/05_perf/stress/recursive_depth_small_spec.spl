"""
## Purpose and audience

# Performance & Stress Test

**Feature IDs:** #PERFORMANCE
**Category:** Performance Testing
**Status:** Implemented

This specification is maintained for compiler and library engineers reviewing PERF-STRESS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/05_perf/stress/recursive_depth_small_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-PERF-STRESS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec

fn check(condition: bool):
    expect(condition).to_equal(true)

describe "Performance Test":
    slow_it "stress test 1":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-PERF-STRESS-001
        step("Verify: stress test 1")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var arr = []
        for i in 0..100:
            arr = arr.append(i)
        check(arr.len() == 100)
        
    slow_it "stress test 2":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-PERF-STRESS-002
        step("Verify: stress test 2")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var sum = 0
        for i in 0..1000:
            sum = sum + i
        check(sum == 499500)
        
    slow_it "stress test 3":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-PERF-STRESS-003
        step("Verify: stress test 3")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var data = []
        for i in 0..50:
            data = data.append([i, i * 2, i * 3])
        check(data.len() == 50)
        
    slow_it "stress test 4":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-PERF-STRESS-004
        step("Verify: stress test 4")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var dict = {}
        for i in 0..100:
            dict["key_" + str(i)] = i
        check(dict.keys().len() == 100)
        
    slow_it "stress test 5":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-PERF-STRESS-005
        step("Verify: stress test 5")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var nested = []
        for i in 0..20:
            var inner = []
            for j in 0..20:
                inner = inner.append(i * j)
            nested = nested.append(inner)
        check(nested.len() == 20)
        
    slow_it "stress test 6":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-PERF-STRESS-006
        step("Verify: stress test 6")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var result = ""
        for i in 0..100:
            result = result + "x"
        check(result.len() == 100)
        
    slow_it "stress test 7":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-PERF-STRESS-007
        step("Verify: stress test 7")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var processed = []
        for i in 0..200:
            if i % 2 == 0:
                processed = processed.append(i)
        check(processed.len() == 100)
        
    slow_it "stress test 8":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-PERF-STRESS-008
        step("Verify: stress test 8")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var count = 0
        for i in 0..10:
            for j in 0..10:
                for k in 0..10:
                    count = count + 1
        check(count == 1000)
        
    slow_it "memory stress":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-PERF-STRESS-009
        step("Verify: memory stress")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var data = []
        for i in 0..100:
            data = data.append({"id": i, "data": [1, 2, 3, 4, 5]})
        check(data.len() == 100)
        
    slow_it "combined stress":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-PERF-STRESS-010
        step("Verify: combined stress")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        var final = []
        for i in 0..50:
            var temp = []
            for j in 0..50:
                temp = temp.append(i + j)
            var sum = 0
            for x in temp:
                sum = sum + x
            final = final.append(sum)
        check(final.len() == 50)
