# @req: REQ-STRESS-MEMORY-STRESS-001


"""
# Performance & Stress Test

**Feature IDs:** #PERFORMANCE
**Category:** Performance Testing
**Status:** Implemented
"""

use std.spec

fn check(condition: bool):
    expect(condition).to_equal(true)

use std.spec.step

describe "Performance Test":
    slow_it "stress test 1":
        # @req: REQ-STRESS-MEMORY-STRESS-001
        step("Verify: stress test 1")
        var arr = []
        for i in 0..100:
            arr = arr.append(i)
        check(arr.len() == 100)
        
    slow_it "stress test 2":
        # @req: REQ-STRESS-MEMORY-STRESS-001
        step("Verify: stress test 2")
        var sum = 0
        for i in 0..1000:
            sum = sum + i
        check(sum == 499500)
        
    slow_it "stress test 3":
        # @req: REQ-STRESS-MEMORY-STRESS-001
        step("Verify: stress test 3")
        var data = []
        for i in 0..50:
            data = data.append([i, i * 2, i * 3])
        check(data.len() == 50)
        
    slow_it "stress test 4":
        # @req: REQ-STRESS-MEMORY-STRESS-001
        step("Verify: stress test 4")
        var dict = {}
        for i in 0..100:
            dict["key_" + str(i)] = i
        check(dict.keys().len() == 100)
        
    slow_it "stress test 5":
        # @req: REQ-STRESS-MEMORY-STRESS-001
        step("Verify: stress test 5")
        var nested = []
        for i in 0..20:
            var inner = []
            for j in 0..20:
                inner = inner.append(i * j)
            nested = nested.append(inner)
        check(nested.len() == 20)
        
    slow_it "stress test 6":
        # @req: REQ-STRESS-MEMORY-STRESS-001
        step("Verify: stress test 6")
        var result = ""
        for i in 0..100:
            result = result + "x"
        check(result.len() == 100)
        
    slow_it "stress test 7":
        # @req: REQ-STRESS-MEMORY-STRESS-001
        step("Verify: stress test 7")
        var processed = []
        for i in 0..200:
            if i % 2 == 0:
                processed = processed.append(i)
        check(processed.len() == 100)
        
    slow_it "stress test 8":
        # @req: REQ-STRESS-MEMORY-STRESS-001
        step("Verify: stress test 8")
        var count = 0
        for i in 0..10:
            for j in 0..10:
                for k in 0..10:
                    count = count + 1
        check(count == 1000)
        
    slow_it "memory stress":
        # @req: REQ-STRESS-MEMORY-STRESS-001
        step("Verify: memory stress")
        var data = []
        for i in 0..100:
            data = data.append({"id": i, "data": [1, 2, 3, 4, 5]})
        check(data.len() == 100)
        
    slow_it "combined stress":
        # @req: REQ-STRESS-MEMORY-STRESS-001
        step("Verify: combined stress")
        var final = []
        for i in 0..50:
            var temp = []
            for j in 0..50:
                temp = temp.append(i + j)
            var sum = 0
            for x in temp:
                sum = sum + x
            final = final.append(sum)
        check(final.len() == 50)
