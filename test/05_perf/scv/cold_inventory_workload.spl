# Run under cold_inventory_profile.shs to enforce wall-time and reciprocal RSS.
# Digests are precomputed: this isolates replay/sort from filesystem and hashing.
use std.scv.compile_source_inventory.*

fn main() -> i64:
    val digest = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    var events: [CompileSourceEventV1] = []
    var index = 16384
    while index > 0:
        events = events.push(CompileSourceEventV1("git", "create", "src/{index}.spl",
            digest, digest, digest, digest, digest, index))
        index = index - 1
    val result = compile_source_inventory_apply_cold_events_v1(0, events)
    assert(result.valid)
    val inventory = result.inventory!
    assert(inventory.generation == 16384)
    assert(inventory.entries.len() == 16384)
    var total = 0
    var previous = ""
    for entry in inventory.entries:
        assert(previous < entry.source_identity)
        assert(entry.content_digest == digest)
        total = total + entry.byte_count
        previous = entry.source_identity
    assert(total == 134225920)
    print "cold_inventory entries=16384 generation=16384 byte_sum=134225920"
    0
