use std.scv.compile_source_inventory_core.{CompileSourceInventoryEntryV1, compile_source_inventory_entry_valid_v1}
extern fn rt_time_now_unix_micros() -> i64
fn main() -> i64:
    val a = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    val b = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    val c = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    val d = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
    val e = "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
    var shape = 0
    for entry in [CompileSourceInventoryEntryV1("src/a.spl", a,a,a,a,a,7), CompileSourceInventoryEntryV1("src/a.spl", a,b,c,b,c,7), CompileSourceInventoryEntryV1("src/a.spl", a,b,c,d,e,7)]:
        val started = rt_time_now_unix_micros()
        var count = 0
        while count < 2048:
            if not compile_source_inventory_entry_valid_v1(entry): return 1
            count = count + 1
        val elapsed = rt_time_now_unix_micros() - started
        print "shape={shape} count={count} micros={elapsed}"
        shape = shape + 1
    0
