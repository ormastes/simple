"""Direct post-Stage4 probe for amortized owner-thread ready dequeue.

This is a single-owner Executor fixture. It is intentionally not an M:N,
thread-safety, work-stealing, or bounded-admission benchmark.
"""

use std.async.executor.{Executor}
use std.async.task.{Task}
use std.async.future.{Future}

fn ready_task() -> Future<i64>:
    Future.from_value(1)

val TASKS = 10000
var executor = Executor.new()
for _ in 0..TASKS:
    executor.spawn(Task.new(ready_task))
executor.run()
if executor.task_count() != 0 or executor.ready_head != 0 or not executor.ready_queue.is_empty():
    print "owner_thread_ready_queue_probe FAIL"
    exit(1)
print "owner_thread_ready_queue_probe PASS tasks={TASKS} model=single-owner-thread admission=unbounded"
