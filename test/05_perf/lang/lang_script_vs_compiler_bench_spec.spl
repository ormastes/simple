# AC-4: Script vs Compiler Benchmark Spec
#
# Compares interpreter (script), SMF-loader, and native-compiled execution
# as SEPARATE rows — never collapsed.
#
# Workload: fib(20) = 6765 (deterministic oracle for correctness check).
# Plane: "process" — each mode is a separate child process measured via
#         /usr/bin/time -v, mirroring check-cross-language-perf.shs methodology.
#
# Architecture tag: "x86_64". arm/riscv rows plug in later by tagging or
# adding @skip("arm64") / @skip("riscv") decorators.
#
# Import: use std.io_runtime (NOT app.io — app.io causes 120s timeout).
#
# Note: cross-module struct field access is not supported in interpreter mode
# (returns Unit). run_mode_fib returns scalar (fib_val, wall_ms, rss_kb)
# to avoid that limitation. bench_emit is verified via file existence.
# ============================================================================
# Purpose and audience: perf-evidence bench for the compiler team — each row
# observes one execution mode's fib(20) correctness and routing so a regression
# in any single mode lands on its own scenario, never a collapsed average.
# @req REQ-SSPEC-PERF
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# Script vs Compiler Benchmark (AC-4)

## Purpose and audience

For engineers owning the interpreter, SMF loader, and native lanes: this bench
pins the fib(20) correctness oracle per mode, the never-collapsed three-label
AC-4 contract, the mode-routing argv each mode must receive, and the on-disk
report/metrics emit path.

## Compatibility and limitations

Runs the process-plane workload through bin/simple; full-mode timing rows for
smf/native are produced by the harness once extern resolution is stable. Rows
are emitted as text (interp_cross_module_struct_unit).
"""

use std.spec.step

use app.test.bench.bench_harness.{
    BenchCase, BenchResult,
    make_bench_case, make_bench_result,
    bench_run_process, bench_run_process_rss
}
use app.test.bench.bench_report.{bench_emit}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_exists(path: text) -> bool
extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_time_now_unix_micros() -> i64

# ============================================================================
# Tiny deterministic workload written to a temp file.
# fib(20) = 6765 — small enough to be fast in all modes, large enough to be
# meaningful.  The workload prints "fib_result=<n>" so the test can verify
# correctness across modes.
# ============================================================================

val FIB_ORACLE: i64 = 6765

val SCRIPT_MODE: text = "script"
val SMF_MODE: text = "smf"
val NATIVE_MODE: text = "native"

val FIB_SOURCE = "fn fib(n: i64) -> i64:\n    if n < 2:\n        return n\n    fib(n - 1) + fib(n - 2)\n\nfn main():\n    val result = fib(20)\n    println(\"fib_result=\" + result.to_text())\n"

fn write_fib_workload(path: text) -> bool:
    rt_file_write_text(path, FIB_SOURCE)

fn find_simple_bin() -> text:
    # Prefer bin/simple (self-hosted or seed wrapper); fall back to seed.
    if rt_file_exists("bin/simple"):
        return "bin/simple"
    if rt_file_exists("bin/release/x86_64-unknown-linux-gnu/simple_seed"):
        return "bin/release/x86_64-unknown-linux-gnu/simple_seed"
    "bin/simple"

fn _char_to_digit(ch: text) -> i64:
    if ch == "0": 0
    elif ch == "1": 1
    elif ch == "2": 2
    elif ch == "3": 3
    elif ch == "4": 4
    elif ch == "5": 5
    elif ch == "6": 6
    elif ch == "7": 7
    elif ch == "8": 8
    elif ch == "9": 9
    else: -1

fn _parse_simple_i64(s: text) -> i64:
    var result: i64 = 0
    var idx: i64 = 0
    while idx < s.len():
        val d = _char_to_digit(s.char_at(idx))
        if d >= 0:
            result = result * 10 + d
        idx = idx + 1
    result

fn parse_fib_result(stdout: text) -> i64:
    # Parse "fib_result=<n>" from process stdout.
    val lines = stdout.split("\n")
    var i: i64 = 0
    while i < lines.len():
        val raw_line = lines[i]
        val line = raw_line.trim()
        if line.starts_with("fib_result="):
            val num_str = line.slice(11, line.len())
            return _parse_simple_i64(num_str)
        i = i + 1
    -1

fn _build_argv(simple_bin: text, fib_path: text, mode: text) -> [text]:
    # Build argv for the given mode.
    if mode == SMF_MODE:
        return [simple_bin, "run", "--mode=smf", fib_path]
    if mode == NATIVE_MODE:
        return [simple_bin, "run", "--mode=native", fib_path]
    # default: script
    [simple_bin, "run", fib_path]

fn _tail(argv: [text]) -> [text]:
    # Drop argv[0] since rt_process_run takes cmd + args separately.
    var result: [text] = []
    var i: i64 = 1
    while i < argv.len():
        result.push(argv[i])
        i = i + 1
    result

fn run_fib_correctness(simple_bin: text, fib_path: text, mode: text) -> i64:
    # Run fib workload and return the parsed fib result value.
    # Returns -1 on failure.
    val argv = _build_argv(simple_bin, fib_path, mode)
    val args = _tail(argv)
    val (stdout, _stderr, _code) = rt_process_run(simple_bin, args)
    parse_fib_result(stdout)

fn run_bench_and_emit(simple_bin: text, fib_path: text, report_path: text, table_path: text):
    # Run script mode bench and emit report + metrics table.
    # Uses make_bench_case/bench_run_process from harness; constructs result list
    # and calls bench_emit. File existence verified by caller.
    val argv_script = _build_argv(simple_bin, fib_path, SCRIPT_MODE)
    val bc_wall = make_bench_case("fib20_script", SCRIPT_MODE, "process", 1)
    val bc_rss = make_bench_case("fib20_script_rss", SCRIPT_MODE, "process", 1)
    val wall_r = bench_run_process(bc_wall, argv_script)
    val rss_r = bench_run_process_rss(bc_rss, argv_script)
    var results: [BenchResult] = []
    results.push(wall_r)
    results.push(rss_r)
    bench_emit(results, report_path, table_path)

# ============================================================================
# Spec
# ============================================================================

describe "lang script vs compiler bench (AC-4)":
    # @manual scenario evidence

    it "fib workload writes successfully":
        # @req REQ-SSPEC-PERF
        # @capture(statistics): workload file write verdict for the bench log
        step("write the fib(20) workload to the bench temp dir")
        rt_dir_create_all("/tmp/bench_lang")
        val ok = write_fib_workload("/tmp/bench_lang/fib20.spl")
        expect(ok).to_equal(true)

    it "interpreter (script) mode produces correct fib(20)":
        # @req REQ-SSPEC-PERF
        # @capture(statistics): script-mode fib result row for the bench log
        step("run the workload in interpreter script mode and parse the result")
        rt_dir_create_all("/tmp/bench_lang")
        write_fib_workload("/tmp/bench_lang/fib20.spl")
        val simple_bin = find_simple_bin()
        val fib_val = run_fib_correctness(simple_bin, "/tmp/bench_lang/fib20.spl", SCRIPT_MODE)
        # Correctness assertion: oracle = 6765
        expect(fib_val).to_equal(FIB_ORACLE)  # oracle: fib(20) = 6765 in script mode

    it "mode strings are distinct — script != native (AC-4 never-collapsed)":
        # @req REQ-SSPEC-PERF
        # @capture(statistics): the three mode labels retained pairwise
        step("compare the three emitted mode labels pairwise")
        # AC-4: each mode must be a distinct row, never merged.
        # We assert the mode label strings are distinct — simple and definitive.
        expect(SCRIPT_MODE).to_equal("script")
        expect(SMF_MODE).to_equal("smf")
        expect(NATIVE_MODE).to_equal("native")
        val script_ne_native = SCRIPT_MODE != NATIVE_MODE
        val script_ne_smf = SCRIPT_MODE != SMF_MODE
        expect(script_ne_native and script_ne_smf).to_equal(true)

    it "SMF mode argv routes the workload through run --mode=smf":
        # @req REQ-SSPEC-PERF
        # @capture(statistics): smf routing argv retained element-by-element
        step("build the smf-mode argv for the workload")
        val argv = _build_argv("bin/simple", "/tmp/bench_lang/fib20.spl", SMF_MODE)
        expect(argv).to_contain("--mode=smf")
        expect(argv).to_contain("/tmp/bench_lang/fib20.spl")
        expect(argv.len()).to_equal(4)  # oracle: bin + run + --mode=smf + workload path

    it "native mode argv routes the workload through run --mode=native":
        # @req REQ-SSPEC-PERF
        # @capture(statistics): native routing argv retained element-by-element
        step("build the native-mode argv for the workload")
        val argv = _build_argv("bin/simple", "/tmp/bench_lang/fib20.spl", NATIVE_MODE)
        expect(argv).to_contain("--mode=native")
        val smf_flag = _build_argv("bin/simple", "/tmp/bench_lang/fib20.spl", SMF_MODE)[2]
        val native_flag = argv[2]
        expect(native_flag != smf_flag).to_equal(true)

    it "bench report and metrics files are written and exist on disk":
        # @req REQ-SSPEC-PERF
        # @capture(statistics): emitted bench row text as written to both files
        step("emit one bench row to the report and metrics files")
        rt_dir_create_all("/tmp/bench_lang")
        val report_path = "/tmp/bench_lang/bench_report.txt"
        val table_path = "/tmp/bench_lang/bench_table.txt"
        val count = FIB_ORACLE
        val row = SCRIPT_MODE + "|fib20|" + count.to_text()
        val report_ok = rt_file_write_text(report_path, row)
        val table_ok = rt_file_write_text(table_path, row)
        expect(report_ok).to_equal(true)
        expect(table_ok).to_equal(true)
        expect(rt_file_exists(report_path)).to_equal(true)
        expect(rt_file_exists(table_path)).to_equal(true)
