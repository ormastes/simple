use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_foundation.{
    web_style_counters_report, web_layout_counters_report}
use std.nogc_sync_mut.text_layout.font_renderer.{font_measure_probe_report}
use std.common.ui.draw_ir_sdn.{draw_ir_to_sdn}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.fs.{read_file}
use std.nogc_sync_mut.ui.host_frame_clock.{default_frame_clock}

fn main():
    val dir = "examples/06_io/ui/web_catalog/"
    val pages = ["overview", "html", "css-layout", "css-paint",
                 "forms-media", "animation", "evidence", "tab-bar"]
    for page in pages:
        val html = read_file(dir + page + ".html")
        val t0 = default_frame_clock().now_micros()
        val comp = simple_web_layout_render_html_draw_ir(html, 900, 760)
        val t1 = default_frame_clock().now_micros()
        val sdn = draw_ir_to_sdn(comp)
        print "[prof] page={page} cold_ms={(t1 - t0) / 1000} sha={sha256_text(sdn).substring(0, 16)}"
        print "[prof] page={page} {web_style_counters_report()}"
        print "[prof-font] page={page} {font_measure_probe_report()}"
        print "[prof-lay] page={page} {web_layout_counters_report()}"
