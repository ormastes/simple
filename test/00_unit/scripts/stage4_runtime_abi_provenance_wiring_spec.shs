#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
CHECKER=${STAGE4_RUNTIME_ABI_CHECKER:-"$ROOT/scripts/check/check-stage4-runtime-abi-gate.shs"}

fail() {
    echo "stage4_runtime_abi_provenance_wiring=fail:$1" >&2
    exit 1
}

grep -F 'stage4_verify_candidate_provenance "$provenance" "$candidate" "$REPO_ROOT" || {' "$CHECKER" >/dev/null ||
    fail canonical_verifier_not_enforced

if grep -F 'stage4_verify_source_provenance' "$CHECKER" >/dev/null; then
    fail removed_helper_still_referenced
fi

echo 'stage4_runtime_abi_provenance_wiring=pass'
