#!/bin/sh
# Invalid repetition counts must fail before any qualification verdict.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
mkdir "$tmp/corpus"
printf 'fn main():\n    print(42)\n' > "$tmp/corpus/control.spl"
for count in 0x2 '' 0 1 02 +2 -2 2.0 ' 2' 999999999999999999999999999999999999; do
    rc=0
    META_K="$count" SIMPLE_BIN="$tmp/missing" sh "$root/scripts/check/cert/tool-qual-meta.shs" "$tmp/corpus" > "$tmp/out" 2>&1 || rc=$?
    if [ "$rc" -eq 0 ] || grep -q 'RESULT: PASS' "$tmp/out"; then
        cat "$tmp/out"
        printf 'FAIL: invalid META_K=[%s] accepted\n' "$count"
        exit 1
    fi
    grep -q 'META_K must be' "$tmp/out" || {
        cat "$tmp/out"; printf 'FAIL: missing count diagnostic for [%s]\n' "$count"; exit 1;
    }
    printf 'PASS: invalid META_K=[%s] rejected\n' "$count"
done
cat > "$tmp/compiler" <<'FIXTURE'
#!/bin/sh
printf 'run\n' >> "$CALLS"
printf '42\n'
FIXTURE
chmod +x "$tmp/compiler"
export CALLS="$tmp/calls"
for count in 2 3 default; do
    : > "$CALLS"
    if [ "$count" = default ]; then
        env -u META_K SIMPLE_BIN="$tmp/compiler" sh "$root/scripts/check/cert/tool-qual-meta.shs" "$tmp/corpus" > "$tmp/out" 2>&1
        expected=10
    else
        META_K="$count" SIMPLE_BIN="$tmp/compiler" sh "$root/scripts/check/cert/tool-qual-meta.shs" "$tmp/corpus" > "$tmp/out" 2>&1
        expected=$((count * 2))
    fi
    grep -q 'RESULT: PASS' "$tmp/out"
    [ "$(wc -l < "$CALLS")" -eq "$expected" ] || {
        printf 'FAIL: wrong execution count for META_K=%s\n' "$count"; exit 1;
    }
    printf 'PASS: META_K=%s executes %s runs\n' "$count" "$expected"
done
echo 'PASS: tool-qualification repetition-count regressions'
