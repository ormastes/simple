#!/usr/bin/env bash
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
producer="$root/scripts/bootstrap/produce-bootstrap-planner-admission-v2.shs"
verifier="$root/scripts/check/lib/bootstrap-planner-admission-bound.shs"
fixture=$(mktemp -d "${TMPDIR:-/tmp}/planner-capsule-corrected.XXXXXX")
trap 'rm -rf -- "$fixture"' EXIT HUP INT TERM
repo="$fixture/repo"; txn="$fixture/txn"; stage2="$txn/output/stage2/triple"
runtime="$repo/src/runtime"; source="$repo/src/app/cli/bootstrap_reason_planner.spl"
git_state="$fixture/git-state.env"; control="$fixture/control"
mkdir -p "$runtime" "$(dirname "$source")" "$stage2" "$txn/evidence" "$control"
printf 'extern fn rt_argc() -> i64\n' >"$source"
printf 'int runtime(void) { return 0; }\n' >"$runtime/runtime.c"
printf 'schema=coordinator-git-state-v1\nhead=fixture\n' >"$git_state"
printf 'stage2-sanity: pass\n' >"$stage2/stage2-sanity.receipt"
printf 'stage2-provenance: pure-simple\n' >"$stage2/stage2-provenance.receipt"
printf 'schema=simple-bootstrap-stage2-transaction-v1\nstatus=committed\nexit_code=0\n' >"$txn/transaction.env"
printf 'schema=simple-bootstrap-stage2-runner-v4\nstatus=succeeded\nexit_code=0\n' >"$txn/evidence/result.env"
cat >"$stage2/simple" <<'COMPILER'
#!/bin/sh
set -eu
[ ! -e '@CONTROL@/runtime' ] || printf 'changed\n' >>'@RUNTIME@/runtime.c'
[ ! -e '@CONTROL@/git' ] || printf 'changed=true\n' >>'@GIT@'
out= prev=
for arg in "$@"; do [ "$prev" != -o ] || out=$arg; prev=$arg; done
cat >"$out" <<'PLANNER'
#!/bin/sh
set -eu
reason= target= parent= runtime= closure= planner= receipt=
for arg in "$@"; do case "$arg" in
--bootstrap-reason=*) reason=${arg#*=};; --bootstrap-target=*) target=${arg#*=};;
--parent-compiler-sha256=*) parent=${arg#*=};; --runtime-snapshot-sha256=*) runtime=${arg#*=};;
--planner-source-closure-sha256=*) closure=${arg#*=};; --planner-sha256=*) planner=${arg#*=};;
--bootstrap-receipt=*) receipt=${arg#*=};; esac; done
[ "$target:$reason" = //bootstrap:stage3:seed-missing ] || exit 2
printf '%s\n' "simple-bootstrap-authorization-v2|producer=simple-build-planner-v2|target=$target|reason=$reason|parent_sha256=$parent|runtime_sha256=$runtime|source_closure_sha256=$closure|planner_sha256=$planner" >"$receipt"
PLANNER
chmod +x "$out"
COMPILER
sed -i "s#@CONTROL@#$control#g;s#@RUNTIME@#$runtime#g;s#@GIT@#$git_state#g" "$stage2/simple"
chmod +x "$stage2/simple"
exec 4<"$verifier" 5<"$stage2/simple" 6<"$stage2/stage2-sanity.receipt" \
    7<"$stage2/stage2-provenance.receipt" 8<"$runtime" 9<"$source" 10<"$txn" 11<"$git_state"

invoke() {
    capsule_fd=$1; sanity_fd=${2:-6}; sanity_display=${3:-$stage2/stage2-sanity.receipt}; git_display=${4:-$git_state}
    sh "$producer" --capsule-root="$capsule_fd" --verifier-descriptor="/proc/$$/fd/4" \
      --root="$repo" --target=//bootstrap:stage3 --reason=seed-missing \
      --stage2-transaction-descriptor="/proc/$$/fd/10" --stage2-transaction-display="$txn" \
      --parent-compiler-descriptor="/proc/$$/fd/5" --parent-compiler-display="$stage2/simple" \
      --parent-compiler-transaction-relative=output/stage2/triple/simple \
      --parent-sanity-descriptor="/proc/$$/fd/$sanity_fd" --parent-sanity-display="$sanity_display" \
      --parent-sanity-transaction-relative=output/stage2/triple/stage2-sanity.receipt \
      --parent-provenance-descriptor="/proc/$$/fd/7" --parent-provenance-display="$stage2/stage2-provenance.receipt" \
      --parent-provenance-transaction-relative=output/stage2/triple/stage2-provenance.receipt \
      --runtime-dir-descriptor="/proc/$$/fd/8" --runtime-dir-display="$runtime" \
      --planner-source-descriptor="/proc/$$/fd/9" --planner-source-display="$source" \
      --git-state-descriptor="/proc/$$/fd/11" --git-state-display="$git_display"
}

mkdir "$fixture/runtime-case"; exec 3<"$fixture/runtime-case"; : >"$control/runtime"
if invoke "/proc/$$/fd/3" >"$fixture/runtime.log" 2>&1; then echo 'FAIL runtime mutation' >&2; exit 1; fi
grep -q runtime-directory-changed-during-admission "$fixture/runtime.log"
rm "$control/runtime"; printf 'int runtime(void) { return 0; }\n' >"$runtime/runtime.c"; exec 3<&-

mkdir "$fixture/git-case"; exec 3<"$fixture/git-case"; : >"$control/git"
if invoke "/proc/$$/fd/3" >"$fixture/git.log" 2>&1; then echo 'FAIL git mutation' >&2; exit 1; fi
grep -q git-state-changed-during-admission "$fixture/git.log"
rm "$control/git"; printf 'schema=coordinator-git-state-v1\nhead=fixture\n' >"$git_state"; exec 3<&-

mkdir -p "$fixture/other" "$fixture/unrelated-case"
cp "$stage2/stage2-sanity.receipt" "$fixture/other/stage2-sanity.receipt"
exec 12<"$fixture/other/stage2-sanity.receipt"; exec 3<"$fixture/unrelated-case"
if invoke "/proc/$$/fd/3" 12 "$fixture/other/stage2-sanity.receipt" >"$fixture/unrelated.log" 2>&1; then echo 'FAIL unrelated Stage2' >&2; exit 1; fi
grep -q parent-stage2-transaction-identity-mismatch "$fixture/unrelated.log"; exec 3<&-

mkdir "$fixture/git-display-case"; exec 3<"$fixture/git-display-case"
if invoke "/proc/$$/fd/3" 6 "$stage2/stage2-sanity.receipt" "$fixture/wrong-git-state.env" >"$fixture/git-display.log" 2>&1; then echo 'FAIL git display' >&2; exit 1; fi
grep -q capsule-input-display-mismatch "$fixture/git-display.log"; exec 3<&-

capsule="$fixture/good"; mkdir "$capsule"; exec 3<"$capsule"
invoke "/proc/$$/fd/3" >"$fixture/good.log" 2>&1
receipt="$capsule/planner-admission-v2.env"
[ "$(wc -l <"$receipt" | tr -d ' ')" -eq 29 ]
grep -Fxq "git_state_path=$git_state" "$receipt"
. "/proc/$$/fd/4"
bootstrap_planner_v2_verify "/proc/$$/fd/3/planner-admission-v2.env" "$repo" "/proc/$$/fd/3" >/dev/null

# The transaction walk rejects an intermediate symlink even when its final
# inode is the same held compiler.
mkdir -p "$fixture/symlink-txn/output/stage2"
ln -s "$stage2" "$fixture/symlink-txn/output/stage2/triple"
exec 13<"$fixture/symlink-txn"
if bootstrap_planner_v2_transaction_child_descriptor "/proc/$$/fd/13" \
    output/stage2/triple/simple "/proc/$$/fd/5"; then
    echo 'FAIL intermediate Stage2 symlink' >&2; exit 1
fi
if bootstrap_planner_v2_transaction_child_descriptor "/proc/$$/fd/10" \
    'output/stage2/*/simple' "/proc/$$/fd/5"; then
    echo 'FAIL glob-like Stage2 relative path' >&2; exit 1
fi

# Each held Stage2 authority descriptor remains correlated to the same child
# inode when the public verifier is called after production.
for authority in simple stage2-sanity.receipt stage2-provenance.receipt; do
    mv "$stage2/$authority" "$stage2/$authority.held"
    cp -p "$stage2/$authority.held" "$stage2/$authority"
    if bootstrap_planner_v2_verify "/proc/$$/fd/3/planner-admission-v2.env" "$repo" "/proc/$$/fd/3" >/dev/null 2>&1; then
        echo "FAIL replaced Stage2 $authority" >&2; exit 1
    fi
    rm "$stage2/$authority"
    mv "$stage2/$authority.held" "$stage2/$authority"
done

printf 'changed=true\n' >>"$git_state"
if bootstrap_planner_v2_verify "/proc/$$/fd/3/planner-admission-v2.env" "$repo" "/proc/$$/fd/3" >/dev/null 2>&1; then
    echo 'FAIL post-production git bytes' >&2; exit 1
fi
printf 'schema=coordinator-git-state-v1\nhead=fixture\n' >"$git_state"
cp "$capsule/descriptor-bindings.env" "$fixture/bindings.saved"
sed 's#^git_state_display=.*#git_state_display=/wrong/display#' \
    "$fixture/bindings.saved" >"$capsule/descriptor-bindings.env"
if bootstrap_planner_v2_verify "/proc/$$/fd/3/planner-admission-v2.env" "$repo" "/proc/$$/fd/3" >/dev/null 2>&1; then
    echo 'FAIL post-production git display' >&2; exit 1
fi
cp "$fixture/bindings.saved" "$capsule/descriptor-bindings.env"

printf 'post-production-change\n' >>"$runtime/runtime.c"
if bootstrap_planner_v2_verify "/proc/$$/fd/3/planner-admission-v2.env" "$repo" "/proc/$$/fd/3" >/dev/null 2>&1; then echo 'FAIL post runtime mutation' >&2; exit 1; fi
echo 'PASS: corrected planner capsule binds runtime, committed Stage2 children, and coordinator Git state'

