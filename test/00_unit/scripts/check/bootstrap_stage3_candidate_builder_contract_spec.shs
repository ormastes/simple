#!/bin/sh
set -eu

builder=${1:?usage: bootstrap_stage3_candidate_builder_contract_spec.shs BUILDER}
test_root=$(mktemp -d "${TMPDIR:-/tmp}/candidate-builder-contract.XXXXXX")
trap 'rm -rf "$test_root"' EXIT HUP INT TERM
mkdir -p "$test_root/out"
sha=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

expect_64() {
  set +e
  "$@" >/dev/null 2>&1
  status=$?
  set -e
  [ "$status" -eq 64 ] || {
    echo "expected status 64, got $status: $*" >&2
    exit 1
  }
}

expect_64 "$builder"
expect_64 "$builder" --not-a-builder-option
expect_64 "$builder" --jobs=1 --jobs=1
expect_64 "$builder" --jobs=1 --supervised-stage3 \
  --repository-root="$test_root" --evidence-run-id=stage3_test \
  --rss-raw="$test_root/raw" --rss-sampler="$test_root/sampler" \
  --rss-sampler-sha256="$sha" --admitted-compiler="$test_root/compiler" \
  --admitted-compiler-sha256="$sha" \
  --compatibility-marker="$test_root/compatibility" \
  --runner-plan="$test_root/plan" --runner-plan-sha256="$sha" \
  --env-tool="$test_root/env" --planner-admission="$test_root/planner"

! grep -q 'output="\$root/\$source_output"' "$builder"
! grep -q 'rm -rf' "$builder"
! grep -q 'bootstrap_stage3_source_snapshot "\$source_before"' "$builder"
echo "candidate builder contract: 7/7 pass"

