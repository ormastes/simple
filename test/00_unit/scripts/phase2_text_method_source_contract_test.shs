#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)

devhub="$root/src/app/devhub/convert_storage.spl"
if grep -F '.char_count()' "$devhub" >/dev/null; then
    echo "FAIL: DevHub uses the Phase 2 native char_count method gap" >&2
    exit 1
fi
grep -F 'utext_chars(s)' "$devhub" >/dev/null

for lane in cuda vulkan metal; do
    owner="$root/src/lib/gc_async_mut/gpu_lane/${lane}_vm_executor.spl"
    if grep -F '.to_i64_opt()' "$owner" >/dev/null; then
        echo "FAIL: $lane VM uses unresolved to_i64_opt" >&2
        exit 1
    fi
    grep -F 'raw.trim().parse_int()' "$owner" >/dev/null
done

echo "PASS: Phase 2 text methods use admitted native spellings"
