#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
helper="$root/scripts/bootstrap/workarounds/hir-worker-diagnostics.shs"
# Actual sourceable helper, not a model of its implementation.
unset SIMPLE_HIR_SHARDING
. "$helper"
test "${SIMPLE_HIR_SHARDING+x}" != x
SIMPLE_HIR_SHARDING=1
export SIMPLE_HIR_SHARDING
. "$helper"
test "$SIMPLE_HIR_SHARDING" = 1
SIMPLE_NO_STUB_FALLBACK=1
SIMPLE_FRONTEND_CACHE=1
SIMPLE_HIR_CACHE=1
export SIMPLE_NO_STUB_FALLBACK SIMPLE_FRONTEND_CACHE SIMPLE_HIR_CACHE
(
    simple_enable_hir_worker_diagnostics_workaround
    test "$SIMPLE_HIR_SHARDING" = 0
    test "$SIMPLE_NO_STUB_FALLBACK" = 1
    test "$SIMPLE_FRONTEND_CACHE" = 1
    test "$SIMPLE_HIR_CACHE" = 1
    sh -c 'test "$SIMPLE_HIR_SHARDING" = 0'
)
test "$SIMPLE_HIR_SHARDING" = 1
set +e
(simple_enable_hir_worker_diagnostics_workaround; sh -c 'exit 7')
result=$?
set -e
test "$result" = 7
printf '%s\n' 'PASS: explicit opt-in, default preservation, inherited flag, unrelated controls, subshell isolation, child failure propagation'
