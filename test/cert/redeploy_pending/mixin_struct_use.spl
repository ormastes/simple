# REDEPLOY-PENDING expected-behavior spec for cert redeploy kit item 4b.
#
# `struct X: use SomeMixin` must inject the mixin's field(s) and method(s) the
# same way `class` does (or be rejected at compile time — but NEVER run to
# completion leaking a fabricated "error" string to stdout).
#
# Expected stdout after the mixin-injection fix is redeployed:
#   15
#   Alice
#
# On the FROZEN deployed binary the injected method is not wired up: stderr gets
# "Runtime error: Function 'Player.add_score' not found", stdout gets "error"
# then "0", and the process still exits 0.
mixin Scorable:
    score: i64

    fn add_score(n: i64) -> i64:
        return self.score + n

struct Player:
    use Scorable
    name: text

fn main():
    val p = Player(score: 10, name: "Alice")
    print(p.add_score(5))   # expected 15
    print(p.name)           # expected Alice
