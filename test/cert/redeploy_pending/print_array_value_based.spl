# REDEPLOY-PENDING expected-behavior spec for cert redeploy kit item 1.
#
# print(array) must render element VALUES, not an ASLR-nondeterministic heap
# address tag like `<array@0x...>`.
#
# Expected stdout after the io_print.rs fix is redeployed:
#   [1, 2, 3]
#   [[1, 2], [3]]
#   []
#
# On the FROZEN deployed binary this prints `<array@0x...>` — that is why this
# spec lives under test/cert/redeploy_pending/ (NOT run by the normal suite).
fn main():
    print([1, 2, 3])
    print([[1, 2], [3]])
    val empty: [i64] = []
    print(empty)
