# REDEPLOY-PENDING expected-behavior spec for cert redeploy kit item 4a.
#
# `class X: use SomeMixin` must inject the mixin's field(s) and method(s) so the
# injected method call and injected field read return the constructed values.
#
# Expected stdout after the mixin-injection fix is redeployed:
#   15
#   Alice
#
# On the FROZEN deployed binary this prints a raw heap-value tag and `0.0`.
mixin Scorable:
    score: i64

    fn add_score(n: i64) -> i64:
        return self.score + n

class Player:
    use Scorable
    name: text

fn main():
    val p = Player(score: 10, name: "Alice")
    print(p.add_score(5))   # expected 15
    print(p.name)           # expected Alice
