# REDEPLOY-PENDING expected-behavior spec for cert redeploy kit item 3.
#
# Calling a trait DEFAULT method that a struct inherits WITHOUT overriding it
# must execute the default body.
#
# Expected stdout after the virtual-dispatch fix is redeployed:
#   Yo
#   Good day
#
# On the FROZEN deployed binary the second call SEGFAULTs (exit 139). Lives
# under redeploy_pending/ because it crashes on the frozen binary.
trait Greetable:
    fn greet_formal() -> text:
        "Good day"
    fn greet_casual() -> text:
        "Hey"

struct Person:
    name: text

impl Greetable for Person:
    fn greet_casual() -> text:
        "Yo"

fn main():
    val p = Person(name: "Alice")
    print(p.greet_casual())   # expected "Yo"
    print(p.greet_formal())   # expected "Good day" (inherited default)
