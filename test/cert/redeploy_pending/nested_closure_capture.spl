# REDEPLOY-PENDING expected-behavior spec for cert redeploy kit item 5.
#
# A closure lexically nested inside another closure's body must be able to READ
# a variable captured by the enclosing closure.
#
# Expected stdout after the transitive-capture fix is redeployed:
#   36
#
# On the FROZEN deployed binary this silently prints 0 (the inner closure reads
# 0 for the outer-of-outer `base` instead of its real value 10).
fn main():
    val base = 10
    val mul = 3
    val combo = \x:
        val step = \y: y + base
        step(x) * mul
    print(combo(2))   # expected (2 + 10) * 3 = 36
