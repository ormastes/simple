# OPEN DEFECT repro (NOT gated by the runner). See README.md.
# A `me`-receiver method `m3/3` called with 4 arguments SHOULD be rejected
# (TOR-FM-02). On the deployed binary it is accepted and the extra argument
# displaces the receiver: the program dies with
# "runtime error: field access on nil receiver" and dumps core.
# Unlike the free-function too-many case (extra arg silently dropped, exit 0),
# the method form is a CRASH.
class Box:
    var base: i64 = 0
    fn m3(a: i64, b: i64, c: i64) -> i64:
        return self.base + c * 1000 + a * 10 + b

fn main():
    var bx = Box(base: 0)
    print(bx.m3(7, 8, 9, 11))
