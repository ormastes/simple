# OPEN DEFECT repro (NOT gated by the runner). See README.md.
# A `static fn s3/3` called with 2 arguments SHOULD be rejected (TOR-FM-02).
# On the deployed binary it is silently ACCEPTED and the missing parameter
# reads as the nil sentinel 3, so this prints 3078 instead of 9078. Exit 0.
struct Util:
    dummy: i64

impl Util:
    static fn s3(a: i64, b: i64, c: i64) -> i64:
        return c * 1000 + a * 10 + b

fn main():
    print(Util.s3(7, 8))
