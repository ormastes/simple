"""
## Purpose and audience

Security spec — salt/IV/nonce generators must use the OS CSPRNG.

Regression guard for the weak-randomness family swept on 2026-08-08:

  - `std.bcrypt.salt.generate_random_bytes` used a constant-seeded LCG
    (seed=12345), so every bcrypt salt and every password-reset token
    was byte-for-byte identical. Its exact old output for count=4 was
    126,223,44,245.
  - `tls._TlsUtilities.hex_encoding.generate_random` used an LCG seeded
    ONLY from the `length` argument, so TLS server_random was constant
    for a given length across every handshake and every process. Its
    exact old output for length=4 was 180,2,59,33.

Both now draw from the OS CSPRNG via the `rt_random_i64` extern.

This specification is maintained for compiler and library engineers reviewing SECURITY-CSPRNG_SALT_IV behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/07_security/csprng_salt_iv_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-SECURITY-CSPRNG_SALT_IV-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
use std.spec
use lib.common.bcrypt.salt.{generate_random_bytes}
use lib.nogc_sync_mut.tls.utilities.{generate_random}

# Exact byte sequences the old, broken LCGs produced. If a generator
# ever emits these again, it has regressed to the seeded PRNG.
val OLD_BCRYPT_LCG_0: i64 = 126
val OLD_BCRYPT_LCG_1: i64 = 223
val OLD_TLS_LCG_0: i64 = 180
val OLD_TLS_LCG_1: i64 = 2

describe "CSPRNG-backed salt and nonce generation":

    it "bcrypt generate_random_bytes does not reproduce the old LCG stream":
        # @req: REQ-SECURITY-CSPRNG_SALT_IV-001
        step("Verify: bcrypt generate_random_bytes does not reproduce the old LCG stream")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = generate_random_bytes(4)
        val a0: i64 = a[0]
        val a1: i64 = a[1]
        expect(a0 == OLD_BCRYPT_LCG_0 and a1 == OLD_BCRYPT_LCG_1) == false

    it "bcrypt generate_random_bytes returns distinct output on successive calls":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SECURITY-CSPRNG_SALT_IV-002
        step("Verify: bcrypt generate_random_bytes returns distinct output on successive calls")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = generate_random_bytes(16)
        val b = generate_random_bytes(16)
        var same = 0
        var i = 0
        while i < 16:
            val av: i64 = a[i]
            val bv: i64 = b[i]
            if av == bv:
                same = same + 1
            i = i + 1
        # 16 identical bytes from a real CSPRNG has probability 2^-128.
        expect same < 16

    it "bcrypt generate_random_bytes yields in-range bytes":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SECURITY-CSPRNG_SALT_IV-003
        step("Verify: bcrypt generate_random_bytes yields in-range bytes")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = generate_random_bytes(16)
        var bad = 0
        var i = 0
        while i < 16:
            val av: i64 = a[i]
            if av < 0:
                bad = bad + 1
            if av > 255:
                bad = bad + 1
            i = i + 1
        expect bad == 0
        expect a.length() == 16

    it "TLS generate_random does not reproduce the old length-seeded LCG stream":
        # @req: REQ-SECURITY-CSPRNG_SALT_IV-004
        step("Verify: TLS generate_random does not reproduce the old length-seeded LCG stream")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t = generate_random(4)
        val t0: i64 = t[0]
        val t1: i64 = t[1]
        expect(t0 == OLD_TLS_LCG_0 and t1 == OLD_TLS_LCG_1) == false

    it "TLS generate_random returns distinct output on successive calls":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SECURITY-CSPRNG_SALT_IV-005
        step("Verify: TLS generate_random returns distinct output on successive calls")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val a = generate_random(32)
        val b = generate_random(32)
        var same = 0
        var i = 0
        while i < 32:
            val av: i64 = a[i]
            val bv: i64 = b[i]
            if av == bv:
                same = same + 1
            i = i + 1
        expect same < 32

    it "TLS generate_random yields in-range bytes of the requested length":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-SECURITY-CSPRNG_SALT_IV-006
        step("Verify: TLS generate_random yields in-range bytes of the requested length")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        val t = generate_random(32)
        var bad = 0
        var i = 0
        while i < 32:
            val tv: i64 = t[i]
            if tv < 0:
                bad = bad + 1
            if tv > 255:
                bad = bad + 1
            i = i + 1
        expect bad == 0
        expect t.length() == 32
