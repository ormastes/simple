"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SHARED-CORE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/shared/core/arithmetic_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-SHARED-CORE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @platform: all
# Arithmetic Operations Specification
#
# Tests basic arithmetic operations including addition, subtraction,
# multiplication, division, and operator precedence rules.

describe "Arithmetic":
    # Tests for core arithmetic operations on numeric types.
    # Verifies correct behavior of mathematical operators.
    describe "addition":
        it "adds two numbers":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-001
            step("Verify: adds two numbers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect 1 + 1 == 2
        it "adds multiple numbers":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-002
            step("Verify: adds multiple numbers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect 1 + 2 + 3 == 6

    describe "subtraction":
        it "subtracts two numbers":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-003
            step("Verify: subtracts two numbers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect 5 - 3 == 2
        it "subtracts to zero":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-004
            step("Verify: subtracts to zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect 5 - 5 == 0

    describe "multiplication":
        it "multiplies two numbers":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-005
            step("Verify: multiplies two numbers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect 3 * 4 == 12
        it "multiplies by zero":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-006
            step("Verify: multiplies by zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect 5 * 0 == 0

    describe "division":
        it "divides evenly":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-007
            step("Verify: divides evenly")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect 10 / 2 == 5
        it "integer division":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-008
            step("Verify: integer division")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect 7 / 2 == 3

    describe "precedence":
        it "multiplication before addition":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-009
            step("Verify: multiplication before addition")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect 2 + 3 * 4 == 14
        it "parentheses override precedence":
            # @req: REQ-SHARED-CORE-010
            step("Verify: parentheses override precedence")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect (2 + 3) * 4 == 20
