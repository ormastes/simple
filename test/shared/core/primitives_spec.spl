# @platform: all
# Tests for primitive types in the Simple language.
#
# Covers basic operations on integers and booleans including
# arithmetic, comparisons, and logical operations.

"""
## Purpose and audience
Purpose: handles positive integers
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-CORE-Prim-001

use std.spec.step
describe "Primitives":
    # Tests for primitive data types: integers and booleans.
    # Verifies basic operations and edge cases.

    describe "integers":
        it "handles positive integers":
            step("Verify: handles positive integers")
            # @req: REQ-CORE-Prim-001
            expect(40 + 2).to_equal(42)  # oracle: value fixed by the spec contract
        it "handles zero":
            step("Verify: handles zero")
            # @req: REQ-CORE-Prim-001
            expect(7 - 7).to_equal(0)  # oracle: value fixed by the spec contract
        it "handles negative with parens":
            step("Verify: handles negative with parens")
            # @req: REQ-CORE-Prim-001
            expect(0 - 1).to_equal(-1)  # oracle: value fixed by the spec contract

    describe "booleans":
        it "handles true":
            step("Verify: handles true")
            # @req: REQ-CORE-Prim-001
            if not true:
                fail("true should be truthy")
        it "handles false":
            step("Verify: handles false")
            # @req: REQ-CORE-Prim-001
            if false:
                fail("false should not be truthy")
        it "negates correctly":
            step("Verify: negates correctly")
            # @req: REQ-CORE-Prim-001
            if not (not false):
                fail("not false should be truthy")
