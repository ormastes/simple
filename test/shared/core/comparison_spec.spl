"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SHARED-CORE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/shared/core/comparison_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-SHARED-CORE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @platform: all
# Comparison Operations Specification
#
# Tests comparison and logical operators including equality, inequality,
# ordering comparisons, and boolean logic operators.

describe "Comparisons":
    # Tests for comparison operators and logical operations.
    # Verifies correct behavior of equality, ordering, and boolean logic.
    describe "equality":
        it "equal values are equal":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-001
            step("Verify: equal values are equal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect 5 == 5
        it "unequal values are not equal":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-002
            step("Verify: unequal values are not equal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect 5 != 6

    describe "less than":
        it "smaller is less":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-003
            step("Verify: smaller is less")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect 3 < 5
        it "equal is not less":
            # @req: REQ-SHARED-CORE-004
            step("Verify: equal is not less")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect (not (5 < 5))

    describe "greater than":
        it "larger is greater":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-005
            step("Verify: larger is greater")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect 5 > 3
        it "equal is not greater":
            # @req: REQ-SHARED-CORE-006
            step("Verify: equal is not greater")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect (not (5 > 5))

    describe "less than or equal":
        it "smaller is less or equal":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-007
            step("Verify: smaller is less or equal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect 3 <= 5
        it "equal is less or equal":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-008
            step("Verify: equal is less or equal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect 5 <= 5

    describe "greater than or equal":
        it "larger is greater or equal":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-009
            step("Verify: larger is greater or equal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect 5 >= 3
        it "equal is greater or equal":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-010
            step("Verify: equal is greater or equal")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect 5 >= 5

    describe "logical operators":
        it "and requires both":
            # @req: REQ-SHARED-CORE-011
            step("Verify: and requires both")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect (true and true)
        it "and fails if one false":
            # @req: REQ-SHARED-CORE-012
            step("Verify: and fails if one false")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect (not (true and false))
        it "or requires one":
            # @req: REQ-SHARED-CORE-013
            step("Verify: or requires one")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect (true or false)
        it "or fails if both false":
            # @req: REQ-SHARED-CORE-014
            step("Verify: or fails if both false")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect (not (false or false))
