# @platform: all
"""## Purpose and audience
Sanity evidence that the SPipe test framework loads, steps, asserts, and reads
files on this host. Audience: engineers validating a fresh toolchain deploy
before trusting any other spec's verdict.
## Operator workflow
Run one command from the repository root:
`./src/compiler_rust/target/bootstrap/simple run test/shared/core/hello_spec.spl`
and read the per-scenario verdict line.
## Compatibility and limitations
Exercises only the framework's own execution path; it proves nothing about
product modules. The file-read scenario uses a repository-root-relative path.
## Verification guidance and troubleshooting
A failed scenario means the runner itself is broken: verify the deployed
binary identity before investigating any product spec. Every expected value
is a framework constant and is marked with an inline oracle comment.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @req REQ-SSPEC-SANITY
use std.spec.step
use std.io_runtime.{file_read}

# @manual_section: framework sanity
describe "Hello":
    it "asserts arithmetic through the runner":
        # @req REQ-SSPEC-SANITY
        # @capture(statistics): runner verdict counts for this scenario
        step("Execute one arithmetic assertion through the runner")
        expect(1 + 1).to_equal(2)  # oracle: the runner must evaluate arithmetic, not fold constants

    it "reads a repository file through the io runtime":
        # @req REQ-SSPEC-SANITY
        # @capture(statistics): runner verdict counts for this scenario
        step("Read this spec through the runner's io runtime")
        val spec_source = file_read("test/shared/core/hello_spec.spl") ?? ""
        val spec_has_scenario_root = spec_source.contains("describe")
        expect(spec_has_scenario_root).to_equal(true)  # oracle: a loaded spec source must contain its own scenario root

    it "lowers text through the stdlib string core":
        # @req REQ-SSPEC-SANITY
        # @capture(statistics): runner verdict counts for this scenario
        step("Lower one string through the stdlib string core")
        val lowered = "HELLO".lower()
        expect(lowered).to_equal("hello")

    it "rejects an always-false guard condition":
        # @req REQ-SSPEC-SANITY
        # @capture(statistics): runner verdict counts for this scenario
        step("Evaluate an always-false guard through the runner")
        expect(not (1 > 2)).to_equal(true)  # oracle: the runner executes the condition itself rather than skipping the branch
