"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SHARED-CORE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/shared/core/math_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-SHARED-CORE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @platform: all
# Math Module Specification
#
# Tests for core math operations (Features #220-229). Covers basic operations
# (abs, sign), min/max, clamping, integer math (factorial, gcd, lcm),
# and comparison helpers - all implemented inline without external modules.

# Helper functions for math operations (inline, no module dependency)
fn abs_val(x: i64) -> i64:
    if x < 0: return -x
    return x

fn sign_val(x: i64) -> i64:
    if x > 0: return 1
    if x < 0: return -1
    return 0

fn min_val(a: i64, b: i64) -> i64:
    if a < b: return a
    return b

fn max_val(a: i64, b: i64) -> i64:
    if a > b: return a
    return b

fn clamp_val(x: i64, lo: i64, hi: i64) -> i64:
    if x < lo: return lo
    if x > hi: return hi
    return x

fn factorial(n: i64) -> i64:
    if n <= 1: return 1
    return n * factorial(n - 1)

fn gcd(a: i64, b: i64) -> i64:
    var x = a
    var y = b
    if x < 0: x = -x
    if y < 0: y = -y
    for _ in 0..100:
        if y == 0: return x
        val temp = y
        y = x % y
        x = temp
    return x

fn lcm(a: i64, b: i64) -> i64:
    if a == 0 or b == 0: return 0
    val g = gcd(a, b)
    return (a / g) * b

describe "Math operations":
    # Validates core math operations including abs, sign, min/max, clamping,
    # integer math, and comparison helpers.
    context "Basic operations":
        it "abs returns absolute value of negative":
            # @req: REQ-SHARED-CORE-001
            step("Verify: abs returns absolute value of negative")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(abs_val(-5)).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

        it "abs of positive is unchanged":
            # @req: REQ-SHARED-CORE-002
            step("Verify: abs of positive is unchanged")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(abs_val(5)).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

        it "abs of zero is zero":
            # @req: REQ-SHARED-CORE-003
            step("Verify: abs of zero is zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(abs_val(0)).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "sign returns -1 for negative":
            # @req: REQ-SHARED-CORE-004
            step("Verify: sign returns -1 for negative")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(sign_val(-5)).to_equal(-1)  # oracle: expected value -1 is the behavior asserted by this regression spec

        it "sign returns 1 for positive":
            # @req: REQ-SHARED-CORE-005
            step("Verify: sign returns 1 for positive")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(sign_val(5)).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "sign returns 0 for zero":
            # @req: REQ-SHARED-CORE-006
            step("Verify: sign returns 0 for zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(sign_val(0)).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    context "Min/Max functions":
        it "min returns smaller value":
            # @req: REQ-SHARED-CORE-007
            step("Verify: min returns smaller value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(min_val(3, 5)).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec

        it "min with equal values":
            # @req: REQ-SHARED-CORE-008
            step("Verify: min with equal values")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(min_val(4, 4)).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

        it "min with negative":
            # @req: REQ-SHARED-CORE-009
            step("Verify: min with negative")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(min_val(-3, 5)).to_equal(-3)  # oracle: expected value -3 is the behavior asserted by this regression spec

        it "max returns larger value":
            # @req: REQ-SHARED-CORE-010
            step("Verify: max returns larger value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(max_val(3, 5)).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

        it "max with equal values":
            # @req: REQ-SHARED-CORE-011
            step("Verify: max with equal values")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(max_val(4, 4)).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

        it "max with negative":
            # @req: REQ-SHARED-CORE-012
            step("Verify: max with negative")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(max_val(-3, 5)).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

    context "Clamping":
        it "clamp within range returns value":
            # @req: REQ-SHARED-CORE-013
            step("Verify: clamp within range returns value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(clamp_val(5, 0, 10)).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

        it "clamp below range returns min":
            # @req: REQ-SHARED-CORE-014
            step("Verify: clamp below range returns min")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(clamp_val(-5, 0, 10)).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

        it "clamp above range returns max":
            # @req: REQ-SHARED-CORE-015
            step("Verify: clamp above range returns max")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(clamp_val(15, 0, 10)).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec

        it "clamp at boundaries":
            # @req: REQ-SHARED-CORE-016
            step("Verify: clamp at boundaries")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(clamp_val(0, 0, 10)).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec
            expect(clamp_val(10, 0, 10)).to_equal(10)  # oracle: expected value 10 is the behavior asserted by this regression spec

    context "Integer math":
        it "factorial computes 5!":
            # @req: REQ-SHARED-CORE-017
            step("Verify: factorial computes 5!")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(factorial(5)).to_equal(120)  # oracle: expected value 120 is the behavior asserted by this regression spec

        it "factorial of 0 is 1":
            # @req: REQ-SHARED-CORE-018
            step("Verify: factorial of 0 is 1")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(factorial(0)).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "factorial of 1 is 1":
            # @req: REQ-SHARED-CORE-019
            step("Verify: factorial of 1 is 1")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(factorial(1)).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "factorial of 10":
            # @req: REQ-SHARED-CORE-020
            step("Verify: factorial of 10")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(factorial(10)).to_equal(3628800)  # oracle: expected value 3628800 is the behavior asserted by this regression spec

        it "gcd computes greatest common divisor":
            # @req: REQ-SHARED-CORE-021
            step("Verify: gcd computes greatest common divisor")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(gcd(12, 8)).to_equal(4)  # oracle: expected value 4 is the behavior asserted by this regression spec

        it "gcd of coprime numbers is 1":
            # @req: REQ-SHARED-CORE-022
            step("Verify: gcd of coprime numbers is 1")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(gcd(7, 13)).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "gcd with zero":
            # @req: REQ-SHARED-CORE-023
            step("Verify: gcd with zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(gcd(5, 0)).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec
            expect(gcd(0, 5)).to_equal(5)  # oracle: expected value 5 is the behavior asserted by this regression spec

        it "lcm computes least common multiple":
            # @req: REQ-SHARED-CORE-024
            step("Verify: lcm computes least common multiple")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(lcm(4, 6)).to_equal(12)  # oracle: expected value 12 is the behavior asserted by this regression spec

        it "lcm of coprime numbers":
            # @req: REQ-SHARED-CORE-025
            step("Verify: lcm of coprime numbers")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(lcm(3, 5)).to_equal(15)  # oracle: expected value 15 is the behavior asserted by this regression spec

        it "lcm with zero":
            # @req: REQ-SHARED-CORE-026
            step("Verify: lcm with zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(lcm(0, 5)).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    context "Arithmetic properties":
        it "addition is commutative":
            # @req: REQ-SHARED-CORE-027
            step("Verify: addition is commutative")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(3 + 5).to_equal(5 + 3)

        it "multiplication is commutative":
            # @req: REQ-SHARED-CORE-028
            step("Verify: multiplication is commutative")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(3 * 5).to_equal(5 * 3)

        it "multiplication distributes over addition":
            # @req: REQ-SHARED-CORE-029
            step("Verify: multiplication distributes over addition")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(3 * (4 + 5)).to_equal(3 * 4 + 3 * 5)

        it "integer division truncates toward zero":
            # @req: REQ-SHARED-CORE-030
            step("Verify: integer division truncates toward zero")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(7 / 2).to_equal(3)  # oracle: expected value 3 is the behavior asserted by this regression spec
            expect(-7 / 2).to_equal(-3)  # oracle: expected value -3 is the behavior asserted by this regression spec

        it "modulo gives remainder":
            # @req: REQ-SHARED-CORE-031
            step("Verify: modulo gives remainder")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            expect(7 % 3).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
            expect(10 % 5).to_equal(0)  # oracle: expected value 0 is the behavior asserted by this regression spec

    context "Power via repeated multiplication":
        it "computes x^0 = 1":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CORE-032
            step("Verify: computes x^0 = 1")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val base = 5
            expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec

        it "computes 2^10 = 1024":
            # @req: REQ-SHARED-CORE-033
            step("Verify: computes 2^10 = 1024")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var result = 1
            for _ in 0..10:
                result = result * 2
            expect(result).to_equal(1024)  # oracle: expected value 1024 is the behavior asserted by this regression spec

        it "computes 3^5 = 243":
            # @req: REQ-SHARED-CORE-034
            step("Verify: computes 3^5 = 243")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var result = 1
            for _ in 0..5:
                result = result * 3
            expect(result).to_equal(243)  # oracle: expected value 243 is the behavior asserted by this regression spec
