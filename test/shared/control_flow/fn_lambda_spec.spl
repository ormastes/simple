"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SHARED-CONTROL_FLOW behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/shared/control_flow/fn_lambda_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-SHARED-CONTROL_FLOW-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @platform: all
# # Lambda Syntax fn() Specification
#
# **Category:** Syntax
# **Status:** Implemented
#
# Tests for fn() lambda syntax and its interchangeability with the \\ operator.
# The fn() syntax provides an alternative way to define lambdas and is compatible
# with BDD framework blocks like describe/context/it.


describe "fn() Lambda Syntax":
    # Verifies the fn() lambda syntax for defining anonymous functions.
    # This syntax is an alias for the backslash operator (\:) and supports
    # parameters, multiple expressions, and nested contexts.

    describe "basic inline lambdas":
        # Tests basic fn() lambda syntax with simple expressions.

        it "supports fn() with no parameters":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CONTROL_FLOW-001
            step("Verify: supports fn() with no parameters")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn call_it(f) -> i64:
                f()

            val result = call_it(fn(): 42)
            expect result == 42

        it "supports fn(x) with single parameter":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CONTROL_FLOW-002
            step("Verify: supports fn(x) with single parameter")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn apply(x: i64, f) -> i64:
                f(x)

            val result = apply(5, fn(n): n * 2)
            expect result == 10

        it "supports fn(x, y) with multiple parameters":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CONTROL_FLOW-003
            step("Verify: supports fn(x, y) with multiple parameters")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn apply2(x: i64, y: i64, f) -> i64:
                f(x, y)

            val result = apply2(3, 4, fn(a, b): a + b)
            expect result == 7

    describe "block lambdas":
        # Tests fn() syntax with indented blocks containing multiple expressions.

        it "supports fn() with indented block":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CONTROL_FLOW-004
            step("Verify: supports fn() with indented block")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn execute(f) -> i64:
                f()

            fn sum_xy() -> i64:
                val x = 10
                val y = 20
                x + y

            val result = execute(sum_xy)
            expect result == 30

        it "supports fn(x) with parameter and block":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CONTROL_FLOW-005
            step("Verify: supports fn(x) with parameter and block")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn transform(x: i64, f) -> i64:
                f(x)

            fn compute_square(n) -> i64:
                val doubled = n * 2
                val squared = doubled * doubled
                squared

            val result = transform(5, compute_square)
            expect result == 100

    describe "nested lambdas":
        # Tests fn() syntax with nested lambda definitions.

        it "supports nested fn() lambdas":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CONTROL_FLOW-006
            step("Verify: supports nested fn() lambdas")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn outer(f):
                f

            fn inner(g) -> i64:
                g()

            val result = inner(outer(fn(): 99))
            expect result == 99

    describe "compatibility with backslash operator":
        # Verifies that fn() and \\ syntax are interchangeable and can be mixed.

        it "fn() and \\ are interchangeable":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CONTROL_FLOW-007
            step("Verify: fn() and \\\\ are interchangeable")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn test_sum(f1, f2) -> i64:
                f1() + f2()

            # Mix both syntaxes
            val result = test_sum(fn(): 10, \: 20)
            expect result == 30

    describe "used in BDD framework":
        # Tests fn() lambda syntax within BDD framework context blocks.

        it "works with context/it blocks":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CONTROL_FLOW-008
            step("Verify: works with context/it blocks")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            # Closures capture by value: a callback cannot write back to an
            # enclosing function's local var (lint CLOS001). Block execution is
            # therefore observed through the block's RETURN value.
            fn mock_context(name: text, block) -> bool:
                block()

            val executed = mock_context("test", fn(): true)

            expect executed == true

        it "passes context values into the block result":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-CONTROL_FLOW-009
            step("Verify: passes context values into the block result")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            fn mock_context(name: text, x: i64, block) -> i64:
                block(x)

            val doubled = mock_context("test", 21, fn(n): n * 2)

            expect doubled == 42
