# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SHARED
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @platform: all
# Test no-paren method calls

use std.spec.step

describe "No-paren method calls":
    # @manual scenario evidence
    it "list.len works without parens":
        # @req REQ-SSPEC-SHARED
        step("list.len works without parens")
        val list = [1, 2, 3]
        assert_true(list.len == 3)

    it "string.len works without parens":
        # @req REQ-SSPEC-SHARED
        step("string.len works without parens")
        val str = "hello"
        assert_true(str.len == 5)

    it "comparison with no-paren method call":
        # @req REQ-SSPEC-SHARED
        step("comparison with no-paren method call")
        val items = [1, 2, 3, 4, 5]
        if items.len > 3:
            assert_true(true)
        else:
            fail("items.len should be greater than 3")

    it "works in nested expressions":
        # @req REQ-SSPEC-SHARED
        step("works in nested expressions")
        val data = [[1, 2], [3, 4, 5]]
        val total = data[0].len + data[1].len
        assert_true(total == 5)
