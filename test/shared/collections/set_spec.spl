# @platform: all
# Set<T> Type Test Specification
# Comprehensive tests for set behavior using dict-based implementation
#
# Note: The stdlib Set<T> uses Map<T> which calls .hash() on keys,
# but the bootstrap runtime doesn't have a hash method on str type.
# These tests use the built-in dict {} as a set (keys = elements, values = true)
# to verify set-like behavior without depending on .hash().
#
# Important: The bootstrap runtime has a bug where dict mutations inside
# called functions don't propagate back to the caller. Therefore all dict
# mutations (insert, remove, clear) are done inline, not via helper functions.
# Read-only helpers and functions that return new dicts work fine.

# ============================================================================
# Dict-based Set Helper Functions (read-only / return new dict)
# ============================================================================

# Check if dict-set contains item (read-only - works as function)
"""
## Purpose and audience
Purpose: creates empty set with new()
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-COLLECTIONS-Set-001

fn set_contains(s, item):
    s.has(item)

# Clone a dict-set (returns new dict - works as function)
fn set_clone(s):
    var result = {}
    for k in s.keys():
        result[k] = true
    result

# Union of two dict-sets (returns new dict)
fn set_union(s1, s2):
    var result = {}
    for k in s1.keys():
        result[k] = true
    for k in s2.keys():
        result[k] = true
    result

# Intersection of two dict-sets (returns new dict)
fn set_intersection(s1, s2):
    var result = {}
    for k in s1.keys():
        if s2.has(k):
            result[k] = true
    result

# Difference: elements in s1 but not s2 (returns new dict)
fn set_difference(s1, s2):
    var result = {}
    for k in s1.keys():
        if not s2.has(k):
            result[k] = true
    result

# Symmetric difference: elements in either but not both (returns new dict)
fn set_symmetric_difference(s1, s2):
    var result = {}
    for k in s1.keys():
        if not s2.has(k):
            result[k] = true
    for k in s2.keys():
        if not s1.has(k):
            result[k] = true
    result

# Subset check (read-only)
fn set_is_subset(s1, s2):
    for k in s1.keys():
        if not s2.has(k):
            return false
    true

# Superset check (read-only)
fn set_is_superset(s1, s2):
    set_is_subset(s2, s1)

# Disjoint check (read-only)
fn set_is_disjoint(s1, s2):
    for k in s1.keys():
        if s2.has(k):
            return false
    true

# Filter: keep elements matching predicate (returns new dict)
fn set_filter(s, predicate):
    var result = {}
    for k in s.keys():
        if predicate(k):
            result[k] = true
    result

# Map: transform elements (returns new dict)
fn set_map(s, mapper):
    var result = {}
    for k in s.keys():
        val mapped = mapper(k)
        result[mapped] = true
    result

# Any: true if at least one element matches predicate (read-only)
fn set_any(s, predicate):
    for k in s.keys():
        if predicate(k):
            return true
    false

# All: true if all elements match predicate (read-only)
fn set_all(s, predicate):
    for k in s.keys():
        if not predicate(k):
            return false
    true

# Helper to get list element (workaround for chained method bug)
fn _get_item(lst, idx):
    lst[idx]

fn _list_len(lst):
    lst.len()

# Create set from list (returns new dict)
fn set_from_list(items):
    var s = {}
    for item in items:
        s[item] = true
    s

# Intersection of all sets in a list (returns new dict)
fn intersect_all(sets):
    val slen = _list_len(sets)
    if slen == 0:
        return {}
    val first = _get_item(sets, 0)
    var result = set_clone(first)
    for i in 1..slen:
        val current = _get_item(sets, i)
        result = set_intersection(result, current)
    result

# Union of all sets in a list (returns new dict)
fn union_all(sets):
    var result = {}
    for s in sets:
        for k in s.keys():
            result[k] = true
    result

# ============================================================================
# Tests
# ============================================================================

use std.spec.step
describe "Set<T>":
    context "Construction":
        it "creates empty set with new()":
            step("Verify: creates empty set with new()")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            expect(s.len()).to_equal(0)  # oracle: value fixed by the spec contract

        it "creates empty set with capacity":
            step("Verify: creates empty set with capacity")
            # @req: REQ-COLLECTIONS-Set-001
            # Dict doesn't have capacity, but empty dict is equivalent
            var s = {}
            expect(s.len()).to_equal(0)  # oracle: value fixed by the spec contract

    context "Basic operations":
        it "inserts element into set":
            step("Verify: inserts element into set")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            val was_new = not s.has("Alice")
            s["Alice"] = true
            expect(was_new).to_be(true)
            expect(s.len()).to_equal(1)  # oracle: value fixed by the spec contract

        it "insert returns false for duplicate":
            step("Verify: insert returns false for duplicate")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["Alice"] = true
            val was_new = not s.has("Alice")
            s["Alice"] = true
            expect(was_new).to_be(false)
            expect(s.len()).to_equal(1)  # oracle: value fixed by the spec contract

        it "contains finds existing element":
            step("Verify: contains finds existing element")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["Alice"] = true
            expect(set_contains(s, "Alice")).to_be(true)

        it "contains returns false for missing element":
            step("Verify: contains returns false for missing element")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            expect(set_contains(s, "Alice")).to_be(false)

        it "removes existing element":
            step("Verify: removes existing element")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["Alice"] = true
            val existed = s.has("Alice")
            s.remove("Alice")
            expect(existed).to_be(true)
            expect(s.len()).to_equal(0)  # oracle: value fixed by the spec contract

        it "remove returns false for missing element":
            step("Verify: remove returns false for missing element")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            val existed = s.has("Alice")
            expect(existed).to_be(false)

        it "clear removes all elements":
            step("Verify: clear removes all elements")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["Alice"] = true
            s["Bob"] = true
            s["Charlie"] = true
            s.clear()
            expect(s.len()).to_equal(0)  # oracle: value fixed by the spec contract

    context "Multiple elements":
        it "handles multiple unique elements":
            step("Verify: handles multiple unique elements")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["Alice"] = true
            s["Bob"] = true
            s["Charlie"] = true
            expect(s.len()).to_equal(3)  # oracle: value fixed by the spec contract
            expect(set_contains(s, "Alice")).to_be(true)
            expect(set_contains(s, "Bob")).to_be(true)
            expect(set_contains(s, "Charlie")).to_be(true)

        it "deduplicates elements":
            step("Verify: deduplicates elements")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["Alice"] = true
            s["Bob"] = true
            s["Alice"] = true
            s["Bob"] = true
            expect(s.len()).to_equal(2)  # oracle: value fixed by the spec contract

    context "Conversion":
        it "converts to list":
            step("Verify: converts to list")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["Alice"] = true
            s["Bob"] = true
            s["Charlie"] = true
            val list = s.keys()
            expect(list.len()).to_equal(3)  # oracle: value fixed by the spec contract

        it "to_list contains all elements":
            step("Verify: to_list contains all elements")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["Alice"] = true
            s["Bob"] = true
            val list = s.keys()
            expect(list).to_contain("Alice")
            expect(list).to_contain("Bob")

    context "Iteration":
        it "for_each executes action for all elements":
            step("Verify: for_each executes action for all elements")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["Alice"] = true
            s["Bob"] = true
            s["Charlie"] = true
            var count = 0
            for k in s.keys():
                count = count + 1
            expect(count).to_equal(3)  # oracle: value fixed by the spec contract

    context "Set operations - union":
        it "union combines two sets":
            step("Verify: union combines two sets")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            var s2 = {}
            s2["Charlie"] = true
            s2["David"] = true
            val result = set_union(s1, s2)
            expect(result.len()).to_equal(4)  # oracle: value fixed by the spec contract
            expect(set_contains(result, "Alice")).to_be(true)
            expect(set_contains(result, "Bob")).to_be(true)
            expect(set_contains(result, "Charlie")).to_be(true)
            expect(set_contains(result, "David")).to_be(true)

        it "union handles overlapping sets":
            step("Verify: union handles overlapping sets")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            s1["Charlie"] = true
            var s2 = {}
            s2["Bob"] = true
            s2["Charlie"] = true
            s2["David"] = true
            val result = set_union(s1, s2)
            expect(result.len()).to_equal(4)  # oracle: value fixed by the spec contract

        it "union doesn't modify original sets":
            step("Verify: union doesn't modify original sets")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            var s2 = {}
            s2["Bob"] = true
            val result = set_union(s1, s2)
            expect(s1.len()).to_equal(1)  # oracle: value fixed by the spec contract
            expect(s2.len()).to_equal(1)  # oracle: value fixed by the spec contract

    context "Set operations - intersection":
        it "intersection finds common elements":
            step("Verify: intersection finds common elements")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            s1["Charlie"] = true
            var s2 = {}
            s2["Bob"] = true
            s2["Charlie"] = true
            s2["David"] = true
            val result = set_intersection(s1, s2)
            expect(result.len()).to_equal(2)  # oracle: value fixed by the spec contract
            expect(set_contains(result, "Bob")).to_be(true)
            expect(set_contains(result, "Charlie")).to_be(true)

        it "intersection returns empty for disjoint sets":
            step("Verify: intersection returns empty for disjoint sets")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            var s2 = {}
            s2["Charlie"] = true
            s2["David"] = true
            val result = set_intersection(s1, s2)
            expect(result.len()).to_equal(0)  # oracle: value fixed by the spec contract

        it "intersection doesn't modify original sets":
            step("Verify: intersection doesn't modify original sets")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            var s2 = {}
            s2["Bob"] = true
            val result = set_intersection(s1, s2)
            expect(s1.len()).to_equal(2)  # oracle: value fixed by the spec contract
            expect(s2.len()).to_equal(1)  # oracle: value fixed by the spec contract

    context "Set operations - difference":
        it "difference finds elements in first but not second":
            step("Verify: difference finds elements in first but not second")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            s1["Charlie"] = true
            var s2 = {}
            s2["Bob"] = true
            s2["Charlie"] = true
            s2["David"] = true
            val result = set_difference(s1, s2)
            expect(result.len()).to_equal(1)  # oracle: value fixed by the spec contract
            expect(set_contains(result, "Alice")).to_be(true)
            expect(set_contains(result, "Bob")).to_be(false)
            expect(set_contains(result, "Charlie")).to_be(false)

        it "difference returns empty when second is superset":
            step("Verify: difference returns empty when second is superset")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            var s2 = {}
            s2["Alice"] = true
            s2["Bob"] = true
            s2["Charlie"] = true
            val result = set_difference(s1, s2)
            expect(result.len()).to_equal(0)  # oracle: value fixed by the spec contract

    context "Set operations - symmetric difference":
        it "symmetric_difference finds elements in either but not both":
            step("Verify: symmetric_difference finds elements in either but not both")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            s1["Charlie"] = true
            var s2 = {}
            s2["Bob"] = true
            s2["Charlie"] = true
            s2["David"] = true
            val result = set_symmetric_difference(s1, s2)
            expect(result.len()).to_equal(2)  # oracle: value fixed by the spec contract
            expect(set_contains(result, "Alice")).to_be(true)
            expect(set_contains(result, "David")).to_be(true)
            expect(set_contains(result, "Bob")).to_be(false)
            expect(set_contains(result, "Charlie")).to_be(false)

        it "symmetric_difference returns union for disjoint sets":
            step("Verify: symmetric_difference returns union for disjoint sets")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            var s2 = {}
            s2["Charlie"] = true
            s2["David"] = true
            val result = set_symmetric_difference(s1, s2)
            expect(result.len()).to_equal(4)  # oracle: value fixed by the spec contract

    context "Set predicates - subset":
        it "is_subset returns true when all elements in other":
            step("Verify: is_subset returns true when all elements in other")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            var s2 = {}
            s2["Alice"] = true
            s2["Bob"] = true
            s2["Charlie"] = true
            expect(set_is_subset(s1, s2)).to_be(true)

        it "is_subset returns true for equal sets":
            step("Verify: is_subset returns true for equal sets")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            var s2 = {}
            s2["Alice"] = true
            s2["Bob"] = true
            expect(set_is_subset(s1, s2)).to_be(true)

        it "is_subset returns false when element not in other":
            step("Verify: is_subset returns false when element not in other")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            s1["Charlie"] = true
            var s2 = {}
            s2["Alice"] = true
            s2["Bob"] = true
            expect(set_is_subset(s1, s2)).to_be(false)

    context "Set predicates - superset":
        it "is_superset returns true when contains all elements":
            step("Verify: is_superset returns true when contains all elements")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            s1["Charlie"] = true
            var s2 = {}
            s2["Alice"] = true
            s2["Bob"] = true
            expect(set_is_superset(s1, s2)).to_be(true)

        it "is_superset returns false when missing element":
            step("Verify: is_superset returns false when missing element")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            var s2 = {}
            s2["Alice"] = true
            s2["Bob"] = true
            s2["Charlie"] = true
            expect(set_is_superset(s1, s2)).to_be(false)

    context "Set predicates - disjoint":
        it "is_disjoint returns true for no overlap":
            step("Verify: is_disjoint returns true for no overlap")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            var s2 = {}
            s2["Charlie"] = true
            s2["David"] = true
            expect(set_is_disjoint(s1, s2)).to_be(true)

        it "is_disjoint returns false when sets overlap":
            step("Verify: is_disjoint returns false when sets overlap")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            var s2 = {}
            s2["Bob"] = true
            s2["Charlie"] = true
            expect(set_is_disjoint(s1, s2)).to_be(false)

    context "Functional operations - filter":
        it "filter keeps matching elements":
            step("Verify: filter keeps matching elements")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["1"] = true
            s["2"] = true
            s["3"] = true
            s["4"] = true
            s["5"] = true
            val result = set_filter(s, int(_1) % 2 == 0)
            expect(result.len()).to_equal(2)  # oracle: value fixed by the spec contract
            expect(set_contains(result, "2")).to_be(true)
            expect(set_contains(result, "4")).to_be(true)

        it "filter returns empty when no matches":
            step("Verify: filter returns empty when no matches")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["Alice"] = true
            s["Bob"] = true
            val result = set_filter(s, _1 == "Charlie")
            expect(result.len()).to_equal(0)  # oracle: value fixed by the spec contract

    context "Functional operations - map":
        it "map transforms all elements":
            step("Verify: map transforms all elements")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["1"] = true
            s["2"] = true
            s["3"] = true
            val result = set_map(s, int(_1) * 2)
            expect(result.len()).to_equal(3)  # oracle: value fixed by the spec contract
            expect(set_contains(result, 2)).to_be(true)
            expect(set_contains(result, 4)).to_be(true)
            expect(set_contains(result, 6)).to_be(true)

        it "map deduplicates transformed values":
            step("Verify: map deduplicates transformed values")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["1"] = true
            s["2"] = true
            s["3"] = true
            val result = set_map(s, \_: 42)
            expect(result.len()).to_equal(1)  # oracle: value fixed by the spec contract
            expect(set_contains(result, 42)).to_be(true)

    context "Functional operations - any":
        it "any returns true when element matches":
            step("Verify: any returns true when element matches")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["1"] = true
            s["2"] = true
            s["3"] = true
            val result = set_any(s, int(_1) > 2)
            expect(result).to_be(true)

        it "any returns false when no element matches":
            step("Verify: any returns false when no element matches")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["1"] = true
            s["2"] = true
            s["3"] = true
            val result = set_any(s, int(_1) > 10)
            expect(result).to_be(false)

        it "any returns false for empty set":
            step("Verify: any returns false for empty set")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            val result = set_any(s, \_: true)
            expect(result).to_be(false)

    context "Functional operations - all":
        it "all returns true when all elements match":
            step("Verify: all returns true when all elements match")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["1"] = true
            s["2"] = true
            s["3"] = true
            val result = set_all(s, int(_1) > 0)
            expect(result).to_be(true)

        it "all returns false when one element doesn't match":
            step("Verify: all returns false when one element doesn't match")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["1"] = true
            s["2"] = true
            s["3"] = true
            val result = set_all(s, int(_1) > 1)
            expect(result).to_be(false)

        it "all returns true for empty set":
            step("Verify: all returns true for empty set")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            val result = set_all(s, \_: false)
            expect(result).to_be(true)

    context "Utility operations":
        it "clone creates independent copy":
            step("Verify: clone creates independent copy")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            var s2 = set_clone(s1)
            s2["Charlie"] = true
            expect(s1.len()).to_equal(2)  # oracle: value fixed by the spec contract
            expect(s2.len()).to_equal(3)  # oracle: value fixed by the spec contract
            expect(set_contains(s1, "Charlie")).to_be(false)

        it "extend adds all items from list":
            step("Verify: extend adds all items from list")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["Alice"] = true
            val more = ["Bob", "Charlie", "David"]
            for item in more:
                s[item] = true
            expect(s.len()).to_equal(4)  # oracle: value fixed by the spec contract
            expect(set_contains(s, "Bob")).to_be(true)
            expect(set_contains(s, "Charlie")).to_be(true)
            expect(set_contains(s, "David")).to_be(true)

        it "extend deduplicates items from list":
            step("Verify: extend deduplicates items from list")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["Alice"] = true
            val more = ["Alice", "Bob", "Alice", "Charlie", "Bob"]
            for item in more:
                s[item] = true
            expect(s.len()).to_equal(3)  # oracle: value fixed by the spec contract

    context "Helper functions":
        it "set_from_list creates set from list":
            step("Verify: set_from_list creates set from list")
            # @req: REQ-COLLECTIONS-Set-001
            val s = set_from_list(["Alice", "Bob", "Charlie", "Alice", "Bob"])
            expect(s.len()).to_equal(3)  # oracle: value fixed by the spec contract
            expect(set_contains(s, "Alice")).to_be(true)
            expect(set_contains(s, "Bob")).to_be(true)
            expect(set_contains(s, "Charlie")).to_be(true)

        it "intersect_all finds common elements in multiple sets":
            step("Verify: intersect_all finds common elements in multiple sets")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            s1["Charlie"] = true
            var s2 = {}
            s2["Bob"] = true
            s2["Charlie"] = true
            s2["David"] = true
            var s3 = {}
            s3["Charlie"] = true
            s3["David"] = true
            s3["Eve"] = true
            val result = intersect_all([s1, s2, s3])
            expect(result.len()).to_equal(1)  # oracle: value fixed by the spec contract
            expect(set_contains(result, "Charlie")).to_be(true)

        it "intersect_all returns empty for empty list":
            step("Verify: intersect_all returns empty for empty list")
            # @req: REQ-COLLECTIONS-Set-001
            val result = intersect_all([])
            expect(result.len()).to_equal(0)  # oracle: value fixed by the spec contract

        it "union_all combines all sets":
            step("Verify: union_all combines all sets")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            s1["Alice"] = true
            s1["Bob"] = true
            var s2 = {}
            s2["Bob"] = true
            s2["Charlie"] = true
            var s3 = {}
            s3["Charlie"] = true
            s3["David"] = true
            val result = union_all([s1, s2, s3])
            expect(result.len()).to_equal(4)  # oracle: value fixed by the spec contract
            expect(set_contains(result, "Alice")).to_be(true)
            expect(set_contains(result, "Bob")).to_be(true)
            expect(set_contains(result, "Charlie")).to_be(true)
            expect(set_contains(result, "David")).to_be(true)

    context "Edge cases":
        it "handles many elements":
            step("Verify: handles many elements")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            for i in 0..100:
                s["item{i}"] = true
            expect(s.len()).to_equal(100)  # oracle: value fixed by the spec contract

        it "handles element removal during iteration":
            step("Verify: handles element removal during iteration")
            # @req: REQ-COLLECTIONS-Set-001
            var s = {}
            s["Alice"] = true
            s["Bob"] = true
            s["Charlie"] = true
            val items = s.keys()
            for item in items:
                s.remove(item)
            expect(s.len()).to_equal(0)  # oracle: value fixed by the spec contract

        it "handles empty set operations":
            step("Verify: handles empty set operations")
            # @req: REQ-COLLECTIONS-Set-001
            var s1 = {}
            var s2 = {}
            val union_result = set_union(s1, s2)
            expect(union_result.len()).to_equal(0)  # oracle: value fixed by the spec contract
            val intersect_result = set_intersection(s1, s2)
            expect(intersect_result.len()).to_equal(0)  # oracle: value fixed by the spec contract
            expect(set_is_subset(s1, s2)).to_be(true)
            expect(set_is_disjoint(s1, s2)).to_be(true)
