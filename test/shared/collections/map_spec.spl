"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SHARED-COLLECTIONS behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/shared/collections/map_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-SHARED-COLLECTIONS-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @platform: all
# Map Type Specification
# Tests for dict (hash map) implementation
# NOTE: Using built-in dict type

# Test suite for the built-in dict (hash map) type in Simple.
#
# This specification covers:
# - Dict construction and initialization
# - Key-value insertion, retrieval, and update operations
# - Key existence checking with contains_key()
# - Iterating over keys and counting entries
# - Various value types (integers, strings, booleans)
# - Edge cases like empty string keys and similar key names
#
# The dict type provides O(1) average-case lookup and insertion using
# hash-based storage. Keys are strings and values can be any type.

describe "Dict (Map)":
    # Tests for Simple's built-in dictionary (hash map) data structure.
    #
    # The dict type provides key-value storage with the following operations:
    # - Literal syntax: {} for empty, {"key": value} for initialized
    # - Index access: m["key"] for get, m["key"] = value for set
    # - contains_key(key) to check key existence
    # - keys() to get list of all keys
    # - Iteration via for key in m.keys()
    #
    # Tests verify correct behavior for:
    # - Empty dict creation and population
    # - Single and multiple key-value pairs
    # - Key updates (overwriting existing values)
    # - Length tracking via keys().len()
    # - Different value types stored in the same dict
    # - Edge cases like empty string keys
    context "Construction":
        it "creates empty dict":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-COLLECTIONS-001
            step("Verify: creates empty dict")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val m = {}
            expect m.keys().len() == 0

    context "Basic operations":
        it "inserts and retrieves value":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-COLLECTIONS-002
            step("Verify: inserts and retrieves value")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var m = {}
            m["name"] = "Alice"
            expect m["name"] == "Alice"

        it "updates existing key":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-COLLECTIONS-003
            step("Verify: updates existing key")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var m = {}
            m["count"] = 1
            m["count"] = 2
            expect m["count"] == 2

        it "contains_key returns true for existing keys":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-COLLECTIONS-004
            step("Verify: contains_key returns true for existing keys")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var m = {}
            m["key"] = "value"
            expect m.has("key")

        it "contains_key returns false for missing keys":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-COLLECTIONS-005
            step("Verify: contains_key returns false for missing keys")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val m = {}
            expect not m.has("missing")

        it "len increases with insertions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-COLLECTIONS-006
            step("Verify: len increases with insertions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var m = {}
            expect m.keys().len() == 0
            m["a"] = 1
            expect m.keys().len() == 1
            m["b"] = 2
            expect m.keys().len() == 2

        it "len does not increase for updates":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-COLLECTIONS-007
            step("Verify: len does not increase for updates")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var m = {}
            m["key"] = 1
            expect m.keys().len() == 1
            m["key"] = 2
            expect m.keys().len() == 1

    context "Keys, values":
        it "keys returns all keys":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-COLLECTIONS-008
            step("Verify: keys returns all keys")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var m = {}
            m["a"] = 1
            m["b"] = 2
            m["c"] = 3
            val keys = m.keys()
            expect keys.len() == 3

        it "empty dict returns empty key list":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-COLLECTIONS-009
            step("Verify: empty dict returns empty key list")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            val m = {}
            expect m.keys().len() == 0

    context "Multiple entries":
        it "handles many insertions":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-COLLECTIONS-010
            step("Verify: handles many insertions")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var m = {}
            for i in 0..10:
                val k = "key{i}"
                m[k] = i
            val klen = m.keys().len()
            expect klen == 10
            expect m["key5"] == 5

    context "Different value types":
        it "stores integer values":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-COLLECTIONS-011
            step("Verify: stores integer values")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var m = {}
            m["count"] = 42
            expect m["count"] == 42

        it "stores text values":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-COLLECTIONS-012
            step("Verify: stores text values")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var m = {}
            m["name"] = "Alice"
            expect m["name"] == "Alice"

        it "stores boolean values":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-COLLECTIONS-013
            step("Verify: stores boolean values")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var m = {}
            m["active"] = true
            expect m["active"] == true

    context "Edge cases":
        it "handles empty string key":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-COLLECTIONS-014
            step("Verify: handles empty string key")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var m = {}
            m[""] = "empty key"
            expect m[""] == "empty key"

        it "handles similar keys":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-COLLECTIONS-015
            step("Verify: handles similar keys")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var m = {}
            m["test"] = 1
            m["test1"] = 2
            m["test2"] = 3
            expect m["test"] == 1
            expect m["test1"] == 2

    context "Iteration":
        it "can iterate over entries":
            # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
            # @req: REQ-SHARED-COLLECTIONS-016
            step("Verify: can iterate over entries")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            var m = {}
            m["a"] = 1
            m["b"] = 2
            m["c"] = 3
            var count = 0
            for key in m.keys():
                count = count + 1
            expect count == 3
