# @platform: all
# Defect-class spec: every place a bare `nil` Option meets the `?` operator,
# plus positive controls that must keep passing.

fn none_via_nil() -> Option<i64>:
    return nil

fn some_value(x: i64) -> Option<i64>:
    return Some(x)

fn err_result() -> Result<i64, text>:
    return Err("boom")

fn ok_result(x: i64) -> Result<i64, text>:
    return Ok(x)

fn try_nil_direct() -> Option<i64>:
    val v = none_via_nil()?
    return Some(v)

fn try_nil_after_some() -> Option<i64>:
    val a = some_value(7)?
    val b = none_via_nil()?
    return Some(a + b)

fn try_nil_middle_layer() -> Option<i64>:
    val v = try_nil_direct()?
    return Some(v * 2)

fn try_some_only() -> Option<i64>:
    val a = some_value(3)?
    val b = some_value(4)?
    return Some(a + b)

fn try_result_ok() -> Result<i64, text>:
    val v = ok_result(5)?
    return Ok(v * 2)

fn try_result_err() -> Result<i64, text>:
    val v = err_result()?
    return Ok(v * 2)

describe "Try operator nil/None propagation class":
    context "nil sources propagate as None":
        it "propagates a directly returned nil":
            val r = try_nil_direct()
            val is_none = r.is_none()
            expect(is_none).to_equal(true)

        it "propagates nil that follows a successful Some":
            val r = try_nil_after_some()
            val is_none = r.is_none()
            expect(is_none).to_equal(true)

        it "propagates nil through a nested call stack":
            val r = try_nil_middle_layer()
            val is_none = r.is_none()
            expect(is_none).to_equal(true)

    context "positive controls (must stay passing)":
        it "still unwraps Some through ?":
            val r = try_some_only()
            val is_some = r.is_some()
            expect(is_some).to_equal(true)
            val v = r.unwrap()
            expect(v).to_equal(7)

        it "still unwraps Ok through ?":
            val r = try_result_ok()
            val is_ok = r.is_ok()
            expect(is_ok).to_equal(true)
            val v = r.unwrap()
            expect(v).to_equal(10)

        it "still propagates Err through ?":
            val r = try_result_err()
            val is_err = r.is_err()
            expect(is_err).to_equal(true)
