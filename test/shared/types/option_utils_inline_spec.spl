# @platform: all
# Option Utilities Module Extended Specification
#
# Tests for std.option_utils module logic.
# Since the module uses Option<i64> generics (not supported by runtime parser),
# we test inline implementations of the same functions.

# Inline implementations mirroring std.option_utils

"""
## Purpose and audience
Purpose: returns value when present
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-TYPES-OptiUtilInli-001

fn unwrap_or(opt, default_val: i64) -> i64:
    if opt != nil:
        opt
    else:
        default_val

fn is_some(opt) -> bool:
    opt != nil

fn is_none(opt) -> bool:
    opt == nil

# ============================================================================
# unwrap_or
# ============================================================================

use std.spec.step
describe "unwrap_or":

    it "returns value when present":
        step("Verify: returns value when present")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = unwrap_or(42, 0)
        expect(result).to_equal(42)  # oracle: value fixed by the spec contract

    it "returns default when nil":
        step("Verify: returns default when nil")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = unwrap_or(nil, 10)
        expect(result).to_equal(10)  # oracle: value fixed by the spec contract

    it "returns zero value when present":
        step("Verify: returns zero value when present")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = unwrap_or(0, 99)
        expect(result).to_equal(0)  # oracle: value fixed by the spec contract

    it "returns negative value when present":
        step("Verify: returns negative value when present")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = unwrap_or(-5, 0)
        expect(result).to_equal(-5)  # oracle: value fixed by the spec contract

    it "returns default with negative default":
        step("Verify: returns default with negative default")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = unwrap_or(nil, -1)
        expect(result).to_equal(-1)  # oracle: value fixed by the spec contract

    it "returns large value when present":
        step("Verify: returns large value when present")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = unwrap_or(999999, 0)
        expect(result).to_equal(999999)  # oracle: value fixed by the spec contract

# ============================================================================
# is_some
# ============================================================================

describe "is_some":

    it "returns true for non-nil value":
        step("Verify: returns true for non-nil value")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = is_some(42)
        expect(result).to_equal(true)

    it "returns false for nil":
        step("Verify: returns false for nil")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = is_some(nil)
        expect(result).to_equal(false)

    it "returns true for zero":
        step("Verify: returns true for zero")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = is_some(0)
        expect(result).to_equal(true)

    it "returns true for negative":
        step("Verify: returns true for negative")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = is_some(-1)
        expect(result).to_equal(true)

    it "returns true for string":
        step("Verify: returns true for string")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = is_some("hello")
        expect(result).to_equal(true)

    it "returns true for empty string":
        step("Verify: returns true for empty string")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = is_some("")
        expect(result).to_equal(true)

# ============================================================================
# is_none
# ============================================================================

describe "is_none":

    it "returns true for nil":
        step("Verify: returns true for nil")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = is_none(nil)
        expect(result).to_equal(true)

    it "returns false for non-nil value":
        step("Verify: returns false for non-nil value")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = is_none(42)
        expect(result).to_equal(false)

    it "returns false for zero":
        step("Verify: returns false for zero")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = is_none(0)
        expect(result).to_equal(false)

    it "returns false for negative":
        step("Verify: returns false for negative")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = is_none(-1)
        expect(result).to_equal(false)

    it "returns false for string":
        step("Verify: returns false for string")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = is_none("hello")
        expect(result).to_equal(false)

    it "returns false for empty list":
        step("Verify: returns false for empty list")
        # @req: REQ-TYPES-OptiUtilInli-001
        val result = is_none([])
        expect(result).to_equal(false)

# ============================================================================
# Combined usage patterns
# ============================================================================

describe "option_utils combined patterns":

    it "unwrap_or with is_some check":
        step("Verify: unwrap_or with is_some check")
        # @req: REQ-TYPES-OptiUtilInli-001
        val opt = 42
        if is_some(opt):
            val val_result = unwrap_or(opt, 0)
            expect(val_result).to_equal(42)  # oracle: value fixed by the spec contract

    it "unwrap_or with is_none check":
        step("Verify: unwrap_or with is_none check")
        # @req: REQ-TYPES-OptiUtilInli-001
        val opt = nil
        if is_none(opt):
            val val_result = unwrap_or(opt, -1)
            expect(val_result).to_equal(-1)  # oracle: value fixed by the spec contract

    it "chain of option operations":
        step("Verify: chain of option operations")
        # @req: REQ-TYPES-OptiUtilInli-001
        var values = [42, nil, 7, nil, 99]
        var sum = 0
        for v in values:
            sum = sum + unwrap_or(v, 0)
        expect(sum).to_equal(148)  # oracle: value fixed by the spec contract

    it "count non-nil values":
        step("Verify: count non-nil values")
        # @req: REQ-TYPES-OptiUtilInli-001
        var values = [1, nil, 3, nil, 5]
        var count = 0
        for v in values:
            if is_some(v):
                count = count + 1
        expect(count).to_equal(3)  # oracle: value fixed by the spec contract

    it "count nil values":
        step("Verify: count nil values")
        # @req: REQ-TYPES-OptiUtilInli-001
        var values = [1, nil, 3, nil, 5]
        var count = 0
        for v in values:
            if is_none(v):
                count = count + 1
        expect(count).to_equal(2)  # oracle: value fixed by the spec contract
