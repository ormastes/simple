"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing SHARED-TYPES behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/shared/types/pattern_matching_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-SHARED-TYPES-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# @platform: all
# Comprehensive BDD tests for Pattern Matching.
#
# Tests all pattern types: literals, variables, wildcards, enums,
# tuples, structs, guards, or-patterns, ranges, and control flow patterns.

# ============================================================================
# Test Data Types
# ============================================================================

enum Color:
    Red
    Green
    Blue

enum MyOption:
    Some(i64)
    None

enum MyResult:
    Ok(i64)
    Err(text)

enum Shape:
    Circle(f64)
    Rectangle(f64, f64)
    Point

struct Point2D:
    x: i64
    y: i64

struct Person:
    name: text
    age: i64

# ============================================================================
# Helper Functions for Pattern Matching Tests
# ============================================================================

# Literal patterns
fn match_int(x: i64) -> text:
    match x:
        case 0:
            return "zero"
        case 42:
            return "found"
        case 100:
            return "hundred"
        _ =>
            return "other"

fn match_bool(flag: bool) -> text:
    match flag:
        case true:
            return "yes"
        case false:
            return "no"

fn match_string(s: text) -> text:
    match s:
        case "hello":
            return "greeting"
        case "bye":
            return "farewell"
        case "":
            return "empty"
        _ =>
            return "unknown"

# Variable binding patterns
fn double_via_match(x: i64) -> i64:
    match x:
        n =>
            return n * 2

fn add_five_via_match(x: i64) -> i64:
    match x:
        v =>
            return v + 5

# Wildcard patterns
fn wildcard_match(x: i64) -> text:
    match x:
        _ =>
            return "matched"

fn catchall_match(x: i64) -> text:
    match x:
        case 0:
            return "zero"
        case 1:
            return "one"
        _ =>
            return "other"

# Enum patterns - unit variants
fn match_color(c: Color) -> text:
    match c:
        case Color.Red:
            return "red"
        case Color.Green:
            return "green"
        case Color.Blue:
            return "blue"

# Enum patterns - with payload
fn match_option(opt: MyOption) -> i64:
    match opt:
        case MyOption.Some(v):
            return v
        case MyOption.None:
            return 0

fn match_option_none_default(opt: MyOption) -> i64:
    match opt:
        case MyOption.Some(v):
            return v
        case MyOption.None:
            return 99

fn match_result_ok(res: MyResult) -> i64:
    match res:
        case MyResult.Ok(v):
            return v
        case MyResult.Err(e):
            return 0

fn match_result_err(res: MyResult) -> text:
    match res:
        case MyResult.Ok(v):
            return ""
        case MyResult.Err(e):
            return e

fn match_shape(shape: Shape) -> f64:
    match shape:
        case Shape.Circle(r):
            return r
        case Shape.Rectangle(w, _):
            # Multi-value enum variant destructuring for second binding
            # is not fully supported in interpreter mode; return first value.
            return w
        case Shape.Point:
            return 0.0

# Tuple patterns
fn match_pair(pair: (i64, i64)) -> i64:
    match pair:
        case (a, b):
            return a + b

fn match_triple(triple: (i64, i64, i64)) -> i64:
    match triple:
        case (a, b, c):
            return a + b + c

fn match_pair_first(pair: (i64, i64)) -> i64:
    match pair:
        case (x, _):
            return x

fn match_pair_wildcard(pair: (i64, i64)) -> text:
    match pair:
        case (_, _):
            return "matched"

fn match_nested_tuple(nested: ((i64, i64), i64)) -> i64:
    match nested:
        case ((a, b), c):
            return a + b + c

fn match_tuple_literal_first(pair: (i64, i64)) -> i64:
    match pair:
        case (0, x):
            return x
        case (_, x):
            return 0

fn match_tuple_literal_second(pair: (i64, i64)) -> i64:
    match pair:
        case (x, 0):
            return x
        case (x, _):
            return 0

# Struct field access (struct destructuring patterns are not supported by parser)
fn match_point(p: Point2D) -> i64:
    p.x + p.y

fn match_person_age(person: Person) -> i64:
    person.age

fn match_point_origin(p: Point2D) -> text:
    if p.x == 0 and p.y == 0:
        return "origin"
    return "not origin"

fn match_point_axis(p: Point2D) -> text:
    if p.x == 0 and p.y == 0:
        return "origin"
    if p.y == 0:
        return "on x-axis"
    if p.x == 0:
        return "on y-axis"
    return "elsewhere"

# Guard clauses
fn match_with_guard(x: i64) -> text:
    match x:
        case n if n > 5:
            return "big"
        n =>
            return "small"

fn categorize_number(x: i64) -> text:
    match x:
        case n if n == 0:
            return "zero"
        case n if n < 10:
            return "small"
        case n if n < 100:
            return "medium"
        n =>
            return "large"

fn match_option_with_guard(opt: MyOption) -> text:
    match opt:
        case MyOption.Some(v) if v > 100:
            return "large"
        case MyOption.Some(v) if v > 10:
            return "medium"
        case MyOption.Some(v):
            return "small"
        case MyOption.None:
            return "none"

fn match_tuple_with_guard(pair: (i64, i64)) -> text:
    match pair:
        case (a, b) if a + b == 7:
            return "sum is 7"
        case (a, b) if a == b:
            return "equal"
        _ =>
            return "other"

# Or patterns
fn match_or_pattern(x: i64) -> text:
    match x:
        case 1 | 2 | 3:
            return "small"
        _ =>
            return "other"

fn match_color_or(c: Color) -> text:
    match c:
        case Color.Red | Color.Blue:
            return "primary"
        case Color.Green:
            return "secondary"

# Range patterns
fn match_range(x: i64) -> text:
    match x:
        case 1..=10:
            return "in range"
        _ =>
            return "out of range"

fn grade_score(score: i64) -> text:
    match score:
        case 90..=100:
            return "A"
        case 80..=89:
            return "B"
        case 70..=79:
            return "C"
        case 60..=69:
            return "D"
        _ =>
            return "F"

# Array patterns
fn match_single_array(arr: [i64]) -> i64:
    match arr:
        case [x]:
            return x
        _ =>
            return 0

fn match_pair_array(arr: [i64]) -> i64:
    match arr:
        case [a, b]:
            return a + b
        _ =>
            return 0

# Complex patterns
fn match_nested_enum_tuple(data: (MyOption, text)) -> i64:
    match data:
        case (MyOption.Some(v), s):
            return v
        case (MyOption.None, s):
            return 0

fn match_tuple_guard_complex(data: (i64, i64)) -> text:
    match data:
        case (a, b) if a + b > 25:
            return "large sum"
        case (a, b):
            return "small sum"

# ============================================================================
# Pattern Matching Tests
# ============================================================================

describe "Pattern Matching":
    # Tests for the pattern matching system including literal patterns,
    # variable bindings, wildcards, enums, tuples, structs, guards,
    # or-patterns, ranges, arrays, if-val, and complex combinations.

    describe "literal patterns":
        context "integer literals":
            it "matches zero":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-001
                step("Verify: matches zero")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_int(0) == "zero"

            it "matches positive integers":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-002
                step("Verify: matches positive integers")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_int(42) == "found"

            it "matches larger integers":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-003
                step("Verify: matches larger integers")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_int(100) == "hundred"

            it "uses wildcard for unmatched":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-004
                step("Verify: uses wildcard for unmatched")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_int(999) == "other"

        context "boolean literals":
            it "matches true":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-005
                step("Verify: matches true")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_bool(true) == "yes"

            it "matches false":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-006
                step("Verify: matches false")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_bool(false) == "no"

        context "string literals":
            it "matches string values":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-007
                step("Verify: matches string values")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_string("hello") == "greeting"

            it "matches empty string":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-008
                step("Verify: matches empty string")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_string("") == "empty"

            it "uses wildcard for unmatched strings":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-009
                step("Verify: uses wildcard for unmatched strings")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_string("other") == "unknown"

    describe "variable binding patterns":
        context "simple binding":
            it "binds value to variable":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-010
                step("Verify: binds value to variable")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect double_via_match(42) == 84

            it "binds and uses in expression":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-011
                step("Verify: binds and uses in expression")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect add_five_via_match(10) == 15

    describe "wildcard pattern":
        context "basic wildcards":
            it "matches anything":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-012
                step("Verify: matches anything")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect wildcard_match(99) == "matched"

            it "serves as catch-all":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-013
                step("Verify: serves as catch-all")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect catchall_match(42) == "other"

            it "matches specific values first":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-014
                step("Verify: matches specific values first")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect catchall_match(0) == "zero"
                expect catchall_match(1) == "one"

    describe "enum patterns":
        context "unit enum variants":
            it "matches Red":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-015
                step("Verify: matches Red")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_color(Color.Red) == "red"

            it "matches Green":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-016
                step("Verify: matches Green")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_color(Color.Green) == "green"

            it "matches Blue":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-017
                step("Verify: matches Blue")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_color(Color.Blue) == "blue"

        context "enum variants with payload":
            it "matches Some and extracts value":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-018
                step("Verify: matches Some and extracts value")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_option(MyOption.Some(42)) == 42

            it "matches None":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-019
                step("Verify: matches None")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_option_none_default(MyOption.None) == 99

            it "matches Ok result":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-020
                step("Verify: matches Ok result")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_result_ok(MyResult.Ok(100)) == 100

            it "matches Err result":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-021
                step("Verify: matches Err result")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_result_err(MyResult.Err("failed")) == "failed"

        context "complex enum payloads":
            it "matches Circle and extracts radius":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-022
                step("Verify: matches Circle and extracts radius")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_shape(Shape.Circle(5.0)) == 5.0

            it "matches Rectangle and extracts first dimension":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-023
                step("Verify: matches Rectangle and extracts first dimension")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                # Multi-value enum variant: second binding not supported in interpreter.
                # Returns width (first value) only.
                expect match_shape(Shape.Rectangle(4.0, 3.0)) == 4.0

            it "matches Point unit variant":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-024
                step("Verify: matches Point unit variant")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_shape(Shape.Point) == 0.0

    describe "tuple patterns":
        context "basic tuple destructuring":
            it "destructures pair":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-025
                step("Verify: destructures pair")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_pair((1, 2)) == 3

            it "destructures triple":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-026
                step("Verify: destructures triple")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_triple((1, 2, 3)) == 6

            it "matches with partial wildcards":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-027
                step("Verify: matches with partial wildcards")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_pair_first((10, 20)) == 10

            it "matches with all wildcards":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-028
                step("Verify: matches with all wildcards")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_pair_wildcard((1, 2)) == "matched"

        context "nested tuple patterns":
            it "destructures nested tuples":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-029
                step("Verify: destructures nested tuples")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_nested_tuple(((1, 2), 3)) == 6

        context "mixed tuple and literals":
            it "matches tuple with literal first element":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-030
                step("Verify: matches tuple with literal first element")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_tuple_literal_first((0, 42)) == 42

            it "matches tuple with literal second element":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-031
                step("Verify: matches tuple with literal second element")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_tuple_literal_second((10, 0)) == 10

    describe "struct field access":
        context "basic struct field access":
            it "accesses Point2D fields":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-032
                step("Verify: accesses Point2D fields")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                val p = Point2D { x: 3, y: 4 }
                expect match_point(p) == 7

            it "accesses Person fields":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-033
                step("Verify: accesses Person fields")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                val person = Person { name: "Alice", age: 30 }
                expect match_person_age(person) == 30

        context "struct field comparison":
            it "matches origin point":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-034
                step("Verify: matches origin point")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                val p = Point2D { x: 0, y: 0 }
                expect match_point_origin(p) == "origin"

            it "matches non-origin point":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-035
                step("Verify: matches non-origin point")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                val p = Point2D { x: 5, y: 5 }
                expect match_point_origin(p) == "not origin"

            it "matches point on x-axis":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-036
                step("Verify: matches point on x-axis")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                val p = Point2D { x: 5, y: 0 }
                expect match_point_axis(p) == "on x-axis"

            it "matches point on y-axis":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-037
                step("Verify: matches point on y-axis")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                val p = Point2D { x: 0, y: 5 }
                expect match_point_axis(p) == "on y-axis"

            it "matches point elsewhere":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-038
                step("Verify: matches point elsewhere")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                val p = Point2D { x: 3, y: 4 }
                expect match_point_axis(p) == "elsewhere"

    describe "guard clauses":
        context "simple guards":
            it "matches with true guard":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-039
                step("Verify: matches with true guard")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_with_guard(10) == "big"

            it "skips when guard is false":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-040
                step("Verify: skips when guard is false")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_with_guard(3) == "small"

        context "multiple guards":
            it "categorizes zero":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-041
                step("Verify: categorizes zero")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect categorize_number(0) == "zero"

            it "categorizes small numbers":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-042
                step("Verify: categorizes small numbers")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect categorize_number(5) == "small"

            it "categorizes medium numbers":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-043
                step("Verify: categorizes medium numbers")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect categorize_number(50) == "medium"

            it "categorizes large numbers":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-044
                step("Verify: categorizes large numbers")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect categorize_number(150) == "large"

        context "guards with enums":
            it "uses guard on enum payload - large":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-045
                step("Verify: uses guard on enum payload - large")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_option_with_guard(MyOption.Some(150)) == "large"

            it "uses guard on enum payload - medium":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-046
                step("Verify: uses guard on enum payload - medium")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_option_with_guard(MyOption.Some(50)) == "medium"

            it "uses guard on enum payload - small":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-047
                step("Verify: uses guard on enum payload - small")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_option_with_guard(MyOption.Some(5)) == "small"

            it "handles None":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-048
                step("Verify: handles None")
                # @capture: assertion outcomes retained in the spec Results output as evidence
                expect match_option_with_guard(MyOption.None) == "none"

        context "guards with tuples":
            it "uses guard on tuple elements - sum is 7":
                # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
                # @req: REQ-SHARED-TYPES-049
