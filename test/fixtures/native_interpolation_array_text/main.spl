# Native string-interpolation of array values oracle.
# Bug: doc/08_tracking/bug/native_interpolation_array_renders_empty_2026-11-26.md
# A native build (cranelift and llvm) must print exactly the seed's stdout
# below (`simple run main.spl`). Stage-2 native at 57e92cb68fc7 prints every
# array row empty (`interp=`, `s_len=0`, ...) while `int=5` is correct.
# SEED_STDOUT_BEGIN
#   interp=[1, 2, 3]
#   s_len=9
#   fn=[1, 2, 3]
#   text_arr=[a, b]
#   pushed=[4]
#   int=5
# SEED_STDOUT_END

fn show(xs: [i64]) -> text:
    return "{xs}"

fn main():
    val xs = [1, 2, 3]
    print "interp={xs}"
    val s = "{xs}"
    print "s_len={s.len()}"
    print "fn={show(xs)}"
    val ts = ["a", "b"]
    print "text_arr={ts}"
    var ys: [i64] = []
    ys.push(4)
    print "pushed={ys}"
    val n = 5
    print "int={n}"
