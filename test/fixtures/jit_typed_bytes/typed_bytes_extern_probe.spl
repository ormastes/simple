# Probe: source-level `extern fn` declarations of the typed-bytes accessors
# over a 256 KiB [u8], plus the stdlib checksums built on them. Run under the
# JIT and the interpreter by typed_bytes_extern_jit_parity_spec.spl; both must
# print the same (correct) values, and the JIT must finish in linear time.

use std.common.hash.adler32.{adler32}
use std.common.crypto.crc32.{crc32}

extern fn rt_typed_bytes_u8_unchecked(arr: [u8], idx: u64) -> u64
extern fn rt_typed_bytes_u8_at(arr: [u8], idx: u64) -> u64
extern fn rt_typed_bytes_u32_le_at(arr: [u8], idx: u64) -> u64
extern fn rt_typed_bytes_u32_le_unchecked(arr: [u8], idx: u64) -> u64
extern fn rt_typed_bytes_u64_le_unchecked(arr: [u8], idx: u64) -> u64

fn main():
    val n: i64 = 262144
    var data: [u8] = [0u8; n]
    var i: i64 = 0
    while i < n:
        data[i] = ((i * 31 + 7 + (i >> 8)) & 255).to_u8()
        i = i + 1
    var s8: i64 = 0
    var s8_at: i64 = 0
    var k: u64 = 0u64
    while k < n.to_u64():
        s8 = s8 + rt_typed_bytes_u8_unchecked(data, k).to_i64()
        s8_at = s8_at + rt_typed_bytes_u8_at(data, k).to_i64()
        k = k + 1u64
    var s32: i64 = 0
    var s32u: i64 = 0
    k = 0u64
    while k < n.to_u64():
        s32 = s32 + rt_typed_bytes_u32_le_at(data, k).to_i64()
        s32u = s32u + rt_typed_bytes_u32_le_unchecked(data, k).to_i64()
        k = k + 4u64
    var s64hi: i64 = 0
    k = 0u64
    while k < n.to_u64():
        s64hi = s64hi + ((rt_typed_bytes_u64_le_unchecked(data, k) >> 40u64) & 0xFFFFFFu64).to_i64()
        k = k + 8u64
    # An unused result must compile too (pure read, nothing to emit).
    rt_typed_bytes_u8_unchecked(data, 0u64)
    print("u8={s8} u8_at={s8_at} u32={s32} u32u={s32u} u64hi={s64hi} adler={adler32(data)} crc={crc32(data)}")
    print("DONE")

main()
