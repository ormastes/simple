use std.nogc_sync_mut.mcdc.dynamic_probe.{
    mcdc_dynamic_probe_is_published,
    mcdc_dynamic_probe_controller_unload_all
}

fn guarded_output(a: bool, b: bool) -> i64:
    if a and b: return 7
    3

fn main():
    if not mcdc_dynamic_probe_is_published():
        panic("dynamic MC/DC aspect was not loaded by production main lowering")
    if guarded_output(true, true) != 7:
        panic("instrumented decision changed semantics")
    if not mcdc_dynamic_probe_controller_unload_all():
        panic("dynamic MC/DC aspect did not unload at the quiescent boundary")
    if mcdc_dynamic_probe_is_published():
        panic("dynamic MC/DC aspect remained published after unload")
    print "mcdc-dynamic-load-unload-ok"

