# Native oracle: a generic class method's Result, bound with `val` and then
# matched, keeps its payload value (row 1 read 1005 for 1042 on the Stage 2
# of 34907e7ec8c, which typed `get` on the symbol: the let-bound read decoded a
# raw payload, 42 >> 3 = 5;
# doc/08_tracking/bug/native_generic_class_result_payload_times_8_2026-11-15.md).
# No competing Ok/Err enum: a let-bound subject is a local whose type is
# erased under SIMPLE_BOOTSTRAP=1, so the bare-arm attribution that
# ../native_generic_method_result_match covers does not reach it (open gap).
# Build: SIMPLE_BOOTSTRAP=1 native-build main.spl --entry-closure (cranelift, llvm).
# Expected stdout (seed `simple run main.spl`; native must equal it):
# 1042
# -7
# true
# false

use store.{Store, store_new}

var int_stores: [Store<i64>] = []
var bool_stores: [Store<bool>] = []

fn int_bound(idx: i64) -> i64:
    val q = int_stores[0].get(idx)
    match q:
        case Ok(v): v + 1000
        case Err(_): -7

fn bool_bound(idx: i64) -> bool:
    val q = bool_stores[0].get(idx)
    match q:
        case Ok(v): v
        case Err(_): false

fn main():
    int_stores.push(store_new<i64>("extra"))
    bool_stores.push(store_new<bool>("flag"))
    int_stores[0].set(2, 42)
    bool_stores[0].set(1, true)
    print(int_bound(2))
    print(int_bound(3))
    print(bool_bound(1))
    print(bool_bound(4))
