# SIMPLE_LSP_QUERY_TEST_CHILD names the separately compiled heavy_query_child PE.
# This fixture proves real nonzero and real successful-empty process boundaries.
use std.io_runtime.{env_get}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.lsp.lsp_handlers.{lsp_inlay_hint_query_response, lsp_code_action_query_response}

fn main() -> i64:
    val child = env_get("SIMPLE_LSP_QUERY_TEST_CHILD") ?? ""
    if child == "": return 10
    val (failed_out, failed_err, failed_code) = process_run_bounded(child, ["fail"], 1000, 4096)
    if failed_code != 7: return 11
    val inlay = lsp_inlay_hint_query_response("31", failed_out, failed_code)
    val action = lsp_code_action_query_response("32", "file:///sample.spl", failed_out, failed_code)
    if not inlay.contains("\"error\":{\"code\":-32603"): return 12
    if not action.contains("\"error\":{\"code\":-32603"): return 13
    if inlay.contains("\"result\"") or action.contains("\"result\""): return 14
    val (empty_out, empty_err, empty_code) = process_run_bounded(child, ["empty"], 1000, 4096)
    if empty_code != 0 or empty_out != "" or empty_err != "": return 15
    if not lsp_inlay_hint_query_response("33", empty_out, empty_code).contains("\"result\":[]"): return 16
    if not lsp_code_action_query_response("34", "file:///sample.spl", empty_out, empty_code).contains("\"result\":[]"): return 17
    print "LSP_REAL_CHILD_FAILURE_AND_EMPTY_OK"
    0
