use compiler.backend.codegen.{Codegen}
use compiler.loader.jit_instantiator.{JitInstantiatorConfig}

fn no_codegen() -> Option<Codegen>:
    nil

fn main() -> i64:
    val config = JitInstantiatorConfig(
        update_smf: false,
        max_depth: 50,
        enabled: true,
        verbose: false
    )
    val codegen = no_codegen()
    val passed = config.enabled and codegen == nil
    print("codegen JIT imports resolved: {passed}")
    if passed: 0 else: 1
