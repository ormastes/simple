# Probe for cwd-independent runtime-source discovery (FIX B).
#
# Prints the resolved runtime source directory so a spec can run this SAME
# program from several working directories and compare the answers. The probe
# deliberately does NOT set SIMPLE_PROJECT_ROOT: the point is what discovery
# finds on its own, from the executable's location, when cwd gives no help.
use compiler.backend.backend.runtime_compiler.{find_runtime_source_dir}

fn main():
    print("RTDIR=" + find_runtime_source_dir())
