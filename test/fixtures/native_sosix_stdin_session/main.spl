"""Actual fd0 pipe fixture. Admitted native execution required; UNRUN."""
use std.nogc_sync_mut.sffi.cli_args.{cli_get_args}
use std.nogc_sync_mut.io.text_session.{TextSessionCodec, text_session_codec, utf8_text_session_codec}
use std.common.encoding.external_text.{Encoding, TextByteOrder, BomPolicy, CodecErrorKind}
use std.nogc_sync_mut.io.external_text_io.{TextIoError}
use std.nogc_sync_mut.io.file_bytes.{file_read_borrowed_bytes}
use std.nogc_async_mut.sosix.stdin.{sosix_stdin_text, sosix_stdin_utf8}
use std.common.text_bytes.{boxed_text_bytes_checked}

fn profile(order: TextByteOrder, bom: BomPolicy) -> TextSessionCodec:
    text_session_codec(Encoding.Utf16, order, bom, Encoding.Utf8, TextByteOrder.NotApplicable, BomPolicy.Preserve, 16, 16).unwrap()

fn assert_kind(value: Result<text?, TextIoError>, kind: CodecErrorKind, offset: i64):
    match value:
        case Err(TextIoError.Codec(error)):
            assert(error.kind == kind)
            assert(error.byte_offset == offset)
        case _: assert(false)

fn main() -> i64:
    val args = cli_get_args()
    assert(args.len() == 2)
    val mode = args[1]
    if mode == "utf8":
        var session = sosix_stdin_utf8(16).unwrap()
        assert(session.read_chunk(1).unwrap().unwrap() == "A")
        val nul = session.read_scalar_text().unwrap().unwrap()
        val bytes = boxed_text_bytes_checked(nul).unwrap()
        assert(bytes.len() == 1 and bytes[0] == 0u8)
        assert(session.read_chunk(1).unwrap().unwrap() == "")
        assert(session.pending_byte_count() == 1)
        assert(session.read_text(1).unwrap() == "🙂")
        assert(session.pending_byte_count() == 0)
        assert(session.read_scalar_text().unwrap() == nil)
        assert(session.at_eof())
        assert(session.read_chunk(1).unwrap() == nil)
    elif mode == "utf16le" or mode == "utf16be":
        var order = TextByteOrder.LittleEndian
        if mode == "utf16be": order = TextByteOrder.BigEndian
        var session = sosix_stdin_text(profile(order, BomPolicy.Require)).unwrap()
        assert(session.read_scalar_text().unwrap().unwrap() == "🙂")
        val nul = boxed_text_bytes_checked(session.read_scalar_text().unwrap().unwrap()).unwrap()
        assert(nul.len() == 1 and nul[0] == 0u8)
        assert(session.read_scalar_text().unwrap().unwrap() == "Z")
        assert(session.read_scalar_text().unwrap() == nil)
        assert(session.at_eof())
    elif mode == "utf32le" or mode == "utf32be":
        var order = TextByteOrder.LittleEndian
        if mode == "utf32be": order = TextByteOrder.BigEndian
        val codec = text_session_codec(Encoding.Utf32, order, BomPolicy.Require, Encoding.Utf8, TextByteOrder.NotApplicable, BomPolicy.Preserve, 16, 16).unwrap()
        var session = sosix_stdin_text(codec).unwrap()
        assert(session.read_scalar_text().unwrap().unwrap() == "🙂")
        val nul = boxed_text_bytes_checked(session.read_scalar_text().unwrap().unwrap()).unwrap()
        assert(nul.len() == 1 and nul[0] == 0u8)
        assert(session.read_scalar_text().unwrap() == nil)
    elif mode == "provider-error":
        var session = sosix_stdin_utf8(1).unwrap()
        match session.read_chunk(1):
            case Err(TextIoError.Transport(first)):
                assert(not session.is_open())
                match session.read_chunk(1):
                    case Err(TextIoError.Transport(second)):
                        assert(first.kind == second.kind and first.message == second.message)
                    case _: assert(false)
            case _: assert(false)
        assert(not session.at_eof())
    elif mode == "alias-close":
        var session = sosix_stdin_utf8(1).unwrap()
        var alias = session
        alias.close()
        assert(not session.is_open())
        assert(session.read_chunk(1).is_err())
        val untouched = file_read_borrowed_bytes(0, 1).unwrap()
        assert(untouched.len() == 1 and untouched[0] == 90u8)
    elif mode == "cancel-pending":
        var session = sosix_stdin_utf8(1).unwrap()
        assert(session.read_chunk(1).unwrap().unwrap() == "")
        assert(session.pending_byte_count() == 1)
        session.close()
        assert(not session.at_eof())
        assert(session.read_chunk(1).is_err())
        val remaining = file_read_borrowed_bytes(0, 1).unwrap()
        assert(remaining.len() == 1 and remaining[0] == 159u8)
    elif mode == "preserve":
        val codec = text_session_codec(Encoding.Utf8, TextByteOrder.NotApplicable, BomPolicy.Preserve, Encoding.Utf8, TextByteOrder.NotApplicable, BomPolicy.Preserve, 8, 8).unwrap()
        var session = sosix_stdin_text(codec).unwrap()
        val bom = boxed_text_bytes_checked(session.read_scalar_text().unwrap().unwrap()).unwrap()
        assert(bom.len() == 3 and bom[0] == 239u8 and bom[1] == 187u8 and bom[2] == 191u8)
        assert(session.read_scalar_text().unwrap().unwrap() == "Z")
    elif mode == "forbid":
        val codec = text_session_codec(Encoding.Utf8, TextByteOrder.NotApplicable, BomPolicy.Forbid, Encoding.Utf8, TextByteOrder.NotApplicable, BomPolicy.Preserve, 8, 8).unwrap()
        var session = sosix_stdin_text(codec).unwrap()
        assert_kind(session.read_scalar_text(), CodecErrorKind.ForbiddenBom, 0)
        assert_kind(session.read_scalar_text(), CodecErrorKind.ForbiddenBom, 0)
        val remaining = file_read_borrowed_bytes(0, 1).unwrap()
        assert(remaining.len() == 1 and remaining[0] == 90u8)
    elif mode == "missing-bom":
        var session = sosix_stdin_text(profile(TextByteOrder.LittleEndian, BomPolicy.Require)).unwrap()
        assert_kind(session.read_scalar_text(), CodecErrorKind.MissingBom, 0)
    elif mode == "invalid":
        var session = sosix_stdin_utf8(16).unwrap()
        assert_kind(session.read_scalar_text(), CodecErrorKind.InvalidUtf8, 0)
        assert(not session.is_open())
        assert_kind(session.read_scalar_text(), CodecErrorKind.InvalidUtf8, 0)
        val remaining = file_read_borrowed_bytes(0, 1).unwrap()
        assert(remaining.len() == 1 and remaining[0] == 90u8)
    elif mode == "truncated":
        var session = sosix_stdin_utf8(16).unwrap()
        assert_kind(session.read_scalar_text(), CodecErrorKind.TruncatedInput, 0)
        assert_kind(session.read_scalar_text(), CodecErrorKind.TruncatedInput, 0)
        assert(not session.at_eof())
        assert(file_read_borrowed_bytes(0, 1).unwrap().len() == 0)
    elif mode == "truncated16":
        var session = sosix_stdin_text(profile(TextByteOrder.LittleEndian, BomPolicy.Preserve)).unwrap()
        assert_kind(session.read_scalar_text(), CodecErrorKind.TruncatedInput, 0)
    elif mode == "closed":
        var session = sosix_stdin_utf8(1).unwrap()
        assert(session.read_chunk(0).is_err())
        assert(session.read_chunk(2).is_err())
        assert(session.read_scalar_text().unwrap().unwrap() == "A")
        session.close()
        session.close()
        assert(not session.is_open())
        assert(session.read_chunk(1).is_err())
        val remaining = file_read_borrowed_bytes(0, 1).unwrap()
        assert(remaining.len() == 1 and remaining[0] == 66u8)
    elif mode == "empty":
        var session = sosix_stdin_utf8(1).unwrap()
        assert(session.read_chunk(1).unwrap() == nil)
        assert(session.at_eof())
        assert(session.read_text(1).unwrap() == "")
    elif mode == "metadata":
        assert(utf8_text_session_codec(0, 1).is_err())
        assert(utf8_text_session_codec(16777217, 1).is_err())
        assert(text_session_codec(Encoding.Unknown("guess"), TextByteOrder.NotApplicable, BomPolicy.Preserve, Encoding.Utf8, TextByteOrder.NotApplicable, BomPolicy.Preserve, 8, 8).is_err())
        assert(text_session_codec(Encoding.Utf16, TextByteOrder.NotApplicable, BomPolicy.Preserve, Encoding.Utf8, TextByteOrder.NotApplicable, BomPolicy.Preserve, 8, 8).is_err())
        val untouched = file_read_borrowed_bytes(0, 1).unwrap()
        assert(untouched.len() == 1 and untouched[0] == 90u8)
    else:
        return 2
    print "stdin-session-ok"
    0
