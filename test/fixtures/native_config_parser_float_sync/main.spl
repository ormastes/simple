use nogc_sync_mut.config_parser.{ConfigSection, get_config_float}

fn main() -> i64:
    val section = ConfigSection(
        name: "native-float",
        fields: {"valid": "1.25", "malformed": "not-a-number"}
    )
    val parsed = get_config_float(section, "valid", 9.5)
    val malformed = get_config_float(section, "malformed", 9.5)
    val parsed_ok = parsed == 1.25
    val malformed_ok = malformed == 9.5
    if parsed_ok and malformed_ok:
        print("PASS config float sync valid=1.25 malformed=9.5")
        return 0
    print("FAIL config float sync parsed={parsed} malformed={malformed} valid_ok={parsed_ok} malformed_ok={malformed_ok}")
    1
