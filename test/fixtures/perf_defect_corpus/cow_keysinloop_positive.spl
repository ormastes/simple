# PERF-COW-003 POSITIVE — must be flagged.
# The receiver does not change with the loop, so the same key vector is
# rebuilt every iteration: O(n) per iteration, O(n^2) per loop.
class KeysInLoopPositive:
    table: Dict<text, i64>

    me walk():
        var i = 0
        while i < 10:
            val ks = self.table.keys()
            i = i + 1
