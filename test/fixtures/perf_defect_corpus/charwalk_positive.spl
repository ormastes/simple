# CHARWALK POSITIVE — currently NOT detected by any lint rule. See README.md.
#
# One interpreted `substring(i, i + 1)` per character, with no native fast
# reject, is the shape commit 8d3b7d009b9 removed (CHARWALK rows in
# scripts/check/check-perf-regression-tests.shs). It is a real cost class, but
# it is NOT ruled: the identical loop is unavoidable and correct wherever a
# character actually must be classified one at a time (this repo's own lint
# helpers do it), so a rule on the shape alone would fire on every correct use.
# Discriminating needs to know whether a native scan could have replaced the
# loop — a dataflow question a text lint cannot answer.
fn count_marker(s: text) -> i64:
    var count = 0
    var i = 0
    while i + 2 < s.len():
        if s.slice(i, i + 3) == "\"\"\"":
            count = count + 1
            i = i + 3
        else:
            i = i + 1
    count
