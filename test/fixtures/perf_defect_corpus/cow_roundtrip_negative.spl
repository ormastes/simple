# PERF-COW-001 NEGATIVE — must NOT be flagged.
# Same observable behaviour, mutated through the single owner: O(1) amortized.
class RoundTripNegative:
    table: [i64]

    me add(v: i64):
        self.table.push(v)

    # A take that is never mutated is not a hot path and must stay clean.
    me touch():
        val t = self.table
        self.table = t
