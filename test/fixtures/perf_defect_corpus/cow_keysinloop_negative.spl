# PERF-COW-003 NEGATIVE — must NOT be flagged.
# Two distinct correct shapes:
#   walk_hoisted  — the call is hoisted above the loop, materialized once.
#   walk_varying  — the receiver is REBOUND each iteration, so each
#                   materialization is of a DIFFERENT dict and the total is
#                   O(total entries). Optimal, and not rewritable into anything
#                   cheaper. Flagging this was a measured false positive.
class KeysInLoopNegative:
    table: Dict<text, i64>
    surfaces: [Surface]

    me walk_hoisted():
        val ks = self.table.keys()
        for k in ks:
            use_key(k)

    me walk_varying():
        for surface in self.surfaces:
            val names = surface.callables.keys()
            use_names(names)
