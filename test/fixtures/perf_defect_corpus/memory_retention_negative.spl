# MEMORY-RETENTION NEGATIVE — the same accumulation with an explicit bound.
# Also not statically distinguished from the positive by any lint rule; it is
# here so the pair documents what the corrected shape looks like, and so a
# future runtime-budget detector has both sides to test against.
class BoundedModuleAstCache:
    entries: [text]
    max_entries: i64

    me record(module_source: text):
        self.entries.push(module_source)
        if self.entries.len() > self.max_entries:
            self.drop_oldest()
