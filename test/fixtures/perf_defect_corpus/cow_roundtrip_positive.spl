# PERF-COW-001 POSITIVE — must be flagged.
# The field and the local alias the same buffer across the write, so every push
# deep-copies the whole table: O(n) per write, O(n^2) overall.
class RoundTripPositive:
    table: [i64]

    me add(v: i64):
        val t = self.table
        t.push(v)
        self.table = t
