# CHARWALK NEGATIVE — the corrected form from 8d3b7d009b9.
# A native `index_of` fast reject means the per-character walk never runs on a
# line that cannot contain the marker. Semantics identical.
fn count_marker_fast(s: text) -> i64:
    if s.index_of("\"\"\"") < 0: return 0
    var count = 0
    var i = 0
    while i + 2 < s.len():
        if s.slice(i, i + 3) == "\"\"\"":
            count = count + 1
            i = i + 3
        else:
            i = i + 1
    count
