# PERF-COW-002 POSITIVE — must be flagged.
# The field still holds the buffer while the helper's parameter binding holds it
# too, so each call deep-copies the whole collection.
fn push_into(xs: [i64], v: i64) -> [i64]:
    var out = xs
    out.push(v)
    out

class ByValuePositive:
    xs: [i64]

    me add(v: i64):
        self.xs = push_into(self.xs, v)
