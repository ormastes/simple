# Native oracle, class A second instance (see ../array_element/main.spl): the
# text slice lowering read the receiver handle with `emit_cast(text -> i64)`
# before rt_slice (method_calls_literals.spl lower_text_codepoint_slice_v1 /
# lower_erased_receiver_slice_v1 / emit_runtime_array_slice_bounds), which
# Cranelift lowered as rt_slice(int(text), ...) (Stage 3 gc_config
# is_noalloc_family: `path = path[4:path.len()]` in a second branch).
# Slice units are bytes (owner decision); these rows are ASCII.
# Build: SIMPLE_BOOTSTRAP=1 native-build main.spl --entry-closure (cranelift, llvm).
# Expected stdout (seed `simple run main.spl`):
# s1 [hello]
# s2 [el]
# s3 0 [src]
# s4 0 [c/a.spl]
# s5 0 [src]
# s6 0 [a.spl]
# s7 0 [sr]
# s8 0 []
# s9 0 [/a.spl]
# s10 0 []
# s3 1 [b]
# s4 1 []
# s5 1 [b]
# s6 1 []
# s7 1 [b]
# s8 1 []
# s9 1 []
# s10 1 []
# s11 [rc/a.spl]
# s11 []
# s12 [text]
# s13 [nogc.fs]
# s14 [common]
# s15 [src/a.spl]
#
# s1 literal; s2/s4/s5 param; s3/s6-s10 `[text]` element ([a:b], [a:], [:b],
# empty, clamped and out-of-range bounds); s11 for-in element; s12-s15 the
# two-branch reassigning shape of is_noalloc_family.

fn strip(module_path: text) -> text:
    var path = module_path
    if path.starts_with("std."):
        path = path[4:path.len()]
    elif path.starts_with("lib."):
        path = path[4:path.len()]
    path

fn mid(path: text) -> text:
    path[1:3]

fn from2(path: text) -> text:
    path[2:]

fn to3(path: text) -> text:
    path[:3]

fn main():
    val lit = "hello.spl"
    print "s1 [{lit[0:5]}]"
    print "s2 [{mid(lit)}]"
    val inputs: [text] = ["src/a.spl", "b"]
    var i = 0
    while i < inputs.len():
        val p = inputs[i]
        print "s3 {i} [{p[0:3]}]"
        print "s4 {i} [{from2(p)}]"
        print "s5 {i} [{to3(p)}]"
        print "s6 {i} [{p[4:]}]"
        print "s7 {i} [{p[:2]}]"
        print "s8 {i} [{p[1:1]}]"
        print "s9 {i} [{p[3:100]}]"
        print "s10 {i} [{p[50:60]}]"
        i = i + 1
    for q in inputs:
        print "s11 [{q[1:]}]"
    print "s12 [{strip(\"std.text\")}]"
    print "s13 [{strip(\"lib.nogc.fs\")}]"
    print "s14 [{strip(\"common\")}]"
    print "s15 [{strip(inputs[0])}]"
