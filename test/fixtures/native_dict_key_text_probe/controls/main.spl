# Control rows for native_dict_key_text_probe/array_element: dict probes with
# literal / concatenated keys and genuine `int(text)` / `.to_int()` parses,
# which must keep working after the dict-key reinterpret becomes a Bitcast.
# Build: SIMPLE_BOOTSTRAP=1 native-build main.spl --entry-closure (cranelift, llvm).
# Expected stdout (seed `simple run main.spl`):
# k1 hit
# k2 miss
# k3 hit
# k4 true
# n1 42
# n2 42
# n3 18
# n4 5
# n5 0

var cache: {text: text} = {}

fn lookup(path: text) -> text:
    if cache.has(path):
        return cache[path]
    "miss"

fn main():
    cache["hello.spl"] = "hit"
    print "k1 {lookup(\"hello.spl\")}"
    print "k2 {lookup(\"other.spl\")}"
    val built = "hello" + ".spl"
    print "k3 {lookup(built)}"
    print "k4 {cache.has(\"hello.spl\")}"
    val s = "42"
    print "n1 {int(s)}"
    print "n2 {s.to_int()}"
    print "n3 {int(\"17\") + 1}"
    val parts: [text] = ["5", "x9"]
    print "n4 {int(parts[0])}"
    print "n5 {int(parts[1])}"
