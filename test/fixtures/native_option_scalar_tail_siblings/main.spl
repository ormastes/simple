# Sibling shapes for doc/08_tracking/bug/stage2_implicit_tail_optional_return_takes_scalar_arm_2026-11-15.md
# Kept apart from native_option_f64_enum_payload so a refusal of one shape does
# not hide the others. Build with `native-build main.spl --backend=cranelift
# --entry-closure` (and --backend=llvm) from a directory outside test/.
# Expected stdout, exactly:
#   f32 some 1.5
#   field some -2.5
#   nfield none
#   arr some 1.5 -2.25
#   arr none
#   arg some -7.75
#   arg none
#   i64_tail some 3
#   i64_big some 9000000000
#   i64_match_none none
#   bool some false
#   text some hi
#   bare_x some 3
#   bare_nil none
# Consumers use `match`, not `if val`: `if val a = <i64? None>` separately
# reads as `some 3` on current Stage 2 (see the bug doc), and these rows test
# the producer.

struct H:
    o: f64?

fn f32_tail(x: f32) -> f32?:
    Some(x)

fn mk_field(x: f64) -> H:
    H(o: Some(x))

fn arr_tail(b: bool) -> [f64]?:
    if b:
        Some([1.5, -2.25])
    else:
        None

fn take(o: f64?) -> text:
    match o:
        case Some(x): "some {x}"
        case None: "none"

fn i64_tail(x: i64) -> i64?:
    Some(x)

fn i64_match(k: i64) -> i64?:
    match k:
        case 0: Some(9000000000)
        case _: None

fn bool_tail(b: bool) -> bool?:
    Some(b)

fn text_tail(s: text) -> text?:
    Some(s)

fn bare_x(x: i64) -> i64?:
    x

fn bare_nil() -> i64?:
    nil

fn show_i(label: text, v: i64?):
    match v:
        case Some(x): print "{label} some {x}"
        case None: print "{label} none"

fn main():
    val y: f32 = 1.5
    match f32_tail(y):
        case Some(x): print "f32 some {x}"
        case None: print "f32 none"
    match mk_field(-2.5).o:
        case Some(x): print "field some {x}"
        case None: print "field none"
    match H(o: None).o:
        case Some(x): print "nfield some {x}"
        case None: print "nfield none"
    match arr_tail(true):
        case Some(a): print "arr some {a[0]} {a[1]}"
        case None: print "arr none"
    match arr_tail(false):
        case Some(a): print "arr some {a.len()}"
        case None: print "arr none"
    val z: f64 = -7.75
    print "arg {take(Some(z))}"
    print "arg {take(None)}"
    show_i("i64_tail", i64_tail(3))
    show_i("i64_big", i64_match(0))
    show_i("i64_match_none", i64_match(1))
    match bool_tail(false):
        case Some(b): print "bool some {b}"
        case None: print "bool none"
    match text_tail("hi"):
        case Some(t): print "text some {t}"
        case None: print "text none"
    show_i("bare_x", bare_x(3))
    show_i("bare_nil", bare_nil())
