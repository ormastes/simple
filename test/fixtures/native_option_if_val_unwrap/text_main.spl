class Box:
    v: i64

impl Box:
    fn label() -> Option<text>:
        if self.v > 0:
            return Some("positive")
        None

fn main() -> i64:
    val b = Box(v: 42)
    val r = b.label()
    if val lbl = r:
        if lbl != "positive":
            return 1
    else:
        return 2
    print("option-struct-method-ok")
    0
