# Caller of a split-impl method: must import the provider that defines it,
# not only the type owner, or native entry-closure discovery drops it.
use stage_hir_split_impl.owner_type.{StageOwner}
use stage_hir_split_impl.narrow_provider.*

fn caller_main() -> i64:
    val owner = StageOwner(count: 41)
    owner.stage_core()
