# Direct production-SDK subset; no successful request acknowledgement required.
use test.fixtures.daemon_sdk.publication_regression.{daemon_publication_failure_case}
use test.fixtures.daemon_sdk.owned_poll_v1.{
    owned_poll_idle_stopped_case, owned_poll_publication_failure_case
}

fn main() -> i64:
    val idle = owned_poll_idle_stopped_case()
    if idle != 0:
        return idle
    val blocked = owned_poll_publication_failure_case()
    if blocked != 0:
        return blocked
    val legacy = daemon_publication_failure_case()
    if legacy != 0:
        return legacy
    print "daemon owned poll idle/stopped/owned-publication/legacy-publication subset: PASS"
    0
