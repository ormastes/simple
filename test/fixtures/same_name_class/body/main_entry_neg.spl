# Fixture driver: the entry module's own bare `P` is not another module's `P`.
# Tracks: interpreter_same_name_class_method_dispatch_collision_2026_11_26
use test.fixtures.same_name_class.body.qa.{qa_make, qa_any}

struct P:
    x: i64

fn m_entry(p) -> i64:
    match p:
        case P { x }:
            x
        case _:
            -1

fn main():
    print "entryneg a_entry={qa_any(P(x: 9))} e_a={m_entry(qa_make())} e_e={m_entry(P(x: 9))} a_a={qa_any(qa_make())}"
