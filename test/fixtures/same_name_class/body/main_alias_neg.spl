# Fixture driver: a pattern on an import (or alias) of one module's `P` must
# reject the other module's same-named `P`. Tracks:
# interpreter_same_name_class_method_dispatch_collision_2026_11_26
use test.fixtures.same_name_class.body.qa.{P, qa_make}
use test.fixtures.same_name_class.body.qb.{P as Q, qb_make}

fn mp(p) -> i64:
    match p:
        case P { x }:
            x
        case _:
            -1

fn mq(p) -> i64:
    match p:
        case Q { x }:
            x
        case _:
            -1

fn main():
    print "aliasneg pa={mp(qa_make())} pb={mp(qb_make())} qa={mq(qa_make())} qb={mq(qb_make())}"
