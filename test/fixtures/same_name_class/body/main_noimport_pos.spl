# Fixture driver (positive control): the entry module imports qd's `Gizmo`,
# so the pattern binds qd's class: qd's instance matches, qe's same-named
# instance is rejected. Tracks:
# interpreter_class_identity_no_scope_fallback_fail_open_2026_11_27
use test.fixtures.same_name_class.body.qd.{Gizmo, qd_make}
use test.fixtures.same_name_class.body.qe.{qe_make}

fn m_pos(v) -> i64:
    match v:
        case Gizmo { n }:
            n
        case _:
            -9

fn main():
    print "import d={m_pos(qd_make())} e={m_pos(qe_make())}"
