# Fixture driver: the entry module neither declares nor imports `Gizmo`, so
# an owner-exact `Gizmo` instance must NOT match a bare `Gizmo` pattern --
# the no-scope fallback is fail-closed. Tracks:
# interpreter_class_identity_no_scope_fallback_fail_open_2026_11_27
use test.fixtures.same_name_class.body.qd.{qd_make}
use test.fixtures.same_name_class.body.qe.{qe_make}

fn m_noi(v) -> i64:
    match v:
        case Gizmo { n }:
            n
        case _:
            -9

fn main():
    print "noimport d={m_noi(qd_make())} e={m_noi(qe_make())}"
