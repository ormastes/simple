# Fixture driver: plain import of pa.Thing beside an alias of pb.Thing.
use test.fixtures.same_name_class.pa.Thing
use test.fixtures.same_name_class.pb.Thing as Legacy
use test.fixtures.same_name_class.pc.{old_compile, old_make}

fn main():
    val a = Thing.create()
    val l = Legacy.create()
    print "alias an={a.n} ac={a.compile()} atag={Thing.tag()} ln={l.n} lsize={l.size()} lc={l.compile()} ltag={Legacy.tag()}"
    print "third oc={old_compile(old_make())} disp={l}"
