pub class SpanProbe:
    value: i64

    static fn empty() -> SpanProbe:
        SpanProbe(value: 0)

    static fn at(value: i64) -> SpanProbe:
        SpanProbe(value: value)

    fn merge(self, other: SpanProbe) -> SpanProbe:
        SpanProbe(value: self.value + other.value)

fn main() -> i64:
    val first = SpanProbe.empty()
    val second = SpanProbe.at(42)
    val actual = first.merge(second)
    if actual.value != 42:
        print "FAIL: local self type returned {actual.value}"
        return 1
    print "local class self type: 42"
    0
