use std.common.sdn.value.{SdnSpan}

fn main() -> i64:
    val first = SdnSpan.at(7, 42)
    val second = SdnSpan.empty()
    val actual = first.merge(second)
    if actual.line != 7 or actual.column != 42:
        print "FAIL: SdnSpan direct import {actual.line}:{actual.column}"
        return 1
    print "SdnSpan direct import: 7:42"
    0
