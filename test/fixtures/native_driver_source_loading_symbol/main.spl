use compiler.driver.driver_source_loading.{_driver_module_name_from_path, _format_trait_error, _format_type_infer_error}
use compiler.hir.hir_types.{HirSymbol, ScopeId, SymbolId, SymbolKind}
use compiler.common.dependency.visibility.{Visibility}
use compiler.types.type_infer_types.{TypeInferError}
use compiler.traits.trait_validation.{TraitError}
use compiler.frontend.core.lexer.{Span}

fn main():
    val span = Span(start: 4, end_pos: 11, line: 3, col: 7)
    val formatted = _format_type_infer_error(TypeInferError.Undefined("missing_name", span))
    val trait_name = HirSymbol(id: SymbolId(id: 7), name: "Drawable", kind: SymbolKind.Trait, type_: nil, scope: ScopeId(id: 0), span: span, visibility: Visibility.Public, is_public: true, is_mutable: false, defining_module: nil)
    val trait_formatted = _format_trait_error(TraitError.UndefinedTrait(trait_name, span))
    val module_name = _driver_module_name_from_path("src/compiler/80.driver/driver_source_loading.spl")
    print("driver source loading resolved: {module_name}:{formatted.contains("missing_name")}:{trait_formatted.contains("add an import")}")
