use compiler.driver.driver_source_loading.{_driver_module_name_from_path, _format_type_infer_error}
use compiler.types.type_infer_types.{TypeInferError}
use compiler.frontend.core.lexer.{Span}

fn main():
    val span = Span(start: 4, end_pos: 11, line: 3, col: 7)
    val formatted = _format_type_infer_error(TypeInferError.Undefined("missing_name", span))
    val module_name = _driver_module_name_from_path("src/compiler/80.driver/driver_source_loading.spl")
    print("driver source loading resolved: {module_name}:{formatted.contains("missing_name")}")
