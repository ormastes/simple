# Fixture for test/01_unit/bugs/dict_of_functions_dot_call_spec.spl.
fn always(p: text) -> bool:
    true

fn inc(p: i64) -> i64:
    p + 1

fn shout(p: text) -> text:
    p + "!"

fn main():
    val bools = {"q": always}
    val ints = {"n": inc}
    val texts = {"s": shout}
    val b = bools.q("x")
    print "bool={b}"
    if bools.q("x"):
        print "branch=taken"
    print "int={ints.n(41)}"
    print "text={texts.s("hi")}"
    print "len={ints.len()}"
    print "keys={ints.keys().len()}"
