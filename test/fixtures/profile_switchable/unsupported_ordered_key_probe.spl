# Direct ordered-map queries must reject an unsupported native key even when
# the tree is empty and no pairwise comparison would otherwise run.
use std.nogc_sync_mut.src.collections.ordered_map.OrderedMap

extern fn rt_dict_new(cap_hint: i64) -> i64

fn main():
    val opaque_key = rt_dict_new(8)
    var map: OrderedMap<i64, text> = OrderedMap.new()
    val result = map.get(opaque_key)
    if result == nil:
        print "UNREACHABLE_ORDERED_KEY_QUERY"
