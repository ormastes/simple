"""A local same-name type must not inherit the stdlib factory-family guard."""

use std.nogc_sync_mut.src.collections.adaptive_text_map.AdaptiveTextMap

class AdaptiveTextSet:
    label: text

    static fn attributed_at_site(
        source: AdaptiveTextMap, algorithm: text, site: text
    ) -> AdaptiveTextSet:
        if algorithm != "ordered" or not site.starts_with("ast://"):
            panic("custom same-name wrapper received wrong attribute")
        AdaptiveTextSet(label: "custom-wrapper")

fn make_text_map() -> AdaptiveTextMap:
    AdaptiveTextMap.new()

fn main():
    var chosen: AdaptiveTextSet = AdaptiveTextSet.attributed_at_site(
        make_text_map(), "ordered", "ast://custom-type/ordinary#stable")
    if chosen.label != "custom-wrapper":
        panic("custom same-name wrapper was bypassed")
    print "USER_SAME_NAME_FACTORY: PASS"
