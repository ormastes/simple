# Embedded replay must reject a source container bound to another target.
use std.nogc_sync_mut.src.collections.adaptive_text_set.{
    AdaptiveTextSet, adaptive_set_default_profile
}

fn main():
    val source = AdaptiveTextSet.with_site_and_target(
        adaptive_set_default_profile(), "ast://embedded/mismatch#stable", "target-a")
    AdaptiveTextSet.attributed_with_prior_at_site(
        source, "auto", "ast://embedded/mismatch#stable", "target-b",
        1, 100, 100, 50, 50, -1, -1)
    print "UNREACHABLE_EMBEDDED_REPLAY"
