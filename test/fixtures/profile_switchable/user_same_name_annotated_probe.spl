"""A user type cannot claim the compiler's adaptive collection attribute."""

use std.nogc_sync_mut.src.collections.adaptive_text_map.AdaptiveTextMap

class AdaptiveTextSet:
    label: text

    static fn attributed_at_site(
        source: AdaptiveTextMap, algorithm: text, site: text
    ) -> AdaptiveTextSet:
        AdaptiveTextSet(label: "user-owned")

fn make_text_map() -> AdaptiveTextMap:
    AdaptiveTextMap.new()

fn main():
    @collection_algorithm("ordered")
    var wrong: AdaptiveTextSet = make_text_map()
    print "UNREACHABLE_USER_SAME_NAME_ATTRIBUTE"
