"""A cross-module factory keeps its official result family."""

use std.nogc_sync_mut.src.collections.adaptive_text_set.{
    AdaptiveTextSet, AdaptiveSetAlgorithm
}
use test.fixtures.profile_switchable.reexported_factory_owner.{
    make_reexported_set as make_imported_set
}

fn main():
    @collection_algorithm("ordered")
    var chosen: AdaptiveTextSet = make_imported_set()
    if chosen.selected_algorithm() != AdaptiveSetAlgorithm.Ordered:
        panic("re-exported factory lost forced ordered storage")
    if not chosen.insert("z") or not chosen.insert("a"):
        panic("re-exported factory lost set insertion")
    val values = chosen.snapshot_values()
    if values.len() != 2 or values[0] != "a" or values[1] != "z":
        panic("re-exported factory lost ordering")
    print "REEXPORTED_COLLECTION_FACTORY: PASS"
