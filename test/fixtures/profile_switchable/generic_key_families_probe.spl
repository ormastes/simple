# Generic key families exercise the generic backing, not the text-only helpers.
use std.nogc_sync_mut.src.collections.adaptive_set.AdaptiveSet
use std.nogc_sync_mut.src.collections.adaptive_map.AdaptiveMap
use std.nogc_sync_mut.src.collections.adaptive_text_set.AdaptiveSetAttribute

fn psc_acceptance_text_keys():
    var set: AdaptiveSet<text> = AdaptiveSet.new()
    var map: AdaptiveMap<text, i64> = AdaptiveMap.new()
    for attribute in [AdaptiveSetAttribute.Linear, AdaptiveSetAttribute.Hash,
            AdaptiveSetAttribute.Ordered, AdaptiveSetAttribute.Auto]:
        set.set_attribute(attribute)
        map.set_attribute(attribute)
        set.clear()
        map.clear()
        for key in ["z", "", "alpha"]:
            if not set.insert(key) or not map.put(key, key.len()):
                panic("generic text insertion failed")
        if set.insert("alpha") or map.put("alpha", 99):
            panic("generic text replacement changed cardinality")
        if set.len() != 3 or map.len() != 3:
            panic("generic text duplicate count differs")
        val keys = set.snapshot_values()
        val entries = map.entries()
        if keys != ["", "alpha", "z"] or entries.len() != 3:
            panic("generic text snapshot order differs")
        if entries[0].key != "" or entries[0].value != 0 or
                entries[1].key != "alpha" or entries[1].value != 99 or
                entries[2].key != "z" or entries[2].value != 1:
            panic("generic text map replacement lost values")
        for transition in [AdaptiveSetAttribute.Hash, AdaptiveSetAttribute.Ordered,
                AdaptiveSetAttribute.Linear]:
            set.set_attribute(transition)
            map.set_attribute(transition)
            val found = map.get("alpha")
            if not set.contains("") or found == nil or found.unwrap() != 99:
                panic("generic text populated transition lost values")
        val removed = map.remove("")
        if not set.remove("") or removed == nil or removed.unwrap() != 0:
            panic("generic text empty key removal failed")
        if set.contains("") or map.get("") != nil:
            panic("generic text removed key remains")

fn psc_acceptance_boolean_keys():
    var set: AdaptiveSet<bool> = AdaptiveSet.new()
    var map: AdaptiveMap<bool, text> = AdaptiveMap.new()
    for attribute in [AdaptiveSetAttribute.Linear, AdaptiveSetAttribute.Hash,
            AdaptiveSetAttribute.Ordered, AdaptiveSetAttribute.Auto]:
        set.clear()
        map.clear()
        set.set_attribute(attribute)
        map.set_attribute(attribute)
        if not set.insert(true) or not set.insert(false):
            panic("generic boolean set insertion failed")
        if not map.put(true, "yes") or not map.put(false, "no"):
            panic("generic boolean map insertion failed")
        if set.insert(false) or map.put(false, "updated"):
            panic("generic boolean replacement changed cardinality")
        for transition in [AdaptiveSetAttribute.Ordered, AdaptiveSetAttribute.Linear,
                AdaptiveSetAttribute.Hash]:
            set.set_attribute(transition)
            map.set_attribute(transition)
            val keys = set.snapshot_values()
            val entries = map.entries()
            if keys != [false, true] or set.len() != 2 or map.len() != 2:
                panic("generic boolean populated transition changed contents")
            if entries.len() != 2 or entries[0].key != false or
                    entries[0].value != "updated" or entries[1].key != true or
                    entries[1].value != "yes":
                panic("generic boolean snapshot order or values differ")
        val removed = map.remove(false)
        if not set.remove(false) or removed == nil or removed.unwrap() != "updated":
            panic("generic boolean removal failed")
        if set.contains(false) or map.get(false) != nil:
            panic("generic boolean absent lookup failed")

fn main():
    psc_acceptance_text_keys()
    psc_acceptance_boolean_keys()
    print "COLLECTION_GENERIC_KEY_FAMILIES: PASS"
