"""An imported alias retains the official collection family's identity."""

use std.nogc_sync_mut.src.collections.adaptive_text_set.{
    AdaptiveTextSet as AliasedTextSet, AdaptiveSetAlgorithm
}

fn make_aliased_set() -> AliasedTextSet:
    AliasedTextSet.new()

fn main():
    @collection_algorithm("hash")
    var chosen: AliasedTextSet = make_aliased_set()
    if chosen.selected_algorithm() != AdaptiveSetAlgorithm.Hash:
        panic("alias lost the forced physical algorithm")
    if not chosen.insert("value") or not chosen.contains("value"):
        panic("alias lost the logical set value")
    print "ALIASED_COLLECTION_FACTORY: PASS"
