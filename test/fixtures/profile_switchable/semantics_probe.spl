use std.nogc_sync_mut.src.collections.adaptive_text_set.{AdaptiveTextSet, AdaptiveSetAlgorithm}
use std.nogc_sync_mut.src.collections.adaptive_text_map.AdaptiveTextMap

fn exercise_set(source: AdaptiveTextSet, name: text):
    var set = source
    if not set.insert("b") or not set.insert("a") or not set.insert("c"):
        panic("set insertion failed: " + name)
    if set.insert("a") or not set.contains("a") or set.contains("missing"):
        panic("set lookup or duplicate semantics failed: " + name)
    val before = set.snapshot_values()
    if before.len() != 3 or before[0] != "a" or before[1] != "b" or before[2] != "c":
        panic("set iteration order failed: " + name)
    if not set.remove("b") or set.remove("b") or set.len() != 2:
        panic("set removal semantics failed: " + name)
    val after = set.snapshot_values()
    if after.len() != 2 or after[0] != "a" or after[1] != "c":
        panic("set post-removal order failed: " + name)
    set.clear()
    if set.len() != 0 or set.contains("a"):
        panic("set clear semantics failed: " + name)

fn exercise_map(source: AdaptiveTextMap, name: text):
    var map = source
    if not map.put("b", "second") or not map.put("a", "first") or
            not map.put("c", "third") or map.put("a", "updated"):
        panic("map insertion or replacement failed: " + name)
    if (map.get("a") ?? "") != "updated" or map.get("missing") != nil:
        panic("map lookup semantics failed: " + name)
    val before = map.entries()
    if before.len() != 3 or before[0].key != "a" or before[0].value != "updated" or
            before[1].key != "b" or before[1].value != "second" or
            before[2].key != "c" or before[2].value != "third":
        panic("map iteration order failed: " + name)
    # Keep the mutating optional result in a local; direct remove() ?? fallback
    # is separately tracked in native_direct_mutating_option_coalesce_loses_payload.
    val removed = map.remove("b")
    val removed_again = map.remove("b")
    if (removed ?? "") != "second" or removed_again != nil or map.len() != 2:
        panic("map removal semantics failed: " + name)
    val after = map.entries()
    if after.len() != 2 or after[0].key != "a" or after[1].key != "c":
        panic("map post-removal order failed: " + name)
    map.clear()
    if map.len() != 0 or map.get("a") != nil:
        panic("map clear semantics failed: " + name)

fn main():
    @collection_algorithm("linear")
    var linear_set = AdaptiveTextSet.new()
    @collection_algorithm("hash")
    var hash_set = AdaptiveTextSet.new()
    @collection_algorithm("ordered")
    var ordered_set = AdaptiveTextSet.new()
    @collection_algorithm("linear")
    var linear_map = AdaptiveTextMap.new()
    @collection_algorithm("hash")
    var hash_map = AdaptiveTextMap.new()
    @collection_algorithm("ordered")
    var ordered_map = AdaptiveTextMap.new()
    if linear_set.selected_algorithm() != AdaptiveSetAlgorithm.Linear or
            hash_set.selected_algorithm() != AdaptiveSetAlgorithm.Hash or
            ordered_set.selected_algorithm() != AdaptiveSetAlgorithm.Ordered or
            linear_map.selected_algorithm() != AdaptiveSetAlgorithm.Linear or
            hash_map.selected_algorithm() != AdaptiveSetAlgorithm.Hash or
            ordered_map.selected_algorithm() != AdaptiveSetAlgorithm.Ordered:
        panic("source attributes did not select per-instance storage")
    exercise_set(linear_set, "linear")
    exercise_set(hash_set, "hash")
    exercise_set(ordered_set, "ordered")
    exercise_map(linear_map, "linear")
    exercise_map(hash_map, "hash")
    exercise_map(ordered_map, "ordered")
    print "COLLECTION_SEMANTICS: PASS"
