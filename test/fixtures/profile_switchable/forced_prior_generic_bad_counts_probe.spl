"""The generic map must validate embedded counts before forced storage."""

use std.nogc_sync_mut.src.collections.adaptive_map.AdaptiveMap

fn main():
    val source: AdaptiveMap<i64, text> = AdaptiveMap.new()
    val wrong: AdaptiveMap<i64, text> = AdaptiveMap.attributed_with_prior_at_site(
        source, "hash", "ast://profile/generic-bad-counts#stable", "x86_64-v3",
        0, 16, 10, 6, 4, -1, -1)
    print "UNREACHABLE_GENERIC_BAD_PROFILE_COUNTS"
