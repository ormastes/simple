"""A map factory cannot initialize an attributed text set."""

use std.nogc_sync_mut.src.collections.adaptive_text_set.AdaptiveTextSet
use std.nogc_sync_mut.src.collections.adaptive_text_map.AdaptiveTextMap

fn make_text_map() -> AdaptiveTextMap:
    AdaptiveTextMap.new()

fn main():
    @collection_algorithm("hash")
    var wrong: AdaptiveTextSet = make_text_map()
    print "UNREACHABLE_WRONG_FAMILY_FACTORY"
