use std.nogc_sync_mut.src.collections.adaptive_text_set.{AdaptiveTextSet, AdaptiveSetAlgorithm}
use std.nogc_sync_mut.src.collections.adaptive_text_map.AdaptiveTextMap
use std.nogc_sync_mut.src.collections.adaptive_map.AdaptiveMap

fn make_text_set() -> AdaptiveTextSet:
    AdaptiveTextSet.new()

fn make_text_map() -> AdaptiveTextMap:
    AdaptiveTextMap.new()

fn make_integer_map() -> AdaptiveMap<i64, text>:
    AdaptiveMap.new()

class FactoryHolder:
    @collection_algorithm("ordered")
    items: AdaptiveTextSet = make_text_set()

fn main():
    @collection_algorithm("hash")
    var chosen: AdaptiveTextMap = make_text_map()
    var ordinary = make_text_map()
    @collection_algorithm("ordered")
    var generic: AdaptiveMap<i64, text> = make_integer_map()
    var holder = FactoryHolder()
    if chosen.selected_algorithm() != AdaptiveSetAlgorithm.Hash or
            ordinary.selected_algorithm() != AdaptiveSetAlgorithm.Linear or
            generic.selected_algorithm() != AdaptiveSetAlgorithm.Ordered or
            holder.items.selected_algorithm() != AdaptiveSetAlgorithm.Ordered:
        panic("typed factory attributes selected the wrong storage")
    if not chosen.put("a", "first") or not ordinary.put("a", "other") or
            not generic.put(7, "seven") or not holder.items.insert("z") or
            not holder.items.insert("a"):
        panic("typed factory containers lost insertion semantics")
    val ordered_values = holder.items.snapshot_values()
    if (chosen.get("a") ?? "") != "first" or
            (ordinary.get("a") ?? "") != "other" or
            (generic.get(7) ?? "") != "seven" or
            ordered_values.len() != 2 or ordered_values[0] != "a" or
            ordered_values[1] != "z":
        panic("typed factory containers lost lookup or order semantics")
    print "COLLECTION_TYPED_FACTORY: PASS"
