use std.nogc_sync_mut.src.collections.adaptive_set.AdaptiveSet
use std.nogc_sync_mut.src.collections.adaptive_map.AdaptiveMap
use std.nogc_sync_mut.src.collections.adaptive_text_set.{AdaptiveSetAlgorithm, AdaptiveSetAttribute}

fn exercise_set(source: AdaptiveSet<i64>, name: text):
    var set = source
    if not set.insert(7) or not set.insert(-5) or not set.insert(10) or set.insert(7):
        panic("generic set insertion failed: " + name)
    if not set.contains(-5) or set.contains(99):
        panic("generic set lookup failed: " + name)
    val before = set.snapshot_values()
    if before.len() != 3 or before[0] != -5 or before[1] != 7 or before[2] != 10:
        panic("generic set snapshot failed: " + name)
    if not set.remove(7) or set.remove(7) or set.len() != 2:
        panic("generic set removal failed: " + name)
    set.clear()
    if set.len() != 0 or set.contains(-5):
        panic("generic set clear failed: " + name)

fn exercise_map(source: AdaptiveMap<i64, text>, name: text):
    var map = source
    if not map.put(7, "seven") or not map.put(-5, "minus") or
            not map.put(10, "ten") or map.put(7, "updated"):
        panic("generic map insertion failed: " + name)
    if (map.get(7) ?? "") != "updated" or map.contains_key(99):
        panic("generic map lookup failed: " + name)
    val before = map.entries()
    if before.len() != 3 or before[0].key != -5 or before[0].value != "minus" or
            before[1].key != 7 or before[1].value != "updated" or
            before[2].key != 10 or before[2].value != "ten":
        panic("generic map snapshot failed: " + name)
    val removed = map.remove(-5)
    val removed_again = map.remove(-5)
    if (removed ?? "") != "minus" or removed_again != nil or map.len() != 2:
        panic("generic map removal failed: " + name)
    map.clear()
    if map.len() != 0 or map.contains_key(7):
        panic("generic map clear failed: " + name)

fn main():
    @collection_algorithm("linear")
    var linear_set: AdaptiveSet<i64> = AdaptiveSet.new()
    @collection_algorithm("hash")
    var hash_set: AdaptiveSet<i64> = AdaptiveSet.new()
    @collection_algorithm("ordered")
    var ordered_set: AdaptiveSet<i64> = AdaptiveSet.new()
    @collection_algorithm("linear")
    var linear_map: AdaptiveMap<i64, text> = AdaptiveMap.new()
    @collection_algorithm("hash")
    var hash_map: AdaptiveMap<i64, text> = AdaptiveMap.new()
    @collection_algorithm("ordered")
    var ordered_map: AdaptiveMap<i64, text> = AdaptiveMap.new()
    if linear_set.selected_algorithm() != AdaptiveSetAlgorithm.Linear or
            hash_set.selected_algorithm() != AdaptiveSetAlgorithm.Hash or
            ordered_set.selected_algorithm() != AdaptiveSetAlgorithm.Ordered or
            linear_map.selected_algorithm() != AdaptiveSetAlgorithm.Linear or
            hash_map.selected_algorithm() != AdaptiveSetAlgorithm.Hash or
            ordered_map.selected_algorithm() != AdaptiveSetAlgorithm.Ordered:
        panic("generic source attributes did not select per-instance storage")
    exercise_set(linear_set, "linear")
    exercise_set(hash_set, "hash")
    exercise_set(ordered_set, "ordered")
    exercise_map(linear_map, "linear")
    exercise_map(hash_map, "hash")
    exercise_map(ordered_map, "ordered")
    var nil_payload: AdaptiveMap<i64, text?> = AdaptiveMap.new()
    nil_payload.set_attribute(AdaptiveSetAttribute.Ordered)
    if not nil_payload.put(42, nil) or not nil_payload.contains_key(42):
        panic("nil payload lost its key")
    val entries = nil_payload.entries()
    if entries.len() != 1 or entries[0].key != 42 or entries[0].value != nil:
        panic("nil payload snapshot changed")
    print "COLLECTION_GENERIC_SEMANTICS: PASS"
