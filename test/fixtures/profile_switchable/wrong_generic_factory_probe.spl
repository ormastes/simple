"""A generic set factory cannot initialize an attributed generic map."""

use std.nogc_sync_mut.src.collections.adaptive_set.AdaptiveSet
use std.nogc_sync_mut.src.collections.adaptive_map.AdaptiveMap

fn make_integer_set() -> AdaptiveSet<i64>:
    AdaptiveSet.new()

fn main():
    @collection_algorithm("hash")
    var wrong: AdaptiveMap<i64, text> = make_integer_set()
    print "UNREACHABLE_WRONG_GENERIC_FACTORY"
