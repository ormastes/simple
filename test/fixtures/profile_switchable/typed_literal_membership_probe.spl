# The literal is deliberately the receiver so ownership is local and provable.
fn literal_membership(key: i64) -> bool:
    {1: 10, 2: 20, 1: 30}.contains_key(key)

fn main():
    if not literal_membership(1) or not literal_membership(2):
        panic("typed literal membership lost a present key")
    if literal_membership(0) or literal_membership(3):
        panic("typed literal membership invented an absent key")
    print "COLLECTION_TYPED_LITERAL_MEMBERSHIP: PASS"
