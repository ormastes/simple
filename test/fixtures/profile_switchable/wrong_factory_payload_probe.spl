use std.nogc_sync_mut.src.collections.adaptive_map.AdaptiveMap

fn make_integer_map() -> AdaptiveMap<i64, i64>:
    var result: AdaptiveMap<i64, i64> = AdaptiveMap.new()
    result.put(7, 42)
    result

fn main():
    @collection_algorithm("hash")
    val selected: AdaptiveMap<i64, text> = make_integer_map()
    print "WRONG_FACTORY_PAYLOAD_ACCEPTED"
