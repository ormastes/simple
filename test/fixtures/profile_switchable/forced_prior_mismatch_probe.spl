"""Forced storage must still validate the embedded site and target evidence.

The first map proves a matching profile keeps ordered storage and map values.
The second map supplies a profile for another site; reaching the final marker
would mean forced hash silently accepted stale feedback.
"""

use std.nogc_sync_mut.src.collections.adaptive_text_set.{
    AdaptiveSetAlgorithm, adaptive_set_default_profile
}
use std.nogc_sync_mut.src.collections.adaptive_text_map.{AdaptiveTextMap}
use std.nogc_sync_mut.sffi.diag.{stdout_flush}

fn main():
    val site = "ast://forced-prior/primary#stable"
    val target = "x86_64-v3"
    val primary = AdaptiveTextMap.with_site_and_target(
        adaptive_set_default_profile(), site, target)
    var admitted = AdaptiveTextMap.attributed_with_prior_at_site(
        primary, "ordered", site, target, 1, 100, 100, 50, 50, -1, -1)
    if admitted.selected_algorithm() != AdaptiveSetAlgorithm.Ordered:
        panic("matching embedded feedback changed forced ordered storage")
    if not admitted.put("a", "first") or (admitted.get("a") ?? "") != "first":
        panic("matching forced map lost its value")
    print "FORCED_PRIOR_VALID: PASS"
    stdout_flush()

    val other = AdaptiveTextMap.with_site_and_target(
        adaptive_set_default_profile(), "ast://forced-prior/other#stable", target)
    _ = AdaptiveTextMap.attributed_with_prior_at_site(
        other, "hash", site, target, 1, 100, 100, 50, 50, -1, -1)
    print "UNREACHABLE_FORCED_PRIOR_REPLAY"
