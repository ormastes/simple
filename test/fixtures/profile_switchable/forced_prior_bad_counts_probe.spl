"""A forced policy cannot hide an impossible measured count."""

use std.nogc_sync_mut.src.collections.adaptive_text_set.{
    AdaptiveTextSet, adaptive_set_default_profile
}

fn main():
    val source = AdaptiveTextSet.with_site_and_target(
        adaptive_set_default_profile(), "ast://profile/bad-counts#stable", "x86_64-v3")
    _ = AdaptiveTextSet.attributed_with_prior_at_site(
        source, "hash", "ast://profile/bad-counts#stable", "x86_64-v3",
        1, 16, 10, 9, 9, -1, -1)
    print "UNREACHABLE_BAD_PROFILE_COUNTS"
