"""A forced policy cannot hide an incomplete hash-probe sample."""

use std.nogc_sync_mut.src.collections.adaptive_text_set.{
    AdaptiveTextSet, adaptive_set_default_profile
}

fn main():
    val source = AdaptiveTextSet.with_site_and_target(
        adaptive_set_default_profile(), "ast://profile/incomplete-hash#stable", "x86_64-v3")
    _ = AdaptiveTextSet.attributed_with_prior_at_site(
        source, "ordered", "ast://profile/incomplete-hash#stable", "x86_64-v3",
        1, 16, 10, 6, 4, 5, -1)
    print "UNREACHABLE_INCOMPLETE_HASH_PROFILE"
