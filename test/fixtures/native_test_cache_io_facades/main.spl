use app.test_cache_shared.{TestCacheEntry, shared_cache_save, shared_cache_load_entries}
use app.io.mod.{file_exists, file_delete}

fn main() -> i64:
    val path = "/tmp/simple-native-test-cache-io-facades.cache"
    var entries: {text: TestCacheEntry} = {}
    shared_cache_save(entries, path)
    val loaded = shared_cache_load_entries(path)
    val passed = file_exists(path) and loaded.len() == 0
    file_delete(path)
    print("test cache I/O facades resolved: {passed}")
    if passed: 0 else: 1
