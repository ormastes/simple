use owner.{IdentityProblem, WrappedProblem, parameter_code, payload_code}
use class_owner.{OrdinaryControl}

fn main() -> i64:
    val collision = IdentityProblem.Collision("owner-a")
    if parameter_code(collision) != "collision":
        return 11
    if payload_code(WrappedProblem.Rejected(collision)) != "collision":
        return 12
    if payload_code(WrappedProblem.Rejected(IdentityProblem.Overflow(9))) != "overflow":
        return 13
    if payload_code(WrappedProblem.Accepted) != "accepted":
        return 14
    val constructed = IdentityProblem.from_number(7)
    if constructed.code() != "overflow":
        return 15
    val ordinary = OrdinaryControl.create("ordinary-class")
    if ordinary.code() != "ordinary-class":
        return 16
    print "enum receiver identity: PASS"
    0
