pub enum IdentityProblem:
    Collision(text)
    Overflow(i64)

impl IdentityProblem:
    fn code() -> text:
        match self:
            case IdentityProblem.Collision(_): "collision"
            case IdentityProblem.Overflow(_): "overflow"

pub enum WrappedProblem:
    Rejected(IdentityProblem)
    Accepted

pub fn parameter_code(problem: IdentityProblem) -> text:
    problem.code()

pub fn payload_code(problem: WrappedProblem) -> text:
    match problem:
        case WrappedProblem.Rejected(inner): inner.code()
        case WrappedProblem.Accepted: "accepted"
