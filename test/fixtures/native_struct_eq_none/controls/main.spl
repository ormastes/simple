# Control rows for native_struct_eq_none/record: Option-typed operands against
# None, a struct against `nil`, text? against None and record == record, which
# must keep their current lowering.
# Build: SIMPLE_BOOTSTRAP=1 native-build main.spl --entry-closure (cranelift, llvm).
# Expected stdout (seed `simple run main.spl`):
# c1 false
# c2 true
# c3 false
# c4 false
# c5 true
# c6 false
# c7 true
# c8 false
# c9 true
# c10 true
# c11 false

struct M:
    name: text

fn opt_m(b: bool) -> M?:
    if b:
        Some(M(name: "s"))
    else:
        None

fn opt_eq(o: M?) -> bool:
    o == None

fn main():
    val a = M(name: "a")
    val om = opt_m(true)
    val on = opt_m(false)
    print "c1 {om == None}"
    print "c2 {on == None}"
    print "c3 {on != None}"
    print "c4 {opt_eq(om)}"
    print "c5 {opt_eq(on)}"
    print "c6 {a == nil}"
    print "c7 {a != nil}"
    val ts: text? = Some("x")
    val tn: text? = None
    print "c8 {ts == None}"
    print "c9 {tn == None}"
    print "c10 {a == M(name: \"a\")}"
    print "c11 {a == M(name: \"b\")}"
