# Native oracle rows for class B (see ../record/main.spl) on the wider Stage 3
# shapes: a record with a nested record field in a for-in (diaglink
# struct_none_nested, provider_globals.spl), a dict index result (a miss is
# nil at run time: n6), a nested field read, and `d.get(miss) == None` as an
# Option control.
# Build: SIMPLE_BOOTSTRAP=1 native-build main.spl --entry-closure (cranelift, llvm).
# Expected stdout (seed `simple run main.spl`):
# n1 2
# n2 false
# n3 true
# n4 false
# n5 true
# n6 true

struct Sid:
    id: i64

struct F:
    sym: Sid
    name: text

fn count(fs: [F]) -> i64:
    var n = 0
    for f in fs:
        if f == None:
            continue
        n = n + 1
    n

fn hit_is_none(d: Dict<text, F>, k: text) -> bool:
    d[k] == None

fn sym_of(f: F) -> bool:
    f.sym == None

fn main():
    val fs = [F(sym: Sid(id: 1), name: "a"), F(sym: Sid(id: 2), name: "b")]
    print "n1 {count(fs)}"
    var d: Dict<text, F> = {}
    d["a"] = fs[0]
    print "n2 {hit_is_none(d, \"a\")}"
    print "n3 {d[\"a\"] != None}"
    print "n4 {sym_of(fs[1])}"
    print "n5 {d.get(\"zz\") == None}"
    print "n6 {hit_is_none(d, \"zz\")}"
