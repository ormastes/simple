# Form 10: the entry declares its own same-named fn and global; the namespace
# member must still name the imported module's declaration.
use alib.core as ac

val ALIAS_BASE: i64 = 1000

fn alias_add(x: i64) -> i64:
    x + 100

fn main():
    print("{ac.alias_add(40)} {alias_add(40)} {ac.ALIAS_BASE} {ALIAS_BASE}")
