# Native regression: incompleteness must survive module scope reclamation.
use compiler.common.cache.reverse_reference_facts.*
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end}

fn main() -> i64:
    reverse_reference_owner_end_v1()
    if not reverse_reference_owner_begin_v1(): return 1
    reverse_reference_owner_mark_known_v1("trait-type-implementation")
    if not transient_scope_begin(): return 2
    val token = reverse_reference_module_begin_v1()
    if token <= 0: return 3
    reverse_reference_register_trait_candidate_v1("traits::Show", "", "unknown")
    if not transient_scope_pause(): return 4
    if not reverse_reference_module_seal_v1(token): return 5
    if not transient_scope_end(): return 6
    if not reverse_reference_module_publish_v1(token): return 7
    reverse_reference_register_trait_candidate_v1("traits::Show", "users::Item", "known")
    val snapshot = reverse_reference_owner_snapshot_v1()
    if snapshot.known_families.contains("trait-type-implementation"): return 8
    if snapshot.facts.len() != 1: return 9
    reverse_reference_owner_end_v1()
    if not reverse_reference_owner_begin_v1(): return 10
    reverse_reference_owner_mark_known_v1("trait-type-implementation")
    if not reverse_reference_owner_snapshot_v1().known_families.contains("trait-type-implementation"): return 11
    reverse_reference_owner_end_v1()
    0
