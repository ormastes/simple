# Native regression for dictionary-of-array reads through typed locals.
use compiler.common.cache.reverse_reference_facts.*

fn main() -> i64:
    reverse_reference_owner_end_v1()
    if not reverse_reference_owner_begin_v1(): return 1
    reverse_reference_owner_register_source_alias_v1("item", "phase.spl")
    val token = reverse_reference_module_begin_v1()
    if token <= 0: return 2
    reverse_reference_owner_register_source_alias_v1("item", "phase.spl")
    reverse_reference_owner_register_source_alias_v1("item", "module.spl")
    reverse_reference_owner_register_source_alias_v1("item", "module.spl")
    val merged = reverse_reference_owner_source_aliases_v1("item")
    if merged.len() != 2: return 3
    if merged[0] != "phase.spl" or merged[1] != "module.spl": return 4
    if not reverse_reference_module_abort_v1(token): return 5
    val retained = reverse_reference_owner_source_aliases_v1("item")
    if retained.len() != 1 or retained[0] != "phase.spl": return 6
    if reverse_reference_owner_source_aliases_v1("missing").len() != 0: return 7
    reverse_reference_owner_end_v1()
    0
