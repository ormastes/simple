# Explicit early return plus implicit match/if tails. Keep callees uninstrumented.
fn mixed_match(value: i64) -> i64:
    if value < 0: return -7
    match value:
        case 0: 31
        case 1: 42
        case _: 53

fn mixed_if(value: i64) -> i64:
    if value < 0: return -7
    if value == 0:
        31
    else:
        42

fn pure_tail(value: i64) -> i64:
    match value:
        case 0: 31
        case _: 42

fn explicit_tail(value: i64) -> i64:
    if value < 0: return -7
    if value == 0: return 31
    return 42

fn main() -> i64:
    if mixed_match(-1) != -7: return 21
    if mixed_match(0) != 31: return 22
    if mixed_match(1) != 42: return 23
    if mixed_match(2) != 53: return 24
    if mixed_if(-1) != -7: return 25
    if mixed_if(0) != 31: return 26
    if mixed_if(1) != 42: return 27
    if pure_tail(0) != 31: return 28
    if pure_tail(1) != 42: return 29
    if explicit_tail(-1) != -7: return 30
    if explicit_tail(0) != 31: return 31
    if explicit_tail(1) != 42: return 32
    return 0
