# No callee print: instrumentation can hide receiver/argument transport defects.
struct TailProbeLocal:
    id: i64

enum TailProbeOperand:
    Copy(TailProbeLocal?)
    Empty

fn optional_id(local: TailProbeLocal?) -> i64:
    if val item = local:
        return item.id + 7
    return -1

fn scalar_id(id: i64) -> i64:
    return id + 7

fn field_argument(operand: TailProbeOperand) -> i64:
    match operand:
        case Copy(local):
            if not local.?:
                return -1
            return scalar_id(local.id)
        case Empty:
            return -2

fn main() -> i64:
    var present: TailProbeLocal? = nil
    present = TailProbeLocal(id: 35)
    var zero: TailProbeLocal? = nil
    zero = TailProbeLocal(id: 0)
    val absent: TailProbeLocal? = nil
    if optional_id(present) != 42: return 11
    if optional_id(zero) != 7: return 12
    if optional_id(absent) != -1: return 13
    if field_argument(TailProbeOperand.Copy(present)) != 42: return 14
    if field_argument(TailProbeOperand.Copy(absent)) != -1: return 15
    if field_argument(TailProbeOperand.Empty) != -2: return 16
    if scalar_id(35) != 42: return 17
    return 0
