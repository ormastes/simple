# Native fixture: calls the C-runtime `rt_win_compare_object_handles` with
# the Win32 pseudo-handles for the current process (-1) and thread (-2).
extern fn rt_win_compare_object_handles(first: i64, second: i64) -> i32

fn main() -> i64:
    print "same -> {rt_win_compare_object_handles(-1, -1) != 0}"
    print "different -> {rt_win_compare_object_handles(-1, -2) != 0}"
    0
