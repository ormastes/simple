# A bounded diagnostic probe for the exact pure-export source shape that failed
# in the uncapped full CLI lane. Negative controls detect lost/stale error state.
use compiler.core.parser.{parse_module_silent_checked, parser_first_error_get}

fn check_parse(label: text, source: text, expected_ok: bool) -> bool:
    # This API returns the failure flag (true means an error), not success.
    val parsed = not parse_module_silent_checked(source, label)
    val first_error = parser_first_error_get()
    print "parser-probe {label}: ok={parsed}; first={first_error}"
    if parsed != expected_ok:
        return false
    if expected_ok:
        return first_error == ""
    first_error != ""

fn main() -> i64:
    val modes = "# Block Lexer Modes and Syntax Features\n#\n# Re-exports data types from frontend layer (10.frontend/block_types.spl).\n# Types were moved down to eliminate backward dependency from 10 -> 15.\n\nexport use compiler.frontend.block_types.*\n\n# Re-export helper functions\n\n"
    if not check_parse("modes.spl", modes, true): return 1
    if not check_parse("valid.spl", "fn answer() -> i64:\n    42\n", true): return 2
    if not check_parse("malformed.spl", "val broken: = 1\n", false): return 3
    if not check_parse("valid_after_error.spl", "fn answer() -> i64:\n    42\n", true): return 4
    if not check_parse("modes_after_error.spl", modes, true): return 5
    print "parser-probe: PASS"
    0
