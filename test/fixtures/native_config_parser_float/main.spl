use nogc_sync_mut.config_parser.{ConfigSection, get_config_float}

fn main() -> i64:
    val section = ConfigSection(
        name: "native-float",
        fields: {"valid": "1.25", "invalid": "not-a-number"}
    )
    val parsed = get_config_float(section, "valid", 9.5)
    val malformed = get_config_float(section, "invalid", 9.5)
    print("config parser concrete f64 lowering resolved: true parsed={parsed} malformed={malformed}")
    0
