struct Pair:
    a: i64
    b: text

enum Node:
    Leaf(i64)
    Two(Pair, Pair)

@unsafe(reason: "fixture raw payload ABI", capabilities: [ffi])
extern fn rt_enum_payload<T, TPayload>(value: T) -> TPayload
@unsafe(reason: "fixture raw tuple ABI", capabilities: [ffi])
extern fn rt_tuple_get<TElement>(tuple: i64, index: i64) -> TElement?

fn tuple_at<TElement>(tuple: i64, index: i64) -> TElement?:
    unsafe(capabilities: [ffi]):
        rt_tuple_get<TElement>(tuple, index)

fn payload_of<T>(value: T) -> i64:
    unsafe(capabilities: [ffi]):
        rt_enum_payload<T, i64>(value)

fn get_req<T>(tuple: i64, index: i64) -> T:
    tuple_at<T>(tuple, index).unwrap()

fn main():
    val n = Node.Two(Pair(a: 1, b: "left"), Pair(a: 2, b: "right"))
    val payload = payload_of<Node>(n)
    val l: Pair = get_req<Pair>(payload, 0)
    val r: Pair = get_req<Pair>(payload, 1)
    print "{l.a} {l.b} {r.a} {r.b}"
