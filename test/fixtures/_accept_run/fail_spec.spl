# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# =====================================================================
# DELIBERATE FIXTURE — NOT A PRODUCT DEFECT.
# Lane: unstable_test_mode (lane C, test/fixtures/unstable_mode/**).
# This spec FAILS AN ASSERTION ON PURPOSE so the runner's ERROR (real
# failure) outcome class has something honest to detect. Do not "fix" it.
#

# literal selector `tag: "accept"` (test_runner_files.spl, slow path; the manifest
# fast path uses entry.skip_tag). Both markers are therefore required:
# Without the second one the directory run discovers 0 files and reports
# "No test files found" with exit 4 -- measured.
# =====================================================================
"""
## Purpose and audience
Purpose: DELIBERATE failing fixture for lane C (test/fixtures/unstable_mode) —
gives the runner's ERROR (real failure) outcome class something honest to
detect. It must FAIL, forever, on purpose. Audience: test-runner owners.
"""

use std.spec.step

use std.spec.*

extern fn rt_file_exists(path: text) -> bool

describe "unstable mode failing-assertion fixture":
    # @manual scenario evidence
    it "fails a genuine assertion on purpose":
        # @req REQ-SSPEC-FIXTURES
        # @capture(protocol_json)
        step("fails a genuine assertion on purpose")
        # Real executed oracle (filesystem probe, deterministic), NOT a literal
        # mismatch: the reserved fixture-miss path can never exist, so this
        # expect is a genuine executed assertion that deterministically fails.
        expect(rt_file_exists("/.simple_fixtures/_accept_run/reserved_miss_path")).to_equal(true)  # oracle: reserved miss path must not exist — inverted on purpose, see header
