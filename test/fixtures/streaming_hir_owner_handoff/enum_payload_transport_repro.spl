# Focused native reproducer for the Stage-3 streaming HIR owner crash:
# class-valued payloads must survive (a) two consecutive Result<T, text>
# boundaries including an unwrap+rewrap, and (b) an Option class-field
# store/read across mutable methods in one large frame.
# Exit 0 + "REPRO-OK" when every payload is intact; non-zero otherwise.

class Registry:
    items: [i64]
    frozen: bool

fn freeze_registry(r: Registry) -> Result<Registry, text>:
    if r.frozen:
        return Err("already frozen")
    r.frozen = true
    Ok(r)

fn build_registry_unwrap_rewrap() -> Result<Registry, text>:
    var r = Registry(items: [], frozen: false)
    r.items = r.items.push(11)
    r.items = r.items.push(22)
    r.items = r.items.push(33)
    val fr = freeze_registry(r)
    if fr.is_err():
        return Err(fr.unwrap_err())
    # Original failing pattern: unwrap the inner Ok and rewrap the class
    # through the outer Result boundary.
    Ok(fr.unwrap())

class Driver:
    owner: Registry?
    ready: bool
    sink: i64

    me store(r: Registry) -> bool:
        self.owner = Some(r)
        self.ready = true
        self.ready

    # Large mutable frame: many live scalar locals around the class-field
    # store/load, matching the phase-2/phase-3 handoff shape where the
    # readiness scalar survived but the class handle was lost.
    me load_with_pressure() -> i64:
        var a0 = 1
        var a1 = a0 + 1
        var a2 = a1 + 1
        var a3 = a2 + 1
        var a4 = a3 + 1
        var a5 = a4 + 1
        var a6 = a5 + 1
        var a7 = a6 + 1
        var a8 = a7 + 1
        var a9 = a8 + 1
        var a10 = a9 + 1
        var a11 = a10 + 1
        var a12 = a11 + 1
        var a13 = a12 + 1
        var a14 = a13 + 1
        var a15 = a14 + 1
        if not self.ready or self.owner == nil:
            return -1
        val s = self.owner.unwrap()
        if s == nil:
            return -2
        self.sink = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15
        s.items.len()

fn main() -> i64:
    var failures = 0
    var round = 0
    while round < 2000:
        val br = build_registry_unwrap_rewrap()
        if br.is_err():
            print("REPRO-FAIL round={round}: build returned Err")
            failures = failures + 1
        else:
            val reg = br.unwrap()
            if reg == nil:
                print("REPRO-FAIL round={round}: unwrap+rewrap payload is nil")
                failures = failures + 1
            elif not reg.frozen or reg.items.len() != 3 or reg.items[0] != 11 or reg.items[2] != 33:
                print("REPRO-FAIL round={round}: payload fields corrupted len={reg.items.len()}")
                failures = failures + 1
            else:
                var d = Driver(owner: nil, ready: false, sink: 0)
                d.store(reg)
                val got = d.load_with_pressure()
                if got != 3:
                    print("REPRO-FAIL round={round}: driver field handoff lost payload got={got}")
                    failures = failures + 1
        round = round + 1
    if failures > 0:
        print("REPRO-FAIL failures={failures}")
        return 1
    print("REPRO-OK rounds=2000")
    0
