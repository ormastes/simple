# Stand-in native-build worker for ice_boundary_acceptance_spec.spl and
# ice_go_to_end_crash_supervision_spec.spl.
#
# Walks three modules through the real ICE boundary exactly as the per-module
# codegen loop does. With SIMPLE_ICE_INJECT_MODULE=mod.bad and
# SIMPLE_ICE_INJECT_KIND=abort the boundary ends this PROCESS inside mod.bad,
# leaving its breadcrumb open -- a real worker death, not a simulated one.
# SIMPLE_ICE_FIXTURE_PHASE names the bracketed phase (default `codegen`;
# `hir_lower` plays the HIR loop).
use compiler.driver.driver_ice_boundary.{
    ice_boundary_module_start, ice_boundary_module_done, ice_boundary_fail,
    ice_boundary_finalize}
use std.io_runtime.{exit, env_get_opt}

fn main():
    val phase_env = env_get_opt("SIMPLE_ICE_FIXTURE_PHASE") ?? ""
    val phase = if phase_env == "": "codegen" else: phase_env
    for name in ["mod.alpha", "mod.bad", "mod.gamma"]:
        val path = "fixture/" + name + ".spl"
        val gate = ice_boundary_module_start(name, path, phase, "fixture")
        if gate != "":
            print ice_boundary_fail(name, path, phase, "fixture", gate)
        else:
            print "compiled {name}"
            ice_boundary_module_done(name, phase)
    val summary = ice_boundary_finalize()
    if summary != "":
        print "error: {summary}"
        exit(1)

main()
