# Test DATA and bounded file input only; AUTHORED_NOT_RUN.
use std.spec.*
use std.nogc_sync_mut.io.file_ops.file_read_regular_no_follow_bounded
use std.common.contracts.orchestration.resource_set_v1.decode_resource_set

pub fn acceptance_resource_source_v1(path: text) -> Result<text, text>:
    file_read_regular_no_follow_bounded(path, 1048576)

pub fn acceptance_resource_list_v1(sources: [text]) -> text:
    if sources.len() == 0:
        return "apiVersion: orchestration.simple/v1alpha1\nkind: ResourceList\nmetadata:\n    name: acceptance-list\n    namespace: list-only\nspec:\n    items: []\n"
    var out = "apiVersion: orchestration.simple/v1alpha1\nkind: ResourceList\nmetadata:\n    name: acceptance-list\n    namespace: list-only\nspec:\n    items:\n"
    for source in sources:
        val lines = source.trim().split("\n")
        out = out + "        - " + lines[0] + "\n"
        var index = 1
        while index < lines.len():
            out = out + "          " + lines[index] + "\n"
            index = index + 1
    out

pub fn acceptance_resource_error_v1(source: text, kind: text, path: text):
    match decode_resource_set(source):
        case Ok(_):
            fail("production dispatcher accepted the malformed document")
            return
        case Err(error):
            expect(error.kind).to_equal(kind)
            expect(error.path).to_equal(path)
            expect(error.line).to_be_greater_than(0)
            expect(error.col).to_be_greater_than(0)

# No existing Pod SDN file is present in the selected fixture directory.
# This explicit Pod document is test DATA, not an alternate production decoder.
pub const ACCEPTANCE_POD_SOURCE_V1 = "apiVersion: orchestration.simple/v1alpha1\nkind: Pod\nmetadata:\n    name: acceptance-pod\n    namespace: ci\n    labels:\n        role: check\nspec:\n    os:\n        name: linux\n    runtimeClassName: native-process\n    containers:\n        - name: worker\n          command: [\"/usr/bin/busybox\", \"echo\"]\n          args: [\"pod-check\"]\n"
