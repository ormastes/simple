# NOT_BUILT. Compile with the admitted producer and exact configured runtime.
# Args intentionally contain shell metacharacters; this is a literal Exec oracle.
use std.sosix.host.{sosix_get_cli_args}
use std.sosix.stdio.{sosix_println}
use std.sosix.time.{sosix_sleep_ms}
use app.io.mod.{env_get, env_get_opt, cwd}

fn main() -> i64:
    val args = sosix_get_cli_args()
    if args.len() != 7: return 21
    if args[0] != cwd(): return 22
    if args[1] != "" or args[2] != "two words" or args[3] != "quote\"inside": return 23
    if args[4] != "trail\\" or args[5] != "한글😀" or args[6] != "&echo NOT_SHELL": return 24
    if env_get("SMUX_CONFIGURED_SET") != "value 한글😀": return 25
    if env_get_opt("SMUX_CONFIGURED_REMOVE") != nil: return 26
    if env_get("SMUX_CONFIGURED_KEEP") != "parent-kept": return 27
    # This literal is absent from the launch command and all argv/env values.
    sosix_println("CONFIGURED_CHILD_OBSERVED_ALL_FIELDS")
    # Bounded lifetime even if the parent's assertion/cleanup path fails.
    for attempt in 0..200: sosix_sleep_ms(100)
    0
