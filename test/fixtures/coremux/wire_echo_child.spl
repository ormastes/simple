# Real bounded-protocol child for the CoreMux endpoint fixture. No fake backend.
# Compile with the same admitted Phase3/runtime/configured library mode as server.
use std.sosix.stdio.{sosix_read_stdin_line, sosix_println}

fn main() -> i64:
    sosix_println("COREMUX_CHILD_READY")
    while true:
        val line = sosix_read_stdin_line()
        if line == "" or line == "COREMUX_EXIT": return 0
        sosix_println("COREMUX_ECHO:" + line)
    0
