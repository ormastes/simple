describe "expansion through a fixture":
    it "provides a golden":
        val golden = r"""fn main():
    print(1)
"""
        expect(render(golden)).to_equal(expected_one())

    it "reuses the golden scenario":
        # @prev "provides a golden"
        expect(after_prev_marker()).to_equal(true)

    it "includes the golden scenario":
        # @include "provides a golden"
        expect(after_include_marker()).to_equal(true)
