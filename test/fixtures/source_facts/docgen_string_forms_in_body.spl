describe "every multi-line string form keeps the body whole":
    it "raw triple":
        val a = r"""fn main():
    print(1)
"""
        expect(after_raw_marker()).to_equal(true)

    it "single-quoted triple":
        val b = '''fn main():
    print(2)
'''
        expect(after_single_marker()).to_equal(true)

    it "escaped quotes inside":
        val c = """say \"hi\" to
fn main():
"""
        expect(after_escaped_marker()).to_equal(true)
