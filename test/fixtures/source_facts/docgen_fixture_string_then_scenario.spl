describe "before":
    it "holds a fixture that looks like a spec":
        val src = """
describe "NOT A SCENARIO"
    it "NOT AN IT"
"""
        expect(parse(src)).to_equal(expected())

"""
# Real Title
This standalone block is real documentation and follows the fixture.
"""
describe "after":
    """A one-line docstring on the describe."""
    it "is still found":
        expect(compute()).to_equal(other())
