use compiler.tools.lint.main.{Linter}

fn main():
    val source = "features | id, status, valid, requirement\n" +
        "  FEAT-TEST, done, true, \n"
    val linter = Linter.new()
    val results = linter.lint_source(
        "doc/08_tracking/feature/feature_db.sdn",
        source
    )

    var found = false
    for result in results:
        if result.lint.code == "TRK001":
            found = true
    print("lint traceability resolved: {found}")
