# Probe program for the JIT container-boxing truncation defect.
#
# Run by test/01_unit/bugs/jit_container_i64_boxing_*_spec.spl under BOTH
# SIMPLE_EXECUTION_MODE=interpret and =jit; the two transcripts must be
# byte-identical. Each line prints the SAME value twice: once as a scalar
# through an identity fn (`s<n>=`) and once read back out of a `[i64]`
# (`b<n>=`). Round-trip is the oracle, so no expected values are baked in.
#
# The low exponents are the POSITIVE CONTROL: they must round-trip on every
# engine, so a run where every line disagrees indicates a broken harness
# rather than the defect, and a run where the low lines agree proves the
# comparison is actually observing real output.

fn identity(v: i64) -> i64:
    v

fn emit(label: text, v: i64):
    val xs = [v]
    print("s{label}={identity(v)} b{label}={xs[0]}")

fn main() -> i64:
    emit("00", 0)
    emit("01", 1)
    emit("32", 4294967296)               # 2^32
    emit("40", 1099511627776)            # 2^40
    emit("58", 288230376151711744)       # 2^58
    emit("59", 576460752303423488)       # 2^59
    emit("60", 1152921504606846976)      # 2^60
    emit("61", 2305843009213693952)      # 2^61
    emit("62", 4611686018427387904)      # 2^62
    emit("max", 9223372036854775807)     # i64::MAX
    emit("neg60", -1152921504606846976)  # -2^60
    0
