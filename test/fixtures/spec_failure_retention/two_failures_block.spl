"""Intentional RED child (block form); two failing expects in one example.
Not an auto-discovered *_spec.spl. Expected exit: 1, one failed example, both messages printed.
"""
use std.spec.{describe, it, expect, print_summary, get_exit_code}

fn main() -> i64:
    describe "failure retention":
        it "retains both independent failures":
            expect(11).to_equal(22)
            expect(1).to_equal(1)
            expect(33).to_equal(44)
        it "runs the following passing example":
            expect(55).to_equal(55)
    print_summary()
    get_exit_code()
