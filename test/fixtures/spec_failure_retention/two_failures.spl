"""Intentional RED child; two assertion failures must remain one failed example.

Run only through scripts/check/check-spec-failure-retention.shs with an admitted
self-hosted runtime. Not an auto-discovered *_spec.spl. Expected exit: 1.
"""
use std.spec.{it, expect, print_summary, get_exit_code}

fn two_independent_failures():
    expect(11).to_equal(22)
    expect(1).to_equal(1)
    expect(33).to_equal(44)
    print "FAILURE_RETENTION_BODY_COMPLETED"

fn following_example():
    expect(55).to_equal(55)
    print "FAILURE_RETENTION_NEXT_EXAMPLE_COMPLETED"

fn main() -> i64:
    it("retains both independent failures", two_independent_failures)
    it("runs the following passing example", following_example)
    print_summary()
    get_exit_code()
