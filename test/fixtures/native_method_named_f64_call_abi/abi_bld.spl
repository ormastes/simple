use abi_kinds.{Prim}

var bump_total: f64 = 0.0

class Bld:
    lines: [text]
    total: f64

    static fn create() -> Bld:
        Bld(lines: [], total: 0.0)

    # No `->`: importers see no callable type for these three.
    me emit_cf(dest: text, ty: Prim, value: f64):
        match ty:
            case F32:
                self.lines.push("f32 {dest}")
            case _:
                self.lines.push("f64 {dest}")
        self.total = self.total + value

    me emit_plain(dest: text, value: f64):
        self.lines.push("plain {dest}")
        self.total = self.total + value

    me emit_all(tys: [Prim], value: f64):
        for ty in tys:
            self.emit_cf("all", ty, value)

    static fn bump(ty: Prim, value: f64):
        match ty:
            case F32:
                bump_total = bump_total + value
            case _:
                bump_total = bump_total + value + value

fn bump_total_get() -> f64:
    bump_total
