# Native fixture: cross-module calls to callables WITHOUT `->` whose params
# name a provider enum before an f64 (instance method, static method, free
# function, array-of-enum tail), plus a same-named method on a second class.
#
# Stage 3 run 32 (2026-11-14) aborted on this shape:
#   E-BACKEND-CRANELIFT-CALL-ABI: ...Bld.emit_cf: call in ...Drv.run_const:
#   callee signature unknown; arg 3 is f64 and cannot be passed through the
#   all-i64 import
#
# Build with a Stage 2 `native-build <main.spl> --backend=cranelift
# --entry-closure`. Closure builds exclude test/ and fixture trees, so copy
# this directory outside test/ first. Expected stdout:
#   total=4.75 lines=4 id=8 acc=0.5 count=2 bump=3.0 free=3.0
use abi_bld.{Bld, bump_total_get}
use abi_other.{Sp}
use abi_free.{free_emit, free_total_get}
use abi_kinds.{Prim}

class Drv:
    count: i64

    me run_const(b: Bld, v: f64):
        val ty = Prim.F64
        b.emit_cf("%r1", ty, v)
        self.count = self.count + 1

fn main():
    var b = Bld.create()
    var s = Sp.create()
    var d = Drv(count: 0)
    d.run_const(b, 2.5)
    d.run_const(b, 1.25)
    val id = s.emit_cf(7, 0.5)
    b.emit_all([Prim.F32, Prim.F64], 0.5)
    val ty = Prim.F64
    val v = 1.5
    Bld.bump(ty, v)
    free_emit("%r2", ty, v)
    print "total={b.total} lines={b.lines.len()} id={id} acc={s.acc} count={d.count} bump={bump_total_get()} free={free_total_get()}"
