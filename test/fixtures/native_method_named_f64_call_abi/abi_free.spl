use abi_kinds.{Prim}

var free_total: f64 = 0.0

# No `->`, a provider enum param, then an f64.
fn free_emit(dest: text, ty: Prim, value: f64):
    match ty:
        case F32:
            free_total = free_total + value
        case _:
            free_total = free_total + value + value

fn free_total_get() -> f64:
    free_total
