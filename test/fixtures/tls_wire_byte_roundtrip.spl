extern fn rt_bytes_to_text(bytes: [u8]) -> text

fn bytes_to_wire(bytes: [i64]) -> text:
    var raw: [u8] = []
    var i = 0
    while i < bytes.len():
        val byte = bytes[i]
        if byte < 0 or byte > 255:
            return ""
        raw.push(byte.to_u8())
        i = i + 1
    rt_bytes_to_text(raw)

fn main() -> i64:
    var original: [i64] = []
    var i = 0
    while i < 256:
        original.push(i)
        i = i + 1
    val decoded = bytes_to_wire(original).to_bytes()
    if decoded.len() != 256:
        return 1
    i = 0
    while i < 256:
        if decoded[i] != i:
            return 2
        i = i + 1
    val mixed = bytes_to_wire([194, 128, 0, 226, 130, 172]).to_bytes()
    if mixed.len() != 6:
        return 3
    if mixed[0] != 194 or mixed[1] != 128 or mixed[2] != 0:
        return 4
    if mixed[3] != 226 or mixed[4] != 130 or mixed[5] != 172:
        return 5
    0
