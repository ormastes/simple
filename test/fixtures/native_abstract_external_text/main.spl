use std.common.encoding.external_text.*
use std.common.text_bytes.{bytes_to_text, text_to_utf8_bytes, text_byte_buffer}

extern fn rt_array_bytes_basis_len(bytes: [u8]) -> i64

fn through_text_contract<T>(value: T) -> Result<Text, CodecError> where T: AbstractText:
    value.to_internal_text()

fn through_char_contract<T>(value: T) -> Result<Char, CodecError> where T: AbstractChar:
    value.to_internal_char()

fn main() -> i64:
    var packed = text_byte_buffer(3).unwrap()
    packed.push(65)
    packed.push(0)
    packed.push(255)
    assert(rt_array_bytes_basis_len(packed) == 3)
    assert(packed[2] == 255)
    val format = ExternalFormat(encoding: Encoding.Utf16, byte_order: TextByteOrder.LittleEndian, bom: BomPolicy.Require)
    val encoded = external_text([0xFF, 0xFE, 65, 0, 0, 0, 0x3D, 0xD8, 0x42, 0xDE], format).unwrap()
    val decoded = through_text_contract(encoded).unwrap()
    assert(text_to_utf8_bytes(decoded) == [65, 0, 0xF0, 0x9F, 0x99, 0x82])
    assert(through_text_contract(decoded).unwrap() == decoded)
    val output = external_text_from_internal(decoded, format).unwrap()
    assert(output.encoded_bytes().unwrap() == encoded.encoded_bytes().unwrap())
    val stored = encoded.encoded_bytes().unwrap()
    assert(rt_array_bytes_basis_len(stored) == encoded.encoded_byte_length())
    val character = external_char([0xF0, 0x9F, 0x99, 0x82], utf8_format()).unwrap()
    val internal_char = through_char_contract(character).unwrap()
    assert((internal_char as i64) == 0x1F642)
    assert((through_char_contract(internal_char).unwrap() as i64) == 0x1F642)
    var decoder = external_text_decoder(utf8_format()).unwrap()
    assert(decoder.push([65, 0xF0]).unwrap() == "A")
    assert(decoder.pending_byte_count() == 1)
    assert(decoder.push([0x9F, 0x99, 0x82]).unwrap() == bytes_to_text([0xF0, 0x9F, 0x99, 0x82]))
    assert(decoder.finish().unwrap() == "")
    var truncated = external_text_decoder(utf8_format()).unwrap()
    assert(truncated.push([65, 0xF0, 0x9F]).unwrap() == "A")
    match truncated.finish():
        case Err(error):
            assert(error.kind == CodecErrorKind.TruncatedInput)
            assert(error.byte_offset == 3)
        case Ok(value): assert(false)
    0
