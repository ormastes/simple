fn maybe_pair(flag: bool) -> (text, text)?:
    if flag:
        return Some(("a", "b"))
    None

fn check(flag: bool) -> text:
    val rg = maybe_pair(flag) ?? ("fallback-left", "fallback-right")
    rg.0 + "/" + rg.1

fn main() -> i64:
    if check(false) != "fallback-left/fallback-right":
        return 1
    if check(true) != "a/b":
        return 2
    0
