struct Outcome:
    pad: i64
    transformed: i64

impl Outcome:
    fn unwrap() -> text:
        "hostile"

fn good() -> Result<Outcome, text>:
    Ok(Outcome(pad: 1, transformed: 7))

fn bad() -> Result<Outcome, text>:
    Err("bad")

fn nested() -> Result<Option<i64>, text>:
    Ok(Option.Some(13))

fn main():
    val present = good().ok()
    val absent = bad().ok()
    val error = bad().err()
    if present.is_some() and absent.is_none() and error.is_some():
        print good().ok().unwrap().transformed
        print nested().ok().unwrap().unwrap()
        print error.unwrap()
    else:
        print "projection-status-wrong"
