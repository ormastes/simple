# Prints the Simple twin's trampoline words for scripts/check/check-xray-native-inprocess-e2e.shs.
# XRAY_TWIN_BL = signed BL displacement (instructions) to the handler, read
# by the check from the built runtime object. One lowercase 8-digit hex word
# per line, then `TWIN-OK <count>`.
use std.common.trace.xray_native_trampoline_aarch64_v1.{xray_native_trampoline_words_aarch64_v1}

extern fn rt_env_get(key: text) -> text?

fn hex8(word: i64) -> text:
    val digits = "0123456789abcdef"
    var out = ""
    var shift = 28
    while shift >= 0:
        out = out + digits[(word >> shift) & 15]
        shift = shift - 4
    out

fn main():
    val raw = rt_env_get("XRAY_TWIN_BL") ?? ""
    val displacement = raw.to_i64() ?? 0
    val words = xray_native_trampoline_words_aarch64_v1(displacement)
    for word in words:
        print hex8(word)
    print "TWIN-OK {words.len()}"

main()
