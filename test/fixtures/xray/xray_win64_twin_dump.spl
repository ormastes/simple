# Prints the Simple twin of the Windows x64 XRay trampoline and its
# UNWIND_INFO as hex, for scripts/check/check-xray-native-win64-objects.shs.
# XRAY_WIN64_REL32 = the handler CALL displacement in the clang-built object.
use std.common.trace.xray_native_trampoline_win64_v1.{xray_native_trampoline_bytes_win64_v1, xray_native_trampoline_win64_unwind_v1}

extern fn rt_env_get(key: text) -> text?

fn hex_of(bytes: [i64]) -> text:
    val digits = "0123456789abcdef"
    var out = ""
    for byte in bytes:
        out = out + digits[(byte >> 4) & 15] + digits[byte & 15]
    out

fn main():
    val rel = (rt_env_get("XRAY_WIN64_REL32") ?? "0").to_int()
    print "TWIN-TEXT {hex_of(xray_native_trampoline_bytes_win64_v1(rel))}"
    print "TWIN-XDATA {hex_of(xray_native_trampoline_win64_unwind_v1())}"

main()
