# Runs the pure-Simple `simple compile` CLI entry (cli_compile) under the given
# Simple binary, exactly as `simple compile --native --backend=native
# [--xray] -o <out> <src>` would. Used by
# scripts/check/check-xray-native-inprocess-e2e.shs while no full-CLI
# pure-Simple binary is deployed. Env: XR_SRC, XR_OUT, XR_XRAY=1 for --xray;
# SIMPLE_NATIVE_BUILD_EMIT_OBJECT=shared selects a shared library.
use app.io._CliCompile.compile_opt_and_driver.{cli_compile}

extern fn rt_env_get(key: text) -> text?

fn main():
    val src = rt_env_get("XR_SRC") ?? ""
    val out = rt_env_get("XR_OUT") ?? ""
    var args: [text] = ["compile", "--native", "--backend=native"]
    if (rt_env_get("XR_XRAY") ?? "") == "1":
        args.push("--xray")
    args.push("-o")
    args.push(out)
    args.push(src)
    print "CLI-COMPILE rc={cli_compile(args)}"

main()
