# Program traced in-process by scripts/check/check-xray-native-inprocess-e2e.shs.
# Built with `simple compile --native --backend=native --xray` (shared output);
# the host calls `traced` and `scaled` and selects them by aspect pointcuts.
# `scaled` has two returns (two exit sleds). It branches on == only: ordered
# compares hit doc/08_tracking/bug/native_aarch64_cset_condition_table_mismatch_2026-11-06.md.
fn add1(x: i64) -> i64:
    x + 1

fn traced(x: i64) -> i64:
    add1(x) * 2 + 40

fn scaled(x: i64) -> i64:
    if x == 0:
        return 7
    x * 3
