# Native regression for returned array element provenance. Exit codes and
# exact output are both checked externally: a miscompiled comparison cannot
# turn a pointer-valued field into a false pass.
use native_returned_struct_array_sort.model.{InventoryRow, make_rows}

fn inventory_order(values: [InventoryRow]) -> [InventoryRow]:
    var sorted = values
    var index = 1
    while index < sorted.len():
        val item = sorted[index]
        var cursor = index
        while cursor > 0 and item.source_identity < sorted[cursor - 1].source_identity:
            sorted[cursor] = sorted[cursor - 1]
            cursor = cursor - 1
        sorted[cursor] = item
        index = index + 1
    sorted

fn main() -> i64:
    val rows = inventory_order(make_rows())
    print("count={rows.len()}")
    # Fixed indices intentionally do not depend on the returned length.
    print("first={rows[0].source_identity}:{rows[0].byte_count}")
    print("second={rows[1].source_identity}:{rows[1].byte_count}")
    print("third={rows[2].source_identity}:{rows[2].byte_count}")
    if rows.len() != 3:
        return 91
    if rows[0].source_identity != "src/app/B.spl":
        return 92
    if rows[1].source_identity != "src/app/__init__.spl":
        return 93
    if rows[2].byte_count != 30:
        return 94
    0
