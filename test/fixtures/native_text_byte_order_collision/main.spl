# io_runtime first, then binary_io's ByteOrder: the load order that used to
# leave the codec's byte-order variant lookup pointing at binary_io's enum.
use std.io_runtime.{dir_create_all, file_write, file_read}
use std.common.binary_io.{ByteOrder}

fn main():
    val little = ByteOrder.LittleEndian
    val dir = "build/text_byte_order_enum_collision"
    val path = dir + "/roundtrip.txt"
    val content = "café ok\n"
    if dir_create_all(dir) and file_write(path, content) and file_read(path) == content and little == ByteOrder.LittleEndian:
        print 42
    else:
        print 1
