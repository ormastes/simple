# Focused HIR/import-resolution fixture for the interpreter entry I/O owners.

use app.io.mod.{file_exists, file_read_text}
use std.nogc_sync_mut.sffi.diag.{eprintln, print_raw, stdin_read_line, stdout_flush}

fn main() -> i64:
    val missing = not file_exists("/definitely/not/a/simple/source")
    val empty = file_read_text("/definitely/not/a/simple/source") == ""
    if missing and empty:
        print_raw("")
        stdout_flush()
        eprintln("")
        if not missing:
            val _line = stdin_read_line()
        return 0
    1
