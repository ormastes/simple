# Focused HIR/import-resolution fixture for the interpreter entry I/O owners.

use app.io.mod.{file_exists, file_read_text}
use std.nogc_sync_mut.sffi.diag.{eprintln, print_raw, println, stdin_read_line, stdout_flush}

fn main() -> i64:
    val fixture_path = "test/fixtures/interpreter_io_owner_resolution/main.spl"
    if not file_exists(fixture_path):
        return 1

    val source = file_read_text(fixture_path)
    print_raw("")
    stdout_flush()
    println("interpreter-io-owner-resolution")
    eprintln("interpreter-io-owner-resolution-debug")

    # The retained runtime command supplies one line, so this exercises stdin
    # without relying on an interactive terminal or risking a blocked run.
    val line = stdin_read_line()
    if line is nil:
        return 2
    if source.is_empty():
        return 3
    0
