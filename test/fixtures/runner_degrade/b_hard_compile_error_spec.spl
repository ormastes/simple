# =====================================================================
# DELIBERATE FIXTURE — NOT A PRODUCT DEFECT.
# Lane: smf-compile degrade (test/fixtures/runner_degrade/**).
# This spec calls `print_raw`, a builtin the interpreter provides and the
# self-hosted HIR lowering does NOT
# (doc/08_tracking/bug/print_raw_builtin_unknown_to_selfhosted_hir_2026-09-03.md).
# Compiling it to standalone SMF therefore fails HARD with
#   semantic: Undefined("undefined identifier: print_raw")
# — not the SOFT "cannot compile to standalone SMF: N function(s) contain
# constructs that require the interpreter" the runner already degraded on.
# Under the interpreter every example here passes. Do not "fix" the
# print_raw call: it is the whole point of the fixture.
# =====================================================================
"""
## Purpose and audience
Reproducer fixture: a spec whose SMF compile fails HARD but whose examples
all pass under the interpreter. Before the degrade fix, a directory run of
this file reported executed=1 passed=0 failed=1 and lost every example.
Audience: test-runner owners.
"""
use std.spec.step

use std.spec.*

fn degrade_probe_value() -> i64:
    # `print_raw` resolves in the interpreter and is undefined to the SMF
    # lowering path — this single call is what makes the compile fail hard.
    print_raw("")
    7

describe "runner degrade hard-compile-error fixture":
    # @manual scenario evidence
    it "runs an example that the SMF lowering cannot compile":
        # @req REQ-TESTRUNNER-SMF-COMPILE-DEGRADE
        step("call the interpreter-only builtin and assert its companion value")
        expect(degrade_probe_value()).to_equal(7)  # oracle: executed only if the file degraded

    it "runs a second example in the same lost file":
        # @req REQ-TESTRUNNER-SMF-COMPILE-DEGRADE
        step("assert a second executed value from the same degraded file")
        expect(degrade_probe_value() * 2).to_equal(14)  # oracle: second example of the lost file

    it "runs a third example in the same lost file":
        # @req REQ-TESTRUNNER-SMF-COMPILE-DEGRADE
        step("assert a third executed value from the same degraded file")
        expect(degrade_probe_value() - 7).to_equal(0)  # oracle: third example of the lost file
