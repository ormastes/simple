# =====================================================================
# DELIBERATE FIXTURE — NOT A PRODUCT DEFECT.
# Lane: smf-compile degrade (test/fixtures/runner_degrade/**).
# This spec FAILS AN ASSERTION ON PURPOSE *and* cannot compile to SMF
# (same `print_raw` hard error as b_hard_compile_error_spec.spl). It is the
# fail-closed control: degrading a hard compile error to the interpreter
# must NOT convert a genuine failure into a pass. Do not "fix" it.
# =====================================================================
"""
## Purpose and audience
Fail-closed control for the runner's SMF-compile degrade lane: a spec that
fails under the compiled lane AND under the interpreter must stay failed
after the degrade. Audience: test-runner owners.
"""
use std.spec.step

use std.spec.*

extern fn rt_file_exists(path: text) -> bool

fn failure_probe_value() -> i64:
    # Same interpreter-only builtin as the b fixture: the file degrades.
    print_raw("")
    3

describe "runner degrade fail-closed fixture":
    # @manual scenario evidence
    it "fails a genuine assertion on purpose after degrading":
        # @req REQ-TESTRUNNER-SMF-COMPILE-DEGRADE
        step("probe a reserved path that can never exist, then assert it does")
        # Real executed oracle (filesystem probe, deterministic), NOT a literal
        # mismatch: the reserved fixture-miss path can never exist, so this
        # expect is a genuine executed assertion that deterministically fails.
        expect(rt_file_exists("/.simple_fixtures/runner_degrade/reserved_miss_path_{failure_probe_value()}")).to_equal(true)  # oracle: reserved miss path must not exist — inverted on purpose, see header
