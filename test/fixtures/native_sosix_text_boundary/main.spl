"""Native fixture for actual SOSIX console/legacy failure and bounded work.

Built only by the admitted compiler campaign. UNRUN. The repeated workload is
an input for existing runner RSS/latency measurement, not a performance pass.
"""
use std.common.encoding.external_text.{external_text, external_text_from_internal,
    ExternalFormat, Encoding, TextByteOrder, BomPolicy, CodecErrorKind, utf8_format}
use std.common.text_bytes.{text_byte_buffer, bytes_to_text, boxed_text_bytes_checked}
use std.nogc_sync_mut.sffi.cli_args.{cli_get_args}
use std.nogc_sync_mut.io_runtime.{env_set_process}
use std.nogc_sync_mut.io_runtime.{getpid, file_write_bytes, file_delete}
use std.nogc_sync_mut.io.dir_ops.{dir_create, dir_remove}
use std.nogc_sync_mut.package_sffi.{set_permissions}
use std.nogc_async_mut.sosix.environment.{sosix_env_get_nullable, sosix_env_get_checked}
use std.nogc_sync_mut.io.external_text_io.{TextIoError}
use std.nogc_async_mut.sosix.stdio.{sosix_print_raw, sosix_eprint, sosix_print_raw_checked}
use std.nogc_async_mut.sosix.host_facade.{sosix_dir_list_checked, sosix_which_checked}
use std.nogc_async_mut.sosix.text_boundary.{SOSIX_TEXT_BYTE_LIMIT, sosix_admit_utf8,
    sosix_admit_c_string, sosix_encode_utf8, sosix_decode_text, sosix_decode_char}

fn main() -> i64:
    val argv = cli_get_args()
    assert(argv.len() == 2)
    val mode = sosix_admit_c_string(argv[1], false).unwrap()
    if mode == "emit":
        assert(sosix_print_raw_checked(bytes_to_text([255u8])).is_err())
        sosix_print_raw("A\0🙂")
        sosix_eprint("é\0B")
        return 0
    if mode == "legacy-invalid-env":
        val key = "SIMPLE_SOSIX_INVALID_NATIVE"
        assert(env_set_process(key, "valid-control"))
        assert(sosix_env_get_checked("SIMPLE_SOSIX_INVALID_NATIVE").unwrap().unwrap() == "valid-control")
        assert(env_set_process(key, bytes_to_text([255u8])))
        match sosix_env_get_checked("SIMPLE_SOSIX_INVALID_NATIVE"):
            case Err(TextIoError.Codec(error)):
                assert(error.kind == CodecErrorKind.InvalidUtf8)
                assert(error.byte_offset == 0)
            case _: assert(false)
        sosix_print_raw("legacy-invalid-env-ready")
        # This must fail explicitly. Reaching the following return means the
        # legacy adapter silently converted failure to missing/empty/success.
        val impossible = sosix_env_get_nullable("SIMPLE_SOSIX_INVALID_NATIVE")
        return 0
    if mode == "invalid-directory":
        val directory = "/tmp/sosix-native-dir-{getpid()}"
        assert(dir_create(directory, false))
        assert(file_write_bytes(directory + "/valid-control", [1u8]))
        assert(sosix_dir_list_checked(directory).unwrap().contains("valid-control"))
        var name = sosix_encode_utf8(directory + "/").unwrap().encoded_bytes().unwrap()
        name.push(255u8)
        val raw_path = bytes_to_text(name)
        assert(file_write_bytes(raw_path, [1u8]))
        val rejected = match sosix_dir_list_checked(directory):
            case Err(TextIoError.Codec(error)): error.kind == CodecErrorKind.InvalidUtf8 and error.byte_offset == 0
            case _: false
        assert(file_delete(raw_path))
        assert(file_delete(directory + "/valid-control"))
        assert(dir_remove(directory, false))
        assert(rejected)
        return 0
    if mode == "invalid-resolver":
        assert(sosix_which_checked("sh").unwrap().unwrap().contains("/"))
        var directory_bytes = sosix_encode_utf8("/tmp/sosix-resolver-{getpid()}-").unwrap().encoded_bytes().unwrap()
        directory_bytes.push(255u8)
        val directory = bytes_to_text(directory_bytes)
        assert(dir_create(directory, false))
        var file_bytes = boxed_text_bytes_checked(directory).unwrap()
        for byte in [47u8, 112u8, 114u8, 111u8, 98u8, 101u8]: file_bytes.push(byte)
        val path = bytes_to_text(file_bytes)
        assert(file_write_bytes(path, sosix_encode_utf8("#!/bin/sh\nexit 0\n").unwrap().encoded_bytes().unwrap()))
        assert(set_permissions(path, 0o755))
        assert(env_set_process("PATH", bytes_to_text(directory_bytes)))
        val rejected = match sosix_which_checked("probe"):
            case Err(TextIoError.Codec(error)): error.kind == CodecErrorKind.InvalidUtf8
            case _: false
        assert(file_delete(path))
        assert(dir_remove(directory, false))
        assert(rejected)
        return 0
    if mode == "bounded-repeat":
        val format = ExternalFormat(encoding: Encoding.Utf16, byte_order: TextByteOrder.LittleEndian, bom: BomPolicy.Preserve)
        val external = external_text([65u8, 0u8, 61u8, 216u8, 66u8, 222u8], format).unwrap()
        for index in 0..256:
            assert(sosix_admit_utf8("ASCII").unwrap() == "ASCII")
            assert(sosix_admit_utf8("한é🙂").unwrap() == "한é🙂")
            assert(sosix_decode_text(external).unwrap() == "A🙂")
            assert(sosix_encode_utf8("A\0🙂").unwrap().encoded_byte_length() == 6)
        var bytes = text_byte_buffer(SOSIX_TEXT_BYTE_LIMIT + 1).unwrap()
        for index in 0..(SOSIX_TEXT_BYTE_LIMIT + 1): bytes.push(65u8)
        assert(sosix_admit_utf8(bytes_to_text(bytes)).is_err())
        sosix_print_raw("bounded-repeat-ok")
        return 0
    return 2
