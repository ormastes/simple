# Top-level conditional-compilation fixture (seed parser integration test).
# Every branch defines the same names; exactly one branch must survive.

@when(os="windows"):
    fn platform_name() -> text:
        "windows"
@elif(os == "linux" and arch="aarch64"):
    fn platform_name() -> text:
        "linux-aarch64"
@elif(unix):
    fn platform_name() -> text:
        "unix"
@else:
    fn platform_name() -> text:
        "other"
@end

@when(os="windows"):
    extern fn rt_win_only() -> i64
    @when(arch="aarch64"):
        fn arch_name() -> text:
            "windows-arm64"
    @else:
        fn arch_name() -> text:
            "windows-other"
    @end
@else:
    @when(riscv64 || arm64):
        fn arch_name() -> text:
            "risc-or-arm"
    @else:
        fn arch_name() -> text:
            "other"
    @end
@end

fn main() -> i64:
    0
