# Conformance: nesting, family=, not, parentheses, bare arch atoms, `||`.
@when(family="unix"):
@when(not os="linux" and (arch="aarch64" or arch="riscv64")):
val tag = "TAG_UNIX_NONLINUX_NONX86"
@elif(os="linux"):
val tag = "TAG_LINUX"
@when(riscv64 || arm64):
val sub = "TAG_LINUX_RISC_OR_ARM"
@else:
val sub = "TAG_LINUX_X86"
@end
@else:
val tag = "TAG_UNIX_OTHER"
@end
@else:
val tag = "TAG_NOT_UNIX"
@end
