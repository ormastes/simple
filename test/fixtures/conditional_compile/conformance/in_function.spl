# Conformance: directives inside a function body (the shape used by
# src/lib/nogc_sync_mut/io/retained_file.spl). Bodies are flat: they sit at
# the directive's own indentation and must survive untouched.
fn supported() -> text:
    @when(os="windows"):
    val supported = "TAG_FN_WINDOWS"
    @else:
    @when(os="linux"):
    val supported = "TAG_FN_LINUX"
    @else:
    val supported = "TAG_FN_OTHER"
    @end
    @end
    supported

fn main() -> i64:
    0
