# Conformance: `=` / `==` are tokens of their own, so any spacing around them
# forms one key/value atom.
@when(os ="linux"):
val a = "TAG_SP_LEFT"
@end
@when(os= "linux"):
val b = "TAG_SP_RIGHT"
@end
@when(arch  ==  "x86_64"):
val c = "TAG_SP_DOUBLE"
@end
@when(target_os=="windows" or cpu =='riscv64'):
val d = "TAG_SP_MIXED"
@end
