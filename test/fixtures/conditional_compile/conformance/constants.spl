# Conformance: constant atoms and the always-false feature= key.
@when(true):
val a = "TAG_TRUE"
@end
@when(compiled and debug):
val b = "TAG_COMPILED_DEBUG"
@end
@when(false or interpreter or release):
val c = "TAG_NEVER"
@end
@when(feature="gpu"):
val d = "TAG_FEATURE_GPU"
@else:
val d = "TAG_NO_FEATURE"
@end
