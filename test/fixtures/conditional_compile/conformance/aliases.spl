# Conformance: every accepted key and value alias; values are case-insensitive,
# quotes optional, `=`/`==` with or without spaces.
@when(win):
val a = "TAG_BARE_WIN"
@end
@when(Darwin):
val b = "TAG_BARE_DARWIN"
@end
@when(x64 || ARM64):
val c = "TAG_X64_OR_ARM64"
@end
@when(target_os = 'Linux'):
val d = "TAG_TARGET_OS_LINUX"
@end
@when(platform == "FreeBSD"):
val e = "TAG_PLATFORM_FREEBSD"
@end
@when(target_arch == amd64):
val f = "TAG_TARGET_ARCH_AMD64"
@end
@when(cpu = "riscv64"):
val g = "TAG_CPU_RISCV64"
@end
@when(family="windows"):
val h = "TAG_FAMILY_WINDOWS"
@end
@when(!(unix) && !windows):
val i = "TAG_NEITHER_UNIX_NOR_WINDOWS"
@end
@when(baremetal):
val j = "TAG_BAREMETAL"
@end
@when(arch = "x86_64"):
val k = "TAG_SPACED_ARCH"
@end
