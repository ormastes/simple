# Conformance: first matching branch of an @elif chain wins; `and`, `==`.
@when(os="windows"):
val tag = "TAG_WIN"
@elif(os == "linux" and arch="aarch64"):
val tag = "TAG_LINUX_A64"
@elif(os="macos"):
val tag = "TAG_MAC"
@elif(os="freebsd"):
val tag = "TAG_BSD"
@elif(os="simpleos"):
val tag = "TAG_SOS"
@elif(os="none"):
val tag = "TAG_BARE"
@else:
val tag = "TAG_REST"
@end
