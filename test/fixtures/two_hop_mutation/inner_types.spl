# Fixture for two_hop_field_method_mutation_spec.spl.
#
# Cross-module struct types with a MUTATING method, used as the intermediate
# hop of a `root.mid.inner.<mutating>()` chain. Kept in a separate module so
# the spec exercises the real import path the bug was reported against
# (bug doc: doc/08_tracking/bug/selfhost_two_hop_field_method_mutation_lost_2026-07-27.md).
#
# NOTE the receiver form: `me bump()`, NOT `fn bump(self)`. A mutating
# `fn X(self)` is a hard HIR error ("cannot modify self in immutable fn
# method"); it makes JIT lowering bail for the WHOLE program and silently
# degrades execution to the interpreter, whose place model only supports
# 2-level field places. That fallback — not the hop count itself — is what
# produced the originally-reported "cross-module two-hop loss".

struct TwoHopInner:
    n: i64

    static fn new() -> TwoHopInner:
        TwoHopInner(n: 0)

    me bump():
        self.n = self.n + 1

struct TwoHopMid:
    inner: TwoHopInner

    static fn new() -> TwoHopMid:
        TwoHopMid(inner: TwoHopInner.new())
