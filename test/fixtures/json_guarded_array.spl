# Real production flatten and guarded projection; no local predicate mock.
use std.common.json.types.{json_array, json_number, json_null}
use std.common.json.array_ops.json_array_flatten

fn main() -> i64:
    val result = json_array_flatten(json_array([json_array([json_number(1.0)]), json_null()]))
    if result.0 != "array":
        return 1
    if result.1.len() != 2:
        return 2
    if result.1[0].0 != "number" or result.1[0].1 != 1.0:
        return 3
    if result.1[1].0 != "null":
        return 4
    if json_array_flatten(("array", 9)) != nil:
        return 5
    print "GUARDED_JSON_ARRAY_NATIVE_PASS"
    0
