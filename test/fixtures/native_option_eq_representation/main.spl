# Minimal repro for the native inlined `Option<text>` return-representation
# defect: doc/08_tracking/bug/native_inlined_option_return_representation_mismatch_2026-08-02.md
#
# The original repro (SdnRow.get("run_id") == Some(run_id)) disassembled to a
# bare text handle on the inlined-return side vs an rt_enum_new-boxed value
# on the Some(...) construction side, so rt_native_eq compared mismatched
# physical representations and the equality spuriously returned false.
#
# This fixture keeps the same shape (a function returning Option<text>,
# compared for equality against a freshly constructed Some(...)) using a
# free function rather than a struct method, because a struct/impl-method
# variant currently crashes native-build for an unrelated reason (see the
# check script header for details) and could not be used here.
fn lookup(id: text) -> Option<text>:
    if id == "":
        return None
    return Some(id)

fn main():
    val hit = lookup("run_id")
    val miss = lookup("run_id")
    val absent = lookup("")

    val hit_result = if hit == Some("run_id"): "match" else: "no-match"
    val miss_result = if miss == Some("other_id"): "match" else: "no-match"
    val none_result = if absent == None: "match" else: "no-match"

    print("hit={hit_result} miss={miss_result} none={none_result}")
