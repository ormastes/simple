use compiler.core.lexer.{Lexer, lex_next, lex_token_text}

fn main() -> i64:
    val empty_lexer = Lexer.new("")
    val source_lexer = Lexer.new(
        "fn main() -> i64:\n    val xs = [1, 2, 3]\n    xs\n"
    )
    val repeated_lexer = Lexer.new("val ready = true\n")
    val first_kind = lex_next()
    val first_text = lex_token_text()
    val second_kind = lex_next()
    val second_text = lex_token_text()
    val passed = (
        empty_lexer.dummy == 0 and source_lexer.dummy == 0 and repeated_lexer.dummy == 0 and
        first_kind > 0 and first_text == "val" and
        second_kind > 0 and second_text == "ready"
    )
    print("lexer slot init resolved: {passed}")
    if passed: 0 else: 1
