use compiler.tools.lint.main.{Linter}

fn main() -> i64:
    val linter = Linter.new()
    val results = linter.lint_source(
        "/tmp/native_lint_checks_types.spl",
        "fn f():\n    pass_todo\n"
    )
    var found = false
    for result in results:
        if result.lint.code == "REQC001":
            found = true
    print("lint checks resolved: {found}")
    if found: 0 else: 1
