# Frozen corpus entry: string interpolation and placeholder shapes.
fn render(name: text, count: i64) -> text:
    val a = "module {name} has {count} entries"
    val b = "second {name} line {count} here"
    a + b

fn tally(rows: [i64]) -> i64:
    var total = 0
    for r in rows:
        total = total + r
    total
