struct AggregateReceipt:
    a: i64
    b: i64
    c: i64
    d: i64

fn scalar_stamp() -> i64:
    85

fn aggregate_stamp() -> AggregateReceipt:
    AggregateReceipt(a: 101, b: 202, c: 303, d: 68)

fn leaf(mut meta: [i64], mut pixels: [u8]):
    meta[0] = 11
    meta[1] = 12
    pixels[0] = 13u8
    pixels[1] = 14u8

fn after_scalar(mut meta: [i64], mut pixels: [u8]):
    meta[0] = 21
    pixels[0] = 22u8
    val stamp = scalar_stamp()
    if stamp != 85:
        return
    meta[1] = stamp
    pixels[1] = stamp as u8

fn after_aggregate(mut meta: [i64], mut pixels: [u8]) -> i64:
    meta[0] = 31
    pixels[0] = 32u8
    val receipt = aggregate_stamp()
    if (receipt.a != 101 or receipt.b != 202 or
        receipt.c != 303 or receipt.d != 68):
        return 34
    meta[1] = receipt.a + receipt.b + receipt.c
    pixels[1] = receipt.d as u8
    0

export AggregateReceipt, scalar_stamp, aggregate_stamp
export leaf, after_scalar, after_aggregate
