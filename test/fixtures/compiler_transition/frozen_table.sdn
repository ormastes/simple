# FROZEN selftest fixture for scripts/check/check-compiler-transition-coverage.shs.
#
# The selftest MUST NOT read spec/compiler_schema/transitions/. A selftest built
# from the live tables requires them to PASS, so a genuine missing row in a real
# table aborts the guard as `ERROR — nothing was checked (selftest failure)`
# (exit 2) instead of the `FAIL — ... 1 missing: <name>` (exit 1) the verdict
# convention demands. That inverts the two states the caller most needs to tell
# apart: "the guard could not run" and "the guard ran and found a hole".
#
# So this file is frozen: it never changes when a real boundary changes, and the
# guard's ability to detect a hole is proven against it rather than against
# whatever the compiler happens to look like today.
#
# Exercises both accepted dialects: plain tags with sibling fields, and the
# `State(payload)` constructor form from hardening plan section 11.3.

table: frozen_fixture
producer: FrozenKind
consumer: TargetKind
source: test/fixtures/compiler_transition/frozen_table.sdn

universe:
  - Alpha
  - Beta
  - Gamma
  - Delta
  - Tensor

transition:
  from: FrozenKind.Alpha
  to: TargetKind.A
  state: implemented
  reason: "direct arm"
  test: transition_table_validator_spec

transition:
  from: FrozenKind.Beta
  to: TargetKind.A
  state: normalized
  reason: "rewritten by an earlier pass"
  test: transition_table_validator_spec

transition:
  from: FrozenKind.Gamma
  to: ""
  state: Unsupported(no arm, doc/08_tracking/bug/frozen_fixture.md)
  test: transition_table_validator_spec

transition:
  from: FrozenKind.Delta
  to: ""
  state: NotApplicable(produced only downstream of this boundary)
  test: transition_table_validator_spec

transition:
  from: FrozenKind.Tensor
  to: TargetKind.Opaque
  state: normalized
  profile_dependent: true
  reason: "the row the hole fixture deletes; kept last so the awk filter is unambiguous"
  test: transition_table_validator_spec
