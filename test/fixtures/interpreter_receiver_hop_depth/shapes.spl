# Fixture for receiver_hop_depth_linear_spec: a `me`-mutating method on a class
# receiver that reached the mutating frame through N parameter hops — the exact
# shape of every generated `hc_enc_*` HIR encoder calling `w.put_i64(..)`.

class W:
    parts: [text]

    static fn create() -> W:
        W(parts: [])

    me put(v: i64):
        self.parts.push("{v}")

# depth 0: the frame that owns `w` calls the method itself.
fn hop0(w: W, v: i64):
    w.put(v)

fn hop1(w: W, v: i64):
    hop0(w, v)

fn hop2(w: W, v: i64):
    hop1(w, v)

fn fill_direct(n: i64) -> i64:
    val w = W.create()
    var i = 0
    while i < n:
        w.put(i)
        i = i + 1
    w.parts.len()

fn fill_hops(n: i64) -> i64:
    val w = W.create()
    var i = 0
    while i < n:
        hop2(w, i)
        i = i + 1
    w.parts.len()

# An alias taken BEFORE the pushes must keep the old contents: value semantics
# still hold for a genuinely live second binding.
fn alias_keeps_snapshot() -> [i64]:
    val w = W.create()
    hop2(w, 1)
    val snap = w.parts
    hop2(w, 2)
    hop2(w, 3)
    [snap.len(), w.parts.len()]

# Reference-class semantics: the owner sees every push made three hops down,
# in order.
fn order_across_hops() -> [text]:
    val w = W.create()
    w.put(1)
    hop0(w, 2)
    hop1(w, 3)
    hop2(w, 4)
    w.parts
