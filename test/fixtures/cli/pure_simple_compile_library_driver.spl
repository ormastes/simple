# Runs the pure-Simple single-file compile entry (cli_compile_pure_simple)
# under the given Simple binary, for
# test/03_system/native/pure_simple_compile_library_functions_spec.spl.
#   PSC_SRC      source module
#   PSC_OUT      output library
#   PSC_BACKEND  backend name (default llvm)
# SIMPLE_NATIVE_BUILD_EMIT_OBJECT=shared selects a shared library.
# No --xray and no native target: the route that used to lower the positional
# input to an empty stub module.
use app.io._CliCompile.compile_opt_and_driver.{cli_compile_pure_simple, cli_compile_pure_simple_mode_text}
use compositions.kernel_llvm_cranelift.compiler.driver.bootstrap_k1_selected.{
    install_selected_k1_backend_table_v1, selected_k1_backend_policy_v1}
use plugins.backend_registry.full_static_backend_registry.{
    install_full_static_backends_for_k1_policy_v1}

extern fn rt_env_get(key: text) -> text?

fn main():
    print "PSC-MODE default=[{cli_compile_pure_simple_mode_text("")}] native=[{cli_compile_pure_simple_mode_text("native")}] smf=[{cli_compile_pure_simple_mode_text("smf")}] vulkan=[{cli_compile_pure_simple_mode_text("vulkan")}]"
    # Mirror the real CLI startup: install the backend table first.
    if not install_selected_k1_backend_table_v1():
        print "PSC-COMPILE k1 backend table install failed"
        return
    if not install_full_static_backends_for_k1_policy_v1(selected_k1_backend_policy_v1()):
        print "PSC-COMPILE static backend install failed"
        return
    val src = rt_env_get("PSC_SRC") ?? ""
    val out = rt_env_get("PSC_OUT") ?? ""
    val backend = rt_env_get("PSC_BACKEND") ?? "llvm"
    print "PSC-COMPILE rc={cli_compile_pure_simple(src, out, "", backend, false, true, false, 3, "", "", false, "", 0, 0, false)}"

main()
