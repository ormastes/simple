# Two-function library module (no `main`) compiled to a shared library by
# test/03_system/native/pure_simple_compile_library_functions_spec.spl.
# Branches on == only: ordered compares are a separate open native defect.
pub fn twice(x: i64) -> i64:
    x * 2

pub fn twice_plus(x: i64, y: i64) -> i64:
    if y == 0:
        return twice(x)
    twice(x) + y
