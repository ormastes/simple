# Window-manager process for the two-process remote presentation proof.
# Runs the production serve loop of the resident headless WM. The daemon
# directory comes from SIMPLE_WM_DAEMON_DIR.
# Tracks: wm_host_external_content_owner_2026-07-29

use app.play.wm_daemon.{wm_daemon_dispatch}

fn main() -> i64:
    wm_daemon_dispatch(["serve"], false)
