use app.bootstrap_builder.compiler_admission_diagnostic.{builder_compiler_admission_diagnostic_v1}
fn main() -> i64:
    if not builder_compiler_admission_diagnostic_v1("SCV-E-ADMISSION: source-inventory-scope-unsupported\n"): return 1
    if not builder_compiler_admission_diagnostic_v1("error: SCV-E-ADMISSION: stale\r\n"): return 2
    if not builder_compiler_admission_diagnostic_v1("SCV-E-ADMISSION:\n"): return 3
    if builder_compiler_admission_diagnostic_v1("[parser] text=SCV-E-ADMISSION: quoted\n"): return 4
    if builder_compiler_admission_diagnostic_v1("ordinary message mentions SCV-E-ADMISSION: bad\n"): return 5
    if builder_compiler_admission_diagnostic_v1("SCV-E-ADMISSION-extra: bad\n"): return 6
    0
