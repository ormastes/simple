use compiler.driver.cache.binary_object_cas.{binary_object_cas_put, binary_object_cas_read_full}
use compiler.driver.cache.archive_native_object_admission_v1.{
    ArchiveNativeObjectActionV1, archive_native_object_paths_v1}

fn fixture_action(kind: text, digest: text) -> [ArchiveNativeObjectActionV1]:
    [ArchiveNativeObjectActionV1(
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        kind, "fixture.main", digest)]

fn main() -> i64:
    val root = "build/test/archive-native-object-admission-fixture"
    val elf: [u8] = [127u8, 69u8, 76u8, 70u8, 1u8, 2u8, 3u8, 4u8]
    val digest = binary_object_cas_put(root, elf)
    if digest.len() != 64:
        print "FAIL CAS publication"
        return 11
    match archive_native_object_paths_v1(
            fixture_action("compile-native", digest), root,
            "aarch64-unknown-linux-gnu"):
        case Err(reason):
            print "FAIL valid admission: {reason}"
            return 12
        case Ok(paths):
            if paths.len() != 1 or not paths[0].ends_with(
                    digest.substring(2, 64)):
                print "FAIL admitted object path"
                return 13
    match archive_native_object_paths_v1(
            fixture_action("compile-semantic", digest), root,
            "aarch64-unknown-linux-gnu"):
        case Ok(_):
            print "FAIL semantic-only action admitted"
            return 14
        case Err(_): pass
    match archive_native_object_paths_v1(
            fixture_action("compile-native", digest), root,
            "aarch64-apple-darwin"):
        case Ok(_):
            print "FAIL wrong target admitted"
            return 15
        case Err(_): pass
    val duplicate = [
        ArchiveNativeObjectActionV1(
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "compile-native", "fixture.main", digest),
        ArchiveNativeObjectActionV1(
            "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "compile-native", "fixture.main", digest)]
    match archive_native_object_paths_v1(
            duplicate, root, "aarch64-unknown-linux-gnu"):
        case Ok(_):
            print "FAIL duplicate symbol admitted"
            return 16
        case Err(_): pass
    val odd: [u8] = [127u8, 69u8, 76u8, 70u8, 0u8, 255u8, 254u8, 128u8]
    val odd_digest = binary_object_cas_put(root, odd)
    if odd_digest.len() != 64:
        print "FAIL binary CAS publication"
        return 17
    match binary_object_cas_read_full(root, odd_digest):
        case nil:
            print "FAIL binary CAS readback"
            return 18
        case Some(odd_read):
            if odd_read.len() != odd.len() or odd_read[4] != 0u8 or odd_read[5] != 255u8 or odd_read[7] != 128u8:
                print "FAIL binary CAS bytes"
                return 19
    var large: [u8] = [0u8; 1048583]
    large[0] = 127u8
    large[1] = 69u8
    large[2] = 76u8
    large[3] = 70u8
    large[1048576] = 255u8
    large[1048582] = 128u8
    val large_digest = binary_object_cas_put(root, large)
    if large_digest.len() != 64:
        print "FAIL chunked CAS publication"
        return 20
    match binary_object_cas_read_full(root, large_digest):
        case nil:
            print "FAIL chunked CAS readback"
            return 21
        case Some(large_read):
            if large_read.len() != large.len() or large_read[0] != 127u8 or large_read[1048576] != 255u8 or large_read[1048582] != 128u8:
                print "FAIL chunked CAS bytes"
                return 22
    print "PASS archived native object CAS admission"
    0
