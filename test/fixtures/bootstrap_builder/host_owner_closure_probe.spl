# Native bootstrap boundary probe. Supply "owner-probe" plus LF on stdin.
# Link with no stub fallback and inspect closure for absence of sffi.host.
use std.nogc_sync_mut.sffi.cpu.{cpu_is_x86_64, cpuid}
use std.nogc_sync_mut.sffi.host_text.{read_stdin_line, raw_i64_to_string}
use std.nogc_sync_mut.sffi.rc_graph.{rt_rc_share, rt_rc_count, rt_rc_release}

fn main() -> i64:
    if cpu_is_x86_64() != 1: return 1
    val facts = cpuid(0, 0)
    if facts.0 <= 0: return 2
    if raw_i64_to_string(-42) != "-42": return 3
    if read_stdin_line() != "owner-probe": return 4
    val owned = [11, 22]
    val shared = unsafe(capabilities: [ffi]): rt_rc_share(owned)
    if not shared: return 5
    val count = unsafe(capabilities: [ffi]): rt_rc_count(owned)
    if count < 1: return 6
    val released = unsafe(capabilities: [ffi]): rt_rc_release(owned)
    if not released: return 7
    print "narrow host owners: CPU, text, stdin and refcount PASS"
    0
