use app.io.env_ops.{env_vars, env_set}

fn main() -> i64:
    val _set = env_set("SIMPLE_TUPLE_PROBE", "v=é")
    val snapshot = env_vars() ?? []
    for pair in snapshot:
        if pair.0 == "SIMPLE_TUPLE_PROBE":
            if pair.1 != "v=é": return 2
            val assignment = pair.0 + "=" + pair.1
            if assignment != "SIMPLE_TUPLE_PROBE=v=é":
                print "FAIL tuple concat key_length={pair.0.len()} value_length={pair.1.len()} assignment_length={assignment.len()}"
                return 3
            print "PASS tuple snapshot and concat"
            return 0
    print "FAIL tuple snapshot missing probe key"
    4
