# Native Windows fixture; never prints the nonce or claims OS boot continuity.
use std.nogc_sync_mut.io.windows_service_incarnation_v1.{windows_service_incarnation_nonce_v1, WINDOWS_SERVICE_INCARNATION_PREFIX_V1}

fn main() -> i64:
    match windows_service_incarnation_nonce_v1():
        case Err(reason):
            print("WINDOWS_SERVICE_INCARNATION_V1_ERROR: " + reason)
            1
        case Ok(nonce):
            if not nonce.starts_with(WINDOWS_SERVICE_INCARNATION_PREFIX_V1): return 2
            if nonce.len() != WINDOWS_SERVICE_INCARNATION_PREFIX_V1.len() + 64: return 3
            for index in WINDOWS_SERVICE_INCARNATION_PREFIX_V1.len()..nonce.len():
                val scalar = nonce.char_code_at(index)
                if not ((scalar >= 48 and scalar <= 57) or (scalar >= 97 and scalar <= 102)): return 4
            print("WINDOWS_SERVICE_INCARNATION_V1_NATIVE_ENTROPY_OBSERVED")
            0
