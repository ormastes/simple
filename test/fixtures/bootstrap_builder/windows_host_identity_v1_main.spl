# Native Windows AOT observation fixture. Deliberately does not print OS IDs.
use std.nogc_sync_mut.io.windows_host_identity_v1.{windows_host_identity_v1}

fn main() -> i64:
    match windows_host_identity_v1():
        case Err(reason):
            print("WINDOWS_HOST_IDENTITY_V1_ERROR: " + reason)
            1
        case Ok(observed):
            if not observed.native_machine_id.starts_with("windows-machine-guid-v1:"): return 2
            if observed.native_machine_id.len() != 60: return 3
            if observed.boot_counter <= 0 or observed.boot_counter >= 4294967295: return 4
            if observed.boot_assurance != "successful-boot-counter": return 5
            if observed.architecture != "x86_64" and observed.architecture != "aarch64": return 6
            print("WINDOWS_HOST_IDENTITY_V1_OBSERVED_LOWER_ASSURANCE")
            0
