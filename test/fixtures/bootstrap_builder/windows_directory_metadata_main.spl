# Real filesystem fixture; argv supplies directory, file, missing path, junction.
use app.io.args_ops.{get_args}
use app.io.file_ops.{path_absolute}
use std.nogc_sync_mut.io.windows_process_owner.{windows_process_directory_no_follow_v1}

fn main() -> i64:
    val args = get_args()
    if args.len() != 5: return 2
    if not windows_process_directory_no_follow_v1(args[1]): return 3
    if windows_process_directory_no_follow_v1(args[2]): return 4
    if windows_process_directory_no_follow_v1(args[3]): return 5
    if windows_process_directory_no_follow_v1(args[4]): return 6
    val absolute = path_absolute(args[1]).replace("\\", "/")
    if absolute != args[1].replace("\\", "/"): return 7
    print "PASS Windows absolute directory, regular file, missing path and junction checks"
    0
