# Compile through native-build and run with one existing absolute private
# evidence directory. Exercises Simple text lowering into the actual C owner.
use app.io.args_ops.{get_args}
use std.nogc_sync_mut.io.linux_process_owner.{linux_cgroup_parent_acquire_v1,
    linux_available_capacity_v1, linux_cgroup_parent_release_v1}

fn main() -> i64:
    val args = get_args()
    if args.len() != 2: return 2
    val identity = "decafbaddecafbaddecafbaddecafbaddecafbaddecafbaddecafbaddecafbad"
    val parent = match linux_cgroup_parent_acquire_v1(args[1], identity):
        Ok(value): value
        Err(reason):
            print "native Simple parent ABI failed: {reason}"
            return 3
    val measured = linux_available_capacity_v1(args[1])
    match linux_cgroup_parent_release_v1(parent):
        Ok(_): pass
        Err(reason):
            print "native Simple parent release ABI failed: {reason}"
            return 4
    match measured:
        Ok(capacity):
            if capacity.0 <= 0 or capacity.1 <= 0 or parent.inode <= 0: return 5
            print "PASS native Simple Linux owner ABI: token={parent.token} device={parent.device} inode={parent.inode} memory={capacity.0} disk={capacity.1}"
            0
        Err(reason):
            print "native Simple capacity ABI failed: {reason}"
            6
