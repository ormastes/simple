use provider.{CounterAlias, RegistryCounter}

var IMPORTED_REGISTRY: Dict<i64, CounterAlias> = {}

fn read_inferred(key: i64) -> i64:
    val value = IMPORTED_REGISTRY[key]
    value.read()

fn read_declared(key: i64) -> i64:
    val value: CounterAlias = IMPORTED_REGISTRY[key]
    value.read()

fn main() -> i64:
    if IMPORTED_REGISTRY.contains(7): return 21
    IMPORTED_REGISTRY[7] = RegistryCounter(count: 73)
    if not IMPORTED_REGISTRY.contains(7): return 22
    if read_inferred(7) != 73: return 23
    if read_declared(7) != 73: return 24
    IMPORTED_REGISTRY.remove(7)
    if IMPORTED_REGISTRY.contains(7): return 25
    print "GLOBAL_REGISTRY_IMPORTED_ALIAS_NATIVE_PASS"
    0
