use app.io.args_ops.{get_args}
use app.io.file_ops.{file_atomic_write, file_read_regular_no_follow_bounded}

fn main() -> i64:
    val args = get_args()
    if args.len() != 3: return 2
    val path = args[1] + "/CURRENT"
    val old = "generation=2\ncursor=retained\n"
    if args[2] == "overwrite":
        if not file_atomic_write(path, "generation=1\ncursor=first\n"): return 3
        if not file_atomic_write(path, old): return 4
        val actual = match file_read_regular_no_follow_bounded(path, 4096):
            Ok(value): value
            Err(_message): return 5
        if actual != old: return 6
        print "PASS Windows atomic write creates and replaces existing CURRENT"
        return 0
    if args[2] == "failed-publish":
        if file_atomic_write(path, "generation=3\ncursor=must-not-publish\n"): return 7
        val retained = match file_read_regular_no_follow_bounded(path, 4096):
            Ok(value): value
            Err(_message): return 8
        if retained != old: return 9
        print "PASS failed atomic publication retains prior CURRENT bytes"
        return 0
    10
