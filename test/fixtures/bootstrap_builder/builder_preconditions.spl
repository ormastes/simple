use app.io.mod.{env_get, file_is_regular_no_follow}

# Empty text when the managed scope provided the compiled qualifier; otherwise
# the reason, to be surfaced as a `precondition:` (BLOCKED) result.
fn builder_qualifier_precondition() -> text:
    val qualifier = env_get("SIMPLE_BUILDER_QUALIFIER")
    if qualifier == "":
        return "SIMPLE_BUILDER_QUALIFIER is unset (compiled builder qualifier is provided only by the managed bootstrap scope)"
    if not file_is_regular_no_follow(qualifier):
        return "SIMPLE_BUILDER_QUALIFIER does not name a regular file: {qualifier}"
    ""
