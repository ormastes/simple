use app.io.mod.{env_get}

# Pure: reason text when the managed scope did not provide the qualifier, else "".
# A SET-but-broken qualifier is deliberately NOT a precondition; the spec's
# run helper asserts it so that stays a hard FAIL.
fn builder_qualifier_reason(qualifier: text) -> text:
    if qualifier == "":
        return "SIMPLE_BUILDER_QUALIFIER is unset (compiled builder qualifier is provided only by the managed bootstrap scope)"
    ""

fn builder_qualifier_precondition() -> text:
    builder_qualifier_reason(env_get("SIMPLE_BUILDER_QUALIFIER"))
