use std.mcp_sdk.transport.transport.{Transport}
use std.mcp_sdk.server.app.{mcp_serve}

class Buf with Transport:
    closed: bool
    static fn new() -> Buf:
        Buf(closed: false)
    fn read_message() -> text?:
        print "VTABLE_READ_REACHED"
        nil
    fn write_message(msg: text):
        print "w {msg}"
    fn close():
        print "c"

fn main() -> i64:
    mcp_serve(Buf.new())
    0
