# Compile and execute with an admitted native Simple producer. NOT_RUN.
# Direct extern calls intentionally bypass request validation to test actual
# lowering and native embedded-NUL rejection, not a copied pure predicate.
@unsafe(reason: "exercise actual storage tagged-text ABI", capabilities: [ffi])
extern fn rt_workspace_storage_open_v1(kind: text, parent: text, leaf: text, pool: text,
    workspace: text, quota: i64, hard: i64, policy: text) -> i64
@unsafe(reason: "exercise actual storage recovery tagged-text ABI", capabilities: [ffi])
extern fn rt_workspace_storage_recover_v1(kind: text, parent: text, leaf: text, pool: text,
    workspace: text, quota: i64, hard: i64, policy: text) -> i64

fn main() -> i64:
    val policy = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    val parent = "/not-provisioned\u{0}/suffix"
    val opened = unsafe(capabilities: [ffi]):
        rt_workspace_storage_open_v1("linux-xfs-project-v1", parent, "work", "pool", "workspace", 77, 65536, policy)
    assert(opened == -22)
    val recovered = unsafe(capabilities: [ffi]):
        rt_workspace_storage_recover_v1("linux-xfs-project-v1", parent, "work", "pool", "workspace", 77, 65536, policy)
    assert(recovered == -22)
    print("PASS workspace storage actual embedded-NUL ABI")
    0
