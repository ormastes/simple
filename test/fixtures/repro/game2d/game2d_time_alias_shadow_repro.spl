# Regression repro for doc/08_tracking/bug/interp_module_alias_time_shadowed_builtin_2026-07-02.md
#
# Aliasing a `det_guard` import as `time` used to be shadowed by the
# `game2d` package's own `use std.nogc_sync_mut.game2d.time as time`
# re-export in `src/lib/nogc_sync_mut/game2d/__init__.spl`, producing a
# runtime "semantic: variable `time` not found" instead of resolving the
# local alias.
#
# Expected (fixed): prints "ok" with no resolution error.
use std.nogc_sync_mut.game2d.time.det_guard as time

fn main():
    time.set_deterministic_mode(true)
    print("ok")
