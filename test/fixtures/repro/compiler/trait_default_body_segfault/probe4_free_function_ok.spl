# Control for probe3_trait_default_body_crashes.spl: byte-identical logic to
# the trait's default `poll_event` body, but living in a free function that
# takes the trait object as a parameter instead of as a trait default body.
#
# Bug: doc/08_tracking/bug/trait_default_body_segfaults_via_trait_object_2026-08-06.md
#
# Per the bug report this is expected to run cleanly (exit 0) under
# `bin/simple run`, in contrast to probe3.spl's SIGSEGV -- demonstrating the
# defect is specific to dispatching a DEFAULT-BODIED trait method through a
# trait-object-typed binding, not to the underlying enum/Option logic itself.
#
#   bin/simple run test/fixtures/repro/compiler/trait_default_body_segfault/probe4_free_function_ok.spl

enum Key:
    T
    Other

enum KeyEvent:
    Press(Key)
    Release(Key)

enum MouseEvent:
    Move(int, int)

enum HostEvent:
    KeyEv(text, bool, bool, bool)
    MouseEv(int, int)

fn make_key_event(key_event: KeyEvent, ch: text, shift: bool, ctrl: bool, alt: bool) -> HostEvent?:
    Some(HostEvent.KeyEv(ch, shift, ctrl, alt))

fn make_mouse_event(m: MouseEvent) -> HostEvent?:
    if val Move(x, y) = m:
        return Some(HostEvent.MouseEv(x, y))
    nil

trait Backend:
    me poll_key() -> KeyEvent?
    me poll_mouse() -> MouseEvent?
    fn alt_held() -> bool
    fn shift_held() -> bool
    fn ctrl_held() -> bool
    fn key_to_char(key: Key) -> text?

class SI:
    ch: text

impl Backend for SI:
    me poll_key() -> KeyEvent?:
        Some(KeyEvent.Press(Key.T))

    me poll_mouse() -> MouseEvent?:
        nil

    fn alt_held() -> bool:
        true

    fn shift_held() -> bool:
        false

    fn ctrl_held() -> bool:
        true

    fn key_to_char(key: Key) -> text?:
        Some(self.ch)

fn poll_event_free(b: Backend) -> HostEvent?:
    val key_opt: KeyEvent? = b.poll_key()
    if val key_event = key_opt:
        var ch = ""
        if val Press(pressed_key) = key_event:
            if val Some(c) = b.key_to_char(pressed_key):
                ch = c
        return make_key_event(
            key_event, ch,
            b.shift_held(), b.ctrl_held(), b.alt_held()
        )
    val mouse_opt: MouseEvent? = b.poll_mouse()
    if val mouse_event = mouse_opt:
        return make_mouse_event(mouse_event)
    nil

fn main():
    val b: Backend = SI(ch: "t")
    print("ctrl=" + b.ctrl_held().to_text())
    if val Some(c) = b.key_to_char(Key.T):
        print("char=" + c)
    val ev = poll_event_free(b)
    print("done")
