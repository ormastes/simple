# Minimal native-lowering half of
# doc/08_tracking/bug/primitive_receiver_trait_impl_dispatch_2026-08-07.md
#
#   bin/simple native-build <this file> -o /tmp/x
#     -> [ERROR] MIR error: MIR lowering error: unresolved method call: mark
#        (twice: once for the f32 receiver, once for the text receiver)
#
# Kept separate from primitive_trait_impl_dispatch_repro.spl because the larger
# repro's native build is confounded by unrelated pre-existing prelude errors
# ("unresolved method call: merge", "unsupported MIR type kind [infer-arm]"),
# which would mask this signal.

trait Marker:
    fn mark() -> i64

impl Marker for f32:
    fn mark() -> i64:
        1006

impl Marker for text:
    fn mark() -> i64:
        1001

fn main():
    print("f32  = " + (1.5 as f32).mark().to_text())
    print("text = " + "x".mark().to_text())
