use std.nogc_sync_mut.io.path_identity_abi.{malloc, free}
use std.common.string_builder.{RtStringBuilder}
use std.nogc_sync_mut.io.volatile_ops.{volatile_write_u8}

@unsafe(reason: "regression owns one libc buffer and one distinct builder", capabilities: [ffi, raw_ptr])
fn exercise_imported_free() -> i64:
    val pointer = malloc(16u64)
    if pointer == 0: return 1
    volatile_write_u8(pointer, 47)
    free(pointer)
    var builder = RtStringBuilder.new()
    builder.push("builder-control")
    if builder.len() != 15:
        builder.free()
        return 2
    builder.free()
    0

fn main() -> i64:
    unsafe(capabilities: [ffi, raw_ptr]):
        exercise_imported_free()
