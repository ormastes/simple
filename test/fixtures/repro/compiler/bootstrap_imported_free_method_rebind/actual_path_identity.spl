use std.nogc_sync_mut.io.path_identity.{path_final_existing, path_final_existing_with_capacity, path_entry_present}
use std.common.string_builder.{RtStringBuilder}

fn main() -> i64:
    # Actual POSIX owner exercises malloc/free + realpath/free and readlink/free.
    val resolved = path_final_existing("/home")
    match resolved:
        case Ok(value):
            if not value.path.starts_with("/"): return 1
            if value.identity == "": return 2
        case Err(_): return 3
    match path_final_existing_with_capacity("/home", 1):
        case Err(message):
            if message != "PATH_IDENTITY_TRUNCATED": return 4
        case Ok(_): return 5
    match path_entry_present("/home"):
        case Ok(present):
            if not present: return 6
        case Err(_): return 7
    var builder = RtStringBuilder.new()
    builder.push("control")
    if builder.len() != 7:
        builder.free()
        return 8
    builder.free()
    0
