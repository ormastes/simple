# Focused native regression: call the actual generated CharLit codec.
use compiler.hir.hir_definitions.{HirExprKind}
use compiler.hir.generated.hir_codec.{hc_enc_hir_expr_kind, hc_dec_hir_expr_kind}
use compiler.hir.hir_codec_support.{HirCodecWriter, hc_char_bytes_valid, hc_read_char}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}

fn check_char(wire: text, scalar: i64) -> bool:
    var reader = FlatPoolReader.new(wire)
    val node = hc_dec_hir_expr_kind(reader)
    if not reader.ok: return false
    match node:
        case HirExprKind.CharLit(value):
            if (value as i64) != scalar: return false
        case _: return false
    var writer = HirCodecWriter.create()
    hc_enc_hir_expr_kind(writer, node)
    writer.ok and writer.finish() == wire

fn rejected_char(wire: text) -> bool:
    var reader = FlatPoolReader.new(wire)
    val node = hc_dec_hir_expr_kind(reader)
    not reader.ok and node == nil

fn main() -> i64:
    if not check_char("4\na\n", 97): return 11
    if not check_char("4\né\n", 233): return 12
    if not check_char("4\n😀\n", 128512): return 13
    if not check_char("4\n\\n\n", 10): return 14
    if not check_char("4\n\\\\\n", 92): return 15
    if not check_char("4\n�\n", 65533): return 16
    if not check_char("4\nN\n", 78): return 17
    if not check_char("4\n\x00\n", 0): return 18
    if not check_char("4\n\x03\n", 3): return 19
    if not rejected_char("4\n\n"): return 21
    if not rejected_char("4\nab\n"): return 22
    if not rejected_char("4\n\\\\N\n"): return 23
    if hc_char_bytes_valid([0xC0, 0xAF]): return 31
    if hc_char_bytes_valid([0xED, 0xA0, 0x80]): return 32
    if hc_char_bytes_valid([0xF4, 0x90, 0x80, 0x80]): return 33
    if hc_char_bytes_valid([0x80]): return 34
    if hc_char_bytes_valid([0xE2, 0x82]): return 35
    if not hc_char_bytes_valid([0xEF, 0xBF, 0xBD]): return 36
    var nil_reader = FlatPoolReader.new("4\n\\N\n")
    val nil_node = hc_dec_hir_expr_kind(nil_reader)
    if not nil_reader.ok: return 41
    var nil_writer = HirCodecWriter.create()
    hc_enc_hir_expr_kind(nil_writer, nil_node)
    if not nil_writer.ok or nil_writer.finish() != "4\n\\N\n": return 42
    var scalar_reader = FlatPoolReader.new("\\N\n")
    val rejected_scalar = hc_read_char(scalar_reader, scalar_reader.next())
    if scalar_reader.ok: return 43
    if scalar_reader.failure_detail != "char_nil_requires_enum_slot": return 44
    print "CHAR_WIRE_CODEC_UNICODE_BYTES_AND_NIL_PASS"
    0
