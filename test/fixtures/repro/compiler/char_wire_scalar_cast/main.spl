# Native prerequisite probe for the generated CharLit wire decoder.
# This proves scalar conversion only, not a complete codec repair.
use std.common.encoding.utf8.{text_codepoint_len, text_is_valid_utf8}

enum WireScalar:
    Character(value: char)

fn scalar_text_valid(value: text) -> bool:
    text_is_valid_utf8(value) and text_codepoint_len(value) == 1

fn scalar_from_text(value: text) -> char:
    (value as i64) as char

fn scalar_roundtrip(value: text) -> i64:
    val scalar = scalar_from_text(value)
    val packet = WireScalar.Character(scalar)
    match packet:
        case Character(decoded): decoded as i64

fn main() -> i64:
    if scalar_text_valid(""): return 11
    if scalar_text_valid("ab"): return 12
    if not scalar_text_valid("a"): return 13
    if not scalar_text_valid("é"): return 14
    if not scalar_text_valid("😀"): return 15
    if scalar_roundtrip("a") != 97: return 21
    if scalar_roundtrip("é") != 233: return 22
    if scalar_roundtrip("😀") != 128512: return 23
    if scalar_roundtrip("\n") != 10: return 24
    if scalar_roundtrip("\\") != 92: return 25
    print "CHAR_WIRE_SCALAR_CAST_PASS"
    0
