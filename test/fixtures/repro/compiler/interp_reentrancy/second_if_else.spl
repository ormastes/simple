# Re-entrancy repro, file 2 of 2 — evaluated in the SAME process right after
# first_if_else.spl. Small on purpose (10 expressions), so the stale condition
# id 19 left behind by file 1 is out of range.
#
# Before the fix: `error: semantic: array index out of bounds: index is 19 but
# length is 10`, with nothing printed. After the fix: SECOND ok.
fn main():
    val got = 10
    if got == 10:
        print "SECOND ok"
    else:
        print "SECOND wrong"
