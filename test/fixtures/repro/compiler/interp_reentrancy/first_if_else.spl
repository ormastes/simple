# Re-entrancy repro, file 1 of 2 — evaluate this FIRST in the process.
#
# It is deliberately BIGGER than second_if_else.spl: its `if` condition is
# expression id 19, well past the end of the smaller file's arena. Before the
# fix the elif arena entry holding that id survived ast_reset() (a cross-module
# `elif_cond.clear()` in _Ast/module_state.spl never reached the arena
# _Ast/decl_nodes.spl appends to), so the NEXT eval read id 19 back and indexed
# its own 10-entry expression arena with it.
class CellR:
    n: i64

fn main():
    val first = CellR(n: 120)
    val second = CellR(n: 130)
    val arr = [first, second]
    arr[1].n = 131
    val got = second.n
    if got == 131:
        print "FIRST ok"
    else:
        print "FIRST wrong"
