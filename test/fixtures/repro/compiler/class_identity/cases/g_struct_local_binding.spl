# F1 corpus case G — STRUCT copied by LOCAL BINDING from a place read
# (`var b = a`). S1 copy-site 1.
# Contract: struct = value semantics, so `b` is a SNAPSHOT of `a`.
# Prints VAL when the contract holds, ALIAS(n=..) when it is violated.

struct SCellG:
    n: i64

fn main():
    var a = SCellG(n: 10)
    var b = a
    a.n = 11
    val got = b.n
    if got == 10:
        print "G struct local binding = VAL"
    else:
        print "G struct local binding = ALIAS(n={got})"
