# F1 corpus case I — STRUCT RETURNED from a function (a place read returned by
# value). S1 copy-site 4.
# Contract: struct = value semantics, so the caller's binding is a SNAPSHOT and
# writing to it must not reach the box the value came from.
# Prints VAL when the contract holds, ALIAS(n=..) when it is violated.

struct SCellI:
    n: i64

class BoxI:
    cell: SCellI

fn take(b: BoxI) -> SCellI:
    b.cell

fn main():
    val b = BoxI(cell: SCellI(n: 30))
    var r = take(b)
    r.n = 31
    val got = b.cell.n
    if got == 30:
        print "I struct returned      = VAL"
    else:
        print "I struct returned      = ALIAS(n={got})"
