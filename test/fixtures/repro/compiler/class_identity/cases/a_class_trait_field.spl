# F1 corpus case A — class instance held in a TRAIT-typed field.
# Contract: the field holds the REFERENCE, so a later write through the
# original must be visible through the field.
# Prints REF when the contract holds, COPY(n=..) when it is violated.

class TraitCellA:
    n: i64

trait BumpableA:
    fn value() -> i64

impl BumpableA for TraitCellA:
    fn value() -> i64:
        self.n

class TraitHolderA:
    item: BumpableA

fn main():
    val tc = TraitCellA(n: 100)
    val th = TraitHolderA(item: tc)
    tc.n = 101
    val got = th.item.value()
    if got == 101:
        print "A class trait field    = REF"
    else:
        print "A class trait field    = COPY(n={got})"
