# F1 corpus case F — STRUCT stored into a class field via struct-literal field
# initialisation. This is S1 copy-site 2 in
# doc/03_plan/ui/perf/f1_class_identity_kind_propagation_plan_2026-08-09.md.
# Contract: struct = value semantics, so the field is a SNAPSHOT.
# Prints VAL when the contract holds, ALIAS(n=..) when it is violated.

struct SCellF:
    n: i64

class HolderF:
    cell: SCellF

fn main():
    var s = SCellF(n: 150)
    val h = HolderF(cell: s)
    s.n = 151
    val got = h.cell.n
    if got == 150:
        print "F struct literal init  = VAL"
    else:
        print "F struct literal init  = ALIAS(n={got})"
