# F1 corpus case J — POSITIVE CONTROL for the pure-Simple frontend interpreter.
# Struct passed as a parameter: this is the ONE site that already calls
# `val_struct_deep_copy` (10.frontend/core/interpreter/eval_calls.spl:343), so
# it must print VAL on that engine even while F/G/H/I are wrong. If J ever
# prints ALIAS the copy gate itself has regressed, and every other struct
# reading here is uninterpretable.
# Prints VAL when the contract holds, ALIAS(n=..) when it is violated.

struct SCellJ:
    n: i64

fn bump(s: SCellJ) -> i64:
    s.n = 99
    s.n

fn main():
    var a = SCellJ(n: 40)
    val inner = bump(a)
    val got = a.n
    if got == 40:
        print "J struct param binding = VAL"
    else:
        print "J struct param binding = ALIAS(n={got})"
