# F1 corpus case D — a class passed as a PARAMETER and stored into a field by
# the callee, then mutated by the caller.
# Contract: the field holds the REFERENCE.
# Prints REF when the contract holds, COPY(n=..) when it is violated.

class CellD:
    n: i64

class HolderD:
    cell: CellD

fn stash(h: HolderD, c: CellD):
    h.cell = c

fn main():
    val h = HolderD(cell: CellD(n: 0))
    val c = CellD(n: 140)
    stash(h, c)
    c.n = 141
    val got = h.cell.n
    if got == 141:
        print "D class param->field   = REF"
    else:
        print "D class param->field   = COPY(n={got})"
