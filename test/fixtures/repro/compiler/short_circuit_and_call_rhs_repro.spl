var calls = 0
fn probe() -> bool:
    calls = calls + 1
    true

fn gate(registered_only: bool) -> i64:
    if not registered_only and probe():
        return 1
    0

fn main() -> i64:
    val a = gate(true)
    if calls != 0:
        return 10
    val b = gate(false)
    if b != 1 or calls != 1:
        return 11
    print("short-circuit-and-ok")
    0
