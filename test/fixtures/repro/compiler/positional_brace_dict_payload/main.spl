enum Root:
    IndexMap({text: i64})
    Lists({text: [i64]})
    After(i64)

fn count(r: Root) -> i64:
    match r:
        case IndexMap(m): m.len() * 100 + m["b"]
        case Lists(l): l.len() * 10 + l["x"].len()
        case After(n): n

fn main() -> i64:
    var m: {text: i64} = {}
    m["a"] = 1
    m["b"] = 7
    var l: {text: [i64]} = {}
    l["x"] = [1, 2, 3]
    val a = count(Root.IndexMap(m))
    val b = count(Root.Lists(l))
    val c = count(Root.After(5))
    print("a={a} b={b} c={c}")
    if a == 207 and b == 13 and c == 5: 0 else: 1
