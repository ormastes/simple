# Reproduce: `!` unwrap of an optional USER ENUM, then a match on the result.
#
# Same defect class as the class/struct case in
# `optional_class_unwrap_field.spl`: `Color?` is `HirType::Pointer { inner:
# Enum }`, which is NOT a Result/Option, so `lower_try`'s hashed-"Err"
# discriminant test was false for every variant. Pre-fix the seed JIT printed
# `enum other` for a value that is plainly `Color.Green` (a silent WRONG
# ANSWER, not a crash).
#
# Bug: doc/08_tracking/bug/jit_optional_class_unwrap_field_access_segv_2026-08-20.md
#
# JIT-only assertion: the seed INTERPRETER still raises
# `force unwrap failed: expected Some or Ok, got Color::Green` — a separate
# interpreter-side defect, recorded in the bug doc, not fixed here.
#
# MUST be run as a PROBE (`simple run`), never wrapped in a spec.

enum Color:
    Red
    Green

fn main():
    val m: Color? = Color.Green
    val u = m!
    match u:
        case Color.Green: print "OK enum-unwrap-match"
        case _: print "FAIL enum-unwrap-match wrong variant"

    print "REPRO OK"
