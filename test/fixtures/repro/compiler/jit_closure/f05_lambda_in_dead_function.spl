# Fixture f05 — THE IMPORTANT ONE. A lambda inside a function that is NEVER
# CALLED. `main` does no closure work at all.
#
# The guard scans every function in the module for `ClosureCreate` with no
# reachability analysis, so the prediction is that dead code still poisons the
# whole module. If so, "this lambda is only in a debug/diagnostics helper" is
# no defence — which is exactly what happened in diag.spl.

fn never_called() -> i64:
    val f = \x: x * 2
    f(21)

fn main():
    print("f05 marker result={42}")
