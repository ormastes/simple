# Fixture f03 — non-capturing lambda passed directly as an argument.
# Tests whether CAPTURE is what matters (prediction: it is not).
#
# The lambda is bound OUTSIDE the print string on purpose: an interpolated
# `{...}` expression is real code, but a text-level scanner that strips string
# literals cannot see into it. Keeping the lambda out of the string keeps this
# fixture a test of the LANGUAGE FORM rather than of interpolation handling.

fn apply(f: (i64) -> i64, x: i64) -> i64:
    f(x)

fn main():
    val r = apply(\y: y + 1, 41)
    print("f03 marker result={r}")
