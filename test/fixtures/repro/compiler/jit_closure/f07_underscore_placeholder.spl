# Fixture f07 — the `_` placeholder form, which a lambda-shaped grep does NOT
# match. This is how blocker 2 (Directory.list_paths) stayed hidden.

fn double(x: i64) -> i64:
    x * 2

fn main():
    val nums: [i64] = [1, 2, 3]
    val out = nums.map(double(_))
    print("f07 marker result={out.len()}")
