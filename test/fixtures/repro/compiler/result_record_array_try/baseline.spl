# Real imported Result Ok record; only the local annotation differs between controls.
use app.bootstrap_builder.native_group_module_roles.{
    Phase2ModuleSourceV1, Phase2ModuleSelectionV1, phase2_module_roles_select_v1
}

fn selected_paths(policy: text) -> Result<text, text>:
    val sources = [
        Phase2ModuleSourceV1("src/os/kernel/loader/mod.spl", "1".repeat(64)),
        Phase2ModuleSourceV1("src/unit/simple-lang/volume/L.spl", "2".repeat(64))
    ]
    val selection = phase2_module_roles_select_v1(policy, sources)?
    var paths: [text] = []
    for path in selection.included_paths:
        paths = paths.push(path)
    Ok(paths.join("|"))

fn main() -> i32:
    match selected_paths("schema=SIMPLE-NATIVE-MODULE-ROLES-1\n"):
        case Ok(paths):
            if paths != "src/os/kernel/loader/mod.spl|src/unit/simple-lang/volume/L.spl": return 1
        case Err(_): return 2
    match selected_paths(""):
        case Ok(_): return 3
        case Err(reason):
            if reason != "module role policy framing invalid": return 4
    print "RESULT_RECORD_ARRAY_TRY_PASS"
    0
