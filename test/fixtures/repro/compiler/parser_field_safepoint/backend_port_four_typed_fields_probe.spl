use compiler.frontend.flat_ast_bridge.{parse_and_build_module_scoped}
use compiler.frontend.parser_types.{ParserModule, ParserStruct}
use compiler.frontend.parser_types_expr.{parser_type_kind_named_name}

@unsafe(reason: "exercise the production transient parser-scope ABI", capabilities: [ffi])
extern fn rt_transient_array_scope_begin() -> bool
@unsafe(reason: "exercise the production transient parser-scope ABI", capabilities: [ffi])
extern fn rt_transient_array_scope_pause() -> bool
@unsafe(reason: "exercise the production transient parser-scope ABI", capabilities: [ffi])
extern fn rt_transient_array_scope_end() -> bool
@unsafe(reason: "retain the parsed module across transient-scope teardown", capabilities: [ffi])
extern fn rt_transient_heap_promote(value: Any) -> bool

fn transient_scope_begin() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_begin()

fn transient_scope_pause() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_pause()

fn transient_scope_end() -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_array_scope_end()

fn transient_promote(value: Any) -> bool:
    unsafe(capabilities: [ffi]):
        rt_transient_heap_promote(value)

val source = (
    "struct BackendPortShape:\n" +
    "    name: text\n" +
    "    run_fn: any\n" +
    "    supports_jit_fn: any\n" +
    "    target_triple_fn: any\n")

if not transient_scope_begin():
    panic("transient parser scope unavailable")

# Match the Stage3 driver: it owns the transient scope while the frontend uses
# its ordinary non-self-scoped bridge entrypoint.
val parsed: ParserModule = parse_and_build_module_scoped(
    source, "backend_port_four_typed_fields.spl", false)
if not transient_scope_pause():
    panic("transient parser scope pause failed")
if not transient_promote(parsed):
    panic("parsed module promotion failed")
if not transient_scope_end():
    panic("transient parser scope end failed")

val shape: ParserStruct = parsed.structs["BackendPortShape"]
if shape.fields.len() != 4:
    panic("expected four BackendPort-shaped fields")
if (shape.fields[0].name != "name" or
   shape.fields[1].name != "run_fn" or
   shape.fields[2].name != "supports_jit_fn" or
   shape.fields[3].name != "target_triple_fn"):
    panic("BackendPort-shaped field order changed")
if (parser_type_kind_named_name(shape.fields[0].type_.kind) != "text" or
   parser_type_kind_named_name(shape.fields[1].type_.kind) != "any" or
   parser_type_kind_named_name(shape.fields[2].type_.kind) != "any" or
   parser_type_kind_named_name(shape.fields[3].type_.kind) != "any"):
    panic("BackendPort-shaped field types changed")

print "PASS branch-local ParserField types survive transient safepoints"
