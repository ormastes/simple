struct Expr:
    id: i64

enum StmtKind:
    Expr(e: Expr)
    Return(v: i64)

fn tag(k: StmtKind) -> i64:
    match k:
        case Expr(e):
            return e.id
        case Return(v):
            return v + 100

fn main() -> i64:
    val a = tag(StmtKind.Expr(Expr(id: 7)))
    val b = tag(StmtKind.Return(5))
    print("a={a} b={b}")
    0
