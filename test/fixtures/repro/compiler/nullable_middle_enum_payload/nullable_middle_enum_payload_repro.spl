# Minimal native-lowering reproducer for a nullable struct in the middle of an
# enum payload.  The trailing payload is consumed first, matching the
# HirStmtKind.Let lowering order that exposed the Stage 3 crash.

struct TypeInfo:
    code: i64

enum Statement:
    Let(symbol: i64, type_: TypeInfo?, init: i64)
    Empty

fn declared_code_after_init(stmt: Statement) -> i64:
    match stmt:
        case Statement.Let(_, type_, init):
            val consumed_init = init + 1
            match type_:
                case Some(found): return consumed_init + found.code
                case nil: return consumed_init
        case Statement.Empty: return -1

fn main():
    val inferred = Statement.Let(symbol: 7, type_: nil, init: 40)
    val annotated = Statement.Let(symbol: 8, type_: TypeInfo(code: 1), init: 40)
    print "nil={declared_code_after_init(inferred)}"
    print "present={declared_code_after_init(annotated)}"
