fn probe(tag: text, got: i64?, want: i64) -> i64:
    match got:
        case Some(v):
            if v == want:
                print "PASS {tag}"
                return 0
            print "FAIL {tag} value"
            return 1
        case None:
            print "FAIL {tag} none"
            return 1

fn probe_none(tag: text, got: i64?) -> i64:
    match got:
        case Some(v):
            print "FAIL {tag} some"
            return 1
        case None:
            print "PASS {tag}"
            return 0

fn main() -> i64:
    val a = [10, 20, 30]
    var bad = 0
    bad = bad + probe("at_in_range", a.at(1), 20)
    bad = bad + probe_none("at_out_of_range", a.at(5))
    bad = bad + probe_none("at_negative", a.at(-4))
    bad = bad + probe("first", a.first(), 10)
    bad = bad + probe("last", a.last(), 30)
    bad
