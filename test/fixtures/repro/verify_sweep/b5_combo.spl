fn f1(x: i64) -> i64:
    x + 1
fn optm(o: i64?) -> i64?:
    val r = match o:
        case Some(e): Some(f1(e))
        case None: None
    r

fn in_range(x: u64, lo: u64, hi: u64) -> bool:
    x >= lo and x <= hi

fn add1(n: i64) -> i64:
    n + 1
fn apply(f: fn(i64) -> i64, x: i64) -> i64:
    f(x)

struct Box2:
    items: [i64]

fn main() -> i64:
    var fails = 0
    # optmatch
    val a = optm(Some(3))
    if a.unwrap() != 4:
        print "FAIL optmatch"
        fails = fails + 1
    # u64 range compare
    val big: u64 = 18446744073709551000.to_u64()
    if not in_range(big, 5.to_u64(), 18446744073709551615.to_u64()):
        print "FAIL u64range"
        fails = fails + 1
    # array concat / suffix
    val x = [1, 2, 3]
    val y = x + [4, 5]
    if y.len() != 5:
        print "FAIL concat"
        fails = fails + 1
    val sfx = y[2:]
    if sfx.len() != 3:
        print "FAIL suffix"
        fails = fails + 1
    # first-class lambda
    val k = 10
    val cap = \z: z + k
    if apply(cap, 1) != 11:
        print "FAIL lambda"
        fails = fails + 1
    if apply(add1, 1) != 2:
        print "FAIL fnvalue"
        fails = fails + 1
    # mutate through index
    var d: Dict<text, [i64]> = {}
    d["a"] = []
    d["a"].push(9)
    if d["a"].len() != 1:
        print "FAIL dictpush"
        fails = fails + 1
    var b = Box2(items: [])
    b.items.push(1)
    if b.items.len() != 1:
        print "FAIL fieldpush"
        fails = fails + 1
    if fails == 0:
        print "PASS"
    0
