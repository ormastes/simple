enum Tok:
    Word(text)
    Num(i64)

fn show(t: Tok) -> text:
    match t:
        Word(w): "word:{w}"
        Num(n): "num:{n}"

fn pair() -> (text, i64):
    ("hello", 5)

fn touch() -> i64:
    7

fn main() -> i64:
    var ok = true
    if show(Tok.Word("abc")) != "word:abc":
        print("FAIL enum " + show(Tok.Word("abc")))
        ok = false
    var d: Dict<text, i64> = {}
    d["a"] = 1
    d["b"] = 2
    var total = 0
    for (k, v) in d:
        total = total + v + k.len()
    if total != 5:
        print("FAIL dict " + total.to_string())
        ok = false
    val (s, n) = pair()
    val z = touch()
    if s != "hello" or n != 5 or z != 7:
        print("FAIL tuple " + s)
        ok = false
    if ok:
        print("PASS")
    return 0
