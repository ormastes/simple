enum K:
    Fn(i64, i64, [text])
    Other

fn pick(k: K) -> [text]:
    val effs = match k:
        case Fn(_, _, e): e
        case _: []
    effs

fn main() -> i64:
    val a = pick(K.Fn(1, 2, ["x", "y"]))
    val b = pick(K.Other)
    if a.len() != 2 or b.len() != 0:
        print "FAIL"
        return 1
    print "PASS"
    0
