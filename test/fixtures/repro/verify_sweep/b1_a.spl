fn mk(n: i64) -> [i64]?:
    if n > 0:
        return [n, n + 1]
    return nil

fn main() -> i64:
    val a: [u8] = [1u8, 2u8]
    val b: [u8] = [1u8, 2u8]
    print("U8NE={a != b}")
    val s = "hello"
    print("BOOL={s.starts_with(\"he\")}|END")
    val n = 7
    print("TS={n.to_string()}|END")
    var tot = 0
    if val items = mk(3):
        tot = items.len()
    print("OPTARR={tot}")
    var d = {}
    d["k"] = "hi"
    if d["k"] == "hi":
        print("DICT=ok")
    else:
        print("DICT=bad")
    return 0
