trait Backend:
    fn base() -> i64
    fn mult() -> i64
    fn combined() -> i64:
        self.base() * self.mult() + 1

struct Impl1:
    b: i64

impl Backend for Impl1:
    fn base() -> i64:
        self.b
    fn mult() -> i64:
        3

fn main() -> i64:
    val ib: Backend = Impl1(b: 4)
    if ib.base() != 4:
        print "FAIL base"
        return 1
    if ib.combined() != 13:
        print "FAIL combined"
        return 2
    print "PASS"
    0
