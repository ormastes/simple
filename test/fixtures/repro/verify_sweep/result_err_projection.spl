# Repro: Result.err() projection (result_err_missing_native_projection_2026_10_12).
# Native-build must resolve `.err()` on a Result; s3_fable43 reported
# "MIR lowering error: unresolved method call: err".
fn main() -> i64:
    val r: Result<i64, text> = Err("boom")
    val e = r.err()
    if e.unwrap() != "boom":
        print "FAIL err_projection"
        return 1
    print "PASS err_projection"
    0
