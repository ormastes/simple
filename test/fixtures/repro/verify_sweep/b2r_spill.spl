fn ch(c: i64, s: i64) -> i64:
    if c < 0:
        return 0
    return (c + s) % 256

fn lerp(a: i64, b: i64, t: i64) -> i64:
    val x = ch(a, 0)
    val y = ch(b, 0)
    val z = ch(x, y)
    val w = ch(z, t)
    return ch(w + (b - a) * t / 28, 0) + ch(a, 1) * 0 + ch(b, 2) * 0

fn main() -> i64:
    val top: i64 = 120
    val bottom: i64 = 94
    var i: i64 = 0
    var bad: i64 = 0
    while i < 28:
        val c = lerp(top, bottom, i)
        val e = ch(ch(ch(ch(top, 0), ch(bottom, 0)), i) + (bottom - top) * i / 28, 0)
        if c != e or top != 120 or bottom != 94:
            bad = bad + 1
        i = i + 1
    if bad == 0:
        print("PASS spill")
        return 0
    print("FAIL spill bad={bad}")
    return 1
