struct IoErr:
    code: i64
    message: text

fn run(ok: bool) -> Result<i64, IoErr>:
    if ok:
        return Ok(1)
    Err(IoErr(code: 7, message: "boom"))

fn main() -> i64:
    val r = run(false)
    match r:
        case Err(e):
            if e.message != "boom" or e.code != 7:
                print "FAIL"
                return 1
        case Ok(_):
            print "FAIL ok"
            return 1
    print "PASS"
    0
