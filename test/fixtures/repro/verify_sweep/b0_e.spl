trait MarkerProbe:
    fn marker_probe() -> i64

impl MarkerProbe for text:
    fn marker_probe() -> i64:
        1001

impl MarkerProbe for i64:
    fn marker_probe() -> i64:
        1002

fn main() -> i64:
    var bad = 0
    val s = "x"
    val n: i64 = 5
    if s.marker_probe() != 1001 or n.marker_probe() != 1002:
        print "FAIL prim_trait"
        bad = bad + 1
    if bad == 0:
        print "PASS"
    bad
