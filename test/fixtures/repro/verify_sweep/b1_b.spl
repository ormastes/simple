enum Adm:
    Bad(text)
    Good(i64)

fn mkadm(n: i64) -> Result<i64, text>:
    if n > 0:
        return Ok(n)
    return Err("bad")

fn first_panic(n: i64) -> i64:
    val r: i64 = match mkadm(n):
        case Err(reason): panic("no")
        case Ok(value): value
    return r

fn pairr(n: i64) -> Result<(i64, i64), text>:
    return Ok((n, n * 2))

fn secondf(n: i64) -> i64:
    return pairr(n).unwrap().1

fn rt_array_len(x: i64) -> i64:
    return x + 100

fn cpu() -> i64:
    extern fn rt_cpu_count() -> i64
    return rt_cpu_count()

struct Holder:
    cb: fn(i64) -> i64?

fn dbl(x: i64) -> i64:
    return x * 2

fn main() -> i64:
    print("PANIC1={first_panic(5)}")
    print("TUPLE={secondf(4)}")
    print("RTPFX={rt_array_len(1)}")
    print("NESTEXT={cpu() > 0}")
    return 0
