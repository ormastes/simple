enum E1:
    Bad
    Worse

fn f(n: i64) -> Result<i64, E1>:
    if n > 0:
        return Err(E1.Worse)
    return Ok(n)

fn main() -> i64:
    val r = f(1)
    val e = r.err().unwrap()
    val e2 = r.unwrap_err()
    if e == E1.Worse and e2 == E1.Worse:
        print("PASS errunwrap")
        return 0
    print("FAIL errunwrap")
    return 1
