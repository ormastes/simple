fn fmt_score(score: f64) -> text:
    val milli = (score * 1000.0) as i64
    val whole = milli / 1000
    var frac = milli - whole * 1000
    if frac < 0:
        frac = 0 - frac
    var frac_s = str(frac)
    while frac_s.len() < 3:
        frac_s = "0" + frac_s
    str(whole) + "." + frac_s

fn rb(ok: bool) -> Result<bool, text>:
    if ok:
        return Ok(true)
    Err("e")

fn ra() -> Result<[i64], text>:
    Ok([5, 6, 7])

fn main() -> i64:
    var bad = 0
    if fmt_score(12.345) != "12.345":
        print "FAIL score"
        bad = bad + 1
    val a = [1, 2]
    val b = [1, 2]
    if a != b:
        print "FAIL arr_i64_neq"
        bad = bad + 1
    val u: [u8] = [1, 2, 3]
    val v: [u8] = [1, 2, 3]
    if u != v:
        print "FAIL arr_u8_eq"
        bad = bad + 1
    var ta: [text] = []
    ta.push("x" + "y")
    var tb: [text] = []
    tb.push("xy")
    if ta != tb:
        print "FAIL arr_text_eq"
        bad = bad + 1
    var acc = 0
    var k = 0
    while k < 3:
        acc = acc + k
        k = k + 1
    if acc != 3:
        print "FAIL acc"
        bad = bad + 1
    val y = 5
    var c = 1
    c = c + y
    if c != 6:
        print "FAIL c"
        bad = bad + 1
    val r1 = rb(true).unwrap()
    if not r1:
        print "FAIL unwrap_bool"
        bad = bad + 1
    val r2 = ra().unwrap()
    if r2.len() != 3 or r2[1] != 6:
        print "FAIL unwrap_arr"
        bad = bad + 1
    var ex: [text] = ["a"]
    ex.extend(["b", "c"])
    if ex.len() != 3:
        print "FAIL extend"
        bad = bad + 1
    if bad == 0:
        print "PASS"
    bad
