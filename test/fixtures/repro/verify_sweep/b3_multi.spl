fn neg_label(c: i64) -> text:
    match c:
        -1073741819: "AV"
        -1: "m1"
        0: "zero"
        _: "other"

fn opt3() -> i64?:
    3

fn sum_opt() -> Result<i64, text>:
    val v = opt3()?
    Ok(v + 1)

fn fu() -> u64?:
    Some(7)

fn main() -> i64:
    var ok = true
    if neg_label(-1073741819) != "AV":
        print("FAIL neg1 " + neg_label(-1073741819))
        ok = false
    if neg_label(-1) != "m1":
        print("FAIL neg2 " + neg_label(-1))
        ok = false
    if neg_label(5) != "other":
        print("FAIL neg3")
        ok = false
    val parts = ["a", "b"].map(\p: p)
    val sep = ","
    if parts.join(sep) != "a,b":
        print("FAIL map " + parts.join(sep))
        ok = false
    val r = sum_opt()
    match r:
        Ok(x):
            if x != 4:
                print("FAIL try " + x.to_string())
                ok = false
        Err(e):
            print("FAIL try err " + e)
            ok = false
    val u = (fu() ?? 0) + 1
    if u != 8:
        print("FAIL u64 " + u.to_string())
        ok = false
    if ok:
        print("PASS")
    return 0
