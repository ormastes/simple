use std.nogc_sync_mut.tui.style.{tui_default_style}
use std.nogc_sync_mut.tui.widgets.input.{make_input_widget_with_value, input_insert_char, input_delete_back, input_move_end}

fn main() -> i64:
    val xs = [str(n) for n in [1, 2]]
    print("COMP={xs.join(",")}")
    val unicode = make_input_widget_with_value("p", "é🙂", tui_default_style())
    val end = input_move_end(unicode)
    val deleted = input_delete_back(end)
    print("TUI={deleted.value}|{deleted.cursor_pos}")
    return 0
