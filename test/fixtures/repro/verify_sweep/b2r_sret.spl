struct W3:
    ok: bool
    length: i64
    tag: i64

fn make(n: i64) -> W3:
    W3(ok: n > 0, length: n, tag: 77)

fn main() -> i64:
    val r = make(3)
    if r.length == 3 and r.tag == 77 and r.ok:
        print("PASS sret")
        return 0
    print("FAIL sret len={r.length} tag={r.tag}")
    return 1
