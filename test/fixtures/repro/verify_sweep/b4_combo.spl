struct Custom:
    value: i64

impl Custom:
    fn err() -> i64:
        self.value

fn text_error() -> Result<i64, text>:
    Err("denied")

fn success() -> Result<i64, text>:
    Ok(42)

fn number_error(value: i64) -> Result<text, i64>:
    Err(value)

struct Window:
    value: i64

impl Window:
    fn slice(start: i64, stop: i64) -> i64:
        self.value + start + stop

fn main() -> i64:
    val failure = text_error()
    if failure.err().unwrap() != "denied":
        print "FAIL r1"
        return 1
    val good = success()
    if good.err().is_some():
        print "FAIL r2"
        return 1
    if number_error(-7).err().unwrap() != -7:
        print "FAIL r3"
        return 1
    val custom = Custom(value: 7)
    if custom.err() != 7:
        print "FAIL r4"
        return 1
    val window: Window = Window(value: 37)
    if window.slice(2, 3) != 42:
        print "FAIL s1"
        return 1
    val inferred = "abcdef"
    if inferred.slice(2, 5) != "cde":
        print "FAIL s2"
        return 1
    val values: [i64] = [10, 20, 30, 40]
    val middle = values[1:3]
    if middle.len() != 2 or middle[0] != 20:
        print "FAIL s3"
        return 1
    print "PASS"
    0
