use std.common.text_bytes.{text_to_bytes}
struct Widget:
    name: text

impl Widget:
    fn describe(self) -> text:
        return "widget:" + self.name

trait MarkerProbe:
    fn marker_probe() -> i64

impl MarkerProbe for text:
    fn marker_probe() -> i64:
        1001

impl MarkerProbe for i64:
    fn marker_probe() -> i64:
        1002

impl MarkerProbe for bool:
    fn marker_probe() -> i64:
        1004

fn meta() -> Result<(u64, [u8]), text>:
    val b: [u8] = text_to_bytes("hi")
    Ok((7 as u64, b))

fn main() -> i64:
    var bad = 0
    val w = Widget(name: "w1")
    if w.describe() != "widget:w1":
        print "FAIL text_method"
        bad = bad + 1
    val bytes: [u8] = text_to_bytes("AB")
    val widened = [value as i64 for value in bytes]
    if widened.len() != 2 or widened[1] != 66:
        print "FAIL comprehension"
        bad = bad + 1
    if bytes[0].to_i64() != 65:
        print "FAIL u8_to_i64"
        bad = bad + 1
    val parts = ["a", "b", "c", "d"]
    if parts[2..].join("/") != "c/d":
        print "FAIL tail_range"
        bad = bad + 1
    if parts[1..].join("/") != "b/c/d":
        print "FAIL tail_range1"
        bad = bad + 1
    val m = meta().unwrap()
    if m.0 != 7 or m.1.len() != 2:
        print "FAIL result_tuple"
        bad = bad + 1
    val s = "x"
    val n: i64 = 5
    if s.marker_probe() != 1001 or n.marker_probe() != 1002 or true.marker_probe() != 1004:
        print "FAIL prim_trait"
        bad = bad + 1
    if bad == 0:
        print "PASS"
    bad
