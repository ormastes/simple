# Repro: free-function `len(x)` must resolve in HIR (hir_tui_builtin_len_resolution_2026_10_10).
# The TUI widget owners used a bare `len(...)` that closure HIR reported unresolved.
fn main() -> i64:
    val t = "abc"
    val a = [1, 2, 3, 4]
    if len(t) != 3 or len(a) != 4:
        print "FAIL free_len"
        return 1
    print "PASS free_len"
    0
