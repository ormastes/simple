class Host:
    var n: i64
impl Host:
    fn call(x: i64) -> Result<i64, text>:
        if x > 0:
            Ok(x * 2)
        else:
            Err("neg")
enum Out:
    Value(i64)
fn wrap(h: Host) -> Result<Out, text>:
    val r = h.call(4)?
    Ok(Out.Value(r))
fn main():
    val g = 105
    val w = wrap(Host(n: 0))
    match w:
        case Ok(v):
            match v:
                case Value(x):
                    if x == 8:
                        print "PASS try"
                    else:
                        print "FAIL try {x}"
        case Err(e):
            print "FAIL try err {e}"
