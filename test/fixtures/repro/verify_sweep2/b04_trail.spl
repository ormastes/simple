class Widget:
    base: i64
    static fn stat(a: i64, b: i64 = 55, c: bool = false) -> i64:
        a + b

fn main():
    val v = Widget.stat(2)
    if v == 57: print "PASS static-default"
    else: print "FAIL static-default got {v}"
    val rendered: text = "A"
    val bytes: [u8] = rendered.bytes()
    val b0 = bytes[0] as i64
    if b0 == 65: print "PASS u8-to-i64"
    else: print "FAIL u8-to-i64 got {b0}"
