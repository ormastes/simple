struct Sel:
    paths: [text]

struct T:
    id: text

class H:
    cb: Option<fn(text, text) -> text>

    fn run() -> text:
        if val f = self.cb:
            return f("a", "b")
        "none"

fn cat2(a: text, b: text) -> text:
    a + b

fn meta(ok: bool) -> Result<(u64, [u8]), text>:
    val n: u64 = 5
    val b: [u8] = [1, 2]
    if ok:
        Ok((n, b))
    else:
        Err("bad")

fn use_meta() -> Result<i64, text>:
    val (n, b) = meta(true)?
    Ok(n.to_i64() + b.len())

fn sel() -> Result<Sel, text>:
    Ok(Sel(paths: ["a", "b"]))

fn sel_use() -> Result<i64, text>:
    val s = sel()?
    var c = 0
    for p in s.paths:
        c = c + 1
    Ok(c)

fn merge(items: [T], base: T) -> [T]:
    var out: [T] = []
    var found = false
    for item in items:
        if base.id != "" and item.id == base.id:
            found = true
        else:
            out.push(item)
    out

fn main():
    val m = use_meta()
    if m.ok.?:
        print "PASS resulttuple"
    else:
        print "FAIL resulttuple"
    val s = sel_use()
    if s.ok.?:
        print "PASS resultrecord"
    else:
        print "FAIL resultrecord"
    val h = H(cb: Some(cat2))
    if h.run() == "ab":
        print "PASS optfn"
    else:
        print "FAIL optfn"
    val a: [u8] = [1, 2]
    val b: [u8] = [3]
    val c = a.concat(b)
    if c.len() == 3:
        print "PASS concat"
    else:
        print "FAIL concat"
    val mm = merge([T(id: "a"), T(id: "b")], T(id: "a"))
    if mm.len() == 1:
        print "PASS ifelse"
    else:
        print "FAIL ifelse"
