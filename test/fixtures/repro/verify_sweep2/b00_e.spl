struct Key:
    a: i64
    b: i64
struct Item:
    n: i64
fn pull(cnt: [i64]) -> text?:
    cnt.push(1)
    if cnt.len() == 1:
        Some("first")
    else:
        nil
enum Res:
    Ok(i64?)
    Err(text)
class Holder:
    var d: Dict<i64, text>
    var m: Dict<i64, [Item]>
fn mk_opt(x: i64) -> text?:
    if x > 0:
        Some("v{x}")
    else:
        nil
fn mk_res(x: i64) -> Res:
    if x > 0:
        Res.Ok(nil)
    else:
        Res.Err("e")
enum Wrap:
    Msg(text)
fn main():
    # row 30: coalesce evaluates once
    var cnt: [i64] = []
    val r = pull(cnt) ?? "none"
    if r == "first" and cnt.len() == 1:
        print "PASS coalesce"
    else:
        print "FAIL coalesce {r} {cnt.len()}"
    # row 18: trim bytes inferred
    val src = "  abc  "
    val trimmed = src.trim()
    val bs = trimmed.bytes()
    if bs.len() == 3:
        print "PASS trimbytes"
    else:
        print "FAIL trimbytes {bs.len()}"
