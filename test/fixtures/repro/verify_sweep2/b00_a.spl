struct Key:
    a: i64
    b: i64
struct Item:
    n: i64
fn pull(cnt: [i64]) -> text?:
    cnt.push(1)
    if cnt.len() == 1:
        Some("first")
    else:
        nil
enum Res:
    Ok(i64?)
    Err(text)
class Holder:
    var d: Dict<i64, text>
    var m: Dict<i64, [Item]>
fn mk_opt(x: i64) -> text?:
    if x > 0:
        Some("v{x}")
    else:
        nil
fn mk_res(x: i64) -> Res:
    if x > 0:
        Res.Ok(nil)
    else:
        Res.Err("e")
enum Wrap:
    Msg(text)
fn main():
    # row 2: .? as value bool
    val mp: text? = nil
    val sp: text? = Some("x")
    val hm: bool = mp.?
    val hs: bool = sp.?
    if hm == false and hs == true:
        print "PASS dotq"
    else:
        print "FAIL dotq {hm} {hs}"
    # row 30: coalesce evaluates once
    var cnt: [i64] = []
    val r = pull(cnt) ?? "none"
    if r == "first" and cnt.len() == 1:
        print "PASS coalesce"
    else:
        print "FAIL coalesce {r} {cnt.len()}"
    # row 18: trim bytes inferred
    val src = "  abc  "
    val trimmed = src.trim()
    val bs = trimmed.bytes()
    if bs.len() == 3:
        print "PASS trimbytes"
    else:
        print "FAIL trimbytes {bs.len()}"
    # row 11: for-in dict values
    var h = Holder(d: {}, m: {})
    h.d[1] = "a"
    h.d[2] = "b"
    var tot = 0
    for x in h.d.values():
        tot = tot + x.len()
    if tot == 2:
        print "PASS dictvalues"
    else:
        print "FAIL dictvalues {tot}"
    # row 17: optional text if-val into enum payload
    val ot = mk_opt(3)
    var w = ""
    if val present = ot:
        val wr = Wrap.Msg(present)
        match wr:
            case Msg(t):
                w = t
    if w == "v3":
        print "PASS opttext"
    else:
        print "FAIL opttext {w}"
    # row 15: dict elem untyped
    h.m[1] = [Item(n: 7), Item(n: 9)]
    val lst = h.m[1]
    val e1 = lst[1]
    if e1.n == 9:
        print "PASS dictelem"
    else:
        print "FAIL dictelem {e1.n}"
    # row 14: untyped val if-expr struct as dict key
    val flag = tot == 2
    val k = if flag: Key(a: 1, b: 2) else: Key(a: 3, b: 4)
    if k.a == 1 and k.b == 2:
        print "PASS ifstruct"
    else:
        print "FAIL ifstruct {k.a}"
    # row 12: Ok(nil) subpattern
    val rr = mk_res(1)
    match rr:
        case Ok(nil):
            print "PASS oknil"
        case Ok(_):
            print "FAIL oknil other"
        case Err(m):
            print "FAIL oknil err"
