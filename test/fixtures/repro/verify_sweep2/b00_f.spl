struct Key:
    a: i64
    b: i64
struct Item:
    n: i64
fn pull(cnt: [i64]) -> text?:
    cnt.push(1)
    if cnt.len() == 1:
        Some("first")
    else:
        nil
enum Res:
    Ok(i64?)
    Err(text)
class Holder:
    var d: Dict<i64, text>
    var m: Dict<i64, [Item]>
fn mk_opt(x: i64) -> text?:
    if x > 0:
        Some("v{x}")
    else:
        nil
fn mk_res(x: i64) -> Res:
    if x > 0:
        Res.Ok(nil)
    else:
        Res.Err("e")
enum Wrap:
    Msg(text)
fn main():
    var d: Dict<i64, text> = {}
    d[1] = "a"
    d[2] = "b"
    var tot = 0
    for x in d.values():
        tot = tot + x.len()
    if tot == 2:
        print "PASS dictvalues"
    else:
        print "FAIL dictvalues {tot}"
    var m: Dict<i64, [Item]> = {}
    m[1] = [Item(n: 7), Item(n: 9)]
    val lst = m[1]
    val e1 = lst[1]
    if e1.n == 9:
        print "PASS dictelem"
    else:
        print "FAIL dictelem {e1.n}"
    val flag = tot == 2
    val k = if flag: Key(a: 1, b: 2) else: Key(a: 3, b: 4)
    if k.a == 1 and k.b == 2:
        print "PASS ifstruct"
    else:
        print "FAIL ifstruct {k.a}"
    val rr = mk_res(1)
    match rr:
        case Ok(nil):
            print "PASS oknil"
        case Ok(_):
            print "FAIL oknil other"
        case Err(m2):
            print "FAIL oknil err"
