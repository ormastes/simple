enum Box2<T>:
    Ok(T)
    Err(text)
impl Box2<T>:
    fn code() -> i64:
        match self:
            case Ok(_): 1
            case Err(_): 2
fn main():
    val b: Box2<i64> = Box2.Ok(5)
    val c = b.code()
    if c == 1:
        print "PASS genericself"
    else:
        print "FAIL genericself {c}"
