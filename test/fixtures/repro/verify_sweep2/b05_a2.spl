fn bound_id<K>(k: K) -> K where K: Ord + Eq:
    k

enum E:
    M({text: i64})
    N(i64)

fn tail_join(parts: [text]) -> text:
    parts[1..].join("/")

fn unit_res(ok: bool) -> Result<unit, text>:
    if ok:
        Ok(())
    else:
        Err("bad")

fn dsize(e: E) -> i64:
    match e:
        case E.M(d): d.len()
        case E.N(n): n

fn main():
    if bound_id(7) == 7:
        print "PASS eqord"
    else:
        print "FAIL eqord"
    var d: Dict<text, i64> = {}
    d["a"] = 1
    d["b"] = 2
    if dsize(E.M(d)) == 2:
        print "PASS dictpayload"
    else:
        print "FAIL dictpayload"
    val j = tail_join(["x", "y", "", "z"])
    if j == "y//z":
        print "PASS tailrange"
    else:
        print "FAIL tailrange {j}"
    val r = unit_res(true)
    val r2 = unit_res(false)
    if true:
        print "PASS unitalias"
    else:
        print "FAIL unitalias"
