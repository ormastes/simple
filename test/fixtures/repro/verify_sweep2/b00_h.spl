trait Store:
    fn read(k: i64) -> i64
class MemStore:
    var base: i64
impl Store for MemStore:
    fn read(k: i64) -> i64:
        self.base + k
class Other:
    var z: i64
impl Other:
    fn read(k: i64) -> i64:
        k * 1000
class Other2:
    var z: i64
impl Other2:
    fn read(k: i64) -> i64:
        k * 2000
class Adapter:
    var store: Store
impl Adapter:
    fn get(k: i64) -> i64:
        self.store.read(k)
fn main():
    val a = Adapter(store: MemStore(base: 100))
    val o = Other(z: 0)
    val o2 = Other2(z: 0)
    val g = a.get(5)
    if g == 105:
        print "PASS traitfield"
    else:
        print "FAIL traitfield {g} {o.read(1)} {o2.read(1)}"
