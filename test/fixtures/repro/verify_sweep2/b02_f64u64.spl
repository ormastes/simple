fn half(x: f64) -> f64:
    return x / 2.0

fn h21() -> f64:
    return 21.5

fn in_range(x: u64, lo: u64, hi: u64) -> bool:
    if x < lo or x >= hi:
        return false
    return true

fn top_phys(top: u64, st: u64, v: u64) -> u64:
    val page: u64 = 4096
    val base = st - page
    if v < base or v >= st:
        return 0
    top + (v - base)

fn main():
    val a = half(7.0)
    if a == 3.5:
        print "PASS f64 half"
    else:
        print "FAIL f64 half {a}"
    val b = h21() + h21()
    if b == 43.0:
        print "PASS f64 sum"
    else:
        print "FAIL f64 sum {b}"
    val lo: u64 = 0x1000
    val hi: u64 = 0x9000_0000_0000_0000
    val x: u64 = 0x8000_0000_0000_0000
    if in_range(x, lo, hi):
        print "PASS u64 range"
    else:
        print "FAIL u64 range"
    val t = top_phys(100, 0x10000, 0xF800)
    if t == 100 + (0xF800 - 0xF000):
        print "PASS top_phys"
    else:
        print "FAIL top_phys {t}"
