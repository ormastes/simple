struct SC:
    valid: bool
    reason: text

enum V:
    Nil
    Opt(V?)
    I(i64)

fn wrap(v: V) -> V:
    val inner: V? = Some(v)
    V.Opt(inner)

fn depth(v: V) -> i64:
    match v:
        case V.Opt(i):
            if i == nil:
                return 0
            return 1
        case V.I(n):
            return n
        case V.Nil:
            return -1

fn main():
    if depth(wrap(V.I(3))) == 1:
        print "PASS valueopt"
    else:
        print "FAIL valueopt"
    val a: [u8] = [1, 2]
    val b: [u8] = [3]
    val c = a.concat(b)
    if c.len() == 3 and c[2] == 3:
        print "PASS concat"
    else:
        print "FAIL concat"
