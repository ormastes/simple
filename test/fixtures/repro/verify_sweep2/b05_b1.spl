struct T:
    id: text

fn merge(items: [T], base: T) -> [T]:
    var out: [T] = []
    var found = false
    for item in items:
        if base.id != "" and item.id == base.id:
            found = true
        else:
            out.push(item)
    out

fn main():
    val mm = merge([T(id: "a"), T(id: "b")], T(id: "a"))
    if mm.len() == 1:
        print "PASS ifelse"
    else:
        print "FAIL ifelse"
