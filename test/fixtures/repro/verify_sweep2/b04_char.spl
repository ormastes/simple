fn mk(c: i64) -> Result<char, text>:
    if c < 0: return Err("neg")
    Ok(c as char)

fn main():
    val r = mk(65)
    val ch: char = r.unwrap()
    if (ch as i64) == 65: print "PASS char-unwrap"
    else: print "FAIL char-unwrap"
    val rendered: text = "{ch}"
    val bytes: [u8] = rendered.bytes()
    val b0 = bytes[0] as i64
    if b0 == 65: print "PASS u8-to-i64"
    else: print "FAIL u8-to-i64 got {b0}"
