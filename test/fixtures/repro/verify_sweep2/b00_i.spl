class Host:
    var n: i64
impl Host:
    fn call(x: i64) -> Result<i64, text>:
        if x > 0:
            Ok(x * 2)
        else:
            Err("neg")
enum Out:
    Value(i64)
fn wrap(h: Host) -> Result<Out, text>:
    val r = h.call(4)?
    Ok(Out.Value(r))
fn opt_list(c: bool) -> [i64]?:
    if c:
        Some([1, 2, 3])
    else:
        nil
fn main():
    val g = 105
    val w = wrap(Host(n: 0))
    match w:
        case Ok(v):
            match v:
                case Value(x):
                    if x == 8:
                        print "PASS try"
                    else:
                        print "FAIL try {x}"
        case Err(e):
            print "FAIL try err {e}"
    val cached = if g == 105: opt_list(true) else: nil
    val u = cached.unwrap()
    if u.len() == 3:
        print "PASS inferredunwrap"
    else:
        print "FAIL inferredunwrap {u.len()}"
    val chained = opt_list(true).unwrap()
    if chained.len() == 3:
        print "PASS chainedunwrap"
    else:
        print "FAIL chainedunwrap {chained.len()}"
