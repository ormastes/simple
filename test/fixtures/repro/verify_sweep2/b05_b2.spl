struct Sel:
    paths: [text]

fn meta(ok: bool) -> Result<(u64, [u8]), text>:
    val n: u64 = 5
    val b: [u8] = [1, 2]
    if ok:
        Ok((n, b))
    else:
        Err("bad")

fn use_meta() -> Result<i64, text>:
    val (n, b) = meta(true)?
    Ok(n.to_i64() + b.len())

fn sel() -> Result<Sel, text>:
    var ps: [text] = []
    ps.push("a")
    ps.push("b")
    Ok(Sel(paths: ps))

fn sel_use() -> Result<i64, text>:
    val s = sel()?
    var c = 0
    for p in s.paths:
        c = c + 1
    Ok(c)

fn main():
    val m = use_meta()
    if m.ok.?:
        print "PASS resulttuple"
    else:
        print "FAIL resulttuple"
    val s = sel_use()
    if s.ok.?:
        print "PASS resultrecord"
    else:
        print "FAIL resultrecord"
