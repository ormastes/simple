class H:
    cb: Option<fn(text, text) -> text>

fn run_h(h: H) -> text:
    if val f = h.cb:
        return f("a", "b")
    "none"

fn cat2(a: text, b: text) -> text:
    a + b

fn meta(ok: bool) -> Result<(u64, [u8]), text>:
    val n: u64 = 5
    val b: [u8] = [1, 2]
    if ok:
        Ok((n, b))
    else:
        Err("bad")

fn use_meta() -> Result<i64, text>:
    val (n, b) = meta(true)?
    Ok(n.to_i64() + b.len())

fn main():
    val m = use_meta()
    if m.ok.?:
        print "PASS resulttuple"
    else:
        print "FAIL resulttuple"
    val h = H(cb: Some(cat2))
    if run_h(h) == "ab":
        print "PASS optfn"
    else:
        print "FAIL optfn"
    val a: [u8] = [1, 2]
    val b: [u8] = [3]
    val c = a.concat(b)
    if c.len() == 3:
        print "PASS concat"
    else:
        print "FAIL concat"
