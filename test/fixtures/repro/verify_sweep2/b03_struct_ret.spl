struct W3:
    ok: bool
    length: i64
    tag: i64

fn make(n: i64) -> W3:
    W3(ok: n > 0, length: n, tag: 77)

fn main():
    val inline_v = W3(ok: true, length: 3, tag: 77)
    val ret_v = make(3)
    if ret_v.length == 3 and ret_v.tag == 77 and inline_v.length == 3:
        print "PASS struct_return"
    else:
        print "FAIL struct_return len={ret_v.length} tag={ret_v.tag}"
