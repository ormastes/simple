enum DbType:
    Integer
    Text
enum DbValue:
    Integer(i64)
    Text(text)
struct Span:
    data: [i64]
    start: i64
    stop: i64
impl Span:
    fn slice(a: i64, b: i64) -> Span:
        Span(data: self.data, start: a, stop: b)
    fn size() -> i64:
        self.stop - self.start
fn main():
    val v = DbValue.Integer(5)
    match v:
        case DbValue.Integer(x):
            if x == 5:
                print "PASS enum"
            else:
                print "FAIL enum {x}"
        case DbValue.Text(t):
            print "FAIL enum text"
    val sp = Span(data: [1,2,3,4], start: 0, stop: 4)
    val sl = sp.slice(1, 3)
    if sl.size() == 2:
        print "PASS slice"
    else:
        print "FAIL slice {sl.size()}"
