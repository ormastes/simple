trait Store:
    fn read(k: i64) -> i64
class MemStore:
    var base: i64
impl Store for MemStore:
    fn read(k: i64) -> i64:
        self.base + k
class Other:
    var z: i64
impl Other:
    fn read(k: i64) -> i64:
        k * 1000
class Other2:
    var z: i64
impl Other2:
    fn read(k: i64) -> i64:
        k * 2000
class Adapter:
    var store: Store
impl Adapter:
    fn get(k: i64) -> i64:
        self.store.read(k)
class Host:
    var n: i64
impl Host:
    fn call(x: i64) -> Result<i64, text>:
        if x > 0:
            Ok(x * 2)
        else:
            Err("neg")
enum Out:
    Value(i64)
fn wrap(h: Host) -> Result<Out, text>:
    val r = h.call(4)?
    Ok(Out.Value(r))
fn opt_list(c: bool) -> [i64]?:
    if c:
        Some([1, 2, 3])
    else:
        nil
fn main():
    val a = Adapter(store: MemStore(base: 100))
    val o = Other(z: 0)
    val o2 = Other2(z: 0)
    val g = a.get(5)
    if g == 105:
        print "PASS traitfield"
    else:
        print "FAIL traitfield {g} {o.read(1)} {o2.read(1)}"
    val w = wrap(Host(n: 0))
    match w:
        case Ok(v):
            match v:
                case Value(x):
                    if x == 8:
                        print "PASS try"
                    else:
                        print "FAIL try {x}"
        case Err(e):
            print "FAIL try err {e}"
    val cached = if g == 105: opt_list(true) else: nil
    val u = cached.unwrap()
    if u.len() == 3:
        print "PASS inferredunwrap"
    else:
        print "FAIL inferredunwrap {u.len()}"
    val chained = opt_list(true).unwrap()
    if chained.len() == 3:
        print "PASS chainedunwrap"
    else:
        print "FAIL chainedunwrap {chained.len()}"
