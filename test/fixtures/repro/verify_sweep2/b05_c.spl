struct P:
    x: i64

var g_memo: i64? = None

fn set_memo(v: i64):
    g_memo = Some(v)

fn enc(v: text) -> Result<text, text>:
    Ok(v)

fn row(n: text, v: text) -> Result<text, text>:
    Ok("{n}={enc(v)?}\n")

fn mk(ok: bool) -> P?:
    if ok:
        return Some(P(x: 7))
    nil

fn use_p() -> i64?:
    val p = mk(true)?
    Some(p.x)

fn mk_arr(ok: bool) -> [u8]?:
    if ok:
        val a: [u8] = [1, 2, 3]
        return Some(a)
    nil

fn first_len() -> i64:
    val h = mk_arr(true)
    if h == nil:
        return -1
    h.len()

fn main():
    set_memo(5)
    if g_memo == Some(5):
        print "PASS global"
    else:
        print "FAIL global"
    val r = row("a", "b")
    if r.ok.? and r.unwrap() == "a=b\n":
        print "PASS interp"
    else:
        print "FAIL interp"
    val u = use_p()
    if u == Some(7):
        print "PASS opttry"
    else:
        print "FAIL opttry"
    if first_len() == 3:
        print "PASS optarr"
    else:
        print "FAIL optarr"
