class Acc:
    total: i64
    me add(a: i64, b: i64):
        self.total = self.total + a * 1000 + b

fn main():
    var a = Acc(total: 0)
    a.add(7, 3)
    if a.total == 7003:
        print "PASS me_params"
    else:
        print "FAIL me_params total={a.total}"
    val x = 5
    print "x={x}"
    val n = 5
    match n:
        Some(_): print "FAIL some_on_int accepted"
        _: print "PASS some_on_int rejected/fallthrough"
