use std.common.crypto.sha256.{sha256_u8_hex}
use app.spipe_knowledge_provider.streaming_sha256.{Sha256StreamV1}
use app.spipe_knowledge_provider.work_control.{ProviderBudgetLimitV1, ProviderBoundedBudgetV1, ProviderCheckpointProgressV1, ProviderDeterministicCheckpointV1, ProviderRequestControlHandleV1, provider_budget_category_hash_blocks}

fn deterministic_bytes(count: i64) -> [u8]:
    var bytes: [u8] = [0u8; count]
    var state = 1729
    var i = 0
    while i < count:
        state = (state * 1103515245 + 12345) & 2147483647
        bytes[i] = (state & 255).to_u8()
        i = i + 1
    bytes

fn main() -> i64:
    val payload = deterministic_bytes(4097)
    val expected = sha256_u8_hex(payload)
    var full_stream = Sha256StreamV1.begin([]).unwrap()
    var full_budget = ProviderBoundedBudgetV1.configured([ProviderBudgetLimitV1(
        category: provider_budget_category_hash_blocks(), limit: 100)]).unwrap()
    var full_checkpoint = ProviderDeterministicCheckpointV1.configured(
        ProviderRequestControlHandleV1(request_id: "REQ-SHA-PROBE-FULL",
            registration_generation: 1),
        ProviderCheckpointProgressV1(stage: "sha256", bytes: 4096,
            events: 0, scalars: 0, hash_blocks: 1, comparisons: 0),
        -1, "").unwrap()
    full_stream.update(payload, 0, payload.len(), full_budget,
        full_checkpoint).unwrap()
    val full_actual = full_stream.finish(full_budget, full_checkpoint).unwrap()
    if full_actual != expected:
        return 1
    if full_budget.consumed(provider_budget_category_hash_blocks()) != 65:
        return 2
    if full_checkpoint.checkpoint_count != 66:
        return 3

    var bounded_stream = Sha256StreamV1.begin([]).unwrap()
    var bounded_budget = ProviderBoundedBudgetV1.configured([ProviderBudgetLimitV1(
        category: provider_budget_category_hash_blocks(), limit: 100)]).unwrap()
    var bounded_checkpoint = ProviderDeterministicCheckpointV1.configured(
        ProviderRequestControlHandleV1(request_id: "REQ-SHA-PROBE-BOUNDED",
            registration_generation: 1),
        ProviderCheckpointProgressV1(stage: "sha256", bytes: 4096,
            events: 0, scalars: 0, hash_blocks: 1, comparisons: 0),
        -1, "").unwrap()
    bounded_stream.update_bounded(payload, 0, payload.len(), bounded_budget,
        bounded_checkpoint).unwrap()
    val bounded_actual = bounded_stream.finish(bounded_budget,
        bounded_checkpoint).unwrap()
    if bounded_actual != expected or bounded_actual != full_actual:
        return 4
    if bounded_budget.consumed(provider_budget_category_hash_blocks()) != 65:
        return 5
    if bounded_checkpoint.checkpoint_count != 66:
        return 6

    # A previously finalized owner rejects before chunk allocation/copy and
    # cannot publish another digest or consume more control capacity.
    var finalized_stream = Sha256StreamV1.begin([]).unwrap()
    var finalized_budget = ProviderBoundedBudgetV1.configured([
        ProviderBudgetLimitV1(category: provider_budget_category_hash_blocks(),
            limit: 10)]).unwrap()
    var finalized_checkpoint = ProviderDeterministicCheckpointV1.configured(
        ProviderRequestControlHandleV1(request_id: "REQ-SHA-PROBE-FINAL",
            registration_generation: 1),
        ProviderCheckpointProgressV1(stage: "sha256", bytes: 4096,
            events: 0, scalars: 0, hash_blocks: 1, comparisons: 0),
        -1, "").unwrap()
    finalized_stream.finish(finalized_budget, finalized_checkpoint).unwrap()
    val finalized_charge = finalized_budget.consumed(
        provider_budget_category_hash_blocks())
    val finalized_checks = finalized_checkpoint.checkpoint_count
    val finalized_total = finalized_stream.total_length
    val finalized_partial = finalized_stream.partial_length
    if finalized_stream.update_bounded([1u8], 0, 1, finalized_budget,
        finalized_checkpoint) != Err("sha256_finalized"):
        return 7
    if finalized_budget.consumed(provider_budget_category_hash_blocks()) !=
       finalized_charge or finalized_checkpoint.checkpoint_count != finalized_checks:
        return 8
    if finalized_stream.total_length != finalized_total or
       finalized_stream.partial_length != finalized_partial:
        return 9
    if finalized_stream.finish(finalized_budget,
        finalized_checkpoint) != Err("sha256_finalized"):
        return 10

    # Whole-count overflow is rejected before the first bounded chunk mutates
    # content or consumes budget/checkpoint capacity.
    var overflow_stream = Sha256StreamV1.begin([]).unwrap()
    overflow_stream.total_length = 2305843009213693951
    var overflow_budget = ProviderBoundedBudgetV1.configured([
        ProviderBudgetLimitV1(category: provider_budget_category_hash_blocks(),
            limit: 10)]).unwrap()
    var overflow_checkpoint = ProviderDeterministicCheckpointV1.configured(
        ProviderRequestControlHandleV1(request_id: "REQ-SHA-PROBE-OVERFLOW",
            registration_generation: 1),
        ProviderCheckpointProgressV1(stage: "sha256", bytes: 4096,
            events: 0, scalars: 0, hash_blocks: 1, comparisons: 0),
        -1, "").unwrap()
    if overflow_stream.update_bounded([1u8], 0, 1, overflow_budget,
        overflow_checkpoint) != Err("sha256_length_overflow"):
        return 11
    if overflow_budget.consumed(provider_budget_category_hash_blocks()) != 0 or
       overflow_checkpoint.checkpoint_count != 0:
        return 12
    if overflow_stream.total_length != 2305843009213693951 or
       overflow_stream.partial_length != 0 or overflow_stream.partial[0] != 0u8:
        return 13
    if overflow_stream.finish(overflow_budget,
        overflow_checkpoint) != Err("sha256_finalized"):
        return 14
    0
