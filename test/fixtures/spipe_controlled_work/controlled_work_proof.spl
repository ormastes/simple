# Import-safe proof for deadline-cooperative provider text work.  This fixture
# deliberately owns bytes so the clock can be observed before each bounded
# work quantum.  Production code must not claim the text wrapper is fully
# cooperative: text_to_bytes remains one bounded runtime operation.
use app.spipe_knowledge_provider.query_clock.{QueryClockPort, query_stop_reason}
use std.common.crypto.sha256_core.{sha256_initial_hash, sha256_process_block}
use std.common.string_core.{text_to_bytes, bytes_to_text}

val PROOF_MAX_INPUT_BYTES: i64 = 1048576
val PROOF_CHECK_QUANTUM_BYTES: i64 = 4096

fn proof_stop(clock: QueryClockPort, request_id: text,
              admitted_at_ms: i64, deadline_ms: i64) -> text:
    query_stop_reason(clock, request_id, admitted_at_ms, deadline_ms)

fn proof_push_ascii(out: [u8], value: text):
    val bytes = text_to_bytes(value)
    var i = 0
    while i < bytes.len():
        out.push(bytes[i])
        i = i + 1

fn proof_word_hex(value: i64) -> text:
    val digits = "0123456789abcdef"
    var out = ""
    var shift = 28
    while shift >= 0:
        val nibble = (value >> shift) & 15
        out = out + digits.slice(nibble, nibble + 1)
        shift = shift - 4
    out

fn proof_sha256_bytes_controlled(data: [u8], request_id: text,
                                 admitted_at_ms: i64, deadline_ms: i64,
                                 clock: QueryClockPort) -> Result<text, text>:
    if data.len() > PROOF_MAX_INPUT_BYTES:
        return Err("limit_exceeded")
    var state = sha256_initial_hash()
    var block: [i64] = []
    var offset = 0
    while offset < data.len():
        if offset % PROOF_CHECK_QUANTUM_BYTES == 0:
            val reason = proof_stop(clock, request_id, admitted_at_ms,
                                    deadline_ms)
            if reason != "":
                return Err(reason)
        block.push(data[offset] as i64)
        offset = offset + 1
        if block.len() == 64:
            state = sha256_process_block(state, block)
            block = []

    val tail_reason = proof_stop(clock, request_id, admitted_at_ms,
                                 deadline_ms)
    if tail_reason != "":
        return Err(tail_reason)
    block.push(128)
    if block.len() > 56:
        while block.len() < 64:
            block.push(0)
        state = sha256_process_block(state, block)
        block = []
    while block.len() < 56:
        block.push(0)
    val bit_length = data.len() * 8
    var shift = 56
    while shift >= 0:
        block.push((bit_length >> shift) & 255)
        shift = shift - 8
    state = sha256_process_block(state, block)

    val final_reason = proof_stop(clock, request_id, admitted_at_ms,
                                  deadline_ms)
    if final_reason != "":
        return Err(final_reason)
    var digest = ""
    var word_index = 0
    while word_index < state.len():
        digest = digest + proof_word_hex(state[word_index])
        word_index = word_index + 1
    Ok(digest)

fn proof_sha256_text_compatibility(data: text, request_id: text,
                                   admitted_at_ms: i64, deadline_ms: i64,
                                   clock: QueryClockPort) -> Result<text, text>:
    val bytes = text_to_bytes(data)
    proof_sha256_bytes_controlled(bytes, request_id, admitted_at_ms,
                                  deadline_ms, clock)

fn proof_json_escape_bytes_controlled(data: [u8], request_id: text,
                                      admitted_at_ms: i64,
                                      deadline_ms: i64,
                                      clock: QueryClockPort) -> Result<text, text>:
    if data.len() > PROOF_MAX_INPUT_BYTES:
        return Err("limit_exceeded")
    var out: [u8] = []
    var offset = 0
    while offset < data.len():
        if offset % PROOF_CHECK_QUANTUM_BYTES == 0:
            val reason = proof_stop(clock, request_id, admitted_at_ms,
                                    deadline_ms)
            if reason != "":
                return Err(reason)
        val byte = data[offset] as i64
        if byte == 34:
            proof_push_ascii(out, "\\\"")
        elif byte == 92:
            proof_push_ascii(out, "\\\\")
        elif byte == 8:
            proof_push_ascii(out, "\\b")
        elif byte == 9:
            proof_push_ascii(out, "\\t")
        elif byte == 10:
            proof_push_ascii(out, "\\n")
        elif byte == 12:
            proof_push_ascii(out, "\\f")
        elif byte == 13:
            proof_push_ascii(out, "\\r")
        elif byte < 32:
            val digits = "0123456789abcdef"
            proof_push_ascii(out, "\\u00")
            out.push(digits.byte_at(byte / 16) as u8)
            out.push(digits.byte_at(byte % 16) as u8)
        else:
            out.push(data[offset])
        offset = offset + 1
    val reason = proof_stop(clock, request_id, admitted_at_ms, deadline_ms)
    if reason != "":
        return Err(reason)
    Ok(bytes_to_text(out))
