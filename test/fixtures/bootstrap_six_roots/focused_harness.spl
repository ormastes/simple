# Dedicated executable proof entry: bypass the generic bootstrap coordinator.
use std.nogc_sync_mut.sffi.cli_args.{cli_get_args}
use app.cli.bootstrap_focused_native_build.{run_focused_native_build}
use compiler.driver.bootstrap_api_fixed.{aot_native_project_with_backend_fixed}
use compiler.driver.bootstrap_k1_selected.{install_selected_k1_backend_table_v1,
    selected_k1_backend_policy_v1, selected_k1_backend_table_diagnostic_v1}
use compiler.common.driver_compile_result.{compile_result_is_success, compile_result_errors}

fn main() -> i64:
    val args = cli_get_args()
    if args.len() > 1 and args[1] == "--legacy-five":
        if args.len() != 9:
            print "legacy proof requires five roots, entry and output"
            return 2
        # This compatibility API enters the driver directly, outside the
        # focused CLI boundary that normally admits the selected composition.
        if not install_selected_k1_backend_table_v1():
            print "PLUG-E-K1-POLICY: legacy proof backend composition admission failed (selected policy '{selected_k1_backend_policy_v1()}')"
            print "  k1-table: {selected_k1_backend_table_diagnostic_v1()}"
            return 1
        val result = aot_native_project_with_backend_fixed(
            args[2], args[3], args[4], args[5], args[6], 5,
            args[7], args[8], "llvm", false, false, 0, false)
        if compile_result_is_success(result):
            return 0
        for error in compile_result_errors(result):
            print error
        return 1
    run_focused_native_build(args)
