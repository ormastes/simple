schema: "simple-endpoint-network-v1"
name: "dev-build-net"
namespace: "dev"
generation: 2
addressing:
    mode: "logical-ipv4"
    cidr: "10.73.0.0/24"
discovery:
    suffix: "tools.test"
    mode: "broker"
policy:
    defaultIngress: "deny"
    defaultEgress: "deny"
    rules:
        - sourceRole: "build"
          destinationService: "compiler.tools.test"
          protocol: "tcp"
          port: 8080
          action: "deny"
        - sourceRole: "*"
          destinationService: "*"
          protocol: "tcp"
          port: 8080
          action: "allow"
