use std.spec.*
use std.io_runtime.{env_get, process_run_timeout}

fn emit_inner_red_transcript() -> bool:
    val binary = env_get("SIMPLE_TEST_BINARY") ?? ""
    if binary == "":
        return false
    val (stdout, stderr, code) = process_run_timeout(binary,
        ["run", "test/fixtures/test_runner_single/inner_red_spec.spl"], 30000)
    print stdout
    print stderr
    code != 0

describe "outer BDD result with nested child output":
    it "runs one nested red example and keeps its transcript visible":
        expect(emit_inner_red_transcript()).to_equal(true)
    it "passes one":
        expect(1).to_equal(1)
    it "passes two":
        expect(2).to_equal(2)
    it "passes three":
        expect(3).to_equal(3)
    it "passes four":
        expect(4).to_equal(4)
    it "has one outer assertion failure":
        expect(1 + 1).to_equal(3)
