# @timeout_secs 900
# @exec_limit 30000000
# @di_test
use std.spec.*
use std.nogc_sync_mut.io.env_ops.{env_get}

describe "single-lane directive inheritance":
    it "receives the declared limits and system classification":
        expect((env_get("SIMPLE_TIMEOUT_SECONDS") ?? "0").to_i64() ?? 0).to_be_greater_than(899)
        expect((env_get("SIMPLE_EXECUTION_LIMIT") ?? "0").to_i64() ?? 0).to_be_greater_than(29999999)
        expect(env_get("SIMPLE_SYSTEM_TEST") ?? "").to_equal("1")
        expect(env_get("SIMPLE_DI_TEST") ?? "").to_equal("1")
