use std.spec.*
use std.nogc_sync_mut.io.env_ops.{env_get}

describe "single-lane slow-test budget":
    it "inherits the file's slow-test budget even when slow examples are filtered":
        expect((env_get("SIMPLE_TIMEOUT_SECONDS") ?? "0").to_i64() ?? 0).to_be_greater_than(599)
    slow_it "inherits the slow-test wall-clock floor without sleeping":
        expect((env_get("SIMPLE_TIMEOUT_SECONDS") ?? "0").to_i64() ?? 0).to_be_greater_than(599)
