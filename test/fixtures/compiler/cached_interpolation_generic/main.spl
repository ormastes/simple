# Native oracle for cached generic-body interpolation substitution.
# Required stdout: cached-interpolation-generic: pass
fn render<T>(value: T) -> text:
    "value={value}"

fn main() -> i64:
    val numeric = render<i64>(3)
    if numeric != "value=3": return 1
    val textual = render<text>("ab")
    if textual != "value=ab": return 2
    print "cached-interpolation-generic: pass"
    0
