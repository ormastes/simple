use compiler.mir.mir_types.{MirTypeKind, LocalKind}
use compiler.mir.mir_instruction_support.{MirBinOp}
use compiler.backend.backend.common.type_mapper.{PrimitiveType}

fn primitive(value: PrimitiveType) -> i64:
    match value:
        case I64 | U64: 1
        case _: 0
fn integer(value: MirTypeKind) -> i64:
    match value:
        case U8 | U16 | U32 | U64: 1
        case _: 0
fn local(value: LocalKind) -> i64:
    match value:
        case Var | Temp: 1
        case _: 0
fn comparison(value: MirBinOp) -> i64:
    match value:
        case Eq | Ne | Lt | Le | Gt | Ge: 1
        case _: 0
fn main() -> i64:
    print primitive(PrimitiveType.I64)
    print primitive(PrimitiveType.U64)
    print primitive(PrimitiveType.I32)
    print integer(MirTypeKind.U8)
    print integer(MirTypeKind.U16)
    print integer(MirTypeKind.U32)
    print integer(MirTypeKind.U64)
    print integer(MirTypeKind.I64)
    print local(LocalKind.Var)
    print local(LocalKind.Temp)
    print local(LocalKind.Return)
    print comparison(MirBinOp.Eq)
    print comparison(MirBinOp.Ne)
    print comparison(MirBinOp.Lt)
    print comparison(MirBinOp.Le)
    print comparison(MirBinOp.Gt)
    print comparison(MirBinOp.Ge)
    print comparison(MirBinOp.Rem)
    0
