# Expected TYPE ERROR, never an executable PASS fixture.
# Admission requires a diagnostic for the incompatible Mask vector arguments;
# parser failure, missing runtime, missing imports, or unrelated errors do not pass.
use std.simd.fixed.{FixedVec, fixedvec_from_array}
use std.simd.mask.{Mask}

fn preserve_integer_mask(value: Mask<FixedVec<i32>>) -> Mask<FixedVec<i32>>:
    Mask.from_cmp(value)

fn reject_cross_vector_mask() -> Mask<FixedVec<f64>>:
    val values: FixedVec<i32> = fixedvec_from_array([1i32, 2i32])
    preserve_integer_mask(values.cmp_eq(values))

fn main() -> i32:
    val rejected = reject_cross_vector_mask()
    if rejected.lane_count == 2:
        return 0
    1
