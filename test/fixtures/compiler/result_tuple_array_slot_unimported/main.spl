# native-build fixture: Result<(SdnValue, Dict, [SdnIssue])> `?` in a module
# that imports only the producer function, never SdnIssue (case_events shape).
use std.common.sdn.parser.{parse_with_spans_and_issues}

fn count_issues(source: text) -> Result<i64, text>:
    val parsed = parse_with_spans_and_issues(source)?
    Ok(parsed.2.len())

fn main():
    match count_issues("[1, 2]"):
        case Ok(n): print("issues={n}")
        case Err(e): print("err={e}")
