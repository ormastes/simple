"""Rust Cranelift regression: imported struct construction, copy, and reads."""

use native_struct_aggregate_receiver_provider.{ImportedAggregatePoint, make_point}

fn score(point: ImportedAggregatePoint) -> i64:
    point.left * 10 + point.right

fn main() -> i64:
    val original = make_point(4)
    # This binding is lowered as an aggregate copy. The copied imported struct
    # must stay registered for the guarded field loads below.
    val copied = original
    val values = [copied]
    val imported = values[0]
    if imported.left != 4: return 1
    if imported.right != 5: return 2
    if score(imported) != 45: return 3
    print("cranelift-struct-aggregate-receiver-ok")
    0
