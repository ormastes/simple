enum State:
    Ready
    Closed

struct Packet:
    state: State

struct Receipt:
    packet: Packet

fn main() -> i64:
    val ready = Packet(state: State.Ready)
    val closed = Packet(state: State.Closed)
    val receipt = Receipt(packet: ready)
    if ready.state != State.Ready: return 1
    if ready.state == State.Closed: return 2
    if closed.state == ready.state: return 3
    if receipt.packet.state != State.Ready: return 4
    return 0
