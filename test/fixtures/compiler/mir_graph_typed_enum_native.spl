# Production graph helpers, not copied implementations.
extern fn rt_exit(code: i64)
use compiler.mir.mir_instruction_graph.{MirBlock, mir_fold_binop}
use compiler.mir.mir_instruction_support.{BlockId, MirTerminator, MirOperand,
    MirBinOp, mir_operand_copy, mir_operand_move, mir_operand_const_int}
use compiler.mir.mir_types.{LocalId, MirConstValue}

fn graph_return_block(value: MirOperand?) -> MirBlock:
    val terminator = MirTerminator.Ret(value)
    MirBlock(id: BlockId(id: 0), label: nil, instructions: [], terminator: terminator)

fn main() -> i64:
    val empty = graph_return_block(nil)
    if empty.bootstrap_ret_kind() != 0: rt_exit(1)
    if empty.bootstrap_ret_local_id() != -1: rt_exit(2)
    if empty.bootstrap_ret_const_kind() != 0: rt_exit(3)
    val copied = graph_return_block(Some(mir_operand_copy(LocalId(id: 4))))
    if copied.bootstrap_ret_kind() != 1 or copied.bootstrap_ret_local_id() != 4: rt_exit(4)
    val moved = graph_return_block(Some(mir_operand_move(LocalId(id: 5))))
    if moved.bootstrap_ret_kind() != 2 or moved.bootstrap_ret_local_id() != 5: rt_exit(5)
    val constant = graph_return_block(Some(mir_operand_const_int(7)))
    if constant.bootstrap_ret_kind() != 3 or constant.bootstrap_ret_const_kind() != 1: rt_exit(6)
    if constant.bootstrap_ret_const_scalar_text() != "7": rt_exit(7)
    val integer_fold: MirConstValue? = mir_fold_binop(MirBinOp.Add,
        MirConstValue.Int(3), MirConstValue.Int(4))
    if val result = integer_fold:
        val concrete: MirConstValue = result
        match concrete:
            case MirConstValue.Int(value):
                if value != 7: rt_exit(8)
            case _: rt_exit(9)
    else: rt_exit(10)
    val float_fold: MirConstValue? = mir_fold_binop(MirBinOp.Mul,
        MirConstValue.Float(2.0), MirConstValue.Float(4.0))
    if val result = float_fold:
        val concrete: MirConstValue = result
        match concrete:
            case MirConstValue.Float(value):
                if value != 8.0: rt_exit(11)
            case _: rt_exit(12)
    else: rt_exit(13)
    if mir_fold_binop(MirBinOp.Div, MirConstValue.Int(7), MirConstValue.Int(0)) != nil: rt_exit(14)
    if mir_fold_binop(MirBinOp.Add, MirConstValue.Int(7), MirConstValue.Float(1.0)) != nil: rt_exit(15)
    if mir_fold_binop(MirBinOp.Div, MirConstValue.Float(7.0), MirConstValue.Float(0.0)) != nil: rt_exit(16)
    print "mir_graph_typed_enum_native=PASS"
    0
