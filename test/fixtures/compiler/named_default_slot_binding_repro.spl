var evaluation_order: i64 = 0

fn mark(value: i64) -> i64:
    evaluation_order = evaluation_order * 10 + value
    value

fn combine(a: i64, b: i64 = 20, c: i64 = 30) -> i64:
    a * 100 + b * 10 + c

fn earlier(a: i64, b: i64 = a + 1, c: i64 = 0) -> i64:
    a * 100 + b * 10 + c

fn typed(a: i64, b: f64 = 2.5, c: bool = false) -> bool:
    a == 4 and b == 2.5 and c

fn wide(a: text, b: text = "", c: text = "", d: text = "", e: text = "", f: text = "", g: text = "", h: text = "", i: text = "", j: text = "", k: text = "", l: text = "", m: text = "", n: text = "", o: text = "", p: text = "", q: text = "") -> text:
    q

fn main() -> i64:
    if combine(1, c: 3) != 303: return 1
    if combine(1, b: 2) != 150: return 2
    if combine(c: mark(3), a: mark(1), b: mark(2)) != 123: return 3
    if evaluation_order != 312: return 4
    if earlier(5, c: 7) != 567: return 5
    if wide("head", q: "sentinel") != "sentinel": return 6
    if combine(1, 2, 3) != 123: return 7
    if not typed(4, c: true): return 8
    0
