use compiler.driver.cache.package_module_index.{
    PackageModuleIndexEntryV1, PackageModuleIndexGenerationV1,
    package_module_index_entry_action_digest_v1,
    package_module_index_entry_action_digest_v2,
    package_module_index_frame_read_v1,
    package_module_index_validate_v1,
    package_module_index_publish_if_current_v1,
    package_module_index_read_current_v1
}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.dir_ops.{dir_remove}

extern fn rt_getpid() -> i64

fn probe_entry_with_digests(entry: PackageModuleIndexEntryV1, source_digest: text, action_digest: text) -> PackageModuleIndexEntryV1:
    PackageModuleIndexEntryV1(
        entry.package_identity, entry.module_identity, entry.source_identity,
        source_digest, entry.smf_metadata_digest, entry.export_digest,
        entry.abi_digest, entry.initializer_digest, entry.provider_digest,
        action_digest, entry.manifest_digest, entry.scc_identity,
        entry.direct_imports, entry.reverse_dependents)

fn main() -> i64:
    val frame = package_module_index_frame_read_v1("3:scc", 0)
    if frame == nil:
        return 14
    if frame!.0 != "scc" or frame!.1 != 5:
        return 14
    if package_module_index_frame_read_v1("03:scc", 0) != nil or
            package_module_index_frame_read_v1("9:scc", 0) != nil or
            package_module_index_frame_read_v1("x:scc", 0) != nil:
        return 15
    val cache_root = "build/mini_builds/package-index-cas-{rt_getpid()}"
    dir_remove(cache_root, true)
    val binding = PackageModuleIndexGenerationV1(
        1, sha256_text("producer"), "root", "revision", "commit", "tree",
        sha256_text("inventory"), [], "", "")
    if not package_module_index_publish_if_current_v1(cache_root, binding, ""):
        print "initial-publish-failed: validation={package_module_index_validate_v1(binding)} root={cache_root}"
        return 1
    val bound = package_module_index_read_current_v1(cache_root)
    if not bound.valid:
        return 2
    val digest = sha256_text("source")
    val draft_entry = PackageModuleIndexEntryV1(
        "package", "module", "src/module.spl", digest, digest,
        digest, digest, digest, digest, digest, digest, "scc", [], [])
    var graph = PackageModuleIndexGenerationV1(
        2, binding.producer_digest, binding.root_generation,
        binding.scv_revision_id, binding.scv_commit_id,
        binding.scv_tree_id, binding.inventory_digest, [draft_entry],
        sha256_text("variant"), "")
    val entry = probe_entry_with_digests(draft_entry, digest,
        package_module_index_entry_action_digest_v1(graph, draft_entry))
    if entry.action_digest !=
            "df5d134fb398d2063db35e0dfb64a728817eb0312ff9ff046b9a60d8fb702340":
        return 12
    graph.entries[0] = entry
    if package_module_index_validate_v1(graph) != "ok":
        return 7
    val semantic_action = package_module_index_entry_action_digest_v2(
        graph, entry)
    if semantic_action !=
            "9f65e3a554ca2d5865f3630c68e2881510bce554eb8712d0e30b67056a0ce266":
        return 13
    var next = graph
    next.scv_revision_id = "revision-next"
    next.scv_commit_id = "commit-next"
    next.scv_tree_id = "tree-next"
    next.inventory_digest = sha256_text("inventory-next")
    if semantic_action != package_module_index_entry_action_digest_v2(
            next, entry) or
            entry.action_digest == package_module_index_entry_action_digest_v1(
                next, entry):
        return 8
    val edited = probe_entry_with_digests(entry,
        sha256_text("source-edited"), entry.action_digest)
    if semantic_action == package_module_index_entry_action_digest_v2(
            graph, edited):
        return 9
    next.variant_digest = sha256_text("variant-next")
    if semantic_action == package_module_index_entry_action_digest_v2(
            next, entry):
        return 10
    val semantic_entry = probe_entry_with_digests(entry,
        entry.source_digest, semantic_action)
    graph.entries[0] = semantic_entry
    val second_validation = package_module_index_validate_v1(graph)
    if second_validation != "ok":
        print "second-generation-validation={second_validation} graph-variant={graph.variant_digest} next-variant={next.variant_digest} entry-source={entry.source_digest} edited-source={edited.source_digest} graph-source={graph.entries[0].source_digest} entry-action={semantic_entry.action_digest} graph-action={graph.entries[0].action_digest} expected-action={package_module_index_entry_action_digest_v2(graph, graph.entries[0])}"
        return 11
    if not package_module_index_publish_if_current_v1(
            cache_root, graph, bound.digest):
        return 3
    val admitted = package_module_index_read_current_v1(cache_root)
    if not admitted.valid or admitted.generation == nil or
            admitted.generation!.entries.len() != 1:
        print "readback-failed: valid={admitted.valid} reason={admitted.reason} digest={admitted.digest} expected={package_module_index_entry_action_digest_v2(graph, graph.entries[0])}"
        return 4
    if package_module_index_publish_if_current_v1(
            cache_root, binding, bound.digest):
        return 5
    val retained = package_module_index_read_current_v1(cache_root)
    if not retained.valid or retained.digest != admitted.digest:
        return 6
    dir_remove(cache_root, true)
    print "PASS package_index_publish_cas_native_probe"
    0
