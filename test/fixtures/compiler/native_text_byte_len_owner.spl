struct ByteLengthOwner:
    value: i64

impl ByteLengthOwner:
    fn byte_len() -> i64:
        self.value

fn measured_bytes(value: text) -> i64:
    value.byte_len()

fn main() -> i64:
    val empty: text = ""
    val ascii: text = "abc"
    val unicode: text = "é🙂"
    val with_nul: text = "a\u{0}b"
    if measured_bytes(empty) != 0: return 11
    if measured_bytes(ascii) != 3: return 12
    if measured_bytes(unicode) != 6: return 13
    if measured_bytes(with_nul) != 3: return 14
    val custom = ByteLengthOwner(value: 91)
    if custom.byte_len() != 91: return 15
    print "TEXT_BYTE_LEN_BYTES_AND_OWNER_OK"
    0
