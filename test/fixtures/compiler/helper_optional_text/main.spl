use std.nogc_sync_mut.io.env_ops.{os_value_is_windows}

fn main() -> i64:
    if os_value_is_windows(nil): return 1
    if os_value_is_windows(""): return 2
    if not os_value_is_windows("Windows_NT"): return 3
    if not os_value_is_windows("wInDoWs"): return 4
    if os_value_is_windows("Linux"): return 5
    if os_value_is_windows("Darwin"): return 6
    if not os_value_is_windows("prefix-WINDOWS-suffix"): return 7
    print "helper optional text: 7 checks, 0 failures"
    0
