# Retirement gate for doc/08_tracking/bug/array_get_contract_drift_crypto_2026-10-18.md.
# Contract selected 2026-11-09 (owner decision): `a.get(i)` returns `T?` on every
# lane; `a[i]` is the direct form. A nested row must therefore be unwrapped
# before `len`/`get` are applied to it. Exit 0 = contract honoured.
fn nested_values() -> [list]:
    [[7, 11], [13]]

fn main() -> i64:
    val values = nested_values()
    match values.get(0):
        Some(first):
            if first.len() != 2:
                return 1
            match first.get(1):
                Some(v):
                    if v != 11:
                        return 2
                None:
                    return 3
        None:
            return 4
    match values.get(2):
        Some(_):
            return 5
        None:
            return 0
