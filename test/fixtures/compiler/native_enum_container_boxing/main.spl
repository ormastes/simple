# Native enum payload and native tuple projection retain runtime handles.
enum Entry:
    Text(text)
    Count(i64)
    Empty

fn text_entry() -> Result<Entry, text>:
    Ok(Entry.Text("東京"))

fn count_entry() -> Result<(Entry, i64), text>:
    Ok((Entry.Count(-42), 61))

fn empty_entry() -> Result<Entry, text>:
    Ok(Entry.Empty)

fn integer_entry() -> Result<i64, text>:
    Ok(255)

fn main() -> i64:
    var entries: Dict<text, Entry> = {}
    match text_entry():
        case Ok(value): entries["value"] = value
        case Err(_): return 1
    if not entries.contains_key("value"): return 2
    match entries["value"]:
        case Entry.Text(value):
            if value != "東京": return 3
        case _: return 4
    var ordinal: i64 = 0
    match count_entry():
        case Ok(value):
            entries["value"] = value[0]
            ordinal = value[1]
        case Err(_): return 5
    match entries["value"]:
        case Entry.Text(_): return 6
        case Entry.Count(value):
            if value != -42 or ordinal != 61: return 7
        case _: return 8
    match empty_entry():
        case Ok(value): entries["empty"] = value
        case Err(_): return 9
    match entries["empty"]:
        case Entry.Empty: ()
        case _: return 10
    if entries.contains_key("missing"): return 11
    var integers: Dict<text, i64> = {}
    match integer_entry():
        case Ok(value): integers["decoded"] = value
        case Err(_): return 12
    integers["zero"] = 0
    integers["negative"] = -42
    if integers["decoded"] != 255: return 13
    if integers["zero"] != 0: return 14
    if integers["negative"] != -42: return 15
    print "native-enum-payload-storage: Result enum and tuple variants plus integer controls PASS"
    0
