enum ProviderMode:
    Pending
    Ready

impl ProviderMode:
    fn code() -> i64:
        match self:
            ProviderMode.Pending: 11
            ProviderMode.Ready: 37

    fn label() -> text:
        match self:
            ProviderMode.Pending: "pending"
            ProviderMode.Ready: "ready"

fn main() -> i64:
    val pending = ProviderMode.Pending
    val ready = ProviderMode.Ready
    if pending.code() != 11: return 1
    if ready.code() != 37: return 2
    if pending.label() != "pending": return 3
    if ready.label() != "ready": return 4
    print "PROVIDER_CALLABLE_OPTIONAL_TYPE_PASS"
    0
