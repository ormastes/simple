pub struct Reply:
    status: i64
    stdout: text
    stderr: text

pub struct Port:
    available_fn: fn() -> bool
    scalar_fn: fn(i64) -> i64
    reply_fn: fn(i64) -> Reply

fn available() -> bool: true
fn unavailable() -> bool: false
fn plus_seven(value: i64) -> i64: value + 7
fn plus_nineteen(value: i64) -> i64: value + 19
fn respond(value: i64) -> Reply:
    Reply(status: value, stdout: "output", stderr: "errors")

pub fn plain_port(first: bool) -> Port:
    if first:
        return Port(available_fn: available, scalar_fn: plus_seven, reply_fn: respond)
    Port(available_fn: unavailable, scalar_fn: plus_nineteen, reply_fn: respond)

pub fn captured_port(base: i64) -> Port:
    val callback: fn(i64) -> Reply = \value: Reply(status: base + value, stdout: "capture-out", stderr: "capture-err")
    Port(available_fn: available, scalar_fn: plus_seven, reply_fn: callback)
