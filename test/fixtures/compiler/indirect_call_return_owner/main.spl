use other.{Reply, other_reply}
use provider.{Reply as ActualReply, Port, plain_port, captured_port}

fn check_port(port: Port, available: bool, scalar: i64) -> i64:
    if (port.available_fn)() != available: return 1
    if (port.scalar_fn)(3) != scalar: return 2
    # No identity wrapper or result type annotation may repair this call.
    val result = (port.reply_fn)(scalar)
    if result.status != scalar: return 3
    if result.stdout != "output": return 4
    if result.stderr != "errors": return 5
    0

fn main() -> i64:
    val unrelated: Reply = other_reply()
    if unrelated.stdout != "other-out" or unrelated.stderr != "other-err" or unrelated.status != 73: return 10
    var index = 0
    for port in [plain_port(true), plain_port(false)]:
        val checked = check_port(port, index == 0, if index == 0: 10 else: 22)
        if checked != 0: return 20 + checked
        index = index + 1
    val closure_port = captured_port(40)
    val captured = (closure_port.reply_fn)(2)
    if captured.status != 42: return 30
    if captured.stdout != "capture-out" or captured.stderr != "capture-err": return 31
    val alias_control = ActualReply(status: 9, stdout: "alias-out", stderr: "alias-err")
    if alias_control.status != 9 or alias_control.stderr != "alias-err": return 32
    print "indirect-call-return-owner: pass"
    0
