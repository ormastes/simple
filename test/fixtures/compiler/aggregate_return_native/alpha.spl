# Cross-module aggregate return fixture.  The public alias deliberately keeps
# the declared return spelling different from the concrete struct constructor.
struct AlphaRecord:
    value: i64

struct ThemeSnapshot:
    fingerprint: text

struct ThemePackage:
    snapshot: ThemeSnapshot
    token_map: Dict<text, text>
    widget_css_by_name: Dict<text, text>

type AlphaRecordAlias = AlphaRecord

impl AlphaRecord:
    fn plus(self, extra: i64) -> AlphaRecord:
        AlphaRecord(value: self.value + extra)

fn make_record() -> AlphaRecordAlias:
    return AlphaRecord(value: 11)

fn forward_record() -> AlphaRecordAlias:
    return make_record()

fn make_theme_package() -> ThemePackage:
    ThemePackage(
        snapshot: ThemeSnapshot(fingerprint: "aetheric"),
        token_map: {"accent": "blue"},
        widget_css_by_name: {"button": ".button-a"}
    )

export AlphaRecord, AlphaRecordAlias, ThemePackage
export make_record, forward_record, make_theme_package
