use aggregate_return_native.alpha.{AlphaRecord, ThemePackage, make_record as alpha_make_record, forward_record as alpha_forward_record, make_theme_package}
use aggregate_return_native.beta.{BetaRecord, make_record as beta_make_record, forward_record as beta_forward_record}

struct LocalOrdinalOccupier:
    marker: i64

fn check_alpha(record: AlphaRecord) -> bool:
    record.value == 11

fn check_theme(package: ThemePackage) -> bool:
    (
        package.snapshot.fingerprint == "aetheric" and
        package.token_map["accent"] == "blue" and
        package.widget_css_by_name["button"] == ".button-a"
    )

fn main() -> i64:
    # Keep local declarations ahead of the imported calls: these occupy local
    # symbol/type ordinals before the flat entry-closure calls are lowered.
    val local = LocalOrdinalOccupier(marker: 1)
    if (
        local.marker != 1 or
        not check_alpha(alpha_make_record()) or
        beta_make_record().value != 29 or
        alpha_forward_record().value != 11 or
        alpha_make_record().plus(6).value != 17 or
        beta_forward_record().value != 29 or
        not check_theme(make_theme_package()) or
        make_theme_package().snapshot.fingerprint != "aetheric"
    ):
        return 2
    print "alpha=11"
    print "beta=29"
    print "alias-tail=11"
    print "direct-method=17"
    print "beta-tail=29"
    print "theme-package=aetheric"
    0
