# Deliberately shares an exported callable name with alpha.spl.  The caller
# imports both under aliases so catalog identity must remain module-qualified.
struct BetaRecord:
    value: i64

fn make_record() -> BetaRecord:
    BetaRecord(value: 29)

fn forward_record() -> BetaRecord:
    return make_record()

export BetaRecord, make_record, forward_record
