# Minimal pure-Simple reproducer for nested aggregate scalar loss.
struct Inner:
    token: u64
    bytes: [u8]

struct Outer:
    inner: Inner

fn rebuild(source: Outer) -> Outer:
    var bytes = source.inner.bytes
    bytes[0] = 20
    var token = source.inner.token
    if bytes[0] == 20:
        token = source.inner.token + 1
    val inner = Inner(token: token, bytes: bytes)
    Outer(inner: inner)

fn rebuild_inner(source: Inner) -> Inner:
    var bytes = source.bytes
    bytes[0] = 30
    var token = source.token
    if bytes[0] == 30:
        token = source.token + 2
    Inner(token: token, bytes: bytes)

fn main():
    val result = rebuild(Outer(inner: Inner(token: 11, bytes: [0, 0])))
    print("nested-rebuild bytes={result.inner.bytes} token={result.inner.token}")
    assert result.inner.bytes == [20, 0], "nested bytes mutation was lost"
    assert result.inner.token == 12, "nested branch scalar was lost"
    val adjacent = rebuild_inner(Inner(token: 11, bytes: [0, 0]))
    assert adjacent.bytes == [30, 0], "adjacent bytes mutation was lost"
    assert adjacent.token == 13, "adjacent branch scalar was lost"

main()
