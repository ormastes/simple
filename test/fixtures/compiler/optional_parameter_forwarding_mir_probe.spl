use compiler.mir.mir_data.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.hir.hir_definitions.{HirFunction, HirParam, HirBlock, HirExpr, HirExprKind}
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.attributes.{FunctionAttr}

fn probe_span() -> Span:
    Span(start: 0, end: 0, line: 1, col: 1,
        file: "optional_parameter_forwarding.spl", length: 0)

fn optional_text_type() -> HirType:
    val inner = HirType(kind: HirTypeKind.Str, span: probe_span())
    HirType(kind: HirTypeKind.Optional(inner), span: probe_span())

fn relay_function() -> HirFunction:
    val ty = optional_text_type()
    val param_id = SymbolId(id: 1)
    val nil_expr = HirExpr(kind: HirExprKind.NilLit, has_type_: true,
        type_: ty, span: probe_span())
    val param = HirParam(symbol: param_id, name: "value", type_: ty,
        has_default: false, default: nil_expr, span: probe_span(),
        is_mutable: false)
    val value = HirExpr(kind: HirExprKind.Var(param_id), has_type_: true,
        type_: ty, span: probe_span())
    val body = HirBlock(stmts: [], has: true, value: value, span: probe_span())
    HirFunction(symbol: SymbolId(id: 200), name: "relay", type_params: [],
        params: [param], return_type: ty, body: body, effects: [],
        visibility: Visibility.Public, is_async: false, is_static: false,
        is_public: true, is_method: false, is_mutable: false,
        is_const: false, is_extern: false, func_attr: FunctionAttr.default(),
        has_export_attr: false, export_attr: nil,
        has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_suspension: false, has_vhdl_metadata: false,
        vhdl_metadata: nil, has_doc_comment: false, doc_comment: "",
        span: probe_span())

fn main() -> i64:
    val function = relay_function()
    var functions: Dict<SymbolId, HirFunction> = {}
    functions[function.symbol] = function
    val symbols = SymbolTable.new()
    val hir = HirModule(name: "optional_parameter_forwarding",
        path: "synthetic/optional_parameter_forwarding.spl", imports: [],
        exports: [], domain_blocks: [], symbols: symbols,
        functions: functions, classes: {}, structs: {}, enums: {},
        bitfields: {}, traits: {}, impls: [], constants: {},
        static_asserts: [], aop_advices: [], di_bindings: [],
        arch_rules: [], mock_decls: [], types: [])
    var lowering = MirLowering.new(symbols)
    val mir = lowering.lower_module(hir)
    if lowering.errors.len() != 0:
        print "OPTIONAL_PARAMETER_LOWERING_FAILED"
        return 1
    var found = false
    var extra_boxes = 0
    for lowered in mir.functions.values():
        if lowered.name == "relay" or lowered.name.ends_with(".relay"):
            found = true
            for block in lowered.blocks:
                for instruction in block.instructions:
                    match instruction.kind:
                        case MirInstKind.Call(_, callee, _):
                            match callee.kind:
                                case MirOperandKind.Const(MirConstValue.Str(name), _):
                                    if name == "rt_enum_new": extra_boxes = extra_boxes + 1
                                case _: ()
                        case _: ()
    if not found or extra_boxes != 0:
        print "OPTIONAL_PARAMETER_REBOXED count={extra_boxes} found={found}"
        return 2
    print "OPTIONAL_PARAMETER_MIR_PASS"
    0
