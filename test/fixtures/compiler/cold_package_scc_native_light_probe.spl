"""Strict native smoke for the lightweight cold SCC module graph."""

use std.common.crypto.sha256.{sha256_text}
use compiler.driver.cache.cold_package_scc_v1.{
    ColdPackageEdgeV1, cold_package_scc_v1
}

fn main() -> i64:
    var packages: [text] = []
    var edges: [ColdPackageEdgeV1] = []
    var index = 0
    while index < 128:
        packages.push("p{index}")
        if index > 0:
            val previous = index - 1
            edges.push(ColdPackageEdgeV1("p{previous}", "p{index}"))
        index = index + 1
    match cold_package_scc_v1(packages, edges, sha256_text("variant")):
        case Err(reason):
            print "FAIL cold-package-scc:{reason}"
            return 1
        case Ok(groups):
            if groups.len() != 128:
                print "FAIL cold-package-scc-count:{groups.len()}"
                return 2
            for group in groups:
                if group.packages.len() != 1:
                    print "FAIL cold-package-scc-members"
                    return 3
    print "PASS cold-package-scc-light"
    0
