use native_field_text_receiver_provider.{TextReceiver}

class ReceiverOwner:
    receiver: TextReceiver

fn main() -> i64:
    val owner = ReceiverOwner(receiver: TextReceiver(marker: "self"))
    val expected = "first"
    val observed = owner.receiver.combine(expected)
    if observed != "self:first":
        return 1
    if owner.receiver.combine("second") != "self:second":
        return 2
    print("field-text-receiver-ok")
    0
