"""Native behavior witness across all eight reviewed Formula name ranges."""

use app.office.sheets.formula.{_dispatch_function}
use app.office.sheets.cell.{CellValue}
use app.office.sheets.spreadsheet.{Sheet}

fn error_matches(name: text, expected: text) -> bool:
    match _dispatch_function(name, [], Sheet.new("native-dispatch")):
        CellValue.ErrorVal(message):
            message == expected
        _:
            false

fn unknown_matches() -> bool:
    match _dispatch_function("ZZZ_UNKNOWN", [[1.0]], Sheet.new("native-dispatch")):
        CellValue.ErrorVal(message):
            message == "Unknown function: ZZZ_UNKNOWN"
        _:
            false

fn main() -> i64:
    if not error_matches("ABS", "ABS requires 1 argument"):
        return 1
    if not error_matches("COS", "COS requires 1 argument"):
        return 2
    if not error_matches("EXP", "EXP requires 1 argument"):
        return 3
    if not error_matches("HOUR", "HOUR requires a non-negative serial"):
        return 4
    if not error_matches("MOD", "MOD requires 2 arguments"):
        return 5
    if not error_matches("POWER", "POWER requires 2 arguments"):
        return 6
    if not error_matches("SIN", "SIN requires 1 argument"):
        return 7
    if not error_matches("WORKDAY", "WORKDAY requires start, days"):
        return 8
    if not unknown_matches():
        return 9
    0
