# Native-build regression for admitted builders whose restricted source
# closure cannot parse lexical `unsafe(capabilities: [...])` blocks. Importing
# this facade compiles every body in io_runtime; the call also proves the safe
# public surface remains usable without exposing an unsafe requirement.
use std.nogc_sync_mut.io_runtime.{file_exists}

fn main() -> i64:
    if file_exists("src/lib/nogc_sync_mut/io_runtime.spl"):
        return 0
    1
