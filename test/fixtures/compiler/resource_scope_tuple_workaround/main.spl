use provider.tuple_metrics

fn main() -> i64:
    match tuple_metrics(false):
        case Some(_): return 1
        case nil: ()
    match tuple_metrics(true):
        case Some(pair):
            val peak = pair.0
            val cpu = pair.1
            if peak != 41 or cpu != 1: return 2
            print "{peak},{cpu}"
            return 0
        case nil: return 3
