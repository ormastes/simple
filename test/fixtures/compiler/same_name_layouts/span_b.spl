# Fixture: the other bare `TextSpan` ([value, start, len] vs span_a's
# [start, end]). See span_a.spl.

struct TextSpan:
    value: text
    start: i64
    len: i64

struct WrapB:
    span: TextSpan
    label: text

fn span_b_make(value: text, start: i64, len: i64) -> TextSpan:
    TextSpan(value: value, start: start, len: len)

fn span_b_len(span: TextSpan) -> i64:
    span.len

fn span_b_copy_len(span: TextSpan) -> i64:
    val copied = span
    copied.len

fn span_b_wrap_len(value: text, start: i64, len: i64) -> i64:
    val wrapped = WrapB(span: TextSpan(value: value, start: start, len: len), label: "w")
    val copied = wrapped
    copied.span.len

fn span_b_eq(left: TextSpan, right: TextSpan) -> bool:
    left == right

fn span_b_wrap_eq(value: text, len: i64, other_len: i64) -> bool:
    val left = WrapB(span: TextSpan(value: value, start: 1, len: len), label: "w")
    val right = WrapB(span: TextSpan(value: value, start: 1, len: other_len), label: "w")
    left == right
