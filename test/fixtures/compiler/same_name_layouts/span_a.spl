# Fixture: one of two modules declaring a bare `TextSpan` with DIFFERENT
# field lists (mirrors the Phase-3 census collision, p3_census_mir_classes_2026-11-13
# class 2). Only functions are exported so a consumer never imports the type.

struct TextSpan:
    start: i64
    end: i64

struct WrapA:
    label: text
    span: TextSpan

fn span_a_make(start: i64, end: i64) -> TextSpan:
    TextSpan(start: start, end: end)

fn span_a_end(span: TextSpan) -> i64:
    span.end

fn span_a_copy_end(span: TextSpan) -> i64:
    val copied = span
    copied.end

fn span_a_wrap_end(label: text, start: i64, end: i64) -> i64:
    val wrapped = WrapA(label: label, span: TextSpan(start: start, end: end))
    val copied = wrapped
    copied.span.end

fn span_a_eq(left: TextSpan, right: TextSpan) -> bool:
    left == right

fn span_a_wrap_eq(start: i64, end: i64, other_end: i64) -> bool:
    val left = WrapA(label: "l", span: TextSpan(start: start, end: end))
    val right = WrapA(label: "l", span: TextSpan(start: start, end: other_end))
    left == right
