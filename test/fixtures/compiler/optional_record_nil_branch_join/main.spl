# Regression for mir_optional_record_nil_join_2026_10_18.
# Native compilation must preserve the provider of the only non-nil arm.
# Qualification is pending; do not count this fixture as a passing test.
struct Seed:
    value: i64

fn optional_seed(present: bool) -> Seed?:
    if not present: return nil
    Some(Seed(17))

fn read_joined(enabled: bool, present: bool) -> i64:
    val initial = if enabled:
        optional_seed(present)
    else:
        nil
    match initial:
        case Some(seed): seed.value
        case _: -1

fn main() -> i64:
    if read_joined(true, true) != 17: return 11
    if read_joined(true, false) != -1: return 12
    if read_joined(false, true) != -1: return 13
    if read_joined(false, false) != -1: return 14
    0
