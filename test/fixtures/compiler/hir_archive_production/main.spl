# Actual producer loop/factory/lookup and real diagnostic publication failures.
use support.*
use compiler.driver.driver_hir_archive_production_controller_v1.*
use compiler.driver.cache.hir_mono_final_repository_v1.*
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.common.assurance.policy_schema.{AssuranceStrictness, ResolvedAssurancePolicyV1}
use compiler.semantics.rt_criticality.{rt_bound_manifest_replace}
use compiler.driver.driver_hir_cache.{hir_cache_last_warnings, hir_cache_clear_last_warnings, hir_cache_promote_diagnostic_owner_v1,
    hir_cache_store_in_owned_scope, hir_cache_load}
use compiler.driver.cache.hir_body_typecheck_lease_v1.{hir_body_archive_load_in_owned_scope_v1}
use std.common.crypto.sha256.{sha256_text}
use std.io_runtime.{env_get, env_set}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end, transient_promote}

fn close_fixture(paused: bool, owned: bool):
    val memo = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    if paused: hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not owned or not memo or not ended: panic("production fixture ownership")

fn prepare(path: text, name: text) -> Result<HirArchiveWeavePreparedFixtureV1, text>:
    # Source/parser/surface/provider and the RT grant come from the reviewed
    # real selected source transaction, never a synthetic archive or capability.
    val actual = hir_archive_weave_fixture_prepare_v1(path, name, name + ".alias")?
    val marker = "actual legacy warned-cache replay marker"
    val cache_key = sha256_text("production legacy warning fixture\n" + actual.archive.archive_key)
    if not transient_scope_begin(): return Err("legacy warning writer lease unavailable")
    val body = hir_body_archive_load_in_owned_scope_v1(actual.archive, actual.archive.input)
    val stored = body.is_ok() and hir_cache_store_in_owned_scope(cache_key, body.unwrap(), [marker])
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(stored) else: false
    close_fixture(paused, owned)
    if not stored or hir_cache_load(cache_key) == nil or hir_cache_last_warnings() != [marker]:
        return Err("real legacy warned cache hit did not occur")
    # Exactly the retained caller's actual cache-memo replay before the next
    # closed compilation begins. This tiny legacy body is not bounded-route proof.
    for warning in hir_cache_last_warnings(): actual.driver.ctx.add_warning(warning)
    val prior_warnings = actual.driver.ctx.warnings.len()
    if not driver_hir_archive_production_begin_v1(actual.driver): return Err("production phase-1 begin refused")
    if hir_cache_last_warnings().len() != 0 or actual.driver.ctx.warnings.len() != prior_warnings or
            actual.driver.ctx.warnings[prior_warnings - 1] != marker:
        return Err("closed begin dropped replayed ctx warning or retained stale memo")
    # Orchestration normally captures this after begin. This is the exact real
    # selected admitted owner, still verified again by journal/source factories.
    actual.driver.hir_archive_managed_runtime_selection = Some(actual.selected)
    rt_bound_manifest_replace([actual.capability])
    Ok(actual)

fn borrowed_lookup(driver: CompilerDriver) -> Result<MonoArchiveFinalRepositoryV1?, text>:
    if not transient_scope_begin(): return Err("production lookup lease unavailable")
    val selected = driver_hir_archive_production_try_repository_in_owned_scope_v1(driver)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(selected) else: false
    close_fixture(paused, owned)
    selected

fn main() -> i64:
    var checks = 0
    val saved_quiet = env_get("SIMPLE_RESOLVE_METHODS")
    val saved_levels = env_get("SIMPLE_MONO_LEVELS")
    if not env_set("SIMPLE_RESOLVE_METHODS", "0"): return 1
    val empty = CompilerDriver.create(driver_core_compile_options_default())
    val absent = borrowed_lookup(empty)
    if absent.is_err() or absent.unwrap() != nil: return 2
    checks = checks + 1
    val prepared = prepare("test/fixtures/compiler/hir_archive_production/provider.spl", "production.good")
    if prepared.is_err():
        print prepared.unwrap_err()
        return 3
    val driver = prepared.unwrap().driver
    val pending = borrowed_lookup(driver)
    if pending.is_err() or pending.unwrap() != nil: return 4
    checks = checks + 1
    val before_occupied_errors = driver.ctx.errors.len()
    if not transient_scope_begin(): return 35
    val occupied_phase3 = not driver_hir_archive_production_phase3_v1(driver)
    val caller_still_active = transient_array_scope_state_v1() == 1
    val foreign_paused = transient_scope_pause()
    val paused_phase3 = if foreign_paused: not driver_hir_archive_production_phase3_v1(driver) else: false
    val caller_still_paused = transient_array_scope_state_v1() == 2
    val occupied_end = transient_scope_end()
    if not occupied_phase3 or not caller_still_active or not foreign_paused or not paused_phase3 or
            not caller_still_paused or not occupied_end or driver.ctx.errors.len() != before_occupied_errors: return 36
    checks = checks + 1
    if not driver_hir_archive_production_phase3_v1(driver): return 5
    checks = checks + 1
    if driver.ctx.hir_modules.len() != 0 or driver.ctx.hir_module_count_value != 2 or driver.ctx.bootstrap_entry_hir != nil: return 6
    checks = checks + 1
    if driver.hir_archive_publication_journal == nil or driver.hir_archive_schedule == nil: return 7
    val journal = driver.hir_archive_publication_journal.unwrap()
    if journal.events.len() != 2 or journal.events[0].alias or not journal.events[1].alias or
            journal.logical_order != driver.hir_archive_schedule.unwrap().logical_publication_order or
            journal.events[0].archive.archive_key != journal.events[1].archive.archive_key:
        return 8
    checks = checks + 1
    if not borrowed_lookup(driver).is_err(): return 9
    checks = checks + 1
    if not driver_hir_archive_production_phase4_v1(driver, true, false): return 10
    checks = checks + 1
    val issued = borrowed_lookup(driver)
    if issued.is_err() or issued.unwrap() == nil: return 11
    val repo = issued.unwrap().unwrap()
    checks = checks + 1
    if driver.ctx.hir_modules.len() != 0 or not repo.zero_templates: return 12
    checks = checks + 1
    if not transient_scope_begin(): return 13
    val loaded = mono_archive_load_final_module_in_owned_scope_v1(driver, repo, repo.ordered_inventory[0])
    val real_body = loaded.is_ok() and loaded.unwrap().functions.len() > 0
    val occupied_finish = not driver_hir_archive_production_finish_v1(driver)
    val paused = transient_scope_pause()
    val paused_lookup = if paused: driver_hir_archive_production_try_repository_in_owned_scope_v1(driver).is_err() else: false
    val owned = if paused: transient_promote(real_body) else: false
    close_fixture(paused, owned)
    if not real_body or not occupied_finish or not paused_lookup: return 14
    checks = checks + 1
    if not driver_hir_archive_production_finish_v1(driver) or not borrowed_lookup(driver).is_err(): return 15
    checks = checks + 1
    if not transient_scope_begin(): return 16
    val old_pin_refused = not mono_archive_final_repository_matches_v1(driver, repo)
    val old_paused = transient_scope_pause()
    val old_owned = if old_paused: transient_promote(old_pin_refused) else: false
    close_fixture(old_paused, old_owned)
    if not old_pin_refused: return 17
    checks = checks + 1
    if not driver_hir_archive_production_begin_v1(driver): return 18
    val next = borrowed_lookup(driver)
    if next.is_err() or next.unwrap() != nil or driver.hir_archive_managed_runtime_selection != nil or
            driver.hir_archive_publication_journal != nil: return 19
    checks = checks + 1
    if driver_hir_archive_production_phase3_v1(driver) or not borrowed_lookup(driver).is_err(): return 20
    checks = checks + 1
    # Actual recursive specialization depth produces real mono diagnostics.
    val growing = prepare("test/fixtures/compiler/hir_archive_production/growing.spl", "production.growing")
    if growing.is_err() or not driver_hir_archive_production_phase3_v1(growing.unwrap().driver): return 21
    val growing_driver = growing.unwrap().driver
    if driver_hir_archive_production_phase4_v1(growing_driver, true, false): return 22
    if growing_driver.ctx.errors.len() == 0 or growing_driver.ctx.error_count_value != growing_driver.ctx.errors.len(): return 23
    for error in growing_driver.ctx.errors:
        if not error.starts_with("E-MONO-030:"): return 24
    checks = checks + 1
    if not borrowed_lookup(growing_driver).is_err(): return 25
    checks = checks + 1
    # A real own-type-parameter generic impl is leveled warning by retained
    # mono, but its complete unspecialized method violates robust post policy.
    if not env_set("SIMPLE_MONO_LEVELS", "E-MONO-034=warning"): return 26
    val method = prepare("test/fixtures/compiler/hir_archive_production/method.spl", "production.method")
    if method.is_err(): return 27
    val method_driver = method.unwrap().driver
    val old_policy = method_driver.ctx.assurance_policy
    method_driver.ctx.assurance_policy = ResolvedAssurancePolicyV1(..old_policy, strictness: AssuranceStrictness.Robust)
    # Policy is captured by the real producer after this actual request choice.
    if not driver_hir_archive_production_phase3_v1(method_driver): return 28
    if driver_hir_archive_production_phase4_v1(method_driver, true, false): return 29
    if method_driver.ctx.errors.len() == 0 or method_driver.ctx.error_count_value != method_driver.ctx.errors.len(): return 30
    for error in method_driver.ctx.errors:
        if not error.starts_with("E-MONO-031"): return 31
    checks = checks + 1
    if not borrowed_lookup(method_driver).is_err(): return 32
    checks = checks + 1
    if not env_set("SIMPLE_RESOLVE_METHODS", saved_quiet) or not env_set("SIMPLE_MONO_LEVELS", saved_levels): return 33
    if checks != 19 or transient_array_scope_state_v1() != 0 or hir_cache_last_warnings().len() != 0: return 34
    print "HIR actual production controller: {checks} checks passed"
    0
