fn poison_public_ast_cache_borrowed(source: SourceFile) -> Result<bool, text>:
    val changed = source.content.replace("value + 1", "69").replace("= 37", "= 99")
    if changed == source.content: return Err("fixture AST mutation source absent")
    flat_pool_capture_arm()
    val parsed = parse_and_build_module_in_borrowed_scope(changed, source.path)
    val blob = flat_pool_capture_take()
    if blob == "": return Err("fixture actual fake AST capture absent")
    if not frontend_parse_cache_store(sha256_text(source.content), blob):
        return Err("fixture public fake AST cache store refused")
    Ok(true)

fn poison_public_ast_cache(source: SourceFile) -> Result<bool, text>:
    if not frontend_parse_cache_enabled(): return Err("fixture requires actual isolated frontend cache")
    ast_prepare_persistent_owner_v1()
    val generation = parser_initialization_generation_v1()
    if not transient_scope_begin(): return Err("fixture fake AST cache lease refused")
    val result = poison_public_ast_cache_borrowed(source)
    val entered = generation != parser_initialization_generation_v1()
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val frontend = if paused: driver_promote_retained_frontend_owners_v1(entered) else: false
    val ended = driver_end_transient_parse_scope()
    if not paused or not owned or not frontend or not ended: panic("fixture fake AST cache ownership")
    result

fn source_values(module: HirModule) -> (i64, i64):
    var width = -1
    var submit = -1
    for declaration in module.structs.values():
        if declaration.name != "View": continue
        for field in declaration.fields:
            if field.name != "width" or not field.has_default: continue
            match field.default.kind:
                case HirExprKind.IntLit(value, _): width = value
                case _: pass
    for func in module.functions.values():
        if func.name != "submit_impl" or not func.body.has: continue
        match func.body.value.kind:
            case HirExprKind.IntLit(value, _): submit = value
            case _: pass
    (width, submit)

fn actual_capability(module: HirModule) -> Result<RtBoundCapability, text>:
    val declarations = rt_module_function_declarations_v1(module.name, module)
    val names = rt_unambiguous_declaration_names_v1(declarations)
    var rows: [RtCriticalFunctionFactsV1] = []
    var root = ""
    for func in module.functions.values():
        val row = rt_function_facts_v1(module.name, module, func, names)
        rows.push(row)
        if func.name == "submit_view": root = rt_stable_fn_id(row.declaration.module_key, row.declaration.symbol_id)
    if root == "": return Err("fixture actual submit_view root absent")
    Ok(RtBoundCapability(subject_id: root,
        closure_digest: rt_closure_digest(root, rt_criticality_graph_facts_v1(rows)),
        effect: RT_EFFECT_ALLOC, max_units: 0, review_id: "FIXTURE-WEAVE-ACTUAL-SUBMIT"))

fn registration(journal: DriverHirArchiveJournalV1, archive: HirBodyArchiveV1) -> Result<MonoArchiveRegistrationReceiptV1, text>:
    if not transient_scope_begin(): return Err("fixture registration lease refused")
    val loaded = hir_body_archive_load_in_owned_scope_v1(archive, archive.input)
    val result: Result<MonoArchiveRegistrationReceiptV1, text> = if loaded.is_err(): Err(loaded.unwrap_err()) else:
        mono_archive_collect_registration_in_owned_scope_v1(journal.registration, loaded.unwrap(), archive.input.module_name, archive)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val memo = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not owned or not memo or not ended: panic("fixture registration ownership")
    result

fn actual_capability_from_archive(archive: HirBodyArchiveV1) -> Result<RtBoundCapability, text>:
    if not transient_scope_begin(): return Err("fixture capability body lease refused")
    val loaded = hir_body_archive_load_in_owned_scope_v1(archive, archive.input)
    val result: Result<RtBoundCapability, text> = if loaded.is_err(): Err(loaded.unwrap_err()) else:
        actual_capability(loaded.unwrap())
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val memo = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not owned or not memo or not ended: panic("fixture capability body ownership")
    result

# Actual public mechanical store attack: source SHA, paths, claims, signatures
# and producer selection stay genuine while one complete source body changes.
fn altered_body_borrowed(archive: HirBodyArchiveV1, change_default: bool) -> Result<HirBodyArchiveV1, text>:
    var module = hir_body_archive_load_in_owned_scope_v1(archive, archive.input)?
    var changed = false
    if change_default:
        for symbol in module.structs.keys():
            val declaration = module.structs[symbol]
            if declaration.name != "View": continue
            var fields: [HirField] = []
            for field in declaration.fields:
                if field.name == "width" and field.has_default:
                    fields.push(HirField(..field, default: HirExpr(..field.default, kind: HirExprKind.IntLit(99, nil))))
                    changed = true
                else: fields.push(field)
            module.structs[symbol] = HirStruct(..declaration, fields: fields)
    else:
        for symbol in module.functions.keys():
            val func = module.functions[symbol]
            if func.name != "submit_impl" or not func.body.has: continue
            val value = HirExpr(..func.body.value, kind: HirExprKind.IntLit(69, nil))
            module.functions[symbol] = HirFunction(..func, body: HirBlock(..func.body, value: value))
            changed = true
    if not changed: return Err("fixture actual source body mutation target absent")
    hir_body_archive_store_in_owned_scope_v1(archive.input, module, [])

fn altered_body(archive: HirBodyArchiveV1, change_default: bool) -> Result<HirBodyArchiveV1, text>:
    if not transient_scope_begin(): return Err("fixture altered body lease refused")
    val result = altered_body_borrowed(archive, change_default)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val memo = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not owned or not memo or not ended: panic("fixture altered body ownership")
    result

fn public_body_attack_refused(driver: CompilerDriver, selected: DriverHirManagedRuntimeSelectionV1,
        archive: HirBodyArchiveV1, change_default: bool) -> Result<bool, text>:
    val altered = altered_body(archive, change_default)?
    if altered.input.source_content_digest != archive.input.source_content_digest or altered.body_digest == archive.body_digest:
        return Err("fixture mutation did not retain real source SHA and change complete HIR")
    val real_journal = driver.hir_archive_publication_journal
    val real_policy = driver.hir_archive_post_validation_policy
    val fake = driver_hir_archive_journal_create_v1(driver.ctx, selected)?
    val receipt = registration(fake, altered)?
    val published = driver_hir_archive_journal_publish_v1(fake, driver.ctx, 0, "weave.provider", receipt)?
    val aliased = driver_hir_archive_journal_alias_v1(fake, driver.ctx, 1, "weave.logical_alias", "weave.provider")?
    driver.hir_archive_publication_journal = Some(fake)
    driver.hir_archive_post_validation_policy = nil
    val captured_policy = driver.capture_hir_archive_post_validation_policy_v1()
    var refused = false
    if captured_policy.is_ok(): refused = driver_hir_archive_weave_boundary_capture_v1(driver).is_err()
    driver.hir_archive_publication_journal = real_journal
    driver.hir_archive_post_validation_policy = real_policy
    if captured_policy.is_err(): return Err("fixture real captured source policy attack setup refused")
    Ok(refused)

fn custody_controls(driver: CompilerDriver, archive: HirBodyArchiveV1) -> Result<i64, text>:
    if driver_hir_source_body_custody_matches_in_owned_scope_v1(driver, archive, 0):
        return Err("inactive body custody query admitted")
    var checks = 1
    val other = CompilerDriver.create(driver.ctx.options)
    other.ctx = driver.ctx
    other.streaming_module_surfaces_owner = driver.streaming_module_surfaces_owner
    other.streaming_surface_owner_ready = driver.streaming_surface_owner_ready
    other.hir_archive_managed_runtime_selection = driver.hir_archive_managed_runtime_selection
    other.hir_archive_publication_journal = driver.hir_archive_publication_journal
    other.hir_archive_schedule = driver.hir_archive_schedule
    other.hir_archive_post_validation_policy = driver.hir_archive_post_validation_policy
    if not transient_scope_begin(): return Err("fixture custody query lease refused")
    val actual = driver_hir_source_body_custody_matches_in_owned_scope_v1(driver, archive, 0)
    val foreign = driver_hir_source_body_custody_matches_in_owned_scope_v1(other, archive, 0)
    val alias = driver_hir_source_body_custody_matches_in_owned_scope_v1(driver, archive, 1)
    if not transient_scope_pause():
        val ended = transient_scope_end()
        return Err("fixture custody query pause refused")
    val paused = driver_hir_source_body_custody_matches_in_owned_scope_v1(driver, archive, 0)
    val paused_state = transient_array_scope_state_v1()
    if not transient_scope_end(): return Err("fixture custody query close refused")
    if not actual: return Err("actual closed selected lower transaction lacks custody")
    checks = checks + 1
    if foreign: return Err("distinct driver copied context forged producer identity")
    checks = checks + 1
    if alias: return Err("logical alias index replaced actual canonical producer index")
    checks = checks + 1
    if paused or paused_state != 2: return Err("paused custody query admitted or changed lease")
    checks = checks + 1
    if transient_array_scope_state_v1() != 0 or driver_hir_source_body_custody_matches_in_owned_scope_v1(driver, archive, 0):
        return Err("post-close custody query admitted or retained lease")
    checks = checks + 1
    Ok(checks)

fn observe_borrowed(accepted: DriverHirArchiveWeaveBoundaryUseV1, key: text) -> Result<WeaveObservedV1, text>:
    val loaded = driver_hir_archive_weave_boundary_load_in_owned_scope_v1(accepted, key)?
    var advice = ""
    var statements = -1
    var forwarder = true
    var default_value = -1
    for func in loaded.module.functions.values():
        if func.name != "submit_view": continue
        statements = func.body.stmts.len()
        forwarder = join_point_is_forwarder(func)
        if statements != 1: return Err("fixture expected one woven statement before original tail")
        match func.body.stmts[0].kind:
            case HirStmtKind.Expr(expr):
                match expr.kind:
                    case HirExprKind.Call(callee, _, _):
                        match callee.kind:
                            case HirExprKind.NamedVar(_, name): advice = name
                            case _: return Err("fixture advice callee is not named")
                    case _: return Err("fixture first statement is not advice call")
            case _: return Err("fixture first statement is not expression")
    for declaration in loaded.module.structs.values():
        if declaration.name != "View": continue
        for field in declaration.fields:
            if field.name != "width" or not field.has_default: continue
            match field.default.kind:
                case HirExprKind.IntLit(value, _): default_value = value
                case _: return Err("fixture original default body changed")
    Ok(WeaveObservedV1(loaded.module.name, advice, statements, forwarder, default_value, loaded.warnings))

fn observe(accepted: DriverHirArchiveWeaveBoundaryUseV1, key: text) -> Result<WeaveObservedV1, text>:
    if not transient_scope_begin(): return Err("fixture observation lease refused")
    val result = observe_borrowed(accepted, key)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended: panic("fixture woven observation ownership")
    result

# Mechanical negative census inputs below never grant genuine owner admission.
# All declarations and complete graphs come from actual source recollection.
fn gate_controls(driver: CompilerDriver, original: RtBoundCapability,
        later: RtBoundCapability) -> Result<i64, text>:
    val inputs = driver_hir_weave_inputs_v1(driver)?
    val facts = driver_hir_weave_recollect_facts_v1(driver, inputs)?
    val first = inputs.journal.logical_order[0]
    val second = inputs.journal.logical_order[1]
    val first_declaration = facts.declarations[first]
    val second_declaration = facts.declarations[second]
    val bodies = facts.bodies
    facts.declarations[first] = DriverHirArchiveWeaveDeclarationV1(..first_declaration, dropped: true)
    facts.bodies = {}
    val partial = driver_hir_archive_weave_gate_v1(inputs.policy, facts, inputs.journal.logical_order,
        inputs.layout_keys, inputs.schedule.layout_module_order, false, true)?
    if not partial.gates_skipped or partial.errors.len() != 1 or
            not partial.errors[0].contains("1 HIR module(s) lost their aggregate") or
            partial.aspect_errors.len() != 0 or partial.weave_claims.len() != 0 or
            rt_bound_manifest_capabilities().len() != 1 or rt_bound_manifest_capabilities()[0].review_id != later.review_id:
        return Err("partial census demanded body rows or consumed later RT grant")
    var checks = 1
    if not driver_hir_archive_weave_gate_v1(inputs.policy, facts, inputs.journal.logical_order,
            [], [], false).is_err(): return Err("partial census skipped physical declaration coverage")
    checks = checks + 1
    facts.declarations[second] = DriverHirArchiveWeaveDeclarationV1(..second_declaration, dropped: true)
    if not driver_hir_archive_weave_gate_v1(inputs.policy, facts, inputs.journal.logical_order,
            inputs.layout_keys, inputs.schedule.layout_module_order, false).is_err():
        return Err("all-dropped branch skipped real body coverage")
    checks = checks + 1
    facts.bodies = bodies
    val all_dropped = driver_hir_archive_weave_gate_v1(inputs.policy, facts, inputs.journal.logical_order,
        inputs.layout_keys, inputs.schedule.layout_module_order, false)?
    if all_dropped.gates_skipped or all_dropped.errors.len() != 0 or all_dropped.weave_claims.len() != 2 or
            all_dropped.census_messages.len() != 1 or not all_dropped.census_messages[0].contains("test is unreliable") or
            rt_bound_manifest_capabilities()[0].review_id != later.review_id:
        return Err("all-dropped did not execute actual graph gates")
    checks = checks + 1
    facts.declarations[first] = first_declaration
    facts.declarations[second] = second_declaration
    val mismatches = [RtBoundCapability(..original, subject_id: "different actual subject"),
        RtBoundCapability(..original, closure_digest: sha256_text("different closure")),
        RtBoundCapability(..original, effect: original.effect + 1),
        RtBoundCapability(..original, max_units: original.max_units + 1),
        RtBoundCapability(..original, review_id: "different review")]
    for changed in mismatches:
        rt_bound_manifest_replace([changed])
        val rejected = driver_hir_archive_weave_gate_v1(inputs.policy, facts, inputs.journal.logical_order,
            inputs.layout_keys, inputs.schedule.layout_module_order, false, true)?
        if rejected.errors.len() != 1 or not rejected.errors[0].contains("original RT capability manifest differs") or
                rt_bound_manifest_capabilities().len() != 1 or rt_bound_manifest_capabilities()[0].review_id != changed.review_id:
            return Err("changed complete capability was admitted or consumed")
        checks = checks + 1
    rt_bound_manifest_replace([original, later])
    val extra = driver_hir_archive_weave_gate_v1(inputs.policy, facts, inputs.journal.logical_order,
        inputs.layout_keys, inputs.schedule.layout_module_order, false, true)?
    if extra.errors.len() != 1 or rt_bound_manifest_capabilities().len() != 2:
        return Err("different capability cardinality was consumed")
    checks = checks + 1
    rt_bound_manifest_replace([original])
    val consumed = driver_hir_archive_weave_gate_v1(inputs.policy, facts, inputs.journal.logical_order,
        inputs.layout_keys, inputs.schedule.layout_module_order, false, true)?
    if consumed.errors.len() != 0 or rt_bound_manifest_capabilities().len() != 0:
        return Err("genuine original manifest not consumed at no-claim RT gate")
    checks = checks + 1
    rt_bound_manifest_replace([later])
    val replay = driver_hir_archive_weave_gate_v1(inputs.policy, facts, inputs.journal.logical_order,
        inputs.layout_keys, inputs.schedule.layout_module_order, false)?
    if replay.errors.len() != 0 or rt_bound_manifest_capabilities().len() != 1 or
            rt_bound_manifest_capabilities()[0].review_id != later.review_id:
        return Err("default replay consumed future grant")
    checks = checks + 1
    Ok(checks)

