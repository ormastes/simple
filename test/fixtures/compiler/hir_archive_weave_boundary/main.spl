fn semantic_prerequisite_controls(driver: CompilerDriver, boundary: DriverHirArchiveWeaveBoundaryV1,
        name: text) -> Result<i64, text>:
    val captured = driver_hir_archive_semantic_prerequisite_capture_v1(driver, boundary)?
    val actual = driver_hir_archive_semantic_prerequisite_use_v1(driver, boundary, captured)?
    if actual.prerequisite.stage != "streaming-woven-semantic-prerequisite-v1" or
            actual.weave_use.declaration_order != [name] or
            actual.weave_use.boundary_key != boundary.use.boundary_key:
        return Err("semantic prerequisite actual streaming parent differs")
    var checks = 1
    val fabricated_passes = DriverHirArchiveSemanticPrerequisiteV1(..captured,
        stage: "nonstreaming-four-pass-clean-v1")
    if not driver_hir_archive_semantic_prerequisite_use_v1(driver, boundary, fabricated_passes).is_err():
        return Err("semantic prerequisite accepted fabricated nonstreaming clean passes")
    checks = checks + 1
    val absent_pin = DriverHirArchiveSemanticPrerequisiteV1(..captured,
        artifact_key: sha256_text("unissued semantic prerequisite"))
    if not driver_hir_archive_semantic_prerequisite_use_v1(driver, boundary, absent_pin).is_err():
        return Err("semantic prerequisite accepted an unissued public owner")
    checks = checks + 1
    driver.ctx.config["coverage"] = "1"
    val unsupported = driver_hir_archive_semantic_prerequisite_capture_v1(driver, boundary).is_err()
    driver.ctx.config.remove("coverage")
    if not unsupported or driver_hir_archive_semantic_prerequisite_use_v1(driver, boundary, captured).is_err():
        return Err("semantic prerequisite lost actual route refusal or restored streaming parent")
    checks = checks + 1
    val other = CompilerDriver.create(driver_core_compile_options_default())
    other.ctx = driver.ctx
    if not transient_scope_begin(): return Err("semantic prerequisite borrowed control lease refused")
    val original = driver_hir_archive_semantic_prerequisite_matches_in_owned_scope_v1(driver, captured)
    val copied = driver_hir_archive_semantic_prerequisite_matches_in_owned_scope_v1(other, captured)
    if original.is_err() or copied.is_ok():
        transient_scope_pause()
        transient_scope_end()
        return Err("semantic prerequisite did not distinguish actual driver from copied context")
    checks = checks + 1
    if not transient_scope_pause(): return Err("semantic prerequisite foreign pause refused")
    if not driver_hir_archive_semantic_prerequisite_matches_in_owned_scope_v1(driver, captured).is_err() or
            transient_array_scope_state_v1() != 2:
        transient_scope_end()
        return Err("semantic prerequisite borrowed validator changed foreign paused lease")
    checks = checks + 1
    if not driver_hir_archive_semantic_prerequisite_capture_v1(driver, boundary).is_err() or
            not driver_hir_archive_semantic_prerequisite_use_v1(driver, boundary, captured).is_err() or
            transient_array_scope_state_v1() != 2 or not transient_scope_end():
        return Err("semantic prerequisite closed APIs changed foreign lease")
    checks = checks + 1
    if driver_hir_archive_semantic_prerequisite_use_v1(driver, boundary, captured).is_err() or
            transient_array_scope_state_v1() != 0:
        return Err("semantic prerequisite lost post-close parent")
    checks = checks + 1
    Ok(checks)

# Exercise production input admission with the genuinely published owners.
# Every mutation is restored before the next independent negative control.
fn source_binding_controls(driver: CompilerDriver) -> Result<i64, text>:
    val actual = driver_hir_weave_inputs_v1(driver)?
    val journal = actual.journal
    val schedule = actual.schedule
    val policy = actual.policy
    if journal.source_binding == schedule.source_binding or
            policy.source_binding != schedule.source_binding:
        return Err("fixture source digest domains or policy owner differ")
    val journal_source = journal.source_binding
    journal.source_binding = sha256_text("tampered actual journal source binding")
    val journal_refused = driver_hir_weave_inputs_v1(driver).is_err()
    journal.source_binding = journal_source
    if not journal_refused or driver_hir_weave_inputs_v1(driver).is_err():
        return Err("fixture journal source tamper accepted or restore failed")
    driver.hir_archive_schedule = Some(DriverHirArchiveScheduleV1(..schedule,
        source_binding: sha256_text("tampered actual schedule source binding")))
    val schedule_refused = driver_hir_weave_inputs_v1(driver).is_err()
    driver.hir_archive_schedule = Some(schedule)
    if not schedule_refused or driver_hir_weave_inputs_v1(driver).is_err():
        return Err("fixture schedule source tamper accepted or restore failed")
    driver.hir_archive_post_validation_policy = Some(DriverHirPostValidationPolicyOwnerV1(..policy,
        source_binding: sha256_text("tampered policy schedule source binding")))
    val policy_refused = driver_hir_weave_inputs_v1(driver).is_err()
    driver.hir_archive_post_validation_policy = Some(policy)
    if not policy_refused or driver_hir_weave_inputs_v1(driver).is_err():
        return Err("fixture policy source tamper accepted or restore failed")
    driver.hir_archive_post_validation_policy = Some(DriverHirPostValidationPolicyOwnerV1(..policy,
        journal_key: sha256_text("tampered policy journal key")))
    val key_refused = driver_hir_weave_inputs_v1(driver).is_err()
    driver.hir_archive_post_validation_policy = Some(policy)
    if not key_refused or driver_hir_weave_inputs_v1(driver).is_err():
        return Err("fixture journal predecessor tamper accepted or restore failed")
    driver.hir_archive_post_validation_policy = Some(DriverHirPostValidationPolicyOwnerV1(..policy,
        schedule_digest: sha256_text("tampered policy schedule digest")))
    val digest_refused = driver_hir_weave_inputs_v1(driver).is_err()
    driver.hir_archive_post_validation_policy = Some(policy)
    if not digest_refused or driver_hir_weave_inputs_v1(driver).is_err():
        return Err("fixture schedule predecessor tamper accepted or restore failed")
    Ok(6)

fn main() -> i64:
    val selected_result = driver_hir_capture_managed_runtime_selection_v1("llvm",
        env_get("SIMPLE_NATIVE_BUILD_TARGET"), env_get("SIMPLE_NATIVE_RUNTIME_BUNDLE"))
    if selected_result.is_err(): return 1
    val selected = selected_result.unwrap()
    val path = "test/fixtures/compiler/hir_archive_weave_boundary/provider.spl"
    val name = "weave.provider"
    val alias_name = "weave.logical_alias"
    val loaded_source = SourceFile.load(path)
    val alternate = SourceFile.load("./" + path)
    if loaded_source.is_err() or alternate.is_err(): return 2
    val source = SourceFile(..loaded_source.unwrap(), module_name: name)
    val alias = SourceFile(..alternate.unwrap(), module_name: alias_name)
    if source.authored_path == alias.authored_path or source.content != alias.content: return 3
    val poisoned = poison_public_ast_cache(source)
    if poisoned.is_err(): return 43
    val calls_before_cached_control = flat_parse_module_body_calls()
    val hits_before_cached_control = frontend_parse_cache_hits()
    val parsed = parse_full_frontend(source.content, path, name, Logger(level: 0))
    var untrusted_lowerer = HirLowering.with_filename(path)
    val untrusted = untrusted_lowerer.lower_parser_module_unstub(parsed, false)
    val altered_values = source_values(untrusted)
    if altered_values.0 != 99 or altered_values.1 != 69 or
            flat_parse_module_body_calls() != calls_before_cached_control or
            frontend_parse_cache_hits() != hits_before_cached_control + 1: return 44
    val builder = ModuleSurfaceBuilder.new()
    if builder.add_parsed(parsed, source, 0).is_err() or builder.add_alias(alias).is_err(): return 4
    val surfaces = ModuleSurfacesByName.empty()
    if builder.finish_into(surfaces) != "": return 5
    val driver = CompilerDriver.create(driver_core_compile_options_default())
    driver.ctx.options.low_memory = true
    driver.ctx.options.cli_mode_text = "aot"
    driver.ctx.config["compiler_source_entry"] = source.path
    driver.ctx.native_target = selected.target
    driver.hir_archive_managed_runtime_selection = Some(selected)
    driver.ctx.source_paths_owner = [source.path, alias.path]
    driver.ctx.source_authored_paths_owner = [source.authored_path, alias.authored_path]
    driver.ctx.source_module_names_owner = [name, alias_name]
    driver.ctx.source_contents_owner = [source.content, alias.content]
    driver.ctx.source_identities_owner = [sha256_text(source.content), sha256_text(source.content)]
    driver.ctx.source_byte_lengths_owner = [source.content.len(), source.content.len()]
    val raw_hash = rt_hash_text(source.content)
    val retained_hash = if raw_hash == 0: 1 else: raw_hash
    driver.ctx.source_content_hashes_owner = [retained_hash, retained_hash]
    driver.streaming_module_surfaces_owner = surfaces
    driver.streaming_surface_owner_ready = true
    driver.streaming_entry_source_index_owner = -1
    val schedule_result = driver.capture_hir_archive_streaming_schedule_v1()
    if schedule_result.is_err(): return 6
    val schedule = schedule_result.unwrap()
    val journal_result = driver_hir_archive_journal_create_v1(driver.ctx, selected)
    if journal_result.is_err(): return 9
    val journal = journal_result.unwrap()
    driver.hir_archive_publication_journal = Some(journal)
    # Accepted positive originates in the actual selected read/parse/lower
    # transaction. A public store of an independently edited HIR is not used.
    # Even a caller lowerer already fed the poisoned cache cannot become the
    # actual source producer. The controller owns its own genuine lowerer.
    untrusted_lowerer.module_surfaces = ModuleSurfacesByName.empty()
    val calls_before_actual_transaction = flat_parse_module_body_calls()
    val transaction = driver.lower_streaming_hir_selected_archived_shard_transaction_v1(
        untrusted_lowerer, source, 0, false, journal.registration)
    if transaction.is_err(): return 7
    val completed = transaction.unwrap()
    if completed.status != 1 or completed.archive == nil or completed.declaration_registration == nil: return 8
    if flat_parse_module_body_calls() < calls_before_actual_transaction + 2: return 45
    val archive = completed.archive.unwrap()
    if driver_hir_archive_journal_publish_v1(journal, driver.ctx, 0, name,
            completed.declaration_registration.unwrap()).is_err(): return 10
    if driver_hir_archive_journal_alias_v1(journal, driver.ctx, 1, alias_name, name).is_err(): return 11
    val granted = actual_capability_from_archive(archive)
    if granted.is_err(): return 38
    rt_bound_manifest_replace([granted.unwrap()])
    if driver.capture_hir_archive_post_validation_policy_v1().is_err(): return 12
    val binding_controls = source_binding_controls(driver)
    if binding_controls.is_err():
        print "weave source binding controls failed: {binding_controls.unwrap_err()}"
        return 54
    if binding_controls.unwrap() != 6: return 55
    val captured = driver_hir_archive_weave_boundary_capture_v1(driver)
    if captured.is_err():
        print "weave capture failed: {captured.unwrap_err()}"
        return 13
    val boundary = captured.unwrap()
    var checks = 2
    val registered = registered_gate_report(boundary)
    if boundary.woven_count != 1 or boundary.gate_report.weave_claims.len() != 2 or
            boundary.gate_report.errors.len() != 0 or boundary.gate_report.gates_skipped or
            registered.is_err() or registered.unwrap().errors.len() != 0 or
            registered.unwrap().weave_claims.len() != 2 or registered.unwrap().gates_skipped: return 14
    checks = checks + 1
    if rt_bound_manifest_capabilities().len() != 0: return 15
    checks = checks + 1
    val used = driver_hir_archive_weave_boundary_use_v1(driver, boundary)
    if used.is_err(): return 16
    val accepted = used.unwrap()
    if accepted.declaration_order != [name] or accepted.logical_order != [name, alias_name] or
            accepted.physical_module_keys != [archive.input.module_name] or
            accepted.physical_inventory.logical_rows[1].authored_path != alias.authored_path or
            accepted.physical_inventory.representative_indices != [0]: return 17
    checks = checks + 1
    val canonical_observed = observe(accepted, name)
    val alias_observed = observe(accepted, alias_name)
    if canonical_observed.is_err() or alias_observed.is_err(): return 18
    val actual = canonical_observed.unwrap()
    val alias_actual = alias_observed.unwrap()
    if actual.advice_name != "trace_first" or actual.statements != 1 or actual.forwarder or actual.default_value != 37 or
            actual.warnings.len() != 0 or alias_actual.advice_name != actual.advice_name or
            alias_actual.default_value != 37 or alias_actual.warnings != actual.warnings: return 19
    checks = checks + 1
    if accepted.logical_frames[name].artifact_key != accepted.logical_frames[alias_name].artifact_key or
            accepted.logical_frames[name].body_digest == archive.body_digest: return 20
    checks = checks + 1
    # A later compilation's real grant is untouched by read-use replay.
    val next_grant = RtBoundCapability(..granted.unwrap(), review_id: "FIXTURE-NEXT-COMPILATION")
    rt_bound_manifest_replace([next_grant])
    val repeated = driver_hir_archive_weave_boundary_use_v1(driver, boundary)
    if repeated.is_err() or repeated.unwrap().boundary_key != accepted.boundary_key or
            rt_bound_manifest_capabilities().len() != 1 or rt_bound_manifest_capabilities()[0].review_id != next_grant.review_id:
        return 21
    checks = checks + 1
    if observe(accepted, alias_name).is_err(): return 22
    checks = checks + 1
    val wrong_report = DriverHirArchiveWeaveBoundaryV1(..boundary, woven_count: 0)
    if not driver_hir_archive_weave_boundary_use_v1(driver, wrong_report).is_err() or
            not registered_gate_report(wrong_report).is_err(): return 23
    checks = checks + 1
    val wrong_policy = DriverHirArchiveWeaveBoundaryV1(..boundary,
        policy: DriverHirPostValidationPolicyOwnerV1(..boundary.policy, artifact_digest: sha256_text("different policy")))
    if not driver_hir_archive_weave_boundary_use_v1(driver, wrong_policy).is_err(): return 24
    checks = checks + 1
    val wrong_pin = DriverHirArchiveWeaveBoundaryUseV1(..accepted, boundary_key: sha256_text("unregistered owner"))
    if not observe(wrong_pin, name).is_err(): return 25
    checks = checks + 1
    val wrong_warning = DriverColdHirWeaveBodyV1(..accepted.logical_frames[name], warnings_digest: sha256_text("dropped warning"))
    val wrong_frame = DriverHirArchiveWeaveBoundaryUseV1(..accepted, logical_frames: {name: wrong_warning, alias_name: wrong_warning})
    if not observe(wrong_frame, name).is_err(): return 26
    checks = checks + 1
    val wrong_order = DriverHirArchiveWeaveBoundaryUseV1(..accepted, logical_order: [alias_name, name])
    if not observe(wrong_order, name).is_err(): return 27
    checks = checks + 1
    val old_author = driver.ctx.source_authored_paths_owner[1]
    driver.ctx.source_authored_paths_owner[1] = source.authored_path
    val alias_refused = driver_hir_archive_weave_boundary_use_v1(driver, boundary).is_err()
    driver.ctx.source_authored_paths_owner[1] = old_author
    if not alias_refused or driver_hir_archive_weave_boundary_use_v1(driver, boundary).is_err(): return 28
    checks = checks + 1
    val old_identity = driver.ctx.source_identities_owner[0]
    driver.ctx.source_identities_owner[0] = sha256_text("changed captured physical bytes")
    val source_refused = driver_hir_archive_weave_boundary_use_v1(driver, boundary).is_err()
    driver.ctx.source_identities_owner[0] = old_identity
    if not source_refused or driver_hir_archive_weave_boundary_use_v1(driver, boundary).is_err(): return 29
    checks = checks + 1
    val old_backend = driver.ctx.options.backend
    driver.ctx.options.backend = "interpreter"
    val config_refused = driver_hir_archive_weave_boundary_use_v1(driver, boundary).is_err()
    driver.ctx.options.backend = old_backend
    if not config_refused or driver_hir_archive_weave_boundary_use_v1(driver, boundary).is_err(): return 30
    checks = checks + 1
    if not transient_scope_begin() or not transient_scope_pause(): return 31
    val foreign = driver_hir_archive_weave_boundary_use_v1(driver, boundary).is_err()
    val borrowed = driver_hir_archive_weave_boundary_load_in_owned_scope_v1(accepted, name).is_err()
    if not foreign or not borrowed or transient_array_scope_state_v1() != 2 or not transient_scope_end(): return 32
    checks = checks + 1
    if observe(accepted, name).is_err() or transient_array_scope_state_v1() != 0: return 33
    checks = checks + 1
    if checks != 19: return 34
    val controls = gate_controls(driver, granted.unwrap(), next_grant)
    if controls.is_err():
        print "weave gate controls failed: {controls.unwrap_err()}"
        return 35
    if controls.unwrap() != 12: return 36
    checks = checks + controls.unwrap()
    if checks != 31: return 37
    # The source-body producer proof rejects both attacks even though their
    # genuine source claims and every public journal/artifact seal agree.
    rt_bound_manifest_replace([granted.unwrap()])
    val body_attack = public_body_attack_refused(driver, selected, archive, false)
    if body_attack.is_err() or not body_attack.unwrap(): return 39
    checks = checks + 1
    val default_attack = public_body_attack_refused(driver, selected, archive, true)
    if default_attack.is_err() or not default_attack.unwrap(): return 40
    checks = checks + 1
    if observe(accepted, name).is_err() or driver_hir_archive_weave_boundary_use_v1(driver, boundary).is_err(): return 41
    checks = checks + 1
    if checks != 34: return 42
    val custody = custody_controls(driver, archive)
    if custody.is_err():
        print "actual source body custody controls failed: {custody.unwrap_err()}"
        return 46
    if custody.unwrap() != 6: return 47
    checks = checks + custody.unwrap()
    if checks != 40: return 48
    # An independently authored logical alias cannot replace the genuine
    # first physical declaration label even though it shares complete HIR.
    val wrong_declarations = DriverHirArchiveWeaveBoundaryUseV1(..accepted, declaration_order: [alias_name])
    if not observe(wrong_declarations, name).is_err() or observe(accepted, name).is_err(): return 49
    checks = checks + 1
    if checks != 41: return 50
    val semantics = semantic_prerequisite_controls(driver, boundary, name)
    if semantics.is_err():
        print "actual streaming semantic prerequisite controls failed: {semantics.unwrap_err()}"
        return 51
    if semantics.unwrap() != 8: return 52
    checks = checks + semantics.unwrap()
    if checks != 49: return 53
    checks = checks + binding_controls.unwrap()
    if checks != 55: return 56
    print "HIR archive weave boundary: {checks} checks passed"
    0
