@layer_eq(Device)
struct View:
    @layer_field(w)
    width: i64 = 37

struct Device:
    w: i64

struct Blob:
    a: i64
    b: i64
    c: i64

fn helper(src: Blob) -> i64:
    val duplicate: Blob = src
    duplicate.a

@copy_budget(32)
fn outer(src: Blob) -> i64:
    helper(src)

fn submit_impl(value: i64) -> i64:
    value + 1

fn submit_view(value: i64) -> i64:
    submit_impl(value)

@advice(forward, submit_view)
@readonly
@noalloc
@bounded_time
fn trace_first():
    val first_marker: i64 = 37

@advice(forward, submit_view)
@readonly
@noalloc
@bounded_time
fn trace_second():
    val second_marker: i64 = 69
