# Expected failure: E-CHAR-FOREIGN-ABI. UNRUN; normal return is a regression.
use compiler.backend.common.c_abi_type_mapping.{c_abi_map_type}
use compiler.mir.mir_types.{MirType, MirTypeKind}

fn main() -> i64:
    val spelling = c_abi_map_type(MirType(kind: MirTypeKind.Char))
    panic("CHAR-ABI-REFUSAL-MISSING: mapper returned " + spelling)
    1
