# Bootstrap syntax regression for the two archive-owner declarations.
# AUTHORED_UNEXECUTED: this does not qualify the real archive/lease owners.
fn retained_pair(binding: text, digest: text) -> Result<(text, text), text>:
    val result: Result<(text, text), text> = if binding == "" or digest == "":
        Err("HIR journal retained source or registration predecessor incomplete")
    else:
        Ok((binding, digest))
    result

fn load_selected(value: i64) -> Result<i64, text>:
    if value < 0: return Err("selected load failed")
    Ok(value + 1)

fn selected_input(input_result: Result<i64, text>) -> Result<i64, text>:
    val loaded: Result<i64, text> = if input_result.is_ok():
        load_selected(input_result.unwrap())
    else:
        Err("mono selected input unavailable")
    loaded

fn main() -> i64:
    val empty_binding = retained_pair("", "digest")
    if not empty_binding.is_err(): return 1
    if empty_binding.unwrap_err() != "HIR journal retained source or registration predecessor incomplete": return 2
    val empty_digest = retained_pair("binding", "")
    if not empty_digest.is_err(): return 3
    if empty_digest.unwrap_err() != "HIR journal retained source or registration predecessor incomplete": return 4
    val pair = retained_pair("binding", "digest")
    if not pair.is_ok(): return 5
    if pair.unwrap().0 != "binding" or pair.unwrap().1 != "digest": return 6
    # Err input must not evaluate the true arm's unwrap().
    val absent = selected_input(Err("input absent"))
    if not absent.is_err(): return 7
    if absent.unwrap_err() != "mono selected input unavailable": return 8
    val present = selected_input(Ok(7))
    if not present.is_ok(): return 9
    if present.unwrap() != 8: return 10
    val failed_load = selected_input(Ok(-1))
    if not failed_load.is_err(): return 11
    if failed_load.unwrap_err() != "selected load failed": return 12
    print "BOOTSTRAP_MULTILINE_RESULT_IF_PASS cases=6 checks=12"
    0
