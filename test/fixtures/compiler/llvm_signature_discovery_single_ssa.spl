# Compile and execute with the same normal-AOT producer before/after the
# signature-pass change. Expected stdout is the six lines below, in order:
# 10
# 7
# true
# retained text
# 3
# void body
fn main():
    print sum_loop(5)
    print choose_value(false)
    print choose_flag(true)
    print choose_text(false)
    val values = choose_array(true)
    print values[1]
    void_body()

fn sum_loop(limit: i64) -> i64:
    var index = 0
    var total = 0
    while index < limit:
        total = total + index
        index = index + 1
    total

fn choose_value(first: bool) -> i64:
    if first: 11 else: 7

fn choose_flag(first: bool) -> bool:
    if first: true else: false

fn choose_text(first: bool) -> text:
    if first: "other text" else: "retained text"

fn choose_array(first: bool) -> [i64]:
    if first: [2, 3] else: [5, 7]

fn void_body():
    print "void body"
