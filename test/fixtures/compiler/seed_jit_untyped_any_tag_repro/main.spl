# Repro for doc/08_tracking/bug/seed_jit_untyped_to_u8_push_double_untag_2026-10-18.md.
# Expected (interpreter): untyped=[[99]] typed=[[99]] i64=[[99]] rev=142 rev2=142
# Seed JIT (9c45d2bf601ab93e): untyped=[[12]] i64=[[12]] rev=<huge> - an untyped value
# taken from an [Any] slot keeps its tag when pushed or passed to a typed param.

fn push_untyped(bs, v: i64) -> [Any]:
    var bytes = bs[0]
    bytes.push(v.to_u8())
    return [bytes]

fn push_typed(bs, v: i64) -> [Any]:
    var bytes: [u8] = bs[0]
    bytes.push(v.to_u8())
    return [bytes]

fn push_i64(bs, v: i64) -> [Any]:
    var bytes = bs[0]
    bytes.push(v)
    return [bytes]

fn code_len() -> [Any]:
    return [113, 8]

fn rev(code: i64, n: i64) -> i64:
    var r = 0
    var i = 0
    while i < n:
        r = (r << 1) | ((code >> i) & 1)
        i = i + 1
    r

fn main():
    var e1: [u8] = []
    var e2: [u8] = []
    var e3: [u8] = []
    print "untyped={push_untyped([e1], 99)} typed={push_typed([e2], 99)} i64={push_i64([e3], 99)}"
    val ci = code_len()
    val c: i64 = ci[0]
    val n: i64 = ci[1]
    print "rev={rev(ci[0], ci[1])} rev2={rev(c, n)}"
