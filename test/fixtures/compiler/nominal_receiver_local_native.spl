# Local side of the AtomicI64 receiver provenance discriminator. No imports/FFI.
class GateCell:
    value: i64

    fn load() -> i64:
        self.value

    fn compare_exchange(expected: i64, replacement: i64) -> bool:
        self.value == expected and replacement == 1

fn make_gate() -> GateCell:
    GateCell(value: 0)

fn main() -> i64:
    var gate: GateCell = make_gate()
    if gate.load() != 0: return 1
    if not gate.compare_exchange(0, 1): return 2
    0
