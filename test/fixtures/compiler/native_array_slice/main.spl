# Compile and execute with the candidate self-hosted compiler. Distinct exit
# codes identify failed semantic assertions; success requires every case.
extern fn rt_byte_array_new_len(length: u64) -> [u8]
extern fn rt_array_is_byte_packed(value: [u8]) -> i32
extern fn rt_array_new_with_cap_u64(capacity: i64) -> [u64]
extern fn rt_array_push_i64_raw(value: [u64], item: i64) -> i8
extern fn rt_array_get_i64_raw(value: [u64], index: i64) -> i64
extern fn rt_array_write_span(destination: [u64], source: [u64], destination_offset: i64, source_offset: i64, count: i64) -> i64

struct SliceRecord:
    first: i64
    second: i64

class SliceCell:
    value: i64

    me set(next: i64):
        self.value = next

struct SliceCustom:
    value: i64

    fn slice(start: i64, finish: i64) -> i64:
        self.value + start + finish

var receiver_calls: i64 = 0
var bound_calls: i64 = 0

fn make_values() -> [i64]:
    receiver_calls = receiver_calls + 1
    [10, 20, 30, 40]

fn begin_bound() -> i64:
    bound_calls = bound_calls + 1
    1

fn end_bound() -> i64:
    bound_calls = bound_calls + 1
    3

fn main() -> i64:
    val source: [i64] = [10, 20, 30, 40]
    val partial = source[1:3]
    if partial.len() != 2 or partial[0] != 20 or partial[1] != 30: return 11
    val negative = source.slice(-3, -1)
    if negative.len() != 2 or negative[0] != 20 or negative[1] != 30: return 12
    val full = source.slice(-99, 99)
    if full.len() != 4 or full[0] != 10 or full[3] != 40: return 13
    if source.slice(3, 1).len() != 0 or source.slice(2, 2).len() != 0: return 14
    val empty: [i64] = []
    if empty.slice(0, 9).len() != 0: return 15
    val suffix = source.slice(2)
    if suffix.len() != 2 or suffix[0] != 30 or suffix[1] != 40: return 16

    var independent = source.slice(0, 4)
    independent[0] = 99
    independent.push(50)
    if source.len() != 4 or source[0] != 10: return 21
    if independent.len() != 5 or independent[0] != 99: return 22
    val once = make_values().slice(begin_bound(), end_bound())
    if receiver_calls != 1 or bound_calls != 2 or once.len() != 2: return 23

    val words: [text] = ["before", "middle", "after"]
    if words.slice(1, 2)[0] != "middle": return 31
    val parent_parts = words.slice(0, words.len() - 1)
    if parent_parts.len() != 2 or parent_parts[0] != "before" or parent_parts[1] != "middle": return 61
    val bounds: [i64] = [1, 3]
    val from_elements = words.slice(bounds[0], bounds[1])
    if from_elements.len() != 2 or from_elements[0] != "middle" or from_elements[1] != "after": return 62
    val narrow_bounds: [u8] = [1u8, 3u8]
    val from_narrow = words.slice(narrow_bounds[0], narrow_bounds[1])
    if from_narrow.len() != 2 or from_narrow[0] != "middle" or from_narrow[1] != "after": return 63
    val field_bounds = SliceRecord(first: 1, second: 3)
    val from_fields = words.slice(field_bounds.first, field_bounds.second)
    if from_fields.len() != 2 or from_fields[0] != "middle" or from_fields[1] != "after": return 64
    val bytes: [u8] = [0u8, 128u8, 255u8]
    val byte_slice = bytes.slice(1, 3)
    if byte_slice[0] != 128u8 or byte_slice[1] != 255u8: return 32
    # An explicit runtime owner allocation exercises packed storage as well
    # as the ordinary language array literal above.
    var packed = rt_byte_array_new_len(3u64)
    packed[0] = 1u8
    packed[1] = 128u8
    packed[2] = 255u8
    var packed_slice = packed.slice(1, 3)
    if rt_array_is_byte_packed(packed_slice) == 0: return 33
    if packed_slice[0] != 128u8 or packed_slice[1] != 255u8: return 34
    packed_slice[0] = 3u8
    if packed[1] != 128u8: return 35
    val wide: [u64] = [0u64, 18446744073709551615u64]
    if wide.slice(1, 2)[0] != 18446744073709551615u64: return 36
    val flags: [bool] = [false, true]
    if not flags.slice(1, 2)[0]: return 37
    val packed_wide = rt_array_new_with_cap_u64(1)
    if rt_array_push_i64_raw(packed_wide, 0x123456789abcdef0) != 1: return 38
    val wide_slice = packed_wide.slice(0, 1)
    val wide_destination = rt_array_new_with_cap_u64(1)
    if rt_array_push_i64_raw(wide_destination, 0) != 1: return 39
    # write_span converts differing layouts. Losing U64_PACKED would decode
    # this raw low-tag-zero value as a tagged integer and shift it by three.
    if rt_array_write_span(wide_destination, wide_slice, 0, 0, 1) != 1: return 40
    if rt_array_get_i64_raw(wide_destination, 0) != 0x123456789abcdef0: return 44

    val records = [SliceRecord(first: 11, second: 22), SliceRecord(first: 33, second: 44)]
    if records.slice(1, 2)[0].second != 44: return 41
    val nested: [[i64]] = [[1, 2], [3, 4]]
    if nested.slice(1, 2)[0][1] != 4: return 42
    # Containers are fresh; class element identity follows the existing
    # shallow array-copy contract rather than inventing a deep clone.
    val cells = [SliceCell(value: 7)]
    val shared_elements = cells.slice(0, 1)
    shared_elements[0].set(9)
    if cells[0].value != 9: return 43

    if "abcd".slice(1, 3) != "bc": return 51
    val custom = SliceCustom(value: 20)
    if custom.slice(1, 3) != 24: return 52
    print "PASS native-array-slice bounds types storage ownership dispatch"
    0
