# Cross-module immutable instance-method ABI probe. `read()` has no explicit
# arguments, while `matches(expected)` proves the receiver remains operand 0
# when an explicit argument follows it.
use native_immutable_fn_receiver_provider.{ImmutableReceiver}

fn main() -> i64:
    val receiver = ImmutableReceiver(marker: 73)
    val expected = 41
    val observed = receiver.read()
    if observed != 73:
        return 1
    if receiver.matches(expected):
        return 2
    if not receiver.matches(73):
        return 3
    print("immutable-fn-receiver-ok")
    0
