use .left.{SharedMode as UnitMode}
use .left.{SharedMode as UnitModeAgain}
use .right.{SharedMode as PayloadMode}

fn unit_owner(mode: UnitMode) -> i64:
    match mode:
        case Relaxed: 3
        case Acquire: 5

fn same_owner_alias(mode: UnitModeAgain) -> i64:
    match mode:
        case Relaxed: 7
        case Acquire: 11

fn payload_variant_name_remains_binding(mode: PayloadMode) -> i64:
    match mode:
        case Relaxed: 13

fn main() -> i64:
    if unit_owner(UnitMode.Relaxed) != 3: return 1
    if unit_owner(UnitMode.Acquire) != 5: return 2
    if same_owner_alias(UnitModeAgain.Relaxed) != 7: return 3
    if same_owner_alias(UnitModeAgain.Acquire) != 11: return 4
    if payload_variant_name_remains_binding(PayloadMode.Relaxed(23)) != 13: return 5
    0
