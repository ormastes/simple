# Typed and nominal receivers must remain distinct across imported surfaces.
fn imported_text_byte(value: text, index: i64) -> i64:
    value.byte_at(index) as i64

struct TextByteOwner:
    content: text

impl TextByteOwner:
    fn byte_at(index: i64) -> i64:
        self.content.byte_at(index) as i64

struct CustomByteOwner:
    value: i64

impl CustomByteOwner:
    fn byte_at(index: i64) -> i64:
        self.value + index

struct NoByteOwner:
    value: i64
