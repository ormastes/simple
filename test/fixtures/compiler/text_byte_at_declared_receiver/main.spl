use provider.{imported_text_byte, TextByteOwner, CustomByteOwner}

fn main() -> i64:
    if imported_text_byte("café", 3) != 195: return 1
    if imported_text_byte("café", 4) != 169: return 2
    val source: text = "café"
    if source.char_code_at(3) != 233: return 3
    val texts: [text] = ["A", "café"]
    val selected: text = texts[1]
    if (selected.byte_at(3) as i64) != 195: return 4
    val wrapped: TextByteOwner = TextByteOwner(content: "café")
    if wrapped.byte_at(4) != 169: return 5
    val custom: CustomByteOwner = CustomByteOwner(value: 900)
    if custom.byte_at(7) != 907: return 6
    if imported_text_byte("ASCII", 0) != 65: return 7
    print "PASS declared-text-byte-at 7 checks"
    0
