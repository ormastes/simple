# BOOT-11 fixture half 1 (provider module): a struct with an i64 and a text
# field, returned across a module boundary through Optional and Result.
# Owning bug: doc/08_tracking/bug/native_optional_unwrap_field_index_by_name_collision_2026-09-12.md
pub struct FileFingerprint:
    path: text
    content_hash: text
    modified_time: i64
    size: i64

pub fn make_fp(p: text, n: i64) -> FileFingerprint?:
    return Some(FileFingerprint(path: p, content_hash: "deadbeef", modified_time: 7, size: n))

pub fn make_fp_result(p: text, n: i64) -> Result<FileFingerprint, text>:
    return Ok(FileFingerprint(path: p, content_hash: "deadbeef", modified_time: 7, size: n))

pub fn read_msg(m: text) -> Result<text, text>:
    return Ok(m)
