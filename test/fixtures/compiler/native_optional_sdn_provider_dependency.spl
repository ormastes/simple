# Import only the callable, as the MCP consumers do. The returned record's
# provider identity must not depend on a lexical SdnTable import.
use std.database.core.{parse_sdn_table}

struct SdnTable:
    rows: i64

fn main():
    val decoy = SdnTable(rows: 99)
    assert(decoy.rows == 99)
    val parsed = parse_sdn_table("stats |key, value|\n    first, 17\n    second, 23\n")
    var total = 0
    var count = 0
    match parsed:
        case Some(table):
            assert(table.name.trim() == "stats")
            for row in table.rows:
                val key = row.get("key") ?? ""
                assert(key == "first" or key == "second")
                total = total + ((row.get("value") ?? "0").to_int() ?? 0)
                count = count + 1
        case nil:
            assert(false)
    assert(count == 2)
    assert(total == 40)
    assert(decoy.rows == 99)
    print("optional SDN provider dependency assertions passed")
