# Diagnostic control only: the historical source workaround types the Err alias.
enum CancelError:
    Rejected(code: i64)

enum CancelOutcome:
    Done
    Failed(CancelError)

class CancelSource<T>:
    value: T

    me release(id: i64) -> Result<(), CancelError>:
        if id < 0:
            return Err(CancelError.Rejected(code: id))
        Ok(())

    me cancel(id: i64) -> CancelOutcome:
        val released: Result<(), CancelError> = self.release(id)
        match released:
            case Result.Ok(_): CancelOutcome.Done
            case Result.Err(error):
                val declared: CancelError = error
                CancelOutcome.Failed(declared)

fn outcome_code(outcome: CancelOutcome) -> i64:
    match outcome:
        case CancelOutcome.Done: 0
        case CancelOutcome.Failed(error):
            match error:
                case CancelError.Rejected(code): code

fn main() -> i64:
    var source = CancelSource<i64>(value: 17)
    if outcome_code(source.cancel(-29)) != -29: return 1
    if outcome_code(source.cancel(3)) != 0: return 2
    if outcome_code(source.cancel(-41)) != -41: return 3
    if source.value != 17: return 4
    print "result-err-generic-typed-alias-control: PASS"
    0
