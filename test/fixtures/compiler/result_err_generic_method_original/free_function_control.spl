# Diagnostic control: the same typed Result and Err reconstruction as free calls.
enum CancelError:
    Rejected(code: i64)

enum CancelOutcome:
    Done
    Failed(CancelError)

fn release(id: i64) -> Result<(), CancelError>:
    if id < 0:
        return Err(CancelError.Rejected(code: id))
    Ok(())

fn cancel(id: i64) -> CancelOutcome:
    val released: Result<(), CancelError> = release(id)
    match released:
        case Result.Ok(_): CancelOutcome.Done
        case Result.Err(error): CancelOutcome.Failed(error)

fn outcome_code(outcome: CancelOutcome) -> i64:
    match outcome:
        case CancelOutcome.Done: 0
        case CancelOutcome.Failed(error):
            match error:
                case CancelError.Rejected(code): code

fn main() -> i64:
    if outcome_code(cancel(-29)) != -29: return 1
    if outcome_code(cancel(3)) != 0: return 2
    if outcome_code(cancel(-41)) != -41: return 3
    print "result-err-free-function-control: PASS"
    0
