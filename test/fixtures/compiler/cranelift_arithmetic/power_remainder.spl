# Parameterized power/remainder operations must reach their actual numeric
# implementation, including F32/F64 and mixed integer/float promotion.
fn integer_power(base: i64, exponent: i64) -> i64:
    base ** exponent

fn narrow_power(base: i8, exponent: i8) -> i64:
    base ** exponent

fn unsigned_power(base: u64, exponent: u64) -> u64:
    base ** exponent

fn wide_power(base: f64, exponent: f64) -> f64:
    base ** exponent

fn narrow_float_power(base: f32, exponent: f32) -> f32:
    base ** exponent

fn integer_float_power(base: i64, exponent: f64) -> f64:
    base ** exponent

fn float_integer_power(base: f64, exponent: i64) -> f64:
    base ** exponent

fn wide_remainder(value: f64, divisor: f64) -> f64:
    value % divisor

fn narrow_remainder(value: f32, divisor: f32) -> f32:
    value % divisor

fn integer_float_remainder(value: i64, divisor: f64) -> f64:
    value % divisor

fn float_integer_remainder(value: f64, divisor: i64) -> f64:
    value % divisor

fn signed_remainder(value: i64, divisor: i64) -> i64:
    value % divisor

fn unsigned_remainder(value: u64, divisor: u64) -> u64:
    value % divisor

fn main() -> i64:
    if integer_power(2, 3) != 8: return 1
    if integer_power(-3, 3) != -27: return 2
    if integer_power(-3, 4) != 81: return 3
    if integer_power(0, 0) != 1: return 4
    if integer_power(7, 0) != 1: return 5
    if integer_power(7, -1) != 0: return 6
    if integer_power(9223372036854775807, 1) != 9223372036854775807: return 7
    if narrow_power(3, 3) != 27: return 8
    if unsigned_power(3u64, 4u64) != 81u64: return 9
    if wide_power(2.0, 3.0) != 8.0: return 10
    if wide_power(4.0, 0.5) != 2.0: return 11
    if wide_power(2.0, -2.0) != 0.25: return 12
    if narrow_float_power(2.0f32, 3.0f32) != 8.0f32: return 13
    if integer_float_power(4, 0.5) != 2.0: return 14
    if float_integer_power(2.0, 3) != 8.0: return 15
    if wide_remainder(5.5, 2.0) != 1.5: return 16
    if wide_remainder(-5.5, 2.0) != -1.5: return 17
    if wide_remainder(5.5, -2.0) != 1.5: return 18
    if wide_remainder(-5.5, -2.0) != -1.5: return 19
    if narrow_remainder(5.5f32, 2.0f32) != 1.5f32: return 20
    if narrow_remainder(-5.5f32, 2.0f32) != -1.5f32: return 21
    if integer_float_remainder(5, 2.0) != 1.0: return 22
    if float_integer_remainder(5.5, 2) != 1.5: return 23
    if signed_remainder(-5, 2) != -1: return 24
    if unsigned_remainder(18446744073709551614u64, 3u64) != 2u64: return 25
    if unsigned_power(1u64, 9223372036854775808u64) != 1u64: return 26
    if unsigned_power(18446744073709551615u64, 9223372036854775808u64) != 1u64: return 27
    if unsigned_power(18446744073709551615u64, 18446744073709551615u64) != 18446744073709551615u64: return 28
    if unsigned_power(0u64, 9223372036854775808u64) != 0u64: return 29
    if integer_power(2, 63) != (-9223372036854775807 - 1): return 30
    if integer_power(2, 64) != 0: return 31
    if integer_power(-2, 63) != (-9223372036854775807 - 1): return 32
    if integer_power(7, (-9223372036854775807 - 1)) != 0: return 33
    print "PASS power remainder checks=33"
    0
