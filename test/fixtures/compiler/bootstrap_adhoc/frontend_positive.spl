use compiler.frontend.core.parser_preprocessor.{preprocess_conditionals}

fn main() -> i64:
    val source = "@cfg(false)\nfn hidden():\n    val leaked = 1\n\nfn visible():\n    val kept = 2\n"
    val processed = preprocess_conditionals(source)
    if processed.contains("fn hidden") or processed.contains("val leaked"):
        print "frontend capsule leaked false cfg"
        return 1
    if not processed.contains("fn visible") or not processed.contains("val kept"):
        print "frontend capsule removed visible declaration"
        return 1
    print "BOOTSTRAP_ADHOC_PASS lane=frontend"
    0
