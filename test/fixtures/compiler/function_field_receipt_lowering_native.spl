# Actual frontend/HIR/MIR APIs. Run in a fresh process with
# SIMPLE_COMPILER_PHASE_PROFILE=1 and require a function-field-return receipt.
extern fn rt_exit(code: i64)
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir_lowering_types.MirLowering
use compiler.mir._MirLowering.module_lowering.*
use compiler.mir.mir_instructions.MirFunction
use compiler.mir.mir_instruction_kinds.MirInstKind
use compiler.mir.mir_types.{MirTypeKind, LocalId}

fn main() -> i64:
    val source = "struct Port:\n    call_fn: fn(i64) -> i64\nfn increment(value: i64) -> i64:\n    value + 1\nfn diagnostic_probe() -> i64:\n    val port = Port(call_fn: increment)\n    port.call_fn(7)\n"
    val parsed = parse_full_frontend(source, "receipt_probe.spl", "receipt_probe", Logger(level: 0))
    var hir_lowering = HirLowering.with_filename("receipt_probe.spl")
    val hir = hir_lowering.lower_module(parsed)
    if hir_lowering.errors.len() != 0 or hir.functions.len() < 2: rt_exit(1)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir, [], false)
    if lowering.errors.len() != 0 or mir.functions.len() < 2: rt_exit(2)
    var observed_probe = false
    var observed_raw_indirect = false
    for raw_function in mir.functions.values():
        val function: MirFunction = raw_function
        if function.name.contains("diagnostic_probe"):
            observed_probe = true
            if function.blocks.len() == 0: rt_exit(3)
            for block in function.blocks:
                for instruction in block.instructions:
                    val kind: MirInstKind = instruction.kind
                    match kind:
                        case MirInstKind.CallIndirect(dest, _, args, signature):
                            if signature.params.len() == 1:
                                if args.len() != 1: rt_exit(4)
                                val return_kind: MirTypeKind = signature.return_type.kind
                                if return_kind != MirTypeKind.I64: rt_exit(5)
                                if val present = dest:
                                    val result: LocalId = present
                                    if result.id < 0: rt_exit(6)
                                else:
                                    rt_exit(7)
                                observed_raw_indirect = true
                        case _: ()
    if not observed_probe or not observed_raw_indirect: rt_exit(8)
    print "PASS function_field_receipt_lowering_native"
    0
