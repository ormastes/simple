class OptionalForwardCell:
    value: i64

fn relay(value: OptionalForwardCell?) -> OptionalForwardCell?:
    value

fn forward(value: OptionalForwardCell?) -> OptionalForwardCell?:
    relay(value)

fn main() -> i64:
    val absent: OptionalForwardCell? = nil
    val missing = forward(absent)
    if missing.?:
        print "OPTIONAL_FORWARD_NONE_BECAME_SOME"
        return 1
    val present = forward(Some(OptionalForwardCell(value: 42)))
    if not present.? or present!.value != 42:
        print "OPTIONAL_FORWARD_SOME_LOST"
        return 2
    print "OPTIONAL_PARAMETER_FORWARDING_PASS"
    0
