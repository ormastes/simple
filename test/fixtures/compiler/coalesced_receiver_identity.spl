# Compile and execute with the changed native compiler on each backend.
var text_calls: i64 = 0
var array_calls: i64 = 0
var fallback_calls: i64 = 0
var custom_calls: i64 = 0

struct ReceiverProbe:
    value: i64

impl ReceiverProbe:
    fn is_empty(self) -> bool:
        self.value == 7

fn custom_receiver() -> ReceiverProbe:
    custom_calls = custom_calls + 1
    ReceiverProbe(value: 7)

fn receiver_text() -> text:
    text_calls = text_calls + 1
    "Windows"

fn receiver_args() -> [text]:
    array_calls = array_calls + 1
    ["arg"]

fn fallback_text() -> text:
    fallback_calls = fallback_calls + 1
    "fallback"

fn main():
    val text_value = receiver_text() ?? fallback_text()
    assert(text_value.contains("Windows"))
    assert(text_calls == 1)
    assert(fallback_calls == 0)
    val args = receiver_args() ?? []
    assert(not args.is_empty())
    assert(array_calls == 1)
    val empty: [text] = []
    assert(empty.is_empty())
    assert(custom_receiver().is_empty())
    assert(custom_calls == 1)
    print "coalesced receiver identity: PASS"
