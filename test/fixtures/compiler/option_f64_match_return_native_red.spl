# Known-red native compiler reproducer: value-position Option[f64] match does
# not preserve the f64 return ABI. Config parsing uses `unwrap_or` until fixed.
fn parsed_or_default(raw: text, default_val: f64) -> f64:
    match raw.parse_f64():
        Some(value): value
        nil: default_val

fn main() -> i64:
    if parsed_or_default("1.25", 9.5) != 1.25:
        return 1
    if parsed_or_default("not-a-number", 9.5) != 9.5:
        return 2
    0
