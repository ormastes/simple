"""Parser → HIR → mono generic callback assertions shared by mono/MIR drivers."""
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule, HirTypeKind}
use compiler.hir.hir_definitions.{HirFunction}
use compiler.mono.monomorphize_integration.{run_monomorphization}

val SOURCE = "class HostFuture<T>:\n    value: T\n    static fn from_value(value: T) -> HostFuture<T>:\n        HostFuture(value: value)\n    fn then<U>(f: fn(T) -> HostFuture<U>) -> HostFuture<U>:\n        f(self.value)\nfn read_all(input: HostFuture<Result<[u8], i64>>, prefix: [u8]) -> HostFuture<Result<[u8], i64>>:\n    input.then(\\result:\n        match result:\n            case Ok(bytes):\n                HostFuture.from_value(Ok(prefix + bytes))\n            case Err(error):\n                HostFuture.from_value(Err(error))\n    )\nfn distinct(input: HostFuture<i64>, output: HostFuture<text>) -> HostFuture<text>:\n    input.then(\\value: output)\n"
val NEGATIVE_SOURCE = "class HostFuture<T>:\n    value: T\n    fn then<U>(f: fn(T) -> HostFuture<U>) -> HostFuture<U>:\n        f(self.value)\nfn bad(input: HostFuture<i64>, output: HostFuture<f64>) -> HostFuture<text>:\n    input.then(\\value: output)\n"
val DIRECT_CALLBACK_SOURCE = "fn apply<T, U>(value: T, f: fn(T) -> U) -> U:\n    f(value)\nfn direct(value: i64) -> text:\n    apply(value, \\item: \"mapped\")\n"

fn check(condition: bool, message: text):
    if not condition:
        panic(message)

fn check_generic_callback_mono() -> HirModule:
    val parsed = parse_full_frontend(SOURCE, "generic_callback.spl", "generic_callback", Logger(level: 0))
    var lowering = HirLowering.with_filename("generic_callback.spl")
    val hir = lowering.lower_module(parsed)
    check(lowering.errors.len() == 0, "generic callback fixture did not lower to HIR")
    var modules: Dict<text, HirModule> = {}
    modules["generic_callback"] = hir
    val (rewritten, stats) = run_monomorphization(modules)
    check(stats.specializations_created > 0, "generic callback method was not specialized")
    check(stats.unresolved_generic_calls == 0, "generic callback method retained unresolved binders")
    val module: HirModule = rewritten["generic_callback"]
    var saw_distinct_hir_signature = false
    for raw_function in module.functions.values():
        val function: HirFunction = raw_function
        if function.name.contains("HostFuture__then$i64$text"):
            check(function.type_params.len() == 0, "distinct method specialization retained type parameters")
            check(function.params.len() == 2, "distinct method specialization has wrong arity")
            match function.params[1].type_.kind:
                case HirTypeKind.Function(callback_inputs, callback_result, _):
                    check(callback_inputs.len() == 1, "distinct callback has wrong input arity")
                    match callback_inputs[0].kind:
                        case HirTypeKind.Int(64, true): ()
                        case _: panic("distinct callback owner T is not i64")
                    match callback_result.kind:
                        case HirTypeKind.Named(_, result_args):
                            check(result_args.len() == 1, "distinct callback result has wrong generic arity")
                            match result_args[0].kind:
                                case HirTypeKind.Str: ()
                                case _: panic("distinct method U is not text")
                        case _: panic("distinct callback result is not HostFuture<text>")
                case _: panic("distinct method callback signature is not a function")
            saw_distinct_hir_signature = true
    check(saw_distinct_hir_signature, "mono output has no concrete i64-to-text method signature")

    val bad_parsed = parse_full_frontend(NEGATIVE_SOURCE, "generic_callback_bad.spl", "generic_callback_bad", Logger(level: 0))
    var bad_lowering = HirLowering.with_filename("generic_callback_bad.spl")
    val bad_hir = bad_lowering.lower_module(bad_parsed)
    check(bad_lowering.errors.len() == 0, "negative callback fixture did not lower to HIR")
    var bad_modules: Dict<text, HirModule> = {}
    bad_modules["generic_callback_bad"] = bad_hir
    val (_, bad_stats) = run_monomorphization(bad_modules)
    check(bad_stats.specializations_created == 0, "conflicting callback body was specialized")
    check(bad_stats.unresolved_generic_calls == 1, "conflicting callback body was not refused")

    val direct_parsed = parse_full_frontend(DIRECT_CALLBACK_SOURCE, "generic_direct_callback.spl", "generic_direct_callback", Logger(level: 0))
    var direct_lowering = HirLowering.with_filename("generic_direct_callback.spl")
    val direct_hir = direct_lowering.lower_module(direct_parsed)
    check(direct_lowering.errors.len() == 0, "direct generic callback fixture did not lower to HIR")
    var direct_modules: Dict<text, HirModule> = {}
    direct_modules["generic_direct_callback"] = direct_hir
    val (direct_output, direct_stats) = run_monomorphization(direct_modules)
    check(direct_stats.specializations_created == 1, "direct generic callback was not specialized once")
    check(direct_stats.unresolved_generic_calls == 0, "direct generic callback retained unresolved binders")
    val direct_module: HirModule = direct_output["generic_direct_callback"]
    var saw_direct_signature = false
    for raw_function in direct_module.functions.values():
        val function: HirFunction = raw_function
        if function.name != "apply$i64$text": continue
        check(function.type_params.len() == 0, "direct callback specialization retained type parameters")
        check(function.params.len() == 2, "direct callback specialization has wrong arity")
        match function.params[1].type_.kind:
            case HirTypeKind.Function(callback_inputs, callback_result, _):
                check(callback_inputs.len() == 1, "direct callback input arity is wrong")
                match callback_inputs[0].kind:
                    case HirTypeKind.Int(64, true): ()
                    case _: panic("direct callback T was not inferred as i64")
                match callback_result.kind:
                    case HirTypeKind.Str: ()
                    case _: panic("direct callback U was not inferred as text")
            case _: panic("direct callback specialization lost its function parameter")
        saw_direct_signature = true
    check(saw_direct_signature, "mono output has no direct callback T/U signature")
    module
