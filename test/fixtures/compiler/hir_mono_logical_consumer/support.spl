# Genuine parser/lowerer/registration helpers for the standalone native probe.
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveInputV1, HirBodyArchiveV1, hir_body_archive_store_v1}
use compiler.driver.driver_hir_cache.{hir_cache_header, hir_cache_load_in_owned_scope,
    hir_cache_promote_diagnostic_owner_v1, hir_cache_clear_last_warnings}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId}
use compiler.hir.hir_definitions.{HirFunction, HirParam, HirExpr, HirExprKind, HirCallArg, HirStmt, HirStmtKind}
use compiler.mono.mono_archive_registration_v1.{MonoArchiveRegistrationOwnerV1,
    MonoArchiveRegistrationReceiptV1, mono_archive_collect_registration_in_owned_scope_v1}
use compiler.common.config.{Logger}
use compiler.common.diagnostics.span.{Span}
use std.nogc_sync_mut.io_runtime.{file_read_nullable}
use std.env.{env_get}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end, transient_promote}

fn lower_fixture(file: text, name: text) -> HirModule:
    val path = "test/fixtures/compiler/hir_mono_logical_consumer/" + file
    val source = file_read_nullable(path) ?? ""
    val parsed = parse_full_frontend(source, path, name, Logger(level: 0))
    var lowering = HirLowering.with_filename(path)
    lowering.lower_parser_module_unstub(parsed, false)


fn archive_fixture(module: HirModule) -> Result<HirBodyArchiveV1, text>:
    hir_body_archive_store_v1(HirBodyArchiveInputV1(source_path: module.path,
        module_name: module.name, is_entry: false,
        closure_digest: env_get("SIMPLE_HIR_LEASE_CLOSURE_DIGEST"),
        runtime_provider_digest: env_get("SIMPLE_HIR_LEASE_RUNTIME_PROVIDER_DIGEST"),
        runtime_provider_receipt_path: env_get("SIMPLE_HIR_LEASE_RUNTIME_PROVIDER_RECEIPT"),
        producer_header: hir_cache_header(), stage: "lowered-unresolved-v1"), module, [])


fn fixture_function(module: HirModule, name: text) -> HirFunction:
    for raw in module.functions.values():
        val function: HirFunction = raw
        if function.name == name: return function
    panic("fixture function absent")


fn integer_type() -> HirType:
    HirType(kind: HirTypeKind.Int(64, true), span: Span.default())


fn generic_call(name: text, arg: HirExpr, type_: HirType) -> HirExpr:
    val span = Span.default()
    val callee = HirExpr(kind: HirExprKind.NamedVar(SymbolId.new(-1), name),
        has_type_: false, type_: integer_type(), span: span)
    HirExpr(kind: HirExprKind.Call(callee, [HirCallArg(has_name: false, name: "", value: arg, span: span)], [type_]),
        has_type_: true, type_: integer_type(), span: span)


fn root_for(module: HirModule, template: text, repeat: bool, warn: bool) -> HirModule:
    var output = module
    var root = fixture_function(module, "root")
    val span = root.span
    val arg = HirExpr(kind: HirExprKind.IntLit(7, nil), has_type_: true, type_: integer_type(), span: span)
    val call = generic_call(template, arg, integer_type())
    root.body.stmts = []
    if repeat:
        val text_type = HirType(kind: HirTypeKind.Str, span: span)
        val text_arg = HirExpr(kind: HirExprKind.StringLit("second specialization", nil), has_type_: true, type_: text_type, span: span)
        root.body.stmts = [HirStmt(kind: HirStmtKind.Expr(call), span: span),
            HirStmt(kind: HirStmtKind.Expr(generic_call(template, text_arg, text_type)), span: span)]
    if warn:
        val param: HirParam = root.params[0]
        val base = HirExpr(kind: HirExprKind.Var(param.symbol), has_type_: true, type_: param.type_, span: span)
        val field = HirExpr(kind: HirExprKind.Field(base, "values", nil), has_type_: false, type_: integer_type(), span: span)
        root.body.stmts = root.body.stmts + [HirStmt(kind: HirStmtKind.Expr(field), span: span), HirStmt(kind: HirStmtKind.Expr(field), span: span)]
    root.body.has = true
    root.body.value = call
    output.functions[root.symbol] = root
    output


fn capture_registration(owner: MonoArchiveRegistrationOwnerV1, archive: HirBodyArchiveV1) -> Result<MonoArchiveRegistrationReceiptV1, text>:
    if not transient_scope_begin(): return Err("capture fixture scope unavailable")
    var captured: Result<MonoArchiveRegistrationReceiptV1, text> = Err("complete input unavailable")
    if val module = hir_cache_load_in_owned_scope(archive.archive_key):
        captured = mono_archive_collect_registration_in_owned_scope_v1(owner, module, module.name, archive)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(captured) else: false
    val cache_owned = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    if paused: hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not owned or not cache_owned or not ended: panic("registration fixture ownership")
    captured


export lower_fixture, archive_fixture, fixture_function, integer_type, generic_call, root_for, capture_registration
