
# Appended to an exact copy of process_task_arena.spl by the macOS Phase 2
# native regression driver. Keeping the harness in the same module lets it
# initialize private arena state and call the production join_exact_until body.
fn fixture_owner() -> i64: 41
fn fixture_bind(_handle: i64, _provider: text, _kind: text, _tool: text, _path: text, _hash: text, _schema: text) -> bool: true
fn fixture_cancel(_handle: i64, _deadline: i64) -> bool: true
fn fixture_close_fails(_handle: i64) -> bool: false
fn fixture_spawn(_handle: i64, _request: RtHalExactRequest, _receipt: RtHalCanonicalReceipt) -> i64: 73
fn fixture_joined(_handle: i64, _deadline: i64) -> RtHalExactJoin:
    RtHalExactJoin(completed: true,
        outcome_digest: receipt_zero_digest(), error_digest: receipt_zero_digest(),
        trace_digest: receipt_zero_digest())
fn fixture_shutdown() -> bool: true

fn main():
    val caps = RtHalIsolatedHostCapabilities(
        available: true, canonical_executable_identity: true,
        static_executable_closure: true, fixed_scalar_argv: true,
        private_ipc: true, no_symlink_path_transport: true,
        process_tree_containment: true, bounded_timed_join: true,
        cancellation_and_reap: true, portable_host_contract: true)
    rt_hal_host = Some(RtHalIsolatedHostPort(capabilities: caps,
        current_owner_fn: fixture_owner, bind_adapter_fn: fixture_bind,
        cancel_and_reap_fn: fixture_cancel, close_fn: fixture_close_fails,
        spawn_compare_exact_fn: fixture_spawn, spawn_replay_exact_fn: fixture_spawn,
        join_exact_until_fn: fixture_joined, shutdown_fn: fixture_shutdown))
    rt_hal_controller_owner_id = 41
    rt_hal_tasks = [RtHalIsolatedTask(active: true, generation: 1, host_handle: 73)]
    val result = join_exact_until(513, 100)
    if result.completed: panic("failed close must fail actual join")
    print("ACTUAL-JOIN-CLOSE-FAIL-PASS")
