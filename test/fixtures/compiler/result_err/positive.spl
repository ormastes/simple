struct Custom:
    value: i64

impl Custom:
    fn err() -> i64:
        self.value

fn text_error() -> Result<i64, text>:
    Err("denied")

fn success() -> Result<i64, text>:
    Ok(42)

fn number_error(value: i64) -> Result<text, i64>:
    Err(value)

fn bool_error() -> Result<i64, bool>:
    Err(false)

fn float_error(value: f64) -> Result<i64, f64>:
    Err(value)

fn unicode_error(value: text) -> Result<i64, text>:
    Err(value)

fn main() -> i64:
    val failure = text_error()
    assert(failure.err().unwrap() == "denied")
    val good = success()
    assert(good.err().is_none())
    assert(good.err().unwrap_or("fallback") == "fallback")
    assert(good.ok().unwrap() == 42)
    val zero = number_error(0)
    assert(zero.err().is_some())
    assert(zero.err().unwrap() == 0)
    assert(zero.err().unwrap_or(99) == 0)
    val boolean = bool_error()
    assert(boolean.err().unwrap() == false)
    val floating = float_error(1.5)
    assert(floating.err().unwrap() == 1.5)
    assert(number_error(-7).err().unwrap() == -7)
    assert(number_error(3).err().is_some())
    assert(number_error(3).err().unwrap() == 3)
    assert(unicode_error("").err().unwrap() == "")
    assert(unicode_error("한é").err().unwrap() == "한é")
    val negative_zero = float_error(-0.0).err().unwrap()
    assert(1.0 / negative_zero < 0.0)
    val custom = Custom(value: 7)
    assert(custom.err() == 7)
    print "RESULT_ERR_METHOD_PASS assertions=16"
    0
