# Import each generated consumer directly; the package facade must not hide
# a missing dependency on the sibling that owns leaf and exhaustiveness hooks.
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind}
use compiler.hir.generated.hir_children.{hir_children_of_expr}
use compiler.hir.generated.hir_hash.{hir_hash_expr}

fn main() -> i64:
    val span = Span(start: 0, end: 1, line: 1, col: 1, file: "hir-helper-fixture", length: 1)
    val first = HirExpr(kind: HirExprKind.IntLit(17, nil), has_type_: false, type_: nil, span: span)
    val second = HirExpr(kind: HirExprKind.IntLit(18, nil), has_type_: false, type_: nil, span: span)
    if hir_children_of_expr(first).len() != 0: return 1
    val first_hash = hir_hash_expr(first)
    if first_hash != hir_hash_expr(first): return 2
    if first_hash == hir_hash_expr(second): return 3
    print "hir-generated-helpers: PASS"
    0
