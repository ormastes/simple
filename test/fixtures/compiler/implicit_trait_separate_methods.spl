# Native regression: zero inline methods, actual erased argument dispatch.
trait SeparateMethodProbe:
    fn read() -> i64
    fn twice() -> i64:
        self.read() * 2

struct SeparateMethodDevice(SeparateMethodProbe):
    pass

impl SeparateMethodDevice:
    fn read() -> i64: 37

fn through_trait(value: SeparateMethodProbe) -> i64:
    value.read() + value.twice()

fn main() -> i64:
    assert(through_trait(SeparateMethodDevice()) == 111)
    print "IMPLICIT_TRAIT_SEPARATE_METHODS_PASS value=111"
    0
