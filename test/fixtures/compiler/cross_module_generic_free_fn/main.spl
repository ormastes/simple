# Native repro for p4p2_cross_module_generic_free_fn_not_instantiated_2026-10-20.
# Generic free fns defined in another module must link under erased generics
# (one erased body per generic fn, 3b94b409c17): the defining module emits the
# body under the base symbol, so `mutex_new(0)` and `mutex_new(State(..))` both
# resolve at link time.
# Stage3 repro: bin/simple native-build --entry-closure --entry <this file> --source src/lib -o build/cmg && build/cmg
# Expected stdout: CROSS_MODULE_GENERIC_OK
# Failing producer: lld-link undefined symbol lib.nogc_sync_mut.concurrent.mutex.mutex_new
use std.nogc_sync_mut.concurrent.mutex.{Mutex, mutex_new}

struct State:
    count: i64

fn make_int_mutex() -> Mutex:
    mutex_new(0)

fn make_struct_mutex() -> Mutex:
    mutex_new(State(count: 1))

fn main():
    val a = make_int_mutex()
    val b = make_struct_mutex()
    print("CROSS_MODULE_GENERIC_OK")
