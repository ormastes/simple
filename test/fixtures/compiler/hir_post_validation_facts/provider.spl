@layer_eq(Device)
struct View:
    x: i64 = 37

struct Device:
    x: i64

struct Blob:
    a: i64
    b: i64
    c: i64

fn helper(src: Blob) -> i64:
    val dup: Blob = src
    dup.a

@copy_budget(8)
fn outer(src: Blob) -> i64:
    helper(src)

fn array_value() -> [i64]:
    [1, 2]

fn submit_impl(n: i64) -> i64:
    n + 1

fn submit_view(n: i64) -> i64:
    submit_impl(n)

@advice(forward, submit_view)
@readonly
@noalloc
@bounded_time
fn trace_submit():
    val observed = 1
