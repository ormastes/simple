use compiler.loader.module_loader.{LoadedModule, LoadedSymbol, LoaderSymbolType, ModuleLoader}
use std.nogc_sync_mut.io.file_ops.{file_read}

fn main() -> i64:
    val source = file_read("src/compiler/99.loader/module_loader.spl")
    if not source.contains("use compiler.backend.linker.obj_taker.{SmfSymbol, SymbolType}"):
        return 31
    if not source.contains("fn get_symbol(name: text) -> LoadedSymbol?:"):
        return 32
    if not source.contains("fn get_module(path: text) -> LoadedModule?:"):
        return 33
    if source.contains("struct SmfSymbol:"):
        return 34

    val symbol = LoadedSymbol(
        name: "known",
        address: 4096,
        size: 16,
        ty: LoaderSymbolType.Function,
        is_jit: false,
        file_offset: 8
    )
    val module = LoadedModule(
        path: "known.smf",
        reader: "fixture",
        symbols: {"known": symbol},
        load_time: 1,
        version: 1
    )

    val found_symbol: LoadedSymbol? = module.get_symbol("known")
    match found_symbol:
        case Some(found):
            if found.name != "known" or found.address != 4096:
                return 41
        case _:
            return 42
    val missing_symbol: LoadedSymbol? = module.get_symbol("missing")
    match missing_symbol:
        case Some(_): return 43
        case _: pass

    var loader = ModuleLoader.with_defaults()
    loader.modules["known.smf"] = module
    val found_module: LoadedModule? = loader.get_module("known.smf")
    match found_module:
        case Some(found):
            if found.path != "known.smf":
                return 44
        case _:
            return 45
    val missing_module: LoadedModule? = loader.get_module("missing.smf")
    match missing_module:
        case Some(_): return 46
        case _: pass
    0
