use .provider.{mode, last_file, startup, literal_controls, update}

fn main():
    assert(mode() == "framed")
    assert(mode().len() == 6)
    assert(last_file() == "" and last_file().len() == 0)
    assert(startup() == "framed:")
    assert(literal_controls())
    update("file.spl")
    var i = 0
    while i < 10:
        # Imported callable guards must return without replaying literals.
        assert(mode() == "jsonl" and mode().starts_with("json"))
        assert(last_file() == "file.spl" and last_file().ends_with(".spl"))
        assert(startup() == "framed:")
        i = i + 1
    update("")
    assert(last_file() == "" and mode() == "jsonl")
    print("mutable text literal initialization assertions passed")
