var _TRANSPORT_MODE = "framed"
var _LSP_LAST_FILE: text = ""
var unicode_text: text = "한🙂"
var nul_text: text = "a\0b"
var startup_snapshot: text = _TRANSPORT_MODE + ":" + _LSP_LAST_FILE
val immutable_text = "constant"
var numeric: i64 = 19

pub fn mode() -> text:
    _TRANSPORT_MODE

pub fn last_file() -> text:
    _LSP_LAST_FILE

pub fn startup() -> text:
    startup_snapshot

pub fn literal_controls() -> bool:
    unicode_text == "한🙂" and unicode_text.len() == 7 and
        nul_text == "a\0b" and nul_text.len() == 3 and nul_text.ends_with("b") and
        immutable_text == "constant" and numeric == 19

pub fn update(file: text):
    _TRANSPORT_MODE = "jsonl"
    _LSP_LAST_FILE = file
