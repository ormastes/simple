use .provider.{maybe_table, tables}
use .decoy.{decoy}

fn main() -> i64:
    val unrelated = decoy()
    var count = 0
    val pending = maybe_table(true)
    match pending:
        case Some(table):
            for row in table.rows:
                if (row.get("value") ?? "missing") != "provider": return 1
                if row.get("missing") != nil: return 2
                count = count + 1
        case nil: return 3
    if count != 1: return 4
    for table in tables():
        for row in table.rows:
            if (row.get("value") ?? "missing") != "provider": return 5
            count = count + 1
    if count != 2: return 6
    val missing = maybe_table(false)
    match missing:
        case Some(_): return 7
        case nil: ()
    print "record_array_owner: PASS"
    0
