pub class Row:
    padding: i64
    value: text

    fn get(key: text) -> text?:
        if key == "value": return Some(self.value)
        nil

pub class Table:
    padding: i64
    rows: [Row]

pub fn maybe_table(present: bool) -> Table?:
    if not present: return nil
    Some(Table(padding: 13, rows: [Row(padding: 17, value: "provider")]))

pub fn tables() -> [Table]:
    [Table(padding: 23, rows: [Row(padding: 29, value: "provider")])]
