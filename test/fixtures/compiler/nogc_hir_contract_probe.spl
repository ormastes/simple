"""Native Stage 2 compiler diagnostic for the HIR ownership contract.

This calls the actual parser, lowering and effect analysis. It does not run
the general SPipe test framework or claim full runtime/drop qualification.
"""

use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.common.driver_core_types.{SourceFile}
use compiler.hir.hir_types.*
use compiler.hir.hir_lowering.types.{HirLowering, LoweringError}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.semantics.param_effects.effects.{ParamEffectReport, ParamEffectDiag, param_effect_report_effect}
use compiler.semantics.param_effects.infer.{infer_param_effects}

use std.nogc_sync_mut.io_runtime.{exit}

fn hir_contract_require(condition: bool, message: text):
    if not condition:
        print "nogc-hir-contract: FAIL {message}"
        exit(1)

fn report(body: text, strict: bool) -> ParamEffectReport:
    var parsed = parse_and_build_module("class Node:\n    v: i64\n" + body, "probe.spl")
    parsed.nogc_strict = strict
    hir_contract_require(parsed.functions.keys().len() > 0, "source fixture parsed no function declarations")
    var lowering = HirLowering.with_filename("probe.spl")
    lowering.use_explicit_semantic_policy()
    val lowered = lowering.lower_module(parsed)
    if lowering.errors.len() != 0:
        print "nogc-hir-contract: lowering failed for strict={strict} source:\n{body}"
        for diagnostic in lowering.errors:
            val actual: LoweringError = diagnostic
            print "nogc-hir-contract: lowering error: {actual.message}"
    hir_contract_require(lowering.errors.len() == 0, "source fixture produced HIR lowering errors")
    infer_param_effects(lowered, {}, {})

fn has_param_diag(report: ParamEffectReport, function: text, param: text, code: text) -> bool:
    for diagnostic in report.diags:
        val actual: ParamEffectDiag = diagnostic
        if actual.function == function and actual.param == param and actual.code == code:
            return true
    false

fn check_import(owner_strict: bool, consumer_strict: bool, alias: text, expected: [text]):
    val source = "pub fn take(a: &i64, b: *i64, c: -i64) -> i64:\n    0\n"
    var parsed = parse_and_build_module(source, "provider.spl")
    parsed.nogc_strict = owner_strict
    val sources = [SourceFile(path: "provider.spl", content: source, module_name: "provider")]
    val registry_result = module_surfaces_from_modules({"provider": parsed, "alias": parsed}, sources)
    hir_contract_require(registry_result.is_ok(), "provider registry rejected the source fixture")
    val registry = registry_result.unwrap()
    var lowering = HirLowering.with_filename("consumer.spl")
    lowering.module_surfaces = registry
    lowering.nogc_strict = consumer_strict
    var kinds: [text] = []
    for param in parsed.functions["take"].params:
        val lowered: HirType = lowering.imported_surface_type(param.type_, alias)
        match lowered.kind:
            case HirTypeKind.Error: kinds.push("error")
            case _: kinds.push(hir_type_kind_ownership_name(lowered.kind))
    hir_contract_require(kinds == expected, "imported ownership kinds disagree with declaring-module contract")
    if expected[0] == "error":
        hir_contract_require(lowering.errors.len() == 3, "unchecked imports did not produce fatal lowering diagnostics")
    else:
        hir_contract_require(lowering.errors.len() == 0, "valid provider import produced a diagnostic")

fn main() -> i64:
    val strict = report("fn own(n: &Node) -> i64:\n    0\nfn shared(n: *Node) -> i64:\n    0\nfn retain_weak(n: -Node) -> -Node:\n    n\n", true)
    hir_contract_require(param_effect_report_effect(strict, "own", "n") == "consume", "unique parameter is not consumed")
    hir_contract_require(param_effect_report_effect(strict, "shared", "n") == "share-explicit", "shared parameter lost explicit ownership")
    hir_contract_require(param_effect_report_effect(strict, "retain_weak", "n") == "share-explicit", "retained weak handle was reported as a short borrow")
    val forward = report("fn forward(n: Node) -> i64:\n    later(n)\nfn later(n: Node) -> i64:\n    n.v\n", false)
    hir_contract_require(param_effect_report_effect(forward, "forward", "n") == "read-short", "forward-call inference acquired a transient ambiguity")
    val foreign = report("extern fn retain(n: Node)\nfn forward(n: Node):\n    retain(n)\n", false)
    hir_contract_require(param_effect_report_effect(foreign, "forward", "n") == "ambiguous", "foreign retention was inferred as a short borrow")
    val insertion = report("fn keep(xs: [Node], n: &Node):\n    xs.push(n)\n", true)
    hir_contract_require(param_effect_report_effect(insertion, "keep", "n") == "consume", "explicit owner parameter lost its consuming contract")
    hir_contract_require(insertion.diags.len() == 0, "valid explicit owner insertion produced diagnostics")
    val borrowed_insertion = report("fn keep_borrow(xs: [Node], n: Node):\n    xs.push(n)\n", true)
    hir_contract_require(param_effect_report_effect(borrowed_insertion, "keep_borrow", "n") == "ambiguous", "short parameter retention acquired a consuming contract")
    hir_contract_require(has_param_diag(borrowed_insertion, "keep_borrow", "n", "NOGC-BOR-001"), "container retention did not reject the specific short parameter")
    val reuse = report("fn reuse(xs: [Node], n: &Node) -> i64:\n    xs.push(n)\n    n.v\n", true)
    hir_contract_require(param_effect_report_effect(reuse, "reuse", "n") == "consume", "invalid owner body rewrote its declared consuming interface")
    hir_contract_require(has_param_diag(reuse, "reuse", "n", "NOGC-AMB-001"), "read after container insertion did not diagnose the moved parameter")
    check_import(false, true, "provider", ["error", "error", "error"])
    check_import(false, true, "alias", ["error", "error", "error"])
    check_import(true, true, "alias", ["unique", "shared", "weak"])
    check_import(true, true, "missing", ["error", "error", "error"])
    check_import(false, false, "provider", ["ref", "ptr", "infer"])
    check_import(true, false, "provider", ["ref", "ptr", "infer"])
    print "nogc-hir-contract: pointer effects, short contracts, and import boundary passed"
    0
