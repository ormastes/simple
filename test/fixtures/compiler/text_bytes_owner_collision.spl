struct PointerSize:
    value: i64

    fn bytes() -> i64:
        self.value + 1000

struct UserType:
    value: i64

    fn bytes() -> i64:
        self.value + 2000

struct ArrayOwner:
    value: i64

    fn len() -> i64:
        self.value + 3000

fn hm_hash_text(s: text) -> i64:
    val octets = s.bytes()
    octets.len()

fn user_bytes(value: UserType) -> i64:
    value.bytes()

fn pointer_bytes(value: PointerSize) -> i64:
    value.bytes()

fn array_len(value: [i64]) -> i64:
    value.len()
