pub fn build_unsupported_ops_module(name: text) -> MirModule:
    val i64_type = MirType(kind: MirTypeKind.I64)
    val locals = [
        MirLocal(id: LocalId(id: 0), name: Some("_return"), type_: i64_type, kind: LocalKind.Return),
        MirLocal(id: LocalId(id: 1), name: Some("left"), type_: i64_type, kind: LocalKind.Temp),
        MirLocal(id: LocalId(id: 2), name: Some("right"), type_: i64_type, kind: LocalKind.Temp),
        MirLocal(id: LocalId(id: 3), name: Some("pow"), type_: i64_type, kind: LocalKind.Temp),
        MirLocal(id: LocalId(id: 4), name: Some("transpose"), type_: i64_type, kind: LocalKind.Temp)
    ]
    val value = MirOperand(kind: MirOperandKind.Copy(LocalId(id: 1)))
    val entry = MirBlock(
        id: BlockId.new(0),
        label: Some("entry"),
        instructions: [
