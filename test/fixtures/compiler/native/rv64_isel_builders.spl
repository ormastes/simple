            MirInst(kind: MirInstKind.BinOp(LocalId(id: 6), MirBinOp.Eq, MirOperand(kind: MirOperandKind.Copy(LocalId(id: 1))), MirOperand(kind: MirOperandKind.Copy(LocalId(id: 2)))), span: nil),
