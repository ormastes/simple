pub fn build_unary_module(name: text) -> MirModule:
    val i64_type = MirType(kind: MirTypeKind.I64)
    val locals = [
        MirLocal(id: LocalId(id: 0), name: Some("_return"), type_: i64_type, kind: LocalKind.Return),
        MirLocal(id: LocalId(id: 1), name: Some("value"), type_: i64_type, kind: LocalKind.Temp),
        MirLocal(id: LocalId(id: 2), name: Some("neg"), type_: i64_type, kind: LocalKind.Temp),
        MirLocal(id: LocalId(id: 3), name: Some("not"), type_: i64_type, kind: LocalKind.Temp),
        MirLocal(id: LocalId(id: 4), name: Some("bitnot"), type_: i64_type, kind: LocalKind.Temp)
    ]
    val value = MirOperand(kind: MirOperandKind.Copy(LocalId(id: 1)))
    val entry = MirBlock(
        id: BlockId.new(0),
        label: Some("entry"),
        instructions: [
            MirInst(kind: MirInstKind.Const(LocalId(id: 1), MirConstValue.Int(7), i64_type), span: nil),
            MirInst(kind: MirInstKind.UnaryOp(LocalId(id: 2), MirUnaryOp.Neg, value), span: nil),
            MirInst(kind: MirInstKind.UnaryOp(LocalId(id: 3), MirUnaryOp.Not, value), span: nil),
            MirInst(kind: MirInstKind.UnaryOp(LocalId(id: 4), MirUnaryOp.BitNot, value), span: nil)
        ],
        terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Copy(LocalId(id: 4)))))
    )
    val func = MirFunction(
        symbol: SymbolId.new(0),
        name: name,
        signature: MirSignature(params: [], return_type: i64_type, is_variadic: false),
        locals: locals,
        blocks: [entry],
        entry_block: BlockId.new(0),
        span: Span(start: 0, end: 0, line: 1, col: 1),
        generic_params: [],
        is_generic_template: false,
        specialization_of: nil,
        type_bindings: {}
    )
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[SymbolId.new(0)] = func
    MirModule(name: name, functions: functions, statics: {}, constants: {}, types: {})

