pub fn prologue_block(module: MachModule) -> MachBlock:
    module.functions[0].blocks[0]

pub fn operand_reg_id(op: Operand) -> i64:
    reg_id(operand_get_reg(op))

pub fn operand_imm(op: Operand) -> i64:
    match op.kind:
        case Imm(value): value
        case _: -999

pub fn find_opcode(block: MachBlock, opcode: i64) -> i64:
    for i in 0..block.insts.len():
        if block.insts[i].opcode == opcode:
            return i
    -1

pub fn has_opcode(block: MachBlock, opcode: i64) -> bool:
    find_opcode(block, opcode) >= 0

pub fn count_opcode(block: MachBlock, opcode: i64) -> i64:
    var count = 0
    for inst in block.insts:
        if inst.opcode == opcode:
            count = count + 1
    count

pub fn first_operand_count(block: MachBlock, opcode: i64) -> i64:
    for inst in block.insts:
        if inst.opcode == opcode:
            return inst.operands.len()
    -1

pub fn count_opcode_after_first(block: MachBlock, marker_opcode: i64, opcode: i64) -> i64:
    var seen_marker = false
    var count = 0
    for inst in block.insts:
        if seen_marker and inst.opcode == opcode:
            count = count + 1
        if inst.opcode == marker_opcode:
            seen_marker = true
    count

pub fn mem_offset(op: Operand) -> i64:
    match op.kind:
        case Mem(_, offset): offset
        case _: -1

pub fn mem_base_reg(op: Operand) -> i64:
    match op.kind:
        case Mem(base, _): reg_id(base)
        case _: -1

pub fn nth_mem_offset(block: MachBlock, opcode: i64, nth: i64) -> i64:
    var seen = 0
    for inst in block.insts:
        if inst.opcode == opcode:
            if seen == nth:
                return mem_offset(inst.operands[1])
            seen = seen + 1
    -1

pub fn nth_mem_base_reg(block: MachBlock, opcode: i64, nth: i64) -> i64:
    var seen = 0
    for inst in block.insts:
        if inst.opcode == opcode:
            if seen == nth:
                return mem_base_reg(inst.operands[1])
            seen = seen + 1
    -1

pub fn nth_imm(block: MachBlock, opcode: i64, nth: i64) -> i64:
    var seen = 0
    for inst in block.insts:
        if inst.opcode == opcode:
            if seen == nth:
                match inst.operands[1].kind:
                    case Imm(value): return value
                    case _: return -999
            seen = seen + 1
    -999

pub fn has_li_imm(block: MachBlock, imm: i64) -> bool:
    for inst in block.insts:
        if inst.opcode == RV_OP_LI:
            match inst.operands[1].kind:
                case Imm(value):
                    if value == imm:
                        return true
                case _: ()
    false

pub fn has_large_stack_load(block: MachBlock, opcode: i64, reg: i64) -> bool:
    for i in 0..block.insts.len():
        if i + 2 < block.insts.len():
            if block.insts[i].opcode == RV_OP_LI and operand_imm(block.insts[i].operands[1]) > 2047:
                if block.insts[i + 1].opcode == RV_OP_ADD and block.insts[i + 2].opcode == opcode:
                    if operand_reg_id(block.insts[i + 2].operands[0]) == reg and mem_offset(block.insts[i + 2].operands[1]) == 0:
                        return true
    false

pub fn last_dest_reg(block: MachBlock, opcode: i64) -> i64:
    var found = -1
    for inst in block.insts:
        if inst.opcode == opcode:
            found = reg_id(operand_get_reg(inst.operands[0]))
    found

pub fn nth_dest_reg(block: MachBlock, opcode: i64, nth: i64) -> i64:
    var seen = 0
    for inst in block.insts:
        if inst.opcode == opcode:
            if seen == nth:
                return operand_reg_id(inst.operands[0])
            seen = seen + 1
    -1

pub fn nth_operand_reg(block: MachBlock, opcode: i64, nth: i64, operand_index: i64) -> i64:
    var seen = 0
    for inst in block.insts:
        if inst.opcode == opcode:
            if seen == nth:
                return operand_reg_id(inst.operands[operand_index])
            seen = seen + 1
    -1

pub fn nth_label_id(block: MachBlock, opcode: i64, nth: i64, operand_index: i64) -> i64:
    var seen = 0
    for inst in block.insts:
        if inst.opcode == opcode:
            if seen == nth:
                match inst.operands[operand_index].kind:
                    case Label(id): return id
                    case _: return -1
            seen = seen + 1
    -1

pub fn nth_operand_imm(block: MachBlock, opcode: i64, nth: i64, operand_index: i64) -> i64:
    var seen = 0
    for inst in block.insts:
        if inst.opcode == opcode:
            if seen == nth:
                match inst.operands[operand_index].kind:
                    case Imm(value): return value
                    case _: return -999
            seen = seen + 1
    -999

pub fn nth_sym_name(block: MachBlock, opcode: i64, nth: i64, operand_index: i64) -> text:
    var seen = 0
    for inst in block.insts:
        if inst.opcode == opcode:
            if seen == nth:
                match inst.operands[operand_index].kind:
                    case Sym(name): return name
                    case _: return ""
            seen = seen + 1
    ""
