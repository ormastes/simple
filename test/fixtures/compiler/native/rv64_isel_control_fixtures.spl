use compiler.backend.native.{RV64_WORD_SIZE}
use compiler.backend.native.mach_inst.{
    MachModule, MachBlock, MachReg, MachRegKind, Operand, OperandKind,
    RV_OP_ADD, RV_OP_ADDI, RV_OP_AND, RV_OP_AUIPC, RV_OP_BEQ, RV_OP_BNE, RV_OP_DIV, RV_OP_JAL, RV_OP_JALR, RV_OP_LI, RV_OP_MUL, RV_OP_NEG, RV_OP_NOP, RV_OP_NOT, RV_OP_OR, RV_OP_REM, RV_OP_ROL, RV_OP_ROR, RV_OP_CLZ, RV_OP_CTZ, RV_OP_REV8, RV_OP_SEQZ, RV_OP_SLL, RV_OP_SLT, RV_OP_SNEZ, RV_OP_SRA, RV_OP_SUB, RV_OP_XOR,
    RV_OP_LD, RV_OP_SD, RV_OP_LW, RV_OP_SW, RV_OP_CALL, RV_OP_MV, RV_OP_RET, RV_X0, RV_X1, RV_X2, RV_X8, RV_X10, RV_X11, RV_X12, RV_X13, RV_X14, RV_X15, RV_X16, RV_X17,
    reg_id, operand_get_reg
}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}

pub fn build_if_module(name: text) -> MirModule:
    val i64_type = MirType(kind: MirTypeKind.I64)
    val locals = [
        MirLocal(id: LocalId(id: 0), name: Some("_return"), type_: i64_type, kind: LocalKind.Return),
        MirLocal(id: LocalId(id: 1), name: Some("cond"), type_: i64_type, kind: LocalKind.Temp)
    ]
    val entry = MirBlock(
        id: BlockId.new(0),
        label: Some("entry"),
        instructions: [
            MirInst(kind: MirInstKind.Const(LocalId(id: 1), MirConstValue.Int(1), i64_type), span: nil)
        ],
        terminator: MirTerminator.If(MirOperand(kind: MirOperandKind.Copy(LocalId(id: 1))), BlockId.new(1), BlockId.new(2))
    )
    val then_block = MirBlock(
        id: BlockId.new(1),
        label: Some("then"),
        instructions: [],
        terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Copy(LocalId(id: 1)))))
    )
    val else_block = MirBlock(
        id: BlockId.new(2),
        label: Some("else"),
        instructions: [],
        terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Copy(LocalId(id: 1)))))
    )
    val func = MirFunction(
        symbol: SymbolId.new(0),
        name: name,
        signature: MirSignature(params: [], return_type: i64_type, is_variadic: false),
        locals: locals,
        blocks: [entry, then_block, else_block],
        entry_block: BlockId.new(0),
        span: Span(start: 0, end: 0, line: 1, col: 1),
        generic_params: [],
        is_generic_template: false,
        specialization_of: nil,
        type_bindings: {}
    )
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[SymbolId.new(0)] = func
    MirModule(name: name, functions: functions, statics: {}, constants: {}, types: {})

pub fn build_switch_module(name: text) -> MirModule:
    val i64_type = MirType(kind: MirTypeKind.I64)
    val locals = [
        MirLocal(id: LocalId(id: 0), name: Some("_return"), type_: i64_type, kind: LocalKind.Return),
        MirLocal(id: LocalId(id: 1), name: Some("value"), type_: i64_type, kind: LocalKind.Temp)
    ]
    val entry = MirBlock(
        id: BlockId.new(0),
        label: Some("entry"),
        instructions: [
            MirInst(kind: MirInstKind.Const(LocalId(id: 1), MirConstValue.Int(2), i64_type), span: nil)
        ],
        terminator: MirTerminator.Switch(
            MirOperand(kind: MirOperandKind.Copy(LocalId(id: 1))),
            [SwitchCase(value: 2, target: BlockId.new(1))],
            BlockId.new(2)
        )
    )
    val matched = MirBlock(
        id: BlockId.new(1),
        label: Some("matched"),
        instructions: [],
        terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Copy(LocalId(id: 1)))))
    )
    val default_block = MirBlock(
        id: BlockId.new(2),
        label: Some("default"),
        instructions: [],
        terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Copy(LocalId(id: 1)))))
    )
    val func = MirFunction(
        symbol: SymbolId.new(0),
        name: name,
        signature: MirSignature(params: [], return_type: i64_type, is_variadic: false),
        locals: locals,
        blocks: [entry, matched, default_block],
        entry_block: BlockId.new(0),
        span: Span(start: 0, end: 0, line: 1, col: 1),
        generic_params: [],
        is_generic_template: false,
        specialization_of: nil,
        type_bindings: {}
    )
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[SymbolId.new(0)] = func
    MirModule(name: name, functions: functions, statics: {}, constants: {}, types: {})

