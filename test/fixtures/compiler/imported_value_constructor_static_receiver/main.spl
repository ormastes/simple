# Pattern: imported enum used as a STATIC constructor receiver across a module
# boundary (Value.Int(..), Value.Text(..), unit variant Value.Unit).
# Stage3 repro: bin/simple.exe native-build test/fixtures/compiler/imported_value_constructor_static_receiver/main.spl -o out.exe && ./out.exe
# Expected stdout (exit 0):
#   imported_value_constructor_static_receiver ok
# Baked producer defect: lowered the imported `Value` receiver as a runtime value
# (undefined receiver / unresolved Int(...) call) instead of a static enum owner.
# Bug: imported_value_constructor_static_receiver_native_2026_10_16
use .owner.{Value, value_int}

fn main() -> i64:
    val a = Value.Int(7)
    val b = value_int(7)
    val t = Value.Text("x")
    val u = Value.Unit
    var score = 0
    match a:
        case Value.Int(n): score = score + n
        case _: return 1
    match b:
        case Value.Int(n): score = score + n
        case _: return 2
    match t:
        case Value.Text(s): if s != "x": return 3
        case _: return 4
    match u:
        case Value.Unit: score = score + 1
        case _: return 5
    if score != 15: return 6
    print "imported_value_constructor_static_receiver ok"
    0
