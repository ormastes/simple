# Isolate the native process-output/text split boundary used by SCV refresh.
# This fixture reads Git metadata only; it does not mutate the checkout.
use app.io.process_ops.{process_run_bounded}

fn main() -> i64:
    val literal_rows = "true\n".split("\n")
    if literal_rows.len() != 2 or literal_rows[0] != "true":
        print "PROCESS_OUTPUT_ABI_LITERAL_SPLIT_FAIL"
        return 1
    val (stdout, _stderr, status) = process_run_bounded(
        "git", ["rev-parse", "--is-inside-work-tree"], 10000, 1024 * 1024)
    if status != 0:
        print "PROCESS_OUTPUT_ABI_GIT_STATUS_FAIL"
        return 2
    if stdout.trim() != "true":
        print "PROCESS_OUTPUT_ABI_STDOUT_FAIL"
        return 3
    val rows = stdout.split("\n")
    if rows.len() != 2 or rows[0] != "true":
        print "PROCESS_OUTPUT_ABI_GIT_SPLIT_FAIL"
        return 4
    print "PROCESS_OUTPUT_ABI_PASS"
    0
