fn checksum(xs: [u32]) -> i64:
    var h: i64 = 7
    var i: i64 = 0
    while i < xs.len():
        h = (h * 31 + xs[i].to_i64()) % 1000000007
        i = i + 1
    h

fn main() -> i64:
    # In-range write_span stress: framebuffer-style row fills, a self-overlapping
    # scroll, and a zero-count call. Every call is in range by construction.
    val w: i64 = 320
    val h: i64 = 200
    var fb: [u32] = [0u32; w * h]
    var y: i64 = 0
    while y < h:
        val row: [u32] = [(y * 2654435761u32.to_i64()) as u32; w]
        fb.write_span(row, y * w, 0, w)
        y = y + 1
    val moved = fb.write_span(fb, 0, w * 10, w * 50)
    val zero = fb.write_span(fb, 0, 0, 0)
    print "moved={moved} zero={zero} sum={checksum(fb)}"
    0
