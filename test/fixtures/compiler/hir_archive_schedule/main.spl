# Run separately with SIMPLE_HIR_SHARD empty and 0/1. The same real frozen
# import graph must retain distinct identity/topological visit schedules.
use compiler.driver.cache.driver_hir_archive_schedule_v1.*
use compiler.driver.driver_hir_archive_schedule_owner_v1.*
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_hir_cache.{hir_shard_active}
use compiler.common.driver_core_types.{SourceFile, source_file_authored_path,
    driver_core_compile_options_default}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfaceBuilder, ModuleSurfacesByName}
use compiler.hir.hir_lowering.module_surface_registry.*
use compiler.common.config.{Logger}
use std.nogc_sync_mut.io_runtime.{file_read_nullable}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end}

extern fn rt_hash_text(content: text) -> i64

fn retained_hash(content: text) -> i64:
    val hash = rt_hash_text(content)
    if hash == 0: 1 else: hash

fn main() -> i64:
    val consumer_path = "test/fixtures/compiler/hir_archive_schedule/consumer.spl"
    val provider_path = "test/fixtures/compiler/hir_archive_schedule/provider.spl"
    val consumer_text = file_read_nullable(consumer_path) ?? ""
    val provider_text = file_read_nullable(provider_path) ?? ""
    if consumer_text == "" or provider_text == "": return 1
    val consumer = SourceFile(path: consumer_path,
        content: consumer_text, module_name: "schedule_consumer")
    val provider = SourceFile(path: provider_path,
        content: provider_text, module_name: "schedule_provider")
    if consumer.authored_path != "" or provider.authored_path != "" or
            source_file_authored_path(consumer) != consumer_path or
            source_file_authored_path(provider) != provider_path: return 25
    val alias_loaded = SourceFile.load("./" + provider_path)
    if alias_loaded.is_err(): return 22
    val alias = SourceFile(..alias_loaded.unwrap(), module_name: "schedule_alias")
    if alias.authored_path == provider.authored_path or alias.content != provider_text: return 23
    val builder = ModuleSurfaceBuilder.new()
    if builder.add_parsed(parse_full_frontend(consumer_text, consumer_path, "schedule_consumer", Logger(level: 0)), consumer, 0).is_err(): return 2
    if builder.add_parsed(parse_full_frontend(provider_text, provider_path, "schedule_provider", Logger(level: 0)), provider, 1).is_err(): return 3
    if builder.add_alias(alias).is_err(): return 4
    val surfaces = ModuleSurfacesByName.empty()
    if builder.finish_into(surfaces) != "": return 5
    val driver = CompilerDriver.create(driver_core_compile_options_default())
    driver.ctx.source_paths_owner = [consumer_path, provider_path, alias.path]
    driver.ctx.source_authored_paths_owner = [source_file_authored_path(consumer),
        source_file_authored_path(provider), source_file_authored_path(alias)]
    driver.ctx.source_module_names_owner = ["schedule_consumer", "schedule_provider", "schedule_alias"]
    driver.ctx.source_identities_owner = [sha256_text(consumer_text), sha256_text(provider_text), sha256_text(provider_text)]
    driver.ctx.source_byte_lengths_owner = [consumer_text.len(), provider_text.len(), provider_text.len()]
    driver.ctx.source_content_hashes_owner = [retained_hash(consumer_text), retained_hash(provider_text), retained_hash(provider_text)]
    if not driver.capture_hir_archive_streaming_schedule_v1().is_err(): return 6
    var checks = 1
    driver.streaming_module_surfaces_owner = surfaces
    driver.streaming_surface_owner_ready = true
    driver.streaming_entry_source_index_owner = 0
    val captured_result = driver.capture_hir_archive_streaming_schedule_v1()
    if captured_result.is_err(): return 7
    val captured = captured_result.unwrap()
    if captured.source_to_surface != [0, 1, 1] or captured.entry_source_index != 0 or
            captured.source_binding.len() != 64 or captured.closure_digest.len() != 64 or
            captured.schedule_digest.len() != 64 or captured.surface_generation != surfaces.generation: return 8
    checks = checks + 1
    val full_publication = driver.verify_hir_archive_full_publication_schedule_v1()
    if full_publication.is_err() != hir_shard_active(): return 24
    checks = checks + 1
    val expected_visits: [i64] = if hir_shard_active(): [1, 2, 0] else: [0, 1, 2]
    val expected_first: [i64] = if hir_shard_active(): [1, 1, 0] else: [0, 1, 1]
    val expected_layout: [i64] = if hir_shard_active(): [1, 0] else: [0, 1]
    val expected_logical: [text] = if hir_shard_active(): ["schedule_provider", "schedule_alias", "schedule_consumer"] else:
        ["schedule_consumer", "schedule_provider", "schedule_alias"]
    if captured.visit_order != expected_visits or captured.first_source_for_visit != expected_first or
            captured.layout_source_order != expected_layout or captured.logical_publication_order != expected_logical or
            captured.shard_mode != hir_shard_active(): return 9
    checks = checks + 1
    if captured.layout_module_order != [surfaces.surfaces[captured.source_to_surface[expected_layout[0]]].logical_name,
            surfaces.surfaces[captured.source_to_surface[expected_layout[1]]].logical_name]: return 10
    checks = checks + 1
    if driver.verify_hir_archive_streaming_schedule_v1().is_err() or transient_array_scope_state_v1() != 0: return 11
    checks = checks + 1
    var changed = captured
    changed.visit_order = [2, 1, 0]
    if not driver_hir_archive_schedule_verify_streaming_owner_v1(driver.ctx, surfaces, 0, changed).is_err(): return 12
    checks = checks + 1
    changed = captured
    changed.first_source_for_visit = [0, 1, 2]
    if not driver_hir_archive_schedule_verify_streaming_owner_v1(driver.ctx, surfaces, 0, changed).is_err(): return 13
    checks = checks + 1
    changed = captured
    changed.layout_source_order = [0, 1, 2]
    if not driver_hir_archive_schedule_verify_streaming_owner_v1(driver.ctx, surfaces, 0, changed).is_err(): return 14
    checks = checks + 1
    val identities = driver.ctx.source_identities_owner
    driver.ctx.source_identities_owner = [identities[0], identities[1], sha256_text("edited alias bytes")]
    if not driver.verify_hir_archive_streaming_schedule_v1().is_err(): return 15
    driver.ctx.source_identities_owner = identities
    checks = checks + 1
    driver.streaming_entry_source_index_owner = 1
    if not driver.verify_hir_archive_streaming_schedule_v1().is_err(): return 16
    driver.streaming_entry_source_index_owner = 0
    checks = checks + 1
    if not transient_scope_begin(): return 17
    val active_refused = driver.verify_hir_archive_streaming_schedule_v1().is_err()
    if not transient_scope_pause(): return 18
    val paused_refused = driver.capture_hir_archive_streaming_schedule_v1().is_err()
    if not active_refused or not paused_refused or transient_array_scope_state_v1() != 2 or not transient_scope_end(): return 19
    checks = checks + 1
    var repeat = 0
    while repeat < 20:
        if driver.verify_hir_archive_streaming_schedule_v1().is_err() or transient_array_scope_state_v1() != 0: return 20
        repeat = repeat + 1
    checks = checks + 1
    if checks != 13: return 21
    print "HIR archive streaming schedule: {checks} checks passed shard={hir_shard_active()}"
    0
