# Actual managed runtime and real frozen source closure are mandatory. This
# exercises policy capture/replay, not completed transform/final admission.
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_hir_archive_schedule_owner_v1.*
use compiler.driver.driver_hir_post_validation_policy_owner_v1.*
use compiler.driver.cache.driver_hir_post_validation_policy_v1.*
use compiler.driver.cache.driver_hir_weave_source_policy_v1.{driver_hir_weave_source_policy_v1}
use compiler.driver.cache.driver_hir_managed_runtime_selection_v1.*
use compiler.driver.cache.driver_hir_archive_journal_v1.*
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{hir_owned_artifact_load_blob_v1, hir_owned_artifact_store_blob_v1}
use compiler.driver.cache.hir_body_typecheck_lease_v1.*
use compiler.driver.driver_hir_cache.{hir_cache_promote_diagnostic_owner_v1, hir_cache_clear_last_warnings}
use compiler.mono.mono_archive_registration_v1.*
use compiler.common.driver_core_types.{SourceFile, driver_core_compile_options_default}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfaceBuilder, ModuleSurfacesByName}
use compiler.hir.hir_lowering.module_surface_registry.*
use compiler.common.config.{Logger}
use compiler.semantics.layer_eq_validation.*
use compiler.semantics.layer_eq_checker.{LayerEqType}
use compiler.semantics.effect_validation.*
use compiler.semantics.rt_criticality_validation.*
use compiler.semantics.rt_criticality.{RtCriticalDiagnosticSeverity, RtBoundCapability, RT_EFFECT_ALLOC,
    rt_closure_digest, rt_bound_manifest_replace, rt_bound_manifest_clear, rt_bound_manifest_capabilities}
use compiler.semantics.aspect_validation.*
use compiler.semantics.aspect_weave.{aspect_forward_weave_contract_claims_v1}
use compiler.semantics.join_point_model.{forward_join_points_for_module_v1}
use compiler.frontend.layer_eq_registry.{layer_eq_registry_reset, layer_eq_registry_claim_keys}
use compiler.frontend.effect_registry.{effect_registry_reset, effect_registry_claim_keys}
use compiler.frontend.rt_criticality_registry.{rt_criticality_reset, rt_criticality_claim_keys}
use compiler.frontend.aspect_registry.{aspect_registry_reset, aspect_registry_claim_keys}
use std.common.crypto.sha256.{sha256_text}
use std.env.{env_get}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end, transient_promote}

extern fn rt_hash_text(content: text) -> i64

struct PolicyObservedV1:
    layer_errors: [text]
    effect_errors: [text]
    rt_errors: [text]
    rt_denied_errors: [text]
    aspect_errors: [text]
    weave_claims: i64
    layer_claims: i64
    effect_claims: i64
    rt_claims: i64
    aspect_claims: i64
    capability_count: i64
    capability: RtBoundCapability

fn actual_array_capability(module: HirModule) -> Result<RtBoundCapability, text>:
    val declarations = rt_module_function_declarations_v1(module.name, module)
    val names = rt_unambiguous_declaration_names_v1(declarations)
    var rows: [RtCriticalFunctionFactsV1] = []
    var root = ""
    for func in module.functions.values():
        val row = rt_function_facts_v1(module.name, module, func, names)
        rows.push(row)
        if row.declaration.name == "array_value":
            root = rt_stable_fn_id(row.declaration.module_key, row.declaration.symbol_id)
    if root == "": return Err("fixture actual allocation root absent")
    Ok(RtBoundCapability(subject_id: root, closure_digest: rt_closure_digest(root, rt_criticality_graph_facts_v1(rows)),
        effect: RT_EFFECT_ALLOC, max_units: 1, review_id: "FIXTURE-ACTUAL-POLICY-ALLOC-ONE"))

fn observe_in_scope(owner: DriverHirPostValidationPolicyOwnerV1,
        archive: HirBodyArchiveV1) -> Result<PolicyObservedV1, text>:
    val policy = driver_hir_post_validation_policy_load_in_owned_scope_v1(owner)?
    if policy.capabilities.len() != 1: return Err("fixture actual bound capability missing")
    val module = hir_body_archive_load_in_owned_scope_v1(archive, archive.input)?
    val ids = [module.path, module.name, "policy.logical_alias"]
    val identity_index = {module.path: true, module.name: true, "policy.logical_alias": true}
    val by_name = layer_eq_index_structs({module.name: module})
    val required = layer_eq_required_claim_declaration_names_v1(ids, by_name.keys(), policy.layer)
    var layouts: [LayerEqType] = []
    for name in required: layouts.push(layer_eq_struct_declaration_v1(by_name[name]))
    val sizes = effect_struct_sizes_for_module_v1(module)
    val names = effect_fn_names_for_module_v1(module)
    var effect_rows: [EffectFunctionFactsV1] = []
    for func in module.functions.values(): effect_rows.push(effect_function_facts_v1(func, sizes, names))
    val declarations = rt_module_function_declarations_v1(module.name, module)
    val rt_names = rt_unambiguous_declaration_names_v1(declarations)
    var rt_rows: [RtCriticalFunctionFactsV1] = []
    for func in module.functions.values(): rt_rows.push(rt_function_facts_v1(module.name, module, func, rt_names))
    var rt_errors: [text] = []
    for diagnostic in validate_rt_criticality_claim_facts_v1(ids, rt_rows, policy.capabilities, policy.rt, policy.implicit_rt_error):
        if diagnostic.severity == RtCriticalDiagnosticSeverity.Error: rt_errors.push(diagnostic.message)
    var rt_denied: [text] = []
    for diagnostic in validate_rt_criticality_claim_facts_v1(ids, rt_rows, [], policy.rt, policy.implicit_rt_error):
        if diagnostic.severity == RtCriticalDiagnosticSeverity.Error: rt_denied.push(diagnostic.message)
    val forwards = forward_join_points_for_module_v1(module, 0)
    Ok(PolicyObservedV1(
        layer_errors: validate_layer_eq_claim_declarations_v1(ids, by_name.keys(), layouts, policy.layer),
        effect_errors: validate_effect_claim_facts_v1(ids, effect_rows, policy.effects), rt_errors: rt_errors,
        rt_denied_errors: rt_denied,
        aspect_errors: validate_aspect_claim_join_points_v1(identity_index, forwards, policy.aspects),
        weave_claims: aspect_forward_weave_contract_claims_v1(identity_index, forwards, policy.aspects).len(),
        layer_claims: policy.layer.len(), effect_claims: policy.effects.len(), rt_claims: policy.rt.len(),
        aspect_claims: policy.aspects.len(), capability_count: policy.capabilities.len(), capability: policy.capabilities[0]))

fn observe(owner: DriverHirPostValidationPolicyOwnerV1, archive: HirBodyArchiveV1) -> Result<PolicyObservedV1, text>:
    if not transient_scope_begin(): return Err("fixture observation lease refused")
    val result = observe_in_scope(owner, archive)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val memo = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not owned or not memo or not ended: panic("fixture policy observation ownership")
    result

fn registration(journal: DriverHirArchiveJournalV1, archive: HirBodyArchiveV1) -> Result<MonoArchiveRegistrationReceiptV1, text>:
    if not transient_scope_begin(): return Err("fixture declaration lease refused")
    val loaded = hir_body_archive_load_in_owned_scope_v1(archive, archive.input)
    val result: Result<MonoArchiveRegistrationReceiptV1, text> = if loaded.is_err(): Err(loaded.unwrap_err()) else:
        mono_archive_collect_registration_in_owned_scope_v1(journal.registration, loaded.unwrap(), archive.input.module_name, archive)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val memo = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not owned or not memo or not ended: panic("fixture declaration ownership")
    result

# Store an integrity-valid envelope with extra payload bytes. The policy reader
# must reject framing independently of the raw owner's checksum and key checks.
fn trailing_frame_in_scope(owner: DriverHirPostValidationPolicyOwnerV1) -> Result<DriverHirPostValidationPolicyOwnerV1, text>:
    val frame = hir_owned_artifact_load_blob_v1(owner.cache, owner.artifact_key)? + "trailing-policy-data\n"
    val digest = sha256_text(frame)
    val key = sha256_text("driver-hir-post-validation-policy-artifact-v1\n" + digest + "\n" +
        owner.schedule_digest + "\n" + owner.journal_key + "\n" + owner.cache.producer_header)
    val stored = hir_owned_artifact_store_blob_v1(owner.cache, key, frame)?
    if not stored: return Err("fixture trailing frame store refused")
    Ok(DriverHirPostValidationPolicyOwnerV1(..owner, artifact_key: key, artifact_digest: digest))

fn trailing_frame(owner: DriverHirPostValidationPolicyOwnerV1) -> Result<DriverHirPostValidationPolicyOwnerV1, text>:
    if not transient_scope_begin(): return Err("fixture trailing frame lease refused")
    val result = trailing_frame_in_scope(owner)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended: panic("fixture trailing frame ownership")
    result

fn main() -> i64:
    val selected_result = driver_hir_capture_managed_runtime_selection_v1("llvm",
        env_get("SIMPLE_NATIVE_BUILD_TARGET"), env_get("SIMPLE_NATIVE_RUNTIME_BUNDLE"))
    if selected_result.is_err(): return 1
    val selected = selected_result.unwrap()
    val path = "test/fixtures/compiler/hir_post_validation_policy/provider.spl"
    val name = "policy.provider"
    val loaded_source = SourceFile.load(path)
    if loaded_source.is_err(): return 2
    val source = SourceFile(..loaded_source.unwrap(), module_name: name)
    val alternate_source = SourceFile.load("./" + path)
    if alternate_source.is_err(): return 29
    val alias = SourceFile(..alternate_source.unwrap(), module_name: "policy.logical_alias")
    if alias.authored_path == source.authored_path or alias.content != source.content: return 30
    val parsed = parse_full_frontend(source.content, path, name, Logger(level: 0))
    val builder = ModuleSurfaceBuilder.new()
    if builder.add_parsed(parsed, source, 0).is_err() or
            builder.add_alias(alias).is_err(): return 3
    val surfaces = ModuleSurfacesByName.empty()
    if builder.finish_into(surfaces) != "": return 4
    val driver = CompilerDriver.create(driver_core_compile_options_default())
    driver.ctx.source_paths_owner = [source.path, alias.path]
    driver.ctx.source_authored_paths_owner = [source.authored_path, alias.authored_path]
    driver.ctx.source_module_names_owner = [name, "policy.logical_alias"]
    driver.ctx.source_identities_owner = [sha256_text(source.content), sha256_text(source.content)]
    driver.ctx.source_byte_lengths_owner = [source.content.len(), source.content.len()]
    val raw_hash = rt_hash_text(source.content)
    val retained_hash = if raw_hash == 0: 1 else: raw_hash
    driver.ctx.source_content_hashes_owner = [retained_hash, retained_hash]
    driver.streaming_module_surfaces_owner = surfaces
    driver.streaming_surface_owner_ready = true
    driver.streaming_entry_source_index_owner = -1
    val schedule_result = driver.capture_hir_archive_streaming_schedule_v1()
    if schedule_result.is_err(): return 5
    val schedule = schedule_result.unwrap()
    var lowering = HirLowering.with_filename(path)
    val module = lowering.lower_parser_module_unstub(parsed, false)
    val actual_capability = actual_array_capability(module)
    if actual_capability.is_err(): return 35
    val capability = actual_capability.unwrap()
    rt_bound_manifest_replace([capability])
    val input = HirBodyArchiveInputV1(source_path: path, module_name: name, is_entry: false,
        closure_digest: schedule.closure_digest, runtime_provider_receipt_path: selected.provider.snapshot.path,
        runtime_provider_digest: selected.provider.snapshot.digest, producer_header: selected.producer_header,
        stage: "lowered-unresolved-v1", provider_selection_digest: selected.selection_digest,
        source_content_digest: sha256_text(source.content), source_authored_path: source.authored_path)
    val stored = hir_body_archive_store_v1(input, module, ["policy lowering warning"])
    if stored.is_err(): return 6
    val archive = stored.unwrap()
    val journal_result = driver_hir_archive_journal_create_v1(driver.ctx, selected)
    if journal_result.is_err(): return 7
    val journal = journal_result.unwrap()
    driver.hir_archive_publication_journal = Some(journal)
    if not driver.capture_hir_archive_post_validation_policy_v1().is_err(): return 8
    var checks = 1
    val receipt = registration(journal, archive)
    if receipt.is_err() or driver_hir_archive_journal_publish_v1(journal, driver.ctx, 0, name, receipt.unwrap()).is_err(): return 9
    if driver_hir_archive_journal_alias_v1(journal, driver.ctx, 1, "policy.logical_alias", name).is_err(): return 10
    val captured = driver.capture_hir_archive_post_validation_policy_v1()
    if captured.is_err(): return 11
    val owner = captured.unwrap()
    if owner.schedule_digest != schedule.schedule_digest or owner.journal_key != journal.last_key or
            owner.registration_epoch != journal.registration_epoch or owner.selection_digest != selected.selection_digest or
            owner.artifact_key.len() != 64 or owner.artifact_digest.len() != 64: return 12
    checks = checks + 1
    if not driver.capture_hir_archive_post_validation_policy_v1().is_err(): return 13
    checks = checks + 1
    val first_result = observe(owner, archive)
    if first_result.is_err(): return 14
    val first = first_result.unwrap()
    if first.layer_claims != 1 or first.effect_claims != 1 or first.rt_claims != 1 or first.aspect_claims != 1 or
            first.capability_count != 1 or first.capability.subject_id != capability.subject_id or
            first.capability.closure_digest != capability.closure_digest or first.capability.effect != capability.effect or
            first.capability.max_units != capability.max_units or first.capability.review_id != capability.review_id or
            first.layer_errors.len() != 0 or first.aspect_errors.len() != 0 or first.weave_claims != 1: return 15
    checks = checks + 1
    if first.effect_errors.len() != 1 or not first.effect_errors[0].contains("24 bytes (24 from callees)"): return 16
    checks = checks + 1
    if first.rt_errors.len() != 0 or first.rt_denied_errors.len() != 1 or
            not first.rt_denied_errors[0].contains("RT-E-UNBOUNDED-ALLOCATION"): return 17
    checks = checks + 1
    val source_ids = [path, name, "policy.logical_alias"]
    if driver_hir_weave_source_policy_v1(driver, owner, archive, 0, source_ids).is_err() or
            layer_eq_registry_claim_keys().len() != 1 or effect_registry_claim_keys().len() != 1 or
            rt_criticality_claim_keys().len() != 1 or aspect_registry_claim_keys().len() != 1 or
            rt_bound_manifest_capabilities().len() != 1 or
            rt_bound_manifest_capabilities()[0].review_id != capability.review_id: return 38
    checks = checks + 1
    if rt_bound_manifest_capabilities().len() != 1 or
            validate_rt_criticality_diagnostics({module.name: module}).len() != 0 or
            rt_bound_manifest_capabilities().len() != 0: return 36
    checks = checks + 1
    layer_eq_registry_reset()
    effect_registry_reset()
    rt_criticality_reset()
    aspect_registry_reset()
    if driver_hir_weave_source_policy_v1(driver, owner, archive, 0, source_ids).is_err() or
            layer_eq_registry_claim_keys().len() != 0 or effect_registry_claim_keys().len() != 0 or
            rt_criticality_claim_keys().len() != 0 or aspect_registry_claim_keys().len() != 0 or
            rt_bound_manifest_capabilities().len() != 0: return 39
    checks = checks + 1
    # A genuine mechanical capture after registry loss still has a valid raw
    # envelope. It cannot omit source obligations at the actual weave boundary.
    val omitted = driver_hir_post_validation_policy_capture_v1(driver.ctx, schedule, journal)
    if omitted.is_err() or not driver_hir_weave_source_policy_v1(driver, omitted.unwrap(), archive, 0, source_ids).is_err(): return 40
    checks = checks + 1
    val authored_rows = driver.ctx.source_authored_paths_owner
    driver.ctx.source_authored_paths_owner = []
    val alignment_refused = driver_hir_weave_source_policy_v1(driver, owner, archive, 0, source_ids).is_err()
    driver.ctx.source_authored_paths_owner = authored_rows
    if not alignment_refused or driver_hir_weave_source_policy_v1(driver, owner, archive, 0, source_ids).is_err(): return 41
    checks = checks + 1
    if not transient_scope_begin() or not transient_scope_pause(): return 42
    val foreign_refused = driver_hir_weave_source_policy_v1(driver, owner, archive, 0, source_ids).is_err()
    if not foreign_refused or transient_array_scope_state_v1() != 2 or not transient_scope_end(): return 43
    checks = checks + 1
    val replay_result = observe(owner, archive)
    if replay_result.is_err(): return 18
    val replay = replay_result.unwrap()
    if replay.effect_errors != first.effect_errors or replay.rt_errors != first.rt_errors or
            replay.rt_denied_errors != first.rt_denied_errors or replay.capability.closure_digest != capability.closure_digest or
            replay.layer_errors != first.layer_errors or replay.aspect_errors != first.aspect_errors or replay.weave_claims != 1: return 19
    checks = checks + 1
    val next_capability = RtBoundCapability(..capability, max_units: 0, review_id: "FIXTURE-NEXT-COMPILATION")
    rt_bound_manifest_replace([next_capability])
    val next_replay = observe(owner, archive)
    if next_replay.is_err() or next_replay.unwrap().rt_errors.len() != 0 or
            rt_bound_manifest_capabilities().len() != 1 or
            rt_bound_manifest_capabilities()[0].max_units != 0 or
            rt_bound_manifest_capabilities()[0].review_id != next_capability.review_id: return 37
    rt_bound_manifest_clear()
    checks = checks + 1
    var changed = owner
    changed.artifact_digest = sha256_text("cleared diagnostic policy")
    if not observe(changed, archive).is_err(): return 20
    checks = checks + 1
    changed = owner
    changed.source_binding = sha256_text("another source inventory")
    if not observe(changed, archive).is_err(): return 21
    checks = checks + 1
    if not transient_scope_begin(): return 22
    if not transient_scope_pause(): return 23
    val refused = driver_hir_post_validation_policy_load_in_owned_scope_v1(owner).is_err()
    if not refused or transient_array_scope_state_v1() != 2 or not transient_scope_end(): return 24
    checks = checks + 1
    if observe(owner, archive).is_err() or transient_array_scope_state_v1() != 0: return 25
    checks = checks + 1
    val trailing = trailing_frame(owner)
    if trailing.is_err(): return 26
    if not observe(trailing.unwrap(), archive).is_err(): return 27
    checks = checks + 1
    val inventory = driver_hir_archive_journal_inventory_v1(journal, driver.ctx)
    if inventory.is_err(): return 31
    if inventory.unwrap().logical_rows[1].authored_path != alias.authored_path or
            inventory.unwrap().ordered_archives.len() != 1 or
            inventory.unwrap().ordered_archives[0].input.source_authored_path != source.authored_path: return 32
    checks = checks + 1
    driver.ctx.source_authored_paths_owner[1] = source.authored_path
    val altered_author_refused = driver_hir_archive_journal_verify_v1(journal, driver.ctx).is_err()
    driver.ctx.source_authored_paths_owner[1] = alias.authored_path
    if not altered_author_refused or driver_hir_archive_journal_verify_v1(journal, driver.ctx).is_err(): return 33
    checks = checks + 1
    driver.ctx.source_identities_owner[1] = sha256_text("different physical alias bytes")
    val altered_source_refused = driver_hir_archive_journal_verify_v1(journal, driver.ctx).is_err()
    driver.ctx.source_identities_owner[1] = sha256_text(source.content)
    if not altered_source_refused or driver_hir_archive_journal_verify_v1(journal, driver.ctx).is_err(): return 34
    checks = checks + 1
    if checks != 22: return 28
    print "HIR post-validation policy: {checks} checks passed"
    0
