@layer_eq(Device)
struct View:
    @layer_field(w)
    width: i64 = 37

struct Device:
    w: i64

struct Blob:
    a: i64
    b: i64
    c: i64

fn helper(src: Blob) -> i64:
    val duplicate: Blob = src
    duplicate.a

@copy_budget(8)
fn outer(src: Blob) -> i64:
    helper(src)

@rt(critical)
fn array_value() -> [i64]:
    [1, 2]

fn submit_impl(value: i64) -> i64:
    value + 1

fn submit_view(value: i64) -> i64:
    submit_impl(value)

@advice(forward, submit_view)
@readonly
@noalloc
@bounded_time
fn trace_submit():
    val zero: i64 = 0
    val observed = 1 / zero
