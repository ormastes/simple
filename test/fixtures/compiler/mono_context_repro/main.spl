# Original implicit-call regression. Compile and execute with the repaired producer.
fn failure<T>(message: text) -> Result<T, text>:
    Err(message)

fn integer_failure() -> Result<i64, text>:
    failure("integer")

fn array_failure() -> Result<[text], text>:
    failure("array")

fn main() -> i32:
    val integer = integer_failure()
    val array = array_failure()
    if not integer.is_err() or integer.unwrap_err() != "integer":
        return 1
    if not array.is_err() or array.unwrap_err() != "array":
        return 2
    0
