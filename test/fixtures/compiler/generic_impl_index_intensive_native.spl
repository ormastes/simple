# UNRUN. Actual production collector; same fixture bytes for baseline/candidate.
extern fn rt_exit(code: i64)
# Existing runtime ABI, monotonic microseconds (runtime.h).
extern fn rt_time_now_micros() -> i64
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.HirModule
use compiler.hir.hir_definitions.{HirImpl, HirFunction, HirParam, HirExpr, HirExprKind}
use compiler.hir.hir_codec.hir_module_encode
use compiler.hir.hir_codec_support.HirCodecWriter
use compiler.hir.generated.hir_codec.{hc_enc_hir_function, hc_enc_hir_type_param}
use compiler.mono.monomorphize_integration.MonomorphizationPass
use compiler.mono.mono_archive_types_v1.{MonoTemplateBodyModeV1,
    MonoTemplateRecipeV1, mono_template_signature_digest_v1, mono_apply_template_recipe_v1}
use std.common.crypto.sha256.sha256_text

fn intensive_lower(source: text, name: text) -> HirModule:
    val parsed = parse_full_frontend(source, name + ".spl", name, Logger(level: 0))
    var lowering = HirLowering.with_filename(name + ".spl")
    val module = lowering.lower_module(parsed)
    if lowering.errors.len() != 0 or module.functions.len() == 0: rt_exit(1)
    module

fn intensive_source(count: i64, shape: i64) -> text:
    var parts: [text] = []
    for index in 0..count:
        parts = parts.push("fn work_{index}(value: i64) -> i64:\n    val first = value + {index}\n    val second = first * 3\n    second - value\n")
    if shape > 0:
        parts = parts.push("class Plain:\n    value: i64\nimpl Plain:\n    fn read() -> i64:\n        self.value\n")
    if shape == 6:
        for index in 0..32:
            parts = parts.push("class Box_{index}<T>:\n    value: T\nimpl Box_{index}<T>:\n    fn read(extra: i64 = 7) -> T:\n        self.value\n")
    elif shape > 1:
        parts = parts.push("class Box<T>:\n    value: T\nimpl Box<T>:\n    fn read(extra: i64 = 7) -> T:\n        self.value\n")
    parts.join("\n")

fn intensive_function_digest(func: HirFunction) -> text:
    var writer = HirCodecWriter.create()
    hc_enc_hir_function(writer, func)
    if not writer.ok: rt_exit(2)
    val encoded = writer.finish()
    if encoded == "": rt_exit(3)
    sha256_text(encoded)

fn intensive_state(pass_: MonomorphizationPass) -> text:
    var writer = HirCodecWriter.create()
    for key in pass_.generic_methods.keys().sort():
        writer.put_text(key)
        writer.put_text(pass_.generic_methods[key])
    writer.put_text("rejected")
    for key in pass_.generic_method_rejected.keys().sort():
        writer.put_text(key)
        writer.put_text(pass_.generic_method_rejected[key])
    writer.put_text("recipes")
    for key in pass_.template_recipes.keys().sort():
        val recipe: MonoTemplateRecipeV1 = pass_.template_recipes[key]
        writer.put_text(key)
        writer.put_text(recipe.module_name)
        writer.put_i64(recipe.original_symbol.id)
        writer.put_text(recipe.template_name)
        writer.put_bool(recipe.inherent_method)
        writer.put_i64(recipe.canonical_type_params.len())
        for param in recipe.canonical_type_params: hc_enc_hir_type_param(writer, param)
        writer.put_i64(recipe.bound_type_params.len())
        for param in recipe.bound_type_params: hc_enc_hir_type_param(writer, param)
        val signature = pass_.template_signature_v1(key)
        val digest = mono_template_signature_digest_v1(signature)
        if digest == "": rt_exit(4)
        writer.put_text(digest)
    writer.put_text("retained-bodies")
    for key in pass_.generic_functions.keys().sort():
        writer.put_text(key)
        writer.put_text(intensive_function_digest(pass_.generic_functions[key]))
    if not writer.ok: rt_exit(5)
    sha256_text(writer.finish())

fn intensive_default_check(module: HirModule, recipe: MonoTemplateRecipeV1):
    var found = false
    for raw in module.functions.values():
        val original: HirFunction = raw
        if original.symbol.id == recipe.original_symbol.id:
            val canonical = mono_apply_template_recipe_v1(original, recipe)
            if canonical.params.len() != 2: rt_exit(6)
            val param: HirParam = canonical.params[1]
            if not param.has_default: rt_exit(7)
            val default_expr: HirExpr = param.default
            val kind: HirExprKind = default_expr.kind
            match kind:
                case HirExprKind.IntLit(value, _):
                    if value != 7: rt_exit(8)
                case _: rt_exit(9)
            found = true
    if not found: rt_exit(10)

fn intensive_case(count: i64, shape: i64, mode: MonoTemplateBodyModeV1, mode_name: text, seed: HirModule):
    var module = intensive_lower(intensive_source(count, shape), "workload")
    val expected_impls = if shape == 0: 0 elif shape == 1: 1 elif shape == 6: 33 else: 2
    if module.impls.len() != expected_impls: rt_exit(11)
    if module.functions.len() < count: rt_exit(12)
    if shape > 1:
        val first: HirImpl = module.impls[0]
        val last: HirImpl = module.impls[1]
        if first.type_params.len() != 0 or last.type_params.len() != 1: rt_exit(13)
        if shape == 3:
            var trait_impl: HirImpl = last
            trait_impl.has_trait_ = true
            module.impls = [first, trait_impl]
        elif shape == 4 or shape == 5:
            # Classification stress at the real HIR API boundary, not a claim
            # that repeating a source impl declaration4096 times is legal.
            var expanded: [HirImpl] = []
            if shape == 5: expanded = expanded.push(last)
            for index in 0..4096: expanded = expanded.push(first)
            if shape == 4: expanded = expanded.push(last)
            module.impls = expanded
            if module.impls.len() != 4097: rt_exit(29)
    val before = hir_module_encode(module)
    if before == "": rt_exit(14)
    var expected_state = ""
    var total_us: i64 = 0
    var samples_us: [text] = []
    # Fix the batch before measurement: 64 fresh seeded passes per sample.
    # Construction/fingerprints are outside the timer. The timed loop includes
    # identical indexed record loads/stores in both baseline and candidate.
    for repetition in 0..16:
        var passes: [MonomorphizationPass] = []
        var seed_states: [text] = []
        for batch_index in 0..64:
            var prepared = MonomorphizationPass.create()
            prepared.template_body_mode = mode
            prepared.collect_generics(seed, "seed")
            seed_states = seed_states.push(intensive_state(prepared))
            passes = passes.push(prepared)
        val start = rt_time_now_micros()
        for batch_index in 0..64:
            var pass_: MonomorphizationPass = passes[batch_index]
            pass_.collect_generic_impl_methods(module, "workload")
            passes[batch_index] = pass_
        val elapsed = rt_time_now_micros() - start
        if elapsed <= 0: rt_exit(15)
        total_us = total_us + elapsed
        samples_us = samples_us.push(elapsed.to_text())
        for batch_index in 0..64:
            var pass_: MonomorphizationPass = passes[batch_index]
            if not pass_.template_recipes.has("identity"): rt_exit(16)
            intensive_default_check(seed, pass_.template_recipes["identity"])
            if shape < 2:
                if intensive_state(pass_) != seed_states[batch_index]: rt_exit(17)
            elif shape != 3:
                val expected_methods = if shape == 6: 32 else: 1
                if pass_.generic_methods.len() != expected_methods or pass_.generic_method_rejected.len() != 0: rt_exit(18)
                if shape == 6:
                    for index in 0..32:
                        val template_name = "Box_{index}__read"
                        if not pass_.template_recipes.has(template_name): rt_exit(19)
                        if index == 0 or index == 31:
                            intensive_default_check(module, pass_.template_recipes[template_name])
                else:
                    if not pass_.template_recipes.has("Box__read"): rt_exit(19)
                    intensive_default_check(module, pass_.template_recipes["Box__read"])
                if pass_.template_recipes.has("Plain__read"): rt_exit(20)
            else:
                if pass_.generic_methods.len() != 0 or pass_.generic_method_rejected.len() != 1: rt_exit(21)
                if pass_.template_recipes.has("Box__read"): rt_exit(22)
                for key in pass_.generic_method_rejected.keys():
                    if not pass_.generic_method_rejected[key].contains("trait impl"): rt_exit(23)
            val state = intensive_state(pass_)
            if repetition == 0 and batch_index == 0: expected_state = state
            elif state != expected_state: rt_exit(24)
    if hir_module_encode(module) != before: rt_exit(25)
    val sample_text = samples_us.join(",")
    val function_count = module.functions.len()
    val impl_count = module.impls.len()
    print "IMPL_INDEX_ROW count={count} functions={function_count} impls={impl_count} shape={shape} mode={mode_name} samples=16 batch_size=64 collector_calls=1024 timed_batch_us={total_us} batch_samples_us={sample_text} state={expected_state} input={sha256_text(before)}"

fn main() -> i64:
    val seed = intensive_lower("fn identity<T>(value: T, extra: i64 = 7) -> T:\n    value\n", "seed")
    if seed.impls.len() != 0: rt_exit(26)
    val seed_before = hir_module_encode(seed)
    if seed_before == "": rt_exit(27)
    for count in [64, 256, 1024]:
        for shape in [0, 1, 2, 3]:
            intensive_case(count, shape, MonoTemplateBodyModeV1.Retained, "retained", seed)
            intensive_case(count, shape, MonoTemplateBodyModeV1.ArchiveRequests, "archive", seed)
    # I >> F and dense-generic controls supplement the function-size matrix.
    for shape in [4, 5, 6]:
        intensive_case(64, shape, MonoTemplateBodyModeV1.Retained, "retained", seed)
        intensive_case(64, shape, MonoTemplateBodyModeV1.ArchiveRequests, "archive", seed)
    if hir_module_encode(seed) != seed_before: rt_exit(28)
    print "PASS generic_impl_index_intensive_native rows=30 collector_calls=30720 batch_size=64 samples_per_row=16"
    0
