# Behavioral native regression: parameters prevent literal folding from hiding
# mismatched Cranelift SSA operands. Run normally (exit 0), then --negative
# (exit 1 and first assertion failure) to prove the arithmetic oracle executes.
use std.sffi.cli_args.{cli_get_args}

fn int_float_add(a: i64, b: f64) -> f64: a + b
fn float_int_add(a: f64, b: i64) -> f64: a + b
fn int_float_sub(a: i64, b: f64) -> f64: a - b
fn float_int_sub(a: f64, b: i64) -> f64: a - b
fn int_float_mul(a: i64, b: f64) -> f64: a * b
fn float_int_mul(a: f64, b: i64) -> f64: a * b
fn int_float_div(a: i64, b: f64) -> f64: a / b
fn float_int_div(a: f64, b: i64) -> f64: a / b
fn uint_float_div(a: u64, b: f64) -> f64: a / b
fn float_uint_div(a: f64, b: u64) -> f64: a / b
fn narrow_wide_add(a: f32, b: f64) -> f64: a + b
fn wide_narrow_add(a: f64, b: f32) -> f64: a + b
fn mixed_less(a: i64, b: f64) -> bool: a < b
fn mixed_greater(a: f64, b: i64) -> bool: a > b
fn signed_div(a: i64, b: i64) -> i64: a / b
fn unsigned_div(a: u64, b: u64) -> u64: a / b

fn main() -> i64:
    var expected_division: f64 = 2.5
    for arg in cli_get_args():
        if arg == "--negative": expected_division = 3.5
    if int_float_div(5, 2.0) != expected_division:
        print "mixed-numeric assertion 1 failed"
        return 1
    if float_int_div(5.0, 2) != 2.5: return 2
    if int_float_div(-5, 2.0) != -2.5: return 3
    if float_int_div(5.0, -2) != -2.5: return 4
    if int_float_add(-3, 0.5) != -2.5: return 5
    if float_int_add(0.5, 2) != 2.5: return 6
    if int_float_sub(2, 0.5) != 1.5: return 7
    if float_int_sub(2.5, 2) != 0.5: return 8
    if int_float_mul(-2, 0.5) != -1.0: return 9
    if float_int_mul(0.5, -2) != -1.0: return 10
    if uint_float_div(18446744073709551614u64, 2.0) != 9223372036854775808.0: return 11
    if float_uint_div(9223372036854775808.0, 9223372036854775808u64) != 1.0: return 12
    if narrow_wide_add(0.5f32, 2.0) != 2.5: return 13
    if wide_narrow_add(2.0, 0.5f32) != 2.5: return 14
    if not mixed_less(-2, -1.5): return 15
    if not mixed_greater(2.5, 2): return 16
    if signed_div(-5, 2) != -2: return 17
    if unsigned_div(18446744073709551614u64, 2u64) != 9223372036854775807u64: return 18
    print "mixed-numeric assertions=18 PASS"
    0
