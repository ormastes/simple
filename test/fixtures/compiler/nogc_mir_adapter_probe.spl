"""Actual MIR-to-NLL adapter diagnostic; not whole-source language proof."""

use compiler.borrow.borrow_check.mod.{BorrowCheckResult, create_borrow_checker}
use compiler.mir.mir_instruction_graph.{MirBody, MirBlock, MirInst}
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_instruction_support.{BlockId, MirTerminator, MirOperand, MirBorrowKind, MirPlace, AggregateKind, MirBinOp, mir_operand_copy, mir_operand_move, mir_operand_const_int}
use compiler.mir.mir_types.{LocalId, MirType, MirTypeKind, MirLocal, LocalKind}
use compiler.hir.hir_types.{SymbolId}
use std.nogc_sync_mut.io_runtime.{exit}

fn adapter_inst(kind: MirInstKind) -> MirInst:
    MirInst(kind: kind, span: nil)

fn adapter_local(id: i64, type_: MirType) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: type_, kind: LocalKind.Temp, is_ghost: false)

fn adapter_accepts(instructions: [MirInst], result: MirOperand? = nil, scalar_result: bool = false, known_result: bool = true) -> bool:
    val block = MirBlock(id: BlockId(id: 7), label: nil, instructions: instructions, terminator: MirTerminator.Ret(result))
    val reference_type = MirType(kind: MirTypeKind.Ref(MirType.i64(), false))
    # The negative load reads a reference from a borrowed reference slot;
    # the positive load reads a scalar from a borrowed scalar slot.
    val source_type = if scalar_result: MirType.i64() else: reference_type
    val source_reference_type = MirType(kind: MirTypeKind.Ref(source_type, false))
    var locals: [MirLocal] = [adapter_local(0, source_type), adapter_local(1, source_reference_type), adapter_local(3, reference_type), adapter_local(9, reference_type)]
    if known_result:
        val result_type = if scalar_result: MirType.i64() else: reference_type
        locals = locals.push(adapter_local(2, result_type))
    val body = MirBody(name: "adapter-probe", blocks: [block], locals: locals, arg_count: 0, return_ty: MirType.i64(), nogc_strict: true)
    var checker = create_borrow_checker()
    match checker.check_function(body, 7):
        case BorrowCheckResult.Ok: true
        case BorrowCheckResult.Errors(_): false

fn adapter_guard(condition: bool, message: text):
    if not condition:
        print "FAIL: {message}"
        exit(1)

fn adapter_borrow() -> MirInst:
    adapter_inst(MirInstKind.Ref(LocalId(id: 1), MirBorrowKind.Shared, MirPlace(local: LocalId(id: 0), projection: [])))

fn main() -> i64:
    val owner = LocalId(id: 0)
    val reference = LocalId(id: 1)
    val aggregate = LocalId(id: 2)
    val projected = LocalId(id: 3)
    val pointer = LocalId(id: 9)

    adapter_guard(not adapter_accepts([
        adapter_inst(MirInstKind.Aggregate(aggregate, AggregateKind.Tuple, [mir_operand_move(owner)])),
        adapter_inst(MirInstKind.DebugValue(owner, "moved-owner"))
    ]), "aggregate move operand was discarded")

    adapter_guard(adapter_accepts([
        adapter_inst(MirInstKind.Aggregate(aggregate, AggregateKind.Tuple, [mir_operand_copy(owner)]))
    ], Some(mir_operand_copy(aggregate))), "unborrowed aggregate was rejected")

    adapter_guard(not adapter_accepts([
        adapter_borrow(),
        adapter_inst(MirInstKind.Aggregate(aggregate, AggregateKind.Tuple, [mir_operand_copy(reference)])),
        adapter_inst(MirInstKind.GetField(projected, mir_operand_copy(aggregate), 0))
    ], Some(mir_operand_copy(projected))), "aggregate projection laundered a returned borrow")

    adapter_guard(not adapter_accepts([
        adapter_borrow(),
        adapter_inst(MirInstKind.Aggregate(reference, AggregateKind.Tuple, [mir_operand_copy(reference)]))
    ], Some(mir_operand_copy(reference))), "in-place aggregate construction erased its input provenance")

    adapter_guard(not adapter_accepts([
        adapter_borrow(),
        adapter_inst(MirInstKind.Aggregate(aggregate, AggregateKind.Tuple, [mir_operand_copy(reference)])),
        adapter_inst(MirInstKind.GetField(aggregate, mir_operand_copy(aggregate), 0))
    ], Some(mir_operand_copy(aggregate))), "in-place projection erased its input provenance")

    adapter_guard(not adapter_accepts([
        adapter_borrow(), adapter_inst(MirInstKind.Copy(aggregate, reference))
    ], Some(mir_operand_copy(aggregate))), "local copy laundered a returned borrow")

    adapter_guard(not adapter_accepts([
        adapter_borrow(), adapter_inst(MirInstKind.Load(aggregate, mir_operand_copy(reference)))
    ], Some(mir_operand_copy(aggregate))), "load erased pointer provenance")

    adapter_guard(adapter_accepts([
        adapter_borrow(), adapter_inst(MirInstKind.Load(aggregate, mir_operand_copy(reference)))
    ], Some(mir_operand_copy(aggregate)), true), "loading an independent i64 falsely retained the source borrow")

    adapter_guard(not adapter_accepts([
        adapter_borrow(), adapter_inst(MirInstKind.Load(aggregate, mir_operand_copy(reference)))
    ], Some(mir_operand_copy(aggregate)), false, false), "missing loaded-result type silently erased provenance")

    adapter_guard(adapter_accepts([
        adapter_borrow(), adapter_inst(MirInstKind.GetField(aggregate, mir_operand_copy(reference), 0))
    ], Some(mir_operand_copy(aggregate)), true), "scalar field projection falsely retained the source borrow")

    adapter_guard(not adapter_accepts([
        adapter_borrow(),
        adapter_inst(MirInstKind.GetElementPtr(aggregate, mir_operand_copy(reference), [mir_operand_const_int(0)]))
    ], Some(mir_operand_copy(aggregate))), "element address erased pointer provenance")

    adapter_guard(not adapter_accepts([
        adapter_borrow(), adapter_inst(MirInstKind.Cast(aggregate, mir_operand_copy(reference), MirType.i64()))
    ], Some(mir_operand_copy(aggregate))), "cast erased pointer provenance")

    adapter_guard(adapter_accepts([
        adapter_inst(MirInstKind.GetField(projected, mir_operand_move(aggregate), 0)),
        adapter_inst(MirInstKind.GetField(pointer, mir_operand_copy(aggregate), 1))
    ]), "moving one field invalidated an independent sibling")

    adapter_guard(not adapter_accepts([
        adapter_inst(MirInstKind.GetField(projected, mir_operand_move(aggregate), 0)),
        adapter_inst(MirInstKind.GetField(pointer, mir_operand_copy(aggregate), 0))
    ]), "field extraction lost its move fact")

    adapter_guard(not adapter_accepts([
        adapter_borrow(),
        adapter_inst(MirInstKind.Store(mir_operand_copy(pointer), mir_operand_copy(reference)))
    ]), "pointer store retained a short borrow")

    adapter_guard(not adapter_accepts([
        adapter_inst(MirInstKind.Store(mir_operand_copy(pointer), mir_operand_move(owner))),
        adapter_inst(MirInstKind.DebugValue(owner, "reused after store"))
    ]), "pointer store discarded its move operand")

    adapter_guard(not adapter_accepts([
        adapter_borrow(),
        adapter_inst(MirInstKind.StoreGlobal(SymbolId(id: 12), mir_operand_copy(reference)))
    ]), "global store retained a short borrow")

    adapter_guard(not adapter_accepts([
        adapter_borrow(),
        adapter_inst(MirInstKind.SetField(mir_operand_copy(aggregate), 0, mir_operand_copy(reference)))
    ]), "field store retained a short borrow")

    adapter_guard(not adapter_accepts([
        adapter_borrow(),
        adapter_inst(MirInstKind.Await(aggregate, mir_operand_copy(pointer))),
        adapter_inst(MirInstKind.DebugValue(reference, "live-after-await"))
    ]), "a live short borrow crossed await")

    adapter_guard(adapter_accepts([
        adapter_borrow(),
        adapter_inst(MirInstKind.DebugValue(reference, "last-use-before-await")),
        adapter_inst(MirInstKind.Await(aggregate, mir_operand_copy(pointer)))
    ]), "a dead borrow incorrectly survived to await")

    adapter_guard(not adapter_accepts([
        adapter_borrow(), adapter_inst(MirInstKind.Yield(Some(mir_operand_copy(reference))))
    ]), "yield leaked a short borrow")

    adapter_guard(not adapter_accepts([
        adapter_borrow(),
        adapter_inst(MirInstKind.Spawn(aggregate, mir_operand_copy(pointer), [mir_operand_copy(reference)]))
    ]), "spawn retained a short borrow")

    adapter_guard(not adapter_accepts([
        adapter_inst(MirInstKind.Move(aggregate, owner)),
        adapter_inst(MirInstKind.BinOp(projected, MirBinOp.Add, mir_operand_copy(owner), mir_operand_const_int(1)))
    ]), "arithmetic ignored a moved input")

    adapter_guard(not adapter_accepts([
        adapter_inst(MirInstKind.Parallel(aggregate, [mir_operand_copy(pointer)]))
    ]), "an unsupported opcode silently bypassed the adapter")

    print "nogc-mir-adapter: aggregates, projections, stores, arithmetic, return aliases and suspension passed"
    0
