mod file_system.types
mod file_system.file_ops
mod file_system.dir_ops
mod file_system.path_ops

fn main() -> i64:
    val info = types.PathInfo(size: 4)
    if (file_ops.file_exists("fixture") and
        dir_ops.dir_exists("fixture") and
        path_ops.path_extension("fixture.spl") == "spl"):
        return info.size
    0
