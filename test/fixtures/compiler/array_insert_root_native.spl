# Native behavior fixture for the original builtin, without source workarounds.
var values: [i64] = [10, 30]
values.insert(1, 20)
assert values == [10, 20, 30]
values.insert(0, 5)
values.insert(values.len(), 40)
assert values == [5, 10, 20, 30, 40]
values.insert(99, 7)
assert values == [5, 10, 20, 30, 40]
values.insert(-8, 1)
assert values[0] == 1
var empty: [i64] = []
val inserted = empty.insert(0, 9)
assert empty == [9]
assert inserted == [9]
var words: [text] = ["a", "c"]
words.insert(1, "b")
assert words == ["a", "b", "c"]
print("array insert root fixture passed")

# A side-effecting receiver and both arguments execute in source order once.
var insert_events: i64 = 0
fn insert_receiver() -> [i64]:
    insert_events = insert_events * 10 + 1
    [1]
fn insert_index() -> i64:
    insert_events = insert_events * 10 + 2
    1
fn insert_item() -> i64:
    insert_events = insert_events * 10 + 3
    2
val once = insert_receiver().insert(insert_index(), insert_item())
assert insert_events == 123
assert once == [1, 2]
