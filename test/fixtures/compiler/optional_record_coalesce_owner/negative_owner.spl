use provider.{Value, Operand}
use other.{OtherValue, OtherOperand}

fn invalid(value: Operand?) -> i64:
    val payload = value ?? OtherOperand(prefix: "wrong-owner", kind: OtherValue.Int(3))
    match payload.kind:
        case Int(number): number
        case Text(_): -1

fn main() -> i64:
    invalid(nil)
