use provider.{Value, Operand, integer_operand}
use other.{OtherValue}

var fallback_calls: i64 = 0

fn fallback() -> Operand:
    fallback_calls = fallback_calls + 1
    integer_operand(7)

fn read_operand(value: Operand?) -> i64:
    val payload = value ?? fallback()
    if payload.prefix != "owner-layout-prefix": return -100
    match payload.kind:
        case Int(number): number
        case Text(_): -200

fn read_other(value: OtherValue) -> i64:
    match value:
        case OtherValue.Int(number): number
        case OtherValue.Text(_): -1

fn main() -> i64:
    if read_other(OtherValue.Int(4)) != 4: return 10
    if read_operand(Some(integer_operand(37))) != 37: return 11
    if fallback_calls != 0: return 12
    if read_operand(nil) != 7: return 13
    if fallback_calls != 1: return 14
    0
