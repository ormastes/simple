struct HistItem:
    command: text
    result: text
    session: text
    core: text
    request_id: text

fn make_hist(n: i64) -> [HistItem]:
    var out: [HistItem] = []
    var i: i64 = 0
    while i < n:
        out.push(HistItem(command: "cmd-{i}", result: "value-{i}", session: "session", core: "core", request_id: "request-{i}"))
        i = i + 1
    out
