fn shell(cmd: text) -> text:
    "fn:" + cmd

fn pick(candidates: [text]) -> text:
    for shell in candidates:
        if shell == "/bin/bash":
            return shell
    ""

fn run_with(limit: i64) -> text:
    val shell = pick(["/bin/zsh", "/bin/bash"])
    if limit > 0:
        return shell + "#" + "{limit}"
    shell

fn main() -> i64:
    val a = run_with(3)
    print "a={a}"
    if a != "/bin/bash#3":
        return 21
    if shell("x") != "fn:x":
        return 22
    print "PASS shell shadow"
    0
