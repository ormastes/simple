use std.io_runtime.{exit}
use compiler.mir.mir_instruction_support.{MirTerminator}
use compiler.hir.hir_definitions.{HirExprKind}

fn is_return_terminator(term: MirTerminator) -> bool:
    match term:
        case MirTerminator.Ret(_): true
        case _: false

fn is_unit_expression(kind: HirExprKind) -> bool:
    match kind:
        case HirExprKind.UnitLit: true
        case _: false

fn check_ret_owner(condition: bool, message: text):
    if not condition:
        print "FAIL: {message}"
        exit(1)

fn main() -> i64:
    val actual_return = MirTerminator.Ret(None)
    val actual_nonreturn = MirTerminator.Unreachable
    check_ret_owner(is_return_terminator(actual_return), "typed MirTerminator.Ret(None) is recognized")
    check_ret_owner(not is_return_terminator(actual_nonreturn), "valid non-Ret terminator is rejected")
    check_ret_owner(is_unit_expression(HirExprKind.UnitLit), "typed HirExprKind unit variant is recognized")
    check_ret_owner(not is_unit_expression(HirExprKind.IntLit(7, None)), "valid non-unit HIR expression is rejected")

    print "terminator Ret owner probe: Ret and non-Ret constructors remain distinct"
    0
