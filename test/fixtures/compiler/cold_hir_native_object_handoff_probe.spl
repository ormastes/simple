"""Focused native proof of the cold HIR to validated object-path handoff."""

use compiler.driver.driver_types.{CompileContext}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_aot_native_output.{
    driver_cold_hir_record_verified_object_v1
}
use compiler.driver.cache.cold_hir_semantic_seed_v1.{
    ColdHirSemanticSeedV1, ColdHirTypedReceiptV1
}

fn main() -> i64:
    val ctx = CompileContext.create(driver_core_compile_options_default())
    if driver_cold_hir_record_verified_object_v1(
            ctx, "module.a", "/tmp/module-a.o", "capsule-a") != "" or
            ctx.cold_hir_native_object_paths.len() != 0:
        print "FAIL warm route retained an object path"
        return 1
    ctx.cold_hir_typed_receipts = [ColdHirTypedReceiptV1(
        ColdHirSemanticSeedV1("module.a", "module/a.spl", "source",
            "inventory", "abi", []), "typed-abi")]
    if driver_cold_hir_record_verified_object_v1(
            ctx, "", "/tmp/module-a.o", "capsule-a") != "cold-hir-object-identity-invalid" or
            driver_cold_hir_record_verified_object_v1(
                ctx, "module.a", "", "capsule-a") != "cold-hir-object-identity-invalid" or
            driver_cold_hir_record_verified_object_v1(
                ctx, "module.a", "/tmp/module-a.o", "") != "cold-hir-object-identity-invalid":
        print "FAIL empty object identity admitted"
        return 2
    if driver_cold_hir_record_verified_object_v1(
            ctx, "module.a", "/tmp/module-a.o", "capsule-a") != "" or
            ctx.cold_hir_native_object_paths["module.a"] != "/tmp/module-a.o" or
            ctx.cold_hir_native_capsule_identities["module.a"] != "capsule-a":
        print "FAIL cold object path not retained"
        return 3
    if driver_cold_hir_record_verified_object_v1(
            ctx, "module.a", "/tmp/other.o", "capsule-other") !=
                "cold-hir-object-duplicate:module.a" or
            ctx.cold_hir_native_object_paths["module.a"] != "/tmp/module-a.o" or
            ctx.cold_hir_native_capsule_identities["module.a"] != "capsule-a":
        print "FAIL duplicate object replaced admitted path"
        return 4
    print "PASS cold_hir_native_object_handoff_probe"
    0
