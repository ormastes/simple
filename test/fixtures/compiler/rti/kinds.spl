# RTI fixture module A: declared returns of a free fn, an instance method and
# a static method, all naming the module's own enum.
pub enum Shape:
    Circle(r: f64)
    Square(s: f64)

pub fn pick(n: i64) -> Result<Shape, text>:
    if n > 0:
        return Ok(Shape.Circle(1.0))
    Err("none")

pub struct Box:
    w: i64

impl Box:
    fn open() -> Result<Shape, text>:
        Ok(Shape.Square(2.0))

    static fn make() -> Box:
        Box(w: 1)

# A second enum declaring bare Ok/Err: a bare arm is ambiguous unless the
# match subject's declared return type is known.
pub enum Verdict:
    Ok(v: i64)
    Err(m: text)
