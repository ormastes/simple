# RTI fixture module C: bare Ok/Err arms over imported callees.
use rti_fixture.kinds.{pick, Box, Shape, Verdict}
use rti_fixture.reexport.{choose}

fn via_fn() -> i64:
    match pick(1):
        case Ok(s): 1
        case Err(e): 0

fn via_method() -> i64:
    match Box.make().open():
        case Ok(s): 1
        case Err(e): 0

fn via_reexport() -> i64:
    match choose(2):
        case Ok(s): 1
        case Err(e): 0
