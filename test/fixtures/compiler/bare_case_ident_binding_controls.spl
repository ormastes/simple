# Controls for the bare-identifier `case` arm defect.
#
# Bug: doc/08_tracking/bug/case_bare_ident_is_irrefutable_binding_2026-08-01.md
#
# A bare `case <Ident>:` whose identifier is NOT a variant of the matched enum
# silently became an irrefutable binding that swallowed every later arm. Both
# engines now REFUSE that shape (`hir/lower/stmt_lowering.rs` for JIT/native,
# `interpreter_patterns.rs` for the tree-walk interpreter).
#
# The refusal itself cannot be a row here -- it aborts the whole module -- so it
# is covered by the Rust unit tests in `compiler/src/pattern_case_naming.rs` and
# by the diagnostic text. What THIS fixture guards is the other direction: the
# shapes that must KEEP working, so a future over-broad tightening of the
# predicate is caught loudly instead of rejecting valid code.
#
# Run on the JIT (the default engine) and assert `[jit-fallback]` is absent:
#   simple run test/fixtures/compiler/bare_case_ident_binding_controls.spl
# The interpreter is the true-positive control:
#   SIMPLE_EXECUTION_MODE=interpret simple run <same file>
#
# Expected tail: BADCOUNT 0

enum Color:
    Red
    Green
    Blue

enum Shape:
    Dot
    Line(n: i64)

var bad: i64 = 0

fn check(label: text, got: i64, want: i64):
    if got == want:
        print("PASS " + label + " got=" + got.to_text())
    else:
        bad = bad + 1
        print("FAIL " + label + " got=" + got.to_text() + " want=" + want.to_text())

# --- control 1: lowercase bare identifier IS a real binding, and must stay one
fn lowercase_binds(c: Color) -> i64:
    match c:
        case Color.Red: return 1
        case other: return 90

# --- control 2: qualified variant arms dispatch correctly (not always-first)
fn qualified_dispatch(c: Color) -> i64:
    match c:
        case Color.Red: return 10
        case Color.Green: return 20
        case _: return 30

# --- control 3: a bare identifier that IS a variant of the matched enum stays
# a variant TEST, not a binding. This is the arm the fix must not break.
fn bare_variant_is_a_test(c: Color) -> i64:
    match c:
        case Red: return 41
        case Green: return 42
        case _: return 43

# --- control 4: `is` on a qualified variant -- the only shape that reaches
# `codegen/instr/pattern.rs::compile_pattern_test` (proved by probe 2026-08-02)
fn is_variant(c: Color) -> i64:
    if c is Color.Red:
        return 5
    return 6

# --- control 5: payload binding still binds (blocker 1's slice must not regress)
fn payload_binds(s: Shape) -> i64:
    match s:
        case Shape.Line(n): return n
        case _: return 70

fn main():
    check("lowercase_binds_red", lowercase_binds(Color.Red), 1)
    check("lowercase_binds_other", lowercase_binds(Color.Green), 90)
    check("lowercase_binds_blue", lowercase_binds(Color.Blue), 90)

    check("qualified_red", qualified_dispatch(Color.Red), 10)
    check("qualified_green", qualified_dispatch(Color.Green), 20)
    check("qualified_blue", qualified_dispatch(Color.Blue), 30)

    check("bare_variant_red", bare_variant_is_a_test(Color.Red), 41)
    check("bare_variant_green", bare_variant_is_a_test(Color.Green), 42)
    check("bare_variant_blue", bare_variant_is_a_test(Color.Blue), 43)

    check("is_red", is_variant(Color.Red), 5)
    check("is_green", is_variant(Color.Green), 6)

    check("payload_line", payload_binds(Shape.Line(7)), 7)
    check("payload_dot", payload_binds(Shape.Dot), 70)

    # Value-3 control: 3 is the nil sentinel, so a silently-nil binder would
    # pass a naive check here. Keep this row.
    check("payload_line_three", payload_binds(Shape.Line(3)), 3)

    print("BADCOUNT " + bad.to_text())
