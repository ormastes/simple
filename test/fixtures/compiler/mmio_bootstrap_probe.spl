use os.kernel.boot.mmio.{mmio_reset_for_test, mmio_test_mode_enabled, mmio_disable_test_mode, mmio_write8, mmio_read8, mmio_write16, mmio_read16, mmio_write32, mmio_read32, mmio_write64, mmio_read64}

fn main() -> i32:
    mmio_reset_for_test()
    if not mmio_test_mode_enabled(): return 1
    mmio_write8(0x1000, 7u8)
    mmio_write8(0x1000, 9u8)
    if mmio_read8(0x1000) != 9u8: return 2
    mmio_write16(0x2000, 13u16)
    if mmio_read16(0x2000) != 13u16: return 3
    mmio_write32(0x3000, 19u32)
    if mmio_read32(0x3000) != 19u32: return 4
    mmio_write64(0x4000, 29u64)
    if mmio_read64(0x4000) != 29u64: return 5
    mmio_reset_for_test()
    if mmio_read8(0x1000) != 0u8: return 6
    if mmio_read16(0x2000) != 0u16: return 7
    if mmio_read32(0x3000) != 0u32: return 8
    if mmio_read64(0x4000) != 0u64: return 9
    mmio_disable_test_mode()
    if mmio_test_mode_enabled(): return 10
    0
