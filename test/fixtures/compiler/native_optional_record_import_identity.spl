use std.common.env_access.model.{EnvAccessPlan, EnvToolIdentity as Tool, EnvToolIdentity as Again}

fn admitted_tool(tool: Tool, present: bool) -> Again?:
    if present: return Some(tool)
    nil

fn inspect(tool: Again, present: bool) -> text:
    val stored = admitted_tool(tool, present)
    val copied = stored
    match copied:
        case Some(value):
            assert(value.tool_id == "compiler")
            assert(value.canonical_path == "/admitted/simple")
            assert(value.identity_hash == "expected-digest")
            value.canonical_path
        case nil: "absent"

fn main():
    val tool = Tool(tool_id: "compiler", canonical_path: "/admitted/simple", identity_hash: "expected-digest")
    assert(inspect(tool, true) == "/admitted/simple")
    assert(inspect(tool, false) == "absent")
    print("Optional imported struct identity assertions passed")
