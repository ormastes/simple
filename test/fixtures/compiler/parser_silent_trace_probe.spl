use compiler.core.parser.{
    parse_module, parse_module_silent_checked, parser_has_errors}

extern fn rt_cli_get_args() -> [text]
extern fn rt_env_set(key: text, value: text) -> bool

val args = rt_cli_get_args()
val restore = args.contains("restore")
val silent = args.contains("silent") or restore
val trace_kind = if args.contains("compiler"): "compiler" else: "ast"

# Enable tracing only after this probe is loaded, so compiler startup cannot
# contaminate the silent negative oracle.
rt_env_set("SIMPLE_TRACE_AST_RESET", "")
rt_env_set("SIMPLE_COMPILER_TRACE", "")
if trace_kind == "ast":
    rt_env_set("SIMPLE_TRACE_AST_RESET", "1")
else:
    rt_env_set("SIMPLE_COMPILER_TRACE", "1")

val source = if trace_kind == "compiler":
    "fn f():\n    print(\"x\")\n"
else:
    "fn f() -> i64:\n    1\n"
val path = "src/parser_silent_trace_contract_input.spl"
var failed = false
if silent:
    failed = parse_module_silent_checked(source, path)
else:
    parse_module(source, path)
    failed = parser_has_errors()
if restore:
    parse_module(source, path)
    failed = failed or parser_has_errors()

rt_env_set("SIMPLE_TRACE_AST_RESET", "")
rt_env_set("SIMPLE_COMPILER_TRACE", "")
var mode_text = "ordinary"
if silent:
    mode_text = "silent"
if restore:
    mode_text = "restore"
print "RESULT mode={mode_text} trace={trace_kind} failed={failed}"
