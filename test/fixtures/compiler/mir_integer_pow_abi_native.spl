# Exercise production constant folding; do not copy the power implementation.
extern fn rt_exit(code: i64)
use compiler.mir.mir_instruction_graph.{mir_fold_binop}
use compiler.mir.mir_instruction_support.{MirBinOp}
use compiler.mir.mir_types.{MirConstValue}

fn check_integer_power(base: i64, exponent: i64, expected: i64):
    val folded: MirConstValue? = mir_fold_binop(MirBinOp.Pow,
        MirConstValue.Int(base), MirConstValue.Int(exponent))
    if val present = folded:
        val concrete: MirConstValue = present
        match concrete:
            case MirConstValue.Int(actual):
                if actual != expected: rt_exit(11)
            case _: rt_exit(12)
    else: rt_exit(13)

fn check_float_power(base: f64, exponent: f64, expected: f64):
    val folded: MirConstValue? = mir_fold_binop(MirBinOp.Pow,
        MirConstValue.Float(base), MirConstValue.Float(exponent))
    if val present = folded:
        val concrete: MirConstValue = present
        match concrete:
            case MirConstValue.Float(actual):
                if actual != expected: rt_exit(21)
            case _: rt_exit(22)
    else: rt_exit(23)

fn main() -> i64:
    # These values keep every multiplication in the C helper within i64.
    check_integer_power(0, 0, 1)
    check_integer_power(0, 1, 0)
    check_integer_power(1, 0, 1)
    check_integer_power(1, 65535, 1)
    check_integer_power(-1, 65534, 1)
    check_integer_power(-1, 65535, -1)
    check_integer_power(2, 10, 1024)
    check_integer_power(-2, 3, -8)
    check_integer_power(-2, 4, 16)
    check_integer_power(3, 5, 243)
    check_integer_power(7, -1, 0)
    check_integer_power(0, -2, 0)
    check_float_power(0.0, 0.0, 1.0)
    check_float_power(0.0, 2.0, 0.0)
    check_float_power(-2.0, 3.0, -8.0)
    check_float_power(2.0, 3.0, 8.0)
    check_float_power(9.0, 0.5, 3.0)
    check_float_power(4.0, -0.5, 0.5)
    if mir_fold_binop(MirBinOp.Pow, MirConstValue.Int(2), MirConstValue.Float(3.0)) != nil:
        rt_exit(31)
    if mir_fold_binop(MirBinOp.Div, MirConstValue.Int(7), MirConstValue.Int(0)) != nil:
        rt_exit(32)
    print "mir_integer_pow_abi_native=PASS integer=12 float=6 controls=2"
    0
