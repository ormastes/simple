# Expected native stdout: discard effects=1
var discard_calls: i64 = 0

fn discard_observe() -> i64:
    discard_calls = discard_calls + 1
    37

fn discard_final_statement():
    _ = discard_observe()

fn main():
    discard_final_statement()
    assert(discard_calls == 1)
    print "discard effects={discard_calls}"
