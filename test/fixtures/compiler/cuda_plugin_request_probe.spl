use compiler.common.cuda_backend_policy.{cuda_backend_request_error_v1,
    install_cuda_backend_mode_v1, installed_cuda_backend_mode_v1}

fn main() -> i64:
    val cuda = cuda_backend_request_error_v1("static", "cuda", "/missing/cuda.so")
    val ptx = cuda_backend_request_error_v1("static", "ptx", "/missing/cuda.so")
    if not cuda.starts_with("BACKEND_PLUGIN_GPU_ARTIFACT_UNSUPPORTED:"): return 1
    if ptx != cuda: return 2
    if cuda_backend_request_error_v1("static", "cuda", "") != "": return 3
    if cuda_backend_request_error_v1("static", "llvm", "/provider.so") != "": return 4
    if cuda_backend_request_error_v1("disabled", "native", "/provider.so") != "": return 5
    if not cuda_backend_request_error_v1("disabled", "cuda", "").starts_with("PLUG-E-DISABLED:"): return 6
    if cuda_backend_request_error_v1("dynamic", "cuda", "") != cuda: return 7
    if install_cuda_backend_mode_v1("invalid"): return 8
    if not install_cuda_backend_mode_v1("disabled"): return 9
    if installed_cuda_backend_mode_v1() != "disabled": return 10
    if install_cuda_backend_mode_v1("static"): return 11
    if not cuda_backend_request_error_v1("unselected", "cuda", "").starts_with("PLUG-E-CUDA-POLICY:"): return 12
    if not cuda_backend_request_error_v1("invalid", "ptx", "").starts_with("PLUG-E-CUDA-POLICY:"): return 13
    print "CUDA_PLUGIN_REQUEST_PASS"
    0
