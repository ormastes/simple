# Permanent native regression. Compile and execute with the qualified fresh
# pure-Simple producer; source-only/interpreter PASS does not qualify native Eq.
struct OptionalTextStoreV1:
    fields: Dict<text, text>

    fn lookup(key: text) -> text?:
        if self.fields.contains_key(key):
            Some(self.fields[key])
        else:
            nil

fn main() -> i64:
    val store = OptionalTextStoreV1(fields: {"same": "word", "other": "different", "utf8": "Ω漢字", "empty": ""})
    val same: text? = store.lookup("same")
    val other: text? = store.lookup("other")
    val absent: text? = store.lookup("absent")
    val utf8: text? = store.lookup("utf8")
    val empty: text? = store.lookup("empty")
    if same != Some("word"): return 11
    if Some("word") != same: return 12
    if same == other: return 13
    if not (same != other): return 14
    if absent != nil: return 21
    val also_absent: text? = nil
    if absent != also_absent: return 22
    if same == absent or absent == same: return 23
    if empty == absent or absent == empty: return 24
    if empty != Some(""): return 25
    if utf8 != Some("Ω漢字"): return 31
    if utf8 == Some("Ω漢詞"): return 32
    val nested_left: Option<Option<text>> = Some(same)
    val nested_right: Option<Option<text>> = Some(Some("word"))
    if nested_left != nested_right: return 41
    val nested_different: Option<Option<text>> = Some(Some("different"))
    if nested_left == nested_different: return 42
    val outer_none: Option<Option<text>> = nil
    val some_inner_none: Option<Option<text>> = Some(absent)
    val other_some_inner_none: Option<Option<text>> = Some(also_absent)
    if some_inner_none == outer_none: return 43
    if not (some_inner_none != outer_none): return 44
    if some_inner_none != other_some_inner_none: return 45
    if some_inner_none == nested_left: return 47
    val nested_utf8_left: Option<Option<text>> = Some(utf8)
    val nested_utf8_right: Option<Option<text>> = Some(Some("Ω漢字"))
    if nested_utf8_left != nested_utf8_right: return 46
    # Scalar Optional semantics, including the raw nil sentinel's numeric value, remain unchanged.
    val three: i64? = Some(3)
    val no_number: i64? = nil
    if three == no_number: return 51
    if three != Some(3): return 52
    0
