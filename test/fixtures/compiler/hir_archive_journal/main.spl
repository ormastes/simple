# Requires the same actual cold managed-tool/runtime launcher handoff as the
# inventory fixture. No synthetic provider receipt, source SHA or acceptance.
use compiler.driver.cache.driver_hir_archive_journal_v1.*
use compiler.driver.cache.driver_hir_managed_runtime_selection_v1.*
use compiler.driver.cache.hir_body_typecheck_lease_v1.*
use compiler.driver.driver_hir_cache.{hir_cache_promote_diagnostic_owner_v1, hir_cache_clear_last_warnings}
use compiler.mono.mono_archive_registration_v1.*
use compiler.driver.driver_types.{CompileContext}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.common.config.{Logger}
use std.nogc_sync_mut.io_runtime.{file_read_nullable}
use std.common.crypto.sha256.{sha256_text}
use std.env.{env_get}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end, transient_promote}

fn registration(owner: DriverHirArchiveJournalV1, archive: HirBodyArchiveV1) -> Result<MonoArchiveRegistrationReceiptV1, text>:
    if not transient_scope_begin(): return Err("fixture registration lease refused")
    val loaded = hir_body_archive_load_in_owned_scope_v1(archive, archive.input)
    val receipt: Result<MonoArchiveRegistrationReceiptV1, text> = if loaded.is_err(): Err(loaded.unwrap_err()) else:
        mono_archive_collect_registration_in_owned_scope_v1(owner.registration, loaded.unwrap(), archive.input.module_name, archive)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(receipt) else: false
    val cache_owned = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not owned or not cache_owned or not ended: panic("fixture registration ownership")
    receipt

fn main() -> i64:
    val selected_result = driver_hir_capture_managed_runtime_selection_v1("llvm",
        env_get("SIMPLE_NATIVE_BUILD_TARGET"), env_get("SIMPLE_NATIVE_RUNTIME_BUNDLE"))
    if selected_result.is_err(): return 1
    val selected = selected_result.unwrap()
    val path = "test/fixtures/compiler/hir_archive_journal/provider.spl"
    val name = "hir_archive_journal.provider"
    val source = file_read_nullable(path) ?? ""
    if source == "" or selected.producer_header == "" or env_get("SIMPLE_HIR_LEASE_CLOSURE_DIGEST").len() != 64: return 2
    val parsed = parse_full_frontend(source, path, name, Logger(level: 0))
    var lowering = HirLowering.with_filename(path)
    val module = lowering.lower_parser_module_unstub(parsed, false)
    val input = HirBodyArchiveInputV1(source_path: path, module_name: name, is_entry: false,
        closure_digest: env_get("SIMPLE_HIR_LEASE_CLOSURE_DIGEST"),
        runtime_provider_receipt_path: selected.provider.snapshot.path,
        runtime_provider_digest: selected.provider.snapshot.digest,
        producer_header: selected.producer_header, stage: "lowered-unresolved-v1",
        provider_selection_digest: selected.selection_digest,
        source_content_digest: sha256_text(source), source_authored_path: path)
    val stored = hir_body_archive_store_v1(input, module, ["journal lowering warning"])
    if stored.is_err(): return 3
    val archive = stored.unwrap()
    var ctx = CompileContext.create(driver_core_compile_options_default())
    ctx.source_paths_owner = [path, path]
    ctx.source_authored_paths_owner = [path, path]
    ctx.source_identities_owner = [sha256_text(source), sha256_text(source)]
    ctx.source_byte_lengths_owner = [source.len(), source.len()]
    ctx.source_module_names_owner = [name, "journal.logical_alias"]
    # Journal creation recaptures and revalidates the provider. A nested
    # aggregate transported across phase 2 is not itself the authority; its
    # retained scalar digest/header must still bind the genuine recapture.
    var transported = selected
    var transported_provider = transported.provider
    transported_provider.root = "transported nested provider is not authority"
    transported.provider = transported_provider
    val created = driver_hir_archive_journal_create_v1(ctx, transported)
    if created.is_err(): return 4
    val owner = created.unwrap()
    if driver_hir_archive_journal_verify_v1(owner, ctx).is_err() or owner.events.len() != 0 or
            owner.selection.provider.root == transported.provider.root: return 5
    var tampered_transport = transported
    tampered_transport.selection_digest = sha256_text("tampered transported selection")
    if not driver_hir_archive_journal_create_v1(ctx, tampered_transport).is_err(): return 24
    var checks = 2
    if not transient_scope_begin(): return 6
    val active = driver_hir_archive_journal_verify_v1(owner, ctx).is_err()
    if not transient_scope_pause(): return 7
    val paused = driver_hir_archive_journal_verify_v1(owner, ctx).is_err()
    if not active or not paused or transient_array_scope_state_v1() != 2 or not transient_scope_end(): return 8
    checks = checks + 1
    val receipt_result = registration(owner, archive)
    if receipt_result.is_err(): return 9
    val receipt = receipt_result.unwrap()
    var forged = receipt
    forged.roots = []
    if not driver_hir_archive_journal_publish_v1(owner, ctx, 0, name, forged).is_err() or
            owner.events.len() != 0 or owner.registration.epoch != 0: return 10
    checks = checks + 1
    if driver_hir_archive_journal_publish_v1(owner, ctx, 0, name, receipt).is_err() or
            owner.events.len() != 1 or owner.registration.epoch != 1 or owner.logical_order != [name]: return 11
    checks = checks + 1
    if not driver_hir_archive_journal_alias_v1(owner, ctx, 0, "journal.logical_alias", name).is_err() or owner.events.len() != 1: return 12
    checks = checks + 1
    if driver_hir_archive_journal_alias_v1(owner, ctx, 1, "journal.logical_alias", name).is_err() or
            owner.events.len() != 2 or owner.registration.epoch != 1 or owner.logical_order != [name, "journal.logical_alias"]: return 13
    checks = checks + 1
    val inventory = driver_hir_archive_journal_inventory_v1(owner, ctx)
    if inventory.is_err() or inventory.unwrap().representative_indices != [0] or
            driver_hir_archive_journal_verify_v1(owner, ctx).is_err() or transient_array_scope_state_v1() != 0: return 14
    checks = checks + 1
    val original_events = owner.events
    var changed = original_events[1]
    changed.registration_after = sha256_text("unexecuted publication")
    owner.events = [original_events[0], changed]
    if not driver_hir_archive_journal_verify_v1(owner, ctx).is_err(): return 15
    owner.events = original_events
    checks = checks + 1
    if driver_hir_archive_journal_alias_v1(owner, ctx, 1, "journal.logical_alias", name).is_err() or
            owner.events.len() != 3 or owner.logical_order != [name, "journal.logical_alias"] or
            driver_hir_archive_journal_verify_v1(owner, ctx).is_err(): return 16
    checks = checks + 1
    var repeat = 0
    while repeat < 50:
        if driver_hir_archive_journal_verify_v1(owner, ctx).is_err() or transient_array_scope_state_v1() != 0: return 23
        repeat = repeat + 1
    checks = checks + 1
    val failed_created = driver_hir_archive_journal_create_v1(ctx, selected)
    if failed_created.is_err(): return 17
    val failed = failed_created.unwrap()
    val failed_receipt = registration(failed, archive)
    if failed_receipt.is_err(): return 18
    var broken_artifacts = failed.artifacts
    broken_artifacts.directory = path  # Actual regular file cannot be a cache directory.
    failed.artifacts = broken_artifacts
    if not driver_hir_archive_journal_publish_v1(failed, ctx, 0, name, failed_receipt.unwrap()).is_err() or
            failed.registration.epoch != 1 or failed.events.len() != 0 or failed.failed_reason == "" or
            failed.failed_event_key == "" or not failed.registration.sealed: return 19
    checks = checks + 1
    if not driver_hir_archive_journal_verify_v1(failed, ctx).is_err() or
            not driver_hir_archive_journal_inventory_v1(failed, ctx).is_err() or
            not driver_hir_archive_journal_alias_v1(failed, ctx, 1, "journal.logical_alias", name).is_err(): return 20
    checks = checks + 1
    failed.failed_reason = ""
    failed.failed_event_key = ""
    if not driver_hir_archive_journal_verify_v1(failed, ctx).is_err() or transient_array_scope_state_v1() != 0: return 21
    checks = checks + 1
    if checks != 14: return 22
    print "HIR archive publication journal: {checks} checks passed"
    0
