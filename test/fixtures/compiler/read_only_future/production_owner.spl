use std.async.cancellation.{CancellationToken, cancellation_token_new}
use std.async.future.{Future}
use std.async.poll.{Poll}
use std.common.io.file_read_policy.{FileReadPolicyV1, FileViewTransportV1}
use std.common.io.read_only_file_view.{
    ReadOnlyFileViewV1, ReadOnlyFileViewErrorV1, FileViewSliceV1,
    read_only_file_view_open_v1, read_only_file_view_read_async_v1,
    read_only_file_view_prefetch_async_v1, read_only_file_view_close_v1
}

fn prefetch_code(future: Future<Result[(), ReadOnlyFileViewErrorV1]>) -> i64:
    if val Poll.Ready(result) = future.poll():
        if val Ok(value) = result: return 0
        if val Err(error) = result:
            if error == ReadOnlyFileViewErrorV1.closed: return 1
            if error == ReadOnlyFileViewErrorV1.cancelled: return 2
            if error == ReadOnlyFileViewErrorV1.invalid_range: return 3
    -1

fn check_view(view: ReadOnlyFileViewV1) -> i64:
    var cancellation: CancellationToken = cancellation_token_new()
    if view.identity.size != 5: return 11
    val reading: Future<Result[FileViewSliceV1, ReadOnlyFileViewErrorV1]> = read_only_file_view_read_async_v1(&view, 1, 3, cancellation)
    var saw_payload = false
    if val Poll.Ready(result) = reading.poll():
        if val Ok(slice) = result:
            saw_payload = slice.offset == 1 and slice.length == 3 and slice.bytes.len() == 3 and slice.bytes[0] == 66 and slice.bytes[1] == 67 and slice.bytes[2] == 68 and slice.transport == FileViewTransportV1.buffered
    if not saw_payload: return 12
    if prefetch_code(read_only_file_view_prefetch_async_v1(&view, 0, 5, cancellation)) != 0: return 13
    if prefetch_code(read_only_file_view_prefetch_async_v1(&view, 5, 1, cancellation)) != 3: return 14
    cancellation.cancel()
    if prefetch_code(read_only_file_view_prefetch_async_v1(&view, 0, 5, cancellation)) != 2: return 15
    val cancelled_read: Future<Result[FileViewSliceV1, ReadOnlyFileViewErrorV1]> = read_only_file_view_read_async_v1(&view, 0, 1, cancellation)
    var saw_cancelled = false
    if val Poll.Ready(result) = cancelled_read.poll():
        if val Err(error) = result:
            saw_cancelled = error == ReadOnlyFileViewErrorV1.cancelled
    if not saw_cancelled: return 16
    val closed: Result[(), ReadOnlyFileViewErrorV1] = read_only_file_view_close_v1(view)
    if val Err(error) = closed: return 17
    if prefetch_code(read_only_file_view_prefetch_async_v1(&view, 0, 5, cancellation)) != 1: return 18
    0

fn main() -> i64:
    val opened: Result[ReadOnlyFileViewV1, ReadOnlyFileViewErrorV1] = read_only_file_view_open_v1(
        ".", "test/fixtures/compiler/read_only_future/payload.txt",
        "future-receiver-fixture", FileReadPolicyV1.buffered)
    if val Ok(view) = opened:
        val code = check_view(view)
        if code != 0: return code
        print "read-only-future-owner-pass"
        return 0
    10
