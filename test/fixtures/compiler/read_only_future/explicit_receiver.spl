use std.async.future.{Future}
use std.async.poll.{Poll}

enum FutureProbeError:
    closed
    cancelled
    invalid_range

struct FutureProbeSlice:
    bytes: [u8]
    offset: u64

fn cancellation_snapshot(cancelled: bool) -> Future<bool>:
    if cancelled:
        return Future<bool>.from_value(true)
    Future<bool>.pending()

fn read_snapshot() -> Future<Result[FutureProbeSlice, FutureProbeError]>:
    val result: Result[FutureProbeSlice, FutureProbeError] = Ok(FutureProbeSlice([37, 41], 7))
    Future<Result[FutureProbeSlice, FutureProbeError]>.from_value(result)

fn prefetch_snapshot(mode: i64) -> Future<Result[(), FutureProbeError]>:
    if mode == 1:
        val result: Result[(), FutureProbeError] = Err(FutureProbeError.closed)
        return Future<Result[(), FutureProbeError]>.from_value(result)
    if mode == 2:
        val result: Result[(), FutureProbeError] = Err(FutureProbeError.cancelled)
        return Future<Result[(), FutureProbeError]>.from_value(result)
    if mode == 3:
        val result: Result[(), FutureProbeError] = Err(FutureProbeError.invalid_range)
        return Future<Result[(), FutureProbeError]>.from_value(result)
    val result: Result[(), FutureProbeError] = Ok(())
    Future<Result[(), FutureProbeError]>.from_value(result)

fn check_prefetch(mode: i64) -> bool:
    val future: Future<Result[(), FutureProbeError]> = prefetch_snapshot(mode)
    if val Poll.Ready(result) = future.poll():
        if val Err(error) = result:
            if mode == 1: return error == FutureProbeError.closed
            if mode == 2: return error == FutureProbeError.cancelled
            if mode == 3: return error == FutureProbeError.invalid_range
            return false
        if val Ok(value) = result:
            return mode == 0
    false

fn main() -> i64:
    val pending: Future<bool> = cancellation_snapshot(false)
    if val Poll.Ready(value) = pending.poll():
        return 11
    val ready: Future<bool> = cancellation_snapshot(true)
    var saw_ready = false
    if val Poll.Ready(value) = ready.poll():
        saw_ready = value
    if not saw_ready: return 12
    val reading: Future<Result[FutureProbeSlice, FutureProbeError]> = read_snapshot()
    var saw_payload = false
    if val Poll.Ready(result) = reading.poll():
        if val Ok(slice) = result:
            saw_payload = slice.offset == 7 and slice.bytes.len() == 2 and slice.bytes[0] == 37 and slice.bytes[1] == 41
    if not saw_payload: return 13
    if not check_prefetch(0): return 20
    if not check_prefetch(1): return 21
    if not check_prefetch(2): return 22
    if not check_prefetch(3): return 23
    print "future-receiver-pass"
    0
