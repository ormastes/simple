# Shared native positive setup. This does not mint archive/weave authority:
# the actual selected controller and genuine capture functions do that work.
# Independent fixtures may supply their real provider path and logical labels.
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_hir_archive_schedule_owner_v1.*
use compiler.driver.driver_hir_post_validation_policy_owner_v1.*
use compiler.driver.driver_hir_pipeline_lowering.*
use compiler.driver.cache.driver_hir_archive_weave_boundary_v1.*
use compiler.driver.cache.driver_hir_managed_runtime_selection_v1.*
use compiler.driver.cache.driver_hir_archive_journal_v1.*
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1,
    hir_body_archive_load_in_owned_scope_v1}
use compiler.driver.driver_hir_cache.{hir_cache_promote_diagnostic_owner_v1,
    hir_cache_clear_last_warnings}
use compiler.common.driver_core_types.{SourceFile, driver_core_compile_options_default}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfaceBuilder, ModuleSurfacesByName}
use compiler.hir.hir_types.{HirModule}
use compiler.common.config.{Logger}
use compiler.semantics.rt_criticality_validation.*
use compiler.semantics.rt_criticality.{RtBoundCapability, RT_EFFECT_ALLOC,
    rt_closure_digest, rt_bound_manifest_replace}
use std.common.crypto.sha256.{sha256_text}
use std.env.{env_get}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

extern fn rt_hash_text(content: text) -> i64

struct HirArchiveWeaveFixtureSetupV1:
    driver: CompilerDriver
    selected: DriverHirManagedRuntimeSelectionV1
    source: SourceFile
    alias: SourceFile
    archive: HirBodyArchiveV1
    capability: RtBoundCapability
    boundary: DriverHirArchiveWeaveBoundaryV1

fn fixture_actual_capability_v1(module: HirModule) -> Result<RtBoundCapability, text>:
    val declarations = rt_module_function_declarations_v1(module.name, module)
    val names = rt_unambiguous_declaration_names_v1(declarations)
    var rows: [RtCriticalFunctionFactsV1] = []
    var root = ""
    for func in module.functions.values():
        val row = rt_function_facts_v1(module.name, module, func, names)
        rows.push(row)
        if func.name == "submit_view": root = rt_stable_fn_id(row.declaration.module_key, row.declaration.symbol_id)
    if root == "": return Err("fixture actual submit_view root absent")
    Ok(RtBoundCapability(subject_id: root,
        closure_digest: rt_closure_digest(root, rt_criticality_graph_facts_v1(rows)),
        effect: RT_EFFECT_ALLOC, max_units: 0, review_id: "FIXTURE-WEAVE-ACTUAL-SUBMIT"))

fn fixture_capability_from_archive_v1(archive: HirBodyArchiveV1) -> Result<RtBoundCapability, text>:
    if not transient_scope_begin(): return Err("fixture capability body lease refused")
    val loaded = hir_body_archive_load_in_owned_scope_v1(archive, archive.input)
    val result: Result<RtBoundCapability, text> = if loaded.is_err(): Err(loaded.unwrap_err()) else:
        fixture_actual_capability_v1(loaded.unwrap())
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val memo = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not owned or not memo or not ended: panic("fixture capability body ownership")
    result

pub fn hir_archive_weave_fixture_setup_v1(path: text, name: text, alias_name: text
) -> Result<HirArchiveWeaveFixtureSetupV1, text>:
    val selected = driver_hir_capture_managed_runtime_selection_v1("llvm",
        env_get("SIMPLE_NATIVE_BUILD_TARGET"), env_get("SIMPLE_NATIVE_RUNTIME_BUNDLE"))?
    val loaded_source = SourceFile.load(path)?
    val alternate = SourceFile.load("./" + path)?
    val source = SourceFile(..loaded_source, module_name: name)
    val alias = SourceFile(..alternate, module_name: alias_name)
    if name == alias_name or source.authored_path == alias.authored_path or source.content != alias.content:
        return Err("fixture actual independent alias source differs")
    val parsed = parse_full_frontend(source.content, path, name, Logger(level: 0))
    val builder = ModuleSurfaceBuilder.new()
    val canonical = builder.add_parsed(parsed, source, 0)?
    val aliased = builder.add_alias(alias)?
    val surfaces = ModuleSurfacesByName.empty()
    val failure = builder.finish_into(surfaces)
    if failure != "": return Err(failure)
    val driver = CompilerDriver.create(driver_core_compile_options_default())
    driver.ctx.options.low_memory = true
    driver.ctx.options.cli_mode_text = "aot"
    driver.ctx.config["compiler_source_entry"] = source.path
    driver.ctx.native_target = selected.target
    driver.hir_archive_managed_runtime_selection = Some(selected)
    driver.ctx.source_paths_owner = [source.path, alias.path]
    driver.ctx.source_authored_paths_owner = [source.authored_path, alias.authored_path]
    driver.ctx.source_module_names_owner = [name, alias_name]
    driver.ctx.source_contents_owner = [source.content, alias.content]
    driver.ctx.source_identities_owner = [sha256_text(source.content), sha256_text(source.content)]
    driver.ctx.source_byte_lengths_owner = [source.content.len(), source.content.len()]
    val raw_hash = rt_hash_text(source.content)
    val retained_hash = if raw_hash == 0: 1 else: raw_hash
    driver.ctx.source_content_hashes_owner = [retained_hash, retained_hash]
    driver.streaming_module_surfaces_owner = surfaces
    driver.streaming_surface_owner_ready = true
    driver.streaming_entry_source_index_owner = -1
    val schedule = driver.capture_hir_archive_streaming_schedule_v1()?
    val journal = driver_hir_archive_journal_create_v1(driver.ctx, selected)?
    driver.hir_archive_publication_journal = Some(journal)
    # The controller ignores this caller lowerer for archive-mode production
    # and constructs private real surfaces plus a forced-source lowerer.
    val caller_lowerer = HirLowering.with_filename(path)
    val completed = driver.lower_streaming_hir_selected_archived_shard_transaction_v1(
        caller_lowerer, source, 0, false, journal.registration)?
    if completed.status != 1 or completed.archive == nil or completed.declaration_registration == nil:
        return Err("fixture actual selected closed transaction refused")
    val archive = completed.archive.unwrap()
    val published = driver_hir_archive_journal_publish_v1(journal, driver.ctx, 0, name,
        completed.declaration_registration.unwrap())?
    val alias_published = driver_hir_archive_journal_alias_v1(journal, driver.ctx, 1, alias_name, name)?
    val capability = fixture_capability_from_archive_v1(archive)?
    rt_bound_manifest_replace([capability])
    val policy = driver.capture_hir_archive_post_validation_policy_v1()?
    val boundary = driver_hir_archive_weave_boundary_capture_v1(driver)?
    Ok(HirArchiveWeaveFixtureSetupV1(driver, selected, source, alias, archive, capability, boundary))

export HirArchiveWeaveFixtureSetupV1, hir_archive_weave_fixture_setup_v1
