use test.fixtures.native_trait_match_owner.provider.{MatchOwner, optional_owner}

fn matched(choice: i64) -> i64:
    val optional = optional_owner(choice)
    val selected = match optional:
        case Some(owner): owner
        case nil: return -1
    selected.code() * 100 + selected.adjusted()

fn guarded(choice: i64) -> i64:
    val optional = optional_owner(choice)
    val selected = match optional:
        case Some(owner) if choice == 1: owner
        case Some(owner): owner
        case nil: return -2
    selected.adjusted()

fn main() -> i64:
    assert matched(0) == -1
    assert matched(1) == 3136
    assert matched(2) == 4758
    assert guarded(0) == -2
    assert guarded(1) == 36
    assert guarded(2) == 58
    print("native_trait_match_owner: 6 checks passed")
    0
