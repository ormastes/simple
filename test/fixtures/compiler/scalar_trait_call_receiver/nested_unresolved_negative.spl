# Expected native compilation failure containing unresolved method call:
# missing_nested_method. The diagnostic must propagate through both lifts.
use .provider.{scalar_token}

fn invoke(callback: fn() -> i64) -> i64:
    callback()

fn nested_invalid() -> fn() -> i64:
    \:
        invoke(\: scalar_token("nested invalid call").missing_nested_method())

fn main() -> i64:
    val nested = nested_invalid()
    nested()
