# Expected compile rejection: a blanket receiver may match i64 and must
# remain an ambiguity barrier while generic dispatch is unsupported here.
trait BlanketProbe:
    fn measured() -> i64
trait ConcreteProbe:
    fn measured() -> i64
impl<T> BlanketProbe for T:
    fn measured() -> i64:
        10
impl ConcreteProbe for i64:
    fn measured() -> i64:
        20
fn scalar_token(value) -> i64:
    41
fn main() -> i64:
    scalar_token("untyped input").measured()
