# Untyped input remains inferred; only the return is declared.
pub fn scalar_token(value) -> i64:
    41

pub trait ScalarProbe:
    fn measured() -> i64

impl ScalarProbe for i64:
    fn measured() -> i64:
        self + 1

impl ScalarProbe for bool:
    fn measured() -> i64:
        900

var scalar_probe_calls: i64 = 0
pub fn counted_token(value) -> i64:
    scalar_probe_calls = scalar_probe_calls + 1
    41
pub fn token_call_count() -> i64:
    scalar_probe_calls
