use .provider.{scalar_token, counted_token, token_call_count, ScalarProbe as VisibleProbe}
use .bool_provider.{scalar_token as bool_token}

fn invoke(callback: fn() -> i64) -> i64:
    callback()

fn nested_receiver() -> fn() -> i64:
    \:
        invoke(\: counted_token("nested receiver").measured())

fn main() -> i64:
    if scalar_token("ordinary call").measured() != 42:
        return 1
    if invoke(\: counted_token("one lift").measured()) != 42:
        return 2
    val nested = nested_receiver()
    if nested() != 42:
        return 3
    if token_call_count() != 2:
        return 4
    # An imported alias with the same original callable leaf must retain its
    # own bool declaration, rather than borrowing the i64 return above.
    if invoke(\: bool_token("other owner").measured()) != 900:
        return 5
    print("NESTED_SCALAR_RTI_PASS")
    0
