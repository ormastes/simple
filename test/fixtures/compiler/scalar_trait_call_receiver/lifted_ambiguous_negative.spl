# Expected native compilation rejection: ambiguous scalar trait method: measured.
# A lifted body must retain the same ambiguity marker as an ordinary body.
# Expected native compile rejection: two visible traits supply the same
# method on exactly i64. Neither provider may win by registration order.
trait LeftProbe:
    fn measured() -> i64
trait RightProbe:
    fn measured() -> i64
impl LeftProbe for i64:
    fn measured() -> i64:
        10
impl RightProbe for i64:
    fn measured() -> i64:
        20
fn scalar_token(value) -> i64:
    41
fn invoke(callback: fn() -> i64) -> i64:
    callback()
fn main() -> i64:
    invoke(\: scalar_token("lifted ambiguous receiver").measured())
