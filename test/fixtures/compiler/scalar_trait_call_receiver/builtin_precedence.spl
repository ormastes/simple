# A visible unsupported blanket trait must not reject an established builtin.
trait GenericLength:
    fn len() -> i64
impl<T> GenericLength for T:
    fn len() -> i64:
        999
fn text_token(value) -> text:
    "abc"
fn main() -> i64:
    if text_token(0).len() != 3:
        return 1
    print("SCALAR_BUILTIN_PRECEDENCE_PASS")
    0
