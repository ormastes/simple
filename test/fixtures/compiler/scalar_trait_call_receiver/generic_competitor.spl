# Expected compile rejection: an unsupported visible generic candidate is
# not permission to choose a competing concrete implementation.
trait GenericProbe:
    fn pick<T>(value: T) -> i64
trait ConcreteProbe:
    fn pick(value: i64) -> i64
impl GenericProbe for i64:
    fn pick<T>(value: T) -> i64:
        10
impl ConcreteProbe for i64:
    fn pick(value: i64) -> i64:
        20
fn scalar_token(value) -> i64:
    41
fn main() -> i64:
    scalar_token("untyped input").pick(1)
