# Pattern: trait with a DEFAULT method; an impl omits it; the default is called
# through the trait (as the outline/block registry does for BlockDefinition).
# Stage3 repro: bin/simple.exe native-build test/fixtures/compiler/outline_block_trait_default_slots/main.spl -o out.exe && ./out.exe
# Expected stdout (exit 0):
#   outline_block_trait_default_slots ok
# Baked producer defect: emitted an empty method placeholder without signature for
# the omitted default, so the trait table/signature lengths were unequal (MIR fatal).
# Bug: outline_block_native_prerequisites_2026_10_16
trait Block:
    fn kind() -> text
    fn policy() -> text:
        "default"

struct Plain:
    pass

struct Custom:
    pass

impl Block for Plain:
    fn kind() -> text: "plain"

impl Block for Custom:
    fn kind() -> text: "custom"
    fn policy() -> text: "override"

fn describe(b: Block) -> text:
    b.kind() + ":" + b.policy()

fn main() -> i64:
    if describe(Plain()) != "plain:default": return 1
    if describe(Custom()) != "custom:override": return 2
    print "outline_block_trait_default_slots ok"
    0
