# Distinguish the native tuple carrier from Result pattern extraction.
# Every Result declaration retains its exact tuple/array/text payload types.
enum CompetingWrapper:
    Ok(i64, [i64])
    Err(text)

fn multi_argument(value: CompetingWrapper) -> i64:
    match value:
        case CompetingWrapper.Err(message):
            print "tuple competing branch=Err message={message}"
            -1
        case CompetingWrapper.Ok(number, items):
            val count = items.len()
            val first = items[0]
            print "tuple competing branch=Ok number={number} count={count} first={first}"
            number + first

fn single_payload(value: Result<(i64, [i64]), text>) -> i64:
    match value:
        case Err(message):
            print "tuple single branch=Err message={message}"
            -1
        case Ok(payload):
            val number = payload[0]
            val items = payload[1]
            val count = items.len()
            val first = items[0]
            print "tuple single branch=Ok number={number} count={count} first={first}"
            number + first

fn nested_payload(value: Result<(i64, [i64]), text>) -> i64:
    match value:
        case Err(message):
            print "tuple nested branch=Err message={message}"
            -1
        case Ok((number, items)):
            val count = items.len()
            val first = items[0]
            print "tuple nested branch=Ok number={number} count={count} first={first}"
            number + first

fn make_result(payload: (i64, [i64])) -> Result<(i64, [i64]), text>:
    Ok(payload)

fn main() -> i64:
    val input: (i64, [i64]) = (11, [7])
    val input_number = input[0]
    val input_items = input[1]
    val input_count = input_items.len()
    val input_first = input_items[0]
    print "tuple input number={input_number} count={input_count} first={input_first}"
    val direct: Result<(i64, [i64]), text> = Ok(input)
    val returned = make_result(input)
    val direct_single = single_payload(direct)
    val returned_single = single_payload(returned)
    val direct_nested = nested_payload(direct)
    val returned_nested = nested_payload(returned)
    val inline_nested = nested_payload(Ok((11, [7])))
    val competing = multi_argument(CompetingWrapper.Ok(11, [7]))
    val error_single = single_payload(Err("single-error"))
    val error_nested = nested_payload(Err("nested-error"))
    print "tuple totals direct_single={direct_single} returned_single={returned_single} direct_nested={direct_nested} returned_nested={returned_nested} inline_nested={inline_nested} error_single={error_single} error_nested={error_nested} competing={competing}"
    if input_number != 11 or input_count != 1 or input_first != 7: return 1
    if direct_single != 18: return 2
    if returned_single != 18: return 3
    if direct_nested != 18: return 4
    if returned_nested != 18: return 5
    if inline_nested != 18: return 6
    if error_single != -1 or error_nested != -1: return 7
    if competing != 18: return 8
    print "Result tuple payload: 8 checks, 0 failures"
    0
