# Positive control for the same declarations and generic call as main.spl.
struct Expected:
    value: i64

struct Wrong:
    value: i64

fn consume[T](fixed: Expected, payload: T) -> T:
    payload

fn main() -> i64:
    val correct = Expected(value: 7)
    if consume(correct, 42) != 42:
        return 1
    0
