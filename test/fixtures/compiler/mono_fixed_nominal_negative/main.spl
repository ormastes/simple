# Must fail frontend type checking at the consume call: Wrong is not Expected.
# A generic-inference, parser, import, cache or toolchain error is NOT a pass.
struct Expected:
    value: i64

struct Wrong:
    value: i64

fn consume[T](fixed: Expected, payload: T) -> T:
    payload

fn main() -> i64:
    val wrong = Wrong(value: 7)
    consume(wrong, 42)
