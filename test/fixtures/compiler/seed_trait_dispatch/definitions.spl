trait Kinded:
    fn kind() -> i64

struct ShellBlockDef(Kinded):
    fn kind() -> i64: 17

struct SqlBlockDef(Kinded):
    fn kind() -> i64: 29

trait Read:
    fn read_all() -> i64

struct MemoryReader(Read):
    value: i64
    fn read_all() -> i64: self.value

# Name contains Read, but this concrete type must never own another reader.
struct ShbReader(Read):
    fn read_all() -> i64: 999

trait Write:
    fn write(value: i64) -> i64

struct MemoryWriter(Write):
    fn write(value: i64) -> i64: value + 10

struct SmfWriter(Write):
    fn write(value: i64) -> i64: 999
