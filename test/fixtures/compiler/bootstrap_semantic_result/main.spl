struct ProbeError:
    message: text

fn probe_err<T>(message: text) -> Result<T, ProbeError>:
    Err(ProbeError(message: message))

fn explicit_return() -> Result<i64, ProbeError>:
    return probe_err("explicit")

fn tail_return() -> Result<i64, ProbeError>:
    probe_err("tail")

fn branch_return(flag: bool) -> Result<i64, ProbeError>:
    if flag:
        probe_err("branch")
    else:
        Ok(42)

fn main() -> i64:
    if not explicit_return().is_err(): return 1
    if not tail_return().is_err(): return 2
    if not branch_return(true).is_err(): return 3
    if branch_return(false).unwrap() != 42: return 4
    0
