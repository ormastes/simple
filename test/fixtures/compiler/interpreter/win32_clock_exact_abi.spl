# Windows-only fixed ABI control; no pointer-valued or mixed-width foreign calls.
@unsafe(reason: "Win64 monotonic clock ABI regression", capabilities: [ffi])
extern fn GetTickCount64() -> u64
val first: u64 = GetTickCount64()
val second: u64 = GetTickCount64()
assert(second >= first)
print "win32-clock-exact-abi PASS"
