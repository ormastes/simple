# Native repro for mir_unannotated_collection_element_type_lost_2026_10_20.
# Stage3 repro: bin/simple native-build --entry <this file> --output build/ucp && build/ucp
# Expected stdout: UNANNOTATED_POP_OK
# Failing producer reports "unresolved method call: pop" on the unannotated forms.
fn pop_text(x: text) -> text:
    var pending = [x]
    pending.pop() ?? ""

fn pop_int(a: i64, b: i64) -> i64:
    var pending = [a, b]
    pending.pop() ?? -1

# Mirrors coordinator.spl worklist: unannotated literal, index-read then pop statement.
fn drain_count(x: text) -> i64:
    var pending = [x]
    var visited = 0
    while pending.len() > 0:
        val cur = pending[pending.len() - 1]
        pending.pop()
        visited = visited + 1
    visited

fn main():
    if pop_text("a") == "a" and pop_int(1, 2) == 2 and drain_count("z") == 1:
        print "UNANNOTATED_POP_OK"
