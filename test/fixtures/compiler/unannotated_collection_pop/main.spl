# Native repro for mir_unannotated_collection_element_type_lost_2026_10_20.
# Stage3 repro: bin/simple native-build --entry <this file> --output build/ucp && build/ucp
# Expected stdout: UNANNOTATED_POP_OK
# Failing producer reports "unresolved method call: pop" at the first form.
fn pop_unannotated(x: text) -> text:
    var pending = [x]
    val got = pending.pop()
    if got.?:
        return got.unwrap()
    ""

fn pop_annotated(x: text) -> text:
    var pending: [text] = [x]
    val got = pending.pop()
    if got.?:
        return got.unwrap()
    ""

fn main():
    if pop_unannotated("a") == "a" and pop_annotated("b") == "b":
        print "UNANNOTATED_POP_OK"
