class ContextCell:
    first: i64
    second: i64

    fn read_second() -> i64:
        self.second

var REGISTRY: Dict<i64, ContextCell> = {}

fn read_registered(key: i64) -> i64:
    if not REGISTRY.contains(key): return -1
    val context = REGISTRY[key]
    context.read_second()

fn main() -> i64:
    REGISTRY[7] = ContextCell(first: 3, second: 17)
    if read_registered(7) != 17: return 1
    if read_registered(8) != -1: return 2
    val local: Dict<i64, ContextCell> = {9: ContextCell(first: 4, second: 23)}
    if local[9].read_second() != 23: return 3
    if local[9].first != 4: return 4
    0
