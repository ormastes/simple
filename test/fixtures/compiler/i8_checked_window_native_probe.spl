# Signed control for the high-bit U8 checked-window reproducer. Keep the byte
# live across the validation branch and verify every copied numeric value.
fn checked_signed_window(values: [i8]) -> Result<[i64], text>:
    var result: [i64] = []
    for index in 0..values.len():
        val byte = values[index]
        val value = byte as i64
        if value < -128 or value > 127:
            return Err("signed byte range")
        result.push(byte as i64)
    Ok(result)

fn main():
    val values: [i8] = [-128, -1, 0, 127]
    val checked = checked_signed_window(values)
    assert(checked.is_ok())
    val copied = checked.unwrap()
    assert(copied.len() == 4)
    assert(copied[0] == -128)
    assert(copied[1] == -1)
    assert(copied[2] == 0)
    assert(copied[3] == 127)
