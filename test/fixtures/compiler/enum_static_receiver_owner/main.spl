use .left.{DbValue as LeftValue, DbType}
use .right.{DbValue as RightValue}

enum DbValue:
    Text(value: bool)

var payload_calls: i64 = 0

fn next_payload() -> i64:
    payload_calls = payload_calls + 1
    35

fn main() -> i64:
    val left = LeftValue.Integer(value: next_payload())
    if payload_calls != 1: return 1
    val left_number = match left:
        LeftValue.Integer(value): value
        _: -1
    if left_number != 35: return 2
    val text_values: [LeftValue] = [LeftValue.Text(value: "left")]
    val left_text = match text_values[0]:
        LeftValue.Text(value): value
        _: "wrong"
    if left_text != "left": return 3
    val right = RightValue.Text(value: 71)
    val right_number = match right:
        RightValue.Text(value): value
        _: -1
    if right_number != 71: return 4
    val local = DbValue.Text(value: true)
    val local_flag = match local:
        DbValue.Text(value): value
    if not local_flag: return 5
    if LeftValue.factory() != 69: return 6
    0
