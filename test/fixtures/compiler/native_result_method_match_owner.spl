enum OtherMethodVerdict:
    Ok(i64)
    Err(text)

struct MethodResultSource:
    value: i64

impl MethodResultSource:
    fn read(self, succeed: bool) -> Result<i64, text>:
        if succeed: Ok(self.value)
        else: Err("method-error")

fn main() -> i64:
    val source = MethodResultSource(value: 29)
    val good = match source.read(true):
        case Result.Ok(value): value
        case Result.Err(_): -1
    val bad = match source.read(false):
        case Result.Ok(_): "wrong-success"
        case Result.Err(detail): detail
    if good != 29 or bad != "method-error": return 1
    print "result-method-match-owner: PASS"
    0
