# Native positive fixture: expected exit 0, source must compile with changed mono.
fn marker<T = i64>() -> i64:
    19

fn dependent<T = i64, U = [T]>() -> i64:
    29

fn inferred<T = i64>(value: T) -> T:
    value

fn sparse<T = i64, U = text, V = bool>(value: U) -> i64:
    23

fn first_or<T = bool>(values: [T], fallback: T) -> T:
    fallback

fn main() -> i64:
    assert(marker() == marker<i64>())
    assert(dependent() == dependent<i64, [i64]>())
    assert(inferred(true) == true)
    assert(sparse<text>("hello") == sparse<text, text, bool>("world"))
    assert(marker() + dependent() + sparse("hello") == 71)
    assert(first_or([], 9) == 9)
    0
