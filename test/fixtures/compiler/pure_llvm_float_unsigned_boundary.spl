# Compile with an admitted producer containing the changed LLVM cast owner.
# @req REQ-PURE-LLVM-FLOAT-UNSIGNED
fn boundary_f64_to_u32(value: f64) -> u32:
    value as u32

fn boundary_f64_to_u64(value: f64) -> u64:
    value as u64

fn boundary_u32_to_f64(value: u32) -> f64:
    value as f64

fn boundary_u64_to_f64(value: u64) -> f64:
    value as f64

fn boundary_f64_to_i32(value: f64) -> i32:
    value as i32

fn boundary_f64_to_i64(value: f64) -> i64:
    value as i64

fn boundary_i32_to_f64(value: i32) -> f64:
    value as f64

fn boundary_i64_to_f64(value: i64) -> f64:
    value as f64

fn main():
    assert(boundary_f64_to_u32(2147483648.0) == 2147483648u32)
    assert(boundary_f64_to_u32(4294967295.0) == 4294967295u32)
    assert(boundary_f64_to_u64(9223372036854775808.0) == 0x8000000000000000u64)
    assert(boundary_u32_to_f64(4294967295u32) == 4294967295.0)
    assert(boundary_u64_to_f64(0x8000000000000000u64) == 9223372036854775808.0)
    assert(boundary_f64_to_i32(-3.75) == -3i32)
    assert(boundary_f64_to_i64(-3.75) == -3i64)
    assert(boundary_i32_to_f64(-3i32) == -3.0)
    assert(boundary_i64_to_f64(-3i64) == -3.0)
    print "float-unsigned-boundaries: PASS"
