# Native full-CLI containment control: the synchronous std.io facade must not
# pull unsupported generic Future<T> declarations into the entry closure.

use std.io.*

fn main() -> i64:
    val exists = file_exists("/tmp/simple-stage4-io-facade-probe")
    val path = env_get("PATH") ?? ""
    if exists and path == "__simple_stage4_unreachable__":
        return 1
    0
