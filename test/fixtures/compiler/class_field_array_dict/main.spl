# Native regression: execute this output; interpreter success is not native proof.
class ArrayDictOwner:
    rows: Dict<i64, [i64]>

    static fn new() -> ArrayDictOwner:
        ArrayDictOwner(rows: {})

    me put(key: i64, values: [i64]):
        self.rows[key] = values

    fn read(key: i64) -> [i64]:
        self.rows[key]

class ScalarDictOwner:
    rows: Dict<i64, i64>

    static fn new() -> ScalarDictOwner:
        ScalarDictOwner(rows: {})

    me put(key: i64, value: i64):
        self.rows[key] = value

    fn read(key: i64) -> i64:
        self.rows[key]

fn check_array(values: [i64], first: i64, second: i64):
    assert(values.len() == 2)
    assert(values[0] == first)
    assert(values[1] == second)

fn main():
    val owner = ArrayDictOwner.new()
    owner.put(11, [17, -23])
    owner.put(29, [41, 53])
    check_array(owner.read(29), 41, 53)
    check_array(owner.read(11), 17, -23)
    owner.put(11, [67, -79])
    check_array(owner.read(11), 67, -79)
    check_array(owner.read(29), 41, 53)
    owner.put(31, [])
    assert(owner.read(31).len() == 0)

    val local: Dict<i64, [i64]> = {11: [83, 97], 29: [-101, 103]}
    check_array(local[29], -101, 103)
    check_array(local[11], 83, 97)

    val scalar = ScalarDictOwner.new()
    scalar.put(11, 109)
    scalar.put(29, -127)
    assert(scalar.read(11) == 109)
    assert(scalar.read(29) == -127)
    print "CLASS_FIELD_ARRAY_DICT_PASS|checks=21"
