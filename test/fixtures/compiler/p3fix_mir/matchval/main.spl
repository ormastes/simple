# p3fix MIR payload regression fixture (bug docs: doc/08_tracking/bug/*_2026-10-24.md)
# EXPECT stdout: 1
class Eff:
    n: i64

enum Ty:
    Function(params: [i64], ret: i64, effects: [Eff])
    Other

enum Mode:
    Check(effs: [Eff])
    Synth

fn effects_of(t: Ty) -> Mode:
    val callee_effects = match t:
        case Ty.Function(_, _, effects): effects
        case _: []
    Mode.Check(callee_effects)

fn main():
    match effects_of(Ty.Function([1], 2, [Eff(n: 7)])):
        case Mode.Check(es): print es.len()
        case _: print "x"
