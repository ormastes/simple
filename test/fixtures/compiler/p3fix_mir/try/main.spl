# p3fix MIR payload regression fixture (bug docs: doc/08_tracking/bug/*_2026-10-24.md)
# EXPECT stdout: 5
use types.*
use host.{Host}

fn main():
    val h = Host(base: 2)
    match h.process(3):
        case Ok(r):
            match r:
                case BRes.Value(v): print v.n
                case _: print "x"
        case Err(e): print e.msg
