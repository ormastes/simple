# p3fix MIR payload regression fixture (bug docs: doc/08_tracking/bug/*_2026-10-24.md)
# EXPECT stdout: ab
class Impl:
    name: text

enum TErr:
    Overlap(a: Impl, b: Impl)
    Fine

class Solver:
    impls: Dict<text, [Impl]>

    fn check() -> TErr:
        for k in self.impls.keys():
            val impl_list = self.impls[k]
            for i in 0..impl_list.len():
                for j in (i + 1)..impl_list.len():
                    val impl1 = impl_list[i]
                    val impl2 = impl_list[j]
                    return TErr.Overlap(impl1, impl2)
        TErr.Fine

fn main():
    var d: Dict<text, [Impl]> = {}
    d["t"] = [Impl(name: "a"), Impl(name: "b")]
    val s = Solver(impls: d)
    match s.check():
        case TErr.Overlap(a, b): print a.name + b.name
        case _: print "x"
