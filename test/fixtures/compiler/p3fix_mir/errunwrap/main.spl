# p3fix MIR payload regression fixture (bug docs: doc/08_tracking/bug/*_2026-10-24.md)
# EXPECT stdout: err
enum PErr:
    Bad(msg: text)
    Worse

fn validate(k: i64) -> Result<i64, PErr>:
    if k < 0:
        return Err(PErr.Bad("neg"))
    Ok(k)

fn load(k: i64) -> Result<i64, PErr>:
    val validated = validate(k)
    if validated.is_err():
        return Err(validated.err().unwrap())
    Ok(k + 1)

fn main():
    match load(-1):
        case Ok(v): print v
        case Err(e): print "err"
