# p3fix MIR payload regression fixture (bug docs: doc/08_tracking/bug/*_2026-10-24.md)
# EXPECT stdout: 6
class Blk:
    n: i64

enum Ex:
    If(c: i64, then_: Blk, else_: Blk?)
    Lit(v: i64)

fn fix(b: Blk) -> Blk:
    Blk(n: b.n + 1)

fn resolve(c: i64, t: Blk, e: Blk?) -> Ex:
    val resolved_else = match e:
        case Some(eb):
            Some(fix(eb))
        case nil:
            None
    Ex.If(c, fix(t), resolved_else)

fn main():
    match resolve(1, Blk(n: 1), Some(Blk(n: 5))):
        case Ex.If(_, _, e):
            if val b = e:
                print b.n
        case _: print "x"
