# p3fix MIR payload regression fixture (bug docs: doc/08_tracking/bug/*_2026-10-24.md)
# EXPECT stdout: bad
use gen.{gen_err}
use res.{CRes}

fn compile_it(k: i64) -> CRes:
    val cmake_err = gen_err(k)
    if cmake_err != nil:
        if val present_cmake_err = cmake_err:
            return CRes.CodegenError(present_cmake_err)
    CRes.Fine

fn main():
    match compile_it(1):
        case CRes.CodegenError(m): print m
        case _: print "fine"
