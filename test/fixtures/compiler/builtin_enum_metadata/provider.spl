# Real cross-module constructors: preserve distinct Result T/E and Option T.
pub fn builtin_metadata_success(value: i64) -> Result<i64, text>:
    Ok(value)

pub fn builtin_metadata_error(value: text) -> Result<i64, text>:
    Err(value)

pub fn builtin_metadata_present(value: text) -> Option<text>:
    Some(value)

pub fn builtin_metadata_absent() -> Option<text>:
    None

pub fn builtin_metadata_fraction(value: f64) -> Option<f64>:
    Some(value)

pub fn builtin_metadata_values(value: [i64]) -> Option<[i64]>:
    Some(value)
