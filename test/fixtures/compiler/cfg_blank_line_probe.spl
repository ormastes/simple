# Native regression for inactive declarations containing blank body lines.
use compiler.core.parser_preprocessor.{preprocess_conditionals}

fn cfg_blank_line_failure() -> i64:
    val doc = "@cfg(false)\nfn hidden():\n    \"\"\"Copy array values.\n\n    Decode `[u8]` elements.\n    \"\"\"\n    return 17\nfn kept():\n    return 23\n"
    val doc_expected = "\n\n\n\n\n\n\nfn kept():\n    return 23\n"
    if preprocess_conditionals(doc) != doc_expected:
        return 1
    val statements = "@cfg(false)\nfn hidden():\n    val first = 1\n   \t\n    return first\n@cfg(true)\nfn kept():\n    return 29\n"
    val statements_expected = "\n\n\n\n\n\nfn kept():\n    return 29\n"
    if preprocess_conditionals(statements) != statements_expected:
        return 2
    val nested = "class Container:\n    @cfg(false)\n    fn hidden():\n        val first = 1\n\n        return first\n    fn kept():\n        return 31\n"
    val nested_expected = "class Container:\n\n\n\n\n\n    fn kept():\n        return 31\n"
    if preprocess_conditionals(nested) != nested_expected:
        return 3
    val enabled = "@cfg(true)\nfn kept():\n    \"\"\"Keep this paragraph.\n\n    And this `code`.\n    \"\"\"\n    return 37\n"
    val enabled_expected = "\nfn kept():\n    \"\"\"Keep this paragraph.\n\n    And this `code`.\n    \"\"\"\n    return 37\n"
    if preprocess_conditionals(enabled) != enabled_expected:
        return 4
    0

fn main() -> i64:
    val failure = cfg_blank_line_failure()
    if failure != 0:
        print "cfg blank-line regression failed: {failure}"
        return failure
    print "cfg blank-line regressions: 4 passed"
    0
