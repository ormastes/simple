"""Native regression probe for repeated text search and substring extraction."""

fn find_text_from(value: text, needle: text, offset: i64) -> i64:
    var marker_at: i64 = -1
    var i = offset
    while i + needle.len() <= value.len() and marker_at < 0:
        if value.substring(i, i + needle.len()) == needle:
            marker_at = i
        i = i + 1
    marker_at

fn response_result_id(response: text) -> text:
    val id_marker = "\"id\":\""
    val id_at = find_text_from(response, id_marker, 0)
    if id_at < 0: return ""
    val start = id_at + id_marker.len()
    var finish = start
    while finish < response.len() and response[finish] != "\"":
        finish = finish + 1
    if finish >= response.len(): return ""
    response.substring(start, finish)

fn main() -> i64:
    val first = response_result_id("{\"id\":2,\"result\":{\"thread\":{\"id\":\"thread-123\"}}}")
    if first != "thread-123":
        print "FAIL first=" + first
        return 1
    val second = response_result_id("{\"id\":4,\"result\":{\"turn\":{\"id\":\"turn-456\",\"status\":\"inProgress\"}}}")
    if second != "turn-456":
        print "FAIL second=" + second
        return 2
    print "PASS repeated_text_result"
    0
