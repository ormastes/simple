# Stage 2 Cranelift repro: unary minus on an i32 call result.
# Before the fix the backend emitted `isub.i32 0, v` with v an I64 lane
# value and the verifier rejected the function
# (bug cranelift_narrow_negation_zero_width_2026-11-06).
# Expected output: -1, 1, -1, -2147483648, 7, -128, -32768, -300
fn cmp_i32(a: i64, b: i64) -> i32:
    if a < b: return -1
    if a > b: return 1
    0

fn order(a: i64, b: i64, ascending: bool) -> i32:
    val cmp = cmp_i32(a, b)
    val result = if ascending:
        cmp
    else:
        -cmp
    result

fn negate_i32(x: i32) -> i32:
    -x

fn negate_i8(x: i8) -> i8:
    -x

fn negate_i16(x: i16) -> i16:
    -x

fn main() -> i64:
    print(order(1, 2, true))
    print(order(1, 2, false))
    print(order(5, 2, false))
    print(negate_i32(-2147483647 - 1))
    print(negate_i8(-7))
    print(negate_i8(-127 - 1))
    print(negate_i16(-32767 - 1))
    print(negate_i16(300))
    0
