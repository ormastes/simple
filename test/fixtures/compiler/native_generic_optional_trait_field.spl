# Bootstrap producer regression: generic optional field payloads retain their
# owner; two implementations prevent a single-conformer/name-based shortcut.
trait CellOwner<T>:
    fn read() -> T
    me write(value: T)

class FirstCell:
    value: i64

impl CellOwner<i64> for FirstCell:
    fn read() -> i64:
        self.value
    me write(value: i64):
        self.value = value

class SecondCell:
    value: i64

impl CellOwner<i64> for SecondCell:
    fn read() -> i64:
        self.value
    me write(value: i64):
        self.value = value + 100

class OptionalCell:
    owner: CellOwner<i64>?
    fn read_if() -> i64:
        if val selected = self.owner:
            return selected.read()
        -1
    fn read_match() -> i64:
        match self.owner:
            case Some(selected): return selected.read()
            case _: return -2
    me write(value: i64):
        if val selected = self.owner:
            selected.write(value)

fn main() -> i64:
    val first = FirstCell(value: 11)
    val second = SecondCell(value: 29)
    var a = OptionalCell(owner: Some(first))
    var b = OptionalCell(owner: Some(second))
    val empty = OptionalCell(owner: None)
    assert a.read_if() == 11
    assert a.read_match() == 11
    assert b.read_if() == 29
    assert b.read_match() == 29
    a.write(7)
    b.write(7)
    assert a.read_if() == 7
    assert b.read_match() == 107
    assert empty.read_if() == -1
    assert empty.read_match() == -2
    print("native_generic_optional_trait_field: 8 checks passed")
    0
