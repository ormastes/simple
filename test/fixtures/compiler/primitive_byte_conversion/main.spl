# Run as a native executable with the repaired producer; nonzero is failure.
# Conversion checks deliberately call .to_i64(), not the cast workaround.
fn indexed_byte(data: [u8], index: i64) -> i64:
    data[index].to_i64()

fn signed_byte(value: i8) -> i64:
    value.to_i64()

fn signed_half(value: i16) -> i64:
    value.to_i64()

fn unsigned_half(value: u16) -> i64:
    value.to_i64()

fn signed_word(value: i32) -> i64:
    value.to_i64()

fn unsigned_word(value: u32) -> i64:
    value.to_i64()

fn text_number(value: text) -> i64:
    value.to_i64()

fn main() -> i64:
    val separators = ":=".bytes()
    if separators[0].to_i64() != 58: return 1
    if separators[1].to_i64() != 61: return 2
    val octets: [u8] = [0, 127, 128, 255]
    if indexed_byte(octets, 0) != 0: return 3
    if indexed_byte(octets, 1) != 127: return 4
    if indexed_byte(octets, 2) != 128: return 5
    if indexed_byte(octets, 3) != 255: return 6
    val negative: i8 = -1
    if signed_byte(negative) != -1: return 7
    if "58".to_i64() != 58: return 8
    if "-42".to_i64() != -42: return 9
    val negative_half: i16 = -32768
    val positive_half: u16 = 65535
    val negative_word: i32 = -2147483648
    val positive_word: u32 = 4294967295
    if signed_half(negative_half) != -32768: return 10
    if unsigned_half(positive_half) != 65535: return 11
    if signed_word(negative_word) != -2147483648: return 12
    if unsigned_word(positive_word) != 4294967295: return 13
    if text_number("255") != 255: return 14
    print "primitive-byte-conversion: numeric bytes, signed widening and text controls PASS"
    0
