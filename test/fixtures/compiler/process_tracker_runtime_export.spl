# Regression for the async facade consumed by runner_lifecycle.
# Probes runtime availability only; never starts or stops a container.
use std.nogc_async_mut.test_runner.process_tracker.{tracker_container_runtime}

fn main() -> i64:
    val runtime = tracker_container_runtime()
    if runtime == "docker" or runtime == "podman" or runtime == "none":
        return 0
    return 1
