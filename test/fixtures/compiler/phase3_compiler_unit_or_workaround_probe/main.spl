# TEMPORARY_BOOTSTRAP_WORKAROUND_P3_OR_18 regression. Actual declaration owners.
use compiler.hir.hir_types.{SymbolKind, HirTypeKind}
use compiler.hir.hir_operators.{HirBinOp}
use compiler.mir.mir_instruction_support.{MirBinOp}
use compiler.mir.mir_types.{MirTypeKind}
use compiler.types.dim_constraints.{DimCheckTiming}

fn symbol_group(value: SymbolKind) -> i64:
    match value:
        case SymbolKind.Class | SymbolKind.Struct | SymbolKind.Enum | SymbolKind.Trait: 1
        case _: 0

fn mir_group(value: MirBinOp) -> i64:
    match value:
        case MirBinOp.Eq | MirBinOp.Ne: 2
        case _: 0

fn hir_group(value: HirBinOp) -> i64:
    match value:
        case HirBinOp.And | HirBinOp.Or: 3
        case _: 0

fn type_group(value: MirTypeKind) -> i64:
    match value:
        case MirTypeKind.I8 | MirTypeKind.I16 | MirTypeKind.I32: 4
        case _: 0

fn timing_group(value: DimCheckTiming) -> i64:
    match value:
        case DimCheckTiming.CompileTime | DimCheckTiming.Both: 5
        case _: 0

fn hir_type_group(value: HirTypeKind) -> i64:
    match value:
        case HirTypeKind.Any | HirTypeKind.Error: 6
        case _: 0

fn main() -> i64:
    print symbol_group(SymbolKind.Class)
    print symbol_group(SymbolKind.Struct)
    print symbol_group(SymbolKind.Enum)
    print symbol_group(SymbolKind.Trait)
    print symbol_group(SymbolKind.Function)
    print mir_group(MirBinOp.Eq)
    print mir_group(MirBinOp.Ne)
    print mir_group(MirBinOp.Add)
    print hir_group(HirBinOp.And)
    print hir_group(HirBinOp.Or)
    print hir_group(HirBinOp.Add)
    print type_group(MirTypeKind.I8)
    print type_group(MirTypeKind.I16)
    print type_group(MirTypeKind.I32)
    print type_group(MirTypeKind.U8)
    print timing_group(DimCheckTiming.CompileTime)
    print timing_group(DimCheckTiming.Both)
    print timing_group(DimCheckTiming.Runtime)
    print hir_type_group(HirTypeKind.Any)
    print hir_type_group(HirTypeKind.Error)
    print hir_type_group(HirTypeKind.Bool)
    return 0
