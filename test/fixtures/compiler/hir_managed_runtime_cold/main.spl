# Fresh-process native control. Inherit the actual managed tool/runtime
# authorities and producer/header scope from the admitted parent launcher.
use compiler.driver.cache.driver_hir_managed_runtime_selection_v1.*
use compiler.backend.linker.linker_wrapper.{native_runtime_archive_inputs_for_platform}
use std.nogc_sync_mut.io.native_tool_authority_v1.{native_tool_strict_owner_ready_v1}
use std.nogc_sync_mut.io.native_runtime_authority_v1.{native_runtime_strict_owner_ready_v1,
    native_runtime_strict_provider_selection_revalidate_v1}
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end}

fn main() -> i64:
    if transient_array_scope_state_v1() != 0 or native_tool_strict_owner_ready_v1() or
            native_runtime_strict_owner_ready_v1(false): return 1
    var checks = 1
    if not transient_scope_begin(): return 2
    val refused = driver_hir_capture_managed_runtime_selection_v1("llvm", "", "core-c-bootstrap").is_err()
    val occupied = transient_array_scope_state_v1() == 1
    if not transient_scope_pause(): return 12
    val paused_refused = driver_hir_capture_managed_runtime_selection_v1("llvm", "", "core-c-bootstrap").is_err()
    val still_paused = transient_array_scope_state_v1() == 2
    if not transient_scope_end() or not refused or not occupied or
            native_tool_strict_owner_ready_v1() or native_runtime_strict_owner_ready_v1(false): return 3
    checks = checks + 1
    if not paused_refused or not still_paused: return 13
    checks = checks + 1
    val target = env_get("SIMPLE_NATIVE_BUILD_TARGET")
    val bundle = env_get("SIMPLE_NATIVE_RUNTIME_BUNDLE")
    val captured = driver_hir_capture_managed_runtime_selection_v1("llvm", target, bundle)
    if captured.is_err():
        print "cold runtime capture error: {captured.unwrap_err()}"
        return 4
    val selected = captured.unwrap()
    if not native_tool_strict_owner_ready_v1() or not native_runtime_strict_owner_ready_v1(false) or
            transient_array_scope_state_v1() != 0: return 5
    checks = checks + 1
    if selected.compiler_digest.len() != 64 or selected.provider.snapshot.digest.len() != 64 or
            selected.selection_digest.len() != 64 or selected.provider.pins.len() == 0: return 6
    checks = checks + 1
    if not transient_scope_begin(): return 7
    var scratch: [text] = []
    var index = 0
    while index < 64:
        scratch.push("post-admission-churn-{index}")
        index = index + 1
    if not transient_scope_end(): return 8
    val inputs = native_runtime_archive_inputs_for_platform(selected.provider.root, bundle, selected.msvc)
    if native_runtime_strict_provider_selection_revalidate_v1(selected.provider, inputs, true).is_err(): return 9
    checks = checks + 1
    val repeated = driver_hir_capture_managed_runtime_selection_v1("llvm", target, bundle)
    if repeated.is_err() or repeated.unwrap().selection_digest != selected.selection_digest or
            transient_array_scope_state_v1() != 0: return 10
    checks = checks + 1
    if checks != 7: return 11
    print "HIR managed runtime cold owner: {checks} checks passed"
    0
