# Exercise both argument append sites and preserve nested commas/parentheses.
use compiler.common.predicate_parser.{tokenize, parse_predicate, Token}
use compiler.common.predicate.{Predicate, Selector}

fn main() -> i64:
    match tokenize("import( core.alpha , app.beta )"):
        case Ok(tokens):
            if tokens.len() != 1:
                return 1
            match tokens[0]:
                case Sel(name, args):
                    if name != "import" or args.len() != 2:
                        return 2
                    if args[0] != "core.alpha" or args[1] != "app.beta":
                        return 3
                case _: return 4
        case Err(_): return 5

    match tokenize("call( i64 service.calc(pair(i64, text), bool) ) & depend( left , right )"):
        case Ok(tokens):
            if tokens.len() != 3:
                return 6
            match tokens[0]:
                case Sel(name, args):
                    if name != "call" or args.len() != 1:
                        return 7
                    if args[0] != "i64 service.calc(pair(i64, text), bool)":
                        return 8
                case _: return 9
            match tokens[1]:
                case And: pass
                case _: return 10
            match tokens[2]:
                case Sel(name, args):
                    if name != "depend" or args.len() != 2:
                        return 11
                    if args[0] != "left" or args[1] != "right":
                        return 12
                case _: return 13
        case Err(_): return 14

    # Empty trimmed arguments retain their existing omission behavior.
    match tokenize("import( , core.alpha , , app.beta , )"):
        case Ok(tokens):
            if tokens.len() != 1:
                return 23
            match tokens[0]:
                case Sel(_, args):
                    if args.len() != 2:
                        return 15
                    if args[0] != "core.alpha" or args[1] != "app.beta":
                        return 16
                case _: return 17
        case Err(_): return 18

    # The public parser must receive both ordered arguments, not just tokenize.
    match parse_predicate("pc{import(core.alpha, app.beta)}"):
        case Ok(pred):
            match pred:
                case Sel(selector):
                    match selector:
                        case Import(source, target):
                            if source != "core.alpha" or target != "app.beta":
                                return 19
                        case _: return 20
                case _: return 21
        case Err(_): return 22
    print "predicate_selector_arguments: PASS"
    0
