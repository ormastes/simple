# Regression for #3081: exercise the real verifier's recursive Ptr payload decode.
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.*
use compiler.mir.mir_verify.{MirVerifyReport, mir_verify_module}

fn pointer_report(pair: MirType) -> MirVerifyReport:
    val location = Span(start: 0, end: 0, line: 1, col: 1,
        file: "native_mir_ptr_payload", length: 0)
    val function = MirFunction(
        symbol: SymbolId(id: 800), name: "fixture.ptr_payload",
        signature: MirSignature(params: [pair], return_type: pair,
            is_variadic: false, params_known: true),
        locals: [MirLocal(id: LocalId(id: 0), name: Some("pointer"), type_: pair,
            kind: LocalKind.Arg(0), is_ghost: false)],
        blocks: [MirBlock(id: BlockId(id: 0), label: Some("entry"), instructions: [],
            terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Copy(LocalId(id: 0))))))],
        entry_block: BlockId(id: 0), span: location, generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {},
        layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "",
        is_export_c: false, export_name: "", has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false,
        unroll_factor: 0, pipeline_ii: 0, memory_banks: 0
    )
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[function.symbol] = function
    mir_verify_module(MirModule(name: "fixture.ptr_payload", functions: functions,
        statics: {}, constants: {}, types: {}))

fn main() -> i64:
    val scalar = MirType(kind: MirTypeKind.I64)
    val pointer = MirType(kind: MirTypeKind.Ptr(scalar, false))
    if not pointer_report(pointer).is_clean(): return 1
    val nested = MirType(kind: MirTypeKind.Ptr(pointer, false))
    if not pointer_report(nested).is_clean(): return 2
    val record = MirType(kind: MirTypeKind.Struct(SymbolId(id: 700)))
    if not pointer_report(MirType(kind: MirTypeKind.Ptr(record, false))).is_clean(): return 3
    val unknown = MirType(kind: MirTypeKind.Opaque("<unresolved>"))
    val rejected = pointer_report(MirType(kind: MirTypeKind.Ptr(unknown, false)))
    var found = false
    for finding in rejected.findings:
        if finding.rule == "MIRV-001": found = true
    if not found: return 4
    0
