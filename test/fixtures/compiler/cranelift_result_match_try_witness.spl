# Result match verification metadata must not reject executable Cranelift CFG.
fn half(n: i64) -> Result<i64, text>:
    if n % 2 == 0: Ok(n / 2)
    else: Err("odd")

fn run(n: i64) -> Result<i64, text>:
    val h = half(n)?
    Ok(h + 1)

fn main() -> i64:
    match run(8):
        case Ok(value):
            if value != 5: return 1
        case Err(_): return 2
    match run(7):
        case Ok(_): return 3
        case Err(error):
            if error != "odd": return 4
    print("result-match-try-ok")
    0
