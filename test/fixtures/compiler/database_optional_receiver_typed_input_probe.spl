# Actual async facade -> sync table owner, no local database mocks.
use std.nogc_async_mut.database.core.{SdnDatabase, SdnTable, SdnRow}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_delete}

fn db_probe_row_typed_v1(id: text, value: text) -> SdnRow:
    val row = SdnRow.empty()
    row.set("id", id)
    row.set("value", value)
    row.set("valid", "true")
    row

fn db_update_optional_typed_v1(db: SdnDatabase, table_name: text, id: text, value: text) -> bool?:
    # Explicit declared owner; getter, payload extraction and writeback stay actual.
    var current_table: SdnTable = db.get_table_mut(table_name)?
    val updated = current_table.update_row(id, db_probe_row_typed_v1(id, value))
    val visible = db.get_table(table_name) ?? return nil
    if updated:
        val seen = visible.get_row(id) ?? return nil
        if seen.get("value") != Some(value): return nil
    db.set_table(table_name, current_table)
    Some(updated)

fn db_delete_optional_typed_v1(db: SdnDatabase, table_name: text, id: text) -> bool?:
    var current_table: SdnTable = db.get_table_mut(table_name)?
    val deleted = current_table.mark_deleted(id)
    val visible = db.get_table(table_name) ?? return nil
    if deleted:
        val seen = visible.get_row(id) ?? return nil
        if seen.get("valid") != Some("false"): return nil
    db.set_table(table_name, current_table)
    Some(deleted)

fn db_optional_mutation_probe_typed_v1(path: text) -> i64:
    val db = SdnDatabase.new(path)
    val table = SdnTable.new("records", ["id", "value", "valid"])
    if not table.add_row(db_probe_row_typed_v1("a", "old")): return 1
    if not table.add_row(db_probe_row_typed_v1("b", "keep")): return 2
    db.set_table("records", table)
    if db_update_optional_typed_v1(db, "records", "a", "new") != Some(true): return 3
    if db_update_optional_typed_v1(db, "records", "missing", "bad") != Some(false): return 4
    if db_update_optional_typed_v1(db, "absent", "a", "bad") != nil: return 5
    if db_delete_optional_typed_v1(db, "records", "b") != Some(true): return 6
    if db_delete_optional_typed_v1(db, "records", "missing") != Some(false): return 7
    if db_delete_optional_typed_v1(db, "absent", "a") != nil: return 8
    # SdnTable is a class: the preexisting table alias must observe mutation.
    val alias_updated = table.get_row("a") ?? return 30
    val alias_deleted = table.get_row("b") ?? return 31
    if alias_updated.get("value") != Some("new"): return 32
    if alias_deleted.get("valid") != Some("false"): return 33
    if not db.save(): return 9
    val loaded = SdnDatabase.load(path) ?? return 10
    val persisted = loaded.get_table("records") ?? return 11
    val updated = persisted.get_row("a") ?? return 12
    val deleted = persisted.get_row("b") ?? return 13
    if updated.get("value") != Some("new"): return 14
    if updated.get("valid") != Some("true"): return 15
    if deleted.get("value") != Some("keep"): return 16
    if deleted.get("valid") != Some("false"): return 17
    if persisted.rows.len() != 2: return 18
    0

fn main() -> i32:
    val directory = secure_temp_dir("/tmp", "simple-db-typed-input-").unwrap()
    val path = directory + "/records.sdn"
    val status = db_optional_mutation_probe_typed_v1(path)
    val removed = file_delete(path)
    if status != 0: return status as i32
    if not removed: return 29
    0
