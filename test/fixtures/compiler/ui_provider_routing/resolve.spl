# Actual resolver regression: no synthetic provider declarations.
use compiler.driver.driver_source_loading.{_driver_resolve_source_root_entry_import_v1}
use app.io.mod.{cwd}
use compiler.common.source_root_resolution.{SourceRootResolutionV1}

fn resolved(module_name: text, roots: [text]) -> text:
    match _driver_resolve_source_root_entry_import_v1(module_name, roots):
        case SourceRootResolutionV1.Found(path): path
        case SourceRootResolutionV1.Missing: "MISSING"
        case SourceRootResolutionV1.Ambiguous(reason): "AMBIGUOUS:" + reason

fn main() -> i64:
    val modules = ["render.ansi", "render.types", "render.html_widgets", "browser.app", "tui.app", "electron.app_launcher", "test_api.json"]
    val paths = ["render/ansi", "render/types", "render/html_widgets", "browser/app", "tui/app", "electron/app_launcher", "test_api/json"]
    val absolute_root = cwd().replace("\\", "/")
    var index = 0
    while index < modules.len():
        val name = "app.ui." + modules[index]
        val expected = "src/app/ui." + paths[index] + ".spl"
        if resolved(name, ["src/app"]) != expected: return 10 + index
        if resolved(name, ["src"]) != expected: return 20 + index
        if resolved(name, ["src/app/"]) != expected: return 30 + index
        if resolved(name, [absolute_root + "/src/app"]) != absolute_root + "/" + expected: return 50 + index
        if resolved(name, [absolute_root + "/src"]) != absolute_root + "/" + expected: return 60 + index
        if resolved(name, ["src/compiler", "src/lib"]) != "MISSING": return 70 + index
        if resolved(name, [absolute_root + "/src/compiler", absolute_root + "/src/lib"]) != "MISSING": return 80 + index
        index = index + 1
    if resolved("app.ui.render.ansi", []) != "MISSING": return 40
    if resolved(".ui.render.ansi", ["src/app"]) != "MISSING": return 41
    print "UI_PROVIDER_SOURCE_ROOT_PASS"
    0
