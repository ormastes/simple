# Actual provider HIR + behavior regression. Authored, UNRUN.
# Compile with declared src/compiler, src/app, src/lib source roots.
use app.ui.render.ansi.{ansi_bold, ansi_reset, ansi_cyan}
use app.ui.render.types.{RenderConfig, RenderResult}
use app.ui.render.html_widgets.{render_html_tree}
use app.ui.browser.app.{BrowserApp, run_browser_gui}
use app.ui.tui.app.{run_tui}
use app.ui.electron.app_launcher.{electron_app_launch_args}
use app.ui.test_api.json.{extract_json_field}

# Retain real UI callable/type imports through HIR without opening windows.
fn tui_provider(file_path: text) -> i64:
    run_tui(file_path)

fn browser_provider(file_path: text) -> i64:
    run_browser_gui(file_path, 3000)

fn main() -> i64:
    if ansi_bold() != "\u{001b}[1m": return 1
    if ansi_reset() != "\u{001b}[0m": return 2
    if ansi_cyan() != "\u{001b}[36m": return 3
    val config = RenderConfig.default()
    if config.width != 80 or config.height != 24: return 4
    val result = RenderResult.empty()
    if result.text_output != "": return 5
    if extract_json_field("{\"name\":\"provider\"}", "name") != "provider": return 6
    val args = electron_app_launch_args("fixture/electron", "http://localhost:3000", "9222")
    if args.len() != 5: return 7
    if args[1] != "--remote-debugging-port=9222": return 8
    if args[2] != "fixture/electron": return 9
    print "UI_PROVIDER_ROUTING_PASS"
    0
