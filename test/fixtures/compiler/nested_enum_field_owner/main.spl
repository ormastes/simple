use .left.{left_records, left_grid, left_envelope}
use .right.{right_records}

fn main() -> i64:
    val left = left_records()
    val right = right_records()
    var i = 0
    if left[i].category.name() != "left-ready": return 1
    if right[i].category.name() != "right-ready": return 2
    # Same enum basename, variant, ordinal and method must not capture
    # the foreign provider's implementation.
    if left[i].category.name() == right[i].category.name(): return 3
    i = 1
    if left[i].category.name() != "left-closed": return 4
    if right[i].category.name() != "right-closed": return 5
    val grid = left_grid()
    if grid[0][i].category.name() != "left-closed": return 6
    val envelope = left_envelope()
    if envelope.record.category.name() != "left-closed": return 7
    print "NESTED_ENUM_FIELD_OWNER_PASS"
    0
