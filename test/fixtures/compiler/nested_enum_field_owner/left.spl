pub enum Category:
    Ready
    Closed

impl Category:
    fn name() -> text:
        match self:
            Category.Ready: "left-ready"
            Category.Closed: "left-closed"

pub struct LeftRecord:
    category: Category

pub struct LeftEnvelope:
    record: LeftRecord

pub fn left_records() -> [LeftRecord]:
    [LeftRecord(category: Category.Ready), LeftRecord(category: Category.Closed)]

pub fn left_grid() -> [[LeftRecord]]:
    [left_records()]

pub fn left_envelope() -> LeftEnvelope:
    LeftEnvelope(record: LeftRecord(category: Category.Closed))
