enum LocalCategory:
    Ready
    Closed

impl LocalCategory:
    fn name() -> text:
        match self:
            LocalCategory.Ready: "layout-ready"
            LocalCategory.Closed: "layout-closed"

struct LayoutRow:
    marker: i64
    category: LocalCategory

fn nested_rows() -> [[LayoutRow]]:
    [[LayoutRow(marker: 41, category: LocalCategory.Ready),
      LayoutRow(marker: 73, category: LocalCategory.Closed)]]

fn indexed_name(rows: [[LayoutRow]], index: i64) -> text:
    rows[0][index].category.name()

fn main() -> i64:
    val rows = nested_rows()
    var index = 0
    if rows[0][index].marker != 41: return 1
    if rows[0][index].category.name() != "layout-ready": return 2
    if indexed_name(rows, index) != "layout-ready": return 3
    index = 1
    if rows[0][index].marker != 73: return 4
    if rows[0][index].category.name() != "layout-closed": return 5
    if indexed_name(rows, index) != "layout-closed": return 6
    print "INDEXED_STRUCT_LAYOUT_PASS"
    0
