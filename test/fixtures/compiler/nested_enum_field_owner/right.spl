pub enum Category:
    Ready
    Closed

impl Category:
    fn name() -> text:
        match self:
            Category.Ready: "right-ready"
            Category.Closed: "right-closed"

pub struct RightRecord:
    category: Category

pub fn right_records() -> [RightRecord]:
    [RightRecord(category: Category.Ready), RightRecord(category: Category.Closed)]
