struct Record:
    value: i64

impl Record:
    fn __eq__(other: Record) -> bool:
        self.value == other.value

fn absent(value: Record) -> bool:
    value == nil

fn absent_reverse(value: Record) -> bool:
    nil == value

fn present(value: Record) -> bool:
    value != nil

fn present_reverse(value: Record) -> bool:
    nil != value

fn optional_absent(value: Record?) -> bool:
    value == nil

fn scalar_absent(value: i64) -> bool:
    value == nil

fn main() -> i64:
    val value = Record(value: 3)
    if absent(value) or absent_reverse(value): return 11
    if not present(value) or not present_reverse(value): return 12
    if not absent(nil) or not absent_reverse(nil): return 13
    if present(nil) or present_reverse(nil): return 14
    if not optional_absent(nil): return 15
    if optional_absent(Some(value)): return 16
    if scalar_absent(3) or scalar_absent(0): return 17
    if not (value == Record(value: 3)): return 18
    if value == Record(value: 4): return 19
    0
