use std.nogc_async_mut.io.file.{FileThreadPool}
use std.async.poll.{Poll}
use compiler.hir.hir_codec.{hir_codec_header}

fn compute_value() -> i64:
    print "async-file-task-called"
    37

fn main() -> i64:
    val header = hir_codec_header()
    if not header.starts_with("spl-hircodec-"): return 4
    val pool = FileThreadPool.new(1)
    val result = pool.exec(compute_value)
    val state: Poll<i64> = result.poll()
    match state:
        case Poll.Ready(value):
            if value != 37: return 2
        case Poll.Pending:
            return 3
    print "async-file-future-ready-pass"
    0
