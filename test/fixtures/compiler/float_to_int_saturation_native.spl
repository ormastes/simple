fn main() -> i32:
    val maximum: i64 = 9223372036854775807
    val minimum: i64 = -9223372036854775807 - 1
    if (0.0).to_int() != 0: return 1
    if (-0.0).to_int() != 0: return 2
    if (1.9).to_int() != 1: return 3
    if (-1.9).to_int() != -1: return 4
    if (9223372036854775808.0).to_int() != maximum: return 5
    if (-9223372036854775808.0).to_int() != minimum: return 6
    if (9223372036854774784.0).to_int() != 9223372036854774784: return 7
    if (-9223372036854774784.0).to_int() != -9223372036854774784: return 8
    val huge: f64 = 1.0e308
    val infinity = huge * huge
    if infinity.to_int() != maximum: return 9
    if (0.0 - infinity).to_i64() != minimum: return 10
    val nan = infinity - infinity
    if nan.to_int() != 0: return 11
    val narrow: f32 = -1.9f32
    if narrow.to_i64() != -1: return 12
    print "float builtin saturation: 12 checks passed"
    0
