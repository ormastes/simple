"""Focused optimizer constant payload diagnostic; not whole-compiler proof."""

use compiler.mir_opt._OptimizationPasses.engine.{OptimizationEngine, OptimizationLevel}
use compiler.mir.mir_types.{LocalId, MirConstValue, MirType, MirTypeKind}
use compiler.mir.mir_instruction_support.{MirOperand, MirOperandKind, MirBinOp, MirUnaryOp}
use compiler.mir.mir_instruction_graph.{MirInst}
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use std.nogc_sync_mut.io_runtime.{exit}

fn optimizer_payload_guard(condition: bool, message: text):
    if not condition:
        print "FAIL: {message}"
        exit(1)

fn check_integer(inst: MirInst?, destination: i64, expected: i64):
    if val value = inst:
        match value.kind:
            case MirInstKind.Const(dest, constant, type_):
                val concrete_type: MirType = type_
                optimizer_payload_guard(dest.id == destination, "constant destination changed")
                optimizer_payload_guard(concrete_type.kind == MirTypeKind.I32, "constant width changed")
                match constant:
                    case MirConstValue.Int(payload):
                        optimizer_payload_guard(payload == expected, "integer payload changed")
                    case _:
                        optimizer_payload_guard(false, "integer constant kind changed")
            case _:
                optimizer_payload_guard(false, "constant instruction missing")
    else:
        optimizer_payload_guard(false, "optimizer returned no instruction")

fn main() -> i64:
    var engine = OptimizationEngine.create(OptimizationLevel.Basic)
    val dest = LocalId(id: 9)
    val narrow = MirType(kind: MirTypeKind.I32)
    engine.type_map[dest.id] = narrow
    val two = MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(2), narrow))
    val three = MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(3), narrow))
    val zero = MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(0), narrow))
    val unknown = MirOperand(kind: MirOperandKind.Copy(LocalId(id: 71)))
    check_integer(engine.optimize_binop(dest, MirBinOp.Add, two, three, nil), 9, 5)
    check_integer(engine.optimize_binop(dest, MirBinOp.Mul, unknown, zero, nil), 9, 0)
    check_integer(engine.optimize_binop(dest, MirBinOp.Mul, zero, unknown, nil), 9, 0)
    check_integer(engine.optimize_binop(dest, MirBinOp.BitAnd, unknown, zero, nil), 9, 0)
    check_integer(engine.optimize_unaryop(dest, MirUnaryOp.Neg, three, nil), 9, -3)
    optimizer_payload_guard(engine.stats.constants_folded == 2, "fold counter changed")
    optimizer_payload_guard(engine.stats.zero_eliminations == 3, "zero counter changed")
    print "nogc-optimizer-payload: five constant paths retained integer value and I32 width"
    0
