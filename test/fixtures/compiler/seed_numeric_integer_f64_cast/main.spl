# Reproduces the integer -> f64 operation that the seed used to lower as a
# representation bitcast while constructing the self-hosted float parser.
enum FloatCarrier:
    Float(f64)

fn decimal_digits(source: text) -> f64:
    var result: f64 = 0.0
    var index = 0
    while index < source.len():
        val digit = source[index].ord() - 48
        result = result * 10.0 + digit as f64
        index = index + 1
    result

fn main() -> i64:
    assert(decimal_digits("25") == 25.0)
    assert(decimal_digits("100") == 100.0)
    val negative: i64 = -25
    val unsigned: u64 = 100
    assert(negative as f64 == -25.0)
    assert(unsigned as f64 == 100.0)
    val carried = FloatCarrier.Float(decimal_digits("25"))
    match carried:
        case FloatCarrier.Float(value):
            assert(value == 25.0)
    print "SEED_NUMERIC_INTEGER_F64_CAST_PASS"
    0
