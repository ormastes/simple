# Native regression: real event factory return feeds the real transient generic.
# The same unannotated binding failed on receiver 9ee03151 with E-MONO-032/033.
use std.scv.compile_source_inventory_core.{CompileSourceEventV1, compile_source_inventory_git_event_v1}
use compiler.mir._MirLowering.transient_owner_sffi.{
    transient_array_scope_begin_v1, transient_array_scope_pause_v1,
    transient_array_scope_end_v1, transient_heap_promote_v1}

fn main() -> i64:
    if not transient_array_scope_begin_v1(): return 1
    val event = compile_source_inventory_git_event_v1(
        "modify", "src/main.spl", "fn original_source() -> i64:\n    7\n")
    if not transient_array_scope_pause_v1():
        transient_array_scope_end_v1()
        return 2
    val retained = transient_heap_promote_v1(event)
    val ended = transient_array_scope_end_v1()
    if not retained or not ended: return 3
    if event.source_identity != "src/main.spl": return 4
    0
