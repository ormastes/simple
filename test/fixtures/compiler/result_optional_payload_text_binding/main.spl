# Native regression for bug native_enum_nil_payload_pattern_2026_10_11 (#2981):
# a binder nested in a builtin wrapper (`Ok(Some(chunk))` over
# `Result<text?, text>`) must be bound as TEXT. Stage3 43 bound the raw payload
# word: `chunk.len()` worked but "{chunk}" printed an integer handle and
# `output + chunk` was not a text concatenation.
fn ok_some(result: Result<text?, text>) -> text:
    match result:
        Ok(Some(chunk)): "[{chunk}]"
        Ok(nil): "nil"
        Err(problem): "err:{problem}"

fn ok_some_concat(result: Result<text?, text>, output: text) -> text:
    match result:
        Ok(Some(chunk)): output + chunk
        Ok(nil): output
        Err(_): "err"

# Similar pattern: the Err slot carries the optional text.
fn err_some(result: Result<i64, text?>) -> text:
    match result:
        Ok(n): "ok"
        Err(Some(why)): "why={why}"
        Err(_): "why=nil"

# Similar pattern: Option of Option of text.
fn some_some(v: text??) -> text:
    match v:
        Some(Some(t)): "t={t}"
        _: "nil"

# Similar pattern: Result nested in Result.
fn ok_ok(r: Result<Result<text, i64>, i64>) -> text:
    match r:
        Ok(Ok(t)): "okok={t}"
        Ok(Err(c)): "okerr"
        Err(_): "err"

fn main() -> i64:
    print "hello canary"
    if ok_some(Ok(Some("bc"))) != "[bc]": return 1
    if ok_some(Ok(nil)) != "nil": return 2
    if ok_some(Err("e")) != "err:e": return 3
    if ok_some_concat(Ok(Some("bc")), "a") != "abc": return 4
    if ok_some_concat(Ok(nil), "a") != "a": return 5
    if err_some(Err(Some("x"))) != "why=x": return 6
    if err_some(Err(nil)) != "why=nil": return 7
    if ok_ok(Ok(Ok("q"))) != "okok=q": return 8
    if ok_ok(Ok(Err(3))) != "okerr": return 9
    print "result_optional_payload_text_binding: PASS"
    0
