use app.mcp.main_ctx_score_conversion.{ctx_score_milli}

fn main() -> i32:
    if ctx_score_milli(0.0) != 0: return 11
    if ctx_score_milli(1.2349) != 1234: return 12
    if ctx_score_milli(-1.2349) != -1234: return 13
    if ctx_score_milli(0.0009) != 0: return 14
    if ctx_score_milli(-0.0009) != 0: return 15
    if ctx_score_milli(2.5) != 2500: return 16
    val maximum: i64 = 9223372036854775807
    val minimum: i64 = -9223372036854775807 - 1
    if ctx_score_milli(1.0e300) != maximum: return 17
    if ctx_score_milli(-1.0e300) != minimum: return 18
    val huge: f64 = 1.0e308
    val positive_infinity: f64 = huge * huge
    val negative_infinity: f64 = 0.0 - positive_infinity
    if ctx_score_milli(positive_infinity) != maximum: return 19
    if ctx_score_milli(negative_infinity) != minimum: return 20
    val nan_value: f64 = positive_infinity - positive_infinity
    if ctx_score_milli(nan_value) != 0: return 21
    val negative_zero: f64 = 0.0 / negative_infinity
    if ctx_score_milli(negative_zero) != 0: return 22
    print "MCP score conversion: 12 checks passed"
    0
