class Batch:
    prefix: i64
    words: [text]

struct Descriptor:
    prefix: i64
    words: [text]

fn all_batches() -> [Batch]:
    [Batch(prefix: 11, words: ["one", "four"])]

fn all_descriptors() -> [Descriptor]:
    [Descriptor(prefix: 13, words: ["two", "five"])]

fn integers() -> [i64]:
    [2, 3]

struct Empty:
    pass

fn empty_records() -> [Empty]:
    [Empty()]
