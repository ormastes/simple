use .provider.{Descriptor, all_descriptors}

# A consumer-LOCAL array-returning function over the IMPORTED record, called
# inside lifted bodies. The element shape comes from this module's own prescan
# under the imported symbol's canonical owner, so the lifted lowering must fold
# it through struct_identity_layout_key onto the provider's registered layout.
# Native SSpec shape: `fn spec_schema() -> [ConfigFieldDescriptor]` used from
# `it` closures (run 16, config_core specs).
fn local_descriptors() -> [Descriptor]:
    all_descriptors()

fn invoke(callback: fn() -> i64) -> i64:
    callback()

fn main() -> i64:
    # The ordinary call is the control: it lowered before this repair too.
    if local_descriptors()[0].prefix != 13: return 1
    if invoke(\: local_descriptors()[0].prefix) != 13: return 2
    if invoke(\: local_descriptors()[0].words[1].len()) != 4: return 3
    print("LOCAL_LIFTED_ARRAY_RECORD_LAYOUT_PASS")
    0
