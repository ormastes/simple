use provider.{Batch as ProviderBatch, Descriptor as ProviderDescriptor, all_batches, all_descriptors, integers, Empty as ProviderEmpty, empty_records}

# Each provider's array element competes with a different consumer layout.
class Batch:
    words: i64

struct Descriptor:
    words: i64

fn main():
    assert(Batch(words: 9).words == 9)
    assert(Descriptor(words: 10).words == 10)
    var total = 0
    for batch in all_batches():
        assert(batch.prefix == 11)
        for word in batch.words:
            total = total + word.len()
    assert(total == 7)
    val stored = all_batches()
    for batch in stored:
        assert(batch.prefix == 11)
        assert(batch.words[1] == "four")
    val indexed_batch = stored[0]
    assert(indexed_batch.prefix == 11)
    assert(indexed_batch.words[1] == "four")
    var descriptor_total = 0
    for descriptor in all_descriptors():
        assert(descriptor.prefix == 13)
        for word in descriptor.words:
            descriptor_total = descriptor_total + word.len()
    assert(descriptor_total == 7)
    val descriptor = all_descriptors()[0]
    assert(descriptor.prefix == 13)
    assert(descriptor.words[0] == "two")
    var sum = 0
    for integer in integers():
        sum = sum + integer
    assert(sum == 5)
    var empty_count = 0
    for empty in empty_records():
        empty_count = empty_count + 1
    assert(empty_count == 1)
    print("array return provider record assertions passed")
