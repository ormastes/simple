use .provider.{Descriptor as ProviderDescriptor, all_descriptors}

struct Descriptor:
    words: i64

fn invoke(callback: fn() -> i64) -> i64:
    callback()

fn nested() -> fn() -> i64:
    \:
        invoke(\: all_descriptors()[0].prefix)

fn main() -> i64:
    # The ordinary call materializes the provider before lifting begins.
    if all_descriptors()[0].prefix != 13: return 1
    if invoke(\: all_descriptors()[0].prefix) != 13: return 2
    val callback = nested()
    if callback() != 13: return 3
    if invoke(\: all_descriptors()[0].words[1].len()) != 4: return 4
    print("LIFTED_ARRAY_RECORD_LAYOUT_PASS")
    0
