use .provider.{Descriptor as ProviderDescriptor, all_descriptors}

struct Descriptor:
    words: i64

fn main() -> i64:
    val descriptor = all_descriptors()[0]
    if descriptor.prefix != 13: return 1
    if descriptor.words[1] != "five": return 2
    print("PLAIN_ARRAY_RECORD_LAYOUT_PASS")
    0
