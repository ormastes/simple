class SearchOwner:
    value: i64

    fn index_of(needle: text) -> i64:
        self.value

fn tail(source: text) -> text:
    source[1:source.len()]

fn main() -> i64:
    if "a,b".index_of(",") != 1: return 1
    val body = tail("xabcabc")
    if body.index_of("bc") != 1: return 2
    if body.index_of("missing") != -1: return 3
    if body.index_of("") != 0: return 4
    if body.index_of("bc", 2) != 4: return 5
    val owner = SearchOwner(value: 17)
    if owner.index_of("bc") != 17: return 6
    0
