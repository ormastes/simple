# Runtime-array metadata must survive an inferred binding and its alias.
struct CustomBytes:
    value: i64

impl CustomBytes:
    fn bytes() -> i64:
        self.value

fn main() -> i64:
    val empty = "".bytes()
    if empty.len() != 0: return 1
    val ascii = "HTTP\r\n".bytes()
    if ascii.len() != 6: return 2
    if ascii[0] != 72u8 or ascii[5] != 10u8: return 3
    val alias = ascii
    if alias.len() != 6 or alias[3] != 80u8: return 4
    val unicode_bytes = "é한😀".bytes()
    val expected: [u8] = [195u8, 169u8, 237u8, 149u8, 156u8, 240u8, 159u8, 152u8, 128u8]
    if unicode_bytes.len() != expected.len(): return 5
    var index = 0
    while index < expected.len():
        if unicode_bytes[index] != expected[index]: return 6
        index = index + 1
    val zero = "a\0b".bytes()
    if zero.len() != 3: return 7
    if zero[0] != 97u8 or zero[1] != 0u8 or zero[2] != 98u8: return 8
    var total: i64 = 0
    for byte in ascii:
        total = total + (byte as i64)
    if total != 343: return 9
    if "ok".bytes().len() != 2: return 10
    val custom = CustomBytes(value: 37)
    if custom.bytes() != 37: return 11
    print "text_bytes_result_metadata=pass"
    0
