# Distinct records can be equal under their user's equality relation.
struct ModuloRecord:
    value: i64

impl ModuloRecord:
    fn __eq__(other: ModuloRecord) -> bool:
        self.value % 10 == other.value % 10

fn same(a: ModuloRecord, b: ModuloRecord) -> bool:
    a == b

fn different(a: ModuloRecord, b: ModuloRecord) -> bool:
    a != b

fn main() -> i64:
    val left = ModuloRecord(value: 1)
    val equal = ModuloRecord(value: 11)
    val unequal = ModuloRecord(value: 2)
    if not same(left, equal): return 10
    if different(left, equal): return 11
    if same(left, unequal): return 12
    if not different(left, unequal): return 13
    print "STRUCT_INEQUALITY_NATIVE: PASS"
    0
