use std.io_runtime.{exit}
use compiler.hir.hir_types.{HirTypeKind, SymbolKind}

@unsafe(reason: "reads a concrete runtime enum discriminant for corrupt-carrier diagnostics", capabilities: [ffi])
extern fn rt_enum_discriminant<T>(value: T) -> i64

fn hir_kind_discriminant(value: HirTypeKind) -> i64:
    unsafe(capabilities: [ffi]):
        rt_enum_discriminant(value)

fn symbol_kind_discriminant(value: SymbolKind) -> i64:
    unsafe(capabilities: [ffi]):
        rt_enum_discriminant(value)

fn check_enum_carrier(condition: bool, message: text):
    if not condition:
        print "FAIL: {message}"
        exit(1)

fn main() -> i64:
    val raw_hir_kind: HirTypeKind = 0
    val nil_hir_kind: HirTypeKind = nil
    val first_hir_kind = HirTypeKind.Int(8, false)
    val other_hir_kind = HirTypeKind.Unit
    check_enum_carrier(hir_kind_discriminant(raw_hir_kind) < 0, "raw zero HirTypeKind carrier is absent")
    check_enum_carrier(hir_kind_discriminant(nil_hir_kind) < 0, "nil HirTypeKind carrier is absent")
    check_enum_carrier(hir_kind_discriminant(first_hir_kind) == 0, "first HirTypeKind variant keeps ordinal zero")
    check_enum_carrier(hir_kind_discriminant(other_hir_kind) >= 0, "other HirTypeKind variant is valid")

    val raw_symbol_kind: SymbolKind = 0
    val nil_symbol_kind: SymbolKind = nil
    val first_symbol_kind = SymbolKind.Function
    val other_symbol_kind = SymbolKind.Method
    check_enum_carrier(symbol_kind_discriminant(raw_symbol_kind) < 0, "raw zero SymbolKind carrier is absent")
    check_enum_carrier(symbol_kind_discriminant(nil_symbol_kind) < 0, "nil SymbolKind carrier is absent")
    check_enum_carrier(symbol_kind_discriminant(first_symbol_kind) == 0, "first SymbolKind variant keeps ordinal zero")
    check_enum_carrier(symbol_kind_discriminant(other_symbol_kind) >= 0, "other SymbolKind variant is valid")

    print "enum carrier guard: raw-zero and nil are absent; valid ordinal-zero variants survive"
    0
