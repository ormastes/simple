val PRIVATE_TEXT: text = "inline"
pub val PUBLIC_TEXT: text = "exported"
var EMPTY_TEXT: text = ""
var MUTABLE_TEXT = "initial"
val DEPENDENT_TEXT: text = PUBLIC_TEXT + "/tail"

fn replace_text():
    EMPTY_TEXT = "filled"
    MUTABLE_TEXT = "changed"

fn main() -> i64:
    if PRIVATE_TEXT != "inline": return 1
    if PUBLIC_TEXT != "exported": return 2
    if EMPTY_TEXT != "": return 3
    if MUTABLE_TEXT != "initial": return 4
    if DEPENDENT_TEXT != "exported/tail": return 5
    replace_text()
    if EMPTY_TEXT != "filled": return 6
    if MUTABLE_TEXT != "changed": return 7
    if PUBLIC_TEXT != "exported": return 8
    0
