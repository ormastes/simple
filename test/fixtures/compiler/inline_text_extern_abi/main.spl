# Authored native ABI regression, not executed or root-cause proof.
# Exercise the imported env_get name that the LLVM alias path handles;
# cross-module body inlining is neither required nor asserted.
# Runner prerequisite:
# SIMPLE_INLINE_TEXT_EXTERN_ABI_PROBE=inline-abi-known-value-173
use test.fixtures.compiler.inline_text_extern_abi.provider.{
    env_get, control_environment_value
}

fn main() -> i64:
    val control = control_environment_value("SIMPLE_INLINE_TEXT_EXTERN_ABI_PROBE")
    if val control_value = control:
        if control_value != "inline-abi-known-value-173": return 1
    else:
        return 2
    val aliased = env_get("SIMPLE_INLINE_TEXT_EXTERN_ABI_PROBE")
    if val alias_value = aliased:
        if alias_value != "inline-abi-known-value-173": return 3
    else:
        return 4
    # A second value-bearing call catches stale argument/register dependence.
    val key = "SIMPLE_INLINE_TEXT_EXTERN_ABI_PROBE"
    val repeated = env_get(key)
    if val repeated_value = repeated:
        if repeated_value != "inline-abi-known-value-173": return 5
    else:
        return 6
    print "PASS imported env_get text extern ABI checks=3"
    0
