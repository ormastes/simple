# Authored native ABI regression; unexecuted and not proof of the root cause.
# The historical directory name is retained. The defective LLVM path was the
# bare imported env_get alias, not cross-module body inlining.
@unsafe(reason: "native text extern ABI regression", capabilities: [ffi])
extern fn rt_env_get(key: text) -> text?

@always_inline
fn env_get(key: text) -> text?:
    unsafe(capabilities: [ffi]):
        rt_env_get(key)

# Distinct control: its imported name does not hit the env_get
# alias. The provider owns the ordinary rt_env_get text-to-(ptr,len) boundary.
fn control_environment_value(key: text) -> text?:
    unsafe(capabilities: [ffi]):
        rt_env_get(key)
