use app.mcp.assistant.session_store_helpers.{
    ASSISTANT_STORE_ROOT, ASSISTANT_STORE_SESSIONS, ASSISTANT_STORE_TIMELINES,
    ASSISTANT_STORE_NOTIFICATIONS, ASSISTANT_STORE_DIGESTS,
    assistant_store_sessions_dir, assistant_store_timelines_dir
}

fn main() -> i64:
    if ASSISTANT_STORE_ROOT != ".build/llm_dashboard/assistant": return 1
    if ASSISTANT_STORE_SESSIONS != ASSISTANT_STORE_ROOT + "/sessions": return 2
    if ASSISTANT_STORE_TIMELINES != ASSISTANT_STORE_ROOT + "/timelines": return 3
    if ASSISTANT_STORE_NOTIFICATIONS != ASSISTANT_STORE_ROOT + "/notifications": return 4
    if ASSISTANT_STORE_DIGESTS != ASSISTANT_STORE_ROOT + "/digests": return 5
    if assistant_store_sessions_dir("") != ASSISTANT_STORE_SESSIONS: return 6
    if assistant_store_timelines_dir(" ") != ASSISTANT_STORE_TIMELINES: return 7
    if assistant_store_sessions_dir("custom root") != "custom root/sessions": return 8
    print "assistant store public paths: 8 checks, 0 failures"
    0
