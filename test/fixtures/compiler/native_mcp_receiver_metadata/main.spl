# Expected stdout: 7, beta, 2, 2, 7 (one per line).
use provider.{Batch, make_batch, all_batches}

struct Descriptor:
    name: text
    count: i64

class CustomNumber:
    value: i64
    fn to_int() -> i64: self.value + 1

fn main():
    # Braced literals must share declaration order with named constructors.
    val descriptor = Descriptor { count: 7, name: "alpha" }
    assert(descriptor.name == "alpha")
    print(descriptor.count)
    var words: [text] = ["alpha"]
    words.extend(["beta"])
    assert(words.len() == 2)
    print(words[1])
    assert((2.75).to_int() == 2)
    assert((-2.75).to_int() == -2)
    assert(CustomNumber(value: 6).to_int() == 7)
    print((2.75).to_int())
    var direct_count = 0
    match make_batch():
        case Some(batch):
            for word in batch.words:
                assert(word.len() > 0)
                direct_count = direct_count + 1
        case nil:
            assert(false)
    print(direct_count)
    val optional_words: [text]? = Some(["kept"])
    match optional_words:
        case Some(retained):
            for word in retained:
                assert(word == "kept")
        case nil:
            assert(false)
    var total = 0
    for batch in all_batches():
        for word in batch.words:
            total = total + word.len()
    print(total)
