use compiler.hir.hir_types.{SymbolTable, SymbolId, SymbolKind, HirType, HirTypeKind, Effect}
use compiler.frontend.parser_types_expr.{Type, TypeKind}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}

# Keep both unrelated Function variants in this real symbol-table closure.
fn parser_function_arity(kind: TypeKind) -> i64:
    match kind:
        case TypeKind.Function(params, _): params.len()
        case _: -1

fn hir_function_arity(kind: HirTypeKind) -> i64:
    match kind:
        case HirTypeKind.Function(params, _, _): params.len()
        case _: -1

fn main() -> i64:
    val span = Span.empty()
    val no_type_args: [Type] = []
    val parser_int = Type(kind: TypeKind.Named("i64", no_type_args), span: span)
    val parser_params: [Type] = [parser_int]
    val parser_callable = TypeKind.Function(parser_params, parser_int)
    if parser_function_arity(parser_callable) != 1: return 11
    if parser_function_arity(TypeKind.Error) != -1: return 12
    val hir_int = HirType(kind: HirTypeKind.Int(64, true), span: span)
    val hir_params: [HirType] = [hir_int]
    val effects: [Effect] = []
    val callable_kind = HirTypeKind.Function(hir_params, hir_int, effects)
    if hir_function_arity(callable_kind) != 1: return 13
    if hir_function_arity(HirTypeKind.Bool) != -1: return 14
    val callable_type = HirType(kind: callable_kind, span: span)
    var symbols = SymbolTable.new()
    val function_id = symbols.define("callable", SymbolKind.Function, Some(callable_type), span, Visibility.Public, false, nil)
    val untyped_function_id = symbols.define("untyped_callable", SymbolKind.Function, nil, span, Visibility.Public, false, nil)
    # Names and callable types cannot turn a non-Function symbol into a function.
    val variable_id = symbols.define("Function", SymbolKind.Variable, Some(callable_type), span, Visibility.Private, false, nil)
    val method_id = symbols.define("method", SymbolKind.Method, Some(callable_type), span, Visibility.Public, false, nil)
    val alias_id = symbols.define("alias", SymbolKind.TypeAlias, Some(callable_type), span, Visibility.Public, false, nil)
    if not symbols.is_function(function_id): return 21
    if not symbols.is_function(untyped_function_id): return 22
    if symbols.is_function(variable_id): return 23
    if symbols.is_function(method_id): return 24
    if symbols.is_function(alias_id): return 25
    if symbols.is_function(SymbolId(id: -1)): return 26
    if symbols.is_function(SymbolId(id: 1000000)): return 27
    print "layout-symbol-function-owner: pass"
    0
