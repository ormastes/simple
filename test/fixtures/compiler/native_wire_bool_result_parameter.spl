use std.nogc_sync_mut.sffi.enum_wire.{enum_wire_nil_slot}

enum OtherBoolVerdict:
    Ok(bool)
    Err(text)

enum BoolWireNode:
    Flag(bool)

struct BoolSlotState:
    valid: bool
    is_nil: bool
    detail: text

fn decode_bool_result(slot: Result<bool, text>) -> BoolSlotState:
    match slot:
        case Ok(is_nil):
            BoolSlotState(valid: true, is_nil: is_nil, detail: "")
        case Err(detail): BoolSlotState(valid: false, is_nil: false, detail: detail)

fn check_wire_bool<T>(node: T, arity: i64, index: i64, expected_valid: bool, expected_nil: bool, expected_detail: text) -> i64:
    unsafe(capabilities: [ffi]):
        val slot: BoolSlotState = decode_bool_result(enum_wire_nil_slot<T>(node, arity, index))
        print "slot valid={slot.valid} nil={slot.is_nil} error={slot.detail}"
        if slot.valid != expected_valid or slot.is_nil != expected_nil or slot.detail != expected_detail: return 1
    0

fn known_nil_slot() -> Result<bool, text>:
    Ok(true)

fn main() -> i64:
    var failures = 0
    val known: BoolSlotState = decode_bool_result(known_nil_slot())
    print "known valid={known.valid} nil={known.is_nil} error={known.detail}"
    if not known.valid or not known.is_nil or known.detail != "": failures = failures + 1
    failures = failures + check_wire_bool<BoolWireNode>(BoolWireNode.Flag(false), 1, 0, true, false, "")
    failures = failures + check_wire_bool<BoolWireNode>(BoolWireNode.Flag(true), 1, 1, false, false, "enum wire slot out of range")
    if failures == 0: print "wire-bool-result-parameter: PASS"
    failures
