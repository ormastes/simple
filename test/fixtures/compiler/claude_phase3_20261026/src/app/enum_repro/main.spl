# Repro module C: constructs and matches module B's enum with module A's payloads.
use app.enum_repro.types.{Point, Label}
use app.enum_repro.shapes.{Shape, shape_weight}
use app.enum_repro.kinds.{ConstValue, NodeKind, Node}
use app.enum_repro.frames.{Frame, FrameSink, expand_reverse, frame_weight}

fn make_dot(p: Point) -> Shape:
    Shape.Dot(p)

fn make_tagged(p: Point, l: Label) -> Shape:
    Shape.Tagged(p, l)

fn make_many(ps: [Point]) -> Shape:
    Shape.Many(ps)

fn make_const_frame(name: text) -> Frame:
    Frame.Const(ConstValue.Str(name), Point(x: 1, y: 1))

fn parse_num(s: text) -> Result<i64, text>:
    if s == "": return Err("empty")
    Ok(s.len())

fn describe(s: Shape) -> i64:
    match s:
        case Shape.Dot(p): p.x * 10
        case Shape.Tagged(p, l): p.x + l.name.len()
        case Shape.Many(ps): ps.len() * 100
        case Shape.Empty: -1

fn main():
    val p = Point(x: 1, y: 2)
    val l = Label(name: "ab")
    val total = describe(make_dot(p)) + describe(make_tagged(p, l)) + describe(make_many([p, p])) + shape_weight(Shape.Empty)
    val sink = FrameSink(frames: [])
    expand_reverse(Node(kind: NodeKind.Call(p, [p, p]), depth: 0), sink)
    expand_reverse(Node(kind: NodeKind.Text("hey", nil), depth: 1), sink)
    expand_reverse(Node(kind: NodeKind.Nothing, depth: 2), sink)
    sink.push_frame(make_const_frame("zz"))
    var fw = 0
    for f in sink.frames:
        fw = fw + frame_weight(f)
    match parse_num("xyz"):
        case Ok(n): print "{total + n} frames={sink.count()} fw={fw}"
        case Err(e): print e
