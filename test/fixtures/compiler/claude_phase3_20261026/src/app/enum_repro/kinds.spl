# Repro module D: an enum (payload-carrying) that other modules nest as payloads.
use app.enum_repro.types.{Point}

enum ConstValue:
    Str(value: text)
    Int(value: i64)
    At(where_: Point)

enum NodeKind:
    Leaf(value: i64)
    Call(callee: Point, args: [Point])
    Text(label: text, extras: [Point]?)
    Nothing

struct Node:
    kind: NodeKind
    depth: i64
