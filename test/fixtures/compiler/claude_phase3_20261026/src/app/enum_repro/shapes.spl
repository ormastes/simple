# Repro module B: an enum whose payloads are nominal types from module A.
use app.enum_repro.types.{Point, Label}

enum Shape:
    Dot(Point)
    Tagged(Point, Label)
    Many([Point])
    Empty

fn shape_weight(s: Shape) -> i64:
    match s:
        case Shape.Dot(p): p.x
        case Shape.Tagged(p, l): p.y + l.name.len()
        case Shape.Many(ps): ps.len()
        case Shape.Empty: 0
