enum Payload:
    Tuple(value: i64)
    Struct(value: i64)

enum OtherPayload:
    Tuple(value: text)
    Struct(value: text)

fn weight(payload: Payload?) -> i64:
    if val p = payload:
        match p:
            case Payload.Tuple(value): return value
            case Payload.Struct(value): return value + 1
    0

fn main():
    val direct: Payload? = Payload.Tuple(7)
    val wrapped: Payload? = Some(Payload.Struct(7))
    val absent: Payload? = nil
    print "{weight(direct)} {weight(wrapped)} {weight(absent)}"
