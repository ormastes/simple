enum Payload:
    Tuple(value: i64)
    Struct(value: i64)

enum OtherPayload:
    Tuple(value: text)
    Struct(value: text)

fn weight(payload: Payload?) -> i64:
    if payload == nil:
        return 0
    match payload:
        case Payload.Tuple(value): value
        case Payload.Struct(value): value + 1
        Some(p): weight(p)
        nil: 0

fn main():
    print "{weight(Payload.Tuple(7))}"
