use std.nogc_sync_mut.sffi.cpu.{cpuid}

# Windows x86-64 native regression: canonical CPU owner without unrelated
# privileged hardware or debugger imports from the broader host facade.
fn main() -> i64:
    val vendor = cpuid(0, 0)
    if vendor.0 <= 0: return 1
    if vendor.1 == 0 or vendor.2 == 0 or vendor.3 == 0: return 2
    val features = cpuid(1, 0)
    if (features.3 & (1 << 26)) == 0: return 3
    print "PASS Windows CPUID tuple ABI"
    0
