# The imported provider exposes the unresolved bare extern shape handled by LLVM.
use env_provider.{env_get}

fn main() -> i64:
    val value = env_get("SIMPLE_LLVM_ENV_OWNER_POSITIVE_20261107") ?? "missing"
    if value != "runtime-value":
        return 1
    print "env_get imported alias: runtime-value"
    0
