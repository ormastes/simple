"""Focused native ownership-CFG diagnostic; not general SPipe qualification."""

use compiler.borrow.borrow_check.ownership_flow.{OwnershipFlow, OwnershipEvent}
use compiler.borrow.borrow_check.borrow_graph.{place_local, place_field, place_index}


use std.nogc_sync_mut.io_runtime.{exit}

fn ownership_probe_guard(condition: bool, message: text):
    if not condition:
        print "FAIL: {message}"
        exit(1)

fn main() -> i64:
    val owner = place_local(0)
    val other = place_local(1)
    val child = place_field(owner, 0)
    val sibling = place_field(owner, 1)
    val grandchild = place_field(child, 0)
    ownership_probe_guard(owner.projections.len() == 0, "derived projection mutated the owner")
    ownership_probe_guard(child.projections.len() == 1, "grandchild projection mutated the child")
    ownership_probe_guard(sibling.projections.len() == 1, "sibling inherited another place's projections")
    ownership_probe_guard(grandchild.projections.len() == 2, "grandchild projection chain has wrong length")
    val diamond_points: Dict<i64, [i64]> = {0: [0], 1: [1], 2: [2], 3: [3]}
    val diamond_edges: Dict<i64, [i64]> = {0: [1, 2], 1: [3], 2: [3], 3: []}
    val loop_points: Dict<i64, [i64]> = {0: [0], 1: [1, 2], 2: [3]}
    val loop_edges: Dict<i64, [i64]> = {0: [1], 1: [1, 2], 2: []}

    var disjoint = OwnershipFlow.create()
    disjoint.record(1, OwnershipEvent.Move(owner))
    disjoint.record(2, OwnershipEvent.Move(owner))
    ownership_probe_guard(disjoint.check(0, diamond_points, diamond_edges).len() == 0, "sibling arms polluted each other")
    disjoint.record(3, OwnershipEvent.Read(owner))
    val joined = disjoint.check(0, diamond_points, diamond_edges)
    ownership_probe_guard(joined.len() == 1, "join lost a possible move")
    ownership_probe_guard(joined[0].point == 3, "join diagnosed a sibling instead of the join")

    var revived = OwnershipFlow.create()
    revived.record(0, OwnershipEvent.Move(owner))
    revived.record(1, OwnershipEvent.Revive(owner))
    revived.record(2, OwnershipEvent.Revive(owner))
    revived.record(3, OwnershipEvent.Read(owner))
    ownership_probe_guard(revived.check(0, diamond_points, diamond_edges).len() == 0, "all-arm revival did not kill a move")

    var missing = OwnershipFlow.create()
    missing.record(0, OwnershipEvent.Move(owner))
    missing.record(1, OwnershipEvent.Revive(owner))
    missing.record(3, OwnershipEvent.Read(owner))
    ownership_probe_guard(missing.check(0, diamond_points, diamond_edges).len() == 1, "one-arm revival unsafely revived the join")

    var repeated = OwnershipFlow.create()
    repeated.record(2, OwnershipEvent.Move(owner))
    val repeated_errors = repeated.check(0, loop_points, loop_edges)
    ownership_probe_guard(repeated_errors.len() == 1, "backedge failed to detect repeated move")
    ownership_probe_guard(repeated_errors[0].point == 2, "repeated move has wrong source point")

    var refill = OwnershipFlow.create()
    refill.record(1, OwnershipEvent.Revive(owner))
    refill.record(2, OwnershipEvent.Move(owner))
    ownership_probe_guard(refill.check(0, loop_points, loop_edges).len() == 0, "dominating refill rejected")

    val break_edges: Dict<i64, [i64]> = {0: [1], 1: [2], 2: []}
    ownership_probe_guard(repeated.check(0, loop_points, break_edges).len() == 0, "unconditional break treated as a backedge")
    repeated.record(3, OwnershipEvent.Read(owner))
    ownership_probe_guard(repeated.check(0, loop_points, break_edges).len() == 1, "break exit lost its moved state")

    # Branch 2 is a continue edge that bypasses branch 1's refill.
    val continue_edges: Dict<i64, [i64]> = {0: [3], 1: [3], 2: [3], 3: [1, 2]}
    var conditional_continue = OwnershipFlow.create()
    conditional_continue.record(1, OwnershipEvent.Revive(owner))
    conditional_continue.record(3, OwnershipEvent.Move(owner))
    ownership_probe_guard(conditional_continue.check(0, diamond_points, continue_edges).len() == 1, "continue bypassed required refill")

    val straight_points: Dict<i64, [i64]> = {0: [0, 1, 2, 3]}
    val no_edges: Dict<i64, [i64]> = {0: []}
    var projected = OwnershipFlow.create()
    projected.record(0, OwnershipEvent.Move(child))
    projected.record(1, OwnershipEvent.Read(sibling))
    projected.record(2, OwnershipEvent.Read(other))
    projected.record(3, OwnershipEvent.Read(owner))
    val partial_errors = projected.check(0, straight_points, no_edges)
    ownership_probe_guard(partial_errors.len() == 1, "partial move confused disjoint fields or local identities")
    ownership_probe_guard(partial_errors[0].point == 3, "whole use after partial move not diagnosed")

    var parent_write = OwnershipFlow.create()
    parent_write.record(0, OwnershipEvent.Move(grandchild))
    parent_write.record(1, OwnershipEvent.Revive(child))
    parent_write.record(2, OwnershipEvent.Read(owner))
    ownership_probe_guard(parent_write.check(0, straight_points, no_edges).len() == 0, "field write did not revive its descendants")

    var child_write = OwnershipFlow.create()
    child_write.record(0, OwnershipEvent.Move(owner))
    child_write.record(1, OwnershipEvent.Revive(child))
    child_write.record(2, OwnershipEvent.Read(owner))
    ownership_probe_guard(child_write.check(0, straight_points, no_edges).len() == 1, "child write resurrected whole owner")

    var symbolic_write = OwnershipFlow.create()
    val indexed = place_index(owner, 7)
    symbolic_write.record(0, OwnershipEvent.Move(indexed))
    symbolic_write.record(1, OwnershipEvent.Revive(indexed))
    symbolic_write.record(2, OwnershipEvent.Read(indexed))
    ownership_probe_guard(symbolic_write.check(0, straight_points, no_edges).len() == 1, "mutable index identity unsafely proved revival")

    var ordered = OwnershipFlow.create()
    ordered.record(0, OwnershipEvent.Move(owner))
    ordered.record(0, OwnershipEvent.Read(owner))
    ownership_probe_guard(ordered.check(0, straight_points, no_edges).len() == 1, "same-point event order lost")

    val unreachable_edges: Dict<i64, [i64]> = {0: [3], 1: [3], 2: [3], 3: []}
    ownership_probe_guard(disjoint.check(0, diamond_points, unreachable_edges).len() == 0, "unreachable move entered the join")
    ownership_probe_guard(disjoint.check(0, diamond_points, diamond_edges, 0).len() == 1, "budget exhaustion returned success")
    val malformed: Dict<i64, [i64]> = {0: [99]}
    ownership_probe_guard(disjoint.check(0, diamond_points, malformed).len() == 1, "missing successor returned success")
    ownership_probe_guard(disjoint.check(99, diamond_points, diamond_edges).len() == 1, "missing entry returned success")
    var unmapped = OwnershipFlow.create()
    unmapped.record(99, OwnershipEvent.Move(owner))
    ownership_probe_guard(unmapped.check(0, straight_points, no_edges).len() == 1, "unmapped event silently disappeared")
    val duplicate_points: Dict<i64, [i64]> = {0: [0], 1: [0]}
    var empty = OwnershipFlow.create()
    ownership_probe_guard(empty.check(0, duplicate_points, no_edges).len() == 1, "duplicate point identity returned success")
    var replay_budget = OwnershipFlow.create()
    replay_budget.record(0, OwnershipEvent.Read(owner))
    val tiny_points: Dict<i64, [i64]> = {0: [0]}
    val tiny_edges: Dict<i64, [i64]> = {}
    val exhausted_replay = replay_budget.check(0, tiny_points, tiny_edges, 8)
    ownership_probe_guard(exhausted_replay.len() == 1, "replay budget exhaustion returned success")
    ownership_probe_guard(exhausted_replay[0].message == "ownership CFG work budget exhausted during replay", "budget did not reach replay")
    ownership_probe_guard(replay_budget.check(0, tiny_points, tiny_edges, 9).len() == 0, "exact replay budget rejected valid control")
    val unreachable_bad_edges: Dict<i64, [i64]> = {0: [], 1: [99]}
    val unreachable_bad = empty.check(0, diamond_points, unreachable_bad_edges)
    ownership_probe_guard(unreachable_bad.len() == 1, "unreachable malformed target was ignored")
    ownership_probe_guard(unreachable_bad[0].message == "ownership CFG edge targets a missing block", "unreachable edge diagnostic changed")
    val missing_source_edges: Dict<i64, [i64]> = {99: []}
    ownership_probe_guard(empty.check(0, tiny_points, missing_source_edges).len() == 1, "missing edge source was ignored")
    # AC-OWN-04: physical block insertion order is not execution order.
    val reverse_points: Dict<i64, [i64]> = {3: [3], 2: [2], 1: [1], 0: [0]}
    val reverse_edges: Dict<i64, [i64]> = {3: [], 2: [3], 1: [3], 0: [2, 1]}
    var partial_join = OwnershipFlow.create()
    partial_join.record(1, OwnershipEvent.Move(child))
    partial_join.record(2, OwnershipEvent.Revive(child))
    partial_join.record(3, OwnershipEvent.Read(owner))
    val forward_join = partial_join.check(0, diamond_points, diamond_edges)
    val reverse_join = partial_join.check(0, reverse_points, reverse_edges)
    ownership_probe_guard(forward_join.len() == 1 and reverse_join.len() == 1, "block permutation changed partial-move join")
    ownership_probe_guard(forward_join[0].point == 3 and reverse_join[0].point == 3, "partial join has wrong diagnostic point")
    # A returning arm contributes no edge into the continuation.
    val returning_arm: Dict<i64, [i64]> = {0: [1, 2], 1: [], 2: [3], 3: []}
    ownership_probe_guard(partial_join.check(0, diamond_points, returning_arm).len() == 0, "early-return move polluted the continuation")
    # Separate body/refill blocks force a multi-block strongly connected loop.
    val cycle_points: Dict<i64, [i64]> = {30: [30], 20: [20], 10: [10], 0: [0]}
    val cycle_edges: Dict<i64, [i64]> = {0: [10], 10: [20], 20: [10, 30], 30: []}
    var partial_cycle = OwnershipFlow.create()
    partial_cycle.record(10, OwnershipEvent.Move(child))
    partial_cycle.record(20, OwnershipEvent.Revive(child))
    partial_cycle.record(30, OwnershipEvent.Read(owner))
    ownership_probe_guard(partial_cycle.check(0, cycle_points, cycle_edges).len() == 0, "multi-block loop lost definite partial refill")
    var wrong_refill = OwnershipFlow.create()
    wrong_refill.record(10, OwnershipEvent.Move(child))
    wrong_refill.record(20, OwnershipEvent.Revive(sibling))
    val repeated_partial = wrong_refill.check(0, cycle_points, cycle_edges)
    ownership_probe_guard(repeated_partial.len() == 1, "sibling refill concealed repeated partial move")
    ownership_probe_guard(repeated_partial[0].point == 10, "partial loop diagnostic moved off its source")
    print "nogc-ownership-flow: branch, backedge, revival, projection, ordering and fail-closed corpus passed"
    0
