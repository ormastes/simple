use std.nogc_sync_mut.sffi.host.{cpuid, cpu_is_x86_64}

fn main() -> i64:
    val vendor = cpuid(0, 0)
    if cpu_is_x86_64() == 1:
        if vendor.0 <= 0: return 1
        if vendor.1 == 0 or vendor.2 == 0 or vendor.3 == 0: return 2
        val features = cpuid(1, 0)
        if (features.3 & (1 << 26)) == 0: return 3
    else:
        if vendor.0 != 0 or vendor.1 != 0 or vendor.2 != 0 or vendor.3 != 0: return 4
    print "PASS CPUID tuple ABI"
    0
