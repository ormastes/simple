fn as_integer(value: text) -> i64:
    value as i64

fn as_float(value: text) -> f64:
    value as f64

fn main() -> i64:
    if as_integer("A") != 65: return 11
    if as_integer("é") != 233: return 12
    if as_integer("😀") != 128512: return 13
    if as_float("A") != 65.0: return 14
    if as_float("é") != 233.0: return 15
    # Source forms retain different meanings: code point versus numeric parse.
    if as_integer("7") != 55: return 16
    if i64("7") != 7: return 17
    if f64("7") != 7.0: return 18
    print "TEXT_CODEPOINT_CAST_PASS"
    0
