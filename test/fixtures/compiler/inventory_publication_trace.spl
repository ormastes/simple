use app.compiler_entrypoint.inventory_events.{compiler_inventory_refresh_v1}
use app.io.env_ops.{env_get}
fn main() -> i64:
    val root = env_get("INVENTORY_TRACE_FIXTURE_ROOT") ?? ""
    val mode = env_get("INVENTORY_TRACE_FIXTURE_MODE") ?? ""
    if root == "" or mode == "": return 10
    val roots = if mode == "cold": ["src", "test"] elif mode == "test": ["test"] else: ["src"]
    val result = compiler_inventory_refresh_v1(root, root + "/build/scv", roots, mode == "cold")
    print "REFRESH_RESULT valid={result.valid} reason={result.reason} digest={result.inventory_digest} generation={result.inventory_generation}"
    if not result.valid: return 11
    0
