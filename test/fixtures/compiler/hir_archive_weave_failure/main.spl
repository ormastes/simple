# Native controls use actual source/private producer/gate execution. No report
# or failure variant is fabricated. Required managed authority is unchanged.
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.cache.driver_hir_archive_weave_boundary_v1.*
use compiler.driver.cache.driver_hir_archive_weave_replay_v1.{driver_hir_archive_weave_replay_with_failure_v1}
use test.fixtures.compiler.hir_archive_weave_boundary.support.*
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_end}

fn unpublished(result: Result<DriverHirArchiveWeaveBoundaryV1, DriverHirArchiveWeaveFailureV1>) -> bool:
    match result:
        Ok(owner): false
        Err(failure):
            match failure:
                Unpublished(message): message != ""
                AlreadyPublished(message): false

fn main() -> i64:
    var checks = 0
    val empty = CompilerDriver.create(driver_core_compile_options_default())
    if not unpublished(driver_hir_archive_weave_boundary_capture_with_failure_v1(empty)) or
            empty.ctx.error_count_value != 0: return 10
    checks = checks + 1
    if not transient_scope_begin(): return 11
    val occupied = unpublished(driver_hir_archive_weave_boundary_capture_with_failure_v1(empty))
    val still_owned = transient_array_scope_state_v1() == 1
    val ended = transient_scope_end()
    if not occupied or not still_owned or not ended or empty.ctx.error_count_value != 0: return 12
    checks = checks + 1
    val prepared = hir_archive_weave_fixture_prepare_v1(
        "test/fixtures/compiler/hir_archive_weave_failure/provider.spl", "failure_provider", "failure_alias")
    if prepared.is_err():
        print prepared.unwrap_err()
        return 13
    val driver = prepared.unwrap().driver
    val silent = driver_hir_archive_weave_replay_with_failure_v1(driver, false)
    val silent_message = match silent:
        Ok(value): ""
        Err(failure):
            match failure:
                Unpublished(message): message
                AlreadyPublished(message): ""
    if not silent_message.contains("copies 24 bytes") or driver.ctx.error_count_value != 0: return 14
    checks = checks + 1
    val actual = driver_hir_archive_weave_boundary_capture_with_failure_v1(driver)
    val published_message = match actual:
        Ok(owner): ""
        Err(failure):
            match failure:
                AlreadyPublished(message): message
                Unpublished(message): ""
    if driver.ctx.error_count_value <= 0 or driver.ctx.error_count_value != driver.ctx.errors.len() or
            published_message != "post-HIR actual validation failed after ordered weave: " + driver.ctx.errors.join("\n") or
            published_message != silent_message: return 15
    checks = checks + 1
    # A later early refusal remains unpublished even with existing ctx errors.
    val prior = driver.ctx.error_count_value
    if not unpublished(driver_hir_archive_weave_boundary_capture_with_failure_v1(driver)) or
            driver.ctx.error_count_value != prior: return 16
    checks = checks + 1
    val good = hir_archive_weave_fixture_prepare_v1(
        "test/fixtures/compiler/hir_archive_weave_boundary/provider.spl", "good_provider", "good_alias")
    if good.is_err(): return 17
    val success = driver_hir_archive_weave_boundary_capture_with_failure_v1(good.unwrap().driver)
    if success.is_err() or success.unwrap().gate_report.errors.len() != 0: return 18
    checks = checks + 1
    val legacy = hir_archive_weave_fixture_prepare_v1(
        "test/fixtures/compiler/hir_archive_weave_failure/provider.spl", "legacy_provider", "legacy_alias")
    if legacy.is_err(): return 19
    val legacy_driver = legacy.unwrap().driver
    val legacy_result = driver_hir_archive_weave_boundary_capture_v1(legacy_driver)
    if legacy_result.is_ok() or legacy_driver.ctx.error_count_value <= 0 or
            legacy_result.unwrap_err() != "post-HIR actual validation failed after ordered weave: " + legacy_driver.ctx.errors.join("\n"):
        return 20
    checks = checks + 1
    if checks != 7: return 21
    print "HIR archive weave failure provenance: {checks} checks passed"
    0
