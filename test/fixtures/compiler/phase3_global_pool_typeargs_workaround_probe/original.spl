var custom_primitive_names: [text] = []
var custom_primitive_underlying_type_tags: [i64] = []
var custom_primitive_symbol_ids: [i64] = []
var dict_type_keys: [i64] = []
var dict_type_values: [i64] = []
var named_type_names: [text] = []
var union_type_members: [[i64]] = []
var result_type_ok: [i64] = []
var result_type_err: [i64] = []

extern fn rt_transient_heap_promote<T>(value: T) -> bool
extern fn rt_array_free<T>(array: [T])

# A one-element temporary array is the root, so an owner that is not itself a
# promotable heap root is skipped as an element instead of failing promotion.
fn _type_pool_promote_root<T>(root: [T]) -> bool:
    val promoted = rt_transient_heap_promote(root)
    rt_array_free(root)
    promoted

pub fn type_pools_promote_hir_owners() -> bool:
    # The parser resets these module globals inside a per-file transient
    # scope, but HIR still reads them after that scope ends. Promote only the
    # semantic registries HIR queries: custom primitives, Dict specializations,
    # and the nested type-tag names reached from primitive backing types.
    var promoted = true
    promoted = _type_pool_promote_root([custom_primitive_names]) and promoted
    promoted = _type_pool_promote_root([custom_primitive_underlying_type_tags]) and promoted
    promoted = _type_pool_promote_root([custom_primitive_symbol_ids]) and promoted
    promoted = _type_pool_promote_root([dict_type_keys]) and promoted
    promoted = _type_pool_promote_root([dict_type_values]) and promoted
    promoted = _type_pool_promote_root([named_type_names]) and promoted
    promoted = _type_pool_promote_root([union_type_members]) and promoted
    promoted = _type_pool_promote_root([result_type_ok]) and promoted
    promoted = _type_pool_promote_root([result_type_err]) and promoted
    promoted

fn main() -> i64:
    if type_pools_promote_hir_owners():
        return 0
    return 1
