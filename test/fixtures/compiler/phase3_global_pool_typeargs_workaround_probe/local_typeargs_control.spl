fn first<T>(root: [T]) -> T:
    root[0]

fn main() -> i64:
    val words: [text] = ["tagged"]
    val numbers: [i64] = [7]
    val nested: [[i64]] = [[17]]
    val got_words = first<[text]>([words])
    val got_numbers = first<[i64]>([numbers])
    val got_nested = first<[[i64]]>([nested])
    print got_words[0]
    print got_numbers[0]
    print got_nested[0][0]
    return 0
