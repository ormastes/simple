# Explicit type arguments must survive the real parser, not inference from
# an argument (T never appears in the parameter list).
fn failure[T](message: text) -> Result<T, text>:
    Err(message)

fn main() -> i32:
    val scalar = failure<i64>("scalar")
    match scalar:
        case Err(message):
            if message != "scalar": return 1
        case _: return 2
    val array = failure<[i64]>("array")
    match array:
        case Err(message):
            if message != "array": return 3
        case _: return 4
    val mapping = failure<Dict<text, i64>>("mapping")
    match mapping:
        case Err(message):
            if message != "mapping": return 5
        case _: return 6
    print "explicit return-only generic: 3 checks, 0 failures"
    0
