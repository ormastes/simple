# Real equality/inequality controls for method Any arguments. No SSpec.
class AnyProbe:
    value: any

    fn matches(expected) -> bool:
        self.value == expected

    fn matches_explicit(expected: any) -> bool:
        self.value == expected

    fn matches_default(expected: any = 41) -> bool:
        self.value == expected

    fn typed_default(expected: i64 = 41) -> i64:
        expected

fn free_matches(actual: any, expected: any) -> bool:
    actual == expected

fn forward(probe: AnyProbe, expected: any) -> bool:
    probe.matches(expected)

trait ScalarAnyProbe:
    fn matches_scalar(expected) -> bool

impl ScalarAnyProbe for i64:
    fn matches_scalar(expected) -> bool:
        val probe = AnyProbe(value: self)
        probe.matches(expected)

fn scalar_token() -> i64:
    41

fn invoke(callback: fn() -> bool) -> bool:
    callback()

fn main() -> i64:
    if not free_matches(41, 41): return 1
    if free_matches(41, 42): return 2
    val integer = AnyProbe(value: 41)
    if not integer.matches(41): return 3
    if integer.matches(42): return 4
    if not integer.matches_explicit(41): return 5
    if integer.matches_explicit(42): return 6
    if not forward(integer, 41): return 7
    if forward(integer, 42): return 8
    if not scalar_token().matches_scalar(41): return 9
    if scalar_token().matches_scalar(42): return 10
    if not invoke(\: scalar_token().matches_scalar(41)): return 11
    if invoke(\: scalar_token().matches_scalar(42)): return 12
    val boolean = AnyProbe(value: true)
    if not boolean.matches(true): return 13
    if boolean.matches(false): return 14
    val text_value = AnyProbe(value: "forty-one")
    if not text_value.matches("forty-one"): return 15
    if text_value.matches("forty-two"): return 16
    val floating = AnyProbe(value: 41.5)
    if not floating.matches(41.5): return 17
    if floating.matches(42.5): return 18
    if not integer.matches_default(): return 19
    if integer.matches_default(42): return 20
    if integer.typed_default() != 41: return 21
    if integer.typed_default(42) != 42: return 22
    print("METHOD_ANY_ARGUMENTS_PASS")
    0
