use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_instruction_support.{MirBinOp, mir_operand_const_int}
use compiler.mir.mir_types.{LocalId, MirTypeKind}
fn invalid(value: MirInstKind) -> i64:
    match value:
        case MirInstKind.BinOp: 1
        case _: 0
fn main() -> i64:
    invalid(MirInstKind.BinOp(LocalId(id: 0), MirBinOp.Eq, mir_operand_const_int(1), mir_operand_const_int(2)))
