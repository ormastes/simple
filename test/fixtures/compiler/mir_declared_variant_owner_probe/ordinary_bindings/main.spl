# Ordinary non-enum patterns must retain their value/tuple semantics.
fn bind(value: i64) -> i64:
    match value:
        case result: result + 1
fn tuple_bind(value: (i64, text)) -> i64:
    match value:
        case (number, label):
            if label == "ordinary": number
            else: 0
fn main() -> i64:
    print bind(6)
    print tuple_bind((23, "ordinary"))
    print tuple_bind((29, "other"))
    0
