use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_instruction_support.{MirBinOp, mir_operand_const_int}
use compiler.mir.mir_types.{LocalId, MirTypeKind}

# Exact real backend source patterns: CUDA binds BinOp.op then matches it;
# Vulkan matches the same declared op slot through a nested unit OR.
fn cuda_op(value: MirInstKind) -> i64:
    match value:
        case BinOp(_, op, _, _):
            match op:
                case Eq | Ne | Lt | Le | Gt | Ge: 1
                case _: 0
        case _: 0
fn vulkan_op(value: MirInstKind) -> i64:
    match value:
        case BinOp(_, Eq, _, _) | BinOp(_, Ne, _, _) | BinOp(_, Lt, _, _) | BinOp(_, Le, _, _) | BinOp(_, Gt, _, _) | BinOp(_, Ge, _, _): 1
        case _: 0
fn probe(op: MirBinOp):
    val value = MirInstKind.BinOp(LocalId(id: 0), op, mir_operand_const_int(1), mir_operand_const_int(2))
    print cuda_op(value)
    print vulkan_op(value)
fn main() -> i64:
    probe(MirBinOp.Eq)
    probe(MirBinOp.Ne)
    probe(MirBinOp.Lt)
    probe(MirBinOp.Le)
    probe(MirBinOp.Gt)
    probe(MirBinOp.Ge)
    probe(MirBinOp.Add)
    0
