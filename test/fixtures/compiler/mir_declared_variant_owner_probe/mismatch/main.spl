use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_instruction_support.{MirBinOp, mir_operand_const_int}
use compiler.mir.mir_types.{LocalId, MirTypeKind}

fn wrong(value: MirInstKind) -> i64:
    match value:
        case MirInstKind.BinOp(x, _, _, _) | MirInstKind.BinOp(y, _, _, _): 1
        case _: 0
fn main() -> i64:
    wrong(MirInstKind.BinOp(LocalId(id: 0), MirBinOp.Eq, mir_operand_const_int(1), mir_operand_const_int(2)))
