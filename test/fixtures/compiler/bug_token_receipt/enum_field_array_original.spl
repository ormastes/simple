struct TokenCount:
    value: i64

enum Reading:
    Unavailable
    Count(TokenCount)

fn total(readings: [Reading]) -> i64:
    var sum: i64 = 0
    for reading in readings:
        match reading:
            case Reading.Unavailable: return -1
            case Reading.Count(count): sum = sum + count.value
    sum

struct Usage:
    input: Reading
    output: Reading

fn usage_total(usage: Usage) -> i64:
    val readings = [usage.input, usage.output]
    var known: i64 = 0
    for reading in readings:
        match reading:
            case Reading.Unavailable: ()
            case Reading.Count(_): known = known + 1
    if known != 2: return -2
    total(readings)

fn main():
    val usage = Usage(input: Reading.Count(TokenCount(value: 2)), output: Reading.Count(TokenCount(value: 3)))
    print "{usage_total(usage)}"
