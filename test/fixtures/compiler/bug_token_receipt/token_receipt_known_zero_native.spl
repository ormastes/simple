use nogc_sync_mut.database.bug.{Bug, BugSeverity, BugStatus, BugTokenReading, BugTokenCount, BugTokenUsage, BugTokenCategory, BugTokenProvider, BugTokenSource, BugKnowledgeLink, create_bug_database}

fn main():
    var db = create_bug_database("build/bugtoken-layout-probe/unused-zero.sdn")
    assert(db.add_bug(Bug(id: "zero", severity: BugSeverity.P2, status: BugStatus.Open, title: "zero", description: [], file: "src/compiler/probe.spl", line: 1, reproducible_by: "native", fix_strategy: [], investigation_log: [], created_at: "2026-11-23", updated_at: "2026-11-23", valid: true)))
    var partial = BugTokenUsage(category: BugTokenCategory.Compiler, provider: BugTokenProvider(value: "probe"), input: BugTokenReading.Count(BugTokenCount(value: 0)), output: BugTokenReading.Unavailable, cache_read: BugTokenReading.Unavailable, cache_create: BugTokenReading.Unavailable, source: BugTokenSource(value: "native-probe"), knowledge: None, recorded_at: "2026-11-23")
    # A reported zero is known, so mixing it with unavailable fields still needs evidence.
    assert(not db.add_token_usage("zero", partial))
    assert(db.db.get_table("bug_token_usage").unwrap().rows.len() == 0)
    partial.knowledge = Some(BugKnowledgeLink(path: "doc/native-probe.md"))
    assert(db.add_token_usage("zero", partial))
    val row = db.db.get_table("bug_token_usage").unwrap().rows[0]
    assert((row.get("input_tokens") ?? "") == "0")
    assert((row.get("output_tokens") ?? "") == "unavailable")
    assert((row.get("total_tokens") ?? "") == "unavailable")
    print "token-receipt-known-zero-ok assertions=7"
