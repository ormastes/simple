# Native fixture for mcp_native_source_form_gaps_2026_10_11 (brace StructLit).
# Expected stdout: "ok". Stage3 verify: bin/simple native-build this file and run it.
struct Desc:
    name: text
    desc: text
    req: text

fn main() -> i64:
    val n = "tool"
    val d = "describes"
    val r = "required"
    # in declaration order, and reordered with order-insensitive values
    val a = Desc { name: n, desc: d, req: r }
    val b = Desc { req: r, name: n, desc: d }
    if a.name != "tool" or a.desc != "describes" or a.req != "required": return 1
    if b.name != "tool" or b.desc != "describes" or b.req != "required": return 2
    print "ok"
    0
