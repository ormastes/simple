# Small native regression: no full driver, parser, or test-runner closure.
use compiler.driver.driver_streaming_surface_policy.{driver_streaming_surface_requested_values, driver_streaming_surface_route_values, driver_streaming_surface_rejection}

fn main() -> i64:
    # The failed ordinary CLI invocation had stage3=1 and no bootstrap flag.
    val requested = driver_streaming_surface_requested_values("1", "", "")
    if not requested: return 1
    if driver_streaming_surface_route_values(requested, true, true, false, true, false) != 1: return 2
    if driver_streaming_surface_route_values(false, true, true, false, true, false) != 0: return 3
    if driver_streaming_surface_requested_values("0", "", ""): return 4
    if driver_streaming_surface_requested_values("", "", ""): return 5
    if driver_streaming_surface_requested_values("true", "", ""): return 6
    if not driver_streaming_surface_requested_values("", "1", "1"): return 7
    if driver_streaming_surface_requested_values("", "0", "1"): return 8
    if driver_streaming_surface_requested_values("", "1", "0"): return 9
    # Reject unsupported explicit requests; zero would silently retain all ASTs.
    if driver_streaming_surface_route_values(true, false, true, false, true, false) != -1: return 10
    if driver_streaming_surface_route_values(true, true, false, false, true, false) != -2: return 11
    if driver_streaming_surface_route_values(true, true, true, true, true, false) != -3: return 12
    if driver_streaming_surface_route_values(true, true, true, false, false, false) != -4: return 13
    if driver_streaming_surface_route_values(true, true, true, false, true, true) != -5: return 14
    if driver_streaming_surface_route_values(false, false, false, true, false, true) != 0: return 15
    if driver_streaming_surface_rejection(-1) != "E-DRV-STREAM-AOT: explicit streaming requires AOT mode": return 16
    if driver_streaming_surface_rejection(-2) != "E-DRV-STREAM-ENTRY: explicit streaming requires an entry closure": return 17
    if driver_streaming_surface_rejection(-3) != "E-DRV-STREAM-COVERAGE: explicit streaming cannot retain coverage inventory": return 18
    if driver_streaming_surface_rejection(-4) != "E-DRV-STREAM-MCDC: explicit streaming requires MC/DC off": return 19
    if driver_streaming_surface_rejection(-5) != "E-DRV-STREAM-BACKEND: explicit streaming does not support VHDL": return 20
    if driver_streaming_surface_rejection(0) != "": return 21
    if driver_streaming_surface_rejection(1) != "": return 22
    print "PASS: ordinary streaming route, defaults, five safety guards, rejection diagnostics (22 checks)"
    0
