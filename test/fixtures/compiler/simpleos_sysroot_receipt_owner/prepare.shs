#!/bin/sh
# Data preparation only. Reuse the canonical real-ELF fixture owner unchanged.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd -P)
result=$(sh "$repo/test/01_unit/os/port/simpleos_sysroot_receipt_test.shs" --fixture-only)
case "$result" in fixture=*) fixture=${result#fixture=} ;; *) echo 'ERROR: fixture owner returned no private path' >&2; exit 2 ;; esac
if command -v cygpath >/dev/null 2>&1; then fixture=$(cygpath -m "$fixture"); fi
printf 'fixture=%s\nqualification=none\n' "$fixture"
