use std.nogc_sync_mut.concurrent.mutex.{mutex_new, mutex_lock_gate, mutex_unlock}

fn main() -> i64:
    val gate = mutex_new(0)
    val first = mutex_lock_gate(gate)
    if first == nil: return 1
    if (first ?? -1) != 0: return 2
    val _ = mutex_unlock(gate, 0)
    val second = mutex_lock_gate(gate)
    if second == nil: return 3
    if (second ?? -1) != 0: return 4
    val _ = mutex_unlock(gate, 0)
    0
