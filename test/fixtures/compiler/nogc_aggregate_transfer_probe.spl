"""Native diagnostic: actual array/tuple MIR aggregates consume owned elements."""
use std.nogc_sync_mut.io_runtime.{exit}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId, SymbolTable}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind}
use compiler.mir.mir_data.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir._MirLoweringExpr.method_calls_literals.*

fn nogc_aggregate_require(condition: bool, message: text):
    if not condition:
        print "nogc-aggregate-transfer FAILED: {message}"
        exit(1)

fn transfer_operand_moves(type_: HirType, strict: bool, array: bool) -> bool:
    var lowering = MirLowering.new(SymbolTable.new())
    lowering.nogc_strict = strict
    var builder = lowering.builder
    val source = builder.new_local(nil, MirType(kind: MirTypeKind.Ref(MirType.i64(), false)), LocalKind.Temp)
    lowering.builder = builder
    lowering.bind_local(17, source)
    lowering.remember_local_hir_type(source.id, type_, 0, 0)
    # Attribute deliberately absent: authoritative local type must survive
    # erasure and select the operand used by the real aggregate instruction.
    val expression = HirExpr(kind: HirExprKind.NamedVar(SymbolId(id: 17), "owner"),
        has_type_: false, type_: HirType(kind: HirTypeKind.Error, span: Span.empty()), span: Span.empty())
    val result = if array:
        lowering.lower_array_lit([expression])
    else:
        lowering.lower_tuple_lit([expression])
    nogc_aggregate_require(lowering.errors.len() == 0, "typed literal lowering reported an error")
    var found = false
    var moves = false
    for instruction in lowering.builder.instructions:
        match instruction.kind:
            case MirInstKind.Aggregate(destination, _, operands):
                if destination.id == result.id:
                    nogc_aggregate_require(operands.len() == 1, "element was duplicated or omitted")
                    found = true
                    match operands[0].kind:
                        case MirOperandKind.Move(local):
                            nogc_aggregate_require(local.id == source.id, "owned element was copied through another local")
                            moves = true
                        case MirOperandKind.Copy(_): pass
                        case _: nogc_aggregate_require(false, "literal lost its local operand")
            case _: pass
    nogc_aggregate_require(found, "literal emitted no aggregate instruction")
    moves

fn verify_nested_fresh_array(unique: HirType):
    var lowering = MirLowering.new(SymbolTable.new())
    var builder = lowering.builder
    val source = builder.new_local(nil, MirType(kind: MirTypeKind.Ref(MirType.i64(), false)), LocalKind.Temp)
    lowering.builder = builder
    lowering.bind_local(17, source)
    lowering.remember_local_hir_type(source.id, unique, 0, 0)
    val unknown = HirType(kind: HirTypeKind.Error, span: Span.empty())
    val owner = HirExpr(kind: HirExprKind.NamedVar(SymbolId(id: 17), "owner"),
        has_type_: false, type_: unknown, span: Span.empty())
    val inner = HirExpr(kind: HirExprKind.ArrayLit([owner], None),
        has_type_: false, type_: unknown, span: Span.empty())
    val outer = lowering.lower_array_lit([inner])
    nogc_aggregate_require(lowering.errors.len() == 0, "fresh nested array lost ownership metadata")
    var moved_aggregates = 0
    for instruction in lowering.builder.instructions:
        match instruction.kind:
            case MirInstKind.Aggregate(_, _, operands):
                nogc_aggregate_require(operands.len() == 1, "nested initializer was duplicated")
                match operands[0].kind:
                    case MirOperandKind.Move(_): moved_aggregates = moved_aggregates + 1
                    case _: nogc_aggregate_require(false, "nested fresh owner aggregate was copied")
            case _: pass
    nogc_aggregate_require(moved_aggregates == 2, "nested literal was not evaluated once per level")
    var retained_nested = false
    if val outer_type = lowering.find_local_hir_type(outer.id):
        match outer_type.kind:
            case HirTypeKind.Array(inner_type, _):
                match inner_type.kind:
                    case HirTypeKind.Array(owner_type, _):
                        match owner_type.kind:
                            case HirTypeKind.Unique(_): retained_nested = true
                            case _: pass
                    case _: pass
            case _: pass
    nogc_aggregate_require(retained_nested, "nested array result discarded unique element type")

fn verify_empty_array_context(unique: HirType):
    var lowering = MirLowering.new(SymbolTable.new())
    val declared = lowering.lower_array_lit([], Some(unique))
    var retained_owner = false
    if val declared_type = lowering.find_local_hir_type(declared.id):
        match declared_type.kind:
            case HirTypeKind.Array(element, _):
                match element.kind:
                    case HirTypeKind.Unique(_): retained_owner = true
                    case _: pass
            case _: pass
    nogc_aggregate_require(retained_owner, "declared empty array lost its element type")
    val unknown = lowering.lower_array_lit([])
    nogc_aggregate_require(lowering.find_local_hir_type(unknown.id) == nil,
        "untyped empty array invented ownership from MIR erasure")

fn verify_runtime_storage(type_: HirType, expected_move: bool, dictionary: bool):
    var lowering = MirLowering.new(SymbolTable.new())
    lowering.nogc_strict = true
    var builder = lowering.builder
    val source = builder.new_local(nil, MirType(kind: MirTypeKind.Ref(MirType.i64(), false)), LocalKind.Temp)
    val second_source = builder.new_local(nil, MirType(kind: MirTypeKind.Ref(MirType.i64(), false)), LocalKind.Temp)
    val receiver = builder.new_local(nil, MirType.i64(), LocalKind.Temp)
    lowering.builder = builder
    lowering.bind_local(17, source)
    lowering.remember_local_hir_type(source.id, type_, 0, 0)
    lowering.bind_local(18, second_source)
    lowering.remember_local_hir_type(second_source.id, type_, 0, 0)
    val expression = HirExpr(kind: HirExprKind.NamedVar(SymbolId(id: 17), "owner"),
        has_type_: false, type_: HirType(kind: HirTypeKind.Error, span: Span.empty()), span: Span.empty())
    val second_expression = HirExpr(kind: HirExprKind.NamedVar(SymbolId(id: 18), "other_owner"),
        has_type_: false, type_: HirType(kind: HirTypeKind.Error, span: Span.empty()), span: Span.empty())
    if dictionary:
        lowering.lower_dict_lit([(expression, second_expression)])
    else:
        lowering.lower_unresolved_array_push(receiver, expression, 0, receiver, receiver, 0)
    nogc_aggregate_require(lowering.errors.len() == 0, "runtime storage reported a type error")
    var stores = 0
    for instruction in lowering.builder.instructions:
        match instruction.kind:
            case MirInstKind.Call(_, function, arguments):
                match function.kind:
                    case MirOperandKind.Const(MirConstValue.Str(name), _):
                        if name == "rt_array_push" or name == "rt_dict_set":
                            stores = stores + 1
                            match arguments[0].kind:
                                case MirOperandKind.Copy(_): pass
                                case _: nogc_aggregate_require(false, "storage consumed its mutation receiver")
                            var index = 1
                            while index < arguments.len():
                                var is_move = false
                                match arguments[index].kind:
                                    case MirOperandKind.Move(local):
                                        is_move = true
                                        nogc_aggregate_require(local.id == (if index == 2: second_source.id else: source.id), "storage moved another local")
                                    case MirOperandKind.Copy(_): pass
                                    case _: nogc_aggregate_require(false, "storage lost its value operand")
                                nogc_aggregate_require(is_move == expected_move, "runtime storage transfer mode changed")
                                index = index + 1
                    case _: pass
            case _: pass
    nogc_aggregate_require(stores == 1, "runtime storage duplicated or omitted a call")

fn main() -> i64:
    val span = Span.empty()
    val scalar = HirType(kind: HirTypeKind.Int(64, true), span: span)
    val unique = HirType(kind: HirTypeKind.Unique(scalar), span: span)
    val nested = HirType(kind: HirTypeKind.Tuple([scalar, unique]), span: span)
    val shared = HirType(kind: HirTypeKind.Shared(unique), span: span)
    val short = HirType(kind: HirTypeKind.Ref(unique, false), span: span)
    val named = HirType(kind: HirTypeKind.Named(SymbolId(id: 321), []), span: span)
    for array in [false, true]:
        nogc_aggregate_require(transfer_operand_moves(unique, false, array), "unique owner was copied")
        nogc_aggregate_require(transfer_operand_moves(nested, false, array), "nested unique owner was copied")
        nogc_aggregate_require(not transfer_operand_moves(shared, true, array), "shared pointee was consumed")
        nogc_aggregate_require(not transfer_operand_moves(short, true, array), "short reference pointee was consumed")
        nogc_aggregate_require(transfer_operand_moves(named, true, array), "strict bare owner was copied")
        nogc_aggregate_require(not transfer_operand_moves(named, false, array), "ordinary named value changed policy")
    for dictionary in [false, true]:
        verify_runtime_storage(unique, true, dictionary)
        verify_runtime_storage(shared, false, dictionary)
        verify_runtime_storage(short, false, dictionary)
        verify_runtime_storage(named, true, dictionary)
    verify_nested_fresh_array(unique)
    verify_empty_array_context(unique)
    print "nogc-aggregate-transfer: array and tuple Move/Copy and nested metadata boundaries passed"
    0
