# Native regression for While traversal during closure conversion.
# Expected: exit 0 and native-while-lambda-ok.
fn make_body_local_callback() -> fn() -> i64:
    \:
        var shadow = 99
        var i = 0
        while i < 2:
            val shadow = i + 5
            i = i + 1
        i + shadow

fn make_capturing_callback(limit: i64, step: i64) -> fn() -> i64:
    \:
        var i = 0
        var total = 0
        while i < limit:
            val limit = step
            total = total + limit
            i = i + 1
        total

fn main() -> i64:
    val local_callback = make_body_local_callback()
    if local_callback() != 101:
        print "body-local while callback failed"
        return 1
    val capturing_callback = make_capturing_callback(2, 5)
    if capturing_callback() != 10:
        print "capturing while callback failed"
        return 2
    print "native-while-lambda-ok"
    0
