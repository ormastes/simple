# Native diagnostic: invokes actual analyzer, binding and archive owners.
# No specification framework allocations occur inside transient scopes.
use support.*
use current.{collection_current_controls_v1}
use compiler.driver.cache.collection_archive_analysis_types_v1.{CollectionArchiveAnalysisV1}
use compiler.driver.cache.collection_archive_analysis_v1.{collection_archive_capture_v1,
    collection_archive_load_analysis_in_owned_scope_v1}
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1, hir_body_archive_matches_v1}
use compiler.driver.driver_hir_cache.{hir_cache_header, hir_cache_last_warnings}
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_collection_planner.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.semantics.perf_facts.registry.{CollectionRegistryBindingV1,
    collection_registry_parse, collection_registry_bind_modules}
use compiler.semantics.perf.collection_plan_analysis.{analyze_collection_module_v1}
use std.env.{env_get}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end}

fn main() -> i64:
    if hir_cache_header() == "" or env_get("SIMPLE_HIR_LEASE_CLOSURE_DIGEST").len() != 64 or
            env_get("SIMPLE_HIR_LEASE_RUNTIME_PROVIDER_DIGEST").len() != 64 or
            transient_array_scope_state_v1() != 0: return 1
    var checks = 1
    val path = "test/fixtures/compiler/hir_collection_archive/operations.spl"
    val module = collection_typed_module(path, "hir_collection_archive.operations")
    val source = "schema_version: simple.collection-operations/v1\nmetadata_version: collection-native-v1\noperations:\n" +
        collection_registry_row(module, "array_map", "map", "same-as-receiver", false) +
        collection_registry_row(module, "array_filter", "filter", "at-most-receiver", false) +
        collection_registry_row(module, "array_append", "append", "same-as-receiver", true)
    val snapshot_result = collection_registry_parse(source)
    if snapshot_result.is_err(): return 2
    val snapshot = snapshot_result.unwrap()
    val bindings = [collection_binding(module, "array_map", snapshot),
        collection_binding(module, "array_filter", snapshot), collection_binding(module, "array_append", snapshot)]
    val registries_result = collection_registry_bind_modules(snapshot, bindings)
    if registries_result.is_err() or not registries_result.unwrap().has(path): return 3
    val registry = registries_result.unwrap()[path]
    if not registry.is_structurally_valid() or registry.summaries.len() != 3: return 4
    checks = checks + 1
    val retained = analyze_collection_module_v1(module, registry)
    val expected = collection_observation(retained)
    if expected.plans != 2 or expected.maximal_chain_nodes != 3 or expected.loop_nodes != 2 or
            expected.callback_literal != 43 or expected.loop_literal != 17 or
            expected.loop_append != collection_function(module, "array_append").symbol.id or not expected.unproven: return 5
    checks = checks + 1
    val archive_result = collection_archive(module)
    if archive_result.is_err(): return 6
    val archive = archive_result.unwrap()
    if not hir_body_archive_matches_v1(archive, archive.input): return 7
    checks = checks + 1
    val captured_result = collection_archive_capture_v1(archive, source, bindings, "llvm")
    if captured_result.is_err(): return 8
    val descriptor = captured_result.unwrap()
    if descriptor.plans_found != 2 or descriptor.functions_scanned != module.functions.len() or
            transient_array_scope_state_v1() != 0 or hir_cache_last_warnings().len() != 0: return 9
    checks = checks + 1
    val observed_result = collection_observe_archive(descriptor)
    if observed_result.is_err(): return 10
    val observed = observed_result.unwrap()
    if observed.digest != expected.digest or observed.callback_literal != 43 or observed.loop_literal != 17 or
            observed.maximal_chain_nodes != 3 or observed.loop_nodes != 2 or not observed.unproven: return 11
    checks = checks + 1
    # A second real scope allocates large scratch text before another replay.
    # Only scalar checks survive; no plan/expression/loop origin is promoted.
    if not transient_scope_begin(): return 12
    var scratch: [text] = []
    var i = 0
    while i < 4096:
        scratch = scratch.push("collection scope growth {i}: callback/loop body reclamation control")
        i = i + 1
    val churn_valid = scratch.len() == 4096
    if not transient_scope_end() or not churn_valid: return 13
    val replayed = collection_observe_archive(descriptor)
    if replayed.is_err() or replayed.unwrap().digest != expected.digest or replayed.unwrap().loop_literal != 17: return 14
    checks = checks + 1
    if not collection_archive_load_analysis_in_owned_scope_v1(descriptor).is_err(): return 15
    checks = checks + 1
    if not transient_scope_begin(): return 16
    val nested_refused = collection_archive_capture_v1(archive, source, bindings, "llvm").is_err()
    if not nested_refused or transient_array_scope_state_v1() != 1: return 17
    val paused = transient_scope_pause()
    val paused_refused = if paused: collection_archive_load_analysis_in_owned_scope_v1(descriptor).is_err() else: false
    if not paused_refused or transient_array_scope_state_v1() != 2 or not transient_scope_end(): return 18
    checks = checks + 1
    var changed = descriptor
    changed.registry_source = source + "unrecognized: true\n"
    if not collection_observe_archive(changed).is_err(): return 19
    checks = checks + 1
    changed = descriptor
    changed.plans_found = descriptor.plans_found + 1
    if not collection_observe_archive(changed).is_err(): return 20
    checks = checks + 1
    changed = descriptor
    var changed_bindings: [CollectionRegistryBindingV1] = []
    for binding in descriptor.bindings: changed_bindings = changed_bindings.push(binding)
    var wrong_binding = changed_bindings[0]
    wrong_binding.signature_fingerprint = sha256_text("wrong actual signature")
    changed_bindings[0] = wrong_binding
    changed.bindings = changed_bindings
    if not collection_observe_archive(changed).is_err() or
            not collection_archive_capture_v1(archive, source, changed_bindings, "llvm").is_err(): return 21
    checks = checks + 1
    changed = descriptor
    changed.backend = "native"
    if not collection_observe_archive(changed).is_err() or
            not collection_archive_capture_v1(archive, source, bindings, "native").is_err(): return 22
    checks = checks + 1
    changed = descriptor
    var wrong_archive = changed.archive
    wrong_archive.body_digest = sha256_text("wrong complete body")
    changed.archive = wrong_archive
    if not collection_observe_archive(changed).is_err(): return 23
    checks = checks + 1
    var options = driver_core_compile_options_default()
    options.backend = "llvm"
    val driver = CompilerDriver.create(options)
    if driver.configure_collection_registry(source, bindings).is_err(): return 24
    driver.ctx.hir_modules[module.name] = module
    driver.ctx.hir_module_count_value = 1
    if not driver.analyze_collections_before_monomorphize(true) or driver.collection_analyses.len() != 1 or
            collection_observation(driver.collection_analyses[module.name]).digest != expected.digest: return 25
    checks = checks + 1
    var archives: Dict<text, HirBodyArchiveV1> = {}
    archives[module.name] = archive
    if not driver.analyze_collections_before_archived_monomorphize_v1(true, archives, [module.name]) or
            driver.collection_analyses.len() != 0 or driver.collection_archived_analyses.len() != 1: return 26
    val driver_observed = collection_observe_archive(driver.collection_archived_analyses[module.name])
    if driver_observed.is_err() or driver_observed.unwrap().digest != expected.digest: return 27
    checks = checks + 1
    if not driver.analyze_collections_before_monomorphize(true) or driver.collection_archived_analyses.len() != 0 or
            driver.collection_analyses.len() != 1: return 28
    checks = checks + 1
    if driver.analyze_collections_before_archived_monomorphize_v1(false, archives, [module.name]) or
            driver.collection_archived_analyses.len() != 0 or driver.collection_analyses.len() != 0: return 29
    checks = checks + 1
    val later = collection_lower("test/fixtures/compiler/hir_collection_archive/second.spl", "hir_collection_archive.second")
    val later_archive_result = collection_archive(later)
    if later_archive_result.is_err(): return 30
    var all_archives: Dict<text, HirBodyArchiveV1> = {}
    all_archives[module.name] = archive
    all_archives[later.name] = later_archive_result.unwrap()
    var late_bindings: [CollectionRegistryBindingV1] = []
    for binding in bindings: late_bindings = late_bindings.push(binding)
    var late_invalid = bindings[2]
    late_invalid.module_path = later.path
    late_invalid.symbol_id = collection_function(later, "later_owner").symbol.id
    late_bindings = late_bindings.push(late_invalid)
    # Parsing/binding succeeds; the second complete module's actual ABI owner
    # rejects this different declaration before pending first-module publication.
    if driver.configure_collection_registry(source, late_bindings).is_err(): return 31
    driver.ctx.hir_module_count_value = 2
    if driver.analyze_collections_before_archived_monomorphize_v1(true, all_archives, [module.name, later.name]) or
            driver.collection_archived_analyses.len() != 0 or driver.collection_analyses.len() != 0 or
            not driver.ctx.errors.join("\n").contains("collection-binding-typed-signature-mismatch"): return 32
    checks = checks + 1
    if driver.configure_collection_registry(source, bindings).is_err(): return 33
    driver.ctx.hir_module_count_value = 1
    if not driver.analyze_collections_before_archived_monomorphize_v1(true, archives, [module.name]): return 34
    if not driver.configure_collection_registry("schema_version: invalid\n", []).is_err() or
            driver.collection_archived_analyses.len() != 0 or driver.collection_analyses.len() != 0 or
            driver.analyze_collections_before_archived_monomorphize_v1(true, archives, [module.name]): return 35
    checks = checks + 1
    if checks != 20: return 36
    val current = collection_current_controls_v1(archive, source, bindings, registry, expected)
    if current.is_err():
        print "current collection controls failed: {current.unwrap_err()}"
        return 37
    if current.unwrap() != 14: return 38
    checks = checks + current.unwrap()
    if checks != 34: return 39
    print "HIR collection archive: {checks} checks passed"
    0
