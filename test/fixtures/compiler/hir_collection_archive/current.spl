use support.*
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_collection_planner.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1}
use compiler.driver.cache.collection_current_archive_analysis_v1.{CollectionCurrentArchiveAnalysisV1,
    collection_current_archive_capture_v1, collection_current_archive_load_analysis_in_owned_scope_v1}
use compiler.mono.mono_archive_body_input_v1.{MonoArchiveBodyInputV1}
use compiler.mono.mono_archive_current_body_v1.{MonoArchiveCurrentBodyV1,
    mono_archive_current_body_store_in_owned_scope_v1}
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{HirOwnedArtifactContextV1}
use compiler.semantics.perf_facts.registry.{CollectionRegistryBindingV1}
use compiler.semantics.perf_facts.types.{CollectionOperationRegistry}
use compiler.semantics.perf.collection_plan_analysis.{analyze_collection_module_v1}
use std.env.{env_get}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end, transient_promote}

fn current_observe(descriptor: CollectionCurrentArchiveAnalysisV1) -> Result<CollectionObservation, text>:
    if transient_array_scope_state_v1() != 0 or not transient_scope_begin(): return Err("current observation lease")
    val analysis = collection_current_archive_load_analysis_in_owned_scope_v1(descriptor)
    val result: Result<CollectionObservation, text> = if analysis.is_err():
        Err(analysis.unwrap_err())
    else:
        Ok(collection_observation(analysis.unwrap()))
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended: panic("current observation ownership")
    result

fn current_input(archive: HirBodyArchiveV1) -> Result<MonoArchiveBodyInputV1, text>:
    val cache = HirOwnedArtifactContextV1(directory: env_get("SIMPLE_HIR_CACHE_DIR") + "/collection-current-native",
        producer_header: archive.input.producer_header, enabled: true)
    if transient_array_scope_state_v1() != 0: return Err("current input foreign lease")
    # Fixture setup parses outside the transient frame-storage lease so parser
    # global owners cannot retain scratch allocations after that lease closes.
    val module = collection_typed_module(archive.input.source_path, archive.input.module_name, 97, 29)
    if not transient_scope_begin(): return Err("current input lease")
    # Real complete frame, deliberately different callback and loop bodies.
    # This mechanical fixture boundary does not pretend to be driver admission.
    val stored = mono_archive_current_body_store_in_owned_scope_v1(cache, archive,
        sha256_text("collection fixture boundary"), sha256_text("collection fixture contents"), module, [])
    val result: Result<MonoArchiveBodyInputV1, text> = if stored.is_err():
        Err(stored.unwrap_err())
    else:
        Ok(MonoArchiveBodyInputV1(original_parent: archive, current_body: Some(stored.unwrap()),
            current_cache: Some(cache), logical_name: archive.input.module_name))
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val ended = transient_scope_end()
    if not paused or not owned or not ended: panic("current input ownership")
    result

fn collection_current_controls_v1(archive: HirBodyArchiveV1, source: text,
        bindings: [CollectionRegistryBindingV1], registry: CollectionOperationRegistry,
        original: CollectionObservation) -> Result<i64, text>:
    val input = current_input(archive)?
    if input.current_body!.current_body_digest == archive.body_digest: return Err("current body unchanged")
    var checks = 1
    val module = collection_typed_module(archive.input.source_path, archive.input.module_name, 97, 29)
    val expected = collection_observation(analyze_collection_module_v1(module, registry))
    val descriptor = collection_current_archive_capture_v1(input, source, bindings, "llvm")?
    val observed = current_observe(descriptor)?
    if observed.digest != expected.digest or observed.digest == original.digest or
            observed.callback_literal != 97 or observed.loop_literal != 29: return Err("current planner parity")
    checks = checks + 1
    val source_attack = CollectionCurrentArchiveAnalysisV1(..descriptor, registry_source: source + "invalid: true\n")
    if not current_observe(source_attack).is_err(): return Err("current source attack")
    checks = checks + 1
    val count_attack = CollectionCurrentArchiveAnalysisV1(..descriptor, nodes_scanned: descriptor.nodes_scanned + 1)
    if not current_observe(count_attack).is_err(): return Err("current count attack")
    checks = checks + 1
    val alias = MonoArchiveBodyInputV1(..input, logical_name: "collection.actual.alias")
    if not current_observe(CollectionCurrentArchiveAnalysisV1(..descriptor, input: alias)).is_err():
        return Err("current logical substitution")
    val alias_descriptor = collection_current_archive_capture_v1(alias, source, bindings, "llvm")?
    val alias_observed = current_observe(alias_descriptor)?
    if alias_observed.digest != expected.digest or alias_descriptor.input_digest == descriptor.input_digest:
        return Err("current logical capture")
    checks = checks + 1
    val wrong_body = MonoArchiveBodyInputV1(..input,
        current_body: Some(MonoArchiveCurrentBodyV1(..input.current_body!, current_body_digest: sha256_text("wrong current body"))))
    if not current_observe(CollectionCurrentArchiveAnalysisV1(..descriptor, input: wrong_body)).is_err():
        return Err("current body substitution")
    checks = checks + 1
    if not current_observe(CollectionCurrentArchiveAnalysisV1(..descriptor, backend: "native")).is_err():
        return Err("current backend substitution")
    checks = checks + 1
    val original_only = MonoArchiveBodyInputV1(original_parent: archive)
    if not collection_current_archive_capture_v1(original_only, source, bindings, "llvm").is_err():
        return Err("current unresolved fallback")
    checks = checks + 1
    if not transient_scope_begin(): return Err("current foreign scope start")
    val nested = collection_current_archive_capture_v1(input, source, bindings, "llvm").is_err()
    val paused = transient_scope_pause()
    val paused_refused = if paused: collection_current_archive_load_analysis_in_owned_scope_v1(descriptor).is_err() else: false
    val ended = transient_scope_end()
    if not nested or not paused or not paused_refused or not ended or transient_array_scope_state_v1() != 0:
        return Err("current foreign scope refusal")
    checks = checks + 1
    if not collection_current_archive_load_analysis_in_owned_scope_v1(descriptor).is_err():
        return Err("current inactive replay")
    checks = checks + 1
    var options = driver_core_compile_options_default()
    options.backend = "llvm"
    val driver = CompilerDriver.create(options)
    driver.collection_current_archived_analyses["stale"] = descriptor
    if not driver.analyze_collections_before_current_monomorphize_v1({}, []) or
            driver.collection_current_archived_analyses.len() != 0:
        return Err("current unconfigured reset")
    checks = checks + 1
    if driver.configure_collection_registry(source, bindings).is_err(): return Err("current driver registry")
    driver.ctx.hir_module_count_value = 1
    val modules = {input.logical_name: input}
    if not driver.analyze_collections_before_current_monomorphize_v1(modules, [input.logical_name]) or
            driver.collection_current_archived_analyses.len() != 1 or
            driver.collection_analyses.len() != 0 or driver.collection_archived_analyses.len() != 0:
        return Err("current driver publication")
    val actual = current_observe(driver.collection_current_archived_analyses[input.logical_name])?
    if actual.digest != expected.digest: return Err("current driver plan parity")
    checks = checks + 1
    val aliases = {input.logical_name: input, alias.logical_name: alias}
    if driver.analyze_collections_before_current_monomorphize_v1(aliases, [input.logical_name, alias.logical_name]) or
            driver.collection_current_archived_analyses.len() != 0 or
            not driver.ctx.errors.join("\n").contains("collection-analysis-module-path-ambiguous"):
        return Err("current duplicate path was waived")
    checks = checks + 1
    # The earlier actual ABI error must outrank a later missing owner, as in
    # retained configured-binding order rather than module/capture order.
    var bad = bindings[0]
    bad.symbol_id = bindings[1].symbol_id
    var missing = bindings[1]
    missing.module_path = "test/fixtures/compiler/hir_collection_archive/absent.spl"
    if driver.configure_collection_registry(source, [bad, missing]).is_err(): return Err("binding order fixture config")
    val previous_errors = driver.ctx.errors.len()
    if driver.analyze_collections_before_current_monomorphize_v1(modules, [input.logical_name]) or
            driver.ctx.errors.len() != previous_errors + 1 or
            driver.ctx.errors[previous_errors] != "collection-binding-typed-signature-mismatch" or
            driver.collection_current_archived_analyses.len() != 0:
        return Err("current binding order")
    checks = checks + 1
    Ok(checks)

export collection_current_controls_v1
