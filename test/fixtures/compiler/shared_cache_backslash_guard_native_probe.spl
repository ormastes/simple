# Linux-only generated regression. The host fixture must contain a literal
# backslash symlink to private storage and a distinct normalized sibling.
# Direct C admission tests do not qualify this compiler-helper call path.
use compiler.frontend.frontend_cache_root_admission_v1.{frontend_cache_root_admission_v1}
use std.nogc_sync_mut.io_runtime.{env_get_opt}

fn main() -> i64:
    val literal = env_get_opt("SIMPLE_BACKSLASH_LITERAL_ROOT") ?? ""
    val normalized = env_get_opt("SIMPLE_BACKSLASH_NORMALIZED_ROOT") ?? ""
    val private_root = env_get_opt("SIMPLE_BACKSLASH_PRIVATE_ROOT") ?? ""
    if not literal.starts_with("/") or not literal.contains("\\") or
            normalized == "" or private_root == "":
        print "BACKSLASH_GUARD_FAILURE missing Linux fixture"
        return 1
    if not frontend_cache_root_admission_v1(normalized, private_root):
        print "BACKSLASH_GUARD_FAILURE normalized sibling rejected"
        return 2
    if frontend_cache_root_admission_v1(literal, private_root):
        print "BACKSLASH_GUARD_FAILURE literal symlink admitted"
        return 3
    print "BACKSLASH_GUARD rejected-original-symlink"
    0
