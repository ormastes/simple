enum Admission:
    Started(value: i64)
    Owned(value: RightLease)

class RightLease:
    label: text
    number: i64

enum Envelope:
    Inside(value: Admission)

fn read_right_owned(value: Admission) -> i64:
    match value:
        case Admission.Started(number): number
        case Admission.Owned(lease): lease.number

fn right_lease() -> RightLease:
    RightLease(label: "right", number: 91)

fn make_right_owned() -> Admission:
    Admission.Owned(right_lease())

fn right_returned_value() -> i64:
    read_right_owned(make_right_owned())

fn right_nested_value() -> i64:
    val wrapped = Envelope.Inside(make_right_owned())
    match wrapped:
        case Envelope.Inside(value): read_right_owned(value)

fn right_value() -> i64:
    val value = Admission.Started(73)
    match value:
        case Admission.Started(number): number
        case Admission.Owned(lease): lease.number
