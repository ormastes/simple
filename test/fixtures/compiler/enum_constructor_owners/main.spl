# Native two-module oracle: same enum and variant leaves, different payloads.
use .left.{left_value, left_returned_value, left_nested_value}
use .right.{right_value, right_returned_value, right_nested_value}

fn main() -> i64:
    var failed = 0
    if left_value() != "left": failed = failed + 1
    if right_value() != 73: failed = failed + 1
    if left_returned_value() != "returned-left": failed = failed + 1
    if right_returned_value() != 91: failed = failed + 1
    if left_nested_value() != "returned-left": failed = failed + 1
    if right_nested_value() != 91: failed = failed + 1
    print "checks=6 failures={failed}"
    failed
