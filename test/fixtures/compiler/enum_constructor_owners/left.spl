enum Admission:
    Started(value: text)
    Owned(value: LeftLease)

class LeftLease:
    marker: i64
    label: text

enum Envelope:
    Inside(value: Admission)

fn read_left_owned(value: Admission) -> text:
    match value:
        case Admission.Started(label): label
        case Admission.Owned(lease): lease.label

fn left_lease() -> LeftLease:
    LeftLease(marker: 31, label: "returned-left")

fn make_left_owned() -> Admission:
    Admission.Owned(left_lease())

fn left_returned_value() -> text:
    read_left_owned(make_left_owned())

fn left_nested_value() -> text:
    val wrapped = Envelope.Inside(make_left_owned())
    match wrapped:
        case Envelope.Inside(value): read_left_owned(value)

fn left_value() -> text:
    val value = Admission.Started("left")
    match value:
        case Admission.Started(label): label
        case Admission.Owned(lease): lease.label
