use app.probe.provider.{Service, fail, okay, scalar_error, fail_other, value_fail}

class IoError:
    message: i64
    padding: i64

fn alias_probe(service: Service) -> text:
    val first = service.run()
    val second = first
    val third = second
    match third:
        case Ok(_): "unexpected"
        case Err(error): error.message

fn direct_probe() -> text:
    match fail():
        case Ok(_): "unexpected"
        case Err(error): error.message

fn wildcard_probe() -> text:
    val result = fail()
    match result:
        case Err(error): error.message
        case _: "unexpected"

fn joined_probe(flag: bool) -> text:
    val result = if flag: fail() else: fail()
    match result:
        case Ok(_): "unexpected"
        case Err(error): error.message

fn scalar_probe() -> text:
    val result = scalar_error()
    match result:
        case Ok(_): "unexpected"
        case Err(error): error

fn value_copy_probe() -> i64:
    val result = value_fail()
    match result:
        case Ok(_): 1
        case Err(error):
            var separate = error
            separate.message = "changed copy"
            if error.message != "value message": return 2
            if separate.message != "changed copy": return 3
            0

fn main() -> i64:
    var service = Service(calls: 0)
    if alias_probe(service) != "provider message": return 1
    if service.calls != 1: return 2
    if direct_probe() != "provider message": return 3
    if wildcard_probe() != "provider message": return 4
    if scalar_probe() != "text error": return 5
    if joined_probe(true) != "provider message": return 6
    if joined_probe(false) != "provider message": return 7
    if value_copy_probe() != 0: return 8
    0
