use app.probe.records.{IoError, ValueError}

pub class Service:
    calls: i64
    me run() -> Result<(), IoError>:
        self.calls = self.calls + 1
        Err(IoError(kind: 19, message: "provider message", source: 41))

pub fn fail() -> Result<(), IoError>:
    Err(IoError(kind: 7, message: "provider message", source: 11))

pub fn okay() -> Result<IoError, text>:
    Ok(IoError(kind: 7, message: "ok message", source: 11))

pub fn scalar_error() -> Result<(), text>:
    Err("text error")

pub class OtherError:
    message: text
    kind: i64

pub fn fail_other() -> Result<(), OtherError>:
    Err(OtherError(message: "other message", kind: 3))

pub fn value_fail() -> Result<(), ValueError>:
    Err(ValueError(code: 9, message: "value message"))
