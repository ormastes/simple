# Native fixture: a class-typed `var`/`val` initialized from an existing local
# must get its OWN slot. Stage 2 aliased the binding to the source local, so
# reassigning one name overwrote the other
# (doc/08_tracking/bug/stage2_class_var_place_alias_clobbers_source_2026-11-16.md).
# Expected output (interpreter and fixed native agree):
#   param a=llvm t=tm
#   typed a=llvm t=tm
#   local a=llvm t=tm
#   loop a=llvm,llvm,llvm len=12
#   reverse a=tm t=llvm
#   bitfield-free struct a=1 t=9
#   mutate a=mut t=mut
#   generic a=alpha before=alpha t=beta len=4
#   generic-struct a=4 before=4 t=8

class Surf:
    impls: [i64]
    name: text

struct Pt:
    x: i64

fn v_param(a: Surf, all: [Surf]) -> text:
    var t = a
    t = all[1]
    "param a={a.name} t={t.name}"

fn v_typed(a: Surf, all: [Surf]) -> text:
    var t: Surf = a
    t = all[1]
    "typed a={a.name} t={t.name}"

fn v_local(all: [Surf]) -> text:
    val a = all[0]
    var t = a
    t = all[1]
    "local a={a.name} t={t.name}"

fn v_loop(a: Surf, all: [Surf]) -> text:
    # The Stage 3 shape (register_imported_type_methods_inner): the alias is
    # re-created per iteration and reassigned on the first one only.
    var names = ""
    var total = 0
    var pos = 0
    while pos < 3:
        total = total + a.impls.len()
        names = if pos == 0: a.name else: names + "," + a.name
        var t = a
        if pos == 0:
            t = all[1]
        pos = pos + 1
    "loop a={names} len={total}"

fn v_reverse(all: [Surf]) -> text:
    var a = all[0]
    val t = a
    a = all[1]
    "reverse a={a.name} t={t.name}"

fn v_struct(a: Pt) -> text:
    var t = a
    t = Pt(x: 9)
    "bitfield-free struct a={a.x} t={t.x}"


class GBox<T>:
    value: T

fn v_mutate(a: Surf) -> text:
    # Class reference semantics are kept: a field write through t is seen by a.
    var t = a
    t.name = "mut"
    "mutate a={a.name} t={t.name}"

fn v_generic(a: GBox<text>, b: GBox<text>) -> text:
    var t = a
    val before = t.value
    t = b
    "generic a={a.value} before={before} t={t.value} len={t.value.len()}"

fn v_generic_struct(a: GBox<Pt>, b: GBox<Pt>) -> text:
    var t = a
    val before = t.value.x
    t = b
    "generic-struct a={a.value.x} before={before} t={t.value.x}"

fn main():
    val s0 = Surf(impls: [1, 2, 3, 4], name: "llvm")
    val s1 = Surf(impls: [], name: "tm")
    val all = [s0, s1]
    print v_param(s0, all)
    print v_typed(s0, all)
    print v_local(all)
    print v_loop(s0, all)
    print v_reverse(all)
    print v_struct(Pt(x: 1))
    print v_mutate(Surf(impls: [1], name: "orig"))
    print v_generic(GBox(value: "alpha"), GBox(value: "beta"))
    print v_generic_struct(GBox(value: Pt(x: 4)), GBox(value: Pt(x: 8)))
