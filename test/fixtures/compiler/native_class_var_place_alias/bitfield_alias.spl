# Native fixture (bitfield word copy): `var g = f` of a bitfield.
# Interpreter (value semantics): bitfield f=3,0 g=3,5
# Native r16 and the fix both print f=3,5: the bitfield-only early-Let arm
# still aliases the source word, unchanged by the class-alias fix (copying it
# SIGSEGVs on the field write at address 0x3). Recorded in
# doc/08_tracking/bug/stage2_class_var_place_alias_clobbers_source_2026-11-16.md.

bitfield AliasFlags(u32):
    lo: 4
    hi: 28

fn main():
    var f: AliasFlags = AliasFlags(0)
    f.lo = 3
    var g = f
    g.hi = 5
    print "bitfield f={f.lo},{f.hi} g={g.lo},{g.hi}"
