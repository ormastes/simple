# Native fixture (bitfield word copy): `var g = f` of a bitfield, at top level
# of main and inside a text-returning fn.
# Interpreter (value semantics):  top f=3,0 g=3,5 / fn f=3,0 g=3,5
# Native r16 and the fix both print f=3,5 in both forms: the bitfield-only
# early-Let arm still aliases the source word (pre-existing, unchanged by the
# class-alias fix). Copying it (6e2e04a2956) prints f=3,0 here but SIGSEGVs at
# 0x3 when this fn sits in a module with classes/generics (main.spl + v_bitfield),
# so the alias is kept. Recorded in
# doc/08_tracking/bug/stage2_class_var_place_alias_clobbers_source_2026-11-16.md.

bitfield AliasFlags(u32):
    lo: 4
    hi: 28

fn v_bitfield() -> text:
    var f: AliasFlags = AliasFlags(0)
    f.lo = 3
    var g = f
    g.hi = 5
    "fn f={f.lo},{f.hi} g={g.lo},{g.hi}"

fn main():
    var f: AliasFlags = AliasFlags(0)
    f.lo = 3
    var g = f
    g.hi = 5
    print "top f={f.lo},{f.hi} g={g.lo},{g.hi}"
    print v_bitfield()
