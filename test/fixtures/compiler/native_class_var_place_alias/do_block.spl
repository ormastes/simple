# Native fixture (block initializer): a `do:` block whose tail is `a` lowers to
# a's OWN local (MIR lower_block), so the Let initializer is not a HIR place
# read and a syntactic place check let `var t = do: ... a` alias `a`.
# The Rust seed has no `do:` expression, so there is no interpreter oracle;
# the expected output is fixed by the language semantics:
#   block a=llvm t=tm

class Surf:
    impls: [i64]
    name: text

fn v_block(a: Surf, all: [Surf], k: i64) -> text:
    var t = do:
        val unused = k + 1
        a
    t = all[1]
    "block a={a.name} t={t.name}"

fn main():
    val s0 = Surf(impls: [1, 2, 3, 4], name: "llvm")
    val s1 = Surf(impls: [], name: "tm")
    print v_block(s0, [s0, s1], 7)
