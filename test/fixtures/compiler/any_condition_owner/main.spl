# UNRUN. Compile with a future producer containing the condition-owner repair.
# Explicit exits are the oracle; these checks do not depend on std.spec.
use .provider.{untyped_branch, erased_value, erased_score,
    typed_bool_branch, typed_int_branch, typed_optional_branch,
    counted_value, evaluation_count}

fn main() -> i64:
    val computed: i64 = 17 + 1
    if untyped_branch(computed == 19) != 0: return 11
    if untyped_branch(computed == 18) != 1: return 12
    if erased_score(false) != 2: return 13
    if erased_score(true) != 29: return 14
    if erased_score(nil) != 2: return 15
    if erased_score(0) != 2: return 16
    if erased_score(7) != 29: return 17
    if erased_score(-7) != 29: return 18
    if erased_score(0.0) != 2: return 19
    if erased_score(2.5) != 29: return 20
    if erased_score("nonempty") != 29: return 21

    # Typed native scalars must not be sent to the tagged-value predicate.
    if typed_bool_branch(false) != 0: return 22
    if typed_bool_branch(true) != 1: return 23
    if typed_int_branch(1) != 1: return 24
    if typed_int_branch(0) != 0: return 25
    # Raw native 19 has the same bits as tagged false; it is still nonzero.
    if typed_int_branch(19) != 1: return 28
    val present_false: bool? = Some(false)
    val absent: bool? = nil
    if typed_optional_branch(present_false) != 1: return 26
    if typed_optional_branch(absent) != 0: return 27

    # Local, returned-call and untyped collection element ownership paths.
    val local: any = computed == 19
    if local: return 31
    if erased_value(false): return 32
    if not erased_value(true): return 33
    val values: list = [false, true, nil]
    if values[0]: return 34
    if not values[1]: return 35
    if values[2]: return 36

    # Conversion must not reevaluate the operand or destroy short circuiting.
    if counted_value(false): return 41
    if evaluation_count() != 1: return 42
    if erased_value(false) and counted_value(true): return 43
    if evaluation_count() != 1: return 44
    if erased_value(true) or counted_value(false):
        if evaluation_count() != 1: return 45
    else:
        return 46
    print "native-any-condition-owner-pass"
    0
