# Real imported condition owners. No std.spec or replacement truthiness helper.
pub fn untyped_branch(value) -> i64:
    if value: 1 else: 0

pub fn erased_value(value: any) -> any:
    value

pub fn erased_score(value: any) -> i64:
    var score: i64 = 0
    if value: score += 1
    if not value: score += 2
    if value and true: score += 4
    if value or false: score += 8
    while value:
        score += 16
        break
    score

pub fn typed_bool_branch(value: bool) -> i64:
    if value: 1 else: 0

pub fn typed_int_branch(value: i64) -> i64:
    if value: 1 else: 0

pub fn typed_optional_branch(value: bool?) -> i64:
    if value: 1 else: 0

var evaluated: i64 = 0

pub fn counted_value(value: any) -> any:
    evaluated += 1
    value

pub fn evaluation_count() -> i64:
    evaluated
