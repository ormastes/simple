use compiler.driver.cache.runtime_std_authority_receipt.{
    runtime_std_authority_receipt_decode_v2,
    runtime_std_authority_receipt_encode_v2}

fn receipt_fixture() -> text:
    val digest = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    val final_digest = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    [
        "simple-runtime-std-authority-receipt-v2",
        "compiler={digest}", "action_abi={digest}",
        "runtime_abi={digest}", "std_abi={digest}", "config={digest}",
        "target=x86_64-pc-windows-msvc", "snapshot_revision=scv-test",
        "runtime_action={digest}", "std_action={digest}",
        "runtime_archive={digest}", "std_archive={digest}",
        "runtime_receipt={digest}", "std_receipt={final_digest}",
        "manager_request={digest}", "enforced_memory=4096",
        "action_schema=manager-budget+source-outcomes-v2"
    ].join("\n")

fn main() -> i64:
    val content = receipt_fixture()
    val decoded = runtime_std_authority_receipt_decode_v2(content)
    if decoded.is_err(): return 11
    val receipt = decoded.unwrap()
    if receipt.base.compiler_digest != "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": return 12
    if receipt.base.std_receipt_digest != "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb": return 13
    if receipt.budget.enforced_process_limit_bytes != 4096: return 14
    if runtime_std_authority_receipt_encode_v2(receipt) != content: return 15
    if runtime_std_authority_receipt_decode_v2(
            content.substring(0, content.rfind("\n"))).is_ok(): return 21
    if runtime_std_authority_receipt_decode_v2(content + "\nextra=unexpected").is_ok(): return 22
    var rows = content.split("\n")
    rows[13] = "std_receipt=invalid"
    if runtime_std_authority_receipt_decode_v2(rows.join("\n")).is_ok(): return 31
    rows = content.split("\n")
    rows[16] = "action_schema=unexpected"
    if runtime_std_authority_receipt_decode_v2(rows.join("\n")).is_ok(): return 32
    rows = content.split("\n")
    rows[15] = "enforced_memory=0"
    if runtime_std_authority_receipt_decode_v2(rows.join("\n")).is_ok(): return 33
    0
