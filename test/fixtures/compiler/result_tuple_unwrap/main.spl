var calls: i64 = 0
var after_try: i64 = 0

fn pair_result(fail: bool) -> Result<(i64, i64), text>:
    calls = calls + 1
    if fail:
        return Err("pair-error")
    Ok((31, 47))

fn project(fail: bool) -> Result<i64, text>:
    val pair = pair_result(fail)?
    after_try = after_try + 1
    Ok(pair.0 * 100 + pair.1)

fn relay() -> Result<(i64, i64), text>:
    val pair = pair_result(false)?
    Ok(pair)

fn nested() -> Result<(bool, f64, (i64, i64)), text>:
    Ok((true, 2.5, (5, 13)))

fn tiny() -> Result<(bool, bool), text>:
    Ok((false, true))

fn error_pair() -> Result<i64, (i64, i64)>:
    Err((7, 19))

fn scalar() -> Result<f64, text>:
    Ok(2.75)

fn main() -> i64:
    val direct = pair_result(false).unwrap()
    if direct.0 != 31 or direct.1 != 47 or calls != 1: return 1
    val projected = project(false)
    if projected.unwrap() != 3147 or calls != 2 or after_try != 1: return 2
    val failed = project(true)
    if not failed.is_err(): return 3
    if failed.unwrap_err() != "pair-error" or calls != 3 or after_try != 1: return 4
    val relayed = relay().unwrap()
    if relayed.0 != 31 or relayed.1 != 47 or calls != 4: return 5
    val mixed = nested().unwrap()
    val inner = mixed.2
    if not mixed.0 or mixed.1 != 2.5 or inner.0 != 5 or inner.1 != 13: return 6
    val flags = tiny().unwrap()
    if flags.0 or not flags.1: return 7
    val error = error_pair().unwrap_err()
    if error.0 != 7 or error.1 != 19: return 8
    if scalar().unwrap() != 2.75: return 9
    0
