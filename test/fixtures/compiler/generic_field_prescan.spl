# Unused generic declarations must still validate fields in their own scope.
# Multi-character names avoid the legacy single-uppercase-letter fallback.
struct PostingList<Id>:
    ids: [Id]

class Cell<Element>:
    value: Element

struct Concrete:
    value: i64

fn main() -> i64:
    val concrete = Concrete(value: 37)
    if concrete.value != 37:
        return 1
    print "generic_field_prescan=pass"
    0
