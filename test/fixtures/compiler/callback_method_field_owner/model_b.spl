pub struct Port:
    padding: text
    flag: bool
    invoke: fn(i64) -> i64

var receiver_calls: i64 = 0
var callback_calls: i64 = 0

fn add_nineteen(value: i64) -> i64:
    callback_calls = callback_calls + 1
    value + 19

pub fn make_port() -> Port:
    receiver_calls = receiver_calls + 1
    Port(padding: "different-layout", flag: true, invoke: add_nineteen)

pub fn effects() -> i64:
    receiver_calls * 10 + callback_calls
