pub struct Port:
    padding: i64
    invoke: fn(i64) -> i64

var receiver_calls: i64 = 0
var callback_calls: i64 = 0

fn add_seven(value: i64) -> i64:
    callback_calls = callback_calls + 1
    value + 7

pub fn make_port() -> Port:
    receiver_calls = receiver_calls + 1
    Port(padding: 99, invoke: add_seven)

pub fn effects() -> i64:
    receiver_calls * 10 + callback_calls
