# Preserve the original unannotated helper and separately expose its boundaries.
fn invoke_word(callback, value):
    callback(value)

fn value_typed_tail(callback, value: i64):
    callback(value)

fn declared_word_return(callback, value: i64) -> i64:
    callback(value)

fn dynamic_value_word_return(callback, value) -> i64:
    callback(value)

fn dynamic_value_any_return(callback, value) -> Any:
    callback(value)

fn add_three(value: i64) -> i64:
    value + 3

fn add_half(value: f64) -> f64:
    value + 0.5

fn negate(value: bool) -> bool:
    not value

fn main() -> i64:
    val input = 5
    val shift = 3
    val direct = add_three(input)
    val callback = \value: value + shift
    val local = callback(input)
    print "callback control direct={direct} local={local} expected=8"
    val original = invoke_word(\value: value + shift, input)
    print "callback original unannotated={original} expected=8"
    val typed_value_tail = value_typed_tail(\value: value + shift, input)
    print "callback typed_value_only={typed_value_tail} expected=8"
    val declared_raw = declared_word_return(\value: value + shift, input)
    print "callback declared_return_raw_value={declared_raw} expected=8"
    val declared_dynamic = dynamic_value_word_return(\value: value + shift, input)
    print "callback declared_return_dynamic_value={declared_dynamic} expected=8"
    val any_dynamic = dynamic_value_any_return(\value: value + shift, input)
    print "callback dynamic_return_dynamic_value={any_dynamic} expected=8"
    val nil_identity = dynamic_value_any_return(\value: value, nil)
    val int_identity = dynamic_value_any_return(\value: value, 5)
    val float_identity = dynamic_value_any_return(\value: value, 2.5)
    val captured_constant = dynamic_value_any_return(\value: shift, nil)
    val nil_is_nil = nil_identity == nil
    val int_is_five = int_identity == 5
    val float_is_two_point_five = float_identity == 2.5
    val captured_is_three = captured_constant == 3
    val named_word = invoke_word(add_three, 5)
    val local_word_fn: fn(i64) -> i64 = add_three
    val local_word = invoke_word(local_word_fn, 5)
    val named_float = invoke_word(add_half, 2.5)
    val local_float_fn: fn(f64) -> f64 = add_half
    val local_float = invoke_word(local_float_fn, 2.5)
    val dynamic_float_add = invoke_word(\value: value + 0.5, 2.5)
    val dynamic_mixed_add = invoke_word(\value: value + shift, 2.5)
    val dynamic_text_add = invoke_word(\value: value + "!", "ok")
    val dynamic_wide_add = invoke_word(\value: value + 1, 1152921504606846975)
    val flag = true
    val captured_bool = invoke_word(\value: flag, nil)
    val named_bool = invoke_word(negate, true)
    val half_shift = 0.5
    val captured_float = invoke_word(\value: value + half_shift, 2.5)
    val text_wide = invoke_word(\value: "n=" + value, 1152921504606846976)
    val scalar_call = invoke_word(\value: add_three(value), 5)
    print "callback typed adapters named_word={named_word} local_word={local_word} named_float={named_float} local_float={local_float}"
    print "callback dynamic arithmetic float={dynamic_float_add} mixed={dynamic_mixed_add} text={dynamic_text_add} wide={dynamic_wide_add}"
    print "callback boolean captured={captured_bool} named={named_bool}"
    print "callback captured float={captured_float} expected=3.0"
    print "callback wide text={text_wide} scalar_call={scalar_call}"
    print "callback dynamic identities nil={nil_identity} int={int_identity} float={float_identity} captured={captured_constant}"
    print "callback dynamic identity checks nil={nil_is_nil} int={int_is_five} float={float_is_two_point_five} captured={captured_is_three}"
    if direct != 8 or local != 8: return 1
    if original != 8: return 2
    if typed_value_tail != 8: return 3
    if declared_raw != 8: return 4
    if declared_dynamic != 8: return 5
    if any_dynamic != 8: return 6
    if not nil_is_nil: return 7
    if not int_is_five: return 8
    if not float_is_two_point_five: return 9
    if not captured_is_three: return 10
    if named_word != 8: return 11
    if local_word != 8: return 12
    if named_float != 3.0: return 13
    if local_float != 3.0: return 14
    if dynamic_float_add != 3.0: return 15
    if dynamic_mixed_add != 5.5: return 16
    if dynamic_text_add != "ok!": return 17
    if dynamic_wide_add != 1152921504606846976: return 18
    if captured_bool != true: return 19
    if named_bool != false: return 20
    if captured_float != 3.0: return 21
    if text_wide != "n=1152921504606846976": return 22
    if scalar_call != 8: return 23
    print "inferred callback boundaries: 23 checks, 0 failures"
    0
