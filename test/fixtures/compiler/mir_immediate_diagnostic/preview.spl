# Narrow native fixture for the production formatter and flushed logging owner.
# It does not validate MirError transport, classification or range selection.
use compiler.driver.driver_mir_diagnostic_preview_v1.{driver_mir_diagnostic_field_v1, driver_mir_fatal_preview_v1}
use compiler.driver.driver_log_helpers.{log_error_flushed}

fn main() -> i64:
    if driver_mir_diagnostic_field_v1("a\nb\rc\td", 7) != "a?b?c?d": return 71
    if driver_mir_diagnostic_field_v1("abcdefgh", 4) != "abcd...": return 72
    if driver_mir_fatal_preview_v1("m", "p", "not a fatal", 0) != "": return 73
    val summary = driver_mir_fatal_preview_v1("fixture.provider", "fixture/provider.spl",
        "undefined variable: retained-before-later-module", 2)
    if not summary.contains("fatal_count=2"): return 74
    log_error_flushed(summary)
    var later_work: i64 = 0
    while later_work >= 0:
        later_work = later_work + 1
    75
