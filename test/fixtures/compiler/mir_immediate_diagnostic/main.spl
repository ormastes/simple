# Native retention fixture: its supervisor kills it after observing the summary.
# A normal process exit would flush stdio and would not test early visibility.
use compiler.mir.mir_lowering_types.{MirError}
use compiler.driver.driver_mir_error_owner.{driver_trace_module_mir_errors, driver_mir_fatal_summary_v1}

fn main() -> i64:
    val errors = [MirError(message: "older fatal", span: nil, fatal: true),
        MirError(message: "advisory", span: nil, fatal: false),
        MirError(message: "undefined variable: retained-before-later-module", span: nil, fatal: false),
        MirError(message: "second fatal", span: nil, fatal: true)]
    val summary = driver_mir_fatal_summary_v1("fixture.provider", "fixture/provider.spl", errors, 1)
    if not summary.contains("fatal_count=2") or summary.contains("older fatal"):
        return 71
    driver_trace_module_mir_errors("fixture.provider", "fixture/provider.spl", errors, 1)
    # Stand in for later module processing which never reaches aggregation.
    var later_work: i64 = 0
    while later_work >= 0:
        later_work = later_work + 1
    72
