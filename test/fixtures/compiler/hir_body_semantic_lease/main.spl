use compiler.driver.cache.hir_body_typecheck_lease_v1.*
use compiler.driver.cache.hir_body_semantic_lease_v1.*
use compiler.driver.hir_semantic_consumer_v1.*
use compiler.driver.hir_typecheck_consumer_v1.{collect_module_typecheck_receipt_v1}
use compiler.driver.driver_hir_cache.{hir_cache_header}
use compiler.driver.driver_safety_severity.{SafetyPassSeverity}
use compiler.driver.driver_types.{CompileContext}
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.common.assurance.policy_schema.{AssuranceStrictness}
use compiler.common.parallel_policy.policy_schema.{ResolvedParallelPolicyV1}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.common.config.{Logger}
use std.nogc_sync_mut.io_runtime.{file_read_nullable}
use std.env.{env_get}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end}

fn lower(path: text, name: text) -> HirModule:
    val parsed = parse_full_frontend(file_read_nullable(path) ?? "", path, name, Logger(level: 0))
    var lowering = HirLowering.with_filename(path)
    lowering.lower_parser_module_unstub(parsed, false)

fn input(path: text, name: text) -> HirBodyArchiveInputV1:
    HirBodyArchiveInputV1(source_path: path, module_name: name, is_entry: false,
        closure_digest: env_get("SIMPLE_HIR_LEASE_CLOSURE_DIGEST"),
        runtime_provider_digest: env_get("SIMPLE_HIR_LEASE_RUNTIME_PROVIDER_DIGEST"),
        runtime_provider_receipt_path: env_get("SIMPLE_HIR_LEASE_RUNTIME_PROVIDER_RECEIPT"),
        producer_header: hir_cache_header(), stage: "lowered-unresolved-v1")

fn main() -> i64:
    if hir_cache_header() == "" or env_get("SIMPLE_HIR_LEASE_CLOSURE_DIGEST").len() != 64 or
            env_get("SIMPLE_HIR_LEASE_RUNTIME_PROVIDER_DIGEST").len() != 64: return 1
    var checks = 1
    val path = "test/fixtures/compiler/hir_body_semantic_lease/findings.spl"
    val name = "hir_body_semantic_lease.findings"
    val bad = lower(path, name)
    val parallel = ResolvedParallelPolicyV1.for_assurance(AssuranceStrictness.Moderate)
    val deny = collect_module_safety_receipt_v1(name, bad, SafetyPassSeverity.Deny, parallel)
    if deny.errors.len() != 1 or not deny.messages[0].contains("inline-asm-outside-unsafe") or
            not deny.messages[0].contains(name): return 2
    checks = checks + 1
    val warn = collect_module_safety_receipt_v1(name, bad, SafetyPassSeverity.Warn, parallel)
    if warn.messages != deny.messages or warn.warnings != deny.errors or warn.errors.len() != 0: return 3
    checks = checks + 1
    val advisory = collect_module_safety_receipt_v1(name, bad, SafetyPassSeverity.Advisory, parallel)
    if advisory.messages != deny.messages or advisory.warnings.len() != 0 or advisory.errors.len() != 0: return 4
    checks = checks + 1
    val any_deny = collect_module_any_escape_receipt_v1(name, bad, AssuranceStrictness.Critical)
    if any_deny.errors.len() == 0 or not any_deny.errors.join("\n").contains("E-MC-ANY-001") or
            not any_deny.errors.join("\n").contains("erased_value"): return 5
    checks = checks + 1
    val any_warn = collect_module_any_escape_receipt_v1(name, bad, AssuranceStrictness.Moderate)
    if any_warn.messages != any_deny.messages or any_warn.warnings != any_deny.errors or any_warn.errors.len() != 0: return 6
    checks = checks + 1
    val enum_deny = collect_module_enum_contract_receipt_v1(name, bad, AssuranceStrictness.Critical)
    if enum_deny.errors.len() != 1 or not enum_deny.errors[0].contains("E-CLOSED-002") or
            not enum_deny.errors[0].contains("First / Second = 1"): return 7
    checks = checks + 1
    val enum_warn = collect_module_enum_contract_receipt_v1(name, bad, AssuranceStrictness.Moderate)
    if enum_warn.messages != enum_deny.messages or enum_warn.warnings != enum_deny.errors or enum_warn.errors.len() != 0: return 8
    checks = checks + 1
    val clean_path = "test/fixtures/compiler/hir_body_semantic_lease/clean.spl"
    val clean_name = "hir_body_semantic_lease.clean"
    val clean = lower(clean_path, clean_name)
    if collect_module_safety_receipt_v1(clean_name, clean, SafetyPassSeverity.Deny, parallel).messages.len() != 0 or
            collect_module_any_escape_receipt_v1(clean_name, clean, AssuranceStrictness.Critical).messages.len() != 0 or
            collect_module_enum_contract_receipt_v1(clean_name, clean, AssuranceStrictness.Critical).messages.len() != 0: return 9
    checks = checks + 1
    val bad_input = input(path, name)
    val second_path = "test/fixtures/compiler/hir_body_semantic_lease/findings_second.spl"
    val second_name = "hir_body_semantic_lease.findings_second"
    val second = lower(second_path, second_name)
    val second_input = input(second_path, second_name)
    val bad_store = hir_body_archive_store_v1(bad_input, bad, ["lowered warning"])
    val second_store = hir_body_archive_store_v1(second_input, second, [])
    if bad_store.is_err() or second_store.is_err(): return 10
    checks = checks + 1
    val archives = [bad_store.unwrap(), second_store.unwrap()]
    val ctx = CompileContext.create(driver_core_compile_options_default())
    val policy = hir_body_semantic_policy_v1(ctx.assurance_policy.strictness)
    if not policy.typecheck_enabled or not policy.safety_enabled: return 11
    val bad_lease = hir_body_archive_semantic_lease_v1(archives[0], bad_input, ctx.assurance_policy.strictness)
    val second_lease = hir_body_archive_semantic_lease_v1(archives[1], second_input, ctx.assurance_policy.strictness)
    if bad_lease.is_err() or second_lease.is_err(): return 12
    checks = checks + 1
    val retained = bad_lease.unwrap()
    val tc = collect_module_typecheck_receipt_v1(name, bad, policy.typecheck)
    if tc.errors.len() == 0 or retained.typecheck.messages != tc.messages or
            retained.typecheck.warnings != tc.warnings or retained.typecheck.errors != tc.errors: return 13
    checks = checks + 1
    if retained.safety.messages != deny.messages or retained.any_escape.messages != any_warn.messages or
            retained.enum_contract.messages != enum_warn.messages or retained.lowering_warnings != ["lowered warning"] or
            retained.functions_checked != 3 or transient_array_scope_state_v1() != 0: return 14
    checks = checks + 1
    if not transient_scope_begin(): return 15
    if not hir_body_archive_semantic_lease_v1(archives[0], bad_input, ctx.assurance_policy.strictness).is_err() or
            transient_array_scope_state_v1() != 1: return 16
    if not transient_scope_pause(): return 17
    if not hir_body_archive_semantic_lease_v1(archives[0], bad_input, ctx.assurance_policy.strictness).is_err() or
            transient_array_scope_state_v1() != 2 or not transient_scope_end(): return 18
    checks = checks + 1
    val refused_ctx = CompileContext.create(driver_core_compile_options_default())
    var wrong_stage = bad_input
    wrong_stage.stage = "mono-final-module-v1"
    val refused_stage = hir_body_archive_semantic_lease_v1(archives[0], wrong_stage, ctx.assurance_policy.strictness)
    if refused_stage.is_ok() or not refused_stage.unwrap_err().contains("identity mismatch") or
            transient_array_scope_state_v1() != 0: return 24
    checks = checks + 1
    val replayed = hir_body_archive_semantic_lease_v1(archives[0], bad_input, ctx.assurance_policy.strictness)
    if replayed.is_err() or replayed.unwrap().typecheck.messages != retained.typecheck.messages or
            replayed.unwrap().enum_contract.messages != retained.enum_contract.messages: return 25
    checks = checks + 1
    if not hir_body_semantic_publish_pass_major_v1(refused_ctx, archives, [second_lease.unwrap(), retained]).is_err() or
            refused_ctx.errors.len() != 0 or refused_ctx.warnings.len() != 0: return 19
    checks = checks + 1
    val edited_ctx = CompileContext.create(driver_core_compile_options_default())
    var edited = retained
    var edited_typecheck = retained.typecheck
    edited_typecheck.errors = []
    edited.typecheck = edited_typecheck
    var edited_any = retained.any_escape
    edited_any.errors = []
    edited_any.warnings = []
    edited.any_escape = edited_any
    if not hir_body_semantic_publish_pass_major_v1(edited_ctx, archives, [edited, second_lease.unwrap()]).is_err() or
            edited_ctx.errors.len() != 0 or edited_ctx.warnings.len() != 0: return 26
    checks = checks + 1
    val forged_ctx = CompileContext.create(driver_core_compile_options_default())
    var empty = retained.typecheck
    empty.messages = []
    empty.warnings = []
    empty.errors = []
    var forged = HirBodySemanticReceiptV1(module_name: retained.module_name,
        archive_key: retained.archive_key, body_digest: retained.body_digest,
        policy_key: retained.policy_key, typecheck: empty, safety: empty,
        any_escape: empty, enum_contract: empty, lowering_warnings: retained.lowering_warnings,
        functions_checked: retained.functions_checked)
    forged.capture_digest = hir_body_semantic_receipt_digest_v1(forged)
    if not hir_body_semantic_publish_pass_major_v1(forged_ctx, archives, [forged, second_lease.unwrap()]).is_err() or
            forged_ctx.errors.len() != 0 or forged_ctx.warnings.len() != 0 or
            transient_array_scope_state_v1() != 0: return 27
    checks = checks + 1
    val published = hir_body_semantic_publish_pass_major_v1(ctx, archives, [retained, second_lease.unwrap()])
    if published.is_err(): return 20
    var expected_messages: [text] = []
    for r in [retained.typecheck, second_lease.unwrap().typecheck, retained.safety,
            second_lease.unwrap().safety, retained.any_escape, second_lease.unwrap().any_escape,
            retained.enum_contract, second_lease.unwrap().enum_contract]:
        for message in r.messages: expected_messages.push(message)
    if published.unwrap() != expected_messages: return 21
    checks = checks + 1
    val expected_errors = retained.typecheck.errors.len() + retained.safety.errors.len() +
        retained.any_escape.errors.len() + retained.enum_contract.errors.len() +
        second_lease.unwrap().typecheck.errors.len() + second_lease.unwrap().safety.errors.len() +
        second_lease.unwrap().any_escape.errors.len() + second_lease.unwrap().enum_contract.errors.len()
    if ctx.errors.len() != expected_errors: return 22
    checks = checks + 1
    if checks != 21: return 23
    print "HIR body semantic lease: {checks} checks passed"
    0
