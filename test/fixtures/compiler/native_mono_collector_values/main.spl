# Native semantic oracle; no compiler-internal dictionary mock.
# G1 port excludes the separate unported class-static template feature.
fn identity<T>(value: T) -> T:
    value

class Box<T>:
    value: T

impl Box<T>:
    fn read() -> T:
        self.value

fn ordinary() -> i64:
    9

fn main() -> i64:
    if identity(41) != 41: return 11
    if identity("retained") != "retained": return 12
    val box = Box<i64>(value: 17)
    if box.read() != 17: return 13
    if ordinary() != 9: return 15
    print "PASS generic collector standalone owner ordinary"
    0
