use left.maybe_left
use right.maybe_right

fn main() -> i64:
    val left_value = match maybe_left():
        case Some(record): record.value
        case nil: 0
    val right_value = match maybe_right():
        case Some(record): record.value
        case nil: 0
    if left_value != 42 or right_value != 7:
        return 1
    print 42
    0
