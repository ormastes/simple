# Isolate the RTI bind -> Result payload -> (bool, Optional<Record>) path
# without imported declarations. Both paths must preserve the enum payload.
struct Payload:
    value: i64

enum TypeShape:
    Scalar
    Optional(Payload)

struct BoundType:
    kind: TypeShape

fn bind_type() -> Result<BoundType, text>:
    Ok(BoundType(kind: TypeShape.Optional(Payload(value: 42))))

fn query_type() -> (bool, BoundType?):
    match bind_type():
        case Ok(bound): return (true, Some(bound))
        case Err(_): return (false, nil)

fn main() -> i64:
    match bind_type():
        case Ok(direct):
            match direct.kind:
                case TypeShape.Optional(payload):
                    if payload.value != 42: return 1
                    print "direct={payload.value}"
                case _: return 2
        case Err(_): return 3
    val (answered, optional_bound) = query_type()
    if not answered: return 4
    match optional_bound:
        case Some(bound):
            match bound.kind:
                case TypeShape.Optional(payload):
                    if payload.value != 42: return 5
                    print "tuple={payload.value}"
                case _: return 6
        case nil: return 7
    0
