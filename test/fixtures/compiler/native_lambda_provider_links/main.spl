# Expected exit0 and native-provider-lambda-links-ok.
# Import alias plus local callback/value shadowing pin lexical precedence.
use .provider.{invoke, imported_value as provider_value}

fn make_nested() -> fn() -> i64:
    \:
        invoke(\: provider_value())

fn make_shadowed_callback() -> fn() -> i64:
    val provider_value = \: 11
    \:
        invoke(provider_value)

fn make_shadowed_value() -> fn() -> i64:
    val provider_value = 13
    \: provider_value

fn main() -> i64:
    if invoke(\: provider_value()) != 7:
        return 1
    val nested = make_nested()
    if nested() != 7:
        return 2
    val local_callback = make_shadowed_callback()
    if local_callback() != 11:
        return 3
    val local_value = make_shadowed_value()
    if local_value() != 13:
        return 4
    print "native-provider-lambda-links-ok"
    0
