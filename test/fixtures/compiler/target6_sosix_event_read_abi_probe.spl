use std.nogc_async_mut.sosix.host_facade.{sosix_file_read_regular_no_follow_bounded}
use std.scv.compile_source_inventory_core.{
    compile_source_inventory_git_event_v1,
    compile_source_inventory_digest_valid_v1
}

fn main() -> i64:
    val source = "src/app/compiler_entrypoint/inventory_scratch.spl"
    val content = match sosix_file_read_regular_no_follow_bounded(
        source, 1073741824):
        case Err(_):
            print "SOSIX_EVENT_READ_FAILED"
            return 1
        case Ok(value): value
    if content.len() <= 0:
        print "SOSIX_EVENT_CONTENT_LENGTH_INVALID {content.len()}"
        return 2
    val event = compile_source_inventory_git_event_v1("upsert", source, content)
    if event.byte_count != content.len():
        print "SOSIX_EVENT_BYTE_COUNT_MISMATCH {content.len()} {event.byte_count}"
        return 3
    if (not compile_source_inventory_digest_valid_v1(event.content_digest) or
            not compile_source_inventory_digest_valid_v1(event.semantic_digest) or
            not compile_source_inventory_digest_valid_v1(event.export_digest) or
            not compile_source_inventory_digest_valid_v1(event.initializer_digest) or
            not compile_source_inventory_digest_valid_v1(event.provider_digest)):
        print "SOSIX_EVENT_DIGEST_INVALID"
        return 4
    print "PASS target6_sosix_event_read_abi_probe {event.byte_count}"
    0
