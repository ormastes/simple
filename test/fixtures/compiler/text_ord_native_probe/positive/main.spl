class CustomOrd:
    marker: i64
    fn ord() -> i64:
        return self.marker

fn main() -> i64:
    print "A".ord()
    print "é".ord()
    print "".ord()
    print "AB".ord()
    print "🙂x".ord()
    val joined = "é" + "B"
    print joined.ord()
    var total = 0
    for ch in "Aé":
        total = total + ch.ord()
    print total
    val custom = CustomOrd(marker: 77)
    print custom.ord()
    return 0
