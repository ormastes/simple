use os.compositor.arm64_virtio_input_backend.{Arm64VirtioInputBackend}
use os.compositor.input_backend.{InputBackend}
use os.drivers.virtio.virtio_input_ops.{
    BTN_LEFT,
    EV_KEY,
    EV_REL,
    EV_SYN,
    KEY_VALUE_PRESS,
    REL_X,
    REL_Y,
    SYN_REPORT
}
use os.kernel.arch.arm64.virtio_input.{ARM64_VIRTIO_INPUT_DEVICE_POINTER}

fn poll_mouse_coordinates(input: InputBackend) -> i64:
    if val mouse = input.poll_mouse():
        return mouse.x * 1000 + mouse.y
    -1

fn main() -> i64:
    var backend = Arm64VirtioInputBackend.create(640, 480)
    backend.feed_raw_event(ARM64_VIRTIO_INPUT_DEVICE_POINTER, EV_REL, REL_X, 5u32)
    backend.feed_raw_event(ARM64_VIRTIO_INPUT_DEVICE_POINTER, EV_REL, REL_Y, 4294967294u32)
    backend.feed_raw_event(ARM64_VIRTIO_INPUT_DEVICE_POINTER, EV_KEY, BTN_LEFT, KEY_VALUE_PRESS)
    backend.feed_raw_event(ARM64_VIRTIO_INPUT_DEVICE_POINTER, EV_SYN, SYN_REPORT, 0u32)
    print(poll_mouse_coordinates(backend))
    print(backend.delivered_mouse_sequence)
    print(backend.delivered_pointer_rel_x)
    print(backend.delivered_pointer_rel_y)
    print(backend.delivered_pointer_left_edge)
    print(backend.delivered_pointer_left_value)
    print(backend.delivered_pointer_type)
    0
