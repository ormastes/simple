val FOREIGN_SHIFT: i64 = 7

fn add_three(value: i64) -> i64:
    value + 3

val RUNTIME_SHIFT: i64 = add_three(4)

fn with_runtime_global(base: i64, callback: fn(i64) -> i64 = \value: value + base + RUNTIME_SHIFT) -> i64:
    callback(5)

fn with_nested_default(base: i64, callback: fn(i64) -> i64 = \value: cascade(base) + value) -> i64:
    callback(5)

fn apply(value: i64, callback: fn(i64) -> i64) -> i64:
    callback(value)

fn with_child_lift(base: i64, callback: fn(i64) -> i64 = \value: apply(value, \inner: inner + base + FOREIGN_SHIFT)) -> i64:
    callback(5)

fn with_lambda(base: i64, callback: fn(i64) -> i64 = \value: value + base + FOREIGN_SHIFT) -> i64:
    callback(5)

fn cascade(base: i64, extra: i64 = base + FOREIGN_SHIFT, result: i64 = extra * 2) -> i64:
    result

fn with_named(callback: fn(i64) -> i64 = add_three) -> i64:
    callback(5)

fn with_block(base: i64, callback: fn(i64) -> i64 = \value:
        val shadow = base + FOREIGN_SHIFT
        val inner = \input: input + shadow
        inner(value)
) -> i64:
    callback(5)

fn text_default(prefix: text, suffix: text = prefix + "!") -> text:
    suffix

class DefaultCallableHolder:
    callback: fn(i64) -> i64

fn with_callable_field(holder: DefaultCallableHolder, callback: fn(i64) -> i64 = \value: holder.callback(value)) -> i64:
    callback(5)

trait DefaultShiftOwner:
    me shift(value: i64) -> i64

class DefaultAddOwner:
    bias: i64

impl DefaultShiftOwner for DefaultAddOwner:
    me shift(value: i64) -> i64:
        self.bias + value

class DefaultMultiplyOwner:
    factor: i64

impl DefaultShiftOwner for DefaultMultiplyOwner:
    me shift(value: i64) -> i64:
        self.factor * value

fn with_trait_owner(owner: DefaultShiftOwner, callback: fn(i64) -> i64 = \value: owner.shift(value)) -> i64:
    callback(5)

fn float_default(callback: fn(f64) -> f64 = \value: value + 0.5) -> f64:
    callback(2.5)

var UNIT_COUNTER: i64 = 0

fn record_default_effect(value: i64) -> ():
    UNIT_COUNTER = UNIT_COUNTER + value

fn unit_default(callback: fn(i64) -> () = \value: record_default_effect(value)) -> i64:
    callback(5)
    UNIT_COUNTER

class DefaultInitializedCallableHolder:
    callback: fn(i64) -> i64 = \value: value + FOREIGN_SHIFT
