struct InlineLexerProbe:
    value: i64
    fn char_at_pos(pos: i64) -> i64:
        self.value + pos
    fn char_slice(start: i64, end: i64) -> i64:
        self.value + end - start
    me enable_forced_indentation():
        self.value = self.value + 10
    me disable_forced_indentation():
        self.value = self.value - 10
    me pop_indent():
        self.value = self.value - 1

struct NoMethods:
    value: i64
