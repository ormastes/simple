use compiler.frontend.core.lexer_struct.{CoreLexer, make_core_lexer, core_lexer_char_at_pos, core_lexer_char_slice, core_lexer_enable_forced_indentation, core_lexer_disable_forced_indentation, core_lexer_pop_indent}

fn main() -> i64:
    var lexer: CoreLexer = make_core_lexer("AéZ")
    if core_lexer_char_at_pos(lexer, 1) != "é": return 1
    if core_lexer_char_slice(lexer, 1, 3) != "éZ": return 2
    if core_lexer_char_at_pos(lexer, -1) != "": return 3
    val original: CoreLexer = lexer
    lexer = core_lexer_enable_forced_indentation(lexer)
    if lexer.force_indent_bracket_depths.len() != 1: return 4
    if original.force_indent_bracket_depths.len() != 0: return 9
    lexer = core_lexer_disable_forced_indentation(lexer)
    if lexer.force_indent_bracket_depths.len() != 0: return 5
    lexer = core_lexer_disable_forced_indentation(lexer)
    if lexer.force_indent_bracket_depths.len() != 0: return 6
    lexer = core_lexer_pop_indent(lexer)
    if lexer.indent_stack.len() != 1: return 7
    lexer.indent_stack.push(4)
    val before_pop: CoreLexer = lexer
    lexer = core_lexer_pop_indent(lexer)
    if lexer.indent_stack.len() != 1: return 8
    if before_pop.indent_stack.len() != 2: return 10
    lexer = core_lexer_pop_indent(lexer)
    if lexer.indent_stack.len() != 1: return 11
    if core_lexer_char_slice(lexer, 0, 3) != "AéZ": return 12
    print "PASS lexer-owner-wrappers 12 checks"
    0
