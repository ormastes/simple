use provider.{InlineLexerProbe}

fn main() -> i64:
    var lexer: InlineLexerProbe = InlineLexerProbe(value: 7)
    if lexer.char_at_pos(2) != 9: return 1
    if lexer.char_slice(2, 5) != 10: return 2
    val original: InlineLexerProbe = lexer
    lexer.enable_forced_indentation()
    if lexer.value != 17: return 3
    lexer.disable_forced_indentation()
    if lexer.value != 7: return 4
    lexer.pop_indent()
    if lexer.value != 6: return 5
    if original.value != 7: return 6
    print "PASS imported-inline-methods 6 checks"
    0
