# Native regression: field container identity must not become element identity.
# Compile with the produced pure compiler; interpreter success is insufficient.
class ArrayFields:
    texts: [text]
    integers: [i64]
    flags: [bool]
    reals: [f64]
    nested: [[text]]

    fn inferred_text() -> text:
        val value = self.texts[0]
        value

    fn annotated_text() -> text:
        val value: text = self.texts[0]
        value

    fn dictionary_key() -> text:
        val values: Dict<text, text> = {"alpha": "matched"}
        val key = self.texts[0]
        values[key]

    fn nested_copy_is_independent() -> bool:
        var row = self.nested[0]
        row[0] = "changed"
        row[0] == "changed" and self.nested[0][0] == "nested"

fn from_argument(values: [text]) -> text:
    values[0]

fn main() -> i64:
    val local: [text] = ["alpha"]
    val fields = ArrayFields(
        texts: ["alpha"], integers: [42], flags: [true], reals: [1.25],
        nested: [["nested"]])
    if local[0] != "alpha" or from_argument(local) != "alpha":
        print("FAIL local or argument text")
        return 1
    if fields.inferred_text() != "alpha" or fields.annotated_text() != "alpha":
        print("FAIL class field text")
        return 2
    if fields.texts[0] != "alpha" or fields.dictionary_key() != "matched":
        print("FAIL field text or dictionary key")
        return 3
    if fields.integers[0] != 42 or fields.flags[0] != true or fields.reals[0] != 1.25:
        print("FAIL scalar field element")
        return 4
    if fields.nested[0][0] != "nested" or not fields.nested_copy_is_independent():
        print("FAIL nested array value copy")
        return 5
    print("PASS class field array elements and nested value copy")
    0
