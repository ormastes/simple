use test.fixtures.compiler.native_imported_struct_inequality.plain_provider.{ImportedModulo as PlainRecord}

pub struct ImportedModulo:
    value: i64
    marker: i64

impl ImportedModulo:
    fn __eq__(other: ImportedModulo) -> bool:
        self.value % 10 == other.value % 10

    fn __add__(other: i64) -> ImportedModulo:
        ImportedModulo(value: self.value + other, marker: self.marker)

    fn __sub__(other: i64) -> PlainRecord:
        PlainRecord(prefix: self.value + other, value: other, marker: self.marker + 1)
