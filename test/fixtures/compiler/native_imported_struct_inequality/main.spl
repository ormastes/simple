fn plain_same(a: PlainRecord, b: PlainRecord) -> bool:
    a == b

fn plain_different(a: PlainRecord, b: PlainRecord) -> bool:
    a != b

fn same(a: ImportedModulo, b: ImportedModulo) -> bool:
    a == b

fn different(a: ImportedModulo, b: ImportedModulo) -> bool:
    a != b

fn square(value: i64) -> i64:
    value * value

fn main() -> i64:
    val left = ImportedModulo(value: 1, marker: 77)
    val equal = ImportedModulo(value: 11, marker: 88)
    val unequal = ImportedModulo(value: 2, marker: 99)
    if not same(left, equal): return 10
    if different(left, equal): return 11
    if same(left, unequal): return 12
    if not different(left, unequal): return 13
    val records: [ImportedModulo] = [left, equal, unequal]
    if records[0] != records[1]: return 14
    if records[0] == records[2]: return 15
    if square(3) != 9: return 16
    val sum = left + 20
    if sum.value != 21 or sum.marker != 77: return 17
    val plain = PlainRecord(prefix: 17, value: 1, marker: 55)
    val plain_equal = PlainRecord(prefix: 17, value: 1, marker: 55)
    val plain_other_value = PlainRecord(prefix: 17, value: 11, marker: 55)
    val plain_other_marker = PlainRecord(prefix: 17, value: 1, marker: 66)
    val plain_other_prefix = PlainRecord(prefix: 18, value: 1, marker: 55)
    if plain.prefix != 17 or plain.value != 1 or plain.marker != 55: return 28
    if plain_other_prefix.prefix != 18 or plain_other_prefix.value != 1 or plain_other_prefix.marker != 55: return 29
    val literal_plain = PlainRecord{marker: 55, value: 1, prefix: 17}
    if literal_plain.prefix != 17 or literal_plain.value != 1 or literal_plain.marker != 55: return 30
    if not plain_same(plain, literal_plain): return 31
    if not plain_same(plain, plain_equal): return 18
    if plain_different(plain, plain_equal): return 19
    if plain_same(plain, plain_other_value): return 20
    if not plain_different(plain, plain_other_value): return 21
    if plain_same(plain, plain_other_marker): return 22
    if plain_same(plain, plain_other_prefix): return 23
    val plain_records: [PlainRecord] = [plain, plain_equal, plain_other_value, plain_other_marker, plain_other_prefix]
    if plain_records[0] != plain_records[1]: return 24
    if plain_records[0] == plain_records[2]: return 25
    if plain_records[0] == plain_records[3]: return 26
    if plain_records[0] == plain_records[4]: return 27
    print "IMPORTED_STRUCT_INEQUALITY_NATIVE: PASS"
    0
