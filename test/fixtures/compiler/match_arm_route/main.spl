# Rebuild with the candidate compiler on both backends. This checks native
# dispatch; the companion MIR spec checks the compiler code and diagnostics.
enum Choice:
    First
    Number(i64)
    Second

fn qualified(value: Choice) -> i64:
    match value:
        case Choice.First: 11
        case rest: 29

fn bare(value: Choice) -> i64:
    match value:
        case First: 11
        case rest: 29

fn mixed(value: Choice) -> i64:
    match value:
        case Choice.Number(number): number
        case First: 11
        case rest: 29

fn integer(value: i64) -> i64:
    match value:
        case 1: 11
        case rest: rest + 10

fn check(name: text, actual: i64, expected: i64) -> i64:
    if actual == expected:
        print "PASS match-arm-route {name}"
        return 0
    print "FAIL match-arm-route {name}: {actual} != {expected}"
    1

fn main() -> i64:
    var failed = 0
    failed = failed + check("qualified-first", qualified(Choice.First), 11)
    failed = failed + check("qualified-fallback", qualified(Choice.Second), 29)
    failed = failed + check("bare-first", bare(Choice.First), 11)
    failed = failed + check("bare-fallback", bare(Choice.Second), 29)
    failed = failed + check("mixed-payload", mixed(Choice.Number(47)), 47)
    failed = failed + check("mixed-first", mixed(Choice.First), 11)
    failed = failed + check("mixed-fallback", mixed(Choice.Second), 29)
    failed = failed + check("integer-literal", integer(1), 11)
    failed = failed + check("integer-binding", integer(7), 17)
    print "match-arm-route checks=9 failed={failed}"
    failed
