pub trait Marker:
    fn mark() -> i64
    fn inherited() -> i64: self.mark() + 1
    static fn zero() -> i64: 0

trait Other:
    fn mark() -> i64
    fn inherited() -> i64: 2000

pub type Narrow = i16

impl Marker for Narrow:
    fn mark() -> i64: 1016

impl Marker for i32:
    fn mark(self) -> i64: 1032

impl Marker for i64:
    fn mark() -> i64: 1064

impl Marker for text:
    fn mark() -> i64: 1001

impl i64:
    fn inherited() -> i64: 2070

impl i16:
    fn inherited() -> i64: 2016

impl Other for i32:
    fn mark() -> i64: 2032
    fn inherited() -> i64: 2033

pub struct Control:
    value: i64

impl Marker for Control:
    fn mark() -> i64: self.value + 5000

fn free_control(value: i64) -> i64: value + 1
