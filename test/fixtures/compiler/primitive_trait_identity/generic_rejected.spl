# Scalar MIR admission currently rejects generic trait arguments. Two concrete
# instantiations must fail compilation, never select whichever body was last.
trait GenericMarker<T>:
    fn mark() -> i64

impl GenericMarker<i32> for i64:
    fn mark() -> i64: 3032

impl GenericMarker<i64> for i64:
    fn mark() -> i64: 3064

fn main() -> i32:
    val value: i64 = 7
    print(value.mark())
    print("GENERIC_TRAIT_WRONGLY_EXECUTED")
    0
