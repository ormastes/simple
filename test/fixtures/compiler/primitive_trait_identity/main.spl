# Only the selected trait is visible. The provider also implements Other.mark
# for i32, which must retain a distinct body without stealing this call.
use provider.{Marker as SelectedMarker, Control, Narrow}

fn main() -> i32:
    val narrow: i32 = 5
    val wide: i64 = 5
    if narrow.mark() != 1032: return 1
    if wide.mark() != 1064: return 2
    if "x".mark() != 1001: return 3
    if wide.inherited() != 2070: return 4
    if Control(value: 7).mark() != 5007: return 5
    val alias_value: Narrow = 5
    if alias_value.mark() != 1016: return 6
    if alias_value.inherited() != 2016: return 7
    if "x".inherited() != 1002: return 8
    print("PRIMITIVE_TRAIT_IDENTITY_OK")
    0
