fn default_value() -> i64:
    33

pub class Leaf:
    padding: i64 = 90
    value: i64 = 17

pub class Cell:
    padding: i64 = 22
    right: i64 = default_value()
    child: Leaf = Leaf()
    static fn tag() -> i64:
        202
    fn value(self) -> i64:
        self.right

impl Cell:
    fn child_value(self) -> i64:
        self.child.value
    static fn from_default() -> Self:
        Cell()

pub fn make_right() -> Cell:
    Cell()
