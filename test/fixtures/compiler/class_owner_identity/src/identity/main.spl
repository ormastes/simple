use identity.facade.{LeftCell, RightCell, make_left, make_right, helper_main}

@global
fn class_owner_identity_abi_guard() -> i64:
    1

extern fn class_owner_identity_extern_guard(value: i64) -> i64

fn local_probe() -> i64:
    73

export fn class_owner_identity_main() -> i64:
    LeftCell.tag() * 1000000 + RightCell.tag() * 10000 + LeftCell().value() * 1000 + RightCell().value() * 100 + make_left().value() * 10 + make_right().value()

fn main() -> i64:
    assert(class_owner_identity_main() == 103034443)
    assert(LeftCell.from_default().child_value() == 7)
    assert(RightCell.from_default().child_value() == 17)
    assert(LeftCell(left: 41).value() == 41)
    assert(RightCell(right: 51).value() == 51)
    assert(class_owner_identity_abi_guard() == 1)
    assert(helper_main() == 404)
    val provider_value = helper_main
    val local_value = local_probe
    assert(provider_value() == 404)
    assert(local_value() == 73)
    var values: [i64] = []
    values = values.push(73)
    assert(values[0] == 73)
    0
