fn default_value() -> i64:
    11

pub fn main() -> i64:
    404

pub class Leaf:
    value: i64 = 7

pub class Cell:
    left: i64 = default_value()
    child: Leaf = Leaf()
    static fn tag() -> i64:
        101
    fn value(self) -> i64:
        self.left

impl Cell:
    fn child_value(self) -> i64:
        self.child.value
    static fn from_default() -> Self:
        Cell()

pub fn make_left() -> Cell:
    Cell()
