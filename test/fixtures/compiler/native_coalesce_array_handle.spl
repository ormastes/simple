# Native regression: ?? must retain array handles and element types.
extern fn rt_cli_get_args() -> [text]

fn supplied() -> [text]?:
    Some(["kept", "second"])

fn absent() -> [text]?:
    nil

fn forbidden_default() -> [text]:
    print "FAIL evaluated present-array default"
    ["wrong"]

fn main() -> i64:
    var failures = 0
    val process_args = rt_cli_get_args() ?? []
    if process_args.len() < 2:
        print "FAIL process argument array"
        failures = failures + 1
    val present = supplied() ?? forbidden_default()
    if present.len() != 2:
        print "FAIL present array length"
        failures = failures + 1
    elif present[0] != "kept":
        print "FAIL present array element"
        failures = failures + 1
    val fallback = absent() ?? ["fallback"]
    if fallback.len() != 1:
        print "FAIL default array length"
        failures = failures + 1
    elif fallback[0] != "fallback":
        print "FAIL default array element"
        failures = failures + 1
    if failures == 0: print "PASS coalesced native arrays"
    failures
