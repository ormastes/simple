use compiler.common.attributes.{OptimizationReq, OptimizationReqLevel, OptimizationBackend}

fn main() -> i64:
    val requirement = OptimizationReq(level: OptimizationReqLevel.Must, backend: OptimizationBackend.Simd)
    match requirement.level:
        case Must: ()
        case _: return 1
    match requirement.backend:
        case Simd: ()
        case _: return 2
    print "PASS optimization attribute exports"
    0
