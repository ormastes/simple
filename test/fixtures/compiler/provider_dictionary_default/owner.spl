# Provider relocation must preserve dictionary field defaults whose HIR key type is nil.
pub class DefaultDictionaryOwner:
    empty: Dict<text, i64> = {}
    populated: Dict<text, i64> = {"answer": 42}

    fn default_empty_size() -> i64:
        self.empty.len()

    fn default_answer() -> i64:
        self.populated.get("answer") ?? -1
