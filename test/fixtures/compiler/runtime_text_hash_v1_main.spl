# Direct native-link regression: the imported owner must provide the symbol.
# Same known answers as the SSpec; no test-runner/provider dependency.
use std.common.hash.runtime_text.{runtime_text_hash_v1}

fn main() -> i64:
    if runtime_text_hash_v1("") != -3750763034362895579:
        return 1
    if runtime_text_hash_v1("a") != -5808556873153909620:
        return 2
    if runtime_text_hash_v1("abc") != -1792535898324117685:
        return 3
    if runtime_text_hash_v1("hello") != -6615550055289275125:
        return 4
    if runtime_text_hash_v1("héllo") != -6674344407707008800:
        return 5
    if runtime_text_hash_v1("日本語") != -1252314375984451705:
        return 6
    if runtime_text_hash_v1("🎉") != -51012698996789463:
        return 7
    if runtime_text_hash_v1("a\0b") != -1886276961191958862:
        return 8
    if runtime_text_hash_v1("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx") != 9038906031697053191:
        return 9
    if runtime_text_hash_v1("ab") == runtime_text_hash_v1("ba"):
        return 10
    return 0
