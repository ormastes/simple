# Exercise production extraction and the existing SHB runtime hash owner.
use compiler.shb.shb_extractor.{extract_symbol_hashes}
use compiler.shb.shb_hash.{shb_source_hash}

fn main() -> i64:
    val source = "fn alpha() -> i64:\n    7\nfn beta() -> i64:\n    9"
    val hashes = extract_symbol_hashes(source)
    if hashes.len() != 2: return 1
    if hashes["alpha"] != shb_source_hash("fn alpha() -> i64:\n7").to_text(): return 2
    if hashes["beta"] != shb_source_hash("fn beta() -> i64:\n9").to_text(): return 3
    val changed = extract_symbol_hashes(source.replace("    7", "    8"))
    if changed["alpha"] == hashes["alpha"]: return 4
    if changed["beta"] != hashes["beta"]: return 5
    val commented = extract_symbol_hashes(source.replace("    7", "    # ignored\n    7"))
    if commented["alpha"] != hashes["alpha"]: return 6
    if commented["beta"] != hashes["beta"]: return 7
    0
