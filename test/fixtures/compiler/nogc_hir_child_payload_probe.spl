"""Focused native diagnostic for HIR child-frame payload typing.

The four constructors differ only in how their HirExpr argument is obtained.
Enable SIMPLE_ENUM_PAYLOAD_TRACE=1 on the producer to compare declared,
remembered and source types at these independent constructor sites. This is
not a substitute for compiler or ownership acceptance tests.
"""
use std.nogc_sync_mut.io_runtime.{exit}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind}
use compiler.hir.hir_types.{HirType, HirTypeKind}
use compiler.hir.generated.hir_children.{HirChildFrame}

fn child_payload_require(condition: bool, message: text):
    if not condition:
        print "nogc-hir-child-payload FAILED: {message}"
        exit(1)

fn child_payload_sample() -> HirExpr:
    val span = Span.empty()
    val type_ = HirType(kind: HirTypeKind.Int(64, true), span: span)
    HirExpr(kind: HirExprKind.IntLit(73, None), has_type_: true,
        type_: type_, span: span)

fn child_from_direct_parameter(node: HirExpr) -> HirChildFrame:
    HirChildFrame.Expr(node)

fn child_from_typed_array(nodes: [HirExpr]) -> HirChildFrame:
    child_payload_require(nodes.len() == 1, "typed-array control requires one element")
    HirChildFrame.Expr(nodes[0])

fn child_from_arraylit_payload(node: HirExpr) -> HirChildFrame:
    match node.kind:
        case HirExprKind.ArrayLit(elements, _):
            child_payload_require(elements.len() == 1, "destructured-array control requires one element")
            return HirChildFrame.Expr(elements[0])
        case _:
            child_payload_require(false, "destructured-array control received a different expression")
    child_from_direct_parameter(node)

fn child_from_rebound_arraylit_payload(node: HirExpr) -> HirChildFrame:
    match node.kind:
        case HirExprKind.ArrayLit(elements, _):
            child_payload_require(elements.len() == 1, "rebound-array control requires one element")
            val element: HirExpr = elements[0]
            return HirChildFrame.Expr(element)
        case _:
            child_payload_require(false, "rebound-array control received a different expression")
    child_from_direct_parameter(node)

fn children_from_tuple_array(nodes: [(HirExpr, HirExpr)]) -> [HirChildFrame]:
    child_payload_require(nodes.len() == 1, "tuple-array control requires one pair")
    val (left, right) = nodes[0]
    [HirChildFrame.Expr(left), HirChildFrame.Expr(right)]

fn verify_child_payload(frame: HirChildFrame, label: text):
    match frame:
        case HirChildFrame.Expr(payload):
            val node: HirExpr = payload
            child_payload_require(node.has_type_, "{label}: expression type-presence bit changed")
            match node.kind:
                case HirExprKind.IntLit(value, suffix):
                    child_payload_require(value == 73, "{label}: integer payload changed")
                    child_payload_require(suffix == nil, "{label}: absent suffix acquired a value")
                case _:
                    child_payload_require(false, "{label}: expression variant changed")
            match node.type_.kind:
                case HirTypeKind.Int(bits, signed):
                    child_payload_require(bits == 64 and signed, "{label}: scalar type payload changed")
                case _:
                    child_payload_require(false, "{label}: expression type changed")
        case _:
            child_payload_require(false, "{label}: child-frame variant changed")

fn main() -> i64:
    val sample: HirExpr = child_payload_sample()
    val nodes: [HirExpr] = [sample]
    val array_expr = HirExpr(kind: HirExprKind.ArrayLit(nodes, None),
        has_type_: false, type_: HirType(kind: HirTypeKind.Error, span: Span.empty()),
        span: Span.empty())
    verify_child_payload(child_from_direct_parameter(sample), "direct parameter")
    verify_child_payload(child_from_typed_array(nodes), "typed array index")
    verify_child_payload(child_from_arraylit_payload(array_expr), "destructured array index")
    verify_child_payload(child_from_rebound_arraylit_payload(array_expr), "typed element rebind")
    val tuple_children = children_from_tuple_array([(sample, sample)])
    child_payload_require(tuple_children.len() == 2, "tuple destructuring changed the number of child frames")
    verify_child_payload(tuple_children[0], "tuple-array first projection")
    verify_child_payload(tuple_children[1], "tuple-array second projection")
    print "nogc-hir-child-payload: four index controls and tuple destructuring passed"
    0
