# Custom-native x86-64 source reproducer, not LLVM/Cranelift ABI evidence.
# Execution pending an admitted source-matched pure-Simple producer. The
# selector spec isolates this repair from separate generic spill defects.
fn six(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64:
    a + b * 10 + c * 100 + d * 1000 + e * 10000 + f * 100000

fn seven(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> i64:
    g

fn eight(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64:
    g * 100 + h

fn nine(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64) -> i64:
    g * 10000 + h * 100 + i

fn main() -> i64:
    assert(six(1, 2, 3, 4, 5, 6) == 654321)
    assert(seven(1, 2, 3, 4, 5, 6, -7) == -7)
    assert(eight(1, 2, 3, 4, 5, 6, 7, 8) == 708)
    assert(nine(1, 2, 3, 4, 5, 6, 7, 8, 9) == 70809)
    0
