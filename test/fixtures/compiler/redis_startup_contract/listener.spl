# Bug: redis_tagged_text_runtime_abi_2026_10_11.
# A bounded external client connects only after proving this process owns the
# emitted LISTENER address, then sends exactly ASCII Q and requires exact bytes [81, 0, 82] back.
# No server restart.
use std.common.string_core.{bytes_to_text}
use std.nogc_sync_mut.sosix.network.{sosix_tcp_bind, sosix_tcp_local_addr, sosix_tcp_accept_timeout, sosix_tcp_read, sosix_tcp_write_text, sosix_tcp_close}

fn main() -> i64:
    val invalid = unsafe(capabilities: [ffi]):
        sosix_tcp_bind("not-an-address")
    if invalid >= 0:
        unsafe(capabilities: [ffi]):
            sosix_tcp_close(invalid)
        return 1
    val listener = unsafe(capabilities: [ffi]):
        sosix_tcp_bind("127.0.0.1:0")
    if listener < 0: return 2
    val address = unsafe(capabilities: [ffi]):
        sosix_tcp_local_addr(listener)
    if val concrete = address:
        print("LISTENER:{concrete}")
    else:
        unsafe(capabilities: [ffi]):
            sosix_tcp_close(listener)
        return 3
    val client = unsafe(capabilities: [ffi]):
        sosix_tcp_accept_timeout(listener, 3000)
    if client < 0:
        unsafe(capabilities: [ffi]):
            sosix_tcp_close(listener)
        return 4
    val payload = unsafe(capabilities: [ffi]):
        sosix_tcp_read(client, 1)
    var written: i64 = -1
    if val bytes = payload:
        if bytes.len() == 1:
            val response_bytes: [u8] = [bytes[0], 0, 82]
            val response = bytes_to_text(response_bytes)
            written = unsafe(capabilities: [ffi]):
                sosix_tcp_write_text(client, response)
    val client_closed = unsafe(capabilities: [ffi]):
        sosix_tcp_close(client)
    val listener_closed = unsafe(capabilities: [ffi]):
        sosix_tcp_close(listener)
    if not client_closed or not listener_closed: return 5
    if written != 3: return 9
    if val bytes = payload:
        if bytes.len() != 1: return 6
        if bytes[0] != 81: return 7
    else:
        return 8
    0
