# Exercise the real event publication/readback owner against owned physical
# fixture sources. This is not whole-checkout SCV filesystem admission.
use std.scv.compile_source_inventory.{
    compile_source_inventory_git_event_v1,
    compile_source_inventory_apply_git_events_v1,
    compile_source_inventory_read_current_v1}
use std.nogc_sync_mut.io.file_ops.{file_read, file_write, file_exists}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}
use std.common.crypto.sha256.{sha256_text}

fn main() -> i64:
    if file_exists("fixture-a/build/scv/source-inventory/CURRENT"): return 10
    if file_exists("fixture-b/build/scv/source-inventory/CURRENT"): return 11
    if not dir_create_all("fixture-a/src"): return 12
    if not dir_create_all("fixture-b/src"): return 13
    if not file_write("fixture-a/src/a.spl", "fn sample_a() -> i64:\n    1\n"): return 14
    if file_read("fixture-a/src/a.spl") != "fn sample_a() -> i64:\n    1\n": return 16
    if not file_write("fixture-a/src/b.spl", "fn sample_b() -> i64:\n    2\n"): return 15
    if file_read("fixture-a/src/b.spl") != "fn sample_b() -> i64:\n    2\n": return 17
    val first_a = compile_source_inventory_git_event_v1(
        "create", "src/a.spl", file_read("fixture-a/src/a.spl"))
    val first_b = compile_source_inventory_git_event_v1(
        "create", "src/b.spl", file_read("fixture-a/src/b.spl"))
    val seeded = compile_source_inventory_apply_git_events_v1(
        "fixture-a/build/scv", [first_b, first_a])
    if not seeded.valid or seeded.digest == "": return 21
    if seeded.inventory!.generation != 2 or seeded.inventory!.entries.len() != 2: return 22
    if seeded.inventory!.entries[0].source_identity != "src/a.spl": return 23
    if seeded.inventory!.entries[0].content_digest != sha256_text(file_read("fixture-a/src/a.spl")): return 24
    val seed_readback = compile_source_inventory_read_current_v1("fixture-a/build/scv")
    if not seed_readback.valid or seed_readback.digest != seeded.digest: return 25

    if not file_write("fixture-a/src/a.spl", "fn sample_a() -> i64:\n    3\n"): return 30
    if file_read("fixture-a/src/a.spl") != "fn sample_a() -> i64:\n    3\n": return 34
    if not file_write("fixture-a/src/b.spl", "fn sample_b() -> i64:\n    4\n"): return 31
    if file_read("fixture-a/src/b.spl") != "fn sample_b() -> i64:\n    4\n": return 35
    val batch = compile_source_inventory_apply_git_events_v1("fixture-a/build/scv", [
        compile_source_inventory_git_event_v1("modify", "src/a.spl", file_read("fixture-a/src/a.spl")),
        compile_source_inventory_git_event_v1("modify", "src/b.spl", file_read("fixture-a/src/b.spl"))])
    if not batch.valid or batch.inventory!.generation != 4: return 32
    if batch.inventory!.entries[1].content_digest != sha256_text(file_read("fixture-a/src/b.spl")): return 33

    if not file_write("fixture-a/src/a.spl", "fn sample_a() -> i64:\n    5\n"): return 40
    if file_read("fixture-a/src/a.spl") != "fn sample_a() -> i64:\n    5\n": return 45
    val single = compile_source_inventory_apply_git_events_v1("fixture-a/build/scv", [
        compile_source_inventory_git_event_v1("modify", "src/a.spl", file_read("fixture-a/src/a.spl"))])
    if not single.valid or single.inventory!.generation != 5: return 41
    val before_invalid = compile_source_inventory_read_current_v1("fixture-a/build/scv")
    if not before_invalid.valid or before_invalid.digest != single.digest: return 42
    val rejected = compile_source_inventory_apply_git_events_v1("fixture-a/build/scv", [
        compile_source_inventory_git_event_v1("unknown", "src/a.spl", file_read("fixture-a/src/a.spl"))])
    if rejected.valid: return 43
    val after_invalid = compile_source_inventory_read_current_v1("fixture-a/build/scv")
    if not after_invalid.valid or after_invalid.digest != before_invalid.digest: return 44

    # Duplicate creates decline initial seeding and exercise the existing
    # batch fallback on a fresh publication root.
    if not file_write("fixture-b/src/a.spl", "fn duplicate_sample() -> i64:\n    7\n"): return 50
    if file_read("fixture-b/src/a.spl") != "fn duplicate_sample() -> i64:\n    7\n": return 54
    val duplicate_event = compile_source_inventory_git_event_v1(
        "create", "src/a.spl", file_read("fixture-b/src/a.spl"))
    val duplicate = compile_source_inventory_apply_git_events_v1(
        "fixture-b/build/scv", [duplicate_event, duplicate_event])
    if not duplicate.valid or duplicate.inventory!.generation != 1: return 51
    if duplicate.inventory!.entries.len() != 1: return 52
    val duplicate_readback = compile_source_inventory_read_current_v1("fixture-b/build/scv")
    if not duplicate_readback.valid or duplicate_readback.digest != duplicate.digest: return 53
    0
