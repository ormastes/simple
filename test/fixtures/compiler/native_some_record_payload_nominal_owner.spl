# Native regression: ambiguous same-name fields must use the payload's record.
class Record:
    reducer: i64

class Decoy:
    reducer: bool

fn select(value: Record) -> i64:
    match Some(value):
        Some(owned): owned.reducer
        nil: -1

fn main() -> i64:
    val got = select(Record(reducer: 73))
    if got != 73:
        return 1
    print "some-record-payload=73"
    0
