# Native regression/performance input, UNCOMPILED/UNRUN.
# Run under an admitted self-produced Stage3 compiler, retaining source/producer
# runtime/toolchain and RSS/time identity. Expected stdout: text-copy-ok.
fn next_line(content: text, start: i64) -> i64:
    content.index_of("\n", start)

fn contains_from_parameter(content: text, needle: text) -> bool:
    content.contains(needle)

fn main():
    assert(next_line("raw\ntext", 0) == 3)
    assert(next_line("raw\ntext", 4) == -1)
    assert(next_line("1234\n", 0) == 4)
    val numeric_text = "1234" + "\n"
    assert(next_line(numeric_text, 0) == 4)
    val tagged = "head\n" + "tail"
    assert(next_line(tagged, 0) == 4)
    assert(contains_from_parameter(tagged, "tail"))
    assert(not contains_from_parameter(tagged, "missing"))
    val counted = "a\0" + "b\n"
    assert(next_line(counted, 0) == 3)
    assert(contains_from_parameter(counted, "b"))
    val unicode = "é" + "\n한"
    assert(next_line(unicode, 0) == 2)
    val content = "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz1234567\n".repeat(20000)
    var start = 0
    var lines = 0
    while start < content.byte_len():
        val found = next_line(content, start)
        assert(found >= start)
        start = found + 1
        lines = lines + 1
    assert(lines == 20000)
    print("text-copy-ok")
