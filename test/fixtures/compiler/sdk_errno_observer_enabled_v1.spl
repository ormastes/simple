# Native diagnostic-build control only. This is not an SDK failure reproduction.
use compiler.common.sdk_errno_observer_v1.{sdk_errno_observer_enabled_v1,
    sdk_errno_observer_initialize_v1, sdk_errno_observer_emit_root_v1}

fn emit_probe_v1(path: text, wanted: text, branch: text):
    sdk_errno_observer_emit_root_v1("fixture.module", path, wanted, branch,
        19, 691, 79, -1, 126, true, true, true,
        17, 690, true, 19, 691, true, "path_errno_address")

fn main() -> i64:
    if not sdk_errno_observer_enabled_v1(): return 2
    sdk_errno_observer_initialize_v1()
    var index = 0
    while index < 16:
        emit_probe_v1("src/other/io/path_identity.spl", "path_errno_address", "wrong-importer")
        emit_probe_v1("src/lib/nogc_sync_mut/io/path_identity.spl", "other_name", "wrong-symbol")
        index = index + 1
    index = 0
    while index < 12:
        emit_probe_v1("src/lib/nogc_sync_mut/io/path_identity.spl", "path_errno_address", "enabled-native-control")
        index = index + 1
    0
