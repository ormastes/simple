use provider.{INLINE_LABEL as PRIVATE_ALIAS}

# Standalone compile-negative entry: no direct bad address outside this returned
# lambda. Returning and then passing it forces first-class lifted MIR lowering.
fn make_address_callback() -> fn() -> i64:
    \:
        unsafe:
            val address = &PRIVATE_ALIAS
        0

fn invoke(callback: fn() -> i64) -> i64:
    callback()

fn main() -> i64:
    invoke(make_address_callback())
