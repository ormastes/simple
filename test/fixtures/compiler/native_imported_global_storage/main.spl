use provider.{VALUE, INITIALIZATIONS, INLINE_LABEL, PUBLIC_NUMBER, read_value, set_value,
    owns_value_address, own_private_address_is_stable}
use observer.{observe, same_value_address, same_public_address}

val LOCAL_NUMBER: i64 = 31

fn main() -> i64:
    if VALUE != 7: return 1
    if INITIALIZATIONS != 1: return 2
    if observe() != 7: return 3
    VALUE = 11
    if read_value() != 11: return 4
    if observe() != 11: return 5
    set_value(17)
    if VALUE != 17: return 6
    if observe() != 17: return 7
    if INLINE_LABEL != "ready": return 9
    if INITIALIZATIONS != 1: return 8
    unsafe:
        if not same_value_address(&VALUE): return 10
        if not owns_value_address(&VALUE): return 11
        if not same_public_address(&PUBLIC_NUMBER): return 12
        val first = &LOCAL_NUMBER
        val second = &LOCAL_NUMBER
        if first != second: return 13
    if not own_private_address_is_stable(): return 14
    if INITIALIZATIONS != 1: return 15
    0
