pub var INITIALIZATIONS: i64 = 0
val INLINE_LABEL = "ready"
val INLINE_NUMBER: i64 = 23
pub val PUBLIC_NUMBER: i64 = 29

fn initial_value() -> i64:
    INITIALIZATIONS = INITIALIZATIONS + 1
    7

pub var VALUE: i64 = initial_value()

pub fn read_value() -> i64:
    VALUE

pub fn set_value(value: i64):
    VALUE = value

pub fn owns_value_address(candidate: &i64) -> bool:
    unsafe:
        candidate == &VALUE

pub fn own_private_address_is_stable() -> bool:
    unsafe:
        val first = &INLINE_NUMBER
        val second = &INLINE_NUMBER
        first == second
