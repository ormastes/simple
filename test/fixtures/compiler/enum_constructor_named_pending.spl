# KNOWN UNQUALIFIED: reordered named payload binding is a separate owner gap.
# Intended oracle is 12, not 21. Native UNRUN; not a passing regression.
enum PairValue:
    Pair(first: i64, second: i64)
fn main() -> i64:
    val value = PairValue.Pair(second: 2, first: 1)
    match value:
        case PairValue.Pair(first, second): first * 10 + second
