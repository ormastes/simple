use compiler.backend.backend.cranelift_global_address.{cranelift_define_global_accessor_v1}
use std.nogc_sync_mut.sffi.codegen.*

fn main() -> i64:
    val module = cranelift_new_aot_module("accessor_visibility", "aarch64-unknown-linux-gnu")
    if module == 0: return 1
    val private_data = cranelift_declare_global_data_with_metadata(module, "private_payload", 4, 41, 2, 8)
    if private_data == 0: return 2
    if cranelift_define_global_accessor_v1(module, "rejected_local", private_data, 2): return 3
    if cranelift_define_global_accessor_v1(module, "rejected_hidden", private_data, 3): return 4
    if cranelift_define_global_accessor_v1(module, "rejected_import", private_data, 1): return 5
    val public_data = cranelift_declare_global_data_with_metadata(module, "public_payload", 4, 43, 0, 8)
    if public_data == 0: return 6
    if not cranelift_define_global_accessor_v1(module, "accepted_public", public_data, 0): return 7
    if not cranelift_emit_object(module, "build/native_probe/imported-globals/accessor-visibility.o"): return 8
    cranelift_free_module(module)
    0
