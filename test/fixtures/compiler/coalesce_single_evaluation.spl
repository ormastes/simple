var left_calls: i64 = 0
var right_calls: i64 = 0

fn read_text(kind: i64) -> text?:
    left_calls = left_calls + 1
    if kind == 0: return nil
    if kind == 1: return "value"
    if kind == 2: return ""
    Some("wrapped")

fn text_fallback() -> text:
    right_calls = right_calls + 1
    "fallback"

fn read_scalar(present: bool) -> i64?:
    left_calls = left_calls + 1
    if present: return 42
    nil

fn scalar_fallback() -> i64:
    right_calls = right_calls + 1
    9

fn main() -> i64:
    val nonempty = read_text(1) ?? text_fallback()
    if nonempty != "value" or left_calls != 1 or right_calls != 0: return 11
    val empty = read_text(2) ?? text_fallback()
    if empty != "" or left_calls != 2 or right_calls != 0: return 12
    val wrapped = read_text(3) ?? text_fallback()
    if wrapped != "wrapped" or left_calls != 3 or right_calls != 0: return 13
    val absent = read_text(0) ?? text_fallback()
    if absent != "fallback" or left_calls != 4 or right_calls != 1: return 14
    val scalar = (read_scalar(true) ?? scalar_fallback()) + 1
    if scalar != 43 or left_calls != 5 or right_calls != 1: return 15
    val absent_scalar = (read_scalar(false) ?? scalar_fallback()) + 1
    if absent_scalar != 10 or left_calls != 6 or right_calls != 2: return 16
    val nested = read_text(0) ?? (read_text(1) ?? text_fallback())
    if nested != "value" or left_calls != 8 or right_calls != 2: return 17
    val skipped_nested = read_text(1) ?? (read_text(0) ?? text_fallback())
    if skipped_nested != "value" or left_calls != 9 or right_calls != 2: return 18
    print "coalesce-single-evaluation PASS"
    0
