# Native regression for mir_if_val_bool_binder_is_presence_predicate_2026-11-06.
# A false payload is present; None is absent. Explicit bool .? is presence.
fn selected_flag(mode: i64) -> bool?:
    if mode == 0: return nil
    if mode == 1: return false
    true

fn payload_code(mode: i64) -> i64:
    if val flag = selected_flag(mode):
        if flag: return 1
        return 0
    -1

fn main() -> i64:
    if payload_code(0) != -1: return 1
    if payload_code(1) != 0: return 2
    if payload_code(2) != 1: return 3
    val absent: bool = selected_flag(0).?
    val present_false: bool = selected_flag(1).?
    val present_true: bool = selected_flag(2).?
    if absent: return 4
    if not present_false: return 5
    if not present_true: return 6
    print "if-val-bool-payload: PASS"
    0
