# Native qualification must use a fresh Git fixture root and natural runtime link.
# @req REQ-PURE-DB-NUMERIC-PARSE-001
use std.database.pure_sql.{PureDatabase}
use std.common.crypto.sha256.{sha256_text}
use std.io_runtime.{file_delete, file_read, file_write}

extern fn rt_getpid() -> i64
extern fn rt_time_now_unix_micros() -> i64

fn write_image(path: text, version: text, payload: text) -> bool:
    file_write(path, version + "\n" + payload.len().to_text() + "\n" + sha256_text(payload) + "\n" + payload)

fn reject_image(path: text, version: text, payload: text) -> bool:
    if not write_image(path, version, payload): return false
    val before = file_read(path)
    val rejected = PureDatabase.open_deferred(path).is_err()
    rejected and file_read(path) == before

fn check_numeric_store(path: text) -> i64:
    if not write_image(path, "simple-pure-db-v2", "table|n|i,r\nrow|n|I1:0R3:0.0\nrow|n|I2:-7R5:-3.25"):
        return 1
    val opened = PureDatabase.open_deferred(path)
    if opened.is_err(): return 2
    val db = opened.unwrap()
    val queried = db.scan_all("n")
    if queried.is_err(): return 3
    val rows = queried.unwrap()
    if rows.len() != 2: return 4
    if rows[0].values[0].as_int().unwrap() != 0: return 5
    if rows[0].values[1].as_real().unwrap() != 0.0: return 6
    if rows[1].values[0].as_int().unwrap() != -7: return 7
    if rows[1].values[1].as_real().unwrap() != -3.25: return 8
    if db.checkpoint().is_err(): return 9
    if not file_read(path).starts_with("simple-pure-db-v3\n"): return 10
    val reopened = PureDatabase.open_deferred(path)
    if reopened.is_err(): return 11
    val persisted = reopened.unwrap().scan_all("n").unwrap()
    if persisted.len() != 2: return 12
    if persisted[0].values[0].as_int().unwrap() != 0: return 13
    if persisted[0].values[1].as_real().unwrap() != 0.0: return 14
    if persisted[1].values[1].as_real().unwrap() != -3.25: return 15
    val prefix = "table|n|v\nrow|n|"
    for row in ["R3:bad", "R0:", "R4:2.5x", "R01:0", "R2147483648:0", "R9223372036854775808:0"]:
        if not reject_image(path, "simple-pure-db-v2", prefix + row): return 16
    val v3_prefix = "table|T1:n|T1:v\nschema|T1:n|T14:legacy-unknown\nrow|T1:n|"
    for row in ["I2:01", "I19:9223372036854775808", "R3:bad", "R4:2.50"]:
        if not reject_image(path, "simple-pure-db-v3", v3_prefix + row): return 17
    if not file_write(path, "simple-pure-db-v1\ntable|n|i,r\nrow|n|I:bad\tR:bad"): return 18
    val legacy = PureDatabase.open_deferred(path)
    if legacy.is_err(): return 19
    val legacy_db = legacy.unwrap()
    val legacy_rows = legacy_db.scan_all("n").unwrap()
    if legacy_rows[0].values[0].as_int().unwrap() != 0: return 20
    if legacy_rows[0].values[1].as_real().unwrap() != 0.0: return 21
    if legacy_db.exec_sql("INSERT INTO n VALUES (-7, 2.5)").is_err(): return 22
    val inserted = legacy_db.scan_all("n").unwrap()
    if inserted.len() != 2: return 23
    if inserted[1].values[1].as_real().unwrap() != 2.5: return 24
    0

fn main() -> i64:
    val path = "/tmp/pure_db_numeric_native_{rt_getpid()}_{rt_time_now_unix_micros()}.db"
    val result = check_numeric_store(path)
    file_delete(path)
    file_delete(path + ".commit.lock")
    result
