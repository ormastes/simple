# Compile with each executable backend. Both exhaustive arm orders must retain
# their discriminator, payload and merge value. --negative must exit 2.
use std.sffi.cli_args.{cli_get_args}

fn render(value: Result<i64, text>) -> text:
    match value:
        case Ok(number): "ok {number}"
        case Err(message): "err {message}"

fn render_error_first(value: Result<i64, text>) -> text:
    val rendered = match value:
        case Err(message): "error-first {message}"
        case Ok(number): "success-second {number}"
    "continued {rendered}"

fn main() -> i64:
    var expected_error = "err unavailable"
    for arg in cli_get_args():
        if arg == "--negative": expected_error = "err wrong payload"
    if render(Ok(42)) != "ok 42": return 1
    if render(Err("unavailable")) != expected_error: return 2
    if render(Ok(-7)) != "ok -7": return 3
    if render(Err("different")) != "err different": return 4
    if render_error_first(Err("rejected")) != "continued error-first rejected": return 5
    if render_error_first(Ok(19)) != "continued success-second 19": return 6
    print "result-match assertions=6 PASS"
    0
