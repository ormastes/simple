# Original boxed optional writable-place regression (bootstrap seed).
class Cell:
    n: i64

    me bump():
        self.n = self.n + 1

class Holder:
    cell: Cell?

var p1_enum_opt_index_calls: i64 = 0

fn p1_enum_opt_index() -> i64:
    p1_enum_opt_index_calls = p1_enum_opt_index_calls + 1
    0

fn main() -> i64:
    var direct: Cell? = Cell(n: 1)
    direct!.n = 2
    assert(direct!.n == 2)

    var some: Cell? = Some(Cell(n: 3))
    some!.n = 4
    assert(some!.n == 4)
    some!.n += 2
    assert(some!.n == 6)
    some!.bump()
    assert(some!.n == 7)

    var result = Ok(Cell(n: 8))
    result!.n = 9
    result!.n += 1
    assert(result!.n == 10)

    var holder = Holder(cell: Some(Cell(n: 11)))
    holder.cell!.n = 12
    assert(holder.cell!.n == 12)

    var rows = [Some(Cell(n: 13))]
    rows[p1_enum_opt_index()]!.n += 1
    assert(rows[0]!.n == 14)
    assert(p1_enum_opt_index_calls == 1)

    print "forceunwrap-place: 8 assertions passed"
    0
