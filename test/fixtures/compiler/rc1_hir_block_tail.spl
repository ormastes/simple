struct TailValue:
    value: i64

fn implicit_tail() -> i64:
    42

fn explicit_return() -> i64:
    return 42

fn tuple_tail() -> i64:
    val (left, right) = (19, 23)
    left + right

fn typed_tail() -> TailValue:
    val value: TailValue = TailValue(value: 42)
    value

fn conditional_tail(flag: bool) -> i64:
    if flag: 42 else: 7

fn main() -> i64:
    if implicit_tail() != 42: return 1
    if explicit_return() != 42: return 2
    if tuple_tail() != 42: return 3
    val value = typed_tail()
    if value.value != 42: return 4
    if conditional_tail(true) != 42: return 5
    if conditional_tail(false) != 7: return 6
    print "RC1 HIR block tails PASS"
    0
