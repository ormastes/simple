use .left.{SharedMode as UnitMode}
use .right.{SharedMode as PayloadMode}

enum OtherOutcome:
    Ok(message: text)
    Err(code: i64)

fn unit_owner(mode: UnitMode) -> i64:
    match mode:
        case Relaxed: 3
        case Acquire: 5

fn payload_variant_name_remains_binding(mode: PayloadMode) -> i64:
    # Relaxed belongs to this enum but carries a payload. As a bare name in a
    # match it must remain an ordinary catch-all binding, not a unit pattern.
    match mode:
        case Relaxed: 7

fn ordinary_binding(mode: UnitMode) -> i64:
    match mode:
        case remaining: unit_owner(remaining)

fn result_owner(value: Result<i64, text>) -> i64:
    match value:
        case Ok(number): number
        case Err(_): -1

fn main() -> i64:
    if unit_owner(UnitMode.Relaxed) != 3: return 1
    if unit_owner(UnitMode.Acquire) != 5: return 2
    if payload_variant_name_remains_binding(PayloadMode.Acquire) != 7: return 3
    if ordinary_binding(UnitMode.Relaxed) != 3: return 4
    if ordinary_binding(UnitMode.Acquire) != 5: return 5
    if result_owner(Ok(23)) != 23: return 6
    if result_owner(Err("bad")) != -1: return 7
    0
