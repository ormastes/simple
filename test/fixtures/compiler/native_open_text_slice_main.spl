# Compile and execute with the repaired pure-Simple native compiler.
# Text slicing uses UTF-8 byte offsets, as raw_text_index_contract_spec requires.
fn main() -> i64:
    val line = "SPL Doctest: 2 passed, 0 failed, 0 skipped"
    val prefix = "SPL Doctest: "
    assert(prefix.len() == 13)
    assert(line[prefix.len():] == "2 passed, 0 failed, 0 skipped")
    assert(line[13:] == "2 passed, 0 failed, 0 skipped")
    assert(line[13:21] == "2 passed")
    assert(line[:13] == prefix)
    assert(line[:] == line)
    assert(line[line.len():] == "")
    assert(line[0:] == line)
    val empty = ""
    assert(empty[:] == "")
    val unicode = "π.尾"
    val byte_start = 3
    assert(unicode[byte_start:] == "尾")
    assert(unicode[:byte_start] == "π.")
    assert(unicode[2:3] == ".")
    assert(unicode[:] == unicode)
    # Chained receivers take the second postfix parser path and must agree.
    assert(("π." + "尾")[:] == unicode)
    assert(("a" + "bc")[1:] == "bc")
    val word = "abcd"
    val explicit_end = -1
    # Preserve the provider's existing explicit endpoint behavior. An omitted
    # endpoint must not make an authored negative endpoint become open-ended.
    val explicit_baseline = word.slice(1, -1)
    assert(word[1:-1] == explicit_baseline)
    assert(word[1:explicit_end] == explicit_baseline)
    assert(word[1:(-1)] == explicit_baseline)
    assert(word[99:] == "")
    val values = [10, 20, 30]
    val tail = values[1:]
    assert(tail.len() == 2)
    assert(tail[0] == 20)
    assert(tail[1] == 30)
    val copied = values[:]
    assert(copied.len() == 3)
    assert(copied[0] == 10)
    assert(copied[2] == 30)
    print "PASS native open text slice: 25 assertions"
    0
