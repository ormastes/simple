class Reading:
    value: i64

impl Reading:
    fn read() -> i64:
        self.value

class Envelope:
    reading: Reading?

fn main() -> i64:
    val envelope = Envelope(reading: Reading(value: 42))
    if envelope.reading.?.read() != 42: return 1
    print "OPTIONAL_CLASS_PAYLOAD_METHOD_PASS"
    0
