# Native oracle for declared optional enum payloads. Compile and execute.
enum OptionalTextCarrier:
    Payload(value: text?)

fn read_optional_text(carrier: OptionalTextCarrier) -> text:
    match carrier:
        case OptionalTextCarrier.Payload(value):
            value ?? "absent"

fn main() -> i64:
    val present: text? = "retained"
    val empty: text? = ""
    var failures = 0
    if read_optional_text(OptionalTextCarrier.Payload(nil)) != "absent":
        failures = failures + 1
    if read_optional_text(OptionalTextCarrier.Payload(present)) != "retained":
        failures = failures + 1
    if read_optional_text(OptionalTextCarrier.Payload(empty)) != "":
        failures = failures + 1
    print "checks=3 failures={failures}"
    failures
