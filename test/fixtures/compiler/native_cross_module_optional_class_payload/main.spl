# Imported inline method returns an Optional class with an array-valued method.
use facade.{ProbeTable, ProbeDatabase}
fn query(db: ProbeDatabase) -> i64:
    val table = match db.get_table("rows"):
        case Some(found): found
        case None: return -1
    for row in table.valid_rows():
        return row
    -2
fn main() -> i64:
    val db = ProbeDatabase(table: ProbeTable(rows: [37]))
    print(query(db))
    0
