# New boxed-payload prevention criterion. No original scalar criterion is rerun.
fn classify(value: [u8]?) -> i64:
    match value:
        case Some(raw):
            if raw.len() == 0:
                return 0
            if raw.len() != 3:
                return -2
            if raw[0] != 0x7f:
                return -3
            if raw[1] != 0x80:
                return -4
            if raw[2] != 0xff:
                return -5
            1
        case None: -1

fn absent_bytes() -> [u8]?:
    nil

fn main() -> i64:
    val empty: [u8] = []
    val payload: [u8] = [0x7f, 0x80, 0xff]
    if classify(Some(empty)) != 0:
        return 11
    if classify(Some(payload)) != 1:
        return 12
    if classify(absent_bytes()) != -1:
        return 13
    if empty.len() != 0:
        return 14
    if payload.len() != 3:
        return 15
    if payload[0] != 0x7f:
        return 16
    if payload[1] != 0x80:
        return 17
    if payload[2] != 0xff:
        return 18
    print "array-optional-probe-ok"
    0
