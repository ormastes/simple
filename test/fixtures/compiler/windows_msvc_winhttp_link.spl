# Windows x64 native import-closure regression. Opening and closing a session
# does not send a request. Run with both internal COFF and external MSVC links.
@unsafe(reason: "exercise the Windows SDK WinHTTP import closure", capabilities: [ffi])
extern fn WinHttpOpen(agent: i64, access_type: u32, proxy: i64, bypass: i64, flags: u32) -> i64
@unsafe(reason: "close the real WinHTTP session created by the fixture", capabilities: [ffi])
extern fn WinHttpCloseHandle(handle: i64) -> i32

fn main() -> i64:
    unsafe(capabilities: [ffi]):
        val session = WinHttpOpen(0, 1u32, 0, 0, 0u32)
        if session == 0: return 1
        if WinHttpCloseHandle(session) == 0: return 2
    print "WinHTTP link OK"
    0
