use std.common.sdn.value.{SdnValue}

# The runner closure has multiple declarations with these variant leaves.
# A constructor must use its declared receiver owner in that environment.
enum CompetingValue:
    Float(i64)
    Array(bool)
    Dict(text)

struct CustomLength:
    count: i64

impl CustomLength:
    fn len() -> i64:
        self.count + 40

# Test the declarations that the standalone runner imports, including the
# recursive payload type and the Float leaf shared with other compiler enums.
fn tuple_value(value: Result<(i64, [i64]), text>) -> i64:
    match value:
        case Err(_): -1
        case Ok((number, items)):
            number + items[0]

fn array_value(items: [SdnValue]) -> SdnValue:
    SdnValue.Array(items)

fn dict_value(items: Dict<text, SdnValue>) -> SdnValue:
    SdnValue.Dict(items)

fn competing_float(value: CompetingValue) -> i64:
    match value:
        case CompetingValue.Float(number): number
        case _: -1

fn competing_array(value: CompetingValue) -> bool:
    match value:
        case CompetingValue.Array(flag): flag
        case _: false

fn competing_dict(value: CompetingValue) -> text:
    match value:
        case CompetingValue.Dict(label): label
        case _: "wrong"

fn main() -> i64:
    val floating = SdnValue.float(2.5)
    if not floating.is_float(): return 1
    val items: [SdnValue] = [SdnValue.Int(17)]
    val mapping: Dict<text, SdnValue> = {"answer": SdnValue.Int(23)}
    val array = array_value(items)
    val factory_array = SdnValue.array(items)
    val dict = dict_value(mapping)
    val empty_array = SdnValue.empty_array()
    val empty_dict = SdnValue.empty_dict()
    val direct = SdnValue.Array(items)
    val items_len = items.len()
    val direct_len = direct.len()
    val returned_len = array.len()
    val returned_payload_len = match array:
        case SdnValue.Array(payload): payload.len()
        case _: -1
    print "runner SDN array lengths: input={items_len} direct={direct_len} returned={returned_len} payload={returned_payload_len}"
    if array.len() != 1 or factory_array.len() != 1: return 2
    if dict.len() != 1: return 3
    if empty_array.len() != 0: return 4
    if empty_dict.len() != 0: return 5
    if tuple_value(Ok((11, [7]))) != 18: return 6
    if tuple_value(Err("failure")) != -1: return 7
    if competing_float(CompetingValue.Float(31)) != 31: return 8
    if not competing_array(CompetingValue.Array(true)): return 9
    if competing_dict(CompetingValue.Dict("owned")) != "owned": return 10
    val custom = CustomLength(count: 2)
    if custom.len() != 42: return 11
    if items.len() != 1: return 12
    val text_value = "length"
    if text_value.len() != 6: return 13
    print "runner SDN MIR: 13 checks, 0 failures"
    0
