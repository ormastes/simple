fn widen_byte(value: u8) -> i64:
    value as i64

fn widen_signed(value: i8) -> i64:
    value as i64

fn widen_copied_signed(value: i8) -> i64:
    val copied = value
    copied as i64

fn widen_array_byte(values: [u8], index: i64) -> i64:
    val byte = values[index]
    byte as i64

fn widen_array_direct(values: [u8], index: i64) -> i64:
    values[index] as i64

fn widen_array_annotated(values: [u8], index: i64) -> i64:
    val byte: u8 = values[index]
    byte as i64

fn sum_inferred_octets(values: [u8]) -> i64:
    var total: i64 = 0
    for index in 0..values.len():
        val byte = values[index]
        val wide = byte as i64
        total = total + wide
    total

fn sum_annotated_octets(values: [u8]) -> i64:
    var total: i64 = 0
    for index in 0..values.len():
        val byte: u8 = values[index]
        val wide = byte as i64
        total = total + wide
    total

fn checked_window(values: [u8], start: i64, end: i64) -> Result<[u8], text>:
    var result: [u8] = []
    for index in start..end:
        val byte = values[index]
        val value = byte as i64
        if value < 0 or value > 255:
            return Err("octet range")
        result.push(byte)
    Ok(result)

fn main():
    val values: [u8] = [127, 128, 153, 255]
    val low = widen_byte(127 as u8)
    val high = widen_byte(153 as u8)
    val max_byte = widen_byte(255 as u8)
    val indexed = widen_array_byte(values, 2)
    val direct_indexed = widen_array_direct(values, 2)
    val annotated = widen_array_annotated(values, 2)
    val signed = widen_signed(-1 as i8)
    val copied_signed = widen_copied_signed(-1 as i8)
    val looped = sum_inferred_octets(values)
    val looped_annotated = sum_annotated_octets(values)
    val checked = checked_window(values, 0, values.len())
    print "u8 widen: low={low} high={high} max={max_byte} indexed={indexed} signed={signed}"
    print "array widening: direct={direct_indexed} annotated={annotated}"
    print "loop widening: inferred={looped} annotated={looped_annotated}"
    print "checked window success={checked.is_ok()}"
    assert(low == 127)
    assert(high == 153)
    assert(max_byte == 255)
    assert(indexed == 153)
    assert(direct_indexed == 153)
    assert(annotated == 153)
    assert(signed == -1)
    assert(copied_signed == -1)
    assert(looped == 663)
    assert(looped_annotated == 663)
    assert(checked.is_ok())
    val copied = checked.unwrap()
    assert(copied.len() == 4)
    assert(widen_array_direct(copied, 0) == 127)
    assert(widen_array_direct(copied, 1) == 128)
    assert(widen_array_direct(copied, 2) == 153)
    assert(widen_array_direct(copied, 3) == 255)
