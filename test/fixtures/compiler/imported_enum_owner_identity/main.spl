use owner.{PacketKind as Kind, Packet, Receipt, frozen_receipt}

fn main() -> i64:
    val receipt = frozen_receipt()
    if receipt.packet.kind != Kind.Frozen:
        return 1
    if receipt.packet.kind == Kind.Ack:
        return 2
    val other = Receipt(packet: Packet(kind: Kind.CleanupFrozen))
    if other.packet.kind == Kind.Frozen:
        return 3
    print "imported-enum-owner: pass"
    0
