use owner.{PacketKind, Packet, Receipt}
fn main() -> i64:
    val kinds = [PacketKind.Unknown, PacketKind.Frozen, PacketKind.Ack, PacketKind.CleanupFrozen]
    var index = 0
    for kind in kinds:
        val receipt = Receipt(packet: Packet(kind: kind))
        val is_frozen = receipt.packet.kind is PacketKind.Frozen
        val is_ack = receipt.packet.kind is PacketKind.Ack
        val is_cleanup = receipt.packet.kind is PacketKind.CleanupFrozen
        if is_frozen != (index == 1):
            return 1
        if is_ack != (index == 2):
            return 2
        if is_cleanup != (index == 3):
            return 3
        if (not is_frozen) != (receipt.packet.kind != PacketKind.Frozen):
            return 4
        if is_frozen != (receipt.packet.kind == PacketKind.Frozen):
            return 5
        index = index + 1
    if index != 4:
        return 6
    print "enum-pattern-matrix: 20 checks passed"
    0
