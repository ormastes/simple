# Actual async facade -> sync table owner, no local database mocks.
use std.nogc_async_mut.database.core.{SdnDatabase, SdnTable, SdnRow}
use std.nogc_async_mut.database.query.{QueryBuilder, CompareOp}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_delete}

fn db_probe_row_v1(id: text, value: text) -> SdnRow:
    val row = SdnRow.empty()
    row.set("id", id)
    row.set("value", value)
    row.set("valid", "true")
    row

fn db_update_optional_v1(db: SdnDatabase, table_name: text, id: text, value: text) -> bool?:
    # Inferred nominal receiver after actual optional-returning method and ?.
    var current_table = db.get_table_mut(table_name)?
    val updated = current_table.update_row(id, db_probe_row_v1(id, value))
    db.set_table(table_name, current_table)
    Some(updated)

fn db_delete_optional_v1(db: SdnDatabase, table_name: text, id: text) -> bool?:
    var current_table = db.get_table_mut(table_name)?
    val deleted = current_table.mark_deleted(id)
    db.set_table(table_name, current_table)
    Some(deleted)

fn db_optional_mutation_probe_v1(path: text) -> i64:
    val db = SdnDatabase.new(path)
    val table = SdnTable.new("records", ["id", "value", "valid"])
    if not table.add_row(db_probe_row_v1("a", "old")): return 1
    if not table.add_row(db_probe_row_v1("b", "keep")): return 2
    db.set_table("records", table)
    if db_update_optional_v1(db, "records", "a", "new") != Some(true): return 3
    if db_update_optional_v1(db, "records", "missing", "bad") != Some(false): return 4
    if db_update_optional_v1(db, "absent", "a", "bad") != nil: return 5
    if db_delete_optional_v1(db, "records", "b") != Some(true): return 6
    if db_delete_optional_v1(db, "records", "missing") != Some(false): return 7
    if db_delete_optional_v1(db, "absent", "a") != nil: return 8
    if not db.save(): return 9
    val loaded = SdnDatabase.load(path) ?? return 10
    val persisted = loaded.get_table("records") ?? return 11
    val updated = persisted.get_row("a") ?? return 12
    val deleted = persisted.get_row("b") ?? return 13
    if updated.get("value") != Some("new"): return 14
    if updated.get("valid") != Some("true"): return 15
    if deleted.get("value") != Some("keep"): return 16
    if deleted.get("valid") != Some("false"): return 17
    if persisted.rows.len() != 2: return 18
    0

fn db_query_prefix_probe_v1() -> i64:
    val table = SdnTable.new("records", ["id", "value", "valid"])
    table.add_row(db_probe_row_v1("b", "20"))
    table.add_row(db_probe_row_v1("a", "10"))
    table.add_row(db_probe_row_v1("c", "30"))
    # Unsorted order remains original; sorted order is applied before prefix.
    for limit in [0, 1, 2, 3, 9, -1]:
        var expected = limit
        if expected < 0: expected = 0
        if expected > 3: expected = 3
        val query = QueryBuilder.for_table(table)
        query.take(limit)
        val rows = query.execute()
        if rows.len() != expected: return 20
        val insertion_order = ["b", "a", "c"]
        for index in 0..rows.len():
            if rows[index].get("id") != Some(insertion_order[index]): return 21
        val sorted_query = QueryBuilder.for_table(table)
        sorted_query.order_by("value", false)
        sorted_query.take(limit)
        val sorted_rows = sorted_query.execute()
        if sorted_rows.len() != expected: return 22
        val sorted_order = ["a", "b", "c"]
        for index in 0..sorted_rows.len():
            if sorted_rows[index].get("id") != Some(sorted_order[index]): return 23
    val filtered = QueryBuilder.for_table(table)
    filtered.filter_by("value", CompareOp.Ge, "20")
    filtered.order_by("value", true)
    filtered.take(1)
    val filtered_rows = filtered.execute()
    if filtered_rows.len() != 1: return 24
    if filtered_rows[0].get("id") != Some("c"): return 25
    # Prefix/result storage remains a copied collection, never a source view.
    val query = QueryBuilder.for_table(table)
    query.take(1)
    val copy = query.execute()
    val copied_row = copy[0]
    copied_row.set("value", "changed-copy")
    if table.rows[0].get("value") != Some("20"): return 26
    val again = query.execute()
    if again.len() != 1 or again[0].get("value") != Some("20"): return 27
    val empty_table = SdnTable.new("empty", ["id", "value", "valid"])
    val empty_query = QueryBuilder.for_table(empty_table)
    empty_query.take(9)
    if empty_query.execute().len() != 0: return 28
    0

fn main() -> i32:
    val directory = secure_temp_dir("/tmp", "simple-db-native-").unwrap()
    val path = directory + "/records.sdn"
    val mutation_status = db_optional_mutation_probe_v1(path)
    val removed = file_delete(path)
    if mutation_status != 0: return mutation_status as i32
    if not removed: return 29
    db_query_prefix_probe_v1() as i32
