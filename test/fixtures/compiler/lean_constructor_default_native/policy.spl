# Small cross-module reproducer of the Lean planner's five-field policy default.
struct Limits:
    max_depth: i64 = 128
    max_nodes: i64 = 65536
    max_work: i64 = 1048576
    max_key_bytes: i64 = 1048576
    max_plans: i64 = 4096

fn policy_signature(limits: Limits = Limits()) -> text:
    "{limits.max_depth},{limits.max_nodes},{limits.max_work},{limits.max_key_bytes},{limits.max_plans}"

fn literal_default(value: i64 = 17) -> i64:
    value
