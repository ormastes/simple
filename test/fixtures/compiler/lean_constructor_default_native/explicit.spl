use policy.{Limits, policy_signature, literal_default}

fn main() -> i64:
    val default_policy = policy_signature(Limits())
    if default_policy != "128,65536,1048576,1048576,4096":
        print "FAIL default policy: {default_policy}"
        return 1
    val smaller = policy_signature(Limits(max_depth: 8, max_nodes: 32, max_work: 64, max_key_bytes: 128, max_plans: 2))
    if smaller != "8,32,64,128,2":
        print "FAIL explicit policy: {smaller}"
        return 2
    if literal_default() != 17:
        return 3
    print "PASS lean constructor default: 3 checks"
    0
