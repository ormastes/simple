"""Native diagnostic for the synchronous weak registry, not sigil lowering."""
use std.nogc_sync_mut.io_runtime.{exit}
use std.nogc_sync_mut.ptr.weak.{WeakLease, weak_reset, weak_register, weak_create, weak_upgrade, weak_is_alive, weak_remove_strong, weak_add_strong, weak_strong_count, weak_upgrade_owned, weak_lease_value, weak_lease_release}

fn weak_lease_require(condition: bool, message: text):
    if not condition:
        print "nogc-weak-lease FAILED: {message}"
        exit(1)

fn acquire_checked(target_id: i64) -> WeakLease:
    val acquired: WeakLease? = weak_upgrade_owned(weak_create(target_id))
    if val lease = acquired:
        return lease
    print "nogc-weak-lease FAILED: live target did not acquire"
    exit(1)
    WeakLease(token_id: -1, generation: -1)

fn main() -> i64:
    weak_reset()
    val target = weak_register(42)
    val observer = weak_create(target)
    val lease = acquire_checked(target)
    weak_lease_require(weak_strong_count(target) == 2, "upgrade must acquire one strong reference")
    weak_remove_strong(target)
    weak_lease_require(weak_is_alive(observer), "lease must retain target after original owner release")
    weak_lease_require(weak_lease_value(lease) == Some(42), "retained lease value")
    weak_lease_require(weak_lease_release(lease), "first release")
    val lease_copy = lease
    weak_lease_require(not weak_lease_release(lease_copy), "copied acquisition cannot release twice")
    weak_lease_require(weak_strong_count(target) == 0, "final release reaches zero once")
    weak_lease_require(not weak_is_alive(observer), "weak expires after final owner release")
    weak_lease_require(weak_upgrade_owned(observer) == nil, "expired upgrade cannot resurrect")
    weak_lease_require(weak_lease_value(lease) == nil, "released token has no value")
    weak_remove_strong(target)
    weak_add_strong(target)
    weak_lease_require(weak_strong_count(target) == 0, "legacy calls cannot underflow or resurrect")

    weak_reset()
    val stale_target = weak_register(71)
    val stale_ref = weak_create(stale_target)
    val stale_lease = acquire_checked(stale_target)
    weak_reset()
    val replacement = weak_register(-1)
    val replacement_lease = acquire_checked(replacement)
    weak_lease_require(stale_target == replacement, "reset case must actually reuse target slot")
    weak_lease_require(stale_lease.token_id == replacement_lease.token_id, "reset case must actually reuse lease slot")
    weak_lease_require(stale_lease.generation != replacement_lease.generation, "reused lease slot gets fresh generation")
    weak_lease_require(not weak_is_alive(stale_ref), "reset must invalidate stale target generation")
    weak_lease_require(weak_upgrade(stale_ref) == -1, "legacy stale lookup stays expired")
    weak_lease_require(weak_upgrade_owned(stale_ref) == nil, "stale ref cannot acquire replacement")
    weak_lease_require(weak_lease_value(stale_lease) == nil, "reset revokes old lease")
    weak_lease_require(not weak_lease_release(stale_lease), "stale token cannot release replacement")
    weak_lease_require(weak_strong_count(replacement) == 2, "replacement retains both owners")
    weak_lease_require(weak_lease_value(replacement_lease) == Some(-1), "owned API distinguishes valid minus-one payload")
    weak_remove_strong(replacement)
    weak_lease_require(weak_lease_release(replacement_lease), "replacement lease release")
    weak_lease_require(weak_strong_count(replacement) == 0, "replacement final count")
    weak_reset()
    val shared_target = weak_register(93)
    val first = acquire_checked(shared_target)
    val second = acquire_checked(shared_target)
    val shared_observer = weak_create(shared_target)
    weak_remove_strong(shared_target)
    weak_lease_require(weak_strong_count(shared_target) == 2, "independent upgrades acquire independently")
    weak_lease_require(weak_lease_release(first), "first independent release")
    weak_lease_require(weak_is_alive(shared_observer), "second acquisition still retains lifetime")
    weak_lease_require(weak_lease_value(second) == Some(93), "second acquisition remains usable")
    weak_lease_require(weak_lease_release(second), "second independent release")
    weak_lease_require(not weak_is_alive(shared_observer), "last independent acquisition expires target")
    print "nogc-weak-lease: retained lifetime, expiration, reset generations and one-time release passed"
    0
