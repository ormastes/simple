use first.{Value as Numeric}
use second.{Value as Textual}

fn same_owner(left: Numeric, right: Numeric) -> i64:
    match (left, right):
        case (Int(a), Int(b)): a * 100 + b
        case (Float(a), Float(b)): a * 1000 + b
        case _: -1

fn mixed_owners(left: Numeric, right: Textual) -> i64:
    match (left, right):
        case (Int(a), Int(label)):
            if label == "right": a else: -2
        case (Float(a), Float(label)):
            if label == "fraction": a + 100 else: -3
        case _: -1

fn nested_owners(left: Numeric, right: Textual) -> i64:
    match ((left, right), left):
        case ((Int(a), Int(label)), Int(b)):
            if label == "nested": a * 10 + b else: -2
        case _: -1

fn main() -> i64:
    if same_owner(Numeric.Int(3), Numeric.Int(7)) != 307: return 1
    if same_owner(Numeric.Float(2), Numeric.Float(9)) != 2009: return 2
    if same_owner(Numeric.Int(3), Numeric.Float(7)) != -1: return 3
    if mixed_owners(Numeric.Int(11), Textual.Int("right")) != 11: return 4
    if mixed_owners(Numeric.Float(4), Textual.Float("fraction")) != 104: return 5
    if mixed_owners(Numeric.Int(11), Textual.Float("right")) != -1: return 6
    if nested_owners(Numeric.Int(5), Textual.Int("nested")) != 55: return 7
    print "declared_tuple_match_owner: PASS"
    0
