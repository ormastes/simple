# Isolates the production cas_batch_error_v1<T> shape without unwrap_err.
enum TransactionError:
    generation_changed

struct Transaction:
    closed: bool

fn batch_error<T>(error: TransactionError) -> Result<T, TransactionError>:
    Err(error)

fn main() -> i64:
    val record: Result<Transaction, TransactionError> = batch_error<Transaction>(TransactionError.generation_changed)
    val scalar: Result<text, TransactionError> = batch_error<text>(TransactionError.generation_changed)
    val unit: Result<(), TransactionError> = batch_error<()>(TransactionError.generation_changed)
    match record:
        case Err(TransactionError.generation_changed): ()
        case _: return 21
    match scalar:
        case Err(TransactionError.generation_changed): ()
        case _: return 22
    match unit:
        case Err(TransactionError.generation_changed): ()
        case _: return 23
    print "generic-result-error-pass"
    0
