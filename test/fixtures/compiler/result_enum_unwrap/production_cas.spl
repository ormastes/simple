# Separate actual-owner compilation; runtime covers inheritance error values,
# not the filesystem-backed transaction-seal propagation call site.
use compiler.driver.cache.cas_batch_transaction.{
    CasBatchTransactionErrorV1, cas_batch_inherit_mappings_v1
}

fn main() -> i64:
    val digest = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    val mapping = "package|{digest}|{digest}"
    match cas_batch_inherit_mappings_v1(["malformed"], []):
        case Err(CasBatchTransactionErrorV1.generation_corrupt): ()
        case _: return 41
    match cas_batch_inherit_mappings_v1([], [mapping, mapping]):
        case Err(CasBatchTransactionErrorV1.duplicate_mapping): ()
        case _: return 42
    match cas_batch_inherit_mappings_v1([mapping], []):
        case Ok(values):
            val inherited: [text] = values
            if inherited.len() != 1: return 43
            if inherited[0] != mapping: return 44
        case _: return 45
    print "production-cas-enum-error-pass"
    0
