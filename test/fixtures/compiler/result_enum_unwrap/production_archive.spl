# Separate, explicitly budgeted actual-owner probe; not in the tiny launcher.
use compiler.hir.archive.interface_action_archive.{
    InterfaceActionArchiveErrorV1, InterfaceActionArchiveV1,
    SemanticContext, CompileActionRegistry, RouteArchiveInstallTransactionV1,
    interface_action_archive_payloads_decode_v1, route_archive_install_commit_v1
}
use compiler.driver.cache.package_tldr_metadata.{ConfigVariantKeyV1}

fn main() -> i64:
    val digest = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    val symbol = "symbol|entry|function|i64|{digest}"
    val action = "action|compile-entry|compile|entry|{digest}"
    match interface_action_archive_payloads_decode_v1("malformed", action):
        case Err(InterfaceActionArchiveErrorV1.malformed_interface): ()
        case _: return 31
    match interface_action_archive_payloads_decode_v1(symbol, "malformed"):
        case Err(InterfaceActionArchiveErrorV1.malformed_action): ()
        case _: return 32
    match interface_action_archive_payloads_decode_v1(symbol, action):
        case Ok(_): ()
        case _: return 33
    val variant = ConfigVariantKeyV1("archive", "archive", [], "archive", "v1", [], [])
    val archive = InterfaceActionArchiveV1("existing", variant, digest, [], digest, digest, [], [])
    var transaction = RouteArchiveInstallTransactionV1([archive], ["existing"], false)
    var semantic = SemanticContext(["existing"], [])
    var actions = CompileActionRegistry([], [])
    match route_archive_install_commit_v1(&mut transaction, &mut semantic, &mut actions):
        case Err(InterfaceActionArchiveErrorV1.install_conflict): ()
        case _: return 34
    if not transaction.closed: return 35
    print "production-archive-enum-error-pass"
    0
