enum Wire:
    Empty
    TupleOnly((i64, i64))
    Named(count: i64, label: text)
fn first(w: Wire) -> i64:
    match w:
        case Wire.TupleOnly(p): p.0 * 10 + p.1
        case Wire.Named(count, label): count + label.len()
        case _: -1
fn main() -> i64:
    val a = first(Wire.TupleOnly((7, 9)))
    val b = first(Wire.Named(4, "ab"))
    if a == 79 and b == 6:
        print("PASS ha2_tuplit")
        return 0
    print("FAIL ha2_tuplit a={a} b={b}")
    return 1
