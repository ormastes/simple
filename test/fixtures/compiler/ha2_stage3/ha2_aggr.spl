struct Reg:
    keys: [text]
    rows: [Row]
struct Row:
    id: text
fn has(r: &mut Reg, k: text) -> bool:
    r.keys.contains(k)
fn main() -> i64:
    var r = Reg(keys: ["a", "b"], rows: [Row(id: "x"), Row(id: "y")])
    var n = 0
    for row in r.rows:
        if row.id.len() == 1: n = n + 1
    val parts = if n == 0: [] else: "p|q".split("|")
    if has(&mut r, "b") and not has(&mut r, "z") and n == 2 and parts.len() == 2 and parts[1] == "q":
        print("PASS ha2_aggr")
        return 0
    print("FAIL ha2_aggr")
    return 1
