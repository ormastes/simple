struct Reg:
    keys: [text]
    rows: [Row]
struct Row:
    id: text
fn has(r: &mut Reg, k: text) -> bool:
    r.keys.contains(k)
fn has_typed(r: &mut Reg, k: text) -> bool:
    val keys: [text] = r.keys
    keys.contains(k)
fn main() -> i64:
    var r = Reg(keys: ["a", "b"], rows: [Row(id: "x"), Row(id: "y")])
    var n = 0
    for row in r.rows:
        if row.id.len() == 1: n = n + 1
    val parts = if n == 0: [] else: "p|q".split("|")
    val typed_parts: [text] = if n == 0: [] else: "p|q".split("|")
    print("has_b={has(&mut r, "b")} has_z={has(&mut r, "z")} typed_b={has_typed(&mut r, "b")} typed_z={has_typed(&mut r, "z")}")
    print("n={n} parts={parts.len()} typed_parts={typed_parts.len()}")
    if parts.len() == 2: print("p1={parts[1]}")
    0
