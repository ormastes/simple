enum Choice:
    Many(count: i64 = 9, label: text = "d")
    One
fn c(x: Choice) -> i64:
    match x:
        case Choice.Many(count, label): count * 10 + label.len()
        case Choice.One: 0
fn main() -> i64:
    val a = c(Choice.Many())
    val b = c(Choice.Many(count: 2))
    if a == 91 and b == 21:
        print("PASS ha2_namedef")
        return 0
    print("FAIL ha2_namedef a={a} b={b}")
    return 1
