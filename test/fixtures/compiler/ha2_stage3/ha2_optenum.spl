enum Err:
    Orphan(name: text, suggestion: text?)
fn mk(n: i64) -> Err:
    val suggestion = if n > 0:
        Some("wrap it")
    else:
        nil
    Err.Orphan(name: "t", suggestion: suggestion)
fn main() -> i64:
    var ok = false
    match mk(1):
        case Err.Orphan(name, suggestion):
            match mk(0):
                case Err.Orphan(n2, s2):
                    ok = name == "t" and suggestion.? and suggestion.unwrap() == "wrap it" and not s2.?
    if ok:
        print("PASS ha2_optenum")
        return 0
    print("FAIL ha2_optenum")
    return 1
