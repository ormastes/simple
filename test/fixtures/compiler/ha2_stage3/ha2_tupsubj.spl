enum Ty:
    Function([text], text, bool)
    Int
fn compose(x: Ty, y: Ty) -> i64:
    match (x, y):
        case (Ty.Function(a, b, _), Ty.Function(c, d, _)):
            var n = 0
            for p in a:
                n = n + p.len()
            for q in c:
                n = n + q.len()
            n * 100 + b.len() * 10 + d.len()
        case _: -1
fn main() -> i64:
    val r = compose(Ty.Function(["ab", "c"], "rr", true), Ty.Function(["xyz"], "s", false))
    if r == 621:
        print("PASS ha2_tupsubj")
        return 0
    print("FAIL ha2_tupsubj r={r}")
    return 1
