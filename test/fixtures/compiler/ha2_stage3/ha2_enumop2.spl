enum Kind:
    Code
    Data
    Meta
struct Sec:
    kind: Kind
    size: i64
fn find_size(secs: [Sec], k: Kind) -> i64:
    for s in secs:
        if s.kind == k:
            return s.size
    -1
fn main() -> i64:
    val secs = [Sec(kind: Kind.Code, size: 1), Sec(kind: Kind.Meta, size: 3)]
    val k = Kind.Meta
    print("eq_direct={Kind.Code == Kind.Code} ne_direct={Kind.Code != Kind.Data} local={k == Kind.Meta} field={secs[1].kind == Kind.Meta} field_ne={secs[0].kind == Kind.Meta}")
    print("find_meta={find_size(secs, Kind.Meta)} find_data={find_size(secs, Kind.Data)}")
    0
