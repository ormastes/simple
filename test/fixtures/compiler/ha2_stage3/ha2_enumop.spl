enum Kind:
    Code
    Data
    Meta
struct Sec:
    kind: Kind
    size: i64
fn find(secs: [Sec], k: Kind) -> Sec?:
    for s in secs:
        if s.kind == k:
            return Some(s)
    nil
fn main() -> i64:
    val secs = [Sec(kind: Kind.Code, size: 1), Sec(kind: Kind.Meta, size: 3)]
    val a = find(secs, Kind.Meta)
    val b = find(secs, Kind.Data)
    if a.?  and a.unwrap().size == 3 and not b.? and Kind.Code != Kind.Data:
        print("PASS ha2_enumop")
        return 0
    print("FAIL ha2_enumop")
    return 1
