enum Ty:
    Pair(text, i64)
    Fn([text], text)
fn f(t: Ty) -> i64:
    match t:
        case Ty.Pair(name, width):
            name.len() + width
        case Ty.Fn(params, ret):
            params.len() * 10 + ret.len()
fn main() -> i64:
    val a = f(Ty.Pair("abc", 4))
    val b = f(Ty.Fn(["x", "y"], "rr"))
    if a == 7 and b == 22:
        print("PASS ha2_binders")
        return 0
    print("FAIL ha2_binders a={a} b={b}")
    return 1
