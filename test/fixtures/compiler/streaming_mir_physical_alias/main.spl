# Both imports resolve to one physical manifest. Streaming HIR admits one
# typed source receipt; MIR/native publication must produce one owner too.
use std.sfm.manifest.{LayerKind, layer_kind_to_byte}
use lib.nogc_sync_mut.sfm.manifest.{SfmSecurityLevel, security_level_to_byte}

fn main() -> i32:
    var failures: i32 = 0
    if layer_kind_to_byte(LayerKind.FrontGui) != 0: failures = failures + 1
    print "check=front-gui failures={failures}"
    if layer_kind_to_byte(LayerKind.BackHw) != 4: failures = failures + 1
    print "check=back-hw failures={failures}"
    if security_level_to_byte(SfmSecurityLevel.Ordinary) != 0: failures = failures + 1
    print "check=ordinary failures={failures}"
    if security_level_to_byte(SfmSecurityLevel.Trusted) != 1: failures = failures + 1
    print "check=trusted failures={failures}"
    print "streaming MIR physical alias: 4 checks, {failures} failures"
    failures
