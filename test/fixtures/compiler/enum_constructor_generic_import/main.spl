# Compatibility oracle for imported and reexported generic declaration owners.
# Native UNRUN. No claim that the prior generic specialization route passes.
use .facade.{PayloadBox}

fn integer_box() -> PayloadBox<i64>:
    PayloadBox.Value(41)

fn text_box() -> PayloadBox<text>:
    PayloadBox.Value("kept")

fn main() -> i64:
    val number = match integer_box():
        case PayloadBox.Value(value): value
    val label = match text_box():
        case PayloadBox.Value(value): value
    if number == 41 and label == "kept": 0 else: 1
