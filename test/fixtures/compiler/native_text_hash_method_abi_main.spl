# Tagged text methods must use rt_hash_text, not the raw C-string rt_str_hash.
# Run as a real native executable with the core-c-bootstrap runtime provider.
extern fn rt_hash_text(value: text) -> i64

struct HashBox:
    value: i64

impl HashBox:
    fn hash() -> i64:
        self.value

fn typed_hash(value: text) -> i64:
    value.hash()

fn check_hash(value: text, expected: i64) -> bool:
    val direct = rt_hash_text(value)
    val method = value.hash()
    val forwarded = typed_hash(value)
    print "direct={direct} method={method} forwarded={forwarded} expected={expected}"
    direct == expected and method == expected and forwarded == expected

fn main() -> i64:
    var failed = 0
    if not check_hash("", -3750763034362895579):
        failed = failed + 1
    if not check_hash("hello", -6615550055289275125):
        failed = failed + 1
    if not check_hash("a\0b", -1886276961191958862):
        failed = failed + 1
    if not check_hash("héllo", -6674344407707008800):
        failed = failed + 1
    val literal_hash = "hello".hash()
    val custom = HashBox(value: 73)
    val user_hash = custom.hash()
    print "literal={literal_hash} user={user_hash}"
    if literal_hash != -6615550055289275125:
        failed = failed + 1
    if user_hash != 73:
        failed = failed + 1
    if failed != 0:
        return failed
    print "Results: 14 passed, 0 failed"
    return 0
