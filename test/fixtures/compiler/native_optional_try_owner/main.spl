# Expected native stdout: OPTIONAL_TRY_OWNER_PASS
# The returned table's owner is supplied by the provider, not a lexical import.
use provider.{ProbeDatabase, make_probe_database}

class ProbeTable:
    decoy: i64

fn update_present(db: ProbeDatabase, present: bool) -> i64?:
    # Original failing shape: no explicit type annotation on the Try result.
    val table = db.get_table(present)?
    table.update(41)
    Some(table.read())

fn main() -> i64:
    val decoy = ProbeTable(decoy: 99)
    val db = make_probe_database()
    val alias = db.table
    if update_present(db, true) != Some(41): return 1
    if db.calls != 1: return 2
    if alias.read() != 41: return 3
    alias.update(13)
    if update_present(db, false) != None: return 4
    if db.calls != 2: return 5
    if alias.read() != 13: return 6
    if decoy.decoy != 99: return 7
    print "OPTIONAL_TRY_OWNER_PASS"
    0
