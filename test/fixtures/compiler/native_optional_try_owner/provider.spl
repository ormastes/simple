class ProbeTable:
    value: i64

    me update(value: i64):
        self.value = value

    fn read() -> i64:
        self.value

class ProbeDatabase:
    table: ProbeTable
    calls: i64

    me get_table(present: bool) -> ProbeTable?:
        self.calls = self.calls + 1
        if not present: return None
        Some(self.table)

fn make_probe_database() -> ProbeDatabase:
    ProbeDatabase(table: ProbeTable(value: 7), calls: 0)
