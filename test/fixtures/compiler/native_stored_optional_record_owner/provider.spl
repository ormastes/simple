struct SdnTable:
    name: text
    rows: [[text]]

struct OtherTable:
    rows: i64

fn parse_sdn_table(source: text) -> SdnTable?:
    if source == "":
        return nil
    Some(SdnTable(name: source, rows: [["a", "17"], ["b", "23"]]))

fn other_table() -> OtherTable?:
    Some(OtherTable(rows: 99))
