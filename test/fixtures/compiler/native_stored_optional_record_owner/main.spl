use provider.{SdnTable as ProviderTable, OtherTable as ProviderOtherTable, parse_sdn_table, other_table}

# Contest the provider's leaf name, first field, and consumer numeric IDs.
struct SdnTable:
    rows: text

fn sum_stored_rows(source: text) -> i64:
    val decoy = SdnTable(rows: "consumer")
    assert(decoy.rows == "consumer")
    var table = parse_sdn_table(source)
    # The other Optional instantiation must not overwrite Some's layout.
    val unrelated = other_table()
    match unrelated:
        case Some(other):
            assert(other.rows == 99)
        case None:
            assert(false)
    var total = 0
    match table:
        case Some(t):
            assert(t.name == source)
            for row in t.rows:
                assert(row.len() == 2)
                total = total + row[1].to_int()
        case None:
            assert(source == "")
    table = nil
    assert(table == nil)
    total

fn main():
    assert(sum_stored_rows("example") == 40)
    assert(sum_stored_rows("") == 0)
    print("stored optional provider record assertions passed")
