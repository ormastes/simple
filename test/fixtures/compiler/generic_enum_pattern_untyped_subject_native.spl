# Qualified generic-enum variant patterns over UNTYPED match subjects.
#
# The subject type is not inferred in these shapes (match-expression value,
# `.unwrap()`, `Ok(x)` binder). Variants whose payload binds no type parameter
# (`_`) must still lower; a binder over `T` keeps failing closed.
#
# Expected stdout is in generic_enum_pattern_untyped_subject_native.spl.expected.

enum P<T>:
    Ready(T)
    Pending(i64)

fn get() -> Result<P<i64>, text>:
    Ok(P.Pending(3))

# Shape 1: subject is a match-expression value.
fn shape_match_value() -> i64:
    val v = match get():
        case Err(e): return 1
        case Ok(x): x
    match v:
        case P.Ready(_): print "p1 ready"
        case P.Pending(t): print "p1 pending {t}"
    0

# Shape 2: subject came from an Ok(x) binder.
fn shape_ok_binder() -> i64:
    val r = get()
    match r:
        case Ok(x):
            match x:
                case P.Ready(_): print "p6 ready"
                case P.Pending(t): print "p6 pending {t}"
        case Err(e): return 1
    0

# Shape 3: subject came from .unwrap().
fn shape_unwrap() -> i64:
    val v = get().unwrap()
    match v:
        case P.Ready(_): print "p4 ready"
        case P.Pending(t): print "p4 pending {t}"
    0

fn main() -> i64:
    if shape_match_value() != 0: return 1
    if shape_ok_binder() != 0: return 2
    if shape_unwrap() != 0: return 3
    0
