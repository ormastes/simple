# Device-free fixture for
# test/02_integration/compiler/backend/run_path_extern_text_return_abi_native_spec.spl
#
# Regression fixture for
# doc/08_tracking/bug/run_path_extern_text_corruption_causes_false_gpu_skip_2026-08-20.md
# Exercises the four corruption shapes the bug doc recorded on the `run` path:
#   (a) inline `val` binding of an extern-returned text, then `.len()` / `==`
#   (b) the same value passed across a function-parameter boundary
#   (b-direct) an extern call result passed straight into a parameter
#   (c) concatenation with a literal (the doc saw the whole concat collapse,
#      silently discarding the literal prefix)
# Uses two runtime externs with different text ABIs: rt_text_to_lower_ascii
# (boxed value ABI) and rt_path_basename (ptr+len ABI). Corruption sentinel
# per the bug doc: len() == -1, == "discrete" false, empty concat line.
# Output is byte-exact; the spec asserts it in full.

extern fn rt_text_to_lower_ascii(s: text) -> text
extern fn rt_path_basename(path: text) -> text

fn report(label: text, t: text):
    print(label + " len=" + t.len().to_text() + " eq=" + (t == "discrete").to_text())

fn consume(t: text):
    report("param", t)

fn main():
    # (a) inline binding, consumed in main directly
    val inline_v = rt_text_to_lower_ascii("DISCRETE")
    report("inline", inline_v)

    # (b) cross-function parameter boundary via a named binding
    val cross_v = rt_text_to_lower_ascii("DISCRETE")
    consume(cross_v)

    # (b-direct) extern result fed straight into the parameter
    consume(rt_text_to_lower_ascii("DISCRETE"))

    # (c) concatenation with a literal
    print("concat " + rt_text_to_lower_ascii("DISCRETE"))

    # second extern family: rt_path_basename (ptr+len ABI)
    val base_inline = rt_path_basename("/usr/share/discrete")
    report("basename-inline", base_inline)
    consume(rt_path_basename("/usr/share/discrete"))
    print("concat " + rt_path_basename("/usr/share/discrete"))

    print("TEXT-EXTERN OK")
