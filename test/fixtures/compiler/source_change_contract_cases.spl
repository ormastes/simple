use std.common.source_change.contracts_v1.*

pub fn source_contract_limits_v1() -> SourceChangeLimitsV1:
    SourceChangeLimitsV1(max_path_bytes: 128, max_identity_bytes: 64,
        max_metadata_bytes: 1024, max_capture_bytes: 32, max_files: 4, max_edits: 4)

pub fn source_contract_batch_v1() -> SourceChangeBatchV1:
    val digest = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    SourceChangeBatchV1(schema: 1, root_identity: digest,
        before_root_digest: digest, after_root_digest: digest, sequence: 1,
        edits: [], complete: false)

pub fn source_contract_edit_v1() -> SourceEditV1:
    SourceEditV1(path: "src/a.spl", old_snapshot: "buffer:1",
        old_start_byte: 0, old_end_byte: 2,
        new_bytes_digest: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        new_byte_len: 4, origin: EditOriginV1.Ide, transaction_id: "txn-1")

pub fn source_contract_case_v1(index: i64) -> SourceChangeShapeV1:
    var batch: SourceChangeBatchV1 = source_contract_batch_v1()
    var limits: SourceChangeLimitsV1 = source_contract_limits_v1()
    var edit: SourceEditV1 = source_contract_edit_v1()
    if index == 0:
        return source_change_batch_shape_v1(batch, limits)
    batch.edits = [edit]
    if index == 1:
        batch.complete = true
    elif index == 2:
        batch.schema = 2
    elif index == 3:
        batch.sequence = 0
    elif index == 4:
        batch.root_identity = "invalid"
    elif index == 5:
        edit.new_bytes_digest = "E3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    elif index == 6:
        edit.path = "../outside.spl"
    elif index == 7:
        edit.old_snapshot = ""
    elif index == 8:
        edit.old_start_byte = 4
        edit.old_end_byte = 2
    elif index == 9:
        edit.new_byte_len = 33
    elif index == 10:
        limits.max_edits = 0
    elif index == 11:
        edit.transaction_id = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    elif index == 12:
        limits.max_metadata_bytes = 191
    elif index == 13:
        limits.max_metadata_bytes = 200
    elif index == 14:
        edit.new_byte_len = 18
        batch.edits = [edit, edit]
        return source_change_batch_shape_v1(batch, limits)
    elif index == 15:
        edit.transaction_id = edit.path
        limits.max_path_bytes = 128
        limits.max_identity_bytes = 64
        edit.path = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        edit.transaction_id = edit.path
    else:
        return SourceChangeShapeV1(valid: false, reason: "invalid_test_case")
    batch.edits = [edit]
    source_change_batch_shape_v1(batch, limits)

pub fn source_contract_expected_reason_v1(index: i64) -> text:
    val reasons: [text] = ["well_formed_change_batch", "well_formed_change_batch",
        "unsupported_schema", "invalid_sequence", "invalid_root_digest",
        "invalid_payload_digest", "invalid_path", "missing_edit_identity",
        "byte_extent_over_bound", "byte_extent_over_bound", "edit_count_over_bound",
        "identity_over_bound", "metadata_over_bound", "metadata_over_bound",
        "payload_over_bound", "identity_over_bound"]
    if index < 0 or index >= reasons.len(): return "invalid_test_case"
    reasons[index]
