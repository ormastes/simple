use compiler.backend.backend.llvm_cross_target.{toolchain_for_host, toolchain_for_target}
use compiler.backend.backend.backend_types.{CodegenTarget}

fn main() -> i64:
    val tc = toolchain_for_host("macos", "arm64")
    if tc.triple != "aarch64-apple-darwin": return 11
    if tc.default_flags != ["-arch", "arm64", "-lSystem"]: return 12
    val host = toolchain_for_target(CodegenTarget.Host)
    if host.triple != "aarch64-apple-darwin": return 13
    val native = toolchain_for_target(CodegenTarget.Native)
    if native.triple != "aarch64-apple-darwin": return 14
    print "PASS LLVM ARM64 macOS host toolchain"
    0
