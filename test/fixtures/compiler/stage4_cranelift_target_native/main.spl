use compiler.backend.codegen.{CodegenMode, CodegenPipeline, CraneliftTarget}

fn main() -> i64:
    val native_pipeline = CodegenPipeline.aot(CraneliftTarget.Native)
    val x86_pipeline = CodegenPipeline.aot(CraneliftTarget.X86_64)
    if native_pipeline.target != CraneliftTarget.Native: return 41
    if x86_pipeline.target != CraneliftTarget.X86_64: return 42
    if native_pipeline.mode != CodegenMode.Aot: return 43
    if x86_pipeline.mode != CodegenMode.Aot: return 44
    0
