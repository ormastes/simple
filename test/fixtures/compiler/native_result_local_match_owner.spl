enum OtherVerdict:
    Ok(i64)
    Err(text)

struct Src:
    value: i64

impl Src:
    fn read(self, succeed: bool) -> Result<i64, text>:
        if succeed: Ok(self.value)
        else: Err("method-error")

trait Reader:
    fn fetch(self, succeed: bool) -> Result<i64, text>

impl Reader for Src:
    fn fetch(self, succeed: bool) -> Result<i64, text>:
        if succeed: Ok(self.value + 1)
        else: Err("trait-error")

fn wrap<T>(v: T, succeed: bool) -> Result<T, text>:
    if succeed: Ok(v)
    else: Err("generic-error")

fn main() -> i64:
    val s: Src = Src(value: 29)
    val r1: Result<i64, text> = s.read(true)
    val good = match r1:
        case Ok(v): v
        case Err(_): -1
    val r2: Result<i64, text> = s.read(false)
    val bad = match r2:
        case Ok(_): "wrong"
        case Err(d): d
    val r3: Result<i64, text> = s.fetch(true)
    val tgood = match r3:
        case Ok(v): v
        case Err(_): -1
    val r4: Result<i64, text> = s.fetch(false)
    val tbad = match r4:
        case Ok(_): "wrong"
        case Err(d): d
    val r5: Result<i64, text> = wrap(7, true)
    val ggood = match r5:
        case Ok(v): v
        case Err(_): -1
    val r6: Result<i64, text> = wrap(7, false)
    val gbad = match r6:
        case Ok(_): "wrong"
        case Err(d): d
    val o: OtherVerdict = OtherVerdict.Err("other")
    val ob = match o:
        case Ok(_): "wrong"
        case Err(d): d
    if good != 29 or bad != "method-error": return 1
    if tgood != 30 or tbad != "trait-error": return 2
    if ggood != 7 or gbad != "generic-error": return 3
    if ob != "other": return 4
    print "result-local-match-owner: PASS"
    0
