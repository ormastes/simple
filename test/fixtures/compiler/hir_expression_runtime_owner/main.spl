# Actual expression consumers must share one foreign declaration owner.
use compiler.hir.hir_lowering._Expressions.expression_support.*
use compiler.hir.hir_lowering._Expressions.match_desugaring.*
use compiler.hir.hir_lowering._Expressions.runtime_observation.{hir_expr_runtime_discriminant}
use compiler.hir.hir_types.{HirPatternKind}
use compiler.frontend.parser_types_expr.{ExprKind}

fn main() -> i64:
    val absent = hir_expr_env_get("SIMPLE_EXTERN_OWNER_ABSENT_20261017")
    if absent != nil: return 1
    val pattern_disc = hir_expr_runtime_discriminant<HirPatternKind>(HirPatternKind.Wildcard)
    if pattern_disc < 0: return 2
    0
