struct Owner:
    id: i64

enum Packet:
    Pair(i64?, Owner?)

fn make(value: i64, owner: Owner) -> Packet:
    Packet.Pair(Some(value), Some(owner))

fn score(packet: Packet) -> i64:
    match packet:
        case Packet.Pair(number, owner):
            if val n = number:
                if val o = owner:
                    return n + o.id
                return n
            -1

fn main() -> i64:
    if score(make(3, Owner(id: 40))) != 43: return 11
    if score(make(0, Owner(id: 7))) != 7: return 12
    if score(make(-3, Owner(id: 8))) != 5: return 13
    if score(Packet.Pair(Some(3), nil)) != 3: return 14
    if score(Packet.Pair(nil, nil)) != -1: return 15
    0
