struct ReceiverCapability:
    platform: text
    backend: text

class ReceiverProbe:
    capability: ReceiverCapability
    commands: [i64]
    device_started: bool
    device_handle: i64
    playback_handles: [i64]

impl ReceiverProbe:
    me can_play_after_local_buffer() -> bool:
        var samples: [f32] = []
        var frame: i64 = 0
        while frame < 2880:
            samples.push(0.0f32)
            samples.push(0.0f32)
            frame = frame + 1
        if not self.device_started:
            return false
        true

fn main() -> i64:
    var probe = ReceiverProbe(
        capability: ReceiverCapability(
            platform: "ci",
            backend: "none"
        ),
        commands: [],
        device_started: false,
        device_handle: 0,
        playback_handles: []
    )
    if probe.can_play_after_local_buffer():
        return 1
    0
