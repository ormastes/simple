# Native fixture: an array-HOF lambda parameter reads the element record's field.
# Expect stdout `map=3,6 filter=1 any=1 all=1` and exit 0. A field-0 read prints
# `map=1,4 filter=2 any=0 all=0` and exits 1 (Stage 2 bootstrap-fable-13).
# Spec: test/01_unit/compiler/50.mir/array_hof_lambda_record_param_field_spec.spl
struct S:
    a: i64
    b: i64
    c: i64
fn main() -> i64:
    val xs = [S(a: 1, b: 0, c: 3), S(a: 4, b: 5, c: 6)]
    val m = xs.map(\f: f.c)
    val n = xs.filter(\f: f.b != 0).len()
    var y = 0
    if xs.any(\f: f.c == 6): y = 1
    var z = 0
    if xs.all(\f: f.c > 2): z = 1
    print("map={m[0]},{m[1]} filter={n} any={y} all={z}")
    if m[0] == 3 and m[1] == 6 and n == 1 and y == 1 and z == 1: return 0
    return 1
