# Native original-boundary regression; no seed/interpreter substitution.
enum Collision:
    Ok(code: i64)
    Err(message: text)

struct TypedResult:
    success: bool
    code: [u8]
    has_error: bool
    error: text

fn hir_invoke_real_owner(typed_result: TypedResult) -> i64:
    val code_result = if typed_result.success:
        Ok(typed_result.code)
    elif typed_result.has_error:
        Err(typed_result.error)
    else:
        Err(if typed_result.has_error: typed_result.error else: "Unknown error")
    match code_result:
        case Ok(compiled_code):
            if compiled_code.len() != 2: return 11
            if compiled_code[0] != 7u8 or compiled_code[1] != 19u8: return 12
            return 101
        case Err(msg):
            if msg == "typed failure": return 202
            if msg == "Unknown error": return 303
            return 13

fn main() -> i64:
    if hir_invoke_real_owner(TypedResult(true, [7u8, 19u8], false, "")) != 101: return 21
    if hir_invoke_real_owner(TypedResult(false, [7u8, 19u8], true, "typed failure")) != 202: return 22
    if hir_invoke_real_owner(TypedResult(false, [7u8, 19u8], false, "")) != 303: return 23
    print "PASS:hir-if-result-ifchain"
    0
