# Native guard: an untyped Ok/Err join whose payload is a type parameter is
# generic, never a concrete Result witness (PR #8486 follow-up, finding 2).
fn wrap<T>(x: T, c: bool) -> i64:
    val r = if c: Ok(x) else: Err("generic")
    match r:
        case Ok(_): return 101
        case Err(m):
            if m == "generic": return 202
            return 13

fn main() -> i64:
    if wrap(7, true) != 101: return 21
    if wrap(7, false) != 202: return 22
    if wrap("s", true) != 101: return 23
    if wrap("s", false) != 202: return 24
    print "PASS:hir-if-result-generic_payload"
    0
