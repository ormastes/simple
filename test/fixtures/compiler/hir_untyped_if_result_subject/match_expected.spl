# Native guard: an Ok/Err-only match lowered under an expected Result type
# keeps that type; the untyped-constructor join is withheld there exactly as
# it is for the if/elif joins (PR #8486 follow-up, review finding 1).
enum Collision:
    Ok(code: i64)
    Err(message: text)

enum Sel:
    A
    B

fn tail_pick(s: Sel, x: u8) -> Result<i64, text>:
    match s:
        case Sel.A: Ok(x)
        case _: Err("tail")

fn let_pick(s: Sel) -> i64:
    val r: Result<u8, text> = match s:
        case Sel.A: Ok(5u8)
        case _: Err("let")
    match r:
        case Ok(v):
            val wrapped = v + 255u8
            if wrapped != 4u8: return 12
            return 101
        case Err(m):
            if m == "let": return 202
            return 13

fn main() -> i64:
    match tail_pick(Sel.A, 5u8):
        case Ok(v):
            if v + 255 != 260: return 21
        case Err(_): return 22
    match tail_pick(Sel.B, 5u8):
        case Ok(_): return 23
        case Err(m):
            if m != "tail": return 24
    if let_pick(Sel.A) != 101: return 25
    if let_pick(Sel.B) != 202: return 26
    print "PASS:hir-if-result-match_expected"
    0
