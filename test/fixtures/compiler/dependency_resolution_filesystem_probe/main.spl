# Run from the repository root after native compilation with a qualified producer.
# The actual resolver owner must resolve both filesystem names through its facade.
use compiler.common.dependency.resolution.{resolve_segment_with_numbering}
use std.io_runtime.{file_exists, dir_exists}

fn main() -> i64:
    val parent = "test/fixtures/compiler"
    val name = "dependency_resolution_filesystem_probe"
    val directory = parent + "/" + name
    val missing = "__missing_dependency_resolution_probe_20261106__"
    if not dir_exists(directory): return 11
    if not file_exists(directory + "/main.spl"): return 12
    if dir_exists(directory + "/main.spl"): return 13
    if file_exists(directory + "/" + missing) or dir_exists(directory + "/" + missing): return 14
    if resolve_segment_with_numbering(parent, name) != name: return 15
    if resolve_segment_with_numbering(directory, "main.spl") != "main.spl": return 16
    if resolve_segment_with_numbering(directory, missing) != missing: return 17
    print "dependency resolution filesystem probes OK"
    0
