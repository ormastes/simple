# Run from the repository root after native compilation with a qualified producer.
# The actual resolver owner must resolve both filesystem names through its facade.
use compiler.common.dependency.resolution.{Segment, ModPath, FileKind, FileSystem,
    to_file_path, to_dir_path, resolve, resolve_segment_with_numbering}
use std.io_runtime.{file_exists, dir_exists}

fn main() -> i64:
    val parent = "test/fixtures/compiler"
    val name = "dependency_resolution_filesystem_probe"
    val directory = parent + "/" + name
    val missing = "__missing_dependency_resolution_probe_20261106__"
    if not dir_exists(directory): return 11
    if not file_exists(directory + "/main.spl"): return 12
    if dir_exists(directory + "/main.spl"): return 13
    if file_exists(directory + "/" + missing) or dir_exists(directory + "/" + missing): return 14
    if resolve_segment_with_numbering(parent, name) != name: return 15
    if resolve_segment_with_numbering(directory, "main.spl") != "main.spl": return 16
    if resolve_segment_with_numbering(directory, missing) != missing: return 17
    val module_path = ModPath(segments: [Segment(name: "alpha"), Segment(name: "beta")])
    val expected_file = "src/alpha/beta.spl"
    val expected_directory = "src/alpha/beta/__init__.spl"
    if to_file_path("src", module_path) != expected_file: return 21
    if to_dir_path("src", module_path) != expected_directory: return 22
    match resolve(FileSystem(files: [expected_file]), "src", module_path):
        case Unique(kind, path):
            if kind != FileKind.File: return 23
            if path != expected_file: return 24
        case _: return 25
    match resolve(FileSystem(files: [expected_directory]), "src", module_path):
        case Unique(kind, path):
            if kind != FileKind.Directory: return 26
            if path != expected_directory: return 27
        case _: return 28
    match resolve(FileSystem(files: [expected_file, expected_directory]), "src", module_path):
        case Ambiguous(file_path, dir_path):
            if file_path != expected_file: return 29
            if dir_path != expected_directory: return 30
        case _: return 31
    match resolve(FileSystem(files: []), "src", module_path):
        case NotFound: print "dependency resolution filesystem probes OK"
        case _: return 32
    0
