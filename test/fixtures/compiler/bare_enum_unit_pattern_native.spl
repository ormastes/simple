enum GateMode:
    Relaxed
    Acquire

fn number(mode: GateMode) -> i64:
    match mode:
        case Relaxed: 7
        case Acquire: 11

fn catch_all(mode: GateMode) -> i64:
    match mode:
        case Relaxed: 3
        case remaining: number(remaining)

fn qualified(mode: GateMode) -> i64:
    match mode:
        case GateMode.Relaxed: 7
        case GateMode.Acquire: 11

fn main() -> i64:
    if number(GateMode.Relaxed) != 7: return 1
    if number(GateMode.Acquire) != 11: return 2
    if catch_all(GateMode.Acquire) != 11: return 3
    if qualified(GateMode.Acquire) != 11: return 4
    0
