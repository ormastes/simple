# Fixture B for the module-private function name-collision class-detection spec.
# Same private helper NAME and signature as private_collision_mod_a.spl,
# different body. If module-private functions are resolved by name across the
# co-compiled module set, one of the two pub wrappers below silently calls the
# other module's body and returns a wrong answer with exit 0.

fn _collision_probe_shared(x: i64) -> i64: x + 100

pub fn probe_b(x: i64) -> i64: _collision_probe_shared(x)
