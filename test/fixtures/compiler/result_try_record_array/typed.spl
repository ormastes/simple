# Temporary typed-binding control for native-result-ok-record-inference-20261018.
# Unannotated root-fix acceptance lives in the separate compiler-fix candidate.
use test.fixtures.compiler.result_try_record_array.provider.{produce, Bundle as ProviderBundle, Entry}
struct Bundle:
    rows: i64
    marker: text
fn inspect(reject: bool) -> Result<i64, text>:
    val record: ProviderBundle = produce(reject)?
    var total = record.marker
    for row in record.rows:
        total = total + row.value
    Ok(total)

fn produce_local(reject: bool) -> Result<ProviderBundle, text>:
    if reject: return Err("local record rejected")
    Ok(ProviderBundle(marker: 23, rows: [Entry(code: 2, value: 5), Entry(code: 6, value: 13)]))
fn inspect_local(reject: bool) -> Result<i64, text>:
    val record: ProviderBundle = produce_local(reject)?
    var total = record.marker
    for row in record.rows:
        total = total + row.value
    Ok(total)

fn main() -> i32:
    match inspect(false):
        case Ok(value):
            if value != 37: return 1
        case Err(_): return 2
    match inspect(true):
        case Ok(_): return 3
        case Err(reason):
            if reason != "record rejected": return 4
    match inspect_local(false):
        case Ok(value):
            if value != 41: return 5
        case Err(_): return 6
    match inspect_local(true):
        case Ok(_): return 7
        case Err(reason):
            if reason != "local record rejected": return 8
    print "RESULT_TRY_RECORD_ARRAY_PASS cases=4"
    0
