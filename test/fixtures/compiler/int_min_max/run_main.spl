# Integer max/min/clamp/abs under `simple run` (seed JIT). Expected line is
# asserted by test/01_unit/compiler/50.mir/int_min_max_methods_spec.spl.
fn neg() -> i64:
    -4

fn main():
    val y = 5
    val n: i64 = -7
    val a: i32 = -7
    val big: u64 = 18446744073709551615
    val u: u64 = 3
    print "i64 {y.max(9)} {y.min(2)} {y.clamp(0, 3)} {n.abs()} {neg().max(0)}"
    print "i32 {a.max(-2)} {a.min(-9)} {a.clamp(-5, 5)} {a.abs()}"
    print "u64 {big.max(0)} {big.min(3)} {big.clamp(1, 10)} {big.abs()} {u.min(8)} {u.max(8)}"
