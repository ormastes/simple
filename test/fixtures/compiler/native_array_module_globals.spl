var NUMBERS: [i64] = [2, 3]
var WORDS: [text] = []

fn replace_arrays():
    NUMBERS = [5]
    WORDS = ["hello"]

fn main() -> i64:
    if NUMBERS.len() != 2: return 1
    if NUMBERS[0] != 2: return 2
    if NUMBERS[1] != 3: return 3
    if WORDS.len() != 0: return 4
    replace_arrays()
    if NUMBERS.len() != 1: return 5
    if NUMBERS[0] != 5: return 6
    if WORDS.len() != 1: return 7
    if WORDS[0] != "hello": return 8
    0
