use std.common.env_access.model.{EnvToolIdentity}
use std.common.rt_hal.model.{RtHalOperationKind}
use std.nogc_sync_mut.rt_hal.process_task_arena.{
    RtHalIsolatedHostPort, RtHalIsolatedHostCapabilities,
    RtHalProcessAdapter, RtHalProcessAdapterKind,
    rt_hal_process_host_install, rt_hal_process_adapter_register,
    rt_hal_process_controller_claim, rt_hal_process_exact_arena,
    rt_hal_process_arena_shutdown
}
use std.nogc_sync_mut.rt_hal.exact_boundary.{
    RtHalDigest256, RtHalExactRequest, RtHalCanonicalReceipt,
    RtHalExactJoin, RtHalExactArenaPort
}

var owner_calls = 0
var bind_calls = 0
var compare_calls = 0
var replay_calls = 0
var cancel_calls = 0
var cancel_handles = 0
var close_calls = 0
var close_handles = 0
var join_calls = 0
var shutdown_calls = 0

fn digest(word: i64) -> RtHalDigest256:
    RtHalDigest256(word0: word, word1: word + 1, word2: word + 2, word3: word + 3)

fn host_owner() -> i64:
    owner_calls = owner_calls + 1
    41

fn host_bind(handle: i64, provider: text, kind: text, tool_id: text, path: text, hash: text, schema: text) -> bool:
    bind_calls = bind_calls + 1
    handle == 2 and provider == "c-comparator" and kind == "c" and tool_id == "fixture" and path == "/opt/simple/fixture" and hash == "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" and schema == "rthal-scalar-v1"

fn valid_input(handle: i64, request: RtHalExactRequest, receipt: RtHalCanonicalReceipt) -> bool:
    handle == 2 and request.case_id == 7 and request.operation == RtHalOperationKind.Query and request.operation_digest.word0 == 30 and request.input_digest.word0 == 40 and receipt.case_id == 7 and receipt.observed_once and receipt.outcome_digest.word0 == 10 and receipt.error_digest.word0 == 20 and receipt.trace_digest.word0 == 30

fn host_compare(handle: i64, request: RtHalExactRequest, receipt: RtHalCanonicalReceipt) -> i64:
    if not valid_input(handle, request, receipt): return -1
    compare_calls = compare_calls + 1
    100 + compare_calls

fn host_replay(handle: i64, request: RtHalExactRequest, receipt: RtHalCanonicalReceipt) -> i64:
    if not valid_input(handle, request, receipt): return -1
    replay_calls = replay_calls + 1
    201

fn host_cancel(handle: i64, deadline: i64) -> bool:
    cancel_calls = cancel_calls + 1
    cancel_handles = cancel_handles + handle
    (handle == 101 or handle == 102) and deadline == 1000

fn host_close(handle: i64) -> bool:
    close_calls = close_calls + 1
    close_handles = close_handles + handle
    handle == 101 or handle == 201 or handle == 102

fn host_join(handle: i64, deadline: i64) -> RtHalExactJoin:
    join_calls = join_calls + 1
    RtHalExactJoin(completed: handle == 201 and deadline == 100,
        outcome_digest: digest(10), error_digest: digest(20), trace_digest: digest(30))

fn host_shutdown() -> bool:
    shutdown_calls = shutdown_calls + 1
    true

# Existing #2980 typed boundary for an indirect record return.
fn arena_join(arena: RtHalExactArenaPort, handle: i64) -> RtHalExactJoin:
    (arena.join_until_fn)(handle, 100)

fn main() -> i64:
    val host = RtHalIsolatedHostPort(
        capabilities: RtHalIsolatedHostCapabilities(
            available: true, canonical_executable_identity: true,
            static_executable_closure: true, fixed_scalar_argv: true,
            private_ipc: true, no_symlink_path_transport: true,
            process_tree_containment: true, bounded_timed_join: true,
            cancellation_and_reap: true, portable_host_contract: true),
        current_owner_fn: host_owner, bind_adapter_fn: host_bind,
        cancel_and_reap_fn: host_cancel, close_fn: host_close,
        spawn_compare_exact_fn: host_compare, spawn_replay_exact_fn: host_replay,
        join_exact_until_fn: host_join, shutdown_fn: host_shutdown)
    if rt_hal_process_host_install(host, 2) != "": return 11
    val adapter = RtHalProcessAdapter(handle: 2, provider_id: "c-comparator",
        kind: RtHalProcessAdapterKind.C,
        executable: EnvToolIdentity(tool_id: "fixture", canonical_path: "/opt/simple/fixture",
            identity_hash: "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"),
        query_capable: true, replay_capable: true)
    if rt_hal_process_adapter_register(adapter) != "": return 12
    if rt_hal_process_controller_claim() != "": return 13
    val arena: RtHalExactArenaPort = rt_hal_process_exact_arena()
    val request = RtHalExactRequest(case_id: 7, operation: RtHalOperationKind.Query,
        operation_digest: digest(30), input_digest: digest(40))
    val receipt = RtHalCanonicalReceipt(case_id: 7, outcome_digest: digest(10),
        error_digest: digest(20), trace_digest: digest(30), observed_once: true)
    val cancelled = (arena.spawn_compare_fn)(2, request, receipt)
    if cancelled <= 0 or not (arena.cancel_fn)(cancelled): return 14
    val replay = (arena.spawn_replay_fn)(2, request, receipt)
    if replay <= 0: return 15
    val joined = arena_join(arena, replay)
    if not joined.completed or joined.outcome_digest.word0 != 10 or joined.error_digest.word0 != 20 or joined.trace_digest.word0 != 30: return 16
    val pending = (arena.spawn_compare_fn)(2, request, receipt)
    if pending <= 0: return 17
    if rt_hal_process_arena_shutdown() != "": return 18
    if owner_calls != 9 or bind_calls != 1: return 21
    if compare_calls != 2 or replay_calls != 1 or join_calls != 1: return 22
    if cancel_calls != 2 or cancel_handles != 203: return 23
    if close_calls != 3 or close_handles != 404 or shutdown_calls != 1: return 24
    # Shutdown is idempotent and must not invoke a retained host callback.
    if rt_hal_process_arena_shutdown() != "" or shutdown_calls != 1: return 25
    print "process-arena-callback-fields: pass"
    0
