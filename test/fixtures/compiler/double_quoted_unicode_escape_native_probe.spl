# Compile with the repaired compiler, then execute. Expected bytes do not use
# the escape decoder under test. No legacy-producer success is implied.
fn main() -> i64:
    val nul = "a\u0000z"
    if nul.byte_len() != 3 or nul.byte_at(0) != 97 or nul.byte_at(1) != 0 or nul.byte_at(2) != 122: return 1
    val unicode = "\u00E9\uD55C\u{1F600}"
    val expected = [195, 169, 237, 149, 156, 240, 159, 152, 128]
    if unicode.byte_len() != expected.len(): return 2
    for index in 0..expected.len():
        if (unicode.byte_at(index) as i64) != expected[index]: return 3
    val name = "a"
    val framed = "{name}\u0000"
    if framed.byte_len() != 2 or framed.byte_at(0) != 97 or framed.byte_at(1) != 0: return 4
    val literal = "\\u0000"
    val raw = r"\u0000"
    if literal.byte_len() != 6 or raw.byte_len() != 6: return 5
    if literal != raw: return 6
    0
