# Repro for native_build_entry_module_loses_own_class_methods_multimodule_2026-08-17
# (native/stage3 only). Known-bad: "MIR lowering error: unresolved method call: bump".
use helper.{helper_value}

class Widget:
    n: i64

    me bump(k: i64):
        self.n = self.n + k

fn main():
    var w = Widget(n: helper_value())
    w.bump(1)
    print("w.n={w.n} expect=42")
