"""Negative native diagnostic: this executable must exit 1 before main continues."""

use std.nogc_sync_mut.io_runtime.{exit}

fn schema_input_require(condition: bool, message: text):
    if not condition:
        print "schema-input: FAIL {message}"
        exit(1)

fn main() -> i64:
    schema_input_require(false, "intentional negative guard control")
    print "FAIL-GUARD-UNREACHABLE: native guard failed to stop execution"
    0
