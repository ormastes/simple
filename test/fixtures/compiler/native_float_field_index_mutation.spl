struct ScoreBoard:
    scores: [f64]
    matched: [i64]

fn contribution(x: f64) -> f64:
    x * 0.5 + 0.25

fn empty_board(n: i64) -> ScoreBoard:
    var scores: [f64] = []
    var matched: [i64] = []
    var i = 0
    while i < n:
        scores.push(1.25)
        matched.push(0)
        i = i + 1
    ScoreBoard(scores: scores, matched: matched)

fn main() -> i64:
    var board = empty_board(2)
    var scores = board.scores
    var matched = board.matched
    for i in [0, 1]:
        scores[i] = scores[i] + contribution(1.0)
        matched[i] = matched[i] + 1
    if scores[0] != 2.0 or scores[1] != 2.0:
        return 1
    if matched[0] != 1 or matched[1] != 1:
        return 2
    var grid = [[1], [2]]
    grid[1].push(7)
    if grid[1].len() != 2 or grid[1][1] != 7:
        return 3
    print "float indexed store readback PASS"
    return 0
