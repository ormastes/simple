fn mk(present: bool) -> [i64]?:
    if present: return Some([1, 2, 3])
    nil

fn len_guarded(a: [i64]?) -> i64:
    if a == nil: return -1
    a!.len()

fn empty_guarded(a: [i64]?) -> bool:
    if a == nil: return true
    a!.len() == 0

fn sum_guarded(a: [i64]?) -> i64:
    var s = 0
    if a == nil: return 0
    for x in a!:
        s = s + x
    s

fn main() -> i64:
    print("LEN_{len_guarded(mk(true))}_{len_guarded(mk(false))}")
    print("EMPTY_{empty_guarded(mk(true))}_{empty_guarded(mk(false))}")
    print("SUM_{sum_guarded(mk(true))}_{sum_guarded(mk(false))}")
    0
