use .facade.{PrimitiveBox}

fn main() -> i64:
    val bytes: [u8] = [0, 255]
    val box = PrimitiveBox(count: 37, bytes: bytes, label: "typed", enabled: true, maybe: nil)
    if box.count != 37 or not box.enabled:
        return 1
    if box.bytes.len() != 2 or box.bytes[0] != 0 or box.bytes[1] != 255:
        return 2
    if box.label != "typed" or box.maybe != nil:
        return 3
    0
