use test.fixtures.compiler.imported_default_owner.provider.{imported_default_value}

# A foreign default must retain its declaring owner, including when the
# consumer has an unrelated global with the same spelling and numeric type.
val LIMIT: i64 = 99

fn main() -> i64:
    if LIMIT != 99:
        return 1
    if imported_default_value() != 37:
        return 2
    if imported_default_value(41) != 41:
        return 3
    print "imported-default-shadow-pass"
    0
