fn single(values: [i64]) -> i64:
    var only = 0
    [only] = values
    only

fn pair(values: [i64]) -> i64:
    var left = 0
    var right = 0
    [left, right] = values
    left * 10 + right

fn nested(values: [[i64]]) -> i64:
    var a = 0
    var b = 0
    var c = 0
    var d = 0
    [[a, b], [c, d]] = values
    a * 1000 + b * 100 + c * 10 + d
