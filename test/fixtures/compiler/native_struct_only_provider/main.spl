use .owner.{Counter, make_counter}

fn main() -> i64:
    var counter: Counter = make_counter(7)
    if counter.read() != 7: return 1
    counter.increase(5)
    if counter.read() != 12: return 2
    if counter.doubled() != 24: return 3
    var other: Counter = make_counter(-3)
    if other.read() != -3: return 4
    print "struct-only provider: 4 checks, 0 failures"
    0
