# Deliberately contains no class or enum: imported struct methods still need
# registration before lowering the consumer module.
pub struct Counter:
    value: i64

    fn read() -> i64:
        self.value

    me increase(delta: i64):
        self.value = self.value + delta

    fn doubled() -> i64:
        self.value * 2

pub fn make_counter(value: i64) -> Counter:
    Counter(value: value)
