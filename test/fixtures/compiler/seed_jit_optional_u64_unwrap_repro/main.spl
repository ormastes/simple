# Repro for doc/08_tracking/bug/seed_jit_optional_u64_unwrap_2026-10-18.md.
# Expected (interpreter): every line hi=3928117168 lo=2011024077.
# Seed JIT (9c45d2bf601ab93e): only `typed_coalesce` is right; `unwrap` and
# `untyped_coalesce` print pointer-like values.

fn maybe(ok: bool) -> u64?:
    if not ok:
        return nil
    val x: u64 = 0xea224fb077ddcacdu64
    x

fn show(label: text, v: u64):
    print "{label} hi={(v >> 32u64).to_i64()} lo={(v & 0xFFFFFFFFu64).to_i64()}"

fn main():
    val r = maybe(true)
    val a: u64 = r ?? 0u64
    show("typed_coalesce", a)
    if r != nil:
        val b: u64 = r.unwrap()
        show("unwrap", b)
    val c = maybe(true) ?? 0u64
    show("untyped_coalesce", c)
