"""Native proof that an opt-in Linux LLD link retains its exact inputs."""

use compiler.backend.linker.linker_wrapper.{
    NativeLinkConfig, link_to_native
}
use std.io_runtime.{cwd, file_exists, file_read}

fn main() -> i64:
    val output = "build/target5-link-reproduce/hello_linked"
    val archive = "{cwd()}/build/target5-link-reproduce/hello_linked.tar"
    val cfg = NativeLinkConfig(
        libraries: [],
        library_paths: [],
        runtime_path: "none",
        pie: true,
        debug: false,
        verbose: false,
        allow_duplicate_definitions: false,
        allow_cc_fallback: false,
        retained_symbols: [],
        extra_flags: [],
        prefer_size_linker: true
    )
    val result = link_to_native(
        ["build/target5-link-reproduce/hello.o"], output, cfg)
    if result.is_err():
        print "FAIL native link"
        return 1
    if not file_exists(output) or not file_exists(archive) or
            not file_exists(archive + ".receipt"):
        print "FAIL reproduction artifacts missing"
        return 2
    val receipt = file_read(archive + ".receipt")
    if not receipt.starts_with("simple-native-link-reproduce-v1\n") or
            not receipt.contains("archive_sha256=") or
            not receipt.contains("output_sha256=") or
            not receipt.contains("linker_sha256="):
        print "FAIL reproduction receipt invalid"
        return 3
    print "PASS native_link_reproduce_probe"
    0
