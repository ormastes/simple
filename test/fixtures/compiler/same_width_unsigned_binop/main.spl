# REQ-MIR-SAME-WIDTH-UNSIGNED-ARITHMETIC
# UNRUN: compile and execute with a current-source admitted producer on LLVM
# and Cranelift. The completed operation widens to i64 before returning, so a
# narrow destination store cannot hide a wrongly widened arithmetic result.
fn add8(a: u8, b: u8) -> i64: (a + b) as i64
fn sub8(a: u8, b: u8) -> i64: (a - b) as i64
fn mul8(a: u8, b: u8) -> i64: (a * b) as i64
fn add16(a: u16, b: u16) -> i64: (a + b) as i64
fn sub16(a: u16, b: u16) -> i64: (a - b) as i64
fn mul16(a: u16, b: u16) -> i64: (a * b) as i64
fn add32(a: u32, b: u32) -> i64: (a + b) as i64
fn sub32(a: u32, b: u32) -> i64: (a - b) as i64
fn mul32(a: u32, b: u32) -> i64: (a * b) as i64
fn mixed8(a: u8, b: i64) -> i64: a * b

fn main() -> i64:
    if add8(200, 60) != 4: return 1
    if sub8(60, 200) != 116: return 2
    if mul8(200, 60) != 224: return 3
    if add16(60000, 10000) != 4464: return 4
    if sub16(10000, 60000) != 15536: return 5
    if mul16(60000, 10000) != 17920: return 6
    if add32(4000000000, 500000000) != 205032704: return 7
    if sub32(500000000, 4000000000) != 794967296: return 8
    if mul32(4000000000, 500000000) != 1321730048: return 9
    if mixed8(200, 300) != 60000: return 10
    print "PASS same-width unsigned arithmetic 10 checks"
    0
