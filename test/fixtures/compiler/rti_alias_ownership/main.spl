use compiler.core.provider.{identity as legacy_identity, ordinary}
use compiler.frontend.core.provider.{identity as canonical_identity}

fn main() -> i64:
    if ordinary() != 19: return 1
    if legacy_identity<i64>(23) != 23: return 2
    if canonical_identity<i64>(29) != 29: return 3
    print "PASS: ordinary and specialized rows share the admitted provider"
    0
