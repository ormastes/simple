use first.{Record as FirstRecord, SymbolId}
use second.{Record as SecondRecord}

struct Record:
    name: text

fn first_sum(record: FirstRecord) -> i64:
    match record:
        case FirstRecord(tag, values, enabled):
            if not enabled: return -1
            var total = tag
            for value in values:
                total = total + value
            total

fn second_sum(record: SecondRecord) -> i64:
    match record:
        case SecondRecord(values, tag):
            var total = tag
            for value in values:
                total = total + value
            total

fn optional_id(id: SymbolId?) -> i64:
    match id:
        case Some(SymbolId(raw)): raw
        case _: -1

fn local_name(record: Record) -> text:
    match record:
        case Record(name): name

fn main() -> i64:
    if first_sum(FirstRecord(tag: 10, values: [2, 3], enabled: true)) != 15:
        return 1
    if first_sum(FirstRecord(tag: 99, values: [8], enabled: false)) != -1:
        return 2
    if second_sum(SecondRecord(values: [7, 11], tag: 100)) != 118:
        return 3
    if local_name(Record(name: "local")) != "local":
        return 4
    if optional_id(Some(SymbolId(id: 37))) != 37:
        return 5
    if optional_id(nil) != -1:
        return 6
    print "imported_positional_struct_owner: PASS"
    0
