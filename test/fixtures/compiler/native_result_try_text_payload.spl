# Native regression: Result text extracted by ? must retain text semantics.
fn produce_text(failed: bool) -> Result<text, text>:
    if failed: return Err("expected failure")
    val prefix = "owned"
    Ok(prefix + "-root")

fn literal_text() -> Result<text, text>:
    Ok("owned-root")

fn consume_text(failed: bool) -> Result<text, text>:
    val root = produce_text(failed)?
    val literal = literal_text()?
    assert(root == literal)
    assert(root == "owned-root")
    assert(root.len() == 10)
    val marker = root + "/owner.token"
    assert(marker == "owned-root/owner.token")
    Ok(marker)

fn main():
    match consume_text(false):
        case Ok(marker): assert(marker == "owned-root/owner.token")
        case Err(_): assert(false)
    match consume_text(true):
        case Ok(_): assert(false)
        case Err(message): assert(message == "expected failure")
    print "result-try-text: PASS"
