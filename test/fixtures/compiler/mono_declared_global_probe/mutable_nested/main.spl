var texts: [text] = ["A", "é"]
var integers: [i64] = [3, 5]
var grids: [[i64]] = [[11, 13]]

fn first<T>(roots: [T]) -> T:
    roots[0]

fn main() -> i64:
    texts[0] = "B"
    integers[1] = 7
    grids[0][1] = 17
    val text_result = first([texts])
    val integer_result = first([integers])
    val grid_result = first([grids])
    print text_result[0]
    print integer_result[1]
    print grid_result[0][1]
    return 0
