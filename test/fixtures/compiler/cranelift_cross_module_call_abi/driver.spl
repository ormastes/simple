# Two-module Cranelift cross-module call ABI fixture driver
# (bug p4p2_cranelift_verifier_types_2026-10-20, cluster A1).
#
# Usage: bin/simple run <this> <case> <out_dir>
# Lowers ONE source (so the caller's HIR sees the callee's declared
# signature, as an imported summary does), then splits it into a provider
# module (callees) and a caller module holding only `cv_go_<case>`, and
# compiles each with the Cranelift adapter into <out_dir>/<module>.o.
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering.{MirLowering}
use compiler.backend.backend.backend_types.{compileoptions_default_options}
use compiler.backend.cranelift_codegen_adapter.{CraneliftCodegenAdapter}
use std.io_runtime.{get_args, file_write_bytes}

val CV_SOURCE = "fn cv_take(x):\n    return x\n\nfn cv_take_i64(x: i64) -> i64:\n    return x + 1\n\nfn cv_half_f64(x: f64) -> f64:\n    return x / 2.0\n\nfn cv_go_untyped() -> i64:\n    return cv_take(2.0)\n\nfn cv_go_i64() -> i64:\n    return cv_take_i64(2.0)\n\nfn cv_go_int_to_f64() -> f64:\n    return cv_half_f64(3)\n\nfn cv_go_match() -> f64:\n    return cv_half_f64(3.0)\n\nfn cv_go_match_i64() -> i64:\n    return cv_take_i64(41)\n"

fn split_module(mir: MirModule, name: text, keep_callers: bool, case_name: text) -> MirModule:
    var functions: Dict<SymbolId, MirFunction> = {}
    for key in mir.functions.keys():
        val function = mir.functions[key]
        val leaf = function.name.split(".")[-1]
        val is_caller = leaf.starts_with("cv_go_")
        if keep_callers:
            if is_caller and leaf == "cv_go_{case_name}":
                functions[key] = function
        elif leaf.starts_with("cv_") and not is_caller:
            functions[key] = function
    MirModule(name: name, functions: functions, statics: {}, constants: {}, types: {})

fn compile_to(module: MirModule, out_dir: text) -> bool:
    val adapter = CraneliftCodegenAdapter(options: compileoptions_default_options())
    match adapter.compile_module(module):
        case Ok(output):
            file_write_bytes("{out_dir}/{module.name}.o", output.object_code)
            print "cv-driver: compiled {module.name}"
            true
        case Err(err):
            print "cv-driver: COMPILE-ERROR {module.name}: {err.message}"
            false

fn main() -> i64:
    val args = get_args()
    val case_name = args[args.len() - 2]
    val out_dir = args[args.len() - 1]
    val path = "cv_cross_module_call_abi.spl"
    val ast = parse_full_frontend(CV_SOURCE, path, path, Logger(level: 0))
    var hir_lowering = HirLowering.with_filename(path)
    val hir = hir_lowering.lower_module(ast)
    var lowering = MirLowering.new(hir.symbols)
    val mir = lowering.lower_module(hir)
    for function in mir.functions.values():
        print "cv-driver: fn {function.name} params={function.signature.params.len()}"
        for block in function.blocks:
            for inst in block.instructions:
                match inst.kind:
                    case MirInstKind.Call(_, func_op, call_args):
                        match func_op.kind:
                            case MirOperandKind.Const(_, op_type):
                                match op_type.kind:
                                    case MirTypeKind.FuncPtr(sig):
                                        print "cv-driver: call in {function.name} args={call_args.len()} declared_params={sig.declared_params.len()} known={sig.declared_params_known}"
                                    case _: ()
                            case _: ()
                    case _: ()
    if not compile_to(split_module(mir, "cv_provider", false, case_name), out_dir):
        return 2
    if not compile_to(split_module(mir, "cv_caller_{case_name}", true, case_name), out_dir):
        return 3
    0
