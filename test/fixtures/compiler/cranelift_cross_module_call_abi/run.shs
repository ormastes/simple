#!/bin/sh
# Build each two-module case with the Cranelift adapter, link with harness.c,
# run it, and print one line per case: `<case> <outcome>` where outcome is
# `value=<printed>`, `compile-error=<first E- line>` or `link-or-run-failed`.
# Usage: sh run.shs <out_dir> [simple_bin] [case...]
set -u
fixture_dir=$(cd "$(dirname "$0")" && pwd)
out=$1; shift
simple_bin=${1:-bin/simple}; [ $# -gt 0 ] && shift
cases=${*:-"untyped i64 int_to_f64 match match_i64"}
mkdir -p "$out"
for c in $cases; do
  d="$out/$c"; mkdir -p "$d"
  SIMPLE_NATIVE_BUILD_NO_MANGLE=1 "$simple_bin" run "$fixture_dir/driver.spl" "$c" "$d" > "$d/build.log" 2>&1
  rc=$?
  if [ "$rc" -ne 0 ] || [ ! -f "$d/cv_caller_$c.o" ]; then
    msg=$(grep -o 'E-BACKEND-CRANELIFT-[A-Z-]*:.*' "$d/build.log" | head -1)
    [ -n "$msg" ] || msg=$(grep -m1 'Verifier errors\|COMPILE-ERROR' -A1 "$d/build.log" | tr '\n' ' ')
    echo "$c compile-error=rc$rc $msg"
    continue
  fi
  if cc -DCV_CASE_$c -o "$d/run" "$fixture_dir/harness.c" "$d/cv_caller_$c.o" "$d/cv_provider.o" > "$d/link.log" 2>&1; then
    v=$("$d/run" 2>&1); rc=$?
    echo "$c value=$v rc=$rc"
  else
    echo "$c link-or-run-failed $(head -2 "$d/link.log" | tr '\n' ' ')"
  fi
done
