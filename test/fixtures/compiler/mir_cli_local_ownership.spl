# Compile with SIMPLE_BOOTSTRAP=0 and 1. Local return values differ from argv.
var owned_calls: i64 = 0

fn get_args() -> [text]:
    owned_calls = owned_calls + 1
    ["local-first", "local-second"]

fn get_cli_args() -> [text]:
    owned_calls = owned_calls + 10
    ["filtered-first", "filtered-second"]

fn eprint(value: text) -> i64:
    owned_calls = owned_calls + 100
    if value == "owned": 37 else: -1

fn main() -> i64:
    if get_args()[0] != "local-first": return 1
    if owned_calls != 1: return 2
    if get_cli_args()[1] != "filtered-second": return 3
    if owned_calls != 11: return 4
    if eprint("owned") != 37: return 5
    if owned_calls != 111: return 6
    print "mir-cli-local-ownership: PASS"
    0
