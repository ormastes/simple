struct ProbeCodecError:
    byte_offset: i64
    reason: text

enum ProbeIoError:
    Codec(ProbeCodecError)

fn main() -> i64:
    val bytes: [u8] = [65, 66]
    var total: i64 = 0
    for byte in bytes:
        total = total + byte
    assert(total == 131)
    val error = ProbeIoError.Codec(ProbeCodecError(byte_offset: 7, reason: "invalid byte"))
    match error:
        case ProbeIoError.Codec(codec):
            assert(codec.byte_offset == 7)
            assert(codec.reason == "invalid byte")
    print "PASS direct byte-array and codec payload: 3 assertions"
    0
