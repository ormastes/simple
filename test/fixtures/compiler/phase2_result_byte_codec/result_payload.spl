struct ProbeCodecError:
    byte_offset: i64
    reason: text

enum ProbeIoError:
    Codec(ProbeCodecError)

fn probe_bytes(ok: bool) -> Result<[u8], ProbeCodecError>:
    if ok:
        Ok([65, 66])
    else:
        Err(ProbeCodecError(byte_offset: 7, reason: "invalid byte"))

fn probe_mapped(ok: bool) -> Result<[u8], ProbeIoError>:
    match probe_bytes(ok):
        case Ok(value): Ok(value)
        case Err(error): Err(ProbeIoError.Codec(error))

fn main() -> i64:
    val bytes: [u8] = match probe_mapped(true):
        case Ok(value): value
        case Err(_): return 1
    var total: i64 = 0
    for byte in bytes:
        total = total + byte
    assert(total == 131)
    match probe_mapped(false):
        case Ok(_): return 2
        case Err(error):
            match error:
                case ProbeIoError.Codec(codec):
                    assert(codec.byte_offset == 7)
                    assert(codec.reason == "invalid byte")
    print "PASS Result byte-array and codec payload: 3 assertions"
    0
