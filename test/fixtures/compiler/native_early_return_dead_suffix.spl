# Regression: a dead conditional must not replace a finalized return block.
# Compile and execute through each backend; success is exit 0 and the marker.
struct PreservedValue:
    number: i64
    enabled: bool

fn make_value() -> PreservedValue:
    PreservedValue(number: 37, enabled: true)

fn return_value(flag: bool) -> PreservedValue:
    val result = make_value()
    return result
    if flag:
        return result
    PreservedValue(number: 99, enabled: false)

fn choose_value(flag: bool) -> i64:
    if flag:
        return 11
    val answer = 23
    return answer
    if flag:
        return 99
    101

fn main() -> i32:
    val first = return_value(false)
    if first.number != 37 or not first.enabled:
        return 1
    val second = return_value(true)
    if second.number != 37 or not second.enabled:
        return 2
    if choose_value(true) != 11:
        return 3
    if choose_value(false) != 23:
        return 4
    print "early-return-dead-suffix: PASS"
    0
