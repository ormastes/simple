# Native Cranelift regression: evaluate operations on parameters so overflow
# happens in emitted code, then widen the narrow result to expose its sign.
# Widen directly: an annotated narrow let emits its own MIR cast and can
# conceal a broken BinOp by normalizing the result before this observation.
fn add8(a: i8, b: i8) -> i64:
    (a + b).to_i64()

fn sub8(a: i8, b: i8) -> i64:
    (a - b).to_i64()

fn mul8(a: i8, b: i8) -> i64:
    (a * b).to_i64()

fn add16(a: i16, b: i16) -> i64:
    (a + b).to_i64()

fn sub16(a: i16, b: i16) -> i64:
    (a - b).to_i64()

fn mul16(a: i16, b: i16) -> i64:
    (a * b).to_i64()

fn add32(a: i32, b: i32) -> i64:
    (a + b).to_i64()

fn sub32(a: i32, b: i32) -> i64:
    (a - b).to_i64()

fn mul32(a: i32, b: i32) -> i64:
    (a * b).to_i64()

fn unsigned_add(a: u8, b: u8) -> i64:
    (a + b).to_i64()

fn float_add(a: f64, b: f64) -> f64:
    a + b

fn wide_add(a: i64, b: i64) -> i64:
    a + b

fn main() -> i64:
    if add8(127, 1) != -128: return 1
    if sub8(-128, 1) != 127: return 2
    if mul8(64, 2) != -128: return 3
    if add16(32767, 1) != -32768: return 4
    if sub16(-32768, 1) != 32767: return 5
    if mul16(16384, 2) != -32768: return 6
    if add32(2147483647, 1) != -2147483648: return 7
    if sub32(-2147483648, 1) != 2147483647: return 8
    if mul32(1073741824, 2) != -2147483648: return 9
    if sub32(0, -2147483648) != -2147483648: return 10
    if unsigned_add(255, 1) != 0: return 11
    if unsigned_add(127, 1) != 128: return 12
    if float_add(1.25, 2.5) != 3.75: return 13
    if wide_add(2147483647, 1) != 2147483648: return 14
    if add8(-5, 2) != -3: return 15
    print "PASS signed narrow binop checks=15"
    0
