use provider.{Argument as ProviderArgument, Payload as ProviderPayload, CallbackBox, boxes}

# Provider nominal IDs inside the function field must not resolve these
# same-name consumer declarations with different layouts and field types.
struct Argument:
    value: text

struct Payload:
    value: text

fn main():
    assert(Argument(value: "consumer").value == "consumer")
    assert(Payload(value: "consumer").value == "consumer")
    val argument = ProviderArgument(prefix: "provider", value: 23)
    var count = 0
    for box in boxes():
        assert(box.prefix == 7)
        assert(box.scalar_fn(11) == 12)
        val payload = box.call_fn(argument)
        assert(payload.prefix == 17)
        assert(payload.value == 23)
        count = count + 1
    assert(count == 1)
    val stored = boxes()
    val box = stored[0]
    assert(box.scalar_fn(4) == 5)
    val payload = box.call_fn(argument)
    assert(payload.prefix == 17)
    assert(payload.value == 23)
    print("array return function-field ownership assertions passed")
