struct Argument:
    prefix: text
    value: i64

struct Payload:
    prefix: i64
    value: i64

class CallbackBox:
    prefix: i64
    call_fn: fn(Argument) -> Payload
    scalar_fn: fn(i64) -> i64
    any_fn: fn(any) -> any

fn increment(value: i64) -> i64:
    value + 1

fn transform(argument: Argument) -> Payload:
    Payload(prefix: 17, value: argument.value)

fn identity(value: any) -> any:
    value

fn boxes() -> [CallbackBox]:
    [CallbackBox(prefix: 7, call_fn: transform, scalar_fn: increment, any_fn: identity)]
