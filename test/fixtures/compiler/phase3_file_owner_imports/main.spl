use std.nogc_sync_mut.io.file_ops.{file_read, file_write, file_lock, file_unlock, file_remove}
use std.common.text_bytes.{bytes_to_text, text_to_utf8_bytes}

fn main() -> i64:
    val path = "build/phase3_file_owner_imports_probe.txt"
    if not file_write(path, "owner-bound bytes"):
        return 1
    if file_read(path) != "owner-bound bytes":
        return 2
    val lock = file_lock("{path}.lock", 1)
    if lock < 0:
        return 3
    if not file_unlock(lock):
        return 4
    if bytes_to_text(text_to_utf8_bytes("owner")) != "owner":
        return 5
    if not file_remove(path):
        return 6
    print "PASS phase3 file owner imports"
    0