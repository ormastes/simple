fn inferred_tail() -> i64:
    val (left, right) = (19, 23)
    left + right

fn annotated_tail() -> i64:
    var value: i64 = 41
    value = value + 1
    value

fn main() -> i64:
    if inferred_tail() != 42: return 1
    if annotated_tail() != 42: return 2
    print "optional let scalar probe PASS"
    0
