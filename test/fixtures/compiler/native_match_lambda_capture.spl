# @req REQ-SSPEC-COMPILER
# Bug: mir_match_lambda_capture_scope_2026_10_17
# Actual native value oracle; see mirrored manual for execution commands.
fn make_body(bias: i64) -> fn(i64) -> i64:
    \value:
        match value:
            case 0: bias
            case local: local + bias

fn make_guard(limit: i64) -> fn(i64) -> i64:
    \value:
        match value:
            case local if local > limit: local
            case other: 0 - other

fn make_shadow(local: i64) -> fn(i64) -> i64:
    \value:
        match value:
            case local: local + 1

fn make_nested(bias: i64) -> fn(i64) -> i64:
    \value:
        match value:
            case outer:
                match outer:
                    case inner if inner > 0: inner + bias
                    case rest: bias - rest

fn make_scrutinee(selected: i64) -> fn(i64) -> i64:
    \value:
        match selected:
            case 0: value
            case other: other + value

fn main() -> i64:
    val body = make_body(7)
    val guard = make_guard(5)
    val shadow = make_shadow(200)
    val nested = make_nested(3)
    val selected = make_scrutinee(4)
    var offset = 9
    val snapshot = \value:
        match value:
            case 0: offset
            case other: other + offset
    offset = 100
    val a = body(6)
    val b = guard(8)
    val c = guard(2)
    val d = shadow(5)
    val e = nested(4)
    val f = nested(-2)
    val g = selected(6)
    val h = snapshot(3)
    if a != 13 or b != 8 or c != -2 or d != 6 or e != 7 or f != 5 or g != 10 or h != 12:
        return 1
    print "match-closure:13,8,-2,6,7,5,10,12"
    0
