# A bare unit variant in a struct-field sub-pattern is a VARIANT TEST, like one
# in a tuple / array / payload slot. The seed tested struct fields with an
# ANY-typed slot while the binder used the real field type, so `Red` here was
# neither tested nor bound and the arm matched every Holder.
# Bug: doc/08_tracking/bug/seed_struct_field_slot_bare_unit_variant_neither_tested_nor_bound_2026-11-12.md
enum Color:
    Red
    Green

enum Kind:
    Int(bits: i64)
    Str

class Holder:
    c: Color
    n: i64

class Tagged:
    k: Kind
    n: i64

fn named(h: Holder) -> i64:
    match h:
        case Holder { c: Red, n: n }: 100 + n
        case _: 0

fn positional(h: Holder) -> i64:
    match h:
        case Holder(Red, n): 100 + n
        case _: 0

# Negative: a lowercase field pattern still binds.
fn lower_binder(h: Holder) -> i64:
    match h:
        case Holder(c, n):
            match c:
                case Color.Red: 10 + n
                case Color.Green: 20 + n

# Negative: a PAYLOAD variant name in a field slot binds (unit-only rule).
fn payload_name(t: Tagged) -> i64:
    match t:
        case Tagged(Int, n):
            match Int:
                case Kind.Int(b): b + n
                case Kind.Str: 50 + n

fn main() -> i64:
    if named(Holder(c: Color.Green, n: 1)) != 0: return 1
    if named(Holder(c: Color.Red, n: 2)) != 102: return 2
    if positional(Holder(c: Color.Green, n: 1)) != 0: return 3
    if positional(Holder(c: Color.Red, n: 3)) != 103: return 4
    if lower_binder(Holder(c: Color.Green, n: 4)) != 24: return 5
    if payload_name(Tagged(k: Kind.Str, n: 5)) != 55: return 6
    if payload_name(Tagged(k: Kind.Int(7), n: 1)) != 8: return 7
    print "struct_field_pattern_bare_unit_variant: ok"
    0
