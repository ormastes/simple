# CPU backend artifact validation fixture.
# A successful executable must return 41, so a zero-return codegen stub cannot
# satisfy the run/readback stage.

fn backend_probe_value(input: i64) -> i64:
    if input > 10:
        input * 2 + 1
    else:
        input - 1

fn main() -> i64:
    backend_probe_value(20)
