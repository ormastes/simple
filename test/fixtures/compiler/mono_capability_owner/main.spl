use compiler.common.diagnostics.span.{Span}
use compiler.frontend.parser_types_expr.{Type, TypeKind}
use compiler.mono.monomorphize.types.{ConcreteType, PointerKind, ReferenceCapability}
use compiler.mono.monomorphize.util.{mono_pointer_concrete}

fn capability_code(capability: ReferenceCapability) -> i64:
    match capability:
        case ReferenceCapability.Isolated: 1
        case ReferenceCapability.Exclusive: 2
        case ReferenceCapability.Shared: 3

fn pointer_code(kind: PointerKind) -> i64:
    match kind:
        case PointerKind.Unique: 1
        case PointerKind.Shared: 2
        case PointerKind.Weak: 3
        case PointerKind.Handle: 4
        case PointerKind.Borrow: 5
        case PointerKind.BorrowMut: 6
        case PointerKind.RawConst: 7
        case PointerKind.RawMut: 8

fn check_pointer(kind: PointerKind, expected_capability: i64) -> bool:
    val inner = Type(kind: TypeKind.Named("T", []), span: Span(0, 0, 0, 0, "", 0))
    val actual = mono_pointer_concrete(kind, inner, {"T": ConcreteType.String})
    match actual:
        case ConcreteType.Pointer(actual_kind, capability, leaf):
            if pointer_code(actual_kind) != pointer_code(kind): return false
            if capability_code(capability) != expected_capability: return false
            match leaf:
                case ConcreteType.String: true
                case _: false
        case _: false

fn main() -> i64:
    if not check_pointer(PointerKind.Unique, 1): return 11
    if not check_pointer(PointerKind.Shared, 3): return 12
    if not check_pointer(PointerKind.Weak, 3): return 13
    if not check_pointer(PointerKind.Borrow, 3): return 14
    if not check_pointer(PointerKind.BorrowMut, 2): return 15
    if not check_pointer(PointerKind.RawConst, 3): return 16
    if not check_pointer(PointerKind.RawMut, 2): return 17
    print "mono_capability_owner: PASS (7 mappings)"
    0
