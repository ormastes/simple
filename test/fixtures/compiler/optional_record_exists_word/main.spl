# Original if-val forms for #3016; native qualification is required.
struct Record:
    prefix: i64
    value: i64

impl Record:
    fn read() -> i64:
        self.value

fn read_optional(record: Record?) -> i64:
    if val present = record:
        if present.value != present.read(): return -1
        return present.value
    -2

fn read_lookup(records: Dict<text, Record>, key: text) -> i64:
    if val present = records.get(key):
        if present.value != present.read(): return -3
        return present.value
    -4

fn main() -> i64:
    val record = Record(prefix: 101, value: 47)
    if read_optional(Some(record)) != 47: return 1
    if read_optional(nil) != -2: return 2
    var records: Dict<text, Record> = {}
    records["present"] = record
    if read_lookup(records, "present") != 47: return 3
    if read_lookup(records, "missing") != -4: return 4
    0
