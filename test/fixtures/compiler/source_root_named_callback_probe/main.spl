use compiler.common.source_root_resolution.{SourceRootResolutionV1}
use .callback_owner.{resolve_with_callback}
use .named_target.{resolve_default}

fn main() -> i64:
    val result = resolve_with_callback(SourceRootResolutionV1.Missing,
        "normal", "checkout", resolve_default)
    match result:
        case SourceRootResolutionV1.Found(path):
            if path != "checkout/normal.spl": return 1
        case SourceRootResolutionV1.Missing: return 2
        case SourceRootResolutionV1.Ambiguous(_): return 3
    print "NAMED_CALLBACK_PASS"
    0
