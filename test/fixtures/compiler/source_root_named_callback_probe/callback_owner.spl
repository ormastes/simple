use compiler.common.source_root_resolution.{SourceRootResolutionV1}

pub fn resolve_with_callback(selected: SourceRootResolutionV1,
        module_path: text, entry_dir: text,
        fallback: fn(text, text) -> text) -> SourceRootResolutionV1:
    match selected:
        case SourceRootResolutionV1.Found(_): selected
        case SourceRootResolutionV1.Ambiguous(_): selected
        case SourceRootResolutionV1.Missing:
            val path: text = fallback(module_path, entry_dir)
            if path == "": SourceRootResolutionV1.Missing
            else: SourceRootResolutionV1.Found(path)
