# Actual shared mono consumers, with synthetic mechanical transform boundaries.
# No production prerequisite/final admission is asserted by this fixture.
use support.*
use provider.{outer}
use compiler.mono.mono_archive_current_body_v1.*
use compiler.mono.mono_archive_body_input_v1.*
use compiler.mono.mono_archive_registration_v1.*
use compiler.mono.monomorphize_integration.{MonomorphizationPass}
use compiler.driver.cache.hir_body_typecheck_lease_v1.{HirBodyArchiveV1, hir_body_archive_load_in_owned_scope_v1}
use compiler.driver.cache.hir_mono_archive_consumer_v1.*
use compiler.driver.cache.hir_mono_archive_execution_v1.*
use compiler.driver.cache.hir_mono_archive_assembly_v1.*
use compiler.driver.cache.hir_mono_archive_verify_v1.{mono_archive_post_mono_report_digest_v1}
use compiler.driver.cache.hir_mono_verification_use_v1.*
use compiler.driver.cache.driver_hir_archive_mono_execute_v1.*
use compiler.mono.verify.post_mono_verify.{post_mono_verify_modules}
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_definitions.{HirFunction, HirExpr, HirExprKind}
use compiler.hir.hir_codec.{hir_module_encode}
use compiler.driver.driver_hir_cache.{hir_cache_clear_last_warnings, hir_cache_promote_diagnostic_owner_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end, transient_promote}

struct CurrentParity:
    root_digest: text
    provider_digest: text
    report_digest: text
    literal_bodies_ok: bool

fn close_fixture(paused: bool, owned: bool):
    val cache_owned = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    if paused: hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not owned or not cache_owned or not ended: panic("current consumer fixture ownership")

fn capture_current(owner: MonoArchiveCurrentRegistrationOwnerV1, archive: HirBodyArchiveV1,
        change_outer: bool) -> Result<MonoArchiveCurrentRegistrationReceiptV1, text>:
    if not transient_scope_begin(): return Err("current consumer capture scope unavailable")
    var captured: Result<MonoArchiveCurrentRegistrationReceiptV1, text> = Err("current complete parent unavailable")
    val decoded = hir_body_archive_load_in_owned_scope_v1(archive, archive.input)
    if decoded.is_ok():
        var module = decoded.unwrap()
        if change_outer:
            var function = fixture_function(module, "outer")
            function.body.stmts = []
            function.body.has = true
            function.body.value = HirExpr(kind: HirExprKind.IntLit(99, nil), has_type_: true,
                type_: integer_type(), span: function.span)
            module.functions[function.symbol] = function
        val warnings = ["actual current first warning", "actual current second warning"]
        val stored = mono_archive_current_body_store_in_owned_scope_v1(owner.cache, archive,
            sha256_text("mechanical fixture boundary key"), sha256_text("mechanical fixture transform policy"), module, warnings)
        if stored.is_ok():
            captured = mono_archive_collect_current_registration_in_owned_scope_v1(owner, module, stored.unwrap(), warnings)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(captured) else: false
    close_fixture(paused, owned)
    captured

fn literal_body(function: HirFunction) -> i64:
    if not function.body.has: return -1
    match function.body.value.kind:
        case HirExprKind.IntLit(value, _): value
        case _: -1

fn observe_parity(repository: MonoArchiveRepositoryV1, root_name: text,
        provider_name: text, replay: MonoArchiveVerificationUseV1?) -> Result<CurrentParity, text>:
    if not transient_scope_begin(): return Err("current parity scope unavailable")
    var observation: Result<CurrentParity, text> = Err("current complete parity bodies unavailable")
    var modules: Dict<text, HirModule> = {}
    var valid = true
    for name in [root_name, provider_name]:
        if val use_owner = replay:
            val loaded = mono_archive_verification_use_load_module_in_owned_scope_v1(use_owner, name)
            if loaded.is_ok(): modules[name] = loaded.unwrap() else: valid = false
        else:
            val input = mono_archive_repository_input_v1(repository, name)
            if input.is_err():
                valid = false
            else:
                val loaded = mono_archive_body_input_load_in_owned_scope_v1(input.unwrap())
                if loaded.is_ok(): modules[name] = loaded.unwrap().module else: valid = false
    if valid:
        var output = modules
        if replay == nil:
            val worker = MonomorphizationPass.create()
            output = worker.process_modules(modules)
        val provider: HirModule = output[provider_name]
        var body_count = 0
        var untouched_inner = false
        var pruned_outer = true
        for raw in provider.functions.values():
            val function: HirFunction = raw
            if function.name == "outer": pruned_outer = false
            if function.name == "inner" and literal_body(function) == 43: untouched_inner = true
            if function.name.starts_with("outer$") and literal_body(function) == 99: body_count = body_count + 1
        observation = Ok(CurrentParity(root_digest: sha256_text(hir_module_encode(output[root_name])),
            provider_digest: sha256_text(hir_module_encode(provider)),
            report_digest: mono_archive_post_mono_report_digest_v1(post_mono_verify_modules(output)),
            literal_bodies_ok: body_count == 2 and untouched_inner and pruned_outer))
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(observation) else: false
    close_fixture(paused, owned)
    observation

fn main() -> i64:
    if outer<i64>(7) != 43 or outer<text>("original native complete generic") != 43: return 1
    var checks = 1
    val provider = lower_fixture("provider.spl", "current.provider")
    val root = root_for(lower_fixture("root.spl", "current.root"), "outer", true, true)
    val root_archive = archive_fixture(root)
    val provider_archive = archive_fixture(provider)
    val created = mono_archive_current_registration_create_v1()
    if root_archive.is_err() or provider_archive.is_err() or created.is_err(): return 2
    val registration = created.unwrap()
    val root_capture = capture_current(registration, root_archive.unwrap(), false)
    if root_capture.is_err() or mono_archive_publish_current_registration_v1(registration, root_capture.unwrap()).is_err(): return 3
    val provider_capture = capture_current(registration, provider_archive.unwrap(), true)
    if provider_capture.is_err() or mono_archive_publish_current_registration_v1(registration, provider_capture.unwrap()).is_err(): return 4
    if registration.registration.epoch != 2 or registration.bodies.len() != 2: return 5
    checks = checks + 1
    var inventory: Dict<text, text> = {}
    inventory[root.name] = root.path
    inventory[provider.name] = provider.path
    val order = [root.name, provider.name]
    if not mono_archive_current_registration_seal_v1(registration, inventory, [provider.name, root.name]).is_err() or registration.registration.sealed: return 6
    checks = checks + 1
    val admitted = mono_archive_current_registration_seal_v1(registration, inventory, order)
    if admitted.is_err(): return 7
    checks = checks + 1
    if not mono_archive_execution_create_v1(registration.registration, inventory, order).is_err(): return 8
    checks = checks + 1
    val saved_counter = registration.registration.state.next_symbol
    registration.registration.state.next_symbol = saved_counter + 1
    val edited_state_refused = mono_archive_current_execution_create_v1(registration, inventory, order).is_err()
    registration.registration.state.next_symbol = saved_counter
    if not edited_state_refused: return 30
    checks = checks + 1
    val execution_result = mono_archive_current_execution_create_v1(registration, inventory, order)
    if execution_result.is_err(): return 9
    val execution = execution_result.unwrap()
    val retained = observe_parity(execution.admission.repository, root.name, provider.name, nil)
    if retained.is_err() or not retained.unwrap().literal_bodies_ok: return 10
    checks = checks + 1
    if not mono_archive_execute_next_specialization_v1(execution).is_err() or not mono_archive_verification_use_capture_v1(execution).is_err(): return 11
    checks = checks + 1
    var wrong = execution.admission
    wrong.repository.current_bodies = {}
    if not mono_archive_rewrite_root_v1(wrong, root.name, execution.roots[0].symbols[0]).is_err() or execution.expected_epoch != 0: return 12
    checks = checks + 1
    wrong = execution.admission
    wrong.repository.current_mode = false
    if not mono_archive_rewrite_root_v1(wrong, root.name, execution.roots[0].symbols[0]).is_err(): return 13
    checks = checks + 1
    val current_publication = mono_archive_rewrite_root_v1(execution.admission, root.name, execution.roots[0].symbols[0])
    if current_publication.is_err(): return 31
    var stale = current_publication.unwrap()
    stale.input_archive_key = root_archive.unwrap().archive_key
    stale.input_body_digest = root_archive.unwrap().body_digest
    stale.function_archive_key = mono_archive_function_record_key_v1(stale)
    stale.output_archive_key = mono_archive_output_key_v1(stale)
    if not mono_archive_apply_v1(execution.admission, stale).is_err() or execution.admission.state.epoch != 0: return 32
    checks = checks + 1
    while not mono_archive_roots_complete_v1(execution):
        if mono_archive_execute_next_root_v1(execution).is_err(): return 14
    if execution.admission.state.queue.len() != 2 or execution.expected_epoch != execution.root_records.len(): return 15
    checks = checks + 1
    # Repeated identical calls share the actual request; transformed outer
    # has no inner call, so the original parent's four-request graph is stale.
    while execution.admission.state.cursor < execution.admission.state.queue.len():
        if mono_archive_execute_next_specialization_v1(execution).is_err(): return 16
    if not mono_archive_execution_complete_v1(execution) or execution.specialization_records.len() != 2 or
            execution.admission.state.emitted.len() != 2: return 17
    checks = checks + 1
    for publication in execution.specialization_records:
        if publication.input_archive_key != registration.bodies[provider.name].current_artifact_key or
                publication.input_body_digest != registration.bodies[provider.name].current_body_digest: return 18
    checks = checks + 1
    val assembled = mono_archive_assemble_module_v1(execution, provider.name)
    if assembled.is_err() or assembled.unwrap().body_input == nil or assembled.unwrap().lowering_warnings_digest !=
            registration.bodies[provider.name].current_warnings_digest: return 19
    checks = checks + 1
    val captured = mono_archive_verification_use_capture_v1(execution)
    if captured.is_err(): return 20
    val replay_owner = captured.unwrap()
    val replay = observe_parity(execution.admission.repository, root.name, provider.name, Some(replay_owner))
    if replay.is_err() or not replay.unwrap().literal_bodies_ok or replay.unwrap().root_digest != retained.unwrap().root_digest or
            replay.unwrap().provider_digest != retained.unwrap().provider_digest or replay.unwrap().report_digest != retained.unwrap().report_digest: return 21
    checks = checks + 1
    val used = mono_archive_verification_use_v1(replay_owner)
    if used.is_err() or used.unwrap().modules.len() != 2 or mono_archive_post_mono_report_digest_v1(used.unwrap().report) != retained.unwrap().report_digest: return 22
    checks = checks + 1
    if not transient_scope_begin(): return 23
    var growth: [text] = []
    var index = 0
    while index < 4096:
        growth = growth.push("current body FIFO replay churn {index}")
        index = index + 1
    val grown = growth.len() == 4096
    if not transient_scope_end() or not grown: return 24
    val after_growth = mono_archive_verification_use_v1(replay_owner)
    if after_growth.is_err() or mono_archive_post_mono_report_digest_v1(after_growth.unwrap().report) != retained.unwrap().report_digest: return 25
    checks = checks + 1
    if not mono_archive_verification_use_load_module_in_owned_scope_v1(replay_owner, provider.name).is_err(): return 26
    checks = checks + 1
    if not transient_scope_begin(): return 27
    val occupied_refused = mono_archive_verification_use_v1(replay_owner).is_err()
    val paused = transient_scope_pause()
    val paused_refused = if paused: mono_archive_verification_use_load_module_in_owned_scope_v1(replay_owner, provider.name).is_err() else: false
    if not transient_scope_end() or not occupied_refused or not paused_refused: return 28
    checks = checks + 1
    # Exercise the actual closed continuation against another freshly captured
    # owner. Reusing the earlier completed mutable state is not admission.
    val next_created = mono_archive_current_registration_create_v1()
    if next_created.is_err(): return 33
    val next = next_created.unwrap()
    val next_root = capture_current(next, root_archive.unwrap(), false)
    if next_root.is_err() or mono_archive_publish_current_registration_v1(next, next_root.unwrap()).is_err(): return 34
    val next_provider = capture_current(next, provider_archive.unwrap(), true)
    if next_provider.is_err() or mono_archive_publish_current_registration_v1(next, next_provider.unwrap()).is_err(): return 35
    if mono_archive_current_registration_seal_v1(next, inventory, order).is_err(): return 36
    if not driver_hir_archive_current_mono_execute_v1(next, inventory, [provider.name, root.name]).is_err() or
            next.registration.state.epoch != 0: return 37
    checks = checks + 1
    if not transient_scope_begin(): return 38
    val active_continuation_refused = driver_hir_archive_current_mono_execute_v1(next, inventory, order).is_err()
    val next_paused = transient_scope_pause()
    val paused_continuation_refused = if next_paused: driver_hir_archive_current_mono_execute_v1(next, inventory, order).is_err() else: false
    if not transient_scope_end() or not active_continuation_refused or not paused_continuation_refused or
            next.registration.state.epoch != 0: return 39
    checks = checks + 1
    val continued = driver_hir_archive_current_mono_execute_v1(next, inventory, order)
    if continued.is_err(): return 40
    val result = continued.unwrap()
    if not mono_archive_execution_complete_v1(result.execution) or result.execution.specialization_records.len() != 2 or
            result.verification.capture.ordered_inventory != order or result.verification.modules.len() != 2: return 41
    checks = checks + 1
    val statistics = driver_hir_archive_mono_stats_v1(result.execution)
    if statistics.generic_functions_found != execution.generic_functions or
            statistics.call_sites_found != execution.call_sites_found or
            statistics.specializations_created != execution.specializations_created or
            statistics.unresolved_generic_calls != execution.unresolved_generic_calls or
            result.execution.diagnostics != execution.diagnostics or result.execution.warnings != execution.warnings: return 42
    checks = checks + 1
    val continued_parity = observe_parity(result.execution.admission.repository, root.name, provider.name,
        Some(result.verification.capture))
    if continued_parity.is_err() or not continued_parity.unwrap().literal_bodies_ok or
            continued_parity.unwrap().root_digest != retained.unwrap().root_digest or
            continued_parity.unwrap().provider_digest != retained.unwrap().provider_digest or
            mono_archive_post_mono_report_digest_v1(result.verification.report) != retained.unwrap().report_digest: return 43
    checks = checks + 1
    val final_epoch = next.registration.state.epoch
    if not driver_hir_archive_current_mono_execute_v1(next, inventory, order).is_err() or
            next.registration.state.epoch != final_epoch: return 44
    checks = checks + 1
    if not transient_scope_begin(): return 45
    var continuation_growth: [text] = []
    for number in 0..4096: continuation_growth = continuation_growth.push("closed mono continuation churn {number}")
    val continuation_grown = continuation_growth.len() == 4096
    if not transient_scope_end() or not continuation_grown: return 46
    val continuation_replay = mono_archive_verification_use_v1(result.verification.capture)
    if continuation_replay.is_err() or mono_archive_post_mono_report_digest_v1(continuation_replay.unwrap().report) !=
            retained.unwrap().report_digest: return 47
    checks = checks + 1
    if checks != 27: return 29
    print "HIR current mono consumer: {checks} checks passed"
    0
