use compiler.common.assurance.flight_rules.{flight_rules_in_category, flight_rule_enforcement_gaps, flight_rules_canonical_text, RuleCategory}

fn main() -> i64:
    val rules = flight_rules_in_category(RuleCategory.Memory)
    if rules.len() == 0:
        return 1
    for rule in rules:
        if rule.category.name() != "memory":
            return 4
    val gaps = flight_rule_enforcement_gaps()
    if gaps.len() == 0:
        return 2
    for rule in gaps:
        if not rule.is_enforcement_gap():
            return 5
    val canonical = flight_rules_canonical_text()
    if not canonical.starts_with("flight-core-v1\n"):
        return 3
    if not canonical.contains("FLT-MEM-") or not canonical.contains("|memory|"):
        return 6
    if not canonical.contains("|control_flow|compile|intrinsic|intrinsic|intrinsic|none|prohibited|"):
        return 7
    print "FLIGHT_RULE_INDEXED_OWNER_PASS"
    0
