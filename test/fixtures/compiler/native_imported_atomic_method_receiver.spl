# Cross-module atomic method ABI probe. The MemoryOrdering enum must remain an
# explicit argument after the imported AtomicI64/AtomicBool receiver. If the
# receiver is dropped, SeqCst (4) is used as the runtime handle and the native
# program faults instead of printing the success marker.
use std.nogc_sync_mut.atomic.{AtomicI64, AtomicBool, MemoryOrdering, atomic_i64_new, atomic_bool_new}

fn main() -> i64:
    val counter: AtomicI64 = atomic_i64_new(40)
    val enabled: AtomicBool = atomic_bool_new(false)

    if counter.load(MemoryOrdering.SeqCst) != 40:
        return 1
    if counter.fetch_add(2, MemoryOrdering.AcqRel) != 40:
        return 2
    if counter.load(MemoryOrdering.Acquire) != 42:
        return 3

    enabled.store(true, MemoryOrdering.Release)
    if not enabled.load(MemoryOrdering.Acquire):
        return 4

    counter.free()
    enabled.free()
    print("imported-atomic-method-receiver-ok")
    0
