use compiler.common.source_root_resolution.{SourceRootResolutionV1,
    source_root_numbered_candidate_v1, source_root_numbered_match_v1}

fn resolution_text(result: SourceRootResolutionV1) -> text:
    match result:
        case SourceRootResolutionV1.Found(path): path
        case SourceRootResolutionV1.Missing: "MISSING"
        case SourceRootResolutionV1.Ambiguous(reason): "AMBIGUOUS:" + reason

fn main() -> i64:
    if not source_root_numbered_candidate_v1("00.driver", "driver"): return 1
    if not source_root_numbered_candidate_v1("999.driver", "driver"): return 2
    if source_root_numbered_candidate_v1("1000.driver", "driver"): return 3
    if source_root_numbered_candidate_v1("a.driver", "driver"): return 4
    if source_root_numbered_candidate_v1("00.backend", "driver"): return 5
    val first = source_root_numbered_match_v1(SourceRootResolutionV1.Missing,
        "overlay/00.driver", "overlay/driver")
    if resolution_text(first) != "overlay/00.driver": return 6
    val ambiguous = source_root_numbered_match_v1(first,
        "overlay/10.driver", "overlay/driver")
    print "second-match=" + resolution_text(ambiguous)
    if resolution_text(ambiguous) != "AMBIGUOUS:overlay/driver": return 7
    val retained = source_root_numbered_match_v1(ambiguous,
        "default/driver", "default/driver")
    if resolution_text(retained) != "AMBIGUOUS:overlay/driver": return 8
    print "SOURCE_ROOT_RESOLUTION_PASS"
    0
