"""Native proof that source edits retain a workspace root generation."""

use compiler.driver.cache.cold_full_index_root_identity_v1.{
    cold_full_index_workspace_root_generation_v1
}

fn main() -> i64:
    val first = cold_full_index_workspace_root_generation_v1(
        "/work/project")
    val same = cold_full_index_workspace_root_generation_v1(
        "/work/project")
    val other = cold_full_index_workspace_root_generation_v1(
        "/work/other")
    val windows = cold_full_index_workspace_root_generation_v1(
        "C:\\work\\project")
    val windows_plain = cold_full_index_workspace_root_generation_v1(
        "C:/work/project")
    if first.len() != 64 or first != same or first == other or
            windows != windows_plain:
        print "FAIL stable workspace root identity"
        return 1
    if cold_full_index_workspace_root_generation_v1("relative/path") != "" or
            cold_full_index_workspace_root_generation_v1("") != "":
        print "FAIL invalid workspace root admitted"
        return 2
    print "PASS cold_full_index_root_identity_probe"
    0
