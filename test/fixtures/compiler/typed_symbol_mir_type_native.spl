# Native boundary regression: actual SymbolTable and MirType APIs.
extern fn rt_exit(code: i64)
use compiler.common.diagnostics.span.Span
use compiler.common.dependency.visibility.Visibility
use compiler.hir.hir_types.{SymbolTable, SymbolId, SymbolKind, HirSymbol}
use compiler.hir.hir_symbol_table_methods.*
use compiler.mir.mir_types.{MirType, MirTypeKind, mir_type_is_text,
    mir_type_probe_text, mir_type_probe_shallow}

fn typed_symbol_require(table: SymbolTable, id: SymbolId?, expected: i64, name: text):
    val observed: HirSymbol? = table.get_symbol(id)
    if val payload = observed:
        val symbol: HirSymbol = payload
        if symbol.id.id != expected or symbol.name != name:
            rt_exit(1)
    else:
        rt_exit(2)

fn main() -> i64:
    var table = SymbolTable.new()
    val zero = table.define("zero_function", SymbolKind.Function, nil,
        Span.empty(), Visibility.Private, false, nil)
    val variable = table.define("variable", SymbolKind.Variable, nil,
        Span.empty(), Visibility.Private, false, nil)
    if zero.id != 0 or variable.id != 1:
        rt_exit(3)
    typed_symbol_require(table, Some(zero), 0, "zero_function")
    typed_symbol_require(table, Some(variable), 1, "variable")
    typed_symbol_require(table, zero, 0, "zero_function")
    val absent: HirSymbol? = table.get_symbol(nil)
    if absent != nil:
        rt_exit(4)
    val missing: HirSymbol? = table.get_symbol(Some(SymbolId.new(999)))
    if missing != nil:
        rt_exit(5)
    val invalid: HirSymbol? = table.get_symbol(Some(SymbolId.new(-1)))
    if invalid != nil:
        rt_exit(6)
    if not table.is_function(zero) or table.is_function(variable) or table.is_function(SymbolId.new(999)):
        rt_exit(7)
    if table.symbol_display_name(zero, "fallback") != "zero_function": rt_exit(15)
    table.rename_symbol(zero, "qualified.zero_function")
    typed_symbol_require(table, Some(zero), 0, "qualified.zero_function")
    if table.symbol_display_name(zero, "fallback") != "qualified.zero_function": rt_exit(16)
    if table.lookup_or_invalid("zero_function").id != 0: rt_exit(17)
    if table.lookup_or_invalid("qualified.zero_function").id != -1: rt_exit(18)
    if not table.exact_symbols.has("qualified.zero_function"): rt_exit(24)
    val exact_id: i64 = table.exact_symbols["qualified.zero_function"]
    if exact_id != 0: rt_exit(25)
    if table.symbol_display_name(SymbolId.new(999), "fallback") != "fallback": rt_exit(19)
    if table.symbol_display_name(SymbolId.new(-1), "fallback") != "fallback": rt_exit(20)
    if table.symbol_display_name(nil, "nil-fallback") != "nil-fallback": rt_exit(21)
    val exact_count = table.exact_symbols.len()
    table.rename_symbol(SymbolId.new(999), "missing")
    table.rename_symbol(nil, "absent")
    if table.symbols.len() != 2 or table.exact_symbols.len() != exact_count: rt_exit(22)
    if table.symbol_display_name(zero, "fallback") != "qualified.zero_function": rt_exit(23)

    val byte = MirType(kind: MirTypeKind.I8)
    val text = MirType.ptr(byte, false)
    val mutable_text = MirType.ptr(byte, true)
    val integer_pointer = MirType.ptr(MirType.i64(), false)
    val alias = text
    if not mir_type_is_text(text) or not mir_type_is_text(mutable_text) or not mir_type_is_text(alias):
        rt_exit(8)
    if mir_type_is_text(integer_pointer) or mir_type_is_text(MirType.i64()) or mir_type_is_text(MirType(kind: MirTypeKind.Opaque("str"))):
        rt_exit(9)
    if mir_type_probe_text(nil) != "nil" or mir_type_probe_shallow(nil) != "nil":
        rt_exit(10)
    if mir_type_probe_text(text) != "Ptr" or mir_type_probe_shallow(text) != "Ptr":
        rt_exit(11)
    val array = MirType(kind: MirTypeKind.Array(MirType.i64(), 3))
    val dict = MirType(kind: MirTypeKind.Dict(MirType.i32(), MirType.bool()))
    if mir_type_probe_text(array) != "Array(I64,3)" or mir_type_probe_shallow(array) != "Array":
        rt_exit(12)
    if mir_type_probe_text(dict) != "Dict(I32,Bool)" or mir_type_probe_shallow(dict) != "Dict":
        rt_exit(13)
    if mir_type_probe_text(MirType(kind: MirTypeKind.Opaque("alias"))) != "Opaque(alias)":
        rt_exit(14)
    print "typed_symbol_mir_type_native=PASS"
    0
