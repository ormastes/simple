# Native boundary probe: calls the production reference walker without parsing
# source fixtures or constructing a complete MirLowering instance.
use compiler.common.diagnostics.span.Span
use compiler.common.dependency.visibility.Visibility
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId}
use compiler.hir.hir_definitions.{HirConst, HirExpr, HirExprKind}
use compiler.hir.generated.hir_children.{HirNode, hir_children_of}
use compiler.mir._MirLowering.provider_globals.*

fn reference_probe_constant(id: i64, value: HirExpr) -> HirConst:
    val span = Span.default()
    HirConst(
        symbol: SymbolId.new(id), name: "probe", type_: HirType(kind: HirTypeKind.Int(64, true), span: span),
        value: value, is_mutable: false, visibility: Visibility.Public,
        is_public: true, is_volatile: false, has_fixed_address: false,
        fixed_address: 0, span: span)

fn main() -> i64:
    val span = Span.default()
    val integer = HirType(kind: HirTypeKind.Int(64, true), span: span)
    val before = HirExpr(kind: HirExprKind.Var(SymbolId.new(7101)), has_type_: false, type_: integer, span: span)
    val after = HirExpr(kind: HirExprKind.NamedVar(SymbolId.new(7102), "after"), has_type_: false, type_: integer, span: span)
    if hir_children_of(HirNode.Expr(nil)).len() != 0:
        print "FAIL generated nil-leaf contract"
        return 1
    val references = mir_global_reference_ids([], [
        reference_probe_constant(1, before),
        reference_probe_constant(2, nil),
        reference_probe_constant(3, after),
        reference_probe_constant(4, before)])
    if references.len() != 2:
        print "FAIL reference count"
        return 2
    if references[0] != 7101 or references[1] != 7102:
        print "FAIL reference order or identity"
        return 3
    print "PASS nil expression leaf preserves both references and deduplication"
    0
