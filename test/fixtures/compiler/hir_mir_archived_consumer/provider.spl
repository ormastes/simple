@layer_eq(Device)
struct View:
    @layer_field(w)
    width: i64 = 37

    fn read_width() -> i64:
        self.width

struct Device:
    w: i64

struct Blob:
    a: i64
    b: i64
    c: i64

fn helper(src: Blob) -> i64:
    val duplicate: Blob = src
    duplicate.a

@copy_budget(32)
fn outer(src: Blob) -> i64:
    helper(src)

fn submit_impl(value: i64) -> i64:
    value + 1

fn final_inner<T>(value: T) -> i64:
    43

fn final_outer<T>(value: T) -> i64:
    final_inner<T>(value)

fn final_call() -> i64:
    final_outer<i64>(41)

fn submit_view(value: i64) -> i64:
    submit_impl(value)

# Real receiver nodes exercise quiet resolution and type attachment, rather
# than checking only the policy bit or unrelated free-function bodies.
fn quiet_view(value: View) -> i64:
    val alias = value
    alias.read_width()

fn quiet_array(values: [i64]) -> i64:
    val alias = values
    alias.len()

@advice(forward, submit_view)
@readonly
@noalloc
@bounded_time
fn trace_first():
    val first_marker: i64 = 37

@advice(forward, submit_view)
@readonly
@noalloc
@bounded_time
fn trace_second():
    val second_marker: i64 = 69

# Real runtime initialization must remain single-owner across aliases.
var initialization_count: i64 = 0
fn initialize_values() -> [i64]:
    initialization_count = initialization_count + 1
    [2, 3]
val initialized_values: [i64] = initialize_values()
fn selected_storage<T>(value: T) -> i64:
    initialized_values[0] + initialization_count
fn storage_call() -> i64:
    selected_storage<i64>(41)
