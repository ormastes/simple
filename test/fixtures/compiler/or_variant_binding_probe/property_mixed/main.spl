use .provider.{E, Holder}

fn select(holder: Holder) -> i64:
    match holder.kind:
        case Deref | Field(_):
            1
        case _:
            0

fn main() -> i64:
    print select(Holder(kind: E.Deref))
    print select(Holder(kind: E.Field(29)))
    print select(Holder(kind: E.Downcast(3)))
    return 0
