use .provider.{E}

fn count() -> i64:
    var total = 0
    for value in [E.Deref, E.Field(29), E.Downcast(3)]:
        match value:
            case Deref | Field(_):
                total = total + 1
            case _:
                pass
    return total

fn main() -> i64:
    print count()
    return 0
