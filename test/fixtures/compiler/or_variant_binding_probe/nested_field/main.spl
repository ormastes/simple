use .provider.{E, Holder, Inner}

fn select(holder: Holder) -> i64:
    match holder.inner.kind:
        case Deref | Field(_):
            1
        case _:
            0

fn main() -> i64:
    print select(Holder(inner: Inner(kind: E.Deref)))
    print select(Holder(inner: Inner(kind: E.Field(23))))
    return 0
