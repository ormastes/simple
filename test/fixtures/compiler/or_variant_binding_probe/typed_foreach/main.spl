use .provider.{E}

fn count(values: [E]) -> i64:
    var total = 0
    for value in values:
        match value:
            case Deref | Field(_):
                total = total + 1
            case _:
                pass
    return total

fn main() -> i64:
    print count([E.Deref, E.Field(17), E.Downcast(3)])
    return 0
