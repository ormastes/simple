# Known-failure reproducer, not a passing test or a release qualification gate.
# Generic early return still escapes the legacy Future.from_value block. A
# real fix needs explicit forwarding of all generic arguments into a helper.
use std.async.future.{Future}
use std.async.poll.{Poll}

async fn generic_early<T>(value: T) -> T:
    return value

fn main() -> i64:
    val future: Future<i64> = generic_early(29)
    match future.poll():
        case Poll.Ready(value):
            if value == 29: return 0
        case Poll.Pending: ()
    1
