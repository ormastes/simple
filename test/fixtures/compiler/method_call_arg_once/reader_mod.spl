# Fixture: a module-internal call whose argument is a `me` method call.
pub class OnceReader:
    data: [u8]
    offset: i64
    me fn read_u8() -> i64:
        val value = self.data[self.offset] & 0xFF
        self.offset = self.offset + 1
        value

fn _once_id(t: i64) -> i64: t
pub fn once_public_id(t: i64) -> i64: t
fn _once_pair(t: i64, u: i64) -> i64: t + u

pub fn once_offsets(b: [u8]) -> [i64]:
    val r = OnceReader(data: b, offset: 0)
    val a = _once_id(r.read_u8())
    val o1 = r.offset
    val c = once_public_id(r.read_u8())
    val o2 = r.offset
    val d = _once_pair(r.read_u8(), 0)
    val o3 = r.offset
    [a, o1, c, o2, d, o3]

export OnceReader, once_offsets, once_public_id
