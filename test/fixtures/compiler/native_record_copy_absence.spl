struct CopyChild:
    value: i64

struct CopyParent:
    child: CopyChild
    sibling: i64

fn copy_parameter(value: CopyChild) -> CopyChild:
    value

fn main() -> i64:
    val missing: CopyChild = nil
    val missing_copy: CopyChild = missing
    if missing_copy.?: return 1
    if copy_parameter(missing).?: return 2
    val pairs: [(CopyChild, CopyChild)] = [(missing, CopyChild(value: 17)), (CopyChild(value: 23), missing)]
    var missing_keys = 0
    var missing_values = 0
    for (key, value) in pairs:
        val key_copy: CopyChild = key
        val value_copy: CopyChild = value
        if not key_copy.?: missing_keys = missing_keys + 1
        if not value_copy.?: missing_values = missing_values + 1
    if missing_keys != 1 or missing_values != 1: return 3
    val absent_parent = CopyParent(child: missing, sibling: 31)
    val absent_parent_copy = absent_parent
    if absent_parent_copy.child.?: return 4
    if absent_parent_copy.sibling != 31: return 5
    val original = CopyChild(value: 41)
    var copied = original
    copied.value = 97
    if original.value != 41 or copied.value != 97: return 6
    val parent = CopyParent(child: CopyChild(value: 53), sibling: 59)
    var parent_copy = parent
    parent_copy.child.value = 101
    if parent.child.value != 53 or parent_copy.child.value != 101: return 7
    print "RECORD_COPY_ABSENCE_PASS"
    0
