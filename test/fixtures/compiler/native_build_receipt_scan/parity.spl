use app.cli.native_build_receipt_scan.{native_build_log_has_exact_line_v1}

fn receipt_scan_legacy_oracle(output: text, expected: text) -> bool:
    output.replace("\r\n", "\n").split("\n").contains(expected)

fn main() -> i64:
    val atoms = ["", "r", "rr", "\r", "\n", "\r\n", "\r\r\n", "한"]
    val expected_lines = ["", "r", "rr", "r\r", "한", "r\nr", "r\r\n", "\r"]
    var cases: i64 = 0
    for left in atoms:
        for middle in atoms:
            for right in atoms:
                val output = left + middle + right
                for expected in expected_lines:
                    val wanted = receipt_scan_legacy_oracle(output, expected)
                    val actual = native_build_log_has_exact_line_v1(output, expected)
                    if actual != wanted:
                        print "receipt-scan parity failed case={cases}"
                        return 1
                    cases = cases + 1
    if not native_build_log_has_exact_line_v1("receipt", "receipt"):
        return 2
    if native_build_log_has_exact_line_v1("receiptX", "receipt"):
        return 3
    if not native_build_log_has_exact_line_v1("prefix\r\nArtifact: 빌드/출력.o\r\n", "Artifact: 빌드/출력.o"):
        return 4
    if native_build_log_has_exact_line_v1("receipt\r\n", "receipt\r"):
        return 5
    if not native_build_log_has_exact_line_v1("receipt\r\r\n", "receipt\r"):
        return 6
    if native_build_log_has_exact_line_v1("receipt\nforged", "receipt\nforged"):
        return 7
    print "receipt-scan parity cases={cases} explicit_cases=6 failures=0"
    0
