use compiler.core.ast.{ast_reset}

extern fn rt_transient_array_scope_begin() -> bool
extern fn rt_transient_array_scope_pause() -> bool
extern fn rt_transient_array_scope_end() -> bool

fn main() -> i64:
    if not rt_transient_array_scope_begin():
        return 31
    ast_reset()
    if not rt_transient_array_scope_pause():
        return 32
    if not rt_transient_array_scope_end():
        return 33

    # This was the exact native crash boundary: expr_env_mirror_slot retained
    # the reclaimed singleton allocated by the first reset.
    ast_reset()
    print "ast_mode_slot_transient_reset=true"
    0
