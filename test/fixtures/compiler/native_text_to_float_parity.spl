fn parse_value(value: text) -> f64:
    value.to_float()

fn main() -> i32:
    if parse_value("1.5") != 1.5: return 1
    if parse_value("-2.25") != -2.25: return 2
    if "1.5".to_f64() != 1.5: return 3
    if "invalid".to_float() != 0.0: return 4
    if "0".to_float() != 0.0: return 5
    val integer: i64 = -7
    if integer.to_float() != -7.0: return 6
    val unsigned: u64 = 42
    if unsigned.to_float() != 42.0: return 7
    print "PASS native text and numeric float conversion"
    0
