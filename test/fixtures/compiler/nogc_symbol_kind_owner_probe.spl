use std.io_runtime.{exit}
use compiler.hir.hir_types.{HirTypeKind, SymbolKind}
use compiler.hir.hir_kind_carrier.{symbol_kind_discriminant, symbol_kind_has_carrier_owner}

enum CarrierEnvelope:
    Wrapped(value: HirTypeKind)

@unsafe(reason: "returns the original enum payload as a deliberately forged foreign enum view", capabilities: [ffi])
extern fn rt_enum_payload(value: CarrierEnvelope) -> SymbolKind
@unsafe(reason: "reads the runtime enum family for a carrier-owner diagnostic", capabilities: [ffi])
extern fn rt_enum_id<T>(value: T) -> i64

fn check_symbol_owner(condition: bool, message: text):
    if not condition:
        print "FAIL: {message}"
        exit(1)

fn main() -> i64:
    val foreign = CarrierEnvelope.Wrapped(HirTypeKind.Int(8, false))
    val forged: SymbolKind = unsafe(capabilities: [ffi]):
        rt_enum_payload(foreign)
    val foreign_id = unsafe(capabilities: [ffi]):
        rt_enum_id(HirTypeKind.Int(8, false))
    val forged_id = unsafe(capabilities: [ffi]):
        rt_enum_id(forged)
    val symbol_kind_id = unsafe(capabilities: [ffi]):
        rt_enum_id(SymbolKind.Function)

    check_symbol_owner(symbol_kind_id > 0, "SymbolKind owner has an authoritative positive family ID")
    check_symbol_owner(symbol_kind_discriminant(forged) == 0, "foreign enum view carries ordinal zero")
    check_symbol_owner(forged_id == foreign_id, "payload retains the foreign HirTypeKind owner")
    check_symbol_owner(forged_id != symbol_kind_id, "foreign owner differs from SymbolKind owner")
    check_symbol_owner(not symbol_kind_has_carrier_owner(forged), "foreign ordinal-zero enum view is rejected")
    check_symbol_owner(symbol_kind_has_carrier_owner(SymbolKind.Function), "SymbolKind first ordinal-zero variant is accepted")
    check_symbol_owner(symbol_kind_has_carrier_owner(SymbolKind.Struct), "another valid SymbolKind variant is accepted")

    val raw_zero: SymbolKind = 0
    val nil_kind: SymbolKind = nil
    check_symbol_owner(symbol_kind_discriminant(raw_zero) < 0, "raw zero SymbolKind carrier is absent")
    check_symbol_owner(not symbol_kind_has_carrier_owner(raw_zero), "raw zero SymbolKind carrier has no owner")
    check_symbol_owner(symbol_kind_discriminant(nil_kind) < 0, "nil SymbolKind carrier is absent")
    check_symbol_owner(not symbol_kind_has_carrier_owner(nil_kind), "nil SymbolKind carrier has no owner")

    print "symbol-kind owner guard: foreign ordinal-zero carrier rejected; valid variants retained"
    0
