# Native fail-fast regression for fresh provider-default factory evaluation.
extern fn rt_exit(code: i64)
use compiler.mono.monomorphize_integration.{MonomorphizationPass, mono_default_warnings_v1, mono_default_archive_requests_v1}
use compiler.mono.mono_archive_types_v1.{MonoSpecializationRequestV1}

class ProviderDefaultFactoryProbe:
    warnings: [text] = mono_default_warnings_v1()
    requests: [MonoSpecializationRequestV1] = mono_default_archive_requests_v1()

fn main() -> i64:
    var first = ProviderDefaultFactoryProbe()
    var second = ProviderDefaultFactoryProbe()
    if first.warnings.len() != 0 or second.warnings.len() != 0: rt_exit(1)
    if first.requests.len() != 0 or second.requests.len() != 0: rt_exit(2)
    first.warnings = first.warnings.push("first")
    if first.warnings.len() != 1 or second.warnings.len() != 0: rt_exit(3)
    second.warnings = second.warnings.push("second")
    first.warnings[0] = "changed"
    if second.warnings[0] != "second": rt_exit(4)
    val request = MonoSpecializationRequestV1(template_name: "template", module_name: "provider",
        mangled_name: "instance", symbol_id: 7, type_args: [])
    first.requests = first.requests.push(request)
    if first.requests.len() != 1 or second.requests.len() != 0: rt_exit(5)
    val third = ProviderDefaultFactoryProbe()
    if third.warnings.len() != 0 or third.requests.len() != 0: rt_exit(6)
    val pass = MonomorphizationPass.create()
    if pass.warnings.len() != 0 or pass.archive_requests.len() != 0: rt_exit(7)
    print "provider-default-factory: PASS 7 fail-fast cases"
    0