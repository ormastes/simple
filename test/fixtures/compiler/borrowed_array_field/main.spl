# Native regression for borrowed nominal array-field metadata and owner mutation.
struct BorrowedCapabilityProbe:
    descriptor: i64

class BorrowedClassScopeProbe:
    guard: i64
    capabilities: [BorrowedCapabilityProbe]
    closed_count: i64

struct BorrowedStructScopeProbe:
    guard: i64
    capabilities: [BorrowedCapabilityProbe]
    closed_count: i64

fn drain_class(scope: &BorrowedClassScopeProbe) -> i64:
    var total = 0
    for capability in scope.capabilities:
        total = total + capability.descriptor
    val last = scope.capabilities.pop().unwrap()
    if last.descriptor != 29:
        return -1
    scope.closed_count = scope.closed_count + 1
    val first: BorrowedCapabilityProbe = scope.capabilities.pop().unwrap()
    if first.descriptor != 17:
        return -2
    scope.closed_count = scope.closed_count + 1
    total

fn drain_struct(scope: &BorrowedStructScopeProbe) -> i64:
    var total = 0
    for capability in scope.capabilities:
        total = total + capability.descriptor
    val last = scope.capabilities.pop().unwrap()
    if last.descriptor != 43:
        return -3
    scope.closed_count = scope.closed_count + 1
    val first: BorrowedCapabilityProbe = scope.capabilities.pop().unwrap()
    if first.descriptor != 31:
        return -4
    scope.closed_count = scope.closed_count + 1
    total

fn main() -> i64:
    val class_items = [BorrowedCapabilityProbe(descriptor: 17), BorrowedCapabilityProbe(descriptor: 29)]
    var class_scope = BorrowedClassScopeProbe(guard: 73, capabilities: class_items, closed_count: 0)
    val class_total = drain_class(&class_scope)
    if class_total != 46:
        return 11
    if class_scope.guard != 73 or class_scope.closed_count != 2:
        return 12
    if class_scope.capabilities.len() != 0:
        return 13
    val struct_items = [BorrowedCapabilityProbe(descriptor: 31), BorrowedCapabilityProbe(descriptor: 43)]
    var struct_scope = BorrowedStructScopeProbe(guard: 97, capabilities: struct_items, closed_count: 0)
    val struct_total = drain_struct(&struct_scope)
    if struct_total != 74:
        return 21
    if struct_scope.guard != 97 or struct_scope.closed_count != 2:
        return 22
    if struct_scope.capabilities.len() != 0:
        return 23
    0
