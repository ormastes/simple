# Native-only negative fixture. The provider's bounds-checked text accessor
# returns NIL for an absent element. Intentionally keep that machine-word
# value in the text lane to exercise an invalid input without fabricating or
# dereferencing a pointer. This declaration is test-only.
use compiler.frontend.core.flat_pool_codec.{flat_pool_enc_text}

extern fn rt_array_get_text(values: [text], index: i64) -> text
extern fn rt_string_len(value: Any) -> i64

fn main() -> i32:
    if flat_pool_enc_text(["", "a\nb", "c\\d"]) != "3\n\na\\nb\nc\\\\d\n":
        return 41
    val empty: [text] = []
    val invalid = rt_array_get_text(empty, 0)
    if rt_string_len(invalid) != -1:
        return 42
    val unexpected = flat_pool_enc_text(["valid", invalid])
    print "unexpected-append-success:{unexpected}"
    43
