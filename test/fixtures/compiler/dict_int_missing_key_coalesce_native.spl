# Seed-native regression probe for a missing integer-valued Dict key.
# Expected stdout: i64idx=-1 i64get=-1 textidx=dflt textkey=-7
# As of 2026-10-31 the Rust seed prints i64idx=3 and textkey=nil, because
# `d[k] ?? x` with an i64 value type yields the raw nil tag. See
# doc/08_tracking/bug/seed_dict_int_index_nil_coalesce_2026-10-31.md.

fn main():
    var d: Dict<i64, i64> = {}
    d[5] = 5
    val a = d[9] ?? -1
    val b = d.get(9) ?? -1
    var e: Dict<i64, text> = {}
    e[1] = "x"
    val c = e[2] ?? "dflt"
    var f: Dict<text, i64> = {}
    f["k"] = 4
    val g = f["z"] ?? -7
    print "i64idx={a} i64get={b} textidx={c} textkey={g}"
