# Named payloads can be destructured positionally in declaration order.
enum NamedPatternMode:
    Plain
    Composite(spec: text, count: i64)

fn named_pattern_value(mode: NamedPatternMode) -> i64:
    match mode:
        case NamedPatternMode.Plain: 0
        case NamedPatternMode.Composite(spec, count):
            if spec != "named-positional-ok": return -1
            return count + 2

fn main() -> i64:
    if named_pattern_value(NamedPatternMode.Plain) != 0: return 1
    if named_pattern_value(NamedPatternMode.Composite("named-positional-ok", 40)) != 42: return 2
    print("named-positional-ok")
    return 0
