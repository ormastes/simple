# Native Cranelift float casts must use destination signedness/width and
# extend narrow conversion results to the uniform I64 SSA lane before return.
# Parameters prevent constant folding; direct chains expose the Cast result.

fn f32_to_i8(value: f32) -> i64:
    (value as i8).to_i64()

fn f32_to_u8(value: f32) -> i64:
    (value as u8).to_i64()

fn f32_to_i16(value: f32) -> i64:
    (value as i16).to_i64()

fn f32_to_u16(value: f32) -> i64:
    (value as u16).to_i64()

fn f32_to_i32(value: f32) -> i64:
    (value as i32).to_i64()

fn f32_to_u32(value: f32) -> i64:
    (value as u32).to_i64()

fn f32_to_i64(value: f32) -> i64:
    (value as i64).to_i64()

fn f32_to_u64(value: f32) -> i64:
    (value as u64).to_i64()

fn f64_to_i8(value: f64) -> i64:
    (value as i8).to_i64()

fn f64_to_u8(value: f64) -> i64:
    (value as u8).to_i64()

fn f64_to_i16(value: f64) -> i64:
    (value as i16).to_i64()

fn f64_to_u16(value: f64) -> i64:
    (value as u16).to_i64()

fn f64_to_i32(value: f64) -> i64:
    (value as i32).to_i64()

fn f64_to_u32(value: f64) -> i64:
    (value as u32).to_i64()

fn f64_to_i64(value: f64) -> i64:
    (value as i64).to_i64()

fn f64_to_u64(value: f64) -> i64:
    (value as u64).to_i64()

fn main() -> i64:
    if f32_to_i8(-3.75) != -3: return 1
    if f32_to_i8(3.75) != 3: return 2
    if f32_to_u8(128.0) != 128: return 3
    if f32_to_u8(3.75) != 3: return 4
    if f32_to_i16(-3.75) != -3: return 5
    if f32_to_i16(3.75) != 3: return 6
    if f32_to_u16(32768.0) != 32768: return 7
    if f32_to_u16(3.75) != 3: return 8
    if f32_to_i32(-3.75) != -3: return 9
    if f32_to_i32(3.75) != 3: return 10
    if f32_to_u32(2147483648.0) != 2147483648: return 11
    if f32_to_u32(3.75) != 3: return 12
    if f32_to_i64(-3.75) != -3: return 13
    if f32_to_i64(3.75) != 3: return 14
    if f32_to_u64(9223372036854775808.0) != (-9223372036854775807 - 1): return 15
    if f32_to_u64(3.75) != 3: return 16
    if f64_to_i8(-3.75) != -3: return 17
    if f64_to_i8(3.75) != 3: return 18
    if f64_to_u8(128.0) != 128: return 19
    if f64_to_u8(3.75) != 3: return 20
    if f64_to_i16(-3.75) != -3: return 21
    if f64_to_i16(3.75) != 3: return 22
    if f64_to_u16(32768.0) != 32768: return 23
    if f64_to_u16(3.75) != 3: return 24
    if f64_to_i32(-3.75) != -3: return 25
    if f64_to_i32(3.75) != 3: return 26
    if f64_to_u32(2147483648.0) != 2147483648: return 27
    if f64_to_u32(3.75) != 3: return 28
    if f64_to_i64(-3.75) != -3: return 29
    if f64_to_i64(3.75) != 3: return 30
    if f64_to_u64(9223372036854775808.0) != (-9223372036854775807 - 1): return 31
    if f64_to_u64(3.75) != 3: return 32
    if f32_to_i8(-128.75) != -128: return 33
    if f32_to_i8(127.75) != 127: return 34
    if f32_to_u8(255.75) != 255: return 35
    if f32_to_i16(-32768.75) != -32768: return 36
    if f32_to_i16(32767.75) != 32767: return 37
    if f32_to_u16(65535.75) != 65535: return 38
    if f64_to_i8(-128.75) != -128: return 39
    if f64_to_i8(127.75) != 127: return 40
    if f64_to_u8(255.75) != 255: return 41
    if f64_to_i16(-32768.75) != -32768: return 42
    if f64_to_i16(32767.75) != 32767: return 43
    if f64_to_u16(65535.75) != 65535: return 44
    if f32_to_u8(-0.75) != 0: return 45
    if f32_to_u16(-0.75) != 0: return 46
    if f64_to_u8(-0.75) != 0: return 47
    if f64_to_u16(-0.75) != 0: return 48
    print "PASS float integer cast checks=48"
    0
