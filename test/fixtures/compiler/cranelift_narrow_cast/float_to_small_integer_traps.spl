# Each named negative case runs in its own process. A valid control proves
# the executable/argument dispatch works. A returned cast always exits zero,
# so an out-of-range conversion cannot pass merely by returning an error code.
use std.io_runtime.{get_args}

fn f32_to_i8(value: f32) -> i64:
    (value as i8).to_i64()

fn f32_to_u8(value: f32) -> i64:
    (value as u8).to_i64()

fn f32_to_i16(value: f32) -> i64:
    (value as i16).to_i64()

fn f32_to_u16(value: f32) -> i64:
    (value as u16).to_i64()

fn f32_divide(left: f32, right: f32) -> f32:
    left / right

fn f64_to_i8(value: f64) -> i64:
    (value as i8).to_i64()

fn f64_to_u8(value: f64) -> i64:
    (value as u8).to_i64()

fn f64_to_i16(value: f64) -> i64:
    (value as i16).to_i64()

fn f64_to_u16(value: f64) -> i64:
    (value as u16).to_i64()

fn f64_divide(left: f64, right: f64) -> f64:
    left / right

fn unexpected_cast_return(value: i64) -> i64:
    print "UNEXPECTED cast returned {value}"
    0

fn main() -> i64:
    for name in get_args():
        if name == "valid":
            if f32_to_i8(-128.75f32) != -128: return 98
            if f64_to_u16(65535.75) != 65535: return 99
            print "PASS float cast trap control"
            return 0
        elif name == "f32_i8_overflow":
            print "ENTER f32_i8_overflow"
            return unexpected_cast_return(f32_to_i8(128.0f32))
        elif name == "f32_i8_underflow":
            print "ENTER f32_i8_underflow"
            return unexpected_cast_return(f32_to_i8(-129.0f32))
        elif name == "f32_u8_overflow":
            print "ENTER f32_u8_overflow"
            return unexpected_cast_return(f32_to_u8(256.0f32))
        elif name == "f32_u8_underflow":
            print "ENTER f32_u8_underflow"
            return unexpected_cast_return(f32_to_u8(-1.0f32))
        elif name == "f32_i16_overflow":
            print "ENTER f32_i16_overflow"
            return unexpected_cast_return(f32_to_i16(32768.0f32))
        elif name == "f32_i16_underflow":
            print "ENTER f32_i16_underflow"
            return unexpected_cast_return(f32_to_i16(-32769.0f32))
        elif name == "f32_u16_overflow":
            print "ENTER f32_u16_overflow"
            return unexpected_cast_return(f32_to_u16(65536.0f32))
        elif name == "f32_u16_underflow":
            print "ENTER f32_u16_underflow"
            return unexpected_cast_return(f32_to_u16(-1.0f32))
        elif name == "f32_i8_nan":
            print "ENTER f32_i8_nan"
            return unexpected_cast_return(f32_to_i8(f32_divide(0.0f32, 0.0f32)))
        elif name == "f32_i8_positive_infinity":
            print "ENTER f32_i8_positive_infinity"
            return unexpected_cast_return(f32_to_i8(f32_divide(1.0f32, 0.0f32)))
        elif name == "f32_i8_negative_infinity":
            print "ENTER f32_i8_negative_infinity"
            return unexpected_cast_return(f32_to_i8(f32_divide(-1.0f32, 0.0f32)))
        elif name == "f32_u8_nan":
            print "ENTER f32_u8_nan"
            return unexpected_cast_return(f32_to_u8(f32_divide(0.0f32, 0.0f32)))
        elif name == "f32_u8_positive_infinity":
            print "ENTER f32_u8_positive_infinity"
            return unexpected_cast_return(f32_to_u8(f32_divide(1.0f32, 0.0f32)))
        elif name == "f32_u8_negative_infinity":
            print "ENTER f32_u8_negative_infinity"
            return unexpected_cast_return(f32_to_u8(f32_divide(-1.0f32, 0.0f32)))
        elif name == "f32_i16_nan":
            print "ENTER f32_i16_nan"
            return unexpected_cast_return(f32_to_i16(f32_divide(0.0f32, 0.0f32)))
        elif name == "f32_i16_positive_infinity":
            print "ENTER f32_i16_positive_infinity"
            return unexpected_cast_return(f32_to_i16(f32_divide(1.0f32, 0.0f32)))
        elif name == "f32_i16_negative_infinity":
            print "ENTER f32_i16_negative_infinity"
            return unexpected_cast_return(f32_to_i16(f32_divide(-1.0f32, 0.0f32)))
        elif name == "f32_u16_nan":
            print "ENTER f32_u16_nan"
            return unexpected_cast_return(f32_to_u16(f32_divide(0.0f32, 0.0f32)))
        elif name == "f32_u16_positive_infinity":
            print "ENTER f32_u16_positive_infinity"
            return unexpected_cast_return(f32_to_u16(f32_divide(1.0f32, 0.0f32)))
        elif name == "f32_u16_negative_infinity":
            print "ENTER f32_u16_negative_infinity"
            return unexpected_cast_return(f32_to_u16(f32_divide(-1.0f32, 0.0f32)))
        elif name == "f64_i8_overflow":
            print "ENTER f64_i8_overflow"
            return unexpected_cast_return(f64_to_i8(128.0))
        elif name == "f64_i8_underflow":
            print "ENTER f64_i8_underflow"
            return unexpected_cast_return(f64_to_i8(-129.0))
        elif name == "f64_u8_overflow":
            print "ENTER f64_u8_overflow"
            return unexpected_cast_return(f64_to_u8(256.0))
        elif name == "f64_u8_underflow":
            print "ENTER f64_u8_underflow"
            return unexpected_cast_return(f64_to_u8(-1.0))
        elif name == "f64_i16_overflow":
            print "ENTER f64_i16_overflow"
            return unexpected_cast_return(f64_to_i16(32768.0))
        elif name == "f64_i16_underflow":
            print "ENTER f64_i16_underflow"
            return unexpected_cast_return(f64_to_i16(-32769.0))
        elif name == "f64_u16_overflow":
            print "ENTER f64_u16_overflow"
            return unexpected_cast_return(f64_to_u16(65536.0))
        elif name == "f64_u16_underflow":
            print "ENTER f64_u16_underflow"
            return unexpected_cast_return(f64_to_u16(-1.0))
        elif name == "f64_i8_nan":
            print "ENTER f64_i8_nan"
            return unexpected_cast_return(f64_to_i8(f64_divide(0.0, 0.0)))
        elif name == "f64_i8_positive_infinity":
            print "ENTER f64_i8_positive_infinity"
            return unexpected_cast_return(f64_to_i8(f64_divide(1.0, 0.0)))
        elif name == "f64_i8_negative_infinity":
            print "ENTER f64_i8_negative_infinity"
            return unexpected_cast_return(f64_to_i8(f64_divide(-1.0, 0.0)))
        elif name == "f64_u8_nan":
            print "ENTER f64_u8_nan"
            return unexpected_cast_return(f64_to_u8(f64_divide(0.0, 0.0)))
        elif name == "f64_u8_positive_infinity":
            print "ENTER f64_u8_positive_infinity"
            return unexpected_cast_return(f64_to_u8(f64_divide(1.0, 0.0)))
        elif name == "f64_u8_negative_infinity":
            print "ENTER f64_u8_negative_infinity"
            return unexpected_cast_return(f64_to_u8(f64_divide(-1.0, 0.0)))
        elif name == "f64_i16_nan":
            print "ENTER f64_i16_nan"
            return unexpected_cast_return(f64_to_i16(f64_divide(0.0, 0.0)))
        elif name == "f64_i16_positive_infinity":
            print "ENTER f64_i16_positive_infinity"
            return unexpected_cast_return(f64_to_i16(f64_divide(1.0, 0.0)))
        elif name == "f64_i16_negative_infinity":
            print "ENTER f64_i16_negative_infinity"
            return unexpected_cast_return(f64_to_i16(f64_divide(-1.0, 0.0)))
        elif name == "f64_u16_nan":
            print "ENTER f64_u16_nan"
            return unexpected_cast_return(f64_to_u16(f64_divide(0.0, 0.0)))
        elif name == "f64_u16_positive_infinity":
            print "ENTER f64_u16_positive_infinity"
            return unexpected_cast_return(f64_to_u16(f64_divide(1.0, 0.0)))
        elif name == "f64_u16_negative_infinity":
            print "ENTER f64_u16_negative_infinity"
            return unexpected_cast_return(f64_to_u16(f64_divide(-1.0, 0.0)))
    97
