# Native Cranelift cast regression and signed/unsigned width matrix.
# Keep casts on runtime parameters and widen directly: an annotated narrow
# temporary would emit another cast and could conceal a noncanonical result.
# Exit codes identify the first failed assertion; success requires every row.

fn i8_to_i8(value: i8) -> i64:
    (value as i8).to_i64()

fn i8_to_u8(value: i8) -> i64:
    (value as u8).to_i64()

fn i8_to_i16(value: i8) -> i64:
