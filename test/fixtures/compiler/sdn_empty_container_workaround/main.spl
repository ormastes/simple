use std.common.sdn.value.{SdnValue, sdn_value_to_text}

fn array_is_empty(value: SdnValue) -> bool:
    match value:
        case Array(items): items.len() == 0
        case _: false

fn dict_is_empty(value: SdnValue) -> bool:
    match value:
        case Dict(entries): entries.keys().len() == 0
        case _: false

fn main() -> i64:
    val empty_array = SdnValue.empty_array()
    val empty_dict = SdnValue.empty_dict()
    if not array_is_empty(empty_array): return 1
    if not dict_is_empty(empty_dict): return 2
    if array_is_empty(empty_dict): return 3
    if dict_is_empty(empty_array): return 4
    if sdn_value_to_text(empty_array) != "[]": return 5
    if sdn_value_to_text(empty_dict) != "{...}": return 6
    val nested: [SdnValue] = [empty_array, empty_dict]
    if sdn_value_to_text(SdnValue.array(nested)) != "[[], {...}]": return 7
    print "sdn_empty_container_workaround: PASS"
    0
