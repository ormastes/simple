fn crash_exit(signal_number: i64, exit_code: i64) -> i64:
    val result = if signal_number > 0:
        128 + signal_number
    else:
        exit_code
    result

fn available_capacity(host: i64, process: i64) -> i64:
    val result = if host < process:
        host
    else:
        process
    result

fn retained_thread_bytes(values: [i64], resource_index: i64) -> i64:
    val result = if resource_index >= 0:
        values[resource_index]
    else:
        0
    result

fn write_suffix(chunk: [i64], offset: i64) -> [i64]:
    val remaining = if offset == 0:
        chunk
    else:
        chunk.slice(offset, chunk.len())
    remaining

fn main() -> i64:
    if crash_exit(11, 1) != 139: return 1
    if crash_exit(0, 7) != 7: return 2
    if crash_exit(0, 0) != 0: return 3
    if available_capacity(5, 9) != 5: return 4
    if available_capacity(9, 5) != 5: return 5
    if available_capacity(0, 0) != 0: return 6
    if retained_thread_bytes([], -1) != 0: return 7
    if retained_thread_bytes([], -2) != 0: return 8
    if retained_thread_bytes([31, 47], 0) != 31: return 9
    if retained_thread_bytes([31, 47], 1) != 47: return 10
    val whole = write_suffix([31, 47], 0)
    if whole.len() != 2: return 11
    if whole[0] != 31: return 12
    if whole[1] != 47: return 13
    val suffix = write_suffix([31, 47], 1)
    if suffix.len() != 1: return 14
    if suffix[0] != 47: return 15
    if write_suffix([], 0).len() != 0: return 16
    if write_suffix([31, 47], 2).len() != 0: return 17
    print "bootstrap multiline if: 17 checks, 0 failures"
    0
