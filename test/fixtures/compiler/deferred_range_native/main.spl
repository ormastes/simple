use compiler.mono.monomorphize.deferred_deserialize.{read_text_field, deserialize_last_error, deferred_text_field_bytes}
use compiler.mono.monomorphize.deferred_subst.{_substitute_type_in_text}

fn main() -> i64:
    # Nonzero offset, a two-byte codepoint, a four-byte codepoint, and trailing
    # invalid UTF-8 outside the field: decode exactly the declared byte window.
    val encoded: [u8] = [255u8, 6u8, 0u8, 0u8, 0u8, 0xC3u8, 0xA9u8, 0xF0u8, 0x9Fu8, 0x98u8, 0x80u8, 255u8]
    if val field = read_text_field(encoded, 1):
        if field.0 != "é😀": return 1
        if field.1 != 11: return 2
    else:
        return 3

    val empty: [u8] = [0u8, 0u8, 0u8, 0u8, 255u8]
    if val field = read_text_field(empty, 0):
        if field.0 != "": return 4
        if field.1 != 4: return 5
    else:
        return 6

    val truncated: [u8] = [2u8, 0u8, 0u8, 0u8, 65u8]
    if read_text_field(truncated, 0) != nil: return 7
    if deserialize_last_error() != "Unexpected end of data reading text at offset 4": return 8
    val invalid: [u8] = [1u8, 0u8, 0u8, 0u8, 255u8]
    if read_text_field(invalid, 0) != nil: return 9
    if deserialize_last_error() != "Invalid UTF-8 text field": return 10
    val split_codepoint: [u8] = [1u8, 0u8, 0u8, 0u8, 0xC3u8, 0xA9u8]
    if read_text_field(split_codepoint, 0) != nil: return 11
    if deserialize_last_error() != "Invalid UTF-8 text field": return 12

    # Preserve the range expression's negative-index and clamping behavior.
    val bytes: [u8] = [11u8, 22u8, 33u8, 44u8]
    val tail = deferred_text_field_bytes(bytes, -3, -1)
    if tail.len() != 2: return 13
    if tail[0] != 22u8 or tail[1] != 33u8: return 14
    val clamped = deferred_text_field_bytes(bytes, -99, 99)
    if clamped.len() != 4: return 15
    if clamped[0] != 11u8 or clamped[3] != 44u8: return 16
    if deferred_text_field_bytes(bytes, 3, 1).len() != 0: return 17
    if deferred_text_field_bytes(bytes, 99, 99).len() != 0: return 18
    if deferred_text_field_bytes(bytes, 0, -99).len() != 0: return 19

    if _substitute_type_in_text("T List<T> TT _T T_ T2 2T", "T", "i64") != "i64 List<i64> TT _T T_ T2 2T": return 20
    if _substitute_type_in_text("T->T", "T", "u8") != "u8->u8": return 21
    if _substitute_type_in_text("é(T)😀", "T", "text") != "é(text)😀": return 22
    if _substitute_type_in_text("T", "", "i64") != "T": return 23
    if _substitute_type_in_text("", "T", "i64") != "": return 24
    print "deferred_range_native: PASS"
    0
