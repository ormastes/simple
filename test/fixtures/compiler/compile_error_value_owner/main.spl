use compiler.common.error.{CompileError}
use compiler.common.runtime_value_v1.{Value, backend_value_string_v1, backend_value_int_v1}
use compiler.hir.hir_definitions.{HirExprKind}
use compiler.mir.mir_types.{MirTypeKind}
use old_provider.{old_string, old_function, old_object, old_closure, old_enum, old_accept}

fn main() -> i64:
    val error = CompileError.try_error(old_string())
    match error:
        case CompileError.TryError(value):
            match value:
                case Value.String(message):
                    if message != "old payload Ω": return 11
                case _: return 12
        case _: return 13
    if error.message() != "try error (? operator)": return 14
    if not old_accept(backend_value_string_v1("new payload Ω")): return 15
    if CompileError.semantic("ordinary error").message() != "ordinary error": return 16
    match old_function():
        case Value.Function(function):
            if function.symbol.id != 41 or function.name != "callable_word": return 21
        case _: return 22
    match old_object():
        case Value.Object(object):
            if object.class_name != "Device" or object.handle != 73: return 31
        case _: return 32
    match old_closure():
        case Value.Closure(closure):
            if closure.params.len() != 1: return 41
            if closure.params[0].name != "enabled" or closure.params[0].symbol.id != 43: return 42
            if not closure.params[0].has_default: return 43
            match closure.body.kind:
                case HirExprKind.BoolLit(enabled):
                    if not enabled: return 44
                case _: return 45
            match closure.captures["captured"]:
                case Value.Int(number):
                    if number != -29: return 46
                case _: return 47
        case _: return 48
    match old_enum():
        case Value.Enum(type_, variant, payload):
            if type_ != "Wire" or variant != "Word" or payload == nil: return 51
            match payload.unwrap():
                case Tuple(values):
                    if values.len() != 1 or values[0].as_int() != 59: return 52
                case _: return 53
        case _: return 54
    val type_ = backend_value_int_v1(7).get_type()
    if type_ == nil: return 61
    match type_.unwrap().kind:
        case MirTypeKind.I64: ()
        case _: return 62
    if Value.int(67).as_int() != 67: return 63
    0
