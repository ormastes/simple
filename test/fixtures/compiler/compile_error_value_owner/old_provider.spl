use compiler.backend.backend_types.{Value, EnumPayloadValue, FunctionValue, ClosureValue,
    ObjectValue, backend_value_string_v1, backend_value_int_v1, backend_value_function_v1,
    backend_value_closure_v1, backend_value_object_v1}
use compiler.hir.hir_types.{SymbolId, HirType, HirTypeKind}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind, HirParam}
use compiler.common.diagnostics.span.{Span}

pub fn old_string() -> Value:
    backend_value_string_v1("old payload Ω")

pub fn old_function() -> Value:
    backend_value_function_v1(FunctionValue(symbol: SymbolId(id: 41), name: "callable_word"))

pub fn old_object() -> Value:
    backend_value_object_v1(ObjectValue(class_name: "Device", handle: 73))

pub fn old_closure() -> Value:
    val span = Span.empty()
    val type_ = HirType(kind: HirTypeKind.Bool, span: span)
    val body = HirExpr(kind: HirExprKind.BoolLit(true), has_type_: true, type_: type_, span: span)
    val parameter = HirParam(symbol: SymbolId(id: 43), name: "enabled", type_: type_,
        has_default: true, default: body, span: span, is_mutable: false)
    backend_value_closure_v1(ClosureValue(params: [parameter], body: body,
        captures: {"captured": backend_value_int_v1(-29)}))

pub fn old_enum() -> Value:
    val payload: EnumPayloadValue? = Some(EnumPayloadValue.Tuple([backend_value_int_v1(59)]))
    Value.Enum("Wire", "Word", payload)

pub fn old_accept(value: Value) -> bool:
    match value:
        case Value.String(message): message == "new payload Ω"
        case _: false
