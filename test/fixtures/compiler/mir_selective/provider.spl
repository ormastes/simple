# Cross-module declaration, enum payload, class and default-argument owners.
pub const BASE: i64 = 40
pub var COUNTER: i64 = 1

pub class Reading:
    value: i64 = 11

    fn score() -> i64:
        self.value + 1

pub enum Sample:
    Number(value: i64)
    Empty

pub fn with_default(value: i64, offset: i64 = 2) -> i64:
    value + offset

pub fn identity<Element>(value: Element) -> Element:
    value

pub fn sample_value(sample: Sample) -> i64:
    match sample:
        case Sample.Number(value): value
        case Sample.Empty: 0
