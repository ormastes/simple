use .provider.{Reading as ImportedReading, Sample as ImportedSample, BASE,
    with_default as imported_default, identity as imported_identity, sample_value}

pub fn cross_module_value() -> i64:
    val reading = ImportedReading()
    val sample = ImportedSample.Number(imported_identity<i64>(7))
    reading.score() + imported_default(BASE) + sample_value(sample)

pub fn specialized_text() -> text:
    imported_identity<text>("retained")
