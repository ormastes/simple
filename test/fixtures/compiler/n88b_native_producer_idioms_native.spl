# Native behavior fixture for rows 28-32 of n88_b (unit alias, optional Value
# payload, receiver writeback after a bool-returning method, optional array
# binder, optional narrowing). Written with the ORIGINAL idioms, no workaround
# shapes, so a rebuilt stage3 producer proves the underlying fixes.
class Counter:
    total: i64
    me bump(n: i64) -> bool:
        self.total = self.total + n
        true

class Holder:
    counter: Counter
    units: i64

fn unit_result(ok: bool) -> Result<unit, text>:
    if ok: return Ok(())
    Err("no")

fn opt_array(present: bool) -> [i64]?:
    if present: return Some([1, 2, 3])
    nil

fn sum_binder(a: [i64]?) -> i64:
    var s = 0
    if val arr = a:
        for x in arr:
            s = s + x
    s

fn len_after_guard(a: [i64]?) -> i64:
    if a == nil: return -1
    a!.len()

fn some_payload(present: bool) -> i64:
    val v: i64? = if present: Some(7) else: nil
    if val p = v: return p
    -1

fn main() -> i64:
    val r = unit_result(true)
    if r.is_ok(): print("UNIT_OK")
    else: print("UNIT_BROKEN")
    print("SOME_{some_payload(true)}_{some_payload(false)}")
    var h = Holder(counter: Counter(total: 0), units: 0)
    val updated = h.counter.bump(5)
    if updated: h.units = h.units + 1
    print("WRITEBACK_{h.counter.total}_{h.units}")
    print("BINDER_{sum_binder(opt_array(true))}_{sum_binder(opt_array(false))}")
    print("NARROW_{len_after_guard(opt_array(true))}_{len_after_guard(opt_array(false))}")
    0
