# Native diagnostic: explicit exit-backed guards survive disabled assertions.
use std.nogc_sync_mut.io_runtime.{exit}
use std.nogc_sync_mut.ptr.unique.{unique_new, unique_reset, unique_get, unique_try_get, unique_is_valid, unique_move, unique_drop, unique_release, unique_into_inner}

fn unique_lifecycle_require(condition: bool, message: text):
    if not condition:
        print "nogc-unique-lifecycle FAILED: {message}"
        exit(1)

fn main() -> i64:
    unique_reset()
    val original = unique_new(42, "original")
    val alias = original
    val successor = unique_move(original)
    unique_lifecycle_require(not unique_is_valid(original), "move source live")
    unique_lifecycle_require(not unique_is_valid(alias), "copied source live")
    unique_lifecycle_require(unique_get(successor) == 42, "move payload lost")
    unique_lifecycle_require(not unique_is_valid(unique_move(alias)), "stale move succeeded")
    unique_lifecycle_require(not unique_drop(alias), "stale source released")
    unique_lifecycle_require(unique_release(successor), "release failed")
    unique_lifecycle_require(not unique_drop(successor), "double release succeeded")
    val reused = unique_new(81, "reuse")
    unique_lifecycle_require(reused.id != successor.id, "slot reuse repeated ID")
    unique_lifecycle_require(not unique_is_valid(successor), "slot reuse revived stale owner")
    unique_reset()
    val fresh = unique_new(-1, "negative")
    unique_lifecycle_require(fresh.id != reused.id, "reset repeated ID")
    unique_lifecycle_require(not unique_is_valid(reused), "reset revived stale owner")
    unique_lifecycle_require(not unique_release(reused), "reset stale release succeeded")
    match unique_try_get(fresh):
        case Some(value):
            unique_lifecycle_require(value == -1, "negative payload changed")
        case nil:
            unique_lifecycle_require(false, "valid negative payload rejected")
    unique_lifecycle_require(unique_into_inner(fresh) == -1, "negative take changed")
    unique_lifecycle_require(not unique_is_valid(fresh), "take left owner valid")
    match unique_try_get(fresh):
        case Some(_):
            unique_lifecycle_require(false, "consumed owner read succeeded")
        case nil:
            pass
    unique_lifecycle_require(not unique_drop(fresh), "taken owner released twice")
    val taken = unique_new(93, "take")
    unique_lifecycle_require(unique_into_inner(taken) == 93, "take payload lost")
    unique_lifecycle_require(unique_into_inner(taken) == -1, "second take succeeded")
    print "nogc-unique-lifecycle: move, reuse, reset, negative payload and exactly-once release passed"
    0
