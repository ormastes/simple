use app.cli.query_rich_common.{query_json_escape}

fn main() -> i64:
    val ordinary = query_json_escape("alpha βeta 한글") == "alpha βeta 한글"
    val controls = query_json_escape("a\\b\"c\nd\re\tf") == "a\\\\b\\\"c\\nd\\re\\tf"
    val spans = query_json_escape("left\nβeta\tright") == "left\\nβeta\\tright"
    if not ordinary:
        return 11
    if not controls:
        return 12
    if not spans:
        return 13
    0
