# Native regression: an invalid interpolation region is preserved literally.
# Byte oracles are numeric so a second affected string cannot hide corruption.
use std.common.sdn.parser.parse
use std.common.text_bytes.text_to_bytes

fn main() -> i64:
    val source = "{spec: {maximumJournalEvents: 10000}}"
    val bytes = text_to_bytes(source)
    assert(bytes.len() == 37)
    assert(bytes[30] == 49u8)
    assert(bytes[31] == 48u8)
    assert(bytes[32] == 48u8)
    assert(bytes[33] == 48u8)
    assert(bytes[34] == 48u8)
    assert(bytes[35] == 125u8)
    assert(bytes[36] == 125u8)
    val value = parse(source).unwrap().as_dict().unwrap()["spec"].as_dict().unwrap()["maximumJournalEvents"].as_i64().unwrap()
    assert(value == 10000)
    val escaped = text_to_bytes("{{literal}}")
    assert(escaped.len() == 9)
    assert(escaped[0] == 123u8)
    assert(escaped[8] == 125u8)
    val amount = 10000
    assert("{amount}" == "10000")
    print "nested SDN literal bytes and integer preserved"
    0
