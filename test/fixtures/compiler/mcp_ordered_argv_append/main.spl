fn main() -> i64:
    var child_argv: [text] = ["KEY=value", "simple"]
    val argv: [text] = ["run", "caret.spl", "inspect", "input.sdn"]
    for argument in argv:
        child_argv.push(argument)
    assert(child_argv.len() == 6)
    assert(child_argv[0] == "KEY=value")
    assert(child_argv[1] == "simple")
    assert(child_argv[2] == "run")
    assert(child_argv[5] == "input.sdn")
    val empty: [text] = []
    for argument in empty:
        child_argv.push(argument)
    assert(child_argv.len() == 6)
    0
