extern fn rt_bytes_alloc(n: i64) -> [u8]

class Scratch:
    data: [u8]

    me fill(n: i64):
        var i: i64 = 0
        while i < n:
            self.data[i] = ((i * 7) & 0xFF) as u8
            i = i + 1

fn main() -> i64:
    val n: i64 = 200000
    var s = Scratch(data: rt_bytes_alloc(n))
    s.fill(n)
    var h: i64 = 0
    var i: i64 = 0
    while i < n:
        h = (h * 31 + s.data[i].to_i64()) % 1000000007
        i = i + 1
    print "len={s.data.len()} hash={h}"
    0
