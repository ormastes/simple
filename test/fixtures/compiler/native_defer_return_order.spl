fn mark(value: i64) -> i64:
    print value
    value

fn explicit_value() -> i64:
    defer mark(3)
    defer mark(2)
    return mark(1)

fn implicit_value() -> i64:
    defer mark(6)
    defer mark(5)
    mark(4)

fn unit_value():
    defer mark(8)
    mark(7)

fn conditional_value(take: bool) -> i64:
    defer mark(10)
    if take:
        return mark(9)
    return -1

fn text_value() -> text:
    defer mark(11)
    "kept"

fn array_value() -> [i64]:
    defer mark(12)
    [17, 23]

fn block_value() -> i64:
    defer:
        mark(14)
        mark(15)
    mark(13)

fn main() -> i64:
    if explicit_value() != 1: return 1
    if implicit_value() != 4: return 2
    unit_value()
    if conditional_value(true) != 9: return 3
    if text_value() != "kept": return 4
    val values = array_value()
    if values.len() != 2: return 5
    if values[0] != 17 or values[1] != 23: return 6
    if block_value() != 13: return 7
    0
