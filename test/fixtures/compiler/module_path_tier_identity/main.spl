use compiler.common.module_path_naming.{module_logical_name_from_path}

fn check(path: text, expected: text):
    val actual = module_logical_name_from_path(path)
    if actual != expected:
        panic("module path identity mismatch: {path}: expected={expected} actual={actual}")

fn main():
    check("src/compiler/15.blocks/blocks/registry.spl", "compiler.blocks.registry")
    check("src/compiler/70.backend/backend/native/isel_x86_64.spl", "compiler.backend.native.isel_x86_64")
    check("src/compiler/60.mir_opt/mir_opt/constant_folding.spl", "compiler.mir_opt.constant_folding")
    check("src/compiler/70.backend/backend_types.spl", "compiler.backend.backend_types")
    check("src/compiler/70.backend/backend/backend_types.spl", "compiler.backend.backend.backend_types")
    check("src/compiler/15.blocks/__init__.spl", "compiler.blocks.__init__")
    check("src/compiler/15.blocks/blocks/__init__.spl", "compiler.blocks.blocks.__init__")
    check("src/compiler/99.loader/loader/smf_cache.spl", "compiler.loader.loader.smf_cache")
    check("src/compiler/85.mdsoc/mdsoc/types.spl", "compiler.mdsoc.mdsoc.types")
    check("C:\\snapshot\\src\\compiler\\15.blocks\\blocks\\registry.spl", "compiler.blocks.registry")
    check("build/scv_snapshots/frozen/src/compiler/70.backend/backend/native/isel_x86_64.spl", "compiler.backend.native.isel_x86_64")
