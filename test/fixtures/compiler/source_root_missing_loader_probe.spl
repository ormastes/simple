# A relative import returns Missing from selected-root lookup, then resolves
# through the importing file's admitted sibling path.
use .source_root_named_callback_probe.named_target.{resolve_default}

fn main() -> i64:
    if resolve_default("normal", "checkout") != "checkout/normal.spl": return 1
    print "SOURCE_ROOT_MISSING_FALLBACK_PASS"
    0
