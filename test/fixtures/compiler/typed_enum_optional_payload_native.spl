# Actual production constructors and builders; no copied implementation.
extern fn rt_exit(code: i64)
use compiler.common.diagnostics.span.Span
use compiler.hir.hir_types.{DimExpr, DimExprKind}
use compiler.mir.mir_data.MirBuilder
use compiler.mir.mir_types.{LocalId, MirType, mir_signature_simple}
use compiler.mir.mir_instruction_kinds.MirInstKind
use compiler.mir.mir_instruction_support.{BlockId, MirOperand, MirTerminator}

fn payload_require_local(value: LocalId?, expected: i64):
    if val present = value:
        val actual: LocalId = present
        if expected == -1 or actual.id != expected: rt_exit(1)
    else:
        if expected != -1: rt_exit(2)

fn payload_require_bound(value: i64?, expected: i64):
    if val present = value:
        if present != expected: rt_exit(3)
    else:
        rt_exit(4)

fn payload_require_range(lo: i64, hi: i64):
    val expression = DimExpr.named_range("batch", lo, hi, Span.empty())
    val kind: DimExprKind = expression.kind
    match kind:
        case DimExprKind.Named(name, lower, upper):
            if name != "batch": rt_exit(5)
            payload_require_bound(lower, lo)
            payload_require_bound(upper, hi)
        case _: rt_exit(6)

fn payload_require_term(term: MirTerminator, expected: i64, unwind_id: i64, normal_id: i64):
    match term:
        case MirTerminator.CallTerminator(dest, _, args, normal, unwind, payload, type_tag):
            payload_require_local(dest, expected)
            if args.len() != 1 or normal.id != normal_id: rt_exit(7)
            if val present = unwind:
                val target: BlockId = present
                if target.id != unwind_id: rt_exit(8)
            else:
                rt_exit(9)
            payload_require_local(payload, 91)
            payload_require_local(type_tag, 92)
        case _: rt_exit(10)

fn payload_protected_call(mode: i64, unit_result: bool):
    var builder = MirBuilder.new()
    val start = builder.new_block(nil)
    val unwind = builder.new_block(nil)
    builder.switch_to_block(start)
    val optional_unwind: BlockId? = unwind
    val payload: LocalId? = LocalId(id: 91)
    val type_tag: LocalId? = LocalId(id: 92)
    builder.set_unwind_target(optional_unwind, payload, type_tag)
    val func = MirOperand.const_int(17)
    val args = [MirOperand.const_int(23)]
    var result_type = MirType.i64()
    var expected = 0
    if unit_result:
        result_type = MirType.unit()
        expected = -1
    if mode == 0:
        payload_require_local(builder.emit_call(func, args, result_type), expected)
    elif mode == 1:
        val result = builder.emit_call_value(func, args, result_type)
        if result.id != 0: rt_exit(11)
    else:
        val signature = mir_signature_simple(result_type)
        payload_require_local(builder.emit_call_indirect(func, args, signature, result_type), expected)
    val term: MirTerminator = builder.blocks[0].terminator
    if builder.current_block.id != 3: rt_exit(21)
    payload_require_term(term, expected, unwind.id, 3)

fn main() -> i64:
    payload_require_range(-3, 0)
    payload_require_range(0, 3)
    var builder = MirBuilder.new()
    val result = builder.emit_call_value(MirOperand.const_int(17), [], MirType.i64())
    val call: MirInstKind = builder.instructions[0].kind
    match call:
        case MirInstKind.Call(dest, _, args):
            payload_require_local(dest, result.id)
            if args.len() != 0: rt_exit(12)
        case _: rt_exit(13)
    val allocation = builder.emit_typed_storage_alloc_owned_raw_v1(
        MirType.i64(), 32, 71, 2, 4, "identity", "probe", "source")
    if allocation.allocation_byte_len != 32 or allocation.logical_type_id != 71: rt_exit(17)
    if allocation.revision != 2 or allocation.element_count != 4: rt_exit(18)
    if allocation.allocation_identity != "identity" or allocation.allocation_provenance != "probe": rt_exit(19)
    if allocation.source_revision != "source": rt_exit(20)
    val intrinsic: MirInstKind = builder.instructions[1].kind
    match intrinsic:
        case MirInstKind.Intrinsic(dest, _, args):
            payload_require_local(dest, allocation.base_local.id)
            if args.len() != 5: rt_exit(14)
        case _: rt_exit(15)
    if result.id != 0 or allocation.base_local.id != 1: rt_exit(16)
    payload_protected_call(0, false)
    payload_protected_call(0, true)
    payload_protected_call(1, false)
    payload_protected_call(2, false)
    payload_protected_call(2, true)
    print "typed_enum_optional_payload_native=PASS ranges=2 protected_calls=5"
    0
