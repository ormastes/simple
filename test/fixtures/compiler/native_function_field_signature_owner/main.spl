use provider.{Argument as ProviderArgument, Payload as ProviderPayload, Port, make_port, make_argument, execute}

# Deliberately contest both leaf names and numeric consumer SymbolIds.
struct Argument:
    second: text

struct Payload:
    value: text

fn main():
    val decoy_argument = Argument(second: "consumer")
    val decoy_payload = Payload(value: "consumer")
    assert(decoy_argument.second == decoy_payload.value)
    val port = make_port()
    val argument = make_argument()
    match port.call_fn(argument):
        case Ok(values):
            assert(values.len() == 1)
            val payload = values[0]
            assert(payload.prefix == 10)
            assert(payload.value == 17)
        case Err(message):
            assert(false)
    # Direct and bound controls retain the same provider-owned record shape.
    match execute(argument):
        case Ok(values):
            assert(values.len() == 1)
            val payload = values[0]
            assert(payload.prefix == 10)
            assert(payload.value == 17)
        case Err(message):
            assert(false)
    val bound = port.call_fn(argument)
    match bound:
        case Ok(values):
            assert(values.len() == 1)
            val payload = values[0]
            assert(payload.prefix == 10)
            assert(payload.value == 17)
        case Err(message):
            assert(false)
    print("function-field-signature ownership assertions passed")
