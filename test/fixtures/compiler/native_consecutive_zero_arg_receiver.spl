use native_consecutive_zero_arg_receiver_provider.{ZeroArgReceiver}

# Keep the first getter's text result live when the second, differently typed
# zero-argument getter is lowered. This is the exact Engine2D failure shape:
# a missing receiver reload reuses the text result as the optional getter's
# `self` pointer. Checking the optional handle itself deliberately avoids
# `evidence.?.marker`: that expression has an independent native lowering bug
# tracked in native_exists_check_struct_payload_becomes_bool_2026-07-25.md.
fn main() -> i64:
    var receiver = ZeroArgReceiver(execution_target: "cpu", performance_evidence: nil)
    receiver.performance_evidence = Some(ZeroArgEvidence(marker: 73))
    val target = receiver.target()
    val evidence = receiver.evidence()
    if target != "cpu" or evidence == nil:
        return 1
    print("zero-arg-receiver-ok")
    0
