enum Choice:
    A(number: i64)
    B(number: i64)
    C

fn pick(choice: Choice) -> i64:
    match choice:
        case Choice.A(number) | Choice.B(number):
            number
        case Choice.C:
            0

fn main() -> i64:
    print pick(Choice.A(17))
    print pick(Choice.B(29))
    print pick(Choice.C)
    return 0
