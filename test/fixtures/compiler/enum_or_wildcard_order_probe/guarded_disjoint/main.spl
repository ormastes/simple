enum Choice:
    A
    B
    C

fn pick(choice: Choice, enabled: bool) -> i64:
    match choice:
        case Choice.A | Choice.B if enabled:
            1
        case Choice.C:
            3
        case _:
            2

fn main() -> i64:
    print pick(Choice.A, true)
    print pick(Choice.B, true)
    print pick(Choice.A, false)
    print pick(Choice.B, false)
    print pick(Choice.C, true)
    return 0
