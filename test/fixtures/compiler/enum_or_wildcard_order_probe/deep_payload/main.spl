enum Choice:
    A(number: i64)
    B

fn pick(choice: Choice) -> i64:
    match choice:
        case Choice.A(7):
            7
        case _:
            1
        case Choice.B:
            2
        case _:
            3

fn main() -> i64:
    print pick(Choice.A(7))
    print pick(Choice.A(8))
    print pick(Choice.B)
    return 0
