use .cases.*

fn main() -> i64:
    var failures = 0
    if case_binding() != 0: failures += 1
    if case_reassignment() != 0: failures += 1
    if case_getter_constructor() != 0: failures += 1
    if case_nested_arrays() != 0: failures += 1
    if case_struct_nested() != 0: failures += 1
    if case_struct_method() != 0: failures += 1
    if case_struct_value_method() != 0: failures += 1
    if case_class_reference() != 0: failures += 1
    if case_insertion() != 0: failures += 1
    if case_dictionary_insertion() != 0: failures += 1
    if case_self_push() != 0: failures += 1
    if case_nested_self_push() != 0: failures += 1
    if case_mutator_lengths() != 0: failures += 1
    if case_function_arguments() != 0: failures += 1
    if case_method_arguments() != 0: failures += 1
    if case_argument_order() != 0: failures += 1
    if case_mut_nested_writeback() != 0: failures += 1
    if case_temporary_receiver() != 0: failures += 1
    if case_iteration_values() != 0: failures += 1
    if failures != 0:
        print "core-array-cow: FAIL cases=19 failures={failures}"
        return 1
    print "core-array-cow: PASS cases=19"
    0
