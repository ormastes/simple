use compiler.core.ast_expr.{expr_ident, expr_int_lit, expr_call, expr_get_args,
    expr_store_state_take, expr_store_state_install}

fn main() -> i64:
    val leaf = expr_int_lit(11, 0)
    val replacement = expr_int_lit(22, 0)
    var input = [leaf]
    val call = expr_call(expr_ident("callee", 0), input, 0)
    input[0] = replacement
    if expr_get_args(call)[0] != leaf: return 1
    var getter = expr_get_args(call)
    getter[0] = replacement
    if expr_get_args(call)[0] != leaf: return 2
    var state = expr_store_state_take()
    # Refuse a configuration that did not expose the real arena column.
    if state.expr_args.len() <= call: return 7
    expr_store_state_install(state)
    state.expr_args[call][0] = replacement
    if expr_get_args(call)[0] != leaf: return 3
    var snapshot = state
    snapshot.expr_args[call][0] = leaf
    if state.expr_args[call][0] != replacement: return 4
    if expr_get_args(call)[0] != leaf: return 5
    print "core-array-cow-expr-store: PASS"
    0
