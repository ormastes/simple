struct CowData:
    items: [i64]
    fn isolated(value: i64) -> i64:
        self.items[0] = value
        self.items[0]
    me poke(value: i64):
        self.items[0] = value

class CowBox:
    value: i64

class CowStore:
    values: [i64]
    rows: [[i64]]
    calls: i64
    fn snapshot() -> [i64]: self.values
    me counted_rows() -> [[i64]]:
        self.calls += 1
        self.rows
    fn isolated(values: [i64]) -> i64:
        values[0] = 91
        values[0]
    me replace(mut values: [i64]):
        values = [73]

var cow_effects: i64 = 0
var cow_global: [i64] = [1]

fn cow_index() -> i64:
    cow_effects += 1
    0

fn cow_later_argument() -> i64:
    cow_global[0] = 9
    0

fn cow_first_argument(values: [i64], ignored: i64) -> i64: values[0]

fn cow_by_value(values: [i64]): values[0] = 99
fn cow_by_mut(mut values: [i64]): values[0] = 99
fn cow_replace(mut values: [i64]): values = [73]

