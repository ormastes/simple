# Must fail compilation with the declared-parameter-binding diagnostic.
# Named source order differs from declaration order; guessing boxes wrong slots.
class NamedAnyProbe:
    value: any

    fn matches(expected: any, count: i64) -> bool:
        self.value == expected and count == 1

fn main() -> i64:
    val probe = NamedAnyProbe(value: 41)
    if probe.matches(count: 1, expected: 41): return 0
    1
