# The two same-named provider functions have different concrete Result payloads.
use left.{fetch as left_fetch}
use right.{fetch as right_fetch}

val result = left_fetch()

fn check_local() -> i64:
    val result = right_fetch()
    assert(not result.is_err())
    assert(result.unwrap() == 27)
    if true:
        val result = "shadow"
        assert(result.len() == 6)
    assert(result.unwrap() == 27)
    result.unwrap()

fn main() -> i64:
    assert(not result.is_err())
    assert(result.unwrap() == "outer")
    assert(check_local() == 27)
    assert(result.unwrap() == "outer")
    print "PASS: global/local Result bindings, lexical shadowing, distinct provider owners"
    0
