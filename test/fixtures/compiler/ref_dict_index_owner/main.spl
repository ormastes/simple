# Native/object regression: borrowed Dict indexing must retain the handle ABI.
# Exact successful stdout: ref-dict-index-owner: pass\n
fn cache_value(key: text, values: mut Dict<text, i64>) -> i64:
    if values.contains_key(key): return values[key]
    values[key] = 37
    return values[key]

fn update_float(values: mut Dict<text, f64>, key: text) -> f64:
    values[key] = 1.25
    values[key] += 0.5
    return values[key]

fn update_text(values: mut Dict<text, text>, key: text) -> text:
    values[key] = "borrowed-value"
    return values[key]

fn update_bool(values: mut Dict<text, bool>, key: text) -> bool:
    values[key] = false
    if values[key]: return false
    values[key] = true
    return values[key]

fn main() -> i64:
    var counts: Dict<text, i64> = {}
    if cache_value("cached", counts) != 37: return 11
    counts["cached"] = 52
    if cache_value("cached", counts) != 52: return 12
    if counts["cached"] != 52: return 13
    var floats: Dict<text, f64> = {}
    if update_float(floats, "fraction") != 1.75: return 21
    if floats["fraction"] != 1.75: return 22
    var texts: Dict<text, text> = {}
    if update_text(texts, "word") != "borrowed-value": return 31
    if texts["word"] != "borrowed-value": return 32
    var flags: Dict<text, bool> = {}
    if not update_bool(flags, "flag"): return 41
    if not flags["flag"]: return 42
    val numbers = [8, 13]
    if numbers[1] != 13: return 51
    print "ref-dict-index-owner: pass"
    0
