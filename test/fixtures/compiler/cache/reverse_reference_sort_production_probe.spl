# Standalone diagnostic of actual production imports; NOT_RUN.
use compiler.common.cache.reverse_reference_key.{ReverseReferenceKeyV1, reverse_reference_key_encode_v1}
use compiler.driver.cache.reverse_reference_receipt.{ReverseReferenceProjectionV1,
    ReverseReferenceGenerationReceiptV1, reverse_reference_receipt_encode_v1,
    reverse_reference_receipt_digest_v1}
use std.common.crypto.sha256.{sha256_text}

fn main() -> i64:
    val key = ReverseReferenceKeyV1("semantic", "owner", "root", "subject", "direct-import-export", sha256_text("fact"), 1)
    val frame = reverse_reference_key_encode_v1(key)
    if frame == "": return 11
    var rows: [ReverseReferenceProjectionV1] = []
    for consumer in ["z", "a", "a"]:
        rows.push(ReverseReferenceProjectionV1(key, consumer))
    val receipt = ReverseReferenceGenerationReceiptV1(2, "owner", "root", rows)
    val line = "{frame.len()}:{frame}1:"
    val expected = "simple-reverse-reference-generation-receipt-v2\nschema=2\nowner=owner\nroot=root\ncount=3\n" + line + "a\n" + line + "a\n" + line + "z"
    val encoded = reverse_reference_receipt_encode_v1(receipt)
    if encoded != expected: return 12
    if reverse_reference_receipt_digest_v1(receipt) != "sha256:" + sha256_text(expected): return 13
    print "PASS:reverse-reference-production-bytes"
    0
