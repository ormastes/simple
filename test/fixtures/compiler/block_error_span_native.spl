use compiler.blocks.context.{BlockContext}
use compiler.blocks.error_helpers.{error_at, error_span}
use compiler.common.diagnostics.span.{Span}

fn main() -> i64:
    val payload = Span(start: 10, end: 30, line: 3, col: 5, file: "span.spl", length: 20)
    val ctx = BlockContext(source: "payload", block_kind: "test", span: payload, payload_span: payload)
    val first = error_at(ctx, "single", 2, 4)
    if not first.has_span or first.message != "single":
        return 1
    if first.span.start != 12 or first.span.end != 16:
        return 2
    if first.span.line != 3 or first.span.col != 7:
        return 3
    if first.span.file != "span.spl" or first.span.length != 4:
        return 4
    val range = error_span(ctx, "range", (3, 8))
    if not range.has_span or range.message != "range":
        return 5
    if range.span.start != 13 or range.span.end != 18:
        return 6
    if range.span.col != 8 or range.span.length != 5 or range.span.file != "span.spl":
        return 7
    val empty = error_span(ctx, "empty", (0, 0))
    if empty.span.start != 10 or empty.span.end != 10 or empty.span.length != 0:
        return 8
    print "block error span native PASS"
    0
