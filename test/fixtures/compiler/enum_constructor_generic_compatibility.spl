# Compatibility fixture: custom generic enum remains on its previous route.
# Native UNRUN; this file is not evidence that existing generic support passes.
enum PayloadBox<T>:
    Value(value: T)

fn integer_box() -> PayloadBox<i64>:
    PayloadBox.Value(41)

fn text_box() -> PayloadBox<text>:
    PayloadBox.Value("kept")

fn main() -> i64:
    val number = match integer_box():
        case PayloadBox.Value(value): value
    val label = match text_box():
        case PayloadBox.Value(value): value
    if number == 41 and label == "kept": 0 else: 1
