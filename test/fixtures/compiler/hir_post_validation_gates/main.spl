# Actual managed runtime and real frozen source closure are mandatory. This
# exercises policy capture/replay, not completed transform/final admission.
use compiler.driver.driver_compiler_type.{CompilerDriver}
use compiler.driver.driver_hir_archive_schedule_owner_v1.*
use compiler.driver.driver_hir_post_validation_policy_owner_v1.*
use compiler.driver.cache.driver_hir_post_validation_policy_v1.*
use compiler.driver.cache.driver_hir_weave_source_policy_v1.{driver_hir_weave_source_policy_v1}
use compiler.driver.cache.driver_hir_managed_runtime_selection_v1.*
use compiler.driver.cache.driver_hir_archive_journal_v1.*
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{hir_owned_artifact_load_blob_v1, hir_owned_artifact_store_blob_v1}
use compiler.driver.cache.hir_body_typecheck_lease_v1.*
use compiler.driver.driver_hir_cache.{hir_cache_promote_diagnostic_owner_v1, hir_cache_clear_last_warnings}
use compiler.mono.mono_archive_registration_v1.*
use compiler.common.driver_core_types.{SourceFile, driver_core_compile_options_default}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule}
use compiler.hir.hir_lowering.module_surface.{ModuleSurfaceBuilder, ModuleSurfacesByName}
use compiler.hir.hir_lowering.module_surface_registry.*
use compiler.common.config.{Logger}
use compiler.semantics.layer_eq_validation.*
use compiler.semantics.layer_eq_checker.{LayerEqType}
use compiler.semantics.effect_validation.*
use compiler.semantics.rt_criticality_validation.*
use compiler.semantics.rt_criticality.{RtCriticalDiagnosticSeverity, RtBoundCapability, RT_EFFECT_ALLOC,
    rt_closure_digest, rt_bound_manifest_replace, rt_bound_manifest_clear, rt_bound_manifest_capabilities}
use compiler.semantics.aspect_validation.*
use compiler.semantics.aspect_weave.{aspect_forward_weave_contract_claims_v1}
use compiler.semantics.join_point_model.{forward_join_points_for_module_v1}
use compiler.frontend.layer_eq_registry.{layer_eq_registry_reset, layer_eq_registry_claim_keys}
use compiler.frontend.effect_registry.{effect_registry_reset, effect_registry_claim_keys}
use compiler.frontend.rt_criticality_registry.{rt_criticality_reset, rt_criticality_claim_keys}
use compiler.frontend.aspect_registry.{aspect_registry_reset, aspect_registry_claim_keys}
use std.common.crypto.sha256.{sha256_text}
use std.env.{env_get}
use std.nogc_sync_mut.sffi.runtime.{transient_array_scope_state_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end, transient_promote}

extern fn rt_hash_text(content: text) -> i64

use compiler.driver.cache.driver_hir_archive_weave_facts_v1.*
use compiler.driver.cache.driver_hir_archive_weave_gate_v1.{driver_hir_archive_weave_gate_v1}
use compiler.driver.cache.driver_hir_post_validation_gate_facts_v1.*
use compiler.driver.driver_hir_pipeline_support.{driver_validate_value_struct_layout_declarations_v1}
use compiler.semantics.value_struct_layout.{value_struct_layout_declarations_v1}
use compiler.hir.hir_codec.{hir_module_encode}
use test.fixtures.compiler.hir_post_validation_gates.collection.*
fn actual_array_capability(module: HirModule) -> Result<RtBoundCapability, text>:
    val declarations = rt_module_function_declarations_v1(module.name, module)
    val names = rt_unambiguous_declaration_names_v1(declarations)
    var rows: [RtCriticalFunctionFactsV1] = []
    var root = ""
    for func in module.functions.values():
        val row = rt_function_facts_v1(module.name, module, func, names)
        rows.push(row)
        if row.declaration.name == "array_value":
            root = rt_stable_fn_id(row.declaration.module_key, row.declaration.symbol_id)
    if root == "": return Err("fixture actual allocation root absent")
    Ok(RtBoundCapability(subject_id: root, closure_digest: rt_closure_digest(root, rt_criticality_graph_facts_v1(rows)),
        effect: RT_EFFECT_ALLOC, max_units: 1, review_id: "FIXTURE-ACTUAL-POLICY-ALLOC-ONE"))

fn registration(journal: DriverHirArchiveJournalV1, archive: HirBodyArchiveV1) -> Result<MonoArchiveRegistrationReceiptV1, text>:
    if not transient_scope_begin(): return Err("fixture declaration lease refused")
    val loaded = hir_body_archive_load_in_owned_scope_v1(archive, archive.input)
    val result: Result<MonoArchiveRegistrationReceiptV1, text> = if loaded.is_err(): Err(loaded.unwrap_err()) else:
        mono_archive_collect_registration_in_owned_scope_v1(journal.registration, loaded.unwrap(), archive.input.module_name, archive)
    val paused = transient_scope_pause()
    val owned = if paused: transient_promote(result) else: false
    val memo = if paused: hir_cache_promote_diagnostic_owner_v1() else: false
    hir_cache_clear_last_warnings()
    val ended = transient_scope_end()
    if not paused or not owned or not memo or not ended: panic("fixture declaration ownership")
    result

fn main() -> i64:
    val selected_result = driver_hir_capture_managed_runtime_selection_v1("llvm",
        env_get("SIMPLE_NATIVE_BUILD_TARGET"), env_get("SIMPLE_NATIVE_RUNTIME_BUNDLE"))
    if selected_result.is_err(): return 1
    val selected = selected_result.unwrap()
    val path = "test/fixtures/compiler/hir_post_validation_gates/provider.spl"
    val name = "policy.provider"
    val loaded_source = SourceFile.load(path)
    if loaded_source.is_err(): return 2
    val source = SourceFile(..loaded_source.unwrap(), module_name: name)
    val alternate_source = SourceFile.load("./" + path)
    if alternate_source.is_err(): return 29
    val alias = SourceFile(..alternate_source.unwrap(), module_name: "policy.logical_alias")
    if alias.authored_path == source.authored_path or alias.content != source.content: return 30
    val parsed = parse_full_frontend(source.content, path, name, Logger(level: 0))
    val builder = ModuleSurfaceBuilder.new()
    if builder.add_parsed(parsed, source, 0).is_err() or
            builder.add_alias(alias).is_err(): return 3
    val surfaces = ModuleSurfacesByName.empty()
    if builder.finish_into(surfaces) != "": return 4
    val driver = CompilerDriver.create(driver_core_compile_options_default())
    driver.ctx.source_paths_owner = [source.path, alias.path]
    driver.ctx.source_authored_paths_owner = [source.authored_path, alias.authored_path]
    driver.ctx.source_module_names_owner = [name, "policy.logical_alias"]
    driver.ctx.source_identities_owner = [sha256_text(source.content), sha256_text(source.content)]
    driver.ctx.source_byte_lengths_owner = [source.content.len(), source.content.len()]
    val raw_hash = rt_hash_text(source.content)
    val retained_hash = if raw_hash == 0: 1 else: raw_hash
    driver.ctx.source_content_hashes_owner = [retained_hash, retained_hash]
    driver.streaming_module_surfaces_owner = surfaces
    driver.streaming_surface_owner_ready = true
    driver.streaming_entry_source_index_owner = -1
    val schedule_result = driver.capture_hir_archive_streaming_schedule_v1()
    if schedule_result.is_err(): return 5
    val schedule = schedule_result.unwrap()
    var lowering = HirLowering.with_filename(path)
    val module = lowering.lower_parser_module_unstub(parsed, false)
    if lowering.errors.len() != 0: return 125
    val actual_capability = actual_array_capability(module)
    if actual_capability.is_err(): return 35
    val capability = actual_capability.unwrap()
    rt_bound_manifest_replace([capability])
    val input = HirBodyArchiveInputV1(source_path: path, module_name: name, is_entry: false,
        closure_digest: schedule.closure_digest, runtime_provider_receipt_path: selected.provider.snapshot.path,
        runtime_provider_digest: selected.provider.snapshot.digest, producer_header: selected.producer_header,
        stage: "lowered-unresolved-v1", provider_selection_digest: selected.selection_digest,
        source_content_digest: sha256_text(source.content), source_authored_path: source.authored_path)
    val stored = hir_body_archive_store_v1(input, module, ["policy lowering warning"])
    if stored.is_err(): return 6
    val archive = stored.unwrap()
    val journal_result = driver_hir_archive_journal_create_v1(driver.ctx, selected)
    if journal_result.is_err(): return 7
    val journal = journal_result.unwrap()
    driver.hir_archive_publication_journal = Some(journal)
    if not driver.capture_hir_archive_post_validation_policy_v1().is_err(): return 8
    var checks = 1
    val receipt = registration(journal, archive)
    if receipt.is_err() or driver_hir_archive_journal_publish_v1(journal, driver.ctx, 0, name, receipt.unwrap()).is_err(): return 9
    if driver_hir_archive_journal_alias_v1(journal, driver.ctx, 1, "policy.logical_alias", name).is_err(): return 10
    val captured = driver.capture_hir_archive_post_validation_policy_v1()
    if captured.is_err(): return 11
    val owner = captured.unwrap()
    val order = [name]
    val facts = DriverHirArchiveWeaveFactsV1()
    # Complete declaration barrier precedes all complete-body reads.
    for key in order:
        val declaration = driver_hir_weave_declaration_v1(key, archive, owner)
        if declaration.is_err() or driver_hir_weave_append_declaration_v1(facts, key, declaration.unwrap()).is_err(): return 101
    for key in order:
        val body = driver_hir_weave_body_v1(key, archive, owner, facts)
        if body.is_err() or body.unwrap().lowering_warnings != ["policy lowering warning"] or
                driver_hir_weave_append_body_v1(facts, key, body.unwrap()).is_err(): return 102
    val captured_gate = driver_hir_archive_weave_gate_v1(owner, facts, order, [name], [name], false)
    if captured_gate.is_err(): return 103
    val expected = captured_gate.unwrap()
    if expected.errors.len() != 1 or not expected.errors[0].contains("24 bytes (24 from callees)") or
            expected.aspect_errors.len() != 0 or expected.weave_claims.len() != 1 or expected.gates_skipped: return 104
    checks = checks + 1
    # Retained control uses genuine complete parsed/lowered modules, not DTOs.
    val modules = {name: module}
    val before = hir_module_encode(modules[name])
    val retained = driver_validate_value_struct_layout_declarations_v1([name],
        [value_struct_layout_declarations_v1(module.name, module.path, module.structs, module.symbols)], modules)
    if retained != expected.errors or rt_bound_manifest_capabilities().len() != 0: return 105
    checks = checks + 1
    if hir_module_encode(modules[name]) == before: return 106
    checks = checks + 1
    # Real captured-policy replay survives ambient parser registry reset and
    # does not consume the next compilation's actual capability manifest.
    layer_eq_registry_reset()
    effect_registry_reset()
    rt_criticality_reset()
    aspect_registry_reset()
    val next = RtBoundCapability(..capability, max_units: 0, review_id: "FIXTURE-NEXT-GATE-COMPILATION")
    rt_bound_manifest_replace([next])
    val replay = driver_hir_archive_weave_gate_v1(owner, facts, order, [name], [name], false)
    if replay.is_err() or replay.unwrap().errors != expected.errors or replay.unwrap().weave_claims.len() != 1 or replay.unwrap().warnings != expected.warnings or
            replay.unwrap().aspect_errors != expected.aspect_errors or replay.unwrap().census_messages != expected.census_messages or
            replay.unwrap().skipped_struct_edges != expected.skipped_struct_edges or
            replay.unwrap().layout_cycles_downgraded != expected.layout_cycles_downgraded or
            replay.unwrap().gates_skipped != expected.gates_skipped or
            rt_bound_manifest_capabilities().len() != 1 or rt_bound_manifest_capabilities()[0].review_id != next.review_id or
            rt_bound_manifest_capabilities()[0].max_units != 0: return 107
    checks = checks + 1
    rt_bound_manifest_clear()
    # Mechanical fault inputs: actual collected provider keys/count, not an
    # assertion that an actual Dict corruption or final admission occurred.
    val alias_order = [name, "policy.logical_alias"]
    val alias_facts = DriverHirArchiveWeaveFactsV1()
    for key in alias_order:
        val declaration = driver_hir_weave_declaration_v1(key, archive, owner)
        if declaration.is_err() or driver_hir_weave_append_declaration_v1(alias_facts, key, declaration.unwrap()).is_err(): return 122
    for key in alias_order:
        val body = driver_hir_weave_body_v1(key, archive, owner, alias_facts)
        if body.is_err() or driver_hir_weave_append_body_v1(alias_facts, key, body.unwrap()).is_err(): return 123
    if driver_hir_archive_weave_gate_v1(owner, alias_facts, alias_order, [name], [name], false).is_err(): return 124
    checks = checks + 1
    val partial = gate_fault_report(owner, alias_facts, alias_order, [name])
    if partial.is_err() or not partial.unwrap().gates_skipped or partial.unwrap().errors.len() == 0 or partial.unwrap().weave_claims.len() != 0: return 108
    checks = checks + 1
    val rejected = gate_fault_report(owner, alias_facts, alias_order, alias_order)
    if rejected.is_err() or rejected.unwrap().gates_skipped or rejected.unwrap().census_messages.len() == 0 or
            rejected.unwrap().errors.len() == 0 or rejected.unwrap().weave_claims.len() == 0: return 109
    checks = checks + 1
    # Actual aggregate partial-census branch must not require body rows or
    # consume the next manifest even with original-consumption requested.
    val saved_declaration = alias_facts.declarations[name]
    val saved_alias = alias_facts.declarations["policy.logical_alias"]
    val saved_bodies = alias_facts.bodies
    alias_facts.declarations[name] = DriverHirArchiveWeaveDeclarationV1(..saved_declaration, dropped: true)
    alias_facts.bodies = {}
    rt_bound_manifest_replace([next])
    val declarations_only = driver_hir_archive_weave_gate_v1(owner, alias_facts, alias_order, [name], [name], false, true)
    if declarations_only.is_err() or not declarations_only.unwrap().gates_skipped or
            declarations_only.unwrap().errors.len() == 0 or declarations_only.unwrap().weave_claims.len() != 0 or
            rt_bound_manifest_capabilities().len() != 1 or rt_bound_manifest_capabilities()[0].review_id != next.review_id or
            rt_bound_manifest_capabilities()[0].max_units != 0: return 126
    checks = checks + 1
    # All-rejected means the reliability test failed: ordinary real body
    # coverage must still be required. Missing rows cannot become gate skip.
    alias_facts.declarations["policy.logical_alias"] = DriverHirArchiveWeaveDeclarationV1(..saved_alias, dropped: true)
    val missing_all = driver_hir_archive_weave_gate_v1(owner, alias_facts, alias_order, [name], [name], false, true)
    if not missing_all.is_err() or rt_bound_manifest_capabilities().len() != 1 or
            rt_bound_manifest_capabilities()[0].review_id != next.review_id: return 127
    checks = checks + 1
    alias_facts.bodies = saved_bodies
    rt_bound_manifest_replace([capability])
    val all_complete = driver_hir_archive_weave_gate_v1(owner, alias_facts, alias_order, [name], [name], false, true)
    if all_complete.is_err() or all_complete.unwrap().gates_skipped or all_complete.unwrap().errors.len() == 0 or
            all_complete.unwrap().census_messages.len() == 0 or all_complete.unwrap().weave_claims.len() == 0 or
            rt_bound_manifest_capabilities().len() != 0: return 128
    checks = checks + 1
    alias_facts.declarations[name] = saved_declaration
    alias_facts.declarations["policy.logical_alias"] = saved_alias
    if not driver_hir_archive_weave_gate_v1(owner, facts, [], [name], [name], false).is_err() or
            not driver_hir_archive_weave_gate_v1(owner, facts, order, [], [], false).is_err() or
            not driver_hir_archive_weave_gate_v1(owner, alias_facts, alias_order, alias_order, alias_order, false).is_err(): return 110
    checks = checks + 1
    val empty = DriverHirArchiveWeaveFactsV1()
    if not driver_hir_weave_body_v1(name, archive, owner, empty).is_err(): return 111
    checks = checks + 1
    val predecessor = facts.next_join_point
    facts.next_join_point = predecessor + 1
    val wrong_predecessor = driver_hir_archive_weave_gate_v1(owner, facts, order, [name], [name], false).is_err()
    facts.next_join_point = predecessor
    if not wrong_predecessor: return 112
    checks = checks + 1
    if not transient_scope_begin(): return 113
    val active_refused = driver_hir_archive_weave_gate_v1(owner, facts, order, [name], [name], false).is_err()
    if not active_refused or transient_array_scope_state_v1() != 1 or not transient_scope_pause(): return 114
    val paused_refused = driver_hir_weave_declaration_v1(name, archive, owner).is_err()
    if not paused_refused or transient_array_scope_state_v1() != 2 or not transient_scope_end(): return 115
    checks = checks + 1
    # Independent genuine providers test actual cycle and robust RT severity.
    val cycle = gate_parse_module("test/fixtures/compiler/hir_post_validation_gates/cycle.spl", "gate.cycle")
    if cycle.is_err(): return 116
    val cycle_policy = DriverHirPostValidationPolicyLoadV1(..gate_live_policy(), layout_cycle_mode: "warning")
    val cycles = gate_complete_report(cycle.unwrap(), cycle_policy)
    val fatal_cycles = gate_complete_report(cycle.unwrap(), DriverHirPostValidationPolicyLoadV1(..cycle_policy, layout_cycle_mode: ""))
    if cycles.errors.len() != 0 or cycles.layout_cycles_downgraded == 0 or cycles.warnings.len() == 0 or
            fatal_cycles.errors.len() != cycles.layout_cycles_downgraded or fatal_cycles.layout_cycles_downgraded != 0: return 117
    checks = checks + 1
    val warning = gate_parse_module("test/fixtures/compiler/hir_post_validation_gates/warning.spl", "gate.warning")
    if warning.is_err(): return 118
    val warning_policy = DriverHirPostValidationPolicyLoadV1(..gate_live_policy(), implicit_rt_error: false)
    val warnings = gate_complete_report(warning.unwrap(), warning_policy)
    val errors = gate_complete_report(warning.unwrap(), DriverHirPostValidationPolicyLoadV1(..warning_policy, implicit_rt_error: true))
    if warnings.warnings.len() != 1 or not warnings.warnings[0].contains("RT-W-STEADY-ALLOCATION-001") or
            warnings.errors.len() != 0 or errors.errors.len() != 1 or errors.warnings.len() != 0 or
            not errors.errors[0].contains("RT-E-STEADY-ALLOCATION-001"): return 119
    checks = checks + 1
    rt_bound_manifest_clear()
    layer_eq_registry_reset()
    effect_registry_reset()
    rt_criticality_reset()
    aspect_registry_reset()
    if transient_array_scope_state_v1() != 0: return 120
    checks = checks + 1
    if checks != 18: return 121
    print "HIR post-validation gates: {checks} checks passed"
    0
