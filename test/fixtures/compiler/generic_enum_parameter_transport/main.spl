# Explicit arguments isolate declaration transport from omitted-argument policy.
enum Message<T = text>:
    Empty
    Full(value: T)

fn integer_value(message: Message<i64>) -> i64:
    match message:
        case Message.Empty: 0
        case Message.Full(value): value

fn main() -> i64:
    val populated: Message<i64> = Message.Full(value: 37)
    val empty: Message<i64> = Message.Empty
    if integer_value(populated) != 37: return 1
    if integer_value(empty) != 0: return 2
    print "generic-enum-parameter-transport: PASS"
    0
