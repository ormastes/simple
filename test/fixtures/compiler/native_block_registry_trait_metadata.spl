use compiler.blocks.mod.{block_info}
use compiler.blocks.registry.{register_block, unregister_block, get_block}
use compiler.blocks.definition.{BlockDefinition}
use compiler.blocks.context.{BlockContext, BlockError}
use compiler.blocks.value.{BlockValue}
use compiler.frontend.block_types.{LexerMode, SyntaxFeatures, syntaxfeatures_math}
use compiler.common.diagnostics.span.{Span}

struct MetadataBlock:
    padding: i64
    keyword: text
    details: text

impl BlockDefinition for MetadataBlock:
    fn kind() -> text:
        self.keyword

    fn parse_payload(payload: text, ctx: BlockContext) -> Result<BlockValue, BlockError>:
        Ok(BlockValue.Raw(self.details + ":" + payload))

    fn lexer_mode() -> LexerMode:
        LexerMode.Math

    fn syntax_features() -> SyntaxFeatures:
        syntaxfeatures_math()

    fn description() -> text:
        self.details

struct DefaultMetadataBlock:
    keyword: text

impl BlockDefinition for DefaultMetadataBlock:
    fn kind() -> text:
        self.keyword

    fn parse_payload(payload: text, ctx: BlockContext) -> Result<BlockValue, BlockError>:
        Ok(BlockValue.Raw(payload))

fn check_metadata(keyword: text, mode: text, description: text, power: bool):
    val info = match block_info(keyword):
        case Some(found): found
        case nil: panic("missing block metadata: {keyword}")
    assert info.kind == keyword
    assert info.lexer_mode == mode
    assert info.description == description
    assert info.features.power_caret == power

fn main() -> i64:
    check_metadata("m", "math", "Math block with power (^), transpose ('), and implicit multiplication", true)
    check_metadata("loss", "math", "Loss computation with auto-backward", true)
    check_metadata("nograd", "math", "Computation with gradient tracking disabled", true)
    check_metadata("sh", "raw", "Shell command execution", false)
    check_metadata("sql", "raw", "SQL query with parameter support", false)
    check_metadata("re", "raw", "Compiled regular expression", false)
    check_metadata("json", "raw", "JSON literal", false)
    check_metadata("md", "raw", "Markdown text", false)
    assert register_block(MetadataBlock(padding: 901, keyword: "metadata_probe", details: "custom metadata"))
    check_metadata("metadata_probe", "math", "custom metadata", true)
    val custom = match get_block("metadata_probe"):
        case Some(found): found
        case nil: panic("custom registration vanished")
    val context = BlockContext(source: "payload", block_kind: "metadata_probe", span: Span.empty(), payload_span: Span.empty())
    val value = match custom.parse_payload("payload", context):
        case Ok(found): found
        case Err(_): panic("custom parsing contract changed")
    val parsed = match value:
        case BlockValue.Raw(payload): payload
        case _: panic("custom parser returned a different value")
    assert parsed == "custom metadata:payload"
    assert not register_block(MetadataBlock(padding: 1, keyword: "metadata_probe", details: "wrong"))
    assert unregister_block("metadata_probe")
    assert block_info("metadata_probe") == nil
    assert register_block(DefaultMetadataBlock(keyword: "default_metadata_probe"))
    check_metadata("default_metadata_probe", "normal", "", false)
    assert unregister_block("default_metadata_probe")
    print("native_block_registry_trait_metadata: 47 checks passed")
    0
