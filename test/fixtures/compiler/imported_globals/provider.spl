pub var COUNTER: i64 = 1
pub var INITIALIZATIONS: i64 = 0
pub val BASE: i64 = 40
pub val DERIVED: i64 = BASE + 2

fn initialize_labels() -> [text]:
    INITIALIZATIONS = INITIALIZATIONS + 1
    ["param", "ret"]

pub val LABELS: [text] = initialize_labels()
pub val VALUE: i64 = 7
pub(package) val SCOPED_VALUE: i64 = 13
pub val LITERALS: [i64] = [3, 5]
