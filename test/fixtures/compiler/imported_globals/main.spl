use provider.{LABELS, LITERALS, DERIVED, SCOPED_VALUE, VALUE as LeftValue}
use other.{VALUE as RightValue}
use dependent.{CROSS_MODULE}
use writer.{increment}
use reader.{read_counter, read_initializations}
use call_consumer.{FROM_CALL}

fn main() -> i64:
    var count = 0
    for label in LABELS:
        if count == 0 and label != "param": return 1
        if count == 1 and label != "ret": return 2
        count = count + 1
    if count != 2: return 3
    if read_counter() != 1: return 4
    increment()
    if read_counter() != 2: return 5
    if DERIVED != 42: return 6
    if CROSS_MODULE != 43: return 7
    if LeftValue != 7 or RightValue != 9: return 8
    if read_initializations() != 1: return 9
    var sum = 0
    for value in LITERALS:
        sum = sum + value
    if sum != 8: return 10
    if FROM_CALL != 42: return 11
    if SCOPED_VALUE != 13: return 12
    0
