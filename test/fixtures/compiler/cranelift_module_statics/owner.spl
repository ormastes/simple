# Shared storage owner: immutable text, scalar, aggregate and array slots.
use std.nogc_sync_mut.atomic.{AtomicI64, MemoryOrdering, atomic_i64_new}
pub val LABEL = "present"
pub var counter: i64 = 3

class Registry:
    value: i64

fn new_registry() -> Registry:
    Registry(value: 17)

var registry = new_registry()
var entries: [i64] = []
# The instrumented allocation guard runs before main configures MC/DC.
var startup_atomic: AtomicI64 = atomic_i64_new(23)

pub fn startup_atomic_value() -> i64:
    startup_atomic.load(MemoryOrdering.SeqCst)

pub fn owner_label() -> text:
    LABEL

pub fn registry_value() -> i64:
    registry.value

pub fn update_owner(value: i64):
    registry = Registry(value: value)
    entries = entries.push(value)
    counter = counter + 4

pub fn entries_value() -> i64:
    if entries.len() != 1: return -1
    entries[0]
