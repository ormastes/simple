# Native regression: build this entry with Cranelift and execute the binary.
# The importer must reference owner storage rather than define a duplicate.
use owner.{LABEL, counter, owner_label, registry_value, update_owner, entries_value, startup_atomic_value}

use std.nogc_sync_mut.mcdc.static_probe.{mcdc_static_probe_owner_recorded_count}
use std.nogc_sync_mut.mcdc.probe_registry.{mcdc_probe_current_owner_id}

fn main() -> i64:
    if startup_atomic_value() != 23: return 9
    if LABEL != "present": return 1
    if owner_label() != LABEL: return 2
    if counter != 3: return 3
    if registry_value() != 17: return 4
    update_owner(41)
    if counter != 7: return 5
    if registry_value() != 41: return 6
    if entries_value() != 41: return 7
    if LABEL != "present" or owner_label() != "present": return 8
    if mcdc_static_probe_owner_recorded_count(mcdc_probe_current_owner_id()) <= 0: return 10
    print "cranelift_module_statics=PASS text=present counter=7 registry=41 array=41 startup=23 mcdc=recording"
    0
