type Values<T = i64> = [T]
type Rows<T> = Dict<text, Values<T>>

fn first(values: Values<i64>) -> i64:
    values[0]

fn main() -> i64:
    val numbers: Values = [19, 23]
    if first(numbers) != 19: return 1
    val flags: Values<bool> = [false, true]
    if flags[0]: return 2
    if not flags[1]: return 3
    val rows: Rows<i64> = {"row": numbers}
    if rows["row"][1] != 23: return 4
    print "generic-type-alias-parser: PASS"
    0
