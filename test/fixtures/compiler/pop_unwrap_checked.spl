# Executable oracle for `.unwrap()` / `??` on optional array accessors.
# Regression: doc/08_tracking/bug/stage2_unwrap_on_array_pop_yields_nil_2026-09-13.md
# `main` returns 0 on success; any other value names the failing case.

fn main() -> i64:
    var xs = [7, 8, 9]
    val a = xs.pop().unwrap()
    if a != 9 or xs.len() != 2: return 11
    # `??` must evaluate its pop() operand exactly once: one element leaves.
    val b = xs.pop() ?? -1
    if b != 8 or xs.len() != 1: return 12
    val c = xs.pop() ?? -1
    if c != 7 or xs.len() != 0: return 13
    val d = xs.pop() ?? -1
    if d != -1 or xs.len() != 0: return 14

    var pairs = [(7, true), (8, false)]
    val (n, f) = pairs.pop().unwrap()
    if n != 8 or f: return 15
    if pairs.len() != 1: return 16
    val (n2, f2) = pairs.pop() ?? (-1, false)
    if n2 != 7 or not f2: return 17
    if pairs.len() != 0: return 18

    var ys = [3, 4]
    val first = ys.first().unwrap()
    if first != 3: return 19
    val last = ys.last().unwrap()
    if last != 4: return 20
    val removed = ys.remove(0).unwrap()
    if removed != 3 or ys.len() != 1: return 21
    0
