class Surf:
    buf: [u32]
    rows: [[u32]]

    me fill(offset: i32, count: i32, color: u32) -> i64:
        val row: [u32] = [color; count]
        self.buf.write_span(row, offset as i64, 0, count as i64)

    me self_overlap(dst: i64, src: i64, count: i64) -> i64:
        self.buf.write_span(self.buf, dst, src, count)

    me nested(r: i64, color: u32) -> i64:
        val row: [u32] = [color; 3]
        self.rows[r].write_span(row, 1, 0, 3)

fn main() -> i64:
    var s = Surf(buf: [0u32; 10], rows: [[0u32; 5], [0u32; 5]])
    val alias = s.buf
    print "w1={s.fill(2, 4, 7u32)} buf={s.buf} alias={alias}"
    print "w2={s.self_overlap(0, 2, 5)} buf={s.buf}"
    print "w3={s.nested(1, 9u32)} rows={s.rows}"
    print "w0={s.fill(0, 0, 5u32)} buf={s.buf}"
    var t = Surf(buf: [1u32, 2u32, 3u32], rows: [])
    print "before-err buf={t.buf}"
    t.fill(2, 5, 4u32)
    print "unreachable"
    0
