# Real HIR assertions; run with a compiler containing the candidate methods.
extern fn rt_exit(code: i64)
use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{ParserModule}
use compiler.hir.hir_lowering.types.{HirLowering, hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolKind, Visibility}
use compiler.common.diagnostics.span.{Span}

fn imported_owner_scope_lower(extra_owner: text, method: text, extra_consumer: text) -> HirLowering:
    val logger = Logger(level: 0)
    val owner_source = extra_owner + "\nclass GenericRing<Op, Cpl>:\n    operations: [Op]\n    completions: [Cpl]\n\nimpl GenericRing<Op, Cpl>:\n" + method
    val consumer_source = "use generic.owner.\{GenericRing\}\nstruct Holder:\n    ring: GenericRing<i64, text>\n" + extra_consumer + "\nfn main() -> i64:\n    0\n"
    var modules: Dict<text, ParserModule> = {}
    modules["generic.owner"] = parse_full_frontend(owner_source, "generic.owner", "generic.owner", logger)
    val consumer = parse_full_frontend(consumer_source, "generic.consumer", "generic.consumer", logger)
    val sources = [SourceFile(path: "generic/owner.spl", content: owner_source, module_name: "generic.owner")]
    val surfaces = module_surfaces_from_modules(modules, sources)
    if not surfaces.is_ok(): rt_exit(90)
    var lowering = hirlowering_for_module("generic.consumer", surfaces.unwrap())
    val hir = lowering.lower_module(consumer)
    if hir.functions.len() == 0: rt_exit(91)
    lowering

fn imported_owner_scalar_signature(lowering: HirLowering, method: text, expected: text) -> bool:
    val id = lowering.symbols.lookup_or_invalid("generic.owner.GenericRing::" + method)
    if not id.is_valid(): return false
    val symbol = lowering.symbols.get_symbol(id)
    if not symbol.?: return false
    val type_ = symbol.unwrap().type_
    if not type_.?: return false
    match type_.unwrap().kind:
        case HirTypeKind.Function(params, result, _):
            if params.len() < 1: return false
            val parameter_matches = match params[params.len() - 1].kind:
                case HirTypeKind.TypeParam(name, _): name == expected
                case _: false
            val result_matches = match result.kind:
                case HirTypeKind.TypeParam(name, _): name == expected
                case _: false
            parameter_matches and result_matches
        case _: false

fn main() -> i64:
    val ordinary = imported_owner_scope_lower("", "    fn pass_operation(value: Op) -> Op:\n        value\n    fn pass_completion(value: Cpl) -> Cpl:\n        value\n", "")
    if ordinary.errors.len() != 0: return 1
    if not imported_owner_scalar_signature(ordinary, "pass_operation", "Op"): return 2
    if not imported_owner_scalar_signature(ordinary, "pass_completion", "Cpl"): return 3
    if ordinary.prescan_type_parameters.len() != 0: return 4
    if ordinary.symbols.lookup_or_invalid("Op").is_valid(): return 5
    if ordinary.symbols.lookup_or_invalid("Cpl").is_valid(): return 6
    val shadow = imported_owner_scope_lower("struct Op:\n    other: text\nstruct Cpl:\n    other: i64\n", "    fn pass_operation(value: Op) -> Op:\n        value\n", "")
    if shadow.errors.len() != 0: return 7
    if not imported_owner_scalar_signature(shadow, "pass_operation", "Op"): return 8
    val sibling = imported_owner_scope_lower("", "    fn pass_operation(value: Op) -> Op:\n        value\n", "struct Sibling:\n    invalid: Op\n")
    if sibling.errors.len() == 0: return 9
    if sibling.symbols.lookup_or_invalid("Op").is_valid(): return 10
    if not imported_owner_scalar_signature(sibling, "pass_operation", "Op"): return 11
    val missing = imported_owner_scope_lower("", "    fn broken(value: MissingType) -> i64:\n        0\n", "")
    if missing.errors.len() == 0: return 12
    if missing.symbols.lookup_qualified_type_raw("generic.owner", "MissingType") >= 0: return 13
    val concrete = imported_owner_scope_lower("struct Token:\n    number: i64\n", "    fn concrete(value: Token) -> Token:\n        value\n", "")
    if concrete.errors.len() != 0: return 14
    if concrete.symbols.lookup_qualified_type_raw("generic.owner", "Token") < 0: return 15
    if not concrete.symbols.lookup_or_invalid("generic.owner.GenericRing::concrete").is_valid(): return 16
    val owner_types = "struct Marker:\n    owner: i64\nstruct Token:\n    owner: text\n"
    val shadows = "struct Marker:\n    decoy: text\nstruct Token:\n    decoy: i64\n"
    val echo = "    fn echo(value: Op) -> Op:\n        value\n    fn echo_completion(value: Cpl) -> Cpl:\n        value\n"
    val constrained = imported_owner_constraint_lower("Op: Marker = Token, Cpl = Op", owner_types, shadows, echo)
    if constrained.errors.len() != 0: return 17
    if not owner_bound_is_named(constrained, "Marker"): return 18
    if constrained.symbols.lookup_qualified_type_raw("generic.owner", "Token") < 0: return 19
    val composite = imported_owner_constraint_lower("Op: Marker = [Token], Cpl = Op", owner_types, shadows, echo)
    if composite.errors.len() != 0: return 20
    if not owner_bound_is_named(composite, "Marker"): return 21
    if composite.symbols.lookup_qualified_type_raw("generic.owner", "Token") < 0: return 22
    val missing_bound = imported_owner_constraint_lower("Op: Missing, Cpl", "", "struct Missing:\n    decoy: i64\n", echo)
    if missing_bound.errors.len() == 0: return 23
    if missing_bound.symbols.lookup_qualified_type_raw("generic.owner", "Missing") >= 0: return 24
    val missing_default = imported_owner_constraint_lower("Op = Missing, Cpl = Op", "", "struct Missing:\n    decoy: i64\n", echo)
    if missing_default.errors.len() == 0: return 25
    if missing_default.symbols.lookup_qualified_type_raw("generic.owner", "Missing") >= 0: return 26
    val cross = imported_owner_constraint_lower("Op: Cpl = Cpl, Cpl: Op = Op", "", "", echo)
    if cross.errors.len() != 0: return 27
    if not owner_bound_is_parameter(cross, "echo", "Op", "Cpl"): return 28
    if not owner_bound_is_parameter(cross, "echo_completion", "Cpl", "Op"): return 29
    val self_bound = imported_owner_constraint_lower("Op: Op = Op, Cpl: Cpl = Cpl", "", "", echo)
    if self_bound.errors.len() != 0: return 30
    if not owner_bound_is_parameter(self_bound, "echo", "Op", "Op"): return 31
    if not owner_bound_is_parameter(self_bound, "echo_completion", "Cpl", "Cpl"): return 32
    val no_decoys = imported_owner_constraint_lower("Op: Marker = Token, Cpl = Op", owner_types, "", echo)
    if no_decoys.errors.len() != 0: return 33
    if not owner_bound_is_named(no_decoys, "Marker"): return 34
    if no_decoys.symbols.lookup_qualified_type_raw("generic.owner", "Token") < 0: return 35
    print "PASS generic owner binders, bounds, default dependencies, shadowing, exact self-forward constraints and non-leakage"
    0

# Production import path, not a separately reimplemented type projector.
fn imported_owner_constraint_lower(parameters: text, owner_prefix: text, consumer_prefix: text, method: text) -> HirLowering:
    val logger = Logger(level: 0)
    val owner_source = owner_prefix + "\nclass GenericRing<" + parameters + ">:\n    number: i64\n\nimpl GenericRing<Op, Cpl>:\n" + method
    val consumer_source = consumer_prefix + "\nuse generic.owner.\{GenericRing\}\nfn main() -> i64:\n    0\n"
    var modules: Dict<text, ParserModule> = {}
    modules["generic.owner"] = parse_full_frontend(owner_source, "generic.owner", "generic.owner", logger)
    val consumer = parse_full_frontend(consumer_source, "generic.consumer", "generic.consumer", logger)
    val surfaces = module_surfaces_from_modules(modules, [SourceFile(path: "generic/owner.spl", content: owner_source, module_name: "generic.owner")])
    if not surfaces.is_ok(): rt_exit(92)
    var lowering = hirlowering_for_module("generic.consumer", surfaces.unwrap())
    val span = Span.new(0, 0, 1, 1)
    val caller = lowering.symbols.define("CallerBinder", SymbolKind.TypeParam, nil, span, Visibility.Private, false, nil)
    lowering.prescan_type_parameters[caller.id] = HirType(kind: HirTypeKind.TypeParam("CallerBinder", []), span: span)
    val hir = lowering.lower_module(consumer)
    if hir.functions.len() == 0: rt_exit(93)
    if lowering.symbols.lookup_or_invalid("CallerBinder").id != caller.id: rt_exit(94)
    if lowering.prescan_type_parameters.len() != 1: rt_exit(95)
    match lowering.prescan_type_parameters[caller.id].kind:
        case HirTypeKind.TypeParam(name, bounds):
            if name != "CallerBinder" or bounds.len() != 0: rt_exit(96)
        case _: rt_exit(97)
    if lowering.symbols.lookup_or_invalid("Op").is_valid(): rt_exit(98)
    if lowering.symbols.lookup_or_invalid("Cpl").is_valid(): rt_exit(99)
    lowering

fn imported_owner_result_bound(lowering: HirLowering, method: text = "echo", parameter: text = "Op") -> HirType?:
    val id = lowering.symbols.lookup_or_invalid("generic.owner.GenericRing::" + method)
    if not id.is_valid(): return nil
    if val symbol = lowering.symbols.get_symbol(id):
        if val signature = symbol.type_:
            match signature.kind:
                case HirTypeKind.Function(_, result, _):
                    match result.kind:
                        case HirTypeKind.TypeParam(name, bounds):
                            if name == parameter and bounds.len() == 1: return Some(bounds[0])
                        case _: ()
                case _: ()
    nil

fn owner_bound_is_named(lowering: HirLowering, name: text) -> bool:
    if val bound = imported_owner_result_bound(lowering):
        match bound.kind:
            case HirTypeKind.Named(symbol, args):
                val owner = lowering.symbols.lookup_qualified_type_raw("generic.owner", name)
                owner >= 0 and symbol.id == owner and args.len() == 0 and symbol.id != lowering.symbols.lookup_or_invalid(name).id
            case _: false
    else:
        false

fn owner_bound_is_parameter(lowering: HirLowering, method: text, parameter: text, expected: text) -> bool:
    if val bound = imported_owner_result_bound(lowering, method, parameter):
        match bound.kind:
            case HirTypeKind.TypeParam(name, bounds): name == expected and bounds.len() == 0
            case _: false
    else:
        false
