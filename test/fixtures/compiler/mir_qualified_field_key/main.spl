# Repro for mir_qualified_field_key_namespace_mismatch_2026-08-08 (native/stage3 only).
# Expected after fix: every line prints its expected value. Known-bad: direct.gamma=0.
use mod_a.{a_make}
use mod_b.{Config, b_make}

fn main():
    val c = Config(errors: 777, gamma: 888)
    print("direct.errors={c.errors} expect=777")
    print("direct.gamma={c.gamma} expect=888")
    val d = b_make()
    print("viafn.errors={d.errors} expect=777")
    print("viafn.gamma={d.gamma} expect=888")
    val e = a_make()
    print("a.errors={e.errors} expect=333")
