# Owner module for cross_module_method_default_spec: a class method and an
# impl-block method with defaulted trailing parameters, called from ANOTHER
# module with those arguments omitted.

class XmodDefaultTable:
    count: i64

    fn bind_flag(x: i64, flag: bool = true) -> bool:
        flag

impl XmodDefaultTable:
    fn tag_of(x: i64, tag: text = "dflt") -> text:
        tag
