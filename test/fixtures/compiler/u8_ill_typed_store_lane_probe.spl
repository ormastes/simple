extern fn rt_bytes_alloc(n: i64) -> [u8]

# Ill-typed stores into a `[u8]`: an Int outside 0..=255, an Int push, and
# writes at/past the end. Run in every lane (interpreter boxed, interpreter
# packed, JIT, native) to establish which representation's behaviour is the
# reference for these cases.
fn probe(label: text, start: [u8]):
    var a = start
    a[1] = 300
    print "{label} store300 a1={a[1]} plus255u8={a[1] + 255u8} plus1={a[1] + 1}"
    print "{label} eq={a == [0u8, 44u8, 0u8, 0u8]}"
    a.push(5)
    val last = a[a.len() - 1]
    print "{label} push5 last={last} plus255u8={last + 255u8}"
    a[a.len()] = 1u8
    print "{label} at-end a={a} len={a.len()}"
    a[a.len() + 2] = 1u8
    print "{label} past-end a={a} len={a.len()}"

fn main() -> i64:
    probe("boxed", [0u8; 4])
    probe("packed", rt_bytes_alloc(4))
    0
