# FunctionIdentity transition fixture: duplicate bare externs and call destinations.
# The provider modules intentionally share the bare name `fi_numeric` while
# declaring different scalar signatures. The entry-side aliases are the only
# legal way to select either declaration.
# @fixture fi_duplicate_bare_extern_names
# @decl f32: extern fn fi_numeric(value: f32) -> f32
# @decl f64: extern fn fi_numeric(value: f64) -> f64
# @fixture fi_bodyless_extern_closure_retention
# @fixture fi_call_destination_types
# @call-form Call: fi_numeric_f32
# @call-form MethodCallStatic: FiReceiver.read_f64
# @call-form InterpCall: fi_numeric_f64

# Provider f32 (materialized by the lowering harness):
# extern fn fi_numeric(value: f32) -> f32
# Provider f64 (materialized by the lowering harness):
# extern fn fi_numeric(value: f64) -> f64

fn fi_numeric_f32(value: f32) -> f32:
    value

fn fi_numeric_f64(value: f64) -> f64:
    value

class FiReceiver:
    value: f64

    fn read_f64() -> f64:
        self.value

fn fi_call_destination_probe(value: f64) -> f64:
    val receiver = FiReceiver(value: value)
    receiver.read_f64()

fn main() -> i32:
    0
