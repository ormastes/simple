class FiLeft:
    value: f64

    fn read() -> f64:
        self.value

class FiRight:
    value: f64

    fn read() -> f64:
        self.value

fn fi_collision_probe(left: FiLeft, right: FiRight) -> f64:
    left.read() + right.read()

