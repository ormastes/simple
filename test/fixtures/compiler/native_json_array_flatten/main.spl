use std.common.json.types.{json_array, json_null, json_number, json_string, json_to_array, json_to_number, json_to_string, json_is_array}
use std.common.json.array_ops.{json_array_flatten, json_array_length, json_array_get, json_array_append, json_array_concat}

fn number_at(arr: any, index: i64) -> any:
    val values = json_to_array(arr).unwrap()
    json_to_number(values[index]).unwrap()

fn main():
    val inner = json_array([json_number(1), json_number(2)])
    val input = json_array([inner, json_string("kept"), json_array([]), json_number(3)])
    val flattened = json_array_flatten(input)
    assert(json_array_length(flattened) == 4)
    assert(number_at(flattened, 0) == 1.0)
    assert(number_at(flattened, 1) == 2.0)
    val flattened_values = json_to_array(flattened).unwrap()
    assert(json_to_string(flattened_values[2]).unwrap() == "kept")
    assert(number_at(flattened, 3) == 3.0)
    assert(json_array_length(input) == 4)
    val original_values = json_to_array(input).unwrap()
    assert(json_is_array(original_values[0]))
    assert(json_array_length(original_values[0]) == 2)
    assert(number_at(inner, 0) == 1.0)
    assert(number_at(inner, 1) == 2.0)
    assert(json_array_length(json_array_flatten(json_number(9))) == 0)
    assert(json_array_length(json_array_flatten(json_array([]))) == 0)
    assert(json_array_length(json_array_flatten(json_array([json_array([])]))) == 0)
    val twice_nested = json_array([json_array([json_array([json_number(5)])])])
    val flattened_once = json_to_array(json_array_flatten(twice_nested)).unwrap()
    assert(flattened_once.len() == 1)
    assert(json_is_array(flattened_once[0]))
    assert(number_at(flattened_once[0], 0) == 5.0)
    assert(json_to_array(json_null()) == nil)
    val appended = json_array_append(json_null(), json_number(4))
    assert(json_array_length(appended) == 1)
    assert(number_at(appended, 0) == 4.0)
    assert(json_array_get(json_null(), 0) == nil)
    val concatenated = json_array_concat(json_null(), inner)
    assert(json_array_length(concatenated) == 2)
    assert(number_at(concatenated, 0) == 1.0)
    assert(number_at(concatenated, 1) == 2.0)
    print("json-array-flatten assertions passed")
