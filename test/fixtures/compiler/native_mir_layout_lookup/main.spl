# Native bootstrap regression for Dict<SymbolId, MirTypeDef> layout lookups.
# Exit 0 requires field/enum layouts, negative cases, and standalone API checks.
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}
use compiler.mir.mir_data.*
use compiler.mir.mir_verify.{MirVerifyReport, mir_verify_module, mir_verify_function}

fn layout_lookup_copy(id: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Copy(LocalId(id: id)))

fn layout_lookup_has_rule(report: MirVerifyReport, rule: text) -> bool:
    for finding in report.findings:
        if finding.rule == rule:
            return true
    false

fn layout_lookup_module(field: i64, resolved: bool) -> MirModule:
    val scalar = MirType(kind: MirTypeKind.I64)
    val pair = MirType(kind: MirTypeKind.Struct(SymbolId(id: 700)))
    val location = Span(start: 0, end: 0, line: 1, col: 1,
        file: "native_mir_layout_lookup", length: 0)
    val function = MirFunction(
        symbol: SymbolId(id: 800), name: "fixture.layout_lookup",
        signature: MirSignature(params: [pair], return_type: scalar,
            is_variadic: false, params_known: true),
        locals: [
            MirLocal(id: LocalId(id: 0), name: Some("pair"), type_: pair,
                kind: LocalKind.Arg(0), is_ghost: false),
            MirLocal(id: LocalId(id: 1), name: nil, type_: scalar,
                kind: LocalKind.Temp, is_ghost: false)
        ],
        blocks: [MirBlock(id: BlockId(id: 0), label: Some("entry"),
            instructions: [MirInst(kind: MirInstKind.GetField(LocalId(id: 1),
                layout_lookup_copy(0), field), span: Some(location))],
            terminator: MirTerminator.Ret(Some(layout_lookup_copy(1))))],
        entry_block: BlockId(id: 0), span: location, generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {},
        layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "",
        is_export_c: false, export_name: "", has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false,
        unroll_factor: 0, pipeline_ii: 0, memory_banks: 0
    )
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[function.symbol] = function
    var definitions: Dict<SymbolId, MirTypeDef> = {}
    if resolved:
        definitions[SymbolId(id: 700)] = MirTypeDef(symbol: SymbolId(id: 700),
            name: "Pair", kind: MirTypeDefKind.Struct([
                MirFieldDef(name: "x", type_: scalar, offset: 0,
                    has_bits_attr: false, bits_width: 0),
                MirFieldDef(name: "y", type_: scalar, offset: 8,
                    has_bits_attr: false, bits_width: 0)
            ]), is_export_c: false, export_name: "")
    MirModule(name: "fixture.layout_lookup", functions: functions,
        statics: {}, constants: {}, types: definitions)

fn layout_lookup_report(field: i64, resolved: bool) -> MirVerifyReport:
    mir_verify_module(layout_lookup_module(field, resolved))

fn layout_lookup_enum_report(variant: i64, declared: i64, resolved: bool) -> MirVerifyReport:
    # Separate SymbolId boxes at every use reproduce the native identity bug.
    val enum_type = MirType(kind: MirTypeKind.Enum(SymbolId(id: 701)))
    val location = Span(start: 0, end: 0, line: 1, col: 1,
        file: "native_mir_layout_lookup", length: 0)
    val function = MirFunction(
        symbol: SymbolId(id: 801), name: "fixture.enum_lookup",
        signature: MirSignature(params: [], return_type: enum_type,
            is_variadic: false, params_known: true),
        locals: [MirLocal(id: LocalId(id: 0), name: nil, type_: enum_type,
            kind: LocalKind.Temp, is_ghost: false)],
        blocks: [MirBlock(id: BlockId(id: 0), label: Some("entry"),
            # Repeated validation exercises both cache creation and cache hits,
            # including the cached -1 marker for uncached enum layouts.
            instructions: [
                MirInst(kind: MirInstKind.Aggregate(LocalId(id: 0),
                    AggregateKind.Enum(SymbolId(id: 701), variant), []),
                    span: Some(location)),
                MirInst(kind: MirInstKind.Aggregate(LocalId(id: 0),
                    AggregateKind.Enum(SymbolId(id: 701), variant), []),
                    span: Some(location))
            ],
            terminator: MirTerminator.Ret(Some(layout_lookup_copy(0))))],
        entry_block: BlockId(id: 0), span: location, generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {},
        layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "",
        is_export_c: false, export_name: "", has_driver_manifest_attr: false,
        driver_manifest_attr: nil, has_vhdl_metadata: false,
        vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false,
        unroll_factor: 0, pipeline_ii: 0, memory_banks: 0
    )
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[function.symbol] = function
    var definitions: Dict<SymbolId, MirTypeDef> = {}
    if resolved:
        definitions[SymbolId(id: 701)] = MirTypeDef(symbol: SymbolId(id: 701),
            name: "Color", kind: MirTypeDefKind.Enum([
                MirVariantDef(name: "Red", discriminant: declared, payload: nil)
            ]), is_export_c: false, export_name: "")
    mir_verify_module(MirModule(name: "fixture.enum_lookup", functions: functions,
        statics: {}, constants: {}, types: definitions))

fn layout_lookup_standalone(field: i64, expected_rule: text) -> bool:
    val graph = layout_lookup_module(field, true)
    var checked = 0
    for function in graph.functions.values():
        val findings = mir_verify_function(function, graph, {})
        checked = checked + 1
        if expected_rule == "":
            if findings.len() != 0: return false
        else:
            var found = false
            for finding in findings:
                if finding.rule == expected_rule: found = true
            if not found: return false
    checked == 1

fn main() -> i64:
    if not layout_lookup_report(1, true).is_clean():
        return 1
    if not layout_lookup_has_rule(layout_lookup_report(2, true), "MIRV-006"):
        return 2
    if not layout_lookup_has_rule(layout_lookup_report(0, false), "MIRV-006b"):
        return 3
    # Nonnegative discriminants take the cached enum-slot lookup path.
    if not layout_lookup_enum_report(1, 1, true).is_clean():
        return 4
    if not layout_lookup_has_rule(layout_lookup_enum_report(2, 1, true), "MIRV-005d"):
        return 5
    # A negative discriminant forces the uncached definition lookup path.
    if not layout_lookup_enum_report(-1, -1, true).is_clean():
        return 6
    if not layout_lookup_has_rule(layout_lookup_enum_report(-2, -1, true), "MIRV-005d"):
        return 7
    if not layout_lookup_has_rule(layout_lookup_enum_report(0, 0, false), "MIRV-006b"):
        return 8
    if not layout_lookup_standalone(1, ""):
        return 9
    if not layout_lookup_standalone(2, "MIRV-006"):
        return 10
    val empty = MirModule(name: "fixture.empty", functions: {}, statics: {},
        constants: {}, types: {})
    if not mir_verify_module(empty).is_clean():
        return 11
    0
