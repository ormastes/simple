# Known limitation: native per-file cross-module inherent implementations are
# UNSUPPORTED. This positive fixture records desired future behavior; it is not
# currently a passing native test. Preserve the body and marker as the oracle.
# See doc/08_tracking/bug/native_cross_module_inherent_trait_2026-10-12.md.
# Flattened cross-module composition also refuses this incomplete table.
# Trait-alias imports with a local implementation are tested separately.
use .device.{Device as Alias, AliasProbe}

impl Alias:
    fn read() -> i64: 37

fn through_alias(value: AliasProbe) -> i64:
    value.read()

fn main() -> i64:
    assert(through_alias(Alias()) == 37)
    print "IMPLICIT_TRAIT_ALIAS_PASS value=37"
    0
