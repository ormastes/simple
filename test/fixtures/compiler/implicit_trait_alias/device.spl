# Known-limitation diagnostic: required read is implemented in the importing
# module, which native per-file composition does not yet support. Safe compile
# refusal is expected currently; it does not qualify the desired positive path.
# See doc/08_tracking/bug/native_cross_module_inherent_trait_2026-10-12.md.
trait AliasProbe:
    fn read() -> i64

struct Device(AliasProbe):
    pass
