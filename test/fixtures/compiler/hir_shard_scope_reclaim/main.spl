use .owner.{answer_after_scope}
use .consumer.{sibling_answer}

fn main() -> i64:
    val direct = answer_after_scope()
    val sibling = sibling_answer()
    if direct.value != 37: return 1
    if sibling.value != 42: return 2
    print("hir-scope-body=37 sibling-return=42 checks=2 failures=0")
    0
