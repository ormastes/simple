# Probe dependency copied from the production SCV owner. This fixture retains
# the exact data type and identity comparator used by the helper; unrelated
# inventory operations are intentionally not part of this minimal native test.

struct CompileSourceInventoryEntryV1:
    source_identity: text
    content_digest: text
    semantic_digest: text
    export_digest: text
    initializer_digest: text
    provider_digest: text
    byte_count: i64

fn compile_source_inventory_identity_cmp_v1(left: text, right: text) -> i64:
    val shared = if left.byte_len() < right.byte_len(): left.byte_len() else: right.byte_len()
    var index = 0
    while index < shared:
        val a = left.byte_at(index) as i64
        val b = right.byte_at(index) as i64
        if a != b:
            return if a < b: -1 else: 1
        index = index + 1
    if left.byte_len() == right.byte_len(): 0 elif left.byte_len() < right.byte_len(): -1 else: 1
