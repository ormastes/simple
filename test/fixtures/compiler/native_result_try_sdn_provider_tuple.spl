use std.common.sdn.parser.{parse_with_spans_and_issues}
use std.common.sdn.value.{SdnValue as ProviderValue}

# None of these consumer homonyms describes a returned provider value.
enum SdnValue:
    Int(text)
class SdnSpan:
    column: text
    line: text
struct SdnIssue:
    col: text
    kind: i64

var after_try: i64 = 0

fn inspect_document(source: text, expected: i64, line: i64, issue_count: i64) -> Result<i64, text>:
    val parsed = parse_with_spans_and_issues(source)?
    after_try = after_try + 1
    var assigned = parsed
    val copied = assigned
    assigned = copied
    val root = assigned.0
    match root:
        case ProviderValue.Dict(fields):
            assert(fields.len() == 1)
            match fields["a"]:
                case ProviderValue.Int(value): assert(value == expected)
                case _: assert(false)
        case _: assert(false)
    val spans = assigned.1
    assert(spans.contains_key("a"))
    val span = spans["a"]
    assert(span.line == line)
    assert(span.column == 1)
    assert(span.start == 0 and span.end == 0)
    val issues = assigned.2
    assert(issues.len() == issue_count)
    var seen = 0
    for issue in issues:
        assert(issue.kind == "duplicate_key")
        assert(issue.path == "a")
        assert(issue.message.contains("a"))
        assert(issue.line == 2 and issue.col == 1)
        seen = seen + 1
    if issue_count > 0:
        assert(issues[0].line == 2)
        assert(issues[0].path == "a")
    assert(seen == issue_count)
    Ok(expected + seen)

fn numeric_payload() -> Result<(bool, f64, (i64, i64)), text>:
    Ok((true, 2.5, (7, 19)))

fn numeric_probe() -> Result<i64, text>:
    val tuple = numeric_payload()?
    assert(tuple.0)
    assert(tuple.1 == 2.5)
    val inner = tuple.2
    assert(inner.0 == 7 and inner.1 == 19)
    Ok(26)

fn main():
    assert(inspect_document("a: 17\n", 17, 1, 0).unwrap() == 17)
    assert(inspect_document("a: 1\na: 23\n", 23, 2, 1).unwrap() == 24)
    assert(after_try == 2)
    val invalid = inspect_document("\"unterminated", 0, 0, 0)
    assert(invalid.is_err())
    assert(invalid.unwrap_err().len() > 0)
    assert(after_try == 2)
    assert(numeric_probe().unwrap() == 26)
    print("Result try SDN tuple provider assertions passed")
