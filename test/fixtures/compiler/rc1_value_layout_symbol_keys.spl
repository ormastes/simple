# Native layout validation must resolve SymbolId keys for multiple structs.
struct LayoutLeaf:
    value: i64

struct LayoutPair:
    left: LayoutLeaf
    right: LayoutLeaf

fn main() -> i64:
    val pair = LayoutPair(left: LayoutLeaf(value: 19), right: LayoutLeaf(value: 23))
    if pair.left.value + pair.right.value != 42:
        return 1
    print "RC1 value layout symbol keys PASS"
    0
