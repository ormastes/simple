struct ZeroArgEvidence:
    marker: i64

class ZeroArgReceiver:
    var execution_target: text
    var performance_evidence: ZeroArgEvidence? = nil

impl ZeroArgReceiver:
    fn target() -> text:
        self.execution_target

    fn evidence() -> ZeroArgEvidence?:
        self.performance_evidence

export ZeroArgEvidence, ZeroArgReceiver
