# Repro for doc/08_tracking/bug/native_huffman_bitstream_nested_array_abi_2026_10_11.md.
# The gzip bit writer no longer uses this shape (2026-10-18), so the original
# [Any]-tuple-with-nested-[u8] functions are inlined here verbatim to keep the
# native ABI repro meaningful.

fn bitstream_new() -> [Any]:
    var bytes: [u8] = []
    return [bytes, 0, 0]

fn bitstream_finish(bs) -> [u8]:
    var bytes   = bs[0]
    var bit_buf = bs[1]
    var bit_cnt = bs[2]

    if bit_cnt > 0:
        bytes.push(bit_buf.to_u8())

    return bytes

fn main() -> i64:
    val bytes = bitstream_finish(bitstream_new())
    if bytes.len() != 0:
        return 1
    print "bitstream-empty:ok"
    return 0
