use compiler.backend.backend.runtime_compiler.{find_c_compiler}
use std.nogc_sync_mut.io.env_ops.{env_set}

fn main() -> i64:
    if not env_set("SIMPLE_MANAGED_NATIVE_TOOLS", "invalid-request"): return 2
    if not env_set("SIMPLE_MANAGED_NATIVE_TOOL_AUTHORITY_PATH", "/missing/admitted-tools.snapshot"): return 2
    if not env_set("SIMPLE_MANAGED_NATIVE_TOOL_AUTHORITY_SHA256", "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"): return 2
    if not env_set("SIMPLE_NATIVE_BUILD_TARGET", "host"): return 2
    if not env_set("SIMPLE_CC", "/ambient/not-admitted/clang"): return 2
    if find_c_compiler() != "": return 1
    print "strict-ambient-cc-refused"
    0
