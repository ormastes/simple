use provider.{get_values}

fn retained_optional(value: [i64]?) -> [i64]?:
    value

fn count_values(value: [i64]?) -> i64:
    var count = 0
    if val items = value:
        for item in items:
            count = count + 1
        # An inner present binding must restore its own mapping without
        # removing the outer iterable's identity.
        if val inner = get_values(2):
            for item in inner:
                assert(item == 4 or item == 7)
        else:
            assert(false)
        for item in items:
            assert(item == 4 or item == 7)
    else:
        assert(value == nil)
        val still_optional: [i64]? = retained_optional(value)
        assert(still_optional == nil)
    # The source Optional must keep its type and value after both edges.
    val after: [i64]? = retained_optional(value)
    if value == nil:
        assert(after == nil)
    else:
        assert(after.unwrap().len() == count)
    count

fn first_or_missing(value: [i64]?) -> i64:
    if val items = value:
        for item in items:
            return item
        return 0
    else:
        assert(value == nil)
    val after: [i64]? = retained_optional(value)
    assert(after == nil)
    -1

fn chain_count(value: [i64]?) -> i64:
    var count = 0
    if false:
        assert(false)
    elif val items = value:
        for item in items:
            count = count + 1
    else:
        assert(value == nil)
    val after: [i64]? = retained_optional(value)
    if value == nil:
        assert(after == nil)
    else:
        assert(after.unwrap().len() == count)
    count

fn mutable_optional_guard(mode: i64):
    var observed: [i64]? = get_values(mode).?
    if observed != nil:
        observed = nil
    else:
        observed = get_values(2)
    # This is a source Optional variable, not an if-val payload binder.
    # A branch write must affect its original storage after the merge.
    val after: [i64]? = retained_optional(observed)
    if mode == 0:
        assert(after.unwrap().len() == 2)
    else:
        assert(after == nil)

fn main():
    assert(count_values(get_values(0)) == 0)
    assert(count_values(get_values(1)) == 0)
    assert(count_values(get_values(2)) == 2)
    mutable_optional_guard(0)
    mutable_optional_guard(1)
    mutable_optional_guard(2)
    assert(chain_count(get_values(0)) == 0)
    assert(chain_count(get_values(1)) == 0)
    assert(chain_count(get_values(2)) == 2)
    assert(first_or_missing(get_values(0)) == -1)
    assert(first_or_missing(get_values(1)) == 0)
    assert(first_or_missing(get_values(2)) == 4)
    # Mutable source storage retains its Optional metadata across the branch.
    var source: [i64]? = get_values(2)
    if val items = source:
        assert(items.len() == 2)
    else:
        assert(false)
    source = nil
    val absent: [i64]? = retained_optional(source)
    assert(absent == nil)
    print("if-val optional array assertions passed")
