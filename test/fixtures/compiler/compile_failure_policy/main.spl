use compiler.driver.compile_failure_policy.{compile_fail_fast_requested}

fn main() -> i64:
    for ci in ["", "0", "1", "false", "true"]:
        assert(not compile_fail_fast_requested([], "", ci))
        assert(not compile_fail_fast_requested([], "invalid", ci))
        assert(compile_fail_fast_requested([], "1", ci))
        assert(not compile_fail_fast_requested([], "0", ci))
        assert(compile_fail_fast_requested(["--keep-going", "--fail-fast"], "0", ci))
        assert(not compile_fail_fast_requested(["--fail-fast", "--keep-going"], "1", ci))
    print "PASS compile failure policy"
    0
