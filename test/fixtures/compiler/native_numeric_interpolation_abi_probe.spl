# Native runtime probe for stage3_numeric_interpolation_slot_corruption.
# The compiler unit spec owns generic interpolation plus the two
# parser/ast_reset cycles; this native entrypoint stays monomorphic because
# current native builds intentionally reject generic function declarations.

fn tagged_text_identity(value: text) -> text:
    value

fn tagged_text_nested(value: i64) -> text:
    str(str(value))

fn tagged_text_reassignment(value: i64) -> text:
    val rendered = str(value)
    var replacement = str(0)
    replacement = rendered
    replacement

fn tagged_text_methods(value: i64) -> bool:
    val rendered = str(value)
    rendered.len() == 6 and rendered.starts_with("807")

fn tagged_text_container_round_trip(value: i64) -> text:
    val rendered = str(value)
    val values: [text] = [rendered]
    val named: Dict<text, text> = {"count": rendered}
    values[0] + ":" + named["count"]

fn tagged_text_return_call(value: i64) -> text:
    tagged_text_identity(str(value))

# Kept separate from main so this remains a source-level print bridge fixture;
# a future rebuilt native executable can invoke it without changing the probe's
# exit-code-only contract.
fn print_tagged_text(value: i64) -> i64:
    print(str(value))
    0

fn main() -> i64:
    val minimum: i64 = -9223372036854775807 - 1
    val maximum: i64 = 9223372036854775807
    if "min={minimum};max={maximum}" != "min=-9223372036854775808;max=9223372036854775807":
        return 1
    val heap_registry: i64 = 807339
    if "phase2:surface:file:start path=probe.spl heap_registry={heap_registry}" != "phase2:surface:file:start path=probe.spl heap_registry=807339":
        return 2
    val rendered = str(heap_registry)
    if "n=" + str(heap_registry) != "n=807339":
        return 3
    if "n=" + rendered + ";again=" + rendered != "n=807339;again=807339":
        return 4
    if tagged_text_nested(heap_registry) != "807339":
        return 5
    if tagged_text_reassignment(heap_registry) != "807339":
        return 6
    if not tagged_text_methods(heap_registry):
        return 7
    if tagged_text_container_round_trip(heap_registry) != "807339:807339":
        return 8
    if tagged_text_return_call(heap_registry) != "807339":
        return 9
    0
