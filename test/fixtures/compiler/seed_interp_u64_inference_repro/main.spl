# Repro for doc/08_tracking/bug/seed_interp_u64_inference_signed_2026-10-18.md.
# Expected (JIT): both lines hi=2942932839. Seed interpreter: inferred hi=-1352034457.
extern fn rt_typed_bytes_u64_le_at(buf: [u8], off: u64) -> u64
fn rd(b: [u8], o: i64) -> u64:
    rt_typed_bytes_u64_le_at(b, o.to_u64())
fn main():
    val b: [u8] = [0xB8u8, 0xFEu8, 0x6Cu8, 0x39u8, 0x23u8, 0xA4u8, 0x4Bu8, 0xBEu8,
                   0x80u8, 0x77u8, 0x66u8, 0x55u8, 0x44u8, 0x33u8, 0x22u8, 0x11u8]
    val x = rd(b, 0) ^ rd(b, 8)
    val y: u64 = rd(b, 0) ^ rd(b, 8)
    print("inferred  hi=" + (x >> 32u64).to_text())
    print("annotated hi=" + (y >> 32u64).to_text())
