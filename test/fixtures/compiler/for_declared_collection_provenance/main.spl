# Native regression: declared containers must retain element identity.
struct CollectionHolder:
    names: [text]

fn optional_names(present: bool) -> [text]?:
    if present: return Some(["alpha", "beta"])
    nil

fn main() -> i64:
    val holder = CollectionHolder(names: ["one", "two"])
    var joined = ""
    for name in holder.names:
        joined = joined + name
    if not (joined == "onetwo"): return 1
    val present: [text] = optional_names(true) ?? []
    var count = 0
    for name in present:
        count = count + name.len()
    if not (count == 9): return 1
    val absent: [text] = optional_names(false) ?? []
    for name in absent:
        if not (false): return 1
    0
