# Mirrors collection_feedback's optional concrete-class branch merge.
class CollectionOrdinal:
    value: i64
    static fn new() -> CollectionOrdinal:
        CollectionOrdinal(value: 0)
    fn get() -> i64:
        self.value
    me insert(value: i64):
        self.value = value

var retained: CollectionOrdinal? = nil

fn next_ordinal() -> i64:
    var ordinal: CollectionOrdinal = if val existing = retained:
        existing
    else:
        CollectionOrdinal.new()
    val previous = ordinal.get()
    ordinal.insert(previous + 1)
    retained = Some(ordinal)
    previous

fn main() -> i64:
    if not (next_ordinal() == 0): return 1
    if not (next_ordinal() == 1): return 1
    0
