# Bootstrap diagnostic of the real highlighting owner; no mock lexer.
use compiler.blocks.highlighting.{highlight_keywords, highlight_strings, highlight_comments, highlight_numbers}
use compiler.blocks.definition.HighlightKind

fn highlighting_case_1() -> i64:
    val tokens = highlight_keywords("let outlet let", ["let"])
    if not (tokens.len() == 2):
        return 1
    if not (tokens[0].start == 0):
        return 1
    if not (tokens[0].end == 3):
        return 1
    if not (tokens[1].start == 11):
        return 1
    if not (tokens[1].end == 14):
        return 1
    if not (tokens[1].kind == HighlightKind.Keyword):
        return 1
    0

fn highlighting_case_2() -> i64:
    if not (highlight_keywords("alpha", ["missing", "zz", ""]).len() == 0):
        return 2
    if not (highlight_keywords("", ["", "alpha"]).len() == 0):
        return 2
    0

fn highlighting_case_3() -> i64:
    val tokens = highlight_strings("say \"hi\" end")
    if not (tokens.len() == 1):
        return 3
    if not (tokens[0].start == 4):
        return 3
    if not (tokens[0].end == 8):
        return 3
    if not (tokens[0].kind == HighlightKind.String):
        return 3
    0

fn highlighting_case_4() -> i64:
    val tokens = highlight_comments("a // x\nb", "//")
    if not (tokens.len() == 1):
        return 4
    if not (tokens[0].start == 2):
        return 4
    if not (tokens[0].end == 6):
        return 4
    if not (tokens[0].kind == HighlightKind.Comment):
        return 4
    0

fn highlighting_case_5() -> i64:
    val tokens = highlight_comments("a /* x */ b", "//", Some(("/*", "*/")))
    if not (tokens.len() == 1):
        return 5
    if not (tokens[0].start == 2):
        return 5
    if not (tokens[0].end == 9):
        return 5
    if not (tokens[0].kind == HighlightKind.Comment):
        return 5
    0

fn highlighting_case_6() -> i64:
    val tokens = highlight_numbers("x 12 0xFA -2.5e+1")
    if not (tokens.len() == 3):
        return 6
    if not (tokens[0].start == 2):
        return 6
    if not (tokens[0].end == 4):
        return 6
    if not (tokens[1].start == 5):
        return 6
    if not (tokens[1].end == 9):
        return 6
    if not (tokens[2].start == 10):
        return 6
    if not (tokens[2].end == 17):
        return 6
    if not (tokens[2].kind == HighlightKind.Number):
        return 6
    0

fn highlighting_case_7() -> i64:
    val tokens = highlight_strings("\"a\\\"b\"")
    if not (tokens.len() == 1):
        return 7
    if not (tokens[0].start == 0):
        return 7
    if not (tokens[0].end == 6):
        return 7
    if not (tokens[0].kind == HighlightKind.String):
        return 7
    0

# Cases 1-3 already passed in cycle 2. Do not repeat them.
fn main() -> i64:
    if highlighting_case_4() != 0:
        return 4
    if highlighting_case_5() != 0:
        return 5
    if highlighting_case_6() != 0:
        return 6
    if highlighting_case_7() != 0:
        return 7
    print "HIGHLIGHTING_REMAINING_NATIVE_CONTRACT_PASS"
    0
