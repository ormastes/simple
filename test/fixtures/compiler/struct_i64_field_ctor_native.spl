# Native fixture: struct constructor stores, and field reads return, each field.
# Expect stdout `a=7 m=-5,9223372036854775807,42 o=1,2,3 f=2.5 t=hi b=true n=11,22 v=13` and exit 0.
# Bug: native_struct_i64_field_ctor_reads_wrong_value_2026-11-05 (s3_fable44 printed FAIL for P(a: 7).a).
# Spec: test/01_unit/compiler/50.mir/struct_i64_field_ctor_spec.spl
struct P:
    a: i64
struct M:
    x: i64
    y: i64
    z: i64
struct Mixed:
    f: f64
    t: text
    b: bool
struct Inner:
    v: i64
struct Outer:
    k: i64
    inner: Inner
fn main() -> i64:
    val p = P(a: 7)
    val m = M(x: -5, y: 9223372036854775807, z: 42)
    val o = M(z: 3, x: 1, y: 2)
    val q = Mixed(t: "hi", b: true, f: 2.5)
    val n = Outer(inner: Inner(v: 22), k: 11)
    val seed = 13
    val w = P(a: seed)
    print("a={p.a} m={m.x},{m.y},{m.z} o={o.x},{o.y},{o.z} f={q.f} t={q.t} b={q.b} n={n.k},{n.inner.v} v={w.a}")
    var ok = p.a == 7
    if m.x != -5 or m.y != 9223372036854775807 or m.z != 42: ok = false
    if o.x != 1 or o.y != 2 or o.z != 3: ok = false
    if q.f != 2.5 or q.t != "hi" or not q.b: ok = false
    if n.k != 11 or n.inner.v != 22: ok = false
    if w.a != 13: ok = false
    if ok:
        print("PASS struct_i64_field_ctor")
        return 0
    print("FAIL struct_i64_field_ctor")
    return 1
