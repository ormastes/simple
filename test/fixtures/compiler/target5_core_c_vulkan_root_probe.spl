use compiler.backend.linker._LinkerWrapper.native_all_support.{native_all_gnu_support_args}

fn main() -> i64:
    val archive = ["/runtime/libsimple_native_all.a"]
    for os in ["linux", "macos", "freebsd", "windows-mingw"]:
        val core = native_all_gnu_support_args(
            archive, os, "/custom/brew", "core-c-bootstrap")
        if core.len() == 0 or core.contains("-u") or
                core.contains("rt_vulkan_provider_is_available") or
                core.contains("_rt_vulkan_provider_is_available"):
            print "CORE_C_FORCED_VULKAN_ROOT os={os}"
            return 1
    val gpu = native_all_gnu_support_args(archive, "linux", "", "host-gpu")
    if not gpu.contains("-u") or
            not gpu.contains("rt_vulkan_provider_is_available"):
        print "HOST_GPU_LOST_VULKAN_ROOT"
        return 2
    if native_all_gnu_support_args(["runtime.o"], "linux", "",
            "core-c-bootstrap").len() != 0:
        print "CORE_C_SUPPORT_WITHOUT_ARCHIVE"
        return 3
    print "TARGET5_CORE_C_VULKAN_ROOT_PASS"
    0
