use .owner.Writer

# These bare names deliberately collide with Result's Ok and Err variants.
enum OtherReply:
    Ok
    Err

fn other_reply_value(reply: OtherReply) -> i64:
    match reply:
        case Ok: 1
        case Err: 2

fn instance_result(writer: Writer) -> i64:
    match writer.write_all():
        case Ok(value): value
        case Err(_): -1

fn static_result() -> i64:
    match Writer.make():
        case Ok(value): value
        case Err(_): -1

fn main() -> i64:
    if other_reply_value(OtherReply.Ok) != 1: return 1
    if other_reply_value(OtherReply.Err) != 2: return 2
    if instance_result(Writer()) != 31: return 3
    if static_result() != 47: return 4
    print("RESULT_METHOD_ENUM_SUBJECT_PASS instance=31 static=47")
    0
