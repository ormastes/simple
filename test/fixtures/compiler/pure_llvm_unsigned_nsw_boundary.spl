# Compile with the Pure-Simple LLVM producer and optimization enabled, then run.
# @req REQ-PURE-LLVM-UNSIGNED-WRAP
# Parameters keep the three arithmetic sites separate from their callers.
fn unsigned_boundary_add(left: u32, right: u32) -> u32:
    left + right

fn unsigned_boundary_sub(left: u32, right: u32) -> u32:
    left - right

fn unsigned_boundary_mul(left: u32, right: u32) -> u32:
    left * right

fn main():
    val added = unsigned_boundary_add(2147483647u32, 1u32)
    val subtracted = unsigned_boundary_sub(2147483648u32, 1u32)
    val multiplied = unsigned_boundary_mul(65536u32, 65536u32)
    assert(added == 2147483648u32)
    assert(subtracted == 2147483647u32)
    assert(multiplied == 0u32)
    print "unsigned-nsw-boundaries: PASS"
