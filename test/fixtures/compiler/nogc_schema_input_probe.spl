"""Native schema-input diagnostic: distinguish I/O, text and extraction failures.

Print counts only; this does not generate files or establish generator parity.
"""

use std.nogc_sync_mut.io_runtime.{cwd, env_get, read_file_text, read_file_text_result, file_exists, exit}
use app.compiler_schema.extract.{extract_enum_variants}

fn schema_input_require(condition: bool, message: text):
    if not condition:
        print "schema-input: FAIL {message}"
        exit(1)

fn main() -> i64:
    val literal_lines = "first\nsecond\n".split("\n")
    print "schema-input: literal_lines={literal_lines.len()}"
    schema_input_require(literal_lines.len() >= 2, "literal text split did not produce lines")
    schema_input_require(literal_lines[0] == "first", "literal text split changed its first line")
    schema_input_require(literal_lines[1] == "second", "literal text split changed its second line")

    val working_directory = cwd()
    val configured_root = env_get("SIMPLE_REPO_ROOT")
    var root = working_directory
    if configured_root != "":
        root = configured_root
    print "schema-input: cwd_bytes={working_directory.len()} configured_root_bytes={configured_root.len()} root_bytes={root.len()}"
    schema_input_require(root.len() > 0, "schema repository root is empty")

    val path = root + "/src/compiler/20.hir/hir_types.spl"
    val present = file_exists(path)
    print "schema-input: hir_types_exists={present}"
    schema_input_require(present, "HIR declaration source is missing at the selected root")
    val checked_source = read_file_text_result(path)
    match checked_source:
        case Ok(content):
            print "schema-input: checked_read_bytes={content.len()}"
        case Err(error):
            print "schema-input: read error: {error}"
            exit(1)
    val source = read_file_text(path)
    print "schema-input: hir_types_bytes={source.len()}"
    schema_input_require(source.len() > 1000, "file read returned an empty or truncated HIR declaration source")

    val lines = source.split("\n")
    var nonempty = 0
    var module_headers = 0
    for line in lines:
        if line.trim() != "":
            nonempty = nonempty + 1
        if line.trim() == "struct HirModule:":
            module_headers = module_headers + 1
    val module_offset = source.find("struct HirModule:")
    print "schema-input: source_lines={lines.len()} nonempty_lines={nonempty} module_headers={module_headers} module_offset={module_offset}"
    schema_input_require(lines.len() > 100, "HIR source split lost declaration lines")
    schema_input_require(nonempty > 100, "HIR source split returned empty lines")
    schema_input_require(module_headers == 1, "line scanning did not find the unique HirModule header")
    schema_input_require(module_offset >= 0, "text search did not find HirModule in the read source")

    val literal_rows = extract_enum_variants("enum InputProbe:\n    First\n    Second(value: i64)\n", "InputProbe", "probe")
    print "schema-input: literal_variants={literal_rows.len()}"
    schema_input_require(literal_rows.len() == 2, "enum extraction failed on an in-memory control")
    val source_rows = extract_enum_variants(source, "HirTypeKind", "hir")
    print "schema-input: hir_type_variants={source_rows.len()}"
    schema_input_require(source_rows.len() > 10, "enum extraction failed on the verified source text")
    print "schema-input: I/O, line scanning and enum extraction controls passed"
    0
