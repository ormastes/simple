# Differential oracle: literal transport vs runtime numeric production vs
# declared enum transport. No Any casts and no approximate comparisons.
enum FloatCarrier:
    Scalar(f64)
    Pair(f64, i64)

fn ratio(numerator: i64, denominator: i64) -> f64:
    (numerator as f64) / (denominator as f64)

fn scalar(value: FloatCarrier) -> f64:
    match value:
        case FloatCarrier.Scalar(number): number
        case FloatCarrier.Pair(number, marker):
            if marker != 73: return ratio(0, 1)
            number

fn main() -> i32:
    var failed = 0
    val expected = ratio(9, 4)
    if (expected * (4 as f64)) as i64 != 9: failed = failed + 1
    print "case=1 runtime-arithmetic failures={failed}"
    val literal = 2.25
    if literal != expected: failed = failed + 1
    print "case=2 literal-f64 failures={failed}"
    val narrow = 1.5 as f32
    if (narrow as f64) != ratio(3, 2): failed = failed + 1
    print "case=3 literal-f32 failures={failed}"
    val parsed = "2.25".to_float()
    if parsed != expected: failed = failed + 1
    print "case=4 runtime-text-parse failures={failed}"
    if scalar(FloatCarrier.Scalar(expected)) != expected: failed = failed + 1
    print "case=5 runtime-enum-scalar failures={failed}"
    if scalar(FloatCarrier.Pair(expected, 73)) != expected: failed = failed + 1
    print "case=6 runtime-enum-tuple failures={failed}"
    print "float literal transport: 6 checks, {failed} failures"
    failed
