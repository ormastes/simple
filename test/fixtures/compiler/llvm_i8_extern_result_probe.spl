# Expected native exit: 42. A narrow extern status remains i8 through the
# unsafe-expression result and comparison; converting a pointer to i8 would
# hide a wrong inferred/load type. See the 2026-10-10 Phase 3 conversion bug.
@unsafe(reason: "minimal extern result type regression", capabilities: [ffi])
extern fn rt_array_set_len_known(collection: [u8], len: i64) -> i8

fn main() -> i64:
    val bytes: [u8] = [1u8]
    val status = unsafe(capabilities: [ffi]):
        rt_array_set_len_known(bytes, 1)
    if status == 1i8:
        return 42
    1
