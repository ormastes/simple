"""Native regression probe for a direct imported enum text payload."""

use std.database.sql.types.{DbValue}

fn main() -> i64:
    val value = DbValue.Text(value: "direct").to_text()
    if value != "direct":
        print "FAIL imported_enum_text=" + value
        return 1
    print "PASS native_imported_enum_text_payload"
    0
