"""Native NLL recorder integration diagnostic, not whole-language proof."""

use compiler.borrow.borrow_check.nll.{BasicBlock, ControlFlowGraph, NLLChecker, loan_alias_place}
use compiler.borrow.borrow_check.borrow_graph.{LoanAlias, place_local, place_field}


use std.nogc_sync_mut.io_runtime.{exit}

fn nll_probe_guard(condition: bool, message: text):
    if not condition:
        print "FAIL: {message}"
        exit(1)

fn flow_block(id: i64, points: [i64], terminal: i64, successors: [i64]) -> BasicBlock:
    var block = BasicBlock.create(id)
    block.statements = points
    block.terminator_point = terminal
    block.successors = successors
    block

fn loop_cfg(backedge: bool) -> ControlFlowGraph:
    var cfg = ControlFlowGraph.create()
    cfg.add_block(flow_block(0, [0], 1, [1]))
    val targets = if backedge: [1, 2] else: [2]
    cfg.add_block(flow_block(1, [2, 3], 4, targets))
    cfg.add_block(flow_block(2, [5], 6, []))
    cfg.compute_predecessors()
    cfg

fn main() -> i64:
    # Loan ID zero must never be read as the nested Place field at offset zero.
    val projected_alias = LoanAlias(loan_id: 0, place: place_field(place_local(17), 3))
    val alias_place = loan_alias_place(projected_alias)
    nll_probe_guard(alias_place.projections.len() == 1, "LoanAlias nested place layout was lost")
    var alias_flow = NLLChecker.create(loop_cfg(false))
    alias_flow.record_move(2, alias_place)
    alias_flow.record_assign(3, place_local(99))
    alias_flow.record_use(5, alias_place)
    nll_probe_guard(not alias_flow.check(), "unrelated assignment erased the projected alias move")
    val owner = place_local(0)
    var repeated = NLLChecker.create(loop_cfg(true))
    repeated.record_move(3, owner)
    nll_probe_guard(not repeated.check(), "NLL dropped the backedge move")
    nll_probe_guard(repeated.errors[0].primary_span == 3, "NLL move diagnostic has wrong point")

    var refill = NLLChecker.create(loop_cfg(true))
    refill.record_assign(2, owner)
    refill.record_move(3, owner)
    nll_probe_guard(refill.check(), "NLL rejected a dominating refill")

    var exits = NLLChecker.create(loop_cfg(false))
    exits.record_move(3, owner)
    nll_probe_guard(exits.check(), "NLL treated a break as a backedge")

    var after_exit = NLLChecker.create(loop_cfg(false))
    after_exit.record_move(3, owner)
    after_exit.record_use(5, owner)
    nll_probe_guard(not after_exit.check(), "NLL lost moved facts at exit")
    nll_probe_guard(after_exit.errors[0].primary_span == 5, "NLL exit diagnostic has wrong point")

    var cfg = ControlFlowGraph.create()
    cfg.add_block(flow_block(0, [0], 1, [1, 2]))
    cfg.add_block(flow_block(1, [2], 3, [3]))
    cfg.add_block(flow_block(2, [4], 5, [3]))
    cfg.add_block(flow_block(3, [6], 7, []))
    cfg.compute_predecessors()
    var branches = NLLChecker.create(cfg)
    branches.record_move(2, owner)
    branches.record_move(4, owner)
    nll_probe_guard(branches.check(), "NLL source walk polluted sibling moves")

    var partial = NLLChecker.create(loop_cfg(false))
    partial.record_move(3, place_field(owner, 0))
    partial.record_use(5, owner)
    nll_probe_guard(not partial.check(), "NLL allowed a whole read after partial move")
    nll_probe_guard(partial.errors[0].primary_span == 5, "NLL partial move has wrong use point")

    # Storage order must not decide execution order or remove a predecessor.
    var permuted_cfg = ControlFlowGraph.create()
    permuted_cfg.add_block(flow_block(3, [6], 7, []))
    permuted_cfg.add_block(flow_block(2, [4], 5, [3]))
    permuted_cfg.add_block(flow_block(1, [2], 3, [3]))
    permuted_cfg.add_block(flow_block(0, [0], 1, [1, 2]))
    permuted_cfg.compute_predecessors()
    var permuted = NLLChecker.create(permuted_cfg)
    permuted.record_move(2, owner)
    permuted.record_move(4, owner)
    permuted.record_use(6, owner)
    nll_probe_guard(not permuted.check(), "NLL block storage order lost a moved predecessor")
    nll_probe_guard(permuted.errors.len() == 1, "NLL block permutation polluted a sibling arm")
    nll_probe_guard(permuted.errors[0].primary_span == 6, "NLL block permutation changed diagnostic point")
    print "nogc-nll-flow: recorder, backedge, refill, break, branch and partial-move controls passed"
    0
