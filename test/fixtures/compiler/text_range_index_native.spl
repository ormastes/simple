var RECEIVER_CALLS: i64 = 0

fn source_text() -> text:
    RECEIVER_CALLS = RECEIVER_CALLS + 1
    "abcdef"

fn main() -> i64:
    if source_text()[2..] != "cdef": return 1
    if RECEIVER_CALLS != 1: return 2
    val value = "abcdef"
    if value[1..4] != "bcd": return 3
    if value[..3] != "abc": return 4
    if value[6..] != "": return 5
    if value[2..2] != "": return 6
    val lines: [text] = ["  first", "  second"]
    var combined = ""
    for line in lines:
        combined = combined + line[2..]
    if combined != "firstsecond": return 7
    0
