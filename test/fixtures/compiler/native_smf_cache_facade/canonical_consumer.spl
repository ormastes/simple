use compiler.loader.loader.smf_cache.{MappedSmf, CacheStats, SmfCache, parse_header_minimal}

fn canonical_new_cache() -> SmfCache:
    SmfCache.new()

fn canonical_count(cache: SmfCache) -> i32:
    cache.cached_count()

fn canonical_stats(cache: SmfCache) -> CacheStats:
    cache.get_stats()

fn canonical_record() -> MappedSmf:
    MappedSmf(
        path: "owned.smf", address: 0, size: 4096,
        header: parse_header_minimal([]), section_count: 7, note_sdn: nil,
        template_section_offset: 0, note_sdn_section_offset: 0,
        section_table_offset: 0
    )

fn canonical_sections(record: MappedSmf) -> i32:
    record.section_count
