use compiler.loader.smf_cache.{MappedSmf, CacheStats, SmfCache, bytes_to_u32}
use .canonical_consumer.{canonical_new_cache, canonical_count, canonical_stats, canonical_record, canonical_sections}

fn verify_facade(expected_word: u32) -> i32:
    val empty = SmfCache.new()
    if canonical_count(empty) != 0 or empty.is_cached("owned.smf"):
        return 1
    val from_child: SmfCache = canonical_new_cache()
    if from_child.cached_count() != 0 or not from_child.enabled:
        return 2
    val record: MappedSmf = canonical_record()
    if canonical_sections(record) != 7 or record.path != "owned.smf":
        return 3
    val cache = SmfCache(
        cached_files: {"owned.smf": record}, enabled: true,
        stats: CacheStats(total_files: 1, total_memory: 4096, cache_hits: 7, cache_misses: 2)
    )
    if canonical_count(cache) != 1 or not cache.is_cached("owned.smf"):
        return 4
    val stats: CacheStats = canonical_stats(cache)
    if stats.total_files != 1 or stats.total_memory != 4096:
        return 5
    if stats.cache_hits != 7 or stats.cache_misses != 2:
        return 6
    if bytes_to_u32([1u8, 2u8, 3u8, 4u8]) != expected_word:
        return 7
    if bytes_to_u32([1u8, 2u8, 3u8]) != 0u32:
        return 8
    print "smf-cache-facade checks=8 PASS"
    0
