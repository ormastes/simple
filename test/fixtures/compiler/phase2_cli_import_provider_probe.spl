use compiler.backend.common.c_abi_type_mapping.{c_abi_map_type, c_backend_map_type}
use compiler.mir.mir_types.{MirType, MirTypeKind}
use app.devhub.version_manifest.{_version_value}

fn main() -> i64:
    if not (c_abi_map_type(MirType.i64()) == "int64_t"):
        return 1
    if not (c_backend_map_type(MirType(kind: MirTypeKind.Array(MirType.i64(), 4))) == "spl::Array<int64_t>"):
        return 2
    if not (_version_value("semver: 1.4.2") == "1.4.2"):
        return 3
    if not (_version_value("missing delimiter") == ""):
        return 4
    0
