fn parsed(value: text) -> f64:
    float(value)

fn main() -> i64:
    if parsed("12.5") != 12.5: return 11
    if parsed("-2.5e2") != -250.0: return 12
    if parsed("0.0") != 0.0: return 13
    if f64("3.25") != 3.25: return 14
    if float(42) != 42.0: return 15
    print "FLOAT_TEXT_CAST_PASS"
    0
