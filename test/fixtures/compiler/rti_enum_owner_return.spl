# Regression: enum-owner T must bind the return interface of Poll::unwrap.
enum Poll<T>:
    Ready(T)
    Pending

fn poll_unwrap<T>(poll: Poll<T>) -> T:
    match poll:
        case Poll.Ready(value): value
        case Poll.Pending: panic("Poll is pending")

impl Poll<T>:
    fn unwrap() -> T:
        poll_unwrap(self)

    fn replace<U>(value: U) -> U:
        value

fn main() -> i64:
    val ready: Poll<i64> = Poll.Ready(37)
    val value = ready.unwrap()
    if value != 37: return 1
    if ready.replace(true) != true: return 2
    print "PASS: enum owner return binding preserves actual values"
    0
