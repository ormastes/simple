# REQ-IM-007 / REQ-FORMAL-OWNER: exercise the production artifact owner.
# This native diagnostic does not replace concurrent or SPipe qualification.
use lib.compiler_artifact_service.profile.{artifact_service_profile_v1}
use lib.compiler_artifact_service.protocol.{ArtifactResultV1}
use lib.compiler_artifact_service.service.{ArtifactServiceV1, ArtifactRequestV1, ArtifactLeaseV1, ArtifactRequestStateV1, artifact_service_enqueue_v1, artifact_service_claim_v1, artifact_service_complete_v1}

fn queued_service() -> ArtifactServiceV1:
    val profile = artifact_service_profile_v1("authority-probe", "compiler-probe", ["parse"], 0, true)
    artifact_service_enqueue_v1(ArtifactServiceV1(profile, []),
        ArtifactRequestV1("action-a", "compiler-probe", "generation-a", 1, 1024))

fn success_result(action: text) -> ArtifactResultV1:
    ArtifactResultV1(action, "compiler-probe", "generation-a", "artifact-a", [], true, false, "")

fn main() -> i64:
    val queued = queued_service()
    if queued.entries.len() != 1: return 10
    if queued.entries[0].state != ArtifactRequestStateV1.queued: return 11
    val leased = artifact_service_claim_v1(queued, "owner-a", "lease-a", 7, 2048, -1)
    if leased.entries[0].state != ArtifactRequestStateV1.leased: return 12
    val owner = ArtifactLeaseV1("lease-a", "action-a", "owner-a", 7, false)

    # An action B result has no authority over action A's live publisher.
    val foreign = artifact_service_complete_v1(leased, owner, success_result("action-b"))
    if foreign.entries[0].state != ArtifactRequestStateV1.leased: return 20
    if foreign.entries[0].cas_artifact_digest != "": return 21
    val after_foreign = artifact_service_complete_v1(foreign, owner, success_result("action-a"))
    if after_foreign.entries[0].state != ArtifactRequestStateV1.completed: return 22
    if after_foreign.entries[0].cas_artifact_digest != "artifact-a": return 23

    # A stale owner cannot invalidate the current lease or its eventual result.
    val stale = ArtifactLeaseV1("lease-old", "action-a", "owner-old", 6, false)
    val unchanged = artifact_service_complete_v1(leased, stale, success_result("action-a"))
    if unchanged.entries[0].state != ArtifactRequestStateV1.leased: return 30
    if unchanged.entries[0].lease.unwrap().generation != 7: return 31
    if unchanged.entries[0].cas_artifact_digest != "": return 32
    val after_stale = artifact_service_complete_v1(unchanged, owner, success_result("action-a"))
    if after_stale.entries[0].state != ArtifactRequestStateV1.completed: return 33

    # A second caller cannot acquire a second publisher for the same action.
    val second = artifact_service_claim_v1(leased, "owner-b", "lease-b", 8, 2048, -1)
    if second.entries.len() != 1: return 40
    if second.entries[0].lease.unwrap().owner_id != "owner-a": return 41
    if second.entries[0].lease.unwrap().generation != 7: return 42
    if queued.entries[0].state != ArtifactRequestStateV1.queued: return 43
    print "artifact service authority: wrong action, stale lease, duplicate claim, immutable input passed"
    0
