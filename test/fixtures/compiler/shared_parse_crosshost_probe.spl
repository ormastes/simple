# Compiled native host fixture; launch through the SOSIX capacity owner.
# An exit-zero receipt is valid only with external process/host, binary lineage,
# authority, cold private-cache and exact STORE/HIT cell witnesses.
use std.nogc_sync_mut.io_runtime.{env_get_opt, env_set}
use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded}
use std.nogc_sync_mut.io.dir_ops.{dir_is_real_no_follow}
use std.nogc_sync_mut.io.process_ops.{eprint}
use std.nogc_async_mut.sosix.directory_roots_v1.{sosix_directory_pair_check_v1,
    sosix_directory_pair_open_v1, sosix_directory_pair_identity_v1,
    sosix_directory_pair_close_v1}
use std.common.crypto.sha256.{sha256_text}
use std.common.storage_roots.{CanonicalPath}
use std.nogc_sync_mut.storage_roots.path_policy.{validate_storage_containment}
use compiler.common.config.{Logger}
use compiler.driver.driver_build.incremental.{native_build_frontend_portable_source_digest_v1}
use compiler.frontend.frontend.{parse_full_frontend_target_receipted_v1}
use compiler.frontend.frontend_target_cfg_receipt_v1.{frontend_cfg_receipt_valid_v1,
    frontend_cfg_target_from_triple_v1, frontend_cfg_portable_parse_identity_v1}
use compiler.core.parser_preprocessor.{_pp_preprocess_conditionals_target_receipted_v1}
use compiler.frontend.frontend_shared_parse_cas_v1.{frontend_shared_parse_logical_path_v1,
    frontend_shared_parse_key_v1, frontend_shared_parse_feature_identity_v1,
    frontend_shared_parse_load_v1}
use compiler.frontend.flat_ast_bridge.{flat_parse_module_body_calls}
use compiler.frontend.parser_types_expr.{StmtKind, ExprKind}

fn required_environment(name: text) -> text:
    val value = env_get_opt(name) ?? ""
    if value == "": panic("missing required probe input: {name}")
    value

# This lexical guard supplements, and cannot replace, SOSIX's canonical root
# receipts: mount aliases, hard links and reparse ancestry require host proof.
fn probe_root_spelling(path: text) -> text:
    var normalized = path.replace("\\", "/")
    if normalized.contains("..") or normalized.contains("//") or
            normalized.contains("\0") or normalized.contains("\n") or
            normalized.contains("\r") or normalized.contains("\t"):
        panic("probe root has ambiguous path components")
    while normalized.ends_with("/"):
        normalized = normalized.substring(0, normalized.len() - 1)
    if normalized.contains(":"): normalized.to_lower() else: normalized

fn require_nofollow_probe_root(path: text):
    # Check every existing ancestor, including Windows junction/reparse nodes.
    # Native Windows rt_path_absolute is _fullpath, so storage containment alone
    # cannot establish canonical directory identity. Mount/SUBST aliases remain
    # a separate mandatory host-root admission gate.
    val normalized = path.replace("\\", "/")
    val windows = normalized.len() > 2 and normalized.substring(1, 3) == ":/"
    if not windows and not normalized.starts_with("/"):
        panic("probe roots must be absolute")
    var prefix = if windows: normalized.substring(0, 3) else: "/"
    if not dir_is_real_no_follow(prefix): panic("probe root volume is unavailable")
    val start = if windows: 3 else: 1
    for segment in normalized.substring(start).split("/"):
        if segment == "" or segment == "." or segment == "..":
            panic("probe root has noncanonical components")
        prefix = prefix + (if prefix.ends_with("/"): "" else: "/") + segment
        if not dir_is_real_no_follow(prefix):
            panic("probe root ancestor is missing or is a reparse/link node")
    # This child is only a validation path; it is not written.
    val admitted = validate_storage_containment(CanonicalPath(value: path),
        CanonicalPath(value: path + "/shared-cache-probe-admission"))
    if not admitted.is_ok(): panic("probe root failed storage containment admission")

fn probe_source_for_case(kind: text) -> text:
    if kind == "portable": return "fn portable_answer() -> i64:\n    73\n"
    if kind == "source-change": return "fn portable_answer() -> i64:\n    74\n"
    if kind == "target-cfg":
        return "@cfg(windows)\nfn portable_answer() -> i64:\n    74\n" +
            "@cfg(linux)\nfn portable_answer() -> i64:\n    75\n"
    panic("probe case must be portable, source-change or target-cfg")

fn main() -> i64:
    val mode = required_environment("SIMPLE_SHARED_PARSE_PROBE_MODE")
    if mode != "publish" and mode != "consume" and mode != "reparse" and mode != "mutate":
        panic("probe mode must be publish, consume, reparse or mutate")
    if (env_get_opt("SIMPLE_BOOTSTRAP") ?? "") == "1":
        panic("bootstrap mode cannot prove shared parse admission")
    if (env_get_opt("SIMPLE_FRONTEND_CACHE") ?? "") == "0":
        panic("private frontend cache must be enabled")
    val private_scope = required_environment("SIMPLE_FRONTEND_CACHE_SCOPE")
    val private_dir = required_environment("SIMPLE_FRONTEND_CACHE_DIR")
    val shared_root = required_environment("SIMPLE_SHARED_PARSE_CAS_ROOT")
    val private_spelling = probe_root_spelling(private_dir)
    val shared_spelling = probe_root_spelling(shared_root)
    if private_spelling == "" or shared_spelling == "" or
            private_spelling == shared_spelling or
            private_spelling.starts_with(shared_spelling + "/") or
            shared_spelling.starts_with(private_spelling + "/"):
        panic("private frontend root overlaps shared root")
    val root_status = sosix_directory_pair_check_v1(shared_root, private_dir)
    if root_status != 0: panic("native root admission failed: {root_status}")
    val root_token = sosix_directory_pair_open_v1(shared_root, private_dir)
    if root_token <= 0: panic("native root identity failed: {root_token}")
    val roots = sosix_directory_pair_identity_v1(root_token).unwrap()
    print "SHARED_PARSE_PROBE_ROOTS shared_fs={roots.shared.filesystem_id} shared_object={roots.shared.object_id_low} private_fs={roots.private_root.filesystem_id} private_object={roots.private_root.object_id_low} generation={roots.generation}"
    if sosix_directory_pair_close_v1(root_token) != 0: panic("native root receipt close failed")
    require_nofollow_probe_root(private_dir)
    require_nofollow_probe_root(shared_root)
    val root = required_environment("SIMPLE_SHARED_PARSE_SOURCE_ROOT")
    val authority = required_environment("SIMPLE_SHARED_PARSE_SOURCE_AUTHORITY_PATH")
    val authority_digest = required_environment("SIMPLE_SHARED_PARSE_SOURCE_AUTHORITY_DIGEST")
    val parser_digest = native_build_frontend_portable_source_digest_v1(
        root, authority, authority_digest)
    if parser_digest.len() != 64: panic("sealed parser source authority rejected")
    if not env_set("SIMPLE_SHARED_PARSE_CAS_PARSER_IDENTITY", parser_digest):
        panic("could not publish admitted parser identity")
    if not env_set("SIMPLE_SHARED_PARSE_CAS_TRACE", "1"):
        panic("could not enable cache evidence trace")
    val filename = required_environment("SIMPLE_SHARED_PARSE_PROBE_SOURCE")
    val logical = frontend_shared_parse_logical_path_v1(filename)
    if logical == "": panic("probe source must have a portable logical path")
    val source = file_read_regular_no_follow_bounded(filename, 4096).unwrap()
    val kind = required_environment("SIMPLE_SHARED_PARSE_PROBE_CASE")
    if source != probe_source_for_case(kind):
        panic("probe source differs from its semantic oracle")
    val target = required_environment("SIMPLE_SHARED_PARSE_PROBE_TARGET")
    val target_parts = frontend_cfg_target_from_triple_v1(target).unwrap()
    val preprocessed = _pp_preprocess_conditionals_target_receipted_v1(
        source, target_parts.0, target_parts.1).unwrap()
    val target_identity = frontend_cfg_portable_parse_identity_v1(
        preprocessed.source, preprocessed.decisions)
    val features = frontend_shared_parse_feature_identity_v1()
    val key = frontend_shared_parse_key_v1(sha256_text(source),
        sha256_text(preprocessed.source), parser_digest, target_identity, logical, features)
    if key.len() != 64: panic("probe did not derive a complete portable key")
    val reference_key = if mode == "mutate":
        required_environment("SIMPLE_SHARED_PARSE_PROBE_REFERENCE_KEY")
    else: ""
    if mode == "mutate":
        if reference_key.len() != 64 or key == reference_key:
            panic("mutation did not change the original portable key")
        for character in reference_key:
            if not "0123456789abcdef".contains(character):
                panic("mutation reference is not a canonical digest")
    eprint("SHARED_PARSE_PROBE_PHASE\tbegin=preload")
    val previous_cell = frontend_shared_parse_load_v1(sha256_text(source),
        preprocessed.source, target_identity, filename)
    eprint("SHARED_PARSE_PROBE_PHASE\tend=preload")
    if mode == "consume" and previous_cell == "":
        panic("consume requires an admitted shared cell before frontend execution")
    if (mode == "publish" or mode == "mutate") and previous_cell != "":
        panic("publication requires a previously absent shared address")
    eprint("SHARED_PARSE_PROBE_PHASE\tbegin=frontend")
    val before = flat_parse_module_body_calls()
    val parsed = parse_full_frontend_target_receipted_v1(source, filename,
        "shared_parse_crosshost_probe", Logger(level: 0), logical,
        sha256_text(source), target).unwrap()
    val parse_calls = flat_parse_module_body_calls() - before
    eprint("SHARED_PARSE_PROBE_PHASE\tend=frontend")
    val expected_calls = if mode == "consume": 0 else: 1
    if parse_calls != expected_calls:
        panic("unexpected parser work: mode={mode} calls={parse_calls}")
    if not frontend_cfg_receipt_valid_v1(parsed[1], logical, sha256_text(source), target):
        panic("target cfg receipt does not bind the parsed input")
    val module = parsed[0]
    if module.functions.len() != 1: panic("hydration retained foreign functions")
    val function = module.functions["portable_answer"]
    if function.name != "portable_answer" or function.body.stmts.len() != 1:
        panic("hydrated function shape differs")
    val expected_value = if kind == "source-change": 74
        elif kind == "target-cfg" and target_parts.0 == "windows": 74
        elif kind == "target-cfg" and target_parts.0 == "linux": 75
        else: 73
    match function.body.stmts[0].kind:
        case StmtKind.Expr(expression):
            match expression.kind:
                case ExprKind.IntLit(value):
                    if value != expected_value: panic("hydrated return value differs")
                case _: panic("hydrated body is not an integer literal")
        case _: panic("hydrated body is not an expression statement")
    if mode == "publish" or mode == "mutate":
        eprint("SHARED_PARSE_PROBE_PHASE\tbegin=readback")
        val published = frontend_shared_parse_load_v1(sha256_text(source),
            preprocessed.source, target_identity, filename)
        eprint("SHARED_PARSE_PROBE_PHASE\tend=readback")
        if published == "": panic("frontend parsed but failed to publish a shared cell")
    print "SHARED_PARSE_PROBE\tmode={mode}\tcase={kind}\tparse_calls={parse_calls}\tvalue={expected_value}\tkey={key}\treference_key={reference_key}\tpath={logical}\tsource_sha256={sha256_text(source)}\tinput_sha256={sha256_text(preprocessed.source)}\tparser_sha256={parser_digest}\tcfg_sha256={target_identity}\tfeatures_sha256={features}\tauthority_sha256={authority_digest}\ttarget={target}\tprivate_scope={private_scope}"
    0
