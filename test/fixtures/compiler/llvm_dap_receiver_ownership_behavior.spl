use std.editor.services.debug_session_dap.{EditorDebugDapClient}

fn main():
    var client = EditorDebugDapClient.new()
    if client.is_process_backed():
        panic("unexpected process-backed client")
    client.start()
    if client.send_request("initialize", "{}") != 1:
        panic("unexpected DAP sequence")
    print("DAP-OWNERSHIP-PASS")
