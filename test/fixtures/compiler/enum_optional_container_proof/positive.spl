struct Record:
    value: i64

enum Payload:
    Records([Record?])

fn main() -> i64:
    val nonempty: [Record?] = [Some(Record(value: 7)), nil]
    val empty: [Record?] = []
    val first = Payload.Records(nonempty)
    val second = Payload.Records(empty)
    match first:
        case Payload.Records(values):
            assert values.len() == 2
        case _: return 2
    match second:
        case Payload.Records(values):
            assert values.len() == 0
        case _: return 4
    print "enum optional container language proof: 2 guards passed"
    0
