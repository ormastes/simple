struct Record:
    value: i64

enum Payload:
    Records([Record?])

fn main() -> i64:
    val nonempty: [Record?] = [Some(Record(value: 7)), nil]
    val empty: [Record?] = []
    val first = Payload.Records(nonempty)
    val second = Payload.Records(empty)
    match first:
        case Payload.Records(values):
            if values.len() != 2: return 1
        case _: return 2
    match second:
        case Payload.Records(values):
            if values.len() != 0: return 3
        case _: return 4
    0
