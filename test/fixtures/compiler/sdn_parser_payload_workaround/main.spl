use std.common.sdn.parser.{parse}
use std.common.sdn.value.{SdnValue}

fn int_is(value: SdnValue, expected: i64) -> bool:
    match value:
        case Int(actual): actual == expected
        case _: false

fn pair_is(value: SdnValue) -> bool:
    match value:
        case Dict(entries):
            if entries.keys().len() != 1: return false
            if not entries.contains_key("answer"): return false
            int_is(entries["answer"], 42)
        case _: false

fn sequence_is(value: SdnValue) -> bool:
    match value:
        case Array(items):
            if items.len() != 2: return false
            pair_is(items[0]) and pair_is(items[1])
        case _: false

fn main() -> i64:
    match parse("{}"):
        case Ok(value):
            match value:
                case Dict(entries):
                    if entries.keys().len() != 0: return 1
                case _: return 2
        case Err(_): return 3
    match parse("{answer: 42}"):
        case Ok(value):
            if not pair_is(value): return 4
        case Err(_): return 5
    match parse("answer: 42"):
        case Ok(value):
            if not pair_is(value): return 6
        case Err(_): return 7
    match parse("- answer: 42\n- answer: 42"):
        case Ok(value):
            if not sequence_is(value): return 8
        case Err(_): return 9
    match parse("items:\n  - answer: 42\n  - answer: 42"):
        case Ok(value):
            match value:
                case Dict(entries):
                    if not entries.contains_key("items"): return 10
                    if not sequence_is(entries["items"]): return 11
                case _: return 12
        case Err(_): return 13
    print "sdn_parser_payload_workaround: PASS"
    0
