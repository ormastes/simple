use compiler.driver.driver_streaming_surface_policy.{
    driver_low_memory_streaming_requested_values,
    driver_streaming_surface_route_values}

# Standalone native acceptance for the pure policy owner. This exercises real
# source on an admitted producer when the complete SSpec runner is unavailable;
# it does not qualify full CLI memory or substitute for the complete tool suite.
fn main() -> i64:
    val requested = driver_low_memory_streaming_requested_values(
        true, true, true, false, true, false)
    if not requested: return 1
    if driver_streaming_surface_route_values(
        requested, true, true, false, true, false) != 1: return 2
    if driver_low_memory_streaming_requested_values(
        false, true, true, false, true, false): return 3
    if driver_low_memory_streaming_requested_values(
        true, false, true, false, true, false): return 4
    if driver_low_memory_streaming_requested_values(
        true, true, false, false, true, false): return 5
    if driver_low_memory_streaming_requested_values(
        true, true, true, true, true, false): return 6
    if driver_low_memory_streaming_requested_values(
        true, true, true, false, false, false): return 7
    if driver_low_memory_streaming_requested_values(
        true, true, true, false, true, true): return 8
    if driver_streaming_surface_route_values(
        true, true, true, true, true, false) != -3: return 9
    if driver_streaming_surface_route_values(
        true, true, true, false, false, false) != -4: return 10
    if driver_streaming_surface_route_values(
        true, true, true, false, true, true) != -5: return 11
    print "low-memory streaming policy: 11 checks passed"
    0
