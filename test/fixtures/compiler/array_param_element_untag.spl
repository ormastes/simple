# Fixture: element reads off an ARRAY PARAMETER must decode identically under
# the tree-walk interpreter and the Cranelift JIT.
#
# Defect this pins (doc/08_tracking/bug/interp_array_param_indexing_2026-07-03.md):
# under SIMPLE_EXECUTION_MODE=jit every int element read off a function
# PARAMETER came back multiplied by 8 -- the tag-boxed word `v << 3` with the
# 3-bit untag never applied. Reading the SAME array in its defining frame was
# correct, so the divergence is purely a function-boundary effect.
#
# HARNESS RULE: every probe below MUST live inside a `fn` body. A probe at TOP
# LEVEL of a script body runs INTERPRETED regardless of any engine pin and
# therefore proves nothing about the JIT lane. `ctl()` is the engine-identity
# control: 2^60 cannot survive the `v << 3` boxing intact, so the two arms
# print DIFFERENT values for it. If `ctl` agrees across the two arms the JIT
# arm did not actually compile and the run is UNVERIFIED, not a pass.

fn ctl() -> i64:
    val big = 1152921504606846976
    return big

fn bare(a: Array<i64>) -> i64:
    return a.get(0)

fn bracket(a: Array<i64>) -> i64:
    return a[0]

fn unannotated(a) -> i64:
    return a.get(0)

fn sum3(a: Array<i64>) -> i64:
    return a.get(0) + a.get(1) + a.get(2)

fn plus1(a: Array<i64>) -> i64:
    return a.get(0) + 1

fn times2(a: Array<i64>) -> i64:
    return a.get(0) * 2

fn rsub(a: Array<i64>) -> i64:
    return 100 - a.get(0)

# ANY-operand ORIENTATION matrix. Measured 2026-08-17 against a build of current
# HEAD: an op with a CONCRETE left and an ANY right returns a tag-boxed result,
# while ANY-on-the-left and ANY-on-both-sides are correct. `rsub` above happened
# to be the only orientation the first version of this fixture covered, which
# made a whole-family defect look Sub-specific. All four ops are affected.

fn any_left_add(a: Array<i64>) -> i64:
    return a.get(0) + 1

fn any_right_add(a: Array<i64>) -> i64:
    return 1 + a.get(0)

fn any_left_sub(a: Array<i64>) -> i64:
    return a.get(0) - 1

fn any_right_mul(a: Array<i64>) -> i64:
    return 2 * a.get(0)

fn any_right_div(a: Array<i64>) -> i64:
    return 100 / a.get(0)

fn any_both_sub(a: Array<i64>) -> i64:
    return a.get(1) - a.get(0)

fn len_of(a: Array<i64>) -> i64:
    return a.len()

fn hop2(a: Array<i64>) -> i64:
    return a.get(0)

fn hop1(a: Array<i64>) -> i64:
    return hop2(a)

fn local_read() -> i64:
    val a = [10, 20, 30]
    return a.get(0)

fn main():
    val arr = [10, 20, 30]
    print("ctl=" + ctl().to_string())
    print("bare=" + bare(arr).to_string())
    print("bracket=" + bracket(arr).to_string())
    print("unannotated=" + unannotated(arr).to_string())
    print("sum3=" + sum3(arr).to_string())
    print("plus1=" + plus1(arr).to_string())
    print("times2=" + times2(arr).to_string())
    print("rsub=" + rsub(arr).to_string())
    print("len_of=" + len_of(arr).to_string())
    print("hop1=" + hop1(arr).to_string())
    print("local_read=" + local_read().to_string())
    print("any_left_add=" + any_left_add(arr).to_string())
    print("any_right_add=" + any_right_add(arr).to_string())
    print("any_left_sub=" + any_left_sub(arr).to_string())
    print("any_right_mul=" + any_right_mul(arr).to_string())
    print("any_right_div=" + any_right_div(arr).to_string())
    print("any_both_sub=" + any_both_sub(arr).to_string())
