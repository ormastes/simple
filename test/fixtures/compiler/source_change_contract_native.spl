# @workaround bug=source_change_inferred_return_field_layout_2026_10_11 reason=explicit return-type import/control keeps the producer ABI failure visible.
use std.common.source_change.contracts_v1.{SourceChangeShapeV1}
use test.fixtures.compiler.source_change_contract_cases.*

fn main() -> i64:
    val inferred = source_contract_case_v1(0)
    val inferred_ok = inferred.valid and inferred.reason == "well_formed_change_batch"
    if inferred_ok: print("SOURCE_CONTRACT_RETURN_INFERRED_OK")
    else: print("SOURCE_CONTRACT_RETURN_INFERRED_BROKEN")
    var index: i64 = 0
    var passed: i64 = 0
    while index < 16:
        val result: SourceChangeShapeV1 = source_contract_case_v1(index)
        val expected_valid = index < 2
        if result.valid != expected_valid or result.reason != source_contract_expected_reason_v1(index):
            print("SOURCE_CONTRACT_CASE_FAIL")
            print(result.reason)
            print(source_contract_expected_reason_v1(index))
            if result.valid: print("ACTUAL_VALID_TRUE")
            else: print("ACTUAL_VALID_FALSE")
            if expected_valid: print("EXPECTED_VALID_TRUE")
            else: print("EXPECTED_VALID_FALSE")
            return 1
        print("SOURCE_CONTRACT_CASE_PASS")
        passed = passed + 1
        index = index + 1
    if passed != 16:
        return 1
    if not inferred_ok:
        print("SOURCE_CONTRACT_TYPED_RESULTS_PASS_16_INFERENCE_GATE_FAIL")
        return 2
    print("SOURCE_CONTRACT_RESULTS_PASS_16")
    0
