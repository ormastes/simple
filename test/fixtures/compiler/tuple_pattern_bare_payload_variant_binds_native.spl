# In a tuple / payload sub-pattern slot only a UNIT variant name is a variant
# test; a bare name that spells a PAYLOAD variant (`Int` of `Int(bits)`) is a
# BINDER, as in the pure-Simple frontend. The seed tested it as the variant and
# dropped the binding, so `tag(Int)` below failed to compile ("unresolved
# identifier 'Int'"). A top-level bare payload-variant arm (`case Int:`) stays
# the payload-ignoring variant test on both lanes.
# Bug: doc/08_tracking/bug/seed_tuple_pattern_bare_fieldless_variant_binds_hir_types_equal_true_2026-11-12.md
enum Kind:
    Int(bits: i64)
    Str

fn tag(k: Kind) -> i64:
    match k:
        case Kind.Int(_): 1
        case Kind.Str: 2

fn slot_binder(a: Kind, b: Kind) -> i64:
    match (a, b):
        case (Int, _): 10 + tag(Int)
        case _: 0

# Negative: a UNIT variant in the same slot is still tested.
fn slot_unit(a: Kind, b: Kind) -> i64:
    match (a, b):
        case (Str, _): 1
        case _: 0

fn top_level(k: Kind) -> i64:
    match k:
        case Int: 1
        case Str: 2

fn main() -> i64:
    if slot_binder(Kind.Str, Kind.Str) != 12: return 1
    if slot_binder(Kind.Int(3), Kind.Str) != 11: return 2
    if slot_unit(Kind.Int(3), Kind.Str) != 0: return 3
    if slot_unit(Kind.Str, Kind.Int(3)) != 1: return 4
    if top_level(Kind.Str) != 2: return 5
    if top_level(Kind.Int(3)) != 1: return 6
    print "tuple_pattern_bare_payload_variant_binds: ok"
    0
