# Actual native qualification entry; no seed/test-runner fallback.
struct Roots:
    path: text
    generation: i64

struct Resolution:
    roots: Roots

struct Failure:
    code: i64

struct PublicError:
    reason: i64

fn visit_resolution(value: Resolution, calls: [i64]) -> Roots:
    calls[0] = calls[0] + 1
    value.roots

fn visit_error(value: Failure, calls: [i64]) -> PublicError:
    calls[0] = calls[0] + 1
    PublicError(reason: value.code + 1)

fn main() -> i64:
    val calls = [0]
    val errors = [0]
    val good: Result<Resolution, Failure> = Ok(Resolution(roots: Roots(path: "root", generation: 41)))
    val bad: Result<Resolution, Failure> = Err(Failure(code: 17))
    val mapped = good.map(\r: visit_resolution(r, calls))
    if calls[0] != 1:
        return 1
    val roots = mapped.unwrap()
    if roots.path != "root" or roots.generation != 41:
        return 2
    val untouched = bad.map(\r: visit_resolution(r, calls))
    if calls[0] != 1 or untouched.unwrap_err().code != 17:
        return 3
    val shorthand = good.map(_.roots).unwrap()
    if shorthand.path != "root" or shorthand.generation != 41:
        return 4
    val changed_error = bad.map_err(\e: visit_error(e, errors))
    if errors[0] != 1 or changed_error.unwrap_err().reason != 18:
        return 5
    val untouched_good = good.map_err(\e: visit_error(e, errors))
    if errors[0] != 1 or untouched_good.unwrap().roots.generation != 41:
        return 6
    val primitive: Result<i64, text> = Ok(5)
    if primitive.map(\x: x + 2).unwrap_or(0) != 7:
        return 7
    print "Result record map: PASS"
    0
