# Repro: doc/08_tracking/bug/seed_jit_spl_f64_to_bits_miscompile_2026-07-23.md
# The bits of 3.0 must survive an [i64] store/readback and compare equal, on
# the compiled JIT path (no `hybrid-interp-splice detail=spl_f64_to_bits`).
# Expected: bits=4613937818241073152 readback=4613937818241073152 eq=true
extern fn spl_f64_to_bits(value: f64) -> i64

fn f64_to_bits(v: f64) -> i64:
    return spl_f64_to_bits(v)

fn main():
    val b = f64_to_bits(3.0)
    var arr: [i64] = [0, 0, 0]
    arr[1] = b
    val readback = arr[1]
    print("bits={b} readback={readback} eq={readback == b}")
