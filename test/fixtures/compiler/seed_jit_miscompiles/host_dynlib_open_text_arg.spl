# Repro: doc/08_tracking/bug/seed_jit_host_dynlib_open_text_arg_not_split_2026-11-06.md
# Under the seed JIT, rt_host_dynlib_open / rt_host_dynlib_symbol received the
# boxed text handle as path_ptr and the next argument as path_len, so every open
# returned 0. The interpreter split (ptr, len) correctly.
# Expected: open_ok=true sym_ok=true
extern fn rt_host_dynlib_open(path: text, mode: i64) -> i64
extern fn rt_host_dynlib_symbol(handle: i64, name: text) -> i64
extern fn rt_host_dynlib_close(handle: i64) -> i64

fn main():
    var handle = rt_host_dynlib_open("kernel32.dll", 2)
    var symbol_name = "GetTickCount"
    if handle <= 0:
        handle = rt_host_dynlib_open("libc.so.6", 2)
        symbol_name = "getpid"
    print("open_ok={handle > 0}")
    val symbol = rt_host_dynlib_symbol(handle, symbol_name)
    print("sym_ok={symbol > 0}")
    if handle > 0:
        rt_host_dynlib_close(handle)
