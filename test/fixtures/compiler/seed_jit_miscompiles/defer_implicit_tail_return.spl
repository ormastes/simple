# Repro: doc/08_tracking/bug/seed_mir_defer_clobbers_implicit_tail_return_2026-11-06.md
# A function with `defer` returned the deferred call's result instead of its
# implicit tail value under the seed JIT: `run_int()` gave 0 and a struct
# return became a null handle (SIGSEGV on first field read).
# Expected: rel / int=42 / rel / ok=true reason=handled
class Res:
    ok: bool
    reason: text

fn rel():
    print("rel")

fn run_int() -> i64:
    defer rel()
    val r = 41 + 1
    r

fn run_struct() -> Res:
    defer rel()
    val r = Res(ok: true, reason: "handled")
    r

fn main():
    print("int={run_int()}")
    val outcome = run_struct()
    print("ok={outcome.ok} reason={outcome.reason}")
