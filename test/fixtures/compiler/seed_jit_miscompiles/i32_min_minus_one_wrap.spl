# Repro: doc/08_tracking/bug/seed_i32_overflow_interp_vs_jit_divergence_2026-11-05.md
# Narrow integer arithmetic must wrap to its declared width on every edge, not
# only when the result is stored into a typed local.
# Expected (interpreter, and JIT after the fix):
#   i32_max_plus_1 -2147483648
#   i32_min_minus_1 2147483647
#   rev -2147483647 u 4294967295 s 32767 b 0
fn main():
    val m: i32 = 2147483647
    val n = m + 1
    print("i32_max_plus_1 " + n.to_text())
    val k: i32 = -2147483648
    print("i32_min_minus_1 " + (k - 1).to_text())
    val u: u32 = 0
    val s: i16 = -32768
    val b: u8 = 255
    print("rev {1 - k} u {u - 1} s {s - 1} b {b + 1}")
