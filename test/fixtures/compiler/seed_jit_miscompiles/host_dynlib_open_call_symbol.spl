# Repro: doc/08_tracking/bug/seed_rt_host_dynlib_open_returns_zero_2026-11-13.md
# dlopen a clang-built shared library (path = last argv), resolve one symbol,
# and call it. A seed built before be65da720dd passes the boxed text handle as
# path_ptr under the JIT, so every open returns 0.
# Driven by scripts/check/check-host-dynlib-open-call.shs, which builds
#   long long dynlib_probe_add(long long a, long long b) { return a + b + 1000; }
# Expected: open_ok=true sym_ok=true call=1042 close=0
extern fn rt_host_dynlib_open(path: text, mode: i64) -> i64
extern fn rt_host_dynlib_symbol(handle: i64, name: text) -> i64
extern fn rt_host_dynlib_close(handle: i64) -> i64
extern fn spl_wffi_call_i64(fptr: i64, args: [i64], nargs: i64) -> i64
extern fn sys_get_args() -> [text]

fn main():
    val args = sys_get_args()
    val path = args[args.len() - 1]
    val handle = rt_host_dynlib_open(path, 2)
    print("open_ok={handle > 0}")
    val symbol = rt_host_dynlib_symbol(handle, "dynlib_probe_add")
    print("sym_ok={symbol > 0}")
    if handle > 0 and symbol > 0:
        print("call={spl_wffi_call_i64(symbol, [20, 22], 2)}")
        print("close={rt_host_dynlib_close(handle)}")
