# Repro: doc/08_tracking/bug/seed_jit_untyped_to_u8_push_double_untag_2026-10-18.md
# A native scalar pushed onto an erased (Any) array must read back unchanged.
# Expected: u8=[99] i64=[99] footer=[120, 86]
fn push_u8(bs, v: i64) -> [Any]:
    var bytes = bs[0]
    bytes.push(v.to_u8())
    return [bytes]

fn push_i64(bs, v: i64) -> [Any]:
    var words = bs[0]
    words.push(v)
    return [words]

fn footer(crc, size) -> [u8]:
    var out: [u8] = []
    out.push((crc & 255).to_u8())
    out.push((size & 255).to_u8())
    out

fn main():
    var e1: [u8] = []
    var e2: [i64] = []
    val r1 = push_u8([e1], 99)
    val r2 = push_i64([e2], 99)
    print "u8={r1[0]} i64={r2[0]} footer={footer(0x12345678, 0x56)}"
