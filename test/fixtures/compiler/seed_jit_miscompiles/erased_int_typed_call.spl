# Repro: doc/08_tracking/bug/seed_jit_erased_int_not_unboxed_at_typed_call_2026-11-04.md
# An erased (Any) int passed into a typed `i64` parameter must arrive untagged.
# Expected: any=1000 sum=1589 list=1589 tup=1589
fn modq(x: i64) -> i64:
    x % 3329

fn pair() -> [Any]:
    return [1000, 589]

fn via_list(xs) -> i64:
    val fj = xs.get(0)
    val t = xs.get(1)
    modq(fj + t)

fn tup():
    (1000, 589)

fn main():
    val ci = pair()
    val (p, q) = tup()
    print "any={modq(ci[0])} sum={modq(ci[0] + ci[1])} list={via_list([1000, 589])} tup={modq(p + q)}"
