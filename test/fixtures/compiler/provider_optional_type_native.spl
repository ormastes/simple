# Actual production relocation calls for optional collection type metadata.
extern fn rt_exit(code: i64)
use compiler.common.diagnostics.span.Span
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolTable}
use compiler.hir.hir_definitions.{HirExpr, HirExprKind}
use compiler.mir.mir_lowering.MirLowering
use compiler.mir._MirLowering.provider_metadata.*

fn provider_optional_require_type(type_: HirType):
    val kind: HirTypeKind = type_.kind
    match kind:
        case Int(bits, signed):
            if bits != 32 or not signed: rt_exit(21)
        case _: rt_exit(22)
    if type_.span.start != 10 or type_.span.end != 14: rt_exit(23)
    if type_.span.line != 3 or type_.span.col != 5: rt_exit(24)
    if type_.span.file != "provider_optional.spl" or type_.span.length != 4: rt_exit(25)

fn provider_optional_require_literal(expr: HirExpr, expected: i64):
    val kind: HirExprKind = expr.kind
    match kind:
        case IntLit(value, _):
            if value != expected: rt_exit(26)
        case _: rt_exit(27)

fn main() -> i64:
    val span = Span(start: 10, end: 14, line: 3, col: 5,
        file: "provider_optional.spl", length: 4)
    val type_ = HirType(kind: HirTypeKind.Int(32, true), span: span)
    val one = HirExpr(kind: HirExprKind.IntLit(1, nil), has_type_: true, type_: type_, span: span)
    val seven = HirExpr(kind: HirExprKind.IntLit(7, nil), has_type_: true, type_: type_, span: span)
    val provider = SymbolTable.new()
    var lowering = MirLowering.new(SymbolTable.new())

    val array_some = HirExpr(kind: HirExprKind.ArrayLit([seven], Some(type_)),
        has_type_: false, type_: type_, span: span)
    val array_some_result = lowering.relocate_provider_default(array_some, provider, {})
    val array_some_kind: HirExprKind = array_some_result.kind
    match array_some_kind:
        case ArrayLit(items, metadata):
            if items.len() != 1: rt_exit(1)
            provider_optional_require_literal(items[0], 7)
            val option: HirType? = metadata
            if val concrete = option:
                val present: HirType = concrete
                provider_optional_require_type(present)
            else: rt_exit(2)
        case _: rt_exit(3)

    val array_none = HirExpr(kind: HirExprKind.ArrayLit([], nil),
        has_type_: false, type_: type_, span: span)
    val array_none_result = lowering.relocate_provider_default(array_none, provider, {})
    val array_none_kind: HirExprKind = array_none_result.kind
    match array_none_kind:
        case ArrayLit(items, metadata):
            if items.len() != 0 or metadata != nil: rt_exit(4)
        case _: rt_exit(5)

    val dict_some = HirExpr(kind: HirExprKind.DictLit([(one, seven)], type_, Some(type_)),
        has_type_: false, type_: type_, span: span)
    val dict_some_result = lowering.relocate_provider_default(dict_some, provider, {})
    val dict_some_kind: HirExprKind = dict_some_result.kind
    match dict_some_kind:
        case DictLit(entries, key_type, metadata):
            if entries.len() != 1: rt_exit(6)
            val entry: (HirExpr, HirExpr) = entries[0]
            provider_optional_require_literal(entry.0, 1)
            provider_optional_require_literal(entry.1, 7)
            provider_optional_require_type(key_type)
            val option: HirType? = metadata
            if val concrete = option:
                val present: HirType = concrete
                provider_optional_require_type(present)
            else: rt_exit(7)
        case _: rt_exit(8)

    val dict_none = HirExpr(kind: HirExprKind.DictLit([], type_, nil),
        has_type_: false, type_: type_, span: span)
    val dict_none_result = lowering.relocate_provider_default(dict_none, provider, {})
    val dict_none_kind: HirExprKind = dict_none_result.kind
    match dict_none_kind:
        case DictLit(entries, key_type, metadata):
            if entries.len() != 0 or metadata != nil: rt_exit(9)
            provider_optional_require_type(key_type)
        case _: rt_exit(10)
    # Preserve the existing absent-key guard independently of optional values.
    val dict_nil_key = HirExpr(kind: HirExprKind.DictLit([], nil, nil),
        has_type_: false, type_: type_, span: span)
    val dict_nil_key_result = lowering.relocate_provider_default(dict_nil_key, provider, {})
    val dict_nil_key_kind: HirExprKind = dict_nil_key_result.kind
    match dict_nil_key_kind:
        case DictLit(entries, key_type, metadata):
            if entries.len() != 0 or key_type != nil or metadata != nil: rt_exit(12)
        case _: rt_exit(13)
    if lowering.errors.len() != 0: rt_exit(11)
    print "provider_optional_type_native=PASS cases=5"
    0
