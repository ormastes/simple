"""Execute the current parser source; do not trust producer assertion syntax.

AUTHORED_UNEXECUTED: expect zero only after every explicit guard succeeds.
"""

use std.nogc_sync_mut.io_runtime.{exit}
use compiler.core.parser.{parser_init, parser_has_errors}
use compiler.core.parser_stmts.{parse_statement}
use compiler.core.ast.{stmt_get_expr, expr_get_tag, expr_get_args, expr_get_left, expr_get_str, expr_get_int, EXPR_CALL, EXPR_BOOL_LIT, EXPR_BINARY, EXPR_STRING_LIT}

fn assert_parser_require(condition: bool, message: text):
    if not condition:
        print "assert-parser: FAIL {message}"
        exit(1)

fn assert_parser_parse(source: text) -> [i64]:
    parser_init(source)
    val expression = stmt_get_expr(parse_statement())
    assert_parser_require(expr_get_tag(expression) == EXPR_CALL, "statement is not a call")
    assert_parser_require(expr_get_str(expr_get_left(expression)) == "__assert", "statement did not target raising builtin")
    expr_get_args(expression)

fn assert_parser_reject(source: text):
    assert_parser_parse(source)
    assert_parser_require(parser_has_errors(), "invalid assertion shape was accepted")

fn main() -> i64:
    val arguments = assert_parser_parse("assert(false, \"must fail\")\n")
    assert_parser_require(not parser_has_errors(), "valid parenthesized assertion was rejected")
    assert_parser_require(arguments.len() == 2, "condition and message were not separated")
    assert_parser_require(expr_get_tag(arguments[0]) == EXPR_BOOL_LIT, "condition is not a boolean literal")
    assert_parser_require(expr_get_int(arguments[0]) == 0, "false condition changed value")
    assert_parser_require(expr_get_tag(arguments[1]) == EXPR_STRING_LIT, "message changed expression kind")
    assert_parser_require(expr_get_str(arguments[1]) == "must fail", "message changed value")

    val bare = assert_parser_parse("assert false, \"bare\"\n")
    assert_parser_require(not parser_has_errors(), "bare assertion was rejected")
    assert_parser_require(bare.len() == 2, "bare assertion lost its message")
    assert_parser_require(expr_get_tag(bare[0]) == EXPR_BOOL_LIT, "bare condition changed expression kind")

    val single = assert_parser_parse("assert(false)\n")
    assert_parser_require(not parser_has_errors(), "single parenthesized assertion was rejected")
    assert_parser_require(single.len() == 1, "single assertion changed arity")
    assert_parser_require(expr_get_tag(single[0]) == EXPR_BOOL_LIT, "single condition changed expression kind")

    val grouped = assert_parser_parse("assert (false) or true\n")
    assert_parser_require(not parser_has_errors(), "grouped boolean continuation was rejected")
    assert_parser_require(grouped.len() == 1, "grouped condition changed arity")
    assert_parser_require(expr_get_tag(grouped[0]) == EXPR_BINARY, "grouped boolean continuation was discarded")

    assert_parser_reject("assert()\n")
    assert_parser_reject("assert(false, \"one\", \"two\")\n")
    assert_parser_reject("assert false, \"one\", \"two\"\n")
    assert_parser_reject("assert((false, true), \"tuple\")\n")
    print "assert-parser: separate false condition, compatibility and rejected shapes passed"
    0
