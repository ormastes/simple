use lib.nogc_sync_mut.compression.gzip.huffman.{deflate_fixed_huffman, deflate_fixed_distances, huffman_lookup}

fn main() -> i64:
    val dense = deflate_fixed_huffman()
    val check0 = dense.len() == 288
    print check0
    if not check0:
        return 1
    val check1 = dense[0][1] == 48
    print check1
    if not check1:
        return 2
    val check2 = dense[143][1] == 191
    print check2
    if not check2:
        return 3
    val check3 = dense[144][1] == 400
    print check3
    if not check3:
        return 4
    val check4 = dense[255][1] == 511
    print check4
    if not check4:
        return 5
    val check5 = dense[256][1] == 0
    print check5
    if not check5:
        return 6
    val check6 = dense[279][1] == 23
    print check6
    if not check6:
        return 7
    val check7 = dense[280][1] == 192
    print check7
    if not check7:
        return 8
    val check8 = dense[287][1] == 199
    print check8
    if not check8:
        return 9
    val distances = deflate_fixed_distances()
