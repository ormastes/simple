use compiler.common.driver_core_types.{SourceFile, driver_core_compile_options_default}
use compiler.driver.driver.{CompilerDriver}
use compiler.driver.driver_types.{CompileMode}

fn streaming_source(path: text, content: text, module_name: text) -> SourceFile:
    SourceFile(path: path, content: content, module_name: module_name)

fn main() -> i64:
    var options = driver_core_compile_options_default()
    options.mode = CompileMode.Aot
    options.low_memory = true
    options.backend = "cranelift"
    var driver = CompilerDriver.create(options)
    driver.ctx.sources = [
        streaming_source(
            "build/streaming/first.spl",
            "fn first() -> i64:\n    return 1\n",
            "fixture.first"
        ),
        streaming_source(
            "build/streaming/second.spl",
            "fn second() -> i64:\n    return 2\n",
            "fixture.second"
        )
    ]
    val (phase2_ctx, phase2_ok) = driver.parse_all_streaming_surfaces_impl()
    if not phase2_ok:
        return 21
    if phase2_ctx.errors.len() != 0:
        return 22
    if phase2_ctx.module_surfaces == nil:
        return 23
    val surfaces = phase2_ctx.module_surfaces.unwrap()
    if surfaces.surfaces.len() != 2:
        return 24
    if surfaces.surfaces[0].module_name != "fixture.first":
        return 25
    if surfaces.surfaces[1].module_name != "fixture.second":
        return 26
    print "streaming_ast_mode_slots=true"
    0
