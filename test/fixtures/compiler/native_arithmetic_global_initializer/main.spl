# Native startup must execute the entry module's arithmetic initializer.
# A provider call can initialize its own module lazily, so imported globals
# alone do not test whether the generated entry shim calls module initializers.
use limits.{provider_expression, provider_literal, provider_inline}

val LOCAL_EXPRESSION: i64 = 128 * 1024 * 1024
val LOCAL_LITERAL: i64 = 134217728

fn main() -> i64:
    val inline_value: i64 = 128 * 1024 * 1024
    assert(LOCAL_EXPRESSION == 134217728)
    assert(LOCAL_LITERAL == 134217728)
    assert(inline_value == 134217728)
    assert(provider_expression() == 134217728)
    assert(provider_literal() == 134217728)
    assert(provider_inline() == 134217728)
    print "PASS native arithmetic global initialization: 6 assertions"
    0