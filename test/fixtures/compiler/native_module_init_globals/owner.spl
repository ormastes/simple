pub var numbers: [i64] = []
pub var names: [text] = ["initialized"]

pub fn verify_globals() -> i64:
    if names.len() != 1: return 1
    if names[0] != "initialized": return 2
    numbers.clear()
    numbers.push(7)
    if numbers.len() != 1: return 3
    if numbers[0] != 7: return 4
    names.clear()
    if names.len() != 0: return 5
    0
