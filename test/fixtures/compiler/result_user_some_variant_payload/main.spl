# Prevention for bug native_enum_nil_payload_pattern_2026_10_11: a USER enum that
# names a variant `Some` must keep the discriminant path when nested in Ok(..).
enum Maybe:
    Some(n: i64)
    Nothing

fn user_some(r: Result<Maybe, text>) -> i64:
    match r:
        Ok(Maybe.Some(n)): n
        Ok(Maybe.Nothing): -1
        Err(_): -2

fn main() -> i64:
    if user_some(Ok(Maybe.Some(8))) != 8: return 1
    if user_some(Ok(Maybe.Nothing)) != -1: return 2
    if user_some(Err("e")) != -2: return 3
    print "result_user_some_variant_payload: PASS"
    0
