# Bootstrap diagnostic only: compare runtime identity with the public facade.
# A Rust-seed build of this fixture is not self-hosted acceptance evidence.
use std.sffi.platform.{platform_name_raw}
use std.io_runtime.{host_os, host_arch}

fn accepted_host(os: text) -> bool:
    os == "linux" or os == "macos" or os == "darwin" or os == "windows" or
        os == "windows-mingw" or os == "windows-msvc" or os == "freebsd"

fn main() -> i32:
    val runtime_os = platform_name_raw()
    val detected_os = host_os()
    val architecture = host_arch()
    print "runtime_os={runtime_os}"
    print "host_os={detected_os}"
    print "host_arch={architecture}"
    print "windows_supported={accepted_host(\"windows\")}"
    print "unknown_supported={accepted_host(\"unknown\")}"
    if runtime_os != detected_os:
        return 1
    if not accepted_host(detected_os):
        return 2
    if accepted_host("unknown"):
        return 3
    0
