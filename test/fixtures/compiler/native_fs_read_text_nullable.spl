# Native regression for the Stage2 filesystem facade. Link against the same
# archive as Stage2: it exports rt_file_read_text, not rt_fs_read_text.
use std.nogc_sync_mut.sffi.fs.{fs_read_text}

fn main() -> i64:
    val content = fs_read_text("test/fixtures/compiler/native_fs_read_text_nullable.spl")
    if content == nil:
        return 1
    if not (content ?? "").contains("Native regression for the Stage2 filesystem facade"):
        return 2
    if fs_read_text("test/fixtures/compiler/native_fs_read_text_nullable.spl/absent") != nil:
        return 3
    val empty = fs_read_text("test/fixtures/compiler/native_fs_read_text_empty.txt")
    if empty == nil:
        return 4
    if (empty ?? "unexpected") != "":
        return 5
    print("native fs_read_text: content, missing, empty PASS")
    0
