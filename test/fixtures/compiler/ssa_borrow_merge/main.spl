# Native regression: a borrow must not disable slotting of a mutable merge local.
struct BorrowPayload:
    value: i64

fn read_payload(payload: &BorrowPayload) -> i64:
    payload.value

fn borrow_with_merge(flag: bool) -> i64:
    var payload = BorrowPayload(value: 40)
    val borrowed = read_payload(&payload)
    val extra = if flag: 2 else: 3
    borrowed + extra

fn main() -> i64:
    if borrow_with_merge(true) != 42:
        return 1
    if borrow_with_merge(false) != 43:
        return 2
    print "ssa-borrow-merge: PASS"
    0
