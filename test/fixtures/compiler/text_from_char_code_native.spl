class CodeOwner:
    value: i64

    fn from_char_code(code: i64) -> i64:
        self.value + code

fn main() -> i64:
    if text.from_char_code(65) != "A": return 1
    val code = 937
    if text.from_char_code(code) != "Ω": return 2
    if text.from_char_code(8).len() != 1: return 3
    if text.from_char_code(12).len() != 1: return 4
    if text.from_char_code(-1) != "": return 6
    if text.from_char_code(55296) != "": return 7
    if text.from_char_code(1114112) != "": return 8
    val text = CodeOwner(value: 10)
    if text.from_char_code(3) != 13: return 5
    0
