use std.common.bytes.span.{ByteSpan}

fn main() -> i64:
    val span: ByteSpan = ByteSpan.new([10u8, 20u8, 30u8])
    val prefix: ByteSpan = ByteSpan.new([10u8, 20u8])
    val window: ByteSpan = span.slice(0, 2)
    if not window.equals(prefix): return 1
    if span.starts_with(ByteSpan.new([10u8, 21u8])): return 2
    if not span.starts_with(ByteSpan.empty()): return 3
    print("byte-span-prefix-owner-ok")
    0
