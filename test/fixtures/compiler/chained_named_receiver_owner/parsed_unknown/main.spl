use std.common.bytes.span.{ByteSpan}

struct ForeignSliceOwner:
    value: i64

impl ForeignSliceOwner:
    static fn foreign_only(prefix: ByteSpan) -> bool:
        prefix.span_len == 0

fn unknown_owner(span: ByteSpan, prefix: ByteSpan) -> bool:
    span.slice(0, prefix.span_len).foreign_only(prefix)

fn main() -> i64:
    if unknown_owner(ByteSpan.empty(), ByteSpan.empty()): return 1
    0
