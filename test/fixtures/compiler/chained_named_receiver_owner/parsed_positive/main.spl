use std.common.bytes.span.{ByteSpan}

struct ForeignSliceOwner:
    value: i64

impl ForeignSliceOwner:
    static fn equals(prefix: ByteSpan) -> bool:
        false

fn chained_prefix(span: ByteSpan, prefix: ByteSpan) -> bool:
    span.slice(0, prefix.span_len).equals(prefix)

fn typed_prefix_control(span: ByteSpan, prefix: ByteSpan) -> bool:
    val window: ByteSpan = span.slice(0, prefix.span_len)
    window.equals(prefix)

fn span_with_effect() -> ByteSpan:
    print "chained-owner-receiver-once"
    ByteSpan.new([10u8, 20u8, 30u8])

fn effect_prefix(prefix: ByteSpan) -> bool:
    span_with_effect().slice(0, prefix.span_len).equals(prefix)

fn direct_span(span: ByteSpan) -> ByteSpan:
    span

fn direct_call_prefix(span: ByteSpan, prefix: ByteSpan) -> bool:
    direct_span(span).equals(prefix)

fn static_control(prefix: ByteSpan) -> bool:
    ForeignSliceOwner.equals(prefix)

fn main() -> i64:
    val span = ByteSpan.of([99u8, 10u8, 20u8, 30u8], 1, 3)
    if not chained_prefix(span, ByteSpan.new([10u8, 20u8])): return 1
    if chained_prefix(span, ByteSpan.new([10u8, 21u8])): return 2
    if not chained_prefix(span, ByteSpan.empty()): return 3
    if not typed_prefix_control(span, ByteSpan.new([10u8, 20u8])): return 4
    if not effect_prefix(ByteSpan.new([10u8, 20u8])): return 5
    if not direct_call_prefix(span, ByteSpan.new([10u8, 20u8, 30u8])): return 6
    if static_control(ByteSpan.empty()): return 7
    0
