use app.payload_provider.{Atom, Packet, make_items, make_mapping, total}

struct ConsumerPadding:
    value: text

enum ConsumerOther:
    Number(text)

fn main() -> i64:
    # Same-owner construction controls are separate from imported construction.
    if total(make_items()) != 11: return 1
    if total(make_mapping()) != 13: return 2
    val items: [Atom] = [Atom.Number(17)]
    val mapping: Dict<text, Atom> = {"value": Atom.Number(19)}
    if total(Packet.Items(items)) != 17: return 3
    if total(Packet.Mapping(mapping)) != 19: return 4
    val empty: [Atom] = []
    if total(Packet.Items(empty)) != 0: return 5
    print "enum payload owner identity: 5 checks, 0 failures"
    0
