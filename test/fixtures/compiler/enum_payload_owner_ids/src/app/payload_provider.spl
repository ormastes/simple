# Provider symbols intentionally differ from the consumer's declaration order.
pub enum Atom:
    Number(i64)

pub enum Packet:
    Items([Atom])
    Mapping(Dict<text, Atom>)

pub fn make_items() -> Packet:
    val values: [Atom] = [Atom.Number(11)]
    Packet.Items(values)

pub fn make_mapping() -> Packet:
    val values: Dict<text, Atom> = {"value": Atom.Number(13)}
    Packet.Mapping(values)

pub fn total(packet: Packet) -> i64:
    match packet:
        case Packet.Items(items):
            var sum: i64 = 0
            for atom in items:
                match atom:
                    case Atom.Number(number):
                        sum = sum + number
            sum
        case Packet.Mapping(entries):
            var sum: i64 = 0
            for key in entries.keys():
                match entries[key]:
                    case Atom.Number(number):
                        sum = sum + number
            sum
