struct ItemKey:
    id: i64

struct ItemValue:
    first: i64
    second: i64

class Shelf:
    count: i64
    fn items() -> i64:
        self.count

var receiver_calls: i64 = 0

fn make_items_dict() -> Dict<text, i64>:
    receiver_calls = receiver_calls + 1
    {"seven": 7, "nine": 9}

fn check_ref(values: mut Dict<text, i64>) -> i64:
    var total = 0
    for (key, value) in values.items():
        if key != "seven" and key != "nine": return -100
        total = total + value
    total

fn main() -> i64:
    val pairs = make_items_dict().items()
    if receiver_calls != 1: return 1
    if pairs.len() != 2: return 2
    var total = 0
    for (key, value) in pairs:
        if key == "seven" and value != 7: return 3
        if key == "nine" and value != 9: return 4
        if key != "seven" and key != "nine": return 5
        total = total + value
    if total != 16: return 6
    var values: Dict<text, i64> = {"seven": 7, "nine": 9}
    if check_ref(values) != 16: return 7
    var direct_total = 0
    for (key, value) in values:
        direct_total = direct_total + value
    if direct_total != 16: return 8
    val empty: Dict<text, i64> = {}
    if empty.items().len() != 0: return 9
    val records: Dict<ItemKey, ItemValue> = {ItemKey(id: 147): ItemValue(first: 3, second: 41)}
    var record_count = 0
    for (key, value) in records.items():
        if key.id != 147: return 10
        if value.first != 3 or value.second != 41: return 11
        record_count = record_count + 1
    if record_count != 1: return 12
    val numeric: Dict<bool, f64> = {true: 1.5, false: 2.5}
    var numeric_count = 0
    for (key, value) in numeric.items():
        if key and value != 1.5: return 13
        if not key and value != 2.5: return 14
        numeric_count = numeric_count + 1
    if numeric_count != 2: return 15
    if Shelf(count: 19).items() != 19: return 16
    print "DICT_ITEMS_NATIVE_PASS"
    0
