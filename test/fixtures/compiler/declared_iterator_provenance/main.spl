# Keep implicit original forms alongside explicit local controls. No casts.
struct Words:
    values: [text]

fn text_count(value: text) -> i64:
    var count = 0
    for ch in value:
        count = count + 1
    count

fn split_count(value: text) -> i64:
    var count = 0
    for part in value.substring(0).replace("\t", " ").split(" "):
        if part != "": count = count + 1
    count

fn field_text(value: Words) -> text:
    var joined = ""
    for word in value.values:
        joined = joined + word
    joined

fn typed_field_text(value: Words) -> text:
    val words: [text] = value.values
    var joined = ""
    for word in words:
        joined = joined + word
    joined

fn maybe_words(present: bool) -> Result<[text], text>:
    if present: return Ok(["a", "é한"])
    Err("absent")

fn result_index_count(present: bool) -> i64:
    val result = maybe_words(present)
    if result.is_err(): return -1
    val words = result.unwrap()
    var count = 0
    for ch in words[1]: count = count + 1
    count

fn main() -> i64:
    var failed = 0
    if text_count("é한a") != 3: failed = failed + 1
    if text_count("") != 0: failed = failed + 1
    if split_count("one\ttwo  three") != 3: failed = failed + 1
    if split_count("") != 0: failed = failed + 1
    val words = Words(values: ["a", "é", "한"])
    if field_text(words) != "aé한": failed = failed + 1
    if typed_field_text(words) != "aé한": failed = failed + 1
    if field_text(Words(values: [])) != "": failed = failed + 1
    if result_index_count(true) != 2: failed = failed + 1
    if result_index_count(false) != -1: failed = failed + 1
    # Repeat after all consumers: iteration must not mutate or consume owner.
    if field_text(words) != "aé한": failed = failed + 1
    print "declared iterator provenance: 10 checks, {failed} failures"
    failed
