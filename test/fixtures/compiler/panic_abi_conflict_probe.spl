# Compile-time diagnostic plus executed success/failure controls.
use std.sffi.cli_args.{cli_get_args}

fn explicit_failure():
    panic("panic-abi-explicit-marker")

fn codepoint(value: text) -> i64:
    value as i64

fn main() -> i64:
    for arg in cli_get_args():
        if arg == "--explicit":
            explicit_failure()
            print "PANIC_ABI_FELL_THROUGH"
            return 99
        if arg == "--cast":
            val invalid = codepoint("ab")
            print "PANIC_ABI_CAST_FELL_THROUGH={invalid}"
            return 98
    if codepoint("A") != 65: return 1
    print "PANIC_ABI_SUCCESS"
    0
