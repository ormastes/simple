use compiler.mir.mir_types.{MirType, MirTypeKind, MirConstValue, LocalId}
use compiler.mir.mir_instruction_support.{MirOperand, MirOperandKind}

fn nested_kind(operand: MirOperand) -> i64:
    match operand.kind:
        case MirOperandKind.Const(_, ty):
            match ty.kind:
                case MirTypeKind.I32 | MirTypeKind.I64: 1
                case _: 0
        case _: 0

fn same_payload(operand: MirOperand) -> i64:
    match operand.kind:
        case MirOperandKind.Copy(local) | MirOperandKind.Move(local): local.id
        case _: -1

fn main() -> i64:
    print nested_kind(MirOperand(kind: MirOperandKind.Const(MirConstValue.Int(7), MirType(kind: MirTypeKind.I32))))
    print nested_kind(MirOperand(kind: MirOperandKind.Const(MirConstValue.Bool(false), MirType(kind: MirTypeKind.Bool))))
    print same_payload(MirOperand(kind: MirOperandKind.Copy(LocalId(id: 7))))
    print same_payload(MirOperand(kind: MirOperandKind.Move(LocalId(id: 9))))
    return 0
