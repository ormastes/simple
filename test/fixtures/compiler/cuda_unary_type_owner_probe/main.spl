use compiler.mir.mir_types.{MirType, MirTypeKind}

fn supports_neg(ty: MirType) -> i64:
    match ty.kind:
        case MirTypeKind.I16 | MirTypeKind.I32 | MirTypeKind.I64 | MirTypeKind.U16 | MirTypeKind.U32 | MirTypeKind.U64 | MirTypeKind.F32 | MirTypeKind.F64: 1
        case _: 0

fn supports_bitnot(ty: MirType) -> i64:
    match ty.kind:
        case MirTypeKind.I16 | MirTypeKind.I32 | MirTypeKind.I64 | MirTypeKind.U16 | MirTypeKind.U32 | MirTypeKind.U64: 1
        case _: 0

fn main() -> i64:
    print supports_neg(MirType(kind: MirTypeKind.I16))
    print supports_neg(MirType(kind: MirTypeKind.F64))
    print supports_neg(MirType(kind: MirTypeKind.Bool))
    print supports_neg(MirType(kind: MirTypeKind.I8))
    print supports_bitnot(MirType(kind: MirTypeKind.U64))
    print supports_bitnot(MirType(kind: MirTypeKind.F64))
    return 0
