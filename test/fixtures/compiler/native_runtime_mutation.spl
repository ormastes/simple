use std.nogc_sync_mut.io.native_runtime_authority_v1.{native_runtime_strict_generated_bind_v1,
    native_runtime_strict_generated_inputs_v1, native_runtime_strict_generated_release_v1,
    native_runtime_strict_revalidate_v1}
use std.io_runtime.{cwd, getpid, dir_create_all, file_atomic_write, file_delete}

fn runtime_mutation_check_v1(root: text, path: text) -> i64:
    if not native_runtime_strict_generated_bind_v1([root + "/missing.o"]).is_err(): return 3
    if not file_atomic_write(path, "generated-object-first\n"): return 4
    if not native_runtime_strict_generated_bind_v1([path]).is_ok(): return 5
    if not native_runtime_strict_generated_inputs_v1([path]).is_ok(): return 6
    if not native_runtime_strict_generated_inputs_v1([root + "/other.o"]).is_err(): return 7
    if not file_atomic_write(path, "generated-object-changed\n"): return 8
    if not native_runtime_strict_generated_inputs_v1([path]).is_err(): return 9
    if not file_atomic_write(path, "generated-object-first\n"): return 10
    # Restoration must neither make the invocation valid nor authorize rebind.
    if not native_runtime_strict_generated_bind_v1([path]).is_err(): return 11
    if not native_runtime_strict_generated_inputs_v1([path]).is_err(): return 12
    if not native_runtime_strict_revalidate_v1(true).is_err(): return 13
    0

fn main() -> i64:
    val root = cwd().replace("\\", "/") + "/build/runtime-pin-" + str(getpid())
    if not dir_create_all(root): return 2
    val path = root + "/runtime.o"
    val result = runtime_mutation_check_v1(root, path)
    native_runtime_strict_generated_release_v1([path])
    if not file_delete(path): return 14
    if result != 0: return result
    print "strict-runtime-mutation-sticky"
    0
