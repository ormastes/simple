    post_mono_report_diagnostics, post_mono_report_total}
use compiler.driver.cache.hir_owned_artifact_cache_v1.{hir_owned_artifact_store_blob_v1,
    hir_owned_artifact_load_blob_v1, hir_owned_artifact_context_v1}
use compiler.common.cache_contract.hir_owned_artifact_cache_v1.{
    hir_owned_artifact_load_blob_v1 as common_artifact_load_v1}
use compiler.driver.cache.hir_mono_function_record_v1.{mono_function_record_load_in_owned_scope_v1}
use compiler.driver.driver_hir_cache.{hir_cache_header, hir_cache_load_in_owned_scope,
    hir_cache_clear_last_warnings, hir_cache_promote_diagnostic_owner_v1, hir_cache_path,
    hir_cache_store_in_owned_scope}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule, HirType, HirTypeKind, SymbolId}
