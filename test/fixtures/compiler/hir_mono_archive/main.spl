    execution_registration.roots = actual_registered_roots
    checks = checks + 1
    if mono_archive_registration_seal_v1(execution_registration, inventory, admitted_order).is_err(): return 133
    val sealed_schedule = execution_registration.sealed_schedule_digest
    execution_registration.roots = omitted_roots
    if not mono_archive_execution_create_v1(execution_registration, inventory, admitted_order).is_err() or
