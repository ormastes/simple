    checks = checks + 1
    val execution_root = mono_archive_execute_next_root_v1(execution)
    if execution_root.is_err() or not mono_archive_roots_complete_v1(execution): return 139
    val executed_observation = observe_body(execution_root.unwrap())
    if executed_observation.is_err() or executed_observation.unwrap().digest !=
