    checks = checks + 1
    if record_controls(current.unwrap()) != 7: return 128
    checks = checks + 7
    var wrong_record = current.unwrap()
    wrong_record.function_archive_key = sha256_text("wrong record owner")
    val record_epoch = admission.state.epoch
