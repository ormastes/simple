    execution_registration.roots = actual_registered_roots
    checks = checks + 1
    if not mono_archive_execution_create_v1(execution_registration, inventory, [provider.name, root.name]).is_err(): return 134
    checks = checks + 1
    if not transient_scope_begin(): return 135
    val nested_execution = mono_archive_execution_create_v1(execution_registration, inventory, admitted_order).is_err()
    if not transient_scope_end() or not nested_execution: return 136
    checks = checks + 1
    val execution_result = mono_archive_execution_create_v1(execution_registration, inventory, admitted_order)
    if execution_result.is_err(): return 137
    val execution = execution_result.unwrap()
    execution.roots = omitted_roots
    if mono_archive_execution_complete_v1(execution) or
            not mono_archive_execute_next_root_v1(execution).is_err() or execution.expected_epoch != 0: return 159
    execution.roots = actual_registered_roots
    checks = checks + 1
    if not mono_archive_execute_next_specialization_v1(execution).is_err() or
            mono_archive_execution_complete_v1(execution) or execution.expected_epoch != 0 or
