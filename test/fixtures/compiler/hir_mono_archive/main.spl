    checks = checks + 1
    if mono_archive_apply_v1(collision, collision_body.unwrap()).is_err() or collision.state.emitted.len() != 1: return 45
    checks = checks + 1
    # Declaration facts cannot authorize a different complete provider body.
    var mismatch_collector = collector(modules)
