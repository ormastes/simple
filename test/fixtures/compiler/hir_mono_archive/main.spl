    checks = checks + 1
    val execution_registration_result = mono_archive_registration_create_v1()
    if execution_registration_result.is_err(): return 130
    val execution_registration = execution_registration_result.unwrap()
    if not mono_archive_execution_create_v1(execution_registration, inventory, admitted_order).is_err(): return 131
    checks = checks + 1
    for name in admitted_order:
