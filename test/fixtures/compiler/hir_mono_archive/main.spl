# Native only. Complete decoded functions are observed while their scope lives.
use provider.{outer}
use compiler.driver.cache.hir_body_typecheck_lease_v1.*
use compiler.driver.cache.hir_mono_archive_consumer_v1.*
use compiler.driver.cache.hir_mono_archive_execution_v1.*
