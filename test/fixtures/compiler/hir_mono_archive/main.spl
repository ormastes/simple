        if mono_archive_apply_v1(registered_admission, body.unwrap()).is_err(): return 115
        registered_emitted = registered_emitted + 1
    if registered_emitted != 4: return 116
    checks = checks + 1
    if not capture_registration(registered, provider_archive).is_err(): return 117
    checks = checks + 1
    val collision_owner_result = mono_archive_registration_create_v1()
    if collision_owner_result.is_err(): return 118
    val collision_owner = collision_owner_result.unwrap()
