use compiler.driver.hir_admission_order_v1.{hir_admission_path_order_v1}

fn main() -> i64:
    if hir_admission_path_order_v1([]).len() != 0: return 10
    val single = hir_admission_path_order_v1(["one"])
    if single.len() != 1 or single[0] != 0: return 11
    val paths = ["z", "a", "z", "", "a"]
    val order: [i64] = hir_admission_path_order_v1(paths)
    val expected: [i64] = [3, 1, 4, 0, 2]
    if order.len() != expected.len(): return 12
    for index in 0..order.len():
        if order[index] != expected[index]:
            print "index={index} actual={order[index]} expected={expected[index]}"
            return 13
    if paths[0] != "z" or paths[3] != "": return 14
    val reversed = hir_admission_path_order_v1(["g", "f", "e", "d", "c", "b", "a"])
    for index in 0..reversed.len():
        if reversed[index] != 6 - index: return 15
    print "hir-admission-order PASS"
    0
