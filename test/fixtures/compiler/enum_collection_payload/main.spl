enum Payload:
    Items([i64])
    Mapping(Dict<text, i64>)
    Number(i64)

fn total(value: Payload) -> i64:
    match value:
        case Payload.Items(items):
            var sum: i64 = 0
            for item in items:
                sum = sum + item
            sum
        case Payload.Mapping(entries):
            var sum: i64 = 0
            for key in entries.keys():
                sum = sum + entries[key]
            sum
        case Payload.Number(number):
            number

fn main() -> i64:
    val items: [i64] = [4, 7]
    val empty: [i64] = []
    val entries: Dict<text, i64> = {"first": 5, "second": 8}
    if total(Payload.Items(items)) != 11: return 1
    if total(Payload.Items(empty)) != 0: return 2
    if total(Payload.Mapping(entries)) != 13: return 3
    if total(Payload.Number(19)) != 19: return 4
    if items[0] != 4 or entries["first"] != 5: return 5
    print "enum collection payload: 5 checks, 0 failures"
    0
