use compiler.hir.hir_types.{SymbolId}
use compiler.common.diagnostics.span.{Span}
use compiler.mir.mir_types.{MirType, MirSignature, LocalId, LocalKind, MirLocal}
use compiler.mir.mir_instruction_support.{BlockId, MirTerminator}
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_instruction_graph.{MirInst, MirBlock, MirFunction}
use compiler.mir.mir_json.{serialize_mir_function, serialize_mir_block}

fn make_function(name: text, locals: [MirLocal], blocks: [MirBlock]) -> MirFunction:
    MirFunction(symbol: SymbolId(id: 7), name: name,
        signature: MirSignature(params: [], return_type: MirType.i64(),
            is_variadic: false, params_known: true),
        locals: locals, blocks: blocks, entry_block: BlockId(id: 0), span: Span.empty())

pub fn empty_graph_bytes_match() -> bool:
    val actual = serialize_mir_function(make_function("empty", [], []))
    actual == "{\"symbol\":7,\"name\":\"empty\",\"signature\":{\"params\":[],\"return_type\":\"I64\",\"is_variadic\":false,\"params_known\":true},\"locals\":[],\"blocks\":[],\"entry_block\":0}"

pub fn escaped_graph_bytes_match() -> bool:
    val locals = [
        MirLocal(id: LocalId(id: 0), name: Some("quoted\"name"), type_: MirType.i64(), kind: LocalKind.Arg(0), is_ghost: false),
        MirLocal(id: LocalId(id: 1), name: nil, type_: MirType.i64(), kind: LocalKind.Temp, is_ghost: false)]
    val first = MirBlock(id: BlockId(id: 0), label: Some("entry\nlabel"),
        instructions: [MirInst(kind: MirInstKind.Nop, span: nil),
            MirInst(kind: MirInstKind.DebugValue(LocalId(id: 1), "debug\tname"), span: nil)],
        terminator: MirTerminator.Goto(BlockId(id: 2)))
    val last = MirBlock(id: BlockId(id: 2), label: nil, instructions: [], terminator: MirTerminator.Ret(nil))
    val actual = serialize_mir_function(make_function("quoted\"function", locals, [first, last]))
    actual == "{\"symbol\":7,\"name\":\"quoted\\\"function\",\"signature\":{\"params\":[],\"return_type\":\"I64\",\"is_variadic\":false,\"params_known\":true},\"locals\":[{\"id\":0,\"name\":\"quoted\\\"name\",\"type\":\"I64\",\"kind\":{\"Arg\":0}},{\"id\":1,\"name\":null,\"type\":\"I64\",\"kind\":\"Temp\"}],\"blocks\":[{\"id\":0,\"label\":\"entry\\nlabel\",\"instructions\":[\"Nop\",{\"DebugValue\":{\"local\":1,\"name\":\"debug\\tname\"}}],\"terminator\":{\"Goto\":2}},{\"id\":2,\"label\":null,\"instructions\":[],\"terminator\":{\"Return\":null}}],\"entry_block\":0}" and serialize_mir_block(last) == "{\"id\":2,\"label\":null,\"instructions\":[],\"terminator\":{\"Return\":null}}"

pub fn large_graph_bytes_match() -> bool:
    var blocks: [MirBlock] = []
    var expected_blocks: [text] = []
    var nops: [text] = []
    for instruction_index in 0..64:
        nops = nops.push("\"Nop\"")
    val instructions_json = nops.join(",")
    for block_index in 0..32:
        var instructions: [MirInst] = []
        for instruction_index in 0..64:
            instructions = instructions.push(MirInst(kind: MirInstKind.Nop, span: nil))
        blocks = blocks.push(MirBlock(id: BlockId(id: block_index), label: nil,
            instructions: instructions, terminator: MirTerminator.Ret(nil)))
        expected_blocks = expected_blocks.push("{\"id\":{block_index},\"label\":null,\"instructions\":[{instructions_json}],\"terminator\":{\"Return\":null}}")
    val expected = "{\"symbol\":7,\"name\":\"large\",\"signature\":{\"params\":[],\"return_type\":\"I64\",\"is_variadic\":false,\"params_known\":true},\"locals\":[],\"blocks\":[" + expected_blocks.join(",") + "],\"entry_block\":0}"
    serialize_mir_function(make_function("large", [], blocks)) == expected
