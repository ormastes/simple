# Expected bytes are numeric and independent of source escape decoding.
use std.common.string_core.{char_from_code_inline, char_from_code}

fn main() -> i64:
    for code in [11, 12]:
        val direct = char_from_code_inline(code)
        if direct.byte_len() != 1 or (direct.byte_at(0) as i64) != code: return code
        val through_alias = char_from_code(code)
        if through_alias.byte_len() != 1 or (through_alias.byte_at(0) as i64) != code: return code + 100
    0
