use app.compiler_entrypoint.admission.{compiler_entrypoint_admit_v1}
use compiler.driver.cache.cache_root.{machine_cache_root}
use compiler.driver.cache.package_module_index.{package_module_index_read_current_v1}

fn main() -> i64:
    val admitted = compiler_entrypoint_admit_v1(["src"])
    if not admitted.valid:
        print "entrypoint admission failed: {admitted.reason}"
        return 1
    val index = package_module_index_read_current_v1(machine_cache_root())
    if not index.valid or index.generation == nil or
            index.digest != admitted.index_digest or
            index.generation!.entries.len() != 0:
        print "entrypoint index binding invalid: {index.reason}"
        return 2
    print "PASS package_index_admission_native_probe"
    0
