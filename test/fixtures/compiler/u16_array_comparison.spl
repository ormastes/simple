class TokenFlags:
    values: [u16]

fn array_zero(values: [u16]) -> bool:
    values[0] == 0u16

fn field_zero(flags: TokenFlags) -> bool:
    flags.values[0] == 0u16

fn masked(flags: u16) -> bool:
    (flags & ~1u16) != 0u16

class NestedFlags:
    values: [[u16]]

fn nested_zero(flags: NestedFlags) -> bool:
    flags.values[0][0] == 0u16

fn main() -> i64:
    if not array_zero([0u16]): return 11
    if array_zero([65535u16]): return 12
    if not field_zero(TokenFlags(values: [0u16])): return 13
    if field_zero(TokenFlags(values: [65535u16])): return 14
    if masked(1u16): return 15
    if not masked(2u16): return 16
    if not nested_zero(NestedFlags(values: [[0u16]])):
        return 17
    if nested_zero(NestedFlags(values: [[65535u16]])):
        return 18
    print "U16_ARRAY_COMPARISON_PASS"
    0
