use std.nogc_sync_mut.io_runtime.{process_run_timeout, process_run}

fn main() -> i64:
    val (out, err, code) = process_run_timeout("/bin/sh", ["-c", "printf ordinary-out; printf ordinary-err >&2; exit 7"], 10000)
    if code != 7: return 11
    if out != "ordinary-out": return 12
    if err != "ordinary-err": return 13
    val (good_out, good_err, good_code) = process_run_timeout("/bin/sh", ["-c", "printf success"], 10000)
    if good_code != 0 or good_out != "success" or good_err != "": return 14
    val (plain_out, plain_err, plain_code) = process_run("/bin/sh", ["-c", "printf untimed; exit 9"])
    if plain_code != 9 or plain_out != "untimed" or plain_err != "": return 15
    print "PASS: ordinary imported timed/untimed process stdout stderr status"
    0
