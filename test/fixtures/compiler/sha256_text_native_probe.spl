use std.common.crypto.sha256.{sha256_text, sha256_u8_hex, sha256_u8_fast_hex}
use std.common.text_bytes.{text_to_bytes, text_to_utf8_bytes, bytes_to_text}

fn main() -> i64:
    val expected = "d1990f97a1f4fe7b8e86da8c03c9dd3f7d536c14aa4a6f9eedab07f34cd961b0"
    val source = "producer"
    val literal_bytes: [u8] = [112u8, 114u8, 111u8, 100u8, 117u8, 99u8, 101u8, 114u8]
    val encoded = text_to_utf8_bytes(source)
    val alias_bytes = text_to_bytes(source)
    val pure = sha256_u8_hex(literal_bytes)
    val fast = sha256_u8_fast_hex(literal_bytes)
    val text_digest = sha256_text(source)
    print "source-len={source.len()} first={source.byte_at(0) as i64} encoded-len={encoded.len()}"
    print "pure={pure} fast={fast} text={text_digest}"
    if source.len() != 8 or source.byte_at(0) != 112u8:
        return 10
    if encoded.len() != 8:
        return 1
    if encoded[0] != 112u8 or encoded[7] != 114u8:
        return 2
    if alias_bytes.len() != 8 or alias_bytes[0] != 112u8:
        return 7
    val unicode_bytes = text_to_utf8_bytes("é")
    if unicode_bytes.len() != 2 or unicode_bytes[0] != 195u8 or unicode_bytes[1] != 169u8:
        return 8
    if pure != expected:
        return 3
    if fast != expected:
        return 4
    if text_digest != expected:
        return 5
    val rebuilt = bytes_to_text(encoded)
    if sha256_text(rebuilt) != expected:
        return 6
    print "PASS sha256_text_native_probe"
    0
