# Native ABI control for the packed encoder's owned-buffer helpers.
# Both routes must produce identical golden bytes. LLDB allocation-call counts
# distinguish growing-array copies from explicit mutable-buffer appends.

fn copied_put(out: [u8], value: i64) -> [u8]:
    var buf = out
    var v = value
    for i in 0..8:
        buf.push((v & 255) as u8)
        v = v >> 8
    buf

fn owned_put(mut out: [u8], value: i64) -> [u8]:
    var v = value
    for i in 0..8:
        out.push((v & 255) as u8)
        v = v >> 8
    out

fn main() -> i64:
    var old: [u8] = []
    for i in 0..256:
        old = copied_put(old, i)
    var owned: [u8] = []
    for i in 0..256:
        owned = owned_put(owned, i)
    if old.len() != 2048 or owned.len() != 2048: return 1
    for i in 0..2048:
        if old[i] != owned[i]: return 2
        val expected = if i % 8 == 0: (i / 8) as u8 else: 0u8
        if owned[i] != expected: return 3
    print "OWNED_APPEND_OK"
    0
