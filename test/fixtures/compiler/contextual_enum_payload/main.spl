enum Value:
    Floats([f64])
    Matrix([[i64]])
    Map(Dict<text, [f64]>)
    Pair([i64], text)

fn float_probe() -> i64:
    val value = Value.Floats([])
    match value:
        case Value.Floats(items):
            items.push(1.5)
            items.push(2.25)
            if items.len() != 2: return 11
            if items[0] != 1.5: return 12
            if items[1] != 2.25: return 13
            0
        case _: 14

fn nested_probe() -> i64:
    val value = Value.Matrix([[], [1]])
    match value:
        case Value.Matrix(rows):
            if rows.len() != 2: return 21
            if rows[0].len() != 0: return 22
            if rows[1][0] != 1: return 23
            rows[0].push(7)
            if rows[0][0] != 7: return 24
            if rows[1][0] != 1: return 25
            0
        case _: 26

fn dict_probe() -> i64:
    val value = Value.Map({"a": []})
    match value:
        case Value.Map(items):
            if items.len() != 1: return 31
            val floats = items["a"]
            if floats.len() != 0: return 32
            floats.push(3.5)
            if floats[0] != 3.5: return 33
            0
        case _: 34

fn pair_probe() -> i64:
    val value = Value.Pair([], "ok")
    match value:
        case Value.Pair(items, label):
            if label != "ok": return 41
            items.push(17)
            if items[0] != 17: return 42
            0
        case _: 43

fn main() -> i64:
    val a = float_probe()
    if a != 0: return a
    val b = nested_probe()
    if b != 0: return b
    val c = dict_probe()
    if c != 0: return c
    pair_probe()
