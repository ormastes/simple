struct Inner:
    value: text

struct Insp:
    roots: Inner

fn baseErr() -> Result<Insp, i64>:
    Err(42)

fn viaMap() -> Result<Inner, i64>:
    baseErr().map(_.roots)

fn baseOk() -> Result<Insp, i64>:
    Ok(Insp(roots: Inner(value: "nested")))

fn main() -> i64:
    val b = baseErr()
    eprint "E1 base.is_err=" + str(b.is_err())
    if not b.is_err() or b.unwrap_err() != 42:
        return 1
    val r = viaMap()
    eprint "E2 mapped.is_err=" + str(r.is_err())
    if not r.is_err() or r.unwrap_err() != 42:
        return 2
    val mapped_ok = baseOk().map(_.roots)
    if mapped_ok.is_err():
        return 3
    if mapped_ok.unwrap().value != "nested":
        return 4
    print "Result Err shorthand map: PASS"
    0
