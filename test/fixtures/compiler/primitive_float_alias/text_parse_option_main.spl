fn main() -> i32:
    val good = "1.25".parse_f64()
    val bad = "not-a-number".parse_f64()
    var good_ok = false
    if val value = good:
        good_ok = value == 1.25
    val bad_ok = bad == nil
    print "float_alias_text_parse_option_good={good_ok}"
    print "float_alias_text_parse_option_bad={bad_ok}"
    if good_ok and bad_ok:
        return 0
    1
