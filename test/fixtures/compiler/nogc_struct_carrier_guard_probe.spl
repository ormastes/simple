use std.io_runtime.{exit}
use compiler.mir.mir_types.{LocalId}
use compiler.mir.mir_instruction_support.{MirOperand, MirOperandKind}

@unsafe(reason: "tagged runtime-value classifier accepts concrete runtime carriers without reboxing", capabilities: [ffi])
extern fn rt_value_is_nil<T>(value: T) -> bool
@unsafe(reason: "tagged runtime-value classifier accepts concrete runtime carriers without reboxing", capabilities: [ffi])
extern fn rt_value_is_int<T>(value: T) -> bool
@unsafe(reason: "projects an integer carrier after the matching runtime type check", capabilities: [ffi])
extern fn rt_value_as_int<T>(value: T) -> i64

fn local_carrier_absent(value: LocalId) -> bool:
    val is_nil = unsafe(capabilities: [ffi]):
        rt_value_is_nil(value)
    if is_nil: return true
    val is_int = unsafe(capabilities: [ffi]):
        rt_value_is_int(value)
    if is_int:
        val number = unsafe(capabilities: [ffi]):
            rt_value_as_int(value)
        return number == 0
    false

fn operand_carrier_absent(value: MirOperand) -> bool:
    val is_nil = unsafe(capabilities: [ffi]):
        rt_value_is_nil(value)
    if is_nil: return true
    val is_int = unsafe(capabilities: [ffi]):
        rt_value_is_int(value)
    if is_int:
        val number = unsafe(capabilities: [ffi]):
            rt_value_as_int(value)
        return number == 0
    false

fn check_carrier(condition: bool, message: text):
    if not condition:
        print "FAIL: {message}"
        exit(1)

fn main() -> i64:
    val raw_local: LocalId = 0
    val nil_local: LocalId = nil
    val zero_local = LocalId(id: 0)
    val seven_local = LocalId(id: 7)
    check_carrier(local_carrier_absent(raw_local), "raw zero LocalId carrier is absent")
    check_carrier(local_carrier_absent(nil_local), "nil LocalId carrier is absent")
    check_carrier(not local_carrier_absent(zero_local), "constructed LocalId zero is valid")
    check_carrier(not local_carrier_absent(seven_local), "constructed LocalId seven is valid")

    val raw_operand: MirOperand = 0
    val nil_operand: MirOperand = nil
    val valid_operand = MirOperand(kind: MirOperandKind.Copy(LocalId(id: 0)))
    check_carrier(operand_carrier_absent(raw_operand), "raw zero MirOperand carrier is absent")
    check_carrier(operand_carrier_absent(nil_operand), "nil MirOperand carrier is absent")
    check_carrier(not operand_carrier_absent(valid_operand), "constructed MirOperand is valid")

    print "struct carrier guard: raw-zero and nil are absent; constructed records survive"
    0
