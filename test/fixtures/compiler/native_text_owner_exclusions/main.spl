struct InstanceTextNames:
    marker: i64

impl InstanceTextNames:
    fn strip(self) -> i64: self.marker
    fn lines(self) -> i64: self.marker + 1

trait TraitTextNames:
    fn strip() -> i64
    fn lines() -> i64

struct TraitTextOwner:
    marker: i64

impl TraitTextNames for TraitTextOwner:
    fn strip(self) -> i64: 4
    fn lines(self) -> i64: 5

struct UfcsTextOwner:
    marker: i64

fn strip(owner: UfcsTextOwner) -> i64: 7
fn lines(owner: UfcsTextOwner) -> i64: 8

struct StaticTextNames:
    marker: i64

impl StaticTextNames:
    static fn strip() -> i64: 6
    static fn lines() -> i64: 7

fn custom_text_names(a: InstanceTextNames, b: TraitTextOwner, c: UfcsTextOwner) -> i64:
    a.strip() + a.lines() + b.strip() + b.lines() + strip(c) + lines(c) + StaticTextNames.strip() + StaticTextNames.lines()

fn main() -> i64:
    val result = custom_text_names(
        InstanceTextNames(marker: 1),
        TraitTextOwner(marker: 0),
        UfcsTextOwner(marker: 0),
    )
    if result == 40:
        print "native-text-owner-exclusions: PASS"
        return 0
    print "native-text-owner-exclusions: FAIL result={result}"
    1
