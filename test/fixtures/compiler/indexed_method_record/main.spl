use model.{FunctionSymbol, FunctionRecord, FunctionRecords, FunctionOwner}

fn collect(owner: FunctionOwner) -> {i64: FunctionRecord}:
    var result: {i64: FunctionRecord} = {}
    val keys = owner.lowered.keys()
    var index = 0
    while index < keys.len():
        val key = keys[index]
        val method: FunctionRecord = owner.lowered[key]
        result[method.symbol.id] = method
        index = index + 1
    result

fn main() -> i64:
    var records: FunctionRecords = {}
    records[5] = FunctionRecord(symbol: FunctionSymbol(id: 41), name: "first")
    records[9] = FunctionRecord(symbol: FunctionSymbol(id: 73), name: "second")
    val owner = FunctionOwner(lowered: records)
    val result = collect(owner)
    if result.len() != 2: return 1
    val first: FunctionRecord = result[41]
    val second: FunctionRecord = result[73]
    if first.symbol.id != 41 or first.name != "first": return 2
    if second.symbol.id != 73 or second.name != "second": return 3
    if owner.lowered.len() != 2: return 4
    0
