# Native regression probe for Len.is_empty default-method materialization.
# Every marker must be `true`. The custom override deliberately returns false
# when its length is zero, proving the built-in collection fast path cannot
# steal user-defined trait dispatch.

trait ProbeLen:
    fn len() -> i64

    fn is_empty() -> bool:
        self.len() == 0

struct InheritedProbe:
    count: i64

impl ProbeLen for InheritedProbe:
    fn len() -> i64:
        self.count

struct OverrideProbe:
    count: i64

impl ProbeLen for OverrideProbe:
    fn len() -> i64:
        self.count

    fn is_empty() -> bool:
        false

fn generic_is_empty<T: ProbeLen>(value: T) -> bool:
    value.is_empty()

fn main():
    val empty_array: [i64] = []
    val full_array: [i64] = [1]
    val empty_text: text = ""
    val full_text: text = "x"
    var empty_dict: Dict<text, i64> = {}
    var full_dict: Dict<text, i64> = {}
    full_dict["x"] = 1

    print("array_empty=" + empty_array.is_empty().to_string())
    print("array_full=" + (not full_array.is_empty()).to_string())
    print("text_empty=" + empty_text.is_empty().to_string())
    print("text_full=" + (not full_text.is_empty()).to_string())
    print("dict_empty=" + empty_dict.is_empty().to_string())
    print("dict_full=" + (not full_dict.is_empty()).to_string())

    val inherited_empty = InheritedProbe(count: 0)
    val inherited_full = InheritedProbe(count: 2)
    val override_zero = OverrideProbe(count: 0)
    print("inherited_empty=" + generic_is_empty(inherited_empty).to_string())
    print("inherited_full=" + (not generic_is_empty(inherited_full)).to_string())
    print("override_direct=" + (not override_zero.is_empty()).to_string())
    print("override_wins=" + (not generic_is_empty(override_zero)).to_string())
