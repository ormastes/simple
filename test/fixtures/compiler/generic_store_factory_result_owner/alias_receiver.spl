# BOOTSTRAP_DIAGNOSTIC: original failing factory/pattern/mutable-alias shape.
class GenericStore<T>:
    values: [T]

    fn get(node: i64) -> Result<T, text>:
        if node >= 0 and node < self.values.len():
            return Ok(self.values[node])
        Err("empty store")

fn make_store<T>(label: text) -> Result<GenericStore<T>, text>:
    if label == "": return Err("empty label")
    Ok(GenericStore<T>(values: []))

fn main() -> i64:
    match make_store<text>("self_check"):
        case Ok(source):
            var store = source
            match store.get(3):
                case Ok(value):
                    if value == "round-trip": return 1
                    return 2
                case Err(_): return 0
        case Err(_): return 3
