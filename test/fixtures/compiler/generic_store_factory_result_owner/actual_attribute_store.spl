# BOOTSTRAP_DIAGNOSTIC: real imported factory and mutable storage owner.
# Preserve the nodes.spl self-check shape; do not annotate away its Result owner.
use compiler.common.data.attribute_schema_v1.{AttributeStoreV1, AttrPlacementV1, attr_store_detached_v1}

fn actual_attribute_store_roundtrip(placement: AttrPlacementV1, expected: text) -> bool:
    match attr_store_detached_v1<text>("self_check", placement):
        case Ok(source):
            var store = source
            val _written = store.set(3, "round-trip")
            match store.get(3):
                case Ok(value): return value == expected and store.len() == 1
                case Err(_): return false
        case Err(_): return false

fn main() -> i64:
    val matched = actual_attribute_store_roundtrip(AttrPlacementV1.Column, "round-trip")
    val mismatched = actual_attribute_store_roundtrip(AttrPlacementV1.Column, "wrong-value")
    if matched and not mismatched:
        print "attribute-store-owner-ok"
        return 0
    print "attribute-store-owner-failed"
    1
