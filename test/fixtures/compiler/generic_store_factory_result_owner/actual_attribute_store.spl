# BOOTSTRAP_DIAGNOSTIC: real imported factory and mutable storage owner.
# Preserve the nodes.spl self-check shape; do not annotate away its Result owner.
use compiler.common.data.attribute_schema_v1.{AttributeStoreV1, AttrPlacementV1, attr_store_detached_v1}

fn actual_attribute_store_roundtrip(placement: AttrPlacementV1) -> bool:
    match attr_store_detached_v1<text>("self_check", placement):
        case Ok(source):
            var store = source
            val _written = store.set(3, "round-trip")
            match store.get(3):
                case Ok(value): return value == "round-trip" and store.len() == 1
                case Err(_): return false
        case Err(_): return false

fn main() -> i64:
    if actual_attribute_store_roundtrip(AttrPlacementV1.Column): return 0
    1
