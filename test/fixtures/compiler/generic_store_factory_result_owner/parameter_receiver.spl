# BOOTSTRAP_DIAGNOSTIC: concrete parameter receiver, no factory/pattern alias.
class GenericStore<T>:
    values: [T]

    fn get(node: i64) -> Result<T, text>:
        if node >= 0 and node < self.values.len():
            return Ok(self.values[node])
        Err("empty store")

fn inspect(store: GenericStore<text>) -> i64:
    match store.get(3):
        case Ok(value):
            if value == "round-trip": return 1
            return 2
        case Err(_): return 0

fn main() -> i64:
    inspect(GenericStore<text>(values: []))
