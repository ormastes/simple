use std.spec
use std.io.{env_get, file_write}

describe "public SDN provider guard body marker":
    it "writes a marker only if this test body runs":
        val marker = env_get("SIMPLE_PUBLIC_SDN_GUARD_MARKER")
        expect(marker.len() > 0).to_equal(true)
        expect(file_write(marker, "test body ran")).to_equal(true)
