use std.nogc_sync_mut.test_runner.source_route.{source_has_bdd_structure, interpreter_snippet_source}

fn verify(ok: bool, name: text) -> i64:
    if ok:
        print "PASS {name}"
        return 0
    print "FAIL {name}"
    1

fn main() -> i64:
    var failures = 0
    val plain = "val actual = 41\nif actual != 41:\n    panic(\"wrong\")\n"
    val wrapped = interpreter_snippet_source("plain_test.spl", plain)
    failures = failures + verify(wrapped.contains("describe \"standalone SPL snippet\"") and wrapped.contains("val actual = 41") and wrapped.contains("        if actual != 41:"), "plain-real-example-body")
    failures = failures + verify(interpreter_snippet_source("empty.spl", "") == "" and interpreter_snippet_source("comment.spl", "# it \"fake\":\n# expect(1).to_equal(1)\n") == "", "empty-comment-no-example")
    failures = failures + verify(interpreter_snippet_source("decl.spl", "fn helper():\n    print \"not called\"\n") == "" and interpreter_snippet_source("main.spl", "fn main():\n    print \"entry\"\n") == "", "declarations-not-snippets")
    failures = failures + verify(interpreter_snippet_source("pass.spl", "pass\n") == "", "pass-only-no-example")
    failures = failures + verify(interpreter_snippet_source("named_spec.spl", plain) == "", "spec-file-contract-preserved")
    val bdd = "use std.spec\ndescribe \"real\":\n    it \"body\":\n        expect(1).to_equal(1)\n"
    failures = failures + verify(source_has_bdd_structure(bdd) and interpreter_snippet_source("ordinary.spl", bdd) == "", "bdd-source-not-rewrapped")
    failures = failures + verify(source_has_bdd_structure(bdd + "# sdoctest:\n# print \"doc\"\n"), "mixed-bdd-doc-keeps-spec")
    failures = failures + verify(not source_has_bdd_structure("# describe \"fake\":\nval text = \"it fake\"\n"), "comment-string-not-bdd")
    failures = failures + verify(not source_has_bdd_structure("fn doc():\n    \"\"\"\n    describe \"fake\":\n        it \"fake\":\n    \"\"\"\n    pass\n"), "docstring-not-bdd")
    print "SOURCE_ROUTE_REGRESSION failures={failures}"
    if failures > 0: 1 else: 0
