# Fixture: same-file comment doctest whose assert_equal is WRONG (deliberate-red).
# Before 2026-10-19 the seed treated a failed assert_* outside an `it` block as
# a silent no-op (flag set, never read), so this reported "1 passed".
##
## ```simple
## val y = doctest_fixture_add_two(1)
## assert_equal(y, 5)
## ```
pub fn doctest_fixture_add_two(a: i64) -> i64:
    a + 2
