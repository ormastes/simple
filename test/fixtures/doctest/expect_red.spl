# Fixture: same-file comment doctest whose expect matcher is WRONG (deliberate-red).
# Before the fix a failed `expect(..).to_*` outside an `it` block was a silent
# no-op (flag set, never read), so this reported "1 passed".
##
## ```simple
## val y = doctest_fixture_add_three(1)
## expect(y).to_equal(5)
## ```
pub fn doctest_fixture_add_three(a: i64) -> i64:
    a + 3
