# Fixture for lsp_member_definition_spec.spl (REQ-LSP-MEMBER-001). Line numbers are load-bearing.

trait Starter:
    fn start() -> i64

class Engine:
    power: i64
    fn start() -> i64:
        self.power
    fn stop() -> i64:
        0

class Car:
    pub engine: Engine
    alias Starter = engine
    fn drive() -> i64:
        self.engine.stop()

class Garage:
    car: Car
    fn open() -> i64:
        self.car.engine.stop()

fn main():
    val e = Engine(power: 1)
    print(e.power)
    e.stop()
    val g = Garage(car: Car(engine: e))
    g.car.engine.start()
    val c = Car(engine: e)
    c.start()
