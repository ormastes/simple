use std.nogc_sync_mut.src.math.backend.{RenderFormat}
use std.nogc_sync_mut.src.math.rendering.{render_all, render_as}
use expression.{RenderingExpression, RenderingEnvelope, render_nested, copy_expression}

extern fn rt_exit(code: i32)

fn check(label: text, actual: text, expected: text):
    if actual != expected:
        print "FAIL {label}: expected={expected} actual={actual}"
        rt_exit(1)

fn main() -> i64:
    val expr = RenderingExpression(symbol: "x")
    check("direct receiver", expr.to_latex(), "latex:x")
    val rendered = render_all(expr)
    check("all latex", rendered["latex"], "latex:x")
    check("all mathml", rendered["mathml"], "mathml:x")
    check("all text", rendered["text"], "text:x")
    check("all lean", rendered["lean"], "lean:x")
    check("as latex", render_as(expr, RenderFormat.LaTeX), "latex:x")
    check("as mathml", render_as(expr, RenderFormat.MathML), "mathml:x")
    check("as text", render_as(expr, RenderFormat.Text), "text:x")
    check("as lean", render_as(expr, RenderFormat.Lean), "lean:x")
    val copied = copy_expression(expr)
    check("returned aggregate", copied.to_latex(), "latex:x")
    val envelope = RenderingEnvelope(expression: expr)
    check("nested aggregate", render_nested(envelope), "latex:x")
    print "PASS math rendering: 11 checks including direct, trait, returned and nested receivers"
    0
