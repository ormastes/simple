use std.nogc_sync_mut.src.math.rendering.{MathRenderable, render_as}
use std.nogc_sync_mut.src.math.backend.{RenderFormat}

struct RenderingExpression:
    symbol: text

impl MathRenderable for RenderingExpression:
    fn to_latex() -> text: "latex:" + self.symbol
    fn to_mathml() -> text: "mathml:" + self.symbol
    fn to_text() -> text: "text:" + self.symbol
    fn to_lean() -> text: "lean:" + self.symbol

struct RenderingEnvelope:
    expression: RenderingExpression

struct TraitRenderingEnvelope:
    expression: RenderingExpression

impl MathRenderable for TraitRenderingEnvelope:
    fn to_latex() -> text: self.expression.to_latex()
    fn to_mathml() -> text: self.expression.to_mathml()
    fn to_text() -> text: self.expression.to_text()
    fn to_lean() -> text: self.expression.to_lean()

fn render_nested(envelope: RenderingEnvelope) -> text:
    render_as(envelope.expression, RenderFormat.LaTeX)

fn render_nested_trait(envelope: TraitRenderingEnvelope) -> text:
    render_as(envelope.expression, RenderFormat.LaTeX)

fn copy_expression(expr: RenderingExpression) -> RenderingExpression:
    expr
