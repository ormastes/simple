# Native (AOT) fixture for scripts/check/check-native-regress-a.shs.
# Pins four frozen-stage2 miscompile classes (LINK_NOTES S3N-4, 6, 9a, 10).
struct NrP:
    a: i64
    b: i64

fn nr_some(v: i64) -> Option<NrP>:
    Some(NrP(a: v, b: v * 2))

fn nr_pair(x: bool, y: bool) -> i64:
    var r = 0
    if x:
        r = r + 1
    if y:
        r = r + 10
    r

fn main():
    var p = NrP(a: 1, b: 2)
    p = NrP(a: 3, b: 4)
    print "<<reassign_b={p.b}>>"
    print "<<reassign_a={p.a}>>"
    var seen = -1
    if val s = nr_some(5):
        seen = s.b
    print "<<ifval_b={seen}>>"
    val m: i64? = nil
    val o: i64? = 2
    print "<<dotq_pair={nr_pair(m.?, o.?)}>>"
    var d: Dict<text, i64?> = {}
    d["k"] = 8
    val x = d["k"]
    print "<<dict_unwrap={x.unwrap()}>>"
