# Fixture module for L9 in-process LSP query adapter parity specs.
# Kept small and stable: the parity spec compares adapter output against the
# one-shot child for exactly these declarations.

struct SampleRecord:
    name: text
    count: i64

fn sample_helper(value: i64) -> i64:
    value + 1

fn sample_entry(record: SampleRecord) -> i64:
    sample_helper(record.count)
