# Native repro for the HIR walker slice 2 (option/result idioms, enum and
# tuple patterns, casts, trait methods). Run with the native CLI:
#   cli_tip.exe run test/fixtures/native_interp_walker_slice2/main.spl
# doc/08_tracking/bug/native_cli_test_cannot_run_std_spec_2026-11-15.md

enum Shape:
    Dot
    Square(side: i64)

struct Box:
    n: i64

trait Named:
    fn name() -> text

struct Cat:
    age: i64

impl Named for Cat:
    fn name() -> text:
        "cat{self.age}"

fn pick(x: i64?) -> i64:
    x ?? 7

fn has(x: i64?) -> bool:
    x.?

fn half(n: i64) -> Result<i64, text>:
    if n % 2 == 0:
        Ok(n / 2)
    else:
        Err("odd")

fn quarter(n: i64) -> Result<i64, text>:
    val h = half(n)?
    half(h)

fn score(r: Result<i64, text>) -> i64:
    match r:
        case Ok(v): v
        case Err(_): -1

fn get(x: i64?) -> i64:
    if val v = x:
        v + 1
    else:
        0

fn show(x: text?) -> text:
    match x:
        case Some(s): s
        case None: "-"

fn area(s: Shape) -> i64:
    match s:
        case Shape.Square(n): n * n
        case Shape.Dot: 1

fn peek(b: Box?) -> i64:
    b?.n ?? -1

fn main():
    print "coalesce={pick(Some(3)) + pick(None) + pick(nil)}"
    print "exists={has(Some(0))},{has(None)}"
    print "try={score(quarter(12))},{score(quarter(6))}"
    print "ifval={get(Some(4))},{get(None)}"
    print "option_match={show(Some(\"a\"))}{show(None)}"
    print "enum={area(Shape.Square(3)) + area(Shape.Dot)}"
    val t = (3, 4)
    val tup = match t:
        case (a, b): a * 10 + b
    print "tuple={tup}"
    print "optchain={peek(Some(Box(n: 5)))},{peek(None)}"
    val f = 7 as f64
    print "cast={(f * 1.5) as i64}"
    val c = Cat(age: 2)
    print "trait={c.name()}"
