# Deliberate negative: the second payload check must fail with exit 2.
# Both backends must retain optional pointer payloads, nil, and field identity.
struct Payload:
    first: i64
    second: i64

var saved: Payload? = nil

fn read_saved() -> i64:
    if val payload = saved:
        return payload.first * 10 + payload.second
    return -1

fn main() -> i32:
    if read_saved() != -1:
        return 1
    saved = Some(Payload(first: 3, second: 7))
    if read_saved() != 38:
        return 2
    saved = nil
    if read_saved() != -1:
        return 3
    saved = Some(Payload(first: 0, second: 3))
    if read_saved() != 3:
        return 4
    print("optional pointer nil: PASS")
    return 0
