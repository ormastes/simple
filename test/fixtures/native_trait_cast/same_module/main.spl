trait Reader:
    fn read_n() -> i64

trait Closer:
    fn close_n() -> i64

class Both:
    v: i64

impl Reader for Both:
    fn read_n() -> i64:
        self.v

impl Closer for Both:
    fn close_n() -> i64:
        self.v + 100

class ReadOnly:
    v: i64

impl Reader for ReadOnly:
    fn read_n() -> i64:
        self.v

fn close_via(r: Reader) -> i64:
    if val c = r as Closer:
        return c.close_n()
    -1

fn main() -> i64:
    val b: Reader = Both(v: 7)
    val o: Reader = ReadOnly(v: 3)
    print "both {close_via(b)}"
    print "readonly {close_via(o)}"
    0
