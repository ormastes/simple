use test.fixtures.native_trait_cast.cross_module.traits.{Reader, Closer}

pub class Both:
    v: i64

impl Reader for Both:
    fn read_n() -> i64:
        self.v

impl Closer for Both:
    fn close_n() -> i64:
        self.v + 100

pub class ReadOnly:
    v: i64

impl Reader for ReadOnly:
    fn read_n() -> i64:
        self.v

export Both, ReadOnly
