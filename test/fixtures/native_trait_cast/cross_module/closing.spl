# Casts without importing the implementing module: the cast thunk travels in
# the vtable built where the concrete type became a trait object.
use test.fixtures.native_trait_cast.cross_module.traits.{Reader, Closer}

pub fn close_via(r: Reader) -> i64:
    if val c = r as Closer:
        return c.close_n()
    -1

export close_via
