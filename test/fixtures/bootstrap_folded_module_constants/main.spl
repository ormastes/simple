val MODULE_INT = 41
val MODULE_ZERO = 0
val MODULE_FLOAT = 2.5
val MODULE_BOOL = true
val MODULE_TEXT = "folded"
val MODULE_BINARY = 6 * 7

fn main:
    print("CONST-PROBE:" + MODULE_INT.to_text() + ":" + MODULE_ZERO.to_text() +
        ":" + MODULE_FLOAT.to_text() + ":" + MODULE_BOOL.to_text() + ":" +
        MODULE_TEXT + ":" + MODULE_BINARY.to_text())
