use compiler.common.dependency.visibility.{Visibility}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}

fn main() -> i64:
    val source = (
        "enum State:\n" +
        "    Ready\n" +
        "    Busy(code: i64)\n\n" +
        "fn adjust(mut value: i64) -> i64:\n" +
        "    value + 1\n"
    )
    val module = parse_and_build_module(source, "native_frontend_owner_gaps.spl")
    if module.enums.len() != 1:
        return 41
    val state = module.enums["State"]
    if state.variants.len() != 2:
        return 42
    if state.variants[0].name != "Ready" or state.variants[1].name != "Busy":
        return 43
    val adjust = module.functions["adjust"]
    if adjust.params.len() != 1:
        return 44
    if not adjust.params[0].is_mutable:
        return 45

    # The heuristic parser's mapping is covered by the source contract spec;
    # retain the same canonical owner in this native semantic probe so the
    # enum values crossing the frontend boundary cannot silently drift.
    if Visibility.Public == Visibility.Private:
        return 46
    0
