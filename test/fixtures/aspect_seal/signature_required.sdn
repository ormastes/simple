# NEGATIVE fixture 4: the aspect DEMANDS verified provenance. No verifier and
# no trust authority exists in this tree, so it must be refused as
# UnverifiedSignature (E-ASPECT-004) — never admitted, and never described as
# a signature check that passed.
aspect:
  id: audit.signed
  version: 1
  provider_module: aspect_audit
  activation: startup
  signature: "sig-blob-signed"
  signature_authority: "acme-root"
  signature_required: true

  requires_facets:
    - facet: Auditable
      interface: AuditFacet

  advice:
    - name: audit.before_call
      mode: static_weave
      order: 10
      pointcut: "call(compiler.hir.*)"
      joinpoints:
        - "jp:hir:lower_call"

bindings:
  - facet: Auditable
    concrete_type: compiler.hir.HirExprKind
    handler: audit.bind_auditable
    activation: startup
