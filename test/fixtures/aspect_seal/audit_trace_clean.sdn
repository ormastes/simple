# POSITIVE fixture (hardening plan §13.3/§13.4): every required facet bound
# exactly once, startup activation, static weave, non-empty pointcut, and no
# demand for verified provenance. Seals clean under --critical.
aspect:
  id: audit.trace
  version: 2
  provider_module: aspect_audit
  activation: startup
  signature: "sig-blob-audit-trace"
  signature_authority: "unwired"
  signature_required: false

  requires_facets:
    - facet: Auditable
      interface: AuditFacet
    - facet: Traceable
      interface: TraceFacet

  advice:
    - name: audit.before_call
      mode: static_weave
      order: 10
      pointcut: "call(compiler.hir.*)"
      joinpoints:
        - "jp:hir:lower_call"
    - name: audit.after_return
      mode: explicit_facet
      order: 20
      pointcut: "return(compiler.hir.*)"
      joinpoints:
        - "jp:hir:lower_return"

bindings:
  - facet: Auditable
    concrete_type: compiler.hir.HirExprKind
    handler: audit.bind_auditable
    activation: startup
  - facet: Traceable
    concrete_type: compiler.hir.HirExprKind
    handler: audit.bind_traceable
    activation: first_use
