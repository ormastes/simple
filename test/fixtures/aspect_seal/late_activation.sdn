# NEGATIVE fixture 3: the aspect activates `late`, i.e. after the seal.
# Must be counted as late-activation (E-ASPECT-003) under --critical.
aspect:
  id: audit.late
  version: 1
  provider_module: aspect_audit
  activation: late

  requires_facets:
    - facet: Auditable
      interface: AuditFacet

  advice:
    - name: audit.before_call
      mode: static_weave
      order: 10
      pointcut: "call(compiler.hir.*)"
      joinpoints:
        - "jp:hir:lower_call"

bindings:
  - facet: Auditable
    concrete_type: compiler.hir.HirExprKind
    handler: audit.bind_auditable
    activation: late
