# NEGATIVE fixture 2: `Auditable` is bound twice for the same aspect.
# Must be counted as duplicate-binding (E-ASPECT-002).
aspect:
  id: audit.dup
  version: 1
  provider_module: aspect_audit
  activation: startup

  requires_facets:
    - facet: Auditable
      interface: AuditFacet

  advice:
    - name: audit.before_call
      mode: static_weave
      order: 10
      pointcut: "call(compiler.hir.*)"
      joinpoints:
        - "jp:hir:lower_call"

bindings:
  - facet: Auditable
    concrete_type: compiler.hir.HirExprKind
    handler: audit.bind_auditable
    activation: startup
  - facet: Auditable
    concrete_type: compiler.hir.HirStmtKind
    handler: audit.bind_auditable_stmt
    activation: startup
