# NEGATIVE fixture 1: `Traceable` is declared required and bound zero times.
# Must be counted as unbound-required (E-ASPECT-001).
aspect:
  id: audit.unbound
  version: 1
  provider_module: aspect_audit
  activation: startup

  requires_facets:
    - facet: Auditable
      interface: AuditFacet
    - facet: Traceable
      interface: TraceFacet

  advice:
    - name: audit.before_call
      mode: static_weave
      order: 10
      pointcut: "call(compiler.hir.*)"
      joinpoints:
        - "jp:hir:lower_call"

bindings:
  - facet: Auditable
    concrete_type: compiler.hir.HirExprKind
    handler: audit.bind_auditable
    activation: startup
