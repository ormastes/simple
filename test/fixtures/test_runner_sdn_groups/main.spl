use std.test_runner.test_runner_types.{TestFileResult, TestRunResult}
use std.test_runner.test_runner_output.{test_run_result_sdn}

fn file(path: text, passed: i64, failed: i64, skipped: i64, pending: i64) -> TestFileResult:
    TestFileResult(path: path, passed: passed, failed: failed, skipped: skipped,
        pending: pending, duration_ms: 1, setup_ms: 0, error: "",
        timed_out: false, cached: false)

fn main() -> i64:
    val run = TestRunResult(files: [file("test/unit/one.spl", 2, 1, 3, 1),
        file("test/system/two.spl", 0, 0, 5, 0), file("test/unit/three.spl", 1, 0, 1, 1)],
        total_passed: 3, total_failed: 1, total_skipped: 9, total_pending: 2,
        total_timed_out: 0, total_duration_ms: 3, total_setup_ms: 0, total_cached: 0)
    val encoded = match test_run_result_sdn(run):
        case Ok(value): value
        case Err(reason):
            print "FAIL SDN encode: {reason}"
            return 1
    val expected = "groups: [{done_pct: 50, failed: 1, name: unit, passed: 3, pending: 2, skipped: 4}, {done_pct: 0, failed: 0, name: system, passed: 0, pending: 0, skipped: 5}]"
    if not encoded.contains(expected):
        print "FAIL SDN group counts: {encoded}"
        return 1
    print "SDN_GROUP_REGRESSION PASS repeated-group counters and zero-denominator"
    0
