# Integer literals in a collection literal whose DECLARED element type is
# f64 are float values (int->f64 is allowed on all backends). They were boxed
# as tagged ints and read back as floats: `fsint 0.000…0012` natively (and in
# the seed JIT inside a function). The script top-level rows exercise the
# typed replay of top-level bindings into the synthetic main.
# Spec guard: test/01_unit/compiler/mir/typed_float_collection_literal_spec.spl
# Build with `native-build main.spl --backend=<cranelift|llvm> --entry-closure`
# from a directory outside test/. Reference = the language rule (the seed
# interpreter agrees; the seed JIT inside a function does not). Values are
# non-integral: native renders an integral f64 as `3.0`, the seed as `3`.
# Expected stdout, exactly (both backends):
#   fsint 3.25
#   fn_fsint 3.25
#   mixed 3.5
#   nested 3.25
#   dict 1.5
#   opt 3.25
#   done 0

fn in_function() -> i64:
    val fs: [f64] = [1, 2]
    print "fn_fsint {fs[0] + fs[1] + 0.25}"
    val m: [f64] = [1, 2.5]
    print "mixed {m[0] + m[1]}"
    val n: [[f64]] = [[1, 2]]
    print "nested {n[0][0] + n[0][1] + 0.25}"
    val d: {text: f64} = {"a": 1}
    print "dict {d["a"] + 0.5}"
    val o: f64? = 3
    print "opt {(o ?? 0.0) + 0.25}"
    0

val fs: [f64] = [1, 2]
print "fsint {fs[0] + fs[1] + 0.25}"
print "done {in_function()}"
