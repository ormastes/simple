# Same body as checked_downcast_ok.spl, but the `@unsafe` annotations ask for
# `raw_ptr` only. Since the grant is read off HirFunction.unsafe_caps, this is
# the fixture for "region NOT granted type_erasure": the raw Any is an origin.
@unsafe(reason: "representation boundary", capabilities: [raw_ptr])
fn checked_downcast(value: Any) -> i64:
    0

@unsafe(reason: "decode legacy plugin payload", capabilities: [raw_ptr])
fn decode() -> i64:
    var decoded = 0
    unsafe:
        val raw: Any = 1
        decoded = checked_downcast(raw)
    decoded
