# Fixture: `T?` where T is IMPORTED (not declared in this file). The parser
# collapses such a postfix-`?` to a bare Option, which HIR lowers as
# `Optional(Any)`. None of this is an erased value -> must produce zero findings.
# Mirrors formal_delivery_gates.spl:107-154 (census false positives, 2026-08-21).
use compiler.common.assurance.verified_release_gate.{SignedVerifiedReleaseBundleDecisionV1}

struct Decision:
    ok: bool
    hash: text

fn nil_compare(bundle: SignedVerifiedReleaseBundleDecisionV1?) -> Decision:
    if bundle != nil:
        return Decision(false, "")
    Decision(true, "")

fn match_extract(bundle: SignedVerifiedReleaseBundleDecisionV1?) -> Decision:
    val release = match bundle:
        case Some(value): value
        case _: return Decision(false, "")
    if not release.admitted or
            release.bundle_hash == "": return Decision(false, "")
    Decision(true, release.bundle_hash)
