# Fixture: a WRITTEN `Any?` parameter. This is a genuine erased value -- the
# optional wrapper does not un-erase it -- so it must be reported as an origin
# (E-MC-ANY-001) and its operator use as an escape (E-MC-ANY-002).
# Neighbour of imported_optional_param.spl, which has the identical SHAPE but a
# named payload: the two must be classified differently.
fn maybe_set(raw: Any?) -> bool:
    raw != nil
