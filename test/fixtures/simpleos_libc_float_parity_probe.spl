use os.libc.simpleos_stdlib_float.{libc_strtod, libc_strtof}
use std.io_runtime.{exit}

fn main():
    val decimal = "0.1".bytes()
    val binary_fraction = "-1.25e2".bytes()
    var checksum = 0.0
    var i = 0
    while i < 10000:
        checksum = checksum + libc_strtod(decimal).value
        checksum = checksum + libc_strtof(binary_fraction).value
        i = i + 1

    var compensated: [u8] = [49]
    i = 0
    while i < 1199:
        compensated.push(48)
        i = i + 1
    compensated.extend("e-1199".bytes())
    val long_value = libc_strtod(compensated).value
    if checksum < -1248999.0 and checksum > -1249001.0 and long_value == 1.0:
        print "PASS"
    else:
        print "FAIL"
        exit(1)
