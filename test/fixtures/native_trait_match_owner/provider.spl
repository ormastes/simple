trait MatchOwner:
    fn code() -> i64

    fn adjusted() -> i64:
        self.code() + 5

class FirstOwner:
    code_value: i64

class SecondOwner:
    padding: i64
    code_value: i64

impl MatchOwner for FirstOwner:
    fn code() -> i64:
        self.code_value

impl MatchOwner for SecondOwner:
    fn code() -> i64:
        self.code_value

    fn adjusted() -> i64:
        self.code_value + 11

fn optional_owner(choice: i64) -> MatchOwner?:
    if choice == 0:
        return nil
    if choice == 1:
        return FirstOwner(code_value: 31)
    SecondOwner(padding: 700, code_value: 47)

export MatchOwner, FirstOwner, SecondOwner, optional_owner
