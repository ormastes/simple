# Native-only: compile with an admitted Stage 2, then execute the result.
use compiler.frontend.core.types.{reset_all_pools, custom_primitive_register, custom_primitive_bind_symbol, custom_primitive_underlying_type_tag_by_symbol, custom_primitive_underlying_type_tag_by_name, custom_primitive_promote_transient_owner, TYPE_F64, TYPE_I64}

extern fn rt_transient_array_scope_begin() -> bool
extern fn rt_transient_array_scope_pause() -> bool
extern fn rt_transient_array_scope_end() -> bool

fn main() -> i64:
    if not rt_transient_array_scope_begin(): return 1
    reset_all_pools()
    custom_primitive_register("Decimal" + "Unit", TYPE_F64)
    custom_primitive_bind_symbol("DecimalUnit", 7001)
    if not rt_transient_array_scope_pause(): return 2
    if not custom_primitive_promote_transient_owner(): return 3
    if not rt_transient_array_scope_end(): return 4
    if custom_primitive_underlying_type_tag_by_symbol(7001) != TYPE_F64: return 5
    if custom_primitive_underlying_type_tag_by_name("DecimalUnit") != TYPE_F64: return 6
    if custom_primitive_underlying_type_tag_by_symbol(7002) != -1: return 7

    if not rt_transient_array_scope_begin(): return 8
    reset_all_pools()
    if not rt_transient_array_scope_pause(): return 9
    if not custom_primitive_promote_transient_owner(): return 10
    if not rt_transient_array_scope_end(): return 11
    if custom_primitive_underlying_type_tag_by_symbol(7001) != -1: return 12

    if not rt_transient_array_scope_begin(): return 13
    reset_all_pools()
    custom_primitive_register("Count" + "Unit", TYPE_I64)
    custom_primitive_bind_symbol("CountUnit", 7002)
    if not rt_transient_array_scope_pause(): return 14
    if not custom_primitive_promote_transient_owner(): return 15
    if not rt_transient_array_scope_end(): return 16
    if custom_primitive_underlying_type_tag_by_symbol(7002) != TYPE_I64: return 17
    if custom_primitive_underlying_type_tag_by_name("DecimalUnit") != -1: return 18
    if custom_primitive_promote_transient_owner(): return 19
    print("custom-primitive-transient-owner-ok")
    0
