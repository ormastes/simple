# CONTROL for the native `Option.unwrap()` receiver defect.
#
# Identical to `main.spl` in every respect EXCEPT that the receiver never
# passes through an `Option`. This one BUILDS and RUNS on the native lane
# today, which is what makes `main.spl`'s failure attributable to the Option
# hop alone rather than to cross-module resolution, a call-returned receiver,
# or the method names.
#
# Expected native-build behaviour: rc=0, prints exactly `CONTROL=9`.

class Drv2:
    n: i64

impl Drv2:
    static fn new(n: i64) -> Drv2:
        Drv2(n: n)

    me fn stat(path: text) -> i64:
        self.n + path.len()

fn make() -> Drv2:
    Drv2.new(7)

fn main():
    # Concrete-typed local from a construction site.
    val a: Drv2 = Drv2.new(7)
    val direct = a.stat("ab")
    # Concrete-typed local from a CALL RETURN — proves a call-returned
    # receiver is fine when the declared return type names a concrete class.
    val b: Drv2 = make()
    val via_call = b.stat("ab")
    if direct != 9 or via_call != 9:
        println("CONTROL=BAD direct={direct} via_call={via_call}")
        return
    println("CONTROL=9")
