# Child fixture for bdd_it_match_arm_return_spec.spl. NOT a *_spec file, so the
# runner never discovers it; the parent spec runs it explicitly.
# `?` on an Err inside an `it` must FAIL the example (it shares the TryError
# channel with match-arm `return`, which is localized).
use std.spec.*

fn always_err() -> Result<i64, text>:
    Err("boom")

describe "try operator inside an it block":
    it "must fail when ? meets an Err":
        val v = always_err()?
        expect(v).to_equal(1)
