"""Actual Linux native byte-process ABI/codec fixture. No runner substitution."""
use std.nogc_sync_mut.sosix.process_text.*
use std.nogc_sync_mut.io.text_session.{text_session_codec, utf8_text_session_codec}
use std.common.encoding.external_text.{Encoding, TextByteOrder, BomPolicy, CodecErrorKind}

fn retire(s: ProcessTextSession):
    var turns = 0
    while turns < 100:
        if val result = s.collect(25).unwrap():
            assert(result.reaped)
            return
        turns = turns + 1
    assert(false, "native lease did not retire")

fn main() -> i64:
    val utf8 = utf8_text_session_codec(4096, 4096).unwrap()
    val be = text_session_codec(Encoding.Utf16, TextByteOrder.BigEndian, BomPolicy.Require, Encoding.Utf16, TextByteOrder.BigEndian, BomPolicy.Require, 4096, 4096).unwrap()
    val s = sosix_process_text_session("/bin/cat", [], "A\u{0}😀", be, be, utf8, 1000, 50, 4096).unwrap()
    var output = ""
    var finished = false
    var turns = 0
    while not finished and turns < 100:
        val chunk = s.poll(25, 1).unwrap()
        output = output + chunk.stdout
        finished = chunk.output_finished
        turns = turns + 1
    assert(finished)
    assert(output.len() == 6)
    assert(output.byte_at(0) == 65 and output.byte_at(1) == 0)
    assert(output.byte_at(2) == 240 and output.byte_at(3) == 159)
    assert(output.byte_at(4) == 152 and output.byte_at(5) == 128)
    val delivered = s.input_receipt().unwrap()
    assert(delivered.accepted == 10 and delivered.written == 10 and delivered.stdin_closed)
    val alias = s
    retire(alias)
    assert(not s.is_open())
    assert(s.collect(0).is_err())
    val bad = sosix_process_text_session("/bin/sh", ["-c", "printf '\\377'; sleep 1"], "", utf8, utf8, utf8, 1000, 50, 4096).unwrap()
    var rejected = false
    turns = 0
    while not rejected and turns < 100:
        match bad.poll(25, 1):
            case Err(ProcessTextError.Codec(stream, error)):
                assert(stream == "stdout")
                assert(error.kind == CodecErrorKind.InvalidUtf8)
                rejected = true
            case Err(_): assert(false, "unexpected native codec failure")
            case Ok(_): turns = turns + 1
    assert(rejected)
    assert(bad.poll(0, 1).is_err())
    bad.cancel().unwrap()
    retire(bad)
    0
