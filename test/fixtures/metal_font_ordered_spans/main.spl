use std.common.gpu.metal_font_batch_contract.{metal_font_frame_batch_contract, metal_font_frame_span_contract}

fn main() -> i32:
    # First text span completes before a primitive; the second is still open.
    var texts: i64 = 1
    var commands: i64 = 1
    var commits: i64 = 1
    var waits: i64 = 1
    var spans: i64 = 1
    assert(metal_font_frame_span_contract(texts, commands, commits, waits, spans))
    texts = texts + 1
    commands = commands + 1
    assert(not metal_font_frame_span_contract(texts, commands, commits, waits, spans))
    commits = commits + 1
    assert(not metal_font_frame_span_contract(texts, commands, commits, waits, spans))
    waits = waits + 1
    spans = spans + 1
    assert(metal_font_frame_span_contract(texts, commands, commits, waits, spans))
    assert(not metal_font_frame_batch_contract(texts, commands, commits, waits))
    # Empty flushes create no span. Extra commands and incomplete waits fail.
    assert(not metal_font_frame_span_contract(0, 0, 0, 0, 0))
    assert(not metal_font_frame_span_contract(1, 2, 2, 2, 2))
    assert(not metal_font_frame_span_contract(30, 30, 30, 30, 1))
    assert(not metal_font_frame_span_contract(30, 2, 2, 1, 2))
    assert(metal_font_frame_batch_contract(30, 1, 1, 1))
    print "metal_font_ordered_spans=pass"
    0
