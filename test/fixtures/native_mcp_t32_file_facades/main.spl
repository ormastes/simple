use app.mcp_t32.gap_tools.{handle_t32_cmm_validate}
use app.mcp_t32.json_helpers.{t32_file_read, t32_file_write}
use app.io.mod.{file_delete}

fn main() -> i64:
    val result = handle_t32_cmm_validate("1", "{}")
    val path = "/tmp/simple-native-mcp-t32-file-facades.txt"
    val wrote = t32_file_write(path, "facade-ok")
    val read_back = t32_file_read(path)
    file_delete(path)
    val passed = result.contains("error") and wrote and read_back == "facade-ok"
    print("mcp t32 file facades resolved: {passed}")
    if passed: 0 else: 1
