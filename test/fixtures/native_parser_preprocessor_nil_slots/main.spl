use compiler.frontend.frontend.{preprocess_conditionals}

fn main() -> i64:
    val six_false = (
        "val kept = 1\n" +
        "@cfg(false)\nval hidden1 = 1\n" +
        "@cfg(false)\nval hidden2 = 2\n" +
        "@cfg(false)\nval hidden3 = 3\n" +
        "@cfg(false)\nval hidden4 = 4\n" +
        "@cfg(false)\nval hidden5 = 5\n" +
        "@cfg(false)\nval hidden6 = 6"
    )
    val six_out = preprocess_conditionals(six_false)
    if six_out != "val kept = 1\n\n\n\n\n\n\n\n\n\n\n\n":
        return 41
    if six_false.split("\n").len() != six_out.split("\n").len():
        return 43

    val whitespace = "\n   \n@cfg(true)\nval kept = 1\n\t\n"
    val whitespace_out = preprocess_conditionals(whitespace)
    if whitespace_out != "\n   \n\nval kept = 1\n\t\n":
        return 44
    if whitespace_out.contains("nil"):
        return 45

    val punctuation = preprocess_conditionals("@cfg(true)\nval punctuation = (1 + 2)")
    if punctuation != "\nval punctuation = (1 + 2)":
        return 46
    0
