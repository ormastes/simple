use common.ui.taskbar_model.{AppRef, TaskbarModel, WindowRef}
use common.ui.window_scene.{
    SharedWmScene,
    shared_wm_background_color,
    shared_wm_dispatch_pointer,
}
use common.ui.wm_runtime_dispatch.{
    wm_runtime_command_from_shared_dispatch,
}

fn main() -> i64:
    val scene = SharedWmScene(
        width: 800,
        height: 600,
        backend: "probe",
        windows: [],
        background: shared_wm_background_color(0u32),
    )
    val taskbar = TaskbarModel(
        pinned: [
            AppRef(
                app_id: "terminal",
                display_name: "Terminal",
                icon: "term",
            ),
            AppRef(
                app_id: "browser",
                display_name: "Browser",
                icon: "browser",
            ),
        ],
        running: [
            WindowRef(
                window_id: "win1",
                app_id: "demo.app",
                title: "Demo",
                minimized: false,
            ),
        ],
        tray: [],
    )
    val unpin = wm_runtime_command_from_shared_dispatch(
        shared_wm_dispatch_pointer(
            scene, taskbar, 70, 575, "right", "down", 1000, "09:41", 2
        )
    )
    if unpin.kind != "unpin_app" or unpin.app_id != "browser":
        return 1
    val pin = wm_runtime_command_from_shared_dispatch(
        shared_wm_dispatch_pointer(
            scene, taskbar, 120, 575, "right", "down", 1000, "09:41", 2
        )
    )
    if pin.kind != "pin_app" or pin.app_id != "demo.app":
        return 2
    val ignored = wm_runtime_command_from_shared_dispatch(
        shared_wm_dispatch_pointer(
            scene, taskbar, 120, 300, "right", "down", 1000, "09:41", 2
        )
    )
    if ignored.handled:
        return 3
    0
