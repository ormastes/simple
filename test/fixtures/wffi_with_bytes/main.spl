# Native fixture: drives the C-runtime `spl_wffi_call_i64_with_bytes` facade
# through a real libc callee, `strnlen(ptr, len)`.
extern fn spl_wffi_call_i64_with_bytes(fptr: i64, prefix_args: [i64], bytes: [u8], offset: i64, length: i64, suffix_args: [i64]) -> i64
extern fn spl_dlopen(path: text) -> i64
extern fn spl_dlsym(handle: i64, name: text) -> i64

fn main() -> i64:
    val bytes: [u8] = [65u8, 66u8, 0u8, 67u8]
    print "null-fptr -> {spl_wffi_call_i64_with_bytes(0, [], bytes, 0, 4, [])}"
    var lib = spl_dlopen("ucrtbase.dll")
    if lib == 0:
        lib = spl_dlopen("libc.so.6")
    val strnlen = spl_dlsym(lib, "strnlen")
    print "strnlen resolved -> {strnlen != 0}"
    print "strnlen whole -> {spl_wffi_call_i64_with_bytes(strnlen, [], bytes, 0, 4, [])}"
    print "strnlen tail -> {spl_wffi_call_i64_with_bytes(strnlen, [], bytes, 3, 1, [])}"
    print "oob -> {spl_wffi_call_i64_with_bytes(strnlen, [], bytes, 2, 5, [])}"
    0
