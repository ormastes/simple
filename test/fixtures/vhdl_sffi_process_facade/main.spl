# Focused native fence for the VHDL process facade.
#
# This must be compiled by an admitted pure-Simple self-hosted runtime. It
# proves that the public compatibility facade reaches the canonical captured
# process runner, preserves success/failure exit codes, and preserves a GHDL
# diagnostic instead of resolving the removed rt_process_run_capture extern.

use std.nogc_async_mut.io.vhdl_sffi.{ghdl_available, yosys_available, ghdl_analyze, vhdl_write_file}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}

fn main() -> i64:
    if not ghdl_available():
        print("VERDICT: FAIL GHDL availability probe")
        return 10

    if not yosys_available():
        print("VERDICT: FAIL Yosys availability probe")
        return 11

    if not dir_create_all("/tmp/ghdl_work"):
        print("VERDICT: FAIL GHDL work directory")
        return 12

    val valid_path = "/tmp/simple_vhdl_sffi_process_facade_valid.vhd"
    val valid_vhdl = "entity process_facade_probe is end entity; architecture rtl of process_facade_probe is begin end architecture;"
    if not vhdl_write_file(valid_path, valid_vhdl):
        print("VERDICT: FAIL write valid VHDL")
        return 13

    val valid = ghdl_analyze(valid_path)
    if not valid.success or valid.exit_code != 0:
        print("VERDICT: FAIL valid GHDL code={valid.exit_code} stdout={valid.stdout} stderr={valid.stderr}")
        return 14

    val invalid_path = "/tmp/simple_vhdl_sffi_process_facade_invalid.vhd"
    if not vhdl_write_file(invalid_path, "this is not valid VHDL at all;"):
        print("VERDICT: FAIL write invalid VHDL")
        return 15

    val invalid = ghdl_analyze(invalid_path)
    if invalid.success or invalid.exit_code == 0:
        print("VERDICT: FAIL invalid VHDL reported success")
        return 16
    if invalid.stdout == "" and invalid.stderr == "":
        print("VERDICT: FAIL invalid VHDL lost diagnostics")
        return 17

    print("VERDICT: PASS VHDL process facade captures GHDL/Yosys results")
    return 0
