# Fixture for dir_prevention_policy_runner_spec.spl — deliberately NOT named
# *_spec.spl so whole-suite discovery never runs it: under the directory
# policy two of its examples MUST fail. It declares no prevention guard of
# its own; the policy comes from ../_prevention.sdn via the runner.
use std.spec.*
use std.nogc_sync_mut.src.testing.mock.builder.{MockFunction}

describe "spec with no per-file prevention declaration":
    it "calls the forbidden seam once":
        val seam = MockFunction.new("forbidden_seam")
        seam.record_call(["write"])
        expect(seam.call_count()).to_equal(1)

    it "stays inside the budgeted seam's budget":
        val seam = MockFunction.new("budgeted_seam")
        seam.record_call(["a"])
        seam.record_call(["b"])
        expect(seam.call_count()).to_equal(2)

    it "exceeds the budgeted seam's budget":
        val seam = MockFunction.new("budgeted_seam")
        seam.record_call(["a"])
        seam.record_call(["b"])
        seam.record_call(["c"])
        expect(seam.call_count()).to_equal(3)

    it "never touches a guarded seam":
        val other = MockFunction.new("unrelated_seam")
        other.record_call(["x"])
        expect(other.call_count()).to_equal(1)
