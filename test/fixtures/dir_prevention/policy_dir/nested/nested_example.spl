# Fixture for dir_prevention_policy_runner_spec.spl (not *_spec.spl on
# purpose, see ../guarded_example.spl). Under the merged policy chain
# (../_prevention.sdn + ./_prevention.sdn) BOTH examples must fail: the
# parent's rule is inherited, the nested rule is added.
use std.spec.*
use std.nogc_sync_mut.src.testing.mock.builder.{MockFunction}

describe "nested spec with no per-file prevention declaration":
    it "calls the nested directory's seam":
        val seam = MockFunction.new("nested_seam")
        seam.record_call(["x"])
        expect(seam.call_count()).to_equal(1)

    it "calls the parent directory's forbidden seam":
        val seam = MockFunction.new("forbidden_seam")
        seam.record_call(["write"])
        expect(seam.call_count()).to_equal(1)
