# JIT-vs-interpreter fixture for R4: `Any?` slots never boxed.
#
# `slot_holds_tagged_value` (mir/lower/lowering_core.rs) accepted `T?` --
# `HirType::Pointer { inner }` -- only when `inner` was a RAW SCALAR, so
# `Pointer { inner: ANY }` was never recognised as a tagged slot and a raw
# scalar stored into an `Any?` slot skipped boxing entirely. Non-optional
# `Any` was correct throughout, which is why this read as an `Any?`-only
# defect. Pre-fix JIT output: `tail=<value:0x7>`, `ret=<value:0x7>`,
# `flt=576601489791778816`, `bol=nil`, `arg=<value:0x5>`,
# `let=<invalid-heap:0x9>`. The interpreter was correct for every line.

fn any_opt_tail() -> Any?:
    7

fn any_opt_return() -> Any?:
    return 7

fn any_opt_float() -> Any?:
    return 2.5

fn any_opt_bool() -> Any?:
    return true

fn any_opt_nil() -> Any?:
    return nil

fn any_opt_param(v: Any?) -> Text:
    return v.to_string()

fn any_plain() -> Any:
    return 7

fn main():
    print "tail={any_opt_tail() ?? 0}"
    print "ret={any_opt_return() ?? 0}"
    print "flt={any_opt_float() ?? 0}"
    print "bol={any_opt_bool() ?? 0}"
    print "nil={any_opt_nil() == nil}"
    print "arg={any_opt_param(5)}"
    val x: Any? = 9
    print "let={x}"
    var y: Any? = nil
    y = 11
    print "asg={y}"
    print "plain={any_plain()}"
    # Single-line summary for the differential harness.
    print "summary={any_opt_tail() ?? 0}|{any_opt_float() ?? 0}|{any_opt_bool() ?? 0}|{x}|{y}|{any_plain()}"
main()
