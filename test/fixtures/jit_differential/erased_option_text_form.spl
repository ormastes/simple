# JIT-vs-interpreter fixture: one text form for `T?` across an untyped boundary.
#
# The compiled lane carries `"12".parse_int()` raw (payload or nil) and an
# explicit `Some(12)` as a boxed Option enum. Through an untyped parameter the
# interpreter prints `Option::Some(12)` / `Option::None` for both; the JIT
# printed `12` / `nil` / `<enum@0x...>`.
# Bug: parse_family_strips_option_jit_native_2026-08-02

fn erased_text(x) -> text:
    "{x}"

fn relay(x):
    x

fn main():
    val parsed = "12".parse_int()
    val parsed_none = "zz".parse_int()
    val explicit: i64? = Some(12)
    val explicit_none: i64? = None
    print "parsed={erased_text(parsed)}"
    print "parsed_none={erased_text(parsed_none)}"
    print "explicit={erased_text(explicit)}"
    print "explicit_none={erased_text(explicit_none)}"
    print "relay={relay(parsed)} {relay(parsed_none)}"
