# Known bug: `xs.get(i)` on an array returns the raw tag-boxed word
# (value << 3) under the default (Cranelift JIT) engine; `xs[i]` on the same
# element is correct. See memory reference
# reference-list-get-returns-value-shifted-left-3 and
# doc/08_tracking/bug/list_get_returns_tag_boxed_value_shifted_left_3_2026-07-28.md.
# Expected (interpreter, correct): idx=5 get=5
fn main():
    val a = [5, 7]
    print("idx={a[0]} get={a.get(0)}")
