# Known bug: a module-level `val` initialized by a FUNCTION CALL reads as 0
# under the default (Cranelift JIT) engine, even when the function trivially
# returns a literal. The same value as a local, or initialized by a literal,
# is correct. See memory reference
# reference_jit_module_level_val_from_function_call_reads_zero.md and
# doc/08_tracking/bug/jit_drawirrendertarget_moduleresolver_gap_2026-07-30.md.
# Expected (interpreter, correct): X=42
fn get_value() -> i64:
    42

val X = get_value()

fn main():
    print("X={X}")
