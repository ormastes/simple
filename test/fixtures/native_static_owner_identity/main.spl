use provider.{Imported, Choice}

class First:
    value: i64

    static fn answer() -> i64:
        19

class Second:
    value: i64

    static fn answer() -> i64:
        23

class Instance:
    value: i64

    fn answer() -> i64:
        self.value

fn main() -> i64:
    val instance = Instance(value: 5)
    val actual = First.answer() + Second.answer() + instance.answer() + Imported.answer() + Choice.answer()
    print actual
    if actual == 65: 0 else: 1
