# Fixture driver (positive control): a ShaderSource produced by the
# gc_async_mut tier shim must be accepted by create_shader_program even when
# the co-compiled closure also loads the byte-identical nogc_async_mut /
# nogc_sync_mut tier shims of the same struct (owner-exact class identities
# can never match across tiers). Tracks:
# provable_class_rejection_rejects_tier_shim_structs_2026-11-28
use std.gc_async_mut.engine.render.shader.{ShaderSource, load_builtin_2d_shader, create_shader_program}

fn main():
    val source = load_builtin_2d_shader()
    val prog = create_shader_program(source)
    print "tiershim={prog.name} compiled={prog.is_compiled}"
