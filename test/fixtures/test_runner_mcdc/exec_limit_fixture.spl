# @exec_limit 50000000
# Fixture for test_runner_single_lane_features_spec: the single lane must
# forward the header's @exec_limit into the child env under default MC/DC.
use std.spec.*
use std.nogc_sync_mut.io.env_ops.{env_get}
describe "exec_limit directive":
    it "reaches the child env":
        expect(env_get("SIMPLE_EXECUTION_LIMIT") ?? "").to_equal("50000000")
