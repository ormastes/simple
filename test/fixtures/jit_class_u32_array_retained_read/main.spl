class RetainedMirror:
    pixels: [u32]

    static fn create(count: i64) -> RetainedMirror:
        RetainedMirror(pixels: [0u32; count])

    me patch(index: i64, value: u32):
        self.pixels[index] = value

fn main():
    val width: i64 = 7680
    val height: i64 = 4320
    val count = width * height
    var mirror = RetainedMirror.create(count)
    val middle = 256 * width + 320
    var frame: i64 = 0
    while frame < 210:
        mirror.patch(middle, if frame % 2 == 0: 0xffe62846u32 else: 0xff1ec86eu32)
        frame = frame + 1

    val retained = mirror.pixels
    val first = retained[0]
    val changed = retained[middle]
    val last = retained[count - 1]
    print("JIT_RETAINED_ARRAY first=" + first.to_i64().to_string() +
        " changed=" + changed.to_i64().to_string() + " last=" + last.to_i64().to_string())

main()
