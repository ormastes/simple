# Exercise the production owner without loading or initializing GPU hardware.
use lib.nogc_sync_mut.gpu.engine2d.sffi_intel.{IntelFfi}
use std.gpu.engine2d.sffi_dispatch.{GpuFfiMode}

fn init_without_library(provider: IntelFfi) -> bool:
    provider.init()

fn main() -> i64:
    val provider = IntelFfi(_mode: GpuFfiMode.Dynamic, _dyn_lib: nil)
    if provider.mode() != GpuFfiMode.Dynamic:
        return 11
    if init_without_library(provider):
        return 12
    if provider.is_available():
        return 13
    if not provider.shutdown():
        return 14
    val static_provider = IntelFfi.create_static()
    if static_provider.mode() != GpuFfiMode.Static:
        return 15
    print "intel-ffi-init-receiver: PASS cases=5"
    0
