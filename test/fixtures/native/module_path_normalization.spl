# Production-path native regression; compile with the positional Stage3 route.
use compiler.common.module_path_naming.{module_logical_name_from_path}

fn check_path(case_id: i64, path: text, expected: text) -> i64:
    val actual = module_logical_name_from_path(path)
    # Require inferred text rendering as well as pointer/value equality.
    print actual
    if actual != expected:
        print "case {case_id}: expected=[{expected}] actual=[{actual}]"
        return 1
    0

fn main() -> i64:
    var failures = 0
    failures = failures + check_path(1, "src/app/cli/bootstrap_main.spl", "app.cli.bootstrap_main")
