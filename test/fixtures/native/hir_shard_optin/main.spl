use app.cli.native_build_shard_admission.{native_build_hir_shard_policy_v1,
    native_build_shard_worker_limit}

fn main() -> i64:
    if native_build_hir_shard_policy_v1("0", "") != 0: return 101
    if native_build_hir_shard_policy_v1("0", "auto") != 0: return 102
    if native_build_hir_shard_policy_v1("", "0") != 0: return 103
    if native_build_hir_shard_policy_v1("1", "0") != 0: return 104
    if native_build_hir_shard_policy_v1("0", "0") != 0: return 105
    if native_build_hir_shard_policy_v1("0", "1") != 2: return 106
    if native_build_hir_shard_policy_v1("", "") != 1: return 107
    if native_build_hir_shard_policy_v1("1", "1") != 1: return 108
    if native_build_shard_worker_limit(20, 0, 2560, 0) != 20: return 109
    if native_build_shard_worker_limit(20, 102400, 2560, 0) != 20: return 110
    print("hir-shard-optin policy PASS: 10 checks")
    0
