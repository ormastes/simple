# Minimal dependency model for a native projection of the production
# CompilerDriver.borrow_check method. This is not the real compiler context.
class BorrowOptions:
    no_borrow_check: bool

class BorrowModule:
    diagnostics: [text]

class CompileContext:
    options: BorrowOptions
    mir_modules: {text: BorrowModule}
    errors: [text]
    error_count_value: i64

    me add_error(message: text):
        self.errors = self.errors.push(message)
        self.error_count_value = self.error_count_value + 1

    fn has_errors() -> bool:
        self.error_count_value > 0

class CompilerDriver:
    ctx: CompileContext

fn check_mir_module(module: BorrowModule) -> [text]:
    module.diagnostics

fn _format_nll_error(message: text) -> text:
    message

fn log_debug(message: text):
    print message

fn log_warn(message: text):
    print message

export BorrowOptions, BorrowModule, CompileContext, CompilerDriver
export check_mir_module, _format_nll_error, log_debug, log_warn
