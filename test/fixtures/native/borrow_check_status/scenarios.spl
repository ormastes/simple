# Appended after the automatically extracted production borrow_check method.
# The support module replaces dependencies, never the method under test.
fn check_case(skip_check: bool, prior: i64, incoming: [text], expected: bool) -> i64:
    var prior_errors: [text] = []
    if prior > 0:
        prior_errors.push("prior error")
    var modules: {text: BorrowModule} = {}
    modules["main"] = BorrowModule(diagnostics: incoming)
    val ctx = CompileContext(
        options: BorrowOptions(no_borrow_check: skip_check),
        mir_modules: modules, errors: prior_errors, error_count_value: prior)
    var driver = CompilerDriver(ctx: ctx)
    val result = driver.borrow_check()
    if result != expected:
        print "borrow-check-status mismatch prior={prior} skip_check={skip_check}"
        return 1
    val expected_count = if skip_check: prior else: prior + incoming.len()
    if driver.ctx.error_count_value != expected_count:
        return 2
    if driver.ctx.errors.len() != expected_count:
        return 3
    if not skip_check and incoming.len() > 0:
        if driver.ctx.errors[expected_count - 1] != "new borrow error":
            return 4
    0

fn main() -> i64:
    if check_case(false, 0, [], true) != 0:
        return 11
    if check_case(false, 1, [], false) != 0:
        return 12
    if check_case(false, 0, ["new borrow error"], false) != 0:
        return 13
    if check_case(true, 1, ["new borrow error"], true) != 0:
        return 14
    print "borrow-check-status-pass"
    0
