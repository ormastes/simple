use worker.{Thread}

fn erased(parts):
    parts

fn main() -> i64:
    val worker = Thread()
    if worker.join() != nil:
        return 2
    val parts = [for number in [1, 2]: str(number)]
    val actual = "[" + parts.join(",") + "]"
    if actual != "[1,2]":
        print("FAIL: " + actual)
        return 1
    print("PASS: " + actual)
    0