use worker.{Thread}

fn erased(parts):
    parts

fn main() -> i64:
    val worker = Thread()
    if worker.join() != nil:
        return 2
    # @workaround bug=seed_list_comprehension_join_and_empty_native_2026_10_21 recover=400bd5d1983 reason=bootstrap comprehensions lower to nil and erase join receiver
    var parts: [text] = []
    for number in [1, 2]:
        parts.push(str(number))
    val actual = "[" + parts.join(",") + "]"
    if actual != "[1,2]":
        print("FAIL: " + actual)
        return 1
    print("PASS: " + actual)
    0