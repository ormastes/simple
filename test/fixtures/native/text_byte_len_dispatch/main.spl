fn measured_bytes(value: text) -> i64:
    value.byte_len()

fn main() -> i64:
    val unicode = "é🙂"
    if measured_bytes(unicode) != 6: return 1
    if measured_bytes("abc") != 3: return 2
    if measured_bytes("") != 0: return 3
    if unicode.char_count() != 2: return 4
    print "PASS text byte length and codepoint count checks=4"
    0
