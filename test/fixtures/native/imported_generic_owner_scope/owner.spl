# Same-spelled owner declarations must also lose to the lexical binder.
pub struct Op:
    owner_decoy: bool

pub struct Cpl:
    owner_decoy: text

# Imported owner binders must retain their identity in field containers.
pub struct Packet<Op>:
    item: Op
    optional_item: Op?
    backlog: [Op]

pub class Channel<Op, Cpl>:
    operation: Op
    completion: Cpl?
    packets: [Packet<Op>]
