# Same spellings in the consumer must not capture the owner's binders.
struct Op:
    decoy: text

struct Cpl:
    decoy: bool

use .owner.{Channel, Packet}

fn accept_channel(value: Channel<i64, text>) -> i64:
    value.operation

fn accept_packet(value: Packet<i64>) -> i64:
    value.item

fn main() -> i64:
    0
