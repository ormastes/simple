# Concrete field reads must retain the imported owner's generic arguments.
struct Op:
    decoy: text

struct Cpl:
    decoy: bool

use .owner.{Channel, Packet}

fn packet_value(value: Packet<i64>) -> i64:
    value.item

fn channel_value(value: Channel<i64, text>) -> i64:
    value.operation

fn main() -> i64:
    val packet: Packet<i64> = Packet(item: 42, optional_item: nil, backlog: [7, 9])
    if packet_value(packet) != 42:
        return 1
    if packet.backlog.len() != 2:
        return 2
    if packet.backlog[0] != 7 or packet.backlog[1] != 9:
        return 3
    if packet.optional_item != nil:
        return 4
    val channel: Channel<i64, text> = Channel(operation: 37, completion: nil, packets: [packet])
    if channel_value(channel) != 37:
        return 5
    if channel.completion != nil:
        return 6
    if channel.packets.len() != 1:
        return 7
    if packet_value(channel.packets[0]) != 42:
        return 8
    0
