# Non-Linux contract: the real runtime owner reports HIP unavailable.
# Do not run this fixture on Linux, where a HIP provider may be installed.
use lib.nogc_sync_mut.gpu.engine2d.sffi_rocm.{RocmFfi}

fn initialize(ffi: RocmFfi) -> bool:
    ffi.init()

fn main() -> i64:
    val ffi = RocmFfi.create_static()
    if initialize(ffi):
        return 11
    if ffi.is_available():
        return 12
    if not ffi.shutdown():
        return 13
    print "rocm-unsupported-host: PASS cases=3 provider=unavailable"
    0
