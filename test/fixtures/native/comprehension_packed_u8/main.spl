fn main() -> i64:
    val bytes: [u8] = text_to_bytes("AB")
    val widened = [value as i64 for value in bytes]
    val odd = [value as i64 for value in bytes if value > 65]
    if widened.len() != 2 or widened[0] != 65 or widened[1] != 66:
        print "FAIL widened: {widened}"
        return 1
    if odd.len() != 1 or odd[0] != 66:
        print "FAIL filtered: {odd}"
        return 2
    print "PASS comprehension_packed_u8 65,66"
    0
