# Native correctness/performance component for a refreshed pure producer.
# Time the whole process externally; stdout and exit are correctness oracles.
use std.common.crypto.sha256.{sha256_text}
use std.scv.compile_source_inventory_core.{compile_source_inventory_event_from_content_v1}

fn main() -> i64:
    val content = " # ignored\r\n pub  fn answer(): 42\nval  count = 3\nuse alpha.beta\nfn body(): 1\n"
    val semantic = "pub fn answer(): 42\nval count = 3\nuse alpha.beta\nfn body(): 1"
    val expected_content = sha256_text(content)
    val expected_semantic = sha256_text(semantic)
    val expected_export = sha256_text("pub fn answer(): 42")
    val expected_initializer = sha256_text("val count = 3")
    val expected_provider = sha256_text("use alpha.beta")
    val expected_empty = sha256_text("")
    var index = 0
    while index < 256:
        val event = compile_source_inventory_event_from_content_v1(
            "git", "create", "src/fixture.spl", content)
        if event.content_digest != expected_content: return 101
        if event.semantic_digest != expected_semantic: return 102
        if event.export_digest != expected_export: return 103
        if event.initializer_digest != expected_initializer: return 104
        if event.provider_digest != expected_provider: return 105
        if event.byte_count != content.len(): return 106
        val empty = compile_source_inventory_event_from_content_v1(
            "git", "modify", "src/empty.spl", "")
        if empty.content_digest != expected_empty: return 107
        if empty.semantic_digest != expected_empty: return 108
        if empty.export_digest != expected_empty: return 109
        if empty.initializer_digest != expected_empty: return 110
        if empty.provider_digest != expected_empty: return 111
        index = index + 1
    print("scv-coalesced-facets PASS: 512 events, five digests each")
    0
