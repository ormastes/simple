use fnlib.ops.{add_one, mul, greet}

# Module A: stores fnlib.ops functions as values (variable, struct field,
# Option payload, callback argument) and calls them. Pre-fix every such value
# was a closure record `rt_closure_func_ptr` rejected, so the call went to
# address 0.

struct Ops:
    unary: (i64) -> i64
    binary: (i64, i64) -> i64

# The linker's shape (elf_operation_bindings.spl): an optional fn field.
struct Provider:
    op: Option<fn(i64) -> i64> = nil

fn apply(f: (i64) -> i64, x: i64) -> i64:
    f(x)

fn apply2(f: (i64, i64) -> i64, a: i64, b: i64) -> i64:
    f(a, b)

fn main() -> i64:
    val g = add_one
    if g(41) != 42:
        return 1
    val ops = Ops(unary: add_one, binary: mul)
    if ops.unary(9) != 10:
        return 2
    if ops.binary(6, 7) != 42:
        return 3
    if apply(add_one, 4) != 5:
        return 4
    if apply2(mul, 3, 5) != 15:
        return 5
    val maybe: Option<fn(i64) -> i64> = Some(add_one)
    match maybe:
        case Some(h):
            if h(1) != 2:
                return 6
        case None:
            return 7
    val provider = Provider(op: Some(add_one))
    match provider.op:
        case Some(p):
            if p(20) != 21:
                return 9
        case None:
            return 10
    val t = greet
    if t("b") != "hi b":
        return 8
    print "imported-fn-value PASS"
    0
