struct SymbolId:
    id: i64

fn symbol_value(symbol: SymbolId) -> i64:
    symbol.id

fn empty_first(symbols: Dict<SymbolId, i64>, empty: bool) -> i64:
    val keys = if empty: [] else: symbols.keys()
    var total: i64 = 0
    for key in keys:
        total = total + symbol_value(key)
    total

fn empty_last(symbols: Dict<SymbolId, i64>, empty: bool) -> i64:
    val keys = if empty: symbols.keys() else: []
    var total: i64 = 0
    for key in keys:
        total = total + symbol_value(key)
    total

fn main() -> i64:
    var symbols: Dict<SymbolId, i64> = {}
    symbols[SymbolId(id: 4294967313)] = 7
    if empty_first(symbols, false) != 4294967313:
        return 11
    if empty_first(symbols, true) != 0:
        return 12
    if empty_last(symbols, true) != 4294967313:
        return 13
    if empty_last(symbols, false) != 0:
        return 14
    print "conditional-empty-symbol-keys: PASS cases=4"
    0
