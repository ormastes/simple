var profiles: Dict<text, text> = {}
var tags: Dict<text, bool> = {}

fn replace_globals():
    var next_profiles: Dict<text, text> = {}
    var next_tags: Dict<text, bool> = {}
    next_profiles["alpha"] = "retained-value"
    next_profiles["beta"] = "second-value"
    next_tags["alpha"] = true
    next_tags["beta"] = false
    profiles = next_profiles
    tags = next_tags

fn clear_globals():
    var empty_profiles: Dict<text, text> = {}
    var empty_tags: Dict<text, bool> = {}
    profiles = empty_profiles
    tags = empty_tags

fn main() -> i64:
    replace_globals()
    if profiles["alpha"] != "retained-value": return 11
    if profiles["beta"] != "second-value": return 12
    if not tags["alpha"]: return 13
    if tags["beta"]: return 14
    clear_globals()
    if profiles.len() != 0: return 15
    if tags.len() != 0: return 16
    replace_globals()
    if profiles["alpha"] != "retained-value": return 17
    if not tags["alpha"]: return 18
    print "DICT_GLOBAL_READBACK_PASS"
    0
