# Native encoding checks: exact framing, sorted projections and rejection.
fn main() -> i64:
    val empty = ReverseReferenceGenerationReceiptV1(1, "owner", "root", [])
    val header = "simple-reverse-reference-generation-receipt-v1\nschema=1\nowner=owner\nroot=root\ncount="
    if reverse_reference_receipt_encode_v1(empty) != header + "0":
        return 11
    val key = ReverseReferenceKeyV1(
        registry_kind: "native", owner_generation: "owner", root_generation: "root",
        subject_identity: "module", projection_kind: "runtime-provider",
        projection_digest: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", schema_version: 1)
    val frame = reverse_reference_key_encode_v1(key)
    if frame == "":
        return 12
    val alpha = ReverseReferenceProjectionV1(key, "alpha")
    val omega = ReverseReferenceProjectionV1(key, "omega")
    val populated = ReverseReferenceGenerationReceiptV1(1, "owner", "root", [omega, alpha])
    val expected = header + "2\n{frame.len()}:{frame}5:alpha\n{frame.len()}:{frame}5:omega"
    if reverse_reference_receipt_encode_v1(populated) != expected:
        return 13
    val duplicate = ReverseReferenceGenerationReceiptV1(1, "owner", "root", [alpha, alpha])
    if reverse_reference_receipt_encode_v1(duplicate) != header + "2\n{frame.len()}:{frame}5:alpha\n{frame.len()}:{frame}5:alpha":
        return 14
    if reverse_reference_receipt_encode_v1(ReverseReferenceGenerationReceiptV1(2, "owner", "root", [])) != "":
        return 15
    if reverse_reference_receipt_encode_v1(ReverseReferenceGenerationReceiptV1(1, "", "root", [])) != "":
        return 16
    if reverse_reference_receipt_encode_v1(ReverseReferenceGenerationReceiptV1(1, "owner\nother", "root", [])) != "":
        return 17
    if reverse_reference_receipt_encode_v1(ReverseReferenceGenerationReceiptV1(1, "owner", "root\r", [])) != "":
        return 18
    val invalid_consumer = ReverseReferenceProjectionV1(key, "")
    if reverse_reference_receipt_encode_v1(ReverseReferenceGenerationReceiptV1(1, "owner", "root", [invalid_consumer])) != "":
        return 19
    val invalid_key = ReverseReferenceKeyV1(
        registry_kind: "unknown", owner_generation: "owner", root_generation: "root",
        subject_identity: "module", projection_kind: "runtime-provider",
        projection_digest: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", schema_version: 1)
    if reverse_reference_receipt_encode_v1(ReverseReferenceGenerationReceiptV1(1, "owner", "root", [ReverseReferenceProjectionV1(invalid_key, "alpha")])) != "":
        return 20
    print "reverse-receipt-join-pass"
    0
