# Native float `%` fixture: the seed LLVM backend rejected f64 Mod with
# `Unsupported float binop: Mod` (src/runtime/simple_core/core_any_ops.spl:94).
# Expected values are floored (sign of the divisor), matching the interpreter
# and the cranelift backend. f32 is not covered here: on the seed LLVM/core-C
# lane even f32 `a + b` through a function returns 0.0 (separate defect, see
# doc/08_tracking/bug/seed_llvm_float_mod_unsupported_blocks_simple_core_archive_2026-11-22.md).

fn f64_mod(a: f64, b: f64) -> f64:
    a % b

fn main() -> i64:
    val a = f64_mod(7.5, 2.0)
    val b = f64_mod(-7.5, 2.0)
    val c = f64_mod(7.5, -2.0)
    val d = f64_mod(-7.5, -2.0)
    if a == 1.5 and b == 0.5 and c == -0.5 and d == -1.5:
        print "PASS float-mod-floored-semantics"
    else:
        print "FAIL float-mod-floored-semantics a={a} b={b} c={c} d={d}"
    0
