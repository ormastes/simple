# Native float `%` fixture: the seed LLVM backend rejected f64 Mod with
# `Unsupported float binop: Mod` (src/runtime/simple_core/core_any_ops.spl:94).
# Expected values are floored (sign of the divisor), matching the interpreter
# and the cranelift backend.

fn f64_mod(a: f64, b: f64) -> f64:
    a % b

fn f32_mod(a: f32, b: f32) -> f32:
    a % b

fn main() -> i64:
    var ok = true
    if f64_mod(7.5, 2.0) != 1.5:
        ok = false
    if f64_mod(-7.5, 2.0) != 0.5:
        ok = false
    if f64_mod(7.5, -2.0) != -0.5:
        ok = false
    if f32_mod(5.5f32, 2.0f32) != 1.5f32:
        ok = false
    if ok:
        print "PASS float-mod-floored-semantics"
    else:
        print "FAIL float-mod-floored-semantics"
    0
