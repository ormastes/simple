# Native float `%` fixture: the seed LLVM backend rejected f64 Mod with
# `Unsupported float binop: Mod` (src/runtime/simple_core/core_any_ops.spl:94).
# Expected values are truncated (C fmod, sign of the dividend), matching the seed
# interpreter (interpreter/expr/ops.rs) and both rt_any_mod runtime twins. The
# cranelift backend is floored; that divergence is an open owner decision. f32 is
# not covered: on the seed LLVM/core-C lane even f32 `a + b` through a function
# returns 0.0 (separate defect). See
# doc/08_tracking/bug/seed_llvm_float_mod_unsupported_blocks_simple_core_archive_2026-11-22.md.

fn f64_mod(a: f64, b: f64) -> f64:
    a % b

fn main() -> i64:
    val a = f64_mod(7.5, 2.0)
    val b = f64_mod(-7.5, 2.0)
    val c = f64_mod(7.5, -2.0)
    val d = f64_mod(-7.5, -2.0)
    if a == 1.5 and b == -1.5 and c == 1.5 and d == -1.5:
        print "PASS float-mod-truncated-semantics"
    else:
        print "FAIL float-mod-truncated-semantics a={a} b={b} c={c} d={d}"
    0
