type FunctionsByName = {text: i64}

struct ParserModule:
    functions: Dict<text, i64>

struct AliasModule:
    functions: FunctionsByName

class NominalCounter:
    marker: i64
    fn len() -> i64:
        self.marker
    fn length() -> i64:
        self.marker + 5

pub fn dict_len_sequence() -> i64:
    var functions: Dict<text, i64> = {}
    if functions.len() != 0:
        return 101
    functions.set("first", 1)
    if functions.len() != 1:
        return 102
    functions.set("first", 7)
    if functions.len() != 1:
        return 103
    functions.set("second", 2)
    if functions.length() != 2:
        return 104
    functions.remove("first")
    if functions.len() != 1:
        return 105
    functions.remove("second")
    if functions.len() != 0:
        return 106
    return 0

pub fn dict_len_field() -> i64:
    val module = ParserModule(functions: {"first": 11, "second": 12})
    return module.functions.len()

pub fn dict_len_alias_field() -> i64:
    val module = AliasModule(functions: {"first": 11})
    return module.functions.length()

pub fn dict_len_nominal() -> i64:
    val counter = NominalCounter(marker: 23)
    return counter.len()

pub fn dict_len_nominal_length() -> i64:
    val counter = NominalCounter(marker: 23)
    return counter.length()

pub fn dict_len_alias_local() -> i64:
    val functions: FunctionsByName = {"first": 1, "second": 2, "third": 3}
    return functions.length()

pub fn dict_len_parameter(functions: Dict<text, i64>) -> i64:
    return functions.len()

pub fn dict_len_parameter_case() -> i64:
    return dict_len_parameter({"first": 1, "second": 2})

pub fn dict_len_make() -> Dict<text, i64>:
    return {"one": 1}

pub fn dict_len_receiver_once() -> i64:
    return dict_len_make().len()
