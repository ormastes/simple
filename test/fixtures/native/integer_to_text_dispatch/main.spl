use std.common.sdn.value.{SdnValue}

type I32Alias = i32
type I32Alias2 = I32Alias

fn cache_key_frame(value: text) -> text:
    value.len().to_text() + ":" + value

fn frame_i32(value: i32) -> text:
    cache_key_frame(value.to_text())

fn main() -> i64:
    val signed_min: i64 = -9223372036854775807 - 1
    val unsigned_max: u64 = 18446744073709551615u64
    val row = (-7 as i8).to_text() + "|" + (-1234 as i16).to_text() + "|" + (-123456 as i32).to_text() + "|" + signed_min.to_text() + "|" + (255 as u8).to_text() + "|" + (65535 as u16).to_text() + "|" + (4294967295 as u32).to_text() + "|" + unsigned_max.to_text()
    val alias_value: I32Alias2 = -42
    val alias_text = alias_value.to_text()
    val framed_zero = frame_i32(0)
    val scalars = true.to_text() + "|" + false.to_text() + "|" + (1.5 as f32).to_text() + "|" + (-2.5 as f64).to_text() + "|" + (955 as char).to_text()
    val sdn_text = SdnValue.Int(7).to_text()
    val expected = "-7|-1234|-123456|-9223372036854775808|255|65535|4294967295|18446744073709551615"
    if row != expected or alias_text != "-42" or framed_zero != "1:0" or scalars != "true|false|1.5|-2.5|λ" or sdn_text != "7":
        print("FAIL integer-text row=" + row + " alias=" + alias_text + " frame=" + framed_zero + " scalars=" + scalars + " sdn=" + sdn_text)
        return 1
    print("PASS primitive-text-width-alias-frame-and-sdn")
    0
