# Exercise the production owner without requiring installed GPU hardware.
use lib.nogc_sync_mut.gpu.engine2d.sffi_cuda.{CudaFfi}
use lib.nogc_sync_mut.gpu.engine2d.sffi_dispatch.{GpuFfiMode}

fn initialize_cuda(ffi: CudaFfi) -> bool:
    ffi.init()

fn main() -> i64:
    val unavailable = CudaFfi(_mode: GpuFfiMode.Dynamic, _dyn_lib: nil)
    if initialize_cuda(unavailable):
        return 11
    if unavailable.mode() != GpuFfiMode.Dynamic:
        return 12
    if unavailable.is_available():
        return 13
    if unavailable.shutdown():
        return 14
    val static_ffi = CudaFfi.create_static()
    if static_ffi.mode() != GpuFfiMode.Static:
        return 15
    print "cuda-ffi-init-receiver: PASS cases=5"
    0
