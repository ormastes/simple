use .outer.{value}

fn aliased() -> i64:
    use .inner.{value as selected}
    selected()

fn shadowed() -> i64:
    use .inner.{value}
    value()

fn second_scope() -> i64:
    use .inner.{value as selected}
    selected()

fn nested_scope() -> i64:
    var inside = 0
    if true:
        use .inner.{value}
        inside = value()
    inside + value()

fn lazy_scope() -> i64:
    use lazy .inner.{value as selected}
    selected()

fn main():
    assert(aliased() == 22)
    assert(shadowed() == 22)
    assert(second_scope() == 22)
    assert(nested_scope() == 33)
    assert(lazy_scope() == 22)
    assert(value() == 11)
    print "local-use: 6 checks passed"
