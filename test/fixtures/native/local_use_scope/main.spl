use .outer.{value, State, Box, Label}

fn aliased() -> i64:
    use .inner.{value as selected}
    selected()

fn shadowed() -> i64:
    use .inner.{value}
    value()

fn second_scope() -> i64:
    use .inner.{value as selected}
    selected()

fn nested_scope() -> i64:
    var inside = 0
    if true:
        use .inner.{value}
        inside = value()
    inside + value()

fn lazy_scope() -> i64:
    use lazy .inner.{value as selected}
    selected()

fn enum_shadowed() -> i64:
    use .inner.{State}
    val state = State.Inner("abc")
    match state:
        case State.Inner(message): message.len()
        case _: -1

fn enum_second_scope() -> i64:
    use .inner.{State as Selected}
    val state = Selected.Inner("hello")
    match state:
        case Selected.Inner(message): message.len()
        case _: -1

fn enum_nested_restore() -> i64:
    var inside = 0
    if true:
        use .inner.{State}
        val inner = State.Inner("abcd")
        match inner:
            case State.Inner(message): inside = message.len()
            case _: inside = -100
    val outer = State.Outer(7)
    match outer:
        case State.Outer(number): inside + number
        case _: -1

fn class_shadowed() -> i64:
    use .inner.{Box}
    val box = Box(message: "hello")
    box.message.len()

fn class_second_scope() -> i64:
    use .inner.{Box as Selected}
    val box = Selected(message: "abc")
    box.message.len()

fn alias_shadowed() -> i64:
    use .inner.{Label}
    val label: Label = "hello"
    label.len()

fn alias_second_scope() -> i64:
    # Even an import used only for later type metadata must establish its
    # declaring-owner key; this previously failed before the function body.
    use .inner.{Measure as LocalMeasure}
    use .inner.{Label as Selected}
    val label: Selected = "abc"
    label.len()

fn main():
    assert(aliased() == 22)
    assert(shadowed() == 22)
    assert(second_scope() == 22)
    assert(nested_scope() == 33)
    assert(lazy_scope() == 22)
    assert(value() == 11)
    assert(enum_shadowed() == 3)
    assert(enum_second_scope() == 5)
    assert(enum_nested_restore() == 11)
    assert(class_shadowed() == 5)
    assert(class_second_scope() == 3)
    assert(alias_shadowed() == 5)
    assert(alias_second_scope() == 3)
    val outer_box = Box(number: 13)
    assert(outer_box.number == 13)
    val outer_label: Label = 17
    assert(outer_label == 17)
    print "local-use: 15 checks passed"
