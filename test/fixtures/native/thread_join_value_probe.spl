# Native probe: thread spawn/join must hand back the worker's value unchanged.
# Prints one line per case; the spec test/01_unit/lib/concurrent/thread_join_native_value_spec.spl
# runs the natively built binary and checks every line.
use std.concurrent.thread.{thread_spawn, thread_spawn_with_args, thread_join_by_id, thread_spawn_with_i64_args_id}

fn main():
    val h1 = thread_spawn(\: 1)
    match h1.join():
        case Some(v): print "i64_one={v}"
        case None: print "i64_one=none"
    val h2 = thread_spawn(\: 42)
    match h2.join():
        case Some(v): print "i64_42={v}"
        case None: print "i64_42=none"
    val h3 = thread_spawn_with_args(20, 22, \a, b: a + b)
    match h3.join():
        case Some(v): print "args_sum={v}"
        case None: print "args_sum=none"
    val id = thread_spawn_with_i64_args_id(5, 6, \a, b: a * b)
    match thread_join_by_id(id):
        case Some(v): print "by_id={v}"
        case None: print "by_id=none"
    match h1.join():
        case Some(v): print "rejoin={v}"
        case None: print "rejoin=none"
