# Exercise the production ROCm owner without requiring an AMD device/provider.
use std.gpu.engine2d.sffi_dispatch.{GpuFfiMode}
use lib.nogc_sync_mut.gpu.engine2d.sffi_rocm.{RocmFfi}

fn rocm_initialize(ffi: RocmFfi) -> bool:
    ffi.init()

fn main() -> i64:
    val ffi = RocmFfi(_mode: GpuFfiMode.Dynamic, _dyn_lib: nil)
    if ffi.mode() != GpuFfiMode.Dynamic:
        return 11
    if rocm_initialize(ffi):
        return 12
    if ffi.is_available():
        return 13
    if not ffi.shutdown():
        return 14
    val static_ffi = RocmFfi.create_static()
    if static_ffi.mode() != GpuFfiMode.Static:
        return 15
    if RocmFfi.create_dynamic_from("/definitely/missing/libamdhip64.dylib") != nil:
        return 16
    print "rocm-init-receiver: PASS cases=6 provider=absent"
    0
