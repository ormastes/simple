# Native regression: compile through the pure-Simple frontend.
# Unit pattern is Tuple([]); nil remains a distinct literal pattern.
enum UnitPayload:
    Pair(value: ((), i64))
    Separate(unit: (), number: i64)
    Other(number: i64)

var guard_calls = 0

fn reject_once() -> bool:
    guard_calls = guard_calls + 1
    false

fn unit_result(value: Result<(), text>) -> i64:
    match value:
        case Ok(()): 11
        case Err(message): if message == "no": 22 else: -1

fn unit_result_reversed(value: Result<(), text>) -> i64:
    match value:
        case Err(message): if message == "no": 22 else: -1
        case Ok(()): 11

fn payload_number(value: UnitPayload) -> i64:
    match value:
        case UnitPayload.Pair(((), number)): number + 10
        case UnitPayload.Separate((), number): number + 20
        case UnitPayload.Other(number): number + 30

fn guarded_unit(value: Result<(), text>) -> i64:
    match value:
        case Ok(()) if reject_once(): -100
        case Ok(()): 33
        case Err(message): 44

fn nil_control(value: Result<i64?, text>) -> i64:
    match value:
        case Ok(nil): 51
        case Ok(Some(number)): number
        case Err(message): 53

fn main() -> i64:
    if unit_result(Ok(())) != 11: return 1
    if unit_result(Err("no")) != 22: return 2
    if unit_result_reversed(Ok(())) != 11: return 3
    if unit_result_reversed(Err("no")) != 22: return 4
    if payload_number(UnitPayload.Pair(((), 7))) != 17: return 5
    if payload_number(UnitPayload.Separate((), 8)) != 28: return 6
    if payload_number(UnitPayload.Other(9)) != 39: return 7
    guard_calls = 0
    if guarded_unit(Err("no")) != 44: return 8
    if guard_calls != 0: return 9
    if guarded_unit(Ok(())) != 33: return 10
    if guard_calls != 1: return 11
    if nil_control(Ok(nil)) != 51: return 12
    if nil_control(Ok(Some(52))) != 52: return 13
    if nil_control(Err("no")) != 53: return 14
    print "unit-pattern: 14 checks passed"
    0
