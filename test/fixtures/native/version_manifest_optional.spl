use app.devhub.version_manifest.{parse_version_manifest, render_version_manifest}

fn fixture() -> text:
    "version:\n  schema: simple-release-version/1\n  product: simple\n  semver: 1.4.2\n  line: 1.4\n  channel: stable\ncompatibility:\n  public_api_major: 1\n  compiler_abi: 1\n  bootstrap_protocol: 1\n  package_format: 1\n  scv_store_schema: 1\n  scv_wire_protocol: 1\n  devhub_provider_api: 1\n  spipe_skill_api: 1\n  release_manifest_schema: 1\n  bootstrap_receipt_schema: 1\nprojections:\n  - VERSION\n  - src/app/simple.sdn\n"

fn main() -> i64:
    val manifest = parse_version_manifest(fixture())
    if not manifest.valid:
        return 1
    val rendered = render_version_manifest(manifest)
    if not rendered.contains("  - VERSION\n  - src/app/simple.sdn\n"):
        return 2
    val reparsed = parse_version_manifest(rendered)
    if not reparsed.valid or reparsed.projections.len() != 2:
        return 3
    if reparsed.projections.join(",") != "VERSION,src/app/simple.sdn":
        return 4
    print("manifest projections PASS")
    0
