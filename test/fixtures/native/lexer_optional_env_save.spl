# Compile against the real lexer; run with SIMPLE_BOOTSTRAP_LEX_ENV_SAVE
# unset, empty, 0, and 1. Assertions cover tokens and the optional state sink.
use compiler.frontend.core.lexer.{lex_init, lex_next, lex_token_text, lex_token_line, lex_token_col}
use std.io_runtime.{env_get_nullable, exit}

fn require_equal(actual: text, expected: text, label: text) -> ():
    if actual != expected:
        print "FAIL {label}: expected '{expected}', got '{actual}'"
        exit(1)

fn require_token(kind: i64, token_text: text, line: i64, col: i64) -> ():
    val actual_kind = lex_next()
    require_equal("{actual_kind}", "{kind}", "token kind")
    require_equal(lex_token_text(), token_text, "token text")
    require_equal("{lex_token_line()}", "{line}", "token line")
    require_equal("{lex_token_col()}", "{col}", "token column")

fn require_env(key: text, expected: text) -> ():
    require_equal(env_get_nullable(key) ?? "", expected, key)

fn main() -> i32:
    val save_enabled = (env_get_nullable("SIMPLE_BOOTSTRAP_LEX_ENV_SAVE") ?? "") == "1"
    lex_init("alpha(beta)\ngamma")
    require_token(6, "alpha", 1, 1)
    if save_enabled:
        require_env("SIMPLE_BOOTSTRAP_LEX_POS", "5")
        require_env("SIMPLE_BOOTSTRAP_LEX_COL", "6")
        require_env("SIMPLE_BOOTSTRAP_LEX_LINE_START", "0")
    require_token(140, "(", 1, 6)
    if save_enabled:
        require_env("SIMPLE_BOOTSTRAP_LEX_PAREN", "1")
    require_token(6, "beta", 1, 7)
    require_token(141, ")", 1, 11)
    require_token(180, "\n", 1, 12)
    if save_enabled:
        require_env("SIMPLE_BOOTSTRAP_LEX_LINE_START", "1")
        require_env("SIMPLE_BOOTSTRAP_LEX_LINE", "2")
        require_env("SIMPLE_BOOTSTRAP_LEX_COL", "1")
    require_token(6, "gamma", 2, 1)
    if save_enabled:
        require_env("SIMPLE_BOOTSTRAP_LEX_POS", "17")
        require_env("SIMPLE_BOOTSTRAP_LEX_LINE", "2")
        require_env("SIMPLE_BOOTSTRAP_LEX_COL", "6")
        require_env("SIMPLE_BOOTSTRAP_LEX_LINE_START", "0")
    else:
        require_env("SIMPLE_BOOTSTRAP_LEX_POS", "0")
        require_env("SIMPLE_BOOTSTRAP_LEX_LINE", "1")
        require_env("SIMPLE_BOOTSTRAP_LEX_COL", "1")
        require_env("SIMPLE_BOOTSTRAP_LEX_LINE_START", "1")
    require_env("SIMPLE_BOOTSTRAP_LEX_PAREN", "0")
    require_env("SIMPLE_BOOTSTRAP_LEX_PENDING", "0")
    require_env("SIMPLE_BOOTSTRAP_LEX_INDENT", "0")
    require_equal("{lex_next()}", "190", "EOF")
    print "lexer-optional-env-save-pass"
    0
