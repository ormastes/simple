use probe.ports.{CallbackPort, make_gpu_port, make_counted_port, construction_count, maybe_port, spl_language_manifest}
use probe.other.{other_result}

extern fn spl_ordered_key_cmp(left: i64, right: i64) -> i64

fn inferred_callback(candidate: CallbackPort?) -> i64:
    val selected = candidate ?? make_gpu_port()
    selected.invoke_fn(selected.state, 2)

fn annotated_callback(candidate: CallbackPort?) -> i64:
    val selected: CallbackPort = candidate ?? make_gpu_port()
    selected.invoke_fn(selected.state, 2)

fn nil_fallback(candidate: CallbackPort?) -> CallbackPort?:
    candidate ?? nil

fn optional_fallback(candidate: CallbackPort?, fallback: CallbackPort?) -> CallbackPort?:
    candidate ?? fallback

fn main() -> i64:
    val port = make_gpu_port()
    if not port.supports_fn("emit-gpu"):
        return 1
    if port.supports_fn("emit-source"):
        return 2
    if other_result():
        return 3
    if spl_language_manifest() != 42:
        return 4
    if spl_ordered_key_cmp(1, 1) != 0:
        return 5
    if inferred_callback(maybe_port(false)) != 42:
        return 6
    if inferred_callback(maybe_port(true)) != 72:
        return 7
    if annotated_callback(maybe_port(false)) != 42 or annotated_callback(maybe_port(true)) != 72:
        return 8
    if make_counted_port().invoke_fn(50, 3) != 53 or construction_count() != 1:
        return 9
    if port.owner_state() != 40:
        return 10
    print "symbol-owner-binding PASS"
    return 0
