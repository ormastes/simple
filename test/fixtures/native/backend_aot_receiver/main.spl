use support.{MirModule, MirStorageViewSiteBindingV1, BuiltinBackendCompileAdapter, DynamicBackendAdapter, require_native}
use session.{BackendSession}

fn main() -> i64:
    val module = MirModule(marker: 101)
    val bindings = [MirStorageViewSiteBindingV1(marker: 303)]
    val builtin = BackendSession(Some(BuiltinBackendCompileAdapter(marker: 707)), nil, false)
    require_native(builtin.compile_aot_into_path(module, true, 2, "cpu-sentinel", bindings, "builtin-object", "builtin-diagnostic") == 0)
    require_native(builtin.compile_aot_into_path(MirModule(marker: 102), true, 2, "cpu-sentinel", bindings, "builtin-object", "builtin-diagnostic") != 0)
    require_native(builtin.compile_aot_into_path(module, false, 2, "cpu-sentinel", bindings, "builtin-object", "builtin-diagnostic") != 0)
    require_native(builtin.compile_aot_into_path(module, true, 3, "cpu-sentinel", bindings, "builtin-object", "builtin-diagnostic") != 0)
    require_native(builtin.compile_aot_into_path(module, true, 2, "wrong-cpu", bindings, "builtin-object", "builtin-diagnostic") != 0)
    require_native(builtin.compile_aot_into_path(module, true, 2, "cpu-sentinel", [MirStorageViewSiteBindingV1(marker: 304)], "builtin-object", "builtin-diagnostic") != 0)
    require_native(builtin.compile_aot_into_path(module, true, 2, "cpu-sentinel", bindings, "wrong-object", "builtin-diagnostic") != 0)
    require_native(builtin.compile_aot_into_path(module, true, 2, "cpu-sentinel", bindings, "builtin-object", "wrong-diagnostic") != 0)
    val wrong_builtin = BackendSession(Some(BuiltinBackendCompileAdapter(marker: 708)), nil, false)
    require_native(wrong_builtin.compile_aot_into_path(module, true, 2, "cpu-sentinel", bindings, "builtin-object", "builtin-diagnostic") != 0)
    val dynamic = BackendSession(nil, Some(DynamicBackendAdapter(marker: 909)), false)
    require_native(dynamic.compile_aot_into_path(module, true, 2, "cpu-sentinel", bindings, "dynamic-object", "dynamic-diagnostic") == 0)
    require_native(dynamic.compile_aot_into_path(module, true, 2, "cpu-sentinel", bindings, "wrong-object", "dynamic-diagnostic") != 0)
    require_native(dynamic.compile_aot_into_path(module, true, 2, "cpu-sentinel", bindings, "dynamic-object", "wrong-diagnostic") != 0)
    val closed = BackendSession(Some(BuiltinBackendCompileAdapter(marker: 707)), nil, true)
    require_native(closed.compile_aot_into_path(module, true, 2, "cpu-sentinel", bindings, "builtin-object", "closed-diagnostic") == 1)
    val missing = BackendSession(nil, nil, false)
    require_native(missing.compile_aot_into_path(module, true, 2, "cpu-sentinel", bindings, "builtin-object", "missing-diagnostic") == 1)
    print "backend-aot-receiver-pass"
    0
