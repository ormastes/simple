# Small ABI model: no real MIR lowering, provider loading, or filesystem output.
extern fn rt_exit(code: i64)

fn require_native(condition: bool):
    if not condition:
        print "backend-aot-receiver-check-failed"
        rt_exit(99)

struct MirModule:
    marker: i64

struct MirStorageViewSiteBindingV1:
    marker: i64

fn transport_valid(module: MirModule, is_release: bool, opt_level: i64,
                   target_cpu: text, storage_bindings: [MirStorageViewSiteBindingV1]) -> bool:
    module.marker == 101 and is_release and opt_level == 2 and target_cpu == "cpu-sentinel" and storage_bindings.len() == 1 and storage_bindings[0].marker == 303

fn backend_aot_write_diagnostic(path: text, message: text) -> bool:
    # Each failure has a distinct caller-owned destination and exact message.
    if path == "closed-diagnostic":
        require_native(message == "backend session is closed")
    elif path == "missing-diagnostic":
        require_native(message == "backend session has no AOT adapter")
    else:
        require_native(false)
    print "diagnostic={path}:{message}"
    true

class BuiltinBackendCompileAdapter:
    marker: i64

    fn compile_aot_module(
        module: MirModule,
        is_release: bool,
        opt_level: i64,
        target_cpu: text,
        storage_bindings: [MirStorageViewSiteBindingV1]
    ) -> i64:
        if self.marker != 707 or not transport_valid(module, is_release, opt_level, target_cpu, storage_bindings):
            return 1
        0

    fn compile_aot_into_path(
        self, module: MirModule, is_release: bool, opt_level: i64, target_cpu: text,
        storage_bindings: [MirStorageViewSiteBindingV1], object_path: text,
        diagnostic_path: text
    ) -> i64:
        if object_path != "builtin-object" or diagnostic_path != "builtin-diagnostic":
            return 1
        self.compile_aot_module(module, is_release, opt_level, target_cpu, storage_bindings)

class DynamicBackendAdapter:
    marker: i64

    fn compile_aot_into_path(
        self, module: MirModule, is_release: bool, opt_level: i64, target_cpu: text,
        storage_bindings: [MirStorageViewSiteBindingV1], object_path: text,
        diagnostic_path: text
    ) -> i64:
        if self.marker != 909 or not transport_valid(module, is_release, opt_level, target_cpu, storage_bindings):
            return 1
        if object_path != "dynamic-object" or diagnostic_path != "dynamic-diagnostic":
            return 1
        0

export MirModule, MirStorageViewSiteBindingV1, BuiltinBackendCompileAdapter, DynamicBackendAdapter, backend_aot_write_diagnostic, require_native
