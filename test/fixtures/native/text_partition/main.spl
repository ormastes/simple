struct LocalPartition:
    value: i64

impl LocalPartition:
    fn partition(self, separator: text) -> i64:
        self.value

fn once_receiver() -> text:
    print "receiver-once"
    "left:right"

fn once_separator() -> text:
    print "separator-once"
    ":"

fn parts_equal(parts: [text], before: text, separator: text, after: text) -> bool:
    parts.len() == 3 and parts[0] == before and parts[1] == separator and parts[2] == after

fn main() -> i64:
    val separator: text = "="
    if not parts_equal("a=b=c".partition(separator), "a", "=", "b=c"):
        return 11
    if not parts_equal("a=b=c".rpartition(separator), "a=b", "=", "c"):
        return 12
    if not parts_equal("abc".partition("?"), "abc", "", ""):
        return 13
    if not parts_equal("abc".rpartition("?"), "", "", "abc"):
        return 14
    if not parts_equal("abc".partition(""), "abc", "", ""):
        return 15
    if not parts_equal("abc".rpartition(""), "", "", "abc"):
        return 16
    if not parts_equal("".partition("x"), "", "", ""):
        return 17
    if not parts_equal("한글:é".partition(":"), "한글", ":", "é"):
        return 18
    if not parts_equal(once_receiver().partition(once_separator()), "left", ":", "right"):
        return 19
    val local = LocalPartition(value: 73)
    if local.partition("ignored") != 73:
        return 20
    print "partition native pass"
    0
