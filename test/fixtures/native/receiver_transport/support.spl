class ReceiverTransport:
    marker: i64

    fn read_marker(self, extra: i64) -> i64:
        self.marker + extra

    fn stack_sum(self, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64) -> i64:
        self.marker + a + b + c + d + e + f + g + h + i

export ReceiverTransport
