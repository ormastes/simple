use support.{ReceiverTransport}

fn typed_read(receiver: ReceiverTransport) -> i64:
    receiver.read_marker(7)

fn typed_stack(receiver: ReceiverTransport) -> i64:
    receiver.stack_sum(1, 2, 3, 4, 5, 6, 7, 8, 9)

fn main() -> i64:
    val receiver = ReceiverTransport(marker: 100)
    val value = typed_read(receiver)
    print "typed={value}"
    if value != 107:
        return 1
    val total = typed_stack(receiver)
    print "stack={total}"
    if total != 145:
        return 2
    0
