use std.nogc_sync_mut.runtime.thread_local.{rt_thread_local_new, rt_thread_local_get, rt_thread_local_set, rt_thread_local_free}

pub fn thread_local_boundary_probe() -> i64:
    val handle = rt_thread_local_new()
    if handle <= 0: return 1
    if rt_thread_local_get(handle) != 0: return 2
    rt_thread_local_set(handle, -47)
    if rt_thread_local_get(handle) != -47: return 3
    rt_thread_local_set(handle, 0)
    if rt_thread_local_get(handle) != 0: return 4
    rt_thread_local_free(handle)
    val replacement = rt_thread_local_new()
    if replacement <= handle: return 5
    rt_thread_local_set(handle, 99)
    if rt_thread_local_get(replacement) != 0: return 6
    rt_thread_local_free(replacement)
    if rt_thread_local_get(handle) != 0: return 7
    0
