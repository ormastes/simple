# The projection inserts the production witness call in make_witness.
fn main() -> i64:
    val config = NativeModuleConfigFactV1(
        compiler_identity: "compiler", target_identity: "target",
        options_identity: "options", provider_identity: "provider")
    val empty = make_witness("consumer", "mir-empty", [], config)
    if not empty.valid or empty.module_id != "consumer" or empty.mir_identity != "mir-empty":
        return 11
    val deps = [ActionDep(module_id: "dependency", iface_digest: "iface-one")]
    val populated = make_witness("consumer", "mir-populated", deps, config)
    if not populated.valid or populated.mir_identity != "mir-populated":
        return 12
    if populated.dependency_fold == empty.dependency_fold:
        return 13
    val expected = native_module_cache_witness_v1(
        "consumer", "mir-populated", deps, [], [], config)
    if populated.dependency_fold != expected.dependency_fold or populated.config_fingerprint != expected.config_fingerprint:
        return 14
    val missing = make_witness("", "mir-empty", [], config)
    if missing.valid or missing.reason != "missing-module-id":
        return 15
    val malformed = make_witness("consumer", "mir-empty", [ActionDep(module_id: "dependency", iface_digest: "")], config)
    if malformed.valid or malformed.reason != "missing-dependency-fact":
        return 16
    print "native-cache-receiver-pass"
    0
