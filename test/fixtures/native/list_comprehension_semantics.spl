# Exact stdout is the side-effect oracle; exit codes identify value failures.
fn values() -> [i64]:
    print("iterable")
    [1, 2, 3, 4]

fn keep(value: i64) -> bool:
    print("filter:" + value.to_text())
    value % 2 == 0

fn project(value: i64) -> text:
    print("project:" + value.to_text())
    "v" + value.to_text()

fn main() -> i64:
    val value = 99
    val mapped = [for value in values() if keep(value): project(value)]
    if mapped.len() != 2 or mapped.join(",") != "v2,v4":
        return 1
    if value != 99:
        return 2
    val source = ["left", "right"]
    val shadowed = [for source in source: source + "!"]
    if shadowed.join(",") != "left!,right!" or source.join(",") != "left,right":
        return 3
    val empty: [i64] = []
    val empty_text = [for item in empty: item.to_text()]
    if empty_text.len() != 0:
        return 4
    val rejected = [for item in [1, 3] if item % 2 == 0: project(item)]
    if rejected.len() != 0:
        return 5
    val doubled = [for item in 0..4: item * 2]
    if doubled.len() != 4 or doubled[0] != 0 or doubled[3] != 6:
        return 6
    val nested = [for x in [1, 2]: [for y in [3, 4]: x + y]]
    if nested.len() != 2 or nested[0][0] != 4 or nested[1][1] != 6:
        return 7
    val sums = [for (x, y) in [(1, 2), (3, 4)]: x + y]
    if sums.len() != 2 or sums[0] != 3 or sums[1] != 7:
        return 8
    val chars = [for letter in "ab": letter + "!"]
    if chars.join(",") != "a!,b!":
        return 9
    val unicode_chars = [for letter in "é🦀": letter + "!"]
    if unicode_chars.len() != 2 or unicode_chars.join(",") != "é!,🦀!":
        return 10
    print("comprehension PASS")
    0
