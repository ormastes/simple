# Native regression: insert and existing-ID update must both return normally.
use compiler.mir.mir_lowering.{MirLowering}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolTable}
use compiler.common.diagnostics.span.{Span}

extern fn rt_exit(code: i64)

fn require(condition: bool) -> ():
    if not condition:
        rt_exit(99)

fn main() -> ():
    var lowering = MirLowering.new(SymbolTable.new())
    val span = Span(start: 0, end: 0, line: 1, col: 1, file: "native-metadata", length: 0)
    val integer = HirType(kind: HirTypeKind.Int(64, true), span: span)
    lowering.remember_local_hir_type(901, integer, 2, 0)
    require(lowering.local_hir_type_ids.len() == 1)
    require(lowering.local_hir_type_values.len() == 1)
    require(lowering.local_hir_type_isolation_states[0] == 2)
    require(lowering.local_hir_type_resource_states[0] == 0)
    print("mir-local-metadata-insert-pass")
    lowering.remember_local_hir_type(901, integer, 1, 1)
    require(lowering.local_hir_type_ids.len() == 1)
    require(lowering.local_hir_type_values.len() == 1)
    require(lowering.local_hir_type_isolation_states[0] == 1)
    require(lowering.local_hir_type_resource_states[0] == 1)
    lowering.remember_local_hir_type(902, integer, -3, 9)
    require(lowering.local_hir_type_ids.len() == 2)
    require(lowering.local_hir_type_values.len() == 2)
    require(lowering.local_hir_type_isolation_states[1] == 0)
    require(lowering.local_hir_type_resource_states[1] == 0)
    lowering.remember_local_hir_type(902, integer, 2, 1)
    require(lowering.local_hir_type_ids.len() == 2)
    require(lowering.local_hir_type_isolation_states[1] == 2)
    require(lowering.local_hir_type_resource_states[1] == 1)
    lowering.remember_local_hir_type(901, integer, 42, -1)
    require(lowering.local_hir_type_isolation_states[0] == 0)
    require(lowering.local_hir_type_resource_states[0] == 0)
    require(lowering.local_hir_type_isolation_states[1] == 2)
    require(lowering.local_hir_type_resource_states[1] == 1)
    print("mir-local-metadata-update-pass")
