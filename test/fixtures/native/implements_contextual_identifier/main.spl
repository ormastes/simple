# Expected stdout implements-contextual-identifier PASS; expected exit 0.
fn length(implements: [i64]) -> i64:
    val offset = -1
    implements.len() + offset

fn sink(interface_groups: [i64]) -> i64:
    interface_groups[0]

fn main() -> i64:
    val implements = [7, 9]
    if length(implements) != 1:
        return 101
    if sink(interface_groups: implements) != 7:
        return 102
    if -implements[0] != -7:
        return 103
    if implements[1] - implements[0] != 2:
        return 104
    print("implements-contextual-identifier PASS")
    0
