# Chained float math method -> integer cast, and `[v; n]` with a non-literal
# fill and a computed count. Every check function returns an i64; `main`
# returns a bitmask of failures (0 = all pass) so the interpreter, the JIT and
# a native build all answer the same question.
# doc/08_tracking/bug/float_method_chain_to_i64_returns_bits_2026-11-24.md
# doc/08_tracking/bug/array_repeat_nonliteral_fill_computed_count_2026-11-24.md

fn ceil_to_i64(x: f64) -> i64:
    x.ceil().to_i64()
fn floor_to_i64(x: f64) -> i64:
    x.floor().to_i64()
fn round_to_i64(x: f64) -> i64:
    x.round().to_i64()
fn trunc_to_i64(x: f64) -> i64:
    x.trunc().to_i64()
fn sqrt_to_i64(x: f64) -> i64:
    x.sqrt().to_i64()
fn abs_to_int(x: f64) -> i64:
    x.abs().to_int()
fn ceil_to_i32(x: f64) -> i64:
    x.ceil().to_i32() as i64
fn f32_floor_to_i64(x: f32) -> i64:
    x.floor().to_i64()
fn deep_chain(x: f64) -> i64:
    x.ceil().sqrt().to_i64()
fn repeat_param_fill(full: i64, len: i64) -> i64:
    val al: [i64] = [full; len + 1]
    al[0] + al[len] * 1000 + al.len() * 1000000
fn repeat_param_count(full: i64, n: i64) -> i64:
    val al: [i64] = [full; n]
    al[n - 1] + al.len() * 1000

fn main() -> i64:
    var mask = 0
    if ceil_to_i64(0.4) != 1: mask = mask + 1
    if floor_to_i64(-2.6) != -3: mask = mask + 2
    if round_to_i64(2.6) != 3: mask = mask + 4
    if trunc_to_i64(-2.6) != -2: mask = mask + 8
    if sqrt_to_i64(26.0) != 5: mask = mask + 16
    if abs_to_int(-7.5) != 7: mask = mask + 32
    if ceil_to_i32(0.4) != 1: mask = mask + 64
    if f32_floor_to_i64(2.6) != 2: mask = mask + 128
    if deep_chain(15.2) != 4: mask = mask + 256
    if repeat_param_fill(64, 2) != 3064064: mask = mask + 512
    if repeat_param_fill(5, 2) != 3005005: mask = mask + 1024
    if repeat_param_count(7, 2) != 2007: mask = mask + 2048
    if mask == 0:
        print("float-chain-repeat PASS")
    else:
        print("float-chain-repeat FAIL mask={mask}")
    mask
