use std.nogc_sync_mut.debug.remote.session_model.{DebugExecutionMode, DebugTransportKind}
use std.nogc_sync_mut.debug.remote.types.{Architecture}

fn execution_name(value: DebugExecutionMode) -> text:
    value.to_string()

fn transport_name(value: DebugTransportKind) -> text:
    value.to_string()

fn architecture_name(value: Architecture) -> text:
    value.to_string()

fn main() -> i64:
    if execution_name(DebugExecutionMode.Hw) != "hw": return 1
    if execution_name(DebugExecutionMode.RtlSim) != "rtl_sim": return 2
    if execution_name(DebugExecutionMode.QemuStub) != "qemu_stub": return 3
    if transport_name(DebugTransportKind.OpenocdJtag) != "openocd_jtag": return 4
    if transport_name(DebugTransportKind.OpenocdRemoteBitbang) != "openocd_remote_bitbang": return 5
    if transport_name(DebugTransportKind.IntelJtagd) != "intel_jtagd": return 6
    if transport_name(DebugTransportKind.Trace32Native) != "trace32_native": return 7
    if transport_name(DebugTransportKind.Trace32Gdb) != "trace32_gdb": return 8
    if transport_name(DebugTransportKind.GdbRemote) != "gdb_remote": return 9
    if architecture_name(Architecture.Arm32) != "arm32": return 10
    if architecture_name(Architecture.Arm64) != "arm64": return 11
    if architecture_name(Architecture.RiscV32) != "riscv32": return 12
    if architecture_name(Architecture.RiscV64) != "riscv64": return 13
    if architecture_name(Architecture.X86) != "x86": return 14
    if architecture_name(Architecture.X86_64) != "x86_64": return 15
    if architecture_name(Architecture.Avr) != "avr": return 16
    if architecture_name(Architecture.I8086) != "i8086": return 17
    if architecture_name(Architecture.Wasm32) != "wasm32": return 18
    if architecture_name(Architecture.Xtensa) != "xtensa": return 19
    print "PASS: 19 debug enum names use their Simple owners"
    return 0
