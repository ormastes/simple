# Native regression for the production reporter's two early returns and output.
# Run with SIMPLE_HIR_REEXPORT_STATS unset, empty, 0, and 1. Only 1 may emit
# stderr, exactly at 20000 and 40000; see the associated bug report for checks.
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering._Items.module_import_registration.*

extern fn rt_exit(code: i64)

fn require(condition: bool) -> ():
    if not condition:
        rt_exit(99)

fn main() -> ():
    var lowering = HirLowering.new()
    lowering.reexport_chase_memo_hits = 17
    lowering.reexport_root_memo_index["fixture-owner"] = 9
    for calls in [1, 19999, 20000, 20001, 40000]:
        lowering.reexport_chase_calls = calls
        lowering.report_reexport_chase_stats()
        require(lowering.reexport_chase_calls == calls)
        require(lowering.reexport_chase_memo_hits == 17)
        require(lowering.reexport_root_memo_index.len() == 1)
        require(lowering.reexport_root_memo_index["fixture-owner"] == 9)
        print("reexport-stats-returned-{calls}")
    print("reexport-stats-state-preserved")
