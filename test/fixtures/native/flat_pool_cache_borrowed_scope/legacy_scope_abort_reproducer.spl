# Negative probe: reproduces the former driver's ownership mismatch.
# Expected outcome with the affected producer/library: nested-scope panic.
use compiler.frontend.flat_ast_bridge.{flat_pool_capture_arm, parse_and_build_module_scoped}

@unsafe(reason: "reproduce caller-owned parser memory lifetime", capabilities: [ffi])
extern fn rt_transient_array_scope_begin() -> bool
@unsafe(reason: "cleanup only if the negative probe unexpectedly returns", capabilities: [ffi])
extern fn rt_transient_array_scope_end() -> bool

fn main() -> i64:
    var began = false
    unsafe(capabilities: [ffi]):
        began = rt_transient_array_scope_begin()
    if not began:
        return 2
    flat_pool_capture_arm()
    val parsed = parse_and_build_module_scoped(
        "fn probe() -> i64:\n    return 17\n", "scope_negative.spl", false)
    # The old call shape hides the existing parent scope from serialization.
    unsafe(capabilities: [ffi]):
        val ended = rt_transient_array_scope_end()
    3
