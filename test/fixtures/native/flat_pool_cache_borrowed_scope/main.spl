use test.fixtures.compiler.borrowed_scope_case.{borrowed_cache_scope_case, owned_cache_scope_case}

fn main() -> i64:
    val first = borrowed_cache_scope_case(false)
    if first != 0:
        return first
    val invalid = borrowed_cache_scope_case(true)
    if invalid != 0:
        return invalid + 30
    val owned = owned_cache_scope_case()
    if owned != 0:
        return owned
    borrowed_cache_scope_case(false)
