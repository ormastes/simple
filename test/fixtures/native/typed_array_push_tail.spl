# Typed-array push mutates the receiver and returns that array in tail position.
fn push_u8(out: [u8], value: u8):
    out.push(value)

fn push_u32(out: [u32], value: u32) -> [u32]:
    out.push(value)

fn push_u64(out: [u64], value: u64):
    out.append(value)

fn next_byte(calls: [u8]) -> u8:
    calls.push(1 as u8)
    42 as u8

fn main() -> i64:
    var bytes: [u8] = []
    var calls: [u8] = []
    val returned_bytes: [u8] = push_u8(bytes, next_byte(calls))
    if bytes.len() != 1: return 11
    if bytes[0] != 42 as u8: return 12
    if returned_bytes.len() != 1: return 13
    if returned_bytes[0] != 42 as u8: return 14
    if calls.len() != 1: return 15
    var words: [u32] = []
    val returned = push_u32(words, 123 as u32)
    if returned.len() != 1: return 21
    if returned[0] != 123 as u32: return 22
    var wide: [u64] = []
    val returned_wide: [u64] = push_u64(wide, 456 as u64)
    if wide.len() != 1: return 31
    if wide[0] != 456 as u64: return 32
    if returned_wide.len() != 1: return 33
    if returned_wide[0] != 456 as u64: return 34
    print "typed-array-push-tail: PASS"
    0
