# Projection dependencies: the freeze owner and capsule classes are extracted
# verbatim from production. MIR/storage serialization is modeled here; this
# fixture tests argument transport and identity guards, not real MIR encoding.
class MirModule:
    name: text
    functions: {text: text}
    statics: {text: text}
    constants: {text: text}
    types: {text: text}

class MirStorageViewSiteBindingV1:
    value: text

class MirTypedStorageViewEvidenceV1:
    value: text

fn native_capsule_mir_identity_v1(module: MirModule) -> text:
    "mir:" + module.name

fn frozen_storage_module_identity_v1(module_name: text,
    sites: [MirStorageViewSiteBindingV1], evidence: [MirTypedStorageViewEvidenceV1]) -> text:
    "storage:{module_name}:{sites.len()}:{evidence.len()}"

fn storage_identity_text_v1(value: text) -> text:
    "{value.len()}:{value}"
