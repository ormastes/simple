fn validate(capsule: FrozenNativeModuleCapsuleV1, provider: text) -> bool:
    driver_native_capsule_inputs_valid_v1(capsule, "cranelift", "aarch64-apple-darwin", true, 2, provider)

fn main() -> i64:
    val batch = make_batch("provider-receipt-a", {"probe": "witness-a"}, {"probe": "ok"})
    if not batch.ok: return 10
    val capsule = batch.capsules[0]
    if capsule.provider_receipt_hash != "provider-receipt-a": return 11
    if capsule.module_witness != "witness-a": return 12
    if capsule.module_witness_reason != "ok": return 13
    if not capsule.capsule_identity.starts_with("native-capsule-v1|"): return 14
    if capsule.capsule_identity != "native-capsule-v1|5:probe|9:mir:probe|17:storage:probe:0:0|12:source:probe|19:source-digest:probe|9:witness-a|2:ok|9:cranelift|18:provider-receipt-a|20:aarch64-apple-darwin|8:baseline|2|true|21:capsule-probe.probe.o": return 34
    if not capsule.provider_receipt_valid("provider-receipt-a"): return 35
    if capsule.provider_receipt_valid(""): return 36
    if not validate(capsule, "provider-receipt-a"): return 15
    if validate(capsule, "provider-receipt-b"): return 16
    if driver_native_capsule_inputs_valid_v1(capsule, "llvm", "aarch64-apple-darwin", true, 2, "provider-receipt-a"): return 17
    if driver_native_capsule_inputs_valid_v1(capsule, "cranelift", "wrong-target", true, 2, "provider-receipt-a"): return 18
    if driver_native_capsule_inputs_valid_v1(capsule, "cranelift", "aarch64-apple-darwin", false, 2, "provider-receipt-a"): return 19
    if driver_native_capsule_inputs_valid_v1(capsule, "cranelift", "aarch64-apple-darwin", true, 0, "provider-receipt-a"): return 20

    # Every identity-bearing input remains protected after the record crossing.
    capsule.provider_receipt_hash = "provider-receipt-b"
    if validate(capsule, "provider-receipt-b"): return 21
    capsule.provider_receipt_hash = "provider-receipt-a"
    capsule.module_witness = "witness-b"
    if validate(capsule, "provider-receipt-a"): return 22
    capsule.module_witness = "witness-a"
    capsule.module_witness_reason = "different-reason"
    if validate(capsule, "provider-receipt-a"): return 23
    capsule.module_witness_reason = "ok"
    capsule.source_identity = "mutated-source"
    if validate(capsule, "provider-receipt-a"): return 24
    capsule.source_identity = ""
    if validate(capsule, "provider-receipt-a"): return 25
    capsule.source_identity = "source-digest:probe"
    capsule.mir_module = MirModule(name: "mutated", functions: {}, statics: {}, constants: {}, types: {})
    if validate(capsule, "provider-receipt-a"): return 26
    capsule.mir_module = MirModule(name: "probe", functions: {}, statics: {}, constants: {}, types: {})
    capsule.storage_snapshot.module_identity = "mutated-storage"
    if validate(capsule, "provider-receipt-a"): return 27
    capsule.storage_snapshot.module_identity = "storage:probe:0:0"
    capsule.ok = false
    if validate(capsule, "provider-receipt-a"): return 28
    capsule.ok = true
    if not validate(capsule, "provider-receipt-a"): return 29

    val builtin = make_batch("", {}, {})
    val builtin_capsule = builtin.capsules[0]
    if builtin_capsule.provider_receipt_hash != "": return 30
    if builtin_capsule.module_witness != "": return 31
    if builtin_capsule.module_witness_reason != "missing-witness-facts": return 32
    if not validate(builtin_capsule, ""): return 33
    print "capsule-identity-transport-pass"
    0
