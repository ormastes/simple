use capsule_support.*
use capsule_support.{CompileContext, MirModule, FrozenNativeModuleCapsuleV1,
    FrozenNativeModuleCapsuleBatchV1}

fn make_batch(provider_receipt_hash: text, frozen_module_witnesses: {text: text},
    frozen_module_witness_reasons: {text: text}) -> FrozenNativeModuleCapsuleBatchV1:
    val module = MirModule(name: "probe", functions: {}, statics: {}, constants: {}, types: {})
    val ctx: CompileContext = CompileContext(storage_registry_frozen: true,
        mir_modules: {"probe": module}, bootstrap_entry_mir_name: "", bootstrap_entry_mir: nil)
    val uncached_names = ["probe"]
    val object_base = "capsule-probe"
    val effective_backend = "cranelift"
    val native_target = "aarch64-apple-darwin"
    val native_cpu = "baseline"
    val driver_opt_level = 2
    val is_release = true
