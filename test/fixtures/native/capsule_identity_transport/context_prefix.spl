class CompileContext:
    storage_registry_frozen: bool
    mir_modules: {text: MirModule}
    bootstrap_entry_mir_name: text
    bootstrap_entry_mir: MirModule?

    fn frozen_storage_registry_well_formed(self) -> bool:
        self.storage_registry_frozen

    fn storage_binding_identity(self) -> text:
        "registry"

    fn frozen_storage_module_snapshot(self, module_name: text) -> FrozenStorageModuleSnapshotV1:
        FrozenStorageModuleSnapshotV1(ok: true, module_name: module_name,
            registry_identity: "registry",
            module_identity: frozen_storage_module_identity_v1(module_name, [], []),
            sites: [], evidence: [], reason: "ok")

    fn frozen_native_cache_source_v1(self, module_name: text) -> text:
        "source:" + module_name

    fn frozen_native_cache_source_identity_v1(self, module_name: text) -> text:
        "source-digest:" + module_name
