# Stage-2 native behavior fixture: exercise the production GUI frame renderer.
use std.editor.core.session.{EditSession}
use std.editor.core.document.{EditorDocument}
use std.editor.view.markdown_state.{MarkdownState}
use std.editor.view.outline_panel.{OutlineItem}
use std.editor.view.preview_pane.{preview_pane_update}
use app.editor.gui_shell.*
use app.editor.editor_controller.*
use std.editor.backend.gui_backend.*
use std.editor.common.platform.*
use std.editor.common.config.*
use std.editor.common.types.*
use std.editor.extensions.host.*

fn markdown_fixture_state(session: EditSession) -> GuiShellState:
    var state = gui_shell_new(session)
    # The markdown pane is independent of file-tree enumeration.
    state.ctrl.file_tree_visible = false
    state

fn main() -> i64:
    var session = EditSession.new()
    var state = markdown_fixture_state(session)
    val empty_frame = gui_shell_render_frame(state)
    if empty_frame.editor_html.contains("preview-pane") or empty_frame.editor_html.contains("outline-pane"):
        return 11
    session.open_empty()
    state = markdown_fixture_state(session)
    val plain_frame = gui_shell_render_frame(state)
    if plain_frame.editor_html.contains("preview-pane") or plain_frame.editor_html.contains("outline-pane"):
        return 12
    var doc: EditorDocument = session.active_document()
    var markdown = MarkdownState.new()
    doc.md_state = markdown
    session.documents[0] = doc
    state = markdown_fixture_state(session)
    val hidden_frame = gui_shell_render_frame(state)
    if hidden_frame.editor_html.contains("preview-pane") or hidden_frame.editor_html.contains("outline-pane"):
        return 13
    markdown.preview_visible = true
    markdown.preview = preview_pane_update(markdown.preview, "# PreviewFixture\nbody\n")
    doc.md_state = markdown
    session.documents[0] = doc
    state = markdown_fixture_state(session)
    val preview_frame = gui_shell_render_frame(state)
    if not preview_frame.editor_html.contains("class=\"preview-pane\"") or not preview_frame.editor_html.contains("PreviewFixture"):
        return 14
    markdown.outline_visible = true
    doc.md_state = markdown
    session.documents[0] = doc
    state = markdown_fixture_state(session)
    val both_frame = gui_shell_render_frame(state)
    if not both_frame.editor_html.contains("class=\"preview-pane\"") or both_frame.editor_html.contains("class=\"outline-pane\""):
        return 15
    markdown.preview_visible = false
    markdown.outline.items.push(OutlineItem(kind: "heading", label: "OutlineFixture", line: 0, depth: 0))
    doc.md_state = markdown
    session.documents[0] = doc
    state = markdown_fixture_state(session)
    val outline_frame = gui_shell_render_frame(state)
    if not outline_frame.editor_html.contains("class=\"outline-pane\"") or not outline_frame.editor_html.contains("<div>> OutlineFixture</div>"):
        return 16
    session.dock_layout.active_right = "problems"
    state = markdown_fixture_state(session)
    val problems_frame = gui_shell_render_frame(state)
    if not problems_frame.editor_html.contains("class=\"problems-pane\"") or problems_frame.editor_html.contains("class=\"outline-pane\""):
        return 17
    print "gui-markdown-optional-frame: PASS cases=7"
    0
