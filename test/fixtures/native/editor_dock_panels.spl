# Native semantic regression for the canonical typed docking model.
use dock_zone.*

fn main() -> i64:
    var dock = DockLayout.new()
    dock.add_panel(DockPanel(id: "notes", label: "Notes", zone: DOCK_LEFT, icon: "n", visible: true))
    dock.add_panel(DockPanel(id: "outline", label: "Outline", zone: DOCK_LEFT, icon: "o", visible: true))
    dock.add_panel(DockPanel(id: "hidden", label: "Hidden", zone: DOCK_LEFT, icon: "h", visible: false))
    var rows: [DockPanel] = dock.visible_panels_in(DOCK_LEFT)
    if rows.len() != 2 or rows[0].id != "notes" or rows[1].id != "outline":
        return 1
    dock.set_active(DOCK_LEFT, "notes")
    dock.add_panel(DockPanel(id: "notes", label: "Renamed", zone: DOCK_LEFT, icon: "x", visible: true))
    rows = dock.visible_panels_in(DOCK_LEFT)
    if dock.panels.len() != 3 or rows[0].label != "Renamed" or dock.active_left != "notes":
        return 2
    dock.add_panel(DockPanel(id: "", label: "Invalid", zone: DOCK_LEFT, icon: "", visible: true))
    dock.add_panel(DockPanel(id: "invalid", label: "Invalid", zone: 99, icon: "", visible: true))
    dock.set_active(DOCK_LEFT, "missing")
    dock.set_active(DOCK_LEFT, "hidden")
    dock.set_active(DOCK_RIGHT, "outline")
    if dock.panels.len() != 3 or dock.active_left != "notes" or dock.active_right != "":
        return 3
    if dock.visible_panels_in(99).len() != 0:
        return 4
    dock.add_panel(DockPanel(id: "notes", label: "Moved", zone: DOCK_RIGHT, icon: "x", visible: true))
    dock.set_active(DOCK_RIGHT, "notes")
    if dock.active_left != "" or dock.active_right != "notes" or not dock.right_visible:
        return 5
    dock.add_panel(DockPanel(id: "notes", label: "Hidden", zone: DOCK_RIGHT, icon: "x", visible: false))
    if dock.active_right != "" or dock.visible_panels_in(DOCK_RIGHT).len() != 0:
        return 6
    dock.show_right("lsp-panel")
    dock.hide_right()
    dock.set_active(DOCK_LEFT, "outline")
    dock = dock.toggle_left()
    dock = dock.toggle_right()
    dock = dock.toggle_bottom()
    if dock.panels.len() != 3 or dock.active_left != "outline" or dock.active_right != "lsp-panel" or dock.right_visible:
        return 7
    if dock.left.visible or dock.right.visible or dock.bottom.visible:
        return 8
    dock.remove_panel("missing")
    dock.remove_panel("outline")
    if dock.panels.len() != 2 or dock.active_left != "" or dock.active_right != "lsp-panel":
        return 9
    dock.add_panel(DockPanel(id: "terminal", label: "Terminal", zone: DOCK_BOTTOM, icon: "t", visible: true))
    dock.set_active(DOCK_BOTTOM, "terminal")
    if dock.active_bottom != "terminal":
        return 10
    dock.remove_panel("terminal")
    if dock.active_bottom != "":
        return 11
    print "editor-dock-panels: 11 checks passed"
    0
