use support.{ImportedReceiver as RenamedReceiver, ValueReceiver}

class LocalReceiver:
    marker: i64

    fn local_read(extra: i64) -> i64:
        self.marker + extra

fn imported_read(value: RenamedReceiver) -> i64:
    value.implicit_read(7)

fn imported_stack(value: RenamedReceiver) -> i64:
    value.implicit_stack(1, 2, 3, 4, 5, 6, 7, 8, 9)

fn main() -> i64:
    val local = LocalReceiver(marker: 20)
    if local.local_read(3) != 23:
        return 11
    val imported = RenamedReceiver.new(100)
    if imported_read(imported) != 107:
        return 12
    if imported.explicit_read(7) != 108:
        return 13
    if imported_stack(imported) != 145:
        return 14
    if RenamedReceiver.static_read(7) != 16:
        return 15
    val factory = RenamedReceiver.factory(200)
    if imported_read(factory) != 207:
        return 16
    val value = ValueReceiver(marker: 30)
    if value.value_read(4) != 34:
        return 17
    print "implicit-receiver-metadata: PASS cases=7"
    0
