# Implicit self must be present in exported arity before native linking.
class ImportedReceiver:
    marker: i64

    static fn new(marker: i64) -> ImportedReceiver:
        ImportedReceiver(marker: marker)

    fn implicit_read(extra: i64) -> i64:
        self.marker + extra

    fn explicit_read(self, extra: i64) -> i64:
        self.marker + extra + 1

    fn implicit_stack(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64) -> i64:
        self.marker + a + b + c + d + e + f + g + h + i

    static fn static_read(extra: i64) -> i64:
        extra + 9

    fn factory(marker: i64) -> ImportedReceiver:
        ImportedReceiver(marker: marker)

struct ValueReceiver:
    marker: i64

    fn value_read(extra: i64) -> i64:
        self.marker + extra

export ImportedReceiver, ValueReceiver
