# Native regression: marking a MIR runtime value is idempotent and returns unit.
use compiler.mir.mir_lowering.{MirLowering}
use compiler.hir.hir_types.{SymbolTable}

extern fn rt_exit(code: i64)

fn require(condition: bool) -> ():
    if not condition:
        rt_exit(99)

fn main() -> ():
    var lowering = MirLowering.new(SymbolTable.new())
    require(not lowering.is_runtime_value_local(901))
    lowering.mark_runtime_value_local(901)
    require(lowering.is_runtime_value_local(901))
    require(lowering.runtime_value_local_ids.len() == 1)
    print("mir-runtime-value-first-mark-pass")
    lowering.mark_runtime_value_local(901)
    require(lowering.runtime_value_local_ids.len() == 1)
    lowering.mark_runtime_value_local(902)
    require(lowering.runtime_value_local_ids.len() == 2)
    require(lowering.is_runtime_value_local(901))
    require(lowering.is_runtime_value_local(902))
    lowering.mark_runtime_value_local(901)
    lowering.mark_runtime_value_local(902)
    require(lowering.runtime_value_local_ids.len() == 2)
    require(lowering.runtime_value_local_ids[0] == 901)
    require(lowering.runtime_value_local_ids[1] == 902)
    require(not lowering.is_runtime_value_local(903))
    print("mir-runtime-value-repeat-mark-pass")
