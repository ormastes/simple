use fnlib.ops.{triple}

# A compiled function value handed to the runtime thread pool. The pool must
# run it (or reject it at submit), never call a mangled entry.

extern fn rt_pool_state_create_v1(capacity: i64) -> i64
extern fn rt_pool_state_try_submit_i64_v1(state_handle: i64, entry: fn(i64) -> i64, input: i64) -> i64
extern fn rt_pool_task_join_i64_v1(task_handle: i64) -> i64
extern fn rt_pool_task_release_i64_v1(task_handle: i64) -> i64
extern fn rt_pool_state_close_v1(state_handle: i64) -> i64
extern fn rt_pool_state_destroy_v1(state_handle: i64) -> i64

fn plus_one(x: i64) -> i64:
    x + 1

fn run(state: i64, f: (i64) -> i64, input: i64) -> i64:
    val task = rt_pool_state_try_submit_i64_v1(state, f, input)
    if task <= 0:
        return -1000 + task
    val result = rt_pool_task_join_i64_v1(task)
    rt_pool_task_release_i64_v1(task)
    result

fn main() -> i64:
    val state = rt_pool_state_create_v1(4)
    if state == 0:
        return 1
    if run(state, plus_one, 41) != 42:
        return 2
    if run(state, triple, 7) != 21:
        return 3
    val local = plus_one
    if run(state, local, 9) != 10:
        return 4
    rt_pool_state_close_v1(state)
    rt_pool_state_destroy_v1(state)
    print "pool-fn PASS"
    0
