use fnlib.ops.{add_one}

# An UNTYPED `val m = Some(f)`: the payload is a function value whose type
# the binding never states. The call through the unwrapped `h` must reach
# the body and answer the raw result, for a local and an imported function.

fn twice(x: i64) -> i64:
    x * 2

fn main() -> i64:
    val m = Some(twice)
    match m:
        case Some(h):
            if h(4) != 8:
                return 1
        case None:
            return 2
    val mi = Some(add_one)
    match mi:
        case Some(g):
            if g(41) != 42:
                return 3
        case None:
            return 4
    print "option-untyped PASS"
    0
