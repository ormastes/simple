# Fully-annotated nested fns in method and free-function bodies, including a
# nested fn calling another nested fn (its callee is then a capture of the
# outlined closure body). The native lane has no interpreter to fall back to.
# See doc/08_tracking/bug/jit_lowering_clamp_f_engine_color_2026-07-02.md.

struct EngineColor:
    r: f64

impl EngineColor:
    fn to_byte() -> i64:
        fn clamp_f(v: f64) -> i64:
            val i = (v * 255.0).to_i64()
            if i < 0:
                return 0
            if i > 255:
                return 255
            i
        clamp_f(self.r) + clamp_f(-1.0) + clamp_f(2.0)

class Counter:
    n: i64

    fn combo() -> i64:
        fn inc(v: i64) -> i64:
            v + 1
        fn twice_inc(v: i64) -> i64:
            inc(inc(v)) * 2
        twice_inc(self.n)

fn outer(x: i64) -> i64:
    val k = 5
    fn add_k(a: i64) -> i64:
        a + k
    fn half(v: f64) -> f64:
        v / 2.0
    fn quarter(v: f64) -> f64:
        half(half(v))
    add_k(add_k(x)) + (quarter(10.0) * 100.0).to_i64()

fn main() -> i64:
    if EngineColor(r: 1.0).to_byte() != 510:
        return 1
    if Counter(n: 10).combo() != 24:
        return 2
    if outer(32) != 292:
        return 3
    print "nested-fn PASS"
    0
