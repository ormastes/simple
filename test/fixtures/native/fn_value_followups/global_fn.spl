use fnlib.ops.{add_one, triple}

# Module-level function values: the global holds a function value built by
# the module initializer, and a call through it must reach the body. Typed
# and untyped declarations, local and imported functions.

fn twice(x: i64) -> i64:
    x * 2

val LOCAL_FN = twice
val IMPORTED_FN = add_one
val TYPED_LOCAL_FN: fn(i64) -> i64 = twice
val TYPED_IMPORTED_FN: fn(i64) -> i64 = triple

fn apply(f: (i64) -> i64, x: i64) -> i64:
    f(x)

fn main() -> i64:
    if LOCAL_FN(5) != 10:
        return 1
    if IMPORTED_FN(5) != 6:
        return 2
    if TYPED_LOCAL_FN(5) != 10:
        return 3
    if TYPED_IMPORTED_FN(5) != 15:
        return 4
    if apply(TYPED_LOCAL_FN, 6) != 12:
        return 5
    if apply(TYPED_IMPORTED_FN, 2) != 6:
        return 6
    print "global-fn PASS"
    0
