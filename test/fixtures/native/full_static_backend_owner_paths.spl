# Native source-owner regression for the full CLI's backend composition.
# Run from the repository root. This checks authored imports and their owners;
# driver_source_loading_spec additionally runs the compiler's actual resolver.
extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_exists(path: text) -> bool

fn main() -> i32:
    val ports = rt_file_read_text("src/plugins/backend_registry/full_static_backend_ports.spl")
    if not ports.contains("use compiler.backend.byl_backend.{{BylBackend}}"):
        print "FAIL: BYL composition import does not name its implementation owner"
        return 11
    if not ports.contains("use compiler.backend.irtc_codegen_adapter.{{IrTcCodegenAdapter}}"):
        print "FAIL: IrTc composition import does not name its implementation owner"
        return 12
    if not rt_file_exists("src/compiler/70.backend/backend/byl_backend.spl"):
        return 13
    if not rt_file_exists("src/compiler/70.backend/backend/irtc_codegen_adapter.spl"):
        return 14
    if ports.contains("use plugins.backend_byl.") or ports.contains("use plugins.backend_irtc."):
        return 15
    print "full-static-backend-owner-paths-pass"
    0
