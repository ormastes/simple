# Custom slice must never enter the primitive string ABI.
struct Window:
    value: i64

impl Window:
    fn slice(start: i64, stop: i64) -> i64:
        self.value + start + stop

fn make_window() -> Window:
    print "custom-slice-receiver-once"
    Window(value: 37)

fn main() -> i64:
    val window: Window = Window(value: 37)
    if window.slice(2, 3) != 42:
        return 1
    val source: text = "abcdef"
    if source.substring(1, 4) != "bcd":
        return 2
    val inferred = "abcdef"
    if inferred.slice(2, 5) != "cde":
        return 3
    val values: [i64] = [10, 20, 30, 40]
    val middle = values[1:3]
    if middle.len() != 2:
        return 4
    if middle[0] != 20 or middle[1] != 30:
        return 5
    if make_window().slice(2, 3) != 42:
        return 6
    0
