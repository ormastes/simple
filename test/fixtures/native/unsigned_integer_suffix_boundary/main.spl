# Run with a producer rebuilt from the parser fix. Expected stdout:
# unsigned-integer-suffix PASS; expected exit: 0.
fn main() -> i64:
    val maximum: u64 = 18446744073709551615u64
    if (maximum >> 32) != 4294967295u64:
        return 101
    if (maximum & 4294967295u64) != 4294967295u64:
        return 102
    if maximum / 10u64 != 1844674407370955161u64:
        return 103
    if maximum <= 9223372036854775807u64:
        return 104
    val small: u8 = 255u8
    if small != 255u8:
        return 105
    val hexadecimal: u64 = 0xffffffffffffffffu64
    if hexadecimal != maximum:
        return 106
    val signed_max: i64 = 9223372036854775807
    val signed_min: i64 = -9223372036854775808
    if (signed_max >> 62) != 1:
        return 107
    if (signed_min >> 63) != -1:
        return 108
    print("unsigned-integer-suffix PASS")
    0
