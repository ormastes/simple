use probe.rows.{windows}

# The same field at another offset prevents receiver-blind inference from
# concealing a lost WindowInfo element type.
struct Decoy:
    padding: i64
    window_id: text

fn count_local(present: bool) -> i64:
    val optional_windows = windows(present)
    val ws = optional_windows ?? []
    var count: i64 = 0
    for w in ws:
        val id = w.window_id
        if id == "win-42" and w.title == "actual" and w.focused:
            count = count + 1
    count

fn count_direct(present: bool) -> i64:
    val ws = windows(present) ?? []
    var count: i64 = 0
    for w in ws:
        val id = w.window_id
        if id == "win-42" and w.title == "actual" and w.focused:
            count = count + 1
    count

fn main() -> i64:
    if count_local(false) != 0:
        return 1
    if count_local(true) != 1:
        return 2
    if count_direct(false) != 0:
        return 3
    if count_direct(true) != 1:
        return 4
    print "optional-array-coalesce PASS"
    0
