use symbol_support.*

fn main() -> i64:
    if probe_emit_name_full("value", "alpha", false, "", false, false) != "alpha.value": return 1
    if probe_emit_name_full("value", "beta", false, "", false, false) != "beta.value": return 2
    if probe_emit_name_full("value", "alpha", true, "", false, false) != "value": return 3
    if probe_emit_name_full("value", "alpha", false, "c_value", false, false) != "c_value": return 4
    if probe_emit_name_full("value", "alpha", false, "c_value", false, true) != "c_value": return 5
    if probe_emit_name_full("value", "alpha", false, "", true, false) != "value": return 6
    if probe_emit_name_full("value", "alpha", false, "", false, true) != "value": return 7
    if probe_emit_name_full("Type.method", "alpha", false, "", false, false) != "Type.method": return 8
    if probe_emit_name_full("rt_array_new", "alpha", false, "", false, false) != "__simple_local_rt_array_new": return 9
    if probe_emit_name_full("rt_array_len", "alpha", false, "", false, false) != "__simple_local_rt_array_len": return 10
    if probe_emit_name_full("main", "alpha", true, "", false, false) != "__simple_main": return 11
    if probe_emit_name_full("main", "alpha.lib", false, "", false, false) != "__simple_main_alpha_lib": return 12
    if probe_emit_name_full("main", "alpha", true, "c_main", true, true) != "__simple_main": return 13
    if probe_emit_name_full("rt_array_new", "alpha", false, "c_alloc", true, true) != "c_alloc": return 14
    if probe_emit_name_full("rt_array_new", "alpha", false, "", true, false) != "rt_array_new": return 15
    if probe_emit_name_full("value", "", false, "", false, false) != "value": return 16
    if not probe_entry("compiler.common.module_path_naming", "src/compiler/00.common/module_path_naming.spl"): return 17
    if probe_entry("alpha", "src/compiler/00.common/module_path_naming.spl"): return 18
    if not probe_entry("alpha", ""): return 19
    print "cranelift-symbol-contracts-pass"
    0
