# Native bootstrap regression: the absent event sink must return normally.
# Compile this against the real driver helper; run in separate processes with
# SIMPLE_BUILD_PROGRESS_EVENTS empty, writable, and unwritable respectively.
use compiler.driver.driver_log_helpers.{log_build_progress}

fn main() -> i32:
    log_build_progress("load_sources", "file", 0, 1, "fixture.spl", 0, 1, 0, 0, "running")
    log_build_progress("complete", "file", 1, 1, "fixture.spl", 1, 1, 0, 0, "complete")
    print "build-progress-returned"
    0
