# Native caller proof for core text (literal and computed) and packed [u8].
# Provider is synthetic; these assertions do not establish GPU execution.
extern fn rt_cuda_module_get_function(module: i64, name: text) -> i64
extern fn rt_cuda_module_load_data_array(data: [u8]) -> i64
extern fn rt_cuda_memcpy_htod_array(dst: i64, data: [u8], count: i64) -> i64
extern fn rt_cuda_launch_kernel_name_array(module: i64, name: [u8], gx: i64, gy: i64, gz: i64, bx: i64, by: i64, bz: i64, args: i64) -> i64
extern fn rt_vulkan_compile_spirv_array(data: [u8]) -> i64
extern fn rt_vulkan_copy_to_buffer_array(handle: i64, data: [u8], byte_count: i64, offset: i64) -> bool

fn computed_name(prefix: text) -> text:
    prefix + "bc"

fn phase2_native_gpu_check(good: i64) -> i64:
    val name = computed_name("a")
    val bytes: [u8] = [97u8, 98u8, 99u8]
    val handle = if good == 1: 45 else: -3
    val module = if good == 1: 44 else: -3
    val cuda_ok = if good == 1: 0 else: -3
    val shader = if good == 1: 51 else: 0
    if rt_cuda_module_get_function(44, "abc") != handle: return 1
    if rt_cuda_module_get_function(44, name) != handle: return 2
    if rt_cuda_module_load_data_array(bytes) != module: return 3
    if rt_cuda_memcpy_htod_array(43, bytes, 2) != cuda_ok: return 4
    if rt_cuda_launch_kernel_name_array(44, bytes, 1, 2, 3, 4, 5, 6, 47) != cuda_ok: return 5
    if rt_vulkan_compile_spirv_array(bytes) != shader: return 6
    if rt_vulkan_copy_to_buffer_array(52, bytes, 2, 7) != (good == 1): return 7
    if rt_cuda_memcpy_htod_array(43, bytes, 4) != -1: return 8
    if rt_cuda_module_get_function(44, "") != -1: return 9
    0
