version: 1
currentContext: workstation
servers:
    local:
        transport: local
    shared:
        transport: ssh
        host: build.example.test
        port: 22
        containerHost: 192.168.50.2
        authRef: "secret://work/build-login"
        tlsRef: "trust://work/known-hosts"
        remoteExecutable: /opt/simple/bin/simple-orchestrator
    alternate:
        transport: ssh
        host: 10.20.30.40
        port: 2222
        authRef: "secret://work/alternate-login"
        tlsRef: "trust://work/alternate-host"
        remoteExecutable: /usr/local/bin/simple-orchestrator
contexts:
    workstation:
        sharedServer: shared
    development:
        sharedServer: alternate
        consumers:
            caret: local
            agent: shared
