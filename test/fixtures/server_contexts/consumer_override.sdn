version: 1
currentContext: development
servers:
    shared:
        transport: ssh
        host: shared.example.test
        port: 22
        authRef: "secret://work/login"
        tlsRef: "trust://work/known-hosts"
        remoteExecutable: /opt/simple/bin/simple-orchestrator
    local:
        transport: local
contexts:
    development:
        sharedServer: shared
        consumers:
            caret: local
