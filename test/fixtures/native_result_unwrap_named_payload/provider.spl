# Cross-module payload owners imported by glob, as in
# machine_fresh_workload_lifecycle_v2 (pub(package) class via `use ...*`).
pub(package) class CustodyBox:
    label: text
    count: i64

    pub(package) fn context_v3() -> Result<(text, i64), text>:
        Ok((self.label, self.count))

    pub(package) fn retain_v3(extra: i64) -> Result<CustodyBox, text>:
        Ok(CustodyBox(label: self.label, count: self.count + extra))

pub(package) enum Containment:
    Owned(i64)
    Shared

pub(package) fn custody_ok(label: text) -> Result<CustodyBox, text>:
    Ok(CustodyBox(label: label, count: 3))

pub(package) fn preflight_lookup(present: bool) -> Result<Option<CustodyBox>, text>:
    if present: return Ok(Some(CustodyBox(label: "pre", count: 1)))
    Ok(nil)

# Cross-module generic passthrough, as operation_stored_result_v2<T>.
pub(package) fn provider_stored<T>(result: Result<T, text>, tag: text) -> Result<T, text>:
    if result.is_err():
        print "provider poison {tag}"
    result
