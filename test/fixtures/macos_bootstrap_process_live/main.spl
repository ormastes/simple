# Native regression entry for the stock-macOS process runner.
use std.nogc_sync_mut.io.process_ops.{process_run_timeout_live}

fn main() -> i64:
    val payload = "single' double\" dollar$ backtick` slash\\"
    val (out, err, code) = process_run_timeout_live("/bin/sh", ["-c", "printf '%s' \"$1\"; printf '%s' diagnostic >&2; exit 7", "sh", payload], 10000)
    if out != payload or err != "diagnostic" or code != 7:
        print "FAIL: quoted arguments, output capture, or exit status"
        return 1
    val (slow_out, slow_err, slow_code) = process_run_timeout_live("/bin/sh", ["-c", "sleep 3"], 200)
    if slow_code != -1 or not slow_err.contains("[TIMEOUT:"):
        print "FAIL: timeout was not enforced"
        return 1
    print "PASS: macOS live process argv, stdout, stderr, exit, and timeout"
    return 0
