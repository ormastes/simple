# AOT regression fence for doc/08_tracking/bug/llvm_bool_bitcast_to_ptr_invalid_ir_2026-08-03.md
#
# `Option<bool>` boxes its payload behind the runtime's uniform tagged
# pointer representation, so a function returning `Option<bool>` uses a
# `ptr`-typed ABI return slot while the `Some(true)` / `Some(false)` arm
# carries a bool value across that ptr boundary -- a real bool-crossing-a-
# pointer AOT case that exercises the same family of code (core_codegen.spl
# value_as_type / emit_value_type_conversion) as the original defect.
#
# IMPORTANT SCOPE NOTE: this fixture does NOT force the exact `i1 -> ptr`
# bitcast MIR shape -- confirmed by inspecting the emitted IR with
# SIMPLE_KEEP_LLVM_IR=1: rt_enum_new's boxing call is declared to accept an
# `i1` payload argument directly, so the bool crosses as a same-typed call
# argument, never as a `value_as_type(_, "i1", "ptr")` return coercion. That
# EXACT positive-emission scenario (a local of MIR type i1 flowing into a
# function whose ABI return type is ptr at Ret) is fenced separately and
# directly at test/01_unit/compiler/backend/llvm_bitcast_pointer_bool_spec.spl,
# which synthesizes it via MirToLlvm's internal test-only visibility and
# string-matches the emitted zext/inttoptr instructions (and the absence of
# `bitcast i1 ... to ptr`). What THAT spec does not do -- and what this
# fixture adds -- is run the emitted module through the real LLVM verifier
# (`llvm-as` + `opt -passes=verify`, via SIMPLE_LLVM_BITCODE_DEBUG=1) and a
# real `llc` object-emission + execution, closing the actual gap: nothing
# upstream of this session fed the compiler's bool/ptr-crossing IR through
# the LLVM verifier at all.
fn make_opt(flag: bool) -> Option<bool>:
    if flag:
        return Some(true)
    return None

fn main():
    val a = make_opt(true)
    val b = make_opt(false)
    if a == Some(true):
        print("a: match\n")
    else:
        print("a: no-match\n")
    if b == None:
        print("b: match\n")
    else:
        print("b: no-match\n")
