use compiler.core.ast.{ast_reset}
use compiler.core.ast_expr.{
    EXPR_IDENT, EXPR_LAMBDA, EXPR_INTERPOLATED_STRING,
    expr_ident, expr_owner_tag, expr_owner_str, expr_owner_args, expr_owner_stmts
}
use compiler.frontend.core._AstExpr.accessors.{expr_interpolated_string}
use compiler.frontend.desugar.placeholder_lambda.{transform_placeholder_lambda}

fn rebuilt_name(result: i64, nested: bool) -> text:
    if expr_owner_tag(result) != EXPR_LAMBDA or expr_owner_stmts(result).len() == 0:
        return ""
    val body = expr_owner_stmts(result)[0]
    if expr_owner_tag(body) != EXPR_INTERPOLATED_STRING or expr_owner_args(body).len() == 0:
        return ""
    var rebuilt = body
    if nested:
        rebuilt = expr_owner_args(body)[0]
        if expr_owner_tag(rebuilt) != EXPR_INTERPOLATED_STRING or expr_owner_args(rebuilt).len() == 0:
            return ""
    val part = expr_owner_args(rebuilt)[0]
    if expr_owner_tag(part) != EXPR_IDENT:
        return ""
    expr_owner_str(part)

fn main() -> i64:
    ast_reset()
    val repeated = expr_interpolated_string([expr_ident("_1", 0), expr_ident("_1", 0)], 0)
    val repeated_result = transform_placeholder_lambda(repeated)
    if rebuilt_name(repeated_result, false) != "__p0":
        return 41
    val repeated_body = expr_owner_stmts(repeated_result)[0]
    if expr_s_val[expr_owner_args(repeated_body)[1]] != "__p0":
        return 42

    ast_reset()
    val inner = expr_interpolated_string([expr_ident("_1", 0)], 0)
    val outer = expr_interpolated_string([inner], 0)
    if rebuilt_name(transform_placeholder_lambda(outer), true) != "__p0":
        return 43

    ast_reset()
    val plain = expr_interpolated_string([expr_ident("value", 0)], 0)
    if transform_placeholder_lambda(plain) != plain:
        return 44
    0
