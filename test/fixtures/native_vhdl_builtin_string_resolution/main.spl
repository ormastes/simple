use compiler.backend.vhdl.vhdl_testbench.{
    VhdlTestbenchPort, VhdlTestbenchAssignment, VhdlTestbenchAssertion,
    VhdlTestbenchCase, render_vhdl_testbench,
}

fn main():
    val artifact = render_vhdl_testbench(VhdlTestbenchCase(
        testbench_name: "builtin_text_transport_tb",
        dut_entity: "builtin_text_transport",
        test_name: "vector equality",
        test_source_line: 7,
        ports: [
            VhdlTestbenchPort(
                name: "value", direction: "in",
                type_name: "std_logic_vector(7 downto 0)", source_line: 8)
        ],
        stimuli: [
            VhdlTestbenchAssignment(target: "value", literal: "x\"2a\"", source_line: 9)
        ],
        assertions: [
            VhdlTestbenchAssertion(
                actual: "value", expected: "x\"2a\"", test_name: "vector equality",
                expectation_index: 0, source_line: 10)
        ],
        clock_name: "", reset_name: "", reset_asserted: ""
    ))
    val vhdl_ok = artifact.testbench_vhdl.contains(
        "signal value : std_logic_vector(7 downto 0) := (others => '0');")
    val map_ok = artifact.source_map_json.contains("\"name\":\"value\"") and
        artifact.source_map_json.contains("\"sourceLine\":10")
    if vhdl_ok and map_ok:
        print("PROBE VERDICT: PASS vhdl-builtin-text len=pass contains=pass starts-with=pass")
    else:
        print("PROBE VERDICT: FAIL vhdl-builtin-text")
