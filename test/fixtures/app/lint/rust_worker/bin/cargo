#!/bin/sh
set -eu
case " $* " in
  *" metadata "*)
    printf '%s\n' '{"packages":[],"workspace_root":"fixture","version":1}'
    ;;
  *" --version "*)
    printf '%s\n' 'cargo 1.90.0 (fixture)'
    ;;
  *" --features timeout "*)
    sleep 2
    ;;
  *" --features malformed "*)
    printf '%s\n' 'not-json'
    ;;
  *" clippy "*)
    printf '%s\n' '{"reason":"compiler-message","message":{"level":"warning","code":{"code":"clippy::needless_return"},"message":"unneeded return","spans":[{"file_name":"src/lib.rs","byte_start":0,"byte_end":1,"line_start":1,"line_end":1,"column_start":1,"column_end":2}],"children":[]}}'
    ;;
  *" check "*)
    printf '%s\n' '{"reason":"compiler-message","message":{"level":"error","code":{"code":"E0425"},"message":"cannot find value","spans":[{"file_name":"src/lib.rs","byte_start":0,"byte_end":1,"line_start":1,"line_end":1,"column_start":1,"column_end":2}],"children":[]}}'
    ;;
  *) exit 64 ;;
esac
