# System fixture without DI exemption
# Child fixture: launched only by the environment propagation regression.
use std.spec.*
use std.env.variables.{env_get}
use compiler.di.{di_is_system_test_locked}

describe "DI untagged child environment":
    it "should observe runner-owned flags and the production DI lock":
        expect(env_get("SIMPLE_SYSTEM_TEST")).to_equal("1")
        expect(env_get("SIMPLE_DI_TEST")).to_equal("0")
        expect(di_is_system_test_locked()).to_equal(true)
        print "DI_CHILD_UNTAGGED_ASSERTIONS_REACHED"
