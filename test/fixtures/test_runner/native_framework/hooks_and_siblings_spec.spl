"""
Native admission control for the existing configured SSpec framework.
Expected: three executed examples, three passed, zero failed, native exit0.
NOT_RUN until the exact Phase3 compiler and production runner execute it.
This fixture contains real hooks, nested closures and matcher assertions.
"""
use std.spec.{describe, context, it, before_each, after_each, step, expect}

var framework_hook_events: [text] = []

struct FrameworkFixtureValue:
    value: i64

fn framework_hook_trace() -> text:
    framework_hook_events.join(",")

describe "native complete-framework hooks":
    before_each():
        framework_hook_events.push("before")
    after_each():
        framework_hook_events.push("after")

    it "executes the first before hook and original matcher":
        step("Observe the registered hook before the first real body")
        expect(framework_hook_trace()).to_equal("before")
        framework_hook_events.push("first")
        val observed = FrameworkFixtureValue(value: 5)
        expect(observed.value).to_equal(5)

    it "executes after and before hooks between sibling cases":
        step("Observe retained hook state from the completed first case")
        expect(framework_hook_trace()).to_equal("before,first,after,before")
        framework_hook_events.push("second")
        expect("complete" + " framework").to_equal("complete framework")

    context "nested closure":
        it "runs the nested case after both completed siblings":
            step("Require nested framework closure invocation and hook order")
            expect(framework_hook_trace()).to_equal("before,first,after,before,second,after,before")
            framework_hook_events.push("nested")
            expect(framework_hook_events.len()).to_equal(8)
