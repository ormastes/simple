# Infrastructure candidate only; generation is not SSpec execution.
use std.common.test_runner.native_framework_wrapper.{native_framework_wrapper_source}
use compiler.frontend.core.source_facts.{simple_code_lines, simple_string_continuation_lines, simple_string_byte_ranges}
use app.io.file_ops.{file_read, file_write, file_exists}

fn generate_framework_fixture(source_path: text, output_path: text) -> bool:
    if file_exists(output_path):
        print "wrapper generation refused: output already exists: {output_path}"
        return false
    val source = file_read(source_path)
    if source.trim() == "":
        print "wrapper generation refused: empty or unreadable source: {source_path}"
        return false
    val wrapped = native_framework_wrapper_source(source,
        simple_code_lines(source), simple_string_continuation_lines(source),
        simple_string_byte_ranges(source))
    if wrapped.is_err():
        print "wrapper generation refused: {wrapped.unwrap_err()}"
        return false
    if not file_write(output_path, wrapped.unwrap()):
        print "wrapper generation failed: cannot write: {output_path}"
        return false
    print "canonical wrapper generated: {output_path}"
    true

fn main() -> i64:
    if not generate_framework_fixture(
        "test/fixtures/test_runner/native_framework/hooks_and_siblings_spec.spl",
        "build/review/smux-small-module-phase2-generated/hooks_and_siblings_native.spl"):
        return 1
    if not generate_framework_fixture(
        "test/fixtures/test_runner/native_framework/failure_continuation_spec.spl",
        "build/review/smux-small-module-phase2-generated/failure_continuation_native.spl"):
        return 1
    print "generation complete; SSpec cases executed: 0"
    0
