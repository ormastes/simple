"""
Intentional negative native framework admission control; do not make it green.
Expected: three executed examples, two passed, one genuine matcher failure,
native exit1. Compilation, process admission or a crash is not that outcome.
NOT_RUN until the exact Phase3 compiler and production runner execute it.
"""
use std.spec.{describe, it, before_each, after_each, step, expect}

var framework_failure_events: [text] = []

describe "native failure and continuation":
    before_each():
        framework_failure_events.push("before")
    after_each():
        framework_failure_events.push("after")

    it "records a deliberate matcher failure without replacing the framework":
        step("Fail a real expectation inside an actually executing case")
        expect(framework_failure_events.len()).to_equal(1)
        framework_failure_events.push("failed-body")
        expect(7).to_equal(8)

    it "executes the next case and preserves the failed case after hook":
        step("Require the failed case to finish its framework lifecycle")
        expect(framework_failure_events.join(",")).to_equal("before,failed-body,after,before")
        framework_failure_events.push("continued")
        expect(9 - 4).to_equal(5)

    it "retains the prior failure while another real case passes":
        step("Prevent a later successful assertion from erasing failed verdicts")
        expect(framework_failure_events.join(",")).to_equal("before,failed-body,after,before,continued,after,before")
        expect(framework_failure_events.len()).to_equal(7)
