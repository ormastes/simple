# Real mock-owner regression; no std.spec dependency or fabricated BDD receipt.
# UNRUN: qualify with the admitted native producer before claiming behavior.
use std.common.testing.mock.builder.{MockFunction, MockRegistry}

fn main() -> i64:
    val tracked = MockFunction.new("tracked")
    if tracked.call_count() != 0: return 11
    tracked.record_call(["first", "one"])
    tracked.record_call(["second", "two"])
    if tracked.call_count() != 2: return 12
    val first = tracked.get_call(0)
    if first == nil: return 13
    val first_call = first.unwrap()
    if first_call.call_number != 0 or first_call.args.len() != 2: return 14
    if first_call.args[0] != "first" or first_call.args[1] != "one": return 15
    val last = tracked.get_last_call()
    if last == nil: return 16
    val last_call = last.unwrap()
    if last_call.call_number != 1 or last_call.args[0] != "second": return 17
    if tracked.get_call(2) != nil: return 18

    tracked.expect_call(2)
    tracked.expect_call_with(["second", "two"])
    if tracked.verify().is_err(): return 21
    tracked.record_call(["third"])
    if tracked.verify().is_ok(): return 22

    val unmatched = MockFunction.new("unmatched")
    unmatched.record_call(["actual"])
    unmatched.expect_call_with(["missing"])
    if unmatched.verify().is_ok(): return 23

    val registry = MockRegistry.new()
    if registry.get("absent") != nil: return 31
    registry.register("alpha", tracked)
    registry.register("beta", unmatched)
    registry.register("alpha", unmatched)
    val alpha = registry.get("alpha")
    val beta = registry.get("beta")
    if alpha == nil or beta == nil: return 32
    if alpha.unwrap().name != "tracked" or beta.unwrap().name != "unmatched": return 33
    if registry.get("absent") != nil: return 34
    registry.reset_all()
    if registry.get("alpha").unwrap().call_count() != 0: return 35
    if registry.get("beta").unwrap().call_count() != 0: return 36
    print "native-mock-builder-pass"
    0
