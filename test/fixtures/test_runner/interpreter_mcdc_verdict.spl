# Shared test oracle: an infrastructure failure is never the expected red case.
fn interpreter_mcdc_verdict_valid(passed: i64, failed: i64, skipped: i64,
        pending: i64, blocked: i64, unsupported: i64, timed_out: bool,
        error: text, mcdc: text, executed_marker_matches: bool,
        expected_failure: bool) -> bool:
    if not executed_marker_matches or timed_out or skipped != 0 or pending != 0 or blocked != 0 or unsupported != 0 or mcdc != "":
        return false
    if not expected_failure:
        return passed == 1 and failed == 0 and error == ""
    (passed == 0 and failed == 1 and
        error.starts_with("test-runner: authenticated BDD assertion failure:") and
        error.contains("MCDC_ACTUAL_SENTINEL_A17") and
        error.contains("MCDC_EXPECTED_SENTINEL_B73"))

export interpreter_mcdc_verdict_valid
