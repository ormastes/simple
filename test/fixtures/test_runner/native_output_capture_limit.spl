# Native import regression: the shared scalar must be public in its defining module.
use std.test_runner.test_runner_types.{TEST_OUTPUT_CAPTURE_BYTES}

fn main() -> i64:
    if TEST_OUTPUT_CAPTURE_BYTES != 4194304:
        return 1
    print "PASS native test runner capture limit: {TEST_OUTPUT_CAPTURE_BYTES}"
    0
