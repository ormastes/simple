# Repro (run with SIMPLE_EXECUTION_MODE=interpreter and =jit): doc/08_tracking/bug/seed_interp_u64_high_bit_literal_pattern_2026-11-06.md
# Expected: "u64_high_bit sign other"
fn classify(u: u64) -> text:
    match u:
        case 0x8000000000000000: "sign"
        case _: "other"

fn main():
    val s: u64 = 0x8000000000000000
    val o: u64 = 5
    print("u64_high_bit " + classify(s) + " " + classify(o))
