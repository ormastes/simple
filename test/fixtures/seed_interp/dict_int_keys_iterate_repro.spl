# Repro (run with SIMPLE_EXECUTION_MODE=interpreter): doc/08_tracking/bug/seed_interpreter_dict_int_keys_iterate_as_text_2026-10-30.md
# Expected: "dict_int_keys 7 true 1"
fn main():
    var d: Dict<i64, text> = {}
    d[7] = "seven"
    d[9] = "nine"
    var kept = 0
    var first = 0
    for key in d.keys():
        if key == 7:
            first = key
        if key != 9:
            kept = kept + 1
    var match_sum = 0
    for k, v in d:
        if k == 7:
            match_sum = match_sum + 1
    print("dict_int_keys " + first.to_text() + " " + (first + 0 == 7).to_text() + " " + kept.to_text())
