# Repro: doc/08_tracking/bug/seed_static_method_default_param_value_wrong_2026-09-13.md
# Expected: "static_default 105 42 105"
class Probe:
    static fn make(a: i64, b: i64 = 100) -> i64:
        a + b
    static fn one(x: i64 = 42) -> i64:
        x

fn freefn(a: i64, b: i64 = 100) -> i64:
    a + b

fn main():
    print("static_default " + Probe.make(5).to_text() + " " + Probe.one().to_text() + " " + freefn(5).to_text())
