use std.simd.*

fn main():
    val one = 1.0 as f32
    val two = 2.0 as f32
    val a = Vec4f(x: one, y: two, z: one, w: two)
    val b = Vec4f(x: two, y: two, z: two, w: two)
    val r = simd_mul_f32x4(a, b)
    print("simd_mul_f32x4 " + r.x.to_text() + " " + r.y.to_text())
