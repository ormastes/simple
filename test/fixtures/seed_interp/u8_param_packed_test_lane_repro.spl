# Repro (run with `simple test <this file>` — the spec lane): doc/08_tracking/bug/seed_interp_u8_param_boxed_mux_key_alloc_mismatch_2026-10-31.md
# A literal `[97u8]` bound to a `[u8]` parameter must arrive as packed bytes
# (rt_array_data_ptr != 0), exactly as it does under `simple run`.
use std.spec.{describe, it, expect}
use std.common.text_bytes.{text_byte_extraction_checked}
use os.apps.smux.core_mux_key_codec.{core_mux_key_bytes_checked_v1}

extern fn rt_array_data_ptr(arr: [u8]) -> i64

fn _packed(bytes: [u8]) -> bool:
    rt_array_data_ptr(bytes) != 0

describe "u8 param packing in the spec lane":
    it "packs a literal bound to a [u8] parameter":
        expect(_packed([97u8])).to_equal(true)
    it "admits a one-byte carrier through the text-bytes seam":
        expect(text_byte_extraction_checked(1, [97u8]).is_ok()).to_equal(true)
    it "admits a one-byte carrier through the mux key seam":
        expect(core_mux_key_bytes_checked_v1(1, [97u8]).is_ok()).to_equal(true)
