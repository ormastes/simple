# Repro: doc/08_tracking/bug/seed_interp_cross_module_free_fn_collision_2026-11-06.md
# Each module's `*_entry` must call ITS OWN `render`. Expected output:
#   a_entry a:1
#   b_entry b:2!
use mod_a.{a_entry}
use mod_b.{b_entry}

fn main():
    print("a_entry " + a_entry(1))
    print("b_entry " + b_entry(2))
