# Repro (run with SIMPLE_EXECUTION_MODE=interpreter and =jit): doc/08_tracking/bug/2026-10-30_seed_uint_scrutinee_never_matches_int_patterns.md
# ("A UInt argument bound to an i64 parameter stays UInt"). Expected: "uint_to_i64 -5 true".
fn minus_ten(x: i64) -> i64:
    x - 10

fn is_negative(x: i64) -> bool:
    x - 10 < 0

fn main():
    val u: u64 = 5
    print("uint_to_i64 " + minus_ten(u).to_text() + " " + is_negative(u).to_text())
