# Repro: doc/08_tracking/bug/seed_interpreter_class_to_trait_param_copies_state_2026-10-04.md
# A class is a reference type: mutation through a trait-typed parameter must be
# visible to the caller. Expected: "trait_param 2"
trait Bumper:
    me fn bump()

class Counter:
    n: i64

impl Bumper for Counter:
    me fn bump():
        self.n = self.n + 1

fn bump_twice(t: Bumper):
    t.bump()
    t.bump()

fn main():
    val c = Counter(n: 0)
    bump_twice(c)
    print("trait_param " + c.n.to_text())
