# Repro: doc/08_tracking/bug/float_parse_call_failure_value_differs_from_seed_2026-10-10.md
# Expected (native contract, interpreter): "conv 0.0 1.5 5 7 9 200"
fn main():
    val bad = f64("x")
    print("conv " + bad.to_text() + " " + f64("1.5").to_text() + " " + i32("5").to_text() + " " + i8("7").to_text() + " " + i16("9").to_text() + " " + u8("200").to_text())
