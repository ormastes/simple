# Bootstrap-only interpreter/JIT regression: unary minus retains signed width.
fn main() -> i64:
    val a: i8 = -128
    val b: i16 = -32768
    val c: i32 = -2147483648
    val wide: i64 = -2147483648
    assert(-a == -128)
    assert(-b == -32768)
    assert(-c == -2147483648)
    assert(-(-c) == -2147483648)
    assert(-wide == 2147483648)
    print("signed unary negation: 5 assertions passed")
    0
