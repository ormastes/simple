# Repro (run with SIMPLE_EXECUTION_MODE=interpreter): doc/08_tracking/bug/seed_interp_mut_out_param_writeback_and_u8_data_ptr_2026-08-31.md
# Gap 1: `&mut` out-param writeback on an extern. Gap 2: `[u8].data_ptr()` is a packed-byte pointer.
# Expected: "out_param status=0 handle_nonzero=true" / "data_ptr word=67305985"
extern fn spl_dlopen_checked(path: text, out_handle: *mut i64) -> i64
extern fn rt_ptr_read_i64(ptr: i64, offset: i64) -> i64

fn main():
    var handle: i64 = 0
    val status = spl_dlopen_checked("kernel32.dll", &mut handle)
    print("out_param status=" + status.to_text() + " handle_nonzero=" + (handle != 0).to_text())
    val a: [u8] = [1u8, 2u8, 3u8, 4u8, 0u8, 0u8, 0u8, 0u8]
    print("data_ptr word=" + rt_ptr_read_i64(a.data_ptr(), 0).to_text())
