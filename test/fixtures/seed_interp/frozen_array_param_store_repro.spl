# Repro (run with SIMPLE_EXECUTION_MODE=interpreter): doc/08_tracking/bug/frozen_array_in_place_mutation_lost_seed_interpreter_2026_10_23.md
# An indexed store through an array parameter (or a local copy of one) must land.
# Expected: "flip 254 copy 254 i64 99"
fn _flip(data: [u8], i: i64) -> [u8]:
    data[i] = data[i] ^ 0xff
    data

fn _flip_copy(data: [u8], i: i64) -> [u8]:
    var out = data
    out[i] = out[i] ^ 0xff
    out

fn _set(data: [i64], i: i64) -> [i64]:
    data[i] = 99
    data

fn main():
    val b = _flip([1u8, 1u8, 3u8], 1)
    val c = _flip_copy([1u8, 1u8, 3u8], 1)
    val d = _set([1, 2, 3], 1)
    print("flip " + b[1].to_text() + " copy " + c[1].to_text() + " i64 " + d[1].to_text())
