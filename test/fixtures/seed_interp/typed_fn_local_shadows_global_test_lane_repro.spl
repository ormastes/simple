# Repro (run with `simple test <this file>`): doc/08_tracking/bug/seed_test_typed_fn_local_shadowed_by_global_2026-10-04.md
# A fn-typed local named like an imported function must win over the import.
use std.spec.{describe, it, expect}
use std.path.{resolve}

class Loader:
    resolve_fn: fn(text, text) -> text

fn _noop_resolve(a: text, b: text) -> text:
    b

describe "typed fn local vs imported global":
    it "calls the local closure, not std.path.resolve":
        val loader = Loader(resolve_fn: _noop_resolve)
        val resolve = loader.resolve_fn
        expect(resolve("compiler/driver.spl", "std.math")).to_equal("std.math")
