# Repro (run with SIMPLE_EXECUTION_MODE=interpreter): doc/08_tracking/bug/seed_rt_bytes_to_text_lossy_utf8_split_scalar_2026-10-31.md
# A [u8] -> text -> [u8] round trip must be byte-exact even when the bytes split
# a UTF-8 scalar, and the reassembled fragments must equal the original text.
# Expected: "frag0 e7 / frag1 958cf09f / frag2 9880 / assembled true"
use std.common.text_bytes.{text_to_bytes, bytes_to_text}

fn hex(bytes: [u8]) -> text:
    val digits = "0123456789abcdef"
    var out = ""
    for b in bytes:
        val v = b.to_i64()
        out = out + digits[v / 16:v / 16 + 1] + digits[v % 16:v % 16 + 1]
    out

fn main():
    val bytes = text_to_bytes("界😀")
    val f0 = bytes_to_text(bytes[0:1])
    val f1 = bytes_to_text(bytes[1:5])
    val f2 = bytes_to_text(bytes[5:])
    print("frag0 " + hex(text_to_bytes(f0)) + " / frag1 " + hex(text_to_bytes(f1)) + " / frag2 " + hex(text_to_bytes(f2)) + " / assembled " + (f0 + f1 + f2 == "界😀").to_text())
