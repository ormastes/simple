# Repro (run with SIMPLE_EXECUTION_MODE=interpreter and =jit): doc/08_tracking/bug/seed_i32_overflow_interp_vs_jit_divergence_2026-11-05.md
# ("binding a declared i32 from an out-of-range value still stores the i64").
# Expected: "i32_bind -1294967296 -1294967296".
fn echo32(x: i32) -> i32:
    x

fn main():
    val x: i32 = 3000000000
    print("i32_bind " + x.to_text() + " " + echo32(3000000000).to_text())
