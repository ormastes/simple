# Repro (run with `simple test <this file>`): doc/08_tracking/bug/seed_interpreter_class_to_trait_param_copies_state_2026-10-04.md
use std.spec.{describe, it, expect}

trait Bumper:
    me fn bump()

class Counter:
    n: i64
    log: [i64]

impl Bumper for Counter:
    me fn bump():
        self.n = self.n + 1
        self.log.push(self.n)

fn bump_twice(t: Bumper):
    t.bump()
    t.bump()

class Driver:
    regs: Bumper

impl Driver:
    static fn open(regs: Bumper) -> Driver:
        Driver(regs: regs)
    fn drive():
        self.regs.bump()

var _flag = false

fn _read_flag() -> bool:
    _flag

describe "class through a trait-typed param":
    it "shares state with the caller":
        val c = Counter(n: 0, log: [])
        bump_twice(c)
        expect(c.n).to_equal(2)
        expect(c.log.len()).to_equal(2)
    it "sees an it-block module var assignment from a module fn":
        _flag = true
        expect(_read_flag()).to_equal(true)
    it "shares state when a driver stores the trait object and mutates it":
        val c = Counter(n: 0, log: [])
        val d = Driver.open(c)
        d.drive()
        expect(c.n).to_equal(1)
