# Repro (run with `simple test <this file>`): doc/08_tracking/bug/seed_interpreter_aliased_extern_import_not_found_2026_10_19.md
use std.spec.{describe, it, expect}
use ext_mod.{rt_text_to_bytes as one_hop}
use facade.{facade_to_bytes}

describe "aliased extern import":
    it "resolves a one-hop alias":
        expect(one_hop("abc").len()).to_equal(3)
    it "resolves a two-hop export-use alias":
        expect(facade_to_bytes("abcd").len()).to_equal(4)
