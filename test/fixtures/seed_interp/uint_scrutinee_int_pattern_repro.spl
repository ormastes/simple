# Repro (run with SIMPLE_EXECUTION_MODE=interpreter and =jit): doc/08_tracking/bug/2026-10-30_seed_uint_scrutinee_never_matches_int_patterns.md
fn classify(u: u64) -> text:
    match u:
        case 0: "zero"
        case 1..=9: "digit"
        case 10..100: "small"
        case _: "other"

fn main():
    val a: u64 = 0
    val b: u64 = 5
    val c: u64 = 42
    val d: u64 = 1000
    print("uint_match " + classify(a) + " " + classify(b) + " " + classify(c) + " " + classify(d))
    val f = 7.9
    val g = f.to_u64()
    match g:
        case 7: print("float_to_u64 seven")
        case _: print("float_to_u64 other")
