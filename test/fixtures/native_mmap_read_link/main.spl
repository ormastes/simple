extern fn rt_file_mmap_read_text(path: text) -> text
extern fn rt_file_mmap_read_bytes(path: text) -> [i64]

fn main():
    val path = "test/fixtures/native_mmap_read_link/payload.txt"
    val mapped_text = rt_file_mmap_read_text(path)
    val mapped_bytes = rt_file_mmap_read_bytes(path)
    print "mmap-link-ok:{mapped_text.len()}:{mapped_bytes.len()}"
