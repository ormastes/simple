use compiler.frontend.parser_types.{Parser}
use compiler.frontend.core.lexer.{Lexer}

fn no_parser() -> Option<Parser>:
    nil

fn main() -> i64:
    val lexer = Lexer(dummy: 0)
    val parser = no_parser()
    val passed = lexer.dummy == 0 and parser == nil
    print("parser types Lexer import resolved: {passed}")
    if passed: 0 else: 1
