# F11 native regression. Inspect object symbols before execution:
# main's body must define __simple_main; both runtime names remain imports.
extern fn rt_heap_registry_count() -> i64
extern fn rt_bytes_to_text(bytes: [u8]) -> text

fn main() -> i64:
    val before = rt_heap_registry_count()
    val bytes: [u8] = [65, 0, 66]
    val value = rt_bytes_to_text(bytes)
    val after = rt_heap_registry_count()
    if value.len() != 3:
        return 1
    if before < 0 or after < 0:
        return 2
    0
