# Helper for covexpr_fixture.spl: invokes a lambda written in the fixture. A
# collector that files a closure body under its invoker marks lines of THIS
# file; spl_coverage_module_spec pins its recorded lines to its own two.
pub fn covexpr_apply(f: fn(i64) -> i64, x: i64) -> i64:
    val before = x + 1
    val r = f(before)
    r
