# Negative control for the coverage gate: `covfix_c_called` IS called by the
# spec, `covfix_c_uncalled` is NEVER called. Recordable lines are 7,8,9 (called)
# and 12,13,14 (uncalled), so honest coverage is 3/6 = 50%. A report of 100% here
# means the called-function gate has been relaxed and uncalled bodies are being
# credited — the exact regression defect B's fix must never reintroduce.
pub fn covfix_c_called() -> i64:
    var a = 1
    a = a + 1
    return a

pub fn covfix_c_uncalled() -> i64:
    var b = 1
    b = b + 1
    return b
