# Fixture for coverage_module_report_spec: its executable-line and decision
# counts are pinned by hand in that spec. Do not reformat.
pub fn covrep_classify(n: i64) -> text:
    var label = "zero"
    if n > 0:
        label = "pos"
    elif n < 0:
        label = "neg"
    label

pub fn covrep_sum(xs: [i64]) -> i64:
    var total = 0
    for x in xs:
        total += x
    return total

pub fn covrep_never(n: i64) -> i64:
    val doubled = n * 2
    if doubled > 10 and n > 0:
        return doubled
    return 0
