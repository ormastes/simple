# Fixture for spl_coverage_module_spec: `if` / `match` headers and statements
# whose executor bypasses exec_node, so the collector ran them unrecorded --
# the tail `if` / `match` of an arm of a value-position `match`
# (`val r = match`, `return match`) and every statement of a multi-line lambda
# body. Value-position `if` blocks, call arguments and field initializers are
# here as the already-recorded neighbours. main() takes chosen paths only:
# headers and arm lines it never reaches must stay unrecorded.
# Do not reformat -- the spec pins the line numbers.
use covexpr_helper.{covexpr_apply}

struct CovexprPair:
    a: i64
    b: i64

fn covexpr_add(a: i64, b: i64) -> i64:
    a + b

fn covexpr_val_match(n: i64) -> i64:
    val r = match n:
        case 1:
            if n > 0:
                val hit = 10
                hit
            else:
                val miss = 11
                miss
        case 2:
            match n + 1:
                case 3: 30
                case _: 31
        case _:
            if n > 100:
                90
            else:
                91
    r

fn covexpr_return_match(n: i64) -> i64:
    return match n:
        case 1:
            val k = n + 1
            if k > 0:
                k
            else:
                0
        case _:
            match n:
                case 5: 50
                case _: 51

fn covexpr_val_if(n: i64) -> i64:
    val r = if n > 0:
        val k = n * 2
        match k:
            case 2: 20
            case _: 21
    else:
        if n < -5:
            70
        else:
            71
    r

fn covexpr_call_arg(n: i64) -> i64:
    val r = covexpr_add(if n > 0: 1 else: 2, match n:
        case 1: 5
        case _: 6
    )
    r

fn covexpr_field(n: i64) -> i64:
    val p = CovexprPair(a: if n > 0: 1 else: 2, b: n)
    p.a + p.b

fn covexpr_lambda(n: i64) -> i64:
    val f = \x:
        val k = x + 1
        if k > 1:
            var t = k
            t = t * 2
            t
        else:
            val low = k
            low
    f(n)

fn covexpr_lambda_match(n: i64) -> i64:
    val f = \x:
        match x:
            case 1:
                val one = 100
                one
            case _:
                val other = 200
                other
    f(n)

fn covexpr_unused_lambda(n: i64) -> i64:
    val f = \x:
        val never = x
        never
    n

# The lambda is written here and invoked by covexpr_helper.spl: its lines
# belong to this file, not to the invoker's.
fn covexpr_cross(n: i64) -> i64:
    val f = \x:
        val r = match x:
            case 2:
                if x > 1:
                    20
                else:
                    21
            case _:
                1
        r
    covexpr_apply(f, n)

fn main():
    print covexpr_val_match(1)
    print covexpr_val_match(2)
    print covexpr_return_match(1)
    print covexpr_return_match(5)
    print covexpr_val_if(1)
    print covexpr_val_if(-1)
    print covexpr_call_arg(1)
    print covexpr_field(1)
    print covexpr_lambda(1)
    print covexpr_lambda_match(1)
    print covexpr_unused_lambda(7)
    print covexpr_cross(1)
