# Fixture for spl_coverage_module_spec: main() runs every executable line, so
# the collector must report 100%. The shapes it used to miss: a function's
# tail `match`, a tail one-line `if c: a else: b`, a tail block `if`, and a
# one-line `if c: a else: b` statement mid-body. Do not reformat -- the
# spec pins the line count (9).
fn covtail_match(n: i64) -> text:
    val k = n + 1
    match k:
        case 1: "one"
        case _: "other"

fn covtail_inline_if(n: i64) -> i64:
    val k = n + 1
    if k > 0: k / 2 else: 0

fn covtail_block_if(n: i64) -> i64:
    if n > 1:
        n
    else:
        0

fn covtail_twice(n: i64) -> i64:
    return n * 2

fn covtail_mid_if(n: i64) -> i64:
    var total = n
    if n > 0: covtail_twice(n) else: covtail_twice(0)
    total = total + 1
    total

fn main():
    print covtail_match(0)
    print covtail_inline_if(3)
    print covtail_block_if(2)
    print covtail_mid_if(1)
