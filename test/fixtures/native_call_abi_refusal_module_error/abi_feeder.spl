use abi_sink.{Sink}

class Feeder:
    n: i64

    static fn create() -> Feeder:
        Feeder(n: 0)

    # REFUSED on purpose: an unsuffixed int literal crosses a module boundary
    # into a declared f64 param. There is no implicit coercion at an imported
    # call (the two sides would read different registers).
    me feed(s: Sink):
        s.add(2)
        self.n = self.n + 1
