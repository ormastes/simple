use abi_sink.{Sink}

class Feeder:
    n: i64

    static fn create() -> Feeder:
        Feeder(n: 0)

    # REFUSED on purpose: an f64 value crosses a module boundary into a
    # declared i64 param. No implicit conversion narrows a float to an int,
    # so this stays a compile error even where int -> f64 is allowed.
    me feed(s: Sink):
        val x = 2.5
        val _mixed = s.mix(x)
        self.n = self.n + 1
