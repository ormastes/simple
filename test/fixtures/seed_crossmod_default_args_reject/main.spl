# Omitting a default the caller cannot evaluate must be a compile error.
# Expected: seed native-build fails with "call to `needs_global` omits argument 2".

use callee.{needs_global}

# The omitted default names a callee-module global, which the caller cannot
# evaluate: the seed must reject this at compile time, never pad it with nil.
fn main():
    print "bad={needs_global(1)}"
