# Fixture for global_array_push_linear_spec: module-global side tables mutated
# from a helper fn — the exact shape of `expr_alloc` in the flat AST.

var g_tag: [i64] = []
var g_s: [text] = []

pub fn alloc(t: i64) -> i64:
    val idx = g_tag.len()
    g_tag.push(t)
    g_s.push("")
    idx

pub fn reset():
    g_tag = []
    g_s = []

pub fn fill_global(n: i64) -> i64:
    reset()
    var i = 0
    while i < n:
        alloc(i)
        i = i + 1
    g_tag.len()

pub fn add(x: i64):
    g_tag.push(x)

pub fn snapshot() -> [i64]:
    g_tag
