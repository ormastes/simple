# Native oracle for doc/08_tracking/bug/stage2_implicit_tail_optional_return_takes_scalar_arm_2026-11-15.md
# Build with `native-build main.spl --backend=cranelift --entry-closure` (and
# --backend=llvm) from a directory outside test/. Expected stdout, exactly:
#   float some 2.5
#   negfloat some -3.25
#   int some 7
#   bigint some 4000000000
#   str none
#   some_f64 some -0.5
#   cond_t some 1.5
#   cond_f none
#   i64_3 some 3
#   i64_none none
#   i64_cond_f none
# Before the fix Stage 2 cranelift refused Val.as_f64 / some_f64 / cond_f64
# ("result 0 has type f64, must match function signature of i64"), LLVM
# printed a denormal for every f64 row and then aborted with `.unwrap() called
# on None` on the first None arm; `-> i64?` tails returned the raw payload.

enum Val:
    Float(f64)
    Int(i64)
    Str(text)

impl Val:
    fn as_f64(self) -> f64?:
        match self:
            case Val.Float(f): Some(f)
            case Val.Int(i): Some(i.to_float())
            case _: None

fn some_f64(x: f64) -> f64?:
    Some(x)

fn cond_f64(b: bool) -> f64?:
    if b:
        Some(1.5)
    else:
        None

fn some_i64(x: i64) -> i64?:
    Some(x)

fn none_i64() -> i64?:
    None

fn cond_i64(b: bool) -> i64?:
    if b:
        Some(3)
    else:
        None

fn show_f(label: text, v: f64?):
    match v:
        case Some(x): print "{label} some {x}"
        case None: print "{label} none"

fn show_i(label: text, v: i64?):
    match v:
        case Some(x): print "{label} some {x}"
        case None: print "{label} none"

fn main():
    show_f("float", Val.Float(2.5).as_f64())
    show_f("negfloat", Val.Float(-3.25).as_f64())
    show_f("int", Val.Int(7).as_f64())
    show_f("bigint", Val.Int(4000000000).as_f64())
    show_f("str", Val.Str("a").as_f64())
    show_f("some_f64", some_f64(-0.5))
    show_f("cond_t", cond_f64(true))
    show_f("cond_f", cond_f64(false))
    show_i("i64_3", some_i64(3))
    show_i("i64_none", none_i64())
    show_i("i64_cond_f", cond_i64(false))
