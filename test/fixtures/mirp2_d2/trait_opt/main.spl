trait Reducer:
    fn reduce(x: i64) -> i64

class Doubler:
    k: i64

impl Reducer for Doubler:
    fn reduce(x: i64) -> i64:
        x * self.k

class Holder:
    reducer: Reducer?

class Wrap:
    r: Reducer

fn pick(h: Holder) -> Reducer?:
    if val Some(s) = h.reducer:
        return Some(s)
    nil

fn main() -> i64:
    val h = Holder(reducer: Some(Doubler(k: 2)))
    var out = 0
    if val Some(r) = pick(h):
        val w = Wrap(r: r)
        out = w.r.reduce(21)
    print "trait_opt {out}"
    0
