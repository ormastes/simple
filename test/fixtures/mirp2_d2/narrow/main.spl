class Leaf:
    value: text

class Expr:
    right: Leaf?

fn suffix(where_expr: Expr?) -> text:
    if not where_expr.?:
        return ""
    val expr = where_expr
    if not expr.right.?:
        return ""
    val pattern = expr.right.value
    pattern.slice(1, 3)

fn main() -> i64:
    print "narrow {suffix(Some(Expr(right: Some(Leaf(value: \"%ab%\")))))}"
    0
