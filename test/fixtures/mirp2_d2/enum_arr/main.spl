enum Val:
    Null
    Int(v: i64)

impl Val:
    fn is_null() -> bool:
        match self:
            Val.Null: true
            _: false

fn make(k: i64) -> Val:
    if k == 0:
        return Val.Null
    Val.Int(v: k)

fn main() -> i64:
    var arr: [Val] = []
    arr.push(make(0))
    arr.push(make(3))
    print "enum {arr[0].is_null()} {arr[1].is_null()}"
    0
