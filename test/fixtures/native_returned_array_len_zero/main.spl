# Native/JIT regression for doc/08_tracking/bug/
# stage2_compiled_program_returned_array_len_zero_2026-09-20.md.
# A Stage-2-compiled program once saw .len() of a function-returned array as 0
# (contents survived; only the caller-side length read was wrong). The exact
# reduction from the bug record lives here verbatim, plus exit-code guards so a
# regressed length fails twice: exact stdout AND exit status. Exit codes and
# exact output are both checked externally; a miscompiled comparison cannot
# turn a wrong length into a false pass.
fn param_len(values: [text]) -> i64:
    values.len()
fn ret_lit() -> [text]:
    ["x", "y"]
fn ident(values: [text]) -> [text]:
    values

fn main() -> i64:
    val xs = ["a", "b", "c"]
    print("local={xs.len()} param_len={param_len(xs)}")
    val r = ret_lit()
    print("ret_lit={r.len()}")
    val i = ident(xs)
    print("ident={i.len()}")
    print("ret_lit[1]={r[1]} ident[2]={i[2]}")
    val typed: [text] = ret_lit()
    print("typed_len={typed.len()}")
    if r.len() != 2:
        return 91
    if i.len() != 3:
        return 92
    if typed.len() != 2:
        return 93
    if r[1] != "y" or i[2] != "c":
        return 94
    0
