# ============================================================================
# test/fixtures/structural/profile_golden_v1.spl
#
# GOLDEN VECTORS for the frozen profile-descriptor contract v1 (§26 group 11:
# ResolveProfile / SpatialLayoutProfile).
#
# Every hex string below was derived BY HAND from the frozen layout table in
# doc/05_design/platform/structural_compute/profile_contract_v1.md, then
# cross-checked against an independent field-by-field derivation that does not
# call the Simple encoder. They were NOT captured from encoder output — the
# spec asserts encoder output EQUALS these bytes, so a codec regression cannot
# silently redefine the contract, and a SYMMETRIC encoder+decoder defect (the
# failure mode round-trip testing cannot see) fails here.
#
# Convention: test/fixtures/structural/identity_tagmap_golden_v1.spl sets the
# golden-vector rules (pure data, lowercase unseparated hex, .sdn mirror,
# never edited in place — a change adds _v2). As with the resolve vectors,
# u64 top-bit round-trip coverage lives in the identity golden vectors; these
# vectors use max-positive u64s.
#
# Vector inputs — ResolveProfileDescriptor (envelope SRPD v1, then
# profile_id Hash128 | kind u8 | step_mask u8 | core_mask u16
# | space_count u32 | stage_count u32 | reserved u32):
#
#   RPD_SMF = SmfLinkProfile
#       profile_id  Hash128(hi 0x2122232425262728, lo 0x3132333435363738)
#       kind 0 (smf_link), step_mask 63 (all six §18.1 steps),
#       core_mask 255 (all eight §18.1 core primitives),
#       space_count 3 (symbols / sections / relocations),
#       stage_count 13 (§19 L0..L12)
#
#   RPD_WEB = WebResourceLinkProfile — the profile with no address space
#       profile_id  Hash128(0, 0)
#       kind 2 (web_resource_link),
#       step_mask 47 (all but plan_placement),
#       core_mask 223 (all but scan placement),
#       space_count 6 (§18.2: stylesheet imports, URLs, fonts, keyframes,
#                      custom properties, script/module/component resources),
#       stage_count 6
#
#   RPD_MAX = width witness for the u32 count fields
#       profile_id  Hash128(hi 0x7fffffffffffffff, lo 0x7fffffffffffffff)
#       kind 1 (clang_offload_link), step_mask 63, core_mask 255,
#       space_count 4294967294, stage_count 1
#       (the sum is exactly U32_MAX — one more and the well-formedness check
#        must reject, which it only can if the sum is taken at 64-bit width)
#
# Vector inputs — SpatialLayoutProfileDescriptor (envelope SLPD v1, then
# profile_id Hash128 | kind u8 | step_mask u8 | flags u16
# | admission_mask u32):
#
#   LPD_BLOCK  profile_id Hash128(hi 0x1122334455667788, lo 0x1314151617181920)
#       kind 0 (block), step_mask 27 (discover|estimate|arrange|verify),
#       flags 1 (gpu_eligible), admission_mask 131
#       (LAYOUT_GPU_ADMISSION_TEXT | _REPLACED | _INLINE_FLOW)
#
#   LPD_INLINE profile_id Hash128(0, 0)
#       kind 1 (inline), step_mask 15 (discover|estimate|measure|arrange),
#       flags 6 (text_measure_required | sequential_within_island),
#       admission_mask 0 — a CPU-only profile declares no GPU admission filter
#
#   LPD_GRID   profile_id Hash128(hi 0x7fffffffffffffff, lo 0x7fffffffffffffff)
#       kind 3 (grid), step_mask 31 (all five steps),
#       flags 3 (gpu_eligible | text_measure_required),
#       admission_mask 511 (all nine frozen admission bits)
# ============================================================================

fn profile_golden_resolve_smf_hex() -> text:
    """Framed RPD_SMF: 8-byte envelope + 32-byte descriptor = 40 bytes."""
    "535250440100000028272625242322213837363534333231003fff00030000000d00000000000000"

fn profile_golden_resolve_web_hex() -> text:
    """Framed RPD_WEB: zero profile_id, plan_placement and scan placement both
    absent — the pair that must agree."""
    "535250440100000000000000000000000000000000000000022fdf00060000000600000000000000"

fn profile_golden_resolve_max_hex() -> text:
    """Framed RPD_MAX: max-positive Hash128 halves, space_count 0xfffffffe."""
    "5352504401000000ffffffffffffff7fffffffffffffff7f013fff00feffffff0100000000000000"

fn profile_golden_layout_block_hex() -> text:
    """Framed LPD_BLOCK: 8-byte envelope + 24-byte descriptor = 32 bytes."""
    "534c50440100000088776655443322112019181716151413001b010083000000"

fn profile_golden_layout_inline_hex() -> text:
    """Framed LPD_INLINE: the sequential, CPU-only, text-measuring profile."""
    "534c50440100000000000000000000000000000000000000010f060000000000"

fn profile_golden_layout_grid_hex() -> text:
    """Framed LPD_GRID: every step, every admission bit."""
    "534c504401000000ffffffffffffff7fffffffffffffff7f031f0300ff010000"
