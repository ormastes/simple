# ============================================================================
# test/fixtures/structural/resolve_golden_v1.spl
#
# GOLDEN VECTORS for the frozen resolve contract v1 (LINK lane).
#
# Every hex string below was derived BY HAND from the frozen layout in
# doc/05_design/platform/structural_compute/link_manager_contract_v1.md, not
# captured from encoder output — the spec asserts encoder output EQUALS these
# bytes, so a codec regression cannot silently redefine the contract.
#
# Convention: test/fixtures/structural/identity_tagmap_golden_v1.spl sets the
# golden-vector rules (pure data, lowercase unseparated hex, .sdn mirror,
# never edited in place — a change adds _v2). u64 top-bit round-trip coverage
# lives in the identity golden vectors; these vectors use max-positive u64s.
#
# Vector inputs:
#   DEF  = DefinitionRecord(key: ResolveKey(Hash128(hi 0x0102030405060708,
#                                                    lo 0x1112131415161718),
#                                            space 42),
#                           owner: EntityRef(7, 9),
#                           attributes: 0x00f0000000000001, order: 3)
#   RES0 = ResolutionRecord(reference EntityRef(0,0), definition EntityRef(0,0),
#                           status 0 (Unresolved), reason 0 (Unspecified))
#   RES1 = ResolutionRecord(reference EntityRef(1,2), definition EntityRef(3,4),
#                           status 1 (Resolved), reason 0)
#   REFX = ReferenceRecord(key: ResolveKey(Hash128(hi 0x7fffffffffffffff,
#                                                   lo 0x7fffffffffffffff),
#                                           space 4294967295),
#                          owner: EntityRef(4294967295, 4294967295),
#                          attributes: 0x7fffffffffffffff,
#                          order: 0x7fffffffffffffff)
# ============================================================================

fn resolve_golden_definition_hex() -> text:
    """Framed DEF: envelope SDFN v1, then key | owner | attributes | order."""
    "5344464e01000000080706050403020118171615141312112a0000000700000009000000010000000000f0000300000000000000"

fn resolve_golden_resolution_zero_hex() -> text:
    """Framed RES0: envelope SRSL v1, then 20 zero bytes."""
    "5352534c010000000000000000000000000000000000000000000000"

fn resolve_golden_resolution_resolved_hex() -> text:
    """Framed RES1: envelope SRSL v1; definition present because status=1."""
    "5352534c010000000100000002000000030000000400000001000000"

fn resolve_golden_reference_maxpos_hex() -> text:
    """Framed REFX: envelope SRFR v1, max-positive u64s and max u32s."""
    "5352465201000000ffffffffffffff7fffffffffffffff7fffffffffffffffffffffffffffffffffffffff7fffffffffffffff7f"
