# ============================================================================
# test/fixtures/structural/invalidation_golden_v1.spl
#
# GOLDEN VECTORS for the frozen DirtyMask / dependency-edge contract v1.
#
# Every hex string below was derived BY HAND from the frozen layout in
# doc/05_design/platform/structural_compute/invalidation_contract_v1.md, not
# captured from encoder output. That is what makes them an oracle: the spec
# asserts encoder output EQUALS these bytes, so a codec regression cannot
# silently redefine the contract. A round-trip assertion cannot do this job — an
# encoder and a decoder that drift together round-trip perfectly.
#
# Follows the golden-vector convention established by the ID-TAG lane in
# identity_tagmap_golden_v1.spl and the MAP lane in mapping_golden_v1.spl: pure
# data, no file I/O, lowercase unseparated hex, one vector per record shape plus
# zero and all-ones edge cases, mirrored byte for byte in the sibling .sdn,
# never edited in place.
#
# Envelope = magic(4 ASCII, LE) | version u16 | reserved u16.
#   "SDMK" = 53 44 4d 4b   DirtyMask              -> 53444d4b01000000
#   "SDEP" = 53 44 45 50   InvalidationEdge       -> 5344455001000000
#   "SDBA" = 53 44 42 41   InvalidationEdgeBatch  -> 5344424101000000
#
# DirtyMask bit positions (§9.1 declaration order, bit 0 = Source):
#   Source 0, Token 1, Parse 2, SyntaxIndex 3, Semantic 4, Hir 5, Mir 6,
#   Optimization 7, Codegen 8, Link 9, DomStructure 10, SelectorIndex 11,
#   Cascade 12, ComputedStyle 13, IntrinsicMeasure 14, Layout 15, Paint 16,
#   Composite 17, HitTest 18, Accessibility 19, Resource 20.
#
# InvalidationEdge body, 21 bytes, no padding:
#   producer EntityRef 8 | consumer EntityRef 8 | kind u8 | invalidates u32
# ============================================================================

# ----------------------------------------------------------------------------
# DirtyMask — u32 bitset, bit i = the i-th §9.1 stage.
# ----------------------------------------------------------------------------

# Empty mask. Legal as a standalone record (nothing is dirty); illegal inside an
# InvalidationEdge, where an edge that invalidates nothing can never fire.
val GOLDEN_DIRTY_NONE: text = "53444d4b01000000" + "00000000"

# {Source} = bit 0 = 0x00000001 -> LE 01 00 00 00.
# This vector is the one that pins bit 0 to Source. The layout lane packs
# IntrinsicMeasure on bit 0 in its own shorthand constants, so a reader built
# against that numbering reads this vector as "intrinsic sizes are stale"
# instead of "the source text changed" — same bytes, different meaning, no
# error. See the Divergences section of the contract document.
val GOLDEN_DIRTY_SOURCE: text = "53444d4b01000000" + "01000000"

# {Layout, HitTest} = bits 15, 18 = 0x8000 + 0x40000 = 0x00048000
#   -> LE 00 80 04 00.
# The §9.3 "computed width -> containing block layout" consequence set.
val GOLDEN_DIRTY_LAYOUT_HITTEST: text = "53444d4b01000000" + "00800400"

# {IntrinsicMeasure, Layout, HitTest} = bits 14, 15, 18
#   = 0x4000 + 0x8000 + 0x40000 = 0x0004c000 -> LE 00 c0 04 00.
# The §9.3 "font metric -> text fragments and parent intrinsic size" set: a
# changed font metric re-measures before it re-lays-out.
val GOLDEN_DIRTY_INTRINSIC_CHAIN: text = "53444d4b01000000" + "00c00400"

# All 21 stages: bits 0..20 = 0x001fffff -> LE ff ff 1f 00.
# This vector is what pins DIRTY_MASK_COUNT at 21; adding a 22nd stage without
# a version bump changes these bytes.
val GOLDEN_DIRTY_ALL: text = "53444d4b01000000" + "ffff1f00"

# ----------------------------------------------------------------------------
# InvalidationEdge
# ----------------------------------------------------------------------------

# Minimal edge: EntityRef(0,0) -> EntityRef(0,0), SymbolExport = 0,
# invalidates = {Source} = 1. Every field at its floor EXCEPT the mask, which
# cannot be zero: `invalidation_edge_valid` rejects a non-firing edge, so there
# is no all-zero InvalidationEdge on the wire at all.
val GOLDEN_DEP_MIN: text =
    "5344455001000000"
        + "0000000000000000"
        + "0000000000000000"
        + "00"
        + "01000000"

# EntityRef(1,2) -> EntityRef(3,4), LayoutGeometry = 3,
# invalidates = {Layout, HitTest} = 0x48000.
# Asymmetric on every field, so a byte-order or field-order error cannot pass.
val GOLDEN_DEP_BASIC: text =
    "5344455001000000"
        + "0100000002000000"
        + "0300000004000000"
        + "03"
        + "00800400"

# All-ones EntityRefs with the MAXIMUM kind discriminant
# (LinkRelocation = 5) and every known DirtyMask bit set (0x1fffff).
# Catches sign extension on the u32 fields and pins the top of both vocabularies.
val GOLDEN_DEP_MAX: text =
    "5344455001000000"
        + "ffffffffffffffff"
        + "ffffffffffffffff"
        + "05"
        + "ffff1f00"

# The §9.3 font-metric bullet: EntityRef(0,7) -> EntityRef(0,9), FontMetric = 4,
# invalidates = {IntrinsicMeasure, Layout, HitTest} = 0x4c000.
val GOLDEN_DEP_FONT: text =
    "5344455001000000"
        + "0000000007000000"
        + "0000000009000000"
        + "04"
        + "00c00400"

# ----------------------------------------------------------------------------
# InvalidationEdgeBatch — compressed sparse row over PRODUCERS, the same layout
# and the same invariant checker as §6.3's MappingShard.
#
# Header: version u32 | producer_count u32 | edge_count u32 | has_reverse u8,
# then producer_offsets u32 * (producer_count + 1), then edge_count
# InvalidationEdge bodies, then the optional consumer-index tail.
# ----------------------------------------------------------------------------

# Empty batch: version 1, 0 producers, 0 edges, no reverse,
# producer_offsets = [0]. The single offset entry is not optional — a CSR array
# always has n+1 entries, so even an empty batch carries the terminator.
val GOLDEN_BATCH_EMPTY: text =
    "5344424101000000"
        + "01000000"
        + "00000000"
        + "00000000"
        + "00"
        + "00000000"

# The shared 3-edge fixture body used by both batch vectors below.
#
#   e0: EntityRef(0,0) -> EntityRef(0,1)  SymbolExport(0)
#       invalidates {Semantic, Hir}                = 0x30
#   e1: EntityRef(0,0) -> EntityRef(0,2)  CustomProperty(1)
#       invalidates {ComputedStyle, Layout, Paint} = 0x1a000
#   e2: EntityRef(0,1) -> EntityRef(0,2)  LayoutGeometry(3)
#       invalidates {Layout, HitTest}              = 0x48000
#
# e0 is §9.3's "exported symbol -> dependent module semantic artifact"; e1 is
# "CSS custom property -> computed declarations that reference it". The two
# carry DISJOINT masks on purpose: that is what makes one propagation step
# distinguishable from "everything downstream goes dirty", and it is what the
# spec's propagate cases assert.
val GOLDEN_BATCH_EDGES: text =
    "0000000000000000" + "0000000001000000" + "00" + "30000000"
        + "0000000000000000" + "0000000002000000" + "01" + "00a00100"
        + "0000000001000000" + "0000000002000000" + "03" + "00800400"

# Forward-only batch: 2 producers, 3 edges, producer_offsets = [0, 2, 3].
# This is what `record_dependencies` (§9.4) receives from a stage that has not
# been asked to explain anything yet.
val GOLDEN_BATCH_FORWARD: text =
    "5344424101000000"
        + "01000000"
        + "02000000"
        + "03000000"
        + "00"
        + "00000000" + "02000000" + "03000000"
        + GOLDEN_BATCH_EDGES

# The same batch with the consumer index built for 3 consumer nodes — the
# direction §9.4 `explain` walks.
#   consumers: e0 -> 1, e1 -> 2, e2 -> 2
#   consumer_offsets = [0, 0, 1, 3]   (consumer 0 has no incoming edges)
#   consumer_edges   = [0, 1, 2]      (indices into the forward edge list)
# consumer_edges holds INDICES, not duplicated edge bodies; that is what makes
# the index cheap to build lazily and impossible to disagree with the forward
# list.
val GOLDEN_BATCH_REVERSE: text =
    "5344424101000000"
        + "01000000"
        + "02000000"
        + "03000000"
        + "01"
        + "00000000" + "02000000" + "03000000"
        + GOLDEN_BATCH_EDGES
        + "03000000"
        + "03000000"
        + "00000000" + "00000000" + "01000000" + "03000000"
        + "00000000" + "01000000" + "02000000"
