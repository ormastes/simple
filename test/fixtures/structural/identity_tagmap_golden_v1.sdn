# Golden vectors — frozen identity + tagmap contract v1
#
# Language-neutral mirror of test/fixtures/structural/identity_tagmap_golden_v1.spl.
# Byte-for-byte identical to the Simple fixture; this copy exists so a Rust/C++
# bridge or an external validator can check its encoder without linking Simple.
#
# Normative layout: doc/05_design/platform/structural_compute/
#                   identity_tagmap_contract_v1.md
#
# All `bytes` values are lowercase unseparated hex of the COMPLETE framed record
# (8-byte envelope included).
#
# Shared input used by most vectors:
#   ART = ArtifactId(content_hash = Hash128(hi = 0x1122334455667788,
#                                           lo = 0x99aabbccddeeff00),
#                    schema_version = 7)

contract:
  identity_schema_version: 1
  tagmap_schema_version: 1
  byte_order: little-endian
  envelope: magic_u32 | version_u16 | reserved_u16

identity_vectors:
  - name: entity_ref_zero
    type: EntityRef
    input: { object_slot: 0, local_index: 0 }
    bytes: "53524546010000000000000000000000"

  - name: entity_ref_max
    type: EntityRef
    input: { object_slot: 4294967295, local_index: 4294967295 }
    bytes: "5352454601000000ffffffffffffffff"

  - name: entity_ref_asym
    type: EntityRef
    input: { object_slot: 16909060, local_index: 84281096 }
    bytes: "53524546010000000403020108070605"

  - name: entity_key_basic
    type: EntityKey
    input: { artifact: ART, schema: 3, local_identity: 42 }
    bytes: "534b455901000000887766554433221100ffeeddccbbaa9907000000030000002a00000000000000"

  - name: snapshot_id_basic
    type: SnapshotId
    input: { root_artifact: ART, epoch: 9 }
    bytes: "53534e5001000000887766554433221100ffeeddccbbaa99070000000900000000000000"

  - name: semantic_key_basic
    type: SemanticEntityKey
    input:
      language: 1
      qualified_name: 2
      signature_hash: { hi: 43690, lo: 48059 }
      definition_artifact: ART
    bytes: "5353454d010000000100000002000000aaaa000000000000bbbb000000000000887766554433221100ffeeddccbbaa9907000000"

  - name: source_anchor_basic
    type: SourceAnchor
    input:
      file: ART
      byte_start: 100
      byte_end: 200
      spelling_context: 5
      expansion_context: 6
    bytes: "53414e4301000000887766554433221100ffeeddccbbaa990700000064000000c80000000500000006000000"

tagmap_vectors:
  - name: tag_schema_empty
    type: TagSchema
    input: { version: 0, keys: [] }
    bytes: "53545343010000000000000000000000"

  - name: tag_schema_two_keys
    type: TagSchema
    input:
      version: 5
      keys:
        - { namespace: 11, name: 22, value_type: Marker, cardinality: One,
            lifetime: Snapshot, merge_policy: Replace, authority: Parser }
        - { namespace: 33, name: 44, value_type: SourceAnchor, cardinality: Many,
            lifetime: Artifact, merge_policy: Union, authority: External }
    bytes: "535453430100000005000000020000000b000000160000000000000000210000002c0000000802020104"

  - name: tag_value_marker
    type: TagValue
    input: { value_type: Marker }
    bytes: "5354564c0100000000"

  - name: tag_value_bool_true
    type: TagValue
    input: { value_type: Bool, num: 1 }
    bytes: "5354564c010000000101"

  - name: tag_value_bool_false
    type: TagValue
    input: { value_type: Bool, num: 0 }
    bytes: "5354564c010000000100"

  - name: tag_value_i64
    type: TagValue
    input: { value_type: I64, num: 1234605616436508552 }
    bytes: "5354564c01000000028877665544332211"

  - name: tag_value_u64_max
    type: TagValue
    input: { value_type: U64, num: 18446744073709551615 }
    bytes: "5354564c0100000003ffffffffffffffff"

  - name: tag_value_f64_one
    type: TagValue
    comment: payload is the raw IEEE-754 bit pattern of 1.0
    input: { value_type: F64, num: 4607182418800017408 }
    bytes: "5354564c0100000004000000000000f03f"

  - name: tag_value_string_id
    type: TagValue
    input: { value_type: StringId, num: 2882400001 }
    bytes: "5354564c010000000501efcdab"

  - name: tag_value_entity_ref
    type: TagValue
    input: { value_type: EntityRef, ref: { object_slot: 9, local_index: 8 } }
    bytes: "5354564c01000000060900000008000000"

  - name: tag_value_artifact_id
    type: TagValue
    input: { value_type: ArtifactId, artifact: ART }
    bytes: "5354564c0100000007887766554433221100ffeeddccbbaa9907000000"

  - name: tag_value_source_anchor
    type: TagValue
    input:
      value_type: SourceAnchor
      anchor: { file: ART, byte_start: 100, byte_end: 200,
                spelling_context: 5, expansion_context: 6 }
    bytes: "5354564c0100000008887766554433221100ffeeddccbbaa990700000064000000c80000000500000006000000"

  - name: tag_value_small_set
    type: TagValue
    comment: offset 77 in the low 32 bits, count 3 in the high 32 bits
    input: { value_type: SmallSet, num: 12884901965 }
    bytes: "5354564c01000000094d00000003000000"
