# ============================================================================
# test/fixtures/structural/receipt_golden_v1.spl
#
# GOLDEN VECTORS for the frozen StageReceipt / VerificationReceipt contract v1.
#
# Every hex string below was derived BY HAND from the frozen layout in
# doc/05_design/platform/structural_compute/receipt_contract_v1.md, not
# captured from encoder output. That is what makes them an oracle: the spec
# asserts encoder output EQUALS these bytes, so a codec regression cannot
# silently redefine the contract. Wave 0b proved why this matters — a
# symmetric encode/decode field swap round-tripped perfectly and was caught
# only by the hand-derived vectors.
#
# Convention inherited from wave 0a/0b (identity_tagmap_golden_v1.spl,
# mapping_golden_v1.spl): pure data, no file I/O, lowercase unseparated hex,
# one vector per record shape plus zero and edge cases, mirrored byte for byte
# in the sibling .sdn, never edited in place.
#
# Envelope = magic(4 ASCII, LE) | version u16 | reserved u16.
#   "SRSR" = 53 52 53 52   StageReceipt        -> 5352535201000000
#   "SRVR" = 53 52 56 52   VerificationReceipt -> 5352565201000000
#   "SRMS" = 53 52 4d 53   MappingShardRef     -> 53524d5301000000
#
# Text fields are u32 length followed by that many ASCII bytes (wire.spl's
# list rule). ASCII used below:
#   "layout" = 6c 61 79 6f 75 74     "cpu" = 63 70 75     "gpu" = 67 70 75
#   "aa" = 6161   "bb" = 6262   "cc" = 6363   "de" = 6465   "ad" = 6164
# ============================================================================

# ----------------------------------------------------------------------------
# MappingShardRef — §6.4's deferred handle.
#
# Body 52 bytes, no padding:
#   snapshot SnapshotId 28 | shard_index u32 | edge_count u32
#   | content_hash Hash128 16
# SnapshotId 28 = ArtifactId 20 (Hash128 16 = hi u64 then lo u64, then
# schema_version u32) then epoch u64.
# ----------------------------------------------------------------------------

# The absent handle: every field zero. A receipt that produced no mapping
# delta still fills the slot, so this vector pins the "no origins" encoding.
val GOLDEN_SHARD_REF_NONE: text =
    "53524d5301000000"
        + "0000000000000000" + "0000000000000000" + "00000000"
        + "0000000000000000"
        + "00000000"
        + "00000000"
        + "0000000000000000" + "0000000000000000"

# MappingShardRef(snapshot = SnapshotId(ArtifactId(Hash128(1, 2), 3), 4),
#                 shard_index = 5, edge_count = 6,
#                 content_hash = Hash128(0x1122334455667788,
#                                        0x0099aabbccddeeff))
# Every field a different value, and the content hash asymmetric in both
# halves, so a byte-order or half-swap error cannot pass.
#   hi 0x1122334455667788 -> LE 88 77 66 55 44 33 22 11
#   lo 0x0099aabbccddeeff -> LE ff ee dd cc bb aa 99 00
val GOLDEN_SHARD_REF_BASIC: text =
    "53524d5301000000"
        + "0100000000000000" + "0200000000000000" + "03000000"
        + "0400000000000000"
        + "05000000"
        + "06000000"
        + "8877665544332211" + "ffeeddccbbaa9900"

# ----------------------------------------------------------------------------
# StageReceipt — the frozen wire projection (§21.3 plus the three selection
# provenance fields §21.3 omits).
#
# Fixed head 63 bytes:
#   contract_version u32 | requested_mode u8 | mode u8 | fallback_reason u8
#   | item_count_in u64 | item_count_out u64 | bytes_read u64
#   | bytes_written u64 | fallback_count u32 | malformed_count u32
#   | overflow_flags u64 | elapsed_us u64
# then six length-prefixed texts: stage, backend, candidate_backend,
# input_hash, output_hash, deterministic_hash.
# ----------------------------------------------------------------------------

# The shared body of the two vectors below. IDENTICAL in both; the ONLY
# difference between a cost-policy CPU selection and a forced GPU fallback is
# the single fallback_reason byte, which is precisely the point.
#
#   contract_version 1        -> 01000000
#   requested_mode HybridVectorGpu (1)
#   mode CpuReference (0)
#   item_count_in 100 = 0x64  -> 6400000000000000
#   item_count_out 100
#   bytes_read 4096 = 0x1000  -> 0010000000000000
#   bytes_written 2048 = 0x800-> 0008000000000000
#   fallback_count 1          -> 01000000
#   malformed_count 0
#   overflow_flags 0
#   elapsed_us 250 = 0xfa     -> fa00000000000000
val GOLDEN_STAGE_HEAD_A: text =
    "5352535201000000"
        + "01000000"
        + "01"
        + "00"

val GOLDEN_STAGE_HEAD_B: text =
    "6400000000000000"
        + "6400000000000000"
        + "0010000000000000"
        + "0008000000000000"
        + "01000000"
        + "00000000"
        + "0000000000000000"
        + "fa00000000000000"

# stage "layout", backend "cpu", candidate_backend "gpu",
# input_hash "aa", output_hash "bb", deterministic_hash "cc".
val GOLDEN_STAGE_TEXTS: text =
    "06000000" + "6c61796f7574"
        + "03000000" + "637075"
        + "03000000" + "677075"
        + "02000000" + "6161"
        + "02000000" + "6262"
        + "02000000" + "6363"

# THE CENTREPIECE VECTOR. Hybrid GPU was requested, the cost model chose the
# CPU path, and the receipt says so: fallback_reason = CostModelSelectedCpu
# (8) -> byte 08. This is a PLANNED selection, not a degradation.
val GOLDEN_STAGE_RECEIPT_CPU_SELECTED: text =
    GOLDEN_STAGE_HEAD_A + "08" + GOLDEN_STAGE_HEAD_B + GOLDEN_STAGE_TEXTS

# THE CONTRASTING VECTOR. Byte-for-byte identical except fallback_reason =
# DeviceLost (6) -> byte 06. A forced degradation.
#
# These two vectors are the contract defect's proof and its fix in one place:
# under §21.3 as written both records would encode identically (same mode,
# same fallback_count), and no reader could tell a working cost model from a
# lost GPU. They now differ in exactly one byte at a fixed offset.
val GOLDEN_STAGE_RECEIPT_GPU_FALLBACK: text =
    GOLDEN_STAGE_HEAD_A + "06" + GOLDEN_STAGE_HEAD_B + GOLDEN_STAGE_TEXTS

# A clean resident-GPU run: requested ResidentGpu (2), ran ResidentGpu (2),
# fallback_reason None (0), every counter zero and every text empty.
# This vector pins the "nothing to report" encoding, and the zero reason byte
# is only legal here because requested == mode.
val GOLDEN_STAGE_RECEIPT_CLEAN: text =
    "5352535201000000"
        + "01000000"
        + "02"
        + "02"
        + "00"
        + "0000000000000000"
        + "0000000000000000"
        + "0000000000000000"
        + "0000000000000000"
        + "00000000"
        + "00000000"
        + "0000000000000000"
        + "0000000000000000"
        + "00000000"
        + "00000000"
        + "00000000"
        + "00000000"
        + "00000000"
        + "00000000"

# ----------------------------------------------------------------------------
# VerificationReceipt — §26 group 7, second half. Defined by no section of the
# architecture; this vector IS the definition of its byte layout.
#
# Fixed head 91 bytes:
#   contract_version u32 | mode u8 | policy u8 | outcome u8
#   | checked_count u64 | mismatch_count u64 | first_mismatch EntityRef 8
#   | elapsed_us u64 | origins MappingShardRef 52
# then four length-prefixed texts: stage, backend, result_hash, oracle_hash.
# ----------------------------------------------------------------------------

# The MappingShardRef body of GOLDEN_SHARD_REF_BASIC, unframed (no envelope):
# embedded records carry no envelope of their own, exactly as MappingShard
# embeds bare MappingEdge bodies in wave 0b.
val GOLDEN_SHARD_REF_BASIC_BODY: text =
    "0100000000000000" + "0200000000000000" + "03000000"
        + "0400000000000000"
        + "05000000"
        + "06000000"
        + "8877665544332211" + "ffeeddccbbaa9900"

# A real mismatch found by an oracle comparison.
#   mode HybridVectorGpu (1) | policy OracleCompare (4) | outcome Mismatch (2)
#   checked_count 1000 = 0x3e8  -> e803000000000000
#   mismatch_count 3            -> 0300000000000000
#   first_mismatch EntityRef(2, 7) -> 02000000 07000000
#   elapsed_us 500 = 0x1f4      -> f401000000000000
#   stage "layout", backend "gpu", result_hash "de", oracle_hash "ad"
# The oracle hash is non-empty, which the consistency rule permits ONLY under
# OracleCompare — that pairing is what this vector pins.
val GOLDEN_VERIFICATION_MISMATCH: text =
    "5352565201000000"
        + "01000000"
        + "01"
        + "04"
        + "02"
        + "e803000000000000"
        + "0300000000000000"
        + "02000000" + "07000000"
        + "f401000000000000"
        + GOLDEN_SHARD_REF_BASIC_BODY
        + "06000000" + "6c61796f7574"
        + "03000000" + "677075"
        + "02000000" + "6465"
        + "02000000" + "6164"

# Verification that was never run: policy Off (0), outcome NotRun (0), no
# origins, no hashes. NotRun is NOT clean — `verification_outcome_is_clean`
# returns false for it — so this vector also pins the encoding of the case a
# careless reader would misread as a pass.
val GOLDEN_VERIFICATION_NOT_RUN: text =
    "5352565201000000"
        + "01000000"
        + "00"
        + "00"
        + "00"
        + "0000000000000000"
        + "0000000000000000"
        + "00000000" + "00000000"
        + "0000000000000000"
        + "0000000000000000" + "0000000000000000" + "00000000"
        + "0000000000000000"
        + "00000000"
        + "00000000"
        + "0000000000000000" + "0000000000000000"
        + "00000000"
        + "00000000"
        + "00000000"
        + "00000000"
