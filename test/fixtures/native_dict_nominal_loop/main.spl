struct LoopKey:
    id: i64

struct LoopValue:
    instruction_index: i64
    symbol: LoopKey

struct LoopModule:
    types: Dict<LoopKey, LoopValue>

# Different nominal layouts prevent receiver-blind field guessing from
# accidentally concealing erased dictionary tuple-binder types.
struct OtherKey:
    padding: text
    id: i64

struct OtherValue:
    symbol: text
    instruction_index: text

class LoopChecker:
    module: LoopModule
    fn total() -> i64:
        var total = 0
        for key, value in self.module.types:
            total = total + key.id + value.instruction_index + value.symbol.id
        total

fn main() -> i64:
    var entries: Dict<LoopKey, LoopValue> = {}
    entries[LoopKey(id: 7)] = LoopValue(instruction_index: 11, symbol: LoopKey(id: 13))
    val checker = LoopChecker(module: LoopModule(types: entries))
    val actual = checker.total()
    if actual != 31:
        print("FAIL: dictionary nominal tuple binders expected 31")
        return 1
    print("PASS: dictionary nominal tuple binders = 31")
    0
