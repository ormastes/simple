# milestone_0030 remote-run fixtures: public test material only (deterministic seeds, never real keys or addresses).
# AUTHORED_NOT_RUN.
use app.orchestrator.remote_run_author_v1.{RemoteRunSpecV1, RemoteRunHostInputsV1, RemoteRunAuthoredV1, remote_run_author_v1}
use app.buildrunner.remote_evidence_v1.remote_inventory_digest_v1
use std.common.build_manager.contracts.{BuildTaskV1, BuildInputV1}
use std.common.crypto.sha256.{sha256_text, sha256_u8_hex}
use std.common.text_bytes.text_to_utf8_bytes

fn rr_compiler_v1() -> [u8]:
    [1u8, 2u8, 255u8]

fn rr_runtime_v1() -> [u8]:
    [3u8, 4u8]

fn rr_source_v1() -> text:
    "fn main(): 0\n"

fn rr_tools_v1() -> [BuildInputV1]:
    [BuildInputV1("tools/runtime.a", sha256_u8_hex(rr_runtime_v1()))]

fn rr_environment_text_v1() -> text:
    "{version: 1, kind: \"remote-run-environment\", hostId: \"worker_1\", executionPlatform: \"linux\", " +
        "targetPlatform: \"linux\", testRuntime: \"native\", isolationClass: \"native-container\", " +
        "toolchainDigest: \"" + remote_inventory_digest_v1(rr_tools_v1()) + "\", sdkDigest: \"" + "d".repeat(64) +
        "\", abi: \"gnu\", isa: \"x86_64\", optimization: \"release\"}\n"

fn rr_task_v1() -> BuildTaskV1:
    BuildTaskV1(id: "task_a", attempt: 1, phase: "native", producer_digest: sha256_u8_hex(rr_compiler_v1()),
        source_digest: sha256_text(rr_source_v1()), toolchain_digest: remote_inventory_digest_v1(rr_tools_v1()),
        dependencies: [], program: "tools/simple", args: ["native-build", "src/main.spl"],
        inputs: [BuildInputV1("src/main.spl", sha256_text(rr_source_v1())), rr_tools_v1()[0]],
        outputs: ["artifact/program.bin"], cache_key: sha256_text("remote run cache"), timeout_ms: 500,
        memory_limit_bytes: 536870912, links: [], memory_policy: "enforce")

fn rr_files_v1() -> Dict<text, [u8]>:
    {"tools/simple": rr_compiler_v1(), "tools/runtime.a": rr_runtime_v1(), "src/main.spl": text_to_utf8_bytes(rr_source_v1())}

fn rr_spec_v1() -> RemoteRunSpecV1:
    RemoteRunSpecV1(principal: "user_1", project: "project_1", operation_id: "operation_a", action_kind: "build",
        expected_tests: [], test_report_path: "", maximum_bytes: 65536, toolchain_inputs: ["tools/runtime.a"],
        prepare_deadline_ms: 9000000, reservation_nonce: "nonce_a", backend: "llvm", runtime_digest: "b".repeat(64))

fn rr_inputs_v1() -> RemoteRunHostInputsV1:
    RemoteRunHostInputsV1(image: "registry.invalid/build@sha256:" + "a".repeat(64), launcher_program: "/opt/build/launch",
        guest_root: "/work", host_root: "/var/lib/simple/workspaces/build_a", containment_digest: "c".repeat(64),
        uid: 1000, gid: 1000, cpu_millis: 1000, memory_bytes: 536870912, pid_limit: 256, timeout_ms: 20000,
        profile_digest: "e".repeat(64), slot_binding_digest: "f".repeat(64), preparation_budget_ms: 60000)

fn rr_authored_v1() -> Result<RemoteRunAuthoredV1, text>:
    remote_run_author_v1(rr_spec_v1(), rr_inputs_v1(), rr_task_v1(), rr_environment_text_v1(), rr_files_v1(),
        "controller_1", 7, 5000)

export rr_compiler_v1, rr_runtime_v1, rr_source_v1, rr_tools_v1, rr_environment_text_v1, rr_task_v1, rr_files_v1
export rr_spec_v1, rr_inputs_v1, rr_authored_v1
