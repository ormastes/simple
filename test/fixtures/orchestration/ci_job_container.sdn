apiVersion: ci.simple/v1alpha1
kind: Job
metadata:
    name: echo-container
    namespace: ci
spec:
    template:
        spec:
            os:
                name: linux
            runtimeClassName: native-container
            containers:
                - name: echo
                  image: "docker.io/library/busybox@sha256:aa"
                  command: ["/bin/busybox", "echo", "NONCE-container"]
