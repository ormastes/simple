# SCRIPTED lower-port fixture for the actual claim consumer. No native file,
# deployment authority, Engine response or verified Host admission is provided.
use std.common.contracts.container.exec_state_access_v3.*
use std.common.contracts.container.execution_v2.ContainerHostScopeV2
use std.nogc_sync_mut.io.time_ops.time_sample_unix_micros_or_failure
use std.common.contracts.container.exec_v3.*
use std.common.contracts.container.exec_admission_v3.*
