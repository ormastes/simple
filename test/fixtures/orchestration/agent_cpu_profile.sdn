apiVersion: orchestration.simple/v1alpha1
kind: ResourceProfile
metadata:
    name: agent-cpu
    namespace: caret
spec:
    cpu:
        min: "1000m"
        recommend: "2000m"
        prefer: "4000m"
        limit: "4000m"
    memory:
        min: "2Gi"
        recommend: "4Gi"
        prefer: "8Gi"
        limit: "8Gi"
    gpu:
        required: false
    placement:
        preserveScarceGpuHosts: true
