apiVersion: ci.simple/v1alpha1
kind: Pipeline
metadata:
    name: orchestrator-qualification
spec:
    jobs:
        - name: build-linux
          jobTemplateRef: echo-linux
        - name: build-probe
          jobTemplateRef: echo-probe
        - name: publish
          jobTemplateRef: echo-publish
          runAfter: [build-linux, build-probe]
        - name: evidence
          jobTemplateRef: echo-evidence
          runAfter: [publish]
          runPolicy: always
