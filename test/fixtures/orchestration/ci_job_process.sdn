apiVersion: ci.simple/v1alpha1
kind: Job
metadata:
    name: echo-linux
    namespace: ci
spec:
    backoffLimit: 0
    template:
        spec:
            os:
                name: linux
            runtimeClassName: native-process
            containers:
                - name: echo
                  command: ["/usr/bin/busybox", "echo"]
                  args: ["NONCE-build-linux"]
