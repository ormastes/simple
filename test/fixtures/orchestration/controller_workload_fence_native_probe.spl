# Native diagnostic only; no authenticated receipt or durable state claim.
# Pure projection only: no host effects, journal, execution grants or parent acceptance.
use std.common.contracts.orchestration.placement_v1.*
use std.common.contracts.orchestration.profile_v1.*
use std.common.contracts.orchestration.resource_v1.ObjectMetaV1
use std.common.contracts.orchestration.assignment_v1.*
use std.common.contracts.orchestration.workload_fence_v1.*
use std.common.contracts.orchestration.workload_fence_codec_v1.*
use std.common.contracts.orchestration.host_reservation_codec_v1.*
use std.common.contracts.orchestration.host_capacity_v1.*
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_control_codec_v2.distributed_encode_operation_v2
use std.common.crypto.sha256.sha256_text

fn fence_binding() -> ControllerAssignmentBindingV1:
    val row = HostReservationV1(id: "reservation", operation_id: "host-operation",
        payload_digest: "0".repeat(64), service_scope_id: "user", assignment_generation: 1,
        nonce: "nonce-first", cpu_millis: 2000, memory_bytes: 4000, exclusive_devices: [],
        prepare_deadline_ms: 100, state: HostReservationStateV1.Prepared)
    val intent = host_reservation_bind_intent_v1(HostReservationIntentV1(physical_host_id: "host",
        fence: HostLedgerFenceV1(authority_id: "authority", boot_id: "boot", provider_generation: 1, revision: 1),
        plan_digest: "1".repeat(64), reservation: row)).unwrap()
    val operation = OperationEnvelopeV2(version: 2, id: row.operation_id,
        payload_digest: intent.reservation.payload_digest, principal: "user", project: "project",
        host_id: "host", operation: "host_reservation_v1", environment_digest: "b".repeat(64),
        policy_revision: 1, revocation_epoch: 0, session_generation: 1, memory_bytes: 4000, duration_ms: 100)
    ControllerAssignmentBindingV1(controller_id: "controller", controller_epoch: 1,
        workload_uid: "workload", desired_revision: 1, host_intent: intent, host_operation: operation)

fn fence_initial(binding: ControllerAssignmentBindingV1) -> ControllerWorkloadFenceV1:
    controller_workload_create_v1(binding.controller_id, binding.controller_epoch,
        binding.workload_uid, binding.desired_revision, binding.host_intent.plan_digest).unwrap()

fn fence_control_operation(binding: ControllerAssignmentBindingV1) -> OperationEnvelopeV2:
    var operation = binding.host_operation
    operation.id = "controller-operation"
    operation.host_id = binding.controller_id
    operation.operation = "controller_assignment_v1"
    operation.payload_digest = sha256_text(controller_assignment_bytes_v1(binding).unwrap())
    operation


fn fence_placement_binding() -> ControllerAssignmentBindingV1:
    val profile = ResourceProfileV1(meta: ObjectMetaV1(name: "agent", ns: "caret", labels: {}),
        cpu: ResourceAmountRangeV1(minimum: 1000, recommended: 2000, preferred: 4000, limit: 4000),
        memory: ResourceAmountRangeV1(minimum: 2000, recommended: 4000, preferred: 8000, limit: 8000),
        gpu_required: false, preserve_scarce_gpu_hosts: true)
    val capacity = HostCapacityV1(physical_host_id: "host", authority_id: "authority", boot_id: "boot",
        provider_generation: 1, cpu_millis: 8000, memory_bytes: 16000, exclusive_devices: [])
    val ledger = HostCapacityLedgerV1(capacity: capacity, revision: 7, continuity_proven: true, reservations: [])
    val host = PlacementHostV1(pool_id: "development", service_scope_id: "user", execution_os: "linux",
        architecture: "aarch64", runtime_class: "podman-rootless", authorized: true, healthy: true,
        draining: false, limits_enforced: true, gpu_devices: [], ledger: ledger)
    val request = PlacementRequestV1(pool_id: "development", execution_os: "linux", architecture: "aarch64",
        runtime_class: "podman-rootless", profile: profile, gpu_mode: "none", allow_preferred: false)
    val plan = plan_host_placement_v1(request, [host]).unwrap()
    val selected = plan.offers[plan.selected_index]
    assert(selected.allocation.cpu_millis == 2000)
    assert(selected.allocation.memory_bytes == 4000)
    assert(selected.allocation.cpu_cap_millis == selected.allocation.cpu_millis)
    assert(selected.allocation.memory_cap_bytes == selected.allocation.memory_bytes)
    val identity = PlacementAttemptIdentityV1(reservation_id: "reservation", operation_id: "host-operation",
        assignment_generation: 1, nonce: "nonce-first", plan_digest: "1".repeat(64), prepare_deadline_ms: 100)
    val intent = placement_reservation_intent_v1(plan, identity).unwrap()
    assert(intent.physical_host_id == selected.physical_host_id)
    assert(intent.fence.revision == selected.fence.revision)
    assert(intent.reservation.cpu_millis == selected.allocation.cpu_millis)
    assert(intent.reservation.memory_bytes == selected.allocation.memory_bytes)
    assert(intent.plan_digest == identity.plan_digest)
    assert(ledger.revision == 7)
    assert(ledger.reservations.len() == 0)
    val operation = OperationEnvelopeV2(version: 2, id: intent.reservation.operation_id,
        payload_digest: intent.reservation.payload_digest, principal: "user", project: "project",
        host_id: intent.physical_host_id, operation: "host_reservation_v1", environment_digest: "b".repeat(64),
        policy_revision: 1, revocation_epoch: 0, session_generation: 1,
        memory_bytes: intent.reservation.memory_bytes, duration_ms: 100)
    ControllerAssignmentBindingV1(controller_id: "controller", controller_epoch: 1,
        workload_uid: "workload", desired_revision: 1, host_intent: intent, host_operation: operation)

fn main() -> i64:
    # Case 1: binds one immutable assignment and refuses stale first bind
    fence_case_1()
    # Case 2: retains uncertain assignment until evidence checked retirement exists
    fence_case_2()
    # Case 3: keeps cancellation sticky before and after binding
    fence_case_3()
    # Case 4: matches controller envelope identity and rejects payload or policy tampering
    fence_case_4()
    # Case 5: restores only exact canonical immutable intent and envelope objects
    fence_case_5()
    # Case 6: rejects scope changes generation skips and revision overflow
    fence_case_6()
    # Case 7: round trips canonical fence and rejects invalid or ambiguous wire records
    fence_case_7()
    # Case 8: admits only create first bind and sticky cancel replay transitions
    fence_case_8()
    fence_placement_case()
    print "controller-workload-fence-native-probe: diagnostic assertions passed"
    0

fn fence_case_1():
    val binding = fence_binding()
    val initial = fence_initial(binding)
    assert(controller_workload_bind_v1(initial, 9, binding).is_err())
    val bound = controller_workload_bind_v1(initial, 1, binding).unwrap()
    assert(bound.revision == 2)
    assert(bound.assignment_generation == 1)
    assert(bound.assignment_digest == sha256_text(controller_assignment_bytes_v1(binding).unwrap()))
    assert(controller_workload_matches_v1(bound, binding).unwrap())
    assert(controller_workload_bind_v1(bound, 1, binding).unwrap().revision == 2)

fn fence_case_2():
    val binding = fence_binding()
    val bound = controller_workload_bind_v1(fence_initial(binding), 1, binding).unwrap()
    var replacement = binding
    replacement.host_intent.reservation.assignment_generation = 2
    replacement.host_intent.reservation.nonce = "nonce-replacement"
    replacement.host_intent = host_reservation_bind_intent_v1(replacement.host_intent).unwrap()
    replacement.host_operation.payload_digest = replacement.host_intent.reservation.payload_digest
    assert(controller_workload_bind_v1(bound, 2, replacement).unwrap_err() == "assignment-retirement-required")
    assert(controller_workload_matches_v1(bound, replacement).is_err())

fn fence_case_3():
    val binding = fence_binding()
    val initial = fence_initial(binding)
    val bound = controller_workload_bind_v1(initial, 1, binding).unwrap()
    assert(controller_workload_cancel_v1(bound, 1).is_err())
    val cancelled = controller_workload_cancel_v1(bound, 2).unwrap()
    assert(cancelled.revision == 3)
    assert(cancelled.assignment_digest == bound.assignment_digest)
    assert(controller_workload_cancel_v1(cancelled, 2).unwrap().revision == 3)
    assert(controller_workload_bind_v1(cancelled, 3, binding).is_err())
    val queued_cancel = controller_workload_cancel_v1(initial, 1).unwrap()
    assert(controller_workload_bind_v1(queued_cancel, 2, binding).is_err())

fn fence_case_4():
    val binding = fence_binding()
    val operation = fence_control_operation(binding)
    assert(controller_assignment_match_v1(binding, operation).unwrap())
    var altered = operation
    altered.payload_digest = "e".repeat(64)
    assert(controller_assignment_match_v1(binding, altered).is_err())
    altered = operation
    altered.policy_revision = 2
    assert(controller_assignment_match_v1(binding, altered).is_err())
    altered = operation
    altered.host_id = "other-controller"
    assert(controller_assignment_match_v1(binding, altered).is_err())

fn fence_case_5():
    val binding = fence_binding()
    val bytes = controller_assignment_bytes_v1(binding).unwrap()
    val reference = controller_assignment_decode_reference_v1(bytes).unwrap()
    val intent = host_reservation_encode_intent_v1(binding.host_intent).unwrap()
    val envelope = distributed_encode_operation_v2(binding.host_operation).unwrap()
    val restored = controller_assignment_restore_v1(reference, intent, envelope).unwrap()
    assert(controller_assignment_bytes_v1(restored).unwrap() == bytes)
    assert(controller_assignment_restore_v1(reference, intent + "\n", envelope).is_err())
    assert(controller_assignment_restore_v1(reference, intent, envelope + "\n").is_err())
    assert(controller_assignment_decode_reference_v1(bytes + "extra: true\n").is_err())
    assert(controller_assignment_decode_reference_v1(bytes.replace("controllerEpoch: 1", "controllerEpoch: 2")).unwrap().controller_epoch == 2)
    var mismatched = reference
    mismatched.host_intent_digest = "f".repeat(64)
    assert(controller_assignment_restore_v1(mismatched, intent, envelope).is_err())

fn fence_case_6():
    val binding = fence_binding()
    val initial = fence_initial(binding)
    var different = binding
    different.controller_epoch = 2
    assert(controller_workload_bind_v1(initial, 1, different).is_err())
    different = binding
    different.workload_uid = "other-workload"
    assert(controller_workload_bind_v1(initial, 1, different).is_err())
    different = binding
    different.host_intent.reservation.assignment_generation = 2
    different.host_intent = host_reservation_bind_intent_v1(different.host_intent).unwrap()
    different.host_operation.payload_digest = different.host_intent.reservation.payload_digest
    assert(controller_workload_bind_v1(initial, 1, different).unwrap_err() == "assignment-generation-stale")
    var full = initial
    full.revision = 9223372036854775807
    assert(controller_workload_bind_v1(full, full.revision, binding).is_err())
    assert(controller_workload_cancel_v1(full, full.revision).is_err())

fn fence_case_7():
    val binding = fence_binding()
    val initial = fence_initial(binding)
    val bytes = workload_fence_encode_v1(initial).unwrap()
    val restored = workload_fence_decode_v1(bytes).unwrap()
    assert(workload_fence_encode_v1(restored).unwrap() == bytes)
    assert(workload_fence_decode_v1(bytes + "revision: 2\n").is_err())
    assert(workload_fence_decode_v1(bytes + "extra: true\n").is_err())
    assert(workload_fence_decode_v1(bytes.replace("cancellationRequested: false", "cancellationRequested: \"false\"")).is_err())
    assert(workload_fence_decode_v1(bytes.replace("assignmentGeneration: 0", "assignmentGeneration: 1")).is_err())
    assert(workload_fence_decode_v1("x".repeat(8193)).is_err())

fn fence_case_8():
    val binding = fence_binding()
    val initial = fence_initial(binding)
    val bound = controller_workload_bind_v1(initial, 1, binding).unwrap()
    val cancelled = controller_workload_cancel_v1(bound, 2).unwrap()
    assert(workload_fence_initial_v1(initial))
    assert(not workload_fence_initial_v1(bound))
    assert(workload_fence_successor_v1(initial, bound))
    assert(workload_fence_successor_v1(bound, cancelled))
    assert(not workload_fence_successor_v1(bound, bound))
    assert(not workload_fence_successor_v1(cancelled, bound))
    var forged = bound
    forged.revision = 3
    forged.assignment_digest = "a".repeat(64)
    assert(not workload_fence_successor_v1(bound, forged))
    forged = cancelled
    forged.assignment_generation = 2
    assert(not workload_fence_successor_v1(bound, forged))
    forged = bound
    forged.controller_epoch = 2
    assert(not workload_fence_successor_v1(initial, forged))

fn fence_placement_case():
    val binding = fence_placement_binding()
    val initial = fence_initial(binding)
    val bound = controller_workload_bind_v1(initial, 1, binding).unwrap()
    assert(binding.host_intent.physical_host_id == "host")
    assert(binding.host_intent.fence.authority_id == "authority")
    assert(binding.host_intent.fence.boot_id == "boot")
    assert(binding.host_intent.fence.provider_generation == 1)
    assert(binding.host_intent.fence.revision == 7)
    assert(binding.host_intent.reservation.cpu_millis == 2000)
    assert(binding.host_intent.reservation.memory_bytes == 4000)
    assert(bound.plan_digest == binding.host_intent.plan_digest)
    assert(bound.assignment_generation == binding.host_intent.reservation.assignment_generation)
    assert(bound.assignment_generation == 1)
    assert(bound.assignment_digest == sha256_text(controller_assignment_bytes_v1(binding).unwrap()))
    assert(controller_workload_matches_v1(bound, binding).unwrap())
