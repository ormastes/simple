use std.nogc_sync_mut.io.file_hash_sha256
use std.nogc_sync_mut.io.process_ops.process_run_bounded

# Real external owner fixture. Missing/changed artifacts or unsupported platform
# results fail. Parent dynamic check count can increase on interrupted poll.
pub fn workspace_storage_fork_native_checks_v1(binary: text, expected_digest: text):
    assert(expected_digest.len() == 64)
    assert(file_hash_sha256(binary).unwrap() == expected_digest)
    val result = process_run_bounded(binary, [], 20000, 65536)
    assert(result.2 == 0)
    assert(result.1 == "")
    val lines = result.0.split("\n")
    assert(lines.len() == 3)
    assert(lines[0].starts_with("PASS scoped workspace fork-origin fence: "))
    assert(lines[0].ends_with(" parent checks, 49 child checks; held real mutex, all public entries refused without string allocation; separately injected stat EIO remains quarantined after syscall recovery"))
    assert(lines[1] == "NOT_QUALIFIED: no admitted XFS storage token, successful preparation, namespace-clone transition, Simple ABI execution or Windows handle qualification")
    assert(lines[2] == "")
    assert(file_hash_sha256(binary).unwrap() == expected_digest)
