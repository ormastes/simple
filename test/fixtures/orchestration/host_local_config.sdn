apiVersion: orchestration.simple/v1alpha1
kind: HostConfig
metadata:
    name: host
    namespace: admin
spec:
    physicalHostId: machine
    serviceScopeId: user
    controllerRef: controller
    enrollmentCredentialRef: enrollment
    runtimeClassRef: podman-rootless
    journalRoot: /var/lib/simple/host
    workspaceRoots: [/work]
    budget:
        cpu: 2000m
        memory: 4Gi
        exclusiveDeviceIds: [gpu0]
    maintenanceIntervalMs: 100
    maximumJournalEvents: 10000
