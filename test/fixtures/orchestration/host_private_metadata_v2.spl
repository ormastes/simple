# Pure public-data fixture; no signature, enrollment or engine qualification.
use std.nogc_sync_mut.orchestration.host_private_metadata_v2.HostPrivateMetadataPinsV2
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.common.base_encoding.utilities.base_encoding_text_to_bytes
use std.common.crypto.sha256.sha256_u8_fast_hex

pub fn host_private_metadata_fixture_bytes_v2() -> [[u8]]:
    val key: Dict<text, SdnValue> = {
        "identity": SdnValue.String("issuer"), "role": SdnValue.String("grant-issuer"),
        "revision": SdnValue.Int(1), "publicKeyHex": SdnValue.String("ab".repeat(32)),
        "principal": SdnValue.String("user"), "project": SdnValue.String("project"),
        "hostId": SdnValue.String("host"), "operations": SdnValue.Array([SdnValue.String("host_execute_v1")]),
        "maximumMemoryBytes": SdnValue.Int(8000), "maximumDurationMs": SdnValue.Int(500),
        "policyRevision": SdnValue.Int(1), "revocationEpoch": SdnValue.Int(0),
        "expiresAt": SdnValue.Int(900), "revoked": SdnValue.Bool(false)}
    val policy: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "generation": SdnValue.Int(2),
        "policyRevision": SdnValue.Int(1), "revocationEpoch": SdnValue.Int(0),
        "sessionGeneration": SdnValue.Int(3), "keys": SdnValue.Array([SdnValue.Dict(key)])}
    val configuration = "apiVersion: orchestration.simple/v1alpha1\nkind: HostConfig\n" +
        "metadata:\n    name: host\n    namespace: admin\nspec:\n" +
        "    physicalHostId: machine\n    serviceScopeId: user\n    controllerRef: controller\n" +
        "    enrollmentCredentialRef: enrollment\n    runtimeClassRef: windows-docker-process\n" +
        "    journalRoot: journal\n    workspaceRoots: [work]\n    budget:\n" +
        "        cpu: 2000m\n        memory: 4Gi\n        exclusiveDeviceIds: []\n" +
        "    maintenanceIntervalMs: 100\n    maximumJournalEvents: 10000\n"
    # These are opaque pinned text. Provider/broker schemas are separate ports.
    [base_encoding_text_to_bytes(sdn_encode_canonical(SdnValue.Dict(policy)) + "\n"),
        base_encoding_text_to_bytes(configuration),
        base_encoding_text_to_bytes("version: 2\nkind: engine-policy-fixture\n"),
        base_encoding_text_to_bytes("version: 2\nkind: broker-policy-fixture\n")]

pub fn host_private_metadata_fixture_pins_v2(bytes: [[u8]]) -> HostPrivateMetadataPinsV2:
    HostPrivateMetadataPinsV2(policy_digest: sha256_u8_fast_hex(bytes[0]),
        configuration_digest: sha256_u8_fast_hex(bytes[1]),
        engine_policy_digest: sha256_u8_fast_hex(bytes[2]), broker_policy_digest: sha256_u8_fast_hex(bytes[3]))

export host_private_metadata_fixture_bytes_v2, host_private_metadata_fixture_pins_v2
