# Native authentication exchange shared by installed Windows route scenarios.
use std.sosix.host.sosix_file_read
use std.sosix.time.{sosix_time_now_monotonic_ms, sosix_sleep_ms}
use std.nogc_sync_mut.io.host_service_ready_reader_v1.*
use std.nogc_sync_mut.io.host_service_auth_exchange_v6.*
use std.common.contracts.orchestration.host_service_operation_v6.{HostServiceOperationRequestV6}
use std.common.contracts.orchestration.host_service_operation_reply_v6.{HostServiceOperationReplyV6,
    host_service_operation_reply_match_v6}
use std.common.contracts.orchestration.host_controller_status_v3.{HostControllerStatusV3, host_controller_status_decode_v3}
use std.common.contracts.container.execution_v2.container_scope_fence_id_v2
use std.common.sdn.value.SdnValue
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1


# Actual unresolved native owners survive any assertion failure in this process.
# This is not persistent recovery after process exit and is not a fake owner.
var _route_reader_v6: Option<HostServiceReadyReaderV1> = None
var _route_exchange_v6: Option<HostServiceAuthExchangeV6> = None

pub fn route_fixture_v6() -> Result<Dict<text, text>, text>:
    val source = sosix_file_read("C:\\SimpleQualification\\host-auth-route-v6.sdn")
    route_fixture_parse_v6(source)

pub fn route_fixture_parse_v6(source: text) -> Result<Dict<text, text>, text>:
    if source == "": return Err("missing genuine configured host-auth-route-v6 fixture")
    val parsed = sdn_parse_strict_v1(source, SdnStrictLimitsV1(max_source_bytes: 32768,
        max_depth: 2, max_nodes: 24, max_rows: 0, max_cells: 0, max_columns: 6))
    if parsed.is_err(): return Err("invalid genuine route fixture SDN")
    val fields = match parsed.unwrap().value:
        case SdnValue.Dict(value): value
        case _: return Err("route fixture must be an object")
    val keys = ["setupPath", "setupDigest", "hostDeploymentRoot", "hostAuthorityDigest",
        "expectedScopeDigest", "expectedEnrollmentDigest"]
    if fields.len() != keys.len(): return Err("route fixture must contain exactly six public fields")
    var result: Dict<text, text> = {}
    for key in keys:
        if not fields.contains_key(key): return Err("missing public route fixture field")
        match fields[key]:
            case SdnValue.String(value):
                if value == "": return Err("route fixture field must be nonempty text")
                result[key] = value
            case _: return Err("route fixture field must be nonempty text")
    Ok(result)

fn route_exchange_cleanup_v6() -> text:
    var error = ""
    var exchange_steps = 0
    while _route_exchange_v6.is_some() and error == "" and exchange_steps < 64:
        val closed = host_service_auth_exchange_close_v6(_route_exchange_v6.unwrap())
        _route_exchange_v6 = closed.owner
        exchange_steps = exchange_steps + 1
        if closed.error != "": error = "actual exchange cleanup unconfirmed"
        if closed.owner.is_none() and not closed.completed: error = "actual exchange close consumed but unconfirmed"
    if _route_exchange_v6.is_some() and error == "": error = "actual exchange cleanup budget exhausted"
    error

pub fn route_cleanup_v6() -> text:
    var error = route_exchange_cleanup_v6()
    var reader_steps = 0
    while _route_exchange_v6.is_none() and _route_reader_v6.is_some() and error == "" and reader_steps < 64:
        val closed = host_service_ready_reader_close_v1(_route_reader_v6.unwrap())
        _route_reader_v6 = closed.owner
        reader_steps = reader_steps + 1
        if closed.error != "": error = "actual reader cleanup unconfirmed"
        if closed.owner.is_none() and not closed.completed: error = "actual reader close consumed but unconfirmed"
    if _route_reader_v6.is_some() and error == "": error = "actual reader cleanup budget exhausted"
    error

pub fn route_open_v6(fixture: Dict<text, text>) -> Result<text, text>:
    if _route_reader_v6.is_some() or _route_exchange_v6.is_some():
        return Err("prior actual fixture cleanup remains retained")
    val opened = host_service_ready_reader_open_v1(fixture["setupPath"], fixture["setupDigest"],
        fixture["hostDeploymentRoot"], fixture["hostAuthorityDigest"])
    _route_reader_v6 = opened.owner
    if not opened.ready or opened.owner.is_none() or opened.error != "":
        return Err("genuine protected reader did not become ready")
    host_service_ready_reader_incarnation_v1(opened.owner.unwrap())

fn route_exchange_receive_v6(request: HostServiceOperationRequestV6) -> Result<HostServiceAuthExchangeTurnV6, text>:
    var turn = host_service_auth_exchange_begin_v6(_route_reader_v6.unwrap(), request, 2000)
    _route_exchange_v6 = turn.owner
    val started = sosix_time_now_monotonic_ms()
    var steps = 0
    while (not turn.completed and turn.owner.is_some() and turn.error == "" and
            sosix_time_now_monotonic_ms() - started <= 2100 and steps < 2100):
        turn = host_service_auth_exchange_step_v6(turn.owner.unwrap())
        _route_exchange_v6 = turn.owner
        steps = steps + 1
        if not turn.completed: sosix_sleep_ms(1)
    if not turn.completed or turn.error != "" or turn.reply.is_none() or turn.owner.is_none():
        return Err("actual authenticated response unavailable or uncertain")
    Ok(turn)

fn route_exchange_take_v6(request: HostServiceOperationRequestV6) -> Result<HostServiceOperationReplyV6, text>:
    val turn = route_exchange_receive_v6(request)?
    val reply = host_service_auth_exchange_take_v6(turn.owner.unwrap(), turn.reply.unwrap())?
    val matched = host_service_operation_reply_match_v6(reply, request)?
    Ok(reply)

pub fn route_exchange_v6(request: HostServiceOperationRequestV6) -> Result<HostServiceOperationReplyV6, text>:
    if _route_reader_v6.is_none() or _route_exchange_v6.is_some():
        return Err("actual exchange owner unavailable or still retained")
    val reply = route_exchange_take_v6(request)
    val closed = route_exchange_cleanup_v6()
    if reply.is_err(): return reply
    if closed != "": return Err(closed)
    reply

# Fault at receipt consumption. Wait for one actual authenticated response,
# then retire the owning transport without taking its one-use reply.
pub fn route_exchange_drop_reply_v6(request: HostServiceOperationRequestV6) -> Result<bool, text>:
    if _route_reader_v6.is_none() or _route_exchange_v6.is_some():
        return Err("actual exchange owner unavailable or still retained")
    val received = route_exchange_receive_v6(request)
    val closed = route_exchange_cleanup_v6()
    if received.is_err(): return Err(received.unwrap_err())
    if closed != "": return Err(closed)
    Ok(true)

pub fn route_status_v6(fixture: Dict<text, text>, incarnation: text) -> Result<HostControllerStatusV3, text>:
    val reply = route_exchange_v6(HostServiceOperationRequestV6("status", incarnation, "", "", "", ""))?
    if reply.pending or reply.exit_code != 0 or reply.error != "": return Err("genuine Host status refused")
    val status = host_controller_status_decode_v3(reply.payload)?
    if (not status.ready or container_scope_fence_id_v2(status.scope)? != fixture["expectedScopeDigest"] or
            status.enrollment_digest != fixture["expectedEnrollmentDigest"]): return Err("genuine Host fixture status mismatch")
    Ok(status)

pub fn route_client_released_v6() -> bool:
    _route_exchange_v6.is_none() and _route_reader_v6.is_none()
