# Standalone real filesystem diagnostic; NOT_RUN, no grant authentication.
# Real private-root administrator installation only; synthetic PUBLIC keys.
# No signing, workload dispatch, enrollment or authenticated grant is exercised.
use std.nogc_sync_mut.orchestration.controller_dispatch_config_v1.*
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_create_exclusive, file_read_regular_no_follow_bounded, file_is_regular_no_follow, file_remove, file_fsync, directory_fsync}
use std.nogc_sync_mut.sffi.fs.file_atomic_write_mode
use std.nogc_sync_mut.package_sffi.create_symlink
use std.nogc_sync_mut.file_system.permissions.file_set_mode
use std.nogc_sync_mut.file_system.metadata.file_mode_bits
use std.nogc_sync_mut.io_runtime.dir_remove
use std.common.crypto.sha256.sha256_text
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.common.contracts.orchestration.resource_v1.{parse_resource_document, as_dict}
use std.common.string_core.str_len

struct DispatchConfigFixtureV1:
    parent: text
    root: text
    host_root: text
    policy_bytes: text
    config_bytes: text

fn dispatch_config_policy_fixture_v1(session: i64) -> text:
    val key: Dict<text, SdnValue> = {"identity": SdnValue.String("issuer"), "role": SdnValue.String("grant-issuer"),
        "revision": SdnValue.Int(1), "publicKeyHex": SdnValue.String("ab".repeat(32)),
        "principal": SdnValue.String("user"), "project": SdnValue.String("project"),
        "hostId": SdnValue.String("host"), "operations": SdnValue.Array([SdnValue.String("host_execute_v1")]),
        "maximumMemoryBytes": SdnValue.Int(8000), "maximumDurationMs": SdnValue.Int(500),
        "policyRevision": SdnValue.Int(1), "revocationEpoch": SdnValue.Int(0),
        "expiresAt": SdnValue.Int(900), "revoked": SdnValue.Bool(false)}
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "generation": SdnValue.Int(2),
        "policyRevision": SdnValue.Int(1), "revocationEpoch": SdnValue.Int(0),
        "sessionGeneration": SdnValue.Int(session), "keys": SdnValue.Array([SdnValue.Dict(key)])}
    sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"

fn dispatch_config_fixture_v1() -> DispatchConfigFixtureV1:
    val parent = secure_temp_dir("/tmp", "controller-dispatch-config-").unwrap()
    val root = secure_temp_dir(parent, "controller-").unwrap()
    val host_root = secure_temp_dir(parent, "host-").unwrap()
    val marker = "version: 1\nkind: orchestrator-local-state\ncontrollerId: \"controller\"\n"
    assert(file_create_exclusive(root + "/controller.sdn", marker))
    assert(file_fsync(root + "/controller.sdn"))
    assert(directory_fsync(root))
    val policy_bytes = dispatch_config_policy_fixture_v1(3)
    val config = ControllerDispatchConfigV1(controller_id: "controller", controller_epoch: 1,
        target: "local-inprocess", host_root: host_root, host_authority_id: "host-authority", provider_identity_digest: "e".repeat(64),
        authority_policy_digest: sha256_text(policy_bytes))
    DispatchConfigFixtureV1(parent: parent, root: root, host_root: host_root,
        policy_bytes: policy_bytes, config_bytes: controller_dispatch_config_encode_v1(config).unwrap())

fn dispatch_config_install_fixture_v1(fixture: DispatchConfigFixtureV1) -> ControllerDispatchContextV1:
    controller_dispatch_config_install_v1(fixture.root, "controller", fixture.config_bytes, fixture.policy_bytes).unwrap()

fn dispatch_config_wire_field_v1(source: text, key: text, value: SdnValue) -> text:
    val parsed = parse_resource_document(source).unwrap()
    var fields = as_dict(parsed.0, "", parsed.1).unwrap()
    fields[key] = value
    sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"

fn dispatch_config_assert_bytes_v1(fixture: DispatchConfigFixtureV1):
    assert(file_read_regular_no_follow_bounded(fixture.root + "/dispatch-config.sdn", 16384).unwrap() == fixture.config_bytes)
    assert(file_read_regular_no_follow_bounded(fixture.root + "/authority-policy.sdn", 1048576).unwrap() == fixture.policy_bytes)

fn main() -> i64:
    dispatch_config_case_1()
    dispatch_config_case_2()
    dispatch_config_case_3()
    dispatch_config_case_4()
    dispatch_config_case_5()
    dispatch_config_case_6()
    dispatch_config_case_7()
    print "controller-dispatch-config-probe: private administrator install assertions passed"
    0

fn dispatch_config_case_1():
    val fixture = dispatch_config_fixture_v1()
    val context = dispatch_config_install_fixture_v1(fixture)
    assert(context.config.target == "local-inprocess")
    assert(context.config.controller_id == "controller")
    assert(context.config.host_root == fixture.host_root)
    assert(context.config.host_authority_id == "host-authority")
    assert(context.config.provider_identity_digest == "e".repeat(64))
    assert(context.policy.source_digest == sha256_text(fixture.policy_bytes))
    assert(context.policy.session_generation == 3)
    assert(context.policy.snapshot.keys["grant-issuer/issuer"].public_key[0] as i64 == 171)
    dispatch_config_assert_bytes_v1(fixture)
    assert(file_mode_bits(fixture.root) == 0o700)
    assert(file_mode_bits(fixture.root + "/dispatch-config.sdn") == 0o600)
    assert(file_mode_bits(fixture.root + "/authority-policy.sdn") == 0o600)
    assert(file_fsync(fixture.root + "/dispatch-config.sdn"))
    assert(file_fsync(fixture.root + "/authority-policy.sdn"))
    assert(directory_fsync(fixture.root))
    val loaded = controller_dispatch_context_load_v1(fixture.root, "controller").unwrap()
    assert(loaded.config.authority_policy_digest == context.config.authority_policy_digest)
    assert(loaded.policy.source_digest == context.policy.source_digest)
    assert(dir_remove(fixture.parent, true))

fn dispatch_config_case_2():
    val fixture = dispatch_config_fixture_v1()
    assert(file_create_exclusive(fixture.root + "/authority-policy.sdn", fixture.policy_bytes))
    assert(file_fsync(fixture.root + "/authority-policy.sdn"))
    assert(directory_fsync(fixture.root))
    assert(not file_is_regular_no_follow(fixture.root + "/dispatch-config.sdn"))
    val installed = dispatch_config_install_fixture_v1(fixture)
    val replay = dispatch_config_install_fixture_v1(fixture)
    assert(installed.policy.source_digest == replay.policy.source_digest)
    dispatch_config_assert_bytes_v1(fixture)
    assert(dir_remove(fixture.parent, true))

fn dispatch_config_case_3():
    val fixture = dispatch_config_fixture_v1()
    val installed = dispatch_config_install_fixture_v1(fixture)
    var changed = installed.config
    changed.controller_epoch = 2
    val changed_bytes = controller_dispatch_config_encode_v1(changed).unwrap()
    assert(controller_dispatch_config_install_v1(fixture.root, "controller", changed_bytes, fixture.policy_bytes).unwrap_err() == "dispatch-install-immutable-mismatch")
    val other_policy = dispatch_config_policy_fixture_v1(4)
    assert(controller_dispatch_config_install_v1(fixture.root, "controller", fixture.config_bytes, other_policy).unwrap_err() == "dispatch-policy-pin-mismatch")
    changed.authority_policy_digest = sha256_text(other_policy)
    assert(controller_dispatch_config_install_v1(fixture.root, "controller", controller_dispatch_config_encode_v1(changed).unwrap(), other_policy).unwrap_err() == "dispatch-install-immutable-mismatch")
    dispatch_config_assert_bytes_v1(fixture)
    assert(dir_remove(fixture.parent, true))

fn dispatch_config_case_4():
    val fixture = dispatch_config_fixture_v1()
    val installed = dispatch_config_install_fixture_v1(fixture)
    assert(file_set_mode(fixture.root + "/dispatch-config.sdn", 0o644))
    assert(controller_dispatch_context_load_v1(fixture.root, "controller").unwrap_err() == "dispatch-file-not-private")
    assert(file_set_mode(fixture.root + "/dispatch-config.sdn", 0o600))
    assert(file_set_mode(fixture.root + "/authority-policy.sdn", 0o644))
    assert(controller_dispatch_context_load_v1(fixture.root, "controller").unwrap_err() == "local-policy-file-not-private")
    assert(file_set_mode(fixture.root + "/authority-policy.sdn", 0o600))
    assert(file_set_mode(fixture.root, 0o755))
    assert(controller_dispatch_context_load_v1(fixture.root, "controller").unwrap_err() == "dispatch-root-not-private")
    assert(file_set_mode(fixture.root, 0o700))
    assert(file_atomic_write_mode(fixture.root + "/authority-policy.sdn", dispatch_config_policy_fixture_v1(4), 0o600))
    assert(file_fsync(fixture.root + "/authority-policy.sdn"))
    assert(controller_dispatch_context_load_v1(fixture.root, "controller").unwrap_err() == "local-policy-digest-mismatch")
    assert(dir_remove(fixture.parent, true))

fn dispatch_config_case_5():
    val fixture = dispatch_config_fixture_v1()
    assert(controller_dispatch_context_load_v1(fixture.root, "other-controller").unwrap_err() == "dispatch-controller-mismatch")
    for root in ["relative", "/", fixture.root + "/", fixture.root + "/../other", fixture.root + "//other", fixture.root + "\n"]:
        assert(controller_dispatch_config_install_v1(root, "controller", fixture.config_bytes, fixture.policy_bytes).unwrap_err() == "dispatch-root-identity-invalid")
    var config = controller_dispatch_config_decode_v1(fixture.config_bytes).unwrap()
    config.host_root = fixture.root
    assert(controller_dispatch_config_install_v1(fixture.root, "controller", controller_dispatch_config_encode_v1(config).unwrap(), fixture.policy_bytes).unwrap_err() == "dispatch-owner-roots-must-differ")
    config.host_root = "relative"
    assert(controller_dispatch_config_encode_v1(config).is_err())
    config.host_root = fixture.host_root
    config.provider_identity_digest = "invalid"
    assert(controller_dispatch_config_encode_v1(config).is_err())
    assert(file_atomic_write_mode(fixture.root + "/controller.sdn", "wrong-marker", 0o600))
    assert(file_fsync(fixture.root + "/controller.sdn"))
    assert(controller_dispatch_config_install_v1(fixture.root, "controller", fixture.config_bytes, fixture.policy_bytes).unwrap_err() == "dispatch-controller-mismatch")
    assert(dir_remove(fixture.parent, true))

fn dispatch_config_case_6():
    val fixture = dispatch_config_fixture_v1()
    val root_link = fixture.parent + "/root-link"
    assert(create_symlink(fixture.root, root_link))
    assert(controller_dispatch_config_install_v1(root_link, "controller", fixture.config_bytes, fixture.policy_bytes).unwrap_err() == "dispatch-root-not-real")
    assert(file_remove(root_link))
    val ancestor_link = fixture.parent + "/ancestor-link"
    assert(create_symlink(fixture.parent, ancestor_link))
    val tail = fixture.root.slice(fixture.parent.len() + 1, fixture.root.len())
    assert(controller_dispatch_config_install_v1(ancestor_link + "/" + tail, "controller", fixture.config_bytes, fixture.policy_bytes).unwrap_err() == "dispatch-root-not-real")
    assert(file_remove(ancestor_link))
    val outside_policy = fixture.parent + "/outside-policy.sdn"
    assert(file_atomic_write_mode(outside_policy, fixture.policy_bytes, 0o600))
    assert(create_symlink(outside_policy, fixture.root + "/authority-policy.sdn"))
    assert(controller_dispatch_config_install_v1(fixture.root, "controller", fixture.config_bytes, fixture.policy_bytes).unwrap_err() == "dispatch-file-not-regular")
    assert(file_read_regular_no_follow_bounded(outside_policy, 1048576).unwrap() == fixture.policy_bytes)
    assert(file_remove(fixture.root + "/authority-policy.sdn"))
    val installed = dispatch_config_install_fixture_v1(fixture)
    assert(file_remove(fixture.root + "/dispatch-config.sdn"))
    val outside_config = fixture.parent + "/outside-config.sdn"
    assert(file_atomic_write_mode(outside_config, fixture.config_bytes, 0o600))
    assert(create_symlink(outside_config, fixture.root + "/dispatch-config.sdn"))
    assert(controller_dispatch_context_load_v1(fixture.root, "controller").unwrap_err() == "dispatch-file-not-regular")
    assert(file_read_regular_no_follow_bounded(outside_config, 16384).unwrap() == fixture.config_bytes)
    assert(file_remove(fixture.root + "/dispatch-config.sdn"))
    assert(dir_remove(fixture.parent, true))

fn dispatch_config_case_7():
    val fixture = dispatch_config_fixture_v1()
    assert(controller_dispatch_config_decode_v1("{").is_err())
    assert(controller_dispatch_config_decode_v1(fixture.config_bytes + "\n").unwrap_err() == "dispatch-config-noncanonical")
    assert(controller_dispatch_config_decode_v1(dispatch_config_wire_field_v1(fixture.config_bytes, "authenticated", SdnValue.Bool(true))).is_err())
    assert(controller_dispatch_config_decode_v1(dispatch_config_wire_field_v1(fixture.config_bytes, "controllerEpoch", SdnValue.String("1"))).unwrap_err() == "dispatch-config-epoch")
    assert(controller_dispatch_config_decode_v1(dispatch_config_wire_field_v1(fixture.config_bytes, "target", SdnValue.String("remote-daemon"))).unwrap_err() == "dispatch-target-unsupported")
    val head = fixture.config_bytes.slice(0, fixture.config_bytes.len() - 2)
    assert(controller_dispatch_config_decode_v1(head + ", controllerEpoch: 1" + "}\n").is_err())
    val too_large = "é".repeat(8193)
    assert(str_len(too_large) == 16386)
    assert(controller_dispatch_config_decode_v1(too_large).unwrap_err() == "dispatch-config-size")
    assert(controller_dispatch_config_install_v1(fixture.root, "controller", fixture.config_bytes, "é".repeat(524289)).is_err())
    assert(not file_is_regular_no_follow(fixture.root + "/dispatch-config.sdn"))
    assert(not file_is_regular_no_follow(fixture.root + "/authority-policy.sdn"))
    assert(dir_remove(fixture.parent, true))
