# Pure invocation/signature fixture DATA. Not installed authority or an opaque
# probe/source owner. No native workload or staging is fabricated by this file.
use test.fixtures.orchestration.host_execution_envelope_fixture_v2.*
use test.fixtures.daemon_sdk.distributed_authority_verification_fixture_v2.*
use std.common.contracts.orchestration.agent_workspace_invocation_v1.*
use std.common.contracts.orchestration.agent_workspace_invocation_packet_v1.*
use std.common.contracts.orchestration.agent_task_use_v1.AgentTaskUseBindingV1
use std.common.contracts.orchestration.agent_invocation_binding_v1.AgentTaskInputV1
use std.common.contracts.orchestration.desired_input_v1.controller_desired_input_select_v1
use std.common.contracts.container.agent_workspace_manifest_v1.*
use std.common.contracts.container.execution_v2.{ContainerHostScopeV2, container_host_scope_bytes_v2}
use std.common.contracts.distributed_control_v2.OperationEnvelopeV2
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2, DistributedSignedApprovalV2}
use std.common.contracts.distributed_control_codec_v2.{distributed_encode_operation_v2, distributed_encode_grant_v2}
use std.nogc_sync_mut.orchestration.host_capacity_owner_v1.HostReservationAuthorizationContextV1
use std.nogc_sync_mut.orchestration.local_authority_policy_v1.LocalAuthorityPolicyV1
