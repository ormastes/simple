use std.nogc_sync_mut.io.file_hash_sha256
use std.nogc_sync_mut.io.process_ops.process_run_bounded

# This is a real external production-owner component fixture. Missing artifacts,
# identity changes and unsupported-platform exit77 fail; no success skip exists.
pub fn workspace_preparation_native_checks_v1(binary: text, expected_digest: text):
    assert(expected_digest.len() == 64)
    assert(file_hash_sha256(binary).unwrap() == expected_digest)
    val result = process_run_bounded(binary, [], 20000, 65536)
    assert(result.2 == 0)
    assert(result.1 == "")
    assert(result.0 == "PASS scoped executable-preparation components: 163 dynamic checks; hashes, bounds, deadlines, refusal, real mount observation\nBLOCKED full positive preparation: requires admitted keeper authority, actual XFS project quota and verified RO/RW guest mounts; no chmod success qualified\n")
    assert(file_hash_sha256(binary).unwrap() == expected_digest)
