apiVersion: orchestration.simple/v1alpha1
kind: ResourceList
metadata:
    name: caret-policy
spec:
    items:
        - apiVersion: orchestration.simple/v1alpha1
          kind: ResourceProfile
          metadata:
              name: agent-cpu
              namespace: caret
          spec:
              cpu:
                  min: "1000m"
                  recommend: "2000m"
                  prefer: "4000m"
              memory:
                  min: "2Gi"
                  recommend: "4Gi"
                  prefer: "8Gi"
        - apiVersion: orchestration.simple/v1alpha1
          kind: HostPool
          metadata:
              name: development-linux
              namespace: caret
          spec:
              executionOS: linux
              architecture: aarch64
              runtimeClassRefs: [podman-rootless]
              trustClass: development
        - apiVersion: orchestration.simple/v1alpha1
          kind: RuntimeClass
          metadata:
              name: podman-rootless
              namespace: caret
          spec:
              provider: podman
              executionOS: linux
              architecture: aarch64
              isolation: rootless
