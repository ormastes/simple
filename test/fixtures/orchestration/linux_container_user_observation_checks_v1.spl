use std.nogc_sync_mut.io.file_hash_sha256
use std.nogc_sync_mut.io.process_ops.process_run_bounded

# Real separately built Core-C owner fixture. A missing or different executable
# fails; neither absent support nor exit77 is accepted as a successful skip.
pub fn linux_container_user_native_checks_v1(binary: text, expected_digest: text):
    assert(expected_digest.len() == 64)
    assert(file_hash_sha256(binary).unwrap() == expected_digest)
    val result = process_run_bounded(binary, [], 20000, 65536)
    assert(result.2 == 0)
    assert(result.1 == "")
    assert(result.0 == "PASS real Linux user observer: 61 checks; pidfd lifetime, namespace facts, kind/binding/generation, no reap, no FD leak\n")
    assert(file_hash_sha256(binary).unwrap() == expected_digest)
