# Execution NOT_RUN. Real signed primary helper admission/journal fixture.
# Broker claim/request are synthetic refusal metadata only; no native process
# or successful cleanup is simulated.
use test.fixtures.orchestration.host_helper_fixture_v1.*
use test.fixtures.daemon_sdk.distributed_authority_verification_fixture_v2.verification_fixture
use std.nogc_sync_mut.orchestration.host_helper_owner_v1.*
use std.nogc_sync_mut.orchestration.host_capacity_owner_v1.*
use std.nogc_sync_mut.orchestration.host_helper_stream_record_v1.*
use std.nogc_sync_mut.orchestration.host_helper_request_v1.{host_helper_request_encode_v1, host_helper_execution_proof_load_v1}
use std.common.contracts.orchestration.host_capacity_v1.HostLedgerFenceV1
use std.common.contracts.container.primary_attach_v1.*
use std.nogc_sync_mut.orchestration.host_primary_attach_record_v1.*
use test.fixtures.orchestration.host_helper_settlement_fixture_v1.host_helper_settlement_plan_v1
use std.common.build_manager.group_process_stream_protocol_v2.*
use std.common.contracts.distributed_control_codec_v2.distributed_encode_operation_v2
use std.common.crypto.sha256.sha256_text

pub struct HostPrimaryAttachSettlementFixtureV1:
    fixture: HostHelperFixtureV1
    owner: HostCapacityOwnerV1
    helper: HostHelperLeaseV1
    primary_plan: ContainerPrimaryAttachPlanV1
    consumed: HostPrimaryAttachConsumedV1

pub fn host_primary_attach_settlement_plan_v1(fixture: HostHelperFixtureV1) -> ContainerPrimaryAttachPlanV1:
    val output = host_helper_settlement_plan_v1(fixture)
    var launch = output.launch_template
    launch.request.args = ["attach", "--no-stdin=false", "--sig-proxy=false", "--detach-keys=", output.runtime.native_id]
    launch.request.child_argv_digest = group_process_child_argv_digest_v2(launch.request.program, launch.request.args)
    var plan = ContainerPrimaryAttachPlanV1(terminal_mode: "stdin", workload: output.workload,
        runtime: output.runtime, identity: output.identity, resources: output.resources,
        provider_identity_digest: output.provider_identity_digest, policy_digest: output.policy_digest,
        launch_template: launch, request_digest: "")
    plan.request_digest = container_primary_attach_plan_digest_v1(plan).unwrap()
    plan

pub fn host_primary_attach_settlement_fixture_v1() -> HostPrimaryAttachSettlementFixtureV1:
    var fixture = host_helper_fixture_v1()
    val parent = fixture.request.parent_binding
    var grant = verification_fixture().signed.grant
    grant.operations = ["host_reservation_v1", "host_execute_v1"]
    grant.host_id = parent.host_operation.host_id
    grant.principal = parent.host_operation.principal
    grant.project = parent.host_operation.project
    grant.environment_digest = parent.host_operation.environment_digest
    val receipt = host_capacity_owner_prepared_receipt_v1(fixture.owner, parent.host_intent,
        parent.host_operation, grant, host_helper_clock_v1()).unwrap()
    val cap = fixture.owner.ledger.capacity
    val fence = HostLedgerFenceV1(authority_id: cap.authority_id, boot_id: cap.boot_id,
        provider_generation: cap.provider_generation, revision: fixture.owner.ledger.revision)
    val executing = host_capacity_owner_begin_v1(fixture.owner, parent.host_intent, parent.host_operation,
        receipt, fence, grant, host_helper_clock_v1()).unwrap()
    fixture.request.plan.helper_kind = "attach-broker"
    val plan = host_primary_attach_settlement_plan_v1(fixture)
    fixture.request.plan.request_digest = plan.request_digest
    fixture = host_helper_sibling_fixture_v1(fixture, executing, fixture.request.operation.id)
    val prepared = host_helper_prepare_v1(fixture.owner, fixture.request, fixture.policy, fixture.scope,
        host_helper_clock_v1(), host_helper_clock_v1)
    assert(prepared.error == "", prepared.error)
    val begun = host_helper_begin_v1(prepared.owner, fixture.request, prepared.receipt.unwrap(),
        fixture.execution_signed, fixture.execution_approval, fixture.policy, fixture.scope,
        host_helper_clock_v1(), host_helper_clock_v1)
    assert(begun.error == "", begun.error)
    val helper = begun.lease.unwrap()
    val record = HostPrimaryAttachConsumedV1(operation_id: helper.operation.id,
        operation_digest: sha256_text(distributed_encode_operation_v2(helper.operation).unwrap()),
        packet_digest: sha256_text(host_helper_request_encode_v1(fixture.request).unwrap()),
        execution_proof_digest: sha256_text(host_helper_execution_proof_load_v1(fixture.root, helper.operation.id).unwrap()),
        prepared_receipt_digest: helper.receipt.receipt_digest, deadline_unix_ms: helper.deadline.expires_at_unix_ms,
        primary_plan: plan)
    HostPrimaryAttachSettlementFixtureV1(fixture: fixture, owner: begun.owner, helper: helper, primary_plan: plan, consumed: record)

use std.nogc_sync_mut.io.group_process_owner.{GroupProcessStreamOwnerV2, group_process_stream_prepare_v2}

use std.nogc_sync_mut.io_runtime.dir_create

# Claim/request files are planning metadata ONLY, never terminal/process proof.
pub fn host_primary_attach_settlement_metadata_v1(fixture: HostPrimaryAttachSettlementFixtureV1,
        archive: bool = true) -> GroupProcessStreamOwnerV2:
    host_helper_stream_publish_v1(fixture.fixture.root, fixture.helper.operation.id, "primary-consumed",
        host_primary_attach_consumed_encode_v1(fixture.consumed).unwrap(), true).unwrap()
    var launch = fixture.primary_plan.launch_template
    launch.transport_generation = 11
    launch.request.launch_deadline_unix_ms = fixture.helper.deadline.expires_at_unix_ms
    assert(dir_create(launch.root, true))
    val native = group_process_stream_prepare_v2(launch).unwrap()
    if archive: host_primary_attach_native_store_v1(fixture.fixture.root, fixture.helper.operation, native).unwrap()
    native
