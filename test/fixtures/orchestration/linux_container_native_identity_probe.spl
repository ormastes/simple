# Direct native uname owner diagnostic. Authored only; never built/run here.
use std.nogc_sync_mut.sffi.linux_uname_v1.linux_native_uname_architecture_v1

fn main() -> i32:
    val architecture = match linux_native_uname_architecture_v1():
        case Ok(value): value
        case Err(reason):
            assert(false, reason)
            ""
    assert(["x86_64", "aarch64", "riscv64", "i686", "arm"].contains(architecture))
    print "Linux native uname observation: " + architecture
    0
