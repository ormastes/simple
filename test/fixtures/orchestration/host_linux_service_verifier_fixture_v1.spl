# Deterministic real Ed25519 Linux service enrollment association. NOT_RUN.
# Pure bytes only: no protected root, provider, native identity or writer.
use std.common.contracts.orchestration.host_linux_service_enrollment_v3.*
use std.nogc_sync_mut.io.host_enrollment_v1.HostEnrollmentCredentialV1
use std.nogc_sync_mut.daemon_sdk.distributed_grant_verification_v2.{distributed_grant_signature_message_v2, distributed_approval_signature_message_v2}
use std.common.contracts.distributed_control_v2.{OperationEnvelopeV2, ExecutionGrantV2}
use std.common.contracts.distributed_authority_v2.{DistributedSignedGrantV2, DistributedSignedApprovalV2}
use std.common.contracts.distributed_control_codec_v2.{distributed_encode_operation_v2, distributed_encode_grant_v2}
use std.common.build_manager.group_process_stream_profile_v3.{GroupProcessCpuQuotaV3, GroupProcessBrokerBudgetV3, GroupProcessStreamProfileV3}
use std.common.build_manager.group_process_stream_protocol_v2.{GroupProcessStreamRequestV2, GroupProcessStreamLaunchV2, group_process_child_argv_digest_v2, group_process_stream_template_encode_v3}
use std.common.crypto.ed25519.pure_ed25519_sign_from_seed_v1
use std.common.crypto.sha256.sha256_text
use std.common.binary_inspect.bytes_to_hex_canonical
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical

# 2100-01-01T00:00:00Z in Unix milliseconds: never expires during a test run.
val LINUX_VERIFIER_FAR_V1: i64 = 4102444800000

pub struct LinuxServiceVerifierFixtureV1:
    binding: HostLinuxServiceEnrollmentBindingV3
    credential: HostEnrollmentCredentialV1
    policy: text
    configuration: text
    engine_policy: text
    broker_policy: text
    # milestone_0021 F15 (B): installed agent-helper-template.sdn bytes, pinned by binding.agent_helper_template_digest.
    agent_helper_template: text

fn linux_verifier_seed_v1(offset: i64) -> [u8]:
    var seed: [u8] = []
    for i in 0..32: seed.push((i + offset) as u8)
    seed

fn linux_verifier_bytes_v1(message: text) -> [u8]:
    var out: [u8] = []
    for i in 0..message.byte_len(): out.push(message.byte_at(i) as u8)
    out

fn linux_verifier_public_hex_v1(offset: i64) -> text:
    val derived = pure_ed25519_sign_from_seed_v1(linux_verifier_seed_v1(offset), linux_verifier_bytes_v1("public-key"))
    var wide: [i64] = []
    for byte in derived.public_key: wide.push(byte as i64)
    bytes_to_hex_canonical(wide)

fn linux_verifier_key_v1(identity: text, role: text, offset: i64, operations: [text]) -> SdnValue:
    var allowed: [SdnValue] = []
    for operation in operations: allowed.push(SdnValue.String(operation))
    SdnValue.Dict({"identity": SdnValue.String(identity), "role": SdnValue.String(role), "revision": SdnValue.Int(1),
        "publicKeyHex": SdnValue.String(linux_verifier_public_hex_v1(offset)), "principal": SdnValue.String("user_1"),
        "project": SdnValue.String("project_1"), "hostId": SdnValue.String("worker_1"),
        "operations": SdnValue.Array(allowed), "maximumMemoryBytes": SdnValue.Int(1073741824),
        "maximumDurationMs": SdnValue.Int(2000), "policyRevision": SdnValue.Int(4), "revocationEpoch": SdnValue.Int(2),
        "expiresAt": SdnValue.Int(LINUX_VERIFIER_FAR_V1), "revoked": SdnValue.Bool(false)})

# Installed administrator policy: the two public keys derived from the seeds.
pub fn linux_service_verifier_policy_v1(issuer_offset: i64, approver_offset: i64) -> text:
    linux_service_verifier_policy_ops_v1(issuer_offset, approver_offset, ["host_enroll_v1"])

# Same installed policy whose two keys may also sign the given operations.
pub fn linux_service_verifier_policy_ops_v1(issuer_offset: i64, approver_offset: i64, operations: [text]) -> text:
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "generation": SdnValue.Int(7),
        "policyRevision": SdnValue.Int(4), "revocationEpoch": SdnValue.Int(2), "sessionGeneration": SdnValue.Int(3),
        "keys": SdnValue.Array([linux_verifier_key_v1("issuer_1", "grant-issuer", issuer_offset, operations),
            linux_verifier_key_v1("approver_1", "human-approver", approver_offset, operations)])}
    sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"

fn linux_verifier_configuration_v1() -> text:
    "apiVersion: orchestration.simple/v1alpha1\nkind: HostConfig\nmetadata:\n    name: host\n    namespace: admin\n" +
        "spec:\n    physicalHostId: worker_1\n    serviceScopeId: service_1\n    controllerRef: issuer_1\n" +
        "    enrollmentCredentialRef: enrollment\n    runtimeClassRef: podman-rootless\n    journalRoot: journal\n" +
        "    workspaceRoots: [/work]\n    budget:\n        cpu: 2000m\n        memory: 512Mi\n        exclusiveDeviceIds: []\n" +
        "    maintenanceIntervalMs: 100\n    maximumJournalEvents: 10000\n"

fn linux_verifier_broker_v1() -> text:
    val program = "/opt/helper"
    val args = ["--output"]
    val request = GroupProcessStreamRequestV2(program: program, producer_digest: "a".repeat(64),
        args: args, environment: [], directory: "/work", inputs: [], timeout_ms: 5000,
        broker_program: "/opt/broker", broker_digest: "b".repeat(64),
        child_argv_digest: group_process_child_argv_digest_v2(program, args), launch_deadline_unix_ms: 1900000000000)
    val profile = GroupProcessStreamProfileV3(helper_cpu: GroupProcessCpuQuotaV3(25, 2500, 100000),
        broker: GroupProcessBrokerBudgetV3("/sys/fs/cgroup/service/broker", 11, 22, 3,
            "c".repeat(64), 250000, 1000000, 250, 67108864, 134217728),
        child_image_mode: "trusted-local-admin-image-fd-v1")
    val launch = GroupProcessStreamLaunchV2(root: "/work/owner", worker_id: "worker_1", generation: 7,
        snapshot_digest: "d".repeat(64), cache_identity: "e".repeat(64), memory_limit_bytes: 1048576,
        request: request, delegated_cgroup_path: "/sys/fs/cgroup/service", transport_generation: 34,
        profile_v3: Some(profile))
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(4), "kind": SdnValue.String("linux-host-service-broker-policy"),
        "template": SdnValue.String(group_process_stream_template_encode_v3(launch).unwrap())}
    sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"

# Agent helper template: canonical, normalized (the template encode zeroes the dynamic fields), profiled,
# args ["version"], pinned root prefix under the run root's launch- namespace.
pub fn linux_verifier_agent_helper_template_v1() -> text:
    val program = "/opt/helper"
    val args = ["version"]
    val request = GroupProcessStreamRequestV2(program: program, producer_digest: "a".repeat(64),
        args: args, environment: [], directory: "/work", inputs: [], timeout_ms: 5000,
        broker_program: "/opt/broker", broker_digest: "b".repeat(64),
        child_argv_digest: group_process_child_argv_digest_v2(program, args), launch_deadline_unix_ms: 0)
    val profile = GroupProcessStreamProfileV3(helper_cpu: GroupProcessCpuQuotaV3(25, 2500, 100000),
        broker: GroupProcessBrokerBudgetV3("/sys/fs/cgroup/service/broker", 11, 22, 3,
            "c".repeat(64), 250000, 1000000, 250, 67108864, 134217728),
        child_image_mode: "trusted-local-admin-image-fd-v1")
    val launch = GroupProcessStreamLaunchV2(root: "/run/simple/launch-agent", worker_id: "worker_1", generation: 7,
        snapshot_digest: "d".repeat(64), cache_identity: "e".repeat(64), memory_limit_bytes: 1048576,
        request: request, delegated_cgroup_path: "/sys/fs/cgroup/service", transport_generation: 0,
        profile_v3: Some(profile))
    val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("linux-host-service-agent-helper-template"),
        "template": SdnValue.String(group_process_stream_template_encode_v3(launch).unwrap())}
    sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"

fn linux_verifier_binding_v1(policy: text, configuration: text, engine_policy: text,
        broker_policy: text, parent: text) -> HostLinuxServiceEnrollmentBindingV3:
    HostLinuxServiceEnrollmentBindingV3(physical_host_id: "worker_1", service_scope_id: "service_1",
        config_digest: sha256_text(configuration), policy_digest: sha256_text(policy), policy_revision: 4,
        native_machine_id: "linux-machine-id-v1:0123456789abcdef", provider_identity_digest: "a".repeat(64),
        engine_policy_digest: sha256_text(engine_policy), machine_parent: parent,
        broker_policy_digest: sha256_text(broker_policy), physical_cpu_millis: 2000, physical_memory_bytes: 536870912,
        reserved_cpu_millis: 250, reserved_memory_bytes: 134217728,
        agent_helper_template_digest: sha256_text(linux_verifier_agent_helper_template_v1()))

# Real signatures by the seeds; `approval_expires_at` is the only clock input.
pub fn linux_service_verifier_credential_v1(binding: HostLinuxServiceEnrollmentBindingV3, issuer_offset: i64,
        approver_offset: i64, approval_expires_at: i64) -> HostEnrollmentCredentialV1:
    val operation = OperationEnvelopeV2(version: 2, id: "operation_1",
        payload_digest: host_linux_service_enrollment_digest_v3(binding).unwrap(), principal: "user_1",
        project: "project_1", host_id: "worker_1", operation: "host_enroll_v1", environment_digest: "a".repeat(64),
        policy_revision: 4, revocation_epoch: 2, session_generation: 3, memory_bytes: 536870912, duration_ms: 500)
    val grant = ExecutionGrantV2(id: "grant_1", principal: "user_1", project: "project_1", host_id: "worker_1",
        operations: ["host_enroll_v1"], environment_digest: "a".repeat(64), policy_revision: 4, revocation_epoch: 2,
        expires_at: LINUX_VERIFIER_FAR_V1, maximum_memory_bytes: 536870912, maximum_duration_ms: 1000)
    val proof = linux_service_verifier_sign_v1(operation, grant, issuer_offset, approver_offset, approval_expires_at)
    HostEnrollmentCredentialV1(operation: operation, signed: proof.0, approval: proof.1)

# Real issuer grant signature and approver signature over `operation` by the seeds.
pub fn linux_service_verifier_sign_v1(operation: OperationEnvelopeV2, grant: ExecutionGrantV2, issuer_offset: i64,
        approver_offset: i64, approval_expires_at: i64) -> (DistributedSignedGrantV2, DistributedSignedApprovalV2):
    var signed = DistributedSignedGrantV2(grant: grant, issuer_id: "issuer_1", key_revision: 1, signature: [])
    signed.signature = pure_ed25519_sign_from_seed_v1(linux_verifier_seed_v1(issuer_offset),
        distributed_grant_signature_message_v2(signed).unwrap()).signature
    var approval = DistributedSignedApprovalV2(approver_id: "approver_1", key_revision: 1,
        grant_digest: sha256_text(distributed_encode_grant_v2(grant).unwrap()),
        request_digest: sha256_text(distributed_encode_operation_v2(operation).unwrap()), policy_revision: 4,
        session_generation: 3, expires_at: approval_expires_at, signature: [])
    approval.signature = pure_ed25519_sign_from_seed_v1(linux_verifier_seed_v1(approver_offset),
        distributed_approval_signature_message_v2(approval).unwrap()).signature
    (signed, approval)

# Association whose policy holds the public keys of the given seeds and whose
# credential is signed by the same seeds. Genuine installed seeds: 1 and 65.
pub fn linux_service_verifier_fixture_with_v1(issuer_offset: i64, approver_offset: i64,
        approval_expires_at: i64, parent: text = "/var/lib/simple/hosts") -> LinuxServiceVerifierFixtureV1:
    linux_service_verifier_fixture_ops_v1(issuer_offset, approver_offset, approval_expires_at, parent, ["host_enroll_v1"])

# Genuine association whose installed keys may also sign `operations`.
pub fn linux_service_verifier_fixture_ops_v1(issuer_offset: i64, approver_offset: i64, approval_expires_at: i64,
        parent: text, operations: [text]) -> LinuxServiceVerifierFixtureV1:
    val policy = linux_service_verifier_policy_ops_v1(issuer_offset, approver_offset, operations)
    val configuration = linux_verifier_configuration_v1()
    val engine_policy = "version: 1\nkind: linux-engine-policy-fixture\n"
    val broker_policy = linux_verifier_broker_v1()
    val binding = linux_verifier_binding_v1(policy, configuration, engine_policy, broker_policy, parent)
    LinuxServiceVerifierFixtureV1(binding: binding,
        credential: linux_service_verifier_credential_v1(binding, issuer_offset, approver_offset, approval_expires_at),
        policy: policy, configuration: configuration, engine_policy: engine_policy, broker_policy: broker_policy,
        agent_helper_template: linux_verifier_agent_helper_template_v1())

pub fn linux_service_verifier_fixture_v1() -> LinuxServiceVerifierFixtureV1:
    linux_service_verifier_fixture_with_v1(1, 65, LINUX_VERIFIER_FAR_V1)

# Genuine association whose machine parent is `parent` (for owner entry specs).
pub fn linux_service_verifier_fixture_at_v1(parent: text) -> LinuxServiceVerifierFixtureV1:
    linux_service_verifier_fixture_with_v1(1, 65, LINUX_VERIFIER_FAR_V1, parent)
