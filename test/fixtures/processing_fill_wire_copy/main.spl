"""Native ABI smoke for fused FillU32 validation and wire copy."""

use std.nogc_sync_mut.ptr.raw.{
    raw_alloc, raw_free, raw_read_i32, raw_write_fill_u32s_checksum
}

fn main() -> i64:
    val value = 0x01020304u32
    val ptr = raw_alloc(16)
    if ptr == 0:
        print("PROCESSING_FILL_WIRE_COPY status=fail reason=allocation\n")
        return 1

    val exact = raw_write_fill_u32s_checksum(
        ptr, [value, value, value], 3, value)
    val exact_readback = (
        raw_read_i32(ptr, 0).to_u32() == value and
        raw_read_i32(ptr, 4).to_u32() == value and
        raw_read_i32(ptr, 8).to_u32() == value)
    val mismatch = raw_write_fill_u32s_checksum(
        ptr, [value, 7u32, value], 3, value)
    val extra = raw_write_fill_u32s_checksum(
        ptr, [value, value, value, value], 3, value)
    raw_free(ptr, 16)

    val valid = (
        exact == 50727180 and exact_readback and mismatch == -1 and extra == 0)
    val status = if valid: "pass" else: "fail"
    print("PROCESSING_FILL_WIRE_COPY status={status} exact_checksum={exact} exact_readback={exact_readback} mismatch={mismatch} extra={extra}\n")
    if valid: 0 else: 1
