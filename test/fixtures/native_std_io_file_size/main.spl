use std.io.{file_write, file_size, file_delete}

fn main():
    val path = "/tmp/simple_std_io_file_size_contract.txt"
    if not file_write(path, "abcde"):
        print("file write failed")
        return
    val size = file_size(path)
    file_delete(path)
    print("std.io file size resolved: {size}")
