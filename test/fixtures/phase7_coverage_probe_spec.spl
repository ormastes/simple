use std.spec.*

fn phase7_branch_probe(enabled: bool) -> i64:
    if enabled: 7 else: 11

describe "Phase 7 production coverage probe":
    it "executes a real branch through the production test runner":
        expect(phase7_branch_probe(true)).to_equal(7)
        expect(phase7_branch_probe(false)).to_equal(11)
