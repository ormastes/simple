# Shared HIR builders for the post-mono invariant fixture corpus.
# Consumed by scripts/check/check-post-mono-invariants.shs via
# `bin/simple run test/fixtures/mono/post_mono/<fixture>.spl`.

use compiler.hir.hir.*
use compiler.common.diagnostics.span.{Span}
use compiler.verify.post_mono_verify.*

fn fx_span() -> Span:
    Span.empty()

fn fx_type(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: fx_span())

fn fx_expr(kind: HirExprKind) -> HirExpr:
    HirExpr(kind: kind, has_type_: false, type_: nil, span: fx_span())

fn fx_typed_expr(kind: HirExprKind, ty: HirType) -> HirExpr:
    HirExpr(kind: kind, has_type_: true, type_: ty, span: fx_span())

fn fx_block(stmts: [HirStmt], value: HirExpr) -> HirBlock:
    HirBlock(stmts: stmts, has: true, value: value, span: fx_span())

fn fx_i64() -> HirType:
    fx_type(HirTypeKind.Int(64, true))

fn fx_tparam_type() -> HirType:
    fx_type(HirTypeKind.TypeParam("T", []))

fn fx_tparam() -> HirTypeParam:
    HirTypeParam(symbol: SymbolId(id: 900), name: "T", bounds: [],
                 has_default: false, default: nil, span: fx_span())

fn fx_param(id: i64, name: text, ty: HirType) -> HirParam:
    HirParam(symbol: SymbolId(id: id), name: name, type_: ty,
             has_default: false, default: nil, span: fx_span(), is_mutable: false)

fn fx_fn(id: i64, name: text, type_params: [HirTypeParam], params: [HirParam], ret: HirType, body: HirBlock) -> HirFunction:
    HirFunction(
        symbol: SymbolId(id: id),
        name: name,
        type_params: type_params,
        params: params,
        return_type: ret,
        body: body,
        effects: [],
        visibility: Visibility.Public,
        is_async: false,
        is_static: false,
        is_public: true,
        is_method: false,
        is_mutable: false,
        is_const: false,
        is_extern: false,
        func_attr: FunctionAttr.default(),
        has_export_attr: false,
        export_attr: nil,
        has_driver_manifest_attr: false,
        driver_manifest_attr: nil,
        has_suspension: false,
        has_vhdl_metadata: false,
        vhdl_metadata: nil,
        has_doc_comment: false,
        doc_comment: "",
        span: fx_span(),
        is_gpu_kernel: false,
        gpu_target: "",
        gpu_backend_order: ""
    )

fn fx_module(name: text, funcs: [HirFunction]) -> HirModule:
    var functions: Dict<SymbolId, HirFunction> = {}
    for f in funcs:
        val ft: HirFunction = f
        functions[ft.symbol] = ft
    HirModule(
        name: name,
        path: "fixture/{name}.spl",
        imports: [],
        exports: [],
        domain_blocks: [],
        symbols: SymbolTable.new(),
        functions: functions,
        gpu_function_targets: {},
        gpu_function_backend_orders: {},
        classes: {},
        structs: {},
        enums: {},
        bitfields: {},
        traits: {},
        impls: [],
        constants: {},
        static_asserts: [],
        aop_advices: [],
        di_bindings: [],
        arch_rules: [],
        mock_decls: [],
        types: []
    )

fn fx_emit(r: PostMonoReport):
    """Machine-readable contract read by check-post-mono-invariants.shs."""
    var parts: [text] = []
    if r.unresolved_type_param > 0:
        parts = parts.push("unresolved_type_param={r.unresolved_type_param}")
    if r.generic_call > 0:
        parts = parts.push("generic_call={r.generic_call}")
    if r.generic_ctor > 0:
        parts = parts.push("generic_ctor={r.generic_ctor}")
    if r.generic_method > 0:
        parts = parts.push("generic_method={r.generic_method}")
    if r.generic_emitted_definition > 0:
        parts = parts.push("generic_emitted_definition={r.generic_emitted_definition}")
    if r.any_erasure > 0:
        parts = parts.push("any_erasure={r.any_erasure}")
    if r.error_from_substitution > 0:
        parts = parts.push("error_from_substitution={r.error_from_substitution}")
    if r.unknown_mangling > 0:
        parts = parts.push("unknown_mangling={r.unknown_mangling}")
    if r.unresolved_projection > 0:
        parts = parts.push("unresolved_projection={r.unresolved_projection}")
    if r.unreachable_variant > 0:
        parts = parts.push("unreachable_variant={r.unreachable_variant}")
    if parts.len() == 0:
        print "POST_MONO_COUNTERS=clean"
    else:
        print "POST_MONO_COUNTERS={parts.join(",")}"
    print "POST_MONO_TOTAL={post_mono_report_total(r)}"
