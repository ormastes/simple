# @expect: unknown_mangling=1
# `mangle_type` emitted its `unknown` fallback token into a specialized name.
use compiler.hir.hir.*
use compiler.verify.post_mono_verify.*
use post_mono_fixture_support.*

fn main():
    val f = fx_fn(7, "box_it$unknown", [], [fx_param(70, "v", fx_i64())],
                  fx_i64(), fx_block([], fx_expr(HirExprKind.NilLit)))
    fx_emit(post_mono_verify(fx_module("neg_mangle", [f])))
