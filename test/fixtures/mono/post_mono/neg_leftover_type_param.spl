# @expect: unresolved_type_param=1
# A non-generic function whose `let` annotation is still `TypeParam("T")`.
use compiler.hir.hir.*
use compiler.verify.post_mono_verify.*
use post_mono_fixture_support.*

fn main():
    val body = fx_block(
        [HirStmt(kind: HirStmtKind.Let(SymbolId(id: 41), fx_tparam_type(),
                                       fx_expr(HirExprKind.Var(SymbolId(id: 40)))),
                 span: fx_span())],
        fx_typed_expr(HirExprKind.Var(SymbolId(id: 41)), fx_i64())
    )
    fx_emit(post_mono_verify(fx_module("neg_leftover",
        [fx_fn(4, "leaky", [], [fx_param(40, "v", fx_i64())], fx_i64(), body)])))
