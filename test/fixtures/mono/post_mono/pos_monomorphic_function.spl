# @expect: clean
# A plain non-generic function: every section 9.5 counter must be zero.
use compiler.hir.hir.*
use compiler.verify.post_mono_verify.*
use post_mono_fixture_support.*

fn main():
    val body = fx_block(
        [HirStmt(kind: HirStmtKind.Let(SymbolId(id: 11), fx_i64(),
                                       fx_typed_expr(HirExprKind.IntLit(1, nil), fx_i64())),
                 span: fx_span())],
        fx_typed_expr(HirExprKind.Var(SymbolId(id: 11)), fx_i64())
    )
    val m = fx_module("pos_mono", [fx_fn(1, "add_one", [], [fx_param(10, "v", fx_i64())], fx_i64(), body)])
    fx_emit(post_mono_verify(m))
