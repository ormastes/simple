use std.db.dbfs_engine.file_meta.{InodeHintsCache}

var cache = InodeHintsCache.new(2)
cache.put("/a", 1, 1)
cache.put("/b", 2, 1)
assert cache.entries.len() == 2
val hot = cache.get("/a")
match hot:
    case Some(entry):
        assert entry.access_count == 1
    case None:
        assert cache.entries.len() == -1
cache.put("/a", 1, 2)
assert cache.entries.len() == 2
cache.put("/c", 3, 1)
assert cache.entries.len() == 2
assert cache.entries.contains_key("/a")
assert not cache.entries.contains_key("/b")
assert cache.entries.contains_key("/c")
cache.clear()
assert cache.entries.len() == 0
print "dbfs-file-meta-cache-cardinality-ok"
