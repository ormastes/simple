use std.common.window_protocol.geometry.{WindowId, WmEventType}
use std.common.window_protocol.window_protocol.{WmInputEvent}

fn main() -> i64:
    val event = WmInputEvent.text_input(WindowId(value: 42), "é한")
    if event.event_type != WmEventType.Text:
        return 1
    if event.window_id.value != 42:
        return 2
    if event.committed_text != "é한":
        return 3
    if event.key_code.code != 0:
        return 4
    0
