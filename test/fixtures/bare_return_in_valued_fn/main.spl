# Fixture: a bare `return` inside a function with a declared non-unit
# return type (bug=cranelift_bare_return_in_valued_fn_verifier_2026-11-18).
# NEGATIVE fixture: it must NOT build. Expected: fatal MIR lowering error
# `E-SFFI-016: bare `return` in non-unit function 'pick'`. Before the fix the
# cranelift backend failed its verifier ("arguments of return must match
# function signature") and the llvm backend silently returned 0.
fn pick(name: text, other: text) -> text:
    var selected = "none"
    if name == other: return
    selected = "picked"
    selected

fn main():
    print(pick("a", "b"))
    val same = pick("a", "a")
    print("done")
