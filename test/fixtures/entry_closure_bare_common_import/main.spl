# Native repro (stage3): bare `common.` import from a nested lib consumer.
# native-build --entry test/fixtures/entry_closure_bare_common_import/main.spl --entry-closure
# Expected stdout: bare-common-import ok 3
use common.text.{escape_json}

fn main():
    val s = escape_json("a")
    print("bare-common-import ok {s.len() + 2}")
