# Native verification of newly landed OPT-CATCHALL-001 and SPL-BOUND-003 lint gates
# across all owned A2UI, App Interface, Caret A2UI, and Clock A2UI source files.

use std.nogc_sync_mut.io.file_ops.{file_read}
use compiler.tools.lint.rules.option_catchall_rule.{check_option_catchall}
use compiler.tools.lint.rules.bound_import_graph.{bound_unit_import_summaries}
use compiler.semantics.lint.bound_unit_reassert.{check_bound_unit_reasserts_cross}

fn main() -> i64:
    val paths: [text] = [
        "src/lib/common/ui/a2ui/types.spl",
        "src/lib/common/ui/a2ui/catalog.spl",
        "src/lib/common/ui/a2ui/catalog_functions.spl",
        "src/lib/common/ui/a2ui/express_g4_import.spl",
        "src/lib/common/ui/a2ui/express_grammar.spl",
        "src/lib/common/ui/a2ui/screen_table.spl",
        "src/lib/common/ui/a2ui/surface_state.spl",
        "src/lib/common/ui/a2ui/wire_codec.spl",
        "src/lib/common/app_interface/contracts.spl",
        "src/lib/common/app_interface/authority.spl",
        "src/lib/common/app_interface/query_ir.spl",
        "src/lib/common/app_interface/runtime.spl",
        "src/app/llm_caret/a2ui/cs_queries.spl",
        "src/app/llm_caret/a2ui/cs_commands.spl",
        "src/app/llm_caret/a2ui/cs_app_interface.spl",
        "src/app/llm_caret/a2ui/cs_live_host.spl",
        "src/app/llm_caret/a2ui/cs_session_store.spl",
        "src/os/apps/clock/clock_a2ui.spl"
    ]
    var checked: i64 = 0
    var failed: i64 = 0
    var i = 0
    while i < paths.len():
        val p = paths[i]
        val content = file_read(p)
        if content == "":
            print "LINT_GATE_MISSING_FILE: " + p
            failed = failed + 1
        else:
            checked = checked + 1
            val catchall = check_option_catchall(content)
            if catchall.len() > 0:
                print "OPT-CATCHALL-001 finding in " + p + " count=" + catchall.len().to_string()
                failed = failed + 1
            val sums = if content.contains("use "): bound_unit_import_summaries(content, p) else: []
            val reasserts = check_bound_unit_reasserts_cross(content, p, sums)
            if reasserts.len() > 0:
                print "SPL-BOUND-003 finding in " + p + " count=" + reasserts.len().to_string()
                failed = failed + 1
        i = i + 1
    print "A2UI_LINT_GATE_CHECKED=" + checked.to_string() + " FAIL=" + failed.to_string()
    if failed > 0:
        return 1
    0
