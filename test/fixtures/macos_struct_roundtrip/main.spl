use .factory.{round_trip, result_code}
use .result.{ResultValue, make_result_value}

fn main() -> i64:
    val value = ResultValue(code: 42)
    val returned = round_trip(value)
    if result_code(returned) != 42:
        return 1
    val imported = make_result_value(-17)
    if result_code(round_trip(imported)) != -17:
        return 2
    print("struct-roundtrip-ok")
    0
