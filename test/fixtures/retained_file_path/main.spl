use std.nogc_sync_mut.io.retained_file.{retained_file_open}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_remove}
use std.nogc_sync_mut.io.dir_ops.{dir_remove}

fn main() -> i32:
    val target = secure_temp_dir(".", "retained-path-fixture-").unwrap()
    val ascii_path = "{target}/ascii"
    var ascii_output = retained_file_open(ascii_path, 1u64, true).unwrap()
    if not ascii_output.write([11u8]).unwrap(): return 1
    if not ascii_output.close(): return 2
    var ascii_input = retained_file_open(ascii_path, 1u64).unwrap()
    if ascii_input.read_exact(1).unwrap() != [11u8]: return 3
    if not ascii_input.close(): return 4

    val unicode_path = "{target}/café-🙂"
    var unicode_output = retained_file_open(unicode_path, 2u64, true).unwrap()
    if not unicode_output.write([17u8, 29u8]).unwrap(): return 5
    if not unicode_output.close(): return 6
    var unicode_input = retained_file_open(unicode_path, 2u64).unwrap()
    if unicode_input.read_exact(2).unwrap() != [17u8, 29u8]: return 7
    if not unicode_input.close(): return 8

    if retained_file_open("{target}/bad\0suffix", 1u64, true).is_ok(): return 9
    if retained_file_open("x".repeat(32761), 1u64, true).is_ok(): return 10
    if not file_remove(ascii_path): return 11
    if not file_remove(unicode_path): return 12
    if not dir_remove(target, false): return 13
    print "retained-file-path-fixture-PASS"
    0
