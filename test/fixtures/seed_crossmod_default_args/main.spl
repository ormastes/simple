# Cross-module omitted-default regression (seed native/AOT).
# Expected output: fold1=108 fold2=10113 fold3=10108 low1=112 low2=12 low3=116

use callee.{Lowering, fold}

fn main():
    print "fold1={fold(1)}"
    print "fold2={fold(1, [5])}"
    print "fold3={fold(1, [5], 2)}"
    var low = Lowering(base: 3)
    print "low1={low.lower(2)}"
    print "low2={low.lower(2, [], false)}"
    print "low3={low.lower(2, [4], true, nil)}"
