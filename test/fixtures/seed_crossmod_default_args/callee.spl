class Lowering:
    base: i64

    me lower(x: i64, providers: [i64] = [], is_entry: bool = true, syms: [i64]? = nil, thunks: [i64] = [], k: i64 = 7) -> i64:
        var total = self.base + x + k
        for p in providers:
            total = total + p
        for t in thunks:
            total = total + t
        if is_entry:
            total = total + 100
        if syms != nil:
            total = total + 1000
        total + thunks.len() * 10000

fn fold(x: i64, items: [i64] = [], k: i64 = 7, flag: bool = true) -> i64:
    var total = x + k
    for it in items:
        total = total + it
    if flag:
        total = total + 100
    total + items.len() * 10000
