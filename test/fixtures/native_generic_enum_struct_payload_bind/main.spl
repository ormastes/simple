# Red fixture for doc/08_tracking/bug/stage2_payload_bind_and_tail_option_wrap_2026-11-16.md
# (defect B). A struct payload bound out of a USER generic enum (`Box<Lid>`) is
# read through its declared slot type `T`; the field read `item.id` never
# reaches the arm result. Build with `native-build main.spl --backend=cranelift
# --entry-closure` (and --backend=llvm) from a directory outside test/.
# Expected stdout, exactly (seed interpreter agrees):
#   A 33
# Measured 2026-11-16, integ2 Stage 2 sha256 1b04422037a68ab6:
#   cranelift: A 196570417711888   (the payload pointer, not .id)
#   llvm:      A 222204877299624   (uninitialised result slot)
struct Lid:
    id: i64

enum Box<T>:
    Full(item: T)
    Empty

fn free_first(b: Box<Lid>) -> i64:
    match b:
        case Full(item): item.id
        case Empty: -1

fn main():
    print "A {free_first(Box.Full(Lid(id: 33)))}"
