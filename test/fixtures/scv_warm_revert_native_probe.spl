"""Warm source authority admits a tracked restore through Git events."""
use app.compiler_entrypoint.source_authority.{compiler_source_authority_acquire_v1}
use app.io.mod.{dir_create_all, file_write, file_read}
use app.io.file_ops.{path_absolute}
use app.io.time_ops.{time_now_unix_micros}
use std.nogc_async_mut.sosix.host_facade.{sosix_run}

fn scv_revert_git(root: text, args: [text]) -> bool:
    sosix_run("git", ["-C", root, "-c", "core.hooksPath=",
        "-c", "commit.gpgsign=false"] + args).exit_code == 0

pub fn scv_warm_revert_fixture() -> text:
    val root = path_absolute(
        "build/test-artifacts/scv-warm-revert-{time_now_unix_micros()}")
    if not dir_create_all(root + "/src"): return "mkdir"
    val path = root + "/src/main.spl"
    val committed = "fn main() -> i64: 1\n"
    val modified = "fn main() -> i64: 2\n"
    if not file_write(path, committed): return "write-committed"
    if not scv_revert_git(root, ["init", "-q"]): return "git-init"
    if not scv_revert_git(root, ["add", "src"]): return "git-add"
    if not scv_revert_git(root, ["-c", "user.name=SCV fixture",
            "-c", "user.email=fixture@example.invalid",
            "commit", "-qm", "fixture"]): return "git-commit"
    val cache = root + "/build/scv"
    val initial = compiler_source_authority_acquire_v1(root, cache, ["src"], true)
    if not initial.valid: return "initial:" + initial.reason
    if initial.recovered_cold or initial.warm_refresh_advanced:
        return "initial-refresh-flag"
    if not file_write(path, modified): return "write-modified"
    val dirty = compiler_source_authority_acquire_v1(root, cache, ["src"], false)
    if not dirty.valid: return "dirty:" + dirty.reason
    if dirty.recovered_cold or not dirty.warm_refresh_advanced:
        return "dirty-refresh-flag"
    if file_read(dirty.snapshot.snapshot_root + "/src/main.spl") != modified:
        return "dirty-snapshot"
    if not file_write(path, committed): return "restore"
    val restored = compiler_source_authority_acquire_v1(root, cache, ["src"], false)
    if not restored.valid: return "restored:" + restored.reason
    if restored.recovered_cold or not restored.warm_refresh_advanced:
        return "restored-used-cold-fallback"
    if restored.inventory_generation <= dirty.inventory_generation:
        return "stale-generation"
    if file_read(restored.snapshot.snapshot_root + "/src/main.spl") != committed:
        return "restored-bytes"
    if file_read(dirty.snapshot.snapshot_root + "/src/main.spl") != modified:
        return "changed-sealed-snapshot"
    val unchanged = compiler_source_authority_acquire_v1(root, cache, ["src"], false)
    if not unchanged.valid or unchanged.warm_refresh_advanced or
            unchanged.recovered_cold:
        return "unchanged-warm-republished"
    ""


fn main() -> i64:
    if scv_warm_revert_fixture() == "": return 0
    1
