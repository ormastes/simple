# Bounded bootstrap diagnostic for repeated captured text allocations.
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}

fn main() -> i64:
    var i = 0
    while i < 32:
        val (stdout, stderr, status) = process_run_bounded(
            "/bin/sh", ["-c", "head -c 262144 /dev/zero | tr '\\000' x"], 5000, 262144)
        if status != 0 or stdout.len() != 262144 or stderr != "":
            print "FAIL capture iteration={i} status={status} bytes={stdout.len()}"
            return 1
        i = i + 1
    print "PASS capture iterations={i} bytes_per_capture=262144"
    0
