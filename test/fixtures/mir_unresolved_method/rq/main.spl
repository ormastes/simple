class Line:
    raw: text
    trimmed: text

fn make_lines(src: text) -> [Line]:
    var out: [Line] = []
    out.push(Line(raw: src, trimmed: src))
    out

fn show_loop(lines: [Line]):
    var i = 0
    while i < lines.len():
        val c0 = lines[i]
        print(c0.raw.slice(0, 2))
        i = i + 1

fn show_call():
    val lines = make_lines("abc")
    val c1 = lines[0]
    print(c1.raw.slice(0, 2))

fn show_call_typed():
    val lines: [Line] = make_lines("abc")
    val c2 = lines[0]
    print(c2.raw.slice(0, 2))

fn main() -> i64:
    show_loop(make_lines("xyz"))
    show_call()
    show_call_typed()
    0
