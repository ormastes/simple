class Diag:
    code: text
    hint: text

impl Diag:
    fn new(code: text) -> Diag:
        Diag(code: code, hint: "")

    fn with_fix(hint: text) -> Diag:
        Diag(code: self.code, hint: hint)

class Line:
    raw: text
    trimmed: text

fn make_lines(src: text) -> [Line]:
    var out: [Line] = []
    for part in src.split("\n"):
        out.push(Line(raw: part, trimmed: part.trim()))
    out

export Diag, Line, make_lines
