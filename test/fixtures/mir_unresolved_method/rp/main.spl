use rp.model.{Diag, Line, make_lines}

fn main() -> i64:
    val d = Diag.new("S001").with_fix("do it")
    print(d.code + " " + d.hint)
    val lines = make_lines("  var abc = 0\nx")
    var i = 0
    while i < lines.len():
        val cl = lines[i]
        val t = cl.trimmed
        print(t.slice(4))
        print(cl.raw.slice(0, 2))
        i = i + 1
    0
