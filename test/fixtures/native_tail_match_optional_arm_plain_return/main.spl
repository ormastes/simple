# Stage 2 defect A oracle. Seed prints "L 11 12 13"; the Stage 2 binary from
# 8453e87c8767 printed "L 4 4 4" on cranelift and llvm (Some handle returned as Lid).
# doc/08_tracking/bug/stage2_payload_bind_and_tail_option_wrap_2026-11-16.md
struct Lid:
    id: i64

enum EK:
    IntLit(v: i64)
    Sel(n: i64)
    Nothing

class Bld:
    next: i64

    me new_temp() -> Lid:
        self.next = self.next + 1
        Lid(id: self.next)

class Low:
    builder: Bld

    me lower_sel(n: i64) -> Lid?:
        if n < 0:
            return None
        var b = self.builder
        val r = b.new_temp()
        self.builder = b
        Some(r)

    me lower_impl(k: EK) -> Lid:
        match k:
            case IntLit(v):
                var b = self.builder
                val result = b.new_temp()
                self.builder = b
                result
            case Sel(n):
                self.lower_sel(n)
            case _:
                var b = self.builder
                val r4 = b.new_temp()
                self.builder = b
                r4

fn take(l: Lid) -> i64:
    l.id

fn main():
    var lw = Low(builder: Bld(next: 10))
    val a = lw.lower_impl(EK.IntLit(1))
    val b = lw.lower_impl(EK.Sel(2))
    val c = lw.lower_impl(EK.Nothing)
    print "L {take(a)} {take(b)} {take(c)}"
