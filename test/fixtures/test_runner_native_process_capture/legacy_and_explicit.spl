use std.nogc_sync_mut.sffi.process_capture.{process_capture_bounded_native}
use std.sffi.cli_args.{cli_get_args}
@unsafe(reason: "native regression probe for existing process text ABI", capabilities: [ffi])
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn main() -> i64:
    val args = cli_get_args()
    if args.contains("--legacy"):
        val legacy = unsafe(capabilities: [ffi]): rt_process_run("/bin/sh", ["-c", "printf native-process-probe"])
        print "legacy exit={legacy.2} stdout={legacy.0}"
        return legacy.2
    val captured: (text, text, i64) = process_capture_bounded_native("/bin/sh", ["-c", "printf '%s' \"$1\"; printf '%s' diagnostic >&2; exit 7", "probe", "space ' quote 한글"], 2000, 4096)
    print "capture exit={captured.2} stdout={captured.0} stderr={captured.1}"
    if captured.2 != 7 or captured.0 != "space ' quote 한글" or captured.1 != "diagnostic":
        return 1
    print "NATIVE_PROCESS_CAPTURE_PROBE_PASS"
    0
