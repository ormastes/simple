# Native array builtins `.slice(a, b)`, `.min()`, `.max()` on narrow and
# wide integer arrays: built from a literal, and read as an annotated struct
# field off a call result (the backend_emu_adv emu_draw_shadow_rect shape).

struct RegionU32:
    pixels: [u32]

struct RegionI32:
    pixels: [i32]

struct RegionI64:
    pixels: [i64]

fn make_u32() -> RegionU32:
    RegionU32(pixels: [7u32, 3u32, 9u32, 3u32, 3u32, 3u32, 12u32])

fn make_i32() -> RegionI32:
    RegionI32(pixels: [5i32, -4i32, 8i32, 2i32, 2i32, 2i32, -9i32])

fn make_i64() -> RegionI64:
    RegionI64(pixels: [40, -11, 99, 6, 6, 6, 1000000000000])

fn check_u32():
    val lit: [u32] = [7u32, 3u32, 9u32, 3u32, 3u32, 3u32, 12u32]
    val lseg = lit.slice(1, 3)
    print("u32 lit len={lseg.len()} min={lseg.min()} max={lseg.max()} all={lit.min()}..{lit.max()}")
    val src: [u32] = make_u32().pixels
    val seg = src.slice(3, 6)
    if seg.min() == seg.max():
        print("u32 field uniform seg0={seg[0]}")
    else:
        print("u32 field mixed")
    val wide = src.slice(0, 4)
    print("u32 field wide min={wide.min()} max={wide.max()}")
    val argb: [u32] = [3u32, 0xFF000000u32, 0x00FFFFFFu32]
    print("u32 argb min={argb.min()} max={argb.max()}")

fn check_i32():
    val lit: [i32] = [5i32, -4i32, 8i32, 2i32, 2i32, 2i32, -9i32]
    val lseg = lit.slice(0, 3)
    print("i32 lit len={lseg.len()} min={lseg.min()} max={lseg.max()} all={lit.min()}..{lit.max()}")
    val src: [i32] = make_i32().pixels
    val seg = src.slice(3, 6)
    if seg.min() == seg.max():
        print("i32 field uniform seg0={seg[0]}")
    else:
        print("i32 field mixed")
    val wide = src.slice(1, 7)
    print("i32 field wide min={wide.min()} max={wide.max()}")

fn check_i64():
    val lit: [i64] = [40, -11, 99, 6, 6, 6, 1000000000000]
    val lseg = lit.slice(0, 3)
    print("i64 lit len={lseg.len()} min={lseg.min()} max={lseg.max()} all={lit.min()}..{lit.max()}")
    val src: [i64] = make_i64().pixels
    val seg = src.slice(3, 6)
    if seg.min() == seg.max():
        print("i64 field uniform seg0={seg[0]}")
    else:
        print("i64 field mixed")
    val wide = src.slice(1, 7)
    print("i64 field wide min={wide.min()} max={wide.max()}")


# Trait-typed parameter whose default method returns a class with a `[u32]`
# field: the exact backend_emu_adv shape (`mut core: RenderBackend`,
# `val src: [u32] = core.read_pixels_region(..).pixels`).
class Readback:
    pixels: [u32]
    source: text

trait PixelSource:
    me raw() -> [u32]
    me region(lo: i64, hi: i64) -> Readback:
        val all = self.raw()
        Readback(pixels: all.slice(lo, hi), source: "region")

class Canvas:
    data: [u32]

impl PixelSource for Canvas:
    me raw() -> [u32]:
        self.data

fn check_trait_region(mut core: PixelSource):
    val src: [u32] = core.region(1, 7).pixels
    val seg = src.slice(2, 5)
    if seg.min() == seg.max():
        print("trait field uniform seg0={seg[0]} len={seg.len()}")
    else:
        print("trait field mixed")
    print("trait field wide min={src.min()} max={src.max()}")

fn main():
    check_u32()
    check_i32()
    check_i64()
    var canvas = Canvas(data: [7u32, 3u32, 9u32, 3u32, 3u32, 3u32, 12u32, 1u32])
    check_trait_region(canvas)
    print("done")
