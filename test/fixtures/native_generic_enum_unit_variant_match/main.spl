# Red fixture for doc/08_tracking/bug/stage2_payload_bind_and_tail_option_wrap_2026-11-16.md
# (defect C). A unit variant of a USER generic enum (`Box.Empty`) fails the
# typed match's identity check, so the total match panics. Build with
# `native-build main.spl --backend=cranelift --entry-closure` (and llvm) from a
# directory outside test/.
# Expected stdout, exactly (seed interpreter agrees):
#   C tx
#   D <empty>
# Measured 2026-11-16, integ2 Stage 2 sha256 1b04422037a68ab6, both backends:
#   C tx, then PANIC "total enum match fell through on 'Box'" (exit 1).
enum Box<T>:
    Full(item: T)
    Empty

fn free_text(b: Box<text>) -> text:
    match b:
        case Full(item): item
        case Empty: "<empty>"

fn main():
    print "C {free_text(Box.Full(\"tx\"))}"
    val e: Box<text> = Box.Empty
    print "D {free_text(e)}"
