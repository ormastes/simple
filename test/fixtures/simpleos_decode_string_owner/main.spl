struct Path:
    raw: text

impl Path:
    fn starts_with(self, prefix: text) -> bool:
        self.raw.starts_with(prefix)

fn trim_text(value: text) -> text:
    value.trim()

fn starts_with_text(value: text, prefix: text) -> bool:
    value.starts_with(prefix)

fn parse_theme_line(content: text) -> text:
    for line in content.split("\n"):
        if line.starts_with("#"):
            continue
        val trimmed: text = trim_text(line)
        if starts_with_text(trimmed, "color:"):
            return trim_text(trimmed[6:])
    ""

fn main() -> i64:
    val parsed = parse_theme_line("# header\n color: blue \n")
    if parsed == "blue" and starts_with_text(parsed, "bl"):
        print("DECODE_OWNER_OK")
        return 0
    print("DECODE_OWNER_BAD")
    1
