struct Path:
    raw: text

impl Path:
    fn starts_with(self, prefix: text) -> bool:
        self.raw.starts_with(prefix)

fn trim_text(value: text) -> text:
    value.trim()

fn starts_with_text(value: text, prefix: text) -> bool:
    value.starts_with(prefix)

fn ends_with_text(value: text, suffix: text) -> bool:
    value.ends_with(suffix)

fn parse_theme_section(content: text, section: text, key: text) -> text:
    var current = ""
    val prefix = "{key}:"
    for line in content.split("\n"):
        val trimmed: text = trim_text(line)
        if trimmed == "" or starts_with_text(trimmed, "#"):
            continue
        if not starts_with_text(line, " ") and ends_with_text(trimmed, ":"):
            current = trimmed[0:trimmed.len() - 1]
            continue
        if current == section and starts_with_text(trimmed, prefix):
            return trim_text(trimmed[prefix.len():])
    ""

fn main() -> i64:
    val css = "other:\n  color: red\nchosen:\n  color: blue \nlast:\n  color: green\n"
    val chosen = parse_theme_section(css, "chosen", "color")
    val other = parse_theme_section(css, "other", "color")
    val missing = parse_theme_section(css, "absent", "color")
    if chosen == "blue" and other == "red" and missing == "":
        print("DECODE_OWNER_OK")
        return 0
    print("DECODE_OWNER_BAD")
    1
