use nogc_sync_mut.ui.theme_package.{default_theme_id, resolve_theme_alias, load_theme_package}

struct Path:
    raw: text

impl Path:
    fn starts_with(self, prefix: text) -> bool:
        self.raw.starts_with(prefix)

fn main() -> i64:
    val default_id = default_theme_id()
    val dark_id = resolve_theme_alias("dark")
    val missing_id = resolve_theme_alias("historical-missing-theme")
    val package = load_theme_package(dark_id)
    if default_id == "fluid_light" and dark_id == "aetheric_dark" and missing_id == "historical-missing-theme" and package.id == "aetheric_dark":
        print("DECODE_OWNER_OK")
        return 0
    print("DECODE_OWNER_BAD")
    1
