use std.nogc_sync_mut.compression.gzip.inflate.{deflate_block_parse}

fn main() -> i64:
    val stored: [u8] = [1u8, 3u8, 0u8, 252u8, 255u8, 97u8, 98u8, 99u8]
    assert(deflate_block_parse(stored, -1) == nil)
    assert(deflate_block_parse(stored, 8) == nil)
    val parsed = deflate_block_parse(stored, 0)!
    assert(parsed.block_type == 0 and parsed.is_final)
    assert(parsed.data == [97u8, 98u8, 99u8])
    assert(parsed.next_offset == 8)
    assert(deflate_block_parse([1u8, 0u8], 0) == nil)
    assert(deflate_block_parse([1u8, 1u8, 0u8, 254u8, 255u8], 0) == nil)
    assert(deflate_block_parse([1u8, 0u8, 0u8, 0u8, 0u8], 0) == nil)
    val marker = deflate_block_parse([3u8], 0)!
    assert(marker.block_type == 1 and marker.is_final)
    assert(marker.data.len() == 0 and marker.next_offset == 0)
    print "PASS native typed DEFLATE block guards"
    0
