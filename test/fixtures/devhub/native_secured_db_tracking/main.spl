# Metadata-only registration; no secured DB feature execution.
use std.env.{env_get}
use std.nogc_sync_mut.database.bug.{Bug, BugDatabase, BugSeverity, BugStatus, create_bug_database}
use std.nogc_sync_mut.database.core.{SdnRow}
use std.nogc_sync_mut.database.todo.{append_todo_preserving_legacy}
use std.nogc_sync_mut.compression.gzip.crc.{crc32_text}

fn main() -> i64:
    if crc32_text("123456789") != 3421780262: return 3
    val root = env_get("WORKAROUND_REGISTRY_ROOT")
    if root == "": return 2
    var database: BugDatabase = create_bug_database(root + "/doc/08_tracking/bug/bug_db.sdn")
    val record = Bug(
        id: "devhub_secured_db_key_session_open_failure_2026_10_27", severity: BugSeverity.P1, status: BugStatus.Open,
        title: "DevHub secured messenger DB key session fails before decode",
        description: ["Fresh secured DB ledger1 compiled successfully with pinned Phase2 but actual execution returned Err at direct key-session open before encrypted decode. Messenger database access remains an unresolved main-feature blocker; this is not an infrastructure exception."],
        file: "doc/08_tracking/bug/devhub_secured_db_key_session_open_failure_2026_10_27.md", line: 1,
        reproducible_by: "D:/dev/simple-devhub-secured-db-p2-20261027/build/devhub-completion/fresh-secured-db-ledger1-run.log",
        fix_strategy: ["Repair direct key-session open with a discriminating error regression. Then qualify secure SQLite decode and efficient snapshot paging with memory-only plaintext, unchanged encrypted inputs, cleanup and independent row oracles before claiming Messenger DB support."],
        investigation_log: ["Pinned P2 producer13d73267e690b2cdd46438315e2bfe6d4d6c0c37bcfc15591a921fc9728b270b. Ledger1 build0 run1. Memory oracle passed AES NIST, independent KDF/HMAC and SQLite rows/overflow. Execution stopped at STAGE fresh direct key-session return with FAIL fresh secured DB direct key session. Encrypted inputs and metadata stayed unchanged; no plaintext or journal secret files. Exact root cause remains unisolated; no further feature experiments authorized this session."],
        created_at: "2026-10-27", updated_at: "2026-10-27", valid: true)
    if not database.append_open_bugs_preserving_legacy([record]): return 1
    var row: SdnRow = SdnRow.empty()
    row.set("id", "377")
    row.set("keyword", "TODO")
    row.set("area", "devhub")
    row.set("priority", "P1")
    row.set("description", "Complete secured Messenger DB key-session open then secure SQLite snapshot and efficient bounded paging qualification")
    row.set("file", "doc/08_tracking/bug/devhub_secured_db_key_session_open_failure_2026_10_27.md")
    row.set("line", "1")
    row.set("issue", "devhub_secured_db_key_session_open_failure_2026_10_27")
    row.set("blocked", "Actual pinned Phase2 ledger1 key-session Err before decode; main DevHub feature remains unverified")
    row.set("status", "blocked")
    row.set("valid", "true")
    if not append_todo_preserving_legacy(root + "/doc/08_tracking/todo/todo_db.sdn", row): return 1
    print "PASS canonical BUG and TODO append registration"
    0
