# Isolate native shared-email config decoding without credentials or network.
use std.common.sdn.parser.{parse_with_issues, SdnIssue}
use std.common.sdn.value.{SdnValue}

fn main() -> i64:
    val control_entries: Dict<text, SdnValue> = {"accounts": SdnValue.empty_dict()}
    val control = SdnValue.Dict(control_entries)
    val control_accounts: SdnValue = control.get("accounts") ?? SdnValue.Null
    print "constructed_accounts_dict={control_accounts.is_dict()}"
    assert(control_accounts.is_dict())
    val source = "default_account: work\naccounts:\n  work:\n    protocol: pop3\n    email: alice@example.test\n    pop3_port: 995\n    tls: implicit\n"
    match parse_with_issues(source):
        case Err(_):
            print "FAIL native SDN parse"
            return 1
        case Ok(parsed):
            val root: SdnValue = parsed.0
            val issues: [SdnIssue] = parsed.1
            val entries: Dict<text, SdnValue> = root.as_dict() ?? {}
            val accounts: SdnValue = root.get("accounts") ?? SdnValue.Null
            print "parsed_root_dict={root.is_dict()} issues={issues.len()} root_keys={entries.len()} accounts_key={entries.has(\"accounts\")} accounts_dict={accounts.is_dict()}"
            assert(root.is_dict())
            assert(issues.len() == 0)
            assert(entries.has("accounts"))
            assert(accounts.is_dict())
    print "PASS native SDN accounts"
    0
