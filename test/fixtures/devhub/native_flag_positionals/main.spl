use app.devhub.flags.{_positional_args, _positional_args_with_booleans, _extract_flag, _remove_flags}
use app.devhub.minio_options.{minio_parse_expiry}
use app.devhub.minio_output.{minio_stat_json, minio_health_json}
use std.common.json.value.{json_value_parse_opt, json_value_field, json_value_as_text}

fn main() -> i64:
    assert(_positional_args(["--bytes", "bucket", "key"]).join("|") == "bucket|key")
    assert(_positional_args(["--no-pager", "--prefix", "logs/", "bucket"]).join("|") == "bucket")
    assert(_positional_args(["--prefix=logs/", "bucket"]).join("|") == "bucket")
    assert(_positional_args(["--", "--literal", "-file"]).join("|") == "--literal|-file")
    assert(_positional_args(["--prefix", "--bytes", "bucket"]).join("|") == "bucket")
    assert(_extract_flag(["--prefix", "--bytes"], "--prefix", "default") == "default")
    assert(_extract_flag(["--", "--prefix=literal"], "--prefix", "default") == "default")
    assert(_remove_flags(["--bytes", "bucket"], ["--bytes"]).join("|") == "bucket")
    assert(_remove_flags(["--", "--bytes", "bucket"], ["--bytes"]).join("|") == "--|--bytes|bucket")
    assert(_positional_args_with_booleans(["--json", "bucket", "key"], ["--json"]).join("|") == "bucket|key")
    assert(minio_parse_expiry("1")! == 1)
    assert(minio_parse_expiry("604800")! == 604800)
    assert(minio_parse_expiry("-60") == nil)
    assert(minio_parse_expiry("6oops0") == nil)
    assert(minio_parse_expiry("604801") == nil)
    assert(minio_parse_expiry("999999999999999999999999") == nil)
    val key = "quote\" slash\\ newline\n"
    val stat = json_value_parse_opt(minio_stat_json(key, 4, "etag\"", "now"))!
    assert(json_value_as_text(json_value_field(stat, "key"))! == key)
    assert(json_value_as_text(json_value_field(stat, "etag"))! == "etag\"")
    val health = json_value_parse_opt(minio_health_json(false, "fail\nreason", 2, "http://host/\""))!
    assert(json_value_as_text(json_value_field(health, "status"))! == "fail\nreason")
    print "PASS native boolean, valued, equals and terminator flag contracts"
    0
