# Native qualification of the existing complete SSpec owner, not a replacement runner.
use nogc_sync_mut.spec.{describe, it, before_each, after_each, step, expect, print_summary, get_exit_code, get_executed_test_count}
use std.nogc_sync_mut.io.env_ops.{env_get}

var hook_calls: i64 = 0

fn main() -> i64:
    val negative = env_get("DEVHUB_SPEC_NEGATIVE") == "1"
    describe "Native SSpec framework qualification":
        before_each():
            hook_calls = hook_calls + 1
        after_each():
            hook_calls = hook_calls + 1
        it "should execute its body and before hook":
            step("Check real assertions and hook state")
            expect(hook_calls).to_equal(1)
            expect(2 + 2).to_equal(if negative: 5 else: 4)
        it "should execute the next case and retain after-hook state":
            step("Check that the previous case did not suppress the next body")
            expect(hook_calls).to_equal(3)
    print_summary()
    if get_executed_test_count() != 2:
        return 2
    get_exit_code()
