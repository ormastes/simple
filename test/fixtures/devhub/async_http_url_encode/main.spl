# Native regression for the actual DevHub closure's async HTTP encoder.
use std.nogc_async_mut.http_client.types.{url_encode, url_encode_component}
use std.io_runtime.{exit}

fn require_encoding(actual: text, expected: text):
    if actual != expected:
        print "FAIL async HTTP URL encoding"
        exit(1)

fn main() -> i64:
    require_encoding(url_encode("a b/+?"), "a%20b%2F%2B%3F")
    require_encoding(url_encode(""), "")
    require_encoding(url_encode("Az09-_.~"), "Az09-_.~")
    require_encoding(url_encode("café한"), "caf%C3%A9%ED%95%9C")
    require_encoding(url_encode_component("✓&="), "%E2%9C%93%26%3D")
    print "PASS async HTTP encoder reserved, empty, unreserved and UTF-8 bytes"
    0
