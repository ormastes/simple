# Check the production tuple-array environment boundary without printing secrets.
use std.nogc_sync_mut.io.env_ops.{env_vars, env_get}

fn main() -> i64:
    assert(env_get("DEVHUB_ENV_PAIR_PROBE") == "non-secret-fixture")
    val snapshot = env_vars()
    assert(snapshot != nil)
    var found = false
    var entries: i64 = 0
    for (key, value) in snapshot ?? []:
        entries = entries + 1
        if key == "DEVHUB_ENV_PAIR_PROBE":
            assert(value == "non-secret-fixture")
            found = true
    print "environment entries={entries} fixture_found={found}"
    assert(found)
    0
