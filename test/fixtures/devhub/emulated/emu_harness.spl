# Spec side of the DevHub emulator: spawn emu_http_server.spl as a separate
# process, load scenario scripts, and read back what it observed.
#
# Process env holds the handle (EMU_ADDR, EMU_PID): module `var`s are unreliable
# across `it` blocks in the interpreter (.claude/skills/spipe.md landmines 2+3).

use std.io_runtime.{process_spawn_async, process_kill, process_is_running, env_set, thread_sleep, read_file_text_result, file_write, time_now_unix_micros, cwd, dir_create_all}
use std.env.{env_get}
use std.io_runtime.{host_os, getpid}
use std.io.process_ops.{process_run_bounded}
use std.common.http_curl.{curl_request_text}
use std.nogc_sync_mut.io.tcp.{TcpStream}

val FIXTURE_ROOT = "test/fixtures/devhub/emulated"
val START_TIMEOUT_MS: i64 = 90000

fn _scratch() -> text:
    val base = env_get("TEMP")
    val root = if base != "": base else: "/tmp"
    root.replace("\\", "/") + "/devhub_emu_" + env_get("EMU_TAG")


fn _seed() -> text:
    """SIMPLE_BINARY when set, otherwise the executable running this spec (same pid
    query as std test_executor_parsing), so server and client use one binary."""
    val configured = env_get("SIMPLE_BINARY")
    if configured != "":
        return configured
    if host_os() == "windows":
        val (out, _e, code) = process_run_bounded("powershell.exe", ["-NoProfile", "-NonInteractive", "-Command", "(Get-Process -Id {getpid()}).Path"], 20000, 65536)
        if code == 0:
            return out.trim()
        return ""
    val (ps_out, _pe, ps_code) = process_run_bounded("ps", ["-o", "comm=", "-p", "{getpid()}"], 2000, 65536)
    if ps_code == 0: ps_out.trim() else: ""

fn emu_script_path() -> text:
    env_get("EMU_SCRIPT")

fn emu_start(tag: text) -> text:
    """Start (or reuse) this spec's emulator and return its host:port, or "" on failure."""
    val existing = env_get("EMU_ADDR")
    if existing != "":
        return existing
    val stamp = time_now_unix_micros().to_string()
    env_set("EMU_TAG", tag + "_" + stamp)
    val dir = _scratch()
    val _m = dir_create_all(dir)
    val portfile = dir + "/port"
    env_set("EMU_SCRIPT", dir + "/script")
    env_set("EMU_LOG", dir + "/log")
    env_set("EMU_PORTFILE", portfile)
    env_set("EMU_FIXTURES", cwd() + "/" + FIXTURE_ROOT)
    val _s = file_write(dir + "/script", "GEN\t0\n")
    env_set("SIMPLE_TIMEOUT_SECONDS", "290")
    val pid = process_spawn_async(_seed(), ["run", FIXTURE_ROOT + "/emu_http_server.spl"])
    if pid <= 0:
        return ""
    env_set("EMU_PID", pid.to_string())
    val deadline = time_now_unix_micros() + START_TIMEOUT_MS * 1000
    while time_now_unix_micros() < deadline:
        match read_file_text_result(portfile):
            Ok(content):
                val addr = content.trim()
                if addr != "":
                    env_set("EMU_ADDR", addr)
                    return addr
            Err(_): pass
        if not process_is_running(pid):
            return ""
        thread_sleep(100)
    val _k = process_kill(pid)
    ""

fn emu_base() -> text:
    "http://" + env_get("EMU_ADDR")

fn emu_row(method: text, target: text, headers: text, body_assert: text, status: i64, resp_headers: text, body: text, mode: text = "-") -> text:
    """One expected request and its scripted answer; see emu_http_server.spl for the field grammar."""
    "{method}\t{target}\t{_dash(headers)}\t{_dash(body_assert)}\t{status}\t{_dash(resp_headers)}\t{_dash(body)}\t{mode}"

fn _dash(field: text) -> text:
    if field == "": "-" else: field

fn emu_load(rows: [text]) -> text:
    """Install a scenario. Returns its generation id, which emu_problems() takes."""
    val gen_id = time_now_unix_micros().to_string()
    var script = "GEN\t{gen_id}\n"
    for row in rows:
        script = script + row + "\n"
    val _ = file_write(emu_script_path(), script)
    gen_id

fn _log_lines() -> [text]:
    match read_file_text_result(env_get("EMU_LOG")):
        Ok(content): content.split("\n")
        Err(_): []

fn emu_problems(gen_id: text, expected_requests: i64) -> text:
    """Empty iff the server saw exactly `expected_requests` requests in this
    generation and every one matched. Otherwise the reasons, for the failure text."""
    var seen: i64 = 0
    var problems = ""
    for line in _log_lines():
        val fields = line.split("\t")
        if fields.len() >= 3 and fields[1] == gen_id:
            if fields[0] == "REQ":
                seen = seen + 1
            if fields[0] == "MISMATCH":
                problems = problems + line + "\n"
    if seen != expected_requests:
        problems = problems + "server saw {seen} request(s), expected {expected_requests}\n"
    problems

fn emu_request_times_ms(gen_id: text) -> [i64]:
    """Server-side receipt time of each request in a generation (epoch ms)."""
    var out: [i64] = []
    for line in _log_lines():
        val fields = line.split("\t")
        if fields.len() >= 4 and fields[0] == "REQ" and fields[1] == gen_id:
            out = out + [fields[3].to_i64()]
    out

fn emu_stop() -> bool:
    """Shut the emulator down and prove its process is gone."""
    val addr = env_get("EMU_ADDR")
    val pid_text = env_get("EMU_PID")
    if addr == "" or pid_text == "":
        return false
    val pid = pid_text.to_i64()
    val _r = curl_request_text("POST", "http://{addr}/__emu/shutdown", ["X-Emu: stop"], "")
    var waited = 0
    while process_is_running(pid) and waited < 100:
        thread_sleep(100)
        waited = waited + 1
    val stopped = not process_is_running(pid)
    if not stopped:
        val _k = process_kill(pid)
    env_set("EMU_ADDR", "")
    env_set("EMU_PID", "")
    stopped

fn emu_refused_after_stop(addr: text) -> bool:
    """True when nothing accepts on addr any more."""
    TcpStream.connect_timeout(addr, 1000).is_err()
