# Provenance of the DevHub emulator's data. No entry here was captured from a real service.
#   emulated:   shape written from knowledge of the named public documentation, with
#               synthetic values. The page itself was not fetched for that shape.
#   documented: value taken from the public documentation and verified independently.
provenance:
  captured_from_real_service: none
  values: synthetic only (example.test hosts, syn-* tokens, no real mailbox content)

groups:
  github:
    files: github/*.json
    kind: emulated
    source: https://docs.github.com/en/graphql/reference/objects#pullrequest and https://docs.github.com/en/rest/using-the-rest-api/troubleshooting-the-rest-api
    note: GraphQL wrapper fields chosen to satisfy the real gh client, which parses them in the parity spec.
  bitbucket:
    files: bitbucket/*.json
    kind: emulated
    source: https://developer.atlassian.com/cloud/bitbucket/rest/api-group-pullrequests/
    note: Search confirmed the size/page/pagelen/next/values envelope and source/destination selectors, not a full pull request object.
  jira:
    files: jira/*.json
    kind: emulated
    source: https://developer.atlassian.com/cloud/jira/platform/rest/v3/api-group-issue-search/
  confluence:
    files: confluence/*.json
    kind: emulated
    source: https://developer.atlassian.com/cloud/confluence/rest/v1/api-group-content/
  s3:
    files: s3/*
    kind: emulated
    source: https://docs.aws.amazon.com/AmazonS3/latest/API/API_ListObjectsV2.html and https://docs.aws.amazon.com/AmazonS3/latest/API/ErrorResponses.html
  graph:
    files: graph/*.json
    kind: emulated
    source: https://learn.microsoft.com/en-us/graph/api/user-list-messages and https://learn.microsoft.com/en-us/graph/errors

vectors:
  aws_sigv4_get_object:
    used_by: test/03_system/app/devhub/feature/devhub_minio_emulated_spec.spl
    kind: documented
    source: https://docs.aws.amazon.com/AmazonS3/latest/API/sig-v4-header-based-auth.html
    note: Web search could not show the page, so the signature was recalled, then proved by emu_sigv4 recomputing the same 256-bit value from scratch.
