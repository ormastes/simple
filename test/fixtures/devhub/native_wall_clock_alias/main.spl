# Native build/run companion to wall_clock_alias_spec.spl.
use std.nogc_sync_mut.sffi.time.{time_now_ms, timestamp_now}

fn main() -> i64:
    val millis = time_now_ms()
    val micros = timestamp_now()
    assert(millis > 1000000000000)
    assert(micros > 1000000000000000)
    val delta = micros / 1000 - millis
    assert(delta > -30001 and delta < 30001)
    print "PASS native wall-clock aliases"
    0
