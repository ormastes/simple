# Differential control for P2 callback lowering. Uses the complete SSpec owner.
# This does not qualify the separate nested-DSL fixture or replace its runner.
use std.spec.*
use std.io_runtime.{env_get_opt}

var hook_calls: i64 = 0

fn before_case():
    hook_calls = hook_calls + 1

fn after_case():
    hook_calls = hook_calls + 1

fn first_case():
    step("Verify the complete framework executes the before hook and matcher")
    expect(hook_calls).to_equal(1)
    val expected = if (env_get_opt("DEVHUB_SPEC_NEGATIVE") ?? "") == "1": 5 else: 4
    expect(2 + 2).to_equal(expected)
    expect("same" + "-text").to_equal("same-text")
    val bytes: [u8] = [0u8, 128u8, 255u8]
    expect(bytes).to_equal([0u8, 128u8, 255u8])

fn second_case():
    step("Verify the after hook ran and the next body is executed")
    if (env_get_opt("DEVHUB_SPEC_BARE_NEGATIVE") ?? "") == "1":
        expect(false)
    else:
        expect(true)
    expect(hook_calls).to_equal(3)

fn suite_cases():
    before_each(before_case)
    after_each(after_case)
    it("executes a named callback with real assertions", first_case)
    it("executes the following callback and hooks", second_case)

fn main() -> i64:
    describe("P2 full SSpec callback control", suite_cases)
    print_summary()
    if get_executed_test_count() != 2:
        return 2
    if get_expectation_count() != 6:
        return 3
    get_exit_code()
