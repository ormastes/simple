fn payload(fail: bool) -> Result<(u64, [u8]), text>:
    if fail: return Err("expected-error")
    val octets: [u8] = [0u8, 127u8, 128u8, 255u8]
    Ok((18446744073709551615u64, octets))

fn check_payload(fail: bool) -> Result<i64, text>:
    val result = payload(fail)?
    assert(result.0 == 18446744073709551615u64)
    val octets = result.1
    assert(octets.len() == 4)
    assert(octets[0] == 0u8 and octets[1] == 127u8)
    assert(octets[2] == 128u8 and octets[3] == 255u8)
    Ok(4)

fn main() -> i64:
    match check_payload(false):
        case Ok(count): assert(count == 4)
        case Err(_): assert(false)
    match check_payload(true):
        case Ok(_): assert(false)
        case Err(message): assert(message == "expected-error")
    print "PASS native unsigned Result tuple"
    0
