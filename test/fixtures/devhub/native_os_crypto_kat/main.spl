fn main() -> i64:
    var bad = 0
    val empty: [u8] = []

    # AES-128-GCM TC1: empty PT + empty AAD (NIST SP 800-38D B.1)
    bad = bad + check("aes128gcm tc1 encrypt", hex_u8(aes128_gcm_encrypt(_a128_zero_key(), _zero_nonce(), empty, empty), 16), "58e2fccefa7e3061367f1d57a4e7455a")

    # AES-128-GCM TC2: 16-byte zero PT (NIST SP 800-38D B.2) — failed natively pre-fix
    val tc2_out = aes128_gcm_encrypt(_a128_zero_key(), _zero_nonce(), _tc2_pt(), empty)
    bad = bad + check("aes128gcm tc2 encrypt", hex_u8(tc2_out, 32), "0388dace60b6a392f328c2b971b2fe78ab6e47d42cec13bdf53a67b21257bddf")
    match aes128_gcm_decrypt(_a128_zero_key(), _zero_nonce(), _tc2_ct(), empty, _tc2_tag()):
        case Aes128GcmResult.Ok(data):
            bad = bad + check("aes128gcm tc2 decrypt", hex_u8(data, 16), "00000000000000000000000000000000")
        case Aes128GcmResult.Err(msg):
            print "FAIL aes128gcm tc2 decrypt rejected: {msg}"
            bad = bad + 1
    match aes128_gcm_decrypt(_a128_zero_key(), _zero_nonce(), _tc2_ct(), empty, corrupt_last(_tc2_tag())):
        case Aes128GcmResult.Ok(data):
            print "FAIL aes128gcm tc2 corrupt tag accepted"
            bad = bad + 1
        case Aes128GcmResult.Err(msg):
            print "PASS aes128gcm tc2 corrupt tag rejected"

    # AES-128-GCM TC3: 64-byte PT (NIST SP 800-38D B.3)
    val tc3_out = aes128_gcm_encrypt(_tc3_key(), _tc3_nonce(), _tc3_pt(), empty)
    bad = bad + check("aes128gcm tc3 encrypt", hex_u8(tc3_out, 80), "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091473f59854d5c2af327cd64a62cf35abd2ba6fab4")
    match aes128_gcm_decrypt(_tc3_key(), _tc3_nonce(), _tc3_ct(), empty, _tc3_tag()):
        case Aes128GcmResult.Ok(data):
            bad = bad + check("aes128gcm tc3 decrypt", hex_u8(data, 64), "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255")
        case Aes128GcmResult.Err(msg):
            print "FAIL aes128gcm tc3 decrypt rejected: {msg}"
            bad = bad + 1

    # AES-128-GCM TC4: 60-byte PT + 20-byte AAD (NIST SP 800-38D B.4) — failed natively pre-fix
    val tc4_out = aes128_gcm_encrypt(_tc3_key(), _tc3_nonce(), _tc4_pt(), _tc4_aad())
    bad = bad + check("aes128gcm tc4 encrypt", hex_u8(tc4_out, 76), "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e0915bc94fbc3221a5db94fae95ae7121a47")
    match aes128_gcm_decrypt(_tc3_key(), _tc3_nonce(), _tc4_ct(), _tc4_aad(), _tc4_tag()):
        case Aes128GcmResult.Ok(data):
            bad = bad + check("aes128gcm tc4 decrypt", hex_u8(data, 60), "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39")
        case Aes128GcmResult.Err(msg):
            print "FAIL aes128gcm tc4 decrypt rejected: {msg}"
            bad = bad + 1

    # AES-256-GCM TC13: empty PT + empty AAD (NIST SP 800-38D B.13)
    bad = bad + check("aes256gcm tc13 encrypt", hex_u8(aes256_gcm_encrypt(_a256_zero_key(), _zero_nonce(), empty, empty), 16), "530f8afbc74536b9a963b4f1c4cb738b")

    # AES-256-GCM TC14: 16-byte zero PT (NIST SP 800-38D B.14) — did not link natively pre-fix
    val tc14_out = aes256_gcm_encrypt(_a256_zero_key(), _zero_nonce(), _tc2_pt(), empty)
    bad = bad + check("aes256gcm tc14 encrypt", hex_u8(tc14_out, 32), "cea7403d4d606b6e074ec5d3baf39d18d0d1c8a799996bf0265b98b5d48ab919")
    match aes256_gcm_decrypt(_a256_zero_key(), _zero_nonce(), _tc14_ct(), empty, _tc14_tag()):
        case Aes256GcmResult.Ok(data):
            bad = bad + check("aes256gcm tc14 decrypt", hex_u8(data, 16), "00000000000000000000000000000000")
        case Aes256GcmResult.Err(msg):
            print "FAIL aes256gcm tc14 decrypt rejected: {msg}"
            bad = bad + 1
    match aes256_gcm_decrypt(_a256_zero_key(), _zero_nonce(), _tc14_ct(), empty, corrupt_last(_tc14_tag())):
        case Aes256GcmResult.Ok(data):
            print "FAIL aes256gcm tc14 corrupt tag accepted"
            bad = bad + 1
        case Aes256GcmResult.Err(msg):
            print "PASS aes256gcm tc14 corrupt tag rejected"

    # AES-256-GCM TC15: 64-byte PT (NIST SP 800-38D B.15)
    val tc15_out = aes256_gcm_encrypt(_tc15_key(), _tc3_nonce(), _tc3_pt(), empty)
    bad = bad + check("aes256gcm tc15 encrypt", hex_u8(tc15_out, 80), "522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f662898015adb094dac5d93471bdec1a502270e3cc6c")
    match aes256_gcm_decrypt(_tc15_key(), _tc3_nonce(), _tc15_ct(), empty, _tc15_tag()):
        case Aes256GcmResult.Ok(data):
            bad = bad + check("aes256gcm tc15 decrypt", hex_u8(data, 64), "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255")
        case Aes256GcmResult.Err(msg):
            print "FAIL aes256gcm tc15 decrypt rejected: {msg}"
            bad = bad + 1

    # AES-256-GCM TC16: 60-byte PT + 20-byte AAD (NIST SP 800-38D B.16)
    val tc16_out = aes256_gcm_encrypt(_tc15_key(), _tc3_nonce(), _tc4_pt(), _tc4_aad())
    bad = bad + check("aes256gcm tc16 encrypt", hex_u8(tc16_out, 76), "522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f66276fc6ece0f4e1768cddf8853bb2d551b")
    match aes256_gcm_decrypt(_tc15_key(), _tc3_nonce(), _tc16_ct(), _tc4_aad(), _tc16_tag()):
        case Aes256GcmResult.Ok(data):
            bad = bad + check("aes256gcm tc16 decrypt", hex_u8(data, 60), "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39")
        case Aes256GcmResult.Err(msg):
            print "FAIL aes256gcm tc16 decrypt rejected: {msg}"
            bad = bad + 1

    # X25519 RFC 7748 section 5.2 TV1 — returned all zeros natively pre-fix
    bad = bad + check("x25519 tv1", hex_u8(x25519(_tv1_scalar(), _tv1_u()), 32), "c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552")

    # X25519 RFC 7748 section 5.2 TV2 — returned all zeros natively pre-fix
    bad = bad + check("x25519 tv2", hex_u8(x25519(_tv2_scalar(), _tv2_u()), 32), "95cbde9476e8907d7aade45cb4b873f88b595a68799fa152e6f8f7647aac7957")

    # X25519 RFC 7748 section 6.1: Alice public key from base point
    bad = bad + check("x25519 alice public", hex_u8(x25519_base(_alice_priv()), 32), "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a")

    # X25519 RFC 7748 section 6.1: ECDH shared secret
    bad = bad + check("x25519 ecdh shared", hex_u8(x25519(_alice_priv(), _bob_pub()), 32), "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742")

    print "KAT FAILURES {bad}"
    if bad > 0:
        exit(1)
    0
