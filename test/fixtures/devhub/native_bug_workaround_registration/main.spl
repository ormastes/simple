# Canonical BugDatabase API registration utility. Run against a copied root first.
use std.env.{env_get}
use std.nogc_sync_mut.database.bug.{Bug, BugDatabase, BugSeverity, BugStatus, create_bug_database}
use std.nogc_async_mut.database.bug.{BugDatabase as SnapshotBugDatabase}
use app.bug.workaround_store.{workaround_bug_snapshot}
use std.nogc_sync_mut.compression.gzip.crc.{crc32_calculate, crc32_text, crc32_update, crc32_finalize}
use std.common.text_bytes.{text_to_utf8_bytes}

fn main() -> i64:
    if crc32_text("") != 0: return 3
    if crc32_text("123456789") != 3421780262: return 3
    if crc32_calculate(text_to_utf8_bytes("123456789")) != 3421780262: return 3
    val first: i64 = crc32_update(4294967295, text_to_utf8_bytes("abc"))
    if first != 3403398717: return 3
    val second: i64 = crc32_update(first, text_to_utf8_bytes("def"))
    if second != 3027355152 or crc32_finalize(second) != 1267612143: return 3
    print "PASS actual unsigned CRC32 KAT, empty input and chunked high-bit register"
    val root = env_get("WORKAROUND_REGISTRY_ROOT")
    if root == "": return 2
    var database: BugDatabase = create_bug_database(root + "/doc/08_tracking/bug/bug_db.sdn")
    var records: [Bug] = []
    records.push(Bug(
        id: "phase2_octal_permission_mode_lowering_2026_10_27", severity: BugSeverity.P1, status: BugStatus.Open,
        title: "Pinned Phase 2 lowers octal permission modes incorrectly", description: ["Pinned P2 octal-mode source produced read-only final and staging files. The staging file contained the correct replacement token and expiry, so this failure was not a cache parser failure. Decimal 384 is exactly mode0600 and decimal448 is mode0700."],
        file: "src/lib/common/oauth_token_cache.spl", line: 1, reproducible_by: "test/fixtures/devhub/native_outlook_token_cache/main.spl",
        fix_strategy: ["Remove the source workaround only after the deployed producer proves octal and decimal OS modes identical in actual create, replace and permission checks; require credential and OAuth cache regressions. Do not close this underlying compiler bug from workaround success."],
        investigation_log: ["Producer P2 SHA256 13d73267e690b2cdd46438315e2bfe6d4d6c0c37bcfc15591a921fc9728b270b. Cache unchanged regression compiled and ran exit0 after decimal-mode workaround; artifact e285b95b2f4250817eec5555aee4d67fea0f1f299d2d3d3568381ae8f9b044fd. Earlier actual filesystem inspection observed both files readonly. The exact compiler lowering cause is not yet isolated. Workaround commit pending integration; underlying bug remains open."],
        created_at: "2026-10-27", updated_at: "2026-10-27", valid: true))
    records.push(Bug(
        id: "phase2_u8_accelerated_sha256_ffi_carrier_2026_10_27", severity: BugSeverity.P1, status: BugStatus.Open,
        title: "Pinned Phase 2 byte carrier is rejected by accelerated SHA256 FFI", description: ["Native binary upload failed with an invalid array handle before any loopback request. The accelerated u8 SHA256 boundary is incompatible with this producer. The workaround copies octets by index into the established i64 SHA256 engine without changing the public byte contract."],
        file: "src/app/devhub/adapter_minio.spl", line: 1, reproducible_by: "test/fixtures/devhub/native_minio_binary_put/main.spl",
        fix_strategy: ["Retire after this deployed producer and linked crypto provider pass exact octets 0,128,255 plus empty, Unicode byte sequences and independent SHA256 goldens through the accelerated ABI. Keep the byte-exact upload and SigV4 oracle."],
        investigation_log: ["Producer P2 SHA256 13d73267e690b2cdd46438315e2bfe6d4d6c0c37bcfc15591a921fc9728b270b. Initial native compile0 run1 artifact3adb13de091efe809b6a571ced270f697ee30de9d36d33939692a758dcbaaa8d; independent server observed zero requests. Final typed-carrier transport qualification is recorded in the parent verification report and is not assumed here. Workaround commit pending integration; underlying bug remains open."],
        created_at: "2026-10-27", updated_at: "2026-10-27", valid: true))
    records.push(Bug(
        id: "windows_core_http_client_unavailable_2026_10_27", severity: BugSeverity.P1, status: BugStatus.Open,
        title: "Windows core runtime native HTTP client provider is unavailable", description: ["The Windows core native HTTP branch explicitly returns unavailable. A shared real curl compatibility transport uses bounded execution, private mode384 header/body/response files, no redirects and no TLS bypass; request secrets are absent from argv. Applications retain configured public std interfaces."],
        file: "src/runtime/runtime_native.c", line: 1, reproducible_by: "test/fixtures/devhub/native_http_curl/main.spl",
        fix_strategy: ["Retire only after the selected Windows native provider supports text and exact binary bodies, status and errors, size and time bounds, redirects/TLS policy, secret handling and independent HTTP/SigV4 acceptance with the deployed compiler. An installed curl workaround does not close the missing provider bug."],
        investigation_log: ["Producer P2 SHA256 13d73267e690b2cdd46438315e2bfe6d4d6c0c37bcfc15591a921fc9728b270b. Source-confirmed Windows provider gap. Actual curl8.21.0 exists on the qualification host. HTTP text and signed binary loopback acceptance remains separately bound to the parent qualification artifacts; source review alone is not runtime PASS. Workaround commit pending integration; underlying bug remains open."],
        created_at: "2026-10-27", updated_at: "2026-10-27", valid: true))
    records.push(Bug(
        id: "phase2_result_tuple_try_binding_metadata_2026_10_27", severity: BugSeverity.P1, status: BugStatus.Open,
        title: "Pinned Phase 2 loses integer and byte tuple metadata across Result propagation", description: ["Explicit typed Ok and Err bindings preserve u64 and byte-array tuple payload metadata where native Result propagation did not. Related compiler Result tuple repairs are in source, but the pinned producer has not been rebuilt and the compatibility bindings remain."],
        file: "src/lib/nogc_sync_mut/database/sqlite_format/cell.spl", line: 1, reproducible_by: "test/fixtures/devhub/native_result_unsigned_tuple/main.spl",
        fix_strategy: ["Retire after the actual deployed producer passes try-propagated u64 maxima and byte arrays plus the full SQLite parser and production Messenger read/wrong-key/tamper regressions. Keep the underlying bug open until then."],
        investigation_log: ["Producer P2 SHA256 13d73267e690b2cdd46438315e2bfe6d4d6c0c37bcfc15591a921fc9728b270b. Earlier Messenger compilation admitted all169 MIR modules after explicit SQLite tuple bindings. Supplemental unsigned varint and truncation checks passed. Production Messenger adapter RTS01 remains unresolved; this workaround is not proof that the database read works. Workaround commit pending integration; underlying bug remains open."],
        created_at: "2026-10-27", updated_at: "2026-10-27", valid: true))
    records.push(Bug(
        id: "phase2_bounded_process_text_abi_2026_10_27", severity: BugSeverity.P1, status: BugStatus.Open,
        title: "Pinned Phase 2 bounded process call loses command text ABI", description: ["The actual HTTP compatibility probe returned missing command although curl8.21.0 was installed. The existing bounded tuple runtime provider accepts explicit command pointer and UTF8 length; a source adapter can preserve that ABI without changing the compiler or provider."],
        file: "src/lib/nogc_sync_mut/sffi/process_capture.spl", line: 1, reproducible_by: "test/fixtures/devhub/native_http_curl/main.spl",
        fix_strategy: ["Remove the source adapter only after the deployed producer correctly marshals command text, argv, deadline and output bound to the normal bounded process ABI and passes real quoted-argument, Unicode, timeout, output-limit and HTTP transport regressions."],
        investigation_log: ["Producer P2 SHA256 13d73267e690b2cdd46438315e2bfe6d4d6c0c37bcfc15591a921fc9728b270b. Frozen-source HTTP and binary probes compiled but returned missing command before any localhost request. The exact tuple-provider source adapter and final actual loopback evidence are owned by the provider lane; no success is inferred by this record. Workaround commit pending integration; underlying bug remains open."],
        created_at: "2026-10-27", updated_at: "2026-10-27", valid: true))
    records.push(Bug(
        id: "phase2_module_static_array_concat_initialization_2026_10_27", severity: BugSeverity.P1, status: BugStatus.Open,
        title: "Pinned Phase 2 cannot initialize DevHub module static arrays by concatenation", description: ["The compatibility flag catalogs retain literal typed arrays instead of executing array concatenation while initializing module statics. Their public values remain unchanged. This is narrower than ordinary function-local array concatenation, which remains supported by other focused checks."],
        file: "src/app/devhub/gh_compat.spl", line: 1, reproducible_by: "test/01_unit/app/devhub/gh_compat_spec.spl",
        fix_strategy: ["Retire only after actual module-static concatenation preserves every flag value and method/type metadata under the deployed producer, with native command flag regressions and no startup evaluation error."],
        investigation_log: ["Producer P2 SHA256 13d73267e690b2cdd46438315e2bfe6d4d6c0c37bcfc15591a921fc9728b270b. The retained literal tables were part of the earlier DevHub P2 source repair. Current GH JSON and flag native graphs compile and run successfully, but this is not a new independent replay of the original static-initializer failure. Related older registry issue native_array_concat_dispatch_bootstrap_2026_10_16 remains separate. Workaround commit pending integration; underlying bug remains open."],
        created_at: "2026-10-27", updated_at: "2026-10-27", valid: true))
    records.push(Bug(
        id: "bug_database_roundtrip_drops_overwide_legacy_rows_2026_10_27", severity: BugSeverity.P1, status: BugStatus.Open,
        title: "Bug database full save truncates opaque legacy row payloads", description: ["The canonical registry contains legacy rows with more fields than their declared table schema. The generic table parser and full save do not preserve every overwide legacy row payload, so a complete BugDatabase.save round trip can discard untouched records or fields. The domain append-only API serializes only new records and preserves the complete original body byte for byte apart from inserted canonical rows."],
        file: "src/lib/nogc_sync_mut/database/bug.spl", line: 1, reproducible_by: "test/fixtures/devhub/native_bug_workaround_registration/main.spl",
        fix_strategy: ["Retire the legacy append compatibility path only after all legacy rows are repaired by their owners or the canonical serializer losslessly retains opaque fields, and a complete scratch round trip preserves every original payload byte and record. Never normalize or truncate records merely to enable registration."],
        investigation_log: ["Producer P2 SHA256 13d73267e690b2cdd46438315e2bfe6d4d6c0c37bcfc15591a921fc9728b270b. Read-only baseline audit found eleven versus ten fields at lines2452,2453,2463 and additional overwide rows. No real registry write or generic regeneration was performed. Append-only native copy qualification and independent byte preservation must pass before actual registration. Workaround commit pending integration; underlying bug remains open."],
        created_at: "2026-10-27", updated_at: "2026-10-27", valid: true))
    records.push(Bug(
        id: "phase2_crc32_i64_width_spill_2026_10_27", severity: BugSeverity.P1, status: BugStatus.Open,
        title: "Pinned Phase 2 CRC32 i64 boundary retains unexpected high bits", description: ["A native append-only registry copy preserved all original payload bytes but wrote CRC header -2292158518 while independent unsigned zlib computed2002808778. The values differ by2^32. This proves a CRC width or ABI boundary discrepancy; the exact widening or complement cause is not isolated. Masking public i64 CRC outputs to their low32bits preserves the actual CRC register contract."],
        file: "src/lib/nogc_sync_mut/compression/gzip/crc.spl", line: 1, reproducible_by: "test/fixtures/devhub/native_bug_workaround_registration/main.spl",
        fix_strategy: ["Retire the explicit width normalization only after the deployed producer passes text123456789 CRC3421780262, empty input, chunked update through high-bit-set states and independent unsigned zlib comparisons for real registry bodies. Never accept negative header CRC or relax the external oracle."],
        investigation_log: ["Producer P2 SHA256 13d73267e690b2cdd46438315e2bfe6d4d6c0c37bcfc15591a921fc9728b270b. Cycle3 canonical API compile0 and copy-run0 were not passing evidence because the independent strict CRC oracle failed. Exact old-body preservation passed after removing only28newrowlines, including all5265oldrows and20opaqueoverwide rows. Real canonical registry remained untouched. New actual KAT and copy qualification are required before registration. Workaround commit pending integration; underlying bug remains open."],
        created_at: "2026-10-27", updated_at: "2026-10-27", valid: true))
    if not database.append_open_bugs_preserving_legacy(records):
        print "canonical append-only BugDatabase API refused registration"
        return 1
    val checked: SnapshotBugDatabase = match workaround_bug_snapshot(root):
        case Ok(value): value
        case Err(error):
            print "saved registry validation refused: {error}"
            return 1
    if checked.get_bug("phase2_octal_permission_mode_lowering_2026_10_27") == nil: return 1
    if checked.get_bug("phase2_u8_accelerated_sha256_ffi_carrier_2026_10_27") == nil: return 1
    if checked.get_bug("windows_core_http_client_unavailable_2026_10_27") == nil: return 1
    if checked.get_bug("phase2_result_tuple_try_binding_metadata_2026_10_27") == nil: return 1
    if checked.get_bug("phase2_bounded_process_text_abi_2026_10_27") == nil: return 1
    if checked.get_bug("phase2_module_static_array_concat_initialization_2026_10_27") == nil: return 1
    if checked.get_bug("bug_database_roundtrip_drops_overwide_legacy_rows_2026_10_27") == nil: return 1
    if checked.get_bug("phase2_crc32_i64_width_spill_2026_10_27") == nil: return 1
    print "canonical append-only BugDatabase API registration completed"
    0
