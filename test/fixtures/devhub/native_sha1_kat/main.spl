# Published known-answer vectors for SHA-1, HMAC-SHA-1 and PBKDF2-HMAC-SHA-1, as a
# program so the compiled engines (`simple run` JIT and `native-build`) are checked,
# not only the interpreter the spec runner uses.
# Vectors: FIPS 180-4 "abc" and the 448-bit message, RFC 2202 case 2, RFC 6070 1, 2, 3, 5, 6.
# Bug: doc/08_tracking/bug/jit_corrupts_i64_array_returned_from_sha1_bytes_2026-08-04.md
use std.io_runtime.{exit}
use std.common.crypto.sha1.{sha1_bytes}
use std.common.crypto.hmac.{hmac_sha1_bytes}
use std.common.crypto.pbkdf2.{pbkdf2_sha1_bytes}
use std.common.crypto.types.{bytes_to_hex}
use std.common.text_bytes.{text_to_utf8_bytes}

fn ascii(value: text) -> [i64]:
    var out: [i64] = []
    for b in text_to_utf8_bytes(value):
        out.push(b.to_i64())
    out

fn check(name: text, got: text, want: text) -> i64:
    if got == want:
        print "PASS {name}"
        return 0
    print "FAIL {name} got={got} want={want}"
    1

fn main() -> i64:
    var bad = 0
    bad = bad + check("sha1 abc", bytes_to_hex(sha1_bytes(ascii("abc"))), "a9993e364706816aba3e25717850c26c9cd0d89d")
    bad = bad + check("sha1 448-bit", bytes_to_hex(sha1_bytes(ascii("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))), "84983e441c3bd26ebaae4aa1f95129e5e54670f1")
    bad = bad + check("hmac-sha1 rfc2202-2", bytes_to_hex(hmac_sha1_bytes(ascii("Jefe"), ascii("what do ya want for nothing?"))), "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")
    bad = bad + check("pbkdf2-sha1 rfc6070-1", bytes_to_hex(pbkdf2_sha1_bytes(ascii("password"), ascii("salt"), 1, 20)), "0c60c80f961f0e71f3a9b524af6012062fe037a6")
    bad = bad + check("pbkdf2-sha1 rfc6070-2", bytes_to_hex(pbkdf2_sha1_bytes(ascii("password"), ascii("salt"), 2, 20)), "ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957")
    # 4096-iteration vectors live here, not in the interpreted spec: minutes there, instant compiled.
    bad = bad + check("pbkdf2-sha1 rfc6070-3", bytes_to_hex(pbkdf2_sha1_bytes(ascii("password"), ascii("salt"), 4096, 20)), "4b007901b765489abead49d926f721d065a429c1")
    bad = bad + check("pbkdf2-sha1 rfc6070-5", bytes_to_hex(pbkdf2_sha1_bytes(ascii("passwordPASSWORDpassword"), ascii("saltSALTsaltSALTsaltSALTsaltSALTsalt"), 4096, 25)), "3d2eec4fe41c849b80c8d83662c0e44a8b291a964cf2f07038")
    bad = bad + check("pbkdf2-sha1 rfc6070-6", bytes_to_hex(pbkdf2_sha1_bytes(ascii("pass") + [0] + ascii("word"), ascii("sa") + [0] + ascii("lt"), 4096, 16)), "56fa6aa75548099dcc37d7f03425e0c3")
    print "KAT FAILURES {bad}"
    if bad > 0:
        exit(1)
    0
