use app.devhub.gh_compat.{bb_pr_to_gh_json, json_escape}
use std.common.json.value.{JsonValue, json_value_object_from, json_value_serialize, json_value_parse_opt, json_value_field, json_value_as_text}

fn main() -> i64:
    val title = "quote\" slash\\ and unicode café"
    val body = "first\nsecond\ttab"
    val original = json_value_object_from([
        ("id", JsonValue.Int(42)), ("title", JsonValue.Str(title)),
        ("description", JsonValue.Str(body)), ("state", JsonValue.Str("OPEN"))
    ])
    val converted = bb_pr_to_gh_json(json_value_serialize(original))
    val parsed = json_value_parse_opt(converted)
    assert(parsed != nil)
    assert(json_value_as_text(json_value_field(parsed!, "title"))! == title)
    assert(json_value_as_text(json_value_field(parsed!, "body"))! == body)
    assert(json_value_serialize(json_value_field(parsed!, "number")) == "42")
    assert(json_escape("\u{0001}\u{0008}\u{000c}") == "\\u0001\\b\\f")
    print "PASS native gh JSON decoded-string and control-byte roundtrip"
    0
