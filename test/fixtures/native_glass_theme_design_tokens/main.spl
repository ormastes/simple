use common.ui.glass.theme.{glass_design_tokens}

fn main() -> i64:
    val aetheric = glass_design_tokens("aetheric_dark")
    val passed = (
        aetheric.colors.surface_primary == "rgba(18,18,31,0.72)" and
        aetheric.colors.text_primary == "#E3E0F3" and
        aetheric.colors.accent == "#C6C6C8"
    )
    print("glass theme design tokens resolved: {passed}")
    if passed: 0 else: 1
