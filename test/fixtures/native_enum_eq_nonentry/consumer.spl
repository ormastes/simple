# The enum compare sits in a NON-entry module and the enum is a src/lib enum
# imported as `std.` (r13 lowered it to struct __eq__ dispatch; a test-local
# enum module does not reproduce it). See
# doc/08_tracking/bug/enum_eq_nonentry_module_struct_dispatch_native_2026-10-19.md
use std.common.rt_hal.model.{RtHalProviderKind}

pub struct LocalProv:
    kind: RtHalProviderKind
    flag: bool

pub fn prov_ok(p: LocalProv) -> bool:
    if p.kind != RtHalProviderKind.PureSimple or not p.flag:
        return false
    true

export LocalProv, prov_ok
