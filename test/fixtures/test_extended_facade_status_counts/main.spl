# Native regression fixture: import TestStatusCounts through the
# std.database.test_extended package facade (exactly as
# src/lib/nogc_sync_mut/test_runner/test_db_compat.spl does) and call a method
# whose return type is that re-exported struct. Before the facade fix the
# native Stage 2 compiler failed HIR with `unresolved type: TestStatusCounts`.
#
# app.stats.test_status is imported on purpose: it declares an UNRELATED
# `TestStatusCounts`, exactly as in the full-CLI closure. Without a second
# owner the failed facade chase is silently rescued by the unique-owner
# global-symbol fallback and the defect does not reproduce.
use std.database.test_extended.{TestDatabaseExtended, create_test_database_extended, TestStatusCounts, TestRunCount}
use app.stats.test_status.{TEST_RESULT_PATH}

fn summarize(counts: TestStatusCounts) -> text:
    "total={counts.total.value} passed={counts.passed.value} failed={counts.failed.value} skipped={counts.skipped.value}"

fn main() -> i64:
    val db: TestDatabaseExtended = create_test_database_extended("/nonexistent-test-extended-facade-fixture/test_db.sdn")
    val counts: TestStatusCounts = db.test_count_by_status()
    print(summarize(counts))
    val manual = TestStatusCounts(total: TestRunCount(value: 3), passed: TestRunCount(value: 2), failed: TestRunCount(value: 1), skipped: TestRunCount(value: 0))
    print(summarize(manual))
    print("stats source={TEST_RESULT_PATH}")
    0
