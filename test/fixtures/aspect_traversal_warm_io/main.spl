# AUTHORED / UNRUN. Actual HIR/ordinary-codec ownership and publication fixture.
# Constructors copied from canonical fixture bb7405d1ca81026fd1ea33b601deb4fd06436b41.
# This is not canonical qualification or full driver/authority evidence.
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use compiler.common.attributes.{FunctionAttr}
use compiler.types.type_layout.{layoutattr_default_}
use compiler.hir.hir_types.{HirModule, SymbolTable, HirSymbol, SymbolId, ScopeId, Scope, ScopeKind, SymbolKind, HirType, HirTypeKind}
use compiler.hir.hir_definitions.{HirConst, HirExpr, HirExprKind, HirAopAdvice,
    HirFunction, HirParam, HirStmt, HirStmtKind, HirBlock, HirField, HirStruct,
    HirClass, HirTrait, HirAssocTypeDecl}
use compiler.hir.hir_operators.{HirBinOp}
use compiler.blocks.value.{BlockValue}
use compiler.driver.cache.aop_traversal_inputs_v1.{aop_traversal_batch_capture_v1}
use compiler.driver.cache.aop_traversal_snapshot_io_v1.{aop_traversal_snapshots_match_v1,
    aop_traversal_restore_prepare_v1, aop_traversal_restore_publish_v1}
