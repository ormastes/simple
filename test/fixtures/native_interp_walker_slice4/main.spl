# Native repro for the HIR walker slice 4: a provider module passes a text
# constant imported from a third module to env_get, and value-type struct
# fields are assigned in place. Run with the native CLI:
#   cli_tip.exe run test/fixtures/native_interp_walker_slice4/main.spl
# doc/08_tracking/bug/native_cli_test_cannot_run_std_spec_2026-11-15.md
use mid.{mid_env_value, mid_name}

struct In:
    v: i64

struct Out:
    inner: In
    tag: i64

fn main() -> i64:
    print "name={mid_name()}"
    print "env=[{mid_env_value()}]"
    var o = Out(inner: In(v: 1), tag: 3)
    o.tag = 4
    o.inner.v += 29
    print "struct={o.inner.v + o.tag}"
    0
