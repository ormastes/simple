# Native oracle for tuple-keyed Dict lookups (e.g. TraitSolver's
# `Dict<(HirType, HirSymbol), bool>` cache). A native tuple is a raw rt_alloc
# element block, not a runtime tuple object; used verbatim as a dict key both
# runtimes hash it by ADDRESS, so an equal tuple built separately missed.
# Separately, the C runtime hashed runtime tuples/arrays by address while
# comparing them structurally (src/runtime/test/rt_dict_tuple_key_hash_selfcheck.c).
# Build: SIMPLE_BOOTSTRAP=1 native-build main.spl --entry-closure, run under the
# core-c-bootstrap runtime bundle AND the default Rust runtime (control).
# Expected stdout = seed INTERPRETER (`SIMPLE_EXECUTION_MODE=interpret simple run
# main.spl`). The seed JIT run prints `i nil` (struct element keyed by address).
# Array keys: array_keys.spl.
# a 12
# b true
# c false
# d 99 3
# e 2 false
# f 33
# g 7
# h true
# i 5
# j 6

struct Sid:
    id: i64

fn pair(a: i64, b: i64) -> (i64, i64):
    (a, b)

fn word(n: i64) -> text:
    "w" + n.to_text()

fn main():
    var d: Dict<(i64, i64), i64> = {}
    d[pair(1, 2)] = 12
    d[pair(2, 1)] = 21
    d[pair(1, 3)] = 13
    print "a {d[pair(1, 2)] ?? -1}"
    print "b {d.contains_key(pair(2, 1))}"
    print "c {d.contains_key(pair(3, 3))}"
    d[pair(1, 2)] = 99
    print "d {d[pair(1, 2)] ?? -1} {d.len()}"
    d.remove(pair(2, 1))
    print "e {d.len()} {d.contains_key(pair(2, 1))}"
    var sum = 0
    for k in d.keys():
        sum = sum + k.0 * 10 + k.1
    # (1, 2) -> 12, (1, 3) -> 13, plus the distinct-check offset 8
    print "f {sum + 8}"

    var t: Dict<(text, i64), i64> = {}
    t[(word(4), 2)] = 7
    print "g {t[(word(4), 2)] ?? -1}"
    print "h {t.contains_key((\"w4\", 2))}"

    var s: Dict<(Sid, i64), i64> = {}
    s[(Sid(id: 9), 1)] = 5
    print "i {s[(Sid(id: 9), 1)] ?? -1}"

    var n: Dict<((i64, i64), i64), i64> = {}
    n[(pair(1, 2), 3)] = 6
    print "j {n[(pair(1, 2), 3)] ?? -1}"

