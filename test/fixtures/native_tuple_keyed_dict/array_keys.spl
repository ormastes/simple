# Native oracle for array-keyed Dict lookups: the C-runtime half of the
# tuple-key fix, needing no compiler change. A Simple array is a registered
# runtime array on both runtimes; the C runtime compared two array keys
# STRUCTURALLY but hashed them by ADDRESS, so an equal array built separately
# missed (the Rust runtime hashes and compares by value). Selfcheck:
# src/runtime/test/rt_dict_tuple_key_hash_selfcheck.c.
# Build: SIMPLE_BOOTSTRAP=1 native-build array_keys.spl with --runtime-bundle
# core-c-bootstrap (the fix) and auto (Rust runtime, control).
# Expected stdout = seed INTERPRETER:
# a 12
# b true
# c false
# d 99 3
# e 2 false
# f 5
# g 7

fn arr(a: i64, b: i64) -> [i64]:
    [a, b]

fn main():
    var d: Dict<[i64], i64> = {}
    d[arr(1, 2)] = 12
    d[arr(2, 1)] = 21
    d[arr(1, 3)] = 13
    print "a {d[arr(1, 2)] ?? -1}"
    print "b {d.contains_key(arr(2, 1))}"
    print "c {d.contains_key(arr(3, 3))}"
    d[arr(1, 2)] = 99
    print "d {d[arr(1, 2)] ?? -1} {d.len()}"
    d.remove(arr(2, 1))
    print "e {d.len()} {d.contains_key(arr(2, 1))}"
    var lens = 0
    for k in d.keys():
        lens = lens + k.len() + k[0]
    # two [1, x] keys: (2 + 1) * 2 = 6, minus 1 so a doubled entry cannot pass
    print "f {lens - 1}"
    var t: Dict<[text], i64> = {}
    t[["w" + 4.to_text(), "x"]] = 7
    print "g {t[[\"w4\", \"x\"]] ?? -1}"
