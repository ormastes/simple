# Bug if_expression_text_result_erased_to_i64_2026-10-25: nested if-expression
# text result with a `?` arm must keep its declared text type under native codegen.
fn strict_dir() -> Result<text, text>:
    Ok("strict")

fn find() -> text:
    "found"

fn pick(strict: bool, env: bool) -> Result<text, text>:
    val d = if strict:
        (if env: strict_dir()? else: find())
    else:
        find()
    Ok("{d}/runtime_native.c")

fn main() -> i64:
    print(pick(true, true).unwrap())
    print(pick(true, false).unwrap())
    print(pick(false, true).unwrap())
    0
