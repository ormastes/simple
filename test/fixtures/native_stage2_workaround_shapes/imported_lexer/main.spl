# Bug lexer_imported_instance_methods_2026_10_06: instance methods on a struct from
# another module (typed receiver locals) must resolve under native codegen.
use lexer_mod.{MiniLexer}

fn main() -> i64:
    var lx: MiniLexer = MiniLexer.new("xyz")
    lx = lx.push_indent()
    lx = lx.push_indent()
    lx = lx.pop_indent()
    print("{lx.indent} {lx.char_at_pos()}")
    0
