struct MiniLexer:
    source: text
    pos: i64
    indent: i64

    fn new(source: text) -> MiniLexer:
        MiniLexer(source: source, pos: 0, indent: 0)

    fn push_indent() -> MiniLexer:
        MiniLexer(source: self.source, pos: self.pos, indent: self.indent + 1)

    fn pop_indent() -> MiniLexer:
        MiniLexer(source: self.source, pos: self.pos, indent: self.indent - 1)

    fn char_at_pos() -> text:
        self.source.slice(self.pos, self.pos + 1)
