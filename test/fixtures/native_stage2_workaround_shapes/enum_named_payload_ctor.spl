# Bug a174_named_enum_payload_owner_2026_10_16: named-arg enum payload constructor + positional match.
# Expected native stdout: 64:true 8:false unit
enum K:
    Int(bits: i64, signed: bool)
    Unit

fn mk(n: text) -> K:
    match n:
        case "i64": K.Int(bits: 64, signed: true)
        case "u8": K.Int(bits: 8, signed: false)
        case _: K.Unit

fn show(k: K) -> text:
    match k:
        case K.Int(bits, signed): "{bits}:{signed}"
        case K.Unit: "unit"

fn main() -> i64:
    print("{show(mk("i64"))} {show(mk("u8"))} {show(mk("x"))}")
    0
