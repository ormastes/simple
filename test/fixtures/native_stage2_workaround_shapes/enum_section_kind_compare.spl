# Bug a174_nominal_enum_operator_resolution_2026_10_16: direct `!=` on a nominal
# enum value must agree with comparing canonical names (workaround form).
enum Kind:
    debug
    exports
    types

fn kind_name(k: Kind) -> text:
    match k:
        case Kind.debug: "debug"
        case Kind.exports: "exports"
        case Kind.types: "types"

fn main() -> i64:
    val kinds = [Kind.debug, Kind.exports, Kind.types]
    var by_name = 0
    var by_op = 0
    var i = 0
    while i < 3:
        val k = kinds[i]
        if kind_name(k) != kind_name(kinds[i]):
            by_name = by_name + 1
        if k != kinds[i]:
            by_op = by_op + 1
        i = i + 1
    print("{by_name} {by_op}")
    0
