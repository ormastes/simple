# Bug a174_enum_tuple_literal_provenance_2026_10_16: tuple literal directly as enum payload (no typed temp).
# Expected native stdout: 709 709
enum W:
    Empty
    TupleOnly((i64, i64))

fn sum(w: W) -> i64:
    match w:
        case W.TupleOnly(pair): pair.0 * 100 + pair.1
        case _: -1

fn main() -> i64:
    val t: (i64, i64) = (7, 9)
    print("{sum(W.TupleOnly((7, 9)))} {sum(W.TupleOnly(t))}")
    0
