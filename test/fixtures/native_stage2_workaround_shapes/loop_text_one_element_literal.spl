# Bug one_element_literal_of_loop_text_boxed_as_int_2026-10-25: `[attr]` of a text
# loop variable (non-empty pending list at EOF) must stay a text element.
fn finish(name: text, attrs: [text]) -> text:
    name + ":" + attrs.join(",")

fn main() -> i64:
    var logical = "fn"
    var pending: [text] = []
    for tail in ["a", "b"]:
        logical = logical + tail
        pending = pending.push("@" + tail)
    var cur = pending
    pending = []
    pending = pending.push("@last")
    for attr in pending:
        print(finish(attr, [attr]))
    print(cur.len())
    0
