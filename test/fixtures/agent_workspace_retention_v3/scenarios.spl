# Native integration fixture CONSUMER, NOT_RUN. Caller must install real quota
# slots and supply genuine original source/native owners through actual Host
# gates. No token constructor, NativeObservation DATA surrogate or bare-host Git.
# These functions assert real owner behavior; this is not a configured fixture
# provisioning driver and does not claim executed native lifecycle coverage.
use std.nogc_async_mut.container.providers.linux.workspace_mount_owner_v1.*
use std.nogc_sync_mut.io.linux_fresh_workload_subject_v2.LinuxFreshWorkspaceNativeRetirementV3
use std.common.contracts.storage.linux_workspace_retention_v3.*

pub fn check_partial_creation_retains_all_v3(source: LinuxWorkspaceSourceOwnerV1) -> LinuxWorkspaceSourceOwnerV1:
    val metadata = source.creation_retained_metadata_v3().unwrap()
    assert(metadata.uncertain_creation)
    assert(metadata.parent_identity.len() == 16 and metadata.root_identity.len() == 16)
    assert(source.retained_metadata_v3().is_err())
    val closed = source.close_v1()
    assert(not closed.closed and closed.owner != nil)
    assert(linux_workspace_creation_metadata_encode_v3(closed.owner.unwrap().creation_retained_metadata_v3().unwrap()) ==
        linux_workspace_creation_metadata_encode_v3(metadata))
    closed.owner.unwrap()

pub fn check_native_retirement_and_duplicate_v3(source: LinuxWorkspaceSourceOwnerV1,
        token: LinuxFreshWorkspaceNativeRetirementV3, full_invocation: text) -> LinuxWorkspaceSourceOwnerV1:
    val copied_alias = source
    val first = source.retire_native_v3(token, full_invocation)
    assert(first.retired and first.error == "" and first.metadata != nil)
    val expected = linux_workspace_retained_metadata_encode_v3(first.metadata.unwrap())
    val duplicate = copied_alias.retire_native_v3(token, full_invocation)
    assert(duplicate.retired and duplicate.error == "")
    assert(linux_workspace_retained_metadata_encode_v3(duplicate.metadata.unwrap()) == expected)
    val closed = duplicate.owner.close_v1()
    assert(not closed.closed and closed.owner != nil)
    assert(linux_workspace_retained_metadata_encode_v3(copied_alias.retained_metadata_v3().unwrap()) == expected)
    assert(copied_alias.creation_retained_metadata_v3().is_err())
    closed.owner.unwrap()

pub fn check_wrong_or_stale_actual_token_v3(source: LinuxWorkspaceSourceOwnerV1,
        other_or_closed_token: LinuxFreshWorkspaceNativeRetirementV3, full_invocation: text) -> LinuxWorkspaceSourceOwnerV1:
    val refused = source.retire_native_v3(other_or_closed_token, full_invocation)
    assert(not refused.retired and refused.metadata == nil and refused.error != "")
    val closed = refused.owner.close_v1()
    assert(not closed.closed and closed.owner != nil)
    closed.owner.unwrap()

# Invoke after the genuine lower observer has actually closed. The upper must
# still retain original source/storage charge and failed-WAL recovery custody.
pub fn check_historical_metadata_after_lower_close_v3(source: LinuxWorkspaceSourceOwnerV1,
        expected_canonical_metadata: text) -> LinuxWorkspaceSourceOwnerV1:
    assert(linux_workspace_retained_metadata_encode_v3(source.retained_metadata_v3().unwrap()) == expected_canonical_metadata)
    val closed = source.close_v1()
    assert(not closed.closed and closed.owner != nil)
    closed.owner.unwrap()

# Bug agent_v4_source_return_never_completes_after_effect_2026-11-18: the retained
# return keeps the written root. Invoke with the genuine staged source and the
# actual native token the original authority minted after settle.
pub fn check_retained_return_keeps_written_root_v3(source: LinuxWorkspaceSourceOwnerV1,
        token: LinuxFreshWorkspaceNativeRetirementV3, full_invocation: text) -> LinuxWorkspaceSourceOwnerV1:
    assert(source.staging_effect_attempted_v3().unwrap())
    val retired = source.retire_native_v3(token, full_invocation)
    assert(retired.retired and retired.error == "")
    assert(retired.owner.staging_effect_attempted_v3().unwrap())
    val closed = retired.owner.close_v1()
    assert(not closed.closed and closed.owner.? and closed.error == "agent-workspace-retention-requires-authorized-cleanup")
    assert(closed.owner.unwrap().retained_metadata_v3().is_ok())
    closed.owner.unwrap()
