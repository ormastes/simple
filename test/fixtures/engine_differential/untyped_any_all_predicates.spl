# Untyped any/all with a named-function and a placeholder predicate, and
# untyped index_of: interpreter, JIT and native print the same values.
# The runtime returns a raw 0/1 (any/all) or a raw i64 (index_of); HIR must
# type the call BOOL / I64 so the result is converted. A closure-VARIABLE
# predicate is still recorded open in
# doc/08_tracking/bug/runtime_array_hardening_2026-10-19.md.
fn is_even(x) -> bool:
    x % 2 == 0

fn any_named(data):
    data.any(is_even)

fn all_named(data):
    data.all(is_even)

fn any_placeholder(data):
    data.any(_ > 2)

fn idx(data, v):
    data.index_of(v)

fn main():
    val xs = [1, 3, 4]
    print "named any={any_named(xs)} all={all_named(xs)} ph={any_placeholder(xs)} idx={idx(xs, 4)}"
    print "named any={any_named([1, 3])} all={all_named([2, 4])} ph={any_placeholder([1, 2])} idx={idx(xs, 9)}"
    val bs: [u8] = [1u8, 3u8, 4u8]
    print "u8 any={any_named(bs)} all={all_named(bs)} ph={any_placeholder(bs)} idx={idx(bs, 4)}"
