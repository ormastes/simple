# Divergence class (c), narrow-element sibling of array_value_semantics.spl.
#
# That fixture proves value semantics for `[i64]` only. Every engine agreed on
# it while the JIT was silently WRONG for `[u8]`: the MIR local-bind lowering
# (compiler/src/mir/lower/lowering_stmt.rs, `is_array_place_alias`) carried an
# `elem != TypeId::U8` carve-out, so `val cp = src` for a byte-packed array
# skipped rt_array_copy and aliased the source buffer. The interpreter was
# correct (Arc clone + make_mut), so the two engines DISAGREED about value
# semantics for the same source text.
#
# That carve-out's stated reason -- "rt_array_copy's rt_array_push-based copy
# loop does not understand the byte-packed layout" -- had gone stale: both
# runtimes reproduce the source layout (`is_byte_packed()` +
# copy_nonoverlapping in runtime/src/value/collections.rs;
# RT_CORE_ARRAY_FLAG_BYTES + memcpy in src/runtime/runtime_native.c).
#
# See doc/08_tracking/bug/cross_engine_differential_29_disagreements_2026-08-17.md
# section E -- the single cell of 150 that survived the 2026-08-17 sweep.
#
# Every `*_orig*` line below is the test: an engine with reference semantics
# prints 99 where the language specifies the pre-mutation value. The narrow
# types other than u8 are prevention coverage for the same defect class --
# any future representation change that packs [i8]/[u16]/[u32]/[bool]/[f32]
# must not re-introduce a per-element-type carve-out in the copy predicate.

fn mutate_bytes(inner: [u8]) -> u8:
    var local = inner
    local[0] = 99
    local[0]

fn main() -> i64:
    # 1. by-value ARGUMENT passing for a byte-packed array
    var bs: [u8] = [1, 2, 3]
    val callee_saw = mutate_bytes(bs)
    print("callee_saw={callee_saw}")
    print("arg_orig0={bs[0]}")

    # 2. local-bind PLACE alias -- the exact shape the carve-out skipped
    val cp = bs
    bs[1] = 99
    print("u8_copy1={cp[1]}")
    print("u8_src1={bs[1]}")

    # 3. narrow-element siblings: all already agreed, kept as prevention
    var a8: [i8] = [1, 2, 3]
    val c8 = a8
    a8[1] = 99
    print("i8_copy1={c8[1]}")

    var a16: [u16] = [1, 2, 3]
    val c16 = a16
    a16[1] = 99
    print("u16_copy1={c16[1]}")

    var a32: [u32] = [1, 2, 3]
    val c32 = a32
    a32[1] = 99
    print("u32_copy1={c32[1]}")

    var af: [f32] = [1.0, 2.0, 3.0]
    val cf = af
    af[1] = 99.0
    print("f32_copy1={cf[1]}")

    # 4. a fresh aggregate initializer must still NOT be copied defensively --
    # the predicate is place-scoped, and widening it to every initializer
    # would be a silent per-binding allocation regression.
    var fresh: [u8] = [7, 8, 9]
    fresh[0] = 5
    print("fresh0={fresh[0]}")
    0
