# Divergence class (a): the byte-vs-codepoint axis of text.
#
# `.len()` is a BYTE count while `.chars()` iterates codepoints. A lane that
# conflates the two produces an off-by-N only for non-ASCII input -- which is
# why an ASCII-only example corpus never sees it. The ASCII control line is
# here so a divergence can be attributed to multi-byte handling specifically.

fn main() -> i64:
    val ascii = "hello"
    val mixed = "aé€𝄞z"

    print("ascii_len={ascii.len()}")
    var ascii_chars = 0
    for _c in ascii.chars():
        ascii_chars = ascii_chars + 1
    print("ascii_chars={ascii_chars}")

    print("mixed_len={mixed.len()}")
    var mixed_chars = 0
    for _c in mixed.chars():
        mixed_chars = mixed_chars + 1
    print("mixed_chars={mixed_chars}")

    print("upper={ascii.to_upper()}")
    print("contains={mixed.contains("€")}")
    print("aligned_slice={mixed[0:1]}")
    0
