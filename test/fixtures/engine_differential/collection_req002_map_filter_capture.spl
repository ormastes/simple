# REQ-002: actual runtime collection callbacks, captured scalar and heap text.
# Sole stdout marker is emitted only after independent literal oracle checks.
fn make_prefixer(seed: text) -> (text) -> text:
    val prefix = seed + ":"
    \word: prefix + word

fn main() -> i64:
    val offset = 7
    val values = [3, 1, 3, 2]
    val mapped = values.map(\x: x + offset)
    if mapped != [10, 8, 10, 9]:
        return 1
    val filtered = mapped.filter(\x: x >= 10)
    if filtered != [10, 10]:
        return 2
    val words = ["a", "bbb", "cc"]
    val lengths = words.map(\word: word.len())
    if lengths != [1, 3, 2]:
        return 3
    # The factory's local heap text must survive its return before invocation.
    val prefixer = make_prefixer("owned")
    val prefixed = words.map(prefixer)
    if prefixed != ["owned:a", "owned:bbb", "owned:cc"]:
        return 6
    val empty: [i64] = []
    if empty.map(\x: x + offset).len() != 0:
        return 4
    if values != [3, 1, 3, 2]:
        return 5
    print("REQ002|map_filter_capture|10,8,10,9|10,10|1,3,2|owned:a,owned:bbb,owned:cc|empty=0|input=3,1,3,2")
    0
