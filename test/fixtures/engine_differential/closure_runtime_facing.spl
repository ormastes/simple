# Runtime-facing closure convention: a lambda handed to a runtime collection
# helper is called through rt_closure_func_ptr with the all-RuntimeValue
# convention. Before the boxed-entry thunk existed the JIT refused these shapes
# outright; before that it built a non-Closure object and `map` answered [].
# See doc/08_tracking/bug/seed_jit_coverage_self_hosted_compiler_2026-08-21.md.
fn main():
    val xs = [1, 2, 3, 4]
    print(xs.map(\x: x * 3))
    print(xs.filter(\x: x > 2))
    print(xs.find(\x: x > 2))

    # capture of a mutable local, seated with rt_closure_set_capture and read
    # back bit-for-bit with rt_closure_get_capture
    var k = 10
    print(xs.map(\x: x + k))

    # heap-handle elements crossing an i64-declared parameter slot: the
    # transport is bit-preserving, so the handle arrives intact
    val words = ["a", "bb", "ccc"]
    print(words.map(\s: s.len()))

    # JIT-internal direct callback, same object convention
    val f = \x: x * 10
    print(f(4))
    val g = \a, b: a + b
    print(g(3, 5))
