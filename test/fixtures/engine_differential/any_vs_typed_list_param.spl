# Divergence class (b): tag/untag boxing for ANY-typed vs [T]-typed params.
#
# A `[i64]` parameter can be passed unboxed (raw machine words); an untyped /
# ANY parameter must stay boxed so it can carry a tag. When the SAME list is
# routed through both shapes, a lane that forgets to tag on the way in (or to
# untag on the way out) produces a shifted or garbage value on one side only.
#
# The two sums must be identical. Any difference is a boxing-protocol bug.

fn sum_typed(xs: [i64]) -> i64:
    var total = 0
    for x in xs:
        total = total + x
    total

fn first_typed(xs: [i64]) -> i64:
    xs[0]

fn describe_any(v: Any) -> text:
    "{v}"

fn main() -> i64:
    val xs = [10, 20, 30, 40]
    print("typed_sum={sum_typed(xs)}")
    print("typed_first={first_typed(xs)}")
    print("any_of_elem={describe_any(xs[0])}")
    print("any_of_int={describe_any(30)}")
    print("any_of_bool={describe_any(true)}")
    print("any_of_text={describe_any("hi")}")
    0
