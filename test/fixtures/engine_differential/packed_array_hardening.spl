# Packed [u8]/[u64] and wide-int array semantics: interpreter, JIT and native
# must print the same lines. One block per defect fixed on
# work/runtime-array-hardening (doc/08_tracking/bug/runtime_array_hardening_2026-10-19.md):
#   join      native read [u8] as 8-byte slots and dropped integer elements
#   set/push  native stored a tagged value raw into a [u64] (56 -> 448)
#   for       a typed [u64] for-loop decoded raw words (56 -> 7) in JIT/native
#   wide      words >= 2^60 compared/ordered/hashed by address or as Equal
#   any/all   untyped any/all/index_of leaked a raw result into print
#   max/sort  [u8] max/sorted were wrong in the interpreter and JIT
#   reverse   JIT reverse() on a [u8] wrote 8-byte slots past the buffer
# Left out (recorded, not fixed here): the interpreter's mixed i64 + u8 sum
# wraps at 256, a typed-u64 dict key is boxed differently by `d[k] = v` and
# `contains_key`, and a mixed [int, float] literal is typed [i64].

fn joined(data, sep):
    data.join(sep)

fn set_at(data, i, v):
    data[i] = v

fn push_to(data, v):
    data.push(v)

fn sum_untyped(data):
    var t = 0
    for x in data:
        t = t + x
    t

fn put_key(d, data):
    d[data[0]] = 1

fn has_key(d, data):
    d.contains_key(data[1])

fn any8(data):
    data.any(\x: x == 8)

fn all_pos(data):
    data.all(\x: x > 0)

fn find(data, v):
    data.index_of(v)

fn main():
    val bytes: [u8] = [65u8, 66u8, 67u8]
    val words: [u64] = [65u64, 1152921504606846981u64]
    print "join u8={joined(bytes, ",")} u64={joined(words, ",")} i64={joined([1, 10000], ",")}"

    var g: [u64] = [1u64, 2u64]
    set_at(g, 0, 56)
    push_to(g, 9)
    val g0: u64 = g[0]
    val g2: u64 = g[2]
    var b: [u8] = [1u8, 2u8]
    set_at(b, 0, 56)
    push_to(b, 200)
    val b0: u8 = b[0]
    val b2: u8 = b[2]
    print "write u64={g0},{g2} len={g.len()} u8={b0},{b2}"

    val w: [u64] = [56u64, 8u64, 255u64]
    var tw: u64 = 0
    for y in w:
        tw = tw + y
    print "for typed-u64={tw} untyped-u64={sum_untyped(w)}"

    val wide: [u64] = [1152921504606846981u64, 1152921504606846981u64, 2305843009213693952u64, 5u64]
    val wm: u64 = wide.max()
    val ws = wide.sorted()
    val ws0: u64 = ws[0]
    val ws3: u64 = ws[3]
    var d = {}
    put_key(d, wide)
    print "wide max={wm} sorted0={ws0} sorted3={ws3} dict={has_key(d, wide)}"

    val ints = [1, 8, 3]
    val small: [u8] = [1u8, 8u8, 3u8]
    print "any i64={any8(ints)} {all_pos(ints)} {find(ints, 8)} u8={any8(small)} {all_pos(small)} {find(small, 8)}"
    print "any direct={ints.any(\x: x == 8)} {ints.all(\x: x > 5)} {ints.index_of(8)}"

    val a: [u8] = [56u8, 7u8, 8u8, 0u8, 255u8, 64u8]
    val am: u8 = a.max()
    print "u8 max={am} sorted={a.sorted()}"

    var src: [u8] = [1u8, 2u8, 3u8, 200u8]
    var r = src.copy()
    r.reverse()
    var p = src.copy()
    val popped = p.pop()
    var alias = src
    alias.reverse()
    print "reverse src={src} r={r} p={p} popped={popped} alias={alias}"
