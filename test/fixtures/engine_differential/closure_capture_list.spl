# Divergence class (c): aliasing across a CLOSURE boundary.
#
# A captured array must be captured by VALUE, like every other array binding.
# A lane that captures the backing buffer by reference lets the closure's
# write escape into the enclosing scope.
#
# Separately: the JIT has been documented to REFUSE modules containing
# lambdas, and to return garbage for a named function used as a value. Both
# show up here as an engine that produces no verdict at all, which the harness
# reports as an ERROR lane rather than a wrong answer.

fn apply_twice(f: (i64) -> i64, v: i64) -> i64:
    f(f(v))

fn double(v: i64) -> i64:
    v * 2

fn main() -> i64:
    var xs = [1, 2, 3]
    val bump = fn(n: i64) -> i64:
        n + xs[0]
    print("closure_call={bump(10)}")
    print("orig0_after_closure={xs[0]}")

    print("lambda_twice={apply_twice(fn(n: i64) -> i64: n + 1, 5)}")
    print("named_as_value={apply_twice(double, 3)}")
    0
