# REQ-002: real Dict struct payload overwrite and absent/present lookup.
struct CollectionPayload:
    number: i64
    label: text

fn main() -> i64:
    var values: Dict<i64, CollectionPayload> = {}
    values[7] = CollectionPayload(number: 10, label: "first")
    values[2] = CollectionPayload(number: 20, label: "other")
    values[7] = CollectionPayload(number: 30, label: "replacement")
    if values.len() != 2:
        return 1
    if not values.contains_key(7) or values.contains_key(9):
        return 2
    val replacement = values[7]
    if replacement.number != 30 or replacement.label != "replacement":
        return 3
    match values.get(2):
        Some(payload):
            if payload.number != 20 or payload.label != "other":
                return 4
        nil:
            return 5
    match values.get(9):
        Some(payload):
            return 6
        nil:
            pass
    print("REQ002|dict_struct_overwrite|len=2|present=true|absent=true|30:replacement|20:other")
    0
