# REQ-002: real captured predicates, exact invocation order, no test-side filter.
var integer_visits: [i64] = []
var text_visits: [text] = []

fn observed_integer(value: i64, threshold: i64) -> bool:
    integer_visits.push(value)
    value >= threshold

fn observed_text(value: text, wanted: text) -> bool:
    text_visits.push(value)
    value == wanted

fn main() -> i64:
    val input = [4, 1, 4, 2, 5]
    val threshold = 4
    integer_visits = []
    val selected = input.filter(\value: observed_integer(value, threshold))
    if selected != [4, 4, 5] or integer_visits != [4, 1, 4, 2, 5]:
        return 1
    if input != [4, 1, 4, 2, 5]:
        return 2
    val empty: [i64] = []
    integer_visits = []
    if empty.filter(\value: observed_integer(value, threshold)).len() != 0:
        return 3
    if integer_visits.len() != 0:
        return 4
    val words = ["ba", "ab", "ba", "cc"]
    val wanted = "b" + "a"
    text_visits = []
    val matched = words.filter(\value: observed_text(value, wanted))
    if matched != ["ba", "ba"] or text_visits != ["ba", "ab", "ba", "cc"]:
        return 5
    if words != ["ba", "ab", "ba", "cc"]:
        return 6
    print "REQ002|filter_captured|4,4,5|visits=4,1,4,2,5|empty=0|ba,ba|visits=ba,ab,ba,cc"
    0
