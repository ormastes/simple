# REQ-002: callback-returned nested arrays, empty expansion, stable flattening.
use std.gc_async_mut.pure.collections.{flatten}

fn expand(value: i64) -> [i64]:
    if value == 0:
        return []
    [value, value + 10]

fn main() -> i64:
    val values = [2, 0, 1, 2]
    val result = values.flat_map(expand)
    if result != [2, 12, 1, 11, 2, 12]:
        return 1
    val nested: [[i64]] = [[2, 12], [], [1, 11], [2, 12]]
    val library_result = flatten(nested)
    if library_result != [2, 12, 1, 11, 2, 12]:
        return 2
    val empty: [i64] = []
    if empty.flat_map(expand).len() != 0:
        return 3
    print("REQ002|flatmap_empty_order|2,12,1,11,2,12|library=2,12,1,11,2,12|empty=0")
    0
