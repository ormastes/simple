# Divergence class (d): integer boxing edge cases near the tag boundary.
#
# A tagged-pointer representation steals low bits (the `<< 3` family) or high
# bits from an i64. Values near 2^60 and above are exactly where a boxed
# integer stops round-tripping: it either loses its top bits or gets mistaken
# for a pointer. Small values round-trip fine, which is why every example test
# in the corpus misses this.
#
# Round-trip is the oracle: the value printed must equal the value written.

fn identity(v: i64) -> i64:
    v

fn main() -> i64:
    val small = 42
    val big = 1152921504606846976        # 2^60
    val bigger = 4611686018427387904     # 2^62
    val maxish = 9223372036854775807     # i64::MAX
    val negmax = -9223372036854775807

    print("small={identity(small)}")
    print("p60={identity(big)}")
    print("p62={identity(bigger)}")
    print("imax={identity(maxish)}")
    print("inegmax={identity(negmax)}")

    val boxed = [big, bigger, maxish]
    print("boxed_p60={boxed[0]}")
    print("boxed_p62={boxed[1]}")
    print("boxed_imax={boxed[2]}")

    print("arith={big + 1 - big}")
    print("shifted={big / 1024}")
    0
