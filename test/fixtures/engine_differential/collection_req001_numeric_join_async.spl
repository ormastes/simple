# REQ-001 numeric join oracle; uses production DataFrame merge, never a test join.
use std.ndarray.*
use std.common.binary_io.{f64_from_bits, f64_to_bits}
use std.nogc_async_mut.df.mod.{Symbol, Series, SeriesErased, DataFrame, JoinHow}
use std.nogc_async_mut.df.df_transform.{merge}

fn numeric_pairs_match(frame: DataFrame, left_rows: [i64], right_rows: [i64]) -> bool:
    if frame.num_rows().value != left_rows.len() or left_rows.len() != right_rows.len():
        return false
    val left = frame.col(Symbol.from("left_row")).unwrap()
    val right = frame.col(Symbol.from("right_row")).unwrap()
    for row in 0..left_rows.len():
        if left.missing[row].value != (left_rows[row] == -1):
            return false
        if right.missing[row].value != (right_rows[row] == -1):
            return false
        if left_rows[row] != -1 and left.values.flat_i64(Index.new(row)).value != left_rows[row]:
            return false
        if right_rows[row] != -1 and right.values.flat_i64(Index.new(row)).value != right_rows[row]:
            return false
    true

fn main() -> i64:
    val nan = f64_from_bits(0x7FF8000000000001u64)
    val negative_zero = -0.0
    # Verify the special-value inputs themselves, so a broken substrate cannot
    # make the join oracle vacuously pass on ordinary zeros.
    if nan == nan or f64_to_bits(negative_zero) != 0x8000000000000000u64:
        return 1
    val name = Symbol.from("key")
    val mask = [Bool.new(false), Bool.new(false), Bool.new(false),
                Bool.new(false), Bool.new(false), Bool.new(true)]
    val left_key = Series.from_f64_masked(name,
        [Float64.new(0.0), Float64.new(negative_zero), Float64.new(nan),
         Float64.new(2.0), Float64.new(2.0), Float64.new(9.0)], mask).unwrap()
    val right_key = Series.from_f64_masked(name,
        [Float64.new(negative_zero), Float64.new(0.0), Float64.new(nan),
         Float64.new(2.0), Float64.new(2.0), Float64.new(9.0)], mask).unwrap()
    val left = DataFrame.from_columns([
        SeriesErased.F64Series(left_key),
        SeriesErased.I64Series(Series.from_i64_values(Symbol.from("left_row"),
            [Int64.new(10), Int64.new(11), Int64.new(12),
             Int64.new(13), Int64.new(14), Int64.new(15)]))]).unwrap()
    val right = DataFrame.from_columns([
        SeriesErased.F64Series(right_key),
        SeriesErased.I64Series(Series.from_i64_values(Symbol.from("right_row"),
            [Int64.new(20), Int64.new(21), Int64.new(22),
             Int64.new(23), Int64.new(24), Int64.new(25)]))]).unwrap()

    val inner = merge(left, right, name, JoinHow.Inner).unwrap()
    if not numeric_pairs_match(inner,
            [10, 10, 11, 11, 13, 13, 14, 14],
            [20, 21, 20, 21, 23, 24, 23, 24]):
        return 2
    val outer = merge(left, right, name, JoinHow.Outer).unwrap()
    if not numeric_pairs_match(outer,
            [10, 10, 11, 11, 12, 13, 13, 14, 14, 15, -1, -1],
            [20, 21, 20, 21, -1, 23, 24, 23, 24, -1, 22, 25]):
        return 3
    val outer_key = outer.col(name).unwrap()
    for row in [4, 10]:
        val value = outer_key.values.flat_f64(Index.new(row)).value
        if value == value or outer_key.missing[row].value:
            return 4
    if not outer_key.missing[9].value or not outer_key.missing[11].value:
        return 5
    val right_join = merge(left, right, name, JoinHow.Right).unwrap()
    if not numeric_pairs_match(right_join,
            [10, 11, 10, 11, -1, 13, 14, 13, 14, -1],
            [20, 20, 21, 21, 22, 23, 23, 24, 24, 25]):
        return 6
    print "COLLECTION_REQ001_NUMERIC_JOIN_ASYNC_OK"
    0
