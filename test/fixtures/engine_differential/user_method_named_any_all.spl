# A user class method named `any` / `all` reached through an untyped receiver
# keeps its own result: HIR types untyped `any`/`all` as BOOL only in the
# builtin shape (one lambda predicate). See
# doc/08_tracking/bug/runtime_array_hardening_2026-10-19.md (item 5).
class Bag:
    n: i64
    fn any() -> i64:
        self.n * 10
    fn all(k: i64) -> text:
        "all{k}"

fn bag_any(b):
    b.any()

fn bag_all(b):
    b.all(3)

fn main():
    val bag = Bag(n: 7)
    print "user any={bag_any(bag)} all={bag_all(bag)} direct={bag.any()}"
