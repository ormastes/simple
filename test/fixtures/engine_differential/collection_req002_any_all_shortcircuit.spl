# REQ-002: actual builtin and pure-library short-circuit callback behavior.
use std.gc_async_mut.pure.collections.{any_match, all_match}

var predicate_calls: i64 = 0
fn is_two(value: i64) -> bool:
    predicate_calls = predicate_calls + 1
    value == 2
fn below_two(value: i64) -> bool:
    predicate_calls = predicate_calls + 1
    value < 2

fn main() -> i64:
    val input = [1, 2, 3]
    predicate_calls = 0
    if not input.any(is_two) or predicate_calls != 2:
        return 1
    predicate_calls = 0
    if input.all(below_two) or predicate_calls != 2:
        return 2
    predicate_calls = 0
    if not any_match(input, is_two) or predicate_calls != 2:
        return 3
    predicate_calls = 0
    if all_match(input, below_two) or predicate_calls != 2:
        return 4
    val empty: [i64] = []
    predicate_calls = 0
    if empty.any(is_two) or not empty.all(below_two):
        return 5
    if any_match(empty, is_two) or not all_match(empty, below_two):
        return 6
    if predicate_calls != 0:
        return 7
    print("REQ002|any_all_shortcircuit|any=true:2|all=false:2|library=true,false:2,2|empty=false,true:0")
    0
