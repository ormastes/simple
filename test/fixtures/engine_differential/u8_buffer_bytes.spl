# Divergence class (a)/(d): u8 buffers and the top-bit boundary.
#
# `[u8]` is documented as NOT being a packed buffer in every lane, so a byte
# array is another place the engines can disagree about representation. The
# values chosen straddle the signed-byte boundary: 0x7F / 0x80 / 0xFF is where
# a lane that sign-extends a u8 into an i64 starts printing negatives.

fn main() -> i64:
    val bytes: [u8] = [0, 1, 127, 128, 255]
    print("len={bytes.len()}")
    print("b0={bytes[0]}")
    print("b2={bytes[2]}")
    print("b3={bytes[3]}")
    print("b4={bytes[4]}")

    var total = 0
    for b in bytes:
        total = total + (b as i64)
    print("sum={total}")
    0
