# Divergence class (b)/(c): nested containers.
#
# A list-of-lists forces the boxing protocol to nest: the outer element is
# itself a heap value that must be tagged. A lane that untags one level too
# few (or too many) reads an address as an integer -- the "address-shaped"
# wrong answer, an implausibly large number.
#
# Value semantics must hold at BOTH levels: writing through the extracted
# inner list must not disturb the original.

# GRAMMAR DEFECT worked around here (recorded, not silently normalized) --
# see doc/08_tracking/bug/identifier_named_grid_hijacked_by_grid_literal_parser_2026-08-09.md
#
# Two separate spellings are claimed by the GRID-literal rule and rejected
# with "Grid literal must have at least one row":
#   1. an ordinary variable NAMED `grid`, when iterated by a nested `for` --
#      renaming it to `rows` is the entire fix, so `grid` is an undocumented
#      de-facto reserved word;
#   2. the type annotation `[[i64]]`.
# Hence `rows`, and hence seeding the outer list from a single-element
# literal. This keeps the fixture about CODEGEN rather than about the parser.

fn main() -> i64:
    var r0 = [1, 2]
    var r1 = [3, 4]
    var r2 = [5, 6]
    var rows = [r0]
    rows.push(r1)
    rows.push(r2)
    print("outer_len={rows.len()}")
    print("inner_len={rows[0].len()}")
    print("cell00={rows[0][0]}")
    print("cell21={rows[2][1]}")

    var row = rows[1]
    row[0] = 30
    print("orig_cell10={rows[1][0]}")
    print("row0={row[0]}")

    var total = 0
    for r in rows:
        for c in r:
            total = total + c
    print("flat_sum={total}")
    0
