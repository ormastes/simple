# Divergence class (b)/(c): nested containers.
#
# A list-of-lists forces the boxing protocol to nest: the outer element is
# itself a heap value that must be tagged. A lane that untags one level too
# few (or too many) reads an address as an integer -- the "address-shaped"
# wrong answer, an implausibly large number.
#
# Value semantics must hold at BOTH levels: writing through the extracted
# inner list must not disturb the original.

# GRAMMAR DEFECT worked around here (recorded, not silently normalized):
# the GRID-literal rule claims BOTH `[[1, 2], [3, 4]]` (a list-of-lists
# literal) and the type annotation `[[i64]]`, and rejects each with
# "Grid literal must have at least one row". So neither the obvious literal
# nor the obvious annotation can spell a nested list. Seeding the outer list
# from a single-element literal is the only spelling that parses, and keeps
# this fixture about codegen rather than about the syntax collision.

fn main() -> i64:
    var r0 = [1, 2]
    var r1 = [3, 4]
    var r2 = [5, 6]
    var grid = [r0]
    grid.push(r1)
    grid.push(r2)
    print("outer_len={grid.len()}")
    print("inner_len={grid[0].len()}")
    print("cell00={grid[0][0]}")
    print("cell21={grid[2][1]}")

    var row = grid[1]
    row[0] = 30
    print("orig_cell10={grid[1][0]}")
    print("row0={row[0]}")

    var total = 0
    for r in grid:
        for c in r:
            total = total + c
    print("flat_sum={total}")
    0
