# Regression for native_print_of_runtime_array_emits_nothing_2026-08-25.
# The engine-differential gate compares this program's exact stdout across the
# interpreter, JIT, and native lanes.  Cover both outcomes of print's runtime-
# array condition: non-empty/empty helper-produced arrays take aggregate
# rendering, while scalar/text controls retain their existing render paths.
fn main():
    val xs = [1, 2, 3]
    val mapped = xs.map(\x: x * 2)
    print(mapped)
    print(xs.filter(\x: x > 1))
    print(xs.filter(\x: x > 9))
    print(17)
    print("tail")
