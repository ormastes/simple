# Divergence class (a): UTF-8 slice boundary handling.
#
# Slicing text at a byte offset INSIDE a multi-byte codepoint must behave the
# same for every SPELLING of the slice and on every ENGINE: the result carries
# the RAW BYTES of the requested range, so its length is the width of that
# range and adjacent slices reassemble the original text.
#
# Until 2026-08-21 the interpreter's `.slice`/`.substring` substituted U+FFFD
# (via Rust's `String::from_utf8_lossy`), which is valid-but-wrong: it CHANGED
# the byte length (`slice_len` was 4, not 2) while the JIT/native `rt_slice`
# and bracket `s[0:2]` kept the raw bytes on every engine. Fixed in
# src/compiler_rust/compiler/src/interpreter_method/string.rs.
#
# Only the integer LENGTH distinguishes these -- print() renders every case as
# the same `a<?>` glyph, so never verify this class by eyeballing glyphs.
#
# See doc/08_tracking/bug/native_slice_splits_utf8_three_divergent_policies_2026-08-01.md

fn main() -> i64:
    val s = "aé€𝄞z"
    print("total_len={s.len()}")
    print("bracket_aligned_len={s[0:3].len()}")
    print("bracket_split_len={s[0:2].len()}")
    print("slice_len={s.slice(0, 2).len()}")
    print("substring_len={s.substring(0, 2).len()}")
    print("slice_wide_len={s.slice(0, 8).len()}")
    print("empty_len={s.slice(3, 3).len()}")
    print("overrun_len={s.slice(6, 99).len()}")
    print("reassembled={s.slice(0, 2) + s.slice(2, 11)}")
    0
