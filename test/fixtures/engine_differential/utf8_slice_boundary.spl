# Divergence class (a): UTF-8 slice boundary handling.
#
# Slicing text at a byte offset INSIDE a multi-byte codepoint has three
# different behaviours depending on the SPELLING of the slice and the ENGINE:
#   - bracket `s[0:2]`      -> raw bytes on every engine (stores INVALID UTF-8)
#   - `.slice(0,2)`         -> interpreter substitutes U+FFFD (len 4),
#                              JIT/native keep raw bytes (len 2)
#   - `.substring(0,2)`     -> same divergence as .slice
#
# Only the integer LENGTH distinguishes these -- print() renders all three as
# the same `a<?>` glyph, so never verify this class by eyeballing glyphs.
#
# See doc/08_tracking/bug/native_slice_splits_utf8_three_divergent_policies_2026-08-01.md
#
# EXPECTED: DIVERGENCE between interpret and jit/native on slice_len and
# substring_len. This fixture is the harness's own proof-of-life.

fn main() -> i64:
    val s = "aé€𝄞z"
    print("total_len={s.len()}")
    print("bracket_aligned_len={s[0:3].len()}")
    print("bracket_split_len={s[0:2].len()}")
    print("slice_len={s.slice(0, 2).len()}")
    print("substring_len={s.substring(0, 2).len()}")
    0
