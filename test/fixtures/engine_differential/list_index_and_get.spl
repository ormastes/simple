# Divergence class (d): list element read paths.
#
# `list.get(i)` was documented as returning `value << 3` on some codegen
# lanes (a tagged-pointer left in its boxed form and never untagged), while
# bracket indexing `xs[i]` returned the correct value. Both spellings read the
# same slot, so any disagreement between them -- on ANY single engine -- is a
# boxing/untagging defect, and disagreement BETWEEN engines is the same defect
# reaching only one lane.
#
# The `<< 3` shape is why the values below are chosen to be small: a shifted
# 5 reads as 40, which is unmistakable.

fn main() -> i64:
    val xs = [5, 9, 17, 33]
    print("bracket0={xs[0]}")
    print("bracket3={xs[3]}")
    print("get0={xs.get(0) ?? -1}")
    print("get3={xs.get(3) ?? -1}")
    print("len={xs.len()}")
    var total = 0
    for x in xs:
        total = total + x
    print("iter_sum={total}")
    0
