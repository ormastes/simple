# Divergence class (d): f64 boxing and rendering.
#
# A tagged representation that boxes f64 through an i64 slot is the classic
# place for a NaN-boxing or bit-reinterpretation bug: the value survives
# arithmetic but comes back as a different double, or renders with a
# different number of digits on one lane.
#
# Formatting differences are themselves a real divergence here -- the same
# program must produce the same stdout on every engine.

fn identity(v: f64) -> f64:
    v

fn main() -> i64:
    val a = 0.1
    val b = 0.2
    print("sum={identity(a + b)}")
    print("whole={identity(2.0)}")
    print("neg={identity(-1.5)}")
    print("tiny={identity(0.000001)}")
    print("big={identity(1.0e18)}")

    val fs = [1.5, 2.25, 3.125]
    var total = 0.0
    for f in fs:
        total = total + f
    print("list_sum={total}")
    print("boxed0={fs[0]}")
    0
