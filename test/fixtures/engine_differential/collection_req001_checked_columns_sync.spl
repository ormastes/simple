# REQ-001 checked production column facade; shared across requested engines.
use std.ndarray.*
use std.nogc_sync_mut.df.mod.{Symbol, Series}
use std.nogc_sync_mut.df.*

fn main() -> i64:
    val integer = TypedSeries<Int64>.from_masked_checked(Symbol.from("integers"),
        [Int64.new(11), Int64.new(999), Int64.new(33)],
        [Bool.new(false), Bool.new(true), Bool.new(false)]).unwrap()
    val dynamic = i64_typed_series_into_dynamic_checked(integer).unwrap()
    val restored = i64_typed_series_from_dynamic_checked(dynamic).unwrap()
    if restored.len().value != 3 or restored.values[0].value != 11 or restored.values[2].value != 33:
        return 1
    if restored.missing[0].value or not restored.missing[1].value or restored.missing[2].value:
        return 2
    val absent = restored.get_checked(Index.new(1)).unwrap()
    if absent.?:
        return 3
    if restored.get_checked(Index.new(0)).unwrap().unwrap().value != 11:
        return 4
    for index in [-1, 3]:
        match restored.get_checked(Index.new(index)):
            case Err(error):
                if error != TypedColumnError.IndexOutOfBounds(index, 3):
                    return 5
            case _: return 6

    val floating = TypedSeries<Float64>.from_masked_checked(Symbol.from("floats"),
        [Float64.new(-1.25), Float64.new(99.0), Float64.new(3.5)],
        [Bool.new(false), Bool.new(true), Bool.new(false)]).unwrap()
    val float_dynamic = f64_typed_series_into_dynamic_checked(floating).unwrap()
    val float_restored = f64_typed_series_from_dynamic_checked(float_dynamic).unwrap()
    if float_restored.values[0].value != -1.25 or float_restored.values[2].value != 3.5:
        return 7
    if float_restored.missing[0].value or not float_restored.missing[1].value or float_restored.missing[2].value:
        return 8
    match i64_typed_series_from_dynamic_checked(float_dynamic):
        case Err(error):
            if error != TypedColumnError.DTypeMismatch(DType.I64, DType.F64, DType.F64):
                return 9
        case _: return 10
    match TypedSeries<Int64>.from_masked_checked(Symbol.from("bad_mask"), [Int64.new(1)], []):
        case Err(error):
            if error != TypedColumnError.MaskLength(1, 0):
                return 11
        case _: return 12

    var view = Series.from_i64_values(Symbol.from("reverse"),
        [Int64.new(11), Int64.new(22), Int64.new(33)])
    var backing = view.values
    backing.offset = Index.new(2)
    backing.strides = Stride.new([Index.new(-1)])
    view.values = backing
    val reversed = i64_typed_series_from_dynamic_checked(view).unwrap()
    if reversed.values[0].value != 33 or reversed.values[1].value != 22 or reversed.values[2].value != 11:
        return 13
    backing.offset = Index.new(0)
    backing.shape = Shape.new([Index.new(2)])
    backing.strides = Stride.new([Index.new(2)])
    view.values = backing
    view.missing = [Bool.new(false), Bool.new(false)]
    val strided = i64_typed_series_from_dynamic_checked(view).unwrap()
    if strided.len().value != 2 or strided.values[0].value != 11 or strided.values[1].value != 33:
        return 14
    backing.shape = Shape.new([Index.new(3)])
    view.values = backing
    view.missing = [Bool.new(false), Bool.new(false), Bool.new(false)]
    match i64_typed_series_from_dynamic_checked(view):
        case Err(error):
            if error != TypedColumnError.InvalidStorage("stride-outside-backing"):
                return 15
        case _: return 16
    print("REQ001|checked_columns_sync|i64=11,missing,33|f64=-1.25,missing,3.5|index=-1,3:rejected|dtype=reject|mask=reject|reverse=33,22,11|stride=11,33|bounds=reject")
    0
