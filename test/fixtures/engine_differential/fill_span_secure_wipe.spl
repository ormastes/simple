# Engine parity for the compiler-owned in-place volatile fill
# (`Array.fill_span`) and the secure-memory owner built on it.
#
# doc/08_tracking/bug/secure_memory_interpreter_raw_pointer_aliasing_2026-08-24.md:
# the interpreter used to wipe through a raw pointer into a shared
# `Arc<Vec<u8>>` (or a freed temporary), so the two engines disagreed about
# which buffers a wipe reached. Every line below must be identical across
# engines: the owner's place is wiped, a pre-wipe value-semantics copy is
# not, a callee's private copy never reaches the caller, and field /
# nested-field places are wiped in place.

use std.common.crypto.secure_memory.{secure_zero_u8_slots, secure_zero_u8_range}

class KeyHolder:
    key: [u8]

fn wipe_private_copy(bytes: [u8]) -> i64:
    var local = bytes
    if secure_zero_u8_slots(local).verified(): 1 else: 0

fn main() -> i64:
    var secret: [u8] = [0xDE, 0xAD, 0xBE, 0xEF]
    var copy_before = secret
    val report = secure_zero_u8_slots(secret)
    print("verified={report.verified()} written={report.overwritten_slots} residual={report.residual_nonzero_slots}")
    print("owner0={secret[0]} owner3={secret[3]}")
    print("copy_before0={copy_before[0]}")

    var caller: [u8] = [1, 2, 3]
    val private_ok = wipe_private_copy(caller)
    print("private_ok={private_ok} caller0={caller[0]} caller2={caller[2]}")

    var holder = KeyHolder(key: [9, 9, 9, 9])
    val field_report = secure_zero_u8_slots(holder.key)
    print("field_verified={field_report.verified()} field0={holder.key[0]} field3={holder.key[3]}")

    var guarded: [u8] = [170, 17, 34, 51, 68, 187]
    val window = secure_zero_u8_range(guarded, 1u64, 4u64)
    print("window_verified={window.verified()} g0={guarded[0]} g1={guarded[1]} g4={guarded[4]} g5={guarded[5]}")

    var direct: [u8] = [5, 5, 5]
    val n = direct.fill_span(0, 2, 0xA5u8)
    print("fill_n={n} d0={direct[0]} d1={direct[1]} d2={direct[2]}")
    0
