# Deliberately produce one byte beyond each 4096-byte capture boundary.
fn main() -> i64:
    var stdout_payload = ""
    var stderr_payload = ""
    # print/eprintln each append their newline: 4096 payload bytes + 1 newline.
    for _i in range(0, 4096):
        stdout_payload = stdout_payload + "o"
        stderr_payload = stderr_payload + "e"
    print(stdout_payload)
    eprintln(stderr_payload)
    0
