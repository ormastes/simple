use dep.{cross}

# TRAIT method call omitting trailing defaults -- the `TraitMethod` arm in
# `_MirLoweringExpr/method_calls_literals.spl` (distinct from `InstanceMethod`:
# it is only reached when the receiver's STATIC type is the trait, e.g. a
# trait-typed local variable, not the concrete class).
#
# NOTE: a trait-typed *field* receiver (e.g. `host.g.greet(...)` or
# `if val g = host.g: g.greet(...)` for `g: Greeter?`) and a trait-typed
# return value threaded through a function call (`fn make_greeter() ->
# Greeter`) both hit a SEPARATE, pre-existing native-build defect --
# "unresolved method call: greet" -- independent of the trailing-default-arg
# padding this fixture guards. Only the direct-construction-to-trait-typed-
# local-var shape is used here to isolate the trailing-default regression;
# the field/return-value trait-dispatch gap is not this check's concern.
trait Greeter:
    me greet(name: text, loud: bool = false, times: i64 = 1) -> i64

class FriendlyGreeter:
    prefix: text

impl Greeter for FriendlyGreeter:
    me greet(name: text, loud: bool = false, times: i64 = 1) -> i64:
        print("greet name={name} loud={loud} times={times}\n")
        0

class Widget:
    base: i64

    me bump(step: i64, loud: bool = false, extra: i64 = 99) -> i64:
        print("bump step={step} loud={loud} extra={extra}\n")
        self.base + step

    static fn stat(a: i64, b: i64 = 55, c: bool = false) -> i64:
        print("stat a={a} b={b} c={c}\n")
        0

# Same-module free function with a mix of literal AND expression defaults.
fn local_fn(a: i64, s: bool = false, t: i64 = 12) -> i64:
    print("local a={a} s={s} t={t}\n")
    0

fn main() -> i64:
    # Same-module free function: omit both trailing defaults.
    local_fn(1)
    # Same-module free function: omit only the last trailing default.
    local_fn(1, true)
    # Cross-module free function: omit all four trailing defaults, including
    # one whose default is a CALL EXPRESSION (`computed`) and one whose
    # default is a CONST EXPRESSION (`expr`), not just a literal.
    cross(9)
    var w = Widget(base: 100)
    # Instance method: omit both trailing defaults.
    w.bump(1)
    # Static method: omit both trailing defaults.
    Widget.stat(2)
    # TRAIT method: omit both trailing defaults. `g` is a local variable
    # declared with the TRAIT type (not the concrete class), so the call
    # resolves through the `TraitMethod` arm, not `InstanceMethod`.
    var g: Greeter = FriendlyGreeter(prefix: "hi")
    g.greet("Bob")
    0
