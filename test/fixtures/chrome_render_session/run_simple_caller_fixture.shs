#!/usr/bin/env sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)
cd "$root"

out_dir=build/test-fixtures/chrome_render_session
simple_bin=${SIMPLE_BIN:-bin/simple}
mkdir -p "$out_dir"

case "$(uname -s)" in
    Darwin) suffix=dylib; shared_flag=-dynamiclib ;;
    Linux) suffix=so; shared_flag=-shared ;;
    *) echo "chrome-render-session fixture requires Darwin or Linux" >&2; exit 1 ;;
esac

${CC:-cc} -std=c11 -Wall -Wextra -Werror -fPIC "$shared_flag" \
    -Isrc/runtime/browser \
    test/fixtures/chrome_render_session/simple_chrome_render_session_fixture.c \
    -o "$out_dir/libsimple_chrome_render_session.$suffix"

caller_output=$(SIMPLE_LIB=src "$simple_bin" run \
    test/02_integration/rendering/chrome_render_session_native_integration.spl 2>&1) || {
    printf '%s\n' "$caller_output"
    exit 1
}
printf '%s\n' "$caller_output"
case "$caller_output" in
    *"chrome-render-session-integration: PASS fixture-only"*) ;;
    *) echo "ERROR: Simple caller did not emit its required PASS receipt" >&2; exit 1 ;;
esac
