#!/usr/bin/env sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM

case "$(uname -s)" in
    Darwin) strip_flag=-Wl,-dead_strip ;;
    Linux) strip_flag=-Wl,--gc-sections ;;
    *) echo "mixed ABI bridge harness requires Darwin or Linux" >&2; exit 1 ;;
esac

${CC:-cc} -std=c11 -O0 -ffunction-sections -fdata-sections \
    -DSIMPLE_RUNTIME_DYNLOAD_OWNER=1 -I"$root/src/runtime" \
    -I"$root/src/runtime/platform" \
    -c "$root/src/runtime/runtime_native.c" -o "$work/runtime_native.o"
${CC:-cc} -std=c11 -Wall -Wextra -Werror "$strip_flag" \
    "$root/test/fixtures/chrome_render_session/mixed_abi_bridge_harness.c" \
    "$work/runtime_native.o" -o "$work/mixed_abi_bridge_harness"
"$work/mixed_abi_bridge_harness"
