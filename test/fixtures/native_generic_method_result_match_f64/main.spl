# Native oracle (f64 sibling of ../native_generic_method_result_match): the
# declared Result<T, E> of Store<f64>.get owns bare Ok/Err arms and its
# payload is decoded as f64, including after `set`. Arms use explicit
# `return`: with an implicit match tail in this `-> f64` function the seed
# interpreter prints 0.0 for every call (seed defect, not the oracle).
# Build: SIMPLE_BOOTSTRAP=1 native-build main.spl --entry-closure (cranelift, llvm).
# Expected stdout (seed `simple run main.spl`):
# -1.5
# 2.25
# -1.5
# 3.25

use store.{Store, store_new}

enum Probe:
    Ok
    Err

var f64_stores: [Store<f64>] = []

fn f64_get(idx: i64) -> f64:
    match f64_stores[0].get(idx):
        case Ok(v): return v
        case Err(_): return -1.5

fn main():
    f64_stores.push(store_new<f64>("weight"))
    print(f64_get(1))
    f64_stores[0].set(1, 2.25)
    print(f64_get(1))
    print(f64_get(0))
    print(f64_stores[0].get(1).unwrap_or(0.5) + 1.0)
