# Fixture: where the pure-runner specs find the stories15M model directory.
#
# SLANG_PURE_MODEL names the directory itself; otherwise it is
# llama2c-stories15M under SLANG_MODEL_ROOT. There is no built-in default
# path: a host that sets neither gets "" and the specs skip with a reason.

use std.gc_async_mut.slang.host.slang_host.{host_env, host_is_dir}

val STORIES15M_DIR_NAME = "llama2c-stories15M"

# Candidate directory from the two settings ("" = unset); "" when both are unset.
pub fn pure_model_dir_from(pure_model: text, model_root: text) -> text:
    if pure_model != "":
        return pure_model
    if model_root == "":
        return ""
    if model_root.ends_with("/") or model_root.ends_with("\\"):
        return model_root + STORIES15M_DIR_NAME
    model_root + "/" + STORIES15M_DIR_NAME

# The configured stories15M directory, or "" when unset or not a directory.
pub fn pure_model_dir() -> text:
    val d = pure_model_dir_from(host_env("SLANG_PURE_MODEL"), host_env("SLANG_MODEL_ROOT"))
    if d != "" and host_is_dir(d):
        return d
    ""
