use std.common.binary_io.{f64_to_bits}

fn main():
    val positive: f64 = 3.6
    val negative: f64 = -3.6
    val rounded: f64 = 2.6
    val negative_rounded: f64 = -2.6
    val below_half: f64 = 0.49999999999999994
    val precision_boundary: f64 = 4503599627370497.0
    val positive_tie: f64 = 2.5
    val negative_tie: f64 = -2.5
    val negative_zero: f64 = -0.0
    val rounded_negative_zero = negative_zero.round()
    print "floor={positive.floor()} ceil={negative.ceil()}"
    print "round={rounded.round()} negative_round={negative_rounded.round()}"
    print "below_half={below_half.round()} boundary={precision_boundary.round()}"
    print "positive_tie={positive_tie.round()} negative_tie={negative_tie.round()}"
    print "signed_zero={f64_to_bits(rounded_negative_zero) == f64_to_bits(negative_zero)}"
