use compiler.core.parser.{parse_module, parser_has_errors, parser_set_had_error}

fn parses(source: text, name: text) -> bool:
    parser_set_had_error(false)
    parse_module(source, name)
    not parser_has_errors()

fn main() -> i64:
    val named = "fn outer(x: i64) -> i64:\n    fn twice(y: i64) -> i64: y * 2\n    twice(x)\n"
    if not parses(named, "native_named_nested_fn_owner.spl"):
        return 41
    val anonymous = "fn outer():\n    fn(x: i64) -> i64: x + 1\n"
    if not parses(anonymous, "native_anonymous_stmt_fn_owner.spl"):
        return 42
    val me_named = "fn outer():\n    me helper(x: i64) -> i64: x\n"
    if not parses(me_named, "native_me_named_fn_owner.spl"):
        return 43
    0
