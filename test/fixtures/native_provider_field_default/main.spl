use provider.{Attachment, Lease, mode_name}

# Constructing an imported ("provider") struct while omitting fields whose
# declared default is `None`, a literal, `[]` or a unit enum variant. The
# consumer must store the provider's declared default, exactly as the
# in-module construction path does.
fn show(att: Attachment):
    var helper_id = -1
    if val Some(lease) = att.helper:
        helper_id = lease.id
    var session = "<none>"
    if val Some(s) = att.session:
        session = s
    print("name={att.name} helper={helper_id} session={session} count={att.count} ratio={att.ratio} ready={att.ready} label={att.label} items={att.items.len()} mode={mode_name(att.mode)} tail={att.tail}\n")

fn main() -> i64:
    show(Attachment(name: "all-default"))
    show(Attachment(name: "some-set", helper: Some(Lease(id: 42)), count: 9, tail: 3))
    show(Attachment(name: "session-set", session: Some("s1"), ready: false, label: "cli", items: [1, 2, 3]))
    0
