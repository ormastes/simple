# Provider half of the native_provider_field_default fixture: a struct whose
# defaulted fields the CONSUMER module (main.spl) omits at construction.
pub enum Mode:
    Idle
    Busy

pub struct Lease:
    id: i64

pub struct Attachment:
    name: text
    helper: Option<Lease> = None
    session: Option<text> = None
    count: i64 = 7
    ratio: f64 = 1.5
    ready: bool = true
    label: text = "web"
    items: [i64] = []
    mode: Mode = Mode.Busy
    tail: i64 = 0

pub fn mode_name(mode: Mode) -> text:
    match mode:
        case Idle: "idle"
        case Busy: "busy"
