# Native repro for the HIR walker slice 3: static/instance methods whose
# SymbolId belongs to an imported module, `return` inside a closure body,
# and print line endings. Run with the native CLI:
#   cli_tip.exe run test/fixtures/native_interp_walker_slice3/main.spl
# doc/08_tracking/bug/native_cli_test_cannot_run_std_spec_2026-11-15.md
use provider.{Counter}

fn apply(f: fn(i64) -> i64, x: i64) -> i64:
    f(x) + 1000

fn main() -> i64:
    val c = Counter.start(4)
    print "static={c.n}"
    print "instance={c.bumped()}"
    val early = apply(\x:
        if x > 0:
            return x * 2
        -1
    , 5)
    print "closure_return={early}"
    print "after_closure=ok"
    0
