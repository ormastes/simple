# Prepare retained request bytes; does not launch a tool. Pretty JSON is
# intentional: protocol clients need not compact spaces after a colon.
use std.common.json.value.{JsonValue, json_parse_value_strict, json_value_pretty, json_value_escape_string}
use std.nogc_sync_mut.io_runtime.{env_get, file_read_result, file_write_bytes}

fn main() -> i64:
    val template = file_read_result(env_get("QUALIFICATION_REQUESTS"))
    if template.is_err(): return 2
    val root = template.unwrap().replace("__ROOT_URI__", json_value_escape_string(env_get("QUALIFICATION_ROOT_URI")))
    val subject = root.replace("__SUBJECT_URI__", json_value_escape_string(env_get("QUALIFICATION_SUBJECT_URI")))
    val replaced = subject.replace("__SUBJECT_FILE__", json_value_escape_string(env_get("QUALIFICATION_SUBJECT_FILE")))
    val parsed = json_parse_value_strict(replaced)
    if parsed.is_err(): return 3
    var output: [text] = []
    var requests = 0
    match parsed.unwrap():
        case JsonValue.Array(rows):
            for row in rows:
                val body = json_value_pretty(row)
                output.push("Content-Length: {body.bytes().len()}\r\n\r\n" + body)
                requests = requests + 1
        case _: return 4
    if requests == 0: return 5
    if not file_write_bytes(env_get("QUALIFICATION_STDIN"), output.join("").bytes()): return 6
    print "compiled tool requests: {requests} framed requests prepared"
    0
