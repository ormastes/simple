# Native transcript verifier. It never starts a server or compiler. The owning
# process watchdog supplies raw stdout and its complete, enforced receipt.
use std.common.json.value.{JsonValue, json_parse_value_strict, json_value_field,
    json_value_serialize, json_value_keys, json_value_has}
use std.nogc_sync_mut.io_runtime.{env_get, file_read_result, file_read_bytes_result}

extern fn rt_bytes_to_text(data: [u8]) -> text

fn field_text(value: JsonValue, key: text) -> text:
    match json_value_field(value, key):
        case JsonValue.Str(text_value): text_value
        case _: ""

fn field_int(value: JsonValue, key: text) -> i64:
    match json_value_field(value, key):
        case JsonValue.Int(number): number
        case _: -1

fn field_bool(value: JsonValue, key: text) -> bool:
    match json_value_field(value, key):
        case JsonValue.Bool(flag): flag
        case _: false

fn receipt_field(receipt: text, key: text) -> Result<text, text>:
    val prefix = key + "="
    var found = 0
    var value = ""
    for line in receipt.split("\n"):
        val clean = if line.ends_with("\r"): line.substring(0, line.len() - 1) else: line
        if clean.starts_with(prefix):
            found = found + 1
            value = clean.substring(prefix.len())
    if found != 1: return Err("missing or duplicate process receipt field: " + key)
    Ok(value)

fn framed_json(bytes: [u8]) -> Result<[JsonValue], text>:
    val prefix = "Content-Length: ".bytes()
    var messages: [JsonValue] = []
    var pos = 0
    while pos < bytes.len():
        if bytes.len() - pos < prefix.len(): return Err("truncated frame header")
        var index = 0
        while index < prefix.len():
            if bytes[pos + index] != prefix[index]: return Err("unframed stdout or invalid frame header")
            index = index + 1
        pos = pos + prefix.len()
        var length = 0
        var digits = 0
        while pos < bytes.len() and bytes[pos] >= 48u8 and bytes[pos] <= 57u8:
            length = length * 10 + ((bytes[pos] as i64) - 48)
            digits = digits + 1
            if digits > 7 or length > 4194304: return Err("oversized frame")
            pos = pos + 1
        if digits == 0 or length == 0: return Err("missing positive frame length")
        if pos + 4 > bytes.len() or bytes[pos] != 13u8 or bytes[pos + 1] != 10u8 or
                bytes[pos + 2] != 13u8 or bytes[pos + 3] != 10u8:
            return Err("frame must have exact CRLF header terminator")
        pos = pos + 4
        if length > bytes.len() - pos: return Err("truncated byte-counted payload")
        var payload: [u8] = []
        var consumed = 0
        while consumed < length:
            payload.push(bytes[pos + consumed])
            consumed = consumed + 1
        val parsed = json_parse_value_strict(rt_bytes_to_text(payload))?
        if field_text(parsed, "jsonrpc") != "2.0": return Err("message is not JSON-RPC 2.0")
        messages.push(parsed)
        pos = pos + length
    if messages.len() == 0: return Err("zero framed messages")
    Ok(messages)

fn response_table(messages: [JsonValue]) -> Result<Dict<text, JsonValue>, text>:
    var responses: Dict<text, JsonValue> = {}
    for message in messages:
        if not json_value_has(message, "id"):
            val method = field_text(message, "method")
            if method != "notifications/tools/list_changed" and method != "textDocument/publishDiagnostics":
                return Err("unexpected server notification")
            continue
        val id = json_value_serialize(json_value_field(message, "id"))
        if id == "null" or responses.has(id): return Err("null or duplicate response id")
        if json_value_has(message, "result") == json_value_has(message, "error"):
            return Err("response must contain exactly one result or error")
        responses[id] = message
    Ok(responses)

fn array_contains_name(value: JsonValue, name: text, symbol: bool) -> bool:
    match value:
        case JsonValue.Array(values):
            for row in values:
                if field_text(row, "name") != name: continue
                if not symbol: return true
                val start = json_value_field(json_value_field(row, "range"), "start")
                if field_int(row, "kind") == 12 and field_int(start, "line") == 2: return true
            false
        case _: false

fn tool_text(result: JsonValue) -> Result<text, text>:
    match json_value_field(result, "content"):
        case JsonValue.Array(content):
            if content.len() != 1 or field_text(content[0], "type") != "text":
                return Err("tool result has no unique text content")
            Ok(field_text(content[0], "text"))
        case _: Err("tool content is not an array")

fn validate(mode: text, messages: [JsonValue]) -> Result<i64, text>:
    val rows = response_table(messages)?
    val expected = if mode == "native-lsp": ["1", "2", "3", "\"missing-α\""] else:
        if mode == "mcp": ["1", "2", "3", "4", "\"tools-first\"", "\"tools-full\""] else:
            ["1", "2", "3", "4", "\"tools-first\""]
    if rows.len() != expected.len(): return Err("response count differs from request count")
    for id in expected:
        if not rows.has(id): return Err("missing exact numeric/string response id: " + id)
    var checks = 2
    val initialized = json_value_field(rows["1"], "result")
    if field_text(json_value_field(initialized, "serverInfo"), "name") == "":
        return Err("initialize did not return actual server identity")
    checks = checks + 1
    if mode == "native-lsp":
        if not field_bool(json_value_field(initialized, "capabilities"), "documentSymbolProvider"):
            return Err("initialize did not advertise document symbols")
        checks = checks + 1
        if not array_contains_name(json_value_field(rows["2"], "result"), "qualification_sum", true):
            return Err("documentSymbol did not return actual source function and line")
        checks = checks + 1
        val unknown = json_value_field(rows["\"missing-α\""], "error")
        if field_int(unknown, "code") != -32601 or
                field_text(unknown, "message") != "Method not found: qualification_unknown_é":
            return Err("nested params.method or UTF-8 unknown method changed dispatch")
        checks = checks + 1
        match json_value_field(rows["3"], "result"):
            case JsonValue.Null: pass
            case _: return Err("shutdown result is not null")
        if json_value_has(rows["3"], "error"): return Err("shutdown failed")
        checks = checks + 1
        return Ok(checks)
    val tools = json_value_field(json_value_field(rows["\"tools-first\""], "result"), "tools")
    val full_tools = if mode == "mcp":
        json_value_field(json_value_field(rows["\"tools-full\""], "result"), "tools")
    else:
        tools
    val tool_name = if mode == "mcp": "debug_list_sessions" else: "lsp_symbols"
    if not array_contains_name(full_tools, tool_name, false): return Err("registered tool missing from actual tool list")
    checks = checks + 1
    val called = json_value_field(rows["2"], "result")
    if field_bool(called, "isError"): return Err("registered tool failed")
    val actual = json_parse_value_strict(tool_text(called)?)?
    if mode == "mcp":
        match actual:
            case JsonValue.Array(sessions):
                if sessions.len() != 0: return Err("fresh debug registry is not empty")
            case _: return Err("debug session tool did not return actual JSON array")
    elif not array_contains_name(actual, "qualification_sum", true):
        return Err("LSP MCP symbol query did not return actual source function and line")
    checks = checks + 1
    if mode == "mcp":
        val failed = json_value_field(rows["3"], "result")
        val structured = json_value_field(failed, "structuredContent")
        if not field_bool(failed, "isError") or field_int(structured, "code") != -32601 or
                field_text(structured, "message") != "Unknown tool: qualification_missing_é":
            return Err("unknown UTF-8 MCP tool did not fail with its actual error contract")
    else:
        val failed = json_value_field(rows["3"], "error")
        if field_int(failed, "code") != -32602 or
                field_text(failed, "message") != "Unknown tool: qualification_missing_é":
            return Err("unknown UTF-8 LSP MCP tool did not fail with its actual error contract")
    checks = checks + 1
    val ping = json_value_field(rows["4"], "result")
    match ping:
        case JsonValue.Object(keys, _):
            if keys.len() != 0: return Err("ping result is not empty object")
        case _: return Err("ping did not return object")
    if json_value_has(rows["4"], "error"): return Err("ping failed")
    checks = checks + 1
    Ok(checks)

fn main() -> i64:
    val mode = env_get("QUALIFICATION_PROTOCOL")
    if mode != "mcp" and mode != "lsp-mcp" and mode != "native-lsp": return 2
    val receipt = file_read_result(env_get("QUALIFICATION_PROCESS_RECEIPT"))
    if receipt.is_err(): return 3
    for key in ["status", "exit_status", "quiescent", "observer_errors", "max_rss_kib", "rss_cap_mode"]:
        val expected = if key == "status": "complete" else: if key == "exit_status" or key == "observer_errors": "0" else:
            if key == "quiescent": "1" else: if key == "max_rss_kib": "5859375" else: "enforce"
        val found = receipt_field(receipt.unwrap(), key)
        if found.is_err() or found.unwrap() != expected:
            print "protocol qualification refused process receipt field: {key}"
            return 4
    val bytes = file_read_bytes_result(env_get("QUALIFICATION_STDOUT"))
    if bytes.is_err(): return 5
    val framed = framed_json(bytes.unwrap())
    if framed.is_err():
        print "protocol qualification framing failed: {framed.unwrap_err()}"
        return 6
    val result = validate(mode, framed.unwrap())
    if result.is_err():
        print "protocol qualification response failed: {result.unwrap_err()}"
        return 7
    if result.unwrap() <= 0: return 8
    print "compiled tool protocol: {mode} {result.unwrap()} checks passed"
    0
