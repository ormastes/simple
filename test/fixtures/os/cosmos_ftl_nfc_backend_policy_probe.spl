    cosmos_ftl_nfc_backend_policy_journal_trim_status(0i32, 3u32, 7u64, 2u64, 4u64, 8u64, 9u64)
    cosmos_ftl_nfc_backend_policy_journal_trim_status(0i32, 3u32, 7u64, 2u64, 8u64, 8u64, 7u64)
    cosmos_ftl_nfc_backend_policy_journal_trim_status(0i32, 3u32, 7u64, 2u64, 8u64, 7u64, 8u64)
