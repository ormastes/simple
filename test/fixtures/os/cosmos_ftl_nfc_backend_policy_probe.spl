    cosmos_ftl_nfc_backend_policy_journal_trim_status(0i32, 3u32, 2u64, 2u64, 0u64, 2u64, 2u64)
    cosmos_ftl_nfc_backend_policy_journal_trim_status(0i32, 3u32, 2u64, 2u64, 3u64, 2u64, 2u64)

fn main() -> i64:
    cover_backend_policy()
    print "COSMOS_FTL_NFC_BACKEND_SIMPLE_COVERAGE_PROBE PASS"
    0
