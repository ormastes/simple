    cosmos_ftl_nfc_backend_policy_journal_pages_valid(0u64)
    cosmos_ftl_nfc_backend_policy_checkpoint_data_pages(0u32)
    cosmos_ftl_nfc_backend_policy_checkpoint_data_pages(16349u32)
    cosmos_ftl_nfc_backend_policy_checkpoint_data_pages(0xffffffffu32)
    cosmos_ftl_nfc_backend_policy_checkpoint_slot_pages(256u64, 1024u32)
    cosmos_ftl_nfc_backend_policy_checkpoint_slot_pages(262144u64, 524288u32)
    cosmos_ftl_nfc_backend_policy_checkpoint_slot_pages(0u64, 127u32)
    cosmos_ftl_nfc_backend_policy_checkpoint_slot_pages(897u64, 1024u32)
    cosmos_ftl_nfc_backend_policy_checkpoint_slot_pages(0xffffffffffffffffu64, 1024u32)
    cosmos_ftl_nfc_backend_policy_journal_start_page(0u32)
    cosmos_ftl_nfc_backend_policy_journal_start_page(128u32)
    cosmos_ftl_nfc_backend_policy_layout_valid(128u32, 128u64, 128u32, 2u32, 1024u32)
    cosmos_ftl_nfc_backend_policy_layout_valid(1024u32, 128u64, 128u32, 2u32, 1024u32)
    cosmos_ftl_nfc_backend_policy_layout_valid(1000u32, 128u64, 128u32, 2u32, 1024u32)
    cosmos_ftl_nfc_backend_policy_layout_valid(128u32, 128u64, 1u32, 2u32, 1024u32)

    cosmos_ftl_nfc_backend_policy_journal_page(100u32, 256u64, 0u64)
    cosmos_ftl_nfc_backend_policy_journal_page(100u32, 256u64, 255u64)
    cosmos_ftl_nfc_backend_policy_journal_page(100u32, 256u64, 256u64)
    cosmos_ftl_nfc_backend_policy_journal_page(100u32, 0u64, 1u64)
    cosmos_ftl_nfc_backend_policy_journal_page(100u32, 3u64, 1u64)
    cosmos_ftl_nfc_backend_policy_journal_append_admit(1i32, 3u64, 2u64, 4u64, 3u64)
    cosmos_ftl_nfc_backend_policy_journal_append_admit(0i32, 3u64, 2u64, 4u64, 3u64)
    cosmos_ftl_nfc_backend_policy_journal_append_admit(0i32, 1u64, 2u64, 4u64, 0u64)
    cosmos_ftl_nfc_backend_policy_journal_append_admit(0i32, 6u64, 2u64, 4u64, 0u64)
    cosmos_ftl_nfc_backend_policy_journal_append_admit(0i32, 3u64, 2u64, 4u64, 4u64)
    cosmos_ftl_nfc_backend_policy_journal_append_admit(0i32, 3u64, 2u64, 4u64, 0u64)
    cosmos_ftl_nfc_backend_policy_journal_append_admit(0i32, 3u64, 2u64, 0u64, 0u64)
    cosmos_ftl_nfc_backend_policy_journal_append_admit(0i32, 3u64, 2u64, 3u64, 0u64)
    for status in [0i32, 1i32, 2i32, 3i32, 4i32, 5i32, 6i32]:
        cosmos_ftl_nfc_backend_policy_journal_append_result(status)

    cosmos_ftl_nfc_backend_policy_journal_read_admit(1i32, 3u64, 2u64, 4u64)
    cosmos_ftl_nfc_backend_policy_journal_read_admit(0i32, 1u64, 2u64, 4u64)
    cosmos_ftl_nfc_backend_policy_journal_read_admit(0i32, 6u64, 2u64, 4u64)
    cosmos_ftl_nfc_backend_policy_journal_read_admit(0i32, 3u64, 2u64, 4u64)
    cosmos_ftl_nfc_backend_policy_journal_read_admit(0i32, 3u64, 2u64, 0u64)
    cosmos_ftl_nfc_backend_policy_journal_read_admit(0i32, 3u64, 2u64, 3u64)
    cosmos_ftl_nfc_backend_policy_journal_next_after_read(0xffffffffffffffffu64, 3u64)
    cosmos_ftl_nfc_backend_policy_journal_next_after_read(3u64, 3u64)
    cosmos_ftl_nfc_backend_policy_journal_next_after_read(2u64, 3u64)

    cosmos_ftl_nfc_backend_policy_journal_record_valid(1u64, 1u64, 0x46544c31u32, 7u32, 7u32)
    cosmos_ftl_nfc_backend_policy_journal_record_valid(1u64, 2u64, 0x46544c31u32, 7u32, 7u32)
    cosmos_ftl_nfc_backend_policy_journal_record_valid(1u64, 1u64, 0u32, 7u32, 7u32)
    cosmos_ftl_nfc_backend_policy_journal_record_valid(1u64, 1u64, 0x46544c31u32, 7u32, 8u32)

    cosmos_ftl_nfc_backend_policy_journal_block_fully_dead(256u64, 0u64, 0u32, 0u64)
    cosmos_ftl_nfc_backend_policy_journal_block_fully_dead(128u64, 128u64, 0u32, 128u64)
    cosmos_ftl_nfc_backend_policy_journal_block_fully_dead(256u64, 300u64, 0u32, 384u64)
    cosmos_ftl_nfc_backend_policy_journal_block_fully_dead(256u64, 300u64, 0u32, 383u64)
    cosmos_ftl_nfc_backend_policy_journal_block_fully_dead(1u64, 0xffffffffffffffbfu64, 0u32, 0xffffffffffffffffu64)
    cosmos_ftl_nfc_backend_policy_journal_block_fully_dead(0u64, 0u64, 0u32, 0u64)
    cosmos_ftl_nfc_backend_policy_journal_block_fully_dead(3u64, 0u64, 0u32, 0u64)

    cosmos_ftl_nfc_backend_policy_journal_trim_status(1i32, 3u32, 4u64, 2u64, 4u64, 5u64, 6u64)
