    cosmos_ftl_nfc_backend_policy_payload_length_status(16348u32)
    cosmos_ftl_nfc_backend_policy_payload_length_status(16349u32)

    for status in [0i32, 4i32, 5i32]:
        cosmos_ftl_nfc_backend_policy_read_io_state(status)
    cosmos_ftl_nfc_backend_policy_read_content_state(1u32, 2i32, 0u32, 2i32)
    cosmos_ftl_nfc_backend_policy_read_content_state(0u32, 2i32, 0u32, 0i32)
