fn cover_backend_policy():
    cosmos_ftl_nfc_backend_policy_checkpoint_total_bytes(1u32, 1u32)
    cosmos_ftl_nfc_backend_policy_checkpoint_total_bytes(0xffffffffu32, 0xffffffffu32)

