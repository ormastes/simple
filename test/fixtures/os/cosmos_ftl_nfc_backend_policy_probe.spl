    cosmos_ftl_nfc_backend_policy_superblock_status(4i32, 0u32, 0u64, 0u32, 0u32)
    cosmos_ftl_nfc_backend_policy_superblock_status(1i32, 2u32, 0u64, 40u32, 1u32)
