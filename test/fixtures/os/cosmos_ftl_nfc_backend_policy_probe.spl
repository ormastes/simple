    cosmos_ftl_nfc_backend_policy_mounted_status(1u32, 1u32, 0u32)
    cosmos_ftl_nfc_backend_policy_mounted_status(0u32, 1u32, 0u32)
    cosmos_ftl_nfc_backend_policy_mounted_status(1u32, 0u32, 0u32)
    cosmos_ftl_nfc_backend_policy_mounted_status(1u32, 1u32, 1u32)

    cosmos_ftl_nfc_backend_policy_checkpoint_candidate_better(0u32, 1u64, 9u64, 0u32, 9u32)
    cosmos_ftl_nfc_backend_policy_checkpoint_candidate_better(1u32, 2u64, 1u64, 0u32, 9u32)
    cosmos_ftl_nfc_backend_policy_checkpoint_candidate_better(1u32, 1u64, 2u64, 9u32, 0u32)
    cosmos_ftl_nfc_backend_policy_checkpoint_candidate_better(1u32, 2u64, 2u64, 2u32, 1u32)
    cosmos_ftl_nfc_backend_policy_checkpoint_candidate_better(1u32, 2u64, 2u64, 1u32, 2u32)

    for state in [0i32, 1i32, 2i32, 3i32, 4i32]:
        cosmos_ftl_nfc_backend_policy_page_blank_status(state)
    cosmos_ftl_nfc_backend_policy_recycle_status(2u32, 3u32)
    cosmos_ftl_nfc_backend_policy_recycle_status(0u32, 0u32)
    cosmos_ftl_nfc_backend_policy_recycle_status(0u32, 2u32)
    cosmos_ftl_nfc_backend_policy_recycle_status(1u32, 1u32)

    cosmos_ftl_nfc_backend_policy_next_journal_index(2u64, 3u64)
    cosmos_ftl_nfc_backend_policy_next_journal_index(3u64, 2u64)
    cosmos_ftl_nfc_backend_policy_first_journal_index(1u32, 4u64, 8u64, 9u64)
    cosmos_ftl_nfc_backend_policy_first_journal_index(3u32, 4u64, 8u64, 7u64)
    cosmos_ftl_nfc_backend_policy_first_journal_index(3u32, 4u64, 7u64, 8u64)
    cosmos_ftl_nfc_backend_policy_first_journal_index(3u32, 9u64, 7u64, 8u64)

    cosmos_ftl_nfc_backend_policy_journal_pages_normalized(0u64)
    cosmos_ftl_nfc_backend_policy_journal_pages_normalized(65536u64)
    for pages in [65536u64, 262145u64, 3u64, 64u64, 128u64]:
