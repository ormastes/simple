    for status in [0i32, 3i32, 4i32, 6i32]:
        cosmos_ftl_nfc_backend_policy_write_faults(status)

    cosmos_ftl_nfc_backend_policy_superblock_status(1i32, 1u32, 0u64, 40u32, 1u32)
    cosmos_ftl_nfc_backend_policy_superblock_status(3i32, 0u32, 0u64, 0u32, 0u32)
