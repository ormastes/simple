use os.kernel.arch.arm32.cosmos.cosmos_ftl_policy.{
    cosmos_ftl_policy_crc32_step,
    cosmos_ftl_policy_crc32_begin,
    cosmos_ftl_policy_crc32_u32,
    cosmos_ftl_policy_crc32_u64,
    cosmos_ftl_policy_checkpoint_crc,
    cosmos_ftl_policy_journal_record_crc,
    cosmos_ftl_policy_l2p_crc_step,
    cosmos_ftl_policy_blocks_crc_step,
    cosmos_ftl_policy_ppa_encode,
    cosmos_ftl_policy_ppa_decode_valid,
    cosmos_ftl_policy_ppa_row,
    cosmos_ftl_policy_block_index_from_parts,
    cosmos_ftl_policy_lane_index_from_parts,
    cosmos_ftl_policy_block_parts_from_index,
    cosmos_ftl_policy_block_index_from_ppa,
    cosmos_ftl_policy_clear_tables_value,
    cosmos_ftl_policy_init_valid,
    cosmos_ftl_policy_factory_initialize_erased_valid,
    cosmos_ftl_policy_factory_block_state,
    cosmos_ftl_policy_checkpoint_valid,
    cosmos_ftl_policy_load_checkpoint_status,
    cosmos_ftl_policy_map_apply_actions,
    cosmos_ftl_policy_rebuild_runtime_state_entry,
    cosmos_ftl_policy_allocation_ppa_valid,
    cosmos_ftl_policy_allocation_apply_receipt,
    cosmos_ftl_policy_apply_record_action,
    cosmos_ftl_policy_data_ppa_valid,
    cosmos_ftl_policy_journal_has_space,
    cosmos_ftl_policy_recover_checkpoint_first,
    cosmos_ftl_policy_lookup_status,
    cosmos_ftl_policy_append_record_result,
    cosmos_ftl_policy_allocate_page_action,
    cosmos_ftl_policy_commit_page_admit,
    cosmos_ftl_policy_commit_page_mode,
    cosmos_ftl_policy_refresh_page_status,
    cosmos_ftl_policy_discard_page_action,
    cosmos_ftl_policy_retire_block_action,
    cosmos_ftl_policy_gc_victim_better,
    cosmos_ftl_policy_gc_finish_action,
    cosmos_ftl_policy_gc_step_status,
    cosmos_ftl_policy_flush_action
}

fn emit(id: u32, value: u64):
    print "FTL|{id}|{value}"

fn cover_decisions():
    for bytes in [0u32, 1u32]:
        cosmos_ftl_policy_crc32_begin(bytes)
    for die in [0u32, 63u32, 64u32]:
        for lun in [0u32, 1u32, 2u32]:
            for block in [0u32, 31u32, 32u32, 4095u32, 4183u32, 4184u32]:
                for page in [0u32, 1u32, 127u32, 128u32]:
                    cosmos_ftl_policy_ppa_encode(die, lun, block, page)
    for ppa in [0u32, 0x000fffffu32, 0x00100000u32, 0x08000000u32, 0xffffffffu32]:
        cosmos_ftl_policy_ppa_decode_valid(ppa)
        cosmos_ftl_policy_ppa_row(ppa)
        cosmos_ftl_policy_block_index_from_ppa(ppa)
    for present in [0u32, 1u32]:
        cosmos_ftl_policy_factory_initialize_erased_valid(present)
    cosmos_ftl_policy_init_valid(0u32, 1u32, 1u32, 1u32, 1u32, 2u32, 3u32, 3u32, 0x3ffu32, 1u64)
    cosmos_ftl_policy_init_valid(1u32, 0u32, 1u32, 1u32, 1u32, 2u32, 3u32, 3u32, 0x3ffu32, 1u64)
    cosmos_ftl_policy_init_valid(1u32, 1u32, 0u32, 1u32, 1u32, 2u32, 3u32, 3u32, 0x3ffu32, 1u64)
    cosmos_ftl_policy_init_valid(1u32, 1u32, 1u32, 0u32, 1u32, 2u32, 3u32, 3u32, 0x3ffu32, 1u64)
    cosmos_ftl_policy_init_valid(1u32, 1u32, 1u32, 3u32, 0u32, 2u32, 3u32, 3u32, 0x3ffu32, 1u64)
    cosmos_ftl_policy_init_valid(1u32, 1u32, 1u32, 3u32, 1u32, 2u32, 3u32, 3u32, 0x3ffu32, 1u64)
    cosmos_ftl_policy_init_valid(1u32, 1u32, 1u32, 1u32, 1u32, 2u32, 2u32, 3u32, 0x3ffu32, 1u64)
    cosmos_ftl_policy_init_valid(1u32, 1u32, 1u32, 1u32, 1u32, 2u32, 3u32, 3u32, 0u32, 1u64)
    cosmos_ftl_policy_init_valid(1u32, 1u32, 1u32, 1u32, 1u32, 2u32, 3u32, 3u32, 0x3ffu32, 0u64)
    for block in [0u32, 31u32, 32u32, 4095u32, 4096u32, 4183u32]:
        for bad in [0u32, 1u32]:
            cosmos_ftl_policy_factory_block_state(block, bad)
    for state in [0u32, 1u32, 2u32, 3u32, 4u32, 5u32, 6u32, 7u32]:
        for valid in [0u32, 1u32, 128u32, 129u32]:
            for next in [0u32, 1u32, 127u32, 128u32, 129u32]:
                for bad in [0u32, 1u32]:
                    for block in [0u32, 31u32, 32u32, 4095u32, 4096u32]:
                        cosmos_ftl_policy_rebuild_runtime_state_entry(
                            block, valid, bad, state, next, 0u32, 0u32)
                        cosmos_ftl_policy_rebuild_runtime_state_entry(
                            block, valid, bad, state, next, 1u32, 1u32)
    for mismatch in [0u32, 1u32, 2u32, 3u32, 4u32, 5u32]:
        cosmos_ftl_policy_checkpoint_valid(
            if mismatch == 0u32: 0u32 else: 0x46544c31u32,
            if mismatch == 1u32: 0u32 else: 2u32,
            if mismatch == 2u32: 0u32 else: 1u32, 1u32,
            if mismatch == 3u32: 0u32 else: 1u32, 1u32,
            if mismatch == 4u32: 0u32 else: 1u32, 1u32)
    for mismatch in [0u32, 1u32, 2u32, 3u32, 4u32]:
        cosmos_ftl_policy_load_checkpoint_status(
            if mismatch == 0u32: 4u32 else: 0u32,
            if mismatch == 1u32: 0u32 else: 1u32, 1u32,
            if mismatch == 2u32: 0u32 else: 1u32, 1u32,
            if mismatch == 3u32: 128u32 else: 0u32)
    for old_ppa in [1u32, 0xffffffffu32]:
        for old_valid in [0u32, 1u32]:
            for pages in [0u32, 1u32]:
                for new_valid in [0u32, 1u32]:
                    cosmos_ftl_policy_map_apply_actions(
                        old_ppa, old_valid, pages, new_valid)
    for ppa_valid in [0u32, 1u32]:
        for block in [0u32, 31u32, 32u32, 4095u32, 4096u32]:
            for page in [0u32, 1u32, 127u32]:
                for state in [0u32, 2u32, 3u32]:
                    cosmos_ftl_policy_allocation_ppa_valid(
                        ppa_valid, block, page, 0u32, state, 0xffffu32)
                    cosmos_ftl_policy_allocation_ppa_valid(
                        ppa_valid, block, page, 1u32, state, block)
    for record_type in [0u32, 1u32, 2u32, 3u32, 4u32, 5u32, 6u32, 7u32, 8u32, 9u32]:
        cosmos_ftl_policy_apply_record_action(record_type, 0u32, 1u32, 0u32, 1u32)
        cosmos_ftl_policy_apply_record_action(record_type, 1u32, 1u32, 1u32, 1u32)
    for result in [0u32, 1u32, 2u32, 3u32]:
        cosmos_ftl_policy_append_record_result(0u64, 0u64, 1u64, result)
    cosmos_ftl_policy_append_record_result(0xffffffffffffffffu64, 0u64, 1u64, 0u32)
    cosmos_ftl_policy_append_record_result(0u64, 1u64, 1u64, 0u32)
    cosmos_ftl_policy_append_record_result(1u64, 0u64, 1u64, 0u32)
    for state in [0u32, 2u32, 3u32, 4u32, 5u32, 6u32]:
        for count in [0u32, 1u32, 409u32, 410u32]:
            cosmos_ftl_policy_allocate_page_action(
                0u32, 1u32, state, 0u32, 0u32, 0u32, count, 0u32, 0u32)
            cosmos_ftl_policy_allocate_page_action(
                1u32, 1u32, state, 127u32, 1u32, 1u32, count, 1u32, 0u32)
    cosmos_ftl_policy_allocate_page_action(
        0u32, 1u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 1u32)
    cosmos_ftl_policy_allocate_page_action(
        0u32, 1u32, 0u32, 0u32, 0u32, 0u32, 409u32, 0u32, 1u32)
    cosmos_ftl_policy_allocate_page_action(
        0u32, 1u32, 0u32, 0u32, 0u32, 0u32, 410u32, 0u32, 1u32)
    cosmos_ftl_policy_allocate_page_action(
        0u32, 1u32, 0u32, 0u32, 0u32, 0u32, 1u32, 1u32, 1u32)
    for state in [0u32, 1u32, 2u32, 3u32, 4u32, 5u32, 6u32]:
        cosmos_ftl_policy_retire_block_action(1u32, 1u32, 1u32, state, 0u32, 1u32)
        cosmos_ftl_policy_retire_block_action(1u32, 1u32, 1u32, state, 1u32, 1u32)
        cosmos_ftl_policy_gc_victim_better(state, 0u32, 0u32, 0u32, 128u32, 0u32)
        cosmos_ftl_policy_gc_victim_better(state, 127u32, 2u32, 1u32, 127u32, 3u32)
    for records in [0u64, 1u64, 2u64, 5u64]:
        cosmos_ftl_policy_journal_has_space(3u64, 1u64, 4u64, records)
    cosmos_ftl_policy_journal_has_space(0u64, 1u64, 4u64, 1u64)
    cosmos_ftl_policy_journal_has_space(0xffffffffffffffffu64, 0u64, 4u64, 1u64)
    for valid0 in [0u32, 1u32]:
        for valid1 in [0u32, 1u32]:
            cosmos_ftl_policy_recover_checkpoint_first(valid0, valid1, 1u64, 2u64, 3u64, 4u64)
            cosmos_ftl_policy_recover_checkpoint_first(valid0, valid1, 2u64, 2u64, 4u64, 3u64)
    for flag in [0u32, 1u32]:
        cosmos_ftl_policy_lookup_status(flag, 1u32, 1u32, 0u32, 1u32, 1u32, 1u32, 0u32)
        cosmos_ftl_policy_lookup_status(1u32, flag, 1u32, 0u32, 1u32, 1u32, 1u32, 0u32)
        cosmos_ftl_policy_lookup_status(1u32, 1u32, flag, 0u32, 1u32, 1u32, 1u32, 0u32)
        cosmos_ftl_policy_lookup_status(1u32, 1u32, 1u32, flag, 1u32, if flag == 0u32: 0xffffffffu32 else: 1u32, flag, flag)
    for flag in [0u32, 1u32]:
        cosmos_ftl_policy_commit_page_admit(flag, 1u32, 1u32, 0u32, 0u32, 1u32, 0u64, 1u32, 0xffffffffu32, 1u32)
        cosmos_ftl_policy_commit_page_admit(1u32, flag, 1u32, 0u32, 0u32, 1u32, 0u64, 1u32, 0xffffffffu32, 1u32)
        cosmos_ftl_policy_commit_page_admit(1u32, 1u32, flag, 0u32, 0u32, 1u32, 0u64, 1u32, 0xffffffffu32, 1u32)
        cosmos_ftl_policy_commit_page_admit(1u32, 1u32, 1u32, 1u32 - flag, flag, 1u32, if flag == 0u32: 0xffffffffffffffffu64 else: 0u64, flag, 1u32, flag)
        cosmos_ftl_policy_commit_page_mode(if flag == 0u32: 0xffffffffu32 else: 1u32)
        cosmos_ftl_policy_refresh_page_status(if flag == 0u32: 1u32 else: 0u32, flag, 1u32)
        cosmos_ftl_policy_discard_page_action(flag, 1u32, 0u32, 0u32, 1u32, 0u64, 1u32, 1u32)
        cosmos_ftl_policy_discard_page_action(1u32, flag, 0u32, 0u32, 1u32, 0u64, if flag == 0u32: 0xffffffffu32 else: 1u32, flag)
        cosmos_ftl_policy_gc_finish_action(if flag == 0u32: 5u32 else: 3u32, flag)
        cosmos_ftl_policy_flush_action(flag, 1u32, 0u32, 3u32)
        cosmos_ftl_policy_flush_action(1u32, flag, 1u32 - flag, if flag == 0u32: 0u32 else: 3u32)
    cosmos_ftl_policy_gc_step_status(0u32, 1u32, 0u32, 1u32, 0u32, 0u32)
    cosmos_ftl_policy_gc_step_status(1u32, 0u32, 0u32, 1u32, 0u32, 0u32)
    cosmos_ftl_policy_gc_step_status(1u32, 1u32, 1u32, 1u32, 0u32, 0u32)
    cosmos_ftl_policy_gc_step_status(1u32, 1u32, 0u32, 0u32, 0u32, 0u32)
    cosmos_ftl_policy_gc_step_status(1u32, 1u32, 0u32, 1u32, 0u32, 1u32)
    cosmos_ftl_policy_gc_step_status(1u32, 1u32, 0u32, 1u32, 1u32, 1u32)

fn main() -> i64:
    emit(1u32, cosmos_ftl_policy_crc32_step(0xffffffffu32, 0x5au32) as u64)
    emit(2u32, cosmos_ftl_policy_crc32_begin(4u32) as u64)
    emit(3u32, cosmos_ftl_policy_crc32_u32(0xffffffffu32, 0x12345678u32) as u64)
    emit(4u32, cosmos_ftl_policy_crc32_u64(0xffffffffu32, 0x0123456789abcdefu64) as u64)
    # The Rust bootstrap seed sign-extends these two high-bit u32 values while
    # widening for printing.  Mask after the diagnostic-only widening so the
    # textual oracle compares the actual 32-bit C ABI value.
    emit(5u32, (cosmos_ftl_policy_checkpoint_crc(0x46544c31u32, 2u32, 3u64, 4u64, 5u32, 6u32, 7u32, 8u32, 9u32, 10u32) as u64) & 0xffffffffu64)
    emit(6u32, (cosmos_ftl_policy_journal_record_crc(0x46544c31u32, 2u32, 3u64, 4u64, 5u32, 6u32, 7u32, 8u32, 9u32) as u64) & 0xffffffffu64)
    emit(7u32, cosmos_ftl_policy_l2p_crc_step(1u32, 2u32) as u64)
    emit(8u32, cosmos_ftl_policy_blocks_crc_step(1u32, 2u32, 3u32, 0u32, 2u32, 4u32, 0u32) as u64)
    emit(9u32, cosmos_ftl_policy_ppa_encode(63u32, 1u32, 4183u32, 127u32))
    emit(10u32, cosmos_ftl_policy_ppa_decode_valid(0x07ffffffu32) as u64)
    emit(11u32, cosmos_ftl_policy_ppa_row(0x00100001u32))
    emit(12u32, cosmos_ftl_policy_block_index_from_parts(3u32, 1u32, 32u32) as u64)
    emit(13u32, cosmos_ftl_policy_lane_index_from_parts(3u32, 1u32) as u64)
    emit(14u32, cosmos_ftl_policy_block_parts_from_index(4184u32))
    emit(15u32, cosmos_ftl_policy_block_index_from_ppa(0x00100000u32))
    emit(16u32, cosmos_ftl_policy_clear_tables_value(0u32))
    emit(17u32, cosmos_ftl_policy_init_valid(1u32, 1u32, 1u32, 1u32, 1u32, 2u32, 3u32, 3u32, 0x3ffu32, 1u64) as u64)
    emit(18u32, cosmos_ftl_policy_factory_initialize_erased_valid(1u32) as u64)
    emit(19u32, cosmos_ftl_policy_factory_block_state(32u32, 0u32) as u64)
    emit(20u32, cosmos_ftl_policy_checkpoint_valid(0x46544c31u32, 2u32, 1u32, 1u32, 2u32, 2u32, 3u32, 3u32) as u64)
    emit(21u32, cosmos_ftl_policy_load_checkpoint_status(0u32, 1u32, 1u32, 2u32, 2u32, 0u32) as u64)
    emit(22u32, cosmos_ftl_policy_map_apply_actions(1u32, 1u32, 1u32, 1u32) as u64)
    emit(23u32, cosmos_ftl_policy_rebuild_runtime_state_entry(32u32, 1u32, 0u32, 2u32, 1u32, 0u32, 0u32) as u64)
    emit(24u32, cosmos_ftl_policy_allocation_ppa_valid(1u32, 32u32, 0u32, 0u32, 0u32, 0xffffu32) as u64)
    emit(25u32, cosmos_ftl_policy_allocation_apply_receipt(0u32, 0u32, 32u32, 0u32))
    emit(26u32, cosmos_ftl_policy_apply_record_action(2u32, 0u32, 1u32, 0u32, 1u32) as u64)
    emit(27u32, cosmos_ftl_policy_data_ppa_valid(1u32, 32u32, 1u32, 0u32) as u64)
    emit(28u32, cosmos_ftl_policy_journal_has_space(1u64, 0u64, 4u64, 1u64) as u64)
    emit(29u32, cosmos_ftl_policy_recover_checkpoint_first(1u32, 1u32, 1u64, 2u64, 3u64, 4u64) as u64)
    emit(30u32, cosmos_ftl_policy_lookup_status(1u32, 1u32, 1u32, 0u32, 1u32, 2u32, 1u32, 0u32) as u64)
    emit(31u32, cosmos_ftl_policy_append_record_result(0u64, 0u64, 4u64, 0u32) as u64)
    emit(32u32, cosmos_ftl_policy_allocate_page_action(0u32, 0xffffffffu32, 0u32, 0u32, 0u32, 0u32, 409u32, 0u32, 1u32) as u64)
    emit(33u32, cosmos_ftl_policy_commit_page_admit(1u32, 1u32, 1u32, 0u32, 0u32, 1u32, 0u64, 1u32, 0xffffffffu32, 1u32) as u64)
    emit(34u32, cosmos_ftl_policy_commit_page_mode(0xffffffffu32) as u64)
    emit(35u32, cosmos_ftl_policy_refresh_page_status(0u32, 1u32, 1u32) as u64)
    emit(36u32, cosmos_ftl_policy_discard_page_action(1u32, 1u32, 0u32, 0u32, 1u32, 0u64, 1u32, 1u32) as u64)
    emit(37u32, cosmos_ftl_policy_retire_block_action(1u32, 1u32, 1u32, 3u32, 0u32, 1u32) as u64)
    emit(38u32, cosmos_ftl_policy_gc_victim_better(3u32, 1u32, 2u32, 1u32, 2u32, 3u32) as u64)
    emit(39u32, cosmos_ftl_policy_gc_finish_action(5u32, 1u32) as u64)
    emit(40u32, cosmos_ftl_policy_gc_step_status(1u32, 1u32, 0u32, 1u32, 0u32, 0u32) as u64)
    emit(41u32, cosmos_ftl_policy_flush_action(1u32, 1u32, 0u32, 3u32) as u64)
    var scan_410 = cosmos_ftl_policy_allocate_page_action(
        0u32, 1u32, 0u32, 0u32, 0u32, 0u32, 410u32, 0u32, 0u32)
    var final_409 = cosmos_ftl_policy_allocate_page_action(
        0u32, 1u32, 0u32, 0u32, 0u32, 0u32, 409u32, 0u32, 1u32)
    var final_410 = cosmos_ftl_policy_allocate_page_action(
        0u32, 1u32, 0u32, 0u32, 0u32, 0u32, 410u32, 0u32, 1u32)
    var gc_final_409 = cosmos_ftl_policy_allocate_page_action(
        0u32, 1u32, 0u32, 0u32, 0u32, 0u32, 409u32, 1u32, 1u32)
    print "FTL-ALLOC|scan-410|{scan_410}"
    print "FTL-ALLOC|final-409|{final_409}"
    print "FTL-ALLOC|final-410|{final_410}"
    print "FTL-ALLOC|gc-final-409|{gc_final_409}"
    cover_decisions()
    0
