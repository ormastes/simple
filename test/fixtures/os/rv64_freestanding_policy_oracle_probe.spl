use os.kernel.arch.riscv64.freestanding_policy.{
    rv64_read_be16,
    rv64_read_be32,
    rv64_write_be16,
    rv64_write_be32,
    rv64_checksum_add,
    rv64_checksum_finish,
    rv64_pci_is_virtio_net,
    rv64_pci_is_virtio_gpu,
    rv64_pci_is_virtio_blk,
    rv64_pci_is_virtio_input,
    rv64_write_le32,
    rv64_write_le64,
    rv64_read_le32
}

extern fn rt_alloc(size: i64) -> i64
extern fn rt_free(ptr: i64) -> i64
extern fn rt_volatile_read_u8(addr: u64) -> u64
extern fn rt_volatile_write_u8(addr: u64, value: u64)
extern fn rt_coverage_clear()
extern fn rt_coverage_dump_sdn() -> text

fn _rotate_left(value: u64, shift: u64) -> u64:
    (value << shift) | (value >> (64 - shift))

fn _mix1(hash: u64, value: u64, index: u64) -> u64:
    (hash ^ value ^ index) * 1099511628211u64

fn _mix2(hash: u64, value: u64, index: u64) -> u64:
    (hash + _rotate_left(value, 31) + index * 0x9e3779b97f4a7c15u64) *
        14029467366897019727u64

fn _emit(case_id: text, count: u64, hash1: u64, hash2: u64):
    print "{case_id} count={count} hash1={hash1} hash2={hash2}"

fn _read_byte(addr: u64) -> u64:
    rt_volatile_read_u8(addr) & 0xff

fn _write_byte(addr: u64, value: u64):
    rt_volatile_write_u8(addr, value & 0xff)

fn main():
    rt_coverage_clear()
    val raw = rt_alloc(128) as u64
    if raw == 0:
        print "allocation status=FAIL"
        return

    var total_cases: u64 = 0
    var count: u64 = 0
    var hash1: u64 = 0x243f6a8885a308d3
    var hash2: u64 = 0x13198a2e03707344
    var a: u64 = 0
    while a < 256:
        var b: u64 = 0
        while b < 256:
            _write_byte(raw, a)
            _write_byte(raw + 1, b)
            val observed = rv64_read_be16(raw) as u64
            hash1 = _mix1(hash1, observed, count)
            hash2 = _mix2(hash2, observed, count)
            count = count + 1
            b = b + 1
        a = a + 1
    _emit("be16-read-exhaustive", count, hash1, hash2)
    total_cases = total_cases + count

    count = 0
    hash1 = 0x243f6a8885a308d3
    hash2 = 0x13198a2e03707344
    var value16: u64 = 0
    while value16 < 65536:
        rv64_write_be16(raw, value16 as u16)
        val observed = (_read_byte(raw) << 8) | _read_byte(raw + 1)
        hash1 = _mix1(hash1, observed, count)
        hash2 = _mix2(hash2, observed, count)
        count = count + 1
        value16 = value16 + 1
    _emit("be16-write-exhaustive", count, hash1, hash2)
    total_cases = total_cases + count

    count = 0
    hash1 = 0x243f6a8885a308d3
    hash2 = 0x13198a2e03707344
    var index32: u64 = 0
    while index32 < 65536:
        _write_byte(raw, index32 >> 8)
        _write_byte(raw + 1, index32)
        _write_byte(raw + 2, (~index32) >> 8)
        _write_byte(raw + 3, ~index32)
        val observed = rv64_read_be32(raw) as u64
        hash1 = _mix1(hash1, observed, count)
        hash2 = _mix2(hash2, observed, count)
        count = count + 1
        index32 = index32 + 1
    _emit("be32-read-grid", count, hash1, hash2)
    total_cases = total_cases + count

    count = 0
    hash1 = 0x243f6a8885a308d3
    hash2 = 0x13198a2e03707344
    index32 = 0
    while index32 < 65536:
        val word = ((index32 as u32) * 0x00010001) ^ 0xa5a55a5a
        rv64_write_be32(raw, word)
        val observed = (_read_byte(raw) << 24) |
            (_read_byte(raw + 1) << 16) |
            (_read_byte(raw + 2) << 8) |
            _read_byte(raw + 3)
        hash1 = _mix1(hash1, observed, count)
        hash2 = _mix2(hash2, observed, count)
        count = count + 1
        index32 = index32 + 1
    _emit("be32-write-grid", count, hash1, hash2)
    total_cases = total_cases + count

    count = 0
    hash1 = 0x243f6a8885a308d3
    hash2 = 0x13198a2e03707344
    index32 = 0
    while index32 < 65536:
        val word = ((index32 as u32) * 0x00010001) ^ 0x5aa5a55a
        rv64_write_le32(raw, word)
        val bytes = _read_byte(raw) |
            (_read_byte(raw + 1) << 8) |
            (_read_byte(raw + 2) << 16) |
            (_read_byte(raw + 3) << 24)
        val round_trip = rv64_read_le32(raw) as u64
        val observed = bytes ^ _rotate_left(round_trip, 11)
        hash1 = _mix1(hash1, observed, count)
        hash2 = _mix2(hash2, observed, count)
        count = count + 1
        index32 = index32 + 1
    _emit("le32-write-read-grid", count, hash1, hash2)
    total_cases = total_cases + count

    count = 0
    hash1 = 0x243f6a8885a308d3
    hash2 = 0x13198a2e03707344
    var index64: u64 = 0
    while index64 < 65536:
        val word = (index64 << 48) | (index64 << 16) | ((~index64) & 0xffff)
        rv64_write_le64(raw, word)
        var observed: u64 = 0
        var byte_index: u64 = 0
        while byte_index < 8:
            observed = observed | (_read_byte(raw + byte_index) << (byte_index * 8))
            byte_index = byte_index + 1
        hash1 = _mix1(hash1, observed, count)
        hash2 = _mix2(hash2, observed, count)
        count = count + 1
        index64 = index64 + 1
    _emit("le64-write-grid", count, hash1, hash2)
    total_cases = total_cases + count

    val checksum_seeds: [u32] = [0, 1, 0xffff, 0x10000, 0xffff0000, 0x7fffffff, 0x80000000, 0xffffffff]
    count = 0
    hash1 = 0x243f6a8885a308d3
    hash2 = 0x13198a2e03707344
    var pattern: u64 = 0
    while pattern < 4:
        var fill_index: u64 = 0
        while fill_index < 66:
            _write_byte(raw + fill_index, fill_index * 17 + pattern * 29)
            fill_index = fill_index + 1
        var seed_index: u64 = 0
        while seed_index < checksum_seeds.len():
            var len: u64 = 0
            while len < 66:
                val sum = rv64_checksum_add(checksum_seeds[seed_index], raw, len)
                val observed = ((sum as u64) << 16) | (rv64_checksum_finish(sum) as u64)
                hash1 = _mix1(hash1, observed, count)
                hash2 = _mix2(hash2, observed, count)
                count = count + 1
                len = len + 1
            seed_index = seed_index + 1
        pattern = pattern + 1
    _emit("checksum-grid", count, hash1, hash2)
    total_cases = total_cases + count

    count = 0
    hash1 = 0x243f6a8885a308d3
    hash2 = 0x13198a2e03707344
    var finish_index: u64 = 0
    while finish_index < 65536:
        val sum = ((finish_index as u32) << 16) | (((~finish_index) & 0xffff) as u32)
        val observed = rv64_checksum_finish(sum) as u64
        hash1 = _mix1(hash1, observed, count)
        hash2 = _mix2(hash2, observed, count)
        count = count + 1
        finish_index = finish_index + 1
    _emit("checksum-finish-grid", count, hash1, hash2)
    total_cases = total_cases + count

    val classes: [i64] = [1, 2, 3]
    val subclasses: [i64] = [-1, 0, 1]
    val vendors: [i64] = [0x1af3, 0x1af4, 0x1af5]
    val devices: [i64] = [
        0x0fff, 0x1000, 0x1001, 0x100f, 0x1010, 0x1011, 0x1012,
        0x1013, 0x1040, 0x1041, 0x1042, 0x1043, 0x104f, 0x1050,
        0x1051, 0x1052, 0x1053
    ]
    count = 0
    hash1 = 0x243f6a8885a308d3
    hash2 = 0x13198a2e03707344
    var class_index: u64 = 0
    while class_index < classes.len():
        var subclass_index: u64 = 0
        while subclass_index < subclasses.len():
            var vendor_index: u64 = 0
            while vendor_index < vendors.len():
                var device_index: u64 = 0
                while device_index < devices.len():
                    val net = rv64_pci_is_virtio_net(
                        classes[class_index], subclasses[subclass_index],
                        vendors[vendor_index], devices[device_index]
                    )
                    val gpu = rv64_pci_is_virtio_gpu(
                        classes[class_index], subclasses[subclass_index],
                        vendors[vendor_index], devices[device_index]
                    )
                    val observed = (net as u64) | ((gpu as u64) << 1)
                    hash1 = _mix1(hash1, observed, count)
                    hash2 = _mix2(hash2, observed, count)
                    count = count + 1
                    device_index = device_index + 1
                vendor_index = vendor_index + 1
            subclass_index = subclass_index + 1
        class_index = class_index + 1
    _emit("virtio-net-gpu-grid", count, hash1, hash2)
    total_cases = total_cases + count

    count = 0
    hash1 = 0x243f6a8885a308d3
    hash2 = 0x13198a2e03707344
    var vendor_index: u64 = 0
    while vendor_index < vendors.len():
        var device_index: u64 = 0
        while device_index < devices.len():
            val blk = rv64_pci_is_virtio_blk(vendors[vendor_index], devices[device_index])
            val input = rv64_pci_is_virtio_input(vendors[vendor_index], devices[device_index])
            val observed = (blk as u64) | ((input as u64) << 1)
            hash1 = _mix1(hash1, observed, count)
            hash2 = _mix2(hash2, observed, count)
            count = count + 1
            device_index = device_index + 1
        vendor_index = vendor_index + 1
    _emit("virtio-blk-input-grid", count, hash1, hash2)
    total_cases = total_cases + count

    rt_free(raw as i64)
    print "rv64-freestanding-policy oracle_cases={total_cases} decision_outcomes=34"
    print "RV64_FREESTANDING_POLICY_COVERAGE_BEGIN"
    print rt_coverage_dump_sdn()
