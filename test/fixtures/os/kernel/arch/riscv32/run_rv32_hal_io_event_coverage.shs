#!/bin/sh
# Reusable C-oracle event + branch/MC/DC coverage producer for the exact RV32
# HAL migration denominator. It does not inspect the retained shared runtime.
set -eu

repo_root=$(git rev-parse --show-toplevel)
fixture_root="$repo_root/test/fixtures/os/kernel/arch/riscv32"
artifact_root="$repo_root/build/test-artifacts/rv32-hal-io-event"
mkdir -p "$artifact_root"

resolve_tool() {
    for candidate in "$@"; do
        if command -v "$candidate" >/dev/null 2>&1; then
            command -v "$candidate"
            return 0
        fi
    done
    return 1
}

clang_tool=${RV32_HAL_CLANG:-$(resolve_tool clang-20 clang)}
profdata_tool=${RV32_HAL_LLVM_PROFDATA:-$(resolve_tool llvm-profdata-20 llvm-profdata)}
cov_tool=${RV32_HAL_LLVM_COV:-$(resolve_tool llvm-cov-20 llvm-cov)}

"$clang_tool" -O0 -fprofile-instr-generate -fcoverage-mapping \
    -fcoverage-mcdc -c "$fixture_root/rv32_hal_io_event_ref.c" \
    -o "$artifact_root/ref.o"
"$clang_tool" -O0 -c "$fixture_root/rv32_hal_io_event_driver.c" \
    -o "$artifact_root/driver.o"
"$clang_tool" -fprofile-instr-generate "$artifact_root/ref.o" \
    "$artifact_root/driver.o" -o "$artifact_root/rv32_hal_io_event_ref"

LLVM_PROFILE_FILE="$artifact_root/ref.profraw" \
    "$artifact_root/rv32_hal_io_event_ref"
"$profdata_tool" merge -sparse "$artifact_root/ref.profraw" \
    -o "$artifact_root/ref.profdata"

"$cov_tool" report --show-mcdc-summary \
    "$artifact_root/rv32_hal_io_event_ref" \
    -instr-profile="$artifact_root/ref.profdata" \
    "$fixture_root/rv32_hal_io_event_ref.c" \
    | awk '$1 == "TOTAL" {
        branch_total = $(NF - 5)
        branch_missed = $(NF - 4)
        mcdc_total = $(NF - 2)
        mcdc_missed = $(NF - 1)
        printf "coverage|scope=test-only-c-oracle|branches=%d/%d|mcdc_conditions=%d/%d\n", \
            branch_total - branch_missed, branch_total, \
            mcdc_total - mcdc_missed, mcdc_total
    }'
