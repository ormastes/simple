# Driver fragment appended to the production RV32 SMP policy before the
# canonical MC/DC instrumenter runs.  The three vectors independently prove
# both conditions of A && B affect the decision outcome (TT, FT, TF).

fn main():
    hal_rv32_smp_should_wait(2, 10, 3, 100)
    hal_rv32_smp_should_wait(3, 10, 3, 100)
    hal_rv32_smp_should_wait(2, 100, 3, 100)

main()
