# Append this driver to the production smp_policy.spl before running the
# canonical Simple MC/DC instrumenter.  TT, FT, and TF independently establish
# both conditions of A && B; no fourth vector is needed for unique-cause MC/DC.

fn main():
    hal_rv32_smp_should_wait(2, 10, 3, 100)
    hal_rv32_smp_should_wait(3, 10, 3, 100)
    hal_rv32_smp_should_wait(2, 100, 3, 100)

main()
