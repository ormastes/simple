use os.kernel.log.klog_api.{log_set_targets}
use os.services.wm.wm_world.{WmWorld}

fn main() -> i32:
    log_set_targets(0)
    var world = WmWorld.new()
    world.spawn_window(101, 7001, 900, "calc")
    world.spawn_window(102, 7002, 901, "clock")
    world.spawn_window(103, 7001, 902, "hello")
    if world.len() != 3:
        return 1
    if not world.despawn_window(102):
        return 2
    world.spawn_window(104, 7004, 904, "files")
    if world.find_entity_for_window(104).id != 257:
        return 3
    if world.find_owner_port(104) != 7004:
        return 4
    if world.app_id_for_window(104) != "files":
        return 5
    0
