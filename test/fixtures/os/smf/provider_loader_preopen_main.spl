use std.sys.{get_args}
use test.fixtures.os.smf.provider_loader_preopen_support.{run_preopen_case}

fn main() -> i32:
    val args = get_args()
    if args.len() != 3:
        print "FAIL: expected exactly one case and one fresh fixture root argument"
        return 2
    val case_name = args[args.len() - 2]
    val fixture_root = args[args.len() - 1]
    if not run_preopen_case(case_name, fixture_root):
        print "FAIL: provider pre-open case {case_name}"
        return 1
    print "PROVIDER_PREOPEN_CASE_PASS case={case_name}"
    0
