use os.kernel.arch.riscv32.boot_layout.{
    rv32_boot_layout_valid,
    rv32_boot_layout_total_pages,
    rv32_direct_ram_base,
    rv32_direct_ram_size,
    rv32_direct_reserved_end,
    rv32_direct_heap_start,
    rv32_direct_heap_size
}

fn observe(ram_base: u64, ram_size: u64, reserved_end: u64, heap_start: u64, heap_size: u64) -> u64:
    val valid = rv32_boot_layout_valid(ram_base, ram_size, reserved_end, heap_start, heap_size)
    val pages = rv32_boot_layout_total_pages(ram_base, ram_size, reserved_end, heap_start, heap_size)
    if valid: pages + 1 else: pages

fn main():
    val base = rv32_direct_ram_base()
    val size = rv32_direct_ram_size()
    val reserved = rv32_direct_reserved_end()
    val heap = rv32_direct_heap_start()
    val heap_size = rv32_direct_heap_size()
    var checksum: u64 = 0
    checksum = checksum + observe(base, size, reserved, heap, heap_size)
    checksum = checksum + observe(base, 4096, reserved, heap, heap_size)
    checksum = checksum + observe(base, size, base, heap, heap_size)
    checksum = checksum + observe(base, size, reserved, reserved, heap_size)
    checksum = checksum + observe(base, size, reserved, heap, 7)
    checksum = checksum + observe(0xFFFFFFFFFFFFF000, 8192, reserved, heap, heap_size)
    checksum = checksum + observe(base, size, reserved, 0xFFFFFFFFFFFFFFF8, 16)
    checksum = checksum + observe(base, size, reserved, 0x87FFF000, 8192)
    checksum = checksum + observe(base, size, 0x86FFFFFF, 0x87000000, heap_size)
    print "rv32_boot_layout_checksum={checksum}"
