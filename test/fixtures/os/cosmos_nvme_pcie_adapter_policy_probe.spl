use os.kernel.arch.arm32.cosmos.cosmos_nvme_pcie_adapter_policy.{
    cosmos_nvme_pcie_adapter_policy_capacity_valid,
    cosmos_nvme_pcie_adapter_policy_block_bytes_valid,
    cosmos_nvme_pcie_adapter_policy_common_fields_supported,
    cosmos_nvme_pcie_adapter_policy_rw_fields_supported,
    cosmos_nvme_pcie_adapter_policy_flush_fields_supported,
    cosmos_nvme_pcie_adapter_policy_transfer_bytes,
    cosmos_nvme_pcie_adapter_policy_prp_span_valid,
    cosmos_nvme_pcie_adapter_policy_prp_first_bytes,
    cosmos_nvme_pcie_adapter_policy_io_kind,
    cosmos_nvme_pcie_adapter_policy_rw_decode_valid,
    cosmos_nvme_pcie_adapter_policy_write_zeroes_fields_supported,
    cosmos_nvme_pcie_adapter_policy_write_zeroes_decode_valid,
    cosmos_nvme_pcie_adapter_policy_dsm_fields_supported,
    cosmos_nvme_pcie_adapter_policy_dsm_decode_valid,
    cosmos_nvme_pcie_adapter_policy_flush_decode_valid,
    cosmos_nvme_pcie_adapter_policy_io_invalid_field,
    cosmos_nvme_pcie_adapter_policy_admin_common_fields_supported,
    cosmos_nvme_pcie_adapter_policy_admin_kind,
    cosmos_nvme_pcie_adapter_policy_admin_payload_bytes,
    cosmos_nvme_pcie_adapter_policy_admin_transfer_valid,
    cosmos_nvme_pcie_adapter_policy_admin_invalid_field,
    cosmos_nvme_pcie_adapter_policy_post_result,
    cosmos_nvme_pcie_adapter_policy_admin_payload_request_valid,
    cosmos_nvme_pcie_adapter_policy_admin_payload_result,
    cosmos_nvme_pcie_adapter_policy_init_values_valid
}

fn exercise_policy():
    for word in [
        0u32, 1u32, 2u32, 3u32, 4u32, 5u32, 6u32, 7u32, 8u32,
        9u32, 15u32, 512u32, 768u32, 0xC0000000u32, 0xFFFFFFFFu32
    ]:
        cosmos_nvme_pcie_adapter_policy_block_bytes_valid(word)
        cosmos_nvme_pcie_adapter_policy_common_fields_supported(
            word, word, word, word, word)
        cosmos_nvme_pcie_adapter_policy_rw_fields_supported(
            word, word, word, word)
        cosmos_nvme_pcie_adapter_policy_flush_fields_supported(
            word, word, word, word, word, word, word, word, word, word)
        cosmos_nvme_pcie_adapter_policy_io_kind(word)
        cosmos_nvme_pcie_adapter_policy_admin_kind(word)
        cosmos_nvme_pcie_adapter_policy_admin_payload_bytes(word & 3u32, word)

    cosmos_nvme_pcie_adapter_policy_capacity_valid(0u32, 0u32)
    cosmos_nvme_pcie_adapter_policy_capacity_valid(0u32, 1u32)
    cosmos_nvme_pcie_adapter_policy_transfer_bytes(0xFFFFFFFFu32, 512u32)
    cosmos_nvme_pcie_adapter_policy_transfer_bytes(0u32, 0u32)
    cosmos_nvme_pcie_adapter_policy_transfer_bytes(1u32, 0xFFFFFFFFu32)
    cosmos_nvme_pcie_adapter_policy_transfer_bytes(1u32, 512u32)
    cosmos_nvme_pcie_adapter_policy_prp_first_bytes(0x1000u32, 4u32)
    cosmos_nvme_pcie_adapter_policy_prp_first_bytes(0x1000u32, 4096u32)

    cosmos_nvme_pcie_adapter_policy_prp_span_valid(
        0u32, 0u32, 0u32, 0u32, 4u32)
    cosmos_nvme_pcie_adapter_policy_prp_span_valid(
        0x1000u32, 0u32, 0u32, 0u32, 4u32)
    cosmos_nvme_pcie_adapter_policy_prp_span_valid(
        0x1000u32, 0u32, 0x2000u32, 0u32, 4u32)
    cosmos_nvme_pcie_adapter_policy_prp_span_valid(
        0x1FF0u32, 0u32, 0u32, 0u32, 32u32)
    cosmos_nvme_pcie_adapter_policy_prp_span_valid(
        0x1FF0u32, 0u32, 0x3000u32, 0u32, 32u32)
    cosmos_nvme_pcie_adapter_policy_prp_span_valid(
        0x1FF0u32, 0u32, 0x3004u32, 0u32, 32u32)
    cosmos_nvme_pcie_adapter_policy_prp_span_valid(
        0x1FF0u32, 0u32, 0x3010u32, 0u32, 8192u32)
    cosmos_nvme_pcie_adapter_policy_prp_span_valid(
        0x1FF0u32, 0u32, 0x3004u32, 0u32, 8192u32)
    cosmos_nvme_pcie_adapter_policy_prp_span_valid(
        0x1000u32, 16u32, 0u32, 0u32, 4u32)
    cosmos_nvme_pcie_adapter_policy_prp_span_valid(
        0x1004u32, 0u32, 0u32, 0u32, 4u32)
    cosmos_nvme_pcie_adapter_policy_prp_span_valid(
        0x1000u32, 0u32, 0u32, 0u32, 0u32)
    cosmos_nvme_pcie_adapter_policy_prp_span_valid(
        0x1000u32, 0u32, 0u32, 0u32, 1048577u32)

    for a in [0u32, 1u32]:
        for b in [0u32, 1u32]:
            for c in [0u32, 1u32]:
                for d in [0u32, 1u32]:
                    cosmos_nvme_pcie_adapter_policy_rw_decode_valid(a, b, c, d)
                cosmos_nvme_pcie_adapter_policy_dsm_decode_valid(a, b, c)
            cosmos_nvme_pcie_adapter_policy_write_zeroes_decode_valid(a, b)
            cosmos_nvme_pcie_adapter_policy_flush_decode_valid(a, b)
            cosmos_nvme_pcie_adapter_policy_admin_invalid_field(a, b)

    cosmos_nvme_pcie_adapter_policy_write_zeroes_fields_supported(
        0u32, 0u32, 0u32, 0u32)
    cosmos_nvme_pcie_adapter_policy_write_zeroes_fields_supported(
        1u32, 0u32, 0u32, 0u32)
    cosmos_nvme_pcie_adapter_policy_dsm_fields_supported(
        0u32, 0u32, 0u32, 0u32, 0u32)
    cosmos_nvme_pcie_adapter_policy_dsm_fields_supported(
        0x100u32, 0u32, 0u32, 0u32, 0u32)
    cosmos_nvme_pcie_adapter_policy_admin_common_fields_supported(
        0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32)
    cosmos_nvme_pcie_adapter_policy_admin_common_fields_supported(
        0x100u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32)

    for kind in [0u32, 1u32, 2u32, 3u32, 4u32]:
        for valid in [0u32, 1u32]:
            cosmos_nvme_pcie_adapter_policy_io_invalid_field(kind, valid)

    cosmos_nvme_pcie_adapter_policy_admin_transfer_valid(
        1u32, 0x1000u32, 0u32, 0u32, 0u32, 0u32)
    cosmos_nvme_pcie_adapter_policy_admin_transfer_valid(
        1u32, 0x1004u32, 0u32, 0u32, 0u32, 0u32)
    cosmos_nvme_pcie_adapter_policy_admin_transfer_valid(
        2u32, 0x1000u32, 0u32, 0u32, 0u32, 4096u32)
    cosmos_nvme_pcie_adapter_policy_admin_transfer_valid(
        2u32, 0u32, 0u32, 0u32, 0u32, 4096u32)
    cosmos_nvme_pcie_adapter_policy_admin_transfer_valid(
        0u32, 0u32, 0u32, 0u32, 0u32, 0u32)
    cosmos_nvme_pcie_adapter_policy_admin_transfer_valid(
        0u32, 1u32, 0u32, 0u32, 0u32, 0u32)

    for result in [0u32, 1u32, 2u32, 3u32]:
        cosmos_nvme_pcie_adapter_policy_post_result(result)
    cosmos_nvme_pcie_adapter_policy_admin_payload_request_valid(
        0x1000u32, 0u32, 0u32, 4096u32)
    cosmos_nvme_pcie_adapter_policy_admin_payload_request_valid(
        0x1004u32, 0u32, 0u32, 4096u32)
    cosmos_nvme_pcie_adapter_policy_admin_payload_result(0)
    cosmos_nvme_pcie_adapter_policy_admin_payload_result(2)
    cosmos_nvme_pcie_adapter_policy_init_values_valid(1u32, 0u32, 512u32)
    cosmos_nvme_pcie_adapter_policy_init_values_valid(0u32, 0u32, 512u32)

fn main() -> i64:
    exercise_policy()
    0
