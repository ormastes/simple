"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing FIXTURES-VISIBILITY_TEST behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/fixtures/visibility_test/case_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-FIXTURES-VISIBILITY_TEST-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Test module with mixed visibility

# Auto-public: matches filename (test_case.spl -> TestCase)
class TestCase:
    id: i32
    name: text

    fn get_id() -> i32:
        self.id

# Private: doesn't match filename
class Helper:
    data: i32

    fn process() -> i32:
        self.data * 2

# Explicitly public
pub class Utils:
    x: i32

    fn double() -> i32:
        self.x * 2

# Private constant
val DEFAULT_ID: i32 = 0

# Public constant
pub val MAX_ID: i32 = 9999

# Private function
fn internal_helper() -> i32:
    42

# Public function
pub fn create_test(id: i32, name: text) -> TestCase:
    TestCase(id: id, name: name)
