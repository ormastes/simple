# Run INSIDE AN ISOLATED ConPTY under an external watchdog. This fixture injects
# console input records and clears that fixture console's input queue. Running
# it directly in an unrelated interactive console would consume user input.
# It does not mutate the system clipboard. Positive clipboard copy is a
# separate explicit user-action gate.
use std.nogc_sync_mut.io.windows_console_owner.{windows_console_open_v1, windows_console_read_v1, windows_console_size_v1, windows_console_write_v1, windows_console_close_v1, windows_console_cleanup_v1, windows_console_clipboard_write_v1}
use std.nogc_sync_mut.io.windows_console_abi.{GetStdHandle, GetConsoleMode, GetConsoleScreenBufferInfo}
use std.nogc_sync_mut.io.windows_console_codec.{windows_console_raw_input_mode_v1, windows_console_vt_output_mode_v1}
use std.nogc_sync_mut.io.windows_process_owner_abi.{GetProcessHeap, HeapAlloc, HeapFree, Sleep, GetTickCount64}
use std.nogc_sync_mut.io.volatile_ops.{volatile_write_u16, volatile_write_u32, volatile_read_u16, volatile_read_u32}

@unsafe(reason: "injects deterministic input into the fixture's isolated console", capabilities: [ffi, raw_ptr])
extern fn WriteConsoleInputW(console: i64, records: i64, count: u32, written: i64) -> i32
@unsafe(reason: "clears only the explicitly isolated fixture console input", capabilities: [ffi])
extern fn FlushConsoleInputBuffer(console: i64) -> i32
@unsafe(reason: "observes actual fixture screen cells after bottom-right paint", capabilities: [ffi, raw_ptr])
extern fn ReadConsoleOutputCharacterW(console: i64, text_out: i64, capacity: u32, coordinate: u32, read_out: i64) -> i32

@unsafe(reason: "writes exact 20-byte fixture INPUT_RECORD layouts", capabilities: [ffi, raw_ptr])
fn key_record(address: i64, down: bool, repeat: i64, vkey: i64, unit: i64, controls: i64):
    volatile_write_u16(address, 1)
    volatile_write_u32(address + 4, if down: 1 else: 0)
    volatile_write_u16(address + 8, repeat)
    volatile_write_u16(address + 10, vkey)
    volatile_write_u16(address + 14, unit)
    volatile_write_u32(address + 16, controls)

@unsafe(reason: "observes and injects only retained fixture console identities", capabilities: [ffi, raw_ptr])
fn check_console(handle: i64, input: i64, output: i64, arena: i64, saved_input: i64, saved_output: i64) -> i64:
    if windows_console_open_v1().is_ok(): return 10
    if GetConsoleMode(input, arena) == 0 or GetConsoleMode(output, arena + 4) == 0: return 11
    if volatile_read_u32(arena) != windows_console_raw_input_mode_v1(saved_input) as i64: return 12
    if volatile_read_u32(arena + 4) != windows_console_vt_output_mode_v1(saved_output) as i64: return 13
    val dimensions = windows_console_size_v1(handle)
    if not dimensions.is_ok(): return 14
    val size = dimensions.unwrap()
    if size.len() != 2 or size[0] < 9 or size[1] <= 0: return 15
    if not windows_console_write_v1(handle, "\x1b[2J\x1b[HTOP_GUARD").is_ok(): return 28
    if not windows_console_write_v1(handle, "\x1b[{size[1]};{size[0]}HZ").is_ok(): return 29
    if GetConsoleScreenBufferInfo(output, arena + 16) == 0: return 30
    val left = volatile_read_u16(arena + 26)
    val top = volatile_read_u16(arena + 28)
    val coordinate = (left + top * 65536) as u32
    if ReadConsoleOutputCharacterW(output, arena + 192, 9u32, coordinate, arena + 12) == 0: return 31
    if volatile_read_u32(arena + 12) != 9: return 32
    val guard = "TOP_GUARD"
    for index in 0..9:
        if volatile_read_u16(arena + 192 + index * 2) != guard.char_code_at(index): return 33
    if not windows_console_write_v1(handle, "CONSOLE_UTF8_한😀\r\n").is_ok(): return 16
    if windows_console_read_v1(handle, 0).is_ok(): return 17
    if FlushConsoleInputBuffer(input) == 0: return 18
    # An empty read must return without waiting for a line or key event.
    val started = GetTickCount64()
    val empty = windows_console_read_v1(handle, 4096)
    if not empty.is_ok() or empty.unwrap() != "": return 19
    if GetTickCount64() - started > 100u64: return 20
    key_record(arena + 64, true, 1, 67, 3, 8)
    key_record(arena + 84, true, 1, 38, 0, 0)
    key_record(arena + 104, true, 1, 0, 55357, 0)
    key_record(arena + 124, true, 1, 0, 56832, 0)
    key_record(arena + 144, true, 2, 13, 13, 0)
    key_record(arena + 164, false, 1, 67, 3, 8)
    if WriteConsoleInputW(input, arena + 64, 6u32, arena + 8) == 0: return 21
    if volatile_read_u32(arena + 8) != 6: return 22
    val control = windows_console_read_v1(handle, 1)
    if not control.is_ok() or control.unwrap() != "\x03": return 23
    val bounded = windows_console_read_v1(handle, 1)
    if not bounded.is_ok() or bounded.unwrap() != "": return 24
    val rest = windows_console_read_v1(handle, 4096)
    if not rest.is_ok() or rest.unwrap() != "\x1b[A😀\r\r": return 25
    if windows_console_clipboard_write_v1(-1, "no clipboard mutation").is_ok(): return 26
    0

@unsafe(reason: "captures actual modes and requires exact restoration after the native owner closes", capabilities: [ffi, raw_ptr])
fn main() -> i64:
    val input = GetStdHandle(4294967286u32)
    val output = GetStdHandle(4294967285u32)
    val heap = GetProcessHeap()
    val arena = HeapAlloc(heap, 8u32, 256u64)
    if arena == 0: return 1
    var code: i64 = 0
    if GetConsoleMode(input, arena) == 0 or GetConsoleMode(output, arena + 4) == 0: code = 2
    val saved_input = volatile_read_u32(arena)
    val saved_output = volatile_read_u32(arena + 4)
    var handle: i64 = -1
    if code == 0:
        match windows_console_open_v1():
            case Err(_reason): code = 3
            case Ok(opened): handle = opened
    if handle > 0:
        code = check_console(handle, input, output, arena, saved_input, saved_output)
        var closed = false
        for attempt in 0..200:
            if not closed:
                closed = windows_console_close_v1(handle)
                if not closed: Sleep(10u32)
        if not closed and code == 0: code = 4
        if not windows_console_close_v1(handle) and code == 0: code = 5
        if windows_console_read_v1(handle, 32).is_ok() and code == 0: code = 6
    if not windows_console_cleanup_v1() and code == 0: code = 7
    if GetConsoleMode(input, arena) == 0 or GetConsoleMode(output, arena + 4) == 0:
        if code == 0: code = 8
    elif volatile_read_u32(arena) != saved_input or volatile_read_u32(arena + 4) != saved_output:
        if code == 0: code = 9
    if HeapFree(heap, 0u32, arena) == 0 and code == 0: code = 27
    if code != 0:
        print "Windows console owner FAIL {code}"
        return code
    print "Windows console owner PASS"
    0
