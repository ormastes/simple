# Compile with the rebuilt Pure-Simple Windows Phase2 and then Phase3 producer.
# This actual import alias triggered spurious Thread TransferOut in smux.
# Invalid arguments return in the public PTY wrapper, without opening a child.
use std.sys.pty.{spawn as pty_spawn}

fn main() -> i64:
    val invalid_handle = pty_spawn(-1, "cmd.exe")
    val empty_command = pty_spawn(0, "")
    if invalid_handle != -1 or empty_command != -1:
        return 1
    print "pty spawn owner PASS"
    0
