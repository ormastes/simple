# Native-only fixture: compile using the ordered Windows provider overlay.
# This source keeps the exact stable application imports.
use std.sys.pty.{open as pty_open, spawn as pty_spawn, platform_default_shell}
use std.nogc_sync_mut.sosix.network.{sosix_tcp_close}

fn main() -> i64:
    if platform_default_shell() != "cmd.exe": return 1
    if pty_open(0, 80) != -1: return 2
    if pty_spawn(-1, "cmd.exe") != -1: return 3
    if sosix_tcp_close(-1): return 4
    print "windows native provider selection PASS"
    0
