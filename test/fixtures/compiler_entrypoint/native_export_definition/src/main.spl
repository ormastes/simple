use app.export_owner.{EXPORT_DEFINITION_OWNER_V1, ordinary_definition}
use app.normal_caller.{call_same_export_through_simple}
@unsafe(reason: "same-program exported Simple C ABI witness", capabilities: [ffi])
extern fn simple_export_definition_witness_v1(value: i64) -> i64

fn main() -> i64:
    var exported = 0
    unsafe(capabilities: [ffi]):
        exported = simple_export_definition_witness_v1(40)
    if exported != 41:
        print "FAIL C export definition"
        return 1
    if ordinary_definition(40) != 42:
        print "FAIL ordinary imported definition"
        return 2
    if call_same_export_through_simple(42) != 43:
        print "FAIL same C export through Simple import"
        return 3
    print "PASS C export definition"
    print "PASS ordinary imported definition"
    print "PASS same C export through Simple import"
    0
