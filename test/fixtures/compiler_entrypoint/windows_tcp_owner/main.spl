# Real Win64 Winsock qualification fixture. Compile independently with each
# admitted Phase2 and Phase3 producer; execute the resulting native artifact.
# Does not use the old rt_io_tcp_* provider or an interpreter fallback.
use std.nogc_sync_mut.io.windows_tcp.*
use std.common.text_bytes.{text_to_bytes}

fn check_connection(listener: i64, client: i64, server: i64) -> i64:
    if not io_tcp_set_nodelay(client, true): return 20
    if not io_tcp_set_read_timeout(server, 1000): return 21
    if io_tcp_set_reuseport(server, true): return 22
    if not io_tcp_set_nonblocking(server, true): return 23
    if io_tcp_read(server, 1) != nil: return 24
    if io_tcp_write(client, [0u8, 127u8, 128u8, 255u8]) != 4: return 25
    if not io_tcp_set_nonblocking(server, false): return 26
    var received: [u8] = []
    for attempt in 0..4:
        if received.len() < 4:
            if val part = io_tcp_read(server, 4 - received.len()):
                for byte_value in part: received.push(byte_value)
            else: return 27
    if received != [0u8, 127u8, 128u8, 255u8]: return 28
    if not io_tcp_set_nonblocking(server, true): return 29
    if io_tcp_write_text(client, "part") != 4: return 30
    # Nonblocking partial line is retained, not returned or discarded.
    if io_tcp_read_line(server) != nil: return 31
    if io_tcp_write_text(client, "ial 한글\n") != text_to_bytes("ial 한글\n").len(): return 32
    if not io_tcp_set_nonblocking(server, false): return 33
    if io_tcp_read_line(server) != "partial 한글\n": return 34
    if not io_tcp_flush(client): return 35
    if not io_tcp_shutdown(client, 1): return 36
    if val eof = io_tcp_read(server, 1):
        if eof.len() != 0: return 37
    else: return 38
    if not io_tcp_close(client): return 39
    if io_tcp_close(client): return 40
    # A later socket cannot be closed by the earlier logical handle.
    val later = io_tcp_socket_create(0)
    if later < 0: return 41
    var reuse_code: i64 = 0
    if later == client or later % 4096 != client % 4096: reuse_code = 42
    if io_tcp_close(client) or io_tcp_read(client, 1) != nil: reuse_code = 44
    if io_tcp_set_nonblocking(client, true) or io_tcp_local_addr(client) != nil: reuse_code = 45
    val later_valid = io_tcp_flush(later)
    val later_closed = io_tcp_close(later)
    if not later_valid or not later_closed: return 43
    reuse_code

fn check_bounded_reuse() -> i64:
    val before = windows_tcp_registry_slots_v1()
    if windows_tcp_registry_live_v1() != 0: return 50
    var previous: i64 = -1
    for iteration in 0..128:
        val current = io_tcp_socket_create(0)
        if current < 0: return 51
        var code: i64 = 0
        if previous >= 0:
            if current == previous or current % 4096 != previous % 4096: code = 52
            if io_tcp_close(previous) or io_tcp_read(previous, 1) != nil: code = 53
        if not io_tcp_flush(current): code = 54
        if not io_tcp_close(current): code = 55
        if code != 0: return code
        previous = current
    if windows_tcp_registry_slots_v1() != before: return 56
    if windows_tcp_registry_live_v1() != 0: return 57
    0

fn main() -> i64:
    if windows_tcp_address_v1("256.0.0.1:2") != nil: return 1
    if windows_tcp_address_v1("example.com:80") != nil: return 2
    if windows_tcp_address_v1("127.0.0.1:65536") != nil: return 3
    if io_tcp_socket_create(1) != -1: return 4
    if io_tcp_connect_timeout("127.0.0.1:1", 0) != -1: return 5
    if io_tcp_read(-1, 4) != nil or io_tcp_close(-1): return 6
    val listener = io_tcp_bind("127.0.0.1:0")
    if listener < 0: return 7
    var code: i64 = 0
    var client: i64 = -1
    var server: i64 = -1
    if io_tcp_accept_timeout(listener, 5) != -1: code = 8
    if val address = io_tcp_local_addr(listener):
        if address == "127.0.0.1:0": code = 9
        if code == 0: client = io_tcp_connect_timeout(address, 1000)
    else: code = 10
    if code == 0 and client < 0: code = 11
    if code == 0: server = io_tcp_accept_timeout(listener, 1000)
    if code == 0 and server < 0: code = 12
    if code == 0 and windows_tcp_registry_live_v1() != 3: code = 15
    if code == 0 and io_tcp_peer_addr(server) == nil: code = 13
    if code == 0: code = check_connection(listener, client, server)
    if client >= 0:
        val _client_closed = io_tcp_close(client)
    if server >= 0:
        val _server_closed = io_tcp_close(server)
    if not io_tcp_close(listener) and code == 0: code = 14
    if code == 0: code = check_bounded_reuse()
    if code != 0:
        print "Windows TCP owner FAIL {code}"
        return code
    print "Windows TCP owner PASS"
    0
