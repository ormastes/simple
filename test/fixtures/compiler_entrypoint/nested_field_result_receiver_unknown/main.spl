# Negative compiler fixture: the missing field must never inherit the known
# stream field's method/result type. Successful compilation is a failure.
class UnknownFieldEndpoint:
    fn close() -> Result<(), text>:
        Ok(())

class UnknownFieldOwner:
    stream: UnknownFieldEndpoint

fn unknown(owner: UnknownFieldOwner) -> bool:
    owner.absent.close().is_err()

fn main() -> i64:
    val owner = UnknownFieldOwner(stream: UnknownFieldEndpoint())
    if unknown(owner): return 1
    0
