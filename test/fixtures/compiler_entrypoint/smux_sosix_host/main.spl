# Native host boundary control. Arg 1: this executable's existing absolute path.
# Pipe UTF8 "SOSIX_STDIN_λ\n", then close stdin. External watchdog: 10 seconds.
# A successful compile or authored expected output does not qualify execution.
use std.nogc_sync_mut.sosix.host.{sosix_get_cli_args, sosix_file_exists, sosix_getpid}
use std.nogc_sync_mut.sosix.time.{sosix_time_now_monotonic_ms,
    sosix_time_now_unix_micros, sosix_sleep_ms}
use std.nogc_sync_mut.sosix.stdio.{sosix_read_stdin_line, sosix_println}

fn main() -> i64:
    val args = sosix_get_cli_args()
    if args.len() != 1: return 1
    if not sosix_file_exists(args[0]): return 2
    val pid = sosix_getpid()
    if pid <= 0 or sosix_getpid() != pid: return 3
    if sosix_time_now_unix_micros() <= 0: return 4
    val started = sosix_time_now_monotonic_ms()
    sosix_sleep_ms(25)
    val elapsed = sosix_time_now_monotonic_ms() - started
    if elapsed < 10 or elapsed > 5000: return 5
    if sosix_read_stdin_line() != "SOSIX_STDIN_λ": return 6
    if sosix_read_stdin_line() != "": return 7
    sosix_println("sosix-host-boundary-ok")
    0
