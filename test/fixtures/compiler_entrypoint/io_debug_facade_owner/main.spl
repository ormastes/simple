# Regression for the facade's concrete export edge. The observed state comes
# from the exact owner imported by debug_stubs, not an extern runtime symbol.
use std.nogc_sync_mut.io.{rt_debug_set_active}
use lib.nogc_sync_mut.io.debug_state.{ds_is_active}

fn main() -> i64:
    rt_debug_set_active(false)
    if ds_is_active(): return 1
    rt_debug_set_active(true)
    if not ds_is_active(): return 2
    rt_debug_set_active(false)
    if ds_is_active(): return 3
    print "IO debug facade owner PASS"
    0
