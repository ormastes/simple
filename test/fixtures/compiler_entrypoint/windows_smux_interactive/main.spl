# Actual native Windows integration fixture. Argument: the real compiled smux.exe.
# Build this fixture and smux separately with each admitted Phase 2/3 producer.
# The stable std.sys.pty import MUST resolve to its native Windows overlay.
# Run under an external <=180s process-tree/Job watchdog; retain that receipt.
# No source-only run or expected.stdout file constitutes execution evidence.
use std.sys.pty.{open, spawn, write_some, input_pending, read, is_running,
    exit_code, close, cleanup_pending, can_resize}
use std.common.string_core.{text_to_bytes}
use std.cli.cli_util.{get_cli_args}
use std.nogc_async_mut.sosix.{sosix_platform}
use app.io.mod.{file_exists, getpid, thread_sleep_ms}
use os.apps.smux.server.{smux_server_request}

class ClientCapture:
    first: text
    second: text
    overflow: bool

fn owner_request(address: text, token: text, command: text) -> text:
    val reply = smux_server_request(address, token, command)
    if reply.is_err(): return "fixture transport failure: " + reply.unwrap_err()
    return reply.unwrap().replace("\r\n", "\n").trim()

fn owner_ready(address: text, token: text, owner: i32) -> bool:
    for attempt in 0..100:
        if not is_running(owner): return false
        if owner_request(address, token, "list") == "smux: sessions=0": return true
        thread_sleep_ms(10)
    false

fn reply_ids(reply: text, header: text) -> [text]:
    var ids: [text] = []
    if not reply.starts_with(header): return ids
    val lines = reply.split("\n")
    for line in lines[1:]:
        if line.trim() != "": ids.push(line.trim().split(" ")[0])
    ids

fn await_ids(address: text, token: text, command: text, header: text, count: i64) -> [text]:
    for attempt in 0..100:
        val ids = reply_ids(owner_request(address, token, command), header)
        if ids.len() == count: return ids
        thread_sleep_ms(10)
    []

# Byte offsets preserve the provider's partial-write contract. Completion means
# provider delivery, not acceptance alone. No production client is simulated.
fn send_all(handle: i32, content: text) -> bool:
    val bytes = text_to_bytes(content)
    var offset: i64 = 0
    for attempt in 0..500:
        if offset < bytes.len():
            val accepted = write_some(handle, bytes[offset:])
            if accepted < 0 or accepted > bytes.len() - offset: return false
            offset = offset + accepted
        val pending = input_pending(handle)
        if pending.is_err(): return false
        if offset == bytes.len() and not pending.unwrap(): return true
        thread_sleep_ms(10)
    false

# Keep every observed client byte for cross-client exclusion checks. Overflow
# fails instead of dropping earlier output that could conceal a routing error.
fn await_pair(first: i32, second: i32, previous: ClientCapture,
    first_needle: text, second_needle: text) -> ClientCapture:
    var captured = previous
    for attempt in 0..500:
        captured.first = captured.first + read(first, 0)
        captured.second = captured.second + read(second, 0)
        if captured.first.len() > 1048576 or captured.second.len() > 1048576:
            captured.overflow = true
            return captured
        if captured.first.contains(first_needle) and captured.second.contains(second_needle):
            return captured
        thread_sleep_ms(10)
    captured

fn await_terminal(handle: i32) -> bool:
    for attempt in 0..500:
        val _own_output = read(handle, 0)
        if not is_running(handle): return true
        thread_sleep_ms(10)
    false

fn close_bounded(handle: i32) -> bool:
    if handle < 0: return true
    for attempt in 0..200:
        if close(handle): return true
        thread_sleep_ms(10)
    false

fn check_clients(binary: text, address: text, token: text,
    owner: i32, first: i32, second: i32) -> i64:
    if not owner_ready(address, token, owner): return 10
    if not owner_request(address, token, "new alpha").contains("shell pid="): return 11
    if not owner_request(address, token, "new beta").contains("shell pid="): return 12
    val alpha_windows = await_ids(address, token, "windows alpha", "smux: windows[alpha]:", 1)
    if alpha_windows.len() != 1: return 13
    val alpha_window = alpha_windows[0]
    val original_panes = await_ids(address, token, "client-panes alpha " + alpha_window, "smux: panes[alpha]:", 1)
    if original_panes.len() != 1: return 14
    val quoted = "\"" + binary + "\""
    if spawn(first, quoted + " --attach " + address + " " + token + " alpha screen-alpha") <= 0: return 15
    if spawn(second, quoted + " --attach " + address + " " + token + " beta screen-beta") <= 0: return 16
    # These complete tokens never occur in input; real child variable expansion
    # must traverse client input -> owner -> pane -> frame -> client -> ConPTY.
    if not send_all(first, "set SMUX_ALPHA_VALUE=READY\recho SMUX_ALPHA_%SMUX_ALPHA_VALUE%\r"): return 17
    if not send_all(second, "set SMUX_BETA_VALUE=READY\recho SMUX_BETA_%SMUX_BETA_VALUE%\r"): return 18
    var captured = ClientCapture(first: "", second: "", overflow: false)
    captured = await_pair(first, second, captured, "SMUX_ALPHA_READY", "SMUX_BETA_READY")
    if captured.overflow or not captured.first.contains("SMUX_ALPHA_READY") or not captured.second.contains("SMUX_BETA_READY"): return 19
    if captured.first.contains("SMUX_BETA_READY") or captured.second.contains("SMUX_ALPHA_READY"): return 20
    if not is_running(first) or not is_running(second): return 21

    # The keyboard performs the operation. RPC only observes production state.
    if not send_all(first, "\x02%"): return 22
    val split_panes = await_ids(address, token, "client-panes alpha " + alpha_window, "smux: panes[alpha]:", 2)
    if split_panes.len() != 2: return 23
    if not send_all(first, "set SMUX_SPLIT_VALUE=LIVE\recho SMUX_SPLIT_%SMUX_SPLIT_VALUE%\r"): return 24
    captured = await_pair(first, second, captured, "SMUX_SPLIT_LIVE", "SMUX_BETA_READY")
    if captured.overflow or not captured.first.contains("SMUX_SPLIT_LIVE"): return 25
    if captured.second.contains("SMUX_SPLIT_LIVE"): return 26
    # tiled -> even-horizontal -> even-vertical: two keys force observable
    # geometry change for two panes instead of accepting an equivalent layout.
    if not send_all(first, "\x02 \x02 "): return 27
    var arranged = false
    for attempt in 0..100:
        val rects = owner_request(address, token, "rects alpha")
        arranged = rects.contains(split_panes[0] + " 0 0 80 12") and rects.contains(split_panes[1] + " 0 12 80 12")
        if arranged: break
        thread_sleep_ms(10)
    if not arranged: return 28

    if not send_all(first, "\x02c"): return 29
    val two_windows = await_ids(address, token, "windows alpha", "smux: windows[alpha]:", 2)
    if two_windows.len() != 2: return 30
    if not send_all(first, "set SMUX_WINDOW_VALUE=NEW\recho SMUX_WINDOW_%SMUX_WINDOW_VALUE%\r"): return 31
    captured = await_pair(first, second, captured, "SMUX_WINDOW_NEW", "SMUX_BETA_READY")
    if captured.overflow or not captured.first.contains("SMUX_WINDOW_NEW"): return 32
    if captured.second.contains("SMUX_WINDOW_NEW"): return 33
    if not send_all(first, "\x02n"): return 34
    if not send_all(first, "echo SMUX_RETURN_%SMUX_ALPHA_VALUE%\r"): return 35
    captured = await_pair(first, second, captured, "SMUX_RETURN_READY", "SMUX_BETA_READY")
    if captured.overflow or not captured.first.contains("SMUX_RETURN_READY"): return 36
    if captured.second.contains("SMUX_RETURN_READY"): return 37

    if not send_all(first, "\x02d"): return 38
    if not await_terminal(first): return 39
    val first_exit = exit_code(first)
    if first_exit.is_err() or first_exit.unwrap() != 0: return 40
    if not is_running(owner) or not is_running(second): return 41
    if owner_request(address, token, "list") != "smux: sessions=2": return 42
    if not send_all(second, "echo SMUX_SIBLING_%SMUX_BETA_VALUE%\r"): return 43
    captured = await_pair(first, second, captured, "SMUX_RETURN_READY", "SMUX_SIBLING_READY")
    if captured.overflow or not captured.second.contains("SMUX_SIBLING_READY"): return 44
    if captured.first.contains("SMUX_SIBLING_READY") or captured.second.contains("SMUX_ALPHA_READY"): return 45
    if not send_all(second, "\x02d"): return 46
    if not await_terminal(second): return 47
    val second_exit = exit_code(second)
    if second_exit.is_err() or second_exit.unwrap() != 0: return 48
    if not is_running(owner): return 49
    0

fn main() -> i64:
    val args = get_cli_args()
    if args.len() != 1:
        print "Windows smux interactive FAIL argument-required"
        return 1
    val binary = args[0]
    if sosix_platform() != "windows" or not can_resize() or not file_exists(binary) or not binary.ends_with(".exe") or binary.contains("\""):
        print "Windows smux interactive FAIL fixture-required"
        return 2
    val address = "127.0.0.1:" + (56000 + getpid() % 8000).to_text()
    val token = "smux-interactive-" + getpid().to_text()
    val owner = open(24, 80)
    val first = open(24, 80)
    val second = open(30, 100)
    var code: i64 = 0
    var owner_started = false
    if owner < 0 or first < 0 or second < 0: code = 3
    if code == 0:
        owner_started = spawn(owner, "\"" + binary + "\" --serve " + address + " " + token) > 0
        if not owner_started: code = 4
    if code == 0: code = check_clients(binary, address, token, owner, first, second)
    # Every acquired lease reaches cleanup even after a failed observation.
    # stop-server precedes forced owner close; a normal run must exit with code0.
    if owner_started:
        val stopping = owner_request(address, token, "stop-server")
        if stopping != "smux: stopping server" and code == 0: code = 50
        if not await_terminal(owner) and code == 0: code = 51
        if code == 0:
            val owner_exit = exit_code(owner)
            if owner_exit.is_err() or owner_exit.unwrap() != 0: code = 52
    if not close_bounded(first) and code == 0: code = 53
    if not close_bounded(second) and code == 0: code = 54
    if not close_bounded(owner) and code == 0: code = 55
    if cleanup_pending() != 0 and code == 0: code = 56
    if code != 0:
        print "Windows smux interactive FAIL {code}"
        return code
    print "Windows smux interactive PASS"
    0
