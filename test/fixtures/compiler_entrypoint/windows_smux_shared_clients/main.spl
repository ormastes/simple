# Native Windows same-session clients. Sole argument: real compiled smux.exe.
# Build application+fixture separately with admitted Phase2 and Phase3 producers.
# Run under external <=180s process-tree/Job watchdog, preserving its receipt.
# Source authorship and expected.stdout never count as observed runtime proof.
use std.nogc_sync_mut.sosix.pty.{sosix_pty_open as open, sosix_pty_spawn as spawn,
    sosix_pty_write_some as write_some, sosix_pty_input_pending as input_pending,
    sosix_pty_read as read, sosix_pty_is_running as is_running,
    sosix_pty_exit_code as exit_code, sosix_pty_resize as resize,
    sosix_pty_close as close, sosix_pty_cleanup_pending as cleanup_pending,
    sosix_pty_can_resize as can_resize}
use std.common.string_core.{text_to_bytes}
use std.nogc_sync_mut.sosix.host.{sosix_get_cli_args as get_cli_args,
    sosix_platform_name, sosix_file_exists as file_exists, sosix_getpid as getpid}
use std.nogc_sync_mut.sosix.time.{sosix_time_now_monotonic_ms as time_now_monotonic_ms,
    sosix_sleep_ms as thread_sleep_ms}
use std.nogc_sync_mut.sosix.stdio.{sosix_println}
use os.apps.smux.server.{smux_server_request}

class ClientCapture:
    first: text
    second: text
    overflow: bool

fn owner_request(address: text, token: text, command: text) -> text:
    val reply = smux_server_request(address, token, command)
    if reply.is_err(): return "fixture transport failure: " + reply.unwrap_err()
    reply.unwrap().replace("\r\n", "\n").trim()

fn owner_ready(address: text, token: text, owner: i32) -> bool:
    for attempt in 0..100:
        if not is_running(owner): return false
        if owner_request(address, token, "list") == "smux: sessions=0": return true
        thread_sleep_ms(10)
    false

fn reply_ids(reply: text, header: text) -> [text]:
    var ids: [text] = []
    if not reply.starts_with(header): return ids
    val lines = reply.split("\n")
    for line in lines[1:]:
        if line.trim() != "": ids.push(line.trim().split(" ")[0])
    ids

fn await_ids(address: text, token: text, command: text, header: text, count: i64) -> [text]:
    for attempt in 0..100:
        val ids = reply_ids(owner_request(address, token, command), header)
        if ids.len() == count: return ids
        thread_sleep_ms(10)
    []

fn send_all(handle: i32, content: text) -> bool:
    val bytes = text_to_bytes(content)
    var offset: i64 = 0
    for attempt in 0..500:
        if offset < bytes.len():
            val accepted = write_some(handle, bytes[offset:])
            if accepted < 0 or accepted > bytes.len() - offset: return false
            offset = offset + accepted
        val pending = input_pending(handle)
        if pending.is_err(): return false
        if offset == bytes.len() and not pending.unwrap(): return true
        thread_sleep_ms(10)
    false

fn await_pair(first: i32, second: i32, previous: ClientCapture,
    first_needle: text, second_needle: text) -> ClientCapture:
    var captured = previous
    for attempt in 0..500:
        captured.first = captured.first + read(first, 0)
        captured.second = captured.second + read(second, 0)
        if captured.first.len() > 1048576 or captured.second.len() > 1048576:
            captured.overflow = true
            return captured
        if captured.first.contains(first_needle) and captured.second.contains(second_needle): return captured
        thread_sleep_ms(10)
    captured

fn await_terminal(handle: i32) -> bool:
    for attempt in 0..500:
        val _output = read(handle, 0)
        if not is_running(handle): return true
        thread_sleep_ms(10)
    false

fn close_bounded(handle: i32) -> bool:
    if handle < 0: return true
    for attempt in 0..200:
        if close(handle): return true
        thread_sleep_ms(10)
    false

fn await_frame_size(address: text, token: text, window: text, pane: text,
    cols: i64, rows: i64) -> bool:
    val expected = "SMUX-FRAME/1 " + cols.to_text() + " " + rows.to_text() + "\n"
    for attempt in 0..100:
        val frame = owner_request(address, token, "frame shared " + window + " " + pane)
        if frame.starts_with(expected): return true
        thread_sleep_ms(10)
    false

fn pane_history(address: text, token: text, window: text, pane: text) -> text:
    owner_request(address, token, "client-history shared " + window + " " + pane + " 200")

fn check_clients(binary: text, address: text, token: text,
    owner: i32, first: i32, second: i32) -> i64:
    if not owner_ready(address, token, owner): return 10
    if not owner_request(address, token, "new shared").contains("shell pid="): return 11
    val windows = await_ids(address, token, "windows shared", "smux: windows[shared]:", 1)
    if windows.len() != 1: return 12
    val original_window = windows[0]
    val panes = await_ids(address, token, "client-panes shared " + original_window, "smux: panes[shared]:", 1)
    if panes.len() != 1: return 13
    val original_pane = panes[0]
    val quoted = "\"" + binary + "\""
    if spawn(first, quoted + " --attach " + address + " " + token + " shared small") <= 0: return 14
    if spawn(second, quoted + " --attach " + address + " " + token + " shared large") <= 0: return 15
    if not send_all(first, "set SMUX_SHARED_VALUE=READY\recho SMUX_SHARED_%SMUX_SHARED_VALUE%\r"): return 16
    var captured = ClientCapture(first: "", second: "", overflow: false)
    captured = await_pair(first, second, captured, "SMUX_SHARED_READY", "SMUX_SHARED_READY")
    if captured.overflow or not captured.first.contains("SMUX_SHARED_READY") or not captured.second.contains("SMUX_SHARED_READY"): return 17
    if not is_running(first) or not is_running(second): return 18
    if not await_frame_size(address, token, original_window, original_pane, 80, 24): return 19

    # Resize the actual smaller terminal. Its console owner must detect this;
    # no fixture RPC mutates client-size or the production window geometry.
    if not resize(first, 18, 60): return 20
    if not await_frame_size(address, token, original_window, original_pane, 60, 18): return 21
    if not is_running(first) or not is_running(second): return 22
    if not send_all(first, "\x02%"): return 23
    val split = await_ids(address, token, "client-panes shared " + original_window, "smux: panes[shared]:", 2)
    if split.len() != 2: return 24
    val other_pane = if split[0] == original_pane: split[1] else: split[0]
    if not send_all(first, "set SMUX_LOCAL=SMALL\recho SMUX_ROUTED_%SMUX_LOCAL%\r"): return 25
    captured = await_pair(first, second, captured, "SMUX_ROUTED_SMALL", "SMUX_ROUTED_SMALL")
    if captured.overflow or not captured.first.contains("SMUX_ROUTED_SMALL") or not captured.second.contains("SMUX_ROUTED_SMALL"): return 26
    if not send_all(second, "set SMUX_LOCAL=LARGE\recho SMUX_ROUTED_%SMUX_LOCAL%\r"): return 27
    captured = await_pair(first, second, captured, "SMUX_ROUTED_LARGE", "SMUX_ROUTED_LARGE")
    if captured.overflow or not captured.first.contains("SMUX_ROUTED_LARGE") or not captured.second.contains("SMUX_ROUTED_LARGE"): return 28
    val old_history = pane_history(address, token, original_window, original_pane)
    val new_history = pane_history(address, token, original_window, other_pane)
    if not old_history.contains("SMUX_ROUTED_LARGE") or old_history.contains("SMUX_ROUTED_SMALL"): return 29
    if not new_history.contains("SMUX_ROUTED_SMALL") or new_history.contains("SMUX_ROUTED_LARGE"): return 30

    # Small client changes its window; large must remain on its original pane.
    # Explicit frame/input targets must ignore the service-global active window.
    if not send_all(first, "\x02c"): return 31
    val two_windows = await_ids(address, token, "windows shared", "smux: windows[shared]:", 2)
    if two_windows.len() != 2: return 32
    val other_window = if two_windows[0] == original_window: two_windows[1] else: two_windows[0]
    val other_panes = await_ids(address, token, "client-panes shared " + other_window, "smux: panes[shared]:", 1)
    if other_panes.len() != 1: return 33
    if not send_all(first, "set SMUX_LOCAL=NEWWINDOW\recho SMUX_NEW_%SMUX_LOCAL%\r"): return 34
    captured = await_pair(first, second, captured, "SMUX_NEW_NEWWINDOW", "SMUX_ROUTED_LARGE")
    if captured.overflow or not captured.first.contains("SMUX_NEW_NEWWINDOW"): return 35
    if captured.second.contains("SMUX_NEW_NEWWINDOW"): return 36
    if not send_all(second, "echo SMUX_STILL_%SMUX_LOCAL%\r"): return 37
    captured = await_pair(first, second, captured, "SMUX_NEW_NEWWINDOW", "SMUX_STILL_LARGE")
    if captured.overflow or not captured.second.contains("SMUX_STILL_LARGE") or captured.first.contains("SMUX_STILL_LARGE"): return 38
    if not await_frame_size(address, token, other_window, other_panes[0], 60, 18): return 39
    if not is_running(first) or not is_running(second): return 40

    if not send_all(first, "\x02d"): return 41
    if not await_terminal(first): return 42
    val first_exit = exit_code(first)
    if first_exit.is_err() or first_exit.unwrap() != 0: return 43
    if not is_running(owner) or not is_running(second): return 44
    if not await_frame_size(address, token, original_window, original_pane, 100, 30): return 45
    if not await_frame_size(address, token, other_window, other_panes[0], 100, 30): return 46

    # A real long-running child announces readiness with computed output. Raw
    # Ctrl-C must reach that child before the original shell can execute again.
    val sleeper = "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"Write-Output ('SMUX_INTERRUPT_' + (6*7)); Start-Sleep -Seconds 120\"\r"
    if not send_all(second, sleeper): return 47
    captured = await_pair(first, second, captured, "SMUX_NEW_NEWWINDOW", "SMUX_INTERRUPT_42")
    if captured.overflow or not captured.second.contains("SMUX_INTERRUPT_42"): return 48
    val interrupted_at = time_now_monotonic_ms()
    if not send_all(second, "\x03"): return 49
    if not send_all(second, "echo SMUX_AFTER_%SMUX_LOCAL%\r"): return 50
    captured = await_pair(first, second, captured, "SMUX_NEW_NEWWINDOW", "SMUX_AFTER_LARGE")
    val interrupted_ms = time_now_monotonic_ms() - interrupted_at
    if captured.overflow or not captured.second.contains("SMUX_AFTER_LARGE") or interrupted_ms >= 5000: return 51
    if captured.first.contains("SMUX_AFTER_LARGE"): return 52
    if not is_running(owner) or not is_running(second): return 53
    if not pane_history(address, token, original_window, original_pane).contains("SMUX_AFTER_LARGE"): return 54
    if pane_history(address, token, other_window, other_panes[0]).contains("SMUX_AFTER_LARGE"): return 55
    if not send_all(second, "\x02d"): return 56
    if not await_terminal(second): return 57
    val second_exit = exit_code(second)
    if second_exit.is_err() or second_exit.unwrap() != 0: return 58
    if not is_running(owner): return 59
    0

fn main() -> i64:
    val args = get_cli_args()
    if args.len() != 1:
        sosix_println("Windows smux shared clients FAIL argument-required")
        return 1
    val binary = args[0]
    if sosix_platform_name() != "windows" or not can_resize() or not file_exists(binary) or not binary.ends_with(".exe") or binary.contains("\""):
        sosix_println("Windows smux shared clients FAIL fixture-required")
        return 2
    val address = "127.0.0.1:" + (48000 + getpid() % 8000).to_text()
    val token = "smux-shared-" + getpid().to_text()
    val owner = open(24, 80)
    val first = open(24, 80)
    val second = open(30, 100)
    var code: i64 = 0
    var owner_started = false
    if owner < 0 or first < 0 or second < 0: code = 3
    if code == 0:
        owner_started = spawn(owner, "\"" + binary + "\" --serve " + address + " " + token) > 0
        if not owner_started: code = 4
    if code == 0: code = check_clients(binary, address, token, owner, first, second)
    if owner_started:
        if owner_request(address, token, "stop-server") != "smux: stopping server" and code == 0: code = 60
        if not await_terminal(owner) and code == 0: code = 61
        if code == 0:
            val owner_exit = exit_code(owner)
            if owner_exit.is_err() or owner_exit.unwrap() != 0: code = 62
    if not close_bounded(first) and code == 0: code = 63
    if not close_bounded(second) and code == 0: code = 64
    if not close_bounded(owner) and code == 0: code = 65
    if cleanup_pending() != 0 and code == 0: code = 66
    if code != 0:
        sosix_println("Windows smux shared clients FAIL {code}")
        return code
    sosix_println("Windows smux shared clients PASS")
    0
