struct TraitMouseEvent:
    dx: i64
    dy: i64

struct TraitNestedAggregate:
    event: TraitMouseEvent
    values: [i64]

struct TraitAggregatePayload:
    nested: TraitNestedAggregate
    label: text

trait TraitInputBackend:
    me poll_mouse() -> TraitMouseEvent?

class TraitFixtureBackend:
    has_event: bool

class TraitSecondBackend:
    padding: i64
    has_event: bool

impl TraitInputBackend for TraitFixtureBackend:
    me poll_mouse() -> TraitMouseEvent?:
        if self.has_event:
            self.has_event = false
            TraitMouseEvent(dx: 4, dy: 9)
        else:
            nil

impl TraitInputBackend for TraitSecondBackend:
    me poll_mouse() -> TraitMouseEvent?:
        if self.has_event:
            self.has_event = false
            TraitMouseEvent(dx: 7, dy: 3)
        else:
            nil

fn trait_aggregate_result(ok: bool) -> Result<TraitAggregatePayload, text>:
    if not ok:
        return Err("rejected")
    Ok(TraitAggregatePayload(
        nested: TraitNestedAggregate(
            event: TraitMouseEvent(dx: 2, dy: 5),
            values: [11, 13]
        ),
        label: "ok"
    ))

fn trait_aggregate_option(present: bool) -> TraitAggregatePayload?:
    if not present:
        return nil
    Some(TraitAggregatePayload(
        nested: TraitNestedAggregate(
            event: TraitMouseEvent(dx: 3, dy: 4),
            values: [17, 19]
        ),
        label: "option"
    ))

fn trait_nested_return() -> TraitNestedAggregate:
    TraitNestedAggregate(
        event: TraitMouseEvent(dx: 7, dy: 8),
        values: [21, 23]
    )

fn trait_aggregate_by_value_score(payload: TraitAggregatePayload) -> i64:
    payload.nested.event.dx * 1000 + payload.nested.event.dy * 100 + payload.nested.values[0] * 10 + payload.nested.values[1]

var TRAIT_GLOBAL_PAYLOAD = TraitAggregatePayload(
    nested: TraitNestedAggregate(
        event: TraitMouseEvent(dx: 1, dy: 2),
        values: [3, 4]
    ),
    label: "initial"
)

fn trait_global_aggregate_score() -> i64:
    trait_aggregate_by_value_score(TRAIT_GLOBAL_PAYLOAD)

fn trait_global_aggregate_update():
    TRAIT_GLOBAL_PAYLOAD = TraitAggregatePayload(
        nested: TraitNestedAggregate(
            event: TraitMouseEvent(dx: 6, dy: 7),
            values: [8, 9]
        ),
        label: "updated"
    )

export TraitMouseEvent, TraitNestedAggregate, TraitAggregatePayload, TraitInputBackend, TraitFixtureBackend, TraitSecondBackend, trait_aggregate_result, trait_aggregate_option, trait_nested_return, trait_aggregate_by_value_score, trait_global_aggregate_score, trait_global_aggregate_update
