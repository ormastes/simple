struct TraitMouseEvent:
    dx: i64
    dy: i64

trait TraitInputBackend:
    me poll_mouse() -> TraitMouseEvent?

class TraitFixtureBackend:
    has_event: bool

class TraitSecondBackend:
    padding: i64
    has_event: bool

impl TraitInputBackend for TraitFixtureBackend:
    me poll_mouse() -> TraitMouseEvent?:
        if self.has_event:
            self.has_event = false
            TraitMouseEvent(dx: 4, dy: 9)
        else:
            nil

impl TraitInputBackend for TraitSecondBackend:
    me poll_mouse() -> TraitMouseEvent?:
        if self.has_event:
            self.has_event = false
            TraitMouseEvent(dx: 7, dy: 3)
        else:
            nil

export TraitMouseEvent, TraitInputBackend, TraitFixtureBackend, TraitSecondBackend
