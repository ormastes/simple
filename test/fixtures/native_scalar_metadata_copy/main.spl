struct TypeMetadata:
    name: text
    depth: i64

class MetadataTable:
    var ids: [i64]
    var values: [TypeMetadata]
    var isolation_states: [i64]
    var resource_states: [i64]

impl MetadataTable:
    static fn create() -> MetadataTable:
        MetadataTable(
            ids: [7, 9],
            values: [TypeMetadata(name: "array", depth: 1), TypeMetadata(name: "text", depth: 0)],
            isolation_states: [2, 1],
            resource_states: [4, 3])

    me copy_by_scalar_id(destination: i64, source: i64):
        var source_index: i64 = -1
        var i = self.ids.len() - 1
        while i >= 0:
            if self.ids[i] == source:
                source_index = i
                break
            i = i - 1
        if source_index < 0:
            return
        var destination_index: i64 = -1
        i = self.ids.len() - 1
        while i >= 0:
            if self.ids[i] == destination:
                destination_index = i
                break
            i = i - 1
        if destination_index >= 0:
            self.values[destination_index] = self.values[source_index]
            self.isolation_states[destination_index] = self.isolation_states[source_index]
            self.resource_states[destination_index] = self.resource_states[source_index]
        else:
            self.ids.push(destination)
            self.values.push(self.values[source_index])
            self.isolation_states.push(self.isolation_states[source_index])
            self.resource_states.push(self.resource_states[source_index])

fn main():
    val table = MetadataTable.create()
    table.copy_by_scalar_id(11, 7)
    table.copy_by_scalar_id(9, 7)
    table.copy_by_scalar_id(13, 404)
    val actual = table.ids.len().to_text() + ":" + table.values[1].name + ":" +
        table.isolation_states[1].to_text() + ":" + table.resource_states[1].to_text() + ":" +
        table.values[2].name + ":" + table.values[2].depth.to_text() + ":" +
        table.isolation_states[2].to_text() + ":" + table.resource_states[2].to_text()
    if actual == "3:array:2:4:array:1:2:4":
        print("SCALAR METADATA COPY VERDICT: PASS " + actual)
    else:
        print("SCALAR METADATA COPY VERDICT: FAIL " + actual)
