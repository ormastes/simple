# Entry: imports the re-exported fn through the PACKAGE path (last segment is a
# plain package dir under a numbered layer). Under `simple run` the pipeline
# loader must flatten `inner.spl` so the JIT defines `facade_f`; before the fix
# it printed `[jit-fallback] unresolved external symbol 'facade_f'` and the
# whole program dropped to the interpreter.
use sem.pkg_a.{facade_f}

fn main():
    print("{facade_f(20)}")
