# Same load set as ambiguous_entry.spl, but the entry imports ONE `Vec3`
# explicitly: the bare name resolves through that import.
# Run through the interpreter lane: `simple test test/fixtures/modqual/explicit_entry.spl`.
use std.spec
use test.helpers.modqual.geo_a.{Vec3}
use test.helpers.modqual.geo_b.{mode_label as b_label}

describe "explicitly imported Vec3":
    it "resolves to module A's definition":
        val v = Vec3.unit()
        print("SUM=" + v.sum().to_string())
        expect(v.sum()).to_equal(3.0)
