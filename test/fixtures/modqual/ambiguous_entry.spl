# Entry that loads BOTH same-named `Vec3` definitions (through their modules'
# functions) but imports NEITHER `Vec3`. A bare `Vec3` here is ambiguous and
# the interpreter must refuse it instead of silently taking the last one.
# Run through the interpreter lane: `simple test test/fixtures/modqual/ambiguous_entry.spl`.
use std.spec
use test.helpers.modqual.geo_a.{mode_label as a_label}
use test.helpers.modqual.geo_b.{mode_label as b_label}

describe "ambiguous bare Vec3":
    it "is refused":
        val v = Vec3.unit()
        print("SUM=" + v.sum().to_string())
