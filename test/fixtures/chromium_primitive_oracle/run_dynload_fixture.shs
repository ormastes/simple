#!/usr/bin/env sh
set -eu

cc_bin="${CC:-cc}"
out_dir="${CHROMIUM_ORACLE_FIXTURE_OUT:-build/test-fixtures/chromium_primitive_oracle}"
mkdir -p "$out_dir"

case "$(uname -s)" in
    Darwin) lib="$out_dir/libsimple_chromium_primitive_oracle.dylib" ;;
    *) lib="$out_dir/libsimple_chromium_primitive_oracle.so" ;;
esac

"$cc_bin" -std=c11 -Wall -Wextra -Werror -fPIC -shared \
    test/fixtures/chromium_primitive_oracle/simple_chromium_primitive_oracle_fixture.c \
    -o "$lib"
if [ "$(uname -s)" = "Darwin" ]; then
    "$cc_bin" -std=c11 -Wall -Wextra -Werror \
        test/fixtures/chromium_primitive_oracle/dynload_fixture_test.c \
        -o "$out_dir/dynload_fixture_test"
else
    "$cc_bin" -std=c11 -Wall -Wextra -Werror \
        test/fixtures/chromium_primitive_oracle/dynload_fixture_test.c -ldl \
        -o "$out_dir/dynload_fixture_test"
fi
"$out_dir/dynload_fixture_test" "$lib"
