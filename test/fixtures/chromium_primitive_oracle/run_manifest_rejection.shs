#!/usr/bin/env sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)
cd "$root"
electron_bin=${SIMPLE_CHROMIUM_ORACLE_ELECTRON:-"$root/tools/electron-shell/node_modules/.bin/electron"}
broker="$root/tools/web-render-backend/chromium_primitive_oracle_broker.js"
request="$root/test/fixtures/chromium_primitive_oracle/bad_manifest_request.json"

if [ ! -x "$electron_bin" ]; then
    echo "CHROMIUM_ORACLE_MANIFEST_REJECTION_UNAVAILABLE electron-not-installed" >&2
    exit 2
fi

set +e
output=$("$electron_bin" --no-sandbox "$broker" "$request" 2>&1)
status=$?
set -e
if [ "$status" -eq 0 ]; then
    echo "ERROR: bad Chromium oracle manifest was accepted" >&2
    exit 1
fi
case "$output" in
    *"REAL_CHROMIUM_ORACLE_UNAVAILABLE oracle-manifest-identity-mismatch"*)
        echo "CHROMIUM_ORACLE_MANIFEST_REJECTION_PASS"
        ;;
    *)
        printf '%s\n' "$output" >&2
        echo "ERROR: wrong manifest rejection class" >&2
        exit 1
        ;;
esac
