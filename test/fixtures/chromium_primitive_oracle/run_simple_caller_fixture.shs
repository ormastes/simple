#!/usr/bin/env sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)
cd "$root"

simple_bin=${SIMPLE_BIN:-bin/simple}
out_dir=${CHROMIUM_ORACLE_FIXTURE_OUT:-build/test-fixtures/chromium_primitive_oracle}
mkdir -p "$out_dir"

sh test/fixtures/chromium_primitive_oracle/run_dynload_fixture.shs
caller_output=$(SIMPLE_LIB=src "$simple_bin" run \
    test/02_integration/rendering/chromium_reference_oracle_native_integration.spl 2>&1) || {
    printf '%s\n' "$caller_output"
    exit 1
}
printf '%s\n' "$caller_output"
case "$caller_output" in
    *"chromium-oracle-native-integration: PASS fixture-only"*) ;;
    *) echo "ERROR: Simple caller did not emit its required PASS receipt" >&2; exit 1 ;;
esac
