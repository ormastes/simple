#!/bin/sh
# Runs only a pinned, worktree-local Electron.  It intentionally has no PATH,
# global Electron, npx, fixture-library, or synthetic-result fallback.
set -eu

fixture_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
worktree_root=$(CDPATH= cd -- "$fixture_dir/../../.." && pwd)
electron_bin=${SIMPLE_CHROMIUM_ORACLE_ELECTRON:-"$worktree_root/tools/electron-shell/node_modules/.bin/electron"}
broker="$worktree_root/tools/web-render-backend/chromium_primitive_oracle_broker.js"
request="$fixture_dir/real_primitive_request.json"

if [ ! -x "$electron_bin" ]; then
  printf '%s\n' "REAL_CHROMIUM_ORACLE_UNAVAILABLE pinned-electron-not-installed expected=$electron_bin" >&2
  printf '%s\n' "Install the pinned tools/electron-shell package or set SIMPLE_CHROMIUM_ORACLE_ELECTRON to that pinned executable." >&2
  exit 2
fi
if [ ! -f "$broker" ]; then
  printf '%s\n' "REAL_CHROMIUM_ORACLE_UNAVAILABLE broker-missing path=$broker" >&2
  exit 2
fi
# Electron's setuid helper is not configured in disposable worktrees; the
# repository's Chromium backend checks use this same test-only switch.
exec "$electron_bin" --no-sandbox "$broker" "$request"
