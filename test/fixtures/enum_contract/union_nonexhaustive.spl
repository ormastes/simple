# NEGATIVE fixture for union narrowing: a match over `i64 | f64 | bool | text`
# that names only three of the four members and has no wildcard. The
# synthesized `__Union_bool_f64_i64_text` enum is `@closed`, so the EXISTING
# closed-enum exhaustiveness rule must report the missing member -- this
# fixture exists so a gate that stopped reporting it would go red rather than
# silent. Bug doc:
# doc/08_tracking/bug/union_narrowing_has_no_grammar_or_runtime_2026-08-21.md
fn narrow_missing(x: i64 | f64 | bool | text) -> i64:
    match x:
        case i64 v: v
        case f64 f: 2
        case bool b: 3
