# Fixture for lane S4 (union normalization) — a structural union type must
# lower to a CHECKED closed sum, never to Any.
#
# The union is written in a signature, which is where a union is authored.
# The driver runs union_normalize_module over the lowered HIR and must report
# a synthesized `@closed` enum __Union_bool_f64_i64_text for it.

fn tag(x: i64 | f64 | bool | text) -> i64:
    1

fn tag_reordered(x: text | bool | i64 | f64) -> i64:
    2
