# Native compiler regression probe: both methods must execute, not lower to 0.
class SessionProbe:
    state: i64

impl SessionProbe:
    me settle() -> Result<bool, text>:
        self.state = 41
        Ok(true)

    me finish() -> Result<i64, text>:
        if self.state != 41: return Err("settle did not execute")
        Ok(self.state + 1)

fn session_probe_open() -> Result<SessionProbe?, text>:
    Ok(Some(SessionProbe(state: 0)))


export SessionProbe, session_probe_open
