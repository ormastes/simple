# Native compatibility probe: preserve the imported session owner explicitly.
use test.fixtures.buildrunner.session_unwrap_owner.{SessionProbe, session_probe_open}

fn main() -> i64:
    val maybe_database = match session_probe_open():
        Ok(value): value
        Err(_): return 2
    if maybe_database == nil: return 3
    val database: SessionProbe = maybe_database!
    if database.settle().is_err(): return 4
    val finished = database.finish()
    if finished.is_err(): return 5
    val value = finished.unwrap()
    if value != 42: return 6
    print value
    0
