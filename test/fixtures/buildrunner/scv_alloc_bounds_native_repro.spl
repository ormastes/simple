use std.scv.alloc_bounds.{scv_bound_object_bytes, SCV_MAX_OBJECT_BYTES, SCV_ALLOC_DOMAIN_ID}
use std.scv.delta.{SCV_DELTA_MAX_DEPTH}
use std.scv.compile_source_inventory_core.{COMPILE_SOURCE_INVENTORY_SCHEMA_V1, COMPILE_SOURCE_INVENTORY_MAX_BYTES_V1}

fn main() -> i64:
    val below = scv_bound_object_bytes(17)
    val above = scv_bound_object_bytes(SCV_MAX_OBJECT_BYTES + 1)
    print "SCV_MAX_OBJECT_BYTES"
    print SCV_MAX_OBJECT_BYTES
    print "SCV_ALLOC_DOMAIN_ID"
    print SCV_ALLOC_DOMAIN_ID
    print "SCV_DELTA_MAX_DEPTH"
    print SCV_DELTA_MAX_DEPTH
    print "COMPILE_SOURCE_INVENTORY_SCHEMA_V1"
    print COMPILE_SOURCE_INVENTORY_SCHEMA_V1
    print "COMPILE_SOURCE_INVENTORY_MAX_BYTES_V1"
    print COMPILE_SOURCE_INVENTORY_MAX_BYTES_V1
    print "BELOW_BEGIN"
    print below
    print below.len()
    print "ABOVE_BEGIN"
    print above
    print above.len()
    print above.starts_with("ERROR scv allocation bound exceeded: object bytes requested 268435457, bound 268435456")
    if SCV_MAX_OBJECT_BYTES != 268435456: return 3
    if SCV_ALLOC_DOMAIN_ID != 7u32: return 4
    if SCV_DELTA_MAX_DEPTH != 10: return 5
    if COMPILE_SOURCE_INVENTORY_SCHEMA_V1 != 1: return 6
    if COMPILE_SOURCE_INVENTORY_MAX_BYTES_V1 != 268435456: return 7
    if below != "": return 1
    if not above.starts_with("ERROR scv allocation bound exceeded: object bytes requested 268435457, bound 268435456"):
        return 2
    print "SCV_BOUNDS_OK"
    0
