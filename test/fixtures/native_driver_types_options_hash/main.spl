use compiler.common.driver_core_types.{CompileOptions}
use compiler.driver.driver_types.{compute_options_hash}

fn configured_options(profile: text) -> CompileOptions:
    var options = CompileOptions.default()
    options.backend = "llvm"
    options.release = true
    options.debug_info = false
    options.profile = profile
    options.allowed_families = ["a", "b"]
    options

fn main():
    val first = compute_options_hash(configured_options("stage4-driver-types"))
    val same = compute_options_hash(configured_options("stage4-driver-types"))
    val changed = compute_options_hash(configured_options("stage4-driver-types-adjacent"))
    print("driver options hash resolved: {first.hash == same.hash}:{first.hash != changed.hash}")
