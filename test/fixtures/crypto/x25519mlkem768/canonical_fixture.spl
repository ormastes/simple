"""Canonical deterministic inputs shared by X25519MLKEM768 backend specs.

The NTT fixture is public test data, never key material. Native C and Swift
probes mirror fixture id ``ntt-v1-p97-i29-c17-q3329``; the C probes consume
the matching ``ntt_fixture.h`` helper directly.
"""

val X25519_MLKEM768_FIXTURE_ID = "x25519mlkem768-v1"
val X25519_MLKEM768_NTT_FIXTURE_ID = "ntt-v1-p97-i29-c17-q3329"
val X25519_MLKEM768_NTT_MODULUS: i64 = 3329
val X25519_MLKEM768_NTT_COEFFICIENTS: i64 = 256
val X25519_MLKEM768_NTT_BATCH: i64 = 3

fn x25519_mlkem768_fixture_list(count: i64, offset: i64) -> list:
    var out: list = []
    var i: i64 = 0
    while i < count:
        out.push((offset + i) & 0xFF)
        i = i + 1
    out

fn x25519_mlkem768_fixture_bytes(count: i64, offset: i64) -> [u8]:
    var out: [u8] = []
    var i: i64 = 0
    while i < count:
        out.push(((offset + i) & 0xFF).to_u8())
        i = i + 1
    out

fn x25519_mlkem768_fixture_list32(offset: i64) -> list:
    x25519_mlkem768_fixture_list(32, offset)

fn x25519_mlkem768_fixture_bytes32(offset: i64) -> [u8]:
    x25519_mlkem768_fixture_bytes(32, offset)

fn x25519_mlkem768_ntt_fixture(batch: i64) -> list:
    var out: list = []
    var polynomial: i64 = 0
    while polynomial < batch:
        var coefficient: i64 = 0
        while coefficient < X25519_MLKEM768_NTT_COEFFICIENTS:
            out.push((polynomial * 97 + coefficient * 29 + 17) %
                X25519_MLKEM768_NTT_MODULUS)
            coefficient = coefficient + 1
        polynomial = polynomial + 1
    out
