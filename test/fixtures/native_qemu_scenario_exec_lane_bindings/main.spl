use os.kernel.arch.arch_context.{Architecture}
use os.qemu_runner.{
    _arm_fs_exec_disk_image_has_required_smf,
    _riscv_fs_exec_disk_image_has_required_smf
}
use std.nogc_sync_mut.io.file_ops.{file_read}

fn has_lane_catalog_imports(path: text) -> bool:
    val source = file_read(path)
    val header_end = source.find("\nfn ")
    if header_end < 0:
        return false
    val header = source.slice(0, header_end)
    (header.contains("simpleos_platform_has_qemu_lane,") and
        header.contains("simpleos_platform_qemu_lane_or_smoke,"))

fn main() -> i64:
    val consumers = [
        "src/os/_QemuRunner/runner_targets.spl",
        "src/os/_QemuRunner/scenario_catalog.spl",
        "src/os/_QemuRunner/scenario_disks.spl",
        "src/os/_QemuRunner/scenario_exec.spl"
    ]
    for consumer in consumers:
        if not has_lane_catalog_imports(consumer):
            return 40
    val missing = "/tmp/simple-qemu-scenario-exec-lane-bindings-missing.img"
    if _arm_fs_exec_disk_image_has_required_smf(missing, Architecture.Arm64):
        return 41
    if _riscv_fs_exec_disk_image_has_required_smf(missing, Architecture.Riscv64):
        return 42
    0
