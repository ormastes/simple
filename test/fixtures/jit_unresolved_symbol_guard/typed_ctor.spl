# BAD INPUT on purpose: `[i64]()` is NOT a typed-empty-array constructor.
# It parses as a list literal `[i64]` (referencing the undefined variable
# `i64`) which is then CALLED. The interpreter diagnoses this
# (`variable 'i64' not found`); the seed JIT must diagnose too, never crash.
fn main():
    var x = [i64]()
    print("SHOULD_NOT_PRINT")
main()
