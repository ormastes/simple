# POISONED FIXTURE unit 5 of 6 — expected outcome: OK
#
# A deliberately trivial, valid module. It exists to prove that the supervisor
# still REACHES and compiles clean units that sit AFTER the poisoned ones. A
# build that abandons its work list on the first bad unit never gets here, and
# that is exactly the defect this fixture set detects.

fn clean_unit_five(n: i64) -> i64:
    n + 5

fn main():
    print "{clean_unit_five(0)}"
