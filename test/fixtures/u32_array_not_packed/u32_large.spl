# RSS-delta canary large leg: KNOWN-OPEN corroboration that `[u32]` is NOT a
# 4-byte-packed buffer (it is 8-byte tagged-word storage, same as every other
# array element type -- see the source-line evidence in
# doc/08_tracking/bug/rt_typed_words_u32_is_not_a_packed_pixel_basis_2026-08-06.md).
#
# check-u32-array-not-packed.shs measures peak RSS of this process against
# u32_control.spl's and divides the delta by ELEMENT_COUNT below. A true
# 4-byte-packed `[u32]` would show ~4 bytes/element (plus a little growth
# slack); the current (known-wrong) storage shows ~20-24 bytes/element.
# ELEMENT_COUNT must match the constant of the same name embedded in the
# check script's expectations comment.
fn main():
    val element_count: i64 = 5000000
    var a: [u32] = []
    var i: i64 = 0
    while i < element_count:
        a.push((i & 0xffffffff) as u32)
        i = i + 1
    println("len=" + a.len().to_text())
