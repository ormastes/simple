# Packed-basis probe: RT_CORE_ARRAY_FLAG_BYTES via rt_byte_array_new_len is a
# genuine dense 1-byte-stride buffer (unlike `[u32]` literal arrays, which are
# NOT packed -- see u32_control.spl / u32_large.spl in this fixture dir and
# doc/08_tracking/bug/rt_typed_words_u32_is_not_a_packed_pixel_basis_2026-08-06.md).
#
# `rt_byte_array_new_len(n)` must allocate exactly `n` bytes. This is the
# CORRECT, already-working half of the fence: the recommended packed
# alternative to `[u32]` for pixel/word buffers.
extern fn rt_byte_array_new_len(len: i64) -> [u8]

fn main():
    val buf8: [u8] = rt_byte_array_new_len(8 * 4)
    val buf1: [u8] = rt_byte_array_new_len(1 * 4)
    val buf1000: [u8] = rt_byte_array_new_len(1000 * 4)
    println("buf8_len=" + buf8.len().to_text())
    println("buf1_len=" + buf1.len().to_text())
    println("buf1000_len=" + buf1000.len().to_text())
