# POSITIVE control for the `@extern` ATTRIBUTE form: `rt_string_len` is a real
# exported runtime symbol, so this fixture MUST build and print `got 4`. It
# exists so the at_negative fixture cannot pass vacuously by "every `@extern`
# declaration is now rejected".
@extern fn rt_string_len(s: text) -> i64

fn main():
    print("got " + rt_string_len("abcd").to_string())
