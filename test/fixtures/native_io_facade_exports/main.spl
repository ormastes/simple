use app.io.mod.{file_read_bytes_i64, file_write_bytes, file_delete, dir_exists}
use std.io_runtime.{getpid}

fn main() -> i64:
    val path = ".native-io-facade-{getpid()}.bin"
    var expected: [u8] = []
    for value in 0..256:
        expected = expected.push(value.to_u8())
    if not file_write_bytes(path, expected):
        print "FAIL: binary fixture write"
        return 1
    val actual = file_read_bytes_i64(path)
    if not file_delete(path):
        print "FAIL: binary fixture cleanup"
        return 2
    if actual.len() != 256:
        print "FAIL: binary length {actual.len()}"
        return 3
    for value in 0..256:
        if actual[value] != value:
            print "FAIL: byte {value} returned {actual[value]}"
            return 4
    if file_read_bytes_i64(path).len() != 0:
        print "FAIL: missing file result"
        return 5
    if not dir_exists("."):
        print "FAIL: current directory result"
        return 6
    if dir_exists(path):
        print "FAIL: absent directory result"
        return 7
    print "IO facade exports: 256 bytes, missing file, directory checks passed"
    0
