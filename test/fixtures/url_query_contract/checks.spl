# Shared executable checks for the production query-string API. This helper is
# called by both the focused SSpec and a standalone bounded native fixture.
use std.nogc_sync_mut.http.url.{parse_query_param, parse_query_string, build_query_string}

fn url_query_contract_checks_v1() -> i64:
    var checks = 0

    # Negative values identify the first failed assertion. Each list check
    # reports its length separately from each ordered key/value field.
    if parse_query_string("").len() != 0: return -11
    if build_query_string([]) != "": return -12
    checks = checks + 1

    val multiple = parse_query_string("a=1&flag&empty=&dup=x&dup=y")
    if multiple.len() != 5: return -21
    if multiple[0].0 != "a": return -22
    if multiple[0].1 != "1": return -23
    if multiple[1].0 != "flag": return -24
    if multiple[1].1 != "": return -25
    if multiple[2].0 != "empty": return -26
    if multiple[2].1 != "": return -27
    if multiple[3].0 != "dup": return -28
    if multiple[3].1 != "x": return -29
    if multiple[4].0 != "dup": return -30
    if multiple[4].1 != "y": return -31
    checks = checks + 1

    val flag = parse_query_param("flag")
    if flag.0 != "flag": return -32
    if flag.1 != "": return -33
    checks = checks + 1

    val empty = parse_query_param("empty=")
    if empty.0 != "empty": return -41
    if empty.1 != "": return -42
    checks = checks + 1

    val token = parse_query_param("token=a=b")
    if token.0 != "token": return -51
    if token.1 != "a=b": return -52
    checks = checks + 1

    val decoded = parse_query_string("name=caf%C3%A9&space=a+b")
    if decoded.len() != 2: return -61
    if decoded[0].0 != "name": return -62
    if decoded[0].1 != "café": return -63
    if decoded[1].0 != "space": return -64
    if decoded[1].1 != "a b": return -65
    checks = checks + 1

    val encoded = build_query_string([("a", "hello world"), ("emoji", "café")])
    if encoded != "a=hello%20world&emoji=caf%C3%A9": return -7
    checks = checks + 1

    val original = [("a", "one"), ("b", "two words"), ("a", "café")]
    val roundtrip = parse_query_string(build_query_string(original))
    if roundtrip.len() != 3: return -81
    if roundtrip[0].0 != "a": return -82
    if roundtrip[0].1 != "one": return -83
    if roundtrip[1].0 != "b": return -84
    if roundtrip[1].1 != "two words": return -85
    if roundtrip[2].0 != "a": return -86
    if roundtrip[2].1 != "café": return -87
    checks = checks + 1

    checks
