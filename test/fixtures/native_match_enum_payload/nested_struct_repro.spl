struct Point:
    x: i64
    y: i64

enum Shape2:
    Dot(Point)
    Nowhere

fn describe(s: Shape2) -> text:
    match s:
        case Shape2.Dot(Point { x: a, y: b }):
            return "dot:" + a.to_text() + "," + b.to_text()
        case Shape2.Nowhere:
            return "nowhere"

fn main() -> i32:
    val p = Shape2.Dot(Point { x: 7, y: 9 })
    val n = Shape2.Nowhere
    val dp = describe(p)
    val dn = describe(n)
    print(dp)
    print(dn)
    if dp == "dot:7,9" and dn == "nowhere":
        print("PASS")
        return 0
    else:
        print("FAIL")
        return 1
