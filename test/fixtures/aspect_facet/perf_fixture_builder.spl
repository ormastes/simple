"""Build the deterministic SFM2 aspect pack used by the native NFR probe."""

use std.cli.cli_util.{get_cli_args}
use std.io_runtime.{file_write_bytes}
use std.sfm.aspect_pack.{AspectPackCompression, AspectPackPayload, encode_aspect_pack}
use std.sfm.manifest.{FeatureManifest, SfmSecurityLevel}
use test.fixtures.aspect_facet.runtime_fixture.{facet_runtime_fixture_smf}

fn build_aspect_perf_fixture() -> [u8]:
    val smf = facet_runtime_fixture_smf()
    encode_aspect_pack(
        FeatureManifest(
            name: "aspect-facet-perf", version: "1.0.0",
            security_level: SfmSecurityLevel.Trusted, layers: []),
        [AspectPackPayload(
            module_id: "fixture.debug", aspect_id: "fixture.debug",
            compression: AspectPackCompression.None,
            uncompressed_size: smf.len(), dictionary_id: 0,
            stored_bytes: smf)]).unwrap()

fn aspect_perf_builder_output(args: [text]) -> text:
    var index = 0
    while index < args.len():
        if args[index] == "--output" and index + 1 < args.len():
            return args[index + 1]
        if args[index].starts_with("--output="):
            return args[index]["--output=".len():]
        index = index + 1
    "build/test-artifacts/aspect-facet-nfr/fixture.sfm"

fn main() -> i64:
    val output = aspect_perf_builder_output(get_cli_args())
    if not file_write_bytes(output, build_aspect_perf_fixture()):
        print "aspect_facet_fixture_error=write_failed"
        return 1
    print "aspect_facet_fixture_path={output}"
    0

export build_aspect_perf_fixture, main
