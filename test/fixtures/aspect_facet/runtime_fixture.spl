"""Deterministic ordinary-SMF fixture for facet activation and perf probes."""

use compiler.common.structural_contracts.facet_artifact.{
    FACET_ARTIFACT_VERSION, FacetBindingArtifactSummary,
    encode_facet_binding_summaries, facet_witness_symbol
}
use compiler.driver.smf_writer.{
    SmfBuildOptions, Target, generate_smf_with_raw_code_options
}

fn facet_runtime_fixture_binding() -> FacetBindingArtifactSummary:
    FacetBindingArtifactSummary(
        contract_version: FACET_ARTIFACT_VERSION,
        binding_id: "fixture.debug.binding", aspect_id: "fixture.debug",
        concrete_type_id: "fixture.Cache", business_interface_id: "",
        facet_interface_id: "Debuggable",
        facet_contract_abi_hash: "fixture-facet-abi-v1",
        witness_symbol: facet_witness_symbol("fixture_debug"),
        capabilities: ["facet.read"])

fn facet_runtime_fixture_smf() -> [u8]:
    var options = SmfBuildOptions.create(Target.x86_64_unknown_linux_gnu())
    options.export_symbol_name = facet_witness_symbol("fixture_debug")
    options.facet_binding_bytes = encode_facet_binding_summaries(
        [facet_runtime_fixture_binding()])
    # x86_64: mov eax, 73; ret. The same loader-owned witness is used by the
    # native advice probe, which must observe this exact result. It is not a
    # receiver-aware facet ABI and must never be reported as facet-call proof.
    generate_smf_with_raw_code_options(
        [0xB8, 0x49, 0x00, 0x00, 0x00, 0xC3], options).unwrap()

export facet_runtime_fixture_binding, facet_runtime_fixture_smf
