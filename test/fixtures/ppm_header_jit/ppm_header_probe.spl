# Prints the header bytes `encode_ppm_p6` writes for a 12x34 frame. Run by
# test/01_unit/lib/common/ppm_header_jit_parity_spec.spl under the
# interpreter and the JIT; both must print the ASCII bytes of "P6\n12 34\n255\n".
use common.image.ppm_decode.{encode_ppm_p6}

fn main() -> i64:
    val bytes = encode_ppm_p6(12u32, 34u32, [0xFF000000u32; 408])
    var s = "header="
    var i = 0
    while i < 13 and i < bytes.len():
        s = s + "{bytes[i] as i64} "
        i = i + 1
    print s + "len={bytes.len()}"
    0
