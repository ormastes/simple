use std.daemon_sdk.types.{daemon_request_new}
use nogc_sync_mut.daemon_sdk.protocol.{write_daemon_request}

extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool

fn main() -> i64:
    val request = daemon_request_new(7)
    val request_path = write_daemon_request(request, "/tmp")
    val passed = request_path != "" and rt_file_exists(request_path)
    if request_path != "":
        rt_file_delete(request_path)
    print("daemon protocol atomic rename resolved: {passed}")
    if passed: 0 else: 1
