# Minimal real disk round-trip fixture for rt_io_file_* under native-build.
# See doc/08_tracking/bug/rt_io_file_family_interpreter_fixed_native_still_stubbed_2026-08-05.md
#
# Writes a fixed byte string to a path passed as argv[1] (so the shell fence
# can inspect the file from OUTSIDE the process afterward -- a stub that
# fakes an in-process read would still be caught by that external stat/cat),
# reads it back, and asserts byte-for-byte equality plus size().

use std.nogc_sync_mut.io.file.{FileHandle, File}
use std.common.io.types.{FileMode, SeekFrom}

fn main() -> i64:
    val path = "/tmp/rt_io_file_roundtrip_probe.txt"

    File.delete(path)

    val wh = match FileHandle.open(path, FileMode.WriteOnly):
        case Ok(h): h
        case Err(e):
            print("VERDICT: FAIL open WriteOnly failed")
            return 1
    match wh.write_text("0123456789"):
        case Ok(_): pass
        case Err(e):
            print("VERDICT: FAIL write_text failed")
            return 1
    match wh.close():
        case Ok(_): pass
        case Err(e):
            print("VERDICT: FAIL close after write failed")
            return 1

    if not File.exists(path):
        print("VERDICT: FAIL File.exists false after write")
        return 1

    val rh = match FileHandle.open(path, FileMode.ReadOnly):
        case Ok(h): h
        case Err(e):
            print("VERDICT: FAIL open ReadOnly failed")
            return 1
    val content = match rh.read_text():
        case Ok(c): c
        case Err(e):
            print("VERDICT: FAIL read_text failed")
            return 1
    val sz = match rh.size():
        case Ok(n): n
        case Err(e):
            print("VERDICT: FAIL size() failed")
            return 1
    match rh.close():
        case Ok(_): pass
        case Err(e):
            print("VERDICT: FAIL close after read failed")
            return 1

    if content != "0123456789":
        print("VERDICT: FAIL content mismatch got=[{content}]")
        return 1

    if sz != 10:
        print("VERDICT: FAIL size mismatch got={sz}")
        return 1

    print("VERDICT: PASS rt_io_file roundtrip ok")
    return 0
