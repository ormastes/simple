use compiler.frontend.flat_ast_bridge.{parse_and_build_module}

fn main() -> i64:
    val source = (
        "on pc{{ execution(* target(..)) }} use advice before priority 10\n" +
        "forbid pc{{ import(test.internal.*) }} \"forbidden import\"\n" +
        "allow pc{{ import(test.public.*) }} \"allowed import\"\n"
    )
    val module = parse_and_build_module(source, "native_aop_arch_owner.spl")
    if module.aop_advices.len() != 1:
        return 41
    val advice = module.aop_advices[0]
    if advice.handler != "advice" or advice.form != "before" or advice.priority != 10:
        return 42
    if advice.pointcut != "execution ( * target ( .. ) )":
        return 43
    if module.arch_rules.len() != 2:
        return 44
    val first_rule = module.arch_rules[0]
    if first_rule.kind != "forbid" or first_rule.message != "forbidden import" or first_rule.pointcut != "import ( test . internal . * )":
        return 45
    val second_rule = module.arch_rules[1]
    if second_rule.kind != "allow" or second_rule.message != "allowed import" or second_rule.pointcut != "import ( test . public . * )":
        return 46
    0
