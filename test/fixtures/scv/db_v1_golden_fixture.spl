fn setup_item2_v1_golden_vectors() -> [Item2V1GoldenVector]:
    val config_revision = "sha256:v1:68783e2bbffb08f00142782ee44818cf2f38c70864f9d8e01ae1b639af2c9fbd"
    val reproduction_revision = "sha256:v1:bb01a55aecaac4644cdc98f0b953fc1b2af4bfd9b6f01cf056000f520dc1b5f5"
    val observation_revision = "sha256:v1:aa82a174c0c53160e6cfbe2ce1b54fed21e1bd983e45027e35dd77dc4a6cecc8"
    val config_ref = setup_item2_v1_golden_ref("config", 128u64, config_revision)
    val reproduction_ref = setup_item2_v1_golden_ref("reproduction", 1u64, reproduction_revision)
    val definition = setup_item2_v1_golden_ref("test", 1u64, "sha256:v1:" + "4".repeat(64))
    val config = DbReproductionRecord.Config(DbConfigRevision(reference: config_ref, effective_values_digest: "sha256:v1:" + "a".repeat(64), dependencies: []))
    val reproduction = DbReproductionRecord.Reproduction(DbReproductionRevision(reference: reproduction_ref, source_revision: "sha256:v1:" + "2".repeat(64), test_definition: definition, config: config_ref, invocation_digest: "sha256:v1:" + "3".repeat(64), dependencies: []))
    val observation = DbReproductionRecord.Observation(DbObservation(reference: setup_item2_v1_golden_ref("observation", 1u64, observation_revision), provider: DbProviderIdentity(instance: "i", project: "p", run: "r", job: "j", attempt: 128u64, dimensions: []), source_revision: "sha256:v1:" + "2".repeat(64), test_definition: definition, config: config_ref, case_revision: setup_item2_v1_golden_ref("case", 1u64, "sha256:v1:" + "6".repeat(64)), run: setup_item2_v1_golden_ref("run", 1u64, "sha256:v1:" + "7".repeat(64)), actual: "FAIL", measurements: [DbEvidenceMeasurement(name: "m", value: 18446744073709551615u64, unit: "ns")], failure_signature: "é", custom_config: true, reproduction: Some(reproduction_ref), payload_digest: "sha256:v1:" + "5".repeat(64)))
    val header = "SCVDB-REPRODUCTION-RECORD-v1\n"
    [
        Item2V1GoldenVector(name: "config", record: config, wire: header + _item2_v1_config_wire_hex() + "\n", preimage_hex: _item2_v1_config_preimage(), digest: config_revision),
        Item2V1GoldenVector(name: "reproduction", record: reproduction, wire: header + _item2_v1_reproduction_wire_hex() + "\n", preimage_hex: _item2_v1_reproduction_preimage(), digest: reproduction_revision),
        Item2V1GoldenVector(name: "observation", record: observation, wire: header + _item2_v1_observation_wire_hex() + "\n", preimage_hex: _item2_v1_observation_preimage(), digest: observation_revision)
    ]

export Item2V1GoldenVector, setup_item2_v1_golden_vectors
