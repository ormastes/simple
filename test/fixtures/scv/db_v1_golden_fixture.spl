# Independently derived SCVDB reproduction-v1 framing vectors, 2026-10-03.
# Not historic emitted-wire captures and not an externally certified test set.
# Expected literals below were composed from the v1 frame algebra, then hashed
# once with .NET SHA256 tooling; no Simple codec/runtime generated expectations.
# The original v1 builders are also present at repository commit 76899528004.
#
# F(t,p) = one-byte tag || minimal unsigned LEB128(byte_length(p)) || p.
# T(s)=F(03,UTF8(NFC(s))); U(n)=F(02,LEB128(n)); L(xs)=F(06,concat(xs)).
# UID(k,c)=F(28,T(32 ASCII zeroes)||T(k)||T(32 ASCII ones)||U(c)).
# R(k,c)=F(1f,UID(k,c)); RR(k,c,h)=L([R(k,c),T("sha256:v1:"+h)]).
# Own-revision hash substitutes R for RR ONLY at body position1; dependency
# references retain their RR, including semantic digest. Prepend exactly the
# 41 bytes UTF8("scv-db/reproduction-record-content-v1/v1") then NUL (included
# in that count). SHA256 of this literal preimage gives the frozen own digest.
#
# Config body: L([T("config"),RR(config,128,C),T("sha256:v1:"+64*a),L([])]).
# Reproduction: L([T("reproduction"),RR(reproduction,1,R),T(source),
# RR(test,1,64*4),RR(config,128,C),T(invocation),L([])]).
# Observation: L([T("observation"),RR(observation,1,O),provider,T(source),
# RR(test,1,64*4),RR(config,128,C),RR(case,1,64*6),RR(run,1,64*7),
# T("FAIL"),L([L([T("m"),U(u64max),T("ns")])]),T("é"),F(01,01),
# RR(reproduction,1,R),T(payload)]).
# provider=L([T("i"),T("p"),T("r"),T("j"),U(128),L([])]).
# source/invocation/payload are sha256:v1: followed by 64*2 / 64*3 / 64*5.
# Byte edges: U(128)=02 02 80 01; U(u64max)=02 0a ff ff ff ff ff ff ff ff ff 01;
# T("é")=03 02 c3 a9 (already NFC). No normalization oracle is implied.
# Config preimage214 / body wire252 bytes; reproduction624 /662;
# observation1163 /1201. Wire body outer lengths cross127; textual wire
# is ASCII header SCVDB-REPRODUCTION-RECORD-v1 + LF + lowercase hex + LF.
# Tests assert literals against production. Runtime execution is UNEXECUTED.
use std.scv.db_evidence.*
use std.scv.db_reproduction_codec.{DbReproductionRecord}
use std.scv.distributed_identity.*

struct Item2V1GoldenVector:
    name: text
    record: DbReproductionRecord
    wire: text
    preimage_hex: text
    digest: text

fn setup_item2_v1_golden_ref(kind: text, counter: u64, revision: text) -> DbEvidenceRevision:
    DbEvidenceRevision(entity: entity_ref_provisional(EntityUid(database_namespace: "00000000000000000000000000000000", entity_kind: kind, actor: ActorIncarnation(hex: "11111111111111111111111111111111"), counter: counter)), revision: revision)

