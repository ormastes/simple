# Pure canonical-record fixtures. These hashes identify test values, not CAS
# availability, provider authentication, or durable accepted-state receipts.
use std.spec.*
use std.scv.db_evidence.*
use std.scv.db_ci_ingest.{DbCiCapabilities}
use std.scv.db_observation_identity.*
use std.scv.db_reproduction_codec.*
use std.scv.distributed_identity.*
use std.common.crypto.sha256.{sha256_text}

fn setup_item2_identity_ref(kind: text, counter: u64) -> DbEvidenceRevision:
    DbEvidenceRevision(entity: entity_ref_provisional(EntityUid(database_namespace: "00112233445566778899aabbccddeeff", entity_kind: kind, actor: ActorIncarnation(hex: "ffeeddccbbaa99887766554433221100"), counter: counter)), revision: "sha256:v1:" + sha256_text("fixture-reference:" + kind))

fn setup_item2_identity_policy() -> DbObservationIdentityPolicy:
    val capabilities = DbCiCapabilities(identity_dimensions: ["attempt", "case", "instance", "job", "label", "project", "run"], uniqueness_tuple: ["attempt", "case", "instance", "job", "project", "run"], event_hints: true, polling: true, bundle_import: true, artifact_download: true, attestations: false, pagination: true, maximum_bundle_bytes: 1048576u64)
    db_observation_identity_policy_seal(DbObservationIdentityPolicy(revision: "", namespace: "00112233445566778899aabbccddeeff", epoch: 1u64, provider_instance: "ci.fixture.invalid", project: "repo-1", capabilities: capabilities)).unwrap()

fn setup_item2_identity_seal(value: DbObservation) -> DbObservation:
    match db_reproduction_record_seal(DbReproductionRecord.Observation(value)).unwrap():
        Observation(observation): observation
        _: fail("observation seal changed record kind")

fn setup_item2_identity_observation(counter: u64 = 1u64, attempt: u64 = 1u64) -> DbObservation:
    setup_item2_identity_seal(DbObservation(reference: setup_item2_identity_ref("observation", counter), provider: DbProviderIdentity(instance: "ci.fixture.invalid", project: "repo-1", run: "run-1", job: "job-1", attempt: attempt, dimensions: [DbIdentityDimension(name: "case", value: "case-A"), DbIdentityDimension(name: "label", value: "runner-A")]), source_revision: "sha256:v1:" + sha256_text("source bytes"), test_definition: setup_item2_identity_ref("test_definition", 1u64), config: setup_item2_identity_ref("config", 1u64), case_revision: setup_item2_identity_ref("case", 1u64), run: setup_item2_identity_ref("run", 1u64), actual: "PASS", measurements: [DbEvidenceMeasurement(name: "duration", value: 7u64, unit: "ns")], failure_signature: "", custom_config: false, reproduction: nil, payload_digest: "sha256:v1:" + sha256_text("payload bytes")))

export setup_item2_identity_ref, setup_item2_identity_policy, setup_item2_identity_seal, setup_item2_identity_observation
