use std.spec.*
use std.common.text_bytes.{text_to_bytes}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.scv.solver_contract_v1.*
use std.scv.solver_source_v1.*
use std.scv.solver_simple_v1.*
use std.scv.solver_host_v1.*
use std.scv.solver_simple_host_v1.*

fn setup_simple_source_fixture() -> SourceSimpleMergeInputV1:
    val source = "fn alpha() -> i64:\n    1\n\nfn beta() -> i64:\n    2\n"
    val bytes = text_to_bytes(source)
    val first = source.index_of("    1") + 4
    val second = source.index_of("    2") + 4
    val base = SourceFileV1(file_uid: "file-simple", revision: "base", path: "src/simple.spl", kind: "regular", mode: "100644", bytes: bytes)
    var left = base
    left.revision = "left"
    left.bytes = bytes[0:first] + text_to_bytes("10") + bytes[first + 1:]
    var right = base
    right.revision = "right"
    right.bytes = bytes[0:second] + text_to_bytes("20") + bytes[second + 1:]
    val a = SourceEntityEditV1(operation_id: "edit-alpha", producer_id: "accepted-editor", file_uid: base.file_uid, entity_uid: "entity-alpha", identity_map_revision: "identity-r1", base_revision: base.revision, side_revision: left.revision, start_byte: first, end_byte: first + 1, expected_base_digest: sha256_u8_hex(bytes[first:first + 1]), replacement: text_to_bytes("10"))
    val b = SourceEntityEditV1(operation_id: "edit-beta", producer_id: "accepted-editor", file_uid: base.file_uid, entity_uid: "entity-beta", identity_map_revision: "identity-r1", base_revision: base.revision, side_revision: right.revision, start_byte: second, end_byte: second + 1, expected_base_digest: sha256_u8_hex(bytes[second:second + 1]), replacement: text_to_bytes("20"))
    SourceSimpleMergeInputV1(raw: SourceMergeInputV1(base: base, left: left, right: right, moves: []), edits: [a, b])

fn freeze_simple_source_fixture(input: SourceSimpleMergeInputV1) -> SolveRequestV1:
    val raw = input.raw
    val binding = SolveBindingV1(repository: "repo", namespace: "source", domain: "source.simple", base_revision: raw.base.revision, left_revision: raw.left.revision, right_revision: raw.right.revision, base_model_id: source_file_digest_v1(raw.base), left_model_id: source_file_digest_v1(raw.left), right_model_id: source_file_digest_v1(raw.right), expected_root: source_file_digest_v1(raw.base), schema_revision: "simple-entity-edit-v1", policy_revision: "accepted-policy", routing_revision: "accepted-route", identity_map_revision: "identity-r1", parser_lock_digest: "accepted-parser", solver_lock_digest: "accepted-solver", profile_digest: "simple-exact-entity-edits-v1", configuration_digest: "accepted-config", operation_bundle_digest: source_simple_operations_digest_v1(input), authorization_scope: "draft-only")
    SolveRequestV1(request_id: "simple-request", binding: binding, logical_work_budget: 2000000, memory_budget: 2000000, cancelled: false)

fn setup_simple_source_policy(request: SolveRequestV1) -> SolverHostPolicyV1:
    val ids = solver_builtin_ids_v1("source.simple")
    SolverHostPolicyV1(expected: request.binding, parser: ParserProvider(provider_id: ids[0], lock_digest: request.binding.parser_lock_digest), model: DomainModelProvider(provider_id: ids[1], lock_digest: "accepted-model"), solver: SolverProvider(provider_id: ids[2], lock_digest: request.binding.solver_lock_digest), validators: [], publisher: Publisher(provider_id: "unavailable", lock_digest: ""))

fn exercise_simple_source_fixture(input: SourceSimpleMergeInputV1) -> SimpleSourceSolveV1:
    val request = freeze_simple_source_fixture(input)
    solve_simple_source_v1(request, setup_simple_source_policy(request), input)

fn check_simple_source_conflict(input: SourceSimpleMergeInputV1, code: text):
    val solved = exercise_simple_source_fixture(input)
    expect(solved.candidate).to_be_nil()
    expect(solved.result.conflicts[0].code).to_equal(code)
    expect(solved.result.status).to_equal("needs_inputs")
    expect(solved.inputs.raw.left.bytes).to_equal(input.raw.left.bytes)
    expect(solved.inputs.raw.right.bytes).to_equal(input.raw.right.bytes)

export setup_simple_source_fixture, freeze_simple_source_fixture
export setup_simple_source_policy, exercise_simple_source_fixture, check_simple_source_conflict
