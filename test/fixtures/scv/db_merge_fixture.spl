# Real signed local-publication fixtures. ACL admission deliberately permits
# items/tags while their merge schemas are absent, so rejection reaches schema.
use std.scv.db_patch.{DbPatch}
use std.scv.db_admission.{DbAdmissionPolicy, DbPermission, db_admission_policy_digest}
use std.scv.db_reducer.{MergePolicy, DbFieldSchema, FieldMergeRule}
use test.fixtures.scv.db_apply_fixture.{setup_item2_apply_policy, setup_item2_apply_merge}

fn setup_item2_merge_admission(patches: [DbPatch]) -> DbAdmissionPolicy:
    var policy = setup_item2_apply_policy(patches)
    var signer = policy.keys[0]
    signer.permissions = signer.permissions + [DbPermission(operation: "update", kind: "bug", field: "note"), DbPermission(operation: "update", kind: "bug", field: "items"), DbPermission(operation: "update", kind: "bug", field: "tags")]
    policy.keys = [signer]
    policy.revision = db_admission_policy_digest(policy).unwrap()
    policy

fn setup_item2_merge_rules() -> MergePolicy:
    var policy = setup_item2_apply_merge()
    policy.fields = policy.fields + [DbFieldSchema(kind: "bug", field: "note", rule: FieldMergeRule.ScalarConflict)]
    policy

export setup_item2_merge_admission, setup_item2_merge_rules
