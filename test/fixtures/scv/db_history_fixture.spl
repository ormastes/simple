# Actual producer admission, retained generations, CAS and signed checkpoint.
# Reviewed metadata below is fixture policy, never inferred by production code.
use std.spec.{expect}
use app.io.mod.{dir_create, file_write_bytes}
use app.scv.db.ci_projection.*
use app.scv.db.historical_model.*
use app.scv.db.historical_archive.*
use app.scv.db.local_apply.*
use app.scv.db.local_store.*
