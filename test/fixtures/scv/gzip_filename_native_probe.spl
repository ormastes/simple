# Gzip's optional filename must retain its text/UTF-8 type in native lowering.
use std.nogc_sync_mut.compression.gzip.header.{gzip_header_create}

# Independent content oracle: direct typed-array comparison does not prove
# byte equality (see type_pool_fixture_content_assertion_conversion_2026_10_16).
fn gzip_filename_bytes_match(actual: [u8], expected: [u8]) -> bool:
    if actual.len() != expected.len(): return false
    var index = 0
    while index < actual.len():
        if actual[index] != expected[index]: return false
        index = index + 1
    true

fn main() -> i64:
    val absent = gzip_header_create(nil, 0, 0, 3)
    if not gzip_filename_bytes_match(absent, [31u8,139u8,8u8,0u8,0u8,0u8,0u8,0u8,0u8,3u8]): return 10
    val empty = gzip_header_create("", 0, 0, 3)
    if not gzip_filename_bytes_match(empty, [31u8,139u8,8u8,8u8,0u8,0u8,0u8,0u8,0u8,3u8,0u8]): return 11
    val utf8 = gzip_header_create("λ.txt", 0, 0, 3)
    if not gzip_filename_bytes_match(utf8, [31u8,139u8,8u8,8u8,0u8,0u8,0u8,0u8,0u8,3u8,206u8,187u8,46u8,116u8,120u8,116u8,0u8]): return 12
    print "GZIP_FILENAME_NATIVE: PASS"
    0
