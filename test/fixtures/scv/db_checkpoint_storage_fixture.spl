use std.common.crypto.sha256.{sha256_text}

# Storage fixture only; does not claim a signed checkpoint or verified closure.
fn setup_item2_checkpoint_descriptor(phase: text, channel: text, source: text, pending: text, anchor: text, installed: text) -> text:
    val journal = sha256_text("immutable journal fixture")
    "SCVDB-CHECKPOINT-INSTALL-v1\n{phase}\n{channel}\n{source}\n{pending}\n{anchor}\n{installed}\n{journal}\n"

export setup_item2_checkpoint_descriptor
