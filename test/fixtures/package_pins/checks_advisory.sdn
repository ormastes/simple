# NEGATIVE support fixture: one gate covering `fixture-core` is advisory, so a
# critical pin on it must be rejected with E-PIN-005 even though the
# differential gate is present and mandatory.
checks:
  - name: check-fixture-structure.shs
    status: advisory
    differential: false
    covers:
      - fixture-core
  - name: check-fixture-parity.shs
    status: mandatory
    differential: true
    covers:
      - fixture-core
