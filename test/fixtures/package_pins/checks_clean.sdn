# Support fixture: every gate covering `fixture-core` is mandatory, and one of
# them is differential, so preconditions 3 and 4 are both satisfied.
checks:
  - name: check-fixture-structure.shs
    status: mandatory
    differential: false
    covers:
      - fixture-core
      - fixture-base
  - name: check-fixture-parity.shs
    status: mandatory
    differential: true
    covers:
      - fixture-core
