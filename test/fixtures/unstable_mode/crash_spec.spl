"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing FIXTURES-UNSTABLE_MODE behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/fixtures/unstable_mode/crash_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
# @manual: primary
# REQ-FIXTURES-UNSTABLE_MODE-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# =====================================================================
# DELIBERATE FIXTURE — NOT A PRODUCT DEFECT.
# Lane: unstable_test_mode (lane C, test/fixtures/unstable_mode/**).
# This spec CRASHES ON PURPOSE (kills its own PID by signal) so that the
# test runner's CRASHED outcome class has something honest to detect.
# Do not "fix" it. Deleting it removes the only proof unstable mode works.
#
# earlyoom disambiguation: earlyoom is SIGTERMing processes named `simple`
# on this host, which also looks like death-by-signal. So this fixture
# WRITES A SENTINEL FILE immediately before crashing itself:
#   sentinel present + died by signal = a REAL CRASH
#   sentinel absent  + died by signal = TERMINATED / UNVERIFIED (earlyoom)
# Sentinel path is the LANDED CONTRACT from lane B,
# `take_crash_sentinel` in test_executor_parsing.spl: `<spec_path>.crashed`.
# The runner deletes it on read, so a stale sentinel cannot mislabel a
# later run.
#
# @skip  <- keeps it out of DEFAULT discovery (test_runner_files.spl skips
#           any file whose content contains "# @skip").
# Selecting it back: `--only-skipped` does NOT match "# @skip" -- it matches the
# literal selector `tag: "skip"` (test_runner_files.spl, slow path; the manifest
# fast path uses entry.skip_tag). Both markers are therefore required:
# "# @skip" to stay out, `tag: "skip"` to be reachable by explicit request.
# Without the second one the directory run discovers 0 files and reports
# "No test files found" with exit 4 -- measured.
# =====================================================================
use std.spec.*
use std.fs.*
use std.nogc_sync_mut.ffi.system.*

# Four crash mechanisms were tried. Three do NOT work — recorded so nobody
# re-tries them:
#   - unbounded recursion: the tree-walk interpreter guards it at depth 1000
#     and reports an ordinary assertion failure ("stack overflow: recursion
#     depth 1000 exceeded") — exactly the outcome this fixture must NOT give;
#   - `extern fn abort()`: `semantic: unknown extern function: abort` — the
#     interpreter only resolves the runtime's `rt_*` exports;
#   - `extern fn rt_panic(...)`: also `unknown extern function`; the extern
#     allowlist is narrow, even though the release profile is `panic = abort`;
#   - `rt_process_kill(rt_getpid())`: only kills processes in the runtime's
#     SPAWNED_CHILDREN registry, so on our own PID it returns false and the
#     spec then PASSES — a false green, the worst possible outcome here.
# What works is SIGKILL on our own PID via the shell.
extern fn rt_getpid() -> i64

describe "unstable mode crash fixture":
    it "writes a sentinel and then dies by signal":
        # @oracle: this scenario asserts through a file-local helper wrapping expect(<value>).to_equal(<expected>)
        # @req: REQ-FIXTURES-UNSTABLE_MODE-001
        step("Verify: writes a sentinel and then dies by signal")
        # @capture: assertion outcomes retained in the spec Results output as evidence
        file_write_text("test/fixtures/unstable_mode/crash_spec.spl.crashed", "deliberate crash fixture: about to die by signal")
        val pid = rt_getpid()
        shell("kill -9 {pid}")
        expect(1).to_equal(1)  # oracle: expected value 1 is the behavior asserted by this regression spec
