use compiler.tools.fix.rules.helpers.{byte_offset_of, line_start_offset, line_end_offset, levenshtein}
use compiler.tools.fix.rules.impl_.error_fix.{suggest_typo_fix, suggest_type_coercion_fix}

fn main() -> i64:
    val source = "abc\ndef"
    match suggest_typo_fix("fixture.spl", 1, 1, 0, 5, "pritn", ["print"]):
        case Some(fix):
            if fix.replacements.len() != 1 or fix.replacements[0].new_text != "print":
                return 11
        case _: return 12

    match suggest_type_coercion_fix("fixture.spl", 1, 1, 3, "String", "Int"):
        case Some(fix):
            if fix.replacements.len() != 1 or fix.replacements[0].new_text != ".to_string()":
                return 13
        case _: return 14
    val passed = (
        byte_offset_of(source, 2, 2) == 5 and
        line_start_offset(source, 2) == 4 and
        line_end_offset(source, 1) == 3 and
        levenshtein("kitten", "sitting") == 3
    )
    print("fix rule helper i64 contracts resolved: {passed}")
    if passed: 0 else: 15
