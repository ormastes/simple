use std.nogc_sync_mut.src.core.decorators.{CachedFunction}

val cached_fn = CachedFunction(wrapped_fn: nil, cache: {}, hits: 0, misses: 0)
assert cached_fn.cache_info()["size"] == 0
cached_fn.cache["a"] = 1
cached_fn.cache["b"] = 2
assert cached_fn.cache_info()["size"] == 2
cached_fn.cache["a"] = 3
assert cached_fn.cache_info()["size"] == 2
cached_fn.clear_cache()
assert cached_fn.cache_info()["size"] == 0
print "decorators-cache-cardinality-ok"
