# Must NOT compile natively: a struct key on a generic class field declared
# `Dict<K, _>`. The class's own (erased) methods key that dict by the struct
# POINTER; the concrete `b.d[...]` would key it by the struct's field.
# Build: SIMPLE_BOOTSTRAP=1 native-build refuse_generic_class_field.spl --entry-closure
# Expected: build fails; diagnostics contain E-MIR-STRUCT-DICT-KEY and Sid.
# (The seed interpreter compares struct keys by value and prints `1`.)

struct Sid:
    id: i64

class GBox<K>:
    d: Dict<K, i64>

    me put(k: K):
        self.d[k] = 1

fn main():
    var b = GBox<Sid>(d: {})
    b.put(Sid(id: 2))
    print "{b.d[Sid(id: 2)] ?? -1}"
