# Must NOT compile natively: a value-keyed struct dict handed to a generic
# `Dict<K, _>` parameter. The erased body would key it by the struct POINTER
# while the caller keys it by the struct's field, so `gget` would miss and
# `gkeys` would hand back field words typed as `Sid` (a wild dereference).
# Build: SIMPLE_BOOTSTRAP=1 native-build refuse_generic_arg.spl --entry-closure
# Expected: build fails; diagnostics contain E-MIR-STRUCT-DICT-KEY and Sid.
# (The seed interpreter compares struct keys by value and prints `1 3`.)

struct Sid:
    id: i64

fn gget<K>(d: Dict<K, i64>, k: K) -> i64:
    d[k] ?? -1

fn gkeys<K>(d: Dict<K, i64>) -> [K]:
    d.keys()

fn main():
    var d: Dict<Sid, i64> = {}
    d[Sid(id: 3)] = 1
    var n = 0
    for k in gkeys(d):
        n = n + k.id
    print "{gget(d, Sid(id: 3))} {n}"
