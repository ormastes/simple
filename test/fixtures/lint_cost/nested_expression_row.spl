# Fixture: a function whose body is a deeply nested call expression, the shape
# that dominates lint cost in src/compiler/50.mir/hwir/zca_rows.spl.
# Deliberately lint-clean: single-parameter helpers avoid the
# unnamed_duplicate_typed_args rule, so the only findings this file can produce
# are ones a regression introduced.
# Used by test/01_unit/compiler/lint/lint_terminates_with_verdict_spec.spl.

fn inc(a: i64) -> i64:
    return a + 1

fn nested_row() -> i64:
    return inc(inc(inc(inc(inc(inc(1)))))) +
           inc(inc(inc(inc(inc(inc(2)))))) +
           inc(inc(inc(inc(inc(inc(3))))))
