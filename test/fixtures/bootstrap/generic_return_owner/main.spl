# Caller owns a different Node; the generic provider returns a third owner's
# Node, which does not appear in the concrete type argument or display name.
use test.fixtures.bootstrap.generic_return_owner.provider.{wrap, listed, maybe, erase}

struct Node:
    title: text
    weight: i64

fn main() -> i64:
    val decoy = Node(title: "decoy", weight: 41)
    val real = wrap("marker")
    val records = listed(9)
    val optional = maybe(true)
    val erased = erase(13)
    var optional_count = 0
    if val node = optional:
        optional_count = node.name_count()
    var labels = ""
    for label in real.names:
        labels = labels + label
    print "names={labels} count={real.name_count()} array={records[0].title} optional={optional_count} decoy={decoy.weight} erased={erased}"
    0
