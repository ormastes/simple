# Differential case: fields of a multi-parameter generic struct instance carry the instance types.
# Class: generic struct field typed as the type PARAMETER (intensive-tests BUG-IT-6).
# Expected stdout:
#   joined=ab

struct Pair<A, B>:
    a: A
    b: B

fn main() -> i64:
    val p = Pair<text, text>(a: "a", b: "b")
    val joined = p.a + p.b
    print "joined={joined}"
    0
