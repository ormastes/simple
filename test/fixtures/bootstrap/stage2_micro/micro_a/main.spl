# Stage2 micro-program A: core value features on the stage2 native path.
# Expected stdout:
#   sum=55 evens=5 txt=a-b-c len=3 pt=7 shape=circle:3 area=36 opt=42 none=-1 fact=120 fib=55

struct Point:
    x: i64
    y: i64

enum Shape:
    Circle(i64)
    Rect(i64, i64)
    Dot

fn area(s: Shape) -> i64:
    match s:
        case Shape.Circle(r):
            r * r * 3 + 1
        case Shape.Rect(w, h):
            w * h
        case Shape.Dot:
            0

fn label(s: Shape) -> text:
    match s:
        case Shape.Circle(r):
            "circle:{r}"
        case Shape.Rect(_, _):
            "rect"
        case Shape.Dot:
            "dot"

fn fact(n: i64) -> i64:
    if n <= 1:
        return 1
    n * fact(n - 1)

fn fib(n: i64) -> i64:
    var a = 0
    var b = 1
    var i = 0
    while i < n:
        val t = a + b
        a = b
        b = t
        i = i + 1
    a

fn pick(flag: bool) -> i64?:
    if flag:
        Some(42)
    else:
        nil

fn main() -> i64:
    var sum = 0
    var evens = 0
    for i in 1..11:
        sum = sum + i
        if i % 2 == 0:
            evens = evens + 1
    val parts = ["a", "b", "c"]
    var txt = ""
    var k = 0
    for p in parts:
        if k > 0:
            txt = txt + "-"
        txt = txt + p
        k = k + 1
    val pt = Point(x: 3, y: 4)
    val c = Shape.Circle(3)
    val r = Shape.Rect(4, 7)
    val some = pick(true)
    val none = pick(false)
    val o = some ?? -1
    val n = none ?? -1
    print "sum={sum} evens={evens} txt={txt} len={parts.len()} pt={pt.x + pt.y} shape={label(c)} area={area(c) + area(r) + area(Shape.Dot) - 20} opt={o} none={n} fact={fact(5)} fib={fib(10)}"
    0
