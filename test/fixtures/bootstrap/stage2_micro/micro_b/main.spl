# Stage2 micro-program B: closures, generics, traits and Result on the stage2 native path.
# Expected stdout:
#   adder=15 twice=14 sum_i=6 pick=b res=ok:9 err=negative trait=14
# (The generic-struct/generic-impl case lives in micro_e: it fails at link on stage2 — BUG-IT-3.)

trait Area:
    fn area(self) -> i64

struct Sq:
    s: i64

struct Rc:
    w: i64
    h: i64

impl Area for Sq:
    fn area(self) -> i64:
        self.s * self.s

impl Area for Rc:
    fn area(self) -> i64:
        self.w * self.h

fn pick_second<C>(a: C, b: C) -> C:
    b

fn sum_all(xs: [i64]) -> i64:
    var acc = 0
    for x in xs:
        acc = acc + x
    acc

fn make_adder(k: i64) -> fn(i64) -> i64:
    \x: x + k

fn apply_twice(f: fn(i64) -> i64, v: i64) -> i64:
    f(f(v))

fn parse_pos(v: i64) -> Result<i64, text>:
    if v < 0:
        return Err("negative")
    Ok(v)

fn sum_pos(a: i64, b: i64) -> Result<i64, text>:
    val x = parse_pos(a)?
    val y = parse_pos(b)?
    Ok(x + y)

fn show(r: Result<i64, text>) -> text:
    match r:
        case Ok(v):
            "ok:{v}"
        case Err(e):
            e

fn main() -> i64:
    val add5 = make_adder(5)
    val adder = add5(10)
    val twice = apply_twice(make_adder(2), 10)
    val sum_i = sum_all([1, 2, 3])
    val pick = pick_second("a", "b")
    val pick_n = pick_second(1, 2)
    val sq = Sq(s: 3)
    val rc = Rc(w: 1, h: 5)
    val trait_sum = sq.area() + rc.area()
    print "adder={adder} twice={twice} sum_i={sum_i} pick={pick} res={show(sum_pos(4, 5))} err={show(sum_pos(-1, 2))} trait={trait_sum}"
    if pick_n != 2:
        return 1
    0
