# Differential case: a free generic fn instantiated at `text` returns text, not a raw integer.
# Class: wrong code for the text instance of a generic (intensive-tests BUG-IT-5).
# Expected stdout:
#   pick=b len=1 same=true num=2

fn pick_second<C>(a: C, b: C) -> C:
    b

fn main() -> i64:
    val pick = pick_second("a", "b")
    val num = pick_second(1, 2)
    val l = pick.len()
    val same = pick == "b"
    print "pick={pick} len={l} same={same} num={num}"
    0
