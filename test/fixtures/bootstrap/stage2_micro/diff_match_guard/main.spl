# Differential case: `case pattern if guard:` evaluates the guard; a false guard falls through.
# Class: match guards ignored (CURRENT_BUG_PREVENTION section 3).
# Expected stdout:
#   a=big b=small c=neg d=zero p=even q=odd

enum Num:
    Val(i64)
    Nothing

fn size(n: i64) -> text:
    match n:
        case x if x > 100:
            "big"
        case x if x > 0:
            "small"
        case x if x < 0:
            "neg"
        case _:
            "zero"

fn parity(n: Num) -> text:
    match n:
        case Num.Val(v) if v % 2 == 0:
            "even"
        case Num.Val(v):
            "odd"
        case Num.Nothing:
            "none"

fn main() -> i64:
    print "a={size(500)} b={size(5)} c={size(-5)} d={size(0)} p={parity(Num.Val(4))} q={parity(Num.Val(5))}"
    0
