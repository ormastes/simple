# Differential case: `for (i, x) in xs.enumerate()`.
# Class: for-in iteration shapes that do not lower (intensive-tests BUG-IT-9).
# Expected stdout:
#   acc=0:a,1:b,2:c

fn main() -> i64:
    val xs = ["a", "b", "c"]
    var acc = ""
    for (i, x) in xs.enumerate():
        if i > 0:
            acc = acc + ","
        acc = acc + "{i}:{x}"
    print "acc={acc}"
    0
