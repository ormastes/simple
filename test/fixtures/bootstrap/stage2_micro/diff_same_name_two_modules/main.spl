# Differential case: the same simple name defined in two modules binds to the imported one at
# each use, not to a first-hit global.
# Class: RBH T09; transitive bare names (5a4e937a6d1 / 44ae909f04b),
# hir_package_sibling_shadows_own_type_2026-10-10.
# Expected stdout:
#   left=left:1 right=right:2 own=own

use test.fixtures.bootstrap.stage2_micro.diff_same_name_two_modules.left.{left_tag}
use test.fixtures.bootstrap.stage2_micro.diff_same_name_two_modules.right.{right_tag}

fn label_of() -> text:
    "own"

fn main() -> i64:
    print "left={left_tag()} right={right_tag()} own={label_of()}"
    0
