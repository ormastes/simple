# Stage2 micro-program I: a generic value through every variable-change kind.
# Expected stdout:
#   let=x var=y param=p ret=m chain=c field=f gfield=g elem=e dict=v coal=d
#   cap=k loop=ab range=3 concat=xy arith=7 cmp=true ifx=a tmpl=t
#   box=7 boxs=sb bag=ab first=a! n=3
# Expected values are the seed interpreter's (`simple run`). Each field is one kind of
# doc/05_design/compiler/generics/generic_instantiation_model.md §2: the argument of `keep<T>`
# is bound through that kind, and a wrong instantiation shows as a pointer printed as an
# integer, a SEGV, or an undefined symbol at link (BUG-IT-3 / BUG-IT-5 class).

struct S:
    name: text

struct Box<T>:
    item: T

impl<T> Box<T>:
    fn get(self) -> T:
        self.item

struct Bag<T>:
    items: [T]
    first: T?

fn keep<T>(x: T) -> T:
    x

fn keep_local<T>(x: T) -> T:
    val k = x
    keep(k)

fn mk() -> text:
    "m"

fn use_param(p: text) -> text:
    keep(p)

fn main() -> i64:
    val a: text = "x"
    val k_let = keep(a)
    var b = "x"
    b = "y"
    val k_var = keep(b)
    val k_param = use_param("p")
    val k_ret = keep(mk())
    val c1 = keep("c")
    val k_chain = keep(c1)
    val s = S(name: "f")
    val k_field = keep(s.name)
    val bx = Box(item: "g")
    val k_gfield = keep(bx.item)
    val xs = ["e", "z"]
    val k_elem = keep(xs[0])
    val d: Dict<text, text> = {"k": "v"}
    val k_dict = keep(d["k"])
    val o: text? = nil
    val k_coal = keep(o ?? "d")
    print "let={k_let} var={k_var} param={k_param} ret={k_ret} chain={k_chain} field={k_field} gfield={k_gfield} elem={k_elem} dict={k_dict} coal={k_coal}"

    val cap = "k"
    val f = \n: keep(cap)
    val k_cap = f(1)
    var joined = ""
    for w in ["a", "b"]:
        joined = joined + keep(w)
    var total = 0
    for i in 0..3:
        total = total + keep(i) - i + 1
    val k_concat = keep(a + "y")
    val two = 2
    val k_arith = keep(two * 3 + 1)
    val k_cmp = keep(two > 1)
    val k_if = keep(if two > 1: "a" else: "b")
    val k_tmpl = keep_local("t")
    print "cap={k_cap} loop={joined} range={total} concat={k_concat} arith={k_arith} cmp={k_cmp} ifx={k_if} tmpl={k_tmpl}"

    val bi = Box<i64>(item: 7)
    val bs = Box(item: "s")
    val got = bs.get()
    val bag = Bag(items: ["a", "b"], first: "a")
    val first = bag.first ?? "z"
    val nums = Bag(items: [1, 2], first: 1)
    print "box={bi.get()} boxs={got + \"b\"} bag={bag.items[0] + bag.items[1]} first={first + \"!\"} n={nums.items[0] + nums.items[1]}"
    0
