# Stage2 micro-program G: a two-parameter generic struct whose fields are READ (no methods).
# Expected stdout:
#   pair=ab n=7
# Measured 2026-10-10 (stage2 49cbd00527, release/1.0 @ b68c0c65708), as part of micro_e:
#   MIR lowering error: unresolved method call: operator overload for struct A (no matching __add__/...)
# -- the field's declared type is the type PARAMETER `A`, and `p.a + p.b` is lowered as if `A` were a
# struct named A instead of the instance's text (intensive-tests/BUGS.md BUG-IT-6).

struct Pair<A, B>:
    a: A
    b: B

fn main() -> i64:
    val p = Pair<text, i64>(a: "a", b: 7)
    val q = Pair<text, text>(a: "a", b: "b")
    print "pair={q.a + q.b} n={p.b}"
    0
