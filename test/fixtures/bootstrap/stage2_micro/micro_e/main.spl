# Stage2 micro-program E: a generic struct with a generic impl method, called at one type.
# Expected stdout:
#   box=7
# Baseline 2026-10-10 (stage2 49cbd00527, release/1.0 @ b68c0c65708): BUILD FAIL at link —
#   lld-link: error: undefined symbol: <module>.Box.get
# The generic impl method stays a non-emittable template and the call site is never repointed
# at a specialization; nothing diagnoses it before the linker (intensive-tests/BUGS.md BUG-IT-3).

struct Box<T>:
    item: T

impl<T> Box<T>:
    fn get(self) -> T:
        self.item

fn main() -> i64:
    val bx = Box<i64>(item: 7)
    print "box={bx.get()}"
    0
