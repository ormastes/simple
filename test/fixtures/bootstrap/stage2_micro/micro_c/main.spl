# Stage2 micro-program C: text, dict, array and tuple handling on the stage2 native path.
# Expected stdout:
#   words=4 longest=alpha upper=ALPHA joined=alpha,beta,gamma,delta count_a=1 has_zeta=false q=3 r=1 sorted=1,2,5,9 sub=lph

fn longest(words: [text]) -> text:
    var best = ""
    for w in words:
        if w.len() > best.len():
            best = w
    best

fn join(words: [text], sep: text) -> text:
    var out = ""
    var i = 0
    for w in words:
        if i > 0:
            out = out + sep
        out = out + w
        i = i + 1
    out

fn divmod(a: i64, b: i64) -> (i64, i64):
    (a / b, a % b)

fn insertion_sort(xs: [i64]) -> [i64]:
    var out: [i64] = []
    for x in xs:
        var placed = false
        var next: [i64] = []
        for y in out:
            if not placed and x < y:
                next.push(x)
                placed = true
            next.push(y)
        if not placed:
            next.push(x)
        out = next
    out

fn render(xs: [i64]) -> text:
    var out = ""
    var i = 0
    for x in xs:
        if i > 0:
            out = out + ","
        out = out + str(x)
        i = i + 1
    out

fn main() -> i64:
    val words = ["alpha", "beta", "gamma", "delta"]
    var counts: Dict<text, i64> = {}
    for w in words:
        val first = w.substring(0, 1)
        val prev = counts.get(first) ?? 0
        counts[first] = prev + 1
    val count_a = counts.get("a") ?? 0
    val has_zeta = counts.contains_key("z")
    val (q, r) = divmod(10, 3)
    val sorted = insertion_sort([5, 1, 9, 2])
    val sub = words[0].substring(1, 4)
    print "words={words.len()} longest={longest(words)} upper={words[0].upper()} joined={join(words, \",\")} count_a={count_a} has_zeta={has_zeta} q={q} r={r} sorted={render(sorted)} sub={sub}"
    0
