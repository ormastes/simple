# Differential case: an untyped `var c = []` keeps its collection identity for later method calls.
# Class: untyped_var_collection_binding_loses_identity_2026-10-10 (MIR: unresolved method call).
# Expected stdout:
#   len=2 first=1 has=true

fn main() -> i64:
    var c = []
    c.push(1)
    c.push(5)
    var d = {}
    d["k"] = 1
    val first = c.get(0)
    val has = d.contains_key("k")
    print "len={c.len()} first={first} has={has}"
    0
