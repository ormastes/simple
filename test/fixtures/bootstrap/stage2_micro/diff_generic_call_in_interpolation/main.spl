# Differential case: a generic call inside a string-interpolation segment is monomorphized.
# Class: mono call-site walk skips interpolation segments (intensive-tests BUG-IT-8).
# Expected stdout:
#   direct=2

fn pick_second<C>(a: C, b: C) -> C:
    b

fn main() -> i64:
    print "direct={pick_second(1, 2)}"
    0
