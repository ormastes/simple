use compiler.driver.driver_build.native_file_worker_v1.{native_file_worker_serial_low_memory_admitted_v1}

fn main() -> i64:
    assert(native_file_worker_serial_low_memory_admitted_v1(1, "", "1"))
    assert(native_file_worker_serial_low_memory_admitted_v1(0, "", "1"))
    assert(not native_file_worker_serial_low_memory_admitted_v1(1, "SIMPLE_HIR_CACHE=0", "1"))
    assert(not native_file_worker_serial_low_memory_admitted_v1(1, "", ""))
    assert(not native_file_worker_serial_low_memory_admitted_v1(2, "", "1"))
    print "serial-pool=ok"
    0
