# Differential case: a Dict miss coalesces with `??`, and the coalesced value is a usable integer.
# Class: seed_dict_miss_coalesce_increment_2026-10-10 (there the SEED was the wrong side: it
# printed prev=nil got=4; the gate's oracle lane records a seed that disagrees with this header).
# Expected stdout:
#   prev=0 got=1 miss_is_nil=true

fn main() -> i64:
    var counts: Dict<text, i64> = {}
    val prev = counts["a"] ?? 0
    counts["a"] = prev + 1
    val got: i64 = counts["a"]
    var c3: Dict<text, i64> = {}
    val miss = c3["zz"]
    val miss_is_nil = miss == nil
    print "prev={prev} got={got} miss_is_nil={miss_is_nil}"
    0
