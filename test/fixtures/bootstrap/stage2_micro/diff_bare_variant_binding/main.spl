# Differential case: bare unit variants in a `case A | B:` or-pattern are variants, not bindings.
# Class: bare-variant-untyped-subject (rel-p3run PROBLEMS.md P3-HIR-1; stage2 said
# "or-pattern alternatives must bind the same variables: [Add] vs [Sub]").
# Expected stdout:
#   add=arith sub=arith eq=cmp neg=other

enum Op:
    Add
    Sub
    Eq
    Neg

fn pick(i: i64) -> Op:
    if i == 0:
        return Op.Add
    if i == 1:
        return Op.Sub
    if i == 2:
        return Op.Eq
    Op.Neg

fn kind(op) -> text:
    match op:
        case Add | Sub:
            "arith"
        case Eq:
            "cmp"
        case _:
            "other"

fn main() -> i64:
    print "add={kind(pick(0))} sub={kind(pick(1))} eq={kind(pick(2))} neg={kind(pick(3))}"
    0
