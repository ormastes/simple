# Differential case: open-ended ranges with a missing begin or end.
# Class: RBH T04 (open-ended range optionality).
# Expected stdout:
#   tail=3 head=2 mid=2 text=cd

fn main() -> i64:
    val xs = [10, 20, 30, 40]
    val tail = xs[1..]
    val head = xs[..2]
    val mid = xs[1..3]
    val s = "abcd"
    val st = s[2..]
    print "tail={tail.len()} head={head.len()} mid={mid.len()} text={st}"
    0
