# Differential case: array builtin methods `sorted`, `reversed`, `index_of`.
# Class: missing builtin lowerings on array receivers (intensive-tests BUG-IT-10).
# Expected stdout:
#   sorted=1,2,3 rev=2,1,3 idx=1 first=3 len=3

fn join_all(xs: [i64]) -> text:
    var out = ""
    var first = true
    for x in xs:
        if not first:
            out = out + ","
        out = out + "{x}"
        first = false
    out

fn main() -> i64:
    val xs = [3, 1, 2]
    val s = join_all(xs.sorted())
    val r = join_all(xs.reversed())
    val idx = xs.index_of(1)
    print "sorted={s} rev={r} idx={idx} first={xs[0]} len={xs.len()}"
    0
