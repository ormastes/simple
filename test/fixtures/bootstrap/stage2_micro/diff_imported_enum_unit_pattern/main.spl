# Differential case: unit variants of an IMPORTED enum match by their owner, bare or qualified.
# Class: canonical_imported_enum_unit_pattern_owner_2026-10-10, enum_field_receiver_80030_2026-10-10.
# Expected stdout:
#   red=warm blue=cool green=cool held=warm

use test.fixtures.bootstrap.stage2_micro.diff_imported_enum_unit_pattern.colors.{Color, Paint, make_paint}

fn temp(c: Color) -> text:
    match c:
        case Red:
            "warm"
        case Color.Blue | Color.Green:
            "cool"

fn main() -> i64:
    val p = make_paint()
    print "red={temp(Color.Red)} blue={temp(Color.Blue)} green={temp(Color.Green)} held={temp(p.color)}"
    0
