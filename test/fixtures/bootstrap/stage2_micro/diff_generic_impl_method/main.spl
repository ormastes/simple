# Differential case: a method of a generic `impl<T>` is callable on an instance.
# Class: generic impl method call links against a symbol nothing emits (intensive-tests BUG-IT-3).
# Expected stdout:
#   got=7

struct Box<T>:
    item: T

impl<T> Box<T>:
    fn get(self) -> T:
        self.item

fn main() -> i64:
    val b = Box<i64>(item: 7)
    val got = b.get()
    print "got={got}"
    0
