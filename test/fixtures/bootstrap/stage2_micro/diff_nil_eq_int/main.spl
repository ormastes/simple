# Differential case: `== nil` on a non-optional value is false; on a real nil it is true.
# Class: `== nil` true for 3 (CURRENT_BUG_PREVENTION section 5 nil-comparison folding,
# intensive-tests review_nil probe).
# Expected stdout:
#   three=false zero=false flag=false some=false none=true ne=true

fn maybe(i: i64) -> i64?:
    if i > 0:
        return i
    nil

fn main() -> i64:
    val three: i64 = 3
    val zero: i64 = 0
    val flag: bool = false
    val some = maybe(3)
    val none = maybe(0)
    print "three={three == nil} zero={zero == nil} flag={flag == nil} some={some == nil} none={none == nil} ne={three != nil}"
    0
