# Stage2 micro-program H: a free generic fn called INSIDE a string interpolation.
# Expected stdout:
#   direct=2 len=1
# Split out of micro_f on 2026-10-10: with this call present the whole program failed at link with
#   lld-link: error: undefined symbol: pick_second
# although `[mono]` reported call_sites=6 specializations=3 unresolved=0 — one call-site position is
# not repointed at its specialization (intensive-tests/BUGS.md BUG-IT-8).

fn pick_second<C>(a: C, b: C) -> C:
    b

fn main() -> i64:
    print "direct={pick_second(1, 2)} len={pick_second("a", "b").len()}"
    0
