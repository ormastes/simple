# Differential case: a struct returned by an imported fn (whose type lives in a third module)
# keeps its field types at the call site.
# Class: stage2_imported_fn_foreign_struct_return_type_erased_2026-10-10 (`src.names` typed I64).
# Expected stdout:
#   names=a,b count=2

use test.fixtures.bootstrap.stage2_micro.diff_imported_struct_return.state.{node_get}

fn main() -> i64:
    val src = node_get(0)
    var acc = ""
    for name in src.names:
        if acc.len() > 0:
            acc = acc + ","
        acc = acc + name
    print "names={acc} count={src.names.len()}"
    0
