# Differential case: a method call on a trait-typed value dispatches to the implementor.
# Class: stage2_trait_typed_receiver_method_unresolved_2026-10-10 (unresolved method call on a
# trait-object field).
# Expected stdout:
#   sq=9 rc=5 total=14

trait Area:
    fn area(self) -> i64

struct Sq:
    s: i64

struct Rc:
    w: i64
    h: i64

impl Area for Sq:
    fn area(self) -> i64:
        self.s * self.s

impl Area for Rc:
    fn area(self) -> i64:
        self.w * self.h

struct Holder:
    shape: Area

fn measure(a: Area) -> i64:
    a.area()

fn main() -> i64:
    val h = Holder(shape: Sq(s: 3))
    val sq = h.shape.area()
    val rc = measure(Rc(w: 1, h: 5))
    print "sq={sq} rc={rc} total={sq + rc}"
    0
