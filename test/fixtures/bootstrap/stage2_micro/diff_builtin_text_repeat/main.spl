# Differential case: text builtin methods, including `repeat`.
# Class: missing builtin lowerings on text receivers (intensive-tests BUG-IT-10).
# Expected stdout:
#   rep=ababab up=AB starts=true idx=1 trim=x

fn main() -> i64:
    val s = "ab"
    val rep = s.repeat(3)
    val up = s.upper()
    val starts = s.starts_with("a")
    val idx = s.index_of("b")
    val trimmed = "  x ".trim()
    print "rep={rep} up={up} starts={starts} idx={idx} trim={trimmed}"
    0
