# Differential case: text <-> number conversions and text ordinals.
# Class: text casts / missing builtin lowerings (native_text_ord_missing_lowering_2026-10-10).
# Expected stdout:
#   n=42 sum=43 t=17 cat=17! ord=65 len=3

fn main() -> i64:
    val n = "42".to_i64()
    val sum = n + 1
    val k: i64 = 17
    val t = k.to_text()
    val cat = t + "!"
    val o = "A".ord()
    val l = "abc".len()
    print "n={n} sum={sum} t={t} cat={cat} ord={o} len={l}"
    0
