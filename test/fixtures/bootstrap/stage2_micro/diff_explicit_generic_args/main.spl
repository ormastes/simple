# Differential case: explicit generic call arguments `f<T>(...)` must reach monomorphization.
# Class: explicit generic args dropped (E-MONO-032 on `f<T>(...)`,
# mutex_lock_return_only_generic_needs_call_type_2026-10-10, mono_visitor_fn_param_any_e_mono_032).
# Expected stdout:
#   id=7 name=x zero=0 empty=0

fn ident<T>(v: T) -> T:
    v

fn none_of<T>() -> [T]:
    []

fn zero_len<T>(xs: [T]) -> i64:
    xs.len()

fn main() -> i64:
    val a = ident<i64>(7)
    val b = ident<text>("x")
    val e: [i64] = none_of<i64>()
    val z = zero_len<text>([])
    print "id={a} name={b} zero={z} empty={e.len()}"
    0
