# Stage2 micro-program D: the smallest multi-module closure (entry + one sibling module).
# Expected stdout:
#   value=14 steps=3 reset=value=0 steps=4
# Baseline 2026-10-10 (stage2 49cbd00527, release/1.0 @ b68c0c65708): PASS, build 189 s.
# Module names are the repo-relative path with only a leading `src/` stripped, so the sibling is
# `test.fixtures.bootstrap.stage2_micro.micro_d.util` (run.shs passes this dir as a --source root).

use test.fixtures.bootstrap.stage2_micro.micro_d.util.{Op, Counter, fresh, describe}

fn main() -> i64:
    var c = fresh()
    c = c.apply(Op.Add(6))
    c = c.apply(Op.Mul(2))
    c = c.apply(Op.Add(0))
    val d = c.apply(Op.Reset)
    print "{describe(c)} reset={describe(d)}"
    0
