# Provider module for micro_d (smallest multi-module closure: entry + one sibling module).

pub enum Op:
    Add(i64)
    Mul(i64)
    Reset

pub struct Counter:
    value: i64
    steps: i64

impl Counter:
    fn apply(self, op: Op) -> Counter:
        match op:
            case Op.Add(n):
                Counter(value: self.value + n, steps: self.steps + 1)
            case Op.Mul(n):
                Counter(value: self.value * n, steps: self.steps + 1)
            case Op.Reset:
                Counter(value: 0, steps: self.steps + 1)

pub fn fresh() -> Counter:
    Counter(value: 1, steps: 0)

pub fn describe(c: Counter) -> text:
    "value={c.value} steps={c.steps}"
