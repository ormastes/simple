# Differential case: numeric builtin methods `abs`.
# Class: missing builtin lowerings on numeric receivers (intensive-tests BUG-IT-10).
# Expected stdout:
#   abs=5 neg=-9

fn main() -> i64:
    val a: i64 = -5
    val b: i64 = 2
    val c: i64 = 9
    val av = a.abs()
    val ng = (b - c - b).abs() * -1
    print "abs={av} neg={ng}"
    0
