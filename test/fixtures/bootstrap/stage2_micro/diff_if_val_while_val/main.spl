# Differential case: `if val` and `while val` bind the optional payload and stop on nil.
# Class: if_val_optional_payload_owner_2026-10-10, while_val_synthetic_true_identifier_2026-10-10
# (HIR: unresolved name true), optional_nil_arm_stale_producer_2026-10-10.
# Expected stdout:
#   hit=4 miss=-1 sum=6

var cursor: i64 = 3

fn half(n: i64) -> i64?:
    if n % 2 == 0:
        return n / 2
    nil

fn next_item() -> i64?:
    if cursor == 0:
        return nil
    cursor = cursor - 1
    cursor + 1

fn probe(n: i64) -> i64:
    if val h = half(n):
        return h
    -1

fn main() -> i64:
    var sum = 0
    while val item = next_item():
        sum = sum + item
    print "hit={probe(8)} miss={probe(7)} sum={sum}"
    0
