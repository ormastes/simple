# Differential case: fixed-size array fields survive native Stage 2 surface projection.
# Class: optional Expr payload passed to the non-optional semantic encoder (SIGSEGV).
# Expected stdout:
#   fixed-array-surface

@repr("C")
struct ExtendedCtxRv:
    bytes: [u8; 264]

fn main() -> i64:
    print "fixed-array-surface"
    0
