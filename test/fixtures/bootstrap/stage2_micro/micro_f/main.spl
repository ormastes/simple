# Stage2 micro-program F: narrows BUG-IT-5 (micro_b printed `pick=140702706262542`
# for `pick_second("a", "b")`). Each line isolates one variable: the generic specialized at text
# vs a non-generic twin, the binding form, and the consumer (interpolation / .len() / ==).
# Expected stdout:
#   g_untyped=b g_typed=b g_len=1 g_eq=true n_untyped=b n_len=1 g_int=2 g_struct=3
# (A generic call embedded directly in the interpolation lives in micro_h: it fails at link.)
# Baseline 2026-10-10 (stage2 49cbd00527, release/1.0 @ b68c0c65708): builds, then SEGV (rc=139) with no
# output — using the `text` instance of pick_second (.len(), ==) crashes; micro_b only printed it and got an
# integer. intensive-tests/BUGS.md BUG-IT-5.

struct Acc:
    n: i64

fn pick_second<C>(a: C, b: C) -> C:
    b

fn pick_second_text(a: text, b: text) -> text:
    b

fn main() -> i64:
    val g_untyped = pick_second("a", "b")
    val g_typed: text = pick_second("a", "b")
    val g_len = pick_second("a", "b").len()
    val g_eq = pick_second("a", "b") == "b"
    val n_untyped = pick_second_text("a", "b")
    val g_int = pick_second(1, 2)
    val g_struct = pick_second(Acc(n: 1), Acc(n: 3))
    print "g_untyped={g_untyped} g_typed={g_typed} g_len={g_len} g_eq={g_eq} n_untyped={n_untyped} n_len={n_untyped.len()} g_int={g_int} g_struct={g_struct.n}"
    0
