# Differential case: an empty array literal argument does not block inference from a later argument.
# Class: mono type-arg inference abort on `[]` (intensive-tests BUG-IT-2, E-MONO-032).
# Expected stdout:
#   a=9 b=7

fn first_or<C>(xs: [C], fallback: C) -> C:
    if xs.len() > 0:
        return xs[0]
    fallback

fn main() -> i64:
    val a = first_or([], 9)
    val b = first_or([7], 9)
    print "a={a} b={b}"
    0
