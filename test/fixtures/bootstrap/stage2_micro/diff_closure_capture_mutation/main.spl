# Differential case: a closure WRITE to a captured local is REJECTED by both compilers (declared
# capture semantics: closures capture enclosing locals by value and are read-only).
# Class: RBH T08 (captured `flag=true`, `counter+=1` in a hook).
# Expected: reject

fn run_twice(hook: fn() -> i64) -> i64:
    hook()
    hook()

fn main() -> i64:
    var flag = false
    var counter = 0
    val hook = fn() -> i64:
        flag = true
        counter = counter + 1
        counter
    run_twice(hook)
    print "flag={flag} counter={counter}"
    0
