# Differential case: a facade `__init__.spl` that re-exports with `export use owner.{A, B, C}`
# under a generated `# Re-exported from` owner comment binds every name to its real owner.
# Class: runtime_export_comment_origins_2026-10-10 (`# Re-exported from` comment hints turned a
# middle name of an explicit `export use` list into an invalid export origin).
# Expected stdout:
#   a=1 b=2 c=3 d=4

use test.fixtures.bootstrap.stage2_micro.diff_reexport_facade.facade.{alpha, beta, gamma, delta}

fn main() -> i64:
    print "a={alpha()} b={beta()} c={gamma()} d={delta()}"
    0
