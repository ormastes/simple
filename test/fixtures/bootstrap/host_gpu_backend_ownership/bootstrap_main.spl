extern fn rt_vulkan_async_session_supported() -> i64

fn main() -> i64:
    if rt_host_gpu_active_backend_handle() != 0: return 1
    if rt_vulkan_async_session_supported() != 0: return 2
    print "PASS GPU mixed provider: both zero-valued exports reachable"
    0
