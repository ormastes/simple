use probe.writer.{write_state_v1}
use probe.reader.{check_state_v1}

fn main() -> i64:
    var failures = check_state_v1(false)
    write_state_v1(true)
    failures = failures + check_state_v1(true)
    write_state_v1(false)
    failures = failures + check_state_v1(false)
    print "ASSERTIONS=18 FAILURES={failures}"
    failures
