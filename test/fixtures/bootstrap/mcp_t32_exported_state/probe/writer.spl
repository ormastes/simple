use app.mcp_t32.session_state.{McpT32Session, McpT32HistoryItem, MCP_T32_SESSIONS, MCP_T32_CURRENT_SESSION, MCP_T32_CURRENT_CORE, MCP_T32_HISTORY, MCP_T32_AREA_READY, MCP_T32_AREA_NAME}

pub fn write_state_v1(populated: bool):
    if populated:
        MCP_T32_SESSIONS = [McpT32Session(id: "fixture", host: "unused", port: 0, intercom_name: "", architecture: "arm", connected: false, cores: [])]
        MCP_T32_CURRENT_SESSION = "fixture-session"
        MCP_T32_CURRENT_CORE = "fixture-core"
        MCP_T32_HISTORY = [McpT32HistoryItem(command: "fixture-only", result: "record-only", session_id: "fixture-session", core_id: "fixture-core", request_id: "fixture-request")]
        MCP_T32_AREA_READY = true
        MCP_T32_AREA_NAME = "fixture-area"
    else:
        MCP_T32_SESSIONS = []
        MCP_T32_CURRENT_SESSION = ""
        MCP_T32_CURRENT_CORE = ""
        MCP_T32_HISTORY = []
        MCP_T32_AREA_READY = false
        MCP_T32_AREA_NAME = ""
