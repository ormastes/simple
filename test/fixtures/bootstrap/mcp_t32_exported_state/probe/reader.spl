use app.mcp_t32.session_state.{McpT32Session, McpT32HistoryItem, MCP_T32_SESSIONS, MCP_T32_CURRENT_SESSION, MCP_T32_CURRENT_CORE, MCP_T32_HISTORY, MCP_T32_AREA_READY, MCP_T32_AREA_NAME}

pub fn check_state_v1(populated: bool) -> i64:
    val count = if populated: 1 else: 0
    val session = if populated: "fixture-session" else: ""
    val core = if populated: "fixture-core" else: ""
    val area = if populated: "fixture-area" else: ""
    var failures = 0
    failures = failures + check_value_v1(MCP_T32_SESSIONS.len() == count, "sessions")
    failures = failures + check_value_v1(MCP_T32_CURRENT_SESSION == session, "current-session")
    failures = failures + check_value_v1(MCP_T32_CURRENT_CORE == core, "current-core")
    failures = failures + check_value_v1(MCP_T32_HISTORY.len() == count, "history")
    failures = failures + check_value_v1(MCP_T32_AREA_READY == populated, "area-ready")
    failures = failures + check_value_v1(MCP_T32_AREA_NAME == area, "area-name")
    failures

fn check_value_v1(value: bool, name: text) -> i64:
    if value:
        print "PASS: {name}"
        return 0
    print "FAIL: {name}"
    1
