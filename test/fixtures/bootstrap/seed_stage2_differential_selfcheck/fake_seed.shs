#!/bin/sh
# Fake seed for the selfcheck of scripts/check/check-seed-stage2-differential.shs.
# Called as `fake_seed.shs run <main.spl>`: prints every `#S>line` of the fixture and exits with
# its `#S-rc N` (default 0).
entry=$2
rc=0
while IFS= read -r line; do
    case "$line" in
        "#S>"*) printf '%s\n' "${line#"#S>"}" ;;
        "#S-rc "*) rc=${line#"#S-rc "} ;;
    esac
done < "$entry"
exit "$rc"
