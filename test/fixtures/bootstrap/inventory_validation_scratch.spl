use std.scv.compile_source_inventory_core.{CompileSourceInventoryEntryV1, CompileSourceInventoryV1, compile_source_inventory_entry_valid_v1, compile_source_inventory_encode_v1}
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause, transient_scope_end}
use std.nogc_sync_mut.sffi.host.{heap_registry_count}

fn main() -> i64:
    val digest = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    val entry = CompileSourceInventoryEntryV1("src/a.spl", digest, digest, digest, digest, digest, 7)
    # Initialize provider/runtime metadata before measuring repeated validation.
    assert(compile_source_inventory_entry_valid_v1(entry))
    val before_objects = heap_registry_count()
    var i = 0
    while i < 50000:
        assert(compile_source_inventory_entry_valid_v1(entry))
        i = i + 1
    val after_objects = heap_registry_count()
    print "validations=50000"
    print "objects_delta={after_objects - before_objects}"
    assert(after_objects == before_objects)
    val bad = CompileSourceInventoryEntryV1("src/a.spl", digest, digest, digest, digest, "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", 7)
    assert(not compile_source_inventory_entry_valid_v1(bad))
    val short = CompileSourceInventoryEntryV1("src/a.spl", "a", digest, digest, digest, digest, 7)
    assert(not compile_source_inventory_entry_valid_v1(short))
    assert(transient_scope_begin())
    assert(compile_source_inventory_entry_valid_v1(entry))
    assert(not compile_source_inventory_entry_valid_v1(bad))
    assert(transient_scope_pause())
    assert(transient_scope_end())
    assert(compile_source_inventory_entry_valid_v1(entry))
    val encoded = compile_source_inventory_encode_v1(CompileSourceInventoryV1(1, 3, [entry]))
    val expected = "simple-compile-source-inventory-v1\ngeneration=3\ncount=1\nsrc/a.spl|{digest}|{digest}|{digest}|{digest}|{digest}|7"
    assert(encoded == expected)
    print "negative_and_nested_and_canonical=pass"
    0
