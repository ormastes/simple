fn identity<T>(value: T) -> T:
    value

fn text_value(value: text?) -> text:
    if val payload = value:
        return identity(payload) + "b"
    "none"

fn int_value(value: i64?) -> i64:
    if val payload = value:
        return identity(payload) + 2
    -1

fn present(value: text?) -> bool:
    if value.?:
        return true
    false

fn main() -> i64:
    val text_result = text_value(Some("a"))
    val no_text = text_value(nil)
    val int_result = int_value(Some(3))
    val no_int = int_value(nil)
    val has_text = present(Some("a"))
    val no_presence = present(nil)
    print "text={text_result} absent={no_text} int={int_result} missing={no_int} present={has_text} empty={no_presence}"
    0
