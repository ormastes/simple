use test.fixtures.bootstrap.generic_imported_enum.provider.{Parcel}

fn read_text(value: Parcel<text>) -> text:
    match value:
        case Parcel.Has(item):
            item + "b"
        case Parcel.Empty:
            "empty"

fn read_int(value: Parcel<i64>) -> i64:
    match value:
        case Parcel.Has(item):
            item + 2
        case Parcel.Empty:
            0

fn main() -> i64:
    val text_result = read_text(Parcel.Has("a"))
    val int_result = read_int(Parcel.Has(5))
    print "text={text_result} int={int_result}"
    0
