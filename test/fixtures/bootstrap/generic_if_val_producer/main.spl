fn identity<T>(value: T) -> T:
    value

fn producer<T>(value: T, present: bool) -> T?:
    if present:
        return Some(value)
    nil

fn text_value(present: bool) -> text:
    if val payload = producer("a", present):
        return identity(payload) + "b"
    "none"

fn int_value() -> i64:
    if val payload = producer(3, true):
        return identity(payload) + 2
    -1

fn ordinary_value() -> text?:
    val copied = producer("z", true).?
    identity(copied)

fn main() -> i64:
    val text_result = text_value(true)
    val int_result = int_value()
    val absent = text_value(false)
    var ordinary = "missing"
    if val payload = ordinary_value():
        ordinary = payload
    print "text={text_result} int={int_result} absent={absent} ordinary={ordinary}"
    0
