# AUTHORED_UNEXECUTED: qualify using a genuine target self-hosted native producer.
# Real production serializers and JSON decoder; no private helper export.
use compiler.mir.mir_json.{serialize_const_value, serialize_mir_function, serialize_mir_block, serialize_mir_local}
use compiler.mir.mir_instruction_graph.{MirFunction, MirBlock, MirInst}
use compiler.mir.mir_instruction_support.{BlockId, MirTerminator}
use compiler.mir.mir_instruction_kinds.{MirInstKind}
use compiler.mir.mir_types.{MirLocal, LocalId, LocalKind, MirType, MirTypeKind, MirSignature, MirConstValue}
use compiler.hir.hir_types.{SymbolId}
use compiler.common.diagnostics.span.{Span}
use compiler.common.attributes.{vhdl_hardware_metadata_default}
use std.common.json.parser.{json_parse_with_error, json_unescape_string, json_string_escapes_are_valid}
use std.common.json.types.{json_is_string, json_is_object}

fn same_bytes(actual: text, expected: text) -> bool:
    if actual.len() != expected.len(): return false
    for i in 0..expected.len():
        if actual.byte_at(i) != expected.byte_at(i): return false
    true

fn string_case(input: text, golden: text) -> bool:
    val actual = serialize_const_value(MirConstValue.Str(input))
    if not same_bytes(actual, golden): return false
    if actual.len() < 2: return false
    # Do not mix byte length with interpreter character slices for Unicode.
    val units = actual.chars()
    if units.len() < 2 or units[0] != "\"" or units[units.len() - 1] != "\"": return false
    var body_parts: [text] = []
    for i in 1..units.len() - 1:
        body_parts.push(units[i])
    val body = body_parts.join("")
    if not json_string_escapes_are_valid(body): return false
    val (parsed, error) = json_parse_with_error(actual)
    if error != "" or parsed == nil: return false
    if not json_is_string(parsed): return false
    val parsed_text: text = parsed.1
    if not same_bytes(parsed_text, input): return false
    same_bytes(json_unescape_string(body), input)

fn valid_object(serialized: text) -> bool:
    if serialized.len() < 2: return false
    val (parsed, error) = json_parse_with_error(serialized)
    error == "" and parsed != nil and json_is_object(parsed)

fn main() -> i64:
    # Independent explicit 32-entry oracle, not the old serializer as baseline.
    val controls: [text] = ["\u0000", "\u0001", "\u0002", "\u0003", "\u0004", "\u0005", "\u0006", "\u0007",
        "\u0008", "\t", "\n", "\u000b", "\u000c", "\r", "\u000e", "\u000f",
        "\u0010", "\u0011", "\u0012", "\u0013", "\u0014", "\u0015", "\u0016", "\u0017",
        "\u0018", "\u0019", "\u001a", "\u001b", "\u001c", "\u001d", "\u001e", "\u001f"]
    val goldens: [text] = ["\\u0000", "\\u0001", "\\u0002", "\\u0003", "\\u0004", "\\u0005", "\\u0006", "\\u0007",
        "\\u0008", "\\t", "\\n", "\\u000b", "\\u000c", "\\r", "\\u000e", "\\u000f",
        "\\u0010", "\\u0011", "\\u0012", "\\u0013", "\\u0014", "\\u0015", "\\u0016", "\\u0017",
        "\\u0018", "\\u0019", "\\u001a", "\\u001b", "\\u001c", "\\u001d", "\\u001e", "\\u001f"]
    if controls.len() != 32 or goldens.len() != 32: return 1
    for code in 0..32:
        if controls[code].len() != 1 or controls[code].byte_at(0) != code: return 2
        if not string_case(controls[code], "\"" + goldens[code] + "\""): return 3
        if not string_case("a" + controls[code] + "b", "\"a" + goldens[code] + "b\""): return 4
    val interior = "a\u0000b"
    if interior.len() != 3 or interior.byte_at(1) != 0 or interior.byte_at(2) != 98: return 5
    if not string_case("", "\"\""): return 6
    if not string_case("plain", "\"plain\""): return 7
    if not string_case("\\u0000", "\"\\\\u0000\""): return 8
    if not string_case("\"\\", "\"\\\"\\\\\""): return 9
    if not string_case("λ漢😀", "\"λ漢😀\""): return 10
    if not string_case("\u0000\u0001\u001f", "\"\\u0000\\u0001\\u001f\""): return 11
    if not string_case("\u0000a", "\"\\u0000a\""): return 12
    if not string_case("a\u0000", "\"a\\u0000\""): return 13
    # Real nested MIR owners; successful parse alone is insufficient: verify fields.
    val payload = "λ\u0000漢😀\u001f"
    val escaped = "λ\\u0000漢😀\\u001f"
    val integer = MirType(kind: MirTypeKind.I64)
    val text_type = MirType(kind: MirTypeKind.Ptr(MirType(kind: MirTypeKind.I8), false))
    val local = MirLocal(id: LocalId(id: 0), name: Some(payload), type_: text_type, kind: LocalKind.Temp, is_ghost: false)
    val instruction = MirInst(kind: MirInstKind.Const(LocalId(id: 0), MirConstValue.Str(payload), text_type), span: Span.empty())
    val block = MirBlock(id: BlockId(id: 0), label: Some(payload), instructions: [instruction], terminator: MirTerminator.Unreachable)
    val function = MirFunction(symbol: SymbolId(id: 17), name: payload,
        signature: MirSignature(params: [], return_type: integer, is_variadic: false, params_known: true),
        locals: [local], blocks: [block], entry_block: BlockId(id: 0), span: Span.empty(),
        generic_params: [], is_generic_template: false, specialization_of: nil, type_bindings: {},
        layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "",
        is_export_c: false, export_name: "", has_driver_manifest_attr: false, driver_manifest_attr: nil,
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false,
        unroll_factor: 0, pipeline_ii: 0, memory_banks: 0, verification_contract: nil)
    val local_json = serialize_mir_local(local)
    val block_json = serialize_mir_block(block)
    val function_json = serialize_mir_function(function)
    if not valid_object(local_json) or not valid_object(block_json) or not valid_object(function_json): return 14
    if not local_json.contains("\"name\":\"" + escaped + "\""): return 15
    if not block_json.contains("\"label\":\"" + escaped + "\""): return 16
    if not block_json.contains("\"value\":\"" + escaped + "\""): return 17
    if not function_json.starts_with("{\"symbol\":17,\"name\":\"" + escaped + "\","): return 18
    if not function_json.contains(local_json) or not function_json.contains(block_json): return 19
    print "mir-json-c0: PASS 32 controls, byte roundtrips, Unicode, real MIR fields"
    0
