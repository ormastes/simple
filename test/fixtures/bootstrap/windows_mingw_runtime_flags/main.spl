# Focused source regression; native compilation/execution is required evidence.
use compiler.backend.linker._LinkerWrapper.native_all_support.{native_mingw_clang_link_args, native_all_gnu_support_args}

fn main() -> i64:
    var cases = 0
    for directory in ["C:/runtime", "C:/runtime with spaces", "C:\\runtime", "C:\\runtime with spaces", "/runtime", "relative/runtime"]:
        for archive in ["libsimple_native_all.a", "simple_native_all.lib"]:
            val inputs = [directory + "/" + archive]
            val arguments = native_mingw_clang_link_args(inputs)
            assert(arguments[0] == "--rtlib=compiler-rt")
            assert(arguments[1] == "--unwindlib=libunwind")
            assert(not arguments.contains("-lgcc"))
            assert(not arguments.contains("-lgcc_eh"))
            assert(arguments.contains("rt_vulkan_provider_is_available"))
            assert(arguments.contains("-lws2_32"))
            assert(arguments.contains("-lmingw32"))
            val generic = native_all_gnu_support_args(inputs, "windows-mingw", "")
            assert(generic.contains("-lgcc"))
            assert(generic.contains("-lgcc_eh"))
            assert(not generic.contains("--rtlib=compiler-rt"))
            cases = cases + 1
        for input in [directory + "/runtime.o", directory + "/not_libsimple_native_all.a"]:
            assert(native_mingw_clang_link_args([input]) == ["--rtlib=compiler-rt", "--unwindlib=libunwind"])
            assert(native_all_gnu_support_args([input], "windows-mingw", "") == [])
            cases = cases + 1
    assert(cases == 24)
    print "windows-mingw-runtime-flags cases={cases} assertions=145"
    return 0
