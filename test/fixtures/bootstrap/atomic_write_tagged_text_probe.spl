use std.nogc_async_mut.sosix.host_facade.{sosix_file_atomic_write, sosix_file_read, sosix_env_get}
fn main() -> i64:
    val path = sosix_env_get("SIMPLE_ATOMIC_WRITE_PROBE_PATH")
    if path == "": return 1
    val content = "atomic\npublication tail"
    if not sosix_file_atomic_write(path, content): return 2
    if sosix_file_read(path) != content: return 3
    if not sosix_file_atomic_write(path, ""): return 4
    if sosix_file_read(path) != "": return 5
    0
