use compiler.common.build_phase_accounting.{build_phase_succeeded_units_v1,
    build_phase_record_failed_module_v1, build_phase_terminal_failures_v1}
fn main() -> i64:
    var failed = 0
    val outcomes = [false, true, false, true, false]
    for module_failed in outcomes:
        failed = build_phase_record_failed_module_v1(failed, module_failed)
    if failed != 2: return 1
    if build_phase_succeeded_units_v1(5, 1, failed) != 2: return 2
    if build_phase_succeeded_units_v1(141, 0, failed) != 139: return 3
    if build_phase_terminal_failures_v1(failed) != 2: return 4
    if build_phase_terminal_failures_v1(0) != -1: return 5
    if build_phase_succeeded_units_v1(1, 1, 1) != -1: return 6
    if build_phase_succeeded_units_v1(-1, 0, 0) != -1: return 7
    if build_phase_succeeded_units_v1(0, 0, 0) != 0: return 8
    if build_phase_succeeded_units_v1(4, 2, 0) != 2: return 9
    0
