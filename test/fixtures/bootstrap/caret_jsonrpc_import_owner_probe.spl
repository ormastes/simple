# Reproduce the missing jo4 import through the real JSON-RPC request builder.
# A native compile on the original source fails HIR with unresolved name jo4.
use std.nogc_sync_mut.mcp_sdk.core.jsonrpc.{jsonrpc_request}
use std.nogc_sync_mut.sosix.stdio.{sosix_print_raw}

fn main() -> i64:
    val request = jsonrpc_request("7", "echo", "{}")
    # P2 raw-single-quote parser gap: escape both JSON brace pairs explicitly.
    if request != "{{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"echo\",\"params\":{{}}}}":
        return 1
    sosix_print_raw(request + "\n")
    0
