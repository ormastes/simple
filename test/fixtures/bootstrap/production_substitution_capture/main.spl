# Tracked production-substitution capture; exact source authority is bound by the execution request.
# PREPARED / UNRUN: emits kernel-checkable equations from production outputs.
use compiler.hir.hir_types.*
use compiler.common.diagnostics.span.Span
use compiler.monomorphize.type_subst.{TypeSubstitution, typesubstitution_empty, substitute_type}

struct SnapshotEncoding:
    valid: bool
    term: text

fn rejected() -> SnapshotEncoding:
    SnapshotEncoding(valid: false, term: "")

fn encoded(term: text) -> SnapshotEncoding:
    SnapshotEncoding(valid: true, term: term)

fn snapshot_type(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: Span.empty())

fn encode_children(items: [HirType], symbols: SymbolTable, depth: i64) -> SnapshotEncoding:
    if items.len() > 8: return rejected()
    var terms: [text] = []
    for item in items:
        val type_: HirType = item
        val result = encode_type(type_, symbols, depth + 1)
        if not result.valid: return rejected()
        terms = terms.push(result.term)
    encoded(terms.join(", "))

fn encode_application(owner: text, items: [HirType], symbols: SymbolTable, depth: i64) -> SnapshotEncoding:
    val children = encode_children(items, symbols, depth)
    if not children.valid: return rejected()
    encoded(".app \"{owner}\" [{children.term}]")

fn encode_type(type_: HirType, symbols: SymbolTable, depth: i64 = 0) -> SnapshotEncoding:
    if type_ == nil or depth > 16: return rejected()
    match type_.kind:
        case HirTypeKind.Int(bits, signed):
            if bits != 64 or not signed: return rejected()
            encoded(".con \"i64\"")
        case HirTypeKind.Str: encoded(".con \"text\"")
        case HirTypeKind.Bool: encoded(".con \"bool\"")
        case HirTypeKind.TypeParam(name, bounds):
            if name != "T" or bounds.len() != 0: return rejected()
            encoded(".var \"T\"")
        case HirTypeKind.Array(inner, size):
            if size != nil: return rejected()
            encode_application("Array", [inner], symbols, depth)
        case HirTypeKind.Optional(inner): encode_application("Optional", [inner], symbols, depth)
        case HirTypeKind.Tuple(items): encode_application("Tuple", items, symbols, depth)
        case HirTypeKind.Dict(key, value): encode_application("Dict", [key, value], symbols, depth)
        case HirTypeKind.Function(params, returned, effects):
            if effects.len() != 0: return rejected()
            val encoded_params = encode_children(params, symbols, depth)
            val encoded_return = encode_type(returned, symbols, depth + 1)
            if not encoded_params.valid or not encoded_return.valid: return rejected()
            encoded(".app \"Function\" [.app \"Parameters\" [{encoded_params.term}], {encoded_return.term}]")
        case HirTypeKind.Named(id, args):
            if val declaration = symbols.get_symbol_raw(id.id):
                if declaration.id.id != id.id: return rejected()
                if declaration.kind == SymbolKind.TypeParam:
                    if id.id != 0 or declaration.name != "T" or args.len() != 0: return rejected()
                    if (declaration.defining_module ?? "") != "snapshot": return rejected()
                    return encoded(".var \"T\"")
                if declaration.kind != SymbolKind.Struct or declaration.name != "Box" or args.len() != 1:
                    return rejected()
                val owner = declaration.defining_module ?? ""
                # Whitelisted canonical identities need no string escaping and
                # cannot collide with model constructor/atom tags.
                if owner == "snapshot.left":
                    return encode_application("Named:snapshot.left:Box", args, symbols, depth)
                if owner == "snapshot.right":
                    return encode_application("Named:snapshot.right:Box", args, symbols, depth)
            rejected()
        case _: rejected()

fn main() -> i64:
    var symbols = SymbolTable.new()
    val span = Span.empty()
    val formal = symbols.define("T", SymbolKind.TypeParam, nil, span, Visibility.Private, false, "snapshot")
    val left = symbols.define("LeftBox", SymbolKind.Struct, nil, span, Visibility.Public, false, "snapshot.left")
    val right = symbols.define("RightBox", SymbolKind.Struct, nil, span, Visibility.Public, false, "snapshot.right")
    symbols.rename_symbol(left, "Box")
    symbols.rename_symbol(right, "Box")
    val alien = symbols.define("AlienBox", SymbolKind.Struct, nil, span, Visibility.Public, false, "unknown.owner")
    symbols.rename_symbol(alien, "Box")
    if formal.id != 0 or left.id == right.id: return 2
    val integer = snapshot_type(HirTypeKind.Int(64, true))
    val string = snapshot_type(HirTypeKind.Str)
    val boolean = snapshot_type(HirTypeKind.Bool)
    val variable = snapshot_type(HirTypeKind.TypeParam("T", []))
    val optional = snapshot_type(HirTypeKind.Optional(variable))
    val inputs: [HirType] = [integer, string, boolean, variable,
        snapshot_type(HirTypeKind.Named(formal, [])),
        snapshot_type(HirTypeKind.Array(variable, nil)), optional,
        snapshot_type(HirTypeKind.Tuple([variable, string])),
        snapshot_type(HirTypeKind.Dict(variable, boolean)),
        snapshot_type(HirTypeKind.Function([variable], optional, [])),
        snapshot_type(HirTypeKind.Named(left, [variable])),
        snapshot_type(HirTypeKind.Named(right, [variable]))]
    val rejected_inputs: [HirType] = [
        snapshot_type(HirTypeKind.Int(32, true)), snapshot_type(HirTypeKind.Int(64, false)),
        snapshot_type(HirTypeKind.Array(variable, 4)), snapshot_type(HirTypeKind.Float(64)),
        snapshot_type(HirTypeKind.Any), snapshot_type(HirTypeKind.Error),
        snapshot_type(HirTypeKind.Infer(1, 0)), snapshot_type(HirTypeKind.TypeParam("U", [])),
        snapshot_type(HirTypeKind.TypeParam("T", [boolean])),
        snapshot_type(HirTypeKind.Function([integer], integer, [Effect(kind: EffectKind.IO, span: span)])),
        snapshot_type(HirTypeKind.Named(SymbolId(id: 999), [integer])),
        snapshot_type(HirTypeKind.Named(left, [])), snapshot_type(HirTypeKind.Named(alien, [integer]))]
    var rejected_count = 0
    for input in rejected_inputs:
        val type_: HirType = input
        if encode_type(type_, symbols).valid:
            print "-- CAPTURE_REJECT_GATE_FAILED"
            return 3
        rejected_count = rejected_count + 1
    if inputs.len() != 12 or rejected_count != 13: return 4
    print "-- CAPTURE_BEGIN cases=48 rejected=13"
    print "import GenericSubstModel"
    print "open GenericSubstModel"
    print "namespace ProductionCapturedSubstitution"
    print "def s0 : Subst := fun _ => none"
    val ranges = [string, integer, snapshot_type(HirTypeKind.Named(left, [boolean]))]
    for index in 0..3:
        val range: HirType = ranges[index]
        val range_term = encode_type(range, symbols)
        if not range_term.valid: return 5
        val number = index + 1
        print "def s{number} : Subst := fun name => if name == \"T\" then some ({range_term.term}) else none"
    var case_number = 0
    for substitution_index in 0..4:
        var substitution = typesubstitution_empty()
        if substitution_index > 0:
            val range: HirType = ranges[substitution_index - 1]
            substitution.mapping["T"] = range
            substitution.by_symbol[formal.id] = range
        for input in inputs:
            val type_: HirType = input
            val input_term = encode_type(type_, symbols)
            if not input_term.valid: return 6
            # The recorded right-hand side comes from PRODUCTION, not ms_apply.
            val produced = substitute_type(type_, substitution)
            val output_term = encode_type(produced, symbols)
            if not output_term.valid: return 7
            print "theorem captured_{case_number} : GenericSubstModel.apply s{substitution_index} ({input_term.term}) = ({output_term.term})  := by simp [GenericSubstModel.apply, s{substitution_index}]"
            case_number = case_number + 1
    if case_number != 48: return 8
    print "end ProductionCapturedSubstitution"
    print "-- CAPTURE_END cases={case_number} rejected={rejected_count}"
    0
