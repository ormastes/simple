use app.cli.shard_mem_clamp.{shard_effective_tree_budget_kb_v1}

fn main() -> i64:
    val gib = 1048576
    # Real mirgen2 admission inputs: the host still has ~93 GiB free.
    if shard_effective_tree_budget_kb_v1(25165824, 25165824, 97608600) != 25165824:
        print "FAIL: host reserve consumed the compiler's entire scoped cap"
        return 1
    if shard_effective_tree_budget_kb_v1(90 * gib, 64 * gib, 30 * gib) != 6 * gib: return 2
    if shard_effective_tree_budget_kb_v1(90 * gib, 64 * gib, 24 * gib) != 0: return 3
    if shard_effective_tree_budget_kb_v1(8 * gib, 64 * gib, 96 * gib) != 8 * gib: return 4
    if shard_effective_tree_budget_kb_v1(90 * gib, 64 * gib, 0) != 40 * gib: return 5
    if shard_effective_tree_budget_kb_v1(90 * gib, 0, 50 * gib) != 26 * gib: return 6
    if shard_effective_tree_budget_kb_v1(0, 0, 0) != 0: return 7
    if shard_effective_tree_budget_kb_v1(90 * gib, 64 * gib, 96 * gib, 80 * gib) != 16 * gib: return 8
    print "PASS: 8 host-reserve arithmetic assertions"
    0
