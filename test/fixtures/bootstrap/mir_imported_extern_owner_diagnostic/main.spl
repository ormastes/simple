use compiler.common.config.{Logger}
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.module_surface.{module_surfaces_from_modules}
use compiler.mir.mir_lowering.{MirLowering}
use compiler.mir._MirLowering.exact_extern_provenance.*
use compiler.mir._MirLowering.provider_metadata.{mir_provider_callable_key}
use compiler.hir.hir_types.{HirSymbol, SymbolKind}

# Bootstrap-only real parser/HIR/MIR diagnostic fixture; native execution required.
var assertion_count = 0
var active_mode = -1
var mode_check_count = 0
var actual_hir_context = ""
var actual_mir_context = ""

fn checked(condition: bool):
    mode_check_count = mode_check_count + 1
    if not condition:
        print "mir-diagnostic-check mode={active_mode} ordinal={mode_check_count} completed_assertions={assertion_count} condition={condition}"
        print actual_hir_context
        print actual_mir_context
    assert(condition)
    assertion_count = assertion_count + 1

# @req REQ-SSPEC-UNIT

# Actual parsed declarations and imported function symbols exercise the guard.
# This diagnostic preserves its existing treatment of all imported functions,
# including pure functions; it does not change extern admission or deduplicate.
fn check_imported_owner_diagnostic(mode: i64):
    active_mode = mode
    mode_check_count = 0
    actual_hir_context = ""
    actual_mir_context = ""
    val logger = Logger(level: 0)
    val provider_source = "pub fn ping() -> i64:\n    3\n"
    val consumer_source = "use lib.provider.\{ping\}\nfn invoke() -> i64:\n    ping()\n"
    val first_path = "first/src/lib/provider.spl"
    val second_path = "second/src/lib/provider.spl"
    val consumer_path = "app/consumer.spl"
    val provider_ast = parse_full_frontend(provider_source, first_path, "lib.provider", logger)
    val second_ast = parse_full_frontend(provider_source, second_path, "lib.provider", logger)
    val consumer_ast = parse_full_frontend(consumer_source, consumer_path, "app.consumer", logger)
    var modules: Dict<text, Module> = {}
    modules["lib.provider"] = provider_ast
    val surfaces = module_surfaces_from_modules(modules, [
        SourceFile(path: first_path, content: provider_source, module_name: "lib.provider")
    ]).unwrap()
    var first_lowering = hirlowering_for_module("lib.provider", surfaces)
    first_lowering.use_explicit_semantic_policy()
    first_lowering.begin_module(first_path)
    val first = first_lowering.lower_module(provider_ast)
    var second_lowering = hirlowering_for_module("lib.provider", surfaces)
    second_lowering.use_explicit_semantic_policy()
    second_lowering.begin_module(second_path)
    val second = second_lowering.lower_module(second_ast)
    var consumer_lowering = hirlowering_for_module("app.consumer", surfaces)
    consumer_lowering.use_explicit_semantic_policy()
    consumer_lowering.begin_module(consumer_path)
    val actual_ambient_policy = consumer_lowering.ambient_bootstrap_enabled()
    val consumer = consumer_lowering.lower_module(consumer_ast)
    actual_hir_context = "mir-diagnostic-hir mode={mode} first_errors={first_lowering.errors.len()} second_errors={second_lowering.errors.len()} consumer_errors={consumer_lowering.errors.len()}"
    for error in first_lowering.errors:
        print "mir-diagnostic-hir-first {error.message}"
    for error in second_lowering.errors:
        print "mir-diagnostic-hir-second {error.message}"
    for error in consumer_lowering.errors:
        print "mir-diagnostic-hir-consumer {error.message}"
    actual_hir_context = actual_hir_context + " first_name={first.name} first_path={first.path} second_name={second.name} second_path={second.path} consumer_name={consumer.name} consumer_path={consumer.path}"
    actual_hir_context = actual_hir_context + " ast_imports={consumer_ast.imports.len()} surfaces={surfaces.surfaces.len()} ambient_after_begin={actual_ambient_policy}"
    checked(first_lowering.errors.len() == 0)
    checked(second_lowering.errors.len() == 0)
    checked(consumer_lowering.errors.len() == 0)
    checked(first.name == first_path)
    checked(first.path == first_path)
    checked(second.path == second_path)
    checked(consumer.path == consumer_path)
    val imported = mir_imported_extern_consumers_v1(consumer.symbols, consumer.name)
    actual_hir_context = actual_hir_context + " imported_keys={imported.len()}"
    val raw_ids: [i64] = consumer.symbols.symbols.keys()
    var bracket_keys: Dict<text, bool> = {}
    var raw_index = 0
    while raw_index < raw_ids.len():
        val raw_id: i64 = raw_ids[raw_index]
        val row: HirSymbol = consumer.symbols.symbols[raw_id]
        val function_kind = row.kind == SymbolKind.Function
        val type_present = row.type_ != nil
        val defining_owner = row.defining_module ?? ""
        if raw_index < 64:
            actual_hir_context = actual_hir_context + " [raw_id={raw_id} name={row.name} function={function_kind} type_present={type_present} owner={defining_owner}]"
        if function_kind and type_present and defining_owner != "" and mir_provider_callable_key(defining_owner, "") != mir_provider_callable_key(consumer.name, ""):
            bracket_keys[mir_provider_callable_key(defining_owner, row.name)] = true
        raw_index = raw_index + 1
    actual_hir_context = actual_hir_context + " scalar_key_rows={raw_ids.len()} bracket_imported_keys={bracket_keys.len()}"
    checked(imported.len() > 0)
    var lowering = MirLowering.new(consumer.symbols)
    if mode == 0:
        lowering.record_imported_exact_extern_modules_with_context_v1(
            consumer.name, consumer.path, [first, consumer])
        actual_mir_context = "mir-diagnostic-mir mode={mode} errors={lowering.errors.len()}"
        for error in lowering.errors:
            actual_mir_context = actual_mir_context + " fatal={error.fatal} message={error.message}"
        checked(lowering.errors.len() == 0)
        return
    if mode == 1:
        lowering.record_imported_exact_extern_modules_with_context_v1(
            consumer.name, consumer.path, [first, consumer, second])
    else:
        # Existing two-argument ABI remains callable and reports missing path
        # honestly rather than reconstructing one from a module spelling.
        lowering.record_imported_exact_extern_modules_v1(
            consumer.name, [first, consumer, second])
    actual_mir_context = "mir-diagnostic-mir mode={mode} errors={lowering.errors.len()}"
    for error in lowering.errors:
        actual_mir_context = actual_mir_context + " fatal={error.fatal} message={error.message}"
    checked(lowering.errors.len() == 1)
    checked(lowering.errors[0].fatal == true)
    val message = lowering.errors[0].message
    checked(message.starts_with("ambiguous imported extern provider owner"))
    checked(message.contains("consumer_module=\"{consumer_path}\""))
    checked(message.contains("canonical_owner=\"lib.provider#\""))
    checked(message.contains("first_provider_index=0"))
    checked(message.contains("second_provider_index=2"))
    checked(message.contains("first_provider_name=\"{first_path}\""))
    checked(message.contains("second_provider_name=\"{second_path}\""))
    checked(message.contains("first_provider_path=\"{first_path}\""))
    checked(message.contains("second_provider_path=\"{second_path}\""))
    if mode == 1:
        checked(message.contains("consumer_path=\"{consumer_path}\""))
        checked(message.contains("consumer_path_available=true"))
    else:
        checked(message.contains("consumer_path=\"\""))
        checked(message.contains("consumer_path_available=false"))

fn main() -> i64:
    var cases = 0
    for mode in [1, 2, 0]:
        check_imported_owner_diagnostic(mode)
        cases = cases + 1
    checked(cases == 3)
    print "mir-imported-extern-owner-diagnostics cases={cases} assertions={assertion_count}"
    return 0
