# Explicit generic calls, including an alias, must link to the declaration owner.
use test.fixtures.bootstrap.imported_generic_linkage.provider.{pick_second, identity as selected, local_roundtrip}

fn main() -> i64:
    val number = pick_second<i64>(1, 7)
    val word = pick_second<text>("wrong", "ab")
    val alias_number = selected<i64>(13)
    val alias_word = selected<text>("cd")
    val local = local_roundtrip(19)
    if number != 7: return 1
    if word != "ab": return 2
    if alias_number != 13: return 3
    if alias_word != "cd": return 4
    if local != 19: return 5
    print "int={number} text={word} alias_int={alias_number} alias_text={alias_word} local={local}"
    0
