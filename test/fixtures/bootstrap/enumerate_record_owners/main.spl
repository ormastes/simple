struct Pair:
    lo: i64
    hi: i64

impl Pair:
    fn upper(self) -> i64:
        self.hi

fn record_sum(items: [Pair]) -> i64:
    var total = 0
    for (index, item) in items.enumerate():
        total = total + index + item.hi
    total

fn method_sum(items: [Pair]) -> i64:
    var total = 0
    for (index, item) in items.enumerate():
        total = total + item.upper()
    total

fn nested_sum(rows: [[i64]]) -> i64:
    var total = 0
    for (index, row) in rows.enumerate():
        for value in row:
            total = total + index + value
    total

fn dictionary_sum(items: Dict<text, Pair>) -> i64:
    var total = 0
    for (key, item) in items:
        total = total + item.hi
    total

fn ordinary_tuple_sum(items: [Pair], dictionary: Dict<text, Pair>) -> i64:
    val array_pair = (0, items[0])
    val dict_pair = (0, dictionary["key"])
    val (index, record) = (0, items[1])
    array_pair.1.hi + dict_pair.1.hi + record.upper()

fn main() -> i64:
    val records = record_sum([Pair(lo: 101, hi: 7), Pair(lo: 202, hi: 11)])
    val nested = nested_sum([[2, 3], [5]])
    val dictionary = dictionary_sum({"first": Pair(lo: 303, hi: 13), "second": Pair(lo: 404, hi: 17)})
    val methods = method_sum([Pair(lo: 505, hi: 7), Pair(lo: 606, hi: 11)])
    val ordinary = ordinary_tuple_sum([Pair(lo: 707, hi: 19), Pair(lo: 808, hi: 23)], {"key": Pair(lo: 909, hi: 29)})
    print "records={records} nested={nested} dictionary={dictionary} methods={methods} ordinary={ordinary}"
    if records != 19 or nested != 11 or dictionary != 30 or methods != 18 or ordinary != 71:
        return 1
    0

