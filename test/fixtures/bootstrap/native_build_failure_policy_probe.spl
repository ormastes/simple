# Small native probe for the shared native-build argument-to-env policy.
use app.cli.native_build_output_plan.{native_build_apply_failure_policy_v1}
use app.io.env_ops.{env_get, env_set}

fn main() -> i64:
    val previous_go_to_end = env_get("SIMPLE_NATIVE_GO_TO_END") ?? ""
    val previous_fail_fast = env_get("SIMPLE_COMPILE_FAIL_FAST") ?? ""
    env_set("SIMPLE_NATIVE_GO_TO_END", "ambient-go-to-end")
    env_set("SIMPLE_COMPILE_FAIL_FAST", "ambient-fail-fast")

    native_build_apply_failure_policy_v1(["--output", "--go-to-end",
        "--entry", "--fail-fast"])
    assert((env_get("SIMPLE_NATIVE_GO_TO_END") ?? "") == "ambient-go-to-end")
    assert((env_get("SIMPLE_COMPILE_FAIL_FAST") ?? "") == "ambient-fail-fast")
    native_build_apply_failure_policy_v1(["--output=--go-to-end", "--entry=--fail-fast"])
    assert((env_get("SIMPLE_NATIVE_GO_TO_END") ?? "") == "ambient-go-to-end")
    assert((env_get("SIMPLE_COMPILE_FAIL_FAST") ?? "") == "ambient-fail-fast")

    native_build_apply_failure_policy_v1(["--output", "native.o", "--go-to-end",
        "--entry", "entry.spl", "--fail-fast"])
    assert((env_get("SIMPLE_NATIVE_GO_TO_END") ?? "") == "1")
    assert((env_get("SIMPLE_COMPILE_FAIL_FAST") ?? "") == "1")
    native_build_apply_failure_policy_v1([])
    assert((env_get("SIMPLE_NATIVE_GO_TO_END") ?? "") == "1")
    assert((env_get("SIMPLE_COMPILE_FAIL_FAST") ?? "") == "1")

    env_set("SIMPLE_NATIVE_GO_TO_END", previous_go_to_end)
    env_set("SIMPLE_COMPILE_FAIL_FAST", previous_fail_fast)
    print "native-build-failure-policy-probe: PASS"
    0
