use compiler.driver.driver_log_helpers.{log_build_progress, log_build_progress_failure}
fn main() -> i64:
    log_build_progress("mir", "modules", 0, 5, "start", 4, 6, 0, 0, "running")
    log_build_progress("mir", "modules", 5, 5, "complete_set", 4, 6, 2, 1, "failed")
    log_build_progress_failure("mir", "modules", "classified_failure", 4, 6)
    log_build_progress("mir", "files", 1, 1, "different_kind", 4, 6, 1, 0, "failed")
    log_build_progress_failure("mir", "modules", "different_kind_abort", 4, 6)
    log_build_progress("mir", "modules", 3, 5, "partial", 4, 6, 1, 0, "running")
    log_build_progress_failure("mir", "modules", "partial_abort", 4, 6)
    0
