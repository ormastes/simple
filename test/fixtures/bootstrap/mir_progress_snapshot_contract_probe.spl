use compiler.common.build_phase_accounting.{build_phase_snapshot_compiled_units_v1,
    build_phase_terminal_known_failures_v1}
fn main() -> i64:
    if build_phase_snapshot_compiled_units_v1("mir", 141, 0, 2) != 139: return 1
    if build_phase_snapshot_compiled_units_v1("mir", 141, 5, 2) != 134: return 2
    if build_phase_snapshot_compiled_units_v1("mir", -1, 0, -1) != -1: return 3
    if build_phase_snapshot_compiled_units_v1("native_compile", 20, 3, 2) != 20: return 4
    if build_phase_terminal_known_failures_v1(141, 141, 2) != 2: return 5
    if build_phase_terminal_known_failures_v1(64, 141, 1) != -1: return 6
    if build_phase_terminal_known_failures_v1(0, 141, 0) != -1: return 7
    if build_phase_terminal_known_failures_v1(141, 141, 0) != -1: return 8
    0
