# Bootstrap diagnostic for the actual live process facade. This is not an
# admitted self-hosted test runner result.
use app.io.process_ops.{process_run_timeout_live}

fn main() -> i64:
    val (zero_out, zero_err, zero_code) = process_run_timeout_live(
        "/bin/sh", ["-c", "sleep 1; printf zero-complete"], 0)
    if zero_code != 0 or not zero_out.contains("zero-complete") or
            zero_err.contains("[TIMEOUT:"):
        print "process-live-timeout-zero-bootstrap-probe: zero branch failed"
        return 1

    val (short_out, short_err, short_code) = process_run_timeout_live(
        "/bin/sh", ["-c", "sleep 2; printf should-not-complete"], 100)
    if short_code != -1 or not short_err.contains("[TIMEOUT:") or
            short_out.contains("should-not-complete"):
        print "process-live-timeout-zero-bootstrap-probe: positive branch failed"
        return 1

    val (fallback_out, fallback_err, fallback_code) = process_run_timeout_live(
        "/bin/sh", ["-c", "printf fallback-complete"], -1)
    if fallback_code != 0 or not fallback_out.contains("fallback-complete") or
            fallback_err.contains("[TIMEOUT:"):
        print "process-live-timeout-zero-bootstrap-probe: negative branch failed"
        return 1

    print "process-live-timeout-zero-bootstrap-probe: PASS"
    return 0
