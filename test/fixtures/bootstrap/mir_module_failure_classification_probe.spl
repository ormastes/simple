use compiler.common.diagnostics.span.{Span}
use compiler.common.build_phase_accounting.{build_phase_record_failed_module_v1}
use compiler.hir.hir_types.{SymbolTable}
use compiler.mir.mir_lowering.{MirLowering}
use compiler.driver.driver_pipeline_lowering.{driver_mir_has_new_fatal_errors_v1}

fn main() -> i64:
    var lowering = MirLowering.new(SymbolTable.new())
    lowering.error("advisory control", nil)
    if driver_mir_has_new_fatal_errors_v1(lowering.errors, 0): return 1
    val first_start = lowering.errors.len()
    val first = lowering.unsupported_expr_kind("E-MIR-EXPR-Lambda", "lambda expression", Span.empty())
    val second = lowering.unsupported_expr_kind("E-MIR-EXPR-StaticCall", "static call", Span.empty())
    if first.id < 0 or second.id <= first.id: return 2
    if not driver_mir_has_new_fatal_errors_v1(lowering.errors, first_start): return 3
    var failed = build_phase_record_failed_module_v1(0,
        driver_mir_has_new_fatal_errors_v1(lowering.errors, first_start))
    if failed != 1 or lowering.errors.len() != 3: return 4
    val next_start = lowering.errors.len()
    lowering.error("second module advisory", nil)
    failed = build_phase_record_failed_module_v1(failed,
        driver_mir_has_new_fatal_errors_v1(lowering.errors, next_start))
    if failed != 1: return 5
    # Preserve the collector's legacy fallback as well as explicit site flags.
    val legacy_start = lowering.errors.len()
    lowering.error("undefined variable legacy control", nil)
    if lowering.errors[legacy_start].fatal: return 6
    failed = build_phase_record_failed_module_v1(failed,
        driver_mir_has_new_fatal_errors_v1(lowering.errors, legacy_start))
    if failed != 2: return 7
    if driver_mir_has_new_fatal_errors_v1(lowering.errors, lowering.errors.len()): return 8
    0
