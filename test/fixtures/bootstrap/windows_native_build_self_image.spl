use app.io.cli_ops.{cli_kernel_executable_path, get_args}
use std.nogc_sync_mut.fs.host_path.{host_is_windows_host}
use std.io_runtime.{file_exists}
use std.nogc_sync_mut.io.file_ops.{file_hash_sha256}

# Native regression for the exact kernel-image lookup used by Windows self_exe.
# The external collector renames this PE to simple_stage2.exe, spoofs argv[0],
# supplies stale compiler environment values, and passes its independently hashed
# bytes as the last argument. This is not a rebuilt native_build_main proof.
fn main() -> i64:
    val args = get_args()
    assert(args.len() > 0)
    val expected = args[args.len() - 1]
    assert(expected.len() == 64)
    assert(host_is_windows_host())
    val image = cli_kernel_executable_path()
    assert(image != "")
    assert(image.ends_with("simple_stage2.exe"))
    assert(file_exists(image))
    assert(file_hash_sha256(image).unwrap() == expected)
    print "windows-native-build-self-image assertions=7"
    print "kernel-image={image}"
    0
