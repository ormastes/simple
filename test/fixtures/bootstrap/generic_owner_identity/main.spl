# REQ-GENERIC-NOMINAL-IDENTITY: distinct declaration owners despite identical
# short names and layouts. Require two identity specializations in LLVM, then
# execute and compare main.expected. Stdout alone cannot prove distinct keys.
use .left.{Packet as LeftPacket}
use .right.{Packet as RightPacket}

fn identity<T>(value: T) -> T:
    value

fn main():
    val left: LeftPacket = LeftPacket(value: 7)
    val right: RightPacket = RightPacket(value: 9)
    val first = identity(left)
    val second = identity(right)
    print "left={first.value} right={second.value}"
