use std.common.build_manager.grouped_native_worker_request.{NativeGroupWorkerRequestV1,
    native_group_worker_request_encode_v1, native_group_worker_request_decode_v1,
    native_group_worker_request_valid_v1}

fn request_fixture_v1() -> NativeGroupWorkerRequestV1:
    NativeGroupWorkerRequestV1("/bin/simple", "a".repeat(64),
        "/state/group/manifest.sdn", "b".repeat(64), "/state/group/result.sdn",
        "/frozen", "/frozen/src/main.spl", "/index", "run-one", "/objects",
        "llvm", 2, "aarch64-unknown-linux-gnu", 300000)

# REQ-HIR-GROUPED-REQUEST-001: independent exact wire, then every field recovered.
fn request_wire_check_v1() -> bool:
    val request = request_fixture_v1()
    val expected = "SIMPLE-NATIVE-GROUP-WORKER-1\n/bin/simple\n" + "a".repeat(64) +
        "\n/state/group/manifest.sdn\n" + "b".repeat(64) +
        "\n/state/group/result.sdn\n/frozen\n/frozen/src/main.spl\n/index\n" +
        "run-one\n/objects\nllvm\n2\naarch64-unknown-linux-gnu\n300000\n"
    if native_group_worker_request_encode_v1(request) != expected: return false
    val read = native_group_worker_request_decode_v1(expected)
    if read.is_err(): return false
    val recovered = read.unwrap()
    (recovered.producer == request.producer and
        recovered.producer_digest == request.producer_digest and
        recovered.group_manifest == request.group_manifest and
        recovered.manifest_digest == request.manifest_digest and
        recovered.group_result == request.group_result and
        recovered.source_root == request.source_root and
        recovered.entry_source == request.entry_source and
        recovered.index_read_root == request.index_read_root and
        recovered.run_id == request.run_id and recovered.output_root == request.output_root and
        recovered.backend == request.backend and recovered.threads == request.threads and
        recovered.target == request.target and recovered.timeout_ms == request.timeout_ms)

# REQ-HIR-GROUPED-REQUEST-002: actual malformed-wire rejection, not string scans.
fn request_wire_refusal_check_v1() -> bool:
    val payload = native_group_worker_request_encode_v1(request_fixture_v1())
    (native_group_worker_request_decode_v1("x".repeat(65537)).is_err() and
        native_group_worker_request_decode_v1("WRONG\n" + payload).is_err() and
        native_group_worker_request_decode_v1(payload + "junk").is_err() and
        native_group_worker_request_decode_v1(payload.replace("\n2\n", "\n02\n")).is_err())

# REQ-HIR-GROUPED-REQUEST-003: fresh values isolate every authority refusal.
fn request_authority_refusal_check_v1() -> bool:
    var relative = request_fixture_v1()
    relative.producer = "simple"
    var digest = request_fixture_v1()
    digest.producer_digest = "g".repeat(64)
    var escaped = request_fixture_v1()
    escaped.entry_source = "/elsewhere/main.spl"
    var result_root = request_fixture_v1()
    result_root.group_result = "/elsewhere/result.sdn"
    var overlap = request_fixture_v1()
    overlap.output_root = "/state/group/objects"
    var backend = request_fixture_v1()
    backend.backend = "unknown"
    var nul = request_fixture_v1()
    nul.target = "target\0suffix"
    (native_group_worker_request_valid_v1(relative) == "worker path must be absolute" and
        native_group_worker_request_valid_v1(digest) == "worker input digest invalid" and
        native_group_worker_request_valid_v1(escaped) == "worker entry or result root differs" and
        native_group_worker_request_valid_v1(result_root) == "worker entry or result root differs" and
        native_group_worker_request_valid_v1(overlap) == "worker output root overlaps source or attempt" and
        native_group_worker_request_valid_v1(backend) == "worker backend invalid" and
        native_group_worker_request_valid_v1(nul) == "worker target invalid")

# REQ-HIR-GROUPED-REQUEST-004: permitted edges and adjacent invalid values.
fn request_numeric_bounds_check_v1() -> bool:
    var minimum = request_fixture_v1()
    minimum.threads = 1
    minimum.timeout_ms = 0
    var maximum = request_fixture_v1()
    maximum.threads = 256
    maximum.timeout_ms = 86400000
    var zero_threads = request_fixture_v1()
    zero_threads.threads = 0
    var excess_threads = request_fixture_v1()
    excess_threads.threads = 257
    var negative_timeout = request_fixture_v1()
    negative_timeout.timeout_ms = -1
    var excess_timeout = request_fixture_v1()
    excess_timeout.timeout_ms = 86400001
    (native_group_worker_request_valid_v1(minimum) == "" and
        native_group_worker_request_valid_v1(maximum) == "" and
        native_group_worker_request_valid_v1(zero_threads) == "worker thread bound invalid" and
        native_group_worker_request_valid_v1(excess_threads) == "worker thread bound invalid" and
        native_group_worker_request_valid_v1(negative_timeout) == "worker timeout invalid" and
        native_group_worker_request_valid_v1(excess_timeout) == "worker timeout invalid")

export request_wire_check_v1, request_wire_refusal_check_v1
export request_authority_refusal_check_v1, request_numeric_bounds_check_v1
