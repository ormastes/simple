use checks.{request_wire_check_v1, request_wire_refusal_check_v1,
    request_authority_refusal_check_v1, request_numeric_bounds_check_v1}

fn main() -> i64:
    if not request_wire_check_v1(): return 1
    if not request_wire_refusal_check_v1(): return 2
    if not request_authority_refusal_check_v1(): return 3
    if not request_numeric_bounds_check_v1(): return 4
    print "GROUPED_NATIVE_REQUEST_PASS cases=4"
    0
