use resource_policy.{test_max_procs_value_valid}

fn main():
    assert(test_max_procs_value_valid("0"))
    assert(test_max_procs_value_valid("000000000000000000000000000000"))
    assert(test_max_procs_value_valid("1"))
    assert(test_max_procs_value_valid("9223372036854775807"))
    assert(test_max_procs_value_valid("0009223372036854775807"))
    assert(not test_max_procs_value_valid(""))
    assert(not test_max_procs_value_valid("-1"))
    assert(not test_max_procs_value_valid("+1"))
    assert(not test_max_procs_value_valid("1.5"))
    assert(not test_max_procs_value_valid(" 1"))
    assert(not test_max_procs_value_valid("1 "))
    assert(not test_max_procs_value_valid("word"))
    assert(not test_max_procs_value_valid("9223372036854775808"))
    assert(not test_max_procs_value_valid("18446744073709551615"))
    assert(not test_max_procs_value_valid("0009223372036854775808"))
    assert(not test_max_procs_value_valid("100000000000000000000000000000"))
    print("process-limit native 16 assertions PASS")
