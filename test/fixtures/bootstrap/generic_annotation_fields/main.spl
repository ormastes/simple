# Native acceptance fixture for REQ-GENERIC-ANNOTATION-FIELD.
# Compile with a self-hosted successor containing the repair and compare its
# stdout byte-for-byte with main.expected. Compilation alone is insufficient.
struct Bag<T>:
    items: [T]
    first: T?

fn text_sum(b: Bag<text>) -> text:
    b.items[0] + b.items[1]

fn integer_sum(b: Bag<i64>) -> i64:
    b.items[0] + b.items[1]

fn optional_text(b: Bag<text>) -> text:
    (b.first ?? "z") + "z"

fn identity<T>(x: T) -> Later<T>:
    Later(value: x)

struct Later<T>:
    value: T

fn main():
    val words = Bag(items: ["a", "b"], first: "a")
    val numbers = Bag(items: [3, 7], first: 3)
    val forward: Later<text> = identity("q")
    print "text={text_sum(words)} int={integer_sum(numbers)} optional={optional_text(words)} forward={forward.value}"
