# Native component fixture: invalid invocations must fail before source
# inventory access or any foreign compiler call.
use app.cli.bootstrap_main.{run_native_build_bootstrap, bootstrap_native_build_worker_args}
use app.io._CliCompile.compile_targets.{cli_native_build_option_error}

fn main() -> i64:
    val unsupported = ["simple", "native-build", "--source", "src", "--entry", "missing.spl",
        "--unsupported-native-route-flag"]
    assert(cli_native_build_option_error(bootstrap_native_build_worker_args(unsupported), true) ==
        "unknown option: --unsupported-native-route-flag")
    assert(run_native_build_bootstrap(unsupported) == 1)
    val no_entry = ["simple", "native-build", "--source", "src", "--threads", "1"]
    assert(cli_native_build_option_error(bootstrap_native_build_worker_args(no_entry), true) ==
        "No entry point specified for native-build backend")
    assert(run_native_build_bootstrap(no_entry) == 1)
    val conflict = ["simple", "native-build", "--entry", "first.spl", "second.spl"]
    assert(cli_native_build_option_error(bootstrap_native_build_worker_args(conflict), true).contains(
        "multiple native-build entry points"))
    assert(run_native_build_bootstrap(conflict) == 1)
    assert(cli_native_build_option_error(["--source", "src", "entry.spl", "--emit-shared",
        "--no-mangle", "--threads", "1", "--mode=one-binary"], true) == "")
    assert(run_native_build_bootstrap(["simple", "native-build", "--list-optimizations"]) == 0)
    print "pure-bootstrap-native-route-regression: PASS"
    return 0
