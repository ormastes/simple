# Fixture for doc/08_tracking/bug/module_global_write_invisible_to_callee_2026-07-27.md
#
# Every writer below mutates a module global and then CALLS a helper that reads
# it. Each writer returns what the *callee* observed, so a spec can assert the
# callee's view directly. Under the pre-fix interpreter every one of these
# returned the pre-call snapshot; the JIT always returned the fresh value.
use test.fixtures.global_write_visibility.gwv_reader.{gwv_read_n_xmod, gwv_read_len_xmod, gwv_read_at_xmod}

var gwv_n: i64 = 0
var gwv_arr: [i64] = [0, 0, 0, 0]

# --- same-module callees -----------------------------------------------------

fn gwv_read_n() -> i64:
    return gwv_n

fn gwv_read_len() -> i64:
    return gwv_arr.len()

fn gwv_read_at(i: i64) -> i64:
    return gwv_arr[i]

fn gwv_reset():
    gwv_n = 0
    gwv_arr = [0, 0, 0, 0]

# --- writers: same-module callee --------------------------------------------

# Bare scalar assignment.
fn gwv_w_scalar() -> i64:
    gwv_n = 42
    return gwv_read_n()

# Bare whole-array assignment.
fn gwv_w_array() -> i64:
    gwv_arr = [7, 7, 7, 7]
    return gwv_read_at(2)

# Indexed assignment into an array global.
fn gwv_w_indexed() -> i64:
    gwv_arr[2] = 55
    return gwv_read_at(2)

# Repeated growth in a loop (each iteration must be visible to the callee).
fn gwv_w_push_loop() -> i64:
    var i = 0
    while i < 3:
        gwv_arr = gwv_arr.push(100 + i)
        i = i + 1
    return gwv_read_len()

# Write nested inside if/while rather than at function-body top level.
fn gwv_w_nested_if() -> i64:
    var i = 0
    while i < 3:
        if i == 1:
            gwv_n = 777
        i = i + 1
    return gwv_read_n()

# The callee is invoked *between* two writes: it must see the first write and
# not the second, i.e. publication is ordered, not merely eventual.
fn gwv_w_midwrite() -> i64:
    gwv_n = 11
    val seen = gwv_read_n()
    gwv_n = 22
    return seen

# --- writers: cross-module callee -------------------------------------------

fn gwv_w_scalar_xmod() -> i64:
    gwv_n = 43
    return gwv_read_n_xmod()

fn gwv_w_array_xmod() -> i64:
    gwv_arr = [8, 8, 8, 8]
    return gwv_read_at_xmod(2)

fn gwv_w_indexed_xmod() -> i64:
    gwv_arr[2] = 56
    return gwv_read_at_xmod(2)

fn gwv_w_push_loop_xmod() -> i64:
    var i = 0
    while i < 3:
        gwv_arr = gwv_arr.push(200 + i)
        i = i + 1
    return gwv_read_len_xmod()

fn gwv_w_nested_if_xmod() -> i64:
    var i = 0
    while i < 3:
        if i == 1:
            gwv_n = 778
        i = i + 1
    return gwv_read_n_xmod()

# --- write-back-on-return must still work ------------------------------------

# The historic behaviour (value appears after the writer returns) must not
# regress: this reads the global from a *separate* call after the writer exits.
fn gwv_w_then_return_n() -> i64:
    gwv_n = 99
    return 0
