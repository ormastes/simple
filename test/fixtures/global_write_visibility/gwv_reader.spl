# Cross-module callee for the module-global write-visibility regression spec.
# Reads globals that are OWNED by gwv_owner, so the observation crosses a module
# boundary (exercises the imported-global binding path, not just the owner map).
use test.fixtures.global_write_visibility.gwv_owner.{gwv_n, gwv_arr}

# Value of the scalar global as seen from another module.
fn gwv_read_n_xmod() -> i64:
    return gwv_n

# Length of the array global as seen from another module.
fn gwv_read_len_xmod() -> i64:
    return gwv_arr.len()

# Element of the array global as seen from another module.
fn gwv_read_at_xmod(i: i64) -> i64:
    return gwv_arr[i]
