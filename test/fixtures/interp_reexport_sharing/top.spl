# The importer under test. Every probe reads names through a function body
# (frozen env + binding table) or a module-level val (evaluation-time env).
use test.fixtures.interp_reexport_sharing.mid.{mid_fn}
use test.fixtures.interp_reexport_sharing.leaf.{leaf_fn as aliased_leaf}
use test.fixtures.interp_reexport_sharing.facade.*
use test.fixtures.interp_reexport_sharing.order_lo.{order_lo_twin}
use test.fixtures.interp_reexport_sharing.order_ol.{order_ol_twin}
use test.fixtures.interp_reexport_sharing.cyc_a.{cyc_a_reads}
use test.fixtures.interp_reexport_sharing.leaf
use test.fixtures.interp_reexport_sharing.bare_user.{bare_probe}

val top_eval_time = "{mid_fn()}|{mid_other()}|{dup()}|{leaf_val}"

fn top_selective_leak() -> text:
    # `use mid.{mid_fn}` binds mid's whole surface, including what mid only
    # imported from leaf.
    "{mid_fn()}|{mid_other()}|{mid_reads()}|{dup()}"

fn top_alias() -> text:
    aliased_leaf()

fn top_facade() -> text:
    "{facade_other()}|{leaf_val}|{twin}"

fn top_order() -> text:
    "{order_lo_twin()}|{order_ol_twin()}"

fn top_cycle() -> text:
    "{cyc_a_reads()}|{cyc_b_fn()}"

fn top_qualified() -> text:
    leaf.leaf_fn()

fn top_live_global() -> text:
    val before = leaf_counter
    val bumped = leaf_bump()
    "{before}|{bumped}|{leaf_counter}"

fn top_eval() -> text:
    top_eval_time

fn top_bare() -> text:
    "{bare_probe()}"
