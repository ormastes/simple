# Plain glob import of leaf (no `export use`), a local fn shadowing an
# imported one, and own vals placed before and after the import.
val shadow_early = "mid-early"
use test.fixtures.interp_reexport_sharing.leaf.*
val shadow_late = "mid-late"

fn dup() -> text:
    "mid-dup"

fn mid_fn() -> text:
    "mid_fn"

fn mid_other() -> text:
    "mid_other"

fn mid_reads() -> text:
    "{leaf_fn()}|{dup()}|{shadow_early}|{shadow_late}|{leaf_val}|{leaf_counter}"

val mid_eval_early = shadow_early
val mid_eval_late = shadow_late

fn mid_eval_reads() -> text:
    "{mid_eval_early}|{mid_eval_late}"
