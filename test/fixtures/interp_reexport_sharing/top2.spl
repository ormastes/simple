# Sees mid's export table only (no facade masking it), plus an aliased live
# global and a write through an imported global.
use test.fixtures.interp_reexport_sharing.mid.{mid_fn}
use test.fixtures.interp_reexport_sharing.leaf.{leaf_counter as lc, leaf_bump}

fn top2_shadow() -> text:
    "{shadow_early}|{shadow_late}|{mid_eval_reads()}|{leaf_fn()}"

fn top2_alias_live() -> text:
    val bumped = leaf_bump()
    "{bumped}|{lc}|{leaf_counter}"

fn top2_write_through() -> text:
    leaf_counter = 40
    "{leaf_counter}|{lc}|{leaf_bump()}"
