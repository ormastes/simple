# Leaf of the re-export sharing fixture graph: defines everything the
# importers resolve, so a lookup's provenance is visible in its value.
var leaf_counter: i64 = 0
val leaf_val = "leaf"
val twin = "leaf-twin"
val shadow_early = "leaf-early"
val shadow_late = "leaf-late"

fn leaf_fn() -> text:
    "leaf_fn"

fn dup() -> text:
    "leaf-dup"

fn leaf_bump() -> i64:
    leaf_counter = leaf_counter + 1
    leaf_counter

class LeafThing:
    tag: text
