use common.ui.window_scene.{
    WM_CONTENT_ORIGIN_GUI,
    WM_CONTENT_ORIGIN_PIXEL_SURFACE,
    WM_CONTENT_ORIGIN_SIMPLE_WEB,
}
use os.compositor.wm_action_lifecycle.{
    HOST_CONTENT_OWNER_BROWSER,
    HOST_CONTENT_OWNER_GUI,
    HOST_CONTENT_OWNER_LOCAL_WEB,
    HOST_CONTENT_OWNER_PIXEL,
    HOST_CONTENT_OWNER_REMOTE_WEB,
    host_content_owner_default,
    host_content_owner_for_frame,
    host_content_owner_requires_browser_renderer,
}

fn main() -> i64:
    if host_content_owner_default(0, "local", "create_window") != HOST_CONTENT_OWNER_LOCAL_WEB:
        return 1
    if host_content_owner_default(10, "remote", "create_window") != HOST_CONTENT_OWNER_REMOTE_WEB:
        return 2
    if host_content_owner_default(0, "browser", "create_window") != HOST_CONTENT_OWNER_BROWSER:
        return 3
    val gui = host_content_owner_for_frame(
        "remote", WM_CONTENT_ORIGIN_GUI
    )
    val pixel = host_content_owner_for_frame(
        "remote", WM_CONTENT_ORIGIN_PIXEL_SURFACE
    )
    val web = host_content_owner_for_frame(
        "remote", WM_CONTENT_ORIGIN_SIMPLE_WEB
    )
    if gui != HOST_CONTENT_OWNER_GUI or
        host_content_owner_requires_browser_renderer(gui):
        return 4
    if pixel != HOST_CONTENT_OWNER_PIXEL or
        host_content_owner_requires_browser_renderer(pixel):
        return 5
    if web != HOST_CONTENT_OWNER_REMOTE_WEB or
        not host_content_owner_requires_browser_renderer(web):
        return 6
    0
