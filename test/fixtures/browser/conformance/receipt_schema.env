schema=simple-web-browser-conformance-receipt-schema-v1
status=contract-only
allowed_statuses=pass,fail,blocked,unsupported
required_identity_fields=source_revision,binary_path,binary_sha256,manifest_path,manifest_sha256
required_suite_fields=wpt_revision,test262_revision,selected_case_count,pass_count,fail_count,unsupported_count
required_fuzz_fields=corpus_path,corpus_sha256,seed,elapsed_seconds,reproducer_count
pass_requires=all-selected-cases-pass-and-zero-unledgered-unsupported
artifact_hash_algorithm=sha256
