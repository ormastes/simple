# Deliberate negative: must FAIL to compile (pure-Simple MIR).
# `[T].pop()` is `T?`; passing it straight into a non-optional `T` parameter
# widened nil. Before the check this built and panicked at runtime with
# "total enum match fell through on 'NodeX'". The MIR call-argument check now
# refuses it, mirroring the enum-payload check. Fixed form: `.pop().unwrap()`.
# Record: doc/08_tracking/bug/mir_enum_payload_mismatch_loopregion_2026-11-20.md
enum NodeX:
    Step(work: i64)
    Loop(count: i64, body: NodeX)

fn depth(n: NodeX) -> i64:
    match n:
        case NodeX.Step(work): work
        case NodeX.Loop(count, body): count * 100 + depth(body)

fn main() -> i32:
    var built: [NodeX] = []
    built.push(NodeX.Loop(2, NodeX.Step(4)))
    print "depth={depth(built.pop())}"
    0
