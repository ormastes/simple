use definition.{Reader as SelectedReader}
use alternate_definition.{Reader as AlternateReader}
use provider.{first as make_first}
use alternate.{first as make_second}

fn via_parameter(reader: SelectedReader) -> i64:
    reader.read()

fn via_alternate_parameter(reader: AlternateReader) -> i64:
    reader.read()

fn main() -> i64:
    val first_value = make_first(7)
    val second_value = make_second(9)
    if first_value.read() != 7:
        return 1
    if second_value.read() != 90:
        return 2
    val explicit_first: SelectedReader = make_first(13)
    val explicit_second: AlternateReader = make_second(17)
    if explicit_first.read() != 13:
        return 3
    if explicit_second.read() != 170:
        return 4
    if via_parameter(first_value) != 7:
        return 5
    if via_alternate_parameter(second_value) != 90:
        return 6
    print "RETURNED_TRAIT_OWNER_PASS checks=6"
    0
