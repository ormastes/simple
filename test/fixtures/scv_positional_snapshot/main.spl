# Standalone bootstrap component entry for the same behavioral regression.
use .snapshot_case.{positional_snapshot_case}
use app.io._CliCompile.native_build_snapshot_roots.{native_build_snapshot_source_roots_v1}
use app.io.time_ops.{time_now_unix_micros}

fn main() -> i64:
    val explicit = native_build_snapshot_source_roots_v1("entry.spl", ["custom/lib"])
    if explicit.len() != 1 or explicit[0] != "custom/lib":
        print "POSITIONAL-SNAPSHOT-FAIL:explicit-roots"
        return 1
    val sibling_roots = native_build_snapshot_source_roots_v1("test/fixture/main.spl", [])
    if sibling_roots.len() != 4 or sibling_roots[3] != "test/fixture":
        print "POSITIONAL-SNAPSHOT-FAIL:entry-siblings"
        return 1
    for unsafe_entry in ["", "../main.spl", "/outside/main.spl", "D:/outside/main.spl", "src/../main.spl", "src/./main.spl", "src//main.spl", "src\\main.spl", "src/app/", "main.spl"]:
        if native_build_snapshot_source_roots_v1(unsafe_entry, []).len() != 0:
            print "POSITIONAL-SNAPSHOT-FAIL:scope-escape"
            return 1
    val result = positional_snapshot_case("build/component-positional-snapshot-{time_now_unix_micros()}")
    if result != "":
        print "POSITIONAL-SNAPSHOT-FAIL:{result}"
        return 1
    print "POSITIONAL-SNAPSHOT-PASS:membership-immutable-unadmitted-missing"
    0
