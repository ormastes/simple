# Final focused component: retain the earlier membership evidence and exercise
# only the failed containment oracle and previously unreached checks.
use .snapshot_case.{positional_snapshot_case}
use app.io.time_ops.{time_now_unix_micros}

fn main() -> i64:
    val result = positional_snapshot_case(
        "build/component-positional-snapshot-remaining-{time_now_unix_micros()}", true)
    if result != "":
        print "POSITIONAL-SNAPSHOT-FAIL:{result}"
        return 1
    print "POSITIONAL-SNAPSHOT-PASS:escape-immutable-missing"
    0
