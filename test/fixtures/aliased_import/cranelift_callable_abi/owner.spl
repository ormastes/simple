fn increment(value: i64) -> i64:
    value + 1

fn shift_double(value: f64) -> f64:
    value + 1.5

fn shift_single(value: f32) -> f32:
    value + 1.5

fn invert(value: bool) -> bool:
    not value

fn signed_step(value: i32) -> i32:
    value + 1

fn widen(value: i64) -> i64:
    value

fn answer() -> i64:
    42

fn emit(value: i64):
    print(value)
