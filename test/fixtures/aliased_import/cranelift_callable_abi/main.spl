use owner.{increment, shift_double, shift_single, invert, signed_step, widen, answer, emit}

fn invoke(callback: fn(i64) -> i64, value: i64) -> i64:
    callback(value)

fn pass_through(callback: fn(i64) -> i64) -> fn(i64) -> i64:
    callback

fn main():
    val integer = increment
    print(integer(41))
    print(invoke(integer, 41))
    val returned = pass_through(integer)
    print(returned(41))

    val double = shift_double
    if double(40.5) == 42.0:
        print(42)
    else:
        print(-1)

    val single = shift_single
    val single_input: f32 = 40.5
    if single(single_input) == 42.0:
        print(42)
    else:
        print(-2)

    val boolean = invert
    if boolean(false):
        print(42)
    else:
        print(-3)

    val signed = signed_step
    val negative: i32 = -43
    val narrow_result = signed(negative)
    print(narrow_result)
    val wide = widen
    print(wide(narrow_result))

    val plain: fn(i64) -> i64 = \x: x + 1
    print(plain(41))
    val offset = 2
    val captured: fn(i64) -> i64 = \x: x + offset
    print(captured(40))

    val no_args = answer
    print(no_args())
    val void_call = emit
    void_call(71)
