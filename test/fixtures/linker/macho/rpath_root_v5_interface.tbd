{
  "tapi_tbd_version": 5,
  "main_library": {
    "target_info": [
      {"target": "x86_64-macos"},
      {"target": "arm64-macos"}
    ],
    "install_names": [{"name": "/usr/lib/libitem4_rpath_root.dylib"}],
    "rpaths": [
      {"targets": ["x86_64-macos"], "paths": ["@loader_path/x64", "@loader_path/second"]},
      {"targets": ["arm64-macos"], "paths": ["@loader_path/a64", "@loader_path/second"]}
    ],
    "reexported_libraries": [{"names": ["@rpath/libitem4_rpath_leaf.dylib"]}]
  }
}
