--- !tapi-tbd
tbd-version: 4
targets: [ x86_64-macos, arm64-macos ]
install-name: /usr/lib/libitem4_leaf.dylib
exports:
  - targets: [ x86_64-macos, arm64-macos ]
    symbols: [ _helper, _value ]
    weak-symbols: [ _unused_weak ]
    thread-local-symbols: [ _tls ]
    objc-classes: [ Item4Class ]
    objc-eh-types: [ Item4Exception ]
    objc-ivars: [ Item4Class.field ]
...
