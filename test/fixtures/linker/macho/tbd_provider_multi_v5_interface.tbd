{
  "main_library": {
    "compatibility_versions": [
      {
        "version": "1.2"
      }
    ],
    "current_versions": [
      {
        "version": "2.3.4"
      }
    ],
    "exported_symbols": [
      {
        "data": {
          "global": [
            "_helper",
            "_value"
          ]
        }
      }
    ],
    "flags": [
      {
        "attributes": [
          "not_app_extension_safe"
        ]
      }
