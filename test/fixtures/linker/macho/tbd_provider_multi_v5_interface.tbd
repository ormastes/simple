        "name": "@rpath/libitem4.dylib"
      }
    ],
    "target_info": [
      {
        "target": "x86_64-macos"
      },
      {
        "min_deployment": "11",
        "target": "arm64-macos"
      }
    ]
  },
  "tapi_tbd_version": 5
}
