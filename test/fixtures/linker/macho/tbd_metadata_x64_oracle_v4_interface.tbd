--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos ]
install-name:    '/usr/lib/libitem4_metadata.dylib'
current-version: 2.3.4
compatibility-version: 1.2
parent-umbrella:
  - targets:         [ x86_64-macos ]
    umbrella:        Item4Framework
allowable-clients:
  - targets:         [ x86_64-macos ]
    clients:         [ item4_client ]
reexported-libraries:
  - targets:         [ x86_64-macos ]
    libraries:       [ '/usr/lib/libitem4_child.dylib' ]
exports:
  - targets:         [ x86_64-macos ]
    symbols:         [ _shared, _x64_only ]
    objc-classes:    [ Item4Class, Item4Exception ]
    objc-eh-types:   [ Item4Exception ]
    objc-ivars:      [ Item4Class.field ]
    weak-symbols:    [ _weak ]
    thread-local-symbols: [ _tls ]
--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos ]
install-name:    '/usr/lib/libitem4_child.dylib'
exports:
  - targets:         [ x86_64-macos ]
    symbols:         [ _child ]
...
