#!/bin/sh
# Rebuild the riscv64 dynamic fixtures for elf_riscv64_dynamic_spec (clang + ld.lld 18 only).
# Usage (WSL/Linux): sh test/fixtures/linker/elf/rebuild_rv64_dynamic.shs [--oracle]
set -eu
cd "$(dirname "$0")"
PATH=/usr/lib/llvm-18/bin:$PATH
command -v clang >/dev/null && clang --version | grep -q 'version 18\.' || { echo "ERROR: clang 18 required" >&2; exit 2; }
PIC="-c -O1 -ffreestanding -fPIC -fno-stack-protector -fno-asynchronous-unwind-tables -fno-unwind-tables -nostdlib -mno-relax"
T="--target=riscv64-linux-gnu -march=rv64gc -mabi=lp64d"
W=$(mktemp -d)
clang $T $PIC dyn_start_rv64.c -o dyn_start_rv64.o
clang $T $PIC dyn_lib_rv64.c -o dyn_lib_rv64.o
cp dyn_lib_rv64.o "$W/l.o"
ld.lld -shared --soname libadd_rv64.so --hash-style=both -o libadd_rv64.so.1 "$W/l.o"
if [ "${1:-}" = "--oracle" ]; then
  for m in "" "-pie"; do
    ld.lld --no-relax --dynamic-linker /lib/ld-linux-riscv64-lp64d.so.1 $m -o "$W/dyn_lld$m" dyn_start_rv64.o libadd_rv64.so.1
    llvm-readelf -S -r "$W/dyn_lld$m" | grep -E " \.(plt|got|rela|sdata)|R_RISCV" || true
  done
fi
rm -rf "$W"
