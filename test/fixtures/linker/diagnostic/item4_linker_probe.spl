# Diagnostic only: unadmitted pure-Simple candidate, not SSpec/release evidence.
use compiler.backend.linker.elf.elf_static_link.{elf_link, ElfLinkRequest, ELF_LINK_DYNAMIC_EXEC}
use compiler.backend.linker.elf_parser.{elf_parse_object}
use compiler.backend.linker.reloc_engine.{RelocArch}

fn main() -> i64:
    val request = ElfLinkRequest(objects: [], archives: [], shared: [],
        entry: "_start", target: RelocArch.X86_64,
        mode: ELF_LINK_DYNAMIC_EXEC, interp: "/loader\0/ignored")
    val linked = elf_link(request)
    if linked.is_ok(): return 1
    if linked.unwrap_err() != "dynamic interpreter path contains NUL (PT_INTERP)": return 2
    var header: [u8] = []
    while header.len() < 64:
        header = header.push(0u8)
    header[0] = 127u8
    header[1] = 69u8
    header[2] = 76u8
    header[3] = 70u8
    header[4] = 2u8
    header[5] = 1u8
    header[6] = 1u8
    header[16] = 1u8
    header[18] = 62u8
    header[20] = 1u8
    header[52] = 64u8
    header[58] = 64u8
    header[60] = 1u8
    var index: i64 = 40
    while index < 47:
        header[index] = 255u8
        index = index + 1
    header[47] = 127u8
    val parsed = elf_parse_object(header)
    if parsed.is_ok(): return 3
    if parsed.unwrap_err() != "Section header table extends beyond file end": return 4
    0
