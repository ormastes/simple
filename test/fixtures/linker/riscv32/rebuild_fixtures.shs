#!/bin/sh
# Rebuild start.o / provider.o for the riscv32 fixtures (clang + ld.lld only).
# Usage (WSL/Linux): sh test/fixtures/linker/riscv32/rebuild_fixtures.shs [--oracle]
set -eu
cd "$(dirname "$0")"
CL=$(command -v clang-21 || command -v clang-18 || command -v clang)
for f in start provider; do "$CL" --target=riscv32-unknown-elf -march=rv32imac -mabi=ilp32 -c $f.s -o $f.o; done
if [ "${1:-}" = "--oracle" ]; then
  LLD=$(command -v ld.lld-21 || command -v ld.lld-18 || command -v ld.lld)
  RE=$(command -v llvm-readelf-21 || command -v llvm-readelf-18 || command -v llvm-readelf)
  W=$(mktemp -d); trap 'rm -rf "$W"' EXIT
  "$LLD" --no-relax -static -e _start -Ttext=0x80200000 start.o provider.o -o "$W/oracle.elf"
  "$RE" -s "$W/oracle.elf" | grep -E ' (_start|worker|done_label|fail_label|data_value|data_ptr)$'
fi
