# Lane A5 corpus row: compiler_plus_providers.
# Distinct from full_compiler_release: bootstrap_main.spl (Stage 3) exposes
# ONLY `compile`/`native-build` by design (src/app/cli/bootstrap_main.spl
# dispatch, lines 459-492, per .claude/rules/commands.md). The "compiler plus
# providers" row is the Stage-4 full CLI entry, src/app/cli/main.spl, which
# additionally links every provider command surface (mcp, lsp, debug, t32,
# etc.) into one binary — materially more object/archive inputs and a bigger
# link job than the bootstrap-only Stage 3 target.
corpus:
  name: "compiler_plus_providers"
  class: "native_backend"
  producer: "self-hosted native-build, full CLI entry (Stage 4 tool identity 'cli')"
  # Tool identity table verified at scripts/bootstrap/stage4-tools-only.sh:46-49:
  #   cli:src/app/cli/main.spl -> simple
  #   mcp:src/app/mcp/main.spl -> simple_mcp_server
  #   lsp:src/app/simple_lsp_mcp/main.spl -> simple_lsp_mcp_server
  # "compiler plus providers" = the 'cli' identity link job (main.spl pulls in
  # every dispatch-table provider, .claude/rules/code-style.md's MCP-server
  # table), not a separate multi-binary link.
  inputs: "<admitted-compiler> native-build --target <triple> --backend <llvm|cranelift> --runtime-bundle core-c-bootstrap --mode dynload --runtime-path <runtime-dir> -o simple src/app/cli/main.spl   # same producer path as full_compiler_release, entry swapped from bootstrap_main.spl to main.spl per stage4-tools-only.sh:48"
  linker_script: "none"
  target_triple: "x86_64-unknown-linux-gnu (also aarch64-unknown-linux-gnu)"
  expected_outcome: "simple binary whose command surface is the full ~60-command CLI (test/lint/fmt/build/run/mcp/lsp/...), not just compile/native-build; larger symbol/section closure than full_compiler_release"
  status: "blocked:requires-admitted-stage2-binary"
  status_reason: "same Stage-3/4 receipt-gated chain as full_compiler_release; the stage4-tools-only.sh publish path additionally requires a validated tool-compile journal (--tool-compile-journal) and a compiler manifest hash match, neither of which this lane's worktree carries. Recipe captured for A7/A9 slice-2 (LLVM corpus) once available."
