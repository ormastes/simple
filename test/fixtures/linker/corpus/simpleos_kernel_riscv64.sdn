# Lane A5 corpus row: simpleos_kernel_riscv64.
# Target script: src/os/kernel/arch/riscv64/linker.ld.
corpus:
  name: "simpleos_kernel_riscv64"
  class: "native_backend"
  producer: "self-hosted native-build, generic --linker-script path, LLVM backend"
  # Row table: scripts/check/rebuild-sosix-qemu-media.shs:89/91 (llvm, 64-bit);
  # dispatch case at :312-315 ("riscv64) ... --linker-script \"$linker\"").
  # Lower-level mechanism verified directly in
  # src/compiler/70.backend/backend/simpleos_native_linkers.spl:358-364
  # (link_simpleos_riscv64): default linker_script is
  # "src/os/kernel/arch/riscv64/linker.ld" ITSELF (this is the one arch whose
  # in-repo default already matches the plan's required path with no override
  # needed), linked via `ld -m elf64lriscv -T <script> --entry=__simple_riscv_entry`.
  # A real-firmware (OpenSBI, not -kernel) boot path for this exact
  # crt0.S+linker.ld pair is separately gated by
  # scripts/check/check-simpleos-riscv64-opensbi-guest-boot.shs:56,150.
  inputs: "$COMPILER native-build --source src/os --source src/lib --source examples/09_embedded/simple_os --backend llvm --opt-level=aggressive --entry-closure --entry examples/09_embedded/simple_os/arch/riscv64/smoke_entry.spl --target riscv64-unknown-none --output simpleos_riscv64.elf --linker-script src/os/kernel/arch/riscv64/linker.ld"
  linker_script: "src/os/kernel/arch/riscv64/linker.ld"
  target_triple: "riscv64-unknown-none"
  expected_outcome: "freestanding ELF64 kernel image linked by ld -m elf64lriscv -T src/os/kernel/arch/riscv64/linker.ld --entry=__simple_riscv_entry; magic 7f454c46; real-OpenSBI boot evidence available via check-simpleos-riscv64-opensbi-guest-boot.shs"
  status: "runnable-here"
  status_reason: "the in-repo default linker_script for this arch already IS src/os/kernel/arch/riscv64/linker.ld (no path substitution needed, unlike the arm64/x86_64 rows); not executed this pass — see the time-budget note on the x86_32 row"
