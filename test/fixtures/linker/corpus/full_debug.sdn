# Lane A5 corpus row: full_debug.
# Debug-info-preserving counterpart to the release rows above. `native-build`
# itself has no --opt-level/--no-strip flags (checked: src/app/cli/native_build_main.spl
# --help lists only --release as an opt toggle); the debug-preserving path is
# the single-shot `compile --native` entry point, which does expose them.
corpus:
  name: "full_debug"
  class: "native_backend"
  producer: "self-hosted compile --native, LLVM backend, unstripped"
  # Flags verified from `simple compile --help` on this host (bin/simple, the
  # Rust seed, 2026-09-18): "--opt-level <level>  none, basic, standard,
  # aggressive" and "--no-strip  Keep debug info and symbols (default only
  # overrides host --native auto-strip)".
  inputs: "$B compile --native --backend llvm --opt-level none --no-strip -o simple_debug src/app/cli/bootstrap_main.spl"
  linker_script: "none"
  target_triple: "aarch64-unknown-linux-gnu"
  expected_outcome: "ET_EXEC/ET_DYN binary carrying .debug_info/.debug_line and unstripped symtab; larger, slower-to-link than the aggressive-opt release rows, exercising the debug-identity verification item in research doc §11"
  status: "runnable-here"
  status_reason: "flags and entry are real and exercise the same compile path as small_cli; not yet run to completion in this lane (compiling the full bootstrap_main.spl closure is the same multi-minute cold-checkout SCV admission cost documented on small_cli's row, and this lane's time budget went to the census on the small_cli/giant_object rows instead — same recipe, unexecuted)"
