# Lane A5 corpus row: simpleos_kernel_x86_64.
# Target script: src/os/kernel/arch/x86_64/linker.ld.
corpus:
  name: "simpleos_kernel_x86_64"
  class: "native_backend"
  producer: "self-hosted native-build, generic --linker-script path, cranelift backend"
  # Row table: scripts/check/rebuild-sosix-qemu-media.shs:75/77 (entry/linker
  # default) and :78 (backend "cranelift", 64-bit); dispatch case at :320-323
  # ("x86_64) ... --cpu x86-64-v1 ... --linker-script \"$linker\""). Lower-level
  # mechanism: src/compiler/70.backend/backend/simpleos_native_linkers.spl:210-234
  # (link_simpleos_x86_64 freestanding path) reads SIMPLE_NATIVE_BUILD_LINKER_SCRIPT
  # to override its default examples/ script and invokes the linker directly
  # with "-T", linker_script.
  inputs: "$COMPILER native-build --source src/os --source src/lib --source examples/09_embedded/simple_os --backend cranelift --cpu x86-64-v1 --opt-level=aggressive --entry-closure --entry examples/09_embedded/simple_os/arch/x86_64/fs_exec_entry.spl --target x86_64-unknown-none --output simpleos_x86_64.elf --linker-script src/os/kernel/arch/x86_64/linker.ld"
  linker_script: "src/os/kernel/arch/x86_64/linker.ld"
  target_triple: "x86_64-unknown-none"
  expected_outcome: "freestanding ELF64 kernel image, magic 7f454c46; linker.ld carries the Limine boot-protocol layout (per its header comment, distinct from the examples/ 'Bare-Metal' variant)"
  status: "runnable-here"
  status_reason: "flag mechanism, backend, target and entry verified against the real dispatch script and the internal linker function; not executed this pass (see thinlto/x86_32 rows for the same time-budget note)"
