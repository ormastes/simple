# Lane A5 corpus row: full_compiler_release.
# The "6 GB target" named in the plan (§6.1) and research doc §9 — Stage 3 of
# the sanctioned bootstrap, which self-links the compiler's own bootstrap CLI.
corpus:
  name: "full_compiler_release"
  class: "native_backend"
  producer: "self-hosted native-build (dynload mode), driven by the admitted Stage-2 binary"
  # Real command lifted verbatim (flags only, paths generalized) from
  # scripts/bootstrap/resume-stage3-from-admitted.sh:682-686 (also :712-716,
  # the transcribed variant of the same invocation). This is the actual
  # Stage-3 producer of bin/release/<triple>/simple.
  inputs: "SIMPLE_BOOTSTRAP=1 SIMPLE_NATIVE_BUILD_TARGET=<triple> SIMPLE_NATIVE_RUNTIME_BUNDLE=core-c-bootstrap SIMPLE_BINARY=<stage2-admitted-binary> <stage2-admitted-binary> native-build --target <triple> --backend <llvm|cranelift> --runtime-bundle core-c-bootstrap --threads <N> --cache-dir <stage3-cache> --mode dynload --runtime-path <runtime-dir> -o <candidate> src/app/cli/bootstrap_main.spl"
  linker_script: "none (ELF dynload executable; no -T script — see boot_layout lane A9 for kernel-style scripts)"
  target_triple: "x86_64-unknown-linux-gnu (also aarch64-unknown-linux-gnu; both are Stage-3 platforms per resume-stage3-from-admitted.sh)"
  expected_outcome: "bin/release/<triple>/simple binary that boots, whose native-build/compile dispatch matches src/app/cli/bootstrap_main.spl:459-492 (compile + native-build only); receipt-gated, no bypass"
  status: "blocked:requires-admitted-stage2-binary"
  status_reason: "the command is real and unmodified, but it is only runnable through the full bootstrap-from-scratch.sh receipt/planner-admission chain (per .claude/rules/bootstrap.md), not standalone in this lane's worktree; running it here would fabricate an unadmitted candidate. Recipe is captured so A5's census script and A7/A9 can drive it once an admitted Stage-2 binary is available."
