# Target script: src/os/kernel/arch/riscv32/linker.ld.
corpus:
  name: "simpleos_kernel_riscv32"
  class: "native_backend"
  producer: "self-hosted native-build, generic --linker-script path, LLVM backend"
  # Row table: scripts/check/rebuild-sosix-qemu-media.shs:86 (llvm, 32-bit);
  # dispatch case at :316-317 ("riscv32) ... --linker-script \"$linker\"").
  # src/os/port/_SimpleosMultiplatformBuild/platform_target_catalog.spl:539,552
  # names src/os/kernel/arch/riscv32/linker.ld explicitly as the riscv32 kernel
  # target's linker_script (a distinct fpga_linker.ld variant exists at :592
  # for the FPGA row — out of scope here). A real external cross-toolchain
  # command for this arch's boot object is independently confirmed at
  # scripts/check/check-nvme-rv32-minimal-live.shs:734
  # ("riscv64-unknown-elf-gcc -march=rv32imac -mabi=ilp32 -c ...").
  inputs: "$COMPILER native-build --source \"examples/09_embedded/simple_os/arch/riscv32\" --source build/os/generated --backend llvm --opt-level=aggressive --entry-closure --entry examples/09_embedded/simple_os/arch/riscv32/smoke_entry.spl --target riscv32-unknown-none --output simpleos_riscv32.elf --linker-script src/os/kernel/arch/riscv32/linker.ld"
  linker_script: "src/os/kernel/arch/riscv32/linker.ld"
  target_triple: "riscv32-unknown-none"
  expected_outcome: "freestanding ELF32 kernel image, magic 7f454c46; boot crt objects assembled by riscv64-unknown-elf-gcc -march=rv32imac -mabi=ilp32 per the verified nvme-rv32 script"
  status: "runnable-here"
  status_reason: "flag mechanism, target and catalog linker_script identity verified directly; not executed this pass — see the time-budget note on the x86_32 row"
