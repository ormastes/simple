# Lane A5 corpus row: small_cli.
# Smallest realistic native-backend link job — one file, one `main`, prelude
# closure only. Baseline floor for the census and for regression comparisons
# against the other, much larger rows in this directory.
corpus:
  name: "small_cli"
  class: "native_backend"
  producer: "self-hosted native-build, LLVM codegen backend, --emit-object"
  # Real, runnable command (verified 2026-09-18 on the aarch64 host): `simple
  # native-build --emit-object` compiles+links a single-file entry through the
  # normal native pipeline but stops at the relocatable-object stage instead of
  # invoking the external linker. Flag confirmed real (not invented) at
  # src/app/cli/native_build_main.spl:189,958 ("--emit-object  Emit relocatable
  # object output"). A cold checkout has no admitted SCV source inventory yet,
  # so the two env vars below are required or the build fails closed with
  # SCV-E-SNAPSHOT/SCV-E-ADMISSION (observed directly this run).
  inputs: "SIMPLE_SCV_INVENTORY_COLD_INIT=1 SIMPLE_SCV_FREEZE_FALLBACK=1 $B native-build --emit-object --backend llvm -o hello_native.o hello.spl   # hello.spl: fn main(): print \"hello\""
  linker_script: "none"
  target_triple: "aarch64-unknown-linux-gnu"
  expected_outcome: "one relocatable ELF object (ET_REL) naming main and the prelude closure it reaches; llvm-readelf -r enumerates its R_AARCH64_* relocation set"
  status: "runnable-here"
  status_reason: "verified 2026-09-18 on this aarch64 host; see census evidence in the PR body for the resulting R_AARCH64_* set (build is long — full stdlib closure — and was still in flight at report time, see report note)"
