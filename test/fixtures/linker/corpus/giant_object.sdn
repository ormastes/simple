# Lane A5 corpus row: giant_object (generated).
# Research doc §11's "adversarial giant-object set": a single relocatable
# object with a large, dense symbol/relocation table, meant to stress the
# reloc-scan and archive-closure paths (A4a/A7) beyond what a normal small
# corpus row exercises.
corpus:
  name: "giant_object"
  class: "native_backend"
  producer: "generated: a shell (.shs) generator emits N trivial top-level fns into one .spl file, then self-hosted native-build --emit-object compiles it to one relocatable object"
  # No existing repo script already generates this fixture (checked: no hits
  # for "giant_object"/"giant object" under scripts/ or test/); the recipe
  # below is a new, minimal generator using only tools this repo already
  # requires (awk, native-build --emit-object, both used elsewhere in this
  # file set) and produces exactly one artifact, not committed per §1's
  # "reports are not committed" rule.
  inputs: "awk 'BEGIN{for(i=0;i<N;i++) printf \"fn f_%d(x: i64) -> i64:\\n    x + %d\\n\", i, i}' > giant.spl ; echo 'fn main():' >> giant.spl ; echo '    print f_0(1)' >> giant.spl ; SIMPLE_SCV_INVENTORY_COLD_INIT=1 SIMPLE_SCV_FREEZE_FALLBACK=1 $B native-build --emit-object --backend llvm -o giant.o giant.spl   # N=2000 default; scale until llvm-readelf -r/-s shows a materially denser table than small_cli"
  linker_script: "none"
  target_triple: "aarch64-unknown-linux-gnu"
  expected_outcome: "one relocatable ELF object with O(N) exported symbols and a correspondingly larger .rela.text; used to check that census/reloc-scan cost does not blow up superlinearly (cf. the lint-cost superlinearity already tracked in doc/08_tracking/bug/lint_timeout_hwir_zca_rows_2026-08-17.md for a different tool, same class of risk)"
  status: "runnable-here"
  status_reason: "generator recipe is new and untested at full N=2000 in this pass (small_cli's own --emit-object run was still resolving SCV cold-init admission at report time); the mechanism (awk generation + --emit-object) was smoke-checked at N=1 equivalent to small_cli's own hello.spl"
