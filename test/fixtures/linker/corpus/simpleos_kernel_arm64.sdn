# Lane A5 corpus row: simpleos_kernel_arm64.
# Target script: src/os/kernel/arch/arm64/linker.ld.
corpus:
  name: "simpleos_kernel_arm64"
  class: "native_backend"
  producer: "self-hosted native-build, generic --linker-script path, cranelift backend"
  # Row table: scripts/check/rebuild-sosix-qemu-media.shs:82/84 (cranelift, 64-bit);
  # dispatch case at :318-319 ("arm64) ... --linker-script \"$linker\"").
  # Lower-level mechanism verified directly in
  # src/compiler/70.backend/backend/simpleos_native_linkers.spl:73-89
  # (link_simpleos_arm64): default linker_script is the examples/ path, but it
  # reads env SIMPLE_NATIVE_BUILD_LINKER_SCRIPT first and, when set, links with
  # `ld.lld -T <that script> -nostdlib --gc-sections -o <output> <objects>`
  # (process_run("ld.lld", args) at line 80). platform_target_catalog.spl:44,57
  # independently names src/os/kernel/arch/arm64/linker.ld as the real kernel
  # target's linker_script field (as opposed to its fs_exec sibling, which uses
  # the examples/ script at lines 74,97,120).
  inputs: "$COMPILER native-build --source src/os --source src/lib --source examples/09_embedded/simple_os --backend cranelift --opt-level=aggressive --entry-closure --entry examples/09_embedded/simple_os/arch/arm64/fs_exec_entry.spl --target aarch64-unknown-none --output simpleos_arm64.elf --linker-script src/os/kernel/arch/arm64/linker.ld"
  linker_script: "src/os/kernel/arch/arm64/linker.ld"
  target_triple: "aarch64-unknown-none"
  expected_outcome: "freestanding ELF64 kernel image linked by ld.lld -T src/os/kernel/arch/arm64/linker.ld -nostdlib --gc-sections; magic 7f454c46; a board-runnable path exists via scripts/check/check-simpleos-arm64-efi-real-firmware-boot.shs per .claude/rules/board-runnable.md"
  status: "runnable-here"
  status_reason: "both the CLI-flag path (rebuild-sosix-qemu-media.shs) and the internal ld.lld invocation it overrides (simpleos_native_linkers.spl) are read directly, not inferred; not executed this pass — see the time-budget note on the x86_32 row"
