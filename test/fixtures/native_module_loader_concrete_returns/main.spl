use compiler.loader.module_loader.{LoadedModule}

fn main() -> i64:
    val loaded = LoadedModule(
        path: "/tmp/missing.smf",
        reader: "",
        symbols: {},
        load_time: 0,
        version: 1
    )
    val passed = loaded.get_symbol("missing") == nil
    print("module loader concrete returns resolved: {passed}")
    if passed: 0 else: 1
