# Native fixture: builtin numeric suffix literals (`0u64`, `1u8`, `2u32`) in
# several files of one build must parse on every file, not only the first.
#
# Bug: the unit-suffix scope kept its library lookup caches in process
# globals, but the driver parses each file inside a transient array scope and
# frees everything born in it. From the second file on the cache was freed
# memory: native-build failed with
#   parse error in m1.spl: 0:0:unit suffix 'u64' is not in scope; add  (or declare `unit X: T as u64`)
# and larger closures SEGVed in unit_library_families (seen at
# src/lib/common/crypto/sha256.spl).
# doc/08_tracking/bug/unit_scope_cache_freed_by_transient_parse_scope_2026-11-17.md
#
# Expected stdout (the seed interpreter is the reference):
#   total=27
#   b=1 3 c=6 9
#
# Run from a copy of this directory outside test/ (closure builds exclude
# fixture trees): `native-build main.spl --backend=<cranelift|llvm>
# --entry-closure`, then compare its stdout with
# `SIMPLE_EXECUTION_MODE=interpret <seed> run main.spl`.
use m1.{f1_a, f1_b, f1_c}
use m2.{f2_a, f2_b, f2_c}
use m3.{f3_a, f3_b, f3_c}
use m4.{f4_a, f4_b, f4_c}
use m5.{f5_a, f5_b, f5_c}
use m6.{f6_a, f6_b, f6_c}

fn main():
    val total = f1_a(0u64) + f2_a(0u64) + f3_a(0u64) + f4_a(0u64) + f5_a(0u64) + f6_a(1u64)
    print "total={total}"
    print "b={f1_b(0u8)} {f2_b(2u8)} c={f3_c(1u32)} {f6_c(1u32)}"
