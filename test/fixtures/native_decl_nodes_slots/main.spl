use compiler.core.ast.{
    ast_reset, decl_count, decl_fn, module_add_decl,
    module_decl_count_get, module_decl_at
}

fn main() -> i64:
    ast_reset()
    val decl = decl_fn("slot_guard", [], [], 0, [], 0, [], 0)
    module_add_decl(decl)
    val populated = decl_count() == 1 and module_decl_count_get() == 1 and module_decl_at(0) == decl
    ast_reset()
    val cleared = decl_count() == 0 and module_decl_count_get() == 0
    val passed = populated and cleared
    print("decl node slots resolved: {passed}")
    if passed: 0 else: 1
