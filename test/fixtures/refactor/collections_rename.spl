# Migration closure: `containers`/`collections` API onto one trait set —
# every `insert(k, v)` method declaration and call site becomes `set(k, v)`.
# MIG-01: call sites are rewritten; no alias is left behind.
fn matches(node: NodeView) -> bool:
    (node.kind == "fn_decl" or node.kind == "method_call") and node.name == "insert"

fn rewrite(node: NodeView, ctx: RewriteCtx) -> [Edit]:
    [ctx.rename(node, "set")]
