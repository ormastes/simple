# Migration closure: untyped `fn first|last|get|pop():` on a container class
# gets `-> <elem>?` where <elem> is the owner's first type parameter.
# Absence stays `nil` (ERR-01): no `None` is introduced.
fn matches(node: NodeView) -> bool:
    if node.kind != "fn_decl" or node.ret_type != "" or node.owner == "": return false
    node.name == "first" or node.name == "last" or node.name == "get" or node.name == "pop"

fn rewrite(node: NodeView, ctx: RewriteCtx) -> [Edit]:
    if node.owner_type_params == "":
        return [ctx.note(node, "{node.owner}.{node.name}: owner has no type parameter; choose the element type by hand")]
    val elem = split_top_level_args(node.owner_type_params)[0].trim()
    [ctx.set_return_type(node, elem + "?")]
