# Migration closure (class shape): `xs[i]` inside `unsafe:` becomes the
# explicit `xs.get_unchecked(i)`; outside `unsafe:` the site is only noted —
# autofix never inserts `unsafe` (SAF rules).
class UncheckedIndex:
    fn matches(node: NodeView) -> bool:
        node.kind == "index" and not node.args_text.contains(":")

    fn rewrite(node: NodeView, ctx: RewriteCtx) -> [Edit]:
        if node.in_unsafe:
            return [ctx.replace(node, "{node.receiver}.get_unchecked({node.args_text})")]
        [ctx.note(node, "unchecked `{node.text}` outside unsafe: use `{node.receiver}.get({node.args_text})` (T?) or prove the bound")]
