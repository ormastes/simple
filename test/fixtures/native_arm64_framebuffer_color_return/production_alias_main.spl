use std.color.types.{Color as PaintColor}
use os.compositor.decorations.{title_bar_color_focused, close_button_bg, border_color_focused}

fn main():
    val paint = PaintColor(r: 1, g: 2, b: 3, a: 4)
    print(paint.a)
    val title = title_bar_color_focused()
    print(title.r)
    print(title.g)
    print(title.b)
    print(title.a)
    val close = close_button_bg()
    print(close.r)
    print(close.g)
    print(close.b)
    val border = border_color_focused()
    print(border.r)
    print(border.g)
    print(border.b)
