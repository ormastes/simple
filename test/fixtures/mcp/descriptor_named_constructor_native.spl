struct McpStaticTool:
    name: text
    desc: text
    req: text

fn _mcp_static_tool(name: text, desc: text, req: text) -> McpStaticTool:
    # WORKAROUND(mir_struct_literal_kind_unimplemented_2026_10_12):
    # Pure local reads match declaration order; keep the general literal bug open.
    McpStaticTool(name: name, desc: desc, req: req)


fn main() -> i64:
    val first = _mcp_static_tool("debug_create_session", "[debug] Create a debug session (native DAP handler)", "[]")
    assert(first.name == "debug_create_session")
    assert(first.desc == "[debug] Create a debug session (native DAP handler)")
    assert(first.req == "[]")
    val empty = _mcp_static_tool("", "", "")
    assert(empty.name == "")
    assert(empty.desc == "")
    assert(empty.req == "")
    val escaped = _mcp_static_tool("unicode_é", "description with quoted \"value\"", "[\"program\",\"file\"]")
    assert(escaped.name == "unicode_é")
    assert(escaped.desc == "description with quoted \"value\"")
    assert(escaped.req == "[\"program\",\"file\"]")
    print("MCP descriptor native 9 field assertions PASS")
    0
