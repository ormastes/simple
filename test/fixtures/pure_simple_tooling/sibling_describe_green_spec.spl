"""
## Purpose and audience
Pure tooling fixture for the spec runner's sibling-describe lane: two sibling
`describe` blocks in one file must both load and both execute, proving the
runner does not fold a second top-level describe into the first. For runner
maintainers and CI owners changing discovery, collection, or execution order.
## Operator workflow
./src/compiler_rust/target/bootstrap/simple run test/fixtures/pure_simple_tooling/sibling_describe_green_spec.spl
A healthy run reports 2 executed, 0 failed, with both sibling scenario names
listed as passed, and exit code 0.
## Compatibility and limitations
Deliberately minimal: no imports beyond std.spec, no helpers, no runtime
captures — it exists to pin sibling-describe structure, not product
behavior. Do not add a third describe or merge the two; both shapes are the
contract under test.
## Verification guidance and troubleshooting
If the second sibling stops executing, discovery folded the sibling
describes into one — check the runner's describe collector. A failure here
is a runner regression, not a fixture defect.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.*

# @manual_section: sibling describe green fixture
describe "first sibling":
    # @manual scenario evidence
    it "executes first":
        # @req REQ-TEST-RUNNER-SIBLING-001
        # @capture(statistics): executed-example count for the first sibling describe
        step("Run the first sibling describe block to completion")
        val first_marker = "first"
        val first_marker_length = first_marker.len()
        expect(first_marker_length).to_equal(5)  # oracle: the first sibling's marker is the 5-byte literal "first"

describe "second sibling":
    it "executes second":
        # @req REQ-TEST-RUNNER-SIBLING-001
        # @capture(statistics): executed-example count for the second sibling describe
        step("Run the second sibling describe block to completion")
        val second_marker = "second"
        val second_marker_length = second_marker.len()
        expect(second_marker_length).to_equal(6)  # oracle: the second sibling's marker is the 6-byte literal "second"
