use std.spec.*

describe "assertion failure accumulation":
    it "keeps an earlier failure when a later assertion passes":
        expect("actual").to_equal("expected")
        expect("left").to_equal("right")
        expect("later").to_equal("later")

    it "clears failures before the next example":
        expect(false).to_equal(false)
        expect("next").to_equal("next")
