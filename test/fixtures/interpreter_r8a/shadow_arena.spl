# Module-global arena + uninitialised fixed-size module state, consumed by
# test/01_unit/compiler/interpreter/local_shadows_module_global_spec.spl.
var r8a_arena: [[i64]] = []
var r8a_slots: [i64; 4]

fn r8a_arena_push(b: [i64]):
    r8a_arena.push(b)

fn r8a_arena_len() -> i64:
    r8a_arena.len()

fn r8a_slot_set(i: i64, v: i64):
    r8a_slots[i] = v

fn r8a_slot_get(i: i64) -> i64:
    r8a_slots[i]
