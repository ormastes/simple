use compiler.tools.lint.main.{Lint, LintResult, parse_lint_profile}
use std.tooling.easy_fix.types.{LintLevel, LintCategory}

fn main() -> i64:
    match parse_lint_profile("critical"):
        case Some(_): pass
        case _: return 11
    val lint = Lint.new("W001", LintLevel.Warn, LintCategory.Style, "fixture")
    val result = LintResult.new("fixture.spl", 7, 11, lint)
    val passed = (
        result.line == 7 and result.column == 11 and
        result.format().contains("fixture.spl:7:11") and
        not result.has_easy_fix()
    )
    print("lint config model resolved: {passed}")
    if passed: 0 else: 12
