use compiler.core.ast.{ast_reset, module_get_decls, decl_get_ret_type}
use compiler.core.types.{is_union_tag, union_tag_to_id, union_type_get_members}
use compiler.frontend.core.frontend.{core_frontend_parse_reset}

fn members(decl_id: i64) -> [i64]:
    val tag = decl_get_ret_type(decl_id)
    if not is_union_tag(tag):
        return []
    union_type_get_members(union_tag_to_id(tag))

fn main() -> i64:
    ast_reset()
    val source = "val first: i64 | text = 1\nlazy val second: text | bool = \"x\"\nvar third: bool | i64 = true\nval same: i64 | text = 2\nval scalar: bool = false\n"
    if not core_frontend_parse_reset(source, "native_union_decl_owner.spl"):
        return 41
    val decls = module_get_decls()
    if decls.len() != 5:
        return 42
    if members(decls[0]) != [2, 4]:
        return 43
    if members(decls[1]) != [4, 1]:
        return 44
    if members(decls[2]) != [1, 2]:
        return 45
    if decl_get_ret_type(decls[0]) != decl_get_ret_type(decls[3]):
        return 46
    if decl_get_ret_type(decls[4]) != 1:
        return 47
    0
