# Deterministic refusal: promotion must fail while the scope is unpaused.
# This checks normal cleanup without debugger injection or memory mutation.
use compiler.common.cache.reverse_reference_facts.*
use std.nogc_sync_mut.sffi.transient.{transient_scope_begin, transient_scope_pause,
    transient_scope_end}

fn main():
    assert(reverse_reference_owner_begin_v1())
    assert(transient_scope_begin())
    val token = reverse_reference_module_begin_v1()
    assert(token > 0)
    reverse_reference_owner_register_v1("family", "subject", "consumer", "evidence")
    reverse_reference_owner_register_source_alias_v1("identity", "source")
    assert(not reverse_reference_module_seal_v1(token))
    assert(not reverse_reference_module_publish_v1(token))
    assert(transient_scope_pause())
    assert(reverse_reference_module_abort_v1(token))
    assert(transient_scope_end())
    val snapshot = reverse_reference_owner_snapshot_v1()
    assert(snapshot.facts.len() == 0)
    assert(snapshot.known_families.len() == 0)
    assert(reverse_reference_owner_source_aliases_v1("identity").len() == 0)
    reverse_reference_owner_end_v1()
    print "PASS: reverse-reference failed seal abort"
