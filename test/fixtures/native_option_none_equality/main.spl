fn p_ret_explicit(hit: bool):
    val o: F? = ret_explicit(hit)
    val m = match o:
        case Some(f): "some{f.id}"
        case None: "none"
    var iv = "none"
    if val f = o:
        iv = "some{f.id}"
    val q = if o.?: "y" else: "n"
    val c = (o ?? F(id: -9, name: "d")).id
    print "ret_explicit eq={o == None} ne={o != None} req={None == o} rne={None != o} nil={o == nil} match={m} ifval={iv} q={q} coalesce={c}"

fn p_ret_tail(hit: bool):
    val o: F? = ret_tail(hit)
    val m = match o:
        case Some(f): "some{f.id}"
        case None: "none"
    var iv = "none"
    if val f = o:
        iv = "some{f.id}"
    val q = if o.?: "y" else: "n"
    val c = (o ?? F(id: -9, name: "d")).id
