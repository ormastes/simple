fn p_array_first(hit: bool):
    var xs: [F] = []
    if hit:
        xs.push(mk(7))
    val o: F? = xs.first()
    val m = match o:
        case Some(f): "some{f.id}"
        case None: "none"
    var iv = "none"
    if val f = o:
        iv = "some{f.id}"
    val q = if o.?: "y" else: "n"
    val c = (o ?? F(id: -9, name: "d")).id
    print "array_first eq={o == None} ne={o != None} req={None == o} rne={None != o} nil={o == nil} match={m} ifval={iv} q={q} coalesce={c}"

fn p_field_default(hit: bool):
    var s = Slot(id: 1)
    if hit:
        s.pick = Some(mk(9))
    val o: F? = s.pick
    val m = match o:
        case Some(f): "some{f.id}"
        case None: "none"
    var iv = "none"
    if val f = o:
        iv = "some{f.id}"
    val q = if o.?: "y" else: "n"
    val c = (o ?? F(id: -9, name: "d")).id
    print "field_default eq={o == None} ne={o != None} req={None == o} rne={None != o} nil={o == nil} match={m} ifval={iv} q={q} coalesce={c}"

fn p_nil_into_opt(hit: bool):
    val o: F? = if hit: Some(mk(10)) else: nil
    val m = match o:
        case Some(f): "some{f.id}"
        case None: "none"
    var iv = "none"
    if val f = o:
        iv = "some{f.id}"
    val q = if o.?: "y" else: "n"
