fn p_safe_nav(hit: bool):
    val h: Holder? = if hit: Some(Holder(inner: Some(mk(11)))) else: None
    val o: F? = h?.inner
    val m = match o:
        case Some(f): "some{f.id}"
        case None: "none"
    var iv = "none"
    if val f = o:
        iv = "some{f.id}"
    val q = if o.?: "y" else: "n"
    val c = (o ?? F(id: -9, name: "d")).id
    print "safe_nav eq={o == None} ne={o != None} req={None == o} rne={None != o} nil={o == nil} match={m} ifval={iv} q={q} coalesce={c}"

fn p_coalesce_opt(hit: bool):
    val a: F? = None
    val b: F? = if hit: Some(mk(12)) else: None
    val o: F? = a ?? b
    val m = match o:
        case Some(f): "some{f.id}"
        case None: "none"
    var iv = "none"
    if val f = o:
        iv = "some{f.id}"
    val q = if o.?: "y" else: "n"
    val c = (o ?? F(id: -9, name: "d")).id
    print "coalesce_opt eq={o == None} ne={o != None} req={None == o} rne={None != o} nil={o == nil} match={m} ifval={iv} q={q} coalesce={c}"

fn p_generic(hit: bool):
    val o: F? = gen_opt(hit, mk(13))
    val m = match o:
        case Some(f): "some{f.id}"
        case None: "none"
    var iv = "none"
    if val f = o:
        iv = "some{f.id}"
    val q = if o.?: "y" else: "n"
    val c = (o ?? F(id: -9, name: "d")).id
    print "generic eq={o == None} ne={o != None} req={None == o} rne={None != o} nil={o == nil} match={m} ifval={iv} q={q} coalesce={c}"

fn p_trait(hit: bool):
    val o: F? = via_trait(Box1(tag: 14), hit)
    val m = match o:
        case Some(f): "some{f.id}"
        case None: "none"
    var iv = "none"
    if val f = o:
        iv = "some{f.id}"
    val q = if o.?: "y" else: "n"
    val c = (o ?? F(id: -9, name: "d")).id
    print "trait eq={o == None} ne={o != None} req={None == o} rne={None != o} nil={o == nil} match={m} ifval={iv} q={q} coalesce={c}"

fn q_i64_literal_none(hit: bool, v: i64):
    val o: i64? = if hit: Some(v) else: None
    val m = match o:
        case Some(x): "some{x}"
        case None: "none"
    val q = if o.?: "y" else: "n"
    val c = o ?? -9
    print "i64_literal_none eq={o == None} ne={o != None} req={None == o} rne={None != o} nil={o == nil} match={m} q={q} coalesce={c}"

fn q_i64_ret(hit: bool, v: i64):
    val o: i64? = i_ret(hit, v)
    val m = match o:
        case Some(x): "some{x}"
        case None: "none"
    val q = if o.?: "y" else: "n"
    val c = o ?? -9
    print "i64_ret eq={o == None} ne={o != None} req={None == o} rne={None != o} nil={o == nil} match={m} q={q} coalesce={c}"

fn q_i64_dict_get(hit: bool, v: i64):
    var d: Dict<text, i64> = {}
    d["a"] = v
    val k = if hit: "a" else: "zz"
    val o: i64? = d.get(k)
    val m = match o:
        case Some(x): "some{x}"
        case None: "none"
    val q = if o.?: "y" else: "n"
    val c = o ?? -9
    print "i64_dict_get eq={o == None} ne={o != None} req={None == o} rne={None != o} nil={o == nil} match={m} q={q} coalesce={c}"

fn q_i64_nil_into_opt(hit: bool, v: i64):
    val o: i64? = if hit: Some(v) else: nil
    val m = match o:
        case Some(x): "some{x}"
        case None: "none"
    val q = if o.?: "y" else: "n"
    val c = o ?? -9
    print "i64_nil_into_opt eq={o == None} ne={o != None} req={None == o} rne={None != o} nil={o == nil} match={m} q={q} coalesce={c}"

fn erased_sites(hit: bool):
    var d: Dict<text, F> = {}
    d["a"] = mk(20)
    val k = if hit: "a" else: "zz"
    var s = Slot(id: 2)
    if hit:
        s.pick = Some(mk(21))
    val g: F? = d[k]
    print "erased field={s.pick == None} param={is_none_param(g)} generic={is_none_generic(g)}"

fn run_all(hit: bool):
    p_dict_index(hit)
    p_dict_get(hit)
    p_literal_none(hit)
    p_option_none(hit)
    p_ret_explicit(hit)
    p_ret_tail(hit)
    p_array_first(hit)
    p_field_default(hit)
    p_nil_into_opt(hit)
    p_safe_nav(hit)
    p_coalesce_opt(hit)
    p_generic(hit)
    p_trait(hit)
    q_i64_literal_none(hit, 0)
    q_i64_literal_none(hit, 42)
    q_i64_ret(hit, 0)
    q_i64_ret(hit, 42)
    q_i64_dict_get(hit, 0)
    q_i64_dict_get(hit, 42)
    q_i64_nil_into_opt(hit, 0)
    q_i64_nil_into_opt(hit, 42)
    erased_sites(hit)

fn main():
    run_all(false)
    run_all(true)
