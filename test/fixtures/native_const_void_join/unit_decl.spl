# parser_lower_unit_decl bisect (bug native_const_type_void_unit_tail_if_join_2026-11-13).

var PENDING_ATTRS: [text] = []
var PENDING_FLAG: i64 = 0
var PENDING_REASON: text = ""
var DECLS: [i64] = []

fn ntr(name: text, field_names: [text], field_types: [i64]) -> i64:
    field_names.len() + field_types.len() + name.len()

fn cpr(name: text, tag: i64) -> i64:
    name.len() + tag

fn nur(name: text, suffix: text, tag: i64) -> i64:
    name.len() + suffix.len() + tag

fn udro(name: text, role: text, short_symbol: text, tag: i64, alias_of: text, legacy: text) -> i64:
    name.len() + role.len() + short_symbol.len() + tag + alias_of.len() + legacy.len()

fn dsd(name: text, field_names: [text], field_types: [i64], field_defaults: [i64], field_bits: [i64], span_id: i64) -> i64:
    name.len() + field_names.len() + field_types.len() + field_defaults.len() + field_bits.len() + span_id

fn mad(decl_idx: i64):
    DECLS.push(decl_idx)

fn rst():
    PENDING_ATTRS = []
    PENDING_FLAG = 0
    PENDING_REASON = ""

# P1: exact shape.
pub fn p1_exact(name: text, inner_type: i64, suffix: text, legacy_origin: text):
    ntr(name, ["value"], [inner_type])
    cpr(name, inner_type)
    if legacy_origin == "newunit":
        nur(name, suffix, inner_type)
    else:
        udro(name, "nominal", suffix, inner_type, "", legacy_origin)
    val field_names: [text] = ["value"]
    val field_types: [i64] = [inner_type]
    val field_defaults: [i64] = [-1]
    val field_bits: [i64] = [-1]
    val d = dsd(name, field_names, field_types, field_defaults, field_bits, 0)
    mad(d)
    rst()

# P2: P1 without the if/else.
pub fn p2_no_if(name: text, inner_type: i64, suffix: text, legacy_origin: text):
    ntr(name, ["value"], [inner_type])
    cpr(name, inner_type)
    val field_names: [text] = ["value"]
    val field_types: [i64] = [inner_type]
    val field_defaults: [i64] = [-1]
    val field_bits: [i64] = [-1]
    val d = dsd(name, field_names, field_types, field_defaults, field_bits, 0)
    mad(d)
    rst()

# P3: only the array literals + decl.
pub fn p3_arrays(name: text, inner_type: i64):
    val field_names: [text] = ["value"]
    val field_types: [i64] = [inner_type]
    val field_defaults: [i64] = [-1]
    val field_bits: [i64] = [-1]
    val d = dsd(name, field_names, field_types, field_defaults, field_bits, 0)
    mad(d)

# P4: only the leading discarded i64 calls with array-literal args.
pub fn p4_lead(name: text, inner_type: i64):
    ntr(name, ["value"], [inner_type])
    cpr(name, inner_type)
    rst()

# P5: P1 with the workaround binding + explicit unit tail.
pub fn p5_typed_tail(name: text, inner_type: i64, suffix: text, legacy_origin: text):
    ntr(name, ["value"], [inner_type])
    cpr(name, inner_type)
    val registered: i64 = if legacy_origin == "newunit":
        nur(name, suffix, inner_type)
    else:
        udro(name, "nominal", suffix, inner_type, "", legacy_origin)
    val field_names: [text] = ["value"]
    val field_types: [i64] = [inner_type]
    val field_defaults: [i64] = [-1]
    val field_bits: [i64] = [-1]
    val d = dsd(name, field_names, field_types, field_defaults, field_bits, 0)
    mad(d)
    rst()
    ()

# P6: -1 literal arrays only.
pub fn p6_neg(name: text):
    val field_defaults: [i64] = [-1]
    mad(field_defaults.len() + name.len())
