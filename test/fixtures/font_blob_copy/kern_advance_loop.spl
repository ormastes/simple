# Fixture for test/01_unit/lib/nogc_sync_mut/text_layout/font_blob_no_copy_jit_spec.spl.
# Loads one bundled face (1.7 MB blob) and times N kern + advance queries.
# Under the JIT `val blob = self.selected_outline_blob` lowers to
# rt_array_copy, so every query used to copy the whole font file.
use std.nogc_sync_mut.text_layout.font_renderer.{FontRenderer}
extern fn rt_time_now_unix_micros() -> i64

fn main():
    var r = FontRenderer.new()
    val ok = r.try_load_runtime_ttf("assets/fonts/google-fonts/ofl/notosansmono/NotoSansMono[wdth,wght].ttf")
    val blob_len = r.selected_outline_blob.len()
    # Warm the per-face glyph-id / advance tables outside the timed loop.
    var acc = r.horizontal_kern_milli(65, 86, 16) + r.get_glyph_advance_milli(65, 16)
    val n = 500
    val t0 = rt_time_now_unix_micros()
    var i = 0
    while i < n:
        acc = acc + r.horizontal_kern_milli(65, 86, 16)
        acc = acc + r.get_glyph_advance_milli(65, 16)
        i = i + 1
    val t1 = rt_time_now_unix_micros()
    print "loaded={ok} blob_len={blob_len} queries={n * 2} loop_us={t1 - t0} acc={acc}"
