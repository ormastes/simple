use std.nogc_async_mut.sosix.host_facade.{sosix_print_raw as print_raw}
use std.nogc_async_mut.io.{file_read_text_at, file_write_text_at}

fn main() -> i64:
    # Missing files must preserve the canonical typed I/O error result.
    val read_result: Result<text, text> = file_read_text_at("/nonexistent-simple-cs-alias-fixture/file", 0, 1)
    if read_result.is_ok(): return 1
    val written: i64 = file_write_text_at("/nonexistent-simple-cs-alias-fixture/file", 0, "x")
    if written >= 0: return 2
    val emitted = print_raw("caret-cs-host-alias-ok\n")
    if emitted < 0: return 3
    0
