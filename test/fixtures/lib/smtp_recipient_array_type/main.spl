use std.nogc_sync_mut.smtp.send.{email_list_to_recipients as sync_recipients}
use std.nogc_async_mut.smtp.send.{email_list_to_recipients as async_recipients}
use std.gc_async_mut.smtp.send.{email_list_to_recipients as gc_recipients}

use std.nogc_sync_mut.smtp.send.{message_build_simple as sync_message}
use std.nogc_async_mut.smtp.send.{message_build_simple as async_message}
use std.gc_async_mut.smtp.send.{message_build_simple as gc_message}
use std.nogc_sync_mut.smtp.utilities.{qp_encode_char}

fn check_recipients(values: [text]) -> bool:
    values.len() == 2 and values[0] == "alice@example.test" and values[1] == "bob@example.test"

fn main() -> i64:
    val input = " alice@example.test , , bob@example.test "
    if not check_recipients(sync_recipients(input)): return 1
    if not check_recipients(async_recipients(input)): return 2
    if not check_recipients(gc_recipients(input)): return 3
    val empty: [text] = sync_recipients(" , , ")
    if empty.len() != 0: return 4
    val expected = "From: alice@example.test\r\nTo: bob@example.test\r\nSubject: Hi\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nBody\r\n"
    if sync_message("alice@example.test", "bob@example.test", "Hi", "Body") != expected: return 5
    if async_message("alice@example.test", "bob@example.test", "Hi", "Body") != expected: return 6
    if gc_message("alice@example.test", "bob@example.test", "Hi", "Body") != expected: return 7
    if qp_encode_char("=") != "=3D": return 8
    if qp_encode_char("\t") != "=09": return 9
    print("smtp-recipient-arrays-ok")
    0
