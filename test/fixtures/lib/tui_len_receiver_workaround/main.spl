use std.nogc_sync_mut.tui.style.{tui_default_style}
use std.nogc_sync_mut.tui.widgets.input.{make_input_widget_with_value, input_insert_char, input_delete_back, input_move_end}

fn main() -> i64:
    val empty = make_input_widget_with_value("", "", tui_default_style())
    if input_insert_char(empty, "x").value != "x": return 1
    val unicode = make_input_widget_with_value("p", "é🙂", tui_default_style())
    val end = input_move_end(unicode)
    if end.cursor_pos != 2: return 2
    val deleted = input_delete_back(end)
    if deleted.value != "é": return 3
    if deleted.cursor_pos != 1: return 4
    val appended = input_insert_char(deleted, "界")
    if appended.value != "é界": return 5
    if appended.cursor_pos != 2: return 6
    print("tui-len-receiver-ok")
    0
