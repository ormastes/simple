use std.nogc_sync_mut.tls.utilities.{tls_sha256, sha256}

fn same_digest(values: [i64], expected: [i64]) -> bool:
    if values.len() != expected.len(): return false
    var index = 0
    while index < expected.len():
        if values[index] != expected[index]: return false
        index = index + 1
    true

fn main() -> i64:
    val input: [i64] = []
    val expected = [227, 176, 196, 66, 152, 252, 28, 20, 154, 251, 244, 200, 153, 111, 185, 36, 39, 174, 65, 228, 100, 155, 147, 76, 164, 149, 153, 27, 120, 82, 184, 85]
    if not same_digest(tls_sha256(input), expected): return 1
    if not same_digest(sha256(input), expected): return 2
    print("tls-canonical-sha256-alias-ok")
    0
