# Fixture: calls text builtins without importing util.bytes.

pub fn typed_len(s: text) -> i64:
    s.byte_len()

pub fn loop_len(s: text) -> i64:
    val parts = s.split(" ")
    var n = 0
    for p in parts:
        n = n + p.byte_len()
    n

pub fn untyped_len(x) -> i64:
    x.byte_len()

pub fn untyped_count(x) -> i64:
    x.char_count()
