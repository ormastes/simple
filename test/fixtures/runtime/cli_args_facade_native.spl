# Compile this fixture with the candidate compiler and run the resulting binary:
#   <binary> alpha "two words" "" --literal
# Expected: argv-facade-native-ok, exit 0. A changed suffix must exit 22.
# The caller must impose a process-tree deadline; recursion cannot self-report.
use app.io.cli_ops.{get_args}

fn main() -> i64:
    var repetition = 0
    while repetition < 64:
        val args = get_args()
        if args.len() != 5:
            return 21
        val offset = args.len() - 4
        if args[offset] != "alpha" or args[offset + 1] != "two words":
            return 22
        if args[offset + 2] != "" or args[offset + 3] != "--literal":
            return 22
        repetition = repetition + 1
    print "argv-facade-native-ok"
    0
