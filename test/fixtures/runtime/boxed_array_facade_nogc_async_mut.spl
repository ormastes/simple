use std.nogc_async_mut.sffi.runtime.array_value_is_boxed_array

fn main() -> i64:
    val empty: [any] = []
    val values: [any] = [1, "two", nil]
    if not array_value_is_boxed_array(empty):
        return 1
    if not array_value_is_boxed_array(values):
        return 2
    if array_value_is_boxed_array((1, 2)):
        return 3
    if array_value_is_boxed_array(9) or array_value_is_boxed_array(nil):
        return 4
    print "BOXED_ARRAY_FACADE_NOGC_ASYNC_MUT_PASS"
    0
