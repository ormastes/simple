# Windows bootstrap regression for checked SOSIX environment/cwd admission.
use std.nogc_async_mut.sosix.environment.{sosix_env_get_checked, sosix_env_set_checked,
    sosix_env_remove_checked, sosix_cwd_checked}

fn main() -> i64:
    val key = "SIMPLE_UTF8_환경_é"
    if sosix_env_remove_checked(key).is_err(): return 1
    val absent = sosix_env_get_checked(key)
    if absent.is_err() or absent.unwrap() != nil: return 2
    if sosix_env_set_checked(key, "").is_err(): return 3
    val empty = sosix_env_get_checked(key)
    if empty.is_err() or empty.unwrap() == nil: return 4
    if empty.unwrap()! != "": return 5
    if sosix_env_set_checked(key, "값-é-😀").is_err(): return 6
    val unicode = sosix_env_get_checked(key)
    if unicode.is_err() or unicode.unwrap() == nil: return 7
    if unicode.unwrap()! != "값-é-😀": return 8
    if sosix_env_remove_checked(key).is_err(): return 9
    val removed = sosix_env_get_checked(key)
    if removed.is_err() or removed.unwrap() != nil: return 10
    if sosix_env_set_checked("bad=key", "x").is_ok(): return 11
    if sosix_env_set_checked("bad\0key", "x").is_ok(): return 12
    val cwd = sosix_cwd_checked()
    if cwd.is_err(): return 13
    if not cwd.unwrap().contains("환경-é"): return 14
    val shard = sosix_env_get_checked("SIMPLE_HIR_SHARD")
    if shard.is_err() or shard.unwrap() == nil: return 15
    if shard.unwrap()! != "0/1": return 16
    print "PASS Windows SOSIX UTF-8 environment/cwd: 16 checks"
    0