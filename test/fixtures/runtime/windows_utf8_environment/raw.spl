# Direct C-provider regression; no library closure or interpreter dispatch.
extern fn rt_env_get(key: text) -> text?
extern fn rt_env_set(key: text, value: text) -> bool
extern fn rt_env_remove(key: text) -> bool
extern fn rt_env_cwd() -> text?

fn main() -> i64:
    val key = "SIMPLE_RAW_UTF8_환경_é"
    if not rt_env_remove(key): return 1
    if rt_env_get(key) != nil: return 2
    if not rt_env_set(key, ""): return 3
    val empty = rt_env_get(key)
    if empty == nil: return 4
    if empty! != "": return 5
    if not rt_env_set(key, "값-é-😀"): return 6
    val value = rt_env_get(key)
    if value == nil: return 7
    if value! != "값-é-😀": return 8
    if not rt_env_remove(key): return 9
    if rt_env_get(key) != nil: return 10
    val cwd = rt_env_cwd()
    if cwd == nil: return 11
    if not cwd!.contains("환경-é"): return 12
    print "PASS raw C Windows UTF-8 environment/cwd: 12 checks"
    0