# Bootstrap-only producer witness: zero-argument C entrypoints call the exact
# new native ABI; the real Simple decoder and PATH resolver execute here.
# Full text-argument facade qualification requires a freshly registered seed.
use std.nogc_async_mut.sosix.host_facade.{sosix_decode_process_bytes, sosix_which_checked}
use std.nogc_sync_mut.io.external_text_io.{TextIoError}
extern fn process_bytes_malformed_fixture() -> ([u8], [u8], i64)
extern fn process_bytes_unicode_fixture() -> ([u8], [u8], i64)

fn main() -> i64:
    match sosix_decode_process_bytes(process_bytes_unicode_fixture()):
        case Err(_): return 1
        case Ok(result):
            if result.stdout != "한글 😀" or result.stderr != result.stdout: return 2
            if result.exit_code != 7: return 3
    match sosix_decode_process_bytes(process_bytes_malformed_fixture()):
        case Ok(_): return 4
        case Err(error):
            match error:
                case TextIoError.Codec(_): ()
                case _: return 5
    match sosix_which_checked("child"):
        case Err(_): return 6
        case Ok(found):
            if found == nil: return 7
    print "PASS native Simple strict byte decoder and Windows PATH resolver"
    0
