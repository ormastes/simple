use std.nogc_async_mut.sosix.host_facade.{sosix_run_bounded_checked, sosix_which_checked}
use std.nogc_sync_mut.io.external_text_io.{TextIoError}
use std.nogc_sync_mut.io_runtime.{env_get}

fn main() -> i64:
    val child = env_get("SIMPLE_PROCESS_BYTES_CHILD") ?? ""
    if child == "": return 1
    val programs: [text] = [child, child.replace("/", "\\"), "child"]
    for program in programs:
        match sosix_run_bounded_checked(program, ["echo", "한글 😀 quoted \"argument\" \\"], 3000, 4096):
            case Err(_): return 2
            case Ok(result):
                if result.exit_code != 7: return 3
                if result.stdout != "한글 😀 quoted \"argument\" \\" or result.stderr != result.stdout: return 4
    match sosix_run_bounded_checked(child, ["malformed"], 3000, 4096):
        case Ok(_): return 5
        case Err(error):
            match error:
                case TextIoError.Codec(_): ()
                case _: return 6
    match sosix_which_checked("child"):
        case Err(_): return 7
        case Ok(found):
            if found == nil: return 8
    print "PASS Windows SOSIX strict process capture and PATH resolver"
    0
