# Windows bootstrap native ABI regression. No SSpec/interpreter fallback.
extern fn rt_shell_exec(command: text) -> text
extern fn rt_shell_exit_code() -> i64
extern fn rt_shell_exec_tuple(command: text) -> (text, text, i64)

fn main() -> i64:
    if rt_shell_exit_code() != 0: return 1
    val scalar = rt_shell_exec("echo scalar-out& echo scalar-error 1>&2& exit /b 7")
    if scalar.trim() != "scalar-out": return 2
    if rt_shell_exit_code() != 7: return 3
    val (stdout, stderr, code) = rt_shell_exec_tuple("echo tuple-out& echo tuple-error 1>&2& exit /b 3")
    if stdout.trim() != "tuple-out": return 4
    if stderr.trim() != "tuple-error": return 5
    if code != 3: return 6
    if rt_shell_exit_code() != 7: return 7
    val (quoted, quote_error, quote_code) = rt_shell_exec_tuple("echo \"two words\"")
    if quoted.trim() != "\"two words\"": return 8
    if quote_error != "": return 9
    if quote_code != 0: return 10
    if rt_shell_exit_code() != 7: return 11
    val ok = rt_shell_exec("echo scalar-ok& exit /b 0")
    if ok.trim() != "scalar-ok": return 12
    if rt_shell_exit_code() != 0: return 13
    print "PASS native shell provider: 13 checks"
    0
