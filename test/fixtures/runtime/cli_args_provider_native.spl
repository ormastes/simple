# Native backend/provider control for cli_args_facade_native.spl.
# Run with the same four suffix arguments. Expected exit 0; bad suffix exits 22.
extern fn sys_get_args() -> [text]

fn main() -> i64:
    var repetition = 0
    while repetition < 64:
        val args = sys_get_args()
        if args.len() != 5:
            return 21
        val offset = args.len() - 4
        if args[offset] != "alpha" or args[offset + 1] != "two words":
            return 22
        if args[offset + 2] != "" or args[offset + 3] != "--literal":
            return 22
        repetition = repetition + 1
    print "argv-provider-native-ok"
    0
