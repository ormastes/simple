use compiler.tools.lint.main.{
    collect_easy_fixes, lint_accessor_and_parent_names,
    os_freestanding_lint_in_scope
}

fn main() -> i64:
    val warnings = lint_accessor_and_parent_names(
        "fixture.spl",
        "class Box:\n    fn get_name(self):\n        self.name\n"
    )
    val fixes = collect_easy_fixes([], false)
    val os_scope = os_freestanding_lint_in_scope("src/os/native_probe.spl")
    var accessor_count = 0
    for warning in warnings:
        if warning.code == "ACC001":
            accessor_count = accessor_count + 1
    val passed = accessor_count == 1 and fixes.len() == 0 and os_scope
    print("lint remaining modules resolved: {passed}")
    if passed: 0 else: 1
