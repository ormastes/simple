use nogc_sync_mut.daemon_sdk.lock.{is_pid_alive}
use std.nogc_sync_mut.io.process_ops.{process_spawn_async, process_kill}

fn main() -> i64:
    val pid = process_spawn_async("/bin/sh", ["-c", "sleep 5"])
    val passed = pid > 0 and is_pid_alive(pid)
    if pid > 0:
        process_kill(pid)
    print("daemon lock process liveness facade resolved: {passed}")
    if passed: 0 else: 1
