# Env file for test/03_system/app/container/feature/podman_shared_api_live_spec.spl.
# The guest wrapper installs it at /etc/simple/podman-live-spec.env (or points
# SIMPLE_PODMAN_LIVE_ENV_FILE at it). KEY=VALUE lines; process env wins.
# Opt-in for live podman effects (no default).
SIMPLE_PODMAN_SMOKE=1
# Registry-qualified, digest-pinned image. Leave unset to use the RepoDigest of
# a registry-pulled local busybox:1.36.
# SIMPLE_PODMAN_LIVE_IMAGE=docker.io/library/busybox@sha256:<64 hex>
# Written by test/fixtures/container/podman_live_launch_template_gen.spl.
SIMPLE_PODMAN_LIVE_TEMPLATE=/etc/simple/podman-live-launch-template.sdn
# Per-run workspace roots. Must lie beneath the installed fresh-epoch profile's
# workloadBuildRootPrefix (the guest wrapper provisions this directory and key).
SIMPLE_PODMAN_LIVE_WORK_ROOT=/var/lib/simple-host/live-work
