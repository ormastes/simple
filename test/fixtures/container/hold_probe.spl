# Long-lived child for the hold_running pure-container spec: prints a marker, then idles until the
# owner's job object terminates it (stop/destroy). The 120 s bound only keeps a leaked run finite.
use std.nogc_sync_mut.io_runtime.{thread_sleep}

fn main():
    print("HOLD-STARTED")
    var waited = 0
    while waited < 120000:
        thread_sleep(250)
        waited = waited + 250

main()
