# Test-only wrapper for an ACTUAL scripted leaf owner supplied by its tests.
# Never a production fallback or native process/Podman qualification oracle.
use std.common.contracts.container.execution_v2.{ContainerHostScopeV2, container_scope_fence_id_v2}
use std.nogc_async_mut.container.api_v2.SimpleContainerOwnerV2
use std.nogc_async_mut.container.providers.linux.simple_container_adapter_v2.LinuxSimpleContainerAdapterV2

pub fn simple_container_scripted_linux_fixture_v2(scope: ContainerHostScopeV2,
        adapter: LinuxSimpleContainerAdapterV2) -> SimpleContainerOwnerV2:
    assert(adapter.is_scripted_fixture_v2())
    assert(container_scope_fence_id_v2(scope).is_ok())
    SimpleContainerOwnerV2.Linux(scope, adapter)
