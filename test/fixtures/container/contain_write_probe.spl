# Contained-launch fixture: tries to write one path and prints the outcome.
# Usage: simple run contain_write_probe.spl args: <path> [<exit-code>]
# Prints "WRITE allow" only when the write returned true and the file exists, then
# exits with <exit-code> (default 0) so a caller can check exit-code transport.
use std.nogc_sync_mut.io_runtime.{get_args, file_write, file_exists, exit}

fn write_probe_parse(value: text) -> i64:
    var total = 0
    var index = 0
    while index < value.byte_len():
        val digit = value.char_code_at(index) - 48
        if digit < 0 or digit > 9: return 0
        total = total * 10 + digit
        index = index + 1
    total

fn main():
    val args = get_args()
    var path = ""
    var code = 0
    var index = 0
    while index < args.len():
        if args[index] == "args:" and index + 1 < args.len():
            path = args[index + 1]
            if index + 2 < args.len(): code = write_probe_parse(args[index + 2])
        index = index + 1
    if path == "":
        print("WRITE-ERROR usage")
        exit(2)
        return
    val wrote = file_write(path, "contain-write-probe")
    print("WRITE " + (if wrote and file_exists(path): "allow" else: "deny"))
    if code > 0: exit(code)

main()
