# Allocation workload for the Windows job-memory-cap probe. Usage:
#   simple run alloc_mb.spl <N>   (N MiB; 0 = idle, allocate nothing)
# Allocates N chunks, keeps them live, and prints ALLOC_OK. A host or
# runtime allocation failure normally aborts the process (nonzero exit) before
# the marker is printed; ALLOC_DENIED is printed only if the failure is caught.
use std.nogc_sync_mut.io_runtime.{get_args}

fn alloc_mb_parse(text_value: text) -> i64:
    var total = 0
    var index = 0
    while index < text_value.byte_len():
        val digit = text_value.char_code_at(index) - 48
        if digit < 0 or digit > 9: return -1
        total = total * 10 + digit
        index = index + 1
    total

fn alloc_mb_main():
    val args = get_args()
    var requested = 0
    var found = false
    for arg in args:
        val parsed = alloc_mb_parse(arg)
        if parsed >= 0 and arg.byte_len() > 0:
            requested = parsed
            found = true
    if not found:
        print("ALLOC_DENIED no-size")
        return
    # Chunk size is ~(digits(index)+1) * 256 KiB (512 KiB for index 0-9, 768 KiB for
    # 10-99, 1 MiB from 100); measured peaks in the spec depend on this exact size.
    var chunks: [text] = []
    var made = 0
    while made < requested:
        chunks = chunks.push(("x" + made.to_string()).repeat(1048576 / 4))
        made = made + 1
    print("ALLOC_OK " + chunks.len().to_string())

alloc_mb_main()
