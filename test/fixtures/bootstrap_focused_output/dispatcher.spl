# Actual focused owner; this fixture does not replace the compiler or linker.
use std.nogc_sync_mut.sffi.cli_args.{cli_get_args}
use app.cli.bootstrap_focused_native_build.{run_focused_native_build}
use app.io.native_build_output_mode.{native_build_output_mode_snapshot}

fn main() -> i64:
    val before = native_build_output_mode_snapshot()
    val result = run_focused_native_build(cli_get_args())
    val after = native_build_output_mode_snapshot()
    if before != after:
        print "FAIL: focused output mode escaped the call"
        return 2
    return result
