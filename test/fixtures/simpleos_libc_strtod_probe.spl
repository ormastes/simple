use os.libc.simpleos_stdlib_float.libc_strtod

fn main():
    var i = 0
    var checksum: f64 = 0.0
    while i < 10000:
        checksum = checksum + libc_strtod("-1.25e2".bytes()).value
        i = i + 1
    val tiny = libc_strtod("1e-999999999999".bytes())
    if checksum == -1250000.0 and tiny.value == 0.0:
        print "PASS"
    else:
        print "FAIL"
