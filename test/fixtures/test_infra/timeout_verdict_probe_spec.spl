# Fixture: a spec that deliberately exceeds any small `--timeout` budget.
#
# Real trigger for the timeout-verdict fix (bug:
# killed_spec_emits_no_verdict_line_2026-08-09). Run it with a low budget and
# the runner must print a `SPEC FILE VERDICT: ... timeout=1` line instead of
# dying silently with "Process timed out" and no verdict:
#
#   bin/simple run src/app/test_runner_new/test_runner_single.spl \
#       test/fixtures/test_infra/timeout_verdict_probe_spec.spl \
#       --no-session-daemon --timeout 5
#
# It is a fixture, not a suite member: it can never pass, by construction.

use std.spec.step

extern fn rt_sleep_ms(ms: i64)

fn main() -> i64:
    describe("timeout verdict probe"):
        it("sleeps past any small budget"):
        # @req REQ-SSPEC-FIXTURES
    # @req REQ-SSPEC-FIXTURES
            rt_sleep_ms(600000)
            assert_true(true)
    0
