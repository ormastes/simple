"""
## Purpose and audience

This specification is maintained for compiler and library engineers reviewing FIXTURES-TEST_INFRA behavior, and for operators verifying a build.

## Operator workflow

Run `bin/simple test --no-session-daemon test/fixtures/test_infra/timeout_verdict_probe_spec.spl` and confirm the Results line reports 0 failed. Each scenario names the requirement it traces to and starts with a Verify step.

## Compatibility and limitations

Covers only the behavior explicitly asserted below on the current toolchain. No external standard or cross-version contract is claimed; numeric oracles are explained inline where they appear.

## Recovery and troubleshooting

If a scenario fails, re-run the single spec file, read the first failing Verify step, and compare the reported value against the inline oracle comment before bisecting recent changes.
"""
use std.spec.{step}
# @manual: primary
# REQ-FIXTURES-TEST_INFRA-001
# doc-path: doc/01_research/app/
# doc-path: doc/03_plan/app/
# doc-path: doc/04_architecture/app/
# doc-path: doc/05_design/app/
# Fixture: a spec that deliberately exceeds any small `--timeout` budget.
#
# Real trigger for the timeout-verdict fix (bug:
# killed_spec_emits_no_verdict_line_2026-08-09). Run it with a low budget and
# the runner must print a `SPEC FILE VERDICT: ... timeout=1` line instead of
# dying silently with "Process timed out" and no verdict:
#
#   bin/simple run src/app/test_runner_new/test_runner_single.spl \
#       test/fixtures/test_infra/timeout_verdict_probe_spec.spl \
#       --no-session-daemon --timeout 5
#
# It is a fixture, not a suite member: it can never pass, by construction.

extern fn rt_sleep_ms(ms: i64)

fn main() -> i64:
    describe("timeout verdict probe"):
        it("sleeps past any small budget"):
            # @req: REQ-FIXTURES-TEST_INFRA-001
            step("Verify: sleeps past any small budget")
            # @capture: assertion outcomes retained in the spec Results output as evidence
            rt_sleep_ms(600000)
            assert_true(true)
    0
