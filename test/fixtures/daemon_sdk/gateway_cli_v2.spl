# Shared bounded fixture-only argument and clock helpers.
use std.common.string_core.{str_len, string_char_code_at}
use std.nogc_sync_mut.io.time_ops.time_sample_monotonic_nanos_or_failure

pub fn gateway_fixture_uid_v2(source: text) -> i64:
    assert(str_len(source) > 0 and str_len(source) <= 10)
    var value = 0
    for index in 0..str_len(source):
        val digit = string_char_code_at(source, index) - 48
        assert(digit >= 0 and digit <= 9)
        value = value * 10 + digit
        assert(value <= 2147483647)
    value

pub fn gateway_fixture_now_v2() -> i64:
    val now = time_sample_monotonic_nanos_or_failure()
    assert(now >= 0)
    now / 1000000
