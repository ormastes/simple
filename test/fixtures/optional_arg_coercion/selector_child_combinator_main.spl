# Production consequence of
# doc/08_tracking/bug/interpreter_bare_arg_not_some_wrapped_at_optional_param_2026-08-04.md
#
# style_block_resolve.selector_matches matches a child combinator through
# `match parent: case Some(parent_node)`. Under the interpreter that arm never
# runs, control falls through to the descendant-combinator branch below, and a
# strict `a > b` degrades into descendant-like matching:
#
#   simple run ...                         -> parent_mismatch=false  (correct)
#   SIMPLE_EXECUTION_MODE=interpret ...    -> parent_mismatch=true   (wrong)
#
# The `case None` arm (no parent supplied) is correct on both engines.

use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode}
use std.gc_async_mut.gpu.browser_engine.style_block_resolve.{selector_matches}

fn el(tag: text) -> BeDomNode:
    BeDomNode.element_with_id(1, tag)

fn main() -> i64:
    val span = el("span")
    val div = el("div")
    print "parent_mismatch={selector_matches("p > span", span, div, 1, 1)}"
    print "parent_match={selector_matches("div > span", span, div, 1, 1)}"
    print "no_parent={selector_matches("div > span", span, nil, 1, 1)}"
    print "child_side_mismatch={selector_matches("div > span", div, div, 1, 1)}"
    0
