class HostFuture<T>:
    value: T

    static fn from_value(value: T) -> HostFuture<T>:
        HostFuture(value: value)

    fn then<U>(f: fn(T) -> HostFuture<U>) -> HostFuture<U>:
        f(self.value)

fn main() -> i64:
    val text_prefix = "seen:"
    val int_input: HostFuture<i64> = HostFuture.from_value(5)
    val text_output: HostFuture<text> = int_input.then(\value:
        if value == 5:
            HostFuture.from_value(text_prefix + "yes")
        else:
            HostFuture.from_value("wrong")
    )

    val float_input: HostFuture<f64> = HostFuture.from_value(3.5)
    val int_output: HostFuture<i64> = float_input.then(\value:
        if value > 2.0:
            HostFuture.from_value(7)
        else:
            HostFuture.from_value(0)
    )

    if text_output.value == "seen:yes" and int_output.value == 7:
        0
    else:
        1
