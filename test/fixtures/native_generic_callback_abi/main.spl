class HostFuture<T>:
    value: T

    static fn from_value(value: T) -> HostFuture<T>:
        HostFuture(value: value)

    fn then<U>(f: fn(T) -> HostFuture<U>) -> HostFuture<U>:
        f(self.value)

fn main() -> i64:
    val prefix: [u8] = [1]
    val payload: Result<[u8], i64> = Ok([2])
    val input: HostFuture<Result<[u8], i64>> = HostFuture.from_value(payload)
    val output: HostFuture<Result<[u8], i64>> = input.then(\result:
        match result:
            case Ok(bytes):
                HostFuture.from_value(Ok(prefix + bytes))
            case Err(error):
                HostFuture.from_value(Err(error))
    )
    match output.value:
        case Ok(bytes):
            if bytes.len() == 2 and bytes[0] == 1 and bytes[1] == 2:
                0
            else:
                1
        case Err(_): 2
