class HostFuture<T>:
    value: T

    static fn from_value(value: T) -> HostFuture<T>:
        HostFuture(value: value)

    fn then<U>(f: fn(T) -> HostFuture<U>) -> HostFuture<U>:
        f(self.value)

fn invalid(input: HostFuture<i64>) -> HostFuture<text>:
    input.then(\value:
        if value == 5:
            HostFuture.from_value(1.5)
        else:
            HostFuture.from_value(2.5)
    )

fn main() -> i64:
    val input: HostFuture<i64> = HostFuture.from_value(5)
    val result: HostFuture<text> = invalid(input)
    if result.value == "unexpected": 1 else: 0
