#!/bin/bash
# Pane child for CU-005: prints the hex of every byte it reads on stdin, one
# "HX:<hex>" line per byte. The hex is COMPUTED here (printf builtin, bytes
# read one at a time under LC_ALL=C), so the marker cannot be satisfied by the
# PTY echoing the sent bytes back.
export LC_ALL=C
stty raw -echo 2>/dev/null
echo "HX-READY"
while IFS= read -r -d '' -N1 c; do
    printf -v n '%d' "'$c"
    printf 'HX:%02x\n' $(( n & 255 ))
done
