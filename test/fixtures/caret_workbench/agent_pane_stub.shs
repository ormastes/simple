#!/bin/sh
# Stand-in agent CLI for the pane-backed (pane == agent) workbench oracle.
#
# Unlike agent_stub.shs (which only has to STAY ALIVE for the async-spawn
# lane), this stub is the child of an smux PANE: its stdin is the pane's input
# and its stdout is the pane's scrollback. It ignores the launch plan's argv
# (`-p <prompt> --output-format json`) exactly as the sleep stub does, then
# behaves like a line-oriented agent: read a line, answer it TRANSFORMED.
#
# The transform is what makes the oracle real -- an echo of the bytes the
# workbench sent cannot satisfy an assertion on "AGENT:<nonce>".
echo "AGENT:ready"
while IFS= read -r line; do
    echo "AGENT:$line"
done
