use app.io.minimal_runtime_ops.{get_args}
use app.check.main.{checker_begin_file_scope, checker_end_file_scope, checker_scope_owner_poisoned_v1, check_one_full, main as checker_main}

fn main() -> i64:
    val args = get_args()
    if args.len() != 3 or args[1] != "--json": return 10
    # A real invalid lifecycle operation: no file scope has been opened.
    if checker_end_file_scope(false): return 11
    if not checker_scope_owner_poisoned_v1(): return 12
    if checker_begin_file_scope(): return 13
    val counts: (i64, i64) = check_one_full(args[2], true, false, false, 1, 1)
    if counts.0 == 0: return 14
    # Invoke the actual command owner with its real argv, not a status surrogate.
    if checker_main() != 2: return 15
    print "native scope failure admission PASS"
    0
