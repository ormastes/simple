use std.spec.*
use os.compositor.simple_web_window_renderer.{simple_web_content_full_html_with_theme}

describe "quick":
    it "simple web full html includes wm root attrs":
        val html = simple_web_content_full_html_with_theme("aetheric_dark", "Aetheric", "<section></section>", 320, 200)
        expect(html).to_contain("<html data-wm-theme=\"aetheric_dark\"")
