use std.spec
use std.common.structural.transfer.transfer_contracts.{
    TransferEnvelopeV1,
    ParallelExecutionDomain,
    ParallelTransferMode,
    ParallelTransferPayload,
    transfer_envelope_v1
}
use std.common.structural.transfer.object_handle_capability_registry.{
    ObjectHandleCapabilityRegistryV1
}

fn immutable_envelope(region_id: i64, generation: i64, token: i64,
                     source: ParallelExecutionDomain,
                     target: ParallelExecutionDomain): TransferEnvelopeV1:
    transfer_envelope_v1(region_id, generation, source, target,
        ParallelTransferMode.FrozenShare, ParallelTransferPayload.ObjectHandle,
        token, false)

describe "owner-scoped ObjectHandle capability registry":
    it "mints nonzero opaque capabilities in a bounded table":
        var registry = ObjectHandleCapabilityRegistryV1.create(41, 1)
        val first = registry.mint(7, 2, ParallelExecutionDomain.Process)
        assert_true(first.ok)
        assert_equal(first.handle.ownership_token, 64)
        assert_equal(first.handle.owner_context, 41)
        assert_equal(registry.live_count(), 1)
        val full = registry.mint(8, 1, ParallelExecutionDomain.Process)
        assert_false(full.ok)
        assert_equal(registry.capacity(), 1)

    it "accepts a canonical process envelope once and rejects replay":
        var registry = ObjectHandleCapabilityRegistryV1.create(9, 2)
        val minted = registry.mint(10, 4, ParallelExecutionDomain.Process)
        val envelope = immutable_envelope(10, 4, minted.handle.ownership_token,
            ParallelExecutionDomain.Parent, ParallelExecutionDomain.Process)
        assert_true(registry.validate(envelope, 9))
        assert_false(registry.validate(envelope, 9))
        assert_equal(registry.live_count(), 0)

    it "rejects stale generation, wrong owner, and wrong target boundary":
        var registry = ObjectHandleCapabilityRegistryV1.create(12, 3)
        val minted = registry.mint(11, 3, ParallelExecutionDomain.Process)
        val stale = immutable_envelope(11, 4, minted.handle.ownership_token,
            ParallelExecutionDomain.Parent, ParallelExecutionDomain.Process)
        val valid = immutable_envelope(11, 3, minted.handle.ownership_token,
            ParallelExecutionDomain.Parent, ParallelExecutionDomain.Process)
        val wrong_target = immutable_envelope(11, 3, minted.handle.ownership_token,
            ParallelExecutionDomain.Parent, ParallelExecutionDomain.Thread)
        assert_false(registry.validate(stale, 12))
        assert_false(registry.validate(valid, 99))
        assert_false(registry.validate(wrong_target, 12))
        assert_true(registry.validate(valid, 12))

    it "revokes only with the owner context and rejects the revoked handle":
        var registry = ObjectHandleCapabilityRegistryV1.create(23, 1)
        val minted = registry.mint(14, 8, ParallelExecutionDomain.Remote)
        assert_false(registry.revoke(minted.handle, 24))
        assert_true(registry.revoke(minted.handle, 23))
        val envelope = immutable_envelope(14, 8, minted.handle.ownership_token,
            ParallelExecutionDomain.Parent, ParallelExecutionDomain.Remote)
        assert_false(registry.validate(envelope, 23))

    it "fails closed for invalid owner, region, and generation inputs":
        var registry = ObjectHandleCapabilityRegistryV1.create(0, 2)
        assert_false(registry.mint(1, 1, ParallelExecutionDomain.Process).ok)
        var owned = ObjectHandleCapabilityRegistryV1.create(31, 2)
        assert_false(owned.mint(0, 1, ParallelExecutionDomain.Process).ok)
        assert_false(owned.mint(1, 0, ParallelExecutionDomain.Process).ok)

    it "reuses a slot with a new generation and rejects the stale token":
        var registry = ObjectHandleCapabilityRegistryV1.create(51, 1)
        val first = registry.mint(21, 1, ParallelExecutionDomain.Process)
        assert_true(registry.revoke(first.handle, 51))
        val second = registry.mint(21, 1, ParallelExecutionDomain.Process)
        assert_equal(second.handle.ownership_token, 128)
        val stale = immutable_envelope(21, 1, first.handle.ownership_token,
            ParallelExecutionDomain.Parent, ParallelExecutionDomain.Process)
        val live = immutable_envelope(21, 1, second.handle.ownership_token,
            ParallelExecutionDomain.Parent, ParallelExecutionDomain.Process)
        assert_false(registry.validate(stale, 51))
        assert_true(registry.validate(live, 51))
