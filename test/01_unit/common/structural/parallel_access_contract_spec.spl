use std.spec
use std.common.structural.parallel_commit.access_contracts.{
    ParallelAccessMode,
    parallel_access_path_v1,
    parallel_access_paths_conflict,
    parallel_access_paths_overlap
}

describe "Parallel access paths":
    it "allows disjoint known ranges to execute independently":
        val left = parallel_access_path_v1(4, 0, 32, true, "range:0:32", ParallelAccessMode.Write)
        val right = parallel_access_path_v1(4, 32, 64, true, "range:32:64", ParallelAccessMode.Write)
        assert_false(parallel_access_paths_overlap(left, right))
        assert_false(parallel_access_paths_conflict(left, right))

    it "treats unknown access as overlapping even with a different projection name":
        val unknown = parallel_access_path_v1(4, 0, 0, false, "field:velocity", ParallelAccessMode.Write)
        val known = parallel_access_path_v1(4, 32, 64, true, "field:color", ParallelAccessMode.Write)
        assert_true(parallel_access_paths_overlap(unknown, known))
        assert_true(parallel_access_paths_conflict(unknown, known))

    it "permits only two explicit reductions to overlap without a normal conflict":
        val left = parallel_access_path_v1(4, 0, 8, true, "whole", ParallelAccessMode.Reduce)
        val right = parallel_access_path_v1(4, 0, 8, true, "whole", ParallelAccessMode.Reduce)
        assert_false(parallel_access_paths_conflict(left, right))
