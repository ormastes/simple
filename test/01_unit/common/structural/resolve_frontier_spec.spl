"""
## Purpose and audience
Purpose: Prove that resolve frontier v1 reachability.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMMON-STRUCTURAL-001 — stable requirement identity for this spec.

# ============================================================================
# Resolve frontier v1 (LINK lane, Lane FRONTIER) — reachability and
# constraint-propagation CPU reference spec.
#
# Four claims:
#   1. REACHABILITY — worklist BFS marks exactly the nodes reachable from the
#      given roots, deterministically, and never re-marks a node twice.
#   2. TERMINATION — a cycle in the edge set does not loop forever; every
#      cycle member ends up marked.
#   3. BOUNDS DISCIPLINE — an edge indexing outside node_count is an explicit
#      `ok: false` rejection, never a trap and never a silent skip.
#   4. CONSTRAINT FIXPOINT — bitwise-OR propagation over a chain converges to
#      the expected merged values and reports a plausible iteration count.
# ============================================================================

use std.spec
use std.common.structural.resolve.resolve_frontier.{
    ResolveEdge,
    detect_cycles,
    propagate_constraints,
    reachable_mark
}

describe "resolve frontier v1 reachability":
    it "marks every node on a linear chain reached from the root":
        step("Verify: marks every node on a linear chain reached from the root")
        # @req: REQ-COMMON-STRUCTURAL-001
        val edges = [
            ResolveEdge(from_index: 0, to_index: 1),
            ResolveEdge(from_index: 1, to_index: 2),
            ResolveEdge(from_index: 2, to_index: 3)
        ]
        val out = reachable_mark(4, edges, [0])
        expect(out.ok).to_be(true)
        expect(out.values[0]).to_be(true)
        expect(out.values[1]).to_be(true)
        expect(out.values[2]).to_be(true)
        expect(out.values[3]).to_be(true)

    it "marks a diamond-reached node once, not twice, and still ok":
        step("Verify: marks a diamond-reached node once, not twice, and still ok")
        # 0 -> 1, 0 -> 2, 1 -> 3, 2 -> 3: node 3 is reachable via two paths.
        val edges = [
            ResolveEdge(from_index: 0, to_index: 1),
            ResolveEdge(from_index: 0, to_index: 2),
            ResolveEdge(from_index: 1, to_index: 3),
            ResolveEdge(from_index: 2, to_index: 3)
        ]
        val out = reachable_mark(4, edges, [0])
        expect(out.ok).to_be(true)
        expect(out.values.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(out.values[0]).to_be(true)
        expect(out.values[1]).to_be(true)
        expect(out.values[2]).to_be(true)
        expect(out.values[3]).to_be(true)

    it "leaves an unreached island node false":
        step("Verify: leaves an unreached island node false")
        val edges = [ResolveEdge(from_index: 0, to_index: 1)]
        val out = reachable_mark(3, edges, [0])
        expect(out.ok).to_be(true)
        expect(out.values[0]).to_be(true)
        expect(out.values[1]).to_be(true)
        expect(out.values[2]).to_be(false)

    it "terminates on a cycle and marks every cycle member":
        step("Verify: terminates on a cycle and marks every cycle member")
        val edges = [
            ResolveEdge(from_index: 0, to_index: 1),
            ResolveEdge(from_index: 1, to_index: 2),
            ResolveEdge(from_index: 2, to_index: 0)
        ]
        val out = reachable_mark(3, edges, [0])
        expect(out.ok).to_be(true)
        expect(out.values[0]).to_be(true)
        expect(out.values[1]).to_be(true)
        expect(out.values[2]).to_be(true)

    it "reaches nothing when roots is empty":
        step("Verify: reaches nothing when roots is empty")
        val edges = [ResolveEdge(from_index: 0, to_index: 1)]
        val out = reachable_mark(3, edges, [])
        expect(out.ok).to_be(true)
        expect(out.values[0]).to_be(false)
        expect(out.values[1]).to_be(false)
        expect(out.values[2]).to_be(false)

describe "resolve frontier v1 bounds discipline":
    it "rejects an edge whose to_index is out of bounds, never trapping":
        step("Verify: rejects an edge whose to_index is out of bounds, never trapping")
        val edges = [ResolveEdge(from_index: 0, to_index: 5)]
        val out = reachable_mark(2, edges, [0])
        expect(out.ok).to_be(false)

    it "rejects an edge whose from_index is out of bounds for propagation too":
        step("Verify: rejects an edge whose from_index is out of bounds for propagation too")
        val edges = [ResolveEdge(from_index: 9, to_index: 0)]
        val out = propagate_constraints(2, edges, [0, 0])
        expect(out.ok).to_be(false)

describe "resolve frontier v1 constraint propagation":
    it "converges a chain to the expected OR-merged values and reports iterations":
        step("Verify: converges a chain to the expected OR-merged values and reports iterations")
        # 0 -> 1 -> 2, seeding node 0 with bit 0b001; the bit should flow to
        # every downstream node once the fixpoint converges.
        val edges = [
            ResolveEdge(from_index: 0, to_index: 1),
            ResolveEdge(from_index: 1, to_index: 2)
        ]
        val out = propagate_constraints(3, edges, [1, 0, 0])
        expect(out.ok).to_be(true)
        expect(out.values[0]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(out.values[1]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(out.values[2]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(out.iterations).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(out.iterations).to_be_less_than(edges.len() + 2)

    it "OR-merges independent seed bits without clobbering either":
        step("Verify: OR-merges independent seed bits without clobbering either")
        # 0 -> 2, 1 -> 2: node 2 should see both seed bits merged.
        val edges = [
            ResolveEdge(from_index: 0, to_index: 2),
            ResolveEdge(from_index: 1, to_index: 2)
        ]
        val out = propagate_constraints(3, edges, [1, 2, 0])
        expect(out.ok).to_be(true)
        expect(out.values[0]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(out.values[1]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(out.values[2]).to_equal(3)  # oracle: 3 — named expected value from the requirement

describe "resolve frontier v1 cycle detection":
    it "reports no cycle on an acyclic chain":
        step("Verify: reports no cycle on an acyclic chain")
        val edges = [
            ResolveEdge(from_index: 0, to_index: 1),
            ResolveEdge(from_index: 1, to_index: 2)
        ]
        val out = detect_cycles(3, edges)
        expect(out.ok).to_be(true)
        expect(out.has_cycle).to_be(false)
        expect(out.cycle_members.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "reports no cycle on a diamond (two paths are not a cycle)":
        step("Verify: reports no cycle on a diamond (two paths are not a cycle)")
        # 0 -> 1, 0 -> 2, 1 -> 3, 2 -> 3: converging paths, still acyclic.
        val edges = [
            ResolveEdge(from_index: 0, to_index: 1),
            ResolveEdge(from_index: 0, to_index: 2),
            ResolveEdge(from_index: 1, to_index: 3),
            ResolveEdge(from_index: 2, to_index: 3)
        ]
        val out = detect_cycles(4, edges)
        expect(out.ok).to_be(true)
        expect(out.has_cycle).to_be(false)
        expect(out.cycle_members.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "flags a self-loop node as its own single cycle member":
        step("Verify: flags a self-loop node as its own single cycle member")
        val edges = [ResolveEdge(from_index: 1, to_index: 1)]
        val out = detect_cycles(2, edges)
        expect(out.ok).to_be(true)
        expect(out.has_cycle).to_be(true)
        expect(out.cycle_members.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(out.cycle_members[0]).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "flags both members of a 2-cycle in ascending order":
        step("Verify: flags both members of a 2-cycle in ascending order")
        val edges = [
            ResolveEdge(from_index: 1, to_index: 0),
            ResolveEdge(from_index: 0, to_index: 1)
        ]
        val out = detect_cycles(2, edges)
        expect(out.ok).to_be(true)
        expect(out.has_cycle).to_be(true)
        expect(out.cycle_members.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(out.cycle_members[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(out.cycle_members[1]).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "lists all members of two disjoint cycles ascending across both":
        step("Verify: lists all members of two disjoint cycles ascending across both")
        # Cycle A = {1, 4}, cycle B = {2, 5}; nodes 0 and 3 are islands.
        # Edge input order is deliberately scrambled — output must still be
        # ascending by node index, interleaving the two cycles.
        val edges = [
            ResolveEdge(from_index: 4, to_index: 1),
            ResolveEdge(from_index: 2, to_index: 5),
            ResolveEdge(from_index: 1, to_index: 4),
            ResolveEdge(from_index: 5, to_index: 2)
        ]
        val out = detect_cycles(6, edges)
        expect(out.ok).to_be(true)
        expect(out.has_cycle).to_be(true)
        expect(out.cycle_members.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(out.cycle_members[0]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(out.cycle_members[1]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(out.cycle_members[2]).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(out.cycle_members[3]).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "excludes an acyclic tail hanging off a cycle from the members":
        step("Verify: excludes an acyclic tail hanging off a cycle from the members")
        # 0 -> 1 -> 2 -> 0 is the cycle; 2 -> 3 -> 4 is a dead-end tail.
        # Tail nodes are downstream of the cycle but on no cycle themselves.
        val edges = [
            ResolveEdge(from_index: 0, to_index: 1),
            ResolveEdge(from_index: 1, to_index: 2),
            ResolveEdge(from_index: 2, to_index: 0),
            ResolveEdge(from_index: 2, to_index: 3),
            ResolveEdge(from_index: 3, to_index: 4)
        ]
        val out = detect_cycles(5, edges)
        expect(out.ok).to_be(true)
        expect(out.has_cycle).to_be(true)
        expect(out.cycle_members.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(out.cycle_members[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(out.cycle_members[1]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(out.cycle_members[2]).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "rejects out-of-bounds edges and a negative node count, never trapping":
        step("Verify: rejects out-of-bounds edges and a negative node count, never trapping")
        val edges = [ResolveEdge(from_index: 0, to_index: 7)]
        val out = detect_cycles(2, edges)
        expect(out.ok).to_be(false)
        expect(out.has_cycle).to_be(false)
        expect(out.cycle_members.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val no_edges: [ResolveEdge] = []
        val neg = detect_cycles(-1, no_edges)
        expect(neg.ok).to_be(false)
        expect(neg.has_cycle).to_be(false)
