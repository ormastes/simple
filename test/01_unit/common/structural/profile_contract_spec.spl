"""
## Purpose and audience
Purpose: Prove that profile contract v1 exact bytes.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMMON-STRUCTURAL-001 — stable requirement identity for this spec.

# ============================================================================
# Profile-descriptor contract v1 (§26 group 11) — contract freeze spec.
#
# Four claims, extending the pattern of resolve_contract_spec.spl:
#   1. EXACT BYTES — encoder output equals hand-derived golden vectors.
#      Round trip alone cannot see a symmetric encoder+decoder defect.
#   2. TOTAL DECODERS — malformed input returns ok=false, never traps, and
#      unknown discriminants / set reserved bits are hard rejects.
#   3. ENCODE-SIDE ENFORCEMENT — an ill-formed descriptor never reaches the
#      wire; the encoder refuses it and emits no partial buffer.
#   4. NO SECOND VOCABULARY — the frozen layout kind spellings and per-kind
#      GPU eligibility agree with the LAYOUT lane's live constants, and the
#      SMF stage count agrees with the LINK lane's frozen L0..L12 stage ids.
# ============================================================================

use std.spec
use std.common.structural.wire.{wire_to_hex}
use std.common.structural.identity.entity_id.{hash128}
use std.common.structural.profile.profile_types.{
    LAYOUT_ADMISSION_ALL,
    LAYOUT_FLAG_GPU_ELIGIBLE,
    LAYOUT_FLAG_SEQUENTIAL_WITHIN_ISLAND,
    LAYOUT_FLAG_TEXT_MEASURE_REQUIRED,
    LAYOUT_PROFILE_DESCRIPTOR_LEN,
    LAYOUT_PROFILE_KIND_COUNT,
    LAYOUT_STEP_ALL,
    LAYOUT_STEP_ARRANGE,
    LAYOUT_STEP_DISCOVER,
    LAYOUT_STEP_ESTIMATE,
    LAYOUT_STEP_MEASURE,
    LAYOUT_STEP_VERIFY,
    PROFILE_U32_MAX,
    RESOLVE_CORE_ALL,
    RESOLVE_CORE_CONSTRAINT_PROPAGATION,
    RESOLVE_CORE_PATCH_EMISSION,
    RESOLVE_CORE_SCAN_PLACEMENT,
    RESOLVE_PROFILE_DESCRIPTOR_LEN,
    RESOLVE_PROFILE_KIND_COUNT,
    RESOLVE_STEP_ALL,
    RESOLVE_STEP_DERIVE_CONSTRAINTS,
    RESOLVE_STEP_PLAN_PLACEMENT,
    ResolveProfileKind,
    SpatialLayoutProfileKind,
    layout_profile_descriptor,
    layout_profile_descriptor_equal,
    layout_profile_descriptor_valid,
    layout_profile_kind_gpu_eligible,
    layout_profile_kind_name,
    layout_profile_kind_to_u8,
    layout_profile_kind_valid,
    resolve_profile_counts_valid,
    resolve_profile_descriptor,
    resolve_profile_descriptor_equal,
    resolve_profile_descriptor_valid,
    resolve_profile_kind_name,
    resolve_profile_kind_to_u8,
    resolve_profile_kind_valid
}
use std.common.structural.profile.profile_codec.{
    decode_layout_profile_descriptor,
    decode_resolve_profile_descriptor,
    encode_layout_profile_descriptor,
    encode_resolve_profile_descriptor
}
use std.common.structural.resolve.resolve_types.{SMF_LINK_STAGE_L12_MANIFEST_COMMIT}
use std.common.structural.layout.profile.{
    LAYOUT_PROFILE_ABSOLUTE_STICKY,
    LAYOUT_PROFILE_BLOCK,
    LAYOUT_PROFILE_FLEX,
    LAYOUT_PROFILE_GRID,
    LAYOUT_PROFILE_INLINE,
    LAYOUT_PROFILE_REPLACED,
    LAYOUT_PROFILE_SCROLL,
    LAYOUT_PROFILE_TABLE,
    layout_profile_gpu_eligible,
    layout_profile_supported
}
use test.fixtures.structural.profile_golden_v1.{
    profile_golden_layout_block_hex,
    profile_golden_layout_grid_hex,
    profile_golden_layout_inline_hex,
    profile_golden_resolve_max_hex,
    profile_golden_resolve_smf_hex,
    profile_golden_resolve_web_hex
}

fn golden_resolve_smf() -> any:
    resolve_profile_descriptor(
        hash128(0x2122232425262728, 0x3132333435363738), 0, 63, 255, 3, 13)

fn golden_resolve_web() -> any:
    resolve_profile_descriptor(hash128(0, 0), 2, 47, 223, 6, 6)

fn golden_resolve_max() -> any:
    resolve_profile_descriptor(
        hash128(0x7fffffffffffffff, 0x7fffffffffffffff), 1, 63, 255, 4294967294, 1)

fn golden_layout_block() -> any:
    layout_profile_descriptor(
        hash128(0x1122334455667788, 0x1314151617181920), 0, 27, 1, 131)

fn golden_layout_inline() -> any:
    layout_profile_descriptor(hash128(0, 0), 1, 15, 6, 0)

fn golden_layout_grid() -> any:
    layout_profile_descriptor(
        hash128(0x7fffffffffffffff, 0x7fffffffffffffff), 3, 31, 3, 511)

fn kind_name_from_layout_lane(k: i64) -> text:
    match k:
        case 0: LAYOUT_PROFILE_BLOCK
        case 1: LAYOUT_PROFILE_INLINE
        case 2: LAYOUT_PROFILE_FLEX
        case 3: LAYOUT_PROFILE_GRID
        case 4: LAYOUT_PROFILE_TABLE
        case 5: LAYOUT_PROFILE_ABSOLUTE_STICKY
        case 6: LAYOUT_PROFILE_SCROLL
        case _: LAYOUT_PROFILE_REPLACED

describe "profile contract v1 exact bytes":
    it "encodes the SmfLinkProfile descriptor to the hand-derived golden vector":
        step("Verify: encodes the SmfLinkProfile descriptor to the hand-derived golden vector")
        # @req: REQ-COMMON-STRUCTURAL-001
        val out = encode_resolve_profile_descriptor(golden_resolve_smf())
        expect(out.ok).to_be(true)
        expect(wire_to_hex(out.bytes)).to_equal(profile_golden_resolve_smf_hex())

    it "encodes the WebResourceLinkProfile descriptor to the golden vector":
        step("Verify: encodes the WebResourceLinkProfile descriptor to the golden vector")
        val out = encode_resolve_profile_descriptor(golden_resolve_web())
        expect(out.ok).to_be(true)
        expect(wire_to_hex(out.bytes)).to_equal(profile_golden_resolve_web_hex())

    it "encodes the max-count resolve descriptor to the golden vector":
        step("Verify: encodes the max-count resolve descriptor to the golden vector")
        val out = encode_resolve_profile_descriptor(golden_resolve_max())
        expect(out.ok).to_be(true)
        expect(wire_to_hex(out.bytes)).to_equal(profile_golden_resolve_max_hex())

    it "encodes the block layout descriptor to the golden vector":
        step("Verify: encodes the block layout descriptor to the golden vector")
        val out = encode_layout_profile_descriptor(golden_layout_block())
        expect(out.ok).to_be(true)
        expect(wire_to_hex(out.bytes)).to_equal(profile_golden_layout_block_hex())

    it "encodes the inline layout descriptor to the golden vector":
        step("Verify: encodes the inline layout descriptor to the golden vector")
        val out = encode_layout_profile_descriptor(golden_layout_inline())
        expect(out.ok).to_be(true)
        expect(wire_to_hex(out.bytes)).to_equal(profile_golden_layout_inline_hex())

    it "encodes the grid layout descriptor to the golden vector":
        step("Verify: encodes the grid layout descriptor to the golden vector")
        val out = encode_layout_profile_descriptor(golden_layout_grid())
        expect(out.ok).to_be(true)
        expect(wire_to_hex(out.bytes)).to_equal(profile_golden_layout_grid_hex())

    it "freezes the descriptor widths downstream lanes size catalogs by":
        step("Verify: freezes the descriptor widths downstream lanes size catalogs by")
        expect(RESOLVE_PROFILE_DESCRIPTOR_LEN).to_equal(32)  # oracle: 32 — named expected value from the requirement
        expect(LAYOUT_PROFILE_DESCRIPTOR_LEN).to_equal(24)  # oracle: 24 — named expected value from the requirement
        expect(encode_resolve_profile_descriptor(golden_resolve_smf()).bytes.len()).to_equal(40)  # oracle: 40 — named expected value from the requirement
        expect(encode_layout_profile_descriptor(golden_layout_block()).bytes.len()).to_equal(32)  # oracle: 32 — named expected value from the requirement

describe "profile contract v1 round trip":
    it "round-trips an asymmetric resolve descriptor without field loss":
        step("Verify: round-trips an asymmetric resolve descriptor without field loss")
        val d = golden_resolve_smf()
        val out = decode_resolve_profile_descriptor(
            encode_resolve_profile_descriptor(d).bytes)
        expect(out.ok).to_be(true)
        expect(resolve_profile_descriptor_equal(out.value, d)).to_be(true)

    it "round-trips the placement-free web resolve descriptor":
        step("Verify: round-trips the placement-free web resolve descriptor")
        val d = golden_resolve_web()
        val out = decode_resolve_profile_descriptor(
            encode_resolve_profile_descriptor(d).bytes)
        expect(out.ok).to_be(true)
        expect(resolve_profile_descriptor_equal(out.value, d)).to_be(true)

    it "round-trips an asymmetric layout descriptor without field loss":
        step("Verify: round-trips an asymmetric layout descriptor without field loss")
        val d = golden_layout_grid()
        val out = decode_layout_profile_descriptor(
            encode_layout_profile_descriptor(d).bytes)
        expect(out.ok).to_be(true)
        expect(layout_profile_descriptor_equal(out.value, d)).to_be(true)

    it "round-trips the sequential inline layout descriptor":
        step("Verify: round-trips the sequential inline layout descriptor")
        val d = golden_layout_inline()
        val out = decode_layout_profile_descriptor(
            encode_layout_profile_descriptor(d).bytes)
        expect(out.ok).to_be(true)
        expect(layout_profile_descriptor_equal(out.value, d)).to_be(true)

describe "profile contract v1 total decoders":
    it "rejects a resolve buffer presented to the layout decoder":
        step("Verify: rejects a resolve buffer presented to the layout decoder")
        val bytes = encode_resolve_profile_descriptor(golden_resolve_smf()).bytes
        expect(decode_layout_profile_descriptor(bytes).ok).to_be(false)

    it "rejects a layout buffer presented to the resolve decoder":
        step("Verify: rejects a layout buffer presented to the resolve decoder")
        val bytes = encode_layout_profile_descriptor(golden_layout_block()).bytes
        expect(decode_resolve_profile_descriptor(bytes).ok).to_be(false)

    it "rejects a truncated resolve descriptor":
        step("Verify: rejects a truncated resolve descriptor")
        val bytes = encode_resolve_profile_descriptor(golden_resolve_smf()).bytes
        var cut: [u8] = []
        var i = 0
        while i < bytes.len() - 1:
            cut.push(bytes[i])
            i = i + 1
        expect(decode_resolve_profile_descriptor(cut).ok).to_be(false)

    it "rejects a truncated layout descriptor":
        step("Verify: rejects a truncated layout descriptor")
        val bytes = encode_layout_profile_descriptor(golden_layout_grid()).bytes
        var cut: [u8] = []
        var i = 0
        while i < bytes.len() - 1:
            cut.push(bytes[i])
            i = i + 1
        expect(decode_layout_profile_descriptor(cut).ok).to_be(false)

    it "rejects an unknown ResolveProfileKind discriminant on the wire":
        step("Verify: rejects an unknown ResolveProfileKind discriminant on the wire")
        val bytes = encode_resolve_profile_descriptor(golden_resolve_smf()).bytes
        var poked: [u8] = []
        var i = 0
        while i < bytes.len():
            if i == 24:
                poked.push(9)
            else:
                poked.push(bytes[i])
            i = i + 1
        expect(decode_resolve_profile_descriptor(poked).ok).to_be(false)

    it "rejects an unknown SpatialLayoutProfileKind discriminant on the wire":
        step("Verify: rejects an unknown SpatialLayoutProfileKind discriminant on the wire")
        val bytes = encode_layout_profile_descriptor(golden_layout_block()).bytes
        var poked: [u8] = []
        var i = 0
        while i < bytes.len():
            if i == 24:
                poked.push(8)
            else:
                poked.push(bytes[i])
            i = i + 1
        expect(decode_layout_profile_descriptor(poked).ok).to_be(false)

    it "rejects a nonzero reserved u32 in a resolve descriptor":
        step("Verify: rejects a nonzero reserved u32 in a resolve descriptor")
        val bytes = encode_resolve_profile_descriptor(golden_resolve_smf()).bytes
        var poked: [u8] = []
        var i = 0
        while i < bytes.len():
            if i == 36:
                poked.push(1)
            else:
                poked.push(bytes[i])
            i = i + 1
        expect(decode_resolve_profile_descriptor(poked).ok).to_be(false)

    it "rejects a set reserved step bit on the wire":
        step("Verify: rejects a set reserved step bit on the wire")
        val bytes = encode_layout_profile_descriptor(golden_layout_grid()).bytes
        var poked: [u8] = []
        var i = 0
        while i < bytes.len():
            if i == 25:
                poked.push(bytes[i] | 32)
            else:
                poked.push(bytes[i])
            i = i + 1
        expect(decode_layout_profile_descriptor(poked).ok).to_be(false)

    it "bounds the two closed kind vocabularies":
        step("Verify: bounds the two closed kind vocabularies")
        expect(RESOLVE_PROFILE_KIND_COUNT).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(LAYOUT_PROFILE_KIND_COUNT).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(resolve_profile_kind_valid(2)).to_be(true)
        expect(resolve_profile_kind_valid(3)).to_be(false)
        expect(layout_profile_kind_valid(7)).to_be(true)
        expect(layout_profile_kind_valid(8)).to_be(false)

describe "profile contract v1 encode-side enforcement":
    it "refuses to encode a resolve descriptor missing a mandatory step":
        step("Verify: refuses to encode a resolve descriptor missing a mandatory step")
        # emit dropped: the profile would produce no observable output.
        val d = resolve_profile_descriptor(hash128(1, 2), 0, 31, 255, 1, 1)
        val out = encode_resolve_profile_descriptor(d)
        expect(out.ok).to_be(false)
        expect(out.bytes.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "refuses a resolve descriptor whose step and core masks disagree":
        step("Verify: refuses a resolve descriptor whose step and core masks disagree")
        # derive_constraints declared without constraint propagation.
        val d = resolve_profile_descriptor(
            hash128(1, 2), 0,
            RESOLVE_STEP_ALL,
            RESOLVE_CORE_ALL - RESOLVE_CORE_CONSTRAINT_PROPAGATION,
            1, 1)
        expect(encode_resolve_profile_descriptor(d).ok).to_be(false)

    it "refuses a resolve descriptor claiming placement without scan placement":
        step("Verify: refuses a resolve descriptor claiming placement without scan placement")
        val d = resolve_profile_descriptor(
            hash128(1, 2), 0,
            RESOLVE_STEP_ALL,
            RESOLVE_CORE_ALL - RESOLVE_CORE_SCAN_PLACEMENT,
            1, 1)
        expect(encode_resolve_profile_descriptor(d).ok).to_be(false)

    it "refuses a resolve descriptor that emits without patch emission":
        step("Verify: refuses a resolve descriptor that emits without patch emission")
        val d = resolve_profile_descriptor(
            hash128(1, 2), 0,
            RESOLVE_STEP_ALL,
            RESOLVE_CORE_ALL - RESOLVE_CORE_PATCH_EMISSION,
            1, 1)
        expect(encode_resolve_profile_descriptor(d).ok).to_be(false)

    it "takes the u32 count total at 64-bit width, so a wrapping sum is rejected":
        step("Verify: takes the u32 count total at 64-bit width, so a wrapping sum is rejected")
        # 4294967294 + 1 == U32_MAX exactly: accepted.
        expect(resolve_profile_counts_valid(4294967294, 1)).to_be(true)
        # 4294967295 + 1 == 2^32. At u32 width that wraps to 0 and would pass
        # as well-formed; widened to i64 it must be rejected.
        expect(resolve_profile_counts_valid(PROFILE_U32_MAX, 1)).to_be(false)
        expect(resolve_profile_counts_valid(PROFILE_U32_MAX, PROFILE_U32_MAX)).to_be(false)
        expect(encode_resolve_profile_descriptor(resolve_profile_descriptor(
            hash128(1, 2), 0, 63, 255, PROFILE_U32_MAX, 1)).ok).to_be(false)

    it "rejects a zero space_count, which can never form a ResolveKey":
        step("Verify: rejects a zero space_count, which can never form a ResolveKey")
        expect(resolve_profile_counts_valid(0, 1)).to_be(false)
        expect(resolve_profile_counts_valid(1, 0)).to_be(false)

    it "refuses a layout descriptor whose gpu flag contradicts its kind":
        step("Verify: refuses a layout descriptor whose gpu flag contradicts its kind")
        # inline is never GPU eligible, whatever the descriptor claims.
        val d = layout_profile_descriptor(hash128(1, 2), 1, 15,
            LAYOUT_FLAG_GPU_ELIGIBLE | LAYOUT_FLAG_TEXT_MEASURE_REQUIRED, 0)
        expect(encode_layout_profile_descriptor(d).ok).to_be(false)

    it "refuses a layout descriptor whose text flag contradicts its steps":
        step("Verify: refuses a layout descriptor whose text flag contradicts its steps")
        val d = layout_profile_descriptor(hash128(1, 2), 0,
            LAYOUT_STEP_DISCOVER | LAYOUT_STEP_ESTIMATE | LAYOUT_STEP_ARRANGE,
            LAYOUT_FLAG_GPU_ELIGIBLE | LAYOUT_FLAG_TEXT_MEASURE_REQUIRED, 0)
        expect(encode_layout_profile_descriptor(d).ok).to_be(false)

    it "refuses a gpu-eligible profile that is sequential within its island":
        step("Verify: refuses a gpu-eligible profile that is sequential within its island")
        val d = layout_profile_descriptor(hash128(1, 2), 2,
            LAYOUT_STEP_DISCOVER | LAYOUT_STEP_ESTIMATE | LAYOUT_STEP_ARRANGE,
            LAYOUT_FLAG_GPU_ELIGIBLE | LAYOUT_FLAG_SEQUENTIAL_WITHIN_ISLAND, 0)
        expect(encode_layout_profile_descriptor(d).ok).to_be(false)

    it "refuses admission bits on a profile with no gpu admission decision":
        step("Verify: refuses admission bits on a profile with no gpu admission decision")
        val d = layout_profile_descriptor(hash128(1, 2), 4,
            LAYOUT_STEP_DISCOVER | LAYOUT_STEP_ESTIMATE | LAYOUT_STEP_ARRANGE,
            0, 1)
        expect(encode_layout_profile_descriptor(d).ok).to_be(false)

    it "refuses a reserved admission bit above the frozen nine":
        step("Verify: refuses a reserved admission bit above the frozen nine")
        val d = layout_profile_descriptor(hash128(1, 2), 3, LAYOUT_STEP_ALL,
            LAYOUT_FLAG_GPU_ELIGIBLE | LAYOUT_FLAG_TEXT_MEASURE_REQUIRED,
            LAYOUT_ADMISSION_ALL + 512)
        expect(encode_layout_profile_descriptor(d).ok).to_be(false)

    it "accepts every valid golden descriptor it was asked to reject variants of":
        step("Verify: accepts every valid golden descriptor it was asked to reject variants of")
        expect(resolve_profile_descriptor_valid(golden_resolve_smf())).to_be(true)
        expect(resolve_profile_descriptor_valid(golden_resolve_web())).to_be(true)
        expect(layout_profile_descriptor_valid(golden_layout_block())).to_be(true)
        expect(layout_profile_descriptor_valid(golden_layout_inline())).to_be(true)

describe "profile contract v1 mints no second vocabulary":
    it "spells every layout kind exactly as the LAYOUT lane does":
        step("Verify: spells every layout kind exactly as the LAYOUT lane does")
        var k = 0
        while k < LAYOUT_PROFILE_KIND_COUNT:
            expect(layout_profile_kind_name(k)).to_equal(kind_name_from_layout_lane(k))
            expect(layout_profile_supported(layout_profile_kind_name(k))).to_be(true)
            k = k + 1

    it "agrees with the LAYOUT lane on per-kind gpu eligibility":
        step("Verify: agrees with the LAYOUT lane on per-kind gpu eligibility")
        var k = 0
        while k < LAYOUT_PROFILE_KIND_COUNT:
            expect(layout_profile_kind_gpu_eligible(k))
                .to_equal(layout_profile_gpu_eligible(layout_profile_kind_name(k)))
            k = k + 1

    it "orders the layout kind enum to match its wire discriminants":
        step("Verify: orders the layout kind enum to match its wire discriminants")
        expect(layout_profile_kind_to_u8(SpatialLayoutProfileKind.Block)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(layout_profile_kind_to_u8(SpatialLayoutProfileKind.Inline)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(layout_profile_kind_to_u8(SpatialLayoutProfileKind.Replaced)).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "orders the resolve kind enum and names to match §18.2":
        step("Verify: orders the resolve kind enum and names to match §18.2")
        expect(resolve_profile_kind_to_u8(ResolveProfileKind.SmfLink)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(resolve_profile_kind_to_u8(ResolveProfileKind.ClangOffloadLink)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(resolve_profile_kind_to_u8(ResolveProfileKind.WebResourceLink)).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(resolve_profile_kind_name(0)).to_equal("smf_link")
        expect(resolve_profile_kind_name(2)).to_equal("web_resource_link")

    it "keeps the SMF descriptor stage_count equal to the LINK lane L0..L12 span":
        step("Verify: keeps the SMF descriptor stage_count equal to the LINK lane L0..L12 span")
        expect(golden_resolve_smf().stage_count)
            .to_equal(SMF_LINK_STAGE_L12_MANIFEST_COMMIT + 1)

    it "covers every frozen resolve step and layout step bit":
        step("Verify: covers every frozen resolve step and layout step bit")
        expect(RESOLVE_STEP_ALL).to_equal(63)  # oracle: 63 — named expected value from the requirement
        expect(RESOLVE_STEP_DERIVE_CONSTRAINTS | RESOLVE_STEP_PLAN_PLACEMENT).to_equal(24)  # oracle: 24 — named expected value from the requirement
        expect(LAYOUT_STEP_ALL).to_equal(31)  # oracle: 31 — named expected value from the requirement
        expect(LAYOUT_STEP_MEASURE | LAYOUT_STEP_VERIFY).to_equal(20)  # oracle: 20 — named expected value from the requirement
