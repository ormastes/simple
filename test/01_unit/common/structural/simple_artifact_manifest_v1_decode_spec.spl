use std.spec
use std.common.contracts.execution.simpleos_executable_v1.{
    ManifestResourceLimits, ManifestTarget, SimpleArtifactManifest
}
use std.common.structural.execution.simple_artifact_manifest_v1_codec.{
    encode_simple_artifact_manifest_v1_signing_bytes,
    decode_simple_artifact_manifest_v1_signing_bytes
}

fn sam1_decode_fixture() -> SimpleArtifactManifest:
    SimpleArtifactManifest(
        format_version: 1, artifact_kind: "native-executable",
        target: ManifestTarget(
            os: "simpleos", arch: "riscv64", abi: "simpleos"),
        entrypoint: "/bin/simplebox",
        required_abi_features: ["rv64gc"], required_services: ["vfs"],
        required_capabilities: 7u32,
        resource_limits: ManifestResourceLimits(
            max_memory_bytes: 1048576, max_open_handles: 16,
            max_threads: 1, cpu_budget_us: 5000),
        namespace_template: "simplebox", native_libraries: [],
        smf_libraries: [], interpreter: "", argument_schema: [],
        startup_preloads: [], content_hashes: ["11" * 32],
        signature: "ed25519:image-key:" + "22" * 64,
        debug_identity: "simplebox-rv64")

describe "canonical SAM1 typed decoder":
    it "recovers the complete typed projection and exact image identity":
        val manifest = sam1_decode_fixture()
        val encoded = encode_simple_artifact_manifest_v1_signing_bytes(
            manifest, "11" * 32)
        val decoded = decode_simple_artifact_manifest_v1_signing_bytes(
            encoded.bytes, manifest.signature)
        expect(decoded.?).to_be(true)
        expect(decoded.unwrap().image_hash).to_equal("11" * 32)
        expect(decoded.unwrap().manifest).to_equal(manifest)

    it "rejects trailing bytes instead of accepting a canonical prefix":
        val manifest = sam1_decode_fixture()
        var encoded = encode_simple_artifact_manifest_v1_signing_bytes(
            manifest, "11" * 32).bytes
        encoded.push(0u8)
        expect(decode_simple_artifact_manifest_v1_signing_bytes(
            encoded, manifest.signature).?).to_be(false)

    it "rejects nonzero reserved envelope bytes":
        val manifest = sam1_decode_fixture()
        var encoded = encode_simple_artifact_manifest_v1_signing_bytes(
            manifest, "11" * 32).bytes
        encoded[6] = 1u8
        expect(decode_simple_artifact_manifest_v1_signing_bytes(
            encoded, manifest.signature).?).to_be(false)
