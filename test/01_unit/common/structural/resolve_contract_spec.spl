"""
## Purpose and audience
Purpose: Prove that resolve contract v1 exact bytes.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMMON-STRUCTURAL-001 — stable requirement identity for this spec.

# ============================================================================
# Resolve contract v1 (LINK lane) — contract freeze spec.
#
# Three claims, mirroring identity_tagmap_contract_spec.spl:
#   1. EXACT BYTES — encoder output equals hand-derived golden vectors.
#   2. TOTAL DECODERS — malformed input returns ok=false, never traps, and
#      unknown discriminants / nonzero reserved are hard rejects.
#   3. ROUND TRIP — decode(encode(x)) == x for asymmetric values, so no field
#      is dropped, swapped, or truncated.
# ============================================================================

use std.spec
use std.common.structural.wire.{wire_to_hex}
use std.common.structural.identity.entity_id.{entity_ref, hash128}
use std.common.structural.resolve.resolve_types.{
    DEFINITION_RECORD_LEN,
    REFERENCE_RECORD_LEN,
    RESOLUTION_RECORD_LEN,
    RESOLVE_KEY_LEN,
    ResolveReason,
    ResolveStatus,
    definition_record,
    definition_record_equal,
    reference_record,
    reference_record_equal,
    resolution_definition_present,
    resolution_record,
    resolution_record_equal,
    resolve_key,
    resolve_key_equal,
    resolve_reason_to_u8,
    resolve_reason_valid,
    resolve_status_to_u8,
    resolve_status_valid
}
use std.common.structural.resolve.resolve_codec.{
    decode_definition_record,
    decode_reference_record,
    decode_resolution_record,
    encode_definition_record,
    encode_reference_record,
    encode_resolution_record,
    resolve_zero_entity_ref
}
use test.fixtures.structural.resolve_golden_v1.{
    resolve_golden_definition_hex,
    resolve_golden_reference_maxpos_hex,
    resolve_golden_resolution_resolved_hex,
    resolve_golden_resolution_zero_hex
}

fn golden_definition() -> any:
    definition_record(
        resolve_key(hash128(0x0102030405060708, 0x1112131415161718), 42),
        entity_ref(7, 9),
        0x00f0000000000001,
        3)

describe "resolve contract v1 exact bytes":
    it "encodes DefinitionRecord to the hand-derived golden vector":
        step("Verify: encodes DefinitionRecord to the hand-derived golden vector")
        # @req: REQ-COMMON-STRUCTURAL-001
        expect(wire_to_hex(encode_definition_record(golden_definition())))
            .to_equal(resolve_golden_definition_hex())

    it "encodes the zero ResolutionRecord to the golden vector":
        step("Verify: encodes the zero ResolutionRecord to the golden vector")
        val r = resolution_record(resolve_zero_entity_ref(), resolve_zero_entity_ref(), 0, 0)
        expect(wire_to_hex(encode_resolution_record(r)))
            .to_equal(resolve_golden_resolution_zero_hex())

    it "encodes a resolved ResolutionRecord to the golden vector":
        step("Verify: encodes a resolved ResolutionRecord to the golden vector")
        val r = resolution_record(entity_ref(1, 2), entity_ref(3, 4),
            resolve_status_to_u8(ResolveStatus.Resolved),
            resolve_reason_to_u8(ResolveReason.Unspecified))
        expect(wire_to_hex(encode_resolution_record(r)))
            .to_equal(resolve_golden_resolution_resolved_hex())

    it "encodes a max-positive ReferenceRecord to the golden vector":
        step("Verify: encodes a max-positive ReferenceRecord to the golden vector")
        val r = reference_record(
            resolve_key(hash128(0x7fffffffffffffff, 0x7fffffffffffffff), 4294967295),
            entity_ref(4294967295, 4294967295),
            0x7fffffffffffffff,
            0x7fffffffffffffff)
        expect(wire_to_hex(encode_reference_record(r)))
            .to_equal(resolve_golden_reference_maxpos_hex())

    it "freezes the record widths downstream lanes size arenas by":
        step("Verify: freezes the record widths downstream lanes size arenas by")
        expect(RESOLVE_KEY_LEN).to_equal(20)  # oracle: 20 — named expected value from the requirement
        expect(DEFINITION_RECORD_LEN).to_equal(44)  # oracle: 44 — named expected value from the requirement
        expect(REFERENCE_RECORD_LEN).to_equal(44)  # oracle: 44 — named expected value from the requirement
        expect(RESOLUTION_RECORD_LEN).to_equal(20)  # oracle: 20 — named expected value from the requirement
        expect(encode_definition_record(golden_definition()).len()).to_equal(52)  # oracle: 52 — named expected value from the requirement

describe "resolve contract v1 round trip":
    it "round-trips an asymmetric DefinitionRecord without field loss":
        step("Verify: round-trips an asymmetric DefinitionRecord without field loss")
        val d = golden_definition()
        val out = decode_definition_record(encode_definition_record(d))
        expect(out.ok).to_be(true)
        expect(definition_record_equal(out.value, d)).to_be(true)

    it "round-trips an asymmetric ReferenceRecord without field loss":
        step("Verify: round-trips an asymmetric ReferenceRecord without field loss")
        val r = reference_record(
            resolve_key(hash128(0xaaaa, 0xbbbb), 5), entity_ref(11, 13), 17, 19)
        val out = decode_reference_record(encode_reference_record(r))
        expect(out.ok).to_be(true)
        expect(reference_record_equal(out.value, r)).to_be(true)

    it "round-trips a resolved ResolutionRecord and keeps the definition":
        step("Verify: round-trips a resolved ResolutionRecord and keeps the definition")
        val r = resolution_record(entity_ref(1, 2), entity_ref(3, 4),
            resolve_status_to_u8(ResolveStatus.Resolved), 0)
        val out = decode_resolution_record(encode_resolution_record(r))
        expect(out.ok).to_be(true)
        expect(resolution_record_equal(out.value, r)).to_be(true)
        expect(resolution_definition_present(out.value)).to_be(true)

describe "resolve contract v1 total decoders":
    it "rejects a buffer with the wrong magic":
        step("Verify: rejects a buffer with the wrong magic")
        val bytes = encode_reference_record(reference_record(
            resolve_key(hash128(1, 2), 3), entity_ref(4, 5), 6, 7))
        expect(decode_definition_record(bytes).ok).to_be(false)

    it "rejects a truncated DefinitionRecord":
        step("Verify: rejects a truncated DefinitionRecord")
        val bytes = encode_definition_record(golden_definition())
        var cut: [u8] = []
        var i = 0
        while i < bytes.len() - 1:
            cut.push(bytes[i])
            i = i + 1
        expect(decode_definition_record(cut).ok).to_be(false)

    it "rejects an unknown ResolveStatus discriminant":
        step("Verify: rejects an unknown ResolveStatus discriminant")
        val r = resolution_record(entity_ref(1, 2), entity_ref(3, 4), 200, 0)
        expect(decode_resolution_record(encode_resolution_record(r)).ok).to_be(false)

    it "rejects a nonzero reserved field in a ResolutionRecord":
        step("Verify: rejects a nonzero reserved field in a ResolutionRecord")
        val bytes = encode_resolution_record(
            resolution_record(entity_ref(1, 2), resolve_zero_entity_ref(), 0, 0))
        var poked: [u8] = []
        var i = 0
        while i < bytes.len():
            if i == 26:
                poked.push(1)
            else:
                poked.push(bytes[i])
            i = i + 1
        expect(decode_resolution_record(poked).ok).to_be(false)

    it "bounds the status and reason discriminant spaces":
        step("Verify: bounds the status and reason discriminant spaces")
        expect(resolve_status_valid(3)).to_be(true)
        expect(resolve_status_valid(4)).to_be(false)
        expect(resolve_reason_valid(5)).to_be(true)
        expect(resolve_reason_valid(6)).to_be(false)
