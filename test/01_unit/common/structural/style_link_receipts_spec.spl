"""
## Purpose and audience
Purpose: Prove that style_link_receipts stage keys.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMMON-STRUCTURAL-001 — stable requirement identity for this spec.

# ============================================================================
# StyleLinker StageReceipts (Lane STYLERCPT) — style_link_receipts.spl spec.
#
# Five claims (mirroring smf_link_receipts_spec.spl; style_link has no
# rejection path, so there is no malformed section — malformed_count is
# asserted structurally 0 under counts instead):
#   1. STAGE KEYS — collect/resolve/link receipts are keyed by the matching
#      profile-local STYLE_LINK_STAGE_* const via style_link_stage_id, and
#      carry the cpu_reference backend + CpuReference mode.
#   2. WRAPPER FIDELITY — each *_with_receipt wrapper returns exactly what
#      the frozen underlying function returns (record/resolution/name
#      content unchanged).
#   3. COUNTS — item_count_in/item_count_out reflect the stage's real
#      element counts; byte, time and malformed counters are structurally 0.
#   4. DETERMINISM — running the same stage twice on the same input yields
#      byte-identical input_root, output_root and deterministic_hash (no
#      timestamps anywhere in the receipt).
#   5. SENSITIVITY — a one-symbol input change moves input_root,
#      output_root and deterministic_hash (the roots are content hashes,
#      not constants).
# ============================================================================

use std.spec
use std.common.compute.placement_contracts.backend.{StageReceipt}
use std.common.compute.placement_contracts.semantic.{ExecutionMode}
use std.common.structural.resolve.style_link_profile.{
    STYLE_SPACE_CUSTOM_PROPERTY,
    STYLE_SPACE_IMPORT,
    StyleLinkInputs,
    StyleSymbolInput,
    style_collect_records,
    style_link,
    style_resolve
}
use std.common.structural.resolve.style_link_receipts.{
    STYLE_LINK_STAGE_COLLECT,
    STYLE_LINK_STAGE_RESOLVE,
    STYLE_LINK_STAGE_LINK,
    style_link_stage_id,
    style_collect_records_with_receipt,
    style_resolve_with_receipt,
    style_link_with_receipt
}

# ----------------------------------------------------------------------------
# Fixtures
# ----------------------------------------------------------------------------

fn _sym(name: text, space: u32, defined: bool, referenced_names: [text]) -> StyleSymbolInput:
    StyleSymbolInput(
        name: name,
        space: space,
        defined: defined,
        referenced_names: referenced_names)

fn _inputs() -> StyleLinkInputs:
    """Sheet 3: 0 --a(def, cycles with --b) 1 --b(def, cycles with --a)
    2 --a(ref) 3 --missing(ref) 4 theme.css(import ref)."""
    StyleLinkInputs(
        sheet_index: 3,
        symbols: [
            _sym("--a", STYLE_SPACE_CUSTOM_PROPERTY, true, ["--b"]),
            _sym("--b", STYLE_SPACE_CUSTOM_PROPERTY, true, ["--a"]),
            _sym("--a", STYLE_SPACE_CUSTOM_PROPERTY, false, []),
            _sym("--missing", STYLE_SPACE_CUSTOM_PROPERTY, false, []),
            _sym("theme.css", STYLE_SPACE_IMPORT, false, [])
        ])

fn _renamed_inputs() -> StyleLinkInputs:
    """Same shape as _inputs but one definition renamed (--b -> --c)."""
    StyleLinkInputs(
        sheet_index: 3,
        symbols: [
            _sym("--a", STYLE_SPACE_CUSTOM_PROPERTY, true, ["--b"]),
            _sym("--c", STYLE_SPACE_CUSTOM_PROPERTY, true, ["--a"]),
            _sym("--a", STYLE_SPACE_CUSTOM_PROPERTY, false, []),
            _sym("--missing", STYLE_SPACE_CUSTOM_PROPERTY, false, []),
            _sym("theme.css", STYLE_SPACE_IMPORT, false, [])
        ])

fn _is_cpu_reference(receipt: StageReceipt) -> bool:
    match receipt.mode:
        case CpuReference: true
        case HybridVectorGpu: false
        case ResidentGpu: false

# ----------------------------------------------------------------------------
# 1. Stage keys + backend identity
# ----------------------------------------------------------------------------

describe "style_link_receipts stage keys":
    it "keys the collect receipt by STYLE_LINK_STAGE_COLLECT":
        step("Verify: keys the collect receipt by STYLE_LINK_STAGE_COLLECT")
        # @req: REQ-COMMON-STRUCTURAL-001
        val o = style_collect_records_with_receipt(_inputs())
        expect(o.receipt.stage.value).to_equal(style_link_stage_id(STYLE_LINK_STAGE_COLLECT).value)
        expect(o.receipt.stage.value).to_equal("style_link.collect")
        expect(o.receipt.backend.value).to_equal("cpu_reference")
        expect(_is_cpu_reference(o.receipt)).to_be(true)

    it "keys the resolve receipt by STYLE_LINK_STAGE_RESOLVE":
        step("Verify: keys the resolve receipt by STYLE_LINK_STAGE_RESOLVE")
        val c = style_collect_records_with_receipt(_inputs())
        val o = style_resolve_with_receipt(c.defs, c.refs)
        expect(o.receipt.stage.value).to_equal(style_link_stage_id(STYLE_LINK_STAGE_RESOLVE).value)
        expect(o.receipt.stage.value).to_equal("style_link.resolve")
        expect(o.receipt.backend.value).to_equal("cpu_reference")
        expect(_is_cpu_reference(o.receipt)).to_be(true)

    it "keys the link receipt by STYLE_LINK_STAGE_LINK":
        step("Verify: keys the link receipt by STYLE_LINK_STAGE_LINK")
        val o = style_link_with_receipt(_inputs())
        expect(o.receipt.stage.value).to_equal(style_link_stage_id(STYLE_LINK_STAGE_LINK).value)
        expect(o.receipt.stage.value).to_equal("style_link.link")
        expect(o.receipt.backend.value).to_equal("cpu_reference")
        expect(_is_cpu_reference(o.receipt)).to_be(true)

# ----------------------------------------------------------------------------
# 2. Wrapper fidelity — same results as the frozen functions
# ----------------------------------------------------------------------------

describe "style_link_receipts wrapper fidelity":
    it "returns the same defs/refs as style_collect_records":
        step("Verify: returns the same defs/refs as style_collect_records")
        val o = style_collect_records_with_receipt(_inputs())
        val (defs, refs) = style_collect_records(_inputs())
        expect(o.defs.len()).to_equal(defs.len())
        expect(o.refs.len()).to_equal(refs.len())
        expect(o.defs.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(o.refs.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(o.defs[0].order as i64).to_equal(defs[0].order as i64)
        expect(o.refs[0].owner.local_index as i64).to_equal(refs[0].owner.local_index as i64)

    it "returns the same resolutions as style_resolve":
        step("Verify: returns the same resolutions as style_resolve")
        val c = style_collect_records_with_receipt(_inputs())
        val o = style_resolve_with_receipt(c.defs, c.refs)
        val direct = style_resolve(c.defs, c.refs)
        expect(o.results.len()).to_equal(direct.len())
        expect(o.results.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "returns the same packaged result as style_link":
        step("Verify: returns the same packaged result as style_link")
        val o = style_link_with_receipt(_inputs())
        val direct = style_link(_inputs())
        expect(o.result.resolutions.len()).to_equal(direct.resolutions.len())
        expect(o.result.unresolved_names.len()).to_equal(direct.unresolved_names.len())
        expect(o.result.cycle_property_names.len()).to_equal(direct.cycle_property_names.len())
        expect(o.result.cycle_property_names.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(o.result.cycle_property_names[0]).to_equal("--a")
        expect(o.result.cycle_property_names[1]).to_equal("--b")

# ----------------------------------------------------------------------------
# 3. Counts + structurally-zero counters
# ----------------------------------------------------------------------------

describe "style_link_receipts counts":
    it "counts collect input symbols and output records":
        step("Verify: counts collect input symbols and output records")
        val o = style_collect_records_with_receipt(_inputs())
        expect(o.receipt.item_count_in as i64).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(o.receipt.item_count_out as i64).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "counts resolve input records and output resolutions":
        step("Verify: counts resolve input records and output resolutions")
        val c = style_collect_records_with_receipt(_inputs())
        val o = style_resolve_with_receipt(c.defs, c.refs)
        expect(o.receipt.item_count_in as i64).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(o.receipt.item_count_out as i64).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "counts link input symbols and output resolutions":
        step("Verify: counts link input symbols and output resolutions")
        val o = style_link_with_receipt(_inputs())
        expect(o.receipt.item_count_in as i64).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(o.receipt.item_count_out as i64).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "keeps byte, time and malformed counters structurally zero":
        step("Verify: keeps byte, time and malformed counters structurally zero")
        val o = style_link_with_receipt(_inputs())
        expect(o.receipt.bytes_read as i64).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(o.receipt.bytes_written as i64).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(o.receipt.elapsed_us as i64).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(o.receipt.fallback_count as i64).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(o.receipt.malformed_count as i64).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(o.receipt.overflow_flags as i64).to_equal(0)  # oracle: 0 — named expected value from the requirement

# ----------------------------------------------------------------------------
# 4. Determinism — identical input, identical receipt hashes
# ----------------------------------------------------------------------------

describe "style_link_receipts determinism":
    it "produces byte-identical collect receipt hashes across two runs":
        step("Verify: produces byte-identical collect receipt hashes across two runs")
        val a = style_collect_records_with_receipt(_inputs())
        val b = style_collect_records_with_receipt(_inputs())
        expect(a.receipt.input_root.value).to_equal(b.receipt.input_root.value)
        expect(a.receipt.output_root.value).to_equal(b.receipt.output_root.value)
        expect(a.receipt.deterministic_hash.value).to_equal(b.receipt.deterministic_hash.value)

    it "produces byte-identical resolve and link receipt hashes across two runs":
        step("Verify: produces byte-identical resolve and link receipt hashes across two runs")
        val c = style_collect_records_with_receipt(_inputs())
        val ra = style_resolve_with_receipt(c.defs, c.refs)
        val rb = style_resolve_with_receipt(c.defs, c.refs)
        expect(ra.receipt.deterministic_hash.value).to_equal(rb.receipt.deterministic_hash.value)
        val ka = style_link_with_receipt(_inputs())
        val kb = style_link_with_receipt(_inputs())
        expect(ka.receipt.input_root.value).to_equal(kb.receipt.input_root.value)
        expect(ka.receipt.output_root.value).to_equal(kb.receipt.output_root.value)
        expect(ka.receipt.deterministic_hash.value).to_equal(kb.receipt.deterministic_hash.value)

# ----------------------------------------------------------------------------
# 5. Sensitivity — the roots are content hashes
# ----------------------------------------------------------------------------

describe "style_link_receipts sensitivity":
    it "moves every collect hash when one symbol is renamed":
        step("Verify: moves every collect hash when one symbol is renamed")
        val a = style_collect_records_with_receipt(_inputs())
        val b = style_collect_records_with_receipt(_renamed_inputs())
        expect(a.receipt.input_root.value != b.receipt.input_root.value).to_be(true)
        expect(a.receipt.output_root.value != b.receipt.output_root.value).to_be(true)
        expect(a.receipt.deterministic_hash.value != b.receipt.deterministic_hash.value).to_be(true)

    it "moves every link hash when one symbol is renamed":
        step("Verify: moves every link hash when one symbol is renamed")
        val a = style_link_with_receipt(_inputs())
        val b = style_link_with_receipt(_renamed_inputs())
        expect(a.receipt.input_root.value != b.receipt.input_root.value).to_be(true)
        expect(a.receipt.output_root.value != b.receipt.output_root.value).to_be(true)
        expect(a.receipt.deterministic_hash.value != b.receipt.deterministic_hash.value).to_be(true)
