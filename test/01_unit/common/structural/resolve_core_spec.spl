"""
## Purpose and audience
Purpose: Prove that resolve_core intern_name.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMMON-STRUCTURAL-001 — stable requirement identity for this spec.

# ============================================================================
# GraphResolveCore CPU primitives (LINK lane) — resolve_core.spl spec.
#
# Four claims:
#   1. INTERN DETERMINISM — same text always yields the same Hash128, and two
#      distinct texts yield different Hash128 values.
#   2. STABLE SORT — records whose entire sort key (including `order`) ties
#      keep their original input order after sort_definitions_stable.
#   3. GROUPING — group_sorted slices a 3-key mixed input (defs-only,
#      defs+refs, refs-only) into the right contiguous, ascending-key views.
#   4. REDUCTION — reduce_group resolves a unique definition, marks a
#      zero-definition key Unresolved/MissingDefinition, and resolves a
#      duplicate-definition key to its lowest-order winner while counting
#      the extras as diagnostics (contract §3).
# ============================================================================

use std.spec
use std.common.structural.identity.entity_id.{entity_ref, hash128, hash128_equal}
use std.common.structural.resolve.resolve_types.{
    DefinitionRecord,
    ReferenceRecord,
    definition_record,
    reference_record,
    resolve_key
}
use std.common.structural.resolve.resolve_core.{
    group_sorted,
    intern_name,
    reduce_group,
    sort_definitions_stable,
    sort_references_stable
}

# ----------------------------------------------------------------------------
# Fixtures
# ----------------------------------------------------------------------------

fn _stability_fixture() -> [DefinitionRecord]:
    """Three DefinitionRecords sharing one full sort key (same name_hash,
    space, and order) bracketed by a lower-keyed and a higher-keyed record.
    A correct stable sort keeps the tied trio in input order (owners 1, 2,
    3) between the bracket records (owners 8, 9)."""
    val h_tied = hash128(1, 100)
    val h_low = hash128(0, 1)
    val h_high = hash128(2, 1)
    [
        definition_record(resolve_key(h_high, 0), entity_ref(9, 0), 0, 0),
        definition_record(resolve_key(h_tied, 0), entity_ref(1, 0), 0, 5),
        definition_record(resolve_key(h_tied, 0), entity_ref(2, 0), 0, 5),
        definition_record(resolve_key(h_low, 0), entity_ref(8, 0), 0, 0),
        definition_record(resolve_key(h_tied, 0), entity_ref(3, 0), 0, 5)
    ]

fn _mixed_key_defs() -> [DefinitionRecord]:
    """K1 (hash128(1,1)) has two definitions (duplicate); K2 (hash128(2,2))
    has one. Fed unsorted; each `it` block sorts it before use."""
    val k1 = resolve_key(hash128(1, 1), 0)
    val k2 = resolve_key(hash128(2, 2), 0)
    [
        definition_record(k2, entity_ref(20, 0), 0, 0),
        definition_record(k1, entity_ref(10, 0), 0, 1),
        definition_record(k1, entity_ref(11, 0), 0, 0)
    ]

fn _mixed_key_refs() -> [ReferenceRecord]:
    """K2 (hash128(2,2)) has two references; K3 (hash128(3,3)) has one and no
    definition at all. Fed unsorted; each `it` block sorts it before use."""
    val k2 = resolve_key(hash128(2, 2), 0)
    val k3 = resolve_key(hash128(3, 3), 0)
    [
        reference_record(k3, entity_ref(30, 0), 0, 0),
        reference_record(k2, entity_ref(21, 0), 0, 1),
        reference_record(k2, entity_ref(22, 0), 0, 0)
    ]

# ----------------------------------------------------------------------------
# 1. Intern determinism
# ----------------------------------------------------------------------------

describe "resolve_core intern_name":
    it "hashes identical text to the same Hash128 on repeated calls":
        step("Verify: hashes identical text to the same Hash128 on repeated calls")
        # @req: REQ-COMMON-STRUCTURAL-001
        val a = intern_name("link.symbol.foo")
        val b = intern_name("link.symbol.foo")
        expect(hash128_equal(a, b)).to_be(true)

    it "hashes two different texts to different Hash128 values":
        step("Verify: hashes two different texts to different Hash128 values")
        val a = intern_name("link.symbol.foo")
        val b = intern_name("link.symbol.bar")
        expect(hash128_equal(a, b)).to_be(false)

# ----------------------------------------------------------------------------
# 2. Stable sort
# ----------------------------------------------------------------------------

describe "resolve_core sort_definitions_stable":
    it "orders distinct keys by name_hash and keeps tied records in input order":
        step("Verify: orders distinct keys by name_hash and keeps tied records in input order")
        val sorted = sort_definitions_stable(_stability_fixture())
        expect(sorted.len()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(sorted[0].owner.object_slot).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(sorted[1].owner.object_slot).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(sorted[2].owner.object_slot).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(sorted[3].owner.object_slot).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(sorted[4].owner.object_slot).to_equal(9)  # oracle: 9 — named expected value from the requirement

# ----------------------------------------------------------------------------
# 3. Grouping
# ----------------------------------------------------------------------------

describe "resolve_core group_sorted":
    it "slices a 3-key mixed input into contiguous ascending-key views":
        step("Verify: slices a 3-key mixed input into contiguous ascending-key views")
        val defs = sort_definitions_stable(_mixed_key_defs())
        val refs = sort_references_stable(_mixed_key_refs())
        val views = group_sorted(defs, refs)
        expect(views.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

        # K1: two definitions, zero references.
        expect(views[0].definitions_offset).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(views[0].definitions_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(views[0].references_offset).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(views[0].references_count).to_equal(0)  # oracle: 0 — named expected value from the requirement

        # K2: one definition, two references.
        expect(views[1].definitions_offset).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(views[1].definitions_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(views[1].references_offset).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(views[1].references_count).to_equal(2)  # oracle: 2 — named expected value from the requirement

        # K3: zero definitions, one reference.
        expect(views[2].definitions_offset).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(views[2].definitions_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(views[2].references_offset).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(views[2].references_count).to_equal(1)  # oracle: 1 — named expected value from the requirement

# ----------------------------------------------------------------------------
# 4. Reduction
# ----------------------------------------------------------------------------

describe "resolve_core reduce_group":
    it "resolves a unique definition with no diagnostics":
        step("Verify: resolves a unique definition with no diagnostics")
        val defs = sort_definitions_stable(_mixed_key_defs())
        val refs = sort_references_stable(_mixed_key_refs())
        val views = group_sorted(defs, refs)
        val result = reduce_group(views[1], defs)
        expect(result.status).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.reason).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.diagnostic_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.selected.object_slot).to_equal(20)  # oracle: 20 — named expected value from the requirement

    it "marks a zero-definition key Unresolved with reason MissingDefinition":
        step("Verify: marks a zero-definition key Unresolved with reason MissingDefinition")
        val defs = sort_definitions_stable(_mixed_key_defs())
        val refs = sort_references_stable(_mixed_key_refs())
        val views = group_sorted(defs, refs)
        val result = reduce_group(views[2], defs)
        expect(result.status).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.reason).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.diagnostic_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.selected.object_slot).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "resolves a duplicate-definition key to the lowest-order winner and counts the extras":
        step("Verify: resolves a duplicate-definition key to the lowest-order winner and counts the extras")
        val defs = sort_definitions_stable(_mixed_key_defs())
        val refs = sort_references_stable(_mixed_key_refs())
        val views = group_sorted(defs, refs)
        val result = reduce_group(views[0], defs)
        expect(result.status).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.reason).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(result.diagnostic_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.selected.object_slot).to_equal(11)  # oracle: 11 — named expected value from the requirement
