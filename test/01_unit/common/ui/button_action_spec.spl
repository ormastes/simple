use std.spec
use common.ui.builder.{build_tree, button, column, with_height}
use common.ui.event.{process_event}
use common.ui.widget.{UIEvent, UIState}

describe "button action dispatch":
    it "emits one pending action from pointer and keyboard activation":
        val tree = build_tree(column("root", [
            with_height(button("play", "Play", "wm-demo.click"), 32)
        ]))
        var state = UIState.new(tree)
        state = process_event(state, UIEvent.Resize(120, 40))
        state = process_event(
            state,
            UIEvent.MouseEvent(10.0, 10.0, "left", "down")
        )
        val play = tree.find_widget("play")
        expect(play.get_prop("ui_action_pending")).to_equal("true")

        play.set_prop("ui_action_pending", "false")
        state = process_event(state, UIEvent.FocusEvent("play", "focus"))
        state = process_event(state, UIEvent.KeyPress("enter"))
        expect(play.get_prop("ui_action_pending")).to_equal("true")
