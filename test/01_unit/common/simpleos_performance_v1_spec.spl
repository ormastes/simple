"""
## Purpose and audience
Purpose: Verify SimpleOS canonical performance admission v1.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
Troubleshooting: a red scenario here means the pinned contract changed —
check verification guidance in the linked design docs before editing oracles.
# @manual: primary
REQ-GEN-COMMON-001
doc/01_research/local/REQ-GEN-COMMON-001.md
doc/03_plan/sys_test/REQ-GEN-COMMON-001.md
doc/04_architecture/REQ-GEN-COMMON-001.md
doc/05_design/REQ-GEN-COMMON-001.md
"""
# @req: REQ-GEN-COMMON-001

# @codex-impl
# @req REQ-018 NFR-002 NFR-003 NFR-005 NFR-009

use std.spec.*
use common.contracts.execution.simpleos_performance_v1.*

val FIXTURE_HASH: text = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
val BINARY_HASH: text = "1123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
val IMAGE_HASH: text = "2123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
val CONFIG_HASH: text = "3123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
val BASELINE_HASH: text = "4123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn stable_samples(value: u64) -> [u64]:
    [value, value, value, value, value, value, value, value, value, value]

fn evidence_for(
    workload: SimpleOsPerformanceWorkloadV1,
    samples: [u64]
) -> SimpleOsPerformanceEvidenceV1:
    SimpleOsPerformanceEvidenceV1(
        budget: simpleos_performance_canonical_budget(workload, 1000000u64),
        samples: samples,
        rss_samples: stable_samples(100000u64),
        warmup_samples: 2u64,
        cpu_identity: "cpu-model",
        frequency_identity: "fixed-3200mhz",
        noise_identity: "isolated-cpu",
        fixture_hash: FIXTURE_HASH,
        binary_hash: BINARY_HASH,
        image_hash: IMAGE_HASH,
        config_hash: CONFIG_HASH,
        accelerator_identity: "none",
        baseline_identity_hash: BASELINE_HASH,
        artifact_hashes: [FIXTURE_HASH, BINARY_HASH, IMAGE_HASH, CONFIG_HASH,
                          BASELINE_HASH],
        host: SimpleOsPerformanceHostV1.Native,
        comparable_baseline: true,
        baseline_value: samples[0],
        max_rss_bytes: 100000u64,
        baseline_rss_bytes: 100000u64)

use std.spec.step

describe "SimpleOS canonical performance admission v1":
    it "admits stable native evidence and computes nearest-rank percentiles":
        # @req: REQ-018
        step("Verify: admits stable native evidence and computes nearest-rank percentiles")
        val samples = [105u64, 96u64, 104u64, 97u64, 103u64, 98u64, 102u64, 99u64, 101u64, 100u64]
        var evidence = evidence_for(SimpleOsPerformanceWorkloadV1.WarmServerStartup, samples)
        evidence.baseline_value = 105u64
        val result = simpleos_performance_admit(evidence)
        expect(result.ok).to_be(true)
        expect(result.stats.p50).to_equal(100u64)  # oracle: 100u64 — named expected value from the requirement
        expect(result.stats.p95).to_equal(105u64)  # oracle: 105u64 — named expected value from the requirement
        expect(result.stats.p99).to_equal(105u64)  # oracle: 105u64 — named expected value from the requirement
        expect(result.stats.max).to_equal(105u64)  # oracle: 105u64 — named expected value from the requirement
        expect(result.stats.max_rss_bytes).to_equal(100000u64)  # oracle: 100000u64 — named expected value from the requirement
        expect(result.admitted_value).to_equal(105u64)  # oracle: 105u64 — named expected value from the requirement
        expect(samples[0]).to_equal(105u64)  # oracle: 105u64 — named expected value from the requirement

    it "binds every selected NFR budget to its exact unit percentile and limit":
        # @req: REQ-GEN-COMMON-001
        step("Verify: binds every selected NFR budget to its exact unit percentile and limit")
        expect(simpleos_performance_canonical_budget(SimpleOsPerformanceWorkloadV1.WarmServerStartup, 1u64).limit).to_equal(125000u64)  # oracle: 125000u64 — named expected value from the requirement
        expect(simpleos_performance_canonical_budget(SimpleOsPerformanceWorkloadV1.HttpDbLoopback, 1u64).limit).to_equal(5000u64)  # oracle: 5000u64 — named expected value from the requirement
        expect(simpleos_performance_canonical_budget(SimpleOsPerformanceWorkloadV1.SshEstablish, 1u64).limit).to_equal(125000u64)  # oracle: 125000u64 — named expected value from the requirement
        expect(simpleos_performance_canonical_budget(SimpleOsPerformanceWorkloadV1.WindowManagerFirstFrame, 1u64).limit).to_equal(250000u64)  # oracle: 250000u64 — named expected value from the requirement
        expect(simpleos_performance_canonical_budget(SimpleOsPerformanceWorkloadV1.InputToPresent, 1u64).limit).to_equal(25000u64)  # oracle: 25000u64 — named expected value from the requirement
        val frame = simpleos_performance_canonical_budget(SimpleOsPerformanceWorkloadV1.WindowManagerSteadyFrame, 1u64)
        expect(frame.admission_percentile).to_equal(99u64)  # oracle: 99u64 — named expected value from the requirement
        expect(frame.limit).to_equal(16700u64)  # oracle: 16700u64 — named expected value from the requirement
        expect(simpleos_performance_canonical_budget(SimpleOsPerformanceWorkloadV1.FsMetadata, 1u64).limit).to_equal(2500u64)  # oracle: 2500u64 — named expected value from the requirement
        val throughput = simpleos_performance_canonical_budget(SimpleOsPerformanceWorkloadV1.FsSequentialThroughput, 1u64)
        expect(throughput.unit).to_equal(SimpleOsPerformanceUnitV1.BytesPerSecond)
        expect(throughput.direction).to_equal(SimpleOsPerformanceDirectionV1.HigherIsBetter)
        expect(throughput.admission_percentile).to_equal(50u64)  # oracle: 50u64 — named expected value from the requirement
        expect(throughput.limit).to_equal(104857600u64)  # oracle: 104857600u64 — named expected value from the requirement
        expect(simpleos_performance_canonical_budget(SimpleOsPerformanceWorkloadV1.SimpleCompileRun, 1u64).limit).to_equal(2500000u64)  # oracle: 2500000u64 — named expected value from the requirement
        expect(simpleos_performance_canonical_budget(SimpleOsPerformanceWorkloadV1.CCompileLinkRun, 1u64).limit).to_equal(2500000u64)  # oracle: 2500000u64 — named expected value from the requirement

    it "rejects too few samples and all non-native timing evidence":
        # @req: REQ-018
        step("Verify: rejects too few samples and all non-native timing evidence")
        var evidence = evidence_for(SimpleOsPerformanceWorkloadV1.WarmServerStartup, [10u64, 10u64])
        expect(simpleos_performance_admit(evidence).error).to_equal(SimpleOsPerformanceErrorV1.TooFewSamples)
        evidence = evidence_for(SimpleOsPerformanceWorkloadV1.WarmServerStartup, stable_samples(100u64))
        evidence.host = SimpleOsPerformanceHostV1.QemuKvm
        expect(simpleos_performance_admit(evidence).error).to_equal(SimpleOsPerformanceErrorV1.NonNativeCannotPass)
        evidence.host = SimpleOsPerformanceHostV1.QemuTcg
        expect(simpleos_performance_admit(evidence).error).to_equal(SimpleOsPerformanceErrorV1.NonNativeCannotPass)

    it "rejects weakened budgets and noncanonical hashes":
        # @req: REQ-GEN-COMMON-001
        step("Verify: rejects weakened budgets and noncanonical hashes")
        var evidence = evidence_for(SimpleOsPerformanceWorkloadV1.WarmServerStartup, stable_samples(100u64))
        var changed_budget = evidence.budget
        changed_budget.limit = 999999u64
        evidence.budget = changed_budget
        expect(simpleos_performance_admit(evidence).error).to_equal(SimpleOsPerformanceErrorV1.InvalidBudget)
        evidence = evidence_for(SimpleOsPerformanceWorkloadV1.WarmServerStartup, stable_samples(100u64))
        evidence.fixture_hash = "0123456789ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef"
        expect(simpleos_performance_admit(evidence).error).to_equal(SimpleOsPerformanceErrorV1.InvalidHash)
        evidence = evidence_for(SimpleOsPerformanceWorkloadV1.WarmServerStartup, stable_samples(100u64))
        evidence.binary_hash = "bad"
        expect(simpleos_performance_admit(evidence).error).to_equal(SimpleOsPerformanceErrorV1.InvalidHash)

    it "rejects noisy, absolute-budget, and direction-aware regression failures":
        # @req: REQ-018
        step("Verify: rejects noisy, absolute-budget, and direction-aware regression failures")
        var evidence = evidence_for(SimpleOsPerformanceWorkloadV1.WarmServerStartup, [1u64, 1u64, 1u64, 1u64, 1u64, 100u64, 100u64, 100u64, 100u64, 100u64])
        expect(simpleos_performance_admit(evidence).error).to_equal(SimpleOsPerformanceErrorV1.NoisySamples)
        evidence = evidence_for(SimpleOsPerformanceWorkloadV1.FsMetadata, stable_samples(3000u64))
        evidence.baseline_value = 3000u64
        expect(simpleos_performance_admit(evidence).error).to_equal(SimpleOsPerformanceErrorV1.AbsoluteBudgetExceeded)
        evidence = evidence_for(SimpleOsPerformanceWorkloadV1.WarmServerStartup, stable_samples(106u64))
        evidence.baseline_value = 100u64
        expect(simpleos_performance_admit(evidence).error).to_equal(SimpleOsPerformanceErrorV1.Regression)
        evidence = evidence_for(SimpleOsPerformanceWorkloadV1.FsSequentialThroughput, stable_samples(104857600u64))
        evidence.baseline_value = 120000000u64
        expect(simpleos_performance_admit(evidence).error).to_equal(SimpleOsPerformanceErrorV1.Regression)

    it "admits exact five-percent CV and rejects a just-over boundary":
        # @req: REQ-GEN-COMMON-001
        step("Verify: admits exact five-percent CV and rejects a just-over boundary")
        var evidence = evidence_for(
            SimpleOsPerformanceWorkloadV1.WarmServerStartup,
            [950u64, 1050u64, 950u64, 1050u64, 950u64, 1050u64, 950u64, 1050u64, 950u64, 1050u64])
        evidence.baseline_value = 1050u64
        val exact = simpleos_performance_admit(evidence)
        expect(exact.ok).to_be(true)
        expect(exact.stats.cv_basis_points).to_equal(500u64)  # oracle: 500u64 — named expected value from the requirement
        evidence = evidence_for(
            SimpleOsPerformanceWorkloadV1.WarmServerStartup,
            [950u64, 1050u64, 950u64, 1050u64, 949u64, 1051u64, 949u64, 1051u64, 949u64, 1051u64])
        evidence.baseline_value = 1051u64
        expect(simpleos_performance_admit(evidence).error).to_equal(SimpleOsPerformanceErrorV1.NoisySamples)

    it "rejects missing, zero, or summary-mismatched raw RSS evidence":
        # @req: REQ-018
        step("Verify: rejects missing, zero, or summary-mismatched raw RSS evidence")
        var evidence = evidence_for(SimpleOsPerformanceWorkloadV1.WarmServerStartup, stable_samples(100u64))
        evidence.rss_samples = [100000u64]
        expect(simpleos_performance_admit(evidence).error).to_equal(SimpleOsPerformanceErrorV1.InvalidSample)
        evidence = evidence_for(SimpleOsPerformanceWorkloadV1.WarmServerStartup, stable_samples(100u64))
        var zero_rss = stable_samples(100000u64)
        zero_rss[4] = 0u64
        evidence.rss_samples = zero_rss
        expect(simpleos_performance_admit(evidence).error).to_equal(SimpleOsPerformanceErrorV1.InvalidSample)
        evidence = evidence_for(SimpleOsPerformanceWorkloadV1.WarmServerStartup, stable_samples(100u64))
        var mismatched_rss = stable_samples(100000u64)
        mismatched_rss[9] = 100001u64
        evidence.rss_samples = mismatched_rss
        expect(simpleos_performance_admit(evidence).error).to_equal(SimpleOsPerformanceErrorV1.NonComparable)

    it "rejects campaign identities absent from the bounded verified artifact set":
        # @req: REQ-GEN-COMMON-001
        step("Verify: rejects campaign identities absent from the bounded verified artifact set")
        var evidence = evidence_for(SimpleOsPerformanceWorkloadV1.WarmServerStartup, stable_samples(100u64))
        evidence.artifact_hashes = [FIXTURE_HASH, BINARY_HASH, IMAGE_HASH,
                                    BASELINE_HASH]
        expect(simpleos_performance_admit(evidence).error).to_equal(SimpleOsPerformanceErrorV1.NonComparable)
        evidence = evidence_for(SimpleOsPerformanceWorkloadV1.WarmServerStartup, stable_samples(100u64))
        evidence.artifact_hashes = [FIXTURE_HASH, BINARY_HASH, IMAGE_HASH,
                                    CONFIG_HASH, BASELINE_HASH, CONFIG_HASH]
        expect(simpleos_performance_admit(evidence).error).to_equal(SimpleOsPerformanceErrorV1.NonComparable)

    it "fails closed on arithmetic overflow":
        # @req: REQ-018
        step("Verify: fails closed on arithmetic overflow")
        var evidence = evidence_for(SimpleOsPerformanceWorkloadV1.WarmServerStartup, stable_samples(18446744073709551615u64))
        evidence.baseline_value = 18446744073709551615u64
        expect(simpleos_performance_admit(evidence).error).to_equal(SimpleOsPerformanceErrorV1.Overflow)

    it "admits exactly five percent and rejects beyond it for both directions and RSS":
        # @req: REQ-GEN-COMMON-001
        step("Verify: admits exactly five percent and rejects beyond it for both directions and RSS")
        var latency = evidence_for(SimpleOsPerformanceWorkloadV1.WarmServerStartup, stable_samples(105u64))
        latency.baseline_value = 100u64
        expect(simpleos_performance_admit(latency).ok).to_be(true)
        latency = evidence_for(SimpleOsPerformanceWorkloadV1.WarmServerStartup, stable_samples(106u64))
        latency.baseline_value = 100u64
        expect(simpleos_performance_admit(latency).error).to_equal(SimpleOsPerformanceErrorV1.Regression)
        var throughput = evidence_for(SimpleOsPerformanceWorkloadV1.FsSequentialThroughput, stable_samples(114000000u64))
        throughput.baseline_value = 120000000u64
        expect(simpleos_performance_admit(throughput).ok).to_be(true)
        throughput = evidence_for(SimpleOsPerformanceWorkloadV1.FsSequentialThroughput, stable_samples(113999999u64))
        throughput.baseline_value = 120000000u64
        expect(simpleos_performance_admit(throughput).error).to_equal(SimpleOsPerformanceErrorV1.Regression)
        latency = evidence_for(SimpleOsPerformanceWorkloadV1.WarmServerStartup, stable_samples(100u64))
        latency.baseline_rss_bytes = 100u64
        latency.max_rss_bytes = 105u64
        expect(simpleos_performance_admit(latency).ok).to_be(true)
        latency.max_rss_bytes = 106u64
        expect(simpleos_performance_admit(latency).error).to_equal(SimpleOsPerformanceErrorV1.Regression)
