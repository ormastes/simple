# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-RUNTIME
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Module @init and @teardown spec
#
# Tests for @init and @teardown annotation scanning in the annotation scanner.
# Note: Since interpreter mode doesn't re-execute the annotated file,
# we test the annotation detection mechanism.

use std.spec.step

describe "@init and @teardown annotations":
    # @manual scenario evidence
    it "annotated functions can be defined":
        # @req REQ-SSPEC-RUNTIME
        step("annotated functions can be defined")
        # @init
        fn my_init():
            0

        # @teardown
        fn my_teardown():
            0

        expect(my_init()).to_equal(0)
        expect(my_teardown()).to_equal(0)

    it "functions can be called manually if annotated":
        # @req REQ-SSPEC-RUNTIME
        step("functions can be called manually if annotated")
        # NOTE: var mutation inside nested closure doesn't persist in interpreter.
        # Test the concept by checking the function is callable.
        fn setup_module() -> i64:
            1

        val result = setup_module()
        expect(result).to_equal(1)
