use std.io_runtime.{file_read}

use std.spec.step

describe "simple-core char_code_at handle validation":
    it "validates managed strings before dereferencing their header":
        step("keeps raw ASCII pointers on the C-string fallback path")
        val source = file_read("src/runtime/simple_core/core_string.spl")
        val start = source.find("pub fn rt_string_char_code_at(value: i64, index: i64) -> i64:") ?? -1
        val finish = source.find("pub fn __simple_rt_string_char_code_at(value: i64, index: i64) -> i64:") ?? -1
        val body = if start >= 0 and finish > start: source.substring(start, finish) else: ""
        expect(body).to_contain("val ptr = registered_string_ptr(value)")
        expect(body.contains("val ptr = string_ptr(value)")).to_be(false)
        expect(body).to_contain("if ptr > 0:")
        expect(body).to_contain("else:\n        if value < 1:")
