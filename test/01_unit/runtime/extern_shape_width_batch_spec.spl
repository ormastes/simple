# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-RUNTIME
#
# Extern return-shape canonicalisation, batch 12 (fixed-width reads).
# Canonical shape is the NARROW type named by each function (u8/u16/u32/u64;
# CR2/CR3 are u64): a C `uint8_t` return only defines the low bits of the
# return register, so an import declared i64 reads garbage high bits. The
# codegen side is pinned by runtime_sffi.rs `runtime_h_narrow_int_returns_use_narrow_abi`.
use std.io_runtime.{file_read_text}

describe "extern return shapes: batch 12 fixed-width reads":
    it "volatile_ops declares the narrow runtime returns and widens in the wrapper":
        val src = file_read_text("src/lib/nogc_sync_mut/io/volatile_ops.spl") ?? ""
        expect(src).to_contain("extern fn rt_volatile_read_u8(addr: i64) -> u8")
        expect(src).to_contain("extern fn rt_volatile_read_u16(addr: i64) -> u16")
        expect(src).to_contain("extern fn rt_volatile_read_u32(addr: i64) -> u32")
        expect(src).to_contain("extern fn rt_volatile_read_u64(addr: i64) -> u64")
        expect(src).to_contain("(rt_volatile_read_u8(addr) as i64)")

    it "the C runtime header returns the narrow widths":
        val h = file_read_text("src/runtime/runtime.h") ?? ""
        expect(h).to_contain("uint8_t  rt_volatile_read_u8(int64_t addr);")
        expect(h).to_contain("uint16_t rt_volatile_read_u16(int64_t addr);")
        expect(h).to_contain("uint32_t rt_volatile_read_u32(int64_t addr);")
        expect(h).to_contain("uint64_t rt_volatile_read_u64(int64_t addr);")
