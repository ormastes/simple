# @cover src/lib/nogc_sync_mut/sffi/host.spl
# Real process-local counters require a matching admitted runtime provider.
use std.spec.{describe, it, expect, step}
use std.nogc_sync_mut.sffi.host.{heap_alloc_count, heap_array_capacity_bytes}

describe "process-local collection counters":
    it "observes actual collection allocation and capacity through the safe facade":
        step("Allocate and grow an actual array before observing counters")
        val allocation_before = heap_alloc_count()
        val capacity_before = heap_array_capacity_bytes()
        var values = [11, 12, 13, 14]
        values.push(15)
        val allocation_after = heap_alloc_count()
        val capacity_after = heap_array_capacity_bytes()
        expect(values.len()).to_equal(5)
        expect(values[0]).to_equal(11)
        expect(values[4]).to_equal(15)
        expect(allocation_after).to_be_greater_than(allocation_before)
        expect(capacity_after).to_be_greater_than(capacity_before)
