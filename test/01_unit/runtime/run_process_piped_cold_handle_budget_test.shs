#!/bin/sh
# Windows-only: piped-process cold-start handle budget (exit 77 = skipped elsewhere).
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
test_dir=$(mktemp -d)
trap 'rm -rf "$test_dir"' EXIT HUP INT TERM
clang -O2 -std=gnu11 -Wall -Wextra -I "$repo_root/src/runtime" \
    "$repo_root/test/01_unit/runtime/process_piped_cold_handle_budget_test.c" \
    "$repo_root/src/runtime/runtime_process.c" -lpsapi \
    -o "$test_dir/cb.exe"
"$test_dir/cb.exe"
