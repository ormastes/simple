# rt_shell_exec / rt_shell_exit_code / rt_shell_exec_tuple — interpreter dispatch spec
#
# Before this landed, `rt_shell_exec` was declared by ~54 real call sites
# (test_daemon adapters, T32 hardware helpers, the terminal/power stack) but
# had zero implementation anywhere in the tree -- not a C definition, not a
# Rust match arm. Every one of those call sites failed with
# "semantic: unknown extern function: rt_shell_exec" the moment it ran.
# See doc/08_tracking/bug/interpreter_extern_unreachable_names.md bucket (c).
#
# Two incompatible conventions exist for the same bare extern name across the
# tree:
#   - `rt_shell_exec(cmd) -> text` + a separate `rt_shell_exit_code() -> i64`
#     getter (the majority: test_daemon/adapters/*.spl, t32_hw_helpers.spl).
#   - `rt_shell_exec(cmd) -> (text, text, i64)` (the terminal/power stack:
#     relay_terminal.spl, host_power.spl, relay_power.spl).
# The interpreter's extern dispatch table is keyed by bare name only, so one
# name cannot serve both return shapes. This spec keeps the majority
# convention under the original `rt_shell_exec` name (zero caller edits for
# ~43 real call sites) and registers the tuple convention under a distinct
# name, `rt_shell_exec_tuple`, which the 3 terminal/power files were updated
# to call instead.

"""
## Purpose and audience
Purpose: runs a real shell command and captures stdout as text
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-RUNTIME-ShelExecExteDisp-001

extern fn rt_shell_exec(cmd: text) -> text
extern fn rt_shell_exit_code() -> i64
extern fn rt_shell_exec_tuple(cmd: text) -> (text, text, i64)

use std.spec.{describe, it, expect}

use std.spec.step
describe "rt_shell_exec interpreter dispatch":
    it "runs a real shell command and captures stdout as text":
        step("Verify: runs a real shell command and captures stdout as text")
        # @req: REQ-RUNTIME-ShelExecExteDisp-001
        val out = rt_shell_exec("echo hello_from_shell_exec")
        expect(out.trim()).to_equal("hello_from_shell_exec")

    it "rt_shell_exit_code reflects the exit code of the last rt_shell_exec call":
        step("Verify: rt_shell_exit_code reflects the exit code of the last rt_shell_exec call")
        # @req: REQ-RUNTIME-ShelExecExteDisp-001
        rt_shell_exec("exit 0")
        expect(rt_shell_exit_code()).to_equal(0)  # oracle: value fixed by the spec contract
        rt_shell_exec("exit 7")
        expect(rt_shell_exit_code()).to_equal(7)  # oracle: value fixed by the spec contract

    it "honors real shell metacharacters (pipes, redirection) -- not argv-literal":
        step("Verify: honors real shell metacharacters (pipes, redirection) -- not argv-literal")
        # @req: REQ-RUNTIME-ShelExecExteDisp-001
        # Real callers (container_adapter.spl) depend on this, e.g.
        # `rt_shell_exec("{rt} inspect ... 2>/dev/null")`.
        val out = rt_shell_exec("echo one; echo two 1>&2 2>/dev/null")
        expect(out.trim()).to_equal("one")

describe "rt_shell_exec_tuple interpreter dispatch":
    it "returns stdout, stderr, and exit code as one atomic 3-tuple":
        step("Verify: returns stdout, stderr, and exit code as one atomic 3-tuple")
        # @req: REQ-RUNTIME-ShelExecExteDisp-001
        val (stdout, stderr, exit_code) = rt_shell_exec_tuple("printf out_val; printf err_val 1>&2; exit 3")
        expect(stdout).to_equal("out_val")
        expect(stderr).to_equal("err_val")
        expect(exit_code).to_equal(3)  # oracle: value fixed by the spec contract

    it "reports exit code 0 for a successful command":
        step("Verify: reports exit code 0 for a successful command")
        # @req: REQ-RUNTIME-ShelExecExteDisp-001
        val (stdout, stderr, exit_code) = rt_shell_exec_tuple("echo ok")
        expect(stdout.trim()).to_equal("ok")
        expect(exit_code).to_equal(0)  # oracle: value fixed by the spec contract
