#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

cat >"$tmp/main.c" <<'EOF'
#include <stdint.h>
#include <stdio.h>
#include <string.h>

int64_t rt_value_int(int64_t);
int64_t rt_value_float(double);
int64_t rt_string_new(const uint8_t*, uint64_t);
int64_t rt_value_format_string(int64_t, const uint8_t*, uint64_t);
int64_t rt_string_len(int64_t);
const uint8_t* rt_string_data(int64_t);

static int expect_span(int64_t value, const char* spec, uint64_t spec_len,
                       const char* expected) {
    int64_t out = rt_value_format_string(value, (const uint8_t*)spec, spec_len);
    int64_t len = rt_string_len(out);
    return len == (int64_t)strlen(expected) && memcmp(rt_string_data(out), expected, (size_t)len) == 0;
}

static int expect_text(int64_t value, const char* spec, const char* expected) {
    return expect_span(value, spec, strlen(spec), expected);
}

int main(void) {
    static const char long_digits[] =
        "9999999999999999999999999999999999999999999999999999999999999999";
    int64_t text = rt_string_new((const uint8_t*)"hello", 5);
    if (!expect_text(rt_value_int(42), "04x", "002a")) return 1;
    if (!expect_text(rt_value_float(3.5), ".1f", "3.5")) return 2;
    if (!expect_text(text, "s", "hello")) return 3;
    if (!expect_text(3, "", "nil")) return 4;
    if (!expect_text(27, "", "error")) return 5;
    if (!expect_span(rt_value_int(42), NULL, 64, "42")) return 6;
    if (!expect_text(rt_value_int(42), long_digits, "42")) return 7;
    puts("PASS: tagged value format string runtime");
    return 0;
}
EOF

${CC:-cc} ${CFLAGS:-} -std=c11 -O0 -ffunction-sections -fdata-sections \
    "$root/src/runtime/runtime_native.c" "$tmp/main.c" \
    -Wl,--gc-sections -ldl -lm -lpthread -o "$tmp/value-format-test"
"$tmp/value-format-test"
