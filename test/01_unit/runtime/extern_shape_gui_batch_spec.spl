# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-RUNTIME
#
# Extern return-shape canonicalisation, batch 8 (platform/coverage/GUI/exit).
# doc/08_tracking/bug/seed_jit_extern_return_type_last_wins_2026-11-27.md
#   rt_platform_name    -> text  (never null; "unknown" sentinel)
#   rt_coverage_enabled -> bool  (C + Rust return bool)
#   rt_sdl2_quit / rt_winit_event_free -> bool, rt_exit -> (), rt_gui_fill4 -> u64
use std.sffi.platform.{platform_name_raw}

@unsafe(reason: "raw coverage flag ABI", capabilities: [ffi])
extern fn rt_coverage_enabled() -> bool

describe "extern return shapes: batch 8":
    it "platform_name_raw returns non-empty text without an optional":
        step("the runtime name is plain text")
        expect(platform_name_raw().len() > 0).to_equal(true)

    it "rt_coverage_enabled is a bool":
        step("the flag is exactly true or false")
        val on = unsafe(capabilities: [ffi]):
            rt_coverage_enabled()
        expect(on == true or on == false).to_equal(true)
