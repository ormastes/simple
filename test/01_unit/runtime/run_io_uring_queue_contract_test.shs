#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/simple-io-uring-queue.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

cc -std=c11 -D_GNU_SOURCE -Wall -Wextra -Werror \
    -I"$root/src/runtime/vendor/liburing/include" \
    "$root/test/01_unit/runtime/io_uring_queue_contract_test.c" \
    -o "$build_dir/io_uring_queue_contract_test"
"$build_dir/io_uring_queue_contract_test"
