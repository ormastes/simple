use std.io_runtime.{file_read}

# Source-level guard for arm64_simpleos_target_runtime_missing_enumerate_unwrap_2026-08-14.
# The 2026-08-14 repair made the ARM64 simple-core runtime own
# rt_unwrap_or_trap (core_values.spl) alongside rt_array_enumerate
# (core_array_query.spl), so the retained ARM64 payload links without a
# generated fallback stub. The original evidence (focused archive contract at
# /root/arm_runtime_symbols, 2026-08-14) is session-local; this spec pins the
# source contract so the owners cannot silently disappear again.
# Remaining acceptance (focused AArch64 relocatable link over retained payload
# objects + exact archive exports) still requires an ARM64 build lane.

describe "ARM64 target runtime enumerate/unwrap owners":
    it "core_values.spl owns rt_unwrap_or_trap with Ok/Some unwrap and fail-closed Err/None abort":
        val values = file_read("src/runtime/simple_core/core_values.spl")
        expect(values).to_contain("pub fn rt_unwrap_or_trap(value: i64) -> i64")
        # Option Some payload (ordinal 0 and stable hash) unwraps.
        expect(values).to_contain("if discriminant == 0 or discriminant == 4053299545")
        # Option None (ordinal 1 and stable hash) traps via the target abort owner.
        expect(values).to_contain("if discriminant == 1 or discriminant == 2371748697")
        expect(values).to_contain("_sffi_core_values_abort()")
        # Result Ok (hash) unwraps; Result Err (hash) traps.
        expect(values).to_contain("if discriminant == 2405352012")
        expect(values).to_contain("if discriminant == 4200179024")

    it "core_array_query.spl owns rt_array_enumerate":
        val query = file_read("src/runtime/simple_core/core_array_query.spl")
        expect(query).to_contain("pub fn rt_array_enumerate(array: i64) -> i64")
