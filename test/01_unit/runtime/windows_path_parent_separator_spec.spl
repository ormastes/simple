"""
Durable registration for the clang-cl Windows path-parent regression unit.

On Windows this executes the C unit against the real runtime_native.c owner.
Other hosts verify that the registered runner still compiles the production
owner with the test seam and that the root-boundary cases remain in the unit.
"""

use std.spec.{describe, it, expect}

extern fn rt_platform_name() -> text
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_file_read_text(path: text) -> text?

describe "Windows runtime path parent separators":
    it "executes or preserves the clang-cl regression unit":
        val platform = rt_platform_name().lower()
        if platform.contains("win"):
            val (stdout, stderr, code) = rt_process_run(
                "powershell.exe",
                [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "scripts/check/check-windows-runtime-path-parent.ps1",
                ],
            )
            expect(code).to_equal(0)
            expect(stdout).to_contain("windows-path-parent-separator: PASS")
            expect(stderr).to_equal("")
        else:
            val runner = rt_file_read_text(
                "scripts/check/check-windows-runtime-path-parent.ps1",
            ) ?? ""
            val unit = rt_file_read_text(
                "test/01_unit/runtime/windows_path_parent_separator_test.c",
            ) ?? ""
            expect(runner).to_contain("/DSIMPLE_RUNTIME_TESTING")
            expect(runner).to_contain("clang version 23")
            expect(unit).to_contain("expect_parent")
            expect(unit).to_contain("server")
            expect(unit).to_contain("rt_path_parent_is_separator_for_test")
