extern fn rt_file_read_text(path: text) -> text

use std.spec.{describe, it, expect}

# GENERALIZING spec: a `text`-taking runtime extern must use the SAME shape at
# every site -- the C declaration (runtime.h), both platform definitions
# (platform_win.h, unix_common.h), the codegen spec, and the Rust runtime.
#
# Which shape is correct is decided by ONE authority: membership in
# text_arg_indices (src/compiler/50.mir/text_extern_abi.spl and its hand-kept
# Rust twin src/compiler_rust/compiler/src/codegen/instr/calls.rs).
#
#   IN the table  -> `text` splits into a raw (ptr, len) pair  (rt_file_lock)
#   NOT in it     -> `text` collapses to ONE tagged value       (rt_mmap)
#
# Both conventions are live in this codebase, so the shape CANNOT be inferred
# from the `.spl` extern's `path: text` alone -- that is exactly the mistake
# that produced the 2026-09-02 Stage 2 blocker, where rt_mmap had been given
# the (ptr, len) shape it is not registered for. Guessing has a 50% error rate;
# this spec pins the authority and the consequence together.

describe "path-taking extern ABI agreement":
    it "gives rt_mmap the single tagged-value shape, since it is NOT registered":
        val registry = rt_file_read_text("src/compiler/50.mir/text_extern_abi.spl") ?? ""
        val header = rt_file_read_text("src/runtime/runtime.h") ?? ""
        val win = rt_file_read_text("src/runtime/platform/platform_win.h") ?? ""
        val unix_c = rt_file_read_text("src/runtime/platform/unix_common.h") ?? ""

        # Authority: rt_mmap must NOT appear in the split registry.
        expect(registry).to_not_contain("rt_mmap")

        # Consequence: one i64 path handle at all three C sites.
        expect(header).to_contain("int64_t  rt_mmap(int64_t path_value, int64_t size, int64_t offset, int64_t readonly);")
        expect(win).to_contain("int64_t rt_mmap(int64_t path_value, int64_t size, int64_t offset, int64_t readonly) {")
        expect(unix_c).to_contain("int64_t rt_mmap(int64_t path_value, int64_t size, int64_t offset, int64_t readonly) {")

        # The handle is decoded, never dereferenced as a C string.
        expect(win).to_contain("rt_string_data(path_value)")
        expect(unix_c).to_contain("rt_string_data(path_value)")

    it "gives rt_file_lock the (ptr, len) shape, since it IS registered":
        val registry = rt_file_read_text("src/compiler/50.mir/text_extern_abi.spl") ?? ""
        val header = rt_file_read_text("src/runtime/runtime.h") ?? ""
        val win = rt_file_read_text("src/runtime/platform/platform_win.h") ?? ""
        val unix_c = rt_file_read_text("src/runtime/platform/unix_common.h") ?? ""

        # Authority: present in the split registry.
        expect(registry).to_contain("case \"rt_file_lock\":")

        # Consequence: two words for the path at all three C sites.
        expect(header).to_contain("int64_t  rt_file_lock(const uint8_t* path_ptr, uint64_t path_len, int64_t timeout_secs);")
        expect(win).to_contain("int64_t rt_file_lock(const uint8_t* path_ptr, uint64_t path_len, int64_t timeout_secs) {")
        expect(unix_c).to_contain("int64_t rt_file_lock(const uint8_t* path_ptr, uint64_t path_len, int64_t timeout_secs) {")

    it "keeps the pure-Simple registry in lockstep with its Rust twin":
        val registry = rt_file_read_text("src/compiler/50.mir/text_extern_abi.spl") ?? ""
        val twin = rt_file_read_text("src/compiler_rust/compiler/src/codegen/instr/calls.rs") ?? ""
        # rt_file_lock sat in the Rust twin while missing from the pure-Simple
        # table, so stage1-built code emitted TWO words for a THREE-word C
        # function. Drift between these tables is a silent miscompile, not a
        # style issue, so both sides are asserted together.
        expect(twin).to_contain("\"rt_file_lock\" => Some(&[0])")
        expect(registry).to_contain("case \"rt_file_lock\":")

    it "agrees with the codegen spec arity for both functions":
        val spec_rs = rt_file_read_text("src/compiler_rust/compiler/src/codegen/runtime_sffi.rs") ?? ""
        # 4 words: path handle + size + offset + readonly.
        expect(spec_rs).to_contain("RuntimeFuncSpec::new(\"rt_mmap\", &[I64, I64, I64, I64], &[I64]),")
        # 3 words: path ptr + path len + timeout.
        expect(spec_rs).to_contain("RuntimeFuncSpec::new(\"rt_file_lock\", &[I64, I64, I64], &[I64]),")
