#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
io=$root/src/runtime/runtime_core_io_exports.c
host=$root/src/runtime/runtime_core_host_services.c

sed -n '/int64_t rt_term_write(/,/^}/p' "$io" | grep -F '#if defined(_MSC_VER)' >/dev/null
sed -n '/int64_t rt_term_write(/,/^}/p' "$io" | grep -F '_fflush_nolock(stdout)' >/dev/null
grep -F 'static SRWLOCK core_io_stdout_write_lock = SRWLOCK_INIT;' "$io" >/dev/null
sed -n '/int64_t rt_term_write(/,/^}/p' "$io" | grep -F 'AcquireSRWLockExclusive(&core_io_stdout_write_lock)' >/dev/null
sed -n '/int64_t rt_term_write(/,/^}/p' "$io" | grep -F 'if (fd >= 0 && fflush(stdout) == 0)' >/dev/null
sed -n '/int64_t rt_term_write(/,/^}/p' "$io" | grep -F 'ReleaseSRWLockExclusive(&core_io_stdout_write_lock)' >/dev/null

sed -n '/static int spl_topo_find(/,/^}/p' "$host" | grep -F '#if defined(__MINGW32__)' >/dev/null
sed -n '/static int spl_topo_find(/,/^}/p' "$host" | grep -F 'e->NumaNode.GroupMask;' >/dev/null
sed -n '/static int spl_topo_find(/,/^}/p' "$host" | grep -F 'e->NumaNode.GroupMasks[g]' >/dev/null

echo 'PASS Windows core-C MinGW/MSVC source contract'
