"""rt_renderdoc_* honesty contract on a RenderDoc-less host.

RenderDoc's in-application API has exactly one real dynamic export,
RENDERDOC_GetAPI; every other name is macro-trap territory (dlsym binds
NULL). `src/runtime/runtime_renderdoc.c` resolves GetAPI once via dlopen and
must report honest unavailability -- never a fabricated handle, count, or
success flag -- on a host where librenderdoc.so is not resident, which is
the normal case here. This spec is the positive-capability probe: it must
FAIL if any rt_renderdoc_* entry point starts lying about availability.

## Purpose and audience
Purpose: rt_renderdoc_available reports 0 -- RENDERDOC_GetAPI never resolved here
Audience: compiler and tooling engineers who maintain this spec

"""

# @req: REQ-RUNTIME-RendHone-001

use std.spec.{describe, it, expect}

#[runtime_intrinsics]
extern fn rt_renderdoc_available() -> i64
extern fn rt_renderdoc_set_capture_file_path_template(path: text) -> i64
extern fn rt_renderdoc_capture_file_path_template_from_env() -> text
extern fn rt_renderdoc_configure_capture_file_path_template_from_env() -> i64
extern fn rt_renderdoc_is_frame_capturing() -> i64
extern fn rt_renderdoc_start_capture() -> i64
extern fn rt_renderdoc_start_capture_for_device(device: i64) -> i64
extern fn rt_renderdoc_end_capture() -> i64
extern fn rt_renderdoc_end_capture_for_device(device: i64) -> i64
extern fn rt_renderdoc_num_captures() -> i64
extern fn rt_env_set(key: text, value_str: text) -> bool

use std.spec.step
describe "rt_renderdoc_* honesty on a RenderDoc-less host":
    it "rt_renderdoc_available reports 0 -- RENDERDOC_GetAPI never resolved here":
        step("Verify: rt_renderdoc_available reports 0 -- RENDERDOC_GetAPI never resolved here")
        # @req: REQ-RUNTIME-RendHone-001
        expect(rt_renderdoc_available()).to_equal(0)  # oracle: value fixed by the spec contract

    it "rt_renderdoc_num_captures is 0, never a fabricated capture count":
        step("Verify: rt_renderdoc_num_captures is 0, never a fabricated capture count")
        # @req: REQ-RUNTIME-RendHone-001
        expect(rt_renderdoc_num_captures()).to_equal(0)  # oracle: value fixed by the spec contract

    it "rt_renderdoc_start_capture / end_capture report failure, not a fake handle":
        step("Verify: rt_renderdoc_start_capture / end_capture report failure, not a fake handle")
        # @req: REQ-RUNTIME-RendHone-001
        expect(rt_renderdoc_start_capture()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(rt_renderdoc_end_capture()).to_equal(0)  # oracle: value fixed by the spec contract

    it "rt_renderdoc_start_capture_for_device / end_capture_for_device fail honestly for an explicit device":
        step("Verify: rt_renderdoc_start_capture_for_device / end_capture_for_device fail honestly for an explicit device")
        # @req: REQ-RUNTIME-RendHone-001
        expect(rt_renderdoc_start_capture_for_device(4242)).to_equal(0)  # oracle: value fixed by the spec contract
        expect(rt_renderdoc_end_capture_for_device(4242)).to_equal(0)  # oracle: value fixed by the spec contract

    it "rt_renderdoc_is_frame_capturing is honestly false":
        step("Verify: rt_renderdoc_is_frame_capturing is honestly false")
        # @req: REQ-RUNTIME-RendHone-001
        expect(rt_renderdoc_is_frame_capturing()).to_equal(0)  # oracle: value fixed by the spec contract

    it "rt_renderdoc_set_capture_file_path_template fails without a resolved API":
        step("Verify: rt_renderdoc_set_capture_file_path_template fails without a resolved API")
        # @req: REQ-RUNTIME-RendHone-001
        expect(rt_renderdoc_set_capture_file_path_template("build/renderdoc_honesty_probe")).to_equal(0)  # oracle: value fixed by the spec contract

    it "rt_renderdoc_capture_file_path_template_from_env round-trips real env content, not a constant":
        step("Verify: rt_renderdoc_capture_file_path_template_from_env round-trips real env content, not a constant")
        # @req: REQ-RUNTIME-RendHone-001
        val marker = "build/renderdoc_honesty_probe_marker_{rt_renderdoc_num_captures()}_unique"
        rt_env_set("RDOC_SIMPLE_CAPTURE_PATH", marker)
        expect(rt_renderdoc_capture_file_path_template_from_env()).to_equal(marker)
        rt_env_set("RDOC_SIMPLE_CAPTURE_PATH", "")

    it "rt_renderdoc_configure_capture_file_path_template_from_env still fails with an env var set -- no API resolved":
        step("Verify: rt_renderdoc_configure_capture_file_path_template_from_env still fails with an env var set -- no API resolved")
        # @req: REQ-RUNTIME-RendHone-001
        rt_env_set("RDOC_SIMPLE_CAPTURE_PATH", "build/renderdoc_honesty_probe_configure")
        expect(rt_renderdoc_configure_capture_file_path_template_from_env()).to_equal(0)  # oracle: value fixed by the spec contract
        rt_env_set("RDOC_SIMPLE_CAPTURE_PATH", "")
