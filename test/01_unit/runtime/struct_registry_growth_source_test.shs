#!/bin/sh
set -eu

# The struct-allocation registry lives once, in struct_alloc_registry_impl.h,
# and both runtime_memory.c and runtime_native.c include it. Pin that sharing
# (no re-forked copy) plus the growth/authority invariants of the shared body.

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
memory="$repo_root/src/runtime/runtime_memory.c"
native="$repo_root/src/runtime/runtime_native.c"
registry="$repo_root/src/runtime/struct_alloc_registry_impl.h"

for source in "$memory" "$native"; do
  grep -Fq '#include "struct_alloc_registry_impl.h"' "$source"
  ! grep -Eq '^static (int|size_t|void) rt_struct_alloc_(insert_raw|resize|register|load_limit|next_cap|lookup_size)\(' "$source"
  grep -Fq 'if (size <= 0) return NULL;' "$source"
  grep -Fq 'offset <= bytes && width <= bytes - offset' "$source"
done

! grep -Fq 'RT_STRUCT_ALLOC_MAX_CAP' "$registry"
grep -Fq 'const size_t max_entries = SIZE_MAX / sizeof(RtStructAllocation);' "$registry"
grep -Fq 'current > max_entries / 2' "$registry"
grep -Fq 'for (size_t probes = 0; probes < rt_struct_alloc_cap; probes++)' "$registry"
grep -Fq 'if (first_tomb != SIZE_MAX)' "$registry"
grep -Fq 'size_t remaining = limit - rt_struct_alloc_len;' "$registry"
grep -Fq 'rt_struct_alloc_tombs >= remaining - 1' "$registry"
grep -Fq 'rt_struct_alloc_failures != SIZE_MAX' "$registry"
grep -Fq 'free(fresh);' "$registry"
grep -Fq 'rt_struct_allocs = old;' "$registry"
grep -Fq 'rt_struct_alloc_len = old_len;' "$registry"
grep -Fq 'rt_struct_alloc_tombs = old_tombs;' "$registry"
grep -Fq '#if defined(SIMPLE_RUNTIME_STRUCT_REGISTRY_TESTING)' "$registry"
grep -Fq 'int64_t rt_struct_registry_failures(void)' "$registry"

echo 'PASS struct registry growth and authority parity source contract'
