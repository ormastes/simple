use std.nogc_sync_mut.sffi.system.{process_spawn, process_wait}

describe "process_spawn raw owned-child spawn":
    it "spawns a real child that exits 0 and reaps it":
        step("Spawn /bin/sh -c 'exit 0' through process_spawn and reap it")
        val pid = process_spawn("/bin/sh", ["-c", "exit 0"])
        expect(pid > 0).to_be_true()
        expect(process_wait(pid)).to_equal(0)

    it "reports the exit status of the spawned child":
        step("Spawn /bin/sh -c 'exit 7' and observe status 7 from process_wait")
        val pid = process_spawn("/bin/sh", ["-c", "exit 7"])
        expect(pid > 0).to_be_true()
        expect(process_wait(pid)).to_equal(7)
