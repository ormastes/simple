# spl_dlopen / spl_dlsym / spl_dlclose — N0 single-definition probe
#
# Task #82 (campaign Task #62, lane N0): survey §5 found spl_dlopen/spl_dlsym/
# spl_dlclose defined TWICE (src/runtime/runtime_dynload.c and
# src/runtime/runtime_native.c) with incompatible string decoders
# (rt_interp_cstr vs rt_core_string_to_cstring). Under -z muldefs the
# link-order winner decoded a raw char* argument as a tagged heap string,
# returning a garbage pointer / NULL — a silent dlopen failure
# indistinguishable from a genuinely missing library. That defeats this
# campaign's whole point: honest unavailability reporting for every future
# dlopen-based conversion, all of which route through this primitive.
#
# This is the POSITIVE capability probe: it must go RED if the primitive
# regresses (wrong decoder wins again, or a fixed-success stub is swapped in
# for the honest-negative path). It is not a banner/size check.
#
# See doc/03_plan/runtime/native_binding/dlopen_conversion_lanes.md (lane N0)
# and doc/04_architecture/runtime/native_library_binding_survey.md §5.

extern fn spl_dlopen(path: text) -> i64
extern fn spl_dlsym(handle: i64, name: text) -> i64
extern fn spl_dlclose(handle: i64) -> i64

use std.spec.{describe, it, expect}

describe "spl_dlopen / spl_dlsym / spl_dlclose (N0 single-definition probe)":
    it "opens a real system library (libm.so.6) and returns a non-zero handle":
        val handle = spl_dlopen("libm.so.6")
        expect(handle).to_be_greater_than(0)
        # dlclose here only to not leak the handle across examples; the
        # dedicated dlclose example below opens its own handle.
        spl_dlclose(handle)

    it "resolves a real exported symbol (cos) to a non-zero function pointer":
        val handle = spl_dlopen("libm.so.6")
        expect(handle).to_be_greater_than(0)
        val sym = spl_dlsym(handle, "cos")
        expect(sym).to_be_greater_than(0)
        spl_dlclose(handle)

    it "reports an HONEST negative for a library that does not exist -- never a fake handle":
        val handle = spl_dlopen("libdefinitely_absent_xyz.so")
        expect(handle).to_equal(0)

    it "spl_dlclose succeeds (returns 0) on a handle opened by spl_dlopen":
        val handle = spl_dlopen("libm.so.6")
        expect(handle).to_be_greater_than(0)
        val closed = spl_dlclose(handle)
        expect(closed).to_equal(0)
