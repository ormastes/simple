use std.io_runtime.{file_read}

use std.spec.step

describe "progress TLS boolean ABI":
    it "keeps the generated linker anchor identical to the Rust C wrapper":
        step("uses bool for the duplicate Rust declaration of the C bool symbol")
        val build_source = file_read("src/compiler_rust/runtime/build.rs")
        val wrapper_source = file_read("src/compiler_rust/runtime/src/value/sffi/time.rs")
        expect(build_source).to_contain(
            "\"rt_progress_tls_is_initialized\" => \"() -> bool\"")
        expect(wrapper_source).to_contain(
            "fn rt_progress_tls_is_initialized() -> bool")

    it "retains the callable codegen tier's one-byte boolean representation":
        step("keeps I8 at the compiler runtime-call boundary")
        val source = file_read("src/compiler_rust/compiler/src/codegen/runtime_sffi.rs")
        expect(source).to_contain(
            "RuntimeFuncSpec::new(\"rt_progress_tls_is_initialized\", &[], &[I8])")
