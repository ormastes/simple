use std.io_runtime.{file_read}

describe "simple-core required runtime symbol parity":
    it "defines the six bootstrap ABI symbols in their canonical owners":
        val values = file_read("src/runtime/simple_core/core_values.spl")
        val arrays = file_read("src/runtime/simple_core/core_array.spl")
        val strings = file_read("src/runtime/simple_core/core_string.spl")
        expect(values).to_contain("pub fn rt_is_jit_runtime()")
        expect(arrays).to_contain("pub fn rt_transient_array_scope_begin()")
        expect(arrays).to_contain("pub fn rt_transient_array_scope_pause()")
        expect(arrays).to_contain("pub fn rt_transient_heap_promote(value: i64)")
        expect(arrays).to_contain("pub fn rt_transient_array_scope_end()")
        expect(strings).to_contain("pub fn rt_native_cmp(left: i64, right: i64)")
