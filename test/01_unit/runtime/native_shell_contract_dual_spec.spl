# @dual_pair: native-shell-tuple mode=value-legacy ref=rt_shell_exec_tuple cand=LegacyShellContract.capture_tuple
# @cover src/lib/nogc_sync_mut/io/legacy_shell_contract.spl 80%
# Native pair requires a qualified self-hosted test runner; never use seed test.
use std.spec.*
use std.nogc_sync_mut.io.legacy_shell_contract.{LegacyShellContract}
use std.nogc_sync_mut.fs.host_path.{host_is_windows_host}

extern fn rt_shell_exec_tuple(command: text) -> (text, text, i64)

describe "native shell tuple and explicit scalar-status reference boundary":
    it "compares real process capture with the Simple tuple composition":
        val reference = LegacyShellContract.create().unwrap()
        val command = if host_is_windows_host(): "echo tuple-out& echo tuple-error 1>&2& exit /b 3" else: "printf tuple-out; printf tuple-error >&2; exit 3"
        val native = rt_shell_exec_tuple(command)
        val simple = reference.capture_tuple(command)
        expect(native.0).to_equal(simple.0)
        expect(native.1).to_equal(simple.1)
        expect(native.2).to_equal(simple.2)
        expect(native.0.trim()).to_equal("tuple-out")
        expect(native.1.trim()).to_equal("tuple-error")
        expect(native.2).to_equal(3)
        reference.close()

    it "records nonzero scalar status without treating tuple capture as scalar execution":
        val reference = LegacyShellContract.create().unwrap()
        expect(reference.last_status()).to_equal(0)
        expect(reference.scalar_result("actual-host-stdout", 7)).to_equal("actual-host-stdout")
        expect(reference.last_status()).to_equal(7)
        val result = reference.capture_tuple("echo tuple-ok")
        expect(result.2).to_equal(0)
        expect(reference.last_status()).to_equal(7)
        reference.scalar_result("", 0)
        expect(reference.last_status()).to_equal(0)
        reference.close()
