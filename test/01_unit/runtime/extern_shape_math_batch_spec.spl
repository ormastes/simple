# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-RUNTIME
#
# Extern return-shape canonicalisation, batch 9 (math). Every owner (C
# runtime_native.c, Rust value/sffi/math.rs, codegen spec, interpreter) is
# f64 -> f64; f32 callers go through a typed thunk in std.sffi.math.
use std.nogc_sync_mut.sffi.math.{math_acos, math_asin, math_atan, math_atan2, math_log10, math_log2}

fn _close(a: f32, b: f32) -> bool:
    val d = a - b
    d < 0.001 and d > -0.001

describe "extern return shapes: math f32 thunks over the f64 ABI":
    it "inverse trig f32 wrappers return correct values":
        step("acos(1) = 0, asin(1) = pi/2, atan(1) = pi/4, atan2(1,1) = pi/4")
        expect(_close(math_acos(1.0), 0.0)).to_equal(true)
        expect(_close(math_asin(1.0), 1.5707964)).to_equal(true)
        expect(_close(math_atan(1.0), 0.7853982)).to_equal(true)
        expect(_close(math_atan2(1.0, 1.0), 0.7853982)).to_equal(true)
        step("atan2 argument order is (y, x): atan2(1, 0) = pi/2")
        expect(_close(math_atan2(1.0, 0.0), 1.5707964)).to_equal(true)

    it "log f32 wrappers return correct values":
        step("log10(100) = 2, log2(8) = 3")
        expect(_close(math_log10(100.0), 2.0)).to_equal(true)
        expect(_close(math_log2(8.0), 3.0)).to_equal(true)
