use std.spec.*
use std.io_runtime.{file_read}

describe "struct receiver tag and bounds parity":
    it "keeps the C runtimes and pure owner fail-closed on the same domain":
        val native = file_read("src/runtime/runtime_native.c")
        val memory = file_read("src/runtime/runtime_memory.c")
        val pure = file_read("src/runtime/simple_core/core_memory.spl")

        step("Admit only untagged and tag-one receivers")
        expect(native).to_contain("& RT_VALUE_TAG_MASK) > 1")
        expect(memory).to_contain("& (uintptr_t)7) > 1")
        expect(pure).to_contain("if (receiver & 7) > 1:")

        step("Reject zero-sized allocations and zero-width accesses")
        expect(native).to_contain("void* rt_struct_alloc(int64_t size) {\n    if (size <= 0) return NULL;")
        expect(memory).to_contain("uint8_t* rt_struct_alloc(int64_t size) {\n    if (size <= 0) return NULL;")
        expect(pure).to_contain("pub fn rt_struct_alloc(size: i64) -> i64:\n    if size < 1:")
        expect(native).to_contain("access_width <= 0")
        expect(memory).to_contain("access_width <= 0")
        expect(pure).to_contain("access_width < 1")

        step("Require every access to fit fully inside its registered allocation")
        expect(native).to_contain("offset <= bytes && width <= bytes - offset")
        expect(memory).to_contain("offset <= bytes && width <= bytes - offset")
        expect(pure).to_contain("byte_offset <= size and access_width <= size - byte_offset")
