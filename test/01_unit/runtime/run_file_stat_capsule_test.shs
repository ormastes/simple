#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
test_dir=$(mktemp -d)
trap 'rm -rf "$test_dir"' EXIT HUP INT TERM

printf data >"$test_dir/fixture"
rustc "$repo_root/test/01_unit/runtime/file_stat_rust_reference.rs" \
    -o "$test_dir/file_stat_rust_reference"
expected_mtime=$("$test_dir/file_stat_rust_reference" "$test_dir/fixture")

link_gc=-Wl,--gc-sections
if [ "$(uname -s)" = Darwin ]; then
    link_gc=-Wl,-dead_strip
fi

cc -O2 -std=gnu11 -Wall -Wextra -Werror \
    -DSIMPLE_CORE_C_STANDALONE=1 -ffunction-sections -fdata-sections \
    -I "$repo_root/src/runtime" \
    "$repo_root/test/01_unit/runtime/file_stat_capsule_test.c" \
    "$repo_root/src/runtime/runtime_process.c" \
    "$link_gc" -pthread -o "$test_dir/file_stat_capsule_test"

"$test_dir/file_stat_capsule_test" \
    "$test_dir/fixture" "$test_dir/missing" "$expected_mtime"
