use std.spec.*
use std.io_runtime.{file_read}

describe "native text equality runtime surface":
    it "keeps canonical rt_string_eq and removes the dead rt_text_eq_fast alias":
        val header = file_read("src/runtime/runtime.h")
        val native = file_read("src/runtime/runtime_native.c")

        expect(header).to_contain("int64_t  rt_string_eq(int64_t left, int64_t right);")
        expect(native).to_contain("int64_t rt_string_eq(int64_t left, int64_t right)")
        expect(header.contains("rt_text_eq_fast")).to_equal(false)
        expect(native.contains("rt_text_eq_fast")).to_equal(false)
