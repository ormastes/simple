use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text

describe "debug enum methods have one Simple owner":
    it "keeps library enum method symbols out of the C runtime bridge":
        val source = rt_file_read_text("src/runtime/runtime_native.c")
        expect(source.len()).to_be_greater_than(0)
        expect(source.contains("lib__nogc_sync_mut__debug__remote__session_model__DebugExecutionMode_dot_to_string")).to_equal(false)
        expect(source.contains("lib__nogc_sync_mut__debug__remote__session_model__DebugTransportKind_dot_to_string")).to_equal(false)
        expect(source.contains("lib__nogc_sync_mut__debug__remote__types__Architecture_dot_to_string")).to_equal(false)

    it "retains the Simple methods including all architecture variants":
        val session = rt_file_read_text("src/lib/nogc_sync_mut/debug/remote/session_model.spl")
        val types = rt_file_read_text("src/lib/nogc_sync_mut/debug/remote/types.spl")
        expect(session).to_contain("enum DebugExecutionMode:")
        expect(session).to_contain("enum DebugTransportKind:")
        expect(session).to_contain("fn to_string() -> text:")
        expect(types).to_contain("Avr: \"avr\"")
        expect(types).to_contain("I8086: \"i8086\"")
        expect(types).to_contain("Wasm32: \"wasm32\"")
        expect(types).to_contain("Xtensa: \"xtensa\"")
