# Runtime byte-to-text decoder must never build a RuntimeString from invalid UTF-8
# (bug runtime_byte_text_utf8_invariant_2026_10_12). Malformed input -> U+FFFD (3 bytes each).
use std.spec.{describe, it, expect}

extern fn rt_bytes_to_text(bytes: [u8]) -> text

describe "rt_bytes_to_text UTF-8 invariant":
    it "replaces each invalid byte with a 3-byte U+FFFD":
        val t = rt_bytes_to_text([0x80u8, 0xFFu8, 0x41u8])
        expect(t.len()).to_equal(7)
        expect(t.ends_with("A")).to_equal(true)

    it "preserves valid ASCII and embedded NUL":
        expect(rt_bytes_to_text([0x68u8, 0x69u8])).to_equal("hi")
        expect(rt_bytes_to_text([0x61u8, 0x00u8, 0x62u8]).len()).to_equal(3)
