#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/simple-dir-sync-test.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

for provider in runtime runtime_legacy_core; do
    cc -std=gnu11 -O0 -ffunction-sections -fdata-sections \
        -I"$root/src/runtime" \
        "$root/test/01_unit/runtime/dir_sync_focus_test.c" \
        "$root/src/runtime/$provider.c" \
        -Wl,--gc-sections -pthread -ldl -lm -o "$tmp/$provider-test"
    "$tmp/$provider-test"
    nm -g --defined-only "$tmp/$provider-test" | awk '{print $3}' | \
        grep -qx 'rt_dir_sync'
done
