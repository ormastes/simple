# @tag:unit, runtime, simple-core, qemu

use std.spec.*

describe "Pure Simple shared array ABI":
    it "accepts valid arrays created by a foreign freestanding provider":
        val core = file_read_text(
            "src/runtime/simple_core/core_array.spl")
        expect(core).to_contain("if spl_load_u8(ptr, 0) != 2:")
        expect(core).to_contain("val items = spl_load_i64(ptr, 24)")
        expect(core).to_contain("if cap > 0 and (items < 4096 or (items & 7) != 0):")
        expect(core).to_contain("pub fn array_is_registered_ptr(ptr: i64) -> i64:")
        expect(core.contains("if current < 1:\n        return 0\n    if spl_load_u8(ptr, 0) != 2:")).to_be(false)

    it "does not free an inline foreign items pointer independently":
        val ops = file_read_text(
            "src/runtime/simple_core/core_array_ops.spl")
        expect(ops).to_contain("if array_is_registered_ptr(ptr) < 1:")
        expect(ops).to_contain("free(ptr)\n        return")
