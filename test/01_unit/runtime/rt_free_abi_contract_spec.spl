use std.spec.*
use std.io_runtime.{file_read}

describe "cross-platform rt_free ABI":
    it "keeps pure, C, Rust, and SimpleOS boundaries pointer-only":
        val pure_raw = file_read("src/lib/nogc_sync_mut/ptr/raw.spl")
        val pure_gpu = file_read("src/lib/nogc_sync_mut/gpu/memory.spl")
        val rust_memory = file_read("src/compiler_rust/runtime/src/value/sffi/memory.rs")
        val codegen = file_read("src/compiler_rust/compiler/src/codegen/runtime_sffi.rs")
        val simpleos = file_read("src/os/libc/simpleos_simple_runtime.c")
        val guard = file_read("scripts/check/check-rt-free-abi.shs")

        step("Check the exact one-pointer declarations")
        expect(pure_raw).to_contain("pub extern fn rt_free(ptr: i64)")
        expect(pure_gpu).to_contain("extern fn rt_free(ptr: i64)")
        expect(rust_memory).to_contain("pub fn rt_free(ptr: *mut u8)")
        expect(codegen).to_contain("RuntimeFuncSpec::new")
        expect(codegen).to_contain("rt_free")
        expect(simpleos).to_contain("void rt_free(void *ptr)")

        step("Check adjacent deallocation and platform guards")
        expect(pure_raw).to_contain("rt_free(ptr)")
        expect(simpleos).to_contain("free(ptr);")
        expect(guard).to_contain("hosted_platforms=linux,macos,windows,bsd")
        expect(guard).to_contain("hosted_cpus=x86_64,aarch64")
