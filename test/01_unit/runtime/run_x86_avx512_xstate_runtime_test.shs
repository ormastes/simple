#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/simple-x86-xstate.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM

cc -std=gnu11 -O2 -Wall -Wextra \
    -ffunction-sections -fdata-sections \
    -I"$repo_root/src/runtime" \
    -c "$repo_root/src/runtime/runtime_simd_dispatch.c" \
    -o "$work_dir/runtime_simd_dispatch.o"
cc -std=gnu11 -O2 -Wall -Wextra \
    -ffunction-sections -fdata-sections \
    -I"$repo_root/src/runtime" \
    "$repo_root/test/01_unit/runtime/x86_avx512_xstate_runtime_test.c" \
    "$work_dir/runtime_simd_dispatch.o" \
    -Wl,--gc-sections -pthread -ldl -o "$work_dir/xstate-test"
"$work_dir/xstate-test"

cc -std=gnu11 -O2 -Wall -Wextra \
    -ffunction-sections -fdata-sections \
    -DSIMPLE_RUNTIME_FORCE_NO_X86_XSTATE=1 \
    -I"$repo_root/src/runtime" \
    -c "$repo_root/src/runtime/runtime_simd_dispatch.c" \
    -o "$work_dir/runtime_simd_dispatch-non-x86.o"
cc -std=gnu11 -O2 -Wall -Wextra \
    -ffunction-sections -fdata-sections \
    -I"$repo_root/src/runtime" \
    "$repo_root/test/01_unit/runtime/x86_avx512_xstate_runtime_test.c" \
    "$work_dir/runtime_simd_dispatch-non-x86.o" \
    -Wl,--gc-sections -pthread -ldl -o "$work_dir/xstate-test-non-x86"

output=$("$work_dir/xstate-test-non-x86")
test "$output" = "x86-avx512-xstate-runtime: host-usable=0"
printf '%s\n' "$output"
