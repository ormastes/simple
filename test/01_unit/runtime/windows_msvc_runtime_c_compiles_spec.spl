extern fn rt_file_read_text(path: text) -> text

use std.spec.{describe, it, expect}

# REPRODUCING spec for the Windows MSVC Stage 2 admission blocker
# (stage2-struct-receiver-failed, 2026-09-02).
#
# src/runtime/runtime.c could not be compiled by the MSVC lane's C compiler at
# all, so the C runtime archive the Stage 2 struct-receiver probe links against
# could not be produced. Measured with the production compiler and the
# production flags (clang-cl 18.1.8; /c /O2 /Gy /MD /std:c11, assembled at
# src/compiler/70.backend/backend/runtime_compiler.spl:592):
#
#   before: 9 errors, no object emitted
#   after:  exit 0, 0 errors, 144,813-byte object
#
# The four distinct causes are pinned below. Each assertion fails if that
# specific repair is reverted.

describe "runtime.c compiles on the Windows MSVC lane":
    it "declares rt_mmap with the tagged-value ABI both codegens emit":
        val header = rt_file_read_text("src/runtime/runtime.h") ?? ""
        expect(header).to_contain("int64_t  rt_mmap(int64_t path_value, int64_t size, int64_t offset, int64_t readonly);")
        # The stale shape produced MSVC error C2040 / clang-cl 'conflicting types'.
        expect(header).to_not_contain("void*    rt_mmap(const char* path,")

    it "declares rt_file_lock with the raw (ptr, len) ABI it is registered for":
        val header = rt_file_read_text("src/runtime/runtime.h") ?? ""
        val win = rt_file_read_text("src/runtime/platform/platform_win.h") ?? ""
        expect(header).to_contain("int64_t  rt_file_lock(const uint8_t* path_ptr, uint64_t path_len, int64_t timeout_secs);")
        expect(header).to_not_contain("int64_t  rt_file_lock(const char* path, int64_t timeout_secs);")
        expect(win).to_contain("int64_t rt_file_lock(const uint8_t* path_ptr, uint64_t path_len, int64_t timeout_secs) {")

    it "supplies alloca, ssize_t and S_ISDIR under the MS CRT":
        val runtime_c = rt_file_read_text("src/runtime/runtime.c") ?? ""
        # All three are absent from the MS CRT and are hard errors without a shim.
        expect(runtime_c).to_contain("#define alloca _alloca")
        expect(runtime_c).to_contain("typedef SSIZE_T ssize_t;")
        expect(runtime_c).to_contain("#define S_ISDIR(m) (((m) & _S_IFMT) == _S_IFDIR)")

    it "keeps every MSVC shim gated so MinGW and Unix are unaffected":
        val runtime_c = rt_file_read_text("src/runtime/runtime.c") ?? ""
        # The shims are nested in the existing #ifdef _WIN32 arm AND gated on
        # _MSC_VER, which MinGW does not define. Losing the gate would break the
        # MinGW arm, which already supplies all three symbols.
        expect(runtime_c).to_contain("#ifdef _MSC_VER")
        expect(runtime_c).to_contain("#include <basetsd.h>")

    it "prefers clang-cl over cl.exe, which cannot parse the runtime at all":
        val cc = rt_file_read_text("src/compiler/70.backend/backend/runtime_compiler.spl") ?? ""
        # cl.exe passes the trivial probe and then dies on runtime.c's GNU
        # __attribute__ usage (C2143/C2091), which no flag repairs.
        expect(cc).to_contain("val msvc_candidates = [\"clang-cl\", \"cl.exe\"]")
        # stdatomic.h is fatal C1189 on the MS CRT without C11 enabled.
        expect(cc).to_contain("/std:c11")
