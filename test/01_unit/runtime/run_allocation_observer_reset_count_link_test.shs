#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
rt="$root/src/runtime"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
fail() { echo "FAIL: $1" >&2; exit 1; }

compile() {
    mode=$1
    source=$2
    "${CC:-cc}" -c -O2 -fPIC -ffunction-sections -fdata-sections -std=gnu11 \
        -D_GNU_SOURCE -DSIMPLE_RUNTIME_MEMORY_OWNER=1 \
        -DSIMPLE_ALLOC_OBSERVER_V1="$mode" -I"$rt" -I"$rt/platform" \
        "$source" -o "$tmp/$mode-$(basename "$source" .c).o"
}
for mode in 0 1; do
    for source in runtime_native runtime_memory runtime_alloc_observer; do
        compile "$mode" "$rt/$source.c"
    done
    compile "$mode" "$root/test/01_unit/runtime/allocation_observer_reset_count_link_test.c"
done
link() {
    observer_mode=$1
    memory_mode=$2
    native_mode=$3
    shift 3
    "${CC:-cc}" "$@" "$tmp/$observer_mode-allocation_observer_reset_count_link_test.o" \
        "$tmp/$observer_mode-runtime_alloc_observer.o" \
        "$tmp/$memory_mode-runtime_memory.o" "$tmp/$native_mode-runtime_native.o" \
        -Wl,--gc-sections -pthread -ldl -lm -o "$tmp/probe"
}
# Positive controls prove the fixture has a complete real-allocation closure.
link 0 0 0
"$tmp/probe"
link 1 1 1
"$tmp/probe"
# Each disabled canonical owner must be rejected without retaining coverage().
for missing in memory native; do
    if [ "$missing" = memory ]; then
        memory_mode=0; native_mode=1
    else
        memory_mode=1; native_mode=0
    fi
    if link 1 "$memory_mode" "$native_mode" >"$tmp/$missing-link.log" 2>&1; then
        fail "reset/count linked with disabled $missing owner"
    fi
    grep -q "rt_alloc_observer_${missing}_owner_v1" "$tmp/$missing-link.log" ||
        fail "mixed link failed without the missing $missing admission anchor"
done
# Caller objects precede canonical objects, matching production binding order.
# With duplicate forgiveness disabled, neither an allocator nor observer override
# can win, even when both instrumented owner anchors are present.
for conflict in ALLOCATOR OBSERVER; do
    "${CC:-cc}" -c -O2 -ffunction-sections -fdata-sections \
        -DCONFLICT_"$conflict" \
        "$root/test/01_unit/runtime/allocation_observer_conflicting_provider.c" \
        -o "$tmp/conflict-$conflict.o"
    if link 1 1 1 "$tmp/conflict-$conflict.o" >"$tmp/conflict-$conflict.log" 2>&1; then
        fail "caller-first $conflict override linked with canonical owners"
    fi
    grep -Eq 'multiple definition|duplicate symbol' "$tmp/conflict-$conflict.log" ||
        fail "caller-first $conflict link failed without duplicate rejection"
done
echo 'PASS: reset/count GC rejects disabled owners and caller-first allocator/observer overrides; enabled/disabled controls pass'
