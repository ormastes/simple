# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-RUNTIME
#
# Extern return-shape canonicalisation, CUDA kernel-launch (follows the GPU batch, PR #12271).
# doc/08_tracking/bug/seed_jit_extern_return_type_last_wins_2026-11-27.md
#
# rt_cuda_launch_kernel has ONE declared return shape tree-wide: i64
# (0 = launched, negative = CUDA driver error / no driver). The C definition
# (runtime_dynload.c) and the hosted Rust handler (interpreter_extern/gpu.rs)
# both return i64; the physics gpu_solver.spl and os/ml declarations used to say bool.
#
# NOTE: this host has no CUDA hardware. The spec checks only the return SHAPE
# (an i64 status, negative without a driver or with an invalid module) and the
# ABI arity; it does not launch a real kernel.

@unsafe(reason: "raw CUDA kernel-launch status ABI", capabilities: [ffi])
extern fn rt_cuda_launch_kernel(module: i64, func_name: text, grid_x: i64, grid_y: i64, grid_z: i64, block_x: i64, block_y: i64, block_z: i64, args_ptr: i64) -> i64

describe "extern return shapes: CUDA kernel launch":
    it "rt_cuda_launch_kernel returns an i64 status, negative for an invalid module":
        step("launching on module handle 0 cannot succeed (no driver, or null module)")
        val rc = unsafe(capabilities: [ffi]):
            rt_cuda_launch_kernel(0, "no_such_kernel", 1, 1, 1, 1, 1, 1, 0)
        expect(rc < 0).to_equal(true)
        step("the status compares as an integer, not a bool")
        expect(rc != 0).to_equal(true)
