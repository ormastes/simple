# codex-system-test
# @req RUNTIME-VALUE-ABI/03-6
# Native consumer counterpart; whole ABI unification remains open.
# No source scan, local RuntimeValue model, or hand-coded tag oracle.
use std.spec.*
use std.spec.step

fn runtime_consumer_identity(value: Any) -> Any:
    value

fn runtime_consumer_explicit(value: Any) -> Any:
    return value

fn runtime_optional_explicit(value: bool) -> bool?:
    return value

fn runtime_optional_tail(value: bool) -> bool?:
    value

fn runtime_optional_absent() -> bool?:
    nil

describe "Live native RuntimeValue consumers", tag: ["only-compiled"]:
    # @manual scenario evidence
    it "preserves integer local parameter return and render boundaries":
        step("Box a negative integer into an Any local")
        val local: Any = -42
        step("Forward it through implicit and explicit Any returns")
        val implicit = runtime_consumer_identity(local)
        val explicit = runtime_consumer_explicit(local)
        step("Compare both directions and render the decoded value")
        expect(implicit == -42).to_equal(true)
        expect(-42 == explicit).to_equal(true)
        expect(explicit == -41).to_equal(false)
        expect(implicit.to_text()).to_equal("-42")

    it "distinguishes false true and integer zero through Any":
        step("Forward both boolean payloads through Any consumers")
        val yes = runtime_consumer_identity(true)
        val no = runtime_consumer_explicit(false)
        step("Check payload discrimination and renderer output")
        expect(yes == true).to_equal(true)
        expect(no == false).to_equal(true)
        expect(no == true).to_equal(false)
        expect(yes == false).to_equal(false)
        expect(no.to_text()).to_equal("false")
        expect(yes.to_text()).to_equal("true")
        val zero = runtime_consumer_identity(0)
        expect(zero.to_text()).to_equal("0")

    it "preserves float payloads across Any returns":
        step("Pass a fractional float through both return paths")
        val local: Any = -2.5
        val implicit = runtime_consumer_identity(local)
        val explicit = runtime_consumer_explicit(local)
        step("Compare the payload with distinct scalar controls")
        expect(implicit == -2.5).to_equal(true)
        expect(-2.5 == explicit).to_equal(true)
        expect(explicit == 2.5).to_equal(false)
        expect(implicit.to_text()).to_equal("-2.5")

    it "preserves distinct text payloads through Any decoding":
        step("Pass two distinct texts through implicit and explicit Any returns")
        val left = runtime_consumer_identity("alpha")
        val right = runtime_consumer_explicit("beta")
        step("Decode each text and reject accidental payload aliasing")
        expect(left.to_text()).to_equal("alpha")
        expect(right.to_text()).to_equal("beta")
        expect(left == "alpha").to_equal(true)
        expect("beta" == right).to_equal(true)
        expect(left == right).to_equal(false)
        expect(left == "beta").to_equal(false)

    it "preserves present false and absent optional returns":
        step("Return true and false through explicit and implicit optional paths")
        val explicit_true = runtime_optional_explicit(true)
        val explicit_false = runtime_optional_explicit(false)
        val tail_true = runtime_optional_tail(true)
        val tail_false = runtime_optional_tail(false)
        val absent = runtime_optional_absent()
        step("Check false remains present and nil remains absent")
        expect(explicit_true == true).to_equal(true)
        expect(explicit_false == false).to_equal(true)
        expect(tail_true == true).to_equal(true)
        expect(tail_false == false).to_equal(true)
        expect(explicit_false == nil).to_equal(false)
        expect(tail_false == nil).to_equal(false)
        expect(absent == nil).to_equal(true)
        expect(absent == false).to_equal(false)
        expect(absent == true).to_equal(false)
