"""
## Purpose and audience
Purpose: owns the bounded-process ABI on Windows and the shared Unix branch
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-RUNTIME-ProcRunTimeProvSour-001

extern fn rt_file_read_text(path: text) -> text

use std.spec.{describe, it, expect}

use std.spec.step
describe "core C process timeout provider":
    it "owns the bounded-process ABI on Windows and the shared Unix branch":
        step("Verify: owns the bounded-process ABI on Windows and the shared Unix branch")
        # @req: REQ-RUNTIME-ProcRunTimeProvSour-001
        val header = rt_file_read_text("src/runtime/runtime.h") ?? ""
        val provider = rt_file_read_text("src/runtime/runtime_process.c") ?? ""
        val native = rt_file_read_text("src/runtime/runtime_native.c") ?? ""
        val codegen = rt_file_read_text("src/compiler_rust/compiler/src/codegen/runtime_sffi.rs") ?? ""
        val calls = rt_file_read_text("src/compiler_rust/compiler/src/codegen/instr/calls.rs") ?? ""
        val owner_abi = "SplArray* rt_process_run_bounded(const char* cmd, uint64_t cmd_len, SplArray* args,"
        val owner_limits = "int64_t timeout_ms, int64_t max_output_bytes)"
        val windows_start = provider.find("/* Windows process timeout/capture owner. */")
        val unix_start = provider.find("#else /* POSIX */")

        expect(windows_start).to_be_greater_than(-1)
        expect(unix_start).to_be_greater_than(windows_start)
        val windows = provider.substring(windows_start, unix_start)
        val unix = provider.substring(unix_start, provider.len())

        expect(header).to_contain(owner_abi)
        expect(header).to_contain(owner_limits + ";")
        expect(windows).to_contain(owner_abi)
        expect(windows).to_contain(owner_limits)
        # Linux, macOS, and FreeBSD share this Unix C owner.
        expect(unix).to_contain(owner_abi)
        expect(unix).to_contain(owner_limits)
        expect(native).to_contain("int64_t* rt_process_run_bounded_tuple(int64_t cmd, SplArray* args, int64_t timeout_ms,")
        expect(native).to_contain("int64_t max_output_bytes)")
        expect(native).to_contain("return rt_process_result_to_tuple(rt_process_run_bounded(")
        expect(native).to_contain("cmd_c ? cmd_c : \"\", cmd_len, args, timeout_ms, max_output_bytes))")
        expect(codegen).to_contain("RuntimeFuncSpec::new(\"rt_process_run_bounded\", &[I64, I64, I64, I64, I64], &[I64])")
        expect(calls).to_contain("| \"rt_process_run_bounded\" => Some((&[0], &[1]))")

    it "owns the four-word tagged tuple ABI":
        step("Verify: owns the four-word tagged tuple ABI")
        # @req: REQ-RUNTIME-ProcRunTimeProvSour-001
        val header = rt_file_read_text("src/runtime/runtime.h") ?? ""
        val provider = rt_file_read_text("src/runtime/runtime_process.c") ?? ""
        val codegen = rt_file_read_text("src/compiler_rust/compiler/src/codegen/runtime_sffi.rs") ?? ""
        val calls = rt_file_read_text("src/compiler_rust/compiler/src/codegen/instr/calls.rs") ?? ""

        expect(header).to_contain("SplArray* rt_process_run_timeout(const char* cmd, uint64_t cmd_len, SplArray* args, int64_t timeout_ms);")
        expect(provider).to_contain("SplArray* rt_process_run_timeout(const char* cmd, uint64_t cmd_len, SplArray* args, int64_t timeout_ms)")
        expect(provider).to_contain("rt_array_new(3)")
        expect(provider).to_contain("rt_string_new")
        expect(provider).to_contain("rt_value_int(code)")
        expect(codegen).to_contain("RuntimeFuncSpec::new(\"rt_process_run_timeout\", &[I64, I64, I64, I64], &[I64])")
        expect(calls).to_contain("| \"rt_process_run_timeout\"")
        expect(calls).to_contain("| \"rt_process_run_bounded\" => Some((&[0], &[1]))")

    it "captures POSIX output and cleans the timed process group":
        step("Verify: captures POSIX output and cleans the timed process group")
        # @req: REQ-RUNTIME-ProcRunTimeProvSour-001
        val provider = rt_file_read_text("src/runtime/runtime_process.c") ?? ""
        val fork_owner = rt_file_read_text("src/runtime/runtime_fork.c") ?? ""

        expect(provider).to_contain("int64_t argc = args ? rt_array_len(args) : 0;")
        expect(provider).to_contain("const uint8_t* data = rt_string_data(rt_array_get(args, i));")
        expect(provider.find("spl_array_len(args)")).to_equal(-1)  # oracle: value fixed by the spec contract
        expect(provider.find("spl_array_get(args, i)")).to_equal(-1)  # oracle: value fixed by the spec contract
        expect(provider.find("spl_as_str(v)")).to_equal(-1)  # oracle: value fixed by the spec contract
        expect(provider).to_contain("rt_fork_child_setup()")
        expect(provider).to_contain("execvp(cmd_c, argv)")
        expect(provider).to_contain("rt_fork_parent_wait(child_pid, timeout_ms > 0 ? timeout_ms : 0)")
        expect(provider).to_contain("rt_fork_parent_stdout()")
        expect(provider).to_contain("rt_fork_parent_stderr()")
        expect(provider).to_contain("if (rt_fork_parent_signaled()) code = -1")
        expect(fork_owner).to_contain("clock_gettime(CLOCK_MONOTONIC")
        expect(fork_owner).to_contain("setpgid(0, 0)")
        expect(fork_owner).to_contain("kill(-(pid_t)child_pid, SIGKILL)")
        expect(fork_owner).to_contain("cleanup_descendants = stdout_open || stderr_open")
        expect(fork_owner).to_contain("waitpid_nointr((pid_t)child_pid, &child_status, WNOHANG)")

    it "captures Windows output and assigns the suspended child to a Job Object":
        step("Verify: captures Windows output and assigns the suspended child to a Job Object")
        # @req: REQ-RUNTIME-ProcRunTimeProvSour-001
        val provider = rt_file_read_text("src/runtime/runtime_process.c") ?? ""
        val windows_start = provider.find("/* Windows process timeout/capture owner. */")
        val posix_start = provider.find("#else /* POSIX */")
        expect(windows_start).to_be_greater_than(-1)
        expect(posix_start).to_be_greater_than(windows_start)
        val windows = provider.substring(windows_start, posix_start)
        val run_start = windows.find("static SplArray* win_process_run_capture")
        val run_end = windows.find("int64_t rt_process_spawn_piped")
        expect(run_start).to_be_greater_than(-1)
        expect(run_end).to_be_greater_than(run_start)
        val run = windows.substring(run_start, run_end)

        expect(windows).to_contain("PROC_THREAD_ATTRIBUTE_HANDLE_LIST")
        expect(windows).to_contain("JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE")
        expect(windows).to_contain("PeekNamedPipe")
        expect(windows).to_contain("ReadFile")
        expect(windows).to_contain("GetTickCount64")
        expect(windows.find("rt_process_run_timeout unsupported on Windows")).to_equal(-1)  # oracle: value fixed by the spec contract

        val pipe_pos = run.find("CreatePipe(&stdout_read")
        val stderr_pipe_pos = run.find("CreatePipe(&stderr_read")
        val restrict_pos = run.find("SetHandleInformation(stdout_read, HANDLE_FLAG_INHERIT, 0)")
        val stderr_restrict_pos = run.find("SetHandleInformation(stderr_read, HANDLE_FLAG_INHERIT, 0)")
        val kill_flag_pos = run.find("JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE")
        val job_pos = run.find("SetInformationJobObject")
        val attribute_pos = run.find("UpdateProcThreadAttribute")
        val handle_list_pos = run.find("PROC_THREAD_ATTRIBUTE_HANDLE_LIST")
        val stdio_pos = run.find("STARTF_USESTDHANDLES")
        val suspended_pos = run.find("CREATE_SUSPENDED")
        val create_pos = run.find("if (!CreateProcessA")
        val assign_pos = run.find("AssignProcessToJobObject")
        val resume_pos = run.find("ResumeThread")
        val drain_pos = run.find("win_capture_drain(stdout_read")
        val wait_pos = run.find("WaitForSingleObject(process.hProcess, wait_ms)")
        val terminate_pos = run.find("TerminateJobObject")
        expect(pipe_pos).to_be_greater_than(-1)
        expect(stderr_pipe_pos).to_be_greater_than(pipe_pos)
        expect(restrict_pos).to_be_greater_than(pipe_pos)
        expect(stderr_restrict_pos).to_be_greater_than(stderr_pipe_pos)
        expect(kill_flag_pos).to_be_greater_than(-1)
        expect(job_pos).to_be_greater_than(kill_flag_pos)
        expect(attribute_pos).to_be_greater_than(job_pos)
        expect(handle_list_pos).to_be_greater_than(attribute_pos)
        expect(stdio_pos).to_be_greater_than(handle_list_pos)
        expect(suspended_pos).to_be_greater_than(stdio_pos)
        expect(create_pos).to_be_greater_than(pipe_pos)
        expect(create_pos).to_be_greater_than(stderr_pipe_pos)
        expect(create_pos).to_be_greater_than(restrict_pos)
        expect(create_pos).to_be_greater_than(stderr_restrict_pos)
        expect(create_pos).to_be_greater_than(job_pos)
        expect(create_pos).to_be_greater_than(attribute_pos)
        expect(create_pos).to_be_greater_than(handle_list_pos)
        expect(create_pos).to_be_greater_than(suspended_pos)
        expect(assign_pos).to_be_greater_than(create_pos)
        expect(resume_pos).to_be_greater_than(assign_pos)
        expect(drain_pos).to_be_greater_than(resume_pos)
        expect(wait_pos).to_be_greater_than(drain_pos)
        expect(terminate_pos).to_be_greater_than(wait_pos)

    it "owns supervised Windows piped process transport":
        step("Verify: owns supervised Windows piped process transport")
        # @req: REQ-RUNTIME-ProcRunTimeProvSour-001
        val provider = rt_file_read_text("src/runtime/runtime_process.c") ?? ""
        val header = rt_file_read_text("src/runtime/runtime.h") ?? ""
        val windows_start = provider.find("struct WinPipedSlot")
        val posix_start = provider.find("#else /* POSIX */")
        expect(windows_start).to_be_greater_than(-1)
        expect(posix_start).to_be_greater_than(windows_start)
        val piped = provider.substring(windows_start, posix_start)

        expect(header).to_contain("bool        rt_process_close_piped(int64_t pid);")
        expect(header).to_contain("rt_browser_renderer_spawn_sandboxed")
        expect(header).to_contain("rt_browser_renderer_sandbox_enter")
        expect(header).to_contain("rt_browser_renderer_read_stdin_some")
        expect(header).to_contain("rt_browser_renderer_write_stdout_some")
        expect(header).to_contain("rt_browser_renderer_write_protocol_some")
        expect(header).to_contain("int64_t     rt_process_write_stdin_some(")
        expect(piped).to_contain("BCryptGenRandom")
        expect(piped).to_contain("CreateNamedPipeA(")
        expect(piped).to_contain("PIPE_REJECT_REMOTE_CLIENTS")
        expect(piped).to_contain("FILE_FLAG_OVERLAPPED")
        expect(piped).to_contain("CreatePipe(&stdout_read, &stdout_write")
        expect(piped).to_contain("SetHandleInformation(stdout_read, HANDLE_FLAG_INHERIT, 0)")
        expect(piped).to_contain("PROC_THREAD_ATTRIBUTE_HANDLE_LIST")
        expect(piped).to_contain("JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE")
        expect(piped).to_contain("CREATE_SUSPENDED")
        expect(piped).to_contain("AssignProcessToJobObject")
        expect(piped).to_contain("ResumeThread")
        expect(piped).to_contain("WriteFile(")
        expect(piped).to_contain("GetOverlappedResult(")
        expect(piped).to_contain("CancelIoEx(")
        expect(piped).to_contain("PeekNamedPipe(")
        expect(piped).to_contain("ReadFile(")
        expect(piped).to_contain("TerminateJobObject")
        expect(piped).to_contain("WaitForSingleObject(slot->process, 5000)")
        expect(piped.find("(void)cmd; (void)args;")).to_equal(-1)  # oracle: value fixed by the spec contract

    it "owns a fail-closed Linux renderer sandbox and rejects unsupported platform launch":
        step("Verify: owns a fail-closed Linux renderer sandbox and rejects unsupported platform launch")
        # @req: REQ-RUNTIME-ProcRunTimeProvSour-001
        val provider = rt_file_read_text("src/runtime/runtime_process.c") ?? ""
        expect(provider).to_contain("LANDLOCK_CREATE_RULESET_VERSION")
        expect(provider).to_contain("SECCOMP_FILTER_FLAG_TSYNC")
        expect(provider).to_contain("BROWSER_RENDERER_DENY_SYSCALL(__NR_execve)")
        expect(provider).to_contain("BROWSER_RENDERER_DENY_SYSCALL(__NR_socket)")
        expect(provider).to_contain("BROWSER_RENDERER_DENY_SYSCALL(__NR_kill)")
        expect(provider).to_contain("BROWSER_RENDERER_DENY_SYSCALL(__NR_get_robust_list)")
        expect(provider).to_contain("char* empty_environment[] = {NULL}")
        expect(provider).to_contain("argv[0] = (char*)\"simple-browser-renderer\"")
        expect(provider).to_contain("if (chdir(\"/\") != 0) _exit(127)")
        expect(provider).to_contain("read(\n            STDIN_FILENO, s_browser_renderer_stdin_buf, request)")

    it "shares private Windows quoting while preserving the public runtime owner":
        step("Verify: shares private Windows quoting while preserving the public runtime owner")
        # @req: REQ-RUNTIME-ProcRunTimeProvSour-001
        val provider = rt_file_read_text("src/runtime/runtime_process.c") ?? ""
        val platform = rt_file_read_text("src/runtime/platform/platform_win.h") ?? ""
        val quoting = rt_file_read_text("src/runtime/platform/windows_command_line_private.h") ?? ""
        val seed_tools = rt_file_read_text("src/compiler_rust/compiler/src/pipeline/native_project/tools.rs") ?? ""

        expect(provider).to_contain("#include \"platform/windows_command_line_private.h\"")
        expect(provider).to_contain("cmdline = win_cmd_build_line(cmd_c, child_args, argc);")
        expect(provider.find("rt_windows_build_command_line(cmd_c, child_args, argc)")).to_equal(-1)  # oracle: value fixed by the spec contract
        expect(provider.find("static bool win_cmd_needs_quotes")).to_equal(-1)  # oracle: value fixed by the spec contract
        expect(platform).to_contain("#include \"windows_command_line_private.h\"")
        expect(platform).to_contain("char* rt_windows_build_command_line(const char* cmd, const char** args, int64_t arg_count)")
        expect(platform).to_contain("return win_cmd_build_line(cmd, args, arg_count);")
        expect(platform.find("static bool win_cmd_needs_quotes")).to_equal(-1)  # oracle: value fixed by the spec contract
        expect(quoting).to_contain("static bool win_cmd_needs_quotes(const char* s)")
        expect(quoting).to_contain("static bool win_cmd_append_char(char* out, size_t cap, size_t* pos, char ch)")
        expect(quoting).to_contain("static bool win_cmd_append_str(char* out, size_t cap, size_t* pos, const char* s)")
        expect(quoting).to_contain("static bool win_cmd_append_arg(char* out, size_t cap, size_t* pos, const char* arg)")
        expect(quoting).to_contain("static char* win_cmd_build_line(const char* cmd, const char** args, int64_t arg_count)")
        expect(quoting.split("static ").len() - 1).to_equal(5)  # oracle: value fixed by the spec contract
        expect(quoting.find("constructor")).to_equal(-1)  # oracle: value fixed by the spec contract
        expect(quoting.find(".CRT$")).to_equal(-1)  # oracle: value fixed by the spec contract
        expect(quoting).to_contain("if (!s || s[0] == '\\0') return true;")
        expect(quoting).to_contain("*p == ' ' || *p == '\\t' || *p == '\"'")
        expect(quoting).to_contain("backslashes * 2 + 1")
        expect(quoting).to_contain("backslashes * 2")
        expect(quoting).to_contain("if (total > SIZE_MAX - addition) return NULL;")
        expect(seed_tools).to_contain("\"platform/windows_command_line_private.h\",")
