# Production-owner contract: compile --no-mangle; link the changed pure-Simple
# core_array/core_array_ops/core_array_query before hosted providers. Link map
# and disassembly must establish those owners. Wrap libc realloc only.
# Baseline must fail the first canary assertion before admitting the repair.
extern fn rt_byte_array_new(cap: i64) -> i64
extern fn rt_byte_array_new_len(length: i64) -> i64
extern fn rt_array_new(cap: i64) -> i64
extern fn rt_array_new_with_cap_u64(cap: i64) -> i64
extern fn rt_array_free(array: i64)
extern fn rt_array_push(array: i64, value: i64) -> i8
extern fn rt_array_push_no_grow(array: i64, value: i64) -> i8
extern fn rt_typed_bytes_u8_push(array: i64, value: i64) -> i8
extern fn rt_array_pop(array: i64) -> i64
extern fn rt_array_get(array: i64, index: i64) -> i64
extern fn rt_array_set(array: i64, index: i64, value: i64) -> i8
extern fn rt_index_get(array: i64, index: i64) -> i64
extern fn rt_index_set(array: i64, index: i64, value: i64) -> i8
extern fn rt_array_copy(array: i64) -> i64
extern fn rt_array_concat(left: i64, right: i64) -> i64
extern fn rt_array_reverse(array: i64) -> i8
extern fn rt_array_reversed(array: i64) -> i64
extern fn rt_array_take(array: i64, count: i64) -> i64
extern fn rt_array_drop(array: i64, count: i64) -> i64
extern fn rt_array_fill(array: i64, value: i64) -> i8
extern fn rt_array_first(array: i64) -> i64
extern fn rt_array_last(array: i64) -> i64
extern fn rt_array_index_of(array: i64, value: i64) -> i64
extern fn rt_array_last_index_of(array: i64, value: i64) -> i64
extern fn rt_array_count(array: i64, value: i64) -> i64
extern fn rt_array_unique(array: i64) -> i64
extern fn rt_array_all_truthy(array: i64) -> i64
extern fn rt_array_any_truthy(array: i64) -> i64
extern fn rt_array_sum(array: i64) -> i64
extern fn rt_array_min(array: i64) -> i64
extern fn rt_array_max(array: i64) -> i64
extern fn rt_array_sort(array: i64) -> i8
extern fn rt_array_zip(left: i64, right: i64) -> i64
extern fn rt_array_enumerate(array: i64) -> i64
extern fn rt_array_flatten(array: i64) -> i64
extern fn array_items(array: i64) -> i64
extern fn array_len_value(array: i64) -> i64
extern fn array_cap(array: i64) -> i64
extern fn array_flags(array: i64) -> i64
extern fn array_is_valid(array: i64) -> i64
extern fn set_array_items(array: i64, items: i64)
extern fn set_array_len(array: i64, length: i64)
extern fn set_array_cap(array: i64, capacity: i64)
extern fn spl_store_u8(ptr: i64, offset: i64, value: i64)
extern fn spl_load_u8(ptr: i64, offset: i64) -> i64
extern fn calloc(count: i64, size: i64) -> i64
extern fn free(ptr: i64)
extern fn __real_realloc(ptr: i64, size: i64) -> i64
extern fn getpagesize() -> i32
extern fn mmap(address: i64, length: i64, protection: i32, flags: i32, descriptor: i32, offset: i64) -> i64
extern fn mprotect(address: i64, length: i64, protection: i32) -> i32
extern fn munmap(address: i64, length: i64) -> i32
extern fn rt_value_int(value: i64) -> i64
extern fn rt_typed_words_u64_at(array: i64, index: i64) -> i64
extern fn rt_typed_words_u64_set(array: i64, index: i64, value: i64) -> i8
extern fn rt_array_extend_i64(dst: i64, src: i64, count: i64) -> i8

var packed_test_fail_growth: bool = false
var packed_test_resize_bytes: i64 = 0

pub fn __wrap_realloc(ptr: i64, size: i64) -> i64:
    packed_test_resize_bytes = size
    if packed_test_fail_growth:
        packed_test_fail_growth = false
        return 0
    __real_realloc(ptr, size)

fn check_canary_push_get_set_pop():
    val array = rt_byte_array_new(0)
    assert(array_is_valid(array) == 1)
    assert(array_flags(array) == 8 and array_cap(array) == 4)
    val owned = array_items(array)
    val guarded = calloc(40, 1)
    assert(guarded > 0)
    var i = 0
    while i < 40:
        spl_store_u8(guarded, i, 165)
        i = i + 1
    set_array_items(array, guarded + 8)
    assert(rt_array_push(array, 65 << 3) == 1)
    # The baseline eight-byte store corrupts this adjacent byte immediately.
    assert(spl_load_u8(guarded, 9) == 165)
    assert(rt_array_push(array, 0) == 1)
    assert(rt_array_push(array, 255 << 3) == 1)
    assert(rt_array_push_no_grow(array, 128 << 3) == 1)
    assert(rt_array_push_no_grow(array, 8 << 3) == 0)
    assert(array_len_value(array) == 4)
    assert(rt_array_get(array, 0) == 65)
    assert(rt_array_get(array, 2) == 255)
    assert(rt_array_get(array, -1) == 128)
    assert(rt_index_get(array, 2 << 3) == 255)
    assert(rt_array_get(array & -8, 2) == 255)
    assert(rt_index_get(array & -8, -8) == 128)
    assert(rt_index_get(array, 3) == 3)
    assert(rt_index_set(array, 3, 0) == 0)
    assert(rt_array_set(array, 1, 8 << 3) == 1)
    assert(rt_index_set(array, 0, 128 << 3) == 1)
    assert(rt_array_get(array, 1) == 8)
    assert(rt_array_get(array, 0) == 128)
    assert(rt_array_set(array, 4, 0) == 0)
    assert(rt_array_get(array, -5) == 3)
    assert(rt_array_pop(array) == 128)
    assert(array_len_value(array) == 3)
    i = 0
    while i < 8:
        assert(spl_load_u8(guarded, i) == 165)
        i = i + 1
    i = 12
    while i < 40:
        assert(spl_load_u8(guarded, i) == 165)
        i = i + 1
    set_array_items(array, owned)
    free(guarded)
    rt_array_free(array)

fn check_growth_and_failure():
    val array = rt_byte_array_new(4)
    var i = 0
    while i < 4:
        assert(rt_array_push(array, (i + 1) << 3) == 1)
        i = i + 1
    val old_items = array_items(array)
    packed_test_fail_growth = true
    assert(rt_array_push(array, 255 << 3) == 0)
    assert(array_items(array) == old_items)
    assert(array_cap(array) == 4 and array_len_value(array) == 4)
    assert(rt_array_get(array, 3) == 4)
    assert(rt_array_push(array, 255 << 3) == 1)
    assert(packed_test_resize_bytes == 8)
    assert(array_cap(array) == 8 and array_len_value(array) == 5)
    assert(rt_array_get(array, 4) == 255)
    assert(rt_typed_bytes_u8_push(array, 128) == 1)
    assert(rt_array_get(array, 5) == 128)
    # Explicit existing generic-byte cast: decoded integer low eight bits.
    assert(rt_array_push(array, 256 << 3) == 1)
    assert(rt_array_push(array, -8) == 1)
    assert(rt_array_get(array, 6) == 0 and rt_array_get(array, 7) == 255)
    packed_test_fail_growth = true
    val before_typed = array_items(array)
    assert(rt_typed_bytes_u8_push(array, 8) == 0)
    assert(array_items(array) == before_typed)
    assert(array_len_value(array) == 8 and array_cap(array) == 8)
    assert(rt_typed_bytes_u8_push(array, 8) == 1)
    assert(packed_test_resize_bytes == 16 and rt_array_get(array, 8) == 8)
    assert(rt_array_push(array, rt_value_int(9223372036854775807)) == 1)
    assert(rt_array_get(array, 9) == 255)
    rt_array_free(array)
    assert(rt_byte_array_new_len(-1) == 0)
    assert(rt_byte_array_new(-1) == 0)
    val empty = rt_byte_array_new_len(0)
    assert(array_is_valid(empty) == 1 and array_len_value(empty) == 0)
    assert(rt_array_pop(empty) == 3)
    assert(rt_array_push(empty, 8 << 3) == 1)
    rt_array_free(empty)
    assert(rt_byte_array_new(100000001) == 0)
    assert(rt_byte_array_new(9223372036854775807) == 0)
    assert(rt_array_push(0, 0) == 0)
    val bounded = rt_byte_array_new(4)
    set_array_cap(bounded, 100000000)
    set_array_len(bounded, 100000000)
    assert(rt_array_push(bounded, 0) == 0)
    assert(array_cap(bounded) == 100000000 and array_len_value(bounded) == 100000000)
    set_array_len(bounded, 60000000)
    set_array_cap(bounded, 60000000)
    packed_test_fail_growth = true
    val bounded_items = array_items(bounded)
    assert(rt_array_push(bounded, 0) == 0)
    assert(packed_test_resize_bytes == 100000000)
    assert(array_items(bounded) == bounded_items)
    assert(array_cap(bounded) == 60000000 and array_len_value(bounded) == 60000000)
    set_array_len(bounded, 0)
    set_array_cap(bounded, 4)
    rt_array_free(bounded)

fn check_operations_and_queries():
    val page = getpagesize() as i64
    assert(page >= 5)
    val mapping = mmap(0, page * 2, 3, 34, -1, 0)
    assert(mapping != -1 and mapping != 0)
    assert(mprotect(mapping + page, page, 0) == 0)
    val bytes = rt_byte_array_new(5)
    val owned = array_items(bytes)
    # Reads or writes with word stride cross the inaccessible next page.
    set_array_items(bytes, mapping + page - 5)
    assert(rt_array_push(bytes, 255 << 3) == 1)
    assert(rt_array_push(bytes, 8 << 3) == 1)
    assert(rt_array_push(bytes, 128 << 3) == 1)
    assert(rt_array_push(bytes, 0) == 1)
    assert(rt_array_push(bytes, 8 << 3) == 1)
    assert(rt_typed_words_u64_at(bytes, 0) == 0)
    assert(rt_typed_words_u64_set(bytes, 0, -1) == 0)
    assert(rt_array_extend_i64(bytes, bytes, 1) == 0)
    assert(rt_array_first(bytes) == 255 and rt_array_last(bytes) == 8)
    assert(rt_array_index_of(bytes, 8 << 3) == 1)
    assert(rt_array_last_index_of(bytes, 8 << 3) == 4)
    assert(rt_array_count(bytes, 8 << 3) == 2)
    assert(rt_array_count(bytes & -8, 8 << 3) == 2)
    assert(rt_array_index_of(bytes & -8, 128 << 3) == 2)
    assert(rt_array_index_of(bytes, 256 << 3) == -1)
    assert(rt_array_all_truthy(bytes) == 0 and rt_array_any_truthy(bytes) == 1)
    assert(rt_array_sum(bytes) == (399 << 3))
    assert(rt_array_min(bytes) == 0 and rt_array_max(bytes) == (255 << 3))
    val unique = rt_array_unique(bytes)
    assert(array_len_value(unique) == 4)
    assert(rt_array_get(unique, 0) == (255 << 3))
    rt_array_free(unique)
    val copied = rt_array_copy(bytes)
    assert(array_flags(copied) == 8 and array_len_value(copied) == 5)
    assert(rt_array_set(copied, 0, 8 << 3) == 1)
    assert(rt_array_get(bytes, 0) == 255)
    rt_array_free(copied)
    val combined = rt_array_concat(bytes, bytes)
    assert(array_flags(combined) == 8 and array_len_value(combined) == 10)
    assert(rt_array_get(combined, 5) == 255)
    rt_array_free(combined)
    val taken = rt_array_take(bytes, 2)
    val dropped = rt_array_drop(bytes, 3)
    assert(array_flags(taken) == 8 and array_len_value(taken) == 2)
    assert(rt_array_get(taken, 1) == 8)
    assert(array_flags(dropped) == 8 and array_len_value(dropped) == 2)
    assert(rt_array_get(dropped, 0) == 0)
    rt_array_free(taken)
    rt_array_free(dropped)
    val reversed = rt_array_reversed(bytes)
    assert(array_flags(reversed) == 8 and rt_array_get(reversed, 4) == 255)
    assert(rt_array_reverse(reversed) == 1 and rt_array_get(reversed, 0) == 255)
    assert(rt_array_fill(reversed, 128 << 3) == 1)
    assert(rt_array_get(reversed, 0) == 128 and rt_array_get(reversed, 4) == 128)
    rt_array_free(reversed)
    assert(rt_array_sort(bytes) == 1)
    assert(rt_array_get(bytes, 0) == 0 and rt_array_get(bytes, 4) == 255)
    assert(rt_array_get(bytes, 1) == 8 and rt_array_get(bytes, 3) == 128)
    val words = rt_array_new(1)
    assert(rt_array_push(words, 999 << 3) == 1)
    val mixed = rt_array_concat(words, bytes)
    assert(array_flags(mixed) == 0 and array_len_value(mixed) == 6)
    assert(rt_array_get(mixed, 0) == (999 << 3) and rt_array_get(mixed, 5) == (255 << 3))
    rt_array_free(mixed)
    val pairs = rt_array_zip(bytes, words)
    val pair = rt_array_get(pairs, 0)
    assert(rt_array_get(pair, 0) == 0 and rt_array_get(pair, 1) == (999 << 3))
    rt_array_free(pair)
    rt_array_free(pairs)
    val enumerated = rt_array_enumerate(bytes)
    var i = 0
    while i < 5:
        val item = rt_array_get(enumerated, i)
        assert(rt_array_get(item, 0) == (i << 3))
        assert(rt_array_get(item, 1) == (rt_array_get(bytes, i) << 3))
        rt_array_free(item)
        i = i + 1
    rt_array_free(enumerated)
    val outer = rt_array_new(1)
    assert(rt_array_push(outer, bytes) == 1)
    val flattened = rt_array_flatten(outer)
    assert(array_len_value(flattened) == 5 and rt_array_get(flattened, 4) == (255 << 3))
    rt_array_free(flattened)
    rt_array_free(outer)
    rt_array_free(words)
    set_array_items(bytes, owned)
    rt_array_free(bytes)
    assert(munmap(mapping, page * 2) == 0)

fn check_word_storage():
    val words = rt_array_new_with_cap_u64(4)
    var i = 0
    while i < 5:
        assert(rt_array_push(words, -9223372036854775807 - 1 + i) == 1)
        i = i + 1
    assert(packed_test_resize_bytes == 64)
    assert(rt_array_get(words, 0) == -9223372036854775807 - 1)
    assert(rt_array_set(words, 1, 9223372036854775807) == 1)
    assert(rt_array_get(words, 1) == 9223372036854775807)
    assert(rt_array_pop(words) == -9223372036854775807 - 1 + 4)
    rt_array_free(words)

fn main() -> i64:
    check_canary_push_get_set_pop()
    check_growth_and_failure()
    check_operations_and_queries()
    check_word_storage()
    print "PASS pure-Simple packed byte owner: canaries, growth rollback, operations, queries, wide word parity"
    0
