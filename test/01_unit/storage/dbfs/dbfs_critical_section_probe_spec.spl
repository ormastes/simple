## DBFS critical-section provider admission probe.
##
## Reproduce guard for the SimpleOS/dbfs blocker. DBFS's device commit owner
## may not admit a serialization provider on a platform its static allowlist
## does not know unless that provider passes a BEHAVIOURAL handshake, because
## on freestanding targets a link-time stub is indistinguishable from a real
## lock by any static test -- and the stubs actually shipped there are
## deceptive rather than merely inert.
##
## Measured 2026-09-01 by disassembling build/os/simpleos_dbfsrt_uefi.elf:
##   spl_mutex_create  ->  movl $0x8, %eax ; ret    (a NONZERO fake handle)
##   spl_mutex_lock    ->  movl $0x3, %eax ; ret    (TRUTHY)
## so `handle > 0 and lock succeeded` admits a lock that locks nothing. The
## decisive leg is therefore that releasing an ALREADY-RELEASED word must
## FAIL: a real provider fail-stops, a constant-return stub reports success.

use std.spipe.*
use nogc_sync_mut.db.dbfs_driver.device_commit_owner.{
    DBFS_DEVICE_SERIALIZATION_PROBE_FAILED,
    dbfs_device_mutex_probe_verdict
}

describe "dbfs critical-section provider admission probe":

    it "admits a provider that passes every leg":
        expect(dbfs_device_mutex_probe_verdict(
            17, true, true, false, true, true)).to_equal("ready")

    it "rejects the measured deceptive freestanding stub (nonzero handle, truthy lock, truthy double unlock)":
        # handle=8 and lock=3 are the literal measured stub return values.
        expect(dbfs_device_mutex_probe_verdict(
            8, true, true, true, true, true)).to_equal(
                DBFS_DEVICE_SERIALIZATION_PROBE_FAILED)

    it "rejects a provider that cannot allocate a lock word":
        expect(dbfs_device_mutex_probe_verdict(
            0, true, true, false, true, true)).to_equal(
                DBFS_DEVICE_SERIALIZATION_PROBE_FAILED)
        expect(dbfs_device_mutex_probe_verdict(
            -1, true, true, false, true, true)).to_equal(
                DBFS_DEVICE_SERIALIZATION_PROBE_FAILED)

    it "rejects a provider that cannot acquire":
        expect(dbfs_device_mutex_probe_verdict(
            17, false, false, false, false, false)).to_equal(
                DBFS_DEVICE_SERIALIZATION_PROBE_FAILED)

    it "rejects a provider that cannot release":
        expect(dbfs_device_mutex_probe_verdict(
            17, true, false, false, false, false)).to_equal(
                DBFS_DEVICE_SERIALIZATION_PROBE_FAILED)

    it "rejects a provider whose word does not return to unlocked":
        expect(dbfs_device_mutex_probe_verdict(
            17, true, true, false, false, false)).to_equal(
                DBFS_DEVICE_SERIALIZATION_PROBE_FAILED)

    it "rejects a provider that cannot release the reacquired word":
        expect(dbfs_device_mutex_probe_verdict(
            17, true, true, false, true, false)).to_equal(
                DBFS_DEVICE_SERIALIZATION_PROBE_FAILED)
