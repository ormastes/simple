use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text

fn example_source(path: text) -> text:
    rt_file_read_text("examples/06_io/simple_web_server/" + path) ?? ""

describe "standalone Simple web server source root":
    it "imports main dependencies from the declared example source root":
        val main = example_source("main.spl")
        expect(main).to_contain('use config.{ServerConfig, parse_args}')
        expect(main).to_contain('use routes.{register_routes}')
        expect(main.contains("use examples.simple_web_server.")).to_be(false)

    it "keeps adjacent route imports in the same source-root namespace":
        val routes = example_source("routes.spl")
        for module in ["config", "static_files", "error_pages", "middleware"]:
            expect(routes).to_contain("use " + module + ".{")
        expect(routes.contains("use examples.simple_web_server.")).to_be(false)
