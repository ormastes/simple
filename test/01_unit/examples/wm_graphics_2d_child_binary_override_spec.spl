use std.io_runtime.{file_read}

val ENTRY: text = "examples/06_io/ui/wm_graphics_2d_showcase_gui.spl"

describe "host WM graphics 2D child driver override":

    it "uses an explicit admitted child binary and preserves the deployment fallback":
        val s = file_read(ENTRY)
        expect(s).to_contain(
            "env_get(\"SIMPLE_WM_CHILD_SIMPLE_BINARY\") ?? \"\"")
        expect(s).to_contain("if configured_simple_bin == \"\":")
        expect(s).to_contain("path_join(repo_root, \"bin/simple\")")
        expect(s).to_contain("else:\n        configured_simple_bin")
        expect(s).to_contain(
            "process_spawn_async_env(simple_bin, [\"run\", showcase_source_path], env)")
        expect(s).to_contain(
            "simple_bin,\n        \"run\",\n        showcase_source_path")
