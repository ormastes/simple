# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Test: uniq tool
# Feature: TOOL-UNIQ - Report or omit repeated lines

# Local reimplementation to avoid interpreter-mode import issues
# (importing app.tools.uniq.main fails with "cannot index string with type `symbol`")

use std.spec.step

fn lines_equal(a: text, b: text, ignore_case: bool) -> bool:
    """Compare two lines, optionally ignoring case."""
    if ignore_case:
        a.lower() == b.lower()
    else:
        a == b

describe "uniq tool":
    # @manual scenario evidence
    context "line comparison":
        it "detects equal lines":
            # @req REQ-SSPEC-UNIT
            step("detects equal lines")
            val result = lines_equal("hello", "hello", false)
            expect(result).to_equal(true)

        it "detects different lines":
            # @req REQ-SSPEC-UNIT
            step("detects different lines")
            val result = lines_equal("hello", "world", false)
            expect(result).to_equal(false)

        it "compares case-insensitively":
            # @req REQ-SSPEC-UNIT
            step("compares case-insensitively")
            val result = lines_equal("Hello", "hello", true)
            expect(result).to_equal(true)

        it "rejects different lines case-insensitively":
            # @req REQ-SSPEC-UNIT
            step("rejects different lines case-insensitively")
            val result = lines_equal("Hello", "World", true)
            expect(result).to_equal(false)
