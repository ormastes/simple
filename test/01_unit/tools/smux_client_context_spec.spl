"""Shared-focus attachment projection controls. Pure owner values; NOT_RUN."""
use std.spec.{describe, it, expect}
use os.apps.smux.contract.{MuxSession, MuxWindow, MuxPane, MuxClientAttachment, MuxPanePresentation}
use os.apps.smux.service.{ServiceState, PaneRecord}
use os.apps.smux.client_context_service.*
use os.apps.smux.client_attachment_service.{client_attach_leased, client_resize_leased, client_attach_unmanaged}
use os.apps.smux.client_leases.{smux_leases_new}
use os.apps.smux.service_revision.{service_configuration_equal, service_revision_new, service_revision_publish}
use std.common.contracts.mux.execution_v1.{MuxBorderV1, MuxBorderStatusV1}

fn context_fixture() -> ServiceState:
    var st = ServiceState.empty()
    st = st.add_session(MuxSession.create("s1", "one"))
    st = st.add_session(MuxSession.create("s2", "two"))
    st = st.add_window(MuxWindow.create("w1", "s1", "first").with_active(true))
    st = st.add_window(MuxWindow.create("w2", "s1", "second"))
    st = st.add_window(MuxWindow.create("w3", "s2", "other").with_active(true))
    st = st.add_pane(PaneRecord.create(MuxPane.create("p1", "w1", "s1")).with_focus(true))
    st = st.add_pane(PaneRecord.create(MuxPane.create("p2", "w1", "s1")))
    st = st.add_pane(PaneRecord.create(MuxPane.create("p3", "w2", "s1")).with_focus(true))
    st = st.add_pane(PaneRecord.create(MuxPane.create("p4", "w3", "s2")).with_focus(true))
    st = st.add_client(MuxClientAttachment(client_id: "a", session_id: "s1", attached: true, cols: 80, rows: 24, attachment_generation: 1))
    st = st.add_client(MuxClientAttachment(client_id: "b", session_id: "s1", attached: true, cols: 90, rows: 30, attachment_generation: 2))
    st = st.add_client(MuxClientAttachment(client_id: "c", session_id: "s2", attached: true, cols: 100, rows: 40, attachment_generation: 3))
    return client_context_reconcile(st)

describe "Canonical shared client context":
    it "projects the same shared focus for two clients while keeping viewport and identity separate":
        val st = context_fixture()
        for index in [0, 1]:
            expect(st.get_client(index).current_window).to_equal("w1")
            expect(st.get_client(index).current_pane).to_equal("p1")
        expect(st.get_client(0).attachment_generation).to_equal(1)
        expect(st.get_client(1).attachment_generation).to_equal(2)
        expect(st.get_client(0).cols).to_equal(80)
        expect(st.get_client(1).cols).to_equal(90)
        expect(service_configuration_equal(st, client_context_reconcile(st))).to_equal(true)

    it "moves both projections on shared focus change without touching another session":
        val before = context_fixture()
        var changed = before.replace_pane(0, before.get_pane(0).with_focus(false))
        changed = changed.replace_pane(1, changed.get_pane(1).with_focus(true))
        changed = client_context_reconcile(changed)
        expect(changed.get_client(0).current_pane).to_equal("p2")
        expect(changed.get_client(1).current_pane).to_equal("p2")
        expect(changed.get_client(2).current_pane).to_equal("p4")
        changed = changed.replace_window(0, changed.get_window(0).with_active(false))
        changed = changed.replace_window(1, changed.get_window(1).with_active(true))
        changed = client_context_reconcile(changed)
        expect(changed.get_client(0).current_window).to_equal("w2")
        expect(changed.get_client(1).current_pane).to_equal("p3")
        expect(changed.get_client(2).current_window).to_equal("w3")
        val revision = service_revision_publish(service_revision_new(), before, changed, [], [], [])
        expect(revision.value).to_equal(2)
        expect(service_revision_publish(revision, changed, client_context_reconcile(changed), [], [], []).value).to_equal(2)

    it "does not accept caller-supplied private pane context":
        val st = context_fixture()
        val supplied = MuxClientAttachment(client_id: "a", session_id: "s1", attached: true,
            cols: 80, rows: 24, attachment_generation: 1, current_window: "w2", current_pane: "p3")
        val changed = client_context_put(st, 0, supplied)
        expect(changed.get_client(0).current_window).to_equal("w1")
        expect(changed.get_client(0).current_pane).to_equal("p1")
        expect(changed.get_client(1).client_id).to_equal("b")
        expect(service_configuration_equal(st, changed)).to_equal(true)

    it "refuses stale unmanaged or wrong-session identity without renewing anything":
        val st = context_fixture()
        expect(client_context_lookup(st, "s1", "a", 1).unwrap().current_pane).to_equal("p1")
        expect(client_context_lookup(st, "s1", "a", 2).is_err()).to_equal(true)
        expect(client_context_lookup(st, "s2", "a", 1).is_err()).to_equal(true)
        expect(client_context_lookup(st, "s1", "a", 0).is_err()).to_equal(true)
        expect(client_context_lookup(st, "s1", "missing", 1).is_err()).to_equal(true)

    it "clears ambiguous invisible and detached projections without inventing shared focus":
        val st = context_fixture()
        val ambiguous = st.replace_pane(1, st.get_pane(1).with_focus(true))
        expect(client_context_reconcile(ambiguous).get_client(0).current_pane).to_equal("")
        val two_active = st.replace_window(1, st.get_window(1).with_active(true))
        expect(client_context_reconcile(two_active).get_client(1).current_window).to_equal("")
        val window = st.get_window(0)
        val hidden = MuxWindow(id: window.id, session_id: window.session_id, name: window.name,
            is_active: true, layout: window.layout, canvas_cols: 80, canvas_rows: 24,
            manual_rects: [], manual_cols: 80, manual_rows: 24,
            presentation: [MuxPanePresentation(pane_id: "p1", title: "", hidden: true,
                border: MuxBorderV1.Hidden, status: MuxBorderStatusV1.Hidden)])
        expect(client_context_reconcile(st.replace_window(0, hidden)).get_client(0).current_pane).to_equal("")
        val detached = MuxClientAttachment(client_id: "a", session_id: "s1", attached: false,
            cols: 80, rows: 24, attachment_generation: 1, current_window: "w1", current_pane: "p1")
        expect(client_context_project(st, detached).current_window).to_equal("")
        expect(client_context_project(ServiceState.empty(), st.get_client(0)).current_pane).to_equal("")

    it "projects shared zoom only when it agrees with the active pane":
        val st = context_fixture()
        val window = st.get_window(0)
        val mismatch = MuxWindow(id: window.id, session_id: window.session_id, name: window.name,
            is_active: true, layout: window.layout, canvas_cols: 80, canvas_rows: 24,
            manual_rects: [], manual_cols: 80, manual_rows: 24, zoom_pane: "p2")
        expect(client_context_reconcile(st.replace_window(0, mismatch)).get_client(0).current_pane).to_equal("")
        var focused = st.replace_window(0, mismatch)
        focused = focused.replace_pane(0, focused.get_pane(0).with_focus(false))
        focused = focused.replace_pane(1, focused.get_pane(1).with_focus(true))
        expect(client_context_reconcile(focused).get_client(0).current_pane).to_equal("p2")
        expect(client_context_reconcile(focused).get_client(1).current_pane).to_equal("p2")

    it "rebinds managed context across sessions and refuses an unmanaged downgrade":
        var st = context_fixture()
        while st.client_count > 0: st = st.remove_client(st.client_count - 1)
        val leases = smux_leases_new("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb").unwrap()
        val first = client_attach_leased(st, leases, false, "s1", "moving", 80, 24, 100).unwrap()
        val original = first.state.get_client(0)
        val moved = client_attach_leased(first.state, first.leases, false, "s2", "moving", 90, 30, 200).unwrap()
        val replacement = moved.state.get_client(0)
        expect(replacement.session_id).to_equal("s2")
        expect(replacement.current_window).to_equal("w3")
        expect(replacement.current_pane).to_equal("p4")
        expect(replacement.attachment_generation).to_be_greater_than(original.attachment_generation)
        expect(moved.cleared.len()).to_equal(1)
        expect(moved.cleared[0].session_id).to_equal("s1")
        expect(client_context_lookup(moved.state, "s1", "moving", original.attachment_generation).is_err()).to_equal(true)
        expect(client_resize_leased(moved.state, moved.leases, false, "s1", "moving", first.token, 80, 24, 201).is_err()).to_equal(true)
        expect(client_attach_unmanaged(moved.state, moved.leases, false, "s2", "moving", 90, 30).is_err()).to_equal(true)
        expect(client_attach_unmanaged(moved.state, moved.leases, false, "s1", "moving", 80, 24).is_err()).to_equal(true)
        expect(client_context_lookup(moved.state, "s2", "moving", replacement.attachment_generation).unwrap().current_pane).to_equal("p4")

    it "preserves context on renewal and changes canonical generation on reattach":
        var st = context_fixture()
        while st.client_count > 0: st = st.remove_client(st.client_count - 1)
        val leases = smux_leases_new("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa").unwrap()
        val first = client_attach_leased(st, leases, false, "s1", "a", 80, 24, 100).unwrap()
        val second = client_attach_leased(first.state, first.leases, false, "s1", "b", 90, 30, 100).unwrap()
        val renewed = client_resize_leased(second.state, second.leases, false, "s1", "a", first.token, 80, 24, 200).unwrap()
        expect(service_configuration_equal(second.state, renewed.state)).to_equal(true)
        expect(renewed.leases.leases[0].deadline_ms).to_be_greater_than(second.leases.leases[0].deadline_ms)
        val rebound = client_attach_leased(renewed.state, renewed.leases, false, "s1", "a", 80, 24, 300).unwrap()
        expect(rebound.state.get_client(0).attachment_generation).to_be_greater_than(first.state.get_client(0).attachment_generation)
        expect(rebound.state.get_client(0).current_pane).to_equal("p1")
        expect(rebound.state.get_client(1).client_id).to_equal("b")
        expect(client_context_lookup(rebound.state, "s1", "a", first.state.get_client(0).attachment_generation).is_err()).to_equal(true)
