# Test: cut tool
# Feature: TOOL-CUT - Remove sections from lines
# @cover tools/shell/cut/cut_tool.spl

"""
## Purpose and audience
Purpose: extracts fields by delimiter
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-TOOLS-Cut-001

use std.spec.step
describe "cut tool":
    context "field extraction":
        it "extracts fields by delimiter":
            step("Verify: extracts fields by delimiter")
            # @req: REQ-TOOLS-Cut-001
            val line = "one:two:three:four"
            val parts = line.split(":")
            expect(parts.len()).to_equal(4)  # oracle: value fixed by the spec contract
            expect(parts[0]).to_equal("one")
            expect(parts[2]).to_equal("three")

        it "handles tab delimiter":
            step("Verify: handles tab delimiter")
            # @req: REQ-TOOLS-Cut-001
            val line = "a\tb\tc"
            val parts = line.split("\t")
            expect(parts.len()).to_equal(3)  # oracle: value fixed by the spec contract

    context "character extraction":
        it "extracts characters by position":
            step("Verify: extracts characters by position")
            # @req: REQ-TOOLS-Cut-001
            val line = "abcdef"
            expect(line.char_at(0)).to_equal("a")
            expect(line.char_at(2)).to_equal("c")

    context "field list parsing":
        it "parses comma-separated field numbers":
            step("Verify: parses comma-separated field numbers")
            # @req: REQ-TOOLS-Cut-001
            val spec = "1,3,5"
            val parts = spec.split(",")
            expect(parts.len()).to_equal(3)  # oracle: value fixed by the spec contract
            expect(parts[0]).to_equal("1")
