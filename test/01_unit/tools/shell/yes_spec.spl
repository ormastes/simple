# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-TOOLS
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md


# Test: yes tool
# Feature: TOOL-YES - Repeatedly output string
# @cover tools/shell/yes/yes_tool.spl

use std.spec.step

describe "yes tool":
    # @manual scenario evidence
    context "default output":
        it "outputs y by default":
            # @req REQ-SSPEC-TOOLS
            step("outputs y by default")
            val default_msg = "y"
            expect(default_msg).to_equal("y")

    context "custom string":
        it "outputs custom message":
            # @req REQ-SSPEC-TOOLS
            step("outputs custom message")
            val msg = "hello"
            expect(msg).to_equal("hello")
