# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-TOOLS
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Test: base64 tool
# Feature: TOOL-BASE64 - Encode/decode base64
# @cover src/os/tools/shell/base64/base64_tool.spl

use std.spec.step

describe "base64 tool":
    # @manual scenario evidence
    context "encoding":
        it "encodes empty string":
            # @req REQ-SSPEC-TOOLS
            step("encodes empty string")
            val input = ""
            expect(input.len()).to_equal(0)

        it "produces padded output":
            # @req REQ-SSPEC-TOOLS
            step("produces padded output")
            # Base64 output length is always multiple of 4
            val output_len = 8
            expect(output_len % 4).to_equal(0)

    context "character set":
        it "uses standard base64 alphabet":
            # @req REQ-SSPEC-TOOLS
            step("uses standard base64 alphabet")
            val chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            expect(chars.len()).to_equal(64)
