#!/usr/bin/env bash
# Actual compiled helper acceptance. No synthetic crypto or seed fallback.
set -euo pipefail
umask 077
helper="${MAIL_REAL_CREDENTIAL_BIN:?Set MAIL_REAL_CREDENTIAL_BIN to the admitted compiled Simple credential helper}"
[ -x "$helper" ] || { echo 'real_helper_unavailable: FAIL' >&2; exit 1; }
case "$helper" in /*) ;; *) echo 'helper_must_be_absolute: FAIL' >&2; exit 1 ;; esac
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
export HOME="$work/home"
mkdir -p "$HOME"
first=$(printf 'roundtrip-fixture-secret\n' | "$helper" encrypt)
second=$(printf 'roundtrip-fixture-secret\n' | "$helper" encrypt)
case "$first" in encrypted:v2:*) ;; *) exit 1 ;; esac
[ "$first" != "$second" ]
decoded=$(printf '%s\n' "$first" | "$helper" decrypt)
[ "$decoded" = roundtrip-fixture-secret ]
printf 'real_crypto_roundtrip_random_iv: PASS\n'
[ -f "$HOME/.simple/credential_key" ]
perms=$(stat -c '%a' "$HOME/.simple/credential_key" 2>/dev/null || stat -f '%A' "$HOME/.simple/credential_key")
[ "$perms" = 600 ]
printf 'real_key_owner_only: PASS\n'
for value in '' plaintext encrypted:v2:malformed; do
  rc=0
  printf '%s\n' "$value" | "$helper" decrypt > "$work/output" 2> "$work/error" || rc=$?
  [ "$rc" != 0 ] && [ ! -s "$work/output" ]
done
rc=0
printf 'fixture\n' | "$helper" unknown > "$work/output" 2> "$work/error" || rc=$?
[ "$rc" = 2 ] && [ ! -s "$work/output" ]
printf 'real_invalid_decrypt_fails_closed: PASS\n'
