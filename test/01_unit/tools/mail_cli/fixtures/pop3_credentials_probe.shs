#!/usr/bin/env bash
# Host-fixture evidence only: real client, synthetic curl and credential helper.
# Never claims transport interoperability or real encryption correctness.
set -euo pipefail
umask 077
root=$(cd "$(dirname "$0")/../../../../.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
export HOME="$work/home" TMPDIR="$work" MAIL_NONINTERACTIVE=1
export MAIL_CURL_RETRY_DELAY=0 MAIL_CURL_MAX_RETRIES=2
unset MAIL_PASSWORD_FILE MAIL_PASSWORD_COMMAND MAIL_ACCOUNT MAIL_AUTH_RECOVERY MAIL_CONFIG_DIR MAIL_CONFIG_FILE
export PROBE_LOG="$work/requests" PROBE_COUNT="$work/count" PROBE_EXPECT=old-secret
export PROBE_MODE=normal PROBE_RC=0 PROBE_HELPER_MODE=normal
mkdir -p "$HOME/.config/mail-cli" "$work/bin"
export MAIL_CREDENTIAL_BIN="$work/bin/credential"
export PATH="$work/bin:$PATH"
client="$root/tools/mail-cli/bin/mail"
config="$HOME/.config/mail-cli/config.json"

cat > "$work/bin/curl" <<'CURL'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$@" >> "$PROBE_LOG"
[ "${1:-}" = --disable ] || exit 98
for arg in "$@"; do
  case "$arg" in *old-secret*|*new-secret*|*command-secret*|--user) exit 99 ;; esac
done
url= request= auth=
while [ $# -gt 0 ]; do
  case "$1" in
    --config) auth=$(cat "$2"); shift 2 ;;
    --url) url="$2"; shift 2 ;;
    --request) request="$2"; shift 2 ;;
    *) shift ;;
  esac
done
count=0; [ ! -f "$PROBE_COUNT" ] || count=$(cat "$PROBE_COUNT")
printf '%s\n' "$((count + 1))" > "$PROBE_COUNT"
[ "$auth" = "user = \"alice@example.test:${PROBE_EXPECT}\"" ] || exit 67
[ "$PROBE_RC" = 0 ] || exit "$PROBE_RC"
[ "$request" != NOOP ] || exit 0
case "$url" in
  pop3://*/|pop3s://*/)
    case "$PROBE_MODE" in
      empty) exit 0 ;;
      malformed) printf 'unexpected response\n'; exit 0 ;;
      *) printf '1 200\r\n2 210\r\n'; exit 0 ;;
    esac ;;
  pop3://*/[12]|pop3s://*/[12])
    printf 'From: sender@example.test\r\nTo: alice@example.test\r\nSubject: Message %s\r\nMessage-ID: <fixture@example.test>\r\nContent-Type: text/plain\r\n\r\nFixture body.\r\n' "${url##*/}" ;;
  smtps://*|smtp://*) exit 0 ;;
  *) exit 97 ;;
esac
CURL
cat > "$MAIL_CREDENTIAL_BIN" <<'HELPER'
#!/usr/bin/env bash
set -euo pipefail
[ "$#" = 1 ] || exit 90
IFS= read -r value
[ "$PROBE_HELPER_MODE" != fail ] || exit 1
# Deliberately opaque tokens, NOT an encryption implementation.
case "$1:$value" in
  encrypt:new-secret) printf 'encrypted:v2:synthetic-new-token\n' ;;
  decrypt:encrypted:v2:synthetic-new-token) printf 'new-secret\n' ;;
  decrypt:encrypted:v2:synthetic-old-token) printf 'old-secret\n' ;;
  *) exit 1 ;;
esac
HELPER
chmod 700 "$work/bin/curl" "$MAIL_CREDENTIAL_BIN"
cat > "$config" <<'CONFIG'
{"default_account":"work","accounts":{"work":{"protocol":"pop3","email":"alice@example.test","username":"alice@example.test","display_name":"Alice","pop3_server":"pop.example.test","pop3_port":995,"imap_server":"imap.example.test","imap_port":993,"smtp_server":"smtp.example.test","smtp_port":465,"tls":"implicit","password":"encrypted:v2:synthetic-old-token"}}}
CONFIG
chmod 600 "$config"
pass() { printf '%s: PASS\n' "$1"; }
die() { printf '%s: FAIL\n' "$1" >&2; exit 1; }
call() {
  : > "$PROBE_LOG"; rm -f "$PROBE_COUNT"
  rc=0
  "$client" "$@" > "$work/out" 2> "$work/err" || rc=$?
}
status() { [ "$rc" = "$1" ] || die "exit expected $1, got $rc ($2)"; }
change() { jq "$1" "$config" > "$work/config"; mv "$work/config" "$config"; }
group="${1:-all}"

if [ "$group" = all ] || [ "$group" = protocol ]; then
  call inbox --json --limit 1
  status 0 inbox
  jq -e 'length == 1 and .[0].uid == "2" and .[0].protocol == "pop3" and .[0].subject == "Message 2"' "$work/out" >/dev/null
  [ "$(cat "$PROBE_COUNT")" = 2 ] || die inbox_request_bound
  pass pop3_inbox_json_limit
  call read 1 --raw; status 0 read
  grep -q 'Fixture body' "$work/out" || die read_body
  pass pop3_read_body
  PROBE_MODE=empty call inbox --json; status 0 empty
  jq -e 'length == 0' "$work/out" >/dev/null
  pass pop3_empty_json
  PROBE_MODE=malformed call inbox --json; status 1 malformed
  pass pop3_malformed_rejected
  for command in search folder star archive delete move draft; do
    call "$command" 1; status 2 "$command"
    [ ! -s "$PROBE_LOG" ] || die unsupported_contacted_server
  done
  for args in '--unread' '--threads' '--folder Trash' '--limit 0' '--limit 1001' '--limit nope'; do
    # Deliberately split the fixed fixture arguments.
    call inbox $args; status 2 invalid_inbox
  done
  call read ../1 --raw; status 2 invalid_id
  pass pop3_unsupported_and_invalid
  change '.accounts.work.tls="none"'
  call inbox --json; status 2 cleartext
  [ ! -s "$PROBE_LOG" ] || die cleartext_contacted_server
  pass pop3_cleartext_rejected
  change '.accounts.work.tls="starttls"'
  call inbox --json --limit 1; status 0 starttls
  grep -qx -- '--ssl-reqd' "$PROBE_LOG" || die starttls_missing
  grep -qx 'pop3://pop.example.test:995/' "$PROBE_LOG" || die starttls_scheme
  pass pop3_starttls_required
  change '.accounts.work.tls="implicit"'
  for command in send reply forward; do
    case "$command" in
      send) call send --to recipient@example.test --subject fixture --body hello ;;
      reply) call reply 1 --body hello ;;
      forward) call forward 1 --to recipient@example.test --body hello ;;
    esac
    status 0 "$command"
    grep -qx 'smtps://smtp.example.test:465' "$PROBE_LOG" || die smtp_not_used
  done
  pass pop3_send_reply_forward
fi

if [ "$group" = all ] || [ "$group" = credentials ]; then
  printf 'new-secret\n' > "$work/password"
  PROBE_EXPECT=new-secret call inbox --json --password-file "$work/password"
  status 0 file_override
  pass password_file_overrides_encrypted
  PROBE_EXPECT=command-secret call inbox --json --password-cmd 'printf command-secret'
  status 0 command_override
  pass password_command_overrides_encrypted
  call inbox --password-file "$work/password" --password-cmd 'printf command-secret'
  status 2 conflicting_overrides
  printf 'new-secret\nextra-line\n' > "$work/password"
  call inbox --password-file "$work/password"; status 2 multiline
  [ ! -s "$PROBE_LOG" ] || die multiline_contacted_server
  pass conflicting_and_multiline_rejected
  printf 'new-secret\n' > "$work/password"
  before=$(cat "$config")
  PROBE_RC=67 call auth password --password-file "$work/password"
  [ "$rc" != 0 ] || die rejected_password_saved
  [ "$(cat "$config")" = "$before" ] || die old_password_changed
  PROBE_EXPECT=new-secret PROBE_HELPER_MODE=fail call auth password --password-file "$work/password"
  [ "$rc" != 0 ] || die helper_failure_success
  [ "$(cat "$config")" = "$before" ] || die helper_failure_overwrote_config
  pass failed_validation_and_encryption_preserve_old
  PROBE_EXPECT=new-secret call auth password --password-file "$work/password"
  status 0 save
  jq -e '.accounts.work.password == "encrypted:v2:synthetic-new-token" and (.accounts.work | has("password_cmd") | not)' "$config" >/dev/null
  ! grep -q 'new-secret' "$config" || die saved_plaintext
  perms=$(stat -c '%a' "$config" 2>/dev/null || stat -f '%A' "$config")
  [ "$perms" = 600 ] || die config_mode
  PROBE_EXPECT=new-secret call inbox --json; status 0 decrypt_saved
  pass encrypted_save_and_reload_orchestration
  change '.accounts.work.password="encrypted:v2:synthetic-old-token"'
fi

if [ "$group" = all ] || [ "$group" = transport ]; then
  PROBE_RC=67 call read 1 --raw
  status 67 rejected
  [ "$(cat "$PROBE_COUNT")" = 1 ] || die authentication_retried_noninteractive
  grep -q 'mail auth password' "$work/err" || die missing_recovery_hint
  pass noninteractive_rejection_bounded
  PROBE_RC=28 call send --to recipient@example.test --subject fixture --body hello
  [ "$rc" != 0 ] || die smtp_timeout_success
  [ "$(cat "$PROBE_COUNT")" = 1 ] || die smtp_timeout_retried
  pass smtp_timeout_never_retried
  PROBE_RC=7 call send --to recipient@example.test --subject fixture --body hello
  [ "$rc" != 0 ] || die connect_failure_success
  [ "$(cat "$PROBE_COUNT")" = 2 ] || die connect_retry_unbounded
  pass connection_retry_bounded
  call read 1 --raw; status 0 argv_secrecy
  ! grep -Eq 'old-secret|new-secret|command-secret|^--user$' "$PROBE_LOG" || die secret_in_argv
  ! grep -Eq 'old-secret|new-secret|command-secret' "$work/out" "$work/err" || die secret_in_output
  pass credentials_absent_from_curl_argv
fi

if [ "$group" = all ] || [ "$group" = recovery ]; then
  # Exercise production retry/save logic with an injected terminal answer.
  # This does not prove terminal echo suppression or a real server exchange.
  (
    . "$root/tools/mail-cli/lib/config.shs"
    MAIL_ACCOUNT=work
    mail_resolve_account
    _mail_password_input() {
      printf 'prompt\n' >> "$work/prompts"
      MAIL_ACCT_PASSWORD=new-secret
    }
    : > "$PROBE_LOG"; rm -f "$PROBE_COUNT"
    export PROBE_EXPECT=new-secret
    _mail_curl --url pop3s://pop.example.test:995/1 --user 'alice@example.test:old-secret' > "$work/recovery-out"
    [ "$(cat "$PROBE_COUNT")" = 2 ] || die recovery_retry_count
    [ "$(wc -l < "$work/prompts" | tr -d ' ')" = 1 ] || die recovery_prompt_count
    jq -e '.accounts.work.password == "encrypted:v2:synthetic-new-token"' "$config" >/dev/null
    pass authenticated_replacement_saved
    change '.accounts.work.password="encrypted:v2:synthetic-old-token"'
    before=$(cat "$config")
    : > "$work/prompts"; rm -f "$PROBE_COUNT"
    export PROBE_RC=67
    rc=0
    _mail_curl --url pop3s://pop.example.test:995/1 --user 'alice@example.test:old-secret' > "$work/recovery-out" || rc=$?
    [ "$rc" = 67 ] || die second_rejection_exit
    [ "$(cat "$PROBE_COUNT")" = 2 ] || die second_rejection_retry_count
    [ "$(wc -l < "$work/prompts" | tr -d ' ')" = 1 ] || die second_rejection_prompt_count
    [ "$(cat "$config")" = "$before" ] || die second_rejection_saved
    pass replacement_rejected_once_and_preserved
  )
fi
if [ "$group" = all ] || [ "$group" = config ]; then
  mkdir -p "$HOME/.config/devhub"
  shared="$HOME/.config/devhub/email.json"
  cp "$config" "$shared"
  # Default mail account deliberately has an unusable password. Explicit
  # shared-file selection must read the separate devhub account instead.
  change '.accounts.work.password="wrong-default-secret"'
  call inbox --config-file "$shared" --json --limit 1
  status 0 shared_file
  jq -e '.[0].protocol == "pop3" and .[0].uid == "2"' "$work/out" >/dev/null
  pass shared_config_file_selection
  printf 'new-secret\n' > "$work/password"
  PROBE_EXPECT=new-secret call auth password --config-file "$shared" --password-file "$work/password"
  status 0 shared_password_save
  jq -e '.accounts.work.password == "encrypted:v2:synthetic-new-token"' "$shared" >/dev/null
  jq -e '.accounts.work.password == "wrong-default-secret"' "$config" >/dev/null
  pass shared_config_update_isolation
  call config set fixture-marker yes --config-dir "$work/new-config"
  status 0 config_dir
  jq -e '."fixture-marker" == "yes"' "$work/new-config/config.json" >/dev/null
  [ ! -e "$work/new-config/email.json" ] || die wrong_config_basename
  pass custom_config_directory_creation
  call inbox --config-file "$shared" --config-dir "$work/new-config" --json
  status 2 conflicting_config
  [ ! -s "$PROBE_LOG" ] || die conflicting_config_contacted_server
  pass conflicting_config_rejected
fi
if [ "$group" = all ] || [ "$group" = repair ]; then
  printf 'new-secret\n' > "$work/password"
  change '.accounts.work.password_cmd="exit 43"'
  PROBE_EXPECT=new-secret call auth password --password-file "$work/password"
  status 0 broken_saved_command
  jq -e '.accounts.work.password == "encrypted:v2:synthetic-new-token" and (.accounts.work | has("password_cmd") | not)' "$config" >/dev/null
  pass explicit_replacement_bypasses_broken_saved_command
  change '.accounts.work.password="encrypted:v2:unreadable-old-token"'
  (
    . "$root/tools/mail-cli/lib/config.shs"
    MAIL_ACCOUNT=work
    _mail_password_input() { MAIL_ACCT_PASSWORD=new-secret; }
    export PROBE_EXPECT=new-secret
    cmd_auth_password > "$work/replacement-out"
    jq -e '.accounts.work.password == "encrypted:v2:synthetic-new-token"' "$config" >/dev/null
    pass prompted_replacement_bypasses_broken_old_ciphertext
  )
fi
if [ "$group" = all ] || [ "$group" = environment ]; then
  MAIL_CONFIG_FILE="$work/env-only/nested/accounts.json" call config set fixture-marker env
  status 0 environment_file
  jq -e '."fixture-marker" == "env"' "$work/env-only/nested/accounts.json" >/dev/null
  [ ! -d "$work/env-only/nested/config.json" ] || die environment_wrong_directory
  pass environment_config_file_creates_parent
  printf 'stdin-must-remain-unread\n' > "$work/login-input"
  exec 8< "$work/login-input"
  call auth login --non-interactive <&8
  status 2 noninteractive_setup
  IFS= read -r remaining <&8
  exec 8<&-
  [ "$remaining" = stdin-must-remain-unread ] || die setup_consumed_stdin
  [ ! -s "$PROBE_LOG" ] || die setup_contacted_server
  pass noninteractive_setup_preserves_stdin
fi
if [ "$group" = all ] || [ "$group" = placeholders ]; then
  mkdir -p "$HOME/shared settings" "$HOME/helper bin"
  jq '.accounts.work.password="encrypted:v2:synthetic-old-token" | del(.accounts.work.password_cmd)' "$config" > "$HOME/shared settings/accounts.json"
  cp "$MAIL_CREDENTIAL_BIN" "$HOME/helper bin/credential"
  chmod 700 "$HOME/helper bin/credential"
  MAIL_CREDENTIAL_BIN='{home}/helper bin/credential' call inbox --config-file '{home}/shared settings/accounts.json' --json --limit 1
  status 0 placeholder_file_and_helper
  jq -e '.[0].uid == "2"' "$work/out" >/dev/null
  pass home_placeholder_shared_file_and_helper
  printf 'new-secret\n' > "$HOME/shared settings/password"
  PROBE_EXPECT=new-secret MAIL_CREDENTIAL_BIN='{home}/helper bin/credential' call auth password --config-file '{home}/shared settings/accounts.json' --password-file '{home}/shared settings/password'
  status 0 placeholder_password
  jq -e '.accounts.work.password == "encrypted:v2:synthetic-new-token"' "$HOME/shared settings/accounts.json" >/dev/null
  pass home_placeholder_password_file
  call config set marker explicit --config-dir '{home}/explicit directory'
  status 0 placeholder_directory
  jq -e '.marker == "explicit"' "$HOME/explicit directory/config.json" >/dev/null
  MAIL_CONFIG_FILE='{home}/environment file/accounts.json' call config set marker file
  status 0 placeholder_env_file
  jq -e '.marker == "file"' "$HOME/environment file/accounts.json" >/dev/null
  MAIL_CONFIG_DIR='{home}/environment directory' call config set marker directory
  status 0 placeholder_env_directory
  jq -e '.marker == "directory"' "$HOME/environment directory/config.json" >/dev/null
  pass home_placeholder_config_directory_and_environment
  (
    cd "$work"
    literal='{home}/$(touch MUST_NOT_EXIST) `touch ALSO_MUST_NOT_EXIST`'
    call config set marker literal --config-file "$literal"
    status 0 literal_path
    # Let Bash open the literal filename; native Windows jq must not depend on
    # MSYS argument conversion for paths containing shell-looking characters.
    jq -e '.marker == "literal"' < "$HOME/"'$(touch MUST_NOT_EXIST) `touch ALSO_MUST_NOT_EXIST`' >/dev/null
    [ ! -e "$work/MUST_NOT_EXIST" ] && [ ! -e "$work/ALSO_MUST_NOT_EXIST" ] || die shell_evaluated_path
    pass home_placeholder_never_evaluates_shell
  )
fi
case "$group" in all|protocol|credentials|transport|recovery|config|repair|environment|placeholders) ;; *) die unknown_group ;; esac
