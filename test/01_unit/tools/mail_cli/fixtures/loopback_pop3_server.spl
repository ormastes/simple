# Pure-Simple implicit-TLS POP3 loopback fixture for mail-cli interoperability.
# Usage: loopback_pop3_server.spl PORT CERT KEY MODEFILE LOGFILE
# MODEFILE holds one of: normal | empty | reject_list | truncated (re-read per
# accepted connection). LOGFILE receives one command verb per line; arguments
# (credentials) are never recorded. Runs until killed by the driver.
use app.io.args_ops.{get_args}
use std.nogc_sync_mut.io.file_ops.{file_read, file_append}

extern fn rt_tls_server_create(port: i64, cert_path: text, key_path: text) -> i64
extern fn rt_tls_server_accept(server: i64) -> i64
extern fn rt_tls_server_write(conn: i64, data: text) -> i64
extern fn rt_tls_server_read_checked(conn: i64, max_bytes: i64) -> text?
extern fn rt_tls_server_close_connection(conn: i64) -> bool

val MESSAGE_WIRE = "From: sender@example.test\r\nTo: alice@example.test\r\nSubject: Loopback TLS message\r\nContent-Type: text/plain\r\n\r\nLoopback body.\r\n..Leading dot\r\n..\r\n"

fn serve_connection(conn: i64, mode: text, logfile: text):
    rt_tls_server_write(conn, "+OK disposable POP3 fixture ready\r\n")
    var pending = ""
    var authenticated = false
    var open = true
    while open:
        val chunk = rt_tls_server_read_checked(conn, 4096)
        if chunk == nil:
            open = false
        else:
            pending = pending + chunk.unwrap()
            var eol = pending.index_of("\r\n")
            while open and eol >= 0:
                val line = pending.substring(0, eol)
                pending = pending.substring(eol + 2)
                val space = line.index_of(" ")
                var verb = line
                var arg = ""
                if space >= 0:
                    verb = line.substring(0, space)
                    arg = line.substring(space + 1)
                verb = verb.upper()
                file_append(logfile, verb + "\n")
                if verb == "CAPA":
                    rt_tls_server_write(conn, "+OK capabilities\r\nUSER\r\n.\r\n")
                elif verb == "USER":
                    rt_tls_server_write(conn, "+OK user\r\n")
                elif verb == "PASS":
                    authenticated = arg == "loopback-fixture-password"
                    if authenticated:
                        rt_tls_server_write(conn, "+OK authenticated\r\n")
                    else:
                        rt_tls_server_write(conn, "-ERR rejected\r\n")
                elif verb == "QUIT":
                    rt_tls_server_write(conn, "+OK bye\r\n")
                    open = false
                elif not authenticated:
                    rt_tls_server_write(conn, "-ERR authenticate first\r\n")
                elif verb == "LIST":
                    if mode == "empty":
                        rt_tls_server_write(conn, "+OK listing\r\n.\r\n")
                    elif mode == "reject_list":
                        rt_tls_server_write(conn, "-ERR listing unavailable\r\n")
                    else:
                        rt_tls_server_write(conn, "+OK listing\r\n1 {MESSAGE_WIRE.len()}\r\n.\r\n")
                elif verb == "RETR" and arg == "1":
                    rt_tls_server_write(conn, "+OK message\r\n" + MESSAGE_WIRE)
                    if mode == "truncated":
                        open = false
                    else:
                        rt_tls_server_write(conn, ".\r\n")
                elif verb == "NOOP":
                    rt_tls_server_write(conn, "+OK\r\n")
                else:
                    rt_tls_server_write(conn, "-ERR unsupported\r\n")
                eol = pending.index_of("\r\n")
    rt_tls_server_close_connection(conn)

fn main():
    val args = get_args()
    if args.len() < 6:
        panic("loopback_pop3_server: expected PORT CERT KEY MODEFILE LOGFILE")
    val server = rt_tls_server_create(args[1].to_int(), args[2], args[3])
    if server < 0:
        panic("loopback_pop3_server: TLS listener create failed")
    print("listening")
    while true:
        val conn = rt_tls_server_accept(server)
        if conn >= 0:
            serve_connection(conn, file_read(args[4]).trim(), args[5])

main()
