# @req REQ-MAIL-HEADER-001
# @cover tools/mail-cli/lib/format.bash
use std.spec.*
use std.process.{run}

describe "Mail production header and body parsing":
    it "should parse case insensitive fields and keep body text outside metadata":
        step("Run the production mail formatter against disposable RFC messages")
        val result = run("bash", ["test/01_unit/tools/mail_cli/fixtures/header_case_probe.shs", "tools/mail-cli/lib"])
        step("Check actual field values, body preservation, and declared transfer decoding")
        expect(result.exit_code).to_equal(0)
        expect(result.stdout).to_contain("mail_header_case_insensitive_fields: PASS")
        expect(result.stdout).to_contain("mail_body_header_text_is_not_metadata: PASS")
        expect(result.stdout).to_contain("mail_actual_transfer_encoding_preserved: PASS")
