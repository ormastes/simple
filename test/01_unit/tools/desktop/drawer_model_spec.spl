# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-TOOLS
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec
use std.spec.step
use common.drawer_model.{

    drawer_selected_launch_path,
    drawer_select_next,
    drawer_set_query,
    drawer_visible_items,
    primary_drawer_model
}

describe "drawer model":
    # @manual scenario evidence
    it "contains primary GUI applications":
        # @req REQ-SSPEC-TOOLS
        step("contains primary GUI applications")
        val model = primary_drawer_model()

        expect(drawer_visible_items(model)[0].name).to_equal("Terminal")
        expect(drawer_visible_items(model).len() >= 8).to_equal(true)

    it "filters by app name":
        # @req REQ-SSPEC-TOOLS
        step("filters by app name")
        val model = drawer_set_query(primary_drawer_model(), "markdown")
        val visible = drawer_visible_items(model)

        expect(visible.len()).to_equal(1)
        expect(visible[0].launch_path).to_equal("/sys/apps/editor")

    it "filters by category":
        # @req REQ-SSPEC-TOOLS
        step("filters by category")
        val model = drawer_set_query(primary_drawer_model(), "games")
        val visible = drawer_visible_items(model)

        expect(visible[0].name).to_equal("Minesweeper")

    it "selects a launch path":
        # @req REQ-SSPEC-TOOLS
        step("selects a launch path")
        val model = drawer_select_next(primary_drawer_model())

        expect(drawer_selected_launch_path(model)).to_equal("/sys/apps/shell")
