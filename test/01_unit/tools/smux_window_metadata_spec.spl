"""Pure RenameWindow state and canonical name controls. Authored NOT_RUN."""
use std.spec.{describe, it, expect}
use std.common.contracts.mux.request_validation_v1.{mux_validate_name_v1}
use std.common.contracts.mux.execution_v1.{MuxBorderV1, MuxBorderStatusV1}
use os.apps.smux.window_metadata_service.{rename_window_state}
use os.apps.smux.service_revision.{service_configuration_equal}
use os.apps.smux.service.{ServiceState, PaneRecord}
use os.apps.smux.contract.{MuxSession, MuxWindow, MuxPane, MuxPanePresentation}
use os.apps.smux.mux_rects.{MuxRect}

fn metadata_fixture() -> ServiceState:
    var st = ServiceState.empty()
    st = st.add_session(MuxSession.create("s1", "one"))
    st = st.add_session(MuxSession.create("s2", "two"))
    st = st.add_window(MuxWindow.create("w1", "s1", "first"))
    st = st.add_window(MuxWindow.create("w2", "s1", "second"))
    st = st.add_window(MuxWindow.create("w3", "s2", "elsewhere"))
    return st.add_pane(PaneRecord.create(MuxPane.create("p1", "w1", "s1")))

describe "Canonical window metadata rename":
    it "uses the existing clean Unicode byte-bounded name policy":
        for name in ["spaces are literal", "한😀", "x".repeat(256), "😀".repeat(64)]:
            expect(mux_validate_name_v1(name).unwrap()).to_equal(name)
        for name in ["", "x".repeat(257), "😀".repeat(65), "a\0b", "a\nb", "\u{7f}", "\u{80}", "\u{9f}"]:
            expect(mux_validate_name_v1(name).is_err()).to_equal(true)

    it "rejects unknown or foreign membership without changing input state":
        val st = metadata_fixture()
        expect(rename_window_state(st, "missing", "w1", "new").is_err()).to_equal(true)
        expect(rename_window_state(st, "s1", "missing", "new").is_err()).to_equal(true)
        expect(rename_window_state(st, "s2", "w1", "new").is_err()).to_equal(true)
        expect(st.get_window(0).name).to_equal("first")

    it "allows duplicate and ID-like labels without changing ID-targeted authority":
        val st = metadata_fixture()
        val duplicate = rename_window_state(st, "s1", "w1", "second").unwrap()
        expect(duplicate.get_window(0).name).to_equal("second")
        expect(duplicate.get_window(1).name).to_equal("second")
        expect(duplicate.find_window_idx("w1")).to_equal(0)
        expect(duplicate.find_window_idx("w2")).to_equal(1)
        val id_label = rename_window_state(duplicate, "s1", "w1", "w2").unwrap()
        expect(id_label.get_window(0).name).to_equal("w2")
        expect(id_label.get_window(0).id).to_equal("w1")
        expect(id_label.find_window_idx("w2")).to_equal(1)
        val sibling = rename_window_state(id_label, "s1", "w2", "updated sibling").unwrap()
        expect(sibling.get_window(0).name).to_equal("w2")
        expect(sibling.get_window(1).name).to_equal("updated sibling")
        expect(sibling.get_window(1).id).to_equal("w2")
        val renamed = rename_window_state(st, "s1", "w1", "elsewhere").unwrap()
        expect(renamed.get_window(0).name).to_equal("elsewhere")
        expect(renamed.get_window(2).name).to_equal("elsewhere")
        expect(rename_window_state(st, "s1", "w1", "w1").unwrap().get_window(0).id).to_equal("w1")

    it "keeps an identical name as an exact configuration no-op":
        val st = metadata_fixture()
        expect(service_configuration_equal(st, rename_window_state(st, "s1", "w1", "first").unwrap())).to_equal(true)

    it "preserves full manual geometry zoom presentation and pane state":
        var st = metadata_fixture()
        val window = MuxWindow(id: "w1", session_id: "s1", name: "first", is_active: true,
            layout: "manual", canvas_cols: 90, canvas_rows: 30,
            manual_rects: [MuxRect(pane_id: "p1", col: 2, row: 3, cols: 40, rows: 20)],
            manual_cols: 100, manual_rows: 40, zoom_pane: "p1",
            presentation: [MuxPanePresentation(pane_id: "p1", title: "title", hidden: false,
                border: MuxBorderV1.Double, status: MuxBorderStatusV1.Top)])
        st = st.replace_window(0, window)
        val renamed = rename_window_state(st, "s1", "w1", "한 😀 window").unwrap()
        expect(renamed.get_window(0).name).to_equal("한 😀 window")
        val restored = rename_window_state(renamed, "s1", "w1", "first").unwrap()
        expect(service_configuration_equal(st, restored)).to_equal(true)
        expect(restored.get_pane(0).content_revision).to_equal(st.get_pane(0).content_revision)
        expect(restored.get_pane(0).child_incarnation).to_equal(st.get_pane(0).child_incarnation)
        expect(restored.get_pane(0).pty_fd).to_equal(st.get_pane(0).pty_fd)
