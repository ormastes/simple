# @cover src/lib/nogc_async_mut/fs_driver/mount_table.spl 80%
"""
# MountTable Unit Tests

**Feature IDs:** #FS-DRIVER-MOUNT
**Category:** Infrastructure
**Difficulty:** 2/5
**Status:** In Progress
**Design:** doc/05_design/fs_driver_interface.md §3, §8

## Overview

Tests for MountTable lifecycle:
  - new() creates an empty table
  - mount() registers a driver at a path
  - lookup() finds the entry for an exact or prefix path
  - unmount() removes the entry
  - resolve() strips the mount prefix and returns (MountId, relpath)
  - error on unmount of non-existent path
  - error on duplicate mount of same path
"""

use std.spipe.*
use std.fs_driver.mount_table.{MountTable, MountId, ExecuteOpenBinding, PositionedDriverKind}
use std.fs_driver.types.{Path, MountOptions, OpenFlags, FileHandle, ExecuteTrust}
use std.fs_driver.instance.{DriverInstance, RamFsStub}
use std.fs_driver.error.{FsError}
use std.fs_driver.ramfs.{RamFsDriver}


fn make_driver() -> DriverInstance:
    DriverInstance.RamFs(driver: RamFsStub(name: "test_ramfs"))

fn make_opts() -> MountOptions:
    MountOptions.default()

fn root_path() -> Path:
    Path(raw: "/")

fn foo_path() -> Path:
    Path(raw: "/foo")

fn foo_bar_path() -> Path:
    Path(raw: "/foo/bar")

fn real_driver() -> DriverInstance:
    DriverInstance.RamFs(driver: RamFsDriver.new())

fn table_with_program() -> MountTable:
    var table = MountTable.new()
    table.mount("/", real_driver(), MountOptions.default()).unwrap()
    val writer = table.open("/program", OpenFlags.create_write()).unwrap()
    table.ftruncate(writer, 4).unwrap()
    table.close(writer).unwrap()
    table

fn is_permission(error: FsError) -> bool:
    match error:
        case Permission: true
        case _:          false

fn is_invalid_arg(error: FsError) -> bool:
    match error:
        case InvalidArg: true
        case _:          false

describe "MountTable — execute-open policy and ownership":
    it "negotiates required capabilities against the backend vocabulary":
        var mt = MountTable.new()
        var opts = MountOptions.default()
        opts.require_caps = (1 << 23)
        val r = mt.mount("/", real_driver(), opts)
        expect(r.is_ok()).to_be(true)
        val entry_opt = mt.lookup(Path(raw: "/program"))
        match entry_opt:
            case Some(entry): expect((entry.active_caps & (1 << 23)) != 0).to_be(true)
            case nil:         fail("required capability mount was not registered")

    it "rejects untrusted execute requests by default":
        var mt = MountTable.new()
        var opts = MountOptions.default()
        opts.want_caps = (1 << 23)
        mt.mount("/", real_driver(), opts)
        val r = mt.open_for_execute("/program", ExecuteTrust.Untrusted)
        expect(r.is_err()).to_be(true)
        expect(is_permission(r.unwrap_err())).to_be(true)

    it "rejects execute on a noexec mount":
        var mt = MountTable.new()
        var opts = MountOptions.default()
        opts.want_caps = (1 << 23)
        opts.noexec = true
        mt.mount("/", real_driver(), opts)
        val r = mt.open_for_execute("/program", ExecuteTrust.Trusted)
        expect(r.is_err()).to_be(true)
        expect(is_permission(r.unwrap_err())).to_be(true)

    it "rejects a directory execute-open and closes the opened handle":
        var mt = MountTable.new()
        val r = mt.mount("/", real_driver(), MountOptions.default())
        expect(r.is_ok()).to_be(true)
        val opened = mt.open_for_execute("/", ExecuteTrust.Trusted)
        expect(opened.is_err()).to_be(true)
        expect(is_invalid_arg(opened.unwrap_err())).to_be(true)
        expect(mt.unmount("/").is_ok()).to_be(true)

    it "unmount is Busy while a live binding exists":
        var mt = MountTable.new()
        val id = mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        val opened = mt.open("/program", OpenFlags.read_only())
        expect(opened.is_ok()).to_be(true)
        val r = mt.unmount("/")
        expect(r.is_err()).to_be(true)
        match r.unwrap_err():
            case Busy: expect(id.id).to_equal(1)
            case _:    fail("unmount did not report Busy")

    it "detects a stale execute generation snapshot":
        var mt = MountTable.new()
        val id = mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        val binding = ExecuteOpenBinding(
            mount_id: id,
            backend_name: "ramfs",
            backend_kind: "ramfs",
            file_handle: FileHandle(id: 1),
            mount_generation: 1u64,
            namespace_generation: 1u64,
            content_generation: 1u64,
            size: 0
        )
        mt.bump_content_generation(id)
        expect(mt.execute_binding_is_current(binding)).to_be(false)

    it "projects canonical ramfs kind separately from its display name":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        val created = mt.open("/program.smf", OpenFlags.create_write()).unwrap()
        mt.write(created, "SMF1").unwrap()
        mt.close(created).unwrap()
        val binding = mt.open_for_execute("/program.smf", ExecuteTrust.Trusted).unwrap()
        expect(binding.backend_kind).to_equal("ramfs")
        mt.close(binding.file_handle).unwrap()

    it "rejects unknown handles instead of probing other mounts":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default())
        mt.mount("/other", real_driver(), MountOptions.default())
        expect(mt.read(FileHandle(id: 1), 4).is_err()).to_be(true)
        expect(mt.close(FileHandle(id: 1)).is_err()).to_be(true)

    it "keeps colliding backend handles isolated by virtual binding":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default())
        mt.mount("/other", real_driver(), MountOptions.default())
        val left = mt.open("/left", OpenFlags.read_only())
        val right = mt.open("/other/right", OpenFlags.read_only())
        expect(left.is_ok()).to_be(true)
        expect(right.is_ok()).to_be(true)
        val left_handle = left.unwrap()
        val right_handle = right.unwrap()
        expect(left_handle.id != right_handle.id).to_be(true)
        expect(mt.close(left_handle).is_ok()).to_be(true)
        expect(mt.read(right_handle, 1).is_ok()).to_be(true)

    it "automatically invalidates execute snapshots after namespace mutations":
        var mt = MountTable.new()
        val id = mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        val snapshot = ExecuteOpenBinding(
            mount_id: id,
            backend_name: "ramfs",
            backend_kind: "ramfs",
            file_handle: FileHandle(id: 1),
            mount_generation: 1u64,
            namespace_generation: 1u64,
            content_generation: 1u64,
            size: 0
        )
        expect(mt.mkdir("/dir", 0o755).is_ok()).to_be(true)
        expect(mt.execute_binding_is_current(snapshot)).to_be(false)

    it "fails namespace mutation before backend work at generation exhaustion":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default())
        mt.mounts[0].namespace_generation = 0xFFFFFFFFFFFFFFFFu64
        val r = mt.mkdir("/blocked", 0o755)
        expect(r.is_err()).to_be(true)
        expect(mt.mounts[0].namespace_generation).to_equal(0xFFFFFFFFFFFFFFFFu64)

    it "reuses bounded slots with a new generation and rejects the stale handle":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default())
        val first = mt.open("/first", OpenFlags.read_only()).unwrap()
        expect(mt.close(first).is_ok()).to_be(true)
        val second = mt.open("/second", OpenFlags.read_only()).unwrap()
        expect(first.id != second.id).to_be(true)
        expect((first.id & 0xFFFFFFFFu64)).to_equal(second.id & 0xFFFFFFFFu64)
        expect(mt.read(first, 1).unwrap_err()).to_equal(FsError.StaleHandle)
        expect(mt.read(second, 1).is_ok()).to_be(true)

    it "rejects exhausted directory admission before backend opendir":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        mt.dir_capacity_limit = 0
        expect(mt.opendir("/").unwrap_err()).to_equal(FsError.TooLarge)
        match mt.mounts[0].driver:
            case DriverInstance.RamFs(driver): expect(driver.fd_table.len()).to_equal(0)
            case _: fail("test mount did not retain the RamFs backend")
        expect(mt.unmount("/").is_ok()).to_be(true)

    it "fails mount allocation before registering at exhaustion":
        var mt = MountTable.new()
        mt.next_id = 0xFFFFFFFFu32
        expect(mt.mount("/new", real_driver(), MountOptions.default()).is_err()).to_be(true)
        expect(mt.mounts.len()).to_equal(0)

    it "rejects non-canonical mount and lookup paths":
        var mt = MountTable.new()
        expect(mt.mount("relative", real_driver(), MountOptions.default()).is_err()).to_be(true)
        expect(mt.mount("/unsafe/../path", real_driver(), MountOptions.default()).is_err()).to_be(true)
        expect(mt.mount("/trailing/", real_driver(), MountOptions.default()).is_err()).to_be(true)
        expect(mt.mounts.len()).to_equal(0)
        expect(mt.resolve(Path(raw: "/unsafe//path")).is_err()).to_be(true)

    it "rejects unbounded I/O requests before handle lookup or allocation":
        val mt = MountTable.new()
        expect(mt.read(FileHandle(id: 1u64), 16777217).is_err()).to_be(true)
        expect(mt.pread(FileHandle(id: 1u64), 0, 16777217).is_err()).to_be(true)
        expect(mt.pread(FileHandle(id: 1u64), 0 - 1, 1).is_err()).to_be(true)


describe "MountTable — mutation generation invalidation":
    it "advances namespace exactly once after successful create open":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        val before = mt.mounts[0].namespace_generation
        val opened = mt.open("/created", OpenFlags.create_write())
        expect(opened.is_ok()).to_be(true)
        expect(mt.mounts[0].namespace_generation).to_equal(before + 1u64)

    it "advances both requested generations exactly once after failed create truncate open":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        val existing = mt.open("/existing", OpenFlags.create_write()).unwrap()
        mt.close(existing).unwrap()
        val namespace_before = mt.mounts[0].namespace_generation
        val content_before = mt.mounts[0].content_generation
        val create_exclusive = OpenFlags.create_write().with_excl()
        val flags = create_exclusive.with_trunc()
        expect(mt.open("/existing", flags).is_err()).to_be(true)
        expect(mt.mounts[0].namespace_generation).to_equal(namespace_before + 1u64)
        expect(mt.mounts[0].content_generation).to_equal(content_before + 1u64)

    it "advances content exactly once after successful truncate open":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        val existing = mt.open("/existing", OpenFlags.create_write()).unwrap()
        mt.close(existing).unwrap()
        val before = mt.mounts[0].content_generation
        val truncate_flags = OpenFlags.write_only().with_trunc()
        expect(mt.open("/existing", truncate_flags).is_ok()).to_be(true)
        expect(mt.mounts[0].content_generation).to_equal(before + 1u64)

    it "invalidates namespace after a backend reports mutation failure":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        mt.mkdir("/present", 0o755).unwrap()
        val before = mt.mounts[0].namespace_generation
        expect(mt.mkdir("/present", 0o755).is_err()).to_be(true)
        expect(mt.mounts[0].namespace_generation).to_equal(before + 1u64)

    it "invalidates namespace after failed unlink and rename calls":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        val before_unlink = mt.mounts[0].namespace_generation
        expect(mt.unlink("/missing").is_err()).to_be(true)
        expect(mt.mounts[0].namespace_generation).to_equal(before_unlink + 1u64)
        val before_rename = mt.mounts[0].namespace_generation
        expect(mt.rename("/missing", "/new").is_err()).to_be(true)
        expect(mt.mounts[0].namespace_generation).to_equal(before_rename + 1u64)

    it "invalidates namespace after a failed link call":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        val before = mt.mounts[0].namespace_generation
        expect(mt.link("/target", "/alias").is_err()).to_be(true)
        expect(mt.mounts[0].namespace_generation).to_equal(before + 1u64)

    it "invalidates content exactly once after failed handle mutations":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        val handle = mt.open("/data", OpenFlags.create_write()).unwrap()
        val before_write = mt.mounts[0].content_generation
        expect(mt.write(handle, "x").is_err()).to_be(true)
        expect(mt.mounts[0].content_generation).to_equal(before_write + 1u64)
        val before_pwrite = mt.mounts[0].content_generation
        expect(mt.pwrite(handle, "y", 0).is_err()).to_be(true)
        expect(mt.mounts[0].content_generation).to_equal(before_pwrite + 1u64)
        val before_truncate = mt.mounts[0].content_generation
        expect(mt.ftruncate(handle, 0).is_err()).to_be(true)
        expect(mt.mounts[0].content_generation).to_equal(before_truncate + 1u64)

    it "invalidates content after failed positioned write dispatch":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        val handle = mt.open("/data", OpenFlags.create_write()).unwrap()
        val before = mt.mounts[0].content_generation
        val bytes: [u8] = [1u8, 2u8]
        expect(mt.positioned_write_bytes(handle.id, PositionedDriverKind.Auto, 0u64, bytes).is_err()).to_be(true)
        expect(mt.mounts[0].content_generation).to_equal(before + 1u64)

    it "invalidates content after failed shared writable mapping":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        val handle = mt.open("/data", OpenFlags.create_write()).unwrap()
        val before = mt.mounts[0].content_generation
        expect(mt.mmap_shared_writable(handle, 0, 4096).is_err()).to_be(true)
        expect(mt.mounts[0].content_generation).to_equal(before + 1u64)

    it "does not mutate the backend or advance generation when capacity is exhausted":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        mt.mounts[0].namespace_generation = 0xFFFFFFFFFFFFFFFFu64
        expect(mt.mkdir("/blocked", 0o755).is_err()).to_be(true)
        expect(mt.mounts[0].namespace_generation).to_equal(0xFFFFFFFFFFFFFFFFu64)
        expect(mt.stat("/blocked").is_err()).to_be(true)


describe "MountTable — replacement lifecycle":
    it "reports an empty table as quiescent":
        val mt = MountTable.new()
        expect(mt.has_live_handles()).to_be(false)
        expect(mt.can_replace()).to_be(true)

    it "reports mounted but quiescent tables as ready for owner review":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        expect(mt.has_live_handles()).to_be(false)
        expect(mt.can_replace()).to_be(true)

    it "reports Busy without mutation while a file handle is live":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        val handle = mt.open("/file", OpenFlags.create_write()).unwrap()
        val mounts_before = mt.mounts.len()
        val next_id_before = mt.next_id
        val files_before = mt.open_files.len()
        expect(mt.has_live_handles()).to_be(true)
        expect(mt.can_replace()).to_be(false)
        expect(mt.unmount("/").unwrap_err()).to_equal(FsError.Busy)
        expect(mt.mounts.len()).to_equal(mounts_before)
        expect(mt.next_id).to_equal(next_id_before)
        expect(mt.open_files.len()).to_equal(files_before)
        expect(mt.read(handle, 1).is_ok()).to_be(true)
        expect(mt.close(handle).is_ok()).to_be(true)
        expect(mt.can_replace()).to_be(true)
        expect(mt.unmount("/").is_ok()).to_be(true)

    it "reports Busy for a directory binding without a close contract":
        var mt = MountTable.new()
        mt.mount("/", real_driver(), MountOptions.default()).unwrap()
        val directory = mt.opendir("/").unwrap()
        val mounts_before = mt.mounts.len()
        expect(mt.readdir(directory).is_ok()).to_be(true)
        expect(mt.has_live_handles()).to_be(true)
        expect(mt.can_replace()).to_be(false)
        expect(mt.unmount("/").unwrap_err()).to_equal(FsError.Busy)
        expect(mt.mounts.len()).to_equal(mounts_before)
        expect(mt.readdir(directory).is_ok()).to_be(true)

    it "reports Busy for execute bindings until their owned file is closed":
        var mt = table_with_program()
        val binding = mt.open_for_execute("/program", ExecuteTrust.Trusted).unwrap()
        expect(mt.has_live_handles()).to_be(true)
        expect(mt.can_replace()).to_be(false)
        expect(mt.unmount("/").unwrap_err()).to_equal(FsError.Busy)
        expect(mt.execute_binding_is_current(binding)).to_be(true)
        expect(mt.close(binding.file_handle).is_ok()).to_be(true)
        expect(mt.has_live_handles()).to_be(false)
        expect(mt.can_replace()).to_be(true)
        expect(mt.unmount("/").is_ok()).to_be(true)


# ============================================================================
# MountTable.new()
# ============================================================================

describe "MountTable — new()":
    """
    ## Empty table

    new() must produce a table with no mounts and next_id == 1.
    """

    it "new table has zero mounts":
        val mt = MountTable.new()
        expect(mt.mounts.len()).to_equal(0)

    it "new table next_id starts at 1":
        val mt = MountTable.new()
        expect(mt.next_id).to_equal(1)

    it "lookup on empty table returns nil":
        val mt = MountTable.new()
        val result = mt.lookup(root_path())
        expect(result == nil).to_equal(true)


# ============================================================================
# MountTable.mount() + lookup()
# ============================================================================

describe "MountTable — mount() + lookup()":
    """
    ## Mount and lookup

    mount() adds an entry; lookup() returns it for exact and prefix matches.
    """

    it "mount returns Ok with a non-null MountId":
        var mt = MountTable.new()
        val r = mt.mount("/", make_driver(), make_opts())
        expect(r.is_ok()).to_equal(true)
        val id = r.unwrap()
        expect(id.id).to_equal(1)

    it "lookup finds the mounted entry":
        var mt = MountTable.new()
        mt.mount("/", make_driver(), make_opts())
        val entry_opt = mt.lookup(root_path())
        expect(entry_opt == nil).to_equal(false)

    it "lookup with child path finds root mount":
        var mt = MountTable.new()
        mt.mount("/", make_driver(), make_opts())
        val entry_opt = mt.lookup(foo_bar_path())
        expect(entry_opt == nil).to_equal(false)

    it "duplicate mount returns AlreadyExists error":
        var mt = MountTable.new()
        mt.mount("/", make_driver(), make_opts())
        val r2 = mt.mount("/", make_driver(), make_opts())
        expect(r2.is_err()).to_equal(true)
        match r2.unwrap_err():
            case AlreadyExists: expect(r2.is_err()).to_equal(true)
            case _:             fail("duplicate mount did not return AlreadyExists")


# ============================================================================
# MountTable.unmount()
# ============================================================================

describe "MountTable — unmount()":
    """
    ## Unmount

    unmount() removes the entry; subsequent lookup returns nil.
    unmount of non-existent path returns NotFound.
    """

    it "unmount of mounted path returns Ok":
        var mt = MountTable.new()
        mt.mount("/", make_driver(), make_opts())
        val r = mt.unmount("/")
        expect(r.is_ok()).to_equal(true)

    it "after unmount, lookup returns nil":
        var mt = MountTable.new()
        mt.mount("/", make_driver(), make_opts())
        mt.unmount("/")
        val entry_opt = mt.lookup(root_path())
        expect(entry_opt == nil).to_equal(true)

    it "unmount of non-existent path returns NotFound":
        var mt = MountTable.new()
        val r = mt.unmount("/")
        expect(r.is_err()).to_equal(true)
        match r.unwrap_err():
            case NotFound: expect(r.is_err()).to_equal(true)
            case _:        fail("unmount of non-existent path did not return NotFound")


# ============================================================================
# MountTable.resolve()
# ============================================================================

describe "MountTable — resolve()":
    """
    ## Path resolution

    resolve() strips the mount-point prefix and returns (MountId, relpath).
    Fails with NotFound when no mount covers the path.
    """

    it "resolve('/') returns (id, '')":
        var mt = MountTable.new()
        mt.mount("/", make_driver(), make_opts())
        val r = mt.resolve(root_path())
        expect(r.is_ok()).to_equal(true)
        val pair = r.unwrap()
        val mid = pair.mount_id
        val rel = pair.relpath
        expect(mid.id).to_equal(1)
        expect(rel.raw).to_equal("")

    it "resolve('/foo/bar') under '/' returns relpath 'foo/bar'":
        var mt = MountTable.new()
        mt.mount("/", make_driver(), make_opts())
        val r = mt.resolve(foo_bar_path())
        expect(r.is_ok()).to_equal(true)
        val pair = r.unwrap()
        val rel = pair.relpath
        expect(rel.raw).to_equal("foo/bar")

    it "resolve on empty table returns NotFound":
        val mt = MountTable.new()
        val r = mt.resolve(foo_path())
        expect(r.is_err()).to_equal(true)
        match r.unwrap_err():
            case NotFound: expect(r.is_err()).to_equal(true)
            case _:        fail("resolve on empty table did not return NotFound")
