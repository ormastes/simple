"""
## Purpose and audience
Purpose: Hold the Chrome 159 ink box of a shaped Devanagari word whose TOP
edge Simple misses. Expected to FAIL until the glyph rasterizer hints a
Devanagari face with Devanagari blue zones.
Audience: browser-engine text raster maintainers.

Chrome oracle (Chrome for Testing 159, headless, 1x, 400x300, `<html
lang="hi">`, `font:16px Liberation Sans, <bundled Noto Sans Devanagari via
@font-face>`, div at left:20px top:30px): हिन्दी ink (any channel under 200) is
x 19..50, y 30..45; the headline's dark row is 34.
Simple (2026-11-22): x 19..50, y 28..45 (2026-11-23 after PR #10934: 29..45); headline dark row 34 with a grey row
33 above it. Columns, bottom row and glyph run equal Chrome's
(`devanagari_render_chrome159_spec.spl`); the part above the headline is 1-2
rows taller. `_lcd_hint_knots` (`src/lib/common/encoding/sfnt_glyf.spl`) builds
its y knots from the face's LATIN `x o H` outlines, so a Devanagari glyph is
warped by Latin zones; FreeType's autohinter uses the script's own zones
(headline top/bottom, base bottom) for it.
"""
# @tag:in-development
# Tracks: doc/08_tracking/bug/web_render_devanagari_latin_blue_zone_hint_2026-11-22.md
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{
    simple_web_render_html_to_pixels_with_engine2d_backend
}

val W: i32 = 400
val H: i32 = 120

fn _chan(px: u32, shift: u32) -> i32:
    ((px >> shift) & 0xFFu32).to_i32()

describe "Devanagari glyph rows against Chrome 159":
    it "हिन्दी ink box is x 19..50, y 30..45":
        val html = "<!doctype html><html lang=\"hi\"><body style=\"margin:0;background:#fff;font:16px Liberation Sans;color:#000\"><div style=\"position:absolute;left:20px;top:30px;white-space:nowrap;\">हिन्दी</div></body></html>"
        val px = simple_web_render_html_to_pixels_with_engine2d_backend(html, W, H, "cpu_simd")
        var x0 = W
        var y0 = H
        var x1 = -1
        var y1 = -1
        var y = 0
        while y < H:
            var x = 0
            while x < W:
                val p = px[y * W + x]
                if _chan(p, 16u32) < 200 or _chan(p, 8u32) < 200 or _chan(p, 0u32) < 200:
                    if x < x0: x0 = x
                    if x > x1: x1 = x
                    if y < y0: y0 = y
                    if y > y1: y1 = y
                x = x + 1
            y = y + 1
        expect("{x0}..{x1} {y0}..{y1}").to_equal("19..50 30..45")
