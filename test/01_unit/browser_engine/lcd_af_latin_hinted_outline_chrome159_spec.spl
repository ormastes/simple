"""
## Purpose and audience
Purpose: Pin the 1x LCD ink of light-autohinted glyphs (Liberation Sans 16, 13
and 14 px) against Chrome 159. Chrome hints a glyf outline with the latin
autohinter in light mode (vertical only: blue zones, then horizontal-stem
edges, then strong and weak points, all in 26.6 integers) and fills the hinted
path with Skia's analytic AA. The engine's fill is exact for its own outline;
its outline was a knot approximation of the hinter, so round and diagonal
glyphs sat a fraction of a row off (a..z at 16 px: 74 mismatching px).
Audience: web renderer / font rasteriser maintainers.

Chrome oracle (Chrome for Testing 159, `--headless=new --disable-gpu
--force-device-scale-factor=1 --window-size=400,300`, `color:#000` on white,
`font-family:'Liberation Sans'`, `white-space:pre`, `line-height:20px`, each
`<p>` absolutely positioned at `left:10px`).

| row | top | size | text | pinned (x,y) rrggbb |
|-----|-----|------|------|---------------------|
| 1 | 6 | 16 px | `a b g m o p s y` | (56,12) 679fc7, (11,16) 571f00, (86,19) dfcfaf, (70,20) a7875f |
| 2 | 30 | 16 px | `employs gamma` | (25,36) 679fc7, (98,36) 8fbfdf, (111,36) 476fa7, (84,40) 571f00, (37,43) dfcfaf |
| 3 | 54 | 13 px | `a b g m o p s y  employs gamma` | (116,61) 77573f, (15,67) 8f4f1f, (33,67) 975f37, (167,67) 5f270f, (196,67) 370f17, (36,69) cf9747 |
| 4 | 78 | 14 px | same | (88,88) 8fa7bf, (158,88) 4f6f8f, (159,88) a7b7c7, (170,94) cf8f47 |

Base (knot hinter) at the same pixels differs by 39..72 levels; mismatching
px (> 8 levels) per row band against the capture: 63, 82, 79, 44. With the
port: 1, 1, 1, 1, each the last ink column of the run's last glyph, which the
engine does not paint (base too). That column is a separate cause, held by
`lcd_run_end_ink_column_chrome159_spec.spl`.

FreeType's light autohinter outline (`FT_LOAD_TARGET_LIGHT`), filled by libskia,
reproduces the capture with 0 mismatching px on a..z, A..Z and 0..9 at 13, 14
and 16 px, so the hinter is the whole residual of these glyphs.

Tolerance: 8 levels per channel, the catalog differ's own tolerance
(src/app/ui/chrome_showcase/pixel_diff.spl TOLERANCE).
"""

"""
Traceability: REQ-WEB-TEXT-HINT-003 - Draw IR LCD text rasterises each glyph's coverage like Chrome's Skia LCD16 path.
"""
# @tag: unit, browser_engine, text, engine2d, chrome159
# @cover src/lib/common/encoding/sfnt_af_latin.spl 1%
use std.spec.*
use std.io_runtime.{file_exists}
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{
    simple_web_render_html_to_pixels_with_engine2d_backend
}

val SANS: text = "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf"
val W: i32 = 400
val H: i32 = 300
val TOL: i64 = 8

fn _p(top: i32, size: i32, content: text) -> text:
    "<p style=\"position:absolute;left:10px;top:{top}px;margin:0;white-space:pre;color:#000;font-size:{size}px;line-height:20px\">{content}</p>"

fn _page() -> text:
    "<!doctype html><html><body style=\"margin:0;background:#fff;font-family:'Liberation Sans'\">" + _p(6, 16, "a b g m o p s y") + _p(30, 16, "employs gamma") + _p(54, 13, "a b g m o p s y  employs gamma") + _p(78, 14, "a b g m o p s y  employs gamma") + "</body></html>"

fn _chan(v: u32, shift: u32) -> i64:
    ((v >> shift) & 0xFFu32).to_i64()

# Every channel of pixel (x, y) is within TOL of Chrome's `want`.
fn _near(px: [u32], x: i32, y: i32, want: u32) -> bool:
    val got = px[y * W + x] & 0xFFFFFFu32
    var ok = true
    var shift: u32 = 0u32
    while shift <= 16u32:
        var d = _chan(got, shift) - _chan(want, shift)
        if d < 0: d = 0 - d
        if d > TOL: ok = false
        shift = shift + 8u32
    ok

fn _render() -> [u32]:
    simple_web_render_html_to_pixels_with_engine2d_backend(_page(), W, H, "cpu_simd")

describe "1x LCD light-autohinted outline against Chrome 159":
    it "AC-1: 16 px glyph row":
        if not file_exists(SANS):
            skip("no Liberation Sans on this host")
            return
        val px = _render()
        expect(px.len()).to_equal((W * H).to_i64())
        step("(56,12) 679fc7, (11,16) 571f00, (86,19) dfcfaf, (70,20) a7875f")
        expect(_near(px, 56, 12, 0x679fc7u32)).to_equal(true)
        expect(_near(px, 11, 16, 0x571f00u32)).to_equal(true)
        expect(_near(px, 86, 19, 0xdfcfafu32)).to_equal(true)
        expect(_near(px, 70, 20, 0xa7875fu32)).to_equal(true)

    it "AC-2: 16 px words":
        if not file_exists(SANS):
            skip("no Liberation Sans on this host")
            return
        val px = _render()
        step("(25,36) 679fc7, (98,36) 8fbfdf, (111,36) 476fa7, (84,40) 571f00, (37,43) dfcfaf")
        expect(_near(px, 25, 36, 0x679fc7u32)).to_equal(true)
        expect(_near(px, 98, 36, 0x8fbfdfu32)).to_equal(true)
        expect(_near(px, 111, 36, 0x476fa7u32)).to_equal(true)
        expect(_near(px, 84, 40, 0x571f00u32)).to_equal(true)
        expect(_near(px, 37, 43, 0xdfcfafu32)).to_equal(true)

    it "AC-3: 13 px glyph row and words":
        if not file_exists(SANS):
            skip("no Liberation Sans on this host")
            return
        val px = _render()
        step("(116,61) 77573f, (15,67) 8f4f1f, (33,67) 975f37, (167,67) 5f270f, (196,67) 370f17, (36,69) cf9747")
        expect(_near(px, 116, 61, 0x77573fu32)).to_equal(true)
        expect(_near(px, 15, 67, 0x8f4f1fu32)).to_equal(true)
        expect(_near(px, 33, 67, 0x975f37u32)).to_equal(true)
        expect(_near(px, 167, 67, 0x5f270fu32)).to_equal(true)
        expect(_near(px, 196, 67, 0x370f17u32)).to_equal(true)
        expect(_near(px, 36, 69, 0xcf9747u32)).to_equal(true)

    it "AC-4: 14 px glyph row and words":
        if not file_exists(SANS):
            skip("no Liberation Sans on this host")
            return
        val px = _render()
        step("(88,88) 8fa7bf, (158,88) 4f6f8f, (159,88) a7b7c7, (170,94) cf8f47")
        expect(_near(px, 88, 88, 0x8fa7bfu32)).to_equal(true)
        expect(_near(px, 158, 88, 0x4f6f8fu32)).to_equal(true)
        expect(_near(px, 159, 88, 0xa7b7c7u32)).to_equal(true)
        expect(_near(px, 170, 94, 0xcf8f47u32)).to_equal(true)
