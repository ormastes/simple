"""
## Purpose and audience
Purpose: Pin the round-5 invariant that PAINT and LAYOUT measure an inline text
run with the SAME advances. Round 4 made layout size a run from the resolved
per-glyph font metrics while paint kept stepping glyphs by a flat per-character
estimate and computed its aligned line width by indexing the measured advance
array with BYTE offsets; where the three disagreed, glyphs were drawn at
positions the box was never sized for. That divergence is the measured
`forms-media` pixel regression in
doc/08_tracking/bug/web_forms_media_pixel_regression_layout_paint_advance_disagree_2026-09-12.md.
Audience: browser-engine layout/paint maintainers.

Chrome oracle (headless --dump-dom + getBoundingClientRect on
test/fixtures/browser_engine/layout/round4_probe.html at 900x20000, body
margin 0, font 16px/1.5 sans-serif) -- the same harvest round 4 used:
  e1  164 19 68 18      a1  293 19 108 18
Every figure asserted below is Chrome's within the +/-1 px comparison tolerance
the geometry differ uses.

What this spec does and does NOT pin, stated plainly:
  - It pins the WIDTH half: `paint_line_w` is computed by the debug entry point
    through the very functions paint uses (`style_run_byte_advances` +
    `style_text_line_advance_width_with`), so asserting it equals the element's
    layout box width `w` is a real parity assertion, not a tautology -- before
    round 5 those two numbers were produced by different code and differed.
  - It does NOT pin the RASTERIZER half (that `fb_text_thin_scaled_clip_range_adv`
    steps `cx` by the same table). Nothing in-process can observe painted glyph
    positions by element id; that half's evidence is the pixel-differ table in
    doc/10_metrics/ui/chrome_vs_simple_catalog_diff_macos_2026-09-12.md, round 5.
    Recorded as a gap rather than claimed.
"""

# @req: REQ-BROWSER-ENGINE-PAINT-ADVANCE-PARITY-001 — paint measures an inline run with the same per-glyph advances layout sized it with.
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_layout_by_id
}

val VW: i32 = 900
val VH: i32 = 20000

# Byte-identical body of test/fixtures/browser_engine/layout/round4_probe.html
# (inlined so the spec does not depend on the runner's cwd), same as
# inline_run_advance_and_break_boxes_spec.spl.
val PAGE: text = (
    "<!doctype html><html><head><meta charset=\"utf-8\"><style>" +
    "  * { box-sizing: border-box; }" +
    "  body { margin: 0; font: 16px/1.5 sans-serif; }" +
    "</style></head><body>" +
    "<p id=\"p1\">Paragraph with <strong id=\"s1\">strong</strong>, " +
    "<em id=\"e1\">emphasis</em>, and a <a id=\"a1\" href=\"#x\">working anchor</a>.</p>" +
    "<div id=\"brbox\">one<br id=\"br1\">two<br id=\"br2\"></div>" +
    "<ul id=\"ul1\"><li id=\"li1\"><code id=\"c1\">align-content</code> &mdash; partial" +
    "<p id=\"lp1\">No claim.</p></li><li id=\"li2\">short</li></ul>" +
    "<table id=\"t1\"><tbody><tr id=\"r1\"><td id=\"d1\">cell one</td>" +
    "<td id=\"d2\">cell two</td></tr></tbody></table>" +
    "</body></html>"
)

fn field(id: text, name: text) -> text:
    simple_web_layout_debug_layout_by_id(PAGE, VW, VH, id, name)

fn num(id: text, name: text) -> i32:
    val raw = field(id, name)
    if raw == "": return -1
    parse_int(raw)

fn within(a: i32, b: i32, tol: i32) -> bool:
    val d = if a > b: a - b else: b - a
    d <= tol

describe "paint and layout agree on inline run advances":

    it "measures <em>'s run with the width layout sized its box to (Chrome 68)":
        val layout_w = num("e1", "w")
        val paint_w = num("e1", "paint_line_w")
        expect(paint_w).to_equal(layout_w)   # oracle: parity is the invariant
        expect(within(paint_w, 68, 1)).to_equal(true)

    it "measures <a>'s run with the width layout sized its box to (Chrome 108)":
        val layout_w = num("a1", "w")
        val paint_w = num("a1", "paint_line_w")
        expect(paint_w).to_equal(layout_w)
        expect(within(paint_w, 108, 1)).to_equal(true)

    it "agrees on a non-ASCII run, where byte-indexed advances used to skew":
        # li1's text child carries an em dash. The pre-round-5 paint width
        # indexed the per-CODEPOINT advance array with BYTE offsets, so every
        # byte after the em dash read a neighbour's advance; the new table
        # carries the advance on the lead byte and 0 on each continuation byte.
        # No Chrome number is asserted here on purpose -- `<code>`'s own width
        # is still 5 px out (round-4 remainder item 4) so the line total is not
        # a clean oracle. What IS pinned is that a width is produced at all and
        # that it is the measured one, not the flat estimate, which for this
        # run is materially wider.
        val paint_w = num("li1", "paint_line_w")
        val flat_estimate = 15 * 10   # 15 glyphs * the 10 px flat 16 px advance
        expect(paint_w > 0).to_equal(true)
        expect(paint_w < flat_estimate).to_equal(true)
