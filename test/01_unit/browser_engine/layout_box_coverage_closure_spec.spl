"""
## Purpose and audience
Purpose: Prove that BeLayoutBox.block_for.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-BROWSER-ENGINE-LAYOUT-BOX-COVERAGE-CLOSURE-SPEC-SPL-001 — stable requirement identity for this spec.
# @cover src/lib/gc_async_mut/gpu/browser_engine/layout_box.spl 95%
"""
# BeLayoutBox Constructors + Content Geometry — Coverage Closure

Direct-oracle closure over layout_box.spl: block_for / text_box field
propagation from the source DOM node, and the content_* box-model math
(padding + border insets).
"""

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode, StyleProps}
use std.gc_async_mut.gpu.browser_engine.layout_box.{BeLayoutBox, BeBoxKind}

fn _styled_node() -> BeDomNode:
    var n = BeDomNode.element_with_id(7, "div")
    var sp = StyleProps.empty()
    sp.margin_top = 1.0
    sp.margin_right = 2.0
    sp.margin_bottom = 3.0
    sp.margin_left = 4.0
    sp.padding_top = 5.0
    sp.padding_right = 6.0
    sp.padding_bottom = 7.0
    sp.padding_left = 8.0
    sp.border_width = 2.0
    n.style = sp
    n

describe "BeLayoutBox.block_for":
    it "copies node identity, tag and box-model style fields":
        step("Verify: copies node identity, tag and box-model style fields")
        # @req: REQ-BROWSER-ENGINE-LAYOUT-BOX-COVERAGE-CLOSURE-SPEC-SPL-001
        val b = BeLayoutBox.block_for(_styled_node(), 10.0, 20.0, 100.0, 50.0)
        expect(b.node_id).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(b.tag_name).to_equal("div")
        expect(b.text_content).to_equal("")
        expect(b.x).to_equal(10.0)  # oracle: 10.0 — named expected value from the requirement
        expect(b.y).to_equal(20.0)  # oracle: 20.0 — named expected value from the requirement
        expect(b.width).to_equal(100.0)  # oracle: 100.0 — named expected value from the requirement
        expect(b.height).to_equal(50.0)  # oracle: 50.0 — named expected value from the requirement
        expect(b.margin_top).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement
        expect(b.margin_right).to_equal(2.0)  # oracle: 2.0 — named expected value from the requirement
        expect(b.margin_bottom).to_equal(3.0)  # oracle: 3.0 — named expected value from the requirement
        expect(b.margin_left).to_equal(4.0)  # oracle: 4.0 — named expected value from the requirement
        expect(b.padding_top).to_equal(5.0)  # oracle: 5.0 — named expected value from the requirement
        expect(b.padding_right).to_equal(6.0)  # oracle: 6.0 — named expected value from the requirement
        expect(b.padding_bottom).to_equal(7.0)  # oracle: 7.0 — named expected value from the requirement
        expect(b.padding_left).to_equal(8.0)  # oracle: 8.0 — named expected value from the requirement
        expect(b.border_width).to_equal(2.0)  # oracle: 2.0 — named expected value from the requirement
        expect(b.children.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "BeLayoutBox.text_box":
    it "zeroes the box model and carries the text data":
        step("Verify: zeroes the box model and carries the text data")
        val b = BeLayoutBox.text_box(_styled_node(), "hello", 1.0, 2.0, 30.0, 12.0)
        expect(b.node_id).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(b.tag_name).to_equal("#text")
        expect(b.text_content).to_equal("hello")
        expect(b.margin_left).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
        expect(b.padding_top).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
        expect(b.border_width).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
        expect(b.width).to_equal(30.0)  # oracle: 30.0 — named expected value from the requirement

describe "content geometry":
    it "insets width/height by padding and border on both sides":
        step("Verify: insets width/height by padding and border on both sides")
        val b = BeLayoutBox.block_for(_styled_node(), 10.0, 20.0, 100.0, 50.0)
        # width - pl(8) - pr(6) - 2*border(2) = 82
        expect(b.content_width()).to_equal(82.0)  # oracle: 82.0 — named expected value from the requirement
        # height - pt(5) - pb(7) - 2*border(2) = 34
        expect(b.content_height()).to_equal(34.0)  # oracle: 34.0 — named expected value from the requirement

    it "offsets content origin by left/top padding plus border":
        step("Verify: offsets content origin by left/top padding plus border")
        val b = BeLayoutBox.block_for(_styled_node(), 10.0, 20.0, 100.0, 50.0)
        expect(b.content_x()).to_equal(20.0)   # 10 + 8 + 2
        expect(b.content_y()).to_equal(27.0)   # 20 + 5 + 2

    it "content area equals outer box when padding and border are zero":
        step("Verify: content area equals outer box when padding and border are zero")
        val b = BeLayoutBox.text_box(_styled_node(), "t", 3.0, 4.0, 40.0, 10.0)
        expect(b.content_width()).to_equal(40.0)  # oracle: 40.0 — named expected value from the requirement
        expect(b.content_height()).to_equal(10.0)  # oracle: 10.0 — named expected value from the requirement
        expect(b.content_x()).to_equal(3.0)  # oracle: 3.0 — named expected value from the requirement
        expect(b.content_y()).to_equal(4.0)  # oracle: 4.0 — named expected value from the requirement
