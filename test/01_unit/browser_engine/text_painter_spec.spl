"""
## Purpose and audience
Purpose: Prove that Browser text painter.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-BROWSER-ENGINE-001 — stable requirement identity for this spec.

use std.spec.*
use std.gc_async_mut.gpu.browser_engine.text_painter.{
    br_famous_site_corpus_layout_lines,
    br_famous_site_corpus_layout_line_widths_sdn,
    br_famous_site_corpus_layout_paint_runs,
    br_famous_site_corpus_layout_paint_runs_sdn,
    browser_chrome_text_scanline_write_y_probe}

describe "Browser text painter":
    it "keeps Chrome text glyph scanlines at their native y coordinate":
        step("Verify: keeps Chrome text glyph scanlines at their native y coordinate")
        # @req: REQ-BROWSER-ENGINE-001
        expect(browser_chrome_text_scanline_write_y_probe(2)).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(browser_chrome_text_scanline_write_y_probe(48)).to_equal(48)  # oracle: 48 — named expected value from the requirement
        expect(browser_chrome_text_scanline_write_y_probe(49)).to_equal(49)  # oracle: 49 — named expected value from the requirement

    it "wraps the Google corpus text into multiple pixel-width lines":
        step("Verify: wraps the Google corpus text into multiple pixel-width lines")
        val html = "<html><body><div style='width: 120px; height: 40px; background-color: #2563eb; font-family: Arial, sans-serif'>Google search deterministic compatibility fixture</div></body></html>"
        val lines = br_famous_site_corpus_layout_lines(html, 16, 120)
        expect(lines.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(lines.join("|")).to_equal("Google search|deterministic|compatibility|fixture")
        val widths = br_famous_site_corpus_layout_line_widths_sdn(html, 16, 120)
        expect(widths).to_contain("(line text: \"Google search\" width: 105)")

    it "exposes calibrated paint runs for production text compositing":
        step("Verify: exposes calibrated paint runs for production text compositing")
        val html = "<html><body><div data-font-corpus=\"known-site-fonts\" style='width: 120px; height: 40px; background-color: #2563eb; font-family: Arial, sans-serif'>Google search deterministic compatibility fixture</div></body></html>"
        val runs = br_famous_site_corpus_layout_paint_runs(html, 16, 120, 8, 8, 18)
        expect(runs.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(runs[0].line).to_equal("Google search")
        expect(runs[0].x).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(runs[0].y).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(runs[0].width).to_equal(105)  # oracle: 105 — named expected value from the requirement
        expect(runs[1].line).to_equal("deterministic")
        expect(runs[1].y).to_equal(26)  # oracle: 26 — named expected value from the requirement
        val sdn = br_famous_site_corpus_layout_paint_runs_sdn(html, 16, 120, 8, 8, 18)
        expect(sdn).to_contain("count: 4")
        expect(sdn).to_contain("(run text: \"Google search\" x: 8 y: 8 width: 105)")
        expect(sdn).to_contain("(run text: \"compatibility\" x: 8 y: 44")

    it "uses corpus font stack metrics for wider Chrome line breaks":
        step("Verify: uses corpus font stack metrics for wider Chrome line breaks")
        val html = "<html><body><div data-font-corpus=\"known-site-fonts\" style='width: 120px; height: 40px; background-color: #0f766e; font-family: \"Times New Roman\", Times, serif'>TikTok productivity deterministic compatibility fixture</div></body></html>"
        val lines = br_famous_site_corpus_layout_lines(html, 16, 120)
        expect(lines.len()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(lines.join("|")).to_equal("TikTok|productivity|deterministic|compatibility|fixture")
