"""
## Purpose and audience
Purpose: Pin the integer device-scale path of the web renderer. Layout stays in
CSS px; `draw_ir_composition_at_device_scale` multiplies every geometry field
and every length style prop Engine2D consumes by an integer factor k, and
`simple_web_render_html_to_pixels_at_device_scale` renders a (css_w*k)x(css_h*k)
framebuffer from it. Text is re-rasterized at k x font-size (real vector
glyphs), never upscaled pixels.
Audience: browser-engine and Engine2D maintainers; the 300-dpi Chrome-parity
gate (Chrome `--force-device-scale-factor=4`) depends on this path.
"""

"""
Traceability: REQ-BROWSER-ENGINE-DEVICE-SCALE-001 — integer device-scale render path for >=300 dpi Chrome parity.
"""
# @cover src/lib/common/ui/draw_ir_device_scale.spl 60%
use std.spec.*
use std.common.ui.draw_ir.{
    DrawIrComposition, DrawIrStyleProp,
    draw_ir_batch, draw_ir_composition, draw_ir_embedding_config,
    draw_ir_glyph_run_payload, draw_ir_rect_bounds, draw_ir_style_prop,
    draw_ir_text_shaped_font, draw_ir_box_with_style
}
use std.common.ui.draw_ir_device_scale.{draw_ir_composition_at_device_scale}
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_software_pixels
}
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{
    simple_web_render_html_to_pixels,
    simple_web_render_html_to_pixels_at_device_scale,
    simple_web_render_html_to_pixels_with_resolved_engine2d_backend
}

fn style_value(style: [DrawIrStyleProp], key: text) -> text:
    for prop in style:
        if prop.key == key:
            return prop.value
    "<absent>"

fn box_fixture() -> DrawIrComposition:
    val style = [
        draw_ir_style_prop("background-color", "4278190335"),
        draw_ir_style_prop("border-top-width", "1"),
        draw_ir_style_prop("border-left-width", "1"),
        draw_ir_style_prop("border-top-color", "4278190080"),
        draw_ir_style_prop("border-top-left-radius", "2"),
        draw_ir_style_prop("box-shadow", "2px -3px 4278190080"),
        draw_ir_style_prop("box-shadow-blur-radius", "5"),
        draw_ir_style_prop("box-shadow-layer-0-offset-x", "-2"),
        draw_ir_style_prop("box-shadow-layer-0-spread-radius", "1"),
        draw_ir_style_prop("box-shadow-layer-0-color", "4278190080"),
        draw_ir_style_prop("background-gradient-stops", "4278190080,4294967295,0,1000"),
        draw_ir_style_prop("background-gradient-angle-deg", "90"),
        draw_ir_style_prop("background-tile-width", "7"),
        draw_ir_style_prop("backdrop-filter-realized-blur-radius-px", "4"),
        draw_ir_style_prop("z-index", "3")
    ]
    val box = draw_ir_box_with_style(
        "box", 2, 3, 10, 6, 4278190335u32,
        draw_ir_rect_bounds(2, 3, 10, 6), draw_ir_rect_bounds(3, 4, 8, 4),
        draw_ir_rect_bounds(2, 3, 10, 6), draw_ir_rect_bounds(0, 0, 20, 12),
        style)
    val run = draw_ir_glyph_run_payload([36u32, 72u32], [0, 8], [12, 12], [0, 1], true)
    val label = draw_ir_text_shaped_font(
        "label", 1, 2, "AB", 4278190080u32, "DejaVu Sans",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", [8, 9], 17, 18, 16, run)
    draw_ir_composition("c", "scene", "cpu", [
        draw_ir_batch("b", "cpu", draw_ir_embedding_config("s", "root", 0, 0, 20, 12, 0, 1000, true),
            [box, label])
    ])

describe "draw_ir_composition_at_device_scale":
    it "scales command, rect and embedding geometry by k":
        val scaled = draw_ir_composition_at_device_scale(box_fixture(), 4)
        val batch = scaled.batches[0]
        expect(batch.embedding.width).to_equal(80)
        expect(batch.embedding.height).to_equal(48)
        val box = batch.commands[0]
        expect(box.x).to_equal(8)
        expect(box.y).to_equal(12)
        expect(box.width).to_equal(40)
        expect(box.height).to_equal(24)
        expect(box.content_rect.x).to_equal(12)
        expect(box.content_rect.width).to_equal(32)
        expect(box.clip_rect.width).to_equal(80)
        expect(box.clip_rect.height).to_equal(48)
        expect(box.color).to_equal(4278190335u32)

    it "scales length style props and leaves non-length props untouched":
        val box = draw_ir_composition_at_device_scale(box_fixture(), 4).batches[0].commands[0]
        val style = box.computed_style
        expect(style_value(style, "border-top-width")).to_equal("4")
        expect(style_value(style, "border-left-width")).to_equal("4")
        expect(style_value(style, "border-top-left-radius")).to_equal("8")
        expect(style_value(style, "box-shadow")).to_equal("8px -12px 4278190080")
        expect(style_value(style, "box-shadow-blur-radius")).to_equal("20")
        expect(style_value(style, "box-shadow-layer-0-offset-x")).to_equal("-8")
        expect(style_value(style, "box-shadow-layer-0-spread-radius")).to_equal("4")
        expect(style_value(style, "background-tile-width")).to_equal("28")
        expect(style_value(style, "backdrop-filter-realized-blur-radius-px")).to_equal("16")
        # Colors, permille gradient positions, angles and indices are not lengths.
        expect(style_value(style, "background-color")).to_equal("4278190335")
        expect(style_value(style, "border-top-color")).to_equal("4278190080")
        expect(style_value(style, "box-shadow-layer-0-color")).to_equal("4278190080")
        expect(style_value(style, "background-gradient-stops")).to_equal("4278190080,4294967295,0,1000")
        expect(style_value(style, "background-gradient-angle-deg")).to_equal("90")
        expect(style_value(style, "z-index")).to_equal("3")

    it "scales text font-size, line-height, advances and glyph positions":
        val label = draw_ir_composition_at_device_scale(box_fixture(), 4).batches[0].commands[1]
        expect(style_value(label.computed_style, "font-size")).to_equal("64")
        expect(style_value(label.computed_style, "line-height")).to_equal("72")
        expect(style_value(label.computed_style, "font-identity")).to_equal("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf")
        expect(label.advance_widths).to_equal([32, 36])
        expect(label.width).to_equal(68)
        expect(label.glyph_run.xs).to_equal([0, 32])
        expect(label.glyph_run.ys).to_equal([48, 48])
        expect(label.glyph_run.glyph_ids).to_equal([36u32, 72u32])

    it "is the identity at k=1":
        val base = box_fixture()
        val same = draw_ir_composition_at_device_scale(base, 1)
        expect(same.batches).to_equal(base.batches)

val BOX_PAGE = (
    "<html><body style=\"margin:0;padding:0;background:#ffffff\">" +
    "<div style=\"width:8px;height:4px;background:#0000ff;border:1px solid #000000\"></div>" +
    "</body></html>"
)

val TEXT_PAGE = (
    "<html><body style=\"margin:0;padding:0;background:#ffffff;font-family:'DejaVu Sans';font-size:16px\">" +
    "<p style=\"margin:0\">Hg</p></body></html>"
)

fn device_rgb(pixel: u32) -> u32:
    pixel & 0x00FFFFFFu32

fn ink_count(pixels: [u32]) -> i32:
    var count = 0
    for pixel in pixels:
        if device_rgb(pixel) != 0x00FFFFFFu32:
            count = count + 1
    count

describe "simple_web_render_html_to_pixels_at_device_scale":
    it "covers exactly 40x24 device px with a 4px border for a 10x6 CSS box at k=4":
        val w = 80
        val pixels = simple_web_render_html_to_pixels_at_device_scale(BOX_PAGE, 20, 12, 4)
        expect(pixels.len()).to_equal(80 * 48)
        expect(ink_count(pixels)).to_equal(40 * 24)
        expect(device_rgb(pixels[0])).to_equal(0x000000u32)
        expect(device_rgb(pixels[3 * w + 3])).to_equal(0x000000u32)
        expect(device_rgb(pixels[4 * w + 4])).to_equal(0x0000FFu32)
        expect(device_rgb(pixels[19 * w + 35])).to_equal(0x0000FFu32)
        expect(device_rgb(pixels[20 * w + 36])).to_equal(0x000000u32)
        expect(device_rgb(pixels[23 * w + 39])).to_equal(0x000000u32)
        expect(device_rgb(pixels[24 * w + 40])).to_equal(0xFFFFFFu32)

    it "is byte-identical to the CSS-px pixel API at k=1":
        expect(simple_web_render_html_to_pixels_at_device_scale(BOX_PAGE, 20, 12, 1))
            .to_equal(simple_web_render_html_to_pixels(BOX_PAGE, 20, 12))
        expect(simple_web_render_html_to_pixels_at_device_scale(TEXT_PAGE, 40, 24, 1))
            .to_equal(simple_web_render_html_to_pixels(TEXT_PAGE, 40, 24))

    it "re-rasterizes text at k x font-size instead of upscaling pixels":
        val small = simple_web_render_html_to_pixels(TEXT_PAGE, 40, 24)
        val big = simple_web_render_html_to_pixels_at_device_scale(TEXT_PAGE, 40, 24, 4)
        expect(big.len()).to_equal(160 * 96)
        val small_ink = ink_count(small)
        val big_ink = ink_count(big)
        # Re-pinned 2026-11-17 for LCD subpixel text (owner: same as Chrome).
        # 16 px text is LCD at 1x (<= 48 device px): FIR fringes widen the 1x
        # ink. At 4x it is 64 device px, which is grayscale. So 4x ink is 8.6x
        # the 1x ink here, not the old > 10x bound. Chrome 159 on this HTML:
        # 199 px at 1x, 1640 px at 4x, i.e. 8.2x.
        # Re-pinned 2026-11-17 for slight vertical hinting (sfnt_glyf.spl blue-zone
        # fit): 1x ink 190 -> 186. Measured against Chrome 159 on this exact page
        # (40x24 crop, DejaVu Sans 16 px, same ink definition): Chrome 146 ink px
        # at 1x and 1230 at 4x (the 199/1640 above were a different crop). 186 is
        # closer to 146 than 190 was, and the per-pixel mismatch (> 8 per channel)
        # against Chrome drops 114 -> 77 of 960. The 4x frame is grayscale and
        # unchanged (1629; hinting is applied to the LCD raster only).
        # Re-pinned 2026-11-23 for the Skia LCD path raster
        # (glyph_raster_shape_chrome159_spec): 1x ink 186 -> 199. Chrome 159 on
        # this page re-measured on this host (40x24 crop, same ink definition):
        # 199 ink px; per-pixel mismatch (> 8 per channel) 34 -> 13 of 960 and
        # summed channel delta 2,657 -> 1,194. The 4x frame is grayscale and
        # unchanged.
        expect(small_ink).to_equal(199)
        # Re-pinned 2026-11-18 for the baseline-anchored grayscale frame
        # (`_gray_frame`, sfnt_glyf.spl): 4x ink 1629 -> 1625. Chrome 159 on this
        # page at 4x (160x96, same ink definition): 1640 ink px. Per-pixel mismatch
        # (> 8 per channel) against Chrome drops 664 -> 445 of 15360 and the summed
        # channel difference 191742 -> 75900; ink count is not the closeness metric.
        # Re-pinned 2026-11-24 for gray glyphs at Skia quarter phases with exact
        # area coverage (gray_glyph_subpixel_area_chrome159_spec): 4x ink 1625 ->
        # 1655 (Chrome 1640). Per-pixel mismatch against Chrome 445 -> 86 of
        # 15360, summed channel difference 75900 -> 10869.
        expect(big_ink).to_equal(1655)
        # A nearest-neighbour upscale makes every aligned 4x4 block uniform.
        var nonuniform_blocks = 0
        var by = 0
        while by < 24:
            var bx = 0
            while bx < 40:
                val first = big[(by * 4) * 160 + bx * 4]
                var differs = false
                var dy = 0
                while dy < 4:
                    var dx = 0
                    while dx < 4:
                        if big[(by * 4 + dy) * 160 + bx * 4 + dx] != first:
                            differs = true
                        dx = dx + 1
                    dy = dy + 1
                if differs:
                    nonuniform_blocks = nonuniform_blocks + 1
                bx = bx + 1
            by = by + 1
        expect(nonuniform_blocks > 0).to_equal(true)

# ---------------------------------------------------------------------------
# radial-gradient parity with Chrome 159 at device scale 4 (384 dpi).
#
# Expected pixels are Chrome 159's own, sampled at named device points:
#   chrome --headless --no-sandbox --hide-scrollbars \
#     --force-device-scale-factor=4 --window-size=W,H --screenshot=<png> file://<html>
# (chromium-1255, linux-arm64), with <html> = radial_doc(W, H, <bg>) below
# (the widget page is radial_widget_body_page()).
# Tolerance: +-2 per channel. Measured 2026-11-17: over every pixel of the
# five div/40x64 frames (117,760 device px) Chrome deviates from the ideal
# CSS Images 3 value (pixel-centre sample, premultiplied-sRGB stop
# interpolation, colour clamped past the last stop, src-over the box colour)
# by at most 0.995 per channel -- no visible gradient dither; the 40x72
# widget frame by at most 0.99. Simple's 1/1024 px geometry
# and 1025-entry stop ramp add at most ~0.5 more, so +-2 bounds both.
# ---------------------------------------------------------------------------

fn radial_doc(w: i32, h: i32, bg: text) -> text:
    "<html><body style=\"margin:0;background:#fff\"><div style=\"width:" + "{w}" + "px;height:" + "{h}" + "px;" + bg + "\"></div></body></html>"

fn radial_widget_body_page() -> text:
    # PR #9930's residual: a radial body background under legacy widget
    # chrome (no <style>, a widget-panel). Chrome propagates the body
    # background to the canvas: the gradient box is the 40x64 viewport.
    "<html><body style=\"background-image:radial-gradient(circle,#ff0000 0%,#0000ff 100%)\"><section class=\"widget-panel\"></section></body></html>"

fn radial_channel_dev(got: u32, want: u32) -> i32:
    var worst = 0
    var sh = 0u32
    while sh <= 16u32:
        val g = ((got >> sh) & 255u32) as i32
        val w = ((want >> sh) & 255u32) as i32
        val d = if g > w: g - w else: w - g
        if d > worst:
            worst = d
        sh = sh + 8u32
    worst

# Largest per-channel deviation from Chrome over the sample points
# (pts = x0, y0, x1, y1, ...); 999 when a point is off the frame.
fn radial_max_dev(px: [u32], fw: i32, pts: [i32], want: [u32]) -> i32:
    var worst = 0
    var i = 0
    while i < want.len():
        val idx = pts[2 * i + 1] * fw + pts[2 * i]
        if idx < 0 or idx >= px.len():
            return 999
        val d = radial_channel_dev(px[idx], want[i])
        if d > worst:
            worst = d
        i = i + 1
    worst

val RADIAL_A_BG = "background:radial-gradient(#ff0000,#0000ff)"
val RADIAL_A_PTS: [i32] = [80, 48, 120, 48, 80, 80, 0, 0, 159, 95, 40, 20]
val RADIAL_A_CHROME: [u32] = [0xFFFC0002u32, 0xFFA3005Bu32, 0xFF84007Au32, 0xFF0200FCu32, 0xFF0200FDu32, 0xFF760088u32]
val RADIAL_B_BG = "background:radial-gradient(circle closest-side at 25% 75%, #00ff00, #0000ff)"
val RADIAL_B_PTS: [i32] = [40, 96, 56, 96, 40, 80, 100, 40, 159, 0]
val RADIAL_B_CHROME: [u32] = [0xFF00F905u32, 0xFF007B83u32, 0xFF00837Bu32, 0xFF0000FFu32, 0xFF0000FFu32]
val RADIAL_C_BG = "background:radial-gradient(circle, #ff0000 0%, #ffff00 30%, #00ff00 60%, #0000ff 100%)"
val RADIAL_C_PTS: [i32] = [80, 80, 100, 80, 120, 80, 80, 140, 140, 140, 0, 0]
val RADIAL_C_CHROME: [u32] = [0xFFFF0500u32, 0xFFFF9A00u32, 0xFFCDFF00u32, 0xFF37FF00u32, 0xFF009B63u32, 0xFF0003FBu32]
val RADIAL_D_BG = "background-color:#ffff00;background-image:radial-gradient(circle, #0000ff, transparent)"
val RADIAL_D_PTS: [i32] = [80, 48, 120, 48, 0, 0, 159, 95, 80, 10]
val RADIAL_D_CHROME: [u32] = [0xFF0202FDu32, 0xFF6F6F90u32, 0xFFFDFD01u32, 0xFFFDFD02u32, 0xFF676798u32]
# Widget page points avoid the legacy widget chrome Simple paints on top.
# Chrome positions the propagated body radial on the html box (at least the
# viewport: these pages have no doctype). Simple's legacy widget layout gives
# the empty widget-panel section 56 px (Chrome: 0), so Simple's html box is
# 72 px tall and its canvas centre sits at (20, 36), not Chrome's 40x64
# viewport centre (20, 32) -- a widget LAYOUT divergence, not a radial one.
# The 40x64 Chrome match is therefore not met; the pixels below are Chrome's
# at --window-size=40,72, whose canvas equals Simple's html box (Chrome there
# deviates from the ideal by at most 0.99 per channel).
val RADIAL_E_PTS: [i32] = [42, 122, 82, 122, 122, 194, 62, 98, 42, 74]
val RADIAL_E_CHROME: [u32] = [0xFFBC0042u32, 0xFFDD0021u32, 0xFF980066u32, 0xFFB3004Bu32, 0xFF84007Au32]

fn radial_cpu_simd_k4(cw: i32, ch: i32, bg: text) -> [u32]:
    simple_web_layout_render_html_pixels_engine2d_at_device_scale(radial_doc(cw, ch, bg), cw, ch, 4, "cpu_simd")

# The CPU raster has no device-scale entry; laying the same box out at 4x
# CSS px paints the same device picture (keywords and percentages scale).
fn radial_raster_4x(cw: i32, ch: i32, bg: text) -> [u32]:
    simple_web_layout_render_html_software_pixels(radial_doc(cw * 4, ch * 4, bg), cw * 4, ch * 4, 600000)

describe "radial-gradient backgrounds match Chrome 159 at device scale 4":
    it "carries the resolved radial geometry as Q10 px scaled by k":
        val style = [draw_ir_style_prop("background-gradient-radial-geometry", "1024,-512,2048,3072,0,0,4096,5120")]
        val box = draw_ir_box_with_style(
            "r", 1, 1, 4, 5, 0u32,
            draw_ir_rect_bounds(1, 1, 4, 5), draw_ir_rect_bounds(1, 1, 4, 5),
            draw_ir_rect_bounds(1, 1, 4, 5), draw_ir_rect_bounds(0, 0, 8, 8), style)
        val comp = draw_ir_composition("c", "scene", "cpu", [
            draw_ir_batch("b", "cpu", draw_ir_embedding_config("s", "root", 0, 0, 8, 8, 0, 1000, true), [box])
        ])
        val scaled = draw_ir_composition_at_device_scale(comp, 4)
        expect(style_value(scaled.batches[0].commands[0].computed_style, "background-gradient-radial-geometry")).to_equal("4096,-2048,8192,12288,0,0,16384,20480")

    it "paints an ellipse farthest-corner two-stop gradient on cpu_simd as Chrome does":
        expect(radial_max_dev(radial_cpu_simd_k4(40, 24, RADIAL_A_BG), 160, RADIAL_A_PTS, RADIAL_A_CHROME)).to_be_less_than(3)

    it "paints a circle closest-side at 25% 75% on cpu_simd as Chrome does, clamped past the last stop":
        expect(radial_max_dev(radial_cpu_simd_k4(40, 32, RADIAL_B_BG), 160, RADIAL_B_PTS, RADIAL_B_CHROME)).to_be_less_than(3)

    it "paints four stops at explicit positions on cpu_simd as Chrome does":
        expect(radial_max_dev(radial_cpu_simd_k4(40, 40, RADIAL_C_BG), 160, RADIAL_C_PTS, RADIAL_C_CHROME)).to_be_less_than(3)

    it "fades to transparent over the box colour in premultiplied sRGB on cpu_simd as Chrome does":
        expect(radial_max_dev(radial_cpu_simd_k4(40, 24, RADIAL_D_BG), 160, RADIAL_D_PTS, RADIAL_D_CHROME)).to_be_less_than(3)

    it "paints the legacy widget body radial on the canvas on cpu_simd as Chrome does":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(radial_widget_body_page(), 40, 64, 4, "cpu_simd")
        expect(radial_max_dev(px, 160, RADIAL_E_PTS, RADIAL_E_CHROME)).to_be_less_than(3)

    it "paints the same four radial boxes on the CPU raster as Chrome does":
        expect(radial_max_dev(radial_raster_4x(40, 24, RADIAL_A_BG), 160, RADIAL_A_PTS, RADIAL_A_CHROME)).to_be_less_than(3)
        expect(radial_max_dev(radial_raster_4x(40, 32, RADIAL_B_BG), 160, RADIAL_B_PTS, RADIAL_B_CHROME)).to_be_less_than(3)
        expect(radial_max_dev(radial_raster_4x(40, 40, RADIAL_C_BG), 160, RADIAL_C_PTS, RADIAL_C_CHROME)).to_be_less_than(3)
        expect(radial_max_dev(radial_raster_4x(40, 24, RADIAL_D_BG), 160, RADIAL_D_PTS, RADIAL_D_CHROME)).to_be_less_than(3)

# ---------------------------------------------------------------------------
# Multi-layer CSS gradient backgrounds (CSS Backgrounds 3 §3.1: the FIRST
# listed layer paints on top, background-color under all of them) and the
# untyped single linear layer, matching Chrome 159 at device scale 4.
#
# Expected pixels are Chrome 159's own, sampled at named device points:
#   chrome --headless --no-sandbox --hide-scrollbars \
#     --force-device-scale-factor=4 --window-size=W,H --screenshot=<png> file://<html>
# (chromium-1255, linux-arm64), <html> = radial_doc(W, H, <bg>) above; the
# widget page is gradient_stack_widget_body_page() at --window-size=40,72
# (see RADIAL_E: Simple's legacy widget html box is 72 px tall).
# Tolerance +-2 per channel, re-measured 2026-11-17 for linear and stacks:
# Chrome's single linear layer deviates from the ideal CSS Images 3 model
# (pixel-centre sample, gradient line |w sin|+|h cos|, premultiplied-sRGB
# stops) by at most 0.98 per channel over the whole frame; a two-layer stack
# by at most 1.88 (each layer carries Chrome's gradient dither).
# ---------------------------------------------------------------------------

fn gradient_stack_widget_body_page() -> text:
    # PR #9960's residue probe: a legacy-widget body with a radial over a
    # linear layer. Chrome propagates both layers to the canvas.
    "<html><body style=\"background-image:radial-gradient(circle at 30% 30%, rgba(255,0,0,0.8), transparent 60%), linear-gradient(#ffffff,#0000ff)\"><section class=\"widget-panel\"></section></body></html>"

val GSTACK_PTS_24: [i32] = [8, 8, 80, 48, 150, 20, 40, 90, 120, 80, 100, 10]
val GSTACK_PTS_32: [i32] = [10, 10, 48, 51, 80, 64, 150, 120, 20, 110, 120, 30]
# Linear `to right` with a translucent first stop fading to transparent over
# the box colour (an untyped layer: a transparent end stop).
val GSTACK_L1_BG = "background-color:#ffff00;background-image:linear-gradient(to right, rgba(0,0,255,0.6), transparent)"
val GSTACK_L1_CHROME: [u32] = [0xFF6E6E90u32, 0xFFB3B34Cu32, 0xFFF6F609u32, 0xFF8D8D72u32, 0xFFD9D925u32, 0xFFC6C639u32]
# A TYPED linear layer (no zero stop) with translucent stops over the box
# colour: the typed Draw IR path must paint the colour under it.
val GSTACK_L1B_BG = "background-color:#ffff00;background-image:linear-gradient(to right, rgba(0,0,255,0.6), rgba(0,0,255,0.1))"
val GSTACK_L1B_CHROME: [u32] = [0xFF6D6D92u32, 0xFFA6A659u32, 0xFFDDDD21u32, 0xFF868678u32, 0xFFC6C639u32, 0xFFB6B649u32]
# Linear 45deg, three stops, on a non-square box.
val GSTACK_L2_BG = "background:linear-gradient(45deg, #ff0000, #00ff00 40%, #0000ff)"
val GSTACK_L2_CHROME: [u32] = [0xFF0FEF00u32, 0xFF00D42Au32, 0xFF0032CDu32, 0xFF8C7200u32, 0xFF00C737u32, 0xFF00748Au32]
# Shorthand: radial on top of a linear layer (no colour layer).
val GSTACK_S1_BG = "background:radial-gradient(circle at 30% 40%, #ff0000, transparent 50%), linear-gradient(to bottom, #00ff00, #0000ff)"
val GSTACK_S1_CHROME: [u32] = [0xFF2FBF10u32, 0xFFFD0101u32, 0xFF7B4142u32, 0xFF000FF0u32, 0xFF0922D4u32, 0xFF00C23Cu32]
# Longhands: linear on top of a radial whose centre is transparent, over
# background-color (all three show through somewhere).
val GSTACK_S2_BG = "background-color:#ffff00;background-image:linear-gradient(90deg, rgba(255,0,0,0.8), transparent 60%), radial-gradient(circle, transparent 20%, #0000ff)"
val GSTACK_S2_CHROME: [u32] = [0xFFC20D3Cu32, 0xFFE6811Au32, 0xFFFFDE00u32, 0xFF2626D9u32, 0xFFBF1F3Fu32, 0xFF9B9B63u32]
# Points clear of the legacy widget chrome Simple paints over the canvas
# (panel frame and its two inner boxes; (100,160) would land on one).
val GSTACK_S3_PTS: [i32] = [42, 122, 82, 122, 122, 194, 62, 98, 42, 74, 136, 160]
val GSTACK_S3_CHROME: [u32] = [0xFFD23C69u32, 0xFFC9477Du32, 0xFF594FF5u32, 0xFFE3344Fu32, 0xFFEC3446u32, 0xFF8261DDu32]

fn gstack_mismatches(a: [u32], b: [u32]) -> i32:
    if a.len() != b.len():
        return -1
    var n = 0
    var i = 0
    while i < a.len():
        if a[i] != b[i]:
            n = n + 1
        i = i + 1
    n

describe "multi-layer gradient backgrounds match Chrome 159 at device scale 4":
    it "carries the resolved gradient layer geometry as Q10 px scaled by k, stops unscaled":
        val style = [
            draw_ir_style_prop("background-gradient-layer-geometry", "0,0,4096,5120,1024,-512,2048,3072"),
            draw_ir_style_prop("background-gradient-layer-stops", "L:4278190335,16711680:0,1000")
        ]
        val box = draw_ir_box_with_style(
            "g", 1, 1, 4, 5, 0u32,
            draw_ir_rect_bounds(1, 1, 4, 5), draw_ir_rect_bounds(1, 1, 4, 5),
            draw_ir_rect_bounds(1, 1, 4, 5), draw_ir_rect_bounds(0, 0, 8, 8), style)
        val comp = draw_ir_composition("c", "scene", "cpu", [
            draw_ir_batch("b", "cpu", draw_ir_embedding_config("s", "root", 0, 0, 8, 8, 0, 1000, true), [box])
        ])
        val scaled = draw_ir_composition_at_device_scale(comp, 4)
        expect(style_value(scaled.batches[0].commands[0].computed_style, "background-gradient-layer-geometry")).to_equal("0,0,16384,20480,4096,-2048,8192,12288")
        expect(style_value(scaled.batches[0].commands[0].computed_style, "background-gradient-layer-stops")).to_equal("L:4278190335,16711680:0,1000")

    it "paints a translucent linear layer fading to transparent over the box colour on cpu_simd and the raster as Chrome does":
        expect(radial_max_dev(radial_cpu_simd_k4(40, 24, GSTACK_L1_BG), 160, GSTACK_PTS_24, GSTACK_L1_CHROME)).to_be_less_than(3)
        expect(radial_max_dev(radial_raster_4x(40, 24, GSTACK_L1_BG), 160, GSTACK_PTS_24, GSTACK_L1_CHROME)).to_be_less_than(3)

    it "paints a typed translucent linear layer over the box colour on cpu_simd and the raster as Chrome does":
        expect(radial_max_dev(radial_cpu_simd_k4(40, 24, GSTACK_L1B_BG), 160, GSTACK_PTS_24, GSTACK_L1B_CHROME)).to_be_less_than(3)
        expect(radial_max_dev(radial_raster_4x(40, 24, GSTACK_L1B_BG), 160, GSTACK_PTS_24, GSTACK_L1B_CHROME)).to_be_less_than(3)

    it "tiles a gradient layer list with a background-size on both lanes as Chrome does":
        # Was pinned colour-only (fail-closed) before per-layer tiling. Now
        # each layer is tiled 10x10 over the box colour. Chrome 159 pixels:
        # bgl_p6.png of background_layer_tiling_chrome159_spec (this page with
        # and without a doctype screenshots byte-identically).
        val bg = "background-color:#ffff00;background-image:linear-gradient(to right, #ff0000, transparent), radial-gradient(#00ff00, #0000ff);background-size:10px 10px"
        val page = radial_doc(40, 24, bg)
        val raster = simple_web_layout_render_html_software_pixels(page, 40, 24)
        val cpu = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(page, 40, 24, "cpu_simd")
        expect(gstack_mismatches(raster, cpu)).to_equal(0)
        val pts: [i32] = [5, 5, 27, 20, 47, 37, 66, 50, 93, 70, 118, 90, 141, 60, 155, 93, 20, 80, 130, 18]
        val chrome: [u32] = [0xFFDC0A19u32, 0xFF50812Fu32, 0xFFCF0B25u32, 0xFF566444u32, 0xFFA93126u32, 0xFF0940B4u32, 0xFF768108u32, 0xFF1D5B87u32, 0xFF7C295Au32, 0xFFBC2C17u32]
        expect(radial_max_dev(radial_cpu_simd_k4(40, 24, bg), 160, pts, chrome)).to_be_less_than(3)

    it "paints a three-stop 45deg linear layer on cpu_simd and the raster as Chrome does":
        expect(radial_max_dev(radial_cpu_simd_k4(40, 24, GSTACK_L2_BG), 160, GSTACK_PTS_24, GSTACK_L2_CHROME)).to_be_less_than(3)
        expect(radial_max_dev(radial_raster_4x(40, 24, GSTACK_L2_BG), 160, GSTACK_PTS_24, GSTACK_L2_CHROME)).to_be_less_than(3)

    it "paints a radial layer on top of a linear layer on cpu_simd and the raster as Chrome does":
        expect(radial_max_dev(radial_cpu_simd_k4(40, 32, GSTACK_S1_BG), 160, GSTACK_PTS_32, GSTACK_S1_CHROME)).to_be_less_than(3)
        expect(radial_max_dev(radial_raster_4x(40, 32, GSTACK_S1_BG), 160, GSTACK_PTS_32, GSTACK_S1_CHROME)).to_be_less_than(3)

    it "shows the lower radial layer and the colour through a transparent linear stop on cpu_simd and the raster as Chrome does":
        expect(radial_max_dev(radial_cpu_simd_k4(40, 32, GSTACK_S2_BG), 160, GSTACK_PTS_32, GSTACK_S2_CHROME)).to_be_less_than(3)
        expect(radial_max_dev(radial_raster_4x(40, 32, GSTACK_S2_BG), 160, GSTACK_PTS_32, GSTACK_S2_CHROME)).to_be_less_than(3)

    it "paints the legacy widget body radial + linear stack on the canvas, raster equal to cpu_simd and cpu_simd as Chrome does":
        val page = gradient_stack_widget_body_page()
        val raster = simple_web_layout_render_html_software_pixels(page, 40, 64)
        val cpu = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(page, 40, 64, "cpu_simd")
        expect(cpu.len()).to_equal(40 * 64)
        expect(gstack_mismatches(raster, cpu)).to_equal(0)
        val k4 = simple_web_layout_render_html_pixels_engine2d_at_device_scale(page, 40, 64, 4, "cpu_simd")
        expect(radial_max_dev(k4, 160, GSTACK_S3_PTS, GSTACK_S3_CHROME)).to_be_less_than(3)
