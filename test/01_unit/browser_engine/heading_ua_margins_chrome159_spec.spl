"""
## Purpose and audience
Purpose: Pin the UA margins of `h1`..`h6`. They are em values of the
heading's own font size; the tag defaults carry them as whole pixels. `h6`
had 26 px where Chrome's 2.33em x 10.72px is 24.98, so every `h6` block was
2 px too tall -- on the catalog's `html` page that shifted the forty list
items after the `h6` example by 2 px.
Audience: browser-engine style maintainers.

Chrome oracle (Chrome 159.0.8154.6 headless shell, 900x4000,
`body{margin:0;font:16px/1.5 sans-serif}`, `<div>aa</div><hN id=t>x</hN>
<div id=b>bb</div>`, getBoundingClientRect y; the first block is 24 px tall):

| heading | t.y    | t.h    | b.y    |
|---------|--------|--------|--------|
| h1      | 45.44  | 48     | 114.88 |
| h2      | 43.91  | 36     | 99.81  |
| h3      | 42.72  | 28.08  | 89.52  |
| h4      | 45.27  | 24     | 90.53  |
| h5      | 46.17  | 19.92  | 88.27  |
| h6      | 48.97  | 16.08  | 90.02  |

Values are asserted within 1 px (whole-pixel layout). The `b.y` column is the
discriminating one: it carries both margins and the heading's height.
"""

"""
Traceability: REQ-BROWSER-ENGINE-HEADING-UA-MARGINS-001 — h1..h6 UA margins match Chrome 159 to the pixel.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_declarations.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_layout_by_id
}

val HEAD: text = "<html><head><style>body{margin:0;font:16px/1.5 sans-serif}</style></head><body><div>aa</div>"
val TAIL: text = "<div id=\"b\">bb</div></body></html>"

fn y_of(tag: text, id: text) -> i32:
    simple_web_layout_debug_layout_by_id(HEAD + "<" + tag + " id=\"t\">x</" + tag + ">" + TAIL, 900, 600, id, "y").to_int()

fn off(actual: i32, chrome: i32) -> i32:
    if actual > chrome: actual - chrome else: chrome - actual

describe "heading UA margins":
    it "AC-1: h6 has 2.33em of its 10.72 px font above and below":
        step("Chrome 159: heading at 48.97, next block at 90.02")
        expect(off(y_of("h6", "t"), 49)).to_be_less_than(2)
        expect(off(y_of("h6", "b"), 90)).to_be_less_than(2)

    it "AC-2: h5 and h4":
        step("Chrome 159: h5 46.17 / 88.27, h4 45.27 / 90.53")
        expect(off(y_of("h5", "t"), 46)).to_be_less_than(2)
        expect(off(y_of("h5", "b"), 88)).to_be_less_than(2)
        expect(off(y_of("h4", "t"), 45)).to_be_less_than(2)
        expect(off(y_of("h4", "b"), 91)).to_be_less_than(2)

    it "AC-3: h3, h2 and h1":
        step("Chrome 159: h3 42.72 / 89.52, h2 43.91 / 99.81, h1 45.44 / 114.88")
        expect(off(y_of("h3", "t"), 43)).to_be_less_than(2)
        expect(off(y_of("h3", "b"), 90)).to_be_less_than(2)
        expect(off(y_of("h2", "t"), 44)).to_be_less_than(2)
        expect(off(y_of("h2", "b"), 100)).to_be_less_than(2)
        expect(off(y_of("h1", "t"), 45)).to_be_less_than(2)
        expect(off(y_of("h1", "b"), 115)).to_be_less_than(2)
