"""
## Purpose and audience
Purpose: Pin `flex-direction: column-reverse` geometry. The cascade read
`column-reverse` as `row`, so its items were laid out side by side and
stretched to the container height -- 21 of the 201 baselined combo-matrix
ids (`cc-fx-fd-colrev-*`).
Audience: browser-engine flex layout maintainers.

Chrome oracle (Chrome 159.0.8154.6 headless shell, `getBoundingClientRect()`
of CR_PAGE at 900 px wide): `#w` 300x90 column-reverse: `a` (0, 66, 50,
24), `t` with margin-top:4px (0, 42, 50, 24), `b` (0, 14, 50, 24). `#v`
`flex-flow: column-reverse wrap`, auto height: 48 tall at y 100; `c` at y
124, `d` at y 100.
"""

"""
Traceability: REQ-BROWSER-ENGINE-FLEX-COLUMN-REVERSE-001 — column-reverse stacks flex items upward from the content box bottom with their physical margins, as Chrome 159.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_engine.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_geometry.{simple_web_layout_debug_layout_by_id}

val CR_PAGE: text = "<!doctype html><html><head><style>body{{margin:0;font:16px/24px sans-serif}}#w{{display:flex;flex-direction:column-reverse;width:300px;height:90px}}#v{{display:flex;flex-flow:column-reverse wrap;width:300px;margin-top:10px}}.i{{width:50px}}</style></head><body><div id=w><div id=a class=i>aa</div><div id=t class=i style=\"margin-top:4px\">cd</div><div id=b class=i>bb</div></div><div id=v><div id=c class=i>cc</div><div id=d class=i>dd</div></div></body></html>"

fn geom(id: text) -> text:
    val x = simple_web_layout_debug_layout_by_id(CR_PAGE, 900, 400, id, "x")
    val y = simple_web_layout_debug_layout_by_id(CR_PAGE, 900, 400, id, "y")
    val w = simple_web_layout_debug_layout_by_id(CR_PAGE, 900, 400, id, "w")
    val h = simple_web_layout_debug_layout_by_id(CR_PAGE, 900, 400, id, "h")
    "{x},{y},{w},{h}"

describe "flex-direction: column-reverse":
    it "AC-1: items stack upward from the bottom of a definite-height column":
        step("Chrome 159: a 0,66,50,24; t 0,42,50,24; b 0,14,50,24")
        expect(geom("a")).to_equal("0,66,50,24")
        expect(geom("t")).to_equal("0,42,50,24")
        expect(geom("b")).to_equal("0,14,50,24")

    it "AC-2: an auto-height column-reverse is as tall as its items, last item on top":
        step("Chrome 159: v 0,100,300,48; c at y 124; d at y 100")
        expect(geom("v")).to_equal("0,100,300,48")
        expect(geom("c")).to_equal("0,124,50,24")
        expect(geom("d")).to_equal("0,100,50,24")
