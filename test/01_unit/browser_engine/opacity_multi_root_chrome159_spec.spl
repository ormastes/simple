fn mr_mismatches(px: [u32], lane: text) -> i32:
    if px.len() < 124 * 24:
        return 9999
    var bad = 0
    var n = 0
    # cpu-lane-loop-ok: test pin scan; bound is the pin count
    while n < MR_X.len():
        val got = px[MR_Y[n] * 124 + MR_X[n]] | 0xFF000000u32
        if got != MR_CHROME[n]:
            if bad < 10:
                print "{lane} ({MR_X[n]},{MR_Y[n]}) got {got} want {MR_CHROME[n]}"
            bad = bad + 1
        n = n + 1
    if bad > 0:
        print "{lane} mismatches {bad}"
    bad

describe "several opacity roots keep their opacity (Chrome 159)":
    it "on the CPU raster":
        expect(mr_mismatches(simple_web_layout_render_html_software_pixels(MR_PAGE, 124, 24), "raster")).to_equal(0)

    it "on cpu_simd":
        expect(mr_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(MR_PAGE, 124, 24, "cpu_simd"), "cpu_simd")).to_equal(0)

    it "on Vulkan":
        expect(mr_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(MR_PAGE, 124, 24, "vulkan"), "vulkan")).to_equal(0)
