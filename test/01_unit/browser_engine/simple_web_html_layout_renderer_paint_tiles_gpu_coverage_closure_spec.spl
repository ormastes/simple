# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_tiles_gpu.spl 70%
"""
# Tile Render Culling GPU Lane — Coverage Closure (tranche 3)

Covers `simple_web_html_layout_renderer_paint_tiles_gpu.spl` (269 lines):
the flag/backend env readers, the tile grid wrapper, per-tile FNV pixel
checksums, the ordered-replay predicate, the nonempty-live counter, and one
full CPU-lane frame through `tile_lane_render_commands` on the "software"
engine2d backend (provenance honesty: no device claim on the cpu lane).
The actual Vulkan lane needs a GPU device and stays with the live specs.
"""

use std.spec
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_paint_tiles_gpu.{
    tile_gpu_flag_enabled, tile_gpu_backend_name, tile_lane_grid,
    tile_lane_pixel_checksums, _tile_lane_requires_ordered_replay,
    _tile_lane_nonempty_live_count, tile_lane_render_commands,
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_paint_tiles.{
    TILE_FNV_OFFSET_BASIS, TILE_PX, tile_count
}
use std.common.ui.draw_ir.{draw_ir_rect}
use std.gc_async_mut.io.mod_stub.{env_get}

describe "env gates":
    it "flag is only on for the literal value 1":
        val v = env_get("SIMPLE_WEB_TILE_GPU")
        if v == nil:
            expect(tile_gpu_flag_enabled()).to_equal(false)
        else:
            expect(tile_gpu_flag_enabled()).to_equal(v == "1")

    it "backend name defaults to vulkan unless overridden":
        val v = env_get("SIMPLE_2D_BACKEND")
        if v == nil or v == "":
            expect(tile_gpu_backend_name()).to_equal("vulkan")
        else:
            expect(tile_gpu_backend_name()).to_equal(v)

describe "tile_lane_grid and checksums":
    it "a doc smaller than one tile is a single tile":
        val grid = tile_lane_grid(64, 64)
        expect(tile_count(grid)).to_equal(1)

    it "a doc spanning two tile columns yields two tiles":
        val grid = tile_lane_grid(TILE_PX + 1, 10)
        expect(tile_count(grid)).to_equal(2)

    it "checksums hash pixels inside the framebuffer, off-fb tiles hash empty":
        val grid = tile_lane_grid(TILE_PX * 2, TILE_PX)
        var pixels: [u32] = [0; 16]
        # fb is only 4x4: tile 0 hashes its 4x4 intersection, tile 1 is fully
        # outside the fb and must stay at the FNV offset basis
        val sums = tile_lane_pixel_checksums(pixels, 4, 4, grid)
        expect(sums.len()).to_equal(2)
        expect(sums[1]).to_equal(TILE_FNV_OFFSET_BASIS)
        expect(sums[0] == TILE_FNV_OFFSET_BASIS).to_equal(false)

    it "checksum changes when a pixel changes":
        val grid = tile_lane_grid(4, 4)
        var a: [u32] = [0; 16]
        var b: [u32] = [0; 16]
        b[5] = 1u32
        val sa = tile_lane_pixel_checksums(a, 4, 4, grid)
        val sb = tile_lane_pixel_checksums(b, 4, 4, grid)
        expect(sa[0] == sb[0]).to_equal(false)

describe "ordered replay predicate and live counter":
    it "plain rect commands never force ordered replay":
        expect(_tile_lane_requires_ordered_replay([])).to_equal(false)
        val cmds = [draw_ir_rect("a", 0, 0, 10, 10, 0xFF102030u32)]
        expect(_tile_lane_requires_ordered_replay(cmds)).to_equal(false)

    it "counts only live tiles whose bin range is nonempty":
        val live = [true, true, false, true]
        val starts = [0, 2, 2, 5, 5]
        # tile0: 0..2 nonempty+live; tile1: 2..2 empty; tile2 not live; tile3: 5..5 empty
        expect(_tile_lane_nonempty_live_count(live, starts)).to_equal(1)
        expect(_tile_lane_nonempty_live_count([], [0])).to_equal(0)

describe "cpu-lane frame through tile_lane_render_commands":
    it "renders one frame on the software backend with honest provenance":
        val cmds = [draw_ir_rect("box", 8, 8, 16, 16, 0xFFFF0000u32)]
        val r = tile_lane_render_commands(cmds, 64, 64, 64, 64, 0, 0xFF000000u32, "software")
        expect(r.backend_requested).to_equal("software")
        expect(r.ordered_replay).to_equal(false)
        expect(r.tiles_total).to_equal(1)
        expect(r.tiles_rendered).to_equal(1)
        expect(r.tiles_skipped).to_equal(0)
        expect(r.ops_rendered > 0).to_equal(true)
        expect(r.readback_pixel_count).to_equal(4096)
        expect(r.pixels.len()).to_equal(4096)
        # cpu lane makes no device claim
        expect(r.readback_backend_handle).to_equal(0)
        expect(r.readback_device_identity).to_equal(0)
        expect(r.tile_pixel_checksums.len()).to_equal(1)
        # the painted rect changed the pixel content vs the clear color
        expect(r.pixels[9 * 64 + 9]).to_equal(0xFFFF0000u32)
