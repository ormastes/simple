"""
## Purpose and audience
Purpose: pin the device-px width of an auto-width `<button>` that has
something AFTER it, against Chrome 159. Chrome sizes every auto-width button
from its fractional label (`Go` is 33.785 CSS px, 135.14 device px at device
scale 4, painted 135 wide), whatever follows it, and what follows starts at
the exact fractional pen. A box that cannot be moved to that pen (a centred or
rtl line, a button after an inline-block) must not be left 1 px away from a
narrowed button.
Audience: maintainers of the web layout engine.

Chrome oracle (Chrome 159.0.8154.6 headless, `--hide-scrollbars
--window-size=400,300`, `--force-device-scale-factor=1` and `=4`, body
`16px/1.5 'Liberation Sans'`, default UA button). Every row is a 30 px band;
an ink run is a span of columns with a pixel darker than 160 in every channel
(the button frame #767676 counts). `BW_PAGE` rows: `Go` + text `ace`, `Go`
`Submit`, `Go` + space + `ace`, `Go` + space + `OK`, `Submit` `Go` + `ace`.
At k = 4 the BUTTON ink runs are (device px):

| row | Chrome k=4 button runs | whole-CSS-px width (base) |
|-----|------------------------|---------------------------|
| 0 | 0-134 | 0-135 |
| 1 | 0-364 | 0-365 |
| 2 | 0-134 | 0-135 |
| 3 | 0-134, 153-293 | 0-135, 152-292 |
| 4 | 0-364 | 0-363 |

`BW_GAP_PAGE` rows (k = 4): a centred `Go` `Go`, an inline-block `ab` then
`Go` `Go`, and an rtl `Go` `Go` line. Chrome paints each button pair as ONE
ink run (1, 3 and 1 runs per row in all).

Not pinned here (handed over, see
`button_follower_text_and_k1_width_chrome159_spec.spl`): text after a button
at k = 4 (Chrome 138 / 156 / 368, the text pen origin is dropped above 48
device px), and the k = 1 width of `Submit` (Chrome 57, CSS-snapped 58).
"""

"""
Traceability: REQ-WEB-FORM-CHROME-PAINT-001 -- an auto-width `<button>` followed by text or another button is sized in device px as Chrome 159 sizes it.
"""
# @tag: unit, browser_engine, layout, form_control, device_scale, chrome159
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{simple_web_layout_render_html_pixels_engine2d_at_device_scale}

val BW_W: i32 = 400
val BW_H: i32 = 160
val BW_HEAD: text = "<!doctype html><html><head><style>body{{margin:0;background:#fff;font:16px/1.5 'Liberation Sans'}}div{{height:30px}}u{{display:inline-block;text-decoration:none}}</style></head><body>"
val BW_PAGE: text = BW_HEAD + "<div><button>Go</button>ace</div><div><button>Go</button><button>Submit</button></div><div><button>Go</button> ace</div><div><button>Go</button> <button>OK</button></div><div><button>Submit</button><button>Go</button>ace</div></body></html>"
val BW_GAP_PAGE: text = BW_HEAD + "<div style=\"text-align:center\"><button>Go</button><button>Go</button></div><div><u>ab</u><button>Go</button><button>Go</button></div><div style=\"direction:rtl\"><button>Go</button><button>Go</button></div></body></html>"
# Chrome k=4 button ink runs per BW_PAGE row, as start/end pairs.
val BW_CHROME_K4: [[i32]] = [[0, 134], [0, 364], [0, 134], [0, 134, 153, 293], [0, 364]]
# Chrome k=1 ink runs (button and text) of BW_PAGE rows 0, 2 and 3.
val BW_CHROME_K1_ROWS: [i32] = [0, 2, 3]
val BW_CHROME_K1: [[i32]] = [
    [0, 0, 2, 31, 33, 33, 35, 41, 44, 49, 52, 58],
    [0, 0, 2, 31, 33, 33, 39, 46, 48, 53, 56, 62],
    [0, 0, 2, 31, 33, 33, 38, 38, 40, 71, 73, 73]
]
val BW_GAP_RUNS_K4: [i32] = [1, 3, 1]

fn bw_dark_col(px: [u32], dw: i32, x: i32, y0: i32, y1: i32) -> bool:
    var y = y0
    while y < y1:
        val p = px[y * dw + x]
        if ((p >> 16) & 255u32) < 160u32 and ((p >> 8) & 255u32) < 160u32 and (p & 255u32) < 160u32:
            return true
        y = y + 1
    false

# Ink runs of one 30 px row as start/end pairs (device px).
fn bw_runs(px: [u32], k: i32, row: i32) -> [i32]:
    val dw = BW_W * k
    var out: [i32] = []
    var prev = false
    var x = 0
    while x < dw:
        val d = bw_dark_col(px, dw, x, row * 30 * k, (row + 1) * 30 * k)
        if d and not prev:
            out.push(x)
        if not d and prev:
            out.push(x - 1)
        prev = d
        x = x + 1
    if prev:
        out.push(dw - 1)
    out

fn bw_text(v: [i32]) -> text:
    var s = ""
    for n in v:
        s = s + " {n}"
    s

# Rows whose first `want[r].len()` run bounds differ from `want[r]`.
fn bw_prefix_mismatches(page: text, k: i32, rows: [i32], want: [[i32]]) -> i32:
    val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(page, BW_W, BW_H, k, "cpu_simd")
    if px.len() != BW_W * k * BW_H * k:
        return 99
    var bad = 0
    var i = 0
    while i < rows.len():
        val got = bw_runs(px, k, rows[i])
        val exp = want[i]
        var ok = got.len() >= exp.len()
        var j = 0
        while ok and j < exp.len():
            if got[j] != exp[j]:
                ok = false
            j = j + 1
        if not ok:
            print "k={k} row {rows[i]}: runs{bw_text(got)}, Chrome starts with{bw_text(exp)}"
            bad = bad + 1
        i = i + 1
    bad

fn bw_run_count_mismatches(page: text, k: i32, want: [i32]) -> i32:
    val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(page, BW_W, BW_H, k, "cpu_simd")
    if px.len() != BW_W * k * BW_H * k:
        return 99
    var bad = 0
    var row = 0
    while row < want.len():
        val got = bw_runs(px, k, row)
        if got.len() / 2 != want[row]:
            print "k={k} row {row}: {got.len() / 2} ink runs{bw_text(got)}, Chrome {want[row]}"
            bad = bad + 1
        row = row + 1
    bad

describe "an auto-width button with something after it (Chrome 159)":
    it "AC-1: is sized in device px at device scale 4, and a button after it starts at the exact pen":
        expect(bw_prefix_mismatches(BW_PAGE, 4, [0, 1, 2, 3, 4], BW_CHROME_K4)).to_equal(0)

    it "AC-2: leaves no gap where the follower has no exact pen (centred, after an inline-block, rtl) at scale 4":
        expect(bw_run_count_mismatches(BW_GAP_PAGE, 4, BW_GAP_RUNS_K4)).to_equal(0)

    it "AC-3: keeps the device scale 1 columns of a button followed by text or a button":
        expect(bw_prefix_mismatches(BW_PAGE, 1, BW_CHROME_K1_ROWS, BW_CHROME_K1)).to_equal(0)
