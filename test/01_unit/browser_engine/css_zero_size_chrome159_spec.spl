"""
## Purpose and audience
Purpose: Pin `width:0` as a definite size. The layout read a zero width as
"auto" (or clamped it to 1px), so a zero-width box took its content, its
stretch or a 1px width. (`height:0` is still read as auto -- filed in
doc/08_tracking/bug/web_matrix_table_button_html_page_residue_2026-11-14.md.)
Audience: browser-engine block, float, flex, inline-block, abspos and table
layout maintainers.

Chrome oracle (Chrome 159.0.8154.6 headless shell, `getBoundingClientRect()`
of ZERO_PAGE at 900 px wide, every row its own absolutely placed 300px
container):
- abspos `left:10px;right:10px;width:0`: `#ab1` (10, 0) 0 wide.
- float `width:0`: `#fl1` 0 wide, the text after it at x 0.
- flex items `width:0` (with and without `flex-shrink:0`): 0 wide, the next
  item at x 0.
- `width:0;inline-size:50%`: the later `inline-size` wins, 150 wide.
- inline-block `width:0`: 0 wide, the next text at x 0.
- table cell `width:0`: as wide as its content (17.8), not 0.
"""

"""
Traceability: REQ-BROWSER-ENGINE-ZERO-SIZE-001 — width:0 is a definite size in every layout mode, as Chrome 159.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_engine.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_geometry.{simple_web_layout_debug_layout_by_id}

val ZERO_PAGE: text = "<!doctype html><html><head><style>body{{margin:0;font:16px/24px sans-serif}}.r{{position:absolute;left:0;width:300px;height:30px}}</style></head><body><div class=r style=\"top:0\"><div id=ab1 style=\"position:absolute;left:10px;right:10px;width:0;height:10px\">x</div></div><div class=r style=\"top:40px\"><div id=fl1 style=\"float:left;width:0;height:10px\">abc</div><span id=fl2>z</span></div><div class=r style=\"top:80px;display:flex\"><div id=fx1 style=\"width:0;flex-shrink:0\">abc</div><div id=fx2>z</div></div><div class=r style=\"top:120px;display:flex\"><div id=fy1 style=\"width:0\">abc</div><div id=fy2>z</div></div><div class=r style=\"top:160px\"><div id=is1 style=\"width:0;inline-size:50%;height:5px\"></div></div><div class=r style=\"top:200px;height:auto\"><div id=hz1 style=\"height:0;overflow:hidden\">abc</div><div id=hz2>z</div></div><div class=r style=\"top:240px;height:auto\"><div id=hy1 style=\"height:0\">abc</div><div id=hy2>z</div></div><div class=r style=\"top:280px\"><span id=ib1 style=\"display:inline-block;width:0\">abc</span><span id=ib2>z</span></div><table class=r style=\"top:320px;border-spacing:0;width:auto\"><tr><td id=td1 style=\"width:0;padding:0\">ab</td><td id=td2 style=\"padding:0\">c</td></tr></table></body></html>"

fn at(id: text, field: text) -> i32:
    simple_web_layout_debug_layout_by_id(ZERO_PAGE, 900, 400, id, field).to_int()

describe "width:0":
    it "AC-1: width:0 is honoured by abspos, floats, flex items and inline-blocks":
        step("Chrome 159: ab1 x 10 w 0; fl1 w 0, fl2 x 0; fx1/fy1 w 0, fx2/fy2 x 0; ib1 w 0, ib2 x 0")
        expect(at("ab1", "x")).to_equal(10)
        expect(at("ab1", "w")).to_equal(0)
        expect(at("fl1", "w")).to_equal(0)
        expect(at("fl2", "x")).to_equal(0)
        expect(at("fx1", "w")).to_equal(0)
        expect(at("fx2", "x")).to_equal(0)
        expect(at("fy1", "w")).to_equal(0)
        expect(at("fy2", "x")).to_equal(0)
        expect(at("ib1", "w")).to_equal(0)
        expect(at("ib2", "x")).to_equal(0)

    it "AC-2: a later inline-size replaces width:0":
        step("Chrome 159: is1 150 wide")
        expect(at("is1", "w")).to_equal(150)

    it "AC-3: a table cell with width:0 is still as wide as its content":
        step("Chrome 159: td1 17.8 wide")
        expect(at("td1", "w") >= 17 and at("td1", "w") <= 18).to_equal(true)
