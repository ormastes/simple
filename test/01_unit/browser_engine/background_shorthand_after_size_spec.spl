"""
## Purpose and audience
Purpose: Pin that the `background` shorthand keeps parsing after a
`<position> / <size>` group: a box keyword or `scroll` that follows the
size is the origin/clip/attachment, not a bad size (CSS Backgrounds 3
§3.10, `<bg-layer>` components in any order).
Audience: browser-engine background maintainers.

Chrome 159 resolves `url(x) no-repeat right bottom / 4px 2px content-box
padding-box scroll` to background-origin `content-box`, background-clip
`padding-box`, background-size `4px 2px` (getComputedStyle, 2026-11-16).
Before this fix the parser stayed in "after slash" mode and dropped the
whole layer. It is the root cause of the red row "lowers positioned sized
and boxed background shorthand geometry" in simple_web_renderer_spec.
"""

"""
Traceability: REQ-WEB-RENDER-001 — background shorthand components after a size group.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_declarations.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_declarations.{_parse_background_shorthand}

describe "background shorthand after a size group":
    it "AC-1: box keywords and scroll after the size":
        val s = _parse_background_shorthand("url(image://tile) no-repeat right bottom / 4px 2px content-box padding-box scroll")
        expect("{s.valid} {s.origin} {s.clip} {s.size_w} {s.size_h}").to_equal("true content-box padding-box 4 2")

    it "AC-2: a single size value then a colour":
        val s = _parse_background_shorthand("center / 8px red")
        expect("{s.valid} {s.size_w} {s.size_h}").to_equal("true 8 0")

    it "AC-3: a slash with no size still fails closed":
        expect(_parse_background_shorthand("center / red").valid).to_equal(false)

    it "AC-4: a third length after the size is not a new position group":
        expect(_parse_background_shorthand("center / 1px 2px 3px").valid).to_equal(false)
