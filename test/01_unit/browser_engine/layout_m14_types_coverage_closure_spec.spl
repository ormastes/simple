# @cover src/lib/gc_async_mut/gpu/browser_engine/layout_m14_types.spl 100%
"""
# Layout M14 Public Types — Coverage Closure (tranche 4)

Covers the M14 spec-facing layout API types (`LayoutContext`,
`InlineFragment`, `LineBox`, `LayoutBox`) and the CSS 2.2 §8.3.1 signed
margin collapse helper. The only uncovered line is the private
`_layout_box_empty` factory, which has no callers outside the module.
"""

use std.spec
use std.gc_async_mut.gpu.browser_engine.layout_m14_types.{
    LayoutContext, layout_context_new, InlineFragment, LineBox, LayoutBox,
    collapse_margins_signed,
}

describe "layout_context_new":
    it "carries the available dimensions":
        val ctx = layout_context_new(800, 600)
        expect(ctx.available_width).to_equal(800)
        expect(ctx.available_height).to_equal(600)

describe "M14 public layout types":
    it "compose fragments into line boxes into layout boxes":
        val frag = InlineFragment(x: 1, y: 2, width: 30, height: 10, baseline_offset: 8, text_run: "hi")
        val line = LineBox(x: 0, y: 0, width: 100, height: 12, baseline: 9, fragments: [frag])
        val box = LayoutBox(x: 0, y: 0, width: 100, height: 12, is_anonymous: true, line_boxes: [line], children: [])
        expect(box.line_boxes.len()).to_equal(1)
        expect(box.line_boxes[0].fragments[0].text_run).to_equal("hi")
        expect(box.is_anonymous).to_equal(true)

describe "collapse_margins_signed (CSS 2.2 §8.3.1)":
    it "two positives collapse to the max":
        expect(collapse_margins_signed(10, 20)).to_equal(20)
        expect(collapse_margins_signed(20, 10)).to_equal(20)

    it "two negatives collapse to the min":
        expect(collapse_margins_signed(-5, -15)).to_equal(-15)
        expect(collapse_margins_signed(-15, -5)).to_equal(-15)

    it "mixed signs sum max positive and min negative":
        expect(collapse_margins_signed(10, -4)).to_equal(6)
        expect(collapse_margins_signed(-4, 10)).to_equal(6)

    it "zeros are neutral":
        expect(collapse_margins_signed(0, 0)).to_equal(0)
        expect(collapse_margins_signed(0, 7)).to_equal(7)
        expect(collapse_margins_signed(-7, 0)).to_equal(-7)
