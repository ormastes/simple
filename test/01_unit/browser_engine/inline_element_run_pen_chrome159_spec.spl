"""
## Purpose and audience
Purpose: pin a long line of alternating bare text runs and inline elements
against Chrome 159. The inline loop advances by whole pixels and keeps the
exact-minus-integer error on the side; a bare `#text` run was painted from
that error (its pen origin), a run INSIDE an inline element (`<b>o</b>`) was
not, and the error was never folded back into the cursor. After a few runs
the elements sat 2-5 px left of Chrome's, and a bare run whose error passed
3 px lost its origin too (`n <b>o</b> n <i>o</i> ...`: 9th run at 107, Chrome
110).
Audience: browser-engine inline layout maintainers.

Chrome oracle (Chrome 159.0.8154.6 headless, `--hide-scrollbars
--force-device-scale-factor=1 --window-size=400,300`, host default
sans-serif 16px; band 3 at 13.3333px). Four 400 px blocks, line-height 20 px,
one line each. `EP_CHROME` holds each band's ink-run start columns read from
the Chrome screenshot (ink = every channel < 160); every run is one letter
(the last one a letter and a full stop), none of which kerns with a space.
"""

"""
Traceability: REQ-BROWSER-ENGINE-INLINE-ELEMENT-RUN-PEN-001 -- text inside an inline element and the boxes after it land where Chrome 159 puts them on a line of many runs.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_engine.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{simple_web_render_html_to_pixels_with_resolved_engine2d_backend}

val EP_W: i32 = 400
val EP_H: i32 = 300
val EP_PAGE: text = "<!DOCTYPE html><html><body style=\"margin:0;background:#fff;color:#000;font:16px sans-serif\"><div style=\"width:400px;line-height:20px\">n <b>o</b> n <i>o</i> n <b>o</b> n <i>o</i> n <b>o</b> n <i>o</i> n <b>o</b> n.</div><div style=\"width:400px;line-height:20px\">x <b>F</b> x <b>F</b> x <b>F</b> x <b>F</b> x <b>F</b> x <b>F</b> x <b>F</b> x <b>F</b> x.</div><div style=\"width:400px;line-height:20px\">n <span>o</span> n <span>o</span> n <span>o</span> n <span>o</span> n <span>o</span> n <span>o</span> n <span>o</span> n <span>o</span> n.</div><div style=\"width:400px;line-height:20px;font-size:13.3333px\">n <b>o</b> n <i>o</i> n <b>o</b> n <i>o</i> n <b>o</b> n <i>o</i> n <b>o</b> n.</div></body></html>"
val EP_CHROME: [[i32]] = [
    [1, 14, 29, 42, 56, 69, 83, 96, 110, 123, 138, 150, 164, 177, 192, 201],
    [1, 14, 27, 41, 54, 67, 81, 94, 107, 121, 134, 147, 161, 174, 187, 201, 214, 223],
    [1, 14, 28, 41, 55, 68, 81, 94, 108, 121, 135, 148, 162, 174, 188, 201, 215, 224],
    [1, 12, 24, 35, 46, 57, 69, 80, 92, 102, 115, 125, 137, 147, 160, 167]
]

fn ep_dark_col(px: [u32], x: i32, y0: i32) -> bool:
    var y = y0
    while y < y0 + 20:
        val p = px[y * EP_W + x]
        if ((p >> 16) & 255u32) < 160u32 and ((p >> 8) & 255u32) < 160u32 and (p & 255u32) < 160u32:
            return true
        y = y + 1
    false

fn ep_mismatches(px: [u32]) -> i32:
    if px.len() != EP_W * EP_H:
        return 99
    var bad = 0
    var band = 0
    while band < EP_CHROME.len():
        val want = EP_CHROME[band]
        var starts: [i32] = []
        var x = 0
        while x < EP_W:
            if ep_dark_col(px, x, band * 20) and (x == 0 or not ep_dark_col(px, x - 1, band * 20)):
                starts.push(x)
            x = x + 1
        if starts.len() != want.len():
            print "band {band}: {starts.len()} ink runs, Chrome {want.len()}"
            bad = bad + 1
        else:
            var k = 0
            while k < want.len():
                val d = starts[k] - want[k]
                if d > 1 or d < -1:
                    print "band {band} run {k}: {starts[k]}, Chrome {want[k]}"
                    bad = bad + 1
                k = k + 1
        band = band + 1
    bad

describe "a long line of text runs and inline elements lands like Chrome 159":
    it "AC-1: runs inside b / i / span and the runs after them keep the exact pen (cpu_simd)":
        step("16 to 18 one-letter runs per line, at 16px and 13.3333px")
        expect(ep_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(EP_PAGE, EP_W, EP_H, "cpu_simd"))).to_equal(0)
