"""
## Purpose and audience
Purpose: Pin that a password `<input>` masks its value with U+2022 BULLET,
one per codepoint, as Chrome 159 does, and that the bullet paints the same
on the software raster, the Engine2D path and a real Vulkan device.
Audience: browser-engine form-control paint and Engine2D glyph maintainers.

Chrome oracle (Chrome 159, `--headless --dump-dom` + `--screenshot`,
300x200, 2026-11-16). Each input is
`display:block;box-sizing:border-box;width:60px;height:16px;padding:2px;
border:1px solid #fff;color:#22c55e;font:8px Arial`:

| probe                                   | Chrome 159                         |
|-----------------------------------------|------------------------------------|
| computed `-webkit-text-security`        | `disc` (U+2022 BULLET)             |
| `measureText` 8px Arial `•` / `*`       | 2.80 / 3.11                        |
| `#pw` value `ABC`, ink rows (box y 0)   | 8..9 (vertical middle of the box)  |
| `#pw` value `ABC`, ink columns          | 3..10 (three discs)                |
| `*` typed as a value, ink rows          | 6..7 (top-heavy asterisk)          |

The engine used `*`. The shared 5x7 table had no U+2022 cell, so the
glyph was added (index 88) and the Engine2D atlas unknown slot moved to 89.
Open, filed in the bug record: the engine advances the bullet 5px (Chrome
2.8px), so its three discs ink columns 4..16, not 3..10.

Filed in doc/08_tracking/bug/web_layout_cascade_selector_paint_chrome159_round4_divergences_2026-11-15.md
(`password_mask_glyph`).
"""

"""
Traceability: REQ-WEB-RENDER-001 — password inputs mask with U+2022.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_raster.spl 1%
use std.spec.*
use std.io_runtime.{file_exists}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir,
    simple_web_layout_render_html_software_pixels
}
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{
    simple_web_render_html_to_pixels,
    simple_web_render_html_to_readback_with_engine2d_backend,
    simple_web_resolved_engine2d_backend_name
}

val PAGE: text = "<html><head><style>html,body{{margin:0;padding:0;background:#fff}}" +
    " input{{display:block;box-sizing:border-box;width:60px;height:16px;padding:2px;" +
    "border:1px solid #fff;color:#22c55e;background:#fff;font-family:Arial;font-size:8px;outline:none}}" +
    "</style></head><body><input id=pw type=password value=ABC>" +
    "<input id=u type=password value='é'></body></html>"

fn _value_text(id: text) -> text:
    val composition = simple_web_layout_render_html_draw_ir(PAGE, 64, 32)
    for c in composition.batches[0].commands:
        if c.component_id == id + "_value":
            return c.text_value
    "missing " + id + "_value"

# Green (text colour) ink rows of the 16px input row starting at y0, encoded
# as "first..last/count"; "none" when nothing is inked.
fn _ink_rows(pixels: [u32], width: i32, y0: i32) -> text:
    var first = -1
    var last = -1
    var count = 0
    var y = y0
    while y < y0 + 16:
        var x = 0
        var hit = false
        while x < width:
            val p = pixels[y * width + x]
            val r = ((p >> 16) & 0xFFu32).to_i64()
            val g = ((p >> 8) & 0xFFu32).to_i64()
            if g > r + 40:
                hit = true
            x = x + 1
        if hit:
            if first < 0:
                first = y - y0
            last = y - y0
            count = count + 1
        y = y + 1
    if first < 0:
        return "none"
    first.to_text() + ".." + last.to_text() + "/" + count.to_text()

# Chrome inks the discs in box rows 8..9. A disc is a small mark in the
# vertical middle: at most 3 inked rows, all within Chrome's band +-2
# (6..11). The engine's old `*` (and the unknown-glyph box) inks more rows
# and reaches above row 6.
fn _disc_rows_ok(rows: text) -> bool:
    if rows == "none":
        return false
    val parts = rows.split("/")
    val span = parts[0].split("..")
    val first = span[0].to_i64()
    val last = span[1].to_i64()
    val count = parts[1].to_i64()
    first >= 6 and last <= 11 and count <= 3

describe "password input masks with U+2022 (Chrome 159)":
    it "AC-1: Draw IR masks each character of the value with a bullet":
        step("Chrome 159: -webkit-text-security: disc, three discs for ABC")
        expect(_value_text("pw")).to_equal("•••")

    it "AC-2: a multi-byte character is one bullet, not one per byte":
        step("Chrome 159: value.length 1 for 'é', one disc")
        expect(_value_text("u")).to_equal("•")

    it "AC-3: the software raster inks the discs in the vertical middle of the box":
        step("Chrome 159: disc ink rows 8..9 of the 16px box")
        val pixels = simple_web_layout_render_html_software_pixels(PAGE, 64, 32)
        val rows = _ink_rows(pixels, 64, 0)
        expect(rows).to_equal("6..8/3")
        expect(_disc_rows_ok(rows)).to_equal(true)
        expect(_disc_rows_ok(_ink_rows(pixels, 64, 16))).to_equal(true)

    it "AC-4: the Engine2D path paints the same discs":
        step("Chrome 159: disc ink rows 8..9 of the 16px box")
        val pixels = simple_web_render_html_to_pixels(PAGE, 64, 32)
        expect(_disc_rows_ok(_ink_rows(pixels, 64, 0))).to_equal(true)
        expect(pixels).to_equal(simple_web_layout_render_html_software_pixels(PAGE, 64, 32))

describe "password input mask on a real Vulkan device":
    it "AC-5: a Vulkan device readback paints the same discs as the software raster":
        # Runs where a Vulkan ICD is installed (llvmpipe:
        # VK_DRIVER_FILES=/usr/share/vulkan/icd.d/lvp_icd.json). Where none
        # is, the row has nothing to drive and says so: it is NOT exercised.
        if not file_exists("/usr/share/vulkan/icd.d/lvp_icd.json"):
            print("[skip] AC-5: no llvmpipe ICD; this Vulkan row was not exercised")
            return
        step("the request really resolved to Vulkan (no silent software fallback)")
        expect(simple_web_resolved_engine2d_backend_name(64, 32, "vulkan")).to_equal("vulkan")
        val rb = simple_web_render_html_to_readback_with_engine2d_backend(PAGE, 64, 32, "vulkan")
        expect(rb.source).to_equal("device_readback")
        step("Chrome 159: disc ink rows 8..9; device pixels equal the software raster")
        expect(_disc_rows_ok(_ink_rows(rb.pixels, 64, 0))).to_equal(true)
        expect(_disc_rows_ok(_ink_rows(rb.pixels, 64, 16))).to_equal(true)
        expect(rb.pixels).to_equal(simple_web_layout_render_html_software_pixels(PAGE, 64, 32))
