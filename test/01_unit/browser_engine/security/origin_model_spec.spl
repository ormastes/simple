# @cover src/lib/gc_async_mut/gpu/browser_engine/security/origin_policy.spl 85%
# @cover src/lib/gc_async_mut/gpu/browser_engine/security/cookie_policy.spl 85%
# @cover src/lib/gc_async_mut/gpu/browser_engine/security/permission_policy.spl 85%
"""
## Purpose and audience
Executable specification for the browser security model in
src/lib/gc_async_mut/gpu/browser_engine/security/: fail-closed origin
derivation, strict tuple origin equality, opaque-origin isolation,
document/storage/network same-origin decisions, cookie admission and
delivery, and default-deny per-origin permissions. This is a security
model, so the adversarial cases are the specification — every block
states a breach an attacker would attempt and asserts the model
refuses it, with absolute oracles (exact booleans and exact serialized
text, never "is not empty"). Audience: maintainers of the browser
security policies and anyone wiring a new surface (fetch, storage,
permissions UI) onto them.

## Operator workflow
Run the spec from the repo root with the seed runner:
./src/compiler_rust/target/bootstrap/simple run test/01_unit/browser_engine/security/origin_model_spec.spl
Read the trailing SPEC FILE VERDICT line; every scenario prints its
retained statistics/bit_table capture as an evidence comment that
spipe-docgen folds into the mirrored manual under doc/06_spec. The
final block is a calibration: it re-implements classic breaches as
local shadow functions and proves the test vectors used above actually
discriminate a correct implementation from a broken one.

## Compatibility and limitations
Origin derivation never trusts the engine's `Url.parse` for security
decisions: `data:`, `about:`, `javascript:` and `blob:` URLs, malformed
strings, non-numeric or out-of-range ports, trailing-dot hosts and
embedded spaces all yield a fresh opaque origin instead of the shared
`("http", "", ...)` collapse. Cookies are refused unless every
attribute rule holds (public-suffix domains, host coverage, SameSite
vs Secure, `__Host-`/`__Secure-` prefixes, expiry); admission is not
delivery — `Secure`, expiry and `SameSite` are re-checked per request.
Permissions are a single (origin, feature) grant table where absent,
unknown, revoked and opaque all read Denied.

## Verification guidance and troubleshooting
A same-origin failure almost always names its tuple field: compare the
stamped serialization against the scenario's URL before touching the
policy. A cookie admission failure carries an exact reason string
("domain-is-public-suffix", "host-prefix-forbids-domain", ...) — the
reason text is the oracle, so a changed reason is a breaking contract
change, not a formatting nit. If the calibration block ever goes red
together with its paired scenario above, a refactor reintroduced a
classic breach; fix the policy, never the calibration vector.
"""

# Lifecycle: doc/01_research/infra/security/security_convention_first_architecture.md ;
# doc/03_plan/ui/web_browser/simple_browser_chrome_class_roadmap.md ;
# doc/04_architecture/ui/simple_browser_chromium_html_parity.md ;
# doc/05_design/simple_web_browser_engine_production_hardening.md

use std.spipe.*

use std.gc_async_mut.gpu.browser_engine.net.entity.url_types.{Origin}
use std.gc_async_mut.gpu.browser_engine.net.entity.cookie_types.{Cookie, SameSite}
use std.gc_async_mut.gpu.browser_engine.security.origin_policy.{
    OpaqueOriginSource,
    opaque_origin,
    is_opaque,
    is_tuple_origin,
    origin_from_url_text,
    same_origin,
    same_site,
    serialize_origin,
    is_potentially_trustworthy,
    can_access_document,
    can_use_storage,
    storage_key,
    same_storage_partition,
    can_read_response,
    default_port_for
}
use std.gc_async_mut.gpu.browser_engine.security.cookie_policy.{
    CookieVerdict,
    validate_set_cookie,
    cookie_applies,
    script_visible,
    domain_matches,
    path_matches,
    canonical_domain,
    effective_domain,
    is_expired,
    apply_max_age
}
use std.gc_async_mut.gpu.browser_engine.security.permission_policy.{
    PermissionSet,
    PermissionState,
    state_is_granted,
    permission_key,
    is_known_feature
}

fn origin_of(url: text) -> Origin:
    return origin_from_url_text(url, "nonce-for-" + url)

fn make_cookie(
    name: text,
    domain: text,
    path: text,
    secure: bool,
    http_only: bool,
    same_site: SameSite,
    expires_at: i64
) -> Cookie:
    return Cookie {
        name: name,
        value: "v",
        domain: domain,
        path: path,
        secure: secure,
        http_only: http_only,
        same_site: same_site,
        expires_at: expires_at
    }

fn plain_cookie(name: text, domain: text) -> Cookie:
    return make_cookie(name, domain, "/", false, false, SameSite.Lax, 0)

# Fixture origins are functions, not describe-level `val`s: a describe-scoped
# binding is not reliably visible inside every `it` body on this runner.
fn shop_https() -> Origin:
    return origin_of("https://shop.example.com/cart")

fn shop_http() -> Origin:
    return origin_of("http://shop.example.com/cart")

fn site_a() -> Origin:
    return origin_of("https://a.test/")

fn site_b() -> Origin:
    return origin_of("https://b.test/")

fn attacker_origin() -> Origin:
    return origin_of("https://attacker.example.net/")


# ============================================================================
# Origin derivation — fail closed
# ============================================================================

# @manual_section: origin-derivation

describe "origin derivation is fail-closed":
    """
    ## Nothing that cannot be fully validated becomes a trusted origin

    The engine's `Url.parse` maps `data:`, `about:` and `javascript:` URLs onto
    `scheme = "http"` and maps every unparseable string onto one shared
    `("http", "", ...)` origin. Deriving security origins that way makes every
    broken URL mutually same-origin. This model derives origins itself and
    yields a fresh opaque origin for anything it cannot validate.
    """

    context "when the URL is a normal hierarchical URL":
        it "derives the exact scheme, host and default port":
            # @req REQ-ORIGIN-DERIVE-001
            step("Derive the origin of a plain http URL")
            val origin = origin_of("http://example.com/index.html")
            # @capture(statistics): the derived scheme, host and default port
            expect(origin.scheme).to_equal("http")
            expect(origin.host).to_equal("example.com")
            expect(origin.port).to_equal(80)  # oracle: http's default port is 80

        it "lowercases scheme and host but not the path":
            # @req REQ-ORIGIN-DERIVE-002
            step("Derive the origin of a mixed-case URL and serialize it")
            val origin = origin_of("HTTP://ExAmPle.COM/A")
            # @capture(bit_table): the canonical serialized origin
            expect(serialize_origin(origin)).to_equal("http://example.com")

        it "honours an explicit non-default port":
            # @req REQ-ORIGIN-DERIVE-003
            step("Derive the origin of a URL with port 8443")
            val origin = origin_of("https://example.com:8443/")
            # @capture(statistics): the explicit port and serialized origin
            expect(origin.port).to_equal(8443)  # oracle: the URL's explicit port passes through unchanged
            expect(serialize_origin(origin)).to_equal("https://example.com:8443")

        it "takes the host after the LAST userinfo separator":
            # @req REQ-ORIGIN-DERIVE-004
            step("Resolve the double-userinfo URL and check the last separator wins")
            val origin = origin_of("http://user:pass@evil.com@example.com/")
            # @capture(statistics): the host taken after the last @ separator
            expect(origin.host).to_equal("example.com")

    context "when the URL carries no tuple origin":
        it "gives a data: URL an opaque origin, never an http one":
            # @req REQ-ORIGIN-DERIVE-005
            step("Derive the origin of a data: URL and serialize it")
            val origin = origin_of("data:text/html,<b>x</b>")
            # @capture(bit_table): the opaque flag and the "null" serialization
            assert_true(is_opaque(origin))
            expect(serialize_origin(origin)).to_equal("null")

        it "gives about:blank an opaque origin":
            # @req REQ-ORIGIN-DERIVE-006
            step("Derive the origin of an about: URL")
            # @capture(statistics): the opaque flag for about:blank
            assert_true(is_opaque(origin_of("about:blank")))

        it "gives javascript: an opaque origin":
            # @req REQ-ORIGIN-DERIVE-007
            step("Derive the origin of a javascript: URL")
            # @capture(statistics): the opaque flag for javascript:
            assert_true(is_opaque(origin_of("javascript:alert(1)")))

        it "gives blob: an opaque origin":
            # @req REQ-ORIGIN-DERIVE-008
            step("Derive the origin of a blob: URL")
            # @capture(statistics): the opaque flag for blob:
            assert_true(is_opaque(origin_of("blob:https://example.com/uuid")))

    context "when the URL is malformed":
        it "rejects the empty string":
            # @req REQ-ORIGIN-DERIVE-009
            step("Derive the origin of the empty string")
            # @capture(statistics): the opaque flag for the empty URL
            assert_true(is_opaque(origin_of("")))

        it "rejects free text":
            # @req REQ-ORIGIN-DERIVE-010
            step("Derive the origin of a free-text non-URL")
            # @capture(statistics): the opaque flag for free text
            assert_true(is_opaque(origin_of("not a url")))

        it "rejects a non-numeric port":
            # @req REQ-ORIGIN-DERIVE-011
            step("Derive the origin of a URL whose port has a letter in it")
            # @capture(statistics): the opaque flag for port 80x
            assert_true(is_opaque(origin_of("http://example.com:80x/")))

        it "rejects an out-of-range port":
            # @req REQ-ORIGIN-DERIVE-012
            step("Derive the origin of a URL with port 65536")
            # @capture(statistics): the opaque flag for port 65536
            assert_true(is_opaque(origin_of("http://example.com:65536/")))

        it "rejects a trailing-dot host, the public-suffix bypass form":
            # @req REQ-ORIGIN-DERIVE-013
            step("Derive the origin of a trailing-dot host")
            # @capture(statistics): the opaque flag for the trailing-dot host
            assert_true(is_opaque(origin_of("http://example.com./")))

        it "rejects a host with an embedded space":
            # @req REQ-ORIGIN-DERIVE-014
            step("Derive the origin of a host containing a space")
            # @capture(statistics): the opaque flag for the spaced host
            assert_true(is_opaque(origin_of("http://exa mple.com/")))

        it "reports a derived tuple origin as a tuple origin":
            # @req REQ-ORIGIN-DERIVE-015
            step("Classify one derived tuple origin and one opaque origin")
            # @capture(statistics): the tuple-origin classification pair
            assert_true(is_tuple_origin(origin_of("https://example.com/")))
            assert_false(is_tuple_origin(origin_of("data:,x")))


# ============================================================================
# Origin equality
# ============================================================================

# @manual_section: origin-equality

describe "same-origin equality is a strict tuple comparison":
    """
    ## Scheme, host and port each make origins distinct

    `http://x:80` and `https://x:443` are the canonical pair that a naive
    host-only comparison confuses; so are two ports on one host.
    """

    context "when comparing equal origins":
        it "treats a URL and its default-port spelling as one origin":
            # @req REQ-ORIGIN-EQ-001
            step("Compare a URL against its explicit default-port spelling")
            # @capture(statistics): the same-origin verdict for default-port spellings
            assert_true(same_origin(origin_of("http://x.test/"), origin_of("http://x.test:80/a")))

    context "when the scheme differs":
        it "denies http://x:80 vs https://x:443":
            # @req REQ-ORIGIN-EQ-002
            step("Compare the http and https spellings of one host")
            val insecure = origin_of("http://x.test:80/")
            val secure = origin_of("https://x.test:443/")
            # @capture(statistics): the same-origin verdict across schemes
            assert_false(same_origin(insecure, secure))

        it "denies ws vs http on the same host and port":
            # @req REQ-ORIGIN-EQ-003
            step("Compare a ws origin against an http origin on the same tuple port")
            # @capture(statistics): the same-origin verdict across ws and http
            assert_false(same_origin(origin_of("ws://x.test:80/"), origin_of("http://x.test:80/")))

    context "when the port differs":
        it "denies two ports on one host and scheme":
            # @req REQ-ORIGIN-EQ-004
            step("Compare ports 8080 and 8081 on one host")
            # @capture(statistics): the same-origin verdict across ports
            assert_false(same_origin(origin_of("http://x.test:8080/"), origin_of("http://x.test:8081/")))

    context "when the host differs":
        it "denies a subdomain against its parent":
            # @req REQ-ORIGIN-EQ-005
            step("Compare a subdomain origin against its parent origin")
            # @capture(statistics): the same-origin verdict across host levels
            assert_false(same_origin(origin_of("https://a.x.test/"), origin_of("https://x.test/")))

        it "denies a suffix-confusable host":
            # @req REQ-ORIGIN-EQ-006
            step("Compare notexample.com against example.com")
            # @capture(statistics): the same-origin verdict for the suffix-confusable pair
            assert_false(same_origin(origin_of("https://notexample.com/"), origin_of("https://example.com/")))

    context "when an origin is malformed":
        it "denies a malformed origin against an identical malformed origin":
            # @req REQ-ORIGIN-EQ-007
            step("Compare the Url.parse collapse origin with itself")
            val broken = Origin(scheme: "http", host: "", port: 80)
            # @capture(statistics): the reflexive verdict for a malformed origin
            assert_false(same_origin(broken, broken))

        it "serializes a malformed origin as null":
            # @req REQ-ORIGIN-EQ-008
            step("Serialize the empty-host origin")
            # @capture(bit_table): the "null" serialization of a malformed origin
            expect(serialize_origin(Origin(scheme: "http", host: "", port: 80))).to_equal("null")

        it "denies an origin whose port was never populated":
            # @req REQ-ORIGIN-EQ-009
            step("Compare a port-0 origin with itself")
            val no_port = Origin(scheme: "https", host: "example.com", port: 0)
            # @capture(statistics): the reflexive verdict for an unpopulated port
            assert_false(same_origin(no_port, no_port))


# @manual_section: same-site

describe "same-site equality uses scheme and registrable domain":
    it "allows sibling hosts only on the same schemeful site":
        # @req REQ-ORIGIN-SITESITE-001
        step("Compare sibling hosts on both the same and a different scheme")
        # @capture(statistics): the same-site verdicts for sibling hosts
        assert_true(same_site(origin_of("https://shop.example.com/"), origin_of("https://account.example.com/")))
        assert_false(same_site(origin_of("http://shop.example.com/"), origin_of("https://account.example.com/")))

    it "respects public suffix boundaries":
        # @req REQ-ORIGIN-SITESITE-002
        step("Compare two hosts that share only a public suffix")
        # @capture(statistics): the same-site verdict across the public-suffix boundary
        assert_false(same_site(origin_of("https://alice.github.io/"), origin_of("https://bob.github.io/")))

    it "compares IP literals by exact host and denies opaque origins":
        # @req REQ-ORIGIN-SITESITE-003
        step("Compare IPv4, IPv6, localhost and malformed hosts")
        # @capture(statistics): the same-site verdicts across IP-literal shapes
        assert_true(same_site(origin_of("https://127.0.0.1/"), origin_of("https://127.0.0.1:8443/")))
        assert_false(same_site(origin_of("https://127.0.0.1/"), origin_of("https://127.0.0.2/")))
        assert_true(same_site(origin_of("http://localhost/"), origin_of("http://localhost:8080/")))
        assert_false(same_site(origin_of("https://999.999.999.999/"), origin_of("https://999.999.999.999/")))
        assert_false(same_site(origin_of("https://[:::]/"), origin_of("https://[:::]/")))
        assert_false(same_site(origin_of("https://[1:2:3:4:5:6:7:8:]/"), origin_of("https://[1:2:3:4:5:6:7:8:]/")))
        assert_true(same_site(origin_of("https://[::ffff:192.0.2.1]/"), origin_of("https://[::ffff:192.0.2.1]:8443/")))
        assert_false(same_site(origin_of("https://-bad/"), origin_of("https://-bad/")))
        assert_false(same_site(origin_of("https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/"), origin_of("https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/")))
        assert_false(same_site(opaque_origin("a"), opaque_origin("a")))
        assert_false(same_site(Origin(scheme: "https", host: "", port: 443), shop_https()))


# ============================================================================
# Opaque origins
# ============================================================================

# @manual_section: opaque-origins

describe "opaque origins trust nothing":
    """
    ## An opaque origin is same-origin only with itself, and holds nothing

    Two sandboxed documents loaded from the same `data:` URL get two distinct
    opaque origins and must not reach each other. Opaque origins get no storage
    partition and can never hold a permission grant.
    """

    context "when two opaque origins are derived separately":
        it "denies same-origin between two derivations of one data: URL":
            # @req REQ-ORIGIN-OPAQUE-001
            step("Derive the same data: URL under two different sandbox nonces")
            val first = origin_from_url_text("data:text/html,x", "sandbox-a")
            val second = origin_from_url_text("data:text/html,x", "sandbox-b")
            # @capture(statistics): the same-origin verdict across sandbox nonces
            assert_false(same_origin(first, second))

        it "denies document access between them":
            # @req REQ-ORIGIN-OPAQUE-002
            step("Cross two sandbox nonces through can_access_document")
            val first = origin_from_url_text("data:text/html,x", "sandbox-a")
            val second = origin_from_url_text("data:text/html,x", "sandbox-b")
            # @capture(statistics): the document-access verdict across sandboxes
            assert_false(can_access_document(first, second))

    context "when the same opaque origin is compared with itself":
        it "allows a document to reach its own opaque origin":
            # @req REQ-ORIGIN-OPAQUE-003
            step("Compare one opaque origin with itself")
            val self_origin = opaque_origin("sandbox-a")
            # @capture(statistics): the reflexive verdict for an identified opaque origin
            assert_true(same_origin(self_origin, self_origin))

    context "when an opaque origin has no identity at all":
        it "denies same-origin for a nonce-less opaque origin":
            # @req REQ-ORIGIN-OPAQUE-004
            step("Compare an anonymous opaque origin with itself")
            val anonymous = opaque_origin("")
            # @capture(statistics): the reflexive verdict for an unidentified opaque origin
            assert_false(same_origin(anonymous, anonymous))

    context "when an allocator hands out opaque origins":
        it "gives every allocation a distinct identity":
            # @req REQ-ORIGIN-OPAQUE-005
            step("Allocate two opaque origins from one source")
            var source = OpaqueOriginSource.create("frame")
            val first = source.next()
            val second = source.next()
            # @capture(statistics): the opacity flag and pairwise verdict for allocations
            assert_true(is_opaque(first))
            assert_false(same_origin(first, second))

    context "when an opaque origin asks for capabilities":
        it "refuses storage":
            # @req REQ-ORIGIN-OPAQUE-006
            step("Ask an opaque origin for storage access")
            # @capture(statistics): the storage verdict for an opaque origin
            assert_false(can_use_storage(opaque_origin("s")))

        it "returns an empty storage key":
            # @req REQ-ORIGIN-OPAQUE-007
            step("Ask an opaque origin for its storage key")
            # @capture(bit_table): the empty storage key
            expect(storage_key(opaque_origin("s"))).to_equal("")

        it "refuses to share a storage partition even with itself":
            # @req REQ-ORIGIN-OPAQUE-008
            step("Compare two opaque origins' storage partitions")
            # @capture(statistics): the partition verdict for opaque origins
            assert_false(same_storage_partition(opaque_origin("s"), opaque_origin("s")))

        it "is never potentially trustworthy":
            # @req REQ-ORIGIN-OPAQUE-009
            step("Ask whether an opaque origin is potentially trustworthy")
            # @capture(statistics): the trustworthiness verdict for an opaque origin
            assert_false(is_potentially_trustworthy(opaque_origin("s")))


# ============================================================================
# Same-origin policy decision points
# ============================================================================

# @manual_section: sop-decisions

describe "same-origin policy decision points":
    """
    ## Document access, storage partitioning and network reads

    Each decision is deny-wins and takes the origin tuple, never a hostname.
    """

    context "when a document reaches for another document":
        it "denies cross-origin document access":
            # @req REQ-ORIGIN-SOP-001
            step("Cross two distinct hosts through can_access_document")
            # @capture(statistics): the document-access verdict across hosts
            assert_false(can_access_document(origin_of("https://a.test/"), origin_of("https://b.test/")))

        it "denies access across a scheme change on one host":
            # @req REQ-ORIGIN-SOP-002
            step("Cross the http and https spellings of one host through can_access_document")
            # @capture(statistics): the document-access verdict across schemes
            assert_false(can_access_document(origin_of("http://a.test/"), origin_of("https://a.test/")))

        it "allows same-origin document access":
            # @req REQ-ORIGIN-SOP-003
            step("Compare two paths on one origin through can_access_document")
            # @capture(statistics): the document-access verdict within one origin
            assert_true(can_access_document(origin_of("https://a.test/p"), origin_of("https://a.test/q")))

    context "when storage is partitioned":
        it "uses the serialized origin as the partition key":
            # @req REQ-ORIGIN-SOP-004
            step("Ask for the storage key of a port-qualified origin")
            # @capture(bit_table): the storage key equal to the serialized origin
            expect(storage_key(origin_of("https://a.test:8443/x"))).to_equal("https://a.test:8443")

        it "puts http and https on one host in different partitions":
            # @req REQ-ORIGIN-SOP-005
            step("Compare storage partitions across a scheme change")
            # @capture(statistics): the partition verdict across schemes
            assert_false(same_storage_partition(origin_of("http://a.test/"), origin_of("https://a.test/")))

        it "puts two ports in different partitions":
            # @req REQ-ORIGIN-SOP-006
            step("Compare storage partitions across ports 1 and 2")
            # @capture(statistics): the partition verdict across ports
            assert_false(same_storage_partition(origin_of("https://a.test:1/"), origin_of("https://a.test:2/")))

        it "shares a partition for the same origin":
            # @req REQ-ORIGIN-SOP-007
            step("Compare storage partitions of two paths on one origin")
            # @capture(statistics): the partition verdict within one origin
            assert_true(same_storage_partition(origin_of("https://a.test/x"), origin_of("https://a.test/y")))

    context "when a response body is read":
        it "allows a same-origin read with no CORS header":
            # @req REQ-ORIGIN-SOP-008
            step("Read a response from the requester's own origin")
            # @capture(statistics): the read verdict for a same-origin response
            assert_true(can_read_response(origin_of("https://a.test/"), origin_of("https://a.test/"), "", false))

        it "denies a cross-origin read with no CORS header":
            # @req REQ-ORIGIN-SOP-009
            step("Read a cross-origin response with an empty allow-origin header")
            # @capture(statistics): the read verdict with no CORS header
            assert_false(can_read_response(origin_of("https://a.test/"), origin_of("https://b.test/"), "", false))

        it "allows a cross-origin read on an exact allow-origin echo":
            # @req REQ-ORIGIN-SOP-010
            step("Read a cross-origin response whose allow-origin echoes the requester exactly")
            # @capture(statistics): the read verdict for an exact CORS echo
            assert_true(can_read_response(origin_of("https://a.test/"), origin_of("https://b.test/"), "https://a.test", false))

        it "denies a near-miss allow-origin echo":
            # @req REQ-ORIGIN-SOP-011
            step("Offer allow-origin https://a.test.evil to requester https://a.test")
            # @capture(statistics): the read verdict for the suffix-confusable echo
            assert_false(can_read_response(origin_of("https://a.test/"), origin_of("https://b.test/"), "https://a.test.evil", false))

        it "allows a wildcard read without credentials":
            # @req REQ-ORIGIN-SOP-012
            step("Read a cross-origin response with allow-origin * and no credentials")
            # @capture(statistics): the read verdict for wildcard CORS
            assert_true(can_read_response(origin_of("https://a.test/"), origin_of("https://b.test/"), "*", false))

        it "denies a wildcard read WITH credentials":
            # @req REQ-ORIGIN-SOP-013
            step("Read a cross-origin response with allow-origin * and credentials mode on")
            # @capture(statistics): the read verdict for wildcard CORS with credentials
            assert_false(can_read_response(origin_of("https://a.test/"), origin_of("https://b.test/"), "*", true))

        it "denies the allow-origin: null grant":
            # @req REQ-ORIGIN-SOP-014
            step("Offer the literal string null as allow-origin")
            # @capture(statistics): the read verdict for the null CORS grant
            assert_false(can_read_response(origin_of("https://a.test/"), origin_of("https://b.test/"), "null", false))

        it "denies a cross-origin read for an opaque requester":
            # @req REQ-ORIGIN-SOP-015
            step("Read a cross-origin response from an opaque origin")
            # @capture(statistics): the read verdict for an opaque requester
            assert_false(can_read_response(opaque_origin("s"), origin_of("https://b.test/"), "*", false))


# ============================================================================
# Cookie admission
# ============================================================================

# @manual_section: cookie-admission

describe "cookie admission enforces the attribute rules":
    """
    ## Set-Cookie is refused unless every attribute rule holds

    The public-suffix rule is the load-bearing one: without it a page on
    `evil.com` can set a cookie for `com` and have it returned to every `.com`
    site in the browser.
    """


    context "when the Domain attribute is a public suffix":
        it "rejects Domain=com":
            # @req REQ-ORIGIN-CKADM-001
            step("Set a cookie whose domain is the public suffix com")
            val verdict = validate_set_cookie(plain_cookie("sid", "com"), shop_https(), 1000)
            # @capture(bit_table): the refused verdict and its exact reason string
            assert_false(verdict.accepted)
            expect(verdict.reason).to_equal("domain-is-public-suffix")

        it "rejects Domain=co.uk":
            # @req REQ-ORIGIN-CKADM-002
            step("Set a cookie whose domain is the public suffix co.uk")
            val uk_origin = origin_of("https://shop.example.co.uk/")
            val verdict = validate_set_cookie(plain_cookie("sid", "co.uk"), uk_origin, 1000)
            # @capture(bit_table): the refused verdict and its exact reason string
            assert_false(verdict.accepted)
            expect(verdict.reason).to_equal("domain-is-public-suffix")

        it "rejects a dot-prefixed public suffix":
            # @req REQ-ORIGIN-CKADM-003
            step("Set a cookie whose domain is dot-prefixed .com")
            val verdict = validate_set_cookie(plain_cookie("sid", ".com"), shop_https(), 1000)
            # @capture(bit_table): the refused verdict and its exact reason string
            assert_false(verdict.accepted)
            expect(verdict.reason).to_equal("domain-is-public-suffix")

        it "still accepts a registrable domain one label deeper":
            # @req REQ-ORIGIN-CKADM-004
            step("Set a cookie for the registrable domain example.com")
            val verdict = validate_set_cookie(plain_cookie("sid", "example.com"), shop_https(), 1000)
            # @capture(statistics): the accepted verdict for a registrable domain
            assert_true(verdict.accepted)

    context "when the Domain attribute does not cover the request host":
        it "rejects a cookie for an unrelated domain":
            # @req REQ-ORIGIN-CKADM-005
            step("Set a cookie for evil.test on shop.example.com")
            val verdict = validate_set_cookie(plain_cookie("sid", "evil.test"), shop_https(), 1000)
            # @capture(bit_table): the refused verdict and its exact reason string
            assert_false(verdict.accepted)
            expect(verdict.reason).to_equal("domain-not-host-suffix")

        it "rejects a suffix-confusable domain":
            # @req REQ-ORIGIN-CKADM-006
            step("Set a cookie for ample.com on shop.example.com")
            val verdict = validate_set_cookie(plain_cookie("sid", "ample.com"), shop_https(), 1000)
            # @capture(statistics): the refused verdict for the suffix-confusable domain
            assert_false(verdict.accepted)

        it "rejects a domain that is deeper than the host":
            # @req REQ-ORIGIN-CKADM-007
            step("Set a cookie for a subdomain deeper than the request host")
            val verdict = validate_set_cookie(plain_cookie("sid", "a.shop.example.com"), shop_https(), 1000)
            # @capture(statistics): the refused verdict for the too-deep domain
            assert_false(verdict.accepted)

    context "when SameSite=None is used":
        it "rejects SameSite=None without Secure":
            # @req REQ-ORIGIN-CKADM-008
            step("Set an insecure SameSite=None cookie")
            val cookie = make_cookie("sid", "", "/", false, false, SameSite.None, 0)
            val verdict = validate_set_cookie(cookie, shop_https(), 1000)
            # @capture(bit_table): the refused verdict and its exact reason string
            assert_false(verdict.accepted)
            expect(verdict.reason).to_equal("samesite-none-requires-secure")

        it "accepts SameSite=None with Secure on a secure origin":
            # @req REQ-ORIGIN-CKADM-009
            step("Set a secure SameSite=None cookie on https")
            val cookie = make_cookie("sid", "", "/", true, false, SameSite.None, 0)
            # @capture(statistics): the accepted verdict for secure SameSite=None
            assert_true(validate_set_cookie(cookie, shop_https(), 1000).accepted)

    context "when Secure is requested from an insecure origin":
        it "rejects the cookie":
            # @req REQ-ORIGIN-CKADM-010
            step("Set a Secure cookie over http")
            val cookie = make_cookie("sid", "", "/", true, false, SameSite.Lax, 0)
            val verdict = validate_set_cookie(cookie, shop_http(), 1000)
            # @capture(bit_table): the refused verdict and its exact reason string
            assert_false(verdict.accepted)
            expect(verdict.reason).to_equal("secure-attribute-requires-secure-origin")

        it "still allows Secure on http://localhost":
            # @req REQ-ORIGIN-CKADM-011
            step("Set a Secure cookie on the localhost trust boundary")
            val local = origin_of("http://localhost:8080/")
            val cookie = make_cookie("sid", "", "/", true, false, SameSite.Lax, 0)
            # @capture(statistics): the accepted verdict for localhost
            assert_true(validate_set_cookie(cookie, local, 1000).accepted)

    context "when a name prefix is used":
        it "rejects __Host- with a Domain attribute":
            # @req REQ-ORIGIN-CKADM-012
            step("Set a __Host- cookie that carries a Domain attribute")
            val cookie = make_cookie("__Host-sid", "example.com", "/", true, false, SameSite.Lax, 0)
            val verdict = validate_set_cookie(cookie, shop_https(), 1000)
            # @capture(bit_table): the refused verdict and its exact reason string
            assert_false(verdict.accepted)
            expect(verdict.reason).to_equal("host-prefix-forbids-domain")

        it "rejects __Host- with a non-root path":
            # @req REQ-ORIGIN-CKADM-013
            step("Set a __Host- cookie scoped under /app")
            val cookie = make_cookie("__Host-sid", "", "/app", true, false, SameSite.Lax, 0)
            # @capture(statistics): the refused verdict for the non-root path
            assert_false(validate_set_cookie(cookie, shop_https(), 1000).accepted)

        it "rejects __Secure- without Secure":
            # @req REQ-ORIGIN-CKADM-014
            step("Set an insecure __Secure- cookie")
            val cookie = make_cookie("__Secure-sid", "", "/", false, false, SameSite.Lax, 0)
            val verdict = validate_set_cookie(cookie, shop_https(), 1000)
            # @capture(bit_table): the refused verdict and its exact reason string
            assert_false(verdict.accepted)
            expect(verdict.reason).to_equal("secure-prefix-requires-secure")

        it "accepts a well-formed __Host- cookie":
            # @req REQ-ORIGIN-CKADM-015
            step("Set a __Host- cookie with no domain and a root path")
            val cookie = make_cookie("__Host-sid", "", "/", true, false, SameSite.Lax, 0)
            # @capture(statistics): the accepted verdict for a well-formed prefix
            assert_true(validate_set_cookie(cookie, shop_https(), 1000).accepted)

    context "when the origin cannot be trusted":
        it "rejects any cookie set from an opaque origin":
            # @req REQ-ORIGIN-CKADM-016
            step("Set a cookie from an opaque sandbox origin")
            val verdict = validate_set_cookie(plain_cookie("sid", ""), opaque_origin("sandbox"), 1000)
            # @capture(bit_table): the refused verdict and its exact reason string
            assert_false(verdict.accepted)
            expect(verdict.reason).to_equal("opaque-or-malformed-origin")

    context "when the cookie is degenerate":
        it "rejects an empty name":
            # @req REQ-ORIGIN-CKADM-017
            step("Set a cookie with an empty name")
            # @capture(bit_table): the exact empty-name reason string
            expect(validate_set_cookie(plain_cookie("", ""), shop_https(), 1000).reason).to_equal("empty-name")

        it "rejects a relative path":
            # @req REQ-ORIGIN-CKADM-018
            step("Set a cookie whose path lacks the leading slash")
            val cookie = make_cookie("sid", "", "app", false, false, SameSite.Lax, 0)
            # @capture(bit_table): the exact path-must-be-absolute reason string
            expect(validate_set_cookie(cookie, shop_https(), 1000).reason).to_equal("path-must-be-absolute")

        it "rejects an already-expired cookie":
            # @req REQ-ORIGIN-CKADM-019
            step("Set a cookie that expired at tick 500 when the clock reads 1000")
            val cookie = make_cookie("sid", "", "/", false, false, SameSite.Lax, 500)
            # @capture(bit_table): the exact already-expired reason string
            expect(validate_set_cookie(cookie, shop_https(), 1000).reason).to_equal("already-expired")

        it "accepts a cookie expiring in the future":
            # @req REQ-ORIGIN-CKADM-020
            step("Set a cookie that expires at tick 2000 when the clock reads 1000")
            val cookie = make_cookie("sid", "", "/", false, false, SameSite.Lax, 2000)
            # @capture(statistics): the accepted verdict for a future expiry
            assert_true(validate_set_cookie(cookie, shop_https(), 1000).accepted)


# ============================================================================
# Cookie matching and delivery
# ============================================================================

# @manual_section: cookie-delivery

describe "cookie delivery honours domain, path, Secure and SameSite":
    """
    ## A stored cookie is still gated on every request

    Admission is not delivery: `Secure` must hold on the channel, expiry is
    re-checked against the clock, and `SameSite` decides cross-site attachment.
    """


    context "when matching domains":
        it "matches an exact host":
            # @req REQ-ORIGIN-CKDEL-001
            step("Match a cookie domain against its own host")
            # @capture(statistics): the domain-match verdict for an exact host
            assert_true(domain_matches("example.com", "example.com"))

        it "matches a subdomain of the cookie domain":
            # @req REQ-ORIGIN-CKDEL-002
            step("Match a cookie domain against its subdomain")
            # @capture(statistics): the domain-match verdict for a subdomain
            assert_true(domain_matches("example.com", "shop.example.com"))

        it "ignores a leading dot on the cookie domain":
            # @req REQ-ORIGIN-CKDEL-003
            step("Match a dot-prefixed cookie domain against a subdomain")
            # @capture(statistics): the domain-match verdict for a dot prefix
            assert_true(domain_matches(".example.com", "shop.example.com"))

        it "denies a suffix-confusable host":
            # @req REQ-ORIGIN-CKDEL-004
            step("Match ample.com against example.com")
            # @capture(statistics): the domain-match verdict for the confusable pair
            assert_false(domain_matches("ample.com", "example.com"))

        it "requires exact matching for IP hosts":
            # @req REQ-ORIGIN-CKDEL-005
            step("Match an IP cookie domain exactly and by suffix")
            # @capture(statistics): the domain-match verdicts for IP hosts
            assert_true(domain_matches("127.0.0.1", "127.0.0.1"))
            assert_false(domain_matches("0.0.1", "127.0.0.1"))

        it "denies a parent host against a deeper cookie domain":
            # @req REQ-ORIGIN-CKDEL-006
            step("Match a request host shallower than the cookie domain")
            # @capture(statistics): the domain-match verdict for a too-shallow host
            assert_false(domain_matches("shop.example.com", "example.com"))

        it "canonicalises a trailing-dot domain to nothing":
            # @req REQ-ORIGIN-CKDEL-007
            step("Canonicalise a trailing-dot cookie domain")
            # @capture(bit_table): the empty canonical form
            expect(canonical_domain("example.com.")).to_equal("")

    context "when matching paths":
        it "matches an exact path":
            # @req REQ-ORIGIN-CKDEL-008
            step("Match a cookie path against the identical request path")
            # @capture(statistics): the path-match verdict for an exact path
            assert_true(path_matches("/cart", "/cart"))

        it "matches a path prefix at a segment boundary":
            # @req REQ-ORIGIN-CKDEL-009
            step("Match /cart against /cart/items")
            # @capture(statistics): the path-match verdict at the segment boundary
            assert_true(path_matches("/cart", "/cart/items"))

        it "denies a prefix that is not on a segment boundary":
            # @req REQ-ORIGIN-CKDEL-010
            step("Match /cart against /cartel")
            # @capture(statistics): the path-match verdict across the segment boundary
            assert_false(path_matches("/cart", "/cartel"))

        it "denies a relative cookie path outright":
            # @req REQ-ORIGIN-CKDEL-011
            step("Match a cookie path without a leading slash")
            # @capture(statistics): the path-match verdict for a relative path
            assert_false(path_matches("cart", "/cart"))

    context "when the channel is insecure":
        it "withholds a Secure cookie from an http request":
            # @req REQ-ORIGIN-CKDEL-012
            step("Deliver a Secure cookie over http")
            val cookie = make_cookie("sid", "example.com", "/", true, false, SameSite.Lax, 0)
            # @capture(statistics): the delivery verdict over http
            assert_false(cookie_applies(cookie, shop_http(), "/cart/items", Some(shop_http()), "GET", false, 1000))

        it "sends the same cookie over https":
            # @req REQ-ORIGIN-CKDEL-013
            step("Deliver the same Secure cookie over https")
            val cookie = make_cookie("sid", "example.com", "/", true, false, SameSite.Lax, 0)
            # @capture(statistics): the delivery verdict over https
            assert_true(cookie_applies(cookie, shop_https(), "/cart/items", Some(shop_https()), "GET", false, 1000))

    context "when the request is cross-site":
        it "withholds a SameSite=Strict cookie":
            # @req REQ-ORIGIN-CKDEL-014
            step("Deliver a Strict cookie on a cross-site subresource request")
            val cookie = make_cookie("sid", "example.com", "/", true, false, SameSite.Strict, 0)
            # @capture(statistics): the delivery verdict for Strict cross-site
            assert_false(cookie_applies(cookie, shop_https(), "/cart/items", Some(attacker_origin()), "GET", true, 1000))

        it "treats a request with no client as same-site":
            # @req REQ-ORIGIN-CKDEL-015
            step("Deliver a Strict cookie with no initiator origin at all")
            val cookie = make_cookie("sid", "example.com", "/", true, false, SameSite.Strict, 0)
            # @capture(statistics): the delivery verdict with a nil initiator
            assert_true(cookie_applies(cookie, shop_https(), "/cart/items", nil, "POST", false, 1000))

        it "withholds a SameSite=Lax cookie from a subresource request":
            # @req REQ-ORIGIN-CKDEL-016
            step("Deliver a Lax cookie on a cross-site subresource request")
            val cookie = make_cookie("sid", "example.com", "/", true, false, SameSite.Lax, 0)
            # @capture(statistics): the delivery verdict for Lax subresource
            assert_false(cookie_applies(cookie, shop_https(), "/cart/items", Some(attacker_origin()), "GET", false, 1000))

        it "sends a SameSite=Lax cookie on a top-level navigation":
            # @req REQ-ORIGIN-CKDEL-017
            step("Deliver a Lax cookie on a cross-site top-level GET navigation")
            val cookie = make_cookie("sid", "example.com", "/", true, false, SameSite.Lax, 0)
            # @capture(statistics): the delivery verdict for Lax top-level GET
            assert_true(cookie_applies(cookie, shop_https(), "/cart/items", Some(attacker_origin()), "GET", true, 1000))

        it "withholds a SameSite=Lax cookie on an unsafe top-level navigation":
            # @req REQ-ORIGIN-CKDEL-018
            step("Deliver a Lax cookie on a cross-site top-level POST navigation")
            val cookie = make_cookie("sid", "example.com", "/", true, false, SameSite.Lax, 0)
            # @capture(statistics): the delivery verdict for Lax top-level POST
            assert_false(cookie_applies(cookie, shop_https(), "/cart/items", Some(attacker_origin()), "POST", true, 1000))

        it "sends a SameSite=None; Secure cookie on a subresource request":
            # @req REQ-ORIGIN-CKDEL-019
            step("Deliver a secure None cookie on a cross-site subresource request")
            val cookie = make_cookie("sid", "example.com", "/", true, false, SameSite.None, 0)
            # @capture(statistics): the delivery verdict for None cross-site
            assert_true(cookie_applies(cookie, shop_https(), "/cart/items", Some(attacker_origin()), "GET", false, 1000))

        it "withholds a SameSite=None cookie that lost its Secure flag":
            # @req REQ-ORIGIN-CKDEL-020
            step("Deliver an insecure None cookie on a cross-site subresource request")
            val cookie = make_cookie("sid", "example.com", "/", false, false, SameSite.None, 0)
            # @capture(statistics): the delivery verdict for None without Secure
            assert_false(cookie_applies(cookie, shop_https(), "/cart/items", Some(attacker_origin()), "GET", false, 1000))

    context "when the cookie has expired":
        it "withholds an expired cookie even from a same-site request":
            # @req REQ-ORIGIN-CKDEL-021
            step("Deliver a cookie that expired at tick 900 when the clock reads 1000")
            val cookie = make_cookie("sid", "example.com", "/", true, false, SameSite.Strict, 900)
            # @capture(statistics): the delivery verdict for the expired cookie
            assert_false(cookie_applies(cookie, shop_https(), "/cart/items", Some(shop_https()), "GET", false, 1000))

        it "treats expires_at of zero as a session cookie":
            # @req REQ-ORIGIN-CKDEL-022
            step("Check expiry of a zero-expiry session cookie far in the future")
            # @capture(statistics): the expiry verdict for a session cookie
            assert_false(is_expired(plain_cookie("sid", "example.com"), 999999))

    context "when Max-Age is resolved":
        it "turns Max-Age into an absolute expiry":
            # @req REQ-ORIGIN-CKDEL-023
            step("Resolve Max-Age=60 against a clock reading 1000")
            val resolved = apply_max_age(plain_cookie("sid", "example.com"), "sid=v; Max-Age=60", 1000)
            # @capture(statistics): the absolute expiry after Max-Age resolution
            expect(resolved.expires_at).to_equal(1060)  # oracle: Max-Age=60 from tick 1000 lands at absolute tick 1060

        it "turns Max-Age=0 into an already-expired cookie":
            # @req REQ-ORIGIN-CKDEL-024
            step("Resolve Max-Age=0 against a clock reading 1000")
            val resolved = apply_max_age(plain_cookie("sid", "example.com"), "sid=v; Max-Age=0", 1000)
            # @capture(statistics): the expiry verdict for Max-Age=0
            assert_true(is_expired(resolved, 1000))

        it "leaves a cookie with no Max-Age as a session cookie":
            # @req REQ-ORIGIN-CKDEL-025
            step("Resolve a header carrying only Path")
            val resolved = apply_max_age(plain_cookie("sid", "example.com"), "sid=v; Path=/", 1000)
            # @capture(statistics): the untouched expiry for a session cookie
            expect(resolved.expires_at).to_equal(0)  # oracle: no Max-Age attribute leaves the session-cookie expiry sentinel 0

        it "ignores malformed Max-Age and uses the last valid attribute":
            # @req REQ-ORIGIN-CKDEL-026
            step("Resolve a garbage Max-Age and a duplicated valid Max-Age")
            val malformed = apply_max_age(plain_cookie("sid", "example.com"), "sid=v; Max-Age=garbage", 1000)
            val duplicate = apply_max_age(plain_cookie("sid", "example.com"), "sid=v; Max-Age=60; Max-Age=5", 1000)
            # @capture(statistics): the expiries for malformed and duplicate Max-Age
            expect(malformed.expires_at).to_equal(0)  # oracle: a garbage Max-Age is ignored, leaving the session sentinel 0
            expect(duplicate.expires_at).to_equal(1005)  # oracle: the last valid attribute wins, Max-Age=5 from tick 1000 lands at 1005

    context "when a cookie is HttpOnly":
        it "hides it from script":
            # @req REQ-ORIGIN-CKDEL-027
            step("Read an HttpOnly cookie from script")
            # @capture(statistics): the script visibility for an HttpOnly cookie
            assert_false(script_visible(make_cookie("sid", "example.com", "/", true, true, SameSite.Lax, 0)))

        it "shows a non-HttpOnly cookie to script":
            # @req REQ-ORIGIN-CKDEL-028
            step("Read a plain cookie from script")
            # @capture(statistics): the script visibility for a plain cookie
            assert_true(script_visible(plain_cookie("theme", "example.com")))

        it "still sends the HttpOnly cookie on the network":
            # @req REQ-ORIGIN-CKDEL-029
            step("Deliver an HttpOnly cookie over the network channel")
            val cookie = make_cookie("sid", "example.com", "/", true, true, SameSite.Lax, 0)
            # @capture(statistics): the delivery verdict for an HttpOnly cookie
            assert_true(cookie_applies(cookie, shop_https(), "/cart/items", Some(shop_https()), "GET", false, 1000))

    context "when the cookie is host-only":
        it "keys a host-only cookie to the request host":
            # @req REQ-ORIGIN-CKDEL-030
            step("Resolve the effective domain of an empty-domain cookie")
            # @capture(bit_table): the request host as the effective domain
            expect(effective_domain(plain_cookie("sid", ""), shop_https())).to_equal("shop.example.com")


# ============================================================================
# Permissions
# ============================================================================

# @manual_section: permissions

describe "permissions are default-deny and origin-scoped":
    """
    ## A grant is a single (origin, feature) pair and nothing more

    An absent grant, an unknown feature, a revoked grant and an opaque origin
    are indistinguishable at the query boundary: they all read `Denied`.
    """


    context "before anything is granted":
        it "denies every feature":
            # @req REQ-ORIGIN-PERM-001
            step("Query three powerful features on a fresh permission set")
            var permissions = PermissionSet.create()
            # @capture(statistics): the deny verdicts on a fresh set
            assert_false(permissions.allows(site_a(), "geolocation"))
            assert_false(permissions.allows(site_a(), "camera"))
            assert_false(permissions.allows(site_a(), "notifications"))

        it "reports the Denied state explicitly":
            # @req REQ-ORIGIN-PERM-002
            step("Query the raw permission state of an ungranted feature")
            var permissions = PermissionSet.create()
            # @capture(statistics): the raw state for an ungranted feature
            assert_false(state_is_granted(permissions.query(site_a(), "geolocation")))

    context "when a grant is made":
        it "allows exactly the granted feature":
            # @req REQ-ORIGIN-PERM-003
            step("Grant geolocation and query it back")
            var permissions = PermissionSet.create()
            # @capture(statistics): the grant result and the query verdict
            assert_true(permissions.grant(site_a(), "geolocation"))
            assert_true(permissions.allows(site_a(), "geolocation"))

        it "does not leak to another feature on the same origin":
            # @req REQ-ORIGIN-PERM-004
            step("Grant geolocation and query camera on the same origin")
            var permissions = PermissionSet.create()
            # @capture(statistics): the cross-feature deny verdict
            permissions.grant(site_a(), "geolocation")
            assert_false(permissions.allows(site_a(), "camera"))

        it "does not leak to another origin":
            # @req REQ-ORIGIN-PERM-005
            step("Grant site_a and query site_b")
            var permissions = PermissionSet.create()
            # @capture(statistics): the cross-origin deny verdict
            permissions.grant(site_a(), "geolocation")
            assert_false(permissions.allows(site_b(), "geolocation"))

        it "does not leak across a scheme change on one host":
            # @req REQ-ORIGIN-PERM-006
            step("Grant https site_a and query the http spelling")
            var permissions = PermissionSet.create()
            # @capture(statistics): the cross-scheme deny verdict
            permissions.grant(site_a(), "geolocation")
            assert_false(permissions.allows(origin_of("http://a.test/"), "geolocation"))

        it "does not leak across a port change on one host":
            # @req REQ-ORIGIN-PERM-007
            step("Grant default-port site_a and query port 8443")
            var permissions = PermissionSet.create()
            # @capture(statistics): the cross-port deny verdict
            permissions.grant(site_a(), "geolocation")
            assert_false(permissions.allows(origin_of("https://a.test:8443/"), "geolocation"))

        it "does not leak to a subdomain":
            # @req REQ-ORIGIN-PERM-008
            step("Grant a.test and query sub.a.test")
            var permissions = PermissionSet.create()
            # @capture(statistics): the subdomain deny verdict
            permissions.grant(site_a(), "geolocation")
            assert_false(permissions.allows(origin_of("https://sub.a.test/"), "geolocation"))

        it "is idempotent":
            # @req REQ-ORIGIN-PERM-009
            step("Grant the same pair twice and count grants")
            var permissions = PermissionSet.create()
            # @capture(statistics): the grant count after a duplicate grant
            permissions.grant(site_a(), "geolocation")
            permissions.grant(site_a(), "geolocation")
            expect(permissions.granted_count()).to_equal(1)  # oracle: a duplicate grant replaces, leaving one entry

    context "when a grant is revoked":
        it "denies the feature afterwards":
            # @req REQ-ORIGIN-PERM-010
            step("Grant then revoke geolocation and query it")
            var permissions = PermissionSet.create()
            # @capture(statistics): the revoke result and the post-revoke verdict
            permissions.grant(site_a(), "geolocation")
            assert_true(permissions.revoke(site_a(), "geolocation"))
            assert_false(permissions.allows(site_a(), "geolocation"))

        it "leaves no residue behind":
            # @req REQ-ORIGIN-PERM-011
            step("Grant then revoke and count what remains")
            var permissions = PermissionSet.create()
            # @capture(statistics): the grant count after revoke
            permissions.grant(site_a(), "geolocation")
            permissions.revoke(site_a(), "geolocation")
            expect(permissions.granted_count()).to_equal(0)  # oracle: a revoked pair leaves the table empty

        it "keeps other grants on the same origin":
            # @req REQ-ORIGIN-PERM-012
            step("Revoke geolocation while persistent-storage stays granted")
            var permissions = PermissionSet.create()
            # @capture(statistics): the surviving grant verdict after a revoke
            permissions.grant(site_a(), "geolocation")
            permissions.grant(site_a(), "persistent-storage")
            permissions.revoke(site_a(), "geolocation")
            assert_true(permissions.allows(site_a(), "persistent-storage"))

        it "clears every grant for an origin on revoke_origin":
            # @req REQ-ORIGIN-PERM-013
            step("Grant twice on site_a and once on site_b, then revoke site_a")
            var permissions = PermissionSet.create()
            # @capture(statistics): the cleared count and the surviving origin's verdict
            permissions.grant(site_a(), "geolocation")
            permissions.grant(site_a(), "persistent-storage")
            permissions.grant(site_b(), "persistent-storage")
            expect(permissions.revoke_origin(site_a())).to_equal(2)  # oracle: site_a held exactly two grants to clear
            assert_false(permissions.allows(site_a(), "persistent-storage"))
            assert_true(permissions.allows(site_b(), "persistent-storage"))

    context "when the requester is opaque":
        it "refuses the grant":
            # @req REQ-ORIGIN-PERM-014
            step("Grant geolocation to an opaque sandbox origin")
            var permissions = PermissionSet.create()
            # @capture(statistics): the refused grant result
            assert_false(permissions.grant(opaque_origin("sandbox"), "geolocation"))

        it "stores nothing":
            # @req REQ-ORIGIN-PERM-015
            step("Grant to an opaque origin and count grants")
            var permissions = PermissionSet.create()
            # @capture(statistics): the grant count after an opaque grant
            permissions.grant(opaque_origin("sandbox"), "geolocation")
            expect(permissions.granted_count()).to_equal(0)  # oracle: a refused grant stores no entry

        it "still denies the query afterwards":
            # @req REQ-ORIGIN-PERM-016
            step("Query the opaque origin after its refused grant")
            var permissions = PermissionSet.create()
            val sandbox = opaque_origin("sandbox")
            # @capture(statistics): the post-refusal query verdict
            permissions.grant(sandbox, "geolocation")
            assert_false(permissions.allows(sandbox, "geolocation"))

        it "produces no permission key at all":
            # @req REQ-ORIGIN-PERM-017
            step("Ask for the permission key of an opaque origin")
            # @capture(bit_table): the empty permission key
            expect(permission_key(opaque_origin("sandbox"), "geolocation")).to_equal("")

    context "when the feature or context is wrong":
        it "refuses an unknown feature":
            # @req REQ-ORIGIN-PERM-018
            step("Grant and query a feature outside the known set")
            var permissions = PermissionSet.create()
            # @capture(statistics): the refusal for an unknown feature
            assert_false(permissions.grant(site_a(), "read-all-files"))
            assert_false(permissions.allows(site_a(), "read-all-files"))

        it "refuses geolocation to an insecure origin":
            # @req REQ-ORIGIN-PERM-019
            step("Grant the powerful geolocation feature over http")
            var permissions = PermissionSet.create()
            # @capture(statistics): the refusal for a powerful feature on http
            assert_false(permissions.grant(origin_of("http://a.test/"), "geolocation"))

        it "allows a non-powerful feature on an insecure origin":
            # @req REQ-ORIGIN-PERM-020
            step("Grant the non-powerful persistent-storage feature over http")
            var permissions = PermissionSet.create()
            # @capture(statistics): the grant for a non-powerful feature on http
            assert_true(permissions.grant(origin_of("http://a.test/"), "persistent-storage"))

        it "keeps the known-feature set closed":
            # @req REQ-ORIGIN-PERM-021
            step("Check the known set against geolocation and a trailing-space spoof")
            # @capture(statistics): the known-feature verdicts for exact and padded names
            assert_true(is_known_feature("geolocation"))
            assert_false(is_known_feature("geolocation "))


# ============================================================================
# Deliberate-red calibration
# ============================================================================

# @manual_section: calibration

describe "deliberate-red calibration proves the oracles bite":
    """
    ## The tests above are only worth what a breach would cost them

    Each case below re-implements a classic wrong version of a rule as a local
    shadow function and asserts that the exact vector used in the blocks above
    separates the correct answer from the broken one. If a future refactor
    reintroduced the breach, the paired assertion above would flip.
    """

    context "calibration 1 — host-only origin comparison":
        it "shows the http/https vector separates correct from breached":
            # @req REQ-ORIGIN-CAL-001
            step("Run the host-only breach against the http/https vector")
            val insecure = origin_of("http://x.test:80/")
            val secure = origin_of("https://x.test:443/")
            val breached = insecure.host == secure.host
            # @capture(statistics): the breached flag and the real policy verdict
            assert_true(breached)
            assert_false(same_origin(insecure, secure))
            assert_false(same_origin(insecure, secure) == breached)

        it "shows the port vector separates correct from breached":
            # @req REQ-ORIGIN-CAL-002
            step("Run the scheme+host breach against the port vector")
            val first = origin_of("http://x.test:8080/")
            val second = origin_of("http://x.test:8081/")
            val breached = first.scheme == second.scheme and first.host == second.host
            # @capture(statistics): the breached flag and the real policy verdict
            assert_true(breached)
            assert_false(same_origin(first, second))

    context "calibration 2 — cookie domain without the public-suffix rule":
        it "shows Domain=com passes a suffix-only check and fails the real one":
            # @req REQ-ORIGIN-CAL-003
            step("Run the suffix-only breach against the Domain=com vector")
            val breached = domain_matches("com", "shop.example.com")
            # @capture(statistics): the breached flag and the real admission verdict
            assert_true(breached)
            val verdict = validate_set_cookie(plain_cookie("sid", "com"), origin_of("https://shop.example.com/"), 1000)
            assert_false(verdict.accepted)
            expect(verdict.reason).to_equal("domain-is-public-suffix")

    context "calibration 3 — opaque origins compared by serialization":
        it "shows two distinct sandboxes serialize identically yet are not same-origin":
            # @req REQ-ORIGIN-CAL-004
            step("Run the serialization breach against two sandbox nonces")
            val first = origin_from_url_text("data:text/html,x", "sandbox-a")
            val second = origin_from_url_text("data:text/html,x", "sandbox-b")
            val breached = serialize_origin(first) == serialize_origin(second)
            # @capture(bit_table): the equal serializations and the unequal verdicts
            assert_true(breached)
            assert_false(same_origin(first, second))

    context "calibration 4 — permissions defaulting to allow":
        it "shows an ungranted query is Denied, not merely absent":
            # @req REQ-ORIGIN-CAL-005
            step("Query an ungranted feature on a fresh permission set")
            var permissions = PermissionSet.create()
            # @capture(statistics): the empty count and the deny verdict
            expect(permissions.granted_count()).to_equal(0)  # oracle: a fresh set holds no grants
            assert_false(state_is_granted(permissions.query(origin_of("https://a.test/"), "camera")))

    context "calibration 5 — deriving origins through Url.parse":
        it "shows the two inputs that Url.parse collapses stay separated here":
            # @req REQ-ORIGIN-CAL-006
            step("Derive origins for the empty string and free text, then compare")
            val empty = origin_of("")
            val garbage = origin_of("not a url")
            # @capture(statistics): the opaque flags and the separation verdict
            assert_true(is_opaque(empty))
            assert_true(is_opaque(garbage))
            assert_false(same_origin(empty, garbage))

        it "shows a data: URL does not become an http origin":
            # @req REQ-ORIGIN-CAL-007
            step("Derive a data: origin and check its scheme and default port")
            val derived = origin_of("data:text/html,<b>x</b>")
            # @capture(statistics): the scheme comparison and the data default port
            assert_false(derived.scheme == "http")
            expect(default_port_for("data")).to_equal(-1)  # oracle: -1 — named expected value from the requirement
