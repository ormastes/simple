"""
## Purpose and audience
Purpose: Prove that cross-document access is refused at the call site.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-BROWSER-ENGINE-SECURITY-001 — stable requirement identity for this spec.
# @cover src/lib/gc_async_mut/gpu/browser_engine/browsing_context.spl 80%
# @cover src/lib/gc_async_mut/gpu/browser_engine/script/storage_api.spl 60%
# @cover src/lib/gc_async_mut/gpu/browser_engine/script/clipboard_api.spl 60%
"""
# Same-Origin Policy ENFORCEMENT Specification

**Feature IDs:** #BRWIRE-ENFORCE
**Category:** Stdlib
**Difficulty:** 4/5
**Status:** Draft

## Overview

`security/origin_model_spec.spl` covers the *model*: given two origins, does
`same_origin` say yes. This file covers the *wiring*: when a document, a
response body, a cookie, a storage area or a permission-gated API is actually
reached for, is the model consulted and is the answer obeyed.

Every expectation below is an absolute value, not a relative one. A refused
read yields exactly the empty text or an empty `#document`; it never yields
truncated content.
"""

use std.spipe.*

use std.gc_async_mut.gpu.browser_engine.browsing_context.{
    BrowsingContext,
    BrowsingDocument,
    context_origin_from_url
}
use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode}
use std.gc_async_mut.gpu.browser_engine.net.cors.{CorsChecker}
use std.gc_async_mut.gpu.browser_engine.net.entity.cookie_types.{Cookie, SameSite}
use std.gc_async_mut.gpu.browser_engine.net.entity.url_types.{Origin, Url}
use std.gc_async_mut.gpu.browser_engine.script.clipboard_api.{
    BrowserClipboard,
    clipboard_write_text,
    clipboard_read_for,
    clipboard_write_for
}
use std.gc_async_mut.gpu.browser_engine.script.navigator_api.{navigator_geolocation_allowed}
use std.gc_async_mut.gpu.browser_engine.security.permission_policy.{PermissionSet}


# ============================================================================
# Fixtures — module-level fns, not describe-level vals (fixture capture in
# `it` bodies is unreliable; see the 10 pre-existing reds in origin_model_spec)
# ============================================================================

fn alice_origin() -> Origin:
    return Origin(scheme: "https", host: "alice.example", port: 443)

fn bob_origin() -> Origin:
    return Origin(scheme: "https", host: "bob.example", port: 443)

fn alice_http_origin() -> Origin:
    return Origin(scheme: "http", host: "alice.example", port: 80)

fn alice_other_port_origin() -> Origin:
    return Origin(scheme: "https", host: "alice.example", port: 8443)

fn opaque_data_origin() -> Origin:
    return context_origin_from_url("data:text/html,<b>hi</b>", "spec-data-1")

fn secret_document() -> BeDomNode:
    var root = BeDomNode.document()
    root.children.push(BeDomNode.text("BANK-BALANCE-4242"))
    return root

fn context_with_alice_document() -> BrowsingContext:
    var ctx = BrowsingContext.create()
    ctx.install_document(BrowsingDocument.create("alice-page", alice_origin(), secret_document()))
    return ctx

fn plain_cookie(name: text, value: text) -> Cookie:
    return Cookie(
        name: name,
        value: value,
        domain: "",
        path: "/",
        secure: false,
        http_only: false,
        same_site: SameSite.Lax,
        expires_at: 0
    )

fn http_only_cookie(name: text, value: text) -> Cookie:
    return Cookie(
        name: name,
        value: value,
        domain: "",
        path: "/",
        secure: false,
        http_only: true,
        same_site: SameSite.Lax,
        expires_at: 0
    )

fn secure_cookie(name: text, value: text) -> Cookie:
    return Cookie(
        name: name,
        value: value,
        domain: "",
        path: "/",
        secure: true,
        http_only: false,
        same_site: SameSite.Lax,
        expires_at: 0
    )


# ============================================================================
# 1. Cross-document access
# ============================================================================
use std.spec.step


describe "cross-document access is refused at the call site":
    """
    ## A document in one origin cannot read another origin's tree

    `BrowsingContext.read_document_*` is the only path from a context to
    another document's DOM, and it asks `origin_policy.can_access_document`
    first. A refusal returns an empty `#document`, so a caller that ignores the
    boolean still gets nothing.
    """

    it "the owning origin reads its own document text":
        step("Verify: the owning origin reads its own document text")
        # @req: REQ-BROWSER-ENGINE-SECURITY-001
        val ctx = context_with_alice_document()
        val got = ctx.read_document_text(alice_origin(), "alice-page")
        expect(got).to_equal("BANK-BALANCE-4242")

    it "a different host reads the empty text, not the content":
        step("Verify: a different host reads the empty text, not the content")
        val ctx = context_with_alice_document()
        val got = ctx.read_document_text(bob_origin(), "alice-page")
        expect(got).to_equal("")

    it "a different scheme on the same host is still refused":
        step("Verify: a different scheme on the same host is still refused")
        val ctx = context_with_alice_document()
        val got = ctx.read_document_text(alice_http_origin(), "alice-page")
        expect(got).to_equal("")

    it "a different port on the same host and scheme is still refused":
        step("Verify: a different port on the same host and scheme is still refused")
        val ctx = context_with_alice_document()
        val got = ctx.read_document_text(alice_other_port_origin(), "alice-page")
        expect(got).to_equal("")

    it "a refused root read yields an empty document node":
        step("Verify: a refused root read yields an empty document node")
        val ctx = context_with_alice_document()
        val root = ctx.read_document_root(bob_origin(), "alice-page")
        expect(root.children.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "the granted root read yields the real tree":
        step("Verify: the granted root read yields the real tree")
        val ctx = context_with_alice_document()
        val root = ctx.read_document_root(alice_origin(), "alice-page")
        expect(root.children.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "an unknown document name is refused rather than defaulted":
        step("Verify: an unknown document name is refused rather than defaulted")
        val ctx = context_with_alice_document()
        val allowed = ctx.can_access(alice_origin(), "no-such-page")
        expect(allowed).to_equal(false)


# ============================================================================
# 2. Response reads
# ============================================================================

describe "response reads are gated by CORS":
    """
    ## A body from another origin is not readable without an explicit grant

    `BrowsingContext.read_response` delegates to
    `origin_policy.can_read_response`. Same-origin always reads; cross-origin
    needs an exact `Access-Control-Allow-Origin` echo, or `*` without
    credentials. A refused read carries an empty body.
    """

    it "a same-origin body is readable with no CORS header at all":
        step("Verify: a same-origin body is readable with no CORS header at all")
        val ctx = BrowsingContext.create()
        val got = ctx.read_response(alice_origin(), alice_origin(), "", false, "PAYLOAD")
        expect(got.body).to_equal("PAYLOAD")

    it "a cross-origin body with no grant is empty":
        step("Verify: a cross-origin body with no grant is empty")
        val ctx = BrowsingContext.create()
        val got = ctx.read_response(alice_origin(), bob_origin(), "", false, "PAYLOAD")
        expect(got.body).to_equal("")

    it "a cross-origin body with no grant is marked refused":
        step("Verify: a cross-origin body with no grant is marked refused")
        val ctx = BrowsingContext.create()
        val got = ctx.read_response(alice_origin(), bob_origin(), "", false, "PAYLOAD")
        assert_false(got.allowed)

    it "an exact Access-Control-Allow-Origin echo admits the read":
        step("Verify: an exact Access-Control-Allow-Origin echo admits the read")
        val ctx = BrowsingContext.create()
        val got = ctx.read_response(alice_origin(), bob_origin(), "https://alice.example", false, "PAYLOAD")
        expect(got.body).to_equal("PAYLOAD")

    it "a grant addressed to somebody else does not admit the read":
        step("Verify: a grant addressed to somebody else does not admit the read")
        val ctx = BrowsingContext.create()
        val got = ctx.read_response(alice_origin(), bob_origin(), "https://mallory.example", false, "PAYLOAD")
        expect(got.body).to_equal("")

    it "wildcard with credentials is refused":
        step("Verify: wildcard with credentials is refused")
        val ctx = BrowsingContext.create()
        val got = ctx.read_response(alice_origin(), bob_origin(), "*", true, "PAYLOAD")
        expect(got.body).to_equal("")

    it "the CorsChecker reaches the same verdict as the context":
        step("Verify: the CorsChecker reaches the same verdict as the context")
        val checker = CorsChecker.new("https://alice.example")
        val target = Url(
            scheme: "https", host: "bob.example", port: 443,
            path: "/x", query: "", fragment: "", opaque: false
        )
        val allowed = checker.can_read_body(target, "Access-Control-Allow-Origin: https://alice.example\r\n", "omit")
        expect(allowed).to_equal(true)

    it "the CorsChecker refuses a body with no grant":
        step("Verify: the CorsChecker refuses a body with no grant")
        val checker = CorsChecker.new("https://alice.example")
        val target = Url(
            scheme: "https", host: "bob.example", port: 443,
            path: "/x", query: "", fragment: "", opaque: false
        )
        val allowed = checker.can_read_body(target, "Content-Type: text/plain\r\n", "omit")
        expect(allowed).to_equal(false)


# ============================================================================
# 3. Cookie visibility and attachment
# ============================================================================

describe "cookie attachment is gated by the cookie policy":
    """
    ## `HttpOnly` is invisible to script; `Secure` never leaves a secure channel

    Attachment runs through `cookie_policy.cookie_applies` and the
    `document.cookie` surface additionally through `cookie_policy.script_visible`.
    """

    it "a plain cookie is visible to script":
        step("Verify: a plain cookie is visible to script")
        var ctx = BrowsingContext.create()
        ctx.set_cookie_from(plain_cookie("sid", "s1"), alice_origin(), 0)
        val seen = ctx.document_cookie(alice_origin(), "/", 0)
        expect(seen).to_equal("sid=s1")

    it "an HttpOnly cookie is invisible to script at the point script reads it":
        step("Verify: an HttpOnly cookie is invisible to script at the point script reads it")
        var ctx = BrowsingContext.create()
        ctx.set_cookie_from(http_only_cookie("auth", "TOKEN"), alice_origin(), 0)
        val seen = ctx.document_cookie(alice_origin(), "/", 0)
        expect(seen).to_equal("")

    it "the same HttpOnly cookie is still attached to a network request":
        step("Verify: the same HttpOnly cookie is still attached to a network request")
        var ctx = BrowsingContext.create()
        ctx.set_cookie_from(http_only_cookie("auth", "TOKEN"), alice_origin(), 0)
        val header = ctx.request_cookie_header(alice_origin(), "/", Some(alice_origin()), "GET", true, 0)
        expect(header).to_equal("auth=TOKEN")

    it "a host-only cookie stays on the host that set it":
        step("Verify: a host-only cookie stays on the host that set it")
        var ctx = BrowsingContext.create()
        ctx.set_cookie_from(plain_cookie("sid", "s1"), alice_origin(), 0)
        val network_header = ctx.request_cookie_header(
            bob_origin(), "/", Some(alice_origin()), "GET", true, 0
        )
        expect(network_header).to_equal("")
        expect(ctx.document_cookie(bob_origin(), "/", 0)).to_equal("")

    it "a Secure cookie is attached over https":
        step("Verify: a Secure cookie is attached over https")
        var ctx = BrowsingContext.create()
        ctx.set_cookie_from(secure_cookie("sec", "S"), alice_origin(), 0)
        val header = ctx.request_cookie_header(alice_origin(), "/", Some(alice_origin()), "GET", true, 0)
        expect(header).to_equal("sec=S")

    it "a Secure cookie is NOT attached over a non-secure scheme":
        step("Verify: a Secure cookie is NOT attached over a non-secure scheme")
        var ctx = BrowsingContext.create()
        ctx.set_cookie_from(secure_cookie("sec", "S"), alice_origin(), 0)
        val header = ctx.request_cookie_header(alice_http_origin(), "/", Some(alice_http_origin()), "GET", true, 0)
        expect(header).to_equal("")

    it "a Secure cookie cannot even be set from a non-secure origin":
        step("Verify: a Secure cookie cannot even be set from a non-secure origin")
        var ctx = BrowsingContext.create()
        val verdict = ctx.set_cookie_from(secure_cookie("sec", "S"), alice_http_origin(), 0)
        expect(verdict.reason).to_equal("secure-attribute-requires-secure-origin")


# ============================================================================
# 4. Storage partitioning
# ============================================================================

describe "storage is partitioned per origin":
    """
    ## One origin's storage is not another's

    The partition key is `origin_policy.storage_key`. Two different origins get
    two different partitions; an origin with no storage key gets no storage.
    """

    it "an origin reads back what it wrote":
        step("Verify: an origin reads back what it wrote")
        var ctx = BrowsingContext.create()
        ctx.storage_set(alice_origin(), "k", "alice-value")
        val got = ctx.storage_get(alice_origin(), "k")
        expect(got).to_equal("alice-value")

    it "another origin does not see it":
        step("Verify: another origin does not see it")
        var ctx = BrowsingContext.create()
        ctx.storage_set(alice_origin(), "k", "alice-value")
        val got = ctx.storage_get(bob_origin(), "k")
        expect(got).to_equal("")

    it "a different port is a different partition":
        step("Verify: a different port is a different partition")
        var ctx = BrowsingContext.create()
        ctx.storage_set(alice_origin(), "k", "alice-value")
        val got = ctx.storage_get(alice_other_port_origin(), "k")
        expect(got).to_equal("")

    it "writes from two origins do not overwrite each other":
        step("Verify: writes from two origins do not overwrite each other")
        var ctx = BrowsingContext.create()
        ctx.storage_set(alice_origin(), "k", "alice-value")
        ctx.storage_set(bob_origin(), "k", "bob-value")
        val got = ctx.storage_get(alice_origin(), "k")
        expect(got).to_equal("alice-value")

    it "the partition key is the serialized origin":
        step("Verify: the partition key is the serialized origin")
        val ctx = BrowsingContext.create()
        val key = ctx.storage_partition_key(alice_origin())
        expect(key).to_equal("https://alice.example")

    it "two identical origins share a partition":
        step("Verify: two identical origins share a partition")
        val ctx = BrowsingContext.create()
        val shared = ctx.shares_storage_with(alice_origin(), alice_origin())
        expect(shared).to_equal(true)

    it "two different origins do not share a partition":
        step("Verify: two different origins do not share a partition")
        val ctx = BrowsingContext.create()
        val shared = ctx.shares_storage_with(alice_origin(), bob_origin())
        expect(shared).to_equal(false)


# ============================================================================
# 5. Permission-gated APIs
# ============================================================================

describe "permission-gated calls are default-deny":
    """
    ## An ungranted origin is refused, and a refusal returns nothing

    Every gate is `permission_policy.PermissionSet.query`, whose only default
    is `Denied`.
    """

    it "clipboard read from an ungranted origin returns the empty text":
        step("Verify: clipboard read from an ungranted origin returns the empty text")
        var clip = BrowserClipboard.new()
        clipboard_write_text(clip, "COPIED-SECRET")
        val perms = PermissionSet.create()
        val got = clipboard_read_for(clip, perms, alice_origin())
        expect(got).to_equal("")

    it "clipboard read from a granted origin returns the content":
        step("Verify: clipboard read from a granted origin returns the content")
        var clip = BrowserClipboard.new()
        clipboard_write_text(clip, "COPIED-SECRET")
        var perms = PermissionSet.create()
        perms.grant(alice_origin(), "clipboard-read")
        val got = clipboard_read_for(clip, perms, alice_origin())
        expect(got).to_equal("COPIED-SECRET")

    it "a grant to one origin does not admit another origin":
        step("Verify: a grant to one origin does not admit another origin")
        var clip = BrowserClipboard.new()
        clipboard_write_text(clip, "COPIED-SECRET")
        var perms = PermissionSet.create()
        perms.grant(alice_origin(), "clipboard-read")
        val got = clipboard_read_for(clip, perms, bob_origin())
        expect(got).to_equal("")

    it "an ungranted clipboard write is refused and leaves the buffer alone":
        step("Verify: an ungranted clipboard write is refused and leaves the buffer alone")
        var clip = BrowserClipboard.new()
        clipboard_write_text(clip, "ORIGINAL")
        val perms = PermissionSet.create()
        val ok = clipboard_write_for(clip, perms, alice_origin(), "OVERWRITTEN")
        expect(ok).to_equal(false)

    it "the buffer really is unchanged after a refused write":
        step("Verify: the buffer really is unchanged after a refused write")
        var clip = BrowserClipboard.new()
        clipboard_write_text(clip, "ORIGINAL")
        val perms = PermissionSet.create()
        clipboard_write_for(clip, perms, alice_origin(), "OVERWRITTEN")
        val got = clipboard_read_text(clip)
        expect(got).to_equal("ORIGINAL")

    it "geolocation is denied to an ungranted origin":
        step("Verify: geolocation is denied to an ungranted origin")
        val perms = PermissionSet.create()
        val allowed = navigator_geolocation_allowed(perms, alice_origin())
        expect(allowed).to_equal(false)

    it "geolocation is allowed once granted to that origin":
        step("Verify: geolocation is allowed once granted to that origin")
        var perms = PermissionSet.create()
        perms.grant(alice_origin(), "geolocation")
        val allowed = navigator_geolocation_allowed(perms, alice_origin())
        expect(allowed).to_equal(true)

    it "geolocation cannot be granted to a non-secure origin at all":
        step("Verify: geolocation cannot be granted to a non-secure origin at all")
        var perms = PermissionSet.create()
        perms.grant(alice_http_origin(), "geolocation")
        val allowed = navigator_geolocation_allowed(perms, alice_http_origin())
        expect(allowed).to_equal(false)

    it "revoking removes the grant":
        step("Verify: revoking removes the grant")
        var perms = PermissionSet.create()
        perms.grant(alice_origin(), "geolocation")
        perms.revoke(alice_origin(), "geolocation")
        val allowed = navigator_geolocation_allowed(perms, alice_origin())
        expect(allowed).to_equal(false)


# ============================================================================
# 6. Opaque origins get nothing
# ============================================================================

describe "an opaque origin gets nothing":
    """
    ## `data:` and friends are opaque, and every surface refuses them

    A `data:` URL never yields a tuple origin, so it has no storage partition,
    no cookies, no permissions, and no cross-document reach — not even to
    another document derived from the same `data:` URL.
    """

    it "a data: URL has no storage partition key":
        step("Verify: a data: URL has no storage partition key")
        val ctx = BrowsingContext.create()
        val key = ctx.storage_partition_key(opaque_data_origin())
        expect(key).to_equal("")

    it "a data: URL cannot write storage":
        step("Verify: a data: URL cannot write storage")
        var ctx = BrowsingContext.create()
        val ok = ctx.storage_set(opaque_data_origin(), "k", "v")
        expect(ok).to_equal(false)

    it "a data: URL reads the empty text from storage":
        step("Verify: a data: URL reads the empty text from storage")
        var ctx = BrowsingContext.create()
        ctx.storage_set(opaque_data_origin(), "k", "v")
        val got = ctx.storage_get(opaque_data_origin(), "k")
        expect(got).to_equal("")

    it "two opaque origins do not share a storage partition":
        step("Verify: two opaque origins do not share a storage partition")
        val ctx = BrowsingContext.create()
        val left = context_origin_from_url("data:text/html,a", "spec-op-1")
        val right = context_origin_from_url("data:text/html,a", "spec-op-2")
        val shared = ctx.shares_storage_with(left, right)
        expect(shared).to_equal(false)

    it "an opaque origin cannot set a cookie":
        step("Verify: an opaque origin cannot set a cookie")
        var ctx = BrowsingContext.create()
        val verdict = ctx.set_cookie_from(plain_cookie("sid", "s1"), opaque_data_origin(), 0)
        expect(verdict.reason).to_equal("opaque-or-malformed-origin")

    it "an opaque origin is sent no cookies":
        step("Verify: an opaque origin is sent no cookies")
        var ctx = BrowsingContext.create()
        ctx.set_cookie_from(plain_cookie("sid", "s1"), alice_origin(), 0)
        val header = ctx.request_cookie_header(opaque_data_origin(), "/", Some(opaque_data_origin()), "GET", true, 0)
        expect(header).to_equal("")

    it "an opaque origin cannot be granted a permission":
        step("Verify: an opaque origin cannot be granted a permission")
        var perms = PermissionSet.create()
        perms.grant(opaque_data_origin(), "notifications")
        expect(perms.granted_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "an opaque origin cannot read another document":
        step("Verify: an opaque origin cannot read another document")
        val ctx = context_with_alice_document()
        val got = ctx.read_document_text(opaque_data_origin(), "alice-page")
        expect(got).to_equal("")

    it "an opaque origin cannot read a cross-origin response even with a null grant":
        step("Verify: an opaque origin cannot read a cross-origin response even with a null grant")
        val ctx = BrowsingContext.create()
        val got = ctx.read_response(opaque_data_origin(), alice_origin(), "null", false, "PAYLOAD")
        expect(got.body).to_equal("")
