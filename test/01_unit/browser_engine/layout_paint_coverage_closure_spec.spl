# @cover src/lib/gc_async_mut/gpu/browser_engine/layout_paint.spl 20%
"""
# CSS Paint Pass — Coverage Closure (partial)

`layout_paint.spl` had zero test/ references before this spec. This spec
closes `_apply_opacity` fully (all four branches).

`_paint_box` is NOT testable as written: it reads `box.node`, `box.content_x`,
`box.content_y`, `box.content_width`, and `box.content_height` as fields, but
`layout_box.BeLayoutBox` (its declared import) has no `node` field at all and
exposes content_* only as METHODS. No module imports layout_paint, so the
defect is latent dead code rather than a live rendering bug — recorded here
instead of silently skipped. Fixing it means either deleting the module or
porting `_paint_box` to the real BeLayoutBox shape; both are renderer
refactors out of scope for a tests-only pass.
"""

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.browser_engine.layout_paint.{_apply_opacity}

describe "_apply_opacity (closure)":
    it "returns the color unchanged at full opacity":
        expect(_apply_opacity(0xFF112233, 1.0)).to_equal(0xFF112233)

    it "zeroes the alpha channel at zero opacity":
        expect(_apply_opacity(0xFF112233, 0.0)).to_equal(0x00112233)

    it "scales the alpha channel for partial opacity":
        expect(_apply_opacity(0xFF000000, 0.5)).to_equal(0x7F000000)

    it "preserves RGB bits while blending":
        expect(_apply_opacity(0x80ABCDEF, 0.5) & 0x00FFFFFF).to_equal(0x00ABCDEF)
