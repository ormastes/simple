# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
"""
Flat cells-per-line wrap overflow contract (compute_wrap_ranges).

CSS overflow-wrap: normal: a single unbreakable word that does not fit the
line is taken WHOLE and overflows — it is not chopped at the cells-per-line
boundary. The flat fallback used to hard-cut mid-word ('Visible İ' at cpl 2
became 'Vi','si','bl','e','İ'); it now mirrors the style-aware wrap's
`word_end_byte` fallback. `web_wrap_line_end` itself keeps its raw boundary
cut (pinned by text_byte_codepoint_index_residue_spec); this spec pins the
range composer that builds on it. Breaks AT spaces are unchanged.
"""
# @req REQ-SSPEC-UNIT
# @req REQ-BROWSER-ENGINE-TEXT-WRAP-004
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_text.spl 1%
use std.spec.*

use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_layout_foundation.{
    compute_wrap_ranges
}

fn range_tuples(txt: text, cpl: i32) -> text:
    val ranges = compute_wrap_ranges(txt, cpl)
    var out = ""
    var i = 0
    while i < ranges.starts.len():
        if i > 0:
            out = out + ","
        out = out + "{ranges.starts[i]}:{ranges.ends[i]}"
        i = i + 1
    out

describe "flat wrap whole-word overflow":
    it "takes an unbreakable word whole instead of chopping it at the cpl boundary":
        # @req REQ-SSPEC-UNIT
        step("takes an unbreakable word whole instead of chopping it at the cpl boundary")
        # "Visible İ" is 10 bytes / 9 codepoints; cpl 2 used to yield five
        # mid-word lines (0:2,2:4,4:6,6:7,7:10). The unbreakable first word now
        # overflows whole and the break happens at the space: "Visible", "İ".
        expect(range_tuples("Visible İ", 2)).to_equal("0:7,8:10")

    it "still breaks at spaces that fall inside the cpl window":
        # @req REQ-SSPEC-UNIT
        step("still breaks at spaces that fall inside the cpl window")
        expect(range_tuples("ab cd ef", 3)).to_equal("0:2,3:5,6:8")

    it "overflows an unbreakable word and wraps the following words on their own lines":
        # @req REQ-SSPEC-UNIT
        step("overflows an unbreakable word and wraps the following words on their own lines")
        expect(range_tuples("hello world xx", 3)).to_equal("0:5,6:11,12:14")

    it "keeps a run that fits on one line":
        # @req REQ-SSPEC-UNIT
        step("keeps a run that fits on one line")
        expect(range_tuples("hi", 8)).to_equal("0:2")
