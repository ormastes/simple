"""
## Purpose and audience
Purpose: Pin that the UA link style (blue `rgb(0,0,238)` + underline) applies to
an `<a>` only when it has an `href` attribute. An `<a>` without `href` (and a
named anchor) is an ordinary inline: it inherits `color` and has no
text-decoration. An empty `href=""` still counts as a link.
Audience: browser-engine layout and paint maintainers.

Chrome oracle (Chrome 159, getComputedStyle, body color #172033, enclosing
`<p style="color:#336699">`, 2026-11-17):

| anchor                  | color              | text-decoration-line |
|-------------------------|--------------------|----------------------|
| `<a>`                   | rgb(51, 102, 153)  | none                 |
| `<a href="x.html">`     | rgb(0, 0, 238)     | underline            |
| `<a href="">`           | rgb(0, 0, 238)     | underline            |
| `<a name="top">`        | rgb(51, 102, 153)  | none                 |

Found while classifying the catalog `html` page residual: every `<a>a example</a>`
in the feature inventory was blue and underlined in Simple, plain text in Chrome.
Filed in doc/08_tracking/bug/web_render_html_page_residual_2026-11-17.md.
"""

"""
Traceability: REQ-BROWSER-ENGINE-ANCHOR-HREF-UA-STYLE-001 — only an anchor with href gets the UA link style.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_core.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_style_by_id
}

val PAGE: text = "<html><head><style>body{{color:#172033}}</style></head><body><p style=\"color:#336699\">" +
    "<a id=n>nohref</a> <a id=h href=\"x.html\">href</a> <a id=e href=\"\">empty</a> <a id=nm name=top>named</a></p></body></html>"

# 0xFF336699 and 0xFF0000EE as unsigned ARGB
val INHERITED: text = "4281558681"
val LINK_BLUE: text = "4278190318"

fn _look(id: text) -> text:
    simple_web_layout_debug_style_by_id(PAGE, id, "color") + "," +
        simple_web_layout_debug_style_by_id(PAGE, id, "underline")

describe "anchor UA link style":
    it "AC-1: an anchor without href inherits color and is not underlined":
        step("Chrome 159: rgb(51,102,153), none")
        expect(_look("n")).to_equal(INHERITED + ",false")

    it "AC-2: an anchor with href is blue and underlined":
        step("Chrome 159: rgb(0,0,238), underline")
        expect(_look("h")).to_equal(LINK_BLUE + ",true")

    it "AC-3: an empty href is still a link":
        expect(_look("e")).to_equal(LINK_BLUE + ",true")

    it "AC-4: a named anchor without href is plain":
        expect(_look("nm")).to_equal(INHERITED + ",false")
