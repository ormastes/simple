"""Legacy DOM dispatch fields stay explicitly owned by BeDomEventDispatch."""

use std.io_runtime.{file_read}
use std.spec.*

describe "DOM event dispatch field ownership":
    it "declares every collection mutated by the dispatch append path":
        val owner = file_read(
            "src/lib/gc_async_mut/gpu/browser_engine/dom.spl"
        )
        val accessors = file_read(
            "src/lib/gc_async_mut/gpu/browser_engine/dom_accessors.spl"
        )

        expect(owner).to_contain("target_route_id: text")
        expect(owner).to_contain("target_id: text")
        expect(owner).to_contain("current_target_id: text")
        expect(owner).to_contain("related_target_id: text")
        expect(owner).to_contain("current_target_ids: [text]")
        expect(owner).to_contain("current_target_route_ids: [text]")
        expect(accessors).to_contain(
            "next.current_target_ids.push(be_dom_event_identity(node))"
        )
        expect(accessors).to_contain(
            "next.current_target_route_ids.push(be_dom_route_identity(node))"
        )
