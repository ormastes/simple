"""
## Purpose and audience
Purpose: Pin that `rem` resolves against the ROOT element's computed
font-size (CSS Values 4 §6.1.1), not a fixed 16px, for width, padding,
font-size and margin.
Audience: browser-engine cascade maintainers.

Chrome oracle (Chrome 159, 900x2000, `html{font-size:20px}`,
`body{margin:0}`, getBoundingClientRect, 2026-11-16):

| style                                  | x,y,w,h     |
|----------------------------------------|-------------|
| `#a{width:2rem}`                       | 0,0,40,5    |
| `#b{width:50px;padding-left:1rem}`     | 0,5,70,5    |
| `#c{font-size:1.5rem;width:1em}`       | 0,10,30,5   |
| `#d{width:2.5rem;margin-left:0.5rem}`  | 10,15,50,5  |

Filed as `casc_rem_width` in
doc/08_tracking/bug/web_layout_cascade_selector_paint_chrome159_round4_divergences_2026-11-15.md.
"""

"""
Traceability: REQ-BROWSER-ENGINE-REM-ROOT-FONT-001 — rem is relative to the root font-size.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_declarations.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_layout_by_id
}

val PAGE: text = "<html><head><style>html{{font-size:20px}} body{{margin:0;font:16px/1 sans-serif}}" +
    " #a{{width:2rem}} #b{{width:50px;padding-left:1rem}} #c{{font-size:1.5rem;width:1em}}" +
    " #d{{width:2.5rem;margin-left:0.5rem}}</style></head><body>" +
    "<div id=a style=\"height:5px\"></div>" +
    "<div id=b style=\"height:5px\"></div>" +
    "<div id=c style=\"height:5px\"></div>" +
    "<div id=d style=\"height:5px\"></div>" +
    "</body></html>"

fn _box(id: text) -> text:
    simple_web_layout_debug_layout_by_id(PAGE, 900, 2000, id, "x") + "," +
        simple_web_layout_debug_layout_by_id(PAGE, 900, 2000, id, "y") + "," +
        simple_web_layout_debug_layout_by_id(PAGE, 900, 2000, id, "w") + "," +
        simple_web_layout_debug_layout_by_id(PAGE, 900, 2000, id, "h")

describe "rem resolves against the root font-size":
    it "AC-1: width in rem":
        step("Chrome 159: 2rem x 20px root = 40")
        expect(_box("a")).to_equal("0,0,40,5")

    it "AC-2: padding in rem":
        step("Chrome 159: 50 + 1rem (20) = 70")
        expect(_box("b")).to_equal("0,5,70,5")

    it "AC-3: font-size in rem feeds em":
        step("Chrome 159: font-size 1.5rem = 30, width 1em = 30")
        expect(_box("c")).to_equal("0,10,30,5")

    it "AC-4: margin in rem":
        step("Chrome 159: width 2.5rem = 50, margin-left 0.5rem = 10")
        expect(_box("d")).to_equal("10,15,50,5")
