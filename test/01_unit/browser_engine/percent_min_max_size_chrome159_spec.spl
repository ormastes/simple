"""
## Purpose and audience
Purpose: Pin percentage `min-width` / `max-width` / `min-height` /
`max-height`. The clamp slots were px-only: `max-width:50%` was read as 50 px
(and, after a later stop-gap, as `none`), so `img{max-width:100%}` never kept
an image inside its container and `max-width:50%` never halved a block.
Percentages now resolve against the containing block at layout time; in an
intrinsic (max-content) contribution they are `none`, and a percentage
height against an auto-height containing block is `none`, as in CSS 2.2
§10.4 / §10.7.
Audience: browser-engine layout maintainers.

Chrome oracle (Chrome 159.0.8154.6 headless shell, 900x4000, `<!doctype html>`,
`body{margin:0;font:16px/1.5 sans-serif}`, getBoundingClientRect, `w x h`).

| markup                                                                  | element    |
|-------------------------------------------------------------------------|------------|
| `<div style=width:400px><div style=max-width:50%>x</div></div>`          | 200 x 24   |
| `<div style=width:400px><div style=min-width:150%>x</div></div>`         | 600 x 24   |
| `<div style=width:100px><img width=300 height=50 style=max-width:100%>`  | 100 x 50   |
| `<div style=width:120px><input style=max-width:100%></div>`              | 128 x 21   |
| `<div style=width:400px><input style=min-width:50%></div>`               | 208 x 21   |
| `<table style=width:300px><tr><td><div style=max-width:50%>abc`          | 147 x 24 (td 296) |
| `<table><tr><td><div style=max-width:50%>abc def ghi` (auto table)       | 39.14 x 72 (td 80.28) |
| 400x200 block: child `max-height:50%;height:300px`                      | 400 x 100  |
| 400x200 block: child `min-height:50%`                                   | 400 x 100  |
| auto-height block: child `min-height:50%` / `max-height:10%` with text  | 400 x 24   |
"""

"""
Traceability: REQ-BROWSER-ENGINE-PERCENT-MIN-MAX-SIZE-001 — percentage min/max width and height resolve against the containing block, as Chrome 159 does.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_foundation.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_layout_by_id
}
use std.nogc_sync_mut.text_layout.font_provider.{browser_host_has_measured_linux_face_set}

val HEAD: text = "<!doctype html><html><head><style>body{margin:0;font:16px/1.5 sans-serif}</style></head><body>"
val TAIL: text = "</body></html>"
val GIF: text = "data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="

fn field(inner: text, id: text, name: text) -> i32:
    simple_web_layout_debug_layout_by_id(HEAD + inner + TAIL, 900, 600, id, name).to_int()

fn off(actual: i32, chrome: i32) -> i32:
    if actual > chrome: actual - chrome else: chrome - actual

describe "percentage min-width / max-width":
    it "AC-1: a block's max-width:50% halves it, min-width:150% widens it":
        step("Chrome 159: 200 x 24 and 600 x 24 inside a 400 px block")
        val half = "<div style=\"width:400px\"><div id=\"a\" style=\"max-width:50%\">x</div></div>"
        expect(field(half, "a", "w")).to_equal(200)
        expect(field(half, "a", "h")).to_equal(24)
        val wide = "<div style=\"width:400px\"><div id=\"a\" style=\"min-width:150%\">x</div></div>"
        expect(field(wide, "a", "w")).to_equal(600)

    it "AC-2: img{max-width:100%} keeps a wide image inside its container":
        step("Chrome 159: a 300x50 image in a 100 px block is 100 x 50")
        val page = "<div style=\"width:100px\"><img id=\"c\" width=\"300\" height=\"50\" style=\"max-width:100%\" src=\"" + GIF + "\"></div>"
        expect(field(page, "c", "w")).to_equal(100)
        expect(field(page, "c", "h")).to_equal(50)

    it "AC-3: a text input's percentage max-width / min-width":
        step("Chrome 159: max-width:100% in 120 px -> 128 (120 content + 8); min-width:50% in 400 px -> 208")
        val capped = "<div style=\"width:120px\"><input id=\"d\" style=\"max-width:100%\"></div>"
        expect(field(capped, "d", "w")).to_equal(128)
        val floored = "<div style=\"width:400px\"><input id=\"d\" style=\"min-width:50%\"></div>"
        expect(field(floored, "d", "w")).to_equal(208)

    it "AC-4: inside a table cell the percentage is of the cell's content box":
        step("Chrome 159: fixed 300 px table -> td 296, child 147")
        val fixed = "<table style=\"width:300px\"><tr><td id=\"t\"><div id=\"e\" style=\"max-width:50%\">abc</div></td></tr></table>"
        expect(field(fixed, "t", "w")).to_equal(296)
        expect(field(fixed, "e", "w")).to_equal(147)
        step("Chrome 159: auto table -> the percentage is `none` for the column (td 80.28), then halves the child (39.14 x 72)")
        val auto_table = "<table><tr><td id=\"t\"><div id=\"e\" style=\"max-width:50%\">abc def ghi</div></td></tr></table>"
        expect(field(auto_table, "e", "h")).to_equal(72)
        if browser_host_has_measured_linux_face_set():
            expect(off(field(auto_table, "t", "w"), 80)).to_be_less_than(2)
        if browser_host_has_measured_linux_face_set():
            expect(off(field(auto_table, "e", "w"), 39)).to_be_less_than(2)

describe "percentage min-height / max-height":
    it "AC-5: against a definite height they resolve":
        step("Chrome 159: in a 400x200 block, max-height:50% caps height:300px at 100; min-height:50% raises an empty block to 100")
        val page = "<div style=\"width:400px;height:200px\"><div id=\"g\" style=\"max-height:50%;height:300px\"></div><div id=\"g2\" style=\"min-height:50%\"></div></div>"
        expect(field(page, "g", "h")).to_equal(100)
        expect(field(page, "g2", "h")).to_equal(100)
        expect(field(page, "g2", "y")).to_equal(100)

    it "AC-6: against an auto height they are none":
        step("Chrome 159: min-height:50% / max-height:10% in an auto-height block leave one 24 px line")
        val page = "<div style=\"width:400px\"><div id=\"h\" style=\"min-height:50%\">x</div><div id=\"h2\" style=\"max-height:10%\">x</div></div>"
        expect(field(page, "h", "h")).to_equal(24)
        expect(field(page, "h2", "h")).to_equal(24)
        expect(field(page, "h2", "y")).to_equal(24)
