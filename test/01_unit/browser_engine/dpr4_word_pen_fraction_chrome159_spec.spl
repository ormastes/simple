"""
## Purpose and audience
Purpose: Pin where each WORD of a text run starts at device scale 4, against
Chrome 159. Chrome lays a line out in fractional units and keeps the fraction
at paint: in `a b c d e f g h` (16px Liberation Sans, left edge 10) the words
start at 10, 23.344, 36.688, 49.133 .. CSS px, which is device px 40, 93.4,
146.8, 196.5 at scale 4. This engine starts every word on a whole CSS px (a
multiple of 4 device px), so a word sits up to 2 device px left or right of
Chrome's. Catalog css-layout at 4x: the best per-word horizontal shift
recovers about 26k of the 170k mismatched text px (7.5% of the page mismatch);
51 of 117 word clusters want a shift of 1 to 3 device px.
Audience: web renderer text layout / Draw IR device-scale maintainers
(layout_text, layout_foundation pen origin, draw_ir text at device scale).

Chrome oracle (Chrome for Testing 159.0.8154.6 aarch64, `--headless=new
--disable-gpu --hide-scrollbars --force-device-scale-factor=4
--window-size=500,300`, the page below). Word `Range.getBoundingClientRect()`
left, CSS px: line 1 `b` 23.344, `c` 36.688; line 2 `—` 22.445, `y` 42.891;
line 3 `y` 30.445.

Measured from the screenshot, device px: first column holding a pixel with
red < 128, searched from the given column inside the line's 96-row band.

| word            | band rows | search from | Chrome | base (ecff7320c13) |
|-----------------|-----------|-------------|--------|--------------------|
| `b` in line 1   | 0..96     | 80          | 98     | 96                 |
| `c` in line 1   | 0..96     | 135         | 150    | 151                |
| `—` in line 2   | 96..192   | 78          | 90     | 88                 |
| `y` in line 2   | 96..192   | 160         | 172    | 172                |
| `y` in line 3   | 192..288  | 110         | 122    | 120                |

Base matches a whole CSS px pen: `b` 23 (Chrome 23.344), `—` 22 (22.445),
`y` 30 (30.445). The tolerance is 1 device px: glyph edges differ by up to one
antialiased column between the two rasterisers.
"""

"""
Traceability: REQ-WEB-DPR4-WORD-PEN-001 — at device scale k>1 a word starts at Chrome's fractional pen position, not on a whole CSS px.
"""
# @tag: unit, browser_engine, text, device_scale, chrome159
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_text.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}

val CSS_W: i32 = 500
val CSS_H: i32 = 150

val PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff;color:#000;font:16px/1.5 'Liberation Sans'}} p{{margin:0 0 0 10px}} div{{margin:0 0 0 10px;width:200px}}</style></head><body>" +
    "<p>a b c d e f g h</p><p>x — y</p><p>— y</p>" +
    "<div><code>ab</code> plain words here that wrap onto a second line</div><p>tail</p></body></html>"

val PAGE_IIII: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff;color:#000;font:16px/1.5 'Liberation Sans'}} p{{margin:0 0 0 10px}}</style></head><body><p>iiii</p><p style=\"letter-spacing:1.37px\">iiii</p></body></html>"

val PAGE_12: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff;color:#000;font:12px/1.5 'Liberation Sans'}} p{{margin:0 0 0 10px}}</style></head><body><p>Sphinx of black quartz, judge my vow</p></body></html>"

val PAGE_LONG: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff;color:#000;font:16px/1.5 'Liberation Sans'}} p{{margin:0 0 0 10px;white-space:nowrap}}</style></head><body>" +
    "<p>Sphinx of black quartz, judge my vow and pack my box with five</p></body></html>"

fn _red(px: u32) -> i32:
    ((px >> 16u32) & 0xFFu32) as i32

# First device column from x0 that holds ink (red < 128) in rows y0..y0+96.
fn _first_ink_col(px: [u32], x0: i32, y0: i32) -> i32:
    val w = CSS_W * 4
    if px.len() != (w * CSS_H * 4) as i64:
        return -2
    var x = x0
    while x < x0 + 80:
        var y = y0
        while y < y0 + 96:
            if _red(px[y * w + x]) < 128:
                return x
            y = y + 1
        x = x + 1
    -1

# Device columns in 0..x_end where ink (red < 128) begins after a blank
# column, rows y0..y1: one entry per separated glyph.
fn _ink_starts(px: [u32], x_end: i32, y0: i32, y1: i32) -> [i32]:
    val w = CSS_W * 4
    var out: [i32] = []
    var prev = false
    var x = 0
    while x < x_end:
        var ink = false
        var y = y0
        while y < y1 and not ink:
            if _red(px[y * w + x]) < 128:
                ink = true
            y = y + 1
        if ink and not prev:
            out.push(x)
        prev = ink
        x = x + 1
    out

fn _near(got: i32, chrome: i32) -> bool:
    got >= chrome - 1 and got <= chrome + 1

describe "Words start at Chrome's fractional pen at device scale 4 (Chrome 159)":
    it "AC-1: `b` and `c` of `a b c ..` start at device columns 98 and 150":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, 4, "cpu_simd")
        expect(_near(_first_ink_col(px, 80, 0), 98)).to_equal(true)
        expect(_near(_first_ink_col(px, 135, 0), 150)).to_equal(true)

    it "AC-2: the em dash of `x — y` starts at device column 90 and `y` at 172":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, 4, "cpu_simd")
        expect(_near(_first_ink_col(px, 78, 96), 90)).to_equal(true)
        expect(_near(_first_ink_col(px, 160, 96), 172)).to_equal(true)

    it "AC-3: `y` of `— y` starts at device column 122":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, 4, "cpu_simd")
        expect(_near(_first_ink_col(px, 110, 192), 122)).to_equal(true)

    # A whole sentence on one line: a per-glyph pen model that drifts shows
    # here, not on a short line. Chrome word starts (Range left, CSS px):
    # Sphinx 10.000, of 63.367, black 81.156, quartz, 122.953, judge 176.313,
    # my 219.906, vow 245.680, and 278.578, pack 309.719, my 347.961,
    # box 373.734, with 403.977, five 436.875. First ink column (device px)
    # searched from floor(4 x left) - 6 in rows 0..96.
    it "AC-4: every word of a full-width sentence starts at Chrome's device column":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE_LONG, CSS_W, CSS_H, 4, "cpu_simd")
        val from: [i32] = [34, 247, 318, 485, 699, 873, 976, 1108, 1232, 1385, 1488, 1609, 1741]
        val chrome: [i32] = [43, 256, 329, 494, 704, 884, 983, 1117, 1243, 1396, 1499, 1616, 1748]
        var got = ""
        var want = ""
        var i = 0
        while i < from.len():
            val col = _first_ink_col(px, from[i], 0)
            got = got + (if _near(col, chrome[i]): chrome[i].to_text() else: col.to_text()) + " "
            want = want + chrome[i].to_text() + " "
            i = i + 1
        expect(got).to_equal(want)

    # A run laid out mid-line after fractional-width inline content starts at
    # a fractional pen too: `<code>ab</code>` ends at 29.266 CSS px, so the
    # run's words start at plain 33.711, words 71.961, here 119.086,
    # that 155.555 (Range left, CSS px). The run's command sits on a whole CSS
    # px and carries the rest as `pen-origin-milli`, which must scale by k.
    it "AC-5: the words of a mid-line run after `<code>` start at Chrome's device columns":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, 4, "cpu_simd")
        val from: [i32] = [128, 278, 470, 616]
        val chrome: [i32] = [139, 288, 481, 623]
        var got = ""
        var want = ""
        var i = 0
        while i < from.len():
            val col = _first_ink_col(px, from[i], 288)
            got = got + (if _near(col, chrome[i]): chrome[i].to_text() else: col.to_text()) + " "
            want = want + chrome[i].to_text() + " "
            i = i + 1
        expect(got).to_equal(want)

    # Per-glyph pens inside one run (from the spacing lane): `iiii` at 16 px,
    # plain and with letter-spacing 1.37px. Chrome glyph ink starts (device
    # px, columns where ink begins after a blank column, rows 0..96 / 96..192):
    # 44 59 73 87 and 44 64 84 103. Base (ccb5a2ef29c) draws 44 60 72 88 and
    # 44 64 84 104 — already within 1 px — so this pins, not a red-to-green.
    it "AC-6: each glyph of `iiii` (plain and letter-spacing 1.37px) starts within 1 device px of Chrome":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE_IIII, CSS_W, CSS_H, 4, "cpu_simd")
        val chrome: [i32] = [44, 59, 73, 87, 44, 64, 84, 103]
        var got = ""
        var want = ""
        var i = 0
        while i < chrome.len():
            val col = _first_ink_col(px, chrome[i] - 3, if i < 4: 0 else: 96)
            got = got + (if _near(col, chrome[i]): chrome[i].to_text() else: col.to_text()) + " "
            want = want + chrome[i].to_text() + " "
            i = i + 1
        expect(got).to_equal(want)

    # 12 px text at k=4 is 48 device px, exactly the LCD size cutoff
    # (FONT_LCD_MAX_SIZE_PX), so the device advances reach the LCD pen-phase
    # path. Chrome glyph-ink starts (device px, rows 0..72, a column where ink
    # begins after a blank one) of `Sphinx of black quartz, judge my vow`:
    # 43 75 102 129 140 164 202 228 257 284 293 320 345 381. Base (cc26757109c)
    # draws 104 for 102 and 255 for 257 and merges the 320 glyph into its
    # neighbour.
    it "AC-7: 12 px text at k=4 (the LCD size cutoff) keeps Chrome's glyph pens":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE_12, CSS_W, CSS_H, 4, "cpu_simd")
        val chrome: [i32] = [43, 75, 102, 129, 140, 164, 202, 228, 257, 284, 293, 320, 345, 381]
        val starts = _ink_starts(px, 400, 0, 72)
        var got = ""
        var want = ""
        var i = 0
        while i < chrome.len():
            val col = if i < starts.len(): starts[i] else: -1
            got = got + (if _near(col, chrome[i]): chrome[i].to_text() else: col.to_text()) + " "
            want = want + chrome[i].to_text() + " "
            i = i + 1
        expect(got).to_equal(want)
        expect(starts.len()).to_equal(chrome.len())
