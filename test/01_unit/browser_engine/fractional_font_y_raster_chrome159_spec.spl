"""
## Purpose and audience
Purpose: pin the vertical raster of fractional font sizes against Chrome 159.
FreeType's light autohinter scales an outline at the FLOAT size and fits the
x-height to the pixel grid from there; only its 6..14 ppem x-height rule reads
the whole ppem. Simple built the y hint knots from the whole `size_px`, so a
fractional size drew its rows at the rounded size: DejaVu Sans Mono at the UA
13.3333 px (textarea, `<small>`) had 9-row caps where Chrome draws 10, and
21.3333 px sans started one row low. The knots and their cache key now take the
milli size; whole sizes are unchanged.
Audience: text raster and browser-engine maintainers.

Chrome oracle (Chrome 159.0.8154.6 headless, 1x, 400x300 window, page `FF_PAGE`,
host fonts DejaVu Sans / DejaVu Sans Mono). Ink rows = first..last row holding a
pixel with mean channel < 128, per 30 px band:

| band | font                    | Chrome ink rows | base (cpu_simd) |
|------|-------------------------|-----------------|-----------------|
| 0    | 13.3333px monospace     | 2..11           | 3..11           |
| 1    | bold 18.72px sans-serif | 34..46          | 34..46          |
| 2    | 14.4px sans-serif       | 63..72          | 63..72          |
| 3    | 21.3333px sans-serif    | 94..108         | 95..108         |
| 4    | 10.6667px sans-serif    | 132..139        | 132..139        |
| 5    | 13px monospace          | 153..161        | 153..161        |
| 6    | 16px sans-serif         | 172..183        | 172..183        |
| 7    | 18.72px sans-serif      | 204..216        | 204..216        |
| 8    | bold 19px sans-serif    | 234..246        | 234..246        |

Bands 5, 6 and 8 are whole sizes and must not move on cpu_simd or vulkan. The
software `raster` lane (AC-3) draws gray coverage from the same hinted outline.
"""

"""
Traceability: REQ-BROWSER-ENGINE-FRACTIONAL-FONT-SIZE-001 -- fractional computed font sizes keep their fraction in the vertical glyph raster.
"""
# @cover src/lib/common/encoding/sfnt_glyf.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{simple_web_render_html_to_pixels_with_resolved_engine2d_backend}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{simple_web_layout_render_html_software_pixels}

val FF_W: i32 = 400
val FF_H: i32 = 260
val FF_PAGE: text = "<!DOCTYPE html><html><body style=\"margin:0;background:#fff;color:#000\"><div style=\"position:absolute;left:4px;top:0px;font:13.3333px monospace\">HEHEHE xox</div><div style=\"position:absolute;left:4px;top:30px;font:bold 18.72px sans-serif\">HEHEHE xox</div><div style=\"position:absolute;left:4px;top:60px;font:14.4px sans-serif\">HEHEHE xox</div><div style=\"position:absolute;left:4px;top:90px;font:21.3333px sans-serif\">HEHEHE xox</div><div style=\"position:absolute;left:4px;top:130px;font:10.6667px sans-serif\">HEHEHE xox</div><div style=\"position:absolute;left:4px;top:150px;font:13px monospace\">HEHEHE xox</div><div style=\"position:absolute;left:4px;top:170px;font:16px sans-serif\">HEHEHE xox</div><div style=\"position:absolute;left:4px;top:200px;font:18.72px sans-serif\">HEHEHE xox</div><div style=\"position:absolute;left:4px;top:230px;font:bold 19px sans-serif\">HEHEHE xox</div></body></html>"
val FF_BANDS: [i32] = [0, 30, 60, 90, 130, 150, 170, 200, 230, 260]
# Chrome 159 first,last ink row per band (see the table above).
val FF_CHROME: [i32] = [2, 11, 34, 46, 63, 72, 94, 108, 132, 139, 153, 161, 172, 183, 204, 216, 234, 246]

fn ff_dark(p: u32) -> bool:
    val r = ((p >> 16) & 255u32) as i32
    val g = ((p >> 8) & 255u32) as i32
    val b = (p & 255u32) as i32
    (r + g + b) / 3 < 128

fn ff_mismatches(px: [u32], lane: text) -> i32:
    if px.len() != FF_W * FF_H:
        print "{lane}: frame {px.len()} px"
        return 99
    var bad = 0
    var i = 0
    while i + 1 < FF_BANDS.len():
        var first = -1
        var last = -1
        var y = FF_BANDS[i]
        while y < FF_BANDS[i + 1]:
            var x = 0
            while x < FF_W:
                if ff_dark(px[y * FF_W + x]):
                    if first < 0: first = y
                    last = y
                x = x + 1
            y = y + 1
        if first != FF_CHROME[i * 2] or last != FF_CHROME[i * 2 + 1]:
            print "{lane} band{i}: ink rows {first}..{last}, Chrome {FF_CHROME[i * 2]}..{FF_CHROME[i * 2 + 1]}"
            bad = bad + 1
        i = i + 1
    bad

describe "fractional font size vertical raster (Chrome 159)":
    it "AC-1: cpu_simd ink rows match Chrome for fractional and whole sizes":
        step("13.3333px mono caps are 10 rows (2..11); 21.3333px sans starts at 94; whole sizes unchanged")
        expect(ff_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(FF_PAGE, FF_W, FF_H, "cpu_simd"), "cpu_simd")).to_equal(0)

    it "AC-2: vulkan ink rows match Chrome for fractional and whole sizes":
        step("the Vulkan lane shares the LCD glyph outline, so it carries the same rows")
        expect(ff_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(FF_PAGE, FF_W, FF_H, "vulkan"), "vulkan")).to_equal(0)

    it "AC-3: software raster ink rows match Chrome for fractional and whole sizes":
        step("the raster lane draws gray glyphs from the same hinted outline; base drew unhinted rows (0: 3..11, 3: 96..109, 4: 133..139, 6: 173..183)")
        expect(ff_mismatches(simple_web_layout_render_html_software_pixels(FF_PAGE, FF_W, FF_H), "raster")).to_equal(0)
