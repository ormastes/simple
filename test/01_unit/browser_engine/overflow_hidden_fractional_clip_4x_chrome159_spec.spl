"""
## Purpose and audience
Purpose: pin Chrome 159's 4x (384 dpi) clip of an `overflow:hidden` box whose
CSS size is fractional, so the device-px clip edge of a non-textarea box has an
oracle. Audience: maintainers of block layout fractional sizes and the
device-px clip edges (`_html_draw_ir_device_clip`).

Chrome oracle (Chrome for Testing 159.0.8154.6 aarch64, `--headless=new
--disable-gpu --hide-scrollbars --force-device-scale-factor=4`, window
400x300): `.o{margin:10px 0 0 10px;width:100.25px;height:10.5px;
overflow:hidden;background:#dde}` holding a 40px `#c00` child. The child is
clipped at device row 82 and column 441 (k x 10.5 = 42 rows from top 40,
k x 100.25 = 401 columns from left 40): rows 80-81 and column 440 are
(204,0,0), row 82 and column 441 are white.
"""

"""
Traceability: REQ-WEB-FORM-CONTROL-TEXT-PEN-001 -- device-px clip edge of a fractional overflow box.
"""
# @tag: unit, browser_engine, chrome159
# Tracks: overflow_hidden_fractional_clip_4x_drops_fraction_2026-11-27
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}

val K: i32 = 4
val STRIDE: i32 = 400 * 4

val PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff}} .o{{margin:10px 0 0 10px;width:100.25px;height:10.5px;overflow:hidden;background:#dde}} .c{{height:40px;background:#c00}}</style></head><body><div class=\"o\"><div class=\"c\"></div></div></body></html>"
val SHORT_CHILD_PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff}} .o{{margin:10px 0 0 10px;width:100.25px;height:10.5px;overflow:hidden;background:#dde}} .c{{height:5px;background:#c00}}</style></head><body><div class=\"o\"><div class=\"c\"></div></div></body></html>"
val NESTED_PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff}} .outer{{margin:10px 0 0 10px;width:100.25px;height:10.25px;overflow:hidden;background:#dde}} .inner{{width:100.75px;height:10.75px;overflow:hidden}} .c{{height:40px;background:#c00}}</style></head><body><div class=\"outer\"><div class=\"inner\"><div class=\"c\"></div></div></div></body></html>"
val INT_PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff}} .o{{margin:10px 0 0 10px;width:100px;height:10px;overflow:hidden;background:#dde}} .c{{height:40px;background:#c00}}</style></head><body><div class=\"o\"><div class=\"c\"></div></div></body></html>"

fn _px_s(px: [u32], stride: i32, x: i32, y: i32) -> text:
    val p = px[y * stride + x]
    "({(p >> 16u32) & 255u32},{(p >> 8u32) & 255u32},{p & 255u32})"

fn _px(px: [u32], x: i32, y: i32) -> text:
    _px_s(px, STRIDE, x, y)

describe "overflow:hidden box of fractional size at 4x (Chrome 159)":
    it "AC-1: clips its child at the device-px box edge":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, 400, 300, K, "cpu_simd")
        val got = "r81c240={_px(px, 240, 81)} r82c240={_px(px, 240, 82)} r75c440={_px(px, 440, 75)} r75c441={_px(px, 441, 75)}"
        expect(got).to_equal("r81c240=(204,0,0) r82c240=(255,255,255) r75c440=(204,0,0) r75c441=(255,255,255)")

    it "AC-2: paints the fractional box's own background to the snapped device-px edge when child is shorter":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(SHORT_CHILD_PAGE, 400, 300, K, "cpu_simd")
        val got = "r81c240={_px(px, 240, 81)} r82c240={_px(px, 240, 82)} r75c440={_px(px, 440, 75)} r75c441={_px(px, 441, 75)}"
        expect(got).to_equal("r81c240=(221,221,238) r82c240=(255,255,255) r75c440=(221,221,238) r75c441=(255,255,255)")

    it "AC-3: clamps a nested wider/taller fractional overflow:hidden child to the enclosing clip's device edge":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(NESTED_PAGE, 400, 300, K, "cpu_simd")
        val got = "r80c240={_px(px, 240, 80)} r81c240={_px(px, 240, 81)} r75c440={_px(px, 440, 75)} r75c441={_px(px, 441, 75)}"
        expect(got).to_equal("r80c240=(204,0,0) r81c240=(255,255,255) r75c440=(204,0,0) r75c441=(255,255,255)")

    it "AC-4 (guard): integer-sized overflow:hidden at 4x and 1x scale stay on exact CSS edges":
        val px4 = simple_web_layout_render_html_pixels_engine2d_at_device_scale(INT_PAGE, 400, 300, K, "cpu_simd")
        val px1 = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, 400, 300, 1, "cpu_simd")
        val got4 = "r79c240={_px(px4, 240, 79)} r80c240={_px(px4, 240, 80)} r75c439={_px(px4, 439, 75)} r75c440={_px(px4, 440, 75)}"
        val got1 = "r19c60={_px_s(px1, 400, 60, 19)} r20c60={_px_s(px1, 400, 60, 20)} r15c109={_px_s(px1, 400, 109, 15)} r15c110={_px_s(px1, 400, 110, 15)}"
        expect(got4).to_equal("r79c240=(204,0,0) r80c240=(255,255,255) r75c439=(204,0,0) r75c440=(255,255,255)")
        expect(got1).to_equal("r19c60=(204,0,0) r20c60=(255,255,255) r15c109=(204,0,0) r15c110=(255,255,255)")
