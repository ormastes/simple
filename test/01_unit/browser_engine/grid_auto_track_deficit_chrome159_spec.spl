# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
"""
# `auto` grid columns under a space deficit (Chrome 159)

Follow-up to web_grid_auto_track_takes_full_width_with_flex_item_2026-11-27.
CSS Grid 12.4-12.7: an `auto` track starts at its items' min-content and grows
toward max-content only with free space, shared equally. A bare `Nfr` track
(`minmax(auto, Nfr)`) is floored at its items' min-content; `minmax(0, Nfr)`
is floored at 0. Without an `fr` track the `auto` tracks share what is left,
but only under `justify-content: normal | stretch`.

Page: each case is a `.w` grid 60px tall (two 30px lines, overflow hidden),
margin-left 40px, 200px wide. Blue "words" are 30x20 inline-blocks with no
white space between them (a break opportunity on both sides), red items are
not measured. The run is measured through CSS row `slot * 30 + 10`; slot 2c is
line 1 of case c, slot 2c+1 is line 2.

| case | template / items | k=1 Chrome line 1 / line 2 | head before (k=1) |
|------|------------------|----------------------------|-------------------|
| 0 | `minmax(0, 1fr) auto`; red 30px, 8 blue words | 40..219 / 40..99 | 40..239 / none |
| 1 | `1fr auto`; red 120px unbroken, 8 words | 160..219 / 160..219 | 40..239 / none |
| 2 | `minmax(0, 1fr) auto`; red 120px unbroken, 8 words | 40..219 / 40..99 | 40..239 / none |
| 3 | `1fr auto`; red 30px, blue 240px unbroken | 70..239 / none | 40..239 / none |
| 4 | `auto auto`; 8 words each | 40..129 140..229 (both lines) | 40..239 / none |
| 5 | `100px auto`; empty, 8 words | 140..229 (both lines) | 140..239 / none |
| 6 | `auto auto`, justify-content:start; 2 words each | 40..159 / none | 40..99 140..199 / none |
| 7 | `auto 1fr` control; 2 words, red 30px | 40..99 / none | 40..99 / none |
| 8 | `1fr auto`; red 120px in a min-width:0 item, 8 words | 40..219 / 40..99 | 160..219 (both lines) |
| 9 | `1fr auto`; red 120px in an overflow:hidden item, 8 words | 40..219 / 40..99 | 160..219 (both lines) |
| 10 | `1fr auto`; red 120px in a min-width:50px item, 8 words | 90..239 / 90..179 | 160..219 (both lines) |
| 11 | `auto 1fr`; 8 words in a min-width:0 item | 40..219 / 40..99 | 40..219 / 40..99 |
"""

"""
Traceability: web_grid_auto_track_takes_full_width_with_flex_item_2026-11-27 — auto tracks shrink toward min-content under a deficit, bare fr tracks keep their content floor, and auto stretch follows justify-content.
"""
# @tag: unit, browser_engine, layout, grid, chrome159
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_engine.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{
    simple_web_render_html_to_pixels_with_engine2d_backend
}
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}

val CSS_W: i32 = 400
val CSS_H: i32 = 760
val PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff}}.w{{margin-left:40px;width:200px;height:60px;display:grid;overflow:hidden;font-size:0;line-height:30px}}</style></head><body><div class=\"w\" style=\"grid-template-columns:minmax(0, 1fr) auto\"><div><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#f00\"></span></div><div><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span></div></div><div class=\"w\" style=\"grid-template-columns:1fr auto\"><div><span style=\"display:inline-block;vertical-align:top;width:120px;height:20px;background:#f00\"></span></div><div><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span></div></div><div class=\"w\" style=\"grid-template-columns:minmax(0, 1fr) auto\"><div><span style=\"display:inline-block;vertical-align:top;width:120px;height:20px;background:#f00\"></span></div><div><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span></div></div><div class=\"w\" style=\"grid-template-columns:1fr auto\"><div><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#f00\"></span></div><div><span style=\"display:inline-block;vertical-align:top;width:240px;height:20px;background:#00f\"></span></div></div><div class=\"w\" style=\"grid-template-columns:auto auto\"><div><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span></div><div><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span></div></div><div class=\"w\" style=\"grid-template-columns:100px auto\"><div></div><div><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span></div></div><div class=\"w\" style=\"grid-template-columns:auto auto;justify-content:start\"><div><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span></div><div><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span></div></div><div class=\"w\" style=\"grid-template-columns:auto 1fr\"><div><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span></div><div><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#f00\"></span></div></div><div class=\"w\" style=\"grid-template-columns:1fr auto\"><div style=\"min-width:0\"><span style=\"display:inline-block;vertical-align:top;width:120px;height:20px;background:#f00\"></span></div><div><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span></div></div><div class=\"w\" style=\"grid-template-columns:1fr auto\"><div style=\"overflow:hidden\"><span style=\"display:inline-block;vertical-align:top;width:120px;height:20px;background:#f00\"></span></div><div><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span></div></div><div class=\"w\" style=\"grid-template-columns:1fr auto\"><div style=\"min-width:50px\"><span style=\"display:inline-block;vertical-align:top;width:120px;height:20px;background:#f00\"></span></div><div><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span></div></div><div class=\"w\" style=\"grid-template-columns:auto 1fr\"><div style=\"min-width:0\"><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span><span style=\"display:inline-block;vertical-align:top;width:30px;height:20px;background:#00f\"></span></div><div></div></div></body></html>"
var g_px1: [u32] = []
var g_px4: [u32] = []

fn _px(k: i32) -> [u32]:
    if k == 1:
        if g_px1.len() == 0:
            g_px1 = simple_web_render_html_to_pixels_with_engine2d_backend(PAGE, CSS_W, CSS_H, "cpu_simd")
        return g_px1
    if g_px4.len() == 0:
        g_px4 = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, k, "cpu_simd")
    g_px4

# Blue runs " a..b" on the device row through CSS row `row * 30 + 10`.
fn _runs(k: i32, row: i32) -> text:
    val px = _px(k)
    val w = CSS_W * k
    val y = (row * 30 + 10) * k
    var out = ""
    var x = 0
    var inr = false
    var start = 0
    while x <= w:
        var blue = false
        if x < w:
            val v = px[y * w + x]
            val r = ((v >> 16u32) & 0xFFu32).to_i32()
            val b = (v & 0xFFu32).to_i32()
            blue = b > 128 and r < 128
        if blue and not inr:
            inr = true
            start = x
        if not blue and inr:
            inr = false
            out = out + " {start}..{x - 1}"
        x = x + 1
    out

fn _both(row: i32, r1: text, r4: text):
    expect(_runs(1, row)).to_equal(r1)
    expect(_runs(4, row)).to_equal(r4)

describe "auto grid columns under a space deficit (Chrome 159)":
    it "AC-1: an auto track beside minmax(0, 1fr) shrinks to the container and wraps":
        _both(0, " 40..219", " 160..879")
        _both(1, " 40..99", " 160..399")
        _both(4, " 40..219", " 160..879")
        _both(5, " 40..99", " 160..399")

    it "AC-2: a bare 1fr track keeps its min-content floor; the auto track takes the rest":
        _both(2, " 160..219", " 640..879")
        _both(3, " 160..219", " 640..879")

    it "AC-3: an auto track never goes below its min-content":
        _both(6, " 70..239", " 280..959")
        _both(7, "", "")

    it "AC-4: auto tracks share a deficit equally from their min-content":
        _both(8, " 40..129 140..229", " 160..519 560..919")
        _both(9, " 40..129 140..229", " 160..519 560..919")
        _both(10, " 140..229", " 560..919")
        _both(11, " 140..229", " 560..919")

    it "AC-5: justify-content:start leaves auto tracks at their content":
        _both(12, " 40..159", " 160..639")
        _both(13, "", "")

    it "AC-6: control: auto 1fr with room is unchanged":
        _both(14, " 40..99", " 160..399")
        _both(15, "", "")

    it "AC-7: a fr item with min-width:0 or overflow:hidden has no content floor (CSS Grid 6.6)":
        _both(16, " 40..219", " 160..879")
        _both(17, " 40..99", " 160..399")
        _both(18, " 40..219", " 160..879")
        _both(19, " 40..99", " 160..399")

    it "AC-8: a declared min-width replaces the content floor":
        _both(20, " 90..239", " 360..959")
        _both(21, " 90..179", " 360..719")
        _both(22, " 40..219", " 160..879")
        _both(23, " 40..99", " 160..399")
