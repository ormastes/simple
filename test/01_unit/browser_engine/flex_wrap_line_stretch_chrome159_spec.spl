"""
## Purpose and audience
Purpose: Pin cross-axis sizing of items on a wrapped flex line. The wrap
branch placed the lines at their stretched positions (align-content
stretch) but laid every auto-height item out at its content height, so the
items stayed 24 tall inside 45-tall lines -- 21 combo-matrix ids
(`cc-fx-fw-wrap-*`).
Audience: browser-engine flex layout maintainers.

Chrome oracle (Chrome 159.0.8154.6, full browser, `getBoundingClientRect()`
of PAGE at 900 px wide): `#w` 300x90 `flex-wrap:wrap`, three 120 px items:
`a` 0,0,120,45; `t` 120,0,120,45; `b` 0,45,120,45. `#e` (top 90) with
`align-self:flex-end` on `et`: `ea` 0,90,120,45; `et` 120,111,120,24; `eb`
0,135,120,45. `#n` (top 180) auto height, `na` holds two lines: `na`
0,180,120,48; `nt` 120,180,120,48 (stretched to the line); `nb`
0,228,120,24; `#n` 72 tall.
"""

"""
Traceability: REQ-BROWSER-ENGINE-FLEX-WRAP-LINE-STRETCH-001 — items on a wrapped flex line take the line's cross size (align-self stretch) or align inside it, as Chrome 159.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_engine.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_geometry.{simple_web_layout_debug_layout_by_id}

val PAGE: text = "<!doctype html><html><head><style>body{{margin:0;font:16px/24px sans-serif}}.f{{display:flex;width:300px;height:90px;flex-wrap:wrap}}.j{{width:120px}}</style></head><body><div id=w class=f><div id=a class=j>aa</div><div id=t class=j>cd</div><div id=b class=j>bb</div></div><div id=e class=f><div id=ea class=j>aa</div><div id=et class=j style=\"align-self:flex-end\">cd</div><div id=eb class=j>bb</div></div><div id=n style=\"display:flex;flex-wrap:wrap;width:300px\"><div id=na class=j>aa<br>bb</div><div id=nt class=j>cd</div><div id=nb class=j>bb</div></div></body></html>"

fn geom(id: text) -> text:
    val x = simple_web_layout_debug_layout_by_id(PAGE, 900, 400, id, "x")
    val y = simple_web_layout_debug_layout_by_id(PAGE, 900, 400, id, "y")
    val w = simple_web_layout_debug_layout_by_id(PAGE, 900, 400, id, "w")
    val h = simple_web_layout_debug_layout_by_id(PAGE, 900, 400, id, "h")
    "{x},{y},{w},{h}"

describe "flex-wrap: items take their line's cross size":
    it "AC-1: auto-height items stretch to the align-content stretched line":
        step("Chrome 159: a 0,0,120,45; t 120,0,120,45; b 0,45,120,45")
        expect(geom("a")).to_equal("0,0,120,45")
        expect(geom("t")).to_equal("120,0,120,45")
        expect(geom("b")).to_equal("0,45,120,45")

    it "AC-2: align-self:flex-end sits at the bottom of its line, others stretch":
        step("Chrome 159: ea 0,90,120,45; et 120,111,120,24; eb 0,135,120,45")
        expect(geom("ea")).to_equal("0,90,120,45")
        expect(geom("et")).to_equal("120,111,120,24")
        expect(geom("eb")).to_equal("0,135,120,45")

    it "AC-3: an auto-height wrap container stretches a short item to the tallest on its line":
        step("Chrome 159: na 0,180,120,48; nt 120,180,120,48; nb 0,228,120,24; n 72 tall")
        expect(geom("na")).to_equal("0,180,120,48")
        expect(geom("nt")).to_equal("120,180,120,48")
        expect(geom("nb")).to_equal("0,228,120,24")
        expect(geom("n")).to_equal("0,180,300,72")
