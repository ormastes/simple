"""
## Purpose and audience
Purpose: Pin the device-scale box of a plain inline element (its background).
Audience: web renderer inline layout / device-scale maintainers.

Chrome 159 at k=4 paints a span's background as the DEVICE content area:
Liberation Sans at 64 device px is 58 + 14 = 72 rows, hung from the device
baseline, not k x the CSS content area (4 x 17 = 68) from k x the CSS top.
Simple used to paint 152..219 / 255..322 here. It has matched since the
lineheight3 lane (#11895); measured green on origin 269d1b561bb, 2026-11-26.
The k=1 boxes are pinned by inline_element_used_font_line_box AC-5; AC-2 pins a
Latin-only span (Simple 120..187 before #11895, Chrome 121..192).

Chrome oracle: Chrome for Testing 159, `--force-device-scale-factor=4`, with the
same page and fonts as `inline_element_used_font_line_box_chrome159_spec.spl`.
"""
"""
Traceability: REQ-WEB-LINEBOX-USED-FONTS-001 (follow-up) — inline element boxes at device scale.
"""
# @tag: unit, browser_engine, layout, device_scale, chrome159
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}

val CSS_W: i32 = 400
val CSS_H: i32 = 300

val SPANBG: text = "<!doctype html><html lang=\"en\"><body style=\"margin:0;background:#fff;font:16px Liberation Sans;color:#000\"><div style=\"position:absolute;left:20px;top:30px;width:300px\"><div style=\"background:#f00\">Hx <span lang=ar style=\"background:#0ff\">مرحبا</span></div><div lang=hi style=\"background:#0f0\">x<span style=\"background:#0ff\">हिंदी</span></div><div lang=ar style=\"background:#00f\">Hx مرحبا</div></div></body></html>"
val LATSPAN: text = "<!doctype html><html lang=\"en\"><body style=\"margin:0;background:#fff;font:16px Liberation Sans;color:#000\"><div style=\"position:absolute;left:20px;top:30px;width:300px\"><div style=\"background:#f00\">Hx <span style=\"background:#0ff\">Hxgl</span></div></div></body></html>"

# First and last device row holding the span background (#0ff) in rows y0..y1.
fn _cyan_rows(px: [u32], k: i32, y0: i32, y1: i32) -> text:
    val w = CSS_W * k
    if px.len() != (w * CSS_H * k) as i64:
        return "empty frame"
    var i0 = -1
    var i1 = -1
    var y = y0
    while y <= y1:
        var x = 20 * k
        while x < 300 * k:
            if (px[y * w + x] & 0xFFFFFFu32) == 0x00FFFFu32:
                if i0 < 0: i0 = y
                i1 = y
            x = x + 1
        y = y + 1
    "{i0}..{i1}"

describe "device-scale box of a plain inline element against Chrome 159":
    it "AC-1: span backgrounds at k=4 are the device content area":
        step("Chrome k=4: Arabic span 150..221, Devanagari span 256..327 (72 rows each)")
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(SPANBG, CSS_W, CSS_H, 4, "cpu_simd")
        expect(_cyan_rows(px, 4, 120, 254) + " " + _cyan_rows(px, 4, 255, 339)).to_equal("150..221 256..327")

    it "AC-2: a Latin span background at k=4 is the device content area":
        step("Chrome k=4: `Hx <span>Hxgl</span>` background 121..192 (72 rows); Simple painted 120..187 before #11895")
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(LATSPAN, CSS_W, CSS_H, 4, "cpu_simd")
        expect(_cyan_rows(px, 4, 0, CSS_H * 4 - 1)).to_equal("121..192")
