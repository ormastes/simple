"""
## Purpose and audience
Purpose: Extend float_paint_stacking_order_chrome159_spec (REQ-WEB-001) to the
full CSS 2.1 Appendix E order inside one stacking context as
Chrome 159 paints it: every in-flow block background first, then each float
(with its own content, as one unit), then inline-level content. Simple painted
in tree order, so a block that follows a float in the source covered the
float, a later block's background covered earlier inline content, and a float
covered the inline content of an earlier block.
Audience: web renderer Draw IR paint order (`_html_draw_ir_node_paint_order`).

Chrome oracle: Chrome for Testing 159.0.8154.6 aarch64, `--headless=new
--disable-gpu --hide-scrollbars --force-device-scale-factor=K`, window
400x550 CSS px. Each case is its own 50px block. Floats are left, 100x20px,
`#aa0000` (R); in-flow blocks are `#00aa00` (G); the inline-level box is a
30x10px `vertical-align:top` inline-block, `#0000aa` (B); Y is `#aaaa00`,
W the white page. A cell lists the colour runs down one CSS column, as device
rows.

| case (block top CSS y) | column | Chrome k=4 | base k=4 |
|------|--------|-----------|----------|
| float, then a 10px block (0) | 50 | R 0..79 | G 0..39, R 40..79 |
| float, then a block with an inline-block and text (50) | 50 | R 200..279, G 280..295 | G 200..295 |
| same, the wrapped inline-block | 110 | B 200..239, G 240..295 | same |
| inline-block pulled over the float by a -60px margin (100) | 50 | B 400..439, R 440..479, G 480..519 | B 400..439, G 440..519 |
| block holding an inline-block, then a float pulled up 15px (150) | 25 | B 600..639, R 640..699 | B 600..619, R 620..699 |
| float inside a block, then that block's sibling (200) | 50 | R 800..879 | G 800..839, R 840..879 |
| 30px float holding a 50x10 block, then a 20px block (250) | 25 | Y 1000..1039, R 1040..1119 | G 1000..1079, R 1080..1119 |
| 20px inline-block in a 10px block, then a 20px block (300) | 25 | B 1200..1279, G 1280..1319 | B 1200..1239, G 1240..1319 |
| float and a block inside `opacity:0.5` (350) | 50 | `#d47e7e` 1400..1479 | `#7ed47e` 1400..1439, `#d47e7e` 1440..1479 |

| 20px `opacity:0.5` block, then a 20px Y block pulled up 10px (400) | 50 | `#7fd47f` 1600..1639, `#55aa00` 1640..1679, Y 1680..1719 | `#7fd47f` 1600..1639, Y 1640..1719 |

| grid: a 100px G item with text, then a Y item pulled 60px over it (450) | x 40..199, rows 0..19 of the case | all Y | text ink over Y |
| flex: the same two items (500) | x 40..139, rows 0..19 of the case | all Y | text ink over Y |

k=1 is the same table divided by 4. A grid or flex item paints as one unit,
like an inline-block, so the second item covers the first item's text; the
text left of the overlap stays (x 0..39: 2542 px not G at k=4, 326 at k=1 in
Chrome; pinned as > 0). An inline-block is not
a probe here: before this change it was a Step 4 block and already painted
under the later item. An opacity box is a layer: it paints
after the inline content of its stacking context, so over a later block.

A `display:block` button (100x40px, `#aa0000`, no padding or border) holding a
50x10px G block: Chrome paints the block over the button (column 20: R 0..14,
G 15..24, R 25..39 at k=1; R 0..59, G 60..99, R 100..159 at k=4).
"""

"""
Traceability: REQ-WEB-001 — block backgrounds, then floats, then inline content; inline-block, grid and flex items paint as one unit (CSS 2.1 Appendix E).
"""
# @tag: unit, browser_engine, device_scale, paint, float, chrome159
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_layout.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}

val CSS_W: i32 = 400
val CSS_H: i32 = 550

val PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff;font:16px/1.5 'Liberation Sans';color:#172033}}.b{{height:50px}}.f{{float:left;width:100px;height:20px;background:#aa0000}}.g{{background:#00aa00}}.i{{display:inline-block;vertical-align:top;width:30px;height:10px;background:#0000aa}}</style></head><body><div class=\"b\"><div class=\"f\"></div><div class=\"g\" style=\"height:10px\"></div></div><div class=\"b\"><div class=\"f\"></div><div class=\"g\"><i class=\"i\"></i> wrap</div></div><div class=\"b\"><div class=\"f\"></div><div class=\"g\" style=\"height:30px\"><i class=\"i\" style=\"margin-left:-60px\"></i></div></div><div class=\"b\"><div class=\"g\" style=\"height:20px\"><i class=\"i\" style=\"margin-left:20px\"></i></div><div class=\"f\" style=\"margin-top:-15px\"></div></div><div class=\"b\"><div><div class=\"f\"></div></div><div class=\"g\" style=\"height:10px\"></div></div><div class=\"b\"><div class=\"f\" style=\"height:30px\"><div style=\"width:50px;height:10px;background:#aaaa00\"></div></div><div class=\"g\" style=\"height:20px\"></div></div><div class=\"b\"><div style=\"height:10px\"><i class=\"i\" style=\"height:20px\"></i></div><div class=\"g\" style=\"height:20px\"></div></div><div class=\"b\"><div style=\"opacity:0.5\"><div class=\"f\"></div><div class=\"g\" style=\"height:10px\"></div></div></div><div class=\"b\"><div class=\"g\" style=\"opacity:0.5;height:20px\"></div><div style=\"height:20px;margin-top:-10px;background:#aaaa00\"></div></div><div class=\"b\"><div style=\"display:grid;grid-template-columns:100px 100px\"><div class=\"g\" style=\"height:20px\">HHHHHHH</div><div style=\"height:20px;margin-left:-60px;background:#aaaa00\"></div></div></div><div class=\"b\"><div style=\"display:flex\"><div class=\"g\" style=\"width:100px;height:20px\">HHHHHHH</div><div style=\"width:100px;height:20px;margin-left:-60px;background:#aaaa00\"></div></div></div></body></html>"

var g_px4: [u32] = []
var g_px1: [u32] = []

fn _px(k: i32) -> [u32]:
    if k == 4:
        if g_px4.len() == 0:
            g_px4 = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, 4, "cpu_simd")
        return g_px4
    if g_px1.len() == 0:
        g_px1 = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, 1, "cpu_simd")
    g_px1

fn _name(c: u32) -> text:
    val v = c & 0xFFFFFFu32
    if v == 0xFFFFFFu32: return "W"
    if v == 0xAA0000u32: return "R"
    if v == 0x00AA00u32: return "G"
    if v == 0x0000AAu32: return "B"
    if v == 0xAAAA00u32: return "Y"
    if v == 0xD47E7Eu32: return "r"
    if v == 0x7FD47Fu32: return "g"
    if v == 0x55AA00u32: return "m"
    "?"

# Colour runs down CSS column css_x of the 50px case `c`, as device rows.
fn _runs(k: i32, c: i32, css_x: i32) -> text:
    val px = _px(k)
    val w = CSS_W * k
    val x = css_x * k
    val y1 = (c * 50 + 50) * k
    var y = c * 50 * k
    var start = y
    var cur = _name(px[y * w + x])
    var out = ""
    y = y + 1
    while y < y1:
        val n = _name(px[y * w + x])
        if n != cur:
            out = out + "{cur}:{start}..{y - 1} "
            cur = n
            start = y
        y = y + 1
    out + "{cur}:{start}..{y - 1}"

# Pixels that are not `name` on CSS x0..x1-1, rows 0..19 of the 50px case `c`.
fn _non(k: i32, c: i32, x0: i32, x1: i32, name: text) -> i32:
    val px = _px(k)
    val w = CSS_W * k
    var n = 0
    var y = c * 50 * k
    while y < (c * 50 + 20) * k:
        var x = x0 * k
        while x < x1 * k:
            if _name(px[y * w + x]) != name:
                n = n + 1
            x = x + 1
        y = y + 1
    n

describe "Block backgrounds, then floats, then inline content (Chrome 159)":
    it "AC-1: k=4, a float covers the background of a later block":
        expect(_px(4).len()).to_equal((CSS_W * 4 * CSS_H * 4) as i64)
        expect(_runs(4, 0, 50)).to_equal("R:0..79 W:80..199")
        expect(_runs(4, 0, 200)).to_equal("G:0..39 W:40..199")

    it "AC-2: k=1, a float covers the background of a later block":
        expect(_runs(1, 0, 50)).to_equal("R:0..19 W:20..49")
        expect(_runs(1, 0, 200)).to_equal("G:0..9 W:10..49")

    it "AC-3: the later block's inline content still wraps to the right of the float":
        expect(_runs(4, 1, 50)).to_equal("R:200..279 G:280..295 W:296..399")
        expect(_runs(4, 1, 110)).to_equal("B:200..239 G:240..295 W:296..399")
        expect(_runs(1, 1, 50)).to_equal("R:50..69 G:70..73 W:74..99")
        expect(_runs(1, 1, 110)).to_equal("B:50..59 G:60..73 W:74..99")

    it "AC-4: inline content of a later block paints over the float":
        expect(_runs(4, 2, 50)).to_equal("B:400..439 R:440..479 G:480..519 W:520..599")
        expect(_runs(4, 2, 75)).to_equal("R:400..479 G:480..519 W:520..599")
        expect(_runs(1, 2, 50)).to_equal("B:100..109 R:110..119 G:120..129 W:130..149")
        expect(_runs(1, 2, 75)).to_equal("R:100..119 G:120..129 W:130..149")

    it "AC-5: inline content of an earlier block paints over a later float":
        expect(_runs(4, 3, 25)).to_equal("B:600..639 R:640..699 W:700..799")
        expect(_runs(4, 3, 50)).to_equal("G:600..619 R:620..699 W:700..799")
        expect(_runs(1, 3, 25)).to_equal("B:150..159 R:160..174 W:175..199")
        expect(_runs(1, 3, 50)).to_equal("G:150..154 R:155..174 W:175..199")

    it "AC-6: a float inside a block covers the background of that block's later sibling":
        expect(_runs(4, 4, 50)).to_equal("R:800..879 W:880..999")
        expect(_runs(1, 4, 50)).to_equal("R:200..219 W:220..249")

    it "AC-7: a float paints with its own content as one unit":
        expect(_runs(4, 5, 25)).to_equal("Y:1000..1039 R:1040..1119 W:1120..1199")
        expect(_runs(4, 5, 75)).to_equal("R:1000..1119 W:1120..1199")
        expect(_runs(4, 5, 110)).to_equal("G:1000..1079 W:1080..1199")
        expect(_runs(1, 5, 25)).to_equal("Y:250..259 R:260..279 W:280..299")
        expect(_runs(1, 5, 75)).to_equal("R:250..279 W:280..299")

    it "AC-8: inline content paints over the background of a later block":
        expect(_runs(4, 6, 25)).to_equal("B:1200..1279 G:1280..1319 W:1320..1399")
        expect(_runs(4, 6, 50)).to_equal("W:1200..1239 G:1240..1319 W:1320..1399")
        expect(_runs(1, 6, 25)).to_equal("B:300..319 G:320..329 W:330..349")

    it "AC-9: the order holds inside an opacity group":
        expect(_runs(4, 7, 50)).to_equal("r:1400..1479 W:1480..1599")
        expect(_runs(1, 7, 50)).to_equal("r:350..369 W:370..399")

    it "AC-10: an opacity box paints over the background of a later block":
        expect(_runs(4, 8, 50)).to_equal("g:1600..1639 m:1640..1679 Y:1680..1719 W:1720..1799")
        expect(_runs(1, 8, 50)).to_equal("g:400..409 m:410..419 Y:420..429 W:430..449")

    it "AC-11: a grid item paints as one unit, so a later item covers an earlier item's text":
        expect(_non(4, 9, 40, 200, "Y")).to_equal(0)
        expect(_non(1, 9, 40, 200, "Y")).to_equal(0)
        expect(_non(4, 9, 0, 40, "G") > 0).to_equal(true)
        expect(_non(1, 9, 0, 40, "G") > 0).to_equal(true)

    it "AC-12: a flex item paints as one unit, so a later item covers an earlier item's text":
        expect(_non(4, 10, 40, 140, "Y")).to_equal(0)
        expect(_non(1, 10, 40, 140, "Y")).to_equal(0)
        expect(_non(4, 10, 0, 40, "G") > 0).to_equal(true)
        expect(_non(1, 10, 0, 40, "G") > 0).to_equal(true)

val BUTTON_PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff;font:16px/1.5 'Liberation Sans';color:#172033}}</style></head><body><button style=\"display:block;width:100px;height:40px;padding:0;border:0;background:#aa0000\"><div style=\"height:10px;width:50px;background:#00aa00\"></div></button></body></html>"

# Colour runs down CSS column css_x of a 200x50 page, as device rows.
fn _page_runs(page: text, k: i32, css_x: i32) -> text:
    val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(page, 200, 50, k, "cpu_simd")
    val w = 200 * k
    val x = css_x * k
    var y = 0
    var start = 0
    var cur = _name(px[x])
    var out = ""
    while y < 50 * k:
        val n = _name(px[y * w + x])
        if n != cur:
            out = out + "{cur}:{start}..{y - 1} "
            cur = n
            start = y
        y = y + 1
    out + "{cur}:{start}..{y - 1}"

describe "A block-level form control paints its own children over itself (Chrome 159)":
    it "AC-13: a block child of a display:block button covers the button background, k=1 and k=4":
        expect(_page_runs(BUTTON_PAGE, 1, 20)).to_equal("R:0..14 G:15..24 R:25..39 W:40..49")
        expect(_page_runs(BUTTON_PAGE, 4, 20)).to_equal("R:0..59 G:60..99 R:100..159 W:160..199")
