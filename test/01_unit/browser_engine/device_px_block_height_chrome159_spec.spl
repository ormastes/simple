"""
## Purpose and audience
Purpose: Pin where the block BELOW a form control or a mixed-font line lands at
device scale 4, against Chrome 159. At `--force-device-scale-factor=4` Chrome
lays out in DEVICE px, so a box's height is a whole number of device px, not of
CSS px: a text `<input>` (13.333px Liberation Sans, `normal` line-height, 8px
padding, 1px border) is 61 + 72 = 133 device px = 33.25 CSS px, where the 1x
layout has 33. This engine kept every height in whole CSS px and scaled by 4,
so each block after such a box sat up to 2 device px off, and the offsets add
up down the page (catalog forms-media: the h3 under the form is 5 device rows
high).
Audience: web renderer layout / Draw IR device-scale maintainers.

Measured values, device px: the non-white background runs in the right-edge
column of the 10 CSS px marker `<div>` after each block (`R` = `#ffd0d0`,
`G` = `#d0ffd0`).

Chrome oracle (Chrome for Testing 159.0.8154.6 aarch64, `--headless=new
--disable-gpu --hide-scrollbars --force-device-scale-factor=K
--window-size=900,760 --dump-dom`, `getBoundingClientRect()` of each box, the
page below; CSS px):

| block above the marker                  | K=1 h | K=2 h  | K=3 h  | K=4 h  | marker top K=1 / K=4 |
|-----------------------------------------|-------|--------|--------|--------|----------------------|
| label > text input                      | 33    | 33.5   | 33     | 33.25  | 49 / 49.25           |
| label > select                          | 35    | 35     | 34.667 | 34.75  | 110 / 110            |
| label > textarea (textarea 48 / 49.5)   | 55    | 55.5   | 55.667 | 56     | 191 / 192            |
| button                                  | 33    | 33.5   | 33     | 33.25  | 234 / 235.25         |
| p: text + kbd + code + var              | 24    | 24     | 24.333 | 24.25  | 268 / 269.5          |
| p: text + code                          | 24    | 24     | 24.333 | 24.25  | 302 / 303.75         |

Rules read off the table (device px at scale k):
- a control's `normal` line is the face's per-part rounded sum at 13.333k px
  (Liberation Sans: 15, 31, 45, 61);
- a `<select>` adds round(1.5k) of inner block padding to it (2, 3, 5, 6);
- a line box is the device ascent + descent of its boxes: the 13px monospace
  `code` in a 16px/1.5 line reaches 71 above the baseline at k=4 against the
  strut's 70, so the line is 97, not 96.

K=4 marker rows = 4 x top .. 4 x top + 39. Base (5bd3ff5651b) at K=4 keeps
4 x the K=1 tops: R196-235 G440-479 R764-803 G936-975 R1072-1111 G1208-1247.
"""

"""
Traceability: REQ-WEB-DPR4-BLOCK-H-001 — at device scale k>1 a block's height is its device-px height, so the next block starts where Chrome's does.
"""
# @tag: unit, browser_engine, layout, device_scale, chrome159
# @cover src/lib/common/ui/draw_ir_device_scale.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}

val CSS_W: i32 = 300
val CSS_H: i32 = 316

val PAGE: text = "<!doctype html><html><head><style>body{{margin:0;background:#fff;font:16px/1.5 'Liberation Sans';width:300px}} *{{box-sizing:border-box}} label{{display:block;margin:8px 0}} input,select,textarea,button{{padding:8px;border:1px solid #94a3b8}} p{{margin:0}} .r{{height:10px;background:#ffd0d0}} .g{{height:10px;background:#d0ffd0}}</style></head><body>" +
    "<label>Name <input value=\"Simple\"></label><div class=\"r\"></div>" +
    "<label>Choice <select><option>Alpha</option></select></label><div class=\"g\"></div>" +
    "<label>Notes <textarea>Editable</textarea></label><div class=\"r\"></div>" +
    "<button>Go</button><div class=\"g\"></div>" +
    "<p>Keys <kbd>Ctrl</kbd> <code>x</code> <var>v</var></p><div class=\"r\"></div>" +
    "<p>a <code>c</code></p><div class=\"g\"></div></body></html>"

fn _chan(px: u32, shift: u32) -> i32:
    ((px >> shift) & 0xFFu32) as i32

fn _kind(px: u32) -> text:
    val r = _chan(px, 16u32)
    val g = _chan(px, 8u32)
    val b = _chan(px, 0u32)
    if r > 240 and g > 190 and g < 220 and b > 190 and b < 220:
        return "R"
    if g > 240 and r > 190 and r < 220 and b > 190 and b < 220:
        return "G"
    "W"

# Marker runs of the right-edge column, e.g. "R197-236 G440-479".
fn _marker_runs(k: i32) -> text:
    val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, k, "cpu_simd")
    val w = CSS_W * k
    val h = CSS_H * k
    if px.len() != (w * h) as i64:
        return "size-mismatch"
    var out = ""
    var prev = "W"
    var start = 0
    var y = 0
    while y <= h:
        val kd = if y < h: _kind(px[y * w + w - 2]) else: "W"
        if kd != prev:
            if prev != "W":
                out = out + (if out == "": "" else: " ") + prev + start.to_text() + "-" + (y - 1).to_text()
            prev = kd
            start = y
        y = y + 1
    out

describe "Device-px block heights at device scale 4 (Chrome 159)":
    it "AC-1: the block after each control / mixed-font line starts on Chrome's device row":
        expect(_marker_runs(4)).to_equal("R197-236 G440-479 R768-807 G941-980 R1078-1117 G1215-1254")

describe "Device-px block heights leave scale 1 alone":
    it "AC-2 (guard): the 1x tops stay Chrome's 49 110 191 234 268 302":
        expect(_marker_runs(1)).to_equal("R49-58 G110-119 R191-200 G234-243 R268-277 G302-311")

# Fractional font sizes and `sub` at device scale 4: four 50 CSS px cells.
val FONT_W: i32 = 120
val FONT_H: i32 = 200

val FONT_PAGE: text = "<!doctype html><html><head><style>body{{margin:0;background:#fff}} div{{height:50px;margin:0;color:#000}}</style></head><body style=\"width:120px\">" +
    "<div style=\"font:14.4px/1.5 'Liberation Sans'\">HHHHHHHH</div>" +
    "<div style=\"font:15.5px/1.5 'Liberation Sans'\">HHHHHHHH</div>" +
    "<div style=\"font:17.6px/1.5 'Liberation Sans'\">HHHHHHHH</div>" +
    "<div style=\"font:16px/1.5 'Liberation Sans'\">H<sub>H</sub></div></body></html>"

fn _is_ink(px: u32) -> bool:
    _chan(px, 8u32) < 100 and _chan(px, 0u32) < 100

# First and last ink row of device columns x0..x1 in 50 CSS px cell `cell`,
# relative to the cell top, as "first/last".
fn _ink_rows(px: [u32], cell: i32, x0: i32, x1: i32) -> text:
    val k = 4
    val w = FONT_W * k
    if px.len() != (w * FONT_H * k) as i64:
        return "size-mismatch"
    var first = -1
    var last = -1
    var y = 0
    while y < 50 * k:
        var x = x0
        while x < x1:
            if _is_ink(px[(cell * 50 * k + y) * w + x]):
                if first < 0:
                    first = y
                last = y
            x = x + 1
        y = y + 1
    first.to_text() + "/" + last.to_text()

describe "Fractional font sizes paint at the device size at scale 4 (Chrome 159)":
    # Chrome 159 first/last ink row per cell (measured by the dpr4 font lane,
    # skill.md 2026-11-18): 14.4px 23/61, 15.5px 24/66, 17.6px 29/76, sub 48/83.
    # Base (5bd3ff5651b) paints round(css) x 4: 23/60, 24/64, 29/77.
    # Re-measured 2026-11-24 (same page, Chrome 159 k=4, window 400x300, this
    # file's ink rule): 23/61, 24/66, 29/76 as above, and the `sub` cell 47/83.
    # The 48 row above was this engine's 53 px-tall gray glyph; gray glyphs now
    # scale y by the float size, which also brings the 14.4px top row to 23.
    it "AC-3: 14.4 / 15.5 / 17.6 px Liberation Sans cap rows and the sub row":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(FONT_PAGE, FONT_W, FONT_H, 4, "cpu_simd")
        expect(_ink_rows(px, 0, 0, 40)).to_equal("23/61")
        expect(_ink_rows(px, 1, 0, 40) + " " + _ink_rows(px, 2, 0, 40) + " " + _ink_rows(px, 3, 56, 90)).to_equal("24/66 29/76 47/83")
