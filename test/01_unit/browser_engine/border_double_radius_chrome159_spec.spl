use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{simple_web_layout_render_html_software_pixels}
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{simple_web_render_html_to_pixels_with_resolved_engine2d_backend}

# Chrome 159 paints a uniform double border as two solid rings of
# round(w / 3) px: the outer on the border box, the inner on the box inset by
# w - stripe with radii r - inset. Box 1: 6px, radii 10 0 10 0. Box 2: 7px,
# square (stripes 2/3/2, each stripe stopping at the other side's stripe).
# Box 3: 6px, uniform radius 8.
val DB_PAGE = "<!DOCTYPE html><html><body style=\"margin:0;background:#fff\"><div style=\"margin:2px;width:20px;height:14px;background:#0f0;border:6px double #f00;border-radius:10px 0 10px 0\"></div><div style=\"position:absolute;left:40px;top:2px;width:10px;height:6px;background:#0f0;border:7px double #f00\"></div><div style=\"position:absolute;left:70px;top:2px;width:20px;height:14px;background:#0f0;border:6px double #f00;border-radius:8px\"></div></body></html>"

# Chrome 159, k=4, --window-size=110,32. Each pin's 4x4 device block is one
# colour, so it is fully covered (no AA edge).
val DB_X: [i32] = [8,9,10,10,11,24,31,25,32,26,33,28,41,30,25,32,27,40,29,24,31,26,33,2,9,6,3,10,7,4,11,8,5,2,9,6,3,10,24,41,40,40,42,24,25,31,44,32,45,33,41,49,31,46,40,49,45,33,48,43,54,61,58,63,60,54,63,60,57,55,70,58,31,46,40,49,45,33,48,43,32,41,49,42,49,45,54,63,57,72,62,56,71,60,62,56,70,72,60,56,63,61,63,63,75,74,76,73,73,70,77,72,79,92,92,96,94,98,100,98,95,62,75,70,77,73,63,73,79,73,79,92,99,96,93,96,98,94,92]
val DB_Y: [i32] = [3,5,7,9,10,2,2,3,3,4,4,5,5,6,7,7,8,8,9,10,10,11,11,18,18,19,20,20,21,22,22,23,24,25,25,26,27,27,18,18,19,20,21,24,26,2,2,3,3,4,5,5,7,7,8,8,9,10,10,11,2,2,3,4,5,7,7,8,9,10,10,11,12,12,13,13,14,15,15,16,17,18,18,20,20,21,12,12,13,13,14,15,15,16,17,18,18,19,20,21,21,2,3,4,5,6,7,8,9,10,10,11,11,2,4,5,7,8,9,10,11,18,18,19,19,20,21,22,23,25,26,18,18,19,20,21,22,24,26]
val DB_CHROME: [u32] = [0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFF00FF00u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFF00FF00u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFFFF0000u32, 0xFF00FF00u32, 0xFF00FF00u32, 0xFFFF0000u32]

fn db_mismatches(px: [u32], lane: text) -> i32:
    if px.len() < 110 * 32:
        return 999
    var bad = 0
    var n = 0
    while n < DB_CHROME.len():
        val got = px[DB_Y[n] * 110 + DB_X[n]] | 0xFF000000u32
        if got != DB_CHROME[n]:
            print "{lane} ({DB_X[n]},{DB_Y[n]}) got {got} want {DB_CHROME[n]}"
            bad = bad + 1
        n = n + 1
    bad

describe "double borders follow Chrome 159 stripes and radii":
    it "on the CPU raster":
        expect(db_mismatches(simple_web_layout_render_html_software_pixels(DB_PAGE, 110, 32), "raster")).to_equal(0)

    it "on cpu_simd":
        expect(db_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(DB_PAGE, 110, 32, "cpu_simd"), "cpu_simd")).to_equal(0)

    it "on Vulkan":
        expect(db_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(DB_PAGE, 110, 32, "vulkan"), "vulkan")).to_equal(0)
