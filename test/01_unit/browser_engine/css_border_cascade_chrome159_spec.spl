"""
## Purpose and audience
Purpose: Pin the cascade of the border property family: a border shorthand
authored after a longhand wins on every side it sets, and a declaration
with an invalid token is dropped whole, so the earlier value stays.
Audience: browser-engine style cascade maintainers.

Chrome oracle (Chrome 159.0.8154.6 headless shell, `getComputedStyle` /
`getBoundingClientRect()`), every box absolutely placed, 20x20 with
`border:4px solid green` from the stylesheet:
- `#c1` `border-color:blue;border-color:red foo` -- all four sides blue.
- `#c2` `border-color:red blue foo` -- all four sides stay green.
- `#c3` `border-top-color:red;border-color:blue` -- top blue.
- `#c4` `border-left-color:red;border:4px solid blue` -- left blue.
- `#c5` `border-color:blue;border-top-color:red` -- top red (longhand last).
- `#s1` `border-top-style:none;border-style:solid` is 28 tall; `#s2` the
  reverse order is 24 tall.
- `#w1` `border-top-width:10px;border-width:1px` is 22 tall; `#w2` the
  reverse order is 31 tall.

RESET_PAGE / RESET_GEOM (same capture; `color:rgb(0,128,0)`, 20x20 boxes,
no stylesheet border) -- a shorthand resets the parts it omits, and logical
properties cascade in source order with the physical ones:
- `#r1` `border-top-color:red;border:4px solid` -- all four currentColor.
- `#r2` `border:4px solid;border-inline-start-color:red;border-color:blue`
  -- all blue; `#r3` `...;border-left-color:red;border-inline-start-color:blue`
  -- left blue, the rest currentColor.
- `#r4` a five-token `border-color` is dropped -- all red.
- `#r5` `border-inline-start-color:red;border-inline:4px solid blue` --
  left and right blue.
- `#o1` `outline-color:red;outline:2px solid` -- currentColor outline;
  `#o2` `outline-style:dashed;outline:2px red` and `#o3` `outline:0 solid
  red` paint no outline.
- `#g1` `border-top-style:dashed;border:2px red` 20x20 (style none);
  `#g2` the same with `border-top` 20 tall; `#g3` `border-inline:blue`
  after `border:2px solid` 20 wide, 24 tall; `#g4`
  `border-block:4px solid red;border-top-width:1px` 25 tall; `#g5`
  `border-block:4px none #112233` 20 tall.
- `#g6` `border:thin solid` 22; `#g7` `border-width:medium` 26; `#g8`
  `border-width:thick thin` 22 wide, 30 tall; `#g9`
  `border-inline-start-width:7px;border:2px solid` 24 wide.

OUTLINE_PAGE (same capture, screenshot pixels, box 20x20 at x 10):
`outline:solid`, `outline:solid;outline-offset:1px` and `outline-style:solid`
compute 3px (medium) in the element colour -- columns 7..9, 6..8 and 7..9;
`outline:auto` and `outline:5px auto` paint Chrome's focus ring: column 9
outside the box (and column 10 inside, not modelled), column 8 clear.
"""

"""
Traceability: REQ-BROWSER-ENGINE-CSS-BORDER-CASCADE-001 — border shorthands and longhands cascade in source order, and an invalid border-color declaration is dropped whole, as Chrome 159.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_foundation.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{simple_web_render_html_to_pixels_with_engine2d_backend}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_geometry.{simple_web_layout_debug_layout_by_id}

val COLOR_PAGE: text = "<!doctype html><html><head><style>body{{margin:0;background:#fff}}div{{position:absolute;left:0;width:20px;height:20px;border:4px solid green}}</style></head><body><div id=c1 style=\"top:0;border-color:blue;border-color:red foo\"></div><div id=c2 style=\"top:40px;border-color:red blue foo\"></div><div id=c3 style=\"top:80px;border-top-color:red;border-color:blue\"></div><div id=c4 style=\"top:120px;border-left-color:red;border:4px solid blue\"></div><div id=c5 style=\"top:160px;border-color:blue;border-top-color:red\"></div></body></html>"

val GEOM_PAGE: text = "<!doctype html><html><head><style>body{{margin:0}}div{{position:absolute;left:0;width:20px;height:20px;border:4px solid green}}</style></head><body><div id=s1 style=\"top:0;border-top-style:none;border-style:solid\"></div><div id=s2 style=\"top:40px;border-style:solid;border-top-style:none\"></div><div id=w1 style=\"top:80px;border-top-width:10px;border-width:1px\"></div><div id=w2 style=\"top:120px;border-width:1px;border-top-width:10px\"></div></body></html>"

val RESET_PAGE: text = "<!doctype html><html><head><style>body{{margin:0;background:#fff;color:rgb(0,128,0)}}div{{position:absolute;left:0;width:20px;height:20px}}</style></head><body><div id=r1 style=\"top:0;border-top-color:red;border:4px solid\"></div><div id=r2 style=\"top:40px;border:4px solid;border-inline-start-color:red;border-color:blue\"></div><div id=r3 style=\"top:80px;border:4px solid;border-left-color:red;border-inline-start-color:blue\"></div><div id=r4 style=\"top:120px;border:4px solid red;border-color:red blue green yellow pink\"></div><div id=r5 style=\"top:160px;border:4px solid;border-inline-start-color:red;border-inline:4px solid blue\"></div><div id=o1 style=\"top:200px;left:10px;outline-color:red;outline:2px solid\"></div><div id=o2 style=\"top:240px;left:10px;outline-style:dashed;outline:2px red\"></div><div id=o3 style=\"top:280px;left:10px;outline:0 solid red\"></div></body></html>"

val RESET_GEOM: text = "<!doctype html><html><head><style>body{{margin:0}}div{{position:absolute;left:0;width:20px;height:20px}}</style></head><body><div id=g1 style=\"top:0;border-top-style:dashed;border:2px red\"></div><div id=g2 style=\"top:40px;border-top-style:dashed;border-top:2px red\"></div><div id=g3 style=\"top:80px;border:2px solid;border-inline-start-color:red;border-inline:blue\"></div><div id=g4 style=\"top:120px;border-block:4px solid red;border-top-width:1px\"></div><div id=g5 style=\"top:160px;border-block:4px none #112233\"></div><div id=g6 style=\"top:200px;border:thin solid\"></div><div id=g7 style=\"top:240px;border:2px solid;border-width:medium\"></div><div id=g8 style=\"top:280px;border:2px solid;border-width:thick thin\"></div><div id=g9 style=\"top:320px;border-inline-start-width:7px;border:2px solid\"></div></body></html>"

# Colours of the top, right, bottom and left border middles of the 28x28
# box whose top edge is at `y`.
fn sides(px: [u32], y: i32) -> text:
    val t = px[14 + (y + 1) * 100] & 0xFFFFFFu32
    val r = px[26 + (y + 14) * 100] & 0xFFFFFFu32
    val b = px[14 + (y + 26) * 100] & 0xFFFFFFu32
    val l = px[1 + (y + 14) * 100] & 0xFFFFFFu32
    "{t} {r} {b} {l}"

fn height(id: text) -> text:
    simple_web_layout_debug_layout_by_id(GEOM_PAGE, 900, 400, id, "h")

val OUTLINE_PAGE: text = "<!doctype html><html><head><style>body{{margin:0;background:#fff;color:rgb(0,128,0)}}div{{position:absolute;left:10px;width:20px;height:20px}}</style></head><body><div id=p1 style=\"top:10px;outline:auto\"></div><div id=p2 style=\"top:50px;outline:5px auto\"></div><div id=p3 style=\"top:90px;outline:solid\"></div><div id=p4 style=\"top:130px;outline:solid;outline-offset:1px\"></div><div id=p5 style=\"top:170px;outline-style:solid\"></div></body></html>"

fn rg(id: text, field: text) -> text:
    simple_web_layout_debug_layout_by_id(RESET_GEOM, 900, 400, id, field)

val BLUE: text = "255"
val WHITE: text = "16777215"

fn pxc(px: [u32], x: i32, y: i32) -> text:
    val c = px[x + y * 100] & 0xFFFFFFu32
    "{c}"
val GREEN: text = "32768"
val RED: text = "16711680"

describe "border property family cascade":
    it "AC-1: a border-color with an invalid token is dropped whole":
        val px = simple_web_render_html_to_pixels_with_engine2d_backend(COLOR_PAGE, 100, 200, "cpu_simd")
        step("Chrome 159: #c1 all blue (the earlier border-color), #c2 all green")
        expect(sides(px, 0)).to_equal("{BLUE} {BLUE} {BLUE} {BLUE}")
        expect(sides(px, 40)).to_equal("{GREEN} {GREEN} {GREEN} {GREEN}")

    it "AC-2: a border shorthand after a longhand wins; a longhand after it wins":
        val px = simple_web_render_html_to_pixels_with_engine2d_backend(COLOR_PAGE, 100, 200, "cpu_simd")
        step("Chrome 159: #c3 top blue, #c4 left blue, #c5 top red")
        expect(sides(px, 80)).to_equal("{BLUE} {BLUE} {BLUE} {BLUE}")
        expect(sides(px, 120)).to_equal("{BLUE} {BLUE} {BLUE} {BLUE}")
        expect(sides(px, 160)).to_equal("{RED} {BLUE} {BLUE} {BLUE}")

    it "AC-3: border-style and border-width cascade in source order too":
        step("Chrome 159: s1 28, s2 24, w1 22, w2 31 tall")
        expect(height("s1")).to_equal("28")
        expect(height("s2")).to_equal("24")
        expect(height("w1")).to_equal("22")
        expect(height("w2")).to_equal("31")

    it "AC-4: a shorthand resets the parts it omits; logical properties keep source order":
        val px = simple_web_render_html_to_pixels_with_engine2d_backend(RESET_PAGE, 100, 320, "cpu_simd")
        step("Chrome 159: r1 all currentColor; r2 all blue; r3 left blue; r4 all red; r5 left/right blue")
        expect(sides(px, 0)).to_equal("{GREEN} {GREEN} {GREEN} {GREEN}")
        expect(sides(px, 40)).to_equal("{BLUE} {BLUE} {BLUE} {BLUE}")
        expect(sides(px, 80)).to_equal("{GREEN} {GREEN} {GREEN} {BLUE}")
        expect(sides(px, 120)).to_equal("{RED} {RED} {RED} {RED}")
        expect(sides(px, 160)).to_equal("{GREEN} {BLUE} {GREEN} {BLUE}")
        step("Chrome 159: o1 currentColor outline; o2 and o3 no outline")
        expect(pxc(px, 9, 210)).to_equal(GREEN)
        expect(pxc(px, 9, 250)).to_equal(WHITE)
        expect(pxc(px, 9, 290)).to_equal(WHITE)

    it "AC-5: omitted style is none, keywords widths resolve, logical widths keep source order":
        step("Chrome 159: g1 20x20, g2 20 tall, g3 20x24, g4 25 tall, g5 20 tall")
        expect(rg("g1", "w")).to_equal("20")
        expect(rg("g1", "h")).to_equal("20")
        expect(rg("g2", "h")).to_equal("20")
        expect(rg("g3", "w")).to_equal("20")
        expect(rg("g3", "h")).to_equal("24")
        expect(rg("g4", "h")).to_equal("25")
        expect(rg("g5", "h")).to_equal("20")
        step("Chrome 159: g6 22, g7 26, g8 22x30, g9 24 wide")
        expect(rg("g6", "w")).to_equal("22")
        expect(rg("g7", "w")).to_equal("26")
        expect(rg("g8", "w")).to_equal("22")
        expect(rg("g8", "h")).to_equal("30")
        expect(rg("g9", "w")).to_equal("24")

    it "AC-6: an outline without a width is medium; auto paints a ring":
        val px = simple_web_render_html_to_pixels_with_engine2d_backend(OUTLINE_PAGE, 100, 220, "cpu_simd")
        step("Chrome 159: outline:solid / +offset:1px / outline-style:solid are 3px")
        expect(pxc(px, 7, 100)).to_equal(GREEN)
        expect(pxc(px, 6, 100)).to_equal(WHITE)
        expect(pxc(px, 6, 140)).to_equal(GREEN)
        expect(pxc(px, 9, 140)).to_equal(WHITE)
        expect(pxc(px, 7, 180)).to_equal(GREEN)
        expect(pxc(px, 6, 180)).to_equal(WHITE)
        step("Chrome 159: outline:auto and outline:5px auto paint column 9, not 8")
        expect(pxc(px, 9, 20)).to_equal(GREEN)
        expect(pxc(px, 8, 20)).to_equal(WHITE)
        expect(pxc(px, 9, 60)).to_equal(GREEN)
        expect(pxc(px, 8, 60)).to_equal(WHITE)
