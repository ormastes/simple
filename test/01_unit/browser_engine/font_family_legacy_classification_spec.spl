# The pre-2026-11-14 whole-value classification, pinned on EVERY host.
#
# `_browser_resolve_family_legacy` is the path macOS and any host without the
# measured Liberation face set still take (font_provider.spl § Family-LIST
# resolution, SCOPE). It was restored unmeasured, so what it must do is what it
# did before: substring tests over the whole value, mono as the unmatched
# default. It is a pure function of the family string — no file probes — so it
# is called directly here and asserts the same thing on Linux, macOS and CI.
#
# These are NOT Chrome values. They pin behaviour that must not drift while
# those hosts stay unmeasured.
use std.spec.*
use std.nogc_sync_mut.text_layout.font_provider.{_browser_resolve_family_legacy}

fn _category(family: text) -> text:
    _browser_resolve_family_legacy(family).category

fn _default(family: text) -> text:
    _browser_resolve_family_legacy(family).default_category

describe "legacy whole-value font-family classification":
    it "classifies a name containing sans as sans":
        expect(_category("Gill Sans")).to_equal("sans")
        expect(_category("Comic Sans MS")).to_equal("sans")
        expect(_category("Open Sans")).to_equal("sans")
        expect(_category("Helvetica, Arial, sans-serif")).to_equal("sans")
        expect(_category("system-ui")).to_equal("sans")
        expect(_category("-apple-system")).to_equal("sans")

    it "classifies a name containing mono, console or code as mono":
        expect(_category("Lucida Console")).to_equal("mono")
        expect(_category("Andale Mono")).to_equal("mono")
        expect(_category("SFMono-Regular")).to_equal("mono")
        expect(_category("JetBrains Mono")).to_equal("mono")
        expect(_category("\"Source Code Pro\", Arial")).to_equal("mono")

    it "classifies a serif list as serif":
        expect(_category("Georgia, serif")).to_equal("serif")
        expect(_category("Times New Roman")).to_equal("serif")

    it "leaves an unmatched value to the mono default":
        expect(_category("")).to_equal("")
        expect(_default("")).to_equal("mono")
        expect(_category("inherit")).to_equal("")
        expect(_default("inherit")).to_equal("mono")
        expect(_category("UnknownFamily")).to_equal("")
        expect(_default("UnknownFamily")).to_equal("mono")
        expect(_category("default")).to_equal("")
        expect(_default("default")).to_equal("mono")

    it "keeps the system substring out of the strict category":
        # The decorated @font-face branch and the font_renderer category never
        # applied the `system` rule.
        expect(_browser_resolve_family_legacy("system-ui").category_strict).to_equal("")
        expect(_browser_resolve_family_legacy("Open Sans").category_strict).to_equal("sans")

    it "names no host face and no bundled asset for a plain list":
        expect(_browser_resolve_family_legacy("Gill Sans").face).to_equal("")
        expect(_browser_resolve_family_legacy("Gill Sans").bundled).to_equal("")
