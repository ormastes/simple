# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-BROWSER_ENGINE
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: Prove that css_decl_property / css_decl_value / css_decls_contain (U4.3 closure).
Audience: compiler and tooling engineers who maintain this spec.
"""
use std.spec.step
# @req: REQ-BROWSER-ENGINE-001 — stable requirement identity for this spec.

# @cover src/lib/gc_async_mut/gpu/browser_engine/style_block.spl 30%
"""
# Style Block Processor — Coverage Closure (U4.3, part 2: style_block.spl)

Wave 4 of the WM/GUI/web system-test coverage plan
(doc/03_plan/ui/testing/wm_gui_web_system_test_coverage_plan_2026-08-07.md,
unit U4.3). Line coverage IS measurable now; branch coverage remains
unavailable and no branch percentage is claimed here.

`style_block.spl`'s pure text-scanning helpers
(`sb_find`/`sb_split_char`/`sb_split_selector_list`/
`sb_find_top_level_child_combinator`/`sb_split_ws`/`sb_skip_ws_comments`/
`sb_parse_int`/`find_matching_brace`) and the tiny `CssDecl` accessors
(`css_decl_property`/`css_decl_value`/`css_decls_contain`) had zero existing
test/ references before this unit. This spec closes them with real oracles.
DOM-tree application (`apply_css_rules_to_tree*`, `SelectorRuleIndex`
construction/lookup, `process_style_blocks*`) needs a `BeDomNode` fixture and
is left for a follow-up unit — out of scope for this pass, which prioritizes
the zero-dependency pure helpers first per the plan's enumerated-proxy
fallback.
"""

use std.spec.step

use std.spec.{describe, it, expect}
use gc_async_mut.gpu.browser_engine.style_block.{
    CssDecl,
    css_decl_property,
    css_decl_value,
    css_decls_contain,
    find_matching_brace,
    sb_find,
    sb_find_top_level_child_combinator,
    sb_parse_int,
    sb_skip_ws_comments,
    sb_split_char,
    sb_split_selector_list,
    sb_split_ws,
}

describe "css_decl_property / css_decl_value / css_decls_contain (U4.3 closure)":
    # @manual scenario evidence
    it "reads the property and value fields through the accessor functions":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("reads the property and value fields through the accessor functions")
        step("Verify: reads the property and value fields through the accessor functions")
        # @req: REQ-BROWSER-ENGINE-001
        val decl = CssDecl(property: "color", value: "red")
        expect(css_decl_property(decl)).to_equal("color")
        expect(css_decl_value(decl)).to_equal("red")

    it "finds a matching property/value pair and reports absence for a non-matching one (both-directions oracle)":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("finds a matching property/value pair and reports absence for a non-matching one (both-directions oracle)")
        step("Verify: finds a matching property/value pair and reports absence for a non-matching one (both-directions oracle)")
        val decls = [CssDecl(property: "color", value: "red"), CssDecl(property: "display", value: "block")]
        expect(css_decls_contain(decls, "display", "block")).to_equal(true)
        expect(css_decls_contain(decls, "display", "flex")).to_equal(false)

describe "sb_find (U4.3 closure)":
    it "returns the index of the first occurrence at or after start":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("returns the index of the first occurrence at or after start")
        step("Verify: returns the index of the first occurrence at or after start")
        expect(sb_find("a.b.c", ".", 0)).to_equal(1)
        expect(sb_find("a.b.c", ".", 2)).to_equal(3)

    it "returns the sentinel 999999999 when the target is absent (both-directions oracle)":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("returns the sentinel 999999999 when the target is absent (both-directions oracle)")
        step("Verify: returns the sentinel 999999999 when the target is absent (both-directions oracle)")
        expect(sb_find("abc", "z", 0)).to_equal(999999999)

describe "sb_split_char (U4.3 closure)":
    it "splits on every occurrence of the delimiter, keeping empty segments":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("splits on every occurrence of the delimiter, keeping empty segments")
        step("Verify: splits on every occurrence of the delimiter, keeping empty segments")
        val parts = sb_split_char("div,span,,p", ",")
        expect(parts.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(parts[0]).to_equal("div")
        expect(parts[1]).to_equal("span")
        expect(parts[2]).to_equal("")
        expect(parts[3]).to_equal("p")

describe "sb_split_selector_list (U4.3 closure)":
    it "splits top-level commas but not commas nested inside parens":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("splits top-level commas but not commas nested inside parens")
        step("Verify: splits top-level commas but not commas nested inside parens")
        val parts = sb_split_selector_list("div, :is(a, b), span")
        expect(parts.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(parts[0]).to_equal("div")
        expect(parts[1]).to_equal(" :is(a, b)")
        expect(parts[2]).to_equal(" span")

describe "sb_find_top_level_child_combinator (U4.3 closure)":
    it "finds a top-level '>' and ignores one nested inside parens":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("finds a top-level '>' and ignores one nested inside parens")
        step("Verify: finds a top-level '>' and ignores one nested inside parens")
        expect(sb_find_top_level_child_combinator("div > span")).to_equal(4)
        expect(sb_find_top_level_child_combinator(":is(a > b) span")).to_equal(999999999)

describe "sb_split_ws (U4.3 closure)":
    it "splits on runs of whitespace and drops empty segments":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("splits on runs of whitespace and drops empty segments")
        step("Verify: splits on runs of whitespace and drops empty segments")
        val parts = sb_split_ws("  div   span  ")
        expect(parts.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(parts[0]).to_equal("div")
        expect(parts[1]).to_equal("span")

describe "sb_skip_ws_comments (U4.3 closure)":
    it "skips whitespace and a CSS comment, stopping at the next real token":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("skips whitespace and a CSS comment, stopping at the next real token")
        step("Verify: skips whitespace and a CSS comment, stopping at the next real token")
        expect(sb_skip_ws_comments("  /* c */ div", 0)).to_equal(10)

    it "returns start unchanged when there is nothing to skip (both-directions oracle)":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("returns start unchanged when there is nothing to skip (both-directions oracle)")
        step("Verify: returns start unchanged when there is nothing to skip (both-directions oracle)")
        expect(sb_skip_ws_comments("div", 0)).to_equal(0)

describe "sb_parse_int (U4.3 closure)":
    it "parses a positive and a negative integer":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("parses a positive and a negative integer")
        step("Verify: parses a positive and a negative integer")
        expect(sb_parse_int("42")).to_equal(42)
        expect(sb_parse_int("-7")).to_equal(-7)

    it "returns 0 for empty or non-numeric text (both-directions oracle)":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("returns 0 for empty or non-numeric text (both-directions oracle)")
        step("Verify: returns 0 for empty or non-numeric text (both-directions oracle)")
        expect(sb_parse_int("")).to_equal(0)
        expect(sb_parse_int("abc")).to_equal(0)

describe "find_matching_brace (U4.3 closure)":
    it "finds the matching close brace across nested braces":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("finds the matching close brace across nested braces")
        step("Verify: finds the matching close brace across nested braces")
        expect(find_matching_brace("div { .a { color: red; } }", 4)).to_equal(25)

    it "returns the sentinel 999999999 when the brace never closes (both-directions oracle)":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("returns the sentinel 999999999 when the brace never closes (both-directions oracle)")
        step("Verify: returns the sentinel 999999999 when the brace never closes (both-directions oracle)")
        expect(find_matching_brace("div { color: red;", 4)).to_equal(999999999)

# --- Coverage-closure wave 2 (2026-08-15): DOM-tree application paths --------

use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode, StyleProps}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{be_dom_get_children}
use gc_async_mut.gpu.browser_engine.style_block.{
    CssRule,
    apply_css_rules_to_tree,
    apply_css_rules_to_tree_linear,
    apply_css_rules_to_tree_with_w0_stats,
    build_selector_rule_index,
    process_style_blocks,
    process_style_blocks_result,
    selector_bucket_discriminant,
    selector_index_candidates,
}

fn _w2_el(tag: text, id: text, class_val: text, kids: [BeDomNode]) -> BeDomNode:
    var attrs: Dict<text, text> = {}
    if id != "":
        attrs["id"] = id
    if class_val != "":
        attrs["class"] = class_val
    BeDomNode(
        node_id: 1,
        tag_name: tag,
        data: "",
        attributes: attrs,
        style: StyleProps.empty(),
        children: kids,
        parent_id: -1,
        event_listener_types: [],
        event_listener_actions: [],
        event_listener_capture: [])

fn _w2_text(data: text) -> BeDomNode:
    BeDomNode(
        node_id: 2,
        tag_name: "#text",
        data: data,
        attributes: {},
        style: StyleProps.empty(),
        children: [],
        parent_id: -1,
        event_listener_types: [],
        event_listener_actions: [],
        event_listener_capture: [])

fn _w2_rule(selector: text, prop: text, value: text) -> CssRule:
    CssRule(selector: selector, declarations: [CssDecl(property: prop, value: value)])

fn _w2_tree() -> BeDomNode:
    val leaf_a = _w2_el("span", "", "alpha beta", [])
    val leaf_b = _w2_el("p", "target", "", [])
    val leaf_t = _w2_text("hello")
    val skip_style = _w2_el("style", "", "", [])
    val mid = _w2_el("div", "", "container", [leaf_a, leaf_t, leaf_b])
    _w2_el("section", "", "", [mid, skip_style])

fn _w2_rules() -> [CssRule]:
    [
        _w2_rule("span", "color", "red"),
        _w2_rule(".container", "background-color", "blue"),
        _w2_rule("#target", "color", "green"),
        _w2_rule("*", "margin", "1px"),
        _w2_rule(".alpha", "background-color", "yellow"),
        _w2_rule(".beta", "background-color", "purple"),
        _w2_rule("em", "color", "black"),
        _w2_rule("#missing", "color", "white"),
        _w2_rule("div", "display", "block"),
    ]

describe "selector_bucket_discriminant (wave 2 closure)":
    it "buckets id/class/tag/universal shapes on their necessary condition":
        expect(selector_bucket_discriminant("#target")[0]).to_equal("id")
        expect(selector_bucket_discriminant(".alpha")[0]).to_equal("class")
        expect(selector_bucket_discriminant("div.container")[1]).to_equal("container")
        expect(selector_bucket_discriminant("span")[0]).to_equal("tag")
        expect(selector_bucket_discriminant("*")[0]).to_equal("universal")
        expect(selector_bucket_discriminant("")[0]).to_equal("universal")
        expect(selector_bucket_discriminant("div[data-x]")[0]).to_equal("universal")
        expect(selector_bucket_discriminant(":hover")[0]).to_equal("universal")
        expect(selector_bucket_discriminant("div > #t")[0]).to_equal("id")
        expect(selector_bucket_discriminant("section .alpha")[1]).to_equal("alpha")
        expect(selector_bucket_discriminant("div:hover")[1]).to_equal("div")
        expect(selector_bucket_discriminant(":not(.x) ")[0]).to_equal("universal")
        # key ends at the next simple-selector delimiter
        expect(selector_bucket_discriminant("#t.x")[1]).to_equal("t")
        expect(selector_bucket_discriminant(".a:hover")[1]).to_equal("a")

describe "build_selector_rule_index / selector_index_candidates (wave 2 closure)":
    it "buckets duplicate discriminants together and returns sorted candidates":
        val rules = [
            _w2_rule(".a", "color", "red"),
            _w2_rule("div", "color", "blue"),
            _w2_rule("#x", "color", "green"),
            _w2_rule(".a", "margin", "0"),
            _w2_rule("div", "margin", "0"),
            _w2_rule("#x", "margin", "0"),
            _w2_rule("*", "padding", "0"),
        ]
        val idx = build_selector_rule_index(rules)
        val cands = selector_index_candidates(idx, "div", "x", ["a", "zzz"])
        expect(cands.len()).to_equal(7)
        # ascending rule-index order restored across buckets
        var i = 1
        var sorted = true
        while i < cands.len():
            if cands[i - 1] > cands[i]:
                sorted = false
            i = i + 1
        expect(sorted).to_equal(true)

    it "returns only universal candidates for a node matching no bucket":
        val idx = build_selector_rule_index(_w2_rules())
        val cands = selector_index_candidates(idx, "article", "", [])
        expect(cands.len()).to_equal(1)

describe "apply_css_rules_to_tree linear/indexed equivalence (wave 2 closure)":
    it "the indexed path styles the tree identically to the linear reference":
        val a = apply_css_rules_to_tree(_w2_tree(), _w2_rules())
        val b = apply_css_rules_to_tree_linear(_w2_tree(), _w2_rules())
        val mid_a = be_dom_get_children(a)[0]
        val mid_b = be_dom_get_children(b)[0]
        expect(mid_a.style.background_color).to_equal("blue")
        expect(mid_b.style.background_color).to_equal("blue")
        val span_a = be_dom_get_children(mid_a)[0]
        val span_b = be_dom_get_children(mid_b)[0]
        expect(span_a.style.color).to_equal("red")
        expect(span_b.style.color).to_equal("red")
        # last equal-specificity rule wins: .beta after .alpha
        expect(span_a.style.background_color).to_equal("purple")
        expect(span_b.style.background_color).to_equal("purple")
        val p_a = be_dom_get_children(mid_a)[2]
        val p_b = be_dom_get_children(mid_b)[2]
        expect(p_a.style.color).to_equal("green")
        expect(p_b.style.color).to_equal("green")

    it "routes known-PropertyId declarations through apply_declarations (w0 stats grow)":
        var w0: Dict<text, i64> = {}
        val _ = apply_css_rules_to_tree_with_w0_stats(_w2_tree(), _w2_rules(), w0)
        expect((w0["touched"] ?? 0) > 0).to_equal(true)

describe "process_style_blocks (wave 2 closure)":
    it "extracts style-block rules, resolves vars, and applies them to the tree":
        val html = "<html><style>:root " + 123.chr() + " --main: teal; " + 125.chr() + " span " + 123.chr() + " color: var(--main); " + 125.chr() + "</style></html>"
        val styled = process_style_blocks_result(_w2_tree(), html)
        val mid = be_dom_get_children(styled)[0]
        val span = be_dom_get_children(mid)[0]
        expect(span.style.color).to_equal("teal")

    it "still runs inheritance when the html has no style blocks":
        val styled = process_style_blocks(_w2_tree(), "<html><body>plain</body></html>")
        expect(be_dom_get_children(styled).len()).to_equal(2)

describe "sb helper residual branches (wave 2 closure)":
    it "sb_skip_ws_comments stops at an unterminated comment":
        expect(sb_skip_ws_comments("  /* open", 0)).to_equal(2)

    it "sb_parse_int accepts an explicit plus sign":
        expect(sb_parse_int("+42")).to_equal(42)
