fn dr_mismatches(px: [u32], lane: text) -> i32:
    if px.len() < 200 * 100:
        return 99999
    var bad = 0
    var n = 0
    # cpu-lane-loop-ok: test pin scan; bound is the pin count
    while n < DR_X.len():
        val got = px[DR_Y[n] * 200 + DR_X[n]] | 0xFF000000u32
        if got != DR_CHROME[n]:
            if bad < 10:
                print "{lane} ({DR_X[n]},{DR_Y[n]}) got {got} want {DR_CHROME[n]}"
            bad = bad + 1
        n = n + 1
    if bad > 0:
        print "{lane} mismatches {bad}"
    bad

describe "dashed and dotted borders follow rounded corners (Chrome 159)":
    it "on the CPU raster":
        expect(dr_mismatches(simple_web_layout_render_html_software_pixels(DR_PAGE, 200, 100), "raster")).to_equal(0)

    it "on cpu_simd":
        expect(dr_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(DR_PAGE, 200, 100, "cpu_simd"), "cpu_simd")).to_equal(0)

    it "on Vulkan":
        expect(dr_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(DR_PAGE, 200, 100, "vulkan"), "vulkan")).to_equal(0)
