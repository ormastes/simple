"""
## Purpose and audience
Purpose: Pin Chrome 159's dashed and dotted borders on rounded boxes (uniform
width, colour and radius): the dashes and round dots run along the border's
centre line round the arcs, as one closed path.
Audience: browser-engine maintainers.

Chrome 159 (arm64 headless, --force-device-scale-factor=4, --window-size=400,300):
the pins are every pixel within 2 px of a box's border band whose 4x4 device
block is one colour (frame 200x100). Anti-aliased dash ends and dot edges are
not pinned.
"""

"""
Traceability: REQ-BROWSER-ENGINE-DASHED-ROUNDED-CHROME159-001 — dashed and dotted borders follow rounded corners as Chrome 159 does.
"""
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{simple_web_layout_render_html_software_pixels}
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{simple_web_render_html_to_pixels_with_resolved_engine2d_backend}

# Box 1: 4px dashed, radius 10, blue background. Box 2: 4px dotted, radius 10.
# Box 3: 6px dashed, radius 16. Box 4: 8px dotted, radius 20.
val DR_PAGE = "<!DOCTYPE html><html><body style=\"margin:0;background:#fff\"><div style=\"position:absolute;left:4px;top:4px;width:40px;height:24px;border:4px dashed #f00;border-radius:10px;background:#00f\"></div><div style=\"position:absolute;left:60px;top:4px;width:40px;height:24px;border:4px dotted #0a0;border-radius:10px\"></div><div style=\"position:absolute;left:112px;top:4px;width:60px;height:40px;border:6px dashed #f0f;border-radius:16px\"></div><div style=\"position:absolute;left:4px;top:44px;width:70px;height:34px;border:8px dotted #00f;border-radius:20px\"></div></body></html>"

# Chrome 159, k=4, uniform device blocks near the border bands.
