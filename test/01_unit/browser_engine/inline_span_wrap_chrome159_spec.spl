"""
## Purpose and audience
Purpose: Pin that an inline element (`<span>`) wider than its line wraps its
text across lines like a bare #text run, and that nowrap does not.
Audience: browser-engine layout maintainers.

Chrome oracle (Chrome 159 headless, getBoundingClientRect/getClientRects,
body{margin:0;font:16px Liberation Sans}, div{width:120px}, 2026-11-19):
`<span>alpha beta gamma delta</span>` div h=36, span fragments 74.73x17 then
92.5x17 (second line at y+18); `one <span>alpha beta gamma</span> two` h=36,
fragments at x=31.14 line 0, x=0 line 1 (53.36 wide); span with background and
padding:0 4px h=36 (fragments 78.73 / 96.5 wide: padding on first and last
fragment only); `<span><b>alpha beta</b> gamma delta</span>` h=36;
white-space:nowrap span h=18, one fragment 171.67 wide.
"""

"""
Traceability: REQ-BROWSER-ENGINE-INLINE-SPAN-WRAP-001 - inline element text wraps.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_engine.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_layout_by_id
}

val PRE: text = "<html><head><style>body{{margin:0;font:16px Liberation Sans}} div{{width:120px}}</style></head><body>"
val POST: text = "</body></html>"
val PAGE_1: text = PRE + "<div id=d><span>alpha beta gamma delta</span></div>" + POST
val PAGE_2: text = PRE + "<div id=d>one <span>alpha beta gamma</span> two</div>" + POST
val PAGE_3: text = PRE + "<div id=d><span style=\"background:#f00;padding:0 4px\">alpha beta gamma delta</span></div>" + POST
val PAGE_4: text = PRE + "<div id=d><span><b>alpha beta</b> gamma delta</span></div>" + POST
val PAGE_5: text = PRE + "<div id=d><span style=\"white-space:nowrap\">alpha beta gamma delta</span></div>" + POST

fn _g(page: text, id: text, field: text) -> i32:
    simple_web_layout_debug_layout_by_id(page, 900, 2000, id, field).to_i32()

describe "inline span wrap (Chrome 159)":
    it "span wider than its line wraps to two lines":
        step("Chrome 159: d h=36")
        expect(_g(PAGE_1, "d", "h")).to_equal(36)
    it "span after text wraps inside the span":
        step("Chrome 159: d h=36")
        expect(_g(PAGE_2, "d", "h")).to_equal(36)
    it "span with background and padding wraps":
        step("Chrome 159: d h=36")
        expect(_g(PAGE_3, "d", "h")).to_equal(36)
    it "span holding a nested inline element wraps":
        step("Chrome 159: d h=36")
        expect(_g(PAGE_4, "d", "h")).to_equal(36)
    it "control: nowrap span stays on one line":
        step("Chrome 159: d h=18")
        expect(_g(PAGE_5, "d", "h")).to_equal(18)
