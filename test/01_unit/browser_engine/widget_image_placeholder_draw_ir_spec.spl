"""
## Purpose and audience
Purpose: Pin that an `<img class="widget-image">` placeholder (24x16
intrinsic: blue field, amber accent, green block) is emitted as Draw IR
rects with object-fit / object-position geometry, the same as the CPU
raster painter `fb_widget_image_placeholder_clip`. Pixels now come from
Draw IR through Engine2D, so a raster-only placeholder painted nothing.
Audience: browser-engine Draw IR maintainers.

Root cause of the simple_web_renderer_spec rows "renders object-fit
contain for image placeholders" and "renders object-position for
contained image placeholders".
"""

"""
Traceability: REQ-WEB-RENDER-001 — widget image placeholder reaches Draw IR.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_layout.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{simple_web_layout_render_html_draw_ir}

fn _rects(fit: text) -> text:
    val html = "<html><body style='margin:0'><img id='p' class='widget-image' alt='' style='display:block;width:48px;height:16px;" + fit + "'></body></html>"
    var out = ""
    for c in simple_web_layout_render_html_draw_ir(html, 64, 32).batches[0].commands:
        if c.component_id.starts_with("p::placeholder"):
            out = out + "{c.x},{c.y},{c.width},{c.height} "
    out.trim()

describe "widget image placeholder Draw IR":
    it "AC-1: contain centres the 24x16 field":
        expect(_rects("object-fit:contain")).to_equal("12,0,24,16 15,4,8,7 25,5,8,6")

    it "AC-2: object-position left top":
        expect(_rects("object-fit:contain;object-position:left top")).to_equal("0,0,24,16 3,4,8,7 13,5,8,6")

    it "AC-3: a plain img gets no placeholder":
        val html = "<html><body style='margin:0'><img id='p' alt='' style='display:block;width:48px;height:16px'></body></html>"
        var n = 0
        for c in simple_web_layout_render_html_draw_ir(html, 64, 32).batches[0].commands:
            if c.component_id.starts_with("p::placeholder"):
                n = n + 1
        expect(n).to_equal(0)
