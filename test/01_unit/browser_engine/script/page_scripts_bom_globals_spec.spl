"""
# run_page_scripts BOM globals

Bug: js_engine_no_dom_bom_globals_2026-07-11. The `run_page_scripts` lane must
expose a minimal browser global surface (window/self/globalThis, navigator,
location) instead of leaving them undefined.
"""
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.script.script_runner.{run_page_scripts}

fn _one(src: text) -> text:
    val r = run_page_scripts([src])
    r[0]

describe "run_page_scripts BOM globals":
    it "defines window as an object":
        expect(_one("typeof window")).to_equal("object")
    it "defines navigator with a non-empty userAgent":
        expect(_one("typeof navigator")).to_equal("object")
        expect(_one("navigator.userAgent.length > 0")).to_equal("true")
    it "defines location.href":
        expect(_one("location.href")).to_equal("about:blank")
    it "window.navigator is the navigator global":
        expect(_one("window.navigator === navigator")).to_equal("true")
    it "globals persist across script tags":
        val r = run_page_scripts(["window.foo = 7", "window.foo"])
        expect(r[1]).to_equal("7.0")

describe "run_page_scripts DOM globals":
    it "defines document as an object":
        expect(_one("typeof document")).to_equal("object")
    it "window.document is the document global":
        expect(_one("window.document === document")).to_equal("true")
    it "document.title round-trips a write":
        val r = run_page_scripts(["document.title = 'Hi'", "document.title"])
        expect(r[1]).to_equal("Hi")
    it "document.body is an object":
        expect(_one("typeof document.body")).to_equal("object")
    it "keeps console available":
        expect(_one("console.log('x'); 1")).to_equal("1.0")
    it "keeps setTimeout available":
        expect(_one("typeof setTimeout")).to_equal("function")

describe "run_page_scripts storage globals":
    it "defines localStorage and sessionStorage on window and global scope":
        expect(_one("typeof localStorage")).to_equal("object")
        expect(_one("window.localStorage === localStorage")).to_equal("true")
        expect(_one("typeof sessionStorage")).to_equal("object")
        expect(_one("window.sessionStorage === sessionStorage")).to_equal("true")
        expect(_one("typeof localStorage.setItem")).to_equal("function")
        expect(_one("typeof localStorage.getItem")).to_equal("function")

    it "supports localStorage setItem/getItem/key/removeItem/clear and length across script tags":
        val r = run_page_scripts([
            "localStorage.setItem('theme', 'dark')",
            "localStorage.getItem('theme')",
            "localStorage.key(0)",
            "localStorage.length",
            "localStorage.removeItem('theme'); localStorage.getItem('theme') === null",
            "localStorage.setItem('a', '1'); localStorage.clear(); localStorage.length"
        ])
        expect(r[1]).to_equal("dark")
        expect(r[2]).to_equal("theme")
        expect(r[3]).to_equal("1.0")
        expect(r[4]).to_equal("true")
        expect(r[5]).to_equal("0.0")

describe "run_page_scripts DOM element bridge":
    it "exposes real DOM lookup and creation functions on document":
        expect(_one("typeof document.getElementById")).to_equal("function")
        expect(_one("typeof document.querySelector")).to_equal("function")
        expect(_one("typeof document.querySelectorAll")).to_equal("function")
        expect(_one("typeof document.createElement")).to_equal("function")
        expect(_one("typeof document.createTextNode")).to_equal("function")

    it "creates, attaches, and queries elements with attributes, classes, and styles":
        val r = run_page_scripts([
            "var d = document.createElement('div'); d.setAttribute('id', 'box'); d.classList.add('active'); d.style.setProperty('color', 'red'); document.body.appendChild(d); document.getElementById('box') === d",
            "document.querySelector('#box').tagName",
            "document.querySelector('.active').classList.contains('active')",
            "document.getElementById('box').style.getPropertyValue('color')"
        ])
        expect(r[0]).to_equal("true")
        expect(r[1]).to_equal("DIV")
        expect(r[2]).to_equal("true")
        expect(r[3]).to_equal("red")

