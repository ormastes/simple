"""
# run_page_scripts BOM globals

Bug: js_engine_no_dom_bom_globals_2026-07-11. The `run_page_scripts` lane must
expose a minimal browser global surface (window/self/globalThis, navigator,
location) instead of leaving them undefined.
"""
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.script.script_runner.{run_page_scripts}

fn _one(src: text) -> text:
    val r = run_page_scripts([src])
    r[0]

describe "run_page_scripts BOM globals":
    it "defines window as an object":
        expect(_one("typeof window")).to_equal("object")
    it "defines navigator with a non-empty userAgent":
        expect(_one("typeof navigator")).to_equal("object")
        expect(_one("navigator.userAgent.length > 0")).to_equal("true")
    it "defines location.href":
        expect(_one("location.href")).to_equal("about:blank")
    it "window.navigator is the navigator global":
        expect(_one("window.navigator === navigator")).to_equal("true")
    it "globals persist across script tags":
        val r = run_page_scripts(["window.foo = 7", "window.foo"])
        expect(r[1]).to_equal("7.0")
