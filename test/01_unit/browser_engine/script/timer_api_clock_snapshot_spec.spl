"""Browser timer API clock-injection contract."""

# @req REQ-WEB-BROWSER-017 NFR-WEB-BROWSER-006

use std.spec.*
use std.gc_async_mut.gpu.browser_engine.script.event_loop.{EventLoop}
use std.gc_async_mut.gpu.browser_engine.script.timer_api.{
    browser_clock_snapshot, set_timeout, set_timeout_at, set_interval_at,
    request_animation_frame_at
}

describe "browser timer clock snapshot":
    it "schedules timeout from the injected absolute clock basis":
        step("Inject one host clock sample and schedule without another host read")
        var el = EventLoop.new()
        val snapshot = browser_clock_snapshot(5000000)
        expect(set_timeout_at(el, 41, 25, snapshot)).to_equal(1)
        expect(el.drain_expired(5024999).len()).to_equal(0)
        val fired = el.drain_expired(5025000)
        expect(fired.len()).to_equal(1)
        expect(fired[0]).to_equal(41)

    it "keeps the compatibility facade on the last injected snapshot":
        step("Publish a host turn snapshot before using the legacy timer name")
        var el = EventLoop.new()
        el.update_clock_snapshot(7000000)
        expect(set_timeout(el, 52, 10)).to_equal(1)
        expect(el.drain_expired(7009999).len()).to_equal(0)
        expect(el.drain_expired(7010000)[0]).to_equal(52)

    it "uses one snapshot for intervals and animation frames":
        step("Schedule independent retained work from a shared host sample")
        var el = EventLoop.new()
        val snapshot = browser_clock_snapshot(9000000)
        expect(set_interval_at(el, 63, 20, snapshot)).to_equal(1)
        request_animation_frame_at(el, 64, snapshot)
        expect(el.next_due_micros()).to_equal(9016000)
        expect(el.drain_raf(9016000)[0]).to_equal(64)
        expect(el.drain_expired(9020000)[0]).to_equal(63)

    it "fails closed before a host snapshot and on deadline overflow":
        var el = EventLoop.new()
        expect(set_timeout(el, 70, 1)).to_equal(-1)
        expect(set_timeout_at(
            el, 71, 2, browser_clock_snapshot(9223372036854775000)
        )).to_equal(-1)
        request_animation_frame_at(el, 72, browser_clock_snapshot(-1))
        expect(el.pending_timer_count()).to_equal(0)
        expect(el.pending_raf_count()).to_equal(0)

    it "distinguishes an injected zero clock from a missing snapshot":
        step("Inject logical time zero without shifting the browser timeline")
        var el = EventLoop.new()
        el.update_clock_snapshot(0)
        expect(set_timeout(el, 81, 0)).to_equal(1)
        expect(el.drain_expired(0)[0]).to_equal(81)
        request_animation_frame_at(el, 82, browser_clock_snapshot(0))
        expect(el.next_due_micros()).to_equal(16000)
