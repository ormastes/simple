"""
## Purpose and audience
Purpose: Pin horizontal margins that the old sentinel encodings could not
hold, against Chrome 159 at k=1 (the catalog's Engine2D route) and k=4:
a negative percentage (`margin-left:-10%`, `margin-right:-10%`, in an inline
style and in a stylesheet rule) and the sign of `margin-inline`'s second
value. A percentage was stored as `0 - pct`, so `-10%` parsed as +10%;
`margin-inline`'s second value was read by `parse_nth_int`, which drops the
`-`. Cascade order between px, % and auto is pinned as a guard (green on
base).
Audience: web renderer style cascade (margins) and block layout.

Chrome oracle: Chrome for Testing 159.0.8154.6 aarch64, `--headless=new
--disable-gpu --hide-scrollbars --force-device-scale-factor=K`, window
400x300. Each case is a `.w` box (margin-left 40px, 200px wide, 30px tall)
stacked from y 0 holding a 20px tall #00f child. Runs are blue columns.

| case | child | k=1 Chrome / base | k=4 Chrome / base |
|------|-------|-------------------|-------------------|
| 0 | margin-left:-10%; width:40px | 20..59 / 60..99 | 80..239 / 240..399 |
| 1 | same, .w 215px wide (-21.5px) | 19..58 / 61..100 | 74..233 (not pinned: whole-px margin gives 76) |
| 2 | margin-inline:10px -10px (auto width) | 50..249 / 50..229 | 200..999 / 200..919 |
| 3 | margin-right:-10% (auto width) | 40..259 / 40..219 | 160..1039 / 160..879 |
| 4 | margin-left:10%;margin-left:5px | 45..84 (guard) | 180..339 (guard) |
| 5 | margin-left:5px;margin-left:10% | 60..99 (guard) | 240..399 (guard) |
| 6 | margin-left:10%;margin-left:auto | 200..239 (guard) | 800..959 (guard) |
| 7 | rule .p{margin-left:-10%} | 20..59 / 60..99 | 80..239 / 240..399 |
| 8 | rule .q{margin-inline:0 -10%} | 40..259 / 40..229 | 160..1039 / 160..919 |
"""

"""
Traceability: REQ-WEB-MARGIN-TYPED-HORIZONTAL-001 — a horizontal margin keeps its unit and sign: negative percentages and margin-inline's second value resolve as in Chrome.
"""
# @tag: unit, browser_engine, layout, margin, chrome159
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_foundation.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{
    simple_web_render_html_to_pixels_with_engine2d_backend
}
use gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_style.{renderer_default_style}
use gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_declarations.{apply_decls}
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}

val CSS_W: i32 = 400
val CSS_H: i32 = 300

val H: text = "height:20px;background:#00f"
val PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff}}.w{{margin-left:40px;width:200px;height:30px}}.p{{margin-left:-10%;width:40px;" + H + "}}.q{{margin-inline:0 -10%;" + H + "}}</style></head><body><div class=\"w\"><div style=\"margin-left:-10%;width:40px;" + H + "\"></div></div><div class=\"w\" style=\"width:215px\"><div style=\"margin-left:-10%;width:40px;" + H + "\"></div></div><div class=\"w\"><div style=\"margin-inline:10px -10px;" + H + "\"></div></div><div class=\"w\"><div style=\"margin-right:-10%;" + H + "\"></div></div><div class=\"w\"><div style=\"margin-left:10%;margin-left:5px;width:40px;" + H + "\"></div></div><div class=\"w\"><div style=\"margin-left:5px;margin-left:10%;width:40px;" + H + "\"></div></div><div class=\"w\"><div style=\"margin-left:10%;margin-left:auto;width:40px;" + H + "\"></div></div><div class=\"w\"><div class=\"p\"></div></div><div class=\"w\"><div class=\"q\"></div></div></body></html>"

var g_px1: [u32] = []
var g_px4: [u32] = []

fn _px(k: i32) -> [u32]:
    if k == 1:
        if g_px1.len() == 0:
            g_px1 = simple_web_render_html_to_pixels_with_engine2d_backend(PAGE, CSS_W, CSS_H, "cpu_simd")
        return g_px1
    if g_px4.len() == 0:
        g_px4 = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, 4, "cpu_simd")
    g_px4

# Blue runs " a..b" on the device row through CSS row `case * 30 + 10`.
fn _runs(k: i32, case_index: i32) -> text:
    val px = _px(k)
    val w = CSS_W * k
    val y = (case_index * 30 + 10) * k
    var out = ""
    var x = 0
    var inr = false
    var start = 0
    while x <= w:
        var blue = false
        if x < w:
            val v = px[y * w + x]
            val r = ((v >> 16u32) & 0xFFu32).to_i32()
            val b = (v & 0xFFu32).to_i32()
            blue = b > 128 and r < 128
        if blue and not inr:
            inr = true
            start = x
        if not blue and inr:
            inr = false
            out = out + " {start}..{x - 1}"
        x = x + 1
    out

describe "Horizontal margins keep their unit and sign (Chrome 159)":
    it "AC-1: margin-left:-10% moves the child left by 10% of the container":
        expect(_px(1).len()).to_equal((CSS_W * CSS_H) as i64)
        expect(_runs(1, 0)).to_equal(" 20..59")
        expect(_runs(4, 0)).to_equal(" 80..239")

    it "AC-2: -10% of a 215px container is -21.5px; the box snaps to column 19 at k=1":
        expect(_runs(1, 1)).to_equal(" 19..58")

    it "AC-3: margin-inline's second value keeps its sign (auto width grows by 10px)":
        expect(_runs(1, 2)).to_equal(" 50..249")
        expect(_runs(4, 2)).to_equal(" 200..999")

    it "AC-4: margin-right:-10% widens an auto-width child by 20px":
        expect(_runs(1, 3)).to_equal(" 40..259")
        expect(_runs(4, 3)).to_equal(" 160..1039")

    it "AC-5: the later of px, % and auto wins (guard)":
        expect(_runs(1, 4)).to_equal(" 45..84")
        expect(_runs(1, 5)).to_equal(" 60..99")
        expect(_runs(1, 6)).to_equal(" 200..239")
        expect(_runs(4, 4)).to_equal(" 180..339")
        expect(_runs(4, 5)).to_equal(" 240..399")
        expect(_runs(4, 6)).to_equal(" 800..959")

    it "AC-6: a stylesheet rule's margin-left:-10% resolves negative":
        expect(_runs(1, 7)).to_equal(" 20..59")
        expect(_runs(4, 7)).to_equal(" 80..239")

    it "AC-7: a stylesheet rule's margin-inline:0 -10% keeps the second value's sign":
        expect(_runs(1, 8)).to_equal(" 40..259")
        expect(_runs(4, 8)).to_equal(" 160..1039")

# [number, 1 if percent else 0, 1 if auto else 0] of a style's margin side.
fn _left(css: text) -> [i32]:
    val st = apply_decls(renderer_default_style(), css, 16)
    [st.margin_l, if st.margin_l_pct: 1 else: 0, if st.margin_l_auto: 1 else: 0]

fn _right(css: text) -> [i32]:
    val st = apply_decls(renderer_default_style(), css, 16)
    [st.margin_r, if st.margin_r_pct: 1 else: 0, if st.margin_r_auto: 1 else: 0]

describe "A horizontal margin's number, unit and auto flag after the cascade (both style paths)":
    it "AC-8: dispatch path (margin / margin-left only): the later declaration sets all three":
        expect(_left("margin-left:10%;margin-left:5px")).to_equal([5, 0, 0])
        expect(_left("margin-left:5px;margin-left:-10%")).to_equal([-10, 1, 0])
        expect(_left("margin-left:-10%;margin-left:auto")).to_equal([0, 0, 1])
        expect(_left("margin:0 -10%")).to_equal([-10, 1, 0])

    it "AC-9: full path (margin-inline / margin-inline-start present)":
        expect(_left("margin-inline-start:-10%;margin-left:5px")).to_equal([5, 0, 0])
        expect(_left("margin-left:5px;margin-inline-start:-10%")).to_equal([-10, 1, 0])
        expect(_right("margin-inline:0 -10%")).to_equal([-10, 1, 0])
        expect(_right("margin-inline:10px -10px")).to_equal([-10, 0, 0])
        expect(_left("margin-inline:auto 10px")).to_equal([0, 0, 1])
