"""
Purpose: Pin the device rows of every default (unstyled) form control at device
scale 1..4, against Chrome 159. Each control sits alone on a 16px/1.5 line.
Audience: web renderer layout / Draw IR device-scale maintainers.

Chrome oracle (headless shell 1255, Linux arm64, `--headless=new --disable-gpu
--hide-scrollbars --force-device-scale-factor=K --window-size=400,300
--screenshot`, Liberation Sans). `getBoundingClientRect()` of each control,
CSS px, top / height:

| control          | K=1       | K=2         | K=3            | K=4           |
|------------------|-----------|-------------|----------------|---------------|
| input (text)     | 2 / 21    | 2.5 / 21.5  | 2.333 / 21     | 2.5 / 21.25   |
| select           | 34 / 19   | 34.5 / 19   | 34.333 / 18.667| 34.75 / 18.75 |
| button           | 64 / 21   | 64.5 / 21.5 | 64.333 / 21    | 64.5 / 21.25  |
| textarea         | 93 / 36   | 93 / 37     | 93 / 36.667    | 93 / 37.5     |
| checkbox         | 147 / 13  | 148 / 13    | 147.667 / 13   | 148.5 / 13    |
| radio            | 178 / 13  | 179 / 13    | 178.667 / 13   | 179.5 / 13    |
| input (submit)   | 207 / 21  | 208 / 21.5  | 208 / 21       | 208.5 / 21.25 |

The HEIGHTS were already Chrome's device heights (85 / 75 / 85 / 150 / 52 at
K=4). The TOPS were not: Chrome lays the line out in device px, so its
baseline is the strut's device ascent (16px/1.5 Liberation Sans: 17, 35, 51,
70) and an atomic box hangs from that, where this engine kept every atomic box
at K x its CSS top (K=4: input 8 for Chrome's 10, select 12 for 15, checkbox
16 for 18). A `<select>` moves one more row at K=4: its inner block padding is
round(1.5K) device px (2, 3, 5, 6), of which the upper half-rounded-up (1, 2,
3, 3) is above the label, where K x 1 CSS px is 4.

Measured values are the non-white runs of two device columns of the
screenshot: column 2.5K (the frame of input, select, button, textarea, submit)
and column 10K below row 140K (checkbox, radio, submit).
Base (6b508da8f57) at K=4: `8-11 89-92 136-139 207-210 256-340 372-375 518-521
832-916` and `592-595 640-643 716-720 763-767 832-916`.
"""

"""
Traceability: REQ-WEB-DPR4-CONTROL-TOP-001 — at device scale k>1 an atomic form control hangs from the line's device-px baseline, so its frame paints on Chrome's device rows.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_foundation.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}

val CSS_W: i32 = 400
val CSS_H: i32 = 300

val PAGE: text = "<!doctype html><html><head><style>body{{margin:0;background:#fff;font:16px/1.5 'Liberation Sans'}}div{{margin:0 0 7px 0}}</style></head><body>" +
    "<div><input id=\"a\"></div>" +
    "<div><select id=\"b\"><option>One</option></select></div>" +
    "<div><button id=\"c\">Go</button></div>" +
    "<div><textarea id=\"d\"></textarea></div>" +
    "<div><input id=\"e\" type=\"checkbox\"></div>" +
    "<div><input id=\"f\" type=\"radio\"></div>" +
    "<div><input id=\"g\" type=\"submit\" value=\"Send\"></div>" +
    "</body></html>"

fn _is_white(px: u32) -> bool:
    (px & 0xFFFFFFu32) == 0xFFFFFFu32

# Non-white runs of device column `x` from row `y0` down, as "first-last ...".
fn _column_runs(px: [u32], k: i32, x: i32, y0: i32) -> text:
    val w = CSS_W * k
    val h = CSS_H * k
    if px.len() != (w * h) as i64:
        return "size-mismatch"
    var out = ""
    var start = -1
    var y = y0
    while y <= h:
        val ink = y < h and not _is_white(px[y * w + x])
        if ink and start < 0:
            start = y
        if not ink and start >= 0:
            out = out + (if out == "": "" else: " ") + start.to_text() + "-" + (y - 1).to_text()
            start = -1
        y = y + 1
    out

# Frame column (2.5 CSS px) and the checkbox / radio column (10 CSS px, below
# the textarea), joined by " | ".
fn _control_rows(k: i32) -> text:
    val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, k, "cpu_simd")
    _column_runs(px, k, 2 * k + k / 2, 0) + " | " + _column_runs(px, k, 10 * k, 140 * k)

describe "Default form controls at device scale 4 (Chrome 159)":
    it "AC-1: every control's frame paints on Chrome's device rows":
        step("input 10..94, select 139..213, button 258..342, textarea 372..521, checkbox 594..645, radio 718..769, submit 834..918")
        expect(_control_rows(4)).to_equal("10-13 91-94 139-142 210-213 258-342 372-375 518-521 834-918 | 594-597 642-645 718-722 765-769 834-918")

describe "Default form controls at device scale 2 and 3 (Chrome 159)":
    it "AC-2: scale 2 rows":
        expect(_control_rows(2)).to_equal("5-6 46-47 69-70 105-106 129-171 186-187 258-259 416-458 | 296-297 320-321 358-360 381-383 416-458")

    it "AC-3: scale 3 rows":
        expect(_control_rows(3)).to_equal("7-9 67-69 103-105 156-158 193-255 279-281 386-388 624-686 | 443-445 479-481 536-539 571-574 624-686")

describe "Default form controls leave scale 1 alone":
    it "AC-4 (guard): the 1x rows stay Chrome's":
        expect(_control_rows(1)).to_equal("2-2 22-22 34-34 52-52 64-84 93-93 128-128 207-227 | 147-147 159-159 178-179 189-190 207-227")
