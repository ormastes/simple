# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-BROWSER_ENGINE
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-BROWSER_ENGINE
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: Prove that decl_apply early returns.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-BROWSER-ENGINE-SIMPLE-WEB-HTML-LAYOUT-RENDERER-DECL-APPLY-COVERAGE-CLOSURE-SPEC-SPL-001 — stable requirement identity for this spec.
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_decl_apply.spl 64%
"""
# HTML Layout Renderer Decl Apply — Coverage Closure (tranche 3)

`simple_web_html_layout_renderer_decl_apply.spl` is one 2268-line function,
`_apply_decls_without_grid`, the full-probe declaration applier reached via
`apply_decls` whenever a declaration block contains at least one property the
O(k) dispatch table does not handle. This spec drives it black-box through
`apply_decls(renderer_default_style(), decls, em_base)`; every block appends
`letter-spacing` (documented in css_property_id_ok_dispatch_spec.spl as NOT
dispatch-handled) when needed so the full-probe body — this file — is the code
actually executed. Colors use relational oracles (keyword vs hex equivalence)
so the spec does not bake in the ARGB byte order.

Covered branch families: early returns (empty decls, over-quota rule),
box-model px/percent/em lengths, auto margins, borders (shorthand, per-side,
logical), display/position/inset, flex, overflow/visibility, typography
(font shorthand + variants), text decoration, backgrounds and gradients,
radius, z-index/opacity, transitions/animations, last-declaration-wins
ordering, and invalid-value rejection paths.
"""

use std.spec.step

use std.spec
use std.spec.step
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_declarations.{apply_decls}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_style.{renderer_default_style, Style}

fn ap(decls: text) -> Style:
    # letter-spacing is not dispatch-handled -> forces the full-probe body
    apply_decls(renderer_default_style(), decls + ";letter-spacing:0px", 16)

describe "decl_apply early returns":
    # @manual scenario evidence
    it "empty declaration block returns the style unchanged":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("empty declaration block returns the style unchanged")
        step("Verify: empty declaration block returns the style unchanged")
        # @req: REQ-BROWSER-ENGINE-SIMPLE-WEB-HTML-LAYOUT-RENDERER-DECL-APPLY-COVERAGE-CLOSURE-SPEC-SPL-001
        val base = renderer_default_style()
        val st = apply_decls(base, "", 16)
        expect(st.width_px).to_equal(base.width_px)
        expect(st.fg).to_equal(base.fg)

    it "a rule over the per-rule declaration quota is dropped wholesale":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("a rule over the per-rule declaration quota is dropped wholesale")
        step("Verify: a rule over the per-rule declaration quota is dropped wholesale")
        var decls = "width:10px"
        var i = 0
        while i < 260:
            decls = decls + ";color:#123456"
            i = i + 1
        val st = apply_decls(renderer_default_style(), decls, 16)
        val base = renderer_default_style()
        expect(st.width_px).to_equal(base.width_px)
        expect(st.fg).to_equal(base.fg)

describe "decl_apply box model lengths":
    it "applies width/height/min/max in px":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("applies width/height/min/max in px")
        step("Verify: applies width/height/min/max in px")
        val st = ap("width:120px;height:48px;min-width:10px;max-width:300px;min-height:5px;max-height:400px")
        expect(st.width_px).to_equal(120)
        expect(st.height_px).to_equal(48)
        expect(st.min_width_px).to_equal(10)
        expect(st.max_width_px).to_equal(300)
        expect(st.min_height_px).to_equal(5)
        expect(st.max_height_px).to_equal(400)

    it "font-size em lengths scale by em_base (width does not support em)":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("font-size em lengths scale by em_base (width does not support em)")
        step("Verify: font-size em lengths scale by em_base (width does not support em)")
        val st = apply_decls(renderer_default_style(), "font-size:2em;letter-spacing:0px", 20)
        expect(st.font_size).to_equal(40)
        # width has no em branch: the numeric prefix is taken as-is
        val w = apply_decls(renderer_default_style(), "width:2em;letter-spacing:0px", 20)
        expect(w.width_px).to_equal(2)

    it "padding shorthand 1/2/4-value forms":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("padding shorthand 1/2/4-value forms")
        step("Verify: padding shorthand 1/2/4-value forms")
        val one = ap("padding:8px")
        expect(one.pad_l).to_equal(8)
        expect(one.pad_t).to_equal(8)
        expect(one.pad_r).to_equal(8)
        expect(one.pad_b).to_equal(8)
        val two = ap("padding:4px 12px")
        expect(two.pad_t).to_equal(4)
        expect(two.pad_b).to_equal(4)
        expect(two.pad_l).to_equal(12)
        expect(two.pad_r).to_equal(12)
        val four = ap("padding:1px 2px 3px 4px")
        expect(four.pad_t).to_equal(1)
        expect(four.pad_r).to_equal(2)
        expect(four.pad_b).to_equal(3)
        expect(four.pad_l).to_equal(4)

    it "margin shorthand and auto margins":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("margin shorthand and auto margins")
        step("Verify: margin shorthand and auto margins")
        val st = ap("margin:5px 6px 7px 8px")
        expect(st.margin_t).to_equal(5)
        expect(st.margin_r).to_equal(6)
        expect(st.margin_b).to_equal(7)
        expect(st.margin_l).to_equal(8)
        val au = ap("margin:0 auto")
        expect(au.margin_l_auto).to_equal(true)
        expect(au.margin_r_auto).to_equal(true)
        expect(au.margin_t_auto).to_equal(false)

    it "individual margin/padding longhands win over earlier shorthand":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("individual margin/padding longhands win over earlier shorthand")
        step("Verify: individual margin/padding longhands win over earlier shorthand")
        val st = ap("margin:2px;margin-left:9px;padding:3px;padding-bottom:11px")
        expect(st.margin_l).to_equal(9)
        expect(st.margin_t).to_equal(2)
        expect(st.pad_b).to_equal(11)
        expect(st.pad_t).to_equal(3)

    it "box-sizing border-box toggles border_box":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("box-sizing border-box toggles border_box")
        step("Verify: box-sizing border-box toggles border_box")
        expect(ap("box-sizing:border-box").border_box).to_equal(true)
        expect(ap("box-sizing:content-box").border_box).to_equal(false)

describe "decl_apply borders":
    it "border shorthand sets width, sides and color":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("border shorthand sets width, sides and color")
        step("Verify: border shorthand sets width, sides and color")
        val st = ap("border:3px solid #112233")
        expect(st.border_w).to_equal(3)
        expect(st.border_l).to_equal(3)
        expect(st.border_b).to_equal(3)
        # same color through the border-color longhand path (relational oracle)
        expect(st.border_color).to_equal(ap("border-color:#112233").border_color)

    it "per-side border widths (left/right require a paintable style)":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("per-side border widths (left/right require a paintable style)")
        step("Verify: per-side border widths (left/right require a paintable style)")
        val st = ap("border-left-style:solid;border-right-style:solid;border-left-width:1px;border-top-width:2px;border-right-width:3px;border-bottom-width:4px")
        expect(st.border_l).to_equal(1)
        expect(st.border_t).to_equal(2)
        expect(st.border_r).to_equal(3)
        expect(st.border_b).to_equal(4)

    it "l/r widths without a border style are zeroed (default style none), t/b are kept":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("l/r widths without a border style are zeroed (default style none), t/b are kept")
        step("Verify: l/r widths without a border style are zeroed (default style none), t/b are kept")
        # Style only tracks border_style_l/border_style_r; the none/hidden
        # paint-disable pass therefore applies to left/right only.
        val st = ap("border-left-width:1px;border-top-width:2px;border-right-width:3px;border-bottom-width:4px")
        expect(st.border_l).to_equal(0)
        expect(st.border_r).to_equal(0)
        expect(st.border_t).to_equal(2)
        expect(st.border_b).to_equal(4)

    it "per-side border colors parse hex":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("per-side border colors parse hex")
        step("Verify: per-side border colors parse hex")
        val st = ap("border-left-color:#0000ff;border-top-color:#0000ff")
        expect(st.border_color_l).to_equal(st.border_color_t)
        expect(st.border_color_l == renderer_default_style().border_color_l).to_equal(false)

    it "border-radius shorthand and corners":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("border-radius shorthand and corners")
        step("Verify: border-radius shorthand and corners")
        val st = ap("border-radius:6px")
        expect(st.border_radius_px).to_equal(6)
        val c = ap("border-radius:1px 2px 3px 4px")
        expect(c.border_radius_tl_px).to_equal(1)
        expect(c.border_radius_tr_px).to_equal(2)
        expect(c.border_radius_br_px).to_equal(3)
        expect(c.border_radius_bl_px).to_equal(4)

    it "outline shorthand sets width and offset longhand applies":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("outline shorthand sets width and offset longhand applies")
        step("Verify: outline shorthand sets width and offset longhand applies")
        val st = ap("outline:2px solid red;outline-offset:3px")
        expect(st.outline_w).to_equal(2)
        expect(st.outline_offset_px).to_equal(3)

    it "border-collapse and border-spacing":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("border-collapse and border-spacing")
        step("Verify: border-collapse and border-spacing")
        val st = ap("border-collapse:collapse;border-spacing:4px 7px")
        expect(st.border_collapse).to_equal("collapse")
        expect(st.border_spacing_x_px).to_equal(4)
        expect(st.border_spacing_y_px).to_equal(7)

describe "decl_apply display, position, inset":
    it "display keywords land in display":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("display keywords land in display")
        step("Verify: display keywords land in display")
        expect(ap("display:flex").display).to_equal("flex")
        expect(ap("display:none").display).to_equal("none")
        expect(ap("display:inline-block").display).to_equal("inline-block")

    it "position keywords set the exclusive position flags":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("position keywords set the exclusive position flags")
        step("Verify: position keywords set the exclusive position flags")
        val rel = ap("position:relative")
        expect(rel.position_relative).to_equal(true)
        expect(rel.position_absolute).to_equal(false)
        val abs = ap("position:absolute;left:10px;top:20px;right:30px;bottom:40px")
        expect(abs.position_absolute).to_equal(true)
        expect(abs.left_px).to_equal(10)
        expect(abs.top_px).to_equal(20)
        expect(abs.right_px).to_equal(30)
        expect(abs.bottom_px).to_equal(40)
        expect(ap("position:fixed").position_fixed).to_equal(true)
        expect(ap("position:sticky").position_sticky).to_equal(true)

    it "z-index and opacity":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("z-index and opacity")
        step("Verify: z-index and opacity")
        expect(ap("z-index:7").z_index).to_equal(7)
        expect(ap("opacity:0.5").opacity_pct).to_equal(50)
        expect(ap("opacity:1").opacity_pct).to_equal(100)

describe "decl_apply flex":
    it "flex container properties":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("flex container properties")
        step("Verify: flex container properties")
        val st = ap("flex-direction:column;flex-wrap:wrap;justify-content:center;align-items:center;align-content:center;gap:9px")
        expect(st.flex_direction).to_equal("column")
        expect(st.flex_wrap).to_equal("wrap")
        expect(st.justify_content).to_equal("center")
        expect(st.align_items).to_equal("center")
        expect(st.align_content).to_equal("center")
        expect(st.gap_px).to_equal(9)

    it "row-gap and column-gap longhands":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("row-gap and column-gap longhands")
        step("Verify: row-gap and column-gap longhands")
        val st = ap("row-gap:3px;column-gap:5px")
        expect(st.row_gap_px).to_equal(3)
        expect(st.column_gap_px).to_equal(5)

    it "flex item properties":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("flex item properties")
        step("Verify: flex item properties")
        val st = ap("flex-grow:2;flex-shrink:3;flex-basis:44px;order:5;align-self:end")
        expect(st.flex_grow).to_equal(2)
        expect(st.flex_shrink).to_equal(3)
        expect(st.flex_basis_px).to_equal(44)
        expect(st.order).to_equal(5)

describe "decl_apply overflow and visibility":
    it "overflow hidden and scroll axes":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("overflow hidden and scroll axes")
        step("Verify: overflow hidden and scroll axes")
        expect(ap("overflow:hidden").overflow_hidden).to_equal(true)
        expect(ap("overflow-y:auto").overflow_auto_y).to_equal(true)
        expect(ap("overflow-y:scroll").overflow_scroll_y).to_equal(true)

    it "visibility and content-visibility hidden":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("visibility and content-visibility hidden")
        step("Verify: visibility and content-visibility hidden")
        expect(ap("visibility:hidden").visibility_hidden).to_equal(true)
        expect(ap("visibility:visible").visibility_hidden).to_equal(false)
        expect(ap("content-visibility:hidden").content_visibility_hidden).to_equal(true)

    it "text-overflow ellipsis and white-space nowrap":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("text-overflow ellipsis and white-space nowrap")
        step("Verify: text-overflow ellipsis and white-space nowrap")
        expect(ap("text-overflow:ellipsis").text_overflow_ellipsis).to_equal(true)
        expect(ap("white-space:nowrap").white_space_nowrap).to_equal(true)

describe "decl_apply typography":
    it "font-size, family, weight, style, line-height":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("font-size, family, weight, style, line-height")
        step("Verify: font-size, family, weight, style, line-height")
        val st = ap("font-size:22px;font-family:Georgia;font-weight:bold;font-style:italic;line-height:30px")
        expect(st.font_size).to_equal(22)
        expect(st.font_family).to_equal("Georgia")
        expect(st.bold).to_equal(true)
        expect(st.font_style_italic).to_equal(true)
        expect(st.line_height_px).to_equal(30)

    it "numeric font-weight 700 is bold, 400 is not":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("numeric font-weight 700 is bold, 400 is not")
        step("Verify: numeric font-weight 700 is bold, 400 is not")
        expect(ap("font-weight:700").bold).to_equal(true)
        expect(ap("font-weight:400").bold).to_equal(false)

    it "font shorthand sets size and family":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("font shorthand sets size and family")
        step("Verify: font shorthand sets size and family")
        val st = ap("font:italic bold 18px/24px Verdana")
        expect(st.font_size).to_equal(18)
        expect(st.font_family).to_equal("Verdana")

    it "text-align and text-transform and text-indent":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("text-align and text-transform and text-indent")
        step("Verify: text-align and text-transform and text-indent")
        val st = ap("text-align:center;text-transform:uppercase;text-indent:12px")
        expect(st.text_align).to_equal("center")
        expect(st.text_transform).to_equal("uppercase")
        expect(st.text_indent_px).to_equal(12)

    it "letter-spacing and word-spacing":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("letter-spacing and word-spacing")
        step("Verify: letter-spacing and word-spacing")
        val st = apply_decls(renderer_default_style(), "letter-spacing:3px;word-spacing:5px", 16)
        expect(st.letter_spacing_px).to_equal(3)
        expect(st.word_spacing_px).to_equal(5)

    it "direction and writing-mode":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("direction and writing-mode")
        step("Verify: direction and writing-mode")
        val st = ap("direction:rtl;writing-mode:vertical-rl")
        expect(st.direction_rtl).to_equal(true)
        expect(st.writing_mode).to_equal("vertical-rl")

    it "font-variant-caps and font-kerning keywords are recorded":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("font-variant-caps and font-kerning keywords are recorded")
        step("Verify: font-variant-caps and font-kerning keywords are recorded")
        val st = ap("font-variant-caps:small-caps;font-kerning:none")
        expect(st.font_variant_caps).to_equal("small-caps")
        expect(st.font_kerning).to_equal("none")

describe "decl_apply text decoration":
    it "text-decoration line kinds":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("text-decoration line kinds")
        step("Verify: text-decoration line kinds")
        val u = ap("text-decoration:underline")
        expect(u.text_decoration_underline).to_equal(true)
        val l = ap("text-decoration:line-through")
        expect(l.text_decoration_line_through).to_equal(true)
        val o = ap("text-decoration:overline")
        expect(o.text_decoration_overline).to_equal(true)

    it "text-decoration none clears underline":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("text-decoration none clears underline")
        step("Verify: text-decoration none clears underline")
        val st = ap("text-decoration:underline;text-decoration:none")
        expect(st.text_decoration_underline).to_equal(false)

    it "decoration style, thickness and underline offset":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("decoration style, thickness and underline offset")
        step("Verify: decoration style, thickness and underline offset")
        val st = ap("text-decoration-style:dashed;text-decoration-thickness:2px;text-underline-offset:4px")
        expect(st.text_decoration_style).to_equal("dashed")
        expect(st.text_decoration_thickness_px).to_equal(2)
        expect(st.text_underline_offset_px).to_equal(4)

describe "decl_apply backgrounds":
    it "background-color parses hex directly and keywords via the named table":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("background-color parses hex directly and keywords via the named table")
        step("Verify: background-color parses hex directly and keywords via the named table")
        val hex = ap("background-color:#ff0000")
        expect(hex.bg).to_equal(0xFFFF0000u32)
        # 'red' resolves through the named-color table (a themed red, not #ff0000)
        val kw = ap("background-color:red")
        expect(kw.bg == renderer_default_style().bg).to_equal(false)

    it "background repeat, attachment, clip, origin keywords":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("background repeat, attachment, clip, origin keywords")
        step("Verify: background repeat, attachment, clip, origin keywords")
        val st = ap("background-repeat:no-repeat;background-attachment:fixed;background-clip:padding-box;background-origin:border-box")
        expect(st.background_repeat).to_equal("no-repeat")
        expect(st.background_attachment).to_equal("fixed")
        expect(st.background_clip).to_equal("padding-box")
        expect(st.background_origin).to_equal("border-box")

    it "background-size and position in px":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("background-size and position in px")
        step("Verify: background-size and position in px")
        val st = ap("background-size:40px 30px;background-position:10px 20px")
        expect(st.background_size_w_px).to_equal(40)
        expect(st.background_size_h_px).to_equal(30)
        expect(st.background_position_x_px).to_equal(10)
        expect(st.background_position_y_px).to_equal(20)

    it "background-image url is recorded":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("background-image url is recorded")
        step("Verify: background-image url is recorded")
        val st = ap("background-image:url(foo.png)")
        expect(st.background_image_uri.contains("foo.png")).to_equal(true)

    it "background-image linear-gradient records from/to and the stop model":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("background-image linear-gradient records from/to and the stop model")
        step("Verify: background-image linear-gradient records from/to and the stop model")
        val st = ap("background-image:linear-gradient(#ff0000,#0000ff)")
        expect(st.background_gradient_from).to_equal(0xFFFF0000u32)
        expect(st.background_gradient_to).to_equal(0xFF0000FFu32)
        expect(st.background_gradient_stop_colors.len()).to_equal(2)
        # the background SHORTHAND keeps the layer raw instead of decoding here
        val sh = ap("background:linear-gradient(to bottom,#ff0000,#0000ff)")
        expect(sh.background_gradient_from).to_equal(0u32)
        expect(sh.bg_layers_raw.contains("linear-gradient")).to_equal(true)

describe "decl_apply shadows and misc":
    it "box-shadow sets offsets and blur":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("box-shadow sets offsets and blur")
        step("Verify: box-shadow sets offsets and blur")
        val st = ap("box-shadow:2px 3px 4px rgba(0,0,0,0.5)")
        expect(st.box_shadow_x_px).to_equal(2)
        expect(st.box_shadow_y_px).to_equal(3)
        expect(st.box_shadow_blur_px).to_equal(4)

    it "text-shadow sets offsets":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("text-shadow sets offsets")
        step("Verify: text-shadow sets offsets")
        val st = ap("text-shadow:1px 2px #000000")
        expect(st.text_shadow_x_px).to_equal(1)
        expect(st.text_shadow_y_px).to_equal(2)

    it "cursor, caption-side, table-layout, vertical-align keywords":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("cursor, caption-side, table-layout, vertical-align keywords")
        step("Verify: cursor, caption-side, table-layout, vertical-align keywords")
        val st = ap("cursor:pointer;caption-side:bottom;table-layout:fixed;vertical-align:middle")
        expect(st.cursor).to_equal("pointer")
        expect(st.caption_side).to_equal("bottom")
        expect(st.table_layout).to_equal("fixed")
        expect(st.vertical_align).to_equal("middle")

    it "transition and animation longhands are recorded":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("transition and animation longhands are recorded")
        step("Verify: transition and animation longhands are recorded")
        val st = ap("transition-property:opacity;transition-duration:200ms;animation-name:spin;animation-duration:1s;animation-iteration-count:3")
        expect(st.transition_property).to_equal("opacity")
        expect(st.transition_duration_ms).to_equal(200)
        expect(st.animation_name).to_equal("spin")
        expect(st.animation_duration_ms).to_equal(1000)

describe "decl_apply logical border longhands (tranche 4)":
    it "border-block shorthand sets top+bottom width and color together":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("border-block shorthand sets top+bottom width and color together")
        step("Verify: border-block shorthand sets top+bottom width and color together")
        val st = ap("border-block:3px solid #112233")
        expect(st.border_t).to_equal(3)
        expect(st.border_b).to_equal(3)
        expect(st.border_color_t).to_equal(st.border_color_b)
        expect(st.border_color_t == renderer_default_style().border_color_t).to_equal(false)

    it "border-block-start/end map to top/bottom independently":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("border-block-start/end map to top/bottom independently")
        step("Verify: border-block-start/end map to top/bottom independently")
        val st = ap("border-block-start:2px solid #ff0000;border-block-end:5px solid #00ff00")
        expect(st.border_t).to_equal(2)
        expect(st.border_b).to_equal(5)
        expect(st.border_color_t == st.border_color_b).to_equal(false)

    it "bare border-block:none disables top/bottom paint; a multi-token value does not":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("bare border-block:none disables top/bottom paint; a multi-token value does not")
        step("Verify: bare border-block:none disables top/bottom paint; a multi-token value does not")
        # border_style_disables_paint matches only a BARE none/hidden value
        val bare = ap("border:4px solid #112233;border-block:none")
        expect(bare.border_t).to_equal(0)
        expect(bare.border_b).to_equal(0)
        val multi = ap("border-block:4px none #112233")
        expect(multi.border_t).to_equal(4)
        expect(multi.border_b).to_equal(4)

    it "border-inline shorthand sets left+right width, style and color":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("border-inline shorthand sets left+right width, style and color")
        step("Verify: border-inline shorthand sets left+right width, style and color")
        val st = ap("border-inline:3px solid #112233")
        expect(st.border_l).to_equal(3)
        expect(st.border_r).to_equal(3)
        expect(st.border_color_l).to_equal(st.border_color_r)

    it "border-inline-start/end map to left/right and carry their style":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("border-inline-start/end map to left/right and carry their style")
        step("Verify: border-inline-start/end map to left/right and carry their style")
        val st = ap("border-inline-start:1px solid #ff0000;border-inline-end:6px solid #0000ff")
        expect(st.border_l).to_equal(1)
        expect(st.border_r).to_equal(6)
        expect(st.border_color_l == st.border_color_r).to_equal(false)

    it "border-inline-start with hidden style zeroes the left width":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("border-inline-start with hidden style zeroes the left width")
        step("Verify: border-inline-start with hidden style zeroes the left width")
        val st = ap("border-inline-start:7px hidden #ff0000")
        expect(st.border_l).to_equal(0)

    it "border-block-width and border-inline-width take two-value forms":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("border-block-width and border-inline-width take two-value forms")
        step("Verify: border-block-width and border-inline-width take two-value forms")
        val st = ap("border-block-width:1px 2px;border-inline-width:3px 4px;border-inline-style:solid")
        expect(st.border_t).to_equal(1)
        expect(st.border_b).to_equal(2)
        expect(st.border_l).to_equal(3)
        expect(st.border_r).to_equal(4)

    it "border-block-start/end-width single-side widths apply":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("border-block-start/end-width single-side widths apply")
        step("Verify: border-block-start/end-width single-side widths apply")
        val st = ap("border-block-start-width:9px;border-block-end-width:8px")
        expect(st.border_t).to_equal(9)
        expect(st.border_b).to_equal(8)

    it "border-inline-start/end-width need a paintable inline style":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("border-inline-start/end-width need a paintable inline style")
        step("Verify: border-inline-start/end-width need a paintable inline style")
        val st = ap("border-inline-style:solid;border-inline-start-width:5px;border-inline-end-width:6px")
        expect(st.border_l).to_equal(5)
        expect(st.border_r).to_equal(6)

    it "logical border colors mirror the physical color longhands":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("logical border colors mirror the physical color longhands")
        step("Verify: logical border colors mirror the physical color longhands")
        val phys = ap("border-top-color:#123456;border-bottom-color:#123456;border-left-color:#654321;border-right-color:#654321")
        val logical = ap("border-block-color:#123456;border-inline-color:#654321")
        expect(logical.border_color_t).to_equal(phys.border_color_t)
        expect(logical.border_color_b).to_equal(phys.border_color_b)
        expect(logical.border_color_l).to_equal(phys.border_color_l)
        expect(logical.border_color_r).to_equal(phys.border_color_r)

    it "border-block-start/end-color and border-inline-start/end-color set one side each":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("border-block-start/end-color and border-inline-start/end-color set one side each")
        step("Verify: border-block-start/end-color and border-inline-start/end-color set one side each")
        val st = ap("border-block-start-color:#ff0000;border-block-end-color:#00ff00;border-inline-start-color:#0000ff;border-inline-end-color:#ffffff")
        expect(st.border_color_t == st.border_color_b).to_equal(false)
        expect(st.border_color_l == st.border_color_r).to_equal(false)

    it "border-block-style and border-inline-style none disable their axes":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("border-block-style and border-inline-style none disable their axes")
        step("Verify: border-block-style and border-inline-style none disable their axes")
        val st = ap("border:3px solid #112233;border-block-style:none;border-inline-style:hidden")
        expect(st.border_t).to_equal(0)
        expect(st.border_b).to_equal(0)
        expect(st.border_l).to_equal(0)
        expect(st.border_r).to_equal(0)

    it "border-block-start-style/none zeroes only top; end-style only bottom":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("border-block-start-style/none zeroes only top; end-style only bottom")
        step("Verify: border-block-start-style/none zeroes only top; end-style only bottom")
        val t = ap("border:2px solid #112233;border-block-start-style:none")
        expect(t.border_t).to_equal(0)
        expect(t.border_b).to_equal(2)
        val b = ap("border:2px solid #112233;border-block-end-style:none")
        expect(b.border_b).to_equal(0)
        expect(b.border_t).to_equal(2)

    it "border-inline-start/end-style tokens land in the side style slots":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("border-inline-start/end-style tokens land in the side style slots")
        step("Verify: border-inline-start/end-style tokens land in the side style slots")
        val st = ap("border:2px solid #112233;border-inline-start-style:dashed;border-inline-end-style:dotted")
        expect(st.border_l).to_equal(2)
        expect(st.border_r).to_equal(2)

    it "border-style shorthand none disables every side":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("border-style shorthand none disables every side")
        step("Verify: border-style shorthand none disables every side")
        val st = ap("border:3px solid #112233;border-style:none")
        expect(st.border_w).to_equal(0)
        expect(st.border_l).to_equal(0)
        expect(st.border_t).to_equal(0)
        expect(st.border_r).to_equal(0)
        expect(st.border_b).to_equal(0)

describe "decl_apply animation and transition shorthands (tranche 4)":
    it "animation shorthand decodes name, times, timing, count, direction, fill, play state":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("animation shorthand decodes name, times, timing, count, direction, fill, play state")
        step("Verify: animation shorthand decodes name, times, timing, count, direction, fill, play state")
        val st = ap("animation:spin 2s 500ms ease-in-out 3 alternate both paused")
        expect(st.animation_name).to_equal("spin")
        expect(st.animation_duration_ms).to_equal(2000)
        expect(st.animation_delay_ms).to_equal(500)
        expect(st.animation_timing_function).to_equal("ease-in-out")
        expect(st.animation_iteration_count).to_equal("3")
        expect(st.animation_direction).to_equal("alternate")
        expect(st.animation_fill_mode).to_equal("both")
        expect(st.animation_play_state).to_equal("paused")

    it "animation shorthand keyword defaults survive a minimal form":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("animation shorthand keyword defaults survive a minimal form")
        step("Verify: animation shorthand keyword defaults survive a minimal form")
        val st = ap("animation:fade 1s")
        expect(st.animation_name).to_equal("fade")
        expect(st.animation_duration_ms).to_equal(1000)
        expect(st.animation_delay_ms).to_equal(0)
        expect(st.animation_direction).to_equal("normal")
        expect(st.animation_play_state).to_equal("running")

    it "later animation longhands override the shorthand, earlier ones do not":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("later animation longhands override the shorthand, earlier ones do not")
        step("Verify: later animation longhands override the shorthand, earlier ones do not")
        val late = ap("animation:spin 2s;animation-duration:250ms;animation-delay:40ms")
        expect(late.animation_duration_ms).to_equal(250)
        expect(late.animation_delay_ms).to_equal(40)
        expect(late.animation_name).to_equal("spin")
        val early = ap("animation-duration:250ms;animation:spin 2s")
        expect(early.animation_duration_ms).to_equal(2000)

    it "animation-timing-function and iteration-count longhands after the shorthand win":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("animation-timing-function and iteration-count longhands after the shorthand win")
        step("Verify: animation-timing-function and iteration-count longhands after the shorthand win")
        val st = ap("animation:spin 1s linear 2;animation-timing-function:ease-out;animation-iteration-count:infinite")
        expect(st.animation_timing_function).to_equal("ease-out")
        expect(st.animation_iteration_count).to_equal("infinite")

    it "transition shorthand decodes property, duration, delay and timing":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("transition shorthand decodes property, duration, delay and timing")
        step("Verify: transition shorthand decodes property, duration, delay and timing")
        val st = ap("transition:opacity 300ms 100ms ease-in")
        expect(st.transition_property).to_equal("opacity")
        expect(st.transition_duration_ms).to_equal(300)
        expect(st.transition_delay_ms).to_equal(100)
        expect(st.transition_timing_function).to_equal("ease-in")

    it "later transition longhands override the shorthand":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("later transition longhands override the shorthand")
        step("Verify: later transition longhands override the shorthand")
        val st = ap("transition:opacity 300ms;transition-duration:50ms;transition-timing-function:linear;transition-delay:5ms")
        expect(st.transition_duration_ms).to_equal(50)
        expect(st.transition_delay_ms).to_equal(5)
        expect(st.transition_timing_function).to_equal("linear")
        expect(st.transition_property).to_equal("opacity")

describe "decl_apply ordering and rejection":
    it "last declaration wins within one block":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("last declaration wins within one block")
        step("Verify: last declaration wins within one block")
        val st = ap("width:10px;width:90px;color:#ff0000;color:#00ff00")
        expect(st.width_px).to_equal(90)
        val green = ap("color:#00ff00")
        expect(st.fg).to_equal(green.fg)

    it "an unparseable last width parses to 0 (last-wins, no CSS-style rollback)":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("an unparseable last width parses to 0 (last-wins, no CSS-style rollback)")
        step("Verify: an unparseable last width parses to 0 (last-wins, no CSS-style rollback)")
        # CSS would keep 50px; this applier is last-declaration-wins on the raw
        # value, so 'banana' parses to 0. Documented current behavior.
        val st = ap("width:50px;width:banana")
        expect(st.width_px).to_equal(0)

    it "unknown property names are ignored without disturbing neighbors":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("unknown property names are ignored without disturbing neighbors")
        step("Verify: unknown property names are ignored without disturbing neighbors")
        val st = ap("not-a-prop:12;height:33px")
        expect(st.height_px).to_equal(33)

    it "whitespace and trailing semicolons are tolerated":
        # @req REQ-SSPEC-BROWSER_ENGINE
        step("whitespace and trailing semicolons are tolerated")
        step("Verify: whitespace and trailing semicolons are tolerated")
        val st = ap("  width : 25px ;; height:14px ; ")
        expect(st.width_px).to_equal(25)
        expect(st.height_px).to_equal(14)

describe "decl_apply display keyword arms (tranche 5)":
    it "inline, list-item, grid and block keyword arms land in display":
        expect(ap("display:inline").display).to_equal("inline")
        expect(ap("display:list-item").display).to_equal("list-item")
        expect(ap("display:grid").display).to_equal("grid")
        expect(ap("display:block").display).to_equal("block")

    it "display:contents strips every box-generating property":
        val st = ap("background-color:#ff0000;width:40px;height:30px;padding:5px;border:2px solid #112233;outline:1px solid #445566;margin:6px auto;display:contents")
        expect(st.display).to_equal("contents")
        expect(st.bg).to_equal(0u32)
        expect(st.width_px).to_equal(0)
        expect(st.height_px).to_equal(0)
        expect(st.pad_l).to_equal(0)
        expect(st.border_w).to_equal(0)
        expect(st.border_l).to_equal(0)
        expect(st.outline_w).to_equal(0)
        expect(st.margin_l).to_equal(0)
        expect(st.margin_l_auto).to_equal(false)
        expect(st.margin_r_auto).to_equal(false)

describe "decl_apply overflow, contain, color-scheme (tranche 5)":
    it "overflow-x:hidden and overflow-y:hidden set overflow_hidden":
        expect(ap("overflow-x:hidden").overflow_hidden).to_equal(true)
        expect(ap("overflow-y:hidden").overflow_hidden).to_equal(true)

    it "contain:paint implies overflow clipping":
        expect(ap("contain:paint").overflow_hidden).to_equal(true)

    it "color-scheme:dark themes an unset bg and default fg":
        val st = ap("color-scheme:dark")
        expect(st.bg == 0u32).to_equal(false)
        expect(st.fg == renderer_default_style().fg).to_equal(false)

    it "scrollbar-color with two colors sets thumb and track":
        val st = ap("scrollbar-color:#112233 #445566")
        expect(st.scrollbar_thumb_color == 0u32).to_equal(false)
        expect(st.scrollbar_track_color == 0u32).to_equal(false)
        expect(st.scrollbar_thumb_color == st.scrollbar_track_color).to_equal(false)

    it "content-visibility:visible resets the hidden flag":
        val st = ap("content-visibility:hidden;content-visibility:visible")
        expect(st.content_visibility_hidden).to_equal(false)

describe "decl_apply print and paged-media keywords (tranche 5)":
    it "color-adjust, forced-color-adjust and print-color-adjust keywords":
        val st = ap("color-adjust:economy;forced-color-adjust:none;print-color-adjust:exact")
        expect(st.color_adjust).to_equal("economy")
        expect(st.forced_color_adjust).to_equal("none")
        expect(st.print_color_adjust).to_equal("exact")

    it "orphans and widows record positive counts":
        val st = ap("orphans:3;widows:2")
        expect(st.orphans).to_equal(3)
        expect(st.widows).to_equal(2)

    it "will-change accepts the known keyword set":
        expect(ap("will-change:transform").will_change).to_equal("transform")

describe "decl_apply position, inset and transforms (tranche 5)":
    it "position:static clears every position flag":
        val st = ap("position:relative;position:static")
        expect(st.position_relative).to_equal(false)
        expect(st.position_absolute).to_equal(false)
        expect(st.position_sticky).to_equal(false)
        expect(st.position_fixed).to_equal(false)

    it "top:auto is 0 for non-sticky and a sticky-auto sentinel for sticky":
        expect(ap("top:auto").top_px).to_equal(0)
        expect(ap("position:sticky;top:auto").top_px == 0).to_equal(false)

    it "inset four-value shorthand feeds all four offsets":
        val st = ap("inset:1px 2px 3px 4px")
        expect(st.top_px).to_equal(1)
        expect(st.right_px).to_equal(2)
        expect(st.bottom_px).to_equal(3)
        expect(st.left_px).to_equal(4)

    it "inset-block and inset-inline two-value forms":
        val st = ap("inset-block:5px 6px;inset-inline:7px 8px")
        expect(st.top_px).to_equal(5)
        expect(st.bottom_px).to_equal(6)
        expect(st.left_px).to_equal(7)
        expect(st.right_px).to_equal(8)

    it "inset-block-start/end and inset-inline-start/end single sides":
        val st = ap("inset-block-start:1px;inset-block-end:2px;inset-inline-start:3px;inset-inline-end:4px")
        expect(st.top_px).to_equal(1)
        expect(st.bottom_px).to_equal(2)
        expect(st.left_px).to_equal(3)
        expect(st.right_px).to_equal(4)

    it "filter:opacity multiplies into opacity_pct":
        expect(ap("filter:opacity(50%)").opacity_pct).to_equal(50)

    it "clip rect narrows an explicit width and height":
        val st = ap("width:100px;height:100px;clip:rect(0px, 40px, 30px, 10px)")
        expect(st.width_px).to_equal(30)
        expect(st.height_px).to_equal(30)

    it "transform translate offsets the box and forces relative":
        val st = ap("transform:translate(5px, 6px)")
        expect(st.left_px).to_equal(5)
        expect(st.top_px).to_equal(6)
        expect(st.position_relative).to_equal(true)

    it "transform on a sticky box resets top to the sticky-auto sentinel":
        val st = ap("position:sticky;top:10px;transform:translate(5px, 6px)")
        expect(st.top_px == 10).to_equal(false)

    it "transform scale resizes explicit dimensions":
        val st = ap("width:100px;height:40px;transform:scale(2)")
        expect(st.width_px).to_equal(200)
        expect(st.height_px).to_equal(80)

    it "transform quarter-turn rotate swaps width and height":
        val st = ap("width:100px;height:40px;transform:rotate(90deg)")
        expect(st.width_px).to_equal(40)
        expect(st.height_px).to_equal(100)

    it "individual translate property offsets the box":
        val st = ap("translate:5px 6px")
        expect(st.left_px).to_equal(5)
        expect(st.top_px).to_equal(6)
        expect(st.position_relative).to_equal(true)

    it "individual translate on sticky resets top to the sticky sentinel":
        val st = ap("position:sticky;top:10px;translate:5px 6px")
        expect(st.top_px == 10).to_equal(false)

    it "individual scale and rotate resize and swap the box":
        val sc = ap("width:100px;height:40px;scale:50%")
        expect(sc.width_px).to_equal(50)
        expect(sc.height_px).to_equal(20)
        val ro = ap("width:100px;height:40px;rotate:90deg")
        expect(ro.width_px).to_equal(40)
        expect(ro.height_px).to_equal(100)

    it "transform-origin/box/style keywords are recorded":
        val st = ap("transform-origin:top left;transform-box:border-box;transform-style:preserve-3d")
        expect(st.transform_origin).to_equal("top left")
        expect(st.transform_box).to_equal("border-box")
        expect(st.transform_style).to_equal("preserve-3d")

    it "object-fit, object-position and image-rendering keywords":
        val st = ap("object-fit:cover;object-position:top left;image-rendering:pixelated")
        expect(st.object_fit).to_equal("cover")
        expect(st.object_position).to_equal("top left")
        expect(st.image_rendering).to_equal("pixelated")

describe "decl_apply flex-flow and place alignment (tranche 5)":
    it "flex-direction row and row-reverse arms":
        expect(ap("flex-direction:row-reverse").flex_direction).to_equal("row-reverse")
        expect(ap("flex-direction:column;flex-direction:row").flex_direction).to_equal("row")

    it "flex-flow decodes direction and wrap words":
        val a = ap("flex-flow:row-reverse wrap")
        expect(a.flex_direction).to_equal("row-reverse")
        expect(a.flex_wrap).to_equal("wrap")
        val b = ap("flex-flow:column wrap-reverse")
        expect(b.flex_direction).to_equal("column")
        expect(b.flex_wrap).to_equal("wrap-reverse")
        val c = ap("flex-flow:row nowrap")
        expect(c.flex_direction).to_equal("row")
        expect(c.flex_wrap).to_equal("nowrap")

    it "flex shorthand feeds grow, shrink and pixel basis":
        val st = ap("flex:2 3 40px")
        expect(st.flex_grow).to_equal(2)
        expect(st.flex_shrink).to_equal(3)
        expect(st.flex_basis_px).to_equal(40)

    it "place-content single distribution keyword sets both axes":
        val st = ap("place-content:space-between")
        expect(st.align_content).to_equal("space-between")
        expect(st.justify_content).to_equal("space-between")

    it "place-content two-value form splits align and justify":
        val st = ap("place-content:center space-around")
        expect(st.align_content).to_equal("center")
        expect(st.justify_content).to_equal("space-around")

    it "place-items and place-self first token feed align slots":
        expect(ap("place-items:center").align_items).to_equal("center")
        expect(ap("place-self:center").align_self).to_equal("center")

    it "gap:initial resets all three gap fields":
        val st = ap("gap:9px;gap:initial")
        expect(st.gap_px).to_equal(0)
        expect(st.row_gap_px).to_equal(0)
        expect(st.column_gap_px).to_equal(0)

describe "decl_apply text alignment and justification (tranche 5)":
    it "text-align-all, text-align-last and text-justify keywords":
        val st = ap("text-align-all:center;text-align-last:end;text-justify:inter-word")
        expect(st.text_align).to_equal("center")
        expect(st.text_align_last).to_equal("end")
        expect(st.text_justify).to_equal("inter-word")

describe "decl_apply font longhand families (tranche 5)":
    it "font-size rem and percent forms scale from their bases":
        val rem = apply_decls(renderer_default_style(), "font-size:1.5rem;letter-spacing:0px", 16)
        expect(rem.font_size).to_equal(24)
        val pct = apply_decls(renderer_default_style(), "font-size:150%;letter-spacing:0px", 16)
        expect(pct.font_size).to_equal(24)

    it "font-size-adjust, font-palette and font-feature-settings":
        val st = ap("font-size-adjust:none;font-palette:dark;font-feature-settings:'liga' 1")
        expect(st.font_size_adjust).to_equal("none")
        expect(st.font_palette).to_equal("dark")
        expect(st.font_feature_settings).to_equal("'liga' 1")

    it "font-optical-sizing, language-override and variation-settings":
        val st = ap("font-optical-sizing:none;font-language-override:normal;font-variation-settings:'wght' 700")
        expect(st.font_optical_sizing).to_equal("none")
        expect(st.font_language_override).to_equal("normal")
        expect(st.font_variation_settings).to_equal("'wght' 700")

    it "font-variant family keywords are validated and recorded":
        val st = ap("font-variant:small-caps;font-variant-alternates:historical-forms;font-variant-east-asian:ruby;font-variant-emoji:emoji;font-variant-ligatures:none;font-variant-numeric:ordinal;font-variant-position:sub")
        expect(st.font_variant).to_equal("small-caps")
        expect(st.font_variant_alternates).to_equal("historical-forms")
        expect(st.font_variant_east_asian).to_equal("ruby")
        expect(st.font_variant_emoji).to_equal("emoji")
        expect(st.font_variant_ligatures).to_equal("none")
        expect(st.font_variant_numeric).to_equal("ordinal")
        expect(st.font_variant_position).to_equal("sub")

    it "font-stretch and font-width keyword scales":
        val st = ap("font-stretch:condensed;font-width:expanded")
        expect(st.font_stretch).to_equal("condensed")
        expect(st.font_width).to_equal("expanded")

    it "font-synthesis and its four longhands":
        val st = ap("font-synthesis:none;font-synthesis-small-caps:none;font-synthesis-position:none;font-synthesis-style:none;font-synthesis-weight:none")
        expect(st.font_synthesis).to_equal("none")
        expect(st.font_synthesis_small_caps).to_equal("none")
        expect(st.font_synthesis_position).to_equal("none")
        expect(st.font_synthesis_style).to_equal("none")
        expect(st.font_synthesis_weight).to_equal("none")

describe "decl_apply writing modes and text orientation (tranche 5)":
    it "direction:ltr resets rtl":
        expect(ap("direction:rtl;direction:ltr").direction_rtl).to_equal(false)

    it "text-orientation and text-combine-upright keywords":
        val st = ap("text-orientation:upright;text-combine-upright:all")
        expect(st.text_orientation).to_equal("upright")
        expect(st.text_combine_upright).to_equal("all")

describe "decl_apply text decoration closure (tranche 5)":
    it "text-shadow:none zeroes the shadow model":
        val st = ap("text-shadow:1px 2px #000000;text-shadow:none")
        expect(st.text_shadow_x_px).to_equal(0)
        expect(st.text_shadow_y_px).to_equal(0)
        expect(st.text_shadow_color).to_equal(0u32)

    it "text-decoration shorthand carries a color":
        val st = ap("text-decoration:underline #ff0000")
        expect(st.text_decoration_underline).to_equal(true)
        expect(st.text_decoration_color == renderer_default_style().text_decoration_color).to_equal(false)

    it "text-decoration-line none and multi-line values":
        val none = ap("text-decoration:underline;text-decoration-line:none")
        expect(none.text_decoration_underline).to_equal(false)
        val multi = ap("text-decoration-line:underline overline line-through")
        expect(multi.text_decoration_underline).to_equal(true)
        expect(multi.text_decoration_overline).to_equal(true)
        expect(multi.text_decoration_line_through).to_equal(true)

    it "text-decoration-color longhand parses":
        val st = ap("text-decoration-color:#ff0000")
        expect(st.text_decoration_color == renderer_default_style().text_decoration_color).to_equal(false)

    it "text-decoration-thickness auto is 1px; underline offset auto is 0":
        expect(ap("text-decoration-thickness:auto").text_decoration_thickness_px).to_equal(1)
        expect(ap("text-underline-offset:4px;text-underline-offset:auto").text_underline_offset_px).to_equal(0)

    it "text-underline-position keyword":
        expect(ap("text-underline-position:under").text_underline_position).to_equal("under")

describe "decl_apply wrapping and interaction keywords (tranche 5)":
    it "overflow-wrap, word-wrap alias, line-break, hyphens, word-break":
        val st = ap("overflow-wrap:break-word;line-break:strict;hyphens:auto;word-break:keep-all")
        expect(st.overflow_wrap).to_equal("break-word")
        expect(st.line_break).to_equal("strict")
        expect(st.hyphens).to_equal("auto")
        expect(st.word_break).to_equal("keep-all")
        expect(ap("word-wrap:anywhere").overflow_wrap).to_equal("anywhere")

    it "resize keyword is validated":
        expect(ap("resize:both").resize).to_equal("both")

    it "border-collapse:initial maps to separate; caption-side:initial to top":
        expect(ap("border-collapse:initial").border_collapse).to_equal("separate")
        expect(ap("caption-side:bottom;caption-side:initial").caption_side).to_equal("top")

    it "border-spacing:initial resets both axes":
        val st = ap("border-spacing:4px 7px;border-spacing:initial")
        expect(st.border_spacing_x_px).to_equal(0)
        expect(st.border_spacing_y_px).to_equal(0)

    it "caret-color and accent-color auto and explicit colors":
        expect(ap("caret-color:auto").caret_color).to_equal(0u32)
        expect(ap("caret-color:#123456").caret_color == 0u32).to_equal(false)
        expect(ap("accent-color:auto").accent_color).to_equal(0u32)
        expect(ap("accent-color:#123456").accent_color == 0u32).to_equal(false)

    it "tab-size and unicode-bidi":
        val st = ap("tab-size:4;unicode-bidi:isolate")
        expect(st.tab_size).to_equal(4)
        expect(st.unicode_bidi).to_equal("isolate")

describe "decl_apply animation direction longhands (tranche 5)":
    it "animation-direction, fill-mode and play-state longhands":
        val st = ap("animation-direction:reverse;animation-fill-mode:forwards;animation-play-state:paused")
        expect(st.animation_direction).to_equal("reverse")
        expect(st.animation_fill_mode).to_equal("forwards")
        expect(st.animation_play_state).to_equal("paused")

describe "decl_apply border width and side shorthands (tranche 5)":
    it "border-width four-value form maps per side":
        val st = ap("border-width:1px 2px 3px 4px;border-inline-style:solid")
        expect(st.border_t).to_equal(1)
        expect(st.border_r).to_equal(2)
        expect(st.border_b).to_equal(3)
        expect(st.border_l).to_equal(4)

    it "border-left/top/right/bottom side shorthands carry width and color":
        val st = ap("border-left:2px solid #ff0000;border-top:3px solid #00ff00;border-right:4px solid #0000ff;border-bottom:5px solid #ffffff")
        expect(st.border_l).to_equal(2)
        expect(st.border_t).to_equal(3)
        expect(st.border_r).to_equal(4)
        expect(st.border_b).to_equal(5)
        expect(st.border_color_l == st.border_color_t).to_equal(false)

    it "per-side style longhands with none/hidden zero their side":
        val st = ap("border:2px solid #112233;border-top-style:hidden;border-bottom-style:hidden;border-left-style:none;border-right-style:none")
        expect(st.border_t).to_equal(0)
        expect(st.border_b).to_equal(0)
        expect(st.border_l).to_equal(0)
        expect(st.border_r).to_equal(0)

describe "decl_apply outline and box-shadow closure (tranche 5)":
    it "outline shorthand with a color and outline:none disable":
        val colored = ap("outline:2px solid #ff0000")
        expect(colored.outline_color == renderer_default_style().outline_color).to_equal(false)
        expect(ap("outline:2px solid red;outline:none").outline_w).to_equal(0)

    it "outline-width and outline-color longhands":
        val st = ap("outline-style:solid;outline-width:3px;outline-color:#ff0000")
        expect(st.outline_w).to_equal(3)
        expect(st.outline_color == renderer_default_style().outline_color).to_equal(false)

    it "outline-style none zeroes width; a paintable style floors it at 1":
        expect(ap("outline:2px solid red;outline-style:none").outline_w).to_equal(0)
        expect(ap("outline-style:solid").outline_w).to_equal(1)

    it "box-shadow:none resets the aggregate shadow fields":
        val st = ap("box-shadow:2px 3px 4px #000000;box-shadow:none")
        expect(st.box_shadow_x_px).to_equal(0)
        expect(st.box_shadow_y_px).to_equal(0)
        expect(st.box_shadow_blur_px).to_equal(0)
        expect(st.box_shadow_raw).to_equal("")

    it "two-length box-shadow keeps blur at zero":
        val st = ap("box-shadow:2px 3px #000000")
        expect(st.box_shadow_x_px).to_equal(2)
        expect(st.box_shadow_y_px).to_equal(3)
        expect(st.box_shadow_blur_px).to_equal(0)

    it "backdrop-filter and the -webkit- alias record the raw filter":
        expect(ap("backdrop-filter:blur(4px)").backdrop_filter_raw).to_equal("blur(4px)")
        expect(ap("-webkit-backdrop-filter:none").backdrop_filter_raw).to_equal("")

describe "decl_apply margin logical longhands (tranche 5)":
    it "margin three-value form maps top, sides, bottom":
        val st = ap("margin:1px 2px 3px")
        expect(st.margin_t).to_equal(1)
        expect(st.margin_r).to_equal(2)
        expect(st.margin_l).to_equal(2)
        expect(st.margin_b).to_equal(3)

    it "margin-left:auto flags the left auto margin":
        val st = ap("margin-left:auto")
        expect(st.margin_l_auto).to_equal(true)
        expect(st.margin_l).to_equal(0)

    it "margin-inline auto and two-value forms":
        val au = ap("margin-inline:auto")
        expect(au.margin_l_auto).to_equal(true)
        expect(au.margin_r_auto).to_equal(true)
        val two = ap("margin-inline:5px 7px")
        expect(two.margin_l).to_equal(5)
        expect(two.margin_r).to_equal(7)

    it "margin-inline-start/end auto and lengths":
        val st = ap("margin-inline-start:9px;margin-inline-end:auto")
        expect(st.margin_l).to_equal(9)
        expect(st.margin_r_auto).to_equal(true)
        val rev = ap("margin-inline-start:auto;margin-inline-end:4px")
        expect(rev.margin_l_auto).to_equal(true)
        expect(rev.margin_r).to_equal(4)

    it "margin-block auto and two-value forms":
        val au = ap("margin-block:auto")
        expect(au.margin_t_auto).to_equal(true)
        expect(au.margin_b_auto).to_equal(true)
        val two = ap("margin-block:3px 5px")
        expect(two.margin_t).to_equal(3)
        expect(two.margin_b).to_equal(5)

    it "margin-block-start/end auto and lengths":
        val st = ap("margin-block-start:2px;margin-block-end:auto")
        expect(st.margin_t).to_equal(2)
        expect(st.margin_b_auto).to_equal(true)
        val rev = ap("margin-block-start:auto;margin-block-end:6px")
        expect(rev.margin_t_auto).to_equal(true)
        expect(rev.margin_b).to_equal(6)

    it "margin-top/right/bottom longhands with auto and lengths":
        val st = ap("margin-top:7px;margin-right:8px;margin-bottom:9px")
        expect(st.margin_t).to_equal(7)
        expect(st.margin_r).to_equal(8)
        expect(st.margin_b).to_equal(9)
        val au = ap("margin-top:auto;margin-right:auto;margin-bottom:auto")
        expect(au.margin_t_auto).to_equal(true)
        expect(au.margin_r_auto).to_equal(true)
        expect(au.margin_b_auto).to_equal(true)

describe "decl_apply logical sizing (tranche 5)":
    it "percent width and height store the negative sentinel":
        expect(ap("width:50%").width_px).to_equal(-50)
        expect(ap("height:25%").height_px).to_equal(-25)

    it "inline-size and block-size map to width and height horizontally":
        val st = ap("inline-size:200px;block-size:90px")
        expect(st.width_px).to_equal(200)
        expect(st.height_px).to_equal(90)
        expect(ap("inline-size:50%").width_px).to_equal(-50)

    it "vertical writing-mode swaps inline-size and block-size axes":
        val st = ap("writing-mode:vertical-rl;inline-size:40px;block-size:70px")
        expect(st.height_px).to_equal(40)
        expect(st.width_px).to_equal(70)

    it "aspect-ratio derives the missing dimension":
        expect(ap("width:100px;aspect-ratio:2/1").height_px).to_equal(50)
        expect(ap("height:50px;aspect-ratio:2/1").width_px).to_equal(100)

    it "min-height in vh sets the vh flag":
        expect(ap("min-height:10vh").min_height_vh).to_equal(true)

    it "logical min/max inline and block sizes horizontally":
        val st = ap("min-inline-size:10px;max-inline-size:300px;min-block-size:5px;max-block-size:400px")
        expect(st.min_width_px).to_equal(10)
        expect(st.max_width_px).to_equal(300)
        expect(st.min_height_px).to_equal(5)
        expect(st.max_height_px).to_equal(400)

    it "logical min/max sizes under a vertical writing mode":
        val st = ap("writing-mode:vertical-rl;min-inline-size:10px;max-inline-size:300px;min-block-size:5px;max-block-size:400px")
        expect(st.min_height_px).to_equal(10)
        expect(st.max_height_px).to_equal(300)
        expect(st.min_width_px).to_equal(5)
        expect(st.max_width_px).to_equal(400)

    it "an inherited logical writing mode overrides sizing without a local decl":
        # apply_decls_on_writing_mode passes the parent's computed writing mode;
        # a vertical inherited mode flips inline-size onto the height axis.
        val st = apply_decls_on_writing_mode(renderer_default_style(), "inline-size:40px;letter-spacing:0px", 16, "vertical-rl")
        expect(st.height_px).to_equal(40)
        expect(st.width_px).to_equal(0)

    it "min-inline-size in vh under vertical writing mode flags min-height vh":
        expect(ap("writing-mode:vertical-rl;min-inline-size:10vh").min_height_vh).to_equal(true)

describe "decl_apply background shorthand layers (tranche 5)":
    it "a simple valid background shorthand projects onto the typed fields":
        val st = ap("background:#ff0000")
        expect(st.bg).to_equal(ap("background-color:#ff0000").bg)
        expect(st.background_image_uri).to_equal("")
        expect(st.bg_layers_raw).to_equal("")

    it "typed linear gradient over a base color projects both layers":
        val st = ap("background:linear-gradient(#ff0000,#0000ff), #ffffff")
        expect(st.background_gradient_from).to_equal(0xFFFF0000u32)
        expect(st.background_gradient_to).to_equal(0xFF0000FFu32)
        expect(st.background_gradient_stop_colors.len()).to_equal(2)
        expect(st.bg_layers_raw).to_equal("")

    it "radial gradient over a base color projects as radial stops":
        val st = ap("background:radial-gradient(#ff0000,#0000ff), #ffffff")
        expect(st.background_gradient_is_radial).to_equal(true)
        expect(st.background_gradient_from).to_equal(0u32)
        expect(st.background_gradient_stop_colors.len()).to_equal(2)

    it "background-image:none clears the whole image layer model":
        val st = ap("background-image:linear-gradient(#ff0000,#0000ff);background-image:none")
        expect(st.background_image_uri).to_equal("")
        expect(st.background_gradient_from).to_equal(0u32)
        expect(st.background_gradient_stop_colors.len()).to_equal(0)

    it "a single radial-gradient image layer decodes its stops":
        val st = ap("background-image:radial-gradient(#ff0000,#0000ff)")
        expect(st.background_gradient_is_radial).to_equal(true)
        expect(st.background_gradient_stop_colors.len()).to_equal(2)

    it "an unsupported image layer stays raw and observable":
        val st = ap("background-image:cross-fade(url(a.png))")
        expect(st.bg_layers_raw.contains("cross-fade")).to_equal(true)
        expect(st.background_image_uri).to_equal("")

    it "single-value background-size and background-position defaults":
        val st = ap("background-size:40px;background-position:10px")
        expect(st.background_size_w_px).to_equal(40)
        expect(st.background_size_h_px).to_equal(0)
        expect(st.background_position_x_px).to_equal(10)
        expect(st.background_position_y_px).to_equal(-1050)

    it "a dispatch-only declaration block still applies (O(k) fast path)":
        val st = apply_decls(renderer_default_style(), "width:10px", 16)
        expect(st.width_px).to_equal(10)

    it "width in vw stores the percent sentinel":
        expect(ap("width:50vw").width_px).to_equal(-50)

    it "min-block-size in vh flags min-height vh horizontally":
        expect(ap("min-block-size:10vh").min_height_vh).to_equal(true)

    it "border:none shorthand disables every side":
        val st = ap("border:2px solid #ff0000;border:none")
        expect(st.border_w).to_equal(0)
        expect(st.border_l).to_equal(0)
        expect(st.border_t).to_equal(0)
        expect(st.border_r).to_equal(0)
        expect(st.border_b).to_equal(0)

    it "bare none in logical side shorthands disables their side":
        val blk = ap("border:2px solid #ff0000;border-block-start:none;border-block-end:none")
        expect(blk.border_t).to_equal(0)
        expect(blk.border_b).to_equal(0)
        val inl = ap("border:2px solid #ff0000;border-inline:none")
        expect(inl.border_l).to_equal(0)
        expect(inl.border_r).to_equal(0)
        val se = ap("border:2px solid #ff0000;border-inline-start:none;border-inline-end:none")
        expect(se.border_l).to_equal(0)
        expect(se.border_r).to_equal(0)

    it "border-inline-start/end-style none zero the inline widths":
        val st = ap("border:2px solid #ff0000;border-inline-start-style:none;border-inline-end-style:none")
        expect(st.border_l).to_equal(0)
        expect(st.border_r).to_equal(0)

    it "a colorless two-length box-shadow falls back to signed offsets":
        val st = ap("box-shadow:2px 3px")
        expect(st.box_shadow_x_px).to_equal(2)
        expect(st.box_shadow_y_px).to_equal(3)
        expect(st.box_shadow_blur_px).to_equal(0)

    it "a near-white shadow skips the aggregate model but keeps raw offsets":
        # parse_box_shadow_agg drops glossy near-white layers, so the offsets
        # come from the signed-int fallback path.
        val st = ap("box-shadow:2px 3px #ffffff")
        expect(st.box_shadow_x_px).to_equal(2)
        expect(st.box_shadow_y_px).to_equal(3)
        expect(st.box_shadow_blur_px).to_equal(0)

    it "two url image layers become a raw two-url plan":
        val st = ap("background-image:url(a.png), url(b.png)")
        expect(st.bg_layers_raw.len() > 0).to_equal(true)
        expect(st.background_image_uri).to_equal("")
