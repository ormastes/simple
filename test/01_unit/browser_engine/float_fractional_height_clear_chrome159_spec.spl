"""
## Purpose and audience
Purpose: Pin that a float with an authored fractional `height` (10.25 / 10.5 /
10.75 px) ends where Chrome 159 ends it, and that whatever reads the float's
bottom starts there: a `clear` sibling, the auto height of a `flow-root`
parent, and a float stacked below it. The float context kept whole-px bottoms,
so at k=4 a cleared block sat 1 / 2 / 3 device rows high (and painted over the
float's last rows), and a float below a fractional cursor or with a fractional
vertical margin started on the rounded px.
Audience: web renderer float layout (float context bottom residual).

Chrome oracle: Chrome for Testing 159.0.8154.6 aarch64, `--headless=new
--disable-gpu --hide-scrollbars --force-device-scale-factor=K`, window
400 CSS px wide. Each case is its own 50px block; floats are 100px wide on the
left, cleared blocks are 5px high. Rows are the device rows whose pixel on one
column is exactly the colour (float: CSS x 50, cleared block: CSS x 200).

| case (block top CSS y) | what | Chrome k=4 | base k=4 | Chrome k=1 | base k=1 |
|------|------|-----------|----------|-----------|----------|
| 10.75px float (0) | float / clear | 0..42 / 43..62 | 0..39 / 40..59 | 0..10 / 11..15 | same |
| 10.5px float (50) | float / clear | 200..241 / 242..261 | 200..239 / 240..259 | 50..60 / 61..65 | same |
| 10.25px float (100) | float / clear | 400..440 / 441..460 | 400..439 / 440..459 | 100..109 / 110..114 | same |
| 10.75px, max-height 10px (150) | float / clear | 600..639 / 640..659 | same | 150..159 / 160..164 | same |
| 10.75px, margin-bottom 3.5px (200) | float / clear | 800..842 / 857..876 | 800..842 / 856..875 | 200..210 / 214..218 | 200..210 / 215..219 |
| 5.5px block, then 10.75px float (250) | float / clear | 1022..1064 / 1065..1084 | 1024..1063 / 1064..1083 | 256..265 / 266..270 | 256..266 / 267..271 |
| clear has margin-top 2.5px (300) | float / clear | 1200..1242 / 1243..1262 | 1200..1239 / 1240..1259 | 300..310 / 311..315 | same |
| float in a `flow-root` parent (350) | parent bg / next block | 1400..1442 / 1443..1462 | 1400..1439 / 1440..1459 | 350..360 / 361..365 | same |
| 10.25px left + 10.75px right, `clear:left` (400) | left float / clear | 1600..1640 / 1641..1660 | 1600..1639 / 1640..1659 | 400..409 / 410..414 | same |
| 10.75px, max-height 20.5px (450) | float / clear | 1800..1842 / 1843..1862 | 1800..1839 / 1840..1859 | 450..460 / 461..465 | same |
| 10.75px, margin-top 2.5px (500) | float / clear | 2010..2052 / 2053..2072 | 2012..2051 / 2052..2071 | 503..512 / 513..517 | 503..513 / 514..518 |
| two full-width floats 10.75px + 10.5px (550) | first / second / clear | 2200..2242 / 2243..2284 / 2285..2304 | 2200..2239 / 2240..2279 / 2280..2299 | 550..560 / 561..570 / 571..575 | 550..560 / 561..571 / 572..576 |
| auto-height float holding a 10.75px block (600) | child / clear | 2400..2442 / 2443..2462 | 2400..2442 / 2444..2463 | 600..610 / 611..615 | same |
| 10.75px right float over `clear:left` (400, CSS x 350) | right float | 1600..1642 | 1600..1640 | 400..410 | 400..409 |

REQ-WEB-001 pins the right float (`0x332211u32`) over the overlapping `clear:left` normal-flow block (`0x445566u32`).
"""

"""
Traceability: REQ-WEB-FLOAT-BOTTOM-FRACTION-001 — the float context keeps the sub-pixel part of a float's bottom edge.
"""
# @tag: unit, browser_engine, device_scale, layout, float, chrome159
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_engine.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}

val CSS_W: i32 = 400
val CSS_H: i32 = 650

val PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff;font:16px/1.5 'Liberation Sans';color:#172033}}.b{{height:50px}}.f{{float:left;width:100px}}.c{{clear:both;height:5px}}</style></head><body><div class=\"b\"><div class=\"f\" style=\"height:10.75px;background:#aa5500\"></div><div class=\"c\" style=\"background:#bb6600\"></div></div><div class=\"b\"><div class=\"f\" style=\"height:10.5px;background:#00aa00\"></div><div class=\"c\" style=\"background:#00cc66\"></div></div><div class=\"b\"><div class=\"f\" style=\"height:10.25px;background:#0000aa\"></div><div class=\"c\" style=\"background:#0066cc\"></div></div><div class=\"b\"><div class=\"f\" style=\"height:10.75px;max-height:10px;background:#777700\"></div><div class=\"c\" style=\"background:#888800\"></div></div><div class=\"b\"><div class=\"f\" style=\"height:10.75px;margin-bottom:3.5px;background:#aa00aa\"></div><div class=\"c\" style=\"background:#cc66cc\"></div></div><div class=\"b\"><div style=\"height:5.5px\"></div><div class=\"f\" style=\"height:10.75px;background:#00aaaa\"></div><div class=\"c\" style=\"background:#66cccc\"></div></div><div class=\"b\"><div class=\"f\" style=\"height:10.75px;background:#aa0000\"></div><div class=\"c\" style=\"margin-top:2.5px;background:#cc6666\"></div></div><div class=\"b\"><div style=\"display:flow-root;background:#dddddd\"><div class=\"f\" style=\"height:10.75px;background:#555555\"></div></div><div style=\"height:5px;background:#999999\"></div></div><div class=\"b\"><div class=\"f\" style=\"height:10.25px;background:#112233\"></div><div style=\"float:right;width:100px;height:10.75px;background:#332211\"></div><div style=\"clear:left;height:5px;background:#445566\"></div></div><div class=\"b\"><div class=\"f\" style=\"height:10.75px;max-height:20.5px;background:#123456\"></div><div class=\"c\" style=\"background:#654321\"></div></div><div class=\"b\"><div class=\"f\" style=\"height:10.75px;margin-top:2.5px;background:#abcdef\"></div><div class=\"c\" style=\"background:#fedcba\"></div></div><div class=\"b\"><div style=\"float:left;width:400px;height:10.75px;background:#101010\"></div><div style=\"float:left;width:400px;height:10.5px;background:#202020\"></div><div class=\"c\" style=\"background:#303030\"></div></div><div class=\"b\"><div class=\"f\"><div style=\"height:10.75px;background:#404040\"></div></div><div class=\"c\" style=\"background:#505050\"></div></div></body></html>"

var g_px4: [u32] = []
var g_px1: [u32] = []

fn _px(k: i32) -> [u32]:
    if k == 4:
        if g_px4.len() == 0:
            g_px4 = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, 4, "cpu_simd")
        return g_px4
    if g_px1.len() == 0:
        g_px1 = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, 1, "cpu_simd")
    g_px1

# "first..last" device rows on CSS column css_x whose pixel is exactly rgb.
fn _rows(k: i32, css_x: i32, rgb: u32) -> text:
    val px = _px(k)
    val w = CSS_W * k
    val h = CSS_H * k
    val x = css_x * k
    var first = -1
    var last = -1
    var y = 0
    while y < h:
        if (px[y * w + x] & 0xFFFFFFu32) == rgb:
            if first < 0:
                first = y
            last = y
        y = y + 1
    "{first}..{last}"

describe "A float's fractional bottom reaches clear, flow-root height and stacked floats (Chrome 159)":
    it "AC-1: k=4, a clear block after a 10.75 / 10.5 / 10.25px float starts on device row 43 / 242 / 441":
        expect(_px(4).len()).to_equal((CSS_W * 4 * CSS_H * 4) as i64)
        expect(_rows(4, 50, 0xAA5500u32)).to_equal("0..42")
        expect(_rows(4, 200, 0xBB6600u32)).to_equal("43..62")
        expect(_rows(4, 50, 0x00AA00u32)).to_equal("200..241")
        expect(_rows(4, 200, 0x00CC66u32)).to_equal("242..261")
        expect(_rows(4, 50, 0x0000AAu32)).to_equal("400..440")
        expect(_rows(4, 200, 0x0066CCu32)).to_equal("441..460")

    it "AC-2: k=1, the same floats and clear blocks stay on Chrome's rows":
        expect(_rows(1, 50, 0xAA5500u32)).to_equal("0..10")
        expect(_rows(1, 200, 0xBB6600u32)).to_equal("11..15")
        expect(_rows(1, 50, 0x00AA00u32)).to_equal("50..60")
        expect(_rows(1, 200, 0x00CC66u32)).to_equal("61..65")
        expect(_rows(1, 50, 0x0000AAu32)).to_equal("100..109")
        expect(_rows(1, 200, 0x0066CCu32)).to_equal("110..114")

    it "AC-3: max-height at or below the whole px clamps the fraction away; above it the fraction stays":
        expect(_rows(4, 50, 0x777700u32)).to_equal("600..639")
        expect(_rows(4, 200, 0x888800u32)).to_equal("640..659")
        expect(_rows(1, 50, 0x777700u32)).to_equal("150..159")
        expect(_rows(1, 200, 0x888800u32)).to_equal("160..164")
        expect(_rows(4, 50, 0x123456u32)).to_equal("1800..1842")
        expect(_rows(4, 200, 0x654321u32)).to_equal("1843..1862")
        expect(_rows(1, 50, 0x123456u32)).to_equal("450..460")
        expect(_rows(1, 200, 0x654321u32)).to_equal("461..465")

    it "AC-4: a fractional bottom margin adds to the float's bottom (10.75 + 3.5 = 14.25px)":
        expect(_rows(4, 50, 0xAA00AAu32)).to_equal("800..842")
        expect(_rows(4, 200, 0xCC66CCu32)).to_equal("857..876")
        expect(_rows(1, 50, 0xAA00AAu32)).to_equal("200..210")
        expect(_rows(1, 200, 0xCC66CCu32)).to_equal("214..218")

    it "AC-5: a float below a 5.5px block or with a 2.5px top margin starts on the exact row":
        expect(_rows(4, 50, 0x00AAAAu32)).to_equal("1022..1064")
        expect(_rows(4, 200, 0x66CCCCu32)).to_equal("1065..1084")
        expect(_rows(1, 50, 0x00AAAAu32)).to_equal("256..265")
        expect(_rows(1, 200, 0x66CCCCu32)).to_equal("266..270")
        expect(_rows(4, 50, 0xABCDEFu32)).to_equal("2010..2052")
        expect(_rows(4, 200, 0xFEDCBAu32)).to_equal("2053..2072")
        expect(_rows(1, 50, 0xABCDEFu32)).to_equal("503..512")
        expect(_rows(1, 200, 0xFEDCBAu32)).to_equal("513..517")

    it "AC-6: clearance replaces the clear block's own 2.5px top margin":
        expect(_rows(4, 50, 0xAA0000u32)).to_equal("1200..1242")
        expect(_rows(4, 200, 0xCC6666u32)).to_equal("1243..1262")
        expect(_rows(1, 50, 0xAA0000u32)).to_equal("300..310")
        expect(_rows(1, 200, 0xCC6666u32)).to_equal("311..315")

    it "AC-7: a flow-root parent is as high as its float; the next block follows it":
        expect(_rows(4, 200, 0xDDDDDDu32)).to_equal("1400..1442")
        expect(_rows(4, 200, 0x999999u32)).to_equal("1443..1462")
        expect(_rows(1, 200, 0xDDDDDDu32)).to_equal("350..360")
        expect(_rows(1, 200, 0x999999u32)).to_equal("361..365")

    it "AC-8: clear:left reads the left float's bottom only (10.25px, not the right float's 10.75px) and right float paints over clear block":
        expect(_rows(4, 50, 0x112233u32)).to_equal("1600..1640")
        expect(_rows(4, 200, 0x445566u32)).to_equal("1641..1660")
        expect(_rows(4, 350, 0x332211u32)).to_equal("1600..1642")
        expect(_rows(1, 50, 0x112233u32)).to_equal("400..409")
        expect(_rows(1, 200, 0x445566u32)).to_equal("410..414")
        expect(_rows(1, 350, 0x332211u32)).to_equal("400..410")

    it "AC-9: a float stacked below a 10.75px float starts at its exact bottom":
        expect(_rows(4, 50, 0x101010u32)).to_equal("2200..2242")
        expect(_rows(4, 50, 0x202020u32)).to_equal("2243..2284")
        expect(_rows(4, 50, 0x303030u32)).to_equal("2285..2304")
        expect(_rows(1, 50, 0x101010u32)).to_equal("550..560")
        expect(_rows(1, 50, 0x202020u32)).to_equal("561..570")
        expect(_rows(1, 50, 0x303030u32)).to_equal("571..575")

    it "AC-10: an auto-height float ends at its content's fractional bottom":
        expect(_rows(4, 50, 0x404040u32)).to_equal("2400..2442")
        expect(_rows(4, 200, 0x505050u32)).to_equal("2443..2462")
        expect(_rows(1, 50, 0x404040u32)).to_equal("600..610")
        expect(_rows(1, 200, 0x505050u32)).to_equal("611..615")
