fn pc_mismatches(px: [u32], lane: text) -> i32:
    if px.len() < 200 * 48:
        return 99999
    var bad = 0
    var n = 0
    # cpu-lane-loop-ok: test pin scan; bound is the pin count
    while n < PC_X.len():
        val got = px[PC_Y[n] * 200 + PC_X[n]] | 0xFF000000u32
        if got != PC_CHROME[n]:
            if bad < 10:
                print "{lane} ({PC_X[n]},{PC_Y[n]}) got {got} want {PC_CHROME[n]}"
            bad = bad + 1
        n = n + 1
    if bad > 0:
        print "{lane} mismatches {bad}"
    bad

describe "dashed/dotted borders with per-corner radii (Chrome 159)":
    it "on the CPU raster":
        expect(pc_mismatches(simple_web_layout_render_html_software_pixels(PC_PAGE, 200, 48), "raster")).to_equal(0)

    it "on cpu_simd":
        expect(pc_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(PC_PAGE, 200, 48, "cpu_simd"), "cpu_simd")).to_equal(0)

    it "on Vulkan":
        expect(pc_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(PC_PAGE, 200, 48, "vulkan"), "vulkan")).to_equal(0)
