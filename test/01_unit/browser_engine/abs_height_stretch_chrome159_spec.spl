"""
## Purpose and audience
Purpose: Pin that an absolutely positioned box with `top` and `bottom` set and
`height:auto` stretches to fill its containing block's padding box (CSS 2.2
§10.6.4), while a replaced element keeps its intrinsic height.
Audience: browser-engine layout maintainers.

Chrome oracle (Chrome 159, 900x2000, `body{margin:0}`, each parent
`position:relative;width:200px;height:100px`, getBoundingClientRect,
2026-11-16; parents stack at y = 0, 100, 210, 310):

| child                                                                 | x,y,w,h        |
|-----------------------------------------------------------------------|----------------|
| `left:10px;right:30px;top:5px;bottom:15px`                            | 10,5,160,80    |
| parent `padding:6px 0 4px`; child `inset 0/0, top 5, bottom 15, padding 3, border 2, margin 1` | 1,106,198,88 |
| `<canvas width=50 height=20>` with `inset:0`                          | 0,210,50,20    |
| `width:10px;top:5px;bottom:15px;box-sizing:border-box;padding:4px`    | 0,315,10,80    |

Filed as `abs_stretch` in
doc/08_tracking/bug/web_layout_cascade_selector_paint_chrome159_round4_divergences_2026-11-15.md.
"""

"""
Traceability: REQ-BROWSER-ENGINE-ABS-HEIGHT-STRETCH-001 — top+bottom stretch an auto-height absolute box.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_foundation.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_layout_by_id
}

val PAGE: text = "<html><head><style>body{{margin:0}} .p{{position:relative;width:200px;height:100px}}</style></head><body>" +
    "<div class=p><div id=a style=\"position:absolute;left:10px;right:30px;top:5px;bottom:15px\"></div></div>" +
    "<div class=p style=\"padding:6px 0 4px\"><div id=b style=\"position:absolute;left:0;right:0;top:5px;bottom:15px;padding:3px;border:2px solid;margin:1px\"></div></div>" +
    "<div class=p><canvas id=c width=50 height=20 style=\"position:absolute;inset:0\"></canvas></div>" +
    "<div class=p><div id=d style=\"position:absolute;left:0;width:10px;top:5px;bottom:15px;box-sizing:border-box;padding:4px\"></div></div>" +
    "</body></html>"

fn _box(id: text) -> text:
    simple_web_layout_debug_layout_by_id(PAGE, 900, 2000, id, "x") + "," +
        simple_web_layout_debug_layout_by_id(PAGE, 900, 2000, id, "y") + "," +
        simple_web_layout_debug_layout_by_id(PAGE, 900, 2000, id, "w") + "," +
        simple_web_layout_debug_layout_by_id(PAGE, 900, 2000, id, "h")

describe "absolute top+bottom stretch an auto height":
    it "AC-1: plain box":
        step("Chrome 159: 100 - 5 - 15 = 80")
        expect(_box("a")).to_equal("10,5,160,80")

    it "AC-2: padding box of the parent, margins and own padding/border":
        step("Chrome 159: (100+6+4) - 5 - 15 - 2x1 margin = 88 border-box")
        expect(_box("b")).to_equal("1,106,198,88")

    it "AC-3: a replaced element keeps its intrinsic height":
        expect(_box("c")).to_equal("0,210,50,20")

    it "AC-4: border-box sizing":
        step("Chrome 159: 100 - 5 - 15 = 80 border-box")
        expect(_box("d")).to_equal("0,315,10,80")
