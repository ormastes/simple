# browser_normal_line_height_px / browser_face_ascent_descent_px vs Chrome 159.
# Chrome values measured headless (chromium-1255): a div with `line-height:
# normal`, text "Hxg" plus a 0-height inline-block whose rect.bottom is the
# baseline; getBoundingClientRect().height is the normal line height.
# Rows: family size line_height baseline(ascent).
# 48px baseline 44 (serif/sans) is ascent 43 + floored half line gap 1; pinned by line_strut_baseline_large_chrome159_spec.
use std.spec
use common.text_layout.font_renderer.{browser_normal_line_height_px, browser_face_ascent_descent_px}

fn _check(family: text, size: i32, lh: i32, ascent: i32):
    expect(browser_normal_line_height_px(family, false, false, size)).to_equal(lh)
    val ad = browser_face_ascent_descent_px(family, false, false, size)
    expect(ad.len()).to_equal(2)
    expect(ad[0]).to_equal(ascent)
    # descent is non-negative and ascent+descent fits inside the normal line
    expect(ad[1]).to_be_greater_than(0)
    expect(ad[0] + ad[1]).to_be_less_than(lh + 1)

describe "browser face line metrics match Chrome 159":
    it "serif":
        _check("serif", 12, 15, 11)
        _check("serif", 16, 18, 14)
        _check("serif", 24, 27, 21)
        _check("serif", 32, 37, 29)
        expect(browser_normal_line_height_px("serif", false, false, 48)).to_equal(55)

    it "sans-serif":
        _check("sans-serif", 12, 14, 11)
        _check("sans-serif", 16, 18, 14)
        _check("sans-serif", 24, 28, 22)
        _check("sans-serif", 32, 37, 29)
        expect(browser_normal_line_height_px("sans-serif", false, false, 48)).to_equal(55)

    it "monospace":
        _check("monospace", 12, 14, 11)
        _check("monospace", 16, 19, 15)
        _check("monospace", 24, 28, 22)
        _check("monospace", 32, 38, 30)
        _check("monospace", 48, 56, 45)
        _check("serif", 48, 55, 43)
        _check("sans-serif", 48, 55, 43)

    it "rejects out-of-range sizes":
        expect(browser_normal_line_height_px("serif", false, false, 0)).to_equal(0)
        expect(browser_normal_line_height_px("serif", false, false, 513)).to_equal(0)
        expect(browser_face_ascent_descent_px("serif", false, false, 0).len()).to_equal(0)
        expect(browser_face_ascent_descent_px("serif", false, false, 513).len()).to_equal(0)
