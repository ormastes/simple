"""
## Purpose and audience
Purpose: Prove that expand_flex_flow (U4.3 closure).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-BROWSER-ENGINE-001 — stable requirement identity for this spec.

# @cover src/lib/gc_async_mut/gpu/browser_engine/style_block_parse.spl 90%
"""
# Style Block Parser Shorthand Expansion — Coverage Closure (U4.3, part 3)

Wave 4 of the WM/GUI/web system-test coverage plan
(doc/03_plan/ui/testing/wm_gui_web_system_test_coverage_plan_2026-08-07.md,
unit U4.3). Line coverage IS measurable now; branch coverage remains
unavailable and no branch percentage is claimed here.

The pre-existing dedicated spec
`test/01_unit/lib/gc_async_mut/gpu/browser_engine/style_block_parse_malformed_spec.spl`
already gives `style_block_parse.spl` real, artifact-backed 78% line
coverage (384/488 lines, `Results: 39 total, 39 passed, 0 failed`, measured
via a throwaway `# @cover` header run for this unit, never committed).
Static analysis of the uncovered-line set (diffing the coverage artifact's
hit-line set against every `fn`/`pub fn` body region) found exactly 6 fully
uncovered functions; 5 of the 6 are the CSS shorthand-property expanders
below, closed here with real value/state oracles (private
`_cascade_keyframe_declarations` is left for a follow-up unit — it needs a
`[Keyframe]` fixture, out of scope for this pure-value-expander pass):

  expand_flex_flow      — direction + wrap token pair, unset defaults
  expand_font           — size-unit/percent/bold/italic token classification
  expand_flex           — none / 1-arg / 2-arg / 3+-arg CssDecl triples
  expand_border         — width keyword mapping (thin/medium/thick) + style/color
  expand_box_shorthand  — CSS box-shorthand (1/2/3/4-value) expansion pattern
                           used by margin/padding/border-width/etc.
"""

use std.spec.{describe, it, expect}
use gc_async_mut.gpu.browser_engine.style_block_parse.{
    expand_border,
    expand_box_shorthand,
    expand_flex,
    expand_flex_flow,
    expand_font,
}

describe "expand_flex_flow (U4.3 closure)":
    it "extracts direction and wrap tokens from the shorthand, order-independent":
        step("Verify: extracts direction and wrap tokens from the shorthand, order-independent")
        # @req: REQ-BROWSER-ENGINE-001
        val decls = expand_flex_flow("wrap column")
        expect(decls.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(decls[0].property).to_equal("flex-direction")
        expect(decls[0].value).to_equal("column")
        expect(decls[1].property).to_equal("flex-wrap")
        expect(decls[1].value).to_equal("wrap")

    it "defaults to row/nowrap when neither token is present (both-directions oracle)":
        step("Verify: defaults to row/nowrap when neither token is present (both-directions oracle)")
        val decls = expand_flex_flow("")
        expect(decls[0].value).to_equal("row")
        expect(decls[1].value).to_equal("nowrap")

describe "expand_font (U4.3 closure)":
    it "classifies a size-unit token as font-size and a weight keyword as font-weight, in token order":
        step("Verify: classifies a size-unit token as font-size and a weight keyword as font-weight, in token order")
        val decls = expand_font("bold 14px")
        expect(decls.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(decls[0].property).to_equal("font-weight")
        expect(decls[0].value).to_equal("bold")
        expect(decls[1].property).to_equal("font-size")
        expect(decls[1].value).to_equal("14px")

    it "classifies a percent token as font-size":
        step("Verify: classifies a percent token as font-size")
        val decls = expand_font("120%")
        expect(decls.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(decls[0].property).to_equal("font-size")
        expect(decls[0].value).to_equal("120%")

    it "falls back to a single raw 'font' decl when no token classifies (both-directions oracle)":
        step("Verify: falls back to a single raw 'font' decl when no token classifies (both-directions oracle)")
        val decls = expand_font("italic")
        expect(decls.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(decls[0].property).to_equal("font")
        expect(decls[0].value).to_equal("italic")

describe "expand_flex (U4.3 closure)":
    it "expands the 'none' keyword to grow:0 shrink:0 basis:auto":
        step("Verify: expands the 'none' keyword to grow:0 shrink:0 basis:auto")
        val decls = expand_flex("none")
        expect(decls.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(decls[0].value).to_equal("0")
        expect(decls[1].value).to_equal("0")
        expect(decls[2].value).to_equal("auto")

    it "expands a single number to grow:N shrink:1 basis:0%":
        step("Verify: expands a single number to grow:N shrink:1 basis:0%")
        val decls = expand_flex("2")
        expect(decls[0].value).to_equal("2")
        expect(decls[1].value).to_equal("1")
        expect(decls[2].value).to_equal("0%")

    it "expands two numbers to grow/shrink with basis:0% (both-directions oracle)":
        step("Verify: expands two numbers to grow/shrink with basis:0% (both-directions oracle)")
        val decls = expand_flex("2 3")
        expect(decls[0].value).to_equal("2")
        expect(decls[1].value).to_equal("3")
        expect(decls[2].value).to_equal("0%")

    it "expands three tokens to grow/shrink/basis directly":
        step("Verify: expands three tokens to grow/shrink/basis directly")
        val decls = expand_flex("1 1 200px")
        expect(decls[0].value).to_equal("1")
        expect(decls[1].value).to_equal("1")
        expect(decls[2].value).to_equal("200px")

describe "expand_border (U4.3 closure)":
    it "maps the 'thin'/'medium'/'thick' width keywords to their pixel values":
        step("Verify: maps the 'thin'/'medium'/'thick' width keywords to their pixel values")
        expect(expand_border("thin solid red")[0].value).to_equal("1px")
        expect(expand_border("medium solid red")[0].value).to_equal("3px")
        expect(expand_border("thick solid red")[0].value).to_equal("5px")

    it "passes through an explicit width and captures style + color (both-directions oracle)":
        step("Verify: passes through an explicit width and captures style + color (both-directions oracle)")
        val decls = expand_border("2px dashed blue")
        expect(decls[0].value).to_equal("2px")
        expect(decls[1].value).to_equal("dashed")
        expect(decls[2].value).to_equal("blue")

describe "expand_box_shorthand (U4.3 closure)":
    it "applies a single value to all four sides via the bare property name":
        step("Verify: applies a single value to all four sides via the bare property name")
        val decls = expand_box_shorthand("margin", "10px")
        expect(decls.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(decls[0].property).to_equal("margin")
        expect(decls[0].value).to_equal("10px")

    it "expands two values to vertical/horizontal pairs (top=bottom, right=left)":
        step("Verify: expands two values to vertical/horizontal pairs (top=bottom, right=left)")
        val decls = expand_box_shorthand("margin", "10px 20px")
        expect(decls.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(decls[0].value).to_equal("10px")
        expect(decls[1].value).to_equal("20px")
        expect(decls[2].value).to_equal("10px")
        expect(decls[3].value).to_equal("20px")

    it "expands three values with right=left":
        step("Verify: expands three values with right=left")
        val decls = expand_box_shorthand("margin", "1px 2px 3px")
        expect(decls[0].value).to_equal("1px")
        expect(decls[1].value).to_equal("2px")
        expect(decls[2].value).to_equal("3px")
        expect(decls[3].value).to_equal("2px")

    it "expands four values to top/right/bottom/left independently (both-directions oracle)":
        step("Verify: expands four values to top/right/bottom/left independently (both-directions oracle)")
        val decls = expand_box_shorthand("margin", "1px 2px 3px 4px")
        expect(decls[0].value).to_equal("1px")
        expect(decls[1].value).to_equal("2px")
        expect(decls[2].value).to_equal("3px")
        expect(decls[3].value).to_equal("4px")
