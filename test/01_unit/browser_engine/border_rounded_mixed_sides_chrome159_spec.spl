fn ms_mismatches(px: [u32], lane: text) -> i32:
    if px.len() < 190 * 62:
        return 99999
    var bad = 0
    var n = 0
    # cpu-lane-loop-ok: test pin scan; bound is the pin count
    while n < MS_X.len():
        val got = px[MS_Y[n] * 190 + MS_X[n]] | 0xFF000000u32
        if got != MS_CHROME[n]:
            if bad < 10:
                print "{lane} ({MS_X[n]},{MS_Y[n]}) got {got} want {MS_CHROME[n]}"
            bad = bad + 1
        n = n + 1
    if bad > 0:
        print "{lane} mismatches {bad}"
    bad

describe "rounded dashed/dotted borders with mixed sides (Chrome 159)":
    it "on the CPU raster":
        expect(ms_mismatches(simple_web_layout_render_html_software_pixels(MS_PAGE, 190, 62), "raster")).to_equal(0)

    it "on cpu_simd":
        expect(ms_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(MS_PAGE, 190, 62, "cpu_simd"), "cpu_simd")).to_equal(0)

    it "on Vulkan":
        expect(ms_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(MS_PAGE, 190, 62, "vulkan"), "vulkan")).to_equal(0)
