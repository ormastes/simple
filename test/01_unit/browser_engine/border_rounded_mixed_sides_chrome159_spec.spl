"""
## Purpose and audience
Purpose: Pin Chrome 159's rounded dashed / dotted borders whose sides differ in
colour or mix with solid sides (uniform width and radius): one closed
centre-line dash pattern for the box, each pixel painted by its nearest side
(the diagonal from the outer to the inner corner splits a corner), solid sides
filling their part of the ring.
Audience: browser-engine maintainers.

Chrome 159 (arm64 headless, --force-device-scale-factor=4, --window-size=400,300):
the pins are every pixel near a box's border band whose 4x4 device block is one
colour (frame 190x62). Anti-aliased edges are not pinned.
"""

"""
Traceability: REQ-BROWSER-ENGINE-ROUNDED-MIXED-SIDES-CHROME159-001 — rounded dashed/dotted borders with per-side colours or solid sides paint as Chrome 159 does.
"""
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{simple_web_layout_render_html_software_pixels}
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{simple_web_render_html_to_pixels_with_resolved_engine2d_backend}

# Box 1: 4px dashed, four colours, radius 10. Box 2: 4px solid blue with a red
# dashed top, radius 10. Box 3: 6px dotted, four colours, radius 16.
val MS_PAGE = "<!DOCTYPE html><html><body style=\"margin:0;background:#fff\"><div style=\"position:absolute;left:4px;top:4px;width:40px;height:24px;border:4px dashed;border-color:#f00 #0a0 #00f #f0f;border-radius:10px\"></div><div style=\"position:absolute;left:60px;top:4px;width:40px;height:24px;border:4px solid #00f;border-top-style:dashed;border-top-color:#f00;border-radius:10px\"></div><div style=\"position:absolute;left:112px;top:4px;width:60px;height:40px;border:6px dotted;border-color:#f00 #0a0 #00f #f0f;border-radius:16px\"></div></body></html>"

