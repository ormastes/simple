fn _r(p: u32) -> i32:
    ((p >> 16) & 0xFFu32) as i32

fn _g(p: u32) -> i32:
    ((p >> 8) & 0xFFu32) as i32

fn _b(p: u32) -> i32:
    (p & 0xFFu32) as i32

fn _mc_hex_digit(ch: text) -> i32:
    "0123456789abcdef".index_of(ch) ?? 0

fn _mc_hex_val(two: text) -> i32:
    _mc_hex_digit(two.substring(0, 1)) * 16 + _mc_hex_digit(two.substring(1, 2))

fn _off(a: i32, b: i32) -> bool:
    a - b > 8 or b - a > 8

# Pixels of the reference block at (x0, y0) that are off Chrome by more than 8.
fn _mismatch(px: [u32], w: i32, x0: i32, y0: i32, reference: [text]) -> i32:
    var bad = 0
    var row = 0
    while row < reference.len():
        val cols = reference[row].len() / 6
        var col = 0
        while col < cols:
            val want = reference[row].substring(col * 6, col * 6 + 6)
            val got = px[(y0 + row) * w + x0 + col]
            if _off(_mc_hex_val(want.substring(0, 2)), _r(got)) or _off(_mc_hex_val(want.substring(2, 4)), _g(got)) or _off(_mc_hex_val(want.substring(4, 6)), _b(got)):
                bad = bad + 1
            col = col + 1
        row = row + 1
    bad

# [x_min, x_max, y_min, y_max, count] of the pixels whose red is in lo..hi.
fn _ink(px: [u32], w: i32, x0: i32, y0: i32, x1: i32, y1: i32, lo: i32, hi: i32) -> [i32]:
    var a = 1000000
    var b = -1
    var c = 1000000
    var d = -1
    var n = 0
    var y = y0
    while y < y1:
        var x = x0
        while x < x1:
            val red = _r(px[y * w + x])
            if red >= lo and red <= hi:
                n = n + 1
                if x < a: a = x
                if x > b: b = x
                if y < c: c = y
                if y > d: d = y
            x = x + 1
        y = y + 1
    [a, b, c, d, n]

# The ink box is within 1 px of Chrome's and the ink count within 4 %.
fn _ink_near(got: [i32], want: [i32]) -> bool:
    var i = 0
    while i < 4:
        if got[i] - want[i] > 1 or want[i] - got[i] > 1:
            return false
        i = i + 1
    val slack = want[4] * 4 / 100 + 1
    got[4] - want[4] <= slack and want[4] - got[4] <= slack

var g_px1: [u32] = []
var g_px4: [u32] = []

fn _p1() -> [u32]:
    if g_px1.len() == 0:
        g_px1 = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, 1, "cpu_simd")
    g_px1

fn _p4() -> [u32]:
    if g_px4.len() == 0:
        g_px4 = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, 4, "cpu_simd")
    g_px4

describe "Audio controls vector parts (Chrome 159)":
    it "AC-1: the play triangle equals Chrome's pixels at 1x":
        expect(_mismatch(_p1(), CSS_W, 30, 29, PLAY_REF)).to_equal(0)

    it "AC-2: the timeline track ends equal Chrome's pixels at 1x":
        expect(_mismatch(_p1(), CSS_W, 136, 33, TL_L_REF)).to_equal(0)
        expect(_mismatch(_p1(), CSS_W, 214, 33, TL_R_REF)).to_equal(0)

    it "AC-3: the volume icon is Chrome's shape at 1x":
        step("Chrome 159: 79 px of ink (red <= 200) in columns 245..258, rows 30..43")
        expect(_ink_near(_ink(_p1(), CSS_W, 240, 22, 270, 52, 0, 200), [245, 258, 30, 43, 79])).to_equal(true)
        step("at most 6 of the 440 reference pixels are off by more than 8")
        expect(_mismatch(_p1(), CSS_W, 242, 27, VOL_REF)).to_be_less_than(7)

    it "AC-4: the kebab dots are Chrome's shape at 1x":
        step("Chrome 159: 12 px of solid ink (red <= 60) in columns 283..284, rows 31..42")
        expect(_ink_near(_ink(_p1(), CSS_W, 275, 22, 295, 52, 0, 60), [283, 284, 31, 42, 12])).to_equal(true)
        step("12 of the 162 reference pixels (the dots' side pixels) are off by 9, one over the tolerance: Skia's bezier dots are a hair narrower than a circle; 48 on base")
        expect(_mismatch(_p1(), CSS_W, 280, 28, KEBAB_REF)).to_be_less_than(13)

    it "AC-5: the parts keep Chrome's ink boxes at device scale 4":
        step("Chrome 159 at 4x: play c131-165 r125-170 (834 px)")
        expect(_ink_near(_ink(_p4(), CSS_W * 4, 100, 80, 200, 200, 0, 200), [131, 165, 125, 170, 834])).to_equal(true)
        step("timeline c557-879 r140-155 (5118 px)")
        expect(_ink_near(_ink(_p4(), CSS_W * 4, 500, 100, 920, 200, 0, 215), [557, 879, 140, 155, 5118])).to_equal(true)
        step("volume c978-1037 r119-176 (1486 px)")
        expect(_ink_near(_ink(_p4(), CSS_W * 4, 960, 90, 1080, 200, 0, 200), [978, 1037, 119, 176, 1486])).to_equal(true)
        step("kebab c1129-1142 r121-174 (420 px)")
        expect(_ink_near(_ink(_p4(), CSS_W * 4, 1100, 90, 1180, 200, 0, 120), [1129, 1142, 121, 174, 420])).to_equal(true)

    it "AC-8: the 0:00 / 0:00 time text is Chrome's at 1x and 4x":
        step("Chrome 159 at 1x: 188 px with red < 128 in columns 58..122, rows 31..41")
        expect(_ink_near(_ink(_p1(), CSS_W, 50, 25, 130, 50, 0, 127), [58, 122, 31, 41, 188])).to_equal(true)
        step("Chrome 159 at 4x: 2825 px with red < 128 in columns 230..490, rows 128..167")
        expect(_ink_near(_ink(_p4(), CSS_W * 4, 200, 100, 520, 200, 0, 127), [230, 490, 128, 167, 2825])).to_equal(true)

describe "Video controls vector parts (Chrome 159)":
    it "AC-6: the kebab dots and the timeline of a 120x150 video equal Chrome's pixels at 1x":
        expect(_mismatch(_p1(), CSS_W, 102, 167, V_KEBAB_REF)).to_equal(0)
        expect(_mismatch(_p1(), CSS_W, 24, 198, V_TL_L_REF)).to_equal(0)
        expect(_mismatch(_p1(), CSS_W, 109, 198, V_TL_R_REF)).to_equal(0)

    it "AC-7: the parts keep Chrome's ink boxes at device scale 4":
        step("Chrome 159 at 4x: kebab c418-429 r677-729 (376 px with red >= 70)")
        expect(_ink_near(_ink(_p4(), CSS_W * 4, 400, 660, 460, 750, 70, 255), [418, 429, 677, 729, 376])).to_equal(true)
        step("timeline c104-455 r800-815 (5565 px with red >= 60)")
        expect(_ink_near(_ink(_p4(), CSS_W * 4, 40, 780, 520, 830, 60, 255), [104, 455, 800, 815, 5565])).to_equal(true)
