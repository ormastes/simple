"""
## Purpose and audience
Purpose: Pin the max-content width of a box whose inline content mixes text
with inline elements, `<br>` and replaced boxes -- the measurement behind
auto table columns and every shrink-to-fit box. The block-aware measurement
(`flex_item_max_content_width`) dropped the collapsible space between a text
run and an inline sibling, treated `<br>` as nothing, and gave a replaced
child without a `width` no width at all. A `<td>` holding `ab <span>cd</span>
ef` was therefore 9 px too narrow, wrapped, and came out two lines tall; with
an `<input>` it was 45 px wide where Chrome has 231.
Audience: browser-engine layout maintainers.

Chrome oracle (Chrome 159.0.8154.6 headless shell, 900x4000,
`body{margin:0;font:16px/1.5 sans-serif}`, getBoundingClientRect, `w x h`;
table = `<table><tr><td>…</td></tr></table>` with the UA 2 px spacing and
1 px cell padding). Widths are fractional in Chrome and whole pixels here, so
widths are asserted within 1 px and heights exactly, with two exceptions that
are whole-pixel rounding and stated on their rows: the image row's height
(within 1 px) and the button row's width (within 2 px: five pieces, each
rounded to a whole pixel).

| cell content                                  | table        | td           |
|-----------------------------------------------|--------------|--------------|
| `ab <span>cd</span> ef`                       | 62.95 x 30   | 58.95 x 26   |
| `ab<br>cd`                                    | 23.8 x 54    | 19.8 x 50    |
| `ab <input value="cd"> ef`                    | 231.05 x 30  | 227.05 x 26  |
| `ab <img width=40 height=30> ef` (h within 1) | 86.05 x 43   | 82.05 x 39   |
| `ab <button>cd</button> ef` (w within 2)      | 76.13 x 30   | 72.13 x 26   |
| two cells: `one two` and `ab <b>cd</b>`       | 106.97 x 30  | second td x = 62.05 |
| `position:absolute` div `ab <span>cd</span> ef` | 56.95 x 24 |              |
| `float:left` div, same content                | 56.95 x 24   |              |
| flex item, same content                       | 56.95 x 24   | next item x = 56.95 |
"""

"""
Traceability: REQ-BROWSER-ENGINE-MAX-CONTENT-INLINE-MIX-001 — max-content width counts the spaces between inline pieces, breaks at <br>, and sizes replaced inline children, as Chrome 159 does.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_foundation.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_layout_by_id
}

val HEAD: text = "<html><head><style>body{margin:0;font:16px/1.5 sans-serif}</style></head><body>"
val TAIL: text = "</body></html>"
val IMG: text = "<img width=\"40\" height=\"30\" src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\">"

fn field(inner: text, id: text, name: text) -> i32:
    simple_web_layout_debug_layout_by_id(HEAD + inner + TAIL, 900, 600, id, name).to_int()

fn cell(content: text) -> text:
    "<table id=\"w\"><tr><td id=\"p\">" + content + "</td></tr></table>"

fn off(actual: i32, chrome: i32) -> i32:
    if actual > chrome: actual - chrome else: chrome - actual

describe "max-content width of mixed inline content":
    it "AC-1: the spaces around an inline element are part of the width":
        step("Chrome 159: table 62.95 x 30, td 58.95 x 26 -- one line")
        val page = cell("ab <span id=\"c\">cd</span> ef")
        expect(off(field(page, "w", "w"), 63)).to_be_less_than(2)
        expect(off(field(page, "p", "w"), 59)).to_be_less_than(2)
        expect(field(page, "w", "h")).to_equal(30)
        expect(field(page, "p", "h")).to_equal(26)

    it "AC-2: <br> ends the line being measured":
        step("Chrome 159: table 23.8 x 54, td 19.8 x 50 -- the wider of `ab` and `cd`")
        val page = cell("ab<br>cd")
        expect(off(field(page, "w", "w"), 24)).to_be_less_than(2)
        expect(off(field(page, "p", "w"), 20)).to_be_less_than(2)
        expect(field(page, "w", "h")).to_equal(54)

    it "AC-3: a replaced inline child counts with its own width":
        step("Chrome 159: input -> table 231.05 x 30; img -> table 86.05 x 43; button -> table 76.13 x 30")
        val input_page = cell("ab <input value=\"cd\"> ef")
        expect(off(field(input_page, "w", "w"), 231)).to_be_less_than(2)
        expect(field(input_page, "w", "h")).to_equal(30)
        val img_page = cell("ab " + IMG + " ef")
        expect(off(field(img_page, "w", "w"), 86)).to_be_less_than(2)
        expect(off(field(img_page, "w", "h"), 43)).to_be_less_than(2)
        val button_page = cell("ab <button>cd</button> ef")
        expect(off(field(button_page, "w", "w"), 76)).to_be_less_than(3)
        expect(field(button_page, "w", "h")).to_equal(30)

    it "AC-4: two columns each get their own max-content width":
        step("Chrome 159: table 106.97 x 30, the second cell starts at x = 62.05")
        val page = "<table id=\"w\"><tr><td id=\"p\">one two</td><td id=\"q\">ab <b>cd</b></td></tr></table>"
        expect(off(field(page, "w", "w"), 107)).to_be_less_than(2)
        expect(off(field(page, "q", "x"), 62)).to_be_less_than(2)
        expect(field(page, "w", "h")).to_equal(30)

    it "AC-5: the other shrink-to-fit boxes agree":
        step("Chrome 159: absolute, float and flex item are 56.95 x 24; the flex sibling starts at 56.95")
        val abs_page = "<div style=\"position:relative;height:60px\"><div id=\"w\" style=\"position:absolute\">ab <span>cd</span> ef</div></div>"
        expect(off(field(abs_page, "w", "w"), 57)).to_be_less_than(2)
        expect(field(abs_page, "w", "h")).to_equal(24)
        val float_page = "<div id=\"w\" style=\"float:left\">ab <span>cd</span> ef</div>"
        expect(off(field(float_page, "w", "w"), 57)).to_be_less_than(2)
        expect(field(float_page, "w", "h")).to_equal(24)
        val flex_page = "<div style=\"display:flex\"><div id=\"w\">ab <span>cd</span> ef</div><div id=\"x\">zz</div></div>"
        expect(off(field(flex_page, "w", "w"), 57)).to_be_less_than(2)
        expect(off(field(flex_page, "x", "x"), 57)).to_be_less_than(2)

    it "AC-6: control — plain text and a single inline child are unchanged":
        step("`ab cd ef` alone and `<span>cd</span>` alone: one line, 30 px table")
        expect(field(cell("ab cd ef"), "w", "h")).to_equal(30)
        expect(field(cell("<span>cd</span>"), "w", "h")).to_equal(30)
