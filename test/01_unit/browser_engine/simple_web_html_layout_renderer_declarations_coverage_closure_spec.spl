# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_declarations.spl 60%
"""
# HTML Layout Renderer Declarations — Coverage Closure (U4.3, part 5: _declarations.spl)

Wave 4 of the WM/GUI/web system-test coverage plan
(doc/03_plan/ui/testing/wm_gui_web_system_test_coverage_plan_2026-08-07.md,
unit U4.3, target `_declarations.spl` —
`simple_web_html_layout_renderer_declarations.spl`, 1296 lines, 39
module-level `fn`s). Line coverage IS measurable now (see
doc/09_report/ui/testing/wm_gui_web_coverage_baseline_2026-08-07.md); no
branch percentage is claimed here.

Enumerated every module-level `fn` (`grep -n "^fn "`, 39 total) and
cross-checked each name against `test/` (single-pass whole-word grep, no
partial-name collisions: `apply_decls` does not match
`apply_decls_dispatch` etc. because `_` is a word character). Result: only
`apply_decls` (27 refs) and `tag_defaults` (2 refs) have real test call
sites; `normalized_grid_area`/`normalized_grid_auto_flow`/
`normalized_grid_template_areas`/`normalized_grid_track_list`/
`_apply_decls_on_writing_mode` each had exactly 1 "reference" and every one
of those is prose in a doc-comment or a spec docstring, not a call — so all
5 are genuinely untested. This spec closes the 30 pure text/int/[i32]
helpers that need no `Style`/DOM fixture, with real value oracles (no bare
calls). Left for a follow-up unit (needs a live `Style` + decl-table
fixture, out of scope for this pure-helper pass):
`_apply_decls_dispatch`, `apply_grid_decls`, `apply_authored_style_metadata`,
`_apply_decls_on_writing_mode`, `apply_decls_on_writing_mode`,
`apply_decls_without_display_on_writing_mode`, `_tag_defaults_without_metadata`
(`apply_decls`/`tag_defaults` already have real call sites elsewhere and are
not re-covered here).
"""

use std.spec.step

use std.spec.{describe, it, expect}
use gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_declarations.{
    SIMPLE_WEB_STICKY_TOP_AUTO,
    sticky_top_inset_value,
    border_spacing_px,
    _background_has_image_syntax,
    _background_is_exact_typed_linear_layer,
    _background_exact_single_url,
    _padding_integer_px,
    _padding_integer_px_values,
    _resolve_authored_padding,
    _background_exact_url_value,
    _background_two_url_plan,
    _background_position_value,
    _background_shorthand_tokens,
    _background_box_token,
    _background_position_token,
    _background_size_token,
    _background_color_token,
    _background_position_pair,
    _parse_background_shorthand,
    _decl_tbl_all_dispatch_handled,
    _decl_tbl_resolve_writing_mode,
    parse_supported_nonnegative_px,
    decl_tbl_get_last_valid_nonnegative_px,
    parse_supported_outline_shorthand_width_px,
    resolve_writing_mode_decls,
    normalized_grid_positive_int,
    normalized_grid_track_list,
    normalized_grid_placement,
    normalized_grid_area,
    normalized_grid_auto_flow,
    normalized_grid_template_areas,
}

describe "sticky_top_inset_value (U4.3 closure)":
    # @manual scenario evidence
    it "returns the sentinel only when position is sticky and the token is auto":
        expect(sticky_top_inset_value("auto", 5, true)).to_equal(SIMPLE_WEB_STICKY_TOP_AUTO)
        expect(sticky_top_inset_value("auto", 5, false)).to_equal(5)
        expect(sticky_top_inset_value("10px", 10, true)).to_equal(10)

describe "border_spacing_px (U4.3 closure)":
    it "parses px values, accepts bare zero, rejects malformed tokens":
        expect(border_spacing_px("0")).to_equal(0)
        expect(border_spacing_px("12px")).to_equal(12)
        expect(border_spacing_px("12")).to_equal(-1)
        expect(border_spacing_px("px")).to_equal(-1)
        expect(border_spacing_px("1x2px")).to_equal(-1)

describe "_background_has_image_syntax (U4.3 closure)":
    it "detects any recognized image-function syntax and rejects plain colors":
        expect(_background_has_image_syntax("linear-gradient(red, blue)")).to_equal(true)
        expect(_background_has_image_syntax("url(a.png)")).to_equal(true)
        expect(_background_has_image_syntax("red")).to_equal(false)

describe "_background_is_exact_typed_linear_layer (U4.3 closure)":
    it "accepts a single linear-gradient layer and an optional trailing base color":
        expect(_background_is_exact_typed_linear_layer("linear-gradient(red, blue)", 1u32, 2u32, true)).to_equal(true)
        expect(_background_is_exact_typed_linear_layer("linear-gradient(red, blue), red", 1u32, 2u32, true)).to_equal(true)
        expect(_background_is_exact_typed_linear_layer("linear-gradient(red, blue)", 0u32, 2u32, true)).to_equal(false)
        expect(_background_is_exact_typed_linear_layer("red", 1u32, 2u32, true)).to_equal(false)

describe "_background_exact_single_url (U4.3 closure)":
    it "extracts a lone quoted or bare url() and rejects multi-layer/gradient values":
        expect(_background_exact_single_url("url(a.png)")).to_equal("a.png")
        expect(_background_exact_single_url("url('a.png')")).to_equal("a.png")
        expect(_background_exact_single_url("url(a.png), url(b.png)")).to_equal("")
        expect(_background_exact_single_url("linear-gradient(red, blue)")).to_equal("")

describe "_padding_integer_px / _padding_integer_px_values (U4.3 closure)":
    it "parses a single px token and a whitespace-separated list, capped by maximum":
        expect(_padding_integer_px("0")).to_equal(0)
        expect(_padding_integer_px("4px")).to_equal(4)
        expect(_padding_integer_px("4")).to_equal(-1)
        val two = _padding_integer_px_values("1px 2px", 4)
        expect(two.len()).to_equal(2)
        expect(two[0]).to_equal(1)
        expect(two[1]).to_equal(2)
        expect(_padding_integer_px_values("1px 2px 3px 4px 5px", 4).len()).to_equal(0)
        expect(_padding_integer_px_values("1px bogus", 4).len()).to_equal(0)

describe "_resolve_authored_padding (U4.3 closure)":
    it "expands the padding shorthand and per-side longhands over the initial box":
        val shorthand = _resolve_authored_padding(["padding", "1px 2px 3px 4px"], 0, 0, 0, 0)
        expect(shorthand).to_equal((1, 2, 3, 4))
        val longhand = _resolve_authored_padding(["padding-top", "9px"], 0, 0, 0, 0)
        expect(longhand).to_equal((9, 0, 0, 0))
        val logical = _resolve_authored_padding(["padding-inline", "5px 6px"], 0, 0, 0, 0)
        expect(logical).to_equal((0, 6, 0, 5))

describe "_background_exact_url_value / _background_two_url_plan (U4.3 closure)":
    it "validates a single-url() wrapper and builds a two-layer serialization plan":
        expect(_background_exact_url_value("url(a.png)")).to_equal("a.png")
        expect(_background_exact_url_value("red")).to_equal("")
        val plan = _background_two_url_plan(
            "url(a.png), url(b.png)", "no-repeat", "10px", "0 0",
            10, 0, 0, 0, "border-box", "border-box", "scroll",
        )
        expect(plan.starts_with("two-url-v1\na.png\nb.png")).to_equal(true)
        val rejected = _background_two_url_plan(
            "url(a.png)", "no-repeat", "10px", "0 0",
            10, 0, 0, 0, "border-box", "border-box", "scroll",
        )
        expect(rejected).to_equal("")

describe "_background_position_value / _background_position_pair (U4.3 closure)":
    it "maps position keywords/percentages to internal sentinels and resolves ordered pairs":
        expect(_background_position_value("left", true)).to_equal(-1000)
        expect(_background_position_value("center", true)).to_equal(-1050)
        expect(_background_position_value("right", true)).to_equal(-1100)
        expect(_background_position_value("25%", true)).to_equal(-1025)
        val pair = _background_position_pair("top", "left")
        expect(pair[0]).to_equal(-1000)
        expect(pair[1]).to_equal(_background_position_value("top", false))

describe "_background_shorthand_tokens / token classifiers (U4.3 closure)":
    it "tokenizes on whitespace and slash while respecting parens, and classifies each token kind":
        val tokens = _background_shorthand_tokens("url(a b) / 10px 20px")
        expect(tokens.len()).to_equal(4)
        expect(tokens[0]).to_equal("url(a")
        expect(tokens[1]).to_equal("b)")
        expect(tokens[2]).to_equal("/")
        expect(tokens[3]).to_equal("10px")
        expect(_background_box_token("border-box")).to_equal(true)
        expect(_background_box_token("bogus")).to_equal(false)
        expect(_background_position_token("left")).to_equal(true)
        expect(_background_position_token("10px")).to_equal(true)
        expect(_background_position_token("bogus")).to_equal(false)
        expect(_background_size_token("auto")).to_equal(true)
        expect(_background_size_token("10px")).to_equal(true)
        expect(_background_size_token("bogus")).to_equal(false)
        expect(_background_color_token("transparent")).to_equal(true)
        expect(_background_color_token("bogus")).to_equal(false)

describe "_parse_background_shorthand (U4.3 closure)":
    it "parses a valid shorthand into a BackgroundShorthand and rejects multi-layer values":
        val ok = _parse_background_shorthand("url(a.png) no-repeat center / 10px")
        expect(ok.valid).to_equal(true)
        expect(ok.image_uri).to_equal("a.png")
        expect(ok.repeat).to_equal("no-repeat")
        val bad = _parse_background_shorthand("linear-gradient(red, blue), url(a.png)")
        expect(bad.valid).to_equal(false)

describe "_decl_tbl_all_dispatch_handled / _decl_tbl_resolve_writing_mode (U4.3 closure)":
    it "reports whether every decl in the table has a known property id, and resolves writing-mode":
        expect(_decl_tbl_all_dispatch_handled(["color", "red"])).to_equal(true)
        expect(_decl_tbl_all_dispatch_handled(["not-a-real-prop", "x"])).to_equal(false)
        expect(_decl_tbl_resolve_writing_mode("horizontal-tb", ["writing-mode", "vertical-rl"])).to_equal("vertical-rl")
        expect(_decl_tbl_resolve_writing_mode("horizontal-tb", ["writing-mode", "bogus"])).to_equal("horizontal-tb")
        expect(_decl_tbl_resolve_writing_mode("horizontal-tb", [])).to_equal("horizontal-tb")

describe "parse_supported_nonnegative_px / decl_tbl_get_last_valid_nonnegative_px (U4.3 closure)":
    it "parses nonnegative px lengths and finds the last valid entry for a property":
        expect(parse_supported_nonnegative_px("10px")).to_equal(10)
        expect(parse_supported_nonnegative_px("10")).to_equal(10)
        expect(parse_supported_nonnegative_px("-5px")).to_equal(-1)
        expect(parse_supported_nonnegative_px("")).to_equal(-1)
        val found = decl_tbl_get_last_valid_nonnegative_px(["width", "5px", "width", "10px"], "width")
        if val Some(value) = found:
            expect(value).to_equal("10px")
        else:
            expect(true).to_equal(false)
        val missing = decl_tbl_get_last_valid_nonnegative_px(["height", "5px"], "width")
        expect(missing).to_equal(nil)

describe "parse_supported_outline_shorthand_width_px (U4.3 closure)":
    it "accepts zero and positive px widths, rejects non-positive/malformed values":
        expect(parse_supported_outline_shorthand_width_px("0")).to_equal(0)
        expect(parse_supported_outline_shorthand_width_px("0px")).to_equal(0)
        expect(parse_supported_outline_shorthand_width_px("3px")).to_equal(3)
        expect(parse_supported_outline_shorthand_width_px("-3px")).to_equal(-1)

describe "resolve_writing_mode_decls (U4.3 closure)":
    it "returns current when writing-mode is absent/over-quota, else the resolved value":
        expect(resolve_writing_mode_decls("horizontal-tb", "")).to_equal("horizontal-tb")
        expect(resolve_writing_mode_decls("horizontal-tb", "color:red")).to_equal("horizontal-tb")
        expect(resolve_writing_mode_decls("horizontal-tb", "writing-mode:vertical-rl")).to_equal("vertical-rl")

describe "normalized_grid_positive_int / normalized_grid_track_list (U4.3 closure)":
    it "parses digit-only integers and builds a validated px/fr track list":
        expect(normalized_grid_positive_int("42")).to_equal(42)
        expect(normalized_grid_positive_int("4x")).to_equal(0)
        expect(normalized_grid_positive_int("")).to_equal(0)
        expect(normalized_grid_track_list("10px 20px")).to_equal("10px 20px")
        expect(normalized_grid_track_list("1fr 2fr")).to_equal("1fr 2fr")
        expect(normalized_grid_track_list("10px bogus")).to_equal("")

describe "normalized_grid_placement (U4.3 closure)":
    it "resolves start-only, start/end, and start/span placements":
        expect(normalized_grid_placement("2")).to_equal("2")
        expect(normalized_grid_placement("2 / 4")).to_equal("2 / 4")
        expect(normalized_grid_placement("2 / span 3")).to_equal("2 / span 3")
        expect(normalized_grid_placement("0")).to_equal("")

describe "normalized_grid_area / normalized_grid_auto_flow / normalized_grid_template_areas (U4.3 closure)":
    it "passes through named areas, detects column auto-flow, and normalizes quoted area templates":
        expect(normalized_grid_area("header")).to_equal("header")
        expect(normalized_grid_area("auto")).to_equal("")
        expect(normalized_grid_area("1 / 2")).to_equal("")
        expect(normalized_grid_auto_flow("column")).to_equal(true)
        expect(normalized_grid_auto_flow("row")).to_equal(false)
        expect(normalized_grid_template_areas("\"a a\" \"b c\"")).to_equal("a a|b c")
        expect(normalized_grid_template_areas("\"a a\" \"b\"")).to_equal("")

# --- Coverage-closure wave 2 (2026-08-15): Style-fixture application paths ---

use gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_style.{renderer_default_style}
use gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_declarations.{
    apply_decls,
    apply_decls_on_writing_mode,
    apply_decls_without_display_on_writing_mode,
    tag_defaults,
}

describe "apply_decls dispatch fast path (wave 2 closure)":
    it "applies a rule made only of dispatch-handled properties in one pass":
        val st = apply_decls(renderer_default_style(),
            "box-sizing:border-box;border-collapse:collapse;border-radius:4px;" +
            "color:#112233;width:100px;height:50px;min-height:20px;" +
            "margin:1px 2px 3px 4px;z-index:5;justify-content:space-between;" +
            "align-items:center;gap:8px;flex-basis:10px;text-align:center;" +
            "font-style:italic;cursor:pointer;outline:2px solid #ff0000;" +
            "overflow:auto;box-shadow:2px 3px 4px rgba(0,0,0,0.5);" +
            "padding:5px 6px 7px 8px;display:flex", 16)
        expect(st.border_box).to_equal(true)
        expect(st.border_collapse).to_equal("collapse")
        expect(st.border_radius_px).to_equal(4)
        expect(st.fg).to_equal(0xFF112233u32)
        expect(st.width_px).to_equal(100)
        expect(st.height_px).to_equal(50)
        expect(st.min_height_px).to_equal(20)
        expect(st.margin_t).to_equal(1)
        expect(st.margin_r).to_equal(2)
        expect(st.margin_b).to_equal(3)
        expect(st.margin_l).to_equal(4)
        expect(st.z_index).to_equal(5)
        expect(st.justify_content).to_equal("space-between")
        expect(st.align_items).to_equal("center")
        expect(st.gap_px).to_equal(8)
        expect(st.flex_basis_px).to_equal(10)
        expect(st.text_align).to_equal("center")
        expect(st.font_style_italic).to_equal(true)
        expect(st.cursor).to_equal("pointer")
        expect(st.outline_w).to_equal(2)
        expect(st.box_shadow_blur_px).to_equal(4)
        expect(st.pad_t).to_equal(5)
        expect(st.pad_r).to_equal(6)
        expect(st.pad_b).to_equal(7)
        expect(st.pad_l).to_equal(8)
        expect(st.display).to_equal("flex")

    it "handles percentage and viewport-relative sizes, margin token counts, and margin-left":
        val a = apply_decls(renderer_default_style(), "width:50%;height:30%;min-height:50vh;margin:9px", 16)
        expect(a.width_px).to_equal(-50)
        expect(a.height_px).to_equal(-30)
        expect(a.min_height_vh).to_equal(true)
        expect(a.margin_t).to_equal(9)
        expect(a.margin_l).to_equal(9)
        val b = apply_decls(renderer_default_style(), "margin:1px 2px;margin-left:auto", 16)
        expect(b.margin_t).to_equal(1)
        expect(b.margin_r).to_equal(2)
        expect(b.margin_l_auto).to_equal(true)
        val c = apply_decls(renderer_default_style(), "margin:1px 2px 3px;margin-left:7px", 16)
        expect(c.margin_b).to_equal(3)
        expect(c.margin_l).to_equal(7)
        val d = apply_decls(renderer_default_style(), "margin-left:25%", 16)
        expect(d.margin_l).to_equal(-25)

    it "normalizes degenerate values: bad border-collapse, font-style normal, box-shadow none, outline none":
        val st = apply_decls(renderer_default_style(),
            "border-collapse:bogus;font-style:normal;box-shadow:none;outline:none;overflow:hidden", 16)
        expect(st.border_collapse).to_equal("separate")
        expect(st.font_style_italic).to_equal(false)
        expect(st.box_shadow_raw).to_equal("")
        expect(st.outline_w).to_equal(0)
        expect(st.overflow_hidden).to_equal(true)

    it "applies every supported display keyword through the dispatch path":
        expect(apply_decls(renderer_default_style(), "display:none", 16).display).to_equal("none")
        expect(apply_decls(renderer_default_style(), "display:inline", 16).display).to_equal("inline")
        expect(apply_decls(renderer_default_style(), "display:inline-block", 16).display).to_equal("inline-block")
        expect(apply_decls(renderer_default_style(), "display:list-item", 16).display).to_equal("list-item")
        expect(apply_decls(renderer_default_style(), "display:grid", 16).display).to_equal("grid")
        expect(apply_decls(renderer_default_style(), "display:block", 16).display).to_equal("block")
        expect(apply_decls(renderer_default_style(), "overflow:scroll", 16).overflow_scroll_y).to_equal(true)

    it "display:contents zeroes the box-generating fields":
        val st = apply_decls(renderer_default_style(),
            "display:contents;width:100px;height:40px;padding:5px;outline:3px solid #ff0000;margin:6px", 16)
        expect(st.display).to_equal("contents")
        expect(st.width_px).to_equal(0)
        expect(st.height_px).to_equal(0)
        expect(st.pad_t).to_equal(0)
        expect(st.outline_w).to_equal(0)
        expect(st.margin_t).to_equal(0)
        expect(st.margin_l_auto).to_equal(false)

    it "skips the display write when apply_display is false":
        val st = apply_decls_without_display_on_writing_mode(
            renderer_default_style(), "display:none;color:#445566", 16, "")
        expect(st.display).to_equal("block")
        expect(st.fg).to_equal(0xFF445566u32)

describe "apply_decls grid side path (wave 2 closure)":
    it "normalizes and applies the grid declaration family":
        val st = apply_decls(renderer_default_style(),
            "display:grid;grid-template-columns:1fr 2fr;grid-template-rows:100px 50px;" +
            "grid-column:1 / 3;grid-row:2;grid-template-areas:\"a b\" \"c d\";" +
            "grid-auto-flow:column;grid-area:hd", 16)
        expect(st.grid_template_columns).to_equal("1fr 2fr")
        expect(st.grid_template_rows).to_equal("100px 50px")
        expect(st.grid_column).to_equal("1 / 3")
        expect(st.grid_row).to_equal("2")
        expect(st.grid_template_areas).to_equal("a b|c d")
        expect(st.grid_auto_flow_column).to_equal(true)
        expect(st.grid_area).to_equal("hd")

    it "supports span placements and rejects non-increasing end lines":
        val st = apply_decls(renderer_default_style(), "grid-column:2 / span 3;grid-row:2 / 1", 16)
        expect(st.grid_column).to_equal("2 / span 3")
        expect(st.grid_row).to_equal("")

describe "authored sizing metadata under a logical writing mode (wave 2 closure)":
    it "an authored height clears height_auto in horizontal flow":
        val st = apply_decls(renderer_default_style(), "height:44px", 16)
        expect(st.height_auto).to_equal(false)

    it "keeps metadata resolution working under vertical-rl":
        val st = apply_decls_on_writing_mode(renderer_default_style(), "width:80px;height:44px", 16, "vertical-rl")
        expect(st.width_px).to_equal(80)

describe "_resolve_authored_padding longhand routing (wave 2 closure)":
    it "expands 2- and 3-token padding shorthands":
        val (t2, r2, b2, l2) = _resolve_authored_padding(["padding", "1px 2px"], 0, 0, 0, 0)
        expect(t2).to_equal(1)
        expect(r2).to_equal(2)
        expect(b2).to_equal(1)
        expect(l2).to_equal(2)
        val (t3, r3, b3, l3) = _resolve_authored_padding(["padding", "1px 2px 3px"], 0, 0, 0, 0)
        expect(t3).to_equal(1)
        expect(r3).to_equal(2)
        expect(b3).to_equal(3)
        expect(l3).to_equal(2)

    it "applies each physical and logical longhand":
        val (t, r, b, l) = _resolve_authored_padding([
            "padding-top", "1px", "padding-right", "2px", "padding-bottom", "3px",
            "padding-left", "4px"], 0, 0, 0, 0)
        expect(t).to_equal(1)
        expect(r).to_equal(2)
        expect(b).to_equal(3)
        expect(l).to_equal(4)
        val (bt, br, bb, bl) = _resolve_authored_padding([
            "padding-block", "5px 6px", "padding-inline", "7px 8px"], 0, 0, 0, 0)
        expect(bt).to_equal(5)
        expect(bb).to_equal(6)
        expect(bl).to_equal(7)
        expect(br).to_equal(8)
        val (st_, sr, sb, sl) = _resolve_authored_padding([
            "padding-block-start", "9px", "padding-block-end", "10px",
            "padding-inline-start", "11px", "padding-inline-end", "12px"], 0, 0, 0, 0)
        expect(st_).to_equal(9)
        expect(sb).to_equal(10)
        expect(sl).to_equal(11)
        expect(sr).to_equal(12)

    it "rejects an overflowing px count":
        expect(_padding_integer_px("99999999px")).to_equal(-1)

describe "background helper residual branches (wave 2 closure)":
    it "typed linear layer: rejects 3 layers and a trailing-garbage gradient":
        expect(_background_is_exact_typed_linear_layer(
            "linear-gradient(red,blue), #fff, #000", 1u32, 2u32, true)).to_equal(false)
        expect(_background_is_exact_typed_linear_layer(
            "linear-gradient(red,blue) extra", 1u32, 2u32, true)).to_equal(false)

    it "exact single url: rejects multi-layer, url-less, and double-url values":
        expect(_background_exact_single_url("url(a.png), url(b.png)")).to_equal("")
        expect(_background_exact_single_url("none")).to_equal("")
        expect(_background_exact_single_url("url(a.png) url(b.png)")).to_equal("")

    it "exact url value rejects trailing content after the close paren":
        expect(_background_exact_url_value("url(a.png) extra")).to_equal("")

    it "two-url plan rejects a single image and multi-valued sub-properties":
        expect(_background_two_url_plan("url(a.png)", "repeat", "", "", 0, 0, 0, 0, "padding-box", "border-box", "scroll")).to_equal("")
        expect(_background_two_url_plan("url(a.png), url(b.png)", "repeat,repeat", "", "", 0, 0, 0, 0, "padding-box", "border-box", "scroll")).to_equal("")

    it "position value: out-of-range percentage falls to 0":
        expect(_background_position_value("150%", true)).to_equal(0)

    it "shorthand tokens: a slash flushes the pending token":
        val toks = _background_shorthand_tokens("center/50px")
        expect(toks.len()).to_equal(3)
        expect(toks[0]).to_equal("center")
        expect(toks[1]).to_equal("/")
        expect(toks[2]).to_equal("50px")

    it "position pair: center followed by a horizontal keyword swaps axes":
        val pair = _background_position_pair("center", "left")
        expect(pair[0]).to_equal(-1000)
        expect(pair[1]).to_equal(-1050)

describe "_parse_background_shorthand residual branches (wave 2 closure)":
    it "parses a full accepted shorthand with color, url, repeat, position, size, and boxes":
        val sh = _parse_background_shorthand("#ff0000 url(a.png) no-repeat scroll content-box padding-box left top / 50px 60px")
        expect(sh.valid).to_equal(true)
        expect(sh.color).to_equal(0xFFFF0000u32)
        expect(sh.image_uri).to_equal("a.png")
        expect(sh.repeat).to_equal("no-repeat")
        expect(sh.size_w).to_equal(50)
        expect(sh.size_h).to_equal(60)
        expect(sh.origin).to_equal("content-box")
        expect(sh.clip).to_equal("padding-box")

    it "single box token sets both origin and clip; three box tokens reject":
        expect(_parse_background_shorthand("content-box").origin).to_equal("content-box")
        expect(_parse_background_shorthand("content-box").clip).to_equal("content-box")
        expect(_parse_background_shorthand("border-box padding-box content-box").valid).to_equal(false)

    it "rejects the unsupported and duplicate token shapes":
        expect(_parse_background_shorthand("/ 50px").valid).to_equal(false)
        expect(_parse_background_shorthand("center / bogus").valid).to_equal(false)
        expect(_parse_background_shorthand("fixed").valid).to_equal(false)
        expect(_parse_background_shorthand("scroll scroll").valid).to_equal(false)
        expect(_parse_background_shorthand("repeat repeat-x").valid).to_equal(false)
        expect(_parse_background_shorthand("1px 2px 3px").valid).to_equal(false)
        expect(_parse_background_shorthand("url(a.png) url(b.png)").valid).to_equal(false)
        expect(_parse_background_shorthand("#fff #000").valid).to_equal(false)
        expect(_parse_background_shorthand("@@").valid).to_equal(false)
        expect(_parse_background_shorthand("center /").valid).to_equal(false)

    it "resolves single vertical and paired positions":
        val v = _parse_background_shorthand("top")
        expect(v.position_x).to_equal(-1050)
        expect(v.position_y).to_equal(-1000)
        val p = _parse_background_shorthand("left top")
        expect(p.position_x).to_equal(-1000)
        expect(p.position_y).to_equal(-1000)

describe "grid normalizer residual branches (wave 2 closure)":
    it "track list: skips extra whitespace, rejects zero and non-px tokens":
        expect(normalized_grid_track_list("1fr  2fr")).to_equal("1fr 2fr")
        expect(normalized_grid_track_list("0fr")).to_equal("")
        expect(normalized_grid_track_list("1em")).to_equal("")
        expect(normalized_grid_track_list("0px")).to_equal("")

    it "placement rejects a span-less end line that does not increase":
        expect(normalized_grid_placement("2 / abc")).to_equal("")

    it "template areas: rejects unterminated, empty, and ragged rows; collapses cell whitespace":
        expect(normalized_grid_template_areas("\"a b")).to_equal("")
        expect(normalized_grid_template_areas("\"\"")).to_equal("")
        expect(normalized_grid_template_areas("\"a b\" \"c\"")).to_equal("")
        expect(normalized_grid_template_areas("\"a  b\"")).to_equal("a b")

describe "tag_defaults full tag table (wave 2 closure)":
    it "spot-checks representative tags and walks the whole default table":
        expect(tag_defaults(renderer_default_style(), "div").display).to_equal("block")
        expect(tag_defaults(renderer_default_style(), "script").display).to_equal("none")
        expect(tag_defaults(renderer_default_style(), "li").display).to_equal("block")
        expect(tag_defaults(renderer_default_style(), "h1").bold).to_equal(true)
        val tags = ["a", "address", "article", "blockquote", "body", "button",
            "caption", "center", "code", "dd", "details", "div", "dl", "fieldset",
            "figure", "footer", "h1", "h2", "h3", "h4", "h5", "h6", "header",
            "hr", "input", "kbd", "legend", "li", "mark", "menu", "nav", "ol",
            "p", "pre", "samp", "section", "small", "sub", "summary", "sup",
            "table", "tbody", "td", "tfoot", "th", "thead", "tr", "ul", "var",
            "span"]
        var ok = 0
        for tag in tags:
            val st = tag_defaults(renderer_default_style(), tag)
            if st.display.len() > 0:
                ok = ok + 1
        expect(ok).to_equal(tags.len())

describe "declaration residual value branches (wave 3 closure)":
    it "border-collapse:initial resets to separate through the dispatch path":
        val st = apply_decls(renderer_default_style(), "border-collapse:collapse;border-collapse:initial", 16)
        expect(st.border_collapse).to_equal("separate")

    it "width in vw units is stored as a negative viewport-relative value":
        expect(apply_decls(renderer_default_style(), "width:10vw", 16).width_px).to_equal(-10)

    it "gap:initial resets all three gap fields to zero":
        val st = apply_decls(renderer_default_style(), "gap:8px;gap:initial", 16)
        expect(st.gap_px).to_equal(0)
        expect(st.row_gap_px).to_equal(0)
        expect(st.column_gap_px).to_equal(0)

    it "grid placement rejects span 0":
        expect(normalized_grid_placement("2 / span 0")).to_equal("")

    it "a later logical block-size wins the sizing metadata under horizontal flow":
        val st = apply_decls(renderer_default_style(), "height:auto;block-size:44px", 16)
        expect(st.height_auto).to_equal(false)

    it "empty declaration text returns the style unchanged":
        val st = apply_decls(renderer_default_style(), "", 16)
        expect(st.display).to_equal("block")

    it "an unterminated url() is rejected":
        expect(_background_exact_single_url("url(a.png")).to_equal("")

    it "a three-image value has no two-url plan":
        expect(_background_two_url_plan("url(a.png), url(b.png), url(c.png)", "repeat", "", "", 0, 0, 0, 0, "padding-box", "border-box", "scroll")).to_equal("")
