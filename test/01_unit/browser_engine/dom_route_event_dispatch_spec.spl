# @req: REQ-GEN-BROWSERENGIN-001

# codex-system-test
# @req REQ-WEB-BROWSER-004
"""# Typed DOM route dispatch

Route dispatch preserves action order and cancellation without publishing or
reparsing text routing identities.
"""

use std.spec.*

use std.gc_async_mut.gpu.browser_engine.dom.{BeDomEvent, BeDomNode}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{
    BeDomRouteEventDispatch, be_dom_dispatch_event_to_route,
    be_dom_dispatch_keyboard_event_to_route,
    be_dom_dispatch_input_event_to_route
}
use std.gc_async_mut.gpu.browser_engine.dom_identity_index.{
    DomDocumentGeneration, DomIdentityIndex, DomNodeRoute,
    dom_identity_index_build
}

class DomRouteDispatchFixture:
    root: BeDomNode
    index: DomIdentityIndex
    root_route: DomNodeRoute
    parent_route: DomNodeRoute
    target_route: DomNodeRoute

fn _route_dispatch_generation() -> DomDocumentGeneration:
    match DomDocumentGeneration.create(1):
        Ok(generation): generation
        Err(reason): fail("Expected valid generation: {reason}")

fn _route_dispatch_route(
    index: DomIdentityIndex, author_id: text
) -> DomNodeRoute:
    match index.route_for_author_id(author_id):
        Some(route): route
        nil: fail("Expected route for #{author_id}")

fn _route_dispatch_fixture() -> DomRouteDispatchFixture:
    var root = BeDomNode.element_with_id(1, "document")
    root.set_attr("id", "root")
    root.add_event_listener_with_capture("click", "root-capture", true)
    var parent = BeDomNode.element_with_id(2, "div")
    parent.set_attr("id", "parent")
    parent.add_event_listener("click", "parent-bubble")
    var target = BeDomNode.element_with_id(3, "input")
    target.set_attr("id", "target")
    target.set_attr("type", "text")
    target.set_attr("onclick", "cancel")
    target.add_event_listener("keydown", "keyboard-target")
    target.add_event_listener("input", "input-target")
    parent.children.push(target)
    root.children.push(parent)
    val index = match dom_identity_index_build(
        root, _route_dispatch_generation()
    ):
        Ok(value): value
        Err(reason): fail("Expected identity index: {reason}")
    DomRouteDispatchFixture(
        root: root,
        index: index,
        root_route: _route_dispatch_route(index, "root"),
        parent_route: _route_dispatch_route(index, "parent"),
        target_route: _route_dispatch_route(index, "target")
    )

fn _route_dispatch_executor(
    event: BeDomEvent, node: BeDomNode, action: text, phase: text
) -> BeDomEvent:
    var next = event
    next.namespace_uri = "urn:test-payload"
    next.client_x = 42
    next.pointer_type = "pen"
    if action == "cancel":
        next.prevent_default()
    next

use std.spec.step

describe "Typed DOM route event dispatch":

    it "keeps typed current-target order and cancellation state":
        # @req: REQ-WEB-BROWSER-004
        step("Verify: keeps typed current-target order and cancellation state")
        val fixture = _route_dispatch_fixture()
        val dispatch = be_dom_dispatch_event_to_route(
            fixture.root, fixture.index, fixture.target_route,
            "click", true, true, true, _route_dispatch_executor
        )

        expect(dispatch.target_route).to_equal(fixture.target_route)
        expect(dispatch.related_target_route).to_be_nil()
        expect(dispatch.actions).to_equal([
            "root-capture", "cancel", "parent-bubble"
        ])
        expect(dispatch.phases).to_equal([
            "capture", "target", "bubble"
        ])
        expect(dispatch.current_targets.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(dispatch.current_targets[0]).to_equal(fixture.root_route)
        expect(dispatch.current_targets[1]).to_equal(fixture.target_route)
        expect(dispatch.current_targets[2]).to_equal(fixture.parent_route)
        expect(dispatch.event.default_prevented).to_be(true)
        expect(dispatch.event.namespace_uri).to_equal("urn:test-payload")
        expect(dispatch.event.client_x).to_equal(42)  # oracle: 42 — named expected value from the requirement
        expect(dispatch.event.pointer_type).to_equal("pen")
        expect(dispatch.event.target_tag).to_equal("input")
        expect(dispatch.event.current_target_tag).to_equal("div")
        expect(dispatch.default_action).to_equal("focus-element")
        expect(dispatch.default_action_allowed).to_be(false)

    it "returns the typed receipt for keyboard and input payloads":
        # @req: REQ-GEN-BROWSERENGIN-001
        step("Verify: returns the typed receipt for keyboard and input payloads")
        val fixture = _route_dispatch_fixture()
        val keyboard = be_dom_dispatch_keyboard_event_to_route(
            fixture.root, fixture.index, fixture.target_route,
            "keydown", true, true, "Enter", "Enter", false, true
        )
        val input = be_dom_dispatch_input_event_to_route(
            fixture.root, fixture.index, fixture.target_route,
            "input", true, false, Some("x"), "insertText", false, true
        )

        expect(keyboard.target_route).to_equal(fixture.target_route)
        expect(keyboard.event.key).to_equal("Enter")
        expect(keyboard.current_targets.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(keyboard.current_targets[0]).to_equal(fixture.target_route)
        expect(input.target_route).to_equal(fixture.target_route)
        expect(input.event.input_data).to_equal(Some("x"))
        expect(input.event.input_type).to_equal("insertText")
        expect(input.current_targets.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(input.current_targets[0]).to_equal(fixture.target_route)
