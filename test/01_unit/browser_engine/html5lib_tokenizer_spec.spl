# @req: REQ-GEN-BROWSERENGIN-001

"""
# Pinned HTML tokenizer vector specification

This specification compares the canonical tokenizer output with every field
represented by the pinned fixture schema. Adjacent character tokens are
coalesced because token chunk boundaries are not observable HTML semantics.

The fixtures are a curated local subset, not a claim that the upstream
html5lib tokenizer suite passes. Corpus placeholders remain explicitly
inadmissible as conformance evidence.
"""

use std.spec.*
use std.gc_async_mut.gpu.browser_engine.html_tokenizer.{
    HtmlToken, HtmlTokenKind, html_tokenizer_new, html_tokenizer_tokenize
}
use std.io_runtime.{read_file_text}
use std.json.{
    json_parse, json_object_get, json_object_keys, json_array_length,
    json_array_get, json_get_type, json_to_boolean, json_to_string
}

fn _load_fixture(filename: text) -> text:
    read_file_text("test/fixtures/html5lib/" + filename)

fn _run_tokenizer_on(input: text) -> [HtmlToken]:
    html_tokenizer_tokenize(html_tokenizer_new(input))

fn _normalized_tokens(tokens: [HtmlToken]) -> [HtmlToken]:
    var out: [HtmlToken] = []
    for token in tokens:
        if (
            token.token_kind == HtmlTokenKind.Character and
            out.len() > 0 and
            out[out.len() - 1].token_kind == HtmlTokenKind.Character
        ):
            val prior = out[out.len() - 1]
            out[out.len() - 1] = HtmlToken(
                token_kind: HtmlTokenKind.Character,
                tag_name: "",
                attrs: [],
                self_closing: false,
                data: prior.data + token.data
            )
        else:
            out.push(token)
    out

fn _token_kind_name(token: HtmlToken) -> text:
    if token.token_kind == HtmlTokenKind.Doctype: return "DOCTYPE"
    if token.token_kind == HtmlTokenKind.StartTag: return "StartTag"
    if token.token_kind == HtmlTokenKind.EndTag: return "EndTag"
    if token.token_kind == HtmlTokenKind.Character: return "Character"
    if token.token_kind == HtmlTokenKind.Comment: return "Comment"
    "EOF"

fn _attrs_match(token: HtmlToken, expected: any) -> bool:
    if json_get_type(expected) != "object":
        return false
    val keys = json_object_keys(expected)
    if keys.len() != token.attrs.len():
        return false
    for key in keys:
        var found = false
        for attr in token.attrs:
            if attr.name == key and
                attr.value == json_to_string(json_object_get(expected, key)):
                found = true
        if not found:
            return false
    true

fn _token_matches_expected(token: HtmlToken, expected: any) -> bool:
    if json_get_type(expected) != "array":
        return false
    val field_count = json_array_length(expected) as i32
    if field_count < 1 or
        json_get_type(json_array_get(expected, 0)) != "string":
        return false
    val kind = json_to_string(json_array_get(expected, 0))
    if _token_kind_name(token) != kind:
        return false

    if kind == "EOF":
        return field_count == 1
    if kind == "DOCTYPE":
        return (
            field_count == 2 and
            json_get_type(json_array_get(expected, 1)) == "string" and
            token.tag_name == json_to_string(json_array_get(expected, 1))
        )
    if kind == "EndTag":
        return (
            field_count == 2 and
            json_get_type(json_array_get(expected, 1)) == "string" and
            token.tag_name == json_to_string(json_array_get(expected, 1))
        )
    if kind == "Character" or kind == "Comment":
        return (
            field_count == 2 and
            json_get_type(json_array_get(expected, 1)) == "string" and
            token.data == json_to_string(json_array_get(expected, 1))
        )
    if kind != "StartTag" or field_count < 3 or field_count > 4:
        return false
    if (
        json_get_type(json_array_get(expected, 1)) != "string" or
        token.tag_name != json_to_string(json_array_get(expected, 1)) or
        not _attrs_match(token, json_array_get(expected, 2))
    ):
        return false
    var expected_self_closing = false
    if field_count == 4:
        if json_get_type(json_array_get(expected, 3)) != "boolean":
            return false
        expected_self_closing = (
            json_to_boolean(json_array_get(expected, 3)) == true
        )
    token.self_closing == expected_self_closing

fn _case_matches_expected(input: text, expected: any) -> bool:
    if json_get_type(expected) != "array":
        return false
    val actual = _normalized_tokens(_run_tokenizer_on(input))
    val expected_count = json_array_length(expected) as i32
    if actual.len() != expected_count:
        return false
    var index = 0
    while index < expected_count:
        if not _token_matches_expected(
            actual[index], json_array_get(expected, index)
        ):
            return false
        index = index + 1
    true

fn _json_string_field_equals(value: any, key: text, expected: text) -> bool:
    if json_get_type(value) != "object":
        return false
    val field = json_object_get(value, key)
    json_get_type(field) == "string" and json_to_string(field) == expected

fn _fixture_contract_valid(fixture: any) -> bool:
    if not _json_string_field_equals(
        fixture, "schema", "simple-html-token-v1"
    ):
        return false
    val provenance = json_object_get(fixture, "provenance")
    (
        _json_string_field_equals(provenance, "kind", "curated-local") and
        _json_string_field_equals(
            provenance, "upstream_html5lib_import", "not-imported"
        ) and
        _json_string_field_equals(
            provenance, "normalization",
            "coalesce-adjacent-character-tokens"
        ) and
        _json_string_field_equals(
            provenance, "token_fields",
            "kind,tag-name,attributes,self-closing,data"
        )
    )

fn _fixture_case_metadata_valid(case: any) -> bool:
    if json_get_type(case) != "object":
        return false
    val description = json_object_get(case, "description")
    (
        json_get_type(description) == "string" and
        json_to_string(description).trim() != ""
    )

fn _fixture_failure_count(filename: text) -> i32:
    val fixture = json_parse(_load_fixture(filename))
    if not _fixture_contract_valid(fixture):
        return 1
    val cases = json_object_get(fixture, "tests")
    if json_get_type(cases) != "array":
        return 1
    val count = json_array_length(cases) as i32
    if count == 0:
        return 1
    var failures = 0
    var index = 0
    while index < count:
        val case = json_array_get(cases, index)
        val input = json_object_get(case, "input")
        val expected = json_object_get(case, "output")
        if (
            not _fixture_case_metadata_valid(case) or
            json_get_type(input) != "string" or
            not _case_matches_expected(json_to_string(input), expected)
        ):
            failures = failures + 1
        index = index + 1
    failures

fn _corpus_baseline_is_admissible(content: text) -> bool:
    content.trim() != "" and not content.lower().contains("placeholder")

describe "Pinned HTML tokenizer vectors":
    # @manual: show
    # @req REQ-WEB-BROWSER-019 REQ-WEB-BROWSER-021
    it "should exactly match every normalized token in test1":
        # @req: REQ-WEB-BROWSER-019
        step("Verify: should exactly match every normalized token in test1")
        step("Load the first pinned tokenizer vector set")
        val fixture = _load_fixture("test1.json")
        expect(fixture.len()).to_be_greater_than(0)
        expect(_fixture_failure_count("test1.json")).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # @manual: show
    # @req REQ-WEB-BROWSER-019 REQ-WEB-BROWSER-021
    it "should exactly match every normalized token in test2":
        # @req: REQ-WEB-BROWSER-021
        step("Verify: should exactly match every normalized token in test2")
        step("Load the second pinned tokenizer vector set")
        val fixture = _load_fixture("test2.json")
        expect(fixture.len()).to_be_greater_than(0)
        expect(_fixture_failure_count("test2.json")).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # @manual: show
    # @req REQ-WEB-BROWSER-019 REQ-WEB-BROWSER-021
    it "should reject a known expected-token mutation":
        # @req: REQ-GEN-BROWSERENGIN-001
        step("Verify: should reject a known expected-token mutation")
        step("Change the expected start-tag name while keeping the input fixed")
        val mutated = json_parse(
            "[[\"StartTag\",\"wrong\",{}]," +
            "[\"Character\",\"hello\"],[\"EndTag\",\"p\"],[\"EOF\"]]"
        )
        expect(_case_matches_expected(
            "<p>hello</p>", mutated
        )).to_equal(false)

    # @manual: show
    # @req REQ-WEB-BROWSER-019 REQ-WEB-BROWSER-021
    it "should reject changed fixture provenance and missing descriptions":
        # @req: REQ-WEB-BROWSER-019
        step("Verify: should reject changed fixture provenance and missing descriptions")
        step("Change the declared normalization and token field schema")
        val changed_provenance = json_parse(
            "{\"schema\":\"simple-html-token-v1\",\"provenance\":{" +
            "\"kind\":\"curated-local\"," +
            "\"upstream_html5lib_import\":\"not-imported\"," +
            "\"normalization\":\"different\"," +
            "\"token_fields\":\"kind,data\"}}"
        )
        val rejects_changed_normalization = not _fixture_contract_valid(
            changed_provenance
        )
        val changed_fields = json_parse(
            "{\"schema\":\"simple-html-token-v1\",\"provenance\":{" +
            "\"kind\":\"curated-local\"," +
            "\"upstream_html5lib_import\":\"not-imported\"," +
            "\"normalization\":\"coalesce-adjacent-character-tokens\"," +
            "\"token_fields\":\"kind,data\"}}"
        )
        val rejects_changed_fields = not _fixture_contract_valid(
            changed_fields
        )

        step("Require a nonempty description on every loaded case")
        val undescribed = json_parse(
            "{\"description\":\"\",\"input\":\"x\"," +
            "\"output\":[[\"Character\",\"x\"],[\"EOF\"]]}"
        )
        val rejects_missing_description = not _fixture_case_metadata_valid(
            undescribed
        )
        expect(
            "{rejects_changed_normalization}|" +
            "{rejects_changed_fields}|{rejects_missing_description}"
        ).to_equal("true|true|true")

describe "Retained HTML corpus admission":
    # @manual: folded
    # @req REQ-WEB-BROWSER-019 REQ-WEB-BROWSER-021
    it "should reject empty and placeholder baselines as conformance evidence":
        # @req: REQ-WEB-BROWSER-021
        step("Verify: should reject empty and placeholder baselines as conformance evidence")
        step("Inspect the retained site corpus baseline")
        val content = read_file_text(
            "test/09_baselines/famous_site_corpus/site_0/baseline.txt"
        )
        expect(_corpus_baseline_is_admissible("")).to_equal(false)
        expect(_corpus_baseline_is_admissible(content)).to_equal(false)
