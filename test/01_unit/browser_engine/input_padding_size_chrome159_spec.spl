"""
## Purpose and audience
Purpose: Pin the border-box of an `<input>` / `<textarea>` with author
`padding` against Chrome 159 (author padding replaces the UA `1px 2px` and
grows the box).
Audience: web renderer form-control layout maintainers.

Chrome oracle: Chrome for Testing 159.0.8154.6 aarch64, `--dump-dom` with an
inline `getBoundingClientRect` script; doctype page, `body{margin:0;font:16px
'Liberation Sans'}`, controls `display:block`, measured 2026-11-19.

| case                                          | Chrome |
|-----------------------------------------------|--------|
| `<input>`                                     | 185x21 |
| `padding:10px`                                | 201x39 |
| `padding:0`                                   | 181x19 |
| `padding:4px 12px;border:1px solid #888`      | 203x25 |
| `width:200px;padding:10px` (content-box)      | 224x39 |
| same with `box-sizing:border-box`             | 200x39 |
| `type=password` `padding:6px`                 | 193x31 |
| `<textarea>` `padding:8px`                    | 194x48 |
"""

"""
Traceability: REQ-WEB-FORM-CHROME-PAINT-001 - author padding sizes a text control as Chrome 159.
"""
# @tag: unit, browser_engine, layout, form_control, chrome159
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_text.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{simple_web_layout_debug_layout_by_id}

val PAGE: text = "<!doctype html><html><head><style>body{{margin:0;font:16px 'Liberation Sans'}}input,textarea{{display:block}}</style></head><body>" +
    "<input id=\"c1\"><input id=\"c2\" style=\"padding:10px\"><input id=\"c3\" style=\"padding:0\">" +
    "<input id=\"c4\" style=\"padding:4px 12px;border:1px solid #888\">" +
    "<input id=\"c5a\" style=\"width:200px;padding:10px\">" +
    "<input id=\"c5b\" style=\"width:200px;padding:10px;box-sizing:border-box\">" +
    "<input id=\"c6\" type=\"password\" style=\"padding:6px\"><textarea id=\"c7\" style=\"padding:8px\"></textarea>" +
    "</body></html>"

fn _geo(id: text) -> text:
    simple_web_layout_debug_layout_by_id(PAGE, 900, 760, id, "w") + "x" + simple_web_layout_debug_layout_by_id(PAGE, 900, 760, id, "h")

describe "Author padding sizes a text control (Chrome 159)":
    it "AC-1: default, padding:10px and padding:0 text inputs":
        step("Chrome: 185x21, 201x39, 181x19")
        expect(_geo("c1")).to_equal("185x21")
        expect(_geo("c2")).to_equal("201x39")
        expect(_geo("c3")).to_equal("181x19")

    it "AC-2: padding with an author border":
        step("Chrome: 203x25")
        expect(_geo("c4")).to_equal("203x25")

    it "AC-3: explicit width, content-box and border-box":
        step("Chrome: 224x39 and 200x39")
        expect(_geo("c5a")).to_equal("224x39")
        expect(_geo("c5b")).to_equal("200x39")

    it "AC-4: password input and textarea":
        step("Chrome: 193x31 and 194x48")
        expect(_geo("c6")).to_equal("193x31")
        expect(_geo("c7")).to_equal("194x48")
