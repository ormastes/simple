"""
## Purpose and audience
Purpose: Pin that form controls take their UA font as a whole. Chrome's
html.css gives `button`, `input`, `select` (and `textarea`, monospace)
`font: -webkit-small-control`, which resets family, weight and style as well
as size. The tag defaults reset only the size and line height, so a button in
an `<h1>` measured its label bold (32 px wide where Chrome has 30), and a
button or input in a `<pre>` measured in monospace (button 33, input 153
where Chrome has 30 and 185).
Audience: browser-engine style maintainers.

Chrome oracle (Chrome 159.0.8154.6 headless shell, 900x4000,
`body{margin:0;font:16px/1.5 sans-serif}`, getBoundingClientRect width):

| parent                               | control                              | width  |
|--------------------------------------|--------------------------------------|--------|
| `<div>` (control)                    | `<button>cd</button>`                | 30.08  |
| `<h1>` (bold, 32 px)                 | `<button>cd</button>`                | 30.08  |
| `<pre>` (monospace)                  | `<button>cd</button>`                | 30.08  |
| `<pre>`                              | `<input value="cd">`                 | 185    |
| `font-weight:bold;font-style:italic` | `<button>cd</button>`                | 30.08  |
| `font-family:serif`                  | `<button>`, `<input>`, `<select>` (`cdcd`) | 30.08, 185, 51 |
| `<pre>`                              | `<button style="font-family:inherit">` | 32   |
| `<h1>`                               | `<button style="font-weight:inherit">` | 31.56 |
| `<pre>` or `<div>`                   | `<textarea>cd</textarea>`            | 181    |

Widths are asserted within 1 px (whole-pixel layout); the two `inherit` rows
assert that the author declaration still wins over the UA reset.
"""

"""
Traceability: REQ-BROWSER-ENGINE-FORM-CONTROL-UA-FONT-RESET-001 — form controls do not inherit font family, weight or style from their ancestors unless the author says so.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_declarations.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_layout_by_id
}

val HEAD: text = "<html><head><style>body{margin:0;font:16px/1.5 sans-serif}</style></head><body>"
val TAIL: text = "</body></html>"

fn width(inner: text, id: text) -> i32:
    simple_web_layout_debug_layout_by_id(HEAD + inner + TAIL, 900, 600, id, "w").to_int()

fn off(actual: i32, chrome: i32) -> i32:
    if actual > chrome: actual - chrome else: chrome - actual

describe "form controls take the UA font as a whole":
    it "AC-1: control — a button in a plain block is 30 px wide":
        step("Chrome 159: 30.08")
        expect(off(width("<div>ab <button id=\"c\">cd</button> ef</div>", "c"), 30)).to_be_less_than(2)

    it "AC-2: a button does not inherit a heading's weight":
        step("Chrome 159: 30.08 inside <h1>")
        expect(off(width("<h1 style=\"margin:0\">ab <button id=\"c\">cd</button> ef</h1>", "c"), 30)).to_be_less_than(2)
        step("Chrome 159: 30.08 inside font-weight:bold;font-style:italic")
        expect(off(width("<div style=\"font-weight:bold;font-style:italic\">ab <button id=\"c\">cd</button> ef</div>", "c"), 30)).to_be_less_than(2)

    it "AC-3: a button or input does not inherit a monospace family":
        step("Chrome 159: button 30.08, input 185 inside <pre>")
        expect(off(width("<pre style=\"margin:0\">ab <button id=\"c\">cd</button> ef</pre>", "c"), 30)).to_be_less_than(2)
        expect(width("<pre style=\"margin:0\">ab <input id=\"c\" value=\"cd\"> ef</pre>", "c")).to_equal(185)

    it "AC-4: button, input and select ignore a serif parent":
        step("Chrome 159: 30.08, 185, 51")
        val page = "<div style=\"font-family:serif\">ab <button id=\"c\">cd</button> <input id=\"i\" value=\"cd\"> <select id=\"s\"><option>cdcd</option></select></div>"
        expect(off(width(page, "c"), 30)).to_be_less_than(2)
        expect(width(page, "i")).to_equal(185)
        expect(off(width(page, "s"), 51)).to_be_less_than(2)

    it "AC-5: an author `inherit` still wins over the UA reset":
        step("Chrome 159: font-family:inherit in <pre> -> 32 (monospace label)")
        val family = width("<pre style=\"margin:0\">ab <button id=\"c\" style=\"font-family:inherit\">cd</button> ef</pre>", "c")
        expect(family).to_be_greater_than(31)
        step("Chrome 159: font-weight:inherit in <h1> -> 31.56 (bold label)")
        val weight = width("<h1 style=\"margin:0\">ab <button id=\"c\" style=\"font-weight:inherit\">cd</button> ef</h1>", "c")
        expect(weight).to_be_greater_than(30)

    it "AC-6: a textarea keeps its own monospace UA font everywhere":
        step("Chrome 159: 181 wide in <pre> and in <div>")
        expect(width("<pre style=\"margin:0\">ab <textarea id=\"c\">cd</textarea> ef</pre>", "c")).to_equal(181)
        expect(width("<div>ab <textarea id=\"c\">cd</textarea> ef</div>", "c")).to_equal(181)
