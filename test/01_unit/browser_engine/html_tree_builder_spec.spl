use std.spec.*
use std.gc_async_mut.gpu.browser_engine.html_tree_builder.{
    html_tree_builder_build, html_tree_builder_build_with_scripts,
    html_tree_builder_build_with_parse_limits,
    html_tree_builder_debug_dump_bedom,
    html_tree_builder_flat_projection
}
use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{
    be_dom_get_tag, be_dom_get_children,
    be_dom_get_attr, be_dom_get_text_content,
    be_dom_serialize_html
}

fn _build(html: text) -> BeDomNode:
    return html_tree_builder_build(html)

fn _serialized(html: text) -> text:
    """Byte-exact document the tree builder produces for `html`."""
    return be_dom_serialize_html(html_tree_builder_build(html))

fn _child_count(node: BeDomNode) -> i32:
    return be_dom_get_children(node).len()

fn _first_child_tag(node: BeDomNode) -> text:
    val ch = be_dom_get_children(node)
    if ch.len() == 0:
        return ""
    return be_dom_get_tag(ch[0])

fn _find_first_by_tag(node: BeDomNode, tag: text) -> BeDomNode:
    val ch = be_dom_get_children(node)
    var i = 0
    while i < ch.len():
        val child = ch[i]
        if be_dom_get_tag(child) == tag:
            return child
        i = i + 1
    return node

fn _find_nested(node: BeDomNode, tag: text) -> BeDomNode:
    val ch = be_dom_get_children(node)
    var i = 0
    while i < ch.len():
        val child = ch[i]
        if be_dom_get_tag(child) == tag:
            return child
        val nested = _find_nested(child, tag)
        if be_dom_get_tag(nested) == tag:
            return nested
        i = i + 1
    return node

# ============================================================================
# AC-2: Tree builder — implicit tag closing
# ============================================================================

describe "HtmlTreeBuilder implicit closing":
    it "AC-2: wraps body content in html/head/body even when absent":
        val doc = _build("<p>hello</p>")
        val html = _first_child_tag(doc)
        expect(html).to_equal("html")

    it "AC-2: implicitly closes <li> when next <li> starts":
        val doc = _build("<ul><li>a<li>b</ul>")
        val ul = _find_nested(doc, "ul")
        val count = _child_count(ul)
        expect(count).to_equal(2)

    it "AC-2: implicitly closes <p> when block element starts":
        val doc = _build("<p>text<div>block</div>")
        val div = _find_nested(doc, "div")
        val tag = be_dom_get_tag(div)
        expect(tag).to_equal("div")

# ============================================================================
# AC-2: Tree builder — scope-based insertion
# ============================================================================

describe "HtmlTreeBuilder scope-based insertion":
    it "AC-2: inserts heading inside body scope":
        val doc = _build("<h1>Title</h1>")
        val h1 = _find_nested(doc, "h1")
        expect(be_dom_get_tag(h1)).to_equal("h1")

    it "AC-2: attribute preserved on parsed element":
        val doc = _build("<a href=\"/path\">link</a>")
        val a = _find_nested(doc, "a")
        val href = be_dom_get_attr(a, "href")
        expect(href).to_equal("/path")

    it "AC-2: nested structure preserves parent-child relationship":
        val doc = _build("<div><p><span>text</span></p></div>")
        val div = _find_nested(doc, "div")
        val p = _find_first_by_tag(div, "p")
        val span = _find_first_by_tag(p, "span")
        expect(be_dom_get_tag(span)).to_equal("span")

# ============================================================================
# AC-2: Tree builder — foster parenting basics
# ============================================================================

describe "HtmlTreeBuilder foster parenting":
    it "AC-2: text before <table> is foster-parented before table":
        val doc = _build("<table>misplaced text<tr><td>cell</td></tr></table>")
        val body = _find_nested(doc, "body")
        val count = _child_count(body)
        expect(count).to_be_greater_than(0)

    it "AC-2: <p> inside <table> is foster-parented outside table":
        val doc = _build("<table><p>para</p><tr><td>x</td></tr></table>")
        val body = _find_nested(doc, "body")
        val p = _find_first_by_tag(body, "p")
        expect(be_dom_get_tag(p)).to_equal("p")

    it "foster-parents a void element out of table context":
        expect(_serialized("<table><img src='a'><tr><td>c")).to_equal(
            "<html><head></head><body><img src=\"a\">" +
            "<table><tbody><tr><td>c</td></tr></tbody></table></body></html>"
        )

    # bug browser_engine_no_implicit_tbody_synthesis_2026-08-19 (reproduce
    # spec: pre-fix the tree was table/tr with NO tbody, unlike every browser)
    it "synthesizes an implicit tbody for a row directly inside <table>":
        expect(_serialized("<table><tr><td>x</td></tr></table>")).to_equal(
            "<html><head></head><body>" +
            "<table><tbody><tr><td>x</td></tr></tbody></table></body></html>"
        )

    it "synthesizes an implicit tbody for a stray cell directly inside <table>":
        expect(_serialized("<table><td>x</td></table>")).to_equal(
            "<html><head></head><body>" +
            "<table><tbody><td>x</td></tbody></table></body></html>"
        )

    it "does not double-wrap an explicit tbody":
        expect(_serialized("<table><tbody><tr><td>x</td></tr></tbody></table>")).to_equal(
            "<html><head></head><body>" +
            "<table><tbody><tr><td>x</td></tr></tbody></table></body></html>"
        )

    it "leaves rows inside an explicit thead alone":
        expect(_serialized("<table><thead><tr><th>h</th></tr></thead></table>")).to_equal(
            "<html><head></head><body>" +
            "<table><thead><tr><th>h</th></tr></thead></table></body></html>"
        )

# ============================================================================
# Void elements, implicit closing and stray end tags
# ============================================================================

describe "HtmlTreeBuilder void and implicit-close handling":
    it "never opens a scope for a void element":
        expect(_serialized("<p>a<br>b<hr><img src='i.png'><wbr>c")).to_equal(
            "<html><head></head><body><p>a<br>b</p><hr>" +
            "<img src=\"i.png\"><wbr>c</body></html>"
        )

    it "emits every void tag without a closing tag":
        val void_tags = [
            "area", "base", "br", "col", "embed", "hr", "img", "input",
            "link", "meta", "param", "source", "track", "wbr"
        ]
        expect(void_tags.len()).to_equal(14)
        var i = 0
        while i < void_tags.len():
            val tag = void_tags[i]
            val html = _serialized("<div><" + tag + "></div>")
            expect(html).to_contain("<" + tag + ">")
            expect(html.index_of("</" + tag + ">")).to_equal(-1)
            i = i + 1

    it "closes an open <p> before every block-level element":
        val block_tags = [
            "address", "article", "aside", "blockquote", "div", "dl",
            "details", "fieldset", "footer", "h1", "h2", "h3", "h4", "h5",
            "h6", "header", "hr", "main", "menu", "nav", "ol", "p", "pre",
            "section", "summary", "table", "ul"
        ]
        expect(block_tags.len()).to_equal(27)
        var i = 0
        while i < block_tags.len():
            expect(_serialized(
                "<p>x<" + block_tags[i] + ">"
            )).to_contain("<p>x</p>")
            i = i + 1

    it "keeps an open <p> when an inline element starts":
        expect(_serialized("<p>x<span>y</span>")).to_equal(
            "<html><head></head><body><p>x<span>y</span></p></body></html>"
        )

    it "closes an open <dt> or <dd> when the other kind starts":
        expect(_serialized("<dl><dt>a<dd>b<dt>c<dd>d</dl>")).to_equal(
            "<html><head></head><body><dl>" +
            "<dt>a</dt><dd>b</dd><dt>c</dt><dd>d</dd>" +
            "</dl></body></html>"
        )

    it "ignores an end tag for an element that was never opened":
        expect(_serialized("<p>x</p></div></span>")).to_equal(
            "<html><head></head><body><p>x</p></body></html>"
        )

    it "treats a self-closed non-void start tag as an open scope":
        expect(_serialized("<div><span/>t</div>")).to_equal(
            "<html><head></head><body><div><span>t</span></div></body></html>"
        )

# ============================================================================
# Head content, raw text and document-element attributes
# ============================================================================

describe "HtmlTreeBuilder head and document structure":
    it "keeps <title> text in the head instead of the body":
        expect(_serialized("<head><title>Hi</title></head><p>x")).to_equal(
            "<html><head><title>Hi</title></head>" +
            "<body><p>x</p></body></html>"
        )

    it "appends meta, link and base as void head children":
        expect(_serialized(
            "<head><meta charset='utf-8'><link rel='s' href='a.css'>" +
            "<base href='/r/'></head><p>x"
        )).to_equal(
            "<html><head><meta charset=\"utf-8\">" +
            "<link href=\"a.css\" rel=\"s\"><base href=\"/r/\"></head>" +
            "<body><p>x</p></body></html>"
        )

    it "drops <style> raw text instead of admitting it as content":
        expect(_serialized("<style>p{{color:red}}</style><p>x")).to_equal(
            "<html><head></head><body><p>x</p></body></html>"
        )

    it "drops <noscript> raw text but keeps the elements it wrapped":
        expect(_serialized(
            "<noscript><p>hidden</p></noscript><p>x"
        )).to_equal(
            "<html><head></head><body><p></p><p>x</p></body></html>"
        )

    it "applies attributes to the synthesized html and body elements":
        expect(_serialized(
            "<html lang='en'><head></head><body class='b'><p>x</p>" +
            "</body></html>"
        )).to_equal(
            "<html lang=\"en\"><head></head>" +
            "<body class=\"b\"><p>x</p></body></html>"
        )

    it "merges a second <body> start tag into the open body element":
        expect(_serialized("<body id='a'><p>x</p><body id='b'>")).to_equal(
            "<html><head></head><body id=\"b\"><p>x</p></body></html>"
        )

    it "discards doctype and comment tokens":
        expect(_serialized("<!DOCTYPE html><!-- c --><p>x")).to_equal(
            "<html><head></head><body><p>x</p></body></html>"
        )

    it "synthesizes an empty body for empty and whitespace-only input":
        val empty_document = "<html><head></head><body></body></html>"
        expect(_serialized("")).to_equal(empty_document)
        expect(_serialized("   ")).to_equal(empty_document)

# ============================================================================
# Script collection
# ============================================================================

describe "HtmlTreeBuilder script collection":
    it "separates external src paths from inline script bodies":
        val result = html_tree_builder_build_with_scripts(
            "<script src='a.js'></script><script>var x=1;</script><p>y"
        )
        expect(result.src_paths.len()).to_equal(1)
        expect(result.src_paths[0]).to_equal("a.js")
        expect(result.scripts.len()).to_equal(1)
        expect(result.scripts[0]).to_equal("var x=1;")
        expect(result.truncated).to_equal(false)
        expect(be_dom_serialize_html(result.doc)).to_equal(
            "<html><head></head><body><script src=\"a.js\"></script>" +
            "<script>var x=1;</script><p>y</p></body></html>"
        )

    it "does not collect a script nested inside a <template>":
        val result = html_tree_builder_build_with_scripts(
            "<template><script>inner</script></template>"
        )
        expect(result.scripts.len()).to_equal(0)
        expect(result.src_paths.len()).to_equal(0)

# ============================================================================
# Debug dump, flat projection and node-limit truncation
# ============================================================================

describe "HtmlTreeBuilder projections and limits":
    it "dumps depth, tag, style length and child count per node":
        expect(html_tree_builder_debug_dump_bedom("<p>x</p>")).to_equal(
            "0|#document|attrlen=0|childcount=1\n" +
            "1|html|attrlen=0|childcount=2\n" +
            "2|head|attrlen=0|childcount=0\n" +
            "2|body|attrlen=0|childcount=1\n" +
            "3|p|attrlen=0|childcount=1\n" +
            "4|#text|attrlen=0|childcount=0"
        )

    it "flattens in pre-order with normalized attributes and parentage":
        val projection = html_tree_builder_flat_projection(
            "<div id='a'><span>t</span></div>"
        )
        expect(projection.truncated).to_equal(false)
        expect(projection.nodes.len()).to_equal(7)
        expect(projection.nodes[0].tag).to_equal("#document")
        expect(projection.nodes[0].parent).to_equal(-1)
        expect(projection.nodes[4].tag).to_equal("div")
        expect(projection.nodes[4].normalized_attrs).to_equal(" id=\"a\"")
        expect(projection.nodes[4].parent).to_equal(3)
        expect(projection.nodes[4].depth).to_equal(3)
        expect(projection.nodes[5].tag).to_equal("span")
        expect(projection.nodes[5].parent).to_equal(4)
        expect(projection.nodes[5].depth).to_equal(4)
        expect(projection.nodes[6].tag).to_equal("#text")
        expect(projection.nodes[6].text_data).to_equal("t")
        expect(projection.nodes[6].parent).to_equal(5)

    it "stops admitting element nodes once the node limit is reached":
        val limited = html_tree_builder_build_with_parse_limits(
            "<p>a<p>b<p>c", 2, 100, 10
        )
        expect(limited.truncated).to_equal(true)
        expect(be_dom_serialize_html(limited.doc)).to_equal(
            "<html><head></head><body></body></html>"
        )

    it "still applies html and body attributes at an exhausted node limit":
        # <html>/<head>/<body> start tags create no node, so the limit check
        # lets them through and their attributes reach the synthesized
        # elements; the <p> that follows is what trips truncation.
        val body_attr = html_tree_builder_build_with_parse_limits(
            "<body class='x'><p>y</p>", 4, 1000, 10
        )
        expect(body_attr.truncated).to_equal(true)
        expect(be_dom_serialize_html(body_attr.doc)).to_equal(
            "<html><head></head><body class=\"x\"></body></html>"
        )

        val html_attr = html_tree_builder_build_with_parse_limits(
            "<html lang='en'><p>y</p>", 4, 1000, 10
        )
        expect(html_attr.truncated).to_equal(true)
        expect(be_dom_serialize_html(html_attr.doc)).to_equal(
            "<html lang=\"en\"><head></head><body></body></html>"
        )

    it "never truncates on tokens that would create no node":
        # An end tag for a non-script element, and raw text skipped inside
        # <style>, both create nothing — a document made only of those plus a
        # <body> start tag parses to completion at the minimum node limit.
        val end_tag = html_tree_builder_build_with_parse_limits(
            "</p><body class='x'>", 4, 1000, 10
        )
        expect(end_tag.truncated).to_equal(false)
        expect(be_dom_serialize_html(end_tag.doc)).to_equal(
            "<html><head></head><body class=\"x\"></body></html>"
        )

        val skipped_raw = html_tree_builder_build_with_parse_limits(
            "<style>a</style><body class='x'>", 4, 1000, 10
        )
        expect(skipped_raw.truncated).to_equal(false)
        expect(be_dom_serialize_html(skipped_raw.doc)).to_equal(
            "<html><head></head><body class=\"x\"></body></html>"
        )

    it "separates whitespace from text when the node limit is reached":
        # Before the body opens, whitespace-only character data creates no
        # node and so does not truncate; any non-whitespace does.
        val whitespace = html_tree_builder_build_with_parse_limits(
            "   ", 4, 1000, 10
        )
        expect(whitespace.truncated).to_equal(false)
        expect(be_dom_serialize_html(whitespace.doc)).to_equal(
            "<html><head></head><body></body></html>"
        )

        val text_data = html_tree_builder_build_with_parse_limits(
            "hi", 4, 1000, 10
        )
        expect(text_data.truncated).to_equal(true)
        expect(be_dom_serialize_html(text_data.doc)).to_equal(
            "<html><head></head><body></body></html>"
        )

    it "opens the body on the first non-whitespace text with no tags at all":
        # Leading whitespace rides along in the same character token, so it is
        # kept rather than trimmed away.
        expect(_serialized("hello")).to_equal(
            "<html><head></head><body>hello</body></html>"
        )
        expect(_serialized("  hi")).to_equal(
            "<html><head></head><body>  hi</body></html>"
        )
