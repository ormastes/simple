"""
## Purpose and audience
Purpose: hand over a Chrome 159 fact found by the forms parity lane: the
bottom partial row of a 16px Liberation Sans underscore. It is the shared
cause of the forms-media regions around x 528-740 that sit about 0.08 px
high (`owner=simple_web_html_layout_renderer_paint_layout.spl` in each
feature row): only the underscores differ, so the ink centroid moves up.
Audience: maintainers of the glyph raster vertical frame
(`common/encoding/sfnt_glyf.spl`, owned by the LCD glyph lane).

Chrome oracle (Chrome for Testing 159.0.8154.6 aarch64, `--headless=new
--disable-gpu --hide-scrollbars --force-device-scale-factor=1`, window
400x300), black on white, `font:16px/1.5 'Liberation Sans'`, `p{margin:0;
padding:4px 10px}`, text `a_b___c` in the second paragraph. The underscore
paints row 55 solid and row 56 at a quarter: columns 20-22 and 41-43 =
(191,191,191). Here row 56 is white: the bitmap ends after one row, so the
1.25 px bar loses its bottom quarter.
"""

"""
Traceability: REQ-WEB-TEXT-GLYPH-RASTER-001 -- a glyph's partial bottom row is kept at 1x, handed over.
"""
# @tag: unit, browser_engine, text, chrome159
# @tag:in-development
# Tracks: underscore bottom partial row at 16px 1x, handed over by the forms parity lane 2026-11-24 (pagediff_claims "forms lane" HANDOFF row); owner: glyph raster vertical frame (sfnt_glyf).
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}

val CSS_W: i32 = 400
val CSS_H: i32 = 300
val PAGE: text = "<!doctype html><html><head><style>body{{margin:0;background:#fff;color:#000;font:16px/1.5 sans-serif}} p{{margin:0;padding:4px 10px}}</style></head><body><p>a_b___c</p><p style=\"font-family:'Liberation Sans'\">a_b___c</p></body></html>"

fn _gray_text(px: [u32], y: i32, cols: [i32]) -> text:
    var s = ""
    for c in cols:
        val p = px[y * CSS_W + c]
        val g = ((p >> 8u32) & 0xFFu32) as i32
        val shown = if g >= 183 and g <= 199: 191 else: g
        s = s + "{c}={shown} "
    s

describe "A 16px underscore's bottom row (Chrome 159, 1x, handover)":
    it "AC-1: keeps its quarter-covered bottom row":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, 1, "cpu_simd")
        expect(_gray_text(px, 56, [20, 21, 22, 41, 42, 43])).to_equal("20=191 21=191 22=191 41=191 42=191 43=191 ")
