"""
## Purpose and audience
Purpose: Pin Filter Effects 2 Backdrop Root behaviour for production-style
nested glass (gradient image layer, `backdrop-filter: blur(24px)
saturate(1.7)`, an outer 120px halo) against Chrome 159 on the Engine2D
Vulkan lane. The cpu_simd lane and the page are described in
backdrop_root_glass_gradient_saturate_chrome159_spec.spl.
Audience: maintainers of the web paint path and the Engine2D Vulkan backend.
"""

"""
Traceability: doc/08_tracking/bug/web_layout_cascade_selector_paint_chrome159_round4_divergences_2026-11-15.md
(2026-11-20: window-fixture glass is 241 where Chrome shows 251).
Chrome pixels: headless Chromium 1255 at 400x300, the same pages and points
as the cpu_simd spec. The CSS backdrop blur runs on the host over a device
region readback (the device blur kernel serves only the WM glass material),
so the device blur count is not asserted; every frame must still be read
back from the Vulkan device.
"""
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}
use std.gc_async_mut.gpu.engine2d.backend_vulkan.{
    vulkan_readback_count
}

val WGV_FILTER = "backdrop-filter:blur(24px) saturate(1.7)"
val WGV_HALO = "box-shadow:0 0 120px rgba(137,180,250,0.12)"
val WGV_WHITE = "rgba(255,255,255,0.72)"
val WGV_OUTER_TINT = "rgba(255,160,60,0.45)"
val WGV_INNER_TINT = "rgba(60,140,255,0.45)"

fn wgv_html(outer_extra: text, outer_bg: text, inner_bg: text) -> text:
    val grad = "linear-gradient(rgba(255,255,255,0.08),rgba(255,255,255,0.024))"
    "<!DOCTYPE html><html><body style='margin:0;background:#1e1e2e'><div style='position:absolute;left:0;top:120px;width:400px;height:60px;background:#c03020'></div><div style='position:absolute;left:10px;top:10px;width:380px;height:280px;border-radius:20px;background:" + grad + "," + outer_bg + ";" + outer_extra + "'><div style='position:absolute;left:20px;top:50px;width:340px;height:200px;border-radius:20px;background:" + grad + "," + inner_bg + ";" + WGV_FILTER + "'></div></div></body></html>"

# Channel mismatches (beyond +-2) against `want`: x, y, r, g, b per point.
fn wgv_mismatches(px: [u32], want: [i32]) -> i32:
    if px.len() < 400 * 300:
        return -1
    var bad = 0
    var i = 0
    while i < want.len():  # cpu-lane-loop-ok: spec probe points; bound want.len() / 5
        val p = px[want[i + 1] * 400 + want[i]]
        var c = 0
        while c < 3:  # cpu-lane-loop-ok: RGB channels of one probe pixel; bound 3
            val d = ((p >> ((16 - c * 8) as u32)) & 0xFFu32) as i32 - want[i + 2 + c]
            if d > 2 or d < -2:
                bad = bad + 1
            c = c + 1
        i = i + 5
    bad

fn wgv_render(html: text) -> [u32]:
    simple_web_layout_render_html_pixels_engine2d_at_device_scale(html, 400, 300, 1, "vulkan")

describe "backdrop root glass with gradient and saturate on Vulkan (Chrome 159)":
    it "window shape: halo, gradient and saturate together, on the device":
        val readbacks = vulkan_readback_count()
        val px = wgv_render(wgv_html(WGV_FILTER + ";" + WGV_HALO, WGV_WHITE, WGV_WHITE))
        expect(vulkan_readback_count() - readbacks >= 1).to_equal(true)
        expect(wgv_mismatches(px, [200, 150, 253, 250, 249, 200, 80, 252, 251, 252, 200, 35, 197, 197, 203, 200, 275, 194, 194, 201, 4, 150, 188, 55, 43])).to_equal(0)

    it "tinted glass keeps the colour pass to one src-over, on the device":
        val readbacks = vulkan_readback_count()
        val px = wgv_render(wgv_html(WGV_FILTER, WGV_OUTER_TINT, WGV_INNER_TINT))
        expect(vulkan_readback_count() - readbacks >= 1).to_equal(true)
        expect(wgv_mismatches(px, [200, 150, 167, 139, 137, 200, 80, 144, 144, 147, 200, 35, 140, 100, 73, 200, 275, 134, 92, 63, 4, 150, 192, 48, 32])).to_equal(0)
