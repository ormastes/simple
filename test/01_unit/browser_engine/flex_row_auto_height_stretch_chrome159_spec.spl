"""
## Purpose and audience
Purpose: Pin that in an auto-height row flexbox, `align-items: stretch`
(the default) stretches every auto-height item to the line's cross size,
the tallest item's height (CSS Flexbox 1 §9.4 step 11), including an item
that is itself a column flexbox.
Audience: browser-engine flex layout maintainers.

Chrome oracle (Chrome 159, 900x2000, `body{margin:0}`, rows
`display:flex;width:200px` with a `50x30` sibling, getBoundingClientRect
y,height, 2026-11-16):

| item                                              | y,h   |
|---------------------------------------------------|-------|
| empty `width:20px`                                | 0,30  |
| `width:20px` with text                            | 30,30 |
| column flexbox `flex:1` holding two 10px blocks   | 60,30 |
| `align-self:flex-start` with text (not stretched) | 90,18 |
| row `align-items:center`, `height:10px` item      | 130,10 |

Filed as `flex_nested_col` in
doc/08_tracking/bug/web_layout_cascade_selector_paint_chrome159_round4_divergences_2026-11-15.md.
"""

"""
Traceability: REQ-BROWSER-ENGINE-FLEX-ROW-STRETCH-001 — auto-height row flex items stretch to the line cross size.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_engine.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_layout_by_id
}

val PAGE: text = "<html><head><style>body{{margin:0}} .r{{display:flex;width:200px}}</style></head><body>" +
    "<div class=r><div id=a style=\"width:20px\"></div><div style=\"width:50px;height:30px\"></div></div>" +
    "<div class=r><div id=b style=\"width:20px\">x</div><div style=\"width:50px;height:30px\"></div></div>" +
    "<div class=r><div id=c style=\"display:flex;flex-direction:column;flex:1\"><div id=ca style=\"height:10px\"></div><div style=\"height:10px\"></div></div><div style=\"width:50px;height:30px\"></div></div>" +
    "<div class=r><div id=d style=\"width:20px;align-self:flex-start\">x</div><div style=\"width:50px;height:30px\"></div></div>" +
    "<div class=r style=\"align-items:center\"><div id=e style=\"width:20px;height:10px\"></div><div style=\"width:50px;height:30px\"></div></div>" +
    "</body></html>"

fn _yh(id: text) -> text:
    simple_web_layout_debug_layout_by_id(PAGE, 900, 2000, id, "y") + "," +
        simple_web_layout_debug_layout_by_id(PAGE, 900, 2000, id, "h")

describe "auto-height row flex stretch":
    it "AC-1: an empty item stretches to the tallest sibling":
        expect(_yh("a")).to_equal("0,30")

    it "AC-2: a text item stretches too":
        expect(_yh("b")).to_equal("30,30")

    it "AC-3: a nested column flexbox stretches":
        expect(_yh("c")).to_equal("60,30")

    it "AC-4: align-self:flex-start keeps its content height":
        expect(_yh("d")).to_equal("90,18")

    it "AC-5: align-items:center does not stretch":
        expect(_yh("e")).to_equal("130,10")
