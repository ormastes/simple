fn ds_mismatches(px: [u32], fw: i32, xs: [i32], ys: [i32], want: [u32], lane: text) -> i32:
    if px.len() < fw * 48:
        return 9999
    var bad = 0
    var n = 0
    # cpu-lane-loop-ok: test pin scan; bound is the pin count
    while n < xs.len():
        val got = px[ys[n] * fw + xs[n]] | 0xFF000000u32
        if got != want[n]:
            if bad < 10:
                print "{lane} ({xs[n]},{ys[n]}) got {got} want {want[n]}"
            bad = bad + 1
        n = n + 1
    if bad > 0:
        print "{lane} mismatches {bad}"
    bad

val THIN_PAGE = "<!DOCTYPE html><html><body style=\"margin:0;background:#fff\"><div style=\"position:absolute;left:10px;top:10px;width:71px;height:30px;border:1px dashed #000\"></div><div style=\"position:absolute;left:100px;top:10px;width:90px;height:30px;border:2px dashed #000\"></div></body></html>"

# Chrome 159, 1x, --window-size=200,60. Each row/column is ink (#), paper (.),
# or partial coverage (?, not pinned).
val THIN_A_TOP = "###..###..###..###..###..###..###..###..###..###..###..###..###..###..###"
val THIN_A_LEFT = "###.?##?.?##?.?##?.?##?.?##..###"
val THIN_B_TOP = "######...?#####?...?#####?...?#####?...######....######...?#####?...?#####?...?#####?...######"
val THIN_B_LEFT = "######...?#####?..?#####?...######"

fn thin_row(px: [u32], fw: i32, y: i32, x0: i32, n: i32) -> text:
    var s = ""
    var i = 0
    # cpu-lane-loop-ok: test pin scan; bound is the pin length
    while i < n:
        s = s + (if (px[y * fw + x0 + i] & 0xFFu32) < 128u32: "#" else: ".")
        i = i + 1
    s

fn thin_col(px: [u32], fw: i32, x: i32, y0: i32, n: i32) -> text:
    var s = ""
    var i = 0
    # cpu-lane-loop-ok: test pin scan; bound is the pin length
    while i < n:
        s = s + (if (px[(y0 + i) * fw + x] & 0xFFu32) < 128u32: "#" else: ".")
        i = i + 1
    s

fn thin_differs(got: text, want: text) -> bool:
    if got.len() != want.len():
        return true
    var i = 0
    # cpu-lane-loop-ok: test pin scan; bound is the pin length
    while i < want.len():
        if want[i] != "?" and want[i] != got[i]:
            return true
        i = i + 1
    false

fn thin_mismatches(px: [u32], lane: text) -> i32:
    if px.len() < 200 * 60:
        return 9999
    var bad = 0
    val a_top = thin_row(px, 200, 10, 10, 73)
    val a_left = thin_col(px, 200, 10, 10, 32)
    val b_top0 = thin_row(px, 200, 10, 100, 94)
    val b_top1 = thin_row(px, 200, 11, 100, 94)
    val b_left = thin_col(px, 200, 100, 10, 34)
    if thin_differs(a_top, THIN_A_TOP):
        print "{lane} 1px top {a_top}"
        bad = bad + 1
    if thin_differs(a_left, THIN_A_LEFT):
        print "{lane} 1px left {a_left}"
        bad = bad + 1
    if thin_differs(b_top0, THIN_B_TOP):
        print "{lane} 2px top0 {b_top0}"
        bad = bad + 1
    if thin_differs(b_top1, THIN_B_TOP):
        print "{lane} 2px top1 {b_top1}"
        bad = bad + 1
    if thin_differs(b_left, THIN_B_LEFT):
        print "{lane} 2px left {b_left}"
        bad = bad + 1
    bad

describe "square dashed and dotted borders lay out dashes as Chrome 159":
    it "on the CPU raster":
        expect(ds_mismatches(simple_web_layout_render_html_software_pixels(DS_PAGE, 160, 48), 160, DS_X, DS_Y, DS_CHROME, "raster") + ds_mismatches(simple_web_layout_render_html_software_pixels(SS_PAGE, 210, 70), 210, SS_X, SS_Y, SS_CHROME, "raster short")).to_equal(0)

    it "on cpu_simd":
        expect(ds_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(DS_PAGE, 160, 48, "cpu_simd"), 160, DS_X, DS_Y, DS_CHROME, "cpu_simd") + ds_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(SS_PAGE, 210, 70, "cpu_simd"), 210, SS_X, SS_Y, SS_CHROME, "cpu_simd short")).to_equal(0)

    it "on Vulkan":
        expect(ds_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(DS_PAGE, 160, 48, "vulkan"), 160, DS_X, DS_Y, DS_CHROME, "vulkan") + ds_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(SS_PAGE, 210, 70, "vulkan"), 210, SS_X, SS_Y, SS_CHROME, "vulkan short")).to_equal(0)

describe "thin dashed borders use Chrome 159 thin-dash ratios":
    it "on the CPU raster":
        expect(thin_mismatches(simple_web_layout_render_html_software_pixels(THIN_PAGE, 200, 60), "raster")).to_equal(0)

    it "on cpu_simd":
        expect(thin_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(THIN_PAGE, 200, 60, "cpu_simd"), "cpu_simd")).to_equal(0)

    it "on Vulkan":
        expect(thin_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(THIN_PAGE, 200, 60, "vulkan"), "vulkan")).to_equal(0)

# Dotted borders at 1x (Chrome 159, --force-device-scale-factor=1, --window-size=500,300): 2px and 3px dots are square pixel runs on a pitch of 2t, not
# the fitted dpr4 ones. Row/column of ink (#) / paper (.) through the border centre; 3px / 2px boxes of 200x100, then 3px / 2px sides of 50..60px.
val DOT1_PAGE = "<!DOCTYPE html><html><body style=\"margin:0;background:#fff\"><div style=\"position:absolute;left:10px;top:10px;width:194px;height:94px;border:3px dotted #000\"></div><div style=\"position:absolute;left:230px;top:10px;width:196px;height:96px;border:2px dotted #000\"></div><div style=\"position:absolute;left:10px;top:120px;width:44px;height:8px;border:3px dotted #000\"></div><div style=\"position:absolute;left:10px;top:136px;width:46px;height:8px;border:3px dotted #000\"></div><div style=\"position:absolute;left:10px;top:152px;width:48px;height:8px;border:3px dotted #000\"></div><div style=\"position:absolute;left:10px;top:168px;width:49px;height:8px;border:3px dotted #000\"></div><div style=\"position:absolute;left:10px;top:184px;width:53px;height:8px;border:3px dotted #000\"></div><div style=\"position:absolute;left:10px;top:200px;width:54px;height:8px;border:3px dotted #000\"></div><div style=\"position:absolute;left:230px;top:120px;width:47px;height:10px;border:2px dotted #000\"></div><div style=\"position:absolute;left:230px;top:136px;width:48px;height:10px;border:2px dotted #000\"></div><div style=\"position:absolute;left:230px;top:152px;width:51px;height:10px;border:2px dotted #000\"></div><div style=\"position:absolute;left:230px;top:168px;width:52px;height:10px;border:2px dotted #000\"></div></body></html>"
val DOT1_A_TOP = "###..###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###"
val DOT1_A_LEFT = "###....###...###...###...###...###...###...###...###...###...###...###...###...###...###...###...###"
val DOT1_B_TOP = "##.##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##.##"
val DOT1_B_LEFT = "##.##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##..##.##"
val DOT1_C50 = "###..###...###...###...###...###...###...###...###"
val DOT1_C52 = "###....###...###...###...###...###...###...###...###"
val DOT1_C54 = "####...###...###...###...###...###...###...###....####"
val DOT1_C55 = "###..###...###...###...###...###...###...###...###..###"
val DOT1_C59 = "###....###...###...###...###...###...###...###...###....###"
val DOT1_C60 = "####...###...###...###...###...###...###...###...###....####"
val DOT1_D51 = "##...##..##..##..##..##..##..##..##..##..##..##..##"
val DOT1_D52 = "##.##..##..##..##..##..##..##..##..##..##..##..##.##"
val DOT1_D55 = "##...##..##..##..##..##..##..##..##..##..##..##..##..##"
val DOT1_D56 = "##.##..##..##..##..##..##..##..##..##..##..##..##..##.##"

fn dot1_mismatches(px: [u32], lane: text) -> i32:
    if px.len() < 500 * 300:
        return 9999
    var bad = 0
    var got = thin_row(px, 500, 11, 10, 200)
    if got != DOT1_A_TOP:
        print "{lane} 3px top {got}"
        bad = bad + 1
    got = thin_col(px, 500, 11, 10, 100)
    if got != DOT1_A_LEFT:
        print "{lane} 3px left {got}"
        bad = bad + 1
    got = thin_row(px, 500, 11, 230, 200)
    if got != DOT1_B_TOP:
        print "{lane} 2px top {got}"
        bad = bad + 1
    got = thin_col(px, 500, 231, 10, 100)
    if got != DOT1_B_LEFT:
        print "{lane} 2px left {got}"
        bad = bad + 1
    got = thin_row(px, 500, 121, 10, 50)
    if got != DOT1_C50:
        print "{lane} 3px side 50 {got}"
        bad = bad + 1
    got = thin_row(px, 500, 137, 10, 52)
    if got != DOT1_C52:
        print "{lane} 3px side 52 {got}"
        bad = bad + 1
    got = thin_row(px, 500, 153, 10, 54)
    if got != DOT1_C54:
        print "{lane} 3px side 54 {got}"
        bad = bad + 1
    got = thin_row(px, 500, 169, 10, 55)
    if got != DOT1_C55:
        print "{lane} 3px side 55 {got}"
        bad = bad + 1
    got = thin_row(px, 500, 185, 10, 59)
    if got != DOT1_C59:
        print "{lane} 3px side 59 {got}"
        bad = bad + 1
    got = thin_row(px, 500, 201, 10, 60)
    if got != DOT1_C60:
        print "{lane} 3px side 60 {got}"
        bad = bad + 1
    got = thin_row(px, 500, 121, 230, 51)
    if got != DOT1_D51:
        print "{lane} 2px side 51 {got}"
        bad = bad + 1
    got = thin_row(px, 500, 137, 230, 52)
    if got != DOT1_D52:
        print "{lane} 2px side 52 {got}"
        bad = bad + 1
    got = thin_row(px, 500, 153, 230, 55)
    if got != DOT1_D55:
        print "{lane} 2px side 55 {got}"
        bad = bad + 1
    got = thin_row(px, 500, 169, 230, 56)
    if got != DOT1_D56:
        print "{lane} 2px side 56 {got}"
        bad = bad + 1
    bad

describe "1x 2px and 3px dotted borders place dots as Chrome 159":
    it "on the CPU raster":
        expect(dot1_mismatches(simple_web_layout_render_html_software_pixels(DOT1_PAGE, 500, 300), "raster")).to_equal(0)

    it "on cpu_simd":
        expect(dot1_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(DOT1_PAGE, 500, 300, "cpu_simd"), "cpu_simd")).to_equal(0)

    it "on Vulkan":
        expect(dot1_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(DOT1_PAGE, 500, 300, "vulkan"), "vulkan")).to_equal(0)
