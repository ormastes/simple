"""
## Purpose and audience
Purpose: Pin Chrome 159's tops of lines 2+ of a wrapped text run and of lines a
bigger inline makes taller. Chrome stacks line boxes in LayoutUnits: line j of
a 15px/1.3 run starts j x 19.5 px below the first (rows 0, 19.5, 39), not
j x 19; a 22px/1.3 span makes its line 28.594 px (the half leading above the
baseline is floored, the line-height keeps its fraction below); and the lines
after it start below that height, not below how far the line's baseline moved
the run. This engine painted lines 2+ at whole-px steps from the run's
baseline-shifted box: one row high per line at 1x, 3 px high after a tall line.
Audience: web renderer inline layout maintainers.

Chrome oracle: Chrome for Testing 159.0.8154.6 aarch64, `--headless=new
--disable-gpu --hide-scrollbars --force-device-scale-factor=K`, window
400x400, Liberation Sans via `sans-serif`; `Range.getClientRects()` for
WRAP_MIXED_PAGE's divs: tops 0, 48.0938, 115.6875, 163.7813. Values are the
device rows with green < 128 in one column, as runs.

| page / column          | K | Chrome                          | base ea5ca01cfce |
|------------------------|---|---------------------------------|------------------|
| WRAP_PAGE, x 2         | 1 | 5-14 25-34 44-53 66-78 ...      | 5-14 24-33 43-52 |
| WRAP_PAGE, x 8         | 4 | 18-58 96-136 174-214            | 18-58 94-134 170-210 |
| WRAP_PAGE, x 8 bottoms | 4 | 315 427 540                     | 315 427 539 |
| WRAP_MIXED_PAGE, x 2   | 1 | ... 74-88 101-110 122-136 149-158 ... | ... 73-87 97-106 121-135 145-154 ... |
| TALL_PAGE, x 2         | 1 | ... 53-62 87-98 ...             | ... 50-59 77-88 ... |

Not pinned: lines with a bigger inline at device scale 4 (1..4 device rows
early, as on base).
"""

"""
Traceability: REQ-WEB-INLINE-LINE-TOPS-001 — lines 2+ of a wrapped run and lines after a taller line start at Chrome's exact LayoutUnit tops.
"""
# @tag: unit, browser_engine, layout, inline, line_height, device_scale, chrome159
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_foundation.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}

val WRAP_PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;font:16px/1.5 sans-serif;color:#000;background:#fff}} div{{margin:0}}</style></head><body><div style=\"width:60px;font-size:15px;line-height:1.3\">HH HH HH HH HH HH</div><div style=\"width:60px;font-size:18.72px;line-height:1.5\">HH HH HH HH HH</div><div>HH <span style=\"font-size:24px\">HH</span> HH</div><div>HH <span style=\"display:inline-block;height:30px;width:10px;background:#888\"></span> HH</div><div>after</div></body></html>"

val WRAP_MIXED_PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;font:16px/1.5 sans-serif;color:#000;background:#fff}} div{{margin:0;width:70px;font-size:15px;line-height:1.3}}</style></head><body><div>HH HH <span style=\"font-size:22px\">HH</span> HH</div><div>HH HH <span style=\"font-size:22px\">HH</span> HH HH HH<i></i></div><div><span style=\"font-size:22px\">HH</span> HH HH HH</div><div>after</div></body></html>"

val TALL_PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;font:16px/1.5 sans-serif;color:#000;background:#fff}} div{{margin:0;width:70px}}</style></head><body><div style=\"font-size:15px;line-height:1.3\">HH HH <span style=\"font-size:22px\">HH</span> HH HH HH</div><div>HH HH <span style=\"display:inline-block;height:31px;width:10px;background:#888\"></span> HH HH HH</div><div>after</div></body></html>"

# Runs of device rows y0..y1 whose pixel in column x has green < 128.
fn _runs(px: [u32], w: i32, x: i32, y0: i32, y1: i32) -> text:
    var s = ""
    var start = -1
    var y = y0
    while y <= y1:
        val ink = y < y1 and ((px[y * w + x] >> 8u32) & 255u32) < 128u32
        if ink and start < 0:
            start = y
        if not ink and start >= 0:
            s = s + " {start}-{y - 1}"
            start = -1
        y = y + 1
    s.trim()

# The last row of each run in rows y0..y1 of column x: the glyph raster here
# is one row taller than Chrome's at the top, so the bottoms are compared.
fn _bottoms(px: [u32], w: i32, x: i32, y0: i32, y1: i32) -> text:
    var s = ""
    var y = y0
    while y < y1:
        val ink = ((px[y * w + x] >> 8u32) & 255u32) < 128u32
        val next_ink = y + 1 < y1 and ((px[(y + 1) * w + x] >> 8u32) & 255u32) < 128u32
        if ink and not next_ink:
            s = s + " {y}"
        y = y + 1
    s.trim()

describe "Wrapped and taller line tops (Chrome 159)":
    it "AC-1: lines 2+ of a 19.5 px run step 19.5 px at device scale 1":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(WRAP_PAGE, 400, 400, 1, "cpu_simd")
        expect(_runs(px, 400, 2, 0, 400)).to_equal("5-14 25-34 44-53 66-78 94-106 122-134 157-168 197-208 224-225 227-228 231-232")

    it "AC-2: and 78 device px at device scale 4":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(WRAP_PAGE, 400, 400, 4, "cpu_simd")
        expect(_runs(px, 1600, 8, 0, 250)).to_equal("18-58 96-136 174-214")

    it "AC-3: a 22px span's line is 28.594 px and the run's next lines start below it":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(WRAP_MIXED_PAGE, 400, 400, 1, "cpu_simd")
        expect(_runs(px, 400, 2, 0, 400)).to_equal("5-14 26-40 53-62 74-88 101-110 122-136 149-158 171-172 174-175 178-178")

    it "AC-4: the block after a taller wrapped line starts at its exact bottom":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(TALL_PAGE, 400, 400, 1, "cpu_simd")
        expect(_runs(px, 400, 2, 0, 400)).to_equal("5-14 26-40 53-62 87-98 111-122 135-146 162-163 165-166 169-170")

    it "AC-5: an 18.72px/1.5 run's lines 2+ step 112.32 device px at device scale 4 (bottom rows)":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(WRAP_PAGE, 400, 400, 4, "cpu_simd")
        expect(_bottoms(px, 1600, 8, 250, 560)).to_equal("315 427 540")
