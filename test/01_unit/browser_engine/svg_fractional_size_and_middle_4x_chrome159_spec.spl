"""
## Purpose and audience
Purpose: Handoff red spec. Pins three inline `<svg>` placement gaps against
Chrome 159 at k=4 that the svg-offset lane measured and did not fix:
a viewBox-derived height is rounded to whole CSS px (12.25 -> 12, 16.667 -> 17),
fractional `width`/`height` attributes are truncated (40.5 x 20.3 -> 40 x 20),
and `vertical-align: middle` sits one device row high. `top` and `bottom`
already match and are pinned as controls.
EXPECTED RED, tagged `@tag:in-development` (a whole-suite run skips and COUNTS
it). Owner: replaced-element sizing / inline vertical-align (layout lane).
Audience: web renderer replaced-element layout.

Chrome oracle: Chrome for Testing 159.0.8154.6 aarch64, `--headless=new
--disable-gpu --hide-scrollbars --force-device-scale-factor=4`, window 400 CSS
px wide, Liberation Sans 16px/1.5. Each case is its own 60px block (240 rows).

| case | what | Chrome | base d40623d3f59 |
|------|------|--------|------------------|
| `vertical-align:middle` 40x20 | rect rows | 13..92 | 12..91 |
| `vertical-align:top` 40x41 (control) | rect rows | 240..403 | 240..403 |
| `width=49 viewBox="0 0 4 1"` | rect rows / first col | 501..549 / 89 | 502..549 / 93 |
| `width=50 viewBox="0 0 3 1"` | rect rows | 723..788 | 722..789 |
| `width=40.5 height=20.3` | rect rows / cols / line bg | 960..1040 / 89..250 / 960..1066 | 960..1039 / 89..248 / 960..1065 |
| `vertical-align:bottom` 40x20 (control) | rect rows | 1216..1295 | 1216..1295 |
"""

"""
Traceability: REQ-WEB-SVG-FRACTIONAL-SIZE-001 — an inline svg keeps its fractional used size and its vertical-align position at device scale.
"""
# @tag: unit, browser_engine, device_scale, layout, svg, chrome159
# @tag:in-development
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_engine.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}

val CSS_W: i32 = 400
val CSS_H: i32 = 360
val K: i32 = 4

val PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff;font:16px/1.5 'Liberation Sans';color:#172033}}.b{{height:60px}}</style></head><body><div class=\"b\"><div style=\"background:#ffe0e0\">ab <svg width=\"40\" height=\"20\" style=\"vertical-align:middle\"><rect width=\"40\" height=\"20\" fill=\"#ff0000\"></rect></svg> cd</div></div><div class=\"b\"><div style=\"background:#e0ffe0\">ab <svg width=\"40\" height=\"41\" style=\"vertical-align:top\"><rect width=\"40\" height=\"41\" fill=\"#00ff00\"></rect></svg> cd</div></div><div class=\"b\"><div style=\"background:#e0e0ff\">ab <svg width=\"49\" viewBox=\"0 0 4 1\"><rect width=\"4\" height=\"1\" fill=\"#0000ff\"></rect></svg> cd</div></div><div class=\"b\"><div style=\"background:#ffe0ff\">ab <svg width=\"50\" viewBox=\"0 0 3 1\"><rect width=\"3\" height=\"1\" fill=\"#ff00ff\"></rect></svg> cd</div></div><div class=\"b\"><div style=\"background:#e0ffff\">ab <svg width=\"40.5\" height=\"20.3\"><rect width=\"100\" height=\"100\" fill=\"#00c0c0\"></rect></svg> cd</div></div><div class=\"b\"><div style=\"background:#ffffe0\">ab <svg width=\"40\" height=\"20\" style=\"vertical-align:bottom\"><rect width=\"40\" height=\"20\" fill=\"#ffa000\"></rect></svg> cd</div></div></body></html>"

var g_px: [u32] = []

fn _px() -> [u32]:
    if g_px.len() == 0:
        g_px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, K, "cpu_simd")
    g_px

# "first..last" device rows on column x whose pixel is exactly rgb.
fn _rows(x: i32, rgb: u32) -> text:
    val px = _px()
    val w = CSS_W * K
    var first = -1
    var last = -1
    var y = 0
    while y < CSS_H * K:
        if (px[y * w + x] & 0xFFFFFFu32) == rgb:
            if first < 0:
                first = y
            last = y
        y = y + 1
    "{first}..{last}"

# "first..last" device columns on row y whose pixel is exactly rgb.
fn _cols(y: i32, rgb: u32) -> text:
    val px = _px()
    val w = CSS_W * K
    var first = -1
    var last = -1
    var x = 0
    while x < w:
        if (px[y * w + x] & 0xFFFFFFu32) == rgb:
            if first < 0:
                first = x
            last = x
        x = x + 1
    "{first}..{last}"

describe "An inline svg keeps its fractional size and middle alignment (Chrome 159, k=4)":
    it "AC-1: vertical-align middle puts the 40x20 svg on device rows 13..92":
        expect(_px().len()).to_equal((CSS_W * K * CSS_H * K) as i64)
        expect(_rows(150, 0xFF0000u32)).to_equal("13..92")

    it "AC-2: vertical-align top and bottom stay on Chrome's rows (controls)":
        expect(_rows(150, 0x00FF00u32)).to_equal("240..403")
        expect(_rows(150, 0xFFA000u32)).to_equal("1216..1295")

    it "AC-3: width 49 with a 4:1 viewBox is 12.25 px high: 49 device rows from column 89":
        expect(_rows(150, 0x0000FFu32)).to_equal("501..549")
        expect(_cols(525, 0x0000FFu32)).to_equal("89..284")

    it "AC-4: width 50 with a 3:1 viewBox is 16.667 px high: rows 723..788":
        expect(_rows(150, 0xFF00FFu32)).to_equal("723..788")

    it "AC-5: width 40.5 and height 20.3 keep their fractions: 162 x 81 device px and a 107-row line":
        expect(_rows(150, 0x00C0C0u32)).to_equal("960..1040")
        expect(_cols(1000, 0x00C0C0u32)).to_equal("89..250")
        expect(_rows(1000, 0xE0FFFFu32)).to_equal("960..1066")
