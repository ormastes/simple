fn rd_mismatches(px: [u32], lane: text) -> i32:
    if px.len() < 160 * 90:
        return 9999
    var bad = 0
    var n = 0
    # cpu-lane-loop-ok: test pin scan; bound is the pin count
    while n < RD_X.len():
        val got = px[RD_Y[n] * 160 + RD_X[n]] | 0xFF000000u32
        if got != RD_CHROME[n]:
            if bad < 10:
                print "{lane} ({RD_X[n]},{RD_Y[n]}) got {got} want {RD_CHROME[n]}"
            bad = bad + 1
        n = n + 1
    if bad > 0:
        print "{lane} mismatches {bad}"
    bad

describe "dotted borders paint round dots (Chrome 159)":
    it "on the CPU raster":
        expect(rd_mismatches(simple_web_layout_render_html_software_pixels(RD_PAGE, 160, 90), "raster")).to_equal(0)

    it "on cpu_simd":
        expect(rd_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(RD_PAGE, 160, 90, "cpu_simd"), "cpu_simd")).to_equal(0)

    it "on Vulkan":
        expect(rd_mismatches(simple_web_render_html_to_pixels_with_resolved_engine2d_backend(RD_PAGE, 160, 90, "vulkan"), "vulkan")).to_equal(0)
