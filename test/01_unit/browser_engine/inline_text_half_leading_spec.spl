"""
## Purpose and audience
Purpose: Pin that a bare `#text` run sits in its line box by HALF-LEADING,
exactly like an inline element's text. An inline non-replaced element
(`<strong>`, `<code>`) is already centred on its content area
(`align_inline_line_baselines`), but a bare text run kept its box at the line
top, so in `Paragraph with <strong>strong</strong>, ...` the plain words were
painted 3 px ABOVE the strong/em/code words (catalog `overview`), and every
block made of plain text (h1, blockquote, li) sat 3-4 px above Chromium's.
Audience: browser-engine inline-layout maintainers.

Chrome oracle (Chrome 159 headless shell, standards mode, Range.getBoundingClientRect
of each text node, page `*{box-sizing:border-box}body{margin:0;font:16px/1.5
sans-serif}`, Liberation Sans / DejaVu Sans Mono):

| text node                     | line box top | text rect top | offset |
|-------------------------------|--------------|---------------|--------|
| `<p>` plain `Paragraph with ` | 69.44        | 72.44         | +3     |
| `<strong>` text               | 69.44        | 72.44         | +3     |
| `<code>` text (h 18)          | 69.44        | 73.44         | +4     |
| `<section><h1>` text (32/48)  | 21.44        | 27.44         | +6     |

KNOWN GAP: AC-4 pins the `<code>` text at +2 (the Chromium 131 figure, and what
the content-area centring produces). Chrome 159 puts it at +4 (rect h 18): it
aligns the monospace run on the parent strut BASELINE rather than centring its
content area. AC-4 is a no-regression control for this change, not a Chrome
159 parity claim.
"""

"""
Traceability: REQ-BROWSER-ENGINE-INLINE-HALF-LEADING-001 — every text run in a line shares the line's half-leading placement.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_foundation.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_layout_by_id
}

val VW: i32 = 900
val VH: i32 = 760
val HEAD: text = "<html><head><style>*{box-sizing:border-box}body{margin:0;font:16px/1.5 sans-serif}</style></head><body>"
val PARA: text = "<p id=\"p\">Paragraph with <strong id=\"s\">strong</strong>, <code id=\"c\">inline code</code> x</p>"

fn probe(inner: text, id: text, name: text) -> text:
    simple_web_layout_debug_layout_by_id(
        HEAD + inner + "</body></html>", VW, VH, id, name)

describe "a bare text run is placed by half-leading like an inline element":
    it "AC-1: control — the paragraph line box starts at y=16":
        step("Chrome: p margin-top 16 (1em), line box top 16")
        expect(probe(PARA, "p", "y")).to_equal("16")

    it "AC-2: the plain text run sits 3 px below the line top":
        step("Chrome: plain text rect top = line top + 3")
        expect(probe(PARA, "p", "text_y")).to_equal("19")

    it "AC-3: control — the strong text keeps its +3 placement":
        step("Chrome: strong text rect top = line top + 3")
        expect(probe(PARA, "s", "text_y")).to_equal("19")

    it "AC-4: control — the monospace code text keeps its +2 placement":
        step("Chromium 131: line top + 2 (Chrome 159: + 4, see KNOWN GAP)")
        expect(probe(PARA, "c", "text_y")).to_equal("18")

    it "AC-5: a heading's only text run is half-leaded in its 48 px line":
        step("Chrome 159: <section><h1> is 32px (no sectioning shrink) at y=21.44, text rect top +6")
        expect(probe("<section><h1 id=\"h\">Common HTML</h1></section>", "h", "text_y")).to_equal("27")

# A line made TALLER than the line-height by an atomic inline (Chrome: 47 px
# line, plain text rect top 26, strong text rect top 26; with a 32 px span,
# 48 px line, plain 21, strong 21, the big span's own text 6). The inline
# element takes the strut-baseline branch there, and must carry the same
# content-area offset as the bare run beside it.
val TALL: text = "<p id=\"p\">plain <strong id=\"s\">strong</strong> <span style=\"display:inline-block;width:20px;height:40px\"></span></p>"
val MIXED: text = "<p id=\"q\">plain <strong id=\"t\">strong</strong> <span id=\"g\" style=\"font-size:32px\">big</span></p>"

describe "runs stay on one baseline when the line is taller than the line-height":
    it "AC-6: strong and plain text share a top beside a 40 px inline-block":
        step("Chrome: both text rects at line top + 26")
        expect(probe(TALL, "s", "text_y")).to_equal(probe(TALL, "p", "text_y"))

    it "AC-7: strong and plain text share a top beside a 32 px span":
        step("Chrome: both text rects at line top + 21")
        expect(probe(MIXED, "t", "text_y")).to_equal(probe(MIXED, "q", "text_y"))

    it "AC-8: the plain run sits 21 px below the 48 px line's top":
        step("Chrome: p y=16, plain text rect top 16 + 21 = 37")
        expect(probe(MIXED, "q", "text_y")).to_equal("37")

    it "AC-9: the 32 px span's text sits 6 px below the line top":
        step("Chrome: big text rect top 16 + 6 = 22")
        expect(probe(MIXED, "g", "text_y")).to_equal("22")
