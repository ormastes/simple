# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
"""
# An auto-width inline-block holding a row flex container (Chrome 159)

Bug web_inline_block_flex_percent_margin_item_1px_2026-11-27. An auto-width
inline-block shrinks to fit its content. Its width was predicted by the inline
text walk alone, which never enters a block child, so an inline-block holding a
row flex was laid out 1 px wide and the flex items shrank into that 1 px. A
block or column-flex child kept its own width and hid the gap.

Page: each case is a `.w` box (margin-left 40px) holding a
`display:inline-block; vertical-align:top` box; the blue run is measured on the
device row through CSS row `case * 30 + 10`, at k = 1 and k = 4.

| case | inline-block content | k=1 Chrome / base | k=4 Chrome / base |
|------|----------------------|-------------------|-------------------|
| 0 | row flex (inside a 205px .w); one 40px blue item, margin-left:10% | 44..79 / 40..40 | 176..319 / 160..163 |
| 1 | row flex; one 40px blue item | 40..79 / 40..40 | 160..319 / 160..163 |
| 2 | row flex; a 30px item, then a 40px blue item | 70..109 / 41..41 | 280..439 / 164..167 |
| 3 | padding-left:10px, border-left:4px; row flex; one 40px blue item | 54..93 / 54..54 | 216..375 / 216..219 |
| 4 | a 40px blue block (already right) | 40..79 / 40..79 | 160..319 / 160..319 |
| 5 | column flex; one 40px blue item (already right) | 40..79 / 40..79 | 160..319 / 160..319 |
| 6 | grid; one 40px blue item (already right) | 40..79 / 40..79 | 160..319 / 160..319 |
| 7 | after a 10px inline-block; row flex; one 40px blue item | 50..89 / 50..50 | 200..359 / 200..203 |
| 8 | blue float; row flex: a checkbox with margin 0 3px 0 4px (13px, border-box), then a 20px item | 40..79 / 40..59 | 160..319 / 160..239 |
| 9 | the same row flex in a blue inline-block | 40..79 / 40..40 | 160..319 / 160..163 |

The row-flex sum lives in `flex_item_max_content_width`, so it applies to every
caller: floats, table cells, flex and grid items as well as inline-blocks.
Case 8 pins that an input's horizontal margins are added once (the atomic-box
rule already adds them; a second add made it 7px too wide).
"""

"""
Traceability: web_inline_block_flex_percent_margin_item_1px_2026-11-27 — an auto-width inline-block holding a row flex container is as wide as the flex container's max-content.
"""
# @tag: unit, browser_engine, layout, inline-block, flex, chrome159
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_engine.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{
    simple_web_render_html_to_pixels_with_engine2d_backend
}
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}

val CSS_W: i32 = 400
val CSS_H: i32 = 300

val PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff}}.w{{margin-left:40px;width:200px;height:30px}}.ib{{display:inline-block;vertical-align:top}}</style></head><body><div class=\"w\" style=\"width:205px\"><div class=\"ib\"><div style=\"display:flex\"><div style=\"margin-left:10%;width:40px;height:20px;background:#00f\"></div></div></div></div><div class=\"w\"><div class=\"ib\"><div style=\"display:flex\"><div style=\"width:40px;height:20px;background:#00f\"></div></div></div></div><div class=\"w\"><div class=\"ib\"><div style=\"display:flex\"><div style=\"width:30px;height:20px\"></div><div style=\"width:40px;height:20px;background:#00f\"></div></div></div></div><div class=\"w\"><div class=\"ib\" style=\"padding-left:10px;border-left:4px solid #fff\"><div style=\"display:flex\"><div style=\"width:40px;height:20px;background:#00f\"></div></div></div></div><div class=\"w\"><div class=\"ib\"><div style=\"width:40px;height:20px;background:#00f\"></div></div></div><div class=\"w\"><div class=\"ib\"><div style=\"display:flex;flex-direction:column\"><div style=\"width:40px;height:20px;background:#00f\"></div></div></div></div><div class=\"w\"><div class=\"ib\"><div style=\"display:grid\"><div style=\"width:40px;height:20px;background:#00f\"></div></div></div></div><div class=\"w\"><span style=\"display:inline-block;width:10px;height:20px\"></span><div class=\"ib\"><div style=\"display:flex\"><div style=\"width:40px;height:20px;background:#00f\"></div></div></div></div><div class=\"w\"><div style=\"float:left;background:#00f\"><div style=\"display:flex\"><input type=\"checkbox\" style=\"margin:0 3px 0 4px;width:13px;height:13px;padding:0;border:0;box-sizing:border-box;opacity:0\"><div style=\"width:20px;height:20px\"></div></div></div></div><div class=\"w\"><div class=\"ib\" style=\"background:#00f\"><div style=\"display:flex\"><input type=\"checkbox\" style=\"margin:0 3px 0 4px;width:13px;height:13px;padding:0;border:0;box-sizing:border-box;opacity:0\"><div style=\"width:20px;height:20px\"></div></div></div></div></body></html>"

var g_px1: [u32] = []
var g_px4: [u32] = []

fn _px(k: i32) -> [u32]:
    if k == 1:
        if g_px1.len() == 0:
            g_px1 = simple_web_render_html_to_pixels_with_engine2d_backend(PAGE, CSS_W, CSS_H, "cpu_simd")
        return g_px1
    if g_px4.len() == 0:
        g_px4 = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, k, "cpu_simd")
    g_px4

# Blue runs " a..b" on the device row through CSS row `row * 30 + 10`.
fn _runs(k: i32, row: i32) -> text:
    val px = _px(k)
    val w = CSS_W * k
    val y = (row * 30 + 10) * k
    var out = ""
    var x = 0
    var inr = false
    var start = 0
    while x <= w:
        var blue = false
        if x < w:
            val v = px[y * w + x]
            val r = ((v >> 16u32) & 0xFFu32).to_i32()
            val b = (v & 0xFFu32).to_i32()
            blue = b > 128 and r < 128
        if blue and not inr:
            inr = true
            start = x
        if not blue and inr:
            inr = false
            out = out + " {start}..{x - 1}"
        x = x + 1
    out

fn _both(row: i32, r1: text, r4: text):
    expect(_runs(1, row)).to_equal(r1)
    expect(_runs(4, row)).to_equal(r4)

describe "An auto-width inline-block holding a row flex container (Chrome 159)":
    it "AC-1: the bug repro: a margin-left:10% item in a 205px line":
        _both(0, " 44..79", " 176..319")

    it "AC-2: one and two flex items set the inline-block's width":
        _both(1, " 40..79", " 160..319")
        _both(2, " 70..109", " 280..439")

    it "AC-3: the inline-block's own padding and border add to it":
        _both(3, " 54..93", " 216..375")

    it "AC-4: block, column flex and grid content stay as they were":
        _both(4, " 40..79", " 160..319")
        _both(5, " 40..79", " 160..319")
        _both(6, " 40..79", " 160..319")

    it "AC-5: after another inline-block on the line":
        _both(7, " 50..89", " 200..359")

    it "AC-6: a margined form control in a row flex counts its margins once (float and inline-block)":
        _both(8, " 40..79", " 160..319")
        _both(9, " 40..79", " 160..319")
