"""
## Purpose and audience
Purpose: Pin the exact Chrome value of one glyph pixel on the fifth wrapped
line of the famous-site corpus page. Expected to FAIL until the glyph
rasterizer's edge coverage matches Chrome's.
Audience: browser-engine text raster maintainers.

Chrome oracle (Chrome 159.0.8154.6, Linux, 160x120, device scale 1): pixel
(32,93) is 0xFF000000. Simple paints the line on the same rows (82-93, see
wrapped_line_advance_normal_line_height_spec.spl) but this pixel is
0xFF808080: the glyph edge is antialiased to half coverage where Chrome's is
full. Until 2026-11-14 the pixel was background, because wrapped lines
advanced 16px instead of 18px; that part is fixed.
"""
# @tag:in-development
# Tracks: doc/08_tracking/bug/web_wrapped_line_advance_16px_vs_chrome_18px_2026-11-14.md (residual "Exact pixel value")
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{simple_web_render_html_to_pixels}

describe "famous-site corpus fifth line exact pixel":
    it "matches Chrome at (32,93)":
        val html = "<html><body><div data-font-corpus=\"known-site-fonts\" style='width: 120px; height: 40px; background-color: #7c3aed; font-family: \"IBM Plex Sans\", Arial, sans-serif'>Twitch commerce deterministic compatibility fixture</div></body></html>"
        val pixels = simple_web_render_html_to_pixels(html, 160, 120)
        expect(pixels.len()).to_equal(160 * 120)
        expect(pixels[32 + 93 * 160]).to_equal(0xFF000000u32)
