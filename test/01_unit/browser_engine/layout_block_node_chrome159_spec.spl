        expect(w.children[1].y).to_equal(15.0)
        expect(w.children[2].y).to_equal(35.0)
        expect(w.height).to_equal(45.0)

    it "mc-empty-first: an empty first child's margins collapse through the parent top":
        # Chrome: ef W h=30 | ef_p y=20 h=10 | ef_e y=20 h=0 | ef_c y=20 h=10
