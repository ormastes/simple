        expect(w.children[1].height).to_equal(0.0)
        expect(w.children[1].children[0].y).to_equal(25.0)
        expect(w.children[2].y).to_equal(25.0)
        expect(w.height).to_equal(30.0)

    it "mc-height0-parent: an explicit height:0 blocks the bottom collapse":
        # Chrome: h0 W h=5 | h0_p y=0 h=0 | h0_c y=0 h=10 | h0_s y=0 h=5
