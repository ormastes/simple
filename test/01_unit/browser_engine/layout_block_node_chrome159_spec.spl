        val pb = w.children[0]
        expect(pb.y).to_equal(10.0)
        expect(pb.height).to_equal(10.0)
        expect(pb.children[0].y).to_equal(10.0)
        expect(pb.children[1].y).to_equal(10.0)
        expect(w.height).to_equal(20.0)

    it "mc-abs-first: a leading absolute box does not stop the top collapse":
        # Chrome: fa W h=20 | fa_p y=10 h=10 | fa_x y=10 h=5 | fa_c y=10 h=10
        var p = BeDomNode.element("div")
        p.add_child(_block(["position", "absolute", "width", "50px", "height", "5px"]))
        p.add_child(_block(["height", "10px", "margin-top", "10px"]))
        val w = _lay(_wrap(p))
        val pb = w.children[0]
