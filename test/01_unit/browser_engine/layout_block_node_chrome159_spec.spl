        expect(w.children[1].y).to_equal(34.0)
        expect(w.height).to_equal(39.0)

    it "mc-empty-padded: top padding stops an empty block self-collapsing (guard)":
        # Chrome: ept W h=51 | ept_a y=0 h=10 | ept_e y=20 h=1 | ept_b y=41 h=10
        var root = BeDomNode.element("div")
        root.add_child(_block(["height", "10px"]))
        root.add_child(_block(["padding-top", "1px", "margin-top", "10px", "margin-bottom", "20px"]))
        root.add_child(_block(["height", "10px"]))
