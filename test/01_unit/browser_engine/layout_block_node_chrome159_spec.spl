        expect(w.children[1].y).to_equal(20.0)
        expect(w.children[1].height).to_equal(1.0)
        expect(w.children[2].y).to_equal(41.0)
        expect(w.height).to_equal(51.0)

    it "mc-float-between: a float does not separate collapsing sibling margins":
        # Chrome: fl W h=40 | fl_a y=0 h=10 | fl_f y=27 h=5 | fl_b y=30 h=10
        var root = BeDomNode.element("div")
        root.add_child(_block(["height", "10px", "margin-bottom", "10px"]))
        root.add_child(_block(["float", "left", "width", "50px", "height", "5px", "margin-top", "7px"]))
        root.add_child(_block(["height", "10px", "margin-top", "20px"]))
        val w = _lay(root)
        expect(w.children[1].y).to_equal(27.0)
        expect(w.children[2].y).to_equal(30.0)
        expect(w.height).to_equal(40.0)

    it "mc-abs-between: an absolute box does not separate collapsing sibling margins":
        # Chrome: ab W h=40 | ab_a y=0 h=10 | ab_x y=20 h=5 | ab_b y=30 h=10
        # Chrome: abm W h=40 | abm_a y=0 h=10 | abm_x y=23 h=5 | abm_b y=30 h=10
        var root = BeDomNode.element("div")
        root.add_child(_block(["height", "10px", "margin-bottom", "10px"]))
        root.add_child(_block(["position", "absolute", "width", "50px", "height", "5px", "margin-top", "3px"]))
        root.add_child(_block(["height", "10px", "margin-top", "20px"]))
        val w = _lay(root)
        expect(w.children[1].y).to_equal(23.0)
        expect(w.children[2].y).to_equal(30.0)
        expect(w.height).to_equal(40.0)

    it "mc-float-first: a leading float does not stop the top collapse":
        # Chrome: ff W h=20 | ff_p y=10 h=10 | ff_f y=10 h=5 | ff_c y=10 h=10
        var p = BeDomNode.element("div")
        p.add_child(_block(["float", "left", "width", "50px", "height", "5px"]))
        p.add_child(_block(["height", "10px", "margin-top", "10px"]))
