        expect(pb.height).to_equal(10.0)
        expect(pb.children[0].y).to_equal(10.0)
        expect(pb.children[1].y).to_equal(10.0)
        expect(w.height).to_equal(20.0)

    it "mc-whitespace: whitespace-only text does not block parent/child collapse":
        # Chrome: ws W h=35 | ws_p y=10 h=10 | ws_c y=10 h=10 | ws_s y=30 h=5
        var p = BeDomNode.element("div")
        p.add_child(BeDomNode.text("\n   "))
        p.add_child(_block(["height", "10px", "margin-top", "10px", "margin-bottom", "10px"]))
        p.add_child(BeDomNode.text("\n   "))
        var root = _wrap(p)
        root.add_child(_block(["height", "5px"]))
        val w = _lay(root)
        expect(w.children[0].y).to_equal(10.0)
        expect(w.children[0].height).to_equal(10.0)
        expect(w.children[1].y).to_equal(30.0)
        expect(w.height).to_equal(35.0)

    it "mc-grid-items: grid items never collapse their margins with each other":
        # Chrome: gr W h=40 | gr_p y=0 h=40 | gr_a y=0 h=10 | gr_b y=30 h=10
        var p = _block(["display", "grid"])
        p.add_child(_block(["height", "10px", "margin-bottom", "10px"]))
        p.add_child(_block(["height", "10px", "margin-top", "10px"]))
        val w = _lay(_wrap(p))
        expect(w.children[0].height).to_equal(40.0)
        expect(w.children[0].children[1].y).to_equal(30.0)

    it "mc-flex-column-items: flex column items never collapse (guard)":
        # Chrome: fc W h=40 | fc_p y=0 h=40 | fc_a y=0 h=10 | fc_b y=30 h=10
        var p = _block(["display", "flex", "flex-direction", "column"])
        p.add_child(_block(["height", "10px", "margin-bottom", "10px"]))
        p.add_child(_block(["height", "10px", "margin-top", "10px"]))
        val w = _lay(_wrap(p))
        expect(w.children[0].height).to_equal(40.0)
        expect(w.children[0].children[1].y).to_equal(30.0)

# Per-side borders. Chrome for Testing 159.0.8154.6, `--headless --no-sandbox
# --window-size=900,2000 --dump-dom`, 2026-11-17: each case sits in a
# `<div style="display:flow-root;width:300px">` wrapper W (mirrored by
# `_wrap300`), `html,body{margin:0}`, `div{margin:0}`; geometry is
# `getBoundingClientRect()` relative to W. Every value below is quoted on its row.
fn _wrap300(kids: [BeDomNode]) -> BeDomNode:
    var w = BeDomNode.element("div")
    w.set_style("width", "300px")
    for k in kids:
        w.add_child(k)
    w

fn _bordered(border_pairs: [text]) -> BeDomNode:
    """P with the given declarations around one `height:10px` child."""
    var p = _block(border_pairs)
    p.add_child(_block(["height", "10px"]))
    p

fn _collapser() -> BeDomNode:
    _block(["height", "10px", "margin-top", "10px", "margin-bottom", "10px"])

describe "layout_tree per-side borders (Chrome 159)":
    it "bw-bottom: a bottom border keeps the last child's bottom margin inside P only":
        # Chrome: bb_p y=10 h=25 | bb_c y=10 h=10 | bb_s y=35 | W h=40
        var p = _block(["border-bottom", "5px solid"])
        p.add_child(_collapser())
        val w = _lay(_wrap300([p, _block(["height", "5px"])]))
        expect(w.children[0].y).to_equal(10.0)
        expect(w.children[0].height).to_equal(25.0)
        expect(w.children[0].children[0].y).to_equal(10.0)
        expect(w.children[1].y).to_equal(35.0)
        expect(w.height).to_equal(40.0)

    it "bw-top: a top border keeps the first child's top margin inside P only":
        # Chrome: bt_p y=0 h=25 | bt_c y=15 h=10 | bt_s y=35 | W h=40
        var p = _block(["border-top", "5px solid"])
        p.add_child(_collapser())
        val w = _lay(_wrap300([p, _block(["height", "5px"])]))
        expect(w.children[0].y).to_equal(0.0)
        expect(w.children[0].height).to_equal(25.0)
        expect(w.children[0].children[0].y).to_equal(15.0)
        expect(w.children[1].y).to_equal(35.0)
        expect(w.height).to_equal(40.0)

    it "bw-4value: border-width with four values insets each side separately":
        # Chrome: w4_p (width:100px;border-style:solid;border-width:1px 2px 3px 4px) x=0 y=0 w=106 h=14 | w4_c x=4 y=1 w=100 h=10
        val w = _lay(_wrap300([_bordered(["width", "100px", "border-style", "solid", "border-width", "1px 2px 3px 4px"])]))
        val p = w.children[0]
        expect(p.width).to_equal(106.0)
        expect(p.height).to_equal(14.0)
        expect(p.children[0].x).to_equal(4.0)
        expect(p.children[0].y).to_equal(1.0)
        expect(p.children[0].width).to_equal(100.0)

    it "bw-left-right: side borders move x and width but do not block vertical collapse":
        # Chrome: lr_p (width:100px;border-left:7px solid;border-right:3px solid) y=10 w=110 h=10 | lr_c x=7 y=10 w=100 | lr_s y=30
        var p = _block(["width", "100px", "border-left", "7px solid", "border-right", "3px solid"])
        p.add_child(_collapser())
        val w = _lay(_wrap300([p, _block(["height", "5px"])]))
        expect(w.children[0].y).to_equal(10.0)
        expect(w.children[0].width).to_equal(110.0)
        expect(w.children[0].height).to_equal(10.0)
        expect(w.children[0].children[0].x).to_equal(7.0)
        expect(w.children[0].children[0].width).to_equal(100.0)
        expect(w.children[1].y).to_equal(30.0)

    it "bw-left-right-auto: an auto-width box narrows its content by left + right borders":
        # Chrome: lra_p w=300 h=10 | lra_c x=7 y=0 w=290
        val w = _lay(_wrap300([_bordered(["border-left", "7px solid", "border-right", "3px solid"])]))
        expect(w.children[0].width).to_equal(300.0)
        expect(w.children[0].children[0].x).to_equal(7.0)
        expect(w.children[0].children[0].width).to_equal(290.0)

    it "bw-border-box: border-box sizing carves per-side borders out of width and height":
        # Chrome: bx_p (box-sizing:border-box;width:100px;height:40px;padding:2px;border-top:5px solid;border-left:6px solid) w=100 h=40 | bx_c x=8 y=7 w=90
        val w = _lay(_wrap300([_bordered(["box-sizing", "border-box", "width", "100px", "height", "40px", "padding", "2px", "border-top", "5px solid", "border-left", "6px solid"])]))
        val p = w.children[0]
        expect(p.width).to_equal(100.0)
        expect(p.height).to_equal(40.0)
        expect(p.children[0].x).to_equal(8.0)
        expect(p.children[0].y).to_equal(7.0)
        expect(p.children[0].width).to_equal(90.0)

    it "bw-border-box-bottom-right: bottom/right borders leave the content origin alone":
        # Chrome: bxb_p (box-sizing:border-box;width:100px;height:40px;border-bottom:9px solid;border-right:4px solid) w=100 h=40 | bxb_c x=0 y=0 w=96
        val w = _lay(_wrap300([_bordered(["box-sizing", "border-box", "width", "100px", "height", "40px", "border-bottom", "9px solid", "border-right", "4px solid"])]))
        val p = w.children[0]
        expect(p.width).to_equal(100.0)
        expect(p.height).to_equal(40.0)
        expect(p.children[0].x).to_equal(0.0)
        expect(p.children[0].y).to_equal(0.0)
        expect(p.children[0].width).to_equal(96.0)

    it "bw-content-box: content-box sizing adds each side's border to width and height":
        # Chrome: cb_p (width:100px;height:40px;border-top:5px solid;border-bottom:2px solid;border-left:6px solid) w=106 h=47 | cb_c x=6 y=5 w=100
        val w = _lay(_wrap300([_bordered(["width", "100px", "height", "40px", "border-top", "5px solid", "border-bottom", "2px solid", "border-left", "6px solid"])]))
        val p = w.children[0]
        expect(p.width).to_equal(106.0)
        expect(p.height).to_equal(47.0)
        expect(p.children[0].x).to_equal(6.0)
        expect(p.children[0].y).to_equal(5.0)
        expect(p.children[0].width).to_equal(100.0)

    it "bw-no-style: border-width alone (initial style none) has zero width and does not block collapse":
        # Chrome: nw_p (border-width:5px) y=10 h=10 | nw_c x=0 y=10 w=300 | nw_s y=30
        var p = _block(["border-width", "5px"])
        p.add_child(_collapser())
        val w = _lay(_wrap300([p, _block(["height", "5px"])]))
        expect(w.children[0].y).to_equal(10.0)
        expect(w.children[0].height).to_equal(10.0)
        expect(w.children[0].children[0].x).to_equal(0.0)
        expect(w.children[0].children[0].width).to_equal(300.0)
        expect(w.children[1].y).to_equal(30.0)

    it "bw-style-only: border-style alone uses the initial medium (3px) width":
        # Chrome: sn_p (border-style:solid) h=16 | sn_c x=3 y=3 w=294
        val w = _lay(_wrap300([_bordered(["border-style", "solid"])]))
        expect(w.children[0].height).to_equal(16.0)
        expect(w.children[0].children[0].x).to_equal(3.0)
        expect(w.children[0].children[0].y).to_equal(3.0)
        expect(w.children[0].children[0].width).to_equal(294.0)

    it "bw-order: border-width and border-style resolve the same in either order":
        # Chrome: ws_p (border-width:5px;border-style:solid) h=20, ws_c x=5 y=5 w=290 | sw_p (border-style:solid;border-width:5px) h=20, sw_c x=5 y=5 w=290
        val a = _lay(_wrap300([_bordered(["border-width", "5px", "border-style", "solid"])]))
        val b = _lay(_wrap300([_bordered(["border-style", "solid", "border-width", "5px"])]))
        expect(a.children[0].height).to_equal(20.0)
        expect(a.children[0].children[0].x).to_equal(5.0)
        expect(a.children[0].children[0].width).to_equal(290.0)
        expect(b.children[0].height).to_equal(20.0)
        expect(b.children[0].children[0].x).to_equal(5.0)
        expect(b.children[0].children[0].width).to_equal(290.0)

    it "bw-shorthand-no-width: border shorthand without a width uses medium (3px)":
        # Chrome: sc_p (border:solid red) h=16 | sc_c x=3 y=3 w=294
        val w = _lay(_wrap300([_bordered(["border", "solid red"])]))
        expect(w.children[0].height).to_equal(16.0)
        expect(w.children[0].children[0].x).to_equal(3.0)
        expect(w.children[0].children[0].width).to_equal(294.0)

    it "bw-shorthand-resets-style: border shorthand without a style resets it to none":
        # Chrome: sr_p (border-style:solid;border:5px) h=10 | sr_c x=0 y=0 w=300
        val w = _lay(_wrap300([_bordered(["border-style", "solid", "border", "5px"])]))
        expect(w.children[0].height).to_equal(10.0)
        expect(w.children[0].children[0].x).to_equal(0.0)
        expect(w.children[0].children[0].width).to_equal(300.0)

    it "bw-side-style-none: border-top-style:none zeroes only the top border":
        # Chrome: tn_p (border:5px solid;border-top-style:none) h=15 | tn_c x=5 y=0 w=290
        val w = _lay(_wrap300([_bordered(["border", "5px solid", "border-top-style", "none"])]))
        expect(w.children[0].height).to_equal(15.0)
        expect(w.children[0].children[0].x).to_equal(5.0)
        expect(w.children[0].children[0].y).to_equal(0.0)
        expect(w.children[0].children[0].width).to_equal(290.0)

    it "bw-side-width: border-bottom-width overrides one side of the border shorthand":
        # Chrome: bbw_p (border:2px solid;border-bottom-width:8px) h=20 | bbw_c x=2 y=2 w=296
        val w = _lay(_wrap300([_bordered(["border", "2px solid", "border-bottom-width", "8px"])]))
        expect(w.children[0].height).to_equal(20.0)
        expect(w.children[0].children[0].x).to_equal(2.0)
        expect(w.children[0].children[0].y).to_equal(2.0)
        expect(w.children[0].children[0].width).to_equal(296.0)

    it "bw-style-2value: border-style with two values gives top/bottom and left/right":
        # Chrome: s2_p (width:100px;border-width:4px;border-style:solid none) w=100 h=18 | s2_c x=0 y=4 w=100
        val w = _lay(_wrap300([_bordered(["width", "100px", "border-width", "4px", "border-style", "solid none"])]))
        expect(w.children[0].width).to_equal(100.0)
        expect(w.children[0].height).to_equal(18.0)
        expect(w.children[0].children[0].x).to_equal(0.0)
        expect(w.children[0].children[0].y).to_equal(4.0)

    it "bw-hidden: border style hidden has zero width":
        # Chrome: hd_p (border:5px hidden) h=10 | hd_c x=0 y=0 w=300
        val w = _lay(_wrap300([_bordered(["border", "5px hidden"])]))
        expect(w.children[0].height).to_equal(10.0)
        expect(w.children[0].children[0].x).to_equal(0.0)

    it "bw-empty-left: an empty block with only a left border still self-collapses":
        # Chrome: el_a y=0 h=10 | el_e (border-left:5px solid;mt10;mb10) y=20 h=0 | el_b y=20 | W h=30
        val e = _block(["border-left", "5px solid", "margin-top", "10px", "margin-bottom", "10px"])
        val w = _lay(_wrap300([_block(["height", "10px", "margin-bottom", "10px"]), e, _block(["height", "10px", "margin-top", "10px"])]))
        expect(w.children[1].height).to_equal(0.0)
        expect(w.children[2].y).to_equal(20.0)
        expect(w.height).to_equal(30.0)

    it "bw-empty-top: an empty block with a top border does not self-collapse":
        # Chrome: et_a y=0 h=10 | et_e (border-top:5px solid;mt10;mb10) y=20 h=5 | et_b y=35 | W h=45
        val e = _block(["border-top", "5px solid", "margin-top", "10px", "margin-bottom", "10px"])
        val w = _lay(_wrap300([_block(["height", "10px", "margin-bottom", "10px"]), e, _block(["height", "10px", "margin-top", "10px"])]))
        expect(w.children[1].y).to_equal(20.0)
        expect(w.children[1].height).to_equal(5.0)
        expect(w.children[2].y).to_equal(35.0)
        expect(w.height).to_equal(45.0)

    it "bw-empty-bottom: an empty block with a bottom border does not self-collapse":
        # Chrome: eb_a y=0 h=10 | eb_e (border-bottom:5px solid;mt10;mb10) y=20 h=5 | eb_b y=35 | W h=45
        val e = _block(["border-bottom", "5px solid", "margin-top", "10px", "margin-bottom", "10px"])
        val w = _lay(_wrap300([_block(["height", "10px", "margin-bottom", "10px"]), e, _block(["height", "10px", "margin-top", "10px"])]))
        expect(w.children[1].y).to_equal(20.0)
        expect(w.children[1].height).to_equal(5.0)
        expect(w.children[2].y).to_equal(35.0)
        expect(w.height).to_equal(45.0)
