        expect(w.children[1].y).to_equal(30.0)
        expect(w.height).to_equal(35.0)

    it "mc-min-height-top: min-height does not block the top collapse":
        # Chrome: mht W h=40 | mht_p y=10 h=30 | mht_c y=10 h=10
        var p = _block(["min-height", "30px"])
