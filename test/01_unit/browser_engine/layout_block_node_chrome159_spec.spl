        expect(w.children[0].children[1].y).to_equal(40.0)
        expect(w.children[1].y).to_equal(40.0)
        expect(w.height).to_equal(45.0)

    it "mc-empty-nested: a parent holding only an empty block collapses through as a whole":
        # Chrome: ep W h=30 | ep_a y=0 h=10 | ep_p y=25 h=0 | ep_e y=25 h=0 | ep_s y=25 h=5
        var root = BeDomNode.element("div")
