"""
## Purpose and audience
Purpose: Pin the HTML UA-stylesheet rule that shrinks an `<h1>` nested in
sectioning content -- `:is(article, aside, nav, section) h1 { font-size:
1.5em; margin-block: 0.83em }` and its deeper levels in Chrome's `html.css`.
Without it every `<section><h1>` is drawn at 32 px instead of 24 px and the
block flow below drifts (web catalog `overview`: +10 px per line, h1 visibly
larger than Chromium 131's).
Audience: browser-engine layout maintainers.

Chrome oracle (Chromium 131 headless --headless=new, `--dump-dom` of
getBoundingClientRect / getComputedStyle, page
`*{box-sizing:border-box}body{margin:0;font:16px/1.5 sans-serif}`):

| fixture                                   | font-size | margin-top | h     |
|-------------------------------------------|-----------|------------|-------|
| `<div><h1>` (control, no sectioning)      | 32px      | 21.44px    | 48    |
| `<section><h1>`                           | 24px      | 19.92px    | 36    |
| `<article><section><h1>`                  | 18.72px   | 18.72px    | 28.08 |
| `<section><h2>` (control, rule is h1-only)| 24px      | 19.92px    | 36    |
"""

"""
Traceability: REQ-BROWSER-ENGINE-UA-SECTIONING-H1-001 — an h1 inside sectioning content takes the UA's reduced size and margins.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_core.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_layout_by_id
}

val VW: i32 = 900
val VH: i32 = 2000
val HEAD: text = "<html><head><style>*{box-sizing:border-box}body{margin:0;font:16px/1.5 sans-serif}</style></head><body>"

fn probe(inner: text, id: text, name: text) -> text:
    simple_web_layout_debug_layout_by_id(
        HEAD + inner + "</body></html>", VW, VH, id, name)

describe "an h1 inside sectioning content uses the UA's reduced size":
    it "AC-1: control — an h1 outside sectioning content keeps 2em (48 px line box)":
        step("Chrome: <div><h1> is 32px, one 48 px line box")
        expect(probe("<div><h1 id=\"a\">x</h1></div>", "a", "h")).to_equal("48")

    it "AC-2: <section><h1> is 1.5em — a 36 px line box":
        step("Chrome: font-size 24px, h 36")
        expect(probe("<section><h1 id=\"b\">x</h1></section>", "b", "h")).to_equal("36")

    it "AC-3: its block margin is 0.83em of the h1's own size (19.92 -> 20 px)":
        step("Chrome: the h1's 19.92 px top margin collapses through the section, so the h1 starts at y=19.92")
        expect(probe("<section><h1 id=\"b\">x</h1></section>", "b", "y")).to_equal("20")

    it "AC-4: two sectioning levels give 1.17em":
        step("Chrome: <article><section><h1> is 18.72px, h 28.08")
        expect(probe("<article><section><h1 id=\"c\">x</h1></section></article>", "c", "h")).to_equal("28")

    it "AC-5: control — the rule is h1-only, <section><h2> is unchanged":
        step("Chrome: <section><h2> stays 24px, h 36")
        expect(probe("<section><h2 id=\"d\">x</h2></section>", "d", "h")).to_equal("36")
