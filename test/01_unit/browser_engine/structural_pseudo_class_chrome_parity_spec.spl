        it "text and pre-parsed paths agree on the whole second table":
            expect(simple_web_layout_debug_selector_parse_equivalence(_fixture2("#fx tr:nth-child(odd) td {{ width:50px }} #fx tr:nth-of-type(odd) td {{ width:50px }} #fx tr:nth-child(2) > td {{ width:50px }} #fx tr:nth-last-child(1) td {{ width:50px }} #fx tr:nth-last-of-type(2) td {{ width:50px }} #fx li:nth-of-type(2) > a {{ width:50px }} #fx li:nth-of-type(2) a {{ width:50px }} #fx li:first-child a {{ width:50px }} #fx li:last-child > a {{ width:50px }} #fx li:only-child a {{ width:50px }} #fx ul > li:nth-child(n+2) a {{ width:50px }} #fx p:nth-last-child(1) + div {{ width:50px }} #fx p:nth-last-child(2) + div {{ width:50px }} #fx p:nth-child(1) ~ div {{ width:50px }} #fx p:nth-child(1) + div {{ width:50px }} #fx #box > :not(:nth-child(2)) {{ width:50px }} #fx #box > i:not(:nth-of-type(odd)) {{ width:50px }} #fx #box > :not(:first-child) {{ width:50px }} #fx #box > :not(:nth-last-child(1)) {{ width:50px }} #fx section:nth-of-type(2) > div:nth-child(2) {{ width:50px }} #fx tr:nth-child(odd) td:nth-child(2) {{ width:50px }}"), 0 - 1).starts_with("ok ")).to_equal(true)

    context "sibling combinators":

        it "h2 + p -> p1":
            expect(_matched3("h2 + p")).to_equal("p1,")

        it "h2 + p > a -> a1":
            expect(_matched3("h2 + p > a")).to_equal("a1,")

        it "h2 ~ p -> p1 p2":
            expect(_matched3("h2 ~ p")).to_equal("p1,p2,")

        it "h2 ~ p a -> a1 a2":
            expect(_matched3("h2 ~ p a")).to_equal("a1,a2,")

        it "p + p -> p2":
            expect(_matched3("p + p")).to_equal("p2,")

