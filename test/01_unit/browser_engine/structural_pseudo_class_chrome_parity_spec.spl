# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-BROWSER_ENGINE
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_core_selectors.spl 1%
# @tag: unit, browser_engine, css, selectors
#
# Structural pseudo-classes in the LAYOUT renderer's selector matcher, checked
# against Chrome 159.0.8154.6. Page: `#box` with six children
# `p#c1 span#c2 p#c3 p#c4 span#c5 p#c6`, base rule
# `#box > * {display:block; width:200px}` and one probe rule
# `#box > SELECTOR {width:50px}`. Chrome's matched set is the ids whose
# getComputedStyle(el).width is "50px" (harvested with the headless shell,
# --dump-dom); every row below is that set, and the spec reads the same
# cascaded width back from the Simple renderer.
#
# | selector | Chrome 159 matches |
# |---|---|
# | `:nth-child(2n+1)` | c1 c3 c5 |
# | `:nth-child(ODD)` | c1 c3 c5 |
# | `:nth-child(even)` | c2 c4 c6 |
# | `:nth-child(3)` | c3 |
# | `:nth-child(n+4)` | c4 c5 c6 |
# | `:nth-child(-2n+5)` | c1 c3 c5 |
# | `:nth-child(0n+2)` | c2 |
# | `:nth-child(2n)` | c2 c4 c6 |
# | `:nth-child( 2n + 1 )` | c1 c3 c5 |
# | `:nth-child(+3)` | c3 |
# | `:nth-child(-n+0)` | (none) |
# | `:nth-child(1 2)` | (none) |
# | `:nth-child(2n+)` | (none) |
# | `:nth-child(\t2n\n+ 1)` | c1 c3 c5 |
# | `:nth-child(n)` | c1 c2 c3 c4 c5 c6 |
# | `:nth-child(-n)` | (none) |
# | `:nth-child(3n-1)` | c2 c5 |
# | `:nth-child(2N+1)` | c1 c3 c5 |
# | `p:nth-child(2)` | (none) |
# | `p:nth-child(3)` | c3 |
# | `span:nth-child(2)` | c2 |
# | `:nth-last-child(1)` | c6 |
# | `:nth-last-child(-n+2)` | c5 c6 |
# | `:nth-last-child(odd)` | c2 c4 c6 |
# | `:nth-last-child(2n)` | c1 c3 c5 |
# | `p:nth-last-child(2)` | (none) |
# | `p:nth-of-type(2)` | c3 |
# | `span:nth-of-type(1)` | c2 |
# | `p:nth-of-type(odd)` | c1 c4 |
# | `:nth-of-type(-n+1)` | c1 c2 |
# | `:nth-of-type(2)` | c3 c5 |
# | `p:nth-last-of-type(1)` | c6 |
# | `span:nth-last-of-type(2)` | c2 |
# | `p:nth-last-of-type(-n+2)` | c4 c6 |
# | `:nth-last-of-type(1)` | c5 c6 |

use std.spec.{describe, context, it, expect}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_core.{
    simple_web_layout_debug_style_by_id, simple_web_layout_debug_selector_parse_equivalence
}

fn _matched(selector: text) -> text:
    val html = "<html><head><style>#box > * {{ display:block; width:200px; height:4px }} #box > " + selector + " {{ width:50px }}</style></head><body><div id=\"box\"><p id=\"c1\"></p><span id=\"c2\"></span><p id=\"c3\"></p><p id=\"c4\"></p><span id=\"c5\"></span><p id=\"c6\"></p></div></body></html>"
    var out = ""
    for id in ["c1", "c2", "c3", "c4", "c5", "c6"]:
        if simple_web_layout_debug_style_by_id(html, id, "width") == "50":
            out = out + id + ","
    out


# Second fixture (ancestor position, combinators, :not), same method: base
# `#fx * {display:block; width:200px}`, probe `#fx SELECTOR {width:50px}`,
# Chrome 159.0.8154.6 matched ids among a1 a2 b1 c1 (table cells in rows
# r1 r2 r3), x1 x2 x2b x3 (anchors in li l1 l2 l3; x2b is nested in a span),
# q1 q2 (section s: p, div), w1 w2 w3 (section s2: p, div, div), n1 n2 n3.
#
# | selector | Chrome 159 matches |
# |---|---|
# | `tr:nth-child(odd) td` | a1 a2 c1 |
# | `tr:nth-of-type(odd) td` | a1 a2 c1 |
# | `tr:nth-child(2) > td` | b1 |
# | `tr:nth-last-child(1) td` | c1 |
# | `tr:nth-last-of-type(2) td` | b1 |
# | `li:nth-of-type(2) > a` | x2 |
# | `li:nth-of-type(2) a` | x2 x2b |
# | `li:first-child a` | x1 |
# | `li:last-child > a` | x3 |
# | `li:only-child a` | (none) |
# | `ul > li:nth-child(n+2) a` | x2 x2b x3 |
# | `p:nth-last-child(1) + div` | (none) |
# | `p:nth-last-child(2) + div` | q2 |
# | `p:nth-child(1) ~ div` | q2 w2 w3 |
# | `p:nth-child(1) + div` | q2 w2 |
# | `#box > :not(:nth-child(2))` | n1 n3 |
# | `#box > i:not(:nth-of-type(odd))` | n2 |
# | `#box > :not(:first-child)` | n2 n3 |
# | `#box > :not(:nth-last-child(1))` | n1 n2 |
# | `section:nth-of-type(2) > div:nth-child(2)` | w2 |
# | `tr:nth-child(odd) td:nth-child(2)` | a2 |

fn _fixture2(css: text) -> text:
    "<html><head><style>#fx * {{ display:block; width:200px; height:2px }} " + css + "</style></head><body><div id=\"fx\"><table id=\"t\"><tbody id=\"tb\"><tr id=\"r1\"><td id=\"a1\"></td><td id=\"a2\"></td></tr><tr id=\"r2\"><td id=\"b1\"></td></tr><tr id=\"r3\"><td id=\"c1\"></td></tr></tbody></table><ul id=\"u\"><li id=\"l1\"><a id=\"x1\"></a></li><li id=\"l2\"><a id=\"x2\"></a><span id=\"sp\"><a id=\"x2b\"></a></span></li><li id=\"l3\"><a id=\"x3\"></a></li></ul><section id=\"s\"><p id=\"q1\"></p><div id=\"q2\"></div></section><section id=\"s2\"><p id=\"w1\"></p><div id=\"w2\"></div><div id=\"w3\"></div></section><div id=\"box\"><i id=\"n1\"></i><i id=\"n2\"></i><i id=\"n3\"></i></div></div></body></html>"

fn _matched2(selector: text) -> text:
    val html = _fixture2("#fx " + selector + " {{ width:50px }}")
    var out = ""
    for id in ["a1", "a2", "b1", "c1", "x1", "x2", "x2b", "x3", "q1", "q2", "w1", "w2", "w3", "n1", "n2", "n3"]:
        if simple_web_layout_debug_style_by_id(html, id, "width") == "50":
            out = out + id + ","
    out


# Third fixture (sibling combinators, :has(), backtracking, :not/:is lists),
# same method, Chrome 159.0.8154.6. Markup:
#   section#s1: h2#h1, p#p1>a#a1, p#p2>a#a2, div#d1
#   ul#u1: li#l1 li#l2 li#l3          form#f: input#i1[checked] label#lb1 input#i2 label#lb2
#   ul#one: li#o1                     ul#two: li#t1, li#t2>img#im
#   ul#nest: li#n1, li#n2>ol#no>(li#m1, li#m2>a#x)
#   div#cards: div.card#c1>(img#ci1, span#cs1), div.card#c2>span#cs2
#   div#box: i#b1.a i#b2 i#b3.k
#
# | selector | Chrome 159 matches |
# |---|---|
# | `h2 + p` | p1 |
# | `h2 + p > a` | a1 |
# | `h2 ~ p` | p1 p2 |
# | `h2 ~ p a` | a1 a2 |
# | `p + p` | p2 |
# | `p ~ div` | d1 |
# | `h2 + div` | (none) |
# | `li ~ li:last-child` | l3 t2 n2 m2 |
# | `li + li` | l2 l3 t2 n2 m2 |
# | `li:first-child + li` | l2 t2 n2 m2 |
# | `li:first-child ~ li` | l2 l3 t2 n2 m2 |
# | `:checked + label` | lb1 |
# | `input + label` | lb1 lb2 |
# | `input:not(:checked) + label` | lb2 |
# | `h2+p` | p1 |
# | `h2~p>a` | a1 a2 |
# | `li + li + li` | l3 |
# | `section > h2 + p` | p1 |
# | `p + p > a` | a2 |
# | `li:nth-child(2) ~ li` | l3 |
# | `h2 + p + p` | p2 |
# | `h2 ~ div` | d1 |
# | `ul + form` | f |
# | `ul ~ ul > li:first-child` | o1 t1 n1 |
# | `ul:has(li:not(:first-child))` | u1 two nest |
# | `ul:has(> li > img)` | two |
# | `div:not(:has(img))` | d1 c2 box |
# | `.card:has(img) span` | cs1 |
# | `ul:has(li:nth-child(3))` | u1 |
# | `li:has(a)` | n2 m2 |
# | `ul:has(li + li)` | u1 two nest |
# | `:has(> img)` | t2 c1 |
# | `li:has(+ li)` | l1 l2 t1 n1 m1 |
# | `ul:has(li:last-child:not(:first-child))` | u1 two nest |
# | `div:has(span):not(:has(img))` | c2 |
# | `ul:has(ol)` | nest |
# | `ul:has(> ol)` | (none) |
# | `ul > li:nth-child(2) a` | x |
# | `ul > li a` | x |
# | `ul li > a` | x |
# | `ul > li > a` | (none) |
# | `ul > li:nth-child(2) > ol > li a` | x |
# | `ul li:first-child + li a` | x |
# | `#box > :not(.a, :nth-child(2))` | b3 |
# | `#box > :is(.a, :nth-child(2))` | b1 b2 |
# | `#box > :is(:nth-child(1), :nth-child(3))` | b1 b3 |
# | `#box > :not(:is(.a, .k))` | b2 |
# | `li:not(:first-child) a` | x |
# | `ul:not(#nest) > li` | l1 l2 l3 o1 t1 t2 |
# | `ul > li:first-child` | l1 o1 t1 n1 |
# | `ol > li:last-child a` | x |
# | `li li:nth-child(2) > a` | x |
# | `ul ul li` | (none) |
# | `li:nth-child(2) li:nth-child(1)` | m1 |

fn _fixture3(css: text) -> text:
    "<html><head><style>#fx * {{ display:block; width:200px; height:2px }} " + css + "</style></head><body><div id=\"fx\"><section id=\"s1\"><h2 id=\"h1\"></h2><p id=\"p1\"><a id=\"a1\"></a></p><p id=\"p2\"><a id=\"a2\"></a></p><div id=\"d1\"></div></section><ul id=\"u1\"><li id=\"l1\"></li><li id=\"l2\"></li><li id=\"l3\"></li></ul><form id=\"f\"><input id=\"i1\" type=\"checkbox\" checked><label id=\"lb1\"></label><input id=\"i2\" type=\"checkbox\"><label id=\"lb2\"></label></form><ul id=\"one\"><li id=\"o1\"></li></ul><ul id=\"two\"><li id=\"t1\"></li><li id=\"t2\"><img id=\"im\"></li></ul><ul id=\"nest\"><li id=\"n1\"></li><li id=\"n2\"><ol id=\"no\"><li id=\"m1\"></li><li id=\"m2\"><a id=\"x\"></a></li></ol></li></ul><div id=\"cards\"><div class=\"card\" id=\"c1\"><img id=\"ci1\"><span id=\"cs1\"></span></div><div class=\"card\" id=\"c2\"><span id=\"cs2\"></span></div></div><div id=\"box\"><i id=\"b1\" class=\"a\"></i><i id=\"b2\"></i><i id=\"b3\" class=\"k\"></i></div></div></body></html>"

fn _matched3(selector: text) -> text:
    val html = _fixture3("#fx " + selector + " {{ width:50px }}")
    var out = ""
    for id in ["h1", "p1", "p2", "a1", "a2", "d1", "u1", "l1", "l2", "l3", "lb1", "lb2", "i1", "i2", "one", "o1", "two", "t1", "t2", "im", "nest", "n1", "n2", "no", "m1", "m2", "x", "cards", "c1", "c2", "ci1", "cs1", "cs2", "box", "b1", "b2", "b3", "s1", "f"]:
        if simple_web_layout_debug_style_by_id(html, id, "width") == "50":
            out = out + id + ","
    out

describe "Layout renderer structural pseudo-classes vs Chrome 159":

    it "applies the base rule when the probe matches nothing":
        expect(simple_web_layout_debug_style_by_id("<html><head><style>#box > * {{ display:block; width:200px }}</style></head><body><div id=\"box\"><p id=\"c1\"></p></div></body></html>", "c1", "width")).to_equal("200")

    context ":nth-child":

        it ":nth-child(2n+1) -> c1 c3 c5":
            expect(_matched(":nth-child(2n+1)")).to_equal("c1,c3,c5,")

        it ":nth-child(ODD) -> c1 c3 c5":
            expect(_matched(":nth-child(ODD)")).to_equal("c1,c3,c5,")

        it ":nth-child(even) -> c2 c4 c6":
            expect(_matched(":nth-child(even)")).to_equal("c2,c4,c6,")

        it ":nth-child(3) -> c3":
            expect(_matched(":nth-child(3)")).to_equal("c3,")

        it ":nth-child(n+4) -> c4 c5 c6":
            expect(_matched(":nth-child(n+4)")).to_equal("c4,c5,c6,")

        it ":nth-child(-2n+5) -> c1 c3 c5":
            expect(_matched(":nth-child(-2n+5)")).to_equal("c1,c3,c5,")

        it ":nth-child(0n+2) -> c2":
            expect(_matched(":nth-child(0n+2)")).to_equal("c2,")

        it ":nth-child(2n) -> c2 c4 c6":
            expect(_matched(":nth-child(2n)")).to_equal("c2,c4,c6,")

        it ":nth-child( 2n + 1 ) -> c1 c3 c5":
            expect(_matched(":nth-child( 2n + 1 )")).to_equal("c1,c3,c5,")

        it ":nth-child(+3) -> c3":
            expect(_matched(":nth-child(+3)")).to_equal("c3,")

        it ":nth-child(-n+0) -> none":
            expect(_matched(":nth-child(-n+0)")).to_equal("")

        it ":nth-child(1 2) -> none":
            expect(_matched(":nth-child(1 2)")).to_equal("")

        it ":nth-child(2n+) -> none":
            expect(_matched(":nth-child(2n+)")).to_equal("")

        it ":nth-child(\t2n\n+ 1) -> c1 c3 c5":
            expect(_matched(":nth-child(\t2n\n+ 1)")).to_equal("c1,c3,c5,")

        it ":nth-child(n) -> c1 c2 c3 c4 c5 c6":
            expect(_matched(":nth-child(n)")).to_equal("c1,c2,c3,c4,c5,c6,")

        it ":nth-child(-n) -> none":
            expect(_matched(":nth-child(-n)")).to_equal("")

        it ":nth-child(3n-1) -> c2 c5":
            expect(_matched(":nth-child(3n-1)")).to_equal("c2,c5,")

        it ":nth-child(2N+1) -> c1 c3 c5":
            expect(_matched(":nth-child(2N+1)")).to_equal("c1,c3,c5,")

        it "p:nth-child(2) -> none":
            expect(_matched("p:nth-child(2)")).to_equal("")

        it "p:nth-child(3) -> c3":
            expect(_matched("p:nth-child(3)")).to_equal("c3,")

        it "span:nth-child(2) -> c2":
            expect(_matched("span:nth-child(2)")).to_equal("c2,")

    context ":nth-last-child":

        it ":nth-last-child(1) -> c6":
            expect(_matched(":nth-last-child(1)")).to_equal("c6,")

        it ":nth-last-child(-n+2) -> c5 c6":
            expect(_matched(":nth-last-child(-n+2)")).to_equal("c5,c6,")

        it ":nth-last-child(odd) -> c2 c4 c6":
            expect(_matched(":nth-last-child(odd)")).to_equal("c2,c4,c6,")

        it ":nth-last-child(2n) -> c1 c3 c5":
            expect(_matched(":nth-last-child(2n)")).to_equal("c1,c3,c5,")

        it "p:nth-last-child(2) -> none":
            expect(_matched("p:nth-last-child(2)")).to_equal("")

    context ":nth-of-type":

        it "p:nth-of-type(2) -> c3":
            expect(_matched("p:nth-of-type(2)")).to_equal("c3,")

        it "span:nth-of-type(1) -> c2":
            expect(_matched("span:nth-of-type(1)")).to_equal("c2,")

        it "p:nth-of-type(odd) -> c1 c4":
            expect(_matched("p:nth-of-type(odd)")).to_equal("c1,c4,")

        it ":nth-of-type(-n+1) -> c1 c2":
            expect(_matched(":nth-of-type(-n+1)")).to_equal("c1,c2,")

        it ":nth-of-type(2) -> c3 c5":
            expect(_matched(":nth-of-type(2)")).to_equal("c3,c5,")

    context ":nth-last-of-type":

        it "p:nth-last-of-type(1) -> c6":
            expect(_matched("p:nth-last-of-type(1)")).to_equal("c6,")

        it "span:nth-last-of-type(2) -> c2":
            expect(_matched("span:nth-last-of-type(2)")).to_equal("c2,")

        it "p:nth-last-of-type(-n+2) -> c4 c6":
            expect(_matched("p:nth-last-of-type(-n+2)")).to_equal("c4,c6,")

        it ":nth-last-of-type(1) -> c5 c6":
            expect(_matched(":nth-last-of-type(1)")).to_equal("c5,c6,")

    context "text and pre-parsed matcher paths":

        it "agree on every selector of the oracle table":
            val html = "<html><head><style>#box > :nth-child(2n+1) {{ width:50px }} #box > :nth-child(ODD) {{ width:50px }} #box > :nth-child(even) {{ width:50px }} #box > :nth-child(3) {{ width:50px }} #box > :nth-child(n+4) {{ width:50px }} #box > :nth-child(-2n+5) {{ width:50px }} #box > :nth-child(0n+2) {{ width:50px }} #box > :nth-child(2n) {{ width:50px }} #box > :nth-child( 2n + 1 ) {{ width:50px }} #box > :nth-child(+3) {{ width:50px }} #box > :nth-child(-n+0) {{ width:50px }} #box > :nth-child(1 2) {{ width:50px }} #box > :nth-child(2n+) {{ width:50px }} #box > :nth-child(\t2n\n+ 1) {{ width:50px }} #box > :nth-child(n) {{ width:50px }} #box > :nth-child(-n) {{ width:50px }} #box > :nth-child(3n-1) {{ width:50px }} #box > :nth-child(2N+1) {{ width:50px }} #box > p:nth-child(2) {{ width:50px }} #box > p:nth-child(3) {{ width:50px }} #box > span:nth-child(2) {{ width:50px }} #box > :nth-last-child(1) {{ width:50px }} #box > :nth-last-child(-n+2) {{ width:50px }} #box > :nth-last-child(odd) {{ width:50px }} #box > :nth-last-child(2n) {{ width:50px }} #box > p:nth-last-child(2) {{ width:50px }} #box > p:nth-of-type(2) {{ width:50px }} #box > span:nth-of-type(1) {{ width:50px }} #box > p:nth-of-type(odd) {{ width:50px }} #box > :nth-of-type(-n+1) {{ width:50px }} #box > :nth-of-type(2) {{ width:50px }} #box > p:nth-last-of-type(1) {{ width:50px }} #box > span:nth-last-of-type(2) {{ width:50px }} #box > p:nth-last-of-type(-n+2) {{ width:50px }} #box > :nth-last-of-type(1) {{ width:50px }}</style></head><body><div id=\"box\"><p id=\"c1\"></p><span id=\"c2\"></span><p id=\"c3\"></p><p id=\"c4\"></p><span id=\"c5\"></span><p id=\"c6\"></p></div></body></html>"
            expect(simple_web_layout_debug_selector_parse_equivalence(html, 0 - 1).starts_with("ok ")).to_equal(true)

    context "ancestor position, combinators and :not":

        it "tr:nth-child(odd) td -> a1 a2 c1":
            expect(_matched2("tr:nth-child(odd) td")).to_equal("a1,a2,c1,")

        it "tr:nth-of-type(odd) td -> a1 a2 c1":
            expect(_matched2("tr:nth-of-type(odd) td")).to_equal("a1,a2,c1,")

        it "tr:nth-child(2) > td -> b1":
            expect(_matched2("tr:nth-child(2) > td")).to_equal("b1,")

        it "tr:nth-last-child(1) td -> c1":
            expect(_matched2("tr:nth-last-child(1) td")).to_equal("c1,")

        it "tr:nth-last-of-type(2) td -> b1":
            expect(_matched2("tr:nth-last-of-type(2) td")).to_equal("b1,")

        it "li:nth-of-type(2) > a -> x2":
            expect(_matched2("li:nth-of-type(2) > a")).to_equal("x2,")

        it "li:nth-of-type(2) a -> x2 x2b":
            expect(_matched2("li:nth-of-type(2) a")).to_equal("x2,x2b,")

        it "li:first-child a -> x1":
            expect(_matched2("li:first-child a")).to_equal("x1,")

        it "li:last-child > a -> x3":
            expect(_matched2("li:last-child > a")).to_equal("x3,")

        it "li:only-child a -> none":
            expect(_matched2("li:only-child a")).to_equal("")

        it "ul > li:nth-child(n+2) a -> x2 x2b x3":
            expect(_matched2("ul > li:nth-child(n+2) a")).to_equal("x2,x2b,x3,")

        it "p:nth-last-child(1) + div -> none":
            expect(_matched2("p:nth-last-child(1) + div")).to_equal("")

        it "#box > :not(:nth-child(2)) -> n1 n3":
            expect(_matched2("#box > :not(:nth-child(2))")).to_equal("n1,n3,")

        it "#box > i:not(:nth-of-type(odd)) -> n2":
            expect(_matched2("#box > i:not(:nth-of-type(odd))")).to_equal("n2,")

        it "#box > :not(:first-child) -> n2 n3":
            expect(_matched2("#box > :not(:first-child)")).to_equal("n2,n3,")

        it "#box > :not(:nth-last-child(1)) -> n1 n2":
            expect(_matched2("#box > :not(:nth-last-child(1))")).to_equal("n1,n2,")

        it "section:nth-of-type(2) > div:nth-child(2) -> w2":
            expect(_matched2("section:nth-of-type(2) > div:nth-child(2)")).to_equal("w2,")

        it "tr:nth-child(odd) td:nth-child(2) -> a2":
