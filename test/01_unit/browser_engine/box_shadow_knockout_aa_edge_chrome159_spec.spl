"""
## Purpose and audience
Purpose: Pin the anti-aliased edge of the box-shadow knockout under a
translucent rounded box against Chrome 159 on the raster, cpu_simd and
Vulkan lanes. Chrome clips the shadow with an anti-aliased rounded rect,
so the corner pixels of the box carry part of the shadow; every lane used
to restore them whole (a hard, shadow-free corner edge).
Audience: maintainers of the web paint path and Engine2D box effects.
"""

"""
Traceability: doc/08_tracking/bug/web_layout_cascade_selector_paint_chrome159_round4_divergences_2026-11-15.md
(knockout edge not anti-aliased).
The pinned quantity is the shadow's share of a corner pixel: the pixel with
the shadow minus the same pixel without it. The box's own corner coverage
still differs from Chrome's (same bug record, rounded-corner AA coverage),
so absolute pixel values are not pinned here.
"""
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_software_pixels
}

val KOAA_KO = "<!DOCTYPE html><html><body style='margin:0;background:#1e1e2e'><div style='margin:12px;width:60px;height:40px;border-radius:12px;background:rgba(255,255,255,0.72);box-shadow:0 0 20px rgba(0,88,188,0.6)'></div></body></html>"
val KOAA_NB = "<!DOCTYPE html><html><body style='margin:0;background:#1e1e2e'><div style='margin:12px;width:60px;height:40px;border-radius:12px;background:rgba(255,255,255,0.72)'></div></body></html>"

# Chrome 159 shadow share (ko - nb) per device pixel: x, y, dr, dg, db.
val KOAA_K1: [i32] = [15, 15, -3, 3, 10, 16, 14, -4, 7, 16, 14, 16, -3, 6, 14, 18, 13, -1, 3, 8, 13, 18, -1, 2, 4]
val KOAA_K4: [i32] = [63, 60, -4, 6, 17, 55, 70, -2, 2, 6]

fn koaa_mismatches(ko: [u32], nb: [u32], w: i32, want: [i32]) -> i32:
    if ko.len() != nb.len() or ko.len() < (w * 4) as i64:
        return -1
    var bad = 0
    var i = 0
    while i < want.len():
        val idx = want[i + 1] * w + want[i]
        var c = 0
        while c < 3:
            val sh = (16 - c * 8) as u32
            val d = (((ko[idx] >> sh) & 0xFFu32) as i32 - ((nb[idx] >> sh) & 0xFFu32) as i32) - want[i + 2 + c]
            if d > 2 or d < -2:
                bad = bad + 1
            c = c + 1
        i = i + 5
    bad

fn koaa_engine2d(lane: text) -> i32:
    val ko = simple_web_layout_render_html_pixels_engine2d_at_device_scale(KOAA_KO, 120, 90, 4, lane)
    val nb = simple_web_layout_render_html_pixels_engine2d_at_device_scale(KOAA_NB, 120, 90, 4, lane)
    koaa_mismatches(ko, nb, 480, KOAA_K4)

describe "box-shadow knockout anti-aliased edge (Chrome 159)":
    it "raster: corner pixels carry the shadow's share":
        val ko = simple_web_layout_render_html_software_pixels(KOAA_KO, 120, 90, 600000)
        val nb = simple_web_layout_render_html_software_pixels(KOAA_NB, 120, 90, 600000)
        expect(koaa_mismatches(ko, nb, 120, KOAA_K1)).to_equal(0)

    it "cpu_simd at device scale 4: corner pixels carry the shadow's share":
        expect(koaa_engine2d("cpu_simd")).to_equal(0)

    it "vulkan at device scale 4: corner pixels carry the shadow's share":
        expect(koaa_engine2d("vulkan")).to_equal(0)
