use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.browser_engine.layout_insets.{ancestor_bottom_inset}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_foundation.{HNode}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_style.{Style, renderer_default_style}

fn inset_node(parent: i32) -> HNode:
    HNode(tag: "div", text_data: "", text_trimmed: "", style_attr: "",
        class_attr: "", class_words: [], has_widget_class: false,
        has_icon_image_class: false, has_widget_panel_class: false,
        has_widget_button_class: false, has_widget_image_class: false,
        has_focused_class: false, id_attr: "", attrs_raw: "", parent: parent)

fn inset_style(padding: i32, border: i32) -> Style:
    var style = renderer_default_style()
    style.pad_b = padding
    style.border_b = border
    style

describe "ancestor bottom content insets":
    it "excludes the starting node and sums every ancestor padding and border":
        val nodes = [inset_node(-1), inset_node(0), inset_node(1)]
        val styles = [inset_style(5, 2), inset_style(11, 3), inset_style(900, 100)]
        expect(ancestor_bottom_inset(nodes, styles, 2)).to_equal(21)
        expect(ancestor_bottom_inset(nodes, styles, 1)).to_equal(7)

    it "returns zero for a root regardless of its own inset":
        expect(ancestor_bottom_inset([inset_node(-1)], [inset_style(900, 100)], 0)).to_equal(0)

    it "bounds a cyclic parent chain instead of walking forever":
        expect(ancestor_bottom_inset([inset_node(0)], [inset_style(5, 2)], 0)).to_equal(448)
