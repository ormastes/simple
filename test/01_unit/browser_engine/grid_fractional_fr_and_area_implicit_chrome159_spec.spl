# @tag: unit, browser_engine, layout, grid, chrome159
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_declarations.spl 1%
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_engine.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    normalized_grid_track_list, normalized_grid_area, apply_decls, renderer_default_style
}
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{
    simple_web_render_html_to_pixels_with_engine2d_backend
}
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}

val CSS_W: i32 = 520
val CSS_H: i32 = 250
val PAGE: text = (
    "<!doctype html><html><head><meta charset=\"utf-8\"><style>" +
    "body{{margin:0;background:#fff}}" +
    ".w{{margin-left:40px;width:200px;height:30px}}" +
    "</style></head><body>" +
    "<div class=\"w\" style=\"display:grid;grid-template-columns:0.7fr 1fr\"><div style=\"height:20px;background:#00f\"></div><div style=\"height:20px\"></div></div>" +
    "<div class=\"w\" style=\"display:grid;grid-template-columns:0.7fr 1fr\"><div style=\"height:20px\"></div><div style=\"height:20px;background:#00f\"></div></div>" +
    "<div class=\"w\" style=\"display:grid;grid-template-columns:auto auto minmax(96px, 0.7fr) minmax(140px, 1fr) auto;width:440px\"><div style=\"width:20px;height:20px\"></div><div style=\"width:20px;height:20px\"></div><div style=\"height:20px;background:#00f\"></div><div style=\"height:20px\"></div><div style=\"width:20px;height:20px\"></div></div>" +
    "<div class=\"w\" style=\"display:grid;grid-template-columns:auto 1fr\"><div style=\"width:40px;height:20px;background:#00f\"></div><div style=\"grid-area:1 / 3;width:20px;height:20px;background:#00f\"></div></div>" +
    "<div class=\"w\" style=\"display:grid;grid-template-columns:auto 1fr;grid-template-areas:'a b c'\"><div style=\"width:40px;height:20px;background:#00f\"></div><div style=\"grid-area:c;width:20px;height:20px;background:#00f\"></div></div>" +
    "<div class=\"w\" style=\"display:grid;grid-template-columns:40px 40px;column-gap:10px;grid-auto-columns:1fr\"><div style=\"height:20px\"></div><div style=\"height:20px\"></div><div style=\"grid-area:1 / 3;height:20px;background:#00f\"></div></div>" +
    "<div class=\"w\" style=\"display:grid;grid-template-columns:40px 40px;column-gap:10px;grid-auto-columns:0.7fr 1fr;width:210px\"><div style=\"height:20px\"></div><div style=\"height:20px\"></div><div style=\"grid-area:1 / 4;height:20px;background:#00f\"></div></div>" +
    "<div class=\"w\" style=\"display:grid;grid-template-columns:minmax(60px, 0.7fr) 1fr;width:120px\"><div style=\"height:20px\"></div><div style=\"height:20px;background:#00f\"></div></div>" +
    "</body></html>"
)
var g_px1: [u32] = []
var g_px4: [u32] = []

fn _px(k: i32) -> [u32]:
    if k == 1:
        if g_px1.len() == 0:
            g_px1 = simple_web_render_html_to_pixels_with_engine2d_backend(PAGE, CSS_W, CSS_H, "cpu_simd")
        return g_px1
    if g_px4.len() == 0:
        g_px4 = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE, CSS_W, CSS_H, k, "cpu_simd")
    g_px4

fn _runs(k: i32, row: i32) -> text:
    val px = _px(k)
    val w = CSS_W * k
    val y = (row * 30 + 10) * k
    var out = ""
    var x = 0
    var inr = false
    var start = 0
    while x <= w:
        var blue = false
        if x < w:
            val v = px[y * w + x]
            val r = ((v >> 16u32) & 0xFFu32).to_i32()
            val b = (v & 0xFFu32).to_i32()
            blue = b > 128 and r < 128
        if blue and not inr:
            inr = true
            start = x
        if not blue and inr:
            inr = false
            out = out + " {start}..{x - 1}"
        x = x + 1
    out

fn _both(row: i32, r1: text, r4: text):
    expect(_runs(1, row)).to_equal(r1)
    expect(_runs(4, row)).to_equal(r4)

describe "grid fractional fr tracks and grid-area implicit columns":
    it "parses fractional fr tracks while preserving positive-int contract":
        expect(normalized_grid_track_list("0.7fr 1fr")).to_equal("0.7fr 1fr")
        expect(normalized_grid_track_list("auto auto minmax(96px, 0.7fr) minmax(140px, 1fr) auto")).to_equal("auto auto 96+0.7fr 140+1fr auto")
        expect(normalized_grid_track_list("0.0fr 1fr")).to_equal("")
        expect(normalized_grid_track_list("0fr")).to_equal("")
        expect(normalized_grid_track_list("1000000fr 1fr")).to_equal("")
        val st = apply_decls(
            renderer_default_style(),
            "display:grid;grid-template-columns:auto auto minmax(96px, 0.7fr) minmax(140px, 1fr) auto",
            16
        )
        expect(st.grid_template_columns).to_equal("auto auto 96+0.7fr 140+1fr auto")

    it "parses slash-form grid-area shorthand with cascade precedence without changing normalized_grid_area":
        expect(normalized_grid_area("1 / 3")).to_equal("")
        val st1 = apply_decls(renderer_default_style(), "grid-area: 1 / 3", 16)
        expect(st1.grid_area).to_equal("")
        expect(st1.grid_row).to_equal("1")
        expect(st1.grid_column).to_equal("3")

        val st2 = apply_decls(renderer_default_style(), "grid-column: 2; grid-area: 1 / 3", 16)
        expect(st2.grid_row).to_equal("1")
        expect(st2.grid_column).to_equal("3")

        val st3 = apply_decls(renderer_default_style(), "grid-area: 1 / 3; grid-column: 2", 16)
        expect(st3.grid_row).to_equal("1")
        expect(st3.grid_column).to_equal("2")

        val st4 = apply_decls(renderer_default_style(), "grid-area: 2 / 1 / 4 / span 2", 16)
        expect(st4.grid_row).to_equal("2 / 4")
        expect(st4.grid_column).to_equal("1 / span 2")

        val st5 = apply_decls(renderer_default_style(), "grid-column: 2; grid-area: 3", 16)
        expect(st5.grid_row).to_equal("3")
        expect(st5.grid_column).to_equal("")

    it "renders 0.7fr 1fr column tracks and fractional edges at k=1 and k=4":
        _both(0, " 40..121", " 160..488")
        _both(1, " 122..239", " 489..959")

    it "renders auto+minmax+0.7fr titlebar template with auto and fr tracks":
        # 440px container: auto(20) auto(20) 0.7fr(156.47px) 1fr(223.53px) auto(20)
        # col 2 starts at 40+20+20 = 80 (4x: 320), width = 156.4706px (4x: 625.88 -> 626px -> 320..945)
        _both(2, " 80..235", " 320..945")

    it "routes grid-area: 1 / 3 and named grid-area past auto 1fr to implicit columns":
        _both(3, " 40..79 220..239", " 160..319 880..959")
        _both(4, " 40..79 220..239", " 160..319 880..959")

    it "spaces implicit fr tracks after explicit multi-column template with single gap":
        # 200px container at x=40: 40px + 10px gap + 40px + 10px gap + 1fr(100px) -> 140..239 (4x: 560..959)
        _both(5, " 140..239", " 560..959")
        # 210px container at x=40: 40px + 10px + 40px + 10px + 0.7fr(41.18px) + 10px + 1fr(58.82px) -> 191..249 (4x: 765..999)
        _both(6, " 191..249", " 765..999")
        # 120px container at x=40: minmax(60px, 0.7fr) freezes at 60px floor leaving 60px for 1fr -> 100..159 (4x: 400..639)
        _both(7, " 100..159", " 400..639")
