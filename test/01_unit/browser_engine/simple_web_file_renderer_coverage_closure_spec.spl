# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_file_renderer.spl 95%
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_url_placeholder_renderer.spl 100%
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_script_placeholder_renderer.spl 100%
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_script_renderer.spl 60%
"""
# Simple Web File / Placeholder Renderers — Coverage Closure

These small URL-to-RGBA renderers had zero direct test/ references. This
spec closes their branches: about: URLs, missing file:// paths, real
file:// HTML rendering, the deterministic static-HTML pixel pattern, and
the pure-white placeholder renderers.
"""

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.browser_engine.simple_web_file_renderer.{
    simple_web_file_render_url_to_pixels,
    simple_web_render_url_to_pixels,
    simple_web_render_html_to_rgba_bytes}
use std.gc_async_mut.gpu.browser_engine.simple_web_url_placeholder_renderer.{
    simple_web_render_placeholder_url_to_pixels}
use std.gc_async_mut.gpu.browser_engine.simple_web_script_placeholder_renderer.{
    simple_web_render_script_placeholder_url_to_pixels}
use std.gc_async_mut.gpu.browser_engine.simple_web_script_renderer.{
    simple_web_render_url_to_pixels_with_scripts}
use std.io_runtime.{file_write}

fn _is_white(px: [u8], base: i64) -> bool:
    px[base] == 255 and px[base + 1] == 255 and px[base + 2] == 255 and px[base + 3] == 255

describe "simple_web_file_render_url_to_pixels":
    it "renders about: URLs as a white width*height*4 buffer":
        val px = simple_web_file_render_url_to_pixels("about:blank", 3, 2)
        expect(px.len()).to_equal(24)
        expect(_is_white(px, 0)).to_equal(true)
        expect(_is_white(px, 20)).to_equal(true)

    it "renders a missing file:// path as white":
        val px = simple_web_file_render_url_to_pixels("file:///nonexistent/definitely_missing.html", 2, 2)
        expect(px.len()).to_equal(16)
        expect(_is_white(px, 0)).to_equal(true)

    it "renders an unknown scheme as white":
        val px = simple_web_file_render_url_to_pixels("https://example.com", 2, 1)
        expect(_is_white(px, 0)).to_equal(true)

    it "renders an existing file:// HTML through the static pattern":
        val path = "/tmp/simple_web_file_renderer_spec_fixture.html"
        file_write(path, "<html><body>hi</body></html>")
        val px = simple_web_file_render_url_to_pixels("file://" + path, 5, 2)
        expect(px.len()).to_equal(40)
        # pixel 0 is the blue accent (37, 99, 235, 255)
        expect(px[0]).to_equal(37)
        expect(px[2]).to_equal(235)

    it "simple_web_render_url_to_pixels is the same renderer":
        val a = simple_web_render_url_to_pixels("about:blank", 2, 2)
        expect(a.len()).to_equal(16)
        expect(_is_white(a, 12)).to_equal(true)

describe "simple_web_render_html_to_rgba_bytes":
    it "paints the deterministic accent every 17th pixel, white elsewhere":
        val px = simple_web_render_html_to_rgba_bytes("<p>x</p>", 18, 1)
        expect(px.len()).to_equal(72)
        expect(px[0]).to_equal(37)     # pixel 0: 0 % 17 == 0 -> accent
        expect(px[1]).to_equal(99)
        expect(px[3]).to_equal(255)
        expect(_is_white(px, 4)).to_equal(true)      # pixel 1: white
        expect(px[17 * 4]).to_equal(37)              # pixel 17: accent again

describe "placeholder renderers":
    it "url placeholder renders all-white regardless of url":
        val px = simple_web_render_placeholder_url_to_pixels("anything://x", 2, 2)
        expect(px.len()).to_equal(16)
        expect(_is_white(px, 0)).to_equal(true)
        expect(_is_white(px, 12)).to_equal(true)

    it "script placeholder forwards to the url placeholder":
        val px = simple_web_render_script_placeholder_url_to_pixels("x", 1, 1)
        expect(px.len()).to_equal(4)
        expect(_is_white(px, 0)).to_equal(true)

describe "simple_web_render_url_to_pixels_with_scripts":
    it "about: and missing file urls fall back to the white about:blank render":
        val a = simple_web_render_url_to_pixels_with_scripts("about:blank", 2, 1)
        expect(a.len()).to_equal(8)
        expect(_is_white(a, 0)).to_equal(true)
        val b = simple_web_render_url_to_pixels_with_scripts("file:///nonexistent/missing.html", 2, 1)
        expect(_is_white(b, 0)).to_equal(true)
        val c = simple_web_render_url_to_pixels_with_scripts("gopher://x", 2, 1)
        expect(_is_white(c, 0)).to_equal(true)
