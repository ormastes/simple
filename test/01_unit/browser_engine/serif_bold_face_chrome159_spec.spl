"""
## Purpose and audience
Purpose: Pin the FACE of bold serif text against Chrome 159. Since serif became
the default family (#10089), every UA heading and `<b>` on a page without a
`font-family` is bold serif, but the weight router sent bold only to the sans
and mono bold faces, so bold serif painted Liberation Serif REGULAR: the `<b>`
band below was byte-identical to the regular `<span>` band (dark sum 279172 for
both). Chrome 159 on Linux (fontconfig `serif:bold` -> LiberationSerif-Bold.ttf)
paints the real bold face: `<b>Hamburgefonstiv</b>` at 16px is 120.00 px wide
against the regular face's 111.69 (`getBoundingClientRect`).
Audience: web renderer text / font face resolution maintainers.

Chrome oracle (Chrome for Testing 159, `--headless=new --disable-gpu
--hide-scrollbars --force-device-scale-factor=1 --window-size=320,100
--screenshot`), default family (serif), `color:#000` on white, page `_page()`.
dark = 765 - (r+g+b); extent = columns with dark > 150.

| band (rows)            | Chrome x / dark   | base x / dark     | head x / dark     |
|------------------------|-------------------|-------------------|-------------------|
| UA h3 18.72px (0..36)  | 0..140 / 568936   | 0..130 / 366995   | 0..139 / 560032   |
| `<b>` 16px (36..67)    | 0..119 / 433040   | 0..111 / 279172   | 0..119 / 428710   |
| `<span>` 16px (67..100)| 0..111 / 286470   | 0..111 / 279172   | 0..111 / 279172   |

`H` left stem, dark of x=0..5: h3 row 14 Chrome `0 168 703 765 560 48` (2244),
base 1347; `<b>` row 50 Chrome `8 312 750 695 152 0` (1917), base 1155.
Mismatched px (dark delta > 24) vs Chrome: h3 1297 -> 359, `<b>` 1022 -> 249.
Grayscale path (device size > 48 px), `<b style="font-size:60px">H</b>` at
0,0: Chrome row 25 x=0..15 dark `0 0 0 0 0 0 705 765x8 225` (7050); base
`0x7 765x5 573` (4398, the regular stem); head 7074.
"""

"""
Traceability: REQ-WEB-TEXT-FONT-BOLD-001 — bold serif text (UA headings, `<b>`) paints the Liberation Serif Bold face, as Chrome 159 on Linux.
"""
# @tag: unit, browser_engine, text, engine2d, chrome159
# @cover src/lib/nogc_sync_mut/text_layout/font_provider.spl 1%
use std.spec.*
use std.io_runtime.{file_exists}
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{
    simple_web_render_html_to_pixels_with_engine2d_backend
}

val SERIF_BOLD: text = "/usr/share/fonts/truetype/liberation/LiberationSerif-Bold.ttf"
val W: i32 = 320
val H: i32 = 100

fn _page() -> text:
    "<!doctype html><html><body style=\"margin:0;background:#fff\"><h3 style=\"margin:0;position:absolute;left:0;top:2px;color:#000\">Hamburgefonstiv</h3><b style=\"position:absolute;left:0;top:40px;font-size:16px;color:#000\">Hamburgefonstiv</b><span style=\"position:absolute;left:0;top:70px;font-size:16px;color:#000\">Hamburgefonstiv</span></body></html>"

fn _page_60() -> text:
    "<!doctype html><html><body style=\"margin:0;background:#fff\"><b style=\"position:absolute;left:0;top:0;font-size:60px;color:#000\">H</b></body></html>"

fn _dark(px: u32) -> i32:
    765 - (((px >> 16) & 0xFFu32) + ((px >> 8) & 0xFFu32) + (px & 0xFFu32)).to_i32()

# Summed dark over rows y0..y1-1.
fn _band_dark(px: [u32], y0: i32, y1: i32) -> i32:
    var sum = 0
    var y = y0
    while y < y1:
        var x = 0
        while x < W:
            sum = sum + _dark(px[y * W + x])
            x = x + 1
        y = y + 1
    sum

# Rightmost column with dark > 150 over rows y0..y1-1, or -1.
fn _band_right(px: [u32], y0: i32, y1: i32) -> i32:
    var right = -1
    var y = y0
    while y < y1:
        var x = 0
        while x < W:
            if _dark(px[y * W + x]) > 150 and x > right:
                right = x
            x = x + 1
        y = y + 1
    right

# Summed dark of x=0..n-1 on row y.
fn _row_dark(px: [u32], y: i32, n: i32) -> i32:
    var sum = 0
    var x = 0
    while x < n:
        sum = sum + _dark(px[y * W + x])
        x = x + 1
    sum

# Summed dark of x=0..5 on row y (the `H` left stem).
fn _stem_dark(px: [u32], y: i32) -> i32:
    _row_dark(px, y, 6)

fn _within_pct(ours: i32, chrome: i32, pct: i32) -> bool:
    val d = if ours > chrome: ours - chrome else: chrome - ours
    d * 100 <= chrome * pct

describe "bold serif face against Chrome 159":
    it "AC-1: the UA h3 (18.72px bold serif) paints Liberation Serif Bold":
        if not file_exists(SERIF_BOLD):
            skip("no Liberation Serif Bold on this host")
            return
        val px = simple_web_render_html_to_pixels_with_engine2d_backend(_page(), W, H, "cpu_simd")
        expect(px.len()).to_equal((W * H).to_i64())
        step("Chrome ink extent x=0..140 (regular face ends at 130)")
        val right = _band_right(px, 0, 36)
        expect(right >= 139 and right <= 141).to_be(true)
        step("Chrome band dark 568936 (regular face 366995), within 3%")
        expect(_within_pct(_band_dark(px, 0, 36), 568936, 3)).to_be(true)
        step("Chrome H stem row 14 x=0..5 dark 2244 (regular face 1347), within 5%")
        expect(_within_pct(_stem_dark(px, 14), 2244, 5)).to_be(true)

    it "AC-2: `<b>` at 16px in the default serif paints Liberation Serif Bold":
        if not file_exists(SERIF_BOLD):
            skip("no Liberation Serif Bold on this host")
            return
        val px = simple_web_render_html_to_pixels_with_engine2d_backend(_page(), W, H, "cpu_simd")
        expect(px.len()).to_equal((W * H).to_i64())
        step("Chrome ink extent x=0..119 (regular face ends at 111)")
        val right = _band_right(px, 36, 67)
        expect(right >= 118 and right <= 120).to_be(true)
        step("Chrome band dark 433040 (regular face 279172), within 3%")
        expect(_within_pct(_band_dark(px, 36, 67), 433040, 3)).to_be(true)
        step("Chrome H stem row 50 x=0..5 dark 1917 (regular face 1155), within 5%")
        expect(_within_pct(_stem_dark(px, 50), 1917, 5)).to_be(true)

    it "AC-3: regular serif at 16px keeps the regular face":
        if not file_exists(SERIF_BOLD):
            skip("no Liberation Serif Bold on this host")
            return
        val px = simple_web_render_html_to_pixels_with_engine2d_backend(_page(), W, H, "cpu_simd")
        expect(px.len()).to_equal((W * H).to_i64())
        step("Chrome ink extent x=0..111, band dark 286470, within 3%")
        expect(_band_right(px, 67, 100)).to_equal(111)
        expect(_within_pct(_band_dark(px, 67, 100), 286470, 3)).to_be(true)

    it "AC-4: 60px bold serif (grayscale raster path, > 48 px) paints Liberation Serif Bold":
        if not file_exists(SERIF_BOLD):
            skip("no Liberation Serif Bold on this host")
            return
        val px = simple_web_render_html_to_pixels_with_engine2d_backend(_page_60(), W, H, "cpu_simd")
        expect(px.len()).to_equal((W * H).to_i64())
        step("Chrome H stem row 25 x=0..15 `0x6 705 765x8 225` dark 7050 (regular face 4398), within 3%")
        expect(_within_pct(_row_dark(px, 25, 16), 7050, 3)).to_be(true)
