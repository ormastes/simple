use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{simple_web_render_html_to_pixels_with_resolved_engine2d_backend}

# A page-long rounded box at dpr4 (3408 x 3700 device px) is larger than the
# 16.7M-px transient cap yet only its ring is painted: the left/top border must
# not vanish. Here a 4200 x 4200 css box (17.6M px) clipped by a 40 x 40 view.
val TC_PAGE = "<!DOCTYPE html><html><body style=\"margin:0;background:#fff\"><div style=\"width:4200px;height:4200px;box-sizing:border-box;border:2px solid #f00;border-radius:6px;background:#0f0\"></div></body></html>"

describe "rounded border ring on a box larger than the transient cap":
    it "paints the straight left and top sides on cpu_simd":
        val px = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(TC_PAGE, 40, 40, "cpu_simd")
        expect(px.len() >= 1600).to_equal(true)
        expect(px[20 * 40 + 0] | 0xFF000000u32).to_equal(0xFFFF0000u32)
        expect(px[20 * 40 + 1] | 0xFF000000u32).to_equal(0xFFFF0000u32)
        expect(px[0 * 40 + 20] | 0xFF000000u32).to_equal(0xFFFF0000u32)
        expect(px[20 * 40 + 20] | 0xFF000000u32).to_equal(0xFF00FF00u32)
