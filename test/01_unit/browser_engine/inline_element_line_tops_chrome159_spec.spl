"""
## Purpose and audience
Purpose: Pin Chrome 159's line tops at device scale 4 for lines that a bigger
inline makes taller, and the line tops and backgrounds of plain inline
elements (wrapped and not) at device scales 1 and 4.
- **Taller lines at 4x.** Chrome lays out in device px, so a 22px/1.3 span
  line is 114.390625 device px (1/64 LayoutUnit), not 114. The lines below it
  start at that fraction: the third div of MIXED_PAGE starts at device row
  462.78, which paints from 463. This engine dropped the fraction on every
  such line: 1 device row early from the second taller line on (2 rows by
  the end of a page whose last block is also 15px/1.3).
- **Wrapped inline element.** A wrapped `<span>` that holds the block's only
  run stacks exact line boxes, exactly like a bare run. This engine stepped
  those lines, their text and the block height in whole CSS px (19, not
  19.5): line 2 one row high at 1x, 3 device rows high at 4x.
- **Inline element background at 4x.** The box is the DEVICE content area,
  A + D of the face at k x the size (15px Liberation Sans at k=4: 54 + 13 = 67
  rows), hung from the device baseline. This engine painted k x the CSS box
  (68 rows from k x the CSS top), wrapped or not.
Audience: web renderer inline layout maintainers.

Chrome oracle: Chrome for Testing 159.0.8154.6 aarch64, `--headless=new
--disable-gpu --hide-scrollbars --force-device-scale-factor=K`, window
400x400, Liberation Sans via `sans-serif`. `Range.getClientRects()` at K=4:
MIXED_PAGE div tops 0, 48.0977, 115.6953, 163.793; BG_PAGE span line tops
1.25, 20.75, 40.25 (h 16.75), 62, 90.078, 118.156 (h 21). Values are device
rows with green < 128 in one column: runs, or each run's first / last row.

| page / column               | K | Chrome                                  | base 85ed20c0650 |
|-----------------------------|---|-----------------------------------------|------------------|
| MIXED_PAGE, x 8 bottoms     | 4 | ... 356 443 549 635 699 724             | ... 356 442 548 634 698 723 |
| BG_PAGE, x 0                | 1 | 1-17 21-37 40-56 62-82 90-110 ...       | 1-17 20-36 39-55 60-80 88-108 ... |
| BG_PAGE, x 0 tops           | 4 | 5 83 161 248 360 473 581 659 737        | 4 80 156 240 352 464 572 648 724 |
| BG_PAGE, x 0                | 4 | 5-71 83-149 ... 581-638 ...             | 4-71 80-147 ... 572-631 ... |
| UNWRAPPED_PAGE, x 0         | 4 | 5-71 92-175 200-257                     | 4-71 90-173 198-257 |
| MIXED_PAGE, x 2             | 1 | unchanged (guard)                       | same |
| TALL_PAGE, x 8 bottoms      | 4 | unchanged (guard)                       | same |
"""

"""
Traceability: REQ-WEB-INLINE-LINE-TOPS-002 — taller lines keep their device fraction at device scale k; a plain inline element's lines and backgrounds sit on Chrome's exact LayoutUnit tops and device content area.
"""
# @tag: unit, browser_engine, layout, inline, line_height, device_scale, chrome159
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_foundation.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}

val MIXED_PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;font:16px/1.5 sans-serif;color:#000;background:#fff}} div{{margin:0;width:70px}}</style></head><body><div style=\"font-size:15px;line-height:1.3\">HH HH <span style=\"font-size:22px\">HH</span> HH</div><div style=\"font-size:15px;line-height:1.3\">HH HH <span style=\"font-size:22px\">HH</span> HH HH HH<i></i></div><div style=\"font-size:15px;line-height:1.3\"><span style=\"font-size:22px\">HH</span> HH HH HH</div><div>after</div></body></html>"

val BG_PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;font:16px/1.5 sans-serif;color:#000;background:#fff}} div{{margin:0;width:70px}}</style></head><body><div style=\"font-size:15px;line-height:1.3\"><span style=\"background:#00f;color:#fff\">HH HH HH HH HH HH</span></div><div style=\"font-size:18.72px;line-height:1.5\"><span style=\"background:#00f;color:#fff\">HH HH HH HH HH</span></div><div style=\"font-size:13px\"><span style=\"background:#00f;color:#fff\">HH HH HH HH HH HH HH</span></div><div>after</div></body></html>"

val UNWRAPPED_PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;font:16px/1.5 sans-serif;color:#000;background:#fff}} div{{margin:0;width:70px}}</style></head><body><div style=\"font-size:15px;line-height:1.3\"><span style=\"background:#00f;color:#fff\">HH</span></div><div style=\"font-size:18.72px;line-height:1.5\"><span style=\"background:#00f;color:#fff\">HH</span></div><div style=\"font-size:13px\"><span style=\"background:#00f;color:#fff\">HH</span></div><div>after</div></body></html>"

val TALL_PAGE: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;font:16px/1.5 sans-serif;color:#000;background:#fff}} div{{margin:0;width:70px}}</style></head><body><div style=\"font-size:15px;line-height:1.3\">HH HH <span style=\"font-size:22px\">HH</span> HH HH HH</div><div>HH HH <span style=\"display:inline-block;height:31px;width:10px;background:#888\"></span> HH HH HH</div><div>after</div></body></html>"

fn _ink(px: [u32], w: i32, x: i32, y: i32, y1: i32) -> bool:
    y >= 0 and y < y1 and ((px[y * w + x] >> 8u32) & 255u32) < 128u32

# Runs of device rows y0..y1 whose pixel in column x has green < 128.
fn _runs(px: [u32], w: i32, x: i32, y0: i32, y1: i32) -> text:
    var s = ""
    var start = -1
    var y = y0
    while y <= y1:
        val ink = _ink(px, w, x, y, y1)
        if ink and start < 0:
            start = y
        if not ink and start >= 0:
            s = s + " {start}-{y - 1}"
            start = -1
        y = y + 1
    s.trim()

# The first row of each such run.
fn _tops(px: [u32], w: i32, x: i32, y0: i32, y1: i32) -> text:
    var s = ""
    var y = y0
    while y < y1:
        if _ink(px, w, x, y, y1) and not _ink(px, w, x, y - 1, y1):
            s = s + " {y}"
        y = y + 1
    s.trim()

# The last row of each such run (the tall glyphs raster one row taller than
# Chrome's at the top, so their bottoms are compared).
fn _bottoms(px: [u32], w: i32, x: i32, y0: i32, y1: i32) -> text:
    var s = ""
    var y = y0
    while y < y1:
        if _ink(px, w, x, y, y1) and not _ink(px, w, x, y + 1, y1):
            s = s + " {y}"
        y = y + 1
    s.trim()

describe "Inline element and taller line tops (Chrome 159)":
    it "AC-1: lines below a taller line keep its device fraction at device scale 4":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(MIXED_PAGE, 400, 400, 4, "cpu_simd")
        expect(_bottoms(px, 1600, 8, 0, 800)).to_equal("58 164 250 356 443 549 635 699 724")

    it "AC-2: a wrapped span's line backgrounds step 19.5 px at device scale 1":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(BG_PAGE, 400, 400, 1, "cpu_simd")
        expect(_runs(px, 400, 0, 0, 400)).to_equal("1-17 21-37 40-56 62-82 90-110 118-138 145-159 164-178 184-198")

    it "AC-3: their tops sit on Chrome's device rows at device scale 4":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(BG_PAGE, 400, 400, 4, "cpu_simd")
        expect(_tops(px, 1600, 0, 0, 1600)).to_equal("5 83 161 248 360 473 581 659 737")

    it "AC-4: and each is the device content area tall":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(BG_PAGE, 400, 400, 4, "cpu_simd")
        expect(_runs(px, 1600, 0, 0, 1600)).to_equal("5-71 83-149 161-227 248-331 360-443 473-556 581-638 659-716 737-794")

    it "AC-5: an unwrapped span's background is the device content area too":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(UNWRAPPED_PAGE, 400, 400, 4, "cpu_simd")
        expect(_runs(px, 1600, 0, 0, 1600)).to_equal("5-71 92-175 200-257")

    it "AC-6: the 1x line tops of MIXED_PAGE are unchanged":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(MIXED_PAGE, 400, 400, 1, "cpu_simd")
        expect(_runs(px, 400, 2, 0, 400)).to_equal("5-14 26-40 53-62 74-88 101-110 122-136 149-158 172-173 175-176 179-180")

    it "AC-7: the 4x line bottoms of TALL_PAGE are unchanged":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(TALL_PAGE, 400, 400, 4, "cpu_simd")
        expect(_bottoms(px, 1600, 8, 0, 800)).to_equal("58 164 250 393 489 585 656 681")
