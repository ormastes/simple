"""
## Purpose and audience
Purpose: Pin the `line-height: normal` baseline at 48px and larger. Chrome's
baseline there is the face's rounded ascent PLUS the floored half of the
line gap (Liberation Serif/Sans 48px: ascent 43, descent 10, gap 2 -> normal
line 55, baseline 44). The face ascent itself is 43 (hhea 1825*48/2048 =
42.77); the bug record that called it 1px low conflated ascent with baseline.
Audience: browser-engine layout maintainers.

Chrome oracle (Chrome 159, chromium-1255, 0x0 inline-block marker after `Hxg`,
div at top 0): serif/sans-serif 48px baseline 44, line 55; monospace 45, 56.
"""

"""
Traceability: REQ-BROWSER-ENGINE-LINE-STRUT-BASELINE-001 — large-size strut baseline.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_foundation.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_layout_by_id
}

fn _page(family: text, size: i32) -> text:
    "<!DOCTYPE html><html><head><style>body{{margin:0}}</style></head><body>" +
        "<div id=d style=\"position:absolute;left:0;top:0;width:600px;font-family:" + family +
        ";font-size:" + size.to_string() + "px\">Hxg<i id=b style=\"display:inline-block;width:10px;height:10px\"></i></div></body></html>"

fn _g(page: text, id: text, prop: text) -> text:
    simple_web_layout_debug_layout_by_id(page, 900, 2000, id, prop)

fn _hb(family: text, size: i32) -> text:
    val p = _page(family, size)
    _g(p, "d", "h") + "," + _g(p, "b", "y") + "," + _g(p, "b", "h")

describe "normal line baseline at large sizes":
    it "serif 48px":
        expect(_hb("serif", 48)).to_equal("55,34,10")
    it "sans-serif 48px":
        expect(_hb("sans-serif", 48)).to_equal("55,34,10")
    it "monospace 48px":
        expect(_hb("monospace", 48)).to_equal("56,35,10")
    it "64px and 72px":
        # Chrome 159 marker y (height 10): rows are "line height,marker y".
        expect(_hb("serif", 64)).to_equal("74,48,10")
        expect(_hb("serif", 72)).to_equal("83,55,10")
        expect(_hb("sans-serif", 64)).to_equal("74,49,10")
        expect(_hb("sans-serif", 72)).to_equal("82,56,10")
        expect(_hb("monospace", 64)).to_equal("74,49,10")
        expect(_hb("monospace", 72)).to_equal("84,57,10")
