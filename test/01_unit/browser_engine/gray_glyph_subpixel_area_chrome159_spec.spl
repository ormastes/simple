"""
## Purpose and audience
Purpose: Pin the edge pixels of grayscale glyphs (above the 48 device px LCD
cutoff) against Chrome 159. Chrome draws them like its LCD glyphs minus the
filter: the exact-area coverage of the hinted outline, kept at its true
pen-relative x (fractional left bearing) and placed at Skia's quarter-pixel
phase of the exact pen. This engine snapped every gray glyph's left ink edge
onto a whole pixel, dropped the fractional bearing and the phase, and sampled
coverage on a 4x4 grid (17 levels), so every `l` of a run drew the same
`00 .. 80` stem while Chrome cycles four edge patterns. Catalog 4x pages are
~90% text edges (css-layout / animation 4x: 126k mismatched px each); a probe
of the exact-area model on `a e g s o E x` at 64 px cut the mismatch against
Chrome from 5931 to 1755 px (`E`, `x`: 0..3 px left).
Audience: web renderer text raster maintainers (font_renderer phase cells,
sfnt_glyf outline raster).

Chrome oracle (Chrome for Testing 159.0.8154.6 aarch64, `--headless=new
--disable-gpu --hide-scrollbars --force-device-scale-factor=<k>`), black
16px (k=4) or 64px (k=1) Liberation Sans on white. Values are the red channel
of the listed device columns (255 = paper, 0 = full ink).

| case | row | columns = Chrome red |
|------|-----|----------------------|
| `llllllll` 16px k=4 | 30, 50 | 44=85 49=21 58=146 64=208 72=208 78=146 87=21 92=85 |
| `llllllll` 64px k=1 | 50 | 14=85 19=21 28=146 34=208 42=208 48=146 57=21 62=85 |
| `x` of `lx` 16px k=4 (device pen 54.22) | 46 | 62=170 68=155 71=232 72=20 77=103 |
| `x` of `lx` 16px k=4 (device pen 54.22) | 56 | 64=103 69=19 70=83 76=209 |

A block start at a fractional CSS x (`margin-left: 10.25px`) is a separate,
layout-side gap: the run is drawn from x 10 with no pen origin, so its
glyphs sit 0.25 px left of Chrome whatever the raster does; AC-3 therefore
takes its phase from a glyph advance (`l` = 14.22 device px), not a margin.
At k=1 Chrome additionally hints (slight, y only) glyphs above 48 px, so a
64 px `x` at 1x keeps different rows; this engine leaves gray glyphs unhinted
at every k (as before), which is Chrome at k > 1 only.

Base (c576239ba51) draws every `l` stem as `0 0 0 0 0 128` from a whole
pixel (16px k=4: 44=0 49=128 58=0 64=255 ...). Tolerance: 8 per channel, the
catalog's mismatch threshold.
"""

"""
Traceability: REQ-WEB-GRAY-GLYPH-SUBPIXEL-001 — a grayscale glyph (above the LCD size cutoff) is the exact-area coverage of its outline at Chrome's quarter-pixel phase and true left bearing.
"""
# @tag: unit, browser_engine, text, device_scale, chrome159
# @cover src/lib/nogc_sync_mut/text_layout/font_renderer.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{
    simple_web_layout_render_html_pixels_engine2d_at_device_scale
}

val CSS_W: i32 = 200
val CSS_H: i32 = 100

val PAGE_L16: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff;color:#000;font:16px/1.5 'Liberation Sans'}} p{{margin:0 0 0 10px}}</style></head><body><p>llllllll</p></body></html>"

val PAGE_L64: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff;color:#000;font:64px/1.5 'Liberation Sans'}} p{{margin:0 0 0 10px}}</style></head><body><p>llllllll</p></body></html>"

val PAGE_X16: text = "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{{margin:0;background:#fff;color:#000;font-family:'Liberation Sans';font-size:16px}} p{{margin:0 0 0 10px;line-height:24px;height:24px;white-space:nowrap}}</style></head><body><p>lx</p></body></html>"

fn _red(px: [u32], w: i32, x: i32, y: i32) -> i32:
    ((px[y * w + x] >> 16u32) & 0xFFu32) as i32

# "col=red" for each listed column: Chrome's value when within 8, else ours.
fn _row_text(px: [u32], w: i32, y: i32, cols: [i32], chrome: [i32]) -> text:
    var s = ""
    var i = 0
    while i < cols.len():
        val got = _red(px, w, cols[i], y)
        val d = got - chrome[i]
        val shown = if d <= 8 and d >= -8: chrome[i] else: got
        s = s + "{cols[i]}={shown} "
        i = i + 1
    s

fn _want_text(cols: [i32], chrome: [i32]) -> text:
    var s = ""
    var i = 0
    while i < cols.len():
        s = s + "{cols[i]}={chrome[i]} "
        i = i + 1
    s

describe "Grayscale glyphs keep Chrome's quarter phase, true bearing and exact-area coverage (Chrome 159)":
    it "AC-1: `llllllll` at 16px k=4 cycles Chrome's four stem edge patterns":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE_L16, CSS_W, CSS_H, 4, "cpu_simd")
        expect(px.len()).to_equal((CSS_W * 4 * CSS_H * 4) as i64)
        val cols: [i32] = [44, 49, 58, 64, 72, 78, 87, 92]
        val chrome: [i32] = [85, 21, 146, 208, 208, 146, 21, 85]
        expect(_row_text(px, CSS_W * 4, 30, cols, chrome)).to_equal(_want_text(cols, chrome))
        expect(_row_text(px, CSS_W * 4, 50, cols, chrome)).to_equal(_want_text(cols, chrome))

    it "AC-2: `llllllll` at 64px k=1 takes the same quarter phases":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE_L64, CSS_W, CSS_H, 1, "cpu_simd")
        val cols: [i32] = [14, 19, 28, 34, 42, 48, 57, 62]
        val chrome: [i32] = [85, 21, 146, 208, 208, 146, 21, 85]
        expect(_row_text(px, CSS_W, 50, cols, chrome)).to_equal(_want_text(cols, chrome))

    it "AC-3: diagonal `x` of `lx` at 16px k=4 (device pen 54.22, phase 1) has Chrome's exact-area edge coverage":
        val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(PAGE_X16, CSS_W, CSS_H, 4, "cpu_simd")
        val c46: [i32] = [62, 68, 71, 72, 77]
        val v46: [i32] = [170, 155, 232, 20, 103]
        val c56: [i32] = [64, 69, 70, 76]
        val v56: [i32] = [103, 19, 83, 209]
        expect(_row_text(px, CSS_W * 4, 46, c46, v46)).to_equal(_want_text(c46, v46))
        expect(_row_text(px, CSS_W * 4, 56, c56, v56)).to_equal(_want_text(c56, v56))
