"""
## Purpose and audience
Purpose: pin where the box AFTER an auto-width `<button>` lands, against
Chrome 159. Chrome keeps a button's fractional width (`Go` is 33.785 CSS px,
135.14 device px at device scale 4), so what follows it starts at the exact
sum of the widths before it, snapped once: after three `Go` buttons a box
starts at 101.36 px (k=1: column 101; k=4: device column 405). Whole-CSS-px
button widths put it at 102 / 408.
Audience: maintainers of the web layout engine.

Chrome oracle (Chrome 159.0.8154.6 headless, `--hide-scrollbars
--window-size=400,300`, `--force-device-scale-factor=1` and `=4`, body
`16px/1.5 'Liberation Sans'`, default UA button). Five 30 px rows; each ends
with a black 10 x 10 px inline-block. `BF_CHROME_K1` / `BF_CHROME_K4` hold
each row's LAST dark column (every channel < 160) in device px, i.e. the
black box's right edge; its left edge is that minus 10k - 1.

| row | markup before the box | k=1 last col | k=4 last col |
|-----|-----------------------|--------------|--------------|
| 0 | `Go` | 43 | 174 |
| 1 | `Go` `Go` | 77 | 309 |
| 2 | `Go` `Go` `Go` | 110 | 444 |
| 3 | `Submit` | 66 | 269 |
| 4 | `OK` `Cancel` | 102 | 410 |

The same holds for the other auto-width controls, which Chrome sizes in
device px (a default text `<input>` is 719 device px at k = 4, not 4 x 185).
Second page, four 30 px rows, k = 4 last dark column (`BF_CONTROL_K4`):
`<input>` 758, `<select>` with one `One` option 228, two `<input size=5>`
547, `<textarea rows=1 cols=10>` 445. At k = 1 Chrome and whole-px layout
agree (194, 57, 139, 111).
"""

"""
Traceability: REQ-WEB-FORM-CHROME-PAINT-001 -- a box after an auto-width `<button>` starts at Chrome 159's column at device scale 1 and 4.
"""
# @tag: unit, browser_engine, layout, form_control, device_scale, chrome159
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_layout_engine2d_fast.{simple_web_layout_render_html_pixels_engine2d_at_device_scale}

val BF_W: i32 = 400
val BF_H: i32 = 150
val BF_PAGE: text = "<!doctype html><html><head><style>body{{margin:0;background:#fff;font:16px/1.5 'Liberation Sans'}}div{{height:30px}}i{{display:inline-block;width:10px;height:10px;background:#000}}</style></head><body><div><button>Go</button><i></i></div><div><button>Go</button><button>Go</button><i></i></div><div><button>Go</button><button>Go</button><button>Go</button><i></i></div><div><button>Submit</button><i></i></div><div><button>OK</button><button>Cancel</button><i></i></div></body></html>"
val BF_CONTROL_PAGE: text = "<!doctype html><html><head><style>body{{margin:0;background:#fff;font:16px/1.5 'Liberation Sans'}}div{{height:30px}}i{{display:inline-block;width:10px;height:10px;background:#000}}</style></head><body><div><input><i></i></div><div><select><option>One</option></select><i></i></div><div><input size=5><input size=5><i></i></div><div><textarea rows=1 cols=10></textarea><i></i></div></body></html>"
val BF_CONTROL_K1: [i32] = [194, 57, 139, 111]
val BF_CONTROL_K4: [i32] = [758, 228, 547, 445]
val BF_CHROME_K1: [i32] = [43, 77, 110, 66, 102]
val BF_CHROME_K4: [i32] = [174, 309, 444, 269, 410]

fn bf_last_dark(px: [u32], k: i32, row: i32) -> i32:
    val dw = BF_W * k
    var x = dw - 1
    while x >= 0:
        var y = row * 30 * k
        while y < (row + 1) * 30 * k:
            val p = px[y * dw + x]
            if ((p >> 16) & 255u32) < 160u32 and ((p >> 8) & 255u32) < 160u32 and (p & 255u32) < 160u32:
                return x
            y = y + 1
        x = x - 1
    -1

fn bf_mismatches(page: text, k: i32, want: [i32]) -> i32:
    val px = simple_web_layout_render_html_pixels_engine2d_at_device_scale(page, BF_W, BF_H, k, "cpu_simd")
    if px.len() != BF_W * k * BF_H * k:
        return 99
    var bad = 0
    var row = 0
    while row < want.len():
        val got = bf_last_dark(px, k, row)
        if got != want[row]:
            print "k={k} row {row}: box ends at {got}, Chrome {want[row]}"
            bad = bad + 1
        row = row + 1
    bad

describe "the box after an auto-width button (Chrome 159)":
    it "AC-1: starts at the exact sum of the button widths at device scale 4":
        expect(bf_mismatches(BF_PAGE, 4, BF_CHROME_K4)).to_equal(0)

    it "AC-2: starts at the exact sum of the button widths at device scale 1":
        expect(bf_mismatches(BF_PAGE, 1, BF_CHROME_K1)).to_equal(0)

    it "AC-3: after an input / select / textarea it follows the control's device width at scale 4":
        expect(bf_mismatches(BF_CONTROL_PAGE, 4, BF_CONTROL_K4)).to_equal(0)

    it "AC-4: after an input / select / textarea at device scale 1":
        expect(bf_mismatches(BF_CONTROL_PAGE, 1, BF_CONTROL_K1)).to_equal(0)
