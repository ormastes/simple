use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_decl_apply.{_decl_is_current_color_token}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_declarations.{apply_decls}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_style.{renderer_default_style, SIMPLE_WEB_STICKY_TOP_AUTO}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_paint_layout.{_html_draw_ir_non_negative}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_paint_raster.{has_visible_overflow_clip}

describe "Renderer split modules bind their declaration owners":
    it "recognizes currentColor in a real background declaration":
        expect(_decl_is_current_color_token("CURRENTCOLOR")).to_equal(true)
        expect(_decl_is_current_color_token("url(icon.png) currentColor")).to_equal(true)
        expect(_decl_is_current_color_token("red")).to_equal(false)

    it "retains authored sticky auto rather than treating it as zero":
        val styled = apply_decls(renderer_default_style(), "position: sticky; top: auto", 16)
        expect(styled.top_px).to_equal(SIMPLE_WEB_STICKY_TOP_AUTO)

    it "clamps negative paint dimensions without changing positive dimensions":
        expect(_html_draw_ir_non_negative(-3)).to_equal(0)
        expect(_html_draw_ir_non_negative(0)).to_equal(0)
        expect(_html_draw_ir_non_negative(17)).to_equal(17)

    it "ignores hidden boxes while retaining visible overflow clipping":
        expect(has_visible_overflow_clip([])).to_equal(false)
        var styled = renderer_default_style()
        styled.overflow_hidden = true
        styled.display = "block"
        expect(has_visible_overflow_clip([styled])).to_equal(true)
        styled.display = "none"
        expect(has_visible_overflow_clip([styled])).to_equal(false)
