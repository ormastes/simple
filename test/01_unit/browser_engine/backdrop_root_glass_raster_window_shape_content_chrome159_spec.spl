"""
## Purpose and audience
Purpose: Pin Filter Effects 2 Backdrop Root behaviour for production-style
nested glass on the raster lane against Chrome 159: a gradient image layer
over a translucent colour, `backdrop-filter: blur(24px) saturate(1.7)`, an
outer `box-shadow` halo, text inside the glass, and an opaque button with a
shadow inside the inner panel (the production window fixture's shape).
The Engine2D twin is backdrop_root_glass_gradient_saturate_chrome159_spec.spl.
Audience: maintainers of the raster paint path.
"""

"""
Traceability: doc/08_tracking/bug/web_layout_cascade_selector_paint_chrome159_round4_divergences_2026-11-15.md
(2026-11-20: raster window-fixture glass still reads the whole frame).
Chrome pixels: headless Chromium 1255 at 400x300, the same pages as the
cpu_simd spec. Page #1e1e2e with a red bar (0,120 400x60). An outer panel
(10,10 380x280, radius 20) holds an inner panel (20,50 340x200 in it, radius
20); both paint `linear-gradient(rgba(255,255,255,0.08),rgba(255,255,255,0.024))`
over a translucent colour. Probe points (x, y): inner over the bar (200,150),
inner above the bar (200,80), outer only (200,35) and (200,275), outside the
outer box on the bar (4,150, where only the halo paints). The button page adds
a 100x40 `<button>` at (230,180) with `box-shadow: 0 12px 28px
rgba(0,0,0,0.2)`: its face (240,190) and its shadow over the inner glass
(280,235) and (330,235). Text sits at the panels' top-left corners, away from
every probe point.
"""
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_software_pixels
}

val RW_FILTER = "backdrop-filter:blur(24px) saturate(1.7)"
val RW_HALO = "box-shadow:0 0 120px rgba(137,180,250,0.12)"
val RW_WHITE = "rgba(255,255,255,0.72)"
val RW_TITLE = "<div style='color:#cdd6f4;font:13px sans-serif;margin:8px'>Simple Editor</div>"
val RW_STATUS = "<div style='color:#cdd6f4;font:13px sans-serif;margin:8px'>Ready</div>"
val RW_BUTTON = "<button style='position:absolute;left:200px;top:120px;width:100px;height:40px;border:none;border-radius:16px;background:linear-gradient(rgba(255,255,255,0.18),rgba(255,255,255,0.06)),#89b4fa;color:#1e1e2e;font:700 13px sans-serif;box-shadow:0 12px 28px rgba(0,0,0,0.20)'>Run</button>"

fn rw_html(outer_extra: text, outer_bg: text, inner_bg: text, inner_filter: text, outer_content: text, inner_content: text) -> text:
    val grad = "linear-gradient(rgba(255,255,255,0.08),rgba(255,255,255,0.024))"
    "<!DOCTYPE html><html><body style='margin:0;background:#1e1e2e'><div style='position:absolute;left:0;top:120px;width:400px;height:60px;background:#c03020'></div><div style='position:absolute;left:10px;top:10px;width:380px;height:280px;border-radius:20px;background:" + grad + "," + outer_bg + ";" + outer_extra + "'>" + outer_content + "<div style='position:absolute;left:20px;top:50px;width:340px;height:200px;border-radius:20px;background:" + grad + "," + inner_bg + ";" + inner_filter + "'>" + inner_content + "</div></div></body></html>"

# Channel mismatches (beyond +-2) against `want`: x, y, r, g, b per point.
fn rw_mismatches(px: [u32], want: [i32]) -> i32:
    if px.len() < 400 * 300:
        return -1
    var bad = 0
    var i = 0
    while i < want.len():  # cpu-lane-loop-ok: spec probe points; bound want.len() / 5
        val p = px[want[i + 1] * 400 + want[i]]
        var c = 0
        while c < 3:  # cpu-lane-loop-ok: RGB channels of one probe pixel; bound 3
            val d = ((p >> ((16 - c * 8) as u32)) & 0xFFu32) as i32 - want[i + 2 + c]
            if d > 2 or d < -2:
                bad = bad + 1
            c = c + 1
        i = i + 5
    bad

fn rw_render(html: text) -> [u32]:
    simple_web_layout_render_html_software_pixels(html, 400, 300, 600000)

describe "backdrop root glass in the window shape on the raster lane (text and a shadowed button) (Chrome 159)":
    it "text in the translucent glass keeps the backdrop root":
        val html = rw_html(RW_FILTER + ";" + RW_HALO, RW_WHITE, RW_WHITE, RW_FILTER, RW_TITLE, RW_STATUS)
        expect(rw_mismatches(rw_render(html), [200, 150, 253, 250, 249, 200, 80, 252, 251, 252, 200, 35, 197, 197, 203, 200, 275, 194, 194, 201, 4, 150, 188, 55, 43])).to_equal(0)

    it "a shadowed button inside the glass keeps the backdrop root":
        val html = rw_html(RW_FILTER + ";" + RW_HALO, RW_WHITE, RW_WHITE, RW_FILTER, RW_TITLE, RW_STATUS + RW_BUTTON)
        expect(rw_mismatches(rw_render(html), [200, 150, 253, 250, 249, 200, 80, 252, 251, 252, 200, 35, 197, 197, 203, 4, 150, 188, 55, 43, 240, 190, 154, 191, 250, 280, 235, 231, 231, 231, 330, 235, 243, 243, 243])).to_equal(0)

    # The production page's shape: full-viewport `body::before`/`::after`
    # (fixed, z-index 0) and the glass under a `position:relative; z-index:1`
    # wrapper. The pseudos are transparent and the wrapper is not a Backdrop
    # Root, so Chrome paints the same pixels as the first case; the z-0
    # pseudos paint below the z-1 wrapper and must not cost the glass its
    # backdrop root.
    it "z-0 generated full-viewport boxes under a z-1 wrapper keep the backdrop root":
        val base = rw_html(RW_FILTER + ";" + RW_HALO, RW_WHITE, RW_WHITE, RW_FILTER, RW_TITLE, RW_STATUS)
        val html = base.replace("<html><body", "<html><head><style>body::before,body::after{content:'';position:fixed;inset:0;z-index:0}</style></head><body").replace("<div style='position:absolute;left:10px;top:10px", "<div style='position:relative;z-index:1'><div style='position:absolute;left:10px;top:10px").replace("</div></div></body>", "</div></div></div></body>")
        expect(rw_mismatches(rw_render(html), [200, 150, 253, 250, 249, 200, 80, 252, 251, 252, 200, 35, 197, 197, 203, 200, 275, 194, 194, 201, 4, 150, 188, 55, 43])).to_equal(0)

    # A z-0 `body::before` in the glass's own layer precedes it in tree order
    # (though its box is stored after the parsed nodes), so it paints below.
    it "a z-0 body::before in the same layer keeps the backdrop root":
        val base = rw_html(RW_FILTER + ";" + RW_HALO, RW_WHITE, RW_WHITE, RW_FILTER, RW_TITLE, RW_STATUS)
        val html = base.replace("<html><body", "<html><head><style>body::before{content:'';position:fixed;inset:0;z-index:0}</style></head><body")
        expect(rw_mismatches(rw_render(html), [200, 150, 253, 250, 249, 200, 80, 252, 251, 252, 200, 35, 197, 197, 203, 200, 275, 194, 194, 201, 4, 150, 188, 55, 43])).to_equal(0)

    it "control: the same button over an opaque page (shadow falloff alone)":
        val html = "<!DOCTYPE html><html><body style='margin:0;background:#fbfbfb'>" + RW_BUTTON.replace("left:200px;top:120px", "left:230px;top:180px") + "</body></html>"
        expect(rw_mismatches(rw_render(html), [240, 190, 154, 191, 250, 280, 235, 231, 231, 231, 330, 235, 243, 243, 243])).to_equal(0)
