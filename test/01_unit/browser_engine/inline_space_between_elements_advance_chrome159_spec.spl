"""
## Purpose and audience
Purpose: Pin how far a collapsible space between two inline-level boxes moves
the next box, against Chrome 159. Chrome advances exactly one space of the
face (Liberation Sans 16 px: 4.4453 px). Simple advanced 6: the flat fallback
space (5, half the fixed cell) as the lead space, plus a 1 px box that the
`" "` node still kept from before the lead space was charged. On the catalog
forms-media page that pushed `<output>Not exercised</output>` 2 px right of
Chrome (171 against 168.94) after the `<button>`.
Audience: web renderer inline layout maintainers.

Chrome oracle (Chrome for Testing 159.0.8154.6, `--headless=new --disable-gpu
--hide-scrollbars --force-device-scale-factor=1 --window-size=900,400
--dump-dom`, `getBoundingClientRect().x`), page as CAT below, each row an
absolutely placed 800 px block:

| row                                                    | Chrome x  | here |
|--------------------------------------------------------|-----------|------|
| inline-block 120 px, space, `<b id=x>`                 | 124.4531  | 124  |
| `<b>ab</b>`, space, `<b id=x>`                         | 23.1250   | 23   |
| catalog `<button>` (119.4844), newline, `<output id=x>`| 123.9375  | 124  |
| inline-block 20 px, space, inline-block `id=x`         | 24.4531   | 24   |
| leading space, `<b id=x>` (collapses away)             | 0.0000    | 0    |

A run's collapsible edge spaces are exact too: in `Paragraph with
<strong>strong</strong>, <em>emphasis</em>, <code>inline code</code>,
<mark>mark</mark>, and a <a>working anchor</a>.` Chrome puts the five elements
at 112.0625 170.7344 248.1094 362.9688 451.9063; the `, ` runs are 8.89 px
(comma plus space), which rounds to 9 only when rounded as one.
"""

"""
Traceability: REQ-BROWSER-ENGINE-INLINE-WHITESPACE-001 — a collapsible space between inline boxes advances one space of the face, as in Chrome 159.
"""
# @tag: unit, browser_engine, layout, chrome159
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_text.spl 1%
use std.spec.*
use std.io_runtime.{file_exists}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_layout_by_id
}

val SANS: text = "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf"
val CAT: text = "<!doctype html><html><head><style>*{box-sizing:border-box}body{margin:0;font:16px/1.5 sans-serif}.r{position:absolute;left:0;top:0;width:800px}input,select,textarea,button{padding:8px;border:1px solid #94a3b8}</style></head><body><div class=r>"

fn x_of(inner: text) -> text:
    simple_web_layout_debug_layout_by_id(CAT + inner + "</div></body></html>", 900, 400, "x", "x")

describe "a space between inline boxes advances one face space (Chrome 159)":
    it "AC-1: after an inline-block":
        if not file_exists(SANS):
            skip("no Liberation Sans on this host")
            return
        step("Chrome 124.4531")
        expect(x_of("<span style=\"display:inline-block;width:120px\">a</span> <b id=\"x\">N</b>")).to_equal("124")

    it "AC-2: after an inline element":
        if not file_exists(SANS):
            skip("no Liberation Sans on this host")
            return
        step("Chrome 23.1250")
        expect(x_of("<b>ab</b> <b id=\"x\">N</b>")).to_equal("23")

    it "AC-3: the catalog button and output":
        if not file_exists(SANS):
            skip("no Liberation Sans on this host")
            return
        step("Chrome button 119.4844 wide, output at 123.9375")
        expect(x_of("<button type=\"button\">Exercise controls</button>\n      <output id=\"x\">Not exercised</output>")).to_equal("124")

    it "AC-4: between two inline-blocks":
        if not file_exists(SANS):
            skip("no Liberation Sans on this host")
            return
        step("Chrome 24.4531")
        expect(x_of("<span style=\"display:inline-block;width:20px\">a</span> <span id=\"x\" style=\"display:inline-block;width:20px\">b</span>")).to_equal("24")

    it "AC-5: a space that opens the line collapses away":
        step("Chrome 0")
        expect(x_of(" <b id=\"x\">N</b>")).to_equal("0")

    it "AC-6: a run's edge spaces round with the run, not one by one":
        if not file_exists(SANS):
            skip("no Liberation Sans on this host")
            return
        step("Chrome 112.0625 170.7344 248.1094 362.9688 451.9063: `, ` is 4.4453 + 4.4453 = 8.89")
        val html = CAT + "Paragraph with <strong id=\"s1\">strong</strong>, <em id=\"s2\">emphasis</em>, <code id=\"s3\">inline code</code>, <mark id=\"s4\">mark</mark>, and a <a id=\"s5\" href=\"#forms\">working anchor</a>.</div></body></html>"
        var got: [text] = []
        for id in ["s1", "s2", "s3", "s4", "s5"]:
            got.push(simple_web_layout_debug_layout_by_id(html, 900, 400, id, "x"))
        expect(got).to_equal(["112", "171", "248", "363", "452"])
