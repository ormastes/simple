"""
## Purpose and audience
Purpose: Pin that a column flexbox with a definite main size (height, or a
max-/min-height that clamps the content) grows and shrinks its items
(CSS Flexbox 1 §9.7), including the min-content floor of a text item.
Audience: browser-engine flex layout maintainers.

Chrome oracle (Chrome 159, 900x2000, `body{margin:0}`, containers
`display:flex;flex-direction:column;width:100px`, items `width:10px`,
getBoundingClientRect y,height, 2026-11-16):

| container                   | items (y,h)                                             |
|-----------------------------|---------------------------------------------------------|
| `max-height:50px`           | two `height:40px` -> 0,25 / 25,25 (container 0,50)      |
| `height:100px`              | 20px / `flex:1` / 20px -> 50,20 / 70,60 / 130,20        |
| `height:60px`               | `height:10px` grow 1 / grow 3 -> 150,20 / 170,40        |
| `height:50px`               | 40px / 40px `flex-shrink:0` -> 210,10 / 220,40          |
| `height:30px`               | 40px with text `xx` / 40px -> 260,18 / 278,12           |
| `height:50px`               | `flex:1` holding an 80px child -> 290,80 (never below its content) |
| `height:100px`              | `flex:1` holding a 20px child / 10px -> 340,90 / 430,10 |
| `height:50px`               | empty auto div / 40px -> 440,0 / 440,40 (an empty item has no phantom line) |
| `height:60px`, whitespace between items | 10px / `flex:1` -> 490,10 / 500,50     |

Filed as `flex_col_max_h` in
doc/08_tracking/bug/web_layout_cascade_selector_paint_chrome159_round4_divergences_2026-11-15.md.
"""

"""
Traceability: REQ-BROWSER-ENGINE-FLEX-COLUMN-GROW-SHRINK-001 — column flex items grow and shrink in a definite main size.
"""
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_engine.spl 1%
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_layout_by_id
}

val PAGE: text = "<html><head><style>body{{margin:0}} .c{{display:flex;flex-direction:column;width:100px}} .c div{{width:10px}}</style></head><body>" +
    "<div class=c id=c1 style=\"max-height:50px\"><div id=a style=\"height:40px\"></div><div id=b style=\"height:40px\"></div></div>" +
    "<div class=c id=c2 style=\"height:100px\"><div id=h style=\"height:20px\"></div><div id=m style=\"flex:1\"></div><div id=f style=\"height:20px\"></div></div>" +
    "<div class=c id=c3 style=\"height:60px\"><div id=g1 style=\"height:10px;flex-grow:1\"></div><div id=g2 style=\"height:10px;flex-grow:3\"></div></div>" +
    "<div class=c id=c4 style=\"height:50px\"><div id=s1 style=\"height:40px\"></div><div id=s2 style=\"height:40px;flex-shrink:0\"></div></div>" +
    "<div class=c id=c5 style=\"height:30px\"><div id=t1 style=\"height:40px\">xx</div><div id=t2 style=\"height:40px\"></div></div>" +
    "<div class=c style=\"height:50px\"><div id=n1 style=\"flex:1\"><div style=\"height:80px\"></div></div><div id=n2 style=\"height:10px\"></div></div>" +
    "<div class=c style=\"height:100px\"><div id=n3 style=\"flex:1\"><div style=\"height:20px\"></div></div><div id=n4 style=\"height:10px\"></div></div>" +
    "<div class=c style=\"height:50px\"><div id=e1></div><div id=e2 style=\"height:40px\"></div></div>" +
    "<div class=c style=\"height:60px\">\n  <div id=w1 style=\"height:10px\"></div>\n  <div id=w2 style=\"flex:1\"></div>\n</div>" +
    "</body></html>"

fn _yh(id: text) -> text:
    simple_web_layout_debug_layout_by_id(PAGE, 900, 2000, id, "y") + "," +
        simple_web_layout_debug_layout_by_id(PAGE, 900, 2000, id, "h")

describe "column flex grow and shrink":
    it "AC-1: max-height shrinks both items evenly":
        expect(_yh("c1") + " " + _yh("a") + " " + _yh("b")).to_equal("0,50 0,25 25,25")

    it "AC-2: flex:1 fills between a header and a footer":
        expect(_yh("h") + " " + _yh("m") + " " + _yh("f")).to_equal("50,20 70,60 130,20")

    it "AC-3: grow factors split the free space 1:3":
        expect(_yh("g1") + " " + _yh("g2")).to_equal("150,20 170,40")

    it "AC-4: flex-shrink:0 keeps its height":
        expect(_yh("s1") + " " + _yh("s2")).to_equal("210,10 220,40")

    it "AC-5: a text item stops at its one-line height":
        step("Chrome 159: an even share (15) is below the 18px line, so it freezes")
        expect(_yh("t1") + " " + _yh("t2")).to_equal("260,18 278,12")

    it "AC-6: a growing item never ends below its content":
        expect(_yh("n1")).to_equal("290,80")

    it "AC-7: content smaller than the share grows to the share":
        expect(_yh("n3") + " " + _yh("n4")).to_equal("340,90 430,10")

    it "AC-8: an empty auto item adds no phantom base, so nothing shrinks":
        step("y is not pinned: the engine gives an empty block 1px (pre-existing, also on base)")
        expect(simple_web_layout_debug_layout_by_id(PAGE, 900, 2000, "e2", "h")).to_equal("40")

    it "AC-9: whitespace text between items does not shift the grow share":
        expect(_yh("w1") + " " + _yh("w2")).to_equal("490,10 500,50")
