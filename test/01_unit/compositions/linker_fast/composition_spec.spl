use std.spec
use std.spec.step
use compositions.linker_fast.composition.*

describe "fast linker composition":
    it "seals a deterministic critical composition":
        step("Seal the fast linker generation")
        val result = seal_linker_fast_v1(17)
        assert_true(result.status.accepted())
        assert_equal(result.receipt.generation, 17u64)
        assert_equal(result.receipt.capsule_count, 1u32)
        assert_true(result.receipt.total_memory_bytes < LINKER_FAST_MEMORY_BUDGET_BYTES)

    it "declares parallel deterministic completion":
        step("Inspect the admitted capsule contract")
        val capsule = linker_fast_capsule_v1()
        assert_equal(capsule.concurrency.maximum_concurrent_calls, 8u32)
        assert_equal(capsule.concurrency.deterministic_completion, 1u32)
