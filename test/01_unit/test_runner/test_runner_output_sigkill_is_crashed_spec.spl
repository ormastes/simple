# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-TEST_RUNNER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md


# An UNBUDGETED SIGKILL(137) is CRASHED, not TERMINATED.
#
# @req REQ-SSPEC-TEST_RUNNER
#
# earlyoom on this host sends SIGTERM first, so SIGTERM(143) is genuinely
# unattributable and stays UNVERIFIED. A raw SIGKILL is NOT attributable to it
# and is indistinguishable from the compiler dying. Every kill this supervisor
# budgets itself is already classified as TIMEOUT earlier in
# classify_fork_exit (the rt_fork_parent_timed_out() branch), so any SIGKILL
# reaching is_outside_kill is by construction unbudgeted.

use std.spec.step

use std.test_runner.test_runner_fork.{is_outside_kill}

describe "fork exit signal attribution":
    # @manual scenario evidence

    it "does not treat SIGKILL as an outside kill":
        # @req REQ-SSPEC-TEST_RUNNER
        step("does not treat SIGKILL as an outside kill")
        """9 must fall through to the CRASHED branch."""
        assert_false(is_outside_kill(9))

    it "still treats SIGTERM, SIGINT and SIGHUP as outside kills":
        # @req REQ-SSPEC-TEST_RUNNER
        step("still treats SIGTERM, SIGINT and SIGHUP as outside kills")
        assert_true(is_outside_kill(15))
        assert_true(is_outside_kill(2))
        assert_true(is_outside_kill(1))

    it "still treats fault signals as the program's own defect":
        # @req REQ-SSPEC-TEST_RUNNER
        step("still treats fault signals as the program's own defect")
        assert_false(is_outside_kill(11))
        assert_false(is_outside_kill(6))
        assert_false(is_outside_kill(4))
        assert_false(is_outside_kill(7))
        assert_false(is_outside_kill(8))
