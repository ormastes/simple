# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-TEST_RUNNER
# Plan ids: BUG-02 (zero cases is non-passing evidence), T12 (no false green),
# RB-25 truthful verdicts; task 15a of CURRENT_BUG_PREVENTION.md.

"""
Purpose: a spec FILE whose examples ran and exited clean but evaluated ZERO
expectations is VACUOUS -- never a silent pass. std.spec writes the tally to a
sidecar next to the v1 evidence file; the runner reads it fail-closed: absent
or malformed is UNKNOWN (-1), and only an explicit 0 marks a clean result
VACUOUS. Rollout is WARN-FIRST: the `SPEC FILE VACUITY:` line always prints;
the verdict becomes the VACUOUS failure class only under
SIMPLE_TEST_VACUOUS_STRICT=1 and for paths NOT listed in
scripts/check/vacuous_spec_zero_assertion_baseline.txt. The zero-EXAMPLE gates
that already existed (NOT_RUN, --assert-ran) are untouched. The gate is live
only on the pure-Simple runner: the Rust seed evaluates describe/it/expect as
intrinsics and writes no sidecar.
"""

use std.spec
use std.spec.step
use std.nogc_sync_mut.io.file_ops.{file_write, file_delete, file_exists}
use std.nogc_sync_mut.spec.{get_expectation_count, note_expectation}
use std.test_runner.test_executor_parsing.{
    read_structured_test_expectations, vacuous_result_error, vacuous_spec_baselined, _tp_get_temp_dir,
    spec_source_has_raw_assert
}
use std.test_runner.test_runner_output.{test_file_outcome_class, test_file_outcome_tag}
use std.test_runner.test_runner_types.{TestFileResult, test_file_result_outcome_class}

extern fn rt_file_read_text(path: text) -> text?

fn evidence_path(tag: text) -> text:
    _tp_get_temp_dir() + "/vacuous_expectations_" + tag + ".evidence"

fn with_sidecar(tag: text, content: text) -> text:
    val path = evidence_path(tag)
    expect(file_write(path + ".expectations", content)).to_equal(true)
    path

fn cleanup(path: text):
    if file_exists(path + ".expectations"):
        val _ = file_delete(path + ".expectations")

# Shrink-only check for the baseline: an entry is STALE when its file is gone
# or its source now carries an assertion (it must then be deleted from the
# baseline, not kept as a standing exemption). "" = still a valid entry.
fn baseline_entry_problem(source: text?) -> text:
    if source == nil:
        return "missing"
    for line in (source ?? "").split("\n"):
        val stmt = line.trim()
        if stmt.starts_with("#"):
            continue
        if spec_source_has_raw_assert(stmt) or stmt.starts_with("assert_"):
            return "has-assertion"
        for token in ["expect(", "expect_not(", "check(", "check_msg(", "fail(", "fail_test(", "prevent"]:
            if stmt.contains(token):
                return "has-assertion"
    ""

describe "zero-expectation (VACUOUS) gate":
    it "reads an explicit tally from the sidecar and treats everything else as unknown":
        step("absent sidecar -> -1 (unknown), never 0")
        expect(read_structured_test_expectations("")).to_equal(-1)
        expect(read_structured_test_expectations(evidence_path("absent"))).to_equal(-1)
        step("well-formed tallies")
        val zero = with_sidecar("zero", "simple-bdd-expectations-v1\n0\n")
        expect(read_structured_test_expectations(zero)).to_equal(0)
        val many = with_sidecar("many", "simple-bdd-expectations-v1\n42\n")
        expect(read_structured_test_expectations(many)).to_equal(42)
        step("malformed tallies are unknown, not zero")
        val bad_header = with_sidecar("hdr", "simple-bdd-v1\n0\n")
        expect(read_structured_test_expectations(bad_header)).to_equal(-1)
        val bad_number = with_sidecar("num", "simple-bdd-expectations-v1\n-3\n")
        expect(read_structured_test_expectations(bad_number)).to_equal(-1)
        val trailing = with_sidecar("trail", "simple-bdd-expectations-v1\n7\nextra\n")
        expect(read_structured_test_expectations(trailing)).to_equal(-1)
        val padded = with_sidecar("pad", "simple-bdd-expectations-v1\n07\n")
        expect(read_structured_test_expectations(padded)).to_equal(-1)
        for p in [zero, many, bad_header, bad_number, trailing, padded]:
            cleanup(p)

    it "classifies a VACUOUS file result as a failure with its own tag":
        val result = TestFileResult(
            path: "lowering_spec.spl", passed: 4, failed: 1, skipped: 0, pending: 0,
            duration_ms: 1, setup_ms: 0, error: vacuous_result_error(4),
            timed_out: false, cached: false)
        expect(vacuous_result_error(4)).to_equal("VACUOUS: 4 example(s) executed, 0 expectations evaluated")
        expect(test_file_result_outcome_class(result)).to_equal("VACUOUS")
        expect(test_file_outcome_class(result)).to_equal("VACUOUS")
        expect(test_file_outcome_tag(result)).to_equal("VACU")
        expect(result.is_ok()).to_equal(false)

    it "counts assert_*/check helpers as evaluated expectations, so an assert_equal-only spec is NOT vacuous":
        # Review blocker: these helpers used to touch the counter only on
        # FAILURE, which would have made 1,159 assert_*-only spec files read
        # as vacuous. Each passing call must count exactly once.
        val before = get_expectation_count()
        assert_equal(1, 1)
        assert_true(true)
        assert_false(false)
        assert_nil(nil)
        assert_not_nil(0)
        assert_eq("a", "a")
        assert_ne("a", "b")
        assert_not_equal(1, 2)
        assert_contains("abc", "b")
        check(true)
        check_msg(true, "unused")
        val after_helpers = get_expectation_count()
        note_expectation()
        # note_expectation is plain Simple code on every engine: always +1.
        expect(get_expectation_count() - after_helpers).to_equal(1)
        # The 11 helpers above are Simple code on the pure-Simple runner (the
        # engine the gate is live on) but INTRINSICS under the Rust seed
        # (interpreter_call/bdd.rs: "assert_equal" | "assert_eq" | ...), which
        # never reach spec.spl. Measured: delta 0 under the seed. So the
        # dynamic count is asserted only where the helpers actually executed
        # as Simple code; the source pin below holds on both engines.
        if after_helpers > before:
            expect(after_helpers - before).to_equal(11)

    it "pins that every assertion helper counts on ENTRY, not only on failure (source contract)":
        val source = rt_file_read_text("src/lib/nogc_sync_mut/spec.spl") ?? ""
        expect(source.len() > 0).to_equal(true)
        for helper in ["fail_test", "fail", "check", "check_msg", "assert_eq", "assert_ne", "assert_true", "assert_false", "assert_nil", "assert_not_nil", "assert_equal", "assert_not_equal", "assert_contains"]:
            val head = source.index_of("pub fn " + helper + "(") ?? -1
            expect(head >= 0).to_equal(true)
            val body = source.substring(head, head + 200)
            val first_nl = body.index_of("\n") ?? -1
            val first_line = body.substring(first_nl + 1, body.len()).trim()
            expect(first_line.starts_with("note_expectation()")).to_equal(true)
        # expect()/expect_not() count through _stable_expect_helper.
        expect(source).to_contain("fn _stable_expect_helper(value, negated: bool, implicit_error: bool) -> i64:\n    _expectations_evaluated = _expectations_evaluated + 1")

    it "exempts only baselined paths from strict mode":
        expect(vacuous_spec_baselined("test/01_unit/compiler/backend/avx2_cmp_emit_spec.spl")).to_equal(true)
        expect(vacuous_spec_baselined("C:/x/repo/test/01_unit/compiler/backend/avx2_cmp_emit_spec.spl")).to_equal(true)
        expect(vacuous_spec_baselined("test/01_unit/test_runner/test_runner_vacuous_expectations_spec.spl")).to_equal(false)
        expect(vacuous_spec_baselined("")).to_equal(false)

    it "leaves a clean, asserting result OK and a feature-gated skip SKIP":
        val ok = TestFileResult(
            path: "ok_spec.spl", passed: 4, failed: 0, skipped: 0, pending: 0,
            duration_ms: 1, setup_ms: 0, error: "", timed_out: false, cached: false)
        expect(test_file_outcome_tag(ok)).to_equal("PASS")
        var gated = TestFileResult(
            path: "gated_spec.spl", passed: 0, failed: 0, skipped: 3, pending: 0,
            duration_ms: 1, setup_ms: 0, error: "", timed_out: false, cached: false)
        gated.feature_gated = "hwir"
        expect(test_file_outcome_tag(gated)).to_equal("SKIP")

    it "does not treat a raw-assert-only spec as vacuous":
        expect(spec_source_has_raw_assert("it \"x\":\n    assert 1 + 1 == 2\n")).to_equal(true)
        expect(spec_source_has_raw_assert("    assert(ok)\n")).to_equal(true)
        expect(spec_source_has_raw_assert("it \"x\":\n    val assertion = 1\n    # assert nothing\n    print \"assert me\"\n")).to_equal(false)
        expect(spec_source_has_raw_assert("")).to_equal(false)

    it "keeps the baseline shrink-only: every entry exists and still has no assertion":
        step("the classifier rejects a missing file and a file that gained an assertion")
        expect(baseline_entry_problem(nil)).to_equal("missing")
        expect(baseline_entry_problem("it \"x\":\n    expect(1).to_equal(1)\n")).to_equal("has-assertion")
        expect(baseline_entry_problem("it \"x\":\n    assert true\n")).to_equal("has-assertion")
        expect(baseline_entry_problem("# expect(1) in a comment\nit \"x\":\n    print \"ran\"\n")).to_equal("")
        step("no stale entry in the real baseline")
        val baseline = rt_file_read_text("scripts/check/vacuous_spec_zero_assertion_baseline.txt") ?? ""
        var entries = 0
        var stale: [text] = []
        for line in baseline.split("\n"):
            val entry = line.trim()
            if entry == "" or entry.starts_with("#"):
                continue
            entries = entries + 1
            val problem = baseline_entry_problem(rt_file_read_text(entry))
            if problem != "":
                stale.push(entry + " (" + problem + ")")
        expect(entries > 0).to_equal(true)
        expect(stale).to_equal([])
