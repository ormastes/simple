# Unit tests for mode-specific test filtering logic
#
# Subject under test: src/lib/nogc_sync_mut/test_runner/mode_filter.spl

use std.test_runner.mode_filter.{extract_mode_tags, file_mode_matches, file_get_mode_tags}
use std.spec.step
# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/test_runner/mode_filter_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/mode_filter_spec.md
# doc-path: doc/03_plan/sys_test/mode_filter_spec.md
# doc-path: doc/04_architecture/mode_filter_spec.md
# doc-path: doc/05_design/mode_filter_spec_oracles.md
# @manual: primary


describe "extract_mode_tags":
    it "returns empty for no annotations":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: returns empty for no annotations")
        val content = "# just a comment\ndescribe \"foo\":\n    it \"runs\":\n        expect(1).to_equal(1)\n"
        expect(extract_mode_tags(content)).to_equal("")

    it "extracts single mode tag":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: extracts single mode tag")
        val content = "# @mode: interpreter\ndescribe \"foo\":\n    it \"runs\":\n        expect(1).to_equal(1)\n"
        expect(extract_mode_tags(content)).to_equal("interpreter")

    it "extracts multi-mode tag":
        step("Verify: extracts multi-mode tag")
        # @req: REQ-SSPEC-LOCAL-001
        val content = "# @mode: interpreter, native\ndescribe \"foo\":\n    it \"runs\":\n        expect(1).to_equal(1)\n"
        expect(extract_mode_tags(content)).to_equal("interpreter,native")

    it "extracts skip_mode as negated":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: extracts skip_mode as negated")
        val content = "# @skip_mode: native\ndescribe \"foo\":\n    it \"runs\":\n        expect(1).to_equal(1)\n"
        expect(extract_mode_tags(content)).to_equal("!native")

    it "extracts skip_mode with multiple modes":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: extracts skip_mode with multiple modes")
        val content = "# @skip_mode: native, smf\ndescribe \"foo\":\n    it \"runs\":\n        expect(1).to_equal(1)\n"
        expect(extract_mode_tags(content)).to_equal("!native,!smf")

describe "file_mode_matches":
    it "empty tags match everything":
        step("Verify: empty tags match everything")
        # @req: REQ-SSPEC-LOCAL-001
        expect(file_mode_matches("", "interpreter")).to_equal(true)
        expect(file_mode_matches("", "native")).to_equal(true)
        expect(file_mode_matches("", "smf")).to_equal(true)

    it "AllModes always matches":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: AllModes always matches")
        expect(file_mode_matches("interpreter", "all-modes")).to_equal(true)
        expect(file_mode_matches("!native", "all-modes")).to_equal(true)

    it "positive tag matches correct mode":
        step("Verify: positive tag matches correct mode")
        # @req: REQ-SSPEC-LOCAL-001
        expect(file_mode_matches("interpreter", "interpreter")).to_equal(true)
        expect(file_mode_matches("interpreter", "native")).to_equal(false)

    it "multi-positive tags match any listed mode":
        step("Verify: multi-positive tags match any listed mode")
        # @req: REQ-SSPEC-LOCAL-001
        expect(file_mode_matches("interpreter,native", "interpreter")).to_equal(true)
        expect(file_mode_matches("interpreter,native", "native")).to_equal(true)
        expect(file_mode_matches("interpreter,native", "smf")).to_equal(false)

    it "skip tag excludes matching mode":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: skip tag excludes matching mode")
        expect(file_mode_matches("!native", "native")).to_equal(false)
        expect(file_mode_matches("!native", "interpreter")).to_equal(true)
        expect(file_mode_matches("!native", "smf")).to_equal(true)

    it "multiple skip tags exclude all listed":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: multiple skip tags exclude all listed")
        expect(file_mode_matches("!native,!smf", "native")).to_equal(false)
        expect(file_mode_matches("!native,!smf", "smf")).to_equal(false)
        expect(file_mode_matches("!native,!smf", "interpreter")).to_equal(true)

describe "file_get_mode_tags":
    it "returns empty list for no annotations":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: returns empty list for no annotations")
        val content = "# nothing here\n"
        val tags = file_get_mode_tags(content)
        expect(tags.len()).to_equal(0)

    it "extracts mode tags as list":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: extracts mode tags as list")
        val content = "# @mode: interpreter\n"
        val tags = file_get_mode_tags(content)
        expect(tags.len()).to_equal(1)
        expect(tags[0]).to_equal("interpreter")

    it "extracts skip_mode tags with ! prefix":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: extracts skip_mode tags with ! prefix")
        val content = "# @skip_mode: native\n"
        val tags = file_get_mode_tags(content)
        expect(tags.len()).to_equal(1)
        expect(tags[0]).to_equal("!native")
