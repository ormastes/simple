#!/bin/sh
set -eu

# Host-only behavioral CPU regression. Fake tools capture actual QEMU
# arguments and guest probe dispatch; no VM or network is used.
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
script="$root/scripts/check/check-freebsd-bootstrap-qemu.shs"
test_work=$(mktemp -d "${TMPDIR:-/tmp}/simple-freebsd-tcg-isa.XXXXXX")
fake_script_dir=$(mktemp -d "$root/scripts/check/.freebsd-tcg-isa.XXXXXX")
trap 'rm -rf "$test_work" "$fake_script_dir"' EXIT HUP INT TERM

mkdir -p "$test_work/bin" "$test_work/media" "$test_work/runtime"

cat >"$test_work/bin/qemu-img" <<'EOF'
#!/bin/sh
set -eu
case "${1:-}" in
    check) exit 0 ;;
    create)
        output=
        for arg do output=$arg; done
        : >"$output"
        ;;
    resize) : >"$2" ;;
    *) exit 0 ;;
esac
EOF

cat >"$test_work/bin/genisoimage" <<'EOF'
#!/bin/sh
set -eu
output=
while [ "$#" -gt 0 ]; do
    if [ "$1" = "-output" ]; then output=$2; shift 2; else shift; fi
done
[ -n "$output" ]
: >"$output"
EOF

cat >"$test_work/bin/qemu-system-x86_64" <<'EOF'
#!/bin/sh
set -eu
printf '%s\n' "$@" >"$TEST_QEMU_ARGS"
pidfile=
while [ "$#" -gt 0 ]; do
    if [ "$1" = "-pidfile" ]; then pidfile=$2; shift 2; else shift; fi
done
sleep 1 &
echo "$!" >"$pidfile"
EOF

cat >"$test_work/bin/ssh" <<'EOF'
#!/bin/sh
set -eu
command=
for arg do command=$arg; done
case "$command" in
    *'__builtin_cpu_supports'* )
        printf '%s\n' "$command" >"$TEST_CPU_PROBE"
        [ "${TEST_AVX2_AVAILABLE:-1}" = 1 ]
        exit $?
        ;;
    "uname -sr") printf '%s\n' 'FreeBSD 14.4' ;;
    *"command -v clang"*) printf '%s\n' ok ;;
    *"echo 'int main"*) printf '%s\n' ok ;;
    *) exit 0 ;;
esac
EOF

chmod +x "$test_work/bin/"*
cat >"$test_work/bin/uname" <<'EOF'
#!/bin/sh
printf '%s\n' aarch64
EOF
chmod +x "$test_work/bin/uname"
export TEST_QEMU_ARGS="$test_work/qemu.args"
export TEST_CPU_PROBE="$test_work/probe.command"
media="$test_work/media/base.qcow2"
printf 'fake admitted media\n' >"$media"
media_sha=$(sha256sum "$media" | awk '{print $1}')
printf '%s  base.qcow2\n' "$media_sha" >"$media.sha256"
printf 'fake ssh public key\n' >"$test_work/id.pub"
printf 'fake ssh private key\n' >"$test_work/id"

run_wrapper() {
    wrapper=$1
    runtime=$2
    env PATH="$test_work/bin:$PATH" \
        QEMU_VM_PATH="$media" \
        QEMU_CLOUDINIT_ISO="$runtime/nested/cloud-init/seed.iso" \
        QEMU_RUNTIME_DIR="$runtime" QEMU_VM_DIR="$runtime" \
        QEMU_SSH_PUBLIC_KEY="$test_work/id.pub" QEMU_SSH_PRIVATE_KEY="$test_work/id" \
        QEMU_CPUS=16 QEMU_BUILD_JOBS=14 SIMPLE_FREEBSD_SELFHOST_JOBS="${TEST_JOB_OVERRIDE:-}" QEMU_MIN_FREE_GB=0 QEMU_SSH_TIMEOUT=1 QEMU_ROOT_SSH_TIMEOUT=1 \
        QEMU_REMOTE_TIMEOUT=1 QEMU_TRANSFER_TIMEOUT=1 QEMU_BOOTSTRAP_TIMEOUT=1 \
        QEMU_SMOKE_TIMEOUT=1 QEMU_FULL_TIMEOUT=1 sh "$wrapper" --smoke
}

# Test the historical CPU selection through the actual launch arguments.
pre_fix="$fake_script_dir/check-freebsd-bootstrap-qemu-pre-fix.shs"
sed 's/CPU_MODEL="max"/CPU_MODEL="qemu64"/' "$script" |
    sed "s|^ROOT_DIR=.*|ROOT_DIR=\"$root\"|" >"$pre_fix"
run_wrapper "$pre_fix" "$test_work/runtime/pre-fix" >"$test_work/red.log" 2>&1 || { cat "$test_work/red.log"; exit 1; }
if grep -qx max "$TEST_QEMU_ARGS"; then
    printf '%s\n' 'FAIL: pre-fix CPU selection unexpectedly passed' >&2
    exit 1
fi
grep -qx qemu64 "$TEST_QEMU_ARGS"
printf '%s\n' 'RED: historical wrapper launches qemu64 without AVX2'

run_wrapper "$script" "$test_work/runtime/fixed" >"$test_work/green.log" 2>&1
grep -q "16 vCPUs, .*14 jobs" "$test_work/green.log"
grep -qx max "$TEST_QEMU_ARGS"
grep -qx 'accel=tcg' "$TEST_QEMU_ARGS"
grep -qx 16 "$TEST_QEMU_ARGS"
grep -q '__builtin_cpu_supports("avx2")' "$TEST_CPU_PROBE"
grep -q -- '-march=x86-64' "$TEST_CPU_PROBE"

# An old KVM host or incomplete TCG build must fail before bootstrap.
export TEST_AVX2_AVAILABLE=0 TEST_JOB_OVERRIDE=3
if run_wrapper "$script" "$test_work/runtime/no-avx2" >"$test_work/no-avx2.log" 2>&1; then
    printf '%s\n' 'FAIL: guest without AVX2 admitted' >&2
    exit 1
fi
grep -q "16 vCPUs, .*3 jobs" "$test_work/no-avx2.log"
grep -q 'Guest AVX2 execution support is required' "$test_work/no-avx2.log"
printf '%s\n' 'GREEN: TCG max, 16 vCPUs, guest probe, unsupported-guest rejection'
