use std.spec.*

# Purpose and audience: executable spec of statement-leading `-` layout for the
# language/compiler engineering team.
# Audience: compiler maintainers verifying that a statement that BEGINS with a
# unary minus at the same indentation is its own statement, not a continuation
# of the physical line above it.
# Scope: the value of a function/branch whose LAST statement starts with `-`.
# Out of scope: unary `+` in the same position (the parser rejects `+7` as a
# statement outright — a loud error, not the silent mis-parse guarded here);
# operator precedence generally; the JIT lane (see NON-VACUITY below).
# @req REQ-SSPEC-COMPILER
#
"""Statement-leading `-` starts a new statement instead of gluing to the line above."""
#
# Regression guard for
# doc/08_tracking/bug/if_chain_last_arm_returns_previous_value_2026-07-28.md
#
# The defect: a statement beginning with `-` at the same indent as the previous
# statement was silently glued to it, so
#
#     fn f() -> i64:
#         15
#         -1
#
# parsed as the single expression `15 - 1` and returned 14 instead of -1. It is
# a layout/parse defect, so it is engine-independent and a spec CAN observe it.
#
# NON-VACUITY (demonstrated, not claimed): the same source was run through two
# binaries on 2026-09-02.
#   - deployed seed of 2026-07-25 (pre-fix):  minus_last=14   nested_if=7
#   - seed built from origin/main 1b76db1d6c3: minus_last=-1  nested_if=-3
# So these assertions genuinely discriminate; they are not tautologies.
#
# CLASS COVERAGE: the same shape is checked in three positions, because the
# glue was a lexer/layout behaviour and not specific to a function tail —
# a function's last statement, an `if` arm's last statement, and a
# non-final position (the control, which was never affected).

fn minus_last() -> i64:
    15
    -1

fn minus_middle() -> i64:
    val a = 15
    -1
    99

fn nested_if(x: i64) -> i64:
    if x > 0:
        10
        -3
    else:
        0

describe "statement-leading minus":
    it "is its own statement as a function's last statement":
        expect(minus_last()).to_equal(-1)

    it "is its own statement as an if-arm's last statement":
        expect(nested_if(1)).to_equal(-3)

    it "does not disturb a non-final statement (control)":
        expect(minus_middle()).to_equal(99)
