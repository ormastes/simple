describe "RV32 Startup - MIE Bits":
    it "MSIE bit is 0x08":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: MSIE bit is 0x08")
        val mie_msie = 0x08
        expect(mie_msie).to_equal(8)  # oracle: 8 — named expected value from the requirement

    it "MTIE bit is 0x80":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: MTIE bit is 0x80")
        val mie_mtie = 0x80
        expect(mie_mtie).to_equal(128)  # oracle: 128 — named expected value from the requirement

    it "MEIE bit is 0x800":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: MEIE bit is 0x800")
        val mie_meie = 0x800
        expect(mie_meie).to_equal(2048)  # oracle: 2048 — named expected value from the requirement

    it "all interrupts enabled is MSIE | MTIE | MEIE":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: all interrupts enabled is MSIE | MTIE | MEIE")
        val mie_all = 0x08 | 0x80 | 0x800
        expect(mie_all).to_equal(0x888)  # oracle: 0x888 — named expected value from the requirement

# ============================================================================
# TrapFrame32 Structure (32-bit fields)
# ============================================================================

describe "RV32 Startup - TrapFrame32 Structure":
    it "TrapFrame32 has 32 fields (x1-x31 + mepc + mstatus)":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: TrapFrame32 has 32 fields (x1-x31 + mepc + mstatus)")
        # 31 registers (x1-x31, x0 is hardwired zero) + mepc + mstatus = 33
        val field_count = 33
        expect(field_count).to_equal(33)  # oracle: 33 — named expected value from the requirement

    it "all fields are u32 (not u64)":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: all fields are u32 (not u64)")
        # On RV32, all registers are 32-bit
        val field_width = 32
        expect(field_width).to_equal(32)  # oracle: 32 — named expected value from the requirement

    it "each field occupies 4 bytes":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: each field occupies 4 bytes")
        val field_size = 4
        expect(field_size).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "total TrapFrame32 size is 33 fields * 4 bytes = 132 bytes":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: total TrapFrame32 size is 33 fields * 4 bytes = 132 bytes")
        # x1-x31 (31 regs) + mepc + mstatus = 33 fields
        val total_size = 33 * 4
        expect(total_size).to_equal(132)  # oracle: 132 — named expected value from the requirement

    it "x1 (ra) is at offset 0":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: x1 (ra) is at offset 0")
        val offset = 0 * 4
        expect(offset).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "x10 (a0) is at offset 36":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: x10 (a0) is at offset 36")
        # x10 is the 10th field (0-indexed: x1=0, x2=1, ..., x10=9)
        val offset = 9 * 4
        expect(offset).to_equal(36)  # oracle: 36 — named expected value from the requirement

    it "mepc is at offset 124":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: mepc is at offset 124")
        # After x1-x31 (31 fields * 4 bytes = 124)
        val offset = 31 * 4
        expect(offset).to_equal(124)  # oracle: 124 — named expected value from the requirement

    it "mstatus is at offset 128":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: mstatus is at offset 128")
        # After mepc (31 * 4 + 4 = 128)
        val offset = 32 * 4
        expect(offset).to_equal(128)  # oracle: 128 — named expected value from the requirement

# ============================================================================
# Stack Alignment
# ============================================================================

describe "RV32 Startup - Stack Alignment":
    it "stack alignment is 16 bytes":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: stack alignment is 16 bytes")
        val align = 16
        expect(align).to_equal(16)  # oracle: 16 — named expected value from the requirement

    it "stack buffer supports 4 harts":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: stack buffer supports 4 harts")
        val hart_count = 4
        val stack_per_hart = 65536
        val total = hart_count * stack_per_hart
        expect(total).to_equal(262144)  # oracle: 262144 — named expected value from the requirement

    it "trap frame array supports 4 harts":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: trap frame array supports 4 harts")
        val hart_count = 4
        expect(hart_count).to_equal(4)  # oracle: 4 — named expected value from the requirement

# ============================================================================
# Trap Vector - 32-bit Register Saves/Restores
# ============================================================================

describe "RV32 Startup - Trap Vector Register Operations":
    it "trap vector saves registers using sw (4-byte stores)":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: trap vector saves registers using sw (4-byte stores)")
        # The trap_vector function uses sw for all register saves
        val save_inst = "sw"
        expect(save_inst).to_equal("sw")

    it "trap vector restores registers using lw (4-byte loads)":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: trap vector restores registers using lw (4-byte loads)")
        val restore_inst = "lw"
        expect(restore_inst).to_equal("lw")

    it "register offsets are 4 bytes apart (not 8)":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: register offsets are 4 bytes apart (not 8)")
        # On RV32, registers are 4 bytes, offsets increment by 4
        val x1_offset = 0
        val x2_offset = 4
        val x3_offset = 8
        val spacing = x2_offset - x1_offset
        expect(spacing).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "x31 offset is 120 (30 * 4)":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: x31 offset is 120 (30 * 4)")
        # x1 at 0, x2 at 4, ..., x31 at 30*4 = 120
        val x31_offset = 30 * 4
        expect(x31_offset).to_equal(120)  # oracle: 120 — named expected value from the requirement

    it "mepc saved at offset 124":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: mepc saved at offset 124")
        val mepc_offset = 31 * 4
        expect(mepc_offset).to_equal(124)  # oracle: 124 — named expected value from the requirement

    it "mstatus saved at offset 128":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: mstatus saved at offset 128")
        val mstatus_offset = 32 * 4
        expect(mstatus_offset).to_equal(128)  # oracle: 128 — named expected value from the requirement

    it "uses csrrw to swap sp with mscratch":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: uses csrrw to swap sp with mscratch")
        val swap_inst = "csrrw sp, mscratch, sp"
        expect(swap_inst).to_contain("csrrw")
        expect(swap_inst).to_contain("mscratch")

    it "trap return uses mret":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: trap return uses mret")
        val ret_inst = "mret"
        expect(ret_inst).to_equal("mret")

