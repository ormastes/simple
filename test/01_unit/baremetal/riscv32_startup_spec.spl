describe "RV32 Startup - MSTATUS Bits":
    it "MIE bit is 0x08 (bit 3)":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: MIE bit is 0x08 (bit 3)")
        val mstatus_mie = 0x08
        expect(mstatus_mie).to_equal(8)  # oracle: 8 — named expected value from the requirement

    it "MPIE bit is 0x80 (bit 7)":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: MPIE bit is 0x80 (bit 7)")
        val mstatus_mpie = 0x80
        expect(mstatus_mpie).to_equal(128)  # oracle: 128 — named expected value from the requirement

