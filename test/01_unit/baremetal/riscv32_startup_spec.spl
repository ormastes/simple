# @req: REQ-GEN-BAREMETAL-001

# @platform: baremetal(riscv32)
# RISC-V 32-bit Baremetal Startup Unit Tests
#
# Tests for RV32 startup code: TrapFrame32 structure, memory constants,
# UART configuration, CSR addresses, interrupt handling, and stack setup.

# ============================================================================
# Memory Configuration Constants
# ============================================================================

use std.spec.step

describe "RV32 Startup - Memory Configuration":
    it "RAM base address is 0x80000000":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: RAM base address is 0x80000000")
        val ram_base = 0x80000000
        expect(ram_base).to_equal(0x80000000)  # oracle: 0x80000000 — named expected value from the requirement

    it "RAM size is 128MB":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: RAM size is 128MB")
        val ram_size = 128 * 1024 * 1024
        expect(ram_size).to_equal(134217728)  # oracle: 134217728 — named expected value from the requirement

    it "stack size is 64KB per hart":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: stack size is 64KB per hart")
        val stack_size = 65536
        expect(stack_size).to_equal(65536)  # oracle: 65536 — named expected value from the requirement

