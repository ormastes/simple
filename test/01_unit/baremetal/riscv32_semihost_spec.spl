describe "RV32 Semihost - ADP Constants":
    it "ADP_Stopped_ApplicationExit is 0x20026":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: ADP_Stopped_ApplicationExit is 0x20026")
        val adp_exit = 0x20026
        expect(adp_exit).to_equal(0x20026)  # oracle: 0x20026 — named expected value from the requirement

    it "ADP_Stopped_ApplicationExit in decimal is 131110":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: ADP_Stopped_ApplicationExit in decimal is 131110")
        val adp_exit = 0x20026
        expect(adp_exit).to_equal(131110)  # oracle: 131110 — named expected value from the requirement

# ============================================================================
# QEMU Platform Constants
# ============================================================================

describe "RV32 Semihost - QEMU Platform Constants":
    it "QEMU virt mtime address is 0x0200BFF8":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: QEMU virt mtime address is 0x0200BFF8")
        val mtime_addr = 0x0200BFF8
        expect(mtime_addr).to_equal(0x0200BFF8)  # oracle: 0x0200BFF8 — named expected value from the requirement

    it "QEMU virt mtimecmp address is 0x02004000":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: QEMU virt mtimecmp address is 0x02004000")
        val mtimecmp_addr = 0x02004000
        expect(mtimecmp_addr).to_equal(0x02004000)  # oracle: 0x02004000 — named expected value from the requirement

    it "QEMU virt UART address is 0x10000000":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: QEMU virt UART address is 0x10000000")
        val uart_addr = 0x10000000
        expect(uart_addr).to_equal(0x10000000)  # oracle: 0x10000000 — named expected value from the requirement

    it "mtime address is in CLINT region (0x02000000-0x0200FFFF)":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: mtime address is in CLINT region (0x02000000-0x0200FFFF)")
        val mtime_addr = 0x0200BFF8
        val in_clint = mtime_addr >= 0x02000000 and mtime_addr <= 0x0200FFFF
        expect(in_clint).to_equal(true)

    it "mtimecmp address is in CLINT region":
        # @req: REQ-GEN-BAREMETAL-001
        step("Verify: mtimecmp address is in CLINT region")
        val mtimecmp_addr = 0x02004000
        val in_clint = mtimecmp_addr >= 0x02000000 and mtimecmp_addr <= 0x0200FFFF
        expect(in_clint).to_equal(true)

