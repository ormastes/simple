"""
## Purpose and audience
Purpose: Exercise the REAL `std.gpu.session` GraphicsSession / policy /
capabilities / error modules, replacing a former self-mocking spec that defined
its own local copies of these classes and so could not fail when production
broke.
Audience: GPU session-layer maintainers.
"""
# @req: REQ-LIB-GPU-SESSION-001 — stable requirement identity for this spec.

# @cover src/lib/gc_async_mut/gpu/session/graphics_session.spl 80%
# @tag: unit, gpu, session, lifecycle

"""
# GraphicsSession API — real-module contract

## Overview

This file used to be 520 lines that defined its own `class GraphicsSession`,
`class Caps`, `class LegacyEngine2D` and five more mocks, importing only
`std.io` and `std.spec`. It asserted 21 things about code that lived nowhere
but inside itself, so no production change could ever turn it red. It has been
rewritten to drive the real modules:

  - `src/lib/gc_async_mut/gpu/session/graphics_session.spl`
  - `src/lib/gc_async_mut/gpu/session/graphics_session_policy.spl`
  - `src/lib/gc_async_mut/gpu/session/graphics_capabilities.spl`
  - `src/lib/gc_async_mut/gpu/session/graphics_error.spl`

## What this layer honestly is — read before extending

This is a **pure model**. It binds to no GPU. Two specific honesty limits are
asserted below rather than hidden, so nobody mistakes a green run for device
evidence:

  - `GraphicsCapabilities.probe(backend, arch, bits)` is not a probe. It is a
    string -> flag lookup table (`graphics_capabilities.spl:30-50`) fed the
    caller's own declared policy strings (`graphics_session.spl:33-37`). Ask it
    for "vulkan" on a machine with no Vulkan and it says yes.
  - `GraphicsSession.retain()` fabricates `handle = session_id + 1000`
    (`graphics_session.spl:76`). No device is created and nothing owns 1001.

# TODO: [gpu][P2] The whole src/lib/gc_async_mut/gpu/session/ layer is an
# orphan: `grep -rl 'gpu\.session' src --include='*.spl' | grep -v
# 'gpu/session/'` returns ZERO hits, so nothing outside the directory imports
# it. Live session code is engine2d/vulkan_session.spl and
# engine2d/backend_session.spl. Evidence to close: either a real importer plus
# a real capability query backing GraphicsCapabilities.probe, or deletion of
# the layer. Until then this spec guards a model, not a device.

## Device-free

Every class here is pure data and pure predicates. No extern, no driver, no
device.
"""

use std.spec.{describe, it, expect, assert_true, assert_false}
use std.spec.step
use std.gpu.session.graphics_session.{GraphicsSession}
use std.gpu.session.graphics_session_policy.{GraphicsSessionPolicy}
use std.gpu.session.graphics_capabilities.{GraphicsCapabilities}
use std.gpu.session.graphics_error.{GraphicsError}

describe "GraphicsSessionPolicy constructors":

    it "managed_shared carries shared surfaces and pooled allocation":
        step("Build a managed_shared policy for vulkan and read its fields")
        # @req: REQ-LIB-GPU-SESSION-001
        val p = GraphicsSessionPolicy.managed_shared("vulkan")
        expect(p.mode).to_equal("managed_shared")  # oracle: policy.spl:29
        expect(p.backend_kind).to_equal("vulkan")  # oracle: caller-supplied
        expect(p.surface_policy).to_equal("shared")  # oracle: policy.spl:31
        expect(p.allocator_policy).to_equal("pooled")  # oracle: policy.spl:33
        expect(p.readback_policy).to_equal("allowed")  # oracle: policy.spl:35
        assert_true(p.is_managed())
        assert_false(p.is_perf_exclusive())
        assert_false(p.is_legacy())

    it "perf_exclusive carries exclusive surfaces and restricted readback":
        step("Build a perf_exclusive policy and read the fields that differ")
        # @req: REQ-LIB-GPU-SESSION-001
        val p = GraphicsSessionPolicy.perf_exclusive("metal")
        expect(p.mode).to_equal("perf_exclusive")  # oracle: policy.spl:44
        expect(p.surface_policy).to_equal("exclusive")  # oracle: policy.spl:46
        expect(p.queue_policy).to_equal("dedicated")  # oracle: policy.spl:47
        expect(p.sync_policy).to_equal("manual")  # oracle: policy.spl:49
        expect(p.readback_policy).to_equal("restricted")  # oracle: policy.spl:50
        expect(p.interop_policy).to_equal("disabled")  # oracle: policy.spl:51
        assert_true(p.is_perf_exclusive())
        assert_false(p.is_managed())

    it "legacy_no_session names no backend at all":
        step("Build the legacy policy and confirm every sub-policy is none")
        # @req: REQ-LIB-GPU-SESSION-001
        val p = GraphicsSessionPolicy.legacy_no_session()
        expect(p.mode).to_equal("legacy_no_session")  # oracle: policy.spl:59
        expect(p.backend_kind).to_equal("none")  # oracle: policy.spl:60
        expect(p.surface_policy).to_equal("none")
        expect(p.optimization_policy).to_equal("none")
        assert_true(p.is_legacy())

    it "the three modes are mutually exclusive":
        step("Each policy answers true to exactly one predicate")
        # @req: REQ-LIB-GPU-SESSION-001
        val m = GraphicsSessionPolicy.managed_shared("vulkan")
        val x = GraphicsSessionPolicy.perf_exclusive("vulkan")
        val l = GraphicsSessionPolicy.legacy_no_session()
        assert_false(m.is_perf_exclusive() or m.is_legacy())
        assert_false(x.is_managed() or x.is_legacy())
        assert_false(l.is_managed() or l.is_perf_exclusive())

describe "GraphicsSession lifecycle":

    it "a freshly created session is inactive with no handle":
        step("Create a managed session and inspect its initial state")
        # @req: REQ-LIB-GPU-SESSION-001
        val s = GraphicsSession.create(GraphicsSessionPolicy.managed_shared("vulkan"))
        assert_false(s.is_active())  # oracle: graphics_session.spl:46 active: false
        expect(s.handle).to_equal(0)  # oracle: :45 handle: 0
        expect(s.frame_count).to_equal(0)  # oracle: :45
        expect(s.mode).to_equal("managed_shared")  # oracle: inherited from the policy
        expect(s.backend_kind).to_equal("vulkan")

    it "retain activates the session and returns no error":
        step("Retain a managed session and inspect the result string and state")
        # @req: REQ-LIB-GPU-SESSION-001
        var s = GraphicsSession.create(GraphicsSessionPolicy.managed_shared("vulkan"))
        val err = s.retain()
        expect(err).to_equal("")  # oracle: :77 empty string means success
        assert_true(s.is_active())

    it "retain fabricates handle = session_id + 1000 with no device (honesty pin)":
        step("Read the handle retain() invents; nothing owns this number")
        # @req: REQ-LIB-GPU-SESSION-001
        var s = GraphicsSession.create(GraphicsSessionPolicy.managed_shared("vulkan"))
        expect(s.session_id).to_equal(1)  # oracle: :41 session_id: 1, always
        s.retain()
        expect(s.handle).to_equal(1001)  # oracle: :76 self.session_id + 1000 — FABRICATED
        # See the TODO in this file's header: this is a model, not a device.

    it "retaining an already-active managed session is a no-op, not an error":
        step("Retain twice; the second call reports already_active")
        # @req: REQ-LIB-GPU-SESSION-001
        var s = GraphicsSession.create(GraphicsSessionPolicy.managed_shared("vulkan"))
        s.retain()
        val again = s.retain()
        expect(again).to_equal("already_active")  # oracle: :74
        assert_true(s.is_active())

    it "retaining an active perf_exclusive session is a mode conflict":
        step("Retain a perf session twice; the second must refuse")
        # @req: REQ-LIB-GPU-SESSION-001
        var s = GraphicsSession.create(GraphicsSessionPolicy.perf_exclusive("vulkan"))
        expect(s.retain()).to_equal("")  # oracle: first retain succeeds
        val conflict = s.retain()
        assert_true(conflict.contains("MODE_CONFLICT"))  # oracle: :70-72 mode_conflict
        assert_true(conflict.contains("perf_exclusive"))

    it "release deactivates and drops the handle":
        step("Retain then release; handle must return to 0")
        # @req: REQ-LIB-GPU-SESSION-001
        var s = GraphicsSession.create(GraphicsSessionPolicy.managed_shared("vulkan"))
        s.retain()
        expect(s.release()).to_equal("")  # oracle: :83 success
        assert_false(s.is_active())
        expect(s.handle).to_equal(0)  # oracle: :82 self.handle = 0

    it "releasing an inactive session reports not_active":
        step("Release without retaining")
        # @req: REQ-LIB-GPU-SESSION-001
        var s = GraphicsSession.create(GraphicsSessionPolicy.managed_shared("vulkan"))
        expect(s.release()).to_equal("not_active")  # oracle: :80

    it "create_legacy yields a zero-id, cpu-only, backendless session":
        step("Build the legacy session and inspect its identity")
        # @req: REQ-LIB-GPU-SESSION-001
        val s = GraphicsSession.create_legacy()
        expect(s.session_id).to_equal(0)  # oracle: :53
        expect(s.mode).to_equal("legacy_no_session")  # oracle: :54
        expect(s.backend_kind).to_equal("none")  # oracle: :55
        assert_false(s.is_active())
        assert_false(s.capabilities.supports_vulkan)  # oracle: cpu_only() caps

describe "GraphicsSession frame sequencing":

    it "begin_frame refuses on an inactive session":
        step("Call begin_frame before retaining")
        # @req: REQ-LIB-GPU-SESSION-001
        var s = GraphicsSession.create(GraphicsSessionPolicy.managed_shared("vulkan"))
        expect(s.begin_frame()).to_equal(-1)  # oracle: :91 inactive sentinel

    it "frame ids increase monotonically from 1 while active":
        step("Retain, then begin three frames")
        # @req: REQ-LIB-GPU-SESSION-001
        var s = GraphicsSession.create(GraphicsSessionPolicy.managed_shared("vulkan"))
        s.retain()
        expect(s.begin_frame()).to_equal(1)  # oracle: :92 frame_count + 1
        expect(s.begin_frame()).to_equal(2)
        expect(s.begin_frame()).to_equal(3)
        expect(s.frame_count).to_equal(3)

    it "end_frame accepts the matching id and rejects a stale one":
        step("Begin a frame, end it with the right id, then with a wrong id")
        # @req: REQ-LIB-GPU-SESSION-001
        var s = GraphicsSession.create(GraphicsSessionPolicy.managed_shared("vulkan"))
        s.retain()
        val id = s.begin_frame()
        expect(s.end_frame(id)).to_equal("")  # oracle: :99 matching id succeeds
        val stale = s.end_frame(id - 1)
        assert_true(stale.contains("INVALID_STATE"))  # oracle: :98 frame_id mismatch
        assert_true(stale.contains("frame_id mismatch"))

    it "end_frame refuses on an inactive session":
        step("End a frame after releasing")
        # @req: REQ-LIB-GPU-SESSION-001
        var s = GraphicsSession.create(GraphicsSessionPolicy.managed_shared("vulkan"))
        s.retain()
        val id = s.begin_frame()
        s.release()
        val err = s.end_frame(id)
        assert_true(err.contains("INVALID_STATE"))  # oracle: :96 session not active
        assert_true(err.contains("not active"))

    it "stats reports the live session identity":
        step("Retain, run two frames, read the stats line")
        # @req: REQ-LIB-GPU-SESSION-001
        var s = GraphicsSession.create(GraphicsSessionPolicy.managed_shared("cuda"))
        s.retain()
        s.begin_frame()
        s.begin_frame()
        val stats = s.stats()
        assert_true(stats.contains("session_id=1"))  # oracle: :111
        assert_true(stats.contains("mode=managed_shared"))
        assert_true(stats.contains("backend=cuda"))
        assert_true(stats.contains("frames=2"))
        assert_true(stats.contains("active=true"))

describe "GraphicsCapabilities table (NOT a device probe)":

    it "probe('vulkan') claims vulkan without asking any device":
        step("Ask for vulkan caps; the answer is the caller's own string echoed")
        # @req: REQ-LIB-GPU-SESSION-001
        val c = GraphicsCapabilities.probe("vulkan", "x86_64", 64)
        assert_true(c.supports_vulkan)  # oracle: caps.spl:37 — table lookup, no device
        assert_true(c.has_compute)
        assert_true(c.has_graphics)
        assert_false(c.supports_metal)
        assert_false(c.supports_cuda)

    it "probe('cuda') grants compute but not graphics or present":
        step("Cuda is the one backend the table treats as compute-only")
        # @req: REQ-LIB-GPU-SESSION-001
        val c = GraphicsCapabilities.probe("cuda", "x86_64", 64)
        assert_true(c.supports_cuda)  # oracle: caps.spl:48
        assert_true(c.has_compute)
        assert_false(c.has_graphics)  # oracle: the cuda arm never sets has_graphics
        assert_false(c.has_present)  # oracle: :60 has_present mirrors has_graphics

    it "probe of an unknown backend grants nothing":
        step("A backend name the table does not know yields all-false")
        # @req: REQ-LIB-GPU-SESSION-001
        val c = GraphicsCapabilities.probe("nonexistent-gpu", "x86_64", 64)
        assert_false(c.supports_vulkan)
        assert_false(c.supports_metal)
        assert_false(c.supports_webgpu)
        assert_false(c.supports_cuda)
        assert_false(c.has_compute)  # oracle: no arm matched
        assert_false(c.has_graphics)

    it "cpu_only reports readback but no graphics and no texture budget":
        step("Read the cpu_only constructor's fields")
        # @req: REQ-LIB-GPU-SESSION-001
        val c = GraphicsCapabilities.cpu_only()
        expect(c.backend_kind).to_equal("cpu")  # oracle: caps.spl:74
        expect(c.simd_kind).to_equal("sse2")  # oracle: :77
        expect(c.vector_bits).to_equal(128)  # oracle: :78
        assert_true(c.has_compute)
        assert_false(c.has_graphics)
        assert_true(c.has_readback)
        expect(c.max_texture_size).to_equal(0)  # oracle: :83 no textures on the cpu lane

    it "supports_backend always says yes to cpu, even from a vulkan probe":
        step("The cpu arm of supports_backend is unconditional")
        # @req: REQ-LIB-GPU-SESSION-001
        val c = GraphicsCapabilities.probe("vulkan", "x86_64", 64)
        assert_true(c.supports_backend("cpu"))  # oracle: caps.spl:105 return true
        assert_true(c.supports_backend("vulkan"))
        assert_false(c.supports_backend("metal"))
        assert_false(c.supports_backend("bogus"))  # oracle: :107 default false

    it "summary names the backend, arch and granted feature words":
        step("Read the summary of a vulkan probe")
        # @req: REQ-LIB-GPU-SESSION-001
        val c = GraphicsCapabilities.probe("vulkan", "aarch64", 64)
        val s = c.summary()
        assert_true(s.contains("backend=vulkan"))  # oracle: caps.spl:109
        assert_true(s.contains("arch=aarch64"))
        assert_true(s.contains("bits=64"))
        assert_true(s.contains("compute"))
        assert_true(s.contains("graphics"))
        assert_true(s.contains("present"))

describe "GraphicsError classification":

    it "a mode conflict is recognised and recoverable":
        step("Build a mode_conflict error and read its predicates")
        # @req: REQ-LIB-GPU-SESSION-001
        val e = GraphicsError.mode_conflict("two owners")
        expect(e.code).to_equal("MODE_CONFLICT")  # oracle: error.spl:19
        assert_true(e.is_mode_conflict())
        assert_true(e.is_recoverable())
        expect(e.to_text()).to_equal("[GraphicsError:MODE_CONFLICT] two owners")  # oracle: :49

    it "a lost device is neither a mode conflict nor recoverable":
        step("device_lost is the one error the model refuses to recover from")
        # @req: REQ-LIB-GPU-SESSION-001
        val e = GraphicsError.device_lost("gpu reset")
        expect(e.code).to_equal("DEVICE_LOST")  # oracle: error.spl:22
        assert_false(e.is_mode_conflict())
        assert_false(e.is_recoverable())  # oracle: :38-42 only MODE_CONFLICT/INVALID_STATE

    it "invalid state is recoverable, backend unavailable is not":
        step("Read the remaining two constructors")
        # @req: REQ-LIB-GPU-SESSION-001
        val bad = GraphicsError.invalid_state("no frame open")
        assert_true(bad.is_recoverable())  # oracle: :41
        val gone = GraphicsError.backend_unavailable("webgpu")
        expect(gone.code).to_equal("BACKEND_UNAVAILABLE")  # oracle: :28
        assert_false(gone.is_recoverable())
        assert_true(gone.message.contains("webgpu"))  # oracle: :27 name is interpolated
