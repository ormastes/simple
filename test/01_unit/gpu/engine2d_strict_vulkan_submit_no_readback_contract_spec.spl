"""
## Purpose and audience
Purpose: Prove that strict Vulkan DrawIR submit/readback separation.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-GPU-001 — stable requirement identity for this spec.

# @tag: unit, gpu, vulkan, draw_ir, contract

use std.spec.{describe, it, expect}
use std.io_runtime.file_read
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{engine2d_vulkan_observed_delta, engine2d_vulkan_window_present_fields_valid}

val OWNER = "src/lib/gc_async_mut/gpu/engine2d/draw_ir_adv.spl"

describe "strict Vulkan DrawIR submit/readback separation":
    it "publishes a fail-closed no-readback completion receipt":
        step("Verify: publishes a fail-closed no-readback completion receipt")
        # @req: REQ-GPU-001
        val source = file_read(OWNER)
        expect(source).to_contain(
            "fn engine2d_draw_ir_adv_strict_vulkan_submit_with_images(")
        expect(source).to_contain("struct Engine2dDrawIrAdvSubmitResult:")
        expect(source).to_contain("completion_known: bool")
        expect(source).to_contain("no_readback: bool")
        expect(source).to_contain("readback_bytes: i64")
        expect(source).to_contain(
            "val finalized = if submitted: eng.finalize_compute_frame_no_readback() else: false")
        expect(source).to_contain("val receipt = eng.latest_vulkan_frame_receipt()")
        expect(source).to_contain(
            "submitted and finalized and observed.valid and completion_known and")
        expect(source).to_contain("observed.submit_count")
        expect(source).to_contain("observed.fence_count")

    it "accepts exactly one observed submit and completed fence delta":
        step("Verify: accepts exactly one observed submit and completed fence delta")
        val observed = engine2d_vulkan_observed_delta(17, 23, 18, 24)
        expect(observed.valid).to_be(true)
        expect(observed.submit_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(observed.fence_count).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "rejects a successful backend no-op without observed deltas":
        step("Verify: rejects a successful backend no-op without observed deltas")
        val no_op = engine2d_vulkan_observed_delta(17, 23, 17, 23)
        expect(no_op.valid).to_be(false)
        expect(no_op.submit_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(no_op.fence_count).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "rejects submission without an observed completed fence":
        step("Verify: rejects submission without an observed completed fence")
        val incomplete = engine2d_vulkan_observed_delta(17, 23, 18, 23)
        expect(incomplete.valid).to_be(false)
        expect(incomplete.submit_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(incomplete.fence_count).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "keeps framebuffer transfer outside the submit timing boundary":
        step("Verify: keeps framebuffer transfer outside the submit timing boundary")
        val source = file_read(OWNER)
        expect(source).to_contain(
            "fn engine2d_draw_ir_adv_strict_vulkan_readback(")
        expect(source).to_contain("val readback = eng.read_pixels_with_source()")
        expect(source).to_contain(
            "val submission = engine2d_draw_ir_adv_strict_vulkan_submit_with_images(")
        expect(source).to_contain(
            "var result = engine2d_draw_ir_adv_strict_vulkan_readback(submission)")
        expect(source).to_contain(
            "export engine2d_draw_ir_adv_strict_vulkan_submit_with_images")
        expect(source).to_contain(
            "export engine2d_draw_ir_adv_strict_vulkan_readback")

    it "commits visible presentation through the returned Engine2D owner":
        step("Verify: commits visible presentation through the returned Engine2D owner")
        val source = file_read(OWNER)
        expect(source).to_contain(
            "struct Engine2dDrawIrWindowPresentOwnerResult:")
        expect(source).to_contain(
            "var submission = engine2d_draw_ir_adv_strict_vulkan_submit_with_images(")
        expect(source).to_contain("var eng = submission.engine")
        expect(source).to_contain("present_completed = eng.present_window_device()")
        expect(source).to_contain("submission.engine = eng")
        expect(source).to_contain("submission: Engine2dDrawIrAdvSubmitResult")
        expect(source).to_contain("full_frame_fallback = frame.full_frame_fallback")
        expect(source).to_contain("cpu_fallback_used = frame.cpu_fallback_used")

    it "accepts only completed same-device window presentation fields":
        step("Verify: accepts only completed same-device window presentation fields")
        expect(engine2d_vulkan_window_present_fields_valid(
            true, "window-swapchain", true, true, true, 7, 11, 13,
            false, false, "")).to_be(true)
        expect(engine2d_vulkan_window_present_fields_valid(
            true, "window-swapchain", false, true, true, 7, 11, 13,
            false, false, "")).to_be(false)
        expect(engine2d_vulkan_window_present_fields_valid(
            true, "headless-swapchain", true, true, true, 7, 11, 13,
            false, false, "")).to_be(false)
        expect(engine2d_vulkan_window_present_fields_valid(
            true, "window-swapchain", true, true, true, 7, 11, 0,
            false, false, "")).to_be(false)
        expect(engine2d_vulkan_window_present_fields_valid(
            true, "window-swapchain", true, true, true, 7, 11, 13,
            true, false, "swapchain-image-history-seed")).to_be(false)
        expect(engine2d_vulkan_window_present_fields_valid(
            true, "window-swapchain", true, true, true, 7, 11, 13,
            false, false, "swapchain-suboptimal")).to_be(false)
