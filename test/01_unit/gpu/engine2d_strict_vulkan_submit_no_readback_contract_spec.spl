# @tag: unit, gpu, vulkan, draw_ir, contract

use std.spec.{describe, it, expect}
use std.io_runtime.file_read

val OWNER = "src/lib/gc_async_mut/gpu/engine2d/draw_ir_adv.spl"

describe "strict Vulkan DrawIR submit/readback separation":
    it "publishes a fail-closed no-readback completion receipt":
        val source = file_read(OWNER)
        expect(source).to_contain(
            "fn engine2d_draw_ir_adv_strict_vulkan_submit_with_images(")
        expect(source).to_contain("struct Engine2dDrawIrAdvSubmitResult:")
        expect(source).to_contain("completion_known: bool")
        expect(source).to_contain("no_readback: bool")
        expect(source).to_contain("readback_bytes: i64")
        expect(source).to_contain(
            "val finalized = if submitted: eng.finalize_compute_frame_no_readback() else: false")
        expect(source).to_contain("val receipt = eng.latest_vulkan_frame_receipt()")
        expect(source).to_contain(
            "submitted and finalized and completion_known and")
        expect(source).to_contain("device_submit_count: if completed: 1 else: 0")
        expect(source).to_contain("device_fence_count: if completed: 1 else: 0")

    it "keeps framebuffer transfer outside the submit timing boundary":
        val source = file_read(OWNER)
        expect(source).to_contain(
            "fn engine2d_draw_ir_adv_strict_vulkan_readback(")
        expect(source).to_contain("val readback = eng.read_pixels_with_source()")
        expect(source).to_contain(
            "val submission = engine2d_draw_ir_adv_strict_vulkan_submit_with_images(")
        expect(source).to_contain(
            "var result = engine2d_draw_ir_adv_strict_vulkan_readback(submission)")
        expect(source).to_contain(
            "export engine2d_draw_ir_adv_strict_vulkan_submit_with_images")
        expect(source).to_contain(
            "export engine2d_draw_ir_adv_strict_vulkan_readback")
