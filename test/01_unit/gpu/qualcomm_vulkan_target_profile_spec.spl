"""
## Purpose and audience
Purpose: Prove that Qualcomm Vulkan target profile.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-GPU-001 — stable requirement identity for this spec.

use std.spec.{describe, it, expect}
use std.gpu.engine2d.backend_qualcomm.{
    QualcommBackend,
    qualcomm_supports_target,
    qualcomm_vulkan_profile_key,
    qualcomm_preferred_backend_for_target,
    qualcomm_preferred_workgroup_size,
    qualcomm_subgroup_size
}

describe "Qualcomm Vulkan target profile":
    it "supports ARM64 Vulkan profile":
        step("Verify: supports ARM64 Vulkan profile")
        # @req: REQ-GPU-001
        val supported = qualcomm_supports_target("arm64", 64)
        expect(supported).to_equal(true)

    it "supports ARM32 Vulkan preparation profile":
        step("Verify: supports ARM32 Vulkan preparation profile")
        val supported = qualcomm_supports_target("arm32", 32)
        expect(supported).to_equal(true)

    it "supports mixed ARM32/ARM64 Vulkan preparation profile":
        step("Verify: supports mixed ARM32/ARM64 Vulkan preparation profile")
        val supported = qualcomm_supports_target("arm-mixed", 3264)
        expect(supported).to_equal(true)

    it "rejects unsupported target width":
        step("Verify: rejects unsupported target width")
        val supported = qualcomm_supports_target("arm64", 32)
        expect(supported).to_equal(false)

    it "maps ARM64 profile key":
        step("Verify: maps ARM64 profile key")
        val key = qualcomm_vulkan_profile_key("arm64", 64)
        expect(key).to_equal("qualcomm-adreno:vulkan:arm64")

    it "maps mixed ARM profile key":
        step("Verify: maps mixed ARM profile key")
        val key = qualcomm_vulkan_profile_key("arm-mixed", 3264)
        expect(key).to_equal("qualcomm-adreno:vulkan:arm32+arm64")

    it "prefers Vulkan for supported Qualcomm targets":
        step("Verify: prefers Vulkan for supported Qualcomm targets")
        val backend = qualcomm_preferred_backend_for_target("arm64", 64)
        expect(backend).to_equal("vulkan")

    it "falls back to CPU for unsupported Qualcomm targets":
        step("Verify: falls back to CPU for unsupported Qualcomm targets")
        val backend = qualcomm_preferred_backend_for_target("x86", 64)
        expect(backend).to_equal("cpu")

    it "keeps Adreno workgroup and subgroup tuning consistent":
        step("Verify: keeps Adreno workgroup and subgroup tuning consistent")
        expect(qualcomm_preferred_workgroup_size()).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(qualcomm_subgroup_size()).to_equal(64)  # oracle: 64 — named expected value from the requirement

    it "creates an ARM64 target-profiled backend":
        step("Verify: creates an ARM64 target-profiled backend")
        val backend = QualcommBackend.create_for_target("arm64", 64)
        expect(backend.target_arch()).to_equal("arm64")
        expect(backend.target_bits()).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(backend.mixed_32_64()).to_equal(false)
        expect(backend.target_profile()).to_equal("qualcomm-adreno:vulkan:arm64")

    it "creates a mixed ARM target-profiled backend":
        step("Verify: creates a mixed ARM target-profiled backend")
        val backend = QualcommBackend.create_for_target("arm-mixed", 3264)
        expect(backend.target_arch()).to_equal("arm-mixed")
        expect(backend.target_bits()).to_equal(3264)  # oracle: 3264 — named expected value from the requirement
        expect(backend.mixed_32_64()).to_equal(true)
        expect(backend.target_profile()).to_equal("qualcomm-adreno:vulkan:arm32+arm64")
