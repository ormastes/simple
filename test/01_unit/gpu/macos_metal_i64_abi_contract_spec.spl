use std.spec
use std.fs.{file_read}

describe "macOS Metal runtime status ABI":
    it "decodes the runtime i64 status explicitly instead of relying on bool ABI coercion":
        val source = file_read("src/lib/nogc_sync_mut/io/metal_sffi.spl")
        expect(source).to_contain("extern fn rt_metal_init() -> i64")
        expect(source).to_contain("extern fn rt_metal_is_available() -> i64")
        expect(source).to_contain("rt_metal_init() != 0")
        expect(source).to_contain("rt_metal_is_available() != 0")
