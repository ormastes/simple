# @tag: unit, gpu, metal, macos, contract
#
# Linux-safe contract: exercise only the harness fail-closed branch and pin
# the receipt fields required from the macOS host evidence run.

use std.spec.{describe, it, expect}
use std.io_runtime.{file_read, process_run}

val HARNESS = "scripts/check/check-macos-gpu-2d-live-evidence.shs"

describe "macOS Metal live evidence harness contract":
    it "fails closed off-host and keeps the required receipt contract":
        val (_stdout, stderr, code) = process_run(
            "/bin/sh",
            ["-c", "GPU_2D_LIVE_BACKEND=invalid sh " + HARNESS]
        )
        expect(code).to_be_greater_than(0)
        expect(stderr).to_contain("invalid-backend")

        val harness = file_read(HARNESS)
        expect(harness).to_contain("case \"$BACKEND\" in")
        expect(harness).to_contain("vulkan|metal) ;;")
        expect(harness).to_contain("gpu_2d_live_status")
        expect(harness).to_contain("gpu_2d_live_backend")
        expect(harness).to_contain("gpu_2d_live_source")
        expect(harness).to_contain("device_readback")
        expect(harness).to_contain("gpu_2d_live_width")
        expect(harness).to_contain("gpu_2d_live_height")
        expect(harness).to_contain("gpu_2d_live_dpi")

    it "keeps the emulator-only Vulkan DrawIR lane on the shared differential contract":
        val live_harness = file_read("test/02_integration/rendering/macos_gpu_2d_live_harness.spl")
        val fixture = file_read("test/02_integration/rendering/macos_gpu_2d_draw_ir_event_fixture.spl")
        val differential = file_read("src/lib/nogc_sync_mut/test/differential_conformance.spl")
        val todo_db = file_read("doc/08_tracking/todo/todo_db.sdn")
        expect(live_harness).to_contain("engine2d_draw_ir_adv_composition(")
        expect(live_harness).to_contain("EVENT_SEQUENCE")
        expect(live_harness).to_contain("gpu_2d_live_draw_ir_fallback_required")
        expect(live_harness).to_contain("gpu_2d_live_source=device_readback")
        expect(fixture).to_contain("DrawIrComposition")
        expect(fixture).to_contain("process_event(")
        expect(fixture.contains("Engine2D")).to_equal(false)
        expect(differential).to_contain("macos_emulator_vulkan_draw_ir_environment_profile")
        expect(differential).to_contain("draw_ir:animation_frame")
        expect(differential).to_contain("draw_ir:input_ctrl_alt")
        expect(differential).to_contain("draw_ir:font")
        expect(differential).to_contain("draw_ir:audio")
        expect(differential).to_contain("vulkan_api:device_readback")
        expect(differential).to_contain("vulkan_api:perf_receipt")
        expect(differential).to_contain("macos-vulkan-dynload-oracle")
        expect(todo_db).to_contain("660, TODO, simpleos")
        expect(todo_db).to_contain("Keep macOS lane as emulator-only on this host and fail-closed")
        expect(todo_db).to_contain("661, TODO, simpleos")
        expect(todo_db).to_contain("animation, event handling (mouse/keyboard/ctrl/alt), font rendering, and sound")
