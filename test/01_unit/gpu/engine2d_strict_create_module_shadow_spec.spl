# @cover src/lib/gc_async_mut/gpu/engine2d/engine.spl
# Reproducing spec for
# doc/08_tracking/bug/match_binding_shadowed_by_module_namespace_2026-08-18.md
#
# RED before the fix: Engine2D.create_with_backend_strict("cpu").unwrap() handed
# back the `engine` MODULE NAMESPACE dict instead of the Engine2D, so
#   semantic: method `backend_name` not found on type `dict`
# The factory bound its match arm as `Ok(engine)`, and a pattern binding whose
# name collides with an in-scope module namespace resolves to the namespace.

use std.spec.{describe, it, expect}
use std.gpu.engine2d.engine.{Engine2D}

describe "Engine2D factories return an Engine2D, not a module namespace":

    it "create_with_backend_strict(cpu) unwraps to a usable Engine2D":
        val strict = Engine2D.create_with_backend_strict(16, 16, "cpu")
        expect(strict.is_ok()).to_equal(true)
        var built = strict.unwrap()
        expect(built.backend_name()).to_equal("cpu")
        built.shutdown()

    it "create_with_backend(cpu) returns a usable Engine2D":
        var built = Engine2D.create_with_backend(16, 16, "cpu")
        expect(built.backend_name()).to_equal("cpu")
        built.shutdown()
