"""
## Purpose and audience
Purpose: Exercise the REAL `std.gpu.session.session_api` session lifecycle —
create, retain, release, probe — replacing a former self-mocking spec that
defined its own `SessionHandle`/`SessionPolicy`/`WmSession` classes and whose
only four assertions included a self-referential "the suite passes".
Audience: GPU session-layer maintainers.
"""
# @req: REQ-LIB-GPU-SESSION-SHARE-001 — stable requirement identity for this spec.

# @cover src/lib/gc_async_mut/gpu/session/session_api.spl 90%
# @tag: unit, gpu, session, sharing, lifecycle

"""
# Backend session sharing — real session_api contract

## Overview

This file used to be 257 lines with 22 `fn test_*` helpers driving locally
defined mock classes, funnelled into a `run_suite()` that printed PASS/FAIL
strings. Only **four** `expect` calls existed in the whole file, one of which
asserted that the suite itself had passed. Nothing in production could turn it
red. It now drives:

  - `src/lib/gc_async_mut/gpu/session/session_api.spl`
    (`backend_session_create`/`_retain`/`_release`/`_probe`,
     `GpuSessionProbeResult`)
  - `src/lib/gc_async_mut/gpu/session/session_types.spl`
    (`GpuSessionHandle`, `GpuSessionPolicy`, `GpuSessionError`)

The original subject — that sharing is permitted in managed mode, refused in
perf-exclusive mode, and that release transfers ownership — is preserved and
now asserted against the real functions.

## Honesty note

`backend_session_probe` is **not a device probe**. `GpuSessionProbeResult.create`
(`session_api.spl:26-35`) sets `device_available` and `api_available` to
`GpuSessionHandle.is_valid(h)` — i.e. to whether the *handle struct* is
well-formed — and hardcodes `driver_version: "1.0.0"`. No driver is consulted.
The spec asserts this explicitly rather than letting a green run imply device
evidence. The orphan-layer TODO in
`test/01_unit/gpu/graphics_session_spec.spl` covers the whole directory.

## Device-free

Every function here is a pure value transformation returning new records. No
extern, driver, or device.
"""

use std.spec.{describe, it, expect, assert_true, assert_false}
use std.spec.step
use std.gpu.session.session_types.{GpuSessionHandle, GpuSessionPolicy, GpuSessionError}
use std.gpu.session.session_api.{
    GpuSessionProbeResult,
    next_session_id,
    backend_session_create,
    backend_session_retain,
    backend_session_release,
    backend_session_probe
}

describe "backend_session_create admission":

    it "a managed vulkan session gets an id seeded at 100 plus the ordinal":
        step("Create the first managed session and read its identity")
        # @req: REQ-LIB-GPU-SESSION-SHARE-001
        val h = backend_session_create("vulkan", GpuSessionPolicy.default_managed(), 1)
        assert_true(GpuSessionHandle.is_valid(h))
        expect(h.id).to_equal(101)  # oracle: session_api.spl:56 SESSION_ID_SEED 100 + ordinal 1
        expect(h.kind).to_equal("vulkan")
        expect(h.mode).to_equal("managed_shared")  # oracle: mode copied from the policy
        expect(h.generation).to_equal(1)

    it "distinct ordinals yield distinct session ids":
        step("Create three sessions and confirm no id collides")
        # @req: REQ-LIB-GPU-SESSION-SHARE-001
        val p = GpuSessionPolicy.default_managed()
        expect(backend_session_create("vulkan", p, 1).id).to_equal(101)
        expect(backend_session_create("vulkan", p, 2).id).to_equal(102)
        expect(backend_session_create("vulkan", p, 7).id).to_equal(107)
        expect(next_session_id(100, 42)).to_equal(142)  # oracle: :59 base + ordinal

    it "an empty backend kind is refused with the invalid handle":
        step("Create with no backend name")
        # @req: REQ-LIB-GPU-SESSION-SHARE-001
        val h = backend_session_create("", GpuSessionPolicy.default_managed(), 1)
        assert_false(GpuSessionHandle.is_valid(h))  # oracle: session_api.spl:70-71
        expect(h.id).to_equal(-1)

    it "all three known modes are admitted":
        step("Create one session per mode; each must be valid")
        # @req: REQ-LIB-GPU-SESSION-SHARE-001
        assert_true(GpuSessionHandle.is_valid(
            backend_session_create("cpu", GpuSessionPolicy.legacy_no_session(), 1)))
        assert_true(GpuSessionHandle.is_valid(
            backend_session_create("vulkan", GpuSessionPolicy.default_managed(), 1)))
        assert_true(GpuSessionHandle.is_valid(
            backend_session_create("vulkan", GpuSessionPolicy.perf_exclusive(), 1)))

describe "backend_session_retain enforces mode separation":

    it "a managed session may be shared — retain bumps the generation":
        step("Retain a managed session twice, simulating two surfaces sharing it")
        # @req: REQ-LIB-GPU-SESSION-SHARE-001
        val h0 = backend_session_create("vulkan", GpuSessionPolicy.default_managed(), 1)
        val h1 = backend_session_retain(h0)
        assert_true(GpuSessionHandle.is_valid(h1))
        expect(h1.generation).to_equal(2)  # oracle: session_api.spl:91 increment_generation
        expect(h1.id).to_equal(h0.id)  # oracle: same session, second reference
        val h2 = backend_session_retain(h1)
        expect(h2.generation).to_equal(3)
        expect(h2.id).to_equal(h0.id)

    it "a perf_exclusive session REFUSES to be shared":
        step("Retain a perf-exclusive session; it must yield the invalid handle")
        # @req: REQ-LIB-GPU-SESSION-SHARE-001
        val h0 = backend_session_create("vulkan", GpuSessionPolicy.perf_exclusive(), 1)
        assert_true(GpuSessionHandle.is_valid(h0))  # oracle: creation itself is fine
        val shared = backend_session_retain(h0)
        assert_false(GpuSessionHandle.is_valid(shared))  # oracle: :89-90 perf refuses
        expect(shared.id).to_equal(-1)

    it "a legacy session may still be retained":
        step("Legacy mode is not perf-exclusive, so the retain guard lets it through")
        # @req: REQ-LIB-GPU-SESSION-SHARE-001
        val h0 = backend_session_create("cpu", GpuSessionPolicy.legacy_no_session(), 1)
        val h1 = backend_session_retain(h0)
        assert_true(GpuSessionHandle.is_valid(h1))
        expect(h1.generation).to_equal(2)

    it "retaining an already-invalid handle stays invalid":
        step("A dead handle must not be resurrected by a retain")
        # @req: REQ-LIB-GPU-SESSION-SHARE-001
        val dead = backend_session_retain(GpuSessionHandle.invalid())
        assert_false(GpuSessionHandle.is_valid(dead))  # oracle: :86-87 validity guard first

describe "backend_session_release transfers ownership away":

    it "release invalidates the handle it was given":
        step("Release a live managed session and inspect the returned handle")
        # @req: REQ-LIB-GPU-SESSION-SHARE-001
        val h = backend_session_create("vulkan", GpuSessionPolicy.default_managed(), 1)
        assert_true(GpuSessionHandle.is_valid(h))
        val released = backend_session_release(h)
        assert_false(GpuSessionHandle.is_valid(released))  # oracle: :101 returns invalid()
        expect(released.id).to_equal(-1)
        expect(released.kind).to_equal("")

    it "release of an already-invalid handle is idempotent":
        step("Release twice; the second must not error or revive anything")
        # @req: REQ-LIB-GPU-SESSION-SHARE-001
        val h = backend_session_create("cpu", GpuSessionPolicy.legacy_no_session(), 1)
        val once = backend_session_release(h)
        val twice = backend_session_release(once)
        assert_false(GpuSessionHandle.is_valid(twice))
        expect(twice.id).to_equal(-1)

    it "release does not mutate the caller's original handle value":
        step("session_api returns new values; the input handle is untouched")
        # @req: REQ-LIB-GPU-SESSION-SHARE-001
        val h = backend_session_create("vulkan", GpuSessionPolicy.default_managed(), 1)
        backend_session_release(h)
        assert_true(GpuSessionHandle.is_valid(h))  # oracle: module docstring — no mutating self
        expect(h.id).to_equal(101)

describe "backend_session_probe reports handle shape, NOT device truth":

    it "a valid handle probes ready with a hardcoded driver version":
        step("Probe a live managed session and read every field")
        # @req: REQ-LIB-GPU-SESSION-SHARE-001
        val h = backend_session_create("vulkan", GpuSessionPolicy.default_managed(), 1)
        val pr = backend_session_probe(h)
        assert_true(GpuSessionProbeResult.is_ready(pr))  # oracle: :50 device and api available
        expect(pr.session_id).to_equal(101)
        expect(pr.kind).to_equal("vulkan")
        expect(pr.mode).to_equal("managed_shared")
        expect(pr.driver_version).to_equal("1.0.0")  # oracle: :32 HARDCODED — no driver asked
        assert_false(GpuSessionError.is_error(pr.error))  # oracle: :33 error none()

    it "availability tracks handle well-formedness, not any device (honesty pin)":
        step("The probe of a struct-valid handle claims a device on any machine")
        # @req: REQ-LIB-GPU-SESSION-SHARE-001
        # This spec runs on hosts with no Vulkan at all and still gets true.
        val h = backend_session_create("vulkan", GpuSessionPolicy.default_managed(), 1)
        val pr = backend_session_probe(h)
        assert_true(pr.device_available)  # oracle: :26-27 avail = is_valid(handle)
        assert_true(pr.api_available)  # oracle: same source — one boolean, reported twice
        # See this file's header: not device evidence.

    it "probing a released handle reports unavailable with a typed error":
        step("Release, then probe the dead handle")
        # @req: REQ-LIB-GPU-SESSION-SHARE-001
        val h = backend_session_create("vulkan", GpuSessionPolicy.default_managed(), 1)
        val released = backend_session_release(h)
        val pr = backend_session_probe(released)
        assert_false(GpuSessionProbeResult.is_ready(pr))  # oracle: :106-107 unavailable path
        expect(pr.session_id).to_equal(-1)  # oracle: :40
        expect(pr.driver_version).to_equal("")  # oracle: :44 no version on the failure path
        assert_true(GpuSessionError.is_error(pr.error))
        expect(pr.error.code).to_equal("BACKEND_UNAVAILABLE")  # oracle: session_types.spl:177

    it "probing a refused perf-exclusive share reports unavailable":
        step("Retain a perf session (refused), then probe what came back")
        # @req: REQ-LIB-GPU-SESSION-SHARE-001
        val h = backend_session_create("vulkan", GpuSessionPolicy.perf_exclusive(), 1)
        val refused = backend_session_retain(h)
        val pr = backend_session_probe(refused)
        assert_false(GpuSessionProbeResult.is_ready(pr))
        assert_true(GpuSessionError.is_error(pr.error))
        assert_true(GpuSessionError.to_text(pr.error).contains("BACKEND_UNAVAILABLE"))

    it "the no-error value renders as ok, an error renders with its code":
        step("Contrast the two GpuSessionError rendering paths")
        # @req: REQ-LIB-GPU-SESSION-SHARE-001
        expect(GpuSessionError.to_text(GpuSessionError.none())).to_equal("ok")  # oracle: :184
        val conflict = GpuSessionError.mode_conflict("two owners")
        assert_true(GpuSessionError.is_error(conflict))
        expect(GpuSessionError.to_text(conflict)).to_equal(
            "[SessionError:MODE_CONFLICT] two owners")  # oracle: :186
