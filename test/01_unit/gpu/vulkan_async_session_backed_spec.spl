# Purpose and audience: executable specification evidence for the seed and Vulkan runtime owners.
# @req REQ-SSPEC-GPU
#
# Device-free contract spec for the Vulkan async submission ring externs.
#
# Bug: doc/08_tracking/bug/
# vulkan_no_wait_pending_submission_blocks_followup_compute_2026-09-09.md
#
# The interpreter has no handler of its own for `rt_vulkan_async_session_*`:
# it resolves them in the running seed with dlsym(RTLD_DEFAULT)
# (interpreter_extern/vulkan.rs). A seed linked without --export-dynamic has an
# empty dynamic symbol table, and every call then dies with "Vulkan runtime
# entry point ... is not linked into this binary" before the ring can even
# report whether it is supported. Measured on a Linux aarch64 seed built from
# the tracked cargo config on 2026-11-13.
#
# What this CAN prove without a GPU: the externs are reachable and answer the
# documented concrete values for "no session".
# What it CANNOT prove: any ring behaviour on a device. That is
# test/02_integration/gpu_lane/vulkan_async_ring_live_device_spec.spl.

use std.spec.step

use std.spipe.*
use std.nogc_sync_mut.gpu.engine2d.sffi_vulkan.{
    vulkan_sffi_async_session_supported, vulkan_sffi_async_session_acquire,
    vulkan_sffi_async_session_in_flight}

describe "rt_vulkan_async_session device-free contract":
    it "should answer the capability query with a concrete 0 or 1":
        step("Ask whether this seed carries the runtime ring")
        val supported = vulkan_sffi_async_session_supported()
        assert_true(supported == 0 or supported == 1)

    it "should refuse the null session instead of fabricating a token":
        step("Acquire from session handle 0")
        expect(vulkan_sffi_async_session_acquire(0)).to_equal(-1)

        step("An unknown session reports the -1 sentinel, not a count")
        expect(vulkan_sffi_async_session_in_flight(0)).to_equal(-1)
