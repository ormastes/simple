#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
HARNESS="$ROOT/test/perf/webserver/live_static_compare.py"
WRAPPER="$ROOT/test/05_perf/webserver/live_static_compare.shs"

grep -Fq 'pattern = ("simple", "nginx", "nginx", "simple")' "$HARNESS"
grep -Fq 'len(successes) * 1_000_000_000' "$HARNESS"
grep -Fq 'simple_nginx_payload_mismatch' "$HARNESS"
grep -Fq 'paired_simple_nginx_targets_required' "$HARNESS"
grep -Fq 'body_sha256' "$HARNESS"
grep -Fq 'exec python3 "$ROOT/test/perf/webserver/live_static_compare.py" "$@"' "$WRAPPER"

if python3 "$HARNESS" --samples 6 --probe >/dev/null 2>&1; then
    echo "FAIL: incomplete ABBA sample block was accepted" >&2
    exit 1
fi
python3 "$HARNESS" --samples 4 --probe >/dev/null
python3 "$HARNESS" --samples 8 --probe >/dev/null
echo "PASS: live static comparison requires complete ABBA blocks"
