use std.spec
use std.io_runtime.{file_read}

describe "GUI retained 8K target budget contract":
    it "bounds all retained Engine2D targets to one 8K surface":
        val source = file_read("src/lib/gc_async_mut/ui/gui_content_renderer.spl")
        expect(source).to_contain("GUI_CONTENT_TARGET_PIXEL_BUDGET: i64 = 7680 * 4320")
        expect(source).to_contain("_gui_content_target_live_pixels() + required_pixels")
        expect(source).to_contain("_gui_content_target_oldest_valid()")
        expect(source).to_contain("_gui_content_target_evict(oldest)")

    it "retires stale resized surfaces and declines oversized target entries":
        val source = file_read("src/lib/gc_async_mut/ui/gui_content_renderer.spl")
        expect(source).to_contain("_gui_content_target_evict_other_sizes(")
        expect(source).to_contain("required_pixels > GUI_CONTENT_TARGET_PIXEL_BUDGET")
        expect(source).to_contain("retired.engine.shutdown()")
        expect(source).to_contain("gui_content_frame_cache_pixels")

    it "retains FULL frames and crosses pixels to the WM boundary once per render":
        val source = file_read("src/lib/gc_async_mut/ui/gui_content_renderer.spl")
        expect(source).to_contain("rendered.retained_engine != nil")
        expect(source).to_contain("target.engine = rendered.retained_engine.unwrap()")
        expect(source).to_contain("target.engine.read_pixels(), scene_revision")
        # LOCAL uses the canonical clipped retained executor; resource-bearing
        # frames deliberately retain the complete transient composition API.
        expect(source).to_contain(
            "engine2d_draw_ir_render_composition_damage_with_images(")
        expect(source).to_contain(
            "# Oversized/non-cacheable content has no persistent owner.")
