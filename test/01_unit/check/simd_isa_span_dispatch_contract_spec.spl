use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "SIMD ISA fill-span production contract":
    it "uses the in-place span ABI without allocating a temporary fill row":
        val provider = file_read(
            "src/lib/nogc_sync_mut/gpu/engine2d/simd_isa_provider.spl")
        expect(provider).to_contain("rt_engine2d_simd_fill_span_u32")
        expect(provider).to_contain(
            "val filled = rt_engine2d_simd_fill_span_u32(dst, offset, count")
        expect(provider).to_contain("if filled.len() != dst.len()")
        expect(provider).to_contain("while i < count:")
        expect(provider.contains("engine2d_simd_fill_row_u32(count")).to_equal(false)

    it "keeps the software production fill route behind the real batch dispatcher":
        val backend = file_read(
            "src/lib/gc_async_mut/gpu/engine2d/backend_software.spl")
        expect(backend).to_contain("simd_span_batch_execute(batch, self.buf")
        expect(backend).to_contain("rt_engine2d_simd_fill_span_u32(self.buf")

    it "routes admitted blend slots through in-place span kernels":
        val provider = file_read(
            "src/lib/nogc_sync_mut/gpu/engine2d/simd_isa_provider.spl")
        expect(provider).to_contain(
            "simd_isa_blend_const_span(dst, dst_off, count, batch.colours[idx])")
        expect(provider).to_contain(
            "simd_isa_blend_span(dst, dst_off, src, src_off, count)")
        expect(provider.contains(
            "simd_isa_src_over_const(dst, dst_off, count, batch.colours[idx])")).to_equal(false)
        expect(provider.contains(
            "simd_isa_src_over_image(dst, dst_off, src, src_off, count)")).to_equal(false)
