use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "Vulkan Engine2D canonical swapchain bridge":
    it "adopts one presentation device before legacy resources exist":
        val core = file_read(
            "src/compiler_rust/runtime/src/vulkan_graphics_runtime_core.rs")
        val bridge = file_read(
            "src/compiler_rust/runtime/src/value/gpu_vulkan/vulkan_sffi/swapchain.rs")

        expect(core).to_contain("pub(crate) fn adopt_canonical_device")
        expect(core).to_contain("if state.has_device_resources()")
        expect(core).to_contain("Arc::ptr_eq(current, &device)")
        expect(bridge).to_contain("rt_vk_engine2d_adopt_device")

    it "copies the legacy framebuffer on-device and queue-presents it":
        val swapchain = file_read(
            "src/compiler_rust/runtime/src/vulkan/swapchain.rs")
        val bridge = file_read(
            "src/compiler_rust/runtime/src/value/gpu_vulkan/vulkan_sffi/swapchain.rs")

        expect(swapchain).to_contain("vk::ImageUsageFlags::TRANSFER_DST")
        expect(swapchain).to_contain("vk::ImageLayout::TRANSFER_DST_OPTIMAL")
        expect(swapchain).to_contain("cmd_copy_buffer_to_image")
        expect(swapchain).to_contain("vk::ImageLayout::PRESENT_SRC_KHR")
        expect(swapchain).to_contain("self.present(image_index, &[])")
        expect(bridge).to_contain(
            "rt_vk_swapchain_copy_engine2d_buffer_and_present")
        expect(bridge).to_contain(
            "crate::vulkan_graphics_runtime::engine2d_buffer")
        expect(bridge.contains("download")).to_equal(false)

    it "uses valid acquisition synchronization and tracks image initialization":
        val swapchain = file_read(
            "src/compiler_rust/runtime/src/vulkan/swapchain.rs")

        expect(swapchain).to_contain("Some(Fence::new")
        expect(swapchain).to_contain("fence.wait(timeout_ns)?")
        expect(swapchain).to_contain("image_initialized: Vec<bool>")
        expect(swapchain).to_contain(
            "self.image_initialized[image_index as usize] = true")

    it "owns production window lifecycle and presents showcase output":
        val bridge = file_read(
            "src/compiler_rust/runtime/src/value/gpu_vulkan/vulkan_sffi/swapchain.rs")
        val host = file_read(
            "src/app/ui_showcase/hosts/host_2d_vulkan.spl")

        expect(bridge).to_contain("rt_vk_engine2d_presenter_create")
        expect(bridge).to_contain("rt_vk_engine2d_presenter_present")
        expect(bridge).to_contain("rt_vk_engine2d_presenter_destroy")
        expect(bridge).to_contain("acquire_next_image(None, u64::MAX)")
        expect(bridge).to_contain("let (image_index, _suboptimal)")
        expect(bridge.contains("if suboptimal {\n            return 1;")).to_equal(false)
        expect(host).to_contain("VulkanEngine2dPresenter.open(w, h)")
        expect(host).to_contain("self.presenter.present(result.backend_handle)")
        expect(host).to_contain("present_mode=swapchain device_present=true")
