use std.spec
use std.io_runtime.{file_read}

describe "Web 8K retained surface payload contract":
    it "keeps scalar surface validity separate from optional pixel result payload":
        val source = file_read("src/os/compositor/compositor_engine2d.spl")
        expect(source).to_contain("_ENGINE2D_REVISION_CACHE_RESULT_PIXEL_CAP: i64 = 1920 * 1080")
        expect(source).to_contain("revision_cache_surface_valid: bool = false")
        expect(source).to_contain("self.revision_cache_surface_valid = true")
        expect(source).to_contain("engine2d_revision_result_payload_cacheable(")
        expect(source).to_contain("self.w, self.h): Some(result) else: nil")

    it "allows zero-pixel frame switching and local damage from the retained surface":
        val source = file_read("src/os/compositor/compositor_engine2d.spl")
        expect(source).to_contain("self.revision_cache_surface_valid)")
        expect(source).to_contain("raster_count: 0, submission_count: 0, readback_count: 0")
        expect(source).to_contain("composition_damage_between(")
        expect(source).to_contain("web_draw_ir_consume_damage(")
        expect(source).to_contain(
            "render_web_draw_ir_composition_resources_revision(")
        expect(source).to_contain("self.engine, prior, composition, images")
        expect(source).to_contain("self.engine = consumed.engine")
