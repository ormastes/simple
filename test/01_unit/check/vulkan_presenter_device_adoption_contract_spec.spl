use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "Vulkan presenter device adoption and shutdown quarantine":
    it "adopts the presenter-selected physical device without replacement":
        val device = file_read(
            "src/compiler_rust/runtime/src/vulkan_graphics_runtime_device.rs")
        val session = file_read(
            "src/lib/gc_async_mut/gpu/engine2d/vulkan_session.spl")

        expect(device).to_contain("rt_vulkan_selected_device_index")
        expect(device).to_contain(
            "device.physical_device().handle == state.physical_devices[idx].handle")
        expect(session).to_contain(
            "val selected_device = vulkan_sffi_selected_device_index()")
        expect(session).to_contain(
            "vulkan_sffi_select_device(selected_device)")
        expect(session).to_contain("vulkan_sffi_selected_device_name()")
        expect(session).to_contain(
            "vulkan_sffi_selected_device_driver_identity()")

    it "preserves shared Vulkan state while a presenter is registered":
        val core = file_read(
            "src/compiler_rust/runtime/src/vulkan_graphics_runtime_core.rs")

        expect(core).to_contain(
            "presenter_registry_blocks_shutdown(state.engine2d_presenters.len())")
        expect(core).to_contain(
            "external Vulkan presenters must be destroyed before the shared device")
        expect(core.index_of(
            "presenter_registry_blocks_shutdown(state.engine2d_presenters.len())")
        ).to_be_less_than(core.index_of("state.engine2d_presenters.clear()"))

