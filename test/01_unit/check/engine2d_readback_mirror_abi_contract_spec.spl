# @tag: unit, contract, engine2d, readback, jit, vulkan

use std.spec
use std.io.file.read_text
use std.nogc_async_mut.gpu.engine2d.backend.engine2d_readback_with_identity

describe "Engine2D readback mirrored ABI":
    it "constructs and preserves explicit device identity in the no-GC tier":
        val receipt = engine2d_readback_with_identity(
            [1u32, 2u32], "device_readback", 41, 73)
        expect(receipt.backend_handle).to_equal(41)
        expect(receipt.device_identity).to_equal(73)
        expect(receipt.pixel_count).to_equal(2)

    it "keeps both same-named class declarations field-compatible":
        val gc_source = read_text("src/lib/gc_async_mut/gpu/engine2d/backend.spl")
        val nogc_source = read_text("src/lib/nogc_async_mut/gpu/engine2d/backend.spl")
        expect(gc_source).to_contain("device_identity: i64")
        expect(nogc_source).to_contain("device_identity: i64")
