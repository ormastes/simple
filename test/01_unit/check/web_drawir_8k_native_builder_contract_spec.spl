use std.spec
use std.io_runtime.{file_read}

describe "Web DrawIR 8K cached native builder contract":
    it "builds the canonical benchmark with a bounded narrow entry closure":
        val script = file_read("scripts/check/build-web-drawir-8k-native.shs")
        expect(script).to_contain("compiler identity probe")
        expect(script).to_contain("grep -q 'bootstrap seed'")
        expect(script).to_contain("simple_compiler_select --root")
        expect(script).to_contain("simple_compiler_usable")
        expect(script).to_contain("--entry-closure --cache-dir")
        expect(script).to_contain("--source \"$ROOT_DIR/src/lib\" --source \"$ROOT_DIR/src/os\"")
        expect(script).to_contain("bench_web_draw_ir_8k_frame_switch.spl")
        expect(script).to_contain("SIMPLE_NO_STUB_FALLBACK=1")

    it "fails closed unless the complete passing evidence receipt exists":
        val script = file_read("scripts/check/build-web-drawir-8k-native.shs")
        expect(script).to_contain("^WEB_DRAW_IR_8K_SWITCH status=pass ")
        expect(script).to_contain("viewport=7680x4320")
        expect(script).to_contain("p50_ns= p95_ns= rss_kb=")
        expect(script).to_contain("fallback= readback_mode= checksum=")
        expect(script).to_contain("redraw_frames= reused_frames=")
        expect(script).to_contain("unresolved-symbol stubs")
