use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "Hosted WM Vulkan existing-window ownership":
    it "exports native handles from the canonical winit owner":
        val winit = file_read("src/runtime/spl_winit/src/lib.rs")
        expect(winit).to_contain("rt_winit_window_vulkan_platform")
        expect(winit).to_contain("rt_winit_window_vulkan_display")
        expect(winit).to_contain("rt_winit_window_vulkan_surface")
        expect(winit).to_contain("RawWindowHandle::Xlib")
        expect(winit).to_contain("RawWindowHandle::Wayland")

    it "queries the live Winit slot through its sanctioned sibling library":
        val presenter = file_read(
            "src/lib/nogc_sync_mut/gpu/engine2d/vulkan_presenter.spl")
        expect(presenter).to_contain("use std.sffi.dynamic.{DynLib}")
        expect(presenter).to_contain("vulkan_presenter_winit_native_handles")
        expect(presenter).to_contain("rt_winit_window_vulkan_platform")
        expect(presenter).to_contain("rt_winit_window_vulkan_display")
        expect(presenter).to_contain("rt_winit_window_vulkan_surface")
        expect(presenter).to_contain("lib!.close()")
        expect(presenter).to_contain(
            "rt_vk_engine2d_presenter_create_external_linux")

    it "selects direct device presentation and preserves software fallback":
        val compositor = file_read(
            "src/os/compositor/compositor_engine2d.spl")
        val host_core = file_read(
            "src/os/compositor/host_compositor_core.spl")
        val hosted = file_read("src/os/hosted/hosted_entry.spl")
        expect(compositor).to_contain("create_from_env_for_winit")
        expect(compositor).to_contain("present_device_frame")
        expect(compositor).to_contain("owner.present_damage(")
        expect(compositor).to_contain("owner.present_retained(")
        expect(compositor).to_contain(
            "engine2d_draw_ir_adv_composition_submit_with_images")
        expect(compositor).to_contain(
            "result.readback_source == \"device_submit_no_readback\"")
        expect(compositor).to_contain("me readback_pixel_buffer()")
        expect(compositor).to_contain("self.engine.read_pixels_with_source()")
        expect(hosted).to_contain(
            "hosted_winit_present_pure_simple_pixels(presenter, raster.readback_pixel_buffer()")
        expect(host_core).to_contain("executor.clear_damage()")
        expect(host_core).to_contain("while dirty_index < self.dirty.rects.len()")
        expect(host_core).to_contain("executor.report_damage(")
        expect(hosted).to_contain("raster.present_device_frame(comp.render_revision)")
        expect(hosted).to_contain("elif not hosted_winit_present_pure_simple_pixels")
