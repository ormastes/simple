use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "Vulkan DrawIR no-readback presentation":
    it "submits a fenced frame without invoking backend present or readback":
        val draw_ir = file_read(
            "src/lib/gc_async_mut/gpu/engine2d/draw_ir_adv.spl")
        expect(draw_ir).to_contain(
            "engine2d_draw_ir_adv_composition_submit_with_images")
        expect(draw_ir).to_contain(
            "composition, gpu_available, images, false, false, false")
        expect(draw_ir).to_contain("device_submit_no_readback")
        expect(draw_ir).to_contain("not readback_frame and submitted_handle > 0")

    it "publishes native identities only from a healthy Vulkan backend":
        val engine = file_read(
            "src/lib/gc_async_mut/gpu/engine2d/engine.spl")
        expect(engine).to_contain("fn vulkan_framebuffer_handle() -> i64")
        expect(engine).to_contain("fn vulkan_device_identity() -> i64")
        expect(engine).to_contain("fn vulkan_submission_generation() -> i64")
        val backend = file_read(
            "src/lib/gc_async_mut/gpu/engine2d/backend_vulkan.spl")
        expect(backend).to_contain(
            "fn vulkan_submitted_framebuffer_handle(backend: VulkanBackend)")
        expect(backend).to_contain("backend.cpu_fallback_used")
        expect(backend).to_contain("backend.completion_unknown")
        expect(backend).to_contain("backend.pending_compute_command != 0")
        expect(backend).to_contain("backend.pending_compute_count != 0")
        expect(backend).to_contain(
            "backend.fenced_submission_generation != backend.submission_generation")

    it "routes hosted WM normal frames through direct present with explicit fallback readback":
        val compositor = file_read(
            "src/os/compositor/compositor_engine2d.spl")
        val host_core = file_read(
            "src/os/compositor/host_compositor_core.spl")
        val hosted = file_read("src/os/hosted/hosted_entry.spl")
        expect(compositor).to_contain("_direct_vulkan_presenter_ready")
        expect(compositor).to_contain(
            "engine2d_draw_ir_adv_composition_submit_with_images")
        expect(compositor).to_contain(
            "result.readback_source == \"device_submit_no_readback\"")
        expect(compositor).to_contain("me readback_pixel_buffer()")
        expect(host_core).to_contain(
            "host_wm_draw_ir_direct_submit_valid")
        expect(host_core).to_contain("if not direct_submit:")
        expect(hosted).to_contain("raster.present_device_frame(")
        expect(hosted).to_contain("raster.has_direct_vulkan_submit()")
        expect(hosted).to_contain("raster.readback_pixel_buffer()")

    it "binds and consumes each direct candidate exactly once":
        val compositor = file_read(
            "src/os/compositor/compositor_engine2d.spl")
        val host_core = file_read(
            "src/os/compositor/host_compositor_core.spl")
        expect(host_core).to_contain(
            "executor.begin_present_frame(self.render_revision)")
        expect(compositor).to_contain(
            "self.vulkan_candidate_frame_revision = self.vulkan_render_frame_revision")
        expect(compositor).to_contain(
            "frame_revision != candidate_frame_revision")
        expect(compositor).to_contain(
            "submission_generation <= self.vulkan_last_presented_submission_generation")
        expect(compositor).to_contain(
            "self._clear_vulkan_present_candidate()")
        expect(compositor).to_contain(
            "self.vulkan_present_candidate_consumed = true")
        expect(compositor).to_contain(
            "_engine2d_compositor_clear_override(self.id)")
        expect(compositor).to_contain("self.invalidate_frame_receipt()")
