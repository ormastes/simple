use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "WM external-content LOCAL damage overlap contract":
    it "rejects intersecting child rectangles before parent translation":
        val source = file_read("src/lib/common/ui/window_scene.spl")
        expect(source).to_contain("fn wm_content_frame_damage_plan_valid(")
        expect(source).to_contain("var prior: i64 = 0")
        expect(source).to_contain("while prior < offset:")
        expect(source).to_contain("fn _wm_content_damage_rects_overlap(")
        expect(source).to_contain(
            "ax < bx + bw and bx < ax + aw and ay < by + bh and by < ay + ah")

    it "keeps invalid LOCAL plans fail-closed at the WM parent boundary":
        val source = file_read("src/os/compositor/host_compositor_core.spl")
        expect(source).to_contain("not wm_content_frame_damage_plan_valid(current)")
        expect(source).to_contain(
            "if not _host_external_damage_incremental_valid(previous, current):")
        expect(source).to_contain("self.dirty.add_full_screen(self.width, self.height)")
        expect(source).to_contain("if current.damage_mode == WM_CONTENT_DAMAGE_LOCAL:")
