use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "Web DrawIR Vulkan damage-present route":
    it "publishes the post-DrawIR effective plan rather than provisional Web damage":
        val consumer = file_read(
            "src/lib/gc_async_mut/gpu/browser_engine/web_draw_ir_damage_consumer.spl")
        expect(consumer).to_contain("effective_plan_mode: i64")
        expect(consumer).to_contain("effective_plan_rects: [i64]")
        expect(consumer).to_contain("replay.rects_replayed == decision.rects.len() / 4")
        expect(consumer).to_contain("effective_plan_mode = DAMAGE_PLAN_FULL")
        expect(consumer).to_contain("decision.mode == DAMAGE_PLAN_NONE")

    it "queues validated local or full rectangles before the external presenter reads damage":
        val compositor = file_read("src/os/compositor/compositor_engine2d.spl")
        expect(compositor).to_contain(
            "me apply_web_draw_ir_effective_damage(")
        expect(compositor).to_contain("self.web_damage_rects_valid(")
        expect(compositor).to_contain("self.report_damage(")
        expect(compositor).to_contain("consumed.effective_plan_mode")
        expect(compositor).to_contain("consumed.effective_plan_rects")
        expect(compositor).to_contain("self.force_web_draw_ir_full_damage(consumed.reason)")
        expect(compositor).to_contain("while index < self.damage.damage_len:")
        expect(compositor).to_contain("owner.present_damage_with_receipt(")

    it "keeps exact retained NONE unqueued and rejects malformed transfer bounds":
        val compositor = file_read("src/os/compositor/compositor_engine2d.spl")
        expect(compositor).to_contain(
            "if mode == DAMAGE_PLAN_NONE:\n            return rects.len() == 0")
        expect(compositor).to_contain("rects.len() == 0 or rects.len() % 4 != 0")
        expect(compositor).to_contain("width > self.w as i64 - x")
        expect(compositor).to_contain("height > self.h as i64 - y")
