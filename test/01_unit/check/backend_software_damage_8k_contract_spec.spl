use std.spec
use std.io_runtime.{file_read}

# This is a structural overflow regression.  Allocating an interpreter-side
# 8K framebuffer only to exercise the damage threshold is needlessly costly;
# the production operation must instead widen both area operands before the
# 100x percentage comparison.
describe "software backend 8K damage area contract":
    it "widens bounding and surface area before deciding the 60 percent fallback":
        val source = file_read("src/lib/gc_async_mut/gpu/engine2d/backend_software.spl")
        expect(source).to_contain(
            "val bound_area = (bx1 - bx0).to_i64() * (by1 - by0).to_i64()")
        expect(source).to_contain(
            "val surface_area = self.w.to_i64() * self.h.to_i64()")
        expect(source).to_contain(
            "bound_area * 100 > surface_area * 60")

    it "has headroom for the exact 8K percentage comparison":
        val surface_area: i64 = 7680 * 4320
        val scaled_area = surface_area * 100
        expect(surface_area).to_equal(33177600)
        expect(scaled_area).to_equal(3317760000)
        expect(scaled_area).to_be_greater_than(2147483647)
