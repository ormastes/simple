use std.spec
use std.io_runtime.{file_read}

describe "Vulkan window device creation contract":
    it "keeps compute-only creation separate from surface-aware creation":
        val device = file_read("src/compiler_rust/runtime/src/value/gpu_vulkan/vulkan_sffi/device.rs")
        val constructor = file_read("src/compiler_rust/runtime/src/vulkan/device.rs")
        val swapchain = file_read("src/compiler_rust/runtime/src/vulkan/swapchain.rs")

        expect(device).to_contain("pub extern \"C\" fn rt_vk_device_create_for_window(window_handle: u64)")
        expect(device).to_contain("VulkanDevice::new_for_surface(physical_device, &surface)")
        expect(device).to_contain("find_present_queue_family(&instance, surface_handle)")
        expect(device).to_contain("candidates.sort_by_key")
        expect(device).to_contain("for physical_device in candidates")
        expect(device).to_contain("Skipping Vulkan presentation device after creation failure")
        expect(constructor).to_contain("pub fn new_for_surface")
        expect(constructor).to_contain("unique_families.insert(present)")
        expect(constructor).to_contain(".queue_create_infos(&queue_create_infos)")
        expect(constructor).to_contain("let present_queue_lock")
        expect(constructor).to_contain("graphics_queue == Some(queue)")
        expect(constructor).to_contain("Arc::clone(&compute_queue_lock)")
        expect(constructor).to_contain("present_surface: Option<Weak<Surface>>")
        expect(constructor).to_contain("Arc::ptr_eq(&owner, surface)")
        expect(swapchain).to_contain("Swapchain device has no presentation queue family")
        expect(swapchain).to_contain("Swapchain device has no presentation queue")
        expect(swapchain).to_contain("if device.present_queue().is_none()")
        expect(swapchain).to_contain("supports_surface(&surface)")
        expect(swapchain).to_contain("Swapchain surface does not match the presentation device")

    it "exports the window-aware ABI through native and interpreter paths":
        val runtime = file_read("src/compiler_rust/runtime/src/lib.rs")
        val native = file_read("src/compiler_rust/native_all/src/lib.rs")
        val codegen = file_read("src/compiler_rust/compiler/src/codegen/runtime_sffi.rs")
        val interpreter = file_read("src/compiler_rust/compiler/src/interpreter_extern/mod.rs")
        val simple = file_read("src/compiler_rust/lib/std/src/ext/gpu/sffi.spl")

        expect(runtime).to_contain("rt_vk_device_create_for_window")
        expect(native).to_contain("rt_vk_device_create_for_window")
        expect(native).to_contain("RT_VK_DEVICE_CREATE_FOR_WINDOW_PROVIDER")
        expect(native.contains("    rt_vk_device_create_for_window,\n")).to_equal(false)
        expect(codegen).to_contain("RuntimeFuncSpec::new(\"rt_vk_device_create_for_window\", &[I64], &[I64])")
        expect(interpreter).to_contain("insert_simple!(\"rt_vk_device_create_for_window\"")
        expect(simple).to_contain("extern fn rt_vk_device_create_for_window(window_handle: i64) -> i64")

    it "keeps one owning surface alive through every swapchain":
        val window = file_read("src/compiler_rust/runtime/src/vulkan/window.rs")
        val sffi_window = file_read("src/compiler_rust/runtime/src/value/gpu_vulkan/vulkan_sffi/window.rs")
        val surface = file_read("src/compiler_rust/runtime/src/vulkan/surface.rs")
        val swapchain = file_read("src/compiler_rust/runtime/src/vulkan/swapchain.rs")
        val sffi_swapchain = file_read("src/compiler_rust/runtime/src/value/gpu_vulkan/vulkan_sffi/swapchain.rs")

        expect(window).to_contain("surface: Arc<Surface>")
        expect(window).to_contain("Arc::new(Surface::from_handle")
        expect(window.contains("destroy_surface(")).to_equal(false)
        expect(sffi_window).to_contain("WINDOW_SURFACES.lock().insert(handle, surface)")
        expect(sffi_window).to_contain("WINDOW_SURFACES.lock().remove")
        expect(sffi_window.contains("Surface::from_handle")).to_equal(false)
        expect(swapchain).to_contain("surface: Arc<Surface>")
        expect(swapchain).to_contain("pub fn recreate(&mut self, surface: Arc<Surface>")
        expect(swapchain).to_contain("self.surface = surface")
        expect(sffi_swapchain).to_contain("let device = DEVICE_REGISTRY.lock().get(&device_handle).cloned()")
        expect(sffi_swapchain).to_contain("let surface = WINDOW_SURFACES.lock().get(&surface_handle).cloned()")
        expect(surface).to_contain("self.surface_loader.destroy_surface(self.surface, None)")
