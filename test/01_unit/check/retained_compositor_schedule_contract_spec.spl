use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "retained compositor schedule consumer":
    it "accepts only the canonical execute/local schedule before clipped replay":
        val source = file_read("src/os/compositor/compositor_engine2d.spl")
        expect(source).to_contain("me render_draw_ir_composition_scheduled(")
        expect(source).to_contain("schedule.status != RETAINED_SCHEDULE_EXECUTE")
        expect(source).to_contain("not schedule.execute_now")
        expect(source).to_contain("schedule.plan.mode != DAMAGE_PLAN_LOCAL")
        expect(source).to_contain("engine2d_draw_ir_render_composition_damage_with_images(")
        expect(source).to_contain("return self.render_draw_ir_composition(composition, images)")
        expect(source).to_contain("self.engine = replay.engine")

    it "uses only same-session full-frame observations before schedule admission":
        val source = file_read("src/os/compositor/compositor_engine2d.spl")
        expect(source).to_contain("_ENGINE2D_RETAINED_CALIBRATION_MIN_SAMPLES")
        expect(source).to_contain("same-session-full-frame-upper-bound-row")
        expect(source).to_contain("result.readback_source != \"device_readback\"")
        expect(source).to_contain("result.device_identity <= 0")
        expect(source).to_contain("perf_stats_p95(")
        expect(source).to_contain("me render_draw_ir_composition_from_retained_damage(")
        expect(source).to_contain("self.retained_damage_consumer.schedule(")
        expect(source).to_contain("self.retained_row_p95_ns")
        val host = file_read("src/os/compositor/host_compositor_core.spl")
        expect(host).to_contain("executor.report_damage(rect.x, rect.y, rect.w, rect.h)")
        expect(host).to_contain("executor.render_draw_ir_composition_from_retained_damage(composition, images)")
