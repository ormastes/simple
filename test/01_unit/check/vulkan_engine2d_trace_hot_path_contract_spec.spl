use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "Vulkan Engine2D order trace hot-path contract":
    it "resolves process trace configuration once outside primitive dispatch":
        val helpers = file_read(
            "src/lib/gc_async_mut/gpu/engine2d/backend_vulkan_helpers.spl")

        expect(helpers).to_contain("val _VULKAN_ORDER_TRACE_ENABLED =")
        expect(helpers).to_contain("fn vulkan_order_trace_enabled() -> bool:")
        expect(helpers).to_contain("    _VULKAN_ORDER_TRACE_ENABLED")
        expect(helpers).to_contain(
            "if vulkan_order_trace_enabled():\n            vulkan_order_trace(\"flush rc=")
        expect(helpers).to_contain(
            "if vulkan_order_trace_enabled():\n            vulkan_order_trace(\"dispatch pipe=")

    it "does not eagerly format disabled image or font trace messages":
        val backend = file_read(
            "src/lib/gc_async_mut/gpu/engine2d/backend_vulkan.spl")
        val font = file_read(
            "src/lib/gc_async_mut/gpu/engine2d/backend_vulkan_font.spl")

        expect(backend).to_contain(
            "if vulkan_order_trace_enabled():\n            vulkan_order_trace(\"image-composite")
        expect(backend).to_contain(
            "if vulkan_order_trace_enabled():\n            vulkan_order_trace(\"readback-entry")
        expect(font).to_contain(
            "if vulkan_order_trace_enabled():\n            vulkan_order_trace(\"font-done")
