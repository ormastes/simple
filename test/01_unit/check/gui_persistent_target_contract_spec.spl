use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "GUI persistent Engine2D target contract":
    it "keeps one per-window Engine2D target instead of retained pixel copies":
        val source = file_read("src/lib/gc_async_mut/ui/gui_content_renderer.spl")
        expect(source).to_contain("class GuiContentPersistentTarget:")
        expect(source).to_contain("engine: Engine2D")
        expect(source).to_contain("var _gui_content_targets: [GuiContentPersistentTarget] = []")
        expect(source).to_contain("target.backend == backend")
        expect(source).to_contain("target.engine, composition, false, images")
        expect(source).to_contain("No cached pixel")

    it "rejects malformed or overlapping LOCAL damage before clearing it":
        val source = file_read("src/lib/gc_async_mut/ui/gui_content_renderer.spl")
        expect(source).to_contain("composition_damage_between(")
        expect(source).to_contain("fn _gui_content_damage_rects_are_local(")
        expect(source).to_contain("rects.len() == 0 or rects.len() % 4 != 0")
        expect(source).to_contain("if not (x + rect_w <= prior_x")
        expect(source).to_contain("planned < surface")
        expect(source).to_contain("_gui_content_damage_rects_are_local(damage.rects, width, height)")
        expect(source).to_contain("engine2d_draw_ir_render_composition_damage_with_images(")
        expect(source).to_contain("replay.accepted and replay.readback.pixels.len()")
        expect(source).to_contain("target.engine.clear(gui_content_frame_clear_color())")
        expect(source).to_contain("_gui_content_damage_mode = DAMAGE_PLAN_NONE")

    it "shuts down targets for resize invalidation and cache clear":
        val source = file_read("src/lib/gc_async_mut/ui/gui_content_renderer.spl")
        expect(source).to_contain("fn _gui_content_target_evict(index: i64):")
        expect(source).to_contain("retired.engine.shutdown()")
        expect(source).to_contain("fn _gui_content_target_evict_other_sizes(")
        expect(source).to_contain("fn gui_content_frame_invalidate(window_id: text):")
        expect(source).to_contain("while _gui_content_targets.len() > 0:")
        val compositor = file_read("src/os/compositor/compositor.spl")
        expect(compositor).to_contain("gui_content_frame_invalidate(removed.id.to_text())")
