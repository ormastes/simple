# @tag: unit, contract, draw_ir, engine2d, vulkan, damage, retained

use std.spec
use std.io.file.read_text
use common.ui.render_opt.damage_tiles.DirtyTilePyramid
use common.ui.render_opt.damage_plan.build_damage_frame_plan
use std.gc_async_mut.gpu.engine2d.engine.Engine2D

describe "DrawIR retained damage presentation route":
    it "routes exact local plans through Engine2D instead of full present":
        val source = read_text("src/lib/gc_async_mut/gpu/engine2d/draw_ir_adv.spl")
        expect(source).to_contain("owner.present_damage_plan(plan)")
        expect(source).to_contain("mode == DAMAGE_PLAN_LOCAL and not fallback")

    it "routes Vulkan plans to the native strided damage presenter":
        val source = read_text("src/lib/gc_async_mut/gpu/engine2d/engine.spl")
        expect(source).to_contain("me present_damage_plan(plan: DamageFramePlan) -> bool:")
        expect(source).to_contain("vulkan.present_damage_plan(plan)")
        expect(source).to_contain("if plan.mode == DAMAGE_PLAN_NONE:")

    it "compiles and preserves idle and software present behavior":
        val tiles = DirtyTilePyramid.create(64, 64, [64], [64])
        val idle = build_damage_frame_plan(tiles, 0, 8, 100)
        var engine = Engine2D.create_with_backend(64, 64, "cpu")
        assert_true(engine.present_damage_plan(idle))
        tiles.mark_rect(0, 0, 1, 1)
        val local = build_damage_frame_plan(tiles, 0, 8, 100)
        assert_true(engine.present_damage_plan(local))
        engine.shutdown()
