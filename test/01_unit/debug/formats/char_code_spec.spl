# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-DEBUG
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, expect}


describe "text.from_char_code interpreter support":
    # @manual scenario evidence
    it "converts ASCII letter codes":
        # @req REQ-SSPEC-DEBUG
        step("converts ASCII letter codes")
        val a = text.from_char_code(65)
        expect(a).to_equal("A")
        val z = text.from_char_code(90)
        expect(z).to_equal("Z")

    it "converts lowercase letter codes":
        # @req REQ-SSPEC-DEBUG
        step("converts lowercase letter codes")
        val a = text.from_char_code(97)
        expect(a).to_equal("a")

    it "converts digit codes":
        # @req REQ-SSPEC-DEBUG
        step("converts digit codes")
        val zero = text.from_char_code(48)
        expect(zero).to_equal("0")

    it "converts space":
        # @req REQ-SSPEC-DEBUG
        step("converts space")
        val sp = text.from_char_code(32)
        expect(sp).to_equal(" ")

    it "handles null char":
        # @req REQ-SSPEC-DEBUG
        step("handles null char")
        val null_ch = text.from_char_code(0)
        expect(null_ch.len()).to_equal(1)

    it "converts tilde":
        # @req REQ-SSPEC-DEBUG
        step("converts tilde")
        val tilde = text.from_char_code(126)
        expect(tilde).to_equal("~")
