"""
## Purpose and audience
Verifies the lifecycle tools behaviour end to end so maintainers of this
component and reviewers of its spec share one pinned definition.
## Operator workflow
Run `bin/simple test <this spec>`; read the per-scenario verdicts in
the `Results:` summary. Each scenario asserts an observable outcome.
## Compatibility and limitations
Covers the currently shipped behaviour only; performance, stress and
unrelated sibling features are out of scope.
"""
# @manual: primary
# @req: REQ-TEST-T32_MCP_LIFECYCLE_TOOLS-001
# doc-path: doc/01_research/app/tools/scv.md
# doc-path: doc/03_plan/blockers/wm_evidence_lifecycle.md
# doc-path: doc/04_architecture/app/tools/scv.md
# doc-path: doc/05_design/app/tools/scv.md
# @parent test/system/t32_mcp_lifecycle_spec.spl
# @req REQ-lifecycle
# tag: unit
#
# Unit tests for T32 MCP lifecycle helper functions.
# Implementation: examples/10_tooling/trace32_tools/t32_mcp/lifecycle_tools.spl
#
# Note: Functions are inlined here to avoid import issues (same pattern as
# test/unit/app/mcp_t32/mcp_t32_run_guard_spec.spl).

use std.spec.step
use std.io_runtime.{env_get, file_exists, process_run}

# ============================================================================
# Inlined logic from lifecycle_tools.spl — pure/testable functions only
# ============================================================================

fn arch_to_binary(arch: text) -> text:
    val a = arch.lower()
    if a == "arm" or a == "arm32" or a == "cortex-m" or a == "cortex-a" or a == "":
        return "t32marm"
    elif a == "arm64" or a == "aarch64":
        return "t32marm64"
    elif a == "tricore" or a == "tc3xx" or a == "tc":
        return "t32mtc"
    elif a == "ppc" or a == "powerpc":
        return "t32mppc"
    elif a == "riscv" or a == "risc-v":
        return "t32mriscv"
    elif a == "x86" or a == "x86_64":
        return "t32mx86"
    "t32marm"

fn find_install_dir() -> text:
    val t32mem = env_get("T32MEM")
    if t32mem != "":
        return t32mem
    if file_exists("/opt/t32"):
        return "/opt/t32"
    ""

fn check_xvfb() -> bool:
    var stdout = ""
    var stderr = ""
    var rc: i64 = 0
    (stdout, stderr, rc) = process_run("/bin/sh", ["-c", "which xvfb-run 2>/dev/null"])
    rc == 0

fn ping_port(backend: text, port: i64) -> bool:
    var stdout = ""
    var stderr = ""
    var rc: i64 = 0
    (stdout, stderr, rc) = process_run("/bin/sh", ["-c", backend + " localhost port=" + str(port) + " PING < /dev/null 2>/dev/null"])
    rc == 0

# ============================================================================
# Tests
# ============================================================================

describe "t32_arch_to_binary":
    it "maps arm to t32marm":
        # @req: REQ-lifecycle
        # @req: REQ-TEST-T32_MCP_LIFECYCLE_TOOLS-001
        step("Verify: maps arm to t32marm")
        # evidence(expect(...) oracle verified): pinned constants below are authoritative values asserted by this scenario
        expect(arch_to_binary("arm")).to_equal("t32marm")

