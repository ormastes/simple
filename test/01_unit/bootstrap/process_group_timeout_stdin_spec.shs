#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)
runner="$repo_root/scripts/bootstrap/run-process-group-timeout.shs"
started=$(date +%s)
actual=$(printf 'phase2-stdin\n' | "$runner" 10 1 sh -c 'IFS= read -r line; printf "%s\n" "$line"')
elapsed=$(($(date +%s) - started))
[ "$actual" = "phase2-stdin" ] || {
  echo "FAIL: contained child lost stdin: '$actual'" >&2
  exit 1
}
[ "$elapsed" -lt 5 ] || {
  echo "FAIL: quick child waited for the ${elapsed}s watchdog" >&2
  exit 1
}
echo "PASS: contained child preserves stdin"
