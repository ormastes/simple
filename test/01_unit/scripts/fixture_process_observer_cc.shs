#!/bin/sh
# Substitute a fault-injection proxy only for the Darwin observer. The guard
# still compiles and pins it normally; production has no test bypass switches.
set -eu
case "$*" in
    *macos-process-observer.c*)
        "$RSS_TEST_REAL_CC" "$@" -o "$RSS_TEST_OBSERVER_REAL"
        output=
        while [ "$#" -gt 0 ]; do
            if [ "$1" = -o ]; then shift; output=$1; fi
            shift
        done
        cp "$RSS_TEST_OBSERVER_PROXY" "$output"
        chmod +x "$output"
        ;;
    *) exec "$RSS_TEST_REAL_CC" "$@" ;;
esac
