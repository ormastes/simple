#!/bin/sh
# Linux integration: inject elapsed time after real observation/identity checks.
# No production fixture hook, sleep, altered process metadata or fake observer.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
[ "$(uname -s)" = Linux ] || { echo 'SKIP: Linux /proc regression'; exit 0; }
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
fail() { echo "FAIL: $*" >&2; exit 1; }
mkdir -p "$tmp/resource" "$tmp/bootstrap"
cp "$root"/scripts/resource/*.c "$tmp/resource/"
cp "$root/scripts/bootstrap/bootstrap-session-exec.c" "$tmp/bootstrap/"
python3 - "$root/scripts/resource/process-tree-rss-watchdog.pl" "$tmp/resource/guard.pl" <<'PY'
import sys
from pathlib import Path
s = Path(sys.argv[1]).read_text()
a = s.index('sub finish_snapshot {')
b = s.index('\nsub members {', a)
part = s[a:b]
needle = '    my $duration_ms = (monotonic_time() - $sample_started_at) * 1000;'
assert part.count(needle) == 1
part = part.replace(needle, '''    # Fixture applies only after the actual workload has launched.
    if (-e $ENV{RSS_TEST_MARKER}) {
        die "fixture malformed observation\\n" if $ENV{RSS_TEST_BROKEN};
        $sample_started_at -= 2;
    }
''' + needle)
Path(sys.argv[2]).write_text(s[:a] + part + s[b:])
PY
export RSS_TEST_MARKER
RSS_TEST_MARKER=$tmp/started
run_case() {
    name=$1; mode=$2; expected=$3; shift 3
    rm -f "$RSS_TEST_MARKER" "$tmp/finished"
    status=0
    perl "$tmp/resource/guard.pl" --rss-cap-mode="$mode" --max-rss-kib="${RSS_TEST_CAP:-1}" \
        --receipt="$tmp/$name.env" "$@" -- /bin/sh -c \
        'echo $$ > "$1"; sleep 0.4; echo done > "$2"; exit 7' sh \
        "$RSS_TEST_MARKER" "$tmp/finished" >"$tmp/$name.log" 2>&1 || status=$?
    [ "$status" -eq "$expected" ] || { cat "$tmp/$name.log"; fail "$name exit $status expected $expected"; }
}
# Monitor ignores the RSS cap, preserves workload exit status and completion.
run_case monitor monitor 7
grep -Fxq 'status=complete' "$tmp/monitor.env" || fail 'monitor incomplete'
grep -Fxq 'measurement_budget_complete=0' "$tmp/monitor.env" || fail 'missing degraded evidence'
grep -Eq '^sample_budget_exceeded=[1-9][0-9]*$' "$tmp/monitor.env" || fail 'missing budget count'
grep -Fxq 'quiescent=1' "$tmp/monitor.env" || fail 'monitor cleanup unverified'
[ -e "$tmp/finished" ] || fail 'monitor killed workload'
[ "$(grep -c 'monitor measurement incomplete' "$tmp/monitor.log")" -eq 1 ] || fail 'warning not once'
# A generous RSS cap isolates enforced observation-budget failure.
RSS_TEST_CAP=5859375 run_case enforce enforce 89
grep -Fxq 'status=rss-measurement-failed' "$tmp/enforce.env" || fail 'enforce did not fail closed'
[ ! -e "$tmp/finished" ] || fail 'enforce workload completed'
kill -0 "$(cat "$RSS_TEST_MARKER")" 2>/dev/null && fail 'enforce workload survived'
# Actual observation failure remains fatal even in monitor mode.
RSS_TEST_BROKEN=1 run_case broken monitor 89
grep -Fxq 'status=rss-measurement-failed' "$tmp/broken.env" || fail 'broken sample accepted'
[ ! -e "$tmp/finished" ] || fail 'broken observer workload completed'
kill -0 "$(cat "$RSS_TEST_MARKER")" 2>/dev/null && fail 'broken observer workload survived'
# Explicit deadlines and signal cancellation remain authoritative under delays.
for kind in timeout interrupted; do
    rm -f "$RSS_TEST_MARKER"
    status=0
    if [ "$kind" = timeout ]; then
        perl "$tmp/resource/guard.pl" --rss-cap-mode=monitor --timeout-seconds=1 \
            --term-grace-seconds=0 --receipt="$tmp/$kind.env" -- /bin/sh -c \
            'echo $$ > "$1"; exec sleep 10' sh "$RSS_TEST_MARKER" >"$tmp/$kind.log" 2>&1 || status=$?
        [ "$status" -eq 124 ] || fail "timeout exit $status"
    else
        perl "$tmp/resource/guard.pl" --rss-cap-mode=monitor --term-grace-seconds=0 \
            --receipt="$tmp/$kind.env" -- /bin/sh -c \
            'echo $$ > "$1"; sleep .2; kill -TERM "$PPID"; exec sleep 10' sh \
            "$RSS_TEST_MARKER" >"$tmp/$kind.log" 2>&1 || status=$?
        [ "$status" -eq 143 ] || fail "interrupted exit $status"
    fi
    grep -Fxq "status=$kind" "$tmp/$kind.env" || fail "$kind status"
    grep -Fxq 'quiescent=1' "$tmp/$kind.env" || fail "$kind cleanup"
    kill -0 "$(cat "$RSS_TEST_MARKER")" 2>/dev/null && fail "$kind survivor"
done
echo 'PASS: monitor degraded timing/exit, warning once, enforce/read fail-closed, timeout/cancellation cleanup'
