#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/linux-llvm-archive-test.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
mkdir -p "$tmp/cache" "$tmp/bin"
printf 'tampered archive' >"$tmp/cache/LLVM-23.1.1-Linux-X64.tar.xz"
export SIMPLE_LINUX_PHASE23_LLVM_PREFIX="$tmp/install"
export SIMPLE_LLVM23_ARCHIVE_CACHE="$tmp/cache"
if sh "$root/scripts/setup/install-linux-phase23-llvm23.shs" >"$tmp/size.log" 2>&1; then echo 'FAIL: bad asset size accepted'; exit 1; fi
grep -q 'archive byte count differs' "$tmp/size.log" || exit 1
[ ! -e "$tmp/install" ] || exit 1
# Simulate only the official byte-count precondition. Real sha256sum must still
# reject the corrupted bytes before any tar/list/extraction call.
cat >"$tmp/bin/wc" <<'EOF'
#!/bin/sh
printf '2014958380\n'
EOF
cat >"$tmp/bin/tar" <<'EOF'
#!/bin/sh
touch "$TAR_MARKER"
exit 99
EOF
chmod +x "$tmp/bin/wc" "$tmp/bin/tar"
export TAR_MARKER="$tmp/tar-called"
if PATH="$tmp/bin:$PATH" sh "$root/scripts/setup/install-linux-phase23-llvm23.shs" >"$tmp/digest.log" 2>&1; then echo 'FAIL: bad digest accepted'; exit 1; fi
grep -q 'archive digest differs' "$tmp/digest.log" || exit 1
[ ! -e "$TAR_MARKER" ] && [ ! -e "$tmp/install" ] || exit 1
[ "$(find "$tmp/cache" -maxdepth 1 -name '.llvm-download.*' | wc -l)" -eq 0 ] || exit 1
printf 'LLVM archive policy: bad size and real digest rejected before extraction PASS\n'
