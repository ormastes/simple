#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
BOOTSTRAP_STAGE3_FACADE_PATH=\
"$root/scripts/check/lib/bootstrap-stage3-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
PORTABLE_LOCK_ATOMIC_HELPER_PATH="$root/scripts/check/lib/portable-hardlink-lock.pl"
export PORTABLE_LOCK_ATOMIC_HELPER_PATH
. "$root/scripts/check/lib/portable-process-lock.shs"
. "$root/scripts/bootstrap/bootstrap-authority-wiring.shs"

tmp=${TMPDIR:-/tmp}/simple-authority-publication.$$
trap 'chmod -R u+w "$tmp" 2>/dev/null || true; rm -rf "$tmp"' EXIT INT TERM
mkdir -p "$tmp/source-a" "$tmp/source-b" "$tmp/source-c" "$tmp/source-d" \
  "$tmp/target/bootstrap.generations" "$tmp/target/bootstrap"

make_source() {
  dir=$1
  marker=$2
  mkdir -p "$dir/deps"
  printf 'runtime-%s\n' "$marker" >"$dir/deps/libsimple_runtime.a"
  printf '#!/bin/sh\necho %s\n' "$marker" >"$dir/simple"
  chmod 755 "$dir/simple"
  printf 'native-%s\n' "$marker" >"$dir/libsimple_native_all.a"
  printf 'backfill-%s\n' "$marker" >"$dir/libsimple_compiler_backfill.a"
}
make_source "$tmp/source-a" A
make_source "$tmp/source-b" B
make_source "$tmp/source-c" C
make_source "$tmp/source-d" D
make_source "$tmp/target/bootstrap" A
fp_a=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
fp_b=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
fp_c=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
fp_d=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
fp_changed=eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
bootstrap_stage3_write_seed_stamp \
  "$tmp/target/bootstrap/simple.inputs.sha256" "$fp_a" \
  "$tmp/target/bootstrap/simple" \
  "$tmp/target/bootstrap/libsimple_native_all.a" \
  "$tmp/target/bootstrap/libsimple_compiler_backfill.a"
printf 'compiler-archive\n' >"$tmp/target/bootstrap/libsimple_compiler.real.a"
ln -s libsimple_compiler.real.a "$tmp/target/bootstrap/libsimple_compiler.a"

# Missing backfill always selects a complete Rust rebuild, never a partial tuple.
if bootstrap_stage3_rust_tuple_requires_complete_rebuild \
  "$tmp/source-a/simple" "$tmp/source-a/libsimple_native_all.a" \
  "$tmp/source-a/missing-backfill.a" 0; then :; else
  echo 'FAIL: backfill-only state did not force a complete rebuild' >&2
  exit 1
fi
if bootstrap_stage3_rust_tuple_requires_complete_rebuild \
  "$tmp/source-a/simple" "$tmp/source-a/libsimple_native_all.a" \
  "$tmp/source-a/libsimple_compiler_backfill.a" 0; then
  echo 'FAIL: complete tuple unnecessarily requested rebuilding' >&2
  exit 1
fi

# The real no-rebuild wiring refuses to inspect or mutate legacy authority
# without ownership, then migrates the complete tuple while locked.
if bootstrap_authority_migrate_complete_legacy \
  "$tmp/target/bootstrap" "$tmp/target/bootstrap.generations" \
  "$tmp/target/bootstrap.current.env" "$tmp/target/bootstrap" "$fp_a" \
  simple libsimple_native_all.a libsimple_compiler_backfill.a \
  aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa "" "$fp_a"; then
  echo 'FAIL: legacy authority mutated without an owned lock' >&2
  exit 1
else
  [ "$?" -eq 77 ] || exit 1
fi
[ -d "$tmp/target/bootstrap" ]
[ ! -L "$tmp/target/bootstrap" ]
[ ! -e "$tmp/target/bootstrap.current.env" ]
if bootstrap_authority_materialize_legacy_file "" \
  "$tmp/target/bootstrap/libsimple_compiler.a"; then
  echo 'FAIL: legacy symlink materialized without authority ownership' >&2
  exit 1
else
  [ "$?" -eq 77 ] || exit 1
fi
[ -L "$tmp/target/bootstrap/libsimple_compiler.a" ]

PORTABLE_LOCK_HANDLES=
portable_lock_acquire "$tmp/locks" authority 5
legacy_handle=$PORTABLE_LOCK_HANDLE
bootstrap_authority_materialize_legacy_file "$legacy_handle" \
  "$tmp/target/bootstrap/libsimple_compiler.a"
[ -f "$tmp/target/bootstrap/libsimple_compiler.a" ]
[ ! -L "$tmp/target/bootstrap/libsimple_compiler.a" ]
bootstrap_authority_migrate_complete_legacy \
  "$tmp/target/bootstrap" "$tmp/target/bootstrap.generations" \
  "$tmp/target/bootstrap.current.env" "$tmp/target/bootstrap" "$fp_a" \
  simple libsimple_native_all.a libsimple_compiler_backfill.a \
  aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa "$legacy_handle" "$fp_a"
portable_lock_release "$legacy_handle"
bootstrap_stage3_resolve_committed_seed "$tmp/target/bootstrap.generations" \
  "$tmp/target/bootstrap.current.env"
[ "$("$BOOTSTRAP_STAGE3_COMMITTED_AUTHORITY/simple")" = A ]
[ -L "$tmp/target/bootstrap" ]
legacy_count=$(find "$tmp/target/bootstrap.generations" -maxdepth 1 \
  -type d -name 'legacy-*' | wc -l | tr -d ' ')
[ "$legacy_count" -eq 1 ]

bootstrap_stage3_prepare_seed_generation "$tmp/source-b" \
  "$tmp/target/bootstrap.generations" \
  "$fp_b" simple libsimple_native_all.a libsimple_compiler_backfill.a bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
stage_b=$BOOTSTRAP_STAGE3_PREPARED_STAGING
final_b=$BOOTSTRAP_STAGE3_PREPARED_GENERATION
hash_b=$BOOTSTRAP_STAGE3_PREPARED_HASH
# Darwin rename needs a writable staging root; tuple files remain frozen.
perl -e 'exit(((stat($ARGV[0]))[2] & 0777) == 0700 ? 0 : 1)' "$stage_b" || {
  echo 'FAIL: staging root frozen before publication rename' >&2
  exit 1
}
[ ! -w "$stage_b/simple" ]
[ ! -w "$stage_b/libsimple_native_all.a" ]
[ ! -w "$stage_b/libsimple_compiler_backfill.a" ]
bootstrap_stage3_prepare_seed_generation "$tmp/source-c" \
  "$tmp/target/bootstrap.generations" \
  "$fp_c" simple libsimple_native_all.a libsimple_compiler_backfill.a cccccccccccccccccccccccccccccccc
stage_c=$BOOTSTRAP_STAGE3_PREPARED_STAGING
final_c=$BOOTSTRAP_STAGE3_PREPARED_GENERATION
hash_c=$BOOTSTRAP_STAGE3_PREPARED_HASH

# A prepared but uncommitted generation cannot affect current authority.
bootstrap_stage3_resolve_committed_seed "$tmp/target/bootstrap.generations" \
  "$tmp/target/bootstrap.current.env"
[ "$("$BOOTSTRAP_STAGE3_COMMITTED_AUTHORITY/simple")" = A ]

publish_locked() (
  stage=$1
  final=$2
  inputs=$3
  hash=$4
  PORTABLE_LOCK_HANDLES=
  portable_lock_acquire "$tmp/locks" authority 10
  handle=$PORTABLE_LOCK_HANDLE
  bootstrap_stage3_publish_seed_generation "$stage" "$final" \
    "$tmp/target/bootstrap.current.env" "$inputs" "$hash" "$inputs" \
    "$tmp/target/bootstrap"
  portable_lock_release "$handle"
)
publish_locked "$stage_b" "$final_b" "$fp_b" "$hash_b" &
publisher_b=$!
publish_locked "$stage_c" "$final_c" "$fp_c" "$hash_c" &
publisher_c=$!
wait "$publisher_b"
wait "$publisher_c"
# Both published generations must be frozen before marker admission.
for generation in "$final_b" "$final_c"; do
  perl -e 'exit(((stat($ARGV[0]))[2] & 0777) == 0500 ? 0 : 1)' "$generation"
done

bootstrap_stage3_resolve_committed_seed "$tmp/target/bootstrap.generations" \
  "$tmp/target/bootstrap.current.env"
committed_marker=$("$BOOTSTRAP_STAGE3_COMMITTED_AUTHORITY/simple")
case "$committed_marker" in
  B|C) ;;
  *) echo "FAIL: mixed or unknown committed generation" >&2; exit 1 ;;
esac
grep -q "^native-${committed_marker}$" \
  "$BOOTSTRAP_STAGE3_COMMITTED_AUTHORITY/libsimple_native_all.a"

# A changed post-Cargo fingerprint fails before generation or marker commit.
bootstrap_stage3_prepare_seed_generation "$tmp/source-d" \
  "$tmp/target/bootstrap.generations" \
  "$fp_d" simple libsimple_native_all.a libsimple_compiler_backfill.a dddddddddddddddddddddddddddddddd
stage_d=$BOOTSTRAP_STAGE3_PREPARED_STAGING
final_d=$BOOTSTRAP_STAGE3_PREPARED_GENERATION
hash_d=$BOOTSTRAP_STAGE3_PREPARED_HASH
marker_before=$(bootstrap_stage3_hash_file "$tmp/target/bootstrap.current.env")
if bootstrap_stage3_publish_seed_generation "$stage_d" "$final_d" \
  "$tmp/target/bootstrap.current.env" "$fp_d" "$hash_d" "$fp_changed" \
  "$tmp/target/bootstrap"; then
  echo 'FAIL: changed fingerprint was published' >&2
  exit 1
fi
[ -d "$stage_d" ]
[ ! -e "$final_d" ]
[ "$marker_before" = \
  "$(bootstrap_stage3_hash_file "$tmp/target/bootstrap.current.env")" ]

# Compatibility migration occurs inside a fail-closed transaction. A crash
# after pointer replacement leaves current resolution unavailable until retry.
BOOTSTRAP_STAGE3_TEST_STOP_AFTER_COMPATIBILITY=1
export BOOTSTRAP_STAGE3_TEST_STOP_AFTER_COMPATIBILITY
if bootstrap_stage3_publish_seed_generation "$stage_d" "$final_d" \
  "$tmp/target/bootstrap.current.env" "$fp_d" "$hash_d" "$fp_d" \
  "$tmp/target/bootstrap"; then
  echo 'FAIL: transaction stop hook unexpectedly committed' >&2
  exit 1
else
  [ "$?" -eq 99 ] || exit 1
fi
# Even an interrupted marker transaction must leave the final root frozen.
perl -e 'exit(((stat($ARGV[0]))[2] & 0777) == 0500 ? 0 : 1)' "$final_d"
unset BOOTSTRAP_STAGE3_TEST_STOP_AFTER_COMPATIBILITY
echo "PASS: Darwin staging rename permissions and frozen published generations"
