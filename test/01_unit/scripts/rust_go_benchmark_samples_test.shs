#!/bin/sh
set -eu
LC_ALL=C
export LC_ALL
ROOT=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd -P)
CHECKER="$ROOT/scripts/check/check-rust-go-benchmark-samples.shs"
fixture=$(mktemp -d); trap 'rm -rf "$fixture"' EXIT INT TERM
mkdir -p "$fixture/test/05_perf/fixtures"
mkdir -p "$fixture/scripts/check/lib" "$fixture/scripts/bootstrap" "$fixture/src/compiler" "$fixture/src/lib" "$fixture/src/app" "$fixture/src/runtime" "$fixture/examples/10_tooling"
cp -R "$ROOT/test/05_perf/fixtures/rust_go_benchmark" "$fixture/test/05_perf/fixtures/"
cp "$ROOT/scripts/check/check-rust-go-benchmark-samples.shs" "$fixture/scripts/check/"
cp "$ROOT/scripts/check/check-rust-go-benchmark-parity.shs" "$fixture/scripts/check/"
cp "$ROOT/scripts/check/check-rust-go-benchmark-build-origin.shs" "$fixture/scripts/check/"
cp "$ROOT/scripts/check/lib/bootstrap-stage3-provenance.shs" "$fixture/scripts/check/lib/"
cp "$ROOT/scripts/check/lib/stage4-candidate-provenance.shs" "$fixture/scripts/check/lib/"
cp -R "$ROOT/scripts/check/lib/bootstrap-stage3" "$fixture/scripts/check/lib/"
cp "$ROOT/scripts/bootstrap/bootstrap-from-scratch.sh" "$fixture/scripts/bootstrap/"
git -C "$fixture" init -q; git -C "$fixture" config user.name benchmark-test; git -C "$fixture" config user.email benchmark@example.invalid
git -C "$fixture" add test scripts; git -C "$fixture" commit -qm fixtures
fingerprint=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
run_id=benchmark-run-001; fixture_id=runtime-fed-lcg-100k
empty=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
base=test/05_perf/fixtures/rust_go_benchmark
hash() { sha256sum "$1" | awk '{print $1}'; }
stdout_sha=$(printf 'checksum=171811812 operations=100000\n' | sha256sum | awk '{print $1}')
input_sha=$(hash "$fixture/$base/input.txt")
cat >"$fixture/equivalence.env" <<EOF
equivalence_schema=simple.rust-go-benchmark-equivalence/v1
gate_id=rust-go-benchmark-parity
source_fingerprint=$fingerprint
run_id=$run_id
fixture_id=$fixture_id
semantic_oracle_path=$base/oracle.txt
semantic_oracle_sha256=$(hash "$fixture/$base/oracle.txt")
input_path=$base/input.txt
input_sha256=$input_sha
simple_source_path=$base/workload.spl
simple_source_sha256=$(hash "$fixture/$base/workload.spl")
rust_source_path=$base/workload.rs
rust_source_sha256=$(hash "$fixture/$base/workload.rs")
go_source_path=$base/workload.go
go_source_sha256=$(hash "$fixture/$base/workload.go")
expected_stdout_sha256=$stdout_sha
simple_stdout_sha256=$stdout_sha
rust_stdout_sha256=$stdout_sha
go_stdout_sha256=$stdout_sha
simple_exit=0
rust_exit=0
go_exit=0
operation_count=100000
final_verdict=PASS
EOF
identity=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
make_x86_64_elf() {
    { printf '\177ELF\002\001\001\000\000\000\000\000\000\000\000\000\003\000\076\000\001\000\000\000'; dd if=/dev/zero bs=1 count=40 2>/dev/null; printf '%s' "$2"; } >"$1"
}
make_x86_64_elf "$fixture/simple-benchmark" simple
make_x86_64_elf "$fixture/rust-benchmark" rust
make_x86_64_elf "$fixture/go-benchmark" go
simple_exe_sha=$(hash "$fixture/simple-benchmark"); rust_exe_sha=$(hash "$fixture/rust-benchmark"); go_exe_sha=$(hash "$fixture/go-benchmark")
cat >"$fixture/environment.env" <<EOF
environment_schema=simple.rust-go-benchmark-environment/v1
gate_id=rust-go-benchmark-parity
source_fingerprint=$fingerprint
run_id=$run_id
fixture_id=$fixture_id
host_id=fixture-host
os=linux
kernel=fixture-kernel
arch=x86_64
cpu_model_sha256=$identity
cpu_count=4
cpu_governor=performance
cpuset_sha256=$identity
isolation=offline-controlled
clock_tool_sha256=$identity
simple_compiler_path=/fixture/bin/release/x86_64/simple
simple_compiler_sha256=$identity
simple_executable_sha256=$simple_exe_sha
rust_executable_sha256=$rust_exe_sha
go_executable_sha256=$go_exe_sha
warmup_iterations=10
runtime_order=simple,rust,go
final_verdict=PASS
EOF
time_for() { case "$1" in simple) echo 00000000000000000100;; rust) echo 00000000000000000200;; go) echo 00000000000000000300;; esac; }
rss_for() { case "$1" in simple) echo 00000000000000001000;; rust) echo 00000000000000002000;; go) echo 00000000000000003000;; esac; }
cat >"$fixture/raw.env" <<EOF
sample_schema=simple.rust-go-benchmark-samples/v1
gate_id=rust-go-benchmark-parity
source_fingerprint=$fingerprint
run_id=$run_id
fixture_id=$fixture_id
clock_id=clock_gettime-monotonic
unit=ns
sample_count=50
warmup_iterations=10
operation_count=100000
EOF
i=1
while [ "$i" -le 50 ]; do
    case $(( (i - 1) % 3 )) in 0) order='simple rust go';; 1) order='rust go simple';; 2) order='go simple rust';; esac
    for language in $order; do
        printf 'sample|%s|%s|%s|%s|0|%s|%s|100000|%s|runtime-fed-black-box\n' \
            "$language" "$i" "$(time_for "$language")" "$(rss_for "$language")" "$stdout_sha" "$empty" "$input_sha" >>"$fixture/raw.env"
    done
    i=$((i + 1))
done
cat >"$fixture/statistics.env" <<EOF
statistics_schema=simple.rust-go-benchmark-statistics/v1
gate_id=rust-go-benchmark-parity
source_fingerprint=$fingerprint
run_id=$run_id
fixture_id=$fixture_id
sample_count=50
simple_p50_ns=00000000000000000100
simple_p95_ns=00000000000000000100
simple_max_rss_kib=00000000000000001000
rust_p50_ns=00000000000000000200
rust_p95_ns=00000000000000000200
rust_max_rss_kib=00000000000000002000
go_p50_ns=00000000000000000300
go_p95_ns=00000000000000000300
go_max_rss_kib=00000000000000003000
comparison_policy=simple-p50-p95-le-rust-go
final_verdict=PASS
EOF
run() { sh "$CHECKER" --root "$fixture" --fingerprint "$fingerprint" --run-id "$run_id" --raw-samples "$1" --statistics "$2" --equivalence "${3:-$fixture/equivalence.env}" --environment "${4:-$fixture/environment.env}" --simple-executable "${5:-$fixture/simple-benchmark}" --rust-executable "${6:-$fixture/rust-benchmark}" --go-executable "${7:-$fixture/go-benchmark}"; }
run "$fixture/raw.env" "$fixture/statistics.env" | grep -q '^STATUS: PASS '
sed -e "s/rust_executable_sha256=$rust_exe_sha/rust_executable_sha256=$simple_exe_sha/" \
    -e "s/go_executable_sha256=$go_exe_sha/go_executable_sha256=$simple_exe_sha/" \
    "$fixture/environment.env" >"$fixture/environment.identical-executables"
run "$fixture/raw.env" "$fixture/statistics.env" "$fixture/equivalence.env" "$fixture/environment.identical-executables" "$fixture/simple-benchmark" "$fixture/simple-benchmark" "$fixture/simple-benchmark" >/dev/null 2>&1 && { echo 'FAIL: identical Simple/Rust/Go benchmark artifacts were accepted' >&2; exit 1; }
sed 's/os=linux/os=darwin/' "$fixture/environment.env" >"$fixture/environment.non-linux"
run "$fixture/raw.env" "$fixture/statistics.env" "$fixture/equivalence.env" "$fixture/environment.non-linux" >/dev/null 2>&1 && { echo 'FAIL: non-Linux environment with ELF artifacts was accepted' >&2; exit 1; }
sed 's/arch=x86_64/arch=aarch64/' "$fixture/environment.env" >"$fixture/environment.cross-arch"
run "$fixture/raw.env" "$fixture/statistics.env" "$fixture/equivalence.env" "$fixture/environment.cross-arch" >/dev/null 2>&1 && { echo 'FAIL: environment/executable target mismatch accepted' >&2; exit 1; }
printf 'not-an-elf-benchmark\n' >"$fixture/rust-benchmark.nonelf"
rust_nonelf_sha=$(hash "$fixture/rust-benchmark.nonelf")
sed "s/rust_executable_sha256=$rust_exe_sha/rust_executable_sha256=$rust_nonelf_sha/" "$fixture/environment.env" >"$fixture/environment.rust-nonelf"
run "$fixture/raw.env" "$fixture/statistics.env" "$fixture/equivalence.env" "$fixture/environment.rust-nonelf" "$fixture/simple-benchmark" "$fixture/rust-benchmark.nonelf" "$fixture/go-benchmark" >/dev/null 2>&1 && { echo 'FAIL: non-ELF Rust benchmark was accepted' >&2; exit 1; }
cp "$fixture/go-benchmark" "$fixture/go-benchmark.rel"
printf '\001\000' | dd of="$fixture/go-benchmark.rel" bs=1 seek=16 conv=notrunc 2>/dev/null
go_rel_sha=$(hash "$fixture/go-benchmark.rel")
sed "s/go_executable_sha256=$go_exe_sha/go_executable_sha256=$go_rel_sha/" "$fixture/environment.env" >"$fixture/environment.go-rel"
run "$fixture/raw.env" "$fixture/statistics.env" "$fixture/equivalence.env" "$fixture/environment.go-rel" "$fixture/simple-benchmark" "$fixture/rust-benchmark" "$fixture/go-benchmark.rel" >/dev/null 2>&1 && { echo 'FAIL: relocatable Go object was accepted as a benchmark executable' >&2; exit 1; }
reject_go_mutation() {
    _artifact=$1; _label=$2
    _sha=$(hash "$_artifact")
    sed "s/go_executable_sha256=$go_exe_sha/go_executable_sha256=$_sha/" "$fixture/environment.env" >"$fixture/environment.go-mutation"
    run "$fixture/raw.env" "$fixture/statistics.env" "$fixture/equivalence.env" "$fixture/environment.go-mutation" "$fixture/simple-benchmark" "$fixture/rust-benchmark" "$_artifact" >/dev/null 2>&1 && { echo "FAIL: $_label Go benchmark mutation was accepted" >&2; exit 1; }
    return 0
}
cp "$fixture/go-benchmark" "$fixture/go-benchmark.truncated"; dd if="$fixture/go-benchmark.truncated" of="$fixture/go-benchmark.short" bs=1 count=63 2>/dev/null; reject_go_mutation "$fixture/go-benchmark.short" truncated-elf64
cp "$fixture/go-benchmark" "$fixture/go-benchmark.ident-version"; printf '\002' | dd of="$fixture/go-benchmark.ident-version" bs=1 seek=6 conv=notrunc 2>/dev/null; reject_go_mutation "$fixture/go-benchmark.ident-version" bad-ident-version
cp "$fixture/go-benchmark" "$fixture/go-benchmark.elf-version"; printf '\002' | dd of="$fixture/go-benchmark.elf-version" bs=1 seek=20 conv=notrunc 2>/dev/null; reject_go_mutation "$fixture/go-benchmark.elf-version" bad-elf-version
cp "$fixture/go-benchmark" "$fixture/go-benchmark.big-endian"; printf '\002' | dd of="$fixture/go-benchmark.big-endian" bs=1 seek=5 conv=notrunc 2>/dev/null; reject_go_mutation "$fixture/go-benchmark.big-endian" unsupported-endianness
cp "$fixture/go-benchmark" "$fixture/go-benchmark.elf32"; printf '\001' | dd of="$fixture/go-benchmark.elf32" bs=1 seek=4 conv=notrunc 2>/dev/null; reject_go_mutation "$fixture/go-benchmark.elf32" class-mismatch
cp "$fixture/go-benchmark" "$fixture/go-benchmark.aarch64"; printf '\267\000' | dd of="$fixture/go-benchmark.aarch64" bs=1 seek=18 conv=notrunc 2>/dev/null; reject_go_mutation "$fixture/go-benchmark.aarch64" machine-mismatch
sed '0,/sample|rust|2|/s//sample|simple|2|/' "$fixture/raw.env" >"$fixture/raw.order"
run "$fixture/raw.order" "$fixture/statistics.env" >/dev/null 2>&1 && { echo 'FAIL: launch-order bias accepted' >&2; exit 1; }
sed '0,/00000000000000000100/s//n\/a/' "$fixture/raw.env" >"$fixture/raw.numeric"
run "$fixture/raw.numeric" "$fixture/statistics.env" >/dev/null 2>&1 && { echo 'FAIL: malformed benchmark timing accepted' >&2; exit 1; }
sed '0,/|100000|/s//|99999|/' "$fixture/raw.env" >"$fixture/raw.ops"
run "$fixture/raw.ops" "$fixture/statistics.env" >/dev/null 2>&1 && { echo 'FAIL: wrong operation count accepted' >&2; exit 1; }
forged=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
sed "s/$stdout_sha/$forged/g" "$fixture/raw.env" >"$fixture/raw.forged"
sed "s/$stdout_sha/$forged/g" "$fixture/equivalence.env" >"$fixture/equivalence.forged"
run "$fixture/raw.forged" "$fixture/statistics.env" "$fixture/equivalence.forged" >/dev/null 2>&1 && { echo 'FAIL: output detached from oracle accepted' >&2; exit 1; }
sed 's/sample|simple|\([0-9][0-9]*\)|00000000000000000100/sample|simple|\1|00000000000000000400/' "$fixture/raw.env" >"$fixture/raw.slow"
sed 's/simple_p\(50\|95\)_ns=00000000000000000100/simple_p\1_ns=00000000000000000400/' "$fixture/statistics.env" >"$fixture/statistics.slow"
run "$fixture/raw.slow" "$fixture/statistics.slow" >/dev/null 2>&1 && { echo 'FAIL: slower Simple benchmark accepted' >&2; exit 1; }
cp /bin/true "$fixture/stage4-simple"; compiler_sha=$(hash "$fixture/stage4-simple")
sed "s/simple_compiler_sha256=$identity/simple_compiler_sha256=$compiler_sha/" "$fixture/environment.env" >"$fixture/environment.wrapper"
printf rustc-compiler >"$fixture/rustc"; rust_compiler_sha=$(hash "$fixture/rustc")
printf go-compiler >"$fixture/go"; go_compiler_sha=$(hash "$fixture/go")
chmod +x "$fixture/rustc" "$fixture/go"
printf 'simple fixture version\n' >"$fixture/simple.version"; simple_version_sha=$(hash "$fixture/simple.version")
printf 'rustc fixture version\n' >"$fixture/rust.version"; rust_version_sha=$(hash "$fixture/rust.version")
printf 'go fixture version\n' >"$fixture/go.version"; go_version_sha=$(hash "$fixture/go.version")
toolchain_digest=$(printf 'simple=%s\nrust=%s\ngo=%s\nsimple-version=%s\nrust-version=%s\ngo-version=%s\n' \
    "$compiler_sha" "$rust_compiler_sha" "$go_compiler_sha" "$simple_version_sha" "$rust_version_sha" "$go_version_sha" | sha256sum | awk '{print $1}')
cat >"$fixture/toolchain.env" <<EOF
evidence_schema=simple.must-check-toolchain/v1
gate_id=rust-go-benchmark-parity
run_id=$run_id
toolchain_id=sha256:$toolchain_digest
simple_compiler_sha256=$compiler_sha
simple_version_sha256=$simple_version_sha
rust_compiler_sha256=$rust_compiler_sha
rust_version_sha256=$rust_version_sha
go_compiler_sha256=$go_compiler_sha
go_version_sha256=$go_version_sha
final_verdict=PASS
EOF
toolchain_sha=$(hash "$fixture/toolchain.env"); environment_sha=$(hash "$fixture/environment.wrapper")
cat >"$fixture/build-origin.env" <<EOF
build_schema=simple.rust-go-benchmark-build-origin/v1
gate_id=rust-go-benchmark-parity
source_fingerprint=$fingerprint
run_id=$run_id
fixture_id=$fixture_id
toolchain_identity_sha256=$toolchain_sha
environment_sha256=$environment_sha
simple_source_path=$base/workload.spl
simple_source_sha256=$(hash "$fixture/$base/workload.spl")
simple_command_id=simple-native-o3-v1
simple_command=simple native-build test/05_perf/fixtures/rust_go_benchmark/workload.spl --backend llvm --opt-level=aggressive --strip --output benchmark_simple_executable
simple_output_sha256=$simple_exe_sha
simple_compile_exit=0
rust_source_path=$base/workload.rs
rust_source_sha256=$(hash "$fixture/$base/workload.rs")
rust_command_id=rust-opt3-codegen1-v1
rust_command=rustc -C opt-level=3 -C codegen-units=1 -C strip=symbols -o benchmark_rust_executable test/05_perf/fixtures/rust_go_benchmark/workload.rs
rust_output_sha256=$rust_exe_sha
rust_compile_exit=0
go_source_path=$base/workload.go
go_source_sha256=$(hash "$fixture/$base/workload.go")
go_command_id=go-trimpath-v1
go_command=go build -trimpath -o benchmark_go_executable test/05_perf/fixtures/rust_go_benchmark/workload.go
go_output_sha256=$go_exe_sha
go_compile_exit=0
simple_compiler_sha256=$compiler_sha
rust_compiler_sha256=$rust_compiler_sha
go_compiler_sha256=$go_compiler_sha
simple_version_sha256=$simple_version_sha
rust_version_sha256=$rust_version_sha
go_version_sha256=$go_version_sha
final_verdict=PASS
EOF
check_origin() { sh "$fixture/scripts/check/check-rust-go-benchmark-build-origin.shs" --root "$fixture" --fingerprint "$fingerprint" --run-id "$run_id" --origin "$1" --toolchain "${2:-$fixture/toolchain.env}" --equivalence "$fixture/equivalence.env" --environment "$fixture/environment.wrapper" --simple-compiler "$fixture/stage4-simple" --rust-compiler "$fixture/rustc" --go-compiler "$fixture/go" --simple-executable "$fixture/simple-benchmark" --rust-executable "$fixture/rust-benchmark" --go-executable "$fixture/go-benchmark" --simple-version "$fixture/simple.version" --rust-version "$fixture/rust.version" --go-version "$fixture/go.version"; }
check_origin "$fixture/build-origin.env" | grep -q '^STATUS: PASS '
sed 's/simple_command_id=simple-native-o3-v1/simple_command_id=custom-command/' "$fixture/build-origin.env" >"$fixture/build-origin.command"
check_origin "$fixture/build-origin.command" >/dev/null 2>&1 && { echo 'FAIL: custom Simple build command was accepted' >&2; exit 1; }
sed 's/rustc -C opt-level=3/rustc -C opt-level=1/' "$fixture/build-origin.env" >"$fixture/build-origin.flags"
check_origin "$fixture/build-origin.flags" >/dev/null 2>&1 && { echo 'FAIL: mutated Rust optimization flags were accepted' >&2; exit 1; }
sed "s/rust_output_sha256=$rust_exe_sha/rust_output_sha256=$simple_exe_sha/" "$fixture/build-origin.env" >"$fixture/build-origin.output"
check_origin "$fixture/build-origin.output" >/dev/null 2>&1 && { echo 'FAIL: swapped Rust build output was accepted' >&2; exit 1; }
sed 's/simple_source_sha256=[0-9a-f]*/simple_source_sha256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/' "$fixture/build-origin.env" >"$fixture/build-origin.source"
check_origin "$fixture/build-origin.source" >/dev/null 2>&1 && { echo 'FAIL: wrong committed Simple source hash was accepted' >&2; exit 1; }
sed 's/rust_compile_exit=0/rust_compile_exit=1/' "$fixture/build-origin.env" >"$fixture/build-origin.exit"
check_origin "$fixture/build-origin.exit" >/dev/null 2>&1 && { echo 'FAIL: failed Rust compilation was accepted' >&2; exit 1; }
sed 's/environment_sha256=[0-9a-f]*/environment_sha256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/' "$fixture/build-origin.env" >"$fixture/build-origin.environment"
check_origin "$fixture/build-origin.environment" >/dev/null 2>&1 && { echo 'FAIL: detached benchmark environment was accepted' >&2; exit 1; }
sed 's/fixture_id=runtime-fed-lcg-100k/fixture_id=other-fixture/' "$fixture/build-origin.env" >"$fixture/build-origin.fixture"
check_origin "$fixture/build-origin.fixture" >/dev/null 2>&1 && { echo 'FAIL: wrong benchmark fixture identity was accepted' >&2; exit 1; }
cp "$fixture/build-origin.env" "$fixture/build-origin.extra"; printf 'unknown_field=x\n' >>"$fixture/build-origin.extra"
check_origin "$fixture/build-origin.extra" >/dev/null 2>&1 && { echo 'FAIL: extra build-origin field was accepted' >&2; exit 1; }
cp "$fixture/toolchain.env" "$fixture/toolchain.extra"; printf 'unknown_field=x\n' >>"$fixture/toolchain.extra"
check_origin "$fixture/build-origin.env" "$fixture/toolchain.extra" >/dev/null 2>&1 && { echo 'FAIL: extra toolchain field was accepted' >&2; exit 1; }
check_origin "$fixture/build-origin.env" "$fixture/toolchain.env" >/dev/null
printf 'mutated rustc version\n' >"$fixture/rust.version.mutated"
sh "$fixture/scripts/check/check-rust-go-benchmark-build-origin.shs" --root "$fixture" --fingerprint "$fingerprint" --run-id "$run_id" --origin "$fixture/build-origin.env" --toolchain "$fixture/toolchain.env" --equivalence "$fixture/equivalence.env" --environment "$fixture/environment.wrapper" --simple-compiler "$fixture/stage4-simple" --rust-compiler "$fixture/rustc" --go-compiler "$fixture/go" --simple-executable "$fixture/simple-benchmark" --rust-executable "$fixture/rust-benchmark" --go-executable "$fixture/go-benchmark" --simple-version "$fixture/simple.version" --rust-version "$fixture/rust.version.mutated" --go-version "$fixture/go.version" >/dev/null 2>&1 && { echo 'FAIL: mutated Rust version capture was accepted' >&2; exit 1; }
cat >"$fixture/stage4-provenance.env" <<EOF
schema=simple-bootstrap-stage4-provenance-v1
status=pass
artifact_kind=pure-simple-full-cli
output_path=/fixture/bin/release/x86_64/simple
output_sha256=$compiler_sha
source_revision_kind=content-sha256
source_revision=$identity
source_roots=src/compiler:src/lib:src/app:src/runtime:examples/10_tooling
producer_path=/fixture/scripts/bootstrap/bootstrap-from-scratch.sh
producer_sha256=$identity
provenance_helper_path=/fixture/scripts/check/lib/stage4-candidate-provenance.shs
provenance_helper_sha256=$identity
parent_compiler_path=/fixture/build/stage3/simple
parent_compiler_sha256=$identity
stage3_provenance_path=/fixture/build/stage3/provenance.env
stage3_provenance_sha256=$identity
build_log_path=/fixture/build/logs/stage4-native-build.log
build_log_sha256=$identity
essential_tools_log_path=/fixture/build/logs/stage4-essential-tools-smoke.log
essential_tools_log_sha256=$identity
completed_gate=stage4-essential-tools-smoke
EOF
sh "$fixture/scripts/check/check-rust-go-benchmark-parity.shs" --root "$fixture" --fingerprint "$fingerprint" --run-id "$run_id" \
 --raw-samples "$fixture/raw.env" --statistics "$fixture/statistics.env" --equivalence "$fixture/equivalence.env" \
 --environment "$fixture/environment.wrapper" --toolchain "$fixture/toolchain.env" --build-origin "$fixture/build-origin.env" \
 --simple-version "$fixture/simple.version" --rust-version "$fixture/rust.version" --go-version "$fixture/go.version" \
 --simple-compiler "$fixture/stage4-simple" --rust-compiler "$fixture/rustc" --go-compiler "$fixture/go" --stage4-provenance "$fixture/stage4-provenance.env" \
 --simple-executable "$fixture/simple-benchmark" --rust-executable "$fixture/rust-benchmark" --go-executable "$fixture/go-benchmark" \
 >/dev/null 2>&1 && { echo 'FAIL: fabricated Stage 4 benchmark compiler admitted' >&2; exit 1; }
grep -Fq 'stage4_verify_candidate_provenance "$live_provenance" "$compiler_path" "$ROOT"' "$fixture/scripts/check/check-rust-go-benchmark-parity.shs"
grep -Fq 'check-rust-go-benchmark-parity.shs' "$ROOT/scripts/check/check-external-must-check-receipt.shs"
echo 'PASS: Rust/Go benchmark raw-sample/statistics oracle'
