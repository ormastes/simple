#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
work=$root/build/test-mci-v2-qemu-wm-$$; trap 'rm -rf "$work"' EXIT HUP INT TERM; mkdir -p "$work"
h=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
cat > "$work/capability.env" <<EOF
headless_qemu_virgl_status=pass
headless_qemu_virgl_image_id=sha256:$h
headless_qemu_virgl_adapter=packaged-ui-opengl-preload
headless_qemu_virgl_adapter_module_sha256=$h
headless_qemu_virgl_render_node=/dev/dri/renderD128
EOF
cat > "$work/capture.env" <<EOF
qemu_gtk_wm_capture_status=pass
qemu_gtk_wm_capture_qemu_live_status=pass
qemu_gtk_wm_capture_qemu_live_pixels=1
qemu_gtk_wm_capture_qemu_live_non_black_pixels=1
qemu_gtk_wm_capture_qemu_live_sample_matches=1
qemu_gtk_wm_capture_qemu_live_sample_mismatches=0
qemu_gtk_wm_capture_qemu_live_scene_mismatches=0
EOF
printf 'P6\n1 1\n255\n\001\002\003' > "$work/frame.ppm"
base="--capability $work/capability.env --capture $work/capture.env --screendump $work/frame.ppm --run-id qemu-fixture --source-hash $h --configuration-hash $h --captured-at-utc-ns 1 --valid-until-utc-ns 2 --now-utc-ns 1"
sh "$root/scripts/check/check-mci-v2-qemu-wm-evidence.shs" $base --output "$work/pass.env" | grep -Fqx qemu_wm_evidence_status=pass
grep -Fqx artifact_schema=mci-rendering-qemu-wm-evidence-v1 "$work/pass.env"
grep -Fqx release_eligible=true "$work/pass.env"

sed 's/qemu_live_scene_mismatches=0/qemu_live_scene_mismatches=1/' "$work/capture.env" > "$work/bad-capture.env"
set +e
sh "$root/scripts/check/check-mci-v2-qemu-wm-evidence.shs" --capability "$work/capability.env" --capture "$work/bad-capture.env" --screendump "$work/frame.ppm" --output "$work/bad.env" --run-id qemu-fixture --source-hash "$h" --configuration-hash "$h" --captured-at-utc-ns 1 --valid-until-utc-ns 2 --now-utc-ns 1 >"$work/bad.out" 2>"$work/bad.err"
code=$?
set -e
[ "$code" -eq 1 ]
grep -Fqx 'BLOCKED: qemu-wm-pixel-oracle-failed' "$work/bad.err"
[ ! -e "$work/bad.env" ]
echo 'mci v2 qemu wm evidence contract: PASS'
