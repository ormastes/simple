#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
resume="$root/scripts/bootstrap/resume-stage3-from-admitted.sh"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/simple-stage3-resume-manifest-env.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

# The receipts must be verified before their exact paths are bound and
# exported to manifest writing; ordering prevents an unverified directory from
# being recorded as proof.
receiver_verify_line=$(grep -n -F 'bootstrap_stage3_verify_receiver_evidence_receipt \' \
  "$resume" | sed -n '1s/:.*//p')
receiver_bind_line=$(grep -n -F 'BSTAGE3_STAGE2_RECEIVER=$stage2_receiver' \
  "$resume" | sed -n '1s/:.*//p')
receiver_display_bind_line=$(grep -n -F 'BSTAGE3_STAGE2_RECEIVER_DISPLAY=$stage2_receiver' \
  "$resume" | sed -n '1s/:.*//p')
receiver_log_bind_line=$(grep -n -F 'BSTAGE3_STAGE2_RECEIVER_LOG="$(dirname -- "$stage2_receiver")/stage2-receiver.log"' \
  "$resume" | sed -n '1s/:.*//p')
write_line=$(grep -n -F 'bootstrap_stage3_write_manifest' "$resume" | \
  tail -n 1 | sed -n 's/:.*//p')
case "$receiver_verify_line:$receiver_bind_line:$receiver_display_bind_line:$receiver_log_bind_line:$write_line" in
  *[!0-9:]*|:*|*::*) fail 'receiver verification/binding markers missing' ;;
esac
[ "$receiver_verify_line" -lt "$receiver_bind_line" ] || fail 'receiver receipt bound before verification'
[ "$receiver_bind_line" -lt "$write_line" ] || fail 'receiver receipt bound after manifest write'
[ "$receiver_display_bind_line" -lt "$write_line" ] || fail 'receiver display bound after manifest write'
[ "$receiver_log_bind_line" -lt "$write_line" ] || fail 'receiver log bound after manifest write'

# Execute the exact manifest-binding tail from the resume wrapper. The fake
# writer reads both values through a child shell, proving they were exported
# rather than only assigned in the parent shell.
receiver_receipt="$tmp/stage2-receiver.env"
receiver_log="$tmp/stage2-receiver.log"
printf 'verified receiver receipt\n' >"$receiver_receipt"
printf 'verified receiver log\n' >"$receiver_log"

harness="$tmp/manifest-env-harness.sh"
manifest="$tmp/provenance.env"
cat >"$harness" <<EOF
#!/bin/sh
set -eu
root=$tmp/root
manifest=$tmp/provenance.env
platform=fixture-platform
seed=$tmp/seed
stamp=$tmp/stamp
native_all=$tmp/libsimple_native_all.a
backfill=$tmp/libsimple_compiler_backfill.a
runtime_origin_before=$tmp/runtime-origin-before.txt
runtime_origin_after=$tmp/runtime-origin-after.txt
runtime_admitted=$tmp/runtime-admitted.txt
tool_before=$tmp/tool-before.txt
tool_after=$tmp/tool-after.txt
stage2=$tmp/stage2
stage2_admission=$tmp/stage2-admission.env
admitted=$tmp/admitted
candidate=$tmp/stage3
source_before=$tmp/source-before.txt
source_after=$tmp/source-after.txt
stage2_log=$tmp/stage2.log
stage3_log=$tmp/stage3.log
stage2_args=stage2-args
stage2_backend=cranelift
stage3_args=stage3-args
stage2_threads=1
stage3_threads=1
stage2_cache=$tmp/stage2-cache
stage3_cache=$tmp/stage3-cache
runtime=$tmp/runtime
script=$resume
helper=$tmp/helper
helper_sha_before=helper-sha
helper_bundle_before=helper-bundle
script_sha_before=script-sha
seed_fingerprint=seed-fingerprint
git_before=$tmp/git-before.env
git_after=$tmp/git-after.env
stage2_transcript=$tmp/stage2.transcript
stage3_transcript=$tmp/stage3.transcript
stage2_sanity=$tmp/stage2-sanity.env
stage2_receiver=$receiver_receipt
stage3_sanity=$tmp/stage3-sanity.env
lock=$tmp/lock
stage2_receiver_expected=$receiver_receipt
stage2_receiver_log_expected=$receiver_log
bootstrap_stage3_write_manifest() {
  [ "\$(sh -c 'printf %s "\$BSTAGE3_STAGE2_RECEIVER"')" = "\$stage2_receiver_expected" ] || exit 41
  [ "\$(sh -c 'printf %s "\$BSTAGE3_STAGE2_RECEIVER_LOG"')" = "\$stage2_receiver_log_expected" ] || exit 42
  printf 'receiver=%s\\nreceiver_log=%s\\n' "\$BSTAGE3_STAGE2_RECEIVER" "\$BSTAGE3_STAGE2_RECEIVER_LOG" >"\$BSTAGE3_MANIFEST"
}
bootstrap_stage3_verify_manifest() {
  [ "\$#" = 6 ] && [ "\$1" = "\$manifest" ] && [ "\$2" = "\$manifest" ] &&
  [ "\$3" = "\$root" ] && [ "\$4" = "\$candidate" ]
}
EOF
sed -n '/^BSTAGE3_ROOT=/,/^  "\$candidate" "\${manifest}\.authority-map\.env"/p' \
  "$resume" >>"$harness"
chmod +x "$harness"
"$harness" || fail 'manifest-binding tail did not execute'

[ "$(sed -n '1s/^receiver=//p' "$manifest")" = "$receiver_receipt" ] || \
  fail 'manifest writer did not receive receiver receipt path'
[ "$(sed -n '2s/^receiver_log=//p' "$manifest")" = "$receiver_log" ] || \
  fail 'manifest writer did not receive receiver log path'

echo 'bootstrap_stage3_resume_manifest_receiver_env_contract_test: PASS'
