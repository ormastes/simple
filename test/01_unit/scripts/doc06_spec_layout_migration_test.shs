#!/bin/sh
set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
check_script=$repo/scripts/check/check-doc06-spec-layout-migration.shs
tmp=$(mktemp -d "${TMPDIR:-/tmp}/doc06-layout-test.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

fixture=$tmp/repo
mkdir -p "$fixture/doc/06_spec/03_system/app/demo" "$fixture/test/03_system/app/demo" "$fixture/out"
spec_rel=03_system/app/demo/demo_spec.spl
printf 'use std.spec\ndescribe "demo":\n    it "works":\n        expect(1).to_equal(1)\n' >"$fixture/doc/06_spec/$spec_rel"
cp "$fixture/doc/06_spec/$spec_rel" "$fixture/test/$spec_rel"

# Missing successor fails and cannot publish an authorization manifest.
if "$check_script" --root "$fixture" --removal-manifest "$fixture/out/remove.env" >/dev/null 2>&1; then
  echo 'FAIL: missing successor was accepted' >&2; exit 1
fi
[ ! -e "$fixture/out/remove.env" ] || { echo 'FAIL: manifest published on failure' >&2; exit 1; }

# Failure reporting is inventory-complete, not first-error fail-fast.
mkdir -p "$fixture/doc/06_spec/03_system/app/second"
printf 'describe "second":\n    it "fails":\n        expect(1).to_equal(1)\n' >"$fixture/doc/06_spec/03_system/app/second/second_spec.spl"
if "$check_script" --root "$fixture" >"$tmp/all.out" 2>"$tmp/all.err"; then
  echo 'FAIL: missing successors were accepted' >&2; exit 1
fi
[ "$(grep -c 'unsafe or missing Markdown successor:' "$tmp/all.err")" -eq 2 ] || { echo 'FAIL: verifier did not report the complete inventory' >&2; exit 1; }
rm "$fixture/doc/06_spec/03_system/app/second/second_spec.spl"

# A renamed executable with a Markdown suffix is not a manual.
cp "$fixture/doc/06_spec/$spec_rel" "$fixture/doc/06_spec/${spec_rel%.spl}.md"
if "$check_script" --root "$fixture" >/dev/null 2>&1; then
  echo 'FAIL: executable Simple masquerading as Markdown was accepted' >&2; exit 1
fi

# Generation must use the canonical test-side source and may then authorize a
# deterministic manifest. The fake models only the generator's file contract.
fake=$tmp/simple
cat >"$fake" <<'EOF'
#!/bin/sh
set -eu
[ "$1" = spipe-docgen ]
input=$2
[ "$3" = --output ]
output=$4
relative=${input#*/test/}
target=$output/${relative%.spl}.md
mkdir -p "$(dirname -- "$target")"
printf '# Demo specification\n\n## Scenarios\n\nGenerated from the canonical test source.\n' >"$target"
EOF
chmod +x "$fake"
rm "$fixture/doc/06_spec/${spec_rel%.spl}.md"
"$check_script" --root "$fixture" --generate-with "$fake" --removal-manifest "$fixture/out/remove.env" >/dev/null
grep -Fxq 'schema=doc06-spec-layout-removal-v1' "$fixture/out/remove.env"
grep -Fxq 'count=1' "$fixture/out/remove.env"
grep -Fq "remove=doc/06_spec/$spec_rel|successor=doc/06_spec/${spec_rel%.spl}.md|spec_sha256=" "$fixture/out/remove.env"
[ -f "$fixture/doc/06_spec/$spec_rel" ] || { echo 'FAIL: verifier deleted the misplaced source' >&2; exit 1; }
cp "$fixture/out/remove.env" "$fixture/out/first.env"
"$check_script" --root "$fixture" --removal-manifest "$fixture/out/remove.env" >/dev/null
cmp -s "$fixture/out/first.env" "$fixture/out/remove.env" || { echo 'FAIL: manifest is not deterministic' >&2; exit 1; }

echo 'doc06_spec_layout_migration_test: PASS'
