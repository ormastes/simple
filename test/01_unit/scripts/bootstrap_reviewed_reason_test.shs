#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$root/scripts/check/lib/bootstrap-planner-admission-bound.shs"
bootstrap_planner_v2_reason_allowed //bootstrap:stage3 verify-reviewed-compiler-fix
if bootstrap_planner_v2_reason_allowed //bootstrap:stage4 verify-reviewed-compiler-fix; then
    echo 'FAIL: reviewed repair admitted Stage4' >&2
    exit 1
fi
if bootstrap_planner_v2_reason_allowed //bootstrap:stage3 verify-unreviewed-compiler-fix; then
    echo 'FAIL: unknown reason admitted' >&2
    exit 1
fi
echo 'PASS: reviewed repair reason is Stage3 scoped'
