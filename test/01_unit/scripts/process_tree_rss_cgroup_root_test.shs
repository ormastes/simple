#!/bin/sh
# Focused regression only: the real cgroup2 root has no cgroup.type interface.
# Private subtree is a filesystem fixture; root metadata reads remain real.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
[ "$(uname -s)" = Linux ] || { echo 'SKIP: Linux cgroup root'; exit 0; }
guard=${RSS_GUARD_UNDER_TEST:-$root/scripts/resource/process-tree-rss-watchdog.pl}
perl - "$guard" <<'PERL'
use strict;
use warnings;
open my $fh, '<', $ARGV[0] or die $!;
my $source = do { local $/; <$fh> };
$source =~ s/\n# Workload startup boundary.*\z//s or die 'startup boundary missing';
local @ARGV = ('--', 'unused');
my $probe = <<'PROBE';
$opt{'observation-failure-mode'} = 'diagnostic';
$opt{'independent-cgroup'} = '/sys/fs/cgroup/simple-bootstrap-stage3.' . ('a' x 32);
$opt{'timeout-seconds'} = 5;
my $parent_path = $opt{'independent-cgroup'};
my $relative_path = $parent_path; $relative_path =~ s{^/sys/fs/cgroup}{};
my %fixture = (
 "/proc/$$/cgroup" => "0::$relative_path/supervisor",
 "$parent_path/cgroup.subtree_control" => 'memory',
 "$parent_path/memory.oom.group" => '1',
 "$parent_path/memory.max" => '536870912',
 "$parent_path/memory.events" => "oom 0\noom_kill 0\noom_group_kill 0",
);
for my $path ($parent_path, "$parent_path/supervisor", "$parent_path/worker") {
 $fixture{"$path/cgroup.type"} = 'domain';
}
my $real_read = \&bounded_read;
my $real_directory = \&protected_cgroup_directory;
my %reads;
{
 no warnings 'redefine';
 *bounded_read = sub {
     ++$reads{$_[0]};
     return $fixture{$_[0]} if exists $fixture{$_[0]};
     return $real_read->(@_);
 };
 *protected_cgroup_directory = sub {
     return '10:100' if $_[0] eq $parent_path || index($_[0], "$parent_path/") == 0;
     return $real_directory->(@_);
 };
}
verify_independent_cgroup();
$independent_checks == 1 or die 'root metadata admission failed';
!$reads{'/sys/fs/cgroup/cgroup.type'} or die 'root-only nonexistent metadata queried';
$reads{'/proc/self/mountinfo'} && $reads{'/sys/fs/cgroup/cgroup.procs'}
    or die 'real root mount/migration protection omitted';
for my $path ($parent_path, "$parent_path/supervisor", "$parent_path/worker") {
 $reads{"$path/cgroup.type"} or die "private domain check omitted: $path";
}
print "PASS: non-root-only cgroup.type admits real root metadata; private domains and root migration proof retained\n";
PROBE
eval $source . $probe;
die $@ if $@;
PERL
