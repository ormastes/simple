#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
guard="$repo_root/scripts/check/check-no-sabotage-residue.shs"
test_tmp=$(mktemp -d)
trap 'rm -rf "$test_tmp"' EXIT HUP INT TERM

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

clean_git() {
    env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
        -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
        -u GIT_COMMON_DIR -u GIT_NAMESPACE -u GIT_CONFIG \
        -u GIT_CONFIG_COUNT git "$@"
}

install_guard() {
    fixture_root=$1
    mkdir -p "$fixture_root/scripts/check" "$fixture_root/src/example" \
        "$fixture_root/test/fixtures"
    cp "$guard" "$fixture_root/scripts/check/check-no-sabotage-residue.shs"
    chmod +x "$fixture_root/scripts/check/check-no-sabotage-residue.shs"
}

run_case() {
    case_name=$1
    expected_status=$2
    fixture_root=$3
    expected_text=$4
    shift 4
    output="$test_tmp/$case_name.out"
    set +e
    (cd "$fixture_root" &&
        env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
            -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
            -u GIT_COMMON_DIR -u GIT_NAMESPACE -u GIT_CONFIG \
            -u GIT_CONFIG_COUNT \
            sh scripts/check/check-no-sabotage-residue.shs "$@") \
        >"$output" 2>&1
    actual_status=$?
    set -e
    if [ "$actual_status" -ne "$expected_status" ]; then
        cat "$output" >&2
        fail "$case_name returned $actual_status, expected $expected_status"
    fi
    grep -Fq "$expected_text" "$output" || {
        cat "$output" >&2
        fail "$case_name omitted expected verdict: $expected_text"
    }
}

# Ordinary primary worktree with a non-vacuous, marker-free tracked source.
primary="$test_tmp/primary"
install_guard "$primary"
printf 'fn main():\n    pass\n' >"$primary/src/example/app.spl"
clean_git init -q "$primary"
clean_git -C "$primary" config user.email guard@test
clean_git -C "$primary" config user.name guard
clean_git -C "$primary" add scripts/check/check-no-sabotage-residue.shs \
    src/example/app.spl
clean_git -C "$primary" commit -q -m baseline
clean_git -C "$primary" update-ref refs/remotes/origin/main HEAD
run_case ordinary_primary 0 "$primary" \
    'PASS — 1 tracked source file(s) scanned, 0 marker candidate file(s) checked'

# Linked worktrees have a `.git` file and must be admitted semantically.
linked="$test_tmp/linked"
clean_git -C "$primary" worktree add -q --detach "$linked" HEAD
run_case linked_worktree 0 "$linked" \
    'PASS — 1 tracked source file(s) scanned, 0 marker candidate file(s) checked'

# A matching marker already present at origin is a checked, legitimate candidate.
printf 'fn main():\n    # SABOTAGE is committed fixture text\n    pass\n' \
    >"$primary/src/example/app.spl"
clean_git -C "$primary" add src/example/app.spl
clean_git -C "$primary" commit -q -m marker-baseline
clean_git -C "$primary" update-ref refs/remotes/origin/main HEAD
run_case legitimate_marker 0 "$primary" \
    'PASS — 1 tracked source file(s) scanned, 1 marker candidate file(s) checked'

# Adding another occurrence of a marker that already exists at origin is still
# residue; mere marker presence at both endpoints must not pass it.
printf 'fn main():\n    # SABOTAGE is committed fixture text\n    # SABOTAGE second local occurrence\n    pass\n' \
    >"$primary/src/example/app.spl"
run_case same_marker_delta 1 "$primary" 'FAIL — residue found in 1 file(s)'
clean_git -C "$primary" restore src/example/app.spl

# Removing one of multiple admitted origin markers is not residue: every
# remaining working marker line is still contained in origin.
printf 'fn main():\n    # SABOTAGE first admitted line\n    # SABOTAGE second admitted line\n    pass\n' \
    >"$primary/src/example/app.spl"
clean_git -C "$primary" add src/example/app.spl
clean_git -C "$primary" commit -q -m two-marker-baseline
clean_git -C "$primary" update-ref refs/remotes/origin/main HEAD
printf 'fn main():\n    # SABOTAGE first admitted line\n    pass\n' \
    >"$primary/src/example/app.spl"
run_case marker_removal 0 "$primary" \
    'PASS — 1 tracked source file(s) scanned, 1 marker candidate file(s) checked'
clean_git -C "$primary" restore src/example/app.spl

# A working-copy marker absent from origin is actual residue. Extra caller
# arguments must not narrow this hook's full tracked-source scan.
printf 'fn main():\n    # SABOTAGE committed marker\n    # DEBUGME local residue\n    pass\n' \
    >"$primary/src/example/app.spl"
run_case residue_full_scan 1 "$primary" 'FAIL — residue found in 1 file(s)' \
    --path src/example/does-not-exist.spl
clean_git -C "$primary" restore src/example/app.spl

# New tracked marker-bearing files have no admitted origin counterpart and
# must be rejected rather than treated as ordinary new work.
printf 'fn probe():\n    # TEMP-PROBE local file\n    pass\n' \
    >"$primary/src/example/new_probe.spl"
clean_git -C "$primary" add src/example/new_probe.spl
run_case new_marker_file 1 "$primary" 'FAIL — residue found in 1 file(s)'
clean_git -C "$primary" reset -q HEAD -- src/example/new_probe.spl
rm -f "$primary/src/example/new_probe.spl"

# A marker-free scan whose sole tracked source has bytes that Git C-quotes in
# newline mode must remain non-vacuous. The same literal pathname must then be
# carried intact into candidate comparison when local residue is introduced.
weird_only="$test_tmp/weird-only"
install_guard "$weird_only"
weird_only_rel=$(printf 'src/example/sole\tline\nbreak\\quote".spl')
printf 'fn weird_only():\n    pass\n' >"$weird_only/$weird_only_rel"
clean_git init -q "$weird_only"
clean_git -C "$weird_only" config user.email guard@test
clean_git -C "$weird_only" config user.name guard
clean_git -C "$weird_only" add \
    scripts/check/check-no-sabotage-residue.shs -- "$weird_only_rel"
clean_git -C "$weird_only" commit -q -m weird-only-baseline
clean_git -C "$weird_only" update-ref refs/remotes/origin/main HEAD
run_case sole_weird_marker_free 0 "$weird_only" \
    'PASS — 1 tracked source file(s) scanned, 0 marker candidate file(s) checked'
printf 'fn weird_only():\n    # DEBUGME sole weird-path residue\n    pass\n' \
    >"$weird_only/$weird_only_rel"
run_case sole_weird_residue 1 "$weird_only" \
    'FAIL — residue found in 1 file(s)'

# NUL-delimited candidate transport must preserve valid path bytes that Git
# otherwise C-quotes in newline mode.
weird_rel=$(printf 'src/example/weird\tline\nbreak\\quote".spl')
printf 'fn weird():\n    pass\n' >"$primary/$weird_rel"
clean_git -C "$primary" add -- "$weird_rel"
clean_git -C "$primary" commit -q -m weird-path-baseline
clean_git -C "$primary" update-ref refs/remotes/origin/main HEAD
printf 'fn weird():\n    # DEBUGME weird-path residue\n    pass\n' \
    >"$primary/$weird_rel"
run_case nul_path_residue 1 "$primary" 'FAIL — residue found in 1 file(s)'
clean_git -C "$primary" restore -- "$weird_rel"

# Candidate filenames containing pathspec metacharacters must be queried as
# literal origin paths, never as patterns selecting siblings.
glob_rel='src/example/glob[*]?.spl'
printf 'fn glob_name():\n    pass\n' >"$primary/$glob_rel"
clean_git -C "$primary" add -- "$glob_rel"
clean_git -C "$primary" commit -q -m glob-path-baseline
clean_git -C "$primary" update-ref refs/remotes/origin/main HEAD
printf 'fn glob_name():\n    # TEMP-PROBE glob-path residue\n    pass\n' \
    >"$primary/$glob_rel"
run_case literal_pathspec_residue 1 "$primary" \
    'FAIL — residue found in 1 file(s)'
clean_git -C "$primary" restore -- "$glob_rel"

# Missing origin/main is an evidence error even in an otherwise valid repo.
missing_origin="$test_tmp/missing-origin"
install_guard "$missing_origin"
printf 'fn main():\n    pass\n' >"$missing_origin/src/example/app.spl"
clean_git init -q "$missing_origin"
clean_git -C "$missing_origin" config user.email guard@test
clean_git -C "$missing_origin" config user.name guard
clean_git -C "$missing_origin" add scripts/check/check-no-sabotage-residue.shs \
    src/example/app.spl
clean_git -C "$missing_origin" commit -q -m baseline
run_case missing_origin 2 "$missing_origin" 'ERROR — nothing was checked'

# Broken scan state is an evidence error. An invalid inherited index makes
# tracked-file enumeration fail before any PASS/FAIL comparison is possible.
printf 'not an index\n' >"$test_tmp/bad.index"
bad_index_output="$test_tmp/bad_index.out"
set +e
(cd "$primary" &&
    env -u GIT_DIR -u GIT_WORK_TREE \
        -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
        -u GIT_COMMON_DIR -u GIT_NAMESPACE -u GIT_CONFIG \
        -u GIT_CONFIG_COUNT GIT_INDEX_FILE="$test_tmp/bad.index" \
        sh scripts/check/check-no-sabotage-residue.shs) \
    >"$bad_index_output" 2>&1
bad_index_status=$?
set -e
[ "$bad_index_status" -eq 2 ] || {
    cat "$bad_index_output" >&2
    fail "bad index returned $bad_index_status, expected 2"
}
grep -Fq 'ERROR — nothing was checked' "$bad_index_output" ||
    fail "bad index omitted ERROR verdict"

# A missing origin blob exercises git-show/read failure after the commit/tree
# probes have succeeded; it must remain ERROR, never residue or PASS.
corrupt_origin="$test_tmp/corrupt-origin"
install_guard "$corrupt_origin"
printf 'fn main():\n    # SABOTAGE committed fixture text\n    pass\n' \
    >"$corrupt_origin/src/example/app.spl"
clean_git init -q "$corrupt_origin"
clean_git -C "$corrupt_origin" config user.email guard@test
clean_git -C "$corrupt_origin" config user.name guard
clean_git -C "$corrupt_origin" add scripts/check/check-no-sabotage-residue.shs \
    src/example/app.spl
clean_git -C "$corrupt_origin" commit -q -m baseline
clean_git -C "$corrupt_origin" update-ref refs/remotes/origin/main HEAD
blob=$(clean_git -C "$corrupt_origin" rev-parse \
    origin/main:src/example/app.spl)
blob_dir=$(printf '%s' "$blob" | cut -c1-2)
blob_tail=$(printf '%s' "$blob" | cut -c3-)
blob_path="$corrupt_origin/.git/objects/$blob_dir/$blob_tail"
[ -f "$blob_path" ] || fail "corrupt-origin blob is not loose as expected"
rm -f "$blob_path"
run_case corrupt_origin_blob 2 "$corrupt_origin" 'ERROR — nothing was checked'

# Accounting helpers are also evidence-bearing. Force sort to fail after the
# scan finds a legitimate marker candidate and require ERROR/2.
fake_sort="$test_tmp/fake-sort"
mkdir -p "$fake_sort"
printf '#!/bin/sh\nexit 7\n' >"$fake_sort/sort"
chmod +x "$fake_sort/sort"
sort_output="$test_tmp/sort_failure.out"
set +e
(cd "$primary" &&
    PATH="$fake_sort:$PATH" \
    env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
        -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
        -u GIT_COMMON_DIR -u GIT_NAMESPACE -u GIT_CONFIG \
        -u GIT_CONFIG_COUNT sh scripts/check/check-no-sabotage-residue.shs) \
    >"$sort_output" 2>&1
sort_status=$?
set -e
[ "$sort_status" -eq 2 ] || {
    cat "$sort_output" >&2
    fail "sort failure returned $sort_status, expected 2"
}
grep -Fq 'ERROR — nothing was checked' "$sort_output" ||
    fail "sort failure omitted ERROR verdict"

# Directories without Git metadata and genuinely bare repositories both lack a
# worktree to scan and must fail closed with status 2.
nonrepo="$test_tmp/nonrepo"
install_guard "$nonrepo"
printf 'fn main():\n    pass\n' >"$nonrepo/src/example/app.spl"
run_case nonrepo 2 "$nonrepo" 'ERROR — nothing was checked'

bare="$test_tmp/bare-layout"
install_guard "$bare"
printf 'fn main():\n    pass\n' >"$bare/src/example/app.spl"
clean_git init -q --bare "$bare/.git"
run_case bare_repo 2 "$bare" 'ERROR — nothing was checked'

echo "PASS: sabotage-residue guard contracts cover primary, linked, marker, and error paths"
