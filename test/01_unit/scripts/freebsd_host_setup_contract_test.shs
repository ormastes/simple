#!/bin/sh
# Test the thin platform guard and canonical argument forwarding, without a VM.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
mkdir -p "$tmp/bin" "$tmp/setup"
cp "$root/scripts/setup/setup-freebsd-host.shs" "$tmp/setup/"
cat >"$tmp/bin/uname" <<'EOF'
#!/bin/sh
printf '%s\n' "$SETUP_TEST_OS"
EOF
cat >"$tmp/setup/host-env.shs" <<'EOF'
#!/bin/sh
printf '%s\n' "$@" >"$SETUP_TEST_RECEIPT"
EOF
chmod +x "$tmp/bin/uname"
SETUP_TEST_RECEIPT="$tmp/args"
export SETUP_TEST_RECEIPT
PATH="$tmp/bin:$PATH" SETUP_TEST_OS=FreeBSD sh "$tmp/setup/setup-freebsd-host.shs"
printf '%s\n' --init --all-cores >"$tmp/expected"
cmp -s "$tmp/args" "$tmp/expected"
rm "$tmp/args"
if PATH="$tmp/bin:$PATH" SETUP_TEST_OS=Linux sh "$tmp/setup/setup-freebsd-host.shs" 2>"$tmp/error"; then
    echo 'FAIL non-FreeBSD host accepted' >&2; exit 1
fi
grep -q 'requires FreeBSD' "$tmp/error"
[ ! -e "$tmp/args" ]
if PATH="$tmp/bin:$PATH" SETUP_TEST_OS=FreeBSD sh "$tmp/setup/setup-freebsd-host.shs" --unknown 2>"$tmp/error"; then
    echo 'FAIL unknown argument accepted' >&2; exit 1
fi
[ ! -e "$tmp/args" ]
echo 'PASS: FreeBSD host initializer forwards canonical options and rejects other hosts/arguments'
