#!/bin/sh
# Execute only the canonical constructor's composition-selection fragment.
# No compiler, native job, seed, or bootstrap artifact is started.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
fragment="$scratch/constructor.sh"
awk '
  /^compiler_backend_manifest=/ { selected=1 }
  selected && /^case "\$\{SIMPLE_KERNEL_K1_POLICY/ { exit }
  selected { print }
' "$repo/scripts/bootstrap/bootstrap-from-scratch.sh" > "$fragment"
[ -s "$fragment" ]
bootstrap_stage3_hash_file() { sha256sum "$1" | awk '{print $1}'; }
fixture() {
  repo_root="$scratch/$1"
  output_dir="$repo_root/build/bootstrap"
  mkdir -p "$repo_root/src/compiler" "$repo_root/src/plugins/backend_registry"
  printf 'compiler_backends:\n  cuda:\n    enabled: %s\n    placement: %s\n' "$2" "$3" > "$repo_root/src/compiler/simple.sdn"
  printf 'fn selected_mode() -> text: "static"\n' > "$repo_root/src/plugins/backend_registry/selected_cuda_backend.spl"
  for fixture_mode in static dynamic disabled; do
    fixture_dir="$repo_root/src/compositions/cuda_$fixture_mode/plugins/backend_registry"
    mkdir -p "$fixture_dir"
    printf 'fn selected_mode() -> text: "%s"\n' "$fixture_mode" > "$fixture_dir/selected_cuda_backend.spl"
  done
}
positive() {
  fixture "$1" "$2" "$3"
  . "$fragment"
  [ "$cuda_source_root" = "$repo_root/src/compositions/cuda_$4" ]
  [ -f "$cuda_composition_file" ]
  cmp "$cuda_source_file" "$cuda_composition_file"
}
positive static true static static
positive dynamic true dynamic dynamic
positive disabled_static false static disabled
positive disabled_dynamic false dynamic disabled
fixture snapshot_binding true static
. "$fragment"
snapshot="$scratch/source-before.txt"
perl -MDigest::SHA=sha256_hex -e '
  my $root = shift;
  for my $path (@ARGV) {
    open my $in, "<", "$root/$path" or die $!;
    local $/; my $bytes = <$in>;
    print "file-hex:", length($path), ":", unpack("H*", $path), ":0:", sha256_hex($bytes), "\n";
  }
' "$repo_root" src/compiler/simple.sdn src/plugins/backend_registry/selected_cuda_backend.spl \
  src/compositions/cuda_static/plugins/backend_registry/selected_cuda_backend.spl > "$snapshot"
bootstrap_cuda_source_snapshot_require "$snapshot"
head -n 2 "$snapshot" > "$scratch/missing.txt"
if bootstrap_cuda_source_snapshot_require "$scratch/missing.txt" > "$scratch/negative.log" 2>&1; then exit 1; fi
grep -q 'snapshot member missing' "$scratch/negative.log"
cat "$snapshot" "$snapshot" > "$scratch/duplicate.txt"
if bootstrap_cuda_source_snapshot_require "$scratch/duplicate.txt" > "$scratch/negative.log" 2>&1; then exit 1; fi
grep -q 'snapshot identity mismatch' "$scratch/negative.log"
saved_manifest_sha=$cuda_manifest_sha256
cuda_manifest_sha256=$(printf 'changed policy' | sha256sum | awk '{print $1}')
if bootstrap_cuda_source_snapshot_require "$snapshot" > "$scratch/negative.log" 2>&1; then exit 1; fi
grep -q 'snapshot identity mismatch' "$scratch/negative.log"
cuda_manifest_sha256=$saved_manifest_sha
fixture canonical_mismatch true static
printf 'tampered\n' >> "$repo_root/src/compositions/cuda_static/plugins/backend_registry/selected_cuda_backend.spl"
if ( . "$fragment" ) > "$scratch/negative.log" 2>&1; then exit 1; fi
grep -q 'canonical CUDA composition differs' "$scratch/negative.log"
fixture generated_mismatch true static
. "$fragment"
printf 'tampered\n' >> "$cuda_composition_file"
if ( . "$fragment" ) > "$scratch/negative.log" 2>&1; then exit 1; fi
grep -q 'selected CUDA composition content differs' "$scratch/negative.log"
fixture generated_symlink true static
. "$fragment"
rm "$cuda_composition_file"
ln -s "$cuda_composition_template" "$cuda_composition_file"
if ( . "$fragment" ) > "$scratch/negative.log" 2>&1; then exit 1; fi
grep -q 'selected CUDA composition content differs' "$scratch/negative.log"
fixture bad_mode maybe static
if ( . "$fragment" ) > "$scratch/negative.log" 2>&1; then exit 1; fi
grep -q 'CUDA enabled must be' "$scratch/negative.log"
fixture duplicate_field true static
printf '    enabled: true\n' >> "$repo_root/src/compiler/simple.sdn"
if ( . "$fragment" ) > "$scratch/negative.log" 2>&1; then exit 1; fi
grep -q 'requires one compiler_backends.cuda.enabled' "$scratch/negative.log"
awk '
  /--source "\$\{cuda_composition_root\}"/ { bad++ }
  /--source "\$\{cuda_source_root\}"/ { canonical++ }
  END { if (bad != 0 || canonical != 7) exit 1 }
' "$repo/scripts/bootstrap/bootstrap-from-scratch.sh"
printf '%s\n' 'PASS: four CUDA policy modes; captured snapshot binding and missing/duplicate/drift negatives; canonical/generated mismatch, symlink, invalid and duplicate policy negatives; seven canonical source vectors'
