#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
session="$repo_root/src/os/smf/dynsmf_session.spl"

need() {
    grep -Fq "$1" "$session" || {
        echo "FAIL: dynSMF facet-count contract missing: $1" >&2
        exit 1
    }
}

need '_issued_facet_ref_count: i64'
need 'if session._issued_facet_ref_count >= DYNSMF_FACET_REF_MAX_ISSUED:'
need 'out._issued_facet_ref_count = out._issued_facet_ref_count + 1'
need 'out._issued_facet_ref_count = retained_count'
if grep -Fq '_issued_facet_refs.keys().len() >= DYNSMF_FACET_REF_MAX_ISSUED' "$session"; then
    echo "FAIL: facet admission rematerializes all issued token keys" >&2
    exit 1
fi

echo "dynsmf_facet_ref_count_cases=5"
echo "dynsmf_facet_ref_count_status=PASS"
