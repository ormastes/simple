#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM
owner="$root/scripts/bootstrap/bootstrap-from-scratch.sh"
awk '/^case "\$\{cuda_mode\}" in$/{copy=1} /^case "\$\{SIMPLE_KERNEL_K1_POLICY:-unselected\}" in$/{copy=0} copy{print}' "$owner" >"$work/cuda.sh"
awk '/^case "\$\{SIMPLE_KERNEL_K1_POLICY:-unselected\}" in$/{copy=1} copy{print} /^k1_composition_source_args=/{exit}' "$owner" >"$work/kernel.sh"
awk '/^[ ]*\$\{k1_composition_source_args\} --source .* --source src\/compiler --source src\/app --source src\/lib/ {sub(/\\$/, ""); print "set -- " $0; exit}' "$owner" >"$work/argv.sh"
awk '/^transcript_source_count\(\)/{copy=1} copy{print} copy && /^}/{exit}' "$root/scripts/bootstrap/write-k1-composition-receipt.shs" >"$work/receipt.sh"
test -s "$work/cuda.sh"; test -s "$work/kernel.sh"; test -s "$work/argv.sh"
# No native call may compile the generated external publication directory.
if grep -Fq -- '--source "${cuda_composition_root}"' "$owner"; then
    echo 'FAIL: external CUDA source selector remains' >&2; exit 1
fi
. "$root/scripts/check/lib/bootstrap-stage3/authority.shs"
. "$work/receipt.sh"
repo_root="$work/checkout"
for selector in src src/compositions/cuda_disabled src/compositions/cuda_dynamic; do
    mkdir -p "$repo_root/$selector/plugins/backend_registry"
    cp "$root/$selector/plugins/backend_registry/selected_cuda_backend.spl" "$repo_root/$selector/plugins/backend_registry/"
done
mkdir -p "$repo_root/src/compiler" "$repo_root/src/app" "$repo_root/src/lib" "$repo_root/src/compositions/kernel_llvm_cranelift"
printf 'compiler_backends:\n  cuda:\n    enabled: true\n    placement: static\n' >"$repo_root/simple.sdn"
compiler_backend_manifest="$repo_root/simple.sdn"
SIMPLE_KERNEL_K1_POLICY=llvm-cranelift
. "$work/kernel.sh"
test "$k1_composition_source_root" = src/compositions/kernel_llvm_cranelift
for cuda_mode in disabled dynamic static; do
    output_dir="$work/$cuda_mode"
    . "$work/cuda.sh"
    case "$cuda_mode" in
        static) expected=src ;;
        *) expected="src/compositions/cuda_$cuda_mode" ;;
    esac
    test "$cuda_composition_source_root" = "$expected"
    test -f "$repo_root/$cuda_composition_source_root/plugins/backend_registry/selected_cuda_backend.spl"
    cmp -s "$cuda_composition_template" "$cuda_composition_file"
    test "$(bootstrap_stage3_hash_file "$cuda_composition_file")" = "$cuda_template_sha256"
    . "$work/argv.sh"
    test "$#" = 10
    test "$2" = "$k1_composition_source_root"
    test "$4" = "$cuda_composition_source_root"
    while [ "$#" -gt 0 ]; do
        test "$1" = --source
        case "$2" in src|src/*) ;; *) echo "FAIL: unsupported source $2" >&2; exit 1 ;; esac
        test -d "$repo_root/$2"
        shift 2
    done
    printf 'tampered\n' >"$cuda_composition_file"
    if (. "$work/cuda.sh") >"$work/rejected-$cuda_mode.log" 2>&1; then
        echo 'FAIL: changed publication bytes accepted' >&2; exit 1
    fi
    grep -q 'composition content differs' "$work/rejected-$cuda_mode.log"
done
if (cuda_mode='../outside'; . "$work/cuda.sh") >"$work/bad-mode.log" 2>&1; then
    echo 'FAIL: unselected CUDA mode accepted' >&2; exit 1
fi
write_source() { printf 'argv:8:--source\nargv:%s:%s\n' "${#1}" "$1"; }
absolute="$repo_root/$k1_composition_source_root"
write_source "$absolute" >"$work/absolute"
write_source "$k1_composition_source_root" >"$work/relative"
cat "$work/absolute" "$work/relative" >"$work/duplicate"
write_source 'src/compositions/kernel_llvm' >"$work/wrong"
write_source 'src/compositions/../compositions/kernel_llvm_cranelift' >"$work/traversal"
test "$(transcript_source_count "$work/absolute" "$absolute")" = 1
test "$(transcript_source_count "$work/relative" "$absolute")" = 1
test "$(transcript_source_count "$work/duplicate" "$absolute")" = 2
test "$(transcript_source_count "$work/wrong" "$absolute")" = 0
test "$(transcript_source_count "$work/traversal" "$absolute")" = 0
echo 'PASS: three CUDA modes preserve published bytes and checkout source precedence; K1 exact spelling and duplicate contracts hold'
