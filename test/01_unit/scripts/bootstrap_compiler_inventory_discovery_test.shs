#!/bin/sh
# Exercise the production inventory function with controlled discovery failures.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/simple-compiler-inventory.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }

verifier=${PHASE_VERIFIER:-$root/scripts/bootstrap/bootstrap-phase-verification.shs}
sed -n '/^run_compiler_unit_tests() {/,/^}/p' "$verifier" >"$scratch/inventory.sh"
[ -s "$scratch/inventory.sh" ] || fail 'production inventory function is missing'
. "$scratch/inventory.sh"

source_root="$scratch/source"
mkdir -p "$source_root/scripts/bootstrap" "$source_root/test/01_unit/compiler"
cat >"$source_root/scripts/bootstrap/run-process-group-timeout.shs" <<'EOF'
#!/bin/sh
shift 2
exec "$@"
EOF
cat >"$scratch/runner" <<'EOF'
#!/bin/sh
printf '%s\n' "$1" >>"$INVENTORY_EXECUTIONS"
EOF
chmod +x "$scratch/runner" "$source_root/scripts/bootstrap/run-process-group-timeout.shs"
validate_command_owner_receipt() { return 0; }

# A filesystem walk can print valid paths before encountering an unreadable
# directory. A pipeline into sort must not erase that nonzero discovery status.
find() {
    printf '%s\n' "$source_root/test/01_unit/compiler/fixture_spec.spl"
    [ "$inventory_case" != discovery-error ]
}
sort() {
    command sort "$@"
    [ "$inventory_case" != sort-error ]
}

run_case() {
    inventory_case=$1
    case_root="$scratch/$inventory_case"
    logs="$case_root/logs"
    tmp="$case_root/tmp"
    home="$case_root/home"
    cache="$case_root/cache"
    summary="$case_root/summary.env"
    compiler_cli="$scratch/runner"
    spec_timeout_seconds=5
    INVENTORY_EXECUTIONS="$case_root/executions"
    export INVENTORY_EXECUTIONS
    mkdir -p "$logs" "$tmp" "$home" "$cache"
    : >"$summary"
    : >"$INVENTORY_EXECUTIONS"
    case_status=0
    run_compiler_unit_tests "$scratch/runner" fixture-receipt || case_status=$?
    if [ "$inventory_case" = complete ]; then
        [ "$case_status" -eq 0 ] || fail 'complete inventory was rejected'
        grep -Fq 'task=compiler_unit_tests|result=PASS|status=0' "$summary" ||
            fail 'complete inventory has no PASS receipt'
        [ "$(wc -l <"$INVENTORY_EXECUTIONS" | tr -d ' ')" = 1 ] ||
            fail 'complete inventory did not execute its only spec'
    else
        [ "$case_status" -ne 0 ] || fail "$inventory_case accepted a partial inventory"
        grep -Fq "task=compiler_unit_tests|result=FAIL|status=$inventory_case|" "$summary" ||
            fail "$inventory_case has no terminal failure receipt"
        [ ! -s "$INVENTORY_EXECUTIONS" ] || fail "$inventory_case executed an incomplete manifest"
    fi
}

run_case complete
run_case discovery-error
run_case sort-error
printf 'PASS: compiler inventory rejects discovery and sort failures (3 cases)\n'
