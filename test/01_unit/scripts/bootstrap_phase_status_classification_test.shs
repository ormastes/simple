#!/bin/sh
# Phase 2 must distinguish an external SIGKILL from an actual task deadline.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
script="$root/scripts/bootstrap/bootstrap-phase-verification.shs"
fail() { echo "FAIL: $*" >&2; exit 1; }

if grep -nF '124|137)' "$script"; then
    fail 'status 137 is still folded into timeout classification'
fi
grep -Fq '124) result=TIMEOUT ;;' "$script" || fail 'task deadline classification missing'
grep -Fq '124) row_result=TIMEOUT ;;' "$script" || fail 'repository-row deadline classification missing'
grep -Fq '124) result=TIMEOUT; timeout_count=$((timeout_count + 1)) ;;' "$script" ||
    fail 'repository summary deadline classification missing'
grep -Fq '*) result=FAIL ;;' "$script" || fail 'task external-kill fallback is not FAIL'
grep -Fq 'row_result=FAIL' "$script" || fail 'repository-row external-kill fallback is not FAIL'
printf '%s\n' 'PASS: Phase 2 status 124 is TIMEOUT; status 137 falls through to FAIL'
