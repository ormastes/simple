#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM
export LC_ALL=C

command -v openssl >/dev/null 2>&1 || {
    echo 'SKIP: openssl unavailable'
    exit 0
}

hash() { sha256sum "$1" | awk '{ print $1 }'; }
expect_reject() {
    name=$1
    shift
    if "$@" >"$work/$name.stdout" 2>"$work/$name.stderr"; then
        echo "FAIL: $name was admitted" >&2
        exit 1
    fi
    echo "PASS: $name rejected"
}

for name in artifact source build compiler abi; do
    printf '%s-v1\n' "$name" >"$work/$name"
done
openssl genpkey -algorithm ED25519 -out "$work/private.pem" >/dev/null 2>&1
openssl pkey -in "$work/private.pem" -pubout -out "$work/public.pem" >/dev/null 2>&1
openssl genpkey -algorithm ED25519 -out "$work/untrusted-private.pem" >/dev/null 2>&1

artifact_hash=$(hash "$work/artifact")
source_hash=$(hash "$work/source")
build_hash=$(hash "$work/build")
compiler_hash=$(hash "$work/compiler")
abi_hash=$(hash "$work/abi")
signature_hash=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
test_symbol=$(printf 'r%s_%s' t test)

printf 'schema\tsimple.sffi-verification-report.v1\nprovider_id\ttest.provider\nartifact_sha256\t%s\nabi_registry_sha256\t%s\nresult\tpass\n' \
    "$artifact_hash" "$abi_hash" >"$work/report.tsv"
report_hash=$(hash "$work/report.tsv")
printf 'schema\tsimple.sffi-evidence.v1\nprovider_id\ttest.provider\ntarget\tx86_64-linux\nsigner_key_id\ttest-key\nartifact_sha256\t%s\ncanonical_source_tree_sha256\t%s\nexact_build_input_sha256\t%s\ncompiler_artifact_sha256\t%s\nabi_registry_sha256\t%s\nverification_report_sha256\t%s\nevidence_verified\ttrue\nsymbol_count\t1\nsymbol\t%s\t%s\n' \
    "$artifact_hash" "$source_hash" "$build_hash" "$compiler_hash" \
    "$abi_hash" "$report_hash" "$test_symbol" "$signature_hash" >"$work/manifest.tsv"
printf 'test-key\ttest.provider\tpublic.pem\n' >"$work/trust.tsv"
openssl pkeyutl -sign -inkey "$work/private.pem" -rawin \
    -in "$work/manifest.tsv" -out "$work/signature.bin"

verify() {
    sh "$root/scripts/audit/sffi-evidence-admission.shs" \
        "$work/manifest.tsv" "$work/signature.bin" "$work/trust.tsv" \
        "$work/artifact" "$work/source" "$work/build" "$work/compiler" \
        "$work/abi" "$work/report.tsv" "$work/admission.tsv"
}

verify >/dev/null
grep -q "^$test_symbol	$signature_hash	$artifact_hash	true	true$" "$work/admission.tsv"
echo 'PASS: exact signed evidence admitted'

cp "$work/artifact" "$work/artifact.good"
printf 'tamper\n' >>"$work/artifact"
expect_reject tampered-artifact verify
mv "$work/artifact.good" "$work/artifact"

cp "$work/report.tsv" "$work/report.good"
sed 's/result	pass/result	fail/' "$work/report.good" >"$work/report.tsv"
expect_reject stale-report-digest verify
failed_report_hash=$(hash "$work/report.tsv")
cp "$work/manifest.tsv" "$work/manifest.good"
sed "s/$report_hash/$failed_report_hash/" "$work/manifest.good" >"$work/manifest.tsv"
openssl pkeyutl -sign -inkey "$work/private.pem" -rawin \
    -in "$work/manifest.tsv" -out "$work/signature.bin"
expect_reject signed-failed-report verify
mv "$work/report.good" "$work/report.tsv"
mv "$work/manifest.good" "$work/manifest.tsv"
openssl pkeyutl -sign -inkey "$work/private.pem" -rawin \
    -in "$work/manifest.tsv" -out "$work/signature.bin"

printf 'other-key\ttest.provider\tpublic.pem\n' >"$work/trust.tsv"
expect_reject untrusted-key verify
printf 'test-key\ttest.provider\tpublic.pem\n' >"$work/trust.tsv"

cp "$work/manifest.tsv" "$work/manifest.good"
sed '1h;1d;2G' "$work/manifest.good" >"$work/manifest.tsv"
openssl pkeyutl -sign -inkey "$work/private.pem" -rawin \
    -in "$work/manifest.tsv" -out "$work/signature.bin"
expect_reject noncanonical-manifest verify
mv "$work/manifest.good" "$work/manifest.tsv"

printf 'test-key\ttest.provider\tpublic.pem\ntest-key\ttest.provider\tpublic.pem\n' >"$work/trust.tsv"
openssl pkeyutl -sign -inkey "$work/private.pem" -rawin \
    -in "$work/manifest.tsv" -out "$work/signature.bin"
expect_reject duplicate-trust-entry verify
printf 'test-key\ttest.provider\tpublic.pem\n' >"$work/trust.tsv"

openssl pkeyutl -sign -inkey "$work/untrusted-private.pem" -rawin \
    -in "$work/manifest.tsv" -out "$work/signature.bin"
expect_reject substituted-signature verify

echo 'STATUS: PASS sffi-evidence-admission-contract'
