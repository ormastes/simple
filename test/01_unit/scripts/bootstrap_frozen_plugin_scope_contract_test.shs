#!/bin/sh
# Source-vector contract only: no compiler, bootstrap job, or native artifact.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
script="$repo/scripts/bootstrap/bootstrap-from-scratch.sh"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
check_vectors() {
  awk '
    function check(statement, cuda, plugins, k1, count, copy) {
      cuda=index(statement, "--source \"${cuda_source_root}\"")
      if (!cuda) return
      routes++
      plugins=index(statement, "--source \"${plugin_policy_source_root}\"")
      copy=statement
      count=gsub(/--source "\$\{plugin_policy_source_root\}"/, "", copy)
      if (!plugins || count != 1 || plugins < cuda) bad++
      k1=index(statement, "${k1_composition_source_args}")
      if (k1) {
        k1_routes++
        if (k1 > cuda) bad++
      }
    }
    {
      line=$0
      if (line ~ /\\$/) {
        sub(/\\$/, "", line)
        statement=statement line " "
      } else {
        statement=statement line
        check(statement)
        statement=""
      }
    }
    END {
      if (statement != "") check(statement)
      if (routes != 7 || k1_routes != 4 || bad) exit 1
    }
  ' "$1"
}
check_vectors "$script"
# Every route is independently required, including command-transcript vectors.
for omit in 1 2 3 4 5 6 7; do
  awk -v omit="$omit" '
    /--source "\$\{plugin_policy_source_root\}"/ {
      seen++
      if (seen == omit) sub(/--source "\$\{plugin_policy_source_root\}"/, "")
    }
    { print }
  ' "$script" > "$scratch/missing-$omit.sh"
  if check_vectors "$scratch/missing-$omit.sh"; then
    echo "FAIL: route $omit accepted a missing plugin root" >&2
    exit 1
  fi
done
# A default static owner must never precede the selected CUDA overlay.
awk '
  {
    gsub(/--source "\$\{cuda_source_root\}"/, "--source \"COMPOSITION_SWAP\"")
    gsub(/--source "\$\{plugin_policy_source_root\}"/, "--source \"${cuda_source_root}\"")
    gsub(/--source "COMPOSITION_SWAP"/, "--source \"${plugin_policy_source_root}\"")
    print
  }
' "$script" > "$scratch/reversed.sh"
if check_vectors "$scratch/reversed.sh"; then
  echo 'FAIL: accepted default plugin root before selected CUDA' >&2
  exit 1
fi
printf '%s\n' 'PASS: seven plugin source vectors; four K1 transcript/execution vectors; seven omission negatives and CUDA precedence inversion rejected'
