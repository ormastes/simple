#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
watcher="${repo_root}/scripts/bootstrap/bootstrap-progress-watch.shs"
test_tmp=$(mktemp -d)
owned_pids=

cleanup() {
  for owned_pid in ${owned_pids}; do
    kill "${owned_pid}" 2>/dev/null || true
  done
  for owned_pid in ${owned_pids}; do
    wait "${owned_pid}" 2>/dev/null || true
  done
  rm -rf "${test_tmp}"
}
trap cleanup EXIT INT TERM

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

field() {
  field_name=$1
  line=$2
  printf '%s\n' "${line}" | tr ' ' '\n' | sed -n "s/^${field_name}=//p"
}

# Exact case: include the watched shell and its child, but not this independent
# watcher process.
sh -c 'sleep 30 & wait' &
nested_root=$!
owned_pids="${nested_root}"
nested_child=
attempt=0
while [ -z "${nested_child}" ] && [ "${attempt}" -lt 50 ]; do
  nested_child=$(ps -o pid= --ppid "${nested_root}" 2>/dev/null | awk 'NF {print $1; exit}')
  attempt=$((attempt + 1))
done
[ -n "${nested_child}" ] || fail "nested child did not start"
owned_pids="${nested_child} ${owned_pids}"
nested_log="${test_tmp}/nested.log"
sh "${watcher}" --pid="${nested_root}" --progress-log="${nested_log}" --once
nested_line=$(tail -n 1 "${nested_log}")
[ "$(field pid "${nested_line}")" = "${nested_root}" ] || fail "root PID changed"
[ "$(field tree_processes "${nested_line}")" -eq 2 ] || fail "nested tree count is not exactly two"
[ "$(field tree_rss_kb "${nested_line}")" -gt "$(field rss_kb "${nested_line}")" ] ||
  fail "nested tree RSS does not exceed root RSS"
[ "$(field done "${nested_line}")" = "unknown" ] || fail "missing event did not fall back to unknown"
[ "$(field terminal "${nested_line}")" = "unknown" ] || fail "missing terminal did not fall back to unknown"

# Second RSS basis must be present and non-vacuous. The parent-chain sum alone
# silently loses a re-parented worker or an unreadable subtree -- that is how a
# 67.4 GB stage-3 compile logged tree_rss_kb=34753460 (34.7 GB), a total
# smaller than one live process. The process-group sum cannot lose a subtree to
# re-parenting, so it bounds the chain sum from below. NEGATIVE CONTROL: revert
# the pgrp tracking in bootstrap-progress-watch.shs and all three fields report
# `unknown`, failing the numeric comparisons below.
nested_pg=$(field tree_rss_pgroup_kb "${nested_line}")
nested_misses=$(field tree_scan_misses "${nested_line}")
case "${nested_pg}" in ''|*[!0-9]*) fail "tree_rss_pgroup_kb is not numeric: ${nested_pg}" ;; esac
case "${nested_misses}" in ''|*[!0-9]*) fail "tree_scan_misses is not numeric: ${nested_misses}" ;; esac
case "$(field tree_pgroup_processes "${nested_line}")" in
  ''|*[!0-9]*) fail "tree_pgroup_processes is not numeric" ;;
esac
[ "${nested_pg}" -ge "$(field tree_rss_kb "${nested_line}")" ] ||
  fail "process-group RSS basis (${nested_pg}) is below the parent-chain sum"

# Adjacent leaf case: a process with no descendants has identical root/tree RSS.
sleep 30 &
leaf_pid=$!
owned_pids="${leaf_pid} ${owned_pids}"
leaf_log="${test_tmp}/leaf.log"
event_log="${test_tmp}/build-progress.events"
printf '%s\n' 'event=build_progress phase=parse unit_kind=files done=64 total=130 remaining=999 tasks_done=1 tasks_total=6 tasks_remaining=999 failed=0 cached=7 current=file64 terminal=running' >>"${event_log}"
sh "${watcher}" --pid="${leaf_pid}" --progress-log="${leaf_log}" \
  --event-file="${event_log}" --once
leaf_line=$(tail -n 1 "${leaf_log}")
[ "$(field tree_processes "${leaf_line}")" -eq 1 ] || fail "leaf tree count is not one"
[ "$(field tree_rss_kb "${leaf_line}")" -eq "$(field rss_kb "${leaf_line}")" ] ||
  fail "leaf tree RSS differs from root RSS"
[ "$(field done "${leaf_line}")" -eq 64 ] || fail "first progress count missing"
[ "$(field remaining "${leaf_line}")" -eq 66 ] || fail "remaining was not recomputed"
[ "$(field tasks_remaining "${leaf_line}")" -eq 5 ] || fail "task remaining was not recomputed"

printf '%s\n' 'event=build_progress phase=parse unit_kind=files done=128 total=130 remaining=2 tasks_done=2 tasks_total=6 tasks_remaining=4 failed=0 cached=7 current=file128 terminal=running' >>"${event_log}"
sh "${watcher}" --pid="${leaf_pid}" --progress-log="${leaf_log}" \
  --event-file="${event_log}" --once
monotonic_line=$(tail -n 1 "${leaf_log}")
[ "$(field done "${monotonic_line}")" -gt "$(field done "${leaf_line}")" ] ||
  fail "done count did not advance monotonically"
[ "$(field tasks_done "${monotonic_line}")" -gt "$(field tasks_done "${leaf_line}")" ] ||
  fail "task count did not advance monotonically"

printf '%s\n' 'event=build_progress phase=parse done=broken total=130 current=partial' >>"${event_log}"
sh "${watcher}" --pid="${leaf_pid}" --progress-log="${leaf_log}" \
  --event-file="${event_log}" --once
malformed_line=$(tail -n 1 "${leaf_log}")
[ "$(field done "${malformed_line}")" = "unknown" ] || fail "malformed done was accepted"
[ "$(field remaining "${malformed_line}")" = "unknown" ] || fail "partial remaining was fabricated"
[ "$(field terminal "${malformed_line}")" = "unknown" ] || fail "partial terminal was fabricated"

printf '%s\n' 'event=build_progress phase=link unit_kind=objects done=130 total=130 remaining=0 tasks_done=6 tasks_total=6 tasks_remaining=0 failed=0 cached=7 current=output terminal=succeeded' >>"${event_log}"
sh "${watcher}" --pid="${leaf_pid}" --progress-log="${leaf_log}" \
  --event-file="${event_log}" --once
terminal_line=$(tail -n 1 "${leaf_log}")
[ "$(field remaining "${terminal_line}")" -eq 0 ] || fail "terminal remaining is not zero"
[ "$(field tasks_remaining "${terminal_line}")" -eq 0 ] || fail "terminal tasks remaining is not zero"
[ "$(field terminal "${terminal_line}")" = "succeeded" ] || fail "terminal state missing"
[ "$(field cached "${terminal_line}")" -eq 7 ] || fail "terminal cached count missing"

# Adjacent exited case: preserve the existing terminal event without fake metrics.
sleep 0 &
exited_pid=$!
wait "${exited_pid}"
exited_log="${test_tmp}/exited.log"
sh "${watcher}" --pid="${exited_pid}" --progress-log="${exited_log}" --once
exited_line=$(tail -n 1 "${exited_log}")
[ "$(field status "${exited_line}")" = "exited" ] || fail "exited PID was not reported exited"
[ "$(field terminal "${exited_line}")" = "exited" ] || fail "exited terminal state missing"
case "${exited_line}" in
  *tree_rss_kb=*) fail "exited event reported fabricated tree metrics" ;;
esac

echo "PASS: bootstrap progress watcher tree and build counters"
