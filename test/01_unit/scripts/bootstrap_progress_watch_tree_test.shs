#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
watcher="${repo_root}/scripts/bootstrap/bootstrap-progress-watch.shs"
test_tmp=$(mktemp -d)
owned_pids=

cleanup() {
  for owned_pid in ${owned_pids}; do
    kill "${owned_pid}" 2>/dev/null || true
  done
  for owned_pid in ${owned_pids}; do
    wait "${owned_pid}" 2>/dev/null || true
  done
  rm -rf "${test_tmp}"
}
trap cleanup EXIT INT TERM

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

field() {
  field_name=$1
  line=$2
  printf '%s\n' "${line}" | tr ' ' '\n' | sed -n "s/^${field_name}=//p"
}

# Deterministic Darwin/BSD process-table provider. The production watcher still
# uses real ps by default; this injection makes snapshot failures, PID reuse,
# process-group membership, and exclusion independently reproducible.
fake_ps="${test_tmp}/fake-ps.sh"
cat >"${fake_ps}" <<'EOF'
#!/bin/sh
set -eu
count=0
[ ! -f "${FAKE_PS_COUNT}" ] || count=$(cat "${FAKE_PS_COUNT}")
count=$((count + 1))
printf '%s\n' "${count}" >"${FAKE_PS_COUNT}"
root=${BOOTSTRAP_WATCH_METRICS_ROOT}
exclude=${BOOTSTRAP_WATCH_METRICS_EXCLUDE}
row() { printf '%s %s %s %s %s %s %s\n' "$1" "$2" "$3" "$4" "$5" "$6" "$7"; }
birth_a='Sun Sep 21 10:00:00 2026'
birth_b='Sun Sep 21 10:00:01 2026'
case "${FAKE_PS_MODE}" in
  fail) exit 1 ;;
  fail_first)
    [ "${count}" -ne 1 ] || exit 1
    row "${root}" 1 700 100 "${birth_a}" 0:00.10 root
    ;;
  busy)
    row "${root}" 1 700 100 "${birth_a}" 0:00.10 root
    [ "${count}" -eq 1 ] && child_time=0:00.10 || child_time=0:00.70
    row 710 "${root}" 700 200 "${birth_a}" "${child_time}" worker
    ;;
  reuse)
    row "${root}" 1 700 100 "${birth_a}" 0:00.10 root
    [ "${count}" -eq 1 ] && child_birth=${birth_a} || child_birth=${birth_b}
    row 711 "${root}" 700 200 "${child_birth}" 0:00.20 recycled
    ;;
  pgroup)
    row "${root}" 1 700 100 "${birth_a}" 0:00.10 root
    row 712 "${root}" 700 200 "${birth_a}" 0:00.10 child
    row 713 1 700 400 "${birth_a}" 0:00.10 orphan
    ;;
  exclude)
    row "${root}" 1 700 100 "${birth_a}" 0:00.10 root
    row 714 "${root}" 700 200 "${birth_a}" 0:00.10 child
    row "${exclude}" "${root}" 700 500 "${birth_a}" 0:00.10 watcher
    row 715 "${exclude}" 700 600 "${birth_a}" 0:00.10 watcher_child
    ;;
  *) exit 2 ;;
esac
EOF
chmod +x "${fake_ps}"

fake_sample() {
  fake_mode=$1
  fake_log="${test_tmp}/fake-${fake_mode}.log"
  fake_count="${test_tmp}/fake-${fake_mode}.count"
  FAKE_PS_MODE=${fake_mode} FAKE_PS_COUNT=${fake_count} \
    BOOTSTRAP_WATCH_PS_COMMAND=${fake_ps} \
    sh "${watcher}" --pid="${leaf_pid}" --progress-log="${fake_log}" --once
  tail -n 1 "${fake_log}"
}

# Exact case: include the watched shell and its child, but not this independent
# watcher process.
sh -c 'sleep 30 & wait' &
nested_root=$!
owned_pids="${nested_root}"
nested_child=
attempt=0
while [ -z "${nested_child}" ] && [ "${attempt}" -lt 50 ]; do
  # BSD/macOS ps has no --ppid selector.  A single portable table snapshot also
  # matches the watcher's Darwin backend and avoids a Linux-only false pass.
  nested_child=$(ps -axo pid=,ppid= 2>/dev/null |
    awk -v parent="${nested_root}" '$2 == parent {print $1; exit}')
  attempt=$((attempt + 1))
done
[ -n "${nested_child}" ] || fail "nested child did not start"
owned_pids="${nested_child} ${owned_pids}"
nested_log="${test_tmp}/nested.log"
sh "${watcher}" --pid="${nested_root}" --progress-log="${nested_log}" --once
nested_line=$(tail -n 1 "${nested_log}")
[ "$(field pid "${nested_line}")" = "${nested_root}" ] || fail "root PID changed"
[ "$(field tree_processes "${nested_line}")" -eq 2 ] || fail "nested tree count is not exactly two"
[ "$(field tree_rss_kb "${nested_line}")" -gt "$(field rss_kb "${nested_line}")" ] ||
  fail "nested tree RSS does not exceed root RSS"
[ "$(field done "${nested_line}")" = "unknown" ] || fail "missing event did not fall back to unknown"
[ "$(field terminal "${nested_line}")" = "unknown" ] || fail "missing terminal did not fall back to unknown"

# Adjacent leaf case: a process with no descendants has identical root/tree RSS.
sleep 30 &
leaf_pid=$!
owned_pids="${leaf_pid} ${owned_pids}"
leaf_log="${test_tmp}/leaf.log"
event_log="${test_tmp}/build-progress.events"
printf '%s\n' 'event=build_progress phase=parse unit_kind=files done=64 total=130 remaining=999 tasks_done=1 tasks_total=6 tasks_remaining=999 failed=0 cached=7 current=file64 terminal=running' >>"${event_log}"
sh "${watcher}" --pid="${leaf_pid}" --progress-log="${leaf_log}" \
  --event-file="${event_log}" --once
leaf_line=$(tail -n 1 "${leaf_log}")
[ "$(field tree_processes "${leaf_line}")" -eq 1 ] || fail "leaf tree count is not one"
[ "$(field tree_rss_kb "${leaf_line}")" -eq "$(field rss_kb "${leaf_line}")" ] ||
  fail "leaf tree RSS differs from root RSS"
[ "$(field done "${leaf_line}")" -eq 64 ] || fail "first progress count missing"
[ "$(field remaining "${leaf_line}")" -eq 66 ] || fail "remaining was not recomputed"
[ "$(field tasks_remaining "${leaf_line}")" -eq 5 ] || fail "task remaining was not recomputed"

printf '%s\n' 'event=build_progress phase=parse unit_kind=files done=128 total=130 remaining=2 tasks_done=2 tasks_total=6 tasks_remaining=4 failed=0 cached=7 current=file128 terminal=running' >>"${event_log}"
sh "${watcher}" --pid="${leaf_pid}" --progress-log="${leaf_log}" \
  --event-file="${event_log}" --once
monotonic_line=$(tail -n 1 "${leaf_log}")
[ "$(field done "${monotonic_line}")" -gt "$(field done "${leaf_line}")" ] ||
  fail "done count did not advance monotonically"
[ "$(field tasks_done "${monotonic_line}")" -gt "$(field tasks_done "${leaf_line}")" ] ||
  fail "task count did not advance monotonically"

printf '%s\n' 'event=build_progress phase=parse done=broken total=130 current=partial' >>"${event_log}"
sh "${watcher}" --pid="${leaf_pid}" --progress-log="${leaf_log}" \
  --event-file="${event_log}" --once
malformed_line=$(tail -n 1 "${leaf_log}")
[ "$(field done "${malformed_line}")" = "unknown" ] || fail "malformed done was accepted"
[ "$(field remaining "${malformed_line}")" = "unknown" ] || fail "partial remaining was fabricated"
[ "$(field terminal "${malformed_line}")" = "unknown" ] || fail "partial terminal was fabricated"

printf '%s\n' 'event=build_progress phase=link unit_kind=objects done=130 total=130 remaining=0 tasks_done=6 tasks_total=6 tasks_remaining=0 failed=0 cached=7 current=output terminal=succeeded' >>"${event_log}"
sh "${watcher}" --pid="${leaf_pid}" --progress-log="${leaf_log}" \
  --event-file="${event_log}" --once
terminal_line=$(tail -n 1 "${leaf_log}")
[ "$(field remaining "${terminal_line}")" -eq 0 ] || fail "terminal remaining is not zero"
[ "$(field tasks_remaining "${terminal_line}")" -eq 0 ] || fail "terminal tasks remaining is not zero"
[ "$(field terminal "${terminal_line}")" = "succeeded" ] || fail "terminal state missing"
[ "$(field cached "${terminal_line}")" -eq 7 ] || fail "terminal cached count missing"

# A failed ps snapshot reports unavailable evidence and a scan miss. It must
# never fabricate a zero-sized live tree.
failed_snapshot_line=$(fake_sample fail)
[ "$(field tree_processes "${failed_snapshot_line}")" = unknown ] ||
  fail "failed ps snapshot fabricated a process count"
[ "$(field tree_rss_kb "${failed_snapshot_line}")" = unknown ] ||
  fail "failed ps snapshot fabricated zero RSS"
[ "$(field tree_scan_misses "${failed_snapshot_line}")" -eq 1 ] ||
  fail "failed ps snapshot did not report a scan miss"

# A failed warmup must not establish CPU state for the subsequent good sample.
failed_warmup_line=$(fake_sample fail_first)
[ "$(field tree_cpu_pct "${failed_warmup_line}")" = unknown ] ||
  fail "failed warmup established a fabricated CPU baseline"

# CPU is a delta across two snapshots, not lifetime-average ps CPU.
busy_line=$(fake_sample busy)
busy_cpu=$(field tree_cpu_pct "${busy_line}")
awk -v value="${busy_cpu}" 'BEGIN { exit !(value > 0 && value <= 100) }' ||
  fail "busy child CPU delta was not measured: ${busy_cpu}"

# Reusing a PID with a different lstart identity counts the new process lifetime
# instead of inheriting or subtracting the dead process's CPU baseline.
reuse_line=$(fake_sample reuse)
reuse_cpu=$(field tree_cpu_pct "${reuse_line}")
awk -v value="${reuse_cpu}" 'BEGIN { exit !(value >= 10 && value <= 20) }' ||
  fail "recycled PID inherited its predecessor CPU baseline: ${reuse_cpu}"

# Parent-chain totals and process-group totals are deliberately independent.
pgroup_line=$(fake_sample pgroup)
[ "$(field tree_processes "${pgroup_line}")" -eq 2 ] || fail "parent tree included orphan"
[ "$(field tree_pgroup_processes "${pgroup_line}")" -eq 3 ] || fail "process group lost orphan"
[ "$(field tree_rss_kb "${pgroup_line}")" -eq 300 ] || fail "parent tree RSS is wrong"
[ "$(field tree_rss_pgroup_kb "${pgroup_line}")" -eq 700 ] || fail "process group RSS is wrong"

# The watcher and every nested watcher child are excluded from both totals.
exclude_line=$(fake_sample exclude)
[ "$(field tree_processes "${exclude_line}")" -eq 2 ] || fail "watcher subtree entered parent tree"
[ "$(field tree_pgroup_processes "${exclude_line}")" -eq 2 ] || fail "watcher subtree entered process group"
[ "$(field tree_rss_kb "${exclude_line}")" -eq 300 ] || fail "watcher subtree entered tree RSS"

# Adjacent exited case: preserve the existing terminal event without fake metrics.
sleep 0 &
exited_pid=$!
wait "${exited_pid}"
exited_log="${test_tmp}/exited.log"
sh "${watcher}" --pid="${exited_pid}" --progress-log="${exited_log}" --once
exited_line=$(tail -n 1 "${exited_log}")
[ "$(field status "${exited_line}")" = "exited" ] || fail "exited PID was not reported exited"
[ "$(field terminal "${exited_line}")" = "exited" ] || fail "exited terminal state missing"
case "${exited_line}" in
  *tree_rss_kb=*) fail "exited event reported fabricated tree metrics" ;;
esac

echo "PASS: bootstrap progress watcher tree and build counters"
