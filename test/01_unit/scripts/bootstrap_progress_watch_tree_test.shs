#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
watcher="${BOOTSTRAP_WATCH_SCRIPT:-${repo_root}/scripts/bootstrap/bootstrap-progress-watch.shs}"
test_tmp=$(mktemp -d)
owned_pids=

cleanup() {
  for owned_pid in ${owned_pids}; do
    kill "${owned_pid}" 2>/dev/null || true
  done
  for owned_pid in ${owned_pids}; do
    wait "${owned_pid}" 2>/dev/null || true
  done
  rm -rf "${test_tmp}"
}
trap cleanup EXIT INT TERM

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

field() {
  field_name=$1
  line=$2
  printf '%s\n' "${line}" | tr ' ' '\n' | sed -n "s/^${field_name}=//p"
}

# Exact case: include the watched shell and its child, but not this independent
# watcher process.
sh -c 'sleep 30 & wait' &
nested_root=$!
owned_pids="${nested_root}"
nested_child=
attempt=0
while [ -z "${nested_child}" ] && [ "${attempt}" -lt 50 ]; do
  nested_child=$(ps -o pid= --ppid "${nested_root}" 2>/dev/null | awk 'NF {print $1; exit}')
  attempt=$((attempt + 1))
done
[ -n "${nested_child}" ] || fail "nested child did not start"
owned_pids="${nested_child} ${owned_pids}"
nested_log="${test_tmp}/nested.log"
sh "${watcher}" --pid="${nested_root}" --progress-log="${nested_log}" --once
nested_line=$(tail -n 1 "${nested_log}")
[ "$(field pid "${nested_line}")" = "${nested_root}" ] || fail "root PID changed"
[ "$(field tree_processes "${nested_line}")" -eq 2 ] || fail "nested tree count is not exactly two"
[ "$(field tree_rss_kb "${nested_line}")" -gt "$(field rss_kb "${nested_line}")" ] ||
  fail "nested tree RSS does not exceed root RSS"
[ "$(field done "${nested_line}")" = "unknown" ] || fail "missing event did not fall back to unknown"
[ "$(field terminal "${nested_line}")" = "unknown" ] || fail "missing terminal did not fall back to unknown"

# FreeBSD/macOS do not expose Linux /proc. Force the portable ps backend on
# this Linux host so the same parent-tree contract is covered without a VM.
ps_nested_log="${test_tmp}/nested-ps.log"
BOOTSTRAP_WATCH_PROCESS_SOURCE=ps sh "${watcher}" --pid="${nested_root}" \
  --progress-log="${ps_nested_log}" --once
ps_nested_line=$(tail -n 1 "${ps_nested_log}")
[ "$(field tree_processes "${ps_nested_line}")" -eq 2 ] ||
  fail "ps backend tree count is not exactly two"
[ "$(field tree_cpu_basis "${ps_nested_line}")" = "ps-tree" ] ||
  fail "ps backend did not publish its tree CPU basis"

# Deterministic two-sample CPU and process-group fixture. The fake ps table
# keeps the parent and one child at zero CPU, then advances a reparented row in
# the root's PGID. This proves the fallback sees work after a parent-chain
# break, derives a delta across samples, and refuses a false stall verdict.
ps_fixture_dir="${test_tmp}/ps-bin"
mkdir -p "${ps_fixture_dir}"
ps_counter="${test_tmp}/ps-counter"
ps_stub="${ps_fixture_dir}/ps"
printf '%s\n' \
  '#!/bin/sh' \
  'case "$2" in' \
  '  lstart=) printf "%s\n" "Mon Sep 21 00:00:00 2026"; exit 0 ;;' \
  '  etime=) printf "%s\n" "00:10"; exit 0 ;;' \
  'esac' \
  'case "$2" in' \
  '  -axo)' \
  '    count=$(sed -n "1p" "$FIXTURE_COUNTER" 2>/dev/null || printf "0")' \
  '    case "$count" in ""|*[!0-9]*) count=0 ;; esac' \
  '    count=$((count + 1))' \
  '    printf "%s\n" "$count" >"$FIXTURE_COUNTER"' \
  '    child=987654321' \
  '    orphan=987654322' \
  '    printf "%s\n" "PID PPID PGID STATE LSTART TIME RSS COMMAND"' \
  '    printf "%s %s %s S Mon Sep 21 00:00:00 2026 0:00.00 100 sh\n" "$FIXTURE_ROOT" 1 "$FIXTURE_ROOT"' \
  '    printf "%s %s %s R Mon Sep 21 00:00:00 2026 0:00.00 100 awk\n" "$child" "$FIXTURE_ROOT" "$FIXTURE_ROOT"' \
  '    printf "%s %s %s R Mon Sep 21 00:00:00 2026 0:%02d.00 1000 orphan\n" "$orphan" 1 "$FIXTURE_ROOT" "$count"' \
  '    exit 0 ;;' \
  'esac' \
  'exit 1' >"${ps_stub}"
chmod +x "${ps_stub}"
ps_fixture_root_pid=
sleep 30 &
ps_fixture_root_pid=$!
owned_pids="${ps_fixture_root_pid} ${owned_pids}"
printf 'milestone=ps-pgroup\nmain_log=%s\n' "${test_tmp}/ps-pgroup.log" >"${test_tmp}/ps-pgroup.state"
printf '%s\n' abc >"${test_tmp}/ps-pgroup.log"
set +e
FIXTURE_ROOT="${ps_fixture_root_pid}" FIXTURE_COUNTER="${ps_counter}" \
  PATH="${ps_fixture_dir}:${PATH}" BOOTSTRAP_WATCH_PROCESS_SOURCE=ps \
  BOOTSTRAP_WATCH_STALL_SAMPLES=2 timeout 5 sh "${watcher}" \
  --pid="${ps_fixture_root_pid}" --state-file="${test_tmp}/ps-pgroup.state" \
  --progress-log="${test_tmp}/ps-pgroup.progress" --interval=1 \
  >/dev/null 2>&1
ps_fixture_status=$?
set -e
[ "${ps_fixture_status}" -eq 124 ] ||
  fail "two-sample ps fixture exited ${ps_fixture_status}, expected timeout 124"
ps_pgroup_line=$(tail -n 1 "${test_tmp}/ps-pgroup.progress")
[ "$(field tree_processes "${ps_pgroup_line}")" -eq 2 ] ||
  fail "ps fixture parent tree count is not two"
[ "$(field tree_pgroup_processes "${ps_pgroup_line}")" -eq 3 ] ||
  fail "ps fixture process-group count is not three"
[ "$(field tree_cpu_basis "${ps_pgroup_line}")" = "ps-pgroup" ] ||
  fail "ps fixture did not select process-group CPU basis"
ps_pgroup_cpu=$(field tree_cpu_pct "${ps_pgroup_line}")
ps_cpu_samples=0
while IFS= read -r ps_sample_line; do
  ps_sample_cpu=$(field tree_cpu_pct "${ps_sample_line}")
  case "${ps_sample_cpu}" in
    unknown|'') continue ;;
  esac
  ps_cpu_samples=$((ps_cpu_samples + 1))
  awk -v cpu="${ps_sample_cpu}" 'BEGIN { exit !(cpu + 0 >= 50 && cpu + 0 <= 150) }' ||
    fail "ps fixture CPU delta was ${ps_sample_cpu}; expected stable 50..150 percent"
done <"${test_tmp}/ps-pgroup.progress"
[ "${ps_cpu_samples}" -ge 2 ] ||
  fail "ps fixture produced ${ps_cpu_samples} numeric CPU samples, expected at least two"
if grep -Fq 'status=alive-no-progress' "${test_tmp}/ps-pgroup.progress"; then
  fail "busy ps process-group fixture was reported alive-no-progress"
fi
printf 'ps-fixture: tree_cpu_pct=%s basis=%s tree_processes=%s pgroup_processes=%s false_stall=false\n' \
  "${ps_pgroup_cpu}" "$(field tree_cpu_basis "${ps_pgroup_line}")" \
  "$(field tree_processes "${ps_pgroup_line}")" \
  "$(field tree_pgroup_processes "${ps_pgroup_line}")"

# Adjacent leaf case: a process with no descendants has identical root/tree RSS.
sleep 30 &
leaf_pid=$!
owned_pids="${leaf_pid} ${owned_pids}"
leaf_log="${test_tmp}/leaf.log"
event_log="${test_tmp}/build-progress.events"
printf '%s\n' 'event=build_progress phase=parse unit_kind=files done=64 total=130 remaining=999 tasks_done=1 tasks_total=6 tasks_remaining=999 failed=0 cached=7 current=file64 terminal=running' >>"${event_log}"
sh "${watcher}" --pid="${leaf_pid}" --progress-log="${leaf_log}" \
  --event-file="${event_log}" --once
leaf_line=$(tail -n 1 "${leaf_log}")
[ "$(field tree_processes "${leaf_line}")" -eq 1 ] || fail "leaf tree count is not one"
[ "$(field tree_rss_kb "${leaf_line}")" -eq "$(field rss_kb "${leaf_line}")" ] ||
  fail "leaf tree RSS differs from root RSS"
[ "$(field done "${leaf_line}")" -eq 64 ] || fail "first progress count missing"
[ "$(field remaining "${leaf_line}")" -eq 66 ] || fail "remaining was not recomputed"
[ "$(field tasks_remaining "${leaf_line}")" -eq 5 ] || fail "task remaining was not recomputed"

printf '%s\n' 'event=build_progress phase=parse unit_kind=files done=128 total=130 remaining=2 tasks_done=2 tasks_total=6 tasks_remaining=4 failed=0 cached=7 current=file128 terminal=running' >>"${event_log}"
sh "${watcher}" --pid="${leaf_pid}" --progress-log="${leaf_log}" \
  --event-file="${event_log}" --once
monotonic_line=$(tail -n 1 "${leaf_log}")
[ "$(field done "${monotonic_line}")" -gt "$(field done "${leaf_line}")" ] ||
  fail "done count did not advance monotonically"
[ "$(field tasks_done "${monotonic_line}")" -gt "$(field tasks_done "${leaf_line}")" ] ||
  fail "task count did not advance monotonically"

printf '%s\n' 'event=build_progress phase=parse done=broken total=130 current=partial' >>"${event_log}"
sh "${watcher}" --pid="${leaf_pid}" --progress-log="${leaf_log}" \
  --event-file="${event_log}" --once
malformed_line=$(tail -n 1 "${leaf_log}")
[ "$(field done "${malformed_line}")" = "unknown" ] || fail "malformed done was accepted"
[ "$(field remaining "${malformed_line}")" = "unknown" ] || fail "partial remaining was fabricated"
[ "$(field terminal "${malformed_line}")" = "unknown" ] || fail "partial terminal was fabricated"

printf '%s\n' 'event=build_progress phase=link unit_kind=objects done=130 total=130 remaining=0 tasks_done=6 tasks_total=6 tasks_remaining=0 failed=0 cached=7 current=output terminal=succeeded' >>"${event_log}"
sh "${watcher}" --pid="${leaf_pid}" --progress-log="${leaf_log}" \
  --event-file="${event_log}" --once
terminal_line=$(tail -n 1 "${leaf_log}")
[ "$(field remaining "${terminal_line}")" -eq 0 ] || fail "terminal remaining is not zero"
[ "$(field tasks_remaining "${terminal_line}")" -eq 0 ] || fail "terminal tasks remaining is not zero"
[ "$(field terminal "${terminal_line}")" = "succeeded" ] || fail "terminal state missing"
[ "$(field cached "${terminal_line}")" -eq 7 ] || fail "terminal cached count missing"

# Adjacent exited case: preserve the existing terminal event without fake metrics.
sleep 0 &
exited_pid=$!
wait "${exited_pid}"
exited_log="${test_tmp}/exited.log"
sh "${watcher}" --pid="${exited_pid}" --progress-log="${exited_log}" --once
exited_line=$(tail -n 1 "${exited_log}")
[ "$(field status "${exited_line}")" = "exited" ] || fail "exited PID was not reported exited"
[ "$(field terminal "${exited_line}")" = "exited" ] || fail "exited terminal state missing"
case "${exited_line}" in
  *tree_rss_kb=*) fail "exited event reported fabricated tree metrics" ;;
esac

echo "PASS: bootstrap progress watcher tree and build counters"
