#!/bin/sh
set -eu

root=${1:-.}
script=$root/scripts/bootstrap/bootstrap-from-scratch.sh

test -f "$script"

body=$(sed -n '/^prepare_rust_authority_workspace()/,/^}/p' "$script")

printf '%s\n' "$body" | grep -Fq 'rm -rf "${rust_authority_home}" "${rust_authority_cargo_home}"'
printf '%s\n' "$body" | grep -Fq '"${rust_authority_tmp}"'
printf '%s\n' "$body" | grep -Fq 'mkdir -p "${rust_authority_target}"'

if printf '%s\n' "$body" | grep -Fq 'rm -rf "${rust_authority_root}"'; then
  echo 'FAIL: content-addressed Rust authority target is destroyed on retry' >&2
  exit 1
fi

printf '%s\n' 'PASS: Rust authority retry preserves fingerprint-matched Cargo target'
