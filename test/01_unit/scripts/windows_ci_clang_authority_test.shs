#!/bin/sh
# Keep Windows CI aligned with the Clang-only MinGW UCRT (CLANG64) authority.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
workflow="$root/.github/workflows/windows-build.yml"

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

# Default Windows CI = MinGW UCRT via MSYS2 CLANG64 (clang + LLD, gnullvm Rust
# host). MSVC stays selectable in-tree but CI builds only the GNU config.
for expected_binding in \
    'uses: msys2/setup-msys2@v2' \
    'msystem: CLANG64' \
    'mingw-w64-clang-x86_64-clang' \
    'mingw-w64-clang-x86_64-lld' \
    'RUST_HOST: x86_64-pc-windows-gnullvm' \
    'rustup set default-host "$RUST_HOST"' \
    'SIMPLE_WINDOWS_ABI: gnu' \
    'SIMPLE_LINKER_FLAVOR: gnu' \
    'CC_x86_64_pc_windows_gnullvm: clang' \
    'AR_x86_64_pc_windows_gnullvm: llvm-ar' \
    'sh scripts/check/check-bootstrap-windows-global-relocation.shs'; do
    grep -F "$expected_binding" "$workflow" >/dev/null ||
        fail "Windows CI binding missing: $expected_binding"
done

for forbidden_binding in \
    'choco install llvm' \
    'ilammy/msvc-dev-cmd' \
    'msystem: MINGW64' \
    'mingw-w64-x86_64-gcc' \
    'rust-target: x86_64-pc-windows-msvc' \
    'linker-flavor: msvc' \
    '=gcc' \
    '=g++' \
    '=cl.exe' \
    'clang-cl'; do
    if grep -Fiq "$forbidden_binding" "$workflow"; then
        fail "Windows CI retained forbidden compiler authority: $forbidden_binding"
    fi
done

setup_line=$(grep -nF -- '- name: Setup MSYS2 CLANG64' "$workflow" | cut -d: -f1)
host_line=$(grep -nF -- '- name: Select gnullvm Rust host' "$workflow" | cut -d: -f1)
seed_build_line=$(grep -nF -- '- name: Build Rust seed' "$workflow" | cut -d: -f1)
[ -n "$setup_line" ] && [ -n "$host_line" ] && [ -n "$seed_build_line" ] &&
    [ "$setup_line" -lt "$host_line" ] && [ "$host_line" -lt "$seed_build_line" ] ||
    fail 'CLANG64 setup and gnullvm host selection do not precede the seed build'
printf 'PASS: Windows CI binds MSYS2 CLANG64 clang/LLD and the gnullvm Rust host before the seed build and excludes alternate authorities\n'
