#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "${repo_root}/scripts/bootstrap/bootstrap-cache-policy.shs"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

if bootstrap_cache_force_clear_one_binary incremental one-binary; then
  fail "ordinary incremental one-binary build unexpectedly clears reusable cache"
fi
bootstrap_cache_force_clear_one_binary clean-release one-binary ||
  fail "clean release one-binary build must clear"
if bootstrap_cache_force_clear_one_binary incremental-unlimited one-binary; then
  fail "incremental-unlimited one-binary build unexpectedly clears reusable cache"
fi
if bootstrap_cache_force_clear_one_binary incremental-unlimited dynload; then
  fail "dynload build unexpectedly selected one-binary clearing"
fi

echo "PASS: bootstrap cache policy"
