#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "${repo_root}/scripts/bootstrap/bootstrap-cache-policy.shs"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

bootstrap_cache_force_clear_one_binary incremental one-binary ||
  fail "ordinary incremental one-binary build must retain conservative clearing"
bootstrap_cache_force_clear_one_binary clean-release one-binary ||
  fail "clean release one-binary build must clear"
if bootstrap_cache_force_clear_one_binary incremental-unlimited one-binary; then
  fail "incremental-unlimited one-binary build unexpectedly clears reusable cache"
fi
if bootstrap_cache_force_clear_one_binary incremental-unlimited dynload; then
  fail "dynload build unexpectedly selected one-binary clearing"
fi

[ "$(bootstrap_strategy_default)" = normal ] ||
  fail "normal must remain the default bootstrap strategy"
for strategy in adhoc normal full; do
  bootstrap_strategy_validate "${strategy}" ||
    fail "supported strategy rejected: ${strategy}"
done
if bootstrap_strategy_validate release; then
  fail "unknown strategy unexpectedly accepted"
fi
[ "$(bootstrap_strategy_failure_policy adhoc)" = fail-fast ] ||
  fail "adhoc failure policy changed"
[ "$(bootstrap_strategy_failure_policy normal)" = fail-fast ] ||
  fail "normal failure policy changed"
[ "$(bootstrap_strategy_failure_policy full)" = inventory-to-end ] ||
  fail "full must inventory failures to the end"
bootstrap_strategy_uses_incremental_cache normal ||
  fail "normal must reuse incremental caches"
bootstrap_strategy_uses_incremental_cache full ||
  fail "full promotion must reuse hash-identical normal cache results"
if bootstrap_strategy_uses_incremental_cache adhoc; then
  fail "adhoc cache policy must be explicitly selected by its task"
fi
bootstrap_strategy_runs_phase_verification normal ||
  fail "normal must schedule phase verification"
bootstrap_strategy_runs_phase_verification full ||
  fail "full must schedule phase verification"
if bootstrap_strategy_runs_phase_verification adhoc; then
  fail "adhoc unexpectedly scheduled the automatic matrix"
fi

echo "PASS: bootstrap cache policy"
