#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
WRAPPER="$ROOT_DIR/scripts/check/check-simpleos-toolchain-desktop-boot.shs"

[ -x "$WRAPPER" ] || {
    printf '%s\n' "FAIL: wrapper missing or not executable: $WRAPPER" >&2
    exit 1
}

output=$(sh "$WRAPPER" --self-test)
[ "$output" = 'STATUS: PASS simpleos-toolchain-desktop-boot receipt-contract self-test checked=16 platform_acceptance_claimed=false' ] || {
    printf '%s\n' "FAIL: unexpected self-test output: $output" >&2
    exit 1
}
printf '%s\n' "$output"
