#!/usr/bin/env bash
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
python3 - "$root" <<'PY'
import pathlib,subprocess,sys,tempfile
root=pathlib.Path(sys.argv[1]);source=(root/'scripts/setup/materialize-symlinks-windows.shs').read_text();a=source.index('pending_policy_allows() {');b=source.index('\n}',a)+2;function=source[a:b]
with tempfile.TemporaryDirectory() as tmp:
 work=pathlib.Path(tmp);policy=(root/'scripts/setup/windows-materialized-pending-policy.tsv').read_bytes();(work/'policy').write_bytes(policy)
 def allowed(path,target):return subprocess.run(['bash','-c',function+'\nwork_dir=$1;pending_policy_allows "$2" "$3"','probe',str(work),path,target]).returncode==0
 for name in ['domain_expert','project_expert','skill_command','spipe','template','tool_expert']:
  path='doc/00_llm_process/'+name;target='../../.spipe/spipe/doc/00_llm_process/'+name
  assert allowed(path,target)
  assert not allowed(path,target+'/changed')
 assert not allowed('doc/00_llm_process/arbitrary','../../.spipe/spipe/doc/00_llm_process/arbitrary')
 assert not allowed('src/compiler/missing','../external/missing')
 assert not allowed('doc/00_llm_process/domain_expert','../../outside/domain_expert')
print('PASS: exact six SPipe aliases accepted; changed targets and arbitrary pending paths rejected by production predicate')
PY
