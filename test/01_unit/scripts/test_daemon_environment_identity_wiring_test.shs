#!/usr/bin/env bash
set -euo pipefail

root="${SIMPLE_TEST_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)}"
client="$root/src/app/test_runner_new/test_runner_client.spl"
daemon="$root/src/app/test_daemon/light_daemon.spl"

fail() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }

grep -q 'my_pid + "\\n" + environment_digest' "$daemon" ||
  fail 'daemon lock does not atomically bind PID and environment identity'
grep -q 'test_daemon_environment_can_reuse_v1' "$client" ||
  fail 'client does not compare its environment with the daemon generation'
grep -q 'caller_environment = test_daemon_environment_identity_v1()' "$client" ||
  fail 'client does not capture a request environment identity'
grep -q 'light_request_encode_v2' "$client" ||
  fail 'request does not carry environment and generation identity'
grep -q 'light_request_matches_daemon_v2' "$daemon" ||
  fail 'daemon does not validate request identity before execution'

printf 'test_daemon_environment_identity_wiring_test: PASS\n'
