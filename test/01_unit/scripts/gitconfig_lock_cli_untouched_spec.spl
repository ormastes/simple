"""
# Gitconfig Lock Untouched CLI Regression Prevention Spec

Prevention coverage for `simple_cli_invocation_attempts_user_gitconfig_lock_2026-09-09`:
runs `scripts/check/check-gitconfig-lock-untouched.shs` and verifies the script
enforces `LOCAL_CONFIG=1` default in `setup-ci-receipt-key.shs` without touching
`~/.gitconfig` or `~/.gitconfig.lock`.
"""

use std.spec.*
use std.io_runtime.{file_read}
use app.io.process_ops.{process_run}

describe "check-gitconfig-lock-untouched regression gate":
    """Verifies CLI invocations and key setup never touch global gitconfig or lock."""

    it "passes check-gitconfig-lock-untouched.shs end-to-end":
        val res = process_run("sh", ["-c",
            "out=$(sh scripts/check/check-gitconfig-lock-untouched.shs 2>&1); rc=$?; printf 'RC=%s\\n%s' \"$rc\" \"$out\""])
        val out: text = res.0
        expect(out).to_contain("RC=0")
        expect(out).to_contain("PASS")

    it "defaults setup-ci-receipt-key to local git config unless --global-config is opted in":
        val script_src = file_read("scripts/setup/setup-ci-receipt-key.shs")
        expect(script_src).to_contain("LOCAL_CONFIG=1")
        expect(script_src).to_contain("--global-config")
        expect(script_src).to_contain("git config --local")
