#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$root/scripts/check/lib/bootstrap-stage3/authority.shs"

fixture=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap-resume-output.XXXXXX")
trap 'rm -rf "$fixture"' EXIT HUP INT TERM
repo="$fixture/repo"
external="$fixture/external"
outside="$fixture/outside"
mkdir -p "$repo/build/admitted" "$external/admitted" "$outside"

fail() {
    echo "FAIL: $1" >&2
    exit 1
}

bootstrap_stage3_resume_output_path build/admitted "$repo" "$external" ||
    fail "canonical repository-relative output rejected"
[ "$BOOTSTRAP_STAGE3_RESUME_OUTPUT" = "$repo/build/admitted" ] ||
    fail "repository-relative output resolved incorrectly"

bootstrap_stage3_resume_output_path "$repo/build/admitted" "$repo" "$external" ||
    fail "allowlisted repository-absolute output rejected"
bootstrap_stage3_resume_output_path "$external/admitted" "$repo" "$external" ||
    fail "allowlisted external-absolute output rejected"
[ "$BOOTSTRAP_STAGE3_RESUME_OUTPUT" = "$external/admitted" ] ||
    fail "external-absolute output resolved incorrectly"

if bootstrap_stage3_resume_output_path "$outside" "$repo" "$external"; then
    fail "outside absolute output admitted"
fi
if bootstrap_stage3_resume_output_path "$external-evil/admitted" "$repo" "$external"; then
    fail "external-root prefix collision admitted"
fi
if bootstrap_stage3_resume_output_path ../outside "$repo" "$external"; then
    fail "relative traversal admitted"
fi

ln -s "$external/admitted" "$external/linked"
if bootstrap_stage3_resume_output_path "$external/linked" "$repo" "$external"; then
    fail "symlinked output leaf admitted"
fi
ln -s "$external" "$fixture/external-link"
if bootstrap_stage3_resume_output_path "$fixture/external-link/admitted" \
    "$repo" "$fixture/external-link"; then
    fail "symlinked allowlist root admitted"
fi

echo "PASS: Stage 3 resume output accepts only canonical allowlisted paths"
