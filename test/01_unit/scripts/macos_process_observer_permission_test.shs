#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
[ "$(uname -s)" = Darwin ] || { echo 'SKIP: Darwin observer permissions'; exit 0; }
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
"${CC:-cc}" -Wall -Wextra -Werror -O2 \
    "$root/test/01_unit/scripts/fixture_macos_observer_kernel_state.c" -o "$tmp/permission"
"$tmp/permission"
if command -v sandbox-exec >/dev/null 2>&1; then
    sandbox-exec -p '(version 1) (allow default) (deny process-info-pidinfo)' \
        "$tmp/permission" --sandbox-denial
else
    echo 'SKIP: actual sandbox denial; sandbox-exec unavailable'
fi
