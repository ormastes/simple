#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
phase="$root/scripts/bootstrap/bootstrap-phase-verification.shs"

fail() { echo "FAIL: $1" >&2; exit 1; }

count=$(grep -F -- '--cache-dir "$cache/tool_builds"' "$phase" | wc -l | tr -d ' ')
[ "$count" = 2 ] || fail "MCP and LSP must share exactly one cache namespace"

if grep -Eq -- '--cache-dir "\$cache/(mcp_build|lsp_build)"' "$phase"; then
    fail "per-tool cache roots prevent cross-entry per-file reuse"
fi

grep -Fq -- '--output "$outputs/simple_mcp_server"' "$phase" ||
    fail "MCP output must remain isolated"
grep -Fq -- '--output "$outputs/simple_lsp_mcp_server"' "$phase" ||
    fail "LSP output must remain isolated"

echo "PASS: phase tool builds share cache while retaining distinct outputs"
