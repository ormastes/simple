#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
phase="$root/scripts/bootstrap/bootstrap-phase-verification.shs"

fail() { echo "FAIL: $1" >&2; exit 1; }

count=$(grep -F -- '--cache-dir "$tool_build_cache"' "$phase" | wc -l | tr -d ' ')
[ "$count" = 2 ] || fail "Phase 2 MCP and LSP must share exactly one cache namespace"

if grep -Eq -- '--cache-dir "\$cache/(mcp_build|lsp_build)"' "$phase"; then
    fail "per-tool cache roots prevent cross-entry per-file reuse"
fi

grep -Fq -- '--output "$outputs/simple_mcp_server"' "$phase" ||
    fail "MCP output must remain isolated"
grep -Fq -- '--output "$outputs/simple_lsp_mcp_server"' "$phase" ||
    fail "LSP output must remain isolated"

# A phase compiler is bootstrap_main and deliberately has no full `check` or
# `test` command surface. The verifier must materialize SHA-bound command
# owners instead of manufacturing one failure per source/spec.
grep -Fq -- 'tool_cache="$cache_root/compiler-tools/$snapshot_sha/$runtime_cache_identity"' "$phase" ||
    fail "full CLI/test-runner cache is not compiler/runtime-SHA-bound"
grep -Fq -- 'hosted-runtime.env' "$phase" ||
    fail "hosted runtime authority is not receipt-bound"
grep -Fq -- 'simple-bootstrap-hosted-runtime-authority-v1' "$phase" ||
    fail "hosted runtime receipt schema is not verified"
grep -Fq -- 'simple-phase2-runtime-capsule-v1' "$phase" ||
    fail "SHA-qualified Phase2 runtime capsule is not verified"
grep -Fq -- 'native_all_sha256' "$phase" ||
    fail "native_all archive is not hash-bound before tool builds"
grep -Fq -- 'phase2-runtime-capsule.env' "$phase" ||
    fail "compiler-only Phase2 publication is not rejected"
grep -Fq -- "-name 'libspl_hosted_runtime-*.rlib'" "$phase" ||
    fail "duplicate hosted runtime artifacts are not rejected"
if grep -Fq -- 'rust-authority-*' "$phase" || grep -Fq -- 'max_by_key' "$phase"; then
    fail "verifier searches mutable Rust targets instead of a frozen capsule"
fi
grep -Fq -- '--entry src/app/cli/_CliMain/main_and_help.spl' "$phase" ||
    fail "phase verifier does not build the full CLI"
grep -Fq -- '--entry src/app/test_runner_new/main.spl' "$phase" ||
    fail "phase verifier does not build the test runner"
[ "$(grep -F -- '--runtime-bundle host-gpu --runtime-path "$runtime_path"' "$phase" | wc -l | tr -d ' ')" = 4 ] ||
    fail "full CLI, test runner, MCP, and LSP must use the explicit host-gpu runtime"
grep -Fq -- '[ "$native_internal_timeout" -gt 60 ]' "$phase" ||
    fail "native tool builds do not enforce an internal timeout above 60 seconds"
if grep -Fq -- '"$compiler_snapshot" check ' "$phase" ||
   grep -Fq -- '"$compiler_snapshot" test ' "$phase"; then
    fail "bootstrap_main is still used as a full check/test CLI"
fi
grep -Fq -- 'run_matrix_task compiler_check "$compiler_cli" check src/compiler' "$phase" ||
    fail "compiler check is not routed through the compiled full CLI"
grep -Fq -- 'run_matrix_task compiler_bootstrap_tests "$test_runner"' "$phase" ||
    fail "compiler tests are not routed through the compiled test runner"
grep -Fq -- 'record_unsupported_task compiler_unit_tests test-runner-artifact-not-built' "$phase" ||
    fail "missing test runner can still expand into false per-spec failures"
grep -Fq -- 'host-gpu-hosted-runtime-authority-unavailable' "$phase" ||
    fail "missing hosted runtime authority is not classified explicitly"

echo "PASS: phase tool builds share cache while retaining distinct outputs"
