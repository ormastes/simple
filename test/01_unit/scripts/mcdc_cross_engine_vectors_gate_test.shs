#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/mcdc-xengine-gate.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
set +e
MCDC_XENGINE_OUT="$tmp/evidence" sh "$root/scripts/check/check-mcdc-cross-engine-vectors.shs" >"$tmp/stdout" 2>"$tmp/stderr"
rc=$?
set -e
[ "$rc" -eq 2 ]
grep -q 'BLOCKED reason=compiler-not-set' "$tmp/stderr"
grep -qx 'status=BLOCKED' "$tmp/evidence/status.sdn"
grep -qx "resume=$tmp/evidence/resume.sh" "$tmp/evidence/status.sdn"
grep -q 'SIMPLE_NO_STUB_FALLBACK' "$root/scripts/check/check-mcdc-cross-engine-vectors.shs"
echo 'mcdc-cross-engine-vectors-gate-selfcheck: PASS'
