"""Executable regression coverage for the Windows LLVM 23.1 C-only toolchain."""

use std.spec.*
use std.io_runtime.{read_file}

val LLVM_ENV = "scripts/setup/llvm-toolchain-env.shs"
val CARGO_CONFIG = "src/compiler_rust/.cargo/config.toml"
val CMAKE_TOOLCHAIN = "src/runtime/cmake/toolchains/windows-x86_64-clangcl.cmake"

describe "Windows MSVC C-only toolchain contract":
    it "selects clang-cl as the C compiler and clears inherited CXX":
        val source = read_file(LLVM_ENV)
        assert_true(source.contains("CC="))
        assert_true(source.contains("/clang-cl.exe"))
        assert_true(source.contains("unset CXX"))
        assert_true(source.contains("clang+llvm-23.1.1-x86_64-pc-windows-msvc"))
        assert_true(source.contains("SIMPLE_WINDOWS_C_COMPILER_VERSION"))
        assert_false(source.contains("SIMPLE_LLVM_WIN_ROOT_18:="))

    it "uses link.exe for Rust's native MSVC target":
        val source = read_file(CARGO_CONFIG)
        assert_true(source.contains("[target.x86_64-pc-windows-msvc]"))
        assert_true(source.contains("linker = \"link.exe\""))
        assert_false(source.contains("linker = \"clang-cl\""))
        assert_false(source.contains("[target.x86_64-pc-windows-gnu]"))

    it "keeps the hosted runtime C-only in the CMake toolchain":
        val source = read_file(CMAKE_TOOLCHAIN)
        assert_true(source.contains("set(CMAKE_C_COMPILER "))
        assert_true(source.contains("/bin/clang-cl.exe"))
        assert_true(source.contains("C:/dev/tool/clang+llvm-23.1.1-x86_64-pc-windows-msvc"))
        assert_true(source.contains("RESULT_VARIABLE _simple_compiler_status"))
        assert_false(source.contains("CMAKE_CXX_COMPILER"))
        assert_false(source.contains("CMAKE_CXX_COMPILER_TARGET"))
        assert_false(source.contains("CMAKE_CXX_FLAGS"))
