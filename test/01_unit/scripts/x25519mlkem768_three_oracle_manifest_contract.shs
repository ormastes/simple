#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
manifest="$root/test/oracle/x25519mlkem768_three_oracle_manifest.sdn"
runner="$root/test/oracle/x25519mlkem768_circl/run.sh"
test_file="$root/test/oracle/x25519mlkem768_circl/oracle_test.go"

test -f "$manifest"
test -x "$runner"
test -f "$test_file"
grep -F 'external_independent_implementation_count: 1' "$manifest" >/dev/null
grep -F 'does not claim three independent external implementations' "$manifest" >/dev/null
grep -F 'offline only; an unavailable cached module, exact local toolchain, or readonly dependency graph is a hard failure' "$manifest" >/dev/null
grep -F 'GOENV=off GOWORK=off GOPROXY=off GOSUMDB=off GONOSUMDB=' "$runner" >/dev/null
grep -F 'GOTOOLCHAIN=local GOFLAGS=-mod=readonly' "$runner" >/dev/null
grep -F 'test -count=1 ./...' "$runner" >/dev/null
grep -F 'encapsulation key' "$test_file" >/dev/null
grep -F 'decapsulation key' "$test_file" >/dev/null
grep -F 'ciphertext' "$test_file" >/dev/null
grep -F 'decapsulated shared secret' "$test_file" >/dev/null
