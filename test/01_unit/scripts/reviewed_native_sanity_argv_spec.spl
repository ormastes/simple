# @cover scripts/bootstrap/run-reviewed-native-sanity.shs 80%
"""
## Purpose and audience
Purpose: the reviewed native sanity owner selects the real subprocess argv for a
canonical and a renamed LSP artifact, and never invokes an unqualified MCP role.
Ported from reviewed_native_sanity_argv_test.py (stub binary is sh, not Python).
Audience: maintainers of scripts/bootstrap/run-reviewed-native-sanity.shs.
"""

use std.spec.step
use std.spec.*
use std.io_runtime.{process_run}
use std.nogc_sync_mut.io.process_ops.{resolve_shell_argv, is_posix_shell_argv}

fn has_posix_shell() -> bool:
    val (sh_bin, _args) = resolve_shell_argv("true")
    is_posix_shell_argv(sh_bin)

fn run_script_sh(cmd: text) -> (text, text, i64):
    val (sh_bin, sh_args) = resolve_shell_argv(cmd)
    process_run(sh_bin, sh_args)

describe "reviewed native sanity argv":

    it "passes literal argv for canonical and renamed LSP artifacts and leaves MCP unqualified":
        if not has_posix_shell():
            pending("BLOCKED: POSIX sh not available for script execution")
        else:
            step("Run the production owner against stub artifacts")
            val (out, err, code) = run_script_sh("sh test/01_unit/scripts/reviewed_native_sanity_argv_fixture.shs")
            expect(code).to_equal(0)
            expect(out).to_contain("CASE simple_lsp_mcp_server rc=0 argv=--version ")
            expect(out).to_contain("CASE renamed-lsp-artifact rc=0 argv=simple_lsp_mcp_server --version ")
            step("MCP has no reviewed contract: exit 2, named reason, stub never invoked")
            expect(out).to_contain("CASE simple_mcp_server rc=2 argv= stderr=sanity_status=UNQUALIFIED reason=no-reviewed-native-sanity-contract")
