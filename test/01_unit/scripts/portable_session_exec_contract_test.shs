#!/bin/sh
set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
helper="$repo/scripts/check/lib/portable-session-exec.pl"
fixture_source="$repo/test/01_unit/scripts/fixture_stage3_process_tree.c"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

perl -c "$helper" >/dev/null
cc -std=c11 -O2 -Wall -Wextra -Werror "$fixture_source" -o "$tmp/tree-fixture"
! grep -F "'sess='" "$helper" >/dev/null
grep -F "'-o', 'ppid='" "$helper" >/dev/null

# Keep the production-shaped intermediate shell alive as the session leader;
# a final simple command may be tail-execed and cease to be the queried parent.
identity=$(perl "$helper" /bin/sh -c \
  'perl "$1" --identity-parent; identity_status=$?; :; exit "$identity_status"' \
  ignored "$helper")
pid=$(printf '%s\n' "$identity" | sed -n 's/^pid=//p')
pgid=$(printf '%s\n' "$identity" | sed -n 's/^pgid=//p')
sid=$(printf '%s\n' "$identity" | sed -n 's/^sid=//p')
ppid=$(printf '%s\n' "$identity" | sed -n 's/^ppid=//p')
start=$(printf '%s\n' "$identity" | sed -n 's/^start=//p')
test -n "$pid" && test -n "$ppid" && test "$pid" = "$pgid"
# Linux /proc provides an authoritative numeric SID.  Portable ps hosts omit
# it rather than interpreting Darwin's opaque sess pointer as a number.
test -z "$sid" || test "$pid" = "$sid"
case $start in ''|*[!0-9a-f]*) exit 1 ;; esac

# Exercise the exact non-/proc parser even on Linux.  It binds PID, PPID,
# PGID, and start identity while refusing to synthesize an SID from `sess`.
portable_identity=$(perl "$helper" --test-portable-identity-current)
portable_pid=$(printf '%s\n' "$portable_identity" | sed -n 's/^pid=//p')
portable_ppid=$(printf '%s\n' "$portable_identity" | sed -n 's/^ppid=//p')
portable_pgid=$(printf '%s\n' "$portable_identity" | sed -n 's/^pgid=//p')
portable_start=$(printf '%s\n' "$portable_identity" | sed -n 's/^start=//p')
case $portable_pid:$portable_ppid:$portable_pgid in
  *[!0-9:]*) exit 1 ;;
  [1-9]*:[1-9]*:[1-9]*) : ;;
  *) exit 1 ;;
esac
test -n "$portable_start"
! printf '%s\n' "$portable_identity" | grep -q '^sid='

ready="$tmp/term-ignore.identity"
started=$(perl -MTime::HiRes=clock_gettime,CLOCK_MONOTONIC -e \
  'printf "%.6f\n", clock_gettime(CLOCK_MONOTONIC)')
set +e
perl "$helper" perl "$helper" --require-fallback /bin/sh -c \
  'trap "" TERM; start=$(awk "{print \$22}" "/proc/$$/stat"); printf "%s %s\n" "$$" "$start" >"$1"; while :; do sleep 1; done' \
  ignored "$ready" &
wrapper=$!
set -e

attempt=0
while test ! -s "$ready"; do
  attempt=$((attempt + 1))
  test "$attempt" -lt 500
  sleep 0.01
done
read -r child child_start <"$ready"
kill -TERM "$wrapper"
set +e
wait "$wrapper"
status=$?
set -e
finished=$(perl -MTime::HiRes=clock_gettime,CLOCK_MONOTONIC -e \
  'printf "%.6f\n", clock_gettime(CLOCK_MONOTONIC)')
test "$status" -eq 137
elapsed_ms=$(awk -v start="$started" -v finish="$finished" \
  'BEGIN { printf "%d\n", (finish - start) * 1000 }')
test "$elapsed_ms" -ge 1500
test "$elapsed_ms" -le 6000
if test -r "/proc/$child/stat"; then
  current=$(awk '{print $22}' "/proc/$child/stat" 2>/dev/null || true)
  test "$current" != "$child_start"
fi

# Inherited SIGCHLD=IGNORE must not discard the fallback child's status.
set +e
/bin/sh -c 'trap "" CHLD; exec perl "$1" perl "$1" --require-fallback /bin/sh -c "exit 23"' \
  ignored "$helper"
ignored_status=$?
set -e
test "$ignored_status" -eq 23

# Exercise the actual fallback owner with inherited SIGCHLD=IGNORE plus
# SA_NOCLDWAIT, not merely an outer direct-exec wrapper.
set +e
"$tmp/tree-fixture" exec-nocldwait-session perl "$helper" \
  --require-fallback /bin/sh -c 'exit 24'
nocldwait_status=$?
set -e
test "$nocldwait_status" -eq 24

printf 'portable session exec contract: 6/6 passed\n'
