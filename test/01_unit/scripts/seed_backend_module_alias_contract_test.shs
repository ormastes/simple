#!/bin/sh
# The Rust seed's LLVM codegen cannot lower a call through a whole-module
# alias (`use a.b as m` + `m.f()`): it emits a load of an undeclared global
# `m`. Strict Stage 2 compiles every 70.backend file with the seed, so one
# such import there aborts bootstrap on every host (2026-09-19,
# llvm_native_link.spl). Use a renamed selective import instead:
# `use a.b.{f as m_f}`.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
fail() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }

hits=$(grep -rnE '^use [a-z_][a-z_0-9.]* as [a-z_][a-z_0-9]*[[:space:]]*$' \
    "$root/src/compiler/70.backend" || true)
[ -z "$hits" ] || fail "whole-module alias import in seed-compiled backend:
$hits"
printf 'seed_backend_module_alias_contract=true\n'
