#!/bin/sh
set -eu

source_file=src/compiler/99.loader/aspect_pack_io.spl

grep -q 'use std.nogc_sync_mut.io_runtime.{file_size_signed}' "$source_file"
[ "$(grep -c 'file_size_signed(path)' "$source_file")" -eq 4 ]
! grep -q '^extern fn rt_file_size' "$source_file"
! grep -q 'rt_file_size(' "$source_file"

printf 'aspect-pack file-size facade contract: PASS\n'
