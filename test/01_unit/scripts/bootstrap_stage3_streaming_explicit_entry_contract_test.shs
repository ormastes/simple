#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
gate="$root/src/compiler/80.driver/driver_phase_gates.spl"

body=$(sed -n '/^fn driver_streaming_surface_enabled(ctx: CompileContext)/,/^fn bootstrap_last_fixed_input/p' "$gate")
printf '%s\n' "$body" | grep -Fq 'driver_source_entry_closure_enabled(ctx)'
if printf '%s\n' "$body" | grep -Fq 'driver_explicit_source_entry(ctx) == ""'; then
    echo 'FAIL: Stage3 streaming rejects the explicit native-build entry' >&2
    exit 1
fi
if printf '%s\n' "$body" | grep -Fq 'SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE'; then
    echo 'FAIL: Stage3 streaming still requires only the late environment latch' >&2
    exit 1
fi

echo 'PASS: explicit native-build entry selects the bounded streaming route'
