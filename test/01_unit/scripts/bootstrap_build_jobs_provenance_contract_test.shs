#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
wrapper="$root/scripts/bootstrap/bootstrap-from-scratch.sh"
resume3="$root/scripts/bootstrap/resume-stage3-from-admitted.sh"
resume4="$root/scripts/bootstrap/resume-stage4-from-admitted.sh"
policy="$root/scripts/bootstrap/bootstrap-build-jobs-policy.shs"
writer="$root/scripts/check/lib/bootstrap-stage3/manifest-write.shs"
verifier="$root/scripts/check/lib/bootstrap-stage3/manifest-verify.shs"
redeploy="$root/scripts/check/cert/redeploy_gate/redeploy_gate.shs"
matrix="$root/scripts/bootstrap/stage4-tooling-matrix.shs"
fail() { echo "FAIL: $*" >&2; exit 1; }

sh -n "$wrapper" "$resume3" "$resume4" "$policy" "$writer" "$verifier" \
  "$redeploy" "$matrix" || fail "shell syntax"
grep -Fq 'exec sh "$(dirname -- "$0")/resume-stage3-from-admitted.sh"' "$wrapper" || fail "mode-0664 Stage 3 helper not invoked through sh"
grep -Fq 'jobs="${SIMPLE_BOOTSTRAP_BUILD_JOBS:-}"' "$wrapper" || fail "environment authority missing"
grep -Fq 'jobs_source=cli' "$wrapper" || fail "CLI precedence missing"
grep -Fq -- '--jobs="${bootstrap_build_jobs_requested}"' "$wrapper" || fail "CLI source token not preserved across Stage 3 exec"
grep -Fq 'Default and environment authority are inherited directly' "$wrapper" || fail "default/environment provenance not preserved"
grep -Fq 'stage3_jobs_receipt="${stage3_provenance_dir}/effective-build-jobs.env"' "$wrapper" || fail "canonical Stage 3 receipt missing"
grep -Fq 'Stage 3 effective build jobs receipt collision' "$wrapper" || fail "ordinary Stage 3 collision guard missing"
grep -Fq 'BSTAGE3_JOBS_RECEIPT_SHA256_BEFORE' "$wrapper" || fail "ordinary provenance hash input missing"
grep -Fq 'jobs_receipt="$stage3/effective-build-jobs.env"' "$resume3" || fail "resume receipt is not canonical"
grep -Fq 'bootstrap_build_jobs_write_receipt "$jobs_receipt"' "$resume3" || fail "resume mint missing"
grep -Fq 'BSTAGE3_JOBS_RECEIPT_SHA256_BEFORE' "$resume3" || fail "resume provenance hash input missing"
grep -Fq 'stage3_jobs_receipt_path=$BSTAGE3_JOBS_RECEIPT' "$writer" || fail "receipt path not bound"
grep -Fq 'stage3_jobs_receipt_sha256=$bootstrap_stage3_jobs_receipt_sha' "$writer" || fail "receipt hash not bound"
grep -Fq 'stage3_jobs_effective=$BSTAGE3_JOBS_EFFECTIVE' "$writer" || fail "effective jobs not bound"
grep -Fq 'stage3_jobs_receipt_sha256' "$verifier" || fail "receipt hash not reverified"
grep -Fq 'stage3_jobs_effective' "$verifier" || fail "effective jobs not reverified"
grep -Fq 'stage3_jobs_receipt_path "$manifest"' "$resume4" || fail "Stage 4 does not consume admitted receipt"
grep -Fq 'bootstrap_build_jobs_verify_receipt "$jobs_receipt" "$admitted_jobs"' "$resume4" || fail "Stage 4 receipt verification missing"
if grep -Fq 'bootstrap_build_jobs_write_receipt' "$resume4"; then fail "Stage 4 overwrites Stage 3 receipt"; fi
grep -Fq 'explicit Stage 4 jobs do not match admitted Stage 3 jobs' "$resume4" || fail "explicit mismatch is not fail-closed"
grep -Fq '${#bbj_uint}' "$policy" || fail "policy length guard missing"
grep -Fq '${#TEST_BUILD_THREADS}' "$redeploy" || fail "redeploy lexical bound missing"
grep -Fq '${#build_jobs}' "$matrix" || fail "matrix lexical bound missing"
grep -Fq 'scheduler_active_count" -lt "$build_jobs"' "$matrix" || fail "Stage 4 worker ceiling missing"
grep -Fq 'scheduler_dependencies_collected' "$matrix" || fail "Stage 4 bounded dependency queue missing"
grep -Fq 'STAGE4_MATRIX_TASK_ID=' "$matrix" || fail "Stage 4 task isolation identity missing"
grep -Fq 'setsid sh "$scheduler_launcher"' "$matrix" || fail "Stage 4 process-group owner missing"
grep -Fq 'scheduler_write_manifest' "$matrix" || fail "Stage 4 parent aggregation missing"
grep -Fq 'scheduler_cancel_all' "$matrix" || fail "Stage 4 cancellation cleanup missing"
grep -Fq 'scheduler_capture_identity "$scheduler_parent_identity_before"' "$matrix" || fail "Stage 4 pre-dispatch identity snapshot missing"
grep -Fq 'scheduler_capture_identity "$scheduler_parent_identity_after"' "$matrix" || fail "Stage 4 post-join identity snapshot missing"
long_jobs=999999999999999999999999999999999999
if SIMPLE_BOOTSTRAP_TEST_BUILD_THREADS=$long_jobs sh "$redeploy" --list >/dev/null 2>&1; then
  fail "redeploy admitted arbitrary-length numeric input"
fi
if sh "$matrix" --matrix-id=lexical-bound --build-jobs=$long_jobs \
  --compiler-manifest=missing --cli-journal=missing --mcp-journal=missing \
  --lsp-journal=missing >/dev/null 2>&1; then
  fail "tooling matrix admitted arbitrary-length numeric input"
fi

echo "PASS: precedence, lexical bounds, immutable Stage 3 provenance, helper invocation, and Stage 4 consumption are fail-closed"
