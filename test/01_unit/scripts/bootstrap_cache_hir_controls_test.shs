#!/bin/sh
# HIR forwarding only: no compiler execution, hit claim or resource limits.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$repo/scripts/bootstrap/bootstrap-cache-lineage.shs"
parent=${BOOTSTRAP_CACHE_TEST_ROOT:-$repo/build/cache-policy-hir-tests}
mkdir -p "$parent"
parent=$(CDPATH= cd -- "$parent" && pwd -P)
bootstrap_cache_new_path_validate "$parent" || exit 64
work=$(mktemp -d "$parent/hir-controls.XXXXXX")
case "$work" in "$parent"/hir-controls.*) ;; *) exit 1 ;; esac
cleanup() {
  fixture_status=$?
  if [ "$fixture_status" -eq 0 ]; then rm -rf -- "$work"
  else printf 'Retained failed HIR fixture: %s\n' "$work" >&2; fi
  return "$fixture_status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
fail() { echo "FAIL bootstrap HIR forwarding: $*" >&2; exit 1; }
producer=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
phase3="$work/cache/stage3/$producer/bootstrap-main"
phase4="$work/cache/stage4/$producer/full-cli"
mkdir -p "$phase3" "$phase4"
# Shared export overwrites inherited disables and attempt-specific paths only
# for managed bootstrap entries, and canonical semantic serialization agrees.
SIMPLE_FRONTEND_CACHE=0 SIMPLE_FRONTEND_CACHE_DIR="$work/old-home/frontend"
SIMPLE_HIR_CACHE=0 SIMPLE_HIR_CACHE_DIR="$work/old-home/hir"
export SIMPLE_FRONTEND_CACHE SIMPLE_FRONTEND_CACHE_DIR SIMPLE_HIR_CACHE SIMPLE_HIR_CACHE_DIR
bootstrap_cache_enable_persistence "$phase3"
[ "$SIMPLE_FRONTEND_CACHE" = 1 ] && [ "$SIMPLE_HIR_CACHE" = 1 ] || fail 'inherited disable survived'
[ "$SIMPLE_HIR_CACHE_DIR" = "$phase3/hir" ] || fail 'HIR follows attempt HOME'
bootstrap_cache_native_environment "$repo" > "$work/actual-semantic.env"
grep -Fxq 'SIMPLE_HIR_CACHE=1:1' "$work/actual-semantic.env" || fail 'effective HIR enable not in semantic key'
grep -Fxq "SIMPLE_HIR_CACHE_DIR=${#SIMPLE_HIR_CACHE_DIR}:$SIMPLE_HIR_CACHE_DIR" "$work/actual-semantic.env" || fail 'effective HIR directory not in semantic key'
phase3_hir=$SIMPLE_HIR_CACHE_DIR
bootstrap_cache_enable_persistence "$phase4"
[ "$SIMPLE_HIR_CACHE_DIR" = "$phase4/hir" ] && [ "$SIMPLE_HIR_CACHE_DIR" != "$phase3_hir" ] || fail 'phases share HIR directory'
bootstrap_cache_persistence_policy > "$work/policy"
grep -Fxq 'hir-cache=1' "$work/policy" && grep -Fxq 'hir-cache-location=selected-entry/hir' "$work/policy" || fail 'Phase 2/3 binding omits HIR controls'
SIMPLE_STAGE3_MISSION_CRITICAL=1 bootstrap_cache_stage3_assurance > "$work/assurance"
grep -Fxq 'hir-cache=1' "$work/assurance" || fail 'resume assurance omits HIR controls'

# Inspect the inline Stage 3 hash and execution vectors separately. Both must
# force the selected cache entry's HIR directory; the worker path is exercised
# below without invoking a compiler.
engine="$repo/scripts/bootstrap/bootstrap-from-scratch.sh"
awk '/^  stage3_build_args_sha256=/{on=1} on{print} on && /^  \)$/{exit}' \
  "$engine" > "$work/stage3-hash.shs"
awk '/^[[:space:]]*bootstrap_stage3_run_transcribed \\/{count++; if(count==2) on=1} on{print} on && /-o "\$\{stage3_bin\}" src\/app\/cli\/bootstrap_main.spl$/{exit}' \
  "$engine" > "$work/stage3-run.shs"
for vector in "$work/stage3-hash.shs" "$work/stage3-run.shs"; do
  [ -s "$vector" ] || fail "missing actual inline Stage 3 vector: $vector"
  [ "$(grep -c 'SIMPLE_HIR_CACHE=1' "$vector")" -eq 1 ] || fail 'inline Stage 3 HIR enable is ambiguous'
  [ "$(grep -c 'SIMPLE_HIR_CACHE_DIR=.*stage3_cache_absolute.*/hir' "$vector")" -eq 1 ] || fail 'inline Stage 3 HIR directory is wrong'
done

# Execute the actual worker against an argument capture facade. Use the Darwin
# branch solely to avoid any host resource-limit change; no compiler is called.
fake_root="$work/capture-root"
mkdir -p "$fake_root/scripts/check/lib" "$work/home-a" "$work/home-b" "$work/tmp-a" "$work/tmp-b"
BOOTSTRAP_CACHE_FIXTURE_REPO=$repo
export BOOTSTRAP_CACHE_FIXTURE_REPO
cat > "$fake_root/scripts/check/lib/bootstrap-stage3-provenance.shs" <<'CAPTURE'
. "$BOOTSTRAP_CACHE_FIXTURE_REPO/scripts/check/lib/bootstrap-stage3/authority.shs"
. "$BOOTSTRAP_CACHE_FIXTURE_REPO/scripts/check/lib/bootstrap-stage3/command-snapshot.shs"
bootstrap_stage3_run_transcribed() { printf '%s\n' "$@" > "$3"; }
CAPTURE
# Transfer-only fixture for the worker's ABI guard; this is not an admitted
# compiler and never enters the canonical caller's full admission verifier.
printf 'capture-only producer fixture\n' > "$work/no-compiler"
producer_sha=$(bootstrap_cache_hash_file "$work/no-compiler")
printf 'schema=simple-bootstrap-stage2-admission-v2\nstatus=admitted\nsimple_abi_policy=v1\ncandidate_sha256=%s\n' "$producer_sha" > "$work/transfer-only.env"
receipt_sha=$(bootstrap_cache_hash_file "$work/transfer-only.env")
SIMPLE_HIR_CACHE=0 SIMPLE_HIR_CACHE_DIR="$work/ambient-hir" \
  sh "$repo/scripts/bootstrap/lib/stage3-native-build-worker.sh" \
  "$work/transcript-a" "$fake_root" "$work/worker-a.args" \
  "$work/home-a" "$work/tmp-a" "$PATH" "$work/no-compiler" \
  fixture-apple-darwin cranelift 1 '' "$phase3" "$work/runtime" \
  "$work/candidate-a" "$work/progress-a" "$work/profile-a" "$work/memory-a" \
  fixture-a direct none 1 '' '' '' 1 v1 "$work/transfer-only.env" "$receipt_sha"
SIMPLE_HIR_CACHE=0 SIMPLE_HIR_CACHE_DIR="$work/another-ambient-hir" \
  sh "$repo/scripts/bootstrap/lib/stage3-native-build-worker.sh" \
  "$work/transcript-b" "$fake_root" "$work/worker-b.args" \
  "$work/home-b" "$work/tmp-b" "$PATH" "$work/no-compiler" \
  fixture-apple-darwin cranelift 1 '' "$phase3" "$work/runtime" \
  "$work/candidate-b" "$work/progress-b" "$work/profile-b" "$work/memory-b" \
  fixture-b direct none 1 '' '' '' 1 v1 "$work/transfer-only.env" "$receipt_sha"
for captured in "$work/worker-a.args" "$work/worker-b.args"; do
  grep -Fxq 'SIMPLE_HIR_CACHE=1' "$captured" || fail 'actual worker omitted enable override'
  grep -Fxq "SIMPLE_HIR_CACHE_DIR=$phase3/hir" "$captured" || fail 'actual worker omitted persistent directory'
  [ "$(grep -c '^SIMPLE_HIR_CACHE=' "$captured")" -eq 1 ] || fail 'ambiguous worker enable overrides'
  [ "$(grep -c '^SIMPLE_HIR_CACHE_DIR=' "$captured")" -eq 1 ] || fail 'ambiguous worker directory overrides'
done

# Check all main transcript+actual and resume transcript forwarding sites.
main="$repo/scripts/bootstrap/bootstrap-from-scratch.sh"
[ "$(grep -c 'SIMPLE_HIR_CACHE_DIR=${stage2_cache_absolute}/hir' "$main")" -eq 2 ] || fail 'Stage 2 transcript/actual mismatch'
[ "$(grep -c 'SIMPLE_HIR_CACHE_DIR=.*stage3_cache_absolute.*/hir' "$main")" -eq 2 ] || fail 'Stage 3 transcript/actual mismatch'
grep -Fq '"SIMPLE_HIR_CACHE=1" "SIMPLE_HIR_CACHE_DIR=$stage3_cache/hir"' "$repo/scripts/bootstrap/resume-stage3-from-admitted.sh" || fail 'resume transcript omits HIR pair'
[ "$(grep -c 'SIMPLE_HIR_CACHE=1 "SIMPLE_HIR_CACHE_DIR=${native_cache_dir}/hir"' "$main")" -eq 3 ] || fail 'tool semantic keys do not match selected directories'
grep -Fq 'bootstrap_cache_enable_persistence "$(absolute_path "$3")"' "$main" || fail 'actual inherited tool env omits HIR pair'
echo 'PASS bootstrap HIR forwarding: inherited disable overridden, persistent selected directory, phase separation, semantic keys, inline Stage 3 vectors, actual worker and resume transcripts; no compiler hit qualification'
