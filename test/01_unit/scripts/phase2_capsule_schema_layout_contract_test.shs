#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
source_tool=${PHASE2_CAPSULE_TOOL:-"$root/scripts/bootstrap/phase2-runtime-capsule.shs"}
tmp=$(mktemp -d)
trap 'chmod -R u+w "$tmp" 2>/dev/null || true; rm -rf "$tmp"' EXIT HUP INT TERM
fail() { echo "FAIL: $1" >&2; exit 1; }

# Isolate schema semantics from platform ACL mechanics.  The production ACL
# helper has its own contract coverage; this fixture helper only lets publish
# and verify reach the receipt parser deterministically on Windows.
mkdir -p "$tmp/tool" "$tmp/authority/deps"
cp "$source_tool" "$tmp/tool/phase2-runtime-capsule.shs"
cat >"$tmp/tool/phase2-capsule-permissions.ps1" <<'EOF'
param([string]$Action, [string]$Path)
exit 0
EOF
tool="$tmp/tool/phase2-runtime-capsule.shs"

printf '#!/bin/sh\nexit 0\n' >"$tmp/compiler"
chmod 755 "$tmp/compiler"
printf native >"$tmp/authority/libsimple_native_all.a"
printf hosted >"$tmp/authority/deps/libspl_hosted_runtime-fixture.rlib"
native_sha=$(sha256sum "$tmp/authority/libsimple_native_all.a" | awk '{print $1}')
hosted_sha=$(sha256sum "$tmp/authority/deps/libspl_hosted_runtime-fixture.rlib" | awk '{print $1}')
cat >"$tmp/authority/hosted-runtime.env" <<EOF
schema=simple-bootstrap-hosted-runtime-authority-v1
status=frozen
relative_path=deps/libspl_hosted_runtime-fixture.rlib
sha256=$hosted_sha
EOF
cat >"$tmp/authority/simple.inputs.sha256" <<EOF
schema=simple-bootstrap-seed-artifact-stamp-v2
inputs_fingerprint=fixture
seed_sha256=fixture
native_all_sha256=$native_sha
backfill_status=absent
backfill_sha256=absent
EOF

capsule=$(sh "$tool" publish "$tmp/compiler" "$tmp/authority" "$tmp/output")
chmod -R u+w "$capsule"
receipt="$capsule/phase2-runtime-capsule.env"
sed -e 's/^schema=simple-phase2-runtime-capsule-v2$/schema=simple-phase2-runtime-capsule-v1/' \
  -e '/^artifact_layout=/d' "$receipt" >"$tmp/legacy"
legacy_identity=$(
  {
    sed -n 's/^compiler_sha256=//p' "$tmp/legacy"
    sed -n 's/^native_all_sha256=//p' "$tmp/legacy"
    sed -n 's/^hosted_authority_receipt_sha256=//p' "$tmp/legacy"
    sed -n 's/^seed_authority_stamp_sha256=//p' "$tmp/legacy"
    printf 'absent\n'
  } | sha256sum | awk '{print $1}'
)
sed "s/^capsule_identity_sha256=.*/capsule_identity_sha256=$legacy_identity/" \
  "$tmp/legacy" >"$receipt"
sh "$tool" verify "$capsule" || fail 'canonical POSIX v1 capsule rejected'
printf 'artifact_layout=windows-msvc\n' >>"$receipt"
if sh "$tool" verify "$capsule" >/dev/null 2>&1; then
  fail 'v1 capsule accepted a contradictory Windows layout'
fi

echo 'phase2_capsule_schema_layout_contract_test: PASS'
