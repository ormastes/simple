"""
## Purpose and audience
Purpose: Prevent compiler selector regression where run-invoking callers omit --require-run or selector omits --require-run docs.
Audience: build, check-script, and bootstrap maintainers.
"""

# @req: REQ-SCRIPTS-COMPILER-SELECT-RUN-001

use std.spec.*

extern fn rt_file_read_text(path: text) -> text?

describe "simple_compiler_select --require-run contract":

    it "implements --require-run probe and advertises it in CLI usage":
        val sel = rt_file_read_text("scripts/lib/simple-compiler-select.shs") ?? ""
        expect(sel).to_contain("simple_compiler_can_run()")
        expect(sel).to_contain("--require-run")
        expect(sel).to_contain("Usage: sh scripts/lib/simple-compiler-select.shs [--self-test] [--builder-target <triple>] [--require-run]")

    it "ensures check scripts invoking selected binary run subcommand pass --require-run":
        val taskbar = rt_file_read_text("scripts/check/check-wm-multiapp-taskbar-evidence.shs") ?? ""
        expect(taskbar).to_contain("simple_compiler_select --root \"$ROOT_DIR\" --require-run")

        val riscv = rt_file_read_text("scripts/check/check-riscv-fpga-sidecar-contract.shs") ?? ""
        expect(riscv).to_contain("simple_compiler_select --root \"$ROOT_DIR\" --require-run")

        val capture = rt_file_read_text("scripts/check/check-wm-launch-capture-evidence.shs") ?? ""
        expect(capture).to_contain("simple_compiler_select --root \"$ROOT_DIR\" --require-run")
