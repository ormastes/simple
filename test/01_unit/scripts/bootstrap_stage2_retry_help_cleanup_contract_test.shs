#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
bootstrap="$root/scripts/bootstrap/bootstrap-from-scratch.sh"
verification="$root/scripts/bootstrap/bootstrap-phase-verification.shs"
qualifier="$root/scripts/bootstrap/bootstrap-qualify-stage2.shs"
strategy="$root/scripts/bootstrap/bootstrap-strategy.sh"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/simple-bootstrap-retry-help-cleanup.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

fail() { echo "FAIL: $*" >&2; exit 1; }

# Exercise the exact production retry predicate with positive and fail-closed
# fixtures. Only one timeout row and its matching terminal summary is eligible.
sed -n '/^bootstrap_stage2_single_timeout_cache_retry_eligible()/,/^}/p' \
  "$bootstrap" >"$tmp/retry-helper.sh"
. "$tmp/retry-helper.sh"
cat >"$tmp/one-timeout.log" <<'EOF'
FAILED FILES (1):
  - src/compiler/example.spl => worker: timeout (300s)
Build failed: native-build aborted: 1 file(s) failed to compile
EOF
bootstrap_stage2_single_timeout_cache_retry_eligible "$tmp/one-timeout.log" ||
  fail 'single timeout was not retry eligible'
cat >>"$tmp/one-timeout.log" <<'EOF'
  - src/compiler/other.spl => worker: error
EOF
if bootstrap_stage2_single_timeout_cache_retry_eligible "$tmp/one-timeout.log"; then
  fail 'mixed/multiple failures were retry eligible'
fi

# The retry must call one captured producer command twice, preserving its cache
# argument, and retain the first failure log before the sole retry.
retry_body=$(sed -n '/^  stage2_native_log=/,/^  bootstrap_stage3_directory_snapshot/p' "$bootstrap")
printf '%s\n' "$retry_body" | grep -Fq -- '--cache-dir "${stage2_cache_absolute}"' ||
  fail 'captured Stage-2 command lost its producer-scoped cache'
[ "$(printf '%s\n' "$retry_body" | grep -Ec '^[[:space:]]+bootstrap_run_stage2_native$')" -eq 2 ] ||
  fail 'Stage-2 command is not limited to initial attempt plus one retry'
printf '%s\n' "$retry_body" | grep -Fq 'stage2-native-build.before-cache-retry.log' ||
  fail 'first timeout evidence is not retained before retry'

# Exercise run_task itself with a shell-zero help command that emits the ABI
# mismatch signature. Admission must be converted to status 86/FAIL.
mkdir -p "$tmp/root/scripts/bootstrap" "$tmp/logs" "$tmp/home" "$tmp/work" "$tmp/cache"
cat >"$tmp/root/scripts/bootstrap/run-process-group-timeout.shs" <<'EOF'
#!/bin/sh
shift 2
exec "$@"
EOF
chmod +x "$tmp/root/scripts/bootstrap/run-process-group-timeout.shs"
sed -n '/^run_with_timeout()/,/^}/p; /^run_task()/,/^}/p' \
  "$verification" >"$tmp/run-task.sh"
. "$tmp/run-task.sh"
source_root="$tmp/root"
logs="$tmp/logs"
home="$tmp/home"
tmp="$tmp/work"
cache="$tmp/cache"
summary="$tmp/summary.env"
timeout_seconds=5
if run_task mcp_help sh -c \
  'echo "[simple-runtime][error] invalid array handle: probable compiler/FFI ABI mismatch"; exit 0'; then
  fail 'shell-zero ABI mismatch help probe was admitted'
fi
grep -Fq 'task=mcp_help|result=FAIL|status=86|' "$summary" ||
  fail 'ABI mismatch help probe did not retain status 86 evidence'

# Cleanup readiness is published atomically after stale private Stage-2/3
# homes/admission are removed, and the qualifier waits for it before admission.
cleanup_line=$(grep -n 'if \[ -n "${SIMPLE_BOOTSTRAP_STAGE2_CLEANUP_MARKER:-}" \]' "$bootstrap" | cut -d: -f1)
remove_line=$(grep -n 'rm -rf "${stage2_provenance_home}"' "$bootstrap" | cut -d: -f1)
cache_line=$(grep -n 'Stage 2/3 native-build caches are content-hash keyed' "$bootstrap" | cut -d: -f1)
[ "$remove_line" -lt "$cleanup_line" ] && [ "$cleanup_line" -lt "$cache_line" ] ||
  fail 'cleanup marker publication moved outside the post-cleanup boundary'
grep -Fq 'mv "${stage2_cleanup_marker_tmp}"' "$bootstrap" ||
  fail 'cleanup marker is not atomically published'
marker_wait=$(grep -n 'cleanup_marker="$generation_dir/stage2-cleanup.ready"' "$qualifier" | cut -d: -f1)
admission_wait=$(grep -n 'while \[ "$waited" -lt "$wait_seconds" \]; do' "$qualifier" | head -1 | cut -d: -f1)
[ "$marker_wait" -lt "$admission_wait" ] ||
  fail 'qualifier can inspect admission before cleanup readiness'
grep -Fq 'SIMPLE_BOOTSTRAP_STAGE2_CLEANUP_MARKER="$generation_dir/stage2-cleanup.ready"' "$strategy" ||
  fail 'scheduler does not provide the generation-scoped cleanup marker'

echo 'bootstrap_stage2_retry_help_cleanup_contract_test: PASS'
