#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
# The alias lane below needs a REAL symlink; Windows shells copy by default.
. "$root/scripts/check/lib/portable-symlink-mode.shs"
PORTABLE_LOCK_ATOMIC_HELPER_PATH="$root/scripts/check/lib/portable-hardlink-lock.pl"
PORTABLE_LOCK_SESSION_EXEC_PATH="$root/scripts/check/lib/portable-session-exec.pl"
export PORTABLE_LOCK_ATOMIC_HELPER_PATH
. "$root/scripts/check/lib/portable-process-lock.shs"

fail() {
  printf 'portable process lock test failed: %s\n' "$*" >&2
  exit 1
}

perl -c "$PORTABLE_LOCK_SESSION_EXEC_PATH" >/dev/null 2>&1 ||
  fail "portable session helper did not load and parse"

wait_for_file() {
  wait_file_path=$1
  wait_file_limit=${2:-15}
  wait_file_count=0
  while [ ! -f "$wait_file_path" ]; do
    wait_file_count=$((wait_file_count + 1))
    [ "$wait_file_count" -lt "$wait_file_limit" ] ||
      fail "timed out waiting for $wait_file_path"
    sleep 1
  done
}

wait_for_pid_exit() {
  wait_pid=$1
  wait_pid_limit=${2:-15}
  wait_pid_count=0
  while kill -0 "$wait_pid" 2>/dev/null; do
    wait_pid_count=$((wait_pid_count + 1))
    [ "$wait_pid_count" -lt "$wait_pid_limit" ] ||
      fail "timed out waiting for process $wait_pid to exit"
    sleep 1
  done
}

stable_for_handle() {
  stable_handle=$1
  stable_identity=$(portable_lock_identity "$stable_handle") || return 1
  stable_dir=${stable_handle%/*}
  for stable_candidate in "$stable_dir"/.[!.]* "$stable_dir"/..?* \
    "$stable_dir"/*; do
    [ -f "$stable_candidate" ] || continue
    [ "$stable_candidate" = "$stable_handle" ] && continue
    stable_candidate_identity=$(portable_lock_identity "$stable_candidate" \
      2>/dev/null || :)
    if [ "$stable_candidate_identity" = "$stable_identity" ]; then
      printf '%s\n' "$stable_candidate"
      return 0
    fi
  done
  return 1
}

tmp=${TMPDIR:-/tmp}/portable-process-lock-test.$$
rm -rf "$tmp"
mkdir -p "$tmp/real"
trap 'portable_lock_release_all >/dev/null 2>&1 || :; rm -rf "$tmp"' \
  0 HUP INT TERM

# The bootstrap readiness variable is evidence, not an authority bypass.
if SIMPLE_BOOTSTRAP_SESSION_READY=1 \
  sh "$root/scripts/bootstrap/bootstrap-from-scratch.sh" --help \
  >"$tmp/session-bypass.out" 2>&1; then
  fail "bootstrap accepted a forged session-ready environment"
else
  session_bypass_status=$?
  [ "$session_bypass_status" -eq 70 ] ||
    fail "session bypass rejection returned $session_bypass_status"
fi
SIMPLE_BOOTSTRAP_SESSION_READY=1 \
  perl "$PORTABLE_LOCK_SESSION_EXEC_PATH" /bin/sh \
    "$root/scripts/bootstrap/bootstrap-from-scratch.sh" --help \
    >"$tmp/session-valid.out" 2>&1 ||
  fail "bootstrap rejected a verified PID=PGID session"

# Nesting the launcher forces its process-group-leader fork fallback.
set +e
perl "$PORTABLE_LOCK_SESSION_EXEC_PATH" perl \
  "$PORTABLE_LOCK_SESSION_EXEC_PATH" --require-fallback sh -c 'exit 37'
session_fallback_status=$?
set -e
[ "$session_fallback_status" -eq 37 ] ||
  fail "session fallback lost child status $session_fallback_status"

exercise_session_forwarding() {
  forwarding_signal=$1
  forwarding_status=$2
  forwarding_ready="$tmp/session-forward-${forwarding_signal}.ready"
  READY="$forwarding_ready" FORWARD_STATUS="$forwarding_status" \
    perl "$PORTABLE_LOCK_SESSION_EXEC_PATH" perl \
      "$PORTABLE_LOCK_SESSION_EXEC_PATH" --require-fallback sh -c '
        trap "exit $FORWARD_STATUS" '"$forwarding_signal"'
        : >"$READY"
        while :; do sleep 1; done
      ' &
  forwarding_pid=$!
  wait_for_file "$forwarding_ready"
  kill -"$forwarding_signal" "$forwarding_pid"
  set +e
  wait "$forwarding_pid"
  forwarding_actual=$?
  set -e
  [ "$forwarding_actual" -eq "$forwarding_status" ] ||
    fail "fallback $forwarding_signal forwarding returned $forwarding_actual"
}

exercise_session_forwarding TERM 42
exercise_session_forwarding INT 43
exercise_session_forwarding HUP 44
exercise_session_forwarding QUIT 45

# dash must treat an absolute claim as data, never as a dynamic unset name.
ROOT_PATH=$root LOCK_ROOT="$tmp/real" \
  PORTABLE_LOCK_ATOMIC_HELPER_PATH=$PORTABLE_LOCK_ATOMIC_HELPER_PATH \
  /bin/sh -c '
    set -eu
    . "$ROOT_PATH/scripts/check/lib/portable-process-lock.shs"
    portable_lock_acquire "$LOCK_ROOT" dash-absolute-release 2
    dash_absolute_handle=$PORTABLE_LOCK_HANDLE
    case "$dash_absolute_handle" in
      /*) ;;
      *) exit 91 ;;
    esac
    portable_lock_release "$dash_absolute_handle"
    [ ! -e "$dash_absolute_handle" ]
  ' || fail "dash could not release an absolute claim handle"

# Aggregate release must preserve literal glob pathnames and private state.
multi_lock_root="$tmp/glob[*]?"
portable_lock_acquire "$multi_lock_root" multi-one 2
multi_lock_handle_one=$PORTABLE_LOCK_HANDLE
portable_lock_acquire "$multi_lock_root" multi-two 2
multi_lock_handle_two=$PORTABLE_LOCK_HANDLE
[ -e "$multi_lock_root/.multi-one.lock" ] ||
  fail "first multi-lock stable link is missing"
[ -e "$multi_lock_root/.multi-two.lock" ] ||
  fail "second multi-lock stable link is missing"
if env | grep -q '^PORTABLE_LOCK_HANDLES='; then
  fail "private multi-lock handle list leaked into environment"
fi
portable_lock_release_all || fail "aggregate multi-lock release failed"
[ ! -e "$multi_lock_root/.multi-one.lock" ] ||
  fail "aggregate release retained first stable link"
[ ! -e "$multi_lock_root/.multi-two.lock" ] ||
  fail "aggregate release retained second stable link"
[ ! -e "$multi_lock_handle_one" ] ||
  fail "aggregate release retained first claim"
[ ! -e "$multi_lock_handle_two" ] ||
  fail "aggregate release retained second claim"
[ -z "${PORTABLE_LOCK_HANDLES:-}" ] ||
  fail "aggregate release retained successful handles"

# Canonical aliases must address one lock lane, and traversal is rejected.
# The alias case needs a REAL symlink. MSYS / Git Bash `ln -s` silently copies
# the directory instead unless MSYS=winsymlinks:nativestrict is set (and that
# needs Developer Mode or admin), which would make `$tmp/alias` a genuinely
# distinct lane — the contender would then rightly acquire it and the case
# would report a lock defect that does not exist. Assert the precondition and,
# when the host cannot express it, say so loudly rather than passing quietly.
ln -s "$tmp/real" "$tmp/alias" 2>/dev/null || :
if [ -L "$tmp/alias" ]; then
  portable_lock_acquire "$tmp/real" alias 2
  alias_handle=$PORTABLE_LOCK_HANDLE
  if ROOT_PATH=$root LOCK_ROOT="$tmp/alias" \
    PORTABLE_LOCK_ATOMIC_HELPER_PATH=$PORTABLE_LOCK_ATOMIC_HELPER_PATH \
    sh -c '
      . "$ROOT_PATH/scripts/check/lib/portable-process-lock.shs"
      portable_lock_acquire "$LOCK_ROOT" alias 1
    '; then
    fail "alias contender acquired an already-owned lane"
  else
    alias_status=$?
    [ "$alias_status" -eq 75 ] || fail "alias contender returned $alias_status"
  fi
  portable_lock_handle_is_owned "$alias_handle" || fail "alias owner lost lock"
  portable_lock_release "$alias_handle" || fail "alias owner could not release"
else
  rm -rf "$tmp/alias"
  printf 'portable process lock test UNSUPPORTED: %s\n' \
    "symlink-alias lane not checked: this host cannot create symlinks (ln -s produced a non-symlink)" >&2
fi
if portable_lock_acquire "$tmp/real/../real" traversal 1; then
  fail "dot-dot output was accepted"
else
  traversal_status=$?
  [ "$traversal_status" -eq 64 ] ||
    fail "dot-dot rejection returned $traversal_status"
fi

# A different process cannot release a parent-owned lock, even with its handle.
portable_lock_acquire "$tmp/real" contention 2
contention_handle=$PORTABLE_LOCK_HANDLE
if ROOT_PATH=$root LOCK_HANDLE=$contention_handle \
  PORTABLE_LOCK_ATOMIC_HELPER_PATH=$PORTABLE_LOCK_ATOMIC_HELPER_PATH \
  sh -c '
    . "$ROOT_PATH/scripts/check/lib/portable-process-lock.shs"
    portable_lock_release "$LOCK_HANDLE"
  '; then
  fail "non-owner released parent claim"
fi
portable_lock_handle_is_owned "$contention_handle" ||
  fail "non-owner release disturbed stable lock"
if ROOT_PATH=$root LOCK_ROOT="$tmp/real" \
  PORTABLE_LOCK_ATOMIC_HELPER_PATH=$PORTABLE_LOCK_ATOMIC_HELPER_PATH \
  sh -c '
    . "$ROOT_PATH/scripts/check/lib/portable-process-lock.shs"
    portable_lock_acquire "$LOCK_ROOT" contention 1
  '; then
  fail "contender acquired a live lock"
else
  contention_status=$?
  [ "$contention_status" -eq 75 ] ||
    fail "contention returned $contention_status"
fi

# Compare-before-remove must reject a wrong nonce without unlinking the lock.
contention_stable=$(stable_for_handle "$contention_handle") ||
  fail "could not locate contention stable link"
contention_identity=$(portable_lock_identity "$contention_stable")
contention_dev=${contention_identity%%:*}
contention_ino=${contention_identity#*:}
contention_pid=$(portable_lock_manifest_value owner_pid "$contention_handle")
contention_start=$(portable_lock_manifest_value owner_start_hex \
  "$contention_handle")
contention_pgid=$(portable_lock_manifest_value owner_pgid "$contention_handle")
if perl "$PORTABLE_LOCK_ATOMIC_HELPER_PATH" unlink-if-match \
  "$contention_stable" "$contention_dev" "$contention_ino" \
  00000000000000000000000000000000 "$contention_pid" \
  "$contention_start" "$contention_pgid"; then
  fail "wrong nonce removed stable lock"
fi
portable_lock_handle_is_owned "$contention_handle" ||
  fail "wrong nonce disturbed ownership"
portable_lock_release "$contention_handle" || fail "contention release failed"

# POSIX subshell $$ aliases the parent; the claim must contain the actual process.
(
  PORTABLE_LOCK_HANDLE=
  PORTABLE_LOCK_HANDLES=
  export PORTABLE_LOCK_HANDLE PORTABLE_LOCK_HANDLES
  portable_lock_acquire "$tmp/real" subshell 2
  subshell_handle=$PORTABLE_LOCK_HANDLE
  subshell_pid=$(portable_lock_manifest_value owner_pid "$subshell_handle")
  [ "$subshell_pid" != "$$" ] || fail "subshell claim reused lexical parent PID"
  portable_lock_handle_is_owned "$subshell_handle" ||
    fail "subshell actual identity was not recognized"
  portable_lock_release "$subshell_handle" || fail "subshell release failed"
)

# Simulate PID reuse: the PID is live, but its claim start identity is wrong.
ROOT_PATH=$root LOCK_ROOT="$tmp/real" READY="$tmp/pid-reuse.ready" \
  HANDLE_FILE="$tmp/pid-reuse.handle" \
  PORTABLE_LOCK_ATOMIC_HELPER_PATH=$PORTABLE_LOCK_ATOMIC_HELPER_PATH \
  perl "$PORTABLE_LOCK_SESSION_EXEC_PATH" sh -c '
    . "$ROOT_PATH/scripts/check/lib/portable-process-lock.shs"
    portable_lock_acquire "$LOCK_ROOT" pid-reuse 2
    printf "%s\n" "$PORTABLE_LOCK_HANDLE" >"$HANDLE_FILE"
    : >"$READY"
    while :; do sleep 1; done
  ' &
pid_reuse_owner=$!
wait_for_file "$tmp/pid-reuse.ready"
pid_reuse_handle=$(cat "$tmp/pid-reuse.handle")
pid_reuse_claim_owner=$(portable_lock_manifest_value owner_pid \
  "$pid_reuse_handle")
pid_reuse_manifest="$tmp/pid-reuse.manifest"
while IFS= read -r pid_reuse_line; do
  case "$pid_reuse_line" in
    owner_start_hex=*) printf '%s\n' 'owner_start_hex=00' ;;
    *) printf '%s\n' "$pid_reuse_line" ;;
  esac
done <"$pid_reuse_handle" >"$pid_reuse_manifest"
cat "$pid_reuse_manifest" >"$pid_reuse_handle"
if portable_lock_acquire "$tmp/real" pid-reuse 1; then
  fail "live process group was recovered after start mismatch"
else
  pid_reuse_status=$?
  [ "$pid_reuse_status" -eq 75 ] ||
    fail "live PID-reuse group returned $pid_reuse_status"
fi
kill -KILL "$pid_reuse_claim_owner" 2>/dev/null || :
wait "$pid_reuse_owner" 2>/dev/null || :
portable_lock_acquire "$tmp/real" pid-reuse 5
pid_reuse_successor=$PORTABLE_LOCK_HANDLE
portable_lock_handle_is_owned "$pid_reuse_successor" ||
  fail "start-mismatch successor did not own lock"
[ ! -e "$pid_reuse_handle" ] || fail "stale PID-reuse claim was not cleaned"
portable_lock_release "$pid_reuse_successor" ||
  fail "start-mismatch successor release failed"

# INT/TERM owners retain claims. A surviving same-PGID worker blocks recovery.
exercise_abnormal_signal() {
  abnormal_signal=$1
  abnormal_status=$2
  abnormal_name=$3
  abnormal_lock_root=${4:-$tmp/real}
  abnormal_ready="$tmp/${abnormal_name}.ready"
  abnormal_handle_file="$tmp/${abnormal_name}.handle"
  abnormal_worker_file="$tmp/${abnormal_name}.worker"
  abnormal_stop="$tmp/${abnormal_name}.stop"
  ROOT_PATH=$root LOCK_ROOT="$abnormal_lock_root" READY="$abnormal_ready" \
    HANDLE_FILE="$abnormal_handle_file" WORKER_FILE="$abnormal_worker_file" \
    STOP_FILE="$abnormal_stop" SIGNAL_NAME="$abnormal_signal" \
    SIGNAL_STATUS="$abnormal_status" LOCK_NAME="$abnormal_name" \
    PORTABLE_LOCK_ATOMIC_HELPER_PATH=$PORTABLE_LOCK_ATOMIC_HELPER_PATH \
    perl "$PORTABLE_LOCK_SESSION_EXEC_PATH" sh -c '
      . "$ROOT_PATH/scripts/check/lib/portable-process-lock.shs"
      abnormal=
      cleanup() {
        status=${1:-$?}
        trap - 0 INT TERM
        if [ -z "$abnormal" ]; then
          portable_lock_release_all
        fi
        exit "$status"
      }
      signal_exit() {
        abnormal=$1
        trap - INT TERM
        exit "$SIGNAL_STATUS"
      }
      trap "cleanup \$?" 0
      trap "signal_exit $SIGNAL_NAME" "$SIGNAL_NAME"
      portable_lock_acquire "$LOCK_ROOT" "$LOCK_NAME" 2
      printf "%s\n" "$PORTABLE_LOCK_HANDLE" >"$HANDLE_FILE"
      sh -c '\''
        trap "" INT TERM
        . "$ROOT_PATH/scripts/check/lib/portable-process-lock.shs"
        portable_lock_actual_process_identity
        printf "%s\n" "$PORTABLE_LOCK_OWNER_PID" >"$WORKER_FILE"
        while [ ! -f "$STOP_FILE" ]; do sleep 1; done
      '\'' &
      : >"$READY"
      while :; do sleep 1; done
    ' &
  abnormal_launcher=$!
  wait_for_file "$abnormal_ready"
  wait_for_file "$abnormal_worker_file"
  abnormal_handle=$(cat "$abnormal_handle_file")
  abnormal_owner=$(portable_lock_manifest_value owner_pid "$abnormal_handle")
  abnormal_worker=$(cat "$abnormal_worker_file")
  kill -"$abnormal_signal" "$abnormal_owner"
  set +e
  wait "$abnormal_launcher"
  abnormal_actual_status=$?
  set -e
  [ "$abnormal_actual_status" -eq "$abnormal_status" ] ||
    fail "$abnormal_signal owner returned $abnormal_actual_status"
  [ -e "$abnormal_handle" ] ||
    fail "$abnormal_signal cleanup released its authority claim"
  if portable_lock_acquire "$abnormal_lock_root" "$abnormal_name" 1; then
    fail "$abnormal_signal successor acquired while worker survived"
  else
    abnormal_contended=$?
    [ "$abnormal_contended" -eq 75 ] ||
      fail "$abnormal_signal contention returned $abnormal_contended"
  fi
  : >"$abnormal_stop"
  wait_for_pid_exit "$abnormal_worker"
  portable_lock_acquire "$abnormal_lock_root" "$abnormal_name" 5
  [ ! -e "$abnormal_handle" ] ||
    fail "$abnormal_signal stale claim was not recovered"
  portable_lock_release "$PORTABLE_LOCK_HANDLE" ||
    fail "$abnormal_signal successor release failed"
}

exercise_abnormal_signal TERM 143 term-owner
exercise_abnormal_signal INT 130 int-owner
mkdir -p "$tmp/deploy/.bootstrap-deploy-locks"
exercise_abnormal_signal TERM 143 deployment \
  "$tmp/deploy/.bootstrap-deploy-locks"

# KILL leaves stale links; a successor must recover them using PID+start identity.
ROOT_PATH=$root LOCK_ROOT="$tmp/real" READY="$tmp/kill.ready" \
  HANDLE_FILE="$tmp/kill.handle" \
  PORTABLE_LOCK_ATOMIC_HELPER_PATH=$PORTABLE_LOCK_ATOMIC_HELPER_PATH \
  perl "$PORTABLE_LOCK_SESSION_EXEC_PATH" sh -c '
    . "$ROOT_PATH/scripts/check/lib/portable-process-lock.shs"
    portable_lock_acquire "$LOCK_ROOT" kill-owner 2
    printf "%s\n" "$PORTABLE_LOCK_HANDLE" >"$HANDLE_FILE"
    : >"$READY"
    while :; do sleep 1; done
  ' &
kill_owner=$!
wait_for_file "$tmp/kill.ready"
kill_handle=$(cat "$tmp/kill.handle")
kill_claim_owner=$(portable_lock_manifest_value owner_pid "$kill_handle")
kill -KILL "$kill_claim_owner"
wait "$kill_owner" 2>/dev/null || :
portable_lock_acquire "$tmp/real" kill-owner 5
[ ! -e "$kill_handle" ] || fail "killed owner claim was not cleaned"
portable_lock_release "$PORTABLE_LOCK_HANDLE" || fail "KILL successor release failed"

# Multiple stale observers must serialize recovery and the protected section.
ROOT_PATH=$root LOCK_ROOT="$tmp/real" READY="$tmp/recovery.ready" \
  HANDLE_FILE="$tmp/recovery.handle" \
  PORTABLE_LOCK_ATOMIC_HELPER_PATH=$PORTABLE_LOCK_ATOMIC_HELPER_PATH \
  perl "$PORTABLE_LOCK_SESSION_EXEC_PATH" sh -c '
    . "$ROOT_PATH/scripts/check/lib/portable-process-lock.shs"
    portable_lock_acquire "$LOCK_ROOT" recovery 2
    printf "%s\n" "$PORTABLE_LOCK_HANDLE" >"$HANDLE_FILE"
    : >"$READY"
    while :; do sleep 1; done
  ' &
recovery_owner=$!
wait_for_file "$tmp/recovery.ready"
recovery_handle=$(cat "$tmp/recovery.handle")
recovery_claim_owner=$(portable_lock_manifest_value owner_pid "$recovery_handle")
kill -KILL "$recovery_claim_owner"
wait "$recovery_owner" 2>/dev/null || :
recovery_pids=
for recovery_index in 1 2 3 4; do
  ROOT_PATH=$root LOCK_ROOT="$tmp/real" ACTIVE="$tmp/recovery.active" \
    OVERLAP="$tmp/recovery.overlap" ORDER="$tmp/recovery.order" \
    INDEX=$recovery_index \
    PORTABLE_LOCK_ATOMIC_HELPER_PATH=$PORTABLE_LOCK_ATOMIC_HELPER_PATH \
    sh -c '
      . "$ROOT_PATH/scripts/check/lib/portable-process-lock.shs"
      portable_lock_acquire "$LOCK_ROOT" recovery 15
      trap "rmdir \"$ACTIVE\" 2>/dev/null || :; portable_lock_release_all" \
        0 HUP INT TERM
      if ! mkdir "$ACTIVE"; then
        : >"$OVERLAP"
        exit 1
      fi
      printf "%s\n" "$INDEX" >>"$ORDER"
      sleep 1
      rmdir "$ACTIVE"
      portable_lock_release "$PORTABLE_LOCK_HANDLE"
      trap - 0 HUP INT TERM
    ' &
  recovery_pids="$recovery_pids $!"
done
recovery_failed=0
for recovery_pid in $recovery_pids; do
  wait "$recovery_pid" || recovery_failed=1
done
[ "$recovery_failed" -eq 0 ] || fail "concurrent recovery contender failed"
[ ! -e "$tmp/recovery.overlap" ] || fail "recovery admitted overlap"
[ "$(wc -l <"$tmp/recovery.order" | tr -d ' ')" -eq 4 ] ||
  fail "not all recovery contenders completed"

# A foreground child may survive a killed shell, but cannot inherit ownership.
ROOT_PATH=$root LOCK_ROOT="$tmp/real" READY="$tmp/foreground.ready" \
  HANDLE_FILE="$tmp/foreground.handle" CHILD_PID="$tmp/foreground.child" \
  PROCEED="$tmp/foreground.proceed" MUTATION="$tmp/foreground.mutation" \
  REJECTED="$tmp/foreground.rejected" \
  PORTABLE_LOCK_ATOMIC_HELPER_PATH=$PORTABLE_LOCK_ATOMIC_HELPER_PATH \
  perl "$PORTABLE_LOCK_SESSION_EXEC_PATH" sh -c '
    . "$ROOT_PATH/scripts/check/lib/portable-process-lock.shs"
    portable_lock_acquire "$LOCK_ROOT" foreground 2
    printf "%s\n" "$PORTABLE_LOCK_HANDLE" >"$HANDLE_FILE"
    : >"$READY"
    sh -c '\''
      . "$ROOT_PATH/scripts/check/lib/portable-process-lock.shs"
      portable_lock_actual_process_identity
      printf "%s\n" "$PORTABLE_LOCK_OWNER_PID" >"$CHILD_PID"
      while [ ! -f "$PROCEED" ]; do sleep 1; done
      if portable_lock_handle_is_owned "$PORTABLE_LOCK_HANDLE"; then
        : >"$MUTATION"
      else
        : >"$REJECTED"
      fi
    '\''
    portable_lock_release "$PORTABLE_LOCK_HANDLE"
  ' &
foreground_owner=$!
wait_for_file "$tmp/foreground.ready"
wait_for_file "$tmp/foreground.child"
foreground_child=$(cat "$tmp/foreground.child")
foreground_handle=$(cat "$tmp/foreground.handle")
foreground_claim_owner=$(portable_lock_manifest_value owner_pid \
  "$foreground_handle")
kill -KILL "$foreground_claim_owner"
wait "$foreground_owner" 2>/dev/null || :
if portable_lock_acquire "$tmp/real" foreground 1; then
  fail "successor acquired while an owner-group child survived"
else
  foreground_status=$?
  [ "$foreground_status" -eq 75 ] ||
    fail "surviving child contention returned $foreground_status"
fi
: >"$tmp/foreground.proceed"
wait_for_file "$tmp/foreground.rejected"
[ ! -e "$tmp/foreground.mutation" ] ||
  fail "surviving foreground child retained mutation authority"
wait_for_pid_exit "$foreground_child"
portable_lock_acquire "$tmp/real" foreground 5
foreground_successor=$PORTABLE_LOCK_HANDLE
[ ! -e "$foreground_handle" ] ||
  fail "foreground stale claim was not cleaned"
portable_lock_release "$foreground_successor" ||
  fail "foreground successor release failed"

printf 'portable process lock behavioral tests passed\n'
