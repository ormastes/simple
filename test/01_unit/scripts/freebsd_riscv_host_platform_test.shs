#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$root/scripts/check/lib/bootstrap-stage3/authority.shs"
uname() {
    case "$1" in
        -m) printf '%s\n' "$fixture_machine" ;;
        -s) printf '%s\n' "$fixture_system" ;;
        -p) [ "$fixture_processor" != unavailable ] || return 1
            printf '%s\n' "$fixture_processor" ;;
        *) return 1 ;;
    esac
}
fixture_system=FreeBSD
fixture_machine=riscv
fixture_processor=riscv64
[ "$(bootstrap_stage3_host_platform)" = riscv64-unknown-freebsd ]
fixture_machine=riscv64
fixture_processor=unavailable
[ "$(bootstrap_stage3_host_platform)" = riscv64-unknown-freebsd ]
fixture_machine=riscv
for fixture_processor in riscv32 unknown unavailable; do
    if bootstrap_stage3_host_platform >/dev/null 2>&1; then
        echo "FAIL: accepted unsupported FreeBSD processor $fixture_processor" >&2
        exit 1
    fi
done
fixture_machine=amd64
[ "$(bootstrap_stage3_host_platform)" = x86_64-unknown-freebsd ]
fixture_machine=aarch64
[ "$(bootstrap_stage3_host_platform)" = aarch64-unknown-freebsd ]
fixture_system=Linux
fixture_machine=x86_64
[ "$(bootstrap_stage3_host_platform)" = x86_64-unknown-linux-gnu ]
echo 'freebsd_riscv_host_platform=pass'
