#!/bin/sh
set -eu
case "$(uname -s)" in MSYS*|MINGW*|CYGWIN*) ;; *) echo 'SKIP: Windows Stage3 long paths'; exit 0 ;; esac
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$root/scripts/check/lib/bootstrap-stage3/authority.shs"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/stage3-long-paths.XXXXXX")
trap 'rm -rf -- "$tmp"' EXIT HUP INT TERM
bootstrap_stage3_materialized_native_source >"$tmp/native.ps1"
powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \
    "$(cygpath -aw "$root/test/01_unit/scripts/bootstrap_stage3_windows_long_paths_test.ps1")" \
    "$(cygpath -aw "$tmp/native.ps1")"
echo 'PASS: Windows Stage3 long-path opens retain containment and reparse checks'
