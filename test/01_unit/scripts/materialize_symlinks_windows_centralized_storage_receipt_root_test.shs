#!/bin/sh
set -Eeuo pipefail

# Regression: the receipt-path guard in materialize-symlinks-windows.shs must
# accept the dedicated bootstrap output roots inside the repo — the legacy
# build/bootstrap tree and the centralized worktree storage root
# (.simple/storage/build/bootstrap, or an explicit SIMPLE_BOOTSTRAP_BUILD_ROOT)
# — while still refusing receipts scattered elsewhere under the repo. Before
# the fix, a bootstrap using the default centralized storage output root
# aborted on Windows with "receipt must use the dedicated bootstrap output
# root" before any stage started.

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$root/scripts/setup/host-env.shs"
host_env_apply_path
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) ;; *) echo 'BLOCKED: Windows/MSYS required' >&2; exit 77 ;; esac
for tool in git mktemp cygpath powershell stat; do
    command -v "$tool" >/dev/null || { echo "BLOCKED: missing $tool" >&2; exit 77; }
done

mkdir -p "$root/build/test-tmp"
tmp=$(mktemp -d "$root/build/test-tmp/simple-materialize-central-receipt.XXXXXX")
trap 'rm -rf -- "$tmp"' EXIT
export TMPDIR="$tmp"
# The materializer canonicalizes the repo root with pwd; the receipt strings
# below must be built from the same canonical prefix or the case match fails.
tmp=$(CDPATH= cd -- "$tmp" && pwd -P)

repo="$tmp/repo"
mkdir -p "$repo" "$tmp/out"
git -C "$repo" init -q
git -C "$repo" config core.symlinks false
git -C "$repo" config user.email test@example.invalid
git -C "$repo" config user.name materializer-central-receipt-test
printf 'payload\n' >"$repo/target.txt"
printf 'target.txt' >"$repo/alias"
blob=$(git -C "$repo" hash-object -w --stdin <"$repo/alias")
git -C "$repo" add target.txt
git -C "$repo" update-index --add --cacheinfo "120000,$blob,alias"
git -C "$repo" commit -qm fixture

materializer="$root/scripts/setup/materialize-symlinks-windows.shs"

# 1. Centralized storage bootstrap output root is accepted.
central_receipt="$repo/.simple/storage/build/bootstrap/materialized-links/r.env"
sh "$materializer" --strict-missing --receipt "$central_receipt" "$repo" \
    >"$tmp/central.log" 2>&1 || { cat "$tmp/central.log" >&2; exit 1; }
grep -Fqx 'result=complete' "$central_receipt"
grep -Fqx 'pending_count=0' "$central_receipt"

# 2. Explicit SIMPLE_BOOTSTRAP_BUILD_ROOT inside the repo is accepted.
# Set the var inside an msys2 sh parent: msys2->msys2 env passing survives
# this host's env-scrubbing sh, where an inline assignment from the test's
# own shell would be dropped before reaching the materializer.
mkdir -p "$repo/custom-bootstrap-root"
custom_receipt="$repo/custom-bootstrap-root/r.env"
sh -c 'export SIMPLE_BOOTSTRAP_BUILD_ROOT="$1"; shift; exec sh "$@"' \
    _ "$repo/custom-bootstrap-root" "$materializer" \
    --strict-missing --receipt "$custom_receipt" "$repo" >"$tmp/custom.log" 2>&1 || {
    cat "$tmp/custom.log" >&2; exit 1; }
grep -Fqx 'result=complete' "$custom_receipt"

# 3. A receipt elsewhere under the repo is still refused with the dedicated-root error.
mkdir -p "$repo/src"
if sh "$materializer" --strict-missing --receipt "$repo/src/r.env" "$repo" \
    >"$tmp/reject.log" 2>&1; then
    echo 'receipt under repo src/ unexpectedly accepted' >&2
    exit 1
fi
grep -Fq 'receipt must use the dedicated bootstrap output root' "$tmp/reject.log"

echo 'PASS: centralized-storage bootstrap output roots accepted for Windows materializer receipts'
