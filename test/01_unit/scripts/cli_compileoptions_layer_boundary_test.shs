#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
cli_dir="$root/src/app/io/_CliCompile"
driver_options="$root/src/compiler/00.common/driver_compile_options.spl"
backend_options="$root/src/compiler/70.backend/backend/backend_types.spl"

if rg -q 'TargetOptContext|target_opt_context_default|target_opt_ctx' "$cli_dir"; then
    echo "FAIL: CLI must not transport backend-owned TargetOptContext through driver CompileOptions" >&2
    exit 1
fi

if rg -q 'target_opt_ctx' "$driver_options"; then
    echo "FAIL: layer 00 CompileOptions must not depend on layer 60 TargetOptContext" >&2
    exit 1
fi

rg -q 'target_opt_ctx: TargetOptContext' "$backend_options"
rg -q 'target_opt_ctx: target_opt_context_default()' "$backend_options"

echo "PASS: target optimization context stays owned by the backend boundary"
