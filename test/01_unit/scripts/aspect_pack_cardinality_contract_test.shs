#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
aspect="$repo_root/src/lib/common/aspect_pack.spl"

need() {
    grep -Fq "$1" "$aspect" || {
        echo "FAIL: aspect-pack cardinality contract missing: $1" >&2
        exit 1
    }
}

need 'var _ld_binding_counts: [i64] = []'
need '_ld_binding_counts[ld] = _ld_binding_counts[ld] + 1'
need 'var owns_live_state = _ld_binding_counts[ld] > 0'
need 'next_binding_counts[_fc_ld[row]] = next_binding_counts[_fc_ld[row]] + 1'
need '_ld_binding_counts = next_binding_counts'
need '_fc_unloaded_order.len() as i64'
if grep -Fq '_ld_binding_index[ld].keys().len()' "$aspect" ||
        grep -Fq '_fc_unloaded.keys().len()' "$aspect"; then
    echo "FAIL: aspect-pack cardinality rematerializes dictionary keys" >&2
    exit 1
fi

echo "aspect_pack_cardinality_cases=8"
echo "aspect_pack_cardinality_status=PASS"
