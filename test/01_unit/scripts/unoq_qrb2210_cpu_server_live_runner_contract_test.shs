#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
RUNNER=$ROOT/scripts/check/run-unoq-qrb2210-cpu-server-live.shs
COLLECTOR=$ROOT/scripts/check/collect-unoq-server-verification-receipt.shs
sh -n "$RUNNER"
sh -n "$COLLECTOR"
output=$(sh "$RUNNER" --self-test)
printf '%s\n' "$output" | grep -Fqx 'unoq_cpu_server_self_test_status=pass'
printf '%s\n' "$output" | grep -Fqx 'unoq_cpu_server_self_test_evidence=negative-only-no-adb'
grep -Fq 'physical-simpleos-identity-missing' "$RUNNER"
grep -Fq 'vendor-debian-is-not-simpleos' "$RUNNER"
grep -Fq 'gpu_libraries_loaded' "$RUNNER"
grep -Fq 'db_restart_value_match' "$RUNNER"
grep -Fq 'parent_authoritative_commit' "$RUNNER"
grep -Fq 'simpleos-arm64-current-source-compiler-admission-v1' "$RUNNER"
grep -Fq 'fresh_reboot_count' "$RUNNER"
grep -Fq 'accelerator_provider_loaded' "$RUNNER"
grep -Fq 'credential_bytes_retained' "$RUNNER"
grep -Fq 'native_smoke_output_sha256' "$RUNNER"
grep -Fq 'source_revision=' "$RUNNER"
grep -Fq 'server-before.maps' "$RUNNER"
grep -Fq 'fresh-reboot-not-observed' "$RUNNER"
grep -Fq '.unoq-cpu-live-XXXXXX.tmp' "$RUNNER"
grep -Fq 'inherited-lock-fd-not-unoq-lock' "$RUNNER"
grep -Fq 'server-before.fds' "$RUNNER"
grep -Fq 'provider-changed-during-reboot-campaign' "$RUNNER"
grep -Fq 'server-pid-executable-mismatch' "$RUNNER"
grep -Fq 'post-reboot-accelerator-observed' "$RUNNER"
grep -Fq 'host-http-filesystem-bytes-mismatch' "$RUNNER"
grep -Fq 'host-db-after-value-missing' "$RUNNER"
grep -Fq 'credential-bytes-retained' "$RUNNER"
grep -Fq 'remote-cleanup-unverified' "$RUNNER"
grep -Fq 'CPU status/exit mismatch' "$COLLECTOR"
grep -Fq 'escaped collector output' "$COLLECTOR"
grep -Fq 'cpu_evidence_class=' "$COLLECTOR"
echo 'unoq_cpu_server_runner_contract_status=pass'
