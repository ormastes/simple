#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)
. "$ROOT/scripts/tool/storage-roots.shs"

SIMPLE_USER_STORAGE_ROOT=/user/storage
SIMPLE_WORKTREE_STORAGE_ROOT=/worktree/storage
export SIMPLE_USER_STORAGE_ROOT SIMPLE_WORKTREE_STORAGE_ROOT
simple_tool_storage_init "$ROOT" fixture-tool

[ "$SIMPLE_TOOL_CACHE_ROOT" = /user/storage/cache/tools/fixture-tool ]
[ "$SIMPLE_TOOL_TMP_ROOT" = /worktree/storage/tmp/tools/fixture-tool ]
[ "$SIMPLE_TOOL_BUILD_ROOT" = /worktree/storage/build/tools/fixture-tool ]

for producer in \
    generate-riscv-gen2-zca-oracle.shs \
    build-riscv-gen2-zca-sail-classifier.shs \
    riscv-gen2-zca-sail-batch-adapter.shs; do
    ! grep -Eq 'TMPDIR:-/tmp|mktemp -d .*\/tmp' "$ROOT/scripts/tool/$producer"
done

grep -Fq 'SIMPLE_TOOL_CACHE_ROOT' "$ROOT/scripts/tool/enumerate-os-lowering-failures.shs"
grep -Fq 'SIMPLE_TOOL_TMP_ROOT' "$ROOT/scripts/tool/sweep-os-parse-errors.shs"
grep -Fq 'SIMPLE_USER_STORAGE_ROOT/downloads/riscv-zca-oracle' "$ROOT/scripts/tool/acquire-riscv-gen2-zca-oracle.shs"
grep -Fq 'storage_source=explicit-override' "$ROOT/scripts/tool/acquire-riscv-gen2-zca-oracle.shs"

printf 'tool storage roots: PASS\n'
