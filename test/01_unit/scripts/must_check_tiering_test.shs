#!/bin/sh
set -eu

ROOT=$(cd "$(dirname "$0")/../../.." && pwd)
PUSH="$ROOT/scripts/check/check-push-must-pass.shs"
BOOTSTRAP="$ROOT/scripts/check/check-bootstrap-must-pass.shs"
HOOK="$ROOT/scripts/check/pre-push-conflict-tree-guard.shs"
INSTALL_UNIX="$ROOT/scripts/setup/install-must-check-hooks.shs"
INSTALL_WINDOWS="$ROOT/scripts/setup/install-must-check-hooks.ps1"
SETUP_HOOKS="$ROOT/scripts/setup/setup-hooks.shs"
ZERO=0000000000000000000000000000000000000000

start=$(date +%s)
sh "$PUSH" --self-test >/dev/null
elapsed=$(($(date +%s) - start))
[ "$elapsed" -le 10 ] || { echo "FAIL: push must-check selftest took ${elapsed}s"; exit 1; }

sh "$BOOTSTRAP" --self-test >/dev/null
grep -q 'exec sh "$repo_root/scripts/check/check-push-must-pass.shs"' "$HOOK"
grep -q 'check-bootstrap-stage3-selfverify.shs' "$BOOTSTRAP"
grep -q 'check-post-bootstrap-stage4-sspec.shs' "$BOOTSTRAP"
grep -q 'pre-push.local' "$ROOT/scripts/hooks/pre-push"
grep -q 'cmp -s "$LOCAL_HOOK" "$CANONICAL_GUARD"' "$ROOT/scripts/hooks/pre-push"
grep -q -- '--install' "$INSTALL_UNIX"
grep -q 'Move-Item' "$INSTALL_WINDOWS"
grep -q 'scripts/setup/setup-hooks.shs' "$ROOT/scripts/setup/setup.shs"

fixture=$(mktemp -d)
rules_fixture=$(mktemp -d)
external_fixture=$(mktemp -d)
trap 'rm -rf "$fixture" "$fixture-hook-repo" "$fixture-hook-peer" "$rules_fixture" "$external_fixture"' EXIT INT TERM

# The production external-evidence validator owns the acceptance matrix. Prove
# one valid row and adjacent semantic mutations before testing recorder wiring.
mkdir -p "$external_fixture/evidence" "$external_fixture/scripts/check" "$external_fixture/config/check"
cp "$ROOT/scripts/check/check-external-must-check-receipt.shs" "$external_fixture/scripts/check/"
external_validator="$external_fixture/scripts/check/check-external-must-check-receipt.shs"
git -C "$external_fixture" init -q
git -C "$external_fixture" config user.name must-check-test
git -C "$external_fixture" config user.email must-check-test@example.invalid
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$external_fixture/reviewer-private.pem" >/dev/null 2>&1
openssl pkey -in "$external_fixture/reviewer-private.pem" -pubout -out "$external_fixture/config/check/fixture-reviewer.pem" >/dev/null 2>&1
reviewer_public_sha=$(sha256sum "$external_fixture/config/check/fixture-reviewer.pem" | awk '{print $1}')
printf '%s\n' \
    'must_check_external_reviewers:' \
    '  schema: "simple.must-check-reviewer-policy/v1"' \
    'trusted_reviewers |key_id, public_key_path, public_key_sha256|' \
    "    fixture-reviewer, config/check/fixture-reviewer.pem, $reviewer_public_sha" \
    > "$external_fixture/config/check/must_check_external_reviewers.sdn"
external_fp=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
external_run=run-001
cat > "$external_fixture/evidence/command.env" <<EOF
evidence_schema=simple.must-check-command/v1
gate_id=web-server-request-port
source_fingerprint=$external_fp
run_id=$external_run
command=check-web-server-request-port
exit_status=0
final_verdict=PASS
EOF
cat > "$external_fixture/evidence/target.env" <<EOF
evidence_schema=simple.must-check-target/v1
gate_id=web-server-request-port
run_id=$external_run
target_kind=native-host
target_id=fixture-host
final_verdict=PASS
EOF
cat > "$external_fixture/evidence/toolchain.env" <<EOF
evidence_schema=simple.must-check-toolchain/v1
gate_id=web-server-request-port
run_id=$external_run
toolchain_id=fixture-toolchain
final_verdict=PASS
EOF
cat > "$external_fixture/evidence/observations.env" <<EOF
evidence_schema=simple.must-check-observations/v1
gate_id=web-server-request-port
source_fingerprint=$external_fp
run_id=$external_run
acceptance_ids=configurable-port,listen,request,response,ownership,stop,no-leak
acceptance.configurable-port=PASS
acceptance.listen=PASS
acceptance.request=PASS
acceptance.response=PASS
acceptance.ownership=PASS
acceptance.stop=PASS
acceptance.no-leak=PASS
final_verdict=PASS
EOF
git -C "$external_fixture" add evidence scripts/check config/check
git -C "$external_fixture" commit -qm external-evidence-blobs
command_sha=$(sha256sum "$external_fixture/evidence/command.env" | awk '{print $1}')
target_sha=$(sha256sum "$external_fixture/evidence/target.env" | awk '{print $1}')
toolchain_sha=$(sha256sum "$external_fixture/evidence/toolchain.env" | awk '{print $1}')
observations_sha=$(sha256sum "$external_fixture/evidence/observations.env" | awk '{print $1}')
external_artifact="$external_fixture/evidence/summary.env"
cat > "$external_artifact" <<'EOF'
evidence_schema=simple.must-check-external-evidence/v2
gate_id=web-server-request-port
source_fingerprint=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
final_verdict=PASS
producer_id=server-producer
producer_kind=native-host
run_id=run-001
produced_at_utc=2000-01-01T00:00:00Z
reviewer_key_id=fixture-reviewer
command_receipt_path=evidence/command.env
command_receipt_sha256=COMMAND_SHA
target_identity_path=evidence/target.env
target_identity_sha256=TARGET_SHA
toolchain_identity_path=evidence/toolchain.env
toolchain_identity_sha256=TOOLCHAIN_SHA
observations_path=evidence/observations.env
observations_sha256=OBSERVATIONS_SHA
acceptance_contract=web-server-request-port/v1
acceptance_ids=configurable-port,listen,request,response,ownership,stop,no-leak
EOF
sed -i "s/COMMAND_SHA/$command_sha/; s/TARGET_SHA/$target_sha/; s/TOOLCHAIN_SHA/$toolchain_sha/; s/OBSERVATIONS_SHA/$observations_sha/" "$external_artifact"
openssl dgst -sha256 -sign "$external_fixture/reviewer-private.pem" -out "$external_fixture/evidence/reviewer.sig" "$external_artifact"
signature_sha=$(sha256sum "$external_fixture/evidence/reviewer.sig" | awk '{print $1}')
external_receipt="$external_fixture/evidence/external.receipt"
printf '%s\n' \
    'reviewer_signature_path=evidence/reviewer.sig' \
    "reviewer_signature_sha256=$signature_sha" > "$external_receipt"
git -C "$external_fixture" add evidence/summary.env evidence/reviewer.sig evidence/external.receipt
git -C "$external_fixture" commit -qm signed-external-summary
external_signed_commit=$(git -C "$external_fixture" rev-parse HEAD)
MUST_CHECK_ROOT="$external_fixture" \
MUST_CHECK_RECEIPT_FILE="$external_receipt" \
MUST_CHECK_ARTIFACT_FILE="$external_artifact" \
MUST_CHECK_EXPECTED_GATE=web-server-request-port \
MUST_CHECK_EXPECTED_FINGERPRINT=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
    sh "$external_validator" | grep -q '^STATUS: PASS '
for mutation in \
    's/producer_id=server-producer/producer_id=fixture-reviewer/' \
    's/reviewer_key_id=fixture-reviewer/reviewer_key_id=other-reviewer/' \
    's/observations_sha256=[0-9a-f]*/observations_sha256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/' \
    's/,no-leak$//'; do
    sed "$mutation" "$external_artifact" > "$external_fixture/external-bad.artifact"
    MUST_CHECK_ROOT="$external_fixture" \
    MUST_CHECK_RECEIPT_FILE="$external_receipt" \
    MUST_CHECK_ARTIFACT_FILE="$external_fixture/external-bad.artifact" \
    MUST_CHECK_EXPECTED_GATE=web-server-request-port \
    MUST_CHECK_EXPECTED_FINGERPRINT=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
        sh "$external_validator" >/dev/null 2>&1 && {
            echo "FAIL: external semantic evidence mutation was accepted: $mutation"
            exit 1
        }
done
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$external_fixture/wrong-private.pem" >/dev/null 2>&1
openssl pkey -in "$external_fixture/wrong-private.pem" -pubout -out "$external_fixture/wrong-public.pem" >/dev/null 2>&1
cp "$external_fixture/wrong-public.pem" "$external_fixture/config/check/fixture-reviewer.pem"
wrong_public_sha=$(sha256sum "$external_fixture/config/check/fixture-reviewer.pem" | awk '{print $1}')
sed -i "s/$reviewer_public_sha/$wrong_public_sha/" "$external_fixture/config/check/must_check_external_reviewers.sdn"
git -C "$external_fixture" add config/check
git -C "$external_fixture" commit -qm replace-reviewer-key-with-wrong-key
MUST_CHECK_ROOT="$external_fixture" \
MUST_CHECK_RECEIPT_FILE="$external_receipt" \
MUST_CHECK_ARTIFACT_FILE="$external_artifact" \
MUST_CHECK_EXPECTED_GATE=web-server-request-port \
MUST_CHECK_EXPECTED_FINGERPRINT=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
    sh "$external_validator" >/dev/null 2>&1 && {
        echo 'FAIL: external summary signed by another key was accepted'
        exit 1
    }
openssl pkey -in "$external_fixture/reviewer-private.pem" -pubout -out "$external_fixture/config/check/fixture-reviewer.pem" >/dev/null 2>&1
restored_public_sha=$(sha256sum "$external_fixture/config/check/fixture-reviewer.pem" | awk '{print $1}')
sed -i "s/$wrong_public_sha/$restored_public_sha/" "$external_fixture/config/check/must_check_external_reviewers.sdn"
git -C "$external_fixture" add config/check
git -C "$external_fixture" commit -qm restore-reviewer-key
printf '%s\n' 'acceptance.unreviewed-extra=PASS' >> "$external_fixture/evidence/observations.env"
git -C "$external_fixture" add evidence/observations.env
git -C "$external_fixture" commit -qm tampered-observations-after-review
MUST_CHECK_ROOT="$external_fixture" \
MUST_CHECK_RECEIPT_FILE="$external_receipt" \
MUST_CHECK_ARTIFACT_FILE="$external_artifact" \
MUST_CHECK_EXPECTED_GATE=web-server-request-port \
MUST_CHECK_EXPECTED_FINGERPRINT=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
    sh "$external_validator" >/dev/null 2>&1 && {
        echo 'FAIL: changed committed observation blob retained its old admission'
        exit 1
    }
for contradiction in FAIL BLOCKED; do
    git -C "$external_fixture" show "$external_signed_commit:evidence/observations.env" > "$external_fixture/evidence/observations.env"
    printf 'acceptance.no-leak=%s\n' "$contradiction" >> "$external_fixture/evidence/observations.env"
    git -C "$external_fixture" add evidence/observations.env
    git -C "$external_fixture" commit -qm "contradictory-$contradiction-observation"
    contradiction_observations_sha=$(sha256sum "$external_fixture/evidence/observations.env" | awk '{print $1}')
    git -C "$external_fixture" show "$external_signed_commit:evidence/summary.env" > "$external_artifact"
    sed -i "s/observations_sha256=[0-9a-f]*/observations_sha256=$contradiction_observations_sha/" "$external_artifact"
    openssl dgst -sha256 -sign "$external_fixture/reviewer-private.pem" -out "$external_fixture/evidence/reviewer.sig" "$external_artifact"
    contradiction_signature_sha=$(sha256sum "$external_fixture/evidence/reviewer.sig" | awk '{print $1}')
    git -C "$external_fixture" show "$external_signed_commit:evidence/external.receipt" > "$external_receipt"
    sed -i "s/reviewer_signature_sha256=[0-9a-f]*/reviewer_signature_sha256=$contradiction_signature_sha/" "$external_receipt"
    git -C "$external_fixture" add evidence/summary.env evidence/reviewer.sig evidence/external.receipt
    git -C "$external_fixture" commit -qm "signed-contradictory-$contradiction-summary"
    MUST_CHECK_ROOT="$external_fixture" \
    MUST_CHECK_RECEIPT_FILE="$external_receipt" \
    MUST_CHECK_ARTIFACT_FILE="$external_artifact" \
    MUST_CHECK_EXPECTED_GATE=web-server-request-port \
    MUST_CHECK_EXPECTED_FINGERPRINT=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
        sh "$external_validator" >/dev/null 2>&1 && {
            echo "FAIL: contradictory $contradiction acceptance was admitted"
            exit 1
        }
done

# A --ref scan must parse policy from that commit, not a hostile/dirty working
# rules.sdl. The dirty command would sleep and fail if the checker read it.
mkdir -p "$rules_fixture/scripts/check"
cp "$ROOT/scripts/check/check-rules-sdl.shs" "$rules_fixture/scripts/check/"
printf '%s\n' proof > "$rules_fixture/proof"
printf '%s\n' \
    'rules:' \
    '  count_gates:' \
    '    - id: committed_policy' \
    '      group: quick' \
    '      cmd: git cat-file -s "$REF:proof"' \
    '      min: 1' > "$rules_fixture/rules.sdl"
git -C "$rules_fixture" init -q
git -C "$rules_fixture" config user.name must-check-test
git -C "$rules_fixture" config user.email must-check-test@example.invalid
git -C "$rules_fixture" add .
git -C "$rules_fixture" commit -qm committed-rules
rules_ref=$(git -C "$rules_fixture" rev-parse HEAD)
rules_policy_sha=$(git -C "$rules_fixture" show "$rules_ref:rules.sdl" | sha256sum | awk '{print $1}')
printf '%s\n' \
    'rules:' \
    '  count_gates:' \
    '    - id: hostile_worktree_policy' \
    '      group: quick' \
    '      cmd: sleep 30; echo 0' \
    '      min: 1' > "$rules_fixture/rules.sdl"
(cd "$rules_fixture" && RULES_SELFTEST=1 RULES_POLICY_SHA256_OVERRIDE="$rules_policy_sha" sh scripts/check/check-rules-sdl.shs --group quick --ref "$rules_ref") |
    grep -q 'PASS — 1 gates checked'

# Linked worktrees share one hooks directory. Installing from one worktree must
# not bind that shared hook to the installer's absolute checkout path, because
# the sibling worktree's wiring verifier would then reject every normal push.
hook_repo="$fixture-hook-repo"
hook_peer="$fixture-hook-peer"
mkdir -p "$hook_repo/scripts/setup" "$hook_repo/scripts/hooks" "$hook_repo/scripts/check"
cp "$INSTALL_UNIX" "$hook_repo/scripts/setup/install-must-check-hooks.shs"
cp "$SETUP_HOOKS" "$hook_repo/scripts/setup/setup-hooks.shs"
cp "$ROOT/scripts/hooks/pre-push" "$hook_repo/scripts/hooks/pre-push"
cp "$ROOT/scripts/hooks/pre-push-worktree-launcher" "$hook_repo/scripts/hooks/pre-push-worktree-launcher"
cp "$ROOT/scripts/check/check-hook-installation.shs" "$hook_repo/scripts/check/check-hook-installation.shs"
cp "$ROOT/scripts/check/pre-push-conflict-tree-guard.shs" "$hook_repo/scripts/check/pre-push-conflict-tree-guard.shs"
cp "$PUSH" "$hook_repo/scripts/check/check-push-must-pass.shs"
for guard in check-tree-size-push check-no-conflict-tree-push check-no-conflict-markers-push check-no-revert-push; do
    printf '%s\n' '#!/bin/sh' 'exit 0' > "$hook_repo/scripts/check/$guard.shs"
done
grep -Eq 'push-runtime-api-regression,[[:space:]]*push,[[:space:]]*true,[[:space:]]*range,[[:space:]]*"sh scripts/check/check-runtime-api-regression-push.shs --scan-only"' "$ROOT/config/check/must_check_gates.sdn" || {
    echo "FAIL: push runtime API guard does not use bounded scan-only mode"
    exit 1
}
grep -Eq 'runtime-api-regression-selftest,[[:space:]]*bootstrap,[[:space:]]*false,[[:space:]]*automated,[[:space:]]*"sh scripts/check/check-runtime-api-regression-push.shs --selftest"' "$ROOT/config/check/must_check_gates.sdn" || {
    echo "FAIL: runtime API mutation selftest is not bootstrap-owned"
    exit 1
}
grep -Eq 'push-interpreter-extern-registry-gap,[[:space:]]*push,[[:space:]]*true,[[:space:]]*tree,[[:space:]]*"sh scripts/check/check-interpreter-extern-registry-gap.shs --scan-only"' "$ROOT/config/check/must_check_gates.sdn" || {
    echo "FAIL: push extern registry guard does not use scan-only mode"
    exit 1
}
grep -Fq '"$ROOT/scripts/check/check-interpreter-extern-registry-gap.shs" --scan-only' "$PUSH" || {
    echo "FAIL: push dispatcher does not pass scan-only to extern registry guard"
    exit 1
}
grep -Eq 'interpreter-extern-registry-gap-selftest,[[:space:]]*bootstrap,[[:space:]]*false,[[:space:]]*automated,[[:space:]]*"sh scripts/check/check-interpreter-extern-registry-gap.shs --selftest"' "$ROOT/config/check/must_check_gates.sdn" || {
    echo "FAIL: extern registry mutation selftest is not bootstrap-owned"
    exit 1
}
grep -Eq 'push-type-walk-constructor-parity,[[:space:]]*push,[[:space:]]*true,[[:space:]]*tree,[[:space:]]*"sh scripts/check/check-type-walk-constructor-parity.shs --scan-only"' "$ROOT/config/check/must_check_gates.sdn" || {
    echo "FAIL: push type-walk guard does not use scan-only mode"
    exit 1
}
grep -Fq '"$ROOT/scripts/check/check-type-walk-constructor-parity.shs" --scan-only' "$PUSH" || {
    echo "FAIL: push dispatcher does not pass scan-only to type-walk guard"
    exit 1
}
grep -Eq 'type-walk-constructor-parity-selftest,[[:space:]]*bootstrap,[[:space:]]*false,[[:space:]]*automated,[[:space:]]*"sh scripts/check/check-type-walk-constructor-parity.shs --selftest"' "$ROOT/config/check/must_check_gates.sdn" || {
    echo "FAIL: type-walk mutation selftest is not bootstrap-owned"
    exit 1
}
sh "$ROOT/scripts/check/check-interpreter-extern-registry-gap.shs" --scan-only >/dev/null
sh "$ROOT/scripts/check/check-type-walk-constructor-parity.shs" --scan-only >/dev/null
chmod +x "$hook_repo/scripts/hooks/pre-push" "$hook_repo/scripts/check/"*.shs
git -C "$hook_repo" init -q
git -C "$hook_repo" config user.name must-check-test
git -C "$hook_repo" config user.email must-check-test@example.invalid
git -C "$hook_repo" add .
git -C "$hook_repo" commit -qm hook-base
git -C "$hook_repo" worktree add -q "$hook_peer" HEAD
sh "$hook_repo/scripts/setup/install-must-check-hooks.shs" --install >/dev/null
(cd "$hook_peer" && sh scripts/setup/install-must-check-hooks.shs --check >/dev/null)
(cd "$hook_peer" && sh scripts/check/check-hook-installation.shs)
(cd "$hook_peer" && sh scripts/setup/setup-hooks.shs >/dev/null)
cp "$hook_peer/scripts/setup/install-must-check-hooks.shs" "$hook_peer/scripts/setup/install-must-check-hooks.shs.saved"
printf '%s\n' '#!/bin/sh' 'exit 9' > "$hook_peer/scripts/setup/install-must-check-hooks.shs"
chmod +x "$hook_peer/scripts/setup/install-must-check-hooks.shs"
if (cd "$hook_peer" && sh scripts/setup/setup-hooks.shs >/dev/null 2>&1); then
    echo "FAIL: general setup hook helper suppressed installer failure"
    exit 1
fi
mv "$hook_peer/scripts/setup/install-must-check-hooks.shs.saved" "$hook_peer/scripts/setup/install-must-check-hooks.shs"
cp "$hook_peer/scripts/check/check-hook-installation.shs" "$hook_peer/scripts/check/check-hook-installation.shs.saved"
printf '%s\n' '#!/bin/sh' 'exit 8' > "$hook_peer/scripts/check/check-hook-installation.shs"
chmod +x "$hook_peer/scripts/check/check-hook-installation.shs"
if (cd "$hook_peer" && sh scripts/setup/setup-hooks.shs >/dev/null 2>&1); then
    echo "FAIL: general setup hook helper suppressed verifier failure"
    exit 1
fi
mv "$hook_peer/scripts/check/check-hook-installation.shs.saved" "$hook_peer/scripts/check/check-hook-installation.shs"
shared_hooks=$(git -C "$hook_repo" rev-parse --git-path hooks)
case "$shared_hooks" in /*) : ;; *) shared_hooks="$hook_repo/$shared_hooks" ;; esac
[ ! -L "$shared_hooks/pre-push" ]
cmp -s "$hook_repo/scripts/hooks/pre-push-worktree-launcher" "$shared_hooks/pre-push"

# A legacy canonical dispatcher is replacement material, not a local hook: if
# preserved it would call the dispatcher from inside itself forever.
rm -f "$shared_hooks/pre-push.local"
cp "$hook_repo/scripts/hooks/pre-push" "$shared_hooks/pre-push"
(cd "$hook_peer" && sh scripts/setup/install-must-check-hooks.shs --install >/dev/null)
[ ! -e "$shared_hooks/pre-push.local" ]
cmp -s "$hook_peer/scripts/hooks/pre-push-worktree-launcher" "$shared_hooks/pre-push"

# A genuinely unrelated hook is still preserved and chained.
printf '%s\n' '#!/bin/sh' 'echo unrelated-local-hook' > "$shared_hooks/pre-push"
chmod +x "$shared_hooks/pre-push"
sh "$hook_repo/scripts/setup/install-must-check-hooks.shs" --install >/dev/null
grep -q 'unrelated-local-hook' "$shared_hooks/pre-push.local"
cmp -s "$hook_repo/scripts/hooks/pre-push-worktree-launcher" "$shared_hooks/pre-push"

if grep -E 'sh .*(native-build|qemu|benchmark)|--whole' "$PUSH" >/dev/null; then
    echo "FAIL: push-tier driver directly names an expensive execution lane"
    exit 1
fi

# Measured whole-tree/compiler lanes belong to bootstrap, not the interactive
# hook. Their registry rows remain mandatory and automated rather than being
# deleted to make the push path look fast.
for moved_gate in use-target-resolves c-runtime-compiles no-direct-rt signature-type-import-provenance perf-regression-tests process-wait-eintr-retry guard-wiring outline-parse-terminates; do
    grep -Eq "^[[:space:]]+$moved_gate,[[:space:]]*bootstrap,[[:space:]]*false,[[:space:]]*automated," "$ROOT/config/check/must_check_gates.sdn" || {
        echo "FAIL: measured expensive gate is not bootstrap-owned: $moved_gate"
        exit 1
    }
    grep -Eq "^[[:space:]]+$moved_gate,[[:space:]]*todo,[[:space:]]*never," "$ROOT/doc/08_tracking/check/must_check_db.sdn" || {
        echo "FAIL: moved bootstrap gate is absent from the textual ledger: $moved_gate"
        exit 1
    }
done

# Exercise the real pre-push ref-input path in an isolated committed fixture.
mkdir -p "$fixture/scripts/check" "$fixture/scripts/hooks" "$fixture/config/check" "$fixture/doc/08_tracking/check"
cp "$PUSH" "$fixture/scripts/check/check-push-must-pass.shs"
cp "$HOOK" "$fixture/scripts/check/pre-push-conflict-tree-guard.shs"
cp "$ROOT/scripts/hooks/pre-push" "$fixture/scripts/hooks/pre-push"
cp "$ROOT/scripts/hooks/pre-push-worktree-launcher" "$fixture/scripts/hooks/pre-push-worktree-launcher"
printf '%s\n' '#!/bin/sh' 'echo "check-hook-installation: PASS — fixture"' > "$fixture/scripts/check/check-hook-installation.shs"
chmod +x "$fixture/scripts/check/check-hook-installation.shs" "$fixture/scripts/hooks/pre-push" "$fixture/scripts/hooks/pre-push-worktree-launcher"
for guard in check-no-conflict-tree-push check-tree-size-push check-no-conflict-markers-push check-rules-sdl check-interpreter-module-owners; do
    printf '%s\n' '#!/bin/sh' 'echo "PASS — fixture guard"' > "$fixture/scripts/check/$guard.shs"
    chmod +x "$fixture/scripts/check/$guard.shs"
done
printf '%s\n' '#!/bin/sh' \
    '[ "$#" -eq 2 ] && [ "$1" = --push-tip ] && printf "%s\\n" "$2" | grep -q "\\.\\." || { echo "FAIL — tree guard was not invoked in bounded push-tip mode"; exit 1; }' \
    "echo invoked >> '$fixture/tree-guard-invocations'" \
    'echo "PASS — fixture tree guard"' \
    > "$fixture/scripts/check/check-tree-size-push.shs"
chmod +x "$fixture/scripts/check/check-tree-size-push.shs"
printf '%s\n' \
    'must_check_gates |id, tier, push_blocking, mode, command, description|' \
    '    compiler-stage1, bootstrap, true, receipt, "", "fixture"' \
    '    fixture-manual-receipt, bootstrap, true, external-receipt, "sh scripts/check/check-fixture-external-receipt.shs", "record fixture evidence"' \
    '    push-conflict-tree, push, true, range, "sh scripts/check/check-no-conflict-tree-push.shs", "fixture"' \
    '    push-tree-size, push, true, range, "sh scripts/check/check-tree-size-push.shs", "fixture"' \
    '    push-conflict-markers, push, true, range, "sh scripts/check/check-no-conflict-markers-push.shs", "fixture"' \
    '    push-rules-quick, push, true, ref, "sh scripts/check/check-rules-sdl.shs --group quick --ref", "fixture"' \
    '    push-interpreter-module-owners, push, true, ref, "sh scripts/check/check-interpreter-module-owners.shs --ref", "fixture"' \
    > "$fixture/config/check/must_check_gates.sdn"
printf '%s\n' \
    'must_check_ledger:' \
    '  schema: "simple.must-check-ledger/v3"' \
    '  source_fingerprint: "unrecorded"' \
    'must_check_results |id, status, passed_at_utc, command, evidence, evidence_sha256, owner, unblock_condition|' \
    > "$fixture/doc/08_tracking/check/must_check_db.sdn"
mkdir -p "$fixture/build"
printf '    compiler-stage1, todo, never, "", "fixture bootstrap evidence pending", "never", "compiler-team", "run the fixture bootstrap producer"\n' >> "$fixture/doc/08_tracking/check/must_check_db.sdn"
printf '    fixture-manual-receipt, todo, never, "sh scripts/check/check-fixture-external-receipt.shs", "fixture manual evidence pending", "never", "release-team", "record fixture evidence"\n' >> "$fixture/doc/08_tracking/check/must_check_db.sdn"
export MUST_CHECK_SELFTEST=1
export MUST_CHECK_REQUIRED_IDS_FIXTURE='compiler-stage1
fixture-manual-receipt'
for phase in 1 2 3 4; do printf 'phase%s evidence\n' "$phase" > "$fixture/build/phase$phase.receipt"; done
cat > "$fixture/scripts/check/check-fixture-external-receipt.shs" <<'EOF'
#!/bin/sh
set -u
artifact=${MUST_CHECK_ARTIFACT_FILE:-}
[ -f "$artifact" ] || exit 1
[ "$(grep -c '^evidence_schema=FixtureManualEvidenceV1$' "$artifact")" -eq 1 ] || exit 1
[ "$(grep -c '^fixture_observation=real$' "$artifact")" -eq 1 ] || exit 1
echo 'STATUS: PASS fixture external receipt semantic evidence admitted'
EOF
printf '%s\n' '#!/bin/sh' \
    'printf "%s\n" compiler-stage1=pass compiler-stage2=pass compiler-stage3=pass compiler-stage4=pass' \
    "printf '%s\\n' compiler-stage1-evidence=$fixture/build/phase1.receipt compiler-stage2-evidence=$fixture/build/phase2.receipt compiler-stage3-evidence=$fixture/build/phase3.receipt compiler-stage4-evidence=$fixture/build/phase4.receipt" \
    > "$fixture/phase-validator"
chmod +x "$fixture/phase-validator" "$fixture/scripts/check/check-fixture-external-receipt.shs"
git -C "$fixture" init -q
cp "$fixture/scripts/check/pre-push-conflict-tree-guard.shs" "$fixture/.git/hooks/pre-push.local"
chmod +x "$fixture/.git/hooks/pre-push.local"
git -C "$fixture" config user.name must-check-test
git -C "$fixture" config user.email must-check-test@example.invalid
git -C "$fixture" add .
git -C "$fixture" commit -qm base
base=$(git -C "$fixture" rev-parse HEAD)
fixture_fp=$(git -C "$fixture" ls-tree -r HEAD -- src scripts config test rules.sdl doc/07_guide doc/00_llm_process doc/glossary.md | sha256sum | awk '{print $1}')
printf '%s\n' 'evidence_schema=FixtureManualEvidenceV1' 'fixture_observation=real' > "$fixture/build/manual.artifact"
manual_artifact_sha=$(sha256sum "$fixture/build/manual.artifact" | awk '{print $1}')
printf '%s\n' \
    'receipt_schema=simple.must-check-gate-receipt/v1' \
    'gate_id=fixture-manual-receipt' \
    'final_verdict=PASS' \
    "source_fingerprint=$fixture_fp" \
    'artifact_path=build/manual.artifact' \
    "artifact_sha256=$manual_artifact_sha" \
    > "$fixture/build/manual.receipt"
git -C "$fixture" add build/manual.artifact build/manual.receipt
git -C "$fixture" commit -qm bound-manual-receipt
base=$(git -C "$fixture" rev-parse HEAD)
printf '%s\n' 'unpromoted source change' > "$fixture/unpromoted-change"
git -C "$fixture" add unpromoted-change
git -C "$fixture" commit -qm unpromoted-source-change
unpromoted_tip=$(git -C "$fixture" rev-parse HEAD)

# Empty stdin is a legitimate no-op only when it traverses the canonical
# pre-push wrapper. Direct invocation remains fail-closed, so an accidental
# missing producer cannot masquerade as Git reporting zero updates.
if printf '' | MUST_CHECK_ROOT="$fixture" sh "$fixture/scripts/check/check-push-must-pass.shs" >/dev/null 2>&1; then
    echo "FAIL: direct empty input was accepted outside pre-push context"
    exit 1
fi
noop_verdict=$(cd "$fixture" && printf '' | MUST_CHECK_ROOT="$fixture" sh "$fixture/scripts/check/pre-push-conflict-tree-guard.shs" origin fixture)
[ "$noop_verdict" = "check-hook-installation: PASS — fixture
push-must-check: PASS — 0 refs to push (no-op)" ] || {
    echo "FAIL: canonical no-op push did not emit the explicit zero-ref verdict"
    exit 1
}
if (cd "$fixture" && printf 'malformed\n' | MUST_CHECK_ROOT="$fixture" sh "$fixture/scripts/check/pre-push-conflict-tree-guard.shs" origin fixture >/dev/null 2>&1); then
    echo "FAIL: malformed pre-push input was accepted as a no-op"
    exit 1
fi

printf 'refs/heads/main %s refs/heads/main %s\n' "$unpromoted_tip" "$base" |
    MUST_CHECK_ROOT="$fixture" sh "$fixture/scripts/check/check-push-must-pass.shs" >/dev/null
base=$unpromoted_tip
MUST_CHECK_ROOT="$fixture" \
MUST_CHECK_MANIFEST="$fixture/config/check/must_check_gates.sdn" \
MUST_CHECK_LEDGER="$fixture/doc/08_tracking/check/must_check_db.sdn" \
MUST_CHECK_EVIDENCE_DIR="$fixture/build/must-check-evidence" \
MUST_CHECK_PHASE_VALIDATOR="$fixture/phase-validator" \
MUST_CHECK_SELFTEST=1 MUST_CHECK_NOW=2000-01-01T00:00:00Z \
    sh "$BOOTSTRAP" --record-bootstrap-success >/dev/null
grep -q 'compiler-stage1, pass, 2000-01-01T00:00:00Z' "$fixture/doc/08_tracking/check/must_check_db.sdn"
grep -q '"compiler-team", "none"' "$fixture/doc/08_tracking/check/must_check_db.sdn"
grep -q 'completed_at_utc: "never"' "$fixture/doc/08_tracking/check/must_check_db.sdn"

# Arbitrary committed text and a schema-correct receipt for another gate are
# not promotion authority, even when their files are regular HEAD blobs.
printf '%s\n' 'STATUS: PASS arbitrary text' > "$fixture/build/arbitrary.txt"
sed 's/gate_id=fixture-manual-receipt/gate_id=other-gate/' \
    "$fixture/build/manual.receipt" > "$fixture/build/wrong-gate.receipt"
printf '%s\n' 'evidence_schema=FixtureManualEvidenceV1' 'fixture_observation=fabricated' > "$fixture/build/semantic-bad.artifact"
semantic_bad_sha=$(sha256sum "$fixture/build/semantic-bad.artifact" | awk '{print $1}')
sed "s|artifact_path=build/manual.artifact|artifact_path=build/semantic-bad.artifact|; s|artifact_sha256=.*|artifact_sha256=$semantic_bad_sha|" \
    "$fixture/build/manual.receipt" > "$fixture/build/semantic-bad.receipt"
git -C "$fixture" add build/arbitrary.txt build/wrong-gate.receipt build/semantic-bad.artifact build/semantic-bad.receipt
git -C "$fixture" commit -qm rejected-manual-evidence-fixtures
for rejected_receipt in build/arbitrary.txt build/wrong-gate.receipt build/semantic-bad.receipt; do
    MUST_CHECK_ROOT="$fixture" \
    MUST_CHECK_MANIFEST="$fixture/config/check/must_check_gates.sdn" \
    MUST_CHECK_LEDGER="$fixture/doc/08_tracking/check/must_check_db.sdn" \
    MUST_CHECK_SELFTEST=1 MUST_CHECK_NOW=2000-01-02T00:00:00Z \
        sh "$BOOTSTRAP" --record-gate-pass fixture-manual-receipt \
            --evidence "$rejected_receipt" >/dev/null 2>&1 && {
                echo "FAIL: malformed or mismatched receipt promoted TODO: $rejected_receipt"
                exit 1
            }
done

# A receipt-backed TODO becomes PASS only through the explicit recording
# interface. Re-recording unchanged evidence must carry the original PASS
# forward instead of resetting the row or inventing a new evidence binding.
MUST_CHECK_ROOT="$fixture" \
MUST_CHECK_MANIFEST="$fixture/config/check/must_check_gates.sdn" \
MUST_CHECK_LEDGER="$fixture/doc/08_tracking/check/must_check_db.sdn" \
MUST_CHECK_EVIDENCE_DIR="$fixture/build/must-check-evidence" \
MUST_CHECK_SELFTEST=1 MUST_CHECK_NOW=2000-01-02T00:00:00Z \
    sh "$BOOTSTRAP" --record-gate-pass fixture-manual-receipt \
        --evidence build/manual.receipt >/dev/null
grep -q 'fixture-manual-receipt, pass, 2000-01-02T00:00:00Z' "$fixture/doc/08_tracking/check/must_check_db.sdn"
grep -q 'completed_at_utc: "2000-01-02T00:00:00Z"' "$fixture/doc/08_tracking/check/must_check_db.sdn"
manual_pass_row=$(grep '^[[:space:]]*fixture-manual-receipt,' "$fixture/doc/08_tracking/check/must_check_db.sdn")
MUST_CHECK_ROOT="$fixture" \
MUST_CHECK_MANIFEST="$fixture/config/check/must_check_gates.sdn" \
MUST_CHECK_LEDGER="$fixture/doc/08_tracking/check/must_check_db.sdn" \
MUST_CHECK_EVIDENCE_DIR="$fixture/build/must-check-evidence" \
MUST_CHECK_SELFTEST=1 MUST_CHECK_NOW=2000-01-03T00:00:00Z \
    sh "$BOOTSTRAP" --record-gate-pass fixture-manual-receipt \
        --evidence build/manual.receipt >/dev/null
[ "$(grep '^[[:space:]]*fixture-manual-receipt,' "$fixture/doc/08_tracking/check/must_check_db.sdn")" = "$manual_pass_row" ] || {
    echo "FAIL: unchanged committed receipt PASS was not carried forward"
    exit 1
}
grep -q 'completed_at_utc: "2000-01-02T00:00:00Z"' "$fixture/doc/08_tracking/check/must_check_db.sdn" || {
    echo "FAIL: unchanged receipt invented a later completion time"
    exit 1
}
git -C "$fixture" add doc/08_tracking/check/must_check_db.sdn build/must-check-evidence
git -C "$fixture" commit -qm bootstrap-ledger
tip=$(git -C "$fixture" rev-parse HEAD)

cp "$fixture/doc/08_tracking/check/must_check_db.sdn" "$fixture/promoted-ledger.saved"
sed 's/source_fingerprint: "[0-9a-f]*"/source_fingerprint: "unrecorded"/; s/completed_at_utc: "[^"]*"/completed_at_utc: "never"/; s/, pass, [^,]*,/, todo, never,/; s/, "none"$/, "produce fresh bootstrap-owned evidence for this gate"/' \
    "$fixture/promoted-ledger.saved" > "$fixture/doc/08_tracking/check/must_check_db.sdn"
git -C "$fixture" add doc/08_tracking/check/must_check_db.sdn
git -C "$fixture" commit -qm attempted-ledger-downgrade
downgrade_tip=$(git -C "$fixture" rev-parse HEAD)
printf 'refs/heads/main %s refs/heads/main %s\n' "$downgrade_tip" "$tip" |
    MUST_CHECK_ROOT="$fixture" sh "$fixture/scripts/check/check-push-must-pass.shs" >/dev/null 2>&1 && {
        echo "FAIL: promoted ledger was allowed to downgrade to unrecorded"
        exit 1
    }
mv "$fixture/promoted-ledger.saved" "$fixture/doc/08_tracking/check/must_check_db.sdn"
git -C "$fixture" add doc/08_tracking/check/must_check_db.sdn
git -C "$fixture" commit -qm restore-promoted-ledger
tip=$(git -C "$fixture" rev-parse HEAD)
start=$(date +%s)
printf 'refs/heads/main %s refs/heads/main %s\n' "$tip" "$base" | MUST_CHECK_ROOT="$fixture" sh "$fixture/scripts/check/check-push-must-pass.shs" >/dev/null
ref_elapsed=$(($(date +%s) - start))
[ "$ref_elapsed" -le 10 ] || { echo "FAIL: push must-check ref path took ${ref_elapsed}s"; exit 1; }

# The pushed commit is authoritative. A dirty or absent live-worktree copy must
# not replace the exact evidence blob retained in that pushed commit.
cp "$fixture/build/manual.receipt" "$fixture/build/manual.receipt.saved"
printf '%s\n' 'live worktree evidence mismatch' > "$fixture/build/manual.receipt"
printf 'refs/heads/main %s refs/heads/main %s\n' "$tip" "$base" |
    MUST_CHECK_ROOT="$fixture" sh "$fixture/scripts/check/check-push-must-pass.shs" >/dev/null 2>&1 || {
        echo "FAIL: exact pushed-ref evidence was replaced by mismatched live bytes"
        exit 1
    }
rm -f "$fixture/build/manual.receipt"
printf 'refs/heads/main %s refs/heads/main %s\n' "$tip" "$base" |
    MUST_CHECK_ROOT="$fixture" sh "$fixture/scripts/check/check-push-must-pass.shs" >/dev/null 2>&1 || {
        echo "FAIL: exact pushed-ref evidence depended on a live worktree file"
        exit 1
    }
mv "$fixture/build/manual.receipt.saved" "$fixture/build/manual.receipt"

# Removing the blob from the revision itself must fail even if the ledger row
# and a separately restored live file would otherwise look valid.
git -C "$fixture" rm -q build/manual.receipt
git -C "$fixture" commit -qm remove-receipt-from-ref
missing_evidence_tip=$(git -C "$fixture" rev-parse HEAD)
printf 'refs/heads/main %s refs/heads/main %s\n' "$missing_evidence_tip" "$tip" |
    MUST_CHECK_ROOT="$fixture" sh "$fixture/scripts/check/check-push-must-pass.shs" >/dev/null 2>&1 && {
        echo "FAIL: pushed revision without its evidence blob was accepted"
        exit 1
    }

rm -f "$fixture/tree-guard-invocations"
two_ref_start=$(date +%s)
printf 'refs/heads/main %s refs/heads/main %s\nrefs/tags/same %s refs/tags/same %s\n' \
    "$tip" "$base" "$tip" "$base" |
    MUST_CHECK_ROOT="$fixture" sh "$fixture/scripts/check/check-push-must-pass.shs" >/dev/null
two_ref_elapsed=$(($(date +%s) - two_ref_start))
[ "$two_ref_elapsed" -le 10 ] || { echo "FAIL: two-ref push path took ${two_ref_elapsed}s"; exit 1; }
[ "$(wc -l < "$fixture/tree-guard-invocations" | tr -d ' ')" -eq 1 ] || {
    echo "FAIL: duplicate ref update reran the tree gate"
    exit 1
}
printf 'refs/heads/a %s refs/heads/a %s\nrefs/heads/b %s refs/heads/b %s\nrefs/heads/c %s refs/heads/c %s\n' \
    "$tip" "$base" "$tip" "$tip" "$tip" "$ZERO" 2>/dev/null |
    MUST_CHECK_ROOT="$fixture" sh "$fixture/scripts/check/check-push-must-pass.shs" >/dev/null 2>&1 && {
        echo "FAIL: more than two unique ref updates were accepted"
        exit 1
    }

start=$(date +%s)
(cd "$fixture" && printf 'refs/heads/main %s refs/heads/main %s\n' "$tip" "$base" | sh scripts/hooks/pre-push-worktree-launcher origin fixture >/dev/null)
hook_elapsed=$(($(date +%s) - start))
[ "$hook_elapsed" -le 10 ] || { echo "FAIL: installed push hook path took ${hook_elapsed}s"; exit 1; }

echo "PASS: must-check tiering contract selftest=${elapsed}s ref-path=${ref_elapsed}s two-ref=${two_ref_elapsed}s installed-hook=${hook_elapsed}s"
