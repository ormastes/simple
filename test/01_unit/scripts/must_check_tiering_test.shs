#!/bin/sh
set -eu

ROOT=$(cd "$(dirname "$0")/../../.." && pwd)
PUSH="$ROOT/scripts/check/check-push-must-pass.shs"
BOOTSTRAP="$ROOT/scripts/check/check-bootstrap-must-pass.shs"
HOOK="$ROOT/scripts/check/pre-push-conflict-tree-guard.shs"
INSTALL_UNIX="$ROOT/scripts/setup/install-must-check-hooks.shs"
INSTALL_WINDOWS="$ROOT/scripts/setup/install-must-check-hooks.ps1"

start=$(date +%s)
sh "$PUSH" --self-test >/dev/null
elapsed=$(($(date +%s) - start))
[ "$elapsed" -le 10 ] || { echo "FAIL: push must-check selftest took ${elapsed}s"; exit 1; }

sh "$BOOTSTRAP" --self-test >/dev/null
grep -q 'exec sh "$repo_root/scripts/check/check-push-must-pass.shs"' "$HOOK"
grep -q 'check-bootstrap-stage3-selfverify.shs' "$BOOTSTRAP"
grep -q 'check-post-bootstrap-stage4-sspec.shs' "$BOOTSTRAP"
grep -q 'pre-push.local' "$ROOT/scripts/hooks/pre-push"
grep -q 'cmp -s "$LOCAL_HOOK" "$CANONICAL_GUARD"' "$ROOT/scripts/hooks/pre-push"
grep -q -- '--install' "$INSTALL_UNIX"
grep -q 'Move-Item' "$INSTALL_WINDOWS"

fixture=$(mktemp -d)
trap 'rm -rf "$fixture" "$fixture-hook-repo" "$fixture-hook-peer"' EXIT INT TERM

# Linked worktrees share one hooks directory. Installing from one worktree must
# not bind that shared hook to the installer's absolute checkout path, because
# the sibling worktree's wiring verifier would then reject every normal push.
hook_repo="$fixture-hook-repo"
hook_peer="$fixture-hook-peer"
mkdir -p "$hook_repo/scripts/setup" "$hook_repo/scripts/hooks" "$hook_repo/scripts/check"
cp "$INSTALL_UNIX" "$hook_repo/scripts/setup/install-must-check-hooks.shs"
cp "$ROOT/scripts/hooks/pre-push" "$hook_repo/scripts/hooks/pre-push"
cp "$ROOT/scripts/hooks/pre-push-worktree-launcher" "$hook_repo/scripts/hooks/pre-push-worktree-launcher"
cp "$ROOT/scripts/check/check-hook-installation.shs" "$hook_repo/scripts/check/check-hook-installation.shs"
cp "$ROOT/scripts/check/pre-push-conflict-tree-guard.shs" "$hook_repo/scripts/check/pre-push-conflict-tree-guard.shs"
cp "$PUSH" "$hook_repo/scripts/check/check-push-must-pass.shs"
for guard in check-tree-size-push check-no-conflict-tree-push check-no-conflict-markers-push check-no-revert-push; do
    printf '%s\n' '#!/bin/sh' 'exit 0' > "$hook_repo/scripts/check/$guard.shs"
done
chmod +x "$hook_repo/scripts/hooks/pre-push" "$hook_repo/scripts/check/"*.shs
git -C "$hook_repo" init -q
git -C "$hook_repo" config user.name must-check-test
git -C "$hook_repo" config user.email must-check-test@example.invalid
git -C "$hook_repo" add .
git -C "$hook_repo" commit -qm hook-base
git -C "$hook_repo" worktree add -q "$hook_peer" HEAD
sh "$hook_repo/scripts/setup/install-must-check-hooks.shs" --install >/dev/null
(cd "$hook_peer" && sh scripts/setup/install-must-check-hooks.shs --check >/dev/null)
(cd "$hook_peer" && sh scripts/check/check-hook-installation.shs)
shared_hooks=$(git -C "$hook_repo" rev-parse --git-path hooks)
case "$shared_hooks" in /*) : ;; *) shared_hooks="$hook_repo/$shared_hooks" ;; esac
[ ! -L "$shared_hooks/pre-push" ]
cmp -s "$hook_repo/scripts/hooks/pre-push-worktree-launcher" "$shared_hooks/pre-push"

# A legacy canonical dispatcher is replacement material, not a local hook: if
# preserved it would call the dispatcher from inside itself forever.
rm -f "$shared_hooks/pre-push.local"
cp "$hook_repo/scripts/hooks/pre-push" "$shared_hooks/pre-push"
(cd "$hook_peer" && sh scripts/setup/install-must-check-hooks.shs --install >/dev/null)
[ ! -e "$shared_hooks/pre-push.local" ]
cmp -s "$hook_peer/scripts/hooks/pre-push-worktree-launcher" "$shared_hooks/pre-push"

# A genuinely unrelated hook is still preserved and chained.
printf '%s\n' '#!/bin/sh' 'echo unrelated-local-hook' > "$shared_hooks/pre-push"
chmod +x "$shared_hooks/pre-push"
sh "$hook_repo/scripts/setup/install-must-check-hooks.shs" --install >/dev/null
grep -q 'unrelated-local-hook' "$shared_hooks/pre-push.local"
cmp -s "$hook_repo/scripts/hooks/pre-push-worktree-launcher" "$shared_hooks/pre-push"

if grep -E 'native-build|qemu|benchmark|--whole' "$PUSH" >/dev/null; then
    echo "FAIL: push-tier driver directly names an expensive execution lane"
    exit 1
fi

# Exercise the real pre-push ref-input path in an isolated committed fixture.
mkdir -p "$fixture/scripts/check" "$fixture/scripts/hooks" "$fixture/config/check" "$fixture/doc/08_tracking/check"
cp "$PUSH" "$fixture/scripts/check/check-push-must-pass.shs"
cp "$HOOK" "$fixture/scripts/check/pre-push-conflict-tree-guard.shs"
cp "$ROOT/scripts/hooks/pre-push" "$fixture/scripts/hooks/pre-push"
printf '%s\n' '#!/bin/sh' 'echo "check-hook-installation: PASS — fixture"' > "$fixture/scripts/check/check-hook-installation.shs"
chmod +x "$fixture/scripts/check/check-hook-installation.shs" "$fixture/scripts/hooks/pre-push"
for guard in check-no-conflict-tree-push check-tree-size-push check-no-conflict-markers-push check-rules-sdl check-interpreter-module-owners; do
    printf '%s\n' '#!/bin/sh' 'echo "PASS — fixture guard"' > "$fixture/scripts/check/$guard.shs"
    chmod +x "$fixture/scripts/check/$guard.shs"
done
printf '%s\n' \
    'must_check_gates |id, tier, push_blocking, mode, command, description|' \
    '    compiler-stage1, bootstrap, true, receipt, "", "fixture"' \
    '    push-conflict-tree, push, true, range, "sh scripts/check/check-no-conflict-tree-push.shs", "fixture"' \
    '    push-tree-size, push, true, range, "sh scripts/check/check-tree-size-push.shs", "fixture"' \
    '    push-conflict-markers, push, true, range, "sh scripts/check/check-no-conflict-markers-push.shs", "fixture"' \
    '    push-rules-quick, push, true, ref, "sh scripts/check/check-rules-sdl.shs --group quick --ref", "fixture"' \
    '    push-interpreter-module-owners, push, true, ref, "sh scripts/check/check-interpreter-module-owners.shs --ref", "fixture"' \
    > "$fixture/config/check/must_check_gates.sdn"
printf '%s\n' \
    'must_check_ledger:' \
    '  schema: "simple.must-check-ledger/v3"' \
    '  source_fingerprint: "pending"' \
    'must_check_results |id, status, passed_at_utc, command, evidence, evidence_sha256, owner, unblock_condition|' \
    > "$fixture/doc/08_tracking/check/must_check_db.sdn"
mkdir -p "$fixture/build"
printf '    compiler-stage1, todo, never, "", "fixture bootstrap evidence pending", "never", "compiler-team", "run the fixture bootstrap producer"\n' >> "$fixture/doc/08_tracking/check/must_check_db.sdn"
for phase in 1 2 3 4; do printf 'phase%s evidence\n' "$phase" > "$fixture/build/phase$phase.receipt"; done
printf '%s\n' '#!/bin/sh' \
    'printf "%s\n" compiler-stage1=pass compiler-stage2=pass compiler-stage3=pass compiler-stage4=pass' \
    "printf '%s\\n' compiler-stage1-evidence=$fixture/build/phase1.receipt compiler-stage2-evidence=$fixture/build/phase2.receipt compiler-stage3-evidence=$fixture/build/phase3.receipt compiler-stage4-evidence=$fixture/build/phase4.receipt" \
    > "$fixture/phase-validator"
chmod +x "$fixture/phase-validator"
git -C "$fixture" init -q
cp "$fixture/scripts/check/pre-push-conflict-tree-guard.shs" "$fixture/.git/hooks/pre-push.local"
chmod +x "$fixture/.git/hooks/pre-push.local"
git -C "$fixture" config user.name must-check-test
git -C "$fixture" config user.email must-check-test@example.invalid
git -C "$fixture" add .
git -C "$fixture" commit -qm base
base=$(git -C "$fixture" rev-parse HEAD)
MUST_CHECK_ROOT="$fixture" \
MUST_CHECK_MANIFEST="$fixture/config/check/must_check_gates.sdn" \
MUST_CHECK_LEDGER="$fixture/doc/08_tracking/check/must_check_db.sdn" \
MUST_CHECK_EVIDENCE_DIR="$fixture/build/must-check-evidence" \
MUST_CHECK_PHASE_VALIDATOR="$fixture/phase-validator" \
MUST_CHECK_SELFTEST=1 MUST_CHECK_NOW=2000-01-01T00:00:00Z \
    sh "$BOOTSTRAP" --record-bootstrap-success >/dev/null
grep -q 'compiler-stage1, pass, 2000-01-01T00:00:00Z' "$fixture/doc/08_tracking/check/must_check_db.sdn"
grep -q '"compiler-team", "none"' "$fixture/doc/08_tracking/check/must_check_db.sdn"
git -C "$fixture" add doc/08_tracking/check/must_check_db.sdn
git -C "$fixture" commit -qm bootstrap-ledger
tip=$(git -C "$fixture" rev-parse HEAD)
start=$(date +%s)
printf 'refs/heads/main %s refs/heads/main %s\n' "$tip" "$base" | MUST_CHECK_ROOT="$fixture" sh "$fixture/scripts/check/check-push-must-pass.shs" >/dev/null
ref_elapsed=$(($(date +%s) - start))
[ "$ref_elapsed" -le 10 ] || { echo "FAIL: push must-check ref path took ${ref_elapsed}s"; exit 1; }

start=$(date +%s)
(cd "$fixture" && printf 'refs/heads/main %s refs/heads/main %s\n' "$tip" "$base" | sh scripts/hooks/pre-push origin fixture >/dev/null)
hook_elapsed=$(($(date +%s) - start))
[ "$hook_elapsed" -le 10 ] || { echo "FAIL: installed push hook path took ${hook_elapsed}s"; exit 1; }

echo "PASS: must-check tiering contract selftest=${elapsed}s ref-path=${ref_elapsed}s installed-hook=${hook_elapsed}s"
