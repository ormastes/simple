"""
# Caret Launcher Entry Override Prevention Spec

Prevention coverage for `caret_launcher_ignores_caret_entry_2026-11-14`:
verifies `bin/caret` and `bin/cs` dispatch to the default entrypoint,
`cs_main.spl`, relative paths, and absolute paths under `src/app/llm_caret/`
in source-fallback mode (`SIMPLE_CARET_ALLOW_SOURCE_FALLBACK=1`).
"""

use std.spec.*
use app.io.process_ops.{process_run}

describe "bin/caret CARET_ENTRY selection":
    """Verifies positive entrypoint resolution and bin/cs wiring."""

    it "passes the repository caret entry suite without regression":
        val res = process_run("sh", ["-c",
            "out=$(sh test/00_unit/scripts/caret_launcher_entry_spec.shs 2>&1); rc=$?; echo \"RC=$rc\"; printf '%s' \"$out\""])
        val stdout_text: text = res.0
        expect(stdout_text).to_contain("RC=0")
        expect(stdout_text).to_contain("PASS")

    it "honors relative and absolute CARET_ENTRY values and bin/cs override":
        val script =
            "set -u; " +
            "REPO=$(pwd); " +
            "T=$(mktemp -d); trap 'rm -rf \"$T\"' EXIT; " +
            "printf '#!/bin/sh\\necho RAN $*\\n' > \"$T/stub_simple\"; " +
            "chmod +x \"$T/stub_simple\"; " +
            "def=$(SIMPLE_CARET_ALLOW_SOURCE_FALLBACK=1 SIMPLE_BINARY=\"$T/stub_simple\" sh bin/caret); " +
            "rel=$(CARET_ENTRY=src/app/llm_caret/cs_main.spl SIMPLE_CARET_ALLOW_SOURCE_FALLBACK=1 SIMPLE_BINARY=\"$T/stub_simple\" sh bin/caret); " +
            "abs=$(CARET_ENTRY=\"$REPO/src/app/llm_caret/cs_main.spl\" SIMPLE_CARET_ALLOW_SOURCE_FALLBACK=1 SIMPLE_BINARY=\"$T/stub_simple\" sh bin/caret); " +
            "cs=$(SIMPLE_CARET_ALLOW_SOURCE_FALLBACK=1 SIMPLE_BINARY=\"$T/stub_simple\" sh bin/cs); " +
            "printf 'DEF=%s\\nREL=%s\\nABS=%s\\nCS=%s\\n' \"$def\" \"$rel\" \"$abs\" \"$cs\""
        val res = process_run("sh", ["-c", script])
        val out: text = res.0
        expect(out).to_contain("DEF=RAN run ")
        expect(out).to_contain("/src/app/llm_caret/main.spl")
        expect(out).to_contain("REL=RAN run ")
        expect(out).to_contain("/src/app/llm_caret/cs_main.spl")
        expect(out).to_contain("ABS=RAN run ")
        expect(out).to_contain("CS=RAN run ")
