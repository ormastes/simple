#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$root/scripts/check/lib/simpleos-admitted-runtime.shs"
SIMPLEOS_ADMITTED_RUNTIME_ROOT=$root
export SIMPLEOS_ADMITTED_RUNTIME_ROOT
BOOTSTRAP_STAGE3_FACADE_PATH=$root/scripts/check/lib/bootstrap-stage3-provenance.shs
export BOOTSTRAP_STAGE3_FACADE_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"

work=$(mktemp -d "${TMPDIR:-/tmp}/simpleos-admitted-runtime-test.XXXXXX")
trap 'chmod -R u+w "$work" 2>/dev/null || true; rm -rf "$work"' 0 HUP INT TERM
canonical_version=$(bootstrap_stage3_canonical_version "$root") || {
    echo "FAIL: canonical release version authority is invalid" >&2
    exit 1
}
stage=$work/stage3/test-triple
mkdir -p "$stage/stage2-admitted"

cat >"$work/runtime_mock.c" <<'EOF'
#include <stdio.h>
#include <string.h>
int main(int argc, char **argv) {
    int stale = strstr(argv[0], "stale") != NULL;
    if (stale) return 139;
    for (int i = 1; i < argc; ++i) {
        if (strcmp(argv[i], "native-build") == 0) {
            fputs("Build failed: failed to read intentional-missing.spl: No such file\n", stdout);
            return 1;
        }
    }
    return 2;
}
EOF
cc "$work/runtime_mock.c" -o "$stage/stage2-admitted/simple"
mkdir -p "$work/stale-stage/stage2-admitted" "$work/script-stage/stage2-admitted"
cc "$work/runtime_mock.c" -o "$work/stale-stage/stage2-admitted/simple"

make_admission() {
    candidate=$1
    stem=$2
    row_hash=${3:-}
    second_row_hash=${4:-}
    # Admission verification derives every authority from the candidate's
    # owned stage directory; receipt paths are display metadata only.
    evidence=$(dirname -- "$(dirname -- "$candidate")")
    mkdir -p "$evidence"
    runtime_authority=$evidence/stage2-runtime-authority
    if [ -d "$runtime_authority" ]; then
        chmod -R u+w "$runtime_authority"
        rm -rf -- "$runtime_authority"
    fi
    mkdir -p "$runtime_authority/deps"
    printf 'hosted runtime\n' \
        >"$runtime_authority/deps/libspl_hosted_runtime-fixture.rlib"
    hosted_sha=$(sha256sum -- \
        "$runtime_authority/deps/libspl_hosted_runtime-fixture.rlib" |
        awk '{print $1}')
    cat >"$runtime_authority/hosted-runtime.env" <<HOSTED
schema=simple-bootstrap-hosted-runtime-authority-v1
status=frozen
relative_path=deps/libspl_hosted_runtime-fixture.rlib
sha256=$hosted_sha
HOSTED
    chmod 400 "$runtime_authority/deps/libspl_hosted_runtime-fixture.rlib" \
        "$runtime_authority/hosted-runtime.env"
    chmod 500 "$runtime_authority/deps" "$runtime_authority"
    sanity=$evidence/stage2-sanity.env
    receiver=$evidence/stage2-receiver.env
    receiver_log=$evidence/stage2-receiver.log
    runtime=$evidence/runtime-admitted.txt
    source=$evidence/source-inputs-before.txt
    tool=$evidence/tool-authority-before.txt
    admission=$(dirname -- "$candidate")/admission.env
    candidate_hash=$(sha256sum -- "$candidate" | awk '{print $1}')
    [ -n "$row_hash" ] || row_hash=$candidate_hash
    empty_hash=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
    printf 'source-snapshot\n' >"$source"
    printf 'tool-authority\n' >"$tool"
    printf 'file-hex:73696d706c65:1:%s\n' "$row_hash" >"$runtime"
    if [ -n "$second_row_hash" ]; then
        printf 'file-hex:73696d706c65:1:%s\n' "$second_row_hash" >>"$runtime"
    fi
    printf 'receiver-probe-pass\n' >"$receiver_log"
    runtime_hash=$(sha256sum -- "$runtime" | awk '{print $1}')
    receiver_log_hash=$(sha256sum -- "$receiver_log" | awk '{print $1}')
    : >"$sanity.frontend-driver.log"
    for sanity_mode in 0 1; do
        mode_log="$sanity.frontend-bootstrap-$sanity_mode.log"
        for probe in p2_add stage2_mir_retention stage2_module_path_naming \
            hello_world_positional; do
            case "$probe" in p2_add) probe_log=$mode_log ;; *) probe_log=$mode_log.$(printf '%s' "$probe" | tr _ -) ;; esac
            printf 'probe=%s\n' "$probe" >"$probe_log"
            probe_sha=$(sha256sum -- "$probe_log" | awk '{print $1}')
            printf '%s\n' schema=simple-bounded-process-log-v1 status=complete \
                reason=child-exit raw_status=0 max_bytes=4194304 \
                "bytes_captured=$(wc -c <"$probe_log" | tr -d ' ')" \
                timeout_seconds=180 term_grace_seconds=1 \
                combined_stream=stdout-stderr process_group=setsid \
                artifact_limit=none "log_leaf=${probe_log##*/}" \
                "log_sha256=$probe_sha" >"$probe_log.bounded.env"
        done
        cat >"$sanity.frontend-bootstrap-$sanity_mode.status.env" <<STATUS
schema=simple-candidate-frontend-status-v2
result=pass
probe=complete
raw_status=0
bootstrap_mode=$sanity_mode
backend=llvm
log_path=$mode_log
p2_add_raw_status=0
p2_add_log_path=$mode_log
p2_add_log_sha256=$(sha256sum -- "$mode_log" | awk '{print $1}')
p2_add_collector_receipt_path=$mode_log.bounded.env
p2_add_collector_receipt_sha256=$(sha256sum -- "$mode_log.bounded.env" | awk '{print $1}')
stage2_mir_retention_raw_status=0
stage2_mir_retention_log_path=$mode_log.stage2-mir-retention
stage2_mir_retention_log_sha256=$(sha256sum -- "$mode_log.stage2-mir-retention" | awk '{print $1}')
stage2_mir_retention_collector_receipt_path=$mode_log.stage2-mir-retention.bounded.env
stage2_mir_retention_collector_receipt_sha256=$(sha256sum -- "$mode_log.stage2-mir-retention.bounded.env" | awk '{print $1}')
stage2_module_path_naming_raw_status=0
stage2_module_path_naming_log_path=$mode_log.stage2-module-path-naming
stage2_module_path_naming_log_sha256=$(sha256sum -- "$mode_log.stage2-module-path-naming" | awk '{print $1}')
stage2_module_path_naming_collector_receipt_path=$mode_log.stage2-module-path-naming.bounded.env
stage2_module_path_naming_collector_receipt_sha256=$(sha256sum -- "$mode_log.stage2-module-path-naming.bounded.env" | awk '{print $1}')
hello_world_positional_raw_status=0
hello_world_positional_log_path=$mode_log.hello-world-positional
hello_world_positional_log_sha256=$(sha256sum -- "$mode_log.hello-world-positional" | awk '{print $1}')
hello_world_positional_collector_receipt_path=$mode_log.hello-world-positional.bounded.env
hello_world_positional_collector_receipt_sha256=$(sha256sum -- "$mode_log.hello-world-positional.bounded.env" | awk '{print $1}')
STATUS
    done
    cat >"$sanity" <<EOF
schema=simple-bootstrap-sanity-evidence-v1
status=pass
candidate_sha256_before=$candidate_hash
version_status=0
version_output=simple-bootstrap $canonical_version
unsupported_status=1
unsupported_output_sha256=$empty_hash
frontend_smoke_status=0
frontend_smoke_backend=llvm
frontend_smoke_bootstrap_mode_status=0
frontend_smoke_bootstrap0_raw_status=0
frontend_smoke_bootstrap0_log_path=$sanity.frontend-bootstrap-0.log
frontend_smoke_bootstrap0_log_sha256=$(sha256sum -- "$sanity.frontend-bootstrap-0.log" | awk '{print $1}')
frontend_smoke_bootstrap0_status_path=$sanity.frontend-bootstrap-0.status.env
frontend_smoke_bootstrap0_status_sha256=$(sha256sum -- "$sanity.frontend-bootstrap-0.status.env" | awk '{print $1}')
frontend_smoke_bootstrap1_ran=true
frontend_smoke_bootstrap1_raw_status=0
frontend_smoke_bootstrap1_log_path=$sanity.frontend-bootstrap-1.log
frontend_smoke_bootstrap1_log_sha256=$(sha256sum -- "$sanity.frontend-bootstrap-1.log" | awk '{print $1}')
frontend_smoke_bootstrap1_status_path=$sanity.frontend-bootstrap-1.status.env
frontend_smoke_bootstrap1_status_sha256=$(sha256sum -- "$sanity.frontend-bootstrap-1.status.env" | awk '{print $1}')
frontend_smoke_output_sha256=$empty_hash
frontend_smoke_driver_log_path=$sanity.frontend-driver.log
frontend_smoke_driver_log_sha256=$empty_hash
candidate_sha256_after=$candidate_hash
EOF
    cat >"$receiver" <<EOF
schema=simple-bootstrap-stage2-receiver-evidence-v1
status=pass
probe_exit=0
candidate_sha256_before=$candidate_hash
candidate_sha256_after=$candidate_hash
runtime_snapshot_sha256=$runtime_hash
probe_log=$receiver_log
probe_log_sha256=$receiver_log_hash
EOF
    args_hash=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
    rm -f "$admission"
    bootstrap_stage3_write_stage2_admission_receipt "$admission" "$admission" \
        "$candidate" "$candidate" "$source" "$source" "$runtime" "$runtime" \
        "$(dirname -- "$runtime")/stage2-runtime-authority" "$(dirname -- "$runtime")/stage2-runtime-authority" \
        "$tool" "$tool" "$args_hash" "$sanity" "$sanity" \
        "$(dirname -- "$sanity")" "$receiver" "$receiver" \
        "$receiver_log" "$receiver_log" "$root"
    printf '%s\n' "$admission"
}

good=$stage/stage2-admitted/simple
good_admission=$(make_admission "$good" good)
SIMPLE_COMPILER_ADMISSION=$good_admission
export SIMPLE_COMPILER_ADMISSION
simpleos_admitted_runtime_verify_auto "$good" || {
    echo "FAIL: canonical admitted native fixture rejected"
    exit 1
}

stale=$work/stale-stage/stage2-admitted/simple
stale_admission=$(make_admission "$stale" stale)
if simpleos_admitted_runtime_verify "$stale" "$stale_admission"; then
    echo "FAIL: signal-139 native fixture admitted"
    exit 1
fi

script=$work/script-stage/stage2-admitted/simple
printf '#!/bin/sh\necho "Build failed: failed to read intentional-missing.spl"\nexit 1\n' >"$script"
chmod +x "$script"
script_admission=$(make_admission "$script" script)
if simpleos_admitted_runtime_verify "$script" "$script_admission"; then
    echo "FAIL: shell-script candidate admitted"
    exit 1
fi

replacement=$stage/stage2-admitted/replacement-simple
cp "$good" "$replacement"
printf '\000' >>"$replacement"
if simpleos_admitted_runtime_verify "$replacement" "$good_admission"; then
    echo "FAIL: candidate path/hash substitution admitted"
    exit 1
fi
runtime_path=$(bootstrap_stage3_manifest_value runtime_snapshot_path "$good_admission")
printf 'file-hex:756e72656c61746564:1:%s\n' \
    'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' \
    >"$runtime_path"
if simpleos_admitted_runtime_verify "$good" "$good_admission"; then
    echo "FAIL: unrelated runtime snapshot admitted"
    exit 1
fi

mkdir -p "$work/fresh-stage/stage2-admitted"
fresh=$work/fresh-stage/stage2-admitted/simple
cp "$good" "$fresh"
fresh_admission=$(make_admission "$fresh" fresh \
    bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)
simpleos_admitted_runtime_verify "$fresh" "$fresh_admission" || {
    echo "FAIL: fresh Stage2 rejected because its attested input seed differs from its output candidate"
    exit 1
}
fresh_admission=$(make_admission "$fresh" fresh-two-rows \
    bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb \
    cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc)
if simpleos_admitted_runtime_verify "$fresh" "$fresh_admission"; then
    echo "FAIL: ambiguous runtime snapshot with two executable seed rows admitted"
    exit 1
fi

grep -Fq 'simpleos_admitted_runtime_verify_auto "$SIMPLE_BIN_RESOLVED"' \
    "$root/scripts/check/lib/simpleos-wm-fullscreen/admission.shs"
grep -Fq 'simpleos_admitted_runtime_verify_auto "$SIMPLE_BIN"' \
    "$root/scripts/check/check-simpleos-x86-64-wm-hello-lifecycle-evidence.shs"
grep -Fq 'simpleos_admitted_runtime_verify_auto "$simple_bin"' \
    "$root/scripts/check/check-native-scalar-metadata-copy.shs"

echo "PASS: canonical SimpleOS runtime admission accepts fresh lineage and rejects malformed or stale candidates"
