#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
cat >"$tmp/systemctl" <<'EOF'
#!/bin/sh
echo offline
exit 1
EOF
chmod +x "$tmp/systemctl"
status=0
PATH="$tmp:/usr/bin:/bin" CAP_REQUIRE=1 \
    sh "$root/scripts/resource/run_capped.shs" sh -c 'exit 0' \
    >"$tmp/log" 2>&1 || status=$?
[ "$status" -eq 125 ]
grep -q 'required systemd cgroup memory cap is unavailable' "$tmp/log"
echo 'run_capped required-cap fail-closed contract: PASS'
