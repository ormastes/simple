#!/bin/sh
set -eu
ROOT=$(cd "$(dirname "$0")/../../.." && pwd -P)
CHECK=$ROOT/scripts/check/check-web-server-request-port-evidence.shs
PRODUCER=$ROOT/scripts/check/produce-web-server-request-port-evidence.shs
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT INT TERM
run=fixture-run
fp=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
printf 'GET /health HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n' >"$tmp/request"
printf 'HTTP/1.1 204 No Content\r\nContent-Length: 0\r\nConnection: close\r\n\r\n' >"$tmp/response"
printf '#!/bin/sh\nexit 0\n' >"$tmp/executable"; chmod 700 "$tmp/executable"
printf 'use std.nogc_sync_mut.io.tcp.{TcpListener}\n# fixture listener source\n' >"$tmp/source"
printf '%s\n' 'evidence_schema=simple.web-server-toolchain-identity/v1' "run_id=$run" 'toolchain_id=stage4-fixture' >"$tmp/toolchain"
printf '%s\n' 'evidence_schema=simple.web-server-target-identity/v1' "run_id=$run" 'host=fixture-host' 'os=Linux' 'arch=x86_64' >"$tmp/target"
sha() { sha256sum "$1" | awk '{print $1}'; }
req_hex=$(od -An -v -tx1 "$tmp/request" | tr -d ' \n'); resp_hex=$(od -An -v -tx1 "$tmp/response" | tr -d ' \n')
cat >"$tmp/lifecycle" <<EOF
evidence_schema=simple.web-server-request-port/v1
source_fingerprint=$fp
run_id=$run
bind_address=127.0.0.1
configured_port=18080
observed_listener_address=127.0.0.1:18080
server_pid=4242
listener_pid=4242
readiness_status=ready
request_sha256=$(sha "$tmp/request")
response_sha256=$(sha "$tmp/response")
executable_sha256=$(sha "$tmp/executable")
source_sha256=$(sha "$tmp/source")
toolchain_sha256=$(sha "$tmp/toolchain")
target_sha256=$(sha "$tmp/target")
started_at_unix_ms=1000
ready_at_unix_ms=1100
request_at_unix_ms=1200
response_at_unix_ms=1300
stopped_at_unix_ms=1400
stop_timeout_ms=5000
stop_status=exited
post_stop_listener_count=0
post_stop_process_count=0
expected_request_hex=$req_hex
expected_response_hex=$resp_hex
response_status=204
target_host=fixture-host
final_verdict=PASS
EOF
args="--fingerprint $fp --run-id $run --request $tmp/request --response $tmp/response --lifecycle $tmp/lifecycle --executable $tmp/executable --source $tmp/source --toolchain $tmp/toolchain --target $tmp/target"
sh "$CHECK" $args >/dev/null

reject_mutation() {
    cp "$tmp/$1" "$tmp/$1.good"
    sed "$2" "$tmp/$1.good" >"$tmp/$1"
    if sh "$CHECK" $args >/dev/null 2>&1; then echo "FAIL: accepted $3 mutation" >&2; exit 1; fi
    mv "$tmp/$1.good" "$tmp/$1"
}
reject_mutation lifecycle 's/listener_pid=4242/listener_pid=4243/' listener-owner
reject_mutation lifecycle 's/response_status=204/response_status=200/' response-status
reject_mutation lifecycle 's/post_stop_listener_count=0/post_stop_listener_count=1/' listener-leak
reject_mutation lifecycle 's/ready_at_unix_ms=1100/ready_at_unix_ms=1500/' timestamp-order
reject_mutation lifecycle 's/stop_timeout_ms=5000/stop_timeout_ms=60000/' unbounded-stop
reject_mutation source 's/TcpListener/FakeHandler/' retained-source
reject_mutation toolchain 's/stage4-fixture/other-toolchain/' retained-toolchain
printf 'X' >>"$tmp/request"
if sh "$CHECK" $args >/dev/null 2>&1; then echo 'FAIL: accepted changed request bytes' >&2; exit 1; fi

# Exercise the producer against a real kernel loopback listener. The fixture is
# deliberately a process-owned nc listener, not a direct handler invocation.
printf 'GET /live HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n' >"$tmp/live-request"
printf 'HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nOK' >"$tmp/live-response"
cat >"$tmp/live-server" <<'EOF'
#!/bin/sh
while [ "$#" -gt 0 ]; do case "$1" in --bind) bind=$2; shift 2;; --port) port=$2; shift 2;; *) exit 2;; esac; done
exec nc -l "$bind" "$port" <"$WEB_SERVER_FIXTURE_RESPONSE" >"$WEB_SERVER_RECEIVED_REQUEST_FILE"
EOF
chmod 700 "$tmp/live-server"
printf 'use std.nogc_sync_mut.io.tcp.{TcpListener}\n# live producer fixture source\n' >"$tmp/live-source.spl"
WEB_SERVER_EVIDENCE_DIR="$tmp/live" WEB_SERVER_EXECUTABLE="$tmp/live-server" \
WEB_SERVER_SOURCE="$tmp/live-source.spl" WEB_SERVER_TOOLCHAIN_ID=fixture-stage4 \
WEB_SERVER_PORT=18880 WEB_SERVER_REQUEST_FILE="$tmp/live-request" \
WEB_SERVER_EXPECTED_RESPONSE_FILE="$tmp/live-response" WEB_SERVER_FIXTURE_RESPONSE="$tmp/live-response" \
MUST_CHECK_FINGERPRINT="$fp" WEB_SERVER_RUN_ID=live-run sh "$PRODUCER" >/dev/null
sh "$CHECK" --fingerprint "$fp" --run-id live-run --request "$tmp/live/request.bin" \
    --response "$tmp/live/response.bin" --lifecycle "$tmp/live/lifecycle.env" \
    --executable "$tmp/live/server-executable" --source "$tmp/live/server-source.spl" \
    --toolchain "$tmp/live/toolchain.env" --target "$tmp/live/target.env" >/dev/null
echo 'web-server-request-port evidence test: PASS'
