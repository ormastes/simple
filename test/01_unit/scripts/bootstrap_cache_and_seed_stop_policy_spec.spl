# @cover scripts/bootstrap/bootstrap-cache-policy.shs 80%
# @cover scripts/bootstrap/bootstrap-seed-stop-policy.shs 80%
# @req REQ-P3-CACHE-SEED-POLICY-001
"""
## Purpose and audience
Exercises `scripts/bootstrap/bootstrap-cache-policy.shs` and
`scripts/bootstrap/bootstrap-seed-stop-policy.shs`:
- service-cache path composition (`stage1..4`, 64-hex digests, `mcp|lsp`)
- compile failure and strategy failure policy resolution (`--fail-fast` /
  `--keep-going`, `adhoc|normal|full`)
- bounded LRU cache eviction (`bootstrap_prune_lru_dirs`) keeping `current`,
  recent dirs, and dirs with live `.in-use.<pid>` markers while evicting old
  idle directories
- seed-stop policy (`--stop-after-seed` requires `--full-bootstrap` and rejects
  conflicting bootstrap options with exit `64`)

Audience: bootstrap cache and orchestration maintainers.

## Compatibility and limitations
Evaluates sourced POSIX shell library functions directly in isolated temp dirs
from `get_temp_dir()`.

## Examples
```sh
bin/simple test test/01_unit/scripts/bootstrap_cache_and_seed_stop_policy_spec.spl
```
"""

# @tag: unit, scripts, bootstrap, cache-policy, seed-policy

use std.spec.*
use std.spec.{step}
use app.io.mod.{dir_create_all, dir_remove_all, file_exists, getpid, time_now_unix_micros}
use std.nogc_sync_mut.env.platform.{get_temp_dir}
use std.nogc_sync_mut.io.process_ops.{process_run, resolve_shell_argv}

val CACHE_POLICY = "scripts/bootstrap/bootstrap-cache-policy.shs"
val SEED_STOP_POLICY = "scripts/bootstrap/bootstrap-seed-stop-policy.shs"
val HEX_64_A = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
val HEX_64_B = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

fn _bcp_make_root(tag: text) -> text:
    val base = get_temp_dir().replace("\\", "/")
    val root = base + "/p3-bcp-" + tag + "-" +
        getpid().to_text() + "-" + time_now_unix_micros().to_text()
    expect(dir_create_all(root)).to_be(true)
    root

fn _bcp_sh(cmd: text) -> (text, text, i64):
    val prefix = "case \"$(uname -s 2>/dev/null)\" in MINGW*|MSYS*|CYGWIN*) PATH=\"/usr/bin:/bin:$PATH\"; export PATH ;; esac; "
    val (sh_bin, sh_args) = resolve_shell_argv(prefix + cmd)
    process_run(sh_bin, sh_args)

describe "bootstrap-cache-policy.shs":
    it "enforces clean-release, service-cache digest validation, and failure policy":
        val (out, err, rc) = _bcp_sh(
            "set -eu; . ./" + CACHE_POLICY + "; " +
            "bootstrap_cache_force_clear_one_binary clean-release || exit 11; " +
            "! bootstrap_cache_force_clear_one_binary release || exit 12; " +
            "p=$(bootstrap_phase_service_cache /var/cache/simple stage3 " + HEX_64_A + " " + HEX_64_B + " mcp); " +
            "printf 'path=%s\\n' \"$p\"; " +
            "! bootstrap_phase_service_cache relative/path stage3 " + HEX_64_A + " " + HEX_64_B + " mcp || exit 13; " +
            "! bootstrap_phase_service_cache /var/cache stage5 " + HEX_64_A + " " + HEX_64_B + " mcp || exit 14; " +
            "! bootstrap_phase_service_cache /var/cache stage3 shorthex " + HEX_64_B + " mcp || exit 15; " +
            "! bootstrap_phase_service_cache /var/cache stage3 " + HEX_64_A + " " + HEX_64_B + " cli || exit 16; " +
            "SIMPLE_COMPILE_FAIL_FAST=1 bootstrap_compile_failure_policy --keep-going; " +
            "printf 'pol1=%s\\n' \"$(bootstrap_strategy_failure_policy full)\"; " +
            "bootstrap_compile_failure_policy --fail-fast; " +
            "printf 'pol2=%s\\n' \"$(bootstrap_strategy_failure_policy adhoc)\"; " +
            "! bootstrap_strategy_validate unknown || exit 17"
        )
        expect(rc).to_equal(0)
        expect(err).to_equal("")
        expect(out).to_contain("path=/var/cache/simple/stage3/" + HEX_64_A + "/" + HEX_64_B + "/mcp")
        expect(out).to_contain("pol1=inventory-to-end")
        expect(out).to_contain("pol2=fail-fast")

    it "prunes old idle LRU directories while preserving current, recent, and live-marked dirs":
        val root = _bcp_make_root("lru")
        val parent = root + "/caches"
        expect(dir_create_all(parent + "/cur_dir")).to_be(true)
        expect(dir_create_all(parent + "/recent_dir")).to_be(true)
        expect(dir_create_all(parent + "/live_dir")).to_be(true)
        expect(dir_create_all(parent + "/old_idle_dir")).to_be(true)

        val (_o, _e, rc) = _bcp_sh(
            "set -eu; . ./" + CACHE_POLICY + "; " +
            "touch '" + parent + "/cur_dir/a'; " +
            "touch '" + parent + "/recent_dir/b'; " +
            "touch -t 202001010000 '" + parent + "/live_dir/c' '" + parent + "/live_dir'; " +
            "touch -t 202001010000 '" + parent + "/old_idle_dir/d' '" + parent + "/old_idle_dir'; " +
            ": > '" + parent + "/live_dir/.in-use.'$$; " +
            "touch -t 202001010000 '" + parent + "/live_dir/.in-use.'$$ '" + parent + "/live_dir'; " +
            "bootstrap_prune_lru_dirs '" + parent + "' cur_dir 1 unit-cache"
        )
        expect(rc).to_equal(0)
        expect(file_exists(parent + "/cur_dir")).to_be(true)
        expect(file_exists(parent + "/recent_dir")).to_be(true)
        expect(file_exists(parent + "/live_dir")).to_be(true)
        expect(file_exists(parent + "/old_idle_dir")).to_be(false)
        expect(dir_remove_all(root)).to_be(true)

describe "bootstrap-seed-stop-policy.shs":
    it "allows compatible invocations and rejects missing --full-bootstrap or conflicting flags with 64":
        val (_o_noop, _e_noop, rc_noop) = _bcp_sh(". ./" + SEED_STOP_POLICY + "; bootstrap_seed_stop_policy_validate --pure-simple")
        expect(rc_noop).to_equal(0)

        val (_o_ok, _e_ok, rc_ok) = _bcp_sh(". ./" + SEED_STOP_POLICY + "; bootstrap_seed_stop_policy_validate --full-bootstrap --stop-after-seed")
        expect(rc_ok).to_equal(0)

        val (_o_req, e_req, rc_req) = _bcp_sh(". ./" + SEED_STOP_POLICY + "; bootstrap_seed_stop_policy_validate --stop-after-seed")
        expect(rc_req).to_equal(64)
        expect(e_req).to_contain("--stop-after-seed requires --full-bootstrap")

        val (_o_cf1, e_cf1, rc_cf1) = _bcp_sh(". ./" + SEED_STOP_POLICY + "; bootstrap_seed_stop_policy_validate --stop-after-seed --full-bootstrap --deploy")
        expect(rc_cf1).to_equal(64)
        expect(e_cf1).to_contain("--stop-after-seed conflicts with --deploy")

        val (_o_cf2, e_cf2, rc_cf2) = _bcp_sh(". ./" + SEED_STOP_POLICY + "; bootstrap_seed_stop_policy_validate --full-bootstrap --stop-after-seed --resume-stage3-from-admitted=run1")
        expect(rc_cf2).to_equal(64)
        expect(e_cf2).to_contain("--stop-after-seed conflicts with --resume-stage3-from-admitted=run1")
