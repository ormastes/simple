#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
cd "$ROOT_DIR"

source_file=scripts/check/rebuild-sosix-qemu-media.shs
line=$(grep -n 'env SIMPLE_BUILD_COMPILER="$compiler" SIMPLE_BINARY="$compiler" SIMPLE_BIN="$compiler"' "$source_file")
[ "$(printf '%s\n' "$line" | wc -l | tr -d ' ')" -eq 1 ] || {
    echo 'FAIL admitted compiler forwarding must have exactly one construction owner' >&2
    exit 1
}
start=${line%%:*}
end=$((start + 12))
block=$(sed -n "${start},${end}p" "$source_file")
printf '%s\n' "$block" | grep -F 'TMPDIR="$tmp_dir" sh "$ROOT_DIR/scripts/os/make_os_disk.shs"' >/dev/null || {
    echo 'FAIL admitted compiler aliases are not on the make_os_disk invocation' >&2
    exit 1
}
printf '%s\n' "$block" | grep -F 'SIMPLEOS_FSEXEC_BINARY="$fsexec_env"' >/dev/null || {
    echo 'FAIL compiler authority is disconnected from the filesystem image inputs' >&2
    exit 1
}

echo 'PASS sosix rebuild forwards one verified compiler through every nested image builder alias'
