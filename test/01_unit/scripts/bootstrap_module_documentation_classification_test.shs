#!/bin/sh
# Source classification only; does not simulate compiler/object success.
set -eu
. scripts/bootstrap/bootstrap-module-collection.shs
fixture_root=$(mktemp -d)
trap 'rm -r -- "$fixture_root"' 0
printf '\n # package documentation\n\t# fn main(): example only\n' > "$fixture_root/documentation.spl"
printf 'fn answer() -> i64:\n    42\n' > "$fixture_root/code.spl"
printf '# facade\nexport use app.provider.*\n' > "$fixture_root/export.spl"
printf 'use app.provider.{answer}\n' > "$fixture_root/import.spl"
printf '"""package docstring"""\n' > "$fixture_root/docstring.spl"
printf '# comment\n@target("linux")\n' > "$fixture_root/attribute.spl"
printf 'val text = "# executable text"\n' > "$fixture_root/quoted.spl"
printf 'struct Value:\n    number: i64\n' > "$fixture_root/declaration.spl"
printf ' \t\n\n' > "$fixture_root/whitespace.spl"
ln -s documentation.spl "$fixture_root/alias.spl"
bootstrap_module_documentation_only "$fixture_root/documentation.spl"
bootstrap_module_documentation_only "$fixture_root/whitespace.spl"
for fixture in code export import docstring attribute quoted declaration alias missing; do
  if bootstrap_module_documentation_only "$fixture_root/$fixture.spl"; then
    echo "incorrect documentation-only classification: $fixture" >&2
    exit 1
  fi
done
# Admission policy remains blocking; documentation rows cannot become PASS.
printf '%s\n' "$fixture_root/documentation.spl" > "$fixture_root/inventory"
hash_stream() { sha256sum | awk '{print $1}'; }
validate_fixture() { return 0; }
never_compile_documentation() { echo 'unexpected compile attempt' >&2; return 99; }
snapshot_sha=classifier-fixture-no-compiler-execution
if run_module_compile_inventory "$fixture_root/inventory" "$fixture_root/work" \
    "$fixture_root/cache" 1 1 never_compile_documentation validate_fixture \
    "$fixture_root/summary"; then
  echo 'documentation-only inventory incorrectly admitted' >&2
  exit 1
fi
rg -q 'result=UNSUPPORTED\|status=documentation-only-no-code' "$fixture_root/summary"
rg -q 'artifact=-\|' "$fixture_root/summary"
echo 'bootstrap_module_documentation_classification=PASS'
