#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
gate="$repo_root/scripts/check/run-gdb-inferior-strict.shs"
tmp_dir=$(mktemp -d)
trap 'rm -rf -- "$tmp_dir"' EXIT HUP INT TERM

touch "$tmp_dir/result"
chmod +x "$tmp_dir/result"
"$gate" --log "$tmp_dir/pass.log" --artifact "$tmp_dir/result" -- /bin/true >/dev/null

set +e
"$gate" --log "$tmp_dir/signal.log" -- /bin/sh -c 'kill -SEGV $$' >/dev/null 2>&1
signal_status=$?
set -e
[ "$signal_status" -ne 0 ] || {
    echo "FAIL: signalled inferior was accepted" >&2
    exit 1
}

set +e
"$gate" --log "$tmp_dir/missing.log" --artifact "$tmp_dir/absent" -- /bin/true >/dev/null 2>&1
artifact_status=$?
set -e
[ "$artifact_status" -ne 0 ] || {
    echo "FAIL: missing promotion artifact was accepted" >&2
    exit 1
}

echo "PASS: strict gdb inferior gate"
