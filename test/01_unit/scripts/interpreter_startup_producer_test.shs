#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd -P)
PRODUCER=$ROOT/scripts/check/produce-interpreter-startup-evidence.shs
sh "$PRODUCER" --self-test | grep -Fxq 'STATUS: PASS interpreter-startup-producer self-test'
grep -Fq 'clock_gettime(CLOCK_MONOTONIC' "$ROOT/scripts/check/lib/rust-go-benchmark-monotonic-ns.c"
grep -Fq 'external-evidence.unsigned.env' "$PRODUCER"
grep -Fq 'head-drift-during-production' "$PRODUCER"
grep -Fq 'forbidden-environment-override' "$PRODUCER"
grep -Fq 'startup_clock_helper' "$ROOT/scripts/check/check-external-must-check-receipt.shs"
grep -Fq 'env -i LC_ALL=C PATH=/usr/bin:/bin HOME=' "$PRODUCER"
grep -Fq 'startup-external-checker-source.shs' "$PRODUCER"
grep -Fq 'fresh-process-fresh-isolated-runtime-cache' "$PRODUCER"
echo 'PASS: interpreter startup evidence producer contract'
