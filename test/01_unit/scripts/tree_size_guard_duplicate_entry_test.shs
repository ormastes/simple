#!/bin/sh
# Regression: check-tree-size-push.shs must catch a duplicate tree entry even
# when the two entries hold DIFFERENT subtrees.
#
# The duplicate check used `git ls-tree -r --name-only` (blobs only) piped
# through `sort | uniq -d`. That only sees a duplicate when the two entries
# expand to the SAME path list -- i.e. when they are byte-identical trees, which
# is what the guard's own same-sha fixture built. Two `src/lib` entries holding
# disjoint subtrees expand to disjoint paths and produce ZERO duplicate lines,
# so the corrupt tree walked straight through with a clean PASS. Same defect
# class as the fixed-width `^<<<<<<< ` conflict-marker regex fixed in
# b5863954c1b: an exact-string assumption a real variant slips past.
#
# Builds a throwaway git repo whose trees are large and shapely enough that
# EVERY other check in the guard is satisfied -- ~96k files, 15 entries under
# src/, every load-bearing path over its floor, zero delta against the base --
# so the ONLY thing that can fail the corrupt commit is the duplicate check.
# The REAL guard is run against it, so the test cannot pass by agreeing with a
# stale copy of the logic.
set -e

GUARD=$(cd "$(dirname "$0")/../../.." && pwd)/scripts/check/check-tree-size-push.shs
[ -f "$GUARD" ] || { echo "FAIL: guard not found at $GUARD"; exit 1; }

TMPD=$(mktemp -d)
trap 'rm -rf "$TMPD"' EXIT

# Isolate from any inherited GIT_DIR (see reference: `git -C` does NOT override it).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_NAMESPACE

repo="$TMPD/r"
mkdir -p "$repo"
g() { env -u GIT_DIR git -C "$repo" "$@"; }
g init -q .
g config user.email t@t
g config user.name t
# The guard is fail-closed on "script lives in repo X but cwd is repo Y" (the
# 2026-08-01 cwd fail-open fix). Run a byte copy from inside the fixture repo --
# same logic, satisfies its own containment check.
mkdir -p "$repo/scripts/check"
cp "$GUARD" "$repo/scripts/check/g.shs"
chmod +x "$repo/scripts/check/g.shs"
GUARD="$repo/scripts/check/g.shs"

BLOB=$(printf 'fixture\n' | g hash-object -w --stdin)

# mkdirtree <count> <name-prefix> -> tree sha holding <prefix>0.txt ...
mkdirtree() {
    n=$1; p=$2
    i=0
    : >"$TMPD/mk.in"
    while [ "$i" -lt "$n" ]; do
        printf '100644 blob %s\t%s%s.txt\n' "$BLOB" "$p" "$i" >>"$TMPD/mk.in"
        i=$((i + 1))
    done
    g mktree <"$TMPD/mk.in"
}

# 45k + 45k with DISJOINT names, so the two halves share no path at all.
TQ=$(mkdirtree 45000 q)
TZ=$(mkdirtree 45000 z)
TAPP=$(mkdirtree 2000 a)
TCOMP=$(mkdirtree 1200 c)
TOS=$(mkdirtree 1200 o)
TRUN=$(mkdirtree 150 r)
TFILL=$(mkdirtree 10 x)
TDOC=$(mkdirtree 1000 d)
TSCR=$(mkdirtree 500 s)
TDOC2=$(mkdirtree 1001 d)   # +1 file: the benign-churn control

# src/ entry list shared by both trees; only the two 45k entries differ in NAME.
src_tree() { # <first-name> <second-name>
    {
        printf '040000 tree %s\tapp\n'      "$TAPP"
        printf '040000 tree %s\tcompiler\n' "$TCOMP"
        printf '040000 tree %s\t%s\n'       "$TQ" "$1"
        printf '040000 tree %s\t%s\n'       "$TZ" "$2"
        printf '040000 tree %s\tos\n'       "$TOS"
        printf '040000 tree %s\truntime\n'  "$TRUN"
        for d in h1 h2 h3 h4 h5 h6 h7 h8 h9; do
            printf '040000 tree %s\t%s\n' "$TFILL" "$d"
        done
    } >"$TMPD/src.in"
    g mktree <"$TMPD/src.in"
}

top_tree() { # <src-tree> <doc-tree>
    {
        printf '040000 tree %s\tdoc\n'     "$2"
        printf '040000 tree %s\tscripts\n' "$TSCR"
        printf '040000 tree %s\tsrc\n'     "$1"
    } >"$TMPD/top.in"
    g mktree <"$TMPD/top.in"
}

HEALTHY_SRC=$(src_tree lib lib2)     # two distinct names: a normal tree
CORRUPT_SRC=$(src_tree lib lib)      # the corruption: `lib` twice, disjoint

BASE=$(g commit-tree "$(top_tree "$HEALTHY_SRC" "$TDOC")" -m base </dev/null)
CORRUPT=$(g commit-tree "$(top_tree "$CORRUPT_SRC" "$TDOC")" -p "$BASE" -m corrupt </dev/null)
CHURN=$(g commit-tree "$(top_tree "$HEALTHY_SRC" "$TDOC2")" -p "$BASE" -m churn </dev/null)

run_guard() { # <range> -> echoes exit code
    rc=0
    # `|| rc=$?` is load-bearing: under `set -e` a bare non-zero exit would kill
    # this subshell before it could report the code we are actually testing for.
    ( cd "$repo" && sh "$GUARD" "$1" ) >"$TMPD/out.txt" 2>&1 || rc=$?
    echo "$rc"
}

fails=0
check() { # <label> <actual> <expected>
    if [ "$2" = "$3" ]; then
        echo "ok   $1 (exit $2)"
    else
        echo "FAIL $1: expected exit $3, got $2"
        tail -20 "$TMPD/out.txt" | sed 's/^/     | /'
        fails=$((fails + 1))
    fi
}

# Control FIRST: if this does not pass, the fixture shape is wrong and the
# corrupt case would fail for the wrong reason.
check "healthy +1-file churn passes" "$(run_guard "$BASE..$CHURN")" 0
check "duplicate src/lib with DISJOINT subtrees rejected" \
      "$(run_guard "$BASE..$CORRUPT")" 1

# The guard's own fixture harness must also be green; it now carries the
# differing-sha duplicate as fixture 16.
selftest=0
( cd "$repo" && sh "$GUARD" --selftest ) >"$TMPD/out.txt" 2>&1 || selftest=$?
check "guard selftest green" "$selftest" 0

[ "$fails" -eq 0 ] || exit 1
echo "PASS - 3/3"
