use std.spec.{describe, it, expect}
use std.io_runtime.{rt_file_read_text}

fn evidence_source() -> text:
    rt_file_read_text("scripts/check/check-aspect-facet-nfr-evidence.shs") ?? ""

fn builder_source() -> text:
    rt_file_read_text("scripts/check/build-aspect-facet-nfr-probe.shs") ?? ""

fn probe_source() -> text:
    rt_file_read_text("test/05_perf/aspect_facet/aspect_facet_native_probe.spl") ?? ""

describe "aspect/facet NFR evidence contract":
    # @req NFR-AF-005
    it "admits only an exact pure-Simple compiler, native probe, and fixture":
        val source = evidence_source()
        val builder = builder_source()

        expect(source).to_contain("ASPECT_FACET_ADMITTED_COMPILER_SHA256")
        expect(source).to_contain("compiler_sha256_not_admitted")
        expect(source).to_contain("rust_seed_not_admissible")
        expect(source).to_contain("pure-simple-self-hosted")
        expect(source).to_contain("probe_compiler_provenance_mismatch")
        expect(source).to_contain("probe_binary_provenance_mismatch")
        expect(source).to_contain("probe_sha256=\"$(hash_file \"$PROBE\")\"")
        expect(source).to_contain("fixture_sha256=\"$(hash_file \"$FIXTURE\")\"")
        expect(source).to_contain("production baseline")
        expect(builder).to_contain("compiler_kind=pure-simple-self-hosted")
        expect(builder).to_contain("test/fixtures/aspect_facet/perf_fixture_builder.spl")
        expect(builder).to_contain("test/05_perf/aspect_facet/aspect_facet_native_probe.spl")
        expect(builder).to_contain("probe_sha256=$probe_sha256")

    # @req NFR-AF-005
    it "measures cold startup, first use, retained lookup, and distinct files":
        val source = evidence_source()
        val probe = probe_source()

        expect(source).to_contain("--mode=cold")
        expect(source).to_contain("--mode=first-use")
        expect(source).to_contain("--mode=lookup")
        expect(source).to_contain("first_use_p99_us")
        expect(source).to_contain("lookup_p99_ns")
        expect(source).to_contain("paths[opened] = 1")
        expect(source).to_contain("first_use_opened_files")
        expect(source).to_contain("lookup_opened_files")
        expect(source).to_contain("major_page_faults")
        expect(source).to_contain("minor_page_faults")
        expect(probe).to_contain("fn measure_cold_aspect_startup()")
        expect(probe).to_contain("fn measure_first_facet_use(")
        expect(probe).to_contain("fn measure_repeated_facet_lookup(")
        expect(probe).to_contain("runtime.activate_pack_bytes(")
        expect(probe).to_contain("runtime.acquire_published_facet(")
        expect(probe).to_contain("runtime.release_facet_generation_lease(")

    # @req NFR-AF-005
    it "fails cold isolation violations and retains cache accounting without invented thresholds":
        val source = evidence_source()

        expect(source).to_contain("cold_counter_nonzero_")
        expect(source).to_contain("pack_opens stored_bytes decoded_bytes executable_mappings sidecar_allocations runtime_scans")
        expect(source).to_contain("index_hits index_misses index_evictions")
        expect(source).to_contain("chunk_hits chunk_misses chunk_evictions")
        expect(source).to_contain("negative_hits negative_misses negative_evictions")
        expect(source).to_contain("slot_lookups slot_hits slot_misses")
        expect(source).to_contain("advice_publications advice_unbinds")
        expect(source).to_contain("dispatch_attempts dispatch_invocations dispatch_failures around_rejections")
        expect(source).to_contain("disabled_slot_checks disabled_slot_branches")
        expect(source).to_contain("disabled_contract_footprint_bytes")
        expect(source).to_contain("contract_minimum_not_backend_measurement")
        expect(source).to_contain("status: collected-not-thresholded")
        expect(source).to_not_contain("STARTUP_MAX")
        expect(source).to_not_contain("LOOKUP_MAX")
