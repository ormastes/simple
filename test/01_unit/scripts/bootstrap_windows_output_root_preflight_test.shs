#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
case "$(uname -s)" in MSYS*|MINGW*|CYGWIN*) ;; *) echo 'ERROR: actual Windows execution required' >&2; exit 2 ;; esac
. "$root/scripts/bootstrap/bootstrap-logged-process.shs"
short="$root/build/b3"
bootstrap_windows_output_root_preflight "$short"
long="$root/build/$(printf '%0240d' 0 | tr 0 x)"
status=0
bootstrap_windows_output_root_preflight "$long" > /dev/null 2>"$root/build/native_probe/windows-long-root-preflight.stderr" || status=$?
[ "$status" -eq 1 ]
grep -q '^windows-bootstrap-output-root-too-long:' "$root/build/native_probe/windows-long-root-preflight.stderr"
[ ! -e "$long/logs" ]
printf 'PASS: unsafe Windows output root rejected before build\n'
