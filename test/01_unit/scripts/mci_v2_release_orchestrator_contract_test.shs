#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd -P); work=$root/build/test-mci-v2-release-$$; trap 'rm -rf "$work"' EXIT HUP INT TERM; mkdir -p "$work/tools" "$work/keys"
for x in producer.private producer.public reviewer.public decision decision.sig policy; do printf '%s' "$x" >"$work/keys/$x"; done
base="MCI_RUN_ID=contract MCI_SOURCE_HASH=$(printf %064d 0) MCI_CONFIGURATION_HASH=$(printf %064d 1) MCI_CAPTURED_AT_UTC_NS=1 MCI_VALID_UNTIL_UTC_NS=2 MCI_NOW_UTC_NS=1 MCI_PRODUCER_PRIVATE_KEY=$work/keys/producer.private MCI_PRODUCER_PUBLIC_KEY=$work/keys/producer.public MCI_PRODUCER_KEY_ID=producer MCI_REVIEWER_PUBLIC_KEY=$work/keys/reviewer.public MCI_REVIEWER_KEY_ID=reviewer MCI_REVIEW_DECISION=$work/keys/decision MCI_REVIEW_DECISION_SIGNATURE=$work/keys/decision.sig MCI_REVIEWER_TRUST_POLICY=$work/keys/policy"
set +e; env $base MCI_REVIEW_DECISION= sh "$root/scripts/check/check-mci-v2-release.shs" --profile mixed-criticality-high-assurance --evidence "$work/blocked" --contract-fixture --tool-dir "$work/tools" >"$work/blocked.out" 2>&1; rc=$?; set -e; [ "$rc" -eq 2 ]; grep -q 'missing external/live prerequisite: MCI_REVIEW_DECISION' "$work/blocked.out"
set +e; env $base sh "$root/scripts/check/check-mci-v2-release.shs" --profile mixed-criticality-high-assurance --evidence "build/../outside-mci-release-$$" --contract-fixture --tool-dir "$work/tools" >/dev/null 2>&1; rc=$?; set -e; [ "$rc" -eq 2 ]; [ ! -e "$root/outside-mci-release-$$" ]
for limits in 'MCI_RELEASE_GATE_TIMEOUT_SECONDS=0' 'MCI_RELEASE_CAPTURE_LIMIT_BYTES=1073741825' 'MCI_RELEASE_MEMORY_LIMIT_KB=2097152' 'MCI_RELEASE_PROCESS_LIMIT=4097'; do
 set +e; env $base $limits sh "$root/scripts/check/check-mci-v2-release.shs" --profile mixed-criticality-high-assurance --evidence "$work/invalid-limit-${limits%%=*}" --contract-fixture --tool-dir "$work/tools" >/dev/null 2>&1; rc=$?; set -e; [ "$rc" -eq 2 ]
done
set +e; env $base sh "$root/scripts/check/check-mci-v2-release.shs" --profile mixed-criticality-high-assurance --profile mixed-criticality-high-assurance --evidence "$work/duplicate" --contract-fixture --tool-dir "$work/tools" >/dev/null 2>&1; rc=$?; set -e; [ "$rc" -eq 2 ]
for id in compiler tooling simpleos rendering allocation process-safety stress traceability; do printf '#!/bin/sh\necho %s >> "%s/order"\n' "$id" "$work" >"$work/tools/check-mci-v2-$id.shs"; done
cat >"$work/tools/check-simpleos-mission-critical-release.shs" <<'EOF'
#!/bin/sh
set -eu
mkdir -p "$BUILD_DIR"
printf '%s\n' \
 'simpleos_hardening_matrix_status=pass' \
 'simpleos_hardening_mission_critical_release_status=pass' \
 'simpleos_hardening_mission_critical_release_blockers=none' \
 'simpleos_hardening_matrix_passed=26/26' >"$BUILD_DIR/matrix.out"
: >"$BUILD_DIR/matrix.err"
printf '%s\n' '# controlled SimpleOS mission-critical fixture' '- passed: 26/26' >"$REPORT_PATH"
echo 'STATUS: PASS simpleos-mission-critical-release matrix_status=pass release_status=pass release_blockers=none'
EOF
printf '#!/bin/sh\nwhile [ "$#" -gt 0 ]; do [ "$1" = --lane ] && { echo "$2" >> "%s/order"; exit 0; }; shift; done\nexit 2\n' "$work" >"$work/tools/sign-mci-v2-lane.shs"
printf '#!/bin/sh\ncase "$*" in *candidate*) echo aggregate-candidate >> "%s/order"; exit 2;; *) echo aggregate-final >> "%s/order";; esac\n' "$work" "$work" >"$work/tools/check-mci-v2-aggregate.shs"
printf '#!/bin/sh\necho reviewer >> "%s/order"\n' "$work" >"$work/tools/check-mci-v2-independent-review.shs"; chmod +x "$work/tools/"*.shs
env $base MCI_RELEASE_PROCESS_LIMIT=4096 sh "$root/scripts/check/check-mci-v2-release.shs" --profile mixed-criticality-high-assurance --evidence "$work/happy" --contract-fixture --tool-dir "$work/tools" | grep -q '^CONTRACT_ONLY:'
expected='compiler tooling simpleos rendering allocation process-safety stress traceability compiler tooling simpleos rendering allocation fault-injection process-safety stress traceability aggregate-candidate reviewer aggregate-final'; [ "$(paste -sd' ' "$work/order")" = "$expected" ]; grep -qx result=CONTRACT_ONLY "$work/happy/orchestrator-run.env"
grep -qx gate_schema=simpleos-mission-critical-gate-v1 "$work/happy/simpleos-mission-critical-gate-v1.env"
grep -qx gate_status=pass "$work/happy/simpleos-mission-critical-gate-v1.env"
grep -qx execution_mode=CONTRACT_ONLY "$work/happy/simpleos-mission-critical-gate-v1.env"
grep -qx fixture_contract_only=true "$work/happy/simpleos-mission-critical-gate-v1.env"
grep -qx qemu_claim=not-made-by-orchestrator "$work/happy/simpleos-mission-critical-gate-v1.env"
grep -qx run_id=contract "$work/happy/simpleos-mission-critical-gate-v1.env"
grep -qx source_hash=$(printf %064d 0) "$work/happy/simpleos-mission-critical-gate-v1.env"
grep -qx configuration_hash=$(printf %064d 1) "$work/happy/simpleos-mission-critical-gate-v1.env"
grep -qx matrix_passed=26/26 "$work/happy/simpleos-mission-critical-gate-v1.env"
grep -Eq '^report_sha256=[0-9a-f]{64}$' "$work/happy/simpleos-mission-critical-gate-v1.env"
grep -Eq '^matrix_out_sha256=[0-9a-f]{64}$' "$work/happy/simpleos-mission-critical-gate-v1.env"
cp -R "$work/tools" "$work/fail-tools"
cat >"$work/fail-tools/check-simpleos-mission-critical-release.shs" <<'EOF'
#!/bin/sh
echo 'STATUS: FAIL simpleos-mission-critical-release controlled-fixture' >&2
exit 1
EOF
chmod +x "$work/fail-tools/check-simpleos-mission-critical-release.shs"
set +e; env $base MCI_RELEASE_PROCESS_LIMIT=4096 sh "$root/scripts/check/check-mci-v2-release.shs" --profile mixed-criticality-high-assurance --evidence "$work/gate-fail" --contract-fixture --tool-dir "$work/fail-tools" >"$work/gate-fail.out" 2>&1; rc=$?; set -e; [ "$rc" -eq 2 ]; grep -q 'SimpleOS mission-critical 26/26 gate failed' "$work/gate-fail.out"; [ ! -e "$work/gate-fail/simpleos-mission-critical-gate-v1.env" ]
cp -R "$work/tools" "$work/malformed-tools"
cat >"$work/malformed-tools/check-simpleos-mission-critical-release.shs" <<'EOF'
#!/bin/sh
set -eu
mkdir -p "$BUILD_DIR"
printf '%s\n' \
 'simpleos_hardening_matrix_status=pass' \
 'simpleos_hardening_mission_critical_release_status=pass' \
 'simpleos_hardening_mission_critical_release_blockers=none' \
 'simpleos_hardening_matrix_passed=25/26' >"$BUILD_DIR/matrix.out"
: >"$BUILD_DIR/matrix.err"
printf '%s\n' '- passed: 25/26' >"$REPORT_PATH"
echo 'STATUS: PASS simpleos-mission-critical-release matrix_status=pass release_status=pass release_blockers=none'
EOF
chmod +x "$work/malformed-tools/check-simpleos-mission-critical-release.shs"
set +e; env $base MCI_RELEASE_PROCESS_LIMIT=4096 sh "$root/scripts/check/check-mci-v2-release.shs" --profile mixed-criticality-high-assurance --evidence "$work/malformed" --contract-fixture --tool-dir "$work/malformed-tools" >"$work/malformed.out" 2>&1; rc=$?; set -e; [ "$rc" -eq 2 ]; grep -q 'matrix is not 26/26' "$work/malformed.out"; [ ! -e "$work/malformed/simpleos-mission-critical-gate-v1.env" ]
grep -Fq 'validate_args "$af" --evidence --run-id --source-hash --configuration-hash' "$root/scripts/check/check-mci-v2-release.shs"
grep -Fq 'orchestrator directory or manifest identity changed during stage' "$root/scripts/check/check-mci-v2-release.shs"
grep -Fq "candidate aggregate report missing" "$root/scripts/check/check-mci-v2-release.shs"
grep -Fq "candidate aggregate report result is indeterminate" "$root/scripts/check/check-mci-v2-release.shs"
grep -Fq "compatibility aggregate report differs from final report" "$root/scripts/check/check-mci-v2-release.shs"
cp -R "$work/tools" "$work/swap-tools"
printf '#!/bin/sh\nfor arg in "$@"; do if [ "$previous" = --evidence ]; then evidence=$arg; break; fi; previous=$arg; done\nmv "$evidence/orchestrator-captures" "$evidence/orchestrator-captures.old"\nmkdir "$evidence/orchestrator-captures"\n' >"$work/swap-tools/check-mci-v2-compiler.shs"; chmod +x "$work/swap-tools/check-mci-v2-compiler.shs"
set +e; env $base sh "$root/scripts/check/check-mci-v2-release.shs" --profile mixed-criticality-high-assurance --evidence "$work/path-swap" --contract-fixture --tool-dir "$work/swap-tools" >"$work/path-swap.out" 2>&1; rc=$?; set -e; [ "$rc" -eq 2 ]; grep -q 'orchestrator directory or manifest identity changed during stage' "$work/path-swap.out"
set +e; env $base sh "$root/scripts/check/check-mci-v2-release.shs" --profile mixed-criticality-high-assurance --evidence "$work/happy" --contract-fixture --tool-dir "$work/tools" >/dev/null 2>&1; rc=$?; set -e; [ "$rc" -eq 2 ]
echo 'PASS: MCI-v2 release orchestrator prerequisite and synthetic workflow contract'
