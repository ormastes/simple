#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
RUNNER=$ROOT/scripts/check/run-unoq-qrb2210-native-2d-live.shs

fail() { echo "FAIL: $1" >&2; exit 1; }
[ -x "$RUNNER" ] || fail "live runner is not executable"
sh -n "$RUNNER" || fail "live runner shell syntax"

for forbidden in --transcript --receipt --capture --replay --offline; do
    set +e
    output=$(sh "$RUNNER" "$forbidden" ignored 2>&1)
    code=$?
    set -e
    [ "$code" -eq 1 ] || fail "$forbidden was not rejected"
    printf '%s\n' "$output" | grep -q 'caller-supplied-evidence-forbidden' || fail "$forbidden rejection reason"
done

grep -q 'adb_run shell.*REMOTE_RUNNER' "$RUNNER" || fail "runner does not invoke production provider"
grep -q 'adb_run shell cat.*REMOTE_RECEIPT' "$RUNNER" || fail "runner does not own serial receipt acquisition"
grep -q 'adb_run exec-out cat.*REMOTE_CAPTURE' "$RUNNER" || fail "runner does not own capture acquisition"
grep -q 'blocked "qrb2210-board-not-connected"' "$RUNNER" || fail "missing-board path is not blocked"
grep -q 'blocked "production-board-evidence-provider-missing"' "$RUNNER" || fail "missing-provider path is not blocked"
grep -q 'readback_source.*device_readback' "$RUNNER" || fail "device readback requirement missing"
grep -q 'animation_frame_count).*ge 20' "$RUNNER" || fail "20-frame requirement missing"
grep -q 'warm_p95_frame_time_us' "$RUNNER" || fail "p95 performance receipt missing"
grep -q 'peak_rss_bytes' "$RUNNER" || fail "RSS performance receipt missing"
for field in ctrl_left ctrl_right alt_left alt_right key_down key_up pointer_move pointer_down pointer_drag pointer_up pointer_wheel audio_submitted audio_completed audio_non_silent; do
    grep -q "value $field" "$RUNNER" || fail "$field live receipt missing"
done

echo "PASS: UNO Q live runner rejects offline evidence and owns acquisition"
