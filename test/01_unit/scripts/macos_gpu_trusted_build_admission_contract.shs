#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)"
. "$ROOT_DIR/scripts/check/lib/macos-gpu-trusted-build-admission.shs"

fixture_root="$(mktemp -d "${TMPDIR:-/tmp}/macos-gpu-admission-fixture.XXXXXX")"
trap 'rm -rf "$fixture_root"' EXIT HUP INT TERM
fixture_root="$(CDPATH= cd -- "$fixture_root" && pwd -P)"
manifest="$fixture_root/common.env"

for name in runtime winit runtime-c output; do
    printf '%s\n' "$name" >"$fixture_root/$name"
done
chmod 700 "$fixture_root/output"
hash() {
    shasum -a 256 "$1" | awk '{print $1}'
}
{
    printf 'simple_runtime_provider_path=%s\n' "$fixture_root/runtime"
    printf 'simple_runtime_provider_sha256=%s\n' "$(hash "$fixture_root/runtime")"
    printf 'winit_provider_path=%s\n' "$fixture_root/winit"
    printf 'winit_provider_sha256=%s\n' "$(hash "$fixture_root/winit")"
    printf 'simple_runtime_c_provider_path=%s\n' "$fixture_root/runtime-c"
    printf 'simple_runtime_c_provider_sha256=%s\n' "$(hash "$fixture_root/runtime-c")"
    printf 'repo_revision=fixture-revision\n'
    printf 'source_input_fingerprint=%064d\n' 1
    printf 'output_path=%s\n' "$fixture_root/output"
    printf 'output_sha256=%s\n' "$(hash "$fixture_root/output")"
} >"$manifest"

macos_gpu_admission_populate_common_outputs "$manifest"
for required in \
    MACOS_GPU_ADMISSION_PROVIDER \
    MACOS_GPU_ADMISSION_PROVIDER_SHA256 \
    MACOS_GPU_ADMISSION_WINIT_PROVIDER \
    MACOS_GPU_ADMISSION_WINIT_PROVIDER_SHA256 \
    MACOS_GPU_ADMISSION_RUNTIME_C_PROVIDER \
    MACOS_GPU_ADMISSION_RUNTIME_C_PROVIDER_SHA256 \
    MACOS_GPU_ADMISSION_REPO_REVISION \
    MACOS_GPU_ADMISSION_SOURCE_INPUT_FINGERPRINT \
    MACOS_GPU_ADMISSION_OUTPUT \
    MACOS_GPU_ADMISSION_OUTPUT_SHA256; do
    eval "required_value=\${$required:-}"
    [ -n "$required_value" ] || {
        echo "missing exported admission field: $required" >&2
        exit 1
    }
done
[ "$MACOS_GPU_ADMISSION_PROVIDER" = "$fixture_root/runtime" ]
[ "$MACOS_GPU_ADMISSION_WINIT_PROVIDER" = "$fixture_root/winit" ]
[ "$MACOS_GPU_ADMISSION_RUNTIME_C_PROVIDER" = "$fixture_root/runtime-c" ]
[ "$MACOS_GPU_ADMISSION_OUTPUT" = "$fixture_root/output" ]
echo "macOS GPU trusted admission common outputs: PASS"
