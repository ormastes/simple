#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)
python3 - "$root" <<'PYTEST'
import pathlib, subprocess, tempfile, shutil, sys
root=pathlib.Path(sys.argv[1])
checker='#!/bin/sh\nset -eu\nfail(){ echo "$*" >&2; exit 1; }\ngrep -Fq \'val payload = value?\' test/fixtures/compiler/native_option_try_annotated_loud.spl || fail "uniform Option fixture must exercise annotated/local try lowering"\ngrep -Fq \'self.imported_enum_owners[local_name] = imported_mod.module_name\' src/compiler/20.hir/hir_lowering/_Items/module_import_registration.spl || fail "imported enum owner identity missing"\ngrep -Fq \'_bootstrap_type_runtime_names = lw.enum_runtime_id_names\' src/compiler/50.mir/_MirLowering/bootstrap_type_registration.spl || fail "bootstrap enum collision registry sharing missing"\ngrep -Fq \'lw = bootstrap_type_registration_finish(lw, "bootstrap MIR type registration failed")\' src/compiler/50.mir/_MirLowering/bootstrap_type_registration.spl || fail "bootstrap enum collision rejection missing"\ngrep -Fq \'lw.enum_runtime_id_names = _bootstrap_type_runtime_names\' src/compiler/50.mir/_MirLowering/bootstrap_type_registration.spl || fail "bootstrap enum collision registry restore missing"\nbody=$(sed -n \'/^fn bootstrap_type_registration_finish(/,/^fn bootstrap_register_flat_type_defs(/p\' src/compiler/50.mir/_MirLowering/bootstrap_type_registration.spl)\nprintf \'%s\\n\' "$body" | grep -Fq \'if lw.errors.len() > 0:\' || fail errors\nprintf \'%s\\n\' "$body" | grep -Fq \'exit(1)\' || fail exit\ntest "$(grep -Fc \'MirLowering.new_for_target(SymbolTable.new(), target_context)\' src/compiler/80.driver/driver_pipeline_lowering.spl)" -eq 2 || fail constructors\n'
mutations=[{'owner': 'test/fixtures/compiler/native_option_try_annotated_loud.spl', 'removed': 'val payload = value?', 'exit': 1}, {'owner': 'src/compiler/20.hir/hir_lowering/_Items/module_import_registration.spl', 'removed': 'self.imported_enum_owners[local_name] = imported_mod.module_name', 'exit': 1}, {'owner': 'src/compiler/50.mir/_MirLowering/bootstrap_type_registration.spl', 'removed': '_bootstrap_type_runtime_names = lw.enum_runtime_id_names', 'exit': 1}, {'owner': 'src/compiler/50.mir/_MirLowering/bootstrap_type_registration.spl', 'removed': 'lw.enum_runtime_id_names = _bootstrap_type_runtime_names', 'exit': 1}, {'owner': 'src/compiler/50.mir/_MirLowering/bootstrap_type_registration.spl', 'removed': 'if lw.errors.len() > 0:', 'exit': 1}, {'owner': 'src/compiler/50.mir/_MirLowering/bootstrap_type_registration.spl', 'removed': 'exit(1)', 'exit': 1}, {'owner': 'src/compiler/80.driver/driver_pipeline_lowering.spl', 'removed': 'MirLowering.new_for_target(SymbolTable.new(), target_context)', 'exit': 1}]
with tempfile.TemporaryDirectory(prefix="simple-portability-owner-") as temporary:
    fixture=pathlib.Path(temporary)
    originals={item['owner']:(root/item['owner']).read_bytes() for item in mutations}
    for name,data in originals.items():
        target=fixture/name
        target.parent.mkdir(parents=True,exist_ok=True)
        target.write_bytes(data)
    check=fixture/'check.sh'
    check.write_text(checker)
    def run():
        return subprocess.run(['sh',str(check)],cwd=fixture,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    positive=run()
    if positive.returncode:
        sys.stderr.buffer.write(positive.stderr)
        raise SystemExit('current source-owner contract rejected')
    for item in mutations:
        target=fixture/item['owner']
        text=originals[item['owner']].decode()
        if item['removed'] not in text:
            raise SystemExit('mutation target absent: '+item['removed'])
        target.write_text(text.replace(item['removed'],'REMOVED_CONTRACT'))
        result=run()
        target.write_bytes(originals[item['owner']])
        if result.returncode==0:
            raise SystemExit('removed contract accepted: '+item['removed'])
print('PASS: current source owners and seven destructive rejection fixtures')
PYTEST
