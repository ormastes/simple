#!/bin/sh
# Windows native-child regression for the CL=/TC Git Bash conversion bug.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$root/scripts/bootstrap/bootstrap-windows-cl-mode.shs"
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) ;; *) exit 77 ;; esac
CL=/TC
MSYS2_ENV_CONV_EXCL='OTHER='
export CL MSYS2_ENV_CONV_EXCL
bootstrap_windows_preserve_cl_mode
test "$MSYS2_ENV_CONV_EXCL" = 'OTHER=;CL='
bootstrap_windows_preserve_cl_mode
test "$MSYS2_ENV_CONV_EXCL" = 'OTHER=;CL='
native_cl=$(MSYS2_ARG_CONV_EXCL='*' cmd.exe /d /c 'set CL' | tr -d '\r')
test "$native_cl" = 'CL=/TC'
printf 'bootstrap_windows_cl_mode=true\n'
