#!/bin/sh
# Static contract for the bounded, composer-owned Gen2 qualification envelope.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
RUNNER=$ROOT/scripts/check/run-riscv-gen2-hwir-qualification.shs

fail() { printf '%s\n' "FAIL: $1" >&2; exit 1; }

[ -x "$RUNNER" ] || fail 'qualification runner is not executable'
sh -n "$RUNNER" || fail 'qualification runner shell syntax'

for token in \
    'stage4_verify_candidate_provenance "$provenance" "$simple" "$ROOT_DIR"' \
    'check-post-bootstrap-stage4-sspec.shs' \
    '[ "$provenance" = "${simple}.provenance.env" ]' \
    'command -v ghdl >/dev/null 2>&1 || fail '\''ghdl-missing'\''' \
    'command -v timeout >/dev/null 2>&1 || fail '\''timeout-missing'\''' \
    'output-directory-preexists' \
    'mkdir "$resolved_out" || fail '\''output-directory-create-failed'\''' \
    'QUALIFICATION_PRODUCT=riscv-gen2-zca-trap-single-outstanding-v3' \
    'RV32_ROW=rv32-zca-cjal-critical' \
    'RV64_ROW=rv64-zca-addiw-critical' \
    '--emit-evidence' \
    '--compose-receipt' \
    'receipt-forbidden-before-evidence-validation' \
    'rv32_row_gate rv64_row_gate' \
    'rv32_coverage_gate rv64_coverage_gate' \
    'rv32_ghdl_analyze rv32_ghdl_elaborate rv32_ghdl_run' \
    'rv64_ghdl_analyze rv64_ghdl_elaborate rv64_ghdl_run' \
    'qualification_receipt.json' \
    'composer-receipt-missing-or-symlinked' \
    'cleanup_partial_receipt' \
    'rv32_vhdl_manifest_sha256' \
    'rv64_vhdl_manifest_sha256' \
    'rv32_ghdl_analyze_command_sha256' \
    'rv64_ghdl_run_command_sha256' \
    'ghdl-command-missing:' \
    'ghdl-log-hash-mismatch:' \
    'composer-may-not-recurse-to-runner'; do
    grep -F -- "$token" "$RUNNER" >/dev/null || fail "missing fail-closed token: $token"
done

# Receipt production belongs to the admitted composer.  The shell envelope may
# redirect its composer log but must not create, append, touch, move, or copy
# the qualification receipt itself.
if grep -E '^[^#]*(>|>>|touch|mv|cp)[^#]*(qualification_receipt\.json|\$RECEIPT)' "$RUNNER" |
    grep -Fv 'rm -f -- "$RECEIPT"' >/dev/null; then
    fail 'runner forges or moves the composer-owned receipt'
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/simple-riscv-gen2-qualification-contract.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
if sh "$RUNNER" --unknown >"$tmp/unknown.out" 2>&1; then
    fail 'unknown argument accepted'
fi
grep -q '^riscv_gen2_hwir_qualification_reason=unknown-argument:--unknown$' \
    "$tmp/unknown.out" || {
    fail 'unknown argument did not fail closed'
}

mkdir "$tmp/preexisting-run"
if sh "$RUNNER" \
    --stage4-cli "$tmp/missing-cli" \
    --stage4-provenance "$tmp/missing-provenance" \
    --composer "$tmp/missing-composer" \
    --output-dir "$tmp/preexisting-run" >"$tmp/preexisting.out" 2>&1; then
    fail 'preexisting output directory accepted'
fi
grep -q '^riscv_gen2_hwir_qualification_reason=output-directory-preexists$' \
    "$tmp/preexisting.out" || fail 'preexisting output directory did not fail before admission or execution'

printf '%s\n' 'PASS: Gen2 HWIR qualification runner requires admitted Stage4, fresh evidence, GHDL, and fixed RV32/RV64 gates'
