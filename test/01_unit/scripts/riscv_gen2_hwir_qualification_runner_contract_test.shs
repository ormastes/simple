#!/bin/sh
# Contract and deliberate-red checks for the runner-owned staging boundary.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
RUNNER=$ROOT/scripts/check/run-riscv-gen2-hwir-qualification.shs
fail() { printf '%s\n' "FAIL: $1" >&2; exit 1; }

[ -x "$RUNNER" ] || fail 'runner is not executable'
sh -n "$RUNNER" || fail 'runner shell syntax'
for token in \
    'schema=riscv-gen2-hwir-qualification-run-v2' \
    'STAGING=$evidence_root/$run_id.staging.$$' \
    'final-path-created-before-composer' \
    'run "$COMPOSER_SOURCE" --manifest "$(rel "$MANIFEST")" --run-id "$run_id"' \
    'branch_coverage_command_path=' 'changed_file_count=' 'exclusion_count=4' \
    'testbench' 'product_exit_code=0' 'analyze_exit_code=0' \
    'elaborate_exit_code=0' 'run_exit_code=0' \
    'stage4_verify_candidate_provenance "$provenance" "$simple" "$ROOT_DIR"' \
    'branch-coverage-below-threshold' 'receipt-composer-failed:' \
    'env SIMPLE_SAFETY_PROFILE=critical' '--workdir="$workdir"' \
    'riscv_gen2_trap_stateful_rv32_tb.vhd' \
    'riscv_gen2_trap_identity_rv64_tb.vhd'; do
    grep -F -- "$token" "$RUNNER" >/dev/null || fail "missing contract token: $token"
done
if grep -E -- '--emit-evidence|--compose-receipt|--composer' "$RUNNER" >/dev/null; then
    fail 'fictitious or caller-selected composer mode remains'
fi
if grep -F 'git diff-tree' "$RUNNER" >/dev/null; then
    fail 'content source revision was incorrectly treated as a Git object'
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/simple-g2-runner-contract.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
if sh "$RUNNER" --unknown >"$tmp/unknown.out" 2>&1; then fail 'unknown argument accepted'; fi
grep -q 'reason=unknown-argument:--unknown$' "$tmp/unknown.out" || fail 'unknown argument reason'

mkdir "$tmp/preexisting"
if sh "$RUNNER" --stage4-cli "$tmp/no-cli" --stage4-provenance "$tmp/no-prov" --output-dir "$tmp/preexisting" >"$tmp/preexisting.out" 2>&1; then
    fail 'preexisting final path accepted'
fi
grep -q 'reason=output-directory-preexists$' "$tmp/preexisting.out" || fail 'preexisting path was not rejected before admission'

# A fake executable is permitted only to probe failure ordering. It can never
# produce admitted provenance and therefore can never reach or print PASS.
printf '%s\n' '#!/bin/sh' 'exit 0' >"$tmp/fake-simple"
chmod +x "$tmp/fake-simple"
: >"$tmp/fake-simple.provenance.env"
if sh "$RUNNER" --stage4-cli "$tmp/fake-simple" --stage4-provenance "$tmp/fake-simple.provenance.env" --output-dir "$ROOT/build/evidence/riscv_gen2_hwir_foundation/contract-fake-$$" >"$tmp/fake.out" 2>&1; then
    fail 'fake executable qualified'
fi
grep -q '^riscv_gen2_hwir_qualification_status=pass$' "$tmp/fake.out" && fail 'fake executable printed PASS'

printf '%s\n' 'PASS: runner owns staging and commands, invokes only the admitted CLI composer, and cannot qualify contract fakes'
