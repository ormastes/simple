# Small self-consistent committed generation for host authority contract tests.
phase1_authority_fixture() {
    paf_tools=$1 paf_source=$2 paf_seed=$3
    BOOTSTRAP_STAGE3_FACADE_PATH=$paf_tools/scripts/check/lib/bootstrap-stage3-provenance.shs
    BOOTSTRAP_STAGE3_VERSION_ROOT=$paf_source
    export BOOTSTRAP_STAGE3_FACADE_PATH BOOTSTRAP_STAGE3_VERSION_ROOT
    . "$BOOTSTRAP_STAGE3_FACADE_PATH"
    paf_root=$paf_source/src/compiler_rust/target/bootstrap.generations
    paf_stage=$paf_root/.fixture
    mkdir -p "$paf_stage"
    cp "$paf_seed" "$paf_stage/simple"
    chmod +x "$paf_stage/simple"
    paf_inputs=$(printf fixture-inputs | bootstrap_stage3_hash_stream)
    {
        echo schema=simple-bootstrap-seed-artifact-stamp-v2
        echo inputs_fingerprint="$paf_inputs"
        echo seed_sha256="$(bootstrap_stage3_hash_file "$paf_stage/simple")"
    } >"$paf_stage/simple.inputs.sha256"
    bootstrap_stage3_directory_snapshot "$paf_root/snapshot" "$paf_stage"
    paf_sha=$(bootstrap_stage3_hash_file "$paf_root/snapshot")
    rm "$paf_root/snapshot"
    paf_final=$paf_root/$paf_inputs-$paf_sha
    mv "$paf_stage" "$paf_final"
    {
        echo schema=simple-bootstrap-authority-current-v1
        echo generation="$paf_inputs-$paf_sha"
        echo inputs_fingerprint="$paf_inputs"
        echo generation_sha256="$paf_sha"
        echo stamp_sha256="$(bootstrap_stage3_hash_file "$paf_final/simple.inputs.sha256")"
    } >"$paf_source/src/compiler_rust/target/bootstrap.current.env"
}
