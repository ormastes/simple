"""
# Dual-Implementation Ratchet Test-Dir Prune & Same-Name Prevention Spec

Prevention coverage for `rt_dual_implementation_counts_rust_test_functions_2026_11_07`:
ensures top-level `src/runtime/test` selfchecks are pruned (while nested `test`
subdirectories remain scanned) and a `#[test]` definition never hides a real
same-named runtime export.
"""

use std.spec.*
use app.io.process_ops.{process_run}

describe "rt-dual-implementation ratchet directory pruning and same-name isolation":
    """Verifies C selfcheck directory pruning and per-occurrence Rust test filtering."""

    it "prunes top-level src/runtime/test while keeping nested test subdirectories":
        val script =
            "set -u; " +
            "REPO=$(pwd); SELF=\"$REPO/scripts/check/check-rt-dual-implementation-ratchet.shs\"; " +
            "T=$(mktemp -d); trap 'rm -rf \"$T\"' EXIT; " +
            "mkdir -p \"$T/r/src/runtime/test\" \"$T/r/src/runtime/hosted/test\" \"$T/r/src/compiler_rust/runtime/src\" \"$T/r/src/compiler_rust/native_all/src\" \"$T/r/src/compiler_rust/native_loader/src\" \"$T/r/scripts/check\"; " +
            ": > \"$T/r/src/compiler_rust/native_all/src/.gitkeep\"; : > \"$T/r/src/compiler_rust/native_loader/src/.gitkeep\"; " +
            "printf 'int64_t rt_conly(void) {{ return 1; }}\\n' > \"$T/r/src/runtime/r.c\"; " +
            "printf 'pub fn rt_ronly() -> i64 {{ 1 }}\\n' > \"$T/r/src/compiler_rust/runtime/src/lib.rs\"; " +
            "printf 'rt_conly\\tc-only\\nrt_ronly\\trust-only\\n' > \"$T/r/scripts/check/rt_dual_implementation_baseline.txt\"; " +
            "(cd \"$T/r\" && git init -q . && git config user.email fx@example.com && git config user.name fx && git add -A && git commit -q -m base); " +
            "printf 'int64_t rt_selfcheck_driver(void) {{ return 1; }}\\n' > \"$T/r/src/runtime/test/selfcheck.c\"; " +
            "(cd \"$T/r\" && git add -A && git commit -q -m selfcheck); " +
            "o1=$(RT_DUAL_RATCHET_SELFTEST_CHILD=1 RT_DUAL_CENSUS_DIR=none sh \"$SELF\" --root \"$T/r\" --rev HEAD --baseline-rev HEAD~1 2>&1); rc1=$?; " +
            "printf 'int64_t rt_nested_test_symbol(void) {{ return 2; }}\\n' > \"$T/r/src/runtime/hosted/test/nested.c\"; " +
            "(cd \"$T/r\" && git add -A && git commit -q -m nested); " +
            "o2=$(RT_DUAL_RATCHET_SELFTEST_CHILD=1 RT_DUAL_CENSUS_DIR=none sh \"$SELF\" --root \"$T/r\" --rev HEAD --baseline-rev HEAD~2 2>&1); rc2=$?; " +
            "printf 'RC1=%s\\nO1=%s\\nRC2=%s\\nO2=%s\\n' \"$rc1\" \"$o1\" \"$rc2\" \"$o2\""
        val res = process_run("sh", ["-c", script])
        val out: text = res.0
        expect(out).to_contain("RC1=0")
        expect(out).to_contain("0 new")
        expect(out).to_contain("RC2=1")
        expect(out).to_contain("rt_nested_test_symbol")

    it "does not allow a #[test] function to suppress a real same-named runtime export":
        val script =
            "set -u; " +
            "REPO=$(pwd); SELF=\"$REPO/scripts/check/check-rt-dual-implementation-ratchet.shs\"; " +
            "T=$(mktemp -d); trap 'rm -rf \"$T\"' EXIT; " +
            "mkdir -p \"$T/r/src/runtime\" \"$T/r/src/compiler_rust/runtime/src\" \"$T/r/src/compiler_rust/native_all/src\" \"$T/r/src/compiler_rust/native_loader/src\" \"$T/r/scripts/check\"; " +
            ": > \"$T/r/src/compiler_rust/native_all/src/.gitkeep\"; : > \"$T/r/src/compiler_rust/native_loader/src/.gitkeep\"; " +
            "printf 'int64_t rt_conly(void) {{ return 1; }}\\n' > \"$T/r/src/runtime/r.c\"; " +
            "printf 'pub fn rt_ronly() -> i64 {{ 1 }}\\n' > \"$T/r/src/compiler_rust/runtime/src/lib.rs\"; " +
            "printf 'rt_conly\\tc-only\\nrt_ronly\\trust-only\\n' > \"$T/r/scripts/check/rt_dual_implementation_baseline.txt\"; " +
            "(cd \"$T/r\" && git init -q . && git config user.email fx@example.com && git config user.name fx && git add -A && git commit -q -m base); " +
            "printf 'mod t {{ #[test] fn rt_same_name() {{}} }}\\nmod rt {{ pub fn rt_same_name() {{}} }}\\n' >> \"$T/r/src/compiler_rust/runtime/src/lib.rs\"; " +
            "(cd \"$T/r\" && git add -A && git commit -q -m samename); " +
            "o=$(RT_DUAL_RATCHET_SELFTEST_CHILD=1 RT_DUAL_CENSUS_DIR=none sh \"$SELF\" --root \"$T/r\" --rev HEAD --baseline-rev HEAD~1 2>&1); rc=$?; " +
            "printf 'RC=%s\\nO=%s\\n' \"$rc\" \"$o\""
        val res = process_run("sh", ["-c", script])
        val out: text = res.0
        expect(out).to_contain("RC=1")
        expect(out).to_contain("rt_same_name")
