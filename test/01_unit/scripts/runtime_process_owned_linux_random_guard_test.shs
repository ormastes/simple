#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
source_file="$root/src/runtime/runtime_process_owned.c"

macro_block=$(sed -n '/#ifndef RT_OWNED_TOKEN_FILL/,/#endif/p' "$source_file")
printf '%s\n' "$macro_block" | grep -Fq '#if defined(__linux__) && defined(SYS_getrandom)'
printf '%s\n' "$macro_block" | grep -Fq '#define RT_OWNED_TOKEN_FILL(dst, len) syscall(SYS_getrandom, (dst), (len), 0)'

mint_block=$(sed -n '/static int pov4_mint_positive/,/^}/p' "$source_file")
printf '%s\n' "$mint_block" | grep -Fq '#if defined(__linux__) && defined(SYS_getrandom)'
printf '%s\n' "$mint_block" | grep -Fq 'errno = ENOTSUP;'

printf '%s\n' 'runtime_process_owned_linux_random_guard=pass'
