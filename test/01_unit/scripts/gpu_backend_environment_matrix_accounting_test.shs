#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)"
cd "$ROOT_DIR"

TMP_DIR="$(mktemp -d /tmp/simple-gpu-backend-matrix-test.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT HUP INT TERM

CHECK="scripts/check/check-gpu-backend-layer-evidence.shs"

FAKE_PORTABLE="$TMP_DIR/fake-portable-check.shs"
cat >"$FAKE_PORTABLE" <<'FAKE'
#!/bin/sh
set -eu
if [ "${FAKE_PORTABLE_MODE:-unavailable}" = missing-evidence ]; then
    exit 7
fi
mkdir -p "$BUILD_DIR"
target="$PORTABLE_COMPUTE_TARGETS"
if [ "$target" = vulkan ]; then
    prefix=vulkan_font
else
    prefix="$target"
fi
{
    printf '%s_status=unavailable\n' "$prefix"
    printf '%s_reason=missing-primary-tool\n' "$prefix"
    printf '%s_artifact=%s/%s.missing\n' "$prefix" "$BUILD_DIR" "$target"
} >"$BUILD_DIR/evidence.env"
FAKE
chmod +x "$FAKE_PORTABLE"

sh "$CHECK" --self-test >"$TMP_DIR/classification.log" 2>"$TMP_DIR/classification.err"
test ! -s "$TMP_DIR/classification.err"
grep -Fq 'gpu_backend_layer_self_test=PASS' "$TMP_DIR/classification.log"
grep -Fq 'cuda_validate_result=PASS' "$TMP_DIR/classification.log"
grep -Fq 'cuda_validate_result=SKIP_UNAVAILABLE' "$TMP_DIR/classification.log"
grep -Fq 'cuda_validate_result=FAIL' "$TMP_DIR/classification.log"
grep -Fq 'cuda_runtime_reason=zero-exit-without-pass-receipt' "$TMP_DIR/classification.log"
grep -Fq 'cuda_runtime_reason=runtime-capability-unavailable' "$TMP_DIR/classification.log"
grep -Fq 'cuda_runtime_reason=runtime-check-failed' "$TMP_DIR/classification.log"

sh "$CHECK" --matrix-self-test >"$TMP_DIR/matrix.log" 2>"$TMP_DIR/matrix.err"
test ! -s "$TMP_DIR/matrix.err"

for backend in cuda vulkan metal hip opencl; do
    for stage in emit validate link runtime; do
        row_count="$(grep -Ec "^${backend}_${stage}_result=(PASS|FAIL|SKIP_UNAVAILABLE)$" "$TMP_DIR/matrix.log")"
        test "$row_count" -eq 1
        grep -Fq "${backend}_${stage}_result=PASS" "$TMP_DIR/matrix.log"
    done
done
result_rows="$(grep -Ec '^(cuda|vulkan|metal|hip|opencl)_(emit|validate|link|runtime)_result=(PASS|FAIL|SKIP_UNAVAILABLE)$' "$TMP_DIR/matrix.log")"
test "$result_rows" -eq 20
grep -Fq 'gpu_backend_matrix status=PASS backends=5 layers=20 unique=20 expected=20 pass=20 failures=0 skips=0 runtime=true' \
    "$TMP_DIR/matrix.log"

sh "$CHECK" --targets llvm 2>"$TMP_DIR/cpu-target.err" && exit 1
grep -Fq 'unknown backend target: llvm' "$TMP_DIR/cpu-target.err"

sh "$CHECK" --targets cuda,vulkan --matrix-self-test >"$TMP_DIR/subset.log"
subset_rows="$(grep -Ec '^(cuda|vulkan)_(emit|validate|link|runtime)_result=PASS$' "$TMP_DIR/subset.log")"
test "$subset_rows" -eq 8
grep -Fq 'gpu_backend_matrix status=PASS backends=2 layers=8 unique=8 expected=8 pass=8 failures=0 skips=0 runtime=true' \
    "$TMP_DIR/subset.log"
if grep -Eq '^(metal|hip|opencl)_(emit|validate|link|runtime)_result=' "$TMP_DIR/subset.log"; then
    echo "unrequested GPU backend was included in subset matrix" >&2
    exit 1
fi

GPU_BACKEND_LAYER_PORTABLE_CHECK="$FAKE_PORTABLE" \
GPU_BACKEND_LAYER_BUILD_DIR="$TMP_DIR/unavailable-build" \
    sh "$CHECK" >"$TMP_DIR/unavailable.log"
for backend in cuda vulkan metal hip opencl; do
    grep -Fq "${backend}_emit_result=PASS" "$TMP_DIR/unavailable.log"
    grep -Fq "${backend}_validate_result=SKIP_UNAVAILABLE" "$TMP_DIR/unavailable.log"
    grep -Fq "${backend}_link_result=SKIP_UNAVAILABLE" "$TMP_DIR/unavailable.log"
    grep -Fq "${backend}_runtime_result=SKIP_UNAVAILABLE" "$TMP_DIR/unavailable.log"
done
grep -Fq 'gpu_backend_matrix status=SKIP_UNAVAILABLE backends=5 layers=20 unique=20 expected=20 pass=5 failures=0 skips=15 runtime=false' \
    "$TMP_DIR/unavailable.log"

set +e
FAKE_PORTABLE_MODE=missing-evidence \
GPU_BACKEND_LAYER_PORTABLE_CHECK="$FAKE_PORTABLE" \
GPU_BACKEND_LAYER_BUILD_DIR="$TMP_DIR/missing-evidence-build" \
    sh "$CHECK" --targets hip >"$TMP_DIR/missing-evidence.log"
missing_evidence_code=$?
set -e
test "$missing_evidence_code" -eq 1
grep -Fq 'hip_emit_result=FAIL' "$TMP_DIR/missing-evidence.log"
grep -Fq 'hip_validate_result=FAIL' "$TMP_DIR/missing-evidence.log"
grep -Fq 'hip_link_result=FAIL' "$TMP_DIR/missing-evidence.log"
grep -Fq 'hip_runtime_result=SKIP_UNAVAILABLE' "$TMP_DIR/missing-evidence.log"
grep -Fq 'gpu_backend_matrix status=FAIL backends=1 layers=4 unique=4 expected=4 pass=0 failures=3 skips=1 runtime=false' \
    "$TMP_DIR/missing-evidence.log"

for invalid_targets in '' 'cuda,unknown' 'cuda,cuda' 'cuda,'; do
    set +e
    sh "$CHECK" --targets "$invalid_targets" >"$TMP_DIR/invalid.out" 2>"$TMP_DIR/invalid.err"
    invalid_code=$?
    set -e
    test "$invalid_code" -eq 64
    test -s "$TMP_DIR/invalid.err"
done

echo "gpu-backend-environment-matrix-accounting-test: pass"
