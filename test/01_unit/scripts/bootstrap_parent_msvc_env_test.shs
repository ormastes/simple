#!/bin/sh
# Exercise actual shared setup and Stage2 argv construction without compiling.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM
owner="$root/scripts/bootstrap/bootstrap-from-scratch.sh"
awk '/^cc_abs=""$/{copy=1} /^seed_inputs_fingerprint=/{copy=0} copy{print}' "$owner" >"$work/setup.sh"
awk '/^      cc_abs=\$\{rust_llvm_clang_cl_path\}$/{copy=1} copy{print} copy && /^      export CC$/{exit}' "$owner" >"$work/llvm-override.sh"
awk '/^  bootstrap_run_stage2_native\(\)/{copy=1} copy && /^    # These three guards/{exit} copy{print}' "$owner" >"$work/builder.sh"
cat >>"$work/builder.sh" <<'SH'
    names=$(bootstrap_stage3_env_assignment_names "$@")
    expected=$(bootstrap_stage3_stage2_canonical_env_names "$PLATFORM" '')
    [ "$names" = "$expected" ] || { echo "FAIL: canonical names mismatch: $names" >&2; return 1; }
    count=0
    for assignment in "$@"; do
        case "$assignment" in
            CC=*) [ "$assignment" = "CC=$expected_cc" ]; count=$((count+1)) ;;
            INCLUDE=*) [ "$assignment" = "INCLUDE=$INCLUDE" ]; count=$((count+1)) ;;
            LIB=*) [ "$assignment" = "LIB=$LIB" ]; count=$((count+1)) ;;
            LIBPATH=*) [ "$assignment" = 'LIBPATH=' ]; count=$((count+1)) ;;
        esac
    done
    [ "$count" = 4 ]
}
SH
. "$root/scripts/check/lib/bootstrap-stage3/authority.shs"
. "$root/scripts/check/lib/bootstrap-stage3/command-snapshot.shs"
bootstrap_stage3_target_c_compiler() {
    [ "$1" = x86_64-pc-windows-msvc ] || return 1
    [ "${reject_compiler:-0}" = 0 ] || return 1
    printf '%s\n' 'C:/Program Files/LLVM/bin/clang-cl.exe'
}
# Empty unrelated fixture values still exercise the production assignment names.
stage_build_path= stage_build_rust_log= bootstrap_link_library_path=
bootstrap_link_compat_sha256= simple_abi_policy= SIMPLE_PLUGIN_MANIFEST_POLICY=
SIMPLE_KERNEL_K1_POLICY= SIMPLE_COVERAGE_CUTOVER_STATE= k1_composition_sha256_before=
build_progress_events= stage2_cache_absolute= bootstrap_stage2_darwin_env=
stage2_compatibility_manifest_absolute= stage3_cache_absolute= stage2_seed_absolute=
stage2_cold_init_env=
os=windows PLATFORM_ABI=msvc PLATFORM=x86_64-pc-windows-msvc
bootstrap_windows_abi_env='SIMPLE_WINDOWS_ABI=msvc SIMPLE_LINKER_FLAVOR=msvc'
INCLUDE='C:/Program Files/SDK/include;C:/Other Include'
LIB='C:/Program Files/SDK/lib;C:/Other Lib'
LIBPATH=
. "$work/builder.sh"
for full_bootstrap in 0 1; do
    bootstrap_windows_cc_env= bootstrap_windows_include_env=
    bootstrap_windows_lib_env= bootstrap_windows_libpath_env=
    . "$work/setup.sh"
    expected_cc='C:/Program Files/LLVM/bin/clang-cl.exe'
    if [ "$full_bootstrap" = 1 ]; then
        # Full LLVM authority may replace the initial admitted C driver.
        rust_llvm_clang_cl_path='C:/Pinned LLVM 23/bin/clang-cl.exe'
        . "$work/llvm-override.sh"
        expected_cc=$rust_llvm_clang_cl_path
    fi
    [ "$CC" = "$expected_cc" ]
    bootstrap_run_stage2_native
done
if (reject_compiler=1; . "$work/setup.sh") >"$work/refused.log" 2>&1; then
    echo 'FAIL: invalid compiler authority accepted' >&2; exit 1
fi
grep -q 'no C compiler found for bootstrap target' "$work/refused.log"
echo 'PASS: parent and full MSVC argv retain canonical tools, spaces and empty LIBPATH; invalid compiler fails closed'
