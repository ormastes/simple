#!/usr/bin/env bash
set -euo pipefail

repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
full=$repo/scripts/bootstrap/bootstrap-from-scratch.sh
resume=$repo/scripts/bootstrap/resume-stage3-from-admitted.sh
fixture=$(mktemp -d "${TMPDIR:-/tmp}/stage3-capsule-callers.XXXXXX")
trap 'rm -rf -- "$fixture"' EXIT HUP INT TERM

cat >"$fixture/capsule.shs" <<'CAPSULE'
#!/bin/dash
set -eu
[ "$#" -ge 1 ] && [ "$1" = stage3 ]
shift
printf 'entry=stage3\nargc=%s\n' "$#" >"$CAPSULE_CAPTURE"
for argument in "$@"; do printf 'arg=%s\n' "$argument" >>"$CAPSULE_CAPTURE"; done
CAPSULE
chmod 0500 "$fixture/capsule.shs"

exec {capsule_fd}<"$fixture/capsule.shs"
exec {shell_fd}</usr/bin/dash
capsule_descriptor=/proc/$$/fd/$capsule_fd
shell_descriptor=/proc/$$/fd/$shell_fd

run_caller() {
    local script=$1 origin=$2 capture=$3
    CAPSULE_CAPTURE=$capture \
    BOOTSTRAP_STAGE3_CAPSULE_ENTRY=stage3 \
    BOOTSTRAP_STAGE3_CAPSULE_CALLER_ORIGIN=$origin \
    BOOTSTRAP_STAGE3_CAPSULE_DESCRIPTOR=$capsule_descriptor \
    BOOTSTRAP_STAGE3_CAPSULE_SHELL_DESCRIPTOR=$shell_descriptor \
        /bin/sh "$script" alpha 'beta gamma'
}

run_caller "$full" full "$fixture/full.events"
run_caller "$resume" resume "$fixture/resume.events"
cmp -s "$fixture/full.events" "$fixture/resume.events"
grep -qx 'entry=stage3' "$fixture/full.events"
grep -qx 'argc=2' "$fixture/full.events"
grep -qx 'arg=alpha' "$fixture/full.events"
grep -qx 'arg=beta gamma' "$fixture/full.events"

expect_guard_64() {
    local script=$1 origin=$2 capsule=$3 shell=$4
    set +e
    CAPSULE_CAPTURE=$fixture/rejected.events \
    BOOTSTRAP_STAGE3_CAPSULE_ENTRY=stage3 \
    BOOTSTRAP_STAGE3_CAPSULE_CALLER_ORIGIN=$origin \
    BOOTSTRAP_STAGE3_CAPSULE_DESCRIPTOR=$capsule \
    BOOTSTRAP_STAGE3_CAPSULE_SHELL_DESCRIPTOR=$shell \
        /bin/sh "$script" rejected >/dev/null 2>&1
    local status=$?
    set -e
    [ "$status" -eq 64 ]
    [ ! -e "$fixture/rejected.events" ]
}

expect_guard_64 "$full" resume "$capsule_descriptor" "$shell_descriptor"
expect_guard_64 "$resume" full "$capsule_descriptor" "$shell_descriptor"
for invalid in \
    "/proc/0$$/fd/$capsule_fd" \
    "/proc/$$/fd/0$capsule_fd" \
    "/proc/$$/fd/0" \
    "/proc/$$/fd/${capsule_fd}suffix" \
    "/proc/$$/fd/$capsule_fd/child" \
    "/proc/$$x/fd/$capsule_fd"; do
    expect_guard_64 "$full" full "$invalid" "$shell_descriptor"
    expect_guard_64 "$resume" resume "$invalid" "$shell_descriptor"
done
expect_guard_64 "$full" full "$capsule_descriptor" "/proc/$$/fd/0$shell_fd"
expect_guard_64 "$resume" resume "$capsule_descriptor" "/proc/$$/fd/$shell_fd/x"

printf 'bootstrap Stage3 helper capsule caller parity: PASS (%s)\n' \
    "$(sha256sum "$fixture/full.events" | awk '{print $1}')"
