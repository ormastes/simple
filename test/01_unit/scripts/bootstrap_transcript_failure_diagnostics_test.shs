#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
WORK=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap-transcript-diag.XXXXXX")
trap 'rm -rf "$WORK"' EXIT

. "$ROOT/scripts/check/lib/bootstrap-stage3/authority.shs"
. "$ROOT/scripts/check/lib/bootstrap-stage3/command-snapshot.shs"

mkdir -p "$WORK/tmp"
status=0
bootstrap_stage3_run_transcribed \
    "$WORK/command.transcript" "$ROOT" "$WORK/run.log" \
    "$WORK/missing-home" "$WORK/tmp" /usr/bin:/bin \
    TEST_VALUE=1 -- /usr/bin/true 2>"$WORK/error.log" || status=$?
[ "$status" -eq 1 ] || { echo "FAIL: expected precondition status 1"; exit 1; }
grep -Fq 'bootstrap-transcript-error: non-canonical stage directory:' \
    "$WORK/error.log" || { echo "FAIL: typed precondition diagnostic missing"; exit 1; }
[ ! -e "$WORK/command.transcript" ] || { echo "FAIL: rejected run wrote transcript"; exit 1; }
[ ! -e "$WORK/run.log" ] || { echo "FAIL: rejected run wrote execution log"; exit 1; }

producer="$ROOT/scripts/bootstrap/bootstrap-from-scratch.sh"
remove_line=$(grep -n 'rm -f "${stage2_native_log}"' "$producer" | head -1 | cut -d: -f1)
run_line=$(grep -n '^    bootstrap_stage3_run_transcribed' "$producer" | head -1 | cut -d: -f1)
[ -n "$remove_line" ] && [ -n "$run_line" ] && [ "$remove_line" -lt "$run_line" ] || {
    echo "FAIL: stale Stage 2 log is not removed before transcript admission"
    exit 1
}

watcher="$ROOT/scripts/bootstrap/bootstrap-progress-watch.shs"
grep -Fq 'process_tree_metrics "$watch_pid" "$$" 2>/dev/null || true' "$watcher" || {
    echo "FAIL: MSYS process-scan stderr is not contained"
    exit 1
}

echo "PASS: transcript refusals are diagnosed and cannot reuse stale Stage 2 logs"
