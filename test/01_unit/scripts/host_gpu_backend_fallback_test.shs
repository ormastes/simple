#!/bin/sh
# Exercise the production fallback, both alone and with a strong provider.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
attempt=$(mktemp -d "${TMPDIR:-/tmp}/host-gpu-fallback.XXXXXX")
trap 'rm -rf "$attempt"' EXIT HUP INT TERM
# Compile the actual owner block, without unrelated runtime entrypoints.
printf '#include <stdint.h>\n' >"$attempt/fallback.c"
sed -n '/BEGIN CORE C GPU BACKEND FALLBACK/,/END CORE C GPU BACKEND FALLBACK/p' "$repo/src/runtime/runtime_native.c" >>"$attempt/fallback.c"
grep -q core_c_host_gpu_active_backend_handle "$attempt/fallback.c"
cat >"$attempt/provider.c" <<'EOF'
#include <stdint.h>
int64_t rt_host_gpu_active_backend_handle(void) { return 73; }
EOF
cat >"$attempt/probe.c" <<'EOF'
#include <stdint.h>
#ifndef EXPECTED_HANDLE
#define EXPECTED_HANDLE 0
#endif
extern int64_t rt_host_gpu_active_backend_handle(void);
int main(void) { return rt_host_gpu_active_backend_handle() == EXPECTED_HANDLE ? 0 : 1; }
EOF
if [ "${1:-all}" != merged-only ]; then
for provider in absent present; do
    extra=
    expected=0
    if [ "$provider" = present ]; then
        extra="$attempt/provider.c"
        expected=73
    fi
    if [ "${HOST_GPU_FALLBACK_MSVC:-0}" = 1 ]; then
        # MSYS argument conversion must not rewrite clang-cl's /I and /Fe.
        set -- "$(cygpath -m "$attempt/fallback.c")" "$(cygpath -m "$attempt/probe.c")"
        [ -z "$extra" ] || set -- "$@" "$(cygpath -m "$extra")"
        (cd "$attempt" && MSYS2_ARG_CONV_EXCL='*' "${CC:-clang-cl}" /nologo "/I$(cygpath -m "$repo/src/runtime")" "/DEXPECTED_HANDLE=$expected" "$@" "/Fe$(cygpath -m "$attempt/probe.exe")")
    else
        # extra is either empty or exactly one fixture path, which may contain spaces.
        set -- "$attempt/fallback.c" "$attempt/probe.c"
        [ -z "$extra" ] || set -- "$@" "$extra"
        "${CC:-cc}" -I"$repo/src/runtime" -DEXPECTED_HANDLE="$expected" "$@" -o "$attempt/probe.exe"
    fi
    "$attempt/probe.exe"
    printf 'PASS: GPU fallback provider=%s handle=%s\n' "$provider" "$expected"
done
fi

if [ "${HOST_GPU_FALLBACK_MSVC:-0}" = 1 ]; then
    # Reproduce Rust's merged COFF function section: replacing one public
    # definition with a C strong definition discards the other alias too.
    cat >"$attempt/merged.s" <<'EOF'
.section .text$gpu,"xr",discard,rt_host_gpu_active_backend_handle
.globl rt_host_gpu_active_backend_handle
.def rt_host_gpu_active_backend_handle; .scl 2; .type 32; .endef
rt_host_gpu_active_backend_handle:
.globl rt_vulkan_async_session_supported
.def rt_vulkan_async_session_supported; .scl 2; .type 32; .endef
rt_vulkan_async_session_supported:
    movl $73, %eax
    retq
EOF
    cat >"$attempt/merged-probe.c" <<'EOF'
#include <stdint.h>
extern int64_t rt_host_gpu_active_backend_handle(void);
extern int64_t rt_vulkan_async_session_supported(void);
int main(void) {
    return rt_host_gpu_active_backend_handle() == 73 &&
           rt_vulkan_async_session_supported() == 73 ? 0 : 1;
}
EOF
    MSYS2_ARG_CONV_EXCL='*' clang --target=x86_64-pc-windows-msvc -c "$(cygpath -m "$attempt/merged.s")" -o "$(cygpath -m "$attempt/merged.obj")"
    (cd "$attempt" && MSYS2_ARG_CONV_EXCL='*' "${CC:-clang-cl}" /nologo "$(cygpath -m "$attempt/fallback.c")" "$(cygpath -m "$attempt/merged-probe.c")" "$(cygpath -m "$attempt/merged.obj")" "/Fe$(cygpath -m "$attempt/merged.exe")")
    "$attempt/merged.exe"
    printf 'PASS: merged COFF provider retains both exports\n'
fi
