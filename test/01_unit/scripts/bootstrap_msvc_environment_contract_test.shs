#!/bin/sh
# The MSVC Stage 2 environment must be initialized for both admitted-pure and
# full bootstrap. Exercise the producer's initializer and execution arguments
# directly, then compare their names with the canonical authority list.

set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
producer="${repo_root}/scripts/bootstrap/bootstrap-from-scratch.sh"
authority="${repo_root}/scripts/check/lib/bootstrap-stage3/authority.shs"
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap-msvc-env-contract.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
initializer="${tmp_dir}/initializer.sh"
arguments="${tmp_dir}/arguments.sh"

awk '
  /^cc_abs=""$/ { copy=1; next }
  copy && /^seed_inputs_fingerprint=not-used-by-admitted-stage4-resume$/ {
    found=1
    exit
  }
  copy { print }
  END { if (!found) exit 1 }
' "${producer}" > "${initializer}" || {
  echo "FAIL: could not extract the production shared toolchain initializer" >&2
  exit 1
}

# Extract the exact MSVC argument expansions used by the executed Stage 2
# command. The assignments remain quoted in this fragment, including empty
# LIBPATH, so this checks the production word boundaries as well as the names.
awk '
  /bootstrap_run_stage2_native\(\) \{/ { in_function=1 }
  in_function && !copy && index($0, "${bootstrap_windows_abi_env}") { print "set -- \\"; copy=1 }
  copy {
    line=$0
    if (index(line, "${bootstrap_windows_libpath_env}")) {
      sub(/[[:space:]]*\\[[:space:]]*$/, "", line)
      print line
      found=1
      exit
    }
    print line
  }
  END { if (!found) exit 1 }
' "${producer}" > "${arguments}" || {
  echo "FAIL: could not extract the production Stage 2 MSVC argument fragment" >&2
  exit 1
}

. "${authority}"
platform=x86_64-pc-windows-msvc
canonical_names=$(bootstrap_stage3_stage2_canonical_env_names "${platform}")
expected_windows_names=$(printf '%s\n' "${canonical_names}" | tr ' ' '\n' | awk '
  /^(SIMPLE_WINDOWS_ABI|SIMPLE_LINKER_FLAVOR|CC|INCLUDE|LIB|LIBPATH)$/ {
    printf "%s%s", separator, $0
    separator=" "
  }
')
expected_windows_count=$(printf '%s\n' "${expected_windows_names}" | awk '{ print NF }')

matches_windows_contract() {
  parsed_names=$(bootstrap_stage3_env_assignment_names "$@") || return 1
  actual_windows_names=$(printf '%s\n' "${parsed_names}" | tr ' ' '\n' | awk '
    /^(SIMPLE_WINDOWS_ABI|SIMPLE_LINKER_FLAVOR|CC|INCLUDE|LIB|LIBPATH)$/ {
      printf "%s%s", separator, $0
      separator=" "
    }
  ')
  actual_count=$(printf '%s\n' "${parsed_names}" | awk '{ print NF }')
  [ "${actual_windows_names}" = "${expected_windows_names}" ] &&
    [ "${actual_count}" -eq "${expected_windows_count}" ]
}

run_msvc_environment_case() (
  full_bootstrap=$1
  os=windows
  PLATFORM_ABI=msvc
  PLATFORM=x86_64-pc-windows-msvc
  SIMPLE_WINDOWS_ABI=msvc
  SIMPLE_LINKER_FLAVOR=msvc
  bootstrap_windows_abi_env="SIMPLE_WINDOWS_ABI=${SIMPLE_WINDOWS_ABI} SIMPLE_LINKER_FLAVOR=${SIMPLE_LINKER_FLAVOR}"
  bootstrap_windows_cc_env=
  bootstrap_windows_include_env=
  bootstrap_windows_lib_env=
  bootstrap_windows_libpath_env=
  INCLUDE='C:/Program Files/Microsoft Visual Studio/VC/Include'
  LIB='C:/Program Files/Microsoft Visual Studio/VC/Lib'
  LIBPATH=

  bootstrap_stage3_target_c_compiler() {
    [ "$1" = "${PLATFORM}" ] || return 1
    printf '%s\n' 'C:/Program Files/Microsoft Visual Studio/VC/Tools/Llvm/bin/clang-cl.exe'
  }

  . "${initializer}"
  [ "${CC}" = 'C:/Program Files/Microsoft Visual Studio/VC/Tools/Llvm/bin/clang-cl.exe' ]
  [ "${bootstrap_windows_cc_env}" = "CC=${CC}" ]
  [ "${bootstrap_windows_include_env}" = "INCLUDE=${INCLUDE}" ]
  [ "${bootstrap_windows_lib_env}" = "LIB=${LIB}" ]
  [ "${bootstrap_windows_libpath_env}" = 'LIBPATH=' ]

  . "${arguments}"
  [ "$#" -eq 6 ]
  [ "$3" = "CC=${CC}" ]
  [ "$4" = "INCLUDE=${INCLUDE}" ]
  [ "$5" = "LIB=${LIB}" ]
  [ "$6" = 'LIBPATH=' ]
  matches_windows_contract "$@" || {
    echo "FAIL: ${full_bootstrap} bootstrap produced noncanonical MSVC Stage 2 environment names" >&2
    exit 1
  }

  bootstrap_windows_libpath_env=
  . "${arguments}"
  if matches_windows_contract "$@"; then
    echo "FAIL: missing LIBPATH assignment was admitted" >&2
    exit 1
  fi

  bootstrap_windows_libpath_env='LIBPATH='
  . "${arguments}"
  set -- "$@" UNKNOWN=value
  if matches_windows_contract "$@"; then
    echo "FAIL: unknown environment assignment was admitted" >&2
    exit 1
  fi
)

run_msvc_environment_case 0
run_msvc_environment_case 1
printf '%s\n' 'PASS: Windows MSVC Stage 2 environment contract in normal and full bootstrap'
