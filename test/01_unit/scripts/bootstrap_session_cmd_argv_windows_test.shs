#!/bin/sh
# Windows-only real Job Object helper / native cmd argument regression.
set -eu
case "$(uname -s)" in MSYS*|MINGW*) ;; *) echo 'SKIP: Windows MSYS required'; exit 0 ;; esac
root=${SIMPLE_WINDOWS_CMD_TEST_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)}
# Keep evidence, including genuine NUL-separated pre-helper argv, on failure.
proof=${SIMPLE_WINDOWS_CMD_ARGV_EVIDENCE:-$(mktemp -d)}
mkdir -p "$proof"
guard=$root/scripts/resource/process-tree-rss-watchdog.pl
fail() { echo "FAIL: $*; evidence=$proof" >&2; exit 1; }
run_cmd() {
    name=$1; executable=$2
    status=0
    perl "$guard" --session-mode=new --max-rss-kib=262144 --timeout-seconds=20 \
        --receipt="$proof/$name.receipt" -- "$executable" /d /c \
        'echo SESSION_CMD_MARKER&exit /b 37' >"$proof/$name.stdout" 2>"$proof/$name.stderr" || status=$?
    [ "$status" -eq 37 ] || fail "$name expected exit37 got$status"
    tr -d '\r' <"$proof/$name.stdout" | grep -Fxq SESSION_CMD_MARKER || fail "$name missing actual command marker"
    grep -Fxq 'quiescent=1' "$proof/$name.receipt" || fail "$name not quiescent"
}
run_cmd absolute /c/Windows/System32/cmd.exe
run_cmd mixed_case C:/Windows/System32/CmD.ExE
run_cmd bare cmd.exe
# Read actual recorded wire argv, proving the switches survived before C/sh.
perl -e '
 my $root=shift; my $found=0;
 for my $p (glob "$root/simple-rss-session-*/workload.spec") {
  open my $f,"<:raw",$p or die $!; local $/; my @a=split /\0/,<$f>;
  next unless $a[1] =~ /cmd\.exe$/i;
  die "switches altered before helper" unless $a[2] eq "/d" && $a[3] eq "/c";
  ++$found;
 }
 die "expected three genuine cmd workloads, got $found" unless $found==3;
' "$proof"
# The non-cmd shell route must preserve literal arguments, not interpolate them.
status=0
perl "$guard" --session-mode=new --max-rss-kib=262144 --timeout-seconds=20 \
    --receipt="$proof/posix.receipt" -- /usr/bin/sh -c \
    'test "$1" = '\''space $literal; *'\'' && printf "%s\n" POSIX_ARG_MARKER && exit 23' \
    sh 'space $literal; *' >"$proof/posix.stdout" 2>"$proof/posix.stderr" || status=$?
[ "$status" -eq 23 ] || fail "ordinary shell expected23 got$status"
grep -Fxq POSIX_ARG_MARKER "$proof/posix.stdout" || fail 'ordinary shell argv changed'
grep -Fxq 'quiescent=1' "$proof/posix.receipt" || fail 'ordinary shell not quiescent'
printf 'PASS: native cmd switches and ordinary shell arguments; evidence=%s\n' "$proof"
