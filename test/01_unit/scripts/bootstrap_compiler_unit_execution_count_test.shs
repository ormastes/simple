#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
phase_runner="$root/scripts/bootstrap/bootstrap-phase-verification.shs"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/compiler-unit-execution-count.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

fail() {
  echo "bootstrap_compiler_unit_execution_count_test: FAIL ($*)" >&2
  exit 1
}

for invalid_workers in 00 01 0 13 999999999999999999999999999999 abc; do
  if invalid_output=$(BOOTSTRAP_VERIFY_TEST_WORKERS=$invalid_workers \
      sh "$phase_runner" --phase=stage2 2>&1); then
    fail "invalid worker count was accepted: $invalid_workers"
  fi
  case "$invalid_output" in
    *'test workers must be an integer from 1 to 12'*) ;;
    *) fail "invalid worker count reached later validation: $invalid_workers" ;;
  esac
done

# Exercise the production function without invoking a compiler. Keep the
# extraction narrow so edits to the function are tested here rather than a
# copied implementation drifting independently.
for function_name in validate_test_runner_json_log run_inventory_row run_inventory_rows run_compiler_unit_tests; do
  sed -n "/^${function_name}() {\$/,/^}\$/p" "$phase_runner" \
    >>"$tmp/production-function.sh"
done
grep -Fq 'run_compiler_unit_tests() {' "$tmp/production-function.sh" ||
  fail production-function-not-found
. "$tmp/production-function.sh"

source_root="$tmp/source"
mkdir -p "$source_root/test/01_unit/compiler/loader" \
  "$source_root/scripts/bootstrap" "$tmp/home" "$tmp/cache"
: >"$source_root/test/01_unit/compiler/loader/fixture_spec.spl"
cp "$root/scripts/bootstrap/validate-test-runner-json.pl" \
  "$source_root/scripts/bootstrap/validate-test-runner-json.pl"
cp "$root/scripts/bootstrap/phase3-test-skip-policy.shs" \
  "$source_root/scripts/bootstrap/phase3-test-skip-policy.shs"

cat >"$source_root/scripts/bootstrap/run-process-group-timeout.shs" <<'EOF'
#!/bin/sh
shift 2
exec "$@"
EOF
chmod +x "$source_root/scripts/bootstrap/run-process-group-timeout.shs"

test_runner="$tmp/fake-test-runner"
cat >"$test_runner" <<'EOF'
#!/bin/sh
if [ "${FIXTURE_RESULT:-}" = parallel ]; then
  case " $* " in *' --parallel --max-workers=12 --json '*) ;; *) exit 64 ;; esac
  printf 'start %s\n' "$1" >>"${PARALLEL_EVENTS:?}"
  sleep 2
  printf 'end %s\n' "$1" >>"$PARALLEL_EVENTS"
  case "$1" in
    *fixture_07_spec.spl)
      echo '{"success":false,"spec":{"success":false,"total_passed":0,"total_failed":1,"total_skipped":0,"total_pending":0,"total_duration_ms":0,"groups":[],"files":[]},"spl_doctest":null,"sdoctest":null}'
      ;;
    *)
      echo '{"success":true,"spec":{"success":true,"total_passed":1,"total_failed":0,"total_skipped":0,"total_pending":0,"total_duration_ms":0,"groups":[],"files":[]},"spl_doctest":null,"sdoctest":null}'
      ;;
  esac
  exit 0
fi
case "${FIXTURE_RESULT:?}" in
  pass)
    echo '{"success":true,"spec":{"success":true,"total_passed":1,"total_failed":0,"total_skipped":0,"total_pending":0,"total_duration_ms":0,"groups":[],"files":[]},"spl_doctest":null,"sdoctest":null}'
    ;;
  lookalike)
    printf '%s\n' '{"success":true,"spec":{"success":true,"total_passed":1,"total_failed":0,"total_skipped":0,"total_pending":0,"total_duration_ms":0,"groups":[],"files":[{"path":"\\\"total_passed\\\":1"}]},"spl_doctest":null,"sdoctest":null}'
    ;;
  zero)
    echo '{"success":true,"spec":{"success":true,"total_passed":0,"total_failed":0,"total_skipped":1,"total_pending":0,"total_duration_ms":0,"groups":[],"files":[]},"spl_doctest":null,"sdoctest":null}'
    ;;
  development)
    echo '{"success":true,"spec":{"success":true,"total_passed":0,"total_failed":0,"total_skipped":1,"total_pending":0,"total_duration_ms":0,"groups":[],"files":[]},"spl_doctest":null,"sdoctest":null}'
    ;;
  failed)
    echo '{"success":true,"spec":{"success":false,"total_passed":0,"total_failed":1,"total_skipped":0,"total_pending":0,"total_duration_ms":0,"groups":[],"files":[]},"spl_doctest":null,"sdoctest":null}'
    ;;
  pending)
    echo '{"success":true,"spec":{"success":true,"total_passed":1,"total_failed":0,"total_skipped":0,"total_pending":1,"total_duration_ms":0,"groups":[],"files":[]},"spl_doctest":null,"sdoctest":null}'
    ;;
  outer_false)
    echo '{"success":false,"spec":{"success":true,"total_passed":1,"total_failed":0,"total_skipped":0,"total_pending":0,"total_duration_ms":0,"groups":[],"files":[]},"spl_doctest":null,"sdoctest":null}'
    ;;
  malformed)
    echo '{"success":true,"spec":{"success":true,"total_passed":1'
    ;;
  duplicate)
    echo '{"success":true,"spec":{"success":true,"total_passed":1,"total_failed":0,"total_skipped":0,"total_pending":0,"total_duration_ms":0,"groups":[],"files":[{"total_passed":1}]},"spl_doctest":null,"sdoctest":null}'
    ;;
  overflow)
    echo '{"success":true,"spec":{"success":true,"total_passed":9999999999,"total_failed":0,"total_skipped":0,"total_pending":0,"total_duration_ms":0,"groups":[],"files":[]},"spl_doctest":null,"sdoctest":null}'
    ;;
  absent)
    :
    ;;
  nonzero)
    echo '{"success":true,"spec":{"success":true,"total_passed":1,"total_failed":0,"total_skipped":0,"total_pending":0,"total_duration_ms":0,"groups":[],"files":[]},"spl_doctest":null,"sdoctest":null}'
    exit 17
    ;;
  *) exit 64 ;;
esac
EOF
chmod +x "$test_runner"

compiler_cli="$tmp/fake-cli"
: >"$compiler_cli"
command_owner_receipt="$tmp/command-owner.env"
: >"$command_owner_receipt"
home="$tmp/home"
cache="$tmp/cache"
spec_timeout_seconds=10
test_mode_flag=--sequential
test_worker_flag=
test_workers=1

# The inventory function delegates process measurement to the phase runner's
# outer helper. Keep this focused JSON/count test independent of host rusage.
run_measured_timeout() {
  metric_file=$1
  shift 3
  printf '1\n' >"$metric_file"
  "$@"
}
read_max_rss_kib() { printf '1\n'; }

# The inventory function delegates process measurement to the phase runner's
# outer helper. Keep this focused JSON/count test independent of host rusage.
run_measured_timeout() {
  metric_file=$1
  shift 3
  printf '1\n' >"$metric_file"
  "$@"
}
read_max_rss_kib() { printf '1\n'; }

validate_command_owner_receipt() {
  [ "$1" = "$command_owner_receipt" ]
}

run_case() {
  fixture_result=$1
  expected_status=$2
  case_root="$tmp/case-$fixture_result"
  logs="$case_root/logs"
  mkdir -p "$logs"
  summary="$case_root/summary.env"
  : >"$summary"
  FIXTURE_RESULT=$fixture_result
  export FIXTURE_RESULT
  : >"$source_root/test/01_unit/compiler/loader/fixture_spec.spl"
  if [ "$fixture_result" = development ]; then
    printf '%s\n' '# @tag: in-development' \
      >"$source_root/test/01_unit/compiler/loader/fixture_spec.spl"
  fi
  actual_status=0
  run_compiler_unit_tests "$test_runner" "$command_owner_receipt" ||
    actual_status=$?
  [ "$actual_status" = "$expected_status" ] ||
    fail "$fixture_result-status-$actual_status-want-$expected_status"
}

run_case pass 0
grep -Fq 'task=compiler_unit_tests|result=PASS|status=0' "$summary" ||
  fail passing-row-not-admitted
pass_summary=$summary

# Retry the same work root after a PASS, then make the row process die before
# writing a new result. Neither its old receipt nor its old JSON may be reused.
(
  run_inventory_row() { return 77; }
  logs="$tmp/case-pass/logs"
  summary="$tmp/case-pass/retry-summary.env"
  : >"$summary"
  retry_status=0
  run_compiler_unit_tests "$test_runner" "$command_owner_receipt" ||
    retry_status=$?
  [ "$retry_status" -eq 1 ] || fail "dead retry inherited a prior PASS"
  awk -F '\t' '$2 == "FAIL" && $3 == 96 && $4 == 0 { found=1 } \
    END { exit !found }' "$logs/compiler_unit_tests.inventory.tsv" ||
    fail "dead retry did not retain an explicit failed row"
  grep -Fq 'inventory row worker exited 77' \
    "$logs/compiler_unit_tests.log" ||
    fail "dead retry lost its worker exit evidence"
)

run_case lookalike 0
grep -Fq 'task=compiler_unit_tests|result=PASS|status=0' "$summary" ||
  fail quoted-key-lookalike-rejected

run_case zero 1
awk -F '\t' '$1 ~ /loader\/fixture_spec[.]spl$/ && $2 == "FAIL" && \
  $3 == 94 && $4 == 0 && $5 == 0 && $6 == 0 && $7 == 1 { found=1 } \
  END { exit !found }' "$logs/compiler_unit_tests.inventory.tsv" ||
  fail untagged-zero-execution-row-admitted

run_case development 0
awk -F '\t' '$1 ~ /loader\/fixture_spec[.]spl$/ && $2 == "SKIP" && \
  $3 == 0 && $4 == 0 && $5 == 0 && $6 == 0 && $7 == 1 { found=1 } \
  END { exit !found }' "$logs/compiler_unit_tests.inventory.tsv" ||
  fail tagged-development-row-not-categorized

run_case failed 1
awk -F '\t' '$1 ~ /loader\/fixture_spec[.]spl$/ && $2 == "FAIL" && \
  $3 == 93 && $4 == 1 && $5 == 0 && $6 == 1 { found=1 } \
  END { exit !found }' "$logs/compiler_unit_tests.inventory.tsv" ||
  fail failed-json-row-admitted

run_case pending 1
awk -F '\t' '$1 ~ /loader\/fixture_spec[.]spl$/ && $2 == "FAIL" && \
  $3 == 93 && $4 == 1 { found=1 } END { exit !found }' \
  "$logs/compiler_unit_tests.inventory.tsv" || fail pending-json-row-admitted

for malformed_case in outer_false malformed duplicate overflow absent nonzero; do
  case "$malformed_case" in
    outer_false) expected_row_status=93 ;;
    nonzero) expected_row_status=17 ;;
    *) expected_row_status=91 ;;
  esac
  run_case "$malformed_case" 1
  awk -F '\t' -v wanted="$expected_row_status" \
    '$1 ~ /loader\/fixture_spec[.]spl$/ && $2 == "FAIL" && $3 == wanted \
      { found=1 } END { exit !found }' \
    "$logs/compiler_unit_tests.inventory.tsv" ||
    fail "$malformed_case-row-was-admitted"
done

grep -Fq 'spec_count=1|passed_count=1|skipped_spec_count=0|category_count=2|timeout_count=0|crash_count=0' \
  "$pass_summary" || fail passing-summary-counts-not-exact

find() {
  printf '%s\n' "$source_root/test/01_unit/compiler/loader/fixture_spec.spl"
  return 73
}
run_case discovery 1
grep -Fq 'task=compiler_unit_tests|result=FAIL|status=discovery-error' "$summary" ||
  fail partial-discovery-was-admitted
unset -f find

sort() { return 74; }
run_case sorting 1
grep -Fq 'task=compiler_unit_tests|result=FAIL|status=sort-error' "$summary" ||
  fail failed-sort-was-admitted
unset -f sort

for row_number in 01 02 03 04 05 06 07 08 09 10 11 12 13; do
  : >"$source_root/test/01_unit/compiler/loader/fixture_${row_number}_spec.spl"
done
test_workers=12
test_mode_flag=--parallel
test_worker_flag=--max-workers=12
PARALLEL_EVENTS="$tmp/parallel-events"
export PARALLEL_EVENTS
: >"$PARALLEL_EVENTS"
run_case parallel 1
awk '
  $1 == "start" { active++; started++; if (active > peak) peak=active }
  $1 == "end" { active--; ended++; if (active < 0) bad=1 }
  END { exit !(started == 14 && ended == 14 && active == 0 && peak == 12 && !bad) }
' "$PARALLEL_EVENTS" || fail "12-worker pool did not run exactly 12 concurrent rows"
grep -Fq 'spec_count=14|passed_count=13|timeout_count=0|crash_count=0' \
  "$summary" || fail "parallel row counts were not retained"
awk -F '\t' '$1 ~ /fixture_07_spec[.]spl$/ && $2 == "FAIL" && \
  $3 == 93 && $4 == 1 && $5 == 0 && $6 == 1 { found=1 } \
  END { exit !found }' "$logs/compiler_unit_tests.inventory.tsv" ||
  fail "parallel failed row lost its JSON count"
awk -F '\t' 'NR > 1 { count++; if ($2 == "PASS") passed++ } \
  END { exit !(count == 14 && passed == 13) }' \
  "$logs/compiler_unit_tests.inventory.tsv" ||
  fail "parallel inventory omitted a row"

echo 'bootstrap_compiler_unit_execution_count_test: PASS'
