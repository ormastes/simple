#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)
MUTATION_ROOT="$ROOT/.simple/storage/tmp/tests/tool-storage-roots-mutation"
rm -rf "$MUTATION_ROOT"
mkdir -p "$MUTATION_ROOT"
trap 'rm -rf "$MUTATION_ROOT"' EXIT HUP INT TERM

cp "$ROOT/scripts/tool/storage-roots.shs" "$MUTATION_ROOT/storage-roots.shs"
sed 's#SIMPLE_TOOL_TMP_ROOT=$SIMPLE_WORKTREE_STORAGE_ROOT#SIMPLE_TOOL_TMP_ROOT=$SIMPLE_USER_STORAGE_ROOT#' \
    "$MUTATION_ROOT/storage-roots.shs" > "$MUTATION_ROOT/mutated.shs"

if SIMPLE_USER_STORAGE_ROOT=/user/storage \
   SIMPLE_WORKTREE_STORAGE_ROOT=/worktree/storage \
   sh -c '. "$1"; simple_tool_storage_init "$2" fixture-tool; test "$SIMPLE_TOOL_TMP_ROOT" = /worktree/storage/tmp/tools/fixture-tool' \
      sh "$MUTATION_ROOT/mutated.shs" "$ROOT"; then
    echo "ERROR: user-root temporary-storage mutation survived" >&2
    exit 1
fi

printf 'tool storage roots mutation: PASS\n'
