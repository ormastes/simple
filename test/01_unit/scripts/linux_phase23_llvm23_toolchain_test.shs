#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/linux-llvm-authority.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
mkdir -p "$tmp/llvm/bin" "$tmp/path"
cat >"$tmp/tool" <<'EOF'
#!/bin/sh
name=${0##*/}
case "$name:$*" in
  llvm-config:--prefix) printf '%s\n' "${FAKE_CONFIG_PREFIX:-$SIMPLE_LINUX_PHASE23_LLVM_PREFIX}" ;;
  llvm-config:--version) printf '%s\n' "${FAKE_CONFIG_VERSION:-23.1.1}" ;;
  rustc:*) printf 'rustc test\nLLVM version: %s\n' "${FAKE_RUST_VERSION:-23.1.1}" ;;
  *) version=23.1.1; [ "$name" != "${FAKE_BAD_TOOL:-none}" ] || version=23.1.2
     printf '%s version %s\n' "$name" "$version" ;;
esac
EOF
chmod +x "$tmp/tool"
for tool in clang clang++ llvm-ar ld.lld llvm-config; do cp "$tmp/tool" "$tmp/llvm/bin/$tool"; done
cp "$tmp/tool" "$tmp/path/rustc"
export PATH="$tmp/path:$PATH" SIMPLE_LINUX_PHASE23_LLVM_PREFIX="$tmp/llvm"
export GITHUB_ENV="$tmp/env" GITHUB_PATH="$tmp/path-file"
sh "$root/scripts/check/pin-linux-phase23-llvm23.shs" >"$tmp/good.log" 2>&1
for binding in "LLVM_SYS_231_PREFIX=$tmp/llvm" "LLVM_CONFIG=$tmp/llvm/bin/llvm-config" "CC=$tmp/llvm/bin/clang" "LD=$tmp/llvm/bin/ld.lld"; do
    grep -Fxq "$binding" "$GITHUB_ENV" || { echo "missing binding $binding" >&2; exit 1; }
done
grep -Fxq "$tmp/llvm/bin" "$GITHUB_PATH" || exit 1
reject() {
    label=$1; shift
    : >"$GITHUB_ENV"
    if env "$@" sh "$root/scripts/check/pin-linux-phase23-llvm23.shs" >"$tmp/$label.log" 2>&1; then
        echo "FAIL: accepted $label" >&2; exit 1
    fi
    [ ! -s "$GITHUB_ENV" ] || { echo "FAIL: published rejected $label" >&2; exit 1; }
}
reject old_config FAKE_CONFIG_VERSION=18.1.8
reject newer_minor FAKE_CONFIG_VERSION=23.1.2
reject foreign_prefix FAKE_CONFIG_PREFIX=/unadmitted/llvm
reject wrong_clang FAKE_BAD_TOOL=clang
reject wrong_lld FAKE_BAD_TOOL=ld.lld
reject wrong_rust FAKE_RUST_VERSION=23.1.3
mv "$tmp/llvm/bin/llvm-ar" "$tmp/llvm/bin/llvm-ar.saved"
reject missing_tool FAKE_BAD_TOOL=none
mv "$tmp/llvm/bin/llvm-ar.saved" "$tmp/llvm/bin/llvm-ar"
reject relative_prefix SIMPLE_LINUX_PHASE23_LLVM_PREFIX=relative
printf 'Linux LLVM authority: one valid binding and eight fail-closed scenarios PASS\n'
