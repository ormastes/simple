#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
aggregate="$ROOT/scripts/check/check-sffi-v2-authority.shs"
workflow="$ROOT/.github/workflows/repo-hygiene.yml"
registry="$ROOT/config/check/must_check_gates.sdn"
dispatcher="$ROOT/scripts/check/check-push-must-pass.shs"

test -x "$aggregate"
test "$(grep -c '^run_guard "scripts/audit/.*\.shs"$' "$aggregate")" -eq 46
test "$(sed -n 's/^run_guard "\(scripts\/audit\/.*\.shs\)"$/\1/p' "$aggregate" | sort -u | wc -l | tr -d ' ')" -eq 46

sed -n 's/^run_guard "\(scripts\/audit\/.*\.shs\)"$/\1/p' "$aggregate" |
while IFS= read -r guard; do
    test -f "$ROOT/$guard"
done

grep -Fq 'sh scripts/check/check-sffi-v2-authority.shs' "$workflow"
grep -Fq 'push-sffi-v2-authority, push, true, tree, "sh scripts/check/check-sffi-v2-authority.shs"' "$registry"
grep -Fq "'push-sffi-v2-authority:tree:sh scripts/check/check-sffi-v2-authority.shs')" "$dispatcher"

echo "sffi-v2-authority-gate-test: PASS — 46 unique guards are wired into blocking hook and CI paths"
