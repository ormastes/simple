"""
## Purpose and audience
Purpose: Verify that fixed browser-engine and Engine2D modules no longer emit WM lane boundary violations (WML001/WML002) and that the lint rule catches regressions.
Audience: GUI/WM compositor, browser engine, and tooling engineers.
## Operator workflow
Run with `bin/simple test test/01_unit/scripts/wm_lane_boundary_spec.spl --mode=interpreter`.
## Compatibility and limitations
Exercises `lint_wm_lane_boundary` directly against real repository files and synthetic fixtures.
"""
# @cover src/compiler/90.tools/lint/_LintMain/wm_lane_boundary_lints.spl 60%
# @req REQ-TOOL-WM-LANE-001

use std.spec.*
use std.io_runtime.{file_read}
use compiler.tools.lint.main.{lint_wm_lane_boundary, wm_lane_scope_dirs}

fn _has_code(path: text, content: text, code: text) -> bool:
    for w in lint_wm_lane_boundary(path, content):
        if w.code == code:
            return true
    false

fn _has_message_substring(path: text, content: text, needle: text) -> bool:
    for w in lint_wm_lane_boundary(path, content):
        if w.message.contains(needle):
            return true
    false

describe "WM lane boundary lint reproducer (#176)":
    it "reports zero violations across all fixed renderer and vulkan font modules":
        val clean_paths = [
            "src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer.spl",
            "src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_compose_support.spl",
            "src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_core.spl",
            "src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_core_selectors.spl",
            "src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_core_types.spl",
            "src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_draw_ir.spl",
            "src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_layout.spl",
            "src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_raster.spl",
            "src/lib/gc_async_mut/gpu/engine2d/backend_vulkan_font.spl"
        ]
        for path in clean_paths:
            val content = file_read(path)
            expect(content.len()).to_be_greater_than(0)
            val warnings = lint_wm_lane_boundary(path, content)
            expect(warnings.len()).to_equal(0)

    it "removes sffi.time violations from backend_vulkan_helpers while keeping font timing intact":
        val helpers_path = "src/lib/gc_async_mut/gpu/engine2d/backend_vulkan_helpers.spl"
        val helpers_content = file_read(helpers_path)
        expect(helpers_content.len()).to_be_greater_than(0)
        expect(_has_message_substring(helpers_path, helpers_content, "sffi.time")).to_equal(false)

    it "catches synthetic WML001 host-clock and env imports inside portable lane files":
        val target = "src/lib/gc_async_mut/gpu/browser_engine/sample_renderer.spl"
        val bad_time = "use std.nogc_sync_mut.io.time_ops.{{time_now_micros}}\nfn tick() -> i64:\n    time_now_micros()\n"
        val bad_env = "use std.gc_async_mut.io.mod_stub.{{env_get}}\nfn flag() -> text:\n    env_get(\"TRACE\") ?? \"\"\n"
        val bad_sffi_time = "use std.nogc_sync_mut.sffi.time.{{time_monotonic_ns}}\nfn ns() -> i64:\n    time_monotonic_ns()\n"
        expect(_has_code(target, bad_time, "WML001")).to_equal(true)
        expect(_has_code(target, bad_env, "WML001")).to_equal(true)
        expect(_has_code(target, bad_sffi_time, "WML001")).to_equal(true)

    it "catches synthetic WML002 non-core platform externs in portable lane files":
        val target = "src/os/services/wm/sample_wm_service.spl"
        val bad_extern = "extern fn rt_env_get(k: text) -> text?\nfn read_k() -> text:\n    rt_env_get(\"K\") ?? \"\"\n"
        expect(_has_code(target, bad_extern, "WML002")).to_equal(true)

    it "enumerates the canonical 13 WM/GUI/web/2D scope directories":
        val dirs = wm_lane_scope_dirs()
        expect(dirs.len()).to_equal(13)
        expect(dirs).to_contain("src/app/wm_showcase/")
        expect(dirs).to_contain("src/lib/common/ui/")
        expect(dirs).to_contain("src/lib/gc_async_mut/gpu/browser_engine/")
        expect(dirs).to_contain("src/lib/gc_async_mut/gpu/engine2d/")
        expect(dirs).to_contain("src/os/services/wm/")
