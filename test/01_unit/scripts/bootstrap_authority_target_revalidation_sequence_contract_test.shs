#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
bootstrap_script="$repo_root/scripts/bootstrap/bootstrap-from-scratch.sh"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

line_of() {
  pattern=$1
  nth=${2:-1}
  grep -n -F "$pattern" "$bootstrap_script" | sed -n "${nth}s/:.*//p"
}

assert_before() {
  earlier=$1
  later=$2
  [ -n "$earlier" ] && [ -n "$later" ] || fail "missing sequencing marker"
  [ "$earlier" -lt "$later" ] || fail "authority revalidation occurs after protected use"
}

grep -Fq 'bootstrap_authority_revalidate_target_or_release()' "$bootstrap_script" ||
  fail "missing target revalidation wrapper"
grep -Fq 'portable_lock_release "${rust_target_lock_handle}" || :' "$bootstrap_script" ||
  fail "mismatch wrapper does not clean the nested authority lock"
grep -Fq 'portable_lock_release "${bootstrap_authority_target_lock_handle}" || :' "$bootstrap_script" ||
  fail "mismatch wrapper does not clean the target-root lock"

# This is intentionally a wrapper-sequencing contract, not a helper-only
# identity test: the frozen root must be revalidated after acquisition before
# its runtime/seed paths are consumed, and again directly before publication.
acquire_line=$(line_of 'bootstrap_acquire_rust_authority || exit 1' 3)
runtime_revalidate=$(line_of 'bootstrap_authority_revalidate_target_or_release || exit 1' 5)
runtime_use=$(line_of 'runtime_origin_absolute=$(bootstrap_stage3_physical_directory' 1)
assert_before "$acquire_line" "$runtime_revalidate"
assert_before "$runtime_revalidate" "$runtime_use"

publish_revalidate=$(line_of 'bootstrap_authority_revalidate_target_or_release || exit 1' 3)
publish_line=$(line_of 'bootstrap_stage3_publish_seed_generation' 1)
assert_before "$publish_revalidate" "$publish_line"

post_publish_revalidate=$(line_of 'bootstrap_authority_revalidate_target_or_release || exit 1' 4)
seed_path_use=$(line_of 'seed_bin="${bootstrap_authority_target_root}/bootstrap/simple${exe_suffix}"' 2)
assert_before "$post_publish_revalidate" "$seed_path_use"

echo 'bootstrap_authority_target_revalidation_sequence_contract=true'
