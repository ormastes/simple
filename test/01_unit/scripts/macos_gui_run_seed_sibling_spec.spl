use std.spec
use std.io_runtime.{file_read}

val LAUNCHER = "scripts/gui/macos-gui-run.shs"

describe "macOS GUI launcher diagnostic environment":
    it "passes opt-in std.diag configuration through LaunchServices":
        val source = file_read(LAUNCHER)
        expect(source).to_contain(
            r"<key>SIMPLE_DIAG</key><string>${SIMPLE_DIAG:-}</string>")
        expect(source).to_contain(
            r"<key>SIMPLE_DIAG_FILE</key><string>${SIMPLE_DIAG_FILE:-}</string>")
