#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$root/scripts/check/lib/bootstrap-stage3/memory-admission.shs"

fail() { echo "FAIL: $*" >&2; exit 1; }

# A custom 1 GiB Stage 3 maximum must tighten the default 5.6 GiB tree cap.
stage3_process_max_kib=$((1024 * 1024))
actual=$(bootstrap_stage3_memory_darwin_rss_cap_kib \
  "$stage3_process_max_kib" 5859375) || fail 'custom cap was rejected'
[ "$actual" = "$stage3_process_max_kib" ] || fail "custom cap became $actual"

# The existing tree cap must continue to win when Stage 3 permits more.
actual=$(bootstrap_stage3_memory_darwin_rss_cap_kib 52428800 5859375) ||
  fail 'default Stage 3 cap was rejected'
[ "$actual" = 5859375 ] || fail "tree cap became $actual"

# Invalid configured tree caps must fail closed, including when Stage 3 is lower.
if bootstrap_stage3_memory_darwin_rss_cap_kib 1048576 5859376 >/dev/null; then
  fail 'watchdog-illegal tree cap was accepted'
fi

grep -Fq 'bootstrap_stage3_memory_darwin_rss_cap_kib' \
  "$root/scripts/bootstrap/resume-stage3-from-admitted.sh" ||
  fail 'resume launcher does not call the cap selector'
grep -Fq -- '--max-rss-kib="$stage3_darwin_rss_cap_kib"' \
  "$root/scripts/bootstrap/resume-stage3-from-admitted.sh" ||
  fail 'resume launcher does not pass the selected cap to the watchdog'

echo 'PASS: Darwin Stage 3 RSS watchdog honors the configured process maximum'
