#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$root/scripts/check/lib/bootstrap-stage3/memory-admission.shs"

fail() { echo "FAIL: $*" >&2; exit 1; }

# A custom 1 GiB Stage 3 maximum must tighten the default 5.6 GiB tree cap.
stage3_process_max_kib=$((1024 * 1024))
actual=$(bootstrap_stage3_memory_darwin_rss_cap_kib \
  "$stage3_process_max_kib" 5859375) || fail 'custom cap was rejected'
[ "$actual" = "$stage3_process_max_kib" ] || fail "custom cap became $actual"

# The existing tree cap must continue to win when Stage 3 permits more.
actual=$(bootstrap_stage3_memory_darwin_rss_cap_kib 52428800 5859375) ||
  fail 'default Stage 3 cap was rejected'
[ "$actual" = 5859375 ] || fail "tree cap became $actual"

# Invalid configured tree caps must fail closed, including when Stage 3 is lower.
actual=$(bootstrap_stage3_memory_darwin_rss_cap_kib 52428800 20971520) ||
  fail '20 GiB Darwin ceiling cap was rejected'
[ "$actual" = 20971520 ] || fail "20 GiB ceiling became $actual"
if bootstrap_stage3_memory_darwin_rss_cap_kib 1048576 20971521 >/dev/null; then
  fail 'watchdog-illegal tree cap was accepted'
fi

# Default cap scales as max(11 GiB, min(20 GiB, host_kib / 3)).
gib_bytes=$((1024 * 1024 * 1024))
[ "$(bootstrap_stage3_memory_darwin_default_cap_kib 0)" = 11534336 ] ||
  fail 'unknown Darwin RAM did not fall back to 11534336 KiB'
[ "$(bootstrap_stage3_memory_darwin_default_cap_kib $((24 * gib_bytes)))" = 11534336 ] ||
  fail '24 GiB Darwin host fell below 11534336 KiB floor'
[ "$(bootstrap_stage3_memory_darwin_default_cap_kib $((48 * gib_bytes)))" = 16777216 ] ||
  fail '48 GiB Darwin host did not scale to host_kib/3 (16 GiB)'
[ "$(bootstrap_stage3_memory_darwin_default_cap_kib $((96 * gib_bytes)))" = 20971520 ] ||
  fail '96 GiB Darwin host exceeded 20 GiB ceiling'

# Non-Linux process classification must ignore -c wrapper strings naming
# bootstrap-from-scratch.sh while catching real sibling bootstrap processes.
[ "$(bootstrap_stage3_memory_posix_args_kind 'bash -c "sh scripts/bootstrap/bootstrap-from-scratch.sh --resume"')" = none ] ||
  fail 'bash -c wrapper was misclassified as a bootstrap process'
[ "$(bootstrap_stage3_memory_posix_args_kind 'sh -ec "scripts/bootstrap/bootstrap-from-scratch.sh"')" = none ] ||
  fail 'sh -ec wrapper was misclassified as a bootstrap process'
[ "$(bootstrap_stage3_memory_posix_args_kind '/bin/sh scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap')" = bootstrap ] ||
  fail 'direct bootstrap-from-scratch invocation was missed'

tmp=$(mktemp -d "${TMPDIR:-/tmp}/darwin-admission-snap.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
cat >"$tmp/procs" <<'EOF'
501|1|1024|bash -c "sh scripts/bootstrap/bootstrap-from-scratch.sh --resume-stage3-from-admitted=/tmp/out"
502|1|2048|unrelated process
EOF
SIMPLE_BOOTSTRAP_STAGE3_MEMORY_PLATFORM=Darwin
SIMPLE_BOOTSTRAP_STAGE3_PROCESS_SNAPSHOT="$tmp/procs"
export SIMPLE_BOOTSTRAP_STAGE3_MEMORY_PLATFORM SIMPLE_BOOTSTRAP_STAGE3_PROCESS_SNAPSHOT
bootstrap_stage3_memory_append_processes "$tmp/ev_wrap" ||
  fail 'Darwin snapshot with wrapper cmdline failed process scan'
grep -Fxq 'concurrent_bootstrap_count=0' "$tmp/ev_wrap" ||
  fail 'Darwin admission counted bash -c wrapper as concurrent bootstrap'
printf '%s\n' '503|1|2048|/bin/sh scripts/bootstrap/bootstrap-from-scratch.sh --full-bootstrap' >>"$tmp/procs"
bootstrap_stage3_memory_append_processes "$tmp/ev_peer" ||
  fail 'Darwin snapshot with peer bootstrap failed process scan'
grep -Fxq 'concurrent_bootstrap_count=1' "$tmp/ev_peer" ||
  fail 'Darwin admission missed sibling bootstrap-from-scratch process'
unset SIMPLE_BOOTSTRAP_STAGE3_MEMORY_PLATFORM SIMPLE_BOOTSTRAP_STAGE3_PROCESS_SNAPSHOT

# A clean caller starts a session. Either inherited field selects inherit;
# the watchdog itself rejects a partial pair rather than silently starting new.
unset SIMPLE_BOOTSTRAP_SESSION_ID SIMPLE_BOOTSTRAP_SESSION_EXEC
actual=$(bootstrap_stage3_memory_darwin_session_mode)
[ "$actual" = new ] || fail "clean session mode became $actual"
SIMPLE_BOOTSTRAP_SESSION_ID=123
actual=$(bootstrap_stage3_memory_darwin_session_mode)
[ "$actual" = inherit ] || fail "partial session mode became $actual"
SIMPLE_BOOTSTRAP_SESSION_EXEC=/tmp/bootstrap-session-helper
actual=$(bootstrap_stage3_memory_darwin_session_mode)
[ "$actual" = inherit ] || fail "inherited session mode became $actual"
unset SIMPLE_BOOTSTRAP_SESSION_ID
actual=$(bootstrap_stage3_memory_darwin_session_mode)
[ "$actual" = inherit ] || fail "helper-only session mode became $actual"

grep -Fq 'bootstrap_stage3_memory_darwin_rss_cap_kib' \
  "$root/scripts/bootstrap/resume-stage3-from-admitted.sh" ||
  fail 'resume launcher does not call the cap selector'
grep -Fq -- '--max-rss-kib="$stage3_darwin_rss_cap_kib"' \
  "$root/scripts/bootstrap/resume-stage3-from-admitted.sh" ||
  fail 'resume launcher does not pass the selected cap to the watchdog'
grep -Fq -- '--session-mode="$stage3_darwin_rss_session_mode"' \
  "$root/scripts/bootstrap/resume-stage3-from-admitted.sh" ||
  fail 'resume launcher does not pass the selected session mode to the watchdog'
grep -Fq 'stage3_rss_cap_mode=${SIMPLE_BOOTSTRAP_RSS_CAP_MODE-enforce}' \
  "$root/scripts/bootstrap/resume-stage3-from-admitted.sh" &&
  grep -Fq -- '--rss-cap-mode="$stage3_rss_cap_mode"' \
    "$root/scripts/bootstrap/resume-stage3-from-admitted.sh" ||
  fail 'resume launcher does not preserve explicit monitor mode'
grep -Fq 'bootstrap_stage3_memory_darwin_default_cap_kib' \
  "$root/scripts/bootstrap/resume-stage3-from-admitted.sh" ||
  fail 'resume launcher does not compute host-scaled Darwin default cap'
grep -Fq ': "${SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB:=11534336}"' \
  "$root/scripts/bootstrap/resume-stage3-from-admitted.sh" ||
  fail 'resume launcher does not keep 11 GiB fallback tree cap'

echo 'PASS: Darwin Stage 3 RSS watchdog honors cap and inherited session'
