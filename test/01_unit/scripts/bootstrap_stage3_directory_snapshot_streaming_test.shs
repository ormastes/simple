#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
test_tmp=$(mktemp -d)
trap 'rm -rf "$test_tmp"' EXIT INT TERM

. "$repo_root/scripts/check/lib/bootstrap-stage3/authority.shs"

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

# This is the pre-streaming implementation, retained only as an oracle for
# the public snapshot bytes.  The production helper must continue to emit the
# exact sorted file-hex:executable:sha256 records that provenance manifests
# already bind.
reference_snapshot() {
    perl -MDigest::SHA=sha256_hex -MFile::Find -e '
        use strict;
        use warnings;
        my ($root) = @ARGV;
        my @records;
        find(
            {
                no_chdir => 1,
                wanted => sub {
                    my $absolute = $File::Find::name;
                    return if $absolute eq $root;
                    -l $absolute and die "authority symlink rejected\n";
                    return unless -f $absolute;
                    open my $fh, "<:raw", $absolute or die "open\n";
                    local $/;
                    my $bytes = <$fh>;
                    close $fh or die "close\n";
                    my $relative = substr($absolute, length($root) + 1);
                    push @records, join(
                        ":", "file-hex", unpack("H*", $relative),
                        (-x $absolute ? 1 : 0), sha256_hex($bytes)
                    );
                },
            },
            $root
        );
        @records or die "empty authority\n";
        print join("\n", sort @records), "\n";
    ' "$1" >"$2"
}

fixture="$test_tmp/authority"
mkdir -p "$fixture/nested"
printf 'alpha\n' >"$fixture/plain.txt"
printf 'binary\000bytes\n' >"$fixture/nested/sp ace[1].bin"
printf '#!/bin/sh\necho authority\n' >"$fixture/nested/runner"
chmod 700 "$fixture/nested/runner"
# A fixture larger than the allowed RSS budget proves production hashing does
# not retain whole authority files in memory.
dd if=/dev/zero of="$fixture/large.bin" bs=1048576 count=64 >/dev/null 2>&1

reference="$test_tmp/reference.snapshot"
streamed="$test_tmp/streamed.snapshot"
reference_snapshot "$fixture" "$reference"

if [ "$(uname -s)" = Linux ] && [ -x /usr/bin/time ]; then
    /usr/bin/time -f '%M' sh -c '
        . "$1"
        bootstrap_stage3_directory_snapshot "$2" "$3"
    ' sh "$repo_root/scripts/check/lib/bootstrap-stage3/authority.shs" \
        "$streamed" "$fixture" \
        >"$test_tmp/time.stdout" 2>"$test_tmp/time.stderr" ||
        fail "streaming snapshot failed under RSS probe"
    snapshot_rss_kib=$(sed -n '1p' "$test_tmp/time.stderr")
    case "$snapshot_rss_kib" in
        ''|*[!0-9]*) fail "RSS probe did not emit KiB: $snapshot_rss_kib" ;;
    esac
    [ "$snapshot_rss_kib" -le 32768 ] ||
        fail "streaming snapshot used ${snapshot_rss_kib} KiB for 64 MiB fixture"
else
    bootstrap_stage3_directory_snapshot "$streamed" "$fixture" ||
        fail "streaming snapshot failed"
fi

cmp -s "$reference" "$streamed" ||
    fail "streaming snapshot changed canonical authority records"
before_sha=$(bootstrap_stage3_hash_file "$streamed") || fail "missing before hash"

printf 'mutated\n' >>"$fixture/plain.txt"
bootstrap_stage3_directory_snapshot "$test_tmp/content.snapshot" "$fixture" ||
    fail "content-mutation snapshot failed"
content_sha=$(bootstrap_stage3_hash_file "$test_tmp/content.snapshot") ||
    fail "missing content-mutation hash"
[ "$before_sha" != "$content_sha" ] ||
    fail "content mutation did not change authority snapshot"

chmod 700 "$fixture/plain.txt"
bootstrap_stage3_directory_snapshot "$test_tmp/executable.snapshot" "$fixture" ||
    fail "executable-mutation snapshot failed"
executable_sha=$(bootstrap_stage3_hash_file "$test_tmp/executable.snapshot") ||
    fail "missing executable-mutation hash"
[ "$content_sha" != "$executable_sha" ] ||
    fail "executable mutation did not change authority snapshot"

ln -s plain.txt "$fixture/rejected-link"
if bootstrap_stage3_directory_snapshot "$test_tmp/symlink.snapshot" "$fixture" \
    >/dev/null 2>&1; then
    fail "authority snapshot accepted a symlink"
fi

echo "PASS: bootstrap Stage 3 directory snapshot streams large authorities"
