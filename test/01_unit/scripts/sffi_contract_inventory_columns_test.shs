#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM

cat >"$work/provider.spl" <<'EOF'
@unsafe(reason: "raw checked C provider", capabilities: [ffi])
extern fn rt_c_checked() -> i64

@unsafe(
    reason: "raw checked multiline provider",
    capabilities: [ffi, raw_ptr],
)
extern fn rt_c_multiline() -> i64

@unsafe(reason: "raw close status; false means close failed", capabilities: [ffi])
extern fn rt_false_status() -> bool

extern fn rt_untouched() -> i64

@sffi(abi: "C", contract: "status_out")
extern fn rt_rust_claimed() -> i64
EOF
cat >"$work/backing.tsv" <<'EOF'
symbol	class	scoped_callsites	first_declaring_file	source_languages
rt_c_checked	c_runtime_source_only	1	fixture/provider.spl	c,rust_export
rt_c_multiline	c_runtime_source_only	1	fixture/provider.spl	cxx
rt_false_status	c_runtime_source_only	1	fixture/provider.spl	c_or_cxx_header
rt_rust_claimed	rust_source_feature_gated	1	fixture/provider.spl	rust_export,rust_interpreter
rt_untouched	GENUINELY_MISSING	1	fixture/provider.spl	none_observed
EOF
printf '%s\n' "$work/provider.spl" >"$work/files.txt"

if ! SFFI_CENSUS_INPUT="$work/backing.tsv" \
    SFFI_SOURCE_FILE_LIST="$work/files.txt" \
    sh "$root/scripts/audit/sffi-contract-inventory.shs" \
        "$work/declarations.tsv" "$work/symbols.tsv" >"$work/stdout" 2>"$work/stderr"; then
    cat "$work/stderr" >&2
    exit 1
fi

head -n 1 "$work/declarations.tsv" | grep -Fq 'provider_language'
head -n 1 "$work/declarations.tsv" | grep -Fq 'cryptographic_admission'
# Admission must use the canonical ABI signature as part of its identity.
grep -Fq 'print $2 "\t" $3 "\t" provider' "$root/scripts/audit/sffi-contract-inventory.shs"
grep -Fq 'print $1 "\t" $3 "\t" $2' "$root/scripts/audit/sffi-contract-inventory.shs"
grep -Fq 'admitted[$1 SUBSEP $2 SUBSEP $3]' "$root/scripts/audit/sffi-contract-inventory.shs"
grep -Fq 'admitted[$1 SUBSEP $3 SUBSEP $2]' "$root/scripts/audit/sffi-contract-inventory.shs"
awk -F '\t' '$1 == "rt_c_checked" && $3 == "c,rust_export" && $8 == "tagged" && $10 == "not_admitted" { found=1 } END { exit !found }' "$work/declarations.tsv"
awk -F '\t' '$1 == "rt_c_multiline" && $3 == "cxx" && $8 == "tagged" && $10 == "not_admitted" { found=1 } END { exit !found }' "$work/declarations.tsv"
awk -F '\t' '$1 == "rt_false_status" && $3 == "c_or_cxx_header" && $8 == "tagged" && $9 == "documented" && $10 == "not_admitted" && $11 == "missing" { found=1 } END { exit !found }' "$work/declarations.tsv"
awk -F '\t' '$1 == "rt_rust_claimed" && $3 == "rust_export,rust_interpreter" && $9 == "sffi_metadata" && $10 == "not_admitted" { found=1 } END { exit !found }' "$work/declarations.tsv"
awk -F '\t' '$1 == "rt_untouched" && $3 == "none_observed" && $10 == "untouched" && $6 == 1 { found=1 } END { exit !found }' "$work/symbols.tsv"
grep -Fq 'signed_admitted=0' "$work/stderr"
grep -Fq 'untouched=1' "$work/stderr"
grep -Fq 'SFFI rt_symbol stats: total=5 all_declarations_unsafe_tagged=3 unsafe_tag_incomplete=2 all_declarations_admitted=0 partially_admitted=0 untouched=1' "$work/stderr" || {
    cat "$work/stderr" >&2
    exit 1
}

if SFFI_CENSUS_INPUT="$work/backing.tsv" \
    SFFI_SOURCE_FILE_LIST="$work/files.txt" \
    SFFI_MAX_MIGRATION_REQUIRED=0 \
    sh "$root/scripts/audit/sffi-contract-inventory.shs" \
        "$work/ratchet-declarations.tsv" "$work/ratchet-symbols.tsv" \
        >"$work/ratchet-stdout" 2>"$work/ratchet-stderr"; then
    echo 'FAIL: untouched debt bypassed the migration ratchet' >&2
    exit 1
fi
grep -Fq 'migration=4/0' "$work/ratchet-stderr" || {
    cat "$work/ratchet-stderr" >&2
    exit 1
}

echo 'PASS: SFFI inventory reports all observed provider languages, unsafe, signed/admitted, and untouched state'
