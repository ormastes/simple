#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
test_tmp=$(mktemp -d)
trap 'rm -rf "$test_tmp"' EXIT
. "$repo_root/scripts/check/lib/bootstrap-stage3/authority.shs"

fail() { echo "FAIL: $*" >&2; exit 1; }
mode() { stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1"; }
bound_metadata() {
    perl -e 'my @s=lstat($ARGV[0]); @s or exit 1;
        print((-x $ARGV[0] ? 1 : 0), "\t", ($s[2] & 07777), "\t",
            $s[0], "\t", $s[1], "\t", $s[7], "\t", $s[9], "\t",
            $s[10])' "$1"
}

fixture="$test_tmp/authority"
mkdir -p "$fixture/sub"
newline_name=$(printf 'line\nbreak')
printf 'newline content\n' >"$fixture/sub/$newline_name"
printf 'previous snapshot\n' >"$test_tmp/snapshot"
chmod 640 "$test_tmp/snapshot"
bootstrap_stage3_directory_snapshot "$test_tmp/snapshot" "$fixture"
[ "$(mode "$test_tmp/snapshot")" = 640 ] ||
    fail "newline path lost existing output mode"
(umask 027
 bootstrap_stage3_directory_snapshot "$test_tmp/new-snapshot" "$fixture"
)
[ "$(mode "$test_tmp/new-snapshot")" = 640 ] ||
    fail "newline path ignored output umask"
cmp -s "$test_tmp/snapshot" "$test_tmp/new-snapshot" ||
    fail "newline path changed output records"

# Swap the scanned subtree before the hash phase. A newline-bearing leaf must
# use the same bound worker admission as every other name.
mkdir "$test_tmp/intercept"
real_perl=$(command -v perl)
printf '%s\n' '#!/bin/sh' \
    '"$SNAPSHOT_TEST_REAL_PERL" "$@"' \
    'status=$?' \
    'if [ ! -e "$SNAPSHOT_TEST_MARKER" ]; then' \
    '  mv "$SNAPSHOT_TEST_SUB" "$SNAPSHOT_TEST_MOVED" || exit 1' \
    '  ln -s "$SNAPSHOT_TEST_MOVED" "$SNAPSHOT_TEST_SUB" || exit 1' \
    '  : >"$SNAPSHOT_TEST_MARKER"' \
    'fi' \
    'exit "$status"' >"$test_tmp/intercept/perl"
chmod 755 "$test_tmp/intercept/perl"
if PATH="$test_tmp/intercept:$PATH" \
    SNAPSHOT_TEST_REAL_PERL="$real_perl" \
    SNAPSHOT_TEST_MARKER="$test_tmp/swap.marker" \
    SNAPSHOT_TEST_SUB="$fixture/sub" \
    SNAPSHOT_TEST_MOVED="$test_tmp/moved" \
    bootstrap_stage3_directory_snapshot "$test_tmp/race-snapshot" "$fixture" \
        >/dev/null 2>&1; then
    fail "newline path accepted ancestor substitution"
fi
[ ! -e "$test_tmp/race-snapshot" ] || fail "race published a snapshot"

printf '%s\0' "$test_tmp/moved/$newline_name" >"$test_tmp/paths"
printf '00\t0\t0\t0\t0\t0\t0\t0\n' >"$test_tmp/meta"
if bootstrap_stage3_hash_bound_path_list "$test_tmp/paths" "$test_tmp/meta" \
    "$test_tmp/hashes" 1 "$test_tmp" >/dev/null 2>&1; then
    fail "mismatched identity was accepted"
fi
for worker_dir in "$test_tmp"/hashes.workers.*; do
    [ ! -e "$worker_dir" ] || fail "failed worker leaked its directory"
done

# A failure after the first fork must terminate/reap that child and preserve
# the previously published result. The injected failure is handled by the same
# owner path as an operating-system fork failure.
fork_file="$test_tmp/fork-file"
printf 'fork cleanup\n' >"$fork_file"
printf '%s\0%s\0' "$fork_file" "$fork_file" >"$test_tmp/fork.paths"
fork_metadata=$(bound_metadata "$fork_file")
printf '00\t%s\n01\t%s\n' "$fork_metadata" "$fork_metadata" \
    >"$test_tmp/fork.meta"
printf 'previous fork result\n' >"$test_tmp/fork.hashes"
if BOOTSTRAP_STAGE3_TEST_FORK_FAIL_AT=1 \
    bootstrap_stage3_hash_bound_path_list "$test_tmp/fork.paths" \
        "$test_tmp/fork.meta" "$test_tmp/fork.hashes" 2 "$test_tmp" \
        >/dev/null 2>&1; then
    fail "partial fork failure was accepted"
fi
grep -Fqx 'previous fork result' "$test_tmp/fork.hashes" ||
    fail "partial fork failure replaced the prior result"
for worker_dir in "$test_tmp"/fork.hashes.workers.* \
        "$test_tmp"/fork.hashes.tmp.*; do
    [ ! -e "$worker_dir" ] || fail "partial fork failure leaked temp state"
done

# Deterministically mutate file content after scanning but before workers open
# it. Size/time binding must reject the stale scan and preserve publication.
mutation_fixture="$test_tmp/mutation-authority"
mkdir "$mutation_fixture"
printf 'before\n' >"$mutation_fixture/file"
mkdir "$test_tmp/mutation-intercept"
printf '%s\n' '#!/bin/sh' \
    '"$SNAPSHOT_TEST_REAL_PERL" "$@"' \
    'status=$?' \
    'if [ "$status" -eq 0 ] && [ ! -e "$SNAPSHOT_TEST_MUTATION_MARKER" ]; then' \
    '  printf "content mutated after scan\\n" >>"$SNAPSHOT_TEST_MUTATION_FILE" || exit 1' \
    '  : >"$SNAPSHOT_TEST_MUTATION_MARKER"' \
    'fi' \
    'exit "$status"' >"$test_tmp/mutation-intercept/perl"
chmod 755 "$test_tmp/mutation-intercept/perl"
printf 'previous mutation snapshot\n' >"$test_tmp/mutation.snapshot"
if PATH="$test_tmp/mutation-intercept:$PATH" \
    SNAPSHOT_TEST_REAL_PERL="$real_perl" \
    SNAPSHOT_TEST_MUTATION_MARKER="$test_tmp/mutation.marker" \
    SNAPSHOT_TEST_MUTATION_FILE="$mutation_fixture/file" \
    bootstrap_stage3_directory_snapshot "$test_tmp/mutation.snapshot" \
        "$mutation_fixture" >/dev/null 2>&1; then
    fail "content mutation after scan was accepted"
fi
grep -Fqx 'previous mutation snapshot' "$test_tmp/mutation.snapshot" ||
    fail "content mutation replaced the prior snapshot"

# The descriptor/path tuple is checked again after hashing. Exercise that
# precise boundary deterministically rather than relying on scheduler timing.
post_hash_file="$test_tmp/post-hash-file"
printf 'post hash original\n' >"$post_hash_file"
printf '%s\0' "$post_hash_file" >"$test_tmp/post-hash.paths"
post_hash_metadata=$(bound_metadata "$post_hash_file")
printf '00\t%s\n' "$post_hash_metadata" >"$test_tmp/post-hash.meta"
printf 'previous post-hash result\n' >"$test_tmp/post-hash.hashes"
if BOOTSTRAP_STAGE3_TEST_MUTATE_AFTER_HASH="$post_hash_file" \
    bootstrap_stage3_hash_bound_path_list "$test_tmp/post-hash.paths" \
        "$test_tmp/post-hash.meta" "$test_tmp/post-hash.hashes" 1 \
        "$test_tmp" >/dev/null 2>&1; then
    fail "post-hash content mutation was accepted"
fi
grep -Fqx 'previous post-hash result' "$test_tmp/post-hash.hashes" ||
    fail "post-hash mutation replaced the prior result"

echo "PASS: newline paths, stability binding, and transactional worker cleanup"
