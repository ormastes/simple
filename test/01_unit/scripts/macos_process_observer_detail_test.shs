#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
[ "$(uname -s)" = Darwin ] || { echo 'SKIP: Darwin observer detail'; exit 0; }
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
fail() { echo "FAIL: $*" >&2; exit 1; }
"${CC:-cc}" -Wall -Wextra -Werror -O2 \
    "$root/test/01_unit/scripts/fixture_macos_observer_detail.c" -o "$tmp/detail"
"$tmp/detail" live >"$tmp/live.out" 2>"$tmp/live.err"
grep -Fxq 'R 123 4 123' "$tmp/live.out"
[ ! -s "$tmp/live.err" ] || fail 'successful detail emitted failure diagnostic'
for fault in bsd-before task session bsd-after identity-before identity-after \
    short-bsd-before short-task short-bsd-after; do
    status=0
    "$tmp/detail" "$fault" >"$tmp/fault.out" 2>"$tmp/fault.err" || status=$?
    [ "$status" -eq 89 ] && [ ! -s "$tmp/fault.out" ] || fail "$fault did not fail closed"
    stage=${fault#short-}
    grep -Fq "macos-process-observer: $stage pid=123 " "$tmp/fault.err" || fail "$fault diagnostic lacks attribution"
    case "$fault" in
        identity-*) grep -Fq 'expected=100:42 actual=100:43' "$tmp/fault.err" ;;
        short-*) grep -Fq 'errno=0' "$tmp/fault.err" ;;
        session) grep -Fq 'bytes=-1 errno=1' "$tmp/fault.err" ;;
        *) grep -Fq 'bytes=0 errno=5' "$tmp/fault.err" ;;
    esac
done
# ESRCH at every stage models exit between metadata, first identity, RSS,
# session and second identity. A confirmed zombie is also non-live.
for transition in gone-bsd-before gone-task gone-session gone-bsd-after zombie; do
    "$tmp/detail" "$transition" >"$tmp/gone.out" 2>"$tmp/gone.err"
    grep -Fxq 'R 123 gone' "$tmp/gone.out"
    [ ! -s "$tmp/gone.err" ] || fail "$transition emitted failure diagnostic"
done
echo 'PASS: attributed syscall/short-read/identity failures; exit transitions preserve fail-closed policy'
