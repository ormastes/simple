#!/bin/sh
set -eu
root=build/test-mci-v2-rendering-shell-$$; mkdir -p "$root/input/artifacts"
trap 'rm -rf "$root"' EXIT HUP INT TERM
h=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa; run=render-fixture
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$root/private.pem" >/dev/null 2>&1
openssl pkey -in "$root/private.pem" -pubout -out "$root/public.pem" >/dev/null 2>&1
kh=$(sha256sum "$root/public.pem" | awk '{print $1}'); printf 'policy_schema=mci-rendering-collector-trust-v1\nscope=fixture\ncollector_key_id=fixture-key\ncollector_key_sha256=%s\nload_profile=nominal-exact\nframe_p95_ns=2\nframe_p99_ns=2\nframe_deadline_ns=2\nmax_rss_bytes=3\ncommand_limit=1\nglyph_limit=1\nimage_limit=1\nqueue_limit=1\ninflight_limit=1\n' "$kh" > "$root/trust.env"
ids='packed_generation engine2d_owner gui_parity web_parity cpu_readback device_readback backend_device queue_submit_fence renderdoc allocation_bounds queue_bounds inflight_bounds overflow_rejection fallback_absence atlas_absence interaction latency_rss'
for id in $ids; do printf 'command_%s_sha256=%s\n' "$id" "$(printf 'fixture-%s' "$id" | sha256sum | awk '{print $1}')" >> "$root/trust.env"; done
printf RDOCfixture > "$root/input/artifacts/frame.rdc"; printf 'replay_open=pass\ngeneration=1\n' > "$root/input/artifacts/replay.log"; rh=$(sha256sum "$root/input/artifacts/frame.rdc"|awk '{print $1}'); ph=$(sha256sum "$root/input/artifacts/replay.log"|awk '{print $1}')
{ echo manifest_schema=mci-rendering-collector-manifest-v1; echo artifact_mode=fixture; echo run_id=$run; echo source_hash=$h; echo configuration_hash=$h; echo captured_at_utc_ns=1; echo valid_until_utc_ns=2; echo collector_key_id=fixture-key; echo device_identity=fixture-device; echo rdc_sha256=$rh; echo replay_sha256=$ph;
 for id in $ids; do a=$root/input/artifacts/$id.env; c=$root/input/artifacts/$id.command; printf 'evidence_id=%s\ncommand_id=mci-rendering-%s-v1\nrun_id=%s\nsource_hash=%s\nconfiguration_hash=%s\ncommand=fixture-%s\nexit_code=0\n' "$id" "$id" "$run" "$h" "$h" "$id" > "$c"; ch=$(sha256sum "$c" | awk '{print $1}'); { echo evidence_id=$id; echo run_id=$run; echo source_hash=$h; echo configuration_hash=$h; case $id in packed_generation) echo generation=1; echo composition_sha256=$h; echo state=sealed; echo command_count=1; echo glyph_count=1; echo image_count=1;; engine2d_owner) echo generation=1; echo composition_sha256=$h; echo owner=engine2d;; gui_parity|web_parity) echo generation=1; echo drawir_sha256=$h;; cpu_readback) echo pixel_sha256=$h; echo oracle=exact;; device_readback) echo pixel_sha256=$h; echo matches_cpu_exact=true;; backend_device) echo device_identity=fixture-device; echo synthetic=false;; queue_submit_fence) echo generation=1; echo queue_id=q1; echo submit_id=s1; echo fence_id=f1; echo fence_signaled=true;; renderdoc) echo rdc_path=artifacts/frame.rdc; echo replay_transcript_path=artifacts/replay.log;; allocation_bounds|queue_bounds|inflight_bounds) echo used=1; echo limit=1; echo negative_used=2; echo negative_rejected=true;; overflow_rejection) echo active_state_before_sha256=$h; echo active_state_after_sha256=$h; echo publication_count=0;; fallback_absence) echo fallback_count=0;; atlas_absence) echo drawir_atlas_entry_count=0; echo drawir_cache_entry_count=0;; interaction) echo generation=1; echo events=focus,key_input,pointer_down,pointer_up,click; echo semantic_target_count=5;; latency_rss) echo sample_ns_csv=1,2; echo p95_ns=2; echo p99_ns=2; echo max_rss_bytes=3; echo deadline_negative_ns=3; echo deadline_negative_rejected=true;; esac; } > "$a"; ah=$(sha256sum "$a" | awk '{print $1}'); echo "row=$id|pass|artifacts/$id.command|$ch|artifacts/$id.env|$ah|fixture_producer|measured|negative_checked"; done; } > "$root/input/manifest.env"
openssl dgst -sha256 -sign "$root/private.pem" -out "$root/manifest.sig" "$root/input/manifest.env"
sh scripts/check/check-mci-v2-rendering.shs --contract-fixture --evidence "$root/out" --manifest "$root/input/manifest.env" --manifest-signature "$root/manifest.sig" --collector-key "$root/public.pem" --collector-key-id fixture-key --collector-trust-policy "$root/trust.env" --run-id $run --source-hash $h --configuration-hash $h --captured-at-utc-ns 1 --valid-until-utc-ns 2 --now-utc-ns 1 | grep -F 'rendering_contract_result=CONTRACT_ONLY'
grep -Fqx release_eligible=false "$root/out/artifacts/rendering-v1.evidence"; test ! -e "$root/out/receipts/rendering.unsigned.template"
sed 's/artifact_mode=fixture/artifact_mode=live/' "$root/input/manifest.env" > "$root/input/promoted.env"; openssl dgst -sha256 -sign "$root/private.pem" -out "$root/promoted.sig" "$root/input/promoted.env"
if sh scripts/check/check-mci-v2-rendering.shs --evidence "$root/promoted" --manifest "$root/input/promoted.env" --manifest-signature "$root/promoted.sig" --collector-key "$root/public.pem" --collector-key-id fixture-key --collector-trust-policy "$root/trust.env" --run-id $run --source-hash $h --configuration-hash $h --captured-at-utc-ns 1 --valid-until-utc-ns 2 --now-utc-ns 1 >/dev/null 2>&1; then exit 1; fi
cp "$root/input/manifest.env" "$root/input/tampered.env"; printf '# tamper\n' >> "$root/input/tampered.env"
if sh scripts/check/check-mci-v2-rendering.shs --contract-fixture --evidence "$root/tampered" --manifest "$root/input/tampered.env" --manifest-signature "$root/manifest.sig" --collector-key "$root/public.pem" --collector-key-id fixture-key --collector-trust-policy "$root/trust.env" --run-id $run --source-hash $h --configuration-hash $h --captured-at-utc-ns 1 --valid-until-utc-ns 2 --now-utc-ns 1 >/dev/null 2>&1; then exit 1; fi
# Semantic negative matrix: re-signing cannot make malformed raw evidence pass.
negative_case() {
 name=$1; id=$2; expression=$3
 cp -R "$root/input" "$root/$name-input"; eval "$expression"
 a=$root/$name-input/artifacts/$id.env; old=$(sed -n "s/^row=$id|[^|]*|[^|]*|[^|]*|[^|]*|\([0-9a-f]*\)|.*$/\1/p" "$root/$name-input/manifest.env"); new=$(sha256sum "$a" | awk '{print $1}')
 sed "s/$old/$new/" "$root/$name-input/manifest.env" > "$root/$name-input/negative.manifest"
 openssl dgst -sha256 -sign "$root/private.pem" -out "$root/$name-input/negative.sig" "$root/$name-input/negative.manifest"
 if sh scripts/check/check-mci-v2-rendering.shs --contract-fixture --evidence "$root/$name-out" --manifest "$root/$name-input/negative.manifest" --manifest-signature "$root/$name-input/negative.sig" --collector-key "$root/public.pem" --collector-key-id fixture-key --collector-trust-policy "$root/trust.env" --run-id $run --source-hash $h --configuration-hash $h --captured-at-utc-ns 1 --valid-until-utc-ns 2 --now-utc-ns 1 >"$root/$name.stdout" 2>"$root/$name.stderr"; then exit 1; fi
 grep -Fqx "BLOCKED: artifact semantic inspection failed: $id" "$root/$name.stderr"
}
negative_case pixel-mismatch device_readback "sed -i 's/pixel_sha256=$h/pixel_sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/' '$root/pixel-mismatch-input/artifacts/device_readback.env'"
negative_case bound-over allocation_bounds "sed -i 's/used=1/used=2/' '$root/bound-over-input/artifacts/allocation_bounds.env'"
negative_case bad-rdoc renderdoc "printf FAKEfixture > '$root/bad-rdoc-input/artifacts/frame.rdc'"
negative_case over-budget latency_rss "sed -i 's/sample_ns_csv=1,2/sample_ns_csv=1,3/;s/p95_ns=2/p95_ns=3/;s/p99_ns=2/p99_ns=3/' '$root/over-budget-input/artifacts/latency_rss.env'"
negative_case owner-generation engine2d_owner "sed -i 's/generation=1/generation=2/' '$root/owner-generation-input/artifacts/engine2d_owner.env'"
negative_case parity-hash web_parity "sed -i 's/drawir_sha256=$h/drawir_sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/' '$root/parity-hash-input/artifacts/web_parity.env'"
negative_case queue-id queue_submit_fence "sed -i 's/queue_id=q1/queue_id=bad id/' '$root/queue-id-input/artifacts/queue_submit_fence.env'"
negative_case interaction-set interaction "sed -i 's/focus,key_input,pointer_down,pointer_up,click/focus,click/' '$root/interaction-set-input/artifacts/interaction.env'"
negative_case fallback-count fallback_absence "sed -i 's/fallback_count=0/fallback_count=1/' '$root/fallback-count-input/artifacts/fallback_absence.env'"
negative_case atlas-count atlas_absence "sed -i 's/drawir_atlas_entry_count=0/drawir_atlas_entry_count=1/' '$root/atlas-count-input/artifacts/atlas_absence.env'"
# A rehashed command with the wrong canonical command identity is still rejected.
cp -R "$root/input" "$root/command-input"; sed -i 's/command=fixture-gui_parity/command=true/' "$root/command-input/artifacts/gui_parity.command"; old=$(sed -n 's/^row=gui_parity|[^|]*|[^|]*|\([0-9a-f]*\)|.*$/\1/p' "$root/command-input/manifest.env"); new=$(sha256sum "$root/command-input/artifacts/gui_parity.command"|awk '{print $1}'); sed "s/$old/$new/" "$root/command-input/manifest.env" > "$root/command-input/negative.manifest"; openssl dgst -sha256 -sign "$root/private.pem" -out "$root/command-input/negative.sig" "$root/command-input/negative.manifest"
if sh scripts/check/check-mci-v2-rendering.shs --contract-fixture --evidence "$root/command-out" --manifest "$root/command-input/negative.manifest" --manifest-signature "$root/command-input/negative.sig" --collector-key "$root/public.pem" --collector-key-id fixture-key --collector-trust-policy "$root/trust.env" --run-id $run --source-hash $h --configuration-hash $h --captured-at-utc-ns 1 --valid-until-utc-ns 2 --now-utc-ns 1 >"$root/command.stdout" 2>"$root/command.stderr"; then exit 1; fi
grep -Fqx 'BLOCKED: command receipt invalid: gui_parity' "$root/command.stderr"
# Frozen live template remains byte-shape compatible with the aggregate parser.
grep -Fq 'echo receipt_schema=mci-lane-receipt-v1' scripts/check/check-mci-v2-rendering.shs
grep -Fq 'echo artifact_schema=mci-rendering-evidence-v1' scripts/check/check-mci-v2-rendering.shs
grep -Fq 'echo artifact_mode=live' scripts/check/check-mci-v2-rendering.shs
grep -Fq 'echo release_eligible=true' scripts/check/check-mci-v2-rendering.shs
# Live-shaped output is externally signed and admitted by the real aggregate row.
cp -R "$root/input" "$root/live-input"; sed -i 's/artifact_mode=fixture/artifact_mode=live/' "$root/live-input/manifest.env"
sed 's/scope=fixture/scope=live/' "$root/trust.env" > "$root/live-trust.env"; openssl dgst -sha256 -sign "$root/private.pem" -out "$root/live.sig" "$root/live-input/manifest.env"
sh scripts/check/check-mci-v2-rendering.shs --evidence "$root/aggregate" --manifest "$root/live-input/manifest.env" --manifest-signature "$root/live.sig" --collector-key "$root/public.pem" --collector-key-id fixture-key --collector-trust-policy "$root/live-trust.env" --run-id $run --source-hash $h --configuration-hash $h --captured-at-utc-ns 1 --valid-until-utc-ns 2 --now-utc-ns 1 | grep -F 'rendering_contract_result=PASS'
mkdir -p "$root/aggregate/signatures"; sed 's/attestation=EXTERNAL_SIGNER_SETS_signed-v1/attestation=signed-v1/;s/trusted_key_id=EXTERNAL_SIGNER_KEY_ID/trusted_key_id=producer-key/' "$root/aggregate/receipts/rendering.unsigned.template" | sed '$d' > "$root/rendering.canonical"
cp "$root/rendering.canonical" "$root/aggregate/receipts/rendering.receipt"; printf 'receipt_hash=%s\n' "$(sha256sum "$root/rendering.canonical"|awk '{print $1}')" >> "$root/aggregate/receipts/rendering.receipt"; openssl dgst -sha256 -sign "$root/private.pem" -out "$root/aggregate/signatures/rendering.sig" "$root/rendering.canonical"
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$root/reviewer-private.pem" >/dev/null 2>&1; openssl pkey -in "$root/reviewer-private.pem" -pubout -out "$root/reviewer.pem" >/dev/null 2>&1
if sh scripts/check/check-mci-v2-aggregate.shs --evidence "$root/aggregate" --run-id $run --source-hash $h --configuration-hash $h --now-utc-ns 1 --trusted-key "$root/public.pem" --trusted-key-id producer-key --reviewer-key "$root/reviewer.pem" --reviewer-key-id reviewer-key > "$root/aggregate.report" 2>/dev/null; then exit 1; fi
grep -Fq 'row=rendering|PASS|none|MCI-REN-001,MCI-REN-002,MCI-REN-003,MCI-REN-004,MCI-REN-005,MCI-REN-006,MCI-NFR-011,MCI-NFR-012' "$root/aggregate/aggregate-report-v1.env"
echo 'mci v2 rendering producer contract: PASS'
