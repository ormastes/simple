#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
contract="$root/scripts/bootstrap/bootstrap-scheduler-contract.shs"
supervisor="$root/scripts/bootstrap/bootstrap-strategy.sh"
entrypoint="$root/scripts/bootstrap/bootstrap-from-scratch.sh"
qualifier="$root/scripts/bootstrap/bootstrap-qualify-stage2.shs"
continuation="$root/scripts/bootstrap/resume-stage4-from-admitted.sh"
graph="$root/scripts/bootstrap/bootstrap-graph.sdn"
. "$contract"

scratch=$(mktemp -d "${TMPDIR:-/tmp}/simple-bootstrap-scheduler.XXXXXX")
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
checked=0
fail() { echo "FAIL: $1" >&2; exit 1; }
check() { checked=$((checked + 1)); "$@" || fail "check $checked: $*"; }
reject() { checked=$((checked + 1)); if "$@"; then fail "check $checked unexpectedly accepted: $*"; fi; }
hash() { bootstrap_scheduler_hash_file "$1"; }

check bootstrap_scheduler_validate_graph_contract "$graph"
check sh -n "$supervisor" "$qualifier" "$contract" "$continuation"
check grep -Fq bootstrap_stage3_verify_stage2_admission_receipt "$supervisor"
check grep -Fq bootstrap_stage3_verify_manifest "$supervisor"
check grep -Fq bootstrap_scheduler_verify_lineage_admission "$entrypoint"
check grep -Fq 'SIMPLE_BOOTSTRAP_STAGE2_CLEANUP_MARKER=' "$supervisor"
check grep -Fq 'SIMPLE_BOOTSTRAP_STAGE2_CLEANUP_MARKER' "$entrypoint"
check grep -Fq 'stage2-cleanup.ready' "$qualifier"
check grep -Fq 'ulimit -v' "$supervisor"
reject grep -Eq 'SIMPLE_BOOTSTRAP_SCHEDULER_(SELFTEST|ENGINE|QUALIFIER)' "$supervisor"
reject grep -Fq SIMPLE_BOOTSTRAP_SCHEDULER_RELEASE_ADMITTED "$entrypoint"
reject grep -Eq 'set -- .*--(deploy|release)' "$supervisor"
check grep -Fq simple-bootstrap-promotion-required-v1 "$supervisor"

output="$scratch/output"; generation_dir="$output/scheduler/g1"
mkdir -p "$generation_dir" "$output/stage3/platform/stage2-admitted" \
    "$output/full/platform" "$generation_dir/invalidations"
lease="$generation_dir/generation.lease.env"
cat >"$lease" <<EOF
schema=simple-bootstrap-generation-lease-v1
generation=g1
status=current
EOF
chmod 400 "$lease"; lease_sha=$(hash "$lease")

admission="$output/stage3/platform/stage2-admitted/admission.env"
candidate="$output/stage3/platform/stage2-admitted/simple"
printf 'candidate\n' >"$candidate"
printf 'schema=fixture-admission-v1\nstatus=admitted\n' >"$admission"
gate="$generation_dir/gate.log"
printf 'PASS — 8 case(s) checked\n' >"$gate"
qualification="$generation_dir/qualification.result.env"
cat >"$qualification" <<EOF
schema=simple-bootstrap-qualification-result-v1
generation=g1
status=passed
lease_sha256=$lease_sha
admission_path=$admission
admission_sha256=$(hash "$admission")
candidate_path=$candidate
candidate_sha256=$(hash "$candidate")
gate=check-stage2-hello-world-native-build
gate_log_path=$gate
gate_log_sha256=$(hash "$gate")
EOF
check bootstrap_scheduler_verify_qualification_result "$qualification" g1 \
    "$lease_sha" "$output" "$generation_dir"

sed 's/^gate_log_sha256=.*/gate_log_sha256=bad/' "$qualification" \
    >"$scratch/bad-qualification.env"
reject bootstrap_scheduler_verify_qualification_result \
    "$scratch/bad-qualification.env" g1 "$lease_sha" "$output" "$generation_dir"
outside="$scratch/outside.log"; printf 'PASS — 1 case(s) checked\n' >"$outside"
sed "s|^gate_log_path=.*|gate_log_path=$outside|;s/^gate_log_sha256=.*/gate_log_sha256=$(hash "$outside")/" \
    "$qualification" >"$scratch/escaped-qualification.env"
reject bootstrap_scheduler_verify_qualification_result \
    "$scratch/escaped-qualification.env" g1 "$lease_sha" "$output" "$generation_dir"

provenance="$output/stage3/platform/provenance.env"
stage3_candidate="$output/stage3/platform/simple"
printf 'stage3\n' >"$stage3_candidate"; printf 'schema=fixture-stage3\n' >"$provenance"
stage3_result="$generation_dir/stage3.result.env"
cat >"$stage3_result" <<EOF
schema=simple-bootstrap-stage3-scheduler-result-v1
generation=g1
status=verified
lease_sha256=$lease_sha
provenance_path=$provenance
provenance_sha256=$(hash "$provenance")
candidate_path=$stage3_candidate
candidate_sha256=$(hash "$stage3_candidate")
parent_admission_path=$admission
parent_admission_sha256=$(hash "$admission")
EOF
check bootstrap_scheduler_verify_stage3_result "$stage3_result" g1 \
    "$lease_sha" "$output"
sed 's/^candidate_sha256=.*/candidate_sha256=forged/' "$stage3_result" \
    >"$scratch/forged-stage3.env"
reject bootstrap_scheduler_verify_stage3_result "$scratch/forged-stage3.env" \
    g1 "$lease_sha" "$output"

lineage="$generation_dir/lineage-admission.env"
cat >"$lineage" <<EOF
schema=simple-bootstrap-lineage-admission-v1
generation=g1
status=qualified
bootstrap_output=$output
generation_lease_path=$lease
lease_sha256=$lease_sha
qualification_result_path=$qualification
qualification_result_sha256=$(hash "$qualification")
stage3_result_path=$stage3_result
stage3_result_sha256=$(hash "$stage3_result")
stage3_provenance_path=$provenance
stage3_provenance_sha256=$(hash "$provenance")
stage3_candidate_path=$stage3_candidate
stage3_candidate_sha256=$(hash "$stage3_candidate")
parent_admission_path=$admission
parent_admission_sha256=$(hash "$admission")
ancestor_chain=qualified-untainted
EOF
chmod 400 "$lineage"; lineage_sha=$(hash "$lineage")
check bootstrap_scheduler_verify_lineage_admission "$lineage" g1 \
    "$lease_sha" "$output"
sed 's/^ancestor_chain=.*/ancestor_chain=qualified-but-tainted/' "$lineage" \
    >"$scratch/tainted-lineage.env"
reject bootstrap_scheduler_verify_lineage_admission "$scratch/tainted-lineage.env" \
    g1 "$lease_sha" "$output"

stage4="$output/full/platform/simple"; stage4_provenance="${stage4}.provenance.env"
printf 'stage4\n' >"$stage4"; printf 'schema=fixture-stage4\n' >"$stage4_provenance"
continuation_receipt="$output/stage4-continuation.env"
cat >"$continuation_receipt" <<EOF
schema=simple-bootstrap-stage4-continuation-v1
status=pass
lineage_sha256=$lineage_sha
EOF
continuation_result="$generation_dir/stage4.result.env"
cat >"$continuation_result" <<EOF
schema=simple-bootstrap-stage4-scheduler-result-v1
generation=g1
status=verified
lease_sha256=$lease_sha
publication_status=quarantined
continuation_path=$continuation_receipt
continuation_sha256=$(hash "$continuation_receipt")
lineage_path=$lineage
lineage_sha256=$lineage_sha
stage3_provenance_path=$provenance
stage3_provenance_sha256=$(hash "$provenance")
stage4_path=$stage4
stage4_sha256=$(hash "$stage4")
stage4_provenance_path=$stage4_provenance
stage4_provenance_sha256=$(hash "$stage4_provenance")
EOF
check bootstrap_scheduler_verify_continuation_result "$continuation_result" g1 \
    "$lease_sha" "$output" quarantined
check bootstrap_scheduler_verify_promotion_barrier "$lease" g1 "$lease_sha" \
    input-v1 input-v1 "$lineage" "$lineage_sha" "$output" \
    "$qualification" "$stage3_result" "$continuation_result"
reject bootstrap_scheduler_verify_promotion_barrier "$lease" g1 "$lease_sha" \
    input-v1 source-mutated-during-stage4 "$lineage" "$lineage_sha" "$output" \
    "$qualification" "$stage3_result" "$continuation_result"
cp "$lease" "$scratch/lease.before-race"
sed 's/^status=current$/status=tainted/' "$lease" >"$scratch/lease.raced"
mv "$scratch/lease.raced" "$lease"
reject bootstrap_scheduler_verify_promotion_barrier "$lease" g1 "$lease_sha" \
    input-v1 input-v1 "$lineage" "$lineage_sha" "$output" \
    "$qualification" "$stage3_result" "$continuation_result"
cp "$scratch/lease.before-race" "$lease"
deployed="$output/release/simple"; mkdir -p "$(dirname -- "$deployed")"
cp "$stage4" "$deployed"; stage4_sha=$(hash "$stage4")
deploy_receipt="$output/release/bootstrap-deploy-receipt.env"
deploy_entries="$output/release/deploy-entries.env"
cat >"$deploy_entries" <<EOF
entry_count=1
entry_1_name=simple
entry_1_kind=install
entry_1_mode=755
entry_1_candidate_path=$stage4
entry_1_candidate_sha256=$stage4_sha
entry_1_current_path=$deployed
entry_1_current_sha256=$stage4_sha
entry_1_had_current=false
entry_1_backup_path=$output/release/old.simple
entry_1_backup_sha256=none
EOF
deploy_entries_sha=$(hash "$deploy_entries")
cat >"$deploy_receipt" <<EOF
schema=bootstrap-deploy-receipt-v2
deployment_status=pass
transaction_status=committed
transaction_entries_path=$deploy_entries
transaction_entries_sha256=$deploy_entries_sha
current_path=$deployed
current_sha256=$stage4_sha
stage4_candidate_sha256=$stage4_sha
EOF
check bootstrap_scheduler_verify_deploy_receipt "$deploy_receipt" "$output" \
    "$stage4_sha"
sed 's/^current_sha256=.*/current_sha256=forged/' "$deploy_receipt" \
    >"$scratch/forged-deploy.env"
reject bootstrap_scheduler_verify_deploy_receipt "$scratch/forged-deploy.env" \
    "$output" "$stage4_sha"
printf 'tamper\n' >>"$stage4"
reject bootstrap_scheduler_verify_continuation_result "$continuation_result" g1 \
    "$lease_sha" "$output" quarantined

check bootstrap_scheduler_write_invalidation "$generation_dir/invalidations" \
    g1 stage2 adversarial-parent-failure "$lease_sha"
for node in stage2 stage3 stage4 deploy release; do
    check test "$(bootstrap_scheduler_manifest_value status \
        "$generation_dir/invalidations/$node.env")" = invalidated
done

# End-to-end retirement: barrier drift leaves no qualified/reusable trust state.
check bootstrap_scheduler_retire_generation "$generation_dir" "$output" g1 \
    "$lease" "$lease_sha" "$lineage" "$lineage_sha" \
    final-promotion-barrier-stale input-v1 source-raced policy-v1 policy-raced
check test "$(bootstrap_scheduler_manifest_value status "$lease")" = tainted
check test "$(bootstrap_scheduler_manifest_value status "$lineage")" = invalidated
check test "$(hash "$generation_dir/lineage-admission.revoked.env")" = "$lineage_sha"
check test "$(bootstrap_scheduler_manifest_value status \
    "$generation_dir/failure-manifest.env")" = failed
check test "$(bootstrap_scheduler_manifest_value status \
    "$output/scheduler/current.env")" = failed
reject bootstrap_scheduler_verify_lineage_admission "$lineage" g1 \
    "$lease_sha" "$output"
reject bootstrap_scheduler_verify_promotion_barrier "$lease" g1 "$lease_sha" \
    input-v1 input-v1 "$lineage" "$lineage_sha" "$output" \
    "$qualification" "$stage3_result" "$continuation_result"
reject grep -Eq '^status=qualified' "$lineage" "$output/scheduler/current.env"

# An externally tainted lease is stronger than this supervisor's old current
# hash and must be preserved byte-for-byte while the lineage is still revoked.
external_output="$scratch/external"; external_dir="$external_output/scheduler/g2"
mkdir -p "$external_dir/invalidations"
external_lease="$external_dir/generation.lease.env"
printf 'schema=simple-bootstrap-generation-lease-v1\ngeneration=g2\nstatus=tainted\nreason=external-race\n' >"$external_lease"
external_lease_before=$(hash "$external_lease")
external_lineage="$external_dir/lineage-admission.env"
printf 'schema=simple-bootstrap-lineage-admission-v1\ngeneration=g2\nstatus=qualified\n' >"$external_lineage"
external_lineage_sha=$(hash "$external_lineage")
check bootstrap_scheduler_retire_generation "$external_dir" "$external_output" \
    g2 "$external_lease" stale-old-current-hash "$external_lineage" \
    "$external_lineage_sha" final-promotion-barrier-stale a b c d
check test "$(hash "$external_lease")" = "$external_lease_before"
check test "$(bootstrap_scheduler_manifest_value status "$external_lineage")" = invalidated
check test "$(bootstrap_scheduler_manifest_value status \
    "$external_output/scheduler/current.env")" = failed

# A shipped-entry override is inert: an invalid real-engine option must fail,
# and the attacker-controlled executable must never run.
fake_engine="$scratch/fake-engine.sh"; marker="$scratch/override-ran"
cat >"$fake_engine" <<EOF
#!/bin/sh
touch "$marker"
EOF
chmod +x "$fake_engine"
set +e
SIMPLE_BOOTSTRAP_SCHEDULER_SELFTEST=1 \
SIMPLE_BOOTSTRAP_SCHEDULER_ENGINE="$fake_engine" \
SIMPLE_BOOTSTRAP_SCHEDULER_QUALIFIER="$fake_engine" \
  sh "$supervisor" --strategy=normal --output="$scratch/denied" -- \
    --definitely-invalid >"$scratch/denied.out" 2>"$scratch/denied.err"
override_rc=$?
set -e
check test "$override_rc" -ne 0
check test ! -e "$marker"

echo "bootstrap scheduler contract: PASS ($checked checks)"
