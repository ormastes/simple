#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
wrapper="$root/scripts/bootstrap/bootstrap-from-scratch.sh"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/simple-stage3-evidence-reuse.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

# Exercise the production helper without executing the full bootstrap.
helper="$tmp/archive-helper.sh"
sed -n '/^bootstrap_stage3_archive_prior_evidence() (/,/^)/p' \
  "$wrapper" >"$helper"
. "$helper"

stage3="$tmp/output/stage3/fixture-platform"
cache="$stage3/stage3-native-cache"
memory="$stage3/memory-snapshot-v1.events"
profile="$stage3/phase-profile-v1.events"
generation=stage3-fixture-platform-4242
mkdir -p "$cache"
printf 'cache survives\n' >"$cache/object.cache"
printf 'old memory evidence\n' >"$memory"
printf 'old phase evidence\n' >"$profile"

bootstrap_stage3_archive_prior_evidence "$memory" "$generation" >/dev/null
bootstrap_stage3_archive_prior_evidence "$profile" "$generation" >/dev/null

[ ! -e "$memory" ] && [ ! -L "$memory" ] || \
  fail 'canonical memory evidence still blocks the reused output'
[ ! -e "$profile" ] && [ ! -L "$profile" ] || \
  fail 'canonical phase evidence still blocks the reused output'
[ "$(cat "$memory.prior-to-$generation")" = 'old memory evidence' ] || \
  fail 'prior memory evidence was not preserved'
[ "$(cat "$profile.prior-to-$generation")" = 'old phase evidence' ] || \
  fail 'prior phase evidence was not preserved'
[ "$(cat "$cache/object.cache")" = 'cache survives' ] || \
  fail 'Stage 3 cache changed while evidence was archived'

# The existing production nonexistence gate must now admit the continued run.
[ ! -e "$memory" ] && [ ! -L "$memory" ] || fail 'memory gate rejected continuation'
[ ! -e "$profile" ] && [ ! -L "$profile" ] || fail 'phase gate rejected continuation'

# A foreign symlink remains fail-closed and must not move its target.
target="$tmp/foreign-evidence"
link="$stage3/symlink.events"
printf 'foreign\n' >"$target"
ln -s "$target" "$link"
if bootstrap_stage3_archive_prior_evidence "$link" "$generation" >/dev/null 2>&1; then
  fail 'symlink evidence was archived instead of rejected'
fi
[ -L "$link" ] && [ "$(cat "$target")" = foreign ] || \
  fail 'symlink rejection mutated foreign evidence'

# A generation collision must preserve both the canonical and archived files.
collision="$stage3/collision.events"
printf 'current old\n' >"$collision"
printf 'existing archive\n' >"$collision.prior-to-$generation"
if bootstrap_stage3_archive_prior_evidence \
    "$collision" "$generation" >/dev/null 2>&1; then
  fail 'existing generation archive was overwritten'
fi
[ "$(cat "$collision")" = 'current old' ] || fail 'collision removed canonical evidence'
[ "$(cat "$collision.prior-to-$generation")" = 'existing archive' ] || \
  fail 'collision overwrote archived evidence'

# Pin production ordering: both rotations precede both nonexistence gates.
memory_archive_line=$(grep -n -F '"${stage3_memory_snapshot}" "${stage3_evidence_run_id}" || exit 1' \
  "$wrapper" | sed -n '1s/:.*//p')
profile_archive_line=$(grep -n -F '"${stage3_phase_profile}" "${stage3_evidence_run_id}" || exit 1' \
  "$wrapper" | sed -n '1s/:.*//p')
memory_gate_line=$(grep -n -F '[ ! -e "${stage3_memory_snapshot}" ] && [ ! -L "${stage3_memory_snapshot}" ] || exit 1' \
  "$wrapper" | sed -n '1s/:.*//p')
profile_gate_line=$(grep -n -F '[ ! -e "${stage3_phase_profile}" ] && [ ! -L "${stage3_phase_profile}" ] || exit 1' \
  "$wrapper" | sed -n '1s/:.*//p')
case "$memory_archive_line:$profile_archive_line:$memory_gate_line:$profile_gate_line" in
  *[!0-9:]*|:*|*::*) fail 'production archive/gate markers missing' ;;
esac
[ "$memory_archive_line" -lt "$memory_gate_line" ] || fail 'memory archive follows gate'
[ "$profile_archive_line" -lt "$profile_gate_line" ] || fail 'phase archive follows gate'

echo 'bootstrap_stage3_evidence_reuse_contract_test: PASS'
