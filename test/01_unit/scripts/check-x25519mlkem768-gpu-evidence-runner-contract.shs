#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)"
SCRIPT="$ROOT/scripts/check/build-x25519mlkem768-gpu-evidence-runner.shs"
[ -f "$SCRIPT" ] || exit 1
for token in \
  'stage4_verify_candidate_provenance' \
  'x25519mlkem768-runner-artifact-provenance-v1' \
  'completed_gate=native-runner-build' \
  'artifact_path=$ARTIFACT' \
  'source_path=$RUNNER_SOURCE' \
  'mv "$TMP_ARTIFACT" "$ARTIFACT"' \
  'mv "$TMP_SIDECAR" "$SIDECAR"'; do
  grep -F "$token" "$SCRIPT" >/dev/null || exit 1
done
sh -n "$SCRIPT"
