#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd -P)
PRODUCER="$ROOT/scripts/check/produce-rust-go-benchmark-evidence.shs"

output=$(sh "$PRODUCER" --self-test)
printf '%s\n' "$output" | grep -Fxq 'STATUS: PASS rust-go-benchmark-producer self-test'

fail_case() {
    label=$1; shift
    if sh "$PRODUCER" "$@" >/dev/null 2>&1; then
        echo "FAIL: producer accepted $label" >&2
        exit 1
    fi
}
fail_case too-few-samples --output-dir build/producer-negative --run-id negative --samples 49
fail_case too-many-samples --output-dir build/producer-negative --run-id negative --samples 1001
fail_case unsafe-output --output-dir ../producer-negative --run-id negative
fail_case producer-reviewer-alias --output-dir build/producer-negative --run-id negative --producer-id same --reviewer-key-id same

grep -Fq '[ "$FINGERPRINT" = "$(source_fingerprint "$work/tree-final")" ] || fail head-drift-during-production' "$PRODUCER"
grep -Fq 'external-evidence.unsigned.env' "$PRODUCER"
grep -Fq 'rust-go-benchmark-monotonic-ns.c' "$PRODUCER"
if grep -Fq 'date +%s%N' "$PRODUCER"; then
    echo 'FAIL: realtime date clock used for monotonic evidence' >&2
    exit 1
fi
for validator in check-performance-target-identity.shs check-rust-go-benchmark-build-origin.shs check-rust-go-benchmark-samples.shs; do
    grep -Fq "$validator" "$PRODUCER" || { echo "FAIL: self-test omits $validator" >&2; exit 1; }
done
if grep -Eq 'openssl[[:space:]].*(-sign|-signkey)|reviewer_signature_path=' "$PRODUCER"; then
    echo 'FAIL: producer contains reviewer signing behavior' >&2
    exit 1
fi
for recipe in \
 'simple native-build $FIXTURE_DIR/workload.spl --backend llvm --opt-level=aggressive --strip --output benchmark_simple_executable' \
 'rustc -C opt-level=3 -C codegen-units=1 -C strip=symbols -o benchmark_rust_executable $FIXTURE_DIR/workload.rs' \
 'go build -trimpath -o benchmark_go_executable $FIXTURE_DIR/workload.go'; do
    grep -Fq "$recipe" "$PRODUCER" || { echo "FAIL: missing fixed recipe: $recipe" >&2; exit 1; }
done

echo 'PASS: Rust/Go benchmark evidence producer contract'
