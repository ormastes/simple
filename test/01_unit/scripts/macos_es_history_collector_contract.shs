#!/bin/sh
# Executable, entitlement-free contract for the native EndpointSecurity
# collector state machine and its two-phase build/admission policy.
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)"
SOURCE="$ROOT_DIR/tools/native/macos/simple_es_history_collector.swift"
POLICY="$ROOT_DIR/config/security/macos_gui_es_collector_policy.env"
BUILD="$ROOT_DIR/scripts/check/build-macos-es-history-collector.shs"
ENTITLEMENTS="$ROOT_DIR/config/security/macos_gui_es_collector.entitlements.xml"
fixture_root="$(mktemp -d /tmp/macos-es-collector-contract.XXXXXX)"
trap 'rm -rf "$fixture_root"' EXIT HUP INT TERM

value_of() {
    count="$(grep -c "^$1=" "$2" 2>/dev/null || true)"
    [ "$count" = 1 ] || return 1
    sed -n "s/^$1=//p" "$2"
}

sha256_file() {
    shasum -a 256 "$1" | awk '{print $1}'
}

expect_125() {
    set +e
    "$@" >"$fixture_root/command.out" 2>"$fixture_root/command.err"
    status=$?
    set -e
    [ "$status" = 125 ] || {
        echo "expected unavailable exit 125, got $status: $*" >&2
        exit 1
    }
}

[ "$(uname -s)" = Darwin ]
[ "$(value_of schema "$POLICY")" = simple-macos-es-collector-policy-v3 ]
[ "$(value_of status "$POLICY")" = unavailable ]
[ "$(value_of required_events "$POLICY")" = exec,fork,exit ]
[ "$(value_of signing_identity "$POLICY")" = unassigned ]
[ "$(value_of team_identifier "$POLICY")" = unassigned ]
[ "$(value_of collector_source_path "$POLICY")" = \
    tools/native/macos/simple_es_history_collector.swift ]
[ "$(value_of collector_source_sha256 "$POLICY")" = "$(sha256_file "$SOURCE")" ]
[ "$(value_of collector_build_script_path "$POLICY")" = \
    scripts/check/build-macos-es-history-collector.shs ]
[ "$(value_of collector_build_script_sha256 "$POLICY")" = \
    "$(sha256_file "$BUILD")" ]
[ "$(value_of collector_entitlements_path "$POLICY")" = \
    config/security/macos_gui_es_collector.entitlements.xml ]
[ "$(value_of collector_entitlements_sha256 "$POLICY")" = \
    "$(sha256_file "$ENTITLEMENTS")" ]
[ "$(value_of collector_build_manifest_sha256 "$POLICY")" = unavailable ]
[ "$(value_of collector_output_sha256 "$POLICY")" = unavailable ]
for key in compiler_path compiler_sha256 compiler_version_sha256 sdk_path \
    sdk_version sdk_canonical_name sdk_settings_sha256 target_triple \
    build_argv_sha256 build_environment_sha256 codesign_path codesign_sha256 \
    codesign_version_sha256 codesign_argv_sha256 \
    codesign_environment_sha256; do
    value_of "$key" "$POLICY" >/dev/null
done

# The Swift self-test is compiled into a separate test-only executable. The
# production candidate argv never defines COLLECTOR_SELF_TEST.
self_test_binary="$fixture_root/simple_es_history_collector_self_test"
xcrun --sdk macosx swiftc -D COLLECTOR_SELF_TEST -parse-as-library \
    -lEndpointSecurity -lbsm -framework Security \
    "$SOURCE" -o "$self_test_binary"
"$self_test_binary" |
    grep -Fx 'macOS EndpointSecurity collector self-test: PASS' >/dev/null
! grep -Fq -- '-D COLLECTOR_SELF_TEST' "$BUILD"

# These execute negative prepared/admitted and manifest/output tamper branches.
sh "$BUILD" --self-test |
    grep -Fx 'macOS ES collector snapshot/admission self-test: PASS' >/dev/null

# The checked-in unassigned/unavailable policy can neither build a candidate
# nor admit one for live/full-CLI consumption.
expect_125 sh "$BUILD" --build-candidate
expect_125 sh "$BUILD" --verify

grep -Fq 'com.apple.developer.endpoint-security.client' "$ENTITLEMENTS"
echo "macOS EndpointSecurity collector source contract: PASS"
