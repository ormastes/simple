#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
gate="$repo_root/scripts/check/check-bootstrap-stage2-struct-receiver.shs"
test_dir=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap-receiver-gate-test.XXXXXX")
trap 'rm -rf "$test_dir"' EXIT HUP INT TERM

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

runtime="$test_dir/runtime.a"
: >"$runtime"

if "$gate" "$test_dir/missing" "$runtime" >"$test_dir/missing.log" 2>&1; then
    fail "accepted a missing compiler"
fi

fake_compiler="$test_dir/fake-simple"
cat >"$fake_compiler" <<'FAKE'
#!/bin/sh
set -eu
output=""
while [ "$#" -gt 0 ]; do
    if [ "$1" = "-o" ]; then
        shift
        output=$1
        break
    fi
    shift
done
[ -n "$output" ] || exit 3
cat >"$output" <<'PROBE'
#!/bin/sh
echo "bootstrap struct receiver guard"
PROBE
chmod +x "$output"
FAKE
chmod +x "$fake_compiler"

gate_output=$(cd "$repo_root" && "$gate" "$fake_compiler" "$runtime")
[ "$gate_output" = "bootstrap_stage2_struct_receiver=PASS" ] ||
    fail "valid receiver capability was not admitted"

fake_bad="$test_dir/fake-bad-simple"
sed 's/bootstrap struct receiver guard/bootstrap struct receiver guard failed/' \
    "$fake_compiler" >"$fake_bad"
chmod +x "$fake_bad"
if (cd "$repo_root" && "$gate" "$fake_bad" "$runtime") >"$test_dir/bad.log" 2>&1; then
    fail "accepted an unexpected receiver probe result"
fi

echo "bootstrap_stage2_struct_receiver_gate_cases=3"
echo "bootstrap_stage2_struct_receiver_gate_status=PASS"
