#!/bin/sh
set -eu
PATH=/usr/bin:/bin:$PATH
export PATH

spec=${DYNAMIC_LOADER_SPEC:-test/01_unit/compiler/backend_plugin/dynamic_loader_spec.spl}
fixture=${DYNAMIC_LOADER_FIXTURE_BUILDER:-test/fixtures/backend_plugin/build_dynamic_loader_fixtures.sh}

[ -f "$spec" ] || { echo "missing dynamic loader spec: $spec" >&2; exit 1; }
[ -f "$fixture" ] || { echo "missing dynamic loader fixture builder" >&2; exit 1; }

if grep -F 'source text' "$spec" >/dev/null ||
   grep -F 'DYNAMIC_LOADER_SOURCE' "$spec" >/dev/null; then
    echo "dynamic loader acceptance is still source-text pinned" >&2
    exit 1
fi

for marker in \
    'load_dynamic_backend_plugin_lease(provider_path)' \
    'BACKEND_PLUGIN_MISSING_SYMBOL' \
    'lease.close()' \
    'lease.admitted_handle()).to_equal(0)' \
    'expect(lease.build_id).to_equal(selected_build_id)' \
    'file_read(unload_marker)).to_equal("unloaded\\n")' \
    'file_hash_sha256_or_empty(staged.staged_path)' \
    'dir_exists(staging_dir)).to_be(false)'
do
    grep -F "$marker" "$spec" >/dev/null || {
        echo "missing real-execution oracle: $marker" >&2
        exit 1
    }
done

grep -F 'loaded_build_id != staged.build_id' \
    src/compiler/70.backend/backend_plugin/dynamic_loader.spl >/dev/null || {
    echo "missing post-load digest negative-control boundary" >&2
    exit 1
}

grep -F 'dynamic_loader_provider_v1.c' "$fixture" >/dev/null
grep -F 'dynamic_loader_missing_symbol.c' "$fixture" >/dev/null
grep -F 'clang+llvm-23.1.1-x86_64-pc-windows-msvc/bin/clang-cl.exe' "$fixture" >/dev/null
grep -F 'D43B7FA07B5B77B716E60600AD2792CFB2EEB370AECB6144BF6C698F2C6D7467' "$fixture" >/dev/null

echo 'dynamic_loader_real_execution_contract_test: PASS'
