#!/bin/sh
set -eu

semantic='src/compiler/35.semantics/semantic_scope_contribution_v1.spl'
writer='src/compiler/80.driver/cache/gateway/semantic_scope_authority_v1.spl'
cache_writer='src/compiler/80.driver/cache/gateway/cache_writer_v1.spl'
summary='src/compiler/00.common/cache_contract/public_summary_v1.spl'
attempt='src/compiler/80.driver/cache/closure/three_payload_closure_packer_v2.spl'
spec='test/01_unit/compiler/cache/semantic_scope_authority_v1_spec.spl'

grep -Fq 'struct SemanticScopeContributionAuthorityV1:' "$semantic"
grep -Fq 'struct CacheSemanticScopeV1:' "$writer"
grep -Fq 'struct CacheSemanticCompletenessV1:' "$writer"

if rg -n '^pub struct (SemanticScopeContributionAuthorityV1|CacheSemanticScopeV1|CacheSemanticCompletenessV1):' "$semantic" "$writer"; then
    echo 'semantic scope authority constructor is public' >&2
    exit 1
fi

grep -Fq 'pub fn semantic_scope_contribution_port_available_v1() -> bool:' "$semantic"
grep -Fq 'pub fn semantic_scope_authority_available_v1() -> bool:' "$writer"
grep -Fq 'pub fn writer_semantic_scope_preflight_v1(' "$writer"
grep -Fq 'pub fn writer_begin_semantic_scope_v1(' "$writer"
grep -Fq 'pub fn writer_seal_semantic_completeness_v1(' "$writer"
grep -Fq 'pub fn writer_validate_semantic_completeness_v1(' "$writer"
grep -Fq 'pub fn writer_validate_live_semantic_scope_v1(' "$cache_writer"
grep -Fq 'pub fn public_summary_validate_live_set_v1(' "$summary"
grep -Fq 'public_summary_reverse_navigation_digest_v2(' "$summary"
grep -Fq 'pub fn prepared_attempt_validate_live_v1(' "$attempt"
grep -Fq 'pub fn semantic_owner_validate_live_contribution_v1(' "$semantic"
grep -Fq 'pub fn writer_validate_semantic_scope_owner_ports_v1(' "$writer"
grep -Fq 'writer_validate_live_semantic_scope_v1(' "$writer"
grep -Fq 'public_summary_validate_live_set_v1(' "$writer"
grep -Fq 'prepared_attempt_validate_live_v1(' "$writer"
grep -Fq 'semantic_owner_validate_live_contribution_v1(' "$writer"
grep -Fq 'semantic_scope_live_requests_coherent_v1(' "$writer"
grep -Fq 'prepared_attempt_validate_live_v1(attempt_request,' "$spec"
grep -Fq 'tampered.source_bytes = [0 as u8]' "$spec"
grep -Fq 'writer_validate_semantic_scope_owner_ports_v1(value.binding,' "$spec"
grep -Fq 'generation_manifest_digest_v1(manifest) != binding.root.manifest_digest' "$writer"
grep -Fq 'semantic_scope_dependency_enumeration_valid_v1(dependencies)' "$writer"
grep -Fq 'case MacroExpansion | GenericBody | TraitDefaultBody: return false' "$writer"
grep -Fq 'case ConstBody | MacroBody | GenericBody | DefaultTraitBody | AdviceBody:' "$writer"
grep -Fq 'pub fn semantic_scope_worker_activation_available_v1() -> bool: false' "$writer"
grep -Fq 'pub fn semantic_scope_publication_activation_available_v1() -> bool: false' "$writer"

if rg -n 'publish_three_payload_generation_v1\(|three_payload_worker_execute|pass_todo' \
        "$semantic" "$writer" "$cache_writer" "$summary" "$attempt"; then
    echo 'semantic scope slice activates publication/worker or contains a stub' >&2
    exit 1
fi

echo 'portable semantic scope authority contract: PASS'
