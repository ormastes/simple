#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
runner=${RISCV_CALIBRATION_RUNNER_UNDER_TEST:-"$repo_root/test/riscv_isa_gate/run_calibration.sh"}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

fake_root="$tmp/relocated repo"
fake_bin="$tmp/bin"
mkdir -p "$fake_root/test/riscv_isa_gate" "$fake_root/build/vhdl/rv32" "$fake_bin"
cp "$runner" "$fake_root/test/riscv_isa_gate/run_calibration.sh"

cat >"$fake_bin/ghdl" <<'EOF'
#!/bin/sh
printf '%s\n' "$PWD" >>"$RISCV_CALIBRATION_PWD_LOG"
case "$*" in
    *tb_calibration_retire*) echo CALIBRATION_PASS=RETIRE_LOW_DETECTED ;;
    *tb_calibration_alu*) echo CALIBRATION_PASS=ALU_CORRUPTION_DETECTED ;;
    *tb_calibration_bus*) echo CALIBRATION_PASS=BUS_STALL_DETECTED ;;
    *tb_calibration_pmp*) echo CALIBRATION_SKIP=PMP_NOT_IMPLEMENTED ;;
    *tb_calibration_hash*) echo CALIBRATION_REQ=HASH_VERIFICATION ;;
    *) exit 64 ;;
esac
EOF
chmod +x "$fake_bin/ghdl"

default_log="$tmp/default.pwd"
(
    cd /
    PATH="$fake_bin:$PATH" RISCV_CALIBRATION_PWD_LOG="$default_log" \
        "$fake_root/test/riscv_isa_gate/run_calibration.sh" >"$tmp/default.out"
)
[ "$(sort -u "$default_log")" = "$fake_root/build/vhdl/rv32" ] || {
    echo "default repository-relative build path was not used" >&2
    exit 1
}
grep -Fq 'Calibration Suite Summary' "$tmp/default.out"

override_root="$tmp/override root"
gate_override_root="$tmp/gate override root"
override_gate="$tmp/override gate"
override_build="$tmp/override build"
mkdir -p "$override_root/test/riscv_isa_gate" "$override_root/build/vhdl/rv32" \
    "$gate_override_root" "$override_gate" "$override_build"
root_override_log="$tmp/root-override.pwd"
(
    cd /
    PATH="$fake_bin:$PATH" RISCV_CALIBRATION_PWD_LOG="$root_override_log" \
        RISCV_ISA_GATE_REPO_ROOT="$override_root" \
        "$fake_root/test/riscv_isa_gate/run_calibration.sh" >"$tmp/root-override.out"
)
[ "$(sort -u "$root_override_log")" = "$override_root/build/vhdl/rv32" ] || {
    echo "explicit repository-root override was not used" >&2
    exit 1
}

override_log="$tmp/override.pwd"
(
    cd /
    PATH="$fake_bin:$PATH" RISCV_CALIBRATION_PWD_LOG="$override_log" \
        RISCV_ISA_GATE_REPO_ROOT="$gate_override_root" \
        RISCV_ISA_GATE_DIR="$override_gate" \
        RISCV_ISA_GATE_BUILD_DIR="$override_build" \
        "$fake_root/test/riscv_isa_gate/run_calibration.sh" >"$tmp/override.out"
)
[ "$(sort -u "$override_log")" = "$override_build" ] || {
    echo "explicit build-directory override was not used" >&2
    exit 1
}

if (
    cd /
    PATH="$fake_bin:$PATH" RISCV_CALIBRATION_PWD_LOG="$tmp/missing-gate.pwd" \
        RISCV_ISA_GATE_REPO_ROOT="$override_root" \
        RISCV_ISA_GATE_DIR="$tmp/absent gate" \
        "$fake_root/test/riscv_isa_gate/run_calibration.sh"
) >"$tmp/missing-gate.out" 2>"$tmp/missing-gate.err"; then
    echo "missing gate directory was accepted" >&2
    exit 1
fi
grep -Fq 'RISC-V ISA gate directory not found' "$tmp/missing-gate.err"

if (
    cd /
    PATH="$fake_bin:$PATH" RISCV_CALIBRATION_PWD_LOG="$tmp/missing-build.pwd" \
        RISCV_ISA_GATE_REPO_ROOT="$override_root" \
        RISCV_ISA_GATE_BUILD_DIR="$tmp/absent build" \
        "$fake_root/test/riscv_isa_gate/run_calibration.sh"
) >"$tmp/missing-build.out" 2>"$tmp/missing-build.err"; then
    echo "missing build directory was accepted" >&2
    exit 1
fi
grep -Fq 'RISC-V ISA build directory not found' "$tmp/missing-build.err"

if grep -Fq '/home/ormastes/dev/pub/simple' "$runner"; then
    echo "legacy developer checkout path remains" >&2
    exit 1
fi

echo "PASS: RISC-V calibration paths resolve independently of invocation cwd"
