#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)"
cd "$ROOT_DIR"

TMP_DIR="$(mktemp -d /tmp/simple-cpu-backend-result-test.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT HUP INT TERM

SIMPLE_BIN="$TMP_DIR/missing-simple" BUILD_DIR="$TMP_DIR/build-optional" \
    sh scripts/check/check-cpu-backend-artifacts.shs --backend llvm \
    >"$TMP_DIR/optional.log" 2>&1
grep -Fq 'backend=llvm step=emit backend IR status=SKIP_UNAVAILABLE reason=simple-binary-unavailable' \
    "$TMP_DIR/optional.log"
grep -Fq 'cpu_backend_matrix status=SKIP_UNAVAILABLE' "$TMP_DIR/optional.log"
if grep -Fq 'status=PASS' "$TMP_DIR/optional.log"; then
    echo "missing compiler was incorrectly reported as PASS" >&2
    exit 1
fi

SIMPLE_BIN="$TMP_DIR/missing-simple" BUILD_DIR="$TMP_DIR/build-all" \
    sh scripts/check/check-cpu-backend-artifacts.shs --backend all \
    >"$TMP_DIR/all.log" 2>&1
for backend in llvm cranelift wasm; do
    for stage in \
        "emit backend IR" "validate backend IR" "emit object" \
        "validate object" "link artifact" "run or read back"
    do
        row_count="$(grep -Fc "backend=$backend step=$stage status=SKIP_UNAVAILABLE reason=simple-binary-unavailable" "$TMP_DIR/all.log")"
        test "$row_count" -eq 1
    done
done
result_rows="$(grep -Ec '^backend=(llvm|cranelift|wasm) step=.* status=(PASS|FAIL|SKIP_UNAVAILABLE) ' "$TMP_DIR/all.log")"
test "$result_rows" -eq 18
grep -Fq 'cpu_backend_matrix status=SKIP_UNAVAILABLE failures=0 skips=18 require_all=0' \
    "$TMP_DIR/all.log"

RUST_SEED="$TMP_DIR/simple-seed"
printf '%s\n' '#!/bin/sh' 'echo "simple bootstrap seed only"' >"$RUST_SEED"
chmod +x "$RUST_SEED"
SIMPLE_BIN="$RUST_SEED" BUILD_DIR="$TMP_DIR/build-seed" \
    sh scripts/check/check-cpu-backend-artifacts.shs --backend wasm \
    >"$TMP_DIR/seed.log" 2>&1
grep -Fq 'backend=wasm step=emit backend IR status=SKIP_UNAVAILABLE reason=rust-seed-forbidden' \
    "$TMP_DIR/seed.log"
grep -Fq 'cpu_backend_matrix status=SKIP_UNAVAILABLE failures=0 skips=6 require_all=0' \
    "$TMP_DIR/seed.log"

set +e
SIMPLE_BIN="$TMP_DIR/missing-simple" BUILD_DIR="$TMP_DIR/build-required" \
    sh scripts/check/check-cpu-backend-artifacts.shs --backend llvm --require-all \
    >"$TMP_DIR/required.log" 2>&1
required_code=$?
set -e
test "$required_code" -ne 0
grep -Fq 'cpu_backend_matrix status=FAIL failures=0 skips=6 require_all=1' \
    "$TMP_DIR/required.log"
required_rows="$(grep -Ec '^backend=llvm step=.* status=SKIP_UNAVAILABLE reason=simple-binary-unavailable ' "$TMP_DIR/required.log")"
test "$required_rows" -eq 6

set +e
CPU_BACKEND_REQUIRE_ALL=1 SIMPLE_BIN="$TMP_DIR/missing-simple" BUILD_DIR="$TMP_DIR/build-required-env" \
    sh scripts/check/check-cpu-backend-artifacts.shs --backend wasm \
    >"$TMP_DIR/required-env.log" 2>&1
required_env_code=$?
set -e
test "$required_env_code" -ne 0
grep -Fq 'cpu_backend_matrix status=FAIL failures=0 skips=6 require_all=1' \
    "$TMP_DIR/required-env.log"

set +e
sh scripts/check/check-cpu-backend-artifacts.shs --backend unknown \
    >"$TMP_DIR/invalid.log" 2>&1
invalid_code=$?
set -e
test "$invalid_code" -eq 2

echo "cpu-backend-artifact-environment-result-test: pass"
