#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
bootstrap="$root/scripts/bootstrap/bootstrap-from-scratch.sh"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

block=$(sed -n '/Stage 2: compiler tests/,/Stage 2 compiler tests exited 0/p' "$bootstrap")

grep -Fq 'SIMPLE_PROCESS_TREE_OBSERVATION_BUDGET_MS="${SIMPLE_PROCESS_TREE_OBSERVATION_BUDGET_MS:-60000}"' "$bootstrap" ||
  fail 'full bootstrap owner lacks the bounded 60-second observation default'

grep -Fq 'export SIMPLE_PROCESS_TREE_OBSERVATION_BUDGET_MS' "$bootstrap" ||
  fail 'full bootstrap owner does not export its observation budget'

printf '%s\n' "$block" |
  grep -Fq 'SIMPLE_PROCESS_TREE_OBSERVATION_BUDGET_MS="${SIMPLE_PROCESS_TREE_OBSERVATION_BUDGET_MS:-10000}"' ||
  fail 'Stage 2 compiler verification lacks the bounded 10-second observation default'

printf '%s\n' "$block" |
  grep -Eq 'export .*SIMPLE_PROCESS_TREE_OBSERVATION_BUDGET_MS|BOOTSTRAP_STAGE2_TEST_DELEGATE SIMPLE_PROCESS_TREE_OBSERVATION_BUDGET_MS' ||
  fail 'Stage 2 compiler verification does not export the observation budget'

grep -Fq "\$ENV{SIMPLE_PROCESS_TREE_OBSERVATION_BUDGET_MS}" \
  "$root/scripts/resource/process-tree-rss-watchdog.pl" ||
  fail 'RSS watchdog no longer consumes the explicit observation budget'

echo 'PASS: full bootstrap and Stage 2 verification preserve bounded observer policy'
