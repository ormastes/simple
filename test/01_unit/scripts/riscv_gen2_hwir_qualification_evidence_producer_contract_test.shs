#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
SCRIPT=$ROOT_DIR/scripts/check/produce-riscv-gen2-hwir-qualification-evidence.shs
SCOPE=$ROOT_DIR/scripts/check/riscv-gen2-hwir-qualification-coverage-scope.env

fail() { printf '%s\n' "producer-contract-fail:$1" >&2; exit 1; }
require() { grep -Fq -- "$1" "$SCRIPT" || fail "missing:$1"; }
require_scope() { grep -Fq -- "$1" "$SCOPE" || fail "scope-missing:$1"; }
forbid() { ! grep -Fq -- "$1" "$SCRIPT" || fail "forbidden:$1"; }

sh -n "$SCRIPT"
require --stage4-cli
require --stage4-provenance
require --scratch-dir
require --manifest
require --ghdl-bin
require --expected-runner-sha256
require --expected-producer-sha256
require --expected-coverage-scope-sha256
require --expected-coverage-spec-sha256
require --product
require --required-row
require --run-id
require 'riscv-gen2-zca-trap-single-outstanding-v3'
require 'rv32-zca-cjal-critical'
require 'rv64-zca-addiw-critical'
require 'riscv_gen2_zca_rv32_cjal_trap_single_outstanding_frontend'
require 'riscv_gen2_zca_rv64_addiw_trap_single_outstanding_frontend'
require 'stage4_verify_candidate_provenance'
require 'SIMPLE_SAFETY_PROFILE=critical'
require '"$vhdl_cli" --riscv-gen2-product'
require '"generation_route":"hwir-gen2-trap-stateful-product-v3"'
require 'route=hwir-gen2-trap-stateful-product-v3 profile=$profile graph=$graph_identity'
require '\"target\":{\"name\":\"riscv$xlen\",\"xlen\":$xlen,\"profile\":\"$profile\"}'
require '"source_closure":[]'
require '\"hwir\":{\"module_node_id\":\"$entity:module\",\"config_profile\":\"$profile\",\"graph_sha256\":\"$graph_identity\"}'
require '"implementation_scope":"frontend-predecode-only"'
require '"assurance_policy":{'
require 'assurance_policy_hash=$(json_hash "$product_manifest" policy_hash)'
require '"$ghdl" -a --std=08'
require '"$ghdl" -e --std=08'
require '"$ghdl" -r --std=08'
require 'ghdl_version_sha256'
require 'QUALIFICATION_RUNNER=scripts/check/run-riscv-gen2-hwir-qualification.shs'
require 'QUALIFICATION_PRODUCER=scripts/check/produce-riscv-gen2-hwir-qualification-evidence.shs'
require 'qualification-producer-invocation-not-fixed'
require 'missing-expected-runner-sha256'
require 'missing-expected-producer-sha256'
require 'missing-expected-coverage-scope-sha256'
require 'missing-expected-coverage-spec-sha256'
require 'qualification-runner-hash-changed-before-producer'
require 'qualification-producer-hash-changed-before-producer'
require 'coverage-scope-hash-changed-before-producer'
require 'coverage-spec-hash-changed-before-producer'
require 'coverage_scope_path=%s\ncoverage_scope_sha256=%s'
require 'branch_coverage_raw_path'
require 'branch_coverage_raw_sha256'
require 'GEN2_${arch}_QUALIFICATION_TB_PASS'
require 'generated product failed its selected target-row path'
require 'x"2001"'
require 'x"000000EF"'
require 'x"2085"'
require 'x"0010809B"'
require 'generated product failed its precise C.EBREAK path'
require 'SIMPLE_COVERAGE=1 SIMPLE_COVERAGE_OUTPUT'
require 'COVERAGE_SCOPE=scripts/check/riscv-gen2-hwir-qualification-coverage-scope.env'
require 'COVERAGE_SCOPE_SCHEMA=riscv-gen2-hwir-coverage-scope-v1'
require 'COVERAGE_SCOPE_MAX_BYTES=65536'
require 'COVERAGE_SPEC_EXPECTED=test/03_system/app/hardware/feature/riscv_gen2_hwir_foundation_spec.spl'
require 'parse_coverage_scope()'
require 'coverage_owner_allowed()'
require 'coverage_decision_owners_complete()'
require 'coverage-owner-missing-decision'
require 'coverage_source_path_safe()'
require "case \"\$1\" in *'|'*) return 1 ;; esac"
require 'scope_coverage_sdn()'
require 'conditions |decision_id, condition_id, file, line, column, true_count, false_count|'
require 'coverage_capture_raw=$scratch_abs/branch_coverage.capture.sdn'
require 'coverage_raw=$scratch_abs/branch_coverage.sdn'
require 'scope_coverage_sdn "$coverage_capture_raw" "$coverage_raw"'
require 'coverage-path-malformed'
require 'coverage-owner-unrecognized'
require 'coverage-format-invalid'
require 'coverage-scoped-artifact-missing'
require 'coverage-scope-invalid'
require 'schema=riscv-gen2-hwir-qualification-run-v4'
require 'postbootstrap_log_rel=$SCRATCH_DIR/postbootstrap-stage4-sspec.log'
require 'vhdl_cli_rel=$SCRATCH_DIR/qualified-tools/simple_vhdl_gen2'
require 'vhdl_cli_build_log_rel=$SCRATCH_DIR/qualified-tools/vhdl-build.log'
require 'receipt_cli_rel=$SCRATCH_DIR/qualified-tools/simple_riscv_gen2_receipt'
require 'receipt_cli_build_log_rel=$SCRATCH_DIR/qualified-tools/receipt-build.log'
require 'postbootstrap_log_path=%s\npostbootstrap_log_sha256=%s'
require 'vhdl_cli_path=%s\nvhdl_cli_sha256=%s'
require 'vhdl_cli_build_log_path=%s\nvhdl_cli_build_log_sha256=%s'
require 'receipt_cli_path=%s\nreceipt_cli_sha256=%s'
require 'receipt_cli_build_log_path=%s\nreceipt_cli_build_log_sha256=%s'
require_scope 'schema=riscv-gen2-hwir-coverage-scope-v1'
require_scope 'coverage_spec=test/03_system/app/hardware/feature/riscv_gen2_hwir_foundation_spec.spl'
require_scope 'coverage_owner=src/compiler/50.mir/hwir/stateful_frontend.spl'
require_scope 'coverage_owner=src/compiler/70.backend/backend/hwir_to_vhdl.spl'
require_scope 'coverage_owner=src/lib/hardware/riscv_common/isa/compressed/zca_seed.spl'
require 'branch_coverage_threshold_basis_points=8000'
require 'status=passed'
require 'coverage_kind=branch'
require 'branch-coverage-below-8000bp'
require 'source_closure_sha256'
require 'graph_sha256'
require 'qualification_manifest.env'
require 'mv "$manifest_tmp" "$manifest_abs"'
require 'ROW_${arch}_TESTBENCH=${SCRATCH_DIR}/$arch.qualification_tb.vhd'
require 'ROW_${arch}_COMPILE_COMMAND=${SCRATCH_DIR}/$arch.compile.command'
require 'ROW_${arch}_ANALYZE_COMMAND=${SCRATCH_DIR}/$arch.analyze.command'
require 'ROW_${arch}_ELABORATE_COMMAND=${SCRATCH_DIR}/$arch.elaborate.command'
require 'ROW_${arch}_RUN_COMMAND=${SCRATCH_DIR}/$arch.run.command'
require 'row_1_testbench_path=%s\nrow_1_testbench_sha256=%s'
require 'row_1_compile_command_path=%s\nrow_1_compile_command_sha256=%s'
require 'row_2_testbench_path=%s\nrow_2_testbench_sha256=%s'
require 'row_2_run_command_path=%s\nrow_2_run_command_sha256=%s'
forbid '"target":{"name":"riscv$address_bits"'
forbid 'route=hwir-gen2-product profile=$profile graph=$graph_identity'
forbid 'qualification_receipt.json'
forbid 'src/compiler/*'
forbid 'src/lib/hardware/riscv_common/*'
forbid 'COVERAGE_OWNER_PATHS='
forbid --compose-receipt
forbid --emit-evidence
forbid 'schema=riscv-gen2-hwir-qualification-run-v2'
forbid --vhdl-cli
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/riscv_gen2_hwir_coverage_parser.XXXXXX") || fail 'temporary-directory-create-failed'
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
awk '
    /^coverage_basis_points\(\) \{$/ { capture = 1 }
    capture { print }
    capture && /^}$/ { exit }
' "$SCRIPT" > "$tmp_dir/coverage_basis_points.shs"
[ -s "$tmp_dir/coverage_basis_points.shs" ] || fail 'coverage-parser-extract-failed'
. "$tmp_dir/coverage_basis_points.shs"
cat > "$tmp_dir/valid.sdn" <<'EOF'
# Coverage Report
coverage_extension: decision-condition-v1
decisions |id, file, line, column, true_count, false_count|
    7, src/compiler/50.mir/hwir/stateful_frontend.spl, 42, 3, 1, 1

EOF
coverage_result=$(coverage_basis_points "$tmp_dir/valid.sdn") || fail 'valid-indented-decision-row-rejected'
[ "$coverage_result" = '2 2 10000' ] || fail "valid-indented-decision-row-wrong-coverage:$coverage_result"
cat > "$tmp_dir/malformed.sdn" <<'EOF'
# Coverage Report
coverage_extension: decision-condition-v1
decisions |id, file, line, column, true_count, false_count|
    not-an-id, src/compiler/50.mir/hwir/stateful_frontend.spl, 42, 3, 1, 1

EOF
if coverage_basis_points "$tmp_dir/malformed.sdn" >/dev/null 2>&1; then
    fail 'malformed-decision-row-was-accepted'
fi
COVERAGE_SCOPE_SCHEMA=riscv-gen2-hwir-coverage-scope-v1
COVERAGE_SCOPE_MAX_BYTES=65536
COVERAGE_SPEC_EXPECTED=test/03_system/app/hardware/feature/riscv_gen2_hwir_foundation_spec.spl
awk '
    /^parse_coverage_scope\(\) \{$/ { capture = 1 }
    /^coverage_basis_points\(\) \{$/ { exit }
    capture { print }
' "$SCRIPT" | sed '$d' > "$tmp_dir/coverage_scope_parser.shs"
[ -s "$tmp_dir/coverage_scope_parser.shs" ] || fail 'coverage-scope-parser-extract-failed'
. "$tmp_dir/coverage_scope_parser.shs"
parse_coverage_scope "$ROOT_DIR/scripts/check/riscv-gen2-hwir-qualification-coverage-scope.env" "$tmp_dir/scope-state" || fail 'valid-coverage-scope-rejected'
SCOPE_OWNER_LIST=$tmp_dir/scope-state/coverage_owners
[ -s "$SCOPE_OWNER_LIST" ] || fail 'coverage-scope-owners-missing'
cp "$ROOT_DIR/scripts/check/riscv-gen2-hwir-qualification-coverage-scope.env" "$tmp_dir/unknown-schema.env"
sed -i 's/^schema=.*/schema=unknown-scope-v1/' "$tmp_dir/unknown-schema.env"
if parse_coverage_scope "$tmp_dir/unknown-schema.env" "$tmp_dir/unknown-schema-state"; then
    fail 'unknown-coverage-scope-schema-was-accepted'
fi
cp "$ROOT_DIR/scripts/check/riscv-gen2-hwir-qualification-coverage-scope.env" "$tmp_dir/duplicate-owner.env"
printf '%s\n' 'coverage_owner=src/compiler/50.mir/hwir/stateful_frontend.spl' >> "$tmp_dir/duplicate-owner.env"
if parse_coverage_scope "$tmp_dir/duplicate-owner.env" "$tmp_dir/duplicate-owner-state"; then
    fail 'duplicate-coverage-scope-owner-was-accepted'
fi
cp "$ROOT_DIR/scripts/check/riscv-gen2-hwir-qualification-coverage-scope.env" "$tmp_dir/missing-owner.env"
sed -i '/^coverage_owner=test\/03_system\/app\/hardware\/feature\/riscv_gen2_hwir_foundation_spec\.spl$/d' "$tmp_dir/missing-owner.env"
if parse_coverage_scope "$tmp_dir/missing-owner.env" "$tmp_dir/missing-owner-state"; then
    fail 'missing-coverage-scope-owner-was-accepted'
fi
cp "$SCOPE" "$tmp_dir/missing-final-lf.env"
truncate -s -1 "$tmp_dir/missing-final-lf.env"
if parse_coverage_scope "$tmp_dir/missing-final-lf.env" "$tmp_dir/missing-final-lf-state"; then
    fail 'coverage-scope-without-final-lf-was-accepted'
fi
cp "$SCOPE" "$tmp_dir/oversized.env"
head -c 65536 /dev/zero | tr '\000' 'a' >> "$tmp_dir/oversized.env"
printf '\n' >> "$tmp_dir/oversized.env"
if parse_coverage_scope "$tmp_dir/oversized.env" "$tmp_dir/oversized-state"; then
    fail 'oversized-coverage-scope-was-accepted'
fi
cp "$SCOPE" "$tmp_dir/wrong-spec.env"
sed -i 's|^coverage_spec=.*|coverage_spec=test/03_system/app/hardware/feature/other_spec.spl|' "$tmp_dir/wrong-spec.env"
if parse_coverage_scope "$tmp_dir/wrong-spec.env" "$tmp_dir/wrong-spec-state"; then
    fail 'wrong-coverage-spec-was-accepted'
fi
cp "$SCOPE" "$tmp_dir/non-spl-owner.env"
sed -i '0,/^coverage_owner=.*\.spl$/s//coverage_owner=src\/compiler\/owner.txt/' "$tmp_dir/non-spl-owner.env"
if parse_coverage_scope "$tmp_dir/non-spl-owner.env" "$tmp_dir/non-spl-owner-state"; then
    fail 'non-spl-coverage-owner-was-accepted'
fi
cp "$SCOPE" "$tmp_dir/non-spl-changed.env"
sed -i '0,/^changed_file=.*\.spl$/s//changed_file=src\/compiler\/owner.txt/' "$tmp_dir/non-spl-changed.env"
if parse_coverage_scope "$tmp_dir/non-spl-changed.env" "$tmp_dir/non-spl-changed-state"; then
    fail 'non-spl-changed-file-was-accepted'
fi
cp "$SCOPE" "$tmp_dir/unsafe-direct-test.env"
sed -i '0,/^direct_test=/s|=.*|=test/unsafe:path.spl|' "$tmp_dir/unsafe-direct-test.env"
if parse_coverage_scope "$tmp_dir/unsafe-direct-test.env" "$tmp_dir/unsafe-direct-test-state"; then
    fail 'unsafe-direct-test-path-was-accepted'
fi
cp "$SCOPE" "$tmp_dir/invalid-exclusion-reason.env"
sed -i '0,/^exclusion=/s/|.*$/|Invalid_reason/' "$tmp_dir/invalid-exclusion-reason.env"
if parse_coverage_scope "$tmp_dir/invalid-exclusion-reason.env" "$tmp_dir/invalid-exclusion-reason-state"; then
    fail 'invalid-exclusion-reason-was-accepted'
fi
awk '
    /^coverage_owner_allowed\(\) \{$/ { capture = 1 }
    /^while \[ "\$#" -gt 0 \]; do$/ { exit }
    capture { print }
' "$SCRIPT" > "$tmp_dir/coverage_owner_gate.shs"
[ -s "$tmp_dir/coverage_owner_gate.shs" ] || fail 'coverage-owner-gate-extract-failed'
awk '
    /^safe_relative_path\(\) \{$/ { capture = 1 }
    capture { print }
    capture && /^}$/ { exit }
' "$SCRIPT" > "$tmp_dir/safe_relative_path.shs"
[ -s "$tmp_dir/safe_relative_path.shs" ] || fail 'safe-relative-path-extract-failed'
. "$tmp_dir/safe_relative_path.shs"
. "$tmp_dir/coverage_owner_gate.shs"
while IFS= read -r coverage_owner; do
    [ -n "$coverage_owner" ] || continue
    printf 'D|%s|1||1|1|1|1\n' "$coverage_owner"
done < "$SCOPE_OWNER_LIST" > "$tmp_dir/all_owners.rows"
coverage_decision_owners_complete "$tmp_dir/all_owners.rows" || fail 'all-canonical-coverage-owners-rejected'
missing_owner='src/compiler/50.mir/hwir/stateful_frontend.spl'
while IFS= read -r coverage_owner; do
    [ -n "$coverage_owner" ] || continue
    [ "$coverage_owner" = "$missing_owner" ] && continue
    printf 'D|%s|1||1|1|1|1\n' "$coverage_owner"
done < "$SCOPE_OWNER_LIST" > "$tmp_dir/missing_owner.rows"
if coverage_decision_owners_complete "$tmp_dir/missing_owner.rows"; then
    fail 'missing-canonical-coverage-owner-was-accepted'
fi
write_full_owner_sdn() {
    destination=$1
    excluded_owner=${2:-}
    extra_owner=${3:-}
    {
        printf '%s\n' '# Coverage Report'
        printf '%s\n' 'version: 1.0'
        printf '%s\n' 'coverage_extension: decision-condition-v1'
        printf '%s\n' ''
        printf '%s\n' 'decisions |id, file, line, column, true_count, false_count|'
        decision_id=1
        while IFS= read -r coverage_owner; do
            [ -n "$coverage_owner" ] || continue
            [ "$coverage_owner" = "$excluded_owner" ] && continue
            printf '    %s, %s, 1, 1, 1, 1\n' "$decision_id" "$coverage_owner"
            decision_id=$((decision_id + 1))
        done < "$SCOPE_OWNER_LIST"
        if [ -n "$extra_owner" ]; then
            printf '    %s, %s, 1, 1, 1, 1\n' "$decision_id" "$extra_owner"
        fi
        printf '%s\n' ''
    } > "$destination"
}
owner_count=$(wc -l < "$SCOPE_OWNER_LIST" | tr -d ' ')
expected_outcomes=$((owner_count * 2))
write_full_owner_sdn "$tmp_dir/full_owners.sdn"
scope_coverage_sdn "$tmp_dir/full_owners.sdn" "$tmp_dir/full_owners.scoped.sdn" || fail 'full-canonical-coverage-scope-rejected'
coverage_result=$(coverage_basis_points "$tmp_dir/full_owners.scoped.sdn") || fail 'scoped-canonical-coverage-parser-rejected'
[ "$coverage_result" = "$expected_outcomes $expected_outcomes 10000" ] || fail "scoped-canonical-coverage-wrong-coverage:$coverage_result"
write_full_owner_sdn "$tmp_dir/missing_owner.sdn" "$missing_owner"
if scope_coverage_sdn "$tmp_dir/missing_owner.sdn" "$tmp_dir/missing_owner.scoped.sdn"; then
    fail 'scoped-missing-canonical-owner-was-accepted'
else
    scope_status=$?
fi
[ "$scope_status" = 4 ] || fail "scoped-missing-canonical-owner-wrong-status:$scope_status"
write_full_owner_sdn "$tmp_dir/unrecognized_owner.sdn" '' 'src/compiler/50.mir/hwir/unreviewed_owner.spl'
if scope_coverage_sdn "$tmp_dir/unrecognized_owner.sdn" "$tmp_dir/unrecognized_owner.scoped.sdn"; then
    fail 'scoped-unrecognized-owner-was-accepted'
else
    scope_status=$?
fi
[ "$scope_status" = 3 ] || fail "scoped-unrecognized-owner-wrong-status:$scope_status"
write_full_owner_sdn "$tmp_dir/pipe_injected_owner.sdn" '' 'src/compiler/50.mir/hwir/stateful_frontend.spl|injected'
if scope_coverage_sdn "$tmp_dir/pipe_injected_owner.sdn" "$tmp_dir/pipe_injected_owner.scoped.sdn"; then
    fail 'scoped-pipe-injected-owner-was-accepted'
fi
if sh "$SCRIPT" --unknown >/tmp/riscv_gen2_hwir_producer_contract.$$.out 2>&1; then
    fail 'unknown-argument-was-accepted'
fi
rm -f /tmp/riscv_gen2_hwir_producer_contract.$$.out
printf '%s\n' 'riscv-gen2-hwir-qualification-evidence-producer-contract: pass'
