#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/compiled-check-tree-test.XXXXXX")
trap 'rm -rf -- "$work_dir"' EXIT HUP INT TERM
mkdir -p "$work_dir/sources"

printf 'fn ok_one() -> i64:\n    1\n' > "$work_dir/sources/a.spl"
printf 'fn ok_two() -> i64:\n    2\n' > "$work_dir/sources/b.spl"
printf 'INVALID\n' > "$work_dir/sources/c.spl"
printf 'fn ok_four() -> i64:\n    4\n' > "$work_dir/sources/d.spl"
printf 'fn ok_five() -> i64:\n    5\n' > "$work_dir/sources/e.spl"

fake_checker="$work_dir/fake-checker"
cat > "$fake_checker" <<'SH'
#!/bin/sh
status=0
for arg in "$@"; do
    case "$arg" in
        --progress|count) continue ;;
    esac
    if grep -q INVALID "$arg"; then
        echo "$arg: error[E-FAKE]: invalid fixture"
        status=1
    fi
done
exit "$status"
SH
chmod +x "$fake_checker"

set +e
python3 "$repo_root/scripts/check/compiled-check-tree.py" \
    --checker="$fake_checker" \
    --root="$work_dir/sources" \
    --output-dir="$work_dir/evidence" \
    --workers=2 \
    --batch-size=2 \
    --timeout=10 > "$work_dir/summary.out"
status=$?
set -e
test "$status" -eq 1

python3 - "$work_dir/evidence/summary.json" <<'PY'
import json
import sys

summary = json.load(open(sys.argv[1], encoding="utf-8"))
assert summary["source_count"] == 5
assert summary["passed_files"] == 4
assert summary["failing_files"] == 1
assert summary["error_families"] == {"E-FAKE": 1}
assert summary["complete_per_file_outcomes"] is True
PY

# Memory ceiling phase (doc/08_tracking/bug/executable_checker_failed_only_retry_peak_rss_2026-08-02):
# a checker batch whose process tree exceeds --max-rss-kib is killed and every
# file in the batch is isolated and classified rss_ceiling (fail closed).
# Enforcement requires a measurable tree RSS; elsewhere the sampler reports
# "unsupported" and this phase is skipped.
if [ ! -d /proc ]; then
    echo "compiled check tree: PASS (ceiling phase skipped: no /proc)"
    exit 0
fi

ceiling_dir="$work_dir/ceiling"
mkdir -p "$ceiling_dir/sources"
printf 'fn slow_one() -> i64:\n    1\n' > "$ceiling_dir/sources/slow_a.spl"
printf 'fn slow_two() -> i64:\n    2\n' > "$ceiling_dir/sources/slow_b.spl"

slow_checker="$ceiling_dir/fake-slow-checker"
cat > "$slow_checker" <<'SH'
#!/bin/sh
# Any real process tree exceeds 1 KiB; hold long enough for one sample.
sleep 30
SH
chmod +x "$slow_checker"

set +e
python3 "$repo_root/scripts/check/compiled-check-tree.py" \
    --checker="$slow_checker" \
    --root="$ceiling_dir/sources" \
    --output-dir="$ceiling_dir/evidence" \
    --workers=1 \
    --batch-size=2 \
    --timeout=60 \
    --max-rss-kib=1 \
    --rss-interval-s=1 > "$ceiling_dir/summary.out"
status=$?
set -e
test "$status" -eq 1

python3 - "$ceiling_dir/evidence" <<'PY'
import json
import sys
from pathlib import Path

out = Path(sys.argv[1])
batch = json.loads((out / "batch" / "batch-000001.result.json").read_text(encoding="utf-8"))
assert batch["rss_ceiling_exceeded"] is True, batch
assert batch["rss_sampler"] == "proc-tree", batch
assert batch["rss_ceiling_kib"] == 1, batch
assert batch["rss_tree_peak_kib"] > 1, batch
rows = [
    json.loads(line)
    for line in (out / "file-results.jsonl").read_text(encoding="utf-8").splitlines()
    if line.strip()
]
assert len(rows) == 2, rows
assert all(row["error_family"] == "rss_ceiling" for row in rows), rows
assert all(row["classification"] == "needs_triage" for row in rows), rows
summary = json.loads((out / "summary.json").read_text(encoding="utf-8"))
assert summary["error_families"] == {"rss_ceiling": 2}, summary
assert summary["complete_per_file_outcomes"] is True, summary
PY

echo "compiled check tree: PASS (ceiling phase: rss_ceiling fail-closed)"
