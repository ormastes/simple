#!/usr/bin/env bash
# Exercise real Git checkout and the materializer's actual placeholder predicate.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
python3 - "$root" <<'PY'
import tempfile,pathlib,subprocess,sys
source=(pathlib.Path(sys.argv[1])/'scripts/setup/materialize-symlinks-windows.shs').read_text()
a=source.index('placeholder_looks_like_target() {');b=source.index('\n}\n',a)+3
predicate=source[a:b]
assert 'cmp -s -- "$abs_link" "$blob_file" ||' in source
with tempfile.TemporaryDirectory() as tmp:
 r=pathlib.Path(tmp)
 def git(*a,input=None):return subprocess.check_output(['git','-C',str(r),*a],input=input)
 git('init','-q');(r/'target').write_text('actual source content');blob=git('hash-object','-w','--stdin',input=b'target').decode().strip();git('update-index','--add','--cacheinfo','120000',blob,'alias');(r/'blob').write_bytes(b'target')
 def guard():
  return subprocess.run(['bash','-c',predicate+'\nabs_link=$1;blob_file=$2;placeholder_looks_like_target "$abs_link" && cmp -s -- "$abs_link" "$blob_file"','guard',str(r/'alias'),str(r/'blob')]).returncode
 git('-c','core.symlinks=true','checkout-index','--force','alias');assert (r/'alias').is_symlink();assert guard()!=0;(r/'alias').unlink()
 git('-c','core.symlinks=false','checkout-index','--force','alias');assert not (r/'alias').is_symlink();assert guard()==0
 (r/'alias').write_bytes(b'target\n');assert guard()!=0
print('PASS: real Git checkout true fails actual placeholder predicate; false passes; tampered bytes fail')
PY
