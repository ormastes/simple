#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
. "$repo_root/scripts/check/lib/bootstrap-stage3/authority.shs"
BOOTSTRAP_STAGE3_UNTRACKED_MANIFEST="$repo_root/scripts/check/lib/bootstrap-stage3-untracked-manifest.pl"
export BOOTSTRAP_STAGE3_UNTRACKED_MANIFEST

test_dir=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap-stage3-unicode.XXXXXX")
trap 'rm -rf "$test_dir"' EXIT HUP INT TERM

git -C "$test_dir" init -q
git -C "$test_dir" config user.name "bootstrap provenance test"
git -C "$test_dir" config user.email "bootstrap-provenance@example.invalid"
printf 'tracked\n' >"$test_dir/tracked.txt"
git -C "$test_dir" add tracked.txt
git -C "$test_dir" commit -qm "fixture"

unicode_path="$test_dir/compiler — receiver.md"
printf 'first\n' >"$unicode_path"
first="$test_dir/first.state"
bootstrap_stage3_git_state "$test_dir" "$first"
grep -Eq '^head=[0-9a-f]+$' "$first"
grep -Eq '^dirty_fingerprint=[0-9a-f]{64}$' "$first"

printf 'second\n' >"$unicode_path"
second="$test_dir/second.state"
bootstrap_stage3_git_state "$test_dir" "$second"
if cmp -s "$first" "$second"; then
    echo "FAIL: Unicode-path content change did not move the fingerprint" >&2
    exit 1
fi

executable_path="$test_dir/executable-probe.sh"
printf '#!/bin/sh\nexit 0\n' >"$executable_path"
third="$test_dir/third.state"
bootstrap_stage3_git_state "$test_dir" "$third"
chmod +x "$executable_path"
fourth="$test_dir/fourth.state"
bootstrap_stage3_git_state "$test_dir" "$fourth"
if cmp -s "$third" "$fourth"; then
    echo "FAIL: executable-bit change did not move the fingerprint" >&2
    exit 1
fi

link_path="$test_dir/untracked-link"
ln -s tracked.txt "$link_path"
fifth="$test_dir/fifth.state"
bootstrap_stage3_git_state "$test_dir" "$fifth"
rm "$link_path"
ln -s executable-probe.sh "$link_path"
sixth="$test_dir/sixth.state"
bootstrap_stage3_git_state "$test_dir" "$sixth"
if cmp -s "$fifth" "$sixth"; then
    echo "FAIL: symlink-target change did not move the fingerprint" >&2
    exit 1
fi

nested="$test_dir/nested-repository"
git -C "$test_dir" init -q "$nested"
git -C "$nested" config user.name "nested provenance test"
git -C "$nested" config user.email "nested-provenance@example.invalid"
printf 'nested first\n' >"$nested/value.txt"
git -C "$nested" add value.txt
git -C "$nested" commit -qm "first"
seventh="$test_dir/seventh.state"
bootstrap_stage3_git_state "$test_dir" "$seventh"
printf 'nested second\n' >"$nested/value.txt"
git -C "$nested" commit -am "second" -q
eighth="$test_dir/eighth.state"
bootstrap_stage3_git_state "$test_dir" "$eighth"
if cmp -s "$seventh" "$eighth"; then
    echo "FAIL: nested-repository HEAD change did not move the fingerprint" >&2
    exit 1
fi

echo "bootstrap_stage3_unicode_git_state_cases=5"
echo "bootstrap_stage3_unicode_git_state_status=PASS"
