#!/bin/sh
# Stage 3 serial low-memory opt-in: one live MIR worker, bounded shard count.
set -u
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
worker=$root/scripts/bootstrap/lib/stage3-native-build-worker.sh
[ -f "$worker" ] || { echo 'FAIL: Stage 3 worker missing'; exit 1; }
sh -n "$worker" || exit 1

grep -Fq 'stage3_streaming_surfaces=0' "$worker" || { echo 'FAIL: default retained-surface route changed'; exit 1; }
grep -Fq 'if [ "${SIMPLE_MIR_SHARD_INTERFACE_HIR:-}" = 1 ]; then' "$worker" || { echo 'FAIL: interface opt-in guard missing'; exit 1; }
grep -Fq 'stage3_streaming_surfaces=1' "$worker" || { echo 'FAIL: opt-in streaming route missing'; exit 1; }
grep -Fq 'mir_interface_hir_env="SIMPLE_MIR_SHARD_INTERFACE_HIR=1"' "$worker" || { echo 'FAIL: residency flag is not forwarded'; exit 1; }
grep -Fq 'mir_shard_count_env="SIMPLE_MIR_SHARD_COUNT=${SIMPLE_MIR_SHARD_COUNT:-8}"' "$worker" || { echo 'FAIL: bounded 8-shard default missing'; exit 1; }
grep -Fq '${mir_interface_hir_env} ${mir_shard_count_env}' "$worker" || { echo 'FAIL: opt-in values absent from compiler environment'; exit 1; }
[ "$(grep -Fc 'stage3_streaming_surfaces=0' "$worker")" -eq 1 ] || { echo 'FAIL: default assignment is not unique'; exit 1; }
[ "$(grep -Fc 'stage3_streaming_surfaces=1' "$worker")" -eq 1 ] || { echo 'FAIL: opt-in assignment is not unique'; exit 1; }

echo 'PASS: Stage 3 serial opt-in forwards one-worker interface HIR with 8 shards; default route unchanged'
