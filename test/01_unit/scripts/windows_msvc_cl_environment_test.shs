#!/bin/sh
set -eu
case "$(uname -s)" in
  MSYS*|MINGW*|CYGWIN*) ;;
  *) echo 'SKIP: native Windows environment roundtrip'; exit 0 ;;
esac
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
MSYS2_ENV_CONV_EXCL=KEEP_LITERAL
KEEP_LITERAL=/literal-option
CL=/TC
CONVERT_PROBE_PATH=/tmp
export MSYS2_ENV_CONV_EXCL KEEP_LITERAL CL CONVERT_PROBE_PATH
. "$root/scripts/setup/windows-msvc-bootstrap-env.shs"
[ "$MSYS2_ENV_CONV_EXCL" = 'KEEP_LITERAL;CL' ]
. "$root/scripts/setup/windows-msvc-bootstrap-env.shs"
[ "$MSYS2_ENV_CONV_EXCL" = 'KEEP_LITERAL;CL' ]
python3 -c 'import os; assert os.name == "nt"; assert os.environ["CL"] == "/TC"; assert os.environ["KEEP_LITERAL"] == "/literal-option"; value = os.environ["CONVERT_PROBE_PATH"]; assert value != "/tmp" and len(value) > 2 and value[1] == ":", value; print("PASS: literal CL, preserved exclusions, idempotence, unrelated native path conversion")'
