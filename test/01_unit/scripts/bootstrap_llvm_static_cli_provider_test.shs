#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
detector=${TEST_PLATFORM_DETECTOR:-$root/scripts/setup/platform-detect.shs}
bootstrap="$root/scripts/bootstrap/bootstrap-from-scratch.sh"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/llvm-static-cli.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
fail() { echo "FAIL: $*" >&2; exit 1; }
checks=0
prefix="$tmp/authority with spaces"
mkdir -p "$prefix/bin" "$prefix/lib" "$tmp/host"
printf data >"$tmp/member"
real_ar=$(command -v ar)
for name in LLVMCore LLVMSupport Polly PollyISL; do
  "$real_ar" rc "$prefix/lib/lib$name.a" "$tmp/member"
done
printf '23.1.1\n' >"$prefix/version"
cat >"$prefix/bin/llvm-config" <<EOF2
#!/bin/sh
case "\$*" in
 --version) cat '$prefix/version' ;;
 --prefix) cat '$prefix/reported-prefix' ;;
 --libdir) cat '$prefix/libdir' ;;
 '--link-static --libnames') cat '$prefix/libnames' ;;
 *) exit 2 ;;
esac
EOF2
printf '%s\n' "$prefix/lib" >"$prefix/libdir"
printf '%s\n' "$prefix" >"$prefix/reported-prefix"
printf 'libLLVMCore.a libLLVMSupport.a\n' >"$prefix/libnames"
for tool in llc llvm-as opt clang clang++ llvm-ar; do
  cat >"$prefix/bin/$tool" <<EOF2
#!/bin/sh
if [ "\${1-}" = --version ]; then printf 'LLVM version '; cat '$prefix/version'; exit 0; fi
[ '$tool' = llvm-ar ] && exec '$real_ar' "\$@"
exit 2
EOF2
  chmod +x "$prefix/bin/$tool"
done
chmod +x "$prefix/bin/llvm-config"
# Source the real owner; call its actual prefix selector to isolate negative
# inputs from unrelated host-installed fallback providers.
. "$detector"
check_provider() {
  want=$1; mode=$2; host=$3; target=$4
  LLVM_PROVIDER_REQUIREMENT=$mode; PLATFORM_UNAME=$host; PLATFORM_OS=$target
  LLVM_FOUND=0; LLVM_LIB=""; LLVM_PROVIDER_KIND=""
  if _llvm_try_prefix "$prefix" 23; then got=accept; else got=reject; fi
  [ "$got" = "$want" ] || fail "$mode $host/$target expected $want got $got"
  if [ "$want" = accept ] && [ ! -f "$prefix/lib/libLLVM-23.so" ]; then
    [ "$LLVM_PROVIDER_KIND" = static-cli ] || fail wrong-provider-kind
    [ -z "$LLVM_LIB" ] || fail static-provider-published-dynamic-path
    [ "$LLVM_PREFIX" = "$prefix" ] || fail prefix-authority-lost
  fi
  checks=$((checks+1))
}
printf '%s\n' /unrelated/prefix >"$prefix/reported-prefix"
check_provider reject static-cli Linux linux
printf '%s\n' "$prefix" >"$prefix/reported-prefix"
check_provider reject shared Linux linux
check_provider accept static-cli Linux linux
check_provider accept static-cli FreeBSD freebsd
check_provider reject static-cli Darwin macos
check_provider reject static-cli MINGW64_NT windows
check_provider reject static-cli Linux simpleos
check_provider reject invented Linux linux
mv "$prefix/lib/libLLVMSupport.a" "$prefix/lib/held"
check_provider reject static-cli Linux linux
mv "$prefix/lib/held" "$prefix/lib/libLLVMSupport.a"
rm "$prefix/lib/libLLVMCore.a"
"$real_ar" rc "$prefix/lib/libLLVMCore.a"
check_provider reject static-cli Linux linux
printf broken >"$prefix/lib/libLLVMCore.a"
check_provider reject static-cli Linux linux
rm "$prefix/lib/libLLVMCore.a"
"$real_ar" rc "$prefix/lib/libLLVMCore.a" "$tmp/member"
printf '%s\n' /unrelated/lib >"$prefix/libdir"
check_provider reject static-cli Linux linux
printf '%s\n' "$prefix/lib" >"$prefix/libdir"
printf '\n' >"$prefix/libnames"
check_provider reject static-cli Linux linux
printf '../libLLVMCore.a\n' >"$prefix/libnames"
check_provider reject static-cli Linux linux
printf 'libLLVMCore.a libLLVMSupport.a\n' >"$prefix/libnames"
printf '23.1.3\n' >"$prefix/version"
check_provider reject static-cli Linux linux
printf '23.1.1\n' >"$prefix/version"
printf '#!/bin/sh\necho LLVM version 23.1.2\n' >"$prefix/bin/opt"
check_provider reject static-cli Linux linux
cp "$prefix/bin/llc" "$prefix/bin/opt"
chmod -x "$prefix/bin/llvm-as"
check_provider reject static-cli Linux linux
chmod +x "$prefix/bin/llvm-as"
rm "$prefix/lib/libPolly.a"
check_provider reject static-cli Linux linux
"$real_ar" rc "$prefix/lib/libPolly.a" "$tmp/member"
printf shared >"$prefix/lib/libLLVM-23.so"
check_provider accept shared Linux linux
[ "$LLVM_PROVIDER_KIND" = shared ] || fail shared-kind-lost
check_provider accept static-cli Linux linux
[ "$LLVM_PROVIDER_KIND" = shared ] || fail shared-priority-lost
rm "$prefix/lib/libLLVM-23.so"
# Execute the production bootstrap selection block, including the real sourced
# detector; do not mirror its case logic. Shared host fixtures are simulated.
awk '/^# Explicit llvm uses llc CLI;/{copy=1} copy{print} /^\. "\$\{repo_root\}\/scripts\/setup\/platform-detect.shs"/{if(copy)exit}' "$bootstrap" >"$tmp/select"
[ -s "$tmp/select" ] || fail missing-bootstrap-owner-block
cat >"$tmp/host/uname" <<'EOF2'
#!/bin/sh
case "$1" in -s) printf '%s\n' "$TEST_HOST";; -m) echo x86_64;; *) exit 2;; esac
EOF2
chmod +x "$tmp/host/uname"
for pair in Linux:llvm:static-cli FreeBSD:llvm:static-cli Linux:llvm-lib:shared Linux:cranelift:shared Darwin:llvm:shared MINGW64_NT:llvm:shared; do
  host=${pair%%:*}; rest=${pair#*:}; backend=${rest%%:*}; want=${rest#*:}
  result=$(TEST_HOST="$host" PATH="$tmp/host:$PATH" LLVM_SYS_231_PREFIX="$prefix" sh -c '
    repo_root=$1; backend=$2; unset SIMPLE_LLVM_PATH; . "$3"
    [ "$LLVM_PROVIDER_REQUIREMENT" != static-cli ] || { [ "$LLVM_FOUND" = 1 ] && [ -z "${SIMPLE_LLVM_PATH:-}" ]; } || exit 7
    printf "%s" "$LLVM_PROVIDER_REQUIREMENT"
  ' sh "$root" "$backend" "$tmp/select") || fail bootstrap-source-selection
  [ "$result" = "$want" ] || fail "bootstrap $pair got $result"
  checks=$((checks+1))
done
printf 'bootstrap_llvm_static_cli_provider_test: %s checks PASS\n' "$checks"
