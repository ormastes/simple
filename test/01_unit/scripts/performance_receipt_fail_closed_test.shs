#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd -P)
VALIDATOR="$ROOT/scripts/check/check-external-must-check-receipt.shs"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM
: >"$work/receipt.env"
: >"$work/artifact.env"

grep -Fq 'check-interpreter-startup-parity.shs' "$VALIDATOR"
grep -Fq 'check-rust-go-benchmark-parity.shs' "$VALIDATOR"
grep -Fq 'load_named_artifact_blob simple_compiler 104857600' "$VALIDATOR"
echo 'PASS: quantitative performance receipts use lane semantic validators'
