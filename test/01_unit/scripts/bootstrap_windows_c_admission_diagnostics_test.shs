#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)
fixture=$(mktemp -d "${TMPDIR:-/tmp}/windows-c-admission.XXXXXX")
trap 'rm -rf -- "$fixture"' EXIT HUP INT TERM
BOOTSTRAP_STAGE3_FACADE_PATH="$root/scripts/check/lib/bootstrap-stage3-provenance.shs"
export BOOTSTRAP_STAGE3_FACADE_PATH
. "$BOOTSTRAP_STAGE3_FACADE_PATH"
printf '#!/bin/sh\nexit 0\n' >"$fixture/clang-cl.exe"
chmod +x "$fixture/clang-cl.exe"
printf '#!/bin/sh\nprintf "%%s\\n" "%s"\n' "$fixture/clang-cl.exe" >"$fixture/where.exe"
chmod +x "$fixture/where.exe"
PATH="$fixture:$PATH"
cygpath() { shift; printf '%s\n' "$1"; }
# Inject the launch boundary, not the admission function under test. Capture
# compiler failures without changing candidate selection or inventing retries.
env() {
    printf 'compiler-diagnostic-%s\n' "$probe_status" >&2
    if [ "$probe_object" = yes ]; then
        for argument in "$@"; do
            case "$argument" in /Fo*) printf 'object\n' >"${argument#/Fo}" ;; esac
        done
    fi
    return "$probe_status"
}
probe_status=0 probe_object=yes
selected=$(bootstrap_stage3_windows_runnable_compiler clang-cl.exe --version)
[ "$selected" = "$fixture/clang-cl.exe" ]
for probe_status in 125 1; do
    probe_object=no
    if bootstrap_stage3_windows_runnable_compiler clang-cl.exe --version \
        >"$fixture/stdout" 2>"$fixture/stderr"; then
        echo 'FAIL: failed compiler launch admitted' >&2; exit 1
    fi
    [ ! -s "$fixture/stdout" ]
    grep -F "shell-status=$probe_status object-present=no" "$fixture/stderr" >/dev/null
    grep -F "compiler-diagnostic-$probe_status" "$fixture/stderr" >/dev/null
done
probe_status=0 probe_object=no
if bootstrap_stage3_windows_runnable_compiler clang-cl.exe --version \
    >"$fixture/stdout" 2>"$fixture/stderr"; then
    echo 'FAIL: zero exit without compiled object admitted' >&2; exit 1
fi
grep -F 'shell-status=0 object-present=no' "$fixture/stderr" >/dev/null
printf '#!/bin/sh\nexit 1\n' >"$fixture/where.exe"
if bootstrap_stage3_windows_runnable_compiler nonexistent-simple-clang-cl --version \
    >"$fixture/stdout" 2>"$fixture/stderr"; then
    echo 'FAIL: missing compiler admitted' >&2; exit 1
fi
grep -F 'requested=nonexistent-simple-clang-cl result=missing-tool' "$fixture/stderr" >/dev/null
printf 'PASS: Windows C admission retains launch status/stderr and requires a compiled object\n'
