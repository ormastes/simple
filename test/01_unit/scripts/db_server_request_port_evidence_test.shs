#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
CHECK=$ROOT/scripts/check/check-db-server-request-port-evidence.shs
t=$(mktemp -d); trap 'rm -rf "$t"' EXIT INT TERM
sha() { sha256sum "$1" | awk '{print $1}'; }
hex() { od -An -v -t x1 "$1" | tr -d ' \n'; }
printf 'Q\000SELECT 7\n' >"$t/query"; printf 'R\000OK\0007\n' >"$t/result"
printf '# server source\n' >"$t/server.spl"; printf '# client source\n' >"$t/client.spl"
cp /bin/true "$t/server"; cp /bin/true "$t/client"
cat >"$t/toolchain" <<EOF
evidence_schema=simple.must-check-toolchain/v1
gate_id=db-server-request-port
run_id=fixture-run
toolchain_id=sha256:fixture
final_verdict=PASS
EOF
cat >"$t/target" <<EOF
evidence_schema=simple.must-check-target/v1
gate_id=db-server-request-port
run_id=fixture-run
target_kind=loopback-native-host
target_id=sha256:fixture
final_verdict=PASS
EOF
cat >"$t/session" <<EOF
session_schema=simple.db-server-request-port-session/v1
gate_id=db-server-request-port
source_fingerprint=fixture-fingerprint
run_id=fixture-run
transport=tcp
listen_host=127.0.0.1
client_host=127.0.0.1
configured_port=35431
observed_port=35431
readiness_status=READY
request_status=SENT
result_status=RECEIVED
launched_server_pid=41001
listener_owner_pid=41001
launched_client_pid=41002
accepted_connection_count=1
server_exit_status=0
client_exit_status=0
stop_status=CLEAN
no_leak=true
direct_function_simulation=false
elapsed_ms=42
stop_budget_ms=10000
query_bytes=$(wc -c <"$t/query" | tr -d ' ')
query_hex=$(hex "$t/query")
query_sha256=$(sha "$t/query")
result_bytes=$(wc -c <"$t/result" | tr -d ' ')
result_hex=$(hex "$t/result")
result_sha256=$(sha "$t/result")
server_executable_sha256=$(sha "$t/server")
server_source_sha256=$(sha "$t/server.spl")
client_executable_sha256=$(sha "$t/client")
client_source_sha256=$(sha "$t/client.spl")
toolchain_identity_sha256=$(sha "$t/toolchain")
target_identity_sha256=$(sha "$t/target")
final_verdict=PASS
EOF
run_check() { sh "$CHECK" --session "$1" --query "$t/query" --result "$t/result" --server-executable "$t/server" --server-source "$t/server.spl" --client-executable "$t/client" --client-source "$t/client.spl" --toolchain "$t/toolchain" --target "$t/target" --fingerprint fixture-fingerprint --run-id fixture-run; }
run_check "$t/session" >/dev/null
for mutation in direct-simulation wrong-query listener-alias leaked unbounded duplicate-status; do
 cp "$t/session" "$t/mutated"
 case "$mutation" in
  direct-simulation) sed -i 's/direct_function_simulation=false/direct_function_simulation=true/' "$t/mutated";;
  wrong-query) sed -i 's/^query_hex=.*/query_hex=00/' "$t/mutated";;
  listener-alias) sed -i 's/listener_owner_pid=41001/listener_owner_pid=99999/' "$t/mutated";;
  leaked) sed -i 's/no_leak=true/no_leak=false/' "$t/mutated";;
  unbounded) sed -i 's/elapsed_ms=42/elapsed_ms=10001/' "$t/mutated";;
  duplicate-status) printf 'result_status=RECEIVED\n' >>"$t/mutated";;
 esac
 if run_check "$t/mutated" >/dev/null 2>&1; then echo "FAIL: mutation accepted: $mutation" >&2; exit 1; fi
done
grep -Fq 'load_named_executable_artifact_blob db_server_executable' "$ROOT/scripts/check/check-external-must-check-receipt.shs"
sig_line=$(grep -n 'openssl dgst -sha256 -verify' "$ROOT/scripts/check/check-external-must-check-receipt.shs" | cut -d: -f1)
exec_line=$(grep -n 'load_named_executable_artifact_blob db_server_executable' "$ROOT/scripts/check/check-external-must-check-receipt.shs" | cut -d: -f1)
[ "$sig_line" -lt "$exec_line" ] || { echo 'FAIL: importer is not signature-first' >&2; exit 1; }
grep -Eq '^[[:space:]]+db-server-request-port,[[:space:]]*todo,' "$ROOT/doc/08_tracking/check/must_check_db.sdn"
echo 'STATUS: PASS db-server-request-port evidence semantic mutations, signature-first import, and TODO preservation checked'
