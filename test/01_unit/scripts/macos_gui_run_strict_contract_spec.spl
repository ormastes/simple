use std.io_runtime.{file_read, process_run}
use std.spec.*

val SHELL_OPEN = "$" + "{"

describe "macOS GUI strict launcher contract":

    it "keeps a Linux-runnable strict probe ahead of the Darwin guard":
        val launcher = file_read("scripts/gui/macos-gui-run.shs")
        expect(launcher).to_contain("SIMPLE_GUI_STRICT_CONTRACT_PROBE")
        val probe_at = launcher.index_of("SIMPLE_GUI_STRICT_CONTRACT_PROBE") ?? -1
        val darwin_gate_at = launcher.index_of("$(uname -s)") ?? -1
        expect(probe_at).to_be_less_than(darwin_gate_at)
        expect(launcher).to_contain("SIMPLE_GUI_BINARY must be canonical")
        expect(launcher).to_contain(
            "probe requires SIMPLE_NO_BOOTSTRAP_DELEGATE=1"
        )
        expect(launcher).to_contain("non-symlink regular executable")
        expect(launcher).to_contain("source changed during copy")
        expect(launcher).to_contain("bundled hash differs from source")
        expect(launcher).to_contain("launcher PID does not own the window")
        expect(launcher).to_contain("bundle contains forbidden simple_seed descendant")
        expect(launcher).to_contain("assert_no_simple_seed_descendant")
        expect(launcher).to_contain("launched SimpleGui has forbidden simple_seed descendant")

    it "records strict binary and process identities in a versioned receipt":
        val launcher = file_read("scripts/gui/macos-gui-run.shs")
        expect(launcher).to_contain("SIMPLE_NO_BOOTSTRAP_DELEGATE")
        expect(launcher).to_contain(
            "no_bootstrap_delegate=\"" + SHELL_OPEN +
                "SIMPLE_NO_BOOTSTRAP_DELEGATE:-0}\""
        )
        expect(launcher).to_contain("schema=macos_gui_run_pid_receipt_v2")
        expect(launcher).to_contain("selected_binary_hash")
        expect(launcher).to_contain("bundled_binary_hash")
        expect(launcher).to_contain("trusted_manifest_hash")
        expect(launcher).to_contain("trusted_compiler_source_kind")
        expect(launcher).to_contain("launcher_executable")
        expect(launcher).to_contain("window_owner_executable")

    it "requires real manifest admission in strict launch mode":
        val launcher = file_read("scripts/gui/macos-gui-run.shs")
        expect(launcher).to_contain(
            "scripts/check/lib/macos-gpu-trusted-build-admission.shs"
        )
        expect(launcher).to_contain("macos_gpu_trusted_manifest_admit")
        expect(launcher).to_contain("SIMPLE_GUI_TRUSTED_MANIFEST_PATH")
        expect(launcher).to_contain(
            "[[ \"$override_candidate\" = \"$strict_admitted_binary\" ]]"
        )
        expect(launcher).to_contain(
            "\"$strict_admitted_hash\""
        )

    it "fails a host-neutral probe without an exact admission receipt":
        val missing = "SIMPLE_GUI_STRICT_EVIDENCE=1 " +
            "SIMPLE_NO_BOOTSTRAP_DELEGATE=1 SIMPLE_GUI_BINARY=/usr/bin/env " +
            "SIMPLE_GUI_STRICT_CONTRACT_PROBE=1 bash " +
            "scripts/gui/macos-gui-run.shs"
        val (_missing_out, _missing_err, missing_code) =
            process_run("/bin/sh", ["-c", missing])
        expect(missing_code).to_equal(1)

        val admitted = "root=$(cd \"$(mktemp -d)\" && pwd -P); " +
            "receipt=\"$root/admission.env\"; " +
            "if command -v shasum >/dev/null 2>&1; then hash=$(shasum -a 256 /usr/bin/env | cut -d ' ' -f 1); else hash=$(sha256sum /usr/bin/env | cut -d ' ' -f 1); fi; " +
            "printf 'schema=simple-gui-strict-probe-admission-v1\\nstatus=pass\\ncompiler_abs_path=/usr/bin/env\\ncompiler_sha256=%s\\ncompiler_source_kind=canonical-pure-simple-bootstrap-stage3\\n' \"$hash\" >\"$receipt\"; " +
            "SIMPLE_GUI_STRICT_EVIDENCE=1 SIMPLE_NO_BOOTSTRAP_DELEGATE=1 " +
            "SIMPLE_GUI_BINARY=/usr/bin/env SIMPLE_GUI_STRICT_CONTRACT_PROBE=1 " +
            "SIMPLE_GUI_STRICT_PROBE_ADMISSION_PATH=\"$receipt\" bash scripts/gui/macos-gui-run.shs; " +
            "code=$?; rm -rf \"$root\"; exit $code"
        val (_admitted_out, _admitted_err, admitted_code) =
            process_run("/bin/sh", ["-c", admitted])
        expect(admitted_code).to_equal(0)
end
