#!/bin/sh
# The rc publish gate must not leave its mktemp work dir behind (62 MB each).
set -u
repo=$(cd "$(dirname "$0")/../../.." && pwd)
fx=$(mktemp -d) || { echo "ERROR — nothing was checked: mktemp failed"; exit 2; }
trap 'rm -rf "$fx"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
mkdir "$fx/tmp" || { echo "ERROR — nothing was checked: fixture mkdir failed"; exit 2; }
# Fake stage exe records the work dir it was handed, then fails the gate.
printf '#!/bin/sh\ndirname "$2" > "%s/seen"\nexit 3\n' "$fx" > "$fx/stage-exe"; chmod +x "$fx/stage-exe"
TMPDIR="$fx/tmp" sh "$repo/scripts/release/publish-win-stage-rc.shs" "$fx/stage-exe" stage2 deadbeef --dry-run >/dev/null 2>&1
seen=$(cat "$fx/seen" 2>/dev/null)
case "$seen" in "$fx/tmp/"*) ;; *) echo "ERROR — nothing was checked: work dir '$seen' not under fixture TMPDIR"; exit 2 ;; esac
[ ! -e "$seen" ] || { echo "FAIL — work dir $seen left after gate failure"; exit 1; }
left=$(ls -A "$fx/tmp" | wc -l | tr -d ' ')
[ "${left:-bad}" = 0 ] || { echo "FAIL — ${left:-?} temp entr(ies) left after gate failure"; exit 1; }
echo "PASS — 1 run checked, temp work dir $seen removed"
