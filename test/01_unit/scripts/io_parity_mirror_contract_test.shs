#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
CANONICAL="$ROOT/test/perf/io_parity"
MIRROR="$ROOT/test/05_perf/io_parity"

files=(
    io_parity_cache_control.c
    io_parity_ref.c
    io_parity_ref.rs
    io_parity_simple.spl
    mapped_checksum.spl
    mapped_checksum_selftest.spl
    startup_ref.c
    startup_ref.rs
    startup_simple.spl
)

for name in "${files[@]}"; do
    if ! cmp -s "$CANONICAL/$name" "$MIRROR/$name"; then
        echo "FAIL: I/O parity mirror differs: $name" >&2
        exit 1
    fi
done

grep -qF 'exec "$ROOT/test/perf/io_parity/run_io_parity_benchmarks.shs" "$@"' \
    "$MIRROR/run_io_parity_benchmarks.shs" || {
    echo "FAIL: I/O parity runner mirror does not delegate to the canonical harness" >&2
    exit 1
}
grep -qF 'exec "$ROOT/test/perf/io_parity/check_io_parity_admission.shs" "$@"' \
    "$MIRROR/check_io_parity_admission.shs" || {
    echo "FAIL: I/O parity admission mirror does not delegate to the canonical checker" >&2
    exit 1
}

echo "PASS: I/O parity sources are byte-identical and mirror entrypoints delegate canonically"
