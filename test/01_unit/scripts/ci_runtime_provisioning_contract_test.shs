#!/bin/sh
# Check only the two repaired CI consumers; never bootstrap in this test.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
extract_job() {
  awk -v job="$2" '$0=="  "job":" {inside=1;print;next} inside && /^  [a-zA-Z0-9_-]+:/ {exit} inside {print}' "$1"
}
check_job() {
  file=$1 consumer=$2
  provision=$(grep -nF 'sh scripts/ci/provision-cache-writer-runtime.shs' "$file" | cut -d: -f1)
  use_line=$(grep -nF "$consumer" "$file" | cut -d: -f1)
  [ "$(printf '%s\n' "$provision" | grep -c '[0-9]')" = 1 ] || return 1
  [ "$(printf '%s\n' "$use_line" | grep -c '[0-9]')" = 1 ] || return 1
  [ "$provision" -lt "$use_line" ] || return 1
  llvm=$(grep -nF 'sh scripts/ci/install-selfhost-linux-llvm.shs' "$file" | cut -d: -f1)
  [ "$(printf '%s\n' "$llvm" | grep -c '[0-9]')" = 1 ] || return 1
  [ "$llvm" -lt "$provision" ] || return 1
  grep -F 'uses: dtolnay/rust-toolchain@nightly' "$file" >/dev/null || return 1
  grep -F 'runs-on: ubuntu-24.04' "$file" >/dev/null || return 1
  for required in 'uses: actions/cache@v4' '~/.cargo/registry' '~/.cargo/git' 'src/compiler_rust/target' 'test -x bin/simple' 'bin/simple --version'; do
    grep -F "$required" "$file" >/dev/null || return 1
  done
  if grep -Eq 'bin/release/simple|cargo build|cp .*target/.+bin/simple' "$file"; then return 1; fi
}
extract_job "$root/.github/workflows/cross-platform.yml" path-normalization > "$tmp/path"
extract_job "$root/.github/workflows/cache-promotion.yml" validate-promotions > "$tmp/cache"
# Provisioning must remain local to the affected cross-platform job.
[ "$(grep -cF 'sh scripts/ci/provision-cache-writer-runtime.shs' "$root/.github/workflows/cross-platform.yml")" = 1 ]
for lane in path cache; do
  consumer='sh scripts/ci/cache-promote.shs'
  if [ "$lane" = path ]; then consumer='RESULT=$(bin/simple run test/ci/normalize_path.spl)'; fi
  check_job "$tmp/$lane" "$consumer"
  sed '/sh scripts\/ci\/install-selfhost-linux-llvm.shs/d' "$tmp/$lane" > "$tmp/no-llvm"
  if check_job "$tmp/no-llvm" "$consumer"; then echo 'FAIL missing LLVM prerequisite accepted'; exit 1; fi
  grep -vF 'sh scripts/ci/install-selfhost-linux-llvm.shs' "$tmp/$lane" > "$tmp/late-llvm"
  printf 'sh scripts/ci/install-selfhost-linux-llvm.shs\n' >> "$tmp/late-llvm"
  if check_job "$tmp/late-llvm" "$consumer"; then echo 'FAIL late LLVM prerequisite accepted'; exit 1; fi
  sed '/sh scripts\/ci\/provision-cache-writer-runtime.shs/d' "$tmp/$lane" > "$tmp/missing"
  if check_job "$tmp/missing" "$consumer"; then echo 'FAIL missing provision accepted'; exit 1; fi
  printf '%s\n' "$consumer" > "$tmp/reordered"
  grep -vF "$consumer" "$tmp/$lane" >> "$tmp/reordered"
  if check_job "$tmp/reordered" "$consumer"; then echo 'FAIL early consumer accepted'; exit 1; fi
  sed 's@bin/simple@bin/release/simple@g' "$tmp/$lane" > "$tmp/obsolete"
  if check_job "$tmp/obsolete" "$consumer"; then echo 'FAIL obsolete runtime path accepted'; exit 1; fi
  cat "$tmp/$lane" > "$tmp/seed"
  printf 'cp src/compiler_rust/target/release/simple bin/simple\n' >> "$tmp/seed"
  if check_job "$tmp/seed" "$consumer"; then echo 'FAIL Rust seed normal-tool fallback accepted'; exit 1; fi
done
echo 'PASS: two self-hosted CI consumer contracts; twelve broken setup mutations rejected'
