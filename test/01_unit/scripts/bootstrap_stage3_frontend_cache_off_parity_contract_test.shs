#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
candidate_builder="$root/scripts/check/lib/bootstrap-stage3-candidate-builder.shs"
manifest_verifier="$root/scripts/check/lib/bootstrap-stage3/manifest-verify.shs"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/simple-stage3-cache-off-parity.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

cache_off_contract() {
  builder=$1
  verifier=$2

  [ "$(grep -F -c 'SIMPLE_FRONTEND_CACHE=0' "$builder")" -eq 2 ] || return 1
  [ "$(grep -F -c 'SIMPLE_FRONTEND_CACHE=0' "$verifier")" -eq 2 ] || return 1
  ! grep -Fq 'SIMPLE_FRONTEND_CACHE=1' "$builder" || return 1
  ! grep -Fq 'SIMPLE_FRONTEND_CACHE=1' "$verifier" || return 1

  # Each producer/verifier pair must bind cache-off immediately after the
  # streaming-surface mode in both the hashed argv and transcribed environment.
  [ "$(sed -n '/SIMPLE_STAGE3_STREAMING_SURFACES=1/{n;/SIMPLE_FRONTEND_CACHE=0/p;}' \
      "$builder" | wc -l)" -eq 2 ] || return 1
  [ "$(sed -n '/SIMPLE_STAGE3_STREAMING_SURFACES=\$bootstrap_stage3_stage3_streaming/{n;/SIMPLE_FRONTEND_CACHE=0/p;}' \
      "$verifier" | wc -l)" -eq 2 ] || return 1
}

sh -n "$candidate_builder" || fail 'candidate builder shell syntax'
sh -n "$manifest_verifier" || fail 'manifest verifier shell syntax'
cache_off_contract "$candidate_builder" "$manifest_verifier" || \
  fail 'candidate Stage3 cache-off policy is not receipt/transcript symmetric'

# Exact regression: the hashed identity may not omit the policy while the real
# invocation keeps it. Such a transcript would no longer describe its inputs.
sed '0,/SIMPLE_FRONTEND_CACHE=0/{/SIMPLE_FRONTEND_CACHE=0/d;}' \
  "$candidate_builder" >"$tmp/builder-missing-hash.shs"
if cache_off_contract "$tmp/builder-missing-hash.shs" "$manifest_verifier"; then
  fail 'contract accepted a candidate hash without cache-off identity'
fi

# Adjacent regression: verification must reject a transcript contract that no
# longer requires the cache-off environment used by the admitted candidate.
sed '0,/SIMPLE_FRONTEND_CACHE=0/{/SIMPLE_FRONTEND_CACHE=0/d;}' \
  "$manifest_verifier" >"$tmp/verifier-missing-hash.shs"
if cache_off_contract "$candidate_builder" "$tmp/verifier-missing-hash.shs"; then
  fail 'contract accepted a verifier without cache-off identity'
fi

echo 'bootstrap_stage3_frontend_cache_off_parity_contract_test: PASS'
