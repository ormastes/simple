#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
workflow=$root/.github/workflows/macos-phase23-evidence.yml
pin=$root/scripts/check/pin-macos-phase23-llvm23.shs
sh -n "$pin"
grep -F 'run: brew install llvm lld' "$workflow" >/dev/null
grep -F 'run: sh scripts/check/pin-macos-phase23-llvm23.shs' "$workflow" >/dev/null
grep -F 'SIMPLE_LLVM_REQUIRED_VERSION=$required' "$pin" >/dev/null
for name in CC CXX AR LD LLVM_CONFIG CARGO_TARGET_AARCH64_APPLE_DARWIN_LINKER; do
    grep -F "$name=" "$pin" >/dev/null || { echo "missing pin $name" >&2; exit 1; }
done
grep -F 'rustc --version --verbose' "$pin" >/dev/null
grep -F '"$llvm_config" --version' "$pin" >/dev/null
grep -F '"$ld" --version' "$pin" >/dev/null
echo 'PASS: macOS Phase 2/3 installs and pins exact LLVM 23.1.1 before bootstrap'
