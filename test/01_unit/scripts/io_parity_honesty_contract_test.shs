#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
DIR="$ROOT/test/perf/io_parity"
RUNNER="$DIR/run_io_parity_benchmarks.shs"
ADMISSION="$DIR/check_io_parity_admission.shs"
SIMPLE="$DIR/io_parity_simple.spl"
MAPPED_CHECKSUM="$DIR/mapped_checksum.spl"
MAPPED_CHECKSUM_SELFTEST="$DIR/mapped_checksum_selftest.spl"
RAW_POINTER_OWNER="$ROOT/src/lib/nogc_sync_mut/ptr/raw.spl"
C_REF="$DIR/io_parity_ref.c"
RUST_REF="$DIR/io_parity_ref.rs"
CACHE_CONTROL="$DIR/io_parity_cache_control.c"

require_literal() {
    local file="$1"
    local literal="$2"
    if ! grep -qF -- "$literal" "$file"; then
        echo "FAIL: missing honesty contract '$literal' in $file" >&2
        exit 1
    fi
}

forbid_literal() {
    local file="$1"
    local literal="$2"
    if grep -qF -- "$literal" "$file"; then
        echo "FAIL: forbidden unfair path '$literal' remains in $file" >&2
        exit 1
    fi
}

# Native Simple is mandatory. A failed compile cannot execute or retain PASS.
require_literal "$RUNNER" 'simple_native_compile=failed fallback=forbidden'
require_literal "$RUNNER" 'simple_native_compile=stub_evidence fallback=forbidden'
require_literal "$RUNNER" 'env SIMPLE_NO_STUB_FALLBACK=1 "$SIMPLE_BIN" native-build'
require_literal "$RUNNER" '--source "$ROOT/src/lib" --source "$BENCH_DIR"'
require_literal "$RUNNER" '--cache-dir "$simple_native_cache"'
require_literal "$RUNNER" 'rm -f "$receipt" "$receipt_tmp" "$publication_seal" "$publication_seal_tmp"'
require_literal "$RUNNER" 'require_self_hosted "$SIMPLE_BIN" "I/O parity Stage 4 compiler"'
require_literal "$RUNNER" 'simple_engine_admission="admitted-stage4-pure-simple"'
require_literal "$RUNNER" 'stage4_verify_candidate_provenance'
forbid_literal "$RUNNER" 'admitted-stage3-pure-simple'
forbid_literal "$RUNNER" 'fallback=interpreter'
forbid_literal "$RUNNER" '"$SIMPLE_BIN" run "$BENCH_DIR/io_parity_simple.spl"'
forbid_literal "$RUNNER" '${CC:-gcc}'
forbid_literal "$RUNNER" '${RUSTC:-rustc}'

# Admission re-establishes compiler provenance and reproduces every measured
# engine; receipt-selected paths and merely distinct hashes are not authority.
require_literal "$ADMISSION" '. "$ROOT/scripts/check/lib/require-self-hosted.shs"'
require_literal "$ADMISSION" 'require_self_hosted "$expected_simple" "I/O parity Stage 4 compiler"'
require_literal "$ADMISSION" 'stage4_verify_candidate_provenance "$expected_provenance" "$expected_simple" "$ROOT"'
require_literal "$ADMISSION" 'checker-owned C engine rebuild failed'
require_literal "$ADMISSION" 'checker-owned Rust engine rebuild failed'
require_literal "$ADMISSION" 'checker-owned Simple engine rebuild failed'
require_literal "$ADMISSION" 'is not the checker-reproduced source/compiler product'
require_literal "$ADMISSION" 'test-only Stage 4 verifier injection is forbidden in production mode'
forbid_literal "$ADMISSION" '${CC:-gcc}'
forbid_literal "$ADMISSION" '${RUSTC:-rustc}'
forbid_literal "$ADMISSION" '${SIMPLE_BIN:-'

# mmap rows must consume the mapping in place through canonical owners, not
# copy it into Simple text or redeclare runtime hooks in the benchmark leaf.
require_literal "$SIMPLE" 'use std.nogc_sync_mut.io.file_ops.{file_mmap, file_munmap, file_size, file_write_text_at}'
require_literal "$SIMPLE" 'use mapped_checksum.{mapped_byte_checksum}'
require_literal "$SIMPLE" 'val address = file_mmap(path, size, 0, true)'
require_literal "$SIMPLE" 'mapped_byte_checksum(address, size)'
require_literal "$SIMPLE" 'file_munmap(address, size)'
forbid_literal "$SIMPLE" 'extern fn rt_'
forbid_literal "$SIMPLE" 'rt_file_mmap_read_text'
forbid_literal "$SIMPLE" 'rt_file_mmap_len'
require_literal "$MAPPED_CHECKSUM" 'use std.nogc_sync_mut.ptr.raw.{raw_read_i64, raw_read_u8}'
require_literal "$MAPPED_CHECKSUM" 'while offset < size and (address + offset) % 8 != 0:'
require_literal "$MAPPED_CHECKSUM" 'while size - offset >= 8:'
require_literal "$MAPPED_CHECKSUM" 'checksum_word_bytes(raw_read_i64(address, offset))'
require_literal "$MAPPED_CHECKSUM" 'checksum = checksum + raw_read_u8(address, offset)'
forbid_literal "$MAPPED_CHECKSUM" 'extern fn rt_'
require_literal "$RAW_POINTER_OWNER" 'pub extern fn rt_ptr_read_u8(addr: i64, offset: i64) -> i64'
require_literal "$RAW_POINTER_OWNER" 'pub fn raw_read_u8(addr: i64, offset: i64) -> i64:'
require_literal "$RAW_POINTER_OWNER" 'rt_ptr_read_u8(addr, offset) & 0xFF'
require_literal "$MAPPED_CHECKSUM_SELFTEST" 'while start < 8:'
require_literal "$MAPPED_CHECKSUM_SELFTEST" 'while length <= 17:'
require_literal "$MAPPED_CHECKSUM_SELFTEST" 'if actual != expected:'
require_literal "$MAPPED_CHECKSUM_SELFTEST" 'scalar_calls != 1073741824 or packed_calls != 134217728'
require_literal "$RUNNER" '--entry-closure --entry "$BENCH_DIR/mapped_checksum_selftest.spl"'
require_literal "$RUNNER" 'checksum.selftest.cases=144'
require_literal "$RUNNER" 'checksum.selftest.ratio=8'
require_literal "$ADMISSION" '--entry-closure --entry "$ROOT/test/perf/io_parity/mapped_checksum_selftest.spl"'
require_literal "$ADMISSION" 'checker-owned mapped checksum self-test output mismatch'
require_literal "$C_REF" 'byte_checksum((const unsigned char *)data, (size_t)size)'
require_literal "$RUST_REF" 'byte_checksum(std::slice::from_raw_parts(ptr, size))'
require_literal "$C_REF" 'MAP_SHARED'
require_literal "$RUST_REF" 'MAP_SHARED'

# append_at means one explicit-offset write-all loop per iteration for every
# engine, with target sizing/cache preparation owned by the harness.
require_literal "$SIMPLE" 'while written < data.len():'
require_literal "$SIMPLE" 'val wrote = file_write_text_at(path, offset + written, remaining)'
forbid_literal "$SIMPLE" 'rt_file_write_text_at_cached_repeat'
forbid_literal "$SIMPLE" 'rt_file_write_text_at_cached('
require_literal "$C_REF" 'write_all_at(fd, (const unsigned char *)chunk, sizeof(chunk), i * (int64_t)sizeof(chunk))'
require_literal "$RUST_REF" 'fn write_all_at(file: &File, mut data: &[u8], mut offset: u64)'
require_literal "$RUST_REF" 'write_all_at(&file, &chunk, i as u64 * chunk.len() as u64)'
forbid_literal "$SIMPLE" 'file_write_text_at(path, 0, "")'
forbid_literal "$C_REF" 'unlink(path)'
forbid_literal "$RUST_REF" 'fs::remove_file(path)'
require_literal "$C_REF" 'fd = open(path, O_WRONLY)'
require_literal "$RUST_REF" 'let file = OpenOptions::new().write(true).open(path).unwrap()'
require_literal "$RUNNER" '"$BUILD_DIR/io_parity_cache_control" "$append_output" prepare "$expected_append_bytes"'
require_literal "$RUNNER" 'cache_target="$append_output"'
require_literal "$RUNNER" '"$BUILD_DIR/io_parity_cache_control" "$append_output" verify "$bytes" "$checksum"'

# All strict timers are monotonic; wall-clock jumps cannot win a perf row.
require_literal "$SIMPLE" 'time_now_nanos() / 1000'
forbid_literal "$SIMPLE" 'rt_time_now_unix_micros'

# Checker-owned negative cases establish equivalent error markers and exits.
require_literal "$RUNNER" 'check_error_contract "$lang" "$BUILD_DIR/io_parity_$lang" invalid_iterations 0 mmap_direct'
require_literal "$RUNNER" 'check_error_contract "$lang" "$BUILD_DIR/io_parity_$lang" unknown_case 1 invalid'
require_literal "$RUNNER" 'error.contract=invalid_iterations-and-unknown_case-exit-2-v1'
require_literal "$ADMISSION" 'verify_error_contract "$lang" "$verification_work/io_parity_$lang" invalid_iterations 0 mmap_direct'
require_literal "$ADMISSION" 'verify_error_contract "$lang" "$verification_work/io_parity_$lang" unknown_case 1 invalid'

# Budgets and N are immutable, positive schema constants.
require_literal "$RUNNER" 'readonly IO_PARITY_SAMPLES_PER_CLASS=7'
require_literal "$RUNNER" 'readonly IO_PARITY_MMAP_MIN_C_RATIO="0.50"'
require_literal "$RUNNER" 'readonly IO_PARITY_MMAP_MIN_RUST_RATIO="0.50"'
require_literal "$RUNNER" 'readonly IO_PARITY_APPEND_MIN_C_RATIO="0.50"'
require_literal "$RUNNER" 'readonly IO_PARITY_APPEND_MIN_RUST_RATIO="0.50"'
require_literal "$RUNNER" 'readonly IO_PARITY_MAX_RSS_KIB=524288'
forbid_literal "$RUNNER" 'IO_PARITY_MMAP_MIN_C_RATIO:-'

# Samples are retained, interleaved, cache-classed, and summarized from rows.
require_literal "$RUNNER" 'timing.model=interleaved-process-monotonic-internal-v2'
require_literal "$RUNNER" 'timing.interleave=sample-cache-case-rotating-engine-v1'
require_literal "$RUNNER" 'cache.classes=cold,warm'
require_literal "$RUNNER" 'raw.rows.sha256='
require_literal "$RUNNER" 'output.manifest.sha256='
require_literal "$RUNNER" 'p50_micros='
require_literal "$RUNNER" 'p95_micros='
require_literal "$RUNNER" 'throughput.unit=mib_per_second'
require_literal "$RUNNER" 'p50_mib_per_second='
require_literal "$RUNNER" 'max_rss_kib='
require_literal "$CACHE_CONTROL" 'POSIX_FADV_DONTNEED'
require_literal "$CACHE_CONTROL" 'checksum += data[i]'
require_literal "$CACHE_CONTROL" 'ftruncate(fd, size)'

# read_text timings are excluded until all engines have equivalent cache and
# allocation semantics; no summary or ratio is emitted for that case.
require_literal "$RUNNER" 'case.read_text.mode=excluded'
require_literal "$RUNNER" 'non-equivalent-runtime-cache-semantics-no-performance-claim'
require_literal "$RUNNER" 'cases=(mmap_direct append_at)'
forbid_literal "$SIMPLE" 'bench_read('
forbid_literal "$C_REF" 'bench_read('
forbid_literal "$RUST_REF" 'bench_read('

# Exact environment, compiler, source, runtime, tool, and harness identity is retained.
for literal in \
    'host.load_start=' 'host.load_end=' 'compiler.c.version=' 'compiler.rust.version=' \
    'compiler.simple.version=' 'tool.time.sha256=' 'harness.runner.sha256=' \
    'source.simple.sha256=' 'source.mapped_checksum.sha256=' 'source.ptr_raw.sha256=' \
    'source.mapped_checksum_selftest.sha256=' 'engine.simple.checksum_selftest.sha256=' \
    'source.simple_runtime_manifest.sha256=' \
    'engine.$lang.runtime_manifest.sha256='; do
    require_literal "$RUNNER" "$literal"
done

# PASS becomes visible only after the complete temporary receipt validates and
# the canonical receipt is renamed before the marker commit point.
require_literal "$RUNNER" '} >"$receipt_tmp"'
require_literal "$RUNNER" 'check_io_parity_admission.shs" --prepublish "$receipt_tmp"'
require_literal "$RUNNER" 'schema=simple.io-parity-publication/v1'
require_literal "$RUNNER" 'mv "$publication_seal_tmp" "$publication_seal"'
require_literal "$RUNNER" 'mv "$receipt_tmp" "$receipt"'
receipt_move_line="$(grep -nF 'mv "$receipt_tmp" "$receipt"' "$RUNNER" | cut -d: -f1)"
marker_move_line="$(grep -nF 'mv "$publication_seal_tmp" "$publication_seal"' "$RUNNER" | cut -d: -f1)"
final_check_line="$(grep -nF '"$BENCH_DIR/check_io_parity_admission.shs" "$receipt"' "$RUNNER" | cut -d: -f1)"
[[ "$(grep -cF 'mv "$receipt_tmp" "$receipt"' "$RUNNER")" -eq 1 && \
    "$(grep -cF 'mv "$publication_seal_tmp" "$publication_seal"' "$RUNNER")" -eq 1 && \
    "$receipt_move_line" -lt "$marker_move_line" && "$marker_move_line" -lt "$final_check_line" ]] || {
    echo "FAIL: publication must rename receipt first, marker last, then run the published checker" >&2
    exit 1
}
require_literal "$ADMISSION" 'publication marker exists without its canonical receipt'
require_literal "$ADMISSION" 'canonical receipt is not committed by a publication marker'

echo "PASS: I/O parity harness is direct-byte-touching, interleaved, raw-retaining, provenance-bound, budgeted, atomic, and fail-closed"
