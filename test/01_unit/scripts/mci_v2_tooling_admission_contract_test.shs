#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd)
gate=$root/scripts/check/check-mci-v2-tooling-admission.shs
mkdir -p "$root/build"
work=$(mktemp -d "$root/build/mci-tooling-contract.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
source_hash=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
config_hash=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
ids='compiler-check lib-check mcp-check lsp-check bootstrap-essential bootstrap-portability bootstrap-parity lint duplicate whole-test direct-env-working direct-env-staged runtime-contract artifact-execution warm-cli warm-mcp warm-lsp'
hash=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
manifest=$work/fixture.manifest
{
    echo manifest_schema=mci-tooling-child-manifest-v1
    echo producer_class=tooling-admission
    echo mode=fixture
    echo run_id=contract-run
    echo source_hash=$source_hash
    echo configuration_hash=$config_hash
    echo "required_child_ids=$ids"
    echo capture_limit_bytes=16777216
    echo timeout_seconds=1800
    for id in $ids; do
        status=pass; [ "$id" = whole-test ] && status=blocked
        echo "row=$id|$status|$hash|$hash|$hash|17|$hash|19|1|2|1|0|false|1|20|10|12|100|12|0"
    done
} > "$manifest"
args="--evidence $work/evidence --run-id contract-run --source-hash $source_hash --configuration-hash $config_hash --captured-at-utc-ns 1 --valid-until-utc-ns 2 --fixture-manifest $manifest"
MCI_TOOLING_CONTROLLED_FIXTURE=1 MCI_TOOLING_CAPTURE_SELFTEST=1 sh "$gate" $args > "$work/out"
grep -qx 'tooling_contract=PASS' "$work/out"
grep -qx 'tooling_admission=CONTRACT_ONLY' "$work/out"
grep -qx 'result=blocked' "$work/evidence/tooling-report-v1.env"
grep -qx 'evidence_mode=CONTRACT_ONLY' "$work/evidence/tooling-report-v1.env"
grep -qx 'release_eligible=false' "$work/evidence/tooling-report-v1.env"
tar -xOf "$work/evidence/artifacts/tooling-contract-v1.tar" ./manifest.env | grep -qx 'evidence_mode=CONTRACT_ONLY'
tar -xOf "$work/evidence/artifacts/tooling-contract-v1.tar" ./manifest.env | grep -qx 'release_eligible=false'
[ ! -e "$work/evidence/receipts/tooling.receipt" ]
[ ! -e "$work/evidence/receipts/tooling.unsigned.template" ]

# A malicious external signer cannot promote the real-shaped controlled
# generation by lying in receipt-side mode/eligibility fields.
mkdir -p "$work/evidence/signatures"
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$work/key.pem" >/dev/null 2>&1
openssl pkey -in "$work/key.pem" -pubout -out "$work/public.pem" >/dev/null 2>&1
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$work/reviewer-key.pem" >/dev/null 2>&1
openssl pkey -in "$work/reviewer-key.pem" -pubout -out "$work/reviewer-public.pem" >/dev/null 2>&1
artifact_sha=$(if command -v sha256sum >/dev/null 2>&1; then sha256sum "$work/evidence/artifacts/tooling-contract-v1.tar" | awk '{print $1}'; else shasum -a 256 "$work/evidence/artifacts/tooling-contract-v1.tar" | awk '{print $1}'; fi)
receipt=$work/evidence/receipts/tooling.receipt
{
    echo receipt_schema=mci-lane-receipt-v1; echo check_id=tooling
    echo producer_class=tooling-admission; echo attestation=signed-v1
    echo trusted_key_id=tooling-test-key; echo signature_relpath=tooling.sig
    echo run_id=contract-run; echo source_hash=$source_hash; echo configuration_hash=$config_hash
    echo captured_at_utc_ns=1; echo valid_until_utc_ns=10; echo result=pass
    echo scenarios=MCI-TOOL-001,MCI-TOOL-002,MCI-TOOL-003,MCI-NFR-001,MCI-NFR-002,MCI-NFR-005,MCI-NFR-006,MCI-NFR-013,MCI-NFR-014
    echo artifact_relpath=tooling-contract-v1.tar; echo artifact_sha256=$artifact_sha
    echo artifact_schema=mci-tooling-child-manifest-v1; echo artifact_mode=live; echo release_eligible=true
} > "$work/canonical"
cp "$work/canonical" "$receipt"
receipt_sha=$(if command -v sha256sum >/dev/null 2>&1; then sha256sum "$work/canonical" | awk '{print $1}'; else shasum -a 256 "$work/canonical" | awk '{print $1}'; fi)
echo receipt_hash=$receipt_sha >> "$receipt"
openssl dgst -sha256 -sign "$work/key.pem" -out "$work/evidence/signatures/tooling.sig" "$work/canonical"
sh "$root/scripts/check/check-mci-v2-aggregate.shs" --evidence "$work/evidence" --run-id contract-run --source-hash "$source_hash" --configuration-hash "$config_hash" --now-utc-ns 2 --trusted-key "$work/public.pem" --trusted-key-id tooling-test-key --reviewer-key "$work/reviewer-public.pem" --reviewer-key-id reviewer-test-key >/dev/null 2>&1 || true
grep -q '^row=tooling|BLOCKED|non-release-artifact-policy|' "$work/evidence/aggregate-report-v1.env"
grep -q '^row=compiler|BLOCKED|missing|' "$work/evidence/aggregate-report-v1.env"

sed '/^row=warm-lsp|/d' "$manifest" > "$work/missing.manifest"
if MCI_TOOLING_CONTROLLED_FIXTURE=1 sh "$gate" --evidence "$work/missing-evidence" --run-id contract-run --source-hash "$source_hash" --configuration-hash "$config_hash" --captured-at-utc-ns 1 --valid-until-utc-ns 2 --fixture-manifest "$work/missing.manifest" > /dev/null 2>&1; then
    echo 'missing exact child row was admitted' >&2; exit 1
fi
if sh "$gate" $args > /dev/null 2>&1; then echo 'fixture was admitted without explicit control' >&2; exit 1; fi
if MCI_TOOLING_CONTROLLED_FIXTURE=1 sh "$gate" --evidence /tmp/outside-tooling-evidence --run-id contract-run --source-hash "$source_hash" --configuration-hash "$config_hash" --captured-at-utc-ns 1 --valid-until-utc-ns 2 --fixture-manifest "$manifest" >/dev/null 2>&1; then
    echo 'outside-repository evidence path was admitted' >&2; exit 1
fi
# Unknown, uppercase/skip, oversize, timeout-shaped malformed, and >5%
# regression rows all fail the same closed schema boundary.
for mutation in unknown uppercase duplicate badhash nonzero timeout oversize regression; do
    case "$mutation" in
        unknown) sed '$a row=unexpected|pass|'"$hash|$hash|$hash|1|$hash|1|1|2|1|0|false|0|1|0|0|0|0|0" "$manifest" > "$work/$mutation.manifest";;
        uppercase) sed 's/^row=compiler-check|pass|/row=compiler-check|PASS|/' "$manifest" > "$work/$mutation.manifest";;
        duplicate) { cp "$manifest" "$work/$mutation.manifest"; grep '^row=compiler-check|' "$manifest" >> "$work/$mutation.manifest"; };;
        badhash) sed 's/^row=compiler-check|pass|[^|]*/row=compiler-check|pass|bad/' "$manifest" > "$work/$mutation.manifest";;
        nonzero) sed 's/|0|false|1|20|/|7|false|1|20|/' "$manifest" > "$work/$mutation.manifest";;
        timeout) sed 's/|0|false|1|20|/|124|true|1|20|/' "$manifest" > "$work/$mutation.manifest";;
        oversize) sed 's/^row=compiler-check|pass|\([^|]*|[^|]*|[^|]*\)|17|/row=compiler-check|pass|\1|16777217|/' "$manifest" > "$work/$mutation.manifest";;
        regression) sed 's/|12|0$/|12|501/' "$manifest" > "$work/$mutation.manifest";;
    esac
    if MCI_TOOLING_CONTROLLED_FIXTURE=1 sh "$gate" --evidence "$work/$mutation-evidence" --run-id contract-run --source-hash "$source_hash" --configuration-hash "$config_hash" --captured-at-utc-ns 1 --valid-until-utc-ns 2 --fixture-manifest "$work/$mutation.manifest" >/dev/null 2>&1; then
        echo "$mutation fixture was admitted" >&2; exit 1
    fi
done
echo 'mci_v2_tooling_admission_contract=PASS'
