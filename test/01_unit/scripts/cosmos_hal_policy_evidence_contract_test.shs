#!/bin/sh
# Source-only contract: this test must never execute a Simple compiler gate.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
PCIE="$ROOT/scripts/check/check-cosmos-nvme-pcie-policy.shs"
NFC="$ROOT/scripts/check/check-cosmos-nfc-policy.shs"
FTL="$ROOT/scripts/check/check-cosmos-ftl-policy.shs"
ADAPTER="$ROOT/scripts/check/check-cosmos-nvme-pcie-adapter-policy.shs"
NFC_ECC="$ROOT/scripts/check/check-cosmos-nfc-ecc-policy.shs"
ADAPTER_WRAPPER="$ROOT/test/02_integration/os/cosmos/run_cosmos_nvme_pcie_adapter_contract_test.shs"

fail() {
    echo "FAIL cosmos-hal-policy-evidence-contract: $*" >&2
    exit 1
}

require_fixed() {
    file=$1
    text=$2
    grep -Fq "$text" "$file" || fail "$(basename "$file"): missing $text"
}

reject_fixed() {
    file=$1
    text=$2
    if grep -Fq "$text" "$file"; then
        fail "$(basename "$file"): forbidden $text"
    fi
}

require_before() {
    file=$1
    first=$2
    second=$3
    awk -v first="$first" -v second="$second" '
        index($0, first) && !first_line { first_line = NR }
        index($0, second) && !second_line { second_line = NR }
        END { exit !first_line || !second_line || first_line >= second_line }
    ' "$file" || fail "$(basename "$file"): $first must precede $second"
}

require_final_verify_before_publish() {
    file=$1
    awk '
        /stage4_verify_candidate_provenance/ { verify_line = NR }
        /mv -f -- "\$RECEIPT_TMP" "\$RECEIPT"/ { publish_line = NR }
        END { exit !verify_line || !publish_line || verify_line >= publish_line }
    ' "$file" || fail "$(basename "$file"): final Stage-4 verify must precede publication"
}

for gate in "$PCIE" "$NFC" "$FTL" "$ADAPTER" "$NFC_ECC"; do
    sh -n "$gate" || fail "$(basename "$gate"): shell syntax"
    require_fixed "$gate" 'SIMPLE_STAGE4_BIN'
    require_fixed "$gate" 'SIMPLE_PROVENANCE="${SIMPLE_CANONICAL}.provenance.env"'
    require_fixed "$gate" 'stage4_verify_candidate_provenance'
    require_fixed "$gate" 'case "$("$SIMPLE_CANONICAL" --version 2>&1 || true)" in'
    require_fixed "$gate" 'stage4_compiler_sha256='
    require_fixed "$gate" 'stage4_provenance_sha256='
    require_fixed "$gate" 'simple_source_sha256='
    require_fixed "$gate" 'c_oracle_sha256='
    require_fixed "$gate" 'mv -f -- "$RECEIPT_TMP" "$RECEIPT"'
    reject_fixed "$gate" 'SIMPLE_BIN'
    reject_fixed "$gate" 'SIMPLE_PROVENANCE:-'
    reject_fixed "$gate" 'bin/simple'
    reject_fixed "$gate" 'case $($SIMPLE_CANONICAL --version 2>&1 || true) in'
    verify_count=$(grep -c 'stage4_verify_candidate_provenance' "$gate")
    [ "$verify_count" -ge 2 ] ||
        fail "$(basename "$gate"): provenance is not rechecked before receipt"
done

sh -n "$ADAPTER_WRAPPER" || fail "adapter wrapper: shell syntax"
require_fixed "$ADAPTER_WRAPPER" \
    'exec "$root/scripts/check/check-cosmos-nvme-pcie-adapter-policy.shs"'
reject_fixed "$ADAPTER_WRAPPER" 'bin/simple'
require_fixed "$ADAPTER" 'parity_output=$("$SCRATCH/parity")'
reject_fixed "$ADAPTER" 'parity_output=$($SCRATCH/parity)'

# Frozen denominators remain explicit; hardening evidence must not dilute them.
require_fixed "$NFC" '[ "$oracle_cases" = 5005 ]'
require_fixed "$NFC" '[ "$simple_total" -eq 29 ]'
require_fixed "$NFC" 'policy_exports=28'

require_fixed "$NFC_ECC" '[ "$oracle_cases" = 6144 ]'
require_fixed "$NFC_ECC" 'simple_decisions_total=$simple_total'
require_fixed "$NFC_ECC" 'verify_hash "$SIMPLE_SPEC" "$SIMPLE_SPEC_SHA256" simple-spec'
require_fixed "$NFC_ECC" 'verify_hash "$STAGE4_PROVENANCE_HELPER_PATH" "$STAGE4_PROVENANCE_HELPER_SHA256" stage4-provenance-helper'
require_before "$NFC_ECC" \
    'STAGE4_PROVENANCE_HELPER_SHA256=$(hash_file "$STAGE4_PROVENANCE_HELPER_PATH")' \
    '. "$STAGE4_PROVENANCE_HELPER_PATH"'
require_before "$NFC_ECC" \
    'SIMPLE_SHA256=$(hash_file "$SIMPLE_CANONICAL")' \
    'case "$("$SIMPLE_CANONICAL" --version 2>&1 || true)" in'
require_before "$NFC_ECC" \
    'SIMPLE_SPEC_SHA256=$(hash_file "$SIMPLE_SPEC")' \
    'SIMPLE_LIB="$ROOT/src" "$SIMPLE_CANONICAL" native-build'
require_before "$NFC_ECC" \
    'verify_hash "$SIMPLE_SPEC" "$SIMPLE_SPEC_SHA256" simple-spec' \
    'mv -f -- "$RECEIPT_TMP" "$RECEIPT"'
require_final_verify_before_publish "$NFC_ECC"

require_fixed "$FTL" '[ "$(pin_value decision_sites)" = 182 ]'
require_fixed "$FTL" '[ "$(pin_value branch_outcomes_total)" = 364 ]'
require_fixed "$FTL" 'policy_functions_total=41'
require_fixed "$FTL" 'c_imports_total=39'

require_fixed "$ADAPTER" 'policy_exports_total=39'
require_fixed "$ADAPTER" 'c_policy_imports_total=32'
require_fixed "$ADAPTER" 'c_public_abi_total=7'
require_fixed "$ADAPTER" 'policy_decisions_total=45'
require_fixed "$ADAPTER" 'branch_outcomes_total=90'

# The PCIe gate keeps measured denominators rather than substituting constants.
require_fixed "$PCIE" 'c_branches_total=$C_TOTAL'
require_fixed "$PCIE" 'simple_decisions_total=$SIMPLE_TOTAL'

echo "PASS cosmos HAL policy evidence source contract (Stage4 not executed)"
