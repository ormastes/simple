#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/../../.." && pwd -P)
work=$(mktemp -d); trap 'rm -rf "$work"' EXIT INT TERM
mkdir -p "$work/evidence" "$work/scripts/check" "$work/config/check"
cp "$ROOT/scripts/check/check-external-must-check-receipt.shs" "$work/scripts/check/"
cp "$ROOT/scripts/check/check-performance-target-identity.shs" "$work/scripts/check/"
cp "$ROOT/scripts/check/check-rust-go-benchmark-parity.shs" "$work/scripts/check/"
cp "$ROOT/scripts/check/check-rust-go-benchmark-build-origin.shs" "$work/scripts/check/"
cp "$ROOT/scripts/check/check-rust-go-benchmark-samples.shs" "$work/scripts/check/"
git -C "$work" init -q
git -C "$work" config user.name performance-target-test
git -C "$work" config user.email performance-target@example.invalid
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$work/reviewer-private.pem" >/dev/null 2>&1
openssl pkey -in "$work/reviewer-private.pem" -pubout -out "$work/config/check/reviewer.pem" >/dev/null 2>&1
key_sha=$(sha256sum "$work/config/check/reviewer.pem" | awk '{print $1}')
printf '%s\n' 'must_check_external_reviewers:' '  schema: "simple.must-check-reviewer-policy/v1"' \
    'trusted_reviewers |key_id, public_key_path, public_key_sha256|' \
    "    fixture-reviewer, config/check/reviewer.pem, $key_sha" >"$work/config/check/must_check_external_reviewers.sdn"
fp=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
run_id=benchmark-run-001
cat >"$work/evidence/command.env" <<EOF
evidence_schema=simple.must-check-command/v1
gate_id=rust-go-benchmark-parity
source_fingerprint=$fp
run_id=$run_id
command=run-rust-go-benchmark
exit_status=0
final_verdict=PASS
EOF
cat >"$work/evidence/toolchain.env" <<EOF
evidence_schema=simple.must-check-toolchain/v1
gate_id=rust-go-benchmark-parity
run_id=$run_id
toolchain_id=fixture-toolchain
final_verdict=PASS
EOF
ids=semantic-equivalence,raw-samples,statistics,rust,go,simple-ge-parity
cat >"$work/evidence/observations.env" <<EOF
evidence_schema=simple.must-check-observations/v1
gate_id=rust-go-benchmark-parity
source_fingerprint=$fp
run_id=$run_id
acceptance_ids=$ids
acceptance.semantic-equivalence=PASS
acceptance.raw-samples=PASS
acceptance.statistics=PASS
acceptance.rust=PASS
acceptance.go=PASS
acceptance.simple-ge-parity=PASS
final_verdict=PASS
EOF
write_target() {
    cat >"$work/evidence/target.env" <<EOF
evidence_schema=simple.must-check-target/v1
gate_id=rust-go-benchmark-parity
run_id=$run_id
target_kind=$1
target_id=$2
final_verdict=PASS
EOF
}
write_environment() {
    cat >"$work/evidence/environment.env" <<EOF
environment_schema=simple.rust-go-benchmark-environment/v1
gate_id=rust-go-benchmark-parity
source_fingerprint=$fp
run_id=$run_id
fixture_id=runtime-fed-lcg-100k
host_id=$1
os=linux
kernel=fixture-kernel
arch=x86_64
cpu_model_sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
cpu_count=4
cpu_governor=performance
cpuset_sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
isolation=offline-controlled
clock_tool_sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
simple_compiler_path=/fixture/bin/release/x86_64/simple
simple_compiler_sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
simple_executable_sha256=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
rust_executable_sha256=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
go_executable_sha256=eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
warmup_iterations=10
runtime_order=simple,rust,go
final_verdict=PASS
EOF
}
seal() {
    command_sha=$(sha256sum "$work/evidence/command.env" | awk '{print $1}')
    target_sha=$(sha256sum "$work/evidence/target.env" | awk '{print $1}')
    toolchain_sha=$(sha256sum "$work/evidence/toolchain.env" | awk '{print $1}')
    observations_sha=$(sha256sum "$work/evidence/observations.env" | awk '{print $1}')
    environment_sha=$(sha256sum "$work/evidence/environment.env" | awk '{print $1}')
    cat >"$work/evidence/summary.env" <<EOF
evidence_schema=simple.must-check-external-evidence/v2
gate_id=rust-go-benchmark-parity
source_fingerprint=$fp
final_verdict=PASS
producer_id=fixture-producer
producer_kind=native-host
run_id=$run_id
produced_at_utc=2000-01-01T00:00:00Z
reviewer_key_id=fixture-reviewer
command_receipt_path=evidence/command.env
command_receipt_sha256=$command_sha
target_identity_path=evidence/target.env
target_identity_sha256=$target_sha
toolchain_identity_path=evidence/toolchain.env
toolchain_identity_sha256=$toolchain_sha
observations_path=evidence/observations.env
observations_sha256=$observations_sha
benchmark_environment_path=evidence/environment.env
benchmark_environment_sha256=$environment_sha
acceptance_contract=rust-go-benchmark-parity/v1
acceptance_ids=$ids
EOF
    if [ -f "$work/evidence/build-origin.env" ]; then
        for pair in \
            simple_compiler:simple-compiler \
            benchmark_rust_compiler:rust-compiler \
            benchmark_go_compiler:go-compiler \
            benchmark_simple_executable:simple-executable \
            benchmark_rust_executable:rust-executable \
            benchmark_go_executable:go-executable \
            benchmark_raw_samples:raw-samples \
            benchmark_statistics:statistics \
            semantic_equivalence:equivalence \
            benchmark_build_origin:build-origin \
            benchmark_simple_version:simple-version \
            benchmark_rust_version:rust-version \
            benchmark_go_version:go-version \
            stage4_provenance:stage4-provenance; do
            key=${pair%%:*}; name=${pair#*:}; blob_sha=$(sha256sum "$work/evidence/$name.env" | awk '{print $1}')
            printf '%s_path=evidence/%s.env\n%s_sha256=%s\n' "$key" "$name" "$key" "$blob_sha" >>"$work/evidence/summary.env"
        done
    fi
    openssl dgst -sha256 -sign "$work/reviewer-private.pem" -out "$work/evidence/reviewer.sig" "$work/evidence/summary.env"
    signature_sha=$(sha256sum "$work/evidence/reviewer.sig" | awk '{print $1}')
    printf '%s\n' 'reviewer_signature_path=evidence/reviewer.sig' "reviewer_signature_sha256=$signature_sha" >"$work/evidence/external.receipt"
    git -C "$work" add evidence scripts config
    git -C "$work" commit -qm "$1"
}
run_validator() {
    MUST_CHECK_ROOT="$work" MUST_CHECK_RECEIPT_FILE="$work/evidence/external.receipt" \
    MUST_CHECK_ARTIFACT_FILE="$work/evidence/summary.env" MUST_CHECK_EXPECTED_GATE=rust-go-benchmark-parity \
    MUST_CHECK_EXPECTED_FINGERPRINT="$fp" sh "$work/scripts/check/check-external-must-check-receipt.shs" 2>&1
}
expect_reason() {
    if output=$(run_validator); then echo "FAIL: importer unexpectedly passed $1" >&2; exit 1; fi
    printf '%s\n' "$output" | grep -Fq -- "$2" || { echo "FAIL: wrong importer reason for $1" >&2; exit 1; }
}
write_target native-host fixture-host; write_environment fixture-host; seal canonical-target
expect_reason canonical-target missing-or-duplicate-simple_compiler_path
write_target container-host fixture-host; write_environment fixture-host; seal mutated-target-kind
expect_reason mutated-target-kind rust-go-benchmark-target-identity
write_target native-host other-host; write_environment fixture-host; seal mutated-target-id
expect_reason mutated-target-id rust-go-benchmark-target-identity
write_target native-host fixture-host; write_environment other-host; seal mutated-environment-host
expect_reason mutated-environment-host rust-go-benchmark-target-identity

# Supply every retained blob and a valid derived toolchain. The intentionally
# empty build-origin blob must then fail inside the lane validator, proving the
# signed importer reaches that checker rather than stopping at attachment load.
printf simple-compiler >"$work/evidence/simple-compiler.env"
printf rust-compiler >"$work/evidence/rust-compiler.env"
printf go-compiler >"$work/evidence/go-compiler.env"
printf 'simple version\n' >"$work/evidence/simple-version.env"
printf 'rust version\n' >"$work/evidence/rust-version.env"
printf 'go version\n' >"$work/evidence/go-version.env"
simple_compiler_sha=$(sha256sum "$work/evidence/simple-compiler.env" | awk '{print $1}')
rust_compiler_sha=$(sha256sum "$work/evidence/rust-compiler.env" | awk '{print $1}')
go_compiler_sha=$(sha256sum "$work/evidence/go-compiler.env" | awk '{print $1}')
simple_version_sha=$(sha256sum "$work/evidence/simple-version.env" | awk '{print $1}')
rust_version_sha=$(sha256sum "$work/evidence/rust-version.env" | awk '{print $1}')
go_version_sha=$(sha256sum "$work/evidence/go-version.env" | awk '{print $1}')
toolchain_digest=$(printf 'simple=%s\nrust=%s\ngo=%s\nsimple-version=%s\nrust-version=%s\ngo-version=%s\n' "$simple_compiler_sha" "$rust_compiler_sha" "$go_compiler_sha" "$simple_version_sha" "$rust_version_sha" "$go_version_sha" | sha256sum | awk '{print $1}')
cat >"$work/evidence/toolchain.env" <<EOF
evidence_schema=simple.must-check-toolchain/v1
gate_id=rust-go-benchmark-parity
run_id=$run_id
toolchain_id=sha256:$toolchain_digest
simple_compiler_sha256=$simple_compiler_sha
simple_version_sha256=$simple_version_sha
rust_compiler_sha256=$rust_compiler_sha
rust_version_sha256=$rust_version_sha
go_compiler_sha256=$go_compiler_sha
go_version_sha256=$go_version_sha
final_verdict=PASS
EOF
: >"$work/evidence/build-origin.env"
for name in simple-executable rust-executable go-executable raw-samples statistics equivalence stage4-provenance; do printf placeholder >"$work/evidence/$name.env"; done
write_target native-host fixture-host; write_environment fixture-host; seal retained-build-origin-placeholders
expect_reason retained-build-origin-placeholders origin-field-count
echo 'PASS: signed benchmark target and build-origin wiring fail closed'
