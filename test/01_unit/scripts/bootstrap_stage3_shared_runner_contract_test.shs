#!/usr/bin/env bash
set -euo pipefail

repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
runner_source=$repo/scripts/check/lib/bootstrap-stage3-shared-runner.pl
runner_contract_source=$repo/scripts/check/lib/bootstrap-stage3/runner.shs
supervisor_source=$repo/scripts/check/lib/bootstrap-stage3-unit-supervisor.pl
gate_source=$repo/scripts/check/lib/bootstrap-stage3-unit-gate.shs
facade_source=$repo/scripts/check/lib/bootstrap-stage3-provenance.shs
authority_source=$repo/scripts/check/lib/bootstrap-stage3/authority.shs
manifest_verify_source=$repo/scripts/check/lib/bootstrap-stage3/manifest-verify.shs
provenance_verifier_source=$repo/scripts/check/lib/bootstrap-stage3-provenance-verifier.sh

# An unrelated inherited FD 159 is not the verifier's phase channel until the
# explicit option has been parsed and validated.
phase_guard=$(mktemp "${TMPDIR:-/tmp}/stage3-phase-guard.XXXXXX")
printf 'caller-owned\n' >"$phase_guard"
if "$provenance_verifier_source" --definitely-invalid \
    159>>"$phase_guard" >/dev/null 2>&1; then
    echo 'provenance verifier accepted an unknown option' >&2
    rm -f -- "$phase_guard"
    exit 1
fi
[ "$(cat "$phase_guard")" = caller-owned ] || {
    echo 'provenance verifier corrupted an unvalidated inherited fd159' >&2
    rm -f -- "$phase_guard"
    exit 1
}
rm -f -- "$phase_guard"

# Manifest verification uses fixed internal pin numbers, but its public
# subshell boundary must preserve descriptors owned by a sourced caller.
fd_guard=$(mktemp -d "${TMPDIR:-/tmp}/stage3-fd-guard.XXXXXX")
for fd_guard_number in 6 7 8 9; do
    : >"$fd_guard/fd$fd_guard_number"
done
exec 6<>"$fd_guard/fd6" 7<>"$fd_guard/fd7" \
    8<>"$fd_guard/fd8" 9<>"$fd_guard/fd9"
. "$manifest_verify_source"
bootstrap_stage3_verify_manifest >/dev/null 2>&1 || :
for fd_guard_number in 6 7 8 9; do
    [ "/proc/$$/fd/$fd_guard_number" -ef "$fd_guard/fd$fd_guard_number" ] || {
        echo "manifest verifier clobbered caller fd$fd_guard_number" >&2
        exit 1
    }
done
exec 6>&- 7>&- 8>&- 9>&-
rm -rf -- "$fd_guard"
if grep -Eq '/proc/(self|\$\$)/fd/[6789]' "$manifest_verify_source"; then
    echo 'manifest verifier lacks stable numeric subshell-owned pins' >&2
    exit 1
fi
subshell_pin=$(mktemp "${TMPDIR:-/tmp}/stage3-subshell-pin.XXXXXX")
(
    IFS=' ' read -r subshell_pin_pid subshell_pin_rest </proc/self/stat
    case "$subshell_pin_pid" in ''|0|*[!0-9]*) exit 1 ;; esac
    exec 8<"$subshell_pin"
    [ "/proc/$subshell_pin_pid/fd/8" -ef "$subshell_pin" ]
    [ "$subshell_pin_pid" != "$$" ] || exit 1
    stat -Lc '%d %i %f %s' "/proc/$subshell_pin_pid/fd/8" >/dev/null
    sha256sum "/proc/$subshell_pin_pid/fd/8" >/dev/null
) || {
    echo 'manifest verifier subshell-local procfd model failed' >&2
    rm -f -- "$subshell_pin"
    exit 1
}
rm -f -- "$subshell_pin"
grep -Fq 'bootstrap_stage3_validate_descriptor_map()' "$authority_source" || {
    echo 'production descriptor-map validator missing from captured authority module' >&2
    exit 1
}
grep -Fq 'bootstrap_stage3_descriptor_map_value()' "$authority_source" || {
    echo 'production descriptor-map accessor missing from captured authority module' >&2
    exit 1
}
grep -Fq 'stat -Lc '\''%d %i %a'\'' "$bootstrap_stage3_expected_output"' \
    "$manifest_verify_source" || {
    echo 'manifest verifier expected-output identity bridge missing' >&2
    exit 1
}
grep -Fq '[ "$(bootstrap_stage3_map_value output_ino)" = "$2" ]' \
    "$manifest_verify_source" || {
    echo 'manifest verifier same-content distinct-inode rejection missing' >&2
    exit 1
}
grep -Fq '[ "$(bootstrap_stage3_hash_file "$bootstrap_stage3_expected_output")" = \' \
    "$manifest_verify_source" || {
    echo 'manifest verifier expected-output hash bridge missing' >&2
    exit 1
}
if grep -Fq '[ "$bootstrap_stage3_output" = "$bootstrap_stage3_expected_output" ]' \
    "$manifest_verify_source"; then
    echo 'manifest verifier compares independent descriptor spellings' >&2
    exit 1
fi
verifier_launch_source=$(sed -n '/^sub capture_verifier {/,/^\$SIG{TERM}/p' "$runner_source")
grep -Fq 'dirname($o{candidate_output}) .' <<<"$verifier_launch_source" &&
    grep -Fq '"/stage3-command.transcript",' <<<"$verifier_launch_source" || {
    echo 'verifier launch lacks canonical Stage3 transcript display' >&2
    exit 1
}
if grep -Fq '$held{stage3_transcript}[1]{path}' \
    <<<"$verifier_launch_source"; then
    echo 'verifier launch uses transcript authority as display' >&2
    exit 1
fi
grep -Fq 'return "/proc/$$/fd/$target_fd";' <<<"$verifier_launch_source" || {
    echo 'verifier launch does not use verifier-local authority descriptors' >&2
    exit 1
}
[ "$(printf '%s\n' "$verifier_launch_source" | grep -c '=> \$verifier_local_path->')" = 31 ] || {
    echo 'verifier launch local descriptor transfer count mismatch' >&2
    exit 1
}
[ "$(printf '%s\n' "$verifier_launch_source" | grep -c \
    '\$verifier_self_path->(\$verifier_local{')" = 2 ] || {
    echo 'verifier launch self descriptor path count mismatch' >&2
    exit 1
}
verifier_authority_path_count=$((
    $(printf '%s\n' "$verifier_launch_source" | grep -c \
        '=> \$verifier_local_path->') - 2
))
[ "$verifier_authority_path_count" = 29 ] || {
    echo 'verifier launch authority descriptor path count mismatch' >&2
    exit 1
}
grep -Fq '$^F = $verifier_last_fd;' <<<"$verifier_launch_source" || {
    echo 'verifier launch Perl descriptor ceiling missing' >&2
    exit 1
}
if grep -Eq 'fd-adopt|fd-flags|open\(my \$local_fh,' \
    <<<"$verifier_launch_source"; then
    echo 'verifier launch retains Perl target descriptor adoption' >&2
    exit 1
fi
grep -Fq 'stat("/proc/self/fd/$target_fd")' \
    <<<"$verifier_launch_source" || {
    echo 'verifier launch raw target identity validation missing' >&2
    exit 1
}
grep -Fq '"--verifier-script-descriptor=$verifier_local{script}",' \
    <<<"$verifier_launch_source" || {
    echo 'verifier script is not delivered through descriptor-bound stdin' >&2
    exit 1
}
grep -Fq 'my $verifier_staging_min = 191;' \
    <<<"$verifier_launch_source" || {
    echo 'verifier launch is not compatible with a 256-descriptor soft limit' >&2
    exit 1
}
if grep -q 'verifier_open_max.*> 256' <<<"$verifier_launch_source"; then
    echo 'verifier launch retains a hard descriptor limit above 256' >&2
    exit 1
fi
grep -Fq 'pipe(my $setup_read_fh, my $setup_write_fh)' \
    <<<"$verifier_launch_source" || {
    echo 'verifier launch setup-status pipe missing' >&2
    exit 1
}
grep -Fq "syswrite(\$setup_write_fh, 'S', 1)" \
    <<<"$verifier_launch_source" || {
    echo 'verifier launch stream-proof byte missing' >&2
    exit 1
}
grep -Fq "syswrite(\$setup_write_fh, 'R', 1)" \
    <<<"$verifier_launch_source" || {
    echo 'verifier launch readiness byte missing' >&2
    exit 1
}
grep -Fq '$setup_bytes =~ /\ASR/' <<<"$verifier_launch_source" || {
    echo 'verifier launch stream readiness protocol mismatch' >&2
    exit 1
}
grep -Fq "substr(\$setup_bytes, -1, 1) eq 'c'" \
    <<<"$verifier_launch_source" || {
    echo 'verifier launch receipt phase protocol mismatch' >&2
    exit 1
}
grep -Fq "'--phase-status-fd=159'" <<<"$verifier_launch_source" || {
    echo 'verifier launch phase status descriptor option missing' >&2
    exit 1
}
if grep -q 'parent_fd_path' <<<"$verifier_launch_source"; then
    echo 'verifier argv retains a foreign parent descriptor path' >&2
    exit 1
fi
fixture=$(mktemp -d "${TMPDIR:-/tmp}/stage3-shared-runner.XXXXXX")
fixture_parent=$(CDPATH= cd -- "$(dirname -- "$fixture")" && pwd -P)
read -r fixture_dev fixture_ino fixture_uid < <(
    stat -Lc '%d %i %u' "$fixture"
)
mutation_pid=
holder_pid=
holder_job_pid=
cleanup() {
    cleanup_status=$?
    if [ -n "$mutation_pid" ]; then
        kill "$mutation_pid" 2>/dev/null || true
        wait "$mutation_pid" 2>/dev/null || true
    fi
    if [ -n "$holder_pid" ]; then
        kill "$holder_pid" 2>/dev/null || true
    fi
    if [ -n "$holder_job_pid" ]; then
        wait "$holder_job_pid" 2>/dev/null || true
    fi
    if [ "$cleanup_status" -eq 0 ]; then
        [[ -n $fixture && ! -L $fixture && -d $fixture ]] &&
            [[ $(CDPATH= cd -- "$(dirname -- "$fixture")" && pwd -P) == \
                "$fixture_parent" ]] &&
            [[ $(basename -- "$fixture") =~ \
                ^stage3-shared-runner\.[A-Za-z0-9]{6}$ ]] &&
            [[ $(stat -Lc '%d %i %u' "$fixture") == \
                "$fixture_dev $fixture_ino $fixture_uid" ]] || return 1
        if find -P "$fixture" -xdev -type d ! -uid "$fixture_uid" \
            -print -quit | grep -q .; then
            return 1
        fi
        find -P "$fixture" -xdev -type d \
            -exec chmod u+rwx -- {} + || return 1
        rm -rf -- "$fixture"
    else
        printf 'stage3 shared runner fixture retained: %s\n' "$fixture" >&2
    fi
    return "$cleanup_status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

runner_under_test=$runner_source
if [ "${STAGE3_TEST_POST_ANALYZER_SIGNAL:-}" = TERM ]; then
    runner_under_test=$fixture/shared-runner-post-analyzer-signal.pl
    cp -- "$runner_source" "$runner_under_test"
    SIGNAL_ACK=$fixture/post-analyzer-signal.ack /usr/bin/perl -0pi -e '
        my $needle = q{my $analyzer_status = run_bound_child($analyzer_exec_fh, 120_000, @analyzer_argv);};
        my $replacement = $needle . qq{\nkill SIGTERM, \$\$;\nfor (1 .. 1000) { last if length(\$interrupted); select(undef, undef, undef, 0.001); }\nopen(my \$signal_ack, q{>}, q{$ENV{SIGNAL_ACK}}) or die qq{signal ack: \$!\\n};\nprint {\$signal_ack} \$interrupted, qq{\\n};\nclose(\$signal_ack) or die qq{signal ack close: \$!\\n};};
        index($_, $needle) >= 0 or die "analyzer boundary absent\n";
        s/\Q$needle\E/$replacement/ or die "analyzer boundary mutation failed\n";
    ' "$runner_under_test"
    chmod 0500 "$runner_under_test"
fi

sha() { sha256sum -- "$1" | awk '{print $1}'; }
tool_path=$(dirname -- "$(command -v cargo)"):/usr/bin
copy_role() {
    local name=$1 source=$2
    cp -- "$source" "$roles/$name"
    chmod 0500 "$roles/$name"
}

root=$fixture/root
unit=$fixture/unit
roles=$fixture/role-source
input=$fixture/input
output_rel=build/fake-stage3-output
output=$root/$output_rel
stage2_transaction=$fixture/stage2-transaction
stage2_transaction_display=$stage2_transaction
architecture=x86_64-unknown-linux-gnu
stage3=$output/stage3/$architecture
admitted=$stage3/stage2-admitted/simple
candidate=$stage3/simple
candidate_provenance=$stage3/provenance.env
raw=$unit/process-rss.events
memory=$unit/memory.events
phase=$unit/phase.events
descriptor=$input/descriptor.events
parent_provenance=$input/admitted-provenance.env
parent_verify=$input/admitted-provenance-verification.env
source_snapshot=$input/source-snapshot.txt
git_receipt=$input/git-receipt.env
runtime_snapshot=$input/runtime-snapshot.txt
tool_snapshot=$input/tool-snapshot.txt
stage2_admission=$input/stage2-admission.env
planner_receipt=$input/planner.env
cache=$stage3/stage3-native-cache
runtime=$stage3/stage2-runtime-authority
home=$stage3/stage3-home
tmpdir=$stage3/stage3-tmp
progress=$output/bootstrap-build-progress.events
compatibility_marker=$output.lock
run_id=runner_contract_001
heavy_lock=$fixture/authority/heavy.lock
owner_journal=$fixture/authority/owner.env
quarantine=$fixture/authority/quarantine.env
cgroup_root=$fixture/fake-cgroup
fake_state=$fixture/fake-systemd
admitted_marker=$fixture/admitted-compiler-executed

mkdir -p "$roles" "$stage3/stage2-admitted" "$cache" "$runtime" \
    "$home" "$tmpdir" "$(dirname -- "$progress")" "$fixture/authority" \
    "$cgroup_root" "$fake_state/units" "$input" \
    "$root/scripts/bootstrap" "$root/scripts/check/lib/bootstrap-stage3" \
    "$root/scripts/check/cert/redeploy_gate" "$root/src/compiler" \
    "$root/src/app" "$root/src/lib" "$root/examples/10_tooling" \
    "$root/src/compiler_rust" "$root/src/runtime" "$stage2_transaction"
coproc STAGE2_HOLDER {
    exec /usr/bin/python3 - "$stage2_transaction" <<'PY'
import os
import signal
import sys

fd = os.open(sys.argv[1], os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
if fd != 8:
    os.dup2(fd, 8, inheritable=False)
    os.close(fd)
else:
    os.set_inheritable(8, False)
print(f"ready {os.getpid()} 8", flush=True)
while True:
    signal.pause()
PY
}
holder_job_pid=$STAGE2_HOLDER_PID
read -r holder_ready holder_pid holder_fd <&"${STAGE2_HOLDER[0]}"
[ "$holder_ready" = ready ]
case "$holder_pid:$holder_fd" in *[!0-9:]*|:*) exit 1 ;; esac
[ "$holder_fd" = 8 ]
stage2_transaction=/proc/$holder_pid/fd/$holder_fd
[ -d "$stage2_transaction" ]
cat >"$fixture/fake-compiler.c" <<EOF
#include <fcntl.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>
static int has(const char *s, const char *needle) { return s && strstr(s, needle); }
static int copy_self(const char *self, const char *out) {
    char buf[65536]; ssize_t n; int in = open(self, O_RDONLY), fd;
    if (in < 0) return 64;
    fd = open(out, O_WRONLY | O_CREAT | O_TRUNC, 0500);
    if (fd < 0) return 64;
    while ((n = read(in, buf, sizeof buf)) > 0) {
        char *p = buf; ssize_t left = n;
        while (left && (n = write(fd, p, left)) > 0) { p += n; left -= n; }
        if (left) return 64;
    }
    if (n < 0 || close(in) || close(fd) || chmod(out, 0500)) return 64;
    return 0;
}
static int script(const char *out, const char *body) {
    FILE *f = fopen(out, "w");
    if (!f) return 64;
    if (fprintf(f, "#!/bin/sh\\n%s", body) < 0 || fclose(f) || chmod(out, 0500)) return 64;
    return 0;
}
int main(int argc, char **argv) {
    FILE *marker = fopen("$admitted_marker", "w");
    if (marker) { fputs("executed\\n", marker); fclose(marker); }
    if (argc > 1 && !strcmp(argv[1], "--version")) {
        puts("simple-bootstrap 1.0.0-rc.1"); return 0;
    }
    if (argc > 1 && !strcmp(argv[1], "run")) {
        fputs("unknown command 'run'\\n", stderr); return 1;
    }
    if (argc > 1 && !strcmp(argv[1], "native-build")) {
        const char *out = NULL, *entry = NULL;
        for (int i = 2; i < argc; ++i) {
            if ((!strcmp(argv[i], "-o") || !strcmp(argv[i], "--output")) && i + 1 < argc) out = argv[++i];
            else if (!strcmp(argv[i], "--entry") && i + 1 < argc) entry = argv[++i];
            else if (has(argv[i], ".spl")) entry = argv[i];
        }
        if (!out) return 64;
        if (has(entry, "p2_add.spl")) return script(out, "printf '%s\\n' 5\\n");
        if (has(entry, "stage2_mir_retention.spl")) return script(out, "printf '%s\\n' 3\\n");
        if (has(entry, "stage2_module_path_naming.spl")) return script(out, "printf '%s\\n' app.cli.bootstrap_main compiler.driver.driver app.cli.main\\n");
        if (has(entry, "hello_world.spl")) return script(out, "printf '%s\\n' hello\\n");
        return copy_self(argv[0], out);
    }
    if (argc == 1) { puts("5"); return 0; }
    for (int i = 1; i < argc; ++i) {
        if (has(argv[i], "p2_add.spl")) { puts("5"); return 0; }
        if (has(argv[i], "stage2_mir_retention.spl")) { puts("3"); return 0; }
        if (has(argv[i], "stage2_module_path_naming.spl")) { puts("alpha\\nbeta\\ngamma"); return 0; }
        if (has(argv[i], "hello_world.spl")) { puts("hello"); return 0; }
    }
    return 64;
}
EOF
cc -std=c11 -O0 -o "$admitted" "$fixture/fake-compiler.c"
chmod 0500 "$admitted"
mkdir -p "$root/scripts/check/cert/redeploy_gate/fixtures"
for frontend_fixture in p2_add stage2_mir_retention \
    stage2_module_path_naming hello_world; do
    printf 'fixture %s\n' "$frontend_fixture" > \
        "$root/scripts/check/cert/redeploy_gate/fixtures/$frontend_fixture.spl"
done
for helper_relative in \
    scripts/bootstrap/bootstrap-build-jobs-policy.shs \
    scripts/bootstrap/run-process-group-bounded-log.pl \
    scripts/check/lib/bootstrap-stage3-provenance.shs \
    scripts/check/lib/bootstrap-stage3/authority.shs \
    scripts/check/lib/bootstrap-stage3/command-snapshot.shs \
    scripts/check/lib/bootstrap-stage3/sanity.shs \
    scripts/check/lib/bootstrap-stage3/manifest-write.shs \
    scripts/check/lib/bootstrap-stage3/manifest-verify.shs \
    scripts/check/lib/bootstrap-stage3/self-test.shs \
    scripts/check/lib/bootstrap-stage3/runner.shs \
    scripts/check/lib/bootstrap-planner-admission-bound.shs \
    scripts/check/cert/redeploy_gate/candidate_frontend_admission.shs; do
    cp -- "$repo/$helper_relative" "$root/$helper_relative"
done
chmod 0500 "$root/scripts/bootstrap/run-process-group-bounded-log.pl"
printf '%s\n' 'fixture source' >"$root/src/compiler/main.spl"
printf '%s\n' 'fixture app' >"$root/src/app/main.spl"
printf '%s\n' 'fixture lib' >"$root/src/lib/main.spl"
printf '%s\n' 'fixture tooling' >"$root/examples/10_tooling/main.spl"
printf '%s\n' '[workspace]' >"$root/src/compiler_rust/Cargo.toml"
printf '%s\n' '# fixture lock' >"$root/src/compiler_rust/Cargo.lock"
printf '%s\n' '[toolchain]' 'channel = "stable"' \
    >"$root/src/compiler_rust/rust-toolchain.toml"
mkdir -p "$root/release" "$root/src/app/cli"
cp -- "$repo/release/version.sdn" "$root/release/version.sdn"
cp -- "$repo/VERSION" "$root/VERSION"
cp -- "$repo/src/app/cli/bootstrap_identity.spl" \
    "$root/src/app/cli/bootstrap_identity.spl"
printf '%s\n' 'build/' '.stage3-verifier-scratch-*' >"$root/.gitignore"
git -C "$root" init -q
git -C "$root" config user.name 'Stage3 Contract Fixture'
git -C "$root" config user.email 'stage3-contract@example.invalid'
git -C "$root" add .
GIT_AUTHOR_DATE='2000-01-01T00:00:00Z' \
GIT_COMMITTER_DATE='2000-01-01T00:00:00Z' \
    git -C "$root" commit -q -m fixture
# The first sourced helper deterministically replaces both a later helper leaf
# and a later helper-module ancestor. The body succeeds only with held FDs.
cat >>"$root/scripts/bootstrap/bootstrap-build-jobs-policy.shs" <<MUTATE
mv '$unit/roles/facade' '$unit/roles/facade.captured'
printf '%s\n' 'mutable facade replacement must not be sourced' \
  >'$unit/roles/facade'
mv '$root/scripts/check/lib/bootstrap-stage3' \
  '$root/scripts/check/lib/bootstrap-stage3.captured'
mkdir '$root/scripts/check/lib/bootstrap-stage3'
printf '%s\n' 'mutable module replacement must not be sourced' \
  >'$root/scripts/check/lib/bootstrap-stage3/authority.shs'
MUTATE
for artifact in "$descriptor" "$parent_provenance" "$source_snapshot" \
    "$git_receipt" "$runtime_snapshot" "$tool_snapshot" \
    "$stage2_admission" "$planner_receipt"; do
    printf 'fixture=%s\n' "$(basename -- "$artifact")" >"$artifact"
    chmod 0400 "$artifact"
done

cat >"$fixture/fake-sampler.sh" <<'SAMPLER'
#!/bin/sh
set -eu
raw=
run_id=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --raw) raw=$2; shift 2 ;;
        --run-id) run_id=$2; shift 2 ;;
        --self-sha256|--sha256|--interval-ms|--max-gap-ms|--max-rss-kb|--term-grace-ms|--kill-grace-ms|--max-runtime-ms|--max-batches|--max-records|--max-raw-bytes|--max-tracked-per-batch|--closure-reserve-bytes|--closure-reserve-records)
            shift 2 ;;
        --) shift; break ;;
        run) shift ;;
        *) exit 64 ;;
    esac
done
candidate=
previous=
for argument in "$@"; do
    if [ "$previous" = -o ]; then candidate=$argument; break; fi
    previous=$argument
done
[ -n "$raw" ] && [ -n "$run_id" ] && [ -n "$candidate" ]
"$@"
( set -C; printf 'raw=%s\n' "$run_id" >"$raw" )
( set -C; printf 'memory=%s\n' "$run_id" >"$SIMPLE_MEM_SNAPSHOT_FILE" )
( set -C; printf 'phase=%s\n' "$run_id" >"$SIMPLE_COMPILER_PHASE_PROFILE_FILE" )
SAMPLER
chmod 0500 "$fixture/fake-sampler.sh"

cat >"$fixture/fake-candidate-builder.sh" <<'CANDIDATE_BUILDER'
#!/bin/sh
set -eu
backfill_mode=STAGE3_BACKFILL_MODE_PLACEHOLDER
source_output=
candidate=
stage3_display_root=
root=
run_id=
raw=
sampler=
sampler_sha=
admitted=
admitted_sha=
compatibility_marker=
stage2= stage2_admission= seed= seed_stamp= native_all= backfill=
stage2_sanity= stage2_sanity_companion_parent= stage2_receiver= stage2_receiver_log= stage2_transcript=
stage2_log= source_before= git_before= tool_before= runtime_before=
runtime_after= runtime_admitted= stage2_cache= stage3_cache= runtime=
home= tmpdir= jobs_receipt= manifest= stage3_transcript= stage3_log=
stage3_sanity= source_after= git_after= tool_after= progress=
for option in "$@"; do
    case "$option" in
        --repository-root=*) root=${option#*=} ;;
        --source-output-display=*) source_output=${option#*=} ;;
        --candidate-output=*) candidate=${option#*=} ;;
        --stage3-display-root=*) stage3_display_root=${option#*=} ;;
        --evidence-run-id=*) run_id=${option#*=} ;;
        --rss-raw=*) raw=${option#*=} ;;
        --rss-sampler=*) sampler=${option#*=} ;;
        --rss-sampler-sha256=*) sampler_sha=${option#*=} ;;
        --admitted-compiler=*) admitted=${option#*=} ;;
        --admitted-compiler-sha256=*) admitted_sha=${option#*=} ;;
        --compatibility-marker=*) compatibility_marker=${option#*=} ;;
        --stage2=*) stage2=${option#*=} ;;
        --stage2-admission=*) stage2_admission=${option#*=} ;;
        --seed=*) seed=${option#*=} ;;
        --seed-stamp=*) seed_stamp=${option#*=} ;;
        --native-all=*) native_all=${option#*=} ;;
        --compiler-backfill=*) backfill=${option#*=} ;;
        --stage2-sanity=*) stage2_sanity=${option#*=} ;;
        --stage2-sanity-companion-parent=*) stage2_sanity_companion_parent=${option#*=} ;;
        --stage2-receiver=*) stage2_receiver=${option#*=} ;;
        --stage2-receiver-log=*) stage2_receiver_log=${option#*=} ;;
        --stage2-transcript=*) stage2_transcript=${option#*=} ;;
        --stage2-build-log=*) stage2_log=${option#*=} ;;
        --source-before=*) source_before=${option#*=} ;;
        --git-before=*) git_before=${option#*=} ;;
        --tool-before=*) tool_before=${option#*=} ;;
        --runtime-origin-before=*) runtime_before=${option#*=} ;;
        --runtime-origin-after=*) runtime_after=${option#*=} ;;
        --runtime-admitted=*) runtime_admitted=${option#*=} ;;
        --stage2-cache-dir=*) stage2_cache=${option#*=} ;;
        --stage3-cache-dir=*) stage3_cache=${option#*=} ;;
        --runtime-dir=*) runtime=${option#*=} ;;
        --private-home=*) home=${option#*=} ;;
        --private-tmp=*) tmpdir=${option#*=} ;;
        --jobs-receipt=*) jobs_receipt=${option#*=} ;;
        --candidate-provenance=*) manifest=${option#*=} ;;
        --stage3-transcript=*) stage3_transcript=${option#*=} ;;
        --stage3-build-log=*) stage3_log=${option#*=} ;;
        --stage3-sanity=*) stage3_sanity=${option#*=} ;;
        --source-after=*) source_after=${option#*=} ;;
        --git-after=*) git_after=${option#*=} ;;
        --tool-after=*) tool_after=${option#*=} ;;
        --progress=*) progress=${option#*=} ;;
    esac
done
[ -n "$source_output" ] && [ -n "$candidate" ] && \
    [ -n "$stage3_display_root" ] || exit 64
"$sampler" run --raw "$raw" --self-sha256 "$sampler_sha" \
    --sha256 "$admitted_sha" --run-id "$run_id" --interval-ms 5 \
    --max-gap-ms 50 --max-rss-kb 8388608 --term-grace-ms 5000 \
    --kill-grace-ms 10000 --max-runtime-ms 3600000 --max-batches 1000000 \
    --max-records 16000000 --max-raw-bytes 1073741824 \
    --max-tracked-per-batch 4096 --closure-reserve-bytes 65536 \
    --closure-reserve-records 256 -- "$admitted" native-build --target \
    "$SIMPLE_NATIVE_BUILD_TARGET" --backend cranelift --runtime-bundle \
    core-c-bootstrap --threads 1 --cache-dir "$SIMPLE_NATIVE_BUILD_CACHE_DIR" \
    --mode dynload --runtime-path "$runtime" -o "$candidate" \
    src/app/cli/bootstrap_main.spl

stage2_admitted=$admitted
provenance=$manifest
lock=$compatibility_marker
printf '%s\n' 'stage3 build log' >"$stage3_log"
printf '%s\n' \
    'schema=simple-bootstrap-effective-build-jobs-v1' \
    'owner=resume-stage3-from-admitted' 'requested=1' 'effective=1' \
    'cache_writer_policy=single-native-build-owner' \
    'parallel_cache_writers=false' >"$jobs_receipt"

bootstrap_stage3_source_snapshot "$source_after" "$root"
# The contract deliberately replaces display-tree helpers after the runner has
# captured its authority descriptors.  Preserve the descriptor-bound Stage2
# Git authority here so that this fixture tests that race rather than reporting
# its intentional display-tree mutation as a source revision change.
cp -- "$git_before" "$git_after"
bootstrap_stage3_tool_authority_snapshot "$tool_after" "$PATH" "$root"
seed_features=none
seed_fingerprint=$(bootstrap_stage3_manifest_value inputs_fingerprint "$seed_stamp")
stage2_display_root=$source_output/output/stage3/$SIMPLE_NATIVE_BUILD_TARGET
stage2_runtime_display=$stage2_display_root/stage2-runtime-authority
stage3_output_display=${stage3_display_root%/stage3/$SIMPLE_NATIVE_BUILD_TARGET}
stage3_home_display=$stage3_display_root/stage3-home
stage3_tmp_display=$stage3_display_root/stage3-tmp
stage3_progress_display=$stage3_output_display/bootstrap-build-progress.events
stage3_profile_display=$stage3_display_root/phase-profile-v1.events
stage3_memory_display=$stage3_display_root/memory-snapshot-v1.events

stage2_args_sha=$(bootstrap_stage3_manifest_value build_args_sha256 \
    "$stage2_admission")
printf '%s\n' "$stage2_args_sha" | grep -Eq '^[0-9a-f]{64}$'
stage3_args_sha=$(bootstrap_stage3_args_sha256 \
    'RUST_LOG=error' 'LIBRARY_PATH=' \
    'SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=absent' 'SIMPLE_BOOTSTRAP=1' \
    'SIMPLE_NO_DEPRECATED_WARNINGS=1' \
    'SIMPLE_STAGE3_STREAMING_SURFACES=1' 'SIMPLE_FRONTEND_CACHE=0' \
    'MALLOC_ARENA_MAX=2' \
    'MALLOC_TRIM_THRESHOLD_=0' 'SIMPLE_NATIVE_ARENA_DECLS=1' \
    'SIMPLE_NO_STUB_FALLBACK=1' \
    "SIMPLE_BUILD_PROGRESS_EVENTS=$stage3_progress_display" \
    'SIMPLE_COMPILER_PHASE_PROFILE=1' \
    "SIMPLE_COMPILER_PHASE_PROFILE_FILE=$stage3_profile_display" \
    "SIMPLE_MEM_SNAPSHOT_FILE=$stage3_memory_display" \
    "SIMPLE_EVIDENCE_RUN_ID=$run_id" \
    'LLVM_DISABLE_ABI_BREAKING_CHECKS_ENFORCING=1' \
    "SIMPLE_NATIVE_BUILD_TARGET=$SIMPLE_NATIVE_BUILD_TARGET" \
    'SIMPLE_NATIVE_BUILD_THREADS=1' \
    "SIMPLE_NATIVE_BUILD_CACHE_DIR=$stage3_display_root/stage3-native-cache" \
    "SIMPLE_RUNTIME_PATH=$stage2_runtime_display" \
    'SIMPLE_NATIVE_RUNTIME_BUNDLE=core-c-bootstrap' \
    "SIMPLE_BINARY=$stage2_display_root/stage2-admitted/simple" native-build \
    --target "$SIMPLE_NATIVE_BUILD_TARGET" --backend cranelift \
    --runtime-bundle core-c-bootstrap --threads 1 --timeout 3600 \
    --cache-dir "$stage3_display_root/stage3-native-cache" \
    --mode dynload --runtime-path "$stage2_runtime_display" \
    -o "$stage3_display_root/simple" \
    src/app/cli/bootstrap_main.spl)

bootstrap_stage3_write_command_transcript "$stage3_transcript" "$root" \
    "$stage3_home_display" "$stage3_tmp_display" "$PATH" 'RUST_LOG=error' 'LIBRARY_PATH=' \
    'SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=absent' 'SIMPLE_BOOTSTRAP=1' \
    'SIMPLE_NO_DEPRECATED_WARNINGS=1' \
    'SIMPLE_STAGE3_STREAMING_SURFACES=1' 'SIMPLE_FRONTEND_CACHE=0' \
    'MALLOC_ARENA_MAX=2' \
    'MALLOC_TRIM_THRESHOLD_=0' 'SIMPLE_NATIVE_ARENA_DECLS=1' \
    'SIMPLE_NO_STUB_FALLBACK=1' \
    "SIMPLE_BUILD_PROGRESS_EVENTS=$stage3_progress_display" \
    'SIMPLE_COMPILER_PHASE_PROFILE=1' \
    "SIMPLE_COMPILER_PHASE_PROFILE_FILE=$stage3_profile_display" \
    "SIMPLE_MEM_SNAPSHOT_FILE=$stage3_memory_display" \
    "SIMPLE_EVIDENCE_RUN_ID=$run_id" \
    'LLVM_DISABLE_ABI_BREAKING_CHECKS_ENFORCING=1' \
    "SIMPLE_NATIVE_BUILD_TARGET=$SIMPLE_NATIVE_BUILD_TARGET" \
    'SIMPLE_NATIVE_BUILD_THREADS=1' \
    "SIMPLE_NATIVE_BUILD_CACHE_DIR=$stage3_display_root/stage3-native-cache" \
    "SIMPLE_RUNTIME_PATH=$stage2_runtime_display" \
    'SIMPLE_NATIVE_RUNTIME_BUNDLE=core-c-bootstrap' \
    "SIMPLE_BINARY=$stage2_display_root/stage2-admitted/simple" -- \
    "$stage2_display_root/stage2-admitted/simple" native-build \
    --target "$SIMPLE_NATIVE_BUILD_TARGET" --backend cranelift \
    --runtime-bundle core-c-bootstrap --threads 1 --timeout 3600 \
    --cache-dir "$stage3_display_root/stage3-native-cache" \
    --mode dynload --runtime-path "$stage2_runtime_display" \
    -o "$stage3_display_root/simple" \
    src/app/cli/bootstrap_main.spl

write_sanity_receipt() {
    sanity_path=$1
    sanity_display=$2
    sanity_candidate=$3
    frontend_log="$sanity_path.frontend-driver.log"
    frontend_log_display="$sanity_display.frontend-driver.log"
    : >"$frontend_log"
    for frontend_mode in 0 1; do
        mode_log="$sanity_path.frontend-bootstrap-$frontend_mode.log"
        mode_log_display="$sanity_display.frontend-bootstrap-$frontend_mode.log"
        mode_status="$sanity_path.frontend-bootstrap-$frontend_mode.status.env"
        CANDIDATE_FRONTEND_ROOT="$root" CANDIDATE_FRONTEND_BACKEND=cranelift \
        CANDIDATE_FRONTEND_BOOTSTRAP="$frontend_mode" \
        CANDIDATE_FRONTEND_LOG_PATH="$mode_log" \
        CANDIDATE_FRONTEND_LOG_DISPLAY_PATH="$mode_log_display" \
        CANDIDATE_FRONTEND_STATUS_PATH="$mode_status" \
            candidate_frontend_smoke "$sanity_candidate" >>"$frontend_log" 2>&1
    done
    frontend_sha=$(bootstrap_stage3_hash_file "$frontend_log")
    unsupported_status=0
    unsupported_output=$("$sanity_candidate" run \
        scripts/check/cert/redeploy_gate/fixtures/p2_add.spl 2>&1) || \
        unsupported_status=$?
    [ "$unsupported_status" = 1 ]
    candidate_sha=$(bootstrap_stage3_hash_file "$sanity_candidate")
    printf '%s\n' 'schema=simple-bootstrap-sanity-evidence-v1' 'status=pass' \
        "candidate_sha256_before=$candidate_sha" 'version_status=0' \
        'version_expected=1.0.0-rc.1' 'version_expect_status=0' \
        'version_match_status=0' \
        'version_output=simple-bootstrap 1.0.0-rc.1' \
        'unsupported_status=1' \
        "unsupported_output_sha256=$(printf '%s' "$unsupported_output" | bootstrap_stage3_hash_stream)" \
        'frontend_smoke_status=0' 'frontend_smoke_backend=cranelift' \
        'frontend_smoke_bootstrap_mode_status=0' \
        'frontend_smoke_bootstrap0_raw_status=0' \
        "frontend_smoke_bootstrap0_log_path=$sanity_display.frontend-bootstrap-0.log" \
        "frontend_smoke_bootstrap0_log_sha256=$(bootstrap_stage3_hash_file "$sanity_path.frontend-bootstrap-0.log")" \
        "frontend_smoke_bootstrap0_status_path=$sanity_display.frontend-bootstrap-0.status.env" \
        "frontend_smoke_bootstrap0_status_sha256=$(bootstrap_stage3_hash_file "$sanity_path.frontend-bootstrap-0.status.env")" \
        'frontend_smoke_bootstrap1_ran=true' 'frontend_smoke_bootstrap1_raw_status=0' \
        "frontend_smoke_bootstrap1_log_path=$sanity_display.frontend-bootstrap-1.log" \
        "frontend_smoke_bootstrap1_log_sha256=$(bootstrap_stage3_hash_file "$sanity_path.frontend-bootstrap-1.log")" \
        "frontend_smoke_bootstrap1_status_path=$sanity_display.frontend-bootstrap-1.status.env" \
        "frontend_smoke_bootstrap1_status_sha256=$(bootstrap_stage3_hash_file "$sanity_path.frontend-bootstrap-1.status.env")" \
        "frontend_smoke_output_sha256=$frontend_sha" \
        "frontend_smoke_driver_log_path=$frontend_log_display" \
        "frontend_smoke_driver_log_sha256=$frontend_sha" \
        "candidate_sha256_after=$candidate_sha" >"$sanity_path"
}
write_sanity_receipt "$stage3_sanity" \
    "$stage3_display_root/stage3-sanity.env" "$candidate"

BSTAGE3_ROOT=$root BSTAGE3_MANIFEST=$provenance \
BSTAGE3_MANIFEST_DISPLAY=$stage3_display_root/provenance.env \
BSTAGE3_PLATFORM=$SIMPLE_NATIVE_BUILD_TARGET BSTAGE3_BACKEND=cranelift \
BSTAGE3_MODE=dynload BSTAGE3_RUST_LOG=error BSTAGE3_SEED=$seed \
BSTAGE3_SEED_DISPLAY=$stage2_runtime_display/simple \
BSTAGE3_NATIVE_ALL=$native_all BSTAGE3_BACKFILL=$backfill \
BSTAGE3_NATIVE_ALL_DISPLAY=$stage2_runtime_display/libsimple_native_all.a \
BSTAGE3_BACKFILL_DISPLAY=$stage2_runtime_display/libsimple_compiler_backfill.a \
BSTAGE3_SEED_STAMP=$seed_stamp BSTAGE3_SEED_STAMP_DISPLAY=$stage2_runtime_display/simple.inputs.sha256 \
BSTAGE3_HELPER=$BOOTSTRAP_STAGE3_FACADE_PATH \
BSTAGE3_HELPER_DISPLAY=$root/scripts/check/lib/bootstrap-stage3-provenance.shs \
BSTAGE3_HELPER_SHA256_BEFORE=$(bootstrap_stage3_hash_file \
    "$BOOTSTRAP_STAGE3_FACADE_PATH") \
BSTAGE3_HELPER_BUNDLE_FINGERPRINT_BEFORE=$(bootstrap_stage3_helper_bundle_fingerprint) \
BSTAGE3_STAGE2=$stage2 BSTAGE3_STAGE2_ADMITTED=$stage2_admitted \
BSTAGE3_STAGE2_DISPLAY=$source_output/output/stage2/$SIMPLE_NATIVE_BUILD_TARGET/simple \
BSTAGE3_STAGE2_ADMITTED_DISPLAY=$stage2_display_root/stage2-admitted/simple \
BSTAGE3_STAGE2_ADMISSION=$stage2_admission \
BSTAGE3_STAGE2_ADMISSION_DISPLAY=$stage2_display_root/stage2-admitted/admission.env \
BSTAGE3_STAGE3=$candidate BSTAGE3_STAGE3_DISPLAY=$stage3_display_root/simple \
BSTAGE3_SOURCE_BEFORE=$source_before BSTAGE3_SOURCE_BEFORE_DISPLAY=$stage2_display_root/source-inputs-before.txt \
BSTAGE3_SOURCE_AFTER=$source_after BSTAGE3_SOURCE_AFTER_DISPLAY=$stage3_display_root/source-inputs-after.txt \
BSTAGE3_STAGE2_LOG=$stage2_log BSTAGE3_STAGE2_LOG_DISPLAY=$source_output/output/logs/$SIMPLE_NATIVE_BUILD_TARGET/stage2-native-build.log \
BSTAGE3_STAGE3_LOG=$stage3_log BSTAGE3_STAGE3_LOG_DISPLAY=$stage3_display_root/stage3-build.log \
BSTAGE3_STAGE2_ARGS_SHA256=$stage2_args_sha \
BSTAGE3_STAGE3_ARGS_SHA256=$stage3_args_sha \
BSTAGE3_BOOTSTRAP_SCRIPT=$BOOTSTRAP_STAGE3_BOOTSTRAP_SCRIPT_DESCRIPTOR \
BSTAGE3_BOOTSTRAP_SCRIPT_DISPLAY=$root/scripts/bootstrap/bootstrap-from-scratch.sh \
BSTAGE3_BOOTSTRAP_SCRIPT_SHA256_BEFORE=$(bootstrap_stage3_hash_file \
    "$BOOTSTRAP_STAGE3_BOOTSTRAP_SCRIPT_DESCRIPTOR") \
BSTAGE3_STAGE2_THREADS=1 BSTAGE3_STAGE3_THREADS=1 \
BSTAGE3_STAGE2_CACHE_DIR=$stage2_cache BSTAGE3_STAGE2_CACHE_DIR_DISPLAY=$stage2_display_root/stage2-native-cache \
BSTAGE3_STAGE3_CACHE_DIR=$stage3_cache BSTAGE3_STAGE3_CACHE_DIR_DISPLAY=$stage3_display_root/stage3-native-cache \
BSTAGE3_RUNTIME_PATH=$runtime BSTAGE3_RUNTIME_PATH_DISPLAY=$stage2_runtime_display \
BSTAGE3_STAGE2_COMMAND_OUTPUT=$stage2 \
BSTAGE3_STAGE3_COMMAND_OUTPUT=$candidate \
BSTAGE3_SEED_INPUTS_FINGERPRINT=$seed_fingerprint \
BSTAGE3_SEED_FEATURES=$seed_features BSTAGE3_GIT_BEFORE=$git_before \
BSTAGE3_GIT_AFTER=$git_after BSTAGE3_GIT_AFTER_DISPLAY=$stage3_display_root/git-state-after.env \
BSTAGE3_STAGE2_TRANSCRIPT=$stage2_transcript BSTAGE3_STAGE2_TRANSCRIPT_DISPLAY=$stage2_display_root/stage2-command.transcript \
BSTAGE3_STAGE3_TRANSCRIPT=$stage3_transcript BSTAGE3_STAGE3_TRANSCRIPT_DISPLAY=$stage3_display_root/stage3-command.transcript \
BSTAGE3_STAGE2_SANITY=$stage2_sanity BSTAGE3_STAGE2_SANITY_DISPLAY=$stage2_display_root/stage2-sanity.env \
BSTAGE3_STAGE2_SANITY_COMPANION_PARENT=$stage2_sanity_companion_parent \
BSTAGE3_STAGE2_SANITY_COMPANION_PARENT_DISPLAY=$stage2_display_root \
BSTAGE3_STAGE2_RECEIVER=$stage2_receiver BSTAGE3_STAGE2_RECEIVER_DISPLAY=$stage2_display_root/stage2-receiver.env \
BSTAGE3_STAGE2_RECEIVER_LOG=$stage2_receiver_log BSTAGE3_STAGE2_RECEIVER_LOG_DISPLAY=$stage2_display_root/stage2-receiver.log \
BSTAGE3_STAGE3_SANITY=$stage3_sanity BSTAGE3_STAGE3_SANITY_DISPLAY=$stage3_display_root/stage3-sanity.env \
BSTAGE3_STAGE3_SANITY_COMPANION_PARENT=$(dirname -- "$stage3_sanity") \
BSTAGE3_STAGE3_SANITY_COMPANION_PARENT_DISPLAY=$stage3_display_root \
BSTAGE3_RUNTIME_ORIGIN_BEFORE=$runtime_before \
BSTAGE3_RUNTIME_ORIGIN_AFTER=$runtime_after BSTAGE3_RUNTIME_ORIGIN_AFTER_DISPLAY=$stage2_display_root/runtime-origin-after.txt \
BSTAGE3_RUNTIME_ADMITTED_SNAPSHOT=$runtime_admitted BSTAGE3_RUNTIME_ADMITTED_DISPLAY=$stage2_display_root/runtime-admitted.txt \
BSTAGE3_TOOL_AUTHORITY=$tool_after BSTAGE3_TOOL_AUTHORITY_DISPLAY=$stage3_display_root/tool-authority-after.txt \
BSTAGE3_TOOL_AUTHORITY_BEFORE=$tool_before BSTAGE3_TOOL_AUTHORITY_BEFORE_DISPLAY=$stage2_display_root/tool-authority-before.txt \
BSTAGE3_JOBS_RECEIPT=$jobs_receipt BSTAGE3_JOBS_RECEIPT_DISPLAY=$stage3_display_root/effective-build-jobs.env \
BSTAGE3_JOBS_RECEIPT_SHA256_BEFORE=$(bootstrap_stage3_hash_file "$jobs_receipt") \
BSTAGE3_JOBS_EFFECTIVE=1 BSTAGE3_LOCK=$lock \
BSTAGE3_LOCK_DISPLAY=${stage3_display_root%/stage3/$SIMPLE_NATIVE_BUILD_TARGET}.lock \
    bootstrap_stage3_write_manifest
CANDIDATE_BUILDER
STAGE3_BACKFILL_MODE=${STAGE3_COMPILER_BACKFILL:-absent} \
    /usr/bin/perl -0pi -e '
        s/STAGE3_BACKFILL_MODE_PLACEHOLDER/$ENV{STAGE3_BACKFILL_MODE}/
            or die "backfill mode placeholder absent\n";
    ' "$fixture/fake-candidate-builder.sh"
chmod 0500 "$fixture/fake-candidate-builder.sh"

verifier_under_test=$fixture/production-verifier-with-barrier.sh
cp -- "$repo/scripts/check/lib/bootstrap-stage3-provenance-verifier.sh" \
    "$verifier_under_test"
case "${STAGE3_POST_CAPTURE_MUTATION:-}" in
    leaf|ancestor)
        barrier_before=$fixture/verifier-before.fifo
        barrier_release=$fixture/verifier-release.fifo
        barrier_after=$fixture/verifier-after.fifo
        barrier_restore=$fixture/verifier-restore.fifo
        scratch_display_file=$fixture/verifier-scratch-display
        mkfifo "$barrier_before" "$barrier_release" "$barrier_after" \
            "$barrier_restore"
        BARRIER_BEFORE=$barrier_before BARRIER_RELEASE=$barrier_release \
        BARRIER_AFTER=$barrier_after BARRIER_RESTORE=$barrier_restore \
        SCRATCH_DISPLAY_FILE=$scratch_display_file /usr/bin/perl -0pi -e '
            my $pre = q{BOOTSTRAP_STAGE3_FACADE_PATH=$facade};
            my $pre_insert =
                qq{readlink -- \"\$scratch_root\" >\"$ENV{SCRATCH_DISPLAY_FILE}\"\n} .
                qq{echo reached >\"$ENV{BARRIER_BEFORE}\"\n} .
                qq{IFS= read -r barrier_release <\"$ENV{BARRIER_RELEASE}\"\n} .
                q{[ "$barrier_release" = continue ] || exit 70} . "\n" . $pre;
            index($_, $pre) >= 0 or die "verifier pre-read boundary absent\n";
            s/\Q$pre\E/$pre_insert/ or die "verifier pre-read injection failed\n";
            my $post = q{    '\''status=pass'\''};
            my $post_insert = $post . "\n" .
                qq{echo verified >\"$ENV{BARRIER_AFTER}\"\n} .
                qq{IFS= read -r barrier_restore <\"$ENV{BARRIER_RESTORE}\"\n} .
                q{[ "$barrier_restore" = restored ] || exit 70};
            s/\Q$post\E\n\z/$post_insert\n/
                or die "verifier post-read injection failed\n";
        ' "$verifier_under_test"
        (
            IFS= read -r barrier_marker <"$barrier_before"
            [ "$barrier_marker" = reached ]
            scratch_display=$(sed -n '1p' "$scratch_display_file")
            case "$scratch_display" in
                "$root"/.stage3-verifier-scratch-*/root) ;;
                *) exit 70 ;;
            esac
            manifest_dir=$stage3
            role_dir=$unit/roles
            case "$STAGE3_POST_CAPTURE_MUTATION" in
                leaf)
                    for path in "$manifest_dir"/*; do
                        [ -f "$path" ] || continue
                        mv -- "$path" "$path.captured"
                        printf '%s\n' 'post-capture leaf replacement' >"$path"
                    done
                    for name in shared_runner candidate_builder dash; do
                        path=$role_dir/$name
                        mv -- "$path" "$path.captured"
                        printf '%s\n' 'post-capture role leaf replacement' >"$path"
                    done
                    mv -- "$scratch_display" "$scratch_display.captured"
                    mkdir -- "$scratch_display"
                    printf '%s\n' 'scratch leaf attacker' \
                        >"$scratch_display/attacker-sentinel"
                    ;;
                ancestor)
                    mv -- "$manifest_dir" "$manifest_dir.captured"
                    mkdir -- "$manifest_dir"
                    printf '%s\n' 'post-capture ancestor replacement' \
                        >"$manifest_dir/attacker-sentinel"
                    mv -- "$role_dir" "$role_dir.captured"
                    mkdir -- "$role_dir"
                    printf '%s\n' 'role ancestor attacker' \
                        >"$role_dir/attacker-sentinel"
                    scratch_parent=$(dirname -- "$scratch_display")
                    mv -- "$scratch_parent" "$scratch_parent.captured"
                    mkdir -- "$scratch_parent"
                    mkdir -- "$scratch_display"
                    printf '%s\n' 'scratch ancestor attacker' \
                        >"$scratch_parent/attacker-sentinel"
                    ;;
            esac
            printf '%s\n' continue >"$barrier_release"
            IFS= read -r barrier_marker <"$barrier_after"
            [ "$barrier_marker" = verified ]
            case "$STAGE3_POST_CAPTURE_MUTATION" in
                leaf)
                    for path in "$manifest_dir"/*; do
                        case "$path" in *.captured|*.attack) continue ;; esac
                        [ -f "$path.captured" ] || continue
                        mv -- "$path" "$path.attack"
                        mv -- "$path.captured" "$path"
                    done
                    for name in shared_runner candidate_builder dash; do
                        path=$role_dir/$name
                        mv -- "$path" "$path.attack"
                        mv -- "$path.captured" "$path"
                    done
                    mv -- "$scratch_display/attacker-sentinel" \
                        "$fixture/scratch-leaf-attacker"
                    rmdir -- "$scratch_display"
                    mv -- "$scratch_display.captured" "$scratch_display"
                    ;;
                ancestor)
                    mv -- "$manifest_dir" "$manifest_dir.attack"
                    mv -- "$manifest_dir.captured" "$manifest_dir"
                    mv -- "$role_dir" "$role_dir.attack"
                    mv -- "$role_dir.captured" "$role_dir"
                    scratch_parent=$(dirname -- "$scratch_display")
                    mv -- "$scratch_parent" "$scratch_parent.attack"
                    mv -- "$scratch_parent.captured" "$scratch_parent"
                    ;;
            esac
            printf '%s\n' restored >"$barrier_restore"
        ) &
        mutation_pid=$!
        ;;
    '') ;;
    *) exit 64 ;;
esac
chmod 0500 "$verifier_under_test"

cat >"$fixture/fake-analyzer.pl" <<'ANALYZER'
use strict;
use warnings;
use Digest::SHA qw(sha256_hex);
use Fcntl qw(:DEFAULT);
my $analyzer_path = shift @ARGV;
shift(@ARGV) eq 'analyze' or die "subcommand\n";
my %o;
while (@ARGV) {
    my $key = shift @ARGV;
    $key =~ s/^--// or die "option\n";
    @ARGV or die "value\n";
    $o{$key} = shift @ARGV;
}
sub hash_file {
    my ($path) = @_;
    open(my $fh, '<', $path) or die "open $path: $!\n";
    binmode($fh);
    return Digest::SHA->new(256)->addfile($fh)->hexdigest;
}
sub identity {
    my ($path) = @_;
    my @st = stat($path);
    @st or die "stat $path: $!\n";
    return ($st[0], $st[1], hash_file($path));
}
sub semantic_hash {
    my (@value) = @_;
    my $sha = Digest::SHA->new(256);
    $sha->add(pack('Q>', length($_)), $_) for @value;
    return $sha->hexdigest;
}
sub parse_pairs {
    my ($path) = @_;
    open(my $fh, '<', $path) or die "open $path: $!\n";
    my %v;
    while (<$fh>) { chomp; my ($k, $x) = split(/=/, $_, 2); $v{$k} = $x; }
    return %v;
}
sub role_map {
    my ($path) = @_;
    open(my $fh, '<', $path) or die "open identities: $!\n";
    my %role;
    while (<$fh>) {
        if (/ event=identity role=([^ ]+) path_kind=recorded path=([^ ]+) /) {
            $role{$1} = $2;
        }
    }
    return %role;
}
my %plan = parse_pairs($o{'launch-plan'});
my %role = role_map($plan{identity_manifest_path});
mkdir($o{'output-dir'}, 0700) or die "mkdir output: $!\n";
for my $name (qw(boundary.tsv delta.tsv summary.env)) {
    open(my $fh, '>', "$o{'output-dir'}/$name") or die "create $name: $!\n";
    print {$fh} "$name\n";
    close($fh) or die "close $name: $!\n";
}
my %v = (receipt_schema => 'simple-stage3-memory-evidence-v2',
    run_id => $o{'run-id'}, result => 'complete');
for my $entry ([raw => $o{samples}], [memory => $o{memory}], [phase => $o{phase}],
        [provenance => $o{provenance}], [descriptor => $o{descriptor}],
        [launch_plan => $o{'launch-plan'}],
        [identity_manifest => $plan{identity_manifest_path}],
        [provenance_verify_receipt => $plan{provenance_verify_receipt_path}]) {
    my ($name, $path) = @$entry;
    @v{"${name}_dev", "${name}_ino", "${name}_sha256"} = identity($path);
}
my $candidate = $plan{candidate_output_path};
for my $entry ([candidate_provenance => $o{'candidate-provenance'}],
        [candidate_provenance_verify_receipt =>
            $o{'candidate-provenance-verify-receipt'}],
        [admitted_compiler => $role{admitted_compiler}],
        [produced_candidate => $candidate]) {
    my ($name, $path) = @$entry;
    $v{"${name}_path"} = $path;
    @v{"${name}_dev", "${name}_ino", "${name}_sha256"} = identity($path);
}
for my $entry ([sampler => $role{sampler}], [analyzer => $analyzer_path],
        [measured_command => $role{admitted_compiler}], [runner => $o{runner}],
        [candidate_builder => $o{'candidate-builder'}],
        [orchestration_shell => $o{shell}]) {
    my ($name, $path) = @$entry;
    @v{"${name}_dev", "${name}_ino", "${name}_sha256"} = identity($path);
}
@v{qw(measured_script_dev measured_script_ino measured_script_sha256)} = (0, 0, 'none');
my @env_keys = qw(HOME TMPDIR PATH LC_ALL LANG RUST_LOG LIBRARY_PATH
    SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256 SIMPLE_BOOTSTRAP
    SIMPLE_NO_DEPRECATED_WARNINGS SIMPLE_STAGE3_STREAMING_SURFACES
    MALLOC_ARENA_MAX MALLOC_TRIM_THRESHOLD_ SIMPLE_NATIVE_ARENA_DECLS
    SIMPLE_NO_STUB_FALLBACK SIMPLE_BUILD_PROGRESS_EVENTS
    SIMPLE_COMPILER_PHASE_PROFILE SIMPLE_COMPILER_PHASE_PROFILE_FILE
    SIMPLE_MEM_SNAPSHOT_FILE SIMPLE_EVIDENCE_RUN_ID
    LLVM_DISABLE_ABI_BREAKING_CHECKS_ENFORCING SIMPLE_NATIVE_BUILD_TARGET
    SIMPLE_NATIVE_BUILD_THREADS SIMPLE_NATIVE_BUILD_CACHE_DIR
    SIMPLE_RUNTIME_PATH SIMPLE_NATIVE_RUNTIME_BUNDLE SIMPLE_BINARY);
my @env_semantic;
push @env_semantic, $_, $ENV{$_} for @env_keys;
$v{environment_sha256} = semantic_hash(@env_semantic);
$v{environment_semantic_sha256} = $v{environment_sha256};
my @compiler = ($role{admitted_compiler}, 'native-build', '--target',
    $plan{platform}, '--backend', 'cranelift', '--runtime-bundle',
    'core-c-bootstrap', '--threads', '1', '--cache-dir', $plan{cache_path},
    '--mode', 'dynload', '--runtime-path', $plan{runtime_path}, '-o',
    $candidate, 'src/app/cli/bootstrap_main.spl');
$v{argv_semantic_sha256} = semantic_hash(@compiler);
for my $name (qw(boundary delta summary)) {
    $v{"${name}_sha256"} = hash_file("$o{'output-dir'}/$name" .
        ($name eq 'summary' ? '.env' : '.tsv'));
}
@v{qw(sample_interval_ms max_gap_ms max_summed_rss_kib compiler_wall_ms
    max_sample_batches max_process_records max_tracked_processes
    raw_evidence_max_bytes term_grace_ms kill_reap_deadline_ms
    closure_reserve_bytes closure_reserve_records)} =
    qw(5 50 8388608 3600000 1000000 16000000 4096 1073741824 5000 10000 65536 256);
@v{qw(physical_sources phase_mode observed_max_start_gap_ns
    observed_max_batch_duration_ns)} = (1, 'streaming', 1, 1);
for my $entry ([memory_bytes => $o{memory}], [phase_bytes => $o{phase}]) {
    $v{$entry->[0]} = -s $entry->[1];
}
@v{qw(memory_records phase_records descriptor_records identity_records
    plan_records provenance_verify_records)} = (1, 1, 1, 17, 60, 10);
my @order = qw(receipt_schema run_id result raw_dev raw_ino raw_sha256
    memory_dev memory_ino memory_sha256 phase_dev phase_ino phase_sha256
    provenance_dev provenance_ino provenance_sha256 descriptor_dev descriptor_ino
    descriptor_sha256 launch_plan_dev launch_plan_ino launch_plan_sha256
    identity_manifest_dev identity_manifest_ino identity_manifest_sha256
    provenance_verify_receipt_dev provenance_verify_receipt_ino
    provenance_verify_receipt_sha256 candidate_provenance_path
    candidate_provenance_dev candidate_provenance_ino candidate_provenance_sha256
    candidate_provenance_verify_receipt_path candidate_provenance_verify_receipt_dev
    candidate_provenance_verify_receipt_ino candidate_provenance_verify_receipt_sha256
    admitted_compiler_path admitted_compiler_dev admitted_compiler_ino
    admitted_compiler_sha256 produced_candidate_path produced_candidate_dev
    produced_candidate_ino produced_candidate_sha256 sampler_dev sampler_ino
    sampler_sha256 analyzer_dev analyzer_ino analyzer_sha256 measured_command_dev
    measured_command_ino measured_command_sha256 measured_script_dev
    measured_script_ino measured_script_sha256 runner_dev runner_ino runner_sha256
    candidate_builder_dev candidate_builder_ino candidate_builder_sha256 orchestration_shell_dev
    orchestration_shell_ino orchestration_shell_sha256 environment_sha256
    argv_semantic_sha256 environment_semantic_sha256 boundary_sha256 delta_sha256
    summary_sha256 sample_interval_ms max_gap_ms max_summed_rss_kib compiler_wall_ms
    max_sample_batches max_process_records max_tracked_processes
    raw_evidence_max_bytes term_grace_ms kill_reap_deadline_ms closure_reserve_bytes
    closure_reserve_records physical_sources phase_mode observed_max_start_gap_ns
    observed_max_batch_duration_ns memory_bytes memory_records phase_bytes
    phase_records descriptor_records identity_records plan_records
    provenance_verify_records);
open(my $receipt, '>', "$o{'output-dir'}/receipt.env") or die "receipt: $!\n";
for my $key (@order) { defined($v{$key}) or die "missing $key\n"; print {$receipt} "$key=$v{$key}\n"; }
close($receipt) or die "close receipt: $!\n";
ANALYZER

cat >"$fixture/analyzer-wrapper.c" <<EOF
#include <stdlib.h>
#include <unistd.h>
int main(int argc, char **argv) {
    char **next = calloc((size_t)argc + 3u, sizeof(char *));
    if (!next) return 125;
    next[0] = "/usr/bin/perl";
    next[1] = "$fixture/fake-analyzer.pl";
    for (int i = 0; i < argc; ++i) next[i + 2] = argv[i];
    execv(next[0], next);
    return 126;
}
EOF
cc -std=c11 -O0 -o "$fixture/fake-analyzer" "$fixture/analyzer-wrapper.c"

cat >"$fixture/fake-systemd-run.sh" <<'FAKE_RUN'
#!/bin/sh
set -eu
unit=
memory=
runtime=
working=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --unit=*) unit=${1#*=}; shift ;;
        MemoryMax=*) memory=${1#*=}; shift ;;
        RuntimeMaxSec=*) runtime=${1#*=}; shift ;;
        WorkingDirectory=*) working=${1#*=}; shift ;;
        --) shift; break ;;
        *) shift ;;
    esac
done
[ -n "$unit" ] && [ "$memory" = 8589934592 ] && [ "$runtime" = 3900 ]
[ -n "$working" ] && [ "$#" -gt 0 ]
state=${STAGE3_FAKE_SYSTEMD_STATE:?}
unit_dir=$state/units/$unit
cgroup=$STAGE3_FAKE_CGROUP_ROOT/fake/$unit
mkdir -p "$unit_dir" "$cgroup"
printf '/fake/%s\n' "$unit" >"$unit_dir/ControlGroup"
printf 'active\n' >"$unit_dir/ActiveState"
printf 'populated 1\nfrozen 0\n' >"$cgroup/cgroup.events"
printf 'max 0\noom 0\noom_kill 0\noom_group_kill 0\n' >"$cgroup/memory.events"
printf '1024\n' >"$cgroup/memory.current"
printf '1024\n' >"$cgroup/memory.peak"
printf '%s\n' "$memory" >"$cgroup/memory.max"
printf '0\n' >"$cgroup/memory.swap.current"
printf '0\n' >"$cgroup/memory.swap.max"
printf '1\n' >"$cgroup/memory.oom.group"
cleanup() {
    if [ -f "$unit_dir/child.pid" ]; then
        child=$(sed -n '1p' "$unit_dir/child.pid")
        kill -TERM "$child" 2>/dev/null || true
        wait "$child" 2>/dev/null || true
    fi
    if [ -f "$state/survivor.pid" ]; then
        survivor=$(sed -n '1p' "$state/survivor.pid")
        kill -KILL "$survivor" 2>/dev/null || true
    fi
    printf 'inactive\n' >"$unit_dir/ActiveState"
    printf 'populated 0\nfrozen 0\n' >"$cgroup/cgroup.events"
}
trap 'cleanup; exit 143' TERM HUP INT
exec 9<&0
(cd "$working" && exec "$@" <&9) &
child=$!
exec 9<&-
printf '%s\n' "$child" >"$unit_dir/child.pid"
if wait "$child"; then status=0; else status=$?; fi
printf 'inactive\n' >"$unit_dir/ActiveState"
if [ -f "$state/survivor.pid" ] &&
        kill -0 "$(sed -n '1p' "$state/survivor.pid")" 2>/dev/null; then
    printf 'populated 1\nfrozen 0\n' >"$cgroup/cgroup.events"
else
    printf 'populated 0\nfrozen 0\n' >"$cgroup/cgroup.events"
fi
exit "$status"
FAKE_RUN

cat >"$fixture/fake-systemctl.sh" <<'FAKE_CTL'
#!/bin/sh
set -eu
[ "$1" = --user ] && shift
command=$1
shift
state=${STAGE3_FAKE_SYSTEMD_STATE:?}
case "$command" in
    show)
        unit=${1%.service}
        property=${2#--property=}
        sed -n '1p' "$state/units/$unit/$property"
        ;;
    stop|kill)
        unit=
        for value in "$@"; do case "$value" in *.service) unit=${value%.service} ;; esac; done
        [ -n "$unit" ]
        unit_dir=$state/units/$unit
        if [ -f "$unit_dir/child.pid" ]; then
            kill -TERM "$(sed -n '1p' "$unit_dir/child.pid")" 2>/dev/null || true
        fi
        if [ -f "$state/survivor.pid" ]; then
            kill -KILL "$(sed -n '1p' "$state/survivor.pid")" 2>/dev/null || true
        fi
        printf 'inactive\n' >"$unit_dir/ActiveState"
        printf 'populated 0\nfrozen 0\n' \
            >"$STAGE3_FAKE_CGROUP_ROOT/fake/$unit/cgroup.events"
        ;;
    *) exit 64 ;;
esac
FAKE_CTL
chmod 0500 "$fixture/fake-systemd-run.sh" "$fixture/fake-systemctl.sh" \
    "$supervisor_source"

copy_role sampler "$fixture/fake-sampler.sh"
copy_role analyzer "$fixture/fake-analyzer"
copy_role transaction_supervisor "$supervisor_source"
copy_role shared_runner "$runner_under_test"
copy_role gate_helper "$gate_source"
copy_role dash /usr/bin/dash
copy_role payload /usr/bin/perl
copy_role gate_interpreter /usr/bin/dash
copy_role session_helper /usr/bin/true
copy_role bootstrap_script "$repo/scripts/bootstrap/bootstrap-from-scratch.sh"
copy_role candidate_builder "$fixture/fake-candidate-builder.sh"
copy_role planner /usr/bin/true
copy_role provenance_verifier "$verifier_under_test"
copy_role env /usr/bin/env
copy_role facade "$facade_source"

sampler_sha=$(sha "$roles/sampler")
analyzer_sha=$(sha "$roles/analyzer")
admitted_sha=$(sha "$admitted")
dash_sha=$(sha "$roles/dash")
candidate_builder_sha=$(sha "$roles/candidate_builder")
runner_sha=$(sha "$roles/shared_runner")
verifier_sha=$(sha "$roles/provenance_verifier")

chmod 0600 "$parent_provenance"
printf '%s\n' \
    'schema=simple-bootstrap-stage2-parent-provenance-v1' \
    'stage2-provenance=pure-simple' \
    'authority=explicit-full-bootstrap-stage2-trust-root' \
    "candidate_sha256=$admitted_sha" \
    "source_snapshot_sha256=$(sha "$source_snapshot")" \
    "runtime_snapshot_sha256=$(sha "$runtime_snapshot")" \
    "tool_authority_sha256=$(sha "$tool_snapshot")" \
    "admission_receipt_sha256=$(sha "$stage2_admission")" >"$parent_provenance"
printf '%s\n' \
    'schema=simple-stage23-parent-v1-authentication-v1' 'status=pass' \
    "run_id=$run_id" "architecture=$architecture" \
    "parent_v1_sha256=$(sha "$parent_provenance")" \
    "candidate_sha256=$admitted_sha" \
    "source_snapshot_sha256=$(sha "$source_snapshot")" \
    "runtime_snapshot_sha256=$(sha "$runtime_snapshot")" \
    "tool_snapshot_sha256=$(sha "$tool_snapshot")" \
    "git_receipt_sha256=$(sha "$git_receipt")" \
    "stage2_admission_sha256=$(sha "$stage2_admission")" >"$parent_verify"
chmod 0400 "$parent_provenance" "$parent_verify"

envv=(
    "HOME=$home" "TMPDIR=$tmpdir" "PATH=$tool_path" 'LC_ALL=C' 'LANG=C'
    'RUST_LOG=error' 'LIBRARY_PATH=' 'SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=absent'
    'SIMPLE_BOOTSTRAP=1' 'SIMPLE_NO_DEPRECATED_WARNINGS=1'
    'SIMPLE_STAGE3_STREAMING_SURFACES=1' 'MALLOC_ARENA_MAX=2'
    'MALLOC_TRIM_THRESHOLD_=0' 'SIMPLE_NATIVE_ARENA_DECLS=1'
    'SIMPLE_NO_STUB_FALLBACK=1' "SIMPLE_BUILD_PROGRESS_EVENTS=$progress"
    'SIMPLE_COMPILER_PHASE_PROFILE=1' "SIMPLE_COMPILER_PHASE_PROFILE_FILE=$phase"
    "SIMPLE_MEM_SNAPSHOT_FILE=$memory" "SIMPLE_EVIDENCE_RUN_ID=$run_id"
    'LLVM_DISABLE_ABI_BREAKING_CHECKS_ENFORCING=1'
    "SIMPLE_NATIVE_BUILD_TARGET=$architecture" 'SIMPLE_NATIVE_BUILD_THREADS=1'
    "SIMPLE_NATIVE_BUILD_CACHE_DIR=$cache" "SIMPLE_RUNTIME_PATH=$runtime"
    'SIMPLE_NATIVE_RUNTIME_BUNDLE=core-c-bootstrap' "SIMPLE_BINARY=$admitted"
)
environment_sha=$(env -i "${envv[@]}" /usr/bin/perl -MDigest::SHA=sha256_hex -e '
    my @key = qw(HOME TMPDIR PATH LC_ALL LANG RUST_LOG LIBRARY_PATH
      SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256 SIMPLE_BOOTSTRAP
      SIMPLE_NO_DEPRECATED_WARNINGS SIMPLE_STAGE3_STREAMING_SURFACES
      MALLOC_ARENA_MAX MALLOC_TRIM_THRESHOLD_ SIMPLE_NATIVE_ARENA_DECLS
      SIMPLE_NO_STUB_FALLBACK SIMPLE_BUILD_PROGRESS_EVENTS
      SIMPLE_COMPILER_PHASE_PROFILE SIMPLE_COMPILER_PHASE_PROFILE_FILE
      SIMPLE_MEM_SNAPSHOT_FILE SIMPLE_EVIDENCE_RUN_ID
      LLVM_DISABLE_ABI_BREAKING_CHECKS_ENFORCING SIMPLE_NATIVE_BUILD_TARGET
      SIMPLE_NATIVE_BUILD_THREADS SIMPLE_NATIVE_BUILD_CACHE_DIR
      SIMPLE_RUNTIME_PATH SIMPLE_NATIVE_RUNTIME_BUNDLE SIMPLE_BINARY);
    my $bytes=""; for (@key) { my $v=$ENV{$_}; my $e="$_=$v";
      $bytes .= pack("Q>",length($e)).$e; } print sha256_hex($bytes);')

# The retained transaction descriptor owns the immutable Stage2 capsule.  Its
# fixed child is `output`; materialize only the completed Stage2 authority.
txn_output=$stage2_transaction/output
txn_stage3=$txn_output/stage3/$architecture
txn_runtime=$txn_stage3/stage2-runtime-authority
txn_display=$stage2_transaction_display
txn_output_display=$txn_display/output
txn_stage3_display=$txn_output_display/stage3/$architecture
txn_runtime_display=$txn_stage3_display/stage2-runtime-authority
mkdir -p "$txn_output/stage2/$architecture" \
    "$txn_stage3/stage2-admitted" "$txn_runtime" \
    "$txn_stage3/stage2-native-cache" "$txn_output/logs/$architecture"
cp -- "$admitted" "$txn_output/stage2/$architecture/simple"
cp -- "$admitted" "$txn_stage3/stage2-admitted/simple"
cp -- "$admitted" "$txn_runtime/simple"
printf 'fixture-native-all\n' >"$txn_runtime/libsimple_native_all.a"
BOOTSTRAP_STAGE3_FACADE_PATH=$facade_source
BOOTSTRAP_STAGE3_VERSION_ROOT=$root
export BOOTSTRAP_STAGE3_FACADE_PATH BOOTSTRAP_STAGE3_VERSION_ROOT
. "$facade_source"
bootstrap_stage3_source_snapshot "$txn_stage3/source-inputs-before.txt" "$root"
bootstrap_stage3_git_state "$root" "$txn_stage3/git-state-before.env"
chmod 0600 "$source_snapshot" "$git_receipt"
cp -- "$txn_stage3/source-inputs-before.txt" "$source_snapshot"
cp -- "$txn_stage3/git-state-before.env" "$git_receipt"
bootstrap_stage3_tool_authority_snapshot \
    "$txn_stage3/tool-authority-before.txt" "$tool_path" "$root"
txn_seed_fingerprint=$(bootstrap_stage3_seed_inputs_fingerprint \
    "$root" cranelift none "$tool_path" "$architecture")
bootstrap_stage3_write_seed_stamp "$txn_runtime/simple.inputs.sha256" \
    "$txn_seed_fingerprint" "$txn_runtime/simple" \
    "$txn_runtime/libsimple_native_all.a" "$txn_runtime/backfill.absent"
mkdir "$txn_runtime/deps"
printf 'fixture hosted runtime\n' \
    >"$txn_runtime/deps/libspl_hosted_runtime-fixture.rlib"
txn_hosted_sha=$(sha \
    "$txn_runtime/deps/libspl_hosted_runtime-fixture.rlib")
printf '%s\n' 'schema=simple-bootstrap-hosted-runtime-authority-v1' \
    'status=frozen' \
    'relative_path=deps/libspl_hosted_runtime-fixture.rlib' \
    "sha256=$txn_hosted_sha" >"$txn_runtime/hosted-runtime.env"
chmod 0400 "$txn_runtime/deps/libspl_hosted_runtime-fixture.rlib" \
    "$txn_runtime/hosted-runtime.env" \
    "$txn_runtime/libsimple_native_all.a" \
    "$txn_runtime/simple.inputs.sha256"
chmod 0500 "$txn_runtime/simple"
chmod 0500 "$txn_runtime/deps" "$txn_runtime"
bootstrap_stage3_directory_snapshot \
    "$txn_stage3/runtime-origin-before.txt" "$txn_runtime_display"
cp -- "$txn_stage3/runtime-origin-before.txt" \
    "$txn_stage3/runtime-origin-after.txt"
cp -- "$txn_stage3/runtime-origin-before.txt" \
    "$txn_stage3/runtime-admitted.txt"
txn_stage2_sha=$(sha "$txn_stage3/stage2-admitted/simple")
txn_sanity=$txn_stage3/stage2-sanity.env
txn_sanity_display=$txn_stage3_display/stage2-sanity.env
txn_driver=$txn_sanity.frontend-driver.log
txn_driver_display=$txn_sanity_display.frontend-driver.log
: >"$txn_driver"
for txn_mode in 0 1; do
    txn_mode_log=$txn_sanity.frontend-bootstrap-$txn_mode.log
    txn_mode_status=$txn_sanity.frontend-bootstrap-$txn_mode.status.env
    txn_mode_log_display=$txn_sanity_display.frontend-bootstrap-$txn_mode.log
    txn_mode_status_display=$txn_sanity_display.frontend-bootstrap-$txn_mode.status.env
    for txn_probe in p2_add stage2_mir_retention stage2_module_path_naming hello_world_positional; do
        case "$txn_probe" in
            p2_add) txn_probe_log=$txn_mode_log; txn_probe_log_display=$txn_mode_log_display ;;
            *) txn_probe_suffix=$(printf '%s' "$txn_probe" | tr _ -)
               txn_probe_log=$txn_mode_log.$txn_probe_suffix
               txn_probe_log_display=$txn_mode_log_display.$txn_probe_suffix ;;
        esac
        printf 'probe=%s\n' "$txn_probe" >"$txn_probe_log"
        txn_probe_sha=$(sha "$txn_probe_log")
        printf '%s\n' schema=simple-bounded-process-log-v1 status=complete reason=child-exit raw_status=0 \
            max_bytes=4194304 "bytes_captured=$(wc -c <"$txn_probe_log" | tr -d ' ')" timeout_seconds=180 \
            term_grace_seconds=1 combined_stream=stdout-stderr process_group=setsid artifact_limit=none \
            "log_leaf=${txn_probe_log##*/}" "log_sha256=$txn_probe_sha" >"$txn_probe_log.bounded.env"
    done
    printf '%s\n' 'schema=simple-candidate-frontend-status-v2' \
        'result=pass' 'probe=complete' 'raw_status=0' \
        "bootstrap_mode=$txn_mode" 'backend=cranelift' \
        "log_path=$txn_mode_log_display" \
        'p2_add_raw_status=0' "p2_add_log_path=$txn_mode_log_display" \
        "p2_add_log_sha256=$(sha "$txn_mode_log")" \
        "p2_add_collector_receipt_path=$txn_mode_log_display.bounded.env" \
        "p2_add_collector_receipt_sha256=$(sha "$txn_mode_log.bounded.env")" \
        'stage2_mir_retention_raw_status=0' "stage2_mir_retention_log_path=$txn_mode_log_display.stage2-mir-retention" \
        "stage2_mir_retention_log_sha256=$(sha "$txn_mode_log.stage2-mir-retention")" \
        "stage2_mir_retention_collector_receipt_path=$txn_mode_log_display.stage2-mir-retention.bounded.env" \
        "stage2_mir_retention_collector_receipt_sha256=$(sha "$txn_mode_log.stage2-mir-retention.bounded.env")" \
        'stage2_module_path_naming_raw_status=0' "stage2_module_path_naming_log_path=$txn_mode_log_display.stage2-module-path-naming" \
        "stage2_module_path_naming_log_sha256=$(sha "$txn_mode_log.stage2-module-path-naming")" \
        "stage2_module_path_naming_collector_receipt_path=$txn_mode_log_display.stage2-module-path-naming.bounded.env" \
        "stage2_module_path_naming_collector_receipt_sha256=$(sha "$txn_mode_log.stage2-module-path-naming.bounded.env")" \
        'hello_world_positional_raw_status=0' "hello_world_positional_log_path=$txn_mode_log_display.hello-world-positional" \
        "hello_world_positional_log_sha256=$(sha "$txn_mode_log.hello-world-positional")" \
        "hello_world_positional_collector_receipt_path=$txn_mode_log_display.hello-world-positional.bounded.env" \
        "hello_world_positional_collector_receipt_sha256=$(sha "$txn_mode_log.hello-world-positional.bounded.env")" \
        >"$txn_mode_status"
    printf 'probe=complete\n' >>"$txn_driver"
done
txn_driver_sha=$(sha "$txn_driver")
printf '%s\n' \
    'schema=simple-bootstrap-sanity-evidence-v1' 'status=pass' \
    "candidate_sha256_before=$txn_stage2_sha" 'version_status=0' \
    'version_expected=1.0.0-rc.1' 'version_expect_status=0' \
    'version_match_status=0' 'version_output=simple-bootstrap 1.0.0-rc.1' \
    'unsupported_status=1' \
    "unsupported_output_sha256=$(printf \"unknown command 'run'\" | sha256sum | awk '{print $1}')" \
    'frontend_smoke_status=0' 'frontend_smoke_backend=cranelift' \
    'frontend_smoke_bootstrap_mode_status=0' \
    'frontend_smoke_bootstrap0_raw_status=0' \
    "frontend_smoke_bootstrap0_log_path=$txn_sanity_display.frontend-bootstrap-0.log" \
    "frontend_smoke_bootstrap0_log_sha256=$(sha "$txn_sanity.frontend-bootstrap-0.log")" \
    "frontend_smoke_bootstrap0_status_path=$txn_sanity_display.frontend-bootstrap-0.status.env" \
    "frontend_smoke_bootstrap0_status_sha256=$(sha "$txn_sanity.frontend-bootstrap-0.status.env")" \
    'frontend_smoke_bootstrap1_ran=true' 'frontend_smoke_bootstrap1_raw_status=0' \
    "frontend_smoke_bootstrap1_log_path=$txn_sanity_display.frontend-bootstrap-1.log" \
    "frontend_smoke_bootstrap1_log_sha256=$(sha "$txn_sanity.frontend-bootstrap-1.log")" \
    "frontend_smoke_bootstrap1_status_path=$txn_sanity_display.frontend-bootstrap-1.status.env" \
    "frontend_smoke_bootstrap1_status_sha256=$(sha "$txn_sanity.frontend-bootstrap-1.status.env")" \
    "frontend_smoke_output_sha256=$txn_driver_sha" \
    "frontend_smoke_driver_log_path=$txn_driver_display" \
    "frontend_smoke_driver_log_sha256=$txn_driver_sha" \
    "candidate_sha256_after=$txn_stage2_sha" >"$txn_sanity"
printf 'receiver PASS\n' >"$txn_stage3/stage2-receiver.log"
printf '%s\n' \
    'schema=simple-bootstrap-stage2-receiver-evidence-v1' 'status=pass' \
    'probe_exit=0' "candidate_sha256_before=$txn_stage2_sha" \
    "candidate_sha256_after=$txn_stage2_sha" \
    "runtime_snapshot_sha256=$(sha "$txn_stage3/runtime-admitted.txt")" \
    "probe_log=$txn_stage3_display/stage2-receiver.log" \
    "probe_log_sha256=$(sha "$txn_stage3/stage2-receiver.log")" \
    >"$txn_stage3/stage2-receiver.env"
bootstrap_stage3_write_command_transcript \
    "$txn_stage3/stage2-command.transcript" "$root" "$home" "$tmpdir" \
    "$tool_path" RUST_LOG=error LIBRARY_PATH= \
    SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=absent SIMPLE_BOOTSTRAP=1 \
    SIMPLE_NO_DEPRECATED_WARNINGS=1 SIMPLE_NATIVE_BUILD_RUST=1 \
    SIMPLE_NO_STUB_FALLBACK=1 "SIMPLE_BUILD_PROGRESS_EVENTS=$progress" \
    "SIMPLE_BINARY=$txn_runtime_display/simple" -- "$txn_runtime_display/simple" native-build \
    --target "$architecture" --backend cranelift --runtime-bundle core-c-bootstrap \
    --source src/compiler --source src/app --source src/lib --entry-closure \
    --threads 1 --timeout 3600 --compile-stack-mib 64 \
    --cache-dir "$txn_stage3_display/stage2-native-cache" --mode dynload \
    --entry src/app/cli/bootstrap_main.spl --runtime-path "$txn_runtime_display" \
    -o "$txn_output_display/stage2/$architecture/simple"
txn_args_sha=$(bootstrap_stage3_args_sha256 RUST_LOG=error LIBRARY_PATH= \
    SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256=absent SIMPLE_BOOTSTRAP=1 \
    SIMPLE_NO_DEPRECATED_WARNINGS=1 SIMPLE_NATIVE_BUILD_RUST=1 \
    SIMPLE_NO_STUB_FALLBACK=1 "SIMPLE_BUILD_PROGRESS_EVENTS=$progress" \
    "SIMPLE_BINARY=$txn_runtime_display/simple" native-build --target "$architecture" \
    --backend cranelift --runtime-bundle core-c-bootstrap --source src/compiler \
    --source src/app --source src/lib --entry-closure --threads 1 \
    --timeout 3600 --compile-stack-mib 64 \
    --cache-dir "$txn_stage3_display/stage2-native-cache" \
    --mode dynload --entry src/app/cli/bootstrap_main.spl \
    --runtime-path "$txn_runtime_display" \
    -o "$txn_output_display/stage2/$architecture/simple")
bootstrap_stage3_write_stage2_admission_receipt \
    "$txn_stage3/stage2-admitted/admission.env" \
    "$txn_stage3_display/stage2-admitted/admission.env" \
    "$txn_stage3/stage2-admitted/simple" "$txn_stage3_display/stage2-admitted/simple" \
    "$txn_stage3/source-inputs-before.txt" "$txn_stage3_display/source-inputs-before.txt" \
    "$txn_stage3/runtime-admitted.txt" "$txn_stage3_display/runtime-admitted.txt" \
    "$txn_runtime" "$txn_runtime_display" \
    "$txn_stage3/tool-authority-before.txt" "$txn_stage3_display/tool-authority-before.txt" "$txn_args_sha" "$txn_sanity" \
    "$txn_sanity_display" "$txn_stage3" \
    "$txn_stage3/stage2-receiver.env" "$txn_stage3_display/stage2-receiver.env" \
    "$txn_stage3/stage2-receiver.log" "$txn_stage3_display/stage2-receiver.log" "$root"
chmod 0600 "$parent_provenance" "$parent_verify"
printf '%s\n' 'schema=simple-bootstrap-stage2-parent-provenance-v1' \
    'stage2-provenance=pure-simple' \
    'authority=explicit-full-bootstrap-stage2-trust-root' \
    "candidate_sha256=$txn_stage2_sha" \
    "source_snapshot_sha256=$(sha "$txn_stage3/source-inputs-before.txt")" \
    "runtime_snapshot_sha256=$(sha "$txn_stage3/runtime-admitted.txt")" \
    "tool_authority_sha256=$(sha "$txn_stage3/tool-authority-before.txt")" \
    "admission_receipt_sha256=$(sha "$txn_stage3/stage2-admitted/admission.env")" \
    >"$parent_provenance"
cp -- "$parent_provenance" \
    "$txn_output/stage2/$architecture/stage2-provenance.receipt"
printf '%s\n' 'schema=simple-stage23-parent-v1-authentication-v1' \
    'status=pass' "run_id=$run_id" "architecture=$architecture" \
    "parent_v1_sha256=$(sha "$parent_provenance")" \
    "candidate_sha256=$txn_stage2_sha" \
    "source_snapshot_sha256=$(sha "$source_snapshot")" \
    "runtime_snapshot_sha256=$(sha "$runtime_snapshot")" \
    "tool_snapshot_sha256=$(sha "$tool_snapshot")" \
    "git_receipt_sha256=$(sha "$git_receipt")" \
    "stage2_admission_sha256=$(sha "$stage2_admission")" >"$parent_verify"
chmod 0400 "$parent_provenance" "$parent_verify"
printf 'fixture Stage 2 native build\n' \
    >"$txn_output/logs/$architecture/stage2-native-build.log"
chmod 0500 "$txn_output/stage2/$architecture/simple" \
    "$txn_stage3/stage2-admitted/simple" "$txn_runtime/simple"
find "$txn_output" -type f ! -perm -0100 -exec chmod 0400 {} +

. "$runner_contract_source"
bootstrap_stage3_hash_file() { sha "$1"; }
BSTAGE3_RUN_ROOT=$root
BSTAGE3_RUN_EVIDENCE=$unit
BSTAGE3_RUN_ID=$run_id
BSTAGE3_RUN_ARCHITECTURE=$architecture
BSTAGE3_RUN_HEAVY_LOCK=$heavy_lock
BSTAGE3_RUN_OWNER_JOURNAL=$owner_journal
BSTAGE3_RUN_QUARANTINE=$quarantine
BSTAGE3_RUN_SYSTEMD_RUN=$fixture/fake-systemd-run.sh
BSTAGE3_RUN_SYSTEMCTL=$fixture/fake-systemctl.sh
BSTAGE3_RUN_CGROUP_ROOT=$cgroup_root
BSTAGE3_RUN_HOME=$home
BSTAGE3_RUN_TMPDIR=$tmpdir
BSTAGE3_RUN_PATH=$tool_path
BSTAGE3_RUN_SOURCE_OUTPUT=$fixture/stage2-transaction
BSTAGE3_RUN_STAGE2_TRANSACTION_ROOT=$stage2_transaction
BSTAGE3_RUN_COMPATIBILITY_MARKER=$compatibility_marker
BSTAGE3_RUN_RAW=$raw
BSTAGE3_RUN_MEMORY=$memory
BSTAGE3_RUN_PHASE=$phase
BSTAGE3_RUN_DESCRIPTOR=$descriptor
BSTAGE3_RUN_PARENT_PROVENANCE=$parent_provenance
BSTAGE3_RUN_PARENT_PROVENANCE_VERIFY=$parent_verify
BSTAGE3_RUN_SOURCE_SNAPSHOT=$source_snapshot
BSTAGE3_RUN_GIT_RECEIPT=$git_receipt
BSTAGE3_RUN_RUNTIME_SNAPSHOT=$runtime_snapshot
BSTAGE3_RUN_TOOL_SNAPSHOT=$tool_snapshot
BSTAGE3_RUN_STAGE2_ADMISSION=$stage2_admission
BSTAGE3_RUN_PLANNER_RECEIPT=$planner_receipt
BSTAGE3_RUN_CACHE=$cache
BSTAGE3_RUN_RUNTIME=$runtime
BSTAGE3_RUN_CANDIDATE=$candidate
BSTAGE3_RUN_CANDIDATE_PROVENANCE=$candidate_provenance
BSTAGE3_RUN_PROGRESS=$progress
BSTAGE3_RUN_SUPERVISOR=$supervisor_source
BSTAGE3_RUN_GATE=$gate_source
BSTAGE3_RUN_RUNNER=$runner_under_test
BSTAGE3_RUN_SAMPLER=$roles/sampler
BSTAGE3_RUN_ANALYZER=$roles/analyzer
BSTAGE3_RUN_ADMITTED_COMPILER=$txn_stage3_display/stage2-admitted/simple
BSTAGE3_RUN_DASH=/usr/bin/dash
BSTAGE3_RUN_PERL=/usr/bin/perl
BSTAGE3_RUN_ENV_TOOL=/usr/bin/env
BSTAGE3_RUN_SESSION_HELPER=/usr/bin/true
BSTAGE3_RUN_BOOTSTRAP_SCRIPT=$repo/scripts/bootstrap/bootstrap-from-scratch.sh
BSTAGE3_RUN_CANDIDATE_BUILDER=$roles/candidate_builder
BSTAGE3_RUN_PLANNER=/usr/bin/true
BSTAGE3_RUN_PROVENANCE_VERIFIER=$roles/provenance_verifier
BSTAGE3_RUN_FACADE=$facade_source
BSTAGE3_RUN_SAMPLER_SHA256=$sampler_sha
BSTAGE3_RUN_ANALYZER_SHA256=$analyzer_sha
BSTAGE3_RUN_ADMITTED_COMPILER_SHA256=$txn_stage2_sha
BSTAGE3_RUN_DASH_SHA256=$(sha /usr/bin/dash)
BSTAGE3_RUN_CANDIDATE_BUILDER_SHA256=$candidate_builder_sha
BSTAGE3_RUN_RUNNER_SHA256=$runner_sha
BSTAGE3_RUN_PROVENANCE_VERIFIER_SHA256=$verifier_sha
[[ $BSTAGE3_RUN_ADMITTED_COMPILER -ef \
    $txn_stage3/stage2-admitted/simple ]] || {
    echo 'runner fixture lost exact transaction admitted authority' >&2
    exit 1
}
if [[ $BSTAGE3_RUN_ADMITTED_COMPILER -ef $admitted ]]; then
    echo 'runner fixture reused same-content outer admitted inode' >&2
    exit 1
fi
export STAGE3_FAKE_SYSTEMD_STATE=$fake_state
export STAGE3_FAKE_CGROUP_ROOT=$cgroup_root
if [ "${STAGE3_TEST_POST_ANALYZER_SIGNAL:-}" = TERM ]; then
        if bootstrap_stage3_run_evidenced; then
            echo 'post-analyzer signal mutation unexpectedly passed' >&2
            exit 1
        fi
        grep -qx TERM "$fixture/post-analyzer-signal.ack"
        [ ! -e "$unit/runner-receipt.env" ]
        [ ! -e "$unit/.runner-receipt.commit.$run_id" ]
        grep -qx 'schema=simple-stage3-unit-launch-plan-v2' \
            "$unit/launch-plan.env"
        grep -qx 'status=ready' "$unit/launch-plan.env"
        [ ! -e "$unit/terminal.env" ]
        [ ! -e "$unit/.terminal.env.commit.$run_id" ]
        echo 'bootstrap Stage3 shared runner post-analyzer signal mutation: PASS'
        exit 0
else
    bootstrap_stage3_run_evidenced
fi
if [ -n "$mutation_pid" ]; then
    wait "$mutation_pid"
    mutation_pid=
fi

grep -qx 'status=component-pass' "$unit/runner-receipt.env"
grep -qx 'authority=false' "$unit/runner-receipt.env"
grep -qx 'transaction_admission=false' "$unit/runner-receipt.env"
grep -qx 'unit_zero_authority=false' "$unit/runner-receipt.env"
grep -qx 'authority=false' "$compatibility_marker/compatibility.env"
grep -qx "run_id=$run_id" "$unit/analysis/receipt.env"
grep -qx 'receipt_schema=simple-stage3-memory-evidence-v2' \
    "$unit/analysis/receipt.env"
[ -f "$unit/.runner-receipt.commit.$run_id" ]
[ -d "$compatibility_marker" ]
[ -f "$admitted_marker" ]
observed_unit_roles=$unit/roles
[ -f "$observed_unit_roles/facade.captured" ]
[ -d "$root/scripts/check/lib/bootstrap-stage3.captured" ]
grep -qx 'mutable facade replacement must not be sourced' \
    "$observed_unit_roles/facade"
grep -qx 'mutable module replacement must not be sourced' \
    "$root/scripts/check/lib/bootstrap-stage3/authority.shs"
case "${STAGE3_POST_CAPTURE_MUTATION:-}" in
    leaf)
        [ -f "$candidate.attack" ]
        [ -f "$candidate_provenance.attack" ]
        [ -f "$unit/roles/shared_runner.attack" ]
        [ -f "$unit/roles/candidate_builder.attack" ]
        [ -f "$unit/roles/dash.attack" ]
        grep -qx 'post-capture leaf replacement' "$candidate.attack"
        grep -qx 'post-capture role leaf replacement' \
            "$unit/roles/shared_runner.attack"
        scratch_display=$(sed -n '1p' "$scratch_display_file")
        grep -qx 'scratch leaf attacker' \
            "$fixture/scratch-leaf-attacker"
        ;;
    ancestor)
        [ -d "$stage3.attack" ]
        [ -d "$unit/roles.attack" ]
        grep -qx 'post-capture ancestor replacement' \
            "$stage3.attack/attacker-sentinel"
        grep -qx 'role ancestor attacker' \
            "$unit/roles.attack/attacker-sentinel"
        scratch_display=$(sed -n '1p' "$scratch_display_file")
        scratch_parent=$(dirname -- "$scratch_display")
        grep -qx 'scratch ancestor attacker' \
            "$scratch_parent.attack/attacker-sentinel"
        ;;
esac
grep -qx "compiler_backfill_status=${STAGE3_COMPILER_BACKFILL:-absent}" \
    "$candidate_provenance"

inventory=$unit/stage3-helper-capsule-inventory.env
capsule=$unit/stage3-helper-capsule.shs
INVENTORY=$inventory CAPSULE=$capsule RECEIPT=$unit/runner-receipt.env \
    /usr/bin/perl -MDigest::SHA=sha256_hex -e '
sub hash_file {
    my ($path) = @_;
    open(my $fh, "<", $path) or die "open $path: $!\n";
    binmode($fh);
    return Digest::SHA->new(256)->addfile($fh)->hexdigest;
}
sub vector_hash {
    my $bytes = "";
    for my $value (@_) { $bytes .= pack("Q>", length($value)) . $value; }
    return sha256_hex($bytes);
}
sub pairs {
    my ($path) = @_;
    open(my $fh, "<", $path) or die "open $path: $!\n";
    my %value;
    while (<$fh>) {
        chomp;
        /\A([a-z][a-z0-9_]*)=(.*)\z/ or die "malformed row\n";
        !exists($value{$1}) or die "duplicate key\n";
        $value{$1} = $2;
    }
    return \%value;
}
my $v = pairs($ENV{INVENTORY});
my @names = qw(bootstrap_script candidate_builder jobs_policy facade authority
    command_snapshot sanity manifest_write manifest_verify self_test
    runner_module planner_admission candidate_frontend bounded_log);
$v->{schema} eq "simple-stage3-helper-capsule-v1" or die "schema\n";
$v->{status} eq "ready" or die "status\n";
$v->{entry} eq "stage3" && $v->{full_entry} eq "stage3" &&
    $v->{resume_entry} eq "stage3" or die "entry parity\n";
$v->{helper_count} eq "14" && $v->{helper_count} == scalar(@names)
    or die "count\n";
my @inventory;
for my $index (1 .. scalar(@names)) {
    my $name = $names[$index - 1];
    $v->{"helper_${index}_name"} eq $name or die "helper order $index\n";
    my $descriptor = $v->{"helper_${index}_descriptor_path"};
    $descriptor =~ m{\A/proc/[1-9][0-9]*/fd/[1-9][0-9]*\z}
        or die "noncanonical descriptor $index\n";
    push @inventory, $name, $v->{"helper_${index}_display_path"},
        $descriptor, $v->{"helper_${index}_dev"},
        $v->{"helper_${index}_ino"}, $v->{"helper_${index}_sha256"};
}
my $inventory_sha = vector_hash(@inventory);
$inventory_sha eq $v->{inventory_sha256} or die "inventory hash\n";
my @tampered_final = @inventory;
$tampered_final[-1] = "0" x 64;
vector_hash(@tampered_final) ne $v->{inventory_sha256}
    or die "bounded log omitted from inventory hash\n";
hash_file($ENV{CAPSULE}) eq $v->{capsule_sha256} or die "capsule hash\n";
my $parity = vector_hash("simple-stage3-helper-capsule-entry-parity-v1",
    "entry", "stage3", "full_entry", "stage3", "resume_entry", "stage3",
    "helper_count", "14", "inventory_sha256", $inventory_sha,
    "capsule_sha256", $v->{capsule_sha256}, "full_caller_sha256",
    $v->{full_caller_sha256}, "candidate_builder_caller_sha256",
    $v->{candidate_builder_caller_sha256});
$parity eq $v->{entry_parity_sha256} or die "entry parity hash\n";
my $receipt = pairs($ENV{RECEIPT});
hash_file($ENV{INVENTORY}) eq $receipt->{helper_capsule_inventory_sha256}
    or die "receipt inventory binding\n";
$v->{capsule_sha256} eq $receipt->{helper_capsule_sha256}
    or die "receipt capsule binding\n";
$parity eq $receipt->{helper_capsule_entry_parity_sha256}
    or die "receipt parity binding\n";
'

echo 'bootstrap Stage3 shared runner focused contract: PASS'
