#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../../.." && pwd)
subject="$repo_root/scripts/check/cert/run-tool-qual-corpus.shs"

check_source() {
    file=$1
    if grep -q '/home/ormastes/dev/pub/simple' "$file"; then
        return 1
    fi
    grep -Fxq 'SIMPLE_BIN="${SIMPLE_BIN:-$REPO_ROOT/bin/release/x86_64-unknown-linux-gnu/simple}"' "$file" || return 1
}

write_fake() {
    target=$1
    cat > "$target" <<'FAKE_BIN'
#!/bin/sh
printf 'x\n' >> "$0.invoked"
case "${2##*/}" in
    ok.spl|wrong.spl) printf '42\n'; exit 0 ;;
    leaks.spl) printf '7\n'; exit 0 ;;
    reject.spl) exit 1 ;;
    *) exit 1 ;;
esac
FAKE_BIN
    chmod 755 "$target"
}

fixture_root=$(mktemp -d)
trap 'rm -rf "$fixture_root"' EXIT HUP INT TERM
relocated="$fixture_root/repo with owner's space"
mkdir -p "$relocated/scripts/check/cert" "$relocated/bin/release/x86_64-unknown-linux-gnu"
cp "$subject" "$relocated/scripts/check/cert/run-tool-qual-corpus.shs"
default_bin="$relocated/bin/release/x86_64-unknown-linux-gnu/simple"
write_fake "$default_bin"

output=$(env -u SIMPLE_BIN sh "$relocated/scripts/check/cert/run-tool-qual-corpus.shs" --self-test)
printf '%s\n' "$output" | grep -Fxq 'SELF-TEST: PASS (correct golden PASS / wrong golden FAIL / leaky negative FAIL / real reject PASS)'
default_count=$(wc -l < "$default_bin.invoked")
test "$default_count" -eq 4

override="$fixture_root/override simple"
write_fake "$override"
override_output=$(SIMPLE_BIN="$override" sh "$relocated/scripts/check/cert/run-tool-qual-corpus.shs" --self-test)
printf '%s\n' "$override_output" | grep -Fxq 'SELF-TEST: PASS (correct golden PASS / wrong golden FAIL / leaky negative FAIL / real reject PASS)'
override_count=$(wc -l < "$override.invoked")
test "$override_count" -eq 4

check_source "$subject"
legacy_mutant="$relocated/scripts/check/cert/legacy.shs"
sed 's|$REPO_ROOT/bin/release/x86_64-unknown-linux-gnu/simple|/home/ormastes/dev/pub/simple/bin/release/x86_64-unknown-linux-gnu/simple|' "$subject" > "$legacy_mutant"
if check_source "$legacy_mutant"; then
    echo 'error: accepted legacy-root mutant' >&2
    exit 1
fi

before=$(wc -l < "$default_bin.invoked")
wrong_default="$fixture_root/wrong-default"
write_fake "$wrong_default"
wrong_mutant="$relocated/scripts/check/cert/wrong-default.shs"
sed "s|\$REPO_ROOT/bin/release/x86_64-unknown-linux-gnu/simple|$wrong_default|" "$subject" > "$wrong_mutant"
wrong_output=$(env -u SIMPLE_BIN sh "$wrong_mutant" --self-test)
printf '%s\n' "$wrong_output" | grep -Fxq 'SELF-TEST: PASS (correct golden PASS / wrong golden FAIL / leaky negative FAIL / real reject PASS)'
wrong_count=$(wc -l < "$wrong_default.invoked")
test "$wrong_count" -eq 4
after=$(wc -l < "$default_bin.invoked")
test "$after" -eq "$before"

echo 'tool-qualification corpus default-path contract: PASS'
