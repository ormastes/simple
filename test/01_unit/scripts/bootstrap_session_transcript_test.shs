#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
work=$(mktemp -d)
work=$(CDPATH= cd "$work" && pwd -P)
trap 'rm -rf "$work"' EXIT HUP INT TERM
${CC:-cc} -std=c11 -O2 -Wall -Wextra -Werror \
    "$root/scripts/bootstrap/bootstrap-session-exec.c" -o "$work/session-exec"
perl "$root/scripts/check/lib/portable-session-exec.pl" sh -eu -c '
    root=$1 work=$2
    . "$root/scripts/check/lib/bootstrap-stage3/authority.shs"
    . "$root/scripts/check/lib/bootstrap-stage3/command-snapshot.shs"
    mkdir "$work/home" "$work/tmp"
    bootstrap_stage3_run_transcribed "$work/command" "$root" "$work/log" \
        "$work/home" "$work/tmp" /usr/bin:/bin \
        TEST_FIXED=present -- /bin/sh -eu -c '\''"$SIMPLE_BOOTSTRAP_SESSION_EXEC" --check; test "$TEST_FIXED" = present; test -z "${UNPLANNED_ENV+x}"; printf "contract-survived\n"'\''
    grep -qx contract-survived "$work/log"
    grep -qx runtime-env-contract:bootstrap-session-v1 "$work/command"
    test "$(grep -c "^host-env:" "$work/command")" = 5
    bootstrap_stage3_verify_command_transcript "$work/command" "$root" \
        TEST_FIXED=changed -- /bin/true && exit 1

    # Regression: explicit command env must not replace the guard-owned pair
    # after the inherited helper has validated it. /usr/bin/true simulates a
    # fake helper which accepts every SID and would allow the payload to run.
    for attack in both sid helper; do
        case "$attack" in
            both) set -- SIMPLE_BOOTSTRAP_SESSION_ID=1 SIMPLE_BOOTSTRAP_SESSION_EXEC=/usr/bin/true ;;
            sid) set -- SIMPLE_BOOTSTRAP_SESSION_ID=1 ;;
            helper) set -- SIMPLE_BOOTSTRAP_SESSION_EXEC=/usr/bin/true ;;
        esac
        if bootstrap_stage3_run_transcribed "$work/$attack.command" "$root" \
            "$work/$attack.log" "$work/home" "$work/tmp" /usr/bin:/bin \
            "$@" -- /usr/bin/touch "$work/$attack.payload"; then
            echo "FAIL: explicit session override accepted" >&2
            exit 1
        fi
        test ! -e "$work/$attack.payload"
        test ! -e "$work/$attack.command"

        # A handcrafted transcript containing the formerly accepted fields
        # must also be refused when verification is called independently.
        sed "/^explicit-env:/d; /^executable:/,$ d" "$work/command" >"$work/forged"
        for assignment in "$@"; do
            printf "explicit-env:%s:%s\n" "${#assignment}" "$assignment" >>"$work/forged"
        done
        printf "executable:9:/bin/true\n" >>"$work/forged"
        if bootstrap_stage3_verify_command_transcript "$work/forged" "$root" "$@" -- /bin/true; then
            echo "FAIL: forged session override transcript verified" >&2
            exit 1
        fi
    done
    # Canonical bootstrap must create its own session even when the ambient
    # SID is numerically correct; an untrusted inherited helper is not authority.
    ambient_row=$("$work/session-exec" --sid $$)
    ambient_sid=${ambient_row#* }
    if SIMPLE_BOOTSTRAP_SESSION_ID="$ambient_sid" SIMPLE_BOOTSTRAP_SESSION_EXEC=/usr/bin/true \
        bootstrap_stage3_run_transcribed "$work/ambient.command" "$root" \
            "$work/ambient.log" "$work/home" "$work/tmp" /usr/bin:/bin \
            -- /usr/bin/touch "$work/ambient.payload"; then
        echo "FAIL: ambient session spoof accepted" >&2
        exit 1
    fi
    test ! -e "$work/ambient.payload"
    grep -qx status=session-helper-install-failed "$work/ambient.log.rss.env"
    echo "PASS: hermetic launch preserves verified session contract and fixed transcript admission"
' sh "$root" "$work"
