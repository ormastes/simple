#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/db-runtime-provenance-test.XXXXXX")
trap 'rm -rf "$WORK_DIR"' EXIT INT TERM
CAPSULE="$WORK_DIR/core-c-bootstrap"
mkdir -p "$CAPSULE/objects"
printf 'archive-bytes\n' >"$CAPSULE/libsimple_runtime.a"
printf 'object-a\n' >"$CAPSULE/objects/runtime_native.o"

hash_file() { sha256sum "$1" | awk '{print $1}'; }
archive_hash=$(hash_file "$CAPSULE/libsimple_runtime.a")
object_hash=$(hash_file "$CAPSULE/objects/runtime_native.o")
cat >"$CAPSULE/capsule.manifest" <<EOF
schema=core-c-bootstrap-runtime-capsule-v1
status=pass
archive_sha256=$archive_hash
repeat_archive_sha256=$archive_hash
repeated_build_equal=true
object_runtime_native_o_sha256=$object_hash
EOF

"$ROOT_DIR/scripts/check/check-db-runtime-capsule-provenance.shs" "$CAPSULE" >"$WORK_DIR/pass.env"
grep -q '^db_runtime_provenance_status=pass$' "$WORK_DIR/pass.env"
grep -q '^db_runtime_core_c_object_count=1$' "$WORK_DIR/pass.env"

printf 'tampered\n' >>"$CAPSULE/libsimple_runtime.a"
if "$ROOT_DIR/scripts/check/check-db-runtime-capsule-provenance.shs" "$CAPSULE" >"$WORK_DIR/tampered.out" 2>&1; then
    echo "FAIL: tampered runtime archive was admitted" >&2
    exit 1
fi
grep -q 'selected archive hash does not match manifest' "$WORK_DIR/tampered.out"

echo "PASS: DB runtime capsule provenance gate contract"
