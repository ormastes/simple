#!/bin/sh
# Structural contract for the ML-KEM measured-coverage receipt validator.

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
validator="$root/scripts/check/check-x25519mlkem768-branch-coverage-receipt.shs"
schema="$root/test/fixtures/crypto/x25519mlkem768/branch_coverage_receipt_schema.sdn"
runtime="$root/src/runtime/runtime_coverage_core.c"

test -f "$validator"
test -f "$schema"
test -f "$runtime"
sh -n "$validator"

grep -F 'measurement_status measured' "$validator" >/dev/null
grep -F 'instrumented-decision-counters' "$validator" >/dev/null
grep -F 'branch_coverage_basis_points' "$validator" >/dev/null
grep -F 'critical_branch_outcome_total 346' "$validator" >/dev/null
grep -F 'coverage_extension: decision-condition-v1' "$runtime" >/dev/null
grep -F 'static_or_unmeasured_promotion_forbidden: true' "$schema" >/dev/null

set +e
output=$(cd "$root" && sh "$validator" 2>&1)
status=$?
set -e
test "$status" -ne 0
printf '%s\n' "$output" | grep -F 'receipt absent:' >/dev/null

echo 'X25519MLKEM768_BRANCH_COVERAGE_RECEIPT_CONTRACT: PASS'
