#!/bin/sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)"
cd "$ROOT_DIR"

TMP_DIR="$(mktemp -d /tmp/simple-backend-artifact-identity-test.XXXXXX)"
trap 'rm -rf "$TMP_DIR"' EXIT HUP INT TERM

CPU_CHECK="scripts/check/check-cpu-backend-artifacts.shs"
GPU_CHECK="scripts/check/check-gpu-backend-layer-evidence.shs"

expect_code() {
    expected="$1" output="$2"
    shift 2
    set +e
    "$@" >"$output" 2>&1
    actual=$?
    set -e
    if [ "$actual" -ne "$expected" ]; then
        echo "expected exit $expected, got $actual" >&2
        sed -n '1,30p' "$output" >&2
        exit 1
    fi
}

# A compiler process returning success is not sufficient evidence that the
# requested backend produced an artifact. Exercise the checker's lineage gate
# without invoking a compiler or accepting seed output as evidence.
FAKE_SIMPLE="$TMP_DIR/fake-simple"
cat >"$FAKE_SIMPLE" <<'FAKE_SIMPLE'
#!/bin/sh
set -eu
if [ "${1:-}" = "--version" ]; then
    echo "Simple self-hosted contract fixture"
    exit 0
fi
output=""
want_output=false
for arg in "$@"; do
    if [ "$want_output" = true ]; then
        output="$arg"
        want_output=false
        continue
    fi
    case "$arg" in
        -o|--output) want_output=true ;;
    esac
done
if [ -n "$output" ]; then
    mkdir -p "$(dirname "$output")"
    printf '%s\n' '#!/bin/sh' 'exit 41' >"$output"
    chmod +x "$output"
fi
echo "Backend: ${FAKE_SIMPLE_REPORTED_BACKEND:-unknown}"
exit 0
FAKE_SIMPLE
chmod +x "$FAKE_SIMPLE"

# LLVM's availability preflight is irrelevant to this lineage-negative case,
# so deterministic command stubs make the branch portable across hosts.
mkdir -p "$TMP_DIR/fake-tools"
for tool in llvm-as opt llc; do
    printf '%s\n' '#!/bin/sh' 'exit 0' >"$TMP_DIR/fake-tools/$tool"
    chmod +x "$TMP_DIR/fake-tools/$tool"
done

expect_code 1 "$TMP_DIR/llvm-wrong-lineage.log" env \
    PATH="$TMP_DIR/fake-tools:$PATH" \
    SIMPLE_BIN="$FAKE_SIMPLE" FAKE_SIMPLE_REPORTED_BACKEND=cranelift \
    BUILD_DIR="$TMP_DIR/cpu-llvm-wrong" \
    sh "$CPU_CHECK" --backend llvm
llvm_fail_rows="$(grep -Ec '^backend=llvm step=.* status=FAIL ' "$TMP_DIR/llvm-wrong-lineage.log")"
test "$llvm_fail_rows" -eq 6
grep -Fq 'backend=llvm step=emit backend IR status=FAIL reason=backend-fallback-detected' \
    "$TMP_DIR/llvm-wrong-lineage.log"
grep -Fq 'cpu_backend_matrix status=FAIL failures=6 skips=0 require_all=0' \
    "$TMP_DIR/llvm-wrong-lineage.log"
if grep -Fq 'status=PASS' "$TMP_DIR/llvm-wrong-lineage.log"; then
    echo "wrong LLVM lineage was admitted" >&2
    exit 1
fi

expect_code 1 "$TMP_DIR/cranelift-wrong-lineage.log" env \
    SIMPLE_BIN="$FAKE_SIMPLE" FAKE_SIMPLE_REPORTED_BACKEND=llvm \
    BUILD_DIR="$TMP_DIR/cpu-cranelift-wrong" \
    sh "$CPU_CHECK" --backend cranelift
cranelift_fail_rows="$(grep -Ec '^backend=cranelift step=.* status=FAIL ' "$TMP_DIR/cranelift-wrong-lineage.log")"
cranelift_skip_rows="$(grep -Ec '^backend=cranelift step=.* status=SKIP_UNAVAILABLE ' "$TMP_DIR/cranelift-wrong-lineage.log")"
test "$cranelift_fail_rows" -eq 4
test "$cranelift_skip_rows" -eq 2
grep -Fq 'backend=cranelift step=emit object status=FAIL reason=object-emission-or-lineage-failed' \
    "$TMP_DIR/cranelift-wrong-lineage.log"
grep -Fq 'backend=cranelift step=link artifact status=FAIL reason=link-or-lineage-failed' \
    "$TMP_DIR/cranelift-wrong-lineage.log"
if grep -Fq 'status=PASS' "$TMP_DIR/cranelift-wrong-lineage.log"; then
    echo "wrong Cranelift lineage was admitted" >&2
    exit 1
fi

# Prove the textual-IR -> bitcode -> verified object identity boundary with the
# host LLVM installation. Tool absence is environment evidence, never PASS.
LLVM_AS="$(command -v llvm-as || true)"
LLVM_OPT="$(command -v opt || true)"
LLVM_DIS="$(command -v llvm-dis || true)"
LLVM_LLC="$(command -v llc || true)"
LLVM_READELF="$(command -v llvm-readelf || command -v readelf || true)"
LLVM_NM="$(command -v llvm-nm || command -v nm || true)"
if [ -z "$LLVM_AS" ] || [ -z "$LLVM_OPT" ] || [ -z "$LLVM_DIS" ] || \
   [ -z "$LLVM_LLC" ] || [ -z "$LLVM_READELF" ] || [ -z "$LLVM_NM" ]; then
    echo "llvm_text_bitcode_object_status=SKIP_UNAVAILABLE reason=missing-host-llvm-tool"
else
    GOOD_LL="$TMP_DIR/identity.ll"
    GOOD_BC="$TMP_DIR/identity.bc"
    GOOD_DIS="$TMP_DIR/identity.dis.ll"
    GOOD_OBJ="$TMP_DIR/identity.x86_64.o"
    cat >"$GOOD_LL" <<'LLVM_IR'
source_filename = "backend_identity_fixture"
target triple = "x86_64-unknown-linux-gnu"

define i32 @backend_identity_probe() {
entry:
  ret i32 41
}
LLVM_IR
    "$LLVM_AS" "$GOOD_LL" -o "$GOOD_BC"
    "$LLVM_OPT" -passes=verify -disable-output "$GOOD_BC"
    "$LLVM_DIS" "$GOOD_BC" -o "$GOOD_DIS"
    "$LLVM_LLC" --filetype=obj -mtriple=x86_64-unknown-linux-gnu "$GOOD_BC" -o "$GOOD_OBJ"
    grep -Fq 'target triple = "x86_64-unknown-linux-gnu"' "$GOOD_DIS"
    grep -Fq 'define i32 @backend_identity_probe()' "$GOOD_DIS"
    "$LLVM_READELF" -h "$GOOD_OBJ" >"$TMP_DIR/identity.readelf"
    grep -Eq 'Machine:.*(Advanced Micro Devices X86-64|X86-64)' "$TMP_DIR/identity.readelf"
    "$LLVM_NM" "$GOOD_OBJ" >"$TMP_DIR/identity.nm"
    grep -Eq '[[:space:]]backend_identity_probe$' "$TMP_DIR/identity.nm"

    BAD_LL="$TMP_DIR/malformed.ll"
    BAD_BC="$TMP_DIR/malformed.bc"
    printf '%s\n' 'define i32 @broken( {' '  ret i32 0' '}' >"$BAD_LL"
    expect_code 1 "$TMP_DIR/malformed-llvm-as.log" "$LLVM_AS" "$BAD_LL" -o "$BAD_BC"
    test ! -s "$BAD_BC"

    TAMPERED_BC="$TMP_DIR/tampered.bc"
    printf '%s\n' 'not LLVM bitcode' >"$TAMPERED_BC"
    expect_code 1 "$TMP_DIR/tampered-opt.log" "$LLVM_OPT" -passes=verify -disable-output "$TAMPERED_BC"

    AARCH64_OBJ="$TMP_DIR/identity.aarch64.o"
    if "$LLVM_LLC" --filetype=obj -mtriple=aarch64-unknown-linux-gnu \
        "$GOOD_BC" -o "$AARCH64_OBJ" >"$TMP_DIR/aarch64-llc.log" 2>&1; then
        "$LLVM_READELF" -h "$AARCH64_OBJ" >"$TMP_DIR/aarch64.readelf"
        grep -Eq 'Machine:.*AArch64' "$TMP_DIR/aarch64.readelf"
        if cmp -s "$GOOD_OBJ" "$AARCH64_OBJ"; then
            echo "x86_64 and AArch64 objects were byte-identical" >&2
            exit 1
        fi
        echo "llvm_target_identity_status=PASS targets=x86_64,aarch64"
    else
        echo "llvm_aarch64_target_status=SKIP_UNAVAILABLE reason=llc-target-unavailable"
    fi
    echo "llvm_text_bitcode_object_status=PASS identity=triple,symbol,machine malformed_ir=REJECTED tampered_bitcode=REJECTED"
fi

# Exercise CUDA/Vulkan/Metal artifact identity and negative source generation
# through the shell checker contract only. These are synthetic producer
# receipts; no device execution is claimed.
FAKE_PORTABLE="$TMP_DIR/fake-portable-check.shs"
cat >"$FAKE_PORTABLE" <<'FAKE_PORTABLE'
#!/bin/sh
set -eu
mkdir -p "$BUILD_DIR"
target="$PORTABLE_COMPUTE_TARGETS"
prefix="$target"
if [ "$target" = vulkan ]; then
    prefix=vulkan_font
fi
artifact="$BUILD_DIR/${target}.artifact"
case "${FAKE_PORTABLE_MODE:-verified}" in
    verified)
        printf 'backend=%s\n' "$target" >"$artifact"
        status=compiled_artifact_verified
        reason="verified-${target}-artifact"
        ;;
    generated-failed)
        status=generated_source_failed
        reason="${target}-source-generation-failed"
        ;;
    unavailable)
        status=unavailable
        reason="${FAKE_PORTABLE_REASON:-missing-primary-tool}"
        ;;
    *) exit 70 ;;
esac
{
    printf '%s_status=%s\n' "$prefix" "$status"
    printf '%s_reason=%s\n' "$prefix" "$reason"
    printf '%s_artifact=%s\n' "$prefix" "$artifact"
} >"$BUILD_DIR/evidence.env"
FAKE_PORTABLE
chmod +x "$FAKE_PORTABLE"

GPU_BACKEND_LAYER_PORTABLE_CHECK="$FAKE_PORTABLE" \
GPU_BACKEND_LAYER_BUILD_DIR="$TMP_DIR/gpu-verified" \
FAKE_PORTABLE_MODE=verified \
    sh "$GPU_CHECK" --targets cuda,vulkan,metal >"$TMP_DIR/gpu-verified.log"
grep -Fq 'gpu_backend_matrix status=SKIP_UNAVAILABLE backends=3 layers=12 unique=12 expected=12 pass=9 failures=0 skips=3 runtime=false' \
    "$TMP_DIR/gpu-verified.log"
for backend in cuda vulkan metal; do
    grep -Fq "${backend}_emit_result=PASS" "$TMP_DIR/gpu-verified.log"
    grep -Fq "${backend}_validate_result=PASS" "$TMP_DIR/gpu-verified.log"
    grep -Fq "${backend}_link_result=PASS" "$TMP_DIR/gpu-verified.log"
    grep -Fq "${backend}_runtime_result=SKIP_UNAVAILABLE" "$TMP_DIR/gpu-verified.log"
    probe_path="$TMP_DIR/gpu-verified/$backend/portable/${backend}.artifact"
    grep -Fq "${backend}_validate_probe=$probe_path" "$TMP_DIR/gpu-verified.log"
    grep -Fq "backend=$backend" "$probe_path"
done
if cmp -s "$TMP_DIR/gpu-verified/cuda/portable/cuda.artifact" \
          "$TMP_DIR/gpu-verified/vulkan/portable/vulkan.artifact"; then
    echo "CUDA and Vulkan artifact identities collapsed" >&2
    exit 1
fi

expect_code 1 "$TMP_DIR/gpu-generation-failed.log" env \
    GPU_BACKEND_LAYER_PORTABLE_CHECK="$FAKE_PORTABLE" \
    GPU_BACKEND_LAYER_BUILD_DIR="$TMP_DIR/gpu-generation-failed" \
    FAKE_PORTABLE_MODE=generated-failed \
    sh "$GPU_CHECK" --targets cuda,vulkan,metal
grep -Fq 'gpu_backend_matrix status=FAIL backends=3 layers=12 unique=12 expected=12 pass=0 failures=9 skips=3 runtime=false' \
    "$TMP_DIR/gpu-generation-failed.log"
for backend in cuda vulkan metal; do
    grep -Fq "${backend}_emit_result=FAIL" "$TMP_DIR/gpu-generation-failed.log"
    grep -Fq "${backend}_validate_result=FAIL" "$TMP_DIR/gpu-generation-failed.log"
    grep -Fq "${backend}_link_result=FAIL" "$TMP_DIR/gpu-generation-failed.log"
    if grep -Fq "${backend}_runtime_result=PASS" "$TMP_DIR/gpu-generation-failed.log"; then
        echo "$backend generation failure reached a false runtime PASS" >&2
        exit 1
    fi
done

GPU_BACKEND_LAYER_PORTABLE_CHECK="$FAKE_PORTABLE" \
GPU_BACKEND_LAYER_BUILD_DIR="$TMP_DIR/metal-unavailable" \
FAKE_PORTABLE_MODE=unavailable FAKE_PORTABLE_REASON=missing-metallib-tool \
    sh "$GPU_CHECK" --targets metal >"$TMP_DIR/metal-unavailable.log"
grep -Fq 'metal_validate_result=SKIP_UNAVAILABLE' "$TMP_DIR/metal-unavailable.log"
grep -Fq 'metal_reason=missing-metallib-tool' \
    "$TMP_DIR/metal-unavailable/metal/portable/evidence.env"
grep -Fq 'metal_link_result=SKIP_UNAVAILABLE' "$TMP_DIR/metal-unavailable.log"
grep -Fq 'metal_runtime_result=SKIP_UNAVAILABLE' "$TMP_DIR/metal-unavailable.log"
if grep -Eq '^metal_(validate|link|runtime)_result=PASS$' "$TMP_DIR/metal-unavailable.log"; then
    echo "unavailable Metal environment was admitted" >&2
    exit 1
fi

echo "backend-artifact-identity-target-environment-test: pass"
