#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
setup=${RISCV_GATE_FIXTURE_SETUP_UNDER_TEST:-"$repo_root/test/riscv_isa_gate/setup_checked_in_rtl_fixture.shs"}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

fake_root="$tmp/relocated repo"
source_dir="$fake_root/examples/09_embedded/fpga_riscv/rtl"
fixture="$tmp/fixture with spaces"
mkdir -p "$source_dir"
cat >"$source_dir/rv32_exec_core.vhd" <<'EOF'
entity rv32_exec_core is
end entity;
file f : text open read_mode is "rv32_payload.mem";
file f : text open read_mode is "rv32_fat32.mem";
EOF
stale_dir="$fake_root/build/vhdl/rv32"
mkdir -p "$stale_dir"
cat >"$stale_dir/rv32_exec_core.vhd" <<'EOF'
entity rv32_exec_core is
end entity;
file f : text open read_mode is "rv32_payload.mem";
file f : text open read_mode is "rv32_fat32.mem";
-- stale generated decoy: this must never be staged
EOF

(
    cd /
    RISCV_ISA_GATE_REPO_ROOT="$fake_root" sh "$setup" "$fixture"
) >"$tmp/setup.out"

cmp "$source_dir/rv32_exec_core.vhd" "$fixture/rv32_exec_core.vhd"
! cmp -s "$stale_dir/rv32_exec_core.vhd" "$fixture/rv32_exec_core.vhd"
[ -f "$fixture/rv32_payload.mem" ] && [ ! -s "$fixture/rv32_payload.mem" ]
[ -f "$fixture/rv32_fat32.mem" ] && [ ! -s "$fixture/rv32_fat32.mem" ]
[ "$(find "$fixture" -mindepth 1 -maxdepth 1 -type f | wc -l)" -eq 3 ]
grep -Fq 'RISCV_ISA_GATE_FIXTURE: PASS source=checked-in-rv32-exec-core' "$tmp/setup.out"

sentinel_dir="$tmp/nonempty"
mkdir -p "$sentinel_dir"
: >"$sentinel_dir/sentinel"
if RISCV_ISA_GATE_REPO_ROOT="$fake_root" sh "$setup" "$sentinel_dir" \
    >"$tmp/nonempty.out" 2>"$tmp/nonempty.err"; then
    echo "nonempty fixture directory was accepted" >&2
    exit 1
fi
grep -Fq 'fixture directory must be empty' "$tmp/nonempty.err"
[ -f "$sentinel_dir/sentinel" ]

missing_root="$tmp/missing root"
if RISCV_ISA_GATE_REPO_ROOT="$missing_root" sh "$setup" "$tmp/missing-source-fixture" \
    >"$tmp/missing.out" 2>"$tmp/missing.err"; then
    echo "missing checked-in core was accepted" >&2
    exit 1
fi
grep -Fq 'checked-in RV32 core not found' "$tmp/missing.err"

bad_root="$tmp/incompatible root"
bad_source="$bad_root/examples/09_embedded/fpga_riscv/rtl"
mkdir -p "$bad_source"
cp "$source_dir/rv32_exec_core.vhd" "$bad_source/rv32_exec_core.vhd"
sed 's/rv32_fat32.mem/renamed_fat32.mem/' "$bad_source/rv32_exec_core.vhd" \
    >"$bad_source/rv32_exec_core.vhd.new"
mv "$bad_source/rv32_exec_core.vhd.new" "$bad_source/rv32_exec_core.vhd"
if RISCV_ISA_GATE_REPO_ROOT="$bad_root" sh "$setup" "$tmp/incompatible-fixture" \
    >"$tmp/incompatible.out" 2>"$tmp/incompatible.err"; then
    echo "incompatible checked-in core was accepted" >&2
    exit 1
fi
grep -Fq 'auxiliary-memory contract changed' "$tmp/incompatible.err"

commented_entity_root="$tmp/commented entity root"
commented_entity_source="$commented_entity_root/examples/09_embedded/fpga_riscv/rtl"
mkdir -p "$commented_entity_source"
sed 's/^entity rv32_exec_core is$/-- entity rv32_exec_core is/' \
    "$source_dir/rv32_exec_core.vhd" >"$commented_entity_source/rv32_exec_core.vhd"
if RISCV_ISA_GATE_REPO_ROOT="$commented_entity_root" sh "$setup" "$tmp/commented-entity-fixture" \
    >"$tmp/commented-entity.out" 2>"$tmp/commented-entity.err"; then
    echo "commented-out RV32 entity was accepted" >&2
    exit 1
fi
grep -Fq 'has no rv32_exec_core entity' "$tmp/commented-entity.err"

commented_payload_root="$tmp/commented payload root"
commented_payload_source="$commented_payload_root/examples/09_embedded/fpga_riscv/rtl"
mkdir -p "$commented_payload_source"
sed 's/^file f : text open read_mode is "rv32_payload.mem";/-- file f : text open read_mode is "rv32_payload.mem";/' \
    "$source_dir/rv32_exec_core.vhd" >"$commented_payload_source/rv32_exec_core.vhd"
if RISCV_ISA_GATE_REPO_ROOT="$commented_payload_root" sh "$setup" "$tmp/commented-payload-fixture" \
    >"$tmp/commented-payload.out" 2>"$tmp/commented-payload.err"; then
    echo "commented-out payload-memory declaration was accepted" >&2
    exit 1
fi
grep -Fq 'payload-memory contract changed' "$tmp/commented-payload.err"

if sh "$setup" >"$tmp/usage.out" 2>"$tmp/usage.err"; then
    echo "missing fixture directory was accepted" >&2
    exit 1
fi
grep -Fq 'EMPTY_FIXTURE_DIR' "$tmp/usage.err"

echo "PASS: checked-in RV32 ISA gate fixture is isolated, deterministic, and source-bound"
