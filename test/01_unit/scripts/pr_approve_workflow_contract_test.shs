#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
WORKFLOW="$ROOT/.github/workflows/pr-approve.yml"

verify=$(awk '/- name: Verify the approval was recorded/{on=1} on{print}' "$WORKFLOW")
fail=0
require() {
    printf '%s\n' "$verify" | grep -F -- "$1" >/dev/null || {
        echo "FAIL: approval verifier lacks $2" >&2
        fail=$((fail + 1))
    }
}
forbid() {
    if printf '%s\n' "$verify" | grep -F -- "$1" >/dev/null; then
        echo "FAIL: approval verifier still uses $2" >&2
        fail=$((fail + 1))
    fi
}

require 'headRefOid' 'the exact PR head lookup'
require '.user.login == "github-actions[bot]"' 'the approval bot identity filter'
require '.commit_id == $head' 'the exact head commit filter'
require 'gh api --paginate --slurp' 'complete review pagination'
require "jq -r --arg head \"\$head\"" 'standalone jq evaluation after pagination'
require '| last | .state' 'latest-review state selection'
forbid '--json reviewDecision' 'the aggregate reviewDecision signal'
forbid '.state == \"APPROVED\"' 'approval filtering before latest-review selection'
if printf '%s\n' "$verify" | grep -E -- 'gh api .*--slurp.*--jq' >/dev/null; then
    echo "FAIL: gh api combines incompatible --slurp and --jq options" >&2
    exit 1
fi

query='[.[][] | select(.user.login == "github-actions[bot]" and .commit_id == "head-new")] | last | .state // ""'
fixture='[[
  {"user":{"login":"github-actions[bot]"},"commit_id":"head-new","state":"APPROVED"},
  {"user":{"login":"human"},"commit_id":"head-new","state":"APPROVED"}
],[
  {"user":{"login":"github-actions[bot]"},"commit_id":"head-old","state":"APPROVED"},
  {"user":{"login":"github-actions[bot]"},"commit_id":"head-new","state":"CHANGES_REQUESTED"}
]]'
state=$(printf '%s\n' "$fixture" | jq -r "$query")
[ "$state" = CHANGES_REQUESTED ] || { echo "FAIL: superseding review was ignored" >&2; exit 1; }

fixture='[[
  {"user":{"login":"github-actions[bot]"},"commit_id":"head-new","state":"APPROVED"}
],[
  {"user":{"login":"github-actions[bot]"},"commit_id":"head-new","state":"DISMISSED"}
]]'
state=$(printf '%s\n' "$fixture" | jq -r "$query")
[ "$state" = DISMISSED ] || { echo "FAIL: dismissed latest review was ignored" >&2; exit 1; }

fixture='[[
  {"user":{"login":"github-actions[bot]"},"commit_id":"head-old","state":"APPROVED"}
],[
  {"user":{"login":"github-actions[bot]"},"commit_id":"head-new","state":"APPROVED"}
]]'
state=$(printf '%s\n' "$fixture" | jq -r "$query")
[ "$state" = APPROVED ] || { echo "FAIL: approval on a subsequent page was missed" >&2; exit 1; }

[ "$fail" -eq 0 ] || exit 1
echo "PASS: PR approval verification is bound to the bot review on the exact PR head"
