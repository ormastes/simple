#!/bin/sh
# Regression test for the four rt_ map gates. The SAME test runs against the .shs ports (default)
# or the retired Python originals (python3 -I, CR-stripped) through env overrides:
#   RT_HOST_MAP="python3 -I scripts/check/check-rt-host-map.py"   RT_POINTER_MAP=...   RT_INDEX=...
#   RT_CONTRACT=...  (slow: set RT_TEST_CONTRACT=1 to include its compiler-driven selftest)
# Usage: sh test/01_unit/scripts/rt_map_gates_shs_test.shs   (from the repo root)
# Last line: PASS (exit 0) or FAIL (exit 1).
LC_ALL=C; export LC_ALL
HOST=${RT_HOST_MAP:-sh scripts/check/check-rt-host-map.shs}
PTR=${RT_POINTER_MAP:-sh scripts/check/check-rt-pointer-ref-map.shs}
IDX=${RT_INDEX:-sh scripts/check/rt-binding-index.shs}
CON=${RT_CONTRACT:-sh scripts/check/check-rt-c-contract-compile.shs}
fails=0; ran=0
# run the gate to a file so its own exit code is read directly (never through a pipe)
gate() { # label want_rc want_last_regex "command string"
  _l=$1; _w=$2; _re=$3; _cmd=$4
  _f=$(mktemp) || exit 2
  eval "$_cmd" > "$_f" 2>&1; _rc=$?
  tr -d '\r' < "$_f" > "$_f.lf"; _last=$(tail -n 1 "$_f.lf"); rm -f "$_f" "$_f.lf"
  ran=$((ran + 1))
  [ "$_rc" = "$_w" ] || { echo "FAIL $_l: exit $_rc, wanted $_w"; fails=$((fails + 1)); return; }
  printf '%s\n' "$_last" | grep -Eq "$_re" || { echo "FAIL $_l: last line '$_last' !~ $_re"; fails=$((fails + 1)); }
}
mkfx() { # c-source spl-source -> sets FX
  FX=$(mktemp -d) || exit 2
  mkdir -p "$FX/src/runtime" "$FX/src/lib" "$FX/scripts/check"
  printf '%b' "$1" > "$FX/src/runtime/a.c"
  printf '%b' "$2" > "$FX/src/lib/a.spl"
}

# 1. selftests (the original fixtures: 14+include host cases, 15+8+27 pointer cases, 5 index records)
gate host-selftest 0 '^PASS' "$HOST --selftest"
gate pointer-selftest 0 '^PASS' "$PTR --selftest"
gate index-selftest 0 '^PASS' "$IDX --selftest"
[ "${RT_TEST_CONTRACT:-0}" = 1 ] && gate contract-selftest 0 '^PASS' "$CON --selftest"

# 2. spec cases (test/01_unit/app/check/rt_*_spec.spl): verdict + exit code on small trees
NILC='char *rt_x(void) {\n if (a) return NULL;\n return b;\n}\n'
mkfx "$NILC" 'extern fn rt_x() -> text\n'
gate pointer-new-nil-fails 1 '^FAIL' "$PTR --root $FX"
mkfx "$NILC" 'extern fn rt_x() -> text?\n'
gate pointer-nullable-passes 0 '^PASS' "$PTR --root $FX"
mkfx 'char *rt_x(void);\n' 'fn other() -> text\n'
gate pointer-no-edges-errors 2 '^ERROR' "$PTR --root $FX"
mkfx 'long rt_x(void) { return 1; }\n' 'extern fn rt_x() -> i64\n'
gate host-everywhere-passes 0 '^PASS' "$HOST --root $FX"
mkfx '#if defined(__linux__)\nlong rt_x(void) { return 1; }\n#endif\n' 'extern fn rt_x() -> i64\n'
gate host-linux-only-fails 1 '^FAIL' "$HOST --root $FX"
mkfx 'static long rt_x(void) { return 1; }\n' 'extern fn rt_x() -> i64\n'
gate host-static-is-nothing 2 '^ERROR' "$HOST --root $FX"
# 3. baseline round trip: regen holds its rows, then a stale row fails
mkfx '#if defined(__linux__)\nlong rt_x(void) { return 1; }\n#endif\n' 'extern fn rt_x() -> i64\n'
mkdir -p "$FX/scripts/check"
gate host-regen 0 '^PASS' "$HOST --root $FX --regen-baseline"
gate host-baseline-holds 0 '^PASS' "$HOST --root $FX"
printf 'linux:rt_gone\n' >> "$FX/scripts/check/rt_host_map_baseline.txt"
gate host-stale-fails 1 '^FAIL' "$HOST --root $FX"
# 4. index: two runs byte-identical, compile/link always UNTESTED
mkfx 'char *rt_x(void) {\n return b;\n}\n' 'extern fn rt_x() -> text\n'
gate index-run-1 0 '^RT_BINDING_INDEX' "$IDX --root $FX --out $FX/a.json"
gate index-run-2 0 '^RT_BINDING_INDEX' "$IDX --root $FX --out $FX/b.json"
tr -d '\r' < "$FX/a.json" > "$FX/a.lf"; tr -d '\r' < "$FX/b.json" > "$FX/b.lf"
ran=$((ran + 1)); cmp -s "$FX/a.lf" "$FX/b.lf" || { echo "FAIL index two runs differ"; fails=$((fails + 1)); }
ran=$((ran + 1)); grep -Eq '"(compile|link)": "(PASS|FAIL)"' "$FX/a.lf" && { echo "FAIL index compile/link not UNTESTED"; fails=$((fails + 1)); }

if [ "$fails" -gt 0 ]; then echo "FAIL — $fails of $ran check(s)"; exit 1; fi
echo "PASS — $ran check(s)"
exit 0
