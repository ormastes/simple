#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
runner="$repo_root/test/riscv_isa_gate/run_gate.sh"
contract="$repo_root/test/01_unit/scripts/riscv_isa_gate_runner_path_contract_test.shs"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

expect_red() {
    name=$1
    expression=$2
    mutant="$tmp/$name.sh"
    sed "$expression" "$runner" >"$mutant"
    chmod +x "$mutant"
    if cmp -s "$runner" "$mutant"; then
        echo "mutation was not applied: $name" >&2
        exit 1
    fi
    if RISCV_GATE_RUNNER_UNDER_TEST="$mutant" sh "$contract" \
        >"$tmp/$name.out" 2>"$tmp/$name.err"; then
        echo "mutation survived: $name" >&2
        exit 1
    fi
}

expect_red remove_repo_root_override \
    's|^REPO_ROOT=.*|REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." \&\& pwd -P)|'
expect_red remove_gate_dir_override \
    's|^GATE_DIR=.*|GATE_DIR="$REPO_ROOT/test/riscv_isa_gate"|'
expect_red remove_build_dir_override \
    's|^GHDL_WORK_DIR=.*|GHDL_WORK_DIR="$REPO_ROOT/build/vhdl/rv32"|'
expect_red remove_missing_gate_check \
    '/RISC-V ISA gate directory not found/d'
expect_red remove_missing_build_check \
    '/RISC-V ISA build directory not found/d'

echo "PASS: RISC-V ISA gate runner path contract kills all required mutations"
