#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
scratch=$(mktemp -d "${TMPDIR:-/tmp}/bs7-test.XXXXXX"); trap 'rm -rf "$scratch"' EXIT HUP INT TERM
fail() { echo "BS7 cohort test: FAIL — $*" >&2; exit 1; }
reject() { if "$@" >/dev/null 2>&1; then fail "mutation accepted"; fi; }
printf 'stage=4\ncompiler_kind=pure-simple-stage4\n' >"$scratch/stage4.env"
dd if=/dev/zero of="$scratch/simple" bs=1024 count=10 2>/dev/null
dd if=/dev/zero of="$scratch/c" bs=1024 count=10 2>/dev/null
: >"$scratch/nogc.tsv"; : >"$scratch/providers.tsv"; : >"$scratch/samples.tsv"
i=1; while [ "$i" -le 30 ]; do
  printf 'sample|simple|%s|100|100|0|aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n' "$i" >>"$scratch/samples.tsv"
  printf 'sample|python|%s|100|100|0|aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n' "$i" >>"$scratch/samples.tsv"
  i=$((i+1))
done
produce() { (cd "$scratch" && "$ROOT/scripts/check/produce-runtime-binary-size-startup-cohort.shs" --mode development --output-dir out --samples samples.tsv --simple-binary simple --c-binary c --stage4-receipt stage4.env --nogc-inventory nogc.tsv --provider-trace providers.tsv --format-allowance-bytes 0); }
check() { "$ROOT/scripts/check/check-runtime-binary-size-startup-cohort.shs" --receipt "$scratch/out/receipt.env" --samples "$scratch/out/samples.tsv" --simple-binary "$scratch/simple" --c-binary "$scratch/c" --stage4-receipt "$scratch/stage4.env" --nogc-inventory "$scratch/out/nogc-inventory.tsv" --provider-trace "$scratch/out/provider-trace.tsv"; }
produce >/dev/null || fail clean-producer
check >/dev/null || fail clean-checker
printf 'collector\n' >"$scratch/out/nogc-inventory.tsv"; reject check; : >"$scratch/out/nogc-inventory.tsv"
printf 'provider\n' >"$scratch/out/provider-trace.tsv"; reject check; : >"$scratch/out/provider-trace.tsv"
printf 'stage=3\ncompiler_kind=rust-seed\n' >"$scratch/stage4.env"; reject check
printf 'stage=4\ncompiler_kind=pure-simple-stage4\n' >"$scratch/stage4.env"
sed -i.bak 's/sample_count=30/sample_count=29/' "$scratch/out/receipt.env"; reject check; mv "$scratch/out/receipt.env.bak" "$scratch/out/receipt.env"
printf x >>"$scratch/simple"; reject check
echo 'BS7 cohort test: PASS — clean cohort and five mutations'
