#!/bin/sh
set -Eeuo pipefail

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$root/scripts/setup/host-env.shs"
host_env_apply_path
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) ;; *) echo 'BLOCKED: Windows/MSYS required' >&2; exit 77 ;; esac
for tool in git mktemp cygpath powershell stat; do
    command -v "$tool" >/dev/null || { echo "BLOCKED: missing $tool" >&2; exit 77; }
done

mkdir -p "$root/build/test-tmp"
tmp=$(mktemp -d "$root/build/test-tmp/simple-materialize-receipt.XXXXXX")
trap 'rm -rf -- "$tmp"' EXIT
export TMPDIR="$tmp"

repo="$tmp/repo"
mkdir -p "$repo" "$tmp/out"
git -C "$repo" init -q
git -C "$repo" config core.symlinks false
git -C "$repo" config user.email test@example.invalid
git -C "$repo" config user.name materializer-receipt-test
printf 'payload\n' >"$repo/target.txt"
printf 'target.txt' >"$repo/alias"
blob=$(git -C "$repo" hash-object -w --stdin <"$repo/alias")
git -C "$repo" add target.txt
git -C "$repo" update-index --add --cacheinfo "120000,$blob,alias"
mkdir "$repo/target-dir"
printf 'nested payload\n' >"$repo/target-dir/nested.txt"
printf 'target-dir' >"$repo/directory-alias"
directory_blob=$(git -C "$repo" hash-object -w --stdin <"$repo/directory-alias")
git -C "$repo" add target-dir/nested.txt
git -C "$repo" update-index --add --cacheinfo "120000,$directory_blob,directory-alias"
git -C "$repo" commit -qm fixture

# Cover both the already-existing directory handle and the handle returned by
# exclusive native directory creation, with a Unicode receipt basename.
for receipt in "$tmp/out/receipt.env" "$tmp/out/created dir/雪.env"; do
log="$tmp/materializer.log"
sh "$root/scripts/setup/materialize-symlinks-windows.shs" \
    --strict-missing --receipt "$receipt" "$repo" >"$log" 2>&1 || {
    cat "$log" >&2
    exit 1
}
grep -Fqx 'result=complete' "$receipt"
grep -Fqx 'pending_count=0' "$receipt"
test "$(stat -c '%d:%i' "$repo/alias")" = "$(stat -c '%d:%i' "$repo/target.txt")"
test "$(cat "$repo/alias")" = 'payload'
test "$(cat "$repo/directory-alias/nested.txt")" = 'nested payload'
test "$(find "$(dirname "$receipt")" -maxdepth 1 -name '.materializer-*.tmp' | wc -l | tr -d ' ')" -eq 0

# Publication is no-replace: an existing receipt remains byte-for-byte intact.
cp "$receipt" "$tmp/receipt.before"
if sh "$root/scripts/setup/materialize-symlinks-windows.shs" \
    --strict-missing --receipt "$receipt" "$repo" >"$tmp/rerun.log" 2>&1; then
    echo 'receipt publication unexpectedly replaced an existing destination' >&2
    exit 1
fi
cmp "$receipt" "$tmp/receipt.before"
done
echo 'PASS: Windows receipt publication uses direct native write/flush and no-replace cleanup'

# A core.symlinks=true checkout (the windows-latest image default) carries
# git's own native symlinks. Bare mode must accept them untouched and keep them
# out of the undo manifest; receipt mode must fail closed.
echo "runner core.symlinks: $(git -C "$root" config --show-origin core.symlinks || echo unset)"
native="$tmp/native"
git -c core.symlinks=true clone -q "$repo" "$native"
if [ ! -L "$native/alias" ]; then
    echo 'BLOCKED: this host cannot create native symlinks; native-symlink fixture skipped' >&2
    exit 0
fi
sh "$root/scripts/setup/materialize-symlinks-windows.shs" "$native" >"$tmp/native.log" 2>&1 || {
    cat "$tmp/native.log" >&2
    exit 1
}
test -L "$native/alias"
test -L "$native/directory-alias"
test "$(cat "$native/alias")" = 'payload'
test "$(cat "$native/directory-alias/nested.txt")" = 'nested payload'
if grep -Eq 'alias' "$native/.git/simple-materializer-manifest.tsv" 2>/dev/null; then
    echo 'native git symlink was recorded in the undo manifest' >&2
    exit 1
fi
if sh "$root/scripts/setup/materialize-symlinks-windows.shs" \
    --receipt "$tmp/out/native.env" "$native" >"$tmp/native-receipt.log" 2>&1; then
    echo 'receipt mode unexpectedly admitted a native git symlink' >&2
    exit 1
fi
grep -Fq 'native git symlink is not receiptable' "$tmp/native-receipt.log" || {
    cat "$tmp/native-receipt.log" >&2
    exit 1
}
echo 'PASS: native git symlinks from a core.symlinks=true checkout are accepted untouched'
