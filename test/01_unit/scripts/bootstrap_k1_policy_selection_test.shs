#!/bin/sh
# Execute only the production manifest-policy block; never enter bootstrap.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
work=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap-k1-policy.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
awk '/^kernel_policy_manifest=/ {copy=1} copy && /^# Bootstrap wrapper/ {exit} copy {print}' \
  "$root/scripts/bootstrap/bootstrap-from-scratch.sh" >"$work/policy.shs"
[ -s "$work/policy.shs" ] || { echo 'FAIL: production policy block missing' >&2; exit 1; }
fixture=$work/fixture
mkdir -p "$fixture/doc/04_architecture/compiler/plugin_arch"
manifest=$fixture/doc/04_architecture/compiler/plugin_arch/kernel_closure.sdn
original=$root/doc/04_architecture/compiler/plugin_arch/kernel_closure.sdn
probe() {
  selection=$1
  (
    unset SIMPLE_KERNEL_K1_POLICY SIMPLE_ABI_POLICY SIMPLE_PLUGIN_MANIFEST_POLICY SIMPLE_COVERAGE_CUTOVER_STATE
    [ "$selection" = unset ] || export SIMPLE_KERNEL_K1_POLICY=$selection
    bootstrap_early_repo_root=$fixture
    . "$work/policy.shs"
    printf '%s\n' "$selected_k1_policy|$SIMPLE_KERNEL_K1_POLICY"
  ) >"$work/out" 2>"$work/err"
}
cp "$original" "$manifest"
probe unset
[ "$(cat "$work/out")" = 'llvm-cranelift|llvm-cranelift' ]
probe llvm-cranelift
[ "$(cat "$work/out")" = 'llvm-cranelift|llvm-cranelift' ]
probe llvm
[ "$(cat "$work/out")" = 'llvm|llvm' ]
if probe unadmitted; then echo 'FAIL: unadmitted policy accepted' >&2; exit 1; fi
grep -Fq 'drifts from canonical' "$work/err"
for key in k1_policy k1_policy_alternates; do
  awk -v key="$key" '$1 != key ":"' "$original" >"$manifest"
  if probe unset; then echo "FAIL: missing $key accepted" >&2; exit 1; fi
  [ ! -s "$work/out" ]
  cp "$original" "$manifest"
  awk -v key="$key" '$1 == key ":" {print}' "$original" >>"$manifest"
  if probe unset; then echo "FAIL: duplicate $key accepted" >&2; exit 1; fi
  [ ! -s "$work/out" ]
done
rm "$manifest"
if probe unset; then echo 'FAIL: missing manifest accepted' >&2; exit 1; fi
grep -Fq 'canonical kernel policy authority is missing' "$work/err"
echo 'PASS: source-derived K1 selection, alternate, drift, missing/duplicate keys, and missing manifest'
