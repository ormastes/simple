#!/bin/sh
# Bind the actual MSVC LLVM owners, including explicit paths with spaces.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
. "$root/scripts/check/lib/bootstrap-stage3/authority.shs"
fixture=$(mktemp -d "${TMPDIR:-/tmp}/simple-msvc-tool-authority.XXXXXX")
fixture=$(CDPATH= cd -- "$fixture" && pwd -P)
trap 'rm -rf -- "$fixture"' EXIT HUP INT TERM
mkdir "$fixture/tools" "$fixture/selected tools"
for tool in cargo rustc clang-cl lld-link llvm-ar llvm-ranlib; do
    printf '#!/bin/sh\nprintf "fixture %s version 1\\n"\n' "$tool" >"$fixture/tools/$tool"
    chmod +x "$fixture/tools/$tool"
done
cp "$fixture/tools/lld-link" "$fixture/selected tools/lld-link"
test_path="$fixture/tools:/usr/bin:/bin"
bootstrap_stage3_host_platform() { printf '%s\n' x86_64-pc-windows-msvc; }
bootstrap_stage3_target_c_compiler() { printf '%s\n' "$fixture/tools/clang-cl"; }
bootstrap_stage3_resolve_rust_toolchain() {
    printf 'rustc-path=%s\ncargo-path=%s\n' "$fixture/tools/rustc" "$fixture/tools/cargo"
}
CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER="$fixture/selected tools/lld-link"
LD=missing-ambient-linker
AR="$fixture/tools/llvm-ar" RANLIB="$fixture/tools/llvm-ranlib"
export CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER LD AR RANLIB
bootstrap_stage3_tool_authority_snapshot "$fixture/snapshot" "$test_path" "$root"
grep -F "tool=lld-link|requested=$fixture/selected tools/lld-link|" "$fixture/snapshot" >/dev/null
grep -F "tool=llvm-ar|requested=$fixture/tools/llvm-ar|" "$fixture/snapshot" >/dev/null
grep -F "tool=llvm-ranlib|requested=$fixture/tools/llvm-ranlib|" "$fixture/snapshot" >/dev/null
if grep -E '^tool=(ld|ar|ranlib)\|' "$fixture/snapshot"; then
    echo 'FAIL: MSVC snapshot admitted unrelated GNU owners' >&2
    exit 1
fi
CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER="$fixture/missing-selected-linker"
if bootstrap_stage3_tool_authority_snapshot "$fixture/refused" "$test_path" "$root"; then
    echo 'FAIL: missing selected linker silently fell back' >&2
    exit 1
fi
[ ! -e "$fixture/refused" ]
printf 'PASS: MSVC tool authority binds selected LLVM owners and refuses missing linker\n'
