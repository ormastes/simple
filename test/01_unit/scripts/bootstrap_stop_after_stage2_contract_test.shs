#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
bootstrap_script="${repo_root}/scripts/bootstrap/bootstrap-from-scratch.sh"
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap-stop-after-stage2.XXXXXX")
repo_resume_dir=$(mktemp -d "${repo_root}/scratch/bootstrap-resume-path.XXXXXX")
external_resume_dir=
trap 'rm -rf "${tmp_dir}" "${repo_resume_dir}" ${external_resume_dir:+"${external_resume_dir}"}' EXIT HUP INT TERM

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

help=$(sh "${bootstrap_script}" --help)
printf '%s\n' "${help}" | grep -Fq -- '--stop-after-stage2' ||
  fail "Stage 2 stop option is missing from help"
printf '%s\n' "${help}" | grep -Fq -- 'Build and admit Stage 2, then stop before Stage 3' ||
  fail "Stage 2 stop behavior is undocumented"

grep -Fq 'stop_after_stage2=0' "${bootstrap_script}" ||
  fail "Stage 2 stop option is not default-off"
grep -Fq -- '--stop-after-stage2)' "${bootstrap_script}" ||
  fail "Stage 2 stop option is not parsed"
grep -Fq 'Stage 2 admitted; stopping before Stage 3 as requested.' \
  "${bootstrap_script}" || fail "Stage 2 stop has no admitted-artifact terminal receipt"
grep -Fq 'requires a successful admitted Stage 2 compiler' \
  "${bootstrap_script}" || fail "Stage 2 stop can report success without admission"
grep -Fq 'refused incomplete Stage 2 admission provenance' \
  "${bootstrap_script}" || fail "Stage 2 stop lacks a provenance gate"

stop_line=$(grep -n 'Stage 2 admitted; stopping before Stage 3 as requested.' \
  "${bootstrap_script}" | sed -n '1s/:.*//p')
stage3_line=$(grep -n '^  # Stage 3: stage2 recompiles bootstrap_main.spl' \
  "${bootstrap_script}" | sed -n '1s/:.*//p')
case "${stop_line}:${stage3_line}" in
  *[!0-9:]*|:*) fail "could not locate Stage 2 stop before Stage 3" ;;
esac
[ "${stop_line}" -lt "${stage3_line}" ] ||
  fail "Stage 2 stop is placed after Stage 3"

assert_rejected() {
  name=$1
  expected=$2
  shift 2
  log="${tmp_dir}/${name}.log"
  if sh "${bootstrap_script}" "$@" >"${log}" 2>&1; then
    fail "accepted incompatible invocation: ${name}"
  fi
  grep -Fq -- "${expected}" "${log}" ||
    fail "incompatible invocation did not explain rejection: ${name}"
}

assert_rejected full_cli \
  '--stop-after-stage2 is incompatible with Stage 3/4, deploy, release, or diagnostic-sweep options' \
  --stop-after-stage2 --full-cli
assert_rejected deploy \
  '--stop-after-stage2 is incompatible with Stage 3/4, deploy, release, or diagnostic-sweep options' \
  --stop-after-stage2 --deploy
assert_rejected diagnostic_sweep \
  '--stop-after-stage2 is incompatible with Stage 3/4, deploy, release, or diagnostic-sweep options' \
  --stop-after-stage2 --diagnostic-sweep
assert_rejected resume \
  '--stop-after-stage2 and --resume-stage3-from-admitted conflict' \
  --stop-after-stage2 --resume-stage3-from-admitted=build/fixture
assert_rejected simpleos \
  '--stop-after-stage2 is unavailable for the SimpleOS target lane' \
  --stop-after-stage2 --target=simpleos-x86_64

assert_resume_path_rejected() {
  name=$1
  path=$2
  log="${tmp_dir}/resume-${name}.log"
  if sh "${bootstrap_script}" \
    "--resume-stage3-from-admitted=${path}" >"${log}" 2>&1; then
    fail "accepted incomplete Stage 3 fixture: ${name}"
  fi
  grep -Fq 'error: invalid Stage 3 resume output path:' "${log}" ||
    fail "unsafe Stage 3 resume path reached evidence validation: ${name}"
}

assert_resume_path_reaches_evidence_gate() {
  name=$1
  path=$2
  log="${tmp_dir}/resume-${name}.log"
  if sh "${bootstrap_script}" \
    "--resume-stage3-from-admitted=${path}" >"${log}" 2>&1; then
    fail "empty Stage 3 fixture unexpectedly resumed: ${name}"
  fi
  if grep -Fq 'error: invalid Stage 3 resume output path:' "${log}"; then
    fail "canonical Stage 3 resume path was rejected: ${name}"
  fi
}

repo_resume_rel=${repo_resume_dir#"${repo_root}/"}
assert_resume_path_reaches_evidence_gate repo_relative "${repo_resume_rel}"
assert_resume_path_reaches_evidence_gate repo_absolute "${repo_resume_dir}"

arbitrary_resume_dir=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap-resume-arbitrary.XXXXXX")
assert_resume_path_rejected arbitrary_absolute "${arbitrary_resume_dir}"
assert_resume_path_rejected traversal "${repo_resume_rel}/../$(basename "${repo_resume_dir}")"
resume_symlink="${tmp_dir}/resume-symlink"
ln -s "${repo_resume_dir}" "${resume_symlink}"
assert_resume_path_rejected symlink "${resume_symlink}"
rm -rf "${arbitrary_resume_dir}"

grep -Fq '/mnt/data/.simple/bootstrap/*' \
  "${repo_root}/scripts/bootstrap/resume-stage3-from-admitted.sh" ||
  fail "canonical external bootstrap root is not allowlisted"
if [ -d /mnt/data/.simple/bootstrap ] &&
   [ ! -L /mnt/data/.simple/bootstrap ] &&
   [ -w /mnt/data/.simple/bootstrap ]; then
  external_resume_dir=$(mktemp -d \
    /mnt/data/.simple/bootstrap/resume-path-contract.XXXXXX)
  assert_resume_path_reaches_evidence_gate external_absolute \
    "${external_resume_dir}"
fi

echo "bootstrap_stop_after_stage2_contract=true"
