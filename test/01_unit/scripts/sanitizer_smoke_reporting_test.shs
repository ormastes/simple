#!/bin/sh
# Harness-policy regression with a controlled compiler, not sanitizer evidence.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd -P)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM
mkdir -p "$work/scripts/check/cert" "$work/src/runtime/a" "$work/src/runtime/b"
cp "$root/scripts/check/cert/sanitizer-matrix.shs" "$work/scripts/check/cert/"
printf 'int a;\n' >"$work/src/runtime/a/same.c"
printf 'int b;\n' >"$work/src/runtime/b/same.c"
printf 'parent_type value;\n' >"$work/src/runtime/owner.inc.c"
cat >"$work/cc" <<'EOF'
#!/bin/sh
set -eu
compile=0; source=; output=
while [ "$#" -gt 0 ]; do
    case "$1" in
        -c) compile=1 ;;
        -o) shift; output=$1 ;;
        *.c) source=$1 ;;
    esac
    shift
done
if [ "$compile" -eq 0 ]; then
    if [ "${TEST_HARNESS_FAIL:-0}" -eq 1 ]; then
        echo 'controlled harness compiler failure' >&2; exit 23
    fi
    printf '#!/bin/sh\nexit 0\n' >"$output"
    chmod +x "$output"
else
    case "$source" in
        */failure.c) echo 'controlled unexpected TU error' >&2; exit 24 ;;
        *.inc.c) echo 'fragment incorrectly compiled' >&2; exit 25 ;;
    esac
    echo "compiled $source" >&2
    : >"$output"
fi
EOF
chmod +x "$work/cc"
run_matrix() {
    RT_CC="$work/cc" sh "$work/scripts/check/cert/sanitizer-matrix.shs" --san=address --target=runtime --smoke
}
run_matrix >"$work/clean.log" 2>&1
grep -q 'allocation-harness.*PASS.*no project runtime objects linked' "$work/clean.log"
grep -q 'runtime-objects.*PASS.*2 TU(s).*NOT linked or executed' "$work/clean.log"
grep -q 'runtime-objects.*SKIP' "$work/clean.log"
grep -q 'owner.inc.c.*include fragment' "$work/build/runtime-san-asan/exclusions.tsv"
test -f "$work/build/runtime-san-asan/logs/a/same.c.log"
test -f "$work/build/runtime-san-asan/logs/b/same.c.log"
printf 'invalid C\n' >"$work/src/runtime/failure.c"
if run_matrix >"$work/failure.log" 2>&1; then
    echo 'FAIL: unexpected TU compiler failure returned success' >&2; exit 1
fi
grep -q 'runtime-objects.*FAIL.*failure.c' "$work/failure.log"
grep -q 'controlled unexpected TU error' "$work/build/runtime-san-asan/logs/failure.c.log"
if grep -q 'runtime-objects.*PASS' "$work/failure.log"; then
    echo 'FAIL: failed compilation produced project PASS row' >&2; exit 1
fi
if TEST_HARNESS_FAIL=1 run_matrix >"$work/harness-failure.log" 2>&1; then
    echo 'FAIL: harness compiler failure returned success' >&2; exit 1
fi
grep -q 'allocation-harness.*FAIL' "$work/harness-failure.log"
echo 'PASS: controlled compiler failures fail closed; logs, exclusions and execution scope are explicit'
