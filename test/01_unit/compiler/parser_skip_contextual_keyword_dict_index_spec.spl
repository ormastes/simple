# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-COMPILER
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# `skip` as a dict name: `skip[k] = v` is an index store, not a skip statement

**Category:** Language / Lexer
**Status:** Regression guard

## Purpose and Audience

`skip` is a contextual keyword. The lexer special-cased only a following `(` —
so `skip("reason")` calls worked — but `skip[` still emitted the `Skip` keyword
token. At statement level `parse_skip` consumed the bare `skip` and left
`["a"] = 1` to parse as the NEXT statement: an assignment whose target is an
array literal. MIR then rejected it as `complex lvalue: Array([...])`, blaming
the backend for a lexer defect. This broke
`src/lib/nogc_sync_mut/test_runner/test_db_core.spl` (`var skip: Dict<i64,i64>`
of timing-run bookkeeping) and was Blocker B1 of the full-CLI self-hosted build.

Audience: anyone touching contextual-keyword lexing in
`src/compiler_rust/parser/src/lexer/identifiers.rs`.

## Scope and Preconditions

Requires a seed built at or after 2026-08-27; an older binary fails the first
scenario at compile time (`complex lvalue: Array` or a parse error). The
neighbor scenarios prove the keyword meanings survive: a bare `skip` statement
and `skip:` block still parse, and `skip("reason")` still calls.

## Primary Workflow

Declare a dict named `skip`, write through and read back bracket stores with
text and integer keys.

See doc/08_tracking/bug/full_cli_selfhosted_native_build_blockers_2026-08-27.md
"""

use std.spec.*

describe "skip as an ordinary dict name":
    # @manual scenario evidence
    # @capture(text)

    it "stores and reads a text-keyed dict named skip":
        # @req REQ-SSPEC-COMPILER
        # @capture(text)
        step("Write skip[\"a\"] then read it back")
        var skip: Dict<text, i64> = {}
        skip["a"] = 1
        skip["b"] = skip["a"] + 41
        expect(skip["a"]).to_equal(1)
        expect(skip["b"]).to_equal(42)

    it "stores and reads an integer-keyed dict named skip":
        # @req REQ-SSPEC-COMPILER
        # @capture(text)
        step("Write skip[tid] for integer tid, mirroring test_db_core")
        var skip: Dict<i64, i64> = {}
        val tid = 7
        skip[tid] = 5
        skip[tid] = skip[tid] + 1
        expect(skip[tid]).to_equal(6)

    it "keeps the bare skip statement working":
        # @req REQ-SSPEC-COMPILER
        # @capture(text)
        step("Run a bare skip statement inside a branch")
        fn _pick(flag: bool) -> i64:
            if flag:
                skip
            3
        expect(_pick(true)).to_equal(3)
        expect(_pick(false)).to_equal(3)
