"""Bootstrap grammar control for legacy versus current package-route hints.
These cases isolate expression construction; they do not qualify the full cache route.
"""
use std.spec.*
use std.spec.step

fn native_route_hint_control_v1(version: i64, selected: [text], changed: [text]) -> [text]:
    val fallback = if version < 4: selected else: changed
    fallback

describe "Native route conditional expression construction":
    it "selects the complete legacy migration set":
        step("Select a legacy-schema hint with a distinct supplied change")
        val result = native_route_hint_control_v1(3, ["legacy"], ["private"])
        expect(result.len()).to_equal(1)
        expect(result[0]).to_equal("legacy")

    it "retains the current-schema change hint":
        step("Select a current-schema hint without widening it to all modules")
        val result = native_route_hint_control_v1(4, ["legacy"], ["private"])
        expect(result.len()).to_equal(1)
        expect(result[0]).to_equal("private")

    it "retains all supplied future-schema changes":
        step("Inspect both supplied changes beyond the current version boundary")
        val result = native_route_hint_control_v1(5, ["legacy"], ["private-a", "private-b"])
        expect(result.len()).to_equal(2)
        expect(result[0]).to_equal("private-a")
        expect(result[1]).to_equal("private-b")

    it "preserves an empty current-schema hint":
        step("Keep the empty change set instead of manufacturing dirty modules")
        val result = native_route_hint_control_v1(4, ["legacy"], [])
        expect(result.len()).to_equal(0)
