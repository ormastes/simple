use std.spec.{describe, it, expect}
use std.io_runtime.{read_file}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.common.config.{Logger}

const FRONTEND_SOURCE = "src/compiler/10.frontend/frontend.spl"
const ASSEMBLY_SOURCE = "src/compiler/10.frontend/_FlatAstBridge/module_assembly.spl"

describe "frontend cache-boundary profile contract":
    it "is explicitly opt-in and emits fielded frontend boundaries":
        val source = read_file(FRONTEND_SOURCE)
        expect(source.contains("SIMPLE_FRONTEND_CACHE_BOUNDARY_PROFILE")).to_equal(true)
        expect(source.contains("if frontend_cache_boundary_profile_enabled():")).to_equal(true)
        expect(source.contains("PARSECACHE")).to_equal(true)
        expect(source.contains("load_ms=")).to_equal(true)
        expect(source.contains("store_ms=")).to_equal(true)
        expect(source.contains("desugar_ms=")).to_equal(true)
        expect(source.contains("bytes=")).to_equal(true)
        expect(source.contains("path=")).to_equal(true)

    it "times the flat-pool dump under the same opt-in guard":
        val source = read_file(ASSEMBLY_SOURCE)
        expect(source.contains("SIMPLE_FRONTEND_CACHE_BOUNDARY_PROFILE")).to_equal(true)
        expect(source.contains("if fab_cache_boundary_prof_enabled():")).to_equal(true)
        expect(source.contains("PARSECACHE")).to_equal(true)
        expect(source.contains("dump_ms=")).to_equal(true)
        expect(source.contains("bytes=")).to_equal(true)
        expect(source.contains("path=")).to_equal(true)

    it "keeps the default frontend invocation quiet and functional":
        val module = parse_full_frontend(
            "class CacheBoundaryProfileProbe:\n    val value: i64",
            "cache_boundary_profile_probe.spl",
            "cache_boundary_profile_probe",
            Logger(level: 0))
        expect(module.classes.contains("CacheBoundaryProfileProbe")).to_equal(true)
