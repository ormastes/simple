# @req: REQ-COMPILER-FRONTEND-001
use std.spec
use std.io_runtime.{env_get}
use std.nogc_sync_mut.io.file_ops.{file_exists}
use std.nogc_sync_mut.io.process_ops.{process_run_timeout}

describe "flat pool fatal append diagnostics":
    it "identifies the rejected text position without accepting invalid data":
        step("Execute the source-matched native rejected-text fixture")
        val fixture = env_get("SIMPLE_FLAT_POOL_APPEND_FIXTURE") ?? ""
        expect(fixture != "").to_equal(true)
        expect(file_exists(fixture)).to_equal(true)
        val (out, err, code) = process_run_timeout(fixture, [], 30000)
        expect(code != 0).to_equal(true)
        expect(err).to_contain("flat pool encoder string builder append failed site=text.value item=1 input_length=-1 result=0")
        expect(out.contains("unexpected-append-success")).to_equal(false)
