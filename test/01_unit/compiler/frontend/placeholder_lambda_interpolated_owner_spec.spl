use std.nogc_sync_mut.io.file_ops.{file_read}
use compiler.core.ast.{ast_reset}
use compiler.core.ast_expr.{
    EXPR_IDENT, EXPR_LAMBDA, EXPR_INTERPOLATED_STRING,
    expr_ident, expr_tag, expr_s_val, expr_args, expr_stmts
}
use compiler.frontend.core._AstExpr.accessors.{expr_interpolated_string}
use compiler.frontend.desugar.placeholder_lambda.{transform_placeholder_lambda}

fn assert_rebuilt_interpolation(result: i64, nested: bool):
    expect(expr_tag[result]).to_equal(EXPR_LAMBDA)
    val body = expr_stmts[result][0]
    expect(expr_tag[body]).to_equal(EXPR_INTERPOLATED_STRING)
    var rebuilt = body
    if nested:
        rebuilt = expr_args[body][0]
        expect(expr_tag[rebuilt]).to_equal(EXPR_INTERPOLATED_STRING)
    val parts = expr_args[rebuilt]
    expect(parts.len()).to_be_greater_than(0)
    expect(expr_tag[parts[0]]).to_equal(EXPR_IDENT)
    expect(expr_s_val[parts[0]]).to_equal("__p0")

describe "placeholder lambda interpolated expression owner":
    it "binds the interpolated constructor from its concrete owner":
        val source = file_read("src/compiler/10.frontend/desugar/placeholder_lambda.spl")
        expect(source).to_contain("use compiler.frontend.core._AstExpr.accessors.{expr_interpolated_string}")
        expect(source.count("return expr_interpolated_string(new_parts, 0)")).to_equal(2)

    it "rebuilds repeated interpolated placeholders with one slot":
        ast_reset()
        val input = expr_interpolated_string([expr_ident("_1", 0), expr_ident("_1", 0)], 0)
        val result = transform_placeholder_lambda(input)
        assert_rebuilt_interpolation(result, false)
        val body = expr_stmts[result][0]
        expect(expr_s_val[expr_args[body][1]]).to_equal("__p0")

    it "rebuilds nested interpolation through the fixed-slot path":
        ast_reset()
        val inner = expr_interpolated_string([expr_ident("_1", 0)], 0)
        val outer = expr_interpolated_string([inner], 0)
        assert_rebuilt_interpolation(transform_placeholder_lambda(outer), true)

    it "leaves interpolation without placeholders unchanged":
        ast_reset()
        val input = expr_interpolated_string([expr_ident("value", 0)], 0)
        expect(transform_placeholder_lambda(input)).to_equal(input)
