use std.spec.*
use std.io.{file_read_text as file_read}

# Bug phase2_octal_permission_mode_lowering_2026_10_27: the native compiler
# lowered `int(oc)` over a 1-char slice of the octal digit run through
# rt_string_to_int_any (strtoll on rt_interp_cstr). A slice view is not
# NUL-terminated at the slice end, so `int("600"[0:1])` read "600", making
# 0o600 evaluate to 600*64 (mode bits 0 -> read-only files). The octal
# branch must map digits explicitly like the hex and binary branches.
describe "octal literal digit parse native guard":
    it "does not route octal digits through int() on a slice":
        val src = file_read("src/compiler/10.frontend/core/_ParserPrimary/primary_expr.spl")
        expect(src).to_contain("val oct_table = \"01234567\"")
        expect(src.contains("oct_val * 8 + int(oc)")).to_equal(false)
