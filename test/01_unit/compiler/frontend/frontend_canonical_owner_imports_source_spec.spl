"""Regression guard for Stage-3 frontend terminal-owner imports."""

use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text

fn owner_source(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "frontend consumers import retained canonical owners":
    it "imports Token directly in all tree-sitter consumers":
        for path in [
            "src/compiler/10.frontend/treesitter/outline_lexer.spl",
            "src/compiler/10.frontend/treesitter/outline_decls.spl",
            "src/compiler/10.frontend/treesitter/outline_types.spl",
            "src/compiler/10.frontend/treesitter/heuristic.spl",
        ]:
            expect(owner_source(path)).to_contain(
                r"use compiler.frontend.lexer_types.{Token")

    it "imports expression constructors from their arena owner":
        for path in [
            "src/compiler/10.frontend/core/_ParserPrimary/primary_expr.spl",
            "src/compiler/10.frontend/core/_ParserDecls/enum_module_body.spl",
            "src/compiler/10.frontend/core/_ParserDecls/fn_struct_decls.spl",
        ]:
            val source = owner_source(path)
            expect(source).to_contain(
                r"use compiler.frontend.core._AstExpr.nodes.{expr_ident, expr_string_lit}")
            expect(source.contains(
                r"compiler.core.ast.{expr_ident")).to_equal(false)

    it "imports module mutation from the module-state owner":
        val source = owner_source(
            "src/compiler/10.frontend/core/_ParserDecls/enum_module_body.spl")
        expect(source).to_contain(
            r"use compiler.frontend.core._Ast.module_state.{module_add_decl}")
        expect(source.contains(
            r"compiler.core.ast.{module_set_path, module_add_decl}")).to_equal(false)

    it "imports raw arena and accessor helpers from their split owners":
        expect(owner_source(
            "src/compiler/10.frontend/desugar/collection_desugar.spl"))\
            .to_contain(r"use compiler.frontend.core._AstExpr.nodes.{")
        expect(owner_source(
            "src/compiler/20.hir/hir_lowering/_Items/module_declarations_bootstrap.spl"))\
            .to_contain(r"use compiler.frontend.core._AstExpr.accessors.{expr_get_tag")

    it "imports expr_kind from parser-types expression owner":
        expect(owner_source(
            "src/compiler/10.frontend/desugar/suspension_analysis.spl"))\
            .to_contain(r"use compiler.frontend.parser_types_expr.{expr_kind}")
