use std.spec
use std.io_runtime.{read_file_text}

fn source_has_numeric_bootstrap_operands(path: text) -> bool:
    val source = read_file_text(path)
    source.contains("\"li t1, \{0\}\"") and
        source.contains("\"li t0, \{1\}\"") and
        source.contains("\"li t0, \{2\}\"") and
        source.contains("\"call \{3\}\"") and
        not source.contains("Identifier(\"stack_size\")") and
        not source.contains("\{stack_size\}")

describe "RISC-V bootstrap inline asm operand contract":
    it "binds the exact RV64 stack-size failure through operand zero":
        expect(source_has_numeric_bootstrap_operands(
            "src/lib/nogc_async_mut_noalloc/baremetal/riscv/startup.spl"
        )).to_equal(true)

    it "keeps the adjacent RV32 immediate and identifier route equivalent":
        expect(source_has_numeric_bootstrap_operands(
            "src/lib/nogc_async_mut_noalloc/baremetal/riscv32/startup.spl"
        )).to_equal(true)
