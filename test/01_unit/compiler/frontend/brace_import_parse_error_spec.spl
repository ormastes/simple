# @cover src/compiler/10.frontend/core/parser.spl
# Regression: a leading brace import (`use foo.{X}`) must not swallow later
# syntax errors reported through parse_module_silent_checked.
# NOTE for authors: `{X}` inside a double-quoted literal is string
# interpolation, so the import line is written as a raw '...' literal.
use std.spec
use compiler.core.parser.{parse_module_silent_checked}

describe "brace import does not hide later parse errors":
    it "reports an error after a single-name brace import":
        val src = 'use foo.{X}' + "\nfn f( -> :\n"
        expect(parse_module_silent_checked(src, "brace_err.spl")).to_equal(true)

    it "reports an error after a multi-name brace import":
        val src = 'use foo.{X, Y}' + "\nval = = 3\n"
        expect(parse_module_silent_checked(src, "brace_err2.spl")).to_equal(true)

    it "reports an error after a plain import (control)":
        expect(parse_module_silent_checked("use foo.X\nfn f( -> :\n", "plain_err.spl")).to_equal(true)

    it "accepts a valid module with a brace import":
        val src = 'use foo.{X}' + "\nfn f() -> i64:\n    1\n"
        expect(parse_module_silent_checked(src, "brace_ok.spl")).to_equal(false)

    it "reports an error with no import (control)":
        expect(parse_module_silent_checked("fn f( -> :\n", "noimp_err.spl")).to_equal(true)
