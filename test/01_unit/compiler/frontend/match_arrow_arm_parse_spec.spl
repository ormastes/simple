# @cover src/compiler/10.frontend/core/parser.spl
# Regression: readme_arrow_match_arm_syntax_does_not_parse_2026-09-19.
# The documented `| Pattern -> expr` match arm form must parse. The `|` and `->`
# are written inside raw '...' literals so no interpolation applies.
use std.spec
use compiler.core.parser.{parse_module_silent_checked}

describe "arrow match arms parse":
    it "parses literal arms with a wildcard":
        val src = 'fn f(v: i64) -> text:' + "\n    match v:\n        | 0 -> \"zero\"\n        | 1 -> \"one\"\n        | _ -> \"other\"\n"
        expect(parse_module_silent_checked(src, "arrow_lit.spl")).to_equal(false)

    it "parses arms with guards":
        val src = 'fn f(v: i64) -> text:' + "\n    match v:\n        | n if n < 0 -> \"neg\"\n        | 0 -> \"zero\"\n        | n if n > 0 -> \"pos\"\n"
        expect(parse_module_silent_checked(src, "arrow_guard.spl")).to_equal(false)

    it "parses enum payload arms with multiple bindings":
        val src = 'enum Shape:' + "\n    Circle(f64)\n    Rectangle(f64, f64)\n" + 'fn p(s: Shape) -> f64:' + "\n    match s:\n        | Circle(r) -> 2.0 * 3.14159 * r\n        | Rectangle(w, h) -> 2.0 * (w + h)\n"
        expect(parse_module_silent_checked(src, "arrow_enum.spl")).to_equal(false)

    it "parses the case form (control)":
        val src = 'fn f(v: i64) -> text:' + "\n    match v:\n        case 0: \"zero\"\n        case _: \"other\"\n"
        expect(parse_module_silent_checked(src, "case_ok.spl")).to_equal(false)

    it "still reports a real syntax error (negative control)":
        val src = 'fn f(v: i64) -> text:' + "\n    match v:\n        | 0 -> \n        | = = 3\n"
        expect(parse_module_silent_checked(src, "arrow_bad.spl")).to_equal(true)
