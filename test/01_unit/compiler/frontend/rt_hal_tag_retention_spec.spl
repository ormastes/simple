"""The canonical flat parser retains @rt(hal) as typed function metadata."""

use std.spec
use compiler.common.attributes.{parse_function_attrs}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.mir.mir.*
use compiler.mir.mir_lowering_types.{MirLowering}
use compiler.mir._MirLowering.module_lowering.*
use compiler.common.driver_core_types.{driver_core_compile_options_default}
use compiler.driver.driver_mir_target.{driver_mir_target_context}
use compiler.semantics.rt_hal_tag.{validate_rt_hal_tags}

fn rt_hal_lowered_calls(source: text) -> [text]:
    val parsed = parse_and_build_module(source, "rt_hal_boundary_lowering.spl")
    var hir_lowering = HirLowering.with_filename("rt_hal_boundary_lowering.spl")
    val hir = hir_lowering.lower_module(parsed)
    var mir_lowering = MirLowering.new_for_target(hir.symbols, driver_mir_target_context(driver_core_compile_options_default()))
    val mir = mir_lowering.lower_module(hir)
    var calls: [text] = []
    for function in mir.functions.values():
        for block in function.blocks:
            for instruction in block.instructions:
                match instruction.kind:
                    case MirInstKind.Call(_, callee, _):
                        match callee.kind:
                            case MirOperandKind.Const(MirConstValue.Str(name), _): calls.push(name)
                            case _: pass
                    case _: pass
    calls

fn rt_hal_semantic_errors(source: text, plan_path: text = "") -> [text]:
    val parsed = parse_and_build_module(source, "rt_hal_signature.spl")
    var lowering = HirLowering.with_filename("rt_hal_signature.spl")
    val hir = lowering.lower_module(parsed)
    validate_rt_hal_tags({"rt_hal_signature": hir}, plan_path)

describe "rt(hal) frontend metadata":
    it "defaults to Pure Simple without comparator flags":
        val module = parse_and_build_module(
            "@rt(hal)\nfn clock_read() -> i64:\n    0\n",
            "rt_hal_pure_only.spl"
        )
        val metadata = parse_function_attrs(module.functions["clock_read"].attributes)
        expect(metadata.is_rt_hal).to_equal(true)
        expect(metadata.rt_hal_compare_c).to_equal(false)
        expect(metadata.rt_hal_compare_rust).to_equal(false)
        expect(metadata.rt_hal_error).to_equal("")
        var has_boundary_import = false
        for import_ in module.imports:
            if import_.module == "std.nogc_sync_mut.rt_hal.boundary":
                has_boundary_import = true
        expect(has_boundary_import).to_equal(false)
        val calls = rt_hal_lowered_calls(
            "@rt(hal)\nfn clock_read() -> i64:\n    0\n"
        )
        expect(calls.contains("rt_hal_boundary_dispatch")).to_equal(false)

    it "retains explicitly requested comparison providers":
        val module = parse_and_build_module(
            "@rt(hal, c, rust)\nfn clock_read() -> i64:\n    0\n",
            "rt_hal_comparators.spl"
        )
        val metadata = parse_function_attrs(module.functions["clock_read"].attributes)
        expect(metadata.is_rt_hal).to_equal(true)
        expect(metadata.rt_hal_compare_c).to_equal(true)
        expect(metadata.rt_hal_compare_rust).to_equal(true)
        var has_boundary_import = false
        var has_process_import = false
        var has_env_import = false
        for import_ in module.imports:
            if import_.module == "std.nogc_sync_mut.rt_hal.boundary":
                has_boundary_import = true
            elif import_.module == "std.nogc_sync_mut.rt_hal.process_task_arena":
                has_process_import = true
            elif import_.module == "app.io.env_access_host":
                has_env_import = true
        expect(has_boundary_import).to_equal(true)
        expect(has_process_import).to_equal(true)
        expect(has_env_import).to_equal(true)

    it "retains invalid provider evidence for semantic rejection":
        val module = parse_and_build_module(
            "@rt(hal, python)\nfn clock_read() -> i64:\n    0\n",
            "rt_hal_invalid_provider.spl"
        )
        val metadata = parse_function_attrs(module.functions["clock_read"].attributes)
        expect(metadata.rt_hal_error).to_contain("E-RT-HAL-PROVIDER")

    it "lowers only an RT-safe receipt enqueue at each normal exit":
        val calls = rt_hal_lowered_calls(
            "@rt(hal, c)\nfn clock_read() -> i64:\n    0\n"
        )
        expect(calls).to_contain("rt_hal_boundary_dispatch")
        expect(calls.contains("rt_hal_boundary_register_compiled")).to_equal(false)

    it "adds no boundary dispatch to an untagged function":
        val calls = rt_hal_lowered_calls("fn clock_read() -> i64:\n    0\n")
        expect(calls.contains("rt_hal_boundary_dispatch")).to_equal(false)
        expect(calls.contains("rt_hal_boundary_register_compiled")).to_equal(false)
        val module = parse_and_build_module(
            "fn clock_read() -> i64:\n    0\n", "rt_hal_untagged.spl"
        )
        var has_boundary_import = false
        for import_ in module.imports:
            if import_.module == "std.nogc_sync_mut.rt_hal.boundary":
                has_boundary_import = true
        expect(has_boundary_import).to_equal(false)

    it "accepts typed arguments the dual-run vector can transport (i64/u8/f64/bool/text/[u8])":
        # design B.4: arguments are transported by value in-process (DualArgs)
        val errors = rt_hal_semantic_errors(
            "@rt(hal, c)\nfn clock_read(port: i64, lane: u8, scale: f64, on: bool, name: text, buf: [u8]) -> i64:\n    port\n",
            "/rt-hal-plan.sdn"
        )
        expect(errors.join("\n")).to_equal("")

    it "fails closed when an argument cannot be transported canonically, naming the parameter":
        val errors = rt_hal_semantic_errors(
            "@rt(hal, c)\nfn clock_read(ports: Dict<text, i64>) -> i64:\n    0\n",
            "/rt-hal-plan.sdn"
        )
        expect(errors.join("\n")).to_contain("E-RT-HAL-SIGNATURE")
        expect(errors.join("\n")).to_contain("parameter `ports`")

    it "fails closed on a non-u8 buffer argument":
        val errors = rt_hal_semantic_errors(
            "@rt(hal, c)\nfn sum(xs: [i64]) -> i64:\n    0\n",
            "/rt-hal-plan.sdn"
        )
        expect(errors.join("\n")).to_contain("not u8")

    it "fails closed when a return cannot be transported as an i64 receipt":
        val errors = rt_hal_semantic_errors(
            "@rt(hal, rust)\nfn clock_read() -> text:\n    \"ready\"\n",
            "/rt-hal-plan.sdn"
        )
        expect(errors.join("\n")).to_contain("E-RT-HAL-SIGNATURE")

    it "accepts an ordinary Pure-only ABI without comparator transport":
        val errors = rt_hal_semantic_errors(
            "@rt(hal)\nfn describe(port: i64) -> text:\n    port.to_text()\n"
        )
        expect(errors.len()).to_equal(0)
