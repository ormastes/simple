# Stage4 regression: a recovered top-level docstring must never become the
# synthetic script main that HIR lowers as executable source.
# @cover src/compiler/10.frontend/_FlatAstBridge/module_assembly.spl

use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use std.spec

describe "module docstring synthetic-main guard":
    it "keeps a top-level triple docstring out of script lowering":
        val source = "\"\"\"I/O documentation with source: nil\"\"\"\n"
        val module = parse_and_build_module(source, "module_docstring_guard.spl")
        expect(module.functions.contains("main")).to_equal(false)
        expect(module.constants.len()).to_equal(0)
