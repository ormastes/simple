use std.spec.{describe, it, expect}
use compiler.frontend.core._Ast.decl_nodes.{decl_store_state_take, decl_store_state_install}

describe "DeclStoreState ParseContext snapshot (stage 1)":
    it "take leaves fresh stores and install restores the snapshot":
        val a = decl_store_state_take()
        val fresh = decl_store_state_take()
        expect(fresh.decl_tag.len()).to_equal(0)
        decl_store_state_install(a)
        val again = decl_store_state_take()
        expect(again.decl_tag.len()).to_equal(a.decl_tag.len())
        decl_store_state_install(again)
