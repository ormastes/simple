use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io_runtime.{env_get, env_set}
use compiler.frontend.parse_env_state.{parse_env_state_take, parse_env_state_install}

describe "ParseEnvState (stage 1)":
    it "take clears the env parse channels and install restores them":
        env_set("SIMPLE_PARSER_HAD_ERROR", "1")
        env_set("SIMPLE_BOOTSTRAP_PAR_LINE", "42")
        val a = parse_env_state_take()
        expect(env_get("SIMPLE_PARSER_HAD_ERROR")).to_equal("")
        expect(env_get("SIMPLE_BOOTSTRAP_PAR_LINE")).to_equal("")

        env_set("SIMPLE_BOOTSTRAP_PAR_LINE", "7")
        val b = parse_env_state_take()

        parse_env_state_install(a)
        expect(env_get("SIMPLE_PARSER_HAD_ERROR")).to_equal("1")
        expect(env_get("SIMPLE_BOOTSTRAP_PAR_LINE")).to_equal("42")
        parse_env_state_install(b)
        expect(env_get("SIMPLE_BOOTSTRAP_PAR_LINE")).to_equal("7")
        env_set("SIMPLE_BOOTSTRAP_PAR_LINE", "")
