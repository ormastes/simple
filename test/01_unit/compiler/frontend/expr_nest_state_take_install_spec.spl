use std.spec.{describe, it, expect}
use compiler.frontend.core.parser_expr.{expr_nest_state_take, expr_nest_state_install}

describe "ExprNestState ParseContext snapshot":
    it "take installs fresh state and install restores the snapshot":
        val a = expr_nest_state_take()
        val fresh = expr_nest_state_take()
        expect(fresh.g_expr_nest_depth).to_equal(0)
        expr_nest_state_install(a)
        val again = expr_nest_state_take()
        expect(again.g_expr_nest_depth).to_equal(a.g_expr_nest_depth)
        expr_nest_state_install(again)
