use std.spec.{describe, it, expect}
use compiler.core.types.{reset_all_pools, dict_type_register, dict_type_get_key, dict_type_get_value}
use compiler.core.types.{flat_pool_state_take, flat_pool_state_install}

describe "flat-pool ParseContext snapshot (stage 1)":
    it "take empties the active pools and install restores the snapshot":
        reset_all_pools()
        val a_tag = dict_type_register(1, 2)
        val a = flat_pool_state_take()
        expect(a.dict_type_keys.len()).to_equal(1)

        # Second context starts empty and does not see context A.
        val b_tag = dict_type_register(3, 4)
        expect(b_tag).to_equal(a_tag)
        expect(dict_type_get_key(b_tag)).to_equal(3)
        val b = flat_pool_state_take()

        flat_pool_state_install(a)
        expect(dict_type_get_key(a_tag)).to_equal(1)
        expect(dict_type_get_value(a_tag)).to_equal(2)

        flat_pool_state_install(b)
        expect(dict_type_get_value(b_tag)).to_equal(4)
        reset_all_pools()
