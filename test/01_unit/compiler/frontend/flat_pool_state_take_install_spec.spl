use std.spec.{describe, it, expect}
use compiler.core.types.{reset_all_pools, dict_type_register, dict_type_get_key, dict_type_get_value, dict_tag_to_id}
use compiler.core.types.{flat_pool_state_take, flat_pool_state_install}

describe "flat-pool ParseContext snapshot (stage 1)":
    it "take empties the active pools and install restores the snapshot":
        reset_all_pools()
        val a_tag = dict_type_register(1, 2)
        val a = flat_pool_state_take()
        expect(a.dict_type_keys.len()).to_equal(1)

        # The second context starts empty: A's entry is not visible in it.
        val b_tag = dict_type_register(3, 4)
        expect(dict_type_get_key(dict_tag_to_id(b_tag))).to_equal(3)
        val b = flat_pool_state_take()
        expect(b.dict_type_keys.len()).to_equal(1)
        expect(b.dict_type_keys[0]).to_equal(3)

        flat_pool_state_install(a)
        expect(dict_type_get_key(dict_tag_to_id(a_tag))).to_equal(1)
        expect(dict_type_get_value(dict_tag_to_id(a_tag))).to_equal(2)

        flat_pool_state_install(b)
        expect(dict_type_get_value(dict_tag_to_id(b_tag))).to_equal(4)
        reset_all_pools()
