# Publishes its own fresh private frontend cache scope/root. Under `test`
# (interpret mode) the driver never publishes SIMPLE_FRONTEND_CACHE_SCOPE
# (driver_source_pipeline_parsing.spl), so relying on an inherited scope left
# the cache OFF and every cache-dependent example failing when none was set.
use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.{parse_full_frontend, parse_full_frontend_target_receipted_v1}
use compiler.frontend.frontend_parse_cache.{frontend_parse_cache_enabled, frontend_parse_cache_load, frontend_parse_cache_hits, frontend_parse_cache_misses}
use std.common.crypto.sha256.sha256_text
use std.common.crypto.xxh3.{xxh3_128_hex}
use std.common.text_bytes.{text_to_utf8_bytes}
use std.nogc_sync_mut.sffi.runtime.{xxh3_128_text, xxh3_128_text_fallback_used}
use std.io_runtime.file_exists
use std.io_runtime.file_write_exact
use std.io_runtime.{env_set, getpid}
use compiler.frontend.frontend_parse_cache.{frontend_parse_cache_scope, frontend_parse_cache_dir, frontend_parse_cache_entry_encode}
use compiler.frontend.core.flat_pool_codec.FLAT_POOL_CODEC_VERSION

val supplied_key_path = "test/fixtures/compiler/frontend/supplied_source_key.spl"

# Idempotent; must run before the first frontend_parse_cache_scope() call.
# Only a non-empty scope is memoized, so publishing it first is sufficient.
fn use_fresh_private_parse_cache():
    val run = "supplied-source-cache-key-{getpid()}"
    val _on = env_set("SIMPLE_FRONTEND_CACHE", "1")
    val _scope = env_set("SIMPLE_FRONTEND_CACHE_SCOPE", run)
    val _dir = env_set("SIMPLE_FRONTEND_CACHE_DIR", "build/test_supplied_source_cache_key/" + run)

describe "supplied source owns private parse cache identity":
    it "rejects a real legacy entry and accepts the same pool under the corrected version":
        use_fresh_private_parse_cache()
        expect(frontend_parse_cache_enabled()).to_equal(true)
        val source = "fn migration_member() -> i64:\n    77\n"
        val parsed = parse_full_frontend(source, supplied_key_path, "migration", Logger(level: 0))
        expect(parsed.functions.contains_key("migration_member")).to_equal(true)
        val key = xxh3_128_hex(text_to_utf8_bytes(source))
        val ident = sha256_text(source)
        val blob = frontend_parse_cache_load(key, ident)
        expect(blob.len() > 0).to_equal(true)
        val path = frontend_parse_cache_dir() + "/" + key + ".fpc"
        val suffix = " " + FLAT_POOL_CODEC_VERSION + " " + frontend_parse_cache_scope()
        # v1/v2 entries carried no checksum line: both are legacy and rejected.
        expect(file_write_exact(path, "spl-fecache-v1" + suffix + "\n" + blob)).to_equal(true)
        expect(frontend_parse_cache_load(key, ident)).to_equal("")
        expect(file_write_exact(path, "spl-fecache-v2" + suffix + "\n" + blob)).to_equal(true)
        expect(frontend_parse_cache_load(key, ident)).to_equal("")
        # A current entry whose body was altered after the checksum was taken
        # is rejected too (task 8a: payload checksum, IR-05 admission).
        val current = frontend_parse_cache_entry_encode("spl-fecache-v3" + suffix, blob, ident)
        expect(file_write_exact(path, current + "x")).to_equal(true)
        expect(frontend_parse_cache_load(key, ident)).to_equal("")
        expect(file_write_exact(path, current)).to_equal(true)
        expect(frontend_parse_cache_load(key, ident)).to_equal(blob)

    it "stores changed supplied bytes under their own keys while disk and mtime stay unchanged":
        use_fresh_private_parse_cache()
        expect(file_exists(supplied_key_path)).to_equal(true)
        expect(frontend_parse_cache_enabled()).to_equal(true)
        val first = "fn supplied_first() -> i64:\n    11\n"
        val second = "fn supplied_second() -> i64:\n    22\n"
        val a = parse_full_frontend(first, supplied_key_path, "supplied", Logger(level: 0))
        expect(a.functions.contains_key("supplied_first")).to_equal(true)
        expect(frontend_parse_cache_load(xxh3_128_hex(text_to_utf8_bytes(first)), sha256_text(first)).len() > 0).to_equal(true)
        val b = parse_full_frontend(second, supplied_key_path, "supplied", Logger(level: 0))
        expect(b.functions.contains_key("supplied_second")).to_equal(true)
        expect(b.functions.contains_key("supplied_first")).to_equal(false)
        expect(frontend_parse_cache_load(xxh3_128_hex(text_to_utf8_bytes(second)), sha256_text(second)).len() > 0).to_equal(true)

    it "restores equal source through the existing bridge for an alias":
        use_fresh_private_parse_cache()
        val source = "fn alias_member() -> i64:\n    33\n"
        val first = parse_full_frontend(source, supplied_key_path, "original", Logger(level: 0))
        expect(first.functions.contains_key("alias_member")).to_equal(true)
        val hits = frontend_parse_cache_hits()
        val alias = parse_full_frontend(source, supplied_key_path, "alias", Logger(level: 0))
        expect(alias.functions.contains_key("alias_member")).to_equal(true)
        expect(frontend_parse_cache_hits()).to_equal(hits + 1)

    it "does not admit a missing source path into the private cache":
        use_fresh_private_parse_cache()
        val path = "test/fixtures/compiler/frontend/absent_supplied_key_control.spl"
        expect(file_exists(path)).to_equal(false)
        val hits = frontend_parse_cache_hits()
        val misses = frontend_parse_cache_misses()
        val source = "fn absent_control() -> i64:\n    44\n"
        val parsed = parse_full_frontend(source, path, "absent", Logger(level: 0))
        expect(parsed.functions.contains_key("absent_control")).to_equal(true)
        expect(frontend_parse_cache_hits()).to_equal(hits)
        expect(frontend_parse_cache_misses()).to_equal(misses)

    it "rejects a caller-supplied stale digest before cache access":
        use_fresh_private_parse_cache()
        val source = "fn current_control() -> i64:\n    55\n"
        val hits = frontend_parse_cache_hits()
        val result = parse_full_frontend_target_receipted_v1(source, supplied_key_path,
            "current", Logger(level: 0), "source:current", sha256_text("stale"),
            "x86_64-pc-windows-msvc")
        expect(result.is_err()).to_equal(true)
        expect(frontend_parse_cache_hits()).to_equal(hits)

    it "keeps different target projections separate for equal raw source":
        use_fresh_private_parse_cache()
        val source = "@cfg(windows)\nfn windows_only() -> i64:\n    66\n"
        val win = parse_full_frontend_target_receipted_v1(source, supplied_key_path,
            "target", Logger(level: 0), "source:target", sha256_text(source),
            "x86_64-pc-windows-msvc")
        expect(win.is_ok()).to_equal(true)
        expect(win.unwrap()[0].functions.contains_key("windows_only")).to_equal(true)
        val linux = parse_full_frontend_target_receipted_v1(source, supplied_key_path,
            "target", Logger(level: 0), "source:target", sha256_text(source),
            "x86_64-unknown-linux-gnu")
        expect(linux.is_ok()).to_equal(true)
        expect(linux.unwrap()[0].functions.contains_key("windows_only")).to_equal(false)

describe "private parse cache key uses the runtime XXH3-128 accelerator":
    it "hashes through the runtime and agrees with the pure-Simple reference":
        # Pure-Simple xxh3_128_hex is the oracle (official-vector KAT spec);
        # the fallback flag proves the runtime path, not the fallback, answered.
        val samples = ["", "abc", "fn a() -> i64:\n    1\n", "x".repeat(5000)]
        for s in samples:
            expect(xxh3_128_text(s)).to_equal(xxh3_128_hex(text_to_utf8_bytes(s)))
        expect(xxh3_128_text("abc")).to_equal("06b05ab6733a618578af5f94892f3950")
        expect(xxh3_128_text_fallback_used()).to_equal(false)
