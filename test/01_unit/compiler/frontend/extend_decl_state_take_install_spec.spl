use std.spec.{describe, it, expect}
use compiler.frontend.core._ParserDecls.extend_decls.{extend_decl_state_take, extend_decl_state_install}

describe "ExtendDeclState ParseContext snapshot":
    it "take installs fresh state and install restores the snapshot":
        val a = extend_decl_state_take()
        val fresh = extend_decl_state_take()
        expect(fresh.EXTEND_TARGETS.len()).to_equal(0)
        extend_decl_state_install(a)
        val again = extend_decl_state_take()
        expect(again.EXTEND_TARGETS.len()).to_equal(a.EXTEND_TARGETS.len())
        extend_decl_state_install(again)
