# Direct canonical owner regression. Runtime and docgen NOT_RUN.
use std.spec.{describe, it, expect, step}
use compiler.frontend.treesitter.outline.{TreeSitter}
use compiler.frontend.treesitter.outline_lexer.{treesitter_new}
use compiler.frontend.treesitter_types.{OutlineModule}

fn lsp_native_outline(source: text) -> OutlineModule:
    var parser = treesitter_new(source)
    parser.heuristic_mode = false
    parser.parse_outline()

describe("Canonical native outline declaration boundaries"):
    it("keeps consecutive inline declarations and exact byte ranges"):
        step("Prepare the real fixture")
        val source = "fn first(): 1\nfn second(): 2\n"
        step("Invoke the production owner")
        val outline = lsp_native_outline(source)
        step("Check the observed contract")
        expect(outline.errors.len()).to_equal(0)
        expect(outline.functions.len()).to_equal(2)
        expect(outline.functions[0].name).to_equal("first")
        expect(outline.functions[0].span.start).to_equal(0)
        expect(outline.functions[0].span.end_pos).to_equal(13)
        expect(outline.functions[0].body_span.start).to_equal(12)
        expect(outline.functions[0].body_span.end_pos).to_equal(13)
        expect(outline.functions[1].name).to_equal("second")
        expect(outline.functions[1].span.start).to_equal(14)
        expect(outline.functions[1].span.end_pos).to_equal(28)
        expect(outline.functions[1].body_span.start).to_equal(27)
        expect(outline.functions[1].body_span.end_pos).to_equal(28)
        expect(outline.friends.len()).to_equal(0)
        expect(outline.internal_exports.len()).to_equal(0)
        expect(outline.authority_spans.len()).to_equal(0)

    it("keeps inline methods and the following outer declaration"):
        val outline = lsp_native_outline("class Counter:\n    fn first(): 11\n    fn second(): 22\nfn outside(): 33\n")
        expect(outline.errors.len()).to_equal(0)
        expect(outline.classes.len()).to_equal(1)
        expect(outline.classes[0].name).to_equal("Counter")
        expect(outline.classes[0].methods.len()).to_equal(2)
        expect(outline.classes[0].methods[0].name).to_equal("first")
        expect(outline.classes[0].methods[0].span.start).to_equal(19)
        expect(outline.classes[0].methods[0].span.end_pos).to_equal(33)
        expect(outline.classes[0].methods[1].name).to_equal("second")
        expect(outline.classes[0].methods[1].span.start).to_equal(38)
        expect(outline.classes[0].methods[1].span.end_pos).to_equal(53)
        expect(outline.functions.len()).to_equal(1)
        expect(outline.functions[0].name).to_equal("outside")
        expect(outline.functions[0].span.start).to_equal(54)
        expect(outline.functions[0].span.end_pos).to_equal(70)

    it("preserves nested indented bodies and terminates at their dedent"):
        val outline = lsp_native_outline("fn first():\n    if true:\n        print 1\n    print 2\nfn second(): 3\n")
        expect(outline.errors.len()).to_equal(0)
        expect(outline.functions.len()).to_equal(2)
        expect(outline.functions[0].name).to_equal("first")
        expect(outline.functions[0].body_span.end_pos).to_be_greater_than(51)
        expect(outline.functions[0].body_span.end_pos).to_be_less_than(54)
        expect(outline.functions[1].name).to_equal("second")
        expect(outline.functions[1].span.start).to_equal(53)
        expect(outline.functions[1].span.end_pos).to_equal(67)

    it("captures inline assembly without swallowing the next function"):
        val outline = lsp_native_outline("fn first(): asm { nop }\nfn second(): 7\n")
        expect(outline.errors.len()).to_equal(0)
        expect(outline.functions.len()).to_equal(2)
        expect(outline.functions[1].name).to_equal("second")
        expect(outline.functions[1].span.start).to_equal(24)
        expect(outline.asm_blocks.len()).to_equal(1)
        expect(outline.asm_blocks[0].payload).to_equal("nop")
        expect(outline.asm_blocks[0].syntax_form).to_equal("braced")
        expect(outline.asm_blocks[0].is_legacy).to_equal(false)
        expect(outline.asm_blocks[0].span.start).to_equal(12)
        expect(outline.asm_blocks[0].span.end_pos).to_equal(23)
        expect(outline.asm_blocks[0].payload_span.start).to_equal(17)
        expect(outline.asm_blocks[0].payload_span.end_pos).to_equal(22)

    it("captures an opaque expression block without losing its parent or neighbor"):
        val outline = lsp_native_outline("fn first(): m{ 1 + 2 }\nfn second(): 7\n")
        expect(outline.errors.len()).to_equal(0)
        expect(outline.functions.len()).to_equal(2)
        expect(outline.functions[1].name).to_equal("second")
        expect(outline.functions[1].span.start).to_equal(23)
        expect(outline.inline_blocks.len()).to_equal(1)
        expect(outline.inline_blocks[0].kind).to_equal("m")
        expect(outline.inline_blocks[0].has_parent_context).to_equal(true)
        expect(outline.inline_blocks[0].parent_context).to_equal("first")
        expect(outline.inline_blocks[0].span.start).to_equal(12)
        expect(outline.inline_blocks[0].span.end_pos).to_equal(22)

    it("preserves grouped star relative aliased and lazy import values"):
        val group = lsp_native_outline("use alpha.{One, Two}")
        expect(group.errors.len()).to_equal(0)
        expect(group.imports.len()).to_equal(1)
        expect(group.imports[0].module).to_equal("alpha")
        expect(group.imports[0].items).to_equal(["One", "Two"])
        expect(group.imports[0].span.start).to_equal(0)
        expect(group.imports[0].span.end_pos).to_equal(20)
        val star = lsp_native_outline("import beta.*")
        expect(star.errors.len()).to_equal(0)
        expect(star.imports[0].module).to_equal("beta")
        expect(star.imports[0].items).to_equal(["*"])
        expect(star.imports[0].span.end_pos).to_equal(13)
        val relative = lsp_native_outline("use .gamma as local")
        expect(relative.errors.len()).to_equal(0)
        expect(relative.imports[0].module).to_equal(".gamma")
        expect(relative.imports[0].has_alias).to_equal(true)
        expect(relative.imports[0].alias).to_equal("local")
        expect(relative.imports[0].span.end_pos).to_equal(19)
        val parent = lsp_native_outline("import lazy ..delta")
        expect(parent.errors.len()).to_equal(0)
        expect(parent.imports[0].module).to_equal("..delta")
        expect(parent.imports[0].is_lazy).to_equal(true)
        expect(parent.imports[0].span.end_pos).to_equal(19)
        val qualified = lsp_native_outline("use lazy alpha.beta")
        expect(qualified.errors.len()).to_equal(0)
        expect(qualified.imports[0].module).to_equal("alpha.beta")
        expect(qualified.imports[0].is_lazy).to_equal(true)
        expect(qualified.imports[0].span.end_pos).to_equal(19)
        val missing = lsp_native_outline("import lazy")
        expect(missing.errors.len()).to_be_greater_than(0)
        expect(missing.errors[0].message).to_equal("expected identifier")
        val sibling = lsp_native_outline("use .{Thing}")
        expect(sibling.errors.len()).to_equal(0)
        expect(sibling.imports[0].module).to_equal(".")
        expect(sibling.imports[0].items).to_equal(["Thing"])
        expect(sibling.imports[0].span.end_pos).to_equal(12)

    it("consumes canonical relative-prefix tokens without accepting range assignment"):
        val parent = lsp_native_outline("use ..parent")
        expect(parent.errors.len()).to_equal(0)
        expect(parent.imports[0].module).to_equal("..parent")
        expect(parent.imports[0].span.end_pos).to_equal(12)
        val ancestor = lsp_native_outline("use ...ancestor")
        expect(ancestor.errors.len()).to_equal(0)
        expect(ancestor.imports[0].module).to_equal("...ancestor")
        expect(ancestor.imports[0].span.end_pos).to_equal(15)
        val group = lsp_native_outline("use ..{Thing}")
        expect(group.errors.len()).to_equal(0)
        expect(group.imports[0].module).to_equal("..")
        expect(group.imports[0].items).to_equal(["Thing"])
        expect(group.imports[0].span.end_pos).to_equal(13)
        val star = lsp_native_outline("import ...*")
        expect(star.errors.len()).to_equal(0)
        expect(star.imports[0].module).to_equal("...")
        expect(star.imports[0].items).to_equal(["*"])
        expect(star.imports[0].span.end_pos).to_equal(11)
        val invalid = lsp_native_outline("use ..=wrong")
        expect(invalid.errors.len()).to_be_greater_than(0)
        expect(invalid.errors[0].message).to_equal("expected identifier")

    it("retains imports on both sides of an inline declaration"):
        val outline = lsp_native_outline("use first.module\nfn middle(): 1\nuse second.module\nfn last(): 2\n")
        expect(outline.errors.len()).to_equal(0)
        expect(outline.imports.len()).to_equal(2)
        expect(outline.imports[0].module).to_equal("first.module")
        expect(outline.imports[1].module).to_equal("second.module")
        expect(outline.imports[1].span.start).to_equal(32)
        expect(outline.functions.len()).to_equal(2)
        expect(outline.functions[0].name).to_equal("middle")
        expect(outline.functions[1].name).to_equal("last")

    it("keeps canonical UTF8 byte offsets before and inside an inline body"):
        val outline = lsp_native_outline("# 한😀\nfn first(): \"한😀\"\nfn second(): 2\n")
        expect(outline.errors.len()).to_equal(0)
        expect(outline.functions.len()).to_equal(2)
        expect(outline.functions[0].span.start).to_equal(10)
        expect(outline.functions[0].body_span.start).to_equal(22)
        expect(outline.functions[0].body_span.end_pos).to_equal(31)
        expect(outline.functions[1].span.start).to_equal(32)
        expect(outline.functions[1].span.end_pos).to_equal(46)

    it("reports native malformed-import errors rather than a successful empty outline"):
        step("Check the neighboring failure case")
        val outline = lsp_native_outline("use alpha.{One")
        expect(outline.errors.len()).to_be_greater_than(0)
        expect(outline.errors[0].message).to_equal("expected '}' after import items")
