# Purpose and audience: pin legacy parser diagnostic effects for the
# independent canonical Simple grammar/action differential oracle.
# @req simple_platform_unification/REQ-004

use std.spec
use std.spec.step
use compiler.core.tokens.{TOK_IDENT, TOK_KW_FN}
use compiler.frontend.core.parser.{parser_init_with_path, parser_expect,
    parser_check, parser_error_count, parser_get_errors,
    parser_diagnostics_suppressed_set, parser_diagnostic_emit_count_get}

describe "legacy parser diagnostic recovery oracle":
    it "records a failed expectation without consuming the token":
        step("Verify: failed expect preserves the current token and error order")
        parser_init_with_path("fn item", "diagnostic_oracle.spl")
        expect(parser_expect(TOK_IDENT)).to_equal(false)
        expect(parser_check(TOK_KW_FN)).to_equal(true)
        expect(parser_error_count()).to_equal(1)
        expect(parser_get_errors()[0]).to_contain("path diagnostic_oracle.spl")
        expect(parser_expect(TOK_KW_FN)).to_equal(true)
        expect(parser_check(TOK_IDENT)).to_equal(true)
        expect(parser_error_count()).to_equal(1)

    it "records suppressed diagnostics while keeping the print count zero":
        step("Verify: suppression affects printing, not parser error state")
        parser_init_with_path("fn item", "suppressed_oracle.spl")
        parser_diagnostics_suppressed_set(true)
        expect(parser_expect(TOK_IDENT)).to_equal(false)
        expect(parser_check(TOK_KW_FN)).to_equal(true)
        expect(parser_error_count()).to_equal(1)
        expect(parser_diagnostic_emit_count_get()).to_equal(0)

    it "clears recorded errors on a new reset parse":
        step("Verify: reset starts an independent diagnostic sequence")
        parser_init_with_path("fn item", "first_oracle.spl")
        expect(parser_expect(TOK_IDENT)).to_equal(false)
        expect(parser_error_count()).to_equal(1)
        parser_init_with_path("fn item", "second_oracle.spl")
        expect(parser_error_count()).to_equal(0)
        expect(parser_check(TOK_KW_FN)).to_equal(true)
