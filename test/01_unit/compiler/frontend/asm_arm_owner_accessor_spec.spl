use std.spec.{describe, it, expect}
use compiler.core.ast_expr.*

describe "asm arm owner accessors (ParseContext stage 2)":
    it "reads and writes an arm through the owner":
        val arm = asm_arm_new(["x86_64"], "linux", "", "", [], [], "nop", false, "", false)
        expect(asm_arm_owner_asm_text(arm)).to_equal("nop")
        expect(asm_arm_owner_os(arm)).to_equal("linux")
        asm_arm_owner_set_asm_text(arm, "ret")
        asm_arm_owner_set_is_compile_error(arm, true)
        asm_arm_owner_set_error_msg(arm, "boom")
        expect(asm_arm_owner_asm_text(arm)).to_equal("ret")
        expect(asm_arm_owner_is_compile_error(arm)).to_equal(true)
        expect(asm_arm_owner_error_msg(arm)).to_equal("boom")
