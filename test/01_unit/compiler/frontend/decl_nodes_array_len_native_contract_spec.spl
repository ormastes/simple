use std.nogc_sync_mut.io.file_ops.{file_read}

describe "declaration node native array length boundary":
    it "uses direct concrete slot lengths":
        val source = file_read("src/compiler/10.frontend/core/_Ast/decl_nodes.spl")

        expect(source.contains("fn decl_nodes_array_len<")).to_equal(false)
        expect(source.contains("decl_nodes_array_len(")).to_equal(false)
        expect(source).to_contain("ast_decl_count_slot.len()")
        expect(source).to_contain("ast_module_decl_count_slot.len()")
        expect(source).to_contain("module_decl_slots.len()")
