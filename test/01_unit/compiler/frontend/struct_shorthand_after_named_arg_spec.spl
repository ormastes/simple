# @req: REQ-COMPILER-FRONTEND-001

"""
# Reproducing spec: struct-literal shorthand argument after an explicit named argument

Bug: doc/08_tracking/bug/struct_shorthand_arg_order_binds_wrong_field_2026-07-20.md

`Point(x: 10, y)` -- an explicit named argument followed by a shorthand
argument -- binds the shorthand to the field default (0) instead of to the
local variable `y`. The mirror order `Point(x, y: 20)` works, so the defect is
order-dependent: once a named argument has been seen, the shorthand argument
that follows is no longer resolved by its identifier name.

Runs interpreted, which is where the defect lives (deployed Rust seed
interpreter), so no subprocess shell-out is required here.
"""

struct SsPoint:
    x: i64
    y: i64

struct SsConfig:
    host: text
    port: i64
    timeout: i64

use std.spec.step

describe "struct shorthand after an explicit named argument":

    it "binds the shorthand argument that follows a named argument":
        # @req: REQ-COMPILER-FRONTEND-001
        step("Verify: binds the shorthand argument that follows a named argument")
        val y = 20
        val point = SsPoint(x: 10, y)
        expect point.x == 10
        expect point.y == 20

    it "binds shorthand arguments on both sides of a named argument":
        # @req: REQ-COMPILER-FRONTEND-001
        step("Verify: binds shorthand arguments on both sides of a named argument")
        val host = "localhost"
        val timeout = 30
        val config = SsConfig(host, port: 8080, timeout)
        expect config.host == "localhost"
        expect config.port == 8080
        expect config.timeout == 30

    it "still binds the already-working shorthand-first order":
        # @req: REQ-COMPILER-FRONTEND-001
        step("Verify: still binds the already-working shorthand-first order")
        val x = 10
        val point = SsPoint(x, y: 20)
        expect point.x == 10
        expect point.y == 20
