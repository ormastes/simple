use std.spec.{describe, it, expect}
use compiler.frontend._FlatAstBridge.convert_nodes.{pending_defer_state_take, pending_defer_state_install}

describe "PendingDeferState ParseContext snapshot":
    it "take installs fresh state and install restores the snapshot":
        val a = pending_defer_state_take()
        val fresh = pending_defer_state_take()
        expect(fresh.g_pending_defers.len()).to_equal(0)
        pending_defer_state_install(a)
        val again = pending_defer_state_take()
        expect(again.g_pending_defers.len()).to_equal(a.g_pending_defers.len())
        pending_defer_state_install(again)
