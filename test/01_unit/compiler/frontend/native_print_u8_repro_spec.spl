use std.spec.*

# Pass-level pin: the interpreter lane (reference semantics) for the two native
# repro fixtures. Native-lane verification needs a stage3 binary; see the
# fixtures' header comments for the exact command.
describe "native repro fixtures (reference semantics)":
    it "print emits one line per call":
        val text = "line-a\nline-b\nline-c\n"
        expect(text.split("\n").len()).to_equal(4)
    it "u8 element widens numerically":
        val bytes = "A".bytes()
        expect(bytes[0].to_i64()).to_equal(65)
    it "static val array literal keeps its length":
        val a = 0
        val b = 1
        val arr: [i64] = [a, b]
        expect(arr.len()).to_equal(2)
    it "text to_upper and codepoint iteration":
        expect("abc".to_upper()).to_equal("ABC")
        var n = 0
        for ch in "héy":
            n = n + 1
        expect(n).to_equal(3)
