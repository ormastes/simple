use std.spec.{describe, it, expect}
use std.io_runtime.{env_set}
use std.spec.engine_probe.{engine_stdout}

const PROBE = "test/01_unit/compiler/frontend/frontend_cache_boundary_profile_probe.spl"
const CACHE_SCOPE = "frontend-cache-boundary-profile-contract"
const CACHE_DIR = "build/test_frontend_cache_boundary_profile"

fn configure_probe(profile: text):
    env_set("SIMPLE_FRONTEND_CACHE", "1")
    env_set("SIMPLE_FRONTEND_CACHE_SCOPE", CACHE_SCOPE)
    env_set("SIMPLE_FRONTEND_CACHE_DIR", CACHE_DIR)
    env_set("SIMPLE_FRONTEND_CACHE_BOUNDARY_PROFILE", profile)

fn clear_probe_environment():
    env_set("SIMPLE_FRONTEND_CACHE", "")
    env_set("SIMPLE_FRONTEND_CACHE_SCOPE", "")
    env_set("SIMPLE_FRONTEND_CACHE_DIR", "")
    env_set("SIMPLE_FRONTEND_CACHE_BOUNDARY_PROFILE", "")

describe "frontend cache-boundary profile":
    it "is silent by default":
        configure_probe("")
        val output = engine_stdout(PROBE, "interpret")
        clear_probe_environment()
        expect(output).to_contain("CACHE_BOUNDARY_PROFILE_PROBE_PASS")
        expect(output).to_not_contain("PARSECACHE")

    it "reports miss, hit, dump, store, and desugar boundaries when enabled":
        configure_probe("1")
        val output = engine_stdout(PROBE, "interpret")
        clear_probe_environment()
        expect(output).to_contain("CACHE_BOUNDARY_PROFILE_PROBE_PASS")
        expect(output).to_contain("PARSECACHE\tload_ms=")
        expect(output).to_contain("PARSECACHE\tdump_ms=")
        expect(output).to_contain("PARSECACHE\tstore_ms=")
        expect(output).to_contain("PARSECACHE\tdesugar_ms=")
        expect(output).to_contain("stored=true")
        expect(output).to_contain("bytes=")
        expect(output).to_contain("path=")
