use std.spec.{describe, it, expect}
use compiler.frontend.core.parser.{parser_fixed_array_elem, parser_fixed_array_size, parser_state_take, parser_state_install}

describe "parser fixed-array accessors (ParseContext stage 2)":
    it "read the active context's side channel":
        val saved = parser_state_take()
        expect(parser_fixed_array_elem()).to_equal(0)
        expect(parser_fixed_array_size()).to_equal(-1)
        parser_state_install(saved)
        expect(parser_fixed_array_size()).to_equal(saved.par_fixed_array_size)
