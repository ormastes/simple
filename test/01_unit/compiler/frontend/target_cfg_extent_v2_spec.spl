# Actual target parser/input-owner tests; compilation/execution is not claimed.
use std.spec.*
use std.common.crypto.sha256.{sha256_text}
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend_target_receipted_v1, frontend_prepare_preprocessed_source_v1}
use compiler.frontend.frontend_advisory_preprocess_port_v1.{FrontendAdvisoryPreprocessPolicyV1}
use compiler.frontend.frontend_target_cfg_receipt_v1.{frontend_cfg_receipt_valid_v1, frontend_cfg_receipt_extent_valid_v2}
use compiler.core.parser_preprocessor.{_pp_preprocess_conditionals_target_receipted_v1}

describe "Exact parsed source extent v2":
    it "records bytes after the same target and advisory preprocessing owners":
        val source = "# UTF8 é한\n@cfg(linux)\nfn picked() -> i64:\n    4\n"
        val selected = _pp_preprocess_conditionals_target_receipted_v1(source, "linux", "x86_64").unwrap()
        val prepared = frontend_prepare_preprocessed_source_v1(selected.source, FrontendAdvisoryPreprocessPolicyV1.Reference, 0u64, 0u64, 0u64).unwrap()
        val parsed = parse_full_frontend_target_receipted_v1(source, "extent.spl", "extent", Logger(level: 0), "scv:test:extent", sha256_text(source), "x86_64-unknown-linux-gnu").unwrap()
        val receipt = parsed[1]
        expect(receipt.parsed_byte_length).to_equal(prepared[0].byte_len())
        expect(receipt.preprocessed_digest).to_equal(sha256_text(prepared[0]))
        expect(frontend_cfg_receipt_extent_valid_v2(receipt, "scv:test:extent", sha256_text(source), "x86_64-unknown-linux-gnu")).to_equal(true)

    it "leaves legacy validation and decision identity unchanged while refusing unknown extent":
        val source = "fn ordinary() -> i64:\n    1\n"
        val parsed = parse_full_frontend_target_receipted_v1(source, "legacy_extent.spl", "legacy_extent", Logger(level: 0), "scv:test:legacy_extent", sha256_text(source), "x86_64-unknown-linux-gnu").unwrap()
        var legacy = parsed[1]
        val decision = legacy.decision_digest
        legacy.parsed_byte_length = -1
        expect(frontend_cfg_receipt_valid_v1(legacy, "scv:test:legacy_extent", sha256_text(source), "x86_64-unknown-linux-gnu")).to_equal(true)
        expect(legacy.decision_digest).to_equal(decision)
        expect(frontend_cfg_receipt_extent_valid_v2(legacy, "scv:test:legacy_extent", sha256_text(source), "x86_64-unknown-linux-gnu")).to_equal(false)

    it "does not accept an extent with a mismatched source or target":
        val source = "fn ordinary() -> i64:\n    1\n"
        val parsed = parse_full_frontend_target_receipted_v1(source, "bound_extent.spl", "bound_extent", Logger(level: 0), "scv:test:bound_extent", sha256_text(source), "x86_64-unknown-linux-gnu").unwrap()
        val receipt = parsed[1]
        expect(frontend_cfg_receipt_extent_valid_v2(receipt, "other-source", sha256_text(source), "x86_64-unknown-linux-gnu")).to_equal(false)
        expect(frontend_cfg_receipt_extent_valid_v2(receipt, "scv:test:bound_extent", sha256_text(source), "aarch64-unknown-linux-gnu")).to_equal(false)
