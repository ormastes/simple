use std.spec.{describe, it, expect}
use compiler.frontend.core._AstExpr.nodes.{expr_store_state_take, expr_store_state_install}

describe "ExprStoreState ParseContext snapshot (stage 1)":
    it "take leaves fresh stores and install restores the snapshot":
        val a = expr_store_state_take()
        val fresh = expr_store_state_take()
        expect(fresh.expr_tag.len()).to_equal(0)
        expr_store_state_install(a)
        val again = expr_store_state_take()
        expect(again.expr_tag.len()).to_equal(a.expr_tag.len())
        expr_store_state_install(again)
