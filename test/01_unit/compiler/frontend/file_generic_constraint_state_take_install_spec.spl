use std.spec.{describe, it, expect}
use compiler.frontend.core.parser_decls_fn.{file_generic_constraint_state_take, file_generic_constraint_state_install}

describe "FileGenericConstraintState ParseContext snapshot":
    it "take installs fresh state and install restores the snapshot":
        val a = file_generic_constraint_state_take()
        val fresh = file_generic_constraint_state_take()
        expect(fresh.file_generic_constraints.len()).to_equal(0)
        file_generic_constraint_state_install(a)
        val again = file_generic_constraint_state_take()
        expect(again.file_generic_constraints.len()).to_equal(a.file_generic_constraints.len())
        file_generic_constraint_state_install(again)
