# @cover src/compiler/10.frontend/core/interpreter/module_loader_resolve.spl
#
# Regression: module resolution is part of the bootstrap compiler closure. Its
# deprecated-import warning must use the canonical stderr facade; a direct
# rt_eprintln call leaves spl_eprintln unresolved in the Stage4 runtime capsule.
#
# tag: unit

use std.spec

extern fn rt_file_read_text(path: text) -> text

fn module_loader_resolve_source() -> text:
    rt_file_read_text("src/compiler/10.frontend/core/interpreter/module_loader_resolve.spl") ?? ""

describe "module resolver bootstrap runtime capsule":
    it "routes deprecated import warnings through the stderr facade":
        val source = module_loader_resolve_source()

        expect(source).to_contain("use std.nogc_sync_mut.io.process_ops.{eprint}")
        expect(source).to_contain("eprint(\"[error] `use std.ffi` is deprecated")
        expect(source).to_not_contain("rt_eprintln(")
