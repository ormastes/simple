# Prefix address-of must survive the bootstrap flat-AST path.

use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.parser_types.*
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.mir.mir.*

fn lower_address_mir(src: text) -> MirModule:
    val module = parse_and_build_module(src, "flat_ast_address_of_mir_probe.spl")
    var hir_lowering = HirLowering.with_filename("flat_ast_address_of_mir_probe.spl")
    val hir = hir_lowering.lower_module(module)
    var mir_lowering = MirLowering.new(hir.symbols)
    mir_lowering.lower_module(hir)

fn contains_shared_ref(expr: Expr) -> bool:
    match expr.kind:
        case ExprKind.Unary(op, _):
            op == UnaryOp.Ref
        case ExprKind.Cast(inner, _):
            contains_shared_ref(inner)
        case _:
            false

describe "flat AST address-of parsing", tag: ["only-compiled"]:
    it "preserves shared and mutable references plus binary bitwise-and":
        val src = "fn probe(buf: i64, left: u64, right: u64) -> i64:\n" +
            "    val result = syscall(80, 1, 0, &buf as u64, left & right, &mut buf, 0)\n" +
            "    result\n"
        val module = parse_and_build_module(src, "flat_ast_address_of_probe.spl")
        val probe = module.functions["probe"] ?? panic("missing probe function")

        match probe.body.stmts[0].kind:
            case StmtKind.Val(_, _, init):
                match init.kind:
                    case ExprKind.Call(_, args):
                        expect(contains_shared_ref(args[3].value)).to_equal(true)
                        match args[5].value.kind:
                            case ExprKind.Unary(op, _):
                                expect(op).to_equal(UnaryOp.RefMut)
                            case _:
                                fail("call argument was not a mutable reference")
                        match args[4].value.kind:
                            case ExprKind.Binary(op, _, _):
                                expect(op).to_equal(BinOp.BitAnd)
                            case _:
                                fail("binary ampersand did not remain bitwise-and")
                    case _:
                        fail("initializer was not a call")
            case _:
                fail("first statement was not a value declaration")

    it "lowers reference syntax to MIR Ref instead of numeric negation":
        val mir = lower_address_mir("fn address(buf: i64):\n    (&buf) as u64\n\nfn mutable(buf: i64):\n    &mut buf\n")
        var saw_shared = false
        var saw_mutable = false
        var saw_neg = false
        for function in mir.functions.values():
            for block in function.blocks:
                for instruction in block.instructions:
                    match instruction.kind:
                        case MirInstKind.Ref(_, MirBorrowKind.Shared, _):
                            saw_shared = true
                        case MirInstKind.Ref(_, MirBorrowKind.Mutable, _):
                            saw_mutable = true
                        case MirInstKind.UnaryOp(_, MirUnaryOp.Neg, _):
                            saw_neg = true
                        case _:
                            pass
        expect(saw_shared).to_equal(true)
        expect(saw_mutable).to_equal(true)
        expect(saw_neg).to_equal(false)
