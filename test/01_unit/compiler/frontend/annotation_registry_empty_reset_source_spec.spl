use std.spec.*
use std.io.{file_read_text as file_read}

describe "annotation registry empty-reset native guard":
    it "uses authoritative scalar counts in all module-scoped registries":
        val layer = file_read("src/compiler/10.frontend/layer_eq_registry.spl")
        val effect = file_read("src/compiler/10.frontend/effect_registry.spl")
        val aspect = file_read("src/compiler/10.frontend/aspect_registry.spl")

        # The registries keep an authoritative ordered claim list per registry,
        # keyed "<module path>|<name>", with a module-scoped reset that keeps
        # every OTHER module's claims (kept.push) and declare-time dedup
        # (contains-then-push) so a re-parse cannot duplicate a claim.
        expect(layer).to_contain("fn layer_eq_registry_reset_module(path: text):")
        expect(layer).to_contain("kept.push(key)")
        expect(layer).to_contain("layer_eq_registry_views.push(key)")
        expect(effect).to_contain("fn effect_registry_reset_module(path: text):")
        expect(effect).to_contain("kept.push(key)")
        expect(effect).to_contain("effect_registry_fns.push(key)")
        expect(aspect).to_contain("fn aspect_registry_reset_module(path: text):")
        expect(aspect).to_contain("kept.push(key)")
        expect(aspect).to_contain("aspect_registry_fns.push(key)")
