# Purpose: `name!(...)` parsing added in #4456 must not misfire on quoted
# examples and must keep real-code diagnostics unchanged. Covers the two
# in-tree `format!(` sites: exhaustiveness_validator.spl (inside a docstring)
# and app/interpreter/helpers/debug_spec.spl (Rust-syntax helper code whose
# parse errors were checked identical before/after #4456).
# @req M-02

use std.spec.*
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.core.parser.{par_errors}
use compiler.frontend.core._Ast.decl_nodes.{macro_fact_use_count, macro_fact_use_name_at,
    macro_fact_use_args_at}

val DOC_SRC = "fn f() -> i64:\n    \"\"\"\n    return Err(format!(\n        \"x\", inst\n    ))\n    \"\"\"\n    1\n"
val CODE_SRC = "fn g(x: text) -> text:\n    format!(\"a\", x)\n"
val NOT_SRC = "fn h(a: bool, b: bool) -> bool:\n    a != b\n"

describe "name!(...) parsing":
    it "a format!( inside a docstring is text, not an invocation":
        val _m = parse_full_frontend(DOC_SRC, "doc_fixture.spl", "doc_fixture", Logger(level: 0))
        expect(par_errors.len()).to_equal(0)
        expect(macro_fact_use_count()).to_equal(0)

    it "a real format!(...) is recorded and parses as a call without errors":
        val m = parse_full_frontend(CODE_SRC, "code_fixture.spl", "code_fixture", Logger(level: 0))
        expect(par_errors.len()).to_equal(0)
        expect(m.functions.len()).to_equal(1)
        expect(macro_fact_use_count()).to_equal(1)
        expect(macro_fact_use_name_at(0)).to_equal("format")
        expect(macro_fact_use_args_at(0)).to_equal("\"a\", x")

    it "!= is not taken for an invocation":
        val _m = parse_full_frontend(NOT_SRC, "ne_fixture.spl", "ne_fixture", Logger(level: 0))
        expect(par_errors.len()).to_equal(0)
        expect(macro_fact_use_count()).to_equal(0)
