use std.spec.{describe, it, expect}
use compiler.frontend.core.capture_write_check.{capture_write_check_state_take, capture_write_check_state_install}

describe "CaptureWriteCheckState ParseContext snapshot":
    it "take installs fresh state and install restores the snapshot":
        val a = capture_write_check_state_take()
        val fresh = capture_write_check_state_take()
        expect(fresh.cw_names.len()).to_equal(0)
        capture_write_check_state_install(a)
        val again = capture_write_check_state_take()
        expect(again.cw_names.len()).to_equal(a.cw_names.len())
        capture_write_check_state_install(again)
