# @req: REQ-COMPILER-FRONTEND-001

# Class-detection spec: module-level surface syntax must not be silently
# dropped by the parser.
#
# Generalized from
# doc/08_tracking/bug/type_alias_declarations_discarded_at_parse_2026-07-29.md.
#
# Defect class: parse_module_body
# (src/compiler/10.frontend/core/_ParserDecls/enum_module_body.spl) is a flat
# dispatcher over module-level token kinds. A branch that merely
# parser_advance()s to the next newline without calling module_add_decl
# discards that construct entirely -- compilation still succeeds, exit code is
# still 0, and every downstream layer (_FlatAstBridge, 35.semantics, lints)
# simply cannot see the construct. That is a silent semantic hole, not an
# error, so it can only be detected by asserting that each surface form is
# PRESENT in the parsed module.
#
# This spec asserts presence for a spread of module-level forms alongside
# aliases, and checks the two failure modes a skip-branch produces: the
# construct is missing, and/or neighbouring constructs are lost because the
# skip loop desynced the token stream.

use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.parser_types.*

use std.spec.step

describe "module-level surface syntax survives parse_module_body":

    it "keeps several aliases, not just the first":
        # @req: REQ-COMPILER-FRONTEND-001
        step("Verify: keeps several aliases, not just the first")
        val src = "type A = i64\ntype B = text\ntype C = bool\n"
        val m = parse_and_build_module(src, "c.spl")
        expect m.type_aliases.len() == 3
        expect m.type_aliases.contains_key("A")
        expect m.type_aliases.contains_key("B")
        expect m.type_aliases.contains_key("C")

    it "keeps aliases interleaved with functions and structs":
        # @req: REQ-COMPILER-FRONTEND-001
        step("Verify: keeps aliases interleaved with functions and structs")
        val src = "type A = i64\nfn f1() -> i64:\n    return 1\ntype B = text\nstruct S:\n    v: i64\nfn f2() -> i64:\n    return 2\n"
        val m = parse_and_build_module(src, "c.spl")
        expect m.type_aliases.len() == 2
        expect m.functions.len() == 2
        expect m.structs.len() == 1

    it "keeps an alias declared after a struct":
        # @req: REQ-COMPILER-FRONTEND-001
        step("Verify: keeps an alias declared after a struct")
        val src = "struct S:\n    v: i64\ntype A = i64\n"
        val m = parse_and_build_module(src, "c.spl")
        expect m.structs.len() == 1
        expect m.type_aliases.len() == 1

    it "keeps an alias to a user-defined type":
        # @req: REQ-COMPILER-FRONTEND-001
        step("Verify: keeps an alias to a user-defined type")
        val src = "struct S:\n    v: i64\ntype AliasOfS = S\n"
        val m = parse_and_build_module(src, "c.spl")
        expect m.type_aliases.contains_key("AliasOfS")

    it "does not lose the last declaration in the file":
        # @req: REQ-COMPILER-FRONTEND-001
        step("Verify: does not lose the last declaration in the file")
        # A skip-to-newline branch at EOF is the classic off-by-one: the
        # construct after it disappears with no diagnostic.
        val src = "type A = i64\nfn last() -> i64:\n    return 9\n"
        val m = parse_and_build_module(src, "c.spl")
        expect m.functions.contains_key("last")
