# Importing a module whose exported function exists only inside top-level
# @when/@elif/@else blocks resolves to the variant for the running host
# (interpretation targets the host). Exercises the import / module-loader
# path of whichever runtime executes the spec.
use std.spec
use std.spec.step
use compiler.core.cfg_platform.{cfg_detect_os}
use test.fixtures.compiler.when_block_exports.{when_fixture_os_label}

describe "import of @when-defined exports":
    it "resolves the host-selected variant":
        step("import of a module whose exports are defined inside @when")
        val os = cfg_detect_os()
        val expected = if os == "windows": "windows" elif os == "linux": "linux" else: "other"
        assert_equal(when_fixture_os_label(), expected)
