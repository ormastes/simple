# Authored regression; inventory must not enable field lowering for a function name.
use compiler.frontend.core.aop_predicate_parser.{aop_predicate_has_field_selector_v1}

describe "atom-aware field selector inventory":
    it "keeps ordinary functions named get and set on the execution path":
        expect(aop_predicate_has_field_selector_v1("execution(* get(..))")).to_equal(false)
        expect(aop_predicate_has_field_selector_v1("execution(* set(..))")).to_equal(false)
        expect(aop_predicate_has_field_selector_v1("!execution(* app.get(..)) & within(app.*)")).to_equal(false)

    it "finds field selectors after balanced atoms and grouping":
        expect(aop_predicate_has_field_selector_v1("execution(* get(..)) | get(app.Box.value)")).to_equal(true)
        expect(aop_predicate_has_field_selector_v1("!(set ( app.Box.value ))")).to_equal(true)
        expect(aop_predicate_has_field_selector_v1("within(app.*) & (get(app.Box.value) | set(app.Box.value))")).to_equal(true)

    it "ignores comment text but resumes selector detection after comments":
        expect(aop_predicate_has_field_selector_v1("execution(* get(..)) # set(app.Box.value)\n")).to_equal(false)
        expect(aop_predicate_has_field_selector_v1("# get(app.Box.value)\nexecution(* set(..))")).to_equal(false)
        expect(aop_predicate_has_field_selector_v1("execution(* get(..)) | # comment\nset(app.Box.value)")).to_equal(true)
