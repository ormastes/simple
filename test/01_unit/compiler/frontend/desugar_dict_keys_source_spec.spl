extern fn rt_file_read_text(path: text) -> text?

describe "async desugar Dict key traversal source":
    it "uses the typed Dict runtime owner instead of ambiguous Map dispatch":
        val source = rt_file_read_text("src/compiler/10.frontend/desugar/desugar_async.spl") ?? ""

        # The desugar walks functions, generated helpers, and actors through
        # explicit order lists (function_order / generated_helper_names /
        # actor_order) instead of enumerating dict keys, so traversal order
        # is deterministic and never depends on Dict iteration order.
        expect(source).to_contain("val function_names = module.function_order")
        expect(source).to_contain("val helper_names = generated_helper_names")
        expect(source).to_contain("val actor_names = module.actor_order")
