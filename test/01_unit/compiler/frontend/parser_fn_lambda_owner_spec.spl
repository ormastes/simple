use std.nogc_sync_mut.io.file_ops.{file_read}
use compiler.core.parser.{parse_module, parser_has_errors, parser_set_had_error}

fn owner_lambda_parses(source: text, name: text) -> bool:
    parser_set_had_error(false)
    parse_module(source, name)
    not parser_has_errors()

describe "statement fn lambda parser owner":
    it "binds and exports the lambda continuation from its concrete owner":
        val consumer = file_read("src/compiler/10.frontend/core/parser_stmts.spl")
        val owner = file_read("src/compiler/10.frontend/core/_ParserPrimary/primary_expr.spl")
        expect(consumer).to_contain("use compiler.frontend.core._ParserPrimary.primary_expr.\{parse_fn_lambda_after_kw}")
        # Pin drift: combined export added by a394d4a5be5 was lost by the ae55a746719
        # tree restore; current owner contract is a single explicit export plus the
        # owner-side definition of parse_fn_lambda_after_kw.
        expect(owner).to_contain("export parse_primary_expr")
        expect(owner).to_contain("fn parse_fn_lambda_after_kw() -> i64:")
        expect(consumer.count("parse_fn_lambda_after_kw()")).to_equal(3)

    it "parses a named nested function statement":
        val source = "fn outer(x: i64) -> i64:\n    fn twice(y: i64) -> i64: y * 2\n    twice(x)\n"
        expect(owner_lambda_parses(source, "named_nested_fn_owner.spl")).to_equal(true)

    it "parses an anonymous function expression statement":
        val source = "fn outer():\n    fn(x: i64) -> i64: x + 1\n"
        expect(owner_lambda_parses(source, "anonymous_stmt_fn_owner.spl")).to_equal(true)

    it "parses a me-named function statement":
        val source = "fn outer():\n    me helper(x: i64) -> i64: x\n"
        expect(owner_lambda_parses(source, "me_named_fn_owner.spl")).to_equal(true)
