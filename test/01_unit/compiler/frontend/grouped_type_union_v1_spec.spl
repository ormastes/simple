# @manual: show
# @req: REQ-C2-UNION-TRANSPORT-001
# Actual parser AST and HIR grouping regressions. All scenarios UNRUN.
use std.spec.{describe, it, expect, fail}
use std.spec.step
use compiler.common.config.{Logger}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.core.parser.{parser_has_errors}
use compiler.frontend.parser_types_expr.{TypeKind, parser_type_kind_named_name}
use compiler.hir.hir_types.{HirTypeKind}
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*

describe "parenthesized type grouping retains the existing type expression":
    it "retains nested union structure in the actual AST and HIR":
        step("Parse a grouped union member without replacing it with Any")
        val source = "fn select(value: (bool | i64) | bool) -> i64:\n    0\n"
        val parsed = parse_full_frontend(source, "grouped.spl", "grouped", Logger(level: 0))
        expect(parser_has_errors()).to_equal(false)
        match parsed.functions["select"].params[0].type_.kind:
            case TypeKind.Union(members):
                expect(members.len()).to_equal(2)
                match members[0].kind:
                    case TypeKind.Union(nested):
                        expect(nested.len()).to_equal(2)
                        expect(parser_type_kind_named_name(nested[0].kind)).to_equal("bool")
                        expect(parser_type_kind_named_name(nested[1].kind)).to_equal("i64")
                    case _: fail("grouped union was erased in AST")
            case _: fail("outer union absent")
        var lowering = HirLowering.with_filename("grouped.spl")
        val hir = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        var selected = 0
        for function in hir.functions.values():
            if function.name == "select":
                selected = selected + 1
                match function.params[0].type_.kind:
                    case HirTypeKind.Union(members):
                        match members[0].kind:
                            case HirTypeKind.Union(nested): expect(nested.len()).to_equal(2)
                            case _: fail("grouped union was erased in HIR")
                    case _: fail("outer HIR union absent")
        expect(selected).to_equal(1)

    it "retains ordinary scalar grouping and optional suffix nesting":
        step("Keep a grouped scalar identical to its existing primitive type")
        val parsed = parse_full_frontend("fn select(value: (i64), maybe: (i64)?) -> (i64):\n    value\n", "grouped.spl", "grouped", Logger(level: 0))
        expect(parser_has_errors()).to_equal(false)
        val function = parsed.functions["select"]
        expect(parser_type_kind_named_name(function.params[0].type_.kind)).to_equal("i64")
        expect(parser_type_kind_named_name(function.return_type.kind)).to_equal("i64")
        match function.params[1].type_.kind:
            case TypeKind.Named(name, args):
                expect(name).to_equal("Option")
                expect(args.len()).to_equal(1)
                expect(parser_type_kind_named_name(args[0].kind)).to_equal("i64")
            case _: fail("grouped optional changed shape")
        var lowering = HirLowering.with_filename("grouped.spl")
        val hir = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        for function in hir.functions.values():
            match function.return_type.kind:
                case HirTypeKind.Int(bits, signed):
                    expect(bits).to_equal(64)
                    expect(signed).to_equal(true)
                case _: fail("grouped scalar became Any in HIR")

    it "preserves ordinary tuple arity labels and trailing commas":
        step("Keep the existing multi-element tuple and empty tuple productions")
        val parsed = parse_full_frontend("fn select(pair: (left: i64, right: bool,), unit: ()) -> i64:\n    0\n", "grouped.spl", "grouped", Logger(level: 0))
        expect(parser_has_errors()).to_equal(false)
        val function = parsed.functions["select"]
        match function.params[0].type_.kind:
            case TypeKind.Tuple(elements):
                expect(elements.len()).to_equal(2)
                expect(parser_type_kind_named_name(elements[0].kind)).to_equal("i64")
                expect(parser_type_kind_named_name(elements[1].kind)).to_equal("bool")
            case _: fail("ordinary tuple changed shape")
        match function.params[1].type_.kind:
            case TypeKind.Tuple(elements): expect(elements.len()).to_equal(0)
            case _: fail("empty tuple changed shape")

    it "preserves the existing single-element trailing-comma compatibility path":
        step("Do not reinterpret the separate legacy singleton tuple placeholder as grouping")
        val parsed = parse_full_frontend("fn select(value: (i64,)) -> i64:\n    0\n", "grouped.spl", "grouped", Logger(level: 0))
        expect(parser_has_errors()).to_equal(false)
        expect(parser_type_kind_named_name(parsed.functions["select"].params[0].type_.kind)).to_equal("__any")

    it "preserves function parameters and grouped return-union precedence":
        step("Keep the arrow production ahead of the single grouped type result")
        val parsed = parse_full_frontend("fn select(callback: (i64, bool) -> (i64 | bool)) -> i64:\n    0\n", "grouped.spl", "grouped", Logger(level: 0))
        expect(parser_has_errors()).to_equal(false)
        match parsed.functions["select"].params[0].type_.kind:
            case TypeKind.Function(parameters, result):
                expect(parameters.len()).to_equal(2)
                expect(parser_type_kind_named_name(parameters[0].kind)).to_equal("i64")
                expect(parser_type_kind_named_name(parameters[1].kind)).to_equal("bool")
                match result.kind:
                    case TypeKind.Union(members): expect(members.len()).to_equal(2)
                    case _: fail("grouped function return union erased")
            case _: fail("function arrow became an ordinary grouping")

    it "keeps outer Optional distinct from Optional appearing inside a union":
        step("Retain the precise AST and HIR nesting for later carrier admission")
        val parsed = parse_full_frontend("fn select(value: (i64 | bool)?) -> i64:\n    0\n", "grouped.spl", "grouped", Logger(level: 0))
        expect(parser_has_errors()).to_equal(false)
        match parsed.functions["select"].params[0].type_.kind:
            case TypeKind.Named(name, args):
                expect(name).to_equal("Option")
                expect(args.len()).to_equal(1)
                match args[0].kind:
                    case TypeKind.Union(members): expect(members.len()).to_equal(2)
                    case _: fail("outer Optional's grouped union erased")
            case _: fail("outer Optional was flattened by the parser")
        var lowering = HirLowering.with_filename("grouped.spl")
        val hir = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        for function in hir.functions.values():
            match function.params[0].type_.kind:
                case HirTypeKind.Optional(inner):
                    match inner.kind:
                        case HirTypeKind.Union(members): expect(members.len()).to_equal(2)
                        case _: fail("HIR optional inner union erased")
                case _: fail("HIR outer Optional changed")
