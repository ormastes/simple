use std.spec.{describe, it, expect}
use compiler.core.ast.*

describe "decl owner raw accessors (ParseContext stage 2)":
    it "write and read the packed flag through the owner":
        val before = decl_is_packed_len()
        expect(before >= 0).to_equal(true)
        if before > 0:
            decl_is_packed_set_at(0, 1)
            expect(decl_is_packed_at(0)).to_equal(1)
            decl_is_packed_set_at(0, 0)
            expect(decl_is_packed_at(0)).to_equal(0)
