# Standalone native regression oracle for the FlatAstBridge field loop.
#
# The staged compiler inserts rt_pool_safepoint at the loop backedge in
# flat_ast_to_module.  A field aggregate must therefore own the Type, default
# Expr, and Span values constructed after that safepoint; borrowing a Span made
# before the declaration walk caused the native aggregate copy to dereference
# reclaimed storage.

use compiler.frontend.flat_ast_bridge.{parse_and_build_module_scoped}
use compiler.frontend.parser_types.{ParserModule, ParserStruct, ParserField}
use compiler.frontend.parser_types_expr.{
    ExprKind, TypeKind, parser_type_kind_array_element_name,
    parser_type_kind_named_name
}

extern fn rt_enum_discriminant(value: Any) -> i64
extern fn rt_exit(code: i32)

fn main() -> i64:
    val source = "struct SafepointPayload:\n"
        + "    value: i64\n"
        + "\n"
        + "struct SafepointFieldOwner:\n"
        + "    maybe_payload: Option<SafepointPayload> = nil\n"
        + "    labels: [text]\n"
    val parsed: ParserModule = parse_and_build_module_scoped(
        source, "flat_bridge_parser_field_safepoint_native.spl", true)
    if not parsed.structs.has("SafepointFieldOwner"):
        rt_exit(71)

    val owner: ParserStruct = parsed.structs["SafepointFieldOwner"]
    if owner.fields.len() != 2:
        rt_exit(72)

    val maybe_field: ParserField = owner.fields[0]
    val labels_field: ParserField = owner.fields[1]
    if maybe_field.name != "maybe_payload":
        rt_exit(73)
    if parser_type_kind_named_name(maybe_field.type_.kind) != "Option":
        rt_exit(74)
    if not maybe_field.has_default:
        rt_exit(75)
    if rt_enum_discriminant(maybe_field.default.kind)
            != rt_enum_discriminant(ExprKind.NilLit):
        rt_exit(76)
    if labels_field.name != "labels":
        rt_exit(77)
    if parser_type_kind_array_element_name(labels_field.type_.kind) != "text":
        rt_exit(78)
    if rt_enum_discriminant(labels_field.type_.kind)
            == rt_enum_discriminant(TypeKind.Infer):
        rt_exit(79)
    0
