        expect(bridge.contains("materialize_legacy")).to_equal(false)
        expect(bridge).to_contain("if next_if >= current:")
        expect(bridge).to_contain("flat_bridge_report_unhandled_node(\"if-chain-order\", next_if)")
        expect(parser_stmts).to_contain("fn parse_if_stmt() -> i64:")
