    it "rejects out-of-bounds statement ids instead of indexing them":
        # @req REQ-COMPILER-FRONTEND-BRIDGE-022
        # @capture(statistics): retained verdict for scenario 'rejects out-of-bounds statement ids instead of indexing them'
