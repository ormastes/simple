    it "rejects out-of-order nested STMT_IF links instead of spinning":
        # @req REQ-COMPILER-FRONTEND-BRIDGE-021
        # @capture(statistics): retained verdict for scenario 'rejects out-of-order nested STMT_IF links instead of spinning'
        step("Verify: rejects out-of-order nested STMT_IF links instead of spinning")
