    it "records STMT_IF and EXPR_IF decisions in compiler coverage inventory":
        # @req REQ-COMPILER-FRONTEND-BRIDGE-025
        # @capture(statistics): retained verdict for scenario 'records STMT_IF and EXPR_IF decisions in compiler coverage inventory'
        step("Verify: records STMT_IF and EXPR_IF decisions in compiler coverage inventory")
        val source = rt_file_read_text("src/compiler/10.frontend/core/ast_coverage_inventory.spl") ?? ""
        expect(source).to_contain("if tag == EXPR_IF or tag == EXPR_WHILE:")
        expect(source).to_contain("if tag == STMT_IF or tag == STMT_WHILE:")
