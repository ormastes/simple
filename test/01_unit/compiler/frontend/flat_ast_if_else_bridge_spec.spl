    it "enforces bounds-safe statement and elif arena getters":
        # @req REQ-COMPILER-FRONTEND-BRIDGE-023
        # @capture(statistics): retained verdict for scenario 'enforces bounds-safe statement and elif arena getters'
        step("Verify: enforces bounds-safe statement and elif arena getters")
        ast_reset()
        val cond = expr_bool_lit(true, 0)
        val elif_id = elif_new(cond, [], [expr_int_lit(1, 0)])
        val if_id = stmt_if_stmt(cond, [], elif_id, 0)
        expect(elif_count()).to_equal(1)
        expect(elif_get_cond(elif_id)).to_equal(cond)
        expect(elif_get_else(elif_id).len()).to_equal(1)
        expect(stmt_get_if_single_else(if_id)).to_equal(-1)
        expect(stmt_get_tag(-1)).to_equal(-1)
        expect(stmt_get_tag(999999)).to_equal(-1)

    it "keeps the bridge iterative with order validation and no legacy materializer":
