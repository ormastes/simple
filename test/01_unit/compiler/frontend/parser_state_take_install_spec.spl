use std.spec.{describe, it, expect}
use compiler.frontend.core.parser.{parser_set_had_error, parser_has_errors, parser_state_take, parser_state_install}

describe "parser ParseContext snapshot (stage 1)":
    it "take starts a clean parser context and install restores the error flag":
        parser_set_had_error(true)
        val a = parser_state_take()
        expect(a.par_had_error).to_equal(true)
        expect(parser_has_errors()).to_equal(false)

        val fresh = parser_state_take()
        expect(fresh.par_errors.len()).to_equal(0)
        expect(fresh.par_fixed_array_size).to_equal(-1)

        parser_state_install(a)
        expect(parser_has_errors()).to_equal(true)
        parser_set_had_error(false)
