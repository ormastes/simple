use std.spec
use test.fixtures.compiler.borrowed_scope_case.{borrowed_cache_scope_case, owned_cache_scope_case}

describe "flat pool cache scope ownership":
    it "retains cold and restored blobs while borrowing the driver scope":
        expect(borrowed_cache_scope_case(false)).to_equal(0)

    it "leaves parser error cleanup with the driver owner":
        expect(borrowed_cache_scope_case(true)).to_equal(0)

    it "still serializes and restores under its own temporary scope":
        expect(owned_cache_scope_case()).to_equal(0)

    it "can borrow a fresh owner after owned serialization and parser errors":
        expect(borrowed_cache_scope_case(false)).to_equal(0)
