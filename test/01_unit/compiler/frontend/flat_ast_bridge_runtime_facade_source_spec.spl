use std.spec.*
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "flat AST bridge environment facade ownership":
    it "preserves nullable transport and total bridge lookup semantics":
        val source = file_read(
            "src/compiler/10.frontend/_FlatAstBridge/convert_nodes.spl")
        val facade_source = file_read(
            "src/lib/nogc_sync_mut/io_runtime.spl")

        expect(source).to_contain(
            "use std.nogc_sync_mut.io_runtime.{env_get_nullable}")

        # Positive cardinalities keep the contract meaningful if either the
        # bridge lookup or the reset trace control is accidentally removed.
        expect(source.split("env_get_nullable(").len() - 1).to_equal(2)
        expect(source.split("flat_bridge_env_get(").len() - 1).to_be_greater_than(8)

        # The wrapper deliberately keeps its old empty-for-unset contract;
        # the direct trace lookup also collapses nil only at its use site.
        expect(source).to_contain(
            "fn flat_bridge_env_get(key: text) -> text:\n    env_get_nullable(key) ?? \"\"")
        expect(source).to_contain(
            "val trace_reset = (env_get_nullable(\"SIMPLE_TRACE_AST_RESET\") ?? \"\") == \"1\"")

        expect(source.contains("extern fn rt_env_get")).to_equal(false)
        expect(source.contains("rt_env_get(")).to_equal(false)
        expect(source.contains("env_get_opt(")).to_equal(false)

        # The facade must not merely advertise an optional result over a
        # non-optional raw declaration: both runtime providers return nil for
        # an unset key, so the ABI owner must state that contract exactly.
        expect(facade_source).to_contain(
            "extern fn rt_env_get(key: text) -> text?")
        val nullable_prefix = facade_source.split(
            "pub fn env_get_nullable(key: text) -> text?:")
        expect(nullable_prefix.len()).to_equal(2)
        val nullable_body = nullable_prefix[1].split("\n\n")[0]
        expect(nullable_body.split("rt_env_get(key)").len() - 1).to_equal(1)
        expect(nullable_body).to_equal(
            "\n    unsafe(capabilities: [ffi]):\n        rt_env_get(key)")
        expect(nullable_prefix[0]).to_end_with("@always_inline\n")
