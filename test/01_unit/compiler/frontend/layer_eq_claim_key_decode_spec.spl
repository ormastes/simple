use std.spec.{describe, it, expect}
use compiler.frontend.layer_eq_registry.{layer_eq_claim_path, layer_eq_claim_view}

describe "layer equality claim key decoding":
    it "decodes canonical module and view fields":
        expect(layer_eq_claim_path("pkg/layout.spl|CardView")).to_equal("pkg/layout.spl")
        expect(layer_eq_claim_view("pkg/layout.spl|CardView")).to_equal("CardView")

    it "preserves empty and missing field behavior":
        expect(layer_eq_claim_path("")).to_equal("")
        expect(layer_eq_claim_view("")).to_equal("")
        expect(layer_eq_claim_path("module_only")).to_equal("module_only")
        expect(layer_eq_claim_view("module_only")).to_equal("")
        expect(layer_eq_claim_path("|View")).to_equal("")
        expect(layer_eq_claim_view("|View")).to_equal("View")
        expect(layer_eq_claim_view("module|")).to_equal("")

    it "returns only the second split field":
        expect(layer_eq_claim_path("module|View|ignored")).to_equal("module")
        expect(layer_eq_claim_view("module|View|ignored")).to_equal("View")
        expect(layer_eq_claim_view("module||ignored")).to_equal("")

    it "preserves multibyte path and view fields before trailing data":
        val key = "模块/布局.spl|卡片视图|ignored"
        expect(layer_eq_claim_path(key)).to_equal("模块/布局.spl")
        expect(layer_eq_claim_view(key)).to_equal("卡片视图")
