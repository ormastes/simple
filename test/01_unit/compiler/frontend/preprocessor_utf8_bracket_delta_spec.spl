use std.spec.*
use compiler.frontend.core.parser_preprocessor.{_pp_line_bracket_delta}

describe "preprocessor bracket scanning with UTF-8 declaration text":
    it "iterates code points instead of indexing beyond the character count":
        expect(_pp_line_bracket_delta("é(")).to_equal(1)
        expect(_pp_line_bracket_delta("界[")).to_equal(1)
        expect(_pp_line_bracket_delta("🙂}")).to_equal(-1)
        expect(_pp_line_bracket_delta("fn main() -> i64:")).to_equal(0)
