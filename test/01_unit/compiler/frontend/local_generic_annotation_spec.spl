# @req REQ-GENERIC-ANNOTATION-PRESERVE
# @tag: unit, compiler, frontend, generics
use std.spec
use compiler.core.parser.{parser_init, parser_parse_type}
use compiler.core.types.{TYPE_TEXT, TYPE_I64, named_type_register, named_generic_instance_index, named_generic_instance_base, named_generic_instance_arg_tags}

fn expect_annotation(tag: i64, base: text, arguments: [i64]):
    val index = named_generic_instance_index(tag)
    expect(index).to_be_greater_than(-1)
    expect(named_generic_instance_base(index)).to_equal(base)
    expect(named_generic_instance_arg_tags(index)).to_equal(arguments)

describe "local generic annotations retain base and argument types":
    it "preserves the arguments of an already registered local declaration":
        parser_init("Bag<text>")
        named_type_register("Bag", [], [])
        expect_annotation(parser_parse_type(), "Bag", [TYPE_TEXT])

    it "preserves a generic forward declaration for later HIR resolution":
        parser_init("Later<text>")
        expect_annotation(parser_parse_type(), "Later", [TYPE_TEXT])

    it "keeps two arguments in their written order":
        parser_init("Pair<text, i64>")
        named_type_register("Pair", [], [])
        expect_annotation(parser_parse_type(), "Pair", [TYPE_TEXT, TYPE_I64])

    it "retains nested generic instances without flattening to the outer base":
        parser_init("Bag<Bag<text>>")
        named_type_register("Bag", [], [])
        val outer = named_generic_instance_index(parser_parse_type())
        expect(outer).to_be_greater_than(-1)
        expect(named_generic_instance_base(outer)).to_equal("Bag")
        val arguments = named_generic_instance_arg_tags(outer)
        expect(arguments.len()).to_equal(1)
        expect_annotation(arguments[0], "Bag", [TYPE_TEXT])
