# Repro: the Stage 2 (pure-Simple) parser rejected four lib files during the
# compiler_cli_build row of the Stage 2 compiler tests
# (doc/08_tracking/bug/stage2_cli_build_noncanonical_lib_source_2026-11-17.md).
# Each file must parse with zero errors through compiler.core.parser.

use compiler.core.parser.{parse_module_silent_checked, parser_get_errors}
use compiler.core.parser.{parser_warnings_clear}
use std.io_runtime.{file_read}

# parse_module_silent_checked returns the failure flag by value; the
# parse_module + parser_has_errors pair can lose it across the module boundary.
fn parse_errors_of(path: text) -> text:
    parser_warnings_clear()
    if parse_module_silent_checked(file_read(path), path):
        val msgs = parser_get_errors().join("\n")
        return if msgs == "": "parse failed" else: msgs
    ""

describe "Stage 2 parser accepts the lib sources in the CLI closure":
    it "parses linux_fresh_epoch_population_v1 (try-then-tuple-field)":
        val path = "src/lib/nogc_sync_mut/io/linux_fresh_epoch_population_v1.spl"
        expect(parse_errors_of(path)).to_equal("")
        # `?.` lexes as optional chaining and then needs an identifier, so
        # `f()?.0` is rejected (expected Ident, got IntLit) by every parser
        # route. The documented try-then-access spelling is `(f()?).0`.
        expect(file_read(path).contains(")?.0")).to_equal(false)
        expect(file_read(path).contains(")?.1")).to_equal(false)

    it "parses host_runtime_exec_projection_v3 (multi-line if-expression else)":
        expect(parse_errors_of("src/lib/nogc_sync_mut/orchestration/host_runtime_exec_projection_v3.spl")).to_equal("")

    it "parses host_runtime_exec_no_begin_cancel_evidence_v3 (multi-line if-expression else)":
        expect(parse_errors_of("src/lib/nogc_sync_mut/orchestration/host_runtime_exec_no_begin_cancel_evidence_v3.spl")).to_equal("")
