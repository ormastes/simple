use std.spec.{describe, it, expect}
use compiler.frontend.desugar.placeholder_lambda.{placeholder_lambda_state_take, placeholder_lambda_state_install}

describe "PlaceholderLambdaState ParseContext snapshot":
    it "take installs fresh state and install restores the snapshot":
        val a = placeholder_lambda_state_take()
        val fresh = placeholder_lambda_state_take()
        expect(fresh._ph_pattern_node_marks.len()).to_equal(0)
        placeholder_lambda_state_install(a)
        val again = placeholder_lambda_state_take()
        expect(again._ph_pattern_node_marks.len()).to_equal(a._ph_pattern_node_marks.len())
        placeholder_lambda_state_install(again)
