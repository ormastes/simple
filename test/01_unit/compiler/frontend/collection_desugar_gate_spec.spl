"""
## Purpose and audience
Purpose: Prove that collection-desugar scalar-merge gate.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-COMPILER-FRONTEND-001 — stable requirement identity for this spec.

#!/usr/bin/env simple
# DES1 collection-desugar-type-gate (lane DES1).
#
# Bug: doc/08_tracking/bug/collection_desugar_scalar_merge_rewrite_2026-07-29.md
# `src/compiler/10.frontend/desugar/collection_desugar.spl`'s `try_rewrite_assign`
# (Pattern B) used to rewrite ANY `target = target + rhs` into
# `target.merge(rhs)` with no type gate at all -- including on plain scalars
# (`x = x + 1`) and text concatenation (`s = s + "a"`), because this pass runs
# at the AST level BEFORE type-checking and has no type oracle.
#
# The fix gates Pattern B (and the mirror branch in
# `try_rewrite_compound_assign`) on the addend's *syntactic shape*:
# int/float/bool literal, string/interpolated-string literal, unary, and
# binary-expression addends can only ever be scalar/text values under a
# type-checked program (there is no `+` overload pairing a bare literal or
# arithmetic sub-expression with a collection), so those shapes are excluded
# from the merge rewrite and left as plain Assign/CompoundAssign arithmetic.
# Identifier/field-access/index/call-result addends remain ambiguous without
# type info and still trigger the rewrite (real byte-array-concatenation code
# such as `test/01_unit/compiler/backend/linker/archive_parser_spec.spl`'s
# `a = a + d1` depends on it) -- that residual ambiguity is a separate,
# pre-existing, out-of-scope concern, not something this lane's fix invents a
# type oracle to resolve.
#
# HARNESS LANDMINE (same as param_mutability_semantic_spec.spl and
# iterator_invalidation_spec.spl's headers): the parse_full_frontend pipeline
# is inlined in every `it` block below rather than factored into a shared
# helper fn.

use std.spec
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.frontend.desugar.collection_desugar.{collection_desugar_rewrite_count}
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*

describe "collection-desugar scalar-merge gate":
    it "leaves x = x + 1 (i64 scalar) as plain Assign arithmetic, not a merge rewrite":
        step("Verify: leaves x = x + 1 (i64 scalar) as plain Assign arithmetic, not a merge rewrite")
        # @req: REQ-COMPILER-FRONTEND-001
        val src = "fn bump(x: i64) -> i64:\n" +
            "    x = x + 1\n" +
            "    x\n"
        val parsed = parse_full_frontend(src, "testdata/des1_scalar_int.spl", "des1_scalar_int", Logger(level: 0))
        expect(parsed.functions.contains("bump")).to_equal(true)
        # No collection-desugar rewrite should fire for a scalar-literal addend
        # -- this is the load-bearing assertion: rewrite_count()==0 here means
        # the AST node stayed Assign(Binary(+, x, 1)) instead of being promoted
        # to a MethodCall(x, "merge", [1]) (the exact shape from the bug's HIR
        # repro). A direct HIR-shape walk (`for _item in hir.functions: ...
        # _item[1].name`) was attempted here and dropped: the interpreter's
        # Dict<SymbolId,HirFunction> tuple-iteration raises "unknown property
        # or method 'name' on Tuple" independent of this fix -- a pre-existing,
        # out-of-scope interpreter/Dict-iteration defect, not a collection-desugar
        # regression (reported to the orchestrator).
        expect(collection_desugar_rewrite_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        var hir_lowering = HirLowering.with_filename("testdata/des1_scalar_int.spl")
        val hir = hir_lowering.lower_module(parsed)
        expect(hir.name).to_equal("testdata/des1_scalar_int.spl")

    it "leaves x = x + 1i64 (SUFFIXED scalar literal) as plain Assign arithmetic, not a merge rewrite":
        step("Verify: leaves x = x + 1i64 (SUFFIXED scalar literal) as plain Assign arithmetic, not a merge rewrite")
        # Bug: doc/08_tracking/bug/class_scalar_field_assignment_fails_native_mir_lowering_2026-08-10.md
        # `1i64` is tagged EXPR_SUFFIXED_LIT, a DISTINCT arena tag from
        # EXPR_INT_LIT. The gate originally listed only EXPR_INT_LIT, so a
        # suffixed addend fell through and Pattern B rewrote `x = x + 1i64`
        # into `x.merge(1i64)`. `merge` has no MIR lowering, so every
        # native/AOT build of such a program died with
        # `unresolved method call: merge` -- reproduced at origin with a
        # passing positive control, and proven to be about the SUFFIX (not
        # about classes or field assignment) by an A/B pair differing in one
        # character: `c.n = c.n + 1i64` failed to native-build, `c.n = c.n + 1`
        # built and linked fine.
        #
        # This asserts rewrite_count()==0, the same load-bearing signal the
        # sibling examples use. Its NEGATIVE CONTROL is the very next example
        # (`xs = xs + [2]` must still rewrite, count==1): without that control
        # a gate that suppressed EVERY rewrite would pass this example.
        val src = "fn bump(x: i64) -> i64:\n" +
            "    x = x + 1i64\n" +
            "    x\n"
        val parsed = parse_full_frontend(src, "testdata/des1_scalar_suffixed.spl", "des1_scalar_suffixed", Logger(level: 0))
        expect(parsed.functions.contains("bump")).to_equal(true)
        expect(collection_desugar_rewrite_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "still rewrites xs = xs + [2] (single-element array literal) into a push":
        step("Verify: still rewrites xs = xs + [2] (single-element array literal) into a push")
        val src = "fn append_one() -> [i64]:\n" +
            "    var xs = [1]\n" +
            "    xs = xs + [2]\n" +
            "    xs\n"
        val parsed = parse_full_frontend(src, "testdata/des1_list_lit.spl", "des1_list_lit", Logger(level: 0))
        expect(parsed.functions.contains("append_one")).to_equal(true)
        expect(collection_desugar_rewrite_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "leaves s = s + \"a\" (text concat) as plain Assign arithmetic, not a merge rewrite":
        val src = "fn cat(s: text) -> text:\n" +
            "    s = s + \"a\"\n" +
            "    s\n"
        val parsed = parse_full_frontend(src, "testdata/des1_scalar_str.spl", "des1_scalar_str", Logger(level: 0))
        expect(parsed.functions.contains("cat")).to_equal(true)
        # Bare string-literal addend: same rationale as the int-literal case
        # above -- there is no `text.merge("literal")` single-item form, so
        # this must not be rewritten either.
        expect(collection_desugar_rewrite_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
