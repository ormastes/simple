"""
Regression coverage for signed decimal mantissas in the frontend float parser.
"""

use compiler.frontend.parser_types_utils.{parse_float_literal}
use std.spec.step

describe "Frontend float literal utility preserves a negative mantissa":
    it "applies the sign to both integer and fractional digits":
        step("Parse a negative decimal with a nonzero integer component")
        expect(parse_float_literal("-1.5")).to_equal(-1.5)

    it "preserves the sign when the integer component is zero":
        step("Parse a negative decimal whose integer component is negative zero")
        expect(parse_float_literal("-0.25")).to_equal(-0.25)

    it "scales the complete signed mantissa for scientific notation":
        step("Parse a negative decimal mantissa followed by an exponent")
        expect(parse_float_literal("-1.25e2")).to_equal(-125.0)

    it "keeps positive signed decimal parsing unchanged":
        step("Parse an explicitly positive decimal mantissa")
        expect(parse_float_literal("+1.5")).to_equal(1.5)
