use std.spec.{describe, it, expect}
use compiler.frontend.core.parser_preprocessor.{preprocessor_state_take, preprocessor_state_install}

describe "PreprocessorState ParseContext snapshot":
    it "take installs fresh state and install restores the snapshot":
        val a = preprocessor_state_take()
        val fresh = preprocessor_state_take()
        expect(fresh._pp_tokens.len()).to_equal(0)
        preprocessor_state_install(a)
        val again = preprocessor_state_take()
        expect(again._pp_tokens.len()).to_equal(a._pp_tokens.len())
        preprocessor_state_install(again)
