# @req REQ-SSPEC-UNIT
"""
# No-GC pointer sigils in the self-hosted frontend, HIR and type inference

**Design:** doc/05_design/language/misc/memory.md (`&T` unique owner, `*T`
shared Rc owner, `-T` weak observer, `new(&)` / `new(*)` constructors with
`new&` / `new*` sugar).

Before this lane the pure-Simple parser read `&T` as a borrow
(`TypeKind.Reference`) and `*T` as a raw pointer (`TypeKind.Pointer`, the same
node as `*const T`), and `new& X` / `new(&) X` silently became `nil` in the
flat-AST bridge. The ownership meaning only takes effect in the opt-in strict
mode (`@no_gc(strict)` or `SIMPLE_NOGC_STRICT=1`). In default mode the HIR is
exactly what it was before (`Ref` / `Ptr` / `Infer`), so the bootstrap closure
is unaffected.

The sigils are fed as source STRINGS: `bin/simple test` runs this file on the
Rust seed, whose parser reads the spec's own syntax, so the spec cannot write
the sigils as its own types.
"""

use std.spec.*
use compiler.common.diagnostics.span.{Span}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.parser_types.{ParserModule}
use compiler.frontend.parser_types_expr.{parser_type_kind_ownership_name, parser_expr_new_kind_name}
use compiler.hir.hir_types.*
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.context_helpers.*
use compiler.hir.hir_lowering.items.*
use compiler.types.type_infer.context.*
use compiler.types.type_infer.core.*

val SIGIL_SRC: text = "class Node:\n    v: i64\nfn f(a: &Node, b: *Node, c: -Node, d: *const Node, e: *mut Node, g: &mut Node) -> i64:\n    0\n"

fn param_kinds(module: ParserModule, fn_name: text) -> [text]:
    var kinds: [text] = []
    for p in module.functions[fn_name].params:
        kinds.push(parser_type_kind_ownership_name(p.type_.kind))
    kinds

fn lowered_kinds(source: text, path: text, strict: bool) -> [text]:
    val module = parse_and_build_module(source, path)
    var lowering = HirLowering.with_filename(path)
    lowering.use_explicit_semantic_policy()
    lowering.declare_module_symbols(module)
    lowering.nogc_strict = strict
    var kinds: [text] = []
    for p in module.functions["f"].params:
        kinds.push(hir_type_kind_ownership_name(lowering.lower_type(p.type_).kind))
    kinds

fn const_new_kind(source: text, name: text) -> text:
    val module = parse_and_build_module(source, "nogc_new_spec.spl")
    parser_expr_new_kind_name(module.constants[name].value)

fn hir(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: Span(0, 0, 0, 0, "", 0))

fn i64_ty() -> HirType:
    hir(HirTypeKind.Int(64, true))

describe "self-hosted parser keeps memory.md sigil meaning":
    it "parses &T as unique, *T as shared, -T as weak, and *const/*mut as raw":
        val module = parse_and_build_module(SIGIL_SRC, "nogc_sigil_spec.spl")
        expect(param_kinds(module, "f")).to_equal(["unique", "shared", "weak", "raw_const", "raw_mut", "borrow_mut"])

    it "parses canonical new(&)/new(*) and new&/new* sugar to the same kinds":
        val src = "class Node:\n    v: i64\nval a = new(&) Node(v: 1)\nval b = new& Node(v: 1)\nval c = new(*) Node(v: 1)\nval d = new* Node(v: 1)\nval e = new Node(v: 1)\n"
        expect(const_new_kind(src, "a")).to_equal("unique")
        expect(const_new_kind(src, "b")).to_equal("unique")
        expect(const_new_kind(src, "c")).to_equal("shared")
        expect(const_new_kind(src, "d")).to_equal("shared")
        expect(const_new_kind(src, "e")).to_equal("default")

describe "opt-in strict mode is a module fact":
    it "sets ParserModule.nogc_strict only for @no_gc(strict)":
        expect(parse_and_build_module("@no_gc(strict)\nfn f() -> i64:\n    0\n", "strict_mod.spl").nogc_strict).to_equal(true)
        expect(parse_and_build_module("@no_gc\nfn f() -> i64:\n    0\n", "plain_mod.spl").nogc_strict).to_equal(false)
        expect(parse_and_build_module("fn f() -> i64:\n    0\n", "strict_mod.spl").nogc_strict).to_equal(false)

describe "HIR lowering of sigils":
    it "keeps the legacy HIR in default mode":
        expect(lowered_kinds(SIGIL_SRC, "nogc_hir_default.spl", false)).to_equal(["ref", "ptr", "infer", "ptr", "ptr_mut", "ref_mut"])

    it "lowers to distinct ownership kinds in strict mode":
        expect(lowered_kinds(SIGIL_SRC, "nogc_hir_strict.spl", true)).to_equal(["unique", "shared", "weak", "ptr", "ptr_mut", "ref_mut"])

describe "type inference keeps the kinds distinct":
    it "unifies same kinds and rejects cross kinds":
        var ctx = HmInferContext.new()
        val u = hir(HirTypeKind.Unique(i64_ty()))
        val s = hir(HirTypeKind.Shared(i64_ty()))
        val w = hir(HirTypeKind.Weak(i64_ty()))
        expect(ctx.unify(u, hir(HirTypeKind.Unique(i64_ty()))).is_ok()).to_equal(true)
        expect(ctx.unify(s, hir(HirTypeKind.Shared(i64_ty()))).is_ok()).to_equal(true)
        expect(ctx.unify(w, hir(HirTypeKind.Weak(i64_ty()))).is_ok()).to_equal(true)
        expect(ctx.unify(u, s).is_ok()).to_equal(false)
        expect(ctx.unify(s, u).is_ok()).to_equal(false)
        expect(ctx.unify(w, s).is_ok()).to_equal(false)
        expect(ctx.unify(u, hir(HirTypeKind.Ref(i64_ty(), false))).is_ok()).to_equal(false)
