# @feature mcdc_hal_runtime_hardening
# @req REQ-009 REQ-010

use std.spec.*
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.common.attributes.{parse_function_attrs}

describe "@rt(hal) frontend retention":
    it "retains and lowers the tag while leaving its neighbor untagged":
        val source = "@rt(hal, operation:io.read.v1, providers:pure+c+rust, comparator:11, normalizer:12)\n" +
            "fn tagged(value: i64) -> i64:\n    value\n" +
            "fn plain(value: i64) -> i64:\n    value\n"
        val module = parse_and_build_module(source, "rt_hal_attribute_retention.spl")
        val tagged = module.functions["tagged"]
        val plain = module.functions["plain"]
        val tagged_attr = parse_function_attrs(tagged.attributes)
        val plain_attr = parse_function_attrs(plain.attributes)
        expect(tagged_attr.has_rt_hal).to_be(true)
        expect(tagged_attr.rt_hal_assurance_rank).to_equal(3)
        expect(tagged_attr.is_no_alloc).to_be(true)
        expect(tagged_attr.rt_hal_manifest).to_contain("operation=io.read.v1")
        expect(plain_attr.has_rt_hal).to_be(false)
        expect(plain_attr.rt_hal_manifest).to_equal("")
