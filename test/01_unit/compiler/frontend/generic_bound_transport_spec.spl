# @req REQ-GENERIC-BOUND-TRANSPORT
use std.spec.{describe, it, expect, step, fail}
use compiler.common.config.Logger
use compiler.frontend.frontend.parse_full_frontend
use compiler.frontend.parser_types.{ParserModule, Type, TypeKind}
use compiler.core.parser.{parser_has_errors, parser_get_errors}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module_scoped,
    flat_pool_capture_arm, flat_pool_capture_take, flat_pools_dump_all,
    build_module_from_flat_pool_blob}
use compiler.core.ast.{module_decl_count_get, module_decl_at, decl_get_name,
    decl_set_type_param_constraints}
use compiler.hir.hir_lowering.types.HirLowering
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_types.{HirModule, HirTypeKind}
use compiler.hir.hir_definitions.HirFunction

fn bound_transport_parse(source: text) -> ParserModule:
    val parsed = parse_full_frontend(source, "bound_transport.spl", "bound_transport", Logger(level: 0))
    expect(parser_has_errors()).to_be(false)
    parsed

fn bound_transport_named(type_: Type, name: text, arity: i64):
    match type_.kind:
        case TypeKind.Named(actual, args):
            expect(actual).to_equal(name)
            expect(args.len()).to_equal(arity)
        case _: fail("expected structured Named trait bound")

fn bound_transport_function(module: HirModule, name: text) -> HirFunction:
    for function in module.functions.values():
        if function.name == name: return function
    fail("missing lowered function " + name)
    nil

describe "canonical generic bound transport":
    it "retains inline and where constraints on their declared binder":
        step("Parse two parameters with inline plus where conjunctions")
        val parsed = bound_transport_parse("fn choose<T, U: First>(a: T, b: U) -> U where U: Second + Third:\n    b\n")
        expect(parsed.functions.contains_key("choose")).to_be(true)
        val params = parsed.functions["choose"].type_params
        expect(params.len()).to_equal(2)
        expect(params[0].name).to_equal("T")
        expect(params[0].bounds.len()).to_equal(0)
        expect(params[1].name).to_equal("U")
        expect(params[1].bounds.len()).to_equal(3)
        bound_transport_named(params[1].bounds[0], "First", 0)
        bound_transport_named(params[1].bounds[1], "Second", 0)
        bound_transport_named(params[1].bounds[2], "Third", 0)
        expect(params[0].has_default).to_be(false)
        expect(params[1].has_default).to_be(false)

    it "preserves structured trait arguments without spelling flattening":
        step("Use the canonical type parser on retained where bound source")
        val parsed = bound_transport_parse("fn carry<T, U>(a: T, b: U) -> U where U: Carrier<T>:\n    b\n")
        val bound = parsed.functions["carry"].type_params[1].bounds[0]
        bound_transport_named(bound, "Carrier", 1)
        match bound.kind:
            case TypeKind.Named(_, args): bound_transport_named(args[0], "T", 0)
            case _: fail("missing structured trait argument")

    it "does not leak inline bounds between declarations sharing T":
        step("Keep each parsed constraint row declaration local")
        val parsed = bound_transport_parse("fn bounded<T: First>(x: T) -> T:\n    x\nfn plain<T>(x: T) -> T:\n    x\n")
        expect(parsed.functions["bounded"].type_params[0].bounds.len()).to_equal(1)
        expect(parsed.functions["plain"].type_params[0].bounds.len()).to_equal(0)

    it "does not reinterpret hardware candidate and limit lists as traits":
        step("Preserve existing hardware grammar and exclude those rows from trait conjunctions")
        val parsed = bound_transport_parse("fn hw<T candidates [i64, *], U limits [i64], V: [i64]>(x: T) -> T:\n    x\n")
        val params = parsed.functions["hw"].type_params
        expect(params.len()).to_equal(3)
        for parameter in params: expect(parameter.bounds.len()).to_equal(0)

    it "lowers actual source bounds to the declared same-module trait symbol":
        step("Run the public frontend and actual HIR lowering without injected bounds")
        val parsed = bound_transport_parse("trait Marked:\n    fn mark(self) -> i64:\n        1\nfn choose<T, U: Marked>(a: T, b: U) -> U:\n    b\n")
        var lowering = HirLowering.with_filename("bound_transport.spl")
        val module = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_equal(0)
        val function = bound_transport_function(module, "choose")
        expect(function.type_params[0].bounds.len()).to_equal(0)
        expect(function.type_params[1].bounds.len()).to_equal(1)
        var found_trait = false
        match function.type_params[1].bounds[0].kind:
            case HirTypeKind.Named(id, args):
                expect(args.len()).to_equal(0)
                for trait_ in module.traits.values():
                    if trait_.name == "Marked":
                        expect(id).to_equal(trait_.symbol)
                        found_trait = true
            case _: fail("bound lost its HIR trait identity")
        expect(found_trait).to_be(true)
        expect(function.type_params[0].symbol == function.type_params[1].symbol).to_be(false)

    it "reports malformed and undeclared where subjects through the parser":
        step("Reject malformed fragments instead of silently dropping them")
        val malformed = parse_full_frontend("fn f<T>(x: T) -> T where T: Marked garbage:\n    x\n", "bad_bound.spl", "bad_bound", Logger(level: 0))
        expect(parser_has_errors()).to_be(true)
        expect(parser_get_errors().len()).to_be_greater_than(0)
        val unknown = parse_full_frontend("fn f<T>(x: T) -> T where U: Marked:\n    x\n", "bad_subject.spl", "bad_subject", Logger(level: 0))
        expect(parser_has_errors()).to_be(true)
        expect(parser_get_errors().join("\n")).to_contain("not a declared type parameter")

    it "reports an unknown trait at HIR lowering rather than accepting an unbounded function":
        step("Retain unknown names so the real type resolver diagnoses them")
        val parsed = bound_transport_parse("fn f<T: MissingTrait>(x: T) -> T:\n    x\n")
        var lowering = HirLowering.with_filename("bound_transport.spl")
        val module = lowering.lower_module(parsed)
        expect(lowering.errors.len()).to_be_greater_than(0)

    it "does not publish a cold flat capture rejected during bound conversion":
        step("Exercise actual capture arm, parser, bridge validation and capture take")
        flat_pool_capture_arm()
        val parsed = parse_and_build_module_scoped(
            "fn f<T>(x: T) -> T where T: Marked garbage:\n    x\n",
            "invalid_cold_bound.spl", false)
        expect(parser_has_errors()).to_be(true)
        expect(parser_get_errors().join("\n")).to_contain("invalid generic trait bound")
        expect(flat_pool_capture_take()).to_equal("")

    it "restores captured structured and inline bounds after unrelated pool reuse":
        step("Preserve binder rows and Named argument nodes through the actual cache API")
        val source = "fn f<T, U: First>(x: T, y: U) -> U where U: Carrier<T>:\n    y\n"
        flat_pool_capture_arm()
        val original = parse_and_build_module_scoped(source, "bound_cache.spl", false)
        expect(parser_has_errors()).to_be(false)
        val blob = flat_pool_capture_take()
        expect(blob.len()).to_be_greater_than(0)
        val replacement = parse_and_build_module_scoped("fn other() -> i64:\n    9\n", "other.spl", false)
        val restored = build_module_from_flat_pool_blob(blob, source, "bound_cache.spl")
        expect(restored.is_some()).to_be(true)
        expect(parser_has_errors()).to_be(false)
        val params = restored.unwrap().functions["f"].type_params
        expect(params.len()).to_equal(2)
        expect(params[0].name).to_equal("T")
        expect(params[0].bounds.len()).to_equal(0)
        expect(params[1].name).to_equal("U")
        expect(params[1].bounds.len()).to_equal(2)
        bound_transport_named(params[1].bounds[0], "First", 0)
        bound_transport_named(params[1].bounds[1], "Carrier", 1)
        match params[1].bounds[1].kind:
            case TypeKind.Named(_, args): bound_transport_named(args[0], "T", 0)
            case _: fail("cache lost the structured trait argument")

    it "refuses a restored flat pool whose retained bound fragment is malformed":
        step("Mutate the real flat declaration constraint API then serialize it normally")
        val source = "fn f<T: Marked>(x: T) -> T:\n    x\n"
        val original = parse_and_build_module_scoped(source, "bad_bound_cache.spl", false)
        expect(parser_has_errors()).to_be(false)
        var changed = false
        for i in 0..module_decl_count_get():
            val declaration = module_decl_at(i)
            if decl_get_name(declaration) == "f":
                decl_set_type_param_constraints(declaration, [["Marked garbage"]])
                changed = true
        expect(changed).to_be(true)
        expect(parser_has_errors()).to_be(false)
        val blob = flat_pools_dump_all()
        expect(blob.len()).to_be_greater_than(0)
        val restored = build_module_from_flat_pool_blob(blob, source, "bad_bound_cache.spl")
        expect(restored.is_some()).to_be(false)
        expect(parser_has_errors()).to_be(true)
        expect(parser_get_errors().join("\n")).to_contain("invalid generic trait bound")
