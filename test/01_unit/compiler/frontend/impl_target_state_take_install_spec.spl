use std.spec.{describe, it, expect}
use compiler.frontend.core.parser_decls_use.{impl_target_state_take, impl_target_state_install}

describe "ImplTargetState ParseContext snapshot":
    it "take installs fresh state and install restores the snapshot":
        val a = impl_target_state_take()
        val fresh = impl_target_state_take()
        expect(fresh.par_impl_target_arg_names.len()).to_equal(0)
        impl_target_state_install(a)
        val again = impl_target_state_take()
        expect(again.par_impl_target_arg_names.len()).to_equal(a.par_impl_target_arg_names.len())
        impl_target_state_install(again)
