use std.spec.{describe, it, expect}
use compiler.frontend._FlatAstBridge.module_assembly.{fab_capture_state_take, fab_capture_state_install}

describe "FabCaptureState ParseContext snapshot (stage 1)":
    it "take disarms capture and install restores the snapshot":
        val a = fab_capture_state_take()
        val fresh = fab_capture_state_take()
        expect(fresh._fab_capture_pools).to_equal(0)
        expect(fresh._fab_captured_blob).to_equal("")
        expect(fresh._fab_captured_paths.len()).to_equal(0)
        fab_capture_state_install(a)
        val again = fab_capture_state_take()
        expect(again._fab_capture_arm_tag).to_equal(a._fab_capture_arm_tag)
        fab_capture_state_install(again)
