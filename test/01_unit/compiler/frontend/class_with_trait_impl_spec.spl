# `class X with Trait:` records a trait-implementation CANDIDATE on the
# class's synthesized impl block (one `with` name only), so HIR can decide
# trait conformance where the trait declaration is known. Two or more names
# keep the old behaviour (no candidate): one object has one vtable header.
# doc/08_tracking/bug/trait_receiver_cross_unit_bare_call_stubbed_2026-10-20.md
#
# @cover src/compiler/10.frontend/core/_ParserDecls/fn_struct_decls.spl
# @cover src/compiler/10.frontend/_FlatAstBridge/module_assembly.spl
use std.spec.*
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.frontend.parser_types_expr.{parser_type_kind_named_name}

fn with_impl_row(source: text, owner: text) -> text:
    """`<candidate>|<has_trait>|<trait name>` of the impl synthesized for `owner`."""
    val module = parse_and_build_module(source, "class_with_trait_probe.spl")
    for impl_ in module.impls:
        if parser_type_kind_named_name(impl_.type_.kind) == owner:
            return "{impl_.with_trait_candidate}|{impl_.has_trait_}|{parser_type_kind_named_name(impl_.trait_.kind)}"
    "missing"

val TRAIT_SRC = "trait Ident:\n    fn identity() -> text\n\ntrait Other:\n    fn other() -> text\n\n"

describe "class with Trait parser record":
    it "records a single with-name as a trait candidate on the class impl":
        val row = with_impl_row(TRAIT_SRC + "class Alpha with Ident:\n    tag: text\n    fn identity() -> text: self.tag\n", "Alpha")
        expect(row).to_equal("true|false|Ident")

    it "keeps two with-names as no candidate":
        val row = with_impl_row(TRAIT_SRC + "class Both with Ident, Other:\n    tag: text\n    fn identity() -> text: self.tag\n    fn other() -> text: self.tag\n", "Both")
        expect(row).to_equal("false|false|")

    it "leaves a class without with unchanged":
        val row = with_impl_row(TRAIT_SRC + "class Plain:\n    tag: text\n    fn identity() -> text: self.tag\n", "Plain")
        expect(row).to_equal("false|false|")

    it "drops the candidate when an explicit impl Trait for block exists":
        val row = with_impl_row(TRAIT_SRC + "class Delta with Ident:\n    tag: text\n    fn helper() -> text: self.tag\n\nimpl Ident for Delta:\n    fn identity() -> text: self.tag\n", "Delta")
        expect(row).to_equal("false|false|Ident")

    it "keeps an explicit impl Trait for block a real trait impl":
        val row = with_impl_row(TRAIT_SRC + "class Gamma:\n    tag: text\n\nimpl Ident for Gamma:\n    fn identity() -> text: self.tag\n", "Gamma")
        expect(row).to_equal("false|true|Ident")
