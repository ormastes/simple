use std.io.{file_read}

describe "module state CoreDecl constructor boundary":
    it "imports make_core_decl from its concrete owner":
        val source = file_read("src/compiler/10.frontend/core/_Ast/module_state.spl")
        val owner = file_read("src/compiler/10.frontend/core/ast_types.spl")

        expect(source).to_contain("use compiler.core.ast_types.{CoreExpr, CoreStmt, CoreDecl, make_core_decl}")
        expect(source).to_contain("return make_core_decl(0, -1)")
        expect(owner).to_contain("export make_core_decl")
