# @req REQ-NOGC-FOREIGN-001
"""Ownership sigils cannot acquire checked meaning by crossing an import.

The declaring physical surface owns its strictness; an alias preserves it.
Default importers retain their legacy types. Strict importers reject legacy
or missing ownership contracts before they can authorize a drop.
"""

use std.spec.*
use compiler.common.driver_core_types.{SourceFile}
use compiler.frontend.flat_ast_bridge.{parse_and_build_module}
use compiler.hir.hir_types.*
use compiler.hir.hir_lowering.types.{HirLowering}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{module_surface_from_owner, ModuleSurfaceParserOwner}
use test.helpers.module_surface_owner_fixture.{module_surfaces_from_test_modules}

val CONTRACT_SOURCE = "pub fn take(a: &i64, b: *i64, c: -i64) -> i64:\n    0\n"

fn import_kinds(owner_strict: bool, importer_strict: bool, alias: text) -> [text]:
    var module = parse_and_build_module(CONTRACT_SOURCE, "provider.spl")
    module.nogc_strict = owner_strict
    val sources = [SourceFile(path: "provider.spl", content: CONTRACT_SOURCE, module_name: "provider")]
    val registry = module_surfaces_from_test_modules({"provider": module, "renamed": module}, sources).unwrap()
    var lowering = HirLowering.with_filename("consumer.spl")
    lowering.module_surfaces = registry
    lowering.nogc_strict = importer_strict
    var out: [text] = []
    for p in module.functions["take"].params:
        val lowered: HirType = lowering.imported_surface_type(p.type_, alias)
        match lowered.kind:
            case HirTypeKind.Error: out.push("error")
            case _: out.push(hir_type_kind_ownership_name(lowered.kind))
    if lowering.errors.len() > 0: out.push("diagnostic")
    out

describe "declaring-module ownership contracts":
    it "rejects all legacy sigils in a strict importer":
        expect(import_kinds(false, true, "provider")).to_equal(["error", "error", "error", "diagnostic"])

    it "cannot launder a legacy contract through an alias":
        expect(import_kinds(false, true, "renamed")).to_equal(["error", "error", "error", "diagnostic"])

    it "retains checked kinds through a strict provider alias":
        expect(import_kinds(true, true, "renamed")).to_equal(["unique", "shared", "weak"])

    it "rejects an unavailable declaring-module contract":
        expect(import_kinds(true, true, "missing")).to_equal(["error", "error", "error", "diagnostic"])

    it "preserves default-mode lowering for both provider modes":
        expect(import_kinds(false, false, "provider")).to_equal(["ref", "ptr", "infer"])
        expect(import_kinds(true, false, "provider")).to_equal(["ref", "ptr", "infer"])

    it "binds the module mode into its semantic surface identity":
        var parsed = parse_and_build_module(CONTRACT_SOURCE, "provider.spl")
        val source = SourceFile(path: "provider.spl", content: CONTRACT_SOURCE, module_name: "provider")
        val legacy = module_surface_from_owner(ModuleSurfaceParserOwner.new(parsed), source, 0).unwrap()
        parsed.nogc_strict = true
        val checked = module_surface_from_owner(ModuleSurfaceParserOwner.new(parsed), source, 0).unwrap()
        expect(legacy.nogc_strict).to_equal(false)
        expect(checked.nogc_strict).to_equal(true)
        expect([legacy.semantic_hash0, legacy.semantic_hash1, legacy.semantic_hash2, legacy.semantic_hash3] == [checked.semantic_hash0, checked.semantic_hash1, checked.semantic_hash2, checked.semantic_hash3]).to_equal(false)
