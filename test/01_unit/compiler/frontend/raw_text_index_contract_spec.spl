"""
## Purpose
Keep the compiler's text index helper on the raw byte-offset runtime contract,
including CURRENT records whose first line selects an immutable SCV inventory.
"""

use compiler.frontend.core.types.{str_index_of}
use std.spec.step

describe "compiler raw text index contract":
    it "returns a byte offset and minus one for absent text":
        step("Check first occurrence, absence, and empty needle")
        expect(str_index_of("ababa", "ba")).to_equal(1)
        expect(str_index_of("ababa", "missing")).to_equal(-1)
        expect(str_index_of("ababa", "")).to_equal(0)
        expect(str_index_of("", "")).to_equal(0)
        expect(str_index_of("", "x")).to_equal(-1)

    it "uses UTF8 byte offsets for slicing":
        step("Keep the offset aligned with the text slice boundary")
        val value = "π.a"
        val offset = str_index_of(value, "a")
        expect(offset).to_equal(3)
        expect(value[:offset]).to_equal("π.")

    it "extracts the exact digest from a combined CURRENT record":
        step("Use the real cursor schema and normal compact slice syntax")
        val digest = "34eb407387e2a73ede4b4f43ef41e126689ead2142a5f2e030393e8e02aaa349"
        val current = "{digest}\nsimple-compile-event-cursor-v3\ninventory_generation=1"
        val separator = str_index_of(current, "\n")
        expect(separator).to_equal(64)
        expect(current[:separator]).to_equal(digest)
        expect(str_index_of(digest, "\n")).to_equal(-1)
