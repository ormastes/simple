"""
## Purpose and audience
Purpose: Prove that the parse-cache hit validation mode checks text handles
without serializing pools.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
# @manual: primary
REQ-COMPILER-FRONTEND-001
"""
# @req: REQ-COMPILER-FRONTEND-001

use std.spec
use compiler.frontend.core.flat_pool_codec.*

describe "flat pool validate-texts mode":
    it "skips non-text serialization and keeps valid texts unpoisoned":
        flat_pool_validate_texts_arm_v1()
        val ints = flat_pool_enc_i64([1, 2, 3])
        val bools = flat_pool_enc_bool([true, false])
        val texts = flat_pool_enc_text(["a\nb", "", "c"])
        val poisoned = flat_pool_capture_poisoned_v1()
        flat_pool_validate_texts_disarm_v1()
        expect(ints).to_equal("")
        expect(bools).to_equal("")
        expect(texts).to_equal("")
        expect(poisoned).to_equal(false)

    it "restores normal encoding after disarm":
        flat_pool_validate_texts_arm_v1()
        flat_pool_validate_texts_disarm_v1()
        val r = FlatPoolReader.new(flat_pool_enc_i64([4, 5]))
        expect(flat_pool_dec_i64(r)).to_equal([4, 5])
