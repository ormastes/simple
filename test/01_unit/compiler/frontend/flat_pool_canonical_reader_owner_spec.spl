# @req REQ-CANONICAL-READER-STATIC-FACTORY-OWNER
# Proposal only: native execution is UNRUN; imports the actual production owner.
use std.spec.{describe, it, expect}
use compiler.frontend.core.flat_pool_codec.{FlatPoolReader}

describe "canonical reader static factory owner":
    it "returns the canonical cursor with the original scalar defaults":
        var reader: FlatPoolReader = FlatPoolReader.new_canonical("1\n31\n")
        expect(reader.ok).to_be(true)
        expect(reader.canonical).to_be(true)
        expect(reader.bounded).to_be(false)
        expect(reader.pos).to_equal(0)
        expect(reader.failure_kind).to_equal("")
        expect(reader.failure_detail).to_equal("")
        expect(reader.live_reserved_bytes).to_equal(0)

    it "invokes malformed rejection instead of silently losing the method":
        var reader: FlatPoolReader = FlatPoolReader.new_canonical("1\n31")
        expect(reader.ok).to_be(false)
        expect(reader.canonical).to_be(true)
        expect(reader.failure_kind).to_equal("malformed")
        expect(reader.failure_detail).to_equal("missing_final_newline")
        expect(reader.pos).to_equal(0)

    it "keeps a subsequent valid cursor independent of the rejected cursor":
        var rejected: FlatPoolReader = FlatPoolReader.new_canonical("bad")
        var fresh: FlatPoolReader = FlatPoolReader.new_canonical("0\n")
        expect(rejected.ok).to_be(false)
        expect(rejected.failure_detail).to_equal("missing_final_newline")
        expect(fresh.ok).to_be(true)
        expect(fresh.failure_kind).to_equal("")
        expect(fresh.canonical).to_be(true)
