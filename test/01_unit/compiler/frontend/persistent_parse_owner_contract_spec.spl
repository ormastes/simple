# Refreshed for the ParseContext stage-3 refactor 27f5d4149a2 ("context-owned
# parser state"): parser_prepare_persistent_globals / parser_persistent_globals_ready
# / parser_release_parse_globals and the frontend_parse_ownership.spl registry
# facade were deleted. The persistent-owner contract is now:
#   parser.spl   — par_state: ParserState with O(1) parser_state_take/install
#                  swaps plus parser_promote_transient_owners() (heap promote
#                  of the token-slot owners and public diagnostics);
#   lexer.spl    — nil-guarded one-element slot arrays, whole-owner replacement
#                  per file, lexer_release_parse_source_globals() teardown;
#   module_state — ast_prepare_persistent_owner_v1() one-shot latch;
#   80.driver    — driver_promote_retained_frontend_owners_v1 /
#                  driver_end_transient_parse_scope in driver_source_parse_support.spl,
#                  per-registry *_promote_transient_owner() retained-graph promotion
#                  replacing the remove(key) rollback rows.
# Every pin below asserts the current contract; no assertion was weakened.

use test.helpers.compiler_source_parse_owners.{source_parse_implementation_v1}
use std.io.{file_read}
use std.spec.{describe, it, expect}
use compiler.frontend.core.parser.{parser_state_take, parser_state_install, parser_set_had_error, parser_has_errors}

fn function_body(source: text, start_marker: text, next_marker: text) -> text:
    val start = source.index_of(start_marker)
    if start < 0:
        return ""
    val tail = source.substring(start, source.len())
    val next = tail.index_of(next_marker)
    if next < 0:
        return tail
    tail.substring(0, next)

describe "persistent frontend parse ownership contract":
    it "swaps lexer and parser owners with no per-field copy list":
        val lexer = file_read("src/compiler/10.frontend/core/lexer.spl")
        val parser = file_read("src/compiler/10.frontend/core/parser.spl")
        val lexer_release = function_body(
            lexer,
            "pub fn lexer_release_parse_source_globals():",
            "fn lex_cur_kind_get_slot")
        val parser_promote = function_body(
            parser,
            "pub fn parser_promote_transient_owners() -> bool:",
            "# Perf: cache SIMPLE_BOOTSTRAP_PAR_ENV_SAVE")

        # Lexer: durable state lives behind nil-guarded one-element slot
        # arrays; each file installs a whole fresh CoreLexer owner and release
        # drops every slot that retains the parsed source.
        expect(lexer).to_contain("var current_core_lexer_slot: [CoreLexer] = []")
        expect(lexer).to_contain("if current_core_lexer_slot.len() == 0:")
        expect(lexer).to_contain("current_core_lexer_slot = [make_core_lexer(core_source)]")
        expect(lexer_release).to_contain("current_core_lexer_slot = []")
        expect(lexer_release).to_contain("lex_inline_source_slot = [\"\"]")
        expect(lexer_release).to_contain("lex_source_codes = []")
        expect(lexer_release).to_contain("lex_source_char_count_slot = [0]")
        expect(lexer_release).to_contain("lex_source_code_base_slot = [0]")

        # Parser: the per-parse scratch lives on the context-owned par_state
        # struct (27f5d4149a2); take/install are O(1) whole-state swaps, and
        # parser_promote_transient_owners keeps the token-slot owners and
        # public diagnostics alive across the transient scope.
        expect(parser).to_contain("pub struct ParserState:")
        expect(parser).to_contain("var par_state: ParserState = parser_state_fresh()")
        expect(parser).to_contain("pub fn parser_state_take() -> ParserState:")
        expect(parser).to_contain("pub fn parser_state_install(s: ParserState):")
        expect(parser_promote).to_contain("rt_transient_heap_promote(par_state.par_kind_slot)")
        expect(parser_promote).to_contain("rt_transient_heap_promote(par_state.par_errors)")
        expect(parser_promote).to_contain("decl_pools_promote_transient_owners()")
        # The deleted prepare/ready/release globals stay deleted (fail closed).
        expect(parser).to_not_contain("parser_prepare_persistent_globals")
        expect(parser).to_not_contain("par_persistent_prepared_slot")

    it "keeps prepared state after empty parser scratch is released":
        # 27f5d4149a2 replaced prepare/ready/release with take/install: take()
        # hands the durable owner out and installs a fresh scratch context, so
        # releasing that scratch must not disturb the taken owner.
        parser_set_had_error(true)
        val kept = parser_state_take()
        expect(kept.par_had_error).to_equal(true)
        # The freshly installed scratch reports clean.
        expect(parser_has_errors()).to_equal(false)
        expect(kept.par_errors.len()).to_equal(0)
        # Releasing the empty scratch (take and discard) keeps the owner intact.
        val discarded = parser_state_take()
        expect(discarded.par_had_error).to_equal(false)
        expect(kept.par_had_error).to_equal(true)
        parser_state_install(kept)
        expect(parser_has_errors()).to_equal(true)
        parser_set_had_error(false)
        parser_state_install(discarded)

    it "prepares AST sentinels and clears every declaration-parallel row":
        val decls = file_read("src/compiler/10.frontend/core/_Ast/decl_nodes.spl")
        val state = file_read("src/compiler/10.frontend/core/_Ast/module_state.spl")
        val core_exports = file_read("src/compiler/10.frontend/core/__init__.spl")

        expect(decls).to_contain("if decl_empty_i64 == nil:")
        expect(decls).to_contain("if decl_empty_text == nil:")
        expect(decls).to_contain("if decl_empty_text_lists == nil:")
        # decl_param_default_text moved from module_state.spl into decl_nodes.spl.
        expect(decls).to_contain("if decl_param_default_text == nil:")
        expect(decls).to_contain("decl_param_default_text.clear()")
        # One-shot owner-prep latch replaces ast_decl_prepare_persistent_globals.
        expect(state).to_contain("fn ast_prepare_persistent_owner_v1():")
        expect(state).to_contain("if not ast_persistent_owner_prepared_v1:")
        expect(decls).to_contain("fn ast_module_decl_slots_clear():")
        # A cross-module direct clear of the decl index list is a dropped write.
        expect(state).to_not_contain("module_decl_slots.clear()")
        expect(core_exports).to_contain("export ast_reset, ast_prepare_persistent_owner_v1, expr_get, stmt_get, decl_get")

    it "promotes retained registry graphs owner by owner":
        # frontend_parse_ownership.spl was absorbed into the 80.driver parse
        # support owner; per-registry *_promote_transient_owner() retained-graph
        # promotion replaced the remove(key) rollback rows.
        val support = file_read("src/compiler/80.driver/driver_source_parse_support.spl")
        val layer = file_read("src/compiler/10.frontend/layer_eq_registry.spl")
        val effect = file_read("src/compiler/10.frontend/effect_registry.spl")
        val aspect = file_read("src/compiler/10.frontend/aspect_registry.spl")

        expect(support).to_contain("pub fn driver_promote_frontend_registry_owners() -> bool:")
        expect(support).to_contain("aspect_registry_promote_transient_owner()")
        expect(support).to_contain("effect_registry_promote_transient_owner()")
        expect(support).to_contain("layer_eq_registry_promote_transient_owner()")
        expect(support).to_contain("pub fn driver_promote_retained_frontend_owners_v1(parser_entered: bool) -> bool:")
        expect(support).to_contain("parser_promote_transient_owners()")
        expect(support).to_contain("compiler_coverage_inventory_promote_transient_owner()")
        expect(layer).to_contain("fn layer_eq_registry_promote_transient_owner() -> bool:")
        expect(layer).to_contain("_layer_eq_registry_promote_raw(layer_eq_registry_targets)")
        expect(effect).to_contain("fn effect_registry_promote_transient_owner() -> bool:")
        expect(aspect).to_contain("fn aspect_registry_promote_transient_owner() -> bool:")
        expect(aspect).to_contain("_aspect_registry_promote_raw(aspect_registry_kinds)")

    it "promotes before every production scope end and fails cleanup closed":
        val bridge = file_read("src/compiler/10.frontend/_FlatAstBridge/module_assembly.spl")
        val driver = source_parse_implementation_v1()
        val support = file_read("src/compiler/80.driver/driver_source_parse_support.spl")
        val hir_driver = file_read("src/compiler/80.driver/driver_hir_pipeline_lowering.spl")
        val scope_owner = function_body(
            bridge,
            "fn parse_and_build_module_with_scope_owner(source: text, path: text,",
            "pub fn parse_and_build_module_scoped_for_provider(")
        val end_body = function_body(
            support,
            "pub fn driver_end_transient_parse_scope() -> bool:",
            "use compiler.common.diagnostics.span.{Span}")

        val pause_pos = scope_owner.index_of("_sffi_transient_array_scope_pause()")
        val promote_pos = scope_owner.index_of("parser_promote_transient_owners()")
        val end_pos = scope_owner.index_of("_sffi_transient_array_scope_end()")
        expect(pause_pos).to_be_greater_than(-1)
        expect(promote_pos).to_be_greater_than(pause_pos)
        expect(end_pos).to_be_greater_than(promote_pos)
        # A graph or pool that cannot be promoted is a loud failure, never a
        # silently-reclaimed parser graph.
        expect(scope_owner).to_contain("transient parser graph promotion failed for \{path\}")
        expect(scope_owner).to_contain("[parse-scope] parser/decl/extend/pending pool promote incomplete for \{path\}")
        expect(scope_owner).to_contain("transient parser scope end failed for \{path\}")
        # driver_end_transient_parse_scope: ORDER IS LOAD-BEARING — end the
        # scope before replacing any process-lifetime frontend owner.
        expect(end_body).to_contain("lexer_release_parse_source_globals()")
        expect(end_body).to_contain("core_token_text_intern_reset()")
        expect(end_body).to_contain("ast_reset()")
        expect(end_body.index_of("val ended = _sffi_transient_array_scope_end()")).to_be_less_than(end_body.index_of("\n    lexer_release_parse_source_globals()"))
        # The reconstructed driver impl closes and reclaims the parser scope
        # before mutating the persistent registry; failure surfaces as an Err.
        expect(driver).to_contain("transient parser scope end failed for \{source_path\}")
        expect(hir_driver).to_contain("HIR ownership promotion failed for \{source_path\}")
        expect(hir_driver).to_contain("transient HIR scope end failed for \{source_path\}")
