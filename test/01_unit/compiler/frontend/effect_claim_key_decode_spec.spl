use std.spec.{describe, it, expect}
use compiler.frontend.effect_registry.{effect_claim_path, effect_claim_fn}

describe "effect claim key decoding":
    it "decodes the canonical path and function fields":
        expect(effect_claim_path("pkg/module.spl|render")).to_equal("pkg/module.spl")
        expect(effect_claim_fn("pkg/module.spl|render")).to_equal("render")

    it "preserves split-field behavior for missing and empty fields":
        expect(effect_claim_path("")).to_equal("")
        expect(effect_claim_fn("")).to_equal("")
        expect(effect_claim_path("module_only")).to_equal("module_only")
        expect(effect_claim_fn("module_only")).to_equal("")
        expect(effect_claim_path("|function")).to_equal("")
        expect(effect_claim_fn("|function")).to_equal("function")
        expect(effect_claim_fn("module|")).to_equal("")
        expect(effect_claim_fn("module||tail")).to_equal("")

    it "stops after the second field when trailing fields are present":
        expect(effect_claim_path("module|function|ignored")).to_equal("module")
        expect(effect_claim_fn("module|function|ignored")).to_equal("function")
