use std.spec.{describe, it, expect}
use compiler.core.ast_stmt.{stmt_store_state_take, stmt_store_state_install}

describe "StmtStoreState ParseContext snapshot (stage 1)":
    it "take leaves fresh stores and install restores the snapshot":
        val a = stmt_store_state_take()
        val fresh = stmt_store_state_take()
        expect(fresh.stmt_tag.len()).to_equal(0)
        stmt_store_state_install(a)
        val again = stmt_store_state_take()
        expect(again.stmt_tag.len()).to_equal(a.stmt_tag.len())
        stmt_store_state_install(again)
