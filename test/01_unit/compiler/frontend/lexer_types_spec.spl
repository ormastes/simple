# @req: REQ-COMPILER-FRONTEND-001 — core language semantics hold under execution. 
"""
## Purpose and audience

use std.spec.step
use std.spec.{describe, it, expect}
use compiler.core.tokens.{
    TOK_IDENT, TOK_EOF,
    TOK_INT_LIT, TOK_FLOAT_LIT,
    TOK_KW_FN, TOK_KW_VAL, TOK_KW_VAR, TOK_KW_STRUCT, TOK_KW_ENUM, TOK_KW_CLASS
}
use compiler.frontend.core.lexer.{lex_init_with_path, lex_next}

fn kinds_of(src: text, n: i64) -> [i64]:
    lex_init_with_path(src, "")
    var out: [i64] = []
    var i = 0
    while i < n:
        val k = lex_next()
        out.push(k)
        if k == TOK_EOF:
            return out
        i = i + 1
    out

describe "lexer tokenizes declaration keywords and literal types":
    # @manual scenario evidence
    it "classifies each type-bearing declaration keyword":
        # @req REQ-SSPEC-UNIT
        step("tokenize fn, val, var, struct, enum, class declarations")
        # oracle: each keyword token maps to its own kind, not TOK_IDENT
        expect(kinds_of("fn f", 1)[0]).to_equal(TOK_KW_FN)
        expect(kinds_of("val x", 1)[0]).to_equal(TOK_KW_VAL)
        expect(kinds_of("var y", 1)[0]).to_equal(TOK_KW_VAR)
        expect(kinds_of("struct S", 1)[0]).to_equal(TOK_KW_STRUCT)
        expect(kinds_of("enum E", 1)[0]).to_equal(TOK_KW_ENUM)
        expect(kinds_of("class C", 1)[0]).to_equal(TOK_KW_CLASS)

    it "classifies integer and float literals by their type":
        # @req REQ-SSPEC-UNIT
        step("tokenize 42, 3.5, and a name")
        # oracle: 42 is an int literal, 3.5 a float literal, n an identifier
        expect(kinds_of("42", 1)[0]).to_equal(TOK_INT_LIT)
        expect(kinds_of("3.5", 1)[0]).to_equal(TOK_FLOAT_LIT)
        expect(kinds_of("n", 1)[0]).to_equal(TOK_IDENT)

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/lexer_types.md
# doc-path: doc/03_plan/sys_test/lexer_types.md
# doc-path: doc/04_architecture/lexer_types.md
# doc-path: doc/05_design/lexer_types.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "truncating division and signed remainder":
        step("Verify: truncating division and signed remainder")
        # @req: REQ-COMPILER-FRONTEND-001
        expect(7 / 2).to_equal(3)  # oracle: i64 division truncates toward zero
        expect(-7 / 2).to_equal(-3)  # oracle: truncation is toward zero
        expect(7 % 2).to_equal(1)  # oracle: remainder of positive dividend
        expect(-7 % 2).to_equal(-1)  # oracle: remainder keeps dividend sign

    it "string split, join and repeat":
        step("Verify: string split, join and repeat")
        # @req: REQ-COMPILER-FRONTEND-001
        expect("a,b,c".split(",")).to_equal(["a", "b", "c"])
        expect("ha".repeat(3)).to_equal("hahaha")
        expect("ab".reverse()).to_equal("ba")

    it "integer arithmetic precedence":
        step("Verify: integer arithmetic precedence")
        # @req: REQ-COMPILER-FRONTEND-001
        expect(2 + 3 * 4).to_equal(14)  # oracle: * binds tighter than +
        expect(10 - 2 * 3).to_equal(4)  # oracle: multiplication precedes subtraction
        expect((2 + 3) * 4).to_equal(20)  # oracle: parentheses force additive group first

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "dict get, keys and membership":
        step("Verify: dict get, keys and membership")
        # @req: REQ-COMPILER-FRONTEND-001
        val d = {"a": 1}
        expect(d.get("a")).to_equal(1)  # oracle: stored value
        expect(d.has("b")).to_equal(false)
        expect(d.keys()).to_equal(["a"])

    it "Option payload binding":
        step("Verify: Option payload binding")
        # @req: REQ-COMPILER-FRONTEND-001
        val opt = Some(99)
        var chosen = 0
        match opt:
            Some(x): chosen = x
            nil: chosen = -1
        expect(chosen).to_equal(99)  # oracle: Some arm binds payload

    it "boolean operators short-circuit to expected truth table":
        step("Verify: boolean operators short-circuit to expected truth table")
        # @req: REQ-COMPILER-FRONTEND-001
        expect(true and false).to_equal(false)
        expect(true or false).to_equal(true)
        expect(not true).to_equal(false)
